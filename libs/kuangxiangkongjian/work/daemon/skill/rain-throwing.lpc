// rain-throing.c
#include <combat.h>
#include <ansi.h>
inherit SKILL;
void throw_weapon(object,object,object,int);
mapping *action = ({
	([	"action":		"$N将手中$w用力一郑，一招「点星雨”，只见一道白光往$n$l射去",
		"dodge":        -40,
		"damage":	50,
		"parry":	-30,
		"post_action":  (: throw_weapon :),
	]),
	([	"action":		"$N手中散出一道白光，一招「散雷风”$w飘浮不定的往$n$l而去",
		"dodge":	-30,
		"damage":	50,
		"parry":	-20,
		"post_action":	(: throw_weapon :),
	]),
	([	"action":		"$N一招「星灯万雨”，射出的$w散出无数残影往$n而去",
		"dodge":	-40,
		"damage":	40,
		"parry":	-30,
		"post_action":	(: throw_weapon :),
	]),
	([	"action":		"$N一招「殁\神抢亲”，射出的$w有如俇鹰雄飞，往$n$l直奔而去",
		"dodge":	-30,
		"damage":	20,
		"parry":	-20,
		"post_action":	(: throw_weapon :),
	]),
        ([      "action":              "$N一招「风起云涌”，射出的$w以极端的速度飞往$n的$l去",
                "dodge":        -25,
                "damage":       70,
                "parry":        -10,
                "post_action":  (: throw_weapon :),
        ]),
});

int valid_learn(object me)
{
	object ob;

	if(me->query_skill("throwing",1)<20)
		return notify_fail("要练霸雨螫魂要先有相当的暗器基础。\n");

	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type")!="throwing")
		return notify_fail("你手上要有暗器才能练霸雨螫魂。\n");

	return 1;
}

int valid_enable(string usage)
{
        return usage=="throwing" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
		return notify_fail("你的内力或气不够，不能练霸雨螫魂。\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	return 1;
}

string perform_action_file(string action)
{
	return CLASS_D("killer")+"/rain-throwing/"+action;
}
void throw_weapon(object me, object victim, object weapon, int damage)
{
        if( objectp(weapon) ) {
                if( (int)weapon->query_amount()==1 ) {
                        weapon->unequip();
             tell_object(me, "\n你的" + weapon->query("name") + "用完了！\n\n");
                }
    //此为加的
               else  {    int am; am=random(3);
                if( (int)weapon->query_amount() >25 &&random( me->query_skill("rain-throwing",1)+me->query_skill("throwing",1)) >= random(250) && (int)me->query("force") > 10)  {
      victim->receive_damage("kee",am*me->query_skill("rain-throwing",1)*2/3 );
      me->add("force",-10);
       message_vision(sprintf(HIC"$N再抓起一把暗器对准$n,以密集快速的手法射去,$n躲避不及,全部的暗器打在身上  。\n"NOR),me,victim);
             weapon->add_amount(-am);
                           }
                 }
    //到此为止
                weapon->add_amount(-1);
        }
}
