#include <combat.h>
inherit SKILL;
inherit SSERVER;
void hurt(object me, object victim, object weapon, int damage);
void bleed(object me, object victim, object weapon, int damage);
void conti(object me, object victim, object weapon, int damage);

string pit();

string *parry_msg = ({
  "$N运起太极柔字诀,将$n的攻势尽数卸去。\n",
  "$N将$w一扬，拨开了$n的攻击。\n",
  "但被$N以四两拨千金的手法格开了。\n",
  "$N运起太极真力，缠住了$n，使其无法继续进攻。\n",
  (: pit :),
});

string pit() {
  object me, target;
  string msg;
  me = this_player();
  target = offensive_target(me);
  target->study_busy(3);
  msg = me->query("name") + "格开了" + target->query("name") + "的攻击，顺势使出了紫龙点，\n点住了" + target->query("name") + "的穴道。\n";
  return msg;
}

string query_parry_msg(string limb) {
  if ((int)this_player()->query_skill("gwhip") <= 30)
    return parry_msg[random(sizeof(parry_msg) - 2)];
  else
    return parry_msg[random(sizeof(parry_msg) - 1)];
}

mapping *action = ({
  ([ "action": "$N体内灵气与真气鼓荡，一招「天道无量”，手中$w如一条银蛇般刺向$n的$l",
    "dodge": -20,
    "damage": 10,
    "damage_type": "刺伤",
    "post_action": (: pit :),
  ]),

  ([ "action": "$N使出无量神剑中的「无边无量””，手中$w运劲击刺$n的$l",
    "dodge": -20,
    "damage": 15,
    "damage_type": "刺伤",
    "post_action": (: conti :),
  ]),

  ([ "action": "$N气运丹田，使出一招「乾坤无极”，身形陡然飞跃数尺，手中$w刺向$n的$l",
    "dodge": -30,
    "damage": 20,
    "damage_type": "刺伤",
    "post_action": (: bleed :),
  ]),

  ([ "action": "$N手中$w中宫直进，一式「里太极剑”对准$n的$l陡然刺出",
    "dodge": -40,
    "damage": 25,
    "damage_type": "刺伤",
    "post_action": (: hurt :),
  ]),

  ([ "action": "$N纵身一跃，手中$w一招「无边苍穹”对准$n的$l直直劈下",
    "dodge": -40,
    "damage": 30,
    "damage_type": "割伤",
    "post_action": (: bleed :),
  ]),

  ([ "action": "$N震动手中的$w发出嘤嘤声响，一招「天机莫测”刺向$n的$l",
    "dodge": -20,
    "damage": 35,
    "damage_type": "刺伤",
    "post_action": (: conti :),
  ]),

  ([ "action": "$N手中$w向外一分，使一招「龙云天际”反手对准$n$l刺去",
    "dodge": -20,
    "damage": 40,
    "damage_type": "刺伤",
    "post_action": (: hurt :),
  ]),

  ([ "action": "$N脚踏七星步，身形一转手中$w使一招「天道循环”画出一道光弧斩向$n的$l",
    "dodge": -30,
    "damage": 45,
    "damage_type": "割伤",
    "post_action": (: bleed :),
  ]),

  ([ "action": "$N一招天道击,内力暴射,$w疾点向$n的$l,$l\n",
    "dodge": -30,
    "damage": 50,
    "damage_type": "刺伤",
    "post_action": (: hurt :),
  ]),

  ([ "action": "$N突然长啸一声，一招「四路开泰”，$w挟着一股巨力冲向$n的$l\n",
    "dodge": -30,
    "damage": 51,
    "damage_type": "瘀伤",
    "post_action": (: conti :),
  ]),

  ([ "action":
    "$N使出一招「斗转星移”，左手持剑，右手将对方的招式如数奉还。\n",
    "dodge": -30,
    "damage": 52,
    "damage_type": "刺伤",
    "post_action": (: hurt :),
  ]),
});

void hurt(object me, object victim, object weapon, int damage) {
  if (me->query("force_factor") > 0)
    if (random(500) < me->query_skill("force") + me->query_skill("gsword", 1)) {
      victim->receive_damage("kee", 3 * me->query("force_factor") + me->query_skill("gforce"));
      message_vision(sprintf("$N将必生功力灌入指中,射向$n体内, $n一阵唉豪, 看来已受了不小的伤。\n"), me, victim);
      if (damage <= 0)
        COMBAT_D->report_status(victim);
    }
}
void bleed(object me, object victim, object weapon, int damage) {
  if (damage > 40) {
    victim->apply_condition("bleeding",
      random(me->query_skill("gforce") + me->query_skill("gsword")) / 10);
    message_vision(sprintf("$N喃喃念起一起咒语断了一道怨魂往$n身上破体而出。\n"), me, victim);
  }
}
void conti(object me, object victim, object weapon, int damage) {
  int i, time = me->query_skill("gsword") / 10;
  if (me->query("force_factor") >= 10) {
    if (me->query_temp("conti") == 0) {
      me->set_temp("conti", 1);
      message_vision(sprintf("\n$N一招「无量劫指”，左手以指代剑射出浩然正气！！\n"), me);
      for (i = 0; i < (time - 1); i++)
        COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
      me->delete_temp("conti");
    }
  }
}
int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 30)
    return notify_fail("你的内力不够，没有办法练\n");

  if ((string)me->query_skill_mapped("force") != "gforce")
    return notify_fail("无量神剑必须配合紫府神功才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先装备剑类武器才能练鞭法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {

  if ((int)me->query("kee") < 15
    || (int)me->query("force") < 15)
    return notify_fail("你的内力或气不够，没有办法练习紫龙鞭法。\n");
  me->receive_damage("kee", 15);
  me->add("force", -15);
  write("你按着所学练了一遍无量神剑。\n");
  return 1;
}

string skill_improved(string me) {
  tell_object(this_player(), "你感到你的法力随着你的技能的提升而更上一成了。\n");
}
string perform_action_file(string action) {
  return CLASS_D("taoist") + "/gwhip/" + action;
}
