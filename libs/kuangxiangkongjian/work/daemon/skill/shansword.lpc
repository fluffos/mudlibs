// fonxansword.c

inherit SKILL;

mapping *action = ({
  ([ "action": "$N使一招「拖泥带水”，手中$w平平刺向敌人$n的$l，去势竟是极其缓慢",
    "dodge": -20,
    "damae": 30,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出黯然销魂剑中的「倒行逆施”，手腕翻转竟以剑首朝敌人$l刺去",
    "dodge": -20,
    "damae": 30,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招「庸人自扰”，身形陡向后滑出数尺，手中$w朝$n足踝砍去",
    "dodge": -30,
    "damae": 20,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N面若有思，一式「杞人忧天”对准$n的$l刺出一剑",
    "dodge": -40,
    "damage_type": "刺伤"
  ]),
  ([ "action": "只见$N咬牙切齿，横剑上前，蓦地里一招「饮恨吞声”朝$w的$l刺去",
    "dodge": -40,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N忽哭忽笑，神情诡异，陡然使出一招「想入非非”刺向$n的$l",
    "dodge": 20,
    "damage": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N突然全身委顿余地，使一招「力不从心”反手对准$n$l一剑刺去",
    "dodge": -20,
    "damage": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N突然杀意暴起，调息全身内力于剑尖，大喝一声朝$w刺去，正是黯然销魂剑中最强的「穷途末路”",
    "dodge": -30,
    "damage": 10,
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练黯然销魂剑剑法。\n");

  if ((string)me->query_skill_mapped("force") != "fonxanforce")
    return notify_fail("黯然销魂剑剑法必须配合仙剑派内功\才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习黯然销魂剑剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你坐卧于地，依招演练一次。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("swordsman") + "/shansword/" + action;
}
