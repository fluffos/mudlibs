// bad-array.c by oda

#include <ansi.h>
inherit SKILL;
int mean;
int valid_enable(string usage) { return usage=="array";} 
int variance(object *);
void doing_array(object *,object );
int form_array(object leader)
{
	object *member;
        int i;
        int enable_array=0;
	member = leader->query_team();
	if( sizeof(member) != 2 )
		return notify_fail("此剑阵共需两人，少一个多一个都不行。\n");
	if( leader->query_temp("use_form",1) )
	       return notify_fail("剑阵正在施展中。\n");
	for(i=0;i<sizeof(member);i++)
	 if(!member[i]->query_temp("weapon"))
	   return notify_fail("无持剑，焉成剑阵。\n");
	message_vision( HIG "$N带领众人展开阴阳两仪剑阵。\n" NOR, leader);
	leader->add("sen",-20);
	if( leader->query("sen",1) > 30)
 	  doing_array(member,leader); 
        else 
          message_vision("[1m你精神力不足以启动剑阵\n[0m",leader);
        return 1;
}      

void doing_array(object *member,object leader)
{
     int i;  
     int vari;
     int enable_array=0;
     int max,min;  
     mapping add_dodge=([]);
     mapping add_attack=([]);
     vari=variance(member);
      for(i= 0; i< sizeof(member);i++)
	{
	  if(present(member[i]->query("id"),environment(leader)))
	   {
	      member[i]->set_temp("use_form",1);
              member[i]->set_temp("save/apply",member[i]->query_temp("apply"));
              if( vari< 5)
              { 
                add_attack[i]=
			(int)(member[i]->query_skill("shasword",1)+
			member[i]->query_skill("spider-array",1))/5+
			random(3);
                add_dodge[i]=(int)(member[i]->query_skill("spider-array",1)+
			member[i]->query_skill("dodge",1))/5+
			random(3);
                member[i]->add_temp("apply/attack",add_attack[i]);
                member[i]->add_temp("apply/dodge",add_dodge[i]);
                member[i]->add_temp("gin",-30);
               }
              else if( vari < 20)
               {
                add_attack[i]=(int)(member[i]->query_skill("shasword",1)+
                member[i]->query_skill("spider-array",1))/8+
                random(2);                                        
                
                add_dodge[i]=(int)(member[i]->query_skill("spider-array",1)+
                member[i]->query_skill("dodge",1))/8+
                random(2);
                
                member[i]->add_temp("apply/attack",add_attack[i]);                                
                member[i]->add_temp("apply/dodge",add_dodge[i]);
                member[i]->add_temp("gin",-30);
                }
              else if( vari < 40)
                {
                add_attack[i]=(int)(member[i]->query_skill("spider-array",1)+
                member[i]->query_skill("shasword",1))/10+
                random(1);
                add_dodge[i]=(int)(member[i]->query_skill("spider-array",1)+
                member[i]->query_skill("dodge",1))/10+
                random(1);
                 member[i]->add_temp("apply/attack",add_attack[i]);
                 member[i]->add_temp("apply/dodge",add_dodge[i]); 
                 member[i]->add_temp("gin",-30);
                 } 
              else if( vari < 100)
                {
                add_attack[i]=(int)(member[i]->query_skill("spider-array",1)+
                member[i]->query_skill("shasword",1))/15;
                add_dodge[i]=(int)(member[i]->query_skill("spider-array",1)+
                member[i]->query_skill("dodge",1))/15;
                member[i]->add_temp("apply/attack",add_attack[i]);
                member[i]->add_temp("apply/dodge",add_dodge[i]);
                member[i]->add_temp("gin",-30);
               }
              else
               {
                if( member[i]->query_skill("shasword",1)>mean )
                  { 
                    add_attack[i]=-random(3);
                    add_dodge[i]=-random(3);                                                     
                   }
                else
                  {
                   add_attack[i]=(int)(member[i]->query_skill("spider-array",1)+
                   member[i]->query_skill("shasword",1))/20;
                   add_dodge[i]=(int)(member[i]->query_skill("spider-array",1)+
                   member[i]->query_skill("dodge",1))/20;
                    }
                member[i]->add_temp("apply/attack",add_attack[i]);
                member[i]->add_temp("apply/dodge",add_dodge[i]);
                member[i]->add_temp("gin",-30);                                 
                }
            }
          
          
          } 
         
          leader->start_call_out( (: call_other, __FILE__, "remove_array",
          member, add_attack, add_dodge,leader :), random(10)+leader->query_skill("sha-array",1));
}

void remove_array( object *member,int *add_attack, int *add_dodge,object leader)
{
 
    int i;
   if(leader->query_temp("use_form",1))
   {
     message_vision("[1m$N突然心神一分，阵已不成阵，必须重组。\n[0m",leader);
     for(i=0; i<sizeof(member);i ++)
     {
      member[i]->add_temp("apply/attack",-add_attack[i]);
      member[i]->add_temp("apply/dodge",-add_dodge[i]);
      member[i]->delete_temp("use_form",1);
      }
   }
} 

int sort_skill( object man1, object man2)
{
  int	i, j;

  i = man1->query_skill("shasword",1);
  j = man2->query_skill("shasword",1);
  if (i>j) return 1;
  else if (i<j) return -1;
  else return 0;
}

int variance( object *member)
{
  int i,j,min,num,k,l,total;
  object temp;
  int vari;
  num=0;
  sort_array(member, "sort_skill", this_object());
/*
  for( i=0;i< sizeof(member)-1; i++)
   {
     min=i;
      for(j=i+1; j< sizeof(member);j++)
          if( member[min]->query_skill("shasword",1) >
		member[j]->query_skill("shasword",1))
	  {
                min=j;  
	  }
          temp=member[i];           
          member[i]=member[min];  
          member[j]=temp;
   }   
*/
             
   for(k=0 ; k<sizeof(member);k++)
   {
    total=total+member[k]->query_skill("shasword",1);
    num++;
    }          
   
   (int)mean=total/num;
   for(l=0;l< sizeof(member);l++)
   {
    (int)vari+=(member[l]->query_skill("shasword",1)-mean)*
    (member[l]->query_skill("shasword",1)-mean)/num;
    }
   return vari;
  }           
             
             
                  
