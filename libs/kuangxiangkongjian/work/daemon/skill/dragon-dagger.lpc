// dragon=dagger.c
#include <combat.h>
#include <ansi.h>

inherit SKILL;
void sp1(object me, object victim, object weapon, int damage);
void sp2(object me, object victim, object weapon, int damage);

mapping *action = ({
  ([ "action": "$N一招" HIW "「盘龙出谷”" NOR
    "，手中$w往外划出，向$n直冲而来",
    "dodge": -20,
    "damage": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w一挺出，一招" HIW "「龙奔四海”" NOR
    "如狂龙班往$n刺去",
    "dodge": -30,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一招" HIW "「强龙并肩”" NOR
    "将手中$w往$n郑去，随即飞身踢去，并接回$w",
    "damage": 50,
    "dodge": -40,
    "parry": -30,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出" HIW " 盘龙匕法 之 ‘ 困 ’字诀" NOR
    ",以守带攻的向$n袭去",
    "damage": 40,
    "post_action": (: sp1 :),
  ]),
  ([ "action": "$N使出" HIW " 盘龙匕法 之 ‘ 生 ’字诀" NOR
    ",以守带攻的向$n袭去",
    "damage": 30,
    "post_action": (: sp2 :),
  ]),
});

void sp1(object me, object victim, object weapon, int damage) {
  int skill, i;
  skill = me->query_skill("dragon-dagger");
  if (me->query("force") > skill) {
    i = skill / 15;
    victim->start_busy((int)i);
    message_vision(HIW "$N转眼间化做数十个身影,迷惑了$n。\n" NOR, me, victim);
    me->add("force", -skill);
  } else victim->start_busy(1);
  return;
}
void sp2(object me, object victim, object weapon, int damage) {
  int skill;
  skill = me->query_skill("dragon-dagger") * 4;
  if (me->query("force") > skill) {
    me->receive_curing("kee", skill);
    me->receive_heal("kee", skill);
    me->add("force", (int)(-skill / 2));
    message_vision(HIW "$N吸取天地灵气,回复了伤口。\n" NOR, me);
  } else me->receive_curing("kee", 10);
  return;
}
int valid_learn(object me) {
  object ob;

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "dagger")
    return notify_fail("你要有匕首才能练盘龙匕。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "dagger" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没办法练盘龙匕。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("officer") + "/dragon-dagger/" + action;
}
