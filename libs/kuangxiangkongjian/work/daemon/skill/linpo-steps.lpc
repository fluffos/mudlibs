// linbo-steps.c

inherit SKILL;

string *dodge_msg = 
({
"$n展开[1;36m‘凌波微步’[0m，左足跨出，既踏[1m「中孚”[0m，立转[1m「既济”[0m，[1;33m「神光离合，乍阴乍阳”[0m，斜斜的躲过$N。\n",
"只见$n施展[1;36m‘凌波微步’[0m，甫上[1m「泰”[0m位，一个转身，右脚踏上[1m「蛊”[0m位，[1;33m「体迅飞鹫，飘忽若神”[0m，反而绕到$N身后。\n",
"$n踏出[1;36m‘凌波微步’[0m，足下自然而然自[1m「井”[0m位斜行，踏到了[1m「讼”[0m位，[1;33m「涑轻躯以鹤立，若将飞而未翔”[0m，轻轻松松地躲过$N的招式。\n",
"$n使出[1;36m‘凌波微步’[0m，自[1m「豫”[0m位踏[1m「观”[0m位，[1;33m「翩若惊鸿，婉若游龙”[0m，闪身从$N身旁绕过。\n",
"$n展现[1;36m‘凌波微步’[0m，跟着斜踏[1m「蛊”[0m位，[1;33m「忽焉纵体，以遨以嘻”[0m，身子轻轻飘了开去。\n",
"$n斜踏[1;36m‘凌波微步’[0m，忽高忽低，有若[1;33m「髣佛兮若轻云之蔽月，飘飘兮若流风之回雪”[0m般。\n",
});

int valid_enable(string usage) 
{
	return (usage=="dodge")||(usage=="move");
}

int valid_learn(object me)
{
        if(me->query_skill("literate",1)*2 <= me->query_skill("linpo-steps",1))
        {
          write("你的知识不足，无法体会凌波微步中易经六十四卦的精要变化。\n");
          return 0;
	}
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if((int)me->query("kee")<5)
		return notify_fail("你的气不够，不能练凌波微步。\n");
	me->receive_wound("kee",5);
	return 1;
}
