void hurt(object me, object victim, object weapon, int damage) {
  if (me->query("force_factor") > 0)
    if (random(500) < me->query_skill("force") + me->query_skill("gwhip", 1)) {
      victim->receive_damage("kee", 3 * me->query("force_factor") + me->query_skill("gforce"));
      message_vision(sprintf(HIM "$N将必生功\力灌入鞭中,射向$n体内, $n一阵唉豪,看来已受了不小的伤。\n"), me, victim);
      if (damage <= 0)
        COMBAT_D->report_status(victim);
    }
}
void bleed(object me, object victim, object weapon, int damage) {
  if (damage > 40) {
    victim->apply_condition("bleeding",
      random(me->query_skill("gforce") + me->query_skill("gwhip")) / 10);
    message_vision(sprintf("[1;36m$N喃喃念起一起咒语断了一道怨魂往$n身上破体而出。[0m\n"), me, victim);
  }
}
void conti(object me, object victim, object weapon, int damage) {
  int i, time = me->query_skill("gwhip") / 10;
  if (me->query("force_factor") >= 10) {
    if (me->query_temp("conti") == 0) {
      me->set_temp("conti", 1);
      message_vision(
        sprintf("\n[1;33m$N忽然顿悟紫龙之[1;5;34m神龙鞭法[0m[1;33m的要诀, 浩然正气的破体而出!![0m\n"),
        me
      );
      for (i = 0; i < (time - 1); i++)
        COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
      me->delete_temp("conti");
    }
  }
}
int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 30)
    return notify_fail("你的内力不够，没有办法练\n");

  if ((string)me->query_skill_mapped("force") != "gforce")
    return notify_fail("紫龙鞭法必须配合紫府神功\才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "whip")
    return notify_fail("你必须先装备鞭类武器才能练鞭法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "whip" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {

  if ((int)me->query("kee") < 15
    || (int)me->query("force") < 15)
    return notify_fail("你的内力或气不够，没有办法练习紫龙鞭法。\n");
  me->receive_damage("kee", 15);
  me->add("force", -15);
  write("你按着所学练了一遍紫龙鞭法法。\n");
  return 1;
}

string skill_improved(string me) {
  tell_object(this_player(), "你感到你的法力随着你的技能的提升而更上一成了。\n");
}
string perform_action_file(string action) {
  return CLASS_D("taoist") + "/gwhip/" + action;
}
