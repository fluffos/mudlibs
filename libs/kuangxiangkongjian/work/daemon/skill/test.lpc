int valid_learn(object me) {
  if ((me->query_temp("weapon") || me->query_temp("secondary_weapon")) != 1)
    return notify_fail("练仙剑剑术必需先拿把剑。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "sword" || usage == "parry");
}

string query_parry_msg(string limb) {
  int parry_pow;
  object me;
  me = this_player();
  parry_pow = (int)(me->query_skill("test", 1) / 10);
  if (parry_pow <= 5)
    return parry_msg[random(3)];
  else

    return parry_msg[random(sizeof(parry_msg))];
}

mapping query_action(object me, object weapon) {
  int skill_level, limit;
  skill_level = (int)(me->query_skill("test", 1));
  limit = (int)(skill_level / 8);
  if (limit < 1)
    return action[random(0)];
  if (limit < 2)
    return action[random(1)];
  if (limit < 3)
    return action[random(2)];
  if (limit < 4)
    return action[random(3)];
  if (limit < 5)
    return action[random(4)];
  if (limit < 6)
    return action[random(4) + 1];
  if (limit < 7)
    return action[random(4) + 2];
  if (limit < 8)
    return action[random(4) + 3];
  if (limit < 9)
    return action[random(4) + 4];
  if (limit < 10)
    return action[random(4) + 5];
  else
    return action[random(4) + 5];
}

void berserk(object me, object victim, object weapon, int damage) {
  say("1");
  // if( (int)me->query_skill("test",1) > random(40)+45)
  //   { 
  if (!me->query_temp("berserk")) {
    if (me->query("marks/张乘风")) {
      sprintf(
        HIY "$N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第一招‘射燕式’，手中长剑似有若无朝$n攻去。\n" NOR);
      // COMBAT_D->do_attack(me, victim, me->query_temp("weapon"),TYPE_QUICK);                
      victim->add("kee", -50);
    }
    if (me->query("marks/张乘云")) {
      sprintf(
        HIY " $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第二招‘挑屌式’，手中长剑似灵蛇般朝$n刺去。\n" NOR);
      // COMBAT_D->do_attack(me, victim, me->query_temp("weapon"),TYPE_QUICK);
      victim->add("kee", -50);
    }

    if (me->query("marks/范松")) {
      sprintf(
        HIY "$N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第三招‘左车轮剑’，手中长剑越转越急竟似无数个圆轮向$N攻去。\n" NOR);
      // COMBAT_D->do_attack(me, victim, me->query_temp("weapon"),TYPE_QUICK);              
      victim->add("kee", -50);
    }
    if (me->query("marks/赵鹤")) {
      sprintf(
        HIY "$N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第四招‘流星赶月’，手中剑气暴涨，狂暴的向$N砍去。\n" NOR);
      // COMBAT_D->do_attack(me, victim, me->query_temp("weapon"),TYPE_QUICK);           
      victim->add("kee", -50);
    }
    if (me->query("marks/梁发")) {
      sprintf(
        HIY "$N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第五招‘右车轮剑’，手中长剑越转越急竟似无数个圆轮向$N包围而去。\n" NOR);
      // COMBAT_D->do_attack(me, victim, me->query_temp("weapon"),TYPE_QUICK);
      victim->add("kee", -50);
    }
    if (me->query("marks/何双双")) {
      sprintf(
        HIY "$N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第六招‘天马行空’，手中长剑翁翁作响，由四面八方向$N砍去。\n" NOR);
      // COMBAT_D->do_attack(me, victim, me->query_temp("weapon"),TYPE_QUICK);
      victim->add("kee", -50);
    }
    if (me->query("marks/李逍遥")) {
      say("2");
      sprintf(
        HIY "$N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第七招‘石破天惊’，手中长剑回指，旋身纵起，幻化成无数剑气向$N射去。\n");
      // COMBAT_D->do_attack(me, victim, me->query_temp("weapon"),TYPE_QUICK);
      victim->add("kee", -50);
    }
    me->set_temp("berserk", 1);
  }
  me->delete_temp("apply/attack");
  me->delete_temp("berserk");
  say("3");
  //   }

}


int practice_skill(object me) {
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  if ((int)me->query_skill("literate") <= ((int)(me->query_skill("taigisword", 1) * 0.75)))
    return notify_fail("你的武学知识不足，似乎无法参透绝学中山水之义。");
  me->receive_damage("kee", 40);
  me->add("force", -5);
  return 1;
}
