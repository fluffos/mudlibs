// modmagic.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "magic"; }

int valid_learn(object me) {
  if (me->query("gender") != "女性")
    return notify_fail("九道仙法非女子不可学也。\n");
  if (me->query("max_atman") < 100)
    return notify_fail("要有点灵力上的根基才能学九道仙法。\n");
  return 1;
}

string perform_action_file(string spell) {
  return CLASS_D("god") + "/modmagic/" + spell;
}


int practice_skill(object me) {

  if (me->query("atman") < 10)
    return notify_fail("你的灵能力已经耗尽，还是先休息一下再练吧。\n");
  me->add("atman", -10);
  return 1;
}
