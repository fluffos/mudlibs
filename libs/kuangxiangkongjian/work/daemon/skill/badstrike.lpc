int valid_learn(object me)
{
	int skill, bell;
	object wea1, wea2;
	skill = me->query_skill("badstrike", 1);
	bell = me->query("bellicosity");
	wea1 = me->query_temp("weapon");
	wea2 = me->query_temp("secondary_weapon");

	if( (wea1 && wea1->query("skill_type")!="unarmed") || (wea2 && wea2->query("skill_type")!="unarmed") )
		return notify_fail("练恶霸掌不能使用刀剑等武器。\n");
	if( (int)me->query_skill("badforce", 1) < 10 )
		return notify_fail("你的恶化魔功\不够恶化，无法修练恶霸掌。\n");
	if( (int)me->query("max_force") < 20 )
		return notify_fail("你的内力太弱，无法练恶霸掌法。\n");

	// modify by oda
        //if((int)me->query("bellicosity") < 30 )
	if( (skill<50 && bell<(skill*5)) || (skill>=50 && bell<250) )
          	return notify_fail("你的杀气不够，不能修练恶霸掌。\n");

	return 1;
}

int valid_enable(string usage)
{
	if( this_player()->query_skill("badstrike",1)>=50 )
		return ( usage=="unarmed" || usage=="parry" );
	else
		return ( usage=="unarmed" );
}

mapping query_action(object me, object weapon)
{
	int skill_level, limit;

        skill_level=(int)me->query_skill("badstrike", 1);
        if (skill_level < 10)
                return action[random(2)];
        else if (skill_level < 20 )
                return action[random(3)];
        else if (skill_level < 35 )
                return action[random(4)];
        else if (skill_level < 55 )
                return action[random(5)];
        else if (skill_level < 80 )
                return action[random(5)+1];
        else 
                return action[random(5)+2];
}                                                           

void bleed(object me, object victim, object weapon, int damage)
{
	int bellpower = (int)me->query("bellicosity")/250+1;

	if(damage > 50 && !me->query_temp("berserk"))
	{
		// modify by oda
		// 取消 random 以及 damage/20 改成 damage/10, 增加使用要减内力
		if(me->query("force") < 5*bellpower) return;
		me->add("force", -5*bellpower);
		victim->receive_wound("kee", ((int)damage/10+(int)me->query_skill("badforce",1)/10)*bellpower);
		message_vision(HIM"$N用内力把$n震伤，不停的狂吐鲜血。\n"NOR, me, victim);
		COMBAT_D->report_status(victim, 1);
	}
}

void block(object me, object victim, object weapon, int damage)
{
	int times = (int)me->query_skill("badforce",1)/25+2;
	int bellpower = (int)me->query("bellicosity")/500+1;

	//modify by oda
	// combat_exp 之比较在自身之 exp 处加上 random
	// start_busy 加上 random, skill/20 改为 skill/25, 使用要扣内力
	if(me->query_skill_mapped("force")=="badforce" && !me->query_temp("berserk") && random(me->query("combat_exp")) > random(victim->query("combat_exp")))
	{
		if(me->query("force") < 2*times*bellpower) return;
		me->add("force",-(2*times*bellpower));
		victim->start_busy( (random(times)+1)*bellpower );
		message_vision(HIB"$N暗使内力，使得$n为其恶化魔功\所震而暂时无法动弹。\n"NOR, me, victim);	
	}
}

void suck(object me, object victim, object  weapon, int damage)
{
	int lose;
	int bellpower = (int)me->query("bellicosity")/250+1;
	if( damage > 0 && victim->query("force") > 0 && me->query_skill_mapped("force") == "badforce" && !me->query_temp("berserk"))
	{
		// modify by oda
		// 气低于 70 时无法使用, 每次使用扣气 10
		if(me->query("kee") < 60+bellpower*10) return;
		lose = ((int)me->query_skill("badforce",1)/5+10)*bellpower;
		if( victim->query("force") < lose)
			lose = victim->query("force");
		me->add("kee", -10*bellpower);
	 	me->add("force", lose);
		victim->add("force", -lose);
		message_vision(HIY"$N使出恶化魔功\之吸功\大法，把$n的功\力吸去不少。\n"NOR, me, victim);
	}
}

void upforce(object me, object victim, object weapon, int damage)
{
	int skill = (int)me->query_skill("badforce", 1)/10;
	int bellpower = (int)me->query("bellicosity")/500+1;
	// add by oda...限制 bellpower 上限为 2
	if( bellpower > 2 ) bellpower = 2;

	if( !me->query_temp("berserk") && !me->query_temp("upforce") && damage>50 && me->query_skill_mapped("force")=="badforce")
	{
		// modify by oda
		// 增加当精低于 50 无法使用 upforce
		if(me->query("gin") < 40+bellpower*10) return;
		message_vision(HIG"$N一击得手，$n喷出的鲜血激起了$N的疯狂杀意，内力暴长。\n"NOR, me, victim);
		me->set_temp("oldforce", me->query("force_factor"));
		me->set("force_factor", (int)me->query("force_factor")*skill*bellpower/4+1);
		me->set_temp("upforce", 1);
		me->start_call_out( (: call_other, __FILE__, "remove_upforce", me :),  skill);
	}
}

void remove_upforce(object me)
{
	int bellpower = (int)me->query("bellicosity")/500+1;
	// modify by oda
	// 使用 upforce 完扣精
	me->receive_damage("gin", 10*bellpower);
	me->set("force_factor", me->query_temp("oldforce"));
	me->delete_temp("oldforce");
	me->delete_temp("upforce");
	message_vision(HIW"$N狂意渐退，内力渐渐收回。\n"NOR, me);
}

void berserk(object me, object victim, object weapon, int damage)
{
        int lose, i;
	int bellpower = (int)me->query("bellicosity")/500+1;
	// modify by oda
	// combat_exp 之比较在自身之 exp 加上 random
	// lose = skill/10 + 1 改为 random(skill/10) + 3
	// 增加连击完毕 busy 一回合
	if(!me->query_temp("berserk") && random(me->query("combat_exp")) > random(victim->query("combat_exp")))
	{
        	lose = random((int)me->query_skill("badstrike", 1)/20)+2+bellpower;
		me->set_temp("berserk", 1);
		for(i = 0;i < lose; i++)
		{
        		message_vision(HIR"$N打出恶霸掌之连击技，向$n狂风暴雨般横扫而去。\n"NOR, me, victim);
			COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
		}
		me->delete_temp("berserk");
		message_vision(HIW"一阵狂打之后，$N体内气息大乱，赶紧趁机调息。\n"NOR,me);
		me->start_busy(1);
	}
} 

int practice_skill(object me)
{
	// modify by oda
        //if((int)me->query("bellicosity")<30)
        //  	return notify_fail("你的杀气不够，不能修练恶霸掌。\n");
        if( (int)me->query("force") < 10 )
                return notify_fail("你的内力不够了。\n");
	if( (int)me->query("kee") < 30 )
		return notify_fail("你的体力不够了，休息一下再练吧。\n");
	me->receive_damage("kee", 30);
	//me->add("bellicosity",-1);
        me->add("force", -10);                   
	return 1;
}

string perform_action_file(string action)
{
	return CLASS_D("bandit")+"/badstrike/"+action;
}
