// magic.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "magic"; }

string conjure_magic_file(string func) {
  return CLASS_D("taoist") + "/gmagic/" + func;
}

int conjure_magic(object me, string spell, object target) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon")) ||
    weapon->query("skill_type") != "whip") {
    tell_object(me, "你得拿着拂尘才能施法。\n");
    return 1;
  }
  if ((string)me->query_skill_mapped("whip") != "gwhip") {
    tell_object(me, "你的拂尘用法不对，使不出道家仙术。\n");
    return 1;
  }
  if ((string)me->query_skill_mapped("force") != "gforce") {
    tell_object(me, "你的内功\心法不对，使不出道家仙术。\n");
    return 1;
  }
  return conjure_magic_file(spell)->conjure(me, target);
}
