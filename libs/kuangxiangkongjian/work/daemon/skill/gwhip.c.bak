		"dodge":		-20,       
		"damage":		30,
		"damage_type":	"割伤"
	]),
	([	"action":		"$N一招「御风而行”，身形陡然滑出数尺，手中$w拂向$n的$l",
		"dodge":		-30,                                                                   
		"damage":		30,
		"damage_type":	"割伤"
	]),
	([	"action":		"$N手中$w中宫直进，一式「旭日东升”对准$n的$l刺出",
		"dodge":		-40,                                                         
		"damage":		30,
		"damage_type":	"刺伤"
	]),
	([	"action":		"$N纵身一跃，手中$w一招「巨龙盖\顶”对准$n的$l直直劈下",
		"dodge":		-40,                                                        
		"damage":		40,
		"damage_type":	"割伤"
	]),                          
	([	"action":		"$N的$w螺旋甩出，一招毒龙钻刺向$n的$l",
		"dodge":		-20,                            
		"damage":		40,
		"damage_type":	"刺伤"
	]),
	([	"action":		"$N手中$w向外一分，使一招「柳暗花明”反手对准$n$l刺去",
		"dodge":		-20,                                                          
		"damage":		30,
		"damage_type":	"刺伤"
	]),
	([	"action":		"$N脚踏七星步，身形一转手中$w使一招「空谷秋虹”画出一道光弧斩向$n的$l",
		"dodge":		-30,            
		"damage":		30,
		"damage_type":	"割伤"    
	]),
	([	"action":		"$N一招天道击,内力暴射,$w疾点向$n的$l,$l\n",
		"dodge":		-30,
		"damage":		50,
		"damage_type":	"刺伤"
	]),
	([	"action":		"$N突然暴喝一声，一招雷厉风行，$w挟着一股巨力冲向$n的$l\n",
		"dodge":		-30,
		"damage":		50,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N使出一招龙尾刺，手中$w如针般刺向$n的$l\n",
		"dodge":		-30,
		"damage":		50,
		"damage_type":	"刺伤"
	]),				
});                                                              

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 30 )
		return notify_fail("你的内力不够，没有办法练\n");

	if( (string)me->query_skill_mapped("force")!= "gforce")
		return notify_fail("紫龙鞭法必须配合紫府神功\才能练。\n");
                                                                          
	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "whip" )
		return notify_fail("你必须先装备鞭类武器才能练鞭法。\n");
                                                               
	return 1;
}

int valid_enable(string usage)
{
	return usage=="whip" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 15
	||	(int)me->query("force") < 15 )
		return notify_fail("你的内力或气不够，没有办法练习紫龙鞭法。\n");
	me->receive_damage("kee", 15);                                                   
	me->add("force", -15);
	write("你按着所学练了一遍紫龙鞭法法。\n");
	return 1;                      
}

string perform_action_file(string action)
{
	return CLASS_D("taoist") + "/gwhip/" + action;
}
