// fonxansword.c

inherit SKILL;
inherit SSERVER;

string pit();

string *parry_msg = ({
	"$N运起柔字诀,将$n的攻势尽数卸去。\n",
	"$N将$w一扬，拨开了$n的攻击。\n",
	"但被$N以四两拨千金的手法格开了。\n",
	"$N将手中的$w一甩，缠住了$n，使其无法继续进攻。\n",
	(: pit :),
	});
	
string pit()
{
	object me , target;
	string msg;
	me = this_player();
	target = offensive_target(me);
	target->study_busy(3);
	msg = me->query("name")+"格开了"+target->query("name")+"的攻击，顺势使出了紫龙点，\n点住了"+
		target->query("name")+"的穴道。\n";
	return msg;	
}	

string query_parry_msg(string limb)
{
	if((int)this_player()->query_skill("gwhip") <= 30 )
	return parry_msg[random(sizeof(parry_msg) - 2)] ;
	else
	return parry_msg[random(sizeof(parry_msg) - 1)] ; }

mapping *action = ({
	([	"action":		"$N使一招「峰回路转”，手中$w如一条银蛇般刺向$n的$l",
		"dodge":		-20,
		"damage":		30,
		"damage_type":	"刺伤"
	]),
