// gdragon-steps.c made by carol

#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
	"$n的脚踏七星, 使出了"HIG"‘青玄身法’"NOR"中的"HIY"‘混沌初开’"NOR"将$N的攻击化为无物。\n",
	"$n的身影不动, 等到$N的攻击到时, 突然消失在$N面前, 正是一招"HIW"‘残以欺人’"
NOR"。\n",
	"$n身形旋绕, 轻巧的一招"HIR"‘飞龙在天’"NOR", 数个转身, 将$N的攻势化为如清风吹过一般的无害。\n",
	"$n快步移位, 身影忽快忽慢, 变化莫测, 正是"HIG"‘青玄身法’"NOR"中的最高境界－－"HIW"‘实虚不分’"NOR", 使$N的攻击失效。\n",
});

int valid_enable(string usage)
{
	return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if(me->query("kee") < 30 )
		return notify_fail("你的气不够，没办法练青玄身法。\n");
	me->receive_damage("kee", 30);
	return 1;
}
