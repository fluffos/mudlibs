
// keng_kee.c

#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

int perform(object me, object target)
{
        int ski_value;
        int kee_lv;
        string msg;
        object ob;
        string *name;
        ski_value= random(me->query_skill("shasword",1))+query_function("sha_kee")*2;
       kee_lv =query_function("sha_kee");
        if( !target ) target = offensive_target(me);
        if(!me->is_fighting())
        {        tell_object(me,"万剑诀唯在战斗中才能使用。\n");
                return 1;
         }
           if( me->query_skill("shasword",1) < 20 )
            return notify_fail("你的剑法技巧不足。\n");
         if(me->query("force")<100)
             return notify_fail("你的内力不够。\n");
         if(me->query("kee")< 80)
             return notify_fail("你的气不够。\n");
        message_vision("[1;34m $N纵身一跃 ,体内暗运内劲 ,身体浮沈于半空之中 , 突然间周围草木由耸动而渐渐
        剑拔弩张 ,一根根成为蓄势待发的利器\n[0m",me,target); 
        message_vision(
            "\n\n[1;37m$N指成剑姿大喝一声 万剑诀 , 瞬间四周万剑齐发..！[0m\n\n\n",me,target);
        if( ski_value <  5 ){
           me->add("force",-50);
          write("[1;35m\n不过一把都没有命中 ,你当场羞红了脸将剑收回\n[0m");
          say( "[1;35m你发现空中乱剑飞舞 ,不过就是没有命中敌人 ,不禁指着"+me->query("name")+"的鼻子大笑\n[0m");     
          }
        else if( ski_value < 20  )
          {
          me->add("force",-50);
          target->add("kee",-10-kee_lv);
          write ( "[1;35m你发现大部分的剑都朝地上打去 ,甚至还打向自己 ,你发誓要好好练剑
                   将来方能完全驾驭\n[0m");
          say( "[1;35m你看到空中一堆剑朝你射来 ,妈啊～快闪..发现原来是"+me->query("name")+"这个家伙在舞剑\n[0m");
          }
          else if( ski_value < 40 )
          {
           me->add("force",-50);
           target->add("kee",-30-kee_lv);
          write ("[1;35m已有一些能准确命中敌人 ,使的敌人受创不小\n[0m");
          say("[1;35m你看见空中一些气剑任"+me->query("name")+"挥洒自如 ,心中暗暗钦佩\n[0m");
                 }
          else if( ski_value < 60)
          {
           me->add("force",-50);
          target->add("kee",-70-kee_lv);
          
          write("\n[1;35m 十之八九的气剑朝敌人激射而去 ,使敌人受到严重的创伤\n[0m");
          say("\n[1;35m成千上万的气剑群集朝一目标射去 ,看的你瞠目结舌 , 半晌说不出话来\n[0m ");
          }
          else 
          {
           me->add("force",-50);
           target->add("kee",-100-kee_lv);
           
          write("[1;35m 在你双手挥舞之下 ,万剑均命中敌人 ,穿体而过 ,敌人痛苦的嘶吼着\n[0m");
          say("[1;35m 你不敢相信眼前滂勃的气势 ,群天的气剑掩\盖\了耀眼的阳光 ,却发出一股
                更为绚丽的光芒\n[0m");  
           }           
           me->start_busy(1);
           write("你耗费大量真力 ,得休息一回合才能继续攻击\n");
           function_improved("sha_kee",random(me->query("force")/20));
        return 1;
}
