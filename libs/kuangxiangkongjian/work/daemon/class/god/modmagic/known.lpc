 
#include <ansi.h>

int perform(object me,string arg)
{
	int lv;
	object obj;
	seteuid(getuid());
	lv=F_MAGIC->query_magic(me,"known");
	if(!arg||!(obj=present(arg,environment(me))))
		return notify_fail("这里没这人。\n");
	if(!living(obj))
	return notify_fail("你只能算生物。\n");
	if(me->query("atman")<10)
		return notify_fail("你的灵力不够，不能用火邪大法。\n");
	message_vision(HIG "$N盘指一算～～～～。\n",me);
	message_vision(NOR,me);
	if(lv<10)
		tell_object(me,"你算了许\久，但算不出个所以然来。\n"NOR);
	if(lv>=10)
		tell_object(me,"此人相貌"+(obj->query("per")>=20 ? "堂堂" : "平凡" )+"。\n");
	if(lv>=20)
		tell_object(me,"此人天资"+(obj->query("int")>=20 ? "聪颖" : "平庸" )+"。\n");
	if(lv>=30)
		tell_object(me,"此人胆识"+(obj->query("cor")>=20 ? "过人" : "平凡" )+"。\n");
	if(lv>=40)
		tell_object(me,"此人体格"+(obj->query("con")>=20 ? "极佳" : "不佳" )+"。\n");
	if(lv>=50)
		tell_object(me,"此人法力"+(obj->query("max_mana")>me->query("max_mana") ? "不在你之下" : "不及你" )+"。\n");
	if(lv>=60)
		tell_object(me,"此人灵力"+(obj->query("max_atman")>me->query("max_atman") ? "不在你之下" : "不及你" )+"。\n");
	if(lv>=70)
		tell_object(me,"此人内力"+(obj->query("max_force")>me->query("max_force") ? "不在你之下" : "不及你" )+"。\n");
	if(lv>=80)
		tell_object(me,"此人实战能力"+(obj->query("combat_exp")>me->query("combat_exp") ? "不在你之下" : "不及你" )+"。\n");
	tell_object(me,NOR);
	me->add("atman",-10);
	F_MAGIC->add_magic(me,"known",random(me->query("spi")));
	return 1;
}
 
 
