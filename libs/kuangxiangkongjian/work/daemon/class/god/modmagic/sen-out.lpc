 
#include <ansi.h>
#define BODY "/obj/body.lpc"
int perform(object me,string arg)
{
	int lv;
	object obj;
	seteuid(getuid());
	lv=F_MAGIC->query_magic(me,"sen-out");
	if(me->query("sen-out"))
		return notify_fail("你已经在使用元神出窍了。\n");
	if(me->query("atman")<100)
		return notify_fail("你的灵力不够，不能用火邪大法。\n");
	message_vision(
	HIW "$N口中念着「波罗心咒”，随即运起灵力，忽地元神出了窍！\n",me);
	message_vision(NOR,me);
	tell_object(me,"你的元神不能离开太久，若是不能在时间内回到肉身(return)，将会死去。\n");
	obj=new(BODY);
	obj->move(environment(me));
	obj->set_name(me->name(),({me->query("id")}));
	obj->set("gender",me->query("gender"));
	obj->set("age",me->query("age"));
	obj->set("title",me->query("title"));
	me->apply_condition("out_status",lv/2);
	me->apply_condition("out_status",lv/2+10);
	obj->set("owner",me->query("id"));
	me->set("name",me->query("name")+"的元神");
	me->add_temp("apply/attack",10);
	me->add_temp("apply/dodge",10);
	me->add_temp("apply/damage",30);
	me->set("sen-out",1);
	me->add("atman",-100);
	F_MAGIC->add_magic(me,"sen-out",random(me->query("spi")));
	return 1;
}
 
 
