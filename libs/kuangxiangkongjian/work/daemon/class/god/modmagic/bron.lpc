#include <login.h>
#include <ansi.h>

int skill_recover(object);
int perform(object me, string arg) {
  int lv;
  object obj;
  seteuid(getuid());
  lv = F_MAGIC->query_magic(me, "bron");
  if (me->query("max_atman") < 500 || me->query("atman") < 500)
    return notify_fail("你的灵力不够。\n");
  obj = find_player(arg);
  if (!obj) return notify_fail("没有这个玩者。\n");
  if (1 < 0)
    return notify_fail("你只能救回活人的魂魄。\n");
  message("system", HIB "一位道行高深的法术家" + me->name() + "～～～\n\n施展出九道仙法中的「九转还魂”！\n\n" NOR,
    users());
  if (random(lv) > find_player(arg)->query("combat_exp") / 1000) {
    message(
      "system",
      HIW "天空的云层中．．．\n\n一名乘着白鹤的仙人从云里穿出～～～\n\n只见仙人口中念念有词，伸手一变！\n\n" + obj->name() + "的灵魂由阴间回到阳间～～～\n\n随即仙人立刻消逝无踪．．．\n",
      users()
    );
    message("system", NOR, users());
    obj->reincarnate();
    if (obj != me)
      obj->move(environment(me));
    else
      me->move(REVIVEROOM);
    skill_recover(me);
  } else
    message("system", HIW "但是很可惜～～～\n\n" + me->name() + "的法术并没有成功\．．．\n\n" NOR, users());
  me->add("atman", -50);
  me->add("max_atman", -50);
  F_MAGIC->add_magic(me, "bron", random(me->query("spi")));
  return 1;
}


int skill_recover(object me) {
  mapping skill = me->query_skills();
  string *name;
  int i;
  name = keys(skill);
  for (i = 0; i < sizeof(name); i++)
    me->set_skill(name[i], me->query_skill(name[i], 1) + 1);
  return 1;
}
