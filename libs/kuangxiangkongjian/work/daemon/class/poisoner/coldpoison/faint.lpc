// counterattack.c
 
#include <ansi.h>
 
inherit SSERVER;
 
int perform(object me, object target)
{
        string msg;
        object ob;
 
        if( !target ) target = offensive_target(me);
        if(!ob = present("faint poison",me))
                return notify_fail("你的身上没有一刻香。\n");
	if( environment(me)->query("no_fight") )
		return notify_fail("这里不准战斗。\n");
	if( target->query("no_kill") )
		return notify_fail("这个家伙你不能动就是不能动。\n");

  if( target && ((me->query("mud_age") - target->query("mud_age")) > 300000) && userp(target) && userp(me) )
    return notify_fail("请勿以长辈身份欺负晚辈。\n");

       msg=HIY "$N从口中放出迷烟，往$n吹去！\n" NOR;
        
if(random(me->query_skill("poison"))>random(target->query_skill("dodge"))) {
        msg+= GRN "$n一不留神，吸到迷烟，行动变缓了。\n" NOR;
	target->receive_damage("sen",random(me->query_skill("poison")/4) );
	target->start_busy(1+random(me->query_skill("coldpoison",1))/20);
        } else {
        msg+=HIG "$n识破了$N的毒招，身子一侧，避了开去。\n" NOR;
	me->start_busy(1);
        }
        message_vision(msg, me, target);
           me->kill_ob(target);
        ob->add_amount(-1);
        return 1;
}
 
