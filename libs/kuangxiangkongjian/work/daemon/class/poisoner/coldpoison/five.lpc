// counterattack.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	object ob;

	if( !target ) target = offensive_target(me);

	if(!present("five poison",me))
		return notify_fail("你的身上没有五毒。\n");
	if( environment(me)->query("no_fight") )
		return notify_fail("这里不准战斗。\n");
	if( target->query("no_kill") )
		return notify_fail("这个家伙你不能动就是不能动。\n");

      msg=HIC "$N使出五毒神掌，毒气逼人，朝着$n一掌拍去！\n";

  if( target && ((me->query("mud_age") - target->query("mud_age")) > 300000) && userp(target) && userp(me) )
    return notify_fail("请勿以长辈身份欺负晚辈。\n");

    me->start_busy(2);
        if(random(me->query_skill("poison",1))>random(target->query_skill("dodge
")+target->query_skill("parry"))*2)
	{
     msg+=HIR "结果「碰”的一声，$n身上已留下一个黑掌印。\n" NOR;
     target->apply_condition("five_poison",target->query_condition("five_poison")+me->query_skill("coldpoison",1)/10);
	} else {
        msg+= HIG "$n见情势危急，急防躲开。\n" NOR;
	}
	message_vision(msg, me, target);
          me->kill_ob(target);
	ob=present("five poison",me);
	ob->add_amount(-1);
	return 1;
}
