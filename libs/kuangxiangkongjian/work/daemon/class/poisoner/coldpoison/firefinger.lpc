// kee-wind.c

#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object ob;
  string *name;

  if (!target) target = offensive_target(me);

  if (!me->is_fighting()) {
    tell_object(me, "火云柔指要在战斗中才能使用。\n");
    return 1;
  }
  if (me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  if (me->query_skill("coldpoison", 1) < 20)
    return notify_fail("你的天冰奇毒火喉不够，无法使用火云柔指。\n");
  message_vision(HIR "$N身形一转，右手食指指尖散出红光，忽地一指伸出，往$n点去！\n", me, target);
  if (random(query_function("firefinger") * 6) > random(target->query_skill("dodge") + target->query_skill("parry"))) {
    message_vision(HIC "$n一发觉不妙，可惜已经来不及了，$N右手指尖已在$n划出一道伤痕。\n", me, target);
    target->apply_condition(
      "fire_poison",
      target->query_condition("fire_poison") + query_function("firefinger") / 3
    );
    target->receive_wound("kee", 5 * query_function("firefinger"));
  } else
    message_vision(HIC "$n发觉不妙，身子轻轻一纵，一个转身避了开去。\n", me, target);
  me->add("force", -50 + query_function("firefinger") * 2 / 3);
  if (query_function("firefinger") * 3 < me->query_skill("coldpoison", 1))
    function_improved("firefinger", random(me->query("force") / 5) + 3);

  message_vision(NOR, me);
  return 1;
}
