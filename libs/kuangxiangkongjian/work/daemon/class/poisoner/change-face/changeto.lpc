// change-face.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int perform(object me,object target)
{
	int skill;
          string cname,ctitle,cnick;
          if(random(me->query_skill("face"))<50)
              return notify_fail("你失败了。\n");
           if(me->query_temp("change-face")==1)
               return notify_fail("你已经在用了。\n");
           cname=target->query("id");

          cname[0]=cname[0]-32;
         skill=(int)me->query_skill("change-face")*2;
	message_vision(
          HIG "$N使用易容术，将自己化成$n的模样。\n" NOR,me,target);

          if (!target->query("title"))
             ctitle="";
          else   ctitle=target->query("title");
          if (!target->query("nickname"))
                 cnick=" ";
          else  cnick="「"+target->query("nickname")+"”";
         me->set("short",ctitle+cnick+target->name()+"("+cname+")");
          me->set_temp("cname",me->name());
          me->set("name",target->name());
         me->set_temp("ctitle",me->query("title"));
          me->set_temp("change-face",1);
          me->set("title","");
          me->set_temp("gender",me->query("gender"));
          me->set("gender",target->query("gender"));
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill);


	return 1;
}

void remove_effect(object me, int amount)
{
         me->delete("short");
          me->set("name",me->query_temp("cname"));
           me->set("gender",me->query_temp("gender"));
           me->delete_temp("gender");
          me->delete_temp("cname");
          me->set("title",me->query_temp("ctitle"));
         me->delete_temp("change-face");
        me->delete_temp("ctitle");
        message_vision(
          HIG "$N的易容术失去了效力，恢复成本来面貌。\n" NOR,me);
}
