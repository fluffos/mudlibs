// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
	object ob;
	int skill;

	return notify_fail("此技能暂时停用。\n");
	if( target != me ) return notify_fail("你只能运六阳功\提升自己的紫金六阳刀法威力。\n");

	if((string)me->query_skill_mapped("blade")!="gold-blade")
	return notify_fail("只有在使紫金六阳刀法时才能运六阳功\。\n");
	if(!(ob=me->query_temp("weapon"))
	||(string)ob->query("skill_type")!="blade")
	return notify_fail("只有在使紫金六阳刀法时才能运六阳功\。\n");
	if( (int)me->query("force") < 100 )	return notify_fail("你的内力不够。\n");
	if( (int)me->query_temp("powerup") ) return notify_fail("你已经在运功\中了。\n");

	skill = me->query_skill("force");

	me->add("force", -100);
	me->receive_damage("kee", 0);

	message_vision(
	HIR "$N运起六阳功\ ,紫金六阳刀法威力大增 !\n"NOR,me);

	me->add_temp("apply/attack",skill/2);
	me->set_temp("powerup", 1);

	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill);

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me, int amount)
{
	me->add_temp("apply/gold-blade",- amount);
	me->delete_temp("powerup");
	tell_object(me, "你的六阳功\慢慢弱了下来 ,气回丹田。\n");
}
