// fast-dest.c by konn

#include <combat.h>
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
        object *enemy, weapon, mob;

        enemy = me->query_enemy();

	if( me->query_skill("fast-blade", 1) < 70 ) {
            tell_object(me, "你的幔罗千叶刀法根基不够，"+
                            "没办法使出无影狂刀斩。\n");
	    return 0;
	}

        if( me->query_skill_mapped("blade") != "fast-blade" ) {
            tell_object(me, "只有在使幔罗千叶刀法时才能使出无影狂刀斩。\n");
	    return 0;
	}

        if( !(weapon = me->query_temp("weapon")) ||
            weapon->query("skill_type") != "blade" ) {
            tell_object(me, "没有刀是使不出无影狂刀斩的。\n");
	    return 0;
	}

        if( !me->is_fighting() ) {
            tell_object(me, "你想用无影狂刀斩砍谁?\n");
	    return 0;
	}

        if( me->query("force") < 400 ) {
            tell_object(me, "你的内力不够, 使不出无影狂刀斩。\n");
	    return 0;
	}

        if( me->query_temp("fast/time") ) {
            tell_object(me, "你方才已施展了一次无影狂刀斩, 现在已无力再使。\n");
	    return 0;
	}

        message_vision(HIW "只见$N手中的刀越舞越快, 身法随着刀法跟着加快, \n"+
                           "身影也愈来愈糢糊, $N身旁的人\n"+
                           "已无法看清楚$N的位置了, $N忽然大喝一声\n"+
                           HIY "「无影狂刀斩～～”\n" HIW +
                           "接着开始无声无息的攻击各个敌人。\n" NOR, me);

        me->add("force", -300);

        if( !catch(load_object("/open/gblade/room/fast_room.lpc")) ) {
            if( !(mob = find_living("fast-dest man")) &&
                !(mob = find_object("fast-dest man")) )
            return notify_fail("出bug了! 快post告诉konn。\n");
        }
        else return notify_fail("出大bug了! 快post告诉konn。\n");

        mob->fast_dest(me);

        return 1;
}       
