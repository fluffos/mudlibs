// master.c
// modify attempt_apprentice() by Oda (85/5/31)
// fix it by Lum(5/31/1996)
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
 
// 此 npc 为门派 master 请勿随意更动  (fund)
string check_damage()
{
	object me = this_player();
	if( me->query("quests/kill-dugur") )
		return "你身上的伤痕是独孤愁的独门绝技「枯叶残星掌”，中掌处一片枯干有如一片的枯叶，好在他只使出六成功\力，不然你早就死了。\n";
	return "你的身上有伤吗 ?";
}
string be_young()
{
	if( !present( "lock box" , this_player() ) ||
	    this_player()->query("sec_kee") != "dragon" )
		return "呵呵 ... 你什么条件都没有，也想返老还童 .. 哈哈 !";
	return "带着锁元盒到仙云山去找仙云圣人，设法叫他帮你吧。\n";
}
string cure_damage()
{
	object me = this_player();
	if( me->query("quests/kill-dugur") && !me->query("quests/cure-star") ) {
		command("say 好 ! 我帮你治伤 !");
		message_vision("只见神秘老人手掌贴着$n的背，过了不久，冒了阵烟，$n身上的伤口渐渐消失。\n",this_object(),me);
		me->set("quests/cure-star",1);
		return "没想到独孤老贼竟然还没死，我报仇之日即将来临啦 !";
	}
	return "?";
}
void create()
{
        set_name("神秘老人",({"oldman"}));
        set("gender", "男性" );
        create_family("魔刀莫测",1," ");
            set("title","");
         set("age",70);
      set("str",30);
        set("class","blademan");
        set("guild_class","blademan");
        set("cor", 30);
        set("cps", 27);
        set("int", 24);
 
        set("max_force",2000);
        set("force",2000);
           set("force_factor",10);
	set("kee",5000);
	set("max_kee",5000);
 
 
       set("long","一个看起来全身脏盻盻的老人，脚上还有一个脚铐，看起来像是被关b这里的。\n");
 
        set_skill("force",70);
            set_skill("blade",100);
        set_skill("unarmed",60);
        set_skill("dodge",70);
             set_skill("literate",60);
        set_skill("powerforce",100);
        set_skill("dragon-blade",120);
        map_skill("blade","dragon-blade");
        map_skill("force","powerforce");
 
        set("combat_exp", 1000000);
        set("score", 200000);
        set("chat_chance_combat",60);
        set_temp("apply/armor",80);
        set_temp("apply/damage",80);
         set("chat_msg_combat",({
        (: perform_action, "blade.power-dest" :),
      }));
 
 
 
 
        set("inquiry", ([
           "独孤愁":  "这个老贼用暗招，把我关在这十几年，这个仇....我一定要报！\n",
           "脚铐": "这个脚铐是用千年寒铁石打造的，一般兵器是砍不断的。\n",
           "千年寒铁石": "这是经过千年孕育而成的坚硬石块，除非有神兵利器，不然无法砍断。\n",
           "神兵利器": "听说人间至宝「金鳞蟒邪”配上「天邪石”可以毁灭千年寒铁石。\n",
           "金鳞蟒邪":  "听说金鳞蟒邪好像落在茅山派手上。\n",
	"疗伤" : (: cure_damage :),
           "天邪石":   "天邪石在独孤愁这个老贼手里！！！\n",
		"青龙之笛" : "此乃儒门家传之宝，相传可以召唤神龙。\n",
	"神龙" : "据传说，雪苍山中某处呈青龙降临之势，可能神龙便是藏身在那里。\n",
	"去老还童术" : (: be_young :),
	"我的伤" : (: check_damage :),
	"锁元盒" : "是一种可以用来暂时寄放元力的宝盒。\n",
	"青龙之气" : "传说青龙之气有去老还童的功\能，但是若无锁元盒，一但还童，会功\力尽失。\n",
        ]) );
 
	add_temp("apply/attack",30);
	add_temp("apply/dodge",30);
        setup();
        carry_object("/open/snow/obj/poor_blade")->wield();
}
 
void init()
{
}
void attempt_apprentice(object ob,string str)
{
        // 不知道谁在这里放 if(0) 让后面的检查都不会执行
        //if(0)
        if( this_player()->query("can_apprentice") == 2 )
         {
             command("say 你我无缘，你走吧！");
             return;
         }
        //if(0)
        if(this_player()->query("can_apprentice")!=1)
          {
          command("say 滚！你给我滚开！\n");
          return;
          }
        if (this_player()->query("quests/blade_out") == 1) {
           command("say 凡我门徒，不得将我绝学再传他人。");
        recruit_apprentice( this_player() );
              this_player()->set("title","魔刀传人");
	this_player()->set("no_recruit", 1);
	this_player()->delete("can_apprentice");
   }
}
 
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
            ob->set("class","blademan");
}
int accept_object(object who,object ob)
{
    string ob_id;
    ob_id=ob->query("id");
   if (who->query("quests/blade_out") == 0) {
      if(ob_id=="snake sword")
     {
        command("say 太好了，这正是我需要的东西！");
             this_player()->set("give_1",1);
	destruct(ob);
     }
        if(ob_id=="stone")
         {
             command("say 我没看错吧，你竟然能将天邪石拿到手！");
            this_player()->set("give_2",1);
		destruct(ob);
         }
       if(who->query("give_1")==1&&who->query("give_2")==1)
        {
            command("say 太好了！");
            message_vision(
             HIY "$n将天邪石的神力注入金鳞蟒邪之中，然后运劲一砍，将脚铐砍断。\n
" NOR,this_player(),this_object());
           CHANNEL_D->do_channel(this_object(),"mud",HIR "远处传来魔刀莫测的大喝：\n\n我自由了！哈哈哈哈！！！\n\n独孤愁！你这个老贼等者吧！我要一雪这十几年禁锢之恨！\n" NOR);
        if( who->query("kar") > 20 ) who->set("can_apprentice",1);
           else who->set("can_apprentice",2);
         command("say 非常感谢你帮我重获自由。");
       if(this_player()->query("can_apprentice")==1) {
         command("say 莫某愿将毕生所学传与你。\n");
         who->set("quests/blade_out",1);
    }
      if(this_player()->query("can_apprentice")==2)
       {
           command("say 但莫某觉的我俩并不有缘");
           command("say 好吧！我将部分内力传给你。");
           this_player()->add("max_force",100);
           this_player()->add("force",100);
           who->set("quests/blade_out",1);
        }
	who->delete("give_1");
	who->delete("give_2");
            }
   }
      else{
	     if( ob_id!="snake sword" && ob_id!="stone" ) return 1;
              message_vision("神秘老人说道:感谢$N，我这就去宰了独老贼。\n",who);
		destruct(ob);
              return 1;
            }
 
          return 1;
}
