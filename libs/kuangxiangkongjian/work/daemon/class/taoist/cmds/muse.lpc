// exercise.c

#include <skill.h>

inherit F_CLEAN_UP;
inherit F_GUILDCMDS;

int main(object me, string arg)
{
	int sen_cost,mana_gain;
	seteuid(getuid());
	if(me->query("class") != "taoist" )
		return 0;
        if(me->query_condition("ff_poison"))
          return notify_fail("你气血失调，无法冥思\n");
	if( me->is_fighting() )
		return notify_fail("战斗中ㄟ！\n");

	if( !arg ) sen_cost = 10;
	else if (!sscanf(arg, "%d", sen_cost))
		return notify_fail("你要花多少神冥思？\n");

	if( sen_cost < 10 ) return notify_fail("你最少要花 10 点「神”才能冥思。\n");

	if( (int)me->query("sen") < sen_cost )
		return notify_fail("你现在精神状况太差了，无法凝神专一！\n");

	message_vision("$N坐下来冥思。\n",me);

	me->receive_damage("sen", sen_cost);
	mana_gain = sen_cost * (me->query_skill("gmagic",1) + me->query("spi")*2 )/200;

	// me->add("force", force_gain );
	// 增加乱数
	me->add("mana",mana_gain);

	if( (int)me->query("mana") > (int)me->query("max_mana") * 2) {
		if( (int)me->query("max_mana") >= 
		((int)me->query_skill("gmagic",1)/5 +
		me->query_skill("gmagic") ) *10
		  )
		{
			write("你的法力没有提升的迹象，似乎精神修为已经遇到了瓶颈。\n");
		} else {
			write("你的法力提升了！\n");
			me->add("max_mana", 2);
		}
		me->set("mana", me->query("max_mana"));
	}	
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : muse [<耗费「神”的量，预设值 20>]

凝神冥想，用以提升精神力量而转为法力的储存。
请参考 help stats
HELP
        );
        return 1;
}
