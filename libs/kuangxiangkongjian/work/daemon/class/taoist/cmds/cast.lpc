// cast.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string spells;
	
	seteuid(getuid());

	if( environment(me)->query("no_magic") )
		return notify_fail("这里不准念咒文。\n");

	if( !arg )
		return notify_fail("你要吟诵什么咒文？\n");

	if(stringp(spells = me->query_skill_mapped("spell")) )
		return (int)SKILL_D(spells)->cast_spell(me, arg);
	if( stringp(spells = me->query_skill_mapped("magic")) )
		return SKILL_D(spells)->cast_spell(me,arg);
		
	return notify_fail("你请先用 enable 指令选择你要使用的咒文系。\n");
}

int help (object me)
{
        write(@HELP
指令格式:cast <咒文名称> [<施咒对象>]
 
施法，你必需要指定<咒文名称>，<施咒对象>则可有可无。
在你使用某一个咒文之前，你必须先用 enable 指令来指定你要使用的咒文系。
 
注：如果你改变自己的咒文系，你原本蓄积的法力并不能直接转换过去，必须
    从 0 开始。
 
HELP
        );
        return 1;
}
