//master of taoist
#include "/open/main/main.h"
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("玉矶道人",({"Master of taoist","master","taoist"}) );
        set("long",
        "负责教导初入道的道士们一些基础的修行及\n
        简单的茅山术,想加入道士的行列请(join)。\n" );
        set("gender", "男性" );

        set("class","taoist");
        set("guild_master",1);

        set("combat_exp",1000);
        set("max_mana",200);
        set("mana",200);
        set_skill("parry",40);
        set_skill("dodge",40);
        set_skill("force",50);
        set_skill("literate",60);
        set_skill("magic",50);
        set_skill("move",40);
        set_skill("cure",30);
        set_skill("whip",70);

        setup();
        carry_object(MA_OBJ"tao_shoes")->wear();
        carry_object(MA_OBJ"tao_hat")->wear();
        carry_object(MA_OBJ"tao_robe")->wear();
        carry_object(MA_OBJ"whisk")->wield();

}

void init()
{
        add_action("do_join","join");
        add_action("do_verify","verify");
}

int do_verify(string str)
{
        object me,ob;

        me = this_player();

        if( !str )
        {
          if( me->query("class") != "taoist" ) return 0;
        if( !(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "whip")
        {
          ob = new(MA_OBJ"whisk");
          if (ob) {
            ob->move(me);
            printf("%s给%s一把拂尘\n",this_object()->query("name"),
            me->query("name"));
          }
          return 1;
        }
        else
          return notify_fail("有武器了还跟我要。\n");
        }
        else
          return 0;
}

int do_join(string str)
{
        object ob,me;
        me = this_player();
        if(str!=0)
          return notify_fail("请打\"join\"即可。\n");

        if(me->query("class") == "taoist" )
            return notify_fail("你不要开玩笑了，你不是早就加入了吗？\n");

        if( me->query("class") )
          return notify_fail("你已经加入了别的工会了\n");

        if((int) me->query("int")<20)
        {
         command("hmm");
         command("say 你的资质太差了,不适合加入我们,施主请回吧!!");
         return notify_fail("没法度\n");
        }
        message_vision(HIR"玉机道人喃喃的念起了一段咒语"NOR);
        command("say 加入了道教就要守清规，不可为非作歹，辱了老君的清名。");

        ob = new(MA_OBJ"whisk");
        ob->move(me);

        printf("%s给%s一把拂尘。\n",this_object()->query("name"),
        me->query("name") );
        me->set("class","taoist");
        return 1;
}
