// invocation.c
#include <ansi.h>
int cast(object me, object target) {
  object soldier;


  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < 60)
    return notify_fail("你的精神无法集中！\n");

  message_vision("$N喃喃地念了几句咒语。\n", me);

  me->add("mana", -100);
  me->receive_damage("sen", 60);

  if (random(me->query("max_mana")) < 200) {
    message("vision", "但是什么也没有发生。\n", environment(me));
    return 1;
  }

  seteuid(getuid());
  soldier = new("/obj/npc/god");
  message_vision(
    HIW "$N的身影一分为二，变出了$N的分身。\n" NOR, me);
  soldier->set_name(me->name() + "的分身", ({ "sub " + me->query("id") }));
  soldier->move(environment(me));
  soldier->invocation(me);
  soldier->set_temp("id", me->query("id"));
  soldier->set("force", me->query("force"));
  soldier->set("max_force", me->query("max_force"));
  soldier->set("kee", me->query("kee"));
  soldier->set("max_kee", me->query("max_kee"));
  soldier->set("eff_kee", me->query("eff_kee"));
  soldier->set("combat_exp", me->query("combat_exp"));
  soldier->set("gender", me->query("gender"));
  return 1;
}
