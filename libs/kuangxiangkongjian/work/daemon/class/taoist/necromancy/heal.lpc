// counterattack.c

#include <ansi.h>

int cast(object me, object target) {
  string msg;
  int orik, maxk;
  orik = me->query("kee");
  maxk = me->query("max_kee");
  if (orik == maxk)
    return notify_fail("气满了还补。\n");
  if (!target)
    target = me;
  if (me->is_fighting())
    return notify_fail("这法术不能在战斗中使用。\n");
  if (me->query("mana") < 10)
    return notify_fail("你的法力不足\n");
  msg = CYN "$N突然唸着：" NOR;
  msg += HIR "万能的天神，请恢复我的生命力吧！\n" NOR;
  msg += CYN "突然一阵光芒包住了" + target->query("name") + NOR + "\n";
  if ((maxk - orik) >= ((me->query_skill("gmagic", 1) / 2) + 5))
    me->receive_heal("kee", (me->query_skill("gmagic", 1) / 2) + 5);
  else
    me->set("kee", maxk);
  me->add("mana", -10);
  message_vision(msg, me);
  me->improve_skill("necromancy", random(me->query("spi")));
  return 1;
}
