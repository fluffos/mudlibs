// hell_guard.c

#include <ansi.h>
#include <combat.h>

inherit NPC;

#define bell_big 100
#define bell_small 5
#define SPELLLVL 30
#define MANACOST 75

int special_att ();

void create()
{
	set_name("天兵", ({ "local god", "god" }) );
	set("long", "他玉皇大帝手下天兵。\n");
	set("attitude", "friendly");

	set("max_gin", 800);
	set("max_kee", 800);
	set("max_sen", 800);

	set("max_atman", 100);
	set("atman", 100);
	set("max_mana", 100);
	set("mana", 100);
	set("max_force", 800);
	set("force", 800);
	set("force_factor",8);

	set("str", 30);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 2000);

	set_skill("sword", 50);
	set_skill("parry", 60);
	set_skill("dodge", 70);

	setup();

	carry_object(__DIR__"obj/golden_armor")->wear();
	carry_object(__DIR__"obj/golden_sword")->wield();
}

int heal_up()
{
	if (!is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
  object who = query_leader ();
  message_vision (HIB"$N说道：末将奉法主召唤，现在已经完成护法任务，就此告辞！\n" +
		  "一阵清风吹过，$N的身形随之不见了。\n" NOR, this_object ());
  if (who)
    who->add_temp ("invocation", -1);
  destruct(this_object());
}

void die ()
{
  object who = query_leader ();
  if (who)
    who->add_temp ("invocation", -1);
  message_vision (HIB"$N惨叫一声啊！消失得无影无踪。\n", this_object ());
  destruct (this_object ());
}

void invocation(object who)
{
	int i, bell;
	object *enemy;
	object me = this_object ();

	message_vision (HIB"一阵清风吹过，走出一个$N。\n" +
			"$N说道：奉命来到。\n" NOR, me);
	bell = (int)who->query ("bellicosity");
	if (bell < bell_small)
	  {
	    message_vision (HIW"长笑道：圣人有令，怎敢不从？\n", me);
	  }
	else if (bell < bell_big ||
	         (int)who->query ("combat_exp") > 5000)
	  {
	    message_vision ("$N微一皱眉：如此小事，也来差遣我？！\n", me);
	  }
	else
	  {
	    message_vision (HIB"N$怒喝：何方妖魔，胆敢妄遣天兵？。\n", me);
	    kill_ob (who);
	    set_leader (who);
	    return;
	  }

	enemy = who->query_enemy ();
	i = sizeof(enemy);
	while(i--) {
		enemy[i]->fight_ob(this_object());
		fight_ob(enemy[i]);
/* 由于潜能及经验分配问题，不能用 kill
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
*/
	}
	set_leader(who);
}

int spell ()
{
  return SPELLLVL;
}

int manacost ()
{
  return MANACOST;
}
