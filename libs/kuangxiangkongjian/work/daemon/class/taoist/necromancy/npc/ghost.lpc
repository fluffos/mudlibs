// hell_guard.c

#include <ansi.h>

inherit NPC;

#define bell_small 5
#define bell_big 50
#define SPELLLVL 2
#define MANACOST 50

void create()
{
	set_name("大头鬼", ({ "hell ghost", "ghost" }) );
	set("long", "这是一个来自阴界的恶鬼，专门来抓要死的人。骗骗小孩和吓唬老头子是它专长。\n");
	set("attitude", "friendly");

	set("max_gin", 500);
	set("max_kee", 500);
	set("max_sen", 500);

	set("max_atman", 100);
	set("atman", 100);
	set("max_mana", 100);
	set("mana", 100);

	set("str", 40);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 500);

	set_skill("whip", 30);
	set_skill("parry", 50);
	set_skill("dodge", 50);

	setup();

	carry_object(__DIR__"obj/ghost_armor")->wear();
	carry_object(__DIR__"obj/ghost_whip")->wield();
}

int heal_up()
{
	if (!is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
  object who = query_leader ();
  if (who)
    who->add_temp ("invocation", -1);
  message_vision (HIB"$N说道：末将奉法主召唤，现在已经完成护法任务，就此告辞！\n" +
		  "一阵阴风吹过，$N的身形随之不见了。\n" NOR, this_object());
  destruct (this_object());
}

void die ()
{
  object who = query_leader ();
  if (who)
    who->add_temp ("invocation", -1);
  message_vision (HIB"$N惨叫一声：啊！化为灰烬。\n" NOR, this_object());
  destruct (this_object ());
}

void invocation(object who)
{
	int i, bell;
	object *enemy;

	message_vision (HIB "一阵阴风吹过，走出一个面目狰狞的$N。\n" +
			"$N喝道：何人打搅于我？！\n" NOR, this_object());
	bell = (int)who->query ("bellicosity");
	if (bell < bell_small)
	  {
	    message_vision ("恶鬼媚笑道：圣人有令，怎敢不从？\n", this_object ());
	  }
	else if (bell > bell_big ||
	         (int)who->query ("combat_exp") > 500)
	  {
	    message_vision ("恶鬼媚笑道：小事一桩。\n", this_object ());
	  }
	else
	  {
	    message_vision (HIR"$N怒喝：本事不到家居然敢消遣本大鬼。\n", this_object ());
	     kill_ob (who);
	     set_leader (who);
	     return;
	  }

	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		fight_ob (enemy[i]);
		enemy[i]->fight_ob (this_object ());
/* 不能杀人
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
*/
	}
	set_leader(who);
}

int spell ()
{
  return SPELLLVL;
}

int manacost ()
{
  return MANACOST;
}
