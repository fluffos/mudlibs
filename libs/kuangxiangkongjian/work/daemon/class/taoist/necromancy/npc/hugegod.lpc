// hell_guard.c

#include <ansi.h>
#include <combat.h>

inherit NPC;

#define bell_big 200
#define bell_small 0
#define SPELLLVL 50
#define MANACOST 100

int special_att();

void create() {
  set_name("巨灵神", ({ "huge god", "god" }));
  set("long", "他是天兵小头领，打过不知多少大仗小仗。\n" +
    "他是名副其实的巨人，有一栋楼之高。他手\n" +
    "里的一把轮盘大斧也不之劈下多少妖魔鬼怪\n" +
    "的脑袋。你见了他的头一映象就是想逃，只\n" +
    "可恨爹妈少给你生两条腿。\n");
  set("attitude", "friendly");

  set("max_gin", 1500);
  set("max_kee", 1500);
  set("max_sen", 1500);

  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 15);

  set("str", 50);
  set("cor", 30);
  set("cps", 25);

  set("combat_exp", 5000);

  set_skill("axe", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);

  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({ (: special_att :) }));

  setup();

  carry_object(__DIR__ "obj/golden_armor")->wear();
  carry_object(__DIR__ "obj/hugeaxe")->wield();
}

int heal_up() {
  if (!is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  object who = query_leader();
  message_vision(HIB "$N说道：末将奉法主召唤，现在已经完成护法任务，就此告辞！\n" +
    "一阵清风吹过，$N的身形随之不见了。\n" NOR, this_object());
  if (who)
    who->add_temp("invocation", -1);
  destruct(this_object());
}

void die() {
  object who = query_leader();
  if (who)
    who->add_temp("invocation", -1);
  message_vision(HIB "$N惨叫一声啊！消失得无影无踪。\n", this_object());
  destruct(this_object());
}

void invocation(object who) {
  int i, bell;
  object *enemy;
  object me = this_object();

  message_vision(HIB "一阵清风吹过，走出一个身高十丈的$N。\n" +
    "$N喝道：奉命差遣！\n" NOR, me);
  bell = (int)who->query("bellicosity");
  if (bell < bell_small) {
    message_vision(HIW "笑道：圣人有令，怎敢不从？\n", me);
  } else if (bell < bell_big ||
    (int)who->query("combat_exp") > 5000) {
    message_vision("$N皱眉道：如此小事，也来差遣我？！\n", me);
  } else {
    message_vision(HIB "N$怒喝：何方妖魔，胆敢妄遣天兵？。\n", me);
    kill_ob(who);
    set_leader(who);
    return;
  }

  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    enemy[i]->fight_ob(this_object());
    fight_ob(enemy[i]);
    /* 由于潜能及经验分配问题，不能用 kill
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
*/
  }
  set_leader(who);
}

int spell() {
  return SPELLLVL;
}

int manacost() {
  return MANACOST;
}

int special_att() {
  object me = this_object();
  object *enemy = query_enemy(), victim;
  int i = sizeof(enemy), damage;
  victim = enemy[random(i)];
  message_vision(HIR "只听$N怒喝一声" + HIW "「力劈华山”" + HIR "！！\n" +
    "手中巨灵斧雷霆一般猛劈下来。\n", me);
  if (random(2) >= 1) {
    damage = random((int)victim->query("max_kee") / 5);
    if (damage < 40)
      damage = 40;
    if (damage > 250)
      damage = 250;
    message_vision("$N不幸被一斧劈中，顿时全身血如泉涌。\n" NOR, victim);
    victim->apply_condition("bleeding", random(i * i));
    victim->receive_damage("kee", damage, me);
    COMBAT_D->report_status(victim, 0);
  } else {
    message_vision("只可惜离$N差了一点，劈到地上。轰的一声巨响，地皮顿时裂了开来。\n" NOR, victim);
  }
  start_busy(1);
  return 1;
}
