// invocation.c

int cast(object me, string str)
{
	if( !me->is_fighting() )
		return notify_fail("只有战斗中才能召唤鬼神！\n");
	
	if( (int)me->query("sen") < 30 )
		return notify_fail("你的精神无法集中！\n");

	if ((int)me->query_temp ("invocation") >= 6)
	  return notify_fail ("你已经叫太多天兵天将了！\n");

	write ("你要求哪个鬼神帮助？");
        input_to ((: call_other, __FILE__, "cast_soldier", me :));
	return 1;
}

int cast_soldier (object me, string name)
{
	object soldier;
	int lvl, manacost, exp;
	string filename;

	filename = __DIR__"npc/" + name;
	lvl = filename->spell ();
	if (!lvl)
	  {
	    tell_object (me, filename + "没这个鬼神\n");
	    return 0;
	  }

	if (me->query_skill ("necromancy") < lvl)
	  {
	    tell_object (me, "你的茅山道术还不够高，叫不出那个鬼神。\n");
	    return 0;
	  }

	manacost = filename->manacost ();
	if (me->query ("mana") < manacost)
	  {
	    tell_object (me, "你的法力不够。\n");
	    return 0;
	  }

	message_vision("$N喃喃地念了几句咒语。\n", me);

	me->receive_damage("sen", 30);
	me->add ("mana", -manacost);

	if(random (me->query("mana")) * me->query_skill ("necromancy")
	   < lvl * manacost )
	  {
	    message("vision", "但是什么也没有发生。\n", environment(me));
	    return 1;
	  }

	seteuid(getuid());
	filename = (__DIR__"npc/" + name);
	soldier = new(filename);
	soldier->move (environment (me));
	soldier->invocation (me);
	exp = (int)me->query ("combat_exp");
	if ((int)soldier->query ("combat_exp") < exp)
	  soldier->set ("combat_exp", exp);
	me->add_temp ("invocation", 1);
	return 1;
}
