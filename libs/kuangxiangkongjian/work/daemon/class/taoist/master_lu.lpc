void attempt_apprentice(object ob)
{
        object whip;
        if(this_player()->query("class")!="taoist")
        {
                command("say 你不是道士，所以我不能收你为徒。\n");
                return;
        }
        command("hmm");
        command("recruit "+ob->query("id"));

        command("say 你可以去找志清师叔买件道服。");
}

int accept_kill (object who)
{
  command ("say 既然如此，贫道也只好出手了");
  command ("conjure fly");
  return 1;
}

string magic1()
{
	if ((int)(this_object ()->query ("sen")) > 30)
	  __DIR__"necromancy/invocation"->cast_soldier(this_object (),"hugegod");
        return "\n";
}

string magic2()
{
        command("cast feeblebolt");
        return "\n";
}
