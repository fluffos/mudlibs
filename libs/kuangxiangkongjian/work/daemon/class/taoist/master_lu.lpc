#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string magic1();
string magic2();
string magic3();
string magic4();

void create()
{
        set_name("陆清风",({"master lu","master","lu"}));
        set("long","紫玄道观之主,一身道术无人能敌\n");
        set("gender","男性");
        set("class","taoist");
        set("nickname","紫玄道人");
        set("combat_exp",1000000);
        set("attitude","friendly");
        set("age",50);
        set("title","天道派掌门人");
        set("str",30);
        set("cor", 24);
        set("cps", 25);
        set("per", 24);
        set("spi", 40);
        set("int", 26);
        set("kee",2000);
        set("max_kee",2000);
        set("force",2500);
/*        set("inquiry",([
          ])); */
        set("max_force",2200);
        set("max_mana",1000);
        set("mana",1000);
        set("atman",100);
        set("max_atman",900);
	set_skill("array", 30);
        set_skill("literate",90);
	set_skill("cure",80);
	set_skill("taoism", 120);
	map_skill("cure","taoism");
        set_skill("force",50);
        set_skill("dodge",60);
        set_skill("magic",100);
        set_skill("gmagic", 100);
	map_skill("magic", "gmagic");
        set_skill("g-steps",60);
        set_skill("whip",60);
        set_skill("spells",100);
        set_skill("gwhip",60);
        map_skill("whip","gwhip");
        set("force_factor",30);
        set_skill("parry",50);
        set_skill("gforce",50);
        set_skill("necromancy",100);
        map_skill("spells","necromancy");
        map_skill("force","gforce");
        map_skill("dodge","g-steps");
        set("chat_chance_combat",40);
        set("chat_msg_combat",({
        (: perform_action, "whip.stopmove" :),
         (: magic1 :),
         (: magic2 :),
        }));
        setup();
        create_family("天道派",1,"掌门人");
        carry_object("/open/tendo/obj/goldwhisk")->wield();
        carry_object("/open/tendo/obj/shoe")->wear();
        carry_object("/open/tendo/obj/hat")->wear();
        carry_object("/open/tendo/obj/robe")->wear();
}

