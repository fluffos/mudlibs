// counterattack.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!me->is_fighting(target) )
	return notify_fail("这法术只能对战斗中的对手使用。\n");
	if( me->query("mana") < 30 )
	return notify_fail("你的法力不足\n");
        if( me->query_skill("necromancy",1) <40 )
	return notify_fail("你的法力还不足以驱使这个法术。\n");
	msg = CYN "$N突然唸着：\n" NOR ;
	msg += HIR "活跃于自然中的圣兽啊！请助我一臂之力：火～龙！\n" NOR ;
	msg += CYN "瞬间一条红光直冲向$n，";
	me->start_busy(1);
	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 ) 
	{
		msg += "一阵光闪，$p惨被火龙击中。\n" NOR;
           target->add( "kee",-(me->query_skill("magic",1) / 2 +100));
	} else {
		msg += "可是被$p躲开了。\n" NOR;
	}
	me->add("mana",-30);
	message_vision(msg, me, target);
        me->improve_skill("necromancy",random(me->query("spi")));
	return 1;
}
