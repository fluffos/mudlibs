// counterattack.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!me->is_fighting(target) )
	return notify_fail("这法术只能对战斗中的对手使用。\n");
	if( me->query("mana") < 15 )
	return notify_fail("你的法力不够。\n");
	
	msg = CYN "$N突然唸着：" NOR ;
	msg += HIR "电～击！\n" NOR ;
	msg += CYN "$N祭起一道雷电劈向$n，";
	me->start_busy(1);
	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/2 ) 
	{
		msg += "结果$p惨被$P劈中！\n" NOR;
	target->receive_damage( "kee",(me->query_skill("magic",1) / 2) + 10);
	} else {
		msg += "可是被$p躲开了。\n" NOR;
	}
	me->add("mana",-15);
	message_vision(msg, me, target);
        me->improve_skill("necromancy",random(me->query("spi")));
	return 1;
}
