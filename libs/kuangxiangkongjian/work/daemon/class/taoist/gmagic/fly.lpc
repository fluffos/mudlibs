// by dell

#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

void remove_effect (object me);

int conjure(object me, object target)
{
  int prob;
  int lvl;
  int gmagiclvl = (int)me->query_skill ("gmagic") +
		  (int)me->query_skill ("gmagic", 1) + 
		  (int)me->query_temp ("apply/gmagic");

  prob = me->query_skill ("gmagic", 1);
  if (prob < 40)
    return notify_fail ("你的仙术还不到家，回去再跟师父练练吧。\n");
  if (me->query ("class") != "taoist")
    return notify_fail ("凡夫俗子岂可驾云。\n");
  if ((int)me->query ("atman") < 100)
    return notify_fail ("你的灵力不足，飞仙术使不出来。\n");

  // 避免有人用tintin连续conjure
  me->add ("atman", -50);

  if ((int)me->query_temp ("fly", 1))
    return notify_fail ("你已经在用飞仙术了。\n");

  message_vision (HIY"只见$N使出道家仙术之「腾云飞仙”，手中拂尘一甩，\n", me);
  prob = gmagiclvl / 10 + (int)query_function ("fly") / 5;
  if (prob > random (15))
    {
      message_vision (HIW"一朵白云平地升起，缓缓的将$N托了起来。\n"NOR, me);
      lvl = (int)query_function ("fly") + gmagiclvl;
      me->set_temp ("fly_func", query_function ("fly"));
      me->set_temp ("fly", lvl);
      me->add_temp ("apply/dodge", lvl);
      me->start_call_out((: call_other, __FILE__, "remove_effect", me :), lvl);
    }
  else
    {
      message_vision (NOR"$N等了半天，连点动静都没发生。\n", me);
    }
  function_improved ("fly", random (me->query_skill ("gmagic")) * 5);
  return 1;
}

void remove_effect (object me)
{
  int lvl = me->query_temp ("fly", 1);
  me->add_temp ("apply/dodge", -lvl);
  me->set_temp ("fly", 0);
  tell_object (me, NOR"你脚下的云慢慢的降了下来。\n"NOR);
}
