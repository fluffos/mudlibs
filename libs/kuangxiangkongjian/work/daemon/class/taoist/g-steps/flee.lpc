// by borstquc

#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

int perform(object me, object target) {
  mapping exit = environment(me)->query("exits");
  string *dirs;
  int i;
  dirs = keys(exit);
  i = random(sizeof(dirs));
  load_object(exit[dirs[i]]);
  if (!me->is_fighting())
    return notify_fail("你又没在战斗，跑什么跑?\n");
  if (me->query("force") < 50)
    return notify_fail("你内力不足，无法使出「明哲保身”。\n");
  /*
        if(!me->max_skill("dodge","g-steps"))
          return notify_fail("你没有天道派的独门轻功\，无法使出「隐遁”。\n");
*/
  if (!exit)
    return notify_fail(HIW "这里无处可逃!!\n" NOR);
  message_vision(HIY "$N使出奇门遁甲之「隐遁”。\n" NOR, me);
  me->add("force", -50);
  if ((int)me->query_function("flee") / 2 +
    (int)me->query_skill("g-steps") / 10 > random(6)) {
    message_vision(HIW "只见$N眨眼间已不知去向。\n" NOR, me);
    me->move(exit[dirs[i]]);
  } else {
    message_vision(HIY "可惜因为$N的技术不够纯熟而失败了。\n" NOR, me);
    me->start_busy(1);
  }
  function_improved("flee", random(me->query_skill("g-steps")) * 5);
  return 1;
}
