 
#include <ansi.h>
inherit SSERVER;
int perform(object me,object target)
{
        object weapon;
        if( !target ) target = offensive_target(me);
        if(!me->is_fighting())
                return notify_fail("定身法只能在战斗中使用。\n");
        if(!(weapon=me->query_temp("weapon"))
        ||      (string)weapon->query("skill_type")!="whip")
                return notify_fail("要有适合的武器才能用定身法。\n");
        if(me->query("atman")<50) return notify_fail("你的零力不足使出。\n");
        me->add("force",-100);
          message_vision(
          CYN "$N喃喃的道着,‘天地无极乾坤借法’o(定)o,企图封住$n的行动!\n" NOR,me,
target);
        if(0.7*random(target->query_skill("dodge")+target->query_skill("parry")) < random(me->query_skill("whip")))
          {
               message_vision( MAG "结果$n被$N封住，不能动弹！\n" NOR,me,target)
;
       target->start_busy(6);
          }
           else
              message_vision(   MAG "结果被$n识破，没有命中。\n" NOR,me,target);
        return 1;
}
