
// keng_kee.c

#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        object ob;
        string *name;

        if( !target ) target = offensive_target(me);

        if(me->query_skill("haoforce",1) < 100-me->query("con")*1.5)
             return notify_fail("你的浩日心法不够纯熟，无法聚气指尖。\n");

        if(me->query("force")<350)
                           return notify_fail("你的内力不够。\n");
              if(me->query("kee")<200)
                           return notify_fail("你的气不够。\n");

        if(!me->is_fighting())  
        {
                tell_object(me,"浩日罡\气唯在战斗中才能使用。\n");
                return 0;
        }
        message_vision(
            "[1m$N口中唸唸有词，运起浩日心法中的「[1;31m烈日诀[0m[1m”\n
                 $N霎时一股至阳刚烈的真气充塞着$N身旁只见$N\n
                 全身发光炙热，指尖聚集一颗明亮的光球[0m\n",me,target);

        if(me->query_skill("haoforce",1)>=100-me->query("int"))
        {
        message_vision(
            "[1m$N运劲指尖，一道「浩日罡\气”射去！[0m\n",me,target);

        me->receive_wound("kee",100);
        me->add("force",-350);
        if(random(me->query_skill("unarmed")+20)>random(target->query_skill("dodge")))
        {
                message_vision(
                "$n躲避不及，被罡\气击中，霎时烈火笼罩$n全身，嘶嚎不断！",me,target);
                message_vision( NOR,me);
                target->apply_condition("burn",random(10) +((int)me->query_skill("haoforce", 1)/8 ));
                target->receive_wound("kee",me->query_skill("haoforce",1)+random(me->query_skill("haoforce",1)*5));
                COMBAT_D->report_status(target);
        }
        else
          if(random(me->query_skill("unarmed")+20)<random(target->query_skill("dodge")) ||
           random(me->query_skill("unarmed"))>random(target->query_skill("dodge")*0.5) )
      {
                message_vision(
                "$n运功\避开，但仍受罡\气擦过，只见$n的伤口焦黑一块。\n",me,target);
                message_vision( NOR,me);
                target->apply_condition("burn",random(10) +((int)me->query_skill("haoforce", 1)/8 ));
                COMBAT_D->report_status(target);
       }
        else
                message_vision(
                "$n拼死地躲开，只见罡\气射入空中，随之消逝。\n",me,target);
        }
        message_vision(
            "「浩日罡\气”射出后，$N大耗内力、气息紊乱，无法移动\n",me,target);
        me->start_busy(3);
        function_improved("kee-wind",random(me->query("force")/10));
        message_vision( NOR,me);
        return 1;
}
