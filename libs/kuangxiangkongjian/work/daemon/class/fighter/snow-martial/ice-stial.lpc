// ice-stial.c

#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

void ice_out( object me , object target )
{
	message_vision(HIC,me);
	message_vision( "经过片刻－－－$N朝着$n狠狠打出一掌！\n"+
	"只见一阵寒风朝着$n冲去！\n",me,target);
	if( random( query_function("ice-stial") ) > random(
		target->query_skill("dodge")) ) {
		message_vision("$n只觉的一股寒气刺骨，功\力顿时下降三分。\n",me,target);
		target->receive_wound("kee",20+query_function("ice-stial") * 2 );
		target->add("force",-target->query("force")*3/10);
		if( target->query("force") < 0 ) target->set("force",0);
			target->start_busy(3);
			COMBAT_D->report_status(target);
	} else
	{
		message_vision("$n身子一闪，虽然避开了寒风，仍感一股寒风冻体。\n",me,target);
			target->start_busy(1);
	}
	function_improved("ice-stial",random(query_function("ice-stial")*2)+1);
	me->delete_temp("in_using_ice-stial");
}
int perform(object me, object target)
{
	string msg;
	object ob;
	string *name;

	if( !target ) target = offensive_target(me);

	if( !me->query("ice-stial") ) 
		return notify_fail("你还没有学成寒冰掌。\n");
	if(!me->is_fighting())	
	{
		tell_object( me , "寒冰掌要在战斗中才能使用。\n");
		return 1;
	}
	if( me->query("force") < 50 )
		return notify_fail("你的内力不够。\n");
	if( me->query_temp("weapon") ) 
		return notify_fail("寒冰掌必需空手才能用。\n");
	me->add("force",-50);
	message_vision(
	HIC "$N聚精会神，将一股强劲的寒气聚在掌心！\n" NOR,me);
	me->start_busy(1);
	me->set_temp("in_using_ice-stial",1);
	call_out("ice_out",5,me,target);
	return 1;
}
