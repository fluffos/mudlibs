// master_jen.c

inherit NPC;
inherit F_MASTER;


void create()
  {
set("class", "fighter");
        set_name("任正晴", ({ "master jen", "master", "jen" }) );
        set("title","泷山派第七代掌门人");
        set("nickname", "泷山奇侠");
        set("gender", "男性");
        set("age", 45);
        set("attitude", "peaceful");
        set("long",
                   "任正晴自幼生长于武学名门中，受其父「任博文”英才式的教育，薰\n"
"陶出其严肃而谦逊的人格，身为泷山派掌门的他，以发扬泷山为己任\n"
"，对于违反派规的弟子毫不留情，如此就可看出其严肃的个性\n");

        set("str", 48);
        set("cps", 40);
        set("per", 34);
        set("int", 38);
        set("kar", 16);

       set("combat_exp",1500000);
        set("force"       , 2700);
        set("max_force"   , 2700);
        set("force_factor", 10);
        set("score"       , 200000);

//           set("chat_chance_combat", 80);

/*           set("chat_msg_combat", ({
                (: consider :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :)
          }) ); */

          set("inquiry",([
                 "泷山拳法":   "此为任家传承的绝学，分为「素招”和「奥义”两种。 ",
                 "素招":       "是泷山拳法中较易学、威力较小的招式。\n",
                 "奥义":       "是整个泷山拳里最精华的部份，唯持有阳炎臂环的弟子才能学。\n",
                 "阳炎臂环":   "要取得此臂环必须接受测验(accept test)\n",
                 "测验":       "'\n",
          ]));

        set_skill("array",40);
        set_skill("cure",40);
        set_skill("dagger",20);
        set_skill("move",70);
        set_skill("unarmed", 100);
        set_skill("sword", 60);
	set_skill("blade",60);
        set_skill("force", 90);
        set_skill("parry", 70);
	set_skill("dodge",80);
        set_skill("literate", 60);
          set_skill("henma-steps",100);
        set_skill("lungshan",100);
	set_skill("haoforce",90);

        map_skill("force", "haoforce");
        map_skill("unarmed", "lungshan");
          map_skill("dodge", "henma-steps");

        map_skill("parry", "lungshan");
        set("chat_chance_combat",65);
        set("chat_msg_combat",({
//           (: exert_function, "enforceup" :),

            (: perform_action, "force.kang_kee"   :)
        }));

        create_family("泷山派", 7, "掌门人");


        setup();

            carry_object(__DIR__"plumage")->wear();
            carry_object(__DIR__"armband")->wear();
            carry_object(__DIR__"star")->wield();
        add_money("gold",10);
}

void init()
{
// add_action("do_say","say");
//        add_action("do_join","join");
}
  void attempt_apprentice(object ob)
{
        if(this_player()->query("class")!="fighter")
        {
                command("sigh");
                command("say 你不是武者，我不能收你。\n");
                return;
        }
      if((int)ob->query("cps") <20 )
{
          command("sigh");
          command("say 学泷山拳法必须有恒心，敝人观之"+ RANK_D->query_respect(ob) + "的资质似乎不宜！\n");

return;
        }

      command("hmm");
      command("pat" + ob->query("id"));
      command("recruit "+ob->query("id"));
}
