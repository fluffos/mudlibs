// depoison.c

#include <ansi.h>

int exert(object me) {
  int need;

  if (me->query_skill("haoforce", 1) < 20)
    return notify_fail("你的浩日心法练得不够精深，无法逼毒。\n");
  if (me->is_fighting())
    return notify_fail("战斗中不能逼毒。\n");
  if ((int)me->query("kee") < 30 || (int)me->query("sen") < 30)
    return notify_fail("你的精或神不够，不能逼毒。\n");

  if ((need = me->query_condition("snake_poison") * 5) != 0) {
    if ((int)me->query("force") < need)
      return notify_fail("你的内力不足，不能逼毒。\n");
    if ((int)me->query("kee") < need)
      return notify_fail("强逼此毒,将会让你受到足以死去的内伤(气不足).\n");
    message_vision(
      HIW "$N运起浩日心法\把蛇毒给逼了出来。\n" NOR, me);
    me->add("force", -need);
    me->receive_wound("kee", need);
    me->apply_condition("snake_poison", 0);
  } else if ((need = me->query_condition("ff_poison") * 3) != 0) {
    if ((int)me->query("force") < need)
      return notify_fail("你的内力不足，不能逼毒。\n");
    if ((int)me->query("kee") < need)
      return notify_fail("强逼此毒,将会让你受到足以死去的内伤(气不足).\n");
    message_vision(
      HIW "$N运起浩日心法\将气血调整完毕。\n" NOR, me);
    me->add("force", -need);
    me->receive_wound("kee", need);
    me->apply_condition("ff_poison", 0);
  } else if ((need = me->query_condition("flower_poison") * 5) != 0) {
    if ((int)me->query("force") < need)
      return notify_fail("你的内力不足，不能逼毒。\n");
    if ((int)me->query("kee") < need)
      return notify_fail("强逼此毒,将会让你受到足以死去的内伤(气不足).\n");
    message_vision(
      HIW "$N运起浩日心法\把花柳病毒给逼了出来。\n" NOR, me);
    me->add("force", -need);
    me->receive_wound("kee", need);
    me->apply_condition("flower_poison", 0);
  } else if ((need = me->query_condition("dark_poison") * 7) != 0) {
    if ((int)me->query("force") < need)
      return notify_fail("你的内力不足，不能逼毒。\n");
    if ((int)me->query("kee") < need)
      return notify_fail("强逼此毒,将会让你受到足以死去的内伤(气不足).\n");
    message_vision(
      HIW "$N运起浩日心法\把深宫奇毒给逼了出来。\n" NOR, me);
    me->add("force", -need);
    me->receive_wound("kee", need);
    me->apply_condition("dark_poison", 0);
  } else if ((need = me->query_condition("rose_poison") * 5) != 0) {
    if ((int)me->query("force") < need)
      return notify_fail("你的内力不足，不能逼毒。\n");
    if ((int)me->query("kee") < need)
      return notify_fail("强逼此毒,将会让你受到足以死去的内伤(气不足).\n");
    message_vision(
      HIW "$N运起浩日心法\把火玫瑰毒给逼了出来。\n" NOR, me);
    me->add("force", -need);
    me->receive_wound("kee", need);
    me->apply_condition("rose_poison", 0);
  } else if ((need = me->query_condition("five_poison") * 9) != 0) {
    if ((int)me->query("force") < need)
      return notify_fail("你的内力不足，不能逼毒。\n");
    if ((int)me->query("kee") < need)
      return notify_fail("强逼此毒,将会让你受到足以死去的内伤(气不足).\n");
    message_vision(
      HIW "$N运起浩日心法\把五毒神掌之毒给逼了出来。\n" NOR, me);
    me->add("force", -need);
    me->receive_wound("kee", need);
    me->apply_condition("five_poison", 0);
  } else if ((need = me->query_condition("fire_poison") * 13) != 0)

  {
    if ((int)me->query("force") < need * 2)
      return notify_fail("你的内力不足，不能逼毒。\n");
    if ((int)me->query("kee") < need)
      return notify_fail("强逼此毒,将会让你受到足以死去的内伤(气不足).\n");
    message_vision(
      HIW "$N运起浩日心法\把火云邪毒给逼了出来。\n" NOR, me);
    me->add("force", -need * 2);
    me->receive_wound("kee", need);
    me->apply_condition("fire_poison", 0);
  }

  else
    return notify_fail("你并无中毒或是你所中的毒本心法尚无法解之，请自己保重。\n");
  message_vision(
    HIW "$N因使武林中最烈之浩日心法,而使自己受到火焰反扑.\n" NOR, me);
  if (need < 3) need = 3;
  if (need > 15) need = 15;
  me->apply_condition("burn", need);
  return 1;
}
