// bellup.c

#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_GUILDCMDS;

int main(object me, string arg) {
  int bell = me->query("bellicosity");

  if (me->query("bellicosity") < 100)
    return notify_fail("你身上的杀气不够。\n");
  if (me->query("force") < 100)
    return notify_fail("你的内力不够。\n");
  if (me->query_temp("bellup") == 1)
    return notify_fail("你现在正在放出杀气。\n");
  if (me->query("class") != "killer")
    return notify_fail("这样指令只有杀手才能用。\n");
  me->apply_condition("bell", me->query("bellicosity") / 50);
  me->add_temp("apply/damage", bell / 50);
  me->add_temp("apply/attack", bell / 50);
  me->add_temp("apply/dodge", bell / 50);
  me->set_temp("bell", bell);
  me->set_temp("bellup", 1);
  me->add("force", -100);
  message_vision(
    HIG "$N大暍一声，放出身上的杀气，眼神由温和转变成恐怖。\n" NOR, me);
  return 1;
}

int help(object me) {
  write(@HELP
 
指令格式：bellup
 
说明：这个指令让你可以将体内的杀气放出。
 
HELP
  );
  return 1;
}
