//master_yar.c 作者:fund 修改: urd
#include <ansi.h>
#include "/open/open.h"
inherit NPC;
inherit F_MASTER;
void create()
{
            object ob;
            set_name("叶秀杀",({"master yar","yar"}));
            set("long","他是名震江湖的一代杀手，黑牙联的头目。\n");
            set("gender","男性");
            set("class","killer");
            set("nickname","杀眼无情");
            set("combat_exp",1100000);
            set("attitude","heroism");
            set("age",26);
            set("str", 44);
            set("cor", 30);
            set("cps", 28);
            set("per", 24);
            set("int", 22);
        set("kee",4000);
        set("max_kee",4000);
        set("gin",1600);
        set("max_gin",1600);
        set("atman",1300);
        set("max_atman",1300);
        set("mana",3400);
        set("max_mana",3400);
            set("force",5500);
            set("max_force",5500);
            set_skill("array",70);
            set_skill("rain-throwing",100);
            set_skill("blade",70);
        set_skill("spells",80);
        set_skill("magic",75);
            set_skill("cure",70);
            set_skill("dagger",90);
        set_skill("unarmed",70);
            set_skill("dodge",100);
            set_skill("literate",70);
            set_skill("force",100);
            set_skill("move",100);
            set_skill("parry",70);
            set_skill("poison",60);
            set_skill("sword",70);
            set_skill("throwing",100);
            set_skill("shade-steps",100);
        map_skill("throwing","rain-throwing");
        map_skill("dodge","shade-steps");
        set_skill("blackforce",95);
        map_skill("force","blackforce");
        map_skill("move","shade-steps");
        set_temp("apply/armor",70);
        set("force_factor",10);
        setup();
        create_family("黑牙联",2,"主席");
        ob=carry_object("/open/snow/obj/hate_knife");
        ob->set_amount(250);
        ob->wield();
        carry_object("/obj/cloth.lpc")->wear();
}

void init()
{
        add_action("do_join","join");
}
  void attempt_apprentice(object ob)
{
        command("l "+ob->query("id"));
        if(this_player()->query("cor")<15)
        {
            command("sigh "+ob->query("id"));
            command("say 你的胆识不够,我不能收你为徒\n");
        command("shake");
            return;
        }
        command("smile");
        command("nod");
        command("chat 哈哈哈...我们杀手的成员又多了一名啦..大家小心点啦..\n");
        command("recruit "+ob->query("id"));
}
int accept_fight(object ob)
{
        command("say 你是真的要跟我挑战吗??\n");
        message_vision( this_object()->name()+"脸上一副鄙视的样子。\n",ob);
        this_object()->set("bellicosity",3000);
        command("cmd bellup");
        return 1;
}
int accept_kill(object ob)
{
        command("say 没想到你真有勇气, 敢跟我挑战!!!\n");
        message_vision( this_object()->name()+"突然变脸，脸上出现杀气。\n",ob);
        this_object()->set("bellicosity",5000);
        command("cmd bellup");
        return 1;
}
int do_join()
{
        object ob=this_player();
        if(!ob->query("class"))
        {
        ob->set("class","killer");
	command("nod "+ob->query("id"));
        }
        else
        {
        command("say 道不同志不合，你去找别人吧。\n");
        return 1;
        }
        message("system",
        HIB "纷乱动荡的武林中～～\n\n又出现一名恐怖的杀手～～\n" NOR,users());
        return 1;
}
