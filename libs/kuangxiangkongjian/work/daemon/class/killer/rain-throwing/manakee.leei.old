// made by leei
#include <command.h>
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
       string msg;
       int ski_value, max_lv;
       ski_value= random(me->query_skill("rain-throwing",1));
       max_lv=me->query_skill("rain-throwing",1);

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("‘魔气杀’只能对战斗中的对手使用。\n");
  
        if( me->query_skill_mapped("throwing")!="rain-throwing" )
         return notify_fail("你没有装备霸雨螫魂。 \n");
   if( me->query_skill("rain-throwing",1)<20 )
         return notify_fail("你的霸雨螫魂技巧不足。 \n");
   if( me->query_skill("throwing",1)<10 )
         return notify_fail("你的暗器准度不好。 \n");
   if(me->query("force")<60)
         return notify_fail("你的内力不够。\n");
   if( target->is_busy() )
      return notify_fail(target->name() + "[34;1m为了躲避你的杀气,目前正自顾不暇![0m\n");
msg ="[31;1m$N自残己身,以血气转换成杀气。[0m\n
            [32m……$N身上发出一股强大的杀气……[0m\n
    [32;1m■$N身上杀气逐渐地聚集在双手,在双手上形成两团魔气■\n[0m
            $N倏地大喝一声－－[36;1m魔气杀[0m－－\n\n";

     if( ski_value == random(max_lv)){
     msg += "$N突然喉头一动～～　[35m只见$N口中喷出一道血柱往$n射去～～[0m\n
[34;1m此乃魔气杀之[0m
            [34m最终杀招[0m ‘[33;1;5m魔血气杀[0m’\n\n
$n遭到前所未有的打击,但$N也受伤不轻。\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 3);
     target->receive_damage("kee",target->query("kee")*70/100);
     me->receive_damage("kee",me->query("kee")*40/100);
     me->add("force",-50);  }
     
    else if( ski_value < 10 ){
      msg +="$N真气所转换的杀气不够大,对敌人毫无影响。\n";
      me->receive_damage("kee",me->query("kee")*1/100);
      me->add("force",-50); }

    else if( ski_value <  20 ){
     msg += "第一招 ‘[33;1m魔气无常[0m’\n\n$n受到伤害,动弹不得！\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 1);
     target->receive_damage("kee",target->query("max_kee")*4/100);
     me->receive_damage("kee",me->query("kee")*1/100);
     me->add("force",-50);    }
    
    else if( ski_value <  30 ){
     msg += "第二招 ‘[33;1m火魔煞神[0m’\n\n$n受到伤害,动弹不得！\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 1);
     target->receive_damage("kee",target->query("kee")*8/100);
     me->receive_damage("kee",me->query("kee")*2/100);
     me->add("force",-50);    }

     else  if( ski_value < 40 ){
     msg += "第三招 ‘[33;1m商魂魔身[0m’\n\n$n受到伤害,动弹不得。\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 1);
     target->receive_damage("kee",target->query("kee")*12/100);
     me->receive_damage("kee",me->query("kee")*3/100);
     me->add("force",-50);  }

     else if( ski_value <  50 ){
     msg += "第四招 ‘[33;1m剑魔灭世[0m’\n\n$n受到伤害,动弹不得！\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 1);
     target->receive_damage("kee",target->query("kee")*16/100);
     me->receive_damage("kee",me->query("kee")*4/100);
     me->add("force",-50);    }

     else if( ski_value <  60 ){
     msg += "第五招 ‘[33;1m狂魔破空[0m’\n\n$n受到伤害,动弹不得！\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 2);
     target->receive_damage("kee",target->query("kee")*20/100);
     me->receive_damage("kee",me->query("kee")*5/100);
     me->add("force",-50);    }

     else if( ski_value <  70 ){
     msg += "第六招 ‘[33;1m群魔乱舞[0m’\n\n$n受到伤害,动弹不得！\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 2);
     target->receive_damage("kee",target->query("kee")*24/100);
     me->receive_damage("kee",me->query("kee")*6/100);
     me->add("force",-50);    }

     else if( ski_value <  80 ){
     msg += "第七招 ‘[33;1m天极魔杀[0m’\n\n$n受到伤害,动弹不得！\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 2);
     target->receive_damage("kee",target->query("kee")*28/100);
     me->receive_damage("kee",me->query("kee")*7/100);
     me->add("force",-50);    }

     else if( ski_value <  90 ){
     msg += "第八招 ‘[33;1m斗魔无生魂[0m’\n\n$n受到伤害,动弹不得！\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 2);
     target->receive_damage("kee",target->query("kee")*32/100);
     me->receive_damage("kee",me->query("kee")*8/100);
     me->add("force",-50);    }

     else                    {
     msg += "第九招 ‘[33;1m风魔狂转业[0m’\n\n$n受到伤害,动弹不得。\n";
     target->start_busy( (int)me->query_skill("rain-throwing") / 20 + 2);
     target->receive_damage("kee",target->query("kee")*36/100);
     me->receive_damage("kee",me->query("kee")*9/100);
     me->add("force",-50);  }

     message_vision(msg, me, target);
        return 1;
}
