// 百花齐飞放(write by cyw)

#include <combat.h>
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
        object *enemy,ob;          
        int damage,i;
        enemy=me->query_enemy();
        i=sizeof(enemy);        

        if((string)me->query_skill_mapped("blade")!="season-flower-blade")
           return notify_fail("只有在施展四季花舞刀法时才能打出百花齐飞放。\n");
        if(!(ob=me->query_temp("weapon")) ||
           (string)ob->query("skill_type") != "blade")
              return notify_fail("没拿刀?相信你的根基还不到御气成刀吧!。\n");
        if(me->query_skill("season-flower-blade",1)<50)
           return notify_fail("你的四季花舞刀法火喉还不足，"+
                              "没办法使出百花奇飞放。\n");
        if(!me->is_fighting()) 
           return notify_fail("又没人杀你,何必用出极招。\n");
        if(me->query("force") < 100)
           return notify_fail("你的内力不够。\n");


message_vision(HIY"\n\n$N领悟‘春风桃李花开日,秋雨梧桐叶落时’,师门绝学‘百花齐飞放’"+
                  "顺势而生\n\n,刀气化为百花纷飞分击各敌 !\n\n"NOR,me);

	damage = me->query_skill("ninja-spell")/2 +me->query_skill("season-flower-blade")/2+ me->query_skill("ninja-spell")/2;
        me->add("force",-50);
	me->start_busy(1);
             
        while(i--) {
           if(random(me->query("combat_exp")) > 0.01*random(enemy[i]->query("combat_exp"))) {
              enemy[i]->receive_wound("kee",damage);

              message_vision(HIR"$N一不留神 , 被化为百花的刀气破体穿过 !\n"NOR,enemy[i]);
              COMBAT_D->report_status(enemy[i]);
          }
          else message_vision(YEL"$N机灵的躲过了百花的攻击 !\n"NOR,enemy[i]);
        }
        return 1;
}       
