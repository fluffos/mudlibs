// 女影幻忍法(write by cyw)

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "spell"; }

int valid_learn(object me) {
  if (me->query("gender") != "女性")
    return notify_fail("女影幻忍法非女子不可学也。\n");
  if (me->query("max_atman") < 30)
    return notify_fail("要有点法力上的根基才能学女隐幻忍法。\n");
  return 1;
}

string conjure_magic_file(string spell) {
  return CLASS_D("killer") + "/ninja-spell/" + spell;
}

string scribe_spell_file(string spell) {
  return CLASS_D("taoist") + "/necromancy/" + spell;
}

int practice_skill(object me) {

  if (me->query("atman") < 10)
    return notify_fail("你的法力已经耗尽，还是先休息一下再练吧。\n");
  me->add("atman", -20);
}
