// magic.c
#include <ansi.h>
inherit SKILL;
mapping *action = ({  
([     "action"     : "$N使快$w,一招"HIG"‘春风彩蝶飞’"+NOR"已然使开,刀光闪烁不定,婉如
彩蝶四处飞舞$n一失神全身上下已被砍伤无数处.", 
                "dodge"      :    50,  
                "parry"      :    60,
                "damage"     :    60,
                "force"      :    150,
                "damage_type":   "割伤",
           ]),                        
([     "action"     : "$N双手持$w,刀起刀落,正是四季花舞刀法中的"HIC"‘夏夜星空明’"+NOR
"$n眼睁睁的看着横刀砍来却似乎无法抵抗",
                "dodge"      :   -35,
                "parry"      :    50,
                "damage"     :    40,
                "force"      :    120,
                "damage_type":   "砍伤",
           ]),
([    "action"     : "$N眉头紧锁,杀意急升,"HIY"‘秋意愁不断’"+NOR"之起手式看似完成$w在
$n的四周飘荡化为无数枫叶落地,$n一不定神,刀气已经逼到眼前",
                "dodge"      :    40,
                "parry"      :   -50,
                "damage"     :    90,
                "force"      :    300,
                "damage_type":   "劈伤",
           ]),
([    "action"     : "$N手中$w越使越快,刀风冷冽,"HIG"‘冬雨寒若雪’"+NOR"刀招应声而出,
$n心中大惊,但为时已晚$n已陷入险境无法闪躲.",  
                "dodge"      :  -35,
                "parry"      :  -40,
                "force"      :   200,
                "damage"     :   100,
                "damage_type":   "破体之伤",                                  
           ]),
([     "action"    : "$N连环出招,一招"HIM"‘梅开随风飘’"+NOR"左攻右击,如狂风般的飘流,
$n似乎无法避开这柔刚并进的一击.",
                "dodge"      :   -35,
                "parry"      :   -35,
                "damage"     :    50,
                "force"      :    100,
                "damage_type":   "切伤",           
           ]),
([     "action"    : "$N倒举$w,以极美妙的姿势持刀向前,正是四季花舞刀法中
最柔美的招式"HIM"‘兰香传四方’"+NOR",$n已被这美丽的景像
给吸引而忘了攻击",
                "dodge"      :    70,
                "parry"      :    20,
                "damage"     :    50,
                "force"      :    40,
                "damage_type":   "刺伤",           
           ]),
([    "action"     : "$N刀起斜放,动作清雅脱俗正是"CYN"‘竹出百花残’"+NOR"刀诀的主要宗旨
$n看到这刀招一出觉的相行见惭,竟然有自废武学而拜$N为师的念头.",
                "dodge"      :    70,
                "parry"      :    50,
                "damage"     :    20,
                "force"      :    20,
                "damage_type":   "内伤与割伤",
           ]),
([    "action"     : "$N持刀划半弧成半圆,欺敌之招"HIY"‘菊语采人心’"+NOR"自然而生,$n
被$N看破心意抢得先机,$n已陷入一阵刀网之中..",
                "dodge"      :   40,
                "parry"      :   20,
                "force"      :   10,
                "damage"     :   60,
                "damage_type":   "断臂之伤",                           
           ]),
   });        
int valid_learn(object me)
{
object ob;
  if( !(ob = me->query_temp("weapon"))
  || (string)ob->query("skill_type") != "blade" )
	return notify_fail("你还没到可以空手练刀的功力\n");
	return 1;
}
int valid_skill_usage(string usage)
{
   return (usage== "blade") || (usage=="parry");
}
mapping query_action(object me, object weapon)
{
   return action[random(sizeof(action) )];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 10
	|| (int)me->query("force") < 3 || (int)me->query("bellcosity")< 100 )
		return notify_fail("你的杀气还不够逼人 ,体力内力也无法驾御此刀法。\n");
	me->receive_damage("kee", 5);
	me->add("force", -3);
	write("你运足真气练了一遍刀法后 ,举手投足都带着一点优雅之气 ! \n");
	return 1;
}
