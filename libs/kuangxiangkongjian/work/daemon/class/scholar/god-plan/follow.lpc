#include <ansi.h>
int perform(object me, object target) {
  int i;
  int exp;
  if (!target) return notify_fail("你要对谁用计 ?\n");
  if (userp(target)) return notify_fail("这招对玩者没用。\n");
  if (me->query("sen") < 20)
    return notify_fail("你的精神力不够，无法用计。\n");
  if (me->query_skill("plan") < 45)
    return notify_fail("你的谋略能力不够。\n");
  if (target->query_temp("follow-succeed"))
    return notify_fail("相同的计策对同一个人没有效。\n");
  exp = target->query("combat_exp") / 10000 + 10;
  me->add("sen", -20);
  me->start_busy(1);
  if (random(me->query_skill("plan")) > random(exp)) {
    message_vision(HIG + @LONG
$n中了$N的诱敌之计，突然勃然大怒，看来$n不杀死$N是不会甘休的！
LONG + NOR, me, target);
    target->set_leader(me);
    target->kill_ob(me);
    target->set_temp("follow-succeed", 1);
  } else {
    message_vision(HIG + @LONG
$n识破了$N的奸计，使$N的诱敌之计失效。
LONG + NOR, me, target);
  }
  return 1;
}
