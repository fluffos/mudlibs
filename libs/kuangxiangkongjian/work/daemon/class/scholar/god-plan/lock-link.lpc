#include <ansi.h>
int perform(object me, object target) {
  int i;
  int exp;
  object *all = me->query_enemy();
  if (!me->is_fighting())
    return notify_fail("连环计只能在战斗中使用。\n");
  if (me->query("sen") < 30)
    return notify_fail("你的精神力不够，无法用计。\n");
  if (me->query_skill("plan") < 105)
    return notify_fail("你的谋略能力不够。\n");
  me->add("sen", -30);
  me->start_busy(1);
  message_vision(HIB + @LONG
$N使用兵法中的铁锁连环计，企图牵制敌人的行动！
LONG + NOR, me, target);
  for (i = 0; i < sizeof(all); i++) {
    exp = all[i]->query("combat_exp") / 10000 + 1;
    if (random(me->query_skill("plan")) > random(exp) &&
      !all[i]->query_temp("lock-link")) {
      message_vision(CYN + @LONG
$n中了$N的铁锁连环之计，行动被牵制住了！
LONG + NOR, me, all[i]);
      all[i]->start_busy(5);
      all[i]->set_temp("locl-link", 1);
    } else message_vision(HIY + @LONG
$n识破了$N的奸计，没有上当！
LONG + NOR, me, all[i]);
  }
  return 1;
}
