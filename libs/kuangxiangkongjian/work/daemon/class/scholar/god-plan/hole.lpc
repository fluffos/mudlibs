#include <ansi.h>
int perform(object me, object target) {
  int i;
  string myhole;
  myhole = me->query("name") + "hole-succeed";
  if (!target) {
    if (me->query("kee") < 20)
      return notify_fail("你气力不够，如何制做陷阱。\n");
    if (me->query_skill("plan") < 90)
      return notify_fail("你的谋略能力不够。\n");
    if (environment(me)->query_temp(myhole))
      return notify_fail("你的陷阱已经做好，不需要再做了。\n");
    me->add("kee", -20);
    if ((me->query_skill("plan") - 90) > random(10)) {
      message_vision(HIG + @LONG
在一阵忙碌之后，$N成功的做好了陷阱。
LONG + NOR, me);
      environment(me)->set_temp(myhole, 1);
    } else
      message_vision(HIG + @LONG
$N一不小心，把做好的陷阱弄坏了。
LONG + NOR, me);
  } else {
    if (me->query("sen") < 30)
      return notify_fail("你的精神力不够，无法用计。\n");
    if (me->query_skill("plan") < 90)
      return notify_fail("你的谋略能力不够。\n");
    if (!environment(me)->query_temp(myhole))
      return notify_fail("你并没有在此做陷阱，无法使用此计。\n");
    me->add("sen", -30);
    if ((me->query_skill("plan") - 90) > random(10)) {
      message_vision(RED + @STRING
$n一声惊呼，陷入$N的陷阱之中，无法动弹！！
STRING + NOR, me, target);
      if (target->query_temp("follow-succeed")) {
        target->start_busy(5);
        target->delete_temp("follow-succeed");
      } else {
        target->start_busy(2);
        environment(me)->delete_temp(myhole);
      }
    } else
      message_vision(CYN + @STRING
$n眼明脚快，躲开了$N所布下的陷阱。
STRING + NOR, me, target);
  }
  return 1;
}
