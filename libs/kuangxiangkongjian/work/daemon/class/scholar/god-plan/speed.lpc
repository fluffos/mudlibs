 
#include <ansi.h>
int perform(object me,object target)
{
	int i;
	object *all;
	if( me->query("sen") < 10 )
		return notify_fail("你的精神不够，无法使用。\n");
        if( me->query_skill("plan") < 60 )
		return notify_fail("你的谋略程度不够。\n");
	if( !target ) return notify_fail("你要对谁用计 ?\n");
	if(me->is_fighting(target))	
		return notify_fail("奇袭之计只能在战斗前使用。\n");
	me->add("sen",-10);
	message_vision( RED + @LONG
$N突然地对$n发动奇袭，杀得$n措手不及！
LONG + NOR , me , target );
/*配合伏兵之计使威力加强  By Chun*/
	if(me->query_temp("invis"))
	{
	target->start_busy(3);
	me->delete_temp("invis");
	}
	else
	target->start_busy(1);
	me->kill_ob(target);
	target->kill_ob(me);
	return 1;
}





