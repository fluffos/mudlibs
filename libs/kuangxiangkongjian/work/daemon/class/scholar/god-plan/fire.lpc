 
#include <ansi.h>
int perform(object me,object target)
{
	int i;
	int exp;
	object *all = me->query_enemy();
        if(!me->is_fighting())
		return notify_fail("火计只能在战斗中使用。\n");
	if( me->query("sen") < 30 )
		return notify_fail("你的精神力不够，无法用计。\n");
	if( me->query_skill("plan") < 120 )
		return notify_fail("你的谋略能力不够。\n");
	me->add("sen",-30);
	me->start_busy(2);
		message_vision( HIR + @LONG
$N使用孔明兵法之中的火计！
顿时现场一片的大火弥漫着四周 .....
LONG + NOR , me , target );
	for( i = 0 ; i < sizeof(all) ; i ++ ) {
		exp = all[i]->query("combat_exp") / 10000 + 10;
		if( random(me->query_skill("plan")) > random(exp) ) {
			message_vision( HIR + @LONG
$n来不及逃跑，因此被$N放出了火焰烧伤了！
LONG + NOR , me , all[i] );
			all[i]->receive_wound( "kee" , me->query_skill("plan") );
			COMBAT_D->report_status( all[i] );
		}
		else message_vision( HIY + @LONG
$n见情势不妙，跳了开来，逃过了一劫！
LONG + NOR , me ,all[i] );
	}
        return 1;
}
