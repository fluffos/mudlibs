
#include <ansi.h>
#include <npc.h>

int perform( object me , object target )
{
	object ob;
	int skill = me->query_skill("magic");
	seteuid(getuid(me));
	if( skill < 20 ) return notify_fail("你的法术程度不够。\n");
	if( me->query("atman") < 100 )
		return notify_fail("你的灵力不够。\n");
	if( me->query_temp("call_out_beast") > MAX_CALL_OUT )
		return notify_fail("你无法一次操控太多只圣兽。\n");
	ob = new( BIRD_BEAST );
	ob->move(environment(me));
	ob->join(me);
	ob->add_temp("apply/dodge",skill);
	ob->set("power",skill);
	ob->set("combat_exp",me->query("combat_exp"));
	me->add_temp("call_out_beast",1);
	message_vision(HIY "$N念出法咒，一股灵力奔腾而出，幻化出一只圣兽。\n",me);
	message_vision(NOR,me);
	me->add("atman",-100);
	return 1;
}
