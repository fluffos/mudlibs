// counterattack.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !me->is_fighting(target))
    return notify_fail("这法术只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("dremagic", 1) < 30)
    return notify_fail("你的法术等级不足以施展此术！\n");
  if (me->query("atman") < 30)
    return notify_fail("你的法力不足\n");
  msg = CYN "$N突然唸着：" NOR;
  msg += HIR "火～球！\n" NOR;
  msg += CYN "$N祭起一团火球轰向$n。\n" NOR;
  message_vision(msg, me, target);
  me->start_busy(1);
  call_out("act1", 5, msg, target, me);
  return 1;
}
int act1(string msg, object target, object me) {
  if ((random(me->query("combat_exp")) + (me->query_skill(
    "dremagic",
    1
  ) * 2)) > target->query("combat_exp") / 2) {
    msg = CYN "结果$p惨被$P轰中！\n" NOR;
    target->receive_damage("kee", (me->query_skill("magic", 1) * 3));
  } else {
    msg = CYN "可是被$p躲开了。\n" NOR;
  }
  me->add("atman", -30);
  message_vision(msg, me, target);
  me->improve_skill("dremagic", random(me->query("spi")));
  return 1;
}
