// confuse.c//cgy

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        string msg;
        int damage, ap,dp,bp;

        if( !target ) target = offensive_target(me);
//      if( !target
        if( !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这个法术？\n");

        if(!me->is_fighting())
                return notify_fail("梦幻之舞唯在战斗中才能使用。\n");
        if((int)me->query("atman") < 25 )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("gin") < 10 )
                return notify_fail("你的精神没有办法有效集中！\n");

        me->add("atman", -50);
        me->receive_damage("gin", 10);

        if( random(me->query("max_atman")) < 50 ) {
                write("你失败了。\n");
                return 1;
        }
         write("[1;32m\n                    妳忽然领悟了夜梦天舞中梦幻之舞的绝学。\n[0m");
         msg = HIC "\n                     $N忽然翩然起舞，眼前只见$N那美丽的身影幻" NOR;
         msg += HIC "\n                     化出无数美妙的舞步，令人看得如痴如醉，好" NOR;
         msg += HIC "\n                          似天仙下凡，犹如身处幻梦之中。\n\n" NOR;
         message_vision(msg, me, target);
        ap = me->query_skill("magic");
        bp = me->query_skill("unarmed");
        ap = (( ap * ap * ap / 8) + (bp * bp * bp / 8)) * (int)me->query("gin") / 100;
        dp = target->query("combat_exp");
        if( random(ap + dp) > (dp/2) ) {
                damage = (int)me->query("max_atman") / 20 + random((int)me->query("eff_gin") / 10);
                damage -= (int)target->query("max_atman") / 30 + random((int)me->query("eff_gin") / 15);
                if( damage > 0 ) {
                        write("[1;32m\n                     结果成功\的施展出梦幻之舞。\n[0m");
                        say( "[1;35m                     "+target->query("name")+"露出如痴如醉的表情，整个人像失了魂似的!!\n[0m");
                        target->add("sen",-25);
                        target->start_busy(3);
                        me->improve_skill("dremagic", 1, 1);
                } else if(damage < 0) {
                        write("[1;33m\n                     结果似忽不是很有效。\n[0m");
                        say( "[1;34m                     "+target->query("name")+"稍为呆了一会立即又恢复正常！\n[0m");
                        target->add("sen",-15);
                        target->start_busy(2);
                        me->improve_skill("dremagic", 1, 1);}
        } else if( random(ap + dp) < (dp/2) ) {
                write("[1;31m\n                     结果丝毫起不了作用令妳暗自惋昔。 \n[0m");
                say( "[1;32m                     但是"+target->query("name")+"丝毫不为所动。\n[0m");}
           
        if( damage > 0 ) COMBAT_D->report_status(target);

//      if( !target->is_fighting(me) ) {
//              if( living(target) ) {
//                      if( userp(target) ) target->fight_ob(me);
//                      else                            target->kill_ob(me);
//              }
//              me->kill_ob(target);
//      }

        me->start_busy(1);
        return 1;
}

