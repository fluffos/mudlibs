// swordkee.c
// 将 swordkee 改为大家较可以用的程度, 花的 force 较少, damage 也较少,
// 且用法改为 perform sword.swordkee 			fix by onion
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
	object weapon;
	int force_cost= (me->query_skill("sword")+50)/4;
	if( (me->query("class") != "swordsman")&&(me->query("class") != "blademan")
	  &&(me->query("class") != "fighter") )
	  return notify_fail("你的职业无法使出剑气。\n");
	if( me->query("force") < force_cost )
	  return notify_fail("你的内力不够。\n");
        if( me->query_skill("sword",1) < 20 )
	  return notify_fail("你的基本剑术太差了。\n");
	if( !me->is_fighting() )
	  return notify_fail("剑气要战斗中才能使用。\n");
	if(!objectp(weapon=me->query_temp("weapon")) || (string)weapon->query("skill_type")!="sword")
	  return notify_fail("要有剑才能发剑气。\n");	
	if( target == me )
	  return notify_fail("不能对付自己呀!!\n");
	if( !target )
	  target = offensive_target(me);
	me->add("force",-force_cost );
	message_vision(
	   HIW "$N将内力贯注在剑上，猛然一挥，一道剑气腾出，往$n而来！\n" NOR,me,target);
	if(random(me->query_skill("sword"))*1.5>target->query_skill("dodge")+target->query_skill("parry"))
	{
		message_vision(
		HIR "$n闪躲不及，$N的剑气已在$n身上划出一道血淋淋的伤痕。\n" NOR,me,target);
		target->receive_damage("kee", me->query("max_force")/20+me->query_skill("sword") );
		COMBAT_D->report_status(target);
	}
	else
		message_vision(
	HIY "$n侧身一闪，避开了$N的剑气。\n" NOR,me,target);
	if( me->is_fighting() ) me->start_busy(2);

	return 1;
}
