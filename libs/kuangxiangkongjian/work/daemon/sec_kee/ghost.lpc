// gather.c

#include <combat.h>

#include <ansi.h>

inherit SSERVER;

int kee_out(object me,object target)
{
     int value=me->query("max_s_kee");
     object ghost;
    if(me->query("s_kee")<30)
     {
         tell_object(me,"你的灵气不够。\n");
          return 1;
     }
    message_vision(
       HIR "$N灵气浮动，天魔之气随之而出。\n" NOR,me);
    me->add("s_kee",-30);
      seteuid(getuid());
     ghost=new("/obj/npc/ghost");
     ghost->move(environment(me));
     ghost->invocation(me);
     ghost->set("kee",value*30);
     ghost->set("max_kee",value*30);
     ghost->set("eff_kee",value*30);
          ghost->set("combat_exp",value*5000);
     ghost->set("str",value);
     return 1;
}
int kee_spe(object me)
{
        if(me->query_temp("spe")==1)
        {
                tell_object(me,"你已经在使用灵气了。\n");
                return 1;
        }
     if(me->query("s_kee")<20)
     {
        tell_object(me,"你的灵气不够。\n");
        return 1;
     }
     message_vision(
          HIR "$N身上的天魔之气爆发出来，形成可怕的魔气。\n" NOR,me);
     me->add("s_kee",-20);
      me->set_temp("spe",1);
      me->add("combat_exp",me->query("max_s_kee")*1000);
	me->start_call_out( (: call_other,__FILE__,"remove_it",me :),me->query("max_s_kee"));
     return 1;
}
int remove_it(object me)
{
	me->add("combat_exp",-1000*me->query("max_s_kee"));
	me->delete_temp("spe");
      message_vision(
         HIR "$N身上的天魔之气气势渐渐平缓。\n" NOR,me);
}
