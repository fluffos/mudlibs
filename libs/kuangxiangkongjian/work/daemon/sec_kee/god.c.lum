// gather.c

#include <combat.h>

#include <ansi.h>

inherit SSERVER;

int kee_out(object me,object target)
{
	if(me->query("s_kee")/10)
       {
           tell_object(me,"你的灵气不够。\n");
           return 1;
       }
      message_vision(
          HIC "$N的灵气浮动，仙云之气出窍！\n" NOR,me);
      message_vision(
          CYN "$N的仙云之气不断环绕在$N身边。\n" NOR,me);
      me->start_busy(1);
     me->set("s_kee",0);
     me->apply_condition("get_god",me->query("max_s_kee")/10);
      return 1;
}
int kee_spe(object me)
{
        if(me->query_temp("spe")==1)
        {
                tell_object(me,"你已经在使用灵气了。\n");
                return 1;
        }
	if(me->query("s_kee")<20)
      {
           tell_object(me,"你的灵气不够。\n");
           return 1;
      }
      message_vision(
           HIC "$N的仙云之气散发出灵光，将神力贯入$N脑部。\n" NOR,me);
	me->add("s_kee",-20);
	me->set_temp("spe",1);
	me->add("int",me->query("max_s_kee")/20);
	me->start_call_out( (: call_other,__FILE__,"remove_it",me :),me->query("max_s_kee"));
      return 1;
}
void remove_it(object me)
{
	me->add("int",-1*me->query("max_s_kee")/20);
	me->delete_temp("spe");
      message_vision(
         HIC "$N的仙云之气所发出的灵光消失了。\n" NOR,me);

}
