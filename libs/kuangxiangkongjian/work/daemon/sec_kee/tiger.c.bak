// gather.c
 
#include <combat.h>
 
#include <ansi.h>
 
inherit SSERVER;
 
int kee_out(object me,object target)
{
        if(me->query("s_kee")<10)
     {
          tell_object(me,"你的灵气不够。\n");
             return 1;
     }
   if(me->query("s_kee")<10)
{
     tell_object(me,"你的灵气不够。\n");
        return 1;
}
   if(me->query("kee") >= me->query("max_kee")*0.4){
      tell_object(me,"情况还没危急到使用护身技");
         return 1;
   }
     message_vision(
          HIY "$N的灵气浮动，雷虎之气腾出！\n" NOR,me);
       message_vision(
          CYN "$n被雷虎之气缠住，不能动弹。\n" NOR,me,target);
        target->start_busy(me->query("max_s_kee")/10);
        target->apply_condition("tiger_out",me->query("max_s_kee")/10);
     me->kill_ob(target);
        me->set("s_kee",0);
     return 1;
 
}
int kee_spe(object me)
{
        if(me->query_temp("spe")==1)
        {
                tell_object(me,"你已经在使用灵气了。\n");
                return 1;
        }
    if(me->query("s_kee")<20)
      {
           tell_object(me,"你的灵气不够。\n");
           return 1;
      }
 
      message_vision(
          HIY "$N身上的雷虎之气开始聚集在你的丹田。\n" NOR,me);
        me->set("s_kee",0);
        me->set_temp("spe",1);
        me->add("con",me->query("max_s_kee")/20);
        me->start_call_out( (: call_other,__FILE__,"remove_it",me :),me->query("max_s_kee"));
      return 1;
}
void remove_it(object me)
{
        me->add("con",-1*me->query("max_s_kee")/20);
        me->delete_temp("spe");
      message_vision(
          HIY "聚集在$N丹田的雷虎之气开使散开了。\n" NOR,me);
}
