// gather.c

#include <combat.h>

#include <ansi.h>

inherit SSERVER;

int kee_out(object me,object target)
{

     if(me->query("s_kee")*5<me->query("max_s_kee"))
      {
          tell_object(me,"你的灵气不够。\n");
          return 1;
      }
      message_vision(
         HIG + "$N灵气浮现，只见一条青龙从你体内冲出！\n" NOR,me);
         message_vision(  CYN "结果$N的青龙之气贯穿$n的身体。\n" NOR,me,target);
        target->add("kee",-1*me->query("max_s_kee")-30);
      COMBAT_D->report_status(target);

      me->add("s_kee",-1*me->query("max_s_kee")/5);
          me->start_busy(1);
       me->kill_ob(target);
	return 1;
}
int kee_spe(object me)
{
        if(me->query_temp("spe")==1)
        {
                tell_object(me,"你已经在使用灵气了。\n");
                return 1;
        }
     if(me->query("s_kee")<10)
      {
         tell_object(me,"你的灵气不够。\n");
         return 1;
      }
      message_vision(
          HIG "$N的青龙之气附在$N手上，使$N力量大增。\n" NOR,me);
       me->add("s_kee",-10);
         me->set_temp("spe",1);
      me->add("str",me->query("max_s_kee"));
   me->start_call_out( (: call_other,__FILE__,"remove_it",me :),me->query("max_s_kee"));
     return 1;
}
void remove_it(object me)
{
   me->add("str",-1*me->query("max_s_kee"));
   me->delete_temp("spe");
   message_vision(
      HIG "附在$N手臂上的青龙之气消失了。\n" NOR,me);
}
