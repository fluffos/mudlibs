// invis

inherit SECURITY_D;
inherit F_CLEAN_UP;

int main(object me, string arg)
{
  int	i;

  if (!arg)
    me->set("env/隐身", wiz_level(me));
  else {
    sscanf (arg, "%d", i);
    if (!intp(i))
      return notify_fail ("[invis]: invis [等级]\n");
    me->set("env/隐身", (i > wiz_level(me)) ? wiz_level(me) : i );
  }
  return 1;
}

int help(object me)
{
write(@HELP
指令格式 : invis [等级]
 
这个指令会让巫师得以隐形, 等级可以不给, 要给就一定要是数字
 
HELP
    );
    return 1;
}
