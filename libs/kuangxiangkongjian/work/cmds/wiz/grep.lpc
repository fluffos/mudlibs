// grep.c
// 增加 万用字元(?*) 的使用
// fixed by wade 1995 10 23

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string src, search, dest, *dirs;
  // 底下是为了能 cp * 用的
  mixed *file;
  string dir, srcdir, all_dir = "";
  int i, j, found;

  seteuid(geteuid(me));

  // 解析参数
  if (!arg) return notify_fail("指令格式: cp <'字串'> [目标档名]\n例如: grep 'main' workroom.c\n");

  // 这地方要修正
  if (sscanf(arg, "'%s' %s", search, src) != 2 &&
    sscanf(arg, "%s %s", search, src) != 2) {
    src = "*";
    search = arg;
  }
  write(sprintf("search %s from %s\n", search, src));

  // 取得 source 档名
  dir = resolve_path(me->query("cwd"), src);
  dirs = explode(dir, "/");
  srcdir = dir;
  srcdir[sizeof(dir) - sizeof(dirs[sizeof(dirs) - 1])] = 0x00;
  if (file_size(dir) == -2 && dir[strlen(dir) - 1] != '/') dir += "/";
  file = get_dir(dir, -1);
  if (!sizeof(file)) {
    if (file_size(dir) == -2)
      return notify_fail("目录是空的。\n");
    else
      return notify_fail("没有这个档案: " + src + "。\n");
  }

  i = sizeof(file);
  write("搜寻内容是: " + search + "\n");
  while (i--) {
    if (file[i][1] != -2) {  // 有这个档
      src = srcdir + file[i][0];
      dir = src + "\n";
      src = read_file(src);
      if (src) dirs = explode(src, "\n");
      found = 0;
      for (j = 0; j < sizeof(dirs); j++)
        if (strsrch(dirs[j], search) != -1) {
          found = 1;
          dir += sprintf("%3d: %s\n", j + 1, dirs[j]);
        }
      if (found) all_dir += dir;
    }
  }
  me->start_more(all_dir);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : grep <'搜寻字串'> [目标档名]
使用范例 :
	   grep notify_fail		<-- 等于下一例
	   grep notify_fail *		<-- 从所有档里找 notify_fail
	   grep 'return notify_fail'	<-- 等于下一例
	   grep 'return notify_fail' *	<-- 搜寻字串里有空白
	   grep 'return notify_fail' workroom.c
	   grep 'return notify_fail' /u/w/wade/workroom.c
 
    此指令可让你(妳)在某个档里搜寻字串

    搜寻字串里含有空格时, 一定要引号
HELP
  );
  return 1;
}
