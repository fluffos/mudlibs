inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
  object	ob;
  string	dir, *files, file, name;
  int		i, count, now=time();
 
  seteuid(getuid(me));

  // 取得 /data/user/* 子目录群
  dir = "/data/user/a/";
  count = 0;
  for (dir[11]='a'; dir[11]<='z'; dir[11]++) {
    files = get_dir (dir);
    for (i=0; i<sizeof(files); i++) {
	file = files[i];
	name = file[0..sizeof(file)-3];
	ob = FINGER_D->acquire_login_ob(name);
	if (objectp(ob)) {
	  // if (!wiz_level(ob)) {
	// 	rm ("/data/user/"+dir[11..11]+"/"+name+".o");
	// 	rm ("/data/login/"+dir[11..11]+"/"+name+".o");
		if (now - ob->query("last_on") > 2595000)
		  printf ("%s(%s) 已经超过一个月没来了。\n", ob->name(), ob->query("id"));
		count++;
	  // }
	}
	else printf (".");
    }
  }

  printf ("\ntotal %d 个玩家\n", count);
  return 1;
}
 
int help(object me)
{
  write(@HELP
指令格式 : auto
 
此指令可让系统自动 purge
HELP
    );
    return 1;
}
 
