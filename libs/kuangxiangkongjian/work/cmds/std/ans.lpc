// ans.c by Konn 1996.9.4

inherit F_CLEAN_UP;
int help(object);

int main(object me, string arg)
{
        int ans;

        seteuid(getuid());
        if( !me->query_temp("robot/must_ans") )
            return 0;
        if( !arg ) return help(me);
        arg = lower_case(arg);
        if( sscanf(arg, "%d", ans) != 1 )
            return notify_fail("这是算术耶! 请答个数字好吗?\n");
        if( me->query_temp("robot/ans") != ans ) {
            return notify_fail("你是机器人吗? 这么简单都会答错?\n"+
                               "不想被quit的话就好好答吧!\n");
        }
        me->delete_temp("robot");
        write("既然答对了那就放你一马.\n");
        return 1;
}

int help(object me)
{
        write(@HELP

ans 这个指令是当你在被系统审问时, 用来回答问题的指令。
格式: ans <答案>

HELP);
        return 1;
}
