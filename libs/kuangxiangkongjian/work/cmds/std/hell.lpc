// hell.c by konn

inherit F_CLEAN_UP;
int help(object);

int main(object me, string str) {
  object evil;
  string env;

  seteuid(getuid());

  if (str == "save") {
    evil = environment(me);
    if (evil->query("evil")) {
      me->set("evil_environment", file_name(evil));
      return notify_fail("您的进度已贮存完毕.\n");
    } else return notify_fail("你并不在魔界里, 无法替您贮存进度.\n");
    return 1;
  } else if (str == "load") {
    if (env = me->query("evil_environment")) {
      me->move(env);
      return notify_fail("您已进入魔界, 祝您好运.\n");
    } else return notify_fail("咦? 没读到您的进度耶, 请再check 一下吧!\n");
    return 1;
  } else help(me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : hell <save>|<load>
指令说明 :
           这指令是让你可以贮存或载入在魔界中的游戏进度。
HELP);
  return 1;
}
