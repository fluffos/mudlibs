inherit F_CLEAN_UP;

#include <ansi.h>


inherit F_SAVE;

mapping quests_list = ([ ]);
mapping quest_long = ([ ]);
string have_finish(string arg);

int main(object ob , string arg)
{
	int i;
	string *k;
	restore();
	if( !arg )
	{
	k = keys(quests_list);
	printf("有"+HIC "ν" NOR+"记号者为已完成\n");
	for(i = 0;i < sizeof(quests_list);i+=2)
	{
	printf("%s%d%s\t%s%d%s\n",
	have_finish(quests_list[k[i]]),
	i+1,k[i],
	(i+1 <sizeof(quests_list)? have_finish(quests_list[k[i+1]])
	:""),
	(i+1<sizeof(quests_list)? i+2:""),
	(i+1<sizeof(quests_list)? k[i+1]:"") );
	}
	return 1;
	}
	else
	{
	if( sscanf(arg,"%d",i) != 1)
	return notify_fail("请输入要查询之quest编号\n");
	k = keys(quests_list);
	if( i >= (sizeof(k) + 1) || i <= 0 )
	return notify_fail("好像没有这个编号吧？\n");
	printf("%d%s：%s\n",i,k[i-1],quest_long[k[i-1]]);
	return 1;
	}
}

string query_save_file()
{ return "/data/questlist" ; }

string have_finish(string arg)
{
	object me;
	me = this_player();
	if( !me->query(arg) || me->query(arg) != 1 )
	return " ";
	else
	return HIC "ν" NOR;
}

int help(object me)
{
	write(@HELP
指令格式 : dumpquest
指令说明 :
           这指令让你看任务。
HELP );
	return 1;
}
