inherit F_CLEAN_UP;
int help(object me);

int main(object me, string arg) {
  object *ob, obj;
  int i;

  if (!arg) return help(me);
  if (arg == "all")
    for (i = 0; i < sizeof(ob = all_inventory(me)); i++)
      ob[i]->set_temp("secured", 1);

  else if (obj = present(arg, me))
    obj->set_temp("secured", 1);
  else return notify_fail("没有这样物品。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : secure <物件>
范    例 : secure map
           secure all
说    明 :
           本指令让玩家可以保护物件，以免被 drop，sell，give
HELP
  );
  return 1;
}
