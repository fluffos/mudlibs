//made by urd

#define TIME_TICK (time()*60)
#include <localtime.h>
#include <ansi.h>

inherit ROOM;

mapping menu = ([
  // 2:猫实工大  3 :雅典  4:东计时坡  5:西计时坡
  0: 2,
  1: 3,
  2: 4,
  3: 5,
  4: 2,
  5: 3,
  6: 4,
  7: 5,
  8: 2,
  9: 3,
  10: 4,
  11: 5,
  12: 2,
  13: 3,
  14: 4,
  15: 5,
  16: 2,
  17: 3,
  18: 4,
  19: 5,
  20: 2,
  21: 3,
  22: 4,
  23: 5,
]);

void create() {

  set("short", "猫实站");
  set("long", @LONG
这儿就是猫实站了，要到别的地区就得来这儿搭乘定期
出发的交通工具，看板上显示了飞往各地的下一班次时间及票价
，你可以查询一下(query) ，看看你想搭乘的班次是什么时候。
LONG
  );


  set("exits", ([ /* sizeof() == 2 */
    "south": "/u/u/urd/workroom",
  ]));

  setup();
  set_heart_beat(1);
}

void init() {
  add_action("detail", "query");
}

int detail(string no_use) {
  int next_bus, next_bus1, next_ys, next_ys1, next_est, next_est1, next_wsta, next_wsta1, i;
  mixed *local;

  local = localtime(TIME_TICK);

  for (i = 1; i < 24; i++) {
    if ((local[LT_HOUR] + i) > 23 && menu[local[LT_HOUR] + i - 24] == 2)
      next_bus = local[LT_HOUR] + i - 24, next_bus1 = 1, i = 25;
    else if (menu[local[LT_HOUR] + i] == 2) next_bus = local[LT_HOUR] + i, next_bus1 = 0, i = 25;
  }
  for (i = 1; i < 24; i++) {
    if ((local[LT_HOUR] + i) > 23 && menu[local[LT_HOUR] + i - 24] == 3)
      next_ys = local[LT_HOUR] + i - 24, next_ys1 = 1, i = 25;
    else if (menu[local[LT_HOUR] + i] == 3) next_ys = local[LT_HOUR] + i, next_ys1 = 0, i = 25;
  }
  for (i = 1; i < 24; i++) {
    if ((local[LT_HOUR] + i) > 23 && menu[local[LT_HOUR] + i - 24] == 4)
      next_est = local[LT_HOUR] + i - 24, next_est1 = 1, i = 25;
    else if (menu[local[LT_HOUR] + i] == 4) next_est = local[LT_HOUR] + i, next_est1 = 0, i = 25;
  }
  for (i = 1; i < 24; i++) {
    if ((local[LT_HOUR] + i) > 23 && menu[local[LT_HOUR] + i - 24] == 5)
      next_wsta = local[LT_HOUR] + i - 24, next_wsta1 = 1, i = 25;
    else if (menu[local[LT_HOUR] + i] == 5) next_wsta = local[LT_HOUR] + i, next_wsta1 = 0, i = 25;
  }
  printf("\t目的地　　 　 下一班次时间           价钱\n");
  printf("\t-------------------------------------------------\n");
  printf("\t猫实工大      %s日%s点整       两百五十文钱\n",
    chinese_number(local[LT_MDAY] + next_bus1),
    chinese_number(next_bus));
  printf("\t雅典          %s日%s点整       两百五十文钱\n",
    chinese_number(local[LT_MDAY] + next_ys1),
    chinese_number(next_ys));
  printf("\t东计时坡        %s日%s点整       两百五十文钱\n",
    chinese_number(local[LT_MDAY] + next_est1),
    chinese_number(next_est));
  printf("\t西计时坡      %s日%s点整       两百五十文钱\n",
    chinese_number(local[LT_MDAY] + next_wsta1),
    chinese_number(next_wsta));
  printf("\t-------------------------------------------------\n");
  return 1;
}
void heart_beat() {
  mixed *local;

  local = localtime(TIME_TICK);
  if (menu[local[LT_HOUR]] == 2
    && local[LT_MIN] >= 0 && local[LT_MIN] <= 3 && query("aircraft2") == 0
  ) call_out("air_arr", 0, 2);
  if (menu[local[LT_HOUR]] == 3
    && local[LT_MIN] >= 0 && local[LT_MIN] <= 3 && query("aircraft3") == 0
  ) call_out("air_arr", 0, 3);
  if (menu[local[LT_HOUR]] == 4
    && local[LT_MIN] >= 0 && local[LT_MIN] <= 3 && query("aircraft4") == 0
  ) call_out("air_arr", 0, 4);
  if (menu[local[LT_HOUR]] == 5
    && local[LT_MIN] >= 0 && local[LT_MIN] <= 3 && query("aircraft5") == 0
  ) call_out("air_arr", 0, 5);
  if (menu[local[LT_HOUR]] == 2
    && (local[LT_MIN] - 30) >= 0 && (local[LT_MIN] - 30) <= 3
    && query("aircraft2") == 1) call_out("air_leave", 0, 2);
  if (menu[local[LT_HOUR]] == 3
    && (local[LT_MIN] - 30) >= 0 && (local[LT_MIN] - 30) <= 3
    && query("aircraft3") == 1) call_out("air_leave", 0, 3);
  if (menu[local[LT_HOUR]] == 4
    && (local[LT_MIN] - 30) >= 0 && (local[LT_MIN] - 30) <= 3
    && query("aircraft4") == 1) call_out("air_leave", 0, 4);
  if (menu[local[LT_HOUR]] == 5
    && (local[LT_MIN] - 30) >= 0 && (local[LT_MIN] - 30) <= 3
    && query("aircraft5") == 1) call_out("air_leave", 0, 5);
}

int air_arr(int air) {
  object obj;
  obj = present("aircraft");
  if (objectp(obj)) destruct(obj);
  if (air == 2) {
    set("aircraft2", 1);
    obj = new("/u/u/urd/bus.lpc");
    obj->set_name(HIY "开往猫实工大的公车" NOR, ({ "bus" }));
    set_temp("aircraft2", obj);
    write("开往猫实工大的车子已经到达了，欲搭乘的旅客请快上车(ascend)。\n");
    set("exits", ([ /* sizeof() == 1 */
      "south": "/u/u/urd/workroom",
      "ascend": "/u/u/urd/bus_room",
    ]));
  }
  if (air == 3) {
    set("aircraft3", 1);
    obj = new("/u/u/urd/aircraft1.lpc");
    obj->set_name(HIY "飞往雅典的--飞船" NOR, ({ "aircraft" }));
    set_temp("aircraft3", obj);
    write("飞往雅典的飞船已经到达了，欲搭乘的旅客请快上船(ascend)。\n");
    set("exits", ([ /* sizeof() == 1 */
      "south": "/u/u/urd/workroom",
      "ascend": "/u/u/urd/ys_room",
    ]));
  }
  if (air == 4) {
    set("aircraft4", 1);
    obj = new("/u/u/urd/train1.lpc");
    obj->set_name(HIY "开往东计时坡的火车" NOR, ({ "train" }));
    set_temp("aircraft4", obj);
    write("开往东计时坡的火车已经到达了，欲搭乘的旅客请快上车(ascend)。\n");
    set("exits", ([ /* sizeof() == 1 */
      "south": "/u/u/urd/workroom",
      "ascend": "/u/u/urd/esta_room",
    ]));
  }
  if (air == 5) {
    set("aircraft5", 1);
    obj = new("/u/u/urd/train.lpc");
    obj->set_name(HIY "开往西计时坡的火车" NOR, ({ "train" }));
    set_temp("aircraft5", obj);
    write("开往西计时坡的火车已经到达了，欲搭乘的旅客请快上车(ascend)。\n");
    set("exits", ([ /* sizeof() == 1 */
      "south": "/u/u/urd/workroom",
      "ascend": "/u/u/urd/westa_room",
    ]));
  }
  obj->move(this_object());
  return 1;
}

int air_leave(int air) {
  object obj;
  write("交通工具离开月台了。\n");
  if (air == 2) {
    set("aircraft2", 0);
    obj = query_temp("aircraft2");
  }
  if (air == 3) {
    set("aircraft3", 0);
    obj = query_temp("aircraft3");
  }
  if (air == 4) {
    set("aircraft4", 0);
    obj = query_temp("aircraft4");
  }
  if (air == 5) {
    set("aircraft5", 0);
    obj = query_temp("aircraft5");
  }
  if (!objectp(obj)) obj = present("aircraft");
  if (objectp(obj)) destruct(obj);

  set("exits", ([ /* sizeof() == 1 */
    "south": "/u/u/urd/workroom",
  ]));
  return 1;
}
