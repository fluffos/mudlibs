// magic.c
#include <ansi.h>
inherit SKILL;
mapping *action = ({
  ([ "action": "一阵暴强的雄浑金气霎时如狂龙般的缠绕着$N的剑   ,使出狂龙剑法极霸道的一式‘狂龙破空’ ,劲散身 ,飞身于空 ,宛如一支金箭般直射向   $n,",
    "dodge": -10,
    "damage": 250,
    "damage_type": "破体之伤"
  ]),
  ([ "action": "$N使出一式‘魔气无常’ ,剑以气行 ,$w如鬼魅一
般游移于$n的四面八方 ,霎时$N指一笔,手一划 ,$n四周气劲立时化为千万柄$w棉密不绝
的疾刺$n的$l,",
    "dodge": -50,
    "damage": 80,
    "parry": -50,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N使出魔道剑术最邪气的一式 ,‘商魂魔身’,剑勾
地魂 ,扯出一片阴气所成的剑气聚于剑身 ,$N剑提倒八 ,横空一划 ,暴放如半月状的阴气
飞向$n ,",
    "dodge": -20,
    "damage": 180,
    "damage_type": "斩伤"
  ]),
  ([ "action": "$N一招‘火麟杀神’,$N手中$w一连十八疾刺 ,剑剑  点向$n的要害 ,但$N剑还未碰到$n时却闪电收剑 ,余下十八点惨蓝剑魔气飞向$n十八处要  穴 ! ",
    "dodge": -20,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N以指贯入$w的剑身 ,剑身闪出一阵耀目金光 ,$N   气提十二成 ,劲注全身 ,蓄势准备使出最强最霸道的一式‘风魔狂转业’,霎时狂龙魔气
急速旋绕$N ,无俦魔气因此惊动天地之气 ,互抗暴出数道紫电雷光 ,$N忽然现身于$n前 ,
对$n使出了HIR石破天惊的NOR一击 ! ",
    "dodge": 50,
    "damage": 300,
    "damage_type": "断体之伤"
  ]),
  ([ "action": "$N手中$w使出如猛虎的一式‘狂魔虎炮’夹带着无   比雄厚的灭世魔内力笔直的向$n刺出一剑",
    "dodge": -3,
    "damage": 180,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N仰天狂号一声 ,内力疾吐 ,震开了$n ,霎时飞身而 上 ,使一招‘斗魔无生魂’,如天魔临世一般 ,持剑过头 ,如雷闪电的劈向$n",
    "dodge": 15,
    "damage": 210,
    "damage_type": "砍伤"
  ]),
  ([ "action": "$N手起青眼架式 ,一式‘灭世魔剑’,手起剑落的往  $n的$l兴起一阵失心乱斩 ",
    "dodge": -30,
    "damage": 100,
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  object ob;
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("没有剑怎么练剑 ?\n");
  return 1;
}
int valid_skill_usage(string usage) {
  return usage == "sword" || usage == "parry";
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 10
    || (int)me->query("force") < 3 || (int)me->query("bellcosity") < 100)
    return notify_fail("你的杀气还不够逼人 ,体力内力也无法驾御此剑  法。\n");
  me->receive_damage("kee", 5);
  me->add("force", -3);
  me->add("bellcosity", 10);
  write("你忘神的练了一遍魔剑后 ,越觉得心神难控 ! \n");
  return 1;
}
