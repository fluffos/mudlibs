        return 1;
}
int no_home(string str){
        write(""HIG"笨!!你逃不出去就是逃不出!!还想回家!!"NOR"\n");
        return 1;
}
int no_more(string str){
        write("呵呵!!想用more!!这是根本不可能的事!!\n");
        return 1;
}
