// swallo.c

#include <ansi.h>
#include <combat.h>

int useforce(object me, object target) {
  object ob;
  string msg, limb, *limbs;
  int i, damage, ap, dp, ac, bu, td, md, pp, max;
  mapping myactions, uractions;

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用这个大决招？\n");


  if (me->query("force") < 30)
    return notify_fail(" (你的爆发力还不够！)\n");

  me->add("force", -30);

  //	if( random(me->query("max_atman")) < 50 ) {
  //		write("你失败了。\n");
  //		return 1;
  //	}

  td = target->query("dex");
  md = me->query("dex");

  ap = COMBAT_D->skill_power(me, "super", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->skill_power(target, "dodge", SKILL_USAGE_DEFENSE);
  pp = COMBAT_D->skill_power(target, "parry", SKILL_USAGE_DEFENSE);
  max = (int)me->query_skill("super") * 2 / 6;

  for (i = 0; i < max; i++) {

    myactions = me->query("actions");
    uractions = target->query("actions");

    dp += td * td * 3 + uractions["dodge"] * 60;
    pp += uractions["parry"];
    ac = ap * 3 + me->query("apply/ac") * 60 + md * md * md / 2 + me->query("kar") * 200 + myactions["ac"] * 60;

    damage = (int)random(ap) / 10 + random(me->query_temp("apply/damage")) - random(target->query_temp("apply/armor"));
    if (me->query("force") - 3 < 0) {
      message_vision("(可惜$N冲击力已显不足,只好暂停攻势!)\n", me, target);
      i = 100;
    } else {
      msg = myactions["action"];
      if (random(ac + pp) > pp * (i / 4 + 1)) {
        if (random(ac + dp) > dp * (i / 4 + 1)) {
          if (damage > 0) {
            msg += "$p挡不住这一招,煞时鲜血四溅.. " + HIR "( " + damage + " )\n" NOR;
            target->receive_damage("kee", damage, me);
            target->receive_wound("kee", damage / 40, me);
            me->improve_skill("super", 1, 1);
          } else
            msg += "但是没有对$p造成任何伤害!\n" NOR;
          limbs = target->query("limbs");
          limb = limbs[random(sizeof(limbs))];
          msg = replace_string(msg, "$l", limb);

          if (ob = me->query_temp("weapon"))
            msg = replace_string(msg, "$w", ob->name());
          message_vision(msg, me, target);
          if (damage > 0) COMBAT_D->report_status(target);
          me->add("force", -3);
        } else {
          limbs = target->query("limbs");
          limb = limbs[random(sizeof(limbs))];
          msg = replace_string(msg, "$l", limb);

          if (ob = me->query_temp("weapon"))
            msg = replace_string(msg, "$w", ob->name());
          msg += "可惜被$p躲过了..\n" NOR;
          message_vision(msg, me, target);
        }
      } else {
        limbs = target->query("limbs");
        limb = limbs[random(sizeof(limbs))];
        msg = replace_string(msg, "$l", limb);

        if (ob = me->query_temp("weapon"))
          msg = replace_string(msg, "$w", ob->name());
        msg += "结果$p看清了$N的招式,挡住了这一招...\n" NOR;
        message_vision(msg, me, target);
        i = 100;
      }
    }
  }

  me->start_busy(1);
  target->start_busy(1);
  return 1;
}
