// 小胖专用技能 : 变态神掌 //
#include <ansi.h>

inherit SKILL;

mapping *action = ({
        ([      "action":               "$N使出一招变态神掌第一式[快打升龙拳]
, 由下而上打向$n的下巴",
                "dodge":                -30,
                "parry":                20,
                "ac":                   10,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               "$N两手回收成花形, 大喊:「看我的变态
神掌第三式[龟派气功]!!” 一记金黄色的气波击向$n的$l",
                "dodge":                -30,
                "parry":                -30,
                "ac":                   20,
                "damage_type":  "伤害"
        ]),
        ([      "action":               "$N纵身跳起,使出一招变态神掌第二式[无
敌剪刀脚],双腿瞬间朝向$n的头部攻来",
                "dodge":                -30,
                "parry":                20,
                "ac":                   23,
                "damage_type":  "伤害"

        ]),
        ([      "action":               "$N忽地一吼,一招变态神掌第四式[小胖
摸摸]以迅捷无比的速度扑向$n",
                "dodge":                30,
                "parry":                -30,
                "ac":                   25,
                "damage_type":  "伤害"
        ]),
        ([      "action":               "$N忽然欺身上前,抱住$n的肚子,使出
一招变态神掌第五式[小胖抱抱]",
                "dodge":                -20,
                "parry":                -20,
                "ac":                   25,
                "damage_type":  "伤害"
        ]),
        ([      "action":               "$N忽然分身成两人, 冲向$n的双手双
脚, 大喊一声:「变态神掌第六式[阿鲁巴],就抬起$n撞向一根不知从哪来的仙人掌!!",
                "dodge":                -30,
                "parry":                -30,
                "ac":                29,
                "damage_type":  "伤害"
        ]),
        ([      "action":               "$N忽然站立着不动, 口中一直唸着「
小胖最变态”五个字, 一时$N" + HIY"全身发出金光" NOR + ", 大喊:「看我的变
态神掌最后一式....[小胖亲亲],冲向$n一阵狂吻!!",
                "dodge":                -50,
                "parry":                -50,
                "ac":                   35,
                "damage":               1000,
                "damage_type":  "伤害"
        ]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练变态神掌必须空手。\n");
        if( (int)me->query("max_force") < 2000 )
                return notify_fail("你的内力太弱，无法练变态神掌\n");              
}

int valid_skill_usage(string usage)
{
        return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 5 )
                return notify_fail("你的内力不够了，休息一下再练吧。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        return 1;
}
