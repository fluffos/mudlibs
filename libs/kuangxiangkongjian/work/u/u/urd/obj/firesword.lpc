//  /u/t/tnn/obj/holy_sword.c 阿亚的剑

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
	set_name(RED"ψ 火  焰  剑 ψ"NOR,({"firesword"}));


	set_weight(5000);

        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit","把");
		set("long"," 这是一把周围泛着火焰的宝剑，也是晓萱专用的剑\n");
		set("material","crimsonsteel");
		set("value",500000);
    	} //end of else
    	
	init_sword(500);
	
	set("wield_msg",RED"瞬间红光宠罩大地，一红光束化为$n"RED"显于$N手中。\n"NOR);
	set("unwield_msg",RED"一束红光自$N手中消失，$n"RED"也消失无纵。\n"NOR);
	
	setup();

} // eof create()

int wield()
{
	if ((string)this_player()->query("id") != "carol")
		return notify_fail(" 这把剑对你没用，请交还晓萱。\n");
	else {
        	::wield();
        } //end of else


     return 1;

} //EOF
