// lum.c

inherit EQUIP;

void create()
{
        set_name("拉姆头罩", ({ "lum" }) );
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 600);
		set("material", "cloth");
                set("armor_type", "lum");
		set("armor_prop/id", ({"maskman"}) );
                set("armor_prop/name", ({"拉姆"}) );
                set("armor_prop/short", ({"拉姆(lum)"}) );
		set("armor_prop/long", ({
                        "他就是大wiz拉姆。\n"
		}) );
	}
}
