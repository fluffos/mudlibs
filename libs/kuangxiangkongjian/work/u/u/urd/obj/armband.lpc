#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIG "剑魔臂环" NOR,({"duku armband","armband"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit","件");
    set("long","这是剑魔独孤求败的臂环。\n");
    set("material","blacksteel");
    set("value",10000);
    set("armor_type","armband");
    set("armor_prop/armor",100);
    set("armor_prop/unarmed",100);
       }
  setup();
}
