#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIG "战神披风" NOR,({"duku cape","cape"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit","件");
    set("long","红色的披风上绣着一条恶龙，是琪琪为独孤求败亲手缝制。\n");
    set("material","blacksteel");
    set("value",10000);
    set("armor_type","cape");
    set("armor_prop/armor",100);
       }
  setup();
}

