//fire-belt.c made by carol
#include <ansi.h>
inherit EQUIP;

void create()
{
	set_name(HIR"火  焰  "HIW"腰  带"NOR,({"fire belt","fire","belt"}));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
	set("unit","条");
	set("long","这是小魔女萱萱用火焰制成的腰带，这也是她参加宴会时所穿的。\n");
	set("value",6000);
	set("material","fire");
	set("armor_type","waist");
	set("armor_prop/armor",4);
	}
}
