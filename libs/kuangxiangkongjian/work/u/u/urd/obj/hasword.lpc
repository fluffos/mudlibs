// ten_sword.c
#include <ansi.h>

#include <weapon.h>

inherit SWORD;
inherit F_CLEAN_UP;
void create() {
  set_name(RED "影月魔剑" NOR, ({ "sword", "sword" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000000);
    set("material", "steel");
    set("long", "人间至宝，一把绝世好剑。\n");
  }
  init_sword(60);
  setup();
}
void init() {
  add_action("rec", "recover");
}
int rec() {
  shout(RED "          一阵血光闪过    那就是影月魔的魔力\n\n" NOR);
  message_vision(
    RED "影月魔剑" + HIW + "发出阵阵魔力，$N的内力在一时马上全恢复了。\n" NOR, this_player());
  this_player()->set("atman", this_player()->query("max_atman"));
  if (random(3) < 1) {
    message_vision(RED "影月魔剑的魔力没了，变成了一把普的剑" NOR, this_player());
    message_vision("\n", this_player());
    destruct(this_object());
  }
  return 1;
}
