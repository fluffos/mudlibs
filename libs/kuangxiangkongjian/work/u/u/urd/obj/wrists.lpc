#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIG "玄铁手环" NOR,({"duku wrists","wrists"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit","件");
    set("long","这是剑魔独孤求败的手环。\n");
    set("material","blacksteel");
    set("value",10000);
    set("armor_type","wrists");
    set("armor_prop/armor",100);
    set("armor_prop/dodge",100);
       }
  setup();
}
