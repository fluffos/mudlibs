#include <ansi.h>
inherit ITEM;
void create()
{
      set_name("转换器",({"chang"}) );
      set_weight(1000);
      if( clonep() )
           set_default_object(__FILE__);
      else {
           set("unit","串");
           set("long","这是一串专门欢迎oda归来的鞭炮");
           set("value",500);
           }
 
      setup();
}
 
void init()
{
      add_action("do_fire","down");
}
 
int do_fire(string arg)
{
      object me=this_player();
      if( !arg||arg!="chang" )  return 0;
           message_vision("$N按下了转换器，一时天摇地动。\n",me);
	   this_player()->set("title","音乐小魔女");
	   this_player()->set("nickname","自言自语的猫");
           destruct(this_object());
           return 1;
}
