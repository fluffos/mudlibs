#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
     set_name(HIG "剑魔盔" NOR,({"duku helmet","helmet"}));
     set_weight(1000);
     set("armor_type","head");
     if( clonep() )
       set_default_object(__FILE__);
     else {
       set("unit","顶");
       set("long","一顶杀气腾腾的头盔。\n");
       set("material","blacksteel");
       set("value",10000);
       set("armor_prop/armor",100);
       set("armor_prop/parry",100);
          }
     setup();
}

