//lighter.c by urd
#include <mudlib.h>
#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIW+"爆雷降临"+NOR,({"lighting"}));
  set("long",
	"这是兀儿德最喜欢用的魔法．\n");
  set_weight(1);
	set("unit","个");
  seteuid(getuid());
}

void init()
{
	add_action("fire","lightring");
}

int query_auto_load()
{
return 1;
}

int fire(string str)
{
  object target,targetenv;
  int gin1, kee1, sen1;
  
if((string)this_player()->query("id")!="urd")
	return notify_fail("这不是$N所用的魔法!!\n");
  if(!str || str == "") 
    {
	write(HIW"兀儿德从天上召唤一道雷, 只听见轰的一声......\n"NOR);
      tell_room(environment(this_player()), HIC+this_player()->query("name")
                +HIW"忽然举起冲锋枪朝空中乱放，你心想大事不妙了！\n"NOR,
                ({this_object(), this_player()}));
      return 1;
    }
  target=present(str,environment(this_player()));
  if(!target) target = find_living(str);
  if(!target) {
	write(HIY"看清楚在用雷打人...OK??\n"NOR);
  return 1;}
  targetenv=environment(target);
  
  
  if(target != this_player())
	write(HIW"天边的云海, 听我呼唤!\n"
"意会我心, 我 ,3神之长兀儿德在此--\n"
"爆雷降临!!!\n");
  else
  {
  write("想自杀？用 suicide -f 比较快啦！\n");
  return 1;
  }
  
  tell_room(environment(this_player()),""+HIC
            +(string)this_player()->query("name")
            +HIW"忽然提起冲锋枪向"HIC+(string)target->query("name")
            +HIW"射击！一下子打光一匣子弹！\n"NOR, ({this_player(), target}));

  tell_room(environment(target), HIW"忽然有人用冲锋枪向"HIC
            +(string)target->query("name")+HIW"连续射击，不一会儿"HIC
            +(string)target->query("name")+HIW"已被射得有如蜂窝一般！\n"NOR,
            ({this_player(), target}));
     
	tell_object(target,
		HIW"突然从天上降下一道大雷, 打在你身上!!\n"NOR+
		"( 你"RED"受伤过重, 已经有如风中残烛, 随时都可能断气．)\n"NOR);
	return 1;
}
