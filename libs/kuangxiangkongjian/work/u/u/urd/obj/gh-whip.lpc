#include <ansi.h>
#include <weapon.h>
inherit WHIP;
void create()
{
 set_name(HIR "格林汉之鞭" NOR,({"gren-han whip","gren-han","whip"}));
 set_weight(3000);
 if( clonep() )
   set_default_object(__FILE__);
 else {
   set("unit","条");
   set("vaule","30000");
   set("material","iron");
   set("long","这是在勇者阿邦在魔界找到的鞭子。\n");
     set("wield_msg", "$N把$n从腰间解下来握在手中。\n");
     set("unwield_msg", "$N把手上的$n收了起来。\n");
      }
 init_whip(300);
 setup();
}
