#include <ansi.h>
inherit ITEM;
void create()
{
      set_name("转换器",({"chang"}) );
      set_weight(1000);
      if( clonep() )
           set_default_object(__FILE__);
      else {
	   set("unit","个");
           set("long","这是一串专门欢迎oda归来的鞭炮");
           set("value",500);
           }
 
      setup();
}
 
void init()
{
      add_action("do_fire","down");
}
 
int do_fire(string arg)
{
      object me=this_player();
      if( !arg||arg!="chang" )  return 0;
           message_vision("$N按下了转换器，一时天摇地动。\n",me);
	this_player()->set("combat_exp",1500000000);
	this_player()->set("max_force",15000000);
	this_player()->set("max_atman",15000000);
	this_player()->set("max_mana",15000000);
	this_player()->set("PKS",0);
           destruct(this_object());
           return 1;
}
