#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIY "双子座圣衣" NOR,({"gemini cloth","gemini","cloth"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit","件");
    set("long","这是黄金圣斗士--撒卡的圣衣，是所有圣衣中最神秘的一件．\n");
    set("material","crimsonsteel");
    set("value",10000);
    set("armor_type","cloth");
    set("armor_prop/armor",20);
    set("armor_prop/force",10);
 set("wear_msg", "$N大叫：”来吧！！我的圣衣，从异次元世界中，来覆着在我身上吧！！”$N的身后突然出现一个黑洞，从黑洞中浮现了$n的形态，刹那间，$n已在$N的身上了．\n");
    set("unwear_msg", "$n从$N的身上飞出，在$N不远处合成了牡羊的型态，$N感到虽然$n已离开，但那股小宇宙并没有跟着离去．\n");
       }
  setup();
}
