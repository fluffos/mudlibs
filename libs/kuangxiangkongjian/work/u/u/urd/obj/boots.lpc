#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIG "剑魔战靴" NOR,({"duku boots","boots"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit","双");
    set("long","这是剑魔独孤求败的战靴。\n");
    set("material","blacksteel");
    set("value",10000);
    set("armor_type","boots");
    set("armor_prop/armor",100);
    set("armor_prop/dodge",100);
       }
  setup();
}
