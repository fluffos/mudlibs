#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
	set_name(HIW"晚  礼  服"NOR,({"night cloth","night","cloth"}));
	set("long","这是小魔女萱萱外出参加宴会时的衣服。\n");
	set_weight(200);
	set("unit","件");
	set("value",43000);
	set("material","cloth");
        set("armor_type","cloth");
	set("armor_prop/armor",19);
	set("wear_msg","$N将一件$n穿在身上。\n");
	setup();
}
