#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
	set_name(HIR"火  焰  "HIY"罩  袍"NOR,({"fire robe","fire","robe"}));
	set_weight(200);
	set("unit","件");
	set("value",43000);
	set("material","cape");
	set("armor_type","cape");
	set("armor_prop/armor",19);
	set("wear_msg","$N将一件$n披在肩上。\n");
	setup();
}
