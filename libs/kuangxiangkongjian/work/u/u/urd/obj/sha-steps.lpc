// sha-steps.c

inherit SKILL;

string *dodge_msg = ({
"只见$n身形微动,一招‘移风换形’在风中残留了几个清晰的影像 ,幽幽的绕到$N的身后 .\n", 
"只见$n内力一吐 ,纵身而上 ,一式‘疾风扬尘’,身形卷起无数草石腾空而起 ,避了开去 .\n",
"$n使出了‘破风身法’的无量奥义‘流水’,如水一般轻柔的闪过 .\n",
"可是$n使一招‘狂风七星点’,灵巧的回避穿梭在$N的身前 .\n",
"$n身子往后一仰 ,单手发劲于地 ,以一招‘风里弧月’如飞燕一般的从$N头上飞去 .\n",
"$n使出‘破风身法’最后的奥义‘八面神风’,借八风托力点空 ,使出‘流水’躲过这足以致命的一着杀招 \n",
"但是$n脚下忽出一式极精奇的步法‘风无不定’,身形随着风势而动 ,飘飘一托 ,迅雷闪身于$N之身后 .\n"
});

int valid_skill_usage(string usage)
{
	return (usage=="dodge") || (usage=="move");
}
 int valid_enable(string usage)
 {
        return( usage=="dodge" || usage=="move") ;
 }

int valid_learn(object me)
{
	if( (int)me->query("max_force") < 10 )
		return notify_fail("你的内力不够，没有办法练破风身法 .\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 20
	||	(int)me->query("force") < 5 )
		return notify_fail("你的气或内力不够，不能练破风身法 .\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	return 1;
}
