



#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
     set_name(HIG "温凉玉" NOR,({"duku jade","jade"}));
     set_weight(1000);
     set("armor_type","nick");
     if( clonep() )
       set_default_object(__FILE__);
     else {
       set("unit","块");
       set("long","一块极为罕见的玉。一半火红，一半碧绿。\n");
       set("material","jade");
       set("value",10000);
       set("armor_prop/armor",100);
       set("armor_prop/parry",100);
          }
     setup();
}

