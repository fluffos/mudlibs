#include <ansi.h>
#include <weapon.h>

inherit BLADE;


void create()
{
        set_name(HIR "不知火" NOR,({"blade"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
       
set("long","一把著名的妖刀,有着诡异的青蓝色刀芒,刀锋会渗出血来。可以是着在刀上祭血(blood)\n");
                set("unit", "把");
                set("base_unit","把");
                set("value",10000);
                set_weight(7000);
                set("material", "iron");
        }
        init_blade(44);
        setup();
}

void init()
{
  add_action("blood", "blood");
}

int query_auto_load()
{
return 1;
}

int blood(string str)
{
  object Remark,Remarkenv;
  int sen1;
  
  if(!str || str == "") 
    {
      write(HIR"刀身泛起青蓝色光芒, 刀尖滴下点点的血珠\n"NOR);
      tell_room(environment(this_player()), HIR+this_player()->query("name")
                +BLU"拿起$n, 四周突然冒出奇怪的声音\n"NOR,
                ({this_object(), this_player()}));
      return 1;
    }
  Remark=present(str,environment(this_player()));
  if(!Remark) {
  write(HIG" 你的功力还不够还不能好好的使用不知火\n"+NOR);
  return 1;}
  Remarkenv=environment(Remark);
  
  if(Remark != this_player())
   write(RED+"你挥舞着不知火,
不知火窜出亡魂向"RED+(string)Remark->query("name")
         +"冲去，"+(string)Remark->query("name")+"被哀号的鬼魅纠缠\n"NOR);
  else
  {
  write("或许不知火对你已经产生好感,并没有任何的异状产生\n");
  return 1;
  }
  
  tell_room(environment(this_player()),""+HIY
            +(string)this_player()->query("name")
            +HIW"不知火往"CYN+(string)Remark->query("name")
            +HIW"卷去！"+(string)Remark->query("name")+"显的心神不宁\n"NOR,
({this_player(), Remark}));

  tell_room(environment(Remark), BLU"忽然骇人的幽魂向"HIR
            +(string)Remark->query("name")+BLU"飞去"HIR
            +(string)Remark->query("name")+BLU"被鬼魂团团包围\n"NOR,
            ({this_player(), Remark}));
     
  tell_object(Remark,
              HIY"鬼魂散去\n"NOR+
              "( 你"+RED"昏昏沈沈的,好像受到很大的影响。"NOR
              +" )\n");
              sen1 = Remark->query("sen") * 0.25;
              Remark->add("sen", -sen1);
              this_player()->add("force",-100);
 return 1;

}
