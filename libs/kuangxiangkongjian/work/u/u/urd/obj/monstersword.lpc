// u/c/carol/obj/monstersword.c 幻兽剑

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
     set_name(HIG"ψ  幻  兽  剑  ψ"NOR,({"monster sword","monster","sword"}));

        set_weight(5000);

        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit","把");
	set("long", "这是一把自上古时代就存在的剑，相传有召唤幻兽的力量，\n"
"不过谁也没看过这种力量，这也是晓萱专用的。\n");
                set("material","crimsonsteel");
                set("value",500000);
        } //end of else

	init_sword(1200);

       set("wield_msg",HIG"瞬时四方各地的野兽齐声大叫，所有的声音化为$n"HIG"显于$N手中。\n"NOR);
       set("unwield_msg",HIG"四地的声音渐渐平息下来，$n"HIG"也消失无踪。\n"NOR);

        setup();

} // eof create()

int wield()
{
	if ((string)this_player()->query("id") != "carol")
                return notify_fail("这把剑对你没用，请交还晓萱。\n");
        else {
                ::wield();
        } //end of else


     return 1;

} //EOF
