#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIY "牡羊座圣衣" NOR,({"aries cloth","cloth"}));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("no_drop",1);
    set("unit","件");
    set("long","这是牡羊座圣斗士--穆斯所穿的圣衣，也是代表着黄金圣斗士的象征．\n");
    set("material","crimsonsteel");
    set("value",10000);
    set("armor_type","cloth");
    set("armor_prop/armor",18);
    set("armor_prop/move",10);
    set("wear_msg", "$n突然从牡羊的型态分开，自动的戴在$N的身上，霎那间，$N感到一股温和的小宇宙充满了全身．\n");
    set("unwear_msg", "$n从$N的身上飞出，在$N不远处合成了牡羊的型态，$N感到虽然$n已离开，但那股小宇宙并没有跟着离去．\n");
       }
  setup();
}
