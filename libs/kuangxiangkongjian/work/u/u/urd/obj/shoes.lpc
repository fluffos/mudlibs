#include <ansi.h>
inherit EQUIP;

void create() {
  set_name("靴子", ({ "shoes" }));
  set_weight(100);
  set("long", "这是小魔女萱萱所专用的靴子。\n");
  set("unit", "双");
  set("no_sell", 1);
  set("armor_type", "boots");
  set("armor_prop/armor", 5);
  set("armor_prop/dodge", 10);
  set("armor_prop/move", 10);
  setup();
}
