#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create() {
  set_name(HIW "□□□□□一□□服" NOR, ({ "belldandy suit", "suit" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是掌管现在的女神－□□□□□一所穿的衣服");
    set("unit", "件");
    set("no_sell", 1);
    set("value", 43000);
    set("material", "cloth");
    set("armor_prop/armor", 100000);
  }
  setup();
}
