//belldandy.c
#include <ansi.h>

inherit NPC;

mapping *action = ({
  ([ "action": "$N两臂微张，口中念念有词，只见空气中凝结出无数的冰晶，宛如" +
    "风暴一般地向$n袭来",
    "dodge": -60,
    "parry": -60,
    "damage": 700,
    "ac": 80,
    "damage_type": "冻伤",
  ]),
  ([ "action": "$N高举右手，口中念念有词，只见天空乌云密布，突然发出一道闪"
    "电击向$n",
    "dodge": -60,
    "parry": -60,
    "damage": 800,
    "ac": 80,
    "damage_type": "电击",
  ]),
  ([ "action": "$N两手合掌，口中念念有词，只见数道旋风包围着$N，急速的向" +
    "$n扫去",
    "dodge": -60,
    "parry": -60,
    "damage": 900,
    "ac": 80,
    "damage_type": "割伤",
  ]),
});

void create() {
  set_name("□□□□□一", ({ "belldandy" }));
  set("long", "她是掌管现在的女神，是萤一\许\愿\让她一直留在萤一身边的，\n不过她也是真心爱着萤一的，所以才会留在人间界的。\n");
  set("title", "幸运女神");
  set("nickname", HIW "一级神二种非限定" NOR);
  set("age", 21);
  set("int", 50);
  set("str", 30);
  set("cor", 35);
  set("dex", 35);
  set("con", 32);
  set("kar", 50);
  set("no_kill", 1);
  set("no_fight", 1);
  set("combat_exp", 150000000);
  set("gender", "女性");
  set("attitude", "peaceful");
  set("class", "goddess");
  set_skill("dodge", 90);
  set_skill("unarmed", 70);
  set_skill("parry", 90);
  set("inquiry", ([
    "兀儿德": " 她是我姐姐啊!\n" +
    "虽然她脾气很暴躁，可是她的本性还是很善良的。!\n",
    "urd": " 她是我姐姐啊!\n" +
    "虽然她脾气很暴躁，可是她的本性还是很善良的。!\n",
    "诗寇蒂": " 她是我妹妹!\n" +
    "她对机械方面的东西很厉害的呦!\n",
    "skuld": " 她是我妹妹!\n" +
    "她对机械方面的东西很厉害的呦!\n",
  ]));
  set("chat_chance", 40);
  set("chat_msg", ({
    " □□□□□一正对你微笑着。\n",
    " □□□□□一说道: 请用茶。\n",
  }));
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    " □□□□□一大呼一声: 呀！！～～～～你要干什么～～～～～ ？？\n"
  }));
  setup();
  carry_object("/u/u/urd/GODDESS/belldandy/bellcloth.lpc")->wear();
  set("default_actions", (: call_other, __FILE__, "query_action" :));
  reset_action();
}
mapping query_action() {
  return action[random(sizeof(action))];
}
void init() {
  add_action("do_bless", "bless");
}
int do_bless() {
  object ob;
  ob = this_player();
  tell_room(environment(ob), " □□□□□一轻声的念了一道咒语:「天地间的精灵啊!!" +
    "吾乃一级神二种非限定的□□□□□一，请赐予" + ob->name() + "力量吧!!\n");
  ob->set("gin", ob->query("max_gin"));
  ob->set("kee", ob->query("max_kee"));
  ob->set("sen", ob->query("max_sen"));
  return 1;
}
