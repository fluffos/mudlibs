#include <ansi.h>
#include "/open/open.h"
void do_special();
inherit NPC;
void create()
{
	set_name("佩怡",({"lilian"}));
	set("gender","女性");
	set("class","avatar");
	set("attitude","friendly");
	set("long","她看起来没甚么特别的。\n");
	set("age",15);
	set("str",30);
        set("cor",30);
        set("cps",30);
	set("per",60);
        set("int",30);
        set("con",30);
        set("spi",30);
        set("kar",30);
	set("combat_exp",48957364);
	set("potential",40000);
	set("gin",40000);
	set("kee",40000);
	set("sen",40000);
	set("max_gin",40000);
	set("max_kee",40000);
	set("max_sen",40000);
	set("atman",1239990);
	set("force",1400980);
	set("mana",1239990);
	set("max_atman",1239990);
	set("max_force",1400980);
	set("max_mana",1239990);
	set("force_factor",100);
	set_skill("unarmed",200);
	set_skill("flower-hand",200);
	set_skill("dodge",200);
	set_skill("move",200);
	set_skill("force",200);
	set_skill("haoforce",200);
	set_skill("winter-steps",200);
	set_skill("sword",200);
	set_skill("shasword",200);
	map_skill("unarmed","flower-hand");
	map_skill("force","haoforce");
	map_skill("sword","shasword");
	set_skill("parry",200);
	map_skill("parry","shasword");
	map_skill("dodge","winter-steps");
	set("chat_chance_combat",50);
	set("chat_msg_combat",({
	(:do_special:)
	}));
	setup();
	carry_object("obj/cloth.lpc")->wear();
}
void do_special()
  {
    object *enemy,target;
    int i;

        enemy=this_object()->query_enemy();
        i=sizeof(enemy);
        target=enemy[random(i)];

                message_vision(
HIM"\n佩怡使出了绝招，开始大叫：「啊～～～～～～～～”\n"NOR,target);
		message_vision(
HIW"\n佩怡的声音让$N的力气全部都消失了！！！\n"NOR,target);
		target->receive_wound("kee",random(500+700));
                COMBAT_D->report_status(target);
}
