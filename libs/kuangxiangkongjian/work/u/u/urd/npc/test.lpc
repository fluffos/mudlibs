          set("gin",30000);
          set("max_gin",30000);
          set("kee",30000);
          set("max_kee",30000);
          set("sen",30000);
          set("max_sen",30000);
        set("force",1000000);
        set("max_force",1000000);
	set("atman",1000000);
	set("max_atman",1000000);
        set("mana",30000);
