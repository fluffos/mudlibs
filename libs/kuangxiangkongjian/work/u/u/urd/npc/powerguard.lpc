#include <ansi.h>

inherit NPC;

void create()
{
	set("title","禁军教头");
	set_name("林冲", ({"lin-chong","lin","chong"}));
	set("long","你看到的是雄状威武,堂堂七尺的大汉,他统欲着总数有十万的皇宫禁军。\n");
	set("age",35);
	set("gender","男性");
	set("attitude","friendly");
	set_skill("move",70);
	set_skill("dodge",70);
	set_skill("literate",70);
	set_skill("sword",100);
	set_skill("force",100);
	set("combat_exp",5000);
	setup();
}
