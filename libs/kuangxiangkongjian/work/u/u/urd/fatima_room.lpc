// made by urd

#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "生体工作室");
  set("long", @LONG
这里是巴兰榭博士的生体工作室，许多用水晶制成的 Fatima 堷
养床放置在四周。地上横行着大大小小的电路管线，巨大的水银聚光
灯吊在天花板上，不过都没有打开，所以这儿倒显得有点灰暗，只有
柔柔的光线自堷养床中透出，你感到这儿似乎充满了生命力量。而北
边的房间则是放置 Fatima 衣物的房间。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/u/u/urd/cloth_room",
    "east": "/u/c/carol/workroom",
  ]));
  set("objects", ([
    "/u/u/urd/npc/lilian": 1,
    "/u/u/urd/npc/smallfat": 1,
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  object ob, obj;
  ob = this_player();
  add_action("set_fatima", "order");
  if (ob->query("fatima/status") == "quit") {
    ob->set("fatima/status", 2);
    obj = new("/u/u/urd/fa.lpc");
    obj->move(environment(ob));
    obj->set_temp("master", ob);
    write("你的 Fatima 在这里了,请到北边的衣物室拿 Fatima 服。\n");
  }
}


int set_fatima(string arg) {
  object ob;
  ob = this_player();
  if (!arg) return notify_fail("你要订做啥？\n");
  else if (arg != "fatima") return notify_fail("这里不做这种东西。\n");
  else {
    if ((ob->query("fatima/status")) == 2 || (ob->query("fatima/status")) == "inuse")
      tell_object(ob, "你已经有 Fatima 了,请好好爱护她\n");
    if ((ob->query("fatima/status")) == 0) tell_object(ob, "你还不能认领 Fatima 。\n");
    if ((ob->query("fatima/status")) == "die") {
      write("巴兰榭博士说道:我可怜的女儿啊.... 真该要你为没好好照顾 Fatima 付出代价的...\n");
      write("巴兰榭博士说道:但是因为仍值测试期,我会再让你认领 Fatima 的。\n");
      write("请待会再来一趟...\n");
      ob->set("fatima/status", 1);
    }
    if ((ob->query("fatima/status")) == 1) {
      tell_object(ob, "请依照指示输入 Fatima 资料....\n");
      tell_object(ob, "按任意键开始...\n");
      get_char("start_set");
    }
  }
  return 1;
}
int start_set() {
  object ob;
  ob = this_player();
  tell_object(ob, "请输入你 Fatima 的英文名字 。\n ->");
  input_to("set_fatima_egname", ob);
}
int set_fatima_egname(string egname, object ob) {
  ob->set("fatima/egname", egname);
  tell_object(ob, "请输入你 Fatima 的中文名字 。\n ->");
  input_to("set_fatima_chname", ob);
}
int set_fatima_chname(string chname, object ob) {
  ob->set("fatima/chname", chname);
  tell_object(ob, "请输入你 Fatima 的 nickname 。\n ->");
  input_to("set_fatima_nickname", ob);
}
int set_fatima_nickname(string nickname, object ob) {
  ob->set("fatima/nickname", nickname);
  tell_object(ob, "请输入你 Fatima 的外观叙述 。\n ->");
  input_to("set_fatima_long", ob);
}
int set_fatima_long(string long, object ob) {
  ob->set("fatima/long", long);
  tell_object(ob, "你需要的 Fatima 资料如下: \n");
  tell_object(ob, "英文名字 : " + ob->query("fatima/egname") + "    (此项将永远无法更改)\n");
  tell_object(ob, "中文名字 : " + ob->query("fatima/chname") + "    (此项将永远无法更改)\n");
  tell_object(ob, "nickname : " + ob->query("fatima/nickname") + " \n");
  tell_object(ob, "外观叙述 : " + ob->query("fatima/long") + " \n");
  tell_object(ob, "一切都正确吗？ ( y/n ) \n :");
  input_to("check", ob);
}
int check(string answer, object ob) {
  sscanf(answer, "%s\n", answer);
  if (!answer) { tell_object(ob, "\n请输入 y or n \n :"); get_char("check", ob); } else if (answer == "n") {
    tell_object(ob, "\n按任意键重新开始。\n"); get_char("start_set");
  } else if (answer == "y") {
    tell_object(ob, "\nok!!.... \n");
    ob->set("fatima/status", 2);
    call_out("give_fatima", 0, ob);
  } else { tell_object(ob, "\n请输入 y or n \n :"); get_char("check", ob); }
}
int give_fatima(object ob) {
  object obj;
  obj = new("/u/u/urd/fa.lpc");
  obj->move(environment(ob));
  obj->set_temp("master", ob);
  tell_object(ob, "\n她今后就是你的专属 Fatima 了,请好好爱护她喔.... \n");
  tell_object(ob, "你可以用 fc (fatima command) 让你的 Fatima 为你服务。 \n");
  tell_object(ob, "例如 : fc smile , 你的 Fatima 就会快乐的微笑。 \n");
  tell_object(ob, "请不要任意抛弃她,如果她遭到死亡等意外,你将会因此付出代价。 \n");
  tell_object(ob, "她需要几秒钟来熟悉这个世界... 请先到北边的衣物室拿 Fatima 服,\n");
  tell_object(ob, "然后让她穿上,可别让她光溜溜的喔！\n");
}
