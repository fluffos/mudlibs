// Room://u/u/urd/bus_room

#define TIME_TICK (time()*60)
#include <localtime.h>

inherit ROOM;

mapping menu=([
// 1: 猫实  2: 猫实工大
     0 : 0 ,
     1 : 2 ,
     2 : 0 ,
     3 : 1 ,
     4 : 0 ,
     5 : 2 ,
     6 : 0 ,
     7 : 1 ,
     8 : 0 ,
     9 : 2 ,
     10: 0 ,
     11: 1 ,
     12: 0 ,
     13: 2 ,
     14: 0 ,
     15: 1 ,
     16: 0 ,
     17: 2 ,
     18: 0 ,
     19: 1 ,
     20: 0 ,
     21: 2 ,
     22: 0 ,
     23: 1 ,
     ]);
void create()
{
set("short", "公车内部");
set("long", @LONG
这里是公车的内部，非常舒适的座椅使你期望别那么快到达，
从两旁的窗户，你可以看到延途的风景。
LONG
);

        setup();
        set_heart_beat(1);
}

void heart_beat()
{
  mixed *local;

  local = localtime(TIME_TICK);

  if( menu[local[LT_HOUR]] ==1
       && local[LT_MIN] >= 0 && local[LT_MIN] <= 3 && query("airplant1")==0
    ) call_out("air_arr",0,1);
  if( menu[local[LT_HOUR]] ==2
       && local[LT_MIN] >= 0 && local[LT_MIN] <= 3 && query("airplant1")==0
    ) call_out("air_arr",0,2);

  if( menu[local[LT_HOUR]] ==1 &&
      (local[LT_MIN] - 30) >= 0 && (local[LT_MIN] - 30) <= 3
      && query("airplant1")==1 ) call_out("air_leave",0);
  if( menu[local[LT_HOUR]] ==2 &&
      (local[LT_MIN] - 30) >= 0 && (local[LT_MIN] - 30) <= 3
      && query("airplant1")==1 ) call_out("air_leave",0);
}
int air_arr(int where)
{
   mixed *local;

   local = localtime(TIME_TICK);
   set("airplant1",1);

   if(where==1) {
     write("猫实站已经到达了，车上的旅客请赶快下车。\n");
     set("exits", ([ /* sizeof() == 1 */
              "descend": "/u/u/urd/airport",
               ]));
      return 1;
   }
   if( where ==2 ) {
       write("猫实工大已经到达了，车上的旅客请赶快下车。\n");
       set("exits", ([ /* sizeof() == 1 */
                 "descend": "/u/u/urd/nekomi/station",
         ]));
       return 1;
   }
}
int air_leave()
{
   object *ppl;
   int i;
   mixed *local;

   local = localtime(TIME_TICK);

   set("airplant1",0);
   delete("exits");
   ppl = all_inventory(this_object());
   i=sizeof(ppl);
   while( i-- ) {
      if( ppl[i]->query("coin") < 250 && living(ppl[i]) ) {
         write("车掌小姐说道:这位客人,...您....您忘了带钱是吧! 请带足够的钱\n再来搭乘本班车。
\n");
         message_vision("$N害羞的从座位上站了起来,向四周看了看，快步地跑下了公车。
\n",ppl[i]);
         if( menu[local[LT_HOUR]] == 1 )
           ppl[i]->move("/u/u/urd/airport");
         if( menu[local[LT_HOUR]] == 2 )
     ppl[i]->move("/u/u/urd/nekomi/station");
        }
      else ppl[i]->add("coin",-250);
     }
	write("\n公车开动了。\n");
	write("本班次收取车钱: 两百五十文钱。\n");
   return 1;
}
