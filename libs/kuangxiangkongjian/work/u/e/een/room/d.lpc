
#include <mudlib.h>

inherit ROOM ;
// int Drinking() ;
object drinker;
int allow;
void create () {


	seteuid(getuid()) ;
//	  set_outside("room") ;
	set ("short", "ohio`s drinking bar") ;
	set ("long",@DESC
早安姐专用酒吧----
    这是一间早安姐开的酒吧,内藏有许多名贵的酒,和饮料,是
平常休闲无聊的好去处,你可以问问酒保(boy)今天有啥好喝的饮料
DESC
) ;
	set ("light" ,1) ;
set ("exits",([
	"south" : "/u/o/ohio/home/room",
	]) ) ;
allow=1;
}
void init()
{
add_action("list_drinks","boy") ;
add_action("select_drinks","select") ;
}
int list_drinks (string str) {
       if (!str) {
		  notify_fail("你要喝啥??\n") ;
		  return 0 ;
		  }
write("@@@@@@@@@@@@@ 今天的提供的有 @@@@@@@@@@@@\n"+
      "-----------------------------------------\n"+
      "(1)雪腥玛丽(bloodly)              24 金子\n"+
      "(2)蛋蜜汁  (egg)                  40 金子\n"+
      "(3)琴  　　(gin )                100 金子\n"+
      "(4)ＸＯ    (xo)                  200 金子\n"+
      " 请打(select 1,2,3 or4)。                \n"+
      "-----------------------------------------\n") ;
return 1 ;
}
int select_drinks (string snum) {

int price,recover,ran,i,resp,reg1,reg2,count ;
string drinkname ;
object carry_money;
//object drinker;

mixed drinks=({
	      ({"雪腥玛丽",24,10}),
	      ({"蛋蜜汁",40,24}),
	      ({"琴",100,65}),
	      ({"ＸＯ",200,140}),});
if (allow!=1)
{
notify_fail("对不起现在本店缺货,请待会在来。\n");
return 0;
}
       if(!snum)
		{
		notify_fail("你要选什么?\n") ;
		return 0 ;
		}
       if( snum!="1" && snum!="2" && snum!="3" && snum!="4")
	 {
			 notify_fail("您好,你要喝啥？？　\n") ;
					 return 0 ;
	 }
	sscanf(snum,"%d",i) ;
drinkname=drinks[i-1][0] ;
price=drinks[i-1][1] ;
recover=drinks[i-1][2] ;
carry_money = present("silver_money", me);
if (!carry_money) return notify_fail("你身上没有带银子。\n");
write("你露出满足的笑容,把"+drinkname+"拿起,准备细细的品尝一番..........\n") ;
	resp=0 ;
	allow=0;
       drinker=this_player();
for (i=0;i<4;i++) {
ran=random(4) ;
call_out("Drinking",2+i*2,drinkname,ran,i) ;
	resp=resp+ran+1 ;
	}				     //loop end
	resp=resp*recover/15 ;
	// add SP
	reg1=this_player()->query("max_sp") ;
	reg2=this_player()->query("spell_points") ;
	reg2=reg2+resp ;
	if (reg2>reg1) reg2=reg1 ;
	this_player()->set("spell_points",reg2) ;
	// Sub Hp
	reg2=this_player()->query("hit_points") ;
	reg2=reg2-resp/3 ;
	if (reg2<0) reg2=1 ;
	this_player()->set("hit_points",reg2) ;
	// Sub money
	reg1=this_player()->query("wealth/gold") ;
	reg1=reg1-price ;
	this_player()->set("wealth/gold",reg1) ;
	// add capacity
	this_player()->add("capacity",price) ;
return 1 ;

}
void Drinking (string drinkname,int ran,int i) {
switch (ran) {
	 case 0 : {
tell_object(drinker,"你用舌头轻拍着"+drinkname+",一股香味冲入你的鼻孔,让你全身舒畅 \n");
	      break ;
		  }
	 case 1 : {
tell_object(drinker,drinkname+"渐渐流入你的喉咙,有如一股清流自你心中流过..。\n");
	      break ;
		  }
	  }				      //switch end
if (i==3) {
tell_object(drinker,"经过一翻品尝后,你的魔力大大回复,但你似乎损失不少体力。\n") ;
tell_room(this_object(),drinker->query("chi_name")+"品尝"+drinkname+"后,似乎很满足。\n");
allow=1;
		}
return ;

}
