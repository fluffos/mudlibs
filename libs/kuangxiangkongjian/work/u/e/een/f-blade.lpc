#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
        seteuid(getuid());
        set_name(HIW"鱼龙刀"NOR,({"fish blade","blade"}));
set_weight(10000);
        if( clonep() )
            set_default_object(__FILE__);
else{
        set("unit","把");
        set("long","
使者集海洋鱼类108种的骨头炼制而成,刀成之日,使者叹刀无灵气以刀自吻而
亡,尸首回归大地.\n");
        set("value",10000);
        set("material","steel");
        set("wield_msg", "恨天忌地,鱼龙再世\n");
        set("unwield_msg", "天灭鱼龙,龙刀不再\n");
     }
 init_blade(80);
 setup();
}
