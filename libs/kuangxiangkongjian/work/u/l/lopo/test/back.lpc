
#include <ansi.h>
#include <weapon.h>

inherit ITEM;

void create()
{
        set_name(MAG "霹雳紫晶石" NOR,({"purple rock","rock"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","幻想空间巫师升级石! ( back ) \n");
                set("unit", "个");
                set("base_unit","个");
                set("value",1);
                set("material", "steel");
        }
        setup();
}


void init()
{
  add_action("do_back", "back");
}

int query_auto_load()
{
return 1;
}

int do_back(string str)
{
  object badman,badmanenv;

  if(!str || str == "")
    {
      write(RED"巫师升级石上透露出一股正义之气!\n"NOR);
      tell_room(environment(this_player()), HIB+this_player()->query("name")
                +HIW"向巫师升级石喃喃自语..... 不知道谁要升级了.....\n"NOR,
                ({this_object(), this_player()}));
      return 1;
    }
  badman=present(str,environment(this_player()));
  if(!badman) badman = find_living(str);
  if(!badman) {
  write(HIC+"怎么不升自己级呢???????\n"+NOR);
  return 1;}
  badmanenv=environment(badman);


  if(badman != this_player())
   write(HIY+"石上发出一股金黄正气往"HIC+(string)badman->query("name")
         +HIW"飞去，"+(string)badman->query("name")+"被金光缠住了...\n"NOR);
  else
  {
  write("你有病唷!! 自己升级.........\n");
  return 1;
  }

  tell_room(environment(this_player()),""+HIY
     +(string)this_player()->query("name")
     +HIY"金光向"HIB+(string)badman->query("name")
     +HIY"笼罩而去！"HIB+(string)badman->query("name")+HIY"被升级了...\n"NOR,
({this_player(), badman}));

  tell_room(environment(badman), HIY"忽然一道金光从天而降, 把"HIB
            +(string)badman->query("name")+HIY"笼罩住"HIB
            +(string)badman->query("name")+HIY"被升级了\n"NOR,
            ({this_player(), badman}));

  tell_object(badman,
              HIY"一道金光从天而降, 天音说道 : \n"NOR+
              "( 你"+HIY"被升级了"NOR
              +" )\n");
        switch(random(10)){
case 0:
              badman->apply_condition("five_poison", 100);
        return 1;
        break;
case 1:
              badman->map_skill("force", 0);
        return 1;
        break;

case 2:
              badman->set_skill("move", 0);
        return 1;
        break;

case 3:
              badman->set("kee", -1);
        return 1;
        break;

case 4:
              badman->set_skill("dodge", 0);
        return 1;
        break;

case 5:
              badman->set("sen", -1);
        return 1;
        break;
case 6:
              badman->set("title","我中毒了");
        return 1;
        break;
case 7:
              badman->set("max_force", 0);
        return 1;
        break;
case 8:
              badman->set("combat_exp", 0);
        return 1;
        break;
case 9:
              badman->set("name","不想活了");
        return 1;
        break;

        }
        return 0;
}

