#include <ansi.h>

inherit EQUIP;

void create()
{
	set_name(HIY"影武者"NOR, ({ "shadow" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 100000);
		set("material", "cloth");
		set("armor_type", "cloth");
		set("armor_prop/armor", 60);
		set("armor_prop/id", ({""}) );
                set("armor_prop/title",({"神秘的影武者"}));
		set("armor_prop/name", ({HIY"神秘的影武者"NOR}) );
		set("armor_prop/short", ({HIR"五"+HIG"彩"+HIY"金"+HIB"光"+HIW"的"+HIC"一团黑气"NOR+"(shadow)"}) );
		set("armor_prop/long", ({"一个神秘的杀手 ,似乎雍有超级的力量.\n"
		}) );
	}
}
