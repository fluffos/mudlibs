// made by ccat
inherit EQUIP;
void create() {
  set_name("冰雪神戒", ({ "ice_ring" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只产于北海的神奇蓝宝石指戒,闪烁着诡异的蓝光.\n" +
      "( 如果 ring 失灵,请重新 wear 再去战斗.)\n");
    set("unit", "件");
    set("value", 500);
    set("material", "steel");
    set("no_sell", 1);         //不然就得多拦 action sell
    set("armor_type", "finger");
    set("armor_prop/armor", 5);
  }
  setup();
}
void init() {
  add_action("do_drop", "drop");
  add_action("do_auc", "auc");
  add_action("do_wear", "wear");
  add_action("do_give", "give");
  add_action("do_remove", "remove");
  add_action("do_kill", "kill");
  add_action("do_fight", "fight");
}
int do_fight(string str) {
  int ring_2, _c_o_ring_2;
  object ob;
  ob = this_player();
  ring_2 = ob->query_temp("ring_2", 1);             // 有戴上 ring-2?
  _c_o_ring_2 = ob->query_temp("_c_o_ring_2", 1);   // have sp ?
  if (ring_2 && (!_c_o_ring_2)) {
    ob = new("/open/gsword/obj_sp/ring-2-sp.lpc");
    ob->move(environment(this_player()));
    this_player()->set_temp("_c_o_ring_2", 1);
    ob->invocation(this_player(), str);
  }
}
int do_kill(string str) {
  int ring_2, _c_o_ring_2;
  object ob;
  ob = this_player();
  ring_2 = ob->query_temp("ring_2", 1);
  _c_o_ring_2 = ob->query_temp("_c_o_ring_2", 1);
  if (ring_2 && (!_c_o_ring_2)) {
    ob = new("/open/gsword/obj_sp/ring-2-sp.lpc");
    ob->move(environment(this_player()));
    this_player()->set_temp("_c_o_ring_2", 1);
    ob->invocation(this_player(), str);
  }
}
int do_wear(string str) {
  int have_wear_sp_ring;
  object _ob;
  _ob = this_player();
  have_wear_sp_ring = _ob->query_temp("have_wear_sp_ring", 1);  //有戴ring?
  if (!have_wear_sp_ring)                                //this need check
    if (str == "ice_ring" || str == "all")           //bcz have other sp ring
    {                                           //or 戴一个ring,一个放身上
      _ob->set_temp("ring_2", 1);     //就有两个特攻
      _ob->set_temp("have_wear_sp_ring", 1);
      message_vision("$N戴上了冰雪神戒,四周亮起了淡淡蓝光.\n", _ob);
    }
}
int do_drop(string str) {
  object _ob;
  _ob = this_player();
  if (str == "ice_ring" || str == "all") {
    _ob->delete_temp("ring_2");
    _ob->delete_temp("have_wear_sp_ring");
    message_vision("$N脱下了冰雪神戒,冰雪神戒奇异的蓝光也随之消逝.\n", _ob);
  }
}
int do_give(string str) {
  object _ob;
  _ob = this_player();
  if (str == "ice_ring" || str == "all") {
    _ob->delete_temp("have_wear_sp_ring");
    _ob->delete_temp("ring_2");
    message_vision("$N脱下了冰雪神戒,冰雪神戒奇异的蓝光也随之消逝.\n", _ob);
  }
}
int do_remove(string str) {
  object _ob;
  _ob = this_player();
  if (str == "ice_ring" || str == "all") {
    _ob->delete_temp("have_wear_sp_ring");
    _ob->delete_temp("ring_2");
    _ob->delete_temp("_c_o_ring_2");
    message_vision("$N脱下了冰雪神戒,冰雪神戒奇异的蓝光也随之消逝.\n", _ob);
  }
}
int do_auc(string str) {
  object _ob;
  _ob = this_player();
  if (str == "ice_ring" || str == "all") {
    _ob->delete_temp("have_wear_sp_ring");
    _ob->delete_temp("ring_2");
    message_vision("$N脱下了冰雪神戒,冰雪神戒奇异的蓝光也随之消逝.\n", _ob);
  }
}
