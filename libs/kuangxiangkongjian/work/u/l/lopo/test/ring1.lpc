// made by ccat
inherit EQUIP;
void create()
{
        set_name("红宝石指戒",({"ruby_ring"}) );
        set_weight(2500);
        if( clonep() )
		set_default_object(__FILE__);
	else {
        set("long","一只产于南蛮的神奇红宝石指戒,闪烁着奇异的红色光芒.\n"+
"( 如果 ring 失灵,请重新 remove,wear 再去战斗.)\n");
        set("unit","件");
        set("value", 5000);
        set("material","steel");
        set("no_sell", 1);         //不然就得多拦 action sell
        set("armor_type","finger");
        set("armor_prop/force", 3);
	set("armor_prop/armor", 7);
	}
        setup();
}
void init()
{
     add_action("do_drop","drop"); 
     add_action("do_auc","auc"); 
     add_action("do_wear","wear");
     add_action("do_give","give");
     add_action("do_remove","remove");
     add_action("do_kill","kill");
     add_action("do_fight","fight");
}
int do_fight(string str)
{
    int ring,_call_out;
    object ob;
    ob = this_player();
    ring = ob->query_temp("ring",1);    // 有戴上 ring-1?
    _call_out = ob->query_temp("_call_out",1);  //sp 出来了?
    if( ring && (!_call_out) )
    {
    ob = new("/open/gsword/obj_sp/ring-1-sp.lpc");
    ob->move(environment(this_player()));
    this_player()->set_temp("_call_out",1);
    ob->invocation(this_player());
    }
}
int do_kill(string kill)
{
    int ring,_call_out;
    object ob;
    ob = this_player();
    ring = ob->query_temp("ring",1);
    _call_out = ob->query_temp("_call_out",1);
    if( ring && (!_call_out))
    {
    ob = new("/open/gsword/obj_sp/ring-1-sp.lpc");
    ob->move(environment(this_player()));
    this_player()->set_temp("_call_out",1);
    ob->invocation(this_player());
     }
}                       
int do_wear(string str)
{
    int have_wear_sp_ring;
    object _ob;
    _ob = this_player();
    have_wear_sp_ring = _ob->query_temp("have_wear_sp_ring",1); //有戴ring? 
    if(!have_wear_sp_ring)                                //this need check 
      if(str=="ruby_ring" || str=="all")          //bcz have other sp ring
      {                                           //or 戴一个ring 一个放身上
         _ob->set_temp("ring",1);                //就有两个特攻
         _ob->set_temp("have_wear_sp_ring",1);
         message_vision("$N戴上了红宝石指戒,四周亮起了淡淡红光.\n",_ob);
       }     
}
int do_drop(string str)
{
    object _ob;
    _ob = this_player(); 
    if(str == "ruby_ring" || str=="all")
    {
       _ob->delete_temp("ring");
       _ob->delete_temp("have_wear_sp_ring");
       message_vision("$N脱下了红宝石指戒,红宝石奇异的红光也随之消逝.\n",_ob);
    }
}    
int do_give(string str)
{
    object _ob;
    _ob = this_player();
    if(str == "ruby_ring" || str=="all")
    {
       _ob->delete_temp("ring");
       _ob->delete_temp("have_wear_sp_ring");
       message_vision("$N脱下了红宝石指戒,红宝石奇异的红光也随之消逝.\n",_ob);
     }
}
int do_remove(string str)
{
    object _ob;
    _ob = this_player();
    if(str == "ruby_ring" || str=="all")
    {
       _ob->delete_temp("have_wear_sp_ring");
       _ob->delete_temp("ring");
       _ob->delete_temp("_call_out");
       message_vision("$N脱下了红宝石指戒,红宝石奇异的红光也随之消逝.\n",_ob);
     }
}                       
int do_auc(string str)
{
    object _ob;
    _ob = this_player();
    if(str == "ruby_ring" || str=="all")
    {
       _ob->delete_temp("have_wear_sp_ring");
       _ob->delete_temp("ring");
       message_vision("$N脱下了红宝石指戒,红宝石奇异的红光也随之消逝.\n",_ob);
    }
}                                                         
