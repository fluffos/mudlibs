// seven-steps.c

inherit SKILL;

string *dodge_msg = ({

"$n身形轻轻一飘, 如彩蝶一般越过了$N, 正是闻名‘ 七灵驭风诀 ’的‘ [1;35m凤蝶舞[0m ’。",
"$n吼地一声, 纵身一跃, 一招‘ [1;33m虎跃冲[0m ’,往$N扑了过去, $N心神一分,竟易攻为守, 失
去了先机。",
"$n身行一晃, 一个闪身, 如蛇行般轻灵, 一式‘ 七灵驭风诀 ’之‘ [1;32m蛇行诀[0m’,滑过$N的
左手边, 躲过了$N的攻击。",
"$n忽地抽起一脚, 双手微一上扬, 一招‘ [1;37m鹤冲天[0m ’, 越过$N的头顶, 躲开了$N的狙击。",
"$n身形一跃, 整个身体竟笔直地冲上青天, 忽地只见$n双手一张, 如一大鹏般地滑过$N
, 正是‘ 七灵驭风诀 ’--‘ [1;34m鹰凌霄[0m ’。",
"倏地$n全身如火焚身般微红, 身影快速的在$N的四周回绕, $N眼睛一花竟似看见一头火兽
在其身旁, 不断回旋, 突然$n大叫一声‘ [1;31m麟巡火[0m ’。",
"轻啸一声, 只是$n身已在半天之中, $N忍不住囋了一声道 : 这不是失传已久的轻功绝学
‘ [1;36m龙吟行[0m ’是啥?!",

                   });

int valid_enable(string usage)
{
        return (usage=="dodge")||(usage=="move");
}

int valid_learn(object me)
{
          return 1;
}

string query_dodge_msg(string limb)
{
  int dodge_pow;
  object me;
  me=this_player();
        dodge_pow = (int)( me->query_skill("seven-steps", 1)/10);
          if ( dodge_pow <= 5)
    return dodge_msg[random(sizeof(7))];
          else
                return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if((int)me->query("kee")<5)
                return notify_fail("你的气不够，不能练七灵驭风步。\n");
        me->receive_wound("kee",30);
        return 1;
}
