// magic.c
#include <ansi.h>
inherit SKILL;
inherit SSERVER;
#include <combat.h>
mapping *action = ({
  ([ "action": "一阵暴强雄浑的金气霎时如狂龙般的缠绕着$N的剑,
使出无量魔剑极霸道的一式‘魔气破空’,内劲下沉, 飞身于空, 宛如一支金箭般直射向$n",
    "dodge": -10,
    "damage": 250,
    "damage_type": "破体之伤"
  ]),
  ([ "action": "$N使出一式‘魔气无常’ ,剑以气行 ,$w如鬼魅一
般游移于$n的四面八方 ,霎时$N手一比,剑一划 ,$n四周气劲立时化为千万柄$w绵密不绝
的疾刺$n的$l,",
    "dodge": -50,
    "damage": 80,
    "parry": -50,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N使出无量魔剑最邪气的一式 ,‘暴魂魔体’,剑勾
地魂 ,扯出一片黑雾聚于剑身 ,$N剑提倒八 ,破空斜劈 ,一抹半月状的阴气冲向$n ",
    "dodge": -20,
    "damage": 180,
    "damage_type": "斩伤"
  ]),
  ([ "action": "$N一招‘火麟杀神’,$N手中$w疾刺十八 ,一剑快过一
剑 ,只见十八点炙红剑气射向$n的奇门大穴!",
    "dodge": -20,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N内力贯入$w的剑身 ,剑身渐渐变得金光耀目 ,$N
气提十二成 ,劲注全身 ,蓄势准备使出最强最霸道的一式‘风魔狂转业’,霎时摩诃魔气
急速旋绕$N ,无俦邪劲惊动天地正气 ,互抗暴出无数道紫电雷光 ,$N忽然现身于$n前 ,
对$n使出了HIY石破天惊NOR的一击 ! ",
    "dodge": 50,
    "damage": 300,
    "damage_type": "断体之伤"
  ]),
  ([ "action": "$N手中$w使出如猛虎的一式‘虎炮狂魔’夹杂着无
比雄厚的灭世魔力笔直的向$n刺出一剑",
    "dodge": -3,
    "damage": 180,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N仰天狂号 ,内力疾吐 ,震开了$n ,$N霎时飞身而
上 ,使出一招‘斗魔无生魂’,如血魔临世一般 ,持剑擎天 ,如雷闪电地劈向$n",
    "dodge": 15,
    "damage": 210,
    "damage_type": "砍伤"
  ]),
  ([ "action": "$N手起青眼架式 ,一式‘灭世魔剑’,手起剑落的往
$n的$l一阵失心乱斩 ",
    "dodge": -30,
    "damage": 100,
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  object ob;
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("没有剑怎么练剑 ?\n");
  return 1;
}
int valid_skill_usage(string usage) {
  return (usage == "sword" || usage == "parry");
}
int valid_enable(string usage) {
  return (usage == "sword" || usage == "parry");
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 10
    || (int)me->query("force") < 3 || (int)me->query("bellcosity") < 100)
    return notify_fail("你的杀气还不够逼人 ,体力内力无法驾御此剑法。\n");
  me->receive_damage("kee", 5);
  me->add("force", -3);
  me->add("bellcosity", 10);
  write("你忘神的练了一遍魔剑后 ,越觉得心神难控! \n");
  return 1;
}
