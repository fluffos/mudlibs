//lopo-mac-room.c
#include <room.h>
#include <ansi.h>
inherit ROOM;
int number = 1;
object ob;
void create() {
  set("short", HIM "风灵音乐网" NOR);
  set("long", @LONG

                风   灵   音   乐   电   台  DJ  室

          ∩∩      ∩∩      ∩∩       ∩∩        ∩∩
          ⊙⊙      ◎◎      ☆★       ●★         ∞
         ╰┬╯    ╰┬╯    ╰┬╯     ╰┬╯      ╰┬╯
           ▲～      ▲～      △～       △～       ◢◣～

                                         人客入来坐哦～～～

俏皮可爱的麦克风(mac)  ╭┬┬╮
                       ││││
                       ├┴┴┤
                       │  ㊣│
                       ╰──╯

LONG);

  set("item_desc", ([ /* sizeof() == 1 */
    "mac": "这是一只可爱的麦克风，上面贴有风灵的贴纸，你可以用它来跟全FS的玩家
说说话，打打屁，唱唱歌，喊些心战喊话等等...
用法: mac 后面加上你要说的话 ... ",
  ]));

  set("exits", ([ /* sizeof() == 1 */

    "out": "/u/l/lopo/workroom",

  ]));

  set("light_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);

  setup();
}

//ITEM_MACFON

void init() {
  add_action("mac", "mac");
}

int mac(string str) {

  if (this_player()->query("id") != "lopo")

  {
    notify_fail(HIY "俏皮可爱麦克风说 : 嗯! 你有口臭! 请不要对着我说话! ok? \n" NOR);
    return 0;
  }

  else

  {
    int i, flag = 0;
    if (!str) {
      notify_fail("俏皮可爱麦克风说 : 不说话怎么会有声音传到这个世界呢? \n");
      flag = 0;
      return 0;
    }

    for (i = 0; i < number; i++) {
      //if(ob=find_player(name[i]))
      if (ob != this_player()) {
        message("system", "\n
  [1m[33m[风灵音乐网]" + this_player()->name() + "感性的说:" + str + "[0m\n", users());
        flag++;
      }

      if (flag != 0) {
        write("你对着麦克风用力的吼着：" + str + "\n");
      } else {
        write("不会吧!线上没有其他的玩家耶!。\n");
      }

      say(this_player()->query("name") + "(" + this_player()->query("id") + ")" + " 对着麦克
风摆了一个很帅的POSE，然后咕叽咕叽地说了些带着磁性旳话语...\n");

      flag = 0;
      return 1;
    }
  }
}
