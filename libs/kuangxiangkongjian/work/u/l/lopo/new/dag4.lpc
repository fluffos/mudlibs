// fish-dagger.c
#include <ansi.h>
#include <weapon.h>

inherit DAGGER;

void create() {
  set_name(HIW "冰晶鲤骨匕" NOR, ({ "fish dagger", "dagger" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 200);
    set("long", "冰晶鲤骨匕乃是取冰晶雪鲤骨琢磨粹炼而成! \n");
    //               set("rigidity", 30);
    set("material", "ironsteel");
    set("wield_msg", "$N伸手往寒雪冰曩一掏, 拿出一把$n握在手中! \n");
    set("unwield_msg", "$N将手中的$n放入寒雪冰曩!\n");
  }
  init_dagger(10);
  setup();
}
