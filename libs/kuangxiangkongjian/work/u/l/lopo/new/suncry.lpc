void create()
{
        set_name(HIC "幻日晶匕" NOR,({"sun-cry dagger","dagger"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("unit","把");
//                 set("rigidity", 1000);
                 set("no_drop", 1);
                 set("no_sell", 1);
                 set("no_give", 1);
                 set("light_up", 1);
                 set("attitude", "heroism");
        set("long","上古神兵利器之一. 只见匕首刻有极细致的纹路似乎是一套武功!");
        set("material","crimsonsteel");
        set("wield_msg",HIW"$N抽出了把古匕, 四周起了一片寒光."NOR);
        set("unwield_msg",HIB"$N把这把古匕收了去!"NOR);
}
        init_dagger(60);
        set("actions", (: __FILE__, "query_action" :) );
        setup();
}

varargs mapping query_action()
{
        return action[random(sizeof(action))];
}

void block(object me, object victim, object  weapon, int damage)
{
        if(damage > 150)
        {
        victim->start_busy( random((int)me->query_skill("dagger", 1) / 20+2) );
       message_vision(HIY"幻日晶匕带动$N的手, 使出了失传的天地参合匕诀, 匕首射出七道彩光, 亮光绕射狂卷, 把$n给紧紧的束缚住了! "NOR, me, victim);
        }
}

void bleed(object me, object victim, object  weapon, int damage)
{
        int cond;

     if(damage > 150)
        {
        cond = victim->query_condition("bleeding");
        cond += random(me->query_skill("dagger", 1)/10);
        victim->apply_condition("bleeding", cond);
        message_vision(HIW"幻日晶匕带动$N的手使出了失传的武林绝学天地参合匕诀,忽地七道彩光混合成了一道白色正气射向$n, 把$n的$l射穿了一个窟隆!"NOR, me, victim);
        }
}
