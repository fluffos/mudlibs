// rad-dagger.c
#include <ansi.h>
#include <weapon.h>

inherit DAGGER;

void create()
     {
        set_name(HIR "凤髓红晶匕" NOR,({"rad dagger","dagger"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
               set("unit", "把");
               set("value", 10000);
               set("long", "凤髓红晶匕乃取天山红水晶琢磨粹炼, 透露着一股暖暖热气! \n");
//               set("rigidity", 60);
               set("material", "crimsonsteel");
      set("wield_msg", "$N伸手往寒雪冰曩一掏, 拿出一把$n握在手中! 忽地四周起了一片暖意!\n");
      set("unwield_msg", "$N将手中的$n放入寒雪冰曩, 只感觉热气渐退.\n");
        }
        init_dagger(50);
        setup();
    }
