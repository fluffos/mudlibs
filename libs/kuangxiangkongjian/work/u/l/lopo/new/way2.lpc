#include <room.h>
inherit ROOM;
void create() {
  set("short", "古密道");
  set("long", @LONG
    火光熊熊的燃放着, 四周是一片的空壁, 斜着三两根燃烧
的火把, 由泥土及地道的建筑结构看来, 这修密道似乎已有相
当久远的年代, 走着走着, 你不禁怀疑华灵所指示的路是否正
确, 真是令人想不透, 为何求师之路总是那么的远??
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "way1",
    "east": __DIR__ "way3",
  ]));
  set("light_up", 1);

  setup();
}
