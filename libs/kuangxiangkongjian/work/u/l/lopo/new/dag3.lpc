// rad-dagger.c
#include <ansi.h>
#include <weapon.h>

inherit DAGGER;

void create() {
  set_name(HIY "紫金寒铁匕" NOR, ({ "iron dagger", "dagger" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 2000);
    set("long", "紫金寒铁匕乃取上等钨矿混入金沙琢磨粹炼! \n");
    //               set("rigidity", 40);
    set("material", "ironsteel");
    set("wield_msg", "$N伸手往寒雪冰曩一掏, 拿出一把$n握在手中! \n");
    set("unwield_msg", "$N将手中的$n放入寒雪冰曩!\n");
  }
  init_dagger(30);
  setup();
}
