{
  set ("short", "古密道");
  set ("long", @LONG
    火光熊熊的燃放着, 四周是一片的空壁, 斜着三两根燃烧
的火把, 由泥土及地道的建筑结构看来, 这修密道似乎已有相
当久远的年代!
LONG);

  set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"way1",
  "west" : __DIR__"way9",
]));
