// ice-dagger.c
#include <ansi.h>
#include <weapon.h>

inherit DAGGER;

void create() {
  set_name(HIC "龙纹冰玉匕" NOR, ({ "ice dagger", "dagger" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 10000);
    set("long", "龙纹冰玉匕乃取上古寒玉琢磨, 且吸收日月精华七年粹炼, 透露着一股冰冷寒气! \n");
    //               set("rigidity", 80);
    set("material", "crimsonsteel");
    set("wield_msg", "$N伸手往寒雪冰曩一掏, 拿出一把$n握在手中! 忽地四周起了一片寒霜!\n");
    set("unwield_msg", "$N将手中的$n放入寒雪冰曩, 只见霜气渐退.\n");
  }
  init_dagger(80);
  setup();
}
