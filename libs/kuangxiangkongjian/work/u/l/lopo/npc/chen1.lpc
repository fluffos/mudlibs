//master yun chen

#include <ansi.h>

inherit NPC;

string do_giveneedle();
string dogivepro();

void create()

//菩提医经是工具, 内容是记载用药, 炼药, 针灸, 手术, 治病, 经穴穴诀.
//写一个help 档来说明.

{
  set_name("云青", ({ "master chen", "chen", "master" }));
  set("long", "
他就是当今武林最出名的药王--云青．脾气古怪, 医术一流,求
医之人常被拒绝于外. 自言有二不医 :‘ 非绝症不医. 非死活
人不医.’... 有二必医 : ‘ 门人必医, 死人必医 ’.. 自夸
道 : ‘ 上医巫师, 菩萨...下治玩家, 厉鬼...死人得以复活,
活人必死! ’ \n");

  set("gender", "男性");
  set("class", "doctor");
  set("nickname", HIC "先天三圣手" NOR);
  set("combat_exp", 1000000);
  set("attitude", "heroism");
  set("age", 63);

  set("str", 25);
  set("cor", 28);
  set("cps", 30);
  set("per", 26);
  set("int", 42);
  set("spi", 29);
  set("kar", 45);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 10);

  //根据 skill_rule 的规定, 各项技能均以超过公会老大的skill + 20

  set_skill("move", 40);
  set_skill("literate", 80);
  set_skill("cure", 100);
  set_skill("dagger", 80);
  set_skill("poison", 60);
  set_skill("force", 100);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("unarmed", 60);

  set_skill("shinnoforce", 100);
  set_skill("yu-steps", 100);
  set_skill("yu-needle", 100);
  map_skill("force", "shinnoforce");
  map_skill("cure", "shinnoforce");
  map_skill("dodge", "yu-steps");
  map_skill("move", "yu-steps");
  map_skill("parry", "yu-needle");
  map_skill("stabber", "yu-needle");
  map_skill("unarmed", "yu-needle");



  set("apply/dodge", 10);
  set("apply/attack", 10);

  set("inquiry", ([
    "先天三圣手": "哈! 哈! 不是老夫臭屁! 全天下当只有华陀与扁鹊可与吾为对手. 可惜前人不在, 因此唯我独尊啦!",
    "雪鲤银针": (: do_giveneedle :),
    "九阴仙子": "呵～手下败将, 卖讲也罢!",

    "素问": "素问和黄帝内经是为医书圣典! ",
    "黄帝内经": "素问和黄帝内经是为医书圣典! ",
    "菩提医经": (: dogivepro :),
  ]));

  //战斗中的perform or functions
  //        set("chat_chance_combat",50);
  //        set("chat_msg_combat",({
  //                      }));

  setup();

  //        create_family("神医门",15,"门主");
  //        carry_object("/daemon/class/doctor/obj/i_needle")->wield();
  //        carry_object("/daemon/class/doctor/obj/i_boots")->wear();
  //        carry_object("/daemon/class/doctor/obj/i_cloth")->wear();
  //        carry_object("/daemon/class/doctor/obj/i_hat")->wear();
  //        carry_object("/daemon/class/doctor/obj/i_belt")->wear();


  carry_object("/u/l/lopo/obj/nee1")->wield();
  carry_object("/u/l/lopo/obj/leg1")->wear();
  carry_object("/u/l/lopo/obj/i_hat")->wear();
  carry_object("/u/l/lopo/obj/i_belt")->wear();
  carry_object("/u/l/lopo/obj/i_cloth")->wear();
  carry_object("/u/l/lopo/obj/i_boots")->wear();
  carry_object("/u/l/lopo/obj/hands1")->wear();
  carry_object("/u/l/lopo/obj/neck1")->wear();
  //        carry_object("/u/l/lopo/obj/wrist1")->wear();
  add_money("gold", 5);

}

void attempt_apprentice(object ob) {
  if (this_player()->query("class") != "doctor") {
    command("say 你不是草药郎中 ,老夫岂能收你为徒 ?");
    return;
  } else {
    command("smile");
    command("recruit " + ob->query("id"));
    message_vision("林云青从如意针袋里取出一支银色灸针 ,放在$N手中 .", ob);
    new("/u/l/lopo/obj/nee4")->move(ob);
    command("say 为师的没什么东西可以给你, 这支‘ 雪鲤银针 ’你就收下吧!");
    command("smile " + ob->query("id"));
    command("say OK! 用你的呆头认真地跟我学习‘素问’,‘灵枢’和‘黄帝内经’!");
    return;
  }
}

string do_giveneedle(object ob) {
  if (ob->query("family/family_name") == "银针门") {
    command("kick" + ob->query("id"));
    command("say 哇哩咧! 你怎么把雪鲤银针给弄丢了呢! ");
    command("say 再给你一支, 别再弄丢哦! 否则小心你的脑袋瓜! ");
    new("/u/l/lopo/obj/nee4")->move(ob);
    message_vision("林云青从如意针袋中取出一支雪鲤银针, 交到$N手中", ob);
    return "哪! 拿去吧! 雪鲤银针乃为师费心所制, 别在搞丢了! 小王八蛋! ";
  }

  else {
    return "say 混蛋! 你算那根葱! 竟然敢向我要独门密宝! 还不快滚! ";
  }
}

string dogivepro(object ob) {

  if (ob->query("family/family_name") == "神医门") {
    new("/open/doctor/obj/pronee")->move(ob);
    command("kick");
    command("say 哇哩咧! 你怎么把菩提医经给弄丢了呢! ");
    command("say 再给你一本, 别再弄丢哦! 否则小心你的脑袋瓜! ");
    message_vision("林云青从书柜中取出一本菩提医经, 交到$N手中", ob);
    return "say 哪! 拿去吧! 幸好你老头子我有备份, 别在搞丢了! 小王八蛋! ";
  } else {
    command("slap " + ob->query("id"));
    return "混蛋! 你算那根葱! 竟然敢向我要独门密宝! 还不快滚! ";
  }
}
