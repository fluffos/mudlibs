inherit NPC;
void create()
{
set_name("女王蜂", ({" queen bee","bee"}));
        set("race", "野兽");
        set("age", 5);
set("long","这是一只女王蜂\n");
set("str",44);
// 下面这行是写它的最大的 精 gin ...气 kee 神...sen
set("max_gin",200);
set("max_sen",120);
set("max_kee",500);
set("max_force",500);
//这二行是写它的最内力以及 enforce 多少...
set("force",500);
set("force_factor",5);
set("score",3000);

set("cor",30);
   
set("limbs",({"头部","身躯","鬲r针","翅膀"}) );
        set("verbs", ({ "claw", "poke" }) );
        set("chat_chance", 8);
        set("chat_msg", ({
"虎头蜂在你的头上盘旋..\n"}) );
set("armor_prop/dodge",40);
set("armor_prop/unarmed",40);
               
//apply/attack 是加攻击力  apply/armor 是加防玉力...这表示不穿eq 也会提升
set_temp("apply/attack",25);
       set("attitude","aggressive");
        set_skill("parry",40);
        set("combat_exp",3000);
set_temp("apply/armor",30);
        setup();
}
