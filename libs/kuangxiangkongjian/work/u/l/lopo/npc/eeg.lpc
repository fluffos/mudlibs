//eeg.c
#include <ansi.h>
inherit NPC;

void create()
{
          set_name("蛋蛋",({ "eeg"}) );
          set("long","他是风灵的BBS网友！是他带风灵玩MUD的....
风灵的成绩一落千丈也是因为MUD的缘故!\n");
          set("nickname",HIC"书呆子"NOR);
          set("title","风灵的网友");

          set("age",22);
          set("int",30);
          set("cps",28);
          set("str",28);
          set("cor",25);
          set("spi",30);
          set("con",26);
          set("kar",29);
          set("per",30);

          set("force",1000);
          set("combat_exp",300000);
          set("max_force",1000);
          set("race","人类");
          set("gender","男性");
          set("limbs",({"蛋头","蛋手","蛋脚","蛋背","蛋腹","蛋腰"}) );
          set("attitude","peaceful");

          set_skill("dodge",80);
          set_skill("whip",80);
          set_skill("parry",50);
          set_skill("move",60);
          set_skill("force",80);
          set_skill("nine-steps",100);
          set_skill("ming-snake",90);
          set_skill("poisonforce",80);

          map_skill("dodge","nine-steps");
          map_skill("move","nine-steps");
          map_skill("parry","ming-snake");
          map_skill("force","poisonforce");
          map_skill("whip","ming-snake");

          set("inquiry",([
 "风灵" : "你问这个做什么? 他现在很忙哦! 如果你要找他, 可以mail给他!\n",
 "晓晓" : "她是风灵的初恋情人! 他们好像没有结果! 风灵对追女孩子不内行!\n",
 "书呆子" : "一天不读书, 我就会觉得很难过! \n",
                        ]) );
    setup();
              carry_object("/u/l/lopo/obj/i_whip.lpc")->wield();
              carry_object("/u/l/lopo/obj/i_cloth.lpc")->wear();
              carry_object("/u/l/lopo/obj/i_belt.lpc")->wear();
              carry_object("/u/l/lopo/obj/i_hat.lpc")->wear();
              carry_object("/u/l/lopo/obj/i_boots.lpc")->wear();

}


