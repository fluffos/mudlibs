//secret.c
#include <ansi.h>
inherit NPC;

void create()
{
          set_name("晓晓",({"secret"}) );
          set("long","她是风灵的大学时代初恋情人！");
          set("nickname",HIW"短发黑美人"NOR);
          set("title","风灵的初恋情人");

          set("age", 20 );
          set("int", 30 );
          set("cps", 28 );
          set("str", 28 );
          set("cor", 25 );
          set("spi", 30 );
          set("con", 26 );
          set("kar", 29 );
          set("per", 30 );

          set("force", 2000 );
          set("score", 20000 );
          set("force_factor",10 );
          set("combat_exp", 1000000 );
          set("max_force", 2000 );
          set("race","人类");
          set("gender","女性");
          set("limbs",({"柔颈","玉手","玉足","小腹","纤腰"}) );
          set("attitude","frinedly");

          set_skill("dodge",80);
          set_skill("literate",80);
          set_skill("parry",80);
          set_skill("stabber",80);
          set_skill("move",60);
          set_skill("unarmed",80);
          set_skill("force",100);
          set_skill("haoforce",100);
          set_skill("yu-needle",100);
          set_skill("nine-steps",100);

          map_skill("dodge","linpo-steps");
          map_skill("move","linpo-steps");
          map_skill("force","haoforce");

          set("chat_chance_combat",50);
          set("chat_msg_combat",({
//        (: perform_action,"force.gold-dest" :)
                                }) );

          map_skill("parry","yu-needle");
          map_skill("stabber","yu-needle");
          map_skill("unarmed","yu-needle");

          set("chat_chance",50);
          set("chat_msg",({
"晓晓道 : 只是一颗星罢了! 在无边的黑暗里  已写尽了宇宙的寂寞。",
"晓晓道 : 啊!星子们都美丽, 而梦中也响着的, 袛有一个名字, 那名字, 自在的如流水!",
"晓晓道 : 夜深风竹敲秋韵, 万叶千声都是恨. 人生自是有情痴, 此事不关风与月.",
"晓晓道 : 如果沉默是你的悲抑, 你知道这悲抑...最伤我心....",
"晓晓道 : 风灵最喜欢听游鸿明的[ 愈恋愈深 ], 有空唱给他听吧!",
                 }) );


          set("inquiry",([

"风灵" : "你问这个做什么? 他现在很忙哦! 如果你要找他, 可以 mail 给他!",
"mail" : "lopo 的e-mail box : y824364@fcusqnt.fcu.edu.tw.......",
"name" : "小女子名叫晓晓, 请多多指教! ",
"here" : "这里是风灵的涂鸭坊啦!  ",
"黑美人" : "那是风灵为我取的昵名!  ",
"昵名" : "讨厌！ 别问这档事！ 长的不太白， 又不是我的错！",
"蛋蛋" : "他是风灵的好朋友! 不是二十八天来一次的那种哦!",

                        ]) );

    setup();
             carry_object("/u/l/lopo/obj/nee1.lpc")->wield();
             carry_object("/u/l/lopo/obj/nee2.lpc")->wield();
             carry_object("/u/l/lopo/obj/i_cloth.lpc")->wear();
             carry_object("/u/l/lopo/obj/i_arm.lpc")->wear();
             carry_object("/u/l/lopo/obj/i_belt.lpc")->wear();
             carry_object("/u/l/lopo/obj/i_hat.lpc")->wear();
             carry_object("/u/l/lopo/obj/i_boots.lpc")->wear();
             carry_object("/u/l/lopo/obj/pant1.lpc")->wear();
             carry_object("/u/l/lopo/obj/neck1.lpc")->wear();
             carry_object("/u/l/lopo/obj/hands1.lpc")->wear();
             carry_object("/u/l/lopo/obj/leg1.lpc")->wear();
}


