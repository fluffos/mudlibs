//promiss-book.c
//made by lopo

#include<stdio.h>
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIM "菩提医经" NOR, ({ "pro book", "book" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
菩提医经乃一本无上医经. 先天三圣手云青的大作! 神医门的信物!
经的内容没有学过医术(cure)的人是看不懂的! 看的见的只是一些蝇头
小字, 十来个无衣着之满身红点的铜人, 只见红红的点似乎点出人体的
三百六十五穴! 十四条经脉走向. ( study, or read book )
LONG);
    set("unit", "本");
    set("no_drop", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("material", "leather");

    set("skill", ([
      "name": "cure",
      "sen_cost": 10,
      "exp_required": 500,
      "difficulty": 15,
      "max_skill": 40,
    ]));
  }
  setup();
}

//login 就会带在身上

int query_autoload() {
  return 1;
}


//以下是  read book, study book

void init() {
  add_action("do_read", "read");
  add_action("do_study", "study");
}


//研读make medicine, 材料, 方法, 功用

int do_read(string str) {
  object ob = this_player();
  if (ob->query("family/family_name") != "神医门")
    return notify_fail("茫舒舒, 看拢无? 写些什么东东呢? \n") else {

      char num;
      do {
        clrscr();
        gotoxy(10, 5); printf("1) 九转金丹......\n");
        gotoxy(10, 6); printf("2) 白云熊胆丸....\n");
        gotoxy(10, 7); printf("3) 云青回魂丹....\n");
        gotoxy(10, 8); printf("4) 仙鹤灵芝丸....\n");
        gotoxy(10, 9); printf("5) 百花玉露丸....\n");
        gotoxy(10, 10); printf("6) 三步回春丹....\n");
        gotoxy(10, 11); printf("7) 清心健脑丸....\n");
        gotoxy(10, 12); printf("8) 固本培元丹....\n");
        gotoxy(10, 13); printf("9) 狗皮药膏......\n");
        gotoxy(10, 14); printf("0) 妙用灵丹......\n");
        gotoxy(10, 15); printf("q) 查询经典结束..\n");
        gotoxy(10, 16); printf("Enter the number from 0 to 9 or q :");

        switch (num = getch()) {

          case '1':
            gotoxy(10, 18); printf("九转金丹  \n");
            gotoxy(10, 19); printf("功效      : 回复精气神, 以及内力全满\n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case '2':
            gotoxy(10, 18); printf("白云熊胆丸 \n");
            gotoxy(10, 19); printf("功效      : 回复精, 以及内力全满    \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case '3':
            gotoxy(10, 18); printf("云青回魂丹 \n");
            gotoxy(10, 19); printf("功效      : 解苗蛊五毒神掌的特效药! \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case '4':
            gotoxy(10, 18); printf("仙鹤灵芝丸 \n");
            gotoxy(10, 19); printf("功效      : 解苗蛊深宫奇毒          \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case '5':
            gotoxy(10, 18); printf("百花玉露丸 \n");
            gotoxy(10, 19); printf("功效      : 解火玫瑰毒              \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case '6':
            gotoxy(10, 18); printf("三步回春丹 \n");
            gotoxy(10, 19); printf("功效      : 解恶人谷春药            \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;


          case '7':
            gotoxy(10, 18); printf("清心健脑丸 \n");
            gotoxy(10, 19); printf("功效      : 回复精, 神              \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case '8':
            gotoxy(10, 18); printf("固本培元丹 \n");
            gotoxy(10, 19); printf("功效      : 回复神, 以及内力全满    \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case '9':
            gotoxy(10, 18); printf("狗皮药膏 \n");
            gotoxy(10, 19); printf("功效      : 疗外伤圣药( 回复气 )    \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case '0':
            gotoxy(10, 18); printf("妙用灵丹 \n");
            gotoxy(10, 19); printf("功效      : 治内伤圣品( 受伤用药 )  \n");
            gotoxy(10, 20); printf("所需材料 : ........................\n");
            gotoxy(10, 21); printf("...................................\n");
            break;

          case 'q':
            gotoxy(10, 18); printf("[1;36m医经对着你啰唆道 :‘ 有空多炼丹, 时常保平安! ’[0m\n");
            break;

          default:
            gotoxy(10, 18); printf("[1;33m医经骂道 : 呆哦! 你只能按 0 到 9 哦! 按错没药吃![0m\n");
            break;
        }
        getch();
      } while (num != 'q');
      return 11;
    }


  // 以下是研读的副程式
  //
  int do_study(string str) {
    object ob = this_player();
    if (ob->query("family/family_name") != "银针门")
      return notify_fail("也许我该叛师学做医生! 不然怎么看的懂呢! :( \n") else
        return 1;
  }
