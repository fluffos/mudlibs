//li-needle.c
#include <ansi.h>
#include <weapon.h>

inherit STABBER;

void create()
{
        set_name(HIW "雪鲤银针" NOR,({"li needle","needle"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "雪鲤银针是神医门的信物！配有此针应心怀仁义，
应时存济世之心才不愧于成为一个行医者！\n");
                set("unit", "支");
                set("value",0);
                set("rigidity", 30);
                set("no_drop",1);
                set("no_sell",1);
                set("no_give",1);
                set("material", "ironsteel");
                set("wield_msg", "$N伸手往针袋一掏，忽然一支$n掐在手指间！\n");
                set("unwield_msg", "$N将手中的$n插入针袋中。\n");
        }
        init_stabber(10);
        setup();
}

