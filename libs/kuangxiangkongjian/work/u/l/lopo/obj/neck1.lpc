//an_neck.c
#include <ansi.h>
#include <armor.h>

inherit EQUIP;

void create()
{
        set_name(HIR "凤凰项炼" NOR,({"an neck","neck"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "串");
                set("long", "凤凰项炼乃采凤凰羽和红水晶串链！\n");
                set("value",1000);
                set("material", "steel");
                set("armor_type","neck");
                set("armor_prop/armor",3);
        }
        setup();
}
