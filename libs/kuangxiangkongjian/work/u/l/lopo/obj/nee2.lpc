//yu-needle.c
#include <ansi.h>
#include <weapon.h>

inherit STABBER;

void create()
{
        set_name( "太乙神针" ,({"yu needle","needle"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "太乙神针是由雪山火玉精炼其粹所制！
雪山火玉色红，温润，具天然的磁性．\n");
                set("unit", "支");
                set("light_up",1);
                set("value",3000);
                set("material", "crimsonsteel");
                set("wield_msg", "$N伸手往针袋一掏，忽然一支$n掐在手指间！\n");
                set("unwield_msg", "$N将手中的$n插入针袋中。\n");
        }
        init_stabber(40);
        setup();
}
