// ice-needle.c
#include <ansi.h>
#include <weapon.h>

inherit STABBER;

void create() {
  set_name(HIW "冰蚕寒丝针" NOR, ({ "ice needle", "needle" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", "冰蚕寒丝针乃棌天山冰蚕所吐丝而编织，其丝强韧，
冰冷，需有深厚的内力方可持有！\n");
    //价值
    set("value", 50000);
    //硬度
    set("rigidity", 30);
    //可不可以丢
    //                set("no_drop",1);
    //可不可以给
    //                set("no_give",1);
    //亮不亮
    //                set("light_up",-1);
    //材料 : iron : steel : ironsteel : crimsonsteel 0.8 : 1 : 3 : 5
    set("material", "crimsonsteel");
    set("wield_msg", "$N伸手往针袋一掏，忽然一支$n掐在手指间！\n");
    set("unwield_msg", "$N将手中的$n插入针袋中。\n");
  }
  //打到mod 的skill type ....exp : stabber(*2), blade, sword, whip,
  init_stabber(50);
  setup();
}
