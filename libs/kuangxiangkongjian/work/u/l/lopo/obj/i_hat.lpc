#include <ansi.h>
#include <armor.h>

inherit EQUIP;

void create()
{
        set_name(HIC "华陀巾"NOR,({"hwa hat","hat"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "华陀巾乃采蚕丝编织！\n");
                set("value",500);
                set("material", "steel");
                set("armor_type","head");
                set("armor_prop/armor",2);
        }
        setup();
}

