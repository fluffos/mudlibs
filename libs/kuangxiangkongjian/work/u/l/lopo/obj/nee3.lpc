//gold-needle.c
#include <ansi.h>
#include <weapon.h>

inherit STABBER;

void create()
{
        set_name( "南海金针" ,({"gold needle","needle"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "南海金针乃是采集深海金矿所粹炼而成，
是一种相当罕见的针灸用针！\n");
                set("unit", "支");
                set("value",2000);
                set("material", "ironsteel");
                set("wield_msg", "$N伸手往针袋一掏，忽然一支$n掐在手指间！\n");
                set("unwield_msg", "$N将手中的$n插入针袋中。\n");
        }
        init_stabber(30);
        setup();
}
