//lin_pant.c
#include <ansi.h>
#include <armor.h>

inherit EQUIP;

void create() {
  set_name(HIW "玲珑羽" NOR, ({ "lin pant", "pant" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "玲珑羽乃采海龙筋和凤凰羽交互编织而成！\n");
    set("value", 1000);
    set("material", "steel");
    set("armor_type", "pant");
    set("armor_prop/armor", 5);
  }
  setup();
}
