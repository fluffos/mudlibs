//yun-belt.c
#include <ansi.h>
#include <armor.h>

inherit EQUIP;

void create() {
  set_name(HIY "飘云绫" NOR, ({ "yun belt", "belt" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "飘云绫乃采金蚕所吐的丝编织！\n");
    set("value", 5000);
    set("material", "steel");
    set("armor_type", "waist");
    set("armor_prop/armor", 3);
    set("armor_prop/dodge", 3);
    set("armor_prop/move", 2);
  }
  setup();
}
