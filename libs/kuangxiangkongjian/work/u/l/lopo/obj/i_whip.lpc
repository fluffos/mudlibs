//ice-whip.c
#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create() {
  set_name(HIW "蚕丝鞭" NOR, ({ "ice whip", "whip" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "蚕丝鞭乃棌天山冰蚕所吐丝而编织!\n");
    set("value", 5000);
    set("material", "crimsonsteel");
    set("wield_msg", "$N伸手往腰间一掏，忽然一把$n握在手中！\n");
    set("unwield_msg", "$N将手中的$n缠入腰间。\n");
  }
  init_whip(50);
  setup();
}
