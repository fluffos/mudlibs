//ice-boots.c
#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name(HIW "冰蚕靴" NOR,({"ice boots","boots"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "冰蚕靴乃采天山冰蚕所吐的丝编织！\n");
                set("value",50000);
                set("material", "crimsonsteel");
                set("armor_type","boots");
                set("armor_prop/armor",3);
                set("armor_prop/dodge",5);
                set("armor_prop/move",4);
        }
        setup();
}

