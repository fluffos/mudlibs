//chi_finger.c
#include <ansi.h>
#include <armor.h>

inherit EQUIP;

void create()
{
        set_name(HIW "七宝彩晶戒" NOR,({"chi finger","finger"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("long", "七宝彩晶戒乃是由七色水晶研磨结晶炼制 ！\n");
                set("value",1000);
                set("light_up",1);
                set("material", "steel");
                set("armor_type","finger");
        }
        setup();
}

