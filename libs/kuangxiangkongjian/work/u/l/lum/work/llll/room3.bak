//广播电台
inherit ROOM;

object ob;

int number=1;

 

void create ()

{

  set ("short", "拉姆广播电台□录音室(Lm 105.5兆赫)");
  set ("long", @LONG
这里是拉姆太空船专设的广播站，也是拉姆苦心建设经营的成果，在这边可以向ＦＳ
的玩家们同步播放，所有的录音设备一应俱全，也有很好的隔音设备，站在这边让你忍
不住的想高歌一曲。
这里有:
可爱的麦克风(mac)
全套录音设备(binaural)
LONG);
  set("item_desc", ([ /* sizeof() == 1 */

  "mac" : "这是一只可爱的麦克风，上面贴有虎纹的贴纸，你可以用它来跟全FS的玩家

说说话，打打屁等...

用法: mac 后面加上你要说的话 ...

",

]));

 

  set("exits", ([ /* sizeof() == 2 */

  "carol" : "/u/c/carol/workroom",

  "south" : "/u/l/lum/room2",

]));

 

  set("no_fight", 1);

 

  set("no_magic", 1);

 

  set("no_clean_up", 0);

 

  set("valid_startroom", 1);

 

 

  setup();

}

 

void init()

{

add_action("mac","mac");

}

 

int mac(string str)

{

int i,flag=0;

 

if(!str)

  {

   notify_fail("你总要说些话啊!!, 不然其他玩家怎么能听得到呢?\n");

   flag=0;

   return 0;

  }

for(i=0;i<number;i++)

  {

    //if(ob=find_player(name[i]))

    if(ob!=this_player())

    {

    message("system","\n

  [1m[33m[拉姆广播电台]"+this_player()->name()+"温柔的说:"+str+"[0m\n",users());
 flag++;

    }

  }

  if(flag!=0)

  {

  write("你对着麦克风用力的怒吼："+str+"\n");

  }

  else

  {

  write("不会吧!线上没有其他的玩家耶!。\n");

  }

  say(this_player()->query("name")+"("+this_player()->query("id")+")"+" 对着麦克

风摆了一个很帅的POSE，然后叽叽咕咕地说了些话..\n");

  flag=0;

  return 1;

}

