#include <ansi.h>
#include <armor.h>
 
inherit ARMOR;
 
void create()
{
      set_name("青龙神甲", ({ "armor" }) );
      set_weight(2000);
      if( clonep() )
              set_default_object(__FILE__);
      else {
              set("unit", "件");
              set("material", "cloth");
              set("no_sell",1);
              set("armor_prop/armor", 100);
              set("armor_prop/dodge", 100);
      }
      setup();
}
 
int wear()
{
 if( this_player()->query("id") != "lys" )
    return notify_fail("你并不是我的主人。\n");
 set_heart_beat(1);
 ::wear();
 return 1;
}
int unequip()
{
 set_heart_beat(0);
 ::unequip();
 return 1;
}
void heart_beat()
{
 object me, killer;
 if( !(me =environment())->is_character()) return ;
 if( me->query("kee") == me->query("max_kee") ) return ;
 if(!objectp(killer = me->query_temp("last_damage_from") ))
    return;
 tell_object(environment(me),"忽然神甲幻化成一条青龙, 向"+killer->name()+"直攻而去。\n");
 tell_object(environment(me),"并将其力道还诸己身。\n");
 killer->receive_damage("kee",me->query("max_kee")-me->query("kee"));
 killer->receive_wound("kee",me->query("eff_kee")-me->query("kee"));
 me->set("kee",me->query("max_kee") );
 me->set("eff_kee",me->query("max_kee") );
}
