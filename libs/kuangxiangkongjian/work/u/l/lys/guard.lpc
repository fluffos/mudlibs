#include <ansi.h>

inherit NPC;

void create()
{
	set_name("守卫", ({"guard"}) );
        set("long",
	     "他正在旁边偷懒睡觉。\n");
	set("attitude", "friendly");
	set("gender", "男性" );
	set("age", 30);
	set("max_force", 200);
	set("force", 200);
	set("combat_exp", 6000);

        setup();

        carry_object("/obj/cloth")->wear();
}
