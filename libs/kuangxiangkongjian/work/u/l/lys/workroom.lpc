#include <room.h>

inherit ROOM;

void create ()
{
  set ("short", "大门");
  set ("long", @LONG



		风流才子的工作室




LONG);

  set("exits", ([ /* sizeof() == 8 */
  "up" : "/u/f/fund/workroom",
  "down" : "/open/poison/room/room1",
  "east" : "/open/wiz/entrance",
]));
  set("objects", ([ /* sizeof() == 1 */
  __DIR__"guard.lpc" : 1,
]));
  set("light_up", 1);
  set("valid_startroom", 1);

  setup();
  call_other("/obj/board/lysboards","????");
}
int valid_leave(object me, string dir)
{
object who;
if(me->query("id")!="lys")
{
if (dir=="north" && who=present("guard",environment(me)))
  return notify_fail("没通报一声就想进去呀\n");
}
if (dir == "north" && this_player()->query_temp("weapon"))
 return notify_fail("想闹事呀!\n");
return ::valid_leave(me,dir);
}
