// knife

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name("青铜镖", ({ "copper knife", "knife" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("base_unit", "把");
    set("long", "用青铜所炼制的镖\n");
    set("value", 1000);
    set("material", "steel");
  }
  init_throwing(10);
  set_amount(1);
  set("wield_msg", "$N左手一动手中多了一把$n\n");
  set("unwield_msg", "$N将手中的$n藏入袖中。\n");

  setup();
}
