// knife

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
	set_name("无影神针" ,({"needle"}));
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("base_unit", "把");
		set("long", 
" 		无影神针顾名思义就是没有影子的针
		这是因为针十分细小所以就算有影也很难注意到
		也因为体积小, 所以能射得特别快.
		\n");
		set("value", 8000);
		set("material", "steel");
	}
        init_throwing(80); 
	set_amount(1);
        set("wield_msg", "$N从怀中掏出$n ,两眼瞄着众人\n");
        set("unwield_msg", "$N小心收起$n。\n");
	
	setup();
}

