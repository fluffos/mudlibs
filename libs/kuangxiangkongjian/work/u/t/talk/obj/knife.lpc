// sword.c : an example weapon

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
	set_name(HIY "流星镖" NOR,({"star knife","knife"}));
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("base_unit","把");
		set("base_value",1000);
		set("value",1);
		set("material", "steel");
	}
        init_throwing(100); 
	set_amount(1);
        set("wield_msg", "$N从腰间拔出$n握在手中\n");
        set("unwield_msg", "$N将手中的$n往上一丢$n 消失于无形。\n");


	setup();
}

