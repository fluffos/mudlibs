// knife

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name("小李飞刀", ({ "Li knife", "knife" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("base_unit", "把");
    set("long",
      "当年小李探花的武器
		 百晓生的兵器谱排行第三
		 不够现在世上仅存不多\n");
    set("value", 10000);
    set("material", "steel");
  }
  init_throwing(90);
  set_amount(1);
  set("wield_msg", "$N将$n握在手中, 感受到$n的正义之气,力量倍增\n");
  set("unwield_msg", "$N将$n收入怀中。\n");

  setup();
}
