#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("防弹衣", ({ "cloth" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("value",2000);
	        set_temp("apply/damage", 6);
	        set_temp("apply/armor", 2);
		
        }
        setup();
}

