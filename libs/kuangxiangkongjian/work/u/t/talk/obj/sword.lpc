#include <weapon.h>

inherit SWORD;

void create() {
  set_name("普通剑", ({ "god sword", "sword" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 2000);
    set("material", "iron");
    set("long",
      "这是一把还仆归真的剑，所以看不出来有任何特征。\n");
  }
  init_sword(15);
  setup();
}
