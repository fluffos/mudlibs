inherit ROOM;

void create ()
{
  set ("short", "脱壳王的工作室");
  set ("long", @LONG
	聊天摸鱼混水门的根据地
LONG);

  set("light_up", 1);
  set("valid_startroom", 1);
  set("exits", ([ /* sizeof() == 3 */
  "north"         : __DIR__"room/jail",
  "west"	  : __DIR__"room/poison",
  "down"          : "/open/common/room/inn",
]));
  set("need_key/north",1);
