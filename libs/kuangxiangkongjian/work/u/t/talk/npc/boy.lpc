// guard.c

#include <ansi.h>

inherit NPC;
void create() {
  set_name("聊天小童", ({ "talk boy", "boy" }));
  set("gender", "男性");
  set("age", 18);
  set("str", 35);
  set("cor", 45);
  set("cps", 25);
  set("int", 25);
  set("long",
    "一位聊天派的小剑童,他会一些武艺,\n"
    "他是聊天王的跟班,你可不要小看他.\n");
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 3000);
  set("mana", 600);
  set("max_force", 5000);
  set("force", 5000);
  set("force_factor", 10);

  set_skill("sword", 20);
  set("combat_exp", 70000);
  set("attitude", "peaceful");
  set("chat_chance", 15);
  set("chat_msg", ({
    "小童说: 聊天王到, 众人鼓掌欢送.\n",
    "小童说: 聊天王万岁 \n",
    "小童说: 不要动摸鱼堂的东西喔,有毒的.\n",
    "小童说: 乱走迷路,摸鱼堂可不负责...\n",
  }));
  set_skill("shasword", 100);
  map_skill("sword", "shasword");
  set_skill("sha-steps", 100);
  map_skill("dodge", "sha-steps");
  set_skill("sword", 100);
  set_skill("unarmed", 1);
  set_skill("parry", 1);
  set_skill("dodge", 100);
  setup();
  add_money("coin", 100000);
  carry_object("/open/gsword/obj/wrists")->wear();
  carry_object("/open/gsword/obj/tiger-surcoat")->wear();
  carry_object("/open/gsword/obj/suit")->wear();
  carry_object("/u/t/talk/shoes")->wear();
  carry_object("/u/t/talk/jade")->wear();
  carry_object("/u/t/talk/sword")->wield();
}
