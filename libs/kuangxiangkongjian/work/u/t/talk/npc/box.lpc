inherit NPC;

void create() {
  set_name("聊天猫", ({ "talk cat", "cat" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "聊天猫,聊天王游芙蓉湖时偷回来的\n");
  set("str", 10);
  set("cor", 10);
  set("per", 100);
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("chat_chance", 3);
  set("chat_msg", ({
    "聊天猫 跳到你的膝上,露出白绒绒的肚皮,似乎想叫你摸他。\n",
    "聊天猫 跑来跑去,正在追着毛线球玩。\n",
    "聊天猫 抓抓自己的耳朵。\n" }));

  set_temp("apply/attack", 500);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set("combat_exp", 100000);
  set_temp("apply/armor", 2500);
  setup();
}
