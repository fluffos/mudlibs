inherit PARTY_NPC;
void create()
{
           set_name("士兵", ({"soldier"}));
           set("age", 25);
           set("attitude","heroism");
           set("str", 28);
           set("per", 24);
           set("con", 55);
           set("cps", 20);
           set("cor", 21);
           set("combat_exp", 3000);
           set("force", 200);
           set_skill("parry", 100);
	   set_skill("move", 100);	
           set_skill("unarmed", 10);
           set_skill("dodge", 100);
           set_skill("henma-steps", 100);
           set_skill("lungshan", 25);
           map_skill("unarmed", "lungshan");
           map_skill("parry", "lungshan");
           map_skill("dodge", "henma-steps");
           set("chat_chance", 5);
           set("chat_msg", ({
                    "士兵喝道:‘看甚看!再看扁你喔!’\n"}));
           set_temp("apply/attack", 10000);
           set_temp("apply/armor", 10000);
           setup();
           carry_object("/open/ping/obj/Ns_boots.lpc")->wear();
           carry_object("/open/ping/obj/Ns_armor.lpc")->wear();
           carry_object("/open/ping/obj/Ns_hat.lpc")->wear();
 }
