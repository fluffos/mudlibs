############################################################
#                                                          #
#    国立交通大学  校园网路策进会 ＣＣＣＡ                 #
#                                                          #
#      Campus Computer Communication Association           #
#       Natinal Chiao Tung University                      #
#        HsinChu, Taiwan, ROC                              #
#                                                          #
############################################################
#
#  Example host file for Telnet 2.3
#
#  分离各行命令是任何 <33 的字元(ASCII Code) 和 :;=
#
#  '#' 开头的是注解(Remark)
#
#  命令的形式是 keyword=value ( 对各参数)
#
#myip=slip
myip=140.116.23.82 # 这是各机器的 IP Address,其中 "140.117" 全校
                            # 皆相同, 192 是指十二舍,此以交大为例，前三个
                            # 号码各地皆不同,读者可询问当地的系统管理者,
                            # 1 可自行选择1 至 253 的数字, 但必须选用与
                            # 他人不同的数字,否则选到他人使用的数字, 两
                            # 个人都会当机。
name=mygateway; hostip=140.116.23.253; gateway=1

#myip=RARP                  # 此两行参数一般人用不到, 可删掉。
#myip=BOOTP

netmask=255.255.255.0       # 此行参数大部份的人要设这样。

# 下面参数 'hardware' 一定要设这样(hardware=packet), 即使用外部 driver。
# 即使你的界面卡这里面有, 最好还是使用外部驱动程式,否则可能会出问题。
# (有 '#' 的行都可删掉)

hardware=packet            # 使用外部驱动程式
#interrupt=0
#ioaddr=0

#cursortop=2                # 此五行初学者可不管。
#cursorbottom=7
#broadcast=141.142.103.0
windowgoaway=yes
autoscroll=no

#clock=off                  # 是否在左下角显示时钟
myname=craypc.nsysu.edu.tw       # 可设定自己的名字, 但一般没用。

termtype="vt100"            # 设定终端机型式。(正常是vt100 )

#outputfile=telnet.out      # output mapping file 的 path name

#keyfile=keymap.key         # 键盘特殊键的设定表之档名

beep=yes                    # 当收到 ASCII Code 7 的字元是否要叫一声。

services=services.tel       # 初学者可不管。

tek=no                      # 是否使用 tektronix 绘图萤幕?

video=ega                   # 萤幕的形式
                            #    合法的值是 :
                            #    cga,ega,pga,no9,hercules,ega43,vga50
                            #   ega43 : 43 行 EGA

bios=NO                     # 是否使用 BIOS 呼叫控制萤幕。(Windows 必须使用)
                            #   设 no 比较快但相容性变低。

ftp=yes                     # 是否要在 Telnet 时使自己的 PC 能 FTP

rcp=no                      # 是否要使 rcp 能用?

#domainretry=3              # 在搜寻 domain name 时重试 3 次。

domain="ncku.edu.tw"     # 设定 domain name, 若 type "TELNET CC", 则
                            # 程式会以 "CC.nsysu.edu.tww" 向 nameserver
                            # 要求 IP Address 而连接。(假如读者没有设定
                            # CCSUN7 之 IP Address)

domaintime=10               # 搜寻 Domain name 的 timeout(时间限制) 时间。

#concolor=070170            # 初学者可不管。

capfile="c:\ncsa\capfile.out"         # capture 截下资料所存档案。

#hpfile=hp.out              # 初学者可不管。
#psfile=ps.out              # 初学者可不管。
#tekfile=tek.out            # 初学者可不管。(此三行与 tek 终端机有关)
arptime=30                  # 初学者可不管。

#passfile="c:\ncsa\passwd"   # 对自己的 PC 作 FTP 所用之 password
                             # 假如读者上列参数 "ftp" 设为 yes, 则此行第一
                            # 个 # 必须去掉,否则读者在 telnet 时很可能被别
                            # 人侵入 PC, 此 PC 只有任人宰割了。
                            # 可利用 TELPASS 程式设定自己的 password file ,
#
#  Following are individual machine specifications
#  Gateways are used in order that they appear in the file
#  Nameservers rotate, #1, #2, #3, #1, #2 when a request fails
#
#  The machine named "default" contains the fields which are automatically
#  filled in for later hosts
#
name=default                # 此行不可删掉。

#host=sri-nic.arpa          # Actual host name of machine, not session name
#       :                       :
#nameserver=1               # This machine has a DOMAIN name server for me

scrollback=100              # 可卷回去的行数。

clearsave=on               # 初学者可不管。

# Telnet 时的颜色设定 :
#       black, blue, green, cyan, red, magenta, yellow, white
#       BLACK, BLUE, GREEN, CYAN, RED, MAGENTA, YELLOW, WHITE
#                 ( 大写表高亮度 )
#       NOTE: when the highlighted colors are used for a background color,
#               they produce blinking text.
nfcolor=white                   # normal 时的前景颜色
nbcolor=black                   # normal 时的背景颜色
rfcolor=green                   # 初学者可不管。
rbcolor=BLUE                    # 初学者可不管。
ufcolor=red                     # 反白 时的前景颜色
ubcolor=green                   # 反白 时的背景颜色
bfcolor=RED                     # 加底线 时的前景颜色
bbcolor=green                   # 加底线 时的背景颜色

erase=delete                    # 倒退时的 key, 一般是用 "delete"
                                #   legal values are "delete" and "backspace"
vtwrap=yes                      # 印字在萤幕上超出右边界时是否要绕到下列。
#vtwidth=80                     # width of the vt100 screen
                                #   legal values are 80 and 132
                                #   Default is 80 (132 may not work correctly)
crmap=4.3BSDCRNUL               # 初学者可不管。
#duplex=half                    # 初学者可不管。
#font=Monaco                    # 初学者可不管。
#fsize=9                        # 初学者可不管。
#port=23                        # 初学者可不管。
ftpoptions="-i"                # 初学者可不管。
#outputmap=yes                  # 初学者可不管。

#  The following entries affect the tuning of TCP connections to this host.
#  They should be set by the network administrator who is familiar with
#    the requirements of your specific network.
#  以下 5 行初学者可不管。
contime=50
retrans=90
mtu=1024
maxseg=1024
rwin=1024

#
#  Below this line, most of the communication parameters are obtained
#   from the "default" host entry.
#  Machine names, IP addresses, and special communication parameters are
#   present when needed.
#  下面是设定工作站 IP Address 资料。

                # 设定 router(gateway) 的 IP Address, 一般最后一个数字是 254。
                # 此以交大十二舍为例, 号码各地皆不同,读者可询问当地的系统管理者

name=mynameserv; hostip=140.116.2.6; nameserver=1
name=mynameserv; hostip=140.117.72.1; nameserver=2
                # 设定 name server 的 IP Address

name=bbs;       hostip=140.116.82.7
name=bbs.ch;    hostip=140.116.23.77
name=dream;     hostip=140.116.23.86
name=snoopy;    hostip=140.116.2.11


