// dusa.c by oda

#include "/open/open.h"
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("锺子期", ({ "master chung", "chung", "master" }) );
	set("nickname", "知音者");
	set("title", "渭水音叟");
	set("gender", "男性");
	set("age", 41);
	set("class", "dancer");
	set("combat_exp", 900000);
	set("long", "当年伯牙的唯一的知音者。\n");

	set("str", 40);
	set("cor", 40);
	set("int", 24);
	set("spi", 22);
	set("cps", 30);
	set("con", 30);
	set("per", 16);
	set("max_force", 1500);
	set("force", 1500);
	set("force_factor", 10);

	set_skill("array", 100);
	set_skill("cure", 40);
	set_skill("dodge", 50);
	set_skill("force", 60);
	set_skill("move", 50);
	set_skill("parry", 50);
	set_skill("sword", 75);
	set_skill("throwing", 60);
	set_skill("unarmed", 50);

	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
	}) );

	setup();
	create_family("镜月岛",9,"传音圣使");
	set("family/next_title", "传音人");
	add_money("gold", 10);
}

void init()
{
	add_action("do_join", "join");
}

int accept_fight(object who)
{
	command("say 哼，天外音。\n");
	return 1;
}

void attempt_apprentice(object who)
{
	if( !who->query("class") ) {
		command("shake "+who->query("id"));
		command("say 等你懂五音再来吧。");
		return;
	}
	if( who->query("class")!="dancer" ) {
		command("stare "+who->query("id"));
		command("say 宫觞角征羽！");
		return;
	}
	command("look "+who->query("id"));
	command("say 好！我就收你吧。");
	command("recruit "+who->query("id"));
}

int do_join()
{
	object who;
	who = this_player();

	who->set("class", "dancer");

	return 1;
}
void die()
{
	object weapon;
	weapon = present("hook", this_object());
	destruct(weapon);
	::die();
}
