// Room: /u/t/talk/r1.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "聊天摸鱼室");
  set("long", @LONG
	这里是聊天王的陷害室，用poison即可
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "east": "/u/t/talk/workroom",
  ]));
  set("no_fight", 1);
  set("light_up", 1);
  set("no_magic", 1);

  setup();
}
void init() {
  add_action("do_poison", "poison");
}

int query_auto_load() {
  return 1;
}
int do_poison(string str) {
  object badman, badmanenv;

  if (!str || str == "talk") {
    write(HIW "嗯!!你找死说\n" NOR);
    tell_room(environment(this_player()), HIC + this_player()->query("name")
      +HIW "向聊天王挑战，\n" NOR,
      ({ this_object(), this_player() }));
    this_player()->set("env/immortal", 0);
    this_object()->destruct();
    this_player()->die();
    return 1;
  }
  badman = present(str, environment(this_player()));
  if (!badman) badman = find_living(str);
  if (!badman) {
    write(HIC + "诅咒失败\n" + NOR);
    return 1;
  }
  badmanenv = environment(badman);


  if (badman != this_player())
    write(HIW + "石上发出一股黑气往" HIC + (string)badman->query("name")
      +HIW "飞去，" + (string)badman->query("name") + "被黑气缠住了\n" NOR);
  else {
    write("你有病唷!!诅咒自己\n");
    return 1;
  }

  tell_room(environment(this_player()), "" + HIC
    +(string)this_player()->query("name")
    +HIW "黑气向" HIC + (string)badman->query("name")
    +HIW "卷去！" + (string)badman->query("name") + "被诅咒了\n" NOR,
    ({ this_player(), badman }));

  tell_room(environment(badman), HIW "忽然一道黑气从天而降, 把" HIC
    +(string)badman->query("name") + HIW "缠住" HIC
    +(string)badman->query("name") + HIW "被诅咒了\n" NOR,
    ({ this_player(), badman }));

  tell_object(badman,
    HIW "一道黑气从天而降\n" NOR +
    "( 你" + RED "被诅咒了" NOR
    + " )\n");
  switch (random(6)) {
    case 0:
      badman->apply_condition("dark_poison", 20);
      return 1;
      break;
    case 1:
      badman->apply_condition("five_poison", 20);
      return 1;
      break;

    case 2:
      badman->apply_condition("snake_poison", 20);
      return 1;
      break;

    case 3:
      badman->add("kee", -10000);
      return 1;
      break;

    case 4:
      badman->apply_condition("rose_poison", 20);
      return 1;
      break;

    case 5:
      badman->add("kee", -100);
      return 1;
      break;


  }
  return 0;
}
