#include <armor.h>

inherit CLOTH;

void create() {
  set_name("[1;32m闪绿劲装[0m", ({ "green suit", "suit" }));
  set_weight(200);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "套");
    set("long", "此甲闪着绿芒，有着十分优良的防御力。");

    set("material", "cloth");
    set("value", 2000);
    set("armor_prop/armor", 40);
  }
  setup();
}
