#include <ansi.h>

inherit ITEM;
inherit F_AUTOLOAD;

void create()
{
                set_name("筋斗云", ({ "fly cloud","cloud" }) );
                set_weight(20);
                if( clonep() )
                        set_default_object(__FILE__);
                else {
                        set("unit", "朵");
                        set("value", 0);
                        set("no_get",1);
                        set("no_insert",1);
                }
}

void init()
{
      add_action("do_fly", "fly");
}

int do_fly(string str)
{
        object me;
        me = this_player();
        message_vision(sprintf("忽然"HIY"筋斗云"NOR"从天边迅速飞来,"HIY"$N"NOR"使出一招"HIR"梯云纵"NOR"轻巧
地凌空而上,乘着"HIY"筋斗云"NOR"逍遥离去......\n"),this_player());

        if(!str)
            me->move("/u/l/lkj/workroom");
        else
            if(str == "home")
                me->move("/u/l/lys/workroom");
	else if(str == "gsword")
		me->move("/open/gsword/room/g1-1");
	else if(str == "wu")
	 	me->move("/open/wu/hall/wizroom");

        message_vision(sprintf("忽然"HIY"筋斗云"NOR"从天边快速飞来,"HIY"$N"NOR"脚踏"HIR"七星步"NOR",从天上缓缓而降,如同神仙下凡般。\n"),this_player());
        return 1;
}

int query_autoload()
{
         return 1;
}
