#include <ansi.h>
inherit EQUIP;
void create()
{
    set_name(HIR "红玉坠子" NOR , ({"gem"}) );
     set_weight(500);
     if ( clonep() )
              set_default_object(__FILE__);
     else {
            set("long", 
"一条由难得一见的红宝石镶于其上的项炼 ,\n"
"听说红宝石有收纳能量的功效\n");
            set("unit", "条");
            set("armor_type", "neck");
            set("value", 10000);
set("armor_prop/parry", 10);

            set("armor_prop/armor",3);
            set("wear_msg", "$N把$n戴在脖子上 ,呼然一股力量注入$N的身上。\n");
     }
}

