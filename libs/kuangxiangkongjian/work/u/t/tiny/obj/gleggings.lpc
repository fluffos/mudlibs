inherit EQUIP;

void create()
{
       set_name( "散星护胫" , ({ "leggings" }) );
        set_weight(700);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","由碎钻镶于精钢上的高级护胫\n");
                set("unit", "副");
                set("value", 5000);
                set("material", "steel");
                set("armor_type", "legging");
                set("armor_prop/armor", 6);
        }
}
