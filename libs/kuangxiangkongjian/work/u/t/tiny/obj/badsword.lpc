#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void bleed(object me, object victim, object weapon, int damage);
void block(object me, object victim, object weapon, int damage);

mapping *action = ({
  ([
    "damage_type": "刺伤",
    "action": "$w似乎带着$N势如破竹般的往$n的$l猛刺",
    "dodge": 30,
    "parry": 30,
    "damage": 25,
    "post_action": (: call_other, __FILE__, "block" :),
  ]),
  ([
    "action": "$N手中的$w似乎不听使唤，自己找寻敌人弱点，往$n的$l狠狠地划下去",
    "damage_type": "割伤",
    "dodge": -30,
    "parry": -30,
    "damage": 50,
    "post_action": (: call_other, __FILE__, "bleeding" :),
  ]),
});


void create() {
  set_name("万恶之剑", ({ "badsword", "sword" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "\n这把剑透着一股恶霸之气，剑身浑然一色 - 黑，散发出一股气息 - 死，\n剑上刻满了一万个「恶”字，令人毛骨耸然。\n\n");
    set("value", 1000);
    set("material", "crimsonsteel");
    set("wield_msg", "$N一抽出万恶剑，整个人煞气更重，杀气更深，死气更浓，霸气更恶，邪气更盛，\n仿佛是一个万恶不赦之徒。\n");
    set("unwield_msg", "$N一收回万恶剑，好像恢复了少许\良知。\n");
  }
  init_sword(100);
  set("actions", (: __FILE__, "query_action" :));
  setup();
}

varargs mapping query_action() {
  return action[random(sizeof(action))];
}

void block(object me, object victim, object weapon, int damage) {
  if (damage > 10) {
    victim->start_busy(random((int)me->query_skill("sword", 1) / 20 + 2));
    message_vision(HIY "万恶剑突然不听$N的使唤，自组成一片剑网，使得$n为其所困而暂时无法动弹。\n" NOR, me, victim);
  }
}

void bleed(object me, object victim, object weapon, int damage) {
  int cond;

  if (damage > 30) {
    cond = victim->query_condition("bleeding");
    cond += random(me->query_skill("sword", 1) / 10);
    victim->apply_condition("bleeding", cond);
    message_vision(HIR "万恶剑带着$N把$n划出一道不浅的伤口，流血不止。\n" NOR, me, victim);
  }
}
