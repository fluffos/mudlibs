// ph_hat.c
#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(HIW "龙须衣" NOR, ({ "dragon cloth", "cloth" }));
  set_weight(100);
  set("no_drop", 1);
  set("armor_type", "body");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 100000);
    set("material", "gold");
    set("armor_prop/armor", 50);
    set("armor_prop/dodge", 10);
    set("armor_prop/move", 10);
  }
  setup();
}
