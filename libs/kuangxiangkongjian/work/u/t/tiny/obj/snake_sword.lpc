// ten_sword.c
#include <ansi.h>

#include <weapon.h>

inherit SWORD;
inherit F_CLEAN_UP;
void create()
{
           set_name(HIY "金鳞蟒邪" NOR,({ "snake sword","sword"}));
          set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
            set("value",1000000);
		set("material", "steel");
       set("long","人间至宝，一把绝世好剑。\n");
	}
           init_sword(60);
	setup();
}
void init()
{
            add_action("rec","recover");
}
int rec()
{
          shout(HIW "          突然一道寒光闪过\n\n          乃是从金鳞蟒邪所发出的寒光\n\n" NOR);
          message_vision(
               HIY "金鳞蟒邪"+HIW+"发出阵阵寒气，$N的内力在一瞬间完全恢复。\n" NOR,this_player());
           this_player()->set("force",this_player()->query("max_force"));
                     if(random(3)<1)
          {
                message_vision(                  HIY "金鳞蟒邪的灵气用尽，已经变成一块废铁》" NOR,this_player());
            message_vision( "\n",this_player());
             destruct(this_object());
             }
           return 1;
}
