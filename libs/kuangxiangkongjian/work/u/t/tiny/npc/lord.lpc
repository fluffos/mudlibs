inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("不死之师",({"ttiny"}));
	set("long","不死之师是当今皇上册封给不死鸟专用的老师, 同时也是段家武学的第一把。\n");
	set("gender","男性");
	set("class","scholar");
	set("nickname","不死之师");
        set("combat_exp",1000000);
        set("attitude","heroism");
	set("age",50);
	set("str", 44);
	set("cor", 24);
	set("cps", 18);
	set("per", 24);
	set("int", 42);
	set("force",3000);
	set("max_force",3000);
        set_skill("literate",100);
        set_skill("force", 85);
        set_skill("dodge", 60);
        set_skill("move", 60);
        set_skill("parry", 40);
        set_skill("sunforce",100);
        set_skill("six-fingers",100);
        set_skill("magic",100);
        map_skill("force","sunforce");
        map_skill("unarmed","six-fingers");
	map_skill("dodge","six-fingers");
	
	set("force_factor",10);
	setup();
        add_money("gold",10);
        create_family("段家",10,"掌门人");
}
  void attempt_apprentice(object me)
{
        write("很好，" + RANK_D->query_respect(me) + "多加努力，"+
              "他日必定有成。\n");
        command("recruit " + me->query("id") );
}
