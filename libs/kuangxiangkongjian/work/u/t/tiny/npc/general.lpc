// 平南将军
#include "/open/open.h"
inherit NPC;
void create()
{
	set_name("正五品督军 张渊",({"officer zhang","officer","zhang"}));
	set("long","朝庭派来平南督军的钦命大臣,他正为苗人的入侵(烦恼).\n");
	set("gender","男性");
        set("attitude","heroism");
	set("chat_chance", 15);
	set("chat_msg", ({
	" 张渊说: 苗军入侵联绵不断,如何是好??\n",
	" 张渊说: 来此督军,真是个苦差事啊!!\n",
	" 张渊说: 有能人侠士愿意伸出(援手)哉??\n"
	}));
	set("inquiry",([
	"烦恼" : "本朝与苗军对抗已数年了,如今骑虎难下,不知如何收场,唉...\n",
	"援手" : "擒贼先擒王,本官欲征一壮士,买(苗王)颈上人头!!\n",
	"苗王" : "就是平南城西那个残暴的苗王.(苗疆尚未完成,sorry)\n",
	]) );
	set("age",32);
	set("int",30);
	set("per",30);
	set("str", 10);
	set("cor", 60);
	set("force",1500);
	set("max_force",1500);
        set("combat_exp", 25000);
	set_skill("force",60);
        set_skill("dodge", 5);
        set_skill("parry", 5);
        set_skill("unarmed",45);
        set_skill("linpo-steps",5);
        set_skill("six-fingers",45);
	map_skill("dodge","linpo-steps");
	map_skill("parry","six-fingers");
        map_skill("stabber","six-fingers");
        set("force_factor", 3);
	setup();
	carry_object("/open/ping/obj/fan-1")->wield();
	carry_object("/open/ping/obj/robe-1")->wear();
	carry_object("/open/ping/obj/wrists-1")->wear();
	add_money("silver",50);
}

int accept_kill(object who)
{
  command("wield all");
  command("kill " + who->query("id"));
  return 1;
}
int accept_fight(object who)
{
   command("wield all");
   command("fight " + who->query("id"));
   return 1;
}
                        
