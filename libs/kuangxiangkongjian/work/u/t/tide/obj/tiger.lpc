// black_suit.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
       set_name( HIC "虎形兽皮" NOR, ({ "tiger suit", "suit" }) );

	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 1050);
		set("material", "cloth");
		set("armor_prop/armor", 1);
                      set("armor_prop/id", ({"wlid tiger", "tiger"}) );
                    set("armor_prop/name", ({"老虎"}) );
           set("armor_prop/short", ({"老虎(Tiger)"}) );
		set("armor_prop/long", ({
                   "一只看起来很凶猛的老虎, 看来....平常学习的技能可以派上用场了。\n"
		}) );
	}
	setup();
}
