#include <ansi.h>

inherit ITEM;
inherit F_SAVE;

void ease_msg(object me);

void create()
{
      set_name("筋斗云",({"cloud"}));
      set_weight(100);
      if ( clonep() )
           set_default_object(__FILE__);
      else {
           set("unit","朵");
           set("no_sell",1);
           set("material","water");
           set("long","一朵不起眼的白云停在你的身旁。\n");
      }
      setup();
}

void init()
{
      add_action("do_ease","ease");
}

int do_ease(string str)
{
      object me,ob;
      me=this_player();

       //if ( me->query("id")!="tide" )
           //return notify_fail("SORRY!!本物尚处于测试阶段，故不外流；请见谅。\n");
      if ( !str || str=="" )
         return notify_fail(HIC"阿没你是要去哪？\n"NOR);
      if (!(ob=find_player(str)))
         return notify_fail(HIY"现在没这人吧!?\n"NOR);
      if ( environment(ob)==environment(me) )
         return notify_fail(HIW"你已在此地了，别脱裤子放屁了。\n"NOR);
      else {
         message_vision(HIM"忽的一阵疾风掠来一朵白色的筋斗云，将$N带走了。\n"NOR,me);
         me->move(environment(ob));
         remove_call_out("ease_msg");
         call_out("ease_msg",3,me);
         return 1;
      }
      return 1;
}

void ease_msg(object me)
{
      message_vision(HIM"一朵白云将$N送到了此处。\n"NOR,me);
}
