// houndbane.c

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
	set_name( BLK "狮头刀" NOR, ({ "lion blade", "lion", "blade" }) );
	set_weight(17000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把乌沈沈的狮头刀，因刀柄上威武的狮头而得名，而拿在你手中更显得你英气勃勃。\n");
		set("value", 42000);
		set("material", "crimsonsteel");
		set("wield_msg", "$N「飕”地一声从背后刀囊中抽出一把背厚刃薄的$n握在手中，此时刀柄上的狮头突然发出一声狂吼， ～～吼～～的一声，震的众人大惊失色，耳朵一阵发麻．．．。\n");
		set("unequip_msg", "$N俐落的将手中的$n插入背后的刀囊。\n");
	}

	init_blade(99);
	setup();
}
