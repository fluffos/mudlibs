 
#include <mudlib.h>
#include <ansi.h>
 
inherit ITEM;
 
void create()
{
  set_name(HIB+"雷射光斩剑"+NOR, ({"Lum Lasersword", "sword"}));
  set("long",@LONG
       这是一把雷射光斩剑，攻击力强．．
LONG);
  set_weight(1);
  set("unit", "把");
  seteuid(getuid());
}
 
void init()
{
  add_action("fire", "kick");
}
 
int query_auto_load()
{
return 1;
}
 
int fire(string str)
{
  object target,targetenv;
  int gin1, kee1, sen1;
 
    if((string)this_player()->query("id")!="tide")
  return notify_fail("开玩笑!你以为你拿的动这把雷射光斩剑吗?\n");
  if(!str || str == "")
    {
      write(HIR"你挥动光斩剑往身旁一挥，路边的一台BMW完蛋了!\n"NOR);
      tell_room(environment(this_player()), HIC+this_player()->query("name")
                +HIR"拉姆忽然高举光斩剑往你斩了过来，你心想完蛋了，结果只是斩到
路边的一台BMW，真逊！\n"NOR,
                ({this_object(), this_player()}));
      return 1;
    }
  target=present(str,environment(this_player()));
  if(!target) target = find_living(str);
  if(!target) {
  write(HIC+"你到底要斩什么？\n"+NOR);
  return 1;}
  targetenv=environment(target);
 
 
  if(target != this_player())
   write(HIR+"你挥动光斩剑向"HIC+(string)target->query("name")
         +HIR"攻击，$n的身上喷出了阵阵鲜血!\n"NOR);
  else
  {
  write("这个．．．．不太对吧\n");
  return 1;
  }
 
  tell_room(environment(this_player()),""+HIC
            +(string)this_player()->query("name")
            +HIR"忽然举起光斩剑向"HIC+(string)target->query("name")
            +HIR"挥击,你忽然感到一阵句痛!\n"NOR, ({this_player(), target}));
 
  tell_room(environment(target), HIW"拉姆挥动雷射光斩剑向着"HIC
            +(string)target->query("name")+HIW"斩了过去，一下子"HIC
            +(string)target->query("name")+HIW"的身上已多了一个大窟窿！\n"NOR,
            ({this_player(), target}));
 
  tell_object(target,
              HIW"当你有意识时，你的身上已经多了一个长长的伤口\n"NOR+
              "( 你"+RED"受伤过重，发觉天旋地转，已经站不住脚了。"NOR
              +" )\n");
              gin1 = target->query("gin") * 0.9;
              kee1 = target->query("kee") * 0.9;
              sen1 = target->query("sen") * 0.9;
              target->add("gin", -gin1);
              target->add("kee", -kee1);
              target->add("sen", -sen1);
              if(target->query("kee") < 100 ) target->add("kee", -200);
 
  return 1;
}
