#include <ansi.h>

inherit NPC;

void create()
{
      set_name("云游僧",({"bonze"}));
      set("long",@LONG
一个慈眉善目的老僧人，平日便云游四海、四处为家，无牵无挂的行走天下，
令人好生羡慕。
LONG
      );
      set("age",62);
      set("attitude","friendly");
      set("gender","男性");
      
      set_skill("unarmed",40);
      set_skill("dodge",35);
      set_skill("parry",40);
      set("combat_exp",850);

      set("chat_chance",1);
      set("chat_msg",({
           (:random_move:),
          "云游僧说道：嗯...贫僧怎觉得此处似乎充满着肃杀的气氛。\n",
          "云游僧说道：阿弥陀佛，我佛慈悲。\n",
      }) );

      add_money("coin",5);

      setup();
}
