// holder.c

#include "/open/su.h"
inherit NPC;

int amount;
string ask_tea();

void create() {
  set_name("小男孩", ({ "little boy", "boy" }));
  set("gender", "男性");
  set("age", 10);
  set("long",
    "一位可爱的男孩正面带笑容地站在你的面前，他正是这间房间的管家。\n");
  set("combat_exp", 95);
  set("attitude", "friendly");
  set("inquiry", ([
    "茶水": (: ask_tea :),
    "tea": (: ask_tea :)
  ]));

  // 杯子无限给?
  // 我改成只有三个, 如果你觉得可以的话, 也可以改成捐钱就有茶水喝
  // 新角色我给一千银两, 应该可以做很多事了
  // 捐钱的方式可以找原来的庙祝
  amount = 3;

  set("chat_chance", 3);
  set("chat_msg", ({
    "小男孩对你慈祥地一笑。\n",
    "小男孩说道: 先生若是口渴了，房里备有茶水。\n" }));

  setup();
}


string ask_tea() {
  object tea;

  if (amount > 0) {
    tea = new(SU_OBJ "cup");
    tea->move(this_player());
    amount--;
    message_vision("男孩递给$N一杯茶水。\n", this_player());
  } else
    message_vision("吾主生活困苦, 不知先生, $N愿不愿意先捐点钱?!\n", this_player());
  return "先生请慢慢参观\n";
}
