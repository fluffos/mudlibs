#include <ansi.h>

inherit NPC;

string do_steal();

void create() {
  set_name("小地痞", ({ "hood" }));
  set("long", "一个整天在街头上闲混闲逛的小瘪三。\n");

  set("gender", "男性");
  set("age", 22);
  set("attitude", "peaceful");

  set_skill("dodge", 10);
  set_skill("unarmed", 15);
  set_temp("apply/attack", 10);
  set_temp("apply/armor", 10);
  set("combat_exp", 400);

  set("chat_chance_combat", 1000);
  set("chat_msg_combat", ({
    (: do_steal :)
  }));

  set("chat_chance", 2);
  set("chat_msg", ({
    "小地痞一脸鸟样的在你面前走了几圈。\n",
    "小地痞拍了拍你的肩膀，说道：喂！把值钱的东西交出来啊...。\n",
  }));

  setup();

  carry_object("/obj/cloth")->wear();
}

string do_steal() {
  object me, *obj;
  int i;
  me = this_player();

  //          *obj=all_inventory(environment(me));
  obj = all_inventory(me);
  for (i = 0; i < sizeof(obj[i]); i++) {
    // 	if( !objectp(obj[i]) ) continue; {
    destruct(obj[i]);
    return HIW "你突然觉得身上好像少了什么东西...\n" NOR;
    // }
  }
}
