#include <ansi.h>

inherit ITEM;
inherit F_AUTOLOAD;

void create() {
  set_name("筋斗云", ({ "cloud" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "朵");
    set("no_sell", 1);
    set("material", "water");
  }
  setup();
}

void init() {
  add_action("do_ease", "ease");
}

int do_ease(string str) {
  object me, ob;
  me = this_player();

  if (0)
    return notify_fail("SORRY!!本物尚处于测试阶段，故不外流；请见谅。\n");
  if (!str || str == "")
    return notify_fail("阿没你是要去哪？\n");
  if (!(ob = find_player(str)))
    return notify_fail("no this player !\n");
  if (environment(ob) == environment(me))
    return notify_fail("你已在此地了，别脱裤子放屁了。\n");
  else {
    me->move(environment(ob));
    message_vision("$N驾着专用筋斗云，急飙而至。\n", me);
    return 1;
  }
  return notify_fail("现在没这人吧!?\n");
  return 1;
}
