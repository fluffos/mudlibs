#include "/open/open.h"
#include <ansi.h>

inherit NPC;

void create();
{
      set_name("谜之剑侠",({"sworder"}));
      set("long","一位眉头深锁的男子，俊俏的脸上带着一丝的忧郁；而其满头黑发中
一撮突兀的白发遮住了半边的脸庞，平添了其神秘的感觉...\n");
      set("age",30);
      set("gender","男性");
      set("attitude","heroism");

      set_skill("sword",100);
      //set_skill("?????",100);
      set_skill("dodge",90);
      set_skill("parry",90);
      set("combat_exp",15000);

      //carry_object(BAD_OBJ"sword")->wield();

      setup();
}

