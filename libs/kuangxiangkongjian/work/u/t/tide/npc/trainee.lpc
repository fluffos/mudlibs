// trainee.c

inherit NPC;

void create() {
  set_name("老鼠", ({ "mouse" }));
  set("long", "身上极脏的一只小老鼠而已,非常的不起眼。\n");

  //以下是依次为老鼠的种类、性别、年纪、态度。

  //P.S. race为设定npc种类，若为人类可不用设定。
  set("race", "野兽");
  //P.S. gender为npc性别，若为人类则设为男性 or 女性。
  set("gender", "雄性");
  set("age", 3);
  set("attitude", "peaceful");

  set("str", 10);
  set("cor", 18);
  set("kee", 50);
  set("max_kee", 50);
  set_temp("apply/attack", 20);
  //P.S. verb为npc的攻击方式，若npc为人类可省略。
  set("verb", ({ "bite", "claw" }));
  //P.S. limb为npc受到攻击之部位，若npc为人类可省略。
  set("limb", ({ "头部", "腹部", "腿部" }));
  //P.S. combat_exp为实战经验。
  set("combat_exp", 10);
  set("chat_chance", 4);
  set("chat_msg", ({
    "老鼠对着你吱吱喳喳叫。\n",
  }));

  setup();
}
