// guard.c

#include <ansi.h>

inherit NPC;

string ask_me(object who);

void create()
{
	set_name("贾霸天", ({ "jar baaten", "jar" }) );
	set("title", "护院");
	set("gender", "男性" );
	set("age", 26);
	set("str", 29);
	set("cor", 30);
	set("cps", 30);
	set("int", 11);
	set("long",
		"贾霸天是菠萝戏院的当家护院，除了院长花不丸没有人知道他的出身来历，只知\n"
		"到他的武艺不弱，一手快剑在这一带罕有敌手。\n" );
	set("combat_exp", 5000);
	set("attitude", "heroism");
	set("chat_chance_combat", 15);
	set("chat_msg_combat", ({
		"贾霸天说道：你当这里是什么地方，敢来这里撒野？\n",
		"贾霸天说道：想我堂堂....呃....连我这个菠萝戏院的小小的护院都可以收拾你！\n",
		"贾霸天忽然刺出一剑，招数精奇，但是刺到中途忽然像是想起什么，急忙收招。\n",
		"贾霸天说道：来者是客，就算我输了你啦....\n"
	}) );
	set("inquiry", ([
		"逃生门": (: ask_me :),
		"消防设施": (: ask_me :)
	]) );

	set_skill("sword", 40);
	set_skill("parry", 40);
	
	setup();
	
	carry_object(__DIR__"obj/sword")->wield();
	carry_object("/obj/cloth")->wear();
}

string ask_me(object who)
{
	int i;
	object *ob;

	if( query("revealed") ) {
		if( is_killing(who) ) return "你既然知道了消防设施不合格，今日休想活命！\n";
		else {
			kill_ob(who);
			who->fight_ob(this_object());
			return "免费给你看戏你还啰嗦,去找阎罗王问吧!纳命来！\n";
		}
	}

	if( (random(10) < 5)
	||	!is_fighting() )
		return "我...不知道！\n";
	set_temp("apply/attack", 70);
	set_temp("apply/dodge", 50);
	set_temp("apply/parry", 60);
	set_temp("apply/damage", 20);
	set("title", "刀剑双霸之剑霸");
	set("nickname", HIR "刀剑一霸" NOR);
	message("vision",
		HIY "贾霸天眼中突然放出异样的光芒，颤声说道：看来...你都知道了？\n\n"
		"贾霸天大喝一声，叫道：既然如此，老子今天非灭口不可，纳命来！\n" NOR
		"贾霸天使开长剑，剑撩下阴，招式狠辣，和刚才简直判若两人！\n",
		environment(), this_object() );
	set("pursuer", 1);
	set("attitude", "aggressive");
	set("chat_msg_combat", ({
		(: random_move :)
	}) );
	set("chat_chance", 15);
	set("chat_msg", ({
		(: random_move :)
	}) );
	set("bellicosity", 10000);
	set("combat_exp",10000);
	ob = all_inventory(environment());
	for(i=sizeof(ob)-1; i>=0; i--) {
		if( !ob[i]->is_character() || ob[i]==this_object() ) continue;
		kill_ob(ob[i]);
		ob[i]->fight(this_object());
	}
	carry_object(__DIR__"obj/sword_book");
	set("revealed", 1);
	return 0;
}

