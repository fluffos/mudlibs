#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
     set_name(HIY "君子之帽" NOR,({"gentleman hat","hat"}));
     set_weight(1000);
     set("armor_type","head");
     if( clonep() )
       set_default_object(__FILE__);
     else {
       set("unit","顶");
       set("long","这是当代大儒宁采臣所戴的一顶奇帽。\n");
       set("material","blacksteel");
       set("value",30000);
       set("armor_prop/armor",100);
          }
     setup();
}
