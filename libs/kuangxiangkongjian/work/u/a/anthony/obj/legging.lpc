#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
 set_name(HIY "君子护膝" NOR,({"gentleman legging","legging"}));
 set_weight(5000);
 if( clonep() ) 
  set_default_object(__FILE__);
 else {
  set("unit","个");
  set("long","这是当代大儒宁采臣所穿着的护膝。\n");
  set("material","blacksteel");
  set("value",30000);
  set("armor_type","legging");
  set("armor_prop/armor",100);
      }
 setup();
}
