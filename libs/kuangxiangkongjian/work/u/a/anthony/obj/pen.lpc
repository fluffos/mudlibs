#include <ansi.h>
#include <weapon.h>
inherit STABBER;
int special_att();
void create() {
  set_name(HIG "君子御笔" NOR, ({ "gentleman pen", "pen" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("vaule", 30000);
    set("material", "blacksteel");
    set("long", "这是一支当代大儒宁采臣所专用的一支异笔。\n");
    set("wield_msg", "$N从袖口中拿出了君子御笔握在手中。\n");
    set("unwield_msg", "$N将君子御笔收入袖口中。\n");
  }
  init_stabber(100);
  setup();
}
