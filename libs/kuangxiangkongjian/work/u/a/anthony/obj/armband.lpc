#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name(HIY "君子臂环" NOR, ({ "gentleman armband", "armband" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是由当代大儒宁采臣所佩戴的臂环。\n");
    set("value", 30000);
    set("unit", "个");
    set("material", "crimsonsteel");
    set("armor_type", "armband");
    set("armor_prop/armor", 100);
    set("armor_prop/dodge", 100);
    set("armor_prop/force", 100);
    set("armor_prop/unarmed", 100);
  }
  setup();
}
