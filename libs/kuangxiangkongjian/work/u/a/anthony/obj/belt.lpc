#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
 set_name(HIY "君子腰带" NOR,({"gentleman belt","belt"}));
 set_weight(5000);
 if( clonep() )
  set_default_object(__FILE__);
 else {
  set("unit","条");
  set("value",30000);
  set("long","这是当代大儒宁采臣所佩戴的腰带。\n");
  set("material","blacksteel");
  set("armor_type","belt");
  set("armor_prop/armor",100);
  set("armor_prop/force",100);
  set("armor_prop/dodge",100);
      }
 setup();
}
