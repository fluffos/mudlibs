#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create()
{
     set_name(HIW "君子刀" NOR,({"gentleman blade","blade"}));
     set_weight(7000);
     if( clonep() )
       set_default_object(__FILE__);
     else {
        set("unit","把");
        set("value",30000);
        set("material", "steel");
        set("long","这是一把由当代大儒宁采臣所佩带的西稀世宝刀。\n");
        set("wield_msg","$N‘唰’地一声抽出了君子刀握在手中。\n");
        set("unwield_msg","$N将君子刀霎时地插入刀鞘。\n");
          }
        init_blade(100);
        setup();
}
