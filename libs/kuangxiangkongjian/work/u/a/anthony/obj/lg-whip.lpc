#include <ansi.h>
#include <weapon.h>
inherit WHIP;
void create()
{
 set_name(HIR "炼蛊血鞭" NOR,({"lian-gu whip","lian-gu","whip"}));
 set_weight(3000);
 if( clonep() )
   set_default_object(__FILE__);
 else {
   set("unit","条");
   set("vaule","30000");
   set("material","iron");
   set("long","赤红般的外型，握柄上是一只毒蜈蚣，好似浸泡数载的毒鞭。\n");
     set("wield_msg","$N把炼蛊血鞭从腰间解下来握在手中。\n");
     set("unwield_msg","$N把手上的炼蛊血鞭收了起来。\n");
      }
 init_whip(70);
 setup();
}
