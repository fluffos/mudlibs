#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
     set_name(HIC "君子剑" NOR, ({"gentleman sword","sword"}));
     set_weight(7000);
     if( clonep() )
             set_default_object(__FILE__);
     else {
             set("unit","把");
             set("value",30000);
             set("material", "steel");
             set("long","这是一把由当代大儒宁采臣随身所佩带的宝剑。\n");
             set("wield_msg","$N‘唰’地一声抽出一把君子剑握在手中。\n");
             set("unwield_msg","$N将手中的君子剑插入腰间的剑鞘。\n");
     }
    init_sword(100);
     setup();
}
