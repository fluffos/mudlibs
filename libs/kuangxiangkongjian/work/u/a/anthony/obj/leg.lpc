  // candy.c

inherit F_FOOD;
inherit ITEM;

void create()
{
    set_name("牛肉面", ({ "noodle" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
       set("long", "牛肉面 \n");
          set("unit", "碗");
		set("value", 30);
		set("food_remaining", 4);
		set("food_supply", 40);
	}
	setup();
}

int finish_eat()
{
	set_name("啃得精光的鸡腿骨头", ({ "bone" }) );
	set_weight(150);
	set("long", "一根啃得精光的鸡腿骨头。\n");
	return 1;
}
