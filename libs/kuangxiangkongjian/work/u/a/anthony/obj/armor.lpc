#include <ansi.h>
inherit EQUIP;
void create()
{
       set_name(HIY "君子战衣" NOR,({"gentleman armor","armor"}));
       set_weight(10000);
       if( clonep() )
          set_default_object(__FILE__);
       else {
          set("unit","套");
          set("armor_type","armor");
          set("value",30000);
          set("material","blacksteel");
          set("armor_prop/armor",100);
          set("long","这是当代大儒宁采臣所著的宝衣。\n");
       }
       setup();
}
