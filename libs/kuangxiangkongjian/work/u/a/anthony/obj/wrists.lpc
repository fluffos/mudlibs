#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIY "君子玉环" NOR,({"gentleman wrists","wrists"}));
  set_weight(7000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit","件");
    set("long","这是由当代大儒宁采臣所佩带的手环。\n");
    set("material","jade");
    set("value",30000);
    set("armor_type","wrists");
    set("armor_prop/armor",100);
    set("armor_prop/dodge",100);
       }
  setup();
}
