inherit ROOM;
string kind;
void init() 

{
   add_action("account_check","balance") ;
   add_action("withdraw_money","withdraw"); 
   add_action("deposit_money","deposit");
   add_action("do_convert","convert");
}
						   
int account_check(string str)
{
 int gold, silver, coin;

 coin = this_player()->query("bank/coin"); 
 gold = (int) coin / 10000;
 coin = (int) coin % 10000;
 silver = (int) coin / 100;
 coin = (int) coin % 100;
 write(sprintf("\n您一共存了\n    %4d  锭黄金\n    %4d  两银子\n    %4d  文铜钱\n",
 gold, silver, coin), this_player());
 return 1;																		
}					
			
int withdraw_money(string arg)
{
   int amount;
   int value;
   object n_money;
                        
   if(!arg)
   return notify_fail("\nwithdraw <数量> <种类>\n");   
			
   if( !arg || sscanf(arg, "%d %s", amount, kind)!=2 )
   return 0;

   if( amount + this_player()->query_encumbrance() > this_player()->query_max_encumbrance() )
   return notify_fail("你拿不动那么重的钱。\n");
																											
   n_money = present(kind + "_money", this_player());
          
   if( !n_money && file_size("/obj/money/" + kind + ".lpc") < 0 )
   return notify_fail("你没有这种钱。\n");                      
							
   if( amount < 1 )		
   return notify_fail("你不能提这种数量的钱。\n");

   value = n_money ? n_money->query("base_value") : call_other("/obj/money/" + kind, "query", "base_value" );

   if(this_player()->query("bank/coin") < (amount*value))
   return notify_fail("你没有这么多钱\n");
   
   
   if( !n_money ) {
   n_money = new("/obj/money/" + kind);
   n_money->move(this_player());
   n_money->set_amount(amount);
   } 
   else
   n_money->set_amount(n_money->query_amount()+amount);    
						    
   this_player()->set("bank/coin", this_player()->query("bank/coin")-(amount*value));                                                                     
    write(sprintf("你一共提出%s%s%s\n",chinese_number(amount),n_money->query(
    "base_unit"),n_money->query("name")),this_player());
    			
    return 1;
} 
		
int deposit_money(string arg)
{
   int amount;
   object n_money, gold_money, silver_money, coin_money;
   int value, gold, silver, coin;
                        
   if(!arg)
   return notify_fail("\ndeposit <数量> <种类> || deposit all \n");   
							
   if( arg == "all" )
   {
   gold = 0; silver = 0; coin = 0;
   if( gold_money = present("gold_money", this_player()) )
   {
	gold = gold_money->query_amount();
	gold_money->set_amount(0);
   }
   if( silver_money = present("silver_money", this_player()) )
   {
        silver = silver_money->query_amount();
        silver_money->set_amount(0);
   }
   if( coin_money = present("coin_money", this_player()) )
   {
        coin = coin_money->query_amount();
        coin_money->set_amount(0);
   }
   value = gold * 10000 + silver * 100 + coin;
   this_player()->set("bank/coin",this_player()->query("bank/coin")+value);                                                                     
   write(sprintf("您一共存入 %d 锭黄金 %d 两银子 %d 文铜钱\n",
   gold, silver, coin), this_player());
   } else {

   if( !arg || sscanf(arg, "%d %s", amount, kind)!=2 )
   return 0;

   n_money = present(kind + "_money", this_player());
          
   if( !n_money && file_size("/obj/money/" + kind + ".lpc") < 0 )
   return notify_fail("你没有这种钱。\n");                      

   if(!n_money)
   return notify_fail("你没有这种钱\n");							
   
   if( amount < 1 )		
   return notify_fail("你不能存这种数量的钱。\n");
                
   if( n_money->query_amount() < amount)
   return notify_fail("你没有这么多钱\n");
   else
   n_money->set_amount(n_money->query_amount()-amount);    

   value = n_money ? n_money->query("base_value") : call_other("/obj/money/" + kind, "query", "base_value" );

   this_player()->set("bank/coin",this_player()->query("bank/coin")+(amount*value));                                                                     
   write(sprintf("你一共存入%s%s%s\n",chinese_number(amount),n_money->query(
   "base_unit"),n_money->query("name")),this_player());
   }    			
    return 1;
}
 																					  
int do_convert(string arg)
{											
   string from, to;
   int amount, bv1, bv2;
   object from_ob, to_ob;
   if( !arg || sscanf(arg, "%d %s to %s", amount, from, to)!=3 )
     return notify_fail("指令格式：convert <数量> <货币> to <货币>\n");
   from_ob = present(from + "_money", this_player());
   to_ob = present(to + "_money", this_player());
   if( !to_ob && file_size("/obj/money/" + to + ".lpc") < 0 )
     return notify_fail("你想兑换哪一种钱？\n");
   if( !from_ob )          
     return notify_fail("你身上没有这种货币。\n");
   if( amount < 1 )        
     return notify_fail("兑换货币一次至少要兑换一个。\n");
   if( (int)from_ob->query_amount() < amount )
     return notify_fail("你身上没有那么多" + from_ob->query("name") +".\n");
   bv1 = from_ob->query("base_value");
   if( !bv1 ) return notify_fail("这种东西不值钱。\n");
   bv2 = to_ob ? to_ob->query("base_value") : call_other("/obj/money/" + to
, "query", "base_value" );
   if( bv1 < bv2 ) amount -= amount % (bv2 / bv1);
   if( amount==0 ) return notify_fail("这些" + from_ob->query("name") + "的
价值太低了，换不起。\n");
   if( !to_ob ) {
     to_ob = new("/obj/money/" + to);
     to_ob->move(this_player());
     to_ob->set_amount(amount * bv1 / bv2);
     } else   to_ob->add_amount(amount * bv1 / bv2);
   message_vision( sprintf("$N从身上取出%s%s%s，换成%s%s%s。\n",        
   chinese_number(amount), from_ob->query("base_unit"), from_ob->query("name"),
   chinese_number(amount * bv1 / bv2), to_ob->query("base_unit"),to_ob->query("name")),
   this_player() );      
   from_ob->add_amount(-amount);
   return 1;
}    
