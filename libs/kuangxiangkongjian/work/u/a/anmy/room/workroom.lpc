#include <room.h>
inherit ROOM;

void create() {
  set("short", "马疑慈的马厩");
  set("long", "
这是一间十分干净的马厩，在这一共有八匹马，也就是八骏图中的那八匹。
牠们都是强壮的千里马，但牠们都不外售，因为牠们都是马疑慈私人饲养的马。
你可以清楚的听到牠们正发出声声的嘶呜声。
");

  set("light_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);

  setup();
}
