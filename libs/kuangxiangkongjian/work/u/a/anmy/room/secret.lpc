
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", HIC"古之殿堂"NOR);
	set("long", @LONG
在你眼前,忽然出现了一个殿堂,整个殿堂内都残缺不堪的,好像已经很久没有
人来过这里了。在殿堂的最里面有着一个石座,你仔细的看了一看上面似乎插
着一把剑(sword),里面不断散发着暗淡的光芒,让人有点发冷。


LONG
	);
	set("exits", ([
		"west" : __DIR__"road2",
	]));
	set("item_desc", ([
		"sword": "你看到了一把剑正插在石座上,不过似乎并不怎么起眼..。\n"
	]) );

	setup();
}

void init()
{
	add_action("do_take", "take");
}

void check_trigger()
{
	object room;

	if( (int)query("up_trigger")==6
	&&	(int)query("down_trigger")==6
	&&	!query("exits/down") ) {
		message("vision", "地板忽然出现一个魔法阵，地面不断的发出光，露出一个向下的光之道。\n",
			this_object() );
		set("exits/down", __DIR__"pray");
		if( room = find_object(__DIR__"pray") ) {
			room->set("exits/up", __FILE__);
			message("vision", "忽然发出强光，魔法阵再次的出现, 露出一个向上的光之道。\n",
				room );
		}
		delete("up_trigger");
		delete("down_trigger");
		call_out("close_passage", 10);
	}
}

void close_passage()
{
	object room;

	if( !query("exits/down") ) return;
	message("vision", 
"忽然发出强光，向下的光之道又消失了。\n",
		this_object() );
	if( room = find_object(__DIR__"pray") ) {
		room->delete("exits/up");
		message("vision", "魔法阵的光芒逐渐的暗淡下来,光之道也缓缓的消失在你眼前。\n",
			room );
	}
	delete("exits/down");
}


int do_take(string arg)
{
	string dir;

	if( !arg || arg=="" ) return 0;

	if( arg=="sword" ) {
		write("你试着摇动着这把破烂的剑，不过看起来一动也不动....\n");

		return 1;
	}
	if( sscanf(arg, "sword %s", dir)==1 ) {
		if( dir=="down" ) {
			message_vision("$N用力的将这把剑往下使劲...，不过看来你作了\虚\功\....。\n", 
this_player());
			add("down_trigger", 1);
			check_trigger();
			return 1;
		} else if( dir=="up" ) {
			message_vision("$N用力的将这把剑往上拔...，不过看来你作了\虚\功\....。\n", 
this_player());
			add("up_trigger", 1);
			check_trigger();
			return 1;
		} else {
			write("你要将剑怎么样呢....？\n");
			return 1;
		}
	}
}


void reset()
{
	::reset();
	delete("up_trigger");
	delete("down_trigger");
}
