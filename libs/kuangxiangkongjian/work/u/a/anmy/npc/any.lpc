inherit NPC;
#include <ansi.h>
void create()
{
      set_name("筱岚", ({ "any" }) );
	set("race", "人类");
        set("age", 19);
      set("gender", "女性");
      set("nickname",HIW"天使圣界"HIC"大天使长"NOR);
      set("title", "天使圣界第六十二代天使");
	set("long",
  "一个聪明灵巧的女孩,天资优异, 那灵巧的双眼 ,
让妳不禁感叹..真不\愧\是\天使圣界第一美女啊......
她似乎眉头深锁...可能有莫名的烦恼(trouble)喔....
");
     set("int", 30);
     set("per", 30);
     set_skill("unarmed", 70);
     set_skill("sword", 100);
     set_skill("dodge", 70);
     set_skill("parry", 80);
     set("max_gin", 3000);
     set("max_kee", 3000);
     set("max_sen", 3000);
 
     set( "inquiry", ([
          "name" : " 我是筱岚 , 请问有何指教..!!",
  ]) );
                              
	set("chat_chance", 2);
 	set("chat_msg", ({
               " 嗨,你们好呀.... ^_^\n"
}) );
		
	set("attitude", "friendly");
	set_temp("apply/attack", 100);
        set("combat_exp",3000000);
	setup();
        add_money("coin",1000);
   
}

