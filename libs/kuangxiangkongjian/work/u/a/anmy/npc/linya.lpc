// test.c
#include <ansi.h>
inherit NPC;

void create()
{
  set_name(HIC"天使 翎亚"NOR, ({ "angel-linya","linya","angel" }) );
           set("race", "人类");
           set("gender", "女性");
           set("age", 20);
        set("long",
             "一位天使圣界可爱的天使,她正在以迷人的笑容 \n"
             "对着你微笑着,让你有种亲切的感觉充满全身。 \n");

           set("str", 14);
           set("cor", 26);
           set("per", 35);
           set("combat_exp", 10000);
     set_skill("sword", 60);
     set_skill("dodge", 35);
     set_skill("parry", 30);
     set_skill("unarmed", 30);
     set_skill("dodge", 40);
     set_skill("parry", 30);

           set("limbs", ({ "头部", "身体", "胸部", "腹部" }) );
                   
           set("chat_chance", 8);
           set("chat_msg", ({
                   "翎亚对着你亲切的微笑。\n",
                  }) );
           set("attitude", "friendly");
           set_temp("apply/attack", 50);
           set_temp("apply/armor", 50);

        setup();
        add_money("coin", 500);
        add_money("silver", 2);

}
