inherit NPC;

void create() {
  set_name("周凯伦", ({ "kelen" }));
  set("race", "人类");
  set("age", 19);
  set("gender", "女性");
  set("nickname", "爱死小淫刀了");
  set("title", "天下第一美女");
  set("long",
    "一个还在念大学的女孩,灵活的双眼.,深情的眼眸...
让你不禁赞叹...真是天上少有,地上无双啊!...但你发现...
她似乎眉头深锁...可能有莫名的烦恼(trouble)喔....
");
  set("int", 30);
  set("per", 30);

  set_skill("dodge", 100);
  set_skill("blade", 100);
  set_skill("dodge", 100);

  set("inquiry", ([
    "name": " 小女子名曰:周凯伦",
    "here": " 笨蛋!...难道你看不出来...这里是小淫刀的家吗?",
    "trouble": " 小淫刀勒?...碰到他帮我跟他说我好想他
说要分手只是因为父母反对加上一时冲动...
现在很是后悔....一定要帮我喔!
",
  ]));

  set("chat_chance", 5);
  set("chat_msg", ({
    "小淫刀!你在哪ㄦ?..我找的你好苦啊!..\n"
  }));

  set("attitude", "friendly");
  set_temp("apply/attack", 30);
  set("combat_exp", 100);
  setup();
  add_money("gold", 150);
  add_money("silver", 139);
}
