// test.c

inherit NPC;

void create()
{
        set_name("卖艺师父", ({ "master" }) );
        set("race", "人类");
        set("age", 43);
        set("long", "一位四处卖艺的老人，向着你亲切的微笑着，苍老的脸上
                     隐隐约约带着一丝淡淡的哀愁\n");

        set("str", 24);
        set("cor", 26);

        set("limbs", ({ "头部", "身体" }) );
                   
set("chat_chance", 30);
        set("chat_msg", ({
                "卖艺师父用手拉了拉你袖子。\n",
                "卖艺师父对着你微笑，。\n",
                "卖艺师父翻了个跟斗。\n", 
                "卖艺师父大声喝道:来呦!!来呦..来看表演喔!!\n"
                }) );

        set_temp("apply/attack", 10);
        set_temp("apply/armor", 3);

        setup();
}

int accept_object(object who, object ob)
{
        if( ob->id("gold") ) {
                // set_leader(who);
                message("vision", name() + "以感激的眼光看着你。\n", environment
());
                return 1;
        }
        else {
          say ("我人穷志不穷, 不是金子我不要。\n");
          return 1;
        }
}
