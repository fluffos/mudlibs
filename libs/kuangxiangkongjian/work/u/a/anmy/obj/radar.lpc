//OBJ : /u/s/sometime/obj/bom.c

#include <ansi.h>

inherit ITEM;

void create()
{
       set_name(HIW"投币式"HIY"杀手卫星连线器"NOR, ({ "radar", } ));
       set("long","杀手卫星连线器, 上面写着, 每次使用费 10 两黄金。\n"
       "使用方法 shut <目标>\n");
       
       set("unit","台");
       set("weight", 10000000);
       set("no_get", 1);
}

void init()
{
       add_action("do_aim","shut");
}
int do_aim(string arg)
{
        mixed all;
        object who,room,obj,me,value,n_money;
        int i;
//        int amount;
//        int value;
        
        if(!arg) return notify_fail("瞄准谁？ aim who?\n");
        me = this_player();
        me->set("tt",100000);
//        value=(int)me->query("tt") - me->query("ttt")
        if(me->query("bank/coin") < me->query("tt") )
                 return notify_fail("你银行帐户的钱不够。\n");
//        value = n_money ? n_money->query("base_value") : call_other("/obj/money/" + kind, "query", "base_value" );
//        this_player()->set("bank/coin", this_player()->query("bank/coin")-(amount*value));
        me->set("bank/coin",me->query("bank/coin")-me->query("tt"));
//        write("杀手卫星自动从你的帐户扣除使用费。\n);
        message_vision(HIY"杀手卫星自动从$N的帐户扣除使用费。...\n"NOR,
                           this_player());
                                                  
        me->set("tt",0);
//        who = find_player(arg);
//        if(!who) who = find_living(arg);
//        else who = this_player();
//        room = environment(who);
//        all = all_inventory(room);
//        if(!arg) return notify_fail("瞄准谁？ aim who?\n");
        who = find_player(arg);
        if(!who) who = find_living(arg);
        room = environment(who);
        all = all_inventory(room);
        for( i = 0 ; i < sizeof(all) ; i++)
        {
        obj = all[i];
        obj->add("kee", -random(50));
        }
                                                                
//        for( i = 0 ; i < sizeof(all) ; i++)
//        {
//        obj = all[i];
        obj->add("kee", -random(25));
//        }  
        message_vision(HIY"\n$N向杀手卫星下了攻击"+ who->query("name") +"的指令。\n\n"
        "连线器动了几下显示出, 任务完成。\n\n"NOR,
        this_player());
        tell_room(environment(who),
        HIC"突然天空上的杀手卫星向"+ who->query("name") +"射出死光.....\n\n"
           "听见一声爆炸声响....所有的人都受伤了...\n\n"
        RED"现场惨不忍赌...\n\n"NOR
           "天上掉下一张纸条, 上面写着,\n ‘收据, 兹收到"HIY+ me->query("name") +NOR"攻击"HIY+ who->query("name") +NOR"之费用10两黄金, 此据。’\n\n"
        );
        if( obj->query("kee") <= 0 ) obj->unconcious();
        if( obj->query("kee") <= 0 ) obj->add("kee",10000);
        return 1;

}
