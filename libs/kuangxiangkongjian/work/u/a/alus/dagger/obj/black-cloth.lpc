// ph_hat.c
#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(BLK "乌金丝衣" NOR, ({ "Black cloth", "cloth" }));
  set_weight(2000);
  set("armor_type", "cloth");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 100000);
    set("material", "cloth");
    set("armor_prop/armor", 50);
    set("armor_prop/dodge", -5);
    set("armor_prop/move", -10);
  }
  setup();
}
