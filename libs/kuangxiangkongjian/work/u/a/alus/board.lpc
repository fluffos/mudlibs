// cgyboard.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIC "雅露思的工作室留言板" NOR, ({ "board" }));
  set("location", "/u/a/alus/workroom");
  set("board_id", "cgyboard");
  set("long", HIC "这是记事留言与交朋友板！ \n" NOR);
  setup();
  set("capacity", 50);
  set("master", ({ "alus" }));
}
string query_save_file() {
  return "/u/a/alus/" + query("board_id");
}
