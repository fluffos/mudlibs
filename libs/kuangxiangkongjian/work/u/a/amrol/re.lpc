//  Cage的工作室，亦为自定door函数范例档

#include <mudlib.h>
#include "/u/c/cage/lib/cage.h"
#include "/u/c/cage/lib/door.h"

inherit ROOM;

void reset()        //设定reborn时应还原的状态，如门锁住，钥匙reborn等等
{
  ::reset();
  set("door/east/status" ,DOOR_LOCK);       //reboen时门自动回复上锁
  delete("exits/east");                     //关闭该门所在的出口
  set("key",1);
  _ROOM"bedroom.lpc"->set("door/west/status" ,DOOR_LOCK);
  _ROOM"bedroom.lpc"->delete("exits/west");   //另外在门后的另外一个房间也应
}                                           //相对着改变。
                                            //reborn只需要在其中一个房间
                                            //定义即可，此时另一个房间的
                                            //reborn就会与此方间一致

void create ()
{
  set ("short", "阿獠待客室");
  set ("long", @LONG
  这是一个约四坪大的房间，不但兼具客厅、餐厅的功能，也是阿獠用来待客、
  接生意的地方。客厅除了中央有个大餐桌外，只剩角落还摆着一个廉价的木柜，上
  面放着一台十四寸彩色电视，可见阿獠的经济情况并不是很好。既使如此整个房间
  依旧打扫得一尘不染。也许这房子有个十分精明的女主人在管理也说不定。
      在墙上有个小黑板，上面写着十分潦草的字，远看之下你无法看出上面到底写
  了些什么，但是你辨识出最前面的三个大字Ｘ Ｙ Ｚ………
LONG);

  set("light_up",1);
  set("exits", ([ /* sizeof() == 5 */
  "bcat" : "/u/b/bigcat/workroom",
  "down" : _ROOM"baseroom1.lpc",
  "ent" : "/open/wiz/entrance",
  "bolo" : "/u/w/wade/workroom",
  "lum" : "/u/l/lum/workroom",
  ]));
  set("valid_startroom", 1);
  set("door/east",([                     //设定门所在之出口，此出口不能在exits
      "name" : "木门",                   //中定义。
      "connect" : _ROOM"bedroom.lpc",      //name与connect为该门的名字与连结之
      "relation" : "west",               //房间。relation为该connect方间door
      "status" : DOOR_LOCK,              //所在之出口，如果你想要做单向门的话
                                         //这个变数可以不设。status为门的状态
      "picklv" : 10,                     //picklv为此门之开锁难易度，以后可
                                         //能会写些开锁的东西，故保留此变数
      "lock" : "这个木门是锁着的，本来没这个门的啊，该不会里面放了什么东西\n"+
               "你决定潜入一探究竟………不过你得先开门啊！\n"+
               "钥匙？对了钥匙到底藏在哪儿呢？\n",
                                         //此为当门为lock时，此门的describe
      "close" : "哈哈哈！门锁终于开了吧，快打开进去看看。\n",
                                         //此门为close时之describe档。
      "open" : "这个木门是开着的！\n",   //此门为open的之describe
      "key" : "cage_workroom_east",      //以上三个若没设定则可用函数内定值
      ]));                               //key为此门的mark,只有flag为此值的
                                         //钥匙才可以开此门(开锁不在此限)
  set("key",1);
  set("objects", ([ /* sizeof() == 1 */
    _MOB"kawali" : 1,
    ]));
    
  setup();
  call_other(_CAGE"board/cage_b.lpc","????");
}


void init() 
{
  add_action("search_door" ,"search");
  add_action("handle_look" ,"look");
  add_action("handle_look" ,"l");
  add_action("handle_open" ,"open");
  add_action("handle_close","close");
}
    
int search_door(string str) 
{
  int have_key;
  have_key = (int)this_object()->query("key");
  if(str == "door")
  {
    if( have_key )
    {
      write("你在门四周找呀找的，结果在门上的横木上找到一张电话卡。
             哇，赚到了！\n"+
            "但是当你注意到这张电话上的记号之后~~~  干！用完的。\n");
      new(_OBJ"card.lpc")->move(this_player());
      this_object()->set("key",0);
    }
    else write("你在门边寻找，发现门上横木上的灰尘比其他地方少。\n"+
                "你判断不久前一定有人在此拿走什么东西。\n");
    return 1;
  }
  else return 0;
}    

int handle_look(string str)        //如果你在look,open,close有特殊的设计的话
{                                  //可利用handle函数来做处理，
 return (look_door("east",str));   //最后别忘了把library的函数用进来
}                                  //一般library的function的第一个参数应该
                                   //要先做判断，其中dir应该算是该door在此
int handle_open(string str)        //房间的"识别证"，在此例中，因为房间中只
{                                  //有一个door所以要开关门一定是east，不
 return (open_door("east",str));   //会错，在两个以上时，你就必需自行判断对
}                                  //哪个门动作。
 
int handle_close(string str)
{
 return (close_door("east",str));
}
