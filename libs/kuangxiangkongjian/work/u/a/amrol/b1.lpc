// sword.c : an example weapon

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
  object user;
  object *target;
  int sp_time=0; 
  int l=0;
  string sp_message = " 真气指数 ";
  string start_message = "【 ";
  string end_message = " 】\n";
void create()
{
	set_name("古锈剑",({"old sword","sword"}));
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("no_drop",1);
		set("long","一把年代久远的锈剑。\n");
	/*	set("value",1000);	*/
		set("material", "gold");
		set("no_sell",1);
		set("no_give",1);
		set("no_auc",1);
		set("wield_msg", "$N「唰”地一声抽出一把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
	}
	init_sword(10);
	setup();
}

void init()
{
add_action("do_team","team");
add_action("slash_flower","slash");
add_action("do_check","check");
}

int do_check()
{

      tell_object(user,"\n你暗运真气于丹田已经     "+HIY+l+NOR+"   之久..\n");
         
      tell_object(user,"\n\n\n"+start_message+HIR+sp_message+NOR+end_message);
      return 1;
}       
int do_team(string arg)
{
  string item,targ;
  if( !arg ) 
  {
    return 0;
   } 
  if( sscanf(arg, "form %s", targ)==1 )
  {
    if(targ!="sha-array")
    {
     write("你要施展什么\n");
     return 1;
     }
     else
     {
     set_heart_beat(1);
     user=this_player();
     user->set_temp("use_sha-array",1);
     sp_message = " 真气指数 ";
     sp_time=0;
  l=0;
     return 0;
     }
   }
  return 0;
 }
 int slash_flower(string str)
 {
   int sp_level;
   int sp_hit;
   int i;
   sp_level=(int)sp_time/10;
   sp_hit = user->query_skill("sha-array",1)+100;
   if( !(user->is_fighting() && user->query_temp("use_sha-array",1)) )
     {
      message_vision("此招式乃在剑阵中对付敌人之决招 ,平时是无法施展的\n",user);
      return 1;
      }
    if( str!="flower")
      {
       message_vision("你要施展什么大决招??\n",user);
       return 1;
       }
    if(sp_level < 1 )
    {
      message_vision(HIG+"$N真气尚未凝聚完全 ,无法使出大决招\n"+NOR,user);
      return 1;
    }  
    else if( sp_level ==1 )
     {
      
      message_vision(HIR+"你祭起神剑 ,天空突然闪下一道闪电击中$N\n"+NOR,target[i]);
      sp_time = sp_time-5;
      target[i]->add("kee",-sp_hit);
      return 1;
      } 
    else if(sp_level >1) 
     {
      message_vision(HIR+"$N运尽全身真气于剑上 ,只见$N手中长剑嗡嗡作响 ,朝敌人射去\n"+NOR,user);  
      target[i]->add("kee",-sp_hit);
      sp_time=sp_time-10;
       return 1;
     }
       
 return 1;
 }     
 void heart_beat()
 {
  int number,i,k,a;
  int max_sp_time;
  int j=0;  
  string max_sp_message="真气指数 ";
  max_sp_time = (int)user->query_skill("sha-array",1)/3;
  for( j=0;j<sp_time;j++)
     max_sp_message = max_sp_message+"〉";
  target=user->query_enemy();
  number=sizeof(user->query_team());
 if(user->is_fighting()&& user->query_temp("use_sha-array",1) )
  {
   if(number==2)
   {
     if(random(100)>80)
     {
      message_vision(HIY+"两仪剑阵如行云流水 ,生生不息 ,$N困于其中已渐渐迷失了自己\n"+NOR ,target[i]);
      target[i]->start_busy(2);
      }
      a=random(2)+(int)(user->query_skill("sha-array",1)+user->query_skill("array",1)+
      user->query("cps",1))/20;
      l=l+1;
      for(k=0;k<a;k++)
     { 
       sp_message = sp_message + "〉";
        sp_time=sp_time+1;
        }
      if( sp_time > max_sp_time )
     {
      sp_time = max_sp_time;
      sp_message = max_sp_message;
     }
   }
   else if(number==4)
      {
       if(random(100) > 80)
       {
       message_vision(HIR+"四象剑阵内有如千军万马 ,登时吓的$N魂不附体 ,无法对你攻击\n"+NOR,target[i]);
       target[i]->start_busy(4);
       }
        a=random(2)+(int)(user->query_skill("sha-array",1)+user->query_skill("array",1)+
        user->query("cps",1))/10;
        l=l+1;
        for(k=0; k<a;k++)
        {
           sp_message = sp_message + "〉";
           sp_time=sp_time+1;
         }
        if( sp_time > max_sp_time )
         {
           sp_time = max_sp_time;
           sp_message= max_sp_message;
         }
       }
                            
   else if(number==8)
      {
       if(random(100) > 80)
       {
       message_vision(HIY+"八卦游龙引动九天九地之气 ,刹时金光万丈 ,使得$N妖气顿减 ,无法动弹\n"+NOR,target[i]);
       target[i]->start_busy(4);
       }
       l=l+1;
       
       a=random(2)+(int)(user->query_skill("sha-array",1)+user->query_skill("array",1)+
       user->query("cps",1))/5;
       for(k=0; k<a;k++)
       {
        sp_message = sp_message + "〉";
        sp_time=sp_time+1;
        }
       if( sp_time > max_sp_time )
        {
            sp_time = max_sp_time;
            sp_message=max_sp_message;
        }
     }
  }
  
   return;  
  }            
  int query_autoload()
  {
  return 1;
  }
