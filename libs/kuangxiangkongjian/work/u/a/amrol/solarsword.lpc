#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void bleed(object me, object victim, object weapon, int damage);
void block(object me, object victim, object weapon, int damage);

mapping *action = ({
  ([
    "damage_type": "削肉断骨之伤",
    "action": "$w带动$N的手势如狂龙般的往$n的$l猛刺
 ,这乃是失传已久的霸皇剑式之一式 -‘狂龙破心’",
    "dodge": 150,
    "parry": 190,
    "damage": 1125,
    "post_action": (: call_other, __FILE__, "block" :),
  ]),
  ([
    "action": "$N手中的$w呼然灵动无比 ,急旋下现出一条 紫色的长鞭分朝四面八方攻击 ,一招   ‘龙击虎’企图把$n的$l劲穿出一个窟隆",
    "damage_type": "深可透体的重伤 ",
    "dodge": 200,
    "parry": 300,
    "damage": 1000,
    "post_action": (: call_other, __FILE__, "bleeding" :),
  ]),
});


void create() {
  set_name(HIR "月风魔剑" NOR, ({ "sword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("attitude", "killer");
    set("long",
      "这柄剑光碰触剑鞘上即隐隐的让你感到了一股寒气 ,让你不禁打了一阵寒颤 ,\n"
      "剑鞘已经破烂不堪 ,是一把古剑 .但是当你握到剑把时 ,乎然感觉内心起了 \n"
      "一阵阵的撕裂感 ,神智渐渐的陷入了难以自持的状态 .\n");
    set("value", 0);
    set("material", "crimsonsteel");
    set("wield_msg", "$N抽出了这把古剑 ,两眼瞬时红了起来 .\n");
    set("unwield_msg", "$N把这把古剑收回了破烂的剑鞘 ,$N的理智又慢慢的恢复了 \n");
  }
  init_sword(30);
  set("actions", (: __FILE__, "query_action" :));
  setup();
}

varargs mapping query_action() {
  return action[random(sizeof(action))];
}

void block(object me, object victim, object weapon, int damage) {
  if (damage > 150) {
    victim->start_busy(random((int)me->query_skill("sword", 1) / 20 + 2));
    message_vision(
      HIY "惊世魔剑带动$N的手 ,使出了失传的霸皇剑式‘万魔缠身’ -从剑身上呼然射出一道动人紫光 ,紫光呼然绕射狂卷 ,把$n给紧紧的束住了 ! " NOR,
      me,
      victim
    );
  }
}

void bleed(object me, object victim, object weapon, int damage) {
  int cond;

  if (damage > 210) {
    cond = victim->query_condition("bleeding");
    cond += random(me->query_skill("sword", 1) / 10);
    victim->apply_condition("bleeding", cond);
    message_vision(HIR "惊世魔剑带动$N的手使出了失传的霸皇剑式‘奔雷七紫电’
-魔剑狂气化为七道紫光气劲疾射出 ,剑气如奔雷 ,如闪电般的打穿了$n七处气门 !\n" NOR, me, victim);
  }
}
