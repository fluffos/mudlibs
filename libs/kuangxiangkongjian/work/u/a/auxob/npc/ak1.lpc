#include <command.h>

inherit NPC;

void create()
{
    set_name("仆人一号",({"ak"}));
    set("title", "auxob直属");
    set("gender", "男性");
    set("age",20);
    set("attitude","friendly");
    set("long",@LONG
他是auxob专用的仆人,全身穿的破破烂烂的.
LONG);

    set("combat_exp",1);
    set("str",30);
    set("con",20);
    set("int",30);
    set("per",40);
    set("cps",30);
    set("kar",30);
    set("force",10000);
    set("max_force",10000);
    set("max_kee",100);
    set("limbs",({"头","手","脚","背","腹","腰"}));
    set("chat_chance",15);
    set("chat_msg",({
    "仆人一号帮你脱鞋\n"+
    "仆人一号帮你洗脚脚\n"+
    "仆人一号帮你抓龙\n"}));

    setup();
    carry_object("/u/a/auxob/blade/lion-blade");
}
void greeting(object who)
{
     if( (who->query("id") == "auxob") && (who->query("name")=="魔刀人"))
     {
        command("bow "+who->query("name"));
        command("say "+who->query("name")+"主人你好  :)");
        command("say "+who->query("name")+"让小的来服伺你 :>");
     }
     else
     {
      command("say 欢迎你到魔刀工作室来 :) ");
     }
 return;
}
