inherit NPC;

void create()
{
          set_name("多多龙",({"totoro"}) );
          set("long","");

          set("nickname","小可爱");
          set("title","刀狂的宠物");

          set("age",10);
          set("int",20);
          set("cps",20);
          set("str",20);
          set("cor",20);
          set("spi",20);
          set("con",20);
          set("kar",20);
          set("per",20);
          set("force",10000);
          set("combat_exp",40000);
          set("max_force",10000);
          set("race","野兽");
          set("gender","男性");
          set("max_kee",100);
          set("limbs",({"头","手","脚","背","腹","腰"}) );
          set("attitude","friendly");
          set("chat_chance",15);
          set("chat_msg",({
          "多多龙绕着你身边跑来跑去\n"+
          "你深怕一不小心踩着了它\n",
          "多多龙仰着头呆呆的望着你\n"+
          "你从它的眼神看出它似乎须要你的爱\n"}));

    setup();
}
