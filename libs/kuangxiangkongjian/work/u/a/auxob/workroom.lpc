#include <room.h>

inherit ROOM;

void create() {
  set("short", "魔刀工作室");
  set("long", "这是一间魔刀门编辑室,右边墙角放着一把狮头宝刀(lion blade)
   和一把鱼龙宝刀(fish blade),房间的正中间放着一张桌子和椅子,桌子上有一盏
   暗暗的台灯和一堆散乱的纸
   张\n");
  set("exits", ([
    "down": "/open/snow/room/secret",
    "wiz": "/open/wiz/hall1",
  ]));
  set("light_up", 1);
  set("valid_startroom", 1);
  set("objects", ([
    "/u/a/auxob/blade/lion-blade": 1,
    "/u/a/auxob/blade/fish-blade": 1,
    "/u/a/auxob/npc/ak1.lpc": 1,
    "/u/a/auxob/npc/auxob1.lpc": 1,
  ]));
  setup();
}
