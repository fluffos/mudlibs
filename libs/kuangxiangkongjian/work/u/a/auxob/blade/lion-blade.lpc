#include <weapon.h>
#include <ansi.h>


inherit BLADE;
void create() {
  seteuid(getuid());
  set_name(HIB "狮头宝刀" NOR, ({ "lion blade", "blade" }));
  set_weight(13000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把沉重的巨刀 ,刀柄的末端是一个栩栩如生一个狮头.\n");
    set("value", 10000);
    set("material", "blacksteel");
    set("wield_msg", "$N从背后抽出$n,顿时全身充满力量。\n");
    set("unwield_msg", "$N将手中$n放回背上的刀囊中。\n");
  }
  init_blade(80);
  setup();
}
