#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIM "小猫咪" NOR, ({ "bellcat" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "一只挂着铃当的小花猫!!\n");
  set("str", 20);
  set("cor", 17);
  set("combat_exp", 20000);
  set("score", 20000);
  set("dodge", 100);
  set("attitude", "friendly");
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set_temp("armor", 10);
  set("chat_chance", 4);
  set("chat_msg", ({ (: this_object(), "random_move" :),
    "叮当睁大眼晴喵呀喵呀的望着你。\n",
    "小猫咪用舌头舔舔自己的身体。\n",
    "小猫咪不停的叫.......原来是肚子饿了!\n",
  }));
  setup();
}
