#include <ansi.h>
  inherit NPC;
 
  void create()
 {
  set_name( HIC "护卫" NOR , ({"guard"}));
  set("long"," 一位身长八尺孔武有力的壮汉,他是风云专属的保镖,请不要招惹他。");
 
 set("gender","男性");
 set("attitude","peaceful");
 set("age",25);
 set("score",250000);
 set("combat_exp",100000);
 set("str",30);
 set("int",30);
 set("cor",30);
 set("cps",30);
 set("per",30);
 set("kar",30);
 set("spi",30);
 set("max_gin",3000);
 set("max_kee",3000);
 set("max_sen",3000);
 set("force",1000);
 set("force_factor",100);
 set("max_force",1000);
 setup();
 carry_object("/u/q/quit/obj/super.lpc")->wear();
 set("chat_chance",2);
 set("chat_msg",({"这里没有开放给外人参观,赶快离开这个地方。\n",
                  "护卫用异样的眼光打量你一番,使你感到不自在。\n",
                 }));
 }
