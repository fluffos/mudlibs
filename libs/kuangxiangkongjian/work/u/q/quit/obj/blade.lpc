#include <weapon.h>
inherit BLADE;
#include <ansi.h>
void create()
{
set_name( MAG "雪饮" NOR,({"windy blade","blade"}));
 set_weight(1000);
 if ( clonep() )
      set_default_object(__FILE__);
else {
      set ("unit","柄");
      set("value",10000);
set("material","crimasonsteel");
set("armor_prop/blade",10);
}
set("long","这是一把传说中封卬的刀,带有强大的刹气,不是一般人
能使用的。\n");
 set("wield_msg",HIR"$N突然觉得手头一重,一股寒气由手心传入。\n"NOR);
 set("unwield_msg",HIR"$N突然觉得手头一轻,寒意全无了。\n"NOR);
init_blade(9999);
setup();
}
