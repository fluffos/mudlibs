//ice.c by oyuki
#include <mudlib.h>
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIW + " [D苍白火焰的愤怒" + NOR, ({ "ice" }));
  set("long",
    "这是阿雪生气时会用来制裁对方的冰雪攻击. \n");
  set_weight(1);
  set("unit", "根");
  seteuid(getuid());
}

void init() {
  add_action("fire", "ice");
}

int query_auto_load() {
  return 1;
}

int fire(string str) {
  object target, targetenv;
  int gin1, kee1, sen1;

  if ((string)this_player()->query("id") != "oyuki")
    return notify_fail("这不是你用的魔法!!\n");
  if (!str || str == "") {
    write(HIW "阿雪浑身散发出寒气,瞬间空气中的水份冻结!!!!\n" NOR);
    tell_room(environment(this_player()), HIC + this_player()->query("name")
      +HIW "释放出大量寒气[C瞬间将你冰冻!!\n" NOR,
      ({ this_object(), this_player() }));
    return 1;
  }
  target = present(str, environment(this_player()));
  if (!target) target = find_living(str);
  if (!target) {
    write(HIY "看清楚在用冰柱伤人...OK??\n" NOR);
    return 1;
  }
  targetenv = environment(target);


  if (target != this_player())
    write(HIW "如果事情真是这样...\n"
      "那这下可就没完没了了....\n");
  else {
    write("想自杀？用 suicide -f 比较快啦！\n");
    return 1;
  }

  tell_room(environment(this_player()), "" + HIC
    +(string)this_player()->query("name")
    +HIW "将手中冻住的冰柱向" HIC + (string)target->query("name")
    +HIW "射去!!你的眼前闪过一片白光!! \n" NOR, ({ this_player(), target }));

  tell_room(environment(target), HIW "忽然有人用冰柱向" HIC
    +(string)target->query("name") + HIW "攻击, 瞬间" HIC
    +(string)target->query("name") + HIW "无法动弹 ! \n" NOR,
    ({ this_player(), target }));

  tell_object(target,
    HIW "突然数不清的冰柱猛烈向你刺来!!\n" NOR +
    "( 你" RED "受伤过重, 已经有如风中残烛, 随时都可能断气．)\n" NOR);
  return 1;
}
