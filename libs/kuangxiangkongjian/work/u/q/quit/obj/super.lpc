#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create()
{
    set_name( HIC "风云圣衣" NOR , ({"windy cloth","cloth"}));
    set("long","一件看起有如云朵般柔的衣服,可是别小看它喔,可是传说中的圣物。\n");
    set_weight(100);
    if( clonep() )
            set_default_object(__FILE__);
    else {
           set("unit","件");
           set("value",10000);
           set("material","cloth");
set("armor_type","cloth");
set("armor_prop/armor",9999);
           set("armor_prop/parry",10);
           set("armor_prop/move",10);
           set("armor_prop/dodge",10);
   }
   set("wear_msg",HIC"$N感觉身体轻飘飘的,仿佛整个人都要飞起来似的。\n"NOR);
   set("remove_msg",HIC"$N摆衣服脱了下来,感觉整个人非常沈重。\n"NOR);
   setup();
}
