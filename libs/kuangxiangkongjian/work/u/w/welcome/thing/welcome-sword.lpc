// sword.c : an example weapon
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
	seteuid(getuid());
        set_name(HIB "气浩然" HIB,({"welcome sword","sword"}));
        set_weight(0);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
        set("long","看来并无奇特之处,却给人一种深刻的印像.剑柄泛出蓝色,可是没有 剑身. 。\n");
		set("value",10000);
		set("material", "steel");
       set("wield_msg", "$N突然间,只觉力量从全身聚集于右手,形成了一把属于自己的 
剑. 。\n");
        set("unwield_msg", "$N由右手充入一股亲切而壮大的气,仿佛重生.剑身也在此刻
消于眼前. 。\n");
	}
        init_sword(200);
	setup();
}
