// made by ccat....futzao 修改
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("筋斗云", ({ "cloud" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "朵");
set("long",@LONG

    
      现今提供的各传点: 1. 京城市中   2. 蜀中市中   3. 平南市中
                        4. 中央驿站   5. 陵云村     6. 您的游戏进入点
                        7. <set by u> 8. <set by u> 9. <set by u>
                        
LONG                        
               );
                set("value", 1000);
		set("no_drop",1);
		set("light",1);
        }
}
int query_autoload()
{ return 1; }

void init()
{
        add_action("do_flyset", "flyset");
        add_action("do_flyshow", "flyshow");
        add_action("do_fly", "fly");
}

int do_flyset(string arg)
{
    int no_transmit;
    string str,str_s;
    object me,where;
    if( (arg != "7") && (arg != "8") && (arg != "9") )
    {
      write("你只能设定传送点 7,8,9...\n");
      return 1;
    }  
    me = this_player();
    where = environment(me);
    no_transmit = where->query("no_transmit",1);
    if(no_transmit)
    {
     write("一阵强大的磁场从地底传出,干扰了你的设定,\n");
     write("似乎这里的大神不愿此地可以传送...\n");
     return 1;
    }
    str_s = where->query("short");
    str=file_name(where);
    if( arg == "7")
    {
      me->set_temp("fan/7",str);
      me->set_temp("fan_s/7",str_s);
    }  
    if( arg == "8")
    { 
      me->set_temp("fan/8",str);
      me->set_temp("fan_s/8",str_s);
    }  
    if( arg == "9")
    {
      me->set_temp("fan/9",str);
      me->set_temp("fan_s/9",str_s);
    }  
    write("你设定这里为你的新传送点.\n");
    return 1;
}
int do_flyshow(string arg)
{
    object me;
    string str_s;
    me = this_player();
    str_s = me->query_temp("fan_s/7");
    printf("传送点 7 是%s.\n",str_s);
    str_s = me->query_temp("fan_s/8");
    printf("传送点 8 是%s.\n",str_s);
    str_s = me->query_temp("fan_s/9");
    printf("传送点 9 是%s.\n",str_s);
    return 1;
}         
int do_fly(string arg)
{ 
    int money,no_transmit;
    object me;
    string startroom;
    me = this_player();
    no_transmit = environment(me)->query("no_transmit",1);
    if(no_transmit)
    {
       write("突然一阵能量从地底发出,击散了你招来的云朵,\n");
       write("似乎这里的大神不愿此地可以传送...\n");
       return 1;
    }
    message_vision( HIY+"只见你大喊一声筋斗云就陇罩着$N\n"+NOR ,me);   
    switch(arg)
    {
       case "1":
         me->move("/open/capital/room/r70");
         break;
       case "2":
         me->move("/open/gsword/room/su3");
         break;
       case "3":
         me->move("/open/ping/room/road4");
         break;
       case "4":
         me->move("/open/center/room/inn");
         break;
       case "5":
         me->move("/open/start/room/s5");
         break;
       case "6":
       case "7":
       case "8":
       case "9":
         if(arg == "6") startroom = me->query("startroom");
         if(arg == "7") startroom = me->query_temp("fan/7");
         if(arg == "8") startroom = me->query_temp("fan/8");
         if(arg == "9") startroom = me->query_temp("fan/9");
         if( !startroom ) 
         {
//            write("筋斗云说: 请你想清楚...\n");
            return 1;
         }        
         me->move(startroom);
         break;
       default:
//         write(" 筋斗云说: 请你想清楚...\n");
         return 1;
     } 
     message_vision(HIY+"忽然看到一朵白云放下$N\n"+NOR,me);
     return 1;
}

