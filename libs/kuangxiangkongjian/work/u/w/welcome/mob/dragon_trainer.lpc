#include <ansi.h>

inherit NPC;
  inherit F_MASTER;
void create()
{
        set_name("赐育",({"dragon_trainer","trainer"}));
		set("gender","男性");
           set("title","乌龙院 技师");
        set("combat_exp",400000);

          set("attitude","heroism");
          set("age",30);
                 set("str", 50);
                set("cor", 40);
                 set("cps", 20);
		set("per", 24);
                    set("int", 40);
            set("force",900);
           set_skill("parry",55);
           set("max_force",800);
	set("inquiry",([
                "院长" : "院长 听说他是安心屋主人的好朋友喔,也许他知道如何进入传说中的安心屋。\n",
                "安心屋" : "这我就不知道了,你去问院长,他也许会告诉你吧。\n",
                ]));
       set("chat_chance",20);
          set("chat_msg",({
                            "赐育说道:我院长最好了 ，都不会以大欺小。\n",
                          "赐育说道:听说院长和安心屋的主人相当有交情喔。\n",
                          "赐育挥出一拳，连在旁边的你都能感到他的力道不凡。\n",
                          "赐育说道:听说安心屋里面有很多神兵利器喔，不过都没知道 如和进去。\n",
                      }) );




            set("force_factor",40);
            set_skill("force",50);
          set_skill("unarmed",60);
            set_skill("snowforce",50);
           map_skill("force","snowforce");
              set_skill("snow-martial",75);
             map_skill("unarmed","snow-martial");
        set_skill("black-steps",70);
	map_skill("dodge","black-steps");
	setup();
}

