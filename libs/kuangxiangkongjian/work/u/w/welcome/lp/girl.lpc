// /open/center/npc/vendor.c
#include <obj.h>
#include "/open/open.h"

inherit F_VENDOR;
nosave int reboot_time = 0;

void create()
{
        set_name("卖火材的小女孩", ({ "sale girl", "girl" }) );
        set("nickname","苦命花");
        set("gender", "女性" );
        set("age", 12);
        set("long", @LONG
这是一位有着碧发蓝睛的卖火材的小女孩，由于她无家可归，外加肤色有
异于寻常人，因此经常被路过的有钱大爷欺负。她至今最大的心愿是在这寒冷
的冬天有一件衣服穿，如果你能完成她的心愿，说不定她愿意以身相许哩。在
这儿，你可以可怜可怜她，给她点钱，或者跟她买买东西，施恩不望报的，不
是吗? 再说，她也没东西好回报给你的，除了一身骨瘦如材的身子。
LONG);
        set("attitude", "friendly");
        set("rank_info/respect", "小妹妹");
        set("combat_exp",180);

        set("vendor_goods", ({
            CENTER_OBJ"torch",
            CENTER_OBJ"map",
        }) );
        set("no_kill",1);

        set("chat_msg", 5);
        set("chat_msg", ({
            "小女孩说道: 谁能给我衣服穿啊，好冷耶。\n",
            "小女孩拉拉你的衣服说道: 您能给我一件一服吗?\n",
            "小女孩可怜兮兮的说道: 冬令救济一下嘛!。\n",
        }) );

        set("greeting_msg", ({
            "小女孩说道: 好心的大爷小姐们，买把木头当材烧吧。\n",
            "小女孩可怜兮兮的瞧着你: 这位好心的大爷小姐，伸伸援手救助我吧。\n",
            "小女孩有气无力的说: 好心的大爷小姐，路过此地，难道见死不救吗?\n",
        }) );
        setup();
}

int accept_object(object who, object ob)
{      
  object        me;

  seteuid(getuid());
  me = this_object();

  if (who->query("quests/sale_girl") == 0) {
    message_vision("小女孩说道: 谢谢$N赏赐。妹妹我无以为报，卖得的一百文钱"
        "以及卖剩的一把木头跟一张地图就当成回报，请您笑纳。\n",who);
    who->pay_player(100);
    who->set("quests/sale_girl",1);
    new(CENTER_OBJ"torch")->move(who);
    new(CENTER_OBJ"map")->move(who);
    who->save();
    return 1;
  }
  else {
    message_vision("小女孩说道: 谢谢$N赏赐。\n",who);
    return 1;
  }
}                                                                       

void heart_beat()
{
        object npc;

        if( reboot_time < 32000 ) reboot_time++;
        else {
            reboot_time = 0;
            npc = new(NPC_DEMOGORGON);
            npc->move("/u/k/konn/workroom");
            npc->start_shutdown(5);
        }
}
