// _stat.c
// Command to show a living object's status.
// Created by Mobydick@TMI-2, 11-11-92
// Replaced an existing _stat command which had no header and which had
// lost all touch with reality.
// Modify by Davidoff (风火血舞) 11/22/94'
// modify stat by feyin 9/23/95

#include <mudlib.h>
#include "money.h"

inherit DAEMON ;
inherit COINVALUE ;

int help() ;

int cmd_stat (string name) {

	string *coins, *list, *statnames ;
	object ob ;
	string *skillnames ;
	mapping skills ;
	int i, j,flag,levelnum,hair ;
	string spouse, tempstr,levelname,nickname ;
	mapping stats ;
	mapping wealth ;

	if (!name) {
		return help() ;
	}
// 如果这位玩家不在线上
	ob = get_object(name);
	if (!ob || !living(ob)) {
		notify_fail("这位玩家现在不在这个奇妙的世界中。\n");
		return 0 ;
	}
// 等级、职业和称号
	levelnum = ob->query("level");
	if (!levelnum)
	levelnum= ob->query("mon_level");
	levelname = ob->query("levelname");
	nickname = ob->query("chi_name");
	hair = ob->query("godhair");
	if (!nickname) nickname="无名氏 ";
	write ("["+levelnum+"]  "+levelname+" "+nickname+"\n\n");
	write ("他拥有"+hair+"根猪鬃神毛。\n\n");
// 年龄、名声
        write ("现在的年龄是 "+ format_time((int)ob->query("age")));
        write ("\n");
        write ("现在的名声是 ");
//        flag = ob->query("alian");
        if (!flag) flag = 0;
        switch (flag)
        {
          case -1200..-700 :
          {
            write ("天理不容，无可救药\n");
            break;
          }
          case -699..-350 :
          {
            write ("无恶不作，通缉要犯\n");
            break;
          }
          case -349..-200 :
          {
            write ("伤天挈z，奸淫掳掠\n");
            break;
          }
          case -199..-100 :
          {  
            write ("欺善怕恶，作威作福\n");
            break;
          }
          case -99..-20 :
          {
            write ("贪小便宜，小人行径\n");
            break;
          }
          case -19..20 :         //  revised by Pearl, wa.. v20.23 can check
                                 // discontinuous error     case -21..20 :
          {
            write ("平凡百姓，不善不恶\n");
            break;
          }
          case 21..99 :
          {
            write ("守法公民，乐善好施\n");
            break;
          }
          case 100..199 :
          {
            write ("见义勇为，路见不平\n");
            break;
          }
          case 200..349 :
          {
            write ("仁新仁德，人饥己饥\n");
            break;
          }
          case 350..699 :
          {
            write ("救苦救难，侠义心肠\n");
            break;
          }
          case 700..1200 :
          {
            write ("菩萨转世，万人朝拜\n");
            break;
          }
          default : 
          { 
            write ("不知如何形容你\n"); 
            break;
          }
        }
        write ("你的前科记录 "+ob->query("crime")+"次\n\n");
// 列出玩家的性别和种族
	tempstr = ob->query("race") ;
        if((string)ob->query("gender") == "male")
        {
          if (tempstr) write ("他的种族是"+article(tempstr)+" "+tempstr+"。\n") ;
	}
        else
	{
	  if((string)ob->query("gender") == "female")
	  {
	    if (tempstr) write ("她的种族是"+article(tempstr)+" "+tempstr+"。\n") ;
	  }
	  else         	
	  {
	    if (tempstr) write ("牠的种族是"+article(tempstr)+" "+tempstr+"。\n") ;
	  }
	}        
// 列出玩家的配偶
	spouse = ob->query("spouse") ;
	if (!spouse)
	{
	  write ("自由自在的单身贵族\n\n") ;
	}
	else
	{  
	  if((string)ob->query("gender") == "male")
	  {
	    write ("他的配偶是"+spouse+"。\n") ;
	  }
	  else
	  { 
	    if((string)ob->query("gender") == "female")
	    { 
	      write ("她的另一半是"+spouse+"。\n") ;
	    }
	    else
	    {
	      write ("牠亲密的伴侣是"+spouse+"。\n") ;
	    }
	  }
	}
// 不能被攻击的神族
	if ((int)ob->query("no_attack")) {
		write ("祂是不能被攻击的。\n") ;
	}
/*
	If you want drunkeness, put this back in.
	flag = ob->query("drunk") ;
	switch (flag) {
		case 1..5 : {
			write (subj+" are a bit tispy.\n") ;
			break ;
		}
		case 6..10 : {
			write (subj+" are somewhat drunk.\n") ;
			break ;
		}
		case 11..15 : {
			write (subj+" are rather drunk.\n") ;
			break ;
		}
		case 16..20 : {
			write (subj+" are completely smashed.\n") ;
			break ;
		}
		case 21..25 : {
			write (subj+" are maximally drunk.\n") ;
			break ;
		}
	}
*/
// 基本点数
	write ("生命点数: "+"现存值: "+ob->query("hit_points")+"/最大值: "+
		ob->query("max_hp")+"\n") ;
	write ("法力点数: "+"现存值: "+ob->query("spell_points")+"/最大值: "+
		ob->query("max_sp")+"\n") ;
	write ("肺活量:   "+"现存值: "+ob->query("talk_points")+"/最大值: "+
	        (int)ob->query("level")*50+"\n") ;
        write ("经验点数: "+ob->query("exps")+"\n\n") ;
// 属性值
// modify by feyin 
        stats = ob->query_stats();
	if (stats && sizeof(stats)) 
	{
	  statnames = keys(stats);
	  for (i=0;i<sizeof(stats);i++) 
	  {
          j = (int)ob->query_stat(statnames[i]) ;
            write (sprintf("%12-s : %d (%d)\n",capitalize(statnames[i])
                                         ,j,stats[statnames[i]])) ;
	  }
	  write ("\n");
	}
// 身上所带的钱币数目
	wealth = ob->query("wealth") ;
	if (!wealth) 
	{
          write ("他的钱包里没有一毛钱。\n") ;
	} 
	else 
	{
	  coins = keys(wealth) ;
	  list = sort_array(coins,"sort_coins",this_object()) ;
          flag=0 ;
	  for (i=0;i<sizeof(coins);i++) 
	  {
	    if (wealth[list[i]]>0) 
	    {
	      write (sprintf("   %15-s %d\n",capitalize(list[i]),wealth[list[i]])) ;
	      flag=1 ;
	    }
	  }
	}
	if (flag==0) 
	{
	  write ("他的钱包里没有一毛钱。\n") ;
	}
// 玩家的技能值
	skills = ob->query_skills() ;
	if (skills && sizeof(skills)) {
	skillnames = keys(skills) ;
	write ("\n") ;
	write (capitalize(possessive(ob->query("gender"))) +
		 " skills are:\n") ;
	list = sort_array(skillnames, "sort_skills", this_object()) ;
	for (i=0;i<sizeof(skills);i++) {
		write (sprintf("%24-s : %d\n",capitalize(list[i]),skills[list[i]])) ;
	}
	}
	return 1 ;
}

// 显示技能时的排序

int sort_skills (string s1, string s2) {
        return strcmp( s1, s2 );
}

// 显示钱币时的排序

int sort_coins(string s1, string s2) {
	return (coinvalue(s1)<coinvalue(s2)) ;
}

// 使用help时的说明
int help() {
	write ("使用方法: stat <生物名称>\n"+
"这个指令可以帮助你知道一个生物的基本资料\n") ;
	return 1 ;
}
