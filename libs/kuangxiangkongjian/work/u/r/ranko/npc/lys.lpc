
//lys.c
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("风流才子", ({"lys"}));
        set("title", HIG"神" + HIY"奇" + HIW"魔" + HIM"法" + HIC"师"NOR );
        set("nickname", HIY"落凡精灵"NOR);
        set("gender", "男性");

        set("age", 25);
        set("attitude", "peaceful");
        set("score", 250000);
        set("combat_exp", 80000);

        set("str", 30);
        set("max_gin", 3000);
        set("max_kee", 3000);
        set("max_sen", 3000);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);

        setup();

        carry_object("/obj/cloth")->wear();
        carry_object("/obj/wiz_cloak");
        set("chat_chance", 10);
        if(!present("Germany mark", this_player()))set("chat_msg",({
            CYN"风流才子"NOR + "说道：sigh....真麻烦....\n",
            CYN"风流才子"NOR + "说道：有事吗?\n",
            (: command ("hmm") :),
            (: command ("?") :),
            (: command ("hehe") :),
            (: command ("hoho") :),
            (: command ("smile") :),
            (: command ("nod") :),
            (: command ("hi wugi") :),
            (: command ("kick") :),
            (: this_object() , "random_move" :),
            (: command ("goto futzao") :),
            (: command ("sigh") :),
        }));
}

