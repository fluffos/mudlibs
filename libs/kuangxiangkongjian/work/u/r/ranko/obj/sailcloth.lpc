// anyarmband.c
 
#include <armor.h>
#include <ansi.h>
 
inherit CLOTH;
 
void create()
{
	set_name( HIC "水手服" NOR , ({ "sailman cloth" , "cloth"}) );
 
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value",9999);
                set("material", "crimsonsteel");
		set("armor_type","cloth");
                set("armor_prop/armor", 1);
                      set("armor_prop/id", ({"Pretty Soldier", "soldier"}) );
                      set("armor_prop/name", ({"美少女战士"}) );
           set("armor_prop/short", ({"美少女战士(Pretty Soldier)"}) );
                set("armor_prop/long", ({
                   "一个穿着亮丽水手服的女孩,脸上带着头盔，看不清她的面孔。\n"
                }) );
        }
           set("wear_msg",@LONG
忽然了一阵亮光从臂环中发了出来，亮的你睁不开眼睛。
一瞬间，所有的光芒全部包围住$N换化成一件水手服。
$N忽然举起手大喊 :「可恶的色狼，我美少女战士要代替星星、月亮、太阳还有拉姆
来惩罚你们了。”
LONG);
           set("remove_msg", "$N脱掉了臂环，光芒逐渐退去,恢复了原貌。。\n");
        setup();
}
