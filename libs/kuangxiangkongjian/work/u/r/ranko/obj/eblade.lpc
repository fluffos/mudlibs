#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void block(object me, object victim, object  weapon, int damage);
mapping *action = ({
([ "action":"$N使出‘雨流狂落斩’握着手中的$w向$n冲去.随即身形一变,向$n斩
了数十刀",
	"dodge":200,
	"parry":150,
	"damage":1500,
	"damage_type":"刀伤",
        "post_action":  (: call_other, __FILE__, "block" :),
	]),
(["action":"$N使出‘五月花斩’,整个身子急速的旋转,手中的$w顺势化为一刀芒向$n斩
去",
	"dodge":150,
	"parry":200,
	"damage":1250,
	"damage_type":"刀伤",
	"post_action":  (: call_other, __FILE__, "block" :),
]),

});
void create()
{
	set_name(HIR "妖刀 村正" NOR, ({"musashi blade","blade"}) );
        set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else{
		set("unit", "把");
		set("value", 70000);
		set("material", "crimsonsteel");
set("long"," 室叮幕府时代著名的刀匠,村正所锻造的名刀.此刀因于战场上吸了太多人血
而渐具魔性,曾于德川幕府时代将第三代将军-家光一家闹的鸡犬不宁,是一把
著名的妖刀。\n");
		set("wield_msg", "$N将$n从刀鞘中抽出,一股凌厉的杀意从刀中传到了$N身上,进而控制了$N的意念.\n");

		set("unwield_msg", "$N硬生生地将$n插入刀鞘中,感到意识较刚才清楚,杀气亦没有那么重了.\n");
	}
		init_blade(700, SECONDARY);
		set("actions", (: __FILE__, "query_action" :) );
		setup();
	
}

varargs mapping query_action()
{
	return action[random(sizeof(action))];
}

void block(object me, object victim, object  weapon, int damage)
{
	if(damage > 100)
{
	victim->start_busy( random((int)me->query_skill("blade", 1) / 20 + 2) );
	message_vision(HIR"妖刀 村正的刀身突然泛起一阵黑雾,将$n缠住,使$n动弹不得!\n"NOR,me,victim);
     }
}
