
#include  <ansi.h>
inherit F_VENDOR;

void create()
{
	set_name("药铺老板",({"shop keeper","keeper"}) );
	set("long","
药铺的老板，他正微笑的对你颔首示意。\n");
	set("age",43);
	set("gender","男性");
	set("vendor_goods",({
	"/open/poison/obj/plaster.lpc",
	//"/open/poison/obj/ginseng.lpc",
	//"/open/poison/obj/mushroom.lpc",
	//"/open/poison/obj/tginseng.lpc",
	//"/open/poison/obj/tmushroom.lpc",
}) );
	set("no_kill", 1);
	setup();
	carry_object("/obj/cloth.lpc")->wear();
}

void greeting(object me)
{
	if (!me || environment(me) != environment()) return;
{
	command("pat "+me->query("id"));
	command("say 你看起来很健康嘛。");
} 
}
