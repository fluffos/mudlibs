#include <ansi.h>
#include "/open/open.h"
inherit NPC;
string do_job(object who);
void create() {
  set_name("冲田总司", ({ "cho" }));
  set("title", "新撰组");
  set("nickname", "第一队队长");
  set("age", 18);
  set("str", 50);
  set("cps", 33);
  set("cor", 36);
  set("per", 39);
  set("int", 31);
  set("spi", 30);
  set("con", 40);
  set("kar", 31);
  set("attitude", "heroism");
  set("gender", "男性");
  set("class", "fighter");
  set(
    "long",
    "幕府末期由各地挑选出剑术顶尖的高手成立的‘新撰组’，其目地为保护幕府，是维新志士的头号敌人，其每一队的组长更是高手中的高手，冲田总司为第一组的组长，剑术修为高深，此次不知为了何种目地来到中原。\n"
  );
  set_skill("dodge", 130);
  set_temp("apply/armor", 30);
  set_temp("apply/dodge", 20);
  set_temp("apply/attack", 30);
  set_skill("parry", 150);
  set_skill("blade", 200);
  set_skill("force", 70 + random(50));
  set_skill("move", 100);
  set_skill("nine-steps", 120);
  //map_skill("parry","dragon-blade");
  map_skill("move", "nine-steps");
  map_skill("dodge", "nine-steps");
  //map_skill("blade","dragon-blade");
  set("combat_exp", 2000000);
  set("inquiry", ([

    "任务": (: do_job :),
    "绯村拔刀斋": "他的特征是一头的红发，左脸上有着十字疤痕，你有见过他吗?\n",
    "新撰组": "我们是幕府最引以为傲的一群，维新志士则是我们的头号大敌。\n",
    "维新志士": "他们是与我们立场相反的一群，其中亦不乏剑术高深者，如绯村拔刀斋即为其中的姣佼者。\n",
  ]));
  set("chat_chance", 10);
  set("chat_msg", ({
    "冲田总司疑惑的说:请问你有没有看到绯村拔刀斋呢?\n",

    "冲田总司喃喃自语:我一定要完成这项任务。\n",
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: this_object(), "special_att" :),
  }));
  set("sen", 10000);
  set("max_sen", 10000);
  set("gin", 10000);
  set("kee", 10000 + random(5000));
  set("max_gin", 10000);
  set("max_kee", 10000);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10 + random(5));
  setup();
  carry_object("/open/poison/obj/sandals.lpc")->wear();
  carry_object("/open/poison/obj/esword.lpc")->wield();
  carry_object("/open/poison/obj/cloak.lpc")->wear();

}
int special_att() {
  object *me, one;
  int i;
  me = this_object()->query_enemy();
  i = sizeof(me);
  one = enemy[random(i)];
  message_vision(HIC "
	冲田总司喊道:看我的秘技\n\n"
    HIG "                虚～～～空～～～斩!\n\n" NOR, one);
  message_vision(RED "             一道锋厉的刀气迎面冲来\n" NOR, one);
  one->apply_condition("bleed", 5);
  one->receive_wound("kee", random(300 + 250));
  COMBAT_D->report_status(one);
  return 1;
}
void init() {
  add_action("do_say", "say");
}
string do_job() {
  object who = this_player();
  who->set_temp("do_job", 1);
  command("? " + who->query("id"));
  command("say " + who->query("name") + "，你想帮我完成这任务吗?(yes/no)");
  return "这个任务太过困难，也许\只能靠我独力完成。";
}
int do_say(string str) {
  object who = this_player();
  if (who->query_temp("do_job") != 1)
    return 0;
  if (str == "yes") {
    who->set_temp("do_job", 2);
    command("say 我的任务就是要除去残存的维新志士，完成后请拿他身上的一样物品做信物，拿来给我。");
    command("say 他们的剑术都很高深，健议你最好先跟其它的人试试你的程度在说");
    return 1;
  }
  if (str == "no") {
    command("shrug");
    command("say 这个任务对你来说或许\真的是难了点。");
  }

}
