
 
inherit NPC;

void create()
{
set_name("武僧", ({"bonze"}) );
set("age", 34);
set("long", "一个正在勤练武艺的僧人,武艺似乎不错。");
set("str", 15);
set("con", 15);
set("int", 15);
set_skill("parry", 30);
set_skill("unarmed", 40);
set("title", "道场");
set_skill("move", 30);
set_skill("force", 50);
set("combat_exp", 1000);
	set("max_kee",10000000);
set("gender", "男性");
set("inquiry", ([
          "乱子" : "我家小主人吗?不知跑那去玩了.您四处看看吧。\n"
]) );
set("chat_chance", 6);
set("chat_msg", ({
	"你要找我们家小主人.乱子小姐吗?\n"
}) );
setup();
}
