// torch

inherit ITEM;

void create()
{
        set_name("木头", ({ "torch", }) );
        set("unit", "根");
        set("long", "一根可以当材烧的木头。\n");
	set("burned","快烧光的");
	// light_up 大于 0 表示可以燃烧的心跳数
	set ("light_up", 10);
	set("value", 10);
	setup();
}
void init()
{
 add_action("suu","push");
}
int suu(string str)
{
 if(!str)
 return notify_fail("你要压啥?\n");
 if(str!="button")
 return notify_fail("你要压啥?\n");
 str=lower_case(str);
  return "/u/r/rong/obj/map.lpc"->test();
} 
