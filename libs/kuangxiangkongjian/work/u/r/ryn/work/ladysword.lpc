// blade.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIW "淑女剑" NOR, ({ "lady sword","sword" }) );
        set_weight(24000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value",6000000);
                set("material", "steel");
                set("long",
                    "淑女剑是一把看来平淡无奇，却又削铁如泥的宝剑，它与君子剑正是一对。");
                set("wield_msg",HIW"$N从剑鞘中抽出$n握在手中，瞬间有一股剑气注入到$N的体内。\n"NOR);
                set("unequip_msg",HIW"$N将手中的$n收回剑鞘中，剑气抽体而出。\n"NOR);
        }
        init_sword(10000);
        setup();
}
