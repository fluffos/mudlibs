// blade.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
        set_name(HIY "逆刃刀" NOR,({"contrary-edge blade","blade"}));
        set_weight(24000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value",6000000);
                set("material", "steel");
                set("long", "逆刃刀乃是一把稀世的宝刀，刀身上阵阵透出的杀气，让人惊讶不知吸了多少人的血。\n");
                set("wield_msg", "$N抽出杀气腾腾的$n握在手中，$N感觉到$n无匹的力量注入$N的体内。\n");
                set("unequip_msg", "$N将$n插回背上的缠刀布中。\n");
        }
         init_blade(999999);
        setup();
}
