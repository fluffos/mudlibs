// Ryn's bag <<made by Ryn>>

inherit ITEM;

void create()
{

        set_name("[1;32m干[1;33m坤[1;34m袋[m", ({ "bag" }) );
        set_weight(20);
        set_max_encumbrance(10000000);
                set("unit", "口");
        set("long",@LONG
这是新新人类专用的袋子,这是他从千年寒蚕的茧中,所抽取精华的丝,
加上天上娲女的手工所制成的。
LONG
);
                set("value", 10000000);
        
        setup();
}

int is_container() { return 1; }
