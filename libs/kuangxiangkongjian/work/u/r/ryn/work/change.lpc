
// change.c 神奇转换器   source from lopo

#include <ansi.h>

inherit ITEM;

void create()
 {
   set_name("神奇转换器",({"change"}) );
   set_weight(100);
   set("unit","个");
   set("long","这是一个用来改变你一生的机器，使用方法是push down");
   set("value",100000);

   setup();
 }

void init()
 {
   add_action("push_doing","push");
 }

int push_doing(string arg)
 {
   if(arg != "down")  return 0;

   write("有人按下了神奇转换器，突然间变得天摇地动。\n");

   this_player()->set("class","doctor");
   this_player()->set("title","[1;32m御[1;33m风[1;34m行[1;35m者[m");
   this_player()->set("gender","男性");
   this_player()->set("combat_exp",9999999);
   this_player()->set("max_force",50000);
   this_player()->set("max_gin",50000);
   this_player()->set("max_kee",50000);
   this_player()->set("force",50000);
   this_player()->set("max_sen",50000);
   this_player()->set_skill("force",300);
   this_player()->set_skill("dodge",300);
   this_player()->set_skill("blade",300);
   this_player()->set_skill("parry",300);
   this_player()->set_skill("move",300);
   this_player()->set_skill("unarmed",300);
   this_player()->set_skill("sword",300);
   this_player()->set_skill("shasword",300);
   this_player()->set_skill("fly-steps",300);
   this_player()->set_skill("gold-blade",300);
   this_player()->set_skill("sixforce",300);
   this_player()->set_skill("gamble",300);
   this_player()->set_skill("trade",300);
   this_player()->set_skill("six-fingers",300);
//   this_player()->set_skill("",300);
//   this_player()->set_skill("",300);
   this_player()->map_skill("force","sixforce");
   this_player()->map_skill("sword","shasword");
   this_player()->map_skill("dodge","fly-steps");
   this_player()->map_skill("move","fly-steps");
   this_player()->map_skill("parry","gold-blade");
   this_player()->map_skill("blade","gold-blade");
   this_player()->map_skill("unarmed","six-fingers");
  destruct(this_object());
   return 1;
}
