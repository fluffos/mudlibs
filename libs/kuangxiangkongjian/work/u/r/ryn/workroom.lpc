//Ryn's workroom
#include <room.h>
#include <ansi.h>

inherit ROOM;
 int i=0;
void create ()
{
  set ("short", "[1;32m新新人类的工作室[m");
  set ("long", @LONG
      这里是新新人类的工作室,在你的面前有一个书桌,书
  桌上摆着新新人类最爱的486电脑(computer),你别看他虽然旧
  ,但配备还不错喔!而在东面的墙壁上,有一面窗户(window),你
  可以往外面看看,说不定还可以看到什么新奇的事物喔...

LONG);

  set("exits", ([ /* sizeof() == 7 */
  "north" : "/open/wiz/hall1",
  "down" : "/open/wiz/entrance",
  "up" : "/u/r/ryn/lroom",
  "blade" : "/open/gblade/room/gblade",
  "wade" : "/u/w/wade/workroom",
  "konn" : "/u/k/konn/workroom",
  "shout" : "/u/s/shout/workroom",
]));
  set("item_desc", ([ /* sizeof() == 4 */
           "window" : "\n你从窗外望出去,可以看到一片蔚蓝的天空"+
                    ",还有一朵朵白云(cloud),真是诗情画意啊!\n" ,
           "computer" : "\n你看到萤幕(screen)上有些密密麻麻的字!\n"+
                        "还有一个光碟机(cdrom)正在转动,真想把它(push)出来看看!\n" ,
           "screen" : "\n上面写着\n"+"用LPC所写的程式,由此可知"+
                      "新新人类有多认真啊!....:D\n" ,
           "cloud" : "\n唷!?有几朵白云很奇怪喔...上面好像站着人耶!\n"+
                     "\n喔..原来是wade大大在上面监督我们哩...:D\n" ,
                   ])  );
  set("no_fight", 1);
  set("light_up", 1);
  set("no_magic", 1);
  set("valid_startroom", 1);

   set("objects",([ /* sizeof() == 1 */
       "/u/r/ryn/npc/laro.lpc" : 1,
      ]));

  setup();
}
