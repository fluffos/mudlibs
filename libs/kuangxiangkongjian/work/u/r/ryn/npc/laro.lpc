//Ryn 的忠心宠物
inherit NPC;

void create()
{
          set_name("小雷龙",({"laro"}) );
          set("long", @LONG
               这是一只可爱的小雷龙,是新新人类在某个地方
          捡来的蛋,所孵出来的。别看它呆头呆脑,其实挺善解
          人意的喔。所以它始终都是新新人类忠心的好伙伴。
LONG);

          set("nickname","小乖乖");
          set("title","新新人类的宠物");

          set("age",5);
          set("int",20);
          set("cps",20);
          set("str",20);
          set("cor",20);
          set("spi",20);
          set("con",20);
          set("kar",20);
          set("per",20);

          set("gender","男性");
          set("race","人类");
          set("limbs",({"头","手","脚","背","腹","腰"}) );
          set("attitude","friendly");

          set("chat_chance",10);
          set("chat_msg",({ /* sizeof() == 4 */
          "\n可爱的小雷龙绕着你身边跑来跑去\n"+
          "你深怕一不小心踩着了它\n",
          "\n小雷龙仰着头呆呆的望着你\n"+
          "你从它的眼神看出它似乎须要你的爱\n",
          "\n小雷龙伸出舌头,舔了你的手\n"+
          "唉唷!口水流了满地都是....\n",
          "\n小雷龙对着你一直在摇尾巴\n"+
          "看起来它似乎对你蛮有好感的....\n"
          }));
          set("inquiry",([ /* sizeof() == 4 */
          "新新人类" : "你要找他啊? "+
                       "他既然不在,你就mail到 \n"+
                       "ryn.redbbs@redbbs.cc.tit.edu.tw \n"+
                       "等他看到,他马上就会回信给你了..:D \n",
          "你" : "你问‘我’啊? \n"+
                 "我叫做小雷龙,是新新人类忠心的小宠物啊!\n",
          "这里" : "这里就是新新人类的工作室啊!\n"+
                   "这里的东西只能看,不能动喔!\n",
          "出身" : "我也不知道从哪里来的?你问问我的主人,\n"+
                   "他或许知道喔!\n"
                        ]) );
         setup();
}

