//  Rroom
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("light_up", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  set("valid_startroom", 1);
  set("short", "新新人类私人卧房");
  set("enter_msg", HIG + "你感觉到一股强烈的灵气接近!....莫非是$N ?!..." + NOR);
  set("welcome_msg", "[1;35m呵...原来是[1;33m$N[1;35m的造访!...随便坐,别客气啊!...^_^[0;37m");
  set("long", @LONG
[1;37m= 新新人类□卧房 =[0;37m
     你终于来到了新新人类的私人套房，内部布置得舒适优雅，确实是一个人想
     要安静独处时的最佳环境。室内并没有照明设备，光线全都从房间天花板的
     那扇[1;35m天窗(window)[0m投射进来，所以到了晚上，只要躺在[1;35m床 (bed)[0m上就可以清
     楚的看见天上闪闪发亮的星斗。床头上还有一台床头音响，也是新新人类的
     收藏品之一。另外在角落的墙上，你还看到一样奇怪的[1;35m挂饰(thing)[0m挂在那
     里。
LONG
  );

  set("exits", ([ "down": "/u/r/ryn/workroom",
  ]));
  set("exit_msg", HIW + "一股灵气迅速的消散而去!...原来是$N离开了..." + NOR);
  set("item_desc", ([
    "window": "\n你从天窗望上去，可以看到纯洁无暇的蓝色天空,还有" +
    "一朵朵白云飘过,\n" + "这是在人间难得一见的美景。\n" +
    "咦？！还有一个漂浮在空中的城市(city),就在雷神殿的" +
    "西方天空漂浮着。\n",

    "bed": "\n一张铺着紫色毛毯的双人床，还有两个绣花枕头....\n" +
    "是新新人类平常睡觉休息(rest)的地方。\n",

    "thing": "\n原来那是一条水晶项炼。银色的炼条,下面镶着一块[1;35m紫水晶[0;37m(amethyst)\n" +
    "而水晶上还刻着一个类似闪电的奇怪符号.....\n" +
    "你可以把它拿(take)下来看仔细点,可是要小心喔!..很贵重的...\n",

    "city": "原来那里就是传说中的[1;37m ‘ 天空之城 ’ [0m......\n"
    + "但是因为通道还未打开,所以地面上的人是无法到达那里的...\n"
  ]));

}
void init() {
  add_action("rest_bed", "rest");
  add_action("take_amethyst", "take");
}

// 上床睡觉 (only girl)    rest
int rest_bed() {
  string str;
  str = this_player()->query("id");
  if (str == "Ryn") {
    //    this_player()->receive_healing((int)this_player()->query("max_hp"));
    write("\n[1;37m妳躺在床上,一会儿就昏昏睡去....[0;37m\n");
    write("[1;37m直到其他人叫醒了妳,妳才发现自己已经睡了一段时间了...[0;37m\n");
    write("[1;35m啊～～～睡了舒服的一觉,所有的疲劳都消失了....[0;37m\n");
    say("\n" + HIY + this_player()->query("name") + "躺在床上舒服的睡了一觉," +
      "\n直到你叫醒她,她才伸个懒腰爬起来....\n" + NOR);
    return 1;
  }

  else {
    write(HIW + "\n你躺在床上,正准备好好睡一觉......\n" + NOR +
      "[1;32m突然...碰!!!...你重重的摔到床下! 你自己还搞不清楚怎么回事?!!...[0;37m\n");
    say("\n[1;33m你看见" + this_player()->query("name") + "躺到床上后,又‘碰’的" +
      "一声! 狠狠的摔到床下去....[0;37m\n");
    return 1;
  }
}


