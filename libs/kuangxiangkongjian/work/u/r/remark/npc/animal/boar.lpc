#include "/open/open.h"

inherit NPC;
#include <ansi.h>
void create() {
  set_name(YEL "野猪" NOR, ({ "boar" }));
  set("gender", "雄性");
  set("age", 10);
  set("long", "一只壮硕的野猪。\n");
  set("combat_exp", 1000);
  set("attitude", "aggressive");
  set("chat_chance", 10);
  set("chat_msg", ({
    HIW "  ㄍㄡ～～～ㄍㄡ～～～～～.\n" NOR,
    (: random_move :),
  }));

  setup();
  add_money("coin", 200);
}
