#include "/open/open.h"
inherit PARTY_NPC;
#include <ansi.h>
void create()
{
	set_name(HIC"塞内鲁克"NOR,({"trade man","man"}));
        set("gender", "男性" );
        set("age", 31);
        set("str", 25);
        set("cor", 25);
        set("cps", 20);
        set("int", 30);
set("long", @LONG
 
            亚里亚罕城的大盘商,经营着数家大商店,为人副正义感,
            是一个不可多得的人才,他或许会加入你的队伍
LONG
	);
        set_skill("dodge", 56);
        set_skill("dagger",75);
        set_skill("dragon-dagger", 43);
        set_skill("trade", 99);
        set_skill("move", 31);
        set_skill("chen-steps", 47);
        set_skill("force", 52);
        set_skill("oneforce", 62);
        set_skill("unarmed", 43);
        map_skill("dodge", "chen-steps");
        map_skill("move", "chen-steps");
        map_skill("dagger", "dragon-dagger");
        map_skill("force", "oneforce");
        setup();
        add_money("gold",100);
        carry_object("/open/capital/obj/chen_dagger")->wield();
        carry_object("/u/r/remark/obj/items/flaqon.lpc");
        carry_object("/obj/example/chicken_leg.lpc");
      
        set("chat_chance", 5);
        set("chat_msg", ({
           HIC" 塞内鲁克 说: 希望你能成功\n"NOR,
        }) );
        set("inquiry", ([
		"魔王":HIR "魔王,可恶的家伙,一起去消灭他吧!\n"NOR,
        ]) );
}
