#include "/open/open.h"

inherit NPC;
#include <ansi.h>
void create() {
  set_name(HIY "酒鬼" NOR, ({ "tippler" }));
  set("gender", "男性");
  set("age", 40);
  set("long", "一个鬼鬼祟祟的酒鬼。\n");
  set("combat_exp", 20);
  set("chat_chance", 5);
  set("chat_msg", ({

    "我身上有好东西喔..不过死也不给你 .\n",
    "如果有兴趣,就去拿瓶酒来孝敬我吧 .\n",
    "趁女老板不在,偷喝一些酒吧 .\n",

    (: random_move :),
  }));

  setup();
  add_money("coin", 5);
}
