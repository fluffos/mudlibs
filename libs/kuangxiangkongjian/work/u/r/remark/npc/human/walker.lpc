#include "/open/open.h"
inherit PARTY_NPC;
#include <ansi.h>
void create()
{
	set_name(HIG"过路客"NOR,({"walker"}) );
	set("gender","男性");
	set("age",33);
	set("long","过路客,脸色苍白好像在害怕什么。\n");
	set("combat_exp",7700);
	set("chat_chance",5);
	set("chat_msg",({
         
           "我听说魔王军要攻进来了.. .\n",
           "趁现在还能走掉,快离开吧 .\n",

	(: random_move :),
	}));
        set_skill("move", 70);
        set_skill("force", 31);
        set_skill("unarmed",53);
        set_skill("blade",12);
        set_skill("parry",21);
        set_skill("dodge",36);
        set_skill("gold-blade",24);
        set_skill("fly-steps",30);
        set_skill("sixforce",23);
        map_skill("force", "sixforce");
        map_skill("parry", "gold-blade");
        map_skill("blade", "gold-blade");
        map_skill("dodge", "fly-steps");
        map_skill("move", "fly-steps");
					
	setup(); 
	add_money("coin",5);
}

