#include "/open/open.h"
inherit PARTY_NPC;
#include <ansi.h>
void create() {
  set_name(HIW "旅行者" NOR, ({ "travel man", "man" }));
  set("gender", "男性");
  set("age", 37);
  set("str", 36);
  set("cor", 55);
  set("cps", 30);
  set("int", 32);
  set("long", @LONG
 
            目光熊熊的旅行者,腰间一把锋利的剑正闪闪发出银光
 
LONG
  );
  set_skill("dodge", 66);
  set_skill("sword", 73);
  set_skill("parry", 55);
  set_skill("shasword", 53);
  set_skill("literate", 69);
  set_skill("move", 41);
  set_skill("sha-steps", 57);
  set_skill("force", 43);
  set_skill("sha-steps", 62);
  set_skill("unarmed", 53);
  map_skill("dodge", "sha-steps");
  map_skill("move", "sha-steps");
  map_skill("sword", "shasword");
  map_skill("parry", "shasword");
  map_skill("force", "shaforce");
  setup();
  add_money("gold", 1);
  carry_object("/open/gsword/obj/sword-1.lpc")->wield();

}
