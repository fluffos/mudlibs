#include <ansi.h>
#include "/open/open.h"
inherit NPC;
void create()
{
        set_name("守卫",({"guard"}));
        set("gender","男性");
        set("class","warrior");
        set("combat_exp",15000);
        set("age",20);
        set("str", 34);
        set("cor", 34);
        set("cps", 38);
        set("per", 44);
        set("int", 42);
        set("force",750);
        set("max_force",750);
        set_skill("parry",70);
        set_skill("dodge",70);
        set_skill("blade",70);
        set_skill("gold-blade",65);
        set_skill("fly-steps",60);
        map_skill("dodge","fly-steps");
        map_skill("move","fly-steps");
        map_skill("blade","gold-blade");
        map_skill("parry","gold-blade");
        set("chat_chance_combat",60);
        set("chat_msg_combat",({
                (: exert_function, "powerup" :)
        }));
        setup();
}

void init()
{
  object me = this_player();
  int times = me->query_temp("warrior");
  :: init();
  if( times > 2 && !present("act",me) ) {
       remove_call_out("case1");
       call_out("case1",1,me);
      }
  else if(!present("act",me) && me->query("family/family_name") == "金刀门")
{
           remove_call_out("case2");
           call_out("case2",1,me);
         }
  if(me->query("class") == "warrior" && !me->query("family/family_name") )
{
           remove_call_out("case3");
           call_out("case3",1,me);
         }
  if(present("act",me)) {
           remove_call_out("case4");
           call_out("case4",1,me);
         }
}
void case1(object me)
{
      message_vision(HIR"守卫怒道：可恶! $N还敢再来呀!\n"NOR,me);
      command("say 我看你是活腻啦。乖乖送死吧!");
      this_object()->kill_ob(me);
}
void case2(object me)
{
  int times = me->query_temp("warrior");
      command("say 臭小子，这里不欢迎你。");
      command("say 滚吧! 下次别再让我遇到，否则我就宰了你。");
      me->set_temp("warrior",3+times);
}
void case3(object me)
{
      command("say "+me->name()+"想进皇宫吗?");
      command("smile");
      command("say 经过同意才能来的哦!");
}
void case4(object me)
{
      command(":D");
      command("say 欢迎! 欢迎! 请进! 请进!");
      me->delete_temp("warrior");
}
