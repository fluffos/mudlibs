//vendor.c
#include "/open/open.h"
inherit F_VENDOR;
#include <ansi.h>
void create()
{
	set_name(HIM"女老板"NOR,({"jessica"}));
        set("gender", "女性" );
        set("age", 21);
        set("str", 15);
        set("cor", 15);
        set("cps", 30);
        set("int", 30);
	set("age", 21);
set("long", @LONG
   这间酒店的女老板,长的眉清目秀,可爱的模样令每个看到她的人都不觉的赞叹
   她正高兴的为每个到这里的客人服务....或许你可以跟她要到一些好酒来喝喝
LONG
	);
        set("age",20);
        setup();
        add_money("coin",100);
        carry_object("/obj/cloth.lpc")->wear();
       
set("chat_chance", 5);
        set("chat_msg", ({
           HIC" jessica 说: 英雄要喝杯上好的葡萄酒吗?.\n"NOR,
           HIC" jessica 说: 各位是我这间酒店的嘉宾,欢迎到处看看.\n"NOR,
           HIC" jessica 说: 我是这间酒店的女老板,有什么事就找我吧\n"NOR,
           HIC" jessica 说: 如果您累了的话,可以往北到厢房休息\n"NOR,
           HIC" jessica 说: 墙上是古代勇者的肖像,都是我崇拜的偶像\n"NOR,
           HIC" jessica 说: 我喜欢浪漫的男孩,只是还没有人对我示意\n"NOR,
        }) );
        set("inquiry", ([
                "老板": HIM"人家还未婚呢?哪来的老板...^_^...\n"NOR,
                "上等葡萄酒": HIY"这是我私家珍藏的美酒,你想喝吗?.\n"NOR,
                "勇者": HIW"嗯?你没听过?他是一位打倒魔王的大英雄\n"NOR,
		"魔王":HIR "魔王,你别吓我,我是很胆小的\n"NOR,
        ]) );
	
	set("vendor_goods", ({
                "/u/r/remark/obj/items/flaqon.lpc",
                "/u/r/remark/obj/weapon/sword.lpc",
                "/u/r/remark/obj/weapon/blade.lpc",
                "/u/r/remark/obj/armor/armor.lpc",
                "/u/r/remark/obj/armor/shield.lpc",
                "/u/r/remark/obj/armor/boots.lpc",
                "/u/r/remark/obj/armor/helmet.lpc",
                "/u/r/remark/obj/armor/star.lpc",

	}) );
}
