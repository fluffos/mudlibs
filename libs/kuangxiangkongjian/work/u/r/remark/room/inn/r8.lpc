// Room: /u/r/remark/room/inn/r8
inherit ROOM;
#include <ansi.h>
string search_shelf();
void create() {
  set("short", HIM "jessica 的书房" NOR);
  set("long", @LONG

            这里是 jessica 用功的地方,透明的落地窗引进串串的阳光,
            照在偌大的书架上(shelf),书架旁是张书桌(desk),
            稀奇的是这里干净的很,没有一点灰尘,不太符合主人的个性。

LONG);

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "r7.lpc",
  ]));
  set("item_desc", ([ /* sizeof() == 2 */
    "shelf": "四层的书架,堆着心理学,社会学,佛洛依德,#$%@...看的头晕眼花,
深处好像藏了一本什么,可以仔细的翻一翻(search)
",
    "desk": "一方书桌,桌上不但放满了书,连笔也四处可寻,真是符合主人的性格
",
  ]));
  set("light_up", 1);
  set("search_desc", ([ /* sizeof() == 1 */
    "shelf": (: search_shelf :),
  ]));
  setup();
}
string search_shelf() {
  message_vision(HIC "$N在书架中找来找去,找到了一本日记 \n" NOR, this_player());
  new("/u/r/remark/obj/items/diary.lpc")->move(this_player());
  return "";
}
