void create ()
{
  set ("short",HIM"露依达酒店厨房"NOR);
  set ("long", @LONG
        
           露依达酒店厨房是生产各类佳肴的场所,不但师父功夫道地,
           卫生更是做的彻底,可以放心地食用,尽情地享受,是一大特点
           由于 jessica 在这里酿制葡萄酒,偶尔有几个没钱的酒鬼(tippler)
           会来偷酒喝,在墙角放了一些酒瓶(flaqon pot)。
LONG);

  set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"r1.lpc",
]));
  set("item_desc", ([ /* sizeof() == 1 */
  "flaqon pot" : "一些空的酒瓶,或以后会用的到,不过现在暂时堆放在角落
",
]));
