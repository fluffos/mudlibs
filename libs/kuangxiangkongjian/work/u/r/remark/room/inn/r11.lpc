//Room: /u/r/remark/room/inn/r5
inherit ROOM;
#include <ansi.h>
void create ()
{
  set ("short",HIM"地下一楼客房"NOR);
  set ("long", @LONG

        隔壁是英雄好汉的聚集地,冒险家都在这里寻找自己的伙伴,
        有些累了的冒险者索性在这呼呼大睡起来(sleep),不过这里的
        环境没有一楼客房来的好,如果你真的累的话,不妨多走一点路,
        到一楼去休息吧,墙上挂着古代勇者的肖像(picture).

LONG);

  set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"r9.lpc",
]));
  set("item_desc", ([ /* sizeof() == 1 */
  "picture" : "罗德与其伙伴的肖像,是露依达的珍藏物,不过已经是过去历史,
",
]));
	set("light_up", 1);

	setup();
}

int valid_leave(object who,string direct)
{
	if( direct == "east" && who->query_temp("sleeping") )
		return notify_fail(HIW"周公跟你说:我们棋还没下完呢\n"NOR);
	return ::valid_leave(who,direct);
}

void init()
{
	add_action("do_sleep","sleep");
	add_action("do_look", "look");
	add_action("do_goto", "goto");
        add_action("do_more", "more");
}

int do_sleep(string arg)
{
	object who;
	who=this_player();

	if( who->query_temp("sleeping") )
	{
		tell_object(who,HIW"还睡？ 你想赖床ㄚ\n"NOR);
		return 1;
	}
	tell_object(who,HIY"你躺在房间里的床上，作起梦来。\n"NOR);
	who->delete_temp("sleep");
	who->set_temp("sleeping", 1);
        who->set("name",HIC"英雄好汉"NOR);
	call_out("wakeup", 300, who);
	return 1;
}

int wakeup(object who)
{
	tell_object(who, HIG"一觉醒来，你觉神清气爽。\n"NOR);
	who->receive_heal("kee", 100);
        who->receive_heal("sen", 100);
        who->receive_heal("gin", 100);
	who->delete_temp("sleeping");
	return 1;
}

int do_look()
{
	object who = this_player();

	if( who->query_temp("sleeping") )
	{
		tell_object(who,HIR"有人睁着眼睛睡觉的吗？\n"NOR);
		return 1;
	}
}

int do_more()
{
        object who = this_player();

        if( who->query_temp("sleeping") )
        {
                tell_object(who,HIR"这样就够了吧,你想睡多久？。\n"NOR);
                return 1;
        }
}

int do_goto()
{
	object who = this_player();

	if( who->query_temp("sleeping") )
	{
		tell_object(who,HIR"睡就睡,动来动去的做啥。\n"NOR);
		return 1;
	}
}
