#include <room.h>
inherit ROOM;
#include <ansi.h>
void create ()
{
  set ("short", "[1;35m皇宫大门[2;37;0m");
  set ("long", @LONG


 
       皇宫大门



LONG);

  set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"r2.lpc",
  "south" : "/u/r/remark/room/street/r5.lpc",
]));
  set("objects", ([ /* sizeof() == 1 */
  "/u/r/remark/npc/human/guard.lpc" : 1,
]));
  set("light_up", 1);

  setup();
}
int valid_leave(object me, string dir)
{
object who;
if(me->query("class")!="warrior")
{
if (dir=="north" && who=present("guard",environment(me)))
  return notify_fail("勇者(warrior)才有资格进入\n");
}
if (dir == "north" && this_player()->query_temp("weapon"))
 return notify_fail(HIR"进入皇宫内院,请勿携带武器!\n"NOR);
return ::valid_leave(me,dir);
}
