#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
	set_name(HIR"霸者之剑"NOR,({"warrior sword","sword"}));
	set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit","把");
		set("long"," 这是勇者用欧里哈耳肯金属制成的宝剑\n");
		set("material","blacksteel");
		set("value",500000);
    	} 
	init_sword(500);
	
set("wield_msg",HIY"罗德大喝一声:该死的家伙....看剑$n"HIY"显于$N手中。\n"NOR);
	set("unwield_msg",HIG"宝剑划空而去.自$N手中消失，$n"HIG"变成飞龙...。\n"NOR);
	
	setup();

} // eof create()

int wield()
{
	if ((string)this_player()->query("id") != "remark")
		return notify_fail(" 很可惜,用法只有罗德知道。\n");
	else {
        	::wield();
        } 


     return 1;

} 
