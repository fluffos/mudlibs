#include <ansi.h>
#include <weapon.h>

inherit AXE;

void create()
{
	set_name(HIR"落雷斧"NOR,({"axe"}));

	set_weight(2000);

        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit","把");
		set("long", "怪斧落雷\n");
		set("material","blacksteel");
		set("value",500000);
    	} //end of else
    	
	init_axe(1000);
	

set("wield_msg",HIY"斧中神怪大喝一声:该死的家伙,$n"HIY"显于$N手中。\n"NOR);
	set("unwield_msg",HIC"巨斧划空而去.自$N手中消失，$n"HIC"变成飞龙...。\n"NOR);
	
	setup();
}
