#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create() {
  set_name(HIW "光之铠" NOR, ({ "shiny armor", "armor" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "勇者专用铠甲,如果你套上这件铠甲,请你勿辱没了勇者知名。\n");
    set("material", "blacksteel");
    set("value", 10000);
    set("armor_type", "armor");
    set("armor_prop/armor", 100);
    set("armor_prop/move", 100);
    set("armor_prop/dodge", 100);
  }
  setup();
}
