// kame_suit.c
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(HIM "勇者之盾" NOR, ({ "worrior shield", "shield" }));
  set_weight(2000);
  set("gender_only", "男性");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "勇者的盾牌,能抵挡一定的攻击。\n");
    set("unit", "面");
    set("value", 10000);
    set("material", "blacksteel");
    set("armor_type", "shield");
    set("armor_prop/armor", 100);

  }
  setup();
}
