#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIC "威风靴" NOR,({"wind boots","boots"}));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit","双");
    set("long","一双奇怪的靴子,末端用奇异的羽毛点缀。\n");
    set("material","blacksteel");
    set("value",10000);
    set("armor_type","boots");
    set("armor_prop/move",100);
    set("armor_prop/dodge",100);
    set("armor_prop/armor",100);
       }
  setup();
}
