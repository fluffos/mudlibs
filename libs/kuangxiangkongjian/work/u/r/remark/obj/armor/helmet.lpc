#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
     set_name(BLU "勇者头盔" NOR,({"worrior_helmet","helmet"}));
     set_weight(500);
     set("armor_type","head");
     if( clonep() )
       set_default_object(__FILE__);
     else {
       set("unit","顶");
       set("long","一顶为未来勇者设计的头盔。\n");
       set("material","blacksteel");
       set("value",100000);
       set("armor_prop/armor",75);
       set("armor_prop/parry",75);
          }
     setup();
}

