// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("大肚酒瓶", ({ "flaqon" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "有点奇怪的大酒瓶,但是好像装着好喝的美酒\n");
		set("unit", "瓶");
		set("value", 1000);
		set("max_liquid",105);
                set("no_action","fill");
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
		"name": "葡萄酒",
		"remaining":105,
		"drunk_apply": 33,
	]) );
	setup();
}
