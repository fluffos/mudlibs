inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIM"jessica 的日记"NOR, ({ "diary" }) );
	set("board_id", "diary");
	set("long",HIW" 
       
               岁月带走青春的脸庞,就好像风一样轻轻地吹过,
               但对绚丽的过往丝毫无损,只是在当时扬起一波涟漪,
               回忆过往的趣事,知心的好友,快乐的时光,
               就让千万个心事,尽付方格里\n
"NOR );
	setup();
}
