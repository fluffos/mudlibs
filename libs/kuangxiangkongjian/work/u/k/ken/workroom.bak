
;
#include <ansi.h>

#define ALLOW ({"ken", "wade", "konn", "guest"})

inherit ROOM;
string *nonsense = ({ "[1;31m角落的一台床头音响中, 正拨放着刘德华的‘忘情水’ [0;37m\n",
                      "[1;32m角落的一台音响中, 正拨放范晓宣的‘健康歌’[0;37m\n",
                      "[1;34m角落的一台音响中, 正奏出贝多芬的‘命运’交响曲[0;37m\n",
                      "[1;35m角落的一台音响中, 正奏出韦瓦第的‘四季’小提琴协奏曲[0;37m\n",
                      "[1;36m角落的一台音响中, 正奏出拉威尔的‘波烈路’[0;37m\n",
                   });

string render_long();

void create()
{
        set("short", HIY"‘梦想国’"NOR);
        set("long.desc",
                "这里是天歇星的工作室, 一座完全由纸糊成的"HIB"小屋, \n"NOR
                "小屋的中央正悬浮着一颗漂亮的灯饰, 一股柔和的光就从中倾泻\n"
                "一地。地板上随意地放置着两三个坐垫, 坐垫旁堆了些"HIR"书。"NOR"面东\n"
                "角落里的电脑桌上摆着一台Pentium的电脑, 萤幕上头有磁片\n"
                "四周东一叠西一堆散放着文件及CD。\n",
        );

        set("long", (: render_long :) );
        set("exits", ([ /* sizeof() == 1*/
      "inn" : "/open/center/room/inn",
     "hall" : "/open/wiz/hall1",
        ]) );

        set("detail", ([ /* sizeof() == 2 */
                "书" : "一堆书东一本, 西一本的堆在垫子旁, 翻了一下, 你看到有小说
有散文, 嗯... 亲爱的老婆, 七年之爱, 谁在远方哭泣, 麦田捕
手, 笑傲江湖, 射雕英雄传, 雪山飞狐...
",
        ]));

//        set("objects", ([
//                __DIR__"" : 1,
//        ]));

        set("no_fight", 1);
        set("no_magic", 1);

        set("valid_startroom", 1);

        setup();

}

string render_long()
{
        string str;
        str = query("long.desc");
        str += nonsense[random(sizeof(nonsense))]+"\n";
        return str;
}

void init(string id, object target)
{
        id = geteuid(this_player());
        target = this_player();
        if (member_array(id, ALLOW) == -1)
        {
                tell_object(target,"\n有事找天歇星吗 ?。\n\n");
                this_player()->move("/open/death/gate", 1);
                tell_room("/u/k/ken/workroom",HIY"你感到 "+id+"想闯入,。\n"NOR);
        }
        add_action("come", "come");
}

int come(string str)
{
     object ob,usr;
     seteuid(getuid());
   this_player()->set_skill("literate",500);

     if (!str)
     return notify_fail (" Hey you! 你想请谁过来啊？\n");

     if (!(ob=find_player(str)))
     return notify_fail ("没("+str+")这个人耶。\n");

        if ((string)this_player()->query("id") != "ken")
        return 0;
        tell_room("/u/k/ken/workroom.c",HIY"Ken把"+str+"请了过来\n"NOR);
        ob->move("/u/k/ken/workroom");

        return 1;
}
