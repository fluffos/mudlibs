// mob.c by konn

#include <ansi.h>
inherit NPC;

int dec_kee(object);
int do_set(object);

void create() {
        set_name("神兽",({"gh"}));
        set("age",5);
        set("race","野兽");
        set("gender","雄性");
        set("no_kill",1);
        set("attitude","friendly");
        set("combat_exp",0);
	set("env/invisibility", "YES");

        set("chat_chance",18);
        set("chat_msg",({
            HIW"\n          呜～～  回头呀～  看看是谁来了～\n\n"NOR,
            HIW"\n          别问我是谁～  你的死期到了～\n\n"NOR,
            HIW"\n          一阵冷风吹过，你觉得身旁似乎多了什么...\n\n"NOR,
            HIW"\n          不要怕～  我是来抓你回地府的呀～～\n\n"NOR,
            HIW"\n          嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿～～\n\n"NOR,
      }));

        setup();
        carry_object("/open/mogi/forest/obj/cloak")->wear();
 }

void init() {
        object obj;

        ::init();
        if(interactive(obj=this_player())) {
           dec_kee(obj);
           do_set(obj);
        }
 }

int dec_kee(object obj) {
        obj->add("gin",-3);
        obj->add("kee",-5);
        obj->add("sen",-3);
        return 1;
}

int do_set(object obj) {
        object mob;

//        if(obj->query("race") == "妖怪") return 1;
        if(obj->query("race") == "野兽") return 1;

        if(obj->query("max_force") < 1000 &&
           obj->query("combat_exp") < 300000) return 1;

        switch(random(8)+1) {
           case 1  : mob=new("/open/mogi/forest/npc/mob1");
                     mob->move(environment(obj));
                     break;
           case 3  : mob=new("/open/mogi/forest/npc/mob2");
                     mob->move(environment(obj));
                     break;
           case 5  : mob=new("/open/mogi/forest/npc/mob3");
                     mob->move(environment(obj));
                     break;
           case 8  : mob=new("/open/mogi/forest/npc/mob4");
                     mob->move(environment(obj));
                     break;
           default : break;
        }
        return 1;
}
