inherit F_CLEAN_UP;

int main() {
  object *who;
  string name;
  int max_hp, max_sp, max_tp, i;
  shout("奉天承运，皇帝诏曰，辛苦的人们啊，\n");
  shout("应始皇的要求，恢复你们的体力吧！\n");

  who = filter_array(users(), "filter", this_object(), previous_object());
  for (i = 0; i < sizeof(who); i++) {
    if (objectp(who[i])) {
      name = (string)who[i]->query("name");
      max_hp = find_player(name)->query("max_hp");
      max_sp = find_player(name)->query("max_sp");
      max_tp = (int)find_player(name)->query_level() * 50;
      find_player(name)->set("hit_points", max_hp);
      find_player(name)->set("spell_points", max_sp);
      find_player(name)->set("talk_points", max_tp);
      find_player(name)->set("bleeding", 0);
    } else return 1;

  }
  return 1;
}
