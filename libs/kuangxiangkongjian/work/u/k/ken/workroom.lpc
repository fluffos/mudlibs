
#include <ansi.h>

#define ALLOW ({"ken", "darkforce", "lum", "konn", "cage", "cgy"})
inherit ROOM;
string *nonsense = ({ "[1;31m角落的一台床头音响中, 正拨放着刘德华的‘忘情水’ [0;37m\n",
                      "[1;32m角落的一台音响中, 正拨放范晓宣的‘健康歌’[0;37m\n",
                      "[1;34m角落的一台音响中, 正奏出贝多芬的‘命运’交响曲[0;37m\n",
                      "[1;35m角落的一台音响中, 正奏出韦瓦第的‘四季’小提琴协奏曲[0;37m\n",
                      "[1;36m角落的一台音响中, 正奏出拉威尔的‘波烈路’[0;37m\n",
                   });

string render_long();

void create()
{
        set("short", HIB"§ 蜀山～太极殿 §"NOR);
        set("long.desc",
            "\n经过了长途跋涉，翻过了丛山峻岭，终于来到了传说中的武学圣地"HIY"－ 蜀山 －。\n"NOR
            "您现在所站的位置是位于蜀山山顶的"HIG"【 太极殿 】。\n"NOR
            "而此处也就是"HIW"独孤剑神"HIB" － 天蝎星 －"NOR"所居住的宫殿。蓝天独自隐居于蜀山之\n"
            "中，浅心钻研剑术，平时甚少过问世俗之事。蜀山地形险恶，一般人不易登\n"
            "顶，但只要有心人能克服重重困难，来到太极殿求助于蓝天，嫉恶如仇的蓝\n"
            "天只要是维护正义真理之事，一定会义不容辞的帮忙。\n"
            "在太极殿入口处有一"HIR"石碑(memorial)"NOR"，您可以仔细看看里面写些什么？..\n"
            "而若有事求助于天蝎星，或只是想跟他打屁时，您可进去(enter)拜访他。\n",
        );

        set("light_up",10000);
        set("long", (: render_long :) );
        set("exits", ([ /* sizeof() == 1*/
                "hall" : "/open/wiz/hall1",
        ]) );


//        set("objects", ([
//                __DIR__"" : 1,
//        ]));


        set("valid_startroom", 1);

        setup();

}

string render_long()
{
        string str;
        str = query("long.desc");
        str += nonsense[random(sizeof(nonsense))]+"\n";
        return str;
}

void init(string id, object target)
{
        id = geteuid(this_player());
        target = this_player();
        if (member_array(id, ALLOW) == -1)
        {
                tell_object(target,"\n有事找天歇星吗 ?。\n\n");
                this_player()->move("/open/death/gate", 1);
                tell_room("/u/k/ken/workroom",HIY"你感到 "+id+"想闯入,。\n"NOR);
        }
        add_action("come", "come");
}

int come(string str)
{
     object ob,usr;
     seteuid(getuid());
     if (!str)
     return notify_fail (" Hey you! 你想请谁过来啊？\n");

     if (!(ob=find_player(str)))
     return notify_fail ("没("+str+")这个人耶。\n");

        if ((string)this_player()->query("id") != "ken")
        return 0;
        tell_room("/u/k/ken/workroom.lpc",HIY"Ken把"+str+"请了过来\n"NOR);
        ob->move("/u/k/ken/workroom");

        return 1;
}
