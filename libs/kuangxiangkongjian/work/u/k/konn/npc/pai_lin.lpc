//secret.c

inherit NPC;

void create()
{
          set_name("晓晓",({"secret"}) );
          set("long","她是风灵的大学时代初恋情人！\n");
          set("nickname","短发黑美人");
          set("title","风灵的初恋情人");

          set("age", 20 );
          set("int", 30 );
          set("cps", 28 );
          set("str", 28 );
          set("cor", 25 );
          set("spi", 30 );
          set("con", 26 );
          set("kar", 29 );
          set("per", 30 );

          set("force", 800 );
        set("combat_exp",200000);
          set("max_force", 800 );
          set("race","人类");
          set("gender","女性");
          set("limbs",({"柔颈","玉手","玉足","小腹","纤腰"}) );
          set("attitude","peaceful");

          set_skill("dodge",80);
          set_skill("parry",70);
          set_skill("move",60);
          set_skill("unarmed",100);
set_skill("six-fingers",80);
map_skill("parry","six-fingers");
   map_skill("unarmed","six-fingers");
          set_skill("force",80);

        set("chat_chance",10);
          set("chat_msg",({
      "晓晓道 : 只是一颗星罢了!\n"+
                    "在无边的黑暗里\n"+
                    "已写尽了宇宙的寂寞。\n",
      "晓晓道 : 啊!星子们都美丽\n"+
                "而梦中也响着的,\n"+
                "袛有一个名字\n"+
                "那名字, 自在的如流水.....\n",
      "晓晓道 : 夜深风竹敲秋韵, 万叶千声都是恨.\n"+
                "人生自是有情痴, 此事不关风与月.\n",
      "晓晓道 : 如果沉默是你的悲抑\n"+
                "你知道这悲抑\n"+
                "最伤我心..........\n" }) );

          set("chat_chance_combat",25);
          set("chat_msg_combat",({
                                 }) );
          set("inquiry",([
          "风灵" : "你问这个做什么? \n"+
                   "他现在很忙哦!\n"+
                   "如果你要找他, 可以mail y824364@fcusqnt.fcu.edu.tw \n"+
                   "有问题的话最好去找其它的wiz, 巫师都很和善的说!\n"+
                   "重点是..风灵笨笨，你不懂的他不一定懂！\n ",
          "name" : "小女子名叫晓晓, 请多多指教! \n",
          "here" : "这里是风灵的涂鸭坊啦! \n ",
          "黑美人" : "那是风灵为我取的昵名! \n ",
          "昵名" : "讨厌！别问这档事！长的不太白，又不是我的错！\n",
          "蛋蛋" : "他是风灵的好朋友!不是二十八天来一次的那种哦!\n"
          ]) );

    setup();
             carry_object("/u/l/lopo/obj/nee1.lpc")->wield();
             carry_object("/u/l/lopo/obj/nee2.lpc")->wield();
             carry_object("/u/l/lopo/obj/i_cloth.lpc")->wear();
             carry_object("/u/l/lopo/obj/i_arm.lpc")->wear();
             carry_object("/u/l/lopo/obj/i_belt.lpc")->wear();
             carry_object("/u/l/lopo/obj/i_hat.lpc")->wear();
             carry_object("/u/l/lopo/obj/i_boots.lpc")->wear();
             add_money("gold",5);
}


