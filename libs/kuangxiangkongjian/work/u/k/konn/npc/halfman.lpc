#include <ansi.h>
#include "/open/open.h"
inherit NPC;

void create()
{
        set("name","分身");
        setup();
}
void init()
{
        this_object()->set_heart_beat(1);
        if(this_player()->query_temp("kill")== 1){
        command("say 哈哈哈,~~~纳命来吧!");
        kill_ob(this_player());}
        ::init();
 }

void heart_beat()
{
        object me;
        set_heart_beat(1);
        if(me = find_player(query("master")))
           if(!me->is_fighting())
              destruct(this_object());
}
