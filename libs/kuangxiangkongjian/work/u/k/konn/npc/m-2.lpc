// mob1.c by konn

#include <ansi.h>
inherit NPC;

int kill_him(object);

void create() {
        set("title","魔界恶妖");
        set_name(HIR"不死火妖"NOR,({"fire ghost","ghost"}));
        set("long",
            "它看起来一副饥饿难忍的样子，上下甩动它的双爪。
你心里突然冒出一个念头，那就是「闪”！！\n");
        set("age",1995);
//        set("race","妖怪");
        set("race","野兽");
        set("gender","雄性");
        set("attitude","friendly");
        set("max_gin",580);
        set("max_kee",1100);
        set("max_sen",200);
        set("max_force",1500);
        set("force_factor",5);
        set("combat_exp",2000000);

        set_skill("unarmed",80);
        set_skill("dodge",90);
        set_skill("move",100);
        set_skill("parry",110);

        set("limbs",({"头部","胸部","双爪","鬼脚","背部","腰部"}));
        set("verbs",({"bite","claw"}));

        set("chat_chance_combat",30);
        set("chat_msg_combat",({
            HIR"\n          不死火妖狠狠的瞪了你一眼！\n\n"NOR,
            HIW"\n          不死火妖看起来想把你烤了来吃！\n\n"NOR
      }));

        setup();
 }

void init() {
        object obj;

        ::init();
        if(interactive(obj=this_player()) && !is_fighting()) {
           remove_call_out("kill_him");
           call_out("kill_him",0,obj);
        }
 }

int kill_him(object obj) {
//        if(obj->query("race") == "妖怪") return 1;
        if(obj->query("race") == "野兽") return 1;
        if(obj->query("max_force") > 999 ||
           obj->query("combat_exp") > 399999)
           command("kill "+obj->query("id"));
        return 1;
 }
