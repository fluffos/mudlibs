#include <ansi.h>

inherit NPC;

void create()
 {
        set_name("刘进泉",({"chuan liu","chuan","liu"}));
        set("long","
他是银针门掌门的大徒弟。自幼便同华灵向林云青学习医许N。可别看他\n
长得瘦小，施起医术来可也令人敬佩万分。你若对银针门有疑问可以问\n
他，他会不厌其烦的为你解答。

");

        set("gender","男性");
        set("class","doctor");
        set("nickname","无影针");
        set("combat_exp",600000);
        set("attitude","heroism");
        set("age",35);
        set("title","银针门首徒");
                set("str",19);
                set("cor",24);
                set("cps",29);
                set("per",20);
                set("int",17);
                set("con",20);
                set("spi",26);
                set("kar",20);

        set("force",700);
        set("max_force",700);
        set("force_factor",5);

        set_skill("move",40);
        set_skill("literate",30);
        set_skill("cure",60);
        set_skill("dagger",40);
        set_skill("poison",50);
        set_skill("force",50);
        set_skill("dodge",60);
        set_skill("parry",40);
        set_skill("unarmed",40);
        set_skill("hammer",40);
        set_skill("stabber",60);

        set_temp("apply/attack",40);
        set_temp("apply/move",100);
        set_temp("apply/dodge",100);
        set_temp("apply/parry",100);
        set_temp("apply/armor",100);

        set("inquiry",([
      ]));

        set("chat_chance_combat",4);
        set("chat_msg_combat",({
            HIY"刘进泉说道: 真的要打吗? 你恐怕不是我的对手吧!\n"NOR,
            HIY"刘进泉说道: 就让你嚐嚐苦头吧! 好让你知道天有多高地有多厚!\n"NOR,
      }));

        setup();

        carry_object("/u/l/lopo/obj/nee1")->wield();
        carry_object("/u/l/lopo/obj/leg1")->wear();
        carry_object("/u/l/lopo/obj/i_hat")->wear();
        carry_object("/u/l/lopo/obj/i_belt")->wear();
        carry_object("/u/l/lopo/obj/i_cloth")->wear();
        carry_object("/u/l/lopo/obj/i_boots")->wear();
        carry_object("/u/l/lopo/obj/hands1")->wear();
        carry_object("/u/l/lopo/obj/neck1")->wear();
//        carry_object("/u/l/lopo/obj/wrist1")->wear();

        add_money("gold",5);
 }
