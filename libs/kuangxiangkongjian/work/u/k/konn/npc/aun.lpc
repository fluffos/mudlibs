//eeg.c
inherit NPC;

void create()
{
          set_name("蛋蛋",({ "eeg"}) );
          set("long","他是风灵的BBS网友！是他带风灵玩MUD的....
风灵的成绩一落千丈也是因为MUD的缘故!\n");
          set("nickname","书呆子");
          set("title","风灵的网友");

          set("age",22);
          set("int",30);
          set("cps",28);
          set("str",28);
          set("cor",25);
          set("spi",30);
          set("con",26);
          set("kar",29);
          set("per",30);

          set("force",1000);
          set("combat_exp",80000);
          set("max_force",800);
          set("race","人类");
          set("gender","男性");
          set("limbs",({"蛋头","蛋手","蛋脚","蛋背","蛋腹","蛋腰"}) );
          set("attitude","peaceful");

          set_skill("dodge",80);
    set_skill("unarmed",100);
    set_skill("six-fingers",90);
//  map_skill("dodge","six-fingers");
    map_skill("unarmed","six-fingers");
          set_skill("parry",70);
          set_skill("force",80);


          set("inquiry",([
          "风灵" : "你问这个做什么? \n"+
                   "他现在很忙哦!\n"+
                   "如果你要找他, 可以mail y824364@fcusqnt.fcu.edu.tw \n"+
                   "有问题的话最好去找其它的wiz, 巫师都很和善的说!\n",
          "晓晓" : "那是风灵的初恋情人! \n"+
                   "他们好像没有结果\n"+
                   "风灵对追女孩子不内行\n"+
                   "有空你要多教教他\n ",
                         ]) );
    setup();
              carry_object("/u/l/lopo/obj/i_whip.lpc")->wield();
              carry_object("/u/l/lopo/obj/i_cloth.lpc")->wear();
              carry_object("/u/l/lopo/obj/i_belt.lpc")->wear();
              carry_object("/u/l/lopo/obj/i_hat.lpc")->wear();
              carry_object("/u/l/lopo/obj/i_boots.lpc")->wear();

}


