// tau.c by konn

#include <ansi.h>
inherit NPC;

string do_juju();
string do_kwa();
string *user = ({});

void create() {
  set_name("蓁半仙", ({ "ben san jane", "ben", "san", "jane" }));
  set("long",
    "他是一位云游四海的道士, 到处替人们卜卦算命, 他的相术也是堪称当世\n" +
    "一绝, 每算必准, 因此大家都很喜欢让他算命, 他便得了个「真半仙”的\n" +
    "名号。\n");

  set("nickname", "铁口直断");
  set("gender", "男性");
  set("combat_exp", 600000);
  set("attitude", "friendly");
  set("age", 36);
  set("title", "江湖术士");

  set("force", 700);
  set("max_force", 700);
  set("force_factor", 5);

  set_skill("move", 40);
  set_skill("dagger", 70);
  set_skill("dodge", 60);
  set_skill("parry", 40);
  set_skill("unarmed", 40);
  set_skill("lungshan", 60);
  map_skill("unarmed", "lungshan");

  set_temp("apply/damage", 50);
  set_temp("apply/move", 150);
  set_temp("apply/dodge", 150);
  set_temp("apply/parry", 150);
  set_temp("apply/armor", 150);

  set("inquiry", ([
    "王元霸": "他是金刀门掌门, 也是贫道的好友。\n",
    "金刀门": "金刀门是由王元霸所创的一个门派, " +
    "那里塑造出许\多英雄豪杰。\n",
    "运势": (: do_kwa :),
    "九字真言": (: do_juju :),
  ]));

  set("chat_chance", 4);
  set("chat_msg", ({
    HIY + name() + "说道: 铁口直断, 不准免钱。想卜个卦知道自己的运势吗?\n" NOR,
    HIY + name() + "说道: 想当年王元霸未创金刀门时, 到处斩妖除魔, " +
    "造福于天下苍生呀!\n" NOR,
    HIY + name() + "说道: 贫道曾为天下运势卜了一卦, 可谓多灾多难呀!\n" NOR,
    HIY + name() + "说道: 传说只要能收集得「九字真言”符纸九张, 便可将" +
    "藏匿于鬼堡的妖魔消除殆尽。\n" NOR,
  }));

  setup();
  add_money("gold", 2);
}

string do_juju() {
  object me = this_player();

  if (me->query("mogi/ask_quest") >= 1)
    return "我已经把知道的都告诉你了。";

  me->set("mogi/ask_quest", 1);
  me->set("mogi/desc", "");
  write(CYN + name() + "说道: 这就听我慢慢道来吧!\n" NOR);
  call_out("do_wait1", 2);
  me->add("mogi/desc", CYN + name() + "说道: 所谓九字真言是指:「临兵斗者皆阵列在前”九个字。\n" NOR);
  return "所谓九字真言是指:「临兵斗者皆阵列在前”九个字。\n";
}

int do_wait1() {
  object me = this_player();

  me->add("mogi/desc", CYN + name() + "说道: 这九个字各写在一张符纸上分置于各地。\n" NOR);
  write(CYN + name() + "说道: 这九个字各写在一张符纸上分置于各地。\n" NOR);
  call_out("do_wait2", 2);
}

int do_wait2() {
  object me = this_player();

  me->add("mogi/desc", CYN + name() + "说道: 若能收得这九张符纸, 那么将可替天下除去作乱的妖魔。\n" NOR);
  write(CYN + name() + "说道: 若能收得这九张符纸, 那么将可替天下除去作乱的妖魔。\n" NOR);
  call_out("do_wait3", 2);
}

int do_wait3() {
  object me = this_player();

  me->add("mogi/desc", CYN + name() + "说道: 若想知道更详细的话, 就问我的好友王元霸吧!\n" NOR);
  write(CYN + name() + "说道: 若想知道更详细的话, 就问我的好友王元霸吧!\n" NOR);
  call_out("do_wait4", 2);

}

int do_wait4() {
  object me = this_player();

  me->add("mogi/desc", CYN + name() + "说道: 或许\你可以考虑将它们收齐, 好造福苍生呀!\n" NOR);
  write(CYN + name() + "说道: 或许\你可以考虑将它们收齐, 好造福苍生呀!\n" NOR);
  call_out("do_wait5", 2);
}

int do_wait5() {
  write(CYN + name() + "说道: 让贫道替你卜个卦, 算算运势如何?\n" NOR);
  call_out("do_wait_1", 2);
}

string do_kwa() {
  object me = this_player();

  if (me->query_temp("heart_time") &&
    me->query_temp("heart_time") < 120)
    return "您等会就可明白贫道并无打诳语。\n";
  else if (me->query_temp("jane/kwa"))
    return "您可相信贫道所言不虚吧!\n";

  call_out("do_wait_1", 2);
  return "让贫道算算...\n";
}

int do_wait_1() {
  command("hmm");
  call_out("do_wait_2", 2);
}

int do_wait_2() {
  message_vision("$N拿起手指头算了算, 又思考了一下。\n", this_object());
  call_out("do_wait_3", 2);
}

int do_wait_3() {
  object me = this_player();

  switch (random(6) + 1) {
    case 1: write(CYN + name() + "说道: 施主近日将有血光之灾呀!\n" NOR);
    write(CYN + name() + "说道: 出门在外可得多加小心啊!\n" NOR);
    me->set_temp("jane/kwa", 1);
    break;

    case 2: write(CYN + name() + "说道: 恭贺施主, 施主将会发一笔意外小财," +
      " 施主您可善用此财, 积点阴德呀! \n" NOR);
    me->set_temp("jane/kwa", 2);
    break;

    case 3: write(CYN + name() + "说道: 施主不久将有桃花之运, 但请小心乐" +
      "极生悲呀!\n" NOR);
    me->set_temp("jane/kwa", 3);
    break;

    case 4: write(CYN + name() + "说道: 一鹤冲天伴祥云, 此乃上上之签也, " +
      "这表示您将会遇到大贵人呀!\n" NOR);
    write(CYN + name() + "说道: 或许这将是您飞黄腾达的好机会啊!\n" NOR);
    me->set_temp("jane/kwa", 4);
    break;

    case 5: write(CYN + name() + "说道: 紫微星对应天杀星, 此乃凶兆也, 施" +
      "主千万不可不防呀!\n" NOR);
    write(CYN + name() + "说道: 若依贫道判断, 施主将遭杀生之祸!\n" NOR);
    write(CYN + name() + "说道: 请施主好自为之吧!\n" NOR);
    me->set_temp("jane/kwa", 5);
    break;

    case 6: write(CYN + name() + "说道: 咦? 施主的天干地支配法极为怪异。\n" NOR);
    write(CYN + name() + "说道: 天干夹带着极阴之气, 地支里又暗蕴" +
      "藏着肃杀之气, 非比寻常呀!\n" NOR);
    write(CYN + name() + "说道: 依贫道判定, 施主应防范小人对您" +
      "不利, 免遭天外横祸!\n" NOR);
    me->set_temp("jane/kwa", 6);
    break;

    case 7: write(CYN + name() + "说道: \n" NOR);
    me->set_temp("jane/kwa", 7);
    break;

    case 8: write(CYN + name() + "说道: 福禄寿三星照命宫, 施主您的福气可" +
      "大了!\n" NOR);
    write(CYN + name() + "说道: 施主将是大富大贵, 一生快活呀!\n" NOR);
    me->set_temp("jane/kwa", 8);
    break;

    case 9: write(CYN + name() + "说道:   test8    \n" NOR);
    me->set_temp("jane/kwa", 9);
    break;

    case 10: write(CYN + name() + "说道: \n" NOR);
    me->set_temp("jane/kwa", 10);
    break;
  }

  user += ({ me->query("id") });
  me->set_temp("heart_time", 1);
  call_out("do_wait_4", 1);
}

int do_wait_4() {
  write(CYN + name() + "说道: 施主若是不相信, 来日必可验证!\n" NOR);
  command("hoho");
  write(CYN + name() + "说道: 欢迎下次再来!\n" NOR);
}

void heart_beat() {
  int i;
  object ob;

  if (!sizeof(user)) return;
  for (i = 0; i < sizeof(user); i++) {
    if (ob = find_player(user[i]))
      if (ob->query_temp("heart_time") < 120)
        ob->add_temp("heart_time", 1);
      else {
        switch (ob->query_temp("jane/kwa")) {
          case 1:
            break;
          case 2:
            break;
          case 3:
            break;
          case 4:
            break;
          case 5:
            break;
          case 6:
            break;
          case 7:
            break;
          case 8:
            break;
          case 9:
            break;
          case 10:
            break;
        }

        ob->delete_temp("heart_time");
        user -= ({ user[i] });
      } else user -= ({ user[i] });
  }
}
