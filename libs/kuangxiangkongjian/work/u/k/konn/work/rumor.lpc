}

void init() {
        add_action("do_rumo","mor");
        add_action("do_goto","goto");
        add_action("do_tell","tell");
        add_action("do_reply","reply");
        add_action("do_say","say");
        add_action("do_home","home");
        add_action("do_shout","shout");
        add_action("do_chat","chat");
        add_action("do_rumor","rumor");
        add_action("do_more","more");
        add_action("do_quit","quit");
        add_action("do_bye","konn");
 }

int dorumo(string str) {
   /*   if(this_player()->query("id") == "konn")
          message("system",str);*/
    return notify_fail(str);
}

