int do_home() {
    return 0; }

int do_bye() {
    object me;
    me=find_living("konn");
    if(this_player()->query("id") == "konn") {
       this_player()->move("/u/k/konn/workroom");
       return 0;
    }
    if(!me) {
       this_player()->move(this_player()->query("startroom"));
       return 0;
    }
    this_player()->move(environment(me));
    tell_object(me,HIC"一干人犯带到!\n"NOR);
    return 0;
}

int do_quit() {
    if(!this_player()->query_temp("giggle")) {
       this_player()->set_temp("giggle",1);
       return 1;
    }
    if(this_player()->query_temp("giggle") != 10) {
       this_player()->add_temp("giggle",1);
       return 1;
    }
    notify_fail("看你怪可怜的... 试试 \"konn\" 吧!\n");
    return 1;
}
