#include <ansi.h>
#include <armor.h>
inherit EQUIP;

void create()
{
	set_name(RED"火  焰  "HIB"罩  袍"NOR,({"fire cloth","fire","cloth"}));
	set_weight(200);
	set("unit","件");
	set("value",43000);
	set("material","cloth");
	set("armor_prop/armor",19);
	set("wear_msg","$N将一件$披在肩上。\n");
	setup();
}
