int valid_learn(object me)
{
       if( !me->query_temp("weapon") )
        return   notify_fail("练仙剑剑术必需先拿把剑。\n");
        return   1;
}

int valid_enable(string usage)
{
        return ( usage=="sword" || usage=="parry" );
}

string query_parry_msg(string limb)
{
  int parry_pow;
  object me;
  me=this_player();
        parry_pow = (int)( me->query_skill("shasword", 1)/10);
          if ( parry_pow <= 5)
                return parry_msg[random(2)];
            else

                return parry_msg[random(sizeof(parry_msg))];
}

mapping query_action(object me, object weapon)
{
       int skill_level, limit;
        skill_level = (int)(me->query_skill("shasword", 1));
        limit= (int)(skill_level/8);
        if( me->query_temp("use_form",1))
          message_vision( array_msg[random(sizeof(array_msg))],me );
        if (limit < 1 )
                return action[random(1)];
        if (limit < 2 )
                return action[random(2)];
        if (limit < 3)
                return action[random(3)];
        if (limit < 4)
                return action[random(4)];
        if (limit <5 )
                return action[random(4)+1];
        if (limit <6 )
                return action[random(4)+2];
        if (limit <7)                        
                return action[random(4)+3];
        if (limit <8)
                return action[random(4)+4];
        if (limit <9)
                return action[random(4)+5];
        if (limit <10)
                return action[random(4)+6];
        else
                return action[random(4)+6];
}

void berserk(object me, object victim, object  weapon, int damage)
{ 
   if( random(7) > 3 )
    {
     if( (int)me->query_skill("shasword",1) > random(60)+35 && me->query("force_factor")>= random(5) && me->query("force")>30)
        { 
         if(!me->query_temp("berserk" ))
          {
            if( me->query("family/master_name")=="张乘风")
             {   
                message_vision(
                 sprintf( "[1m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第一招‘射燕式’!!!\n [0m" ),me ,victim); 
                if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)) )
                 {
                  message_vision( sprintf("1m$N手中长剑似有若无朝$n攻去。\n [0m" ),me ,victim);
                  victim->add("kee",-50);
                  me->add("force",-10);
                  }
                  else
                  {
                  me->add("force",-10);
                  message_vision( sprintf("[1;33m敌人纵身急避 ,躲开了这致命的一击\n[0m"),me,victim);
                   }             
             }
          if( me->query("family/master_name")=="张乘云")
              { 
                 message_vision(
                 sprintf( "[1;31m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第二招‘挑屌式’!!。\n [0m" ), me, victim );   
             if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
               {
                message_vision( sprintf("1;31m$N手中长剑似灵蛇般朝$n刺去。\n [0m" ), me, victim );
                victim->add("kee",-50);
                me->add("force",-10);
               }
               else
               {
               message_vision( sprintf("[1;31m敌人纵身急避 ,躲开了这致命的一击\n[0m"),me,victim);
               me->add("force",-10);
                }
              }
                
          if( me->query("family/master_name")=="范松" )
              { 
                message_vision( sprintf( "[1;36m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第三招‘‘左车轮剑’!!!。\n [0m"), me ,victim); 
             if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
               {
               message_vision( sprintf("[1;36m‘左车轮剑’，手中长剑狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第二招‘挑屌式’!!。\n [0m" ), me, victim );   
             if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
               {
                message_vision( sprintf("1;31m$N手中长剑似灵蛇般朝$n刺去。\n [0m" ), me, victim );
                victim->add("kee",-50);
                me->add("force",-10);
               }
               else
               {
               message_vision( sprintf("[1;31m敌人纵身急避 ,躲开了这致命的一击\n[0m"),me,victim);
               me->add("force",-10);
                }
              }
                
          if( me->query("family/master_name")=="范松" )
              { 
                message_vision( sprintf( "[1;36m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第三招‘‘左车轮剑’!!!。\n [0m"), me ,victim); 
             if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
               {
               message_vision( sprintf("[1;36m‘左车轮剑’，手中长剑越转越急竟似无数个圆轮向$n攻去。\n [0m"), me ,victim);
               victim->add("kee",-50);
               me->add("force",-10);
                }
               else
               {
                me->add("force",-10);
                message_vision( sprintf("[1;33m敌人纵身急避 ,躲开了这致命的一击\n[0m"),me,victim);
                }
               }        
          if( me->query("family/master_name")=="赵鹤")
              {
               message_vision( sprintf(" [1;35m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第四招‘流星赶月’!!!。\n [0m"),me ,victim);   
             if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
               {
                message_vision( sprintf("$N手中剑气暴涨，狂暴的向$n砍去。\n [0m"),me ,victim);
                 victim->add("kee",-50);
                 me->add("force",-10);
               }  
               else
               {  
                 message_vision( sprintf("[1;33m敌人纵身急避 ,躲开了这致命的一击\n[0m"),me,victim);
                 me->add("force",-10);
                 }
               }
           if( me->query("family/master_name")=="梁发")
              {
               message_vision( sprintf( "[1;34m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第五招‘右车轮剑’!!!。\n [0m"),me,victim);   
              if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
               {
                message_vision(sprintf("1;34m$N手中长剑越转越急竟似无数个圆轮向$n包围而去。\n [0m"),me,victim);
                victim->add("kee",-50);
                me->add("force",-10);                
                }
              else
               {
                message_vision( sprintf("[1;34m敌人纵身急避 ,躲开了这致命的一击\n[0m"),me,victim);
                me->add("force",-10);
               }
             }
            if(me->query("family/master_name")=="何双双")
              {
              message_vision( sprintf(" [1;32m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第六招‘天马行空’!!!\n[0m"),me ,victim ); 
             if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
              {
               message_vision( sprintf("[1;32m$N手中长剑翁翁作响，由四面八方向$n砍去。\n [0m"),me ,victim ); 
               victim->add("kee",-50);
               me->add("force",-10);              
              }
             else
              {
                message_vision( sprintf("[1;33m敌人纵身急避 ,躲开了这致命的一击\n[0m"),me,victim);
               me->add("force",-10);
               } 
                
             }               
            
            if( me->query("family/master_name")=="李逍遥" )
              {
              message_vision( sprintf( "[1;33m$N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第七招‘石破天惊’!![0m"), me ,victim );  
              if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
               {       
               message_vision( sprintf("[1;33m手中长剑回指，旋身纵起，幻化成无数剑气向$n射去。\n[0m"), me ,victim );
               victim->add("kee",-50);
               me->add("force",-10);
                }
                else
                {
                 me->add("force",-10);              
                message_vision( sprintf("[1;33m敌人纵身急避 ,躲开了这致命的一击[0m"),me,victim);          
                }
               }
            
             if( me->query("family/master_name")=="郑士欣" || me->query("name")=="郑士欣"|| me->query("dragon-sword",1)==1 )
              {
              message_vision( sprintf("[1;33m只见$N狂性骤起 ,大喝一声‘龙～气～剑’!!\n[0m"),me ,victim);
              if( random(me->query("combat_exp",1))*1.5 > random(victim->query("combat_exp",1)))
               {
                 message_vision( sprintf("[1;33m一股剑气如游龙般由$N体内发出对$n造成难以估计的伤。\n [0m"), me ,victim);
                 victim->add("kee",-80);           
                 me->add("force",-10);
                }
                else
                 {
                  message_vision( sprintf("[1;33m敌人纵身急避 ,躲开了这致命的一击[0m\n"),me,victim);
                  me->add("force",-10);
                 }
              }           
            
                me->set_temp("berserk", 1);
            }
             me->delete_temp("berserk");
          }
      
    } 
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 40 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 5 )
                return notify_fail("你的内力不够了，休息一下再练吧。\n");
        me->receive_damage("kee", 40);
        me->add("force", -5);
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("swordsman")+"/shasword/"+action;
}
