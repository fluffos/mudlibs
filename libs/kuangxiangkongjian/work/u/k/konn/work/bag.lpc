// bag.c  made by konn

inherit ITEM;

void create()
{
        set_name("医者之袋",({"bag"}));
	set_weight(500);
        set_max_encumbrance(8000);

	if( clonep() )
		set_default_object(__FILE__);
	else {
           set("long", "这是一口医者的专用袋，可以用来装一些杂物。\n");
           set("unit","口");
           set("light_up",-1);
           set("no_drop",1);
           set("no_sell",1);
           set("no_give",1);
        }
        setup();
}

int is_container()
 { return 1; }

int query_autoload()
 { return 1; }
