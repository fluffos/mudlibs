// change.c 神奇转换器   source from lopo

#include <ansi.h>

inherit ITEM;

void create() {
  set_name("神奇转换器", ({ "change" }));
  set_weight(100);
  set("unit", "个");
  set("long", "这是一个用来改变你一生的机器");
  set("value", 100000);

  setup();
}

void init() {
  add_action("push_doing", "push");
}

int push_doing(string arg) {
  if (arg != "down") return 0;

  write("$N按下了神奇转换器，觉得似乎换了新面孔。\n", this_player());

