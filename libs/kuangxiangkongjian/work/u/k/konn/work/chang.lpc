#include <ansi.h>
inherit ITEM;
void create() {
  set_name("转换器", ({ "chang" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个用来转换名字，测试中");
    set("value", 500);
  }

  setup();
}

void init() {
  add_action("do_fire", "down");
}

int do_fire(string arg) {
  object me = this_player();
  if (!arg || arg != "chang") return 0;
  message_vision("$N按下了转换器，一时天摇地动。\n", me);
  this_player()->set("class", "poisoner");
  //         this_player()->set("nickname","");
  this_player()->set("age", 18);
  destruct(this_object());
  return 1;
}
