// d_blade.c made by Konn
#include <ansi.h>
#include <combat.h>
#include <weapon.h>
inherit BLADE;

string wield_msg();
string unwield_msg();

void create()
{
        set_name("[1;31m降[1;32m龙[1;33m刀"NOR, ({"dragon blade", "blade"}) );
        set("long", @TEXT
这是一把稀世宝刀, 另外还有一把「伏虎刃”, 这一对宝刀都是由金刀门之开
山鼻祖所铸炼出来的好刀, 如果握这把刀使「紫金六阳刀法”则可以使的更随
心所欲, 其精义将发挥的淋漓尽致.

TEXT);
        set_weight(2000);
	if( clonep() )
          set_default_object(__FILE__);
        else {
	  set("unit", "把");
          set("light_up", -1);
          set("no_sell", 1);
          set("material", "crimsonsteel");
          set("wield_msg", (: wield_msg :) );
          set("unwield_msg", (: unwield_msg :) );
	}
        init_blade(50);
        setup();
}

string wield_msg()
{
        string des;

        des = HIY"$N将$n"HIY"从背后抽出, $n"HIY"的刀身发出一道闪烁的"+
              "光茫.\n$N将$n"HIY"牢牢的握在手中.\n"+
              "一股强大的力量从$n"HIY"传送到$N的手臂.\n"+
              "$N的力量增强了!\n"NOR;
        if( this_player()->query_skill_mapped("blade") == "gold-blade" ) {
          des += HIW"$n"HIW"忽然发出低鸣声, 传说中的宝刀终于苏醒了.\n"NOR;
          set("wake", 1);
	}

        return des;
}

string unwield_msg()
{
        delete("wake");
        return HIY"$N将$n"HIY"插入背后的刀鞘, $n"HIY"的刀身发出的"+
               "光茫渐渐暗淡了.\n"+
               "缠在$N手上的一股强大力量也慢慢消失.\n"NOR;
}

void heart_beat()
{
        object me=this_player(), weapon;
        object *enemy;
        int i, lv;

	tell_object(this_player(), "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@\n");
        if( !query("wake") || !userp(me) || !me->is_fighting() ) return ;
        if( random(4) ) return ;
        weapon = me->query_temp("weapon");
        enemy = me->query_enemy();
        message_vision(name()+HIW"的刀气纵横, $N的力量提升了不少.\n"NOR, me);
        me->add("combat_exp", 500000);
        lv = me->query_skill("gold-blade", 1);
        me->set_skill("gold-blade", lv+50);
	tell_object(this_player(), "111111111111111111111111111111111111111\n");
        for(i=0; i<sizeof(enemy); i++)
          COMBAT_D->do_attack(me, enemy[i], weapon, TYPE_QUICK);
        me->add("combat_exp", -500000);
        me->set_skill("gold-blade", lv);
}

