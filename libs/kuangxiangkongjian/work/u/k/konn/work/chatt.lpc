// chatt.c by konn

#include <mudlib.h>
#include <ansi.h>

inherit ITEM;

void create() {
	set_name(HIC"聊天笔"NOR,({"konn pen","pen"}));
	set("long","这是咕哩咕哩猫的聊天用品!\n");
        set_weight(1);
        set("unit", "支");
        seteuid(getuid());
        set("no_sell",1);
        set("no_drop",1);

	setup();
}

void init() {
	add_action("do_chat","chat");
}

int do_chat(string str) {
	object me;
	me = this_player();
	if(me->query("id") != "konn") 
	   return notify_fail("你想作什么?\n");
	shout(HIM+str+"\n"NOR);
	tell_object(me,HIM+str+"\n"NOR);
	return 1;
}
