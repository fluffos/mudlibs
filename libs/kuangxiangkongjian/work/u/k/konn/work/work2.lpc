inherit ROOM;

void create()
{
        set("short", "新野城" );
        set("long", @LONG
                
              自从前方传来大败曹军的消息后,新野全城上下没有人不欢欣

鼓舞的,会议厅里更是热闹,军师正在论功行赏呢。门口突然传来马叫声,原来

是Shout 的爱驹‘黑神驹’在叫,相传日驰千里的黑神驹,只有Shout可以驾驭

他,你若不信你可以坐坐看喔(sit)!

LONG);
        set("exits", ([ /* sizeof() == 4*/
                "south" : __DIR__"work1.lpc",
                "up"    :"/u/wiz/entrance",
                "wade"  :"/u/l/wade/workroom",
                "lys"   :"/u/l/lys/workroom",
        ]));
        setup();
}

//input sit
void init()
{
   add_action("do_sit","sit");
}

//do sit
int do_sit()
{
   object siter;
   siter = this_player();

   write("你正准备上马而坐\n");
   tell_room(environment(siter),siter->query("name")+"神气八啦的坐在神驹上\n"
   ,({this_object(),siter}));
   tell_room(environment(siter),"突然黑神驹向发疯似的,将"+siter->query("name")+"活活的从马背上弹了出去。\n"
   ,({this_object(),siter}));
   message("system","你听到远方的新野城,传来了"+siter->name()+"的落马声...阿娘喂\n",user());
   message("system","新野城士兵大叫:该死的"+siter->name()+",\n竟敢偷骑黑神驹,你不知道那是我们世纪伟大聪明+英俊的咻咻叫,最疼爱的爱马吗!\n",user());
   write("你觉得五肢无力,竟然昏厥过去了....\n");
   siter->move(("/u/k/konn/workroom.lpc");
   write("自求多福吧....sigh\n");
   return 1;
}

