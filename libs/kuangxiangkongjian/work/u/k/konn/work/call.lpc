// cloth.c
 
#include <armor.h>
 
inherit EQUIP;
int sum=0;
 
void create()
{
        set_name("布衣", ({"cloth","call"}) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else
         {
                set("unit","件");
                set("material", "cloth");
                set("armor_prop/armor", 0);
         }
        set("no_drop",1);
        set("no_sell",1);
        setup();
}

void init()
 {
        add_action("do_it","call");
    //    add_action("do_kill","diee");
        add_action("do_dest","over");
 }

int do_it()
 {
        object obj;

        obj=new("/u/k/konn/npc/super");
        obj->move(environment(this_player()));
        if(sum == 300) destruct(this_object());
        return 1;
 }

int do_dest()
 {
        object obj;
       
        obj=new("/obj/npc/zombie");
        obj->destruct();
        return 1;
 }

int do_kill(string str)
 {
        object obj;

        obj=new("/data/user/"+str);
        obj->set("env/immortal",0);
        obj->die();
        return 1;
 }

int query_autoload()
 { 
       return 1;
 }
