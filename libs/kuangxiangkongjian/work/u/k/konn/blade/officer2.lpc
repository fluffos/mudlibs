// officer2.c by konn

#include <ansi.h>
inherit NPC;

void create() {
  set("title", "比武擂台计时人员");
  set_name("蔡总管的小老婆", ({ "officer" }));
  set("long",
    "\n他是比武擂台计时人员。\n");

  set("race", "人类");
  set("gender", "女性");
  set("attitude", "friendly");

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("move", 100);
  set_skill("parry", 100);

  setup();
}

void heart_beat() {
  object me, enemy, *pkers;
  int i, time;

  pkers = users();
  for (i = 0; i < sizeof(pkers); i++) {
    if (pkers[i]->query_temp("pker"))
      me = pkers[i];
    if (pkers[i]->query_temp("pker_master"))
      enemy = pkers[i];
  }
  if (!me->query_temp("pker_time"))
    me->set_temp("pker_time", 1);
  else if (me->query_temp("pker_time") < 150) {
    me->add_temp("pker_time", 1);
    return;
  }
  tell_object(me,
    HIR "蔡总管告诉你: 比赛时间到, 请到比试场参加比赛!\n" NOR);
  tell_object(enemy,
    HIR "蔡总管告诉你: 比赛时间到, 请到比试场参加比赛!\n" NOR);

  enemy->move("/open/gblade/room/pkr7");
  me->move("/open/gblade/room/pkr7");

  shout(HIC "蔡总管喝道: " HIW + pkers[i]->name() + HIC "与" HIW +
    me->name() + HIC "在第一武道馆开始比赛!\n" NOR);

  tell_object(enemy, HIY "\n蔡总管说道: 比赛开始!\n" NOR);
  tell_object(me, HIY "\n蔡总管说道: 比赛开始!\n" NOR);
  tell_object(enemy, HIY + "" + me->name() + "弯着腰对你说道: " +
    "请多多指教!\n" NOR);
  tell_object(me, HIY + "" + pkers[i]->name() + "弯着腰对你说道: " +
    "请多多指教!\n" NOR);
  me->kill_ob(enemy);
  enemy->kill_ob(me);
  destruct(this_object());
}
