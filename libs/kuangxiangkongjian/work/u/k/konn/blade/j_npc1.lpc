// j_npc1.c by konn
#include <ansi.h>
inherit NPC;

string do_juju();

void create()
 {
        set_name("邓良羽",({"whu"}));
        set("long",
"他是茅山第一百零九代弟子, 受师命前来抓妖! 他身上带了一张奇异的符纸, "+
"你似乎不曾在中原看过!\n");

        set("nickname", "斩妖除魔");
        set("gender", "男性");
        set("combat_exp", 300000);
        set("attitude", "friendly");
        set("age", 36);
        set("title","茅山第一百零九代弟子");

        set("force", 700);
        set("max_force", 700);
        set("force_factor", 5);

        set_skill("move", 40);
        set_skill("dagger", 70);
        set_skill("dodge", 60);
        set_skill("parry", 40);
        set_skill("unarmed", 40);
        set_skill("hammer", 40);

        set_temp("apply/damage", 50);
        set_temp("apply/move", 150);
        set_temp("apply/dodge", 150);
        set_temp("apply/parry", 150);
        set_temp("apply/armor", 150);

        set("inquiry",([
            "保命符" : "这是师父给我的, 是九字真言中的其中一张。\n",
            "九字真言" : (: do_juju :),
      ]));

        set("chat_chance",2);
        set("chat_msg",({
            HIY+name()+"说道: 想不到世上妖魔如此多, 杀不完砍不尽呀!\n"NOR,
            HIY+name()+"说道: 幸好这次出门带了张保命符, 要不然可要变成妖"+
               "魔的食物了!\n"NOR,
      }));

        setup();
        add_money("gold", 2);
 }

void init() {
        add_action("do_nod","nod");
        add_action("do_answer","answer");
}

string do_juju() {
        object me;

        me = this_player();
        if(me->query("add_potential")) {
           this_object()->command("smile "+me->query("id"));
           return CYN"恭喜你武功大进!\n"NOR;
        }
        if(me->query_temp("juju1"))
           return CYN"我已经把符纸给你了耶...\n"NOR;
        write(CYN+name()+"说道: 所谓九字真言是指:「临兵斗者皆阵列在前”九个字。\n"NOR);
        write(CYN+name()+"说道: 这九个字各写在一张符纸上分置于各地。\n"NOR);
        write(CYN+name()+"说道: 若能收得这九张符纸, 那么个人的修行将会有急剧的转变。\n"NOR);
        me->set_temp("can_nod", 1);
        return CYN"你想要得到我这张符纸吗?\n"NOR;
}

int do_nod() {
        object me=this_player();

        if(!me->query_temp("can_nod"))
           return 0;
        me->delete_temp("can_nod");
        call_out("do_give",1);
}

int do_give() {
        object obj,me=this_player();
        string answer;

        write(CYN+name()+"说道: 好吧! 反正我也用不着了! 但在给你之前要回答我一个问题!\n"NOR);
        me->set_temp("will_answer", 1);
        me->set_temp("right_answer",this_object()->ask_quests(me)); 
        return 1;
}

int do_answer(string ans) {
        object obj,me=this_player();

        if(!me->query_temp("will_answer")) {
           write("你想回答什么?\n");
           return 1;
        }
        me->delete_temp("will_answer");
        if(ans != me->query_temp("right_answer")) {
           write(CYN+this_object()->name()+"说道: 很抱歉! 你答错了!\n"NOR);
           return 1;
        }
        obj = new("/open/gblade/obj/juju1");
        obj->move(me);
        me->set_temp("juju1", 1);
	me->delete_temp("right_answer");
        this_object()->command("smile "+me->query("id"));
        write(CYN+name()+"说道: 你答对了! 那我就把符纸送给你了! 祝你好运!\n"NOR);
	return 1;
}
