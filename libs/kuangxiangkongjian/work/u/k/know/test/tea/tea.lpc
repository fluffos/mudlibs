//tea by know

inherit ITEM;
#include <ansi.h>

void create()
{
   set_name(HIY"金宣茶"NOR, ({"tea"}));
   set_weight(10);
   set("unit","杯");
   if ( clonep() )
      set_default_object(__FILE__);
   else{
        set("value",10);
        set("long","这金宣茶是由乌龙茶杂交配种而产生的,其又称台十二号茶,这杯茶是努力学习到产地
所带回来的冠军茶,专门泡给至亲好友来品嚐的,忘了说金宣之所以好是它在喝时会有
一股阵阵轻微的奶香,使得它受品茶人士的喜爱。\n");
        }
}

void init() 
{
   if(this_player()==environment())
   add_action("do_drink","drink");
}

int do_drink(string arg)
{
   if( !arg || arg!= "tea")
   return notify_fail("你要喝啥???\n");

   message_vision(HIG"$N仔细一闻感到阵阵的的奶味的亲香,心中感觉一阵舒畅
"HIG"$N把茶喝入口中,感觉到不只是茶叶的品质好,连努力学习的泡茶技巧也是一流的
"HIG"真的好想向努力学习好好的学习茶道一番。\n"NOR,this_player() );

   destruct(this_object());
   return 1;
}
