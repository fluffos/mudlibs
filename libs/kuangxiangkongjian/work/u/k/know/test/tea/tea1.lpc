#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name(HIY "香片" NOR, ({ "fragrant tea", "tea" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "
一壶清香的香片,能让人竟下来静静的思考。\n");
    set("unit", "壶");
    set("value", 20);
    set("饱和", 10);
  }
  set("液体", ([
    "种类": "茶",
    "名称": "乌龙茶",
    "剩": 10,
    "止渴": 30,
    "drunk_apply": -5,
  ]));
  setup();
}
void init() {
  if (this_player() == environment())
    add_action("do_drink", "drink");
}
int do_drink(string arg) {
  if (!arg || arg != "tea")
    return notify_fail("你要喝啥???\n");

  message_vision(HIC "$N仔细的品嚐了这杯清香溢人的茶,并坐下来仔细的思考了起来。
\n" NOR, this_player());

  return 1;
}
