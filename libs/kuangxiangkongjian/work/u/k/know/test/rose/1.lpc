// ROSE.c by know
#include <ansi.h>
#include <mudlib.h>

inherit ITEM;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_GUILDCMDS;

void create()
{
      set_name(HIR+"双色玫瑰"+NOR, ({"rose"}) );
      if( clonep() )
              set_default_object(__FILE__);
      else{

      set( "unit" , "朵" );
      set( "long" , "这朵双色玫瑰是努力学习走遍世界各地找遍全宇宙,才好不容易得到这绝无仅有的宝物
据说它具有神奇的魔法,能将发现者的爱恋传到世界的每一个角落,因此努力学习
将它送给最心爱的"HIW"阿雪"NOR"当作定情之物");
      set( "no_get" , 1 );
      set( "no_put" , 1 );
      seteuid(getuid() );

        }
      setup();
}

void init()
{
      add_action("do_fire" , "smell" );
}

int do_fire(string arg)

{
  object target,targetenv;
     if((string)this_player()->query("id")!="oyuki")
      destruct(this_object());
      if(!arg||arg!="rose") return 0;

     message("system",HIY"          远处传来一阵悦耳的歌声
            "HIC"只见天上星辰排列成形
           "HIY"阿雪 "HIR"妳是我永远的最爱\n"NOR , users());


      return 1;
}

int query_autoload()
{
      return 1;
}
