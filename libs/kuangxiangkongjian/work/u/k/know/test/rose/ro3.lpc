// ROSE.c by know
#include <ansi.h>
#include <mudlib.h>

inherit ITEM;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_GUILDCMDS;

void create()
{
      set_name(" [31m□[1m□[0m[31m□[1m□[0m[31m□[1m□[0m[31m□[1m□[0m ", ({"rose"}) );
      if( clonep() )
              set_default_object(__FILE__);
      else{

      set( "unit" , "朵" );
      set( "long" , "这朵[31m□[1m□[0m[31m□[1m□[0m[31m□[1m□[0m[31m□[1m□[0m是努力学习走遍世界各地找遍全宇宙,才好不容易得到这绝无仅有的宝物
据说它具有神奇的魔法,能将发现者的[31m□[1m[31mR[1m□[0m[31m□[0m传到世界的每一个角落,因此努力学习
将它送给最心爱的"HIW"阿雪"NOR"当作定情之物");
      set( "no_get" , 1 );
      set( "no_put" , 1 );
      seteuid(getuid() );

        }
      setup();
}

void init()
{
     object me;
     me = this_player();
     if(!interactive(me))   return;
     if( me->query("id") == "oyuki" || me->query("id") == "know")
     {
      add_action("do_fire" , "smell" );
     }
}
int do_fire(string arg)

{
      object me=this_player();
      if(!arg||arg!="rose") return 0;

      message("system" , HIY"          从双色玫瑰中传来阵阵清脆悦耳的歌声
                "HIC"只见天上晨星渐渐排列成形
              "HIW"阿雪        "HIR"妳是我今生的最爱\n"NOR ,users());


      return 1;
}

int query_autoload()
{ 
      return 1;
}
