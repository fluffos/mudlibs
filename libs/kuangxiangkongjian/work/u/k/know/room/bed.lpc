//oyuki bedroom.c
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create ()
{
   set ("short",HIW"阿雪的小窝"NOR);
  set ("long", @LONG

这里是阿雪温馨的小卧室, 整个房间的色系是与屋外一样的雪白,
简简单单的摆饰, 只有一张床与床几, 大部份的空间都被床所占据
床几上摆的一束闪着奇特光彩的双色玫瑰(rose), 应是这里唯一的
色彩了。

LONG);

   set("item_desc",([ /* sizeof() ==1 */
    "rose" :" 这是努力学习(know)送给阿雪的"HIR"双色玫瑰"NOR",代表他对阿雪不变的心意....:) 
",
]));


   set("exits", ([ /* sizeof() == 1 */
   "east" : "/u/o/oyuki/room/mathroom",
]));

  set("no_fight", 1);
  set("light_up", 1);
  set("no_magic", 1);
   set("valid_startroom",1);
  

  setup();
}

void init() {
       object me=this_player();

        if(!interactive(me)) return ;
        if( me->query("id") == "oyuki" || me->query("id") == "know")
        return ;
        if(me->query_temp("totoro") != 1 && 
           me->query("boss") != 1) {
            me->move("/open/death/start");
             tell_object(me,HIW"雪女横身一拦:不得擅闯香闺!! \n"NOR);
        }
}

