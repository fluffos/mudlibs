//know bedroom.c
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create ()
{
   set ("short", HIG"努力学习的秘密休息室"NOR );
  set ("long", @LONG

这里是一间不大的房间,门边上挂着一木牌(xxxx),一进门你就看到一个小小
茶几上放满了各类的泡茶用具,突然间你鼻子也闻到阵阵的茶香,令你心情更
加的愉快,其间还看到一舒适的小床,想必这里大概是努力学习休息聊天的地
方。 

LONG);

   set("item_desc",([ /* sizeof() ==1 */
    "xxxx" : HIR"                非  请  末  入\n"NOR,
]));

   set("exits", ([ /* sizeof() == 1 */
   "west" : "/u/k/know/room/laboratory",
]));

  set("no_fight", 1);
  set("light_up", 1);
  set("no_magic", 1);
   set("valid_startroom",1);

  setup();
}

void init()
{
   object me=this_player();
   if(!interactive(me)) return ;
   if( me->query("id") == "know" || me->query("id") == "oyuki" ||
      me->query("id") == "leei" || me->query("id") == "kazuya"||
      me->query("id") == "bigcat" || me->query("id") == "night")
        return ;
        if(me->query_temp("totoro") != 1 && 
           me->query("boss") != 1)
{
               me->move("/u/k/know/workroom");
           tell_object(me,HIY" 主人又没准你进来泡茶,你不要随便乱走 /n"NOR);
  
}
}
