inherit ROOM;
void create()
{
   set("short", "海蚀洞穴");
   set("long", @LONG
此地乃一海蚀洞穴,由四方的墙璧,可以看出此为经过千万年之海流侵蚀,才能行成
如此大的洞,你可以清楚地看到海水现在只淹到你的腰部,若是由顶部的痕迹,则可看出     满潮时,海水将灌满整个洞穴 。你可以看到前方有光线射进来,想必是出口了 。

LONG);
   set("exits", ([
    "east" : __DIR__"2.lpc",
   ]));
  setup();
}
void init()
{
    add_action("do_swim","swim");
}
int do_swim()
{
   object me;
   me = this_player();
tell_object(me,"[34;1m你闭起气来,只听～噗～通～一声地往海水潜了下去。[0m\n");
   me->move("/open/island/room/l1");
   return 1;
}

