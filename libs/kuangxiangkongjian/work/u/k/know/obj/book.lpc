#include <weapon.h>
#include <ansi.h>
inherit STABBER;

void create()
{
  seteuid(getuid());
  set_name(HIG"努力学习的学习宝典"NOR, ({"know's book" , "book"}) );
  set("long",
    "这是一本努力学习用来研究魔法的宝典,据说它还具有穿梭时空的能力
                              能够带着你遨游世界\n");
  set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("unit", "本" );
  set("value",0);
  set("material","gold");
  set("no_sell",1);
  set("wield_msg", "$N高举着"HIG"$n"NOR",身边随即招来了一个小小的防护罩\n");
  set("unwield_msg", "$n突然化做一阵清风偷偷的溜进了$N的口袋之中\n");
}
  init_stabber(500);
  setup();
}
void init()
{
  add_action("go_go","gogo");
}

int query_autoload()
{
   return 1;
}

int go_go(string str)
 {
   object obj;
   object me;
   me=this_player();
  if(!str || str == "")
    {
      write("魔法宝典怀疑的说: 这是啥地方呀???\n");
      return 1;
    }
   message_vision(HIY"$N将身上的"HIG"学习宝典"HIY"轻轻的抛向空中,身影也随之离去\n"NOR,me);
   obj=find_living(str);
   me->move(environment(obj));
   message_vision(HIY"突然听到耳边传来阵阵读书声,赫然发现$N的身影就在你身旁\n"NOR,me);
   return 1;
 }
