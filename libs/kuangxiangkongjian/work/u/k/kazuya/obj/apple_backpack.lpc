#include <armor.h>

inherit CAPE;

void create()
{
      set_name("[1m[33m□[31m囿[33mG背包[0m", ({"apple backpack","apple"}) );
      
      set_weight(1000);
      set("value",1000);
      set_max_encumbrance(50000);
      
      if( clonep() )
         set_default_object(__FILE__);
      else {
         set("long","大[1m[31m□[0m[31m□[1m□[0m[31mG[0m模样的可爱背包摆\在这儿。\n");
         
         set("unit","口");
         set("no_sell",1);
         set("material", "cloth");
         set("armor_prop/armor", 30);
         set("armor_type","cape");
           }
      setup();
}

int is_container() { return 1; }

string short()
{
    object obj=this_object();
    if( environment(obj)->is_character() )
    return "[36m(闪烁)[0m [1m[33m□[31m囿[33mG背包[0m("+obj->query("id")+")";
    else return "大[1m[31m□[0m[31m□[1m□[0m[31mG[0m模样的可爱背包摆\在这儿。("+obj->query("id")+")";
}
int query_autoload()
{
  return 1 ;
}
