//冥王破腰斩, 夜摩天狼剑
#include <ansi.h>
void do_specia1();
void do_specia2();
inherit NPC;

void create() {
  set_name("夜叉王耶摩", ({ "yamado" }));
  set("long",
    "有鬼神之称的北方武神将, 也是天界流传最强的武神将, 和前代占星人
九  是旧识, 正在找寻传说中那个会杀他的命运之子阿修罗.\n");
  set("nickname", "鬼神");
  set("gender", "男性");
  set("age", 500);
  set("str", 80);
  set("con", 30);
  set_skill("sword", 90);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 10);
  set("max_gin", 200);
  set("max_kee", 2000);
  set("max_sen", 100);
  set("limbs", ({ "头部", "手腕", "手臂", "右脚", "腰部" }));
  set("verbs", ({ "claw", "poke" }));
  set("chat_chance", 4);
  set("chat_msg", ({
    "夜叉王凝视着远方, 像是在回忆什么事情.\n",
  }));
  set("combat_exp", 500000);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: do_specia1 :),
    (: do_specia2 :)
  }));
  setup();
  add_money("gold", 10);
}

void do_specia1() {
  object *enemy, target;
  int i;

  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];

  message_vision(
    HIY "\n夜叉大喝一声，看我的‘冥～王～破～腰～斩’\n" NOR, target);
  target->receive_wound("kee", random(100 + 100));
  COMBAT_D->report_status(target);

}

void do_specia2() {
  object *en, tar;
  int j;

  en = this_object()->query_enemy();
  j = sizeof(en);
  tar = en[random(j)];

  message_vision(
    HIB "\n夜叉大喝一声，看我的‘ 夜～摩～天～狼～剑 ’\n" NOR, tar);
  tar->receive_wound("kee", 100 + random(100));
  COMBAT_D->report_status(tar);

}
