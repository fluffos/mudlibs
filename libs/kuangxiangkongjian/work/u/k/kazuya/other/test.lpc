#include <ansi.h>
inherit NPC;

void create() {
  set_name("测试员", ({ "tester" }));
  set("long", "
	我是测试员
\n");
  set("gender", "男性");
  set("combat_exp", 2000000);
  set("attitude", "heroism");
  set("age", 46);
  set("class", "swordsman");
  set("force", 5000);
  set("max_force", 5000);
  set_skill("shaforce", 60);
  set("force_factor", 10);
  set("kee", 100000);
  set("max_kee", 100000);
  set_skill("force", 40);
  set_skill("sword", 100);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("move", 40);
  set_skill("literate", 60);
  set_skill("cure", 40);
  set("str", 30);
  set("cor", 10);
  set("per", 25);
  set("int", 30);
  set("cps", 20);
  set("con", 30);
  set("spi", 15);
  set("kar", 30);
  setup();
  set_heart_beat(1);
  add_money("gold", 5);
}

void heart_beat() {
  mapping exit;
  string *exit_name;
  object env, mob = this_object();
  int i;

  set_heart_beat(1);

  if (query("kee") < 0)
    mob->die();

  // 有五次补精气神的机会, kee < 50% 补
  if (query("kee") * 100 / query("max_kee") < 50) {
    mob->receive_curing("max_kee", 5000);
    mob->receive_curing("kee", 5000);
    mob->receive_heal("kee", 300);
    add_temp("heal", 1);
    tell_room(environment(), HIY + name() + "使出家传绝学," +
      "简简单单的治好自己的伤口.\n" + NOR);
  }
  ::heart_beat();
}
