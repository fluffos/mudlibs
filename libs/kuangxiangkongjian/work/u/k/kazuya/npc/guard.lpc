#include <command.h>

inherit NPC;

void create()
{
    set_name("灵界侦探",({"guard"}));
    set("title", "小阎王直属");
    set("gender", "男性");
    set("age",20);
    set("attitude","heroism");
    set("long",@LONG
他奉命看管灵界之门,以免遭受魔界的袭击.
LONG);    
    
    set("combat_exp",1000000);
    set("str",30);
    set("con",20);
    set("int",30);
    set("per",40);
    set("cps",30);
    set("kar",30);
    set_skill("lungshan",200);
    set_skill("black-steps",200);
    set_skill("haoforce",100);
    set_skill("force",120);
    set("force",5000);
    set("force_factor",100);
    set("max_force",5000);
    set("max_kee",3000);
    set("kee",3000);
    map_skill("parry","lungshan");
    map_skill("unarmed","lungshan");
    map_skill("dodge","black-steps");
    map_skill("move","black-steps");
    map_skill("force","haoforce");
    set("chat_chance_combat",50);
    set("functions/kang_kee/level",100);
    set("chat_msg_combat",({
    (: perform_action,"force.kang_kee" :)
    }));
    setup();
}
