#include <ansi.h>
inherit ROOM;

void create()
{
    set("short","海滩");
    set("long",@LONG
你踩在海沙之上, 脚底感觉到相当的舒爽, 听着海风呼呼的声音,
你的心也慢慢的静下来. 风把你的头发吹的零乱. 你有股想在这里
奔跑起来的冲动. 潮来潮往, 代表着宇宙间的永恒。
LONG);
    set("valid_startroom", 1);
    set("light_up",100);
    set("outdoors","/u/k/kazuya/room/beach");
  /*  set("exits",([
    "apple" : "/u/k/kazuya/workroom",
])); */
    setup();
}

void init()
{  
    object me=this_player();
    add_action("do_apple","apple");
    if(!interactive(me)) return ;
    if( me->query("id") == "kazuya" || me->query("id") == "nala"  ||
        me->query("id") == "ahnu"   || me->query("id") == "snow"  ||
        me->query("id") == "know"   || me->query("id") == "oyuki" ||
        me->query("id") == "night"  || me->query("id") == "ccat"
      ) return;  
       me->move("/obj/void");
       tell_object(me,HIG"        你不受此地欢迎!!!!  \n"NOR);
   
}

int do_apple(string str)
{
   object who=this_player();
   who->move("/u/k/kazuya/workroom");
   return 1 ;
}    
