#include <ansi.h>
inherit NPC;
void create()
{
        set_name(HIB"卓"HIW"卓""NOR,({"lover"}));
        set("title","乱世狂刀的女朋友");
        set("gander", "女性");
        set("age", 17);
        set("eff_gin",1000);
        set("eff_kee",1000);
        set("eff_sen",1000);
        set("max_gin",1000);
        set("max_kee",1000);
        set("max_sen",1000);
        set("str",10);
        set("cor",20);
        set("int",50);
        set("spi",50);
        set("cps",80);
        set("con",30);
        set("kar",10);
        set("dex",20);
        set("attitude","peaceful");
        setup();

}

void die()
{
        object ob;

        if( !ob = query_temp("last_damage_from") )
                ob = this_player(1);
        if( !ob ) return;
        message("system",
HIW"「"HIB"卓"HIW"卓"HIW"”临死前，说道:「想不到你居然会\n\n"
"被" HIY + ob->name(1) + HIW "所杀，我真是想不道你会这～～～～～\n\n"
"乱世狂刀一定不会放过你的，说完「"HIB"卓"HIW"卓"HIW"”化成\n\n"
"一片白云飘向了天际。\n"NOR,
                users() );
         destruct(this_object());
}
