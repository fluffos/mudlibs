        message(" system ",
HIW" 「 "HIB" 卓 "HIW" 卓 "HIW" ” 临 死 前 ， 说 道 : 「 想 不 到 你 居 然 会 \ n \ n "
" 被 " HIY + ob->name(1) + HIW " 所 杀 ， 我 真 是 想 不 道 你 会 这 ～ ～ ～ ～ ～ \ n \ n "
" 乱 世 狂 刀 一 定 不 会 放 过 你 的 ， 说 完 「 "HIB" 卓 "HIW" 卓 "HIW" ” 化 成 \ n \ n "
" 一 片 白 云 飘 向 了 天 际 。 \ n "NOR,
                users() );
         destruct(this_object());
}
