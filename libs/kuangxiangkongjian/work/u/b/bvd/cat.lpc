inherit NPC;

void create()
{
	set_name("棕色小猫", ({ "small cat", "kitty", "cat" }) );
	set("race", "野兽");
	set("age", 1);
	set("long", "这是小野猫从路上捡来的小猫,毛绒绒的尚不满足岁.\n");
	set("str", 150);
        set("max_kee",700);
        set("kee",700);
	set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );
	set("chat_chance", 3);
 	set("chat_msg", ({
		"棕色小猫 在地上翻滚,露出白绒绒的肚皮。\n",
		"棕色小猫 在你的脚边挨挨擦擦的，想讨东西吃。\n",
 		"棕色小猫 用小小的舌头舔你的手。\n",
		"棕色小猫 用后腿抓了抓自己的耳朵。\n" }) );
		
        set_temp("apply/attack", 500);
	set_skill("dodge",100);
	set_skill("parry",100);
	set("combat_exp",10000);
	set_temp("apply/armor", 2500);
	setup();
}

