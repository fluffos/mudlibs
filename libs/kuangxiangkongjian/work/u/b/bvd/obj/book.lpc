#include <weapon.h>
#include <ansi.h>
inherit STABBER;

void create() {
  seteuid(getuid());
  set_name(HIR "小李" HIW "的" HIY "魔法书" NOR, ({ "BVD'S MAGIC BOOK", "BOOK" }));
  set("long",
    "这是一本小李归隐后潜心研究的魔法书\n");
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("value", 0);
    set("material", "gold");
    set("no_sell", 1);
    set("wield_mdg", "$N从手中变出了一本" HIY "$n" "NOR,身旁随即被花萤予狴]围\n);
  set(" unwield_msg "," $N 从 手 中 变 出 了 "HIG" $n "NOR", 身 边 围 绕 着 朵 朵 的 花 瓣 \ n ");
}
  init_stabber(500);
  setup();
}
void init()
{
  add_action(" go_go "," gogo ");
}

int query_autoload()
{
   return 1;
}

int go_go(string str)
 {
   object obj;
   object me;
   me=this_player();
  if(!str || str == " ")
    {
      write(" 魔 法 宝 典 怀 疑 的 说 : 这 是 啥 地 方 呀 ?? ? \ n ");
      return 1;
    }
message_vision(HIR" $N "HIY" 慢 慢 的 消 失 在 一 片 片 花 瓣 中 "NOR,me);
   obj=find_living(str);
   me->move(environment(obj));
message_vision(HIB" 身 边 忽 然 出 现 一 朵 朵 炫 目 的 花, "HIY" 仔 细 一 看, 只 见 $N 从 花 朵 中 走 了 出 来 "NOR);
   return 1;
 }
