#include <weapon.h>
#include <ansi.h>
inherit STABBER;

void create()
{
  seteuid(getuid());
 set_name(HIR "小李"HIW"的"HIY "魔法书"NOR,({"BVD'S MAGIC BOOK","BOOK"}));
  set("long",
"这是一本小李归隐后潜心研究的魔法书\n");
  set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("unit", "本" );
  set("value",0);
  set("material","gold");
  set("no_sell",1);
 set("wield_mdg","$N从手中变出了一本" HIY"$n""NOR,身旁随即被花萤予狴]围\n);
  set("unwield_msg","$N从手中变出了"HIG"$n"NOR",身边围绕着朵朵的花瓣\n");
}
  init_stabber(500);
  setup();
}
void init()
{
  add_action("go_go","gogo");
}

int query_autoload()
{
   return 1;
}

int go_go(string str)
 {
   object obj;
   object me;
   me=this_player();
  if(!str || str == "")
    {
      write("魔法宝典怀疑的说: 这是啥地方呀???\n");
      return 1;
    }
message_vision(HIR"$N"HIY"慢慢的消失在一片片花瓣中"NOR,me);
   obj=find_living(str);
   me->move(environment(obj));
message_vision(HIB"身边忽然出现一朵朵炫目的花,"HIY"仔细一看,只见$N从花朵中走了出来"NOR);
   return 1;
 }
