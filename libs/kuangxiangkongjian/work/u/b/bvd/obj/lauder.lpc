#include <ansi.h>
inherit F_MEDICINE;
void create()
{
set_name(HIY"雅诗兰黛粉底"NOR,({"lauder"}));
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{
set("long","雅诗兰黛清澈透明粉底,不仅创造完美粉颊
还能题供绝佳保养及保护功能...\n"+
"\t用法 : apply lauder [at <target>]\n");
	set("unit", "盒");
	set("base_unit", "盒");
	set("base_weight", 1000);
	set("value", 800);
	set("cure_type","outheal");
	set("cure_heal_type","kee");
set("medicine_power",200);
	set("medicine_times",8);
	}
	set_amount(1);
	setup();
}
