inherit F_MEDICINE;
void create()
{
set_name("倩碧晶莹蜜粉",({"clinique"}));
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{
set("long","倩碧晶莹蜜粉,给任何肤色最完美无暇的修饰,呈现晶莹剔透的光采...\n"
"\t用法 : apply clinique [at <target>]\n");
set("unit","瓶");
set("base_unit","瓶");
	set("base_weight", 1000);
	set("value", 800);
	set("cure_type","outheal");
	set("cure_heal_type","kee");
set("medicine_power",200);
	set("medicine_times",8);
	}
	set_amount(1);
	setup();
}
