
// keng_kee.c

#include <ansi.h>
inherit F_FUNCTION;
inherit SSERVER;

int perform(object me, object target)
{
        int ski_value;
        string msg;
        object ob;
        string *name;
        ski_value= random(me->query("combat_exp")+me->query_skill("shasword",1)*2500
                   - target->query("combat_exp"));
        if( !target ) target = offensive_target(me);

         if( me->query_skill("shasword",1) < 20 )
                           return notify_fail("你的剑法技巧不足。\n"); 
          if(me->query("force")<250)
                           return notify_fail("你的内力不够。\n");
                  if(me->query("kee")<180)
                           return notify_fail("你的气不够。\n");

        if(!me->is_fighting())  
        {
                tell_object(me,"万剑诀唯在战斗中才能使用。\n");
                return 0;
        }
        message_vision(" $N纵身一跃 ,体内暗运功力 ,身体浮沈于半空之中 , 突然间周围草木由耸动而渐渐
        剑拔弩张 ,一根根成为蓄势待发的利器\n",me,target); 
        message_vision(
            "\n[1m$N指成剑姿大喝一声 万剑诀 , 瞬间四周万剑齐发..！[0m\n",me,target);
        if( ski_value < 0 ){
           me->add("force",-50);
          write("不过一把都没有命中 ,你当场羞红了脸将剑收回");
          say( this_player()->query("c_cap_name")+"你发现空中乱剑飞舞 ,不过就是没有命中敌人 ,不禁指着"+me->query("name")+"的鼻子大笑");     
          }
        else if( ski_value < 1000 )
          {
          me->add("force",-50);
          target->add("kee",-10);
          write ( "你发现大部分的剑都朝地上打去 ,甚至还打向自己 ,你发誓要好好练剑
                   将来方能完全驾驭");
          say( this_player()->query("c_cap_name")+你看到空中一堆剑朝你射来 ,妈啊～
          　　快闪..发现原来□+Ome->query("name")+"这个家伙在舞剑");
          }
          else if( ski_value <2000)
          {
           me->add("force",-50);
           target->add("kee",-30);
          write ("已有一些能准确命中敌人 ,使的敌人受创不小");
          say("你看见空中一些气剑任"+me->query("name")+"挥洒自如 ,心中暗暗钦佩");
                 }
          else if( ski_value <3000)
          {
           me->add("force",-50);
          target->add("kee",-50);
          write(" 十之八九的气剑朝敌人激射而去 ,使敌人受到严重的创伤");
          say("成千上万的气剑群集朝一目标射去 ,看的你瞠目结舌 , 半晌说不出话来 ");
          }
          else 
          {
           me->add("force",-50);
           target->add("kee",-70);
          write(" 在你双手挥舞之下 ,万剑均命中敌人 ,穿体而过 ,敌人痛苦的嘶吼着");
          say(" 你不敢相信眼前滂勃的气势 ,群天的气剑掩盖了耀眼的阳光 ,却发出一股
                更为绚丽的光芒");  
           }           
        return 1;
}
