#include <room.h>

 inherit ROOM;

 void create()
{
        set("short", "猫老大的狗窝");
        set("long", @LONG

         你一来到这,立刻被难以数计的小猫们爬满全身,
         无数的小舌头向你舔来,弄的你好不舒服,看着他
         们滚着,躺着,使你心中不禁想样伸出双手抚摸那
         毛绒绒的身体,然而惊鸿一撇的,你看见办功室的
         一角有着一座泛者怪异光忙的雕像,走近一看,上面
         刻着魂老大(ghost),你仔细的端详雕 像,栩栩如生的
          有如真人一般,你隐隐的感觉到这雕像来头不小,
          ,背后似忽有着一段不可告人的故事.........

LONG
        );

       set ("item_desc", (["ghost" :
    "你仔细的看着这个瓶子，越看越入迷，心理就想触摸（touch）它一下。\n"]));
        set("valid_startroom", 1);

        set("exits", ([
		"south": "/u/w/wugi/workroom",
                "gg"  :  "/open/gsword/room/g1-1",
		"down": "/u/w/wade/workroom"
        ]) );
}
    void init() {
add_action("touch_ghost","touch") ;}
int touch_ghost(string str) {
        write ("一阵刺耳的声音传入耳中～～～～～～\n"+
"我好恨啊....为什么我的魔法老是输给bigcat...唉.....\n"+
"想起几年前的魔法比试,bigcat的fb[0]威力竟然胜过我的fb[max]\n"+
"经过那次重大的刺激,我决定潜入bigcat的办公室..
\n")
;

    say (this_player()->query("c_cap_name")+"‘砰！磅！’你听到一声巨响，你回头一看，发现有人昏倒了，你推了他几下，总算把他推醒了。\n") ;
        return 1 ;
}
