// copy from /d/snow/npc/teacher.c
inherit NPC;
void answer();
void shou_turn();
int a;
int b;
void create()
{
	set_name("王凯", ({ "wang","wang kai","kai"}) );
	set("gender", "男性" );
	set("age", 43);
	set("int", 26);
        set("long","他正聚精会神的看着桌上那一个大碗公,嘴中念念有词你好奇的想知道
 那碗公里到底是啥宝贝,走近一看,挖哩勒,竟然是西八剌\n" );
        
        set("inquiry",([
        "禁地": "你是谁!!!禁地的事我一概不知,就算知道不会告诉你,你走吧\n",
        "封印": "唉!!别说那么多讨人厌的话题了,咱们玩两把吧,你赢了,再来问
        	我也不迟啊\n"]
        ) );
	
	set("combat_exp",50000);
        set("max_kee",500);
        set("max_gin",500);                        
	
	set("attitude", "peaceful");
	
	set_skill("unarmed",50);
	set_skill("parry",50);
	set_skill("force",50);
	set_skill("chaos-steps",50);
	set_skill("liuh-ken",50);
	set_skill("fonxanforce",50);
	set_skill("six-chaos-sword",50);
	
	map_skill("unarmed","liuh-ken");
        map_skill("dodge","chaos-steps");
	map_skill("sword","six-chaos-sword");
	map_skill("force","fonxanforce");
	
	setup();
        
        carry_object("/open/su/obj/ten_sword")->wield();
        carry_object("/open/su/obj/snow_cloth")->wear(); 
}

init()
{
	add_action("play_dice","play");
	add_action("toss_dice","toss");
}


int play_dice(string str)
{

	if( str!="dice" ) {
		write("你要玩什么??\n");
		return 0;
	}

	write("王凯道:你先来吧,请掷骰子\n");
	return 1;
}

int toss_dice(string str)
{
	if( str!="dice") {
		printf("你要玩什么??\n");
		return 0;
	}
a=random(5)+1;
b=random(5)+1;
printf("%d",a);
printf("%d",b);

	write("你大喊:[1m嬷眯八咪轰,天兵天将为我所用,西八辣!!![0m\n");
	if( a > 3 ) {
		printf("哈!哈!我掷到%d点,看来你是凶多吉少\n",a);
		write("该你了!!\n");
	} else {
		printf("唉!唉!真是赛,竟然是%d点,你可乐了吧\n",a);
		write("你掷吧!\n");
	}//end if_else
remove_call_out("shou_turn");	
call_out("shou_turn",5,this_player());
	return 1;
}
void shou_turn()
{
say("只见王凯以迅雷不及掩耳速度,将碗公在空中晃了两圈,随即定在桌上,大叫一声开!!\n");
printf("1");
answer();
 }
void answer()
{	
printf("1");
a=random(5)+1;	
b=random(5)+1;
printf("3");
	if( b > a ) {printf("哈!小兄弟你输了,我掷到%d点\n",b);}

        if( b==a) {printf("我也是掷到%d点,这盘咱们可是合局了\n",b);}

	if( b < a ) {
		printf("真是背啊,竟是掷到%d点,算我倒楣,我就告诉你吧\n",b);
 command("tell"+" "+this_player()->quiry("id")+" "+"当年祖师爷逍遥子用三样法宝将他封印起来,祖师爷退休之后就把三样宝物分别
交给他三个大弟子保管,要解开天魔的封印,非要这三样法宝同时施法,除此之外别无他法\n");
           }    
 printf("2");
  }