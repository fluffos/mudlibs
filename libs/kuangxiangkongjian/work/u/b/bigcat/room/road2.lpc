// Room: /open/su/room/suroad9_1.c

inherit ROOM;

void create()
 {
	set("short", "山壁");
	set("long", @LONG
         只见山峰穿云插天,山石滑溜,寸草不生,左边有一片大瀑布(waterfall)
         从天而降,诗人李白所说之黄河之水天上来,恐也无法与之媲美.右边有着
         一栋废弃的茅草屋(house)...



         一艘铁舟停靠在岸


LONG
	);
  set("item_desc",(["waterfall":
                  "一道从天而降的大瀑布,水流极其湍急,仔细一瞧瀑布底似乎另\n
                  有蹊窍,你忍不住想下去探个究竟(swim)...",
                  "house":
                  "一栋残破不堪的茅草屋,仔细的搜寻(search)一下,可能有惊人\n
                  的发现..."]));                           
 
        set("exits",([
                 "up":"/u/b/bigcat/room/road3"
          ]) );
  setup();
 }
  void init(){
  add_action("swim_waterfall","swim");}
  int swim_waterfall(string str) {
       if (str!="waterfall") {
                 return 0;}
       write("你秉气凝神,吸了一大口气,纵身向池底游去");
       this_player()->move("/d/snow/inn");  
         return 1;
         setup();
}
