#include <room.h>

inherit ROOM;

void create ()
{
     set("short" ,"练丹房");
     set("long", @LONG
 你一进这个房间就闻到一股浓浓的药味,在四周的墙上挂着许多名画,
 房子的中间有一个练丹炉,炉中正练着仙剑派的独门仙丹,每一颗能增
 内力一百年,不禁让人起了邪念,正当你想伸手去偷的时候,发现旁边
 的童子正恶狠狠的瞪着你,你只好打消了这个念头。

          

LONG
    );
    set("objects", ([
        "/u/s/shorst/npc/kid" : 1,]) );
    set("exits",([
        "down": "/u/b/bigcat/room/workroom",
        "east": "/u//test"
     ]));
    setup();
}
int valid_leave(object me,string dir)
{
          if(dir=="east" && (string)me->query("id") !=("shorst"))
                     return notify_fail("STOP!!!!\n");
          return ::valid_leave(me, dir);
}
