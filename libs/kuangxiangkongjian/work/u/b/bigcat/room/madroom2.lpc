// Room: /u/s/smallfat/madroom2.c

#include <ansi.h>

inherit ROOM;

string *nonsense = ({ ""HIW"你只能听到外面嘈嘈杂杂的声音......"NOR"\n",
                      "突然.....你看到地上有一堆"HIW"白骨"NOR"...... \n",
                      "很久很久以前，有个人叫做....嗯....忘了.....\n",
                      "你只感觉一股"HIC"寒意"NOR"从地底窜上来..... \n",
                      "被本小胖关的感觉如何呀??!!.....\n",
                      ""HIY"下次绝对不会再进来了......."NOR"你正这样想对不对??\n
",
                      ""HIR"小心!!有陷阱!!"NOR"\n",
                      "你想一死了之..........\n",
                      "其实自杀比较快啦!!嘻嘻....... \n",
                      });

string render_long();

void create()
{
  set("short", HIY"爱 之 牢 房 外 面"NOR);
  set("long.desc", "哈哈哈!!你是不可能逃离本小胖的牢房!!还是乖乖的回去吧!!\n"
      );
  set("long", (: render_long() :) );
  set("exits", ([
      "out" : "/u/s/smallfat/madroom2.lpc",
      "enter" : "/u/s/smallfat/madroom1.lpc",
      ]));

   setup();
}

string render_long()
{
       string str;
       object me;
       me = this_player();
       str = query("long.desc");
       str += "\n哇.....你已经"+chinese_number((int)me->query("age"))+"岁了。\n"
;
       str += nonsense[random(sizeof(nonsense))]+"\n";
       return str;
}

void init(){
  if((string)this_player()->query("id")=="bigcat"){
        add_action("smallfat","smallfat");
        }
        else {
        add_action("no_quit", "quit");
        add_action("no_goto", "goto");
        add_action("do_pass", "say 我爱小胖");
        add_action("no_home", "home");
        add_action("no_more", "more");
        add_action("no_rm", "rm");
        add_action("no_dest", "dest");
        add_action("no_cat", "cat");
        add_action("no_edit", "edit");
        add_action("no_tell", "clone");
        add_action("no_tell", "mkroom");
        add_action("no_tell", "shutdown");
        add_action("no_tell", "reboot");
        add_action("no_tell", "rest");
        add_action("no_tell", "connect");
        add_action("no_tell", "saveroom");
        add_action("no_tell", "localcmds");
        add_action("no_tell", "cp");
        add_action("no_tell", "tell");
        add_action("no_tell", "chat");
        add_action("no_tell", "rumor");
     // add_action("no_tell", "wiz");
        add_action("no_tell", "es");
        add_action("no_tell", "gwiz");
        add_action("no_tell", "twiz");
        add_action("no_tell", "sys");
        add_action("no_tell", "shout");
        add_action("no_tell", "ls");
        add_action("no_tell", "cd");
        add_action("no_tell", "mv");
        add_action("no_call", "call");
        add_action("no_dest", "smash");
        add_action("do_fuck", "fuck");
        add_action("no_fly","fly");
}}

int no_quit(string str){
        write("干嘛!!想用"HIW"Quit大法"NOR"逃跑啊?!门都没有!!\n");
        return 1;
}

int no_goto(string str){
        write("我哩咧!!你是本小胖的囚犯还想跑!!\n");
        return 1;
}
int do_pass(string str){

        object ob;
        ob = this_player();
        ob->reincarnate();
        write(""HIW"嗯!!看在你那么的爱我....这就放你走吧!!"NOR"\n");
        ob->move("/d/wiz/gate");
        return 1;
   }
int no_home(string str){
        write("笨!!你逃不出去就是逃不出!!还想回家!!\n");
        return 1;
}
int no_more(string str){
        write("呵呵!!想用more!!这是不可能的事!!\n");
        return 1;
}
int no_rm(string str){

        write(""RED"什么?!被我关起来什么权力都没了, 还想rm!!"NOR"\n");
        return 1;
}
int no_dest(string str){
       write(""HIW"想摧毁
这里!!告诉你这里是不能被摧毁的!!"NOR"\n");
        return 1;
}
int no_cat(string str){
        write(""HIG"我是猫～～喵～～喵～～喵～～"NOR"\n");
        return 1;
}
int no_edit(string str){
       write("你想用"HIC"EDIT"NOR"干嘛?!被关了还想用"HIC"EDIT"NOR"!!\n");
       return 1;
}
int no_tell(string str){
       write(""HIR"你被关了～～你被关了～～你被关了～～"NOR"\n");
       return 1;
}
int no_call(string str){
       write("CALL!!我还"HIY"B.B.CALL"NOR"咧!!\n");
       return 1;
}
int no_fly(string str){
       write(""HIY"再飞呀!!再飞我就把你扫射下来!!嘻嘻!!"NOR"\n");
       return 1;
}

int smallfat(string str){

       object ob;
       ob = this_player();
       ob->reincarnate();
       ob->move("/u/s/smallfat/workroom");
       return 1;
}
int do_fuck(string str){

       object ob;
       ob = this_player();
       ob->reincarnate();
       ob->move("/u/s/smallfat/madroom1.lpc");
       return 1;
}
