#include <room.h>

 inherit ROOM;

 void create()
{
      
        set("short", "森林");
        set("long", @LONG
丰沛的雨量，适中的气温使的这儿的树木长的高大的吓人，绵延数里之远
当然其中生存的动物更是不计其数，各类的奇花异草在这到处可见，不过
也得提防有猛兽的出没。
LONG
        );

        set("exits", ([
		"east": __DIR__"walley",
                "north":__DIR__"wplain1",
                "south":__DIR__"rroad3"
        ]) );
setup();

}
