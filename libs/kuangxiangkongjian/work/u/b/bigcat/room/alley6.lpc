#include <room.h>

 inherit ROOM;

 void create()
{
      
        set("short", "小径");
        set("long", @LONG
以碎石铺成的小路，平时很少有人经过，所以长了一地的青苔，由于离
剑派也有一段距离，所以平时也鲜少有人清扫。
LONG
        );

        set("exits", ([
		"southwest": "/u/b/bigcat/room/alley5",
                "northeast":"/u/b/bigcat/room/alley7",
                "south":"/u/b/bigcat/room/plain8",
                "east":"/u/b/bigcat/room/plain11"
        ]) );
setup();

}
