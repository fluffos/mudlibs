// sword.c : an example weapon

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("小剑",({"gold blade","blade"}));
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long","一把金光闪闪的小刀。\n");
	/*	set("value",1000);	*/
		set("material", "gold");
		set("wield_msg", "$N「唰”地一声抽出一把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");
	}
	init_sword(10);
	setup();
}

void init()
{
  add_action("do_team","team");
}

int do_team(string arg)
{
  string item,targ;

  if( !arg ) 
  {
    write("请参与剑阵说明\n");
    return 1;
   } 
  if( sscanf(arg, "form %s", targ)==1 )
  {
    if(targ!="sha-array")
    {
     write("你要施展什么\n");
     return 1;
     }
     else
     {
     write("仙剑剑阵开始运作\n"); 
     set_heart_beat(1);
     return 0;
    }
   }
  write("2");  
  return 1;
 }

