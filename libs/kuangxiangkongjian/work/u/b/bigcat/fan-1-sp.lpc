#include <ansi.h>
inherit NPC;
object keep_owner,who;
int my_int,my_per,my_literate,sp_rate;
void create()
{
   set_name("sword-1的特攻",({"sword-1-sp"}));
   set("short","          ");
   set("long","");
   set("age", 10);
   set("combat_exp", 100);
   set("attitude","peaceful");
   setup();
   set_heart_beat(1);
}
void invocation(object me,string str)
{   
   if(!str || !objectp(who = present( lower_case(str), environment(me) )) )
   {  
      keep_owner->delete_temp("_call_out_sword");
      destruct(this_object());
      return;
    }  
   keep_owner = me;
   my_int = keep_owner->query("int",1);
   my_per = keep_owner->query("per",1);
   my_mo = keep_owner->query("bounds",1);
   if(my_mo > 10000)
     my_mo = 10000;
   sp_rate = my_int*30 + my_per*10 + my_mo;
   return;
}
void heart_beat()
{ 
  object _ob;
  int mob_kee,have_sword;
  _ob = this_object();
  if( !objectp(keep_owner) )
      destruct(_ob);
  have_sword = keep_owner->query_temp("sword",1);
  if( !keep_owner->is_fighting() || !have_sword )   
  {
     keep_owner->delete_temp("_call_out_sword");
     destruct(_ob);
  }
  if( sp_rate > random(25000) )
  { 
    message_vision(HIB+"赤麟幻化成一股剑气 ,朝$N激射而去!!!\n"+NOR,who);
    mob_kee = who->query("kee",1);
    mob_kee = mob_kee - my_int - my_per;
    who->set("kee",mob_kee);
  }
}
