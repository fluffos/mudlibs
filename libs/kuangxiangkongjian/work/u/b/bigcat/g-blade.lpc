// sword.c : an example weapon

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
object user;

void create() {
  set_name("小剑", ({ "gold blade", "blade" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把金光闪闪的小刀。\n");
    /*	set("value",1000);	*/
    set("material", "gold");
    set("wield_msg", "$N「唰”地一声抽出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_sword(10);
  setup();
}

void init() {
  add_action("do_team", "team");
}

int do_team(string arg) {
  string item, targ;
  if (!arg) {
    write("请参与剑阵说明");
    return 1;
  }
  if (sscanf(arg, "form %s", targ) == 1) {
    if (targ != "sha-array") {
      write("你要施展什么");
      return 1;
    } else {
      write("仙剑剑阵开始运作");
      set_heart_beat(1);
      user = this_player();

      user->set_temp("use_sha-array", 1);
      return 0;
    }
  }
  write("2");
  return 0;
}
void heart_beat() {
  object *target;
  int number, i;
  target = user->query_enemy();
  number = sizeof(user->query_team());
  tell_object(find_player("bigcat"), "hello\n");

  if (user->is_fighting() && user->query_temp("use_sha-array", 1)) {
    if (number == 2) {
      message_vision(HIY + "两仪剑阵如行云流水 ,生生不息 ,$N困于其中已渐渐迷失了自己\n" + NOR, target[i]);
      target[i]->start_busy(2);
    } else if (number == 4) {
      message_vision(HIR + "四象剑阵内有如千军万马 ,登时吓的$N魂不附体 ,无法对你攻击\n" + NOR, target[i]);
      target[i]->start_busy(4);
    }

    else if (number == 8) {
      message_vision(HIY + "八卦游龙引动九天九地之气 ,刹时金光万丈 ,使得$N妖气顿减 ,无法动弹\n" + NOR, target[i]);
      target[i]->start_busy(4);
    }
  }

  return;
}
