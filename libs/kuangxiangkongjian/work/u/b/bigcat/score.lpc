inherit F_CLEAN_UP;

#include <ansi.h>
#include <combat.h>

string status_color(int current, int max);
string date_string(int date);

void create() { seteuid(ROOT_UID); }

void wiz_score(object ob) {
  mapping my;
  string skill_type, couples, sp_title;
  object weapon;
  int attack_points, dodge_points, parry_points;

  my = ob->query_entire_dbase();
  if (ob->query("sp_title") == 0)
    sp_title = "武林新秀";
  else
    sp_title = ob->query("sp_title");

  printf(BOLD "%s" NOR "%s\n\n□ 生日：%s\n□ 年龄：%s岁\t性别：%s",
    RANK_D->query_rank(ob),
    sp_title + "      " + ob->short(),
    CHINESE_D->chinese_date((my["birthday"] - 14 * 365 * 24 * 60) * 60),
    chinese_number(my["age"]),
    my["gender"]
  );
  if (couples = my["couples/name"])
    printf("\t配偶是: %O", couples);

  printf("。\n□ 你总共杀了 %d 个人，其中有 %d 个是其他玩家。\n\n",
    my["MKS"] + my["PKS"], my["PKS"]);

  if (mapp(my["family"])) {
    if (my["family"]["master_name"])
      printf("□ 师父： " HIW "%s" NOR "。\n",
        my["family"]["master_name"]
      );
  }
  if (my["max_s_kee"])
    printf("□ 灵气：【 %s 】：" + HIG + "%d/%d\n" NOR,
      to_chinese(my["sec_kee"]),
      my["s_kee"], my["max_s_kee"]);

  if (my["class"] && my["class"] == "officer") {
    printf("□ 官位：【" HIW "%s" NOR "】\t权力：" HIY "%d/%d\n" NOR
      "\t政治经验：" HIC "%d\n" NOR,
      my["officer_class"],
      my["officer_power"],
      my["max_officer_power"],
      my["office_exp"]
    );
  }

  printf(
    "□ 膂力[str]：%d\t胆识[cor]：%d\t悟性[int]：%d\t灵性[spi]：%d\n" +
    "□ 定力[cps]：%d\t容貌[per]：%d\t根骨[con]：%d\t福缘[kar]：%d\n\n",
    my["str"], my["cor"], my["int"], my["spi"],
    my["cps"], my["per"], my["con"], my["kar"]
  );

  printf("□ 精：%s%4d/%d\t%s(%d%%)" NOR
    "\t灵力：%s%4d/%d\t(+%d)" NOR
    "\t\t食物：%s%4d/%d\n" NOR,
    status_color(my["gin"], my["eff_gin"]), my["gin"], my["eff_gin"],
    status_color(my["eff_gin"], my["max_gin"]),
    my["eff_gin"] * 100 / my["max_gin"],
    status_color(my["atman"], my["max_atman"]), my["atman"], my["max_atman"],
    my["atman_factor"],
    status_color(my["food"], ob->max_food_capacity()),
    my["food"],
    ob->max_food_capacity()
  );

  printf("□ 气：%s%4d/%d\t%s(%d%%)" NOR
    "\t内力：%s%4d/%d\t(+%d)" NOR
    "\t\t饮水：%s%4d/%d\n" NOR,
    status_color(my["kee"], my["eff_kee"]), my["kee"], my["eff_kee"],
    status_color(my["eff_kee"], my["max_kee"]),
    my["eff_kee"] * 100 / my["max_kee"],
    status_color(my["force"], my["max_force"]), my["force"], my["max_force"],
    my["force_factor"],
    status_color(my["water"], ob->max_water_capacity()),
    my["water"],
    ob->max_water_capacity()
  );
  printf("□ 神：%s%4d/%d\t%s(%d%%)" NOR
    "\t法力：%s%4d/%d\t(+%d)\n\n" NOR,
    status_color(my["sen"], my["eff_sen"]), my["sen"], my["eff_sen"],
    status_color(my["eff_sen"], my["max_sen"]),
    my["eff_sen"] * 100 / my["max_sen"],
    status_color(my["mana"], my["max_mana"]), my["mana"], my["max_mana"],
    my["mana_factor"]);
  /*
  if( objectp(weapon = ob->query_temp("weapon")) )
    if (present(weapon, ob))
      skill_type = weapon->query("skill_type");
    else {
        weapon = 0;
        ob->delete_temp("weapon");
        skill_type = "unarmed";
    }
  else
    skill_type = "unarmed";
 
  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);
 
  printf("□ 战斗攻击力："HIW"%O(+%O)"NOR
                   "\t战斗防御力："HIW"%O(+%O)\n" NOR,
    attack_points/100 + 1,
    (int)ob->query_temp("apply/damage"),
    (dodge_points + (weapon? parry_points: (parry_points/10)))/100 + 1,
    (int)ob->query_temp("apply/armor")
  );
*/
  printf("□ 杀      气：" RED "%O" NOR
    "\t潜      能：" HIY "%O(%O%%)" NOR
    "\t实战经验：" HIM "%O\n" NOR,
    my["bellicosity"],
    my["potential"] - my["learned_points"],
    (int)(1 + my["learned_points"]) * 100 /
    (1 + my["potential"]),
    my["combat_exp"]);
}

string state(int v, int max) {
  int ratio;
  string color;

  if (max == 0) return HIR + ":-? " + NOR;
  ratio = v * 100 / max;
  if (ratio > 100) color = HIC;
  else if (ratio == 100) color = HIW;
  else if (ratio >= 70) color = HIG;
  else if (ratio >= 30) color = HIY;
  else color = HIR;

  if (ratio > 100) return color + "*_* " NOR;
  else if (ratio == 100) return color + "^_^ " NOR;
  else if (ratio >= 80) return color + ":-) " NOR;
  else if (ratio >= 60) return color + ":-| " NOR;
  else if (ratio >= 40) return color + ":-( " NOR;
  else if (ratio >= 20) return color + ":-< " NOR;
  else return color + ":~~(" NOR;
}

void player_score(object ob) {
  mapping my;
  string skill_type, couples;
  object weapon;
  int attack_points, dodge_points, parry_points;

  my = ob->query_entire_dbase();

  printf(BOLD "%s" NOR "%s\n\n□ 生日：%s\n□ 年龄：%s岁\t性别：%s",
    RANK_D->query_rank(ob),
    ob->short(),
    CHINESE_D->chinese_date((my["birthday"] - 14 * 365 * 24 * 60) * 60),
    chinese_number(my["age"]),
    my["gender"]
  );
  if (couples = my["couples/name"])
    printf("\t配偶是: %O。\n", couples);
  else printf("。\n");

  printf("□ 你总共杀了 %d 个人，其中有 %d 个是其他玩家。\n",
    my["MKS"] + my["PKS"], my["PKS"]);

  if (mapp(my["family"])) {
    if (my["family"]["master_name"])
      printf("□ 师父： " HIW "%s" NOR "。\n",
        my["family"]["master_name"]
      );
  }
  if (my["max_s_kee"])
    printf("□ 灵气：【 %s 】：" + HIG + "%d/%d\n" NOR,
      to_chinese(my["sec_kee"]),
      my["s_kee"], my["max_s_kee"]);

  if (my["class"] && my["class"] == "officer") {
    printf("□ 官位：【" HIW "%s" NOR "】：权力 %d/%d：□ 政治经验：" HIC "%d\n" NOR,
      my["officer_class"],
      my["officer_power"], my["max_officer_power"],
      my["office_exp"]
    );
  }

  printf(
    "□ 膂力[str]：%d\t胆识[cor]：%d\t悟性[int]：%d\t灵性[spi]：%d\n"
    "□ 定力[cps]：%d\t容貌[per]：%d\t根骨[con]：%d\t福缘[kar]：%d\n\n",
    my["str"], my["cor"], my["int"], my["spi"],
    my["cps"], my["per"], my["con"], my["kar"]
  );

  printf("□ 精 %s%s%-6s%s  灵力 %s%-5s  经验值：" HIM "%-12d" NOR " 食物 %s  饮水 %s\n" NOR,
    state(my["gin"], my["eff_gin"]),
    status_color(my["eff_gin"], my["max_gin"]),
    "(" + my["eff_gin"] * 100 / my["max_gin"] + "%)", NOR,
    state(my["atman"], my["max_atman"]),
    "(" + my["atman_factor"] + ")",
    my["combat_exp"],
    state(my["food"], ob->max_food_capacity()),
    state(my["water"], ob->max_water_capacity())
  );

  printf("□ 气 %s%s%-6s%s  内力 %s%-5s  潜  能：%-12s " HIR "杀气 %-5d" HIR " 中毒 %s\n",
    state(my["kee"], my["eff_kee"]),
    status_color(my["eff_kee"], my["max_kee"]),
    "(" + my["eff_kee"] * 100 / my["max_kee"] + "%)", NOR,
    state(my["force"], my["max_force"]),
    "(" + my["force_factor"] + ")",
    my["potential"] - my["learned_points"] + "(" +
    (int)(1 + (int)my["learned_points"]) * 100 / (1 + (int)my["potential"]) + "%)",
    my["bellicosity"],
    ob->query_condition() ? ":~~(" : NOR ":-)",
  );

  if (objectp(weapon = ob->query_temp("weapon")))
    if (present(weapon, ob))
      skill_type = weapon->query("skill_type");
    else {
      weapon = 0;
      ob->delete_temp("weapon");
      skill_type = "unarmed";
    } else
      skill_type = "unarmed";

  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

  printf("□ 神 %s%s%-6s%s  法力 %s%-5s  攻击力：" HIW "%O(+%O)" NOR
    "\t防御力：" HIW "%O(+%O)\n\n" NOR,
    state(my["sen"], my["eff_sen"]),
    status_color(my["eff_sen"], my["max_sen"]),
    "(" + my["eff_sen"] * 100 / my["max_sen"] + "%)", NOR,
    state(my["mana"], my["max_mana"]),
    "(" + my["mana_factor"] + ")",
    attack_points / 100 + 1,
    (int)ob->query_temp("apply/damage"),
    (dodge_points + (weapon ? parry_points : (parry_points / 10))) / 100 + 1,
    (int)ob->query_temp("apply/armor"));
}

string status_color(int current, int max) {
  int percent;

  if (max) percent = current * 100 / max;
  else percent = 100;

  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

int help(object me) {
  write(@HELP
指令格式 : score
           score <对象名称>                   (巫师专用)
 
这个指令可以显示你(妳)或指定对象(含怪物)的基本资料。
基本资料的设定请参阅 'help setup'。
 
为了避免玩家为了「天赋”的数值而反覆创造人物，因此限定只有在综合评价达到
100 以上的玩家或巫师才看得到天赋状况。
 
see also : hp
HELP
  );
  return 1;
}

int main(object me, string arg) {
  object ob;
  mapping my;
  string line, str, skill_type, couples;
  object weapon;
  int attack_points, dodge_points, parry_points;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    arg = lower_case(arg);
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");

  if (wizardp(me)) wiz_score(ob);
  else player_score(ob);

  return 1;
}
