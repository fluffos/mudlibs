// copy from /d/snow/npc/teacher.c
inherit NPC;
int a;
int b;
void answer();
void create()
{
	set_name("萧光", ({ "shou","shou whon","whon"}) );
	set("gender", "男性" );
	set("age", 43);
	set("int", 26);
        set("long","他正聚精会神的看着桌上那一个大碗公,嘴中念念有词你好奇的
想知道那碗公里到底是啥宝贝,走近一看,挖哩勒,竟然是西八剌");
~        set("inquiry",([
        "禁地": "你是谁!!!禁地的事我一概不知,就算知道不会告诉你,你走吧\n",
        "封印": "唉!!别说那么多讨人厌的话题了,咱们玩两把吧,你赢了,再来问
        我也不迟啊\n"]));
	set("combat_exp",50000);
        set("max_kee",500);
        set("max_gin",500);                        
	set("attitude", "peaceful");
	set_skill("unarmed",50);
	set_skill("parry",50);
	set_skill("force",50);
	set_skill("chaos-steps",50);
	set_skill("liuh-ken",50);
	set_skill("fonxanforce",50);
	set_skill("six-chaos-sword",50);
	map_skill("unarmed","liuh-ken");
        map_skill("dodge","chaos-steps");
	map_skill("sword","six-chaos-sword");
	map_skill("force","fonxanforce");
	setup();
        carry_object("/open/su/obj/ten_sword")->wield();
        carry_object("/open/su/obj/snow_cloth")->wear(); 
   }

init()
{
add_action("玩_骰子","玩");
add_action("掷_骰子","掷");
}

int 玩_骰子(string str)
{
if(str!="骰子")
{
write("你要玩什么??");
return 0;
}
write("萧光道:你先来吧,请掷骰子");
return 1;
}

int 掷_骰子(string str)
{
randomize();
if(str!="骰子")
{
printf("你要玩什么??");
return 0;
}
write("你大喊:嬷眯八咪轰,天兵天将为我所用,西八辣!!!\n");
a=random(5)+1;
if(a>3)
{
printf("哈!哈!我掷到%d点,看来你是凶多吉少\n",a);
write("该你了!!\n");
}
else
{
printf("唉!唉!真是赛,竟然是%d点,你可乐了吧",a);
write("你掷吧!\n");
}
call_out("play_dice",5,this_player());
return 1
}
void play_dice()
{
write("只见萧光以迅雷不及掩耳速度,将碗公在空中晃了两圈,随即定在桌上,大叫一声开!!\n");
b=random(5)+1;
if(b>a)
{
printf("哈!小兄弟你输了,我掷到%d点",b);
}
if(b=a)
{ 
printf("我也是掷到%d点,这盘咱们可是合局了",b);
}
if(b<a) 
{
printf("真是背啊,竟是掷到%d点,算我倒楣,你有问题就问吧",b);
answer();
}
}
void answer()
{
set("inquiry",([
    "封印": "当年祖师爷逍遥子用三样法宝将他封印起来,祖师爷退休之后就把这三样
宝物分别交给他三个大弟子保管,要解开天魔的封印,非要这三样法宝同时施法,别无他法\n"
    ]));
}    