// copy from /d/snow/npc/teacher.c

inherit NPC;

void create() {
  set_name("旅人", ({ "treveller", "man" }));
  set("gender", "男性");
  set("age", 47);
  set("int", 26);
  set("long", "一个蜀中城的过客,看他跟旁人叙述着这几十年跑遍大江南北的奇闻\n
                    显示出他的确见识不凡!!");
  set("chat_chance", 10);
  set("chat_msg", ({ "
	旅人睁大眼睛的说:前个两天,我闲着没事干,就到处晃晃,走着走着不知怎么的周围\n
	的景物都变了个样,我一个紧张要走回客栈,不料走了一两个时辰,我又走回了原地,还好\n
	一位小剑童把我带了出去,否则啊,你们可能看不到我了,真是 好险啊!!",
    "旅人缓缓道来:后来听那位救我出来的剑童说:那是仙剑派所设的阵法,因为想到仙剑派学\n
	武的人实在过多,且参差不齐,所以在那设下迷宫,希望能让人们知难而退!!",
    "旅人愤愤的说:我被救出来后,那为小剑童竟然伸手向我要银两真是$%@^&%@!!" }));
  set("combat_exp", 5000);
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    "我哪得罪您了!!小人给您赔不是!!!" }));
  set("attitude", "peaceful");
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("force", 30);
  set_skill("chaos-steps", 50);
  set_skill("liuh-ken", 50);
  map_skill("unarmed", "liuh-ken");
  map_skill("dodge", "chaos-steps");
  setup();
}
