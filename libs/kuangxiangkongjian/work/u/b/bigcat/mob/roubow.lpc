// copy from /d/snow/npc/teacher.c

inherit NPC;

void create()
{
	set_name("刑老妈", ({ "mother hsin","hsin"}) );
	set("title", "老鸨");
	set("gender", "女性" );
	set("age", 47);
	set("int", 26);
	set("long","刑老妈堆着满脸笑容说道:客人来哦,咱家的姑娘可是一流的..\n
	至于价钱方面嘛,您可以问问(ask)我,咱们好商量.. ");
                    
	set("chat_chance",20);
	set("chat_msg",({"刑老妈笑道:客人您里面请,最近进了一些洋妞,包您过瘾啊!!\n",
	                 "刑老妈喝道:姑娘们好好伺候大爷啊!!\n",
	                 "刑老妈笑道:大爷:咱们这儿的姑娘可是环肥燕瘦,应有尽有,您看中哪一个啊.\n"
	                 }));
	
	set("combat_exp",5000);
set("chat_chance_combat",20);
	set("chat_msg_combat",({"刑老妈连忙道:大爷您喝醉了,我叫人把您扶回去吧!!\n",
	                        "刑老妈怒道:您别小看老妈子我,我当年也是叱吒江胡,还没人敢在我地方惹事!!\n",
	                        "刑老妈喝道:大爷您再不住手,我可不客气了!!"}));
	
	
	
	set("inquiry", ([
		"价钱": "嗯....这儿的姑娘可都是上等货色,只收您三两银子算是便宜您了。\n",
		"嫖妓": "客人您真爱说笑,来这当然是嫖妓喽。",
	]) );
	set("attitude", "peaceful");
	set_skill("unarmed",50);
	set_skill("parry",50);
	set_skill("force",30);
	
	set_skill("liuh-ken",50);
set_skill("chaos-steps",50);
	
	map_skill("unarmed","liuh-ken");
map_skill("chaos-steps",50);
	setup();
}

int recognize_apprentice(object ob)
{
	
	if( !ob->query("marks/刑老妈") ){
		say("刑老妈喝道：小子!!没钱还敢到这找姑娘!!!\n");
		return 0;
	}

	return 1;
}

int accept_object(object who, object ob)
{
	if( !who->query("marks/刑老妈") ) {
		if( ob->value() >= 300 ) {
			say("刑老妈逢迎的说:大爷您里边请..\n"
				"                      小红啊!!出来接客了!!。\n");
			who->set("marks/刑老妈", 1);
			return 1;
		} else {
			say("邢老妈斥道：就这么这丁点钱,你敢到这儿来!!。\n");
			return 0;
		}
	} else
		say("刑老妈逢迎着道:大爷您先喝点酒,姑娘马上就出来\n");
	return 1;
}
