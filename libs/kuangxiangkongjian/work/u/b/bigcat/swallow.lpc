// swallo.c

#include <ansi.h>
#include <combat.h>

int useforce(object me, object target)
{
        object ob;
	string msg,weapen ;
	int i,damage, ap, dp, ac , bu ,td,md,pp,max;
	
	if( !target
	||	!target->is_character()
	||	target->is_corpse()
	||	target==me)
		return notify_fail("你要对谁使用这个大决招？\n");
	
        if( !(ob = me->query_temp("weapon"))
            ||     ( (string)ob->query("skill_type") != "sword" 
            &        (string)ob->query("skill_type") != "blade") )
        return notify_fail("你必须要装备剑或是刀才能使用飞燕剑。\n");
                         
        weapen = ob->query("name");       

	if( me->query("force") < 30 )
		return notify_fail(" (你的爆发力还不够！)\n");

	me->add("force",-30);

//	if( random(me->query("max_atman")) < 50 ) {
//		write("你失败了。\n");
//		return 1;
//	}

	msg = HIY "$N身形忽变,"+weapen+HIY"在两手间快速变换,朝$n冲了过去\n\n" NOR;
	msg += HIY "使出了传说中的"+HIR" 飞燕剑 "NOR+"!!\n";
        message_vision(msg, me, target);
        td = target->query("dex");
        md = me->query("dex");
  
        ap = COMBAT_D->skill_power(me,"super", SKILL_USAGE_ATTACK) ;
        dp = COMBAT_D->skill_power(target, "dodge", SKILL_USAGE_DEFENSE) ;
        pp = COMBAT_D->skill_power(target, "parry", SKILL_USAGE_DEFENSE) ;
        dp += td * td * 3 ;
        
        ac = ap * 3 + me->query("apply/ac") * 60 + md * md * md / 2 + me->query("kar") * 200 ;
	max = (int)me->query_skill("super") * 2 / 6 ;        


        for( i=0;i<max;i++){
             damage = (int)random(ap)/10 + random(me->query_temp("apply/damage"))
                      - random(target->query_temp("apply/armor"));        
                        if( me->query("force")-3 < 0) 
                         { message_vision("(可惜$N冲击力已显不足,只好暂停攻势!)\n",me,target);
                           i=900;}
         else {
                        msg =  HIM "$N快速地挥出第 "+(i+1)+ " 剑,";                        
	   if( random(ac+pp) > pp*(i/4+1) ) {
	        if( random(ac+dp) > dp*(i/4+1) ) {
	              if( damage > 0 ) { 
			msg += "$p抵挡不住,煞时鲜血四溅.. " + HIR"( " + damage + " )\n" NOR;
			target->receive_damage("kee", damage, me);
			target->receive_wound("kee", damage/40, me);
			me->improve_skill("super", 1, 1);
                        	} else
		        msg += "但是没有对$p造成任何伤害!\n"NOR;
		         message_vision(msg, me, target);
		         if(damage > 0 ) COMBAT_D->report_status(target);
		         me->add("force",-3); }
            else {
	                msg += "可惜被$p躲过了..\n"NOR;
	                 message_vision(msg, me, target); }
	   } else {           
			msg += "结果$p看清了$N的招式,挡住了这一剑...\n"NOR;
			 message_vision(msg, me, target);
			i = 100; }
	} } 

	me->start_busy(1);
	target->start_busy(1);
	return 1;
}

