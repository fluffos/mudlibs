// lungshan.c

#include <ansi.h>
#include <combat.h>
inherit SKILL;
inherit SSERVER;

void berserk(object me, object victim, object weapon, int damage);
void sp_attack0(object me, object victim, object weapon, int damage);
void sp_attack1(object me, object victim, object weapon, int damage);
void sp_att2(object me, object victim, object weapon, int damage);
string m1 = "[1;31m$N手中长剑似灵蛇般朝$n刺去。\n[0m";
string m2 = "[1;33m敌人纵身急避 ,躲开了这致命的一击\n[0m";
int kar = this_player()->query("kar", 1);
int cps = this_player()->query("cps", 1);
int str = this_player()->query("str", 1);
int cor = this_player()->query("cor", 1);
int int1 = this_player()->query("int", 1);
int spi = this_player()->query("spi", 1);
int sp_value;
string *array_msg = ({
  "[1;33m$N带领着众剑士，脚踩八卦，剑化两仪，将仙剑剑法发挥到极致。\n[0m",
  "[1;33m众人愈战愈顺，愈战愈勇，令敌人望之胆怯。\n[0m",
  "[1;33m$N指挥若定，众人剑招一招招递向敌人，配合的天衣无缝。\n[0m",
});
mapping *action = ({
  ([
    "action": "$N突然领悟了[1;31m‘以心行气’[0m的道理并步点剑，气走会阴，正是一招‘蜻蜓点水’，",
    "dodge": -25,
    "parry": 30,
    "damage": 10,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N彻步抽剑，独立反刺，一招[1;31m‘大魁星式’[0m将使出来，颇有九岳震天之气魄",
    "dodge": -30,
    "parry": 35,
    "damage": 15,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N气如九曲珠行遍周身大穴，力贯剑尖，仆布横扫，正是一招[1;31m‘燕子抄水’[0m",
    "dodge": -30,
    "parry": 40,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N弓步带剑，气由‘会阴’而走‘祖窍’，正是一招[1m‘左右拦扫’[0m",
    "dodge": -30,
    "parry": 50,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N力由脊发，转体抡剑，一招[1m‘探海式’[0m将使出来，宛若蛟龙游之于海",
    "dodge": -30,
    "parry": 30,
    "damage": 45,
    "force": 130,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N退步回抽，右手持剑上提，正是一招[1m‘怀中抱月’[0m",
    "dodge": -20,
    "parry": 45,
    "damage": 55,
    "force": 100,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N了悟了剑谱上‘连绵不绝’之真义，手中长剑一荡连使出[1m‘蜻蜓点水’‘大魁星式’[0m，分攻$n周身大穴",
    "dodge": -35,
    "parry": 40,
    "damage": 100,
    "force": 70,
    "post_action": (: berserk :),
    "damage_type": "割伤",
  ]),
  ([ "action": "$N了悟了师父所云之‘顺人之势，后发先至’之真义，连续使出[1m‘蜻蜓点水’‘大魁星式’‘燕子抄水’[0m攻向$n",
    "dodge": -40,
    "parry": 50,
    "damage": 110,
    "force": 80,
    "post_action": (: berserk :),
    "damage_type": "割伤",
  ]),
  ([ "action": "$N领悟了所谓‘静中处动动犹静’，立即心如明镜，看出$n的破绽，一连使出[1m‘蜻蜓点水’‘大魁星式’‘燕子抄水’‘左右拦扫’[0m",
    "dodge": -30,
    "parry": 45,
    "damage": 150,
    "force": 90,
    "post_action": (: berserk :),
    "damage_type": "割伤",
  ]),
  ([ "action": "$N已得剑法精要，一连使出[1m‘蜻蜓点水’‘大魁星式’‘燕子抄水’‘左右拦扫’‘探海势’[0m剑气形成漩涡将$n包围其中",
    "dodge": -40,
    "parry": 45,
    "damage": 110,
    "force": 120,
    "post_action": (: berserk :),
    "damage_type": "割伤",
  ]),
  ([ "action": "[1;5m$N面露微笑，仰视苍天，待$n攻势已近，只见空中剑花闪闪，$N从容的收剑回窍，$n却已受到身受重伤[0m",
    "dodge": -45,
    "parry": 50,
    "damage": 120,
    "force": 130,
    "post_action": (: berserk :),
    "damage_type": "割伤",
  ]),
  ([ "action": "你使出仙剑后三式之第一招\n" +
    "----[1;36m□[1;34mB[1;36m□[1;34mY[1;36m□[1;34mH[1;36m□[1;34m□[0m---\n" +
    "你以气行剑,瞬时间一股寒气笼罩身旁,只见剑上薄冰渐起幻成冰柱,你手中长剑横扫,只见冰柱随剑气朝敌人猛裂刺去\n" +
    "敌人瞬间被刺伤多处...\n",
    "dodge": 70,
    "parry": 60,
    "damage": 150,
    "force": 130,
    "post_action": (: sp_attack0 :),
    "damage_type": "刺伤",
  ]),
  ([ "action": "你使出仙剑后三式之第二招\n" +
    " ----[1;35m□[1;31mU[1;35m□[1;31mV[1;35m□[1;31mi[1;35m□[1;31mi[0m---\n" +
    " 你手中长剑急使,愈使愈快,宛若汹涌巨浪向敌人直冲而去,瞬时压力遽增,\n" +
    " 敌人被巨浪震出内伤,鲜血狂喷....\n",

    "dodge": 80,
    "parry": 50,
    "damage": 150,
    "force": 140,
    "post_action": (: sp_attack1 :),
    "damage_type": "砍伤",

  ]),

  ([ "action": "你使出仙剑后三式之第三招\n" +
    "----[1;32m□[1;33m□[1;32m□[1;33m□[1;32m□[1;33mi[1;32m□[1;33m□[0m---\n" +
    "你长剑飞舞,霎时四周水波云气变化万千难以预料,敌人瞬间分不清剑在何方\n" +
    ",正在迟疑之际,.剑已穿体而出....\n",

    "dodge": 80,
    "parry": 50,
    "damage": 150,
    "force": 140,
    "post_action": (: sp_att2 :),
    "damage_type": "砍伤",

  ]),

});


int valid_learn(object me) {
  if (!me->query_temp("weapon"))
    return notify_fail("练仙剑剑术必需先拿把剑。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "sword" || usage == "parry");
}


mapping query_action(object me, object weapon) {
  int skill_level, limit;
  skill_level = (int)(me->query_skill("shasword", 1));
  limit = (int)(skill_level / 8);
  if (me->query_temp("use_form", 1))
    message_vision(array_msg[random(sizeof(array_msg))], me);
  if (limit < 1)
    return action[random(1)];
  else if (limit < 2)
    return action[random(2)];
  else if (limit < 3)
    return action[random(3)];
  else if (limit < 4)
    return action[random(4)];
  else if (limit < 5)
    return action[random(4) + 1];
  else if (limit < 6)
    return action[random(4) + 2];
  else if (limit < 7)
    return action[random(4) + 3];
  if (me->query("family/family_name") != "仙剑派" || !me->query("get_sha_sp", 1)) {
    if (limit < 8)
      return action[random(4) + 4];
    else if (limit < 9)
      return action[random(4) + 5];
    else if (limit < 10)
      return action[random(4) + 6];
    else
      return action[random(4) + 7];
  } else {
    if (limit < 8)
      return action[random(5) + 6];
    else if (limit < 9)
      return action[random(5) + 7];
    else if (limit < 10)
      return action[random(5) + 8];
    else
      return action[random(5) + 9];
  }
}
void sp_attack0(object me, object victim, object weapon, int damage) {
  sp_value = 4 * (cps + kar) + str + cor + spi + int1;
  if (sp_value > 200)
    if (weapon->query("id") == "han_bin_sword") {
      message_vision(
        "\n[1;36m□[1;34mH[1;36m□[1;34mB[1;36m□[1;34mC[0m剑上寒气与$N体内寒劲会合 ,霎时四周温度遽降 ,一股
阴寒内劲由$N手中长剑发出朝$n而去\n",
        me,
        victim
      );
      victim->add("kee", -sp_value);
      COMBAT_D->report_status(victim, 1);

    } else {
      message_vision("$N一运劲一道寒气发自$N的体内 ,藉由手中长剑斩向$n\n", me, victim);
      victim->add("kee", -sp_value / 2);
      COMBAT_D->report_status(victim, 1);

    }


}
void sp_attack1(object me, object victim, object weapon, int damage) {
  int i;
  sp_value = 4 * (str + cor) + cps + kar + spi + int1;
  if (sp_value > 200)
    if (weapon->query("id") == "hon_water_sword") {
      message_vision("[1;31m□[1;35ml[1;31m□[1;35m□[1;31m□[1;35mC[0m蕴含水劲磅礴 ,与此招式精义吻合 ,一股柔似水又强如浪
      的内劲已由$N发出直向$n而去\n", me, victim);
      victim->add("kee", -sp_value);
      COMBAT_D->report_status(victim, 1);
    } else {
      if (!me->query_temp("conti", 1)) {
        message_vision("藉由此招的精义 ,你感到一股前所未有力量由你体内源源而出 ,
一招接着一招攻向对方\n", me, victim);
        me->set_temp("conti", 1);
        for (i = 0; i < (random(3) + 1); i++)
          COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
        me->delete_temp("conti");
      }
    }
}

void sp_att2(object me, object victim, object weapon, int damage) {
  sp_value = 4 * (spi + int1) + 2 * str + cor + cps + kar;
  if (sp_value > 200)
    if (weapon->query("id") == "han_thon_sword") {
      message_vision(
        "[1;32m□[1;33mH[1;32m□[1;33m□[1;32m□[1;33mC[0m剑势迥异难测 ,加上第三招之变幻莫测 ,$n一个不留神中了$N
     一记强击且暂时无法对$N展开攻击\n",
        me,
        victim
      );
      victim->start_busy(1);
      victim->add("kee", -sp_value);
      COMBAT_D->report_status(victim, 1);
    } else {
      message_vision("$N招式突然千变万化 ,手中长剑如蛇般挥向敌人 ,$n摸不清$N的动向 ,
    冷不防的中了一剑\n", me, victim);
      victim->add("kee", -sp_value / 2);
      COMBAT_D->report_status(victim, 1);
    }
}

void berserk(object me, object victim, object weapon, int damage) {
  if (random(7) > 3) {
    if ((int)me->query_skill(
      "shasword",
      1
    ) > random(60) + 35 && me->query("force_factor") >= random(5) && me->query("force") > 30) {
      if (!me->query_temp("berserk")) {
        if (me->query("family/master_name") == "张乘风") {
          message_vision(
            sprintf("[1m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第一招‘射燕式’!!!\n [0m"), me, victim);
          if (random(me->query("combat_exp", 1)) * 2 > random(victim->query("combat_exp", 1))) {
            message_vision(sprintf(m1), me, victim);
            victim->receive_wound("kee", 50, me);
            me->add("force", -40);
          } else {
            me->add("force", -10);
            message_vision(sprintf(m2), me, victim);
          }
        }
        if (me->query("family/master_name") == "张乘云") {
          message_vision(
            sprintf("[1;31m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第二招‘挑屌式’!!。\n [0m"), me, victim);
          if (random(me->query("combat_exp", 1)) * 2.5 > random(victim->query("combat_exp", 1))) {
            message_vision(sprintf(m1), me, victim);
            victim->add("kee", -35);
            me->add("force", -15);
          } else {
            message_vision(sprintf(m2), me, victim);
            me->add("force", -10);
          }
        }

        if (me->query("family/master_name") == "范松") {
          message_vision(
            sprintf("[1;36m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第三招‘‘左车轮剑’!!!。\n [0m"),
            me,
            victim
          );
          if (random(me->query("combat_exp", 1)) * 1.3 > random(victim->query("combat_exp", 1))) {
            message_vision(sprintf(m1), me, victim);
            victim->add("kee", -60);
            me->add("force", -15);
          } else {
            me->add("force", -10);
            message_vision(sprintf(m2), me, victim);
          }
        }
        if (me->query("family/master_name") == "赵鹤") {
          message_vision(
            sprintf(" [1;35m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第四招‘流星赶月’!!!。\n [0m"),
            me,
            victim
          );
          if (random(me->query("combat_exp", 1)) > random(victim->query("combat_exp", 1))) {
            message_vision(sprintf(m1), me, victim);
            victim->add("kee", -70);
            me->add("force", -15);
          } else {
            message_vision(sprintf(m2), me, victim);
            me->add("force", -10);
          }
        }
        if (me->query("family/master_name") == "梁发") {
          message_vision(
            sprintf("[1;34m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第五招‘右车轮剑’!!!。\n [0m"),
            me,
            victim
          );
          if (random(me->query("combat_exp", 1)) * 1.5 > random(victim->query("combat_exp", 1))) {
            message_vision(sprintf(m1), me, victim);
            victim->add("kee", -50);
            me->add("force", -10);
          } else {
            message_vision(sprintf(m2), me, victim);
            me->add("force", -10);
          }
        }
        if (me->query("family/master_name") == "何双双") {
          message_vision(sprintf(" [1;32m $N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第六招‘天马行空’!!!\n[0m"), me, victim);
          if (random(me->query("combat_exp", 1)) * 2 > random(victim->query("combat_exp", 1))) {
            message_vision(sprintf(m1), me, victim);
            victim->add("kee", -40);
            me->add("force", -10);
          } else {
            message_vision(sprintf(m2), me, victim);
            me->add("force", -10);
          }

        }

        if (me->query("family/master_name") == "李逍遥") {
          message_vision(sprintf("[1;33m$N狂性骤起，口中喃喃有辞，使出仙剑禁断七绝之第七招‘石破天惊’!![0m"), me, victim);
          if (random(me->query("combat_exp", 1)) * 1.5 > random(victim->query("combat_exp", 1))) {
            message_vision(sprintf(m1), me, victim);
            victim->receive_wound("kee", 60, me);
            me->add("force", -30);
          } else {
            me->add("force", -10);
            message_vision(sprintf(m2), me, victim);
          }
        }

        if (me->query("family/master_name") == "郑士欣" || me->query("name") == "郑士欣" || me->query(
          "dragon-sword",
          1
        ) == 1) {
          message_vision(sprintf("[1;33m只见$N狂性骤起 ,大喝一声‘龙～气～剑’!!\n[0m"), me, victim);
          if (random(me->query("combat_exp", 1)) * 1.5 > random(victim->query("combat_exp", 1))) {
            message_vision(sprintf("\n[1;33m一股剑气如游龙般由$N体内发出对$n造成难以估计的伤。\n [0m"), me, victim);
            victim->receive_wound("kee", 100, me);
            me->add("force", -50);
          } else {
            message_vision(sprintf(m2), me, victim);
            me->add("force", -10);
          }
        }

        me->set_temp("berserk", 1);
      }
      me->delete_temp("berserk");
    }

  }
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 40);
  me->add("force", -5);
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("swordsman") + "/shasword/" + action;
}
