// crazy_dog.c

inherit NPC;

void create()
{
	set_name("扶桑浪人", ({ "jap" }) );
	set("race", "人类");
	set("age", 22);
	set("long", "一眼撇见这位老兄的衣着服饰，令你觉得些许好笑，却带着些许
	             不安，从他身上配戴的武器看来，此人大概是远从东瀛渡海而来
	             ，不知他此行目的为何。\n");
	set("attitude", "peaceful");
	set("str", 33);
	set("cor", 30);
	set("combat_exp", 1500);
	set("chat_chance", 6);
	set("chat_msg", ({
 	   (: this_object(), "random_move" :),
 	    "私□日本人□□□□□□□。"}) );
	set_temp("apply/attack", 15);
	set_temp("apply/damage", 6);
	set_temp("apply/armor", 2);
	setup();
}
