// fix by borstquc 

inherit EQUIP;

void create()
{
        set_name("通行证",({"Germany mark","mark"}) );
        set_weight(1000);
        if( clonep() )
		set_default_object(__FILE__);
	else {
        set("long","一张通行无阻的通行证。\n");
        set("unit","张");
        set("value", 500);
        set("material","cloth");
        set("armor_type","armbands");
        set("armor_prop/armor", 1);
	}
        setup();
}

