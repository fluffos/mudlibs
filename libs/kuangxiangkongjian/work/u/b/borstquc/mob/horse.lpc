inherit NPC;
void create()
{
set_name("的卢",({"di-lu"}));
set("long", "一匹强壮的千里马，牠正站在马厩中吃草。\n偶尔也甩甩牠那乌黑又长的尾巴。\n");
	set("race","野兽");
set("age",10);
set("str",20);
set("con",20);
set("max_gin",100);
set("max_kee",100);
set("max_sen",100);
	set("chat_chance", 4);
set("limbs", ({ "前啼","后啼","脖子","尾巴" }) );
set("verbs", ({ "dunt" }) );
    
                      
	set("chat_msg", ({

"牠扬了扬脖子，完全不理会你的存在，让人看了就想 kill 牠。\n",
	}) );
		
set("combat_exp",999999999);
	setup();
}
