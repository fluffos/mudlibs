// suck.c

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target) {
  int skill, dam;
  string str;

  if (target->query_temp("suck") == me->query("id"))
    return notify_fail("因为对方才被你蹂躏不久，所以你没有味口再下毒手。\n");

  if ((target->query_temp("unconcious") == 1) && (target->query_temp("last_damage_from") == me)) {
    skill = (int)me->query_skill("badforce", 1) / 10 + 1;
    switch (random(4)) {
      case 0:
        dam = target->query("combat_exp") / 20 * random(skill);
        target->add("combat_exp", -dam);
        me->add("combat_exp", dam);
        message_vision(
          HIB "$N使出恶化魔功\之吸功\大法，趁$n昏迷之时，吸取其战斗经验。\n" NOR, me, target);
        break;
      case 1:
        if (target->query("max_mana") < target->query("max_force")) {
          dam = target->query("max_force") / 20 * random(skill);
          target->add("max_force", -dam);
          me->add("max_force", dam);
          message_vision(
            HIG "$N使出恶化魔功\之吸功\大法，趁$n昏迷之时，吸取其魔法经验。\n" NOR, me, target);
          break;
        } else {
          dam = target->query("max_mana") / 20 * random(skill
          );
          target->add("max_mana", -dam);
          me->add("max_mana", dam);
          message_vision(
            HIY "$N使出恶化魔功\之吸功\大法，趁$n昏迷之时，吸取其内力经验。\n" NOR, me, target);
          break;
        }
        break;
      case 2:
      case 3:
        me->add("kee", -random((int)me->query("kee") / 2));
        me->add("sen", -random((int)me->query("sen") / 2));
        me->add("gin", -random((int)me->query("gin") / 2));
        message_vision(
          HIW "$N使出恶化魔功\之吸功\大法，趁$n昏迷之时，想吸取其经验，却不慎失败了，且元气大伤。\n" NOR, me, target);
        break;
    }
  } else
    return notify_fail("你只能对被你打昏的敌人施用此法。\n");
  return 1;
}
