// Room: /u/i/ice/workroom.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "神奇制冰场");
        set("long", @LONG
当你一踏入这个房间, 阵阵刺骨冷风往你的肺腔里猛钻, 仿佛要将你的内脏刮下一层
皮肉, 而放眼望去只是一片空荡, 虽然通风十分良好, 但是奇怪的是令人不禁由心底产生
一股凉意, 仿佛潜意识里告诉你这个地方很危险. 在阴暗的角落里有一台奇怪的机器
(Machine), 但是你却觉得机器好像一直在盯着你看, 令你觉得很不舒服.
LONG
        );
	set("exits", ([ /* sizeof() == 1 */
  		"down" : "/open/wiz/hall1.lpc",
		"east" : "/u/w/wade/workroom.lpc",
		"west" : "/u/f/fund/workroom.lpc",
		"north": "/u/c/chun/workroom.lpc",
		"south": "/u/l/lum/workroom.lpc",
		"up"   : "/u/i/ice/hell.lpc" ]));                       
        set("item_desc", ([
        "machine" : "一台奇怪的机器, 上面有一张标签(note), 机器上有浮出的钢印, 写着危险勿近.\n",
        "note" : "                      请拉(pull)杆子(lever)\n",
        ]));
        set("no_clean_up", 0);
        setup();
//        replace_program(ROOM);
}

void init(){
	add_action("do_pull","pull");
	add_action("do_fun","fun");
}

int do_fun(string str)
{
	if(stringp(str))
        message("system",HIW"郑士欣纵声大笑: 
哈哈哈哈....老夫实在太高兴啦!
英雄出少年 ,"+str+": 今后就由老夫亲授于你.\n"NOR,users());
	else if(this_player()->query("id")=="ice")
	        message("system",HIW"郑士欣纵声大笑: 
哈哈哈哈....老夫实在太高兴啦!
英雄出少年 ,"+this_player()->name()+": 今后就老夫就拜你为师.\n"NOR,users());
	else
        	return 0;
	return 1;
}


int do_pull(string str)
{
	object ob;
	ob = this_player();

        if(str!="lever"){
                write("你想拉什么?\n");
        }
        else {
                write("你走上前去, 大力的往杆子一拉. \n");
                tell_room(environment(ob),(string)ob->query("name")+
                "把杆子拉了一下.\n",({this_object(), ob}));
                tell_room(environment(ob),
                "一阵强光闪过, "+(string)ob->query("name")+"竟然不见了.\n",
                ({this_object(), ob}));
                write("突然你眼前一阵强光, 刺得你双眼无法张开.\n");
                ob->reincarnate();
                ob->move("/u/i/ice/room2");
                message("vision",
                "过了一会儿, 那阵强光仿佛消失了,你也可以张开眼睛看清四周了.\n",
                environment(ob), ob);
                return 1;
        }
}

