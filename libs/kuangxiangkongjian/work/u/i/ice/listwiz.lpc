// wizlist.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *list;
  int i, j;

  write(MUD_NAME + "目前的天神地鬼有：(前面有 * 者表正在线上)\n");
  list = sort_array(SECURITY_D->query_wizlist(), 1);
  write("                                   玉帝        阎王\n  ");
  for (i = 0, j = 0; i < sizeof(list); i++)
    if (SECURITY_D->get_status(list[i]) == "(admin)")
      printf(
        "%c%-10s%s",
        (find_player(list[i])) ? '*' : ' ',
        list[i],
        ((j++) % 7 == 6) ? "\n  " : ""
      );
  printf("%s                                   菩萨        鬼王\n  ", (j % 7 == 0) ? "" : "\n");
  for (i = 0, j = 0; i < sizeof(list); i++)
    if (SECURITY_D->get_status(list[i]) == "(arch)")
      printf(
        "%c%-10s%s",
        (find_player(list[i])) ? '*' : ' ',
        list[i],
        ((j++) % 7 == 6) ? "\n  " : ""
      );
  printf("%s                                   护法        判官\n  ", (j % 7 == 0) ? "" : "\n");
  for (i = 0, j = 0; i < sizeof(list); i++)
    if (SECURITY_D->get_status(list[i]) == "(wizard)")
      printf(
        "%c%-10s%s",
        (find_player(list[i])) ? '*' : ' ',
        list[i],
        ((j++) % 7 == 6) ? "\n  " : ""
      );
  printf("%s                                 天兵天将    牛头马面\n  ", (j % 7 == 0) ? "" : "\n");
  for (i = 0, j = 0; i < sizeof(list); i++)
    if (SECURITY_D->get_status(list[i]) == "(apprentice)")
      printf(
        "%c%-10s%s",
        (find_player(list[i])) ? '*' : ' ',
        list[i],
        ((j++) % 7 == 6) ? "\n  " : ""
      );
  write("\n");
  return 1;
}
