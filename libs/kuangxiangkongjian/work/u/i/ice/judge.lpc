// judge.c

#include <login.h>
#include <ansi.h>

inherit NPC;
inherit F_SAVE; 

int in_ask, answer;

void create()
{
	set_name("冰判官", ({ "judge" }) );
	set("short", "专门对付笨蛋的审判官(judge)" );
	set("long",
		"这是一位审查玩家是否是笨蛋的审判官，你必须答对(answer)他三个问题才能\n"
		"脱离他的掌握。\n");

	set("gender", "男性");
	set("chat_chance", 15);

	set("chat_msg_coombat", ({
                         "\n判官说道 : 你敢动我!? 等死吧!!\n" NOR,
                         "\n判官东闪西躲, 仿佛很轻松.\n" NOR,
                }) );
	set("age", 40);

	set("str", 100);
	set("int", 100);
	set("cor", 100);
        set("gin", 999);
        set("kee", 999);
        set("sen", 999);

	set("env/immortal", 1);
	set("combat_exp", 9000000);
	set("score", 0);

	set_temp("apply/attack", 5000000);
	set_temp("apply/damage", 5000000);
	set_temp("apply/dodge", 5000000);

	setup();
	set_skill("parry", 90);
	set_skill("unarmed", 90);
	set_skill("force", 90);
	set_skill("dodge", 90);

	in_ask = 0;
}

string query_save_file()
{
        return "/u/i/ice/judge";
}

void reset()
{
        int learn;

        // Improve judge's natural ability if there's potential available.
        if( (int)query("potential") > (int)query("learned_points") ) {
                learn = (int)query("potential") - (int)query("learned_points");
                add_temp("apply/attack", learn / 3);
                add_temp("apply/dodge", learn / 3);
                add_temp("apply/damage", learn / 3);
                add("learned_points", (learn / 3) * 3);
        }
        save();
}

varargs void improve_skill(string skill, int amount, int raw)
{
        // Thus we can gain skill levels from direct fighting.
        ::improve_skill(skill, amount);
}

void unconcious()
{
	say( "判官大叫一声 : 地藏王菩萨救我!!\n突然地藏王显灵医好了判官...\n ");
	reincarnate();
}
void revive()
{
        // This is a feature of sungoku's race. See the comic :P.
        add("combat_exp", (int)query("combat_exp") / 3 + 10);
        reset();
        ::revive();
}
 
void kill_ob(object ob)
{
        fight_ob(ob);
}

void defeated_enemy(object ob)
{
        say("判官拿起生死簿, 在上面又添了一划...\n" );
        remove_killer(ob);
}

int receive_damage(string type, int pts)
{
        int damage;

        damage = ::receive_damage(type, pts);
//        if( (type=="kee") && (damage > (int)query("max_kee") / 5) ) {
//                say("判官摀着受伤的地方，说道：好痛啊...真有你的....\n");
//        }

        if(((int)query("kee")) < 20
                || ((int)query("gin") < 20)
                || ((int)query("sen") < 20) ) {
                say( "判官大叫一声 : 地藏王菩萨救我!!\n突然地藏王显灵医好了判官...\n ");
		reincarnate();
        }
	return damage;
}

void init()
{
	::init();
	if( !query_heart_beat(this_object()) ) set_heart_beat(1);
	add_action("do_answer", "answer");
	delete_temp("wrong");
        delete_temp("slow");
        add_action("no_tell", "tell");
        add_action("no_tell", "reply");
        add_action("no_tell", "whisper");
        add_action("no_tell", "shout");
        add_action("no_tell", "wiz");
        add_action("no_tell", "sys");
        add_action("no_tell", "chat");
        add_action("no_tell", "rumor");
        add_action("no_goto", "goto");
	add_action("no_goto", "go");
        add_action("no_quit", "quit");
        add_action("no_cat", "cat");
        add_action("no_more", "more");
        add_action("do_search", "search");
        add_action("do_sos", "pray");
	add_action("no_home", "home");
	add_action("no_dest", "dest");
	add_action("no_dest", "smash");
	add_action("no_tell", ".");
        add_action("no_edit", "edit");
	add_action("no_update", "update");
	add_action("no_promote", "promote");
	add_action("no_tell", "clone");
	add_action("no_goto", "call");
        add_action("no_action", "perform");
        add_action("no_action", "exert");
        add_action("no_action", "cast");
        add_action("no_action", "conjure");
        add_action("no_action", "fight");
}

int no_action(string str){
        write("指令失效!!\n");
        return 1;
}


int no_update(string str){
	write("UPDATE?? 你想 update 题目?? 别想!! 快回答吧!!\n");
	return 1;
}

int no_promote(string str){
	write("你想做弊!!?? 门儿都没有!! Answer Question!!\n");
	return 1;
}

int no_edit(string str){
        write("EDIT?? 我们没装 DOS 哪来的 edit??\n");
        return 1;
}

int no_dest(string str){

	if(this_player()->query("id")=="ice" || this_player()->query("id")=="wade")	
	{
		command("say 是的!! " +this_player()->query("id")+ "!! 我的主人!! 我马上去死!!\n");
		this_object()->die();
		message_vision("只见$N一声令下, 冰判官切腹自杀了!!\n", this_player());
	}
	else		
		write("你想消灭我冰判官!?乖乖回答问题吧!!\n");
	return 1;
}

int no_tell(string str){
        write("想搬救兵!?门儿都没有!!\n");
        return 1;
}

int no_home(string str){

	string home_path;

	if(this_player()->query("id")=="ice" || this_player()->query("id")=="wade")
	{
		command("say 是的!! " +this_player()->query("id")+ "!! 我的主人!! 我马上送你走!!\n");
		home_path=user_path(geteuid(this_player()))+"workroom.lpc";
		this_player()->move(home_path);
		message_vision("只见一阵烟雾过后，$N的身影已经不见了。\n", this_player());
	}
	else	
		write("想回家??给我安份的回答问题吧!!\n");
	return 1;
}

int no_cat(string str){
        write("Cat??猫??没有猫啊!!\n");
        return 1;
}

int no_more(string str){
        write("More??你还要??乖乖的一题一题答吧!!\n");
        return 1;
}

int no_quit(string str){
        write("Quit??别想跑!!\n");
        return 1;
}

int no_goto(string str){
        write("你想到那里去啊!?答完问题才可以走!!\n");
        return 1;
}

void chat()
{
	int a, b, c, d;
	string oper;
	
	if( in_ask || random(20) > 10 ) return;
	a = random(100) + 1;
	b = random(100) + 1;
	switch(random(5)) {
		case 0: 
			answer = a + b;
			oper = chinese_number(a) + "加上" + chinese_number(b)+ "等于多少？";
			d=10;
			break;
		case 1: 
			answer = a - b;
			oper = chinese_number(a) + "减去" + chinese_number(b)+ "等于多少？";
			d=10;
			break;
		case 2: 
			if( a * b < 200 ) {
				answer = a * b;
				oper = chinese_number(a) + "乘上" + chinese_number(b)+ "等于多少？";
			} else {
				answer = (a * b) % 10;
				oper = chinese_number(a) + "乘上" + chinese_number(b)+ "，个位数等于多少？";
			}
			d=13;
			break;
		case 3: 
			answer = a % b;
			oper = chinese_number(a) + "除以" + chinese_number(b)+ "余于多少？";
			d=13;
			break;
		case 4:
			oper = chinese_number(a) + "和" + chinese_number(b)+ "的最大公因数是多少？";
			if( b < a ) { c = b; b = a; a = c; }
			while( a > 1 && b%a > 1 ) {
				c = a;
				a = b%a;
				b = c;
			}
                        answer = b%a == 1 ? 1 : a;
			d=15;
                        break;
		case 5:
			d = a*b; 
			oper = chinese_number(a) + "和" + chinese_number(b)+ "的最小公倍数是多少?";
			if( b < a ) { c = b; b = a; a = c; }
                        while( a > 1 && b%a > 1 ) {
                                c = a;
                                a = b%a;
                                b = c;
                        }
			answer = b%a == 1 ? d : d/a;
			d=15;
			break;
	}
	d+=random(5);
	command("say " + oper + "，请在" +chinese_number(d)+ "秒内作答(answer)。");
	in_ask = 1;
	call_out("say_answer", d);
}

void say_answer()
{
	int i;
        object me, *inv, ob;
	string id;

	me=this_object();
	command("say 这么简单都不会？笨蛋!!答案等于" + chinese_number(answer) + "。");
	inv = all_inventory(environment(me));
	for(i=0; i<sizeof(inv); i++)
	{
        	id = implode(inv[i]->parse_command_id_list(), ", ");
		if((id!="judge") && (id!="corpse") && (id!="board"))
		{
		command("say " +id+ "太慢了喔!! 给我小心一点!!");
                add_temp("slow/" + id, 1);
                if( query_temp("slow/" + id) > 4){
                command("say " + id + "你再发呆啊!! 再迟钝啊!! 给我去死吧!!");
		ob=present(id);
                ob->receive_damage("kee", 100, this_object());
                ob->set("env/immortal", 0);
                ob->die();
                delete_temp("slow/" + id);
                delete_temp("wrong/" + id);
		}
		}
	}
	in_ask = 0;	
}

int do_answer(string arg)
{
	string s;
	string home_path;
	int ans;
        int i;
        object me, *inv, ob;
        string id;


	if( !in_ask ) return notify_fail("你必须等下一题。\n");
	if( !arg ) return notify_fail("请你回答一个数字。\n");

	message_vision( CYN "$N答道：" + arg + "\n" NOR, this_player());
	
	if( sscanf(arg, "%d", ans)==1 ) {
		if( ans==answer ) {
			this_player()->add_temp("robot_check", 1);
			command("say 答对了！");
			command("pat " + this_player()->query("id") );
			remove_call_out("say_answer");
	me=this_object();
        inv = all_inventory(environment(me));
        for(i=0; i<sizeof(inv); i++)
        {
                id = implode(inv[i]->parse_command_id_list(), ", ");
                if((id!="judge") && (id!=this_player()->query("id")) && (id!="corpse") && (id!="board") )
                {
                command("say " +id+ "太慢了喔!! 给我小心一点!!");
                add_temp("slow/" + id, 1);
                if( query_temp("slow/" + id) > 4){
                command("say " + id + "你再发呆啊!! 再迟钝啊!! 给我去死吧!!");
		ob=present(id);
                ob->receive_damage("kee", 100, this_object());
                ob->set("env/immortal", 0);
                ob->die();
		delete_temp("slow/" + id);
		delete_temp("wrong/" + id);
                }
                }
        }

			
			in_ask = 0;
			if( this_player()->query_temp("robot_check") >= 3 ) {
				command("say 很好，你看起来不像笨蛋，你可以回家了。\n");
				if( stringp(s = this_player()->query_temp("old_startroom")) )
					this_player()->set("startroom", s);
				this_player()->delete_temp("robot_check");
				delete_temp("wrong/" + this_player()->query("id"));
				delete_temp("slow/" + this_player()->query("id"));
				if ( file_size(home_path=user_path(geteuid(this_player())) + "workroom.lpc") > 0 )
				{
				this_player()->move(home_path);	
				} else
				{
				if( stringp(s = this_player()->query_temp("old_location")) )
					this_player()->move(s);
				else
					this_player()->move(START_ROOM);
				}
			}
		} else {
			command("say 错！");
			add_temp("wrong/" + this_player()->query("id"), 1);
			if( query_temp("wrong/" + this_player()->query("id")) > 2 ) {
				command("say " + this_player()->name() + "你再给我乱猜啊，笨蛋!! 去死吧。\n");
				this_player()->receive_damage("kee", 100, this_object());
				this_player()->set("env/immortal", 0);
				this_player()->die();
				delete_temp("slow/" + this_player()->query("id"));
				delete_temp("wrong/" + this_player()->query("id"));
			}
		}
	}
	return 1;
}
