// magic_bag.c made by Konn

inherit ITEM;

void create()
{
        set_name("魔术袋", ({"bag"}) ); // 先把name and id 都先设好,但是重点
                                        // 是在short(),怕update 时会有bug,所
                                        // 以还是先设定
        set_weight(500);
	set("value", 100);
        set_max_encumbrance(50000); // 设定这个物品(袋子)最多可容纳多重的东西

        if( clonep() )
            set_default_object(__FILE__);
        else {
            set("long", "这是一口神奇的魔术袋.\n"); // long 也先写好, 但是重点
                                                    // 是在 long()
            set("unit", "口");

/*
  下面三个变数是一些特别的物品所要用的, 可视需要而使用
            set("no_drop", 1); // no_drop即不能丢也不能auc, 可能也不能卖
            set("no_sell", 1); // 因为不确定no_drop 可不可以sell, 因此还
                               // 是写一下安心 :>
            set("no_give", 1); // 无法把这个物品给别人
*/
        }

        setup();
}

// 这是用来告诉系统这个东西是拿来装东西的物品(即袋子类)
int is_container() { return 1; }

/*
这个函式是当系统要显示出这个物件的中文名称时所要呼叫到的, 我们可以
将程式加在这个地方, 随心所欲的改写short
*/
string short()
{
        object obj=this_object();

// 如果这个物品是在NPC 身上(包括玩家), 则short 是以下的文字
        if( environment(obj)->is_character() )
            return "[1;5;37m一口闪闪发光的魔术袋[m("+obj->query("id")+")";

// 若不是的话, 则short 是以下的文字
        else return "[1;34m一口肮脏垃圾袋[m("+obj->query("id")+")";

/*
由以上的程式看来, 原先设定的「魔术袋”根本就无用 :> ,
但是开始时还是要设定一下
如果你要延用原来设定的short 的话, 请记得用 ::short();
下面的long()道理跟这个一样
*/
}

// 这个函式是当系统要显示出这个物件的叙述时所要呼叫到的
string long()
{
        object obj=this_object();

        if( environment(obj)->is_character() )
            return @TEXT

闪闪发亮的魔术袋有着一股神秘的力量, 等着你去发掘它.

TEXT;
        else return @TEXT

这是一口毫不起眼的垃圾袋, 上面爬满了蟑螂及苍蝇.

TEXT;
}
