#include <ansi.h>
#include <weapon.h>

inherit SWORD;


void create() {
  set_name(HIW "天女神剑" NOR, ({ "god sword", "sword" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("base_unit", "把");
    set("base_value", 1000);
    set("value", 10000);
    set("material", "gold");
    set("wield_msg", "$n" HIW "感受到$N的仙气,散发出璀璨的光芒\n" NOR);
    set("unwield_msg", HIW "$N将天女神剑卸下,光芒渐渐隐退...\n" NOR);
  }
  init_sword(80);
  setup();
}


void init() {
  add_action("do_poison", "poison");
  add_action("fire", "use");
}

int query_auto_load() {
  return 1;
}

int fire(string str) {
  object target, targetenv;
  int gin1, kee1, sen1;

  if ((string)this_player()->query("id") != "oyuki")
    return notify_fail("嘿嘿,凡夫俗子也想动这把剑?还早呢!!!\n");
  if (!str || str == "") {
    write(HIW "妳祭起天女神剑,仙气浩然,七彩光芒流转不定!!\n" NOR);
    tell_room(environment(this_player()), HIW + this_player()->query("name")
      +HIW "身上的仙气与天女神剑相互呼应,放出七彩琉璃光辉!!\n" NOR,
      ({ this_object(), this_player() }));
    return 1;
  }
  target = present(str, environment(this_player()));
  if (!target) target = find_living(str);
  if (!target) {
    write(HIC + "你的功力还不够还不能杀人于百步之外\n" + NOR);
    return 1;
  }
  targetenv = environment(target);


  if (target != this_player())
    write(HIW + "妳将天女神剑往" HIB + (string)target->query("name")
      +HIW "一指, " + (string)target->query("name") + "被光芒炫得睁不开眼睛!!\n");
  else {
    write("剑不嗜主\n");
    return 1;
  }

  tell_room(environment(this_player()), "" + HIW
    +(string)this_player()->query("name")
    +HIW "将天女神剑朝" HIB + (string)target->query("name")
    +HIW "指去!" + (string)target->query("name") + "垄照于彩光之下,无法反应!!\n" NOR,
    ({ this_player(), target }));

  tell_room(environment(target), HIW "天女神剑的光芒罩住" HIB
    +(string)target->query("name") + HIW ", " HIB
    +(string)target->query("name") + HIW "全身被剑芒困住\n" NOR,
    ({ this_player(), target }));

  tell_object(target,
    HIW "天女神剑的光芒炙烧着你\n" NOR +
    "( 你" + RED "受伤过重，已经有如风中残烛，随时都可能断气。" NOR
    + " )\n");
  gin1 = target->query("gin") * 0;
  kee1 = target->query("kee") * 0;
  sen1 = target->query("sen") * 0;
  target->add("gin", -gin1);
  target->apply_condition("five_poison");
  target->add("kee", -kee1);
  target->add("sen", -sen1);
  if (target->query("kee") < 100) target->add("kee", -150);

  return 1;
}
