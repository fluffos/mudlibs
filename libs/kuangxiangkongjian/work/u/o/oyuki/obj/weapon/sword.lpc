#include <ansi.h>
#include <weapon.h>

inherit SWORD;


void create() {
  set_name(HIG "玉女剑" NOR, ({ "virgo sword", "sword" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("base_unit", "把");
    set("base_value", 1000);
    set("value", 10000);
    set("material", "gold");
    set("wield_msg", "只见$N伸手一指,$n出现在你的眼前\n");
    set("unwield_msg", "$N将手中的$n往天上一抛,瞬间化一股轻烟消失不见  \n");
  }
  init_sword(80);
  setup();
}


void init() {
  add_action("do_poison", "poison");
  add_action("fire", "use");
}

int query_auto_load() {
  return 1;
}

int fire(string str) {
  object target, targetenv;
  int gin1, kee1, sen1;

  if ((string)this_player()->query("id") != "oyuki")
    return notify_fail("不要乱动这把剑\n");
  if (!str || str == "") {
    write(HIW "你舞动着" HIG "玉女剑" HIW ",剑芒吞吐不定,煞是惊人\n" NOR);
    tell_room(environment(this_player()), HIC + this_player()->query("name")
      +HIW "舞动着" HIG "玉女剑" HIW ",剑芒吞吐,令你惊讶不已\n" NOR,
      ({ this_object(), this_player() }));
    return 1;
  }
  target = present(str, environment(this_player()));
  if (!target) target = find_living(str);
  if (!target) {
    write(HIC + "你的功力还不够还不能杀人于百步之外\n" + NOR);
    return 1;
  }
  targetenv = environment(target);


  if (target != this_player())
    write(HIW + "你挥舞着" HIG + "玉女剑" HIW + ",剑上剑芒朝" HIC + (string)target->query("name")
      +HIW "吐去，" + (string)target->query("name") + "被剑芒困住了\n" NOR);
  else {
    write("剑不嗜主\n");
    return 1;
  }

  tell_room(environment(this_player()), "" + HIC
    +(string)this_player()->query("name")
    +HIW "将" HIG "玉女剑" HIW "往" HIC + (string)target->query("name")
    +HIW "卷去！" + (string)target->query("name") + "生命可危\n" NOR,
    ({ this_player(), target }));

  tell_room(environment(target), HIW "忽然一道剑芒往向" HIC
    +(string)target->query("name") + HIW "飞去" HIC
    +(string)target->query("name") + HIW "全身被剑芒困住\n" NOR,
    ({ this_player(), target }));

  tell_object(target,
    HIW "一道剑芒飞逝\n" NOR +
    "( 你" + RED "受伤过重，已经有如风中残烛，随时都可能断气。" NOR
    + " )\n");
  gin1 = target->query("gin") * 0;
  kee1 = target->query("kee") * 0;
  sen1 = target->query("sen") * 0;
  target->add("gin", -gin1);
  target->apply_condition("five_poison");
  target->add("kee", -kee1);
  target->add("sen", -sen1);
  if (target->query("kee") < 100) target->add("kee", -150);

  return 1;
}
