inherit ITEM;
#include <ansi.h>

void create()
{
set_name(HIW"阿雪的爱心月饼"NOR,({"cookie"}));
set("long","
这是阿雪为了迎接中秋而赶工特制的月饼, 雪白粉酥的外皮, 香滑
可口的内馅, 咬起来有股冰凉沁人的快感,不知是用了何种成份??
\n");
        set("unit", "块");
	set("base_weight", 200);
}

void init()
{
	if( this_player()==environment() )
		add_action("do_eat", "eat");
}

int do_eat(string arg)
{
 if( !arg || arg != "cookie") return notify_fail("你要吃什么? \n");

    message_vision( HIY
"$N把月饼吃下, 只觉一股舒畅的冰凉从咽喉直下...\n"+
"$N对阿雪的手艺大感佩服...真不是普通的棒!!\n" NOR,this_player()  );

    destruct(this_object());
	return 1;
}
