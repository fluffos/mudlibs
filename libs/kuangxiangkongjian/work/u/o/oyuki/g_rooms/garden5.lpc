inherit ROOM;

void create() {
  set("short", "前院庭园");
  set("long", @LONG
迎面而来的, 是一片红梅林。每到入冬, 清幽的梅香, 艳丽的红梅衬着白雪, 这
景致真是叫人留恋难舍。怡红院冬季也常在此处安排姑娘在此吟唱舞袖, 红梅缤纷伴
歌舞, 可见怡红院的用心独特, 非一般青楼所能比拟。而在梅枝掩映之间, 似乎还有
一条小路.....
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "garden6",
    "east": __DIR__ "garden1",
  ]));
  set("outdoors", "/u/n");

  setup();
}

void init() {
  add_action("do_search", "search");
}
int do_search(string arg) {
  object me = this_player();
  write("你发现一条小径直通向西, 便走了过去。\n");
  me->move(__DIR__ "way3");
  return 1;
}
