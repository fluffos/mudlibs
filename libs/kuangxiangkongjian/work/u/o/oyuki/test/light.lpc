//lighter.c by urd
#include <mudlib.h>
#include <ansi.h>

inherit ITEM;
void create()
{
  seteuid(getuid());
  set_name(HIW+"雷光招唤"+NOR,({"lighting"}));
  set("long","这是兀儿德喜欢用的魔法，但是威力最小的一种。\n");
  set_weight(1000);
  set("unit","道");
}

void init()
{
  add_action("do_fire", "lighting");
}


int do_fire (string str)
{
  object target,targetenv;
//  int gin1, kee1, sen1;
  if(!((string)this_player()->query("id")=="oyuki"))
    return notify_fail("这不是$N所用的魔法!!\n");
  if(!str)
  {
    write(HIW"兀儿德从天上召唤一道雷, 只听见轰的一声......\n"NOR);
    tell_room(environment(this_player()), HIC+this_player()->query("name")
                +HIW"兀儿德的头上布满了乌云，从云中传出了雷声！\n"NOR,
                ({this_object(), this_player()}));
     return 1;
  }
  target=present(str,environment(this_player()));
  if(!target) target = find_player(str);
  if(!target) 
  {
    write(HIY+"看清楚在用雷打人...OK??\n"+NOR);
    return 1;
  }  
  targetenv=environment(target);
  if(!(target == this_player())) write(HIW+"天边的云海, 听我呼唤!\n"+
                                 "意会我心, 我 ,3神之长兀儿德在此--\n"+
                                 "雷  光  招  唤～～～\n");
  else
  {
    write("想自杀？用 suicide -f 比较快啦！\n");
    return 1;
  }
  message("system", HIW+"天边的云海，听我呼唤！\n\n"+
          "意会我心，我，三神之长兀儿德在此──\n\n"+
          "雷  光  招  唤～～～\n"+NOR,users());
  tell_object(target,HIW+"突然从天上降下一道大雷, 打在你身上!!\n"+NOR+
    "( 你"+RED+"受伤过重, 已经有如风中残烛, 随时都可能断气。"+NOR+")\n");
  return 1;
}
