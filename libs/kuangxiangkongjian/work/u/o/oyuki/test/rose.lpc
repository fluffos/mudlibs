#include <ansi.h>

inherit ITEM;

void create()
{
      set_name(HIM+"紫玫瑰"+NOR,({"rose"}) );
      set_weight(1000);

      if( clonep() )
           set_default_object(__FILE__);
      else {
           set("unit","束");
           set("long","一束鲜艳的玫瑰，带着迷人的色彩(fire flower)");
           set("value",500);
           }
      setup();
}
void init()
{
      add_action("do_fire","fire");
}
int do_fire(string arg)
{
      object me=this_player();
      if( !arg||arg!="flower" )  return 0;
 message("system",HIR"慕容清风手中花束化成只只彩蝶飞在天空。\n"NOR,users());
 message("system",HIR"彩蝶在天空排成一排字
”妳是永远的唯一，林依菁”\n"NOR,users());
            destruct(this_object());

           return 1;
}
int query_autoload()
{
    return 1;
}
