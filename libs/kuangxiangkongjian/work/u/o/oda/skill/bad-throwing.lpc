// bad-throing.c

#include <ansi.h>

inherit SKILL;

void throw_weapon(object,object,object,int);

mapping *action = ({
	([	"action":	"只见$N忽地仰天大笑，一招‘笑面阎罗’让人捉摸不定，手中的$w却早已向$n$l直射而去",
		"dodge":	-45,
		"damage":	40,
		"parry":	-30,
		"post_action":  (: throw_weapon :),
	]),
	([	"action":	"$N使出‘六亲不认’，$w自手中疾射而出，直取$n$l",
		"dodge":	-30,
		"damage":	70,
		"parry":	-20,
		"post_action":	(: throw_weapon :),
	]),
	([	"action":	"$N回眸一笑，眼角却飘出诡异的神情，原来一招‘最毒妇人’$w已向$n要害射去",
		"dodge":	-40,
		"damage":	120,
		"parry":	-10,
		"post_action":	(: throw_weapon :),
	]),
	([	"action":	"$N跃上空中身形一转，霎时爆射出无数$w向四面撒去，正是一招‘修罗地狱’",
		"dodge":	-50,
		"damage":	100,
		"parry":	-25,
		"post_action":	(: throw_weapon :),
	]),
});

int valid_learn(object me)
{
	object ob = me->query_temp("weapon");
        int skill, bell;
        skill = me->query_skill("bad-throwing", 1);
        bell = me->query("bellicosity");

	if( me->query_skill("badblade") )
		return notify_fail("恶人谷的武功你只能学一种。\n");
	if( !ob || ob->query("skill_type")!="throwing" )
		return notify_fail("你手上要有暗器才能恶人谷暗器。\n");
	if( me->query_skill("throwing", 1)<10 )
		return notify_fail("你连投都投不准，还是先去练练暗器使用再来吧。\n");
        if( (skill<50 && bell<(skill*5)) || (skill>=50 && bell<250) )
               return notify_fail("你的杀气不足，在暗器的功力上无法突破。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage=="throwing";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( me->query("sen")<25 )
		return notify_fail("你的神不够，无法专心练习暗器。\n");
	if( me->query("force")<3 )
		return notify_fail("你的内力不足，休息休息吧。\n");
	me->receive_damage("sen", 25);
	me->add("force", -3);
	return 1;
}

string perform_action_file(string action)
{
	return CLASS_D("bandit")+"/bad-throwing/"+action;
}

void throw_weapon(object me, object victim, object weapon, int damage)
{
        if( objectp(weapon) ) {
                if( (int)weapon->query_amount()==1 ) {
                        weapon->unequip();
                        tell_object(me, HIY"\n龟了，你的"+weapon->query("name")+"用完了！\n\n"NOR);
                }
                weapon->add_amount(-1);
        }
}
