// gold.c by oda

#include <ansi.h>
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill = 10;

  if (target != me) {
    tell_object(me, "你只能对自己使用天魔金身。\n");
    return 1;
  }
  if (me->query("force") < 300) {
    tell_object(me, "你的内力不够，无法使用天魔金身。\n");
    return 1;
  }
  if (me->query("bellicosity") < 250) {
    tell_object(me, "你身上的杀气不够，无法发挥天魔金身的强大战斗力。\n");
    return 1;
  }
  if (me->query_temp("gold") == 1) {
    tell_object(me, "你已经在用了。\n");
    return 1;
  }

  me->add("force", -300);
  me->set_temp("gold", 1);
  message_vision(
    HIY "$N运起恶化魔功\的最高绝学‘天魔金身’，将功\力提升至极尽，浑身金光暴现，体内气劲如万马奔腾！\n" NOR, me);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill);

  if (me->is_fighting()) me->start_busy(3);
  return 1;
}

void remove_effect(object me, int amount) {
  me->delete_temp("gold");
  message_vision(HIW "$N身上的金色光芒开始退去，战力也逐渐减弱。\n" NOR, me);
}
