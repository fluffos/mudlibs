// made by onion
#include <weapon.h>
inherit STABBER;
void create()
{
        set_name("奇怪的笔",({"strange pen","pen"}));
        set_weight(10000);
        if( clonep() ) 
          set_default_object(__FILE__);
        else 
        {
          set("unit", "支"); 
          set("value",100000);
          set("material","iron");
        }         
	setup();
	init_stabber(10);
}
void init()
{
	set_heart_beat(1);
}
void heart_beat()
{
	int i;
	object ob=this_object();
	object me=environment(this_object());
	object *enemy;
	if(me->is_character() && me->is_fighting() && ob->query("equipped")=="wielded" && random(100)>80 )
	{
	  enemy=me->query_enemy();
	  i=random(sizeof(enemy));
	  message_vision("[1;5;36m$N手中"+ob->query("name")+"发出一道激光射中$n。[0m\n",me,enemy[i]);
	  enemy[i]->add("kee",-1);
	  COMBAT_D->report_status(enemy[i]);
	} 
}