// Room: /u/o/oda/room/test.c

inherit ROOM;

void create() {
  set("short", "笨蛋测试房");
  set("long", "这是一间什么也没有的空房间。
");

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "workroom",
    "south": __DIR__ "workroom.lpc",
  ]));

  set("objects", ([ /* sizeof() == 1 */
    "/open/badman/npc/guard": 1,
  ]));


  setup();
}

void init() {
  add_action("do_test", "test");
}

int do_test() {
  object who, guard;
  who = this_player();
  guard = present("guard", this_object());
  if (guard) {
    guard->command("smile");
    guard->kill_ob(who);
    return 1;
  }
  return notify_fail("no guard!\n");
}
