// Room: /u/o/oda/room/meeroom.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "苏小妹妹的家");
  set(
    "long",
    @LONG
这里是苏小妹妹的家，和煦的阳光从明亮的落地窗照了进来，四周的书架上堆满了各式各样的散文与小说，一旁的 CD 唱盘也播放着优雅的古典音乐；苏小妹正坐在地上抱着她的龙猫娃娃在看书，你注意到她身旁的小茶几上放了一杯刚倒好的冰牛奶(milk)，看来这苏小妹还真会享受呢！
LONG
  );

  set("no_spells", 1);
  set("item_desc", ([ /* sizeof() == 1 */
    "milk": "哇！好一杯冰凉的光泉鲜乳，你忍不住想喝喝看(drink)。
",
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "workroom.lpc",
  ]));
  set("no_fight", 1);
  set("objects", ([ /* sizeof() == 2 */
    "/u/o/oda/npc/mee": 1,
    "/u/o/oda/npc/cc": 1,
  ]));
  set("no_magic", 1);

  setup();
}

void init() {
  add_action("do_drink", "drink");
}

int do_drink(string str) {
  object ob;
  ob = this_player();

  if (!str)
    return notify_fail("你要喝啥?\n");
  else if (str != "milk")
    return notify_fail("你以为这里是统一面包啊！想喝什么都有！?\n");
  else {
    write("你拿起杯子闻了一闻：嗯~ 好香好浓的 OAK 啊....当你正想好好品尝一口时...........\n");
    message("vision", "你发现" + ob->query("name") + "正在向桌上的鲜奶伸出他的魔手.....\n", environment(ob), ob);
    call_out("do_drink2", 2, ob);
    return 1;
  }
}

int do_drink2(object ob) {
  message_vision("
忽然间，苏小妹举起好大好大的铁锤!! 哇!
     " + HIC "*****************." NOR + "
     " + HIC "*               *." NOR + "
     " + HIC "*  500000000 Pt *." NOR + "   往$N头上用力一敲!
     " + HIC "*               *." NOR + "
     " + HIC "*****************." NOR + "   " + HIY "*** ‘ 锵 !’***" NOR + "
            " + HIC "| |." NOR + "
            " + HIC "| |." NOR + "
            " + HIC "| |." NOR + "          你看到$N头上好多好多美丽的蝴蝶飞来飞去说! :b
            " + HIC "|_|.\n" NOR, ob);
  message_vision(CYN "\n苏小妹对着$N大笑说：哼哼~ 看你还敢不敢偷喝我的牛奶...*grin*\n" NOR, ob);
  return 1;
}
