// mee.c 这是苏小妹的档案

inherit NPC;

void create() {
  set_name("苏小妹", ({ "mee" }));
  set("gender", "女性");
  set("age", 21);
  set("long", "你看到一位天真活泼的小妹妹, 看到她可爱的模样, 你忍不住想去亲亲(kiss)她。不过如果你想欺负她的话, 小心信长跟ＣＣ可不会饶过你的喔！\n");

  set("str", 24);
  set("cor", 26);

  set("chat_chance", 4);
  set("chat_msg", ({
    "苏小妹微笑着对你说：你喜欢香蕉吗? 香蕉很好吃喔!\n" }));

  set_temp("apply/attack", 10);
  set_temp("apply/armor", 3);

  setup();
}

int accept_object(object who, object ob) {
  if (ob->id("bone")) {
    message("vision", name() + "高兴地汪汪叫了起来。\n", environment());
    return 1;
  }
}
