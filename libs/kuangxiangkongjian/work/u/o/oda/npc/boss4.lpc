// /open/su/npc/boss4.c by oda
#include "/open/su.h"
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name(HIB "鞋匠" NOR+"任我行",({"Zen","zen"}));
	set("gender", "男性" );
	set("age", 28);
	set("long", @LONG
	你看到一个强壮的男子正在辛勤的工作着，虽然汗水
	不断的从他的额头滑落，但是他仍然不会忘记随时跟
	来往的客人开开玩笑，想必是一个乐天知命的人吧。

LONG );
	set("attitude", "friendly");
	set("vendor_goods", ([
	"高跟鞋"	:__DIR__"obj/rootshoes",
	"绣花鞋"	:__DIR__"obj/flowerboots",
	"麻布鞋"	:__DIR__"obj/linenshoes",
	"黑布鞋"	:__DIR__"obj/blackboots",
	"草鞋"		:__DIR__"obj/plantshoes",
	"皮靴"		:__DIR__"obj/leatherboots",
	]) );
	setup();
}

int accept_fight(object ob)
{
return notify_fail("任我行说：小的只是个鞋匠，不会啥武功\，您就放过我吧！\n");
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
		say("任我行大声的吆喝道：这位"+RANK_D->query_respect(ob)
			+"买双鞋吧！\n");
		break;
		case 1:
		say("任我行得意的对你说：我做的鞋保证耐用喔！\n");
		break;
		case 2:
		say("任我行高声喊道：来喔~ 买鞋喔~ 不好穿不要钱喔！\n");
		break;
	}
}
