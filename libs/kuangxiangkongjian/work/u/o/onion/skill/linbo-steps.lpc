// linbo-steps.c

inherit SKILL;

string *dodge_msg = ({
  "$n左足跨出，既踏「中孚”，立转「既济”，「神光离合，乍阴乍阳”，斜斜的躲过$N。",
  "只见$n甫上「泰”位，一个转身，右脚踏上「蛊”位，「体迅飞鹫，飘忽若神”，反而绕到$N身后。\n",
  "$n足下自然而然自「井”位斜行，踏到了「讼”位，「涑轻躯以鹤立，若将飞而未翔”，轻轻松松地躲过$N的招式。\n",
  "$n自「豫”位踏「观”位，「翩若惊鸿，婉若游龙”，闪身从$N身旁绕过。\n",
  "$n跟着斜踏「蛊”位，「忽焉纵体，以遨以嘻”，身子轻轻飘了开去。\n",
  "$n忽高忽低，有若「髣佛兮若轻云之蔽月，飘飘兮若流风之回雪”般。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力上限值不够，没有办法练凌波微步。\n");
  if (me->query_skill("literate") <= (me->query_skill("linbo-steps") * 2))
    return notify_fail("你的知识不足，无法体会凌波微步中易经" +
      "六十四卦的精要变化。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if (me->query("gin") < 50)
    return notify_fail("你的神不够，不能练凌波微步。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的气不够，不能练凌波微步。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够，无法踏出凌波微步。\n");
  me->receive_damage("kee", 30);
  me->receive_damage("gin", 5);
  me->add("force", 1);
  return 1;
}
