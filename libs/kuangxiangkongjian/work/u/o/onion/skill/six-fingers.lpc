  ]),
  ([ "action": "[1m$N大喝一声，鼓动全身真气，内劲流转，双手六剑齐发，十指分弹，霎时剑气纵横，似有无数迅雷疾风互冲激荡向$n而去[0m",
    "dodge": -50,
    "parry": -20,
    "damage": 140,
    "force": 300,
