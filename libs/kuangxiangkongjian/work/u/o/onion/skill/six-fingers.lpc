    "force": 400,
    "damage_type": "刺伤",
    "weapon": "拇指剑气",
    "post_action": (: pause :),
  ]),

  ([ "action": "$N食指一伸，[1m‘商阳剑’[0m意随心转，一道真气由指端冲出，直射$n$l，难以捉模",
