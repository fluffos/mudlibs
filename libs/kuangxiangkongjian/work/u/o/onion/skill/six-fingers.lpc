// six-fingers by Onion
#include <combat.h>
inherit SKILL;

void hurt(object me, object victim, object weapon, int damage);
void pause(object me, object victim, object weapon, int damage);
void bleed(object me, object victim, object weapon, int damage);
void conti(object me, object victim, object weapon, int damage);

mapping *action = ({
  ([ "action": "$N拇指一拈，体内真气流转，[1m‘少商剑’[0m剑路雄劲，霸道的向$n$l激射而去，颇有石破天惊，风雨大至之势",
    "dodge": -30,
    "parry": -20,
