    "post_action": (: conti :),
  ]),
  ([ "action": "$N暗运[1m‘少商剑’[0m，体内真气流转，剑路雄劲，剑气由$w激出，霸道的向$n$l激射而去，颇有石破天惊，风雨大至之势",
    "dodge": -30,
    "parry": -20,
    "damage": 110,
