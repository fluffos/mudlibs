// suckforce.c  By Onion

inherit F_CLEAN_UP;

int exert(object me, object target)
{
	int amount=random(me->query_skill("seaforce",1));
	
	if( !target || target->is_corpse() || !target->is_character() || target==me)
	  return notify_fail("你要用北冥神\功\吸谁的内力? \n");
	if( me->is_fighting() )
	  return notify_fail("战斗中没有机会吸取敌人内力。\n");
        if( target->query_temp("suckforce") )
          return notify_fail(target->query("name")+
          "一看到你走过来, 便认出你来, 使你找不到机会使用北冥神\功\。\n");
        if(me->query("force")<target->query("force")) 
          return notify_fail("你的内力不够, 恐怕无法承受对方雄厚的内力。\n");
        if(environment(me)->query("no_fight")==1)   
          return notify_fail("这里不准战斗。\n");

	target->set_temp("suckforce",1);
	message_vision("[1;31m$N运起北冥神\功\, 以迅雷不急掩耳的速度将手伸向$n胸前的坛中穴。[0m\n",me,target);
	if( random(me->query("combat_exp")) < random(target->query("combat_exp")) )
  	{
  	  message_vision("[1;31m结果, $N的动作不够灵敏, 被$n发现了。[0m\n",me,target);
	  target->kill_ob(me);
	  me->kill_ob(target);
  	  return notify_fail("\n");
	}
	message_vision(
	"[1;33m$N登时手足痠麻, 无法动弹。[0m\n",target);
	        
	if( amount > target->query("force") )
	 amount=target->query("force");
	if( amount > (me->query("kee")-10)/3 )
	 amount=(me->query("kee")-10)/3;
	 
	me->receive_damage("gin", 10);
	me->receive_damage("kee", amount*3);
	me->receive_damage("sen", 10);
	
	tell_object(me,"[1;33m(你现在无法动作)[0m\n");
	tell_object(target,"[1;33m(你现在无法动作)[0m\n");

	me->set_temp("block_msg/all", 1);
	target->set_temp("block_msg/all", 1);
        
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me ,target,amount:), amount/10+5);

	return 1;
}

void remove_effect(object me, object target, int amount)
{
        me->add("force",amount);
        target->add("force",-amount);

	me->set_temp("block_msg/all", 0);
        target->set_temp("block_msg/all", 0);
        
        tell_object(me,"[1;31m你觉得吸入的内力在你经脉中一阻, 双手不由自主的垂了下来, 离开了"+
        target->query("name")+"身上。[0m\n");
        tell_object(target,"[1;31m"+me->query("name")+"终于将双手拿开, 你一得到自由, 便恨不得把"+
        me->query("name")+"碎尸万段, 马上一招就打了过去。[0m\n");
	tell_object(environment(me),"[1;31m"+me->query("name")+"和"+
	target->query("name")+"忽然打了起来[0m\n");

	target->kill_ob(me);
	me->kill_ob(target);
}
