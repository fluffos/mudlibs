// 小胖专用技能 : 变态神掌 //
#include <ansi.h>
inherit NPC;
// void do_special();

mapping *action = ({
  ([ "action": "$N使出一招变态神掌第一式[快打升龙拳], 由下而上打向$n的下巴"
    ,
    "dodge": -30,
    "parry": 20,
    "ac": 10,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N两手回收成花形, 大喊:「看我的变态神掌第三式[龟派气功]!!”
一记金黄色的气波击向$n的$l",
    "dodge": -30,
    "parry": -30,
    "ac": 20,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N纵身跳起,使出一招变态神掌第二式[无敌剪刀脚],双腿瞬间朝向$n的
头部攻来",
    "dodge": -30,
    "parry": 20,
    "ac": 23,
    "damage_type": "伤害"

  ]),
  ([ "action": "$N忽地一吼,一招变态神掌第四式[小胖摸摸]以迅捷无比的速度扑
向$n",
    "dodge": 30,
    "parry": -30,
    "ac": 25,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N忽然欺身上前,抱住$n的肚子,使出一招变态神掌第五式[小胖抱
抱]",
    "dodge": -20,
    "parry": -20,
    "ac": 25,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N忽然分身成两人, 冲向$n的双手双
脚, 大喊一声:「变态神掌第六式[阿鲁巴],就抬起$n撞向一根不知从哪来的仙人掌!!",
    "dodge": -30,
    "parry": -30,
    "ac": 29,
    "damage_type": "伤害"
  ]),
  ([ "action": "$N忽然站立着不动, 口中一直唸着「
小胖最变态”五个字, 一时$N" + HIY "全身发出金光" NOR + ", 大喊:「看我的变
态神掌最后一式....[小胖亲亲],冲向$n一阵狂吻!!",
    "dodge": -50,
    "parry": -50,
    "ac": 35,
    "damage": 1000,
    "damage_type": "伤害"
  ]),
});
void create() {
  set_name("小胖", ({ "smallfat" }));
  set("gender", "男性");
  set("class", "scholar");
  set("attitude", "heroism");
  set("age", 18);
  set("title", "变态神教开山祖师");
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("per", 30);
  set("int", 30);
  set("con", 30);
  set("spi", 30);
  set("kar", 30);
  set("gin", 5000);
  set("max_gin", 5000);
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 500);
  set("force", 50000);
  set("max_force", 50000);
  set("force_factor", 100);
  set("combat_exp", 50000000);
  setup();
  set("default_actions", (: call_other, __FILE__, "query_action" :));
  reset_action();
}

mapping query_action() {
  return action[random(sizeof(action))];
}
