inherit NPC;

string play();

void create() {
  set_name("小厮", ({ "footboy", "boy" }));
  set("race", "人类");
  set("age", 13);
  set("gender", "男性");
  set("long",
    "  小厮还是个年纪小的男孩,正是喜欢嬉戏的时期,可是却不得不在在这儿工作.\n"
  );
  set("chat_chance", 20);
  set("chat_msg", ({
    "小厮满脸不高兴的说 : 才不过碰了一下花瓶,就被大管家骂。\n",
    "小厮疑惑的说 : 那花瓶到底有多贵重啊?\n",
  }));
  set("inquiry", ([
    "name": "我叫小狄,你可以陪我玩吗?",
    "squire": "这里有很多婢女小厮啊..请问你要找谁?",
    "小兰": (: play :),
    "bottle": "我也不清楚到底是怎么回事? 大概只有大管家才知道吧..\n" +
    "	       不过我可不敢去问.",
  ]));
  set("attitude", "friendly");
  set_temp("apply/attack", 10);
  setup();
  add_money("coin", 10);

}

string play() {
  object me = this_player();
  me->set_temp("play", 1);
  return "啊..她想要跟我玩吗?可以的话,请你帮我邀她到花园一起玩耍.";
}
