inherit NPC;
inherit F_MASTER;

string do_name_1();
void do_name_0();

void create() {
  set_name("大管家", ({ "steward" }));
  set("race", "人类");
  set("gender", "男性");
  set("age", 50);
  set("long",
    "大管家身着青丝长袍,脸上留着几緅山羊胡,看起来温文儒雅,实在很难想像\n" +
    "他便是管理整个武威镖局的人...\n"
  );
  set("int", 25);
  set("per", 25);
  set("inquiry", ([
    "bottle": " 这...这...ㄜ...那可是很昂贵的宝物,你千万不要乱动呦...",
    "茶花": "那是我从故乡带来的,小姐十分的喜爱,将整个花园都种满了。",
    "段家": (: do_name_0 :),
    "name": (: do_name_1 :),
    "here": "这儿便是名满蜀中的武威镖局."
  ]));
  create_family("大理段家", 8, "弟子");
  set("title", "");
  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 30);
  set_temp("apply/armor", 500);
  //	set_skill("seaforce",100);
  //	set_skill("linbo-steps", 100);
  //	set_skill("six-fingers", 100);
  //	map_skill("force","seaforce");
  //	map_skill("dodge","linbo-steps");
  //	map_skill("move","linbo-steps");
  set("combat_exp", 20000);
  set("score", 10);
  setup();
  add_money("gold", 100);
  carry_object("/u/o/onion/obj/slik_c")->wear();
}
void init() {
  add_action("do_need", "need");
  add_action("do_nickname", "nickname");
}

int do_need(string str) {
  object me = this_player(), weapon_file;
  string what_weapon = me->query("marks/get_weapon");
  message_vision("$N恳求的说:请赐我‘" + str + "’吧...\n", me);
  if (me->query("family/family_name") == "大理段家") {
    if (str == "blood-river" || str == "red-sleeve" || str == "should-not" || str == "stay") {
      switch (str) {
        case "blood-river":
          weapon_file = new("/u/o/onion/obj/4-1");
          break;
        case "red-sleeve":
          weapon_file = new("/u/o/onion/obj/4-2");
          break;
        case "should-not":
          weapon_file = new("/u/o/onion/obj/4-3");
          break;
        case "stay":
          weapon_file = new("/u/o/onion/obj/4-4");
          break;
      }
      if (what_weapon != 0) {
        if (what_weapon == str)
          if (!present(what_weapon, me)) {
            write("大管家说道：你将武器遗失了吧,前几天有人将这把" + str + "送回," +
              "希望你不要再掉了。\n", me);
            message_vision(sprintf("大管家给$N一把" + str + "。\n"), me);
            weapon_file->move(me);
            return 1;
          }
        command("whisper " + me->query("id") + " 哇勒..为师已经给过你一把了," +
          "你还想来骗人!!");
        command("kick " + me->query("id"));
        return 1;
      }
      weapon_file->move(me);
      write("大管家说道：这把武器就赠与你了,望你好好保存,方不辱我一番心意。\n", me);
      message_vision(sprintf("大管家给了$N一把" + str + "。\n"), me);
      me->set("marks/get_weapon", str);
      call_out("change_nickname", 2);
      return 1;
    } else
      write("[32m大管家说道：你在开玩笑吗?哪有这种武器!你到底是要[31m(blood-river)\n" +
        "(red-sleeve) (should-not) (stay) 32m的那一把?[0m\n", me);
  } else
    say("大管家满脸莫名其妙的说 : " + RANK_D->query_respect(me) +
      " 我又不是奶妈,跟我说有什么用呢?\n");
  return 1;
}

void change_nickname() {
  say("大管家说道：从今起你便是大理段家的一份子了，所作所为须已武林正道" +
    "为则。再者，你想要以什么名号(nickname)闯荡江湖呢？\n");
}

int do_nickname(string str) {
  object me = this_player();
  if (me->query("family/family_name") == "大理段家") {
    if (str == 0)
      write("大管家对你说道：你到底要什么名号呢？\n", me);
    else {
      command("pat " + me->query("id"));
      write("大管家对你说道：从今天起，你便是大理段家之「" + str + "”。\n", me);
      me->set("nickname", str);
    }
    return 1;
  } else
    return 0;
}

void attempt_apprentice(object me) {
  if (me->query_temp("realname") == 2) {
    write("很好，" + RANK_D->query_respect(me) + "多加努力，" +
      "他日必定有成。\n");
    command("recruit " + me->query("id"));
    me->set("nickname", "段");
    write(
      "\n段风吹慎重的对你说道:段家自古传下了四把神兵利器,分别是\n" +
      "‘血河’(blood-river)‘红袖’(red-sleeve)‘不应’(should-not)‘挽留’(stay),\n" +
      "由于这四把神器委实太过霸道,早在五百年前便为一位天外奇人将其神力封住,故如今这\n" +
      "把武器徒留形态,神秘的霸气一直被压抑住了....\n\n" +
      "今日你我师徒一场,就让为师送你一把吧...你需要(need)那一吧呢?\n\n");
    me->delete_temp("realname");
    me->set("class", "fighter");
  } else {
    command("shake");
    message_vision(sprintf("大管家和蔼的对$N说道：" + RANK_D->query_respect(me) +
      "，你连我的名字(name)都不知道，怎么就想要拜我为师了，我说啊，你还是另谋良师吧。\n"),
      me);
  }
}

void do_name_0() {
  object me = this_player();
  me->set_temp("realname", 1);
  command("whisper " + me->query("id") + " 啊!!" + RANK_D->query_respect(me) +
    ",你怎么会知道我是段家的人,这件事你千万不可说出去.");
}

string do_name_1() {
  object me = this_player();
  if ((int)me->query_temp("realname") >= 1) {
    me->set_temp("realname", 2);
    command("whisper " + me->query("id") + " 老实告诉你吧!其实老夫便是段家" +
      "嫡传第八代弟子--段风吹." + RANK_D->query_respect(me) +
      "想要拜我为师吗?");
  }
  return "我只是一个小小的管家," + RANK_D->query_respect(me) + "你又何必知道我呢?";

}

int receive_damage(string type, int pts) {
  int damage;
  object ob = this_object();
  damage = ::receive_damage(type, pts);
  if (damage > 0 &&
    (int)ob->query_temp("enable_unarmed") != 1) {
    ob->set_temp("enable_unarmed", 1);
    say("[1;33m大管家喝道：来的好，让你尝尝段家绝学‘六脉神剑’的厉害！[0m\n");
    //	  map_skill("unarmed","six-fingers");	
    setup();
  }
  return damage;
}

void defeated_enemy(object ob) {
  say("[31m大管家微一躬身说道：承让，承让。[0m\n");
  //	map_skill("unarmed","none");
  setup();
  remove_killer(ob);
}
