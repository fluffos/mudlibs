// vendor.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("路边摊小贩", ({ "vendor" }) );
	set("gender", "男性" );
	set("age", 25);
	set("long",
		"这位小贩正大声地吆喝着，还不时敲着挂在旁边的铜锣。\n");
	set("combat_exp", 5);
	set("attitude", "friendly");
        set("rank_info/respect", "小哥");
        set("vendor_goods", ([
		"匕首": "/obj/example/dagger",
		"酒": "/obj/example/wineskin",
		"包子": "/obj/example/dumpling",
		"鸡腿": "/obj/example/chicken_leg",
		"sword":"/u/o/onion/obj/mysword",
		"cloth":"/u/o/onion/obj/mycloth",
	]) );
	setup();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
			say( "小贩笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，来看看吧。\n");
			break;
		case 1:
			say( "小贩用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
				+ "，请来请来。\n");
			break;
		case 2:
			say( "小贩说道：这位" + RANK_D->query_respect(ob)
				+ "，进来喝几盅小酒吧，这几天才从窖子里开封的哟。\n");
			break;
	}
}
