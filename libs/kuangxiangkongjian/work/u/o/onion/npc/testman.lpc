inherit NPC;

string gone();
void create()
{
	set_name("婢女", ({ "squire" }) );
	set("age", 12);
	set("long", "年龄为15岁左右的小女孩,她是赵淑媛身边的贴身婢女.\n");
	set("gender","女性");
        set( "inquiry", ([
        "花园" : (: gone :),
        ]));
	setup();
	add_money("silver",10);
}

string gone()
{
	call_out("killme", 0);
	return "一起去花园玩啊..好啊..谢谢通知我。\n"+
		"那小姐就麻烦你照顾一下了,不要让不相关的人打扰我们小姐呦..";
}	

void killme()
{
	say ("[32m小兰一溜烟的跑走了!![0m \n");
	write("hmm\n");
	write("ob\n",this_object());
	write("me\n",this_player());
	destruct(this_object());
}

