inherit NPC;

void create()
{
	set_name("贴身护院 王一", ({ "guard wang","guard","wang" }) );
	set("race", "人类");
	set("gender", "男性");
	set("age", 30);
	set("long","赵晓龙身边的护院,保护他的生命,武功\相当精湛...\n");
	set("cps", 30);
	set("str", 28);
	set("cor", 20);
	set("kar", 20);
	set("spi", 25);
	set("bellicosity", 100);
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
        query("name")+"说道 : 公子请放心,这家伙交给我就好了。\n",
	 }) );
		
       	set_temp("apply/attack", 100);
	set_skill("dodge",50);
	set_skill("parry",50);
	set_skill("unarmed",70);
	set("combat_exp",400);
	setup();
        add_money("silver",1);
}

void init()
{
	object ob;
	::init();
	if(interactive(ob = this_player()))
	{
	remove_call_out("greeting");
	call_out("greeting",1,ob);
	}
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) 
	return;
	say(this_object()->query("name")+"大喊： 快保护公子!!\n");
}

void invocation(object who)
{
        int i;
        object *enemy;
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) 
        {
		if( enemy[i] && living(enemy[i]) ) 
                {
               	kill_ob(enemy[i]);
		if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
		else enemy[i]->kill_ob(this_object());
		}
	}	
}	       

int heal_up()
{
        if( environment() && !is_fighting() )
        {
        call_out("leave", 1);
        return 1;
        }
        return ::heal_up() + 1;
}

void leave()
{
	if(present ("long-sau", environment(this_object())))
	tell_room(environment(this_object()),query("name")+"道：既然公子无事,属下先行告退。\n");
        else
        tell_room(environment(this_object()),query("name")+"黯然说道：公子待我恩重如山,"+
        "属下必定将那凶手的头拿来以祭公子在天之灵。\n\n[1;31m保镖纵身一跳,"+
        "飞出窗口之外。[0m\n");
	destruct(this_object());
}
