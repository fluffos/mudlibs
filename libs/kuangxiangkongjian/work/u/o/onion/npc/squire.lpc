inherit NPC;

string gone();
void create()
{
	set_name("婢女", ({ "squire" }) );
	set("age", 12);
	set("long", "年龄为15岁左右的小女孩,她是赵淑媛身边的贴身婢女.\n");
	set("gender","女性");
	set_skill("dodge", 50);
	set_skill("parry", 30);
	set_skill("unarmed", 50);
//	set_skill("stormdance",30);
//	set_skill("liau-tan",30);
//	map_skill("dodge","stormdance");
//	map_skill("unarmed","liau-tan");
	set("max_kee",250);
	set("combat_exp",1);
	set("chat_change_combat",15);
        set("chat_msg_combat", ({
        "小兰娇叱一声：别想打扰我家小姐..\n",
        }));	
        set( "inquiry", ([
	"name" : "婢女叫小兰,是咱家小姐的贴身丫嬛。",
        "boy" : "小狄啊..他叫你来说什么吗?",
        "lady" : "小姐自从上次打猎回来后就怪怪的了..。",
        "花园" : (: gone :),
        ]));
	setup();
	add_money("silver",10);
}

string gone()
{
	object me=this_player();
	if(me->query_temp("play")>=1)
	{
	me->set_temp("play",2);
	call_out("killme", 0);
	return "一起去花园玩啊..好啊..谢谢"+RANK_D->query_respect(me)+"通知我。\n"+
		"那小姐就麻烦你照顾一下了,不要让不相关的人打扰我们小姐呦..";
	}
	else
	return "花园是小姐最喜欢的地方,可是小姐她现在足不出户,连花园都不去了..";
}	

void killme()
{
	say ("[32m小兰一溜烟的跑走了!![0m \n");
	destruct(this_object());
}

