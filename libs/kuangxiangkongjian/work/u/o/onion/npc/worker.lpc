inherit NPC;

void create()
{
	set_name("老长工", ({ "old worker","worker" }) );
	set("race", "人类");
	set("age", 60);
	set("gender", "男性");
	set("long",
"老长工已经在镖局里做了数十年了,脸上留着长长的白胡子,是镖局内最长的人了。\n"+
"你或许可以跟他问一些事。\n"
            );
        set( "inquiry", ([
             "name" : "小的名叫长福,自小的时候就在这儿做事了,不是我自夸,"+
             	      "镖局里上上下下,\n大大小小,每个人的事我都知道..",
             "steward" : "大管家好像是从大理来的,在他初来时似乎有说过他姓段,\n"+
             		 "你可以问他「段家”的事看看...",
             "大管家" : "大管家好像是从大理来的,在他初来时似乎有说过他姓段,\n"+
                         "你可以问他「段家”的事看看...",
             "cooker" : "大厨师是镳局瓢把子 赵鼎天的好友,但他却喜欢在这里\n"+
             		"只做一个厨子,真是令我好生不解...",
	     "大厨师" : "大厨师是镳局瓢把子 赵鼎天的好友,但他却喜欢在这里\n"+
	                "只做一个厨子,真是令我好生不解...",
             "赵淑媛" : "小姐啊..自从上个月后镳头全家到蜀中东郊打猎后回来,\n"+
             " 小姐就闷闷不乐的自己一个人躲在房间里,连她最喜爱的花园都没去了..",
	     "赵晓龙" : "公子可真是一位青年才俊啊,才二十出头,便颇有名声,\n"+
	     		  "老爷子可乐了...",
	"赵鼎天" : "老爷是镖局里的支柱,整间镖局可说是在老爷手里才兴盛壮大的...",
             		]));
	set("str",22);             
	set("chat_chance", 10);
 	set("chat_msg", ({
	"老长工说 : 下次小心的啊。\n",
	"老长工说 : 大管家可是很严格的人喔...\n",
	 }) );

        set("attitude", "peaceful");
	set_temp("apply/attack", 17);
	set("combat_exp",200);
	setup();
        add_money("silver",1);
        
}

