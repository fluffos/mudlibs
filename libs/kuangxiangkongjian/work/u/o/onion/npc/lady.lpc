inherit NPC;

void create()
{
	set_name("赵淑媛", ({ "lady sau","sau","lady" }) );
	set("race", "人类");
	set("age", 17);
	set("gender", "女性");
	set("long",
"赵淑媛是赵鼎天最疼爱的小女儿,她正直豆蔻年华的十七岁,面容清秀,长的婷婷玉立,\n"+
"惹人怜爱,但是她现在却郁郁寡欢,脸上没有一点笑容,令人心疼.\n"
            );
	set("chat_chance", 10);
 	set("chat_msg", ({
	(: command("sigh") :),
	(: command("think") :),
	 }) );
        set( "inquiry", ([
	"name" : "我乃赵鼎天的女儿,赵淑媛.",
	"打猎" : "啊..那次...唉...",
        		]));
        set("attitude", "peaceful");
	set_temp("apply/attack", 20);
	set("combat_exp",1);
	setup();
        add_money("gold",300);
        
}

