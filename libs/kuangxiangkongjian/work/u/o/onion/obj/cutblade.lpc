// blade.c

#include <weapon.h>

inherit BLADE;

void create()
{
	set_name("乌钢菜刀", ({ "cut blade","blade" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 500);
		set("material", "iron");
		set("long", "这是一把切菜切肉都很顺手的菜刀，份量大约三、四斤重。\n");
		set("wield_msg", "$N将一把明晃晃的$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入腰间。\n");
	}
	init_blade(10);
	setup();
}
