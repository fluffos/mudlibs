// hat.c
#include <armor.h>
inherit EQUIP;

void create()
{
        set_name("鸳鸯花□冠",({"flower hat","hat"}) );
	set_weight(1000);
	set("armor_type","head");
        if( clonep() )
          set_default_object(__FILE__);
        else 
        {
          set("unit","顶");
          set("long","这是一顶鸳鸯花□冠, 嵌饰华美, 冠首中央一只云里翔凤, 口衔珠串"+
          	     ", 冠前左右个垂饰点翠扇翅叶, 另外还有南海采置的珍珠, 点缀的"+
          	     "玲珑婀娜, 而又富丽轻巧。\n");
	  set("value",1000);
	  set("material","leather");
	  set("armor_prop/armor",5);
        }
        setup();
}
