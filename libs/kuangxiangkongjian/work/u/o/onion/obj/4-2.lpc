#include <weapon.h>
inherit BLADE;
void create()
{
set_name("[1m宝刀[1;35m‘红袖’[0m",({"red-sleeve blade","red-sleeve","blade"}));
	set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit","把");
      		set("long",
"\n[1;35m‘红袖’[0m，刀锋是透明的，刀身绯红，像透明的玻璃镶裹着绯红色的骨脊，刀略短，刀弯处如绝代佳人的纤腰，让人一见钟情，一见难忘。\n");
                set("value", 40000);
                set("material","blacksteel");
  		set("wield_msg",
"\n$N手上忽然多了一把$n，刀光漾映一片水红，刀挥动时还带着一种像音籁般的清吟，还掠起微微的香气。\n\n");
		set("unwield_msg",
"\n$N的$n像一抹夕晖，像一场细雨，忽然自手上消失无踪。\n\n");
        }
	set("no_drop",1);
	set("light",1);
        init_blade(1);
        setup();
}
int query_autoload()
{
        if(this_player()->query("family/family_name")=="大理段家")
        return 1;
	return 0;
}
      