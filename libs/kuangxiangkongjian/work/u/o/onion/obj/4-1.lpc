#include <weapon.h>
inherit SWORD;
void create()
{
set_name("[1m神剑[1;31m‘血河’[0m",({"blood-river sword","blood-river","sword"}));
	set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit","把");
		set("long",
"\n[1;31m‘血河’[0m，剑身凹凸不平，剑锋其钝无比，剑脊弯曲，剑尖歪斜，如果说有出色之处，便是这把剑隐隐透出红光。\n");
                set("value", 40000);
                set("material","blacksteel");
	  	set("wield_msg",
"\n$N缓缓的拔出$n，剑作龙吟，清脆悦耳。一种乍看令人心动,细看足以让人心血贲动的红光，自剑身透了出来。\n\n");
		set("unwield_msg",
"\n$N将$n收入厚套古鞘之内，霎那间有如太阳西下般，满地红光但然消失。\n只见剑鞘却隐然透漾着血红，一如人体里的血脉一般流动。\n\n");
	      }
	set("no_drop",1);
	set("light",1);
        init_sword(1);
        setup();
}

int query_autoload()
{
	if(this_player()->query("family/family_name")=="大理段家")
	return 1;
	return 0;
}