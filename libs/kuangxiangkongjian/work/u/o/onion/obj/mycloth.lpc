// icy_cloth.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
set_name("[1;36m‘[1;33m七宝金幢[1;36m’[0m", ({ "golden cloth","cloth"}));
        set_weight(100);
	set("long","[1;36m‘[1;33m七宝金幢[1;36m’[0m"+
	"本为佛门异宝,精芒宝气笼罩,为修道人梦寐以求的护身神光.\n");
	set("wear_msg","一座金霞万道彩焰千重,通体祥辉闪闪,七色七层的"+
	"[1;33m金幢[0m宝相,忽自$N身后飞起,\n射出一片极强耀眼的精芒光气,"+
	"再似一口钟般笼罩下去.\n");
	set("unequip_meg","$N将[1;33m金幢[0m收缩,金光忽隐,不见有丝毫痕迹.\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("value", 1);
                set("material", "crimsonsteel");
                set("armor_prop/armor", 20000);
        }
        setup();
}
