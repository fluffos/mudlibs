//whip.c

#include <weapon.h>

inherit WHIP;

int special_att();
void create()
{
        object me=this_player();
	set_name("金蛟鞭", ({"golden whip", "whip", "golden"}) );
        set_weight(200);
	if( clonep() )
	 set_default_object(__FILE__);
	else
	 {
	  set("unit", "把");
	  set("long","这是一把金光闪闪的长鞭,相传是用蛟龙的筋浸百宝,经七七四十九天而成\n");
	  set("value", 2400);
	  set("material", "blacksteel");
	  set("wield_msg", "$N长啸一声,从腰间抖出一把金光闪闪的$n.\n");
	  set("unwield_msg", "$N将手中的$n还收入腰间的鞭鞘中.\n");
	 }
	init_whip(70);
	me->set("chat_chance_combat",100);
	me->set("chat_msg_combat", ({
	(: me,"special_att" :),
	}));       
	setup();
}

int special_att()
{
	object me=this_player(),*enemy=me->query_enemy();
	int i=sizeof(enemy);
	tell_room(environment(me),"金蛟鞭隐隐泛出金光...\n");
	while(i--)
	 {
	  if( enemy[i] && living(enemy[i]) )
	   { 
	    tell_object(enemy[i],"金蛟鞭发出闪闪金光,遮住了你的视线!!\n");
 	    enemy[i]->start_busy(3);
 	   } 
	 }
}	
