#include <weapon.h>
inherit SWORD;
void create()
{
set_name("[1m奇剑[1;33m‘挽留’[0m",({"stay sword","stay","sword"}));
      set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit","把");
	 	set("long",
"\n[1;33m‘挽留’[0m，整把剑身是直的，只有剑的把手是弯的，弯如半月，令人怀疑要如何持剑。上头刻着\n"+
"		 [36m「挽留天涯挽留人,挽留岁月挽留你”。[0m\n");
                set("value", 40000);
                set("material","blacksteel");
 		set("wield_msg",
"\n$N突然拔出$n，只觉得又快、又奇、又绝，三分惊艳，三分潇洒，三分惆怅，加上一分的不可一世。\n\n");
		set("unwield_msg",
"$N将$n收起，只觉得忽然之间若有所失。\n\n");
        }
	set("no_drop",1);
	set("light",1);
        init_sword(1);
        setup();
}
int query_autoload()
{
        if(this_player()->query("family/family_name")=="大理段家")
        return 1;
	return 0;
}
      