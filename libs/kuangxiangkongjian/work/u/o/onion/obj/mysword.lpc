#include <weapon.h>
  inherit SWORD;
void create()
{
set_name("[1;32m‘[1;33m诛葱[1;32m’[0m",({"kill_onion","sword"}));
      set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("unit","把");
      set("long", "\n整把剑呈现珠黄色,隐隐透出金光,剑身还不停的抖动着...\n") ;
                set("value", 400);
                 set("material","crimsonsteel");
set("wield_msg","\n$N伸手一张,[1;32m‘[1;33m诛葱[1;32m’[0m脱鞘而出,"+
		"有如一道金虹般平稳的飞到$N的手中。\n");

set("unwield_msg","$N将[1;32m‘[1;33m诛葱[1;32m’[0m往上一抛,口中念念有词,"+
		  "嗖的一声,整道金虹隐没在身后。\n");
        }
                init_sword(20000);
        setup();
}
