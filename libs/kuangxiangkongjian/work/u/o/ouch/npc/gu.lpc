        }
	if( ob->query("class")=="poisoner")
        {
        command("say 哼 ! 魔教徒 , 我宰了你 !");
        kill_ob(ob);
     }
	if( ob->query("class")=="killer")
     {
     command("say 老子生平最痛恨的就是你这种杀手 !");
     kill_ob(ob);
     }
if(!ob->query("family/family_name")&&ob->query("class")=="blademan")
     {
	if(!ob->query_temp("allow-enter")&&!ob->query_temp("have-nod"))
	{
command("say 喔 ,这位"+RANK_D->query_respect(ob)+", 你是来拜师的吗 ?");
     ob->set_temp("can-nod",1);
	}
     }
}

    int do_nod()
    {
    object ob;
    ob=this_player();
    if(!ob->query_temp("can-nod"))
	return 0;
	ob->delete_temp("can-nod");
	ob->set_temp("have-nod",1);
    call_out("do_act1",1,ob);
    }
  int do_act1(object ob)
  {
  command("say 我进去通报一下 , 请稍候 !");
  call_out("do_act2",1,ob);
  }
    int do_act2(object ob)
	{
	say("金刀武士往门内走去\n");
     call_out("do_act3",8,ob);
     }
    int do_act3(object ob)
   {
  object guard;
  guard=new("/open/gblade/npc/guard2");
    guard->move("/open/gblade/room/g1-1");
   say("刷刷刷脚步轻响 , 金刀武士走了回来!\n");
     call_out("do_act4",1,ob);
    }
    int do_act4(object ob)
  {
    command("say 王老爷今天心情很好 ,请进吧 !");
    ob->set_temp("allow-enter",1);
	ob->delete_temp("have-nod");
    }
