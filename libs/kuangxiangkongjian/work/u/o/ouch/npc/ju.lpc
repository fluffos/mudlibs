// judge.c

#include <login.h>
#include <ansi.h>

inherit NPC;

int in_ask, answer;

void create()
{
  set_name("审判官", ({ "judge" }) );
  set("short", "专门对付机器人的" HIY "审判官" NOR "(judge)" );
  set("long",
    "这是一位审查玩家是否是机器人的审判官，你必须答对(answer)他三个问题才能\n"
    "脱离他的掌握。\n");

  set("gender", "男性");
  set("age", 40);

  set("str", 100);
  set("int", 100);
  set("cor", 100);

  set("no_kill",1);

  setup();

  in_ask = 0;
}

void init()
{
  ::init();
  if( !query_heart_beat(this_object()) ) set_heart_beat(1);
  add_action("do_answer", "answer");
  //add_action("do_quit", "quit");
  this_player()->set_temp("wrong_no", 0);
  this_player()->set_temp("robot_check", 0);
}

void chat()
{
  object  *badguy;
  int a, b, c;
  string oper;
  
  if( in_ask || random(20) > 10 ) return;
  badguy = all_inventory(environment());
  for (a=0; a<sizeof(badguy); a++)
    if (userp(badguy[a]))
	badguy[a]->delete_temp("ans_wrong");
  a = random(100) + 1;
  b = random(100) + 1;
  switch(random(6)) {
    case 0: 
	answer = a + b;
	oper = chinese_number(a) + "加上" + chinese_number(b)+ "等于多少？";
	break;
    case 1: 
	answer = a - b;
	oper = chinese_number(a) + "减去" + chinese_number(b)+ "等于多少？";
	break;
    case 2: 
	if( a * b < 200 ) {
	  answer = a * b;
	  oper = chinese_number(a) + "乘上" + chinese_number(b)+ "等于多少？";
	} else {
	  answer = (a * b) % 10;
	  oper = chinese_number(a)+"乘上"+chinese_number(b)+ "，个位数等于多少？";
	}
	break;
    case 3: 
	answer = a % b;
	oper = chinese_number(a) + "除以" + chinese_number(b)+ "余于多少？";
	break;
    case 4:
	oper = chinese_number(a) +"和"+ chinese_number(b)+ "的最大公因数是多少？";
	if( b < a ) { c = b; b = a; a = c; }
	while( a > 1 && b%a > 1 ) {
	  c = a;
	  a = b%a;
	  b = c;
	}
	answer = b%a == 1 ? 1 : a;
	break;
    case 5:
	oper = chinese_number(a) + "与" + chinese_number(b)+ "哪一个数比较大? ";
	answer = a>b?a:b;
	break;
  }
  command("say " + oper + "，请在二十秒内作答(answer)。");
  in_ask = 1;
  call_out("say_answer", 20);
}

void say_answer()
{
  object  *badguy;
  int  i, n;

  in_ask = 0;
  badguy = all_inventory(environment());
  n = sizeof(badguy);
  for (i=0; i<n; i++)
    if (userp(badguy[i])) {
	badguy[i]->add_temp("no_answer", 1);
	if (badguy[i]->query_temp("no_answer") > 5) {
	  tell_object(badguy[i],
	"问半天你竟敢不理我, 只好送你归西了。\n");
	  badguy[i]->die();
	}
	else {
	  tell_object(badguy[i],
	"这么简单都不会？答案等于"+chinese_number(answer)+"。\n"+
	"这是你第 "+badguy[i]->query_temp("no_answer")+
	" 次没回答了。\n");
	}
    }
}

int do_answer(string arg)
{
  object  who;
  string  s, myid;
  int  ans;

  seteuid(getuid());
  if( !in_ask ) return notify_fail("你必须等下一题。\n");
  if( !arg ) return notify_fail("请你回答一个适当的答案。\n");

  who = this_player();
  myid = who->query("id");
  who->set_temp("no_answer",0);
  message_vision( CYN "$N答道：" + arg + "\n" NOR, who);
  
  if( sscanf(arg, "%d", ans)==1 ) {
    if( ans==answer ) {
	if (!who->query_temp("ans_wrong")) {
	  who->delete_temp("ans_wrong");
	  who->add_temp("wrong_no", -1);
	}
	who->add_temp("robot_check", 1);
	command("say 答对了！这是你答对的第 "+
	  who->query_temp("robot_check")+" 题。\n");
	command("pat " + who->query("id") );
    command("pat " + who->query("id") );
    command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
  command("pat " + who->query("id") );
	remove_call_out("say_answer");
	in_ask = 0;
	if( who->query_temp("robot_check") >= 3 ) {
	  command("say 很好，你看起来不像机器人，你可以走了。\n");
	  if( stringp(s = who->query_temp("old_startroom")) )
	    who->set("startroom", s);
	  who->delete_temp("robot_check");
	  if( stringp(s = who->query_temp("old_location")) )
	    who->move(s);
	  else
	    who->move(STARTROOM);
	  who->save();
	}
    } else {
	command("say 错！");
	if (!who->query_temp("ans_wrong")) {
	  who->add_temp("wrong_no", 1);
	  who->set_temp("ans_wrong",1);
	  command("say 你已经错 "+
	    who->query_temp("wrong_no")+" 题了。");
	}
	if( who->query_temp("wrong_no") >= 10 ) {
	  command("say " + who->name() + "你再给我乱猜啊，去死吧。\n");
	  who->die();
	}
    }
  }
  return 1;
}

int do_quit(string arg)
{
  write ("想跑? 门儿都没有!!\n");
  return 1;
}
