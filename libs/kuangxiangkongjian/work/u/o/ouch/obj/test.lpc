// dumpling.c

inherit ITEM;
inherit "/u/o/ouch/obj/food.lpc";

void create()
{
        set_name("吃到死的包子", ({ "dumpling" }) );
        set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个香喷喷、热腾腾的大包子。\n");
		set("unit", "个");
		set("value", 15);
		set("food_supply", 60);
	}
}
