int do_drink(string arg) {
  object me;
  int max_water;

  me = this_player();
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  max_water = (int)me->max_water_capacity();
  if ((int)me->query("water") >= max_water)
    return notify_fail("你已经喝太多了，再也灌不下一滴水了。\n");

  add("liquid/remaining", -1);
  message_vision("$N拿起" + name() + "咕噜噜地喝了几口" + query("liquid/name")
    + "。\n", me);
  me->add("water", 30);
  if ((int)me->query("water") >= max_water)
    me->set("water", max_water);
  if (me->is_fighting()) me->start_busy(2);
  if (!query("liquid/remaining"))
    write("你已经将" + name() + "里的" + query("liquid/name")
      + "喝得一滴也不剩了。\n");

  if (this_object()->query("get_poison")) {
    tell_object(me, "糟了 ! 水里有毒 !\n");
    me->apply_condition(this_object()->query("get_poison"), this_object()->query("poison_power"));
  }
  // This allows customization of drinking effect.
  if (query("liquid/drink_func")) return 1;

  switch (query("liquid/type")) {
    case "alcohol":
      me->apply_condition("drunk",
        (int)me->query_condition("drunk")
        +(int)query("liquid/drunk_apply"));
      break;
  }

  return 1;
}

int do_fill(string arg) {
  if (!this_object()->id(arg)) return 0;
  if (this_player()->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!environment(this_player())->query("resource/water"))
    return notify_fail("这里没有地方可以装水。\n");

  if (environment(this_player())->query("have_poison") == 1) {
    this_object()->set("get_poison", environment(this_player())->query("poison_type"));
    this_object()->set("poison_power", environment(this_player())->query("poison_power"));
  }
  if (query("liquid/remaining"))
    message_vision("$N将" + name() + "里剩下的" + query("liquid/name") + "倒掉。\n", this_player());
  message_vision("$N将" + name() + "装满清水。\n", this_player());

  if (this_player()->is_fighting()) this_player()->start_busy(2);

  set("liquid/type", "water");
  set("liquid/name", "清水");
  set("liquid/remaining", query("max_liquid"));
  set("liquid/drink_func", 0);

  return 1;
}
