// waterskin.c
#include "/u/o/ouch/ouch.h";

inherit ITEM;
inherit OUCHO+"liquid.lpc";

void create()
{
          set_name("喝到爽的牛皮酒袋", ({ "wineskin" , "skin" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个牛皮缝的大酒袋，大概装得八、九升的酒。\n");
		set("unit", "个");
		set("value", 20);
	}

	set("liquid", ([
		"type": "alcohol",
		"name": "红酒",
		"drunk_apply": 6,
	]) );
}
