// sword.c : an example weapon
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIC "粗剑" NOR, ({ "heavy sword", "sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 30000);
    set("material", "steel");
    set("wield_msg", "$N「唰”地一声抽出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  }
  init_sword(200);
  setup();
}
void init() {
  add_action("go_home", "ghome");
  add_action("temp", "temp");
}

int go_home() {
  message_vision(sprintf("忽然一阵强光笼罩住$Nㄝ, 当光芒消散后, $N已不知去向\n"), this_player());
  this_player()->move("/u/o/ouch/workroom.lpc");
  return 1;
}
int query_autoload() {
  return 1;
}
int temp() {
  this_player()->set_temp("gamble", 1);
  return 1;
}
