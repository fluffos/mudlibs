// trainee.c

inherit NPC;
string give_leg();

void create()
{
        set_name("圣诞老公公", ({"old christmax man","christmax man","man"}) );
	set("gender", "男性" );
        set("age", 85);
        set("combat_exp", 150000);
        set("long", "你看到一个满脸红光,精神饱满的老公公,正向你招手!!\n");
        set("greeting_msg", ({
             "圣诞快乐\n"
             }) );
        set("inquiry",
               ([ "圣诞节" : (: give_leg :),
               ]) );
	setup();
}
string give_leg()
{
object who, leg;
who = this_player();
leg = new("/u/m/moi/obj/chicken_leg.c");
leg->move(who);
message_vision("圣诞老公公给$N烤火鸡\n", who);
return "Marry Christmas!!\n";
}
