inherit ITEM;
inherit F_FOOD;

void create()
{
      set_name("烤火鸡", ({ "fried chicken", "chicken" }) );
	set_weight(350);
        set("long", "一只烤得香喷喷的火鸡, 不要犹豫了, 咬吧!!\n");
        set("unit", "只");
        set("value", 0);
        set("food_remaining", 5);
        set("food_supply", 100);
	set("material", "bone");
	setup();
}

int finish_eat()
{
	destruct(this_object());
	return 1;
}
