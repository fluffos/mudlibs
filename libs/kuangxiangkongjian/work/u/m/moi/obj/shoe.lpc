// shoe.c

inherit EQUIP;

void create()
{
	set_name("七星翻云靴", ({ "cloudy shoes", "shoes" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
		set("value", 600);
		set("material", "cloth");
		set("armor_type", "feet");
		set("armor_prop/armor", 2);
		set("armor_prop/dodge", 4);
	}
	setup();
}
	
int query_autoload()
{	
	if(this_player()->query("class") == "taoist" )
	return 1;
	else
	return 0;	
}

int wear()
{
	if(this_player()->query("class") != "taoist" )
	return notify_fail("这是道士专用的装备。\n");
	else
	return ::wear();
}	