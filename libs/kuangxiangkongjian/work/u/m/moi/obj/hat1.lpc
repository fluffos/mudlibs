// hat.c

inherit EQUIP;

void create()
{
        set_name("道冠",({"hat"}));
        set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "顶");
		set("value", 100);
		set("material", "cloth");
		set("armor_type", "head");
                    set("armor_prop/armor", 3);
                   set("armor_prop/magic", 2);
	}
	setup();
}

int query_autoload()
{
	if(this_player()->query("class") == "taoist" )
	return 1;	
	else
	return 0;
}
	
int wear()
{
	if(this_player()->query("class") != "taoist")
	return notify_fail("这是道士们穿戴的装备。\n");
	else
	return ::wear();
}	
