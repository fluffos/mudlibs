// made by ccat
inherit COMBINED_ITEM;
void create()
{
        set_name("37=,$&", ({"force pill","pill"}) );
        set("long",
"&9*+$D8>$$1N-x&[$Q$s543;1D(S$'/+CD,%i%H666!+l4_$:$O.\n"+
"&9-n678gCD.v=U0t(check item),$h1o-9%N(eat pill).\n");
        set("unit", "20");
        set("base_unit", "2I");
        set("no_sell",1);
        set("value",2500);
        set("base_weight", 50);
        set_amount(1);
        setup();
}

void init()
{
        if( this_player()==environment() )
        {
                add_action("eat_pill", "eat");
        }
}

int eat_pill(string arg)
{

        object ob,me=this_player();
        int max_force,force;
        if( !arg )                      return 0;
        arg=lower_case(arg);
        if( !ob = present(arg,me) )     return 0;
        if( ob != this_object() )       return 0;
        message_vision("$N&Y$U$@2I37=,$&.\n", me);
        max_force = me->query("max_force");
        force = me->query("force");
//      if( force < max_force)
          me->set_skill("haoforce",87);
          me->set_skill("force",100);
        add_amount(-1);
        return 1;
}
