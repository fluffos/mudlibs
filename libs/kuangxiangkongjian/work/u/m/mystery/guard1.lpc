//藏神秘跟班 made in mystery


inherit NPC;


void create()
{
	set_name("藏神秘跟班",({"follow-man","man"}));
	set("gender","男性");
	set("age",20);
	set("class","blademan");
	set("str",99);
        set("long","藏神秘的跟班专门砍人。\n");
         set("combat_exp",1000000);
        set("force",10000);
        set("max_force",10000);
	set("force_factor",10);
 set_skill("blade",200);
	set_skill("parry",999);
	set_skill("dodge",999);
	set_skill("gold-blade",999);
	set_skill("fly-steps",999);
	set_skill("sixforce",999);
 	map_skill("blade","gold-blade");
	map_skill("parry","gold-blade");
	map_skill("dodge","fly-steps");
	map_skill("move","fly-steps");
	map_skill("force","sixforce");
	setup();
         carry_object("/u/c/cch/obj/gingi-blade.lpc")->wield();
}


void init()

{
  object ob;
  ob=this_player();
	if( ob->query("id")=="mystery")
	{
        command("smile "+ob->query("id"));
        }
	if( ob->query("id")!="mystery")
        {
        command("say 看到老大不会叫啊 , 我宰了你 !");
        kill_ob(ob);
     }
	if( ob->query("id")=="mystery")
     {
     command("say 大哥好 !");
     }
}

