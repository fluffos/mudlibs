#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
        seteuid(getuid());
        set_name( HIR "血蚕刃" NOR ,({"blood blade","blade"}));
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
set("unit","把");
set("long","刀上刻着词藏神秘三字。 \n");
    


set("value",0);
 set("material","gold");
       
        }
init_blade(999);
setup();

}
int wield()
{
if ((string)this_player()->query("id") != "mystery")
return notify_fail("藏神秘用的刀...你能碰吗^_^ \n");
     else {
           ::wield();
 set("wield msg","$N吸收藏神秘的生命化成一只血蚕。\n");
 set("unwield msg", "$N化成一团红色的气体进入体内。\n");
          }
     return 1;
}
