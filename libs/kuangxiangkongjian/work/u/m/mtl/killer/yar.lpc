//master_yar.c 作者:fund 修改: carol
#include <ansi.h>
#include "/open/open.h"
inherit NPC;
inherit F_MASTER;
#define SKILL_D(x)              ("/u/m/mtl/killer/"+x)
void create()
{
            object ob;
            set_name("叶孤城",({"master yar","yar"}));
            set("long","他是名震江湖的一代杀手，隐月盟的头目。\n");
            set("gender","男性");
            set("class","killer");
            set("nickname","杀眼无情");
            set("combat_exp",1100000);
            set("attitude","heroism");
            set("age",26);
            set("str", 44);
            set("cor", 30);
            set("cps", 28);
            set("per", 24);
            set("int", 22);
	set("kee",1000);
	set("max_kee",1000);
	set("gin",600);
	set("max_gin",600);
	set("atman",1300);
	set("max_atman",1300);
	set("mana",400);
	set("max_mana",400);
            set("force",1500);
            set("max_force",1500);
            set_skill("dodge",90);
            set_skill("force",90);
            set_skill("sword",70);
            set_skill("gdragon-steps",100);
set_skill("shadow-kill",80);
	map_skill("sword","shadow-kill");
	map_skill("dodge","gdragon-steps");
	set_skill("windforce",90);
	map_skill("force","windforce");
	set_temp("apply/armor",70);
	set("force_factor",10);
	setup();
	create_family("隐月盟",2,"主席");
	ob=carry_object("/open/snow/obj/hate_knife");
	ob->set_amount(50);
	carry_object("/obj/cloth.lpc")->wear();
        carry_object("/open/gsword/obj/heaven-sword.lpc")->wield();
}

void init()
{
	add_action("do_join","join");
}
  void attempt_apprentice(object ob)
{
	command("l "+ob->query("id"));
	if(this_player()->query("cor")<15)
        {
            command("sigh "+ob->query("id"));
            command("say 你的胆识不够,我不能收你为徒\n");
	command("shake");
            return;
        }
	command("smile");
	command("nod");
	command("chat 哈哈哈...我们杀手的成员又多了一名啦..大家小心点啦..\n");
	command("recruit "+ob->query("id"));
}
int accept_fight(object ob)
{
	command("say 你是真的要跟我挑战吗??\n");
	message_vision( this_object()->name()+"脸上一副鄙视的样子。\n",ob);
	return 1;
}
int accept_kill(object ob)
{
	command("say 没想到你真有勇气, 敢跟我挑战!!!\n");
	message_vision( this_object()->name()+"突然变脸，脸上出现杀气。\n",ob);
	this_object()->set("bellicosity",5000);
	command("cmd bellup");
	return 1;
}
int do_join()
{
	object ob=this_player();
	if(!ob->query("class"))
        {
	ob->set("class","killer");
	command("nod "+ob->query("id"));
        }
        else
        {
	command("say 道不同志不合，你去找别人吧。\n");
	return 1;
        }
	message("system",
	HIB "纷乱动荡的武林中～～\n\n又出现一名恐怖的杀手～～\n" NOR,users());
	return 1;
}
