#include <ansi.h>
#include <room.h>
inherit ROOM;

void create ()
{
  set ("short", "人间道");
  set ("long", @LONG

你现在来到一个气氛十分诡异的一个地方, 四周浓雾密布且掺杂着各种奇特
的味道. 你的眼前有着数条拉环, 且附有编号. 这似乎意味着拉(pull)拉环
可以将你送往人间.
在你的左侧有一个牌子(sigh).

LONG);
  set("item_desc", ([ /* sizeof() == 1 */
  "sign" : "
     	  1  :  通往仙剑派.
     	  2  :  通往雪苍派.
     	  3  :  通往金刀门.
     	  4  :  通往儒门.
     	  5  :  通往段王府.
     	  6  :  通往恶人谷.
     	  7  :  通往魔教.
     	  8  :  通往陇山派.
	  a  :  通往中央译站.
          b  :  通往蜀中城.
	  c  :  通往皇城.

"]));

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 1 */
     "up" : "/u/p/ppopp/popdoor",
]));
  setup();
}
void init()
{
 add_action("do_pull","pull");
}
int do_pull(string str)
{
  object me;
  me=this_player();
  if(str!="1")
   {
   if(str!="2")
    {
    if(str!="3")
     {
     if(str!="4")
      {
      if(str!="5")
       {
       if(str!="6")
        {
        if(str!="7")
         {
         if(str!="8")
          {
          if(str!="a")
           {
           if(str!="b")
            {
            if(str!="c")
             {
 write(CYN"你在拉啥啊??? 小傻蛋!!!\n"NOR);
   return 1;
             }
            else
             {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在皇城城中.\n"NOR); 
 me->move("/open/capital/room/r34");
   return 1;
             }
            }
           else 
            {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在蜀中城城中.\n"NOR); 
 me->move("/open/gsword/room/su3");
   return 1;
            }
           }
          else
           {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在中央驿站.\n"NOR); 
 me->move("/open/center/room/inn");
   return 1;
           }
          }
         else
          {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在陇山派正晴武馆里.\n"NOR); 
 me->move("/open/wu/room/school8");
   return 1;
          }
         }
        else
         {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在冥蛊魔殿上.\n"NOR); 
 me->move("/open/poison/room/room1");
   return 1;
         }
        }
       else
        {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在恶人谷的大厅里.\n"NOR); 
 me->move("/open/badman/room/g1");
   return 1;
        }
       }
      else
       {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在段王府大厅上.\n"NOR); 
 me->move("/open/ping/room/p1");
   return 1;
       }
      }
     else
      {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在九指书生的小草屋里.\n"NOR); 
 me->move("/open/start/room/small_house");
   return 1;
      }
     }
    else 
     {
 message_vision(HIC"你听到 喀 的一声,$N的身体迅速下滑,跌进了无底深渊.\n"NOR,me);
 write(CYN"幸好即时稳住身形重心,身躯缓缓地降落在金刀无敌王元霸的面前.\n"NOR); 
