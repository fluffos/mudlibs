#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "水月轩大门");
  set("long", @LONG

    水月轩, 镜月岛上美人儿姊妹中的姊姊 -- 月半弯小姐
居住的闺阁, 而北面正是水月轩的大门. 大门内传来阵阵的
琴音, 声声入耳, 扣人心弦, 使人不禁想要入内大饱耳福.

LONG);
  set("item_desc", ([ /* sizeof() == 1 */
    "door": "
这是一扇经花雕名师于长白山查寻多年雕刻而成的高级杉木门,
瞧!!! 其上的凤纹可是天然而成,不加任何修饰的喔!!!\n",
  ]));

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "prmw2",
    "south": "",
  ]));
  create_door("north", "花雕凤纹木门", "south", DOOR_CLOSED);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "enter" && present("gold-blade guard", environment(me))) {
    if (me->query("class") == "poisoner")
      return notify_fail("金刀武士怒喝 : 魔教徒休想进去一步\n");
    if (me->query("class") == "killer")
      return notify_fail("金刀武士说道 : 干什么 , 想进去杀人放火吗 ?\n");
    if (me->query("family/family_name") == "金刀门")
      return 1;
    if (!me->query_temp("allow-enter") && !me->query("quests/bochen_trouble"))
      return notify_fail("金刀武士拦住你的去路 ,说道 :你以为金刀门是什么地方 ? 任你来去自如 ?\n");
  }
  return 1;
}
