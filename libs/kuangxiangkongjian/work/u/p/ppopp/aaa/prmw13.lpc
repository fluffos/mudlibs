inherit ROOM;

void create ()
{
  set ("short", "钟楼");
  set ("long", @LONG

这是一间什么都没有的房间。
 
LONG);

  set("light_up", 1);
  set("no_transmit", 1);
  set("exits", ([ /* sizeof() == 1 */
     "up" : __DIR__"prmw17",
]));

  setup();
}
void init()
{
        add_action("do_turn", "turn");
}

int do_turn(string str)
{
        object me;
        me = this_player();
        if(!str || str != "key")
                return notify_fail("你想要做什么？\n");
        else if(!query_temp("have_turn"))
                {
                  message_vision("$N伸出手来, 转了转那墙上的突起物。\n",me);
                  tell_room(this_object(),"你发现南边的湖面开始晃动, 不久湖面上□B出一条小桥。\n");
                  set("exits/south",__DIR__"prmw12");
                  set_temp("have_turn",1);
                  remove_call_out("do_closed");
                  call_out("do_closed",20);
                  return 1;
                }
        else {
               remove_call_out("do_closed");
                delete_temp("have_turn");
                delete("exits/south");
                message_vision("$N伸出手来转了转那墙上的突起物, 那浮桥迅速沈入湖
里。\n",me);
             }
        return 1;
}
void do_closed()
{
        delete_temp("have_turn");
        delete("exits/south");
        tell_room(this_object(),"浮桥缓缓地沈入了湖里。\n");
}
