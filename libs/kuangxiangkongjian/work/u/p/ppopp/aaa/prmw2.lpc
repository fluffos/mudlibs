#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "前庭");
  set("long", @LONG

    这里是水月轩的前庭, 走道两旁种满了清幽的紫色茉莉
配合着由西边传出的琴音和箫声, 更加显得清新高雅. 抬头
向北方望去, 可看见不远处有座古色古香的阁楼.

LONG);
  set("item_desc", ([ /* sizeof() == 1 */
    "door": "
这是一扇经花雕名师于长白山查寻多年雕刻而成的高级杉木门,
瞧!!! 其上的凤纹可是天然而成,不加任何修饰的喔!!!\n",
  ]));

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "prmw3",
    "south": __DIR__ "prmw1",
    "west": __DIR__ "prmw7",
  ]));
  create_door("south", "花雕凤纹木门", "north", DOOR_CLOSED);
  set("outdoors", "/open/dancer");
  setup();
}
