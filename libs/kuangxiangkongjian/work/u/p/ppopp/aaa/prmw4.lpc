#include <room.h>
inherit ROOM;

void create ()
{
  set ("short", "前厅");
  set ("long", @LONG

    进入水月轩的前厅, 
    水月轩, 镜月岛上美人儿姊妹中的妹妹 -- 月牙儿小姐
居住的闺阁, 而北面正是水月轩的大门. 大门内传来阵阵的
琴音, 声声入耳, 扣人心弦, 使人不禁想要一亲芳泽.

LONG);

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 2 */
     "north" : __DIR__"prmw5",
     "south" : __DIR__"prmw3",
]));
  setup();
}
