inherit ROOM;

void create() {
  set("short", "黛月亭");
  set("long", @LONG

这是一间什么都没有的房间。
 
LONG);
  set("item_desc", ([ /* sizeof() == 1 */
    "wall": "你仔细地看了看这面墙,发现了一个奇怪的突起物(key),而且似乎可以
转动(turn)它。"
  ]));

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "prmw11",
  ]));

  setup();
}
void init() {
  add_action("do_turn", "turn");
}

int do_turn(string str) {
  object me;
  me = this_player();
  if (!str || str != "key")
    return notify_fail("你想要做什么？\n");
  else if (!query_temp("have_turn")) {
    message_vision("$N伸出手来, 转了转那墙上的突起物。\n", me);
    tell_room(this_object(), "你发现北边的湖面开始晃动, 不久湖面上浮出一条小桥。\n");
    set("exits/north", __DIR__ "prmw13");
    set_temp("have_turn", 1);
    remove_call_out("do_closed");
    call_out("do_closed", 20);
    return 1;
  } else {
    remove_call_out("do_closed");
    delete_temp("have_turn");
    delete("exits/north");
    message_vision("$N伸出手来转了转那墙上的突起物, 那浮桥迅速沈入湖里。\n", me);
  }
  return 1;
}
void do_closed() {
  delete_temp("have_turn");
  delete("exits/north");
  tell_room(this_object(), "浮桥缓缓地沈入了湖里。\n");
}
