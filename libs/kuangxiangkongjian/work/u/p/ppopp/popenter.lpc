#include <ansi.h>
#include <room.h>
inherit ROOM;

int i = 0;
void create() {
  set("short", "门庭");
  set("long", @LONG

眼前有一间十分别致的小木屋, 四周都开满了粉红色的玫瑰花, 欢迎着
你的到来, 木屋的左侧有一棵老榕树(tree), 树的四周围绕着很多美丽
的鸟儿. 这使你不禁怀疑到底是谁住在这呀? 真想进去看看!!! 走近一
瞧, 门上有块门牌(sign), 门牌旁有个信箱(box).

LONG);
  set("item_desc", ([ /* sizeof() == 4 */
    "sign": "
          ###############################
          # 服部半藏 和 琪琪 的蜜月小屋 #
          ###############################
\n",
    "tree": "这是一棵百年老树,树的四周围绕着各式各样的鸟儿,莫非.....
真想爬(climb)上去瞧瞧.\n",
    "box": "信箱??!! 住在这儿会有人寄信过来吗??? 不过里头好像有东西,
找找(search)看吧!!! \n",
    "door": "一个爱心形状的小木门,里头一定住着一对恩爱的夫妻.\n"
  ]));

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 数字 */
    "enter": "/u/p/ppopp/poplove",
  ]));
  create_door("enter", HIR "爱之门" NOR, "out", DOOR_CLOSED);
  setup();
}
void init() {
  add_action("do_climb", "climb");
  add_action("do_search", "search");
  add_action("do_shake", "shake");
  add_action("do_jump", "jump");
}
int do_climb(string str) {
  object ob;
  ob = this_player();
  if (str != "tree") return 0;
  message_vision(CYN "$N运起真气默念梯云纵字诀,两个起落已经登上了树梢。 \n" NOR, ob);
  ob->move(__DIR__ "poptree");
  return 1;
}
int do_search(string str) {
  object me;
  me = this_player();
  if (str != "box") return 0;
  if (i >= 1) {
    message_vision("你找了老半天，可是看不出有任何特殊之处。\n", me);
    write(CYN "对了,应该把信箱摇(shake)一摇看看。\n" NOR);
    return 1;
  }
  write("你找了老半天,只找到了一张破旧的纸片。\n");
  write(HIC "你随手将那张纸片拿起来塞进口袋里。\n" NOR);
  new("/u/p/ppopp/obj/paper.lpc")->move(me);
  i = i + 1;
  return 1;
}
int do_shake(string str) {
  object me;
  me = this_player();
  if (str != "box") return 0;
  message_vision(HIC "$N将信箱拿起来,使劲地摇一摇。\n" NOR, me);
  i = 0;
  return 1;
}
int do_jump(string str) {
  object me;
  me = this_player();
  message_vision(HIC "$N在踏垫上轻轻一跳," HIW "地上好似有个强力大弹簧,将$N弹了出去!!!\n" NOR, me);
  write(HIR "你唉呦～～地一声,痛得昏了过去.\n" NOR);
  write(HIY "你醒来时发现自己躺在床上,而可爱的秋香正在照顾自己.\n" NOR);
  me->move(__DIR__ "workroom");
  return 1;
}
