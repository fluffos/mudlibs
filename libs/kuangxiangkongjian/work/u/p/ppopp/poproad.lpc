#include <ansi.h>
#include <room.h>
inherit ROOM;

void create ()
{
  set ("short", "山坡");
  set ("long", @LONG

你沿着粉红玫瑰花径愉快地走着, 走着走着不知不觉地来到一个小山
坡上, 抬头一看, 山上有间小巧的小木屋. 突然间, 你有一股欲望想
爬上去瞧瞧到底是住着什么何方神圣. 

LONG);

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 数字 */
     "east" : "/u/p/ppopp/popgarden",
]));
  set("outdoors","/u/p/ppopp");
  setup();
}
void init()
{
  add_action("do_climb","climb");
}
int do_climb(string str)
{
  object me;
  me=this_player();
  if(str!="up") return 0;
  tell_object(me,CYN"走着走着,四周的雾越来越浓,你赫然发现:你迷路啦!!!\n"NOR);
          me->move("/u/p/ppopp/popenter");
        tell_room(this_object(),"你看着"+me->query("name")+"愉快地向山里走去,消失在浓浓的雾里.\n");
        return 1;
}
