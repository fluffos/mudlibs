#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string magic1();
string magic2();

void create()
{
        set_name("陆清风",({"master lu","lu"}));
	set("long","紫玄道观之主,一身道术无人能敌\n");
	set("gender","男性");
	set("class","taoist");
        set("nickname","紫玄道人");
        set("combat_exp",1000000);
        set("attitude","heroism");
        set("age",50);
        set("title","天道派掌门人");
	set("str", 25);           
	set("cor", 24);
	set("cps", 25);
	set("per", 24);
	set("spi", 40);
	set("int", 26);
        set("force",2200);
        set("inquiry",([
          ]));
        set_skill("literate",80);
        set("max_force",2200);
	set("max_mana",1000);
	set("max_atman",900);
	set_skill("force",50);
	set_skill("dodge",40);
	set_skill("parry",40);
	set_skill("gspell",60);
	set_skill("whip",60);
	set_skill("gwhip",70);
	map_skill("whip","gwhip");
	set("force_factor",10);
	set_skill("parry",60);
	set_skill("gforce",80);
	set_skill("gmagic",100);
	map_skill("force","gforce");
	map_skill("dodge","gspell");
	set("chat_chance_combat",40);
	set("chat_msg_combat",({
	(: magic1 :),
	(: magic2 :),
	}));
	setup();
        create_family("天道派",1,"掌门人");
	carry_object(CLASS_D("taoist/goldwhisk"))->wield();
	carry_object("/open/tendo/obj/robe")->wear();
	carry_object("/open/tendo/obj/shoe")->wear();
	carry_object("/open/tendo/obj/hat")->wear();
}

void attempt_apprentice(object ob)
{
	if(this_player()->query("class")!="taoist")
	{
		command("say 你不是道士，所以我不能收你为徒。\n");
		return;                   
	}
	command("hmm");
	command("recruit "+ob->query("id"));
	command("say 你可以去找志清师叔买件道服。");         
}

string magic1()
{
	command("use fireball");
	return "\n";
}

string magic2()
{
	command("use firedragon");
	return "\n";
}
	
	
