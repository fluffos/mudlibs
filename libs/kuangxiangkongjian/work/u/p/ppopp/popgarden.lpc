#include <ansi.h>
#include <room.h>
inherit ROOM;

    int i=0;
void create ()
{
  set ("short", "寻梦园");
  set ("long", @LONG

一进入这个园地, 仿佛进入了令一个世界, 是梦的世界. 这里四周开满了
粉红色的玫瑰花, 蝴蝶在花海上飞舞, 蜜蜂在花丛中穿梭, 鸟儿在你身旁
吱吱地叫着, 好似在欢迎着你的到来. 看着看着, 你赫然发现有一朵特别
大的花(flower), 难道她是这里的花仙子吗? 另外, 在头顶正上方有一个
牌子(sign), 奇妙的是, 它竟然悬浮在半空中.

LONG);
  set("item_desc", ([ /* sizeof() == 2*/
     "sign" : "

      欢迎莅临寻梦园,来到这儿找寻以往失去的梦想,希望你能满载而归. 

\n",
     "flower" : "
这是一朵盛开的玫瑰花,她的样子十分迷人,让你忍不住想亲吻(kiss)她.
但是想把她摘走(take)可不容易啊,得先经过独孤求败这一关喔! 
\n",
]));
  set("objects", ([ /* sizeof() == 3 */
     "/u/p/ppopp/npc/okla.lpc" : 1,
     "/u/p/ppopp/npc/butterfly2.lpc" : 1,
     "/u/p/ppopp/npc/butterfly1.lpc" : 1,
]));
  set("light_up", 1);
  set("exits", ([ /* sizeof() == 2 */
     "east" : "/u/p/ppopp/workroom",
     "west" : "/u/p/ppopp/poproad",
]));
  create_door("east", "凤纹布帘", "west", DOOR_CLOSED);
  setup();
}

void init()
{
  add_action("do_kiss","kiss");
  add_action("do_take","take");
}

int do_take(string str)
  {
        object me;
        object who;
      me=this_player();
      who=present("okla",environment(me));
   if(str!="flower") return 0;

          if(i>=1)
{
          write(CYN"对不起啰...这朵玫瑰花已经被摘走啦!!! 唉～有花堪折直须折,莫待
无花空折枝. \n"NOR); 
           return 1;
}
if(me->query("id") == "ppopp")
{
message_vision("$N转身一个"HIY"捻花手"NOR",轻巧地摘下那朵"HIM"玫瑰"NOR".真是好身手!!! \n",me);
message_vision("独孤求败 赞道‘好个"HIY"捻花手"NOR"!!! 真是我的好妻子啊!!! 哈哈哈.....’ \n",me);
   new("/u/p/ppopp/obj/rose.lpc")->move(me);
i=i+1;
    return 1;
}
           if(present("okla",environment(me)))
{
           message_vision("$N鬼鬼祟祟地向那朵玫瑰花走去. \n",me);
           message_vision("独孤求败 对着$N大喝‘嘿!!! 想要这朵玫瑰得先通过我这关,你够资格吗???’ \n",me);
           write("独孤求败 朗声说道‘喂!!! 小伙子,注意啦!!! 刀剑可不长眼睛的啊...’ \n");
           who->kill_ob(me);
           return 1;
}
           tell_object(me,"有人用千里传音喊道‘你走运啦! 这朵"HIM"玫瑰"NOR"是你的啦! 真有一套...’ \n");
           message_vision(HIC"$N愉悦地向玫瑰花仙子走去,轻轻地把她摘了下来.     \n"NOR,me);
           write(HIG"这么漂漂的玫瑰该送谁好呢??? 我想送给琪琪最适合了... 嘻嘻嘻... \n"NOR);
           new("/u/p/ppopp/obj/rose.lpc")->move(me);
           i=i+1;
           return 1;
}
int do_kiss(string str)
{
    object me;
    object who;
     me=this_player();
     who=present("okla",environment(me));
     if(str!="flower") return 0;

      if(present("okla",environment(me)))
  {
     if(i>=1)
    {
       message_vision(HIC"$N怜悯地看一看这朵早已被采走的玫瑰,轻轻地吻了她. \n"NOR,me);
       write("突然间,不知是这朵玫瑰受到你的感动还是.... 总之,"HIM"她又开出她美丽
的花啰. \n"NOR);
        i=0;
       return 1;
     }
      else
     {
        message_vision(HIC"$N不自觉得被这朵玫瑰深深吸引着,情不自禁的吻了她. \n"NOR,me);
        write("独孤求败 对着你笑道‘嘿!!! "HIW"花痴"NOR"!!! 想要花的话,就鼓起勇气向我挑战吧!!!’ \n");
        return 1;
      }}
        message_vision(HIC"$N不自觉得被这朵玫瑰深深吸引着,情不自禁的吻了她. \n"NOR,me);
        write("咦??!! 我怎么变成"HIW"花痴"NOR"啦??!! 真丢脸!!! 幸好没人注意到,嘻嘻嘻... \n");
        return 1;
}
