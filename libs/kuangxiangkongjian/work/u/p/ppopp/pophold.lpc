#include <ansi.h>
#include <room.h>
inherit ROOM;

  int i=0;
void create ()
{
  set ("short", "树洞");
  set ("long", @LONG

这里应该是阴暗的树洞, 可是却奇亮无比, 仔细观察后发现原来光芒是
来自一个很大的鸟巢(nest), 鸟巢的旁边有一只七彩凤凰, 她正目露凶
光地看着你, 防止你接近她的宝贝.

LONG);

  set("item_desc", ([ /* sizeof() == 1*/
"nest" : "这是七彩凤凰的巢,里头有一颗闪闪发光的蛋(egg),令人忍不住想拿(take).\n",
]));

  set("objects", ([ /* sizeof() == 1*/
     "/u/p/ppopp/npc/bird.lpc" : 1,
]));
  set("light_up", 1);
  set("exits", ([ /* sizeof() == 1*/
     "down" : "/u/p/ppopp/poptree",
]));
  setup();
}
void init()
{
  add_action("do_take","take");
}
int do_take(string str)
{
  object me;
  object who;
  me=this_player();
  who=present("bird",environment(me));
  if(str!="egg") return 0;
   if(i>=1)
     {
          write(CYN"你在鸟巢里摸了半天,发现里头除了鸟屎外,什么都没有!!!\n"NOR);
          return 1;
     }
     if(present("bird",environment(me)))
  {
  message_vision(HIY"七彩凤凰 愤怒地吼道 : 你想干什么??!!\n"NOR,me);
     who->kill_ob(me);
     return 1;
  }
     message_vision(HIC"$N微笑地向鸟巢走去,伸手将"HIY"凤凰蛋"HIC"取走.\n"NOR,me);
    new("/u/p/ppopp/obj/egg.lpc")->move(me);
    i=i+1;
    return 1;
}
