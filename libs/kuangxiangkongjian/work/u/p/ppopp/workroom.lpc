#include <ansi.h>
#include <room.h>
inherit ROOM;

void create ()
{
  set ("short", "落雁阁");
  set ("long", @LONG

你一进门, 耳边便传来清脆的声音向你问安, 原来是一只褐嘴绿身羽端还
带有彩虹亮纹的彩纹九官鸟, 而后迎面而来的是阵阵粉红色玫瑰花香, 以
及那淡淡优雅清新少女独有的芳香, 使得心情为之欢愉. 屋内摆设简单,
檀木雕刻龙凤桌椅, 丝质手绣鸳鸯被枕, 西向镜子旁有一门帘, 北边有一
侧门. 窗(window)外望去, 满山粉红色玫瑰, 不觉浑然忘我. 这正是我们
名家闺秀--琪琪的房间, 你可别瞧不起这门上‘落雁阁’三个字, 它可是
出自当今皇上之手啊.

LONG);
  set("item_desc", ([ /* sizeof() == 2*/
     "window" : 
"
放眼望去,是一幕带着粉红色系的彩绘啊.喔不!!!是真的!是真实的景色啊.
满山的粉红玫瑰,成群的蝴蝶悠闲地飞舞着,鸟儿愉快地唱着歌,纺织娘在一
旁伴奏着,一片鸟语花香,真是人间仙境,使你不禁想要跳(jump)出窗外.咦!
在那远远的山腰上竟然还有住着人家呢!!!真是浪漫喔～～
\n",
     "door" : "在房间的西侧有一落地凤纹布帘,而房间北边的是紫色雕花坛木门.\n",
]));

  set("objects", ([ /* sizeof() == 2 */
     "/u/p/ppopp/npc/parrot.lpc" : 1,
     "/u/p/ppopp/npc/hsiung.lpc" : 1,
]));
  set("light_up", 1);
  set("valid_startroom", 1);
  set("exits", ([ /* sizeof() == 6 */
     "down" : "/u/p/ppopp/popdoor",
     "hanzo" : "/u/h/hanzo/workroom",
     "east" : "/u/h/hanzo/h2",
     "north" : "/u/p/ppopp/popkitchen",
     "west" : "/u/p/ppopp/popgarden",
     "up" : "/u/p/ppopp/popzoo",
]));
  create_door("north", "雕花紫檀木门", "south", DOOR_CLOSED);
  create_door("west", "凤纹布帘", "east", DOOR_CLOSED);
  setup();
}
void init()
{
  add_action("do_jump","jump");
}
int do_jump(string str)
{
         object me;
         me=this_player();
         if(str!="window") return 0;
          if(me->query("id") == "ppopp" || me->query("id") == "hanzo")
   {
            message_vision(HIG"$N运起无上心法,一个鹰起兔落,飞也似的跳出了窗外。 \n"NOR,me);
            write(HIW"刹那间天空飘下一朵云将你接个正着。咻～的一声,你已经来到了那间小屋前。\n"NOR);
            me->move(__DIR__"popenter");
            return 1;
    }
            message_vision(HIC"$N趁秋香一个不注意,匆忙地跳上了这扇窗子。 \n"NOR,me);
            message_vision("匆促间一个不留神,脚一滑重心不稳,摔了个"HIR"狗吃屎"NOR"。\n",me);
            message_vision("抬头一看,发现旁边有扇"HIW"门帘"NOR",同时也发现自己的"HIW"愚蠢"NOR"。\n",me);
            return 1;
}
