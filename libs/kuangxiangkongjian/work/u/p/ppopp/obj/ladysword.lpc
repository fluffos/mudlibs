// sword.c : an example weapon
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  seteuid(getuid());
  set_name("淑女剑", ({ "lady sword", "sword" }));
  set_weight(4000);
  set("gender_only", "女性");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 10000);
    set("material", "sliver");
    set("wield_msg", "$N从腰间抽出$n,挥出一个剑花.\n");
    set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  }
  init_sword(30);
  setup();
}
