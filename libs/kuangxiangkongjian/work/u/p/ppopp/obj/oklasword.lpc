// sword.c : an example weapon
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
	seteuid(getuid());
        set_name(HIG "魔剑 求败" NOR, ({"okla sword","sword"}));
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
            set("long","
独孤求败 当年走遍千山万水,不断向人求战,只为了求得一败,但仍败幸而归.
心中感慨万千,望着自己手中的剑大喊求败,因而得名!!! 但是这把剑真能求
得一败吗???
");
		set("value",800000);
		set("material", "steel");
                set("wield_msg", "$N从背后抽出$n,两眼布满血丝,霸气四射.\n");
		set("unwield_msg", "$N将手中的$n收回,气血逐渐平和,一切恢复自然。\n");
	}
        init_sword(75);
	setup();
}
