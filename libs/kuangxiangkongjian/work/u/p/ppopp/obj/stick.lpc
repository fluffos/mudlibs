#include <weapon.h>
#include <ansi.h>
inherit STABBER;

void create()
{
  seteuid(getuid());
  set_name(HIY"彩虹仙子小魔棒"NOR, ({"ppopp's stick","stick"}));
  set("long",
      "这是琪琪随身携带的小魔棒,据说可以招来美丽的彩虹,带你去找你思念的人。\n");
  set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("unit", "枝");
  set("value",0);
  set("material","gold");
  set("no_sell",1);
  set("no_drop",1);
  set("wield_msg", "$N优美地挥舞着"HIY"$n"NOR",同时也招来一道美丽的彩虹。\n");
  set("unwield_msg", "$N轻轻地把"HIY"$n"NOR"收进胸前的小盒子里。\n");
}
  init_stabber(15);
  setup();
}
void init()
{
  add_action("go_go","gogo");
}

int query_autoload()
{
   return 1;
}

int go_go(string str)
 {
   object obj;
   object me;
   me=this_player();
  if(!str || str == "")
    {
      write("小魔棒疑问地问道: 你到底要我带你去找谁???\n");
      return 1;
    }
   message_vision(HIM"$N将手上的小魔棒挥成一道彩虹,身影即随着彩虹离去。\n"NOR,me);
   obj=find_living(str);
   me->move(environment(obj));
   message_vision(HIM"天空中突然出现一道彩虹,而$N的身影亦随之出现。\n"NOR,me);
   return 1;
 }
