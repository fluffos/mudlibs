#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "凤凰蛋" NOR, ({ "gold egg", "egg" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗闪闪发亮的金色凤凰蛋。\n");
    set("light_up", -1);
    set("value", 7800);
    setup();
  }
}
