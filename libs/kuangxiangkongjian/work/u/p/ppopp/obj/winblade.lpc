#include <weapon.h>

#include <ansi.h>
inherit BLADE;

void create()
{
	seteuid(getuid());
	set_name(HIW "小悟刀" NOR, ({"win blade","blade"}) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
          	set("unit", "把");
            set("long","
悟刀门掌门人所持的刀, 看其外观是一把十分普通的刀, 令人怀疑是真是假.
古云: 善使刀者只重其刀意. 大概是这个意思吧!
");
		set("value",500000);
		set("material", "steel");
                set("wield_msg", "$N从腰间迅速地抽出$n转了一圈,觉得从中领悟出不少刀诀.\n");
		set("unwield_msg", "$N握着手中的$n转了一圈插入腰间的刀鞘。\n");
	}
        init_blade(65);
	setup();
}
