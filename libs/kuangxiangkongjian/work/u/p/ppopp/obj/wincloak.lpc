 
#include <armor.h>
#include <ansi.h>
 
inherit CLOTH;
 
void create()
{
       set_name( "破旧披风" , ({ "old cloak","cloak"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
set("long","这是一件琪琪出外探查,而又得隐藏身份时所著的装扮.\n");
                set("unit", "件");
                set("value",0);
                set("material", "air");
                set("armor_type","cloak");
}
        setup();
}
void init()
{
add_action("do_wear","wear");
}
int do_wear(string str)
{
          if(this_player() -> query("id") != "ppopp")
             return notify_fail("咦～这件披风那么破旧,能穿吗???\n");
     if(str="cloak"||str="all"||str="old cloak")
                set("armor_prop/armor",5000);
                set("armor_prop/dodge",1500);
           set("wear_msg","琪琪突然转身蹲下,而站起来时已经不是琪琪啰.\n");
                      set("armor_prop/id", ({"win"}) );
                      set("armor_prop/name", ({"小悟刀"}) );
                      set("armor_prop/nickname", ({HIW"追风浪子"NOR}));
                      set("armor_prop/title", ({"金刀门第六代弟子"}));
           set("armor_prop/short", ({"金刀门第六代弟子「"HIW"追风浪子"NOR"”小悟刀(Win)"}) );
                 set("armor_prop/long", ({"
月黑风高, 一声凄厉的狼号划破夜空. 破晓时分, 淡淡霜露, 一条孤独的人影
随着冥纸火光, 摇曳在湿冷小径. 朝阳露出署光, 射在沈沈金刀, 刀光闪耀在
冷酷的脸庞, 不见一丝笑容.
小悟刀, 一生爱刀, 用刀, 惜刀, 悟刀.
                                            悟～嘛!!!
小悟刀, 为悟刀而生, 为悟刀而活, 为悟刀而悟.
                                            悟～嘛!!!
"}) );
 
}
