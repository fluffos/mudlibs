#include <ansi.h>
inherit EQUIP;
void create()
{
     set_name( HIR "黑鹰斗蓬" NOR , ({"black cloak","cloak"}) );
     set_weight(2500);
     if ( clonep() )
              set_default_object(__FILE__);
     else {
            set("long","
一领背后绣着一只黑鹰的黑色斗蓬, 可是为什么看的到那只鹰??!!
莫非...莫非那是一只真的黑鹰??!!
");
            set("unit", "个");
            set("armor_type", "cloak");
            set("material","steel");
            set("value", 90000);
            set("armor_prop/dodge", 10);
            set("armor_prop/move", 10);
            set("armor_prop/armor",50);		

            set("wear_msg", "$N把$n披在身上,呼然一阵风,身子飘离了地面。\n");
     }
}
