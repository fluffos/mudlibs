#include <ansi.h>
inherit EQUIP;

void create()
{
  set_name(HIG"东瀛忍者服"NOR, ({"hanzo suit","suit"}));
  set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("long",
      "这是一件超级小号的东瀛忍者服,是琪琪专门为她家那个小淘气细心缝制的。\n");
  set("unit", "件");
  set("armor_type", "cloth");
  set("value",10);
  set("material","cloth");
  set("armor_prop/armor", 10);
  set("no_sell",1);
  set("wear_msg", CYN"$N死命地将这件超级小号的忍者服往身上套,样子真是滑稽。\n"NOR);
}
}
void init()
{
  add_action("go_go","gogo");
}

int go_go(string str)
 {
   object obj;
   object me;
   me=this_player();
  if(str!="hanzo" || str!="ppopp") return 0;
   message_vision(HIG"$N双手紧握,轻轻地在地上踩三下,整个人化成一阵烟雾消失啰。\n"NOR,me);
   obj=find_living(str);
   me->move(environment(obj));
   message_vision(HIG"忽然吹来一阵烟雾,而$N也出现在烟雾中。\n"NOR,me);
   return 1;
 }
