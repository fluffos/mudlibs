inherit ITEM;

void create()
{
        set_name("一张破旧的纸片",({"paper"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long","
纸片有着十分秀气的字:
这间小木屋可通琪琪小姐的落雁阁,只要你在门前轻轻一跳(jump).
要小心喔!!! 因为.....嘻嘻嘻.....
\n");
                set("value", 0);
                set("material", "paper");
        setup();
}}
