inherit BULLETIN_BOARD;

void create()
{
     set_name("爱□小版版", ({ "board" }) );
     set("location", "/u/p/ppopp/poplove");
     set("board_id", "board");
     set("long", "这是专给一对情人互诉情锺的留言版。\n");
     setup();
     set("capacity", 30);
     // 设这样就能让那些人 discard post 啰
     set("master", ({"ppopp"}));
}
string query_save_file()
{
  return "/u/p/ppopp/obj/popboard" ;
}
