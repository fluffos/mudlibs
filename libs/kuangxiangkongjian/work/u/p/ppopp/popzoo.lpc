#include <ansi.h>
#include <room.h>
inherit ROOM;

void create ()
{
  set ("short", "琪琪宠物收容所");
  set ("long", @LONG

琪琪个性爱好小动物, 把它们当宠物看待, 给予它们一个自由自在的
空间, 可以无拘无束的活动. 虽然说它们是小动物, 但是对你来说也
许算是大怪兽, 还是离远一点的好.
前面有一个警告牌(sign).

LONG);
  set("item_desc", ([ /* sizeof() == 1 */
  "sign" : "
这儿是琪琪专属的宠物收容所,琪琪在里头设计了很多空间,任牠们自由
自在的跑,因此增添了不少危险.为此,琪琪特别命其左右护法看守于此,
禁止闲杂人等进入,以测安全!!! 
\n"]));

  set("light_up", 1);
  set("objects", ([ /* sizeof() == 2 */
  "/u/p/ppopp/npc/general1" : 1,
  "/u/p/ppopp/npc/general2" : 1,
]));
  set("exits", ([ /* sizeof() == 3 */
     "down" : "/u/p/ppopp/workroom",
     "enter" : "/u/l/lum/guild/broom",
     "north" : "/open/dancer/room/proom_s",
]));
  setup();
}

int valid_leave(object me, string dir)
{
           object who;
        if ( dir == "north"&&who=present("general", environment(me)) )
 {
          if(me->query("id") == "ppopp")
  {
            message_vision(HIC"左右护法 轻声说道: 欢迎琪琪小姐光临镜月岛～ \n"NOR,me);
             return 1;
  }
          if(me->query("id") == "hanzo" || me->query("id") == "lum")
  {
            message_vision(HIC"左右护法 朗声说道: 原来是$N啊,贵宾贵宾,欢迎欢迎!!! \n"NOR,me);
             return 1;
  }
           message_vision(HIY"左右护法 怒道: 不准进入还硬闯,找死啊!!! \n"NOR,me);
            return notify_fail(HIW"\n左右护法 张大眼睛愤怒地看着你,使你不敢轻举妄动.\n");
 }
        if ( dir == "enter"&&who=present("general", environment(me)) )
 {
            write(HIC"左右护法 朗声说道: 镜月岛开发计画已经开始动工,您老也快快请进研究讨论吧. \n"NOR);
             return 1;
  }
             return 1;
}
