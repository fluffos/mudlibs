inherit NPC;

void create() {
  set_name("芙蓉彩蝶", ({ "fulon butterfly", "butterfly" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "
稀有且珍贵的蝴蝶，翩翩飞舞在花丛间，姿态显的格外地娴静高雅，仔细
一瞧，发现其头部有一抹淡淡的斑点，色泽犹如碧玉一般。奇怪的是, 她
一点都不怕人。");
  set("str", 10);
  set("cor", 20);
  set("verbs", ({ "bite" }));
  set("limbs", ({ "头部", "身体", }));
  set("combat_exp", 600);
  set("chat_chance", 4);
  set("chat_msg", ({
    "芙蓉彩蝶 愉快地在粉红玫瑰花丛间飞舞着。\n",
    (: this_object(), "random_move" :),
  }));
  setup();

}
