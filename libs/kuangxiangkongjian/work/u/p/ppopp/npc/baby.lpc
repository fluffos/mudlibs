
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("服部小藏", ({"hanzos","baby"}));
        set("nickname", HIY"淘气少爷"NOR);
        set("gender", "男性");
        set("long","
一个十分古锥的小男孩, 身穿着一件手工极为精致的小忍者服. 他现在正蹲在一  
旁, 两眼微闭, 在那喃喃地念着咒语呢!!! 咦?!! 这么可爱的小淘气脸上似乎有
着两个人的影子喔. 啊!!! 他就是服部半藏和琪琪他们家的大少爷嘛!!!
");
        set("age", 10);
        set("attitude", "peaceful");
        set("score",25000);
        set("combat_exp", 8000);

        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);

        setup();

        carry_object("/u/p/ppopp/obj/hansuit.lpc")->wear();
        set("chat_chance", 40);
        if(!present("Germany mark", this_player()))set("chat_msg",({
            (: command ("gogo hanzo") :),
            (: command ("gogo ppopp") :),
            (: command ("say 爹的～ 教我变魔术啦!!!") :),
            (: command ("say 咦!!?? 妈妈呐??? 我要去找妈妈啦!!!") :),
            (: command ("tickle hanzo") :),
            (: command ("giggle") :),
        }));
}
int accept_kill(object me)
{
   command("say 嗯??? 什么是‘杀’啊??? 好不好玩啊???");
   message_vision(CYN"$N听了这么纯真的回答,怎么样也下不了手!!!\n"NOR);
   return 0;
}
int accept_fight(object me)
{
  return notify_fail(CYN"服部小藏正沈迷在玩耍中,压跟儿没听到你在说话。\n"NOR);
   return 1;
}
