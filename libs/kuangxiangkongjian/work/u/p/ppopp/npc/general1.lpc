#include <ansi.h>
#include "/open/open.h"
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("造天笔", ({ "left general zhou_tian_bi", "general" }));
  set("long", "他是一个十分儒雅的书生，但却是武林中的极为有名的侠客。\n"
    "他现在奉琪琪之命,负责看守这里,禁止闲杂人等进入。\n");
  set("gender", "男性");
  set("class", "scholar");
  set("title", "左护法");
  set("nickname", HIC "七孔凤凰笔" NOR);
  set("combat_exp", 1000000);
  set("attitude", "heroism");
  set("age", 42);
  set("str", 44);
  set("cor", 24);
  set("cps", 18);
  set("per", 24);
  set("int", 42);
  set("force", 1400);
  set_skill("literate", 100);
  set("max_force", 1400);
  //	map_skill("dodge","winter-steps");
  set("force_factor", 10);
  set_skill("force", 60);
  set_skill("stabber", 80);
  set_skill("dodge", 50);
  //	set_skill("knowpen",100);
  //	map_skill("stabber","knowpen");
  set_skill("parry", 40);
  //	set_skill("poetforce",80);
  //	map_skill("force","poetforce");
  //	map_skill("parry","knowpen");
  set_skill("unarmed", 40);
  //	set_skill("plan",100);
  //	set_skill("winter-steps",70);
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: perform_action, "stabber.movedown" :)
  }));
  setup();
  carry_object(START_OBJ "ten_pen")->wield();
}
