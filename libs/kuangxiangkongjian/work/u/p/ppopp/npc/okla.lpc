#include <ansi.h>
inherit NPC;
void create() {
  set_name("独孤求败", ({ "okla" }));
  set("long", "

独孤求败, 仙剑派的传奇人物. 一生求剑! 求道! 求战! 皆为求败!!!
败!!! 对他而言, 真是太难啦. 人人皆想求成, 独他偏想求败, 这...
这未尝不是一种领悟呢?!! 近来他剑术已达仙境, 无法以躯壳限制了.
意即这身躯只能算是他的替身, 他已经达到天人合一的境界啦!!! 

");
  set("gender", "男性");
  set("combat_exp", 500000);
  set("age", 32);
  set("class", "swordsman");
  set("title", "仙剑奇人");
  set("nickname", HIG "剑魔" NOR);
  set("score", 1000);
  set("attitude", "heroism");
  set("max_kee", 600);
  set("max_gin", 180);
  set("max_sen", 180);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 10);
  set_skill("unarmed", 50);
  set_skill("sword", 110);
  set_skill("dodge", 80);
  set_skill("move", 40);
  set_skill("force", 50);
  set_skill("parry", 80);
  set_skill("literate", 65);
  set_skill("shasword", 70);
  map_skill("sword", "shasword");
  map_skill("parry", "shasword");
  set_skill("sha-steps", 80);
  map_skill("dodge", "sha-steps");
  map_skill("move", "sha-steps");
  set_skill("shaforce", 50);
  map_skill("force", "shaforce");
  set("str", 35);
  set("cor", 30);
  set("int", 38);
  set("cps", 20);
  set("con", 30);
  set("spi", 20);
  set("kar", 15);
  set("per", 35);
  setup();
  carry_object("/u/p/ppopp/obj/cloak1.lpc")->wear();
  carry_object("/open/gsword/obj/robe_1.lpc")->wear();
  carry_object("/u/p/ppopp/obj/oklasword.lpc")->wield();
  set("chat_chance", 10);
  if (!present("Germany mark", this_player())) set("chat_msg", ({
    (: command("hoho") :),
    (: command("pk") :),
    (: command("hold ppopp") :),
    (: command("say 琪琪是我一生中唯一的真爱!!!") :),
  }));
}
int accept_kill(object me) {
  command("say 觉悟吧!!! 哼!!!");
  return 1;
}
int accept_fight(object me) {
  if ((int)me->query("combat_exp") <= 15000) {
    command("say 你还不配做我的剑下亡魂,哼!!! ");
    return 0;
  }
  command("say 觉悟吧!!! 哼!!! ");
  return 1;
}
