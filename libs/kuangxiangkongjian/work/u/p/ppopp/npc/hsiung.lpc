#include <ansi.h>
inherit NPC;
void create()
{
        set_name("秋香", ({"chio hsiung","hsiung","girl"}));
        set("long","
她是琪琪最喜欢的丫嬛, 从小就一直陪伴着她, 一起玩耍, 一起分享
彼此的心事. 她总是十分地善解人意, 而琪琪也把他当作自己的妹妹 
一样看待. 她看起来总是那么的甜, 往往让人情不自禁地想亲亲她.
");
        set("gender","女性");
        set("combat_exp",1000);
        set("age",15);
        set("class","swordsman");
        set("title","琪琪的贴身丫嬛");
        set("score",1000);
        set("attitude","heroism");
        set_skill("unarmed", 50);
        set_skill("sword", 40);
        set_skill("shasword", 40);
        map_skill("sword","shasword");
        set_skill("parry", 30);
        map_skill("parry","shasword");
        set_skill("dodge", 50);
        set_skill("sha-steps", 40);
        map_skill("dodge","sha-steps");
        set_skill("force", 20);
        set_skill("shaforce", 10);
        map_skill("force","shaforce");
        set("force",50);
        set("max_force",50);
        set("force_factor", 5);
        set_skill("literate",35);
        set("combat_exp",9000);
        set("str", 20);
        set("cor", 15);
        set("per", 28);
        set("int", 25);
        set("cps", 20);
        set("con", 20);
        set("spi", 15);
        set("kar", 15);
        set("chat_chance", 6);
        set("chat_msg", ({
           "秋香 轻声说道:‘琪琪姐姐, 说故事给我听好吗？’\n",
           "秋香 偷偷地告诉你说:‘琪琪姐姐最棒了, 教我好多东西喔。’\n",
           "秋香 满脸喜悦地说:‘我最喜欢琪琪姐姐了。’\n"
}));
        setup();
        add_money("silver", 10);
        carry_object("/open/gblade/obj/flower-shoes.lpc")->wear();
        carry_object("/open/center/obj/pant2.lpc")->wear();
        carry_object("/open/center/obj/cloth3.lpc")->wear();
        carry_object("/open/gsword/obj/ring-1.lpc")->wear();
        carry_object("/open/center/obj/amulet1.lpc")->wear();
        carry_object("/u/p/ppopp/obj/rose.lpc")->wear();
        carry_object("/u/p/ppopp/obj/ladysword.lpc")->wield();
}

void init()
{
      add_action("do_kiss","kiss");
}
int do_kiss(string str)
{
        object ob;
        ob=this_player();
        if(str!="girl" && str!="hsiung") return 0;
        if(ob->query("gender") == "男性")
        {
        if(ob->query("id") == "hanzo")
         {
                message_vision(HIC"$N在秋香的额头上吻了一下.\n"NOR,ob);
                command("blush");
                command("say 讨厌!!! 我要跟琪琪姐姐说喔～ ");
                return 1;
                }
                message_vision(HIC"$N在秋香的额头上吻了一下.\n"NOR,ob);
        command("slap "+ob->query("id"));
        command("say 哼!!! 看我年纪小好欺负??!! ");
        command("face "+ob->query("id"));
        return 1;
        }
        if(ob->query("gender") == "女性")
                message_vision(HIC"$N在秋香的额头上吻了一下.\n"NOR,ob);
        command("say 哎呀! 你怎么偷亲我??!!");
        return 1;
}

int accept_kill(object who)
{
    command("wear all");
    command("fight");
    return 1;
}
int accept_fight(object who)
{
    command("wear all");
    command("kill");
    return 1;
}
