#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
   set("short", HIW"天界中心"NOR);
   set("long", @LONG
这里是天界的中心, 你看到各城的神族来来往往, 十分热闹,
帝释天所住的善见城和水中的阿修罗城恰成一对, 就像是倒影
一般. 围绕东西南北四方的是四天王所统领的城市.
LONG);
        set("exits", ([
	"north": __DIR__ "nm1",
        "down": __DIR__ "dm1",
        ]) );
        setup();
}
void init()
{
    add_action("do_look","l");
    add_action("do_look","look");
}
int do_look(string str)
{
 if(str=="north")
write("你往北面一瞧, 在远处隐隐有两各宫殿, 是北天王昆沙门天的
居处, 相邻的宫殿是他的妻子吉祥天的住处. ");
 if(str=="east")
write("东边的王城感觉上空荡荡的, 自从前代东天王持国天在圣战一役
过逝之后, 这个位置就一直空着至今.   远端不停改变位置的城
是干达婆王的居处干陀罗陼.");
 if(str=="south")
write("南面是南天王增长天的居处, 远方的天空城不停移动位置, 环绕
南天王城.");
 if(str=="west")
write("西边是西方天王广目天的宫殿, 广目天统领着五天, 负责天界西
境的安宁.");
}
