#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
   set("short", CYN"荒芜寺院"NOR);
   set("long", @LONG
到处都是残砖败瓦, 杂草丛生,   房舍一副随时会垮下来的样子.
这里是占星人．九曜从前的修行处, 现在则成了她逃难的临时居
所. 地上有一具惨不忍睹的尸体(corpse).
LONG);

        set("exits", ([
        "south": __DIR__ "dm11",
        ]));
}
void init()
{
        add_action("do_look","l");
        add_action("do_look","look");
}
int do_look(string str)
{
        if(str=="corpse")
        write("前代的占星人. 九曜那惨不忍睹的尸体.");
}

