//小阿修罗使出了红莲火焰, 
#include <ansi.h>
void do_special();
inherit NPC;

void create()
{
        set_name("阿修罗", ({ "xious" }) );
//        set("race","魔族");
        set("long", 
"被封印在幻力森林的小阿修罗, 三百年来一直沈睡于此.\n");
		set("nickname", "命运之子");
        set("gender","男性");
        set("age", 300);
        set("str", 40);
        set("con", 30);
        set_skill("unarmed",70);
        set_skill("dodge",55);
        set_skill("move",50);
        set("force",2000);
        set("max_force",2000);
        set("force_factor",10);
        set("max_gin", 200);
        set("max_kee", 1500);
        set("max_sen", 100);
        set("limbs", ({ "头部", "手腕", "手臂", "右脚", "腰部" }) );
        set("verbs", ({ "claw", "poke" }) );
        set("attitude","heroism");
        set("chat_chance", 4);

        set("chat_msg", ({
                "阿修罗阴沈的说: 唤醒我的人啊, 报上你的姓名来。\n",
                "阿修罗狂笑道: 勇敢的人啊, 这个世界将因你而成为炼狱。\n",
                 }) ); 
        set("chat_chance_combat",40);
        set("chat_msg_combat",({
        (: do_special :)
        }));
        set("combat_exp",100000);
        setup();
        add_money("gold", 5);
}

void do_special()
{
    object *enemy,target;
    int i;

        enemy=this_object()->query_enemy();
        i=sizeof(enemy);
        target=enemy[random(i)];

                message_vision(
        HIC "\n小阿修罗使出了‘红莲火焰’\n"NOR,target);
                target->receive_wound("kee",50+random(100));
                COMBAT_D->report_status(target);

}