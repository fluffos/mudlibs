//tea

inherit ITEM;
#include <ansi.h>

void create()
{
   set_name(RED"一壶刚泡出来的玫瑰花茶"NOR,({"tea"}));
   set_weight(100);
   set("unit","壶");
   if ( clonep() )
      set_default_object(__FILE__);
   else{
        set("value",1000000);
        set("long",HIM"上选玫瑰花露拌着茶叶的香气, 让你想一口把它全部喝下去.\n"NOR);
        }
}

void init() 
{
   if(this_player()==environment())
   add_action("do_drink","drink");
}

int do_drink(string arg)
{
   if( !arg || arg!= "tea")
   return notify_fail("妳要吃啥？\n");
   message_vision(HIM"$N闻到一股淡淡的玫瑰花香飘了出来, 让你觉得脑中清醒多了\n"NOR,this_player() );
   destruct(this_object());
   return 1;
}
