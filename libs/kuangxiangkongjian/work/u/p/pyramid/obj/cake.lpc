//cake by know

inherit ITEM;
#include <ansi.h>

void create()
{
   set_name(HIY"一盘精致的乳酪蛋糕"NOR,({"cake"}));
   set_weight(100);
   set("unit","份");
   if ( clonep() )
      set_default_object(__FILE__);
   else{
        set("value",1000000);
        set("long","新鲜的乳酪作成的精致蛋糕, 入口即化, 松松软软,
看起来十分可口的样子.\n");
        }
}

void init() 
{
   if(this_player()==environment())
   add_action("do_eat","eat");
}

int do_eat(string arg)
{
   if( !arg || arg!= "cake")
   return notify_fail("妳要吃啥？\n");

   message_vision(HIC"$N仔细一闻发觉好香好香,嘴巴张的大大的一口把它放进嘴中
"HIG"从$N的表情看出来一定是天下少有的美味....hmm...好想再吃一口....\n"NOR,this_player() );

   destruct(this_object());
   return 1;
}
