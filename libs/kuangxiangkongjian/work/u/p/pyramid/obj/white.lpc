// ROSE.c by know
#include <ansi.h>
#include <mudlib.h>

inherit ITEM;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_GUILDCMDS;

void create() {
  set_name(" [1m[37m洁白的玫瑰花[0m ", ({ "rose" }));
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("unit", "朵");
    set("long", "一朵[1m[37m鲜嫩洁白的玫瑰花[0m,叶子上还带着未干的露水
");
    set("no_get", 1);
    set("no_put", 1);
    seteuid(getuid());

  }
  setup();
}

void init() {
  if (environment(this_object())->query("id") == "pyramid") {
    add_action("do_fire", "smell");
  }
}
int do_fire(string arg)

{
  object me = this_player();
  if (!arg || arg != "rose") return 0;

  message("system", "一阵玫瑰的清香沁人心房, \n" NOR, users());

  destruct(this_object());

  return 1;
}

int query_autoload() {
  return 1;
}
