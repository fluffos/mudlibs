#define RMK_VERSION "(v1.0)"

inherit ITEM;
inherit F_AUTOLOAD;

int show_table(string arg);
int get_main_choice(string choice);
int make_room(string arg);
int show_room_item();
int get_room_item(string arg);
int set_room_item(string arg,string item);
int show_room_flag();
int set_room_flag(string flag);
int show_room_all();
int get_delete_item(string item);
int save_room(); 
int save_room_file(string yn, string file, string str);
int do_read(string arg);
string *special_props = ({ "short" , "long" });

mapping tmp;

mapping room_flag =  ([
	"1" : (["cname": "禁止施法",  "name" : "no_magic", "set" : 0 ]),
	"2" : (["cname": "禁止战斗",  "name" : "no_fight", "set" : 0 ]),
	"3" : (["cname": "禁止天神传送", "name" : "no_recall", "set" : 0 ]),
	"4" : (["cname": "灯光(室内才有效)", "name" : "light_up", "set" : 0 ]),
	"5" : (["cname" : "储存点", "name" : "valid_startroom", "set" : 0 ])
]);

mapping room_item = ([
	"short" : "房间名",
	"long"  : "长叙述",
	"outdoors" : "属于哪区域(室外才需设)",
	"item_desc/item" : "物品描述",
	"objects of file" : "物件",
	"exits/dir"	: "出口",
	"others" : "其他"
]);

void create()
{
	set_name("房间制造器" + RMK_VERSION, ({ "roommaker", "maker" }) );
	set_weight(100);
	set("unit", "个" );
	set("long", @LONG
    这是一个用来制造或修改房间的工具，帮助巫师能在线上修改或创造房间。
不过只能提供简单的设定，关于房间附属函数就无法提供你编辑了。若想知道此
制造器详细用法，请 read roommaker。
LONG
	);
}

void init()
{
	if( wizardp(environment()) ) {
		seteuid(getuid(environment()));
		add_action("show_table", "run");
		add_action("do_read", "read");
	}
}


int show_table(string arg)
{
	write("[2J[1;0H");
	write("1. 创造新房间(create room)		\n");
	write("2. 设定房间元素(set room item)		\n");
	write("3. 设定房间基本属性(set default flag)	\n");
	write("4. 清除房间元素(delete room item)	\n");
	write("5. 储存房间资料(save room)		\n");
	write("＊ 注意：若无储存则修改无效哦。 ＊	\n");
 	write("请输入数字选择(1-5)，或输入 quit 离开。	\n");
	write("=>");
	input_to("get_main_choice");
	return 1;
}

int get_main_choice(string choice)
{
	switch(choice)
	{
		case "1":
			write("[2J[1;0H请输入房间档名:");
			input_to("make_room");
			return 1; break;
			
		case "2":
			return show_room_item();
			break;

		case "3":
			return show_room_flag();
			break;

		case "4":
			return show_room_all();
			break;

		case "5":
			return save_room();			
			break;

		case "quit":	
			tmp = ([]);
			return 1; break;
		default:
			write("无此选项。\n");
			call_out("show_table",1);			
	}
	return 1;
}

int make_room(string arg)
{
	string file;

	seteuid(geteuid(this_player()));
	file = resolve_path(this_player()->query("cwd"), arg) + ".lpc";
	if( file_size(file)!=-1 )
	{	
		write("档案 " + file + " 已经存在了。\n");
		call_out("show_table",1);
		return 1;
	}

	if( !write_file(file, @ROOM_CODE
// This is a room made by roommaker.

inherit ROOM;

void create()
{
	set("short", "空房间");
	set("long", "这是一间什么也没有的空房间。\n");
	setup();
}
ROOM_CODE
	) ) return notify_fail("你没有写入档案(" + file +")的权利。\n");
	message_vision("只听到$N的房间编辑器「哔”的一声，你觉得这个世界又变大了一点。\n", this_player());

	call_out("show_table",1);	
	return 1;
}

int show_room_item()
{
	int i;
	string *items;
	
	write("[2J[1;0H== 请选择要设定的房间元素 ==\n");
	items = keys(room_item);
	for(i = 0; i< sizeof(items); i++)
		write(room_item[items[i]]+"("+items[i]+")\n");	
		
	write("=>");
	input_to("get_room_item");
	return 1;
}

int get_room_item(string arg)
{
	string dir;

	write("[2J[1;0H== 设定 "+ arg +" 中( 用 . 表结束 ) ==：\n");

	if( strsrch(arg,"objects") != -1 )
	{
		sscanf(arg,"objects of %s",dir);
		if( !find_object(dir) )
		{
			write("无此物件，请检查路径有无设错。\n");
			call_out("show_table",2);
			return 1;
		}	
	}

	input_to("set_room_item",arg);
	return 1;
}

int set_room_item(string arg,string item)
{
	string dir;
	int num;
	if(arg == ".") {
		write(" OK!!\n");
		if( strsrch(item,"objects") != -1 )
		{
			sscanf(item,"objects of %s",dir);
			sscanf(tmp[item],"%d",num);
			environment(this_player())->set("objects", ([ dir:num ]));				

		} else if( !undefinedp(tmp[item]) ){
			environment(this_player())->delete(item);
			environment(this_player())->set(item,tmp[item]);
		}
		call_out("show_table",1);
		return 1;
	}
	if(!mapp(tmp))
		tmp = ([ item : arg ]);
	else
	{		
		if( !undefinedp(tmp[item]) )
			tmp[item] += arg + "\n";
		else if(item == "long")	
			tmp[item] = arg + "\n";	
		else 	tmp[item] = arg;
	}
	
	input_to("set_room_item",item);
	return 1;
}

int show_room_flag()
{
	string str,j,*flags;
	int i;
	str = "[2J[1;0H";
	
	if(sizeof(room_flag) )
	{
		for(i=1;i<=sizeof(room_flag);i++)
		{
			
			j = sprintf("%d",i);
			if(environment(this_player())->query(room_flag[j]["name"]) )
				room_flag[j]["set"] = 1;
			else	room_flag[j]["set"] = 0;	

			str += sprintf("%s. [%s]  %s(%s)\n",j,
			(room_flag[j]["set"])? "◎":"  ",
			room_flag[j]["cname"],room_flag[j]["name"]);
		}	
		str += "请选择想设定的属性(1 - 5 ,直接 enter 跳到主选单)：";
		write(str);
		input_to("set_room_flag");
		return 1;
	}		
}

int set_room_flag(string flag)
{
	object me = this_player();
	object env = environment(this_player());

	if(!room_flag[flag])
	{
		call_out("show_table",1);
		return 1;	
	}
	else
	{
		if(env->query(room_flag[flag]["name"]) )
			env->delete(room_flag[flag]["name"]);				
		else	env->set(room_flag[flag]["name"],1);

		call_out("show_room_flag",1);
		return 1;	
	}
	
}

int show_room_all()
{
	string str,*item;	
	int i;
	mapping room;
	
	str = "[2J[1;0H下面是此房间所有的元素，请选择要删除的。\n";
	
	room = environment(this_player())->query_entire_dbase();
	if(sizeof(room) )
	{
		item = keys(room);	
		for(i=0 ;i<sizeof(item); i++)
			str += sprintf(" %s\t\t∶ %O\n",item[i],room[item[i]]);			
		this_player()->start_more(str);
		write("=>");	
		input_to("get_delete_item");
		return 1;
	} else {
		write("此房间无任何资料。\n");
		call_out("show_table",1);
		return 1;
	}
}

int get_delete_item(string item)
{
	if( environment(this_player())->delete(item) )
		write("OK!!\n");
	else	write("无此资料可删除。\n");
	
	call_out("show_table",1);
	return 1;
}

int save_room()
{
	object env;
	string str, *name, file;
	mapping prop;
	int i;

	env = environment(this_player());
	file = file_name(env) + ".lpc";
	str = "// Room: " + file + @ROOM_CODE


inherit ROOM;

void create()
{
ROOM_CODE
	;
	str += sprintf("\tset(\"short\", %O);\n", env->query("short") );
	str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long") );
	prop = env->query_entire_dbase();
	name = keys(prop);
	for(i=0; i<sizeof(name); i++) {
		if( member_array(name[i], special_props)!=-1 ) continue;
		str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]] );
	}
	str += "\n\tsetup();\n\t}\n";

	// Replace current directory with __DIR__ macro to make relocatable code.
	i = strlen(file)-1;
	while( (i > 0) && (file[i]!='/')) i--;
	if( i>0 ) {
		write("目前目录：" + file[0..i] + " 以 __DIR__ 取代。\n");
		str = replace_string(str, "\"" + file[0..i], "__DIR__\"");
	}

	if( file_size(file)!=-1 ) {
		write("档案 " + file + " 已存在，要删除旧档吗？[y/n]");
		input_to("save_room_file", file, str);
		return 1;
	}

	return save_room_file("y", file, str);
}

int save_room_file(string yn, string file, string str)
{
	if( strlen(yn)<1 || yn[0]!='y' ) return 1;

	rm(file);
	tmp = ([]);
	write("存档 " + file + "....");
	if( write_file(file, str) ) {
		write("Ok.\n");
		return 1;
	} else
		return notify_fail("你没有写入这个档案(" + file + ")的权利。\n");
}

void owner_is_killed() { destruct(this_object()); }
int query_autoload() { return 1; }

int do_read(string arg)
{
	string str;
	
	str = @HELP
== Roommaker 1.0 版 ==   作者: Smallpp

启动 roommaker  =>  run

会出现一个选单
1. 创造新房间(create room)
2. 设定房间元素(set room item)
3. 设定房间基本属性(set default flag)
4. 清除房间元素(delete room item)
5. 储存房间资料(save room)
＊ 注意：若无储存则修改无效哦。 ＊
请输入数字选择(1-5)，或输入 quit 离开。
=>
再照选单说明执行即可

 ++++注意事项++++
 A. 创造出来的新房间会位于你所在的目录下(即ls 时看到的目录)

 B. 设定房间元素有几个元素要注意 格式
     1.其他(others)          这个不是叫你键入 others, 而是任何字串皆可
     2.出口(exits/dir)            例如  exits/north    exits/enter  
     3.物件(objects of file)      例如: objects of /d/locity/npc/cat
     4.物品描述(item_desc/item)   例如: item_desc/table  item_desc/ball

 C. 设定房间基本属性,前有 ◎ 表此房间有设定此属性, 再选一次可以取消
     1. [  ]  禁止施法(no_magic)
     2. [  ]  禁止战斗(no_fight)
     3. [  ]  禁止天神传送(no_recall)
     4. [  ]  灯光(室内才有效)(light_up)
     5. [◎]  储存点(valid_startroom)
 
 D. 如果有设定错误, 只要再重设定一次就可, 或者先不要 save ,
    update here即可恢复旧关

 F. 发现 bug 请通知我..
 
  
HELP;
 
	if(arg == "roommaker")
		this_player()->start_more(str);
	else 	return notify_fail("你想阅\读什么？\n");
	return 1;
}
