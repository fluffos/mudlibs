// shelf.c by cuteyu
#include <ansi.h>
#include <mudlib.h>

inherit ITEM;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_GUILDCMDS;

void create()
{
      set_name(" [1m[36m精致的玻璃柜子[0m ", ({"shelf"}) );
      if( clonep() )
              set_default_object(__FILE__);
      else{

      set( "unit" , "个" );
      set( "long" , "[1m[36m一个精致的玻璃柜子摆在这里[0m,上面的雕工
精细到令人咋舌,里面摆了一些精致的小饰物,小心可别打破了.\n
");
      set( "no_get" , 1 );
      set( "no_put" , 1 );
      seteuid(getuid() );

        }
      setup();
}

void init()
{
     if (environment(this_object())->query("id")=="pyramid")
     {
      add_action("do_exam" , "exam" );
     }
}
int do_exam(string arg)

{
      object me=this_player();
      if(!arg||arg!="shelf") return 0;

      message_vision(HIG"$N小心翼翼的打开玻璃柜子,取出几件小东西在手上把玩.\n"NOR , users());

      destruct(this_object());

      return 1;
}

int query_autoload()
{ 
      return 1;
}
