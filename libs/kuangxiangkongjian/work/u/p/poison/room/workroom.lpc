// Room: /u/l/lum/workroom.c
inherit ROOM;

void create() {
  set("short", "欧阳锋之家");
  set("long", @LONG
这是一间船舰改造而成的房间，大厅上摆了一张桌子，桌上摆了许多化学实验药剂。
地上铺着波斯来的地毯，你用力踏了几下，质感不错，墙上挂了许多的篮球签名海报和麦
可杰克森的海报。你仔细看了一下发现墙上有一部大萤幕(message)上面写了一些东西。
LONG);

  set("exits", ([ /* sizeof() == 7 */
    "lum": "/u/l/lum/workroom.lpc",
    "apple": "/u/p/poison/room/w.lpc",
    "lys": "/u/l/lys/workroom.lpc",
    "wiz": "/open/wiz/hall1",
    "wade": "/u/w/wade/workroom.lpc",
    "ouch": "/u/o/ouch/workroom.lpc",
    "moon": "/open/dancer/room/start.lpc",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "message": "萤幕上写着：欢迎使用西毒传送间，以下是各传送点，祝使用愉快。
            １．京城　　　　２．蜀城　　　　３．平南城
　　　　　　４．译站　　　　５．凌云村　　　６．金刀门
",
  ]));
  set("light_up", 1);
  set("valid_startroom", 1);

  setup();
}
void init() {
  add_action("do_waveto", "waveto");
}

int do_waveto(string arg) {
  int money, no_transmit;
  object me;
  string startroom;
  me = this_player();
  no_transmit = environment(me)->query("no_transmit", 1);
  if (no_transmit) {
    write("突然一阵能量从地底发出,击散了你招来的云朵,\n");
    write("似乎这里的大神不愿此地可以传送...\n");
    return 1;
  }
  money = me->query("bank/coin");
  if (money < 1000) {
    write("[1;31m 西毒房间的萤幕写着：老兄你银行的钱不够啦！！[0m\n");
    return 1;
  }
  message_vision("[1;34m[1;35m只见天上降下一只神兽把$N驮走了。[0m\n", me);
  switch (arg) {
    case "1":
      me->move("/u/p/poison/room/w.lpc");
      break;
    case "2":
      me->move("/u/l/lum/workroom.lpc");
      break;
    case "3":
      me->move("/open/ping/room/road4");
      break;
    case "4":
      me->move("/open/center/room/inn");
      break;
    case "5":
      me->move("/open/start/room/s5");
      break;
    case "6":
      me->move("/open/gblade/room/gblade.lpc");
      break;
    case "7":
      me->move("/open/gsword/room/g5-1.lpc");
      break;
    case "8":
      me->move("/open/common/room/inn.lpc");
      break;
    case "9":
      me->move("/open/snow/room/room2.lpc");
      break;
    case "10":
      me->move("/u/k/konn/workroom.lpc");
      break;

      if (!startroom) {
        write(" [1;31m西毒房间的萤幕写着：无此地点。[0m\n");
        return 1;
      }
      me->move(startroom);
      break;
    default:
      write(" [1;31m西毒房间的萤幕写着：无此地点。[0m\n");
      return 1;
  }
  money = money - 1000;
  me->set("bank/coin", money);
  message_vision("[1;35m[1;36m一阵呼啸后，神兽从天空慢慢的降了下来，$N从上面跳下。[0m\n", me);
  write(" [1;31m西毒房间的萤幕传来一阵讯息：谢谢拉！下次再来！！[0m\n");
  return 1;
}
