void init()
{
    add_action("do_ponder","ponder");
    add_action("do_sea","sea");
}

int do_ponder(string str)
{
    object me =this_player();
        if(me->query("id")=="kazuya")
          {
           me->move(__DIR__"room/k7");
           return 1 ;
          }
}

int do_sea(string str)
{
    object me =this_player();
    me->move(__DIR__"room/beach");
    return 1;
}                 
