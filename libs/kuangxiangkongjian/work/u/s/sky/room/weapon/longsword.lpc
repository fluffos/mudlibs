#include <ansi.h>
inherit NPC;

void create()
{
        set_name("雪缘", ({ "fairy" }) );
        set("nickname", HIM "星尘之妻" NOR );
        set("gender", "女性");
        set("age", 19);
        set("long", HIW "她是星尘的妻子..长的清丽脱俗,不食人间烟火!!\n"
            "然而却喜欢星尘用舌头舔她的阴户,也喜欢星尘用大阴茎插她的阴户!!\n"NOR);
        set("str", 24);
        set("cor", 26);
        set("int", 29);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        setup();
        set("chat_chance", 80);
        set("chat_msg", ({
        YEL "喔喔.....星尘...你干的我..好爽...嗯嗯....\n"NOR,
        HIM "啊啊...小穴里都是..淫水了...噢噢....\n"NOR,
        HIM "喔喔..阿尘...你舔我的穴...啊啊...淫水快流光了.......舔的我好乐...嗯嗯嗯.......唔....\n"NOR,
        YEL "啊啊....星尘!!我快泄了!!小穴好烫....嗯嗯...啊啊啊..出来了.."NOR,
    }));
             
        set("combat_exp", 1000000);
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
        HIY "雪缘突然含住你的肉棒, 并以灵巧的舌头缓缓舔动着~~你的龟头...啊!感觉真好!!\n",
        HIY "雪缘跪趴在地上,把又湿又滑的小淫穴对着你, 并用极为诱人的语调, 要求你狠狠的干她!!!\n",
    }));
        set_temp("apply/attack", 1);
        set_temp("armor", 300000);
        setup();
}
}

