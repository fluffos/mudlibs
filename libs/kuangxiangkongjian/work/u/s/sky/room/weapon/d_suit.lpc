//d_suit.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name( HIY "镶金边龙纹衣" NOR, ({"dragon suit","suit","cloth"}));
        set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
set("material", "crismonsteel");
        set("armor_prop/armor",30000);
	}
	setup();
}
