//rulai.c
inherit SKILL;

#include <ansi.h>

mapping *action = ({
        ([      "action":               "$N使出一招‘佛光初现’，气凝于掌，缓缓推出，击向$n的$l",
                "dodge":             -10,
                "parry":              30,
                "force":            1300,
                "damage":           3000,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               "$N使出一招‘金顶佛灯’，$N双掌突然化为无数掌影，笼罩住$n",
                "dodge":             -10,
                "parry":             -10,
                "force":            1600,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N使出‘迎佛西来’，双掌上提，一股强大气劲袭向$n的$l",
                "dodge":             -10,
                "parry":              40,
                "force":            3000,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N大喝一声,使出‘佛问迦逻’，无形声波化为实劲，击向$n的$l",
                "dodge":              10,
                "parry":             -30,
                "force":            5000,
                "damage":           5000,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N气凝于渊，使出‘佛光普照’，$N真气向四方暴射，双掌推出，击向$n的$l",
                "dodge":             -20,
                "parry":             -30,
                "force":            5000,
                "damage":           8000,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N使出‘佛光万丈’，一声长啸，强大的真气袭向四周!!!",
                "dodge":             -70,
                "parry":             -10,
                "damage":           8000,
                "weapon":       "$N真气",
                "damage_type":  "刺伤"
        ]),
        ([      "action": "$N气贯双臂，气度恢宏，使出‘佛动山河’，排山倒海的掌劲，击向$n$l",
                "parry":             -40,
                "force":           18000,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N席地而坐，双眼微闭双掌朝天高举，使出‘万佛朝宗’，一股莫名气劲如万马奔腾般袭向$n!!",
                "parry":             -10,
                "dodge":              10,
                "force":           80000,
                "damage":          12000,
                "damage_type":  "瘀伤"
         ]),
        ([      "action": "[1;34m霎时风云变色，飞砂走石! $N使出如来神掌第九式‘[1;33m□[0;33m□[1;33m□[0;33mk[1;33m□[0;33mL[1;33m□[0;33m□[1;34m’，$N幻化出无数个身影, 挟着毁天灭地的气势 \n
                           方圆十里之内生灵尽为之涂炭!!!!",
                "parry":             -10,
                "dodge":             -10,
                "force":          100000,
                "damage":         100000,
                "damage_type":   "瘀伤"
         ]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练如来神掌要空手!\n");
        return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{
int skill_level, limit;
        skill_level=(int)me->query_skill("rulai", 1);
        limit=(int)skill_level/10;
        if (limit < 4 )
                return action[random(3)];
        if (limit < 6 )
                return action[random(limit)];
        else if (limit > 6)
                return action[random(7)];
        else if (limit > 9)
                return action[random(9)];
        else
                return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 5 )
                return notify_fail("你的内力不够了，休息一下再练吧。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        return 1;
}
