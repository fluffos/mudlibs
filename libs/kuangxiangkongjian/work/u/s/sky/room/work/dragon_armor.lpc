#include <armor.h>

inherit ARMOR;

void create() {
  set_name("[1;34m青龙鳞甲[0m", ({ "dragon armor", "armor" }));
  set_weight(10000);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "此龙甲是从千年青龙妖身上拔鳞制成, 穿上此甲便可刀枪不入, 无所披靡。\n");
    set("material", "gold");
    set("value", 20000);
    set("armor_prop/armor", 100);
  }
  setup();
}
