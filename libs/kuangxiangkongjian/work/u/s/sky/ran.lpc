
// ran.c
 
inherit NPC;
#include <ansi.h>

mapping *action = ({
        ([      "action":               "$N忽然冲向$n，一爪抓向$n的$l",
                "force":            1000,
                "damage":            100,
                "damage_type":  "抓伤"
        ]),
        ([      "action":               "$N高高跃起，以极快的动作，踢向$n的$l",
                "force":            1600,
                "damage":            100,
                "damage_type":  "瘀伤"
        ]),
});

void do_special();
void create()
{
        set_name("[1;33m□[0;33mp[1;33m□[0;33mI[0m", ({ "ran chen","ran", "chen" }) );
        set("title","魔界之王");
        set("nickname", "斗神");
        set("gender", "男性");
        set("age", 30);
        set("attitude", "peaceful");
        set("long", @LONG
    雷禅是属于魔界生物中吃人鬼之一，但不知为了何故却不再以人为
粮食。即经过了长时间的挨饿～使其战斗力大为下降！  但即使如此，
他还是有着能称霸魔界的强大实力！！
LONG);

        set("kee",20000);
        set("max_kee",20000);
        set("str", 40);
        set("cps", 60);
        set("per", 34);
        set("int", 50);
        set("kar", 16);
        set("con", 50);
        set("combat_exp"  , 3000000);
        set("force"       , 9000);
        set("max_force"   , 9000);
        set("force_factor", 10);
        set("score"       , 500000);
 
 
        set("inquiry",([
                 "幽助":   "嗯．．是个不错的孩子!!唉．．．．\n",
                 "冥界":   "唉．．．要不是我吃素的话！哪容得其他两个嚣张！！\n",
          ]));
 
        set_skill("move",120);
        set_skill("unarmed", 120);
        set_skill("force", 150);
        set_skill("parry", 150);
        set_skill("dodge", 200);

        set("chat_chance",10);
        set("chat_msg",({
 
          "雷禅满脸愁苦的叹道: 好饿啊～～～～\n",
          "雷禅叹道: 食物～～我要～～～～\n",
        }));
 
        set("chat_chance_combat",50);

        set("chat_msg_combat",({
        (: do_special :)

        }));
        setup();
        add_money("gold", 800);
}


void do_special()
  {
    object *enemy,target;
    int i;
    int j;

        enemy=this_object()->query_enemy();
        i=sizeof(enemy);
        target=enemy[random(i)];
        j=random(10);

          if ( j<=4 )
              {
                message_vision(
                "[\n雷禅倏地双掌击地，大喝一声[1;33m□□[5;33m‘金刚仁王震’[0;1;33m□□[0m!!! \n[0m",target);
                message_vision(
                "\n突然间!! 山崩地裂!! $N 感到[1;31m五脏六腑都翻了过来[0m!!!\n",target);
                target->receive_wound("kee",random(100+50));
                COMBAT_D->report_status(target);
               }
           else
               {
                message_vision(
                "[\n雷禅五指往上一托$N，暴喝[1;31m□□[5;32m‘金刚风神击’[0;1;31m□□[0m\n[0m",target);
                message_vision(
                "\n霎时! 一道[1;35m巨大而恐怖的龙卷风[0m紧紧的包围住$N [0m!!将$N送上了高空!!\n",target);
                target->receive_wound("kee",random(50+10));
                COMBAT_D->report_status(target);
               }
}
