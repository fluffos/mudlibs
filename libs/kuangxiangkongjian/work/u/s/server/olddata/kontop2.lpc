// Room: /open/su/room/kontop.c

inherit ROOM;

void create() {
  set("short", "了望台");
  set("long", @LONG
	蜀中城是座依着山所建筑的城市，城四周时常围绕
	着薄薄的云雾，更为他添增了许多神秘的色彩，北
	方的市集是城中最热闹的地方，密密麻麻的人群有
	如蚂蚁般的乱窜，东北方武馆的广场上正有人再练功
	，也看到蜀中城有许多人正在努力的工作，也有许
	多无事压压道路的闲者，总归人生百态，端看个人
	对生命如何的定义了。
	这里可以把恐庙的全貌看得很清楚，只要打开窗户
	(window)看外面(outside)就行了。

LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "kon4f_6",
  ]));

  set("item_desc", ([
    "window": "一扇普通的窗户，打开它你就可以看恐庙的全貌。\n",
  ]));
  setup();
}
void init() {
  add_action("do_open", "open");
  add_action("do_look", "mlook");
}
int do_open(string arg) {
  if (!arg || arg != "window")
    return notify_fail("你要打开什么？\n");

  this_player()->set_temp("win_open", 1);
  tell_object(this_player(), "你把窗户打开了。");
  return 1;
}

int do_look(string str) {
  if (!str)
    return notify_fail("你想要看什么? \n");
  if (str != "outside")
    return notify_fail("你在看哪里？\n");
  if (this_player()->query_temp("win_open") != 1)
    return notify_fail("你还没把窗户打开！\n");
  if (this_player()->query("kon2f_3") != 1)
    return notify_fail("嗯！恐庙的建筑的确很壮观！\n");

  tell_object(this_player(), "你细心的观察着恐庙的景物，心中反覆的思索着恐庙\n这奇特的格局");
  call_out("do_look2", 90);

  return 1;
}
int do_look2(string str) {
  tell_object(this_player(), "\n啊！这就是恐英雄的第九部阵法‘九宝连灯’。\n");
  return 1;
};
