// map1 (1,1) 
#include <config.h> 
#include <mudlib.h> 
#include <path.h> 

#define TEST "/u/s/server/"
void create(object ob) 
{
  if (!ob) return; 
  ob->set("light",1);
  ob->set("short","空房间\n");
  ob->set("long",@ENDtext
空房间
这是用程式大量制造的空房间。
ENDtext
);
  ob->set("exits", ([
  "east" : TEST+"map1" ,
  ])); 
 ob->reset(); 
}; 
