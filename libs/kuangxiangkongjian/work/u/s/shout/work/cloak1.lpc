// mask.c

inherit EQUIP;

void create() {
  set_name("隐身披风", ({ "cloak" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 600);
    set("material", "steel");
    set("armor_type", "cloak");
    set("armor_prop/id", ({ "wade" }));
    set("armor_prop/name", ({ "" }));
    set("armor_prop/short", ({ "" }));
  }
  set("no_drop", 1);
  set("no_sell", 1);
  setup();

}

int query_autoload() {
  return 1;
}
