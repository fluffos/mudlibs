// smob2.c by shout ,mob1.c by konn

#include <ansi.h>
inherit NPC;

int kill_him(object);

void create() {
  set("title", "魔界五鬼");
  set_name("木魑", ({ "wood ghost," ghost "}));
        set(" long ",
            " \ n 它 在 五 鬼 当 中, 排 行 老 二, 功 夫 仅 次 于 五 鬼 之 首 。 相 传 它 是
    由 魔 界 森 林 所 有 木 妖 的 邪 恶 精 气 所 形, 自 然 比 一 般 的 小 妖
    更 加 邪 恶 。 \ n ");
        
        set(" age ",2900);
//        set(" race "," 妖 怪 ");
        set(" race "," 野 兽 ");
        set(" gender "," 雄 性 ");
        set(" attitude "," friendly ");
        set(" max_gin ",580);
        set(" max_kee ",2800);
        set(" max_sen ",180);
        set(" max_force ",1800);
        set(" force_factor ",9);
        set(" combat_exp ",1900000);

        set_temp(" apply / attack ",190);
        set_temp(" apply / damage ",190);
        set_temp(" apply / dodge ",190);
        set_temp(" apply / move ",190);
        set_temp(" apply / armor ",190);

        set_skill(" unarmed ",90);
        set_skill(" dodge ",90);
        set_skill(" move ",90);
        set_skill(" parry ",90);

        set(" limbs ",({" 头 部 "," 胸 部 "," 大 黑 手 "," 大 黑 脚 "," 背 部 "," 腰 部 "}));
        set(" verbs ",({" bite "," claw "}));

        set(" chat_chance_combat ",30);
        set(" chat_msg_combat ",({
            HIW" \ n 木 魑 的 双 手 已 缠 绕 住 你 的 身 体 ... \ n \ n "NOR,
            HIW" \ n 你 发 觉 你 的 身 体 渐 渐 僵 化 了 ... \ n \ n "NOR
      }));

        setup();
 }

void init() {
        object obj;

        ::init();
        if(interactive(obj=this_player()) && !is_fighting()) {
           remove_call_out(" kill_him ");
           call_out(" kill_him ",0,obj);
        }
 }

int kill_him(object obj) {
//        if(obj->query(" race ") == " 妖 怪 ") return 1;
        if(obj->query(" race ") == " 野 兽 ") return 1;
        if(obj->query(" max_force ") > 999 ||
           obj->query(" combat_exp ") > 299999)
           command(" kill "+obj->query(" id "));
        return 1;
 }
