// smob2.c by shout ,mob1.c by konn

#include <ansi.h>
inherit NPC;

int kill_him(object);

void create() {
        set("title","魔界五鬼");
        set_name("木魑",({"wood ghost","ghost"}));
        set("long",
            "\n它在五鬼当中排行老二,妖力也仅次于五鬼之首;相传它是
             \n由魔界森林所有木妖的邪恶精气所形,自然比一般的小妖
             \n更加邪恶。\n");
        
        set("age",5500);
//        set("race","妖怪");
        set("race","野兽");
        set("gender","雄性");
        set("attitude","friendly");
        set("max_gin",1000);
        set("max_kee",1000);
        set("max_sen",1000);
        set("max_force",1800);
        set("force_factor",9);
        set("combat_exp",99999999);
        set_temp("apply/attack",200);
        set_temp("apply/damage",200);
        set_temp("apply/dodge",200);
        set_temp("apply/move",200);
        set_temp("apply/armor",200);

        set_skill("unarmed",100);
        set_skill("dodge",200);
        set_skill("move",200);
        set_skill("parry",200);

        set("limbs",({"头部","胸部","大黑手","大黑脚","背部","腰部"}));
        set("verbs",({"bite","claw"}));

        set("chat_chance_combat",30);
        set("chat_msg_combat",({
            HIW"\n      木魑的双手已缠绕住你的身体...\n\n"NOR,
            HIY"\n          你发觉你的身体渐渐僵化了...\n\n"NOR
      }));

        setup();
 }

void init() {
        object obj;

        ::init();
        if(interactive(obj=this_player()) && !is_fighting()) {
           remove_call_out("kill_him");
           call_out("kill_him",0,obj);
        }
 }

int kill_him(object obj) {
//        if(obj->query("race") == "妖怪") return 1;
        if(obj->query("race") == "野兽") return 1;
        if(obj->query("max_force") > 999 ||
           obj->query("combat_exp") > 299999)
           command("kill "+obj->query("id"));
        return 1;
 }
