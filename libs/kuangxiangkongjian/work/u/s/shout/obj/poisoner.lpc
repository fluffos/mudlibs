
// change.c 神奇转换器   source from lopo

#include <ansi.h>

inherit ITEM;

void create()
 {
   set_name("神奇转换器",({"change"}) );
   set_weight(100);
   set("unit","个");
   set("long","这是一个用来改变你一生的机器");
   set("value",100000);

   setup();
 }

void init()
 {
   add_action("push_doing","push");
 }

int push_doing(string arg)
 {
   if(arg != "down")  return 0;

   write("$N按下了神奇转换器，觉得似乎换了新面孔。\n",this_player());

   this_player()->set("class","poisoner");
   this_player()->set("gender","男性");
        set_skill("move",100);                              set_skill("move",100);                              set_skill("move",100);                                 set_skill("move",100);
        set_skill("force",40);                              set_skill("force",40);                              set_skill("force",40);                                 set_skill("force",40);
        set_skill("dodge",100);                             set_skill("dodge",100);                             set_skill("dodge",100);                                set_skill("dodge",100);
        set_skill("parry",60);                              set_skill("parry",60);                              set_skill("parry",60);                                 set_skill("parry",60);
        set_skill("poison",100);                            set_skill("poison",100);                            set_skill("poison",100);                               set_skill("poison",100);
        set_skill("unarmed",40);                            set_skill("unarmed",40);                            set_skill("unarmed",40);                               set_skill("unarmed",40);
        set_skill("whip",60);                               set_skill("whip",60);                               set_skill("whip",60);                                  set_skill("whip",60);
        set_skill("poisonforce",60);                        set_skill("poisonforce",60);                        set_skill("poisonforce",60);                           set_skill("poisonforce",60);
        map_skill("force","poisonforce");                   map_skill("force","poisonforce");                   map_skill("force","poisonforce");                      map_skill("force","poisonforce");
        set("force_factor",10);                             set("force_factor",10);                             set("force_factor",10);                                set("force_factor",10);
        set_skill("coldpoison",100);                        set_skill("coldpoison",100);                        set_skill("coldpoison",100);                           set_skill("coldpoison",100);
        set_skill("nine-steps",100);                        set_skill("nine-steps",100);                        set_skill("nine-steps",100);                           set_skill("nine-steps",100);
        map_skill("dodge","nine-steps");                    map_skill("dodge","nine-steps");                    map_skill("dodge","nine-steps");                       map_skill("dodge","nine-steps");
        set("chat_chance_combat",60);                       set("chat_chance_combat",60);                       set("chat_chance_combat",60);                          set("chat_chance_combat",60);
        set("chat_msg_combat",({                            set("chat_msg_combat",({                            set("chat_msg_combat",({                               set("chat_msg_combat",({
                (: perform_action,"poison.five" :)                  (: perform_action,"poison.five" :)                  (: perform_action,"poison.five" :)  //                 (: perform_action,"poison.five" :)
        }));                                                }));                                                }));                                        //         }));
        map_skill("move","nine-steps");                     map_skill("move","nine-steps");                     map_skill("move","nine-steps");             //         map_skill("move","nine-steps");
        map_skill("poison","coldpoison");                   map_skill("poison","coldpoison");                   map_skill("poison","coldpoison");           //         map_skill("poison","coldpoison");
  destruct(this_object());
   return 1;
}
