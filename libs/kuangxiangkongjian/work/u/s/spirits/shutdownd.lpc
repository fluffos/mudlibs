#include <mudlib.h>
#include <net/daemons.h>
#pragma save_binary
inherit "/adm/daemons/timezone";
// inherit DAEMON ;

#define log( x )
//#define EMOTE_FILE "/adm/daemons/shutdown_msg"
#define EMOTE_FILE "/adm/etc/shutdown_msg"

string *emotes;
int num_emot; // the number of emotes
int s_sec; //	The time() the shutdown is due at, in seconds.

int query_shutdown() { return s_sec; }
mixed query_emotes() { return emotes; }

void
save_daemons()
{
   object *user;
   int i;
   EMOTE_D->save_data();
   CMWHO_D->halt();
   DNS_MASTER->send_shutdown();
///由于shutdown会保留eq..so...加下面这两行...Noz
   //users()->command("unsecure all");
  // users()->command("drop all");
 users()->save_data();
 //  users()->save_userdata();
      users()->quit();
}

void
do_shutdown(int how)
{

//   if( geteuid( previous_object() ) != ROOT_UID ) return;
   save_daemons();
   shutdown(how);
   call_out("do_shutdown",5,how);  // add by Ges
}

void count_down(int how);

varargs
int start_shutdown( int how, int delay )
{
//  if( geteuid( previous_object() ) != ROOT_UID ) return s_sec;
  if( delay < 0 ) return s_sec;
//  if( this_player() )
//   message("shutdown", (string)this_player()->query("chi_name") +HIW+ 
	//   "竭力嘶吼: 神猪大陆快沉没海底了,大家准备逃命吧。\n"+NOR,users());
   shout("啦啦啦");


  if( !delay )
  {
    do_shutdown( how );
    return time();
  }
  // if there is another shutdown on the way then cancel it
  if(s_sec)
    remove_call_out("count_down");

  s_sec = time() + ( delay * 60 );
  count_down( how );

  return s_sec;
}
string get_emote( int delay )
{
  if( !emotes )
  {
    emotes = explode( read_file( EMOTE_FILE ), "###\n" );
    num_emot = sizeof( emotes ) - 1;
  }
  if( delay < num_emot ) return emotes[(num_emot-delay)];
  return 0; // No message except the time until shutdown, done by count_down()
}

void count_down( int how )
{
  int delay;
  string msg;
 // if( geteuid( previous_object() ) != ROOT_UID ) return;
  delay = ( s_sec - time() ) / 60;
  if( msg = get_emote( delay ) )
//    message( "shutdown", msg, users() );
    shout(msg);
  
  if( delay ) 
shout("啦啦" + delay + "啦啦拉\n");
//message( "shutdown",
  //  "这个Mud将在 " + delay + " 分钟后关掉。\n", users() );

  if( delay < 1 )
  {
    do_shutdown( how );
    return;
  }

  call_out( "count_down", 60, how );

}

int stop_shutdown()
{
  if( geteuid( previous_object() ) != ROOT_UID ) return 0;
  s_sec = 0;
  remove_call_out( "count_down" );
  if( this_player() )
     shout("解除\n",users());
 
//message("shutdown", "巨大的 " + this_player()->query("chi_name") +
	    //"很幸运的拯救了这个世界。\n", users());
// Blessed are the peacemakers, for they shall save your hard won kit.
  return 1;
}
