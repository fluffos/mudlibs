inherit EQUIP;
object user;
string *emote;
object *inv;
int size_of_emote;

void create() {
  set_name("面罩", ({ "mask" }));
  set("long", @LONG

         这是一张具有魔法的面罩，可以让感情自由奔放，

LONG);
  set("weight", 50);
  set("unit", "张");
  set("material", "wood");
  set("value", 10);
  set("armor_type", "mask");
  set("armor_prop/armor", 0);
  set("no_drop", 1);
  set("no_sell", 1);
  setup();
}

void init() {
  emote = sort_array(EMOTE_D->query_all_emote(), 1);
  size_of_emote = sizeof(emote);

  add_action("do_wear", "wear");
  add_action("do_remove", "remove");
  add_action("do_pawn", "pawn");
  add_action("do_pawn", "sell");
  add_action("do_pawn", "auction");
  add_action("do_pawn", "auc");
}

int do_wear() {
  ::wear();
  if (query("equipped")) {
    user = this_player();
    message_vision("$N戴上了面具，感觉百感交集。\n", user);
    set_heart_beat(1);
  }
}

int do_remove(string arg) {
  if (arg == "mask") {
    write("糟糕！面罩已在你脸上生根，无法取下。\n");
    return 1;
  };
  if (arg == "all") return 1;
  return 0;
}

int do_pawn(string arg) {
  if (arg == "mask") {
    write("想卖掉面具?...嘿嘿......门都没有!!\n");
    return 1;
  }
  return 0;
}

