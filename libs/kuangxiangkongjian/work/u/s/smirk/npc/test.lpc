inherit NPC;

void create() {
  set_name("随缘的测试员", ({ "test man", "man" }));


  set("gender", "男性");
  set("age", 22);
  set("str", 23);
  set("cor", 20);
  set("cps", 20);


  set("max_force", 2000);
  set("force", 2000);
  set_skill("sword", 40);
  set_skill("shasword", 70);
  map_skill("sword", "shasword");
  set_skill("dodge", 50);
  set_skill("sha-steps", 70);
  set_skill("shaforce", 60);
  set_skill("parry", 60);
  map_skill("dodge", "sha-steps");
  map_skill("parry", "shasword");
  map_skill("force", "shaforce");
  map_skill("move", "sha-steps");
  set_skill("unarmed", 25);
  set("combat_exp", 30000);


  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "测试员喊道 : 去死!! \n",
    "测试员喊道: 可怜的mob!! \n",
  }));

  set_skill("move", 40);

  set("force_factor", 10);
  setup();

  carry_object("/open/snow/obj/etsword")->wield();
  carry_object("/open/gsword/obj/boots")->wear();
  carry_object("/open/center/obj/belt1")->wear();
  carry_object("/open/center/obj/cloth2")->wear();
  carry_object("/open/start/obj/thunder_hat")->wear();
}
