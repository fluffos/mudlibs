//made by smirk
#include <ansi.h>

inherit NPC;

void create(){
        set_name("绘画师傅",({"painting man","man"}) );
        set("gender","男性");
        set("age",33);
        set("long",@LONG
        一位技艺纯熟的师傅,他所画的作品深受大众的喜爱,就连宫中的达官显贵也十
        分珍重他的作品。 \n
LONG);
        set("combat_exp",25000);
        set("attitude","friendly");
        set("str",21);
        set("int",30);
        set("per",25);
	set("cps",28);
	set("spi",30);
        set_skill("dodge",40);
        set_skill("parry",40);
        set("chat_chance",20);
        set("chat_msg",({
        "绘画师傅说道:京里真是热闹啊，到处都是人来人往的。\n",
        "绘画师傅说道:要不要买幅画啊，这幅我所珍藏的名画不错哟!!\n",
        "绘画师傅说道:卖画的人总希望能遇上懂画爱画的人\n",
                (: random_move :)
        }) );
        set_temp("apply/armor",10);
          set("inquiry", ([
          "thief" : "你是说那个最近在皇城恶名昭彰的大盗是吧?!可惜我连影子都没看□
L,一定是位高人,能够飞檐走壁说!!",
          "painting"  : "你想买画是吧!!那要准备点金子喔!!",
          "珍藏": (: call_treasure :),
          ]) );
setup();
        carry_object("/open/capital/obj/")->wield();
        carry_object("/obj/")->wear();
        carry_object("/open/capital/obj/")->wear();
        add_money("/obj/money/gold",30);
}

string call_treasure
{
	object ob = this_object();
	object me = this_player();
	if( !ob->query_temp("call_treasure") )
	{
	  ob->set_temp("call_treasure",1);
	message_vision("绘画师傅说道:这可是我呕心沥血所完成的作品，价值是500金\n
			除了价值外，也希望你能永远珍藏它。\n");
	  call_out("call_treasure_1",3);
	  return(RANK_D->query_respect(me)+"你等等，我马上就拿给你!!\n");
	}
	else
	{
	  return("好画总是不寂寞的，你看过后不久就被人买走了!!");
	}

string call_treasure_1
{
	object ob = this_object();
	object me = this_player();
	tell_room(environment(ob),"绘画师傅从身后的袋中取出一个画框....\n");
	tell_room(environment(ob),"一幅栩栩如生,唯妙唯肖的仕女图呈现在你面前,你不禁看呆了......\n");
	new("/open/capital/obj/painting")->move(who);
}
 
