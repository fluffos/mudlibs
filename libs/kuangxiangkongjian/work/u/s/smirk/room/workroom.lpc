// Room: /u/o/oda/room/workroom.c

inherit ROOM;

void create() {
  set("short", "随缘的小房间");
  set("long", @LONG
这里是一间小小的寝室,一张小小而温暖的床,一盏柔和的桌灯,一台精致的音响,
几件小小的装饰品,精简的组成了这间可爱的小窝,小木桌上散布着几本漫画和武
侠小说,随缘小朋友最喜欢在这里调剂心情了！！

LONG);

  set("exits", ([ /* sizeof() == 5 */
    "south": "/u/s/smirk/room/palace.lpc",
    "north": "/open/capital/room/king/kr5-4",
    "down": "/open/wiz/entrance",
    "west": "/u/s/smirk/room/testroom",
    "east": "/u/s/smirk/room/transdoor",
  ]));
  set("light_up", 1);

  set("objects", ([ /* sizeof() == 1 */
    "/open/start/obj/beck": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_waveto", "waveto");
}

int do_waveto(string arg) {
  int money, no_transmit;
  object me;
  string startroom;
  me = this_player();
  no_transmit = environment(me)->query("no_transmit", 1);
  if (no_transmit) {
    write("突然一阵能量从地底发出,击散了你招来的云朵,\n");
    write("似乎这里的大神不愿此地可以传送...\n");
    return 1;
  }
  money = me->query("bank/coin");
  if (money < 1000) {
    write("[1;31m 传送房得营幕上显示：老兄你不够钱啦！！□[0;37m\n");
    return 1;
  }
  message_vision("[1;34m[1;35m只见天上降下一只神兽把$N驮走了。[0m\n", me);
  switch (arg) {
    case "1":
      me->move("/open/capital/room/r70");
      break;
    case "2":
      me->move("/open/gsword/room/su3");
      break;
    case "3":
      me->move("/open/ping/room/road4");
      break;
    case "4":
      me->move("/open/center/room/inn");
      break;
    case "5":
      me->move("/open/start/room/s5");
      break;
    case "6":
      me->move("/open/port/room/r3-1");
      break;
    case "7":
      me->move("/open/gsword/room/g5-1.lpc");
      break;
      if (!startroom) {
        write(" 唤云扇说: 无此地点...\n");
        return 1;
      }
      me->move(startroom);
      break;
    default:
      write(" 唤云扇说: 无此地点...\n");
      return 1;
  }
  money = money - 1000;
  me->set("bank/coin", money);
  message_vision("[1;36m一阵呼啸后，神兽从天空慢慢的降了下来，$N从上面跳下。[0m\n", me);
  write(" [1;31m传送间传来一阵讯息：谢谢啦！下次在来！！[0m\n");
  return 1;
}
