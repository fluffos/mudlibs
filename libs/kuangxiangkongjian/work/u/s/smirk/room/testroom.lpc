// Room: /u/o/oda/room/test.c

inherit ROOM;

void create()
{
	set("short", "缘测试房");
	set("long", @LONG
这是一间什么也没有的空房间。
LONG
	);

	set("objects", ([ /* sizeof()== 1 */
	"/u/s/smirk/npc/test.lpc" : 1,
	]) );
	set("exits", ([ /* sizeof() == 0 */
]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_test", "test");
}

int do_test()
{
	object who, guard;
	who = this_player();
	guard = present("guard",this_object());
	if(guard) {
		guard->command("smile");
		guard->kill_ob(who);
		return 1;
	}
	return notify_fail("no guard!\n");
}

