
#include <ansi.h>
#include <armor.h>
inherit NECK;

object user;

void create()
{
  set_name( HIC+"子弹护身符"+NOR ,({"bullet amulet","amulet","bullet"}));
  set_weight(500);
  if( clonep() ) 
    set_default_object(__FILE__);
  else 
  {
    set("long",@LONG
    这是「杀手”米克送给阿香的纪念礼物。一般猎人们在首次狩猎成功后，常会把第
一颗打中猎物的子弹制成护身符戴在胸前。因为他们相信这个幸运的子弹将会带给他们
好运，并保护他们在狩猎中不会受伤。
LONG);    
    set("unit", "个");             
    set("value",5000000);
    set("material","steel");
    set("armor_prop/armor",5);
    set("armor_prop/dodge",10);
  }         
  setup();
}

void init()
{
  if (this_player()==environment(this_object()))
  {
     add_action("do_drop","drop"); 
     add_action("do_auc","auc"); 
     add_action("do_wear","wear");
     add_action("do_give","give");
     add_action("do_remove","remove");
     add_action("do_sell","sell");
     user=this_player();
  } 
}

int do_wear(string str)
{ 
  object ob,this;
  string des,des1,des2;
  if(!str) return 0;
  this=this_object();
  if( str != "all")
  {
    if( !objectp(ob = present(str, user)) )
       return notify_fail("你身上没有这样东西。\n");
    if(this != ob) return 0;
  }
  if( !(user->query_temp("bullet_amulet")) && user == environment(this) ) 
  {
    user->set_temp("bullet_amulet",this);
    set_heart_beat(1);
  } 
  return 0;
}

int do_drop(string str)
{  
  object ob,this;
  string des,des1,des2;
  if(!str) return 0;
  this=this_object();
  if(  str != "all")
  {
    if( !objectp(ob = present(str, user)) )
       return notify_fail("你身上没有这样东西。\n");
    if(this != ob) return 0;
  }
  if( this==user->query_temp("bullet_amulet") && !(this->query_temp("secured")))
  {
    user->delete_temp("bullet_amulet");
    set_heart_beat(0);
  }    
  return 0;
}    

int do_sell(string str)
{  
  object ob,this;
  string des,des1,des2;
  if(!str) return 0;
  this=this_object();
  if( str != "all")
  {
    if( !objectp(ob = present(str, user)) )
       return notify_fail("你身上没有这样东西。\n");
    if(this != ob) return 0;
  }
  if( this==user->query_temp("bullet_amulet") && !(this->query_temp("secured")) )
  {
    user->delete_temp("bullet_amulet");
    set_heart_beat(0);
  }    
  return 0;
}    

int do_give(string str)
{  
  object ob,this;
  string des,des1,des2;
  string item,ppl;
  if(!str) return 0;
  this=this_object();
  if( sscanf(str, "%s to %s", item, ppl)==2
     || sscanf(str, "%s %s", ppl, item)==2 );
  if( !item || !objectp(ob = present(item, user)) )
     return notify_fail("你身上没有这样东西。\n");
  if(this != ob) return 0;
  if( this==user->query_temp("bullet_amulet") && !(this->query_temp("secured")) )
  {
    user->delete_temp("bullet_amulet");
    set_heart_beat(0);
  }
  return 0;
}

int do_remove(string str)
{
  object ob,this;
  string des,des1,des2;
  if(!str) return 0;  
  this=this_object();
  if( str != "all")
  {
   if( !objectp(ob = present(str, user)) )
      return notify_fail("你身上没有这样东西。\n");
   if(this != ob) return 0;
  }
  if( this==user->query_temp("bullet_amulet") )
  {
    user->delete_temp("bullet_amulet");
    set_heart_beat(0);
  }
  return 0;
}                       


int do_auc(string str)
{
  object ob,this;
  string des,des1,des2;
  if(!str) return 0;
  this=this_object();
  if( !objectp(ob = present(str, user)) )
     return notify_fail("你身上没有这样东西。\n");
  if(this != ob) return 0;
  if( this==user->query_temp("bullet_amulet") )
  {
    user->delete_temp("bullet_amulet");
    set_heart_beat(0);
  } 
  return 0;
}
     

void heart_beat()
{
  int max,now,fce,nfc;
  if(!query("equipped") ) return;
  if(user->query_temp("ghost")) return;
  max = user->query("max_kee")+user->query("max_gin")+user->query("max_sen");
  now = user->query("kee")+user->query("gin")+user->query("sen");
  fce = (int)user->query("max_force");
  nfc = (int)user->query("force");
  if( max > now )
  {
    user->receive_curing("kee",(max-now));
    user->receive_heal("kee",(max-now));
    max = user->query("max_gin");
    user->set("eff_gin",max);
    user->set("gin",max);
    max = user->query("max_sen");
    user->set("eff_sen",max);
    user->set("sen",max);
    max = user->max_food_capacity();
    user->set("food",max);
    max = user->max_water_capacity();
    user->set("water",max);
    user->clear_condition();
    if (nfc < fce) user->set("force",fce);
    if (user->query_temp("unconcious")==1 && random(10) < 7) user->revive();
    tell_object(user,"\n不知什么力量使你的伤口神奇的愈合了。\n");
  }
}  

int query_autoload()
{
 if (user->query("id") == "cage") return 1;
  return 0;
}