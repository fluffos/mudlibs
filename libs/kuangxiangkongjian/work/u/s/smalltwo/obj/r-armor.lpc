#include <ansi.h>
#include <armor.h>
inherit EQUIP;
void create()
{
  set_name(HIR "赤炼甲" NOR,({"red armor","red","armor"}));
  set_weight(14000);
  set("gender_only","男性");
  if( clonep() )
     set_default_object(__FILE__);
  else {
     set("unit","套");
     set("armor_type","cloth");
     set("vaule",30000);
     set("material","blacksteel");
     set("armor_prop/armor",6);
     set("long","这是由百种蛊毒所浸泡而成的，据说为了试验蛊毒的毒性，曾牺牲数百条人命。\n");
       }
   setup();
}
