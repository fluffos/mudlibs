#include <weapon.h>
#include <ansi.h>
inherit STABBER;

void create()
{
  seteuid(getuid());
  set_name(HIW"雪芙蓉"NOR,({"oyuki's flower","flower"}));
  set("long",
  "这是阿雪的胸花,据说可以制造异次原空间?!?!\n");
  set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("unit","朵");
  set("value",0);
  set("material","gold");
  set("no_sell",1);
  set("no_drop",0);
  set("wield_msg","$N将"HIW"$n"NOR"轻轻配在胸上,更添几分娇艳\n");
  set("unwield_msg","$N拿下"HIW"$n"NOR",收进和服的袖子中\n");
}
  init_stabber(15);
  setup();
}
void init()
{
  add_action("go_go","gogo");
}

int query_autoload()
{
   return 1;
}

int go_go(string str)
 {
   object obj;
   object me;
   me=this_player();
  if(!str || str == "")
    {
      write(HIW"雪芙蓉无法带你到不存在的人身旁....\n");
      return 1;
    }
  message_vision(HIW"$N长袖一挥,一阵雪花从雪芙蓉中飘出,将$N身影没入于雪中\n"NOR,me);
   obj=find_living(str);
   me->move(environment(obj));
  message_vision(HIW"突然从天上落下阵阵晶莹雪花,而$N随之冉冉而降\n"NOR,me);
   return 1;
 }
