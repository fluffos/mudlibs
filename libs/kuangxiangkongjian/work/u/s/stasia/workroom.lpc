inherit ROOM;
 
void create()
{
      set("short","小雅的工作室" );
      set("long", @C_LONG
这里是小雅的工作室，一间长满了奇花异草的温室。四周飘散着大自然的香气
，柔和的阳光透过北边的窗户轻轻地洒在花草之间，你仿佛还听到潺潺的水流声和
一些不知名的鸟叫声。如果能在这仿佛世外桃源的地方小憩片刻，可能是人生最快
乐的事情了。
C_LONG
      );
      set("light_up",1);
      set("no_fight",1);
      set("no_magic",1);
      set("valid_startroom",1);
      set("exits",([
          "south" : "/u/s/stasia/transroom"
      ]));
      reset();
}
