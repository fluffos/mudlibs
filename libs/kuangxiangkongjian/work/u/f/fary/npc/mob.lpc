// dragon.c

inherit NPC;

void create()
{
     set_name("[1m白虎[0m",({"bifun"}));
        set("long",
   "牠是传说中的四大圣兽之一,排行老三,力量难以致信。\n");

         set("age",600);
        set("attitude", "friendly");

        set("max_gin", 4000);
        set("max_kee", 6000);
        set("max_sen", 3000);

        set("str", 170);
        set("cor", 150);
        set("cps", 100);
        set("spi", 70);
        set("int", 40);

        set("limbs", ({ "头部", "身体", "前爪", "后爪", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

        set_temp("apply/attack", 100);
        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 60);

        set("combat_exp", 1000000);
        setup();
   add_money("gold",10);
   add_money("silver",100);
   add_money("coin",1000);
}
