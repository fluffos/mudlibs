// Room: /open/tary/room/miroad5.c

inherit ROOM;
int done=0;

void create()
{

  seteuid(getuid());
        set("short", "青石大道");
        set("long", @LONG
  这里是桥头城的中央 ,这里有一座纪念碑 ,是为了祈求城中的永久和平而建的。
往北边直走 ,是通往城中最热闹的地区-----市集-----在那里可是有一些异想不到的
商品。向南走即是本城的药坊。西边是银行,每个人皆可拥有自己的帐号。东边直走则
是本城,最有名的酒馆,在那里也可以住宿;再下去就是本城的商店,那里可以选购一些
武器及防具。
     这里有四头圣兽,代表着桥头城的和平基石,四兽盘踞在纪念碑的四周,似乎是在
守护着此一象征和平的纪念碑。
LONG
        );
        set("outdoors","/open/tary/");
        set("exits", ([ /* sizeof() == 4 */
            "east" : __DIR__"miroad4",
            "west" : __DIR__"miroad6",
            "north" : __DIR__"miroad13",
            "south" : __DIR__"miroad14",
             ]));
        set("objects",([
            "/open/tary/npc/junche":1,
            "/open/tary/npc/shanlun":1,
            "/open/tary/obj/statue" : 1,
            "/open/tary/npc/bifun":1,
            "/open/tary/npc/shanue":1,
            ]));

        setup();
}

void init()
{
 add_action("ask_body_about_war","ask");
}

int ask_body_about_war(string str)
{
  object ob;
  ob=this_player();
  if(done==1)
    return notify_fail("你问那么多次干嘛？\n");
  if( str!="war")
    return notify_fail("叫你问真身，你问谁呀?\n");
  write("\n\n\n");
  done=1;
  call_out("msg1",10,ob);
  return 1;
}

int msg1(object ob)
{
  object ob;
  message("system","[1;34m空中由远处渐渐飘来朵朵黑云，迅速地将整个天空都完全罩住了....\n\n[0m",users());
  message("system","[1;34m整个大陆都拢罩在黑云之下，世界末日来临了....................\n\n[0m",users());
  message("system","[1;34m海水不断翻腾，大地不断动摇，所有的生物，在此时都仰望着天空，\n\n[0m",users());
  message("system","[1;34m观看着诸神们的逞罚.........................\n\n[0m",users());
  call_out("msg2",14,ob);
  return 1;
}

int msg2(object ob)
{
 message("system","[1;32m以我  "+ ob->query("name") +"身为"+ ob->query("title") +"的名誉将扫荡一切罪恶\n
 抹干净你们的脖子，静待死神的来临吧，我要替天行道，诛恶扬善！！！\n[0m",users());

 new("/open/tary/npc/magician")->move("/open/tary/room/miroad3");
 new("/open/tary/npc/littlefoot")->move("/open/tary/room/miroad9");
 call_out("msg3",30,ob);
  return 1;
}
int msg3(object ob)
{
  message("system","[1;33m一忧子道长叹道: \n

    祈求和平的到来..............
           众子弟们 ,让我们合力消解大地的苦难吧..\n[0m",users());

  return 1;
}
