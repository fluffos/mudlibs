// guild.c

inherit ROOM;

void create() {
  set("short", "风蓝馆正堂");
  set("long", @LONG
    这里是风蓝馆的正堂 ,简单的陈设中透出一股尊贵不凡的气派 ,一张金边且镶着
翡翠的太师椅端坐在大堂中央 ,这里同时也是广成弟子们议事的所在 ,有时在这里举
行大典。你可以看到北边的墙上挂着一块匾额(sign) ,上面写着一些有关成为一名武
者的事项。风蓝馆可不比其他公会 ,这里可是「先天乾坤功”大本营 ,馆主一忧子即
是本派的掌门人,本来先天乾坤是不外传 ,但他已步入中年末,所以急着找到自己的传
人,因此才开派授课,期望求得自己的传人。
    东边是武馆的大门 ,向东走去即是本城的市场。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "living",
    "up": __DIR__ "keeproom",
  ]));
  set("item_desc", ([
    "sign": @TEXT
要成为一名武者并不难，风蓝馆随时欢迎任何身家清白之人成为我们的
一份子，只要你加入(join)武者同盟，就可以向同盟中的各大门派拜师
学艺。
TEXT
  ]));

  set("objects", ([
    "/open/tary/npc/master_j": 1,
  ]));

  set("valid_startroom", 1);
  setup();
}
