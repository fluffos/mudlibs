// longsword.c

#include <weapon.h>
#include "/u/f/fary/combat.h"

inherit SWORD;

void create()
{
        set_name("长剑", ({ "longsword", "sword" }) );
        set_weight(5000);
        setup_sword(3, 7, 50, 0);

        if( !clonep() ) {
                set("wield_as", "sword" );
                set("unit", "把");
                set("value", 4000);
                set("rigidity", 25);
                set("long", "一把精钢铸成的长剑，是武林中人常用的武器。\n");
                set("wield_msg", "$N「唰”地一声抽出一把长剑握在手中。\n");
        set("actions", ({
      ([  "action": "$N用手中的$w三片巨大的光鹰翼,朝向$n$l包围起来",
                "damage_type": "灼伤",
            ])
        }) );
    }
        setup();
}
void attack_with(object me, object opponent, object skill)
{
        mapping *actions = query("actions");

        if( !opponent ) return;
        COMBAT_D->fight(me, opponent, skill, actions[random(sizeof(actions))],
                this_object());
}
