//封魔壶 by funkcat
// reference: /obj/dust.c

#include <ansi.h>

inherit ITEM;
											
void create()
{
	set_name(HIR"(红光)"NOR+"封魔壶", ({"can"}));
	set("long",
	    "闪闪发着红光的封魔壶，据说它有吸取(suck)敌人法力的能力。\n");
	set("unit", "个");
}								
																										
void init()
{
		add_action("do_suck", "suck");
}
								
int do_suck(string arg)
{       string kk;

        int i,j,k;
	object victim;
	if( !arg ) 
	return notify_fail("你要吸取谁的法力?\n");
	
	victim = present(arg,environment(this_player()) );		             							
						
        if( !victim )
	return notify_fail("这没有这种东西\n");
        																								
													
	if( !living(victim) )
	return notify_fail(HIR"封魔壶说:这东西是死的，没有法力可吸。\n"NOR);
					   
        j= victim->query("mana");							
        
        if(victim->query("mana")==0)
        return notify_fail(HIR"封魔壶说:这家伙是没有法力的垃圾..\n"NOR);
        		
       (int)k=j*0.03;
        i=random(k);
																					                  																																									        
	kk=victim->query("name");																								
        victim->set("mana",(j-i));
																
        message_vision(HIR"封魔壶化作红色的厉鬼吸取"+kk+"的法力。\n "NOR,this_player());
        destruct(this_object());
																		         										
        return 1;
}

													