#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
        set_name("风银彩枫鳞戒",({"funin ring","ring"}));
       set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
          set("unit","只");
          set("value",2000);
                set("material","steel");
             set("armor_prop/armor",1);
               set("armor_prop/dodge",4);
}
	setup();
}
