// SilenceBreaker.c

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
  set_name("[1;31m惊寂[0m",({"SilenceBreaker","blade"}));
        set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
     set("long","\n这是一把会饮血的妖刀，泛着诡异的暗红色。\n");
		set("value", 42000);
		set("material", "crimsonsteel");
  set("wield_msg","\n‘[31;1m惊寂[0m’说:让我喝血吧!主人!\n");
 set("unwield_msg","\n‘[31;1m惊寂[0m’说:你阻止不了我的!我要喝你的血!!!\n");
	}


init_blade(5000);
	setup();
}
