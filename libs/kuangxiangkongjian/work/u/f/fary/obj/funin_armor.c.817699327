#include <ansi.h>
#include <armor.h>

 inherit EQUIP;

void create()
{
     set_name(HIC"风银\彩\战甲"NOR,({"funin armor","armor"}));
       set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
          set("unit","件");
          set("value",20000);
              set("material", "ironsteel");
               set("armor_prop/dodge",-18);
    set("long","有着红色光芒印有风的记号,一阵阵的风一直缠绕着。\n");
              set("wear_msg",HIY"莫名力量自体外涌入。\n"NOR);
}
	setup();
}
