inherit NPC;

void create()
{
	set_name("二楼守卫",({"tower guard","guard"}));
	set("gender","男性");
        set("attitude", "aggressive");
	set("age",35);
	set("class","fighter");
	set("str",25);
set("long","武威七杀塔二楼的守卫，你不禁觉得居然有这样丑的人。\n");
	set("combat_exp",80000);
	set_skill("dodge",50);
        set_skill("force",60);
        set_skill("unarmed",70);
        set_skill("lungshan",70);
        set_skill("haoforce",60);
        map_skill("unarmed","lungshan");
        map_skill("force","haoforce");

	setup();
}
