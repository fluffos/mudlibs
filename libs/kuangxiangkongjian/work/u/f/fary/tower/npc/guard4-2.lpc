inherit NPC;
#include <ansi.h>

void do_special();
void create()
{
	set_name("慕容秀",({"mujung hsiu","mujung","hsiu"}));
	set("nickname", HIW "飘天雪" NOR );
	set("gender","女性");
        set("attitude", "heroism");
	set("age",20);
	set("class","fighter");
	set("str",20);
        set("cor", 15);
        set("int", 26);
        set("spi", 22);
        set("cps", 23);
        set("con", 15);
        set("per", 27);
        set("kee",2000);
        set("max_kee",2000);
        set("force"       , 2500);
        set("max_force"   , 2500);
        set("force_factor",30);
        set("long",
        "站在你眼前的，是一个年轻美少女，你很难相信这样年轻的女子，会有怎样骇人\n"
        "的武艺。\n");

	set("combat_exp",450000);
	set_skill("dodge",300);
        set_skill("move",300);
        set_skill("force",30);
        set_skill("unarmed",100);
        set_skill("lungshan",20);
        set_skill("haoforce",20);
        set_skill("henma-steps",300);
 	set("chat_chance",5);
        set("chat_msg",({
          "慕容秀睁着圆圆的眼睛看着你，一副对你感到好奇的模样。\n",
          "慕容秀噘着嘴对你说：你就是师父说的那种很有勇气想来闯塔的武者吗？\n",
          "慕容秀向你说：我劝你不要上去啦，我不小心会打伤你啦！\n",
	}));

        set("chat_chance_combat",10);
        set("chat_msg_combat",({
        (: do_special :)
        }));

        map_skill("dodge","henma-steps");
        map_skill("unarmed","lungshan");
        map_skill("force","haoforce");

	setup();

	create_family("泷山派气宗", 3 , "首座弟子");

        carry_object("/obj/cloth")->wear();

}

void do_special()
  {
    object *enemy,target;
    int i;

       enemy=this_object()->query_enemy();
       i=sizeof(enemy);
       target=enemy[random(i)];

                message_vision(
       HIW"只见慕容秀双手一扬，爆出阵阵寒气，你似乎感觉有片片雪花向你袭来！\n"NOR,target);
                target->receive_wound("kee",random(3));
                COMBAT_D->report_status(target);
                message_vision(
       HIW"只见慕容秀双手一扬，爆出阵阵寒气，你似乎感觉有片片雪花向你袭来！\n"NOR,target);
               target->receive_wound("kee",random(3));
                COMBAT_D->report_status(target);
                message_vision(
       HIW"只见慕容秀双手一扬，爆出阵阵寒气，你似乎感觉有片片雪花向你袭来！\n"NOR,target);
                target->receive_wound("kee",random(3));
                COMBAT_D->report_status(target);
                message_vision(
       HIW"只见慕容秀双手一扬，爆出阵阵寒气，你似乎感觉有片片雪花向你袭来！\n"NOR,target);
                target->receive_wound("kee",random(3));
                COMBAT_D->report_status(target);
                message_vision(
       HIW"只见慕容秀双手一扬，爆出阵阵寒气，你似乎感觉有片片雪花向你袭来！\n"NOR,target);
                target->receive_wound("kee",random(3));
                COMBAT_D->report_status(target);
 	        message_vision(
       HIW"只见慕容秀双手一扬，爆出阵阵寒气，你似乎感觉有片片雪花向你袭来！\n"NOR,target);
                target->receive_wound("kee",random(3));
                COMBAT_D->report_status(target);

}
