//guard3-2.c make by pokai

inherit NPC;
#include <ansi.h>

void do_special();
void create()
{
	set_name("王彪",({"wang piao","wang","piao"}));
	set("nickname","破峰手");
	set("gender","男性");
        set("attitude", "heroism");
	set("age",40);
	set("class","fighter");
	set("str",25);
        set("cor", 23);
        set("int", 16);
        set("spi", 12);
        set("cps", 13);
        set("con", 20);
        set("per", 15);
        set("force"       , 1000);
        set("max_force"   , 2000);
        set("force_factor", 5);


set("long","又是一个满脸横肉的家伙，你一看到他就觉得浑身不对劲。\n");
	set("combat_exp",200000);
	set_skill("dodge",40);
        set_skill("move",10);
        set_skill("force",80);
        set_skill("unarmed",100);
        set_skill("lungshan",90);
        set_skill("haoforce",90);
        set_skill("henma-steps",30);
	set("chat_chance",5);
        set("chat_msg",({
          "王彪骂了你一句：狗奴才，没本领别来这儿！\n",
          "王彪搔了搔头，喃喃地说：不行不行，今天一定要把师兄打败。\n",
        }));

        set("chat_chance_combat",20);
        set("chat_msg_combat",({
        (: do_special :)
        }));

        map_skill("dodge","henma-steps");
        map_skill("unarmed","lungshan");
        map_skill("force","haoforce");

	setup();

	create_family("泷山派气宗", 3 , "三煞");

        carry_object("/obj/cloth")->wear();

}
void do_special()
  {
    object *enemy,target;
    int i;

       enemy=this_object()->query_enemy();
       i=sizeof(enemy);
       target=enemy[random(i)];

                message_vision(
       HIR "\n王彪狰狞地大笑：「哈哈哈！终于有人来试试我的决招啦！注意啦！”\n"NOR,target);
                message_vision(
       HIR"王彪快拳一振，一招「天峰三破”连打你三拳。\n"NOR,target);
                target->receive_wound("kee",random(50));
                COMBAT_D->report_status(target);
                target->receive_wound("kee",random(100));
                COMBAT_D->report_status(target);
                target->receive_wound("kee",random(10));
                COMBAT_D->report_status(target);
}
