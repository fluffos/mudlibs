//guard4-1.c make by pokai

inherit NPC;
#include <ansi.h>

void do_special();
void create()
{
	set_name("兀烈儿",({"wu lieh erh","wu","erh"}));
	set("nickname","长白飞貂");
	set("gender","男性");
        set("attitude", "heroism");
	set("age",35);
	set("class","fighter");
	set("str",20);
        set("cor", 23);
        set("int", 16);
        set("spi", 12);
        set("cps", 13);
        set("con", 25);
        set("per", 15);
        set("force"       , 1500);
        set("max_force"   , 1500);
        set("force_factor", 4);
        set("long",
        "眼前的这位武者，看起来尖嘴猴腮，一副很惹人厌的样子，不过你注意到他步履_\n"
        "轻盈，似乎功夫和长相不成正比。\n");

	set("combat_exp",280000);
	set_skill("dodge",200);
        set_skill("move",200);
        set_skill("force",90);
        set_skill("unarmed",90);
        set_skill("lungshan",50);
        set_skill("haoforce",50);
        set_skill("henma-steps",150);

        set("chat_chance",10);
        set("chat_msg",({
        "兀烈而对你说：「我劝你还是回头吧，五威七杀塔可不比别的地方.......”\n",
        "兀烈儿喃喃地说，泷山派气宗虽不是正式门派，但是泷山拳法的分支。\n",
        }));

        set("chat_chance_combat",50);
        set("chat_msg_combat",({
        (: do_special :)
        }));

        map_skill("dodge","henma-steps");
        map_skill("move","henma-steps");
        map_skill("unarmed","lungshan");
        map_skill("force","haoforce");

        set_temp("apply/defend",3000);
        set_temp("apply/armor",8000);

	setup();

	create_family("泷山派气宗", 3 , "次座弟子");

        carry_object("/obj/cloth")->wear();

}

void do_special()
  {
    object *enemy,target;
    int i;

       enemy=this_object()->query_enemy();
       i=sizeof(enemy);
       target=enemy[random(i)];

                message_vision(
       HIR"「刷！”一声，兀烈儿一招「毒狼式”已经连皮带肉抓得对手哇哇叫。\n"NOR,target);
                target->receive_wound("kee", 20 + random(5));
                COMBAT_D->report_status(target);

}
