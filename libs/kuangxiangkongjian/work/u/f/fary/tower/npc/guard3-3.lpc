//guard3-3.c make by pokai

inherit NPC;
#include <ansi.h>

void do_checkee();
void do_special();
void create() {
  set_name("赵明", ({ "chao ming", "chao", "ming" }));
  set("nickname", "穿云手");
  set("gender", "男性");
  set("attitude", "heroism");
  set("age", 30);
  set("class", "fighter");
  set("str", 25);
  set("cor", 23);
  set("int", 16);
  set("spi", 12);
  set("cps", 13);
  set("con", 20);
  set("per", 15);
  set("force", 2500);
  set("max_force", 2500);
  set("force_factor", 6);
  set("long",
    "眼前的这位武者，比先前几个都来得斯文，年纪也轻得多，不过看到他高高突起\n"
    "的太阳穴，就知道他内力甚高。\n");

  set("combat_exp", 250000);
  set_skill("dodge", 50);
  set_skill("move", 50);
  set_skill("force", 90);
  set_skill("unarmed", 100);
  set_skill("lungshan", 90);
  set_skill("haoforce", 95);
  set_skill("henma-steps", 40);
  set("chat_chance", 60);
  set("chat_msg", ({
    (: do_checkee :)
  }));

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: do_special :)
  }));

  map_skill("dodge", "henma-steps");
  map_skill("unarmed", "lungshan");
  map_skill("force", "haoforce");

  setup();

  create_family("泷山派气宗", 3, "三煞");

  carry_object("/obj/cloth")->wear();

}

void do_checkee() {
  int kee, max_kee, i;
  object *enemy, target;
  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];
  kee = target->query("kee");
  max_kee = target->query("max_kee");

  if (kee < max_kee * 0.8) {
    target->move(__DIR__ "road3");
    return;
  }
}

void do_special() {
  object *enemy, target;
  int i;

  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  target = enemy[random(i)];
  // if (random(2)) {
  message_vision(
    HIR "\n赵明气振双臂，大喝一声 ～～ ‘看！穿云狂击掌！！’瞬间爆出无数掌影。\n" NOR, target);
  message_vision(
    HIC "只见赵明双掌幻化成一张掌网，疯狂地往你周身大穴拍打而去！！\n" NOR, target);
  target->receive_wound("kee", random(5));
  COMBAT_D->report_status(target);
  message_vision(
    HIC "只见赵明双掌幻化成一张掌网，疯狂地往你周身大穴拍打而去！！\n" NOR, target);
  target->receive_wound("kee", random(10));
  COMBAT_D->report_status(target);
  message_vision(
    HIC "只见赵明双掌幻化成一张掌网，疯狂地往你周身大穴拍打而去！！\n" NOR, target);
  target->receive_wound("kee", random(10));
  COMBAT_D->report_status(target);
  message_vision(
    HIC "只见赵明双掌幻化成一张掌网，疯狂地往你周身大穴拍打而去！！\n" NOR, target);
  target->receive_wound("kee", random(20));
  COMBAT_D->report_status(target);
  message_vision(
    HIC "只见赵明双掌幻化成一张掌网，疯狂地往你周身大穴拍打而去！！\n" NOR, target);
  target->receive_wound("kee", random(10));
  COMBAT_D->report_status(target);
  message_vision(
    HIC "只见赵明双掌幻化成一张掌网，疯狂地往你周身大穴拍打而去！！\n" NOR, target);
  target->receive_wound("kee", random(10));
  COMBAT_D->report_status(target);
}
