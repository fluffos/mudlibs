// heal.c

#include <ansi.h>

int exert(object me,object target)
{
      if(me->query_skill("cure")<30)
          return notify_fail("你的医术太差，无法医治花柳病。\n");
           if(!target->query_condition("flower_poison"))
              return notify_fail("没有得花柳病的人不需要医治。\n");
	if( me->is_fighting() )
          return notify_fail("战斗中不能医治。\n");

       if((int)me->query("gin")<30||(int)me->query("sen")<30)
           return notify_fail("你的精或神不够，不能解毒。\n");

   if(me!=target)
     message_vision(
     HIC + "$N给$n服了几帖药，把$n的花柳病治好了。\n" NOR,
     me,target);
   else 
      message_vision( HIC "$N给$N自给服下了几帖药，把自己的花柳病治好了。\n" NOR,me);

    target->apply_condition("flower_poison",0);
       me->add("gin",-30);
             me->add("sen",-30);

	return 1;
}
