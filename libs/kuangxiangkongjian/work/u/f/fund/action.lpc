 
 
void init()
{
 	add_action("do_kill","kill");
}
int do_kill(string arj)
{
	object ob;
	if(this_object()->query("owner")!=this_player()->query("id"))
		return 0;
	if(!(ob=present(arj,environment(this_player()))))
		return 0;
	if(ob==this_object()||ob==this_player())
	{
		command("shake");
		return 1;
	}
	this_object()->kill_ob(ob);
	return 0;
}
