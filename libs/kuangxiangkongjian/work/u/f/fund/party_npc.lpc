#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DAMAGE;
int test_limit();
int test_kill_limit(object ob);
int do_accept();
int party_with(string str)
{
   object me,obj;
   me=this_player();
   obj=this_object();
   if(str!="with "+obj->query("id"))
       return notify_fail("你想和谁组队？\n");
   if(obj->query_temp("id"))
       return notify_fail("这个人已经和别的人组队了。\n");
   if(me->query_temp("p_"+obj->query("name"))==1)
       return notify_fail("相同的人不能再组队。\n");
   message_vision(
       CYN "$N说道："+obj->query("be_party_msg")+"\n" NOR,me,obj);
   if(obj->query("lim")==1)
      if(!test_limit())
      {
      command("say "+obj->query("lim_msg"));
      return 1;
      }
   command("say "+obj->query("party_succeed_msg"));
   command("follow "+me->query("id"));
   obj->set("long",obj->query("party_long"));
   obj->set_temp("id",me->query("id"));
   me->set_temp("p_"+obj->query("name"),1);
   if(obj->query("be_friend")) obj->set("know",me);
   return 1;
}
int unparty(string str)
{
   object me,obj;
   me=this_player();
   obj=this_object();
   if(str!=obj->query("id"))
       return notify_fail("你想跟谁脱离?\n");
   if(me->query("id")!=obj->query_temp("id"))
       return notify_fail("他并不属于你的队伍。\n");
   message_vision(
     CYN "$N说道："+obj->name()+" ! 我们之间的队伍关系到此为止。\n" NOR,me,obj);
   command("say 你.......");
   command("say 哼!!...");
   if(obj->query("will_angry")==1)
   {
      command("say 你这个无情无义的人....纳命来 !");
      obj->kill_ob(me);
   }
   obj->delete_temp("id");
   return 1;
}
int do_kill(string str)
{
   object me,ob,obj;
   me=this_player();
   obj=this_object();
   if(me->query("id")!=obj->query_temp("id"))
     return 0;
   if(!str) return notify_fail("你想杀谁？\n");
   if(!ob=present(str,environment(me)))
       return notify_fail("这里并没有这个人。\n");
   message_vision(
   CYN "$N说道：我们合力杀死$n吧!\n" NOR,me,ob);
   me->kill_ob(ob);
   if(obj->query("no_kill")==1)
   if(!test_kill_limit(ob))
   {
      command("say 抱歉，我不杀这个人。");
      return 1;
   }
   obj->kill_ob(ob);
   ob->kill_ob(me);
   ob->kill_ob(obj);
   return 1;
}
int do_wield(string str)
{
   object me=this_player(),obj=this_object();
   message_vision(
     CYN "$N说道："+obj->name()+"，装备好武器。\n" NOR,me,obj);
   command("hmm");
   command("wield "+str);
   return 1;
}
int do_unwield(string str)
{
   object me=this_player(),obj=this_object();
   command("unwield "+str);
   return 1;
}
int do_wear(string str)
{
   object me=this_player(),obj=this_object();
   command("wear "+str);
   return 1;
}
int do_remove(string str)
{
   object me=this_player(),obj=this_object();
   command("remove "+str);
   return 1;
}
int do_follow()
{
   object me=this_player(),obj=this_object();
   message_vision(
      CYN "$N说道：$n请跟随我来。\n" NOR,me,obj);
   command("say 好的。");
   command("follow "+me->query("id"));
   return 1;
}
int do_unfollow()
{
   object me=this_player(),obj=this_object();
   message_vision(
       CYN "$N说道：$n ! 请在此稍后。\n" NOR,me,obj);
   command("nod");
   command("follow none");
   return 1;
}
int accept_object(object who,object ob)
{
   if(this_object()->query("do_accept")==1)
       do_accept();
   return 1;
}
int do_order(string str)
{
   object me=this_player(),obj=this_object();
   string st1,st2,st3;
   int i;
   mapping cmds =([
	"wield":1,
	"unwield":2,
	"wear":3,
	"remove":4,
	"follow":5,
	"unfollow":6,
	]);
   if(!str) return notify_fail("\n指令格式：order <npc> <command>\n\n");
   sscanf(str,"%s %s",st1,st2);
   if(!st2) return notify_fail("\n\n指令格式：order <npc> <command>\n\n");
   sscanf(st2,"%s %s",st2,st3);
   if(!st3&&cmds[st2]<5) return notify_fail("\n\n指令格式：order <npc> <command>\n\n");
   if(st1!=obj->query("id")) return 0;
   if(cmds[st2])
	switch(cmds[st2])
	{
	   case 1:do_wield(st3);break;
	   case 2:do_unwield(st3);break;
	   case 3:do_wear(st3);break;
	   case 4:do_remove(st3);break;
	   case 5:do_follow();break;
	   case 6:do_unfollow();break;
	}
   return 1;
}
void basic_action_set()
{
   add_action("party_with","party");
   add_action("unparty","unparty");
   add_action("do_kill","gokill");
   add_action("do_order","order");
}
