// heal.c

#include <ansi.h>

int exert(object me,object target)
{
     if(me->query_skill("cure")<40)
          return notify_fail("你的医术太差，无法医治。\n");
     if(!target->query_condition("snake_poison"))
          return notify_fail("没中毒的人不需要解毒。\n");
	if( me->is_fighting() )
          return notify_fail("战斗中不能解毒。\n");

       if((int)me->query("gin")<30||(int)me->query("sen")<30)
           return notify_fail("你的精或神不够，不能解毒。\n");

   if(me!=target)
      message_vision(
     HIC+"$N给$n服下几颗药丸，把$n的蛇毒治好了。\n" NOR,
         me,target);
   else message_vision( HIG "$N服了自己的解毒药，把自己的蛇毒解了。\n" NOR,me);

          target->apply_condition("snake_poison",0);
       me->add("gin",-30);
             me->add("sen",-30);

	return 1;
}
