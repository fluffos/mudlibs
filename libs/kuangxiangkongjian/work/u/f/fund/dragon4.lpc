// dog.c
inherit NPC;
inherit SSERVER;
#include <ansi.h>
string fight();
void create()
{
	set_name(HIY "灵龙" NOR,({"dragon"}));
	set("race", "野兽");
	set("age",1000);
	
	set("str", 24);
	set("cor", 26);

	set("limbs",({"龙头","龙尾","龙身"}));
	set("verbs", ({ "bite", "claw" }) );

	set_temp("apply/damage",40);
	set_temp("apply/armor",30);
	set("combat_exp",300000);
	set("chat_chance_combat",60);
	set("chat_msg_combat",({
	(: fight :)
	}));

	setup();
}

string fight()
{
	message_vision(HIG "$N从眼中射出灵光～～～～～～\n",this_object());
	if(random(5)<2)
	{
		message_vision("$N的灵光在$n身上留下了一道长痕。\n",this_object(),offensive_target(this_object()));
		COMBAT_D->report_status(offensive_target(this_object()));
	}
		message_vision("$N惊险的躲开了灵光，没被击中。\m",offensive_target(this_object()));
	return " ";
}
