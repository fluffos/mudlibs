#include <room.h>

inherit ROOM;

void create()
{
          set("short","雪苍山山口");
        set("valid_startroom", 1);
          set("long","这里就是武林一大门派「雪苍派”的入口，，往上走即是通往雪苍派的道路，途中有八卦迷宫阵，传说只有有缘之人方可到达雪苍派。\n");
        set("exits", ([
       "up": "/u/f/fund/room/room4",
          "south": "/u/f/fund/room/out",
          "west": "/u/f/fund/room/water2",
        ]) );
          set("object",([__DIR__"npc/door_care" : 2 ]));
        setup();
}
