#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
          object ob;
           ob=this_player();
          set("short","八卦阵阵眼");
        set("valid_startroom", 1);
          set("long","这里就是八卦阵的阵眼，从这里就可以离开八卦阵。\n");
        set("exits", ([
          "north": "/u/f/fund/room/room5",
          "south": "/u/f/fund/room/room5b",
          "west": "/u/f/fund/room/room5c",
         "out": "/u/f/fund/room/room5_out",
          "east": "/u/f/fund/room/room5b"
        ]) );
          set("objects",([__DIR__"npc/cmatetwo":1]));
          setup();
}
