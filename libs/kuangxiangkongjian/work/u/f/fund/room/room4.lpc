#include <room.h>

inherit ROOM;

void create()
{
          set("short","八卦迷宫阵的入口");
        set("valid_startroom", 1);
          set("long","这是八卦迷宫阵的入口，在前方不远处，可以看见一堆用岩石排列而成的八卦，一般人一旦进入，就会被困住，相传只有有缘之人，方能找到阵眼，到达雪苍派。\n");
        set("exits", ([
          "north": "/u/f/fund/room/room5",
          "down": "/u/f/fund/room/room3"
        ]) );
        setup();
}
