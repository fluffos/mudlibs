#include <ansi.h>

inherit NPC;
  inherit F_MASTER;
void create()
{
        set_name("李灵",({"li lin","lin","li"}));
          set("long","他是雪苍派的弟子，现在正在练习长老教他的狂风鬼影脚。\n");
		set("gender","男性");
           set("title","雪苍派授技长老");
            set("combat_exp",200000);
          set("attitude","heroism");
          set("age",62);
		set("str", 44);
		set("cor", 24);
		set("cps", 18);
		set("per", 24);
		set("int", 42);
           set("force",800);
              set_skill("black-steps",60);
           set_skill("parry",50);
            set_skill("ghost-feet",80);
            map_skill("dodge","black-steps");
          map_skill("unarmed","ghost-feet");
           set("max_force",800);
            set("force_factor",20);
          set_skill("dodge",40);
            set_skill("force",50);
          set_skill("unarmed",60);
            set_skill("snowforce",50);
map_skill("force","snowforce");
	setup();
}

