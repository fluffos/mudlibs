// sword_man.c
#include <ansi.h>

inherit NPC;

void create() {

  set_name("独孤笑", ({ "ducu show", "show" }));
  set("attitude", "friendly");
  set("long", "他是一代高人独孤愁的儿子独孤笑，武功甚是不凡》");
  set("max_gin", 200);
  set("max_kee", 600);
  set("max_sen", 200);

  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);

  set("force", 800);
  set("max_force", 800);
  set("age", 35);
  set("force_factor", 10);
  set("str", 40);
  set("cor", 30);
  set("cps", 25);

  set("combat_exp", 300000);
  /*
*/
  set_skill("unarmed", 80);
  set_skill("parry", 100);
  set_skill("dodge", 60);
  set_skill("force", 60);
  set_skill("snowforce", 70);
  set_skill("black-steps", 60);
  set_skill("ghost-feet", 90);
  set_skill("move", 70);
  map_skill("dodge", "black-steps");
  map_skill("force", "snowforce");
  map_skill("unarmed", "ghost-feet");

  create_family("雪苍派", 4, "弟子");
  setup();

}

void init() {
  add_action("do_kill", "gokill");
  add_action("do_party", "party");
}
int do_party(string str) {
  if (this_object()->query_temp("id"))
    return 0;
  if (str != "with ducu show" && str != "with show")
    return 0;
  message_vision(
    "$N说道：皇天在上，我愿与独孤笑义结金兰，同甘共苦。" NOR, this_player());
  message_vision("\n", this_player());
  if (this_player()->query_temp("have_party_show") == 1) {
    command("say 汝何人也？在下不认识你。");
    return 1;
  }
  if (this_player()->query("party_show") != 1) {
    command("say 就凭你也配！");
    return 1;
  }
  command("say 愿生死与共，同甘共苦。");
  command("follow " + this_player()->query("id"));
  this_object()->set_temp("id", this_player()->query("id"));
  this_player()->set_temp("have_party_show", 1);
  this_object()->set("know", this_player());
  return 1;
}
int do_kill(string str) {
  object ob;
  seteuid(geteuid());
  if (this_player()->query("id") != this_object()->query_temp("id"))
    return notify_fail("你无权控制他！\n");
  if (!str || str == "") return notify_fail("砍谁??\n");
  if (!ob = present(str, environment(this_player())))
    return notify_fail("没这人。\n");
  message_vision(
    CYN "$N说道：我们一起合力杀死$n吧！\n" NOR, this_player(), ob);
  this_object()->kill_ob(ob);
  this_player()->kill_ob(ob);
  ob->kill_ob(this_object());
  ob->kill_ob(this_player());
  return 1;
}
int heal_up() {
  return ::heal_up() + 1;
}


void die() {
  this_object()->query("know")->delete("party_show");
  destruct(this_object());
}
