#include <ansi.h>

inherit NPC;

void create()
{
          set_name("王彪",({"wang biou","wang","biou"}));
          set("long","他是雪苍三侠中排行第二的‘鬼刀客’王彪，他的刀法精绝，在武林中颇有名气。\n");
		set("gender","男性");
          set("combat_exp",1000000);
          set("attitude","heroism");
          set("age",45);
          set("title","雪苍派第四代弟子");
		set("str", 44);
		set("cor", 24);
		set("cps", 18);
		set("per", 24);
		set("int", 42);
          set("force",2200);
          set("max_force",2200);
          set("force_factor",10);
          set_skill("dodge",80);
          set_skill("force",100);
	set_skill("blade",100);
	set_skill("snow-martial",80);
	set_skill("snowforce",80);
	map_skill("force","snowforce");
	map_skill("force","snowforce");
	setup();
          carry_object(__DIR__"obj/ghostblade")->wield();
          create_family("雪苍派",4,"弟子");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
		say("这位"+RANK_D->query_respect(ob)+"要加入剑门吗?\n");
			break;
		case 1:
		say("这位"+RANK_D->query_respect(ob)
		+"请勿在此地乱丢垃圾!\n");
			break;
	}
}
