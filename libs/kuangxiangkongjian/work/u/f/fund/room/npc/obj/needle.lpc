// needle.c

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("药针", ({ "needle" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("base_unit", "支");
    set("base_weight", 300);
    set("base_value", 80);
    set("material", "iron");
  }
  set_amount(1);
  init_throwing(10);
  setup();
}
