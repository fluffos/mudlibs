// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill;

          if( target != me ) return notify_fail("你只能用雪苍神功提升内力威力。\n");

          if((int)me->query("force")<200) return notify_fail("你的内力不够。\n");
if((int)me->query_temp("enforceup")) return notify_fail("你已经在运功了。\n");

	skill = me->query_skill("force");

	me->add("bellicosity", 100 + skill/2 );
          me->add("force",-200);
	me->receive_damage("kee", 0);

	message_vision(
      HIY "$N运起雪苍神功将体内力凝聚。\n" NOR,me);
          me->set("force_factor",20);
          me->set_temp("enforceup",1);

	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill);

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me, int amount)
{
          me->set("force_factor",10);
          me->delete_temp("enforceup");
          tell_object(me,"你运完功收回内力。\n");
}
