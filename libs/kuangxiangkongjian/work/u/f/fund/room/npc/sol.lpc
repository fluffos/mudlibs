#include <ansi.h>

inherit NPC;

void create() {
  set_name("吴大侠", ({ "sol" }));
  set("long", "他是吹雪寨不死身洋平。\n");
  set("gender", "男性");
  set("combat_exp", 65000);
  set("nickname", "中华英雄");
  set("attitude", "heroism");
  set("age", 41);
  set("str", 44);
  set("cor", 24);
  set("cps", 18);
  set("per", 24);
  set("int", 42);
  set("force", 1200);
  set("max_force", 1200);
  set("force_factor", 10);
  set_skill("dodge", 60);
  set_skill("pyrobat-steps", 60);
  set_skill("sword", 60);
  set_skill("force", 80);
  set_skill("celestial", 80);
  set_skill("six-chaos-sword", 80);
  map_skill("sword", "six-chaos-sword");
  map_skill("force", "celestial");
  map_skill("dodge", "pyrobat-steps");
  set("immortal", 1);
  setup();
  carry_object(__DIR__ "obj/etsword")->wield();
  create_family("雪苍派", 5, "弟子");
  set("title", "无敌帅个霹雳大侠门开山祖师");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      say("这位" + RANK_D->query_respect(ob) + "要加入剑门吗?\n");
      break;
    case 1:
      say("这位" + RANK_D->query_respect(ob)
        + "请勿在此地乱丢垃圾!\n");
      break;
  }
}
