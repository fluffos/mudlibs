// needle.c

#include <weapon.h>

inherit STABBER;

void create()
{
	set_name("判官笔",({"pen"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit","支");
                set("base_unit","支");
		set("base_weight", 300);
		set("base_value", 80);
		set("material", "iron");
	}
	init_stabber(10);
	setup();
}
