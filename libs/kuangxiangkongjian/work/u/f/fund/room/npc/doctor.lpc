// master.c

inherit NPC;
inherit F_MASTER;

void create()
{
           set_name("柳回春",({"master doctor","doctor","master"}));
            set("nickname","妙手神医");
	set("gender", "男性" );
	set("age", 44);
	set("str", 27);
	set("cor", 30);
	set("cps", 27);
	set("int", 24);

           set("max_force",2000);
           set("force",2000);
           set("force_factor",10);


	set("long",
           "他就是天下第一医「妙手神医”柳回春，他的医术深不可测，传闻天下间没有他不能医的病。\n");

            create_family("神医门",5,"神医");

	set("combat_exp", 1000000);
	set("score", 200000);


           set_skill("unarmed",60);
            set_skill("parry",40);
               set_skill("dodge",60);
                set_skill("force",60);
            set_skill("literate",100);
            set_skill("cure",100);
           set_skill("godcure",100);
          map_skill("cure","godcure");
            set("class","shaman");
           map_skill("force","godcure");
          set_skill("throwing",40);
	setup();
           carry_object("/open/su/obj/h_needle")->wield();
}

void attempt_apprentice(object ob,string str)
{
         string class;
          class=ob->query("class");
                if(class=="swordsman"||class=="scholar"||class=="fighter")
              {
                 command("say 这位大侠请不要跟老夫开玩笑。");
                  return;
             }
            command("recruit "+ob->query("id"));
}

void recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
            ob->set("class","shaman");
}
