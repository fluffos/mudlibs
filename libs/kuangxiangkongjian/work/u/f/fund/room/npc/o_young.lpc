#include <ansi.h>

inherit NPC;
inherit F_MASTER;
void create() {
  set_name("欧阳行", ({ "oh young", "oh", "young" }));
  set("long", "他是雪苍三侠的老三‘醉剑仙’欧阳行，别看他平时疯疯癫癫，整日拿者酒瓶喝酒，他的武功可是深不可测。");
  set("gender", "男性");
  set("combat_exp", 1000000);
  set("attitude", "heroism");
  set("age", 40);
  set("title", "雪苍派第四代弟子");
  set("str", 44);
  set("cor", 24);
  set("cps", 18);
  set("per", 24);
  set("int", 42);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 10);
  set_skill("dodge", 100);
  create_family("测试门", 4, "弟子");
  set_skill("force", 60);
  set_skill("sword", 100);
  setup();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("str") < 20) {
    command("say 雪苍鬼脚要力量大的人才能学，我看你请回吧!\n");
    return;
  }
  command("hmm");
  command("recruit " + ob->query("id"));
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      say("这位" + RANK_D->query_respect(ob) + "要加入剑门吗?\n");
      break;
    case 1:
      say("这位" + RANK_D->query_respect(ob)
        + "请勿在此地乱丢垃圾!\n");
      break;
  }
}
