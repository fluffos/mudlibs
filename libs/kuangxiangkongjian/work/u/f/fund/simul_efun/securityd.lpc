 
#include "path.h"
#define WIZLIST	"/u/f/fund/simul_efun/wizlist"
mapping path = ([
	"/adm" : 	ROOT_PATH,
	"/cmds" :	CMDS_PATH,
	"/data" :	DATA_PATH,
	"/std"	:	STD_PATH,
	"/obj"	:	OBJ_PATH,
	"/open"	:	OPEN_PATH,
	"/u"	:	WIZ_PATH,
	]);
string *wiz_level = ({
	"(player)",
	"(apprentice)",
	"(wizard)",
	"(arch)",
	"(admin)",
	});

string *wizlist;

mapping valid_write_file = ([
	"/" :		"(admin)" ,
	"/data" :	"(admin)" ,
	"/adm" :	"(admin)" ,
	"/cmds" :	"(arch)" ,
	"/std" :	"(arch)" ,
	"/open" : 	"(wizard)" ,
	"/u"	:	"(arch)" ,
	"/obj"	:	"(admin)" ,
]);

mapping valid_read_file = ([
]);
 
void create()
{
	wizlist = explode( read_file(WIZLIST) , "\n" );
}
int path_power( string pathname )
{
	string main_path = pathname[0..strsrch(pathname[1..strlen(pathname)],"/")];
	return path[ main_path ];
}
string wizlevel( object ob )
{
	int i;
	string id , level;
	for( i = 0 ; i < sizeof(wizlist) ; i ++ )
	{
		sscanf(wizlist[i],"%s %s",id,level);
		if( id == getuid(ob) ) return level;
	}
	return "(player)";
}
int wiz_power( object ob )
{
	int i;
	string ob_level = wizlevel( ob );
	for( i = 0 ; i < sizeof(wiz_level) ; i ++ )
		if( wiz_level[i] == ob_level ) return i;
	return 0;
}
int set_wizlevel( object ob , string level )
{
	string promoter = getuid();
	string wiz_id = getuid(ob);
	string new_wizlist = "" , id , old_level;
	int i;
	if( wizlevel(find_player(promoter)) != wiz_level[sizeof(wiz_level)-1] ) return 0;

	for( i = 0 ; i <sizeof(wizlist) ; i ++ )
	{
		sscanf(wizlist[i],"%s %s",id,old_level);
		if( id == wiz_id ) old_level = level;
		if( old_level != "(player)" )
			new_wizlist = new_wizlist + id + " " + old_level + "\n";
	}
	if( wiz_power(ob) == 0 ) new_wizlist = new_wizlist + wiz_id + " " + level + "\n";

	rm(WIZLIST);
	write_file( WIZLIST , new_wizlist );
	return 1;
}
int valid_write( string file , mixed user , string func )
{
	string uid = getuid(user);
	string path ;
	if( !userp(user) ) return 0;
	if( !objectp(user) || !userp(user) ) return 0;
	if( func=="save_object" &&
	sscanf(file_name(user),"/obj/%*s") &&
	sscanf(file,"/data/%*s")
	&& file == (string)user->query_save_file() )
		return 1;
	sscanf(file,"/%s/%s",path,file);
	if( !valid_write_file[path] ) return 1;
	if( wiz_power(user) < member_array(wiz_level,valid_write_file[path]) ) return 0;
	return 1;
}
