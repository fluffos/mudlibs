 
#include "object.lpc"
#define SECURITY	__DIR__"securityd.lpc"
 
mapping database = ([]);
 
int set(string key , mixed value)
{
	if( SECURITY->path_power( call_source() ) < 1 )
		return notify_fail("No power to set database.\n");
	database[key] = value;
	return 1;
}
mixed query(string key)
{
	if( SECURITY->path_power( call_source() ) < 1 )
		return notify_fail("No power to query database.\n");
	return database[key];
}
int delete(string key)
{
	if( SECURITY->path_power( call_source() ) < 1 )
		return notify_fail("No power to delete database.\n");
	map_delete( database , key );
	return 1;
}
mapping query_database()
{
	if( SECURITY->path_power( call_source() ) < 1 )
		return 0;
	return database;
}
