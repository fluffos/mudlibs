// short_sword.c
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
         set_name(HIW "采铃神剑" NOR,({"fund sword","sword"}));
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
          set("value",30000);
		set("material", "iron");
		set("long",
         "大魔女"+HIC+"采铃"+NOR+"的佩剑。\n");
	}
           init_sword(500,SECONDARY);
	setup();
}
void init()
{
         add_action("do_show","show");
}
int do_show()
{
          return 0;
}
