// quit.c

#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

mapping gift = ([
	"str":"膂力",
	"cor":"胆识",
	"int":"悟性",
	"spi":"灵性",
	"cps":"定力",
	"per":"容貌",
	"con":"根骨",
	"kar":"福缘",
	]);
void create() 
{
	seteuid(getuid());
	set("name", "离线指令");
	set("id", "quit");
}

int main(object me, string arg)
{
	int i;
	object *inv, link_ob;
	mapping my;
	string  *my_key;
	string *gift_key;
	gift_key=keys(gift);

	for(i=0;i<sizeof(gift);i++)
		if(me->query(gift_key[i])>30)
		{
			tell_object(me,"你的"+gift[gift_key[i]]+"过高，系统将它改为 30。\n");
			me->set(gift_key[i],30);
		}

        if(me->query_temp("spe")==1)
		SEC_KEE_D(me->query("sec_kee"))->remove_it(me);
	if( !wizardp(me) ) {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
			if( !inv[i]->query_autoload() )
				DROP_CMD->do_drop(me, inv[i]);
	}
	if(sizeof(me->query_team())>0)
		if(sizeof(me->query_team())==2)
			me->query_temp("leader")->dismiss_team();

	link_ob = me->query_temp("link_ob");

	// We might be called on a link_dead player, so check this.
	if( link_ob ) {

		// Are we possessing in others body ?
		if( link_ob->is_character() ) {
			write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
			exec(link_ob, me);
			link_ob->setup();
			return 1;
		}

		link_ob->set("last_on", time());
		link_ob->set("last_from", query_ip_name(me));
		link_ob->save();
		destruct(link_ob);
	}

	write("欢迎下次再来！\n");
	message_vision("$N离开游戏。\n", me);
	log_file("quit", 
                sprintf("%s(%s)于 %s 离开游戏。\n他的上一个命令是 '%s'\n",
		  me->query("name"),
		  me->query("id"),
		  ctime(time()),
		  me->query_temp("last_input"))
	);

	// Modify By Spirits. 10.02.1995
        CHANNEL_D->do_channel(this_object(), "sys",
                sprintf("%s(%s)离开游戏了。", me->query("name"), me->query("id")) );
	me->set("last_on", time());
	me->set("last_from", query_ip_name(me));
	my = me->query_entire_temp_dbase();
	my_key = keys(my);
        for (i=0; i<sizeof(my_key); i++)
	  me->delete_temp(my_key[i]);
	me->save();
	destruct(me);

	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : quit

当你(妳)想暂时离开时, 可利用此一指令。
HELP
    );
    return 1;
}
