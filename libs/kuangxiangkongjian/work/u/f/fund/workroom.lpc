#include <room.h>

inherit "/std/new_room";

void dest() {
  object *all, ob;
  ob = load_object("/obj/void");
  all = all_inventory(ob);
  destruct(all[0]);
}
void create() {
  set("short", "采铃的工作室");
  set("long", @LONG



                 采铃的工作室




LONG
  );

  set("valid_startroom", 1);

  set("exits", ([
    "up": "/u/c/chun/workroom",
    "down": "/u/w/wade/workroom",
    "snow": "/open/snow/room/room2",
    "poison": "/open/poison/room/room1",
    "sue": "/open/start/room/small_house",
    "common": "/open/common/room/inn",
    "officer": "/open/capital/room/chen_home",
    "wiz": "/open/wiz/jobroom",
    "killer": "/open/killer/room/r3",
    "gsword": "/open/gsword/room/g5-1",
  ]));

  setup();
  call_other("/obj/board/fund_b", "???");
}
int do_ave() {
  object *list = users();
  object *all;
  int a = 0;
  int i, total = 0;
  int j;
  for (i = 0; i < sizeof(list); i++) {
    all = all_inventory(list[i]);
    a += sizeof(all);
    for (j = 0; j < sizeof(all); j++)
      total += memory_info(all[j]);
  }
  write(sprintf("总共 %d bytes 平均 %d bytes\n", total, total / sizeof(list)));
  write(sprintf("总共 %d 个 平均 %d 个\n", a, a / sizeof(list)));
  return 1;
}
void init() {
  add_action("do_count", "count");
  add_action("do_ave", "ave");
}
int do_count(string id) {
  object me = find_player(id);
  object *all = all_inventory(me);
  int i;
  int mem = 0;
  for (i = 0; i < sizeof(all); i++) {
    mem += memory_info(all[i]);
    write(all[i]->short() + "\n");
  }
  write(sprintf("个数 = %d\n", sizeof(all)));
  write(sprintf("记忆体 = %d\n", mem));
  return 1;
}
