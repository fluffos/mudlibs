// knowpen.c
#include <combat.h>
#include <ansi.h>
void movedown(object me,object target,object weapon,int damage);
inherit SKILL;

mapping *action = ({
      ([      "action":          "$N手中$w一翻，一招「行云流水”手里的$w如一条长龙流转，往$n$l刺去",
	"damage":	50,
	"dodge":	-50,
	"parry":	-20,
	"damage_type":	"刺伤",
	]),
      ([      "action":      "$N身形流转，连踩七步，手中$w一招「七步成诗”往$n点去",
           "damage":           300,
           "dodge":           20,
             "parry":          -30,
           "damage_type":  "刺伤"
          ]),
              ([         "action":         "$N手中$w摇晃，步法微顿，倏地一招「把酒问天”将$w挥出，连出三下往$n点去",
           "damage":      40,
           "dodge":          0,
            "parry":         -50,
             "force":          100,
            "damage_type":  "刺伤"
           ]),
           ([      "action":      "$N将手里的$w高高举起，忽地手中$w急变招数，一招「菊园尽兴”连绵不绝的往$n急点",
           "damage":          30,
	"dodge":	-30,
	"parry":	10,
          "post_action":          (: movedown :),
              "damage_type": "刺伤"
            ]),
});
int valid_learn(object me)
{
                if((int)me->query_skill("literate")*2<(int)me->query_skill("knowpen"))
           return notify_fail("你的读书识字程度不够，不能领悟其中的道理。\n");
           me->improve_skill("knowpen",me->query_skill("literate")/5+1);
	return 1;
}

int valid_enable(string usage)
{
	return (usage=="stabber")||(usage=="parry");
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

void movedown(object me,object target, object weapon,int damage)
{
          if(random(4)>1)   
               return;
          message_vision(
          HIG "$N使出行云流水笔法中的「七星封穴”往$n身上的穴道连点！\n" NOR,me,target);
           if (random(target->query("combat_exp"))<me->query("combat_exp"))
          {
               message_vision( GRN "结果$n被$N点中，穴道被封！\n" NOR,me,target);
                 target->start_busy(me->query_skill("knowpen")/5);
          }
           else
              message_vision(   GRN "结果被$n识破，没有命中。\n" NOR,me,target);
}
int practice_skill(object me)
{
	object weapon;

           if(me->query_skill("literate")*2<me->query_skill("knowpen"))
              return notify_fail("你的读书识字不够，不能领悟其中的道理。\n");
	if( !objectp(weapon = me->query_temp("weapon"))
	||	(string)weapon->query("skill_type")!="stabber")
          return notify_fail("你要有适合的武器才能练行云流水笔法。\n");

           if((int)me->query("sen")<30)
                 return notify_fail("你的神不够，不能练行云流水笔法。\n");
           me->receive_damage("sen",30);
           me->improve_skill("knowpen",me->query_skill("literate")/5+1);
	return 1;
}
