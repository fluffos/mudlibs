// heal.c

#include <ansi.h>

int exert(object me, object target) {
  if (me->is_fighting())
    return notify_fail("战斗中不能治疗。\n");

  if ((int)me->query("gin") < 30 || (int)me->query("sen") < 30)
    return notify_fail("你的精或神不够，不能治疗。\n");


  message_vision(
    HIW + "$N给$n一帖内伤药，$n服下之后，脸色看起来好多了。\n" NOR,
    me, target);

  target->add("kee", 10 + (int)me->query_skill("cure") / 2 + (int)me->query_skill("godcure") / 5);
  me->add("gin", -30);
  me->add("sen", -30);

  return 1;
}
