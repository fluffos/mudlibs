#include "/u/f/fund/party_npc.lpc"
#include "/feature/call_soldier.lpc"
inherit NPC;

void create()
{
      set_name("测试人员",({"test"}));
	set("gender", "男性" );
	set("age", 74);
	set("long",
        "他是一个可怜的老乞丐，一身破烂的衣着，看起来好像好几天没吃饭的样子让人不禁起了同情心。\n");
	set("combat_exp",1000000);
        set("be_party_msg","$n ! 愿意跟随我吗 ?");
        set("party_succeed_msg","我愿意跟随");
        set("lim_msg","哈哈");
	set("soldier_list",([
	"soldier":"兵士(soldier)",
	"fighter":"武士(fighter)",
	"guard":"护卫(guard)",
	]));
	set("soldier_lv",([
	"soldier":2,
	"fighter":5,
	"guard":8,
	]));
     set("lim",1);
              set("will_angry",1);
	set("attitude", "friendly");
       setup();
}
void init()
{
     basic_action_set();
     add_action("do_set","set");
	call_soldier_set();
}
int test_limit()
{
   if(this_player()->query("str")<20) return 0; else return 1;
}
int do_set()
{
	mapping skills;
	skills=this_player()->query_skills();
	query(skills);
	return 1;
}
void die()
{
	"/u/f/fund/damage"->die();
}
