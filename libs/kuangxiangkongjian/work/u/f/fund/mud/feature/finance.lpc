// finance.c

// can_afford() checks if this_object() can afford a price, it returns:
//
//  0:  cannot afford.
//  1:  can afford with proper money(coins).
//  2:  can afford, but don't have enough proper money(coins).
//
int can_afford(int amount) {
  int total;
  object gold, silver, coin;

  gold = present("gold_money");
  silver = present("silver_money");
  coin = present("coin_money");

  total = 0;
  if (gold) total += gold->value();
  if (silver) total += silver->value();
  if (coin) total += coin->value();

  if (total < amount) return 0;

  if (coin) amount -= (int)coin->value();
  if (amount <= 0) return 1;
  else if (amount % 100) return 2;

  if (silver) amount -= (int)silver->value();
  if (amount <= 0) return 1;
  else if (amount % 10000) return 2;

  return 1;
}

int pay_money(int amount) {
  int total;
  object gold, silver, coin, me = this_player();

  gold = present("gold_money");
  silver = present("silver_money");
  coin = present("coin_money");

  total = 0;
  if (gold) total += gold->value();
  if (silver) total += silver->value();
  if (coin) total += coin->value();
  if (total < amount) return 0;

  total -= amount;

  if (total >= 10000) {
    if (!gold) { gold = new(GOLD_OB); gold->move(me); }
    gold->set_amount(total / 10000);
    total = total % 10000;
  } else if (gold) destruct(gold);

  if (total >= 100) {
    if (!silver) { silver = new(SILVER_OB); silver->move(me); }
    silver->set_amount(total / 100);
    total = total % 100;
  } else if (silver) destruct(silver);

  if (total > 0) {
    if (!coin) { coin = new(COIN_OB); coin->move(me); }
    coin->set_amount(total);
  } else if (coin) destruct(coin);

  return 1;
}

int pay_player(int amount) {
  int total;
  object gold, silver, coin;

  gold = present("gold_money");
  silver = present("silver_money");
  coin = present("coin_money");

  total = 0;
  if (gold) total += gold->value();
  if (silver) total += silver->value();
  if (coin) total += coin->value();

  if (amount >= 10000) {
    if (gold)
      gold->add_amount(amount / 10000);
    else {
      gold = new(GOLD_OB);
      gold->set_amount(amount / 10000);
      gold->move(this_object());
    }
    amount %= 10000;
  }
  if (amount > 100) {
    if (silver)
      silver->add_amount(amount / 100);
    else {
      silver = new(SILVER_OB);
      silver->set_amount(amount / 100);
      silver->move(this_object());
    }
    amount %= 100;
  }
  if (amount > 0) {
    if (coin)
      coin->add_amount(amount);
    else {
      coin = new(COIN_OB);
      coin->set_amount(amount);
      coin->move(this_object());
    }
  }
  return 1;
}
