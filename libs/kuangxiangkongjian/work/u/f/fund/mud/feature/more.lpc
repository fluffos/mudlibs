// more.c

#include <ansi.h>

void more(string cmd, string *text, int line) {
  string str;
  int i, j;

  switch (cmd) {
    case "b":
      line = line - 40;
      if (line < -19) return;
      for (i = line + 20; line < i; line++)
        write(text[line] + "\n");
      break;
    case "q":
      return;
      break;
    default:
      if (sizeof(text) > 24) {
        for (i = line + 20; line < sizeof(text) && line < i; line++)
          write(text[line] + "\n");
        if (line >= sizeof(text)) return;
      } else {
        for (; line < sizeof(text); line++)
          write(text[line] + "\n");
        return;
      }
      break;
  }
  printf("== [test]未完继续 " HIY "%d%%" NOR " == (ENTER 继续下一页，q 离开，b 前一页)",
    (line * 100 / sizeof(text)));
  input_to("more", text, line);
}

void start_more(string msg) {
  if (!msg || msg == "") return;
  more("", explode(msg, "\n"), 0);
}
