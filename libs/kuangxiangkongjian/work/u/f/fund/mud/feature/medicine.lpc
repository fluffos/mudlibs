 // medicine.c

#include <dbase.h>
#include <name.h>

void init()
{
	add_action("do_eat", "eat");
	add_action("do_dress","dress");
}
int do_eat(string arg)
{
	string poison_type;
	int medicine_power,condition;
	medicine_power=this_object()->query("medicine_power");
	if(this_object()->query("cure_type")=="outheal")
		return notify_fail("这种药是外敷的(dress)，不能吃。\n");

	if( !this_object()->id(arg) ) return 0;
	if( this_player()->is_busy() )
		return notify_fail("你上一个动作还没有完成。\n");

	if( this_player()->is_fighting() ) this_player()->start_busy(2);
	if(this_object()->query("cure_type")=="poison")
	{
	poison_type=this_object()->query("cure_poison_type");
	condition=this_player()->query_condition(poison_type);
		if(condition)
			this_player()->apply_condition(poison_type,condition-medicine_power);
		else return notify_fail("你没中毒，干嘛吃药 ?\n");
		destruct(this_object());
		return 1;
	}
	if(this_object()->query("cure_type")=="heal")
	{
		this_player()->receive_heal("kee",medicine_power);
		destruct(this_object());
		return 1;
	}
	if(this_object()->query("cure_type")=="sick")
	{
		this_player()->delete(this_object()->query("sick_type"));
		destruct(this_object());
		return 1;
	}
	message_vision(
	"$N服下了"+this_object()->name()+"之后，过了一会，脸上看起来好多了。\n",this_player());
	                                                   
	return 1;
}

int do_dress()
{
	object ob=this_object();
	if(this_object()->query("cure_type")!="outheal")
		return notify_fail("这种药不能用来外敷。\n");
	message_vision(
	"$N把"+ob->name()+"敷在身上，只见伤口渐渐好转。\n" ,this_player());
	this_player()->receive_curing(this_object()->query("cure_heal_type"),this_object()->query("medicine_power"));
	destruct(ob);
	return 1;
}
