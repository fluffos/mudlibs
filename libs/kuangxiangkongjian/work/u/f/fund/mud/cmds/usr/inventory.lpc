//inventory.c

#include <ansi.h>

int main(object me, string arg)
{
	object	*inv, ob;

	if( wizardp(me) ) {
		if (!arg) ob = me;
		else if (arg == "here") ob = environment(me);
		if (!ob) {
		  arg = lower_case(arg);
                  ob = find_player(arg);
		}
		if ( !ob ) ob = find_living(arg);
		if ( !ob ) ob = present(arg, environment(me));
		if( !ob ) ob = me;
	}
	else ob = me;


	inv = all_inventory(ob);
	if( !sizeof(inv) ) {
		write((ob==me)? "目前你身上没有任何东西。\n"
			: ob->short() + "身上没有携带任何东西。\n");
		return 1;
	}
	if (wizardp (me)) {
	  printf ("%s身上带着下列这些东西(负重 %d%%)：\n%s\n",
		(ob==me)? "你": ob->short(),
		  (int)ob->query_encumbrance() * 100
		/ (int)ob->query_max_encumbrance(),
		implode(map_array(inv, "inventory_desc_w", this_object()), "\n") );
	}
	else
	  printf("%s身上带着下列这些东西(负重 %d%%)：\n%s\n",
		(ob==me)? "你": ob->short(),
		  (int)ob->query_encumbrance() * 100
		/ (int)ob->query_max_encumbrance(),
		implode(map_array(inv, "inventory_desc", this_object()), "\n") );

	return 1;
}

string inventory_desc (object ob)
{
	return sprintf("%s%s%s",
		ob->query("equipped")? HIC "ˇ" NOR:"  ",
		ob->query_temp("secured")? "*":" ",
		ob->short()
	);
}

string inventory_desc_w (object ob)
{
	return sprintf("%s%s%s (%s)",
		ob->query("equipped")? HIC "ˇ" NOR:"  ",
		ob->query_temp("secured")? "*":" ",
		ob->short(),
		(string)base_name (ob)
	);
}

int help (object me)
{
        write(@HELP
指令格式: inventory			<一般玩家>
	  inventory <生物或玩家名字>	<巫师专用>
	  inventory <here>		<巫师专用>
 
可列出你(妳)目前身上所携带的所有物品。
 
注 : 此指令可以 " i " 代替。
HELP
);
        return 1;
}
