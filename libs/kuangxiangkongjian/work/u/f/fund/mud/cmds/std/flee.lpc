// flee.c

#include <command.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
  if (arg) me->command("go "+arg);
  else GO_CMD->do_flee(me);
  return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : flee [<方向>]

    按照逃跑方向逃跑，可配合 wimpy/wimpydir 指令使用。
HELP
    );
    return 1;
}
