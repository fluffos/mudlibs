// save.c
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object link_ob, env = environment(me);

  seteuid(getuid());

  if (!objectp(link_ob = me->query_temp("link_ob"))) {
    // return notify_fail("你不是经由正常连线进入，不能储存。\n");
    me->set_temp("link_ob", me);
    link_ob = me;
  }

  if (env->query("valid_startroom")) {
    me->set("startroom", base_name(env));
    write("当你下次连线进来时，会从这里开始。\n");
  }

  me->save();
  write("档案储存完毕。\n");
  if (me != link_ob)
    link_ob->save();
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：save

把你辛苦奋斗的结果存起来, 系统并不打算自动存档,
不过, 在重要情况系统还是会帮您储存档案, 如断线,
或者是死亡, 或者是重新开机.
HELP
  );
  return 1;
}
