// guild_d.c written by fund


#define DICTIONARY DATA_DIR + "guild"

inherit F_SAVE;

mapping dict = ([]);

void add_translate( string class, string key, string chinz );
void remove_translate( string class, string key );

void create()
{
	seteuid(geteuid());
	restore();
}

// void remove() { save(); }


string query_save_file() { return DICTIONARY; }

// This is called by to_chinese() simul_efun

void remove_translate( string class, string key )
{
  mapping temp=dict[class];
  map_delete(temp,key);
  dict[class]=temp;
  save();

}
void remove_class(string class)
{
  map_delete( dict,class );
  save();
}

void add_translate( string class, string key, string chinz )
{
	mapping temp=([]);
	if(dict[class]) temp=dict[class];
	temp[key]=chinz;
	dict[class]=temp;

	save();
}

mapping query_translate()
{
  if( !undefinedp( dict )) return dict;
  else return ([]);
}

