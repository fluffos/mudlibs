inherit F_DBASE;

string *banned_name = ({
	"你", "妳", "我", "他", "她", "牠", "它",
	"菠萝面包", "冰判官", "巫师", "上帝", "天神", "天帝",
});

// 名字不能含有下列字样的某部份
string *banned_id = ({
	"ice", "fuck", "shit", "wizard", "god", "wiz",
});

string *banned_ip = ({
});

mapping attrs=([
	"str"	:	"力量",
	"int"	:	"悟性",
	"con"	:	"根骨",
]);

mapping nattr=([
	"str"	:	"cps",
	"cps"	:	"int",
  	"int"	:	"cor",
  	"cor"	:	"con",
  	"con"	:	"spi",
  	"spi"	:	"per",
  	"per"	:	"kar",
]);

void get_points (string points, object ob, object user, int tp, string attr, int i);
void get_id(string arg, object ob, int times);
void confirm_id(string yn, object ob);
object make_body(object ob);
varargs void enter_world(object ob, object user);
varargs void reconnect(object ob, object user, int silent);
object find_body(string name);
int check_legal_id(string arg);
int check_legal_name(string arg);

void create() 
{
	seteuid(getuid());
	set_temp("channel_id", "连线精灵");
}

int check_okip(object ob, object user)
{
        string  *okip, okip1, okip2, okip3, ip, ip1, ip2, ip3, ip4;
        int     ipok, i;

        okip = user->query("okip");
	query_ip_number(ob);
	if (!ip) return 1;
        ipok = 0;
        sscanf (ip, "%s.%s.%s.%s", ip1, ip2, ip3, ip4);
          for (i=0; i<sizeof(okip); i++) {
            if (!stringp(ip = okip[i])) break;
            if ("*" == ip) { ipok = 1; i=sizeof(okip); }
            else if (sscanf(ip, "%s.%s", okip1, ip) == 2 && okip1 == ip1) {
                if ("*" == ip) { ipok = 1; i=sizeof(okip); }
                else if (sscanf(ip, "%s.%s", okip2, ip) == 2 && okip2 == ip2) {
                  if (ip == "*") { ipok = 1; i=sizeof(okip); }
                  else if(sscanf(ip,"%s.%s", okip3, ip) == 2 && okip3 == ip3) {
                    if (ip == "*") { ipok = 1; i=sizeof(okip); }
                    else if (ip == ip4) { ipok = 1; i=sizeof(okip); }
                  }
                }
            }
          }
	return 1;
}

// logon --> logonn
void logon(object ob)
{
	object *usr;
	int i, wiz_cnt, ppl_cnt, login_cnt;
	cat(WELCOME);
	UPTIME_CMD->main();

	usr = users();
	wiz_cnt = 0;
	ppl_cnt = 0;
	login_cnt = 0;
	for(i=0; i<sizeof(usr); i++) {
		if( !environment(usr[i]) ) login_cnt++;
		else if( wizardp(usr[i]) ) wiz_cnt++;
		else ppl_cnt++;
	}
	printf("目前共有 %d 位巫师、%d 位玩家在线上，以及 %d 位使用者尝试连线中。\n\n",
		wiz_cnt, ppl_cnt, login_cnt );

	write("您的英文名字：");
	input_to( (: get_id :), ob, 1 );
}

// 为了要输入太多次之后能够断线, 增加了一个参数 times
// void get_id(string arg, object ob)
// 其他地方的参数修改不予以一一列出
// fixed by wade Thu Sep 28 1995
void get_id(string arg, object ob, int times)
{
  object	ppl,user;
  int		i;


  arg = lower_case(arg);
  if( !check_legal_id(arg)) {
    // 底下这个 if 是为了要输入太多次之后能够断线
    // fixed by wade Thu Sep 28 1995
    if (times >= 3) {
      write ("对不起, 您输入太多次了。\n");
      destruct (ob);
      return;
    }
    write("您的英文名字：");
    input_to("get_id", ob, times+1);
    return;
  } 

#ifdef MAX_USERS
	if( (string)SECURITY_D->get_status(arg)=="(player)"
	&& sizeof(users()) >= MAX_USERS ) {
		ppl = find_body(arg);
		// Only allow reconnect an interactive player when MAX_USERS exceeded.
		if( !ppl || !interactive(ppl) ) {
			write("对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来。\n");
			destruct(ob);
			return;
		}
	}
#endif
	if( (string)ob->set("id", arg) != arg ) {
		write("Failed setting user name.\n");
		destruct(ob);
		return;
	}

	if( arg=="guest" ) {
		if (user=find_player("guest"))
		  if (interactive(user)) {
		    write ("对不起, 已经有一只 guest 在里面混了。\n");
		    destruct (ob);
		    return;
		  }
		  else destruct (user);
		// If guest, let them create the character.
		ob->set("name", "神秘过路客");
		ob->set("password", crypt("guest",0) );
		ob->set("body", USER_OB);
		user = make_body(ob);
		user->set("gender", "男性");
		write("\n欢迎参观。\n");
		enter_world(ob, user);
		return;
	} else if( file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0 ) {
	  for (i=0; i<sizeof(banned_ip); i++) {
	    if (strsrch(query_ip_number(ob), banned_ip[i]) == 0) {
	      write("对不起，这种位址目前被停用。\n");
	      destruct (ob);
	      return;
	    }
	  }

	  if( ob->restore() ) {
		write("请输入密码：");
		input_to("get_passwd", 1, ob);
		return;
	  }
	  else {
		write("您的人物档案出了一些问题，请利用 guest 进入通知巫师处理。\n");
		destruct(ob);
		return;
	  }
	}
	else {
	  for (i=0; i<sizeof(banned_id); i++) {
	    if (strsrch(arg, banned_id[i]) == 0) {
	      write("对不起，名字不能由 "+banned_id[i]+" 当开头。\n");
	      destruct (ob);
	      return;
	    }
	  }
	}

	write("使用 " + (string)ob->query("id") + " 这个名字将会创造一个新的人物，您确定吗(y/n)？");
	input_to("confirm_id", ob);
}

void get_passwd(string pass, object ob)
{
	string my_pass;
	object user;

	write("\n");
	my_pass = ob->query("password");
	if( crypt(pass, my_pass) != my_pass ) {
		write("密码错误！\n");
		destruct(ob);
		return;
	}

	// Check if we are already playing.
	user = find_body(ob->query("id"));
	if (user) {
		if (user)
		if( user->query_temp("netdead") ) {
			reconnect(ob, user);
			return;
		}
		write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
		input_to("confirm_relogin", ob, user);
		return;
	}

	if( objectp(user = make_body(ob)) ) {
	  if( user->restore() ) {
	    log_file( "USAGE", sprintf("%s(%s) logined from %s (%s)\n",
                       user->query("name"), user->query("id"),
	               query_ip_number(ob), ctime(time()) ) );
	     enter_world(ob, user);
		user->delete_temp("apply");
		user->set_temp("apply/armor",1);
	     return;
	  }
          else {
	    destruct(user);
	  }
	}
	write("请您重新创造这个人物。\n");
	confirm_id("y", ob);
}

void confirm_relogin(string yn, object ob, object user)
{
	object old_link;

	if( yn=="" ) {
		write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
		input_to("confirm_relogin", ob, user);
		return;
	}	

	if( yn=="DESTROY" ) {
		write("秘密毁灭指令启动....");
		// destruct(user);
		write("Ok.\n");
		user = make_body(ob);
	} else if( yn[0]!='y' && yn[0]!='Y' ) {
		write("好吧，欢迎下次再来。\n");
		destruct(ob);
		return;
	} else {
		tell_object(user, "有人从别处( " + query_ip_number(ob)
			+ " )连线取代你所控制的人物。\n");
		log_file( "USAGE", sprintf("%s replaced by %s (%s)\n", user->query("name"),
			query_ip_number(ob), ctime(time()) ) );
	}

	// Kick out tho old player.
	old_link = user->query_temp("link_ob");
	if( old_link ) {
		exec(old_link, user);
		destruct(old_link);
	}

	reconnect(ob, user);	
}

void confirm_id(string yn, object ob)
{
	if( yn=="" ) {
		write("使用这个名字将会创造一个新的人物，您确定吗(y/n)？");
		input_to("confirm_id", ob);
		return;
	}	

	if( yn[0]!='y' && yn[0]!='Y' ) {
		write("好吧，那么请重新输入您的英文名字：");
		input_to("get_id", ob, 1);
		return;
	}

	write( @TEXT

请您想一个有气质，有个性，又不会太奇怪的中文名字，特别要提醒您
的是，本 mud 是一个以古中国与东方为背景的世界 ，请不要取一些不
雅或是容易造成他人困扰的名字，这个名字将代表你的人物，而且往后
将不能再更改，请务必慎重。
  ^^^^^^^^^^
(除了名字之外，本 mud 有许多取绰号、别称的设计，所以郑重建议您
 取一个比较像名字的中文名字。)

TEXT
	);
	write("您的中文名字：");
	input_to("get_name", ob, 1);
}

void get_name(string arg, object ob, int times)
{
    // 底下这个 if 是为了要输入太多次之后能够断线
    // fixed by wade Thu Sep 28 1995
    if (times >= 3) {
      write ("对不起, 您输入太多次了。\n");
      destruct (ob);
      return;
    }
	if( !check_legal_name(arg) ) {
		write("您的中文名字：");
		input_to("get_name", ob, times+1);
		return;
	}

	// printf("%O\n", ob);
	ob->set("name", arg);
	write("请设定您的密码：");
	input_to("new_password", 1, ob);
}

void new_password(string pass, object ob)
{
	write("\n");
	if( strlen(pass)<5 ) {
		write("密码的长度至少要五个字元，请重设您的密码：");
		input_to("new_password", 1, ob);
		return;
	}
	ob->set("password", crypt(pass,0) );
	write("请再输入一次您的密码，以确认您没记错：");
	input_to("confirm_password", 1, ob);
}

void confirm_password(string pass, object ob)
{
	object	user;
	string old_pass;

	write("\n");
	old_pass = ob->query("password");
	if( crypt(pass, old_pass)!=old_pass ) {
		write("您两次输入的密码并不一样，请重新设定一次密码：");
		input_to("new_password", 1, ob);
		return;
	}

	ob->set("body", USER_OB);
	if( !objectp(user = make_body(ob)) )
                return;
	write("您要扮演男性(m)的角色或女性(f)的角色？");
	input_to("get_gender", ob, user);
}

void get_gender(string gender, object ob, object user)
{
	if( gender=="" ) {
		write("您要扮演男性(m)的角色或女性(f)的角色？");
		input_to("get_gender", ob, user);
		return;
	}

	if( gender[0]=='m' || gender[0]=='M' )
		user->set("gender", "男性");
	else if( gender[0]=='f' || gender[0]=='F' )
		user->set("gender", "女性" );
	else {
		write("对不起，您只能选择男性(m)或女性(f)的角色：");
		input_to("get_gender", ob, user);
		return;
	}

}
//  JJCHEN
void get_points (string points, object ob, object user, int tp, string attr, int i)
{
  int	n;

  if (i<0) i = 0;
  if ( sscanf (points, "%d", n) != 1 || n<10 || n>30 || n>tp ) {
    write (sprintf ("请问您希望的%s是多少? 合法值是 10-30, 目前剩下 %3d。\n\
目前剩 %d 项需要设定, 选完此项之后至少必须剩下 %d 点 : ",
           attrs[attr], tp, 7-i, 70-i*10));
    input_to ("get_points", ob, user, tp, attr, i);
    return;
  }
  user->set(attr, n);

  if (attr == "per") {
    tp = tp-n;
    if (tp < 10 || tp > 30) {
      tp += n;
      write ("您还有某些天赋需要设定，但是所剩的值不合法，全部重新设定一次。\n");
      write ("请问您希望的"+attrs["str"]+"是多少? 合法的值是 10-30, 目前剩下 160 : ");
      input_to ("get_points", ob, user, 160, "str", 1);
    }
    else {
      user->set("kar", tp);
      log_file( "USAGE",
                sprintf("%s was created from %s (%s)\n", user->query("id"),
                user->query("from"), ctime(time()) ) );
      user->set_temp ("create", 1);
      user->set("food", 300);
      user->set("water", 300);
      enter_world(ob, user);
    }
  }
  else {
    tp = tp-n;
    if (tp < 10) {
      write ("您还有某些天赋需要设定，但是所剩的值不合法，全部重新设定一次。\n");
      write ("请问您希望的"+attrs["str"]+"是多少? 合法的值是 10-30, 目前剩下 160 : ");
      input_to ("get_points", ob, user, 160, "str", 1);
    }
    else {
      attr = nattr[attr];
    write (sprintf ("请问您希望的%s是多少? 合法值是 10-30, 目前剩下 %3d。\n\
目前剩 %d 项需要设定, 选完此项之后至少必须剩下 %d 点 : ",
           attrs[attr], tp, 8-i, 70-i*10));
      input_to ("get_points", ob, user, tp, attr, i+1);
    }
  }
}

object make_body(object ob)
{
	string err;
	object user;
	int n;

	user = new(ob->query("body"));
	if(!user) {
		write("现在可能有人正在修改使用者物件的程式，无法进行复制。\n");
		write(err+"\n");
		return 0;
	}
	seteuid(ob->query("id"));
	export_uid(user);
	export_uid(ob);
	seteuid(getuid());
	user->set("id", ob->query("id"));
	user->set_name( ob->query("name"), ({ ob->query("id")}) );
	user->set("title", "普通百姓");
	user->set("birthday", time() );
	user->set("potential", 99);

	user->set("str", 10 + random(21));
	user->set("cps", 10 + random(21));
	user->set("int", 10 + random(21));
	user->set("cor", 10 + random(21));
	user->set("con", 10 + random(21));
	user->set("spi", 10 + random(21));
	user->set("per", 10 + random(21));
	user->set("kar", 10 + random(21));

	return user;
}

void press_enter(string arg, object ob, object user)
{
  string	startroom;
  string	*tuned_ch;

	if( user->is_ghost() )
		startroom = DEATHROOM;
	else if( !stringp(startroom = user->query("startroom")) )
		startroom = STARTROOM;

	if( !catch(load_object(startroom)) )
		user->move(startroom);
	else if (!catch(load_object(STARTROOM))) {
		user->move(STARTROOM);
		startroom = STARTROOM;
		user->set("startroom", STARTROOM);
	}
	else user->move(VOID_OB);

	tell_room(startroom, user->query("name") + "连线进入这个世界。\n",
		({user}));
	if( user->query("new_mail") || ob->query("new_mail") ) {
		write( HIY + "\n\n冰胖用千里传音跟您说：有您的信！请去收信！\n\n" + NOR);
		user->delete("new_mail");
	}
// Modify By Spirits. 10.02.1995
        CHANNEL_D->do_channel( this_object(), "sys",
                sprintf("%s(%s)由%s连线进入。", user->name(),user->query("id"),
			query_ip_number(user)) );
        tuned_ch = user->query_temp("channels");
// channel 改成系统预设
	user->delete("brief");
        if (wizardp(user))
	  user->set_temp("channels",({"mud","chat","rumor","shout","sys","wiz"}) );
	else
	  user->set_temp("channels",({"mud","chat","rumor","shout" }) );

}

varargs void enter_world(object ob, object user)
{
	object cloth, room, carry_money;
	object cop_head;
	int	login_time, i;

//
//      Modify by ICE... add e-mail address..
//
//	modified by wade .. 配合 pk rules....
  if (!wizardp(user)) {
	if (PK_D->get_pk_time(user->query("id"))) {
/*
	  if (!cop_head=find_living("cop head")) {
	    if (cop_head = new(COP_HEAD)) {
	      cop_head->move(STARTROOM);
	    }
	  }
	  else {
	    if (!cop_head->is_fighting()) cop_head->move(STARTROOM);
	  }
*/
	  shout (RED "\n九省总巡捕大声呼喝道: 江洋大盗"+
	         user->query("name")+"出现踪迹了, 所有居民请小心。\n\n"NOR);
	}
  }

	user->set_temp("link_ob", ob);
	ob->set_temp("body_ob", user);
	exec(user, ob);

	user->setup();
	user->set("last_from", query_ip_number(user));
	if (wizardp(user)) write("目前权限：" + wizhood(user) + "\n");

	// In case of new player, we save them here right aftre setup 
	// compeleted.
	user->save();
	ob->save();

	cloth = new("/obj/cloth");
	cloth->move(user);
	cloth->wear();
	login_time = time();
	user->set_temp("login_time", login_time);

	cat(MOTD);
	UPDATE_D->check_user(user);

	if (!user->query("okip")) {
	  write (HIR"你没有设定 okip oh! 为了防止人家侵入你的帐号,\n"
            "请您妥善设定您的 okip, 设定方式请在线上用 help okip 查询.\n"NOR);
          // user->set("okip", ({ user->query("last_from")}) );
	}
	else if(!check_okip(ob, user)) {
	//   destruct(user);
	//   destruct(ob);
	  write (HIR"你连线位址跟你设定的 okip 不相吻合, 请自行小心 oh!\n"NOR);
	//   return;
	}
	write ("-- 请按 Enter 键继续 --\n");
	input_to( "press_enter", ob, user );
}

varargs void reconnect(object ob, object user, int silent)
{
	user->set_temp("link_ob", ob);
	ob->set_temp("body_ob", user);
	exec(user, ob);

	user->reconnect();
	user->set("last_from", query_ip_number(user));
	if( !silent ) {
		tell_room(environment(user),
			user->query("name") + "重新连线回到这个世界。\n",
			({user}));
	}
// Modify By Spirits. 10.02.1995
        CHANNEL_D->do_channel( this_object(), "sys",
                sprintf("%s(%s)由%s重新连线进入。",
			user->query("name"), user->query("id"),
			user->query("last_from")) );
	UPDATE_D->check_user(user);
}

int check_legal_id(string id)
{
	int i;

	i = strlen(id);
	
	if( (strlen(id) < 3) || (strlen(id) > 10 ) ) {
		write("对不起，你的英文名字必须是 3 到 10 个英文字母。\n");
		return 0;
	}
	while(i--)
		if( id[i]<'a' || id[i]>'z' ) {
			write("对不起，你的英文名字只能用小写英文字母。\n");
			return 0;
		}

	return 1;
}

int check_legal_name(string name)
{
	int i;

	i = strlen(name);
	
	if( (strlen(name) < 2) || (strlen(name) > 12 ) ) {
		write("对不起，你的中文名字必须是 1 到 6 个中文字。\n");
		return 0;
	}
	while(i--) {
		if( name[i]<=' ' ) {
			write("对不起，你的中文名字不能用控制字元。\n");
			return 0;
		}
		if( i%2==0 && !is_chinese(name[i..<0]) ) {
			write("对不起，请您用「中文”取名字。\n");
			return 0;
		}
	}
	if( member_array(name, banned_name)!=-1 ) {
		write("对不起，这种名字会造成其他人的困扰。\n");
		return 0;
	}

	return 1;
}

object find_body(string name)
{
	object ob, *body;

	if( objectp(ob = find_player(name)) )
		return ob;
	body = children(USER_OB);
	for(int i=0; i<sizeof(body); i++)
		if( clonep(body[i])
		&&	getuid(body[i]) == name ) return body[i];

	return 0;
}

