// tenderzhi.c

inherit SKILL;

mapping *action = ({
  ([ "action": "$N纤手一出，一招「花开堪折”往$n身上抓去",
    "dodge": -30,
    "parry": 30,
    "force": 80,
    "damage_type": "瘀伤",
    "weapon": "右手",
  ]),
  ([ "action": "$N一招「桃香难耐”，一瞬间连出三手往$n$l而去",
    "damage": 50,
    "dodge": -20,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N一出手，一式「旧情难忘”右手如灵蛇般攀爬，忽地一转往$n折去",
    "damage": 80,
    "parry": 10,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N身形忽地散慢，一出手便是一招「难分难舍”往$n咽喉一折",
    "damage": 200,
    "parry": 10,
    "force": 100,
    "dodge": -20,
    "damage_type": "瘀伤",
  ]),
});

int valid_learn(object me) {
  if (me->query("gender") != "女性")
    return notify_fail("寒谷折花手是女人练的功\夫，男生不能练。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("手上拿着兵器不能练。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query("kee") < 30)
    return notify_fail("你的气不够，不能练寒谷折花手。\n");
  return notify_fail("妳的精神无法集中了，休息一下再练吧。\n");

  me->receive_damage("kee", 30);

  return 1;
}
