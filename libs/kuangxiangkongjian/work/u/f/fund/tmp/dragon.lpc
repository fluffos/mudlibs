#include <ansi.h>

mapping dragon = ([
  0: "/obj/npc/dragon1",
  1: "/obj/npc/dragon2",
  2: "/obj/npc/dragon3",
  3: "/obj/npc/dragon4",
  4: "/obj/npc/dragon5",
]);
int perform(object me, string arg) {
  int lv;
  int index;
  object obj;
  seteuid(getuid());
  lv = F_MAGIC->query_magic(me, "dragon");
  if (me->query("atman") < 50 * lv / 20)
    return notify_fail("你的灵力不够，不能用火邪大法。\n");
  index = lv / 20;
  if (index > 4) index = 4;
  message_vision(HIC "$N口中念念有词，忽地往天空一指！\n", me);
  obj = new(dragon[index]);
  obj->move(environment(me));
  message_vision(HIY "$N从天而降，加入了战圈！\n", obj);
  message_vision(NOR, me);
  me->add("atman", -50 * lv / 20);
  F_MAGIC->add_magic(me, "dragon", random(me->query("spi")));
  return 1;
}
