 
#include <ansi.h>
inherit SSERVER;

int query_all_magic(object);
int main(object me,string arg)
{
	query_all_magic(me);
	return 1;
}
int query_all_magic(object me)
{
        int i;
        string *name;
	seteuid(getuid());
        name=keys(me->query("magic"));
	if(sizeof(name)==0)
		tell_object(me,"你目前并没有练习过任何仙法。\n");
	tell_object(me,HIG "你目前练过的法术有：\n");
        for(i=0;i<sizeof(name);i++)
		tell_object(me,sprintf(HIC "%-20s%10d/%5d\n" NOR,to_chinese(name[i])+"("+name[i]+")",
			F_MAGIC->query_magic(me,name[i]),
			F_MAGIC->query_magic_learned(me,name[i])));
        return 1;
}
