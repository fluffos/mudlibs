 
#include <ansi.h>

mapping fire = ([
	0:HIR "$N将灵力聚在手指上，口中念了几句，忽地往$n一指，一颗雄雄火球射出！\n",
	1:HIR "$N将灵力集中在掌心，使出「火邪灵掌”，「啪”的一声，一条火蛇往$n身上卷去！\n",
	2:HIR "$N怒眉微皱，展出火云大法中最强一招「怒火奔放”，随即卷起一阵火旋风！\n",
	]);
mapping power = ([
	0:10,
	1:30,
	2:50,
	]);
int perform(object me,string arg)
{
	int lv;
	int index;
	object obj;
	seteuid(getuid());
	lv=F_MAGIC->query_magic(me,"fire");
	if(me->query("atman")<50)
		return notify_fail("你的灵力不够，不能用火邪大法。\n");
	if(!arg||!(obj=present(arg,environment(me))))
		return notify_fail("你要对谁使用 ?\n");
	if(!living(obj))
		return notify_fail("不要浪费灵力 !\n");
	index=lv/30;
	if(index>2) index=2;
	message_vision(fire[index]+NOR,me,obj);
	if(random(lv)>random(obj->query_skill("dodge")))
	{
		message_vision("$n不及闪躲，被$N所发出的火焰烧伤。\n",me,obj);
		obj->receive_wound("kee",random(lv*3));
		COMBAT_D->report_status(obj);
	}
	else
		message_vision("$n急忙反应，避了开去。\n",me,obj);
	me->add("atman",-50);
	F_MAGIC->add_magic(me,"fire",random(me->query("spi")));
	return 1;
}
 
 
