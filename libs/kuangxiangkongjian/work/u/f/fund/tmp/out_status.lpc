// rose_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	if(duration==0) return 0;
	me->apply_condition("out_status",duration-1);
	tell_object(me,HIG "你的元神不能离开身体太久，不然会死。 \n" NOR);
	if(duration<5)
		message_vision(HIY "$N的元神快要散尽了～～～～\n" NOR,me);
	if(duration==1)
		me->die();
	if( duration < 1 ) return 0;
	return 1;
}
