// hp cmds
 
#include <ansi.h>
inherit F_MORE;
inherit F_CLEAN_UP;
 
mapping guild = ([
	" 武  者 ":([
		"雪苍派":"刘全书",
		]),
	" 剑  士 ":([
		"仙剑派":"郑士欣",
		]),
	" 医  者 ":([
		]),
	" 书  生 ":([
		"大理段家":"段云",
		"儒门":"圣贤书",
		]),
	" 道  士 ":([
		]),
	" 僧  人 ":([
		]),
	" 刀  客 ":([
		"金刀门":"王元霸",
		"魔刀": "莫测",
		]),
	" 军  人 ":([
		]),
	" 魔教徒 ":([
		"冥蛊魔教": "庄静柔",
		]),
	" 杀  手 ":([
		"黑牙联":"叶秀杀",
		]),
	"朝廷命官":([
		"大理寺":"陈知衡",
		]),
	" 盗  贼 ":([
		]),
	" 平  民 ":([
		]),
	]);
 
int main(object me, string arg)
{
	string *class,*guild_name;
	mapping master;
	int guild_cnt=0;
	int i,j;
	string msg="◎ 狂想空间\n";
	class=keys(guild);
	for(i=0;i<sizeof(class);i++)
	{
		msg+=sprintf("【%s】",class[i]);
		if(sizeof(guild[class[i]])==0)
			msg+=sprintf("    目前没有任何派门。\n");
		else
		{
			guild_name=keys(guild[class[i]]);
			master=guild[class[i]];
			for(j=0;j<sizeof(guild_name);j++)
			{
				if(j!=0) msg+="            ";
				msg+=sprintf("    %-16s%-20s\n",guild_name[j],"master : "+master[guild_name[j]]);
				guild_cnt++;
			}
		}
	}
	msg+="\n ";
	msg+=sprintf("狂想空间目前共有 %d 个门派。\n",guild_cnt);
	msg+=NOR;
	start_more(msg);
	return 1;
}
 
 
int help(object me)
{
	write(@HELP
指令格式：guild 

说明：这个指令让你可以查看目前有几个门派。
HELP
    );
    return 1;
}
