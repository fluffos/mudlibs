// query.c

#include <ansi.h>

inherit F_CLEAN_UP;

string *msg_dunno = ({
  "$n一脸不屑的样子，似乎对你说的话毫不理会。\n",
  "$n一复傲慢的样子瞪着你。\n",
  "$n打了个呵欠，对你毫不在意。\n",
  "$n说道：嗯....这我可不清楚，你最好问问别人吧。\n",
  "$n想了一会儿，说道：对不起，你问的事我实在没有印象。\n"
});

int main(object me, string arg) {
  object ob;


  if (!arg)
    return notify_fail("你想从谁身上打听朝廷大事。\n");

  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!living(ob) || ob->query("class") != "officer")
    return notify_fail("你只能向朝廷官员打听国家大事。\n");

  if (userp(ob)) return notify_fail("跟玩者打听有用吗 ?\n");

  message_vision(
    CYN "$N向$n问道：请问朝中有何大事 ?\n", me, ob);

  if (me->query("relation/" + ob->query("id") + "/value") >= ob->query("officer_power") / 2) {
    message_vision(NOR, me);
    return 1;
  }
  message_vision(msg_dunno[random(sizeof(msg_dunno))], me, ob);
  message_vision(NOR, me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: query <someone>

这个指令让你可以对朝廷大臣询问朝中大事。
HELP
  );
  return 1;
}
