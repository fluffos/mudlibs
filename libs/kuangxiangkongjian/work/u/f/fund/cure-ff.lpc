// heal.c

#include <ansi.h>

int exert(object me,object target)
{
      if(me->query_skill("cure")<20)
          return notify_fail("你的医术太差，无法医治花柳病。\n");
           if(!target->query_condition("ff_poison"))
               return notify_fail("没有气血失调的人不需要医治。\n");
	if( me->is_fighting() )
          return notify_fail("战斗中不能医治。\n");

         if((int)me->query("force")<30)
             return notify_fail("你的内力不够，不能治疗气血失调。\n");

    if(me!=target)
     message_vision(
     HIY+"$N双掌抵住$n背心，运出内力替$n调息，过了不久，$n吐出一口瘀血，气血调合。\n" NOR,
     me,target);
    else 
      message_vision( HIY "$N坐了下来，开使调息，过了一会，内息开始恢复正常。\n" NOR,me);

     target->apply_condition("ff_poison",0);
          me->add("force",-30);

	return 1;
}
