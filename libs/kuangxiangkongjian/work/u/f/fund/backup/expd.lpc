
#include <ansi.h>

string *attr = ({
        "str","cor","int","spi","cps","dex","con","kar"
        });

int count_exp( object me ,object ob )
{
        int result;
        object weapon;
        string skill_type;
        result = ob->query("str") * ob->query("str");
        result += ob->query("cor") * ob->query("cor");
        result += ob->query("dex") * ob->query("dex");
        result += ob->query_temp("apply/damage") * ob->query_temp("apply/damage"
);
        result += ob->query_temp("apply/armor") * ob->query_temp("apply/damage")
;
        if( objectp(weapon = ob->query_temp("weapon")) )
                skill_type = weapon->query("skill_type");
        else
                skill_type = "unarmed";
        result += ob->query_skill(skill_type) * ob->query_skill(skill_type);
        result += ob->query_skill("parry") * ob->query_skill("parry");
        result += ob->query_skill("dodge") * ob->query_skill("dodge");
        if( userp(ob) ) return 0;
        return result * ( 100 + me->query("kar") ) / 20000 + 1;
}

int get_exp( object me ,object ob )
{
        int exp_gotten = count_exp( me , ob ) / 2 + random( count_exp( me , ob )
 );
        int money_gotten = count_exp( me,ob ) / 2 + random( count_exp( me,ob ) )
 + 20;
        if( userp(ob) ) money_gotten = 0 ;
        me->add("combat_exp",exp_gotten);
        me->add("money",money_gotten);
        tell_object(me,sprintf("你获得 %d 点经验值。\n",5 * exp_gotten));
        tell_object(me,sprintf("你获得 %d 个货币。\n",10 * money_gotten));
        return ( exp_gotten > 0 );
}

int attr_down( object me )
{
        int i;
        for(i=0;i<sizeof(attr);i++)
                if( me->query(attr[i])>1 ) me->add(attr[i],-1);
        tell_object(me,HIY "你的属性下降了。\n" NOR);
        return 1;
}

int status_down( object me )
{
        int old_exp = me->query("combat_exp");
        string class_file;
        me->add("combat_exp",-old_exp*9/10);
        tell_object(me,HIY "你的经验值下降了。\n" NOR);
        if( me->query("class") )
        {
                me->add("level",-1);
                class_file = "/daemon/class/"+me->query("class")+"/class.lpc";
                class_file->set_title( me );
                tell_object(me,HIY "你的等级下降了。\n" NOR);
        }
        attr_down( me );
        return 1;
}
