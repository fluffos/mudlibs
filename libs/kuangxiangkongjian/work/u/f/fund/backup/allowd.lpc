
#define ALLOW_FILE DATA_DIR + "allow"

inherit F_SAVE;


mapping guild = ([]) , skill = ([]) , goods = ([]) , sattack = ([]);

void add_guild(string ,string);
void remove_guild(string);
void add_skill(string ,string );
void remove_skill(string);
void add_goods(string,string);
void remove_goods(string);
void add_sattack(string,string);
void remove_sattack(string);
int is_allowed_guild(string);
int is_allowed_skill(string);
int is_allowed_goods(string);
int is_allowed_sattack(string);
mapping query_guild();
mapping query_skill();
mapping query_goods();
mapping query_sattack();

void create()
{
        seteuid(getuid());
        restore();
}

void remove() { save(); }

string query_save_file() { return ALLOW_FILE; }

void remove_guild( string guild_name )
{
        map_delete( guild , guild_name );
        save();
}

void add_guild(string guild_name,string writer)
{
        guild[ guild_name ] = writer;
        save();
}
void remove_skill(string skill_name)
{
        map_delete( skill, skill_name );
        save();
}
void add_skill(string skill_name,string writer)
{
        skill[ skill_name ] = writer;
        save();
}
void remove_goods(string goods_name)
{
        map_delete( goods, goods_name );
        save();
}
void add_goods( string goods_name , string writer )
{
        goods[ goods_name ] = writer;
        save();
}
void remove_sattack(string sattack_name)
{
        map_delete( sattack,sattack_name );
        save();
}
void add_sattack(string sattack_name,string writer)
{
        sattack[ sattack_name ] = writer;
        save();
}

int is_allowed_guild(string guild_name)
{
        if( guild[ guild_name ] ) return 1;
        return 0;
}
int is_allowed_skill(string skill_name)
{
        if( skill[ skill_name ] ) return 1;
        return 0;
}
int is_allowed_goods(string goods_name)
{
        if( goods[ goods_name ] ) return 1;
        return 0;
}
int is_allowed_sattack(string sattack_name)
{
        if( sattack[ sattack_name ] ) return 1;
        return 0;
}
mapping query_guild()
{
        return guild;
}
mapping query_skill()
{
        return skill;
}
mapping query_goods()
{
        return goods;
}
mapping query_sattack()
{
        return sattack;
}
