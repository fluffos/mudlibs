// shoot.c

inherit F_CLEAN_UP;
inherit SSERVER;

mapping types = ([
        "normal" : 1,
        "quick" : 2,
        "auto" : 3,
        ]);
int main(object me, string arg)
{
        object ob , weapon;
        string type , target;
        int result;

        seteuid(getuid());

        if( me->is_busy() )
                return notify_fail("( 你上一个动作还没有完成，不能射击。\n");

        if( !arg ) { ob = offensive_target( me ); type = "normal"; }
        if( arg ) { type = "normal"; ob = present(arg,environment(me)); }
        if( arg )
        if( sscanf(arg, "%s %s",type , target)==2 ) {
                if( !types[type] ) return notify_fail("没有这种射法。\n");
                ob = present( target , environment( me ) );
        }
        if( !ob ) return notify_fail("这里没有这个人哩。\n");
        if( !living(ob) ) return notify_fail("子弹很珍贵，不要浪费了。\n");

        if( !(weapon = me->query_temp("weapon")) ) return notify_fail("你空手想□
g什么 ?\n");
        if( !weapon->is_normal_shooting_object() ) return notify_fail("这种武器□
ㄞ鄍峔荇g击。\n");
        if( type == "quick" && !weapon->is_quick_shooting_object() ) return noti
fy_fail("这种武器不能使用快速射击。\n");
        if( type == "auto" && !weapon->is_auto_shooting_object() ) return notify
_fail("这种武器不能使用自动射击。\n");
        if( !weapon->query("bullet") ) return notify_fail("没有装子弹，射不出东□
閮荂C\n");
        switch( types[type] )
        {
                case 1 : weapon->normal_shoot( me , ob );
                         break;
                case 2 : weapon->quick_shoot( me , ob );
                         break;
                case 3 : weapon->auto_shoot( me , ob );
                         break;
        }
        ob->kill_ob(me);
        return 1;
}

int help (object me)
{
        write(@HELP
HELP
        );
        return 1;
}
