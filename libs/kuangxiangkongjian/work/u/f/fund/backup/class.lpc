

mapping guild_data = ([
        "guild_name" : "特异功\能组",
        "class_name" : "超能者",
        ]);

string *title = ({
        "新手修行士",
        "进阶修行士",
        "中级修行士",
        "资深修行士",
        "高级修行士",
        "新进超能者",
        "进阶超能者",
        "中级超能者",
        "资深超能者",
        "高级超能者",
        "超级超能者",
        "究极超能者",
        });

mapping guild_skills = ([
        "unarmed":      40,
        "dodge":        70,
        "parry":        50,
        "outstanding":  100,
        "super-eyes": 40,
        "fly-action": 60,
        "magnetism": 100,
        ]);

int set_title( object );
int valid_join(object me)
{
        return 1;
}

int join(object me)
{
        me->add("str",-3);
        me->add("int",5);
        me->add("spi",5);
        me->add("dex",-3);
        me->add("max_int",20);
        me->add("max_str",-20);
        me->add("max_spi",20);
        me->add("max_dex",-20);
        if(me->query("str")<1) me->set("str",1);
        if(me->query("dex")<1) me->set("dex",1);
        set_title(me);
        return 1;
}

int attrup(object me)
{
        return 1;
}

int set_title( object me )
{
        int level = me->query("level");
        me->set("title",( level < sizeof(title) ? title[level-1] : title[sizeof(
title)-1] ) );
        return 1;
}
int levelup( object me )
{
        set_title( me );
        return 1;
}

mapping query_data()
{
        return guild_data;
}

mapping query_guild_skills()
{
        return guild_skills;
}
