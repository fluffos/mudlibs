void friend_out(string str);
string call_friend() {
  object me, obj;
  mapping dict;
  int i;
  me = this_player();
  if (!me->query("friend"))
    return "我不记得你有什么伙伴啊 ?\n";
  dict = me->query("friend");
  for (i = 0; i < sizeof(dict); i++)
    friend_out(dict[i]);
  return "你的伙伴等你恨久了。\n";
}
void friend_out(string str) {
  object obj;
  if (str == "none") return;
  obj = new(str);
  obj->move(environment(this_player()));
  message_vision(
    "$N的伙伴$n愉快的走了出来。\n", this_player(), obj);
}
int add_friend(string npc_dir) {
  mapping dict;
  dict = this_player()->query("friend");
  if (sizeof(dict) >= this_player()->query("kar") / 5)
    return notify_fail("你的同伴个数到达极限");
  dict[sizeof(dict)] = npc_dir;
  this_player()->set("friend", dict);
  return 1;
}
int friend_die(object npc) {
  mapping dict;
  int i;
  dict = this_player()->query("friend");
  for (i = 0; i < sizeof(dict); i++)
    if (dict[i] == base_name(npc))
      dict[i] = "none";
  this_player()->set("friend", dict);
  return 1;
}
