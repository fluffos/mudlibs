
// depoison.c

#include <ansi.h>

int exert(object me)
{
        int need;

        if(me->query_skill("force")/2+me->query_skill("haoforce", 1)<20)
          return notify_fail("你的内功练得不够精深，无法逼毒。\n");
        if( me->is_fighting() )
          return notify_fail("战斗中不能逼毒。\n");
        if((int)me->query("kee")<30 || (int)me->query("sen")<30 )
          return notify_fail("你的精或神不够，不能逼毒。\n");
        
        if((need=me->query_condition("snake_poison")*2)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起浩日心法\把蛇毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("snake_poison", 0);
        }
        else if((need=me->query_condition("flower_poison")*2)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起浩日心法\把花柳病毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("flower_poison", 0);
        }
        else if((need=me->query_condition("dark_poison")*3)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起浩日心法\把深宫奇毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("dark_poison", 0);
        }
        else if((need=me->query_condition("rose_poison")*3)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起浩日心法\把火玫瑰毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("rose_poison", 0);
        }
        else if((need=me->query_condition("five_poison")*4)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起浩日心法\把五毒神掌之毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("five_poison", 0);
        }
        else if((need=me->query_condition("ff_poison")*5)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起浩日心法\把无名之毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("ff_poison", 0);
        }
        
        else if((need=me->query_condition("fire_poison")*6)!=0)
        
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                if( (int)me->query("force")< 140-(me->query_skill("haoforce", 1)) )
                        return notify_fail("你受伤过于沉重, 冒然逼毒将会有生命的危险。\n");
                message_vision(
                HIW"$N运起浩日心法\努力地将火云邪毒给逼了出来, 自己仍受相当的内伤。\n"NOR, me);
                me->add("force", -need*2);
                me->add("kee"  , -(120-(me->query_skill("haoforce", 1)));
                me->apply_condition("fire_poison", 0);
        }

        return notify_fail("你并无中毒或是你所中的毒本心法尚无法解之，请自己保重。\n");
        return 1;
}
