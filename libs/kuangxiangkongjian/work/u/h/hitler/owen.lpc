
// owen.c

inherit NPC;
void do_special();
void create()
{
        set_name("欧文", ({ "South Cross Star Knight Lieutenant Owen ", "knigt" , "lieutenant", "owen" }) );
        set("title","南十字星骑士团副团长");
        set("nickname", "[33m棕熊[0m");
        set("gender", "男性");
        set("age", 41);
        set("attitude", "aggressive");
        set("long",
                   "欧文是日耳曼远征军南十字军骑士副团团长，看他满脸的胡须与壮硕\n"
"的体格不难了解其绰号，当然其力量也与绰号相称\n");

        set("str", 55);
        set("cps", 20);
        set("per", 24);
        set("int", 20);
        set("kar", 22);
        set("con", 60);
        set("kee", 1500);
        set("combat_exp"  , 950000);


        set_skill("move",70);
        set_skill("unarmed", 60);
        set_skill("parry", 80);
        set_skill("dodge", 40);
        set_skill("axe",   100);

        set("chat_chance_combat",90);
        set("chat_msg_combat",({
        (: do_special :)
        }));

        set_temp("apply/armor",400);
        set_temp("apply/attack",160);

        setup();

//      carry_object("
//      carry_object("plumage")->wear();
        add_money("gold",8);
}

void do_special()
  {
        object *enemy,target;     
     int i;
        target=this_object()->query_enemy();
        i=sizeof(enemy);
        target=enemy[random(i)];


                message_vision(
                "\n欧文的大斧直劈地上大喊，[33m ‘  大  地  震  撼  波  ’ [0m  \n",target);
                message_vision(
                "\n$欧文手上的大斧发出阵阵波动，大地产生无比的震撼，一股强大能量从地面涌向群众!!\n",target);
                target->start_busy(3);
                target->receive_wound("kee",random(80+50));
                COMBAT_D->report_status(target);

  }
