
// fighter_robe.c

#include <armor.h>
 
inherit CLOTH;
 
void create()
{
        set_name( "[1;34m□[1;30ma[1;30m□[1;34m□[0m□服", ({ "pale moon cloth","cloth"}) );
        set("long",
                   "传说神匠九鬼浩三用尽毕生之力，使用月皇石精炼成丝\n"
                   "编织成这一件充满灵力的衣服，只有绝世强者才有能力\n"
                   "驾驭此惊世的杰作!!\n");
        set_weight(4000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit"              , "件");
                set("material"          , "crimsonsteel");
                set("armor_prop/armor"  ,  30);
                set("armor_prop/dodge"  ,  10);
                set("armor_prop/parry"  ,  10);
        }

        setup();
}
