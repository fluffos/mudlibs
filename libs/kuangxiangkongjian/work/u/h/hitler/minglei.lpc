//nine-blade.c
#include <weapon.h>
#include <ansi.h>


inherit BLADE;
void create()
{
        seteuid(getuid());
        set_name("逆刃  [1;34m□[0;36m□[1;34m□[0;36mp" NOR,({"blade minglei","blade"}));
        set_weight(16000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
        set("long","一把刀刃于刀背的特殊日本刀, 深沉无刃的刀身闪烁着青色的光芒, \n刀柄上缘刻有 [1;34m鸣雷[0m 两字 .\n");
                set("value",100000);
                set("material", "crimsonsteel");
        set("wield_msg", "$N从腰部的刀鞘中抽出$n,顿时$n发出阵阵骇人的雷声。\n");
        set("unwield_msg", "$N将手中的$n收回刀鞘中, 那摄人的震撼也随之停止。\n");
        }
        init_blade(120);
        setup();
}
