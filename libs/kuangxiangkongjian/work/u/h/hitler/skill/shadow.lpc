
// shadow-steps.c
 
inherit SKILL;
 
string *dodge_msg = ({
        " $n轻轻地回侧过身舞出了「逐影幻日”, 凝聚于全身的灵力透出光华万丈,
          直逼$N的双眼, 晕眩了$N的目光./n",
        " $n双足一蹬舞出了「化影藏月”, 以极快的速度幻化出无数残影, 翩翩舞步
  错乱了$N的心神./n",
        " $n从水袖中散出漫天花雨, 一式「离影舞蝶”顺着$N的攻击翩然一回身隐没
          于花影之中./n',
        " $n一式「追影摘星”, 轻点数步飞身一跃犹如嫦娥奔月, 飘散阵阵花香./n",
        " $n轻轻一旋身使出了「残影乱梦”, 快速移动的残像迟疑了$N的动作./n",
});
int valid_enable(string usage) {
        return (usage=="dodge")||(usage=="move");
}
int valid_learn(object me)
{
        return 1;
}
 
string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}
 
int practice_skill(object me)
{
        if((int)me->query("kee")<5)
                return notify_fail("你的气不够，不能练月影迷踪 。\n");
        me->receive_wound("kee",5);
        return 1;
}
