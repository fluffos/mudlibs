// shadow-steps.c

inherit SKILL;

string *dodge_msg = ({
  " $n轻轻地回侧过身舞出了「逐影幻日”, 凝聚于全身的灵力透出光华万丈,
          直逼$N的双眼, 晕眩了$N的目光./n",
  " $n双足一蹬舞出了「化影藏月”, 以极快的速度幻化出无数残影, 翩翩舞步
  错乱了$N的心神./n",
  " $n从水袖中散出漫天花雨, 一式「离影舞蝶”顺着$N的攻击翩然一回身隐没
          于花影之中./n',
        " $n 一 式 「 追 影 摘 星 ”, 轻 点 数 步 飞 身 一 跃 犹 如 嫦 娥 奔 月, 飘 散 阵 阵 花 香./ n ",
        " $n 轻 轻 一 旋 身 使 出 了 「 残 影 乱 梦 ”, 快 速 移 动 的 残 像 迟 疑 了 $N 的 动 作./ n ",
});
int valid_enable(string usage) {
        return (usage==" dodge ")||(usage==" move ");
}
int valid_learn(object me)
{
        return 1;
}
 
string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}
 
int practice_skill(object me)
{
        if((int)me->query(" kee ")<5)
                return notify_fail(" 你 的 气 不 够 ， 不 能 练 月 影 迷 踪 。 \ n ");
        me->receive_wound(" kee ",5);
        return 1;
}
