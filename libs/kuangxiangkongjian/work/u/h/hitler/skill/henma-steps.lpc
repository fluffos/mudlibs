
// henma-steps.c

inherit SKILL;

string *dodge_msg = 
({

      "$n使出幻灭岚影闪避$N的攻击，若隐若现，宛如幻影，躲了过去。\n",
      "$n用一招幻灭岚影中的「雾影飘渺”，$n身影消失于雾中，使$N此招无从下手。\n",
      "$n步法扑朔迷离，似实似虚，一瞬间从$N的身旁绕了过去。\n",
      "$n连踏七步，忽然身分七影，使$N无所适从，不知虚实，正是幻灭岚影中的「山岚无迹”! \n",
      "$n悟出幻灭岚影最高精华「无想转生”，犹如幻化转生般，使$N的一切攻击皆随之逝去！",

});

int valid_enable(string usage) 
{
        return (usage=="dodge")||(usage=="move");
}

string query_dodge_msg(string limb)
{
  int dodge_pow;
  object me=this_player();

        dodge_pow = (int)(me->query_skill("henma-steps", 1)/10);
        if ( dodge_pow <= 5)
              return dodge_msg[random(4)];
        else
              return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
        if(me->query ("combat_exp") <= (me->query_skill("linpo-steps",1)*6) )
          return notify_fail("你的战斗经验不足，无法体会幻灭岚影中精妙身法。\n");
        return 1;
}


int practice_skill(object me)
{
        if((int)me->query("kee")<5)
                return notify_fail("你的气不够，不能练幻灭岚影。\n");
        me->receive_wound("kee",5);
        return 1;
}
