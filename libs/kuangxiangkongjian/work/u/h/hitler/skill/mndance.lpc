int valid_learn(object me)
{
 if(!(ob=me->query_temp(" weapon ")) ||(string)ob->query(" skill_type ")!=" whip ")
      return   notify_fail(" 学 太 幻 影 月 之 舞 必 须 要 有 装 备 唷 ^ __ ^ 。 \ n ");
      return   1;
}
 
int valid_enable(string usage)
{
        return ( usage==" dance " || usage==" parry " );
}
 
string query_parry_msg(string limb)
{
  int parry_pow;
  object me=this_player();
               return parry_msg[random(sizeof(parry_msg))];
}
 
mapping query_action(object me, object weapon)
{
int skill_level, limit;
        skill_level = (int)(me->query_skill(" moondance ", 1));
        limit= (int)(skill_level/10);
        if (limit < 5 )
                return action[random(limit)];
        else
                return action[random(sizeof(action))];
}
 
void berserk(object me, object victim, object  weapon, int damage)
{
    int lose,batter,i,test,pow,pow1;
        pow1 = 0;
        pow  = 0;
        if(!me->query_temp(" berserk " ))
        {
            batter = (int)(me->query_skill(" moondance ", 1)/10 + 2);
            if( batter==2 )
                lose = 3 ;
            else
                lose = 3 + batter/4 ;
 
            me->set_temp(" berserk ", 1);
            for(i = 0;i < lose; i++)
                {
                    pow = random(6);
                    pow1 = pow1+pow;
                    me->set_temp(" apply / attack ", pow1);
                    message_vision(
                    " $N 回 眸 一 笑 纤 腰 轻 挪, 太 幻 影 月 之 舞 应 运 而 生 !!\ n ",me,victim);
                    COMBAT_D->do_attack(me, victim, me->query_temp(" weapon "));
                }
                me->delete_temp(" apply / attack ");
                me->delete_temp(" berserk ");
        }
      lose = 0 ;
      batter = 0 ;
}
int practice_skill(object me)
{
  if( (int)me->query(" shen ") < 10 )
          return notify_fail(" 你 的 精 神 不 够 了 ， 休 息 一 下 再 练 吧 。 \ n ");
  if( (int)me->query(" force ") < 5 )
          return notify_fail(" 你 的 内 力 不 够 了 ， 休 息 一 下 再 练 吧 。 \ n ");
  if( (int)me->query_skill(" literate ") <= ((int)(me->query_skill(" moondance ",
  1)*0.75) ) )
          return notify_fail(" 你 学 艺 不 精 ， 无 法 参 透 更 深 的 技 艺 。 ");
 
        me->receive_damage(" shen ", 10);
        me->add(" force ", -5);
        return 1;
}
