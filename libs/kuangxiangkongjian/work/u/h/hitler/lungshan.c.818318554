// lungshan.c

#include <ansi.h>
#include <combat.h>
inherit SKILL;
inherit SSERVER;

void berserk(object me, object victim, object  weapon, int damage);

string *dodge_msg=
    ({
      "$n使出泷山绝学中的隐雾身法，若隐若现，躲了过去。\n",
      "$n用一招隐雾身法中的「雾影飘渺”，$n身影消失于雾中，使$N此招无从下手。\n",
      "$n步法扑朔迷离，似实似虚，一瞬间从$N的身旁绕了过去。\n",
      "$n悟出隐雾身法最高精华「无想转生”，犹如幻化转生般，使$N的一切攻击皆随之逝去！",
    });
mapping *action = ({
        ([      
                "action"     :               "$N使出泷山绝学的起手式，一招「飞瀑入山”，对准$n的$l打出难以捉摸的一拳",
                "dodge"      :               -25,
                "parry"      :                20,
                "damage_type":               "瘀伤"
        ]),
        ([     
                "action"     :               "$N犹如流水般随$n的攻势，使出一招「追瀑溯源”便往$n的$l反击过去",
                "dodge"      :               -50,
                "parry"      :                10,
                "damage"     :                20,
                "damage_type":               "瘀伤"
        ]),
        ([   
                "action"     :               "$N大喝一声，双拳一提，一招「五岳顶天”往$n的五个要害击出",
                "dodge"      :                40,
                "parry"      :               -30,
                "damage"     :                15,
                "damage_type":               "瘀伤"
        ]),
        ([  
                "action"     :               "$N步履一沉，凝神聚气，双拳连下使出「千川百岳”击向$n$l",
                "dodge"      :               -20,
                "parry"      :                30,
                "damage"     :                20,
                "damage_type":               "瘀伤"
        ]),
        ([ 
                "action"     :               "$N纵身一跃，使出泷山拳奥义「山泉群涌”，拳如连珠般一连数十拳击向$n$l",
                "dodge"      :                20,
                "parry"      :               -20,
                "damage"     :                60,
                "force"      :                130,
                "post_action":               (: berserk :),
                "damage_type":               "瘀伤"
        ]),
        ([
                "action"     :               "$N双拳交错，运足真气，使出泷山拳奥义「山穷水尽”，万钧之力击向$n$l，难以招架",
                "dodge"      :               -10,
                "parry"      :               -35,
                "damage"     :                80,
                "force"      :                240,
                "damage_type":               "瘀伤"
        ]),
        ([
                "action"     :               "$N拳散灵气，霎时狂风四起，无穷真气自$N身旁涌出，使出泷山拳秘奥义「山河俱灭”，$n$l将受可怕之力所毁灭",
                "dodge"      :               -50,
                "parry"      :               -50,
                "damage"     :                150,
                "force"      :                300,
                "damage_type":               "瘀伤"
        ]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return   notify_fail("学泷山绝学必须空手。\n");
        return   1;
}

int valid_enable(string usage)
{
        return ( usage=="unarmed" || usage=="dodge" );
}

string query_dodge_msg(string limb)
{
  int dodge_pow,me;
        dodge_pow = (int)(me->query_skill("lungshan", 1)/10);
          if ( dodge_pow <= 5)
                return dodge_msg[random(3)];
            else

                return dodge_msg[random(sizeof(dodge_msg))];
}

mapping query_action(object me, object weapon)
{
int skill_level, limit;
        skill_level = (int)(me->query_skill("lungshan", 1));
        limit= (int)(skill_level/10);
        if (limit < 4 )
                return action[random(4)];
        if (limit < 7 )
                return action[random(limit)];
        else if (limit < 9)
                return action[random(6)];
        else
                return action[random(sizeof(action))];
}

void berserk(object me, object victim, object  weapon, int damage)
{
    int lose, i, test,pow,pow1;
        pow1 = 0;
        pow  = 0;
        if(!me->query_temp("berserk" ))
        {
                lose = (int)(me->query_skill("lungshan", 1)/20 + 1);
                me->set_temp("berserk", 1);
                for(i = 0;i < lose; i++)
                {
                        pow = random(4);
                        pow1 = pow1+pow;
                        me->set_temp("apply/attack", pow1);
                        message_vision(
                        HIY "$N使出泷山拳法之狂击技，如山泉涌出般打向$n各致命弱点。\n" NOR, me, victim);
                        COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));
                }
                me->delete_temp("apply/attack");
                me->delete_temp("berserk");
        }
} 


int practice_skill(object me)
{
        if( (int)me->query("kee") < 40 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 5 )
                return notify_fail("你的内力不够了，休息一下再练吧。\n");
        if( (int)me->query_skill("literate") <= ( (int)(me->query_skill("lungshan", 1)*0.75) ) )
                return notify_fail("你的武学知识不足，似乎无法参透绝学中山水之义。");
        me->receive_damage("kee", 40);
        me->add("force", -5);
        return 1;
}
