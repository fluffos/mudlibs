
// keith.c

inherit NPC;
void do_special();
void create()
{
        set_name("奇斯", ({ "South Cross Star Knight Lord keith ", "knigt" , "lord", "keith" }) );
        set("title","南十字星骑士团团长");
        set("nickname", "[1;33m金鹰[0m");
        set("gender", "男性");
        set("age", 38);
        set("attitude", "aggressive");
        set("long",
                   "奇斯是日耳曼远征军南十字军骑士团团长，同时亦是骑士团中最强的\n"
"男人，由于其金发与其高超的剑术获得了‘金鹰’的称号\n");

        set("str", 35);
        set("cps", 40);
        set("per", 44);
        set("int", 40);
        set("kar", 26);
        set("con", 40);
        set("kee", 1200);
        set("combat_exp"  , 1000000);

        set_skill("move",70);
        set_skill("unarmed", 60);
        set_skill("sword", 120);
        set_skill("parry", 120);
        set_skill("dodge", 80);


        set("chat_chance_combat",90);
        set("chat_msg_combat",({
        (: do_special :)
        }));

        set_temp("apply/armor",200);
        set_temp("apply/attack",140);

        setup();

//      carry_object("
//      carry_object("plumage")->wear();
        add_money("gold",10);
}

void do_special()
  {
    object *enemy,target;
    int i;
  
        enemy=this_object()->query_enemy();
        i=sizeof(enemy);
        target=enemy[random(i)];

                message_vision(
                "\n奇斯举剑大喝，[1;33m ‘  鹰  王  飓  风  斩  ’ [0m  \n",target);
                message_vision(
                "\n奇斯手上的剑刃透出阵阵金光，镰型金光宛如飓风般射向敌人!!\n",target);
                target->receive_wound("kee",random(100+50));
                COMBAT_D->report_status(target);

  }
