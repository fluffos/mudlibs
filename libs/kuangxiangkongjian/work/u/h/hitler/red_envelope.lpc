// bag.c

inherit ITEM;

void create() {
  set_name("红包", ({ "Red envelope", "envelope" }));
  set_weight(500);
  set_max_encumbrance(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "口");
    set("long", "这是一口有着巫师祝福的红包, 里面充满着FS的欢乐及关怀!!\n");
    set("value", 1);
  }
  setup();
}

int is_container() {
  return 1;
}
