//  /u/h/hugh/npc/guard.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("紫月心",({"wasing"}));
	set("long","一位气质高尚的美女，风度优雅，手持轻萝小扇。\n");
	set("title","柳月居主的女儿");
	set("gender","女性");
  set("combat_exp",80000);
	set("attitude","peaceful");
	set("age",12);
	set_skill("unarmed",5);
	set_skill("parry",5);
	set_skill("dodge",5);
	set("chat_chance_combat",50);
	set("chat_msg_combat",({
	  "柳月心说道：你忍人动手打我这弱不禁风的身子吗???。\n",
	  "柳月心说道：我要告诉我爸爸啦，讨厌人家不理你了啦。\n",
	}));
	set("greeting_msg",({
	  "柳月心说道：欢迎光临柳月居，快来和我一起玩游戏吧。\n",
	}));
	set("chat_chance",1);
	set("chat_msg",({
	"紫月心说道：唉唷!!我的脚好痛,谁来帮帮我 ??\n"
	}));
	setup();
	add_money("coin",10);
}
