inherit BULLETIN_BOARD;

void create() {
  set_name("柳絮拂月版", ({ "hugh board", "board" }));
  set("location", "/u/h/hugh/workroom");
  set("board_id", "hugh_b");
  set("long", "柳絮片片飞,流言句句留\n");
  setup();
  set("capacity", 30);

}

string query_save_file() {
  return "/u/h/hugh/" + query("board_id");
}
