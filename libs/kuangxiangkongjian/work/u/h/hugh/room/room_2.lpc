#include <ansi.h>
#include   "/open/open.h"

inherit ROOM;
         
void create ()
{
  set("short",HIR"浮白轩"NOR);

  set("long",@LONG
     眼前只看一片的白,硕大的池溏中,只看无数不知名的小白花
     暗暗的浮动的幽香,池旁的杨柳青垂,水中鱼儿不时的探出头
     来,晚风徐徐,夕阳依依,不禁使人想起马致远的诗句--小桥,
     流水,人家....真令人徒生无限感概呀!!
[A.
LONG+NOR);

     set("exits",([ /* sizeof == 5 */ 
    "east":"/u/h/hugh/workroom.lpc",
]));
	set("light_up",1);
	setup();
}
