#include <ansi.h>
#include <room.h>
inherit ROOM;

void create ()
{
  set ("short", "弃剑阁");
  set ("long", @LONG

      继当年以独孤九剑 ‘行遍天下，但求一败’ 而不得，遂弃剑于此，
      叹天下无人。南面的墙上挂着一幅画 (picture)，吸引了你的目光。
      在北边的墙脚有个古怪的印记 (key)。

LONG);

  set("item_desc", ([ /* sizeof() == 2*/
   "picture" : "图上绘着青山碧水，小桥人家，世外桃源也不过如此。\n",
   "key"     : "剑魔的小神剑标记，看来可以移动 (move)。\n",
]));

  set("exits", ([ /* sizeof() == 3 */

  "west" : __DIR__"h2",
  "down" : "/u/p/ppopp/popdoor",
  "pop" : "/u/p/ppopp/workroom",
]));
  set("light_up", 1);
  set("valid_startroom", 1); 
  setup();
  call_other("/u/h/hanzo/hanzo_b.lpc","???");
}

void init()
{
  add_action("do_key","move");
  add_action("do_touch","touch");
}

int do_key(string str)
{
 object ob=this_player();
 int kee1;
 if(str!="key") return 0;

 if(ob->query("id") == "hanzo"||ob->query("id") == "ppopp") 
 {
   write(" 「喀”的一声，你推动了暗门。\n");
   write(" 你进入了密室。\n");
   ob->move(__DIR__"r5");
   return 1;
 }
 else
 {
   kee1 = ob->query("kee")+5;
   tell_object(ob,"你触动了机关，只觉脚下一虚，身子直往下坠.....\n");
   message_vision(HIW"只听到$N一声惨叫，$N已失去踪迹\n"NOR,ob);
   write(HIR"好好反省吧!!\n"NOR);
   ob->set("env/immrotal","no");
   ob->add("kee",-kee1);
   ob->move(__DIR__"r10");
   return 1;
  }  
}

int do_touch(string str)
{
  if (str != "picture") return 0;

  tell_object(this_player(),"右边的墙缓缓移出一道门。\n");
  add("exits/east", __DIR__"r4");
  return 1;
}

