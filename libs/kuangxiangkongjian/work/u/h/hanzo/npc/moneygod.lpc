#include <ansi.h>

inherit NPC;

void create()
{
     set_name("财神", ({ "moneygod" }) );
     set("race", "人类");
     set("gender", "男性");
     set("age",2500);
     set("long", "慈祥和霭的财神，以散财为乐。");

     set("str", 30);
     set("cor", 30);

     set("max_kee", 4000);
     set("max_force", 5000);
     set("force", 5000);

     set("force_factor", 20);
     set("combat_exp", 250000);
     set("no_kill",1);
     set("chat_chance", 10);
     set("chat_msg",({
          "财神说道: 恭喜发财!!\n",
          "财神说道: 新春如意!!\n",
          "财神说道: 步步高升!!\n",
        }) );
        set("inquiry", ([
         "红包" :    "要红包??规矩总该懂一点吧....",

         "规矩" :    "教你一个乖, 就是拜年啦....",
         "拜年" :    "要向我拜年??拜年要跪 (kneel) 的吧??",
        ]));
        setup();
    add_money("/obj/money/gold",10);
}


void init()
{
  add_action("do_bi","kneel");
}

int do_bi()
{
  object me=this_player();
  if(me->query("quest/have_pack")!=1)

  {
    message_vision("$N跪了下去，向财神拜年。\n",me);
    command("smile");
    message_vision("财神拍拍$N的头。\n",me);
    command("say 我最喜欢有礼貌的孩子");
    message_vision("财神给$N一个"+HIR"红包"NOR+
     "，打开一看，是张千两银票。\n",me);
    new("/obj/money/thousand-cash")->move(me);
    command("say 愿你在新的一年中，事事顺利!!");
    this_player()->set("quest/have_pack",1);
    return 1;  
  }
  else
  {
   command("stare "+me->query("id"));

   command("wake "+me->query("id"));
   message_vision("拜一次就够啦，没有天天在过年啦！\n",me);
   return 1;
  }
}

