inherit BULLETIN_BOARD;

void create()
{
     set_name("服部半藏小板板", ({ "board" }) );
     set("location", "/u/h/hanzo/workroom");
     set("board_id", "hanzo_b");
     set("long", "小小板板用途多，有水无水任意留。\n");
     setup();
     set("capacity", 100);
 // 设这样就能让那些人 discard post 啰
     set("master", ({"hanzo"}));
}
string query_save_file()
{
  return "/u/h/hanzo/hanzo_b" ;
}

