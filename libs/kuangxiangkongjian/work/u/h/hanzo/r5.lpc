#include <room.h>
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "独孤求败和琪琪的卧房");
  set ("long", @LONG

  远离世俗的烦扰，琪琪和独孤求败刻意营造的一个属于他们自己的空间。房
  间中央有张大床，床上垫的是级品的羊毛毯，盖的是最佳的羽毛绣花被。枕
  头上绣着一对鸳鸯，两只的头都是白色的。踩在脚下的是长毛的波斯地毯，
  在左上角绣着‘御赐贡品’四个字。房间中光线充足，通风良好，实在是一
  个令人心旷神怡的舒适环境。

  这儿是不对外开放的，若有误闯此地的，请尽快离开吧！以免主人不高
  兴之下，把你禁锢起来。

LONG);

  set("exits", ([ /* sizeof() == 3 */
  "south" : __DIR__"h2",
  "southwest" : "/u/p/ppopp/workroom",
  "southeast" : __DIR__"workroom",
]));
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}

