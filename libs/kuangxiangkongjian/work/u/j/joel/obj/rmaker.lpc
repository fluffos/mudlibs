	   "desc"	: "请输入 <物件档名> <数量>",
	   "status"	: 5,// mapping 到整数
	]),
]);

string	*key = keys(tmp);
int	size_of_tmp=sizeof(key);
int      value, index;
string   key2, str;
function back1, back2;

nosave mapping oppdir = ([
  "east"	:	"west",
  "west"	:	"east",
  "north"	:	"south",
  "south"	:	"north",
  "northeast"	:	"southwest",
  "southwest"	:	"northeast",
  "northwest"	:	"southeast",
  "southeast"	:	"northwest",
  "up"		:	"down",
  "down"	:	"up",
]);

string *special_props = ({
	"short", "long" });

int create()
{
	set_name("房间编辑器" + RMK_VERSION, ({ "room maker", "maker" }) );
	set_weight(100);
	set("unit", "个" );
	set("long", @LONG
这是一个用来「快速”制造房间的工具，帮助时间不多或有严重  lag 的巫师
利用线上输入制造简单的房间，不过如果你想提高自己区域房间的品质，最好
不要太依赖这个东西, 当你制造房间时, 会有一堆问题, 如果你想用预设值,
请直接按 enter, 如果想放弃, 请用句点结束。

mkroom <方向> <房间档名>        造出一个「空”房间
rset <房间属性> <属性内容> 	设定你目前所在房间的属性
uset <房间属性>			取消目前所在房间的某项属性
connect <方向> <房间档名> 	将你目前所在的房间连接一个出口到另一个房间。
dconnect <方向>			取消一个出口
addobj <物件档名> <个数>	在该房间增加物件
delobj <物件档名>		取消该房间的物件
saveroom  			将你目前所在的房间存档。

注意: 可以用 help roommaker 取得详细解说
LONG
	);
}

int init()
{
	if( wizardp(environment()) ) {
		seteuid(getuid(environment()));
		add_action("do_mkroom", "mkroom");
		add_action("do_rset", "rset");
		add_action("do_uset", "uset");
		add_action("do_setlong", "setlong");
		add_action("do_connect", "connect");
		add_action("do_dconnect", "dconnect");
		add_action ("do_addobj", "addobj");
		add_action ("do_delobj", "delobj");
		add_action("do_saveroom", "saveroom");
	}
}

string abbr (string rep)
{
  if (rep == "e") return "east";
  else if (rep == "w") return "west";
  else if (rep == "s") return "south";
  else if (rep == "n") return "north";
  else if (rep == "ne") return "northeast";
  else if (rep == "nw") return "northwest";
  else if (rep == "se") return "southeast";
  else if (rep == "sw") return "southwest";
  else if (rep == "u") return "up";
  else if (rep == "d") return "down";
  return rep;
}

void done_int ()
{
  if (value != -MAXINT)
    tmp[key[index]]["value"] = value;
  else tmp[key[index]]["value"] = tmp[key[index]]["def"];
  index++;
  (*back1)();
}

int get_int (string rep)
{
  int		done;

  write ("rep = "+rep+"\n");
  if (rep == ".") {
    write ("你放弃本次编辑。\n");
    return 1;
  }
  else if (rep == "") {
    value = -MAXINT;
    (*back1)();
    return 1;
  }
  else if (sscanf (rep, "%d", value) != 1) {
    write ("你的输入不是数字\n");
    write ("请重新输入: ");
    input_to ( "get_int", back1 );
    return 1;
  }
  (*back1)();
  return 1;
}

void done_stringyn ()
{
  if (str[0] == 'y' || str[0] == 'Y')
    input_to ( "get_string", "done_string" );
  else {
    tmp[key[index]]["value"] = "";
    get_setup();
  }
  return;
}

void done_string ()
{
  write ("index = "+index+"\n");
  if (str == "")
    tmp[key[index]]["value"] = tmp[key[index]]["def"];
  else
    tmp[key[index]]["value"] = str;
  (*back1)();
}

void get_string (string rep)
{
  if (rep == ".") {
    write ("你放弃本次编辑。\n");
    return;
  }

  str = rep;
  (*back1)();
  return;
}

void get_strings (string rep)
{
  if (rep == ".") {
    (*back1)();
    return;
  }
  else {
    str += rep+"\n";
    input_to("get_strings");
    return;
  }
}

void done_map_string ()
{
  write ("index= "+index+"\n");
  if (str == "") {
    write ("你没输入任何字元, 结束本 mapping\n");
    get_setup ();
  }
  else {
    tmp[key[index]]["value"][key2] = str;
    input_to ("get_mapping");
  }
  return;
}

void get_mapping (string rep)
{
  string	p1, p2;
  int		p3;

  write ("index = "+index+"\n");
  if (key2 == "") {
    key2 = "NEXT";
    input_to ("get_mapping");
    return;
  }

  if (rep == "") {
    get_setup ();
    return;
  }
  if (tmp[key[index]]["status"] == 3) { // mapping 到字串, 可多行
    str = "";
    write("结束离开用 '.'。\n");
    write("────────────────────────────────\n");
    input_to ( "get_strings", "done_map_string" );
    return;
  }
  else if (tmp[key[index]]["status"] == 4) { //  出口, 需要用到 abbr[]
    if (sscanf (rep, "%s %s", p1, p2) != 2) {
      write ("请输入 <项目> <内容>\n");
      input_to ("get_mapping");
      return;
    }
    key2 = abbr (p1);
    tmp[key[index]]["value"][key2] = p2;
    input_to ("get_mapping");
    return;
  }
  else {
    if (sscanf (rep, "%s %s", p1, p2) != 2) {
      write ("请输入 <项目> <内容>\n");
      input_to ("get_mapping");
      return;
    }
    if (sscanf (p2, "%d", p3) == 1)
      tmp[key[index]]["value"][p1] = p3;
    else {
      write ("你输入的应该含有数字才对。\n");
      input_to ("get_mapping");
      return;
    }
  }
}

int get_setup ()
{
  if (index >= size_of_tmp) return 1;
  if (key[index] == "file_name") {
    index++;
    get_setup ();
    return 1;
  }
  write ("接下来编辑 "+key[index]+" 这个项目\n--> "+
         tmp[key[index]]["desc"]+"\n");
  if (intp(tmp[key[index]]["value"])) {
    back1 = (function)get_setup();
    input_to ( "get_int" );
  }
  else if (stringp(tmp[key[index]]["value"])) {
    write ("get string\n");
    if (tmp[key[index]]["status"] == 0)
      input_to ( "get_string" );
    else if (tmp[key[index]]["status"] == 1) {
      write("结束离开用 '.'，取消输入用 '~q'。\n"+
            "───────────────────────────────\n");
      input_to ( "get_strings" );
    }
    else if (tmp[key[index]]["status"] == 2)
      input_to ( "get_string" );
  }
  else if (mapp(tmp[key[index]]["value"])) {
    write (key[index] + " 是一个 mapping, 需要成对设定, 请按 Enter 确定, 或按 . 取消本房间\n");
    key2 = "START_INPUT";
    input_to ( "get_mapping" );
  }
  return 1;
}

int do_connect(string arg)
{
        object from, to;
        mapping exits;
        string dir, file;

        from = environment(this_player());
        if( !arg || sscanf(arg, "%s %s", dir, file)!=2 )
                return notify_fail("指令格式：connect <方向> <房间档名>\n");
        dir = abbr(dir);
        file = resolve_path(this_player()->query("cwd"), file);
        to   = find_object (file);
        exits = from->query("exits");
        if( mapp(exits) )
                exits[dir] = file;
        else
                from->set("exits", ([ dir: file ]) );
         write("Ok.\n");
        return 1;
}

int do_mkroom(string arg)
{
  string	here, dir, *key;
  int		status=0, i;

  if (!arg) return
    notify_fail ("mkroom [<方向> <房间的档名>] 或 mkroom <房间的档名>\n"+
		 "例如: mkroom east /u/w/wade/workroom\n");
  here	= file_name (environment(this_player()));
  if (sscanf (arg, "%s %s", dir, arg) == 2) {
    arg = resolve_path(this_player()->query("cwd"), arg);
    if ( oppdir[dir] != "" ) {
      tmp["exits"][oppdir[dir]] = here;
    }
    do_connect (dir+" "+arg);
  }
  else
    arg = resolve_path(this_player()->query("cwd"), arg);
  
  if (arg == here) {
    write ("请输入档名, 请勿命名为 "+here+" : ");
    input_to ( "get_file_name" );
  }
  else {
    index = 0;
    tmp["file_name"] = arg;
    write ("预定编辑的档案名称是 : "+arg+"\n");
    get_setup ();
  }
  return 1;
}

int do_delobj (string arg)
{
	mapping objects;
	object	ob;
	string file;
	int	num;

	if( !arg || sscanf(arg, "%s", file)!=1 )
		return notify_fail("指令格式：delobj <物件档名>\n"
                                   "      如: delobj /open/su/obj/cloth\n");
	objects = environment(this_player())->query("objects");
	if (ob=present (file, environment(this_player()))) {
	  file = resolve_path(this_player()->query("cwd"), file);
	  if( mapp(objects) )
		map_delete (objects, file);
	  destruct (ob);
	  write("Ok.\n");
	  return 1;
	}
	else
	  return notify_fail ("系统告诉你, 没这样东东: "+file+"\n");
}

int do_addobj (string arg)
{
  mapping objects;
  string file;
  object ob, me;
  int	num;

  if( !arg || sscanf(arg, "%s %d", file, num)!=2 )
    return notify_fail("指令格式：addobj <物件档名> <物件个数>\n");
  me = this_player();
  file = resolve_path(me->query("cwd"), file);
  ob = new (file);
  if (!ob) return notify_fail ("系统告诉你: 没那个物件: "+file+"。\n");
  ob->move(environment (me));
  objects  = environment(me)->query("objects");
  if( mapp(objects) )
    objects[file] = num;
  else
    environment(me)->set("objects", ([ file:num ]) );
  write("Ok.\n");
	
  return 1;
}

void done_setlong (object me, string text)
{
	environment(me)->set("long", text);
        return;
}

int do_setlong ()
{
  this_player()->edit( (: done_setlong, this_player() :) );
  return 1;
}

int do_uset(string arg)
{
	string prop, str;

	if( !arg || sscanf(arg, "%s", prop, str)!=1 )
		return notify_fail("指令格式：uset <房间属性>\n"
                                   "      如: uset light\n");

	environment(this_player())->unset(prop);
	write("Ok.\n");
	return 1;
}

int do_rset(string arg)
{
	string	prop, str;
	int	data;

	if( !arg || sscanf(arg, "%s %O", prop, str)!=2 )
		return notify_fail("指令格式：rset <房间属性> <属性内容>\n");

	if( sscanf(str, "%d", data) == 1 )
	  environment(this_player())->set(prop, data);
	else
	  environment(this_player())->set(prop, str);
	write("Ok.\n");
	return 1;
}

int do_dconnect(string arg)
{
	mapping exits;
	string dir;

	if( !arg || sscanf(arg, "%s", dir)!=1 )
		return notify_fail("指令格式：dconnect <方向>\n"
                                   "      如: dconnect east\n");
	dir = abbr(dir);
	exits = environment(this_player())->query("exits");
	if( mapp(exits) )
		map_delete (exits, dir);
	write("Ok.\n");
	return 1;
}

int save_room_file(string yn, string file, string str)
{
  string	tmp;
  int		i;

  if( strlen(yn)<1 || yn[0]!='y' ) return 1;

  i = sizeof(file)-1;
  if (!(file[i] == 'c' && file[i-1] == '.')) file = file+".lpc";
  write ("file name is " + file + "\n");
  if ( write_file(file, str, 1) ) {
    write("Ok.\n");
    return 1;
  }
  else {
    write ("roommaker 尝试写入("+file+")失败!!\n");
    return 0;
  }
}

void owner_is_killed() { destruct(this_object()); }

int save_file()
{
  string	room_code, *maps, file;
  int		i, n;

  // room_code 是房间的程式码, 底下这一段是所有房间的共通点
  room_code = "// Room: " + tmp["file_name"] + @ROOM_CODE

inherit ROOM;

void create()
{
ROOM_CODE;
  // 一直到这边结束

  room_code =
    sprintf ("%s  set (\"short\", \"%s\");\n"
               "  set (\"long\", @LONG\n%sLONG);\n\n",
             room_code, tmp["short"], tmp["long"]);
  if (tmp["no_clean_up"]) room_code =
    sprintf ("%s  set (\"no_clean_up\",        %d);\n", room_code,
             tmp["no_clean_up"]);
  if (tmp["no_fight"]) room_code =
    sprintf ("%s  set (\"no_fight\",           %d);\n", room_code,
             tmp["no_fight"]);
  if (tmp["no_magic"]) room_code =
    sprintf ("%s  set (\"no_magic\",           %d);\n", room_code,
             tmp["no_magic"]);
  if (tmp["valid_startroom"]) room_code =
    sprintf ("%s  set (\"valid_startroom\",    %d);\n", room_code,
             tmp["valid_startroom"]);
  if (tmp["outdoors"] != "") room_code =
    sprintf ("%s  set (\"outdoors\", \"%s\");\n", room_code,
             tmp["outdoors"]);
  if (n = sizeof (tmp["exits"]) ) {
    room_code =
      sprintf ("%s\n  set (\"exits\", ([\t//sizeof() == %d\n", room_code, n);
    maps = keys(tmp["exits"]);
    for (i=0; i<n; i++) {
      if (maps[i] != "") room_code =
        sprintf ("%s      \"%s\"\t:\t\"%s\",\n", room_code,
                 maps[i], tmp["exits"][maps[i]]);
    }
    room_code += "  ]) );\n\n";
  }
  if (n = sizeof (tmp["objects"]) ) {
    room_code =
      sprintf ("%s\n  set (\"objects\", ([\t//sizeof() == %d\n", room_code, n);
    maps = keys(tmp["objects"]);
    for (i=0; i<n; i++) {
      if (maps[i] != "") room_code =
        sprintf ("%s      \"%s\"\t:\t%d,\n", room_code,
                 maps[i], tmp["objects"][maps[i]]);
    }
    room_code += "  ]) );\n\n";
  }
  if (n = sizeof (tmp["item_desc"]) ) {
    room_code =
      sprintf ("%s\n  set (\"item_desc\", ([\t//sizeof() == %d\n", room_code, n);
    maps = keys(tmp["item_desc"]);
    for (i=0; i<n; i++) {
      if (maps[i] != "") room_code =
        sprintf ("%s      \"%s\"\t:\t\"%s\",\n", room_code,
                 maps[i], tmp["item_desc"][maps[i]]);
    }
    room_code += "  ]) );\n\n";
  }
  room_code += "  setup();\n  replace_program(ROOM);\n}\n";
  
  // Replace current directory with __DIR__ macro to make relocatable code.
  // write("所有 room/obj 以 obj 取代。\n");
  // room_code = replace_string(room_code, "room/obj", "obj");
  // write("所有 room/npc 以 npc 取代。\n");
  // room_code = replace_string(room_code, "room/npc", "npc");
  file = tmp["file_name"];
  i = strlen(file)-1;
  if (!file[i] == 'c' || !file[i-1] == '.') file += ".lpc";
  while( (i > 0) && (file[i]!='/')) i--;
  if( i>0 ) {
    write("目前目录：" + file[0..i] + " 以 __DIR__ 取代。\n");
    room_code = replace_string(room_code, "\"" + file[0..i], "__DIR__\"");
  }

  if( file_size(file)!=-1 ) {
    write("档案 " + file + " 已存在，要删除旧档吗？[y/n]");
    input_to("save_room_file", file, room_code);
    return 1;
  }

  return save_room_file("y", file, room_code);
}

int do_saveroom(string arg)
{
	object env;
	string str, *name, file, pre, suc;
	mapping prop;
	int i;
	string home, cwd;

	env = environment(this_player());
	cwd = resolve_path(this_player()->query("cwd"), cwd);
	home=user_path(geteuid(this_player()));
	file = file_name(env) + ".lpc";

	if (file_size(file) <= 0) return
          notify_fail ("没有这房间的档案: "+file+"\n");

	name = explode (read_file (file), "\n");
	pre = "";
	for (i=0; i<sizeof (name); i++)
	  if (strsrch (name[i], "void create") < 0)
	    pre += name[i] + "\n";
	  else break;
	pre += "void create ()\n{\n";

	i += 2;
	while (name[i][0..0] != "}") i++;
	suc = ""; i++;
	while (i<sizeof(name)) suc += name[i++]+"\n";
	
	str = pre;
	str += sprintf("\tset(\"short\", %O);\n", env->query("short") );
	str += sprintf("\tset(\"long\", %O);\n\n", env->query("long") );
	prop = env->query_entire_dbase();
	name = keys(prop);
	for(i=0; i<sizeof(name); i++) {
		if( member_array(name[i], special_props)!=-1 ) continue;
		if (sizeof (prop[name[i]]) > 0)
		    str += sprintf("  set(\"%s\", %O );\n\n",
                                   name[i], prop[name[i]] );
	}
	str += "\n  setup();\n}\n"+suc;

	// Replace current directory with __DIR__ macro to make relocatable code.
	i = strlen(file)-1;
	while( (i > 0) && (file[i]!='/')) i--;
	if( i>0 ) {
		write("目前目录：" + file[0..i] + " 以 __DIR__ 取代。\n");
		str = replace_string(str, "\"" + file[0..i], "__DIR__\"");
	}

	if( file_size(file)!=-1 ) {
		write("档案 " + file + " 已存在，要删除旧档吗？[y/n]");
		input_to("save_room_file", file, str);
		return 1;
	}

	return save_room_file("y", file, str);
}

int query_autoload () { return 1; }
