#define RMK_VERSION "(v 1.2 11/4/1995)"
#define MAXINT	100000

inherit ITEM;

int get_setup ();

mapping tmp = ([
  "no_fight"		:
	([ "value"	: 0,
	   "def"	: 0,
	   "desc"	: "值是 1 不能在本房间战斗, 0 可以在本房间战斗",
	]),
  "no_magic"		:
	([ "value"	: 0,
	   "def"	: 0,
	   "desc"	: "值是 1 不能在本房间施法, 0 可以在本房间施法",
	]),
  "no_clean_up"		:
	([ "value"	: 0,
	   "def"	: 0,
	   "desc"	: "值是 1 本房间的东西不会 reborn, 0 本房间的东西会 reborn",
	]),
  "light_up"		:
	([ "value"	: 0,
	   "def"	: 0,
	   "desc"	: "值是 1 本房间有灯光设施, 0本房间无灯光设施",
	]),
  "valid_startroom"	:
	([ "value"	: 0,
	   "def"	: 0,
	   "desc"	: "值是 1 本房间可当下次进来的入口, 值是 0 则不行",
	]),
  "file_name"		: "",
  "short"		:
	([ "value"	: "",
	   "def"	: "空屋出租",
	   "desc"	: "房间的短叙述, 预设为空房间",
	   "status"	: 0,// 单行, 不可以设为空字串
	]),
  "long"		:
	([ "value"	: "",
	   "def"	: "这是一间空屋，正等着出租",
	   "desc"	: "房间的长叙述, 预设为什么也没有的空房间",
	   "status"	: 1,// 多行
	]),
  "outdoors"		:
	([ "value"	: "",
	   "def"	: "/open",
	   "desc"	: "户外或户内, 会影响玩家的视线",
	   "status"	: 2,// 可以设为空字串
	]),
  "item_desc"		:
	([ "value"	: ([]),
	   "desc"	: "请输入 <项目> <看到的叙述>",
	   "status"	: 3,// mapping 到字串, 可多行
	]),
  "exits"		:
	([ "value"	: ([]),
	   "desc"	: "请输入 <出口方向> <连结房间>, 目前只允许\ e, w, n, s, nw, ne, se, sw, u, d",
	   "status"	: 4,// 出口, 需要用到 abbr[]
	]),
  "objects"		:
