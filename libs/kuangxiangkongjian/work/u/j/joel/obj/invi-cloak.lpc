// mask.c

inherit EQUIP;

void create()
{
	set_name("隐身披风", ({"cloak"}) );
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 600);
		set("material", "cloth");
		set("armor_type", "cloak");
		set("armor_prop/id", ({""}) );
		set("armor_prop/name", ({""}) );
		set("armor_prop/short", ({""}) );
	}
}
