// god_flower.c

inherit ITEM;
inherit F_AUTOLOAD;

void create() {
  set_name("神仙花", ({ "god flower", "flower" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "朵");
    set("long", "一朵五彩缤纷的鲜花，散发着一股诱人的香气，这就是传说中的神仙花。\n
神仙花有着神奇的效用，只要闻闻他的香气(sniff)，就可以治疗各种伤痛。\n");
    set("value", 10000);
  }
}
void init() {
  add_action("do_sniff", "sniff");
}

int do_sniff(string arg) {
  string kind;
  int max;
  object me, n_money;

  if (!arg || (arg != "flower" && arg != "god flower"))
    return notify_fail("你要闻什么啊??\n");

  me = this_player();
  max = me->query("max_gin");
  me->set("eff_gin", max);
  me->set("gin", max);
  max = me->query("max_kee");
  me->set("eff_kee", max);
  me->set("kee", max);
  max = me->query("max_sen");
  me->set("eff_sen", max);
  me->set("sen", max);
  max = me->max_food_capacity();
  me->set("food", max);
  max = me->max_water_capacity();
  me->set("water", max);
  me->clear_condition();

  message_vision(sprintf("$N拼命着吸着花里的香气。\n"), this_player());
  return 1;
}
int query_autoload() {
  return 1;
}
