#include <ansi.h>
inherit SSERVER;
int perform(object me,object target)
{
        mapping exit=environment(me)->query("exits");
        string *dirs;
        int i;
        dirs=keys(exit);
        i=random(sizeof(dirs));
        load_object(exit[dirs[i]]);
        if(!me->is_fighting())
        return notify_fail("你又没在战斗，跑什么跑?\n");
        if(!me->query("force")<100)
        return notify_fail("你内力不足，无法使出「明哲保身”。\n");
        if(!me->max_skill("dodge","winter-steps")
        ||!me->max_skill("move","winter-steps"))
        return notify_fail("你没有儒门的独门轻功\，无法使出「明哲保身”。\n");
        if(!exit) return notify_fail(HIW"这里无处可逃!!\n"NOR);
        message_vision(HIY"$N使出奇门遁甲之「明哲保身”。\n"NOR,me);
        me->add("force",-100);
        if((int)me->query_function("savebody")/2+
        (int)me->query_skill("winter-steps")/10>random(10)+5)
        {
        message_vision(HIW"只见$n眨眼间$N已不知去向。\n"NOR,target,me);
        me->move(exit[dirs[i]]);
        }
        else
        {
        message_vision(HIY"可惜因为$N的技术不够纯熟而失败了。\n"NOR,me);
        me->start_busy(1);
        }
        return 1;
}
