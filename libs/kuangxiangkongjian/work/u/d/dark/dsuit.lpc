// kame_suit.c
 
inherit EQUIP;
 
void create()
{
        set_name("麒麟战衣",({"dark suit","suit"}) );
        set_weight(4500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long","残光由火麒麟的皮所制而成,具有刀枪不入的神奇功能.\n");
        set("unit","件");
        set("value",350);
        set("material","cloth");
        set("wield_msg", "$N穿上$n,全身发出耀眼红光令人睁不开眼.\n");
        set("unwield_msg", "$N你脱下$n,红光随之渐渐消逝.\n");
        set("armor_type","cloth");
        set("armor_prop/armor", 40);
        set("armor_prop/dodge", 20);
        }
        setup();
}
