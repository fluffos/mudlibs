// fusword.c
#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        seteuid(getuid());
        set_name(HIC "麒麟刀" NOR,({"dark blade","blade"}));
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
        set("long","残光斩杀火麒麟后 ,取其脊骨精制成这把冠世奇刀.\n");

        set("value",1000000);
        set("material", "steel");
        set("wield_msg", "$N手握冠世奇刀$n,霎时间你觉得精气充沛十足.\n");
        set("unwield_msg", "$N你将手中的$n插入腰间的刀鞘 。\n");
        }
        init_blade(100);
        setup();
}
