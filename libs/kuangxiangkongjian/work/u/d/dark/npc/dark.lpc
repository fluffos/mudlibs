#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIY "笑傲天" NOR, ({ "dark man", "dark", "man" }));

  set("long", "黑风寨寨主,因从小就闯荡江湖故眉宇间流露出十分自信的眼神.\n
而其一手所建立之黑风寨更是横霸黑白两道,是个人人敬畏的神秘人物.\n");
  set("gender", "男性");
  set("class", "bandit");
  set("nickname", HIC "黑神风" NOR);
  set("combat_exp", 600000);
  set("age", 32);
  set("title", GRN "黑风寨寨主" NOR);
  set("str", 25);
  set("cor", 25);
  set("cps", 25);
  set("per", 25);
  set("int", 25);
  set("con", 25);
  set("spi", 25);
  set("kar", 25);
  set("gin", 200);
  set("max_gin", 200);
  set("kee", 800);
  set("max_kee", 800);
  set("sen", 200);
  set("max_sen", 200);
  set("force", 2500);
  set("max_force", 2500);
  set("atman", 2500);
  set("max_atman", 2500);
  set("mana", 2500);
  set("max_mana", 2500);
  set_skill("move", 80);
  set_skill("dodge", 60);
  set_skill("force", 90);
  set_skill("badforce", 80);
  set_skill("badstrike", 100);
  set_skill("ghost-steps", 60);
  set_skill("parry", 50);
  set_skill("unarmed", 70);
  set("force_factor", 10);
  map_skill("move", "ghost-steps");
  map_skill("unarmed", "badstrike");
  map_skill("force", "badforce");
  map_skill("dodge", "ghost-steps");
  set("chat_chance", 10);
  set("chat_msg", ({ "当今武林有谁是我笑某的对手!\n" }));

  set("functions/evil-blade/level", 35);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.evil-blade" :),
  }));

  setup();
  carry_object("/u/d/dark/obj/dhat.lpc")->wear();
  carry_object("/u/d/dark/obj/dsuit.lpc")->wear();
  carry_object("/u/d/dark/obj/dboots.lpc")->wear();
}
