#include <ansi.h>

inherit EQUIP;

void create() {
  set_name(BLU "麒麟靴" NOR, ({ "fire boots" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "剑神残光斩杀邪兽火麒麟后，取其足巧制而成。\n");
    set("unit", "双");
    set("value", 200000);
    set("armor_prop/armor", 20);
    set("armor_prop/dodge", 10);
    set("armor_prop/move", 10);
    set("material", "leather");
    set("armor_type", "feet");
    setup();
  }
}
