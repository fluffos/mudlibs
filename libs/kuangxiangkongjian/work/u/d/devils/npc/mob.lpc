inherit NPC;
void create()
{
          set_name("小天",({"tan"}));
          set("title","拉姆的弟弟");
          set("gender","男性");
          set("age",12);
          set("long",@LONG
这是一个有着绿色头发的可爱小男孩，年纪大约八九岁，"头上还有着象征鬼星一族的角，
他现在正趴在操纵台上流着口水打盹，模样十分可爱。
LONG);
          set("combat_exp",1000);
          set("max_gin",20);
          set("cor",10);
          set("spi",35);
          set("str",13);
          set("chat_msg", ({
            "ＺＺＺＺＺＺ．．．．．．．．．\n",
            "ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ\n"}));
        set_temp("apply/attack", 15);
        set_temp("apply/armor", 15);
         setup();
        carry_object("/u/d/devils/npc/obj/linen")->wear();
}
