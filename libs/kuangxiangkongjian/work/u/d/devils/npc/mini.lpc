#include <ansi.h>

inherit NPC;
void do_special();
 
mapping *action = ({
        ([
                "action"     :  "$N身形一起，恍如鹰隼穿云,俯冲而下，一招‘云麾三舞’，虎虎生风",
                "dodge"      :   30,
                "parry"      :   25,
                "damage"     :   70,
                "damage_type":  "骨折",
        ]),
        ([
                "action"     :   "$N使出‘九宫八卦掌’，霎眼间，只见掌影漫天，忽东忽西，忽聚忽散，宛如水银泄地，花语缤纷",
                "dodge"      :    35,
                "parry"      :    40,
                "damage"     :    80,
                "damage_type":   "骨折",
        ]),
        ([
                "action"     :   "$N舌绽春雷，跟着就是一招‘回风扫柳’的神掌绝技，未回头反手就是一掌击向$n",
                "dodge"      :    50,
                "parry"      :    15,
                "damage"     :    90,
                "damage_type":   "内伤"
        ]),
        ([
                "action"     :   "$N打出一招‘八方风雨会中州’，掌力一重接一重，如同波浪层层推向$n",
                "dodge"      :    30,
                "parry"      :   -10,
                "damage"     :    160,
                "force"      :    160,
                "damage_type":   "瘀青",
        ]),
        ([
                "action"     :   "$N单掌一挑，并指如戟，掌法中夹杂刀剑的招式，激荡气流，发出嗤嗤的声响",
                "dodge"      :    10,
                "parry"      :   -20,
                "damage"     :    130,
                "force"      :    60,
                "damage_type":   "戳伤",
        ]),
   });
 
void create()
{
       set("title","普通百姓"),
        set_name("最小值", ({"minimun"}));
        set("race", "人类");
        set("nickname",MAG"幸  福"NOR);
        set("age",39);
       set("long",
"你看到一个身形魁梧的大汉，他浑身散放着死亡的气息，双目精光闪闪，有如黑暗中\n"
"的星星，最引你注意的还是他的右手，整只手臂通红，并不断地散放出令人窒息的热\n"
"气，难道那便是传说中的火龙臂 ?\n");
        set("str",30);
        set("cps",30);
        set("kar",20);
        set("spe",20);
        set("int",20);
        set("cor",30);
        set("kee",2000);
        set("max_kee",2000);
        set("limbs", ({"头部", "胸部", "腿部", "手臂"}) );
 
        set("attitude","herosim");
        set("combat_exp",500000);
        set_skill("dodge",260);
        set_skill("unarmed",200);
        set("chat_chance",5);
        set("chat_msg",({

"最小值嚣张的说道：我是 FS 最呛的玩家，厉害吧!\n",
"最小值仰天长叹：强者总是孤独的!\n",
        }));

        set("chat_chance_combat",50);
        set("chat_msg_combat",({
        (: do_special :)
        }));
        set_temp("apply/defend",100000);
        set_temp("apply/armor",100000);
        set_temp("apply/damage",100);
        setup();
}
void do_special()
  {
    object *enemy,target;
    int i;

        enemy=this_object()->query_enemy();
        i=sizeof(enemy);
        target=enemy[random(i)];

                message_vision(
        HIR "\n龙在天大喝一声，看我的‘火龙臂’\n",target);
                message_vision(
        HIR "\n龙在天的右手突然发出一道雄猛的火劲直逼向$N。\n"NOR,target);
                target->receive_wound("kee",random(100));
                COMBAT_D->report_status(target);

  }
