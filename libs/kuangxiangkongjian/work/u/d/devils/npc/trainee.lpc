// trainee.c

inherit NPC;

void create()
{
	set_name("武馆弟子", ({ "trainee" }) );
	set("gender", "男性" );
        set("age", 19);
	set("long", "你看到一位身材高大的汉子，正在辛苦地操练着。\n");
        set("sp_title","killer");
        set("combat_exp",2000);
        set_temp("apply/attack",10);
        set_temp("apply/dodge",15);
        setup();
	this_object()->disable_player(" <沉睡恶魔> ");
}
void die()
 {
 object me;
  me= this_object()->query_temp("last_damage_from");
  if( me&& userp(me) ) {
   me->set("sp_title","变态杀人狂魔");
   }
   ::die() ;
 }
