#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void bleed(object me, object victim, object weapon, int damage);
void block(object me, object victim, object weapon, int damage);

mapping *action = ({
  ([
    "damage_type": "刺伤",
    "action": "$w似乎带着$N势如破竹般的往$n的$l猛刺",
    "dodge": 30,
    "parry": 30,
    "damage": 25,
    "post_action": (: call_other, __FILE__, "block" :),
  ]),
  ([
    "action": "$N手中的$w似乎不听使唤，自己找寻敌人弱点，往$n的$l狠狠地划下去",
    "damage_type": "割伤",
    "dodge": -30,
    "parry": -30,
    "damage": 50,
    "post_action": (: call_other, __FILE__, "bleeding" :),
  ]),
});


void create() {
  set_name(HIB "水龙剑" NOR, ({ "water-dragon-sword", "sword" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "\n这把剑透这一股仙气，剑身透着淡淡的光芒，剑柄雕饰华丽，刻着" + HIC "‘九天’" NOR + "两字，正是九天玄女的配剑。\n");
    set("value", 1000);
    set("material", "crimsonsteel");
    set("wield_msg", HIW "\n$N一抽出水龙剑，突然觉得全身充满力量，心情却非常的平静，仿佛功\力又更上了一层。\n" NOR);
    set("unwield_msg", HIW "$N一收回水龙剑，充满全身的力量忽然消失。\n" NOR);
  }
  init_sword(100);
  set("actions", (: __FILE__, "query_action" :));
  setup();
}

varargs mapping query_action() {
  return action[random(sizeof(action))];
}

void block(object me, object victim, object weapon, int damage) {
  if (damage > 10) {
    victim->start_busy(random((int)me->query_skill("sword", 1) / 20 + 2));
    message_vision(HIC "水龙剑为了保护主人，化成一条水龙，卷住$n使其暂时无法动弹。\n" NOR, me, victim);
  }
}

void bleed(object me, object victim, object weapon, int damage) {
  int cond;

  if (damage > 30) {
    cond = victim->query_condition("bleeding");
    cond += random(me->query_skill("sword", 1) / 10);
    victim->apply_condition("bleeding", cond);
    message_vision(HIC "水龙剑带着$N把$n划出一道不浅的伤口，流血不止。\n" NOR, me, victim);
  }
}
