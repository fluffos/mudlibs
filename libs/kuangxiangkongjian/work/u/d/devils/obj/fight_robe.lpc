#include <armor.h>

inherit ARMOR;

void create()
{
        set_name(  "武斗服"  , ({ "fight robe", "robe" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("value", 800);
                set("armor_prop/armor", 5);
                set("armor_prop/dodge", 1);
        }
        setup();
}

