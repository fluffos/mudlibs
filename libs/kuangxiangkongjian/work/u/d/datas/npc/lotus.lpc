#include <ansi.h>
#include "/open/open.h"
inherit NPC;

void create() {
  set("title", "白莲教教主");
  set_name("王治平", ({ "Lord Lotus", "lord", "lotus", "lord lotus" }));
  set("nickname", HIC "救世白莲" NOR);
  set("long", "
他看起来也不过二十来岁，任何人第一眼看去绝对
不会相信他就是清末第一大教「白莲神教”中统领
十门教众百万数的白莲教主。\n");
  set("age", 24);
  set("attitude", "heroism");
  set("max_gin", 1500);
  set("max_kee", 2000);
  set("max_sen", 2100);
  set("max_force", 2200);
  set("force", 2200);
  set("combat_exp", 800000);
  set("force_factor", 10);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("rulai", 100);
  map_skill("unarmed", "rulai");
  set_skill("yu-steps", 100);
  map_skill("dodge", "yu-steps");
  set_skill("powerforce", 100);
  map_skill("force", "powerforce");
  set("chat_chance", 20);
  set("chat_msg", ({
    "王治平说道：鞑子那狗皇帝，早晚有天要死在我的手下！\n",
    "王治平笑道：待我赶走了鞑子后，我就是皇帝啦..哈哈哈..\n",
    "王治平道：早日入我白莲教，便早一日享受荣华富贵..如何啊？\n"
  }));
  setup();
}

int accept_fight(object me) {
  if ((int)me->query("combat_exp") <= 650000) {
    command("laugh");
    command("say 你帮我提鞋也还不配！快滚!!");
    return 0;
  }
  command("say 哼..那我便跟阁下过二招吧..请..");
  return 1;
}
