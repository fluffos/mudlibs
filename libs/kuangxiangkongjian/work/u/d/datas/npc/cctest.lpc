inherit NPC;

void create()
{
	set_name("鸡",({"chicken"}));
	set("race", "野兽");
	set("age", 2);
	set("long","这是一只普通的鸡。\n");
	set("str", 8);
	set("con", 9);
	set("max_gin", 60);
	set("max_kee",110);
	set("max_sen", 60);

	set("limbs", ({ "身体", "头部", "翅膀" }) );
	set("verbs", ({ "poke", "claw" }) );

	set("chat_chance", 3);
	set("chat_msg",({"咯咯咯！\t咯咯咯!\n"}));
		
	set("combat_exp",100000);

	setup();
}
