#include <ansi.h>

inherit NPC;

void create() {
  set_name("谢婉琳", ({ "Alice", "alice" }));
  set("nickname", HIC "柔情似水" NOR);
  set("long",
    "她看起来是那么地活泼，可爱，又带点知性的美，
令人一眼看去便无法移开目光，她是骆风最挂念不下的人。\n");
  set("attitude", "friendly");
  set("gender", "女性");
  set("age", 17);
  set("max_force", 200);
  set("force", 200);
  set("combat_exp", 6000);

  set("greeting_msg", ({
    "谢婉琳说道：什么时后你才会定下来呢？....唉...骆骆...\n",
    "我们家骆风很帅哦..你有没看过呢？\n",
  }));
  set("chat_msg", ({
    "谢婉琳说道：你看过我家的骆骆吗？他很帅哦..呵呵。 \n",
    "谢婉琳说道：我一定比萱萱好看多了。 \n",
  }));
  setup();

  carry_object("/obj/cloth")->wear();
}
