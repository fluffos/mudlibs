// 此药丸是用来测试，无任何实值上的利益，特此宣告 by borstquc 
inherit COMBINED_ITEM;
void create()
{
        set_name("变身药丸", ({"sispill"}) );
	set("long",
"这是一颗用来变身的药丸...(不要拿去做坏事呦!! 切记切记)\n");
        set("base_unit", "粒");
        set("unit", "粒");
        set("no_sell",1);
	set("value",2500);
	set_amount(1);
	setup();
}

void init()
{
	if( this_player()==environment() )
	{
		add_action("eat_pill", "eat");
	}	
}

int eat_pill(string arg)
{      

        object ob,me=this_player();
        if( !arg )                      return 0;
        arg=lower_case(arg);
        if( !ob = present(arg,me) )     return 0;
        if( ob != this_object() )       return 0;
        message_vision("$N吃下一粒变身丸.\n", me);
        me->set_skill("cure",100);
        me->set_skill("dodge",100);
        me->set_skill("move",100);
        me->set_skill("linpo-steps",120);
        me->set_skill("literate",200);
        me->set_skill("stabber",120);
        me->set_skill("unarmed",120);
        me->set_skill("six-fingers",120);
        me->set_skill("force",200);
        me->set_skill("sunforce",200);
        me->set_skill("snowforce",200);
        me->set_skill("snow-martial",100);
        me->set_skill("trade",100);
        me->set_skill("magic",100);
        me->set("max_officer_power",100000);
        me->set("officer_power",100000);
        me->set("office_exp",2000000000);
        me->set("functions/handwriting/level",100);
        me->set("functions/enforceup/level",200);
       me->set("max_atman",1000);
        me->set("max_gin",1000);
	me->set("max_kee",3000);
	me->set("max_force",5000);
        me->set("max_mana",1000);
        me->set("max_sen",1000);
        me->set("officer_class","左丞相");
	add_amount(-1);
        return 1;
}

              
                           
