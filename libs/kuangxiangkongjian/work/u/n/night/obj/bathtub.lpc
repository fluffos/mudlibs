inherit ITEM;
void create()
{
        set_name("按摩浴缸", ({ "bathtub" }) );
        set_weight(400000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
set("long","这是一个好大好大的浴缸,快像游泳池一样.\n"+
           "温温的水柱溢满了整个浴缸,看的你好想下去洗一洗(wash).\n");
                set("value", 10000);
        }
}
void init()
{
   add_action("do_wash","wash");
}
int do_wash(string str)
{
    object me=this_player();
    if( me->query("id") == "night" || me->query("id") == "ccat")
    {
       me->add("age",-1);
       write("妳倘佯在暖暖浴池里,享受着春光的明媚.\n");
       return 1;
    } 
     write("少不要脸,在别人浴缸里洗澡.\n");
     return 1;
}
