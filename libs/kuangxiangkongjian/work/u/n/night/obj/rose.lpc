#include <weapon.h>
#include <ansi.h>
inherit STABBER;

void create() {
  seteuid(getuid());
  set_name(HIM "小恋□紫色玫瑰花" NOR, ({ "night's rose", "rose" }));
  set("long",
    "这是一朵小恋出生时就握在手上的玫瑰花,十几年来从未离开过小恋身边
     它使小恋拥有神奇的力量\n");
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "朵");
    set("value", 0);
    set("material", "gold");
    set("no_sell", 1);
    set("wield_msg", "$N将" HIM "$n" NOR "握在手上,万能的天神赐给$N神奇的力量\n");
    set("unwield_msg", "$n突然慢慢变小...停留在$N的发际\n");
  }
  init_stabber(500);
  setup();
}
void init() {
  add_action("go_go", "gogo");
}

int query_autoload() {
  return 1;
}

int go_go(string str) {
  object obj;
  object me;
  me = this_player();
  if (!str || str == "") {
    write("紫色玫瑰伸出手指头，指着$N说:眼睛睁亮一点,没有这个地方喔!\n");
    return 1;
  }
  message_vision(HIW "$N挥舞着手上的" HIM "紫色玫瑰" NOR "," HIW "人也随之消失在朦胧的夜色里\n" NOR, me);
  obj = find_living(str);
  me->move(environment(obj));
  message_vision(HIM "一阵狂风骤雨过后,$N的身影出现在神秘的夜色里 ,$N那份神秘的美深深的吸引了你的 视线\n" NOR, me);
  return 1;
}
