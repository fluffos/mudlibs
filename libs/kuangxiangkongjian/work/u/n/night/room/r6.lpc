#include <ansi.h>
inherit ROOM;

void create()
{
    set("short","琴房");
    set("long",@LONG
这里的色调途然变成大红, 红红的钢琴布, 红色的壁厨, 
红系列的艺术桌椅, 这琴房也是暖暖的呢! 几本琴本散放在桌
上, 看似主人刚练琴完毕, 一台 radio录下刚刚的练琴, 练的
是华格纳的 beidal march , 旋律优美而温柔, 深深的敲入你
心中.  
LONG);
    set("valid_startroom", 1);
    set("outdoors","");
    set("objects",([
        "/u/n/night/obj/piano" : 1,
        ]));
    set("exits",([
    "east" : __DIR__"r5",
])); 
    setup();
}

void init()
{  
    object me=this_player();
    string str = me->query("id");
    if(!interactive(me)) return ;
    if( str == "night" || str == "ccat" )  return;  
       me->move("/obj/void");
       tell_object(me,HIG"私人产业,非请莫入,\n"NOR);
   
}

