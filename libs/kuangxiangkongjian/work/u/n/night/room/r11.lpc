#include <ansi.h>
inherit ROOM;

void create()
{
    set("short","浴室");
    set("long",@LONG
这里是小恋整里她那长长的秀发的地方, 淡淡的黄色色调, 在窗
外阳光照射下, 显得更明亮, 一盆长春藤向你展露那亮绿的叶子, 这
是浴室吗? 你不禁怀疑, 如此的明亮清爽, 宽敞洁静, 在这泡澡真是
在好也不过了.    
LONG);
    set("valid_startroom", 1);
    set("objects", ([
    "/u/n/night/obj/bathtub" : 1,
    ]));
    set("exits",([
    "south" : __DIR__"r10",
])); 
    setup();
}

void init()
{  
    object me=this_player();
    string str = me->query("id");
    if(!interactive(me)) return ;
    if( str == "night" || str == "ccat" )  return;  
       me->move("/obj/void");
       tell_object(me,HIG"私人产业,非请莫入,\n"NOR);
   
}

