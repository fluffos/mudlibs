#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
    set("short","庭院");
    set("long",@LONG
走进园内, 愈发的感到幽静, 淡淡的草香扑面而来, 艳阳, 微风, 
绿荫, 构成了一幅风景画, 十二棵大橡树排成一列, 像是欢迎你的来到
, 随着橡树大道望去, 一栋红瓦白屋的欧式建筑在大道尽头, 一坐喷泉
正吐出盈盈水柱,在阳光下正显得晶莹.  
LONG);
    set("item_desc", ([
    "south" : (: look_door,     "south" :),
    ]));
    set("valid_startroom", 1);
    set("outdoors","");
    set("exits",([
    "south" : __DIR__"r1",
    "north" : __DIR__"r3",
]));
    create_door("south", HIW"镂花白滨铁大门"NOR, "north", DOOR_CLOSED); 
    setup();
}

void init()
{  
    object me=this_player();
    string str = me->query("id");
    if(!interactive(me)) return ;
    if( str == "night" || str == "ccat" )  return;  
       me->move("/obj/void");
       tell_object(me,HIG"私人产业,非请莫入,\n"NOR);
   
}

