#include <ansi.h>
inherit ROOM;

void create()
{
    set("short","主卧室");
    set("long",@LONG
这里便是阿猫与小恋的卧室了, 整个粉红色的色调印入眼廉, 
软软的弹簧床, 上面放着几只小喵咪布偶, 是小恋思念阿猫时, 搂
抱的最爱, 一张阿猫与小恋的结婚照(picture)挂在墙上, 阿喵爽朗的微笑,
小恋温柔的依偎, 似乎在对你说: 我们,永远不分离...     
LONG);
    set("valid_startroom", 1);
    set("item_desc", ([ /* sizeof() == 1 */
    "picture" : "  ∩∩∩∩
  ◎◎＊＊     喵~~~
 = ﹀  ﹀ =
～ ▲  △ ～",
]));
    set("objects",([
      "/u/n/night/npc/cat.lpc" : 1,
      "/u/n/night/obj/bed" : 1,
      "/u/n/night/npc/ccat.lpc" : 1,
    ]));
    set("exits",([
    "down"  : __DIR__"r5",
    "north" : __DIR__"r11",
])); 
    setup();
}

void init()
{  
    object me=this_player();
    string str = me->query("id");
    if(!interactive(me)) return ;
    if( str == "night" || str == "ccat" || str == "lum") return;
       me->move("/obj/void");
       tell_object(me,HIG"私人产业,非请莫入,\n"NOR);
   
}

