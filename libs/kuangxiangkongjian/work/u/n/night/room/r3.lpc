#include <ansi.h>
inherit ROOM;

void create()
{
    set("short","喷水池");
    set("long",@LONG
还未走进喷水池畔, 阵阵水气已经扑面而来, 四溅的水珠在阳光下
形成一道彩虹, 大理石雕的人像, 叙述着希腊罗马的爱情故事, 几只蜻
蜓凌空飞舞, 伴着这海蓝蓝的天, 这海蓝蓝的天. 
LONG);
    set("valid_startroom", 1);
    set("outdoors","");
    set("exits",([
   "north" : __DIR__"r4",
   "south" : __DIR__"r2",
])); 
    setup();
}

void init()
{  
    object me=this_player();
    string str = me->query("id");
    if(!interactive(me)) return ;
    if( str == "night" || str == "ccat" )  return;  
       me->move("/obj/void");
       tell_object(me,HIG"私人产业,非请莫入,\n"NOR);
   
}

