#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "客厅");
  set("long", @LONG
这里是招待客人的地方, 几张牛皮沙发延墙摆着, 酒柜里放满了书
与酒瓶, 一幅桂阳山水画挂在墙上, 整体摆设显得庄重而大方, 可以知
到主人平日必定常细细整理, 真是爱干静的一家.    
LONG);
  set("valid_startroom", 1);
  set("outdoors", "");
  set("exits", ([
    "west": __DIR__ "r6",
    //   "north" : __DIR__"r7",
    "up": __DIR__ "r10",
    "out": __DIR__ "r4",
  ]));
  setup();
}

void init() {
  object me = this_player();
  string str = me->query("id");
  if (!interactive(me)) return;
  if (str == "night" || str == "ccat") return;
  me->move("/obj/void");
  tell_object(me, HIG "私人产业,非请莫入,\n" NOR);

}
