#include <combat.h>
#include <ansi.h>
inherit SKILL;

void movedown(object me, object victim, object  weapon, int damage);
void dragon(object me, object victim, object weapon, int damage);
mapping *action = ({
       ([      "action":               "$N纵身而上，忽地身形一转，使出「回龙逆斩”，手中$w往$n横劈过去",
                "dodge":                -20,
                "damage":               30,
                "damage_type": "砍伤",
        ]),
        ([      "action":               "$N运起元功\，将真力贯注$w，一招「呼龙啸天”$w直劈$n",
                "dodge":        -30,
                "damage":       40,
                "damage_type":  "砍伤",
        ]),
        ([      "action":               "$N手中$w连划，一招「夜龙一炬”忽地挺出$n直劈",
                "dodge":        -30,
                "damage":       50,
                "damage_type":  "砍伤",
        ]),
        ([      "action":               "$N一招「万劫尽舍”将手中$w舞成一片刀网",
                "dodge":        -30,
                "damage":       70,
                "damage_type":  "砍伤",
        ]),
        ([      "action":              "$N挥动手中$w使出「一字刀法”只见$w像一道闪电,直劈而下。",
                
                "dodge":        -30,
                "parry":        -10,
                "damage":       90,
                "damage_type":  "砍伤",
        ]),        
        ([      "action":              "$N使出「离刀斩”, 只见刀片像雪片般纷纷落下",       
            
                "dodge":        -30,
                "parry":        -10,
                "damage":       100,
                "force":        50,
                "damage_type":  "砍伤",
        ]), 
        ([      "action":              "$N大喝一声,使出「江山易手” , 一时气震山河 ,一阵刀气往$n直冲而来",
             
                "dodge":        -30,
                "parry":        -20,
                "damage":       120,
                "force":        100, 
                "damage_type":  "砍伤",
        ]),
        ([      "action":              "$N决定使出必杀之技 ,"HIM"【蟠龙锁关】"NOR""HIY"‘忌天......恨地......鱼龙再现！’"NOR" , 抛起$w , 空中转体三周半，气势磅礴!",
             
                "dodge":        -30,
                "parry":        -20,
                "damage":       150,
                "force":        200,
                "post_action":  (: dragon :),
                "damage_type":  "砍伤",                 
        ]),
});
void movedown(object me, object victim, object weapon, int damage)
{
int i;
if( (int)me->query("force") >120 ){
  for(i=1;i<=3;i++){
    switch(i){
    case 1:
          message_vision(sprintf("$N杀气一提，使出魔性三空杀之－「破”，手中巨刃
由左而右斩向$n的身上。\n"),me,victim);
    break;
    case 2:
          message_vision(sprintf("$N翻转右手，使出魔性三空杀之－「灭”，手中巨刃
由下而上斩向$n的胸前。\n"),me,victim);
    break;
    case 3:
          message_vision(sprintf("$N大喝一声，使出魔性三空杀之－「空”，手中大刀
由上而下斩向$n的腹部。\n"),me,victim);
    }
        if( (int)me->query_skill("dragon-blade",1) > random(60)+65) {
          message_vision(sprintf("结果被$N确确实实的命中要害，$n身上立即多了一道
长长的伤痕。\n"),me,victim);
                victim->add("kee",-50);
                 me->add("force",-30);
         }else{
          message_vision(sprintf("结果$N的攻击被$n避了开来。\n"),me,victim);
         }
   }
}
}

void dragon(object me, object victim, object weapon, int damage)
{
           int i,time = random( me->query_skill("dragon-blade")/15 ) ;
           if( me->query("force_factor") >= 10 )
           {                 
             if( me->query_temp("conti") == 0 )    
             {
               me->set_temp("conti",1);   
               message_vision(sprintf("\n$N使出魔刀之终极奥义,只见手中$w有如一
条鱼龙,迅速的冲向$n,$n的身体已被刀气所贯穿!!\n"),me,victim);
               for(i=0;i<=time;i++)
               victim->add("kee",-50);
		COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);	
               me->delete_temp("conti");
             }
           }         
}                                      

int valid_learn(object me)
{
        object ob;

        if((int)me->query("max_force")<100)
                return notify_fail("你的内力不够，不能练狂龙刀法。\n");

        if( (string)me->query_skill_mapped("force")!= "powerforce")
                return notify_fail("狂龙刀法必需配合玄阳神功\才能用。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "blade" )
                return notify_fail("你必须有刀才能练刀法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="blade" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        int skill_level=(int)(me->query_skill("dragon-blade",1)/10);
        if (skill_level<= 7)
          return action[random(skill_level)];
        else
          return action[random(8)];
 
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 5)
                return notify_fail("你的内力或气不够，不能练狂龙刀法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("blademan") + "/dragon-blade/" + action;
}
