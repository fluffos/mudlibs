// germany_pants.c
//germany_pants.c

inherit EQUIP;

void create() {
  set_name("亲卫队野战长裤", ({ "Germany pants", "pants" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "德军武装亲卫队迷彩野战长裤,隐蔽性高,行动方便.\n");
    set("unit", "条");
    set("value", 1250);
    set("material", "cloth");
    set("armor_type", "pants");
    set("armor_prop/armor", 10);
    set("armor_prop/dodge", 3);
  }
  setup();
}
