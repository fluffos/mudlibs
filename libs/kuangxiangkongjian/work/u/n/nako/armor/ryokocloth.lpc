// G.uniform.c

inherit EQUIP;

void create() {
  set_name("黄篮大横条宽松连身睡衣", ({ "ryoko sleepcloth", "sleepcloth" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "普通的布睡衣, 有着深蓝和土黄的宽横条。\n");
    set("unit", "件");
    set("value", 1000);
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 12);
    set("armor_prop/dodge", 5);
    set("armor_prop/parry", 3);
  }
  setup();
}
