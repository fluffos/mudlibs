// G.uniform.c

inherit EQUIP;

void create() {
  set_name("亲卫队野战服", ({ "Germany uniform", "uniform" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "德军武装亲卫队迷彩野战服,隐蔽性高,行动方便.\n");
    set("unit", "件");
    set("value", 1000);
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 12);
    set("armor_prop/dodge", 5);
    set("armor_prop/parry", 3);
  }
  setup();
}
