// germany_boots.c

inherit EQUIP;

void create()
{
        set_name("德军军靴",({"Germany boots","boots"}) );
        set_weight(3500);
        if( clonep() )
		set_default_object(__FILE__);
	else {
        set("long","德意志陆军制式军靴,高筒黑色皮革制普鲁士军靴.\n");
        set("unit","双");
        set("value",1400);
        set("material","leather");
        set("armor_type","boots");
        set("armor_prop/armor", 8);
        set("armor_prop/dodge", 5);
        set("armor_prop/parry", 2);
	}
        setup();
}
