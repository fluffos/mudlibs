//守卫 made by chun,fix by onion,refix by funkcat

#include "/open/capital/capital.h"

inherit NPC;

string app();

void create() {
  set_name("城门卫军", ({ "gate soldier", "soldier" }));
  set("gender", "男性");
  set("age", 25);
  set("class", "soldier");
  set("str", 25);
  set("long", "京城内位阶较低的军官，负责城门的守卫工作，一身军服看起来帅呆了。\n");
  set("combat_exp", 12274);

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: this_object(), "app" :),
  }));

  set_skill("blade", 40);
  set_skill("parry", 30);
  set_skill("dodge", 20);
  set_skill("her-blade", 30);
  map_skill("blade", "her-blade");
  setup();
  carry_object(CAP_OBJ "Ns_armor")->wear();
  carry_object(CAP_OBJ "Ns_boots")->wear();
  carry_object(CAP_OBJ "Ns_hat")->wear();
  carry_object(CAP_OBJ "Ns_blade")->wield();
}

int app() {
  object *enemy = this_object()->query_enemy(this_player());
  int i = sizeof(enemy);
  while (i--) {
    if (!enemy[i]->query_temp("kill_soldier")) {
      enemy[i]->set_temp("kill_soldier", 1);
      say("[1;31m大胆" + RANK_D->query_rude(enemy[i]) + enemy[i]->query("name") +
        "，竟敢在天子脚下捣乱。[0m\n");
    }
  }
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
  add_action("do_report", "report");
}

int accept_fight(object who) {
  return notify_fail("禁卫军说：对不起，我正在执行公务。\n");
}

void greeting(object ob) {
  if (ob->query_temp("kill_soldier")) {
    command("say 你这个扰乱城内秩序的人，还不束手就擒。");
    kill_ob(ob);
  } else {
    if (wizardp(ob))
      command("say " + ob->query("name") + " 大大好, 欢迎参观京城。");
    else {
      if (ob->query_temp("pass"))
        command("smile " + ob->query("id"));
      else {
        command("stare " + ob->query("id"));
        command("say ㄜ！这位" + RANK_D->query_respect(ob) + ", 哪里来的？报上(report)名来。");
      }
    }
  }
}

int do_report(string arg) {
  object ob = this_player();
  if (!arg || arg != ob->query("id"))
    return notify_fail("请告诉我你的id。\n");
  if (ob->query_temp("pass"))
    return notify_fail("我已经知道了，你不用对我说这么多次，\n
		 你的id是" + ob->query("id") + "，对吧？\n");
  ob->set_temp("pass", 1);
  command("say 谢谢您的合作，现在您可以通过了。\n");
  return 1;
}
