
//lum.c by nako
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("拉姆", ({"lum"}) );
        set("title", "拉姆流女王格斗术首门师范");
         set("nickname", "收拾烂摊子中");
        set("msg_min", "$N轻轻的飞了过来\n");
        set("msg_mout", "$N轻轻的向天空飞了上去\n");
        set("gender", "女性");

        set("age", 25);
        set("attitude", "peaceful");
        set("score", 250000);
        set("combat_exp", 80000);

        set("str", 30);
        set("max_gin", 3000);
        set("max_kee", 3000);
        set("max_sen", 3000);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);

        setup();

        carry_object("/obj/cloth")->wear();
        carry_object("/obj/wiz_cloak");
        set("chat_chance", 20);
        if(!present("Germany mark", this_player()))set("chat_msg",({
            (: command ("say 真麻烦..") :),
            (: command ("say 有事吗?") :),
            (: command ("hmm") :),
            (: command ("?") :),
            (: command ("? oyuki") :),
            (: command ("? know") :),
            (: command ("hehe") :),
            (: command ("hoho") :),
            (: command ("smile") :),
            (: command ("smile oyuki") :),
            (: command ("nod") :),
            (: command ("nod oyuki") :),
            (: command ("hi nako") :),
            (: command ("hi oyuki") :),
            (: command ("kick") :),
            (: command ("kick nako") :),
            (: this_object() , "random_move" :),
            (: command ("goto oyuki") :),
            (: command ("sigh") :),
        }));
}

