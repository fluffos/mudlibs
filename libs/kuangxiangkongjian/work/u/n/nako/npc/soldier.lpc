
//soldier.c
//#include <ansi.h>
inherit NPC;

void create()
{
        set_name("亲卫兵", ({"guard soldier","soldier"}));
        set("long",@LONG
    一位穿着纳粹德国军装的士兵,从他一丝不茍的神情中,你大概能了
解当年德军是如何扫平全欧洲的!!他正全神贯注地注意着四周的一切动
静，而且正把锐利的眼光投向你!!
LONG);
        set("gender", "男性");

        set("age", 25);
        set("attitude", "peaceful");
        set("score", 250000);
        set("combat_exp", 80000);

        set("str", 30);
        set("max_gin", 3000);
        set("max_kee", 3000);
        set("max_sen", 3000);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);
        set("inquiry", ([
            "娜考璐璐" : "她是我们的军团长,您找她有事吗?请立刻进去!!",
        ]) );

        setup();

        carry_object("/u/n/nako/armor/G.boots")->wear();
        carry_object("/u/n/nako/armor/G.pants")->wear();
        carry_object("/u/n/nako/armor/G.belt")->wear();
        carry_object("/u/n/nako/armor/G.uniform")->wear();
        carry_object("/u/n/nako/armor/G.helmet")->wear();
        carry_object("/u/n/nako/weapon/.gun");
        set("chat_chance", 2);
        if(!present("Germany mark", this_player()))set("chat_msg",({
            "这里属于军事重地,平民百姓请勿在此逗留!\n",
            "亲卫兵走向你,把你打量一番后,用枪口指指外面,示意要你离去。\n",
        }));
        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
             (: command ("shot " + this_player() -> query("id")) :),
            }));
}

int accept_kill (object ob)
{
    ob -> query("id");
    command("shot " + ob -> query("id"));
    return 1;
}
