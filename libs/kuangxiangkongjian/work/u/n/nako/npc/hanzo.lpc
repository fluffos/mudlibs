
//lys.c
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("服部半藏", ({"hanzo"}));
        set("title", "泷山派第八代弟子");
        set("gender", "男性");

        set("age", 25);
        set("attitude", "peaceful");
        set("score", 250000);
        set("combat_exp", 80000);

        set("str", 30);
        set("max_gin", 3000);
        set("max_kee", 3000);
        set("max_sen", 3000);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);

        setup();

        carry_object("/obj/cloth")->wear();
        carry_object("/obj/wiz_cloak");
        set("chat_chance", 10);
        if(!present("Germany mark", this_player()))set("chat_msg",({
            (: command ("say sigh...真无力....") :),
            (: command ("say 有事吗?") :),
            (: command ("hmm") :),
            (: command ("?") :),
            (: command ("hehe") :),
            (: command ("hoho") :),
            (: command ("smile") :),
            (: command ("nod") :),
            (: command ("kiss ppopp") :),
            (: command ("kick") :),
            (: this_object() , "random_move" :),
            (: command ("goto ppopp") :),
            (: command ("sigh") :),
        }));
}

