
//oyuki.c by nako
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("阿雪", ({"oyuki"}) );
        set("title", "仙剑派第四代女弟子");
        set("nickname", HIW"冰雪聪明"NOR);
        set("gender", "女性");

        set("age", 25);
        set("attitude", "peaceful");
        set("score", 250000);
        set("combat_exp", 80000);

        set("str", 30);
        set("max_gin", 3000);
        set("max_kee", 3000);
        set("max_sen", 3000);
        set("int", 30);
        set("cor", 30);
        set("cps", 30);
        set("con", 30);

        setup();

        carry_object("/obj/cloth")->wear();
        carry_object("/obj/wiz_cloak");
        carry_object("/u/o/oyuki/obj/flower");
        set("chat_chance", 20);
        if(!present("Germany mark", this_player()))set("chat_msg",({
            (: command ("say 真麻烦..") :),
            (: command ("say 有事吗?") :),
            (: command ("hmm") :),
            (: command ("?") :),
            (: command ("? oyuki") :),
            (: command ("? know") :),
            (: command ("hehe") :),
            (: command ("hoho") :),
            (: command ("smile") :),
            (: command ("smile oyuki") :),
            (: command ("nod") :),
            (: command ("nod oyuki") :),
            (: command ("hi nako") :),
            (: command ("hi oyuki") :),
            (: command ("kick") :),
            (: command ("kick nako") :),
            (: this_object() , "random_move" :),
            (: command ("gogo oyuki") :),
            (: command ("kiss know") :),
            (: command ("lean know") :),
            (: command ("hold know") :),
            (: command ("sigh") :),
        }));
}

