// Room: /u/n/nako/outdoor
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "娜考璐璐研究所大门");
  set ("long", @LONG
这儿就是最近新建的娜考璐璐研究所,高耸的水泥围墙,上头还有通电的铁丝网!
在高耸的围墙之后,更还有更高的机枪塔(guntower),两座各据左右两边,虎视耽耽!!
门口站了两个卫兵,卫兵身边的墙上还有个告示牌(sign)。
LONG);

  set("item_desc", ([ /* sizeof() == 2 */
  "sign" : "军事重地  危险勿入！
",
  "guntower" : "两座重型机枪就安在各据左右的高塔上,闪耀着枪金属独有的光泽.
",
]));
  set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/soldier.lpc" : 2,
]));
  set("light_up", 1);
  set("outdoors", "/u/n");
  set("valid_startroom", 1);
  set("exits", ([ /* sizeof() == 1 */
  "enter" : __DIR__"studyroom",
]));

  setup();
  call_other("/u/n/nako/nako_b.lpc","???");
}

void init()
{
     add_action("do_fight", "fight");
}

int do_fight()
{
     int gin1, kee1, sen1;
     object me;
     me = this_player();
     gin1 = me->query("gin") * 0.99;
     kee1 = me->query("kee") * 0.99;
     sen1 = me->query("sen") * 0.99;
     tell_object(me, "你对着亲卫兵说道："+RANK_D->query_self(me)+me->name()
                    +"，领教壮士的高招！\n");
     write("\n");
     tell_object(me, CYN"亲卫兵"NOR+"说道：你这个破坏份子！给你点教训！\n");
     write("\n");
     message("system", HIW"忽然重型机枪枪声骤起．．．\n"NOR, users());
     tell_room(environment(me), HIW"只见塔顶机枪不断向"HIC+me->name()
               +HIW"扫射．．．\n"NOR, ({this_object(), me}));
     tell_object(me, RED"塔顶的机枪无情地向你扫来．．．\n"NOR);
     message("system", HIW"．．．枪声持续了约十秒后停歇，接着是"HIC+me->name()
             +HIW"啪躂倒地的声音．．．\n"NOR, users());
                me->add("gin", -gin1);
                me->add("kee", -kee1);
                me->add("sen", -sen1);
     tell_object(me, "( 你"+RED"受伤过重，已经有如风中残烛，随时都可能断气。"NOR
                 +" )\n");
     tell_room(environment(me), HIC""+me->name()+HIW"倒在血泊中，奄奄一息，"
               +"想ＰＫ就趁现在！\n"NOR, ({this_object(), me}));
     return 1;
}


int valid_leave(object ob, string dir)
{
    if((string)ob->query("id")=="nako")
      {
        tell_object(ob, "亲卫兵一见军团长驾到,立正的动作更抖薮了!!\n");
        tell_room(environment(ob), "当娜考璐璐通过时,两旁的亲卫兵以更有精神的动作向她立正致敬!!\n", ({this_object(), ob}));
        return 1;
      }
    if((string)ob->query("id")=="hitler")
      {
         tell_object(ob, "两旁亲卫兵见是元首大驾光临,立正的动作比步兵教范还要标准!!\n");
        tell_room(environment(ob), "当闇□幻岚通过门口时,两旁的亲卫兵用最标准的动作立正致敬!!\n", ({this_object(), ob}));
        return 1;
      }
    if(!present("Germany mark", ob))
    return notify_fail("亲卫兵挡在门口,并且把枪上膛对准你,不再让你前进一步.\n");
    tell_object(ob, "当你通过门口时,两旁亲卫兵砰然立正!!\n");
    tell_room(environment(ob), "当"+(string)ob->query("name")+"通过门口时,两旁的亲卫兵向"+(string)ob->query("name")+"立正致敬!!\n", ({this_object(), ob}));
    return 1;
}
