// black_suit.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
       set_name("布衣",({"cloth"}) );

	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value",9999);
		set("material", "cloth");
		set("armor_prop/armor", 1);
                      set("armor_prop/id", ({"oyuki", "oyuki"}) );
                      set("armor_prop/name", ({"阿雪"}) );
                      set("armor_prop/short",
                          ({"仙剑派第四代女弟子「" +
                            HIW"冰雪聪明"NOR +
                            "”阿雪(Oyuki)"}) );
             }
	setup();
}
