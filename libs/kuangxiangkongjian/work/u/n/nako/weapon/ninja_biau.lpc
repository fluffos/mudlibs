// ninja_biau

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
        set_name("手里剑" ,({"Ninja shuligan","shuligan"}));
        set_weight(3500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("unit", "枚");
                set("base_unit", "枚");
		set("long", 
                "日本忍者惯用的投掷暗器,精钢铸造,呈风车形.\n");
		set("value", 10000);
		set("material", "steel");
	}
        init_throwing(90); 
	set_amount(1);
        set("wield_msg", "$N将$n握在手中, 感受到$n的杀气,威力倍增\n");
        set("unwield_msg", "$N将$n收入怀中。\n");
	
	setup();
}

