//tower_mob1.c
inherit NPC;

void create()
{
        set_name("食人鼠", ({ "Big rat" , "rat" }));
        set("race", "野兽");
        set("age", 4);
        set("long", "一只巨大的老鼠，因为长久在塔中吃食尸体，变得凶暴异常。\n");
	set("str", 75);
	set("cor", 75);
        set("limbs", ({ "头部", "身体", "前脚" , "后脚" , "尾巴" }) );
        set("verbs", ({ "bite"}));
        set("combat_exp", 7000);
	set_temp("apply/armor", 60);
        set_temp("apply/attack", 30);
        set("attitude", "aggressive");
	set("random_move",2);
	set("chat_chance",10);
	set("chat_msg", ({
           (: this_object(), "random_move" :),
	               }) );
	setup();               
	add_money("coin",1000);

}

