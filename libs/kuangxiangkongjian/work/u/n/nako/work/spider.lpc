//tower_mob2.c
inherit NPC;

void create() {
  set_name("人面蜘蛛", ({ "Face spider", "spider" }));
  set("race", "野兽");
  set("age", 8);
  set("long", "巨大的毒蜘蛛，腹部有着仿佛人面的鲜艳班纹。\n");
  set("str", 70);
  set("cor", 80);
  set("limbs", ({ "头部", "身体", "腹部", "前肢", "后肢" }));
  set("verbs", ({ "bite" }));
  set("combat_exp", 6800);
  set_temp("apply/armor", 55);
  set_temp("apply/attack", 40);
  set("attitude", "aggressive");
  set("random_move", 2);
  set("chat_chance", 10);
  set("chat_msg", ({
    (: this_object(), "random_move" :),
  }));
  setup();
  add_money("coin", 1000);

}
