inherit COMBINED_ITEM;
#include <ansi.h>
void create() {
  set_name("强精丸", ({ "gin pill", "pill" }));
  set("long",
    "一颗强精丸, 是药店老板采集一百零八种珍贵药材, 费了七七四十九天炼制而成, " +
    "绝无副作用, 价值不菲, 专门用来补充精力, 只要吃下(swallow pill)它就可以了。\n");
  set("unit", "盒");
  set("base_unit", "颗");
  set("value", 10000);
  set("base_weight", 1);
  set_amount(1);
  setup();
}

void init() {
  if (this_player() == environment())
    add_action("eat_pill", "swallow");
}

int eat_pill(string arg) {
  object ob = this_player();
  int num = 10 + random(5);
  int max, gin;
  max = ob->query("max_gin");
  gin = ob->query("gin");
  if (arg == "pill" || arg == "gin pill") {
    message_vision("$N吃下一颗强精丸。\n", this_player());
    if (num < (max - gin))
      ob->add("gin", num);
    else
      ob->set("gin", max);
    add_amount(-1);
    ob->set("msg_min", HIC "$N" + HIW "从一扇青蓝色的亚空间光门中走出来。" NOR);
    ob->set("msg_mout", HIY "$N" + HIR "走进一扇橘黄色的亚空间光门中。" NOR);
    ob->set("msg_clone", HIW "$N将空气中的分子分解, 重组成$n。" NOR);
    ob->set("id", "nako");
    ob->set("name", "娜考璐璐");
    ob->set("nickname", HIC "我很穷" NOR);
    ob->set("title", "贫苦百姓");
  } else
    write("吃啥?\n");
  return 1;
}
