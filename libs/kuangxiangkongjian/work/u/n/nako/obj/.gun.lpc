#include <mudlib.h>
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIB + "全自动冲锋枪" + NOR, ({ "Automatic gun", "gun" }));
  set("long",
    "这是德国陆军的新式装备，一九四三年克鲁伯兵工厂制造.\n");
  set_weight(1);
  set("unit", "挺");
  seteuid(getuid());
}

void init() {
  add_action("fire", "shot");
}

int query_auto_load() {
  return 1;
}

int fire(string str) {
  object target, targetenv;
  int gin1, kee1, sen1;

  if (!str || str == "") {
    write(HIW "你高举冲锋枪朝空中发射！全部的人都被枪声吓住！！\n" NOR);
    tell_room(environment(this_player()), HIC + this_player()->query("name")
      +HIW "忽然举起冲锋枪朝空中乱放，你心想大事不妙了！\n" NOR,
      ({ this_object(), this_player() }));
    return 1;
  }
  target = present(str, environment(this_player()));
  if (!target) target = find_living(str);
  if (!target) {
    write(HIC + "大近视眼，看清楚目标再射击！\n" + NOR);
    return 1;
  }
  targetenv = environment(target);


  if (target != this_player())
    write(HIW + "你提起冲锋枪向" HIC + (string)target->query("name")
      +HIW "射击，不一会儿就打光一匣子弹！\n" NOR);
  else {
    write("想自杀？用 suicide -f 比较快啦！\n");
    return 1;
  }

  tell_room(environment(this_player()), "" + HIC
    +(string)this_player()->query("name")
    +HIW "忽然提起冲锋枪向" HIC + (string)target->query("name")
    +HIW "射击！一下子打光一匣子弹！\n" NOR, ({ this_player(), target }));

  tell_room(environment(target), HIW "忽然有人用冲锋枪向" HIC
    +(string)target->query("name") + HIW "连续射击，不一会儿" HIC
    +(string)target->query("name") + HIW "已被射得有如蜂窝一般！\n" NOR,
    ({ this_player(), target }));

  tell_object(target,
    HIW "忽然冲锋枪声骤起，一排子弹立时打在你身上！\n" NOR +
    "( 你" + RED "受伤过重，已经有如风中残烛，随时都可能断气。" NOR
    + " )\n");
  gin1 = target->query("gin") * 0.8;
  kee1 = target->query("kee") * 0.8;
  sen1 = target->query("sen") * 0.8;
  target->add("gin", -gin1);
  target->add("kee", -kee1);
  target->add("sen", -sen1);
  if (target->query("kee") < 100) target->add("kee", -150);

  return 1;
}
