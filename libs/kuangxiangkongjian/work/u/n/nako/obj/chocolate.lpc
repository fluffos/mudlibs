inherit ITEM;
#include <ansi.h>

void create()
{
 set_name(HIC " Nakoruru " HIW + "特制情人节巧克力" NOR, ({ "chocolate" }));
     set("long", "看起来又漂亮又好吃的情人节巧克力,忍不住想吃一口(eat)。\n");
        set("unit", "块");
	set("base_weight", 200);
}

void init()
{
	if( this_player()==environment() )
		add_action("do_eat", "eat");
}

int do_eat(string arg)
{
    if( !arg || arg != "chocolate") return notify_fail("你要吃什么? \n");

    message_vision( HIY
 "$N吃了口心型巧克力,舔了舔手指,似乎回味无穷.....\n"+
 "$N脸上露出幸福的表情....\n" NOR,this_player()  );

    destruct(this_object());
	return 1;
}
