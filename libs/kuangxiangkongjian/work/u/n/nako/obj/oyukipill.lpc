inherit COMBINED_ITEM;
#include <ansi.h>
void create()
{
        set_name("雪泥冰", ({"ice","ice"}));
	set("long",
	"一颗强精丸, 是药店老板采集一百零八种珍贵药材, 费了七七四十九天炼制而成, "+
	"绝无副作用, 价值不菲, 专门用来补充精力, 只要吃下(swallow pill)它就可以了。\n");
	set("unit", "盒");
	set("base_unit", "颗");
	set("value",10000);
	set("base_weight", 1);
	set_amount(1);
	setup();
}

void init()
{
	if( this_player()==environment() )
	  add_action("eat_pill","swallow");
}

int eat_pill(string arg)
{       
	object ob=this_player();
        int num=10+random(5);
        int max,gin;
        max=ob->query("max_gin");
	gin=ob->query("gin");        
        if(arg == "ice")
	{
          message_vision("$N一口吃下了雪泥冰。\n", this_player());
	  if( num < (max-gin) )
 	    ob->add("gin",num);
          else
            ob->set("gin",max);
	  add_amount(-1);
           ob -> set ("id", "oyuki");
           ob -> set ("name", "阿雪");
           ob -> set ("nickname", HIW"冰雪聪明"NOR);
           ob -> set ("title", "海王星女王");
	} 
	else
	  write("吃啥?\n"); 
	return 1;
}

