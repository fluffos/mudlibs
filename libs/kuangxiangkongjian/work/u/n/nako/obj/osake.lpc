// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("大吟酿", ({ "japan wine", "wine" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "大吟酿可是上等的日本清酒呦, 装得有满满一瓶。\n");
    set("unit", "瓶");
    set("value", 100);
    set("max_liquid", 999);
  }

  set("liquid", ([
    "type": "alcohol",
    "name": "清酒",
    "remaining": 999,
    "drunk_apply": 6,
  ]));
  setup();
}
