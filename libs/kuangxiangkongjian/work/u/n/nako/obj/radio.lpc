inherit ITEM;
#include <ansi.h>

void create()
{
    set_name("无线电收发报机", ({ "radio" }));
    set("long", @LONG
一台军用无线电,你可以将它调(turn)至特定频道收信和发报。
频道 1 : 刀客频道 (turn1)       <用 blademan 发信>
频道 2 : 剑士频道 (turn2)       <用 swordsman 发信>
频道 3 : 魔教徒频道 (turn3)     <用 poisoner 发信>
LONG);
    set("unit", "台");
    set("base_weight", 200);
}

void init()
{
     if( this_player() == environment() )
         { add_action("do_turn1", "turn1");
           add_action("do_turn2", "turn2");
           add_action("do_turn3", "turn3");
         }
}

int do_turn1(string arg)
{
     write( HIC "你将无线电调至刀客频道。\n" NOR );
     this_player()->set("class", "blademan");
     return 1;
}

int do_turn2(string arg)
{
     write( HIC "你将无线电调至剑士频道。\n" NOR );
     this_player()->set("class", "swordsman");
     return 1;
}

int do_turn3(string arg)
{
     write( HIC "你将无线电调至魔教徒频道。\n" NOR );
     this_player()->set("class", "poisoner");
     return 1;
}
