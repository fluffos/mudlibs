// Room: /open/start/room/f22.c
#include "/open/open.h"
inherit ROOM;

void create ()
{
  set ("short", "小草屋");
  set ("long", @LONG
这里是江湖上有名的奇侠「九指书生”圣贤书所住之地，草房
虽然看起来十分的简陋，却有十分不平凡的气魄，足足显示读书人
的文学之气，在这边的草墙上有一幅画，画中写着几行字：
 
          「山不在高，有仙则名
            水不在深，有龙则灵
            居陋室者，圣贤书也” 
 
LONG);

  set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"eqroom",
  "north" : __DIR__"r3",
]));
  set("light_up", 1);
  set("objects", ([ /* sizeof() == 3 */
  "/open/start/npc/bookboy" : 2,
  "/open/start/obj/bamboo_pen" : 2,
  "/daemon/class/scholar/master_sue" : 1,
]));
  set("valid_startroom", 1);

  setup();
  call_other("/obj/board/sue_b", "???");
}

int valid_leave(object me, string dir)
{
  if (dir == "south" && me ->query("family/family_name") != "儒门")
  if ( !wizardp (me) )
     return notify_fail("那个房间只有儒门弟子才能进去。\n");
     return :: valid_leave(me, dir);
}
