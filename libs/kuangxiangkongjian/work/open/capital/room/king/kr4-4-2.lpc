int valid_leave(object me,string dir){
  if(dir=="north" && present("palace soldier",environment(me)) && !wizardp(me)){
	if(me->query("class")=="officer")
	  return 1;
	else
	  return notify_fail("殿前武士拿起虎头钢刀挡在你面前,狠狠的瞪着你说道:
放肆！朝圣殿岂是你随便进出的地方 \n");
    }
    return 1;
}
