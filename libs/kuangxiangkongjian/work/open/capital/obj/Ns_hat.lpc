// ph_hat.c
#include <armor.h>

inherit EQUIP;

void create()
{
        set_name("白翎军帽",({"soldier helmet","helmet"}) );
	set_weight(1000);
	set("armor_type","head");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
		set("value",400);
		set("material","steel");
		set("armor_prop/armor",5);
        }
        setup();
}
