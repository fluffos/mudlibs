// ph_hat.c
#include <armor.h>

inherit EQUIP;
			
void create()
{
        set_name("白翎军靴",({"soldier boots","boots"}) );
	set_weight(700);
	set("armor_type","boots");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
		set("value",600);
		set("material","fur");
		set("armor_prop/armor",3);
		set("armor_prop/dodge",5);
        }
        setup();
}
