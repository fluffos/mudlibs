inherit ITEM;
void create()
{
      set_name("九转[1;33m金[0m丹",({"gold_pill"}) );
      set_weight(100);
      if( clonep() )
           set_default_object(__FILE__);
      else {
           set("unit","颗");
           set("long","这是这是一颗非常珍贵的丹药, 运用内\功\服\化(adhibit)后可以增加内力。\n");
           set("value",100000);
           }
      setup();
}

void init()
{
	add_action("do_adhibit","adhibit");
}

int do_adhibit(string str)
{
	object me=this_player();
	object ob=this_object();
	if( str != "gold_pill" )
	  write("服化什么?\n");
	else
	{
	  message_vision("$N将$n服下, 随即坐下\运\功\。\n",me,ob);
	  write("你感觉到丹田一股热气缓缓上升, 这股热气随着你的内力运行奇经八"+
	  "脉一周, 之后便消逝无踪了。\n");
	  me->add("max_force",20);
	  destruct(ob);
	}  
	return 1;
}
