#include <ansi.h>
inherit NPC;

void create()
{
	set_name("守药邪兽", ({ "grass tiger","tiger" }) );
        set("race", "野兽");
	set("age", 15);
	set("long", "一只带着超魔邪力的凶恶老虎.\n");
	set("str", 65);
	set("max_kee", 600);
	set("kee",600);
        set("limbs", ({ "头部", "身体", "前脚" , "后脚" , "尾巴" }) );
        set("verbs", ({ "bite"}));
	set("combat_exp",100000);
	set_temp("apply/armor", 60);
        set_temp("apply/attack", 30);
	set("attitude","aggressive");
	set("chat_chance",10);
	set_skill("dodge",40);
	setup(); 
        carry_object("/open/gsword/obj/f_pill");
//      set_heart_beat(1);
}
