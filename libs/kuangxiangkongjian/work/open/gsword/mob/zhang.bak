inherit NPC;

void create()
{
        set_name("师爷 张冰",({ "zhang pin","zhang","pin"}) );
	set("race", "人类");
        set("age", 47);
	set("long",
"一位宾宾有礼的书生,他跟随将军征讨已经数十年了,一直是将军器
重的人材,他正忙于公务.
");
        set("inquiry",([
            "搜所令": "对不起,这东西不轻易外借的",
           ])); 
        set("str", 20);
        set("max_force", 250);
        set_skill("unarmed", 25);
        set("force", 250);
        set_skill("parry", 27);
         set_skill("dodge", 24);
         set_skill("six-fingers", 20);
         map_skill("dodge","six-fingers");
         set("force_factor", 8);
         map_skill("unarmed","six-fingers");
	set("combat_exp",5773);
        set_temp("apply/armor", 13);
        setup();		
        carry_object("/open/gsword/obj/boots")->wear();
        carry_object("/open/gsword/obj/robe_3")->wear();
        add_money("silver", 10);

}

