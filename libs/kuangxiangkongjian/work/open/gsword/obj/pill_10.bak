// made by ccat
// 二版,加上药性
inherit COMBINED_ITEM;
int time=0;
// time 为药性变数
void create()
{
        set_name("十粒包薏仁丹", ({"10 green pills","pill"}) );
	set("long",
"十粒包薏仁丹,可用来补血,你可以吞下它(swallow pill).\n"+
"(本朝中书省令: 为保障医生生路,改善国民克药习性,所有药丸一律加上药性.)\n");
	set("unit", "盒");
	set("base_unit", "粒");
        set("no_sell",1);
	set("value",2500);
        set("base_weight", 50);
	set_amount(10);
	setup();
}

void init()
{
	if( this_player()==environment() )
		add_action("swallow_pill", "swallow");
}

int swallow_pill(string arg)
{       
      if(arg=="pill" || arg=="green pill"){
	object user;
	user = this_player();
	message_vision(
		"$N吃下一粒药丸\n", user);
        user->receive_curing("kee",30);
        user->receive_heal("kee",30);
        time++;
        if( random(60) < time )
        {
           time =0;
           // 这里利用 time 这个变数来做药性
           // 吃太多,越易发作
           // 既发作,则归零
           message_vision("$N突然觉得血气一阵翻拥!!\n", user);
           user->apply_condition("ff_poison",5);
        }
	add_amount(-1);
        return 1;
        }
        return 0;
        
}

