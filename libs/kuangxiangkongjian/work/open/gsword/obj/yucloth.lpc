inherit EQUIP;
void create()
{
       set_name( "天神的羽衣" , ({ "yucloth" }) );
        set_weight(0);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "这是郑师傅祖传的一匹步制成的羽衣, "
			"传说布料是神仙\n"
			"送给仙剑老祖的, 没想到郑师傅肯为何双双"
			"动用这匹宝布 ,羽衣实在是神仙所穿 .\n");
                set("value", 70000);
                set("material", "cloth");
                set("armor_type", "cloth");
		set("armor_prop/armor", 5);
		set("armor_prop/dodge", 2);



}



        }
