int valid_leave(object me, string dir)
{
	if(dir=="west"&&present("down yua",environment(me)))
return notify_fail("张淡月挡在你身前 ,说道:你是文盲啊 ?看不懂国字喔!\n");
	return ::valid_leave(me,dir);
}
