//copy from cage,re-edit from ccat

#include <ansi.h>
inherit NPC;

void create() {
  set("title", "魔龙刀客");
  set_name("箫龙", ({ "sho-long", "sho", "long" }));
  set("age", 55);
  set("long", "为魔刀莫测的首徒,以尽得魔刀的精华,有感魔刀轻功的缺失,而于山野之间遍寻良矿
来造一把专门配合狂龙刀法的绝世好刀.\n");
  set("gender", "男姓");
  set("str", 30);
  set("con", 30);
  set("max_kee", 2000);
  set("kee", 2000);
  set("combat_exp", 350000);
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 20);
  set_skill("dodge", 80);
  set_skill("force", 60);
  set_skill("blade", 90);
  set_skill("dragon-blade", 100);
  set("inquiry", ([
  ]));
  set("chat_chance", 15);
  set("chat_msg", ({
  }));
  set("chat_chance_combat", 20);
  map_skill("blade", "dragon-blade");
  set_temp("apply/armor", 100);
  set_temp("apply/damage", 80);
  setup();
  carry_object("/open/main/obj/shiblade")->wield();
  carry_object("/open/common/obj/pill2")->set_amount(10);
  add_money("gold", 25);
}

int accept_kill(object me) {
  call_out("change", 1, me);
  return 1;
}
int accept_fight(object me) {
  call_out("change", 1, me);
  return 1;
}

void change(object ob) {
  int exp;
  exp = ob->query("combat_exp", 1);
  if (exp > 150000) {
    exp = exp * 1.5;
    set("combat_exp", exp);
  }
  return;
}

void heart_beat() {
  object env, mob, *enemy, target;
  int i, kee;
  mapping exit;
  string *exit_name;

  mob = this_object();
  env = environment(mob);

  if (random(100) < 12) {
    command("sword_fire");
  }

  if ((mob->query("kee") < mob->query("max_kee") * 0.3) && (random(100) < 25)) {
    command("eat pill");
  }

  if ((mob->query("kee") < mob->query("max_kee") * 0.2) && (random(100) < 20)) {
    exit = env->query("exits");
    exit_name = keys(exit);
    i = random(sizeof(exit_name));
    command(exit_name[i]);
    i = random(sizeof(exit_name));
    command(exit_name[i]);
  }

  set_heart_beat(1);
  ::heart_beat();

}
