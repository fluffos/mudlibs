inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
        set_name("朱火旺", ({ "zhu howang", "zhu", "wang"}));
        set("title", "县衙二捕头");
        set("nickname","[33m屠牛师[0m");
        set("gender", "男性" );
        set("age", 46);
        set("str", 50);
        set("cor", 50);
        set("cps", 50);
        set("int", 50);
        set("spi", 50);
        set("kar", 50);
        set("per", 50);
        set("con", 50);

        set("max_atman", 5000);
        set("max_force", 5000);
        set("max_mana", 5000);
        set("atman", 5000);
        set("force", 5000);
        set("mana", 5000);
        set("force_factor", 5);

        set("long", @LONG
    一个粗壮的男子，他曾是陇山派的弟子。居说他曾为了救人，
一拳击毙一头疯牛，因之得了个‘屠牛师’的美号，不过由于他生
性放荡，故对一些生活上的细节不是很注重，往往使身边的人受不
了。
LONG);

        set("combat_exp", 600000);
        set("score", 20000);

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
        "看拳!!小心啦!!\n",
        "一脚踢翻你这王八蛋!!\n"
        }) );

        set_skill("unarmed", 60);
        set_skill("force", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("sword", 100);
        set_skill("literate", 90);

        set("inquiry", ([
          "陇山派" : "唉～～陇山拳喔～～不说也罢．．．．",
	  "thief"  : "唉～～可惜我身形笨重, 不然上次我就抓到那大盗了",
        ]) );

        setup();
   //   carry_object(__DIR__"obj/dragon_armor")->wear();
}
