#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("[1;37m碧雪魔甲[0m", ({ "snow armor", "armor" }) );
        set_weight(5000);

        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "此甲相传是从千年寒冰精炼而成，有着相当的防御力。");

                set("material", "iron");
                set("value", 2000);
                set("armor_prop/armor", 10);
        }
        setup();
}
