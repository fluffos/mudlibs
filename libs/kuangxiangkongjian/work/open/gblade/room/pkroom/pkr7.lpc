// pkr7.c by konn
inherit ROOM;

void create()
{
        set("short", "第一武道馆");
        set("long", @LONG



LONG);
        set("exits", ([ /* sizeof == 2 */
            "north" : __DIR__"pkr4",
            "east"  : __DIR__"pkr8",
      ]));

        set("no_transmit", 1);
        set("light_up", 1);
        setup();
}

void init()
{
        object me = this_player();

        if( !me->query_temp("pk_fight") ) {
            tell_object(me, "这里正在pk, 你不能进来。\n");
            me->move(me->query("startroom"));
        }
}

int valid_leave(object me, string dir)
{
        if( (me->query("eff_kee")*100 / me->query("max_kee")) < 50 )
            return 0;
        return 1;
}
