// pkr3.c by konn
inherit ROOM;

void create() {
        set("short","第一武道馆");
        set("long", @LONG



LONG);
        set("exits",([ /* sizeof == 3 */
            "east" : __DIR__"pkr4",
            "west" : __DIR__"pkr2",
            "south" : __DIR__"pkr7",
      ]));
        set("no_magic", 1);
        set("no_spells", 1);
        set("no_fight", 1);
        set("no_transmit", 1);
        set("light_up", 1);
        setup();
}

void init() {
        object me=this_player(), enemy;

        if(!me->query_temp("pker_master") &&
           !me->query_temp("pker")) {
              tell_object(me,"这里正在pk, 你不能进来!\n");
              me->move(me->query("startroom"));
        }
	if(!me->query_temp("enemy")) return ;
        if(me->query_temp("go_away")) me->add_temp("go_away", 1);
        else me->set_temp("go_away", 1);
        enemy = find_player(me->query_temp("enemy"));
        if(environment(enemy) == environment(me)) {
           me->kill_ob(enemy);
           enemy->kill_ob(me);
        }
}

int valid_leave(object me,string dir) {
        object enemy;
        enemy = find_player(me->query_temp("enemy"));
        if(me->query_temp("go_away") > 101) {
           me->set("eff_kee", -1);
           me->set("kee", -1);
           me->move(environment(enemy));
           return notify_fail("你已经逃跑太多次了!\n");
        }
        return 1;
}
