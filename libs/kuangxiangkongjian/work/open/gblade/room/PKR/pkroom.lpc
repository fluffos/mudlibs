// pkroom.c by konn

#include <ansi.h>
inherit ROOM;

int total=0;
object pker1,pker2;

void create () {
        set("short","比武擂台");
        set("long", @LONG
这里是让玩家们互相切磋武艺的地方, 场地的正中央摆设了一个长宽约
百尺的擂台, 上面有两个武艺稀松平常的汉子在打斗着, 看来想成为这
里的卫冕者并不难, 在你身旁竖了一块木板(sign), 你可以看看它上面
写了些什么。


LONG);

        set("item_desc",([
            "sign" :
    "

    擂台规则:

        1. 一次只能两个玩家pk, 其他人不能插手, 胜负以先被k 昏或先投
           降(yield) 者为败, 胜者可获得奖励。
        2. 想要较量, 则下指令pkla, 若有两个玩家下了pkla, 则此两位玩
           家先行比赛, 后下此指令则无法参赛, 需等比赛结束后再重新开
           始。
        3. 奖励方法胜者可以获得奖金一些, 数目依对手战斗经验值而异,
           打败经验值越高的对手获得越多, 奖金则存放在钱庄里。
        4. 以上三点为擂台规则与参与方式, 祝各位玩得愉快。


      ",]));

        set("exits",([ /* sizeof() == 1 */
            "east" : __DIR__"g1-1",
      ]));

        set("objects",([ /* sizeof() == 1 */
//            "/open/gblade/npc/officer1" : 1,
      ]));

        set("no_fight", 1);
        set("no_magic", 1);
        set("no_transmic", 1);
        set("light_up", 1);
        setup();
}

void init() {
        add_action("do_pkla","pkla");
        add_action("do_yield","yield");
}

int do_pkla() {
        object me=this_player();
        string str;

        if(total == 0) {
           me->set_temp("pker");
           pker1 = me;
           total++;
           shout(HIB"比武擂台主持人蔡总管喝道: "+pker1->query("name")+
                 "愿意领教高招, 请各位大侠前来比试!\n"NOR);
           tell_object(me,HIB"比武擂台主持人蔡总管喝道: "+pker1->query("name")+
                       "愿意领教高招, 请各位大侠前来比试!\n"NOR);
// 要加入「等待pk中”的讯息

           return 1;
        }
        else if(total == 1) {
           me->set_temp("pker");
           pker2 = me;
           total++;
           shout(HIB"比武擂台主持人蔡总管喝道: "+pker1->query("name")+
                 "与"+pker2->query("name")+"开始决斗了!\n"NOR);
           tell_object(me,HIB"比武擂台主持人蔡总管喝道: "+pker1->query("name")+
                       "与"+pker2->query("name")+"开始决斗了!\n"NOR);
           pker1->set_temp("is_fighting", 1);
           pker2->set_temp("is_fighting", 1);
// 开始pk! 要加入「pk 中”的讯息

           tell_room(HIY"蔡总管说道: 比武开始!\n"NOR);
           pker1->fight_ob(pker2);
           pker2->fight_ob(pker1);
           return 1;
        }
        return notify_fail("擂台人数已满, 请等下一场!\n");
}

int do_yield() {
        object loser,winer,me=this_player();
        int gold,silver,money;

        if(!me->query_temp("is_fighting"))
           return notify_fail("你并没有在比试啊!\n");

        if(me->query("id") == pker1->query("id")) {
           loser = pker1;
           winer = pker2;
        }
        else {
           loser = pker2;
           winer = pker1;
        }
// 删除讯息!

        pker1->remove_all_killer();
        pker2->remove_all_killer();
        loser->delete_temp("pker");
        loser->delete_temp("is_fighting");
        winer->delete_temp("is_fighting");

        money = loser->query("combat_exp") / 25;
        gold = money / 100;
        silver = money % 100;

        shout(HIB"比武擂台主持人蔡总管喝道: 比赛胜负已揭晓, 胜者"+
              winer->query("name")+"\n"NOR);//+", 获得
// 未完成!

        total--;
        return 1;
}

int valid_leave(object me,string dir) {
        if(me->query_temp("is_fighting"))
           return notify_fail("你在比试中, 怎么可以临阵脱逃?\n");
        if(me->query_temp("pker")) {
           me->delete_temp("pker");
           total--;
        }
}
