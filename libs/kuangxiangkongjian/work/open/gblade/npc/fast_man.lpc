// fast_man.c by konn

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("一刀见血", ({"fast-dest man", "man"}));
        set("long", "他是无影狂刀斩的负责人\n");
        set("title", "无影狂刀斩\n");
        set("no_kill", 1);
        setup();
}

object *fast = ({});
object *blademan = ({});

int fast_dest(object me)
{
        object *enemy;
        int i;

        set_heart_beat(1);
        enemy = me->query_enemy();
        for(i=0; i<sizeof(enemy); i++) {
	   enemy[i]->set_temp("my_enemy", me);
           enemy[i]->set_temp("damage/time", 1);
           fast += ({ enemy[i] });
        }
        me->set_temp("fast/time", 1);
        blademan += ({ me });
        return 1;
}

void heart_beat()
{
        object me, enem, *user;
        int i, gin, kee, sen;

        set_heart_beat(1);
        user = users();
        for(i=0; i<sizeof(user); i++) {
           if( user[i]->query_skill_mapped("blade") == "fast-blade" ) 
	       user[i]->delete_busy();
        }

        for(i=0; i<sizeof(blademan); i++) {
           if( blademan[i] ) {
               blademan[i]->add_temp("fast/time", 1);
               if( blademan[i]->query_temp("fast/time") == 60 ) {
                   blademan[i]->delete_temp("fast/time");
                   blademan -= ({ blademan[i] });
               }
           } else blademan -= ({ blademan[i] });
        }

        for(i=0; i<sizeof(fast); i++) {
           if( enem = fast[i] ) {
               if( me = enem->query_temp("my_enemy") ) {
                   if( enem->query_temp("damage/time") > 8 ) {
                       enem->delete_temp("damage/time");
                       fast -= ({ fast[i] });
                   }
                   else enem->add_temp("damage/time", 1);
  
                   message_vision(HIC "$N使出幔罗千叶刀法的精华 --- 无影狂刀斩, "+
                                      "偷偷的向$n砍了一刀。\n" NOR, me, enem);
                   if( environment(me) != environment(enem) )
                       tell_object(enem,
                                   sprintf(HIC "%s使出幔罗千叶刀法的精华 --- "+
                                   "无影狂刀斩, 偷偷的向你砍了过来。\n" NOR,
                                   me->name()));
                   if( random(me->query_skill("fast-blade", 1)) >
                       random(enem->query_skill("dodge"))/5 ) {
                       message_vision(HIR "$n闪躲不及, 被$N的无影狂刀斩砍了一"+
                                          "个大伤口, 血流如注。\n" NOR,
                                          me, enem);
                       if( environment(me) != environment(enem) )
                           tell_object(enem,
                                       sprintf(HIR "你闪躲不及, 被%s的无影狂"+
                                       "刀斩砍了一个大伤口, 血流如注。\n" NOR,
                                       me->name()));
                       kee = enem->query("kee");
		       enem->add("kee", (int) - kee/15);
                       kee = enem->query("eff_kee");
		       enem->add("eff_kee", (int) - kee/15);
                       sen = enem->query("sen");
                       enem->add("sen", (int) - sen/10);
                       gin = enem->query("gin");
                       enem->add("gin", (int) - gin/10);
                       COMBAT_D->report_status(enem);
                   }
                   else {
                       message_vision(HIG "$n巧妙的闪过了$N的无影狂刀斩。\n" NOR,
                                      me, enem);
                       if( environment(me) != environment(enem) )
                           tell_object(enem,
                                       sprintf(HIG "你巧妙的闪过了%s的无影狂刀斩。\n" NOR,
                                       me->name()));
                   }
               }
               else {
                  enem->delete_temp("my_enemy");
                  fast -= ({ fast[i] });
               }
           } else fast -= ({ fast[i] });
        }
}
