//test1

#include <ansi.h>

inherit NPC;

void create() {

  set_name("猛虎", ({ "tiger" }));
  set("long", "一只花纹斑栏的猛虎");
  set("race", "野兽");

  set("max_gin", 250);
  set("max_kee", 400);
  set("max_sen", 250);

  set_temp("apply/armor", 10);
  set_temp("apply/damage", 1);
  set_temp("apply/attack", 40);
  set_temp("apply/dodge", 30);
  set("age", 5);

  set("str", 40);
  set("cor", 30);
  set("cps", 25);

  set("limbs", ({ "头部", "前脚", "尾巴", "身体" }));
  set("verbs", ({ "bite", "claw" }));
  set("combat_exp", 5000);
  /*
	set("chat_chance", 15);
*/
  setup();

}



void invocation(object who) {
  int i;
  object *enemy;

  message("vision",
    HIY "一只恶虎从妖壶中冲出 .\n"
    +name() + "虎吼一声 , 响彻云霄 !\n" NOR,
    environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  /*
	set_leader(who);
	*/
}
