inherit NPC;
void create()
{
        set_name("入门弟子", ({"boy"}));
        set("long","天道派的入门弟子，正在练习着紫龙鞭法.....\n");
	set("gender","男性");
	set("combat_exp",1000);
        set("attitude","friendly");
	set("age",15);
        set("title","天道派");
	set("score",1000);
        set_skill("force",10);
        set_skill("gwhip",20);
        set_skill("whip",20);
        map_skill("whip","gwhip");
	set_skill("dodge",10);
	set_skill("parry",12);
	set_skill("literate",25);
	set_skill("unarmed",10);
	setup();
        carry_object("/open/tendo/obj/whisk1")->wield();
        add_money("silver",2);
}

