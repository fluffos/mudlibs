inherit NPC;
void create()
{
        set_name("看门弟子", ({"boy"}));
        set("long","他们两个是被派来这担任守门的工作，以免掌门人房中的东西被偷。\n");
	set("gender","男性");
        set("combat_exp",10000);
        set("attitude","friendly");
        set("age",22);
        set("title","天道派");
        set_skill("force",30);
        set_skill("gwhip",40);
        set_skill("whip",40);
        map_skill("whip","gwhip");
	set_skill("dodge",35);
	set_skill("parry",24);
	set_skill("literate",20);
	set_skill("unarmed",20);
	setup();
        carry_object("/open/tendo/obj/whisk")->wield();
        add_money("gold",1);
}

