#include <ansi.h>
inherit F_VENDOR;

string magic1();
string magic2();

void create() {
  set_name("志清", ({ "gechin" }));
  set("long", "负责教导新进的弟子，顺便卖些道服。\n");
  set("gender", "男性");
  set("class", "taoist");
  set("combat_exp", 1000000);
  set("attitude", "heroism");
  set("age", 50);
  set("title", "天道派第一代弟子");
  set("str", 25);
  set("cor", 24);
  set("cps", 25);
  set("per", 24);
  set("spi", 30);
  set("int", 26);
  set("force", 1800);
  set_skill("literate", 70);
  set("max_force", 1000);
  set("max_mana", 600);
  set("max_atman", 500);
  set_skill("array", 40);
  set_skill("move", 70);
  set_skill("force", 70);
  set_skill("dodge", 50);
  set_skill("parry", 40);
  set_skill("whip", 70);
  set_skill("gwhip", 80);
  map_skill("whip", "gwhip");
  set("force_factor", 10);
  set_skill("parry", 60);
  set_skill("gforce", 80);
  map_skill("force", "gforce");
  set_skill("g-steps", 75);
  map_skill("dodge", "g-steps");
  set("vendor_goods", ({
    "/open/tendo/obj/hat.lpc",
    "/open/tendo/obj/shoe.lpc",
    "/open/tendo/obj/robe.lpc",
  }));
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: magic1 :),
    (: magic2 :),
  }));
  setup();
  carry_object(CLASS_D("taoist/goldwhisk"))->wield();
  carry_object("/open/tendo/obj/hat")->wear();
  carry_object("/open/tendo/obj/robe")->wear();
  carry_object("/open/tendo/obj/shoe")->wear();
}

string magic1() {
  command("use fireball");
  return "\n";
}

string magic2() {
  command("use firedragon");
  return "\n";
}
