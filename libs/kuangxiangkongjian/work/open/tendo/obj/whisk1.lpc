// bleed_whip.c
#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
        set_name("拂尘",({"whisk"}));
        set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit","件");
          set("value",500);
		set("material","wood");
		set("long",
        "这是一件打扫灰尘的拂尘。\n");
	}
        init_whip(7);
	setup();
}

int query_autoload()
{
  if(this_player()->query("class") == "taoist" )
    return 1;
  else
    return 0;
}

int wear()
{
  if(this_player()->query("class") != "taoist" )
    return notify_fail("这是道士专用的拂尘。\n");
  else
    return ::wear();
}
