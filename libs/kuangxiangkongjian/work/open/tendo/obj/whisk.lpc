// bleed_whip.c
#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
        set_name("三清拂尘",({"whisk"}));
        set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit","件");
                set("value",5000);
		set("material","steel");
	}
        init_whip(60);
	setup();
}

int wield()
{
  if(this_player()->query("class") != "taoist" )
    return notify_fail("这是道士专用的拂尘。\n");
  else
    return ::wield();
}
