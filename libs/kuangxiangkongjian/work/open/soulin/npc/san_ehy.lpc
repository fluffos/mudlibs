inherit NPC;
void create()
{
        set_name("乔三槐",({"san ehy","san ehy"}));
        set("title","农夫");
        set(@LONG,
   没有人知道他来自何处，只知道他某天来到少室山脚后，开始过着农耕的生活
，偶尔也会挑些东西上少林寺去卖。
LONG);
        set("gender","男性");
        set("combat_exp",100000);
        set("attitude","peaceful");
        set("age",60);
        set_skill("unarmed",60);
        set_skill("stick",55);
        set_skill("dodge",30);
        set_skill("parry",40);
        map_skill("unarmed","longfist");
        set("chat_chance",10);
        set("chat_msg",({
        }));
        setup();
        add_money("silver",5);
}
