//copy from ccat and cage

#include <ansi.h>
inherit NPC;
mapping *action = ({
([ "action" :"$N举起前腿,以上面锐利的脚爪向$n抓了过去,使$n感到压力重重。",
             "dodge"      :  -10,
             "parry"      :  -25,
             "damage"     :  100,
             "damage_type":  "抓伤",
           ]), 
([ "action" :"$N抬起重越千斤尾巴对准$n "+HIW+"脑门"NOR+" 直扫了过去,可以听到其夹着呼呼的风声,好不惊人",
             "dodge"      :  -30,
             "parry"      :  -45,
             "damage"     :  150,
             "damage_type":  "撞伤",
            ]),
([ "action":"$N张开大口[34;1m吼～～～[0m了一声,突然间从口中喷出[32;1;5m 火焰[0m向$n喷去将要把$n的身体罩住。",
             "dodge"      : 40,
             "parry"      :  0,
             "damage"     : 200,
             "damage_type":  "烧伤",
           ]),
       });
void create()
{
     set_name("狂暴龙",({"crazy dragon", "dragon"}) );
     set("race", "野兽"); 
     set("age",100);
     set("long","此乃仙岛的守护者之一,为上古时代的魔兽");
     set("max_kee",1500);
     set("kee",1500);
     set("combat_exp",1000000);
     set_skill("dodge",60);
     set_skill("parry",100);
     set_skill("unarmed",80);  
     set("limbs", ({ "龙头", "龙身","龙尾" }) );
     set("chat_chance",5);
     set("chat_msg",({
    (: this_object(),"random_move" :),
    "狂暴龙张开大嘴,吼～～～叫不已,振的你耳多隐隐作痛。\n",
     })); 
     setup();
        set("default_actions", (: call_other, __FILE__,"query_action" :));
         reset_action();
}
mapping query_action()
{
   return action[random(sizeof(action))];
}


