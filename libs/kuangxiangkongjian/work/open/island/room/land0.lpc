#include <mudlib.h>
#include "/u/c/cage/lib/cage.h"
#include "/u/c/cage/lib/door.h"
#include <room.h>
inherit ROOM;
void reset() {
  ::reset();
  call_out("reset", 30);
  set("door/south/status", DOOR_LOCK);
  delete("exits/south");
}
void create() {
  set("short", "山洞");
  set("long", @LONG
这里可看见前方有一洞口,其间附满着藤蔓(rattan),而一丝微弱的光线
由藤蔓的缝隙中透出,可想而知,此必为山洞的出口,在阴暗潮溼的山洞中那么久
现在能见到阳光,可说是一大乐事。后面有一石门(door)

LONG);
  set("light_up", 1);
  set("item_desc", ([
    "door": "石门上写着:
                      [36;4;1m来时有路 去时无门[0;1m 徐巿[0m 字
                                                   看来你是无法往回走了。\n",
    "rattan": "你看到藤蔓盘据在洞口,就像蜘蛛网一般,把洞口遮的看不清楚洞外的世界。\n", ]));
  set("door/south", ([
    "name": "石门",
    "connect": __DIR__ "l10.lpc",
    "status": DOOR_LOCK,
  ]));
  setup();
}
void init() {
  add_action("do_pass", "pass");
  add_action("handle_open", "open");
  add_action("handle_close", "close");
}
int handle_open(string str) {
  return (open_door("south", str));
}
int handle_close(string str) {
  return (close_door("south", str));
}
int do_pass(string arg) {
  object who;
  who = this_player();

  if (!arg || arg != "rattan")
    return notify_fail("你要通过什么？\n");
  tell_object(who, "你用手拨开藤蔓,向前走去。\n");
  who->move(__DIR__ "land1.lpc");
  tell_room(this_object(), "你看到" + who->query("name") + "用手拨开藤蔓,向前走去。\n");
  return 1;
}
