inherit ROOM;

void create()
{
  set ("short", "山洞");
  set ("long", @LONG
这山洞看起来很潮溼,洞壁四周长满了青苔
你发现地面有一些很奇怪的足迹,看起来不像是人类的脚印
难到是有怪物,还是野兽??看来你必须要小心点才是。
[31;1m走到这里你发觉跟其他地方有些不同,是出口的表征吗?[0m
LONG);
    set("exits", ([
    "southwest" : __DIR__"l8", ]));
   setup();
}
void init()
{
   add_action("do_search","search");
}
int do_search()
{
   object me;
   me = this_player();
 tell_room(me,""+me->query("name")+"发现洞顶有些异样,于是搜索一下,果然找到出路。\n");
   set("exits", ([
    "south"  : __DIR__"l5",
    "east"   : __DIR__"l8",
    "up"     : __DIR__"l10", ]));
    return 1;
}
