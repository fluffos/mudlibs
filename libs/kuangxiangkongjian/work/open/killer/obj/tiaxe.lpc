//axe write by Lum 6/14/1996
#include <ansi.h>
#include <weapon.h>
 
inherit AXE;
 
void create()
{
        set_name(HIW+"苍狼邪斧"+NOR, ({ "bastard axe", "axe" }) );
        set_weight(37000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把极其沈重的战斧。\n");
                set("value", 7400);
                set("material", "steel");
        }
        init_axe(85);
 
 
        setup();
}
int wield()
{
        if((int)this_player()->query("bellicosity")<500)
          return notify_fail("苍狼邪斧发出一阵尖锐的笑声:你还不够邪恶,不能够当我的主人。\n");
        else{
          ::wield();
            }
        return 1;
}
