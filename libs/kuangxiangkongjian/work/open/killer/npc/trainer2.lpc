#include <ansi.h>
inherit NPC;
void create() {
  set_name("教头", ({ "trainer" }));
  set("long",
    "他是黑牙联的督导教练,专门督促杀手成员的 练 习\n");
  set("race", "人类");
  set("gender", "男性");
  set("combat_exp", 250);
  set("age", 40);
  set("title", "黑牙联成员");
  set("kee", 350);
  set("max_kee", 350);
  set("bellicosity", 300);
  set_skill("sword", 30);
  set_skill("shadow-kill", 15);
  map_skill("sword", "shadow-kill");
  set("chat_chance", 3);
  set("chat_msg", ({ (: this_object(), "random_move" :),
    "教头愤怒地说: 小子,别偷懒 !\n",
  }));
  setup();
  carry_object("/open/gsword/obj/woodsword")->wield();
  add_money("silver", 5);
}
