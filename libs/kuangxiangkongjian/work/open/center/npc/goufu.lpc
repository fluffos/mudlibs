// goufu.c

#include "/open/open.h"

inherit NPC;

string do_ask();

void create() {
  set_name("倒霉的轿夫", ({ "bad-luck man", "man" }));
  set("race", "人类");
  set("gender", "男性");
  set("age", 25);
  set("long", "你正盯着轿夫看，他正聚精会神的研究赌术哩。\n");
  set("attitude", "peaceful");
  set("str", 26);
  set("cor", 22);
  set("combat_exp", 273);
  set("chat_chance", 8);

  set("chat_msg", ({
    "倒霉的轿夫说道: 么\二三啊 !\n",
    "倒霉的轿夫说道: 四五六啊 !\n",
    "倒霉的轿夫说道: 昨天才输光了裤子, 怎么今天运气还这么背 !\n",
    "轿夫说道: 茶水喝完了也不添一点, 唉, 这些人喔...\n",
    "倒霉的轿夫说道: 听说有个恶赌神找到一本赌神秘术，怎么不让我找到哩。\n",
    "倒霉的轿夫说道: 买好离手 !\n",
  }));

  set("inquiry", ([
    "出关": "东南西北有四个关口, 也不知是哪一个?!",
    "赌术": "你想教我吗? 不过, 听说有一本赌神秘术, 也不知是不是真的!",
    "么\"		: " 么 \ 就 是 一 点 的 意 思 嘛 !",
	" 么 \ 二 三 "	: " 么 \ 二 三 就 是 骰 子 出 一 点 或 者 出 两 点 或 者 出 三 点 的 意 思 。 ",
	" 输 光 "		: " 唉, 说 起 来 惭 愧 \, 跟 恶 赌 神 赌, 一 连 输 了 四 十 几 把, 不 输 光 才 怪 !",
	" 恶 赌 神 "	: " 不 就 是 轩 辕 三 光 吗 ? 不 跟 他 赌 硬 逼 人 跟 他 赌 。 ",
	" 轩 辕 三 光 "	: (: do_ask :),
	" 赌 神 秘 术 "	: " 听 说 有 了 这 本 书 之 后, 可 以 纵 横 赌 场, 要 它 开 几 点 就 开 几 点 ！ ",
	" 茶 水 "		: " 你 要 帮 忙 倒 茶 水 ? 先 谢 谢 你 啰 !",
	" 运 气 "		: " 说 什 么 运 气, 还 不 是 轩 辕 三 光 赖 账, 哼, 要 是 有 本 事, 一 定 砍 死 他 !",
	" 赖 账 "		: " 对 付 赖 账 的 人 应 该 抄 家 伙 扁 他 一 顿 。 ",
	" 抄 家 伙 "	: " 别 抄 家 伙 打 我 啊 !",
	" 扁 他 一 顿 "	: " 对 对 对, 这 位 英 雄 就 靠 您 为 小 的 出 口 怨 气 ",
	" 出 口 怨 气 "	: " 唉, 除 了 忍 气 吞 声 还 能 怎 样 呢 ？ ",
	" 忍 气 吞 声 "	: " 就 靠 您 帮 我 们 出 口 怨 气 了 。 ",
  ]) );

  set_temp(" apply / attack ", 15);
  set_temp(" apply / damage ", 3);
  set_temp(" apply / armor ", 2);
  setup();
}

string do_ask()
{
  object	me=this_player();

  if (me->query(" quests / gamble_book ")) return " 轩 辕 三 光 不 就 在 赌 场 吗 ? \ n ";
  me->set_temp(" quests / gamble_book ",1);
  return " 据 说 他 昨 晚 后 来 输 光 光, 为 了 躲 债, 出 关 去 了 。 ";
}
