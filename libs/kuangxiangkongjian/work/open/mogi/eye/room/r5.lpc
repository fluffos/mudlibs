#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "石洞");
  set("long", @LONG

     阴深深的洞穴,不知隐藏了什么宝物

     在墙角有个石头(stone)
     在北边的墙脚有个古怪的印记 (key)。

LONG);

  set("item_desc", ([ /* sizeof() == 2*/
    "stone": "黑色的石头上面布满了灰尘...是乎可以(touch)...\n",
    "key": "看来是这石洞的秘门,看来好像可以(push) \n",
  ]));

  set("exits", ([ /* sizeof() == 3 */

    "south": __DIR__ "r2",
  ]));
  set("light_up", 1);
  set("evil", 1);
  set("no_auc", 1);
  set("no_transmit", 1);
  setup();
}

void init() {
  add_action("do_push", "push");
  add_action("do_touch", "touch");
}

int do_touch(string str) {
  object ob = this_player();

  if (str != "stone") return 0;

  {
    tell_object(ob, "你看道七色光芒向你射来......\n");
    message_vision(HIW "你似乎听到个声音! ~~ 谢谢你放我出来,加你200的气做为报答..\n" NOR, ob);
    write(HIR "感到前所未有的力量逐渐涌上来!!\n" NOR);
    ob->add("kee", 200);
    ob->move(__DIR__ "out_room");
    return 1;
  }
}

int do_push(string str) {

  if (str != "key") return 0;

  tell_object(this_player(), "右边的墙缓缓移出一道门。\n");
  add("exits/east", __DIR__ "r6");
  return 1;
}
