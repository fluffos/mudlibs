inherit ROOM;

void create ()
{
   set  ("short", "魔眼洞");
  set ("long", @LONG
 
    石洞中不时传来阴深恐怖的声音,让人不觉的毛骨悚然
   

LONG);

  set("exits", ([ /* sizeof() == 1 */
    "out"  : __DIR__"r8",
]));
   set("objects",([ /* sizeof() == 1 */
       "/open/mogi/eye/npc/mob3" : 1,
       "/open/mogi/eye/npc/beast.lpc" : 2,
       "/open/mogi/eye/npc/small-ghost" : 1,
      ]));
  set("light_up", 1);

  set("evil",1);
  set("no_auc",1);
  set("no_transmit",1);
  setup();
}
int valid_leave(object me, string dir)
{
  if( dir=="out" && present("ghost",environment(me)))
if(!me->query_temp("allow_read")) 
 return notify_fail("魔界之王说过: 任何人都不准进入魔界,欲入魔界者,需得到他的同意,"
+RANK_D->query_respect(me)+"还是请回吧!\n");
return ::valid_leave(me,dir); 
}

