// mob2.c by konn

#include <ansi.h>
inherit NPC;

int kill_him(object);

void create() {
        set("title","魔界野妖");
        set_name(HIC"黑暗□怪"NOR,({"dark ghost","ghost"}));
        set("long",
            "\n它看起来想崤N你整个人撕裂，吒n作为它的晚餐\n");
        
        set("age",1437);
//        set("race","妖怪");
        set("race","野兽");
        set("gender","雄性");
        set("attitude","friendly");
        set("max_gin",9830);
        set("max_kee",35500);
        set("max_sen",24420);
        set("max_force",1300);
        set("force_factor",5);
        set("combat_exp",1300000);

        set_temp("apply/attack",100);
        set_temp("apply/damage",100);
        set_temp("apply/dodge",200);
        set_temp("apply/move",200);
        set_temp("apply/armor",200);

        set_skill("unarmed",70);
        set_skill("dodge",110);
        set_skill("move",80);
        set_skill("parry",90);
	set_skill("hell-evil", 100);
        map_skill("unarmed", "hell-evil");

        set("limbs",({"头部","胸部","大黑手","大黑脚","背部","腰部"}));
        set("verbs",({"bite","claw"}));

        set("chat_chance_combat",30);
        set("chat_msg_combat",({
            HIW"\n          黑暗□怪兴奋的发出咭咭的怪笑!\n\n"NOR,
            HIW"\n          黑暗□怪看起来想把你吃掉!\n\n"NOR
      }));

        setup();
 }

void init() {
        object obj;

        ::init();
        if(interactive(obj=this_player()) && !is_fighting()) {
           remove_call_out("kill_him");
           call_out("kill_him",0,obj);
        }
 }

int kill_him(object obj) {
//        if(obj->query("race") == "妖怪") return 1;
        if(obj->query("race") == "野兽") return 1;
        if(obj->query("max_force") > 999 ||
           obj->query("combat_exp") > 299999)
           command("kill "+obj->query("id"));
        return 1;
 }
