#include <ansi.h>
inherit NPC;

void create() 
{
        set("title","魔界守护者");
        set_name("灵妖恶鬼",({"hell evil","evil"}));
        set("long",
            "它是这里的老大, 想通过这里必须跟他比试才行。\n\n");

        set("age",237);
//        set("race","妖怪");
        set("race","野兽");
        set("gender","雄性");
        set("attitude","aggressive");
        set("max_gin",40000);
        set("max_kee",40000);
        set("max_sen",40000);
        set("max_force",30000);
        set("force_factor",20);
        set("combat_exp",600000);

        set_temp("apply/attack",100);
        set_temp("apply/damage",100);
        set_temp("apply/dodge",200);
        set_temp("apply/move",200);
        set_temp("apply/armor",200);

        set_skill("unarmed", 80);
        set_skill("dodge", 90);
        set_skill("move", 100);
        set_skill("parry", 110);
//	set_skill("evil", 100);
//	map_skill("unarmed", "evil");

        set("limbs",({"头部","胸部","大黑手","大黑脚","背部","腰部"}));
        set("verbs",({"bite","claw"}));

        setup();
}
