// mob3.c by konn

#include <ansi.h>
inherit NPC;

int kill_him(object);

void create() {
        set("title","魔界□僧妖");
        set_name(HIG"青血精"NOR,({"green ghost","ghost"}));
        set("long",
            "\n它是这座森林的黑守护，对于外来的人类，必定赶尽杀绝!\n");
        
        set("age",2258);
//        set("race","妖怪");
        set("race","野兽");
        set("gender","雄性");
        set("attitude","friendly");
        set("max_gin",26440);
        set("max_kee",35000);
        set("max_sen",32210);
        set("max_force",1700);
        set("force_factor",8);
        set("combat_exp",1800000);

        set_temp("apply/attack",100);
        set_temp("apply/damage",100);
        set_temp("apply/dodge",200);
        set_temp("apply/move",200);
        set_temp("apply/armor",200);

        set_skill("unarmed",80);
        set_skill("dodge",95);
        set_skill("move",100);
        set_skill("parry",115);
	set_skill("hell-evil", 100);
        map_skill("unarmed", "hell-evil");

        set("limbs",({"头部","胸部","大黑手","大黑脚","背部","腰部"}));
        set("verbs",({"bite","claw"}));

        set("chat_chance_combat",30);
        set("chat_msg_combat",({
            HIW"\n          青血精张着大嘴拚命的对你呵气!\n\n"NOR,
            HIW"\n          青血精看起来想把你吃掉!\n\n"NOR
      }));

        setup();
 }

void init() {
        object obj;

        ::init();
        if(interactive(obj=this_player()) && !is_fighting()) {
           remove_call_out("kill_him");
           call_out("kill_him",0,obj);
        }
 }

int kill_him(object obj) {
//        if(obj->query("race") == "妖怪") return 1;
        if(obj->query("race") == "野兽") return 1;
        if(obj->query("max_force") > 999 ||
           obj->query("combat_exp") > 299999)
           command("kill "+obj->query("id"));
        return 1;
 }
