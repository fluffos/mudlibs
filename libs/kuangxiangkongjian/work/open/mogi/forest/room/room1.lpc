#include <ansi.h>
inherit ROOM;

void create () {
        set ("short","魔界森林入口");
        set ("long", @LONG
这座森林是魔界中最恐怖的地方，一进入这座森林(forest)，便很难再
出得来，不！应该是再也出不来了。这座森林里处处充满了可怕的妖怪
，你听，远方妖怪传来凄厉的哀豪声，不禁使你毛骨悚然起来。这座森
林里除了有可怕的妖怪外，还有着近十层的妖气在里面迷漫，一般人进
去之后，浓烈的妖气会消耗其精气神，而导致在里面昏迷不醒，最后惨
遭被怪物吞食的命运。在这地上竖了一个碑(sign)。



LONG);

	set("evil", 1);
	set("no_auc", 1);
	set("no_transmit", 1);
        set("light_up",1);
        set("outdoors",__DIR__"room");
        set("item_desc",([ /* sizeof == 2 */
            "forest" : HIW"这座森林所环绕的妖气实非人类所能承受的，闲人"+
                       "请速速离去。\n"NOR,
            "sign" : HIW"道高一尺，魔高一丈。\n"+
                     "苦海无涯，回头是岸。\n"NOR
      ]));

        set("exits", ([ /* sizeof() == 2 */
            "east"  : "/u/k/konn/workroom",
            "west"  : __DIR__"room20",
            "south" : __DIR__"room2",
      ]));

        setup();
}
