#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "魔方阵");
  set("long", @LONG
这里四通八达，似乎每条路都可以到达出口，想要正确地选择一条
路还真不容易呀! 不知道魔界的怪物们是怎么走出这魔方阵(cube)
的...


LONG);
  set("item_desc", ([ /* sizeof == 1 */
    "cube": "\n这是一个3*3*3 的魔方阵，你必须走到中央后" +
    "search方可出去!\n\n",
  ]));

  set("evil", 1);
  set("no_auc", 1);
  set("no_transmit", 1);
  set("light_up", -1);
  set("exits", ([ /* sizeof() == 6 */
    "north": __DIR__ "cube13",
    "east": __DIR__ "cube17",
    "west": __DIR__ "cube11",
    "south": __DIR__ "cube15",
    "up": __DIR__ "cube5",
    "down": __DIR__ "cube23",
  ]));

  setup();
}

void init() {
  object me = this_player(), mob;

  add_action("do_search", "search");
  if (!interactive(me)) return;
  mob = new("/open/mogi/forest/npc/evil");
  mob->move(environment(me));
  mob->kill_ob(me);
}

int do_search() {
  object me = this_player();
  tell_object(me, HIW "\n忽然一阵妖风将你卷了起来...\n\n" NOR);
  me->move(me->query("startroom"));
  tell_object(me, HIW "\n妖风咻的不见了! 你发觉来到了另" +
    "一个世界!\n\n" NOR);
  return 1;
}
