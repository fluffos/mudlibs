	set("evil", 1);
        set("no_auc", 1);
        set("no_transmit", 1);
        set("light_up",-1);
        set("exits",([ /* sizeof() == 6 */
            "north" : __DIR__"cube17",
            "east"  : __DIR__"cube12",
