inherit ROOM;
#include "/open/mogi/forest/room/forest.msg"

void create() {
  set("short", "魔森林");
  set("long",
    (: print_forest_msg :)
  );

  set("evil", 1);
  set("no_auc", 1);
  set("no_transmit", 1);
  set("light_up", -1);
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "room26",
    "south": __DIR__ "room21"
  ]));

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "mob": 1,
  ]));

  setup();
}
