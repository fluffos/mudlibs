//dancerboots//
#include <ansi.h>
inherit EQUIP;
void create()
{
        set_name(MAG "凤舞靴" NOR,({"boots"}) );
        set_weight(2000);
        if ( clonep() )
                set_default_object(__FILE__);
        else{
                set("long","
这是月牙儿专用的舞靴，相传为傅剑寒所赠的凤羽所制，非但外观极其
美丽，相传更有不可思议之效。\n");
                set("unit","双");
                set("value",20000);
                set("armor_prop/armor",30);
                set("armor_prop/dodge",10);
                set("armor_prop/move",10);
                set("material","leather");
                set("armor_type","boots");
            set("wear_msg", "$N穿上$n忽然感到身子轻盈了起来，好似要飞一般。\n");
            set("remove_msg", "$N将$n脱了下来，感到身体一沉，又恢复原状了。\n");
                setup();
        }
}
