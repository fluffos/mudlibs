/instrument#include <ansi.h>#include <weapon.h>inherit INSTRUMENT;void create(){        set_name(HIR "木琴" NOR,({"woodeninstrument","instrument"}));        set_weight(3000);        if( clonep() )                set_default_object(__FILE__);        else {                set("unit","具");          set("value",600);                set("material","wood");                set("long",        "这是一具由上等原木雕刻而成的木琴。\n");        }        init_instrument(20);        setup();}
