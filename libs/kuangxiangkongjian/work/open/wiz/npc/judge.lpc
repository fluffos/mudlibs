// judge.c

#include <login.h>
#include <ansi.h>

inherit NPC;

int in_ask, answer;

void create() {
  set_name("冰判官", ({ "judge" }));
  set("short", "专门对付笨蛋的审判官(judge)");
  set("long",
    "这是一位审查玩家是否是笨蛋的审判官，你必须答对(answer)他三个问题才能\n"
    "脱离他的掌握。\n");

  set("gender", "男性");

  set("age", 40);

  set("str", 100);
  set("int", 100);
  set("cor", 100);
  set("gin", 999);
  set("kee", 999);
  set("sen", 999);

  set("no_kill", 1);

  setup();

  in_ask = 0;
}

void init() {
  string id;

  ::init();
  id = this_player()->query("id");
  if (!query_heart_beat(this_object())) set_heart_beat(1);
  add_action("do_answer", "answer");
  delete_temp("wrong/" + id);
  delete_temp("slow/" + id);
  this_player()->delete_temp("answer_right");
  add_action("no_tell", "tell");
  add_action("no_tell", "reply");
  add_action("no_tell", "whisper");
  add_action("no_tell", "shout");
  add_action("no_tell", "chat");
  add_action("no_tell", "rumor");
  add_action("no_action", "perform");
  add_action("no_action", "practice");
  add_action("no_action", "exert");
  add_action("no_action", "cast");
  add_action("no_action", "conjure");
  call_out("judge", 1);
}

int no_action(string str) {
  return notify_fail("冰判官说道: 在这儿除了回答问题, 你还想干嘛?\n");
}

int no_dest(string str) {

  if (this_player()->query("id") == "ice" || this_player()->query("id") == "wade") {
    command("say 是的!! " + this_player()->query("id") + "!! 我的主人!! 我马上去死!!\n");
    message_vision("只见$N一声令下, 冰判官切腹自杀了!!\n", this_player());
    this_object()->die();
  } else
    write("你想消灭我冰判官!?乖乖回答问题吧!!\n");
  return 1;
}

int no_tell(string str) {
  write("想搬救兵!?门儿都没有!!\n");
  return 1;
}

void judge() {
  object ob, *inv;
  int a, b, c, d;
  string oper;

  remove_call_out("judge");
  remove_call_out("say_answer");
  if (in_ask)
    command("say 有人来了, 我们重新出题吧!");

  inv = all_inventory(this_object());
  for (a = 0; a < sizeof(inv); a++)
    if (userp(inv[a]))
      inv[a]->delete_temp("answer_right");
  in_ask = 0;
  a = random(100) + 1;
  b = random(100) + 1;
  switch (random(5)) {
    case 0:
      answer = a + b;
      oper = chinese_number(a) + "加上" + chinese_number(b) + "等于多少？";
      break;
    case 1:
      answer = a - b;
      oper = chinese_number(a) + "减去" + chinese_number(b) + "等于多少？";
      break;
    case 2:
      if (a * b < 200) {
        answer = a * b;
        oper = chinese_number(a) + "乘上" + chinese_number(b) + "等于多少？";
      } else {
        answer = (a * b) % 10;
        oper = chinese_number(a) + "乘上" + chinese_number(b) + "，个位数等于多少？";
      }
      break;
    case 3:
      answer = a % b;
      oper = chinese_number(a) + "除以" + chinese_number(b) + "余于多少？";
      break;
    case 4:
      oper = chinese_number(a) + "和" + chinese_number(b) + "的最大公因数是多少？";
      if (b < a) { c = b; b = a; a = c; }
      while (a > 1 && b % a > 1) {
        c = a;
        a = b % a;
        b = c;
      }
      answer = b % a == 1 ? 1 : a;
      break;
    case 5:
      d = a * b;
      oper = chinese_number(a) + "和" + chinese_number(b) + "的最小公倍数是多少?";
      if (b < a) { c = b; b = a; a = c; }
      while (a > 1 && b % a > 1) {
        c = a;
        a = b % a;
        b = c;
      }
      answer = b % a == 1 ? d : d / a;
      break;
  }
  command("say " + oper + "，请在二十秒内作答(answer)。");
  in_ask = 1;
  call_out("say_answer", 20);
}

void say_answer() {
  int i;
  object me, *inv, ob;
  string id, name, ans;

  in_ask = 0;
  me = this_object();
  ans = chinese_number(answer);
  if (environment()) {
    inv = all_inventory(environment());
    for (i = 0; i < sizeof(inv); i++) {
      ob = inv[i];
      id = ob->query("id");
      name = ob->name();
      if (!userp(ob) && ob != me) {
        destruct(ob);
        continue;
      }
      // 答对就不必检查了
      if (ob->query_temp("answer_right")) {
        ob->delete_temp("answer_right");
        continue;
      }
      // 剩下的就是答错的
      tell_object(ob, "冰判官说道: 这么简单都不会？答案等于" + ans + "。\n");
      if (userp(ob) && !wizardp(ob)) {
        command("say " + name + ", 你反应太慢了喔!! 给我小心一点!!");
        add_temp("slow/" + id, 1);
        if (query_temp("slow/" + id) > 10) {
          command("say " + name + ", 你再发呆啊!! 再迟钝啊!! 给我去死吧!!");
          ob->delete("env/immortal");
          delete_temp("slow/" + id);
          delete_temp("wrong/" + id);
          ob->command("quit");
        }
      }
    }
  }
  inv = all_inventory(environment());
  if (sizeof(inv))
    call_out("judge", 1);
}

int do_answer(string arg) {
  string s, myid, myname, id, home_path;
  object me, *inv, ob, who;
  int ans, i;

  if (!in_ask) return notify_fail("你必须等下一题。\n");
  notify_fail("请你回答一个数字。\n");
  if (!arg) return 0;

  who = this_player();
  myid = who->query("id");
  myname = who->name();
  me = this_object();

  if (who->query_temp("answer_right")) {
    tell_object(who, "冰判官说道: 你已经答对了, 不必再作答!\n");
    return 1;
  }
  tell_object(who, CYN "你答道：" + arg + "\n" NOR);

  if (sscanf(arg, "%d", ans) == 1) {
    if (ans == answer) {
      who->add_temp("robot_check", 1);
      command("say " + myname + "答对了！");
      command("pat " + myid);
      delete_temp("wrong/" + myid);

      if (who->query_temp("robot_check") >= 3) {
        command("say 很好，" + myname + ", 你看起来不像笨蛋，你可以回家了。\n");
        if (stringp(s = who->query_temp("old_startroom")))
          who->set("startroom", s);
        who->delete_temp("robot_check");
        delete_temp("wrong/" + myid);
        delete_temp("slow/" + myid);
        if (file_size(home_path = user_path(geteuid(who)) + "workroom.lpc") > 0)
          who->move(home_path);
        else {
          if (stringp(s = who->query_temp("old_location")))
            who->move(s);
          else
            who->move(STARTROOM);
        }
      }
      who->set_temp("answer_right", 1);
    } else {
      command("say " + myname + "答错了！");
      add_temp("wrong/" + myid, 1);
      if (query_temp("wrong/" + myid) > 10) {
        command("say " + myname + ", 你再给我乱猜啊，笨蛋!! 去死吧。\n");
        who->receive_damage("kee", 100, me);
        who->delete("env/immortal");
        delete_temp("slow/" + myid);
        delete_temp("wrong/" + myid);
        who->command("quit");
      }
    }
  } else return 0;
  return 1;
}
