#include <room.h>

inherit ROOM;

void create()
{
           set("short","洞穴");
          set("long","当你藉由白骨上所发出的灵光看清楚地上遍布着无数的白骨,你开始为自己愚笨的踏进这个洞穴而感到后悔!\n");
        set("exits", ([
        "north":__DIR__"hole2",
	"south":__DIR__"hole",
          "west":__DIR__"hole4",
          "east":__DIR__"hole5",
        ]) );
        setup();
}
