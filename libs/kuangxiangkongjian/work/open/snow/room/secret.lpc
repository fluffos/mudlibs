#include <room.h>
#include "/open/open.h"
inherit ROOM;

void create() {
  set("short", "密室");
  set("long", "这里是一间密室，四周光线极弱，看起来像关犯人的监牢，眼看前面似乎有个老人在那，不知道是何方人士？\n");
  set("exits", ([
    "west": __DIR__ "eqroom",
    "out": __DIR__ "hole2",
  ]));
  set("light_up", 1);
  set("objects", ([
    "/daemon/class/blademan/master_oldman": 1,
  ]));
  set("valid_startroom", 1);
  setup();
  call_other("/obj/board/oldman_b", "???");
}
int valid_leave(object me, string dir) {
  if (dir == "west")
    if (me->query("family/family_name") != "魔刀莫测")
      return notify_fail("只有魔刀才可进\n");
  return ::valid_leave(me, dir);
}
