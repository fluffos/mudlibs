// message.c
// 由 wade 更改过, 改成可以由玩家下命令设定在编辑或输入时是否要显示讯息
// wade 5/20/1996
// 增加可以储存所有自己见到的讯息，以便在有人干扰的时候能留做见证．
// wade 7/10/1996

#include <ansi.h>
#include <dbase.h>

#define MAX_MSG_BUFFER 200

nosave string *msg_buffer = ({});

void receive_message(string msgclass, string msg) {
  string subclass, *ch, *tmp;
  int i, l;

  if (!interactive(this_object())) {
    this_object()->relay_message(msgclass, msg);
    return;
  }

  if (sscanf(msgclass, "%s:%s", subclass, msgclass) == 2) {
    switch (subclass) {
      case "channel":
        if (!pointerp(ch = query_temp("channels"))
          || member_array(msgclass, ch) == -1)
          return;
        break;
      case "outdoor":
        if (!environment() || !environment()->query("outdoors"))
          return;
        break;
      default:
        error("Message: Invalid Subclass " + subclass + ".\n");
    }
  }

  if (query_temp("block_msg/all") || query_temp("block_msg/" + msgclass))
    return;

  // 可以储存所有自己见到的讯息
  if ((l = (int)query_temp("记录")) && l > 0) {
    if (l < time()) {  // 过期了
      set_temp("记录", 0);
      write("你的记录功\能已经到期了.\n");
    }
    log_file("harass/" + geteuid(), msg);
  }

  if (this_object()->query("env/wait_edit") &&
    (in_input(this_object()) || in_edit(this_object()))) {
    if (sizeof(msg_buffer) < MAX_MSG_BUFFER)
      msg_buffer += ({ msg });
    else {
      l = MAX_MSG_BUFFER / 2;
      tmp = msg_buffer;
      for (i = 0; i < l; i++)
        msg_buffer[i] = tmp[i + l];
      tmp = ({});
    }
  } else
    receive(msg);
}

void write_prompt() {
  if (sizeof(msg_buffer)) {
    receive(BOLD "[输入时暂存讯息]\n" NOR);
    //for(int i=0; i<sizeof(msg_buffer); i++)
    //  receive(msg_buffer[i]);
    this_object()->more("", msg_buffer, 0);
    msg_buffer = ({});
  }
  write("> ");
}

void receive_snoop(string msg) {
  receive("%" + msg);
}
