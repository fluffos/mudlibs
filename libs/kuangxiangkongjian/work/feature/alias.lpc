// alias.c
#include <ansi.h>
#include <login.h>
#include <dbase.h>

#define MAX_ALIASES 50

inherit F_SAVE;

mapping alias;

string replace_alias (string str)
{
  string	cmd, arg, *args;
  int		i;

  seteuid(getuid());

  // 有人会做蠢事, 把 go 或者 do 也拿来当 alias
  if (str[0..2] == "go " || str[0..2] == "do") return str;
  cmd = (string)ALIAS_D->process_global_alias(str);

  if( mapp(alias) ) {
    if (sscanf (cmd, "%s %s", cmd, arg) != 2) {
      if( !undefinedp(alias[cmd]) )
        cmd = replace_string( alias[cmd], "$*", "" );
    }
    else if( !undefinedp(alias[cmd]) ) {
      cmd = replace_string( alias[cmd], "$*", arg );
      args = explode(arg, " ");
      for(i=0; i<sizeof(args); i++)
          cmd = replace_string( cmd, "$" + (i+1), args[i] );
    }
    else cmd = cmd + " " + arg;
  }
  return cmd;
}

string process_input(string str)
{
  object me = this_object();
  string cmd, verb, arg;
  int i, j, n=1, gin, kee, sen;

  seteuid(getuid());
  notify_fail(str+"? 看不懂啦, 请用 help cmds 查一般指令!\n");
// 让玩家能 quit when busy...
// 如 suicide 时..    edit by lys 3.2.1996
  if(!wizardp(this_object()) && this_object()->is_busy() && str != "quit"){
    notify_fail ("忙忙忙, 等等再下命令吧.\n");
    return "";
  }
  if (str != "quit" && this_object()->query_temp("block_msg/all")) return 0;
  cmd = replace_alias (str);

/*
	为了要试看看是不是这里造成lag ... 
	所以暂时拿掉...  by Konn

*/

  // ! 用来重复上一命令
  if (cmd == "!!") cmd = query_temp("current_input");
  // ! 后面有接东西
  else if (cmd[0] == '!') {
    arg = query_temp("current_input");
    cmd = arg + cmd[1..<0];
  }
  // 这是用来修改上一命令
  else if (cmd[0] == '^') {
    n = strlen(cmd);
    if ((j=strsrch(cmd[1..<0], "^")) > 0 && j < n-2) {
        verb = cmd[1..j];
        arg = cmd[j+2..<0];
        cmd = query_temp("current_input");
        cmd = replace_string(cmd, verb, arg);
    }
  }
  else 
if (sscanf (cmd, "%d %s", n, verb) == 2 && n > 0) {
    verb = replace_alias (verb);
    cmd = sprintf ("%d %s", n, verb);
  }
  else n = 1;

  // 一般移动相当于两个命令, 即 e 相当于 先 look 要去的房间, 再 move 到该房间
  // 为了不重复计算, 必须滤掉 look 命令的计算
  add_temp("cmd_cnt",n);
  set_temp("last_input",query_temp("current_input"));
  set_temp("current_input", cmd);

  if ((n=query_temp("cmd_cnt")) > 30) {
	write ("小心喔, 不要一次下太多指令了....\n");
        if (n > 45) {
	  write ("你一次下太多命令了，系统无法负荷得了。\n只好请你走路了。\n");
	  set_temp("last_location", base_name(environment(this_object())));
	  set("startroom", ROBOT_CHECK);
	  save();
	  command("quit");
        }
  }
  if( strlen(str) == 0 ) {
    gin = me->query("gin");
    kee = me->query("kee");
    sen = me->query("sen");
    printf("\n<精: "HIY"%d"NOR" 气: "HIG"%d"NOR" 神: "HIM"%d"NOR, 
      gin, kee, sen);
  }
  return cmd;
}

int set_alias(string verb, string replace)
{
	if( !replace ) {
		if( mapp(alias) ) map_delete(alias, verb);
		return 1;
	} else {
		if( !mapp(alias) ) alias = ([ verb:replace ]);
		else if( sizeof(alias) > MAX_ALIASES )
			return notify_fail("您设定的 alias 太多了，请先删掉一些不常用的。\n");
		else alias[verb] = replace;
		return 1;
	}
}

mapping query_all_alias()
{
	return alias;
}
