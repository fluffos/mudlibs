/*
 * FluffOS simul_efun for the SWLPC 0.9.1 catalog overlay.
 * Original SWLPC emulate.lpc is preserved under /RO/emulate.lpc.
 */

void cat(string file) {
  string s;

  s = read_file(file);
  if (s)
    write(s);
}

void log_file(string file, string str) {
  if (file_size("/log") != -2)
    mkdir("/log");
  write_file("/log/" + file, str);
}

int exists(string path) {
  return file_size(path) != -1;
}
