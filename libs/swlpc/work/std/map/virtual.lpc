/*
 * Nested GetVirtualObject.
 */

nosave string room_template = "room/room";

set_room_template(string t) {
	room_template = t;
	}

object GetVirtualObject(string name) {

object GetVirtualObject(string name) {
    string prefix = file_name(this_object()) + "/";	/* computed each time, in case it changes */

    array rdesc = scancoords(name[sizeof(myname)..]);

    if (!rdesc) {
	TG("GetVirtualObject:" + name + " not found.");
	return 0;
	}
    array dd = compute_dd(rdesc);

    object room = clone_object(room_template);
    room->set_short("A maze of twisty little passages, all alike.");
    room->set_long("A maze of twisty little passages, all alike.\n");
    rename_object(room, file_name(this_object()) + "/" + makecoord(rdesc));
    room->set_area_controller(this_object());
    room->set_dest_dir(dd);
    MAPKNOWER->add_location(name, dd, file_name(this_object()));
    this_object()->init_room(room, name);
    return room;
}
