/*
 * Code ripped from Squawk's skeleton key, and my hacks to
 * Taliesin's router monster.
 * It inherits obj/key because it's used as the key object
 * to pick doors.
 */

inherit "obj/key";

#include "gender.h"

#define OWNER environment(this_object())

object key;

reset(arg)
{
        ::reset(arg);
	if (arg) return;
	set_short(0);
	set_type("skeleton");
	set_long("A small skeleton key that will open _ANY_ door\n");
}

init() {
	add_action("set_pick","set_pick",0); 
}

get_type()
{
	int i;
	i = random(10);
	if (i == 0) return "pink";
	if (i == 1) return "bronze";
	if (i == 2) return "tin";
	if (i == 3) return  "nickel";
	if (i == 4) return  "granite";
	if (i == 5) return  "silver";
	if (i == 6) return  "black";
	if (i == 7) return  "wood";
	if (i == 8) return  "hemp";
	if (i == 9) return  "lead";

	return "wierd";
}


/*
 * Call set_pick to pick a lock in a particular direction.
 * Returns the current door state, or (-1) if it isn't a door.
 */

set_pick (string arg) 
{
	int i;
	string dirn, code, state;
	array dest_dir, allargs;

	if (!(OWNER->query_wiz() || OWNER->query_npc()))
		return(-2); 

	if(arg=="e") arg="east";
	if(arg=="n") arg="north";
	if(arg=="w") arg="west";
	if(arg=="s") arg="south";

	dest_dir = environment(OWNER) -> query_dest_dir();
	if (!dest_dir)
	    return (-3);
	for ( i=0; i < sizeof(dest_dir); i= i+2) 
    {
        allargs = STRINGS->split_first(dest_dir[i+1], "#");
        if (allargs && sizeof(allargs) == 2 ) {
            dirn = allargs[0];
            code = allargs[1];
			if (dirn == arg) 
            {
			    state = code[0..0];
			    code = code[1..];
			    tell_object(OWNER,"Code is "+code+".\n");
				set_code(code);
				return atoi(state);
			}
		}
	}
        return (-1);
}
