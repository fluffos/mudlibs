inherit "std/object";

/*
 * This is a generic torch.
 * It will have some good initializations by default.
 * The torch can't be sold when it is lit.
 *
 * Modified by Rhys for wet weather and Billy to use /std/object
 *
 * Here is some example code for a reset() function:
 *   set_name("oil lamp");
 *   set_full_name("an oil lamp");
 *   set_id( ["oil lamp", "lamp"] );
 *   set_fuel(500);
 *   set_lit_desc("The lamp burns warmly, casting its sides into shadow.\n");
 *   set_unlit_desc("It is carved with dark runes.\n");
 *   set_water(0, "The " + query_name() + " gutters and the flame goes out\n") 
 *						- if water-sensitive
 *   set_water(1, "The " + query_name() + " gutters but does not go out\n") 
 *						- ONLY if water-proof
 */
/* 
 * modified by Hunter to use std/object's LIGHT property */

reset(arg) {
    ::reset(arg);
    if (arg)
	return;
    set_fuel(600); 
    set_lit(0); 
    set_waterproof(0);
    set_name("light");
    set_lit_desc("It has been created by an incompetent wizard. It is lit.\n");
    set_unlit_desc("It has been created by an incompetent wizard. It is unlit.\n");
}

set_name(name) { set_id(name); set_full_name("a " + name); }
set_full_name(n) { set_short(capitalize(n)); }
query_full_name() { return short_desc; }
