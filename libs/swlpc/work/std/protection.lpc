int absorb_damage(type, amt, locn) {
    int i, deduct;
    object pob = environment(this_object());

    if (!query_invoked() || this_object()->query_broken())
	return amt;
    if (pointerp(type)) {
        for (i = 0; i < sizeof(type); i++)
            amt -= absorb_damage(type[i], amt, locn);
        return amt;
        }
    if (pointerp(locn)) {
        for (i = 0; i < sizeof(locn); i++)
            amt -= absorb_damage(type, amt, locn[i]);
        return amt;
        }
    if (amt < 1)
	return 0;
    if (pob != caller()) {
	uninvoke();
#if 0
	object j = find_player("jenna");
	if (j) {
		tell_object(j, "[Armour:] Weirdness in " + file_name(this_object()) + ".\n");
		tell_object(j, "[A:] env = " + file_name(pob) + " ( " + pob->short() + ".\n");
		tell_object(j, "[A:] caller = " + file_name(caller()) + " ( " + caller()->short() + ").\n");
		}
#endif
	return 0;
	}
    for (i = 0; i < sizeof(protections); i++)
        if (DAMAGE->is_same_type(type, protections[i][TYPE])
            && is_protected(locn, protections[i][LOC])) {
                deduct = protections[i][AMT] - protections[i][USED];
                if (deduct > (amt * protections[i][PERC]) / 100)
                    deduct = (amt * protections[i][PERC]) / 100;
                if (deduct > amt)
                        deduct = amt;
                if (deduct) {
                    amt -= deduct;
		    call_out("damage_self", 0.2, deduct, type);
                    if (protections[i][REJUV]) {
                        if (!protections[i][USED]
                            || find_call_out("rejuv_prot") == -1)
                             call_out("rejuv_prot", 1, i);
                        protections[i][USED] += deduct;
                        }
                    if (protections[i][CALLBACK_OBJ])
                        (protections[i][CALLBACK_OBJ])->
                            (protections[i][CALLBACK_FUN])(type, deduct, locn);

                    }
                }
    return amt;
    }

damage_self(amt, type)
{
    string n = this_object()->query_name();  /* pre-"(broken)" */
    int already_broken = this_object()->query_broken();

    this_object()->damage_object(amt, type);
    if (this_object()->query_broken() && !already_broken)
    {
	object me = this_object()->query_worn();
	if (!me)
	    me = environment(this_object());
	if (me)
	{
	    tell_object(me, "Your "+n+" splinters!\n");
	    me->checked_say(me->query_name()+"'s "+n+
		" splinters!\n");
	}
    }
}

rejuv_prot(x) {
    if (x < 0 || x >= sizeof(protections))
        return;
    protections[x][USED] -= protections[x][REJUV];
    if (protections[x][USED] > 0)
        call_out("rejuv_prot", 1, x);
    else if (protections[x][USED] < 0)
        protections[x][USED] = 0;
    }

describe_protections() {
    return DAMAGE->describe_protections(this_object());
    }

set_all_protections(a) { protections = a; }

query_destruct() {
	if (query_invoked())
		uninvoke();
	}


