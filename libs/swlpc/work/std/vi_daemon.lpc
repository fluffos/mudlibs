/* 
 * Visual Edit Daemon
 *
 * Hunter of Shattered Worlds
 * October 1992
 */

inherit "std/edit_daemon";

edit_file(file)
{
    int argc;
    array args;
    array argv;
    string WotsLeft;
    string WotchaGot;
    string FileName;

    if (!present ("wiz_soul",this_player()) ) return 0;
    if (this_player()->query_term_type() == "vt100")
        write("Remember, your correct terminal type can now be set using: terminal <type>\n");
    argc = 0;
    this_player()->push_caution("using vi");
    argv = allocate(0);
    if (file != 0)
    {
        int i;
        args = explode(file, " ");
        argc = 0;
        for (i = 0; i < sizeof(args); i++)
        {
            argc++;
            FileName = "/" + present ("wiz_soul",
                        this_player())->valid_read(args[i]);
            if (FileName)
            {
                argv = argv + [ argc ];
                argv[argc-1] = FileName;
            }
        }
        FileName = "/" + implode(args[i+1..], " ");
        argv = argv +  [ argc ];
        argv[argc-1] = FileName;
    }
    external_program("elvis", "edit_done", argv);
    write("vi is starting...");
    return 1;
}
