inherit "secure/player";

nosave int Available;
nosave object OnlinePlayer;


reset()
{
Available = 0;
OnlinePlayer = 0;
}


init()
{
}


call(PlayerName, FuncName, Params)
{
int RetVal;
object PlayerObj;

/* see if we already have the player loaded */
if (PlayerName == name)
    { /* a name match */
    if (OnlinePlayer) /* use the on-line player object */
        PlayerObj = OnlinePlayer;
    else
        { /* player isn't logged on */
        if (!Available)
            LoadPlayer(PlayerName);
        PlayerObj = this_player();
        }
    }
else
    { /* different name from last time - get a new one */
    if (!OnlinePlayer && Available)
        { /* last was a loaded, available one - so save */
        MakeUnavailable();
        }
    /* last was on-line, so try to find the new one */
    write("finding " + PlayerName + ".\n");
    PlayerObj = find_player(PlayerName);
    OnlinePlayer = PlayerObj;
    write(PlayerObj);
    write("\n");
    if (!PlayerObj)
        { /* try to load them from disk */
        write("loading\n");
        LoadPlayer(PlayerName);
        PlayerObj = this_object();
        }
    }
Available = 1;
name = PlayerName;
        
/* do the call */
if (sizeof(Params) == 0)
    RetVal = call_other(PlayerObj, FuncName);
else if (sizeof(Params) == 1)
    RetVal = call_other(PlayerObj, FuncName, Params[0]);
else if (sizeof(Params) == 2)
    RetVal = call_other(PlayerObj, FuncName, Params[0], Params[1]);
else if (sizeof(Params) == 3)
    RetVal = call_other(PlayerObj, FuncName, Params[0], Params[1], 
    	Params[2]);
else if (sizeof(Params) == 4)
    RetVal = call_other(PlayerObj, FuncName, Params[0], Params[1], 
    	Params[2], Params[3]);
else if (sizeof(Params) == 5)
    RetVal = call_other(PlayerObj, FuncName, Params[0], Params[1], 
    	Params[2], Params[3], Params[4]);
else if (sizeof(Params) == 6)
    RetVal = call_other(PlayerObj, FuncName, Params[0], Params[1], 
    	Params[2], Params[3], Params[4], Params[5]);
return RetVal;
}


nosave LoadPlayer(PlayerName)
{
restore_object("/players/" + PlayerName + ".o");
Available = 1;
OnlinePlayer = 0;
call_out("MakeUnavailable", 1);
}


nosave MakeUnavailable()
{
if (!OnlinePlayer)
    save_object("/players/" + name + ".o");
Available = 0;
}

