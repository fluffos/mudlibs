/*
 * Material effects - relates materials to damage.
 *
 * Use this to register various types of attack, defence, etc,
 * so as to get a unique number by which to identify events of
 * that nature.  Standard objects, weapons, living, etc query this
 * object when determining damage from unusual attacks, and propogation
 * of damage into pack items.
 */

#include "materials.h"
#include "damage.h"

array matdam;
array dammsgs;

reset() {
    if (!matdam) {
	matdam = [
	    MAT_WOOD, [ DAM_PHYSICAL,	100,
			 DAM_EDGED,	50,
			 DAM_POINT,	80,
			 DAM_FIRE,	80 ],
	    MAT_IRON, [
			 DAM_ACID,	40,
			 DAM_RUST,	30,
			 DAM_PHYSICAL,	10
			 ],
	    MAT_STEEL, [DAM_PHYSICAL,	20,
			 DAM_ACID,	20,
			 DAM_RUST,	30 ],
	    MAT_TEMPERED, [
			 DAM_PHYSICAL,  25,
			 DAM_ACID,	15,
			 DAM_RUST,	30 ],
	    MAT_LEATHER, [
			 DAM_EDGED,	35,
			 DAM_POINT,	40 ],
	    MAT_GLASS, [
			 DAM_PHYSICAL,	300,
			 DAM_COLD,	100,
			 DAM_SHOCK,	100 ],
	    MAT_STONE, [
			 DAM_SHOCK,	20,
			 DAM_PHYSICAL,	10 ],
	    MAT_PAPER, [ DAM_FIRE,	300,
			 DAM_EDGED,	200,
			 DAM_POINT,	80,
			 DAM_WATER,	50 ],
	    MAT_CLOTH, [ DAM_FIRE,     250,
			 DAM_EDGED, 	50,
			 DAM_POINT, 	70 ],
	    MAT_BRONZE, [ 
			DAM_PHYSICAL,	50,
			DAM_ACID,	20,
			DAM_RUST,	20 ],
	    MAT_FLESH, [
			DAM_PHYSICAL,	100,
			DAM_ACID,	200,
			DAM_EDGED,	120,
			DAM_POINT,	140,
			DAM_FIRE,	180,
			DAM_COLD,	40,
			DAM_SHOCK,	30,
			DAM_MISSILE,	120
		]
	   ];
	}
    if (!dammsgs) {
	dammsgs = [ DAM_PHYSICAL, "is damaged somewhat", "broken",
		     DAM_EDGED,    "is sliced", "shredded",
		     DAM_POINT,	   "is pierced", "broken",
		     DAM_FIRE,	   "burns",	 "burnt",
		     DAM_COLD,	   "is covered in frost", "shattered",
		     DAM_SHOCK,	   "vibrates", "shattered",
		     DAM_MISSILE,  "is damaged somewhat", "broken",
		     DAM_ACID,	   "is corroded", "corroded",
		     DAM_RUST,     "rusts",	  "rusted",
		     DAM_WATER,	   "is waterlogged", "useless" ];
	}

}

/*
 * get_damage(material, damtype, amt) - returns an array:
 *	"whathappened", newamt, "break string"
 */

get_damage(mat, ty, amt) {
    int x;
    int y;
    int z;
    if ((x = index(matdam, mat)) < 0)
	return 0;
    if ((y = index(matdam[x+1], ty)) < 0)
	return 0;
    if (y % 2)		/* ugly 'n horrible hack */
	return 0;
    if ((z = index(dammsgs, ty)) < 0)
	return 0;
    amt = amt * matdam[x+1][y+1] / 100;
    if (amt > 1)
	amt = random(amt);
    return [ dammsgs[z+1], amt, dammsgs[z+2] ];
}
