inherit "std/http/sws";

/* This file is a "how to" create dynamic html pages from
 * any object or file in the game. The instructions on
 * how to do this can be found at:
 * 
 * http://www.shattered.org/dynamic/how_to.htm
 *
 * Greebo - 010125
 *
 */

http_generate()
{
	string ret, sws;
	ret = H1("How to create dynamic html pages.");
	ret += TEXT("The easiest way to create html pages on Shattered World " +
		"is to use what has been called \"Shattered Web Script\", or " +
		"\"SWS\" for short. Using SWS enables the wizard to focus " +
		"primarily on the creation of objects and \"what\" to output " +
		"to a .html file, without worrying about \"how\" it is done. " +
		"The wizard can forget about the construction of html tags, " +
		"and concentrate on the final delivery of their product.");
	ret += TEXT("The simplest way to explain how to create a .html page " +
		"is by example. As such, we will start from the " +
		BOLD("beginning") + ".");
	ret += TEXT("To start with, we need to determine which file or " +
		"object is most suitable to be called on for creating the " +
		"content that we wish to publish to html. This can most " +
		"easily be answered by figuring out which object contains " +
		"most of the information that we wish to publish. For " +
		"example, should we want to create a web page that contains " +
		"information regarding which players are currently logged on " +
		"(similar to the \"who\" command), the object that be most " +
		"suitable would be \"S/users.lpc\", as this is the object " +
		"that is used in-game when someone types the \"who\" " +
		"command. Other examples would be using \"guilds/quest.lpc\"" +
		"for a quests page, or using \"guilds/guild.lpc\" for a " +
		"page containing information about the guilds of Shattered " +
		"World.");
	ret += TEXT("The next thing we have to do is to get in there and " +
		"do what all wizards do best, " + BOLD("code") + ". Luckily, " +
		"due to the creation of SWS, this is all relatively simple.");
	ret += TEXT("Initially, you will need to inherit the SWS code into " +
		"your object. Do this by using the following towards the " +
		"top of your file:");
	ret += TEXT(ITALIC("\"inherit \"std/http/sws.lpc\";"));
	ret += TEXT("This allows you to use the functions contained within " +
		"Shattered Web Script, of which a full list of it's syntax " +
		"can be found " + LINK("dynamic/sws.htm", "here") + ", " +
		"along with examples of each.");
	ret += TEXT("Next, you will need to create the following function:");
	ret += TEXT(ITALIC("http_generate()"));
	ret += TEXT("This function takes no parameters, but returns an array " +
		"of arrays, each of which contain four members with the " +
		"following structure:");
	ret += TEXT(ITALIC("[ string target, string title, string body, int " +
		"no_date ]"));
	ret += TEXT("The parameters can be defined as:");

	array table = [ BOLD("Parameter"), BOLD("Description"), BOLD("Example"), 
			"string target", "file name of the web page",
			"how_to.htm", "string title", "caption to be " +
			"displayed in the title bar of the window" ,
			"How to Create Dynamic HTML pages", "string body",
			"html body of your page", "<p>This is a web page</p>",
			"int no_date", "inhibits the attachment of a date " +
			"stamp at the bottom of the page if not zero", "1" ];

	ret += TABLE(table, 3, 1, 90, "CENTER", [20, 40, 40]);
	ret += TEXT("Going through the parameters in more detail we have:");
	ret += H3("string target");
	ret += TEXT("The \"target\" is the name of the file to be written " +
		"to disk. It will be written to " +
		BOLD("/doc/html/dynamic") + " which translates to a web " +
		"address of " +
		BOLD("http://www.shattered.org/dynamic/target.htm") + ". " +
		"Care has to be taken that the web page is not already being " +
		"written by another object, and that the file name is unique, "+
		"as no checking is done in this regard.");
	ret += TEXT("The page can also include a sub-directory, such as " +
		BOLD("sub/target.htm") + " but the directory must already " +
		"exist and have it's permissions correctly set. Please " +
		"talk to Greebo or Dredd if you want a sub-directory set up");
	ret += H3("string title");
	ret += TEXT("The \"title\" is the caption that you want to appear " +
		"in the title bar of the browser of the user. Keep it short " +
		"and simple, and include the words \"Shattered World\" " +
		"if appropriate.");
	ret += H3("string body");
	ret += TEXT("The \"body\" of the html page is effectively everything " +
		"between the <body> and </body> tags of your html file. " +
		"In layman's terms, the guts of the page. Luckily, you " +
		"have no need to go into html tags, as you can use " +
		LINK("dynamic/sws.htm", "SWS") + " to simplify the " +
		"creation of your content.");
	ret += TEXT("Obviously, the body of the page can be quite large in " +
		"some cases.");
	ret += H3("int no_date");
	ret += TEXT("In order to supress the date created information that " +
		"is appended by default at the bottom of your html page, set " +
		"the \"no_date\" parameter of your array to something other " +
		"than zero. 1 is ideal.");
	ret += TEXT("Only use this when absolutely neccessary, as having a " +
		"recent date printed at the bottom of the page indicates to " +
		"those browsing it that it is dynamic, and this in itself is " +
		"a good thing.");
	ret += H2("Return the parameters");
	ret += TEXT("Now you have all your parameters set, simply return " +
		"them in your http_generate function as follows:");
	ret += TEXT(ITALIC("return [ [\"target.htm\", \"Target title\", " +
		"\"Body of target\", 0] ]"));
	ret += TEXT("Please note that returning multiple arrays causes " +
		"multiple html pages to be written. This can be useful " +
		"for things such as the newspaper, boards, etc. To do this, " +
		"you would do something like the following:");
	ret += TEXT(ITALIC("return [ [\"target.htm\", \"Target title\", " +
		"body, 0] ," + BREAK() + "[\"target2.htm\", \"Target2 title\"" +
		", body2, 0] ]"));
	ret += TEXT("Lastly, you need to tell the HTTP_SERVER that you have " +
		"a page (or set of pages), ready for publishing. You " +
		"should test your output first however, by simply call'ing " +
		"the http_generate function from your command prompt. If " +
		"you get back the array of arrays you expected, then go to " +
		"the " + BOLD("Http configuration room") + " which is " +
		"located above the wiz discussion room. Everything you need " +
		"should be there, as well as information on how to do it.");
	ret += TEXT("Have fun!" + BREAK() + "Greebo.");

	sws = H1("Shattered Web Script Explained");
	sws += TEXT("Welcome to the world of Shattered Web Script, or SWS " +
		"for short. Created exclusively for use with the Shattered " +
		"World Mudlib, SWS enables the quick and easy translation " +
		"of standard files and objects into html code for the " +
		"discerning wizard.");
	sws += TEXT("This page details the syntax for all SWS functions, as " +
		"well as providing examples for each. Please note that all " +
		"functions return strings which contain formatted HTML.");
	sws += H2("TEXT(string str)");
	sws += TEXT("The " + BOLD("TEXT") + " function is the basis of most " +
		"HTML pages. It simply returns the given string with the " +
		"html tags neccessary to write a normal piece of text to " +
		"a page.");
	sws += TEXT("For example, TEXT(\"Hello World.\") would output the " +
		"following:");
	sws += TEXT("Hello World.");
	sws += TEXT("Please note that a line break and a blank line is " +
		"inserted after each normal line of text.");
	sws += BLANK();
	sws += H2("BOLD(string str)");
	sws += TEXT("The " + BOLD("BOLD") + " function makes the given " +
		"string be written in bold. This should be used within the " +
		"TEXT function.");
	sws += TEXT("For example, TEXT(\"Hello \" + BOLD(\"World.\")) would " +
		"output the following:");
	sws += TEXT("Hello " + BOLD("World."));
	sws += BLANK();
	sws += H2("ITALIC(string str)");
	sws += TEXT("The " + BOLD("ITALIC") + " function makes the given " +
		"string be written in italics. This should be used within " +
		"the TEXT function.");
	sws += TEXT("For example, TEXT(\"Hello \" + ITALIC(\"World.\")) would " +
		"output the following:");
	sws += TEXT("Hello " + ITALIC("World."));
	sws += BLANK();
	sws += H2("UNDERLINE(string str)");
	sws += TEXT("The " + BOLD("UNDERLINE") + " function makes the given " +
		"string be underlined. This should be used within the " +
		"TEXT function.");
	sws += TEXT("For example, TEXT(\"Hello \" + UNDERLINE(\"World.\")) " +
		"would output the following:");
	sws += TEXT("Hello " + UNDERLINE("World."));
	sws += BLANK();
	sws += H2("H1(string str)");
	sws += TEXT("The " + BOLD("H1") + " function returns the given " +
		"string with the html tags needed to write the biggest " +
		"heading. A line break and a blank line is inserted " +
		"afterwards.");
	sws += TEXT("For example, H1(\"Hello World.\") would output the " +
		"following:");
	sws += H1("Hello World.");
	sws += BLANK();
	sws += H2("H2(string str)");
	sws += TEXT("The " + BOLD("H2") + " function returns the given " +
		"string with the html tags needed to write the 2nd biggest " +
		"heading. A line break and a blank line is inserted " +
		"afterwards.");
	sws += TEXT("For example, H2(\"Hello World.\") would output the " +
		"following:");
	sws += H2("Hello World.");
	sws += BLANK();
	sws += H2("H3(string str)");
	sws += TEXT("The " + BOLD("H3") + " function returns the given " +
		"string with the html tags needed to write the 3rd biggest " +
		"heading. A line break and a blank line is inserted " +
		"afterwards.");
	sws += TEXT("For example, H3(\"Hello World.\") would output the " +
		"following:");
	sws += H3("Hello World.");
	sws += BLANK();
	sws += H2("H4(string str)");
	sws += TEXT("The " + BOLD("H4") + " function returns the given " +
		"string with the html tags needed to write the 3rd smallest " +
		"heading. A line break and a blank line is inserted " +
		"afterwards.");
	sws += TEXT("For example, H4(\"Hello World.\") would output the " +
		"following:");
	sws += H4("Hello World.");
	sws += BLANK();
	sws += H2("H5(string str)");
	sws += TEXT("The " + BOLD("H5") + " function returns the given " +
		"string with the html tags needed to write the 2nd smallest " +
		"heading. A line break and a blank line is inserted " +
		"afterwards.");
	sws += TEXT("For example, H5(\"Hello World.\") would output the " +
		"following:");
	sws += H5("Hello World.");
	sws += BLANK();
	sws += H2("H6(string str)");
	sws += TEXT("The " + BOLD("H6") + " function returns the given " +
		"string with the html tags needed to write the smallest " +
		"heading. A line break and a blank line is inserted " +
		"afterwards.");
	sws += TEXT("For example, H6(\"Hello World.\") would output the " +
		"following:");
	sws += H6("Hello World.");
	sws += BLANK();
	sws += H2("LINE()");
	sws += TEXT("The " + BOLD("LINE") + " function makes a horizontal " +
		"line be written.");
	sws += TEXT("For example, LINE() would output the following:");
	sws += LINE();
	sws += BLANK();
	sws += H2("BREAK()");
	sws += TEXT("The " + BOLD("BREAK") + " function forces a carriage " +
		"return within a line of text.");
	sws += TEXT("For example, TEXT(\"Hello \" + BREAK() + \"World\") "+
		"would output the following:");
	sws += TEXT("Hello " + BREAK() + "World");
	sws += BLANK();
	sws += H2("BLANK()");
	sws += TEXT("The " + BOLD("BLANK") + " function forces a blank line " +
		"to be written.");
	sws += TEXT("For example, BLANK() would output the following:");
	sws += BLANK();
	sws += TEXT("(Believe me, there's a blank line above ;-)");
	sws += BLANK();
	sws += H2("COLOUR(string str, string colour)");
	sws += TEXT("The " + BOLD("COLOUR") + " function (yes, it is spelt " +
		"correctly) makes the given string be written in the " +
		"colour of choice.");
	sws += TEXT("For example, TEXT(\"Hello \" + " +
		"COLOUR(\"World.\", \"red\")) would return the following:");
	sws += TEXT("Hello " + COLOUR("World.", "red"));
	sws += TEXT("The following colours are available:");

	table = ["black", "grey", "silver", "white", "maroon", "red",
		 "purple", "magenta", "green", "lime", "olive", "yellow",
		 "navy", "blue", "teal", "cyan", "orange"];
	sws += TABLE(table, 6);
	sws += BLANK();
	sws += H2("LINK(string link, string text)");
	sws += TEXT("The " + BOLD("LINK") + " function allows you to add a " +
		"hyperlink to another web page. The link would be situated " +
		"on the string given. This should be used with the TEXT" +
		"function.");
	sws += TEXT("For example, TEXT(\"Hello \" + " +
		"LINK(\"dynamic/sws.htm\", \"World.\")) would return the " +
		"following:");
	sws += TEXT("Hello " + LINK("dynamic/sws.htm", "World."));
	sws += TEXT("Please note that all links are relative to the root web.");
	sws += BLANK();
	sws += H2("IMAGE(string filename, string " +
		"description, string alignment, int border)");
	sws += TEXT("The " + BOLD("IMAGE") + " function allows you to " +
		"add an image your web page. This should be used with the " +
		"TEXT function.");
	sws += TEXT("Only the \"filename\" parameter is strictly " +
		"neccessary.");
	sws += TEXT("For example, TEXT(IMAGE(\"sw2.gif\", " +
		"\"Short description of image or link\"" +
		", \"LEFT\", 1)) would return the following:");
	sws += TEXT(IMAGE("sw2.gif", "Short description of image or link",
		"LEFT", 1));
	sws += BLANK();
	sws += TEXT("Please note that all image filenames are relative to " +
		"/images.");
	sws += BLANK();
	sws += H2("IMAGE_LINK(string link, string filename, string " +
		"description, string alignment, int border)");
	sws += TEXT("The " + BOLD("IMAGE_LINK") + " function allows you to " +
		"add a hyperlink to an image which will direct you to " +
		"another web page. This should be used with the TEXT " +
		"function.");
	sws += TEXT("Only the \"link\" and \"filename\" parameters are " +
		"strictly neccessary.");
	sws += TEXT("For example, TEXT(IMAGE_LINK(\"dynamic/sws.htm\", " +
		"\"sw2.gif\", \"Short description of image or link\"" +
		", \"LEFT\", 1)) would return the following:");
	sws += TEXT(IMAGE_LINK("dynamic/sws.htm", "sw2.gif",
		"Short description of image or link", "LEFT", 1));
	sws += BLANK();
	sws += TEXT("Please note that all links are relative to the root " +
		"web, while all image filenames are relative to /images.");
	sws += BLANK();
	sws += H2("BOOKMARK(string label)");
	sws += TEXT("The " + BOLD("BOOKMARK") + " function adds a bookmark " +
		"with the given label. This should be used with the TEXT " +
		"function.");
	sws += TEXT("For example, TEXT(\"This is a bookmark.\"" +
		"BOOKMARK(\"bookmark\")) would output the following:");
	sws += TEXT("This is a bookmark." + BOOKMARK("bookmark"));
	sws += TEXT("(You'll have to believe me here.)");
	sws += BLANK();
	sws += H2("GOTO_BOOKMARK(string label, string text)");
	sws += TEXT("The " + BOLD("GOTO_BOOKMARK") + " function adds a " +
		"link to the bookmark indicated. This should be used with " +
		"the TEXT function.");
	sws += TEXT("For example, TEXT(\"Go to this \" + " +
		"GOTO_BOOKMARK(\"bookmark\", \"bookmark.\")) would output " +
		"the following:");
	sws += TEXT("Go to this " + GOTO_BOOKMARK("bookmark", "bookmark."));
	sws += BLANK();
	sws += H2("BULLET_LIST(array arr)");
	sws += TEXT("The " + BOLD("BULLET_LIST") + " function adds a bullet " +
		"list with the given array comprising the list.");
	sws += TEXT("For example, BULLET_LIST([\"Hello\", \"World\"]) " +
		"would output the following:");
	sws += BULLET_LIST(["Hello", "World"]);
	sws += BLANK();
	sws += H2("NUMBER_LIST(array arr)");
	sws += TEXT("The " + BOLD("NUMBER_LIST") + " function adds a " +
		"numbered list with the given array comprising the list.");
	sws += TEXT("For example, NUMBER_LIST([\"Hello\", \"World\"]) " +
		"would output the following:");
	sws += NUMBER_LIST(["Hello", "World"]);
	sws += BLANK();
	sws += H2("INDENT(string str)");
	sws += TEXT("The " + BOLD("INDENT") + " function indents the given " +
		"string. It is most commonly used with the TEXT function");
	sws += TEXT("For example, INDENT(TEXT(\"Hello World.\")) " +
		"would return the following:");
	sws += INDENT(TEXT("Hello World."));
	sws += BLANK();
	sws += H2("TABLE(array arr, int columns, int border, int width, " +
		"string alignment, array col_widths)");
	sws += TEXT("The " + BOLD("TABLE") + " function adds a table with " +
		"the given array as it's elements, and formatted with the " +
		"parameters given.");
	sws += TEXT("Only the \"array\" parameter is strictly neccessary.");
	sws += TEXT("For example, TABLE([\"Hello\", \"World\", " +
		"\"Goodbye\", \"World\"], 2, 1, 90, \"CENTER\", " +
		"[40, 60]) would return the following:");
	sws += TABLE(["Hello", "World", "Goodbye", "World"], 2, 1, 90,
		"CENTER", [40, 60]);
	sws += BLANK();


	return ([["how_to.htm", "How to create a dynamic html page", ret, 0 ],
		 ["sws.htm", "Shattered Web Script explained", sws, 0 ]]);
}

