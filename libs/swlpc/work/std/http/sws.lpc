#include "html.h"

/*
 * Greebo - 001214
 *
 * Does a whole heap of HTML type stuff.
 *
 */

nosave array colours =
[
	"black", "000000",
	"grey", "999999",
	"silver", "CCCCCC",
	"white", "FFFFFF",
	"maroon", "660000",
	"red", "FF0000",
	"purple", "990099",
	"magenta", "FF00FF",
	"green", "009900",
	"lime", "00FF00",
	"olive", "999900",
	"yellow", "FFFF00",
	"navy", "000099",
	"blue", "0000FF",
	"teal", "009999",
	"cyan", "00FFFF",
	"orange", "FF9900"
];


int get_colour(str)
{
	int i;

	if (!str) return 0;
	i = index(colours, str);
	if (i < 0 || i%2 == 1) return 0;
	return colours[i+1];
}


TEXT(string str, alignment)
{
	if (!stringp(alignment))
		return (TEXT_ON+str+TEXT_OFF);
	else
		return ("<p align=\"" + alignment + "\">" +str+TEXT_OFF);
}


BOLD(string str)
{
	return (BOLD_ON+str+BOLD_OFF);
}


ITALIC(string str)
{
	return (ITALIC_ON+str+ITALIC_OFF);
}


UNDERLINE(string str)
{
	return (UNDERLINE_ON+str+UNDERLINE_OFF);
}

H1(string str)
{
	return (H1_ON+str+H1_OFF);
}

H2(string str)
{
	return (H2_ON+str+H2_OFF);
}

H3(string str)
{
	return (H3_ON+str+H3_OFF);
}

H4(string str)
{
	return (H4_ON+str+H4_OFF);
}

H5(string str)
{
	return (H5_ON+str+H5_OFF);
}

H6(string str)
{
	return (H6_ON+str+H6_OFF);
}


LINE()
{
	return (HLINE);
}


BREAK()
{
	return (LINE_BREAK);
}


BLANK()
{
	return (BLANK_LINE);
}


COLOUR(string str, string colour)
{
	return "<font color=\"#" + get_colour(colour) + "\">" + str + "</font>";
}


/* all links relative to root */
LINK(string link, string text)
{
	return "<a href=\"/" + link + "\">" + text + "</a>";
}


IMAGE(string filename, string description, string alignment, int border)
{
	if (!stringp(description))
		description = "A very lazy wizard";
	if (!stringp(alignment))
		alignment = "left";
	return "<img border=\"" + border + "\" src=\"/images/" + filename +
		 "\" align=\"" + alignment + "\" alt=\"" + description + "\">";
}


IMAGE_LINK(string link, string filename, string description, string alignment, int border)
{
	if (!stringp(description))
		description = "A very lazy wizard";
	if (!stringp(alignment))
		alignment = "left";
	return "<a href=\"/" + link + "\">" +
		"<img border=\"" + border + "\" src=\"/images/" + filename +
		"\" align=\"" + alignment + "\" alt=\"" + description + "\">" +
		"</a>";
}


BOOKMARK(string label)
{
	return "<a name=\"" + label + "\"></a>";
}


GOTO_BOOKMARK(string label, string text)
{
	return "<a href=\"#" + label + "\">" + text + "</a>";
}


BULLET_LIST(array arr)
{
	if (!sizeof(arr))
		return "";
	string ret = "<ul>\n";
	int i = 0;
	while (i < sizeof(arr))
	{
		ret += "<li>" + arr[i] + "</li>\n";
		i++;
	}
	ret += "</ul>\n";
	return ret;
}


NUMBER_LIST(array arr)
{
	if (!sizeof(arr))
		return "";
	string ret = "<ol>\n";
	int i = 0;
	while (i < sizeof(arr))
	{
		ret += "<li>" + arr[i] + "</li>\n";
		i++;
	}
	ret += "</ol>\n";
	return ret;
}


INDENT(string str)
{
	return (BLOCKQUOTE_ON+str+BLOCKQUOTE_OFF);
}


TABLE(array arr, int columns, int border, int width, string alignment, array col_widths)
{
	int arr_size = sizeof(arr);
	if (!arr_size)
		return "";

	string ret;
	int i = 0;
	int standard_widths;

	if (!columns)
		columns = 1;
	if (!border)
		border = 0;
	if (!width)
		width = 80;
	if (!stringp(alignment))
		alignment = "CENTER";
	if (!arrayp(col_widths))
		standard_widths = 0;
	else
		standard_widths = sizeof(col_widths);
	ret = "<TABLE BORDER=" + border + " WIDTH=\"" + width +
		"%\" ALIGN=\"" + alignment + "\">\n";
	ret += "<TR>\n";
	while (i < arr_size)
	{
		if (!standard_widths)
			ret += "<TD>" + arr[i] + "</TD>\n";
		else
			ret += "<TD WIDTH=\"" + col_widths[(i % standard_widths)] + "%\">" + arr[i] + "</TD>\n";
		i++;
		if ((!(i % columns)) && (i != arr_size))
			ret += "</TR>\n<TR>\n";
	}
	ret += "</TR>\n";
	ret += "</TABLE>\n";
	return ret;
}

