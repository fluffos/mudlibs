	(please retain these comments).

	Ok - I know it's awful.
	But I'm moving it into a skill server now.
	So we can fix it :-)

	I hate the idea that stuff needing to be saved with a player is
	in a seperate server (actually, I'm sick of the bugs 'n hacks).
	So I'm changing it again - everything relating to actual stat/skill
	addition & timeouts is in living.c, and everything related to externally
	provided (server based) tmp skills, stats, etc should be here, so that
	they don't get permanently added in in cases of crashes, etc.
*/

#define SKILLS "std/skill_list"

array Skills; /* array of [ skills, ({ learning stuff ] }) */

reset(arg)
{
	if (!arg) {
		restore_object(SKILLS);
		if (!Skills) Skills = [ ];
	}
}	

#define COMPETENT 30

query_resisted(pob, str, ob, str2) 
{
	int a,b, t1, t2,sa,sb;
	if (!str || !str2 || str == "" || str2 == "") return 0;
	if (intp(str2))  { 
		b = str2; 
		sb = 1; 
	}
	if (!sb && !ob) return 0;
	a = pob->query_stat(str) * 4;
	if (!b) b = ob->query_stat(str2) * 4;
	sa = a; 
	sb = b;
	if (!a) a = pob->query_skill(pob, str); /* query_skill doesn't learn */
	if (!b) b = ob->query_skill(ob, str2);
	if (a < 5) a = 5;
	if (b < 5) b = 5;

	if (random(COMPETENT) < a || sa) {
		if (random(COMPETENT) < b || sb) {
			if (random(a) > random(b)) { /* success!! */
				if ((random(100) < a/15+5) && !sa)
				    pob->learn(str);
				return a;
			}
			if ((random(100) < b/15+5) && !sb)
				ob->learn(str2);
			return 0;
		}
		else { /* automatic success - ie. defence failed */
			if ((random(100) < a/20+5) && !sa)
				pob->learn(str);
			return a;
		}
	}
	else return 0; /* failed! - no resistance attempted */
}


#if 0

/*
   generic routines for adding a skills to a living thing. 
   skills range approximately between 0-100 

   Ok - we can make this take 3 optional params -
   time and call_back & call_back parameter (ick!).
   (with a view to nuking temp_modify)

   [ should do the same for add_stat! ]

   * pob - object to add skill to.
   * arg - name of skill.
   * val - amount to be added.
   * time - length of time this shall last.
   * callb - function to be called on time expiration.
   * callbparam - call back parameter!
*/

add_skill(pob, (string) arg,(int) val,(int) time, callb, callbparam)
{
int oval;
array tmp, skills, skill_values;
	/*
		should check to see if arg is in the
		acceptable skill list.
	*/
	if (!arg) return;
	if (!objectp(pob)) return; /* Looks like that object aint here anymore */
	tmp = pob->query_skills();
	skills = tmp[0];
	skill_values = tmp[1];
	if (!skills) {
		skills = [ ];
		skill_values = [ ];
	} 
	oval = index(skills, arg);
	if (oval < 0) {
		skills = skills + [ arg ];
		skill_values = skill_values + [ val ];
	}
	else {
		if (intp(val) && intp(skill_values[oval]))
			skill_values[oval] = skill_values[oval] + val;
		else skill_values[oval] = val;
	}
	pob->set_skills( [skills, skill_values] );
	if (time) {
		/* ok - set recovery array for crashes & quits etc */
		add_tmp_skill( pob, arg, val);
		call_out("expire_skill", time, [ pob, arg, val, callb, callbparam ]);
	}
	return 1;
}

expire_skill(stuff)
{
int val;
string skill, callb;
array callbparam;
	skill = stuff[1];
	val = stuff[2];
	callb = stuff[3];
	callbparam = stuff[4];

	add_skill(stuff[0], skill, -val);
	add_tmp_skill(stuff[0], skill, -val);
	/* do the callback */
	if (callb) {
		val = index(callb, ".");
		if (val > -1) return call_other(callb[..val-1], callb[val+1..], callbparam);
		else {
			tell_object(stuff[0], callb+".\n");
			return;
		}
	}
}

/* removes a skill a player has. */
remove_skill(pob,str)
{
array tmp, a,b, skills, skill_values;
int tmpi;

	if (!str) return;
	tmp = pob->query_skills();
	skills = tmp[0];
	skill_values = tmp[1];

	if (!skills) return 0;
	tmpi = index(skills, str);
	if (tmpi < 0) return 0;
	a = skills[..tmpi-1];
	b = skills[tmpi+1..];
	skills = a + b;
	a = skill_values[..tmpi-1];
	b = skill_values[tmpi+1..];
	skill_values = a + b;

	pob->set_skills( [skills, skill_values] );
	return 1;
}

/*
   query_skill returns true for success (the value of the skill)
   and 0 for a fail. Does automatic learning.
   if flag is 1 return the value and don't do an automatic success check
   or any learning.
   if flag is 2 don't do any learning.
 
   * blah !
   Should there always be a chance of succeeding? Yes.
*/

query_skill_value(pob, str)
{
int x;
array tmp, skills, skill_values;
	if (str == 0 || str == "") return -1;
	tmp = pob->query_skills();
	if (!tmp) return -1;
	skills = tmp[0];
	skill_values = tmp[1];
	if (skills && ((x = index(skills, str)) >= 0))
		return skill_values[x];
	return -1; /* non-existent */
}

query_skill(pob, str, flag) 
{ 
    int ski, tmps, skil;
    string a,b;
    array skills, skill_values;
    array args;

	if (str == 0 || str == "") return 0;
	skil = query_skill_value(pob, str);

	/* a little nasty */
	if (stringp(skil)) 
    {
		if (pob->query_ghost()) return 1;  /* ghosts always succeed */
        args = STRINGS->split_first(tmps, ":");
        if (sizeof(args) == 2)
        {
			catch tmps = args[0]->(args[1])(this_object(), skil);;
		    return tmps;
        }
	}

	if (flag == 1) return skil;
	if (pob->query_ghost()) return 1;  /* ghosts always succeed */
	if (skil < 4) skil = 4; /* give them at least 4% chance of success */

	ski = random(100);
	if (ski > 96) ski = skil + 1; /* always fail sometimes */
	if (ski < skil) {
		if ((ski < (skil/20+4)) && (flag != 2)) learn(pob, str);
		return skil;
	}

	return 0;
}

/*
   Did the player learn anything? Increase the skill if they did!
   Two params: skill, percentage chance of learning
   Returns 1 if player learned something.
   temp_modify stops learning too often!

   Note : learning chance & amount should depend on the strength
   of the target. *sigh* - I'll fix it one day.
   And the type of skill being learnt!. 
*/

learn(pob, str)
{
int i;
array tmp, skills, skill_values;
	tmp = pob->query_skills();
	skills = tmp[0];
	skill_values = tmp[1];
	if (query_tmp_skill(pob, "*L"+str) != -1) return 0;
	if ((random(100) < (100+pob->query_int()-query_skill_value(pob, str)))
	    && (random(500/pob->query_int()) < 20)) 
	{ 
/* 1/2 chance at int=25 */
		i = index(skills, str);
		if (i < 0) add_skill(pob, str, random(4) + 1);
		else if (intp(skill_values[i]))
			add_skill(pob, str, random(4) + 1);
		add_tmp_skill(pob, "*L"+str, 0);
		call_out("finished_learning", query_skill_value(pob, str) * 18, [ pob, "*L"+str ] );
		return 1;
	}
	return 0;
}

finished_learning(pob)
{
	remove_tmp_skill(pob[0], pob[1]);
}


/*
   query_resisted takes a skill or stat, an opposing object and their
   skill/stat  as parameters. It does a "resistance" check and an automatic
   learning check for the one who suceeds.
   ie. query_resisted("pow", find_player("fred"), "swim");
   combats this objects power against fred's swim skill.

   I'm not sure whether this uses an "ideal" comparison
   or learning chances are ok. 
   returns the aggressors skill on success. else returns 0

   * it sucks a fair bit - so fix it!

*/

#define COMPETENT 30
query_resisted(pob, str, ob, str2)
{
int a,b, t1, t2,sa,sb;
	if (!str || !str2 || str == "" || str2 == "") return 0;
	if (intp(str2))  { b = str2; sb = 1; }
	if (!sb && !ob) return 0;
	a = pob->query_stat(str) * 4;
	if (!b) b = ob->query_stat(str2) * 4;
	sa = a; sb = b;
	if (!a) a = query_skill_value(pob, str); 	
	if (!b) b = query_skill_value(ob, str2);
	if (a < 5) a = 5;	if (b < 5) b = 5;
	
	if (random(COMPETENT) < a || sa) { /* successful attempt! - stats are automatic! */
		if (random(COMPETENT) < b || sb) {
			if (random(a) > random(b)) { /* success!! */
				if ((random(100) < a/15+5) && !sa) learn(pob,str);
				return a;
			}
			if ((random(100) < b/15+5) && !sb) learn(ob,str2);
			return 0;
		}
		else { /* automatic success - ie. defence failed */
			if ((random(100) < a/20+5) && !sa) learn(pob,str);
			return a;
		}
	}
	else return 0; /* failed! - no resistance attempted */

}


add_tmp_skill(pob, arg, val)
{
int x;
array tmp_skills;
	if (!pob) return;
	tmp_skills = pob->query_tmp_skills();
	if (!tmp_skills) tmp_skills = [ arg, val ];
	x = index(tmp_skills, arg);
	if (x == -1)  tmp_skills += [ arg, val ];
	else tmp_skills[x+1] += val;
	pob->set_tmp_skills(tmp_skills);
	/* What if it == 0; should we remove? (yes, but not until learning is fixed */
}

remove_tmp_skill(pob, arg)
{
int x;
array a, b;
array tmp_skills;
	if (!pob) return;
	tmp_skills = pob->query_tmp_skills();
	if (!tmp_skills) tmp_skills = [ ];
	else {
		x = index(tmp_skills, arg);	
		if (x == -1) return;
		a = tmp_skills[..x-1];
		b = tmp_skills[x+2..];
		tmp_skills = a+b;
	}
	pob->set_tmp_skills(tmp_skills);
}

/*
	returns -1 for nonexistent.
*/
query_tmp_skill(pob, arg)
{
int x;
array tmp_skills;
	tmp_skills = pob->query_tmp_skills();
	if (!tmp_skills || !pointerp(tmp_skills)) return -1;
	x = index(tmp_skills, arg);
	if (x > -1) return tmp_skills[x+1];
	else return -1;
}

#endif
