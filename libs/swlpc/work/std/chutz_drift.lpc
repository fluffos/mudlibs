/* CHUTZ_DRIFT: Used by /RO/stats to keep track of the drift factor used
 * to manipulate player chutzpah. This ensures that on average, player
 * chutzpah levels remain the same, with "less than average" characters
 * losing chutz and "greater than average" chars gaining chutz.
 *
 * Jenna 950828
 */ 

int drift_factor;

reset(arg) {
	if (!restore_object(file_name(this_object())))
		drift_factor = 200;
	}

show_stats() {
	write(" Drift Factor: " + drift_factor +
		"\n\nThe Drift Factor started off at 200. A lower number "+
		"means that it is easier now for players to gain chutzpah. "+
		"A higher factor measn that it is harder to gain chutzpah. "+
		"The factor is averaged across all players, so that there "+
		"is no net gain or loss of chutzpah.\n");
	}

query_drift_factor() { return drift_factor; }

add_drift_factor(n) {
	drift_factor += n;
	save_object(file_name(this_object()));
	}

