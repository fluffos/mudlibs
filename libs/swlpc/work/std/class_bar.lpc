array ip;              /* 4 element array of the ip numbers, "*" for all */
int start_time;        /* Start time of the restriction */
int end_time;          /* Finishing time of the restriction */
array days;            /* Days in which it applies */
int mud;               /* Mud to which it applies (see bar.c for more info) */
int maxlogins;         /* Maximum number of people on */
string reason;         /* Reason for barring access */
array exempt;          /* People/groups to which the rule doesnt apply */
