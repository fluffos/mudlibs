/*
	Inflation rate controller.

	Dredd - July 1992.

	o All shops should multiply sale price by the factor 
	return from this controller. Hence is self-adjusting.

*/

#define BANK "room/city/treasury"
#define MARKET "room/city/market5"
#define MARKET2 "room/city/market6"

query_inflation()
{ 
int a, b, i;
	return 1;
	a = BANK->balance();
	b = - (MARKET->query_money());

	i = (b / a) + 1;
	if (i < 0) i = - i;
	if (i < 1) i = 1;
	return i;
}

#define MIN 80	/* the minimum percentage multiplier for costs etc */
query_percent()
{
int a, b, i;
	return 100;

	a = BANK->balance();
	b = - (MARKET->query_money()) * 100;

	i = (b / a) + MIN;
	if (i < 0) i = - i;
	if (i < MIN) i = MIN;
	return i;
}


inflate(val)
{
	val = (val * query_percent()) / 100;
	return val;
}

/* Written by Paladin 950220, used in Kings taxation, and our cut from shops etc */
taxrate() { return inflate(20); } 
