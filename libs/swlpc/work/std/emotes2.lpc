}

/*
	Action gets passed 2 params,
	- object invoking the action
	- the type of action (a string).
	Returns an array of strings
		[ what object should get, what should be "said" ];
	else 0.
*/
action(ob,type)
{
int x;
string xtell, xsay, xset, tmp;
array ret;
	x = index(vsimple, "%"+type);
	if (x < 0) return 0;
	if ((vsimple[x+1][0]) == '@')
		xtell = vsimple[x+1][1..]+"\n";
	else {
		if (vsimple[x+1] != "")	
			xtell = "You "+type+" "+vsimple[x+1]+"\n";
		else xtell = "You "+type+".\n";
	}
	if ((vsimple[x+2][0]) == '@') {
		tmp = vsimple[x+2][1..];
		xsay = ob->query_name() + " " + tmp + "\n";
	}
	else {
		if (vsimple[x+2] != "")	
			xsay = ob->query_name() + " " + PLURAL->plural(type)+" " + vsimple[x+2] + "\n";
		else xsay = ob->query_name() + " " + PLURAL->plural(type) + ".\n";
	}
	xset = "is "+ PLURAL->add_ing(type);
	ret = [ xtell, xsay, xset ];
	return ret;
}

/*
	For format see above comments (in reset)
*/
add_simple(type, string1, string2)
{
	vsimple = vsimple + [ "%"+type, string1, string2 ];
	save_object(RFILE);
	return 1;
}

remove_simple(type)
{
int x;
array a, b;
	x = index(vsimple, "%"+type);
	if (x < 0 ) return 0;
	a = vsimple[..x-1];
	b = vsimple[x+3..]; 
	vsimple = a + b;
	save_object(RFILE);
	return 1;
}

/* sing_verse - grab a file of verses, choose one, and sing it.
 * Initiates a 3 minute timeout to delete the verses array.
 */

nosave int verse_time = 0;

sing_verse_timeout() {
    if (time() - verse_time < 180) {
	if (find_call_out("sing_verse_timeout") < 0)
	    call_out("sing_verse_timeout", 180);
	return;
	}
    Verses = 0;
}

sing_verse(ob, which) {
    string v;
    string you, he;

    verse_time = time();

    if (find_call_out("sing_verse_timeout") < 0)
        call_out("sing_verse_timeout", 180);

    if (!Verses)
	Verses = grab_file(VFILE);
    if (stringp(Verses))
	Verses = explode(Verses, "@verse\n");
    if (!Verses)
	return(action(ob, "sing"));
    if (which < 0)
	which = random(sizeof(Verses));
    v = Verses[which];
    you = "With divine inspiration, you sing:\n" + v;
    he = ob->query_name() + " drunkenly bellows:\n" + v;
    return [ you, he ];
}

query_vsimple() { return vsimple; }
