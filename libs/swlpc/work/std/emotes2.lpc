/*

	Standard emote server.
	Why? Because of LPC's bad handling of various things.
	The Shattered World Lpmud. Ideas came from many.
	by geoff@bruce.cs.monash.oz.au aka Dredd.

 Simple emotes have 3 parts -
 a) type of action (ie. bounce).
 b) string1 - "You <type> " + string1 - except as below.
 c) string2 - "<Name> <type>s " + string2 - except as below.
 d) time that the action takes (standard)
	current action is set to either verb+ing+string2
					(accounting for e's)
	or string2 if it begins with an "@".


 if either string begins with an @ then "You <type>" isn't appended
 in (b) or <type>s isn't included in (c).
	
*/

inherit "RO/Servers";

#define RFILE "std/soul_com"
#define	VFILE "std/Verses"

array vsimple;
nosave array Verses;

debug() { return vsimple; } 
 
reset(arg)
{
	if (arg) return;

	restore_object(RFILE); 

#ifdef CREATE
	vsimple = [
"%applaud", "wholeheartedly.", "@gives a round of applause.",
