/*
 * /std/emoteable.c
 *
 * Provides a generic mechanism for providing emotes to a player object.
 * If your object wants to provide emotes to a player, inherit this
 * object, and register the emote with the register_emote() function.
 * That is all you need to do.
 */
/*
 * 950731 Hunter       	created file
 */

/*
 * provide a dummy reset()
 * which *must* be called in all children objects
 */
reset(arg)
{
    /* do nothing by default, but may do so in future */
}


/*
 * provide a dummy init()
 * which *must* be called in all children objects
 */
init()
{
    /* do nothing by default, but may do so in future */
}


/*
 * register_emote() function.
 */
int
register_emote(
    (string|array) verbs,	/* the command to invoke this emote */
    (int) emotetype,		/* bitmapped array of type of emote */
    (string) msgself,		/* message the actor gets */
    (string) msgothers,		/* message others get */
    (int|string) msgtarget,	/* message a target gets */
    (int|array) adverbs		/* allowed adverbs (future growth) */
    )
{
object emoteSoul;
/* 1. locate emote soul */
    emoteSoul = present( "emote_soul", this_player() );
    if ( !emoteSoul )
    {
	return 0;
    }
/* 2. register this emote */
    return emoteSoul->add_emote_registry( verbs, emotetype, msgself, 
	msgothers, msgtarget, adverbs );
}


