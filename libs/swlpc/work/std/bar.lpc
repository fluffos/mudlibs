inherit "RO/Servers";
#include <security.h>
#include "/RO/lib/parse_types.h"

#define BAR_DIR 	"std/"
#define DENY_FILE	"hosts.deny"
#define SAVE_FILE 	"bar_save"

#define	CHECK_TIME	300

#define CURRENT_TIME	(DATE->hours()+DATE->minutes())

import "std/class_bar" c_bar;

nosave array Days = [ "sun", "mon", "tue", "wed", "thu", "fri", "sat" ];
nosave array AllowRegardless = [ ];
#ifdef UNTRUSTED
array untrusted;
#endif

#define CURRENT_DAY	 (lower_case(DATE->day()))

class c_bar hosts[0];
nosave int logins, denied;

#define ALL 3
#define PLAYER 1
#define WIZ 2

reset()
{
    array files,i,datatime,savetime;

    call_out("check_logins", 60);

    files = ls(BAR_DIR);
    i = index (files[0],DENY_FILE);
    if (i < 0) 
	throw "Could not find data file\n";
    datatime = files[2][i];
    i = index (files[0],SAVE_FILE + ".o");
    if (i == -1 || datatime > files[2][i] 
    	|| !restore_object (BAR_DIR + SAVE_FILE) )
    {
	load_deny_list();
	save_object(BAR_DIR + SAVE_FILE);
    }
    logins = 0; denied = 0;
}

array
show_stats() 
{ /* debug info */
int i;
array ip_adr;
array ret = allocate( sizeof( hosts ) + 3);
int r;
    ret[0] = "ip                  start end   mud  max    days";
    ret[1] = "                    time  time       logins";
    ret[2] = "------------------- ----- ----- ---- ------ ------------------";
    r = 3;
    for (i= sizeof(hosts); i--;) 
    {
        ip_adr = hosts[i].ip;
 	ret[r] =  	
     	    FORMAT->left_justify( ip_adr[0]+"."+ip_adr[1]+"."
		+ip_adr[2]+"."+ip_adr[3], 20) 
	    +FORMAT->right_justify(hosts[i].start_time+"", 5)+" "
	    +FORMAT->right_justify(hosts[i].end_time+"", 5)+" "
	    +["Plyr ", "Wiz  ", "All  "][hosts[i].mud-1]
	    +FORMAT->right_justify(hosts[i].maxlogins+"", 6)+" "
	    +implode(hosts[i].days, " ");
    	r ++;
    } 
    ret += [	"",
		"CURRENT_DAY: \t"+CURRENT_DAY
    		];
    if (sizeof(AllowRegardless) > 0)
        ret += [ "Allowing Regardless:", implode(AllowRegardless, " ") ];
    ret += [ logins + " logins since last reset, " + denied + " logins " +
		"denied." ];
    return ret;
}

/*
 * Hook to retrieve deny time for a given IP/user.
 * Used by player objects to warn users ahead of time that
 * they'll be kicked off - but only if the number of logins
 * from that IP is limited to zero (otherwise, choosing who
 * to kick off would be a little arbitrary).
 *
 * Returns: deny string if currently denied, 0 if never denied,
 * otherwise time (minutes) until they are due to leave.
 */

(int|string) check_ip(string ip, string name, int wiz_level, int new_player) {
    if (!pointerp(hosts))
	return (-1);

    if (  (name == "shutdown")
       || (wiz_level >= SENIOR))
	return (-1);

    int wizmud = WHICH_MUD->is_wiz_mud();
    int num_players = player_population();
    int curr_time = atoi(CURRENT_TIME);
    int chk_time = 10000;	/* about 100 o'clock :) */

    string today = CURRENT_DAY;
    string tomorrow = Days[(index(Days, today) + 1) % sizeof(Days)];

    int i;
    array ips = explode(ip,".");
    for (i=0; i<4; i++) {
	ips[i] = atoi (ips[i]);
        }

    for (i = 0; i < sizeof(hosts); i++) {
	if ((!new_player) && (hosts[i].maxlogins > 0))
	    continue;		/* let them leave by attrition */
	if (((hosts[i].mud & PLAYER) && wizmud)
		|| ((hosts[i].mud & WIZ) && !wizmud))
	    continue;
	if (compare(hosts[i].ip[0],ips[0]) 
		&& compare(hosts[i].ip[1], ips[1])
		&& compare(hosts[i].ip[2], ips[2])
		&& compare(hosts[i].ip[3], ips[3])) {
	    if (query_exempt(name,wiz_level,hosts[i].exempt)
		|| num_players < hosts[i].maxlogins)
		    continue;
	    /*
	     * If we are here, this entry is (sometimes) applicable from
	     * this player and IP.  If it is current, return the string,
	     * otherwise, calculate and remember the time delay.
	     */
	    if (   (index(hosts[i].days, today) != -1) 
		&& (curr_time >= hosts[i].start_time) 
		&& (curr_time <= hosts[i].end_time)) {
		    denied++;
	    	    if (hosts[i].reason)
	                return hosts[i].reason;
		    else
		        return "Access currently denied from your site.";
		    }
	    if (curr_time >= hosts[i].start_time) { /* tomorrow */
		if (index(hosts[i].days, tomorrow) < 0)
		    continue;
		int x = 2400 + hosts[i].start_time;
		if (x < chk_time)
		    chk_time = x;
		}
	    else {
		if (hosts[i].start_time < chk_time)
		    chk_time = hosts[i].start_time;
		}
	    }
	}
    if (chk_time > 9999) {
	logins++;
	return 0;
    }
    curr_time = (curr_time % 100) + (curr_time / 100) * 60;
    chk_time = (chk_time % 100) + (chk_time / 100) * 60;
    logins++;
    return chk_time - curr_time;
    }

load_deny_list()
{
array temp, arr, line;
int i, sd, ed, s ;
class c_bar record;
string tmpstr;
    tmpstr = grab_file(BAR_DIR + DENY_FILE);
    if (!tmpstr)
	throw "Could not find data file, looking at ("+ BAR_DIR 
	+ DENY_FILE + ").\n";
    temp = "RO/lib/parse_file"->filterscript(
	[ "IP","TIME","DAYS","LOGINS", "MUD","EXCUSE","EXEMPT"],
	[ STRING,STRING,STRING|VAR_ARGS,INT,STRING,STRING,VAR_ARGS|STRING ],
	tmpstr) ;   
    s = sizeof(temp);
    for (i = 0; i < s; i++)
    {
	record = create c_bar;
	line = temp[i];
	  /* IP */
	arr = explode(line[0], ".");
	record.ip = allocate (4);
	record.ip[0] = (arr[0] == "*" || arr[0][0] == '[')? arr[0]
		: atoi(arr[0]);
	record.ip[1] = (arr[1] == "*" || arr[1][0] == '[')? arr[1]
		: atoi(arr[1]);
	record.ip[2] = (arr[2] == "*" || arr[2][0] == '[')? arr[2]
		: atoi(arr[2]);
	record.ip[3] = (arr[3] == "*" || arr[3][0] == '[')? arr[3]
		: atoi(arr[3]);
	/* TIME */
	if (stringp(line[1]))
	{
	    arr = explode(line[1], "-");
	    record.start_time = atoi(arr[0]);		
	    record.end_time = atoi(arr[1]);
	}
	else
	{ /*default */
	    record.start_time = 0;
	    record.end_time = 2359;
	}
	/* DAYS */	
	record.days = Days; /*default */
	if (pointerp(line[2]))
	{
	    if (sizeof (line[2]) == 1)
	    {
		if (index(line[2], "-") > -1)
		{
		    arr = explode(line[2], "-");
		    sd = index(Days, lower_case(arr[0]));
		    ed = index(Days, lower_case(arr[1]));
		    if (sd > -1 && ed > -1)  
			record.days = Days[sd..ed];
		}
	    }
	    else
	    { 
		if (sizeof (line[2]) > 1)
		{
		    record.days = [ ];
		    for (sd = 0; sd < sizeof (line[2]);sd++)
		    {
			record.days += [ lower_case(line[2][sd]) ];
		    }
		}
	    }	
	}		
	/* LOGINS */		
	record.maxlogins = line[3];
	/* MUD */
	if (line[4] == "players") 
	    record.mud = 1;
	else if (line[4] == "wizard")
	    record.mud = 2;
	else
	    record.mud = 3;
		/* EXCUSE */		
	if (stringp(line[5]))
	    record.reason = line[5];
	else
	    record.reason = "Go away.\n"; 
	/* EXEMPT */
	/* record.exempt = explode(line[6], " "); Causing failure - G */
	/* and add it in */
	hosts += [ record ];
    }
}

/*
 * NAME:        query_ip_ok
 * ACTION:      Check if an ip is allowed to connect to us
 * PARAMETERS:  string ip "a.b.c.d", string name (lowercase), int wiz_level
 * RETURN:      0 if ok, rejection string if not
 */

query_ip_ok(string ip, string name, int wiz_level) {

    int wizmud = WHICH_MUD->is_wiz_mud();

    if (!pointerp(hosts)) {
	write(file_name(this_object()) 
		+ " could not load its data file. Please fix!");
	return (wiz_level > 0);
        }

#ifdef UNTRUSTED
    if (pointerp(untrusted) && !wizmud && (index(untrusted, name) > -1))
	return "You are banned from the player dec, try the wizdec";
#endif

    return check_ip(ip, name, wiz_level, 1);
    }

/* functionality moved to check_ip - G */

query_ip_ok_old(string ip, string name, int wiz_level)
{
int i, s;
int tme;
int wizmud = WHICH_MUD->is_wiz_mud();
array ips;
    if (!pointerp(hosts))
    {
	/*  a fatal load of hosts, let wizards on, but no one else */
	write(file_name(this_object()) 
		+ " could not load its data file. Please fix!");
	return (wiz_level > 0);
    }
    ips = explode(ip,".");
    for (i=0;i<4;i++)
    {
	ips[i] = atoi (ips[i]);
    }
#ifdef UNTRUSTED
    if (pointerp(untrusted) && !wizmud && (index(untrusted, name) > -1))
	return "You are banned from the player dec, try the wizdec";
#endif

    if ( query_pass(name) )
	return 0;  /* Allow in the temporary name */
    i = 0;
    tme = atoi(CURRENT_TIME);
    s = sizeof(hosts);
    while (i < s)
    {
	if (compare(hosts[i].ip[0],ips[0]) 
		&& compare(hosts[i].ip[1], ips[1])
		&& compare(hosts[i].ip[2],ips[2])
		&& compare(hosts[i].ip[3], ips[3])) 
	{
	    if (
/* test mud */	( ((hosts[i].mud & PLAYER) && !wizmud)
		|| ((hosts[i].mud & WIZ) && wizmud) )
		&& (wiz_level < SENIOR)
		&& (name != "shutdown")
/* test day */	
		&& (index(hosts[i].days, CURRENT_DAY) != -1) 
/* test start time */
		&& (tme >= hosts[i].start_time) 
/* test end time */
		&& (tme <= hosts[i].end_time) 
/* processor demanding: check number of logins */
		&& (!query_exempt(name,wiz_level,hosts[i].exempt)
		&& player_population() > hosts[i].maxlogins) /* not >= :) */
	    ) 
	    {
	    	if (hosts[i].reason)
	            return hosts[i].reason;
		else
		    return "No MUD logins from your site.";
	    }
	}
	i ++;
    }
    return 0;
}

int player_population()
{
array all = users();
int population, i;
    population = 0;
    for (i = 0; i < sizeof(all); i++)
	if (!all[i]->query_wiz())
	    population++;
    return population;
} 

int
query_exempt (string name, int wiz_level, array exempt)
{
int i;
    if (wiz_level >= GOD)
	return 1;  /* Never bar a god, they might get angry;) */
    if (!exempt)
	return 0;
    if (index (exempt, name) >= 0)
	return 1;
    if (index(exempt, "wizards") >=0 && wiz_level)
	return 1;
    if (index(exempt, "senior") >=0 && wiz_level >= SENIOR)
	return 1;
    if (index(exempt, "elder") >=0 && wiz_level >= ELDER)
 	return 1;
    return 0;
}


/* a maybe a range denoted [a-b] or by a *, b is always an integer. */
int
compare((int|string) a, int b) {
int r1, r2;
array r0;

  if (a == b || a == "*") return 1;
  if (intp(a))
	return 0; /* Aint got any chance of matching now! */
  if (a[0..0] == "[")  {
		r0 = explode(a[1..strlen(a)-1], "-");	
		r1 = atoi(r0[0]);
		r2 = atoi(r0[1]);
		if (b >= r1 && b <= r2)
	    return 1;
    }
  return 0;
}

add_pass(string who) { AllowRegardless += [ who ]; }
reset_passes() { AllowRegardless = [ ]; }
query_pass((int|string) who)
{
    return intp(who)?(AllowRegardless):(index(AllowRegardless,who)!=-1);
}
/*
	This should be in /std/banish.c!
	Not /std/bar.c

	-- Dredd.
*/

#ifdef UNTRUSTED
untrusted(who)
{
object caller;
int lvl, where;
	if (!untrusted) untrusted = [ ];
	caller = this_player();
	if (!who) return untrusted;
	if (!caller) return "Failed";
	if (caller->query_wiz() < ELDER) return "Unauthorised";
	lvl = FINGER->query_wiz(who);
	if (!lvl) return "Not a wizard";
	if (caller->query_wiz() < lvl) return "Not allowed";
	where = index (untrusted, who);
	if (where > -1) untrusted = ARRAY->delete(untrusted, where, 0);
	else untrusted += [ who ];
	save_object (BAR_DIR + SAVE_FILE);
	return untrusted;
}
#endif
