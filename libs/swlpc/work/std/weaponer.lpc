#define SKILL 0
#define MATERIAL 1
#define DAM 2
#define ROBUST 4
#define WEIGHT 5
#define TYPE 8
#define STR_REC 9
#define DEX_REC 10
#define PROJECTILE 11
#define THROW_DAM 12
#define IMPACT 13
#define SHOOT_WHAT 14
#define AUTO_L 15
#define DC 16 
/* str - is the weapon type eg "poleaxe"
 * optpoint - is an optional pointer to a special object. Use it to
 *                  configure your special items.
 */

weapon_exists(str) 
{
	return (index(weapons, "#"+str) != -1);
}

/*
** Automatic creation (emulated persistence)
*/
object make_auto(array args)
{
    object wep;
    wep = create_weapon(args[0], 0);
    wep->set_damage(args[1]);
    return wep;
}

make(str, optpoint, callr)
{
    int x, wght, charge, max;
    string mat, alt,b, who;
    object wp;	
    array weapcost;
    object previous = caller();
    if ((file_name(previous) == ITEMER) && objectp(callr))
	previous = callr;

	who = query_su_name(previous);
	if (!who) who = "#treasury";

	if (!str) {
		x = random(sizeof(weapons))/2 *2;

		str = weapons[x][1..];
/*write(x+"   "+str+"\n"); */
	}
	else if (pointerp(str)) {
		str = str[random(sizeof(str))];	
	}
	
	if (optpoint) return create_weapon(str, optpoint);

	if (!is_cloned(previous) && previous->query_living())
		return create_weapon(str);

/* first should try and get the weapon from a shop,
   else charge them price in array above I guess -- Dredd */
	x = index(weapons, "#"+str);
	if (x < 0) max = 0;
	else max = (weapons[x][WEIGHT]/100 +1) * weapons[x][DAM];
	weapcost = SHOP_SERVER->get_cheapest(str, who, max, 0, previous);
	if (!weapcost) {
/*		LOG->log("NPC_BUY", "0 coins: " + who + " creates " + str +
			" for " + file_name(previous) + ".");
*/		return create_weapon(str);
	}
	LOG->log("NPC_BUY", STRINGS->itoa(weapcost[1]) + " coins: "+
		who + " bought " + weapcost[0]->short() + " (requested "+
		str + ") from " +
		weapcost[2] + " (" + weapcost[2]->query_short_desc() +
		") for " + file_name(previous) + ".");
    if (!optpoint) weapcost[0]->set_auto("WEAPONER", ({ str }) );
	return weapcost[0];
}

create_weapon(str, optpoint)
{
  array allargs;
  int x, wght; string mat, alt,b, distance;
  object wp;	
  string who;
  x = index(weapons, "#"+str);
  if (x < 0)
    return 0;
  x+=1;
  if (optpoint)
    wp = optpoint;
  else
    if (weapons[x][PROJECTILE])
    {
      return create_projectile(str, x, optpoint);
    }
    else
      if (weapons[x][SHOOT_WHAT] || weapons[x][THROW_DAM]) 
      {
        wp = clone_object("obj/distance_weapon");
        distance = 1; /* flag */
      }
      else 
      {
        wp = clone_object("obj/weapon");
      }
  wp->set_name(str);
//  wp->set_skill(weapons[x][SKILL]);
  // updated to bring into line with /std/armourer
  // 20010815 Rattcherryh
  mat = material(weapons[x][MATERIAL]);
//  wp->set_material(mat);
  wp->set_material(weapons[x][MATERIAL]);
  wp->set_class(weapons[x][DAM]);
  wp->set_robust(weapons[x][ROBUST] /* / 2 */ );
  wght = weapons[x][WEIGHT]/2000;
  if (wght == 0)
    wght = 1;
  wp->set_weight( wght );
//  wp->set_drawtime(weapons[x+8]);
  wp->set_type(weapons[x][SKILL]); 
  wp->set_requirements(weapons[x][STR_REC]/4, weapons[x][DEX_REC]/4);
  wp->set_damage_type(query_damage_type(weapons[x][SKILL]));
  wp->set_value( (weapons[x][WEIGHT]/100 +1) * weapons[x][DAM]);
  wp->set_short("a "+str);
  if (weapons[x][DAM])
  {
    wp->set_long("A "+ mat + " " + str + 
      ". It has a small message written upon it.\n");
    wp->set_read("Created by an accredited weaponer (member of the SWWMG).\n");
    /* Only proper weapons (we don't want stones having this) */
  }
  else
    wp->set_long("A " + str + ".\n");
  allargs = STRINGS->split_first(weapons[x][SKILL], "-");
  if (allargs && sizeof(allargs) > 0)
    mat = allargs[0];
  else
    mat = weapons[x][SKILL];
/* if (sizeof(allargs) > 1) b = allargs[1]; */
  wp->add_id(mat);
  if (distance) {
    wp->set_throwable(weapons[x][THROW_DAM]);
    wp->set_impact(weapons[x][IMPACT]);
    wp->set_shootable(weapons[x][SHOOT_WHAT]);
    wp->set_autoload(weapons[x][AUTO_L]);
    wp->set_distance_class(weapons[x][DC]);
  }
  if (!optpoint) wp->set_auto("WEAPONER", ({ str }) );
  return wp;
}

create_projectile(str, x, optpoint) 
{ 
	int wght; 
	string mat, b;
	object wp = optpoint;
	string a;
    array allargs;

	if (!wp)
		wp = clone_object("obj/projectile");
	wp->set_id(str);
// updated to bring into line with /std/armourer
// 20010815 Rattcherryh
	mat = material(weapons[x][MATERIAL]);
//	wp->set_material(mat);
	wp->set_material(weapons[x][MATERIAL]);
	wght = weapons[x][WEIGHT]/2000;
	if (wght == 0) wght = 1;
	wp->set_weight( wght );
	wp->set_value( (weapons[x][WEIGHT]/100 +1) * weapons[x][DAM]);
	wp->set_read("Created by an accredited weaponer (member of the SWWMG).\n");
	a = (STRINGS->is_vowel(str[0..0])) ? "an" : "a";
	wp->set_short(a + " " + str);
	wp->set_long(capitalize(a) + " " + mat + " " + str + ". It has a small message written upon it.\n");
    allargs = STRINGS->split_first(weapons[x][SKILL], "-");
    if (allargs && sizeof(allargs) > 0)
        mat = allargs[0];
    else
        mat = weapons[x][SKILL];
	wp->set_damage(weapons[x][THROW_DAM]);
	wp->set_impact(weapons[x][IMPACT]);
	wp->add_id(mat);
        wp->set_damage_type(query_damage_type(weapons[x][SKILL])[0]);
    if (!optpoint) wp->set_auto("WEAPONER", ({ str }) );
	return wp;
}

query_wep() { return weapons; }

list_weapons() {
int count;
	for (count = 0; count < sizeof(weapons); count += 2) {
		write(
explode(weapons[count],"#")[0] + (count == sizeof(weapons)-2?
			".\n":", ") );
	}
} 

// converts "axe-long" into "naginata" -- useful for determining the (rough
// base weapon type that a magical item uses.
query_base_type(string t)
{
    int i;

    for (i = 1; i < sizeof(weapons); i += 2)
	if (weapons[i][SKILL] == t)
	    return weapons[i-1][1..];
    return 0;
}

material(num) {
	if (num == MAT_IRON) return "bronze";
	if (num == MAT_STEEL) return "steel";
	if (num == MAT_WOOD) return "wood";
	if (num == MAT_TEMPERED) return "tempered steel";
	if (num == MAT_LEATHER) return "leather";
	if (num == MAT_BONE) return "bone";
	if (num == MAT_TOOTH) return "tooth";
	if (num == MAT_STONE) return "stone"; 
	if (num == MAT_PAPER) return "paper";
	if (num == MAT_GLASS) return "glass";
	if (num == MAT_CLOTH) return "cloth";
	if (num == MAT_BRONZE) return "bronze"; 
	return "bronze";
}

query_damage_type(string skill) {
    array a = explode(skill, "-");

    return  a[0] == "whip" ? [ "cut", 100] :
            skill == "dagger-stiletto" ? [ "puncture", 100 ] :
		a[0] == "dagger" ? [ "cut", 50, "puncture", 50 ] :
		a[0] == "axe" ? [ "cut", 100 ] :
		a[0] == "mace" ? [ "impact", 100 ] :
		a[0] == "rapier" ? [ "puncture", 80, "cut", 20 ] :
		a[0] == "sword" ? [ "cut", 80, "puncture", 20 ] :
		a[0] == "staff" ? [ "impact", 100 ] :
		a[0] == "spear" ? [ "puncture", 90, "cut", 10 ] :
		a[0] == "hammer" ? [ "impact", 100 ] :
		a[0] == "stone" ? [ "impact", 100 ] :
		a[0] == "arrow" ? [ "puncture", 100 ] :
		a[0] == "bolt" ? [ "impact", 70, "puncture", 30 ] :
			[ "cut", 40, "impact", 30, "puncture", 30] ;
    }

// Jenna Sep 00
query_mastery_type(wep) 
{
    string skill;
    array a;
    string m;

    if (objectp(wep))
	skill = wep->query_weapon_type();
    else
	skill = wep;
    if (!stringp(skill))
	return 0;
    a = explode(skill, "-");
    m = (
		a[0] == "whip" ? "whip" :
                a[0] == "dagger" ? "knife" :
                a[0] == "axe" ? "axe" :
                (a[0] == "mace" || a[0] == "hammer") ? "mace" :
                (a[0] == "rapier" || a[0] == "sword" ) ? "sword" :
                a[0] == "staff" ? "staff" :
                a[0] == "spear" ? "spear" : 
			0
		);
    if (m)
        return m + " mastery";
}

