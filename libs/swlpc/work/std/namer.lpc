reset() { return 1; }

/* yeah yeah - race is ignored...
   This *was* a 5 minute hack :)
   */
make_name(race) {
    int x;
    string s;
    int y;

    x = random(file_size("std/NAMES"));
    s = grab_file("std/NAMES", x-20, x+20);

    x = 0;

    x = index(s, "\n", 0) + 1;
    if (x < 1)
        return "Brutus";

    y = index(s, "\n", x);
    return s[x..y-1];
}
