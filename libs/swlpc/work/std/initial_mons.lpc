make(type, level, gender, name)
{
int x;
int scale;
object ret;
    if (!type || !level || !gender) return;
    x = index(monsters, type);
    if (x < 0) return;
    while(stringp(monsters[x]))
	x++;
    ret = clone_object("obj/monster");
    if (name)
    {
	name = capitalize(name);
	ret->set_name(name);
	ret->add_id(type);
    }
    else
	ret->set_name(type);
    if (name && type != "human")
	ret->set_short(name+" the "+type);
    ret->set_level(level);
    ret->set_race(monsters[x][RACE]);
    ret->set_gender(gender);
    if (level > monsters[x][SIZE])
	scale = 10 + (level/monsters[x][SIZE]);
    else
	scale = 10 - (monsters[x][SIZE]/level);
    if (scale < 4) scale = 4;
    ret->add_siz(monsters[x][SIZE]*scale/10-ret->query_siz());
    ret->set_wc(monsters[x][WC]*scale/10);
    ret->set_ac(monsters[x][AC]*scale/10);
    ret->set_aggressive(monsters[x][AGGRESS]);
    ret->set_wimpy(monsters[x][WIMP]*(ret->query_max_hp())/100);
    ret->set_body(body(monsters[x][BODY]));
    ret->set_chance(monsters[x][SP_CHANCE]);
    ret->set_spell_mess1(monsters[x][SP_MESS1]);
    ret->set_spell_mess2(monsters[x][SP_MESS2]);
    ret->set_spell_dam(monsters[x][SP_DAM]);
    return ret;
}

body(descr)
{
    array body, new_bit;
    int pos, next, sub;
    string part, oper;

    descr = "+"+descr;
    body = [];
    while (descr && descr != "")
    {
	oper = descr[0..0];
	descr = descr[1..];
	pos = index(descr, '+');
	if (pos < 0) pos = sizeof(descr);
	next = index(descr, '-');
	if (next < 0) next = sizeof(descr);
	if (next < pos) pos = next;
	next = index(descr, '}');
	if (next < 0) next = sizeof(descr);
	if (next < pos) pos = next;
	part = descr[..pos-1];
	if (descr[pos] == '}')
	{
        new_bit = STRINGS->split_first(part[1..], ",");
        if (!new_bit) 
        {
	        new_bit = allocate(2);
            new_bit[0] = part[1..];
        }
	    pos++;
	}
	else
	{
	    next = index(bodies, part);
	    if (next < 0) return 0;
	    new_bit = bodies[next+1];
	}
	if (oper == "+")
	    body += new_bit;
	else if (oper == "-")
	    for (sub = 0; sub < sizeof(new_bit); sub += 2)
	    {
		next = index(body, new_bit[sub]);
		if (next >= 0)
		    body = body[0..next-1]+body[..next+2];
	    }
	descr = descr[pos..];
    }
    return body;
}

test(type)
{
int x;
    x = index(monsters, type);
    if (x < 0) return -5;
    while(stringp(monsters[x]))
	x++;
    return body(monsters[x][BODY]);
}
