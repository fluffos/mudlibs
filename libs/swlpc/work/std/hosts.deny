# Hosts Deny file, used by /std/bar.c
# format is of: 
#   ip=	<ip number>
#   time= starttime-endtime	(optional, default 24hr)
#   days= startday-endday (or day1,day2,etc)
#   logins=	<integer>		(default 0)
# 					(this is the number of people that
#					can log in from that IP set, before
#					login is refused)
#   mud=  [all|player|wizard] 			(optional, default - all)
#   excuse= some reason 
#   exempt = (names of people, or 'wizards' that arnt affected by the rule)
#
#      the exempt field can be [name, "wizards","senior","elder"] 
#      gods are automatically exempt from rules (by definition;)
#
# (The ip= field resets all other fields to their maximum values - G).
# Note that Sun is day 1, Sat is day 7.

########## GENERAL RESTRICTIONS

# Limit daytime players, so that poor little IP1 can manage the mud plus the
# occasional direct login from an honors student.
# Gandalf, Apr '94
# NOTE: upped to 100 for the comms skills prac.

#ip	=	*.*.*.*
#time	=	845-1715
#days	= Mon,Tue,Wed,Thu,Fri
#logins	= 100
#mud	= players
#excuse	= "Daytime access (10am-5pm) is restricted to 50 logins."
#exempt	= elders

