/*
 * WEAR possibilities:
 *	Area	type		desc
 *	hands	gloves		1 layer only
 *	arms	sleeves		inner layer; soft materials only
 *	arms	vambrace	outer layer; may be jointed
 *	legs	pants		inner - soft
 *	legs	greaves		outer - hard should only cover half
 *	feet	boots
 *	head	hood		may be worn inside helmet (padding)
 *	head	helmet
 *	chest	shirt		innermost layer; must be soft
 *	chest	
 *
 *  Other possibilities? tails/claws/hands
 */

/*
 * short:		an adjective for the construction type.
 * folds:		stored folded in pack - same enc as when worn.
 * under:		can be worn under other clothing/armour
			1-under, 2-over
 * slices:		not resistant to slicing attack
 * weight:		grams, whole body suit (not underdax)
 * enc:			whole suit, worn.  If carried, double enc if not folded.
 * ac:			per location.  some locs can wear undergarments.
 * blunt_mod:		percentage of AC used against blunt attacks.
 */

inherit "RO/Servers";

#define ATYPEF_0 1

array acm = [
   "soft leather",  1,  1,  1,  2500,  250,  2,  50, 0 | ATYPEF_0 ,
   "cotton",  1,  1,  1,        1000,  100,  1,  0, 0 | ATYPEF_0 ,
   "silk",  1,  1,  1,          1000,  50,   1,  0, 0 | ATYPEF_0 ,
   "wool",  1,  1,  1,          2500,  200,  1,  0, 0 | ATYPEF_0 ,
   "canvas",  1,  1,  1,        2000,  100,  1,  0, 0 | ATYPEF_0 ,
   "velvet",  1,  1,  1,        2000,  100,  1,  0, 0 | ATYPEF_0 ,
   "linen",  1,  1,  1,         1000,  100,  1,  0, 0 | ATYPEF_0 ,
   "plaid",  1,  1,  1,         1000,  100,  1,  0, 0 | ATYPEF_0 ,
   "grass",  1,  1,  1,         1000,  300,  1,  0, 0 | ATYPEF_0 
 ];

#define M_TYPE 0
#define M_FOLD 1
#define M_UNDER 2
#define M_SLICE 3
#define M_WEIGHT 4
#define M_ENC 5
#define M_AC 6
#define M_BLUNT 7

