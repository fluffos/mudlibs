reset() 
{
    clothing_types = cloth1 + cloth2;
}

#define C_COVER 1
#define C_LAYER 2
#define C_WEIGHT 3
#define C_SIZE  4

#define MEDIUM 12


/*
** Automatic creation (emulated persistence)
*/
object make_auto(array args)
{
    object arm;
    arm = create_clothing(args[0], args[1], args[2], args[3], 0);
    return arm;
}

/*
 * Main creation function..
 */
make(mat, name, size, color, optpoint)
{
    string who;
    array armcost;
    int n,m, max;

	who = query_su_name(caller());
	if (!who) who = "#treasury";
	if (optpoint) return create_clothing(mat, name, size, color, optpoint);
	m = index(acm, mat);
	n = index(clothing_types, name);
	if (n < 0 || m < 0) max = 0;
	else max = acm[m + M_WEIGHT] * clothing_types[n+C_WEIGHT] / 400;
	armcost = SHOP_SERVER->get_cheapest(mat+" "+name, who, max);
	if (!armcost) 
    {
		return create_clothing(mat, name, size, color, optpoint);
	}
	return armcost[0];
}

create_clothing(mat, name, size, color, optpoint)
{
    int m,n, wght; string alt,b;
    object am;	

	m = index(acm, mat);
	if (m < 0) return;
	n = index(clothing_types, name);
	if (n < 0) return;
	if (!size) size = MEDIUM;
	if (optpoint) am = optpoint;
	else am = clone_object("obj/armour");
	am->set_name(name);
	am->add_id(mat);
	am->add_id(name);
	am->add_id(mat + " " + name);
	am->set_cover(clothing_types[n + C_COVER]);
	am->set_layer( clothing_types[n + C_LAYER] );
    if (!color) color = colors[random(sizeof(colors))];
    am->set_color(color);
#if 0
	wght = ( acm[m + M_WEIGHT] * size * clothing_types[n + C_WEIGHT] )
							 / 2000000;
	if (!wght) wght = 1;
#endif
	am->set_weight(wght);
	am->set_weight(1);
	am->set_under( acm[m + M_UNDER] );
    if (name[sizeof(name)-1..sizeof(name)-1] == "s")
    	am->set_short(mat + " " + name);
    else
    	am->set_short("A " + mat + " " + name);
	am->set_long(capitalize(color) + " " + name + " made of " + mat + ".\n");
	am->set_type(name);
	am->set_ac(acm[m + M_AC] / 3);
	am->set_robust(acm[m+M_AC]);
    if (!optpoint) am->set_auto("TAILOR", [ mat,name,size,color ]);
	return am;
}

test(str) {
int count;
    if (str == "materials") {
	write("Armor Materials:\n");
	for (count = 0; count < sizeof(acm); count += 9) 
		write(acm[count]+(count == sizeof(acm)-9?".\n":", "));
	}
    if (str == "types") {
	write("Armor types:\n");
	for (count = 0; count < sizeof(clothing_types); count += 5) 
		write(clothing_types[count]+" ("+implode(clothing_types[count+1],"+")+
			")"+(count == sizeof(clothing_types)-5?".\n":", "));
	}	
}

query_acm () { return acm + [] ; }

query_clothing_types () { return clothing_types + [ ]; }
