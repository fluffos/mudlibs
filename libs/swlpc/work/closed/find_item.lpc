 * Shattered World Mudlib (Wizard support)
 * find_item() code.
 *
 * This code used to be in the wiz_soul, but is now split into
 * its own file.
 */

/*
 * History:
 * 940615 Hunter    	added SERVLIST support to find_item()
 * 941215 Hunter    	added wildcards to find_item()
 * 950104 Hunter    	added last_object ("it") to find_item()
 * 950527 Hunter    	added "me" to find_item()
 * 950528 Hunter    	added remote object supprt to find_item()
 * 950914 Hunter	find_item() moved from closed/wiz_soul.c to
 *			separate file.
 * 950919 Hunter	added root object, ie the thing with the filename
 *			"", support.
 */


/*
 * #include's
 */
#include <Config.h>
#include <security.h>
