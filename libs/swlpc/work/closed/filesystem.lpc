/*
 * Shattered World Mudlib (Wizard support)
 * Filesystem code
 * 
 * This object contains basic functions and file-system calls
 * relating to the low-level Unix-style directory structure.
 *
 * This code used to be in the wiz_soul, but is now split into
 * its own file.
 */

/*
 * History:
 * 951008 Hunter	created separate file.
 */

/*
 * #include's
 */
#include <Config.h>
#include <security.h>
#include <errors.h>
#include <types.h>

/*
 * inherit's
 */
inherit "RO/Servers"; 

/*
 * variables
 */
string UnixFSPwd;		/* file-system pwd */

valid_read(str)
{
    return valid_file(str, "r", "");
}

string
query_pwd( )
{
    return UnixFSPwd;
}

nosave
valid_file(str, what, dir)
{
    str = compute_path (str);
    if (!query_valid_file(str+dir, what))
    {
        if (dir == "/")
	    dir = "directory ";
        if (what == "r")
            notify_fail("Can't read " + dir + str + "\n");
        else
            notify_fail("Can't write " + dir + str + "\n");
        return 0;
    }
    return str;
}

string
compute_path(str)
{
array exploded, stack = ({ });
string pwd = this_object()->query_pwd();
string name = environment()->query_real_name();
int i;
    if (!stringp(str))
	return remove_trailing_slash( pwd );
    str = STRINGS->strip_whitespace(str);
    if (str[0] != '/' && str[0] != '~')
	str = pwd + str;
    exploded = explode(str, "/");
    if (!pointerp(exploded))
	return "";
    for (i=0;i < sizeof(exploded);i++)
    {
	if (exploded[i] == ".." && sizeof(stack) > 0)
	{
	    stack = stack[..sizeof(stack)-2];
	}
	else if (exploded[i] == "~")
	{
	    stack = ({ PlayerHome(name) });
	}
	else if (exploded[i][..0] == "~")
 	{
	    stack = ({ "players", exploded[i][1..] }) ;
	}
	else if (exploded[i] != ".")
	{
	    stack += ({ exploded[i] });
	}
    }
    if (!sizeof(stack))
	return "";
    return implode(stack, "/");
}

/*
 * add a leading slash to a filename, if it doesn't already have one
 */
string
add_slash( string filename )
{
    if ( filename[0..0] != "/" )
    {
	filename = "/" + filename;
    }
    return filename;
}

/*
 * remove a leading slash from a filename, if it already has one
 */
string
remove_slash( string filename )
{
    if ( filename[0..0] == "/" )
    {
	filename = filename[1..];
    }
    return filename;
}


/*
 * glue a path name to a filename
 */
string
build_filename( string path, string file )
{
int i = sizeof( path ) - 1;
     if ( path[i..i] == "/" )
	return path + file;
    return path + "/" + file;
}

/*
 * add a trailing slash, as if it is a directory name
 */
string
add_trailing_slash( string path )
{
int i = sizeof( path ) - 1;
    if ( path[i..i] == "/" )
	return path;
    return path + "/";
}

/*
 * remove a trailing slash
 */
string
remove_trailing_slash( string path )
{
int i = sizeof( path ) - 1;
    if ( path[i..i] == "/" )
	return path[0..i-1];
    return path;
}

/*
 * query_directory: 
 *  given a file mask, return an array of files, and information.
 *  Can recurse directories. (tricky).
 */
query_directory( string dir )
{
array efun_ls;
    
}

/*
 * is_directory:
 *  given a filename, return true if the file is a directory.
 */
int
is_directory( string file )
{
    return file_size(file) == -2;
}

