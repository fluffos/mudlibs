ACTION_PLAYER ACTION_SECURE
grant_wiz_level(str) {
    int rec_lev;

    CHECK_SECURE;
    if (!str || !query_ip_number(this_player()))
        return 0;
    grantee = find_player(str);
    if (!grantee) {
        write(str+" is not within range.\n");
        return 1;
    }
    rec_lev = grantee->query_wiz();
    if (rec_lev >= GOD) {
        write("You can't mess with a god!\n");
        return 1;
    }
    if (rec_lev > wiz_level) {
        write("You can't change a more powerful wizard!\n");
        return 1;
    }
    if (wiz_level < SHUTDOWN) {
        write("You are not an elder and can't grant power!\n");
        return 1;
    }
    if ((wiz_level < GOD && rec_lev >= ELDER) ||
        (wiz_level < ELDER && rec_lev >= SENIOR)) {
        write("You may not grant power to your peers.\n");
        return 1;
    }
    write("What wiz_level do you want to grant "+str +"?\n"+
        str + " is wiz_level "+rec_lev+" now.\n");
    input_to("grant_wiz_level2");
    return 1;
}

grant_wiz_level2(str) {
    int rec_lev;
    if (!str) {
        grantee = 0;
        write("Aborted.\n");
        return 1;
    }
    if (!grantee || this_player() != myself) {
        write("Level setting error.\n");
        return 1;
/*        illegal_patch("grant_wiz_level2");*/
    }
    rec_lev = atoi (str);
    if (!rec_lev) {
        write("Invalid integer.\n");
        return 1;
    }
    if (rec_lev <= 0 && wiz_level < GOD) {
        write("Only a god can take away wizard status");
        return 1;
    }
    if ((wiz_level < GOD && rec_lev >= ELDER) ||
        (wiz_level < ELDER && rec_lev >= SENIOR)) {
        write("You may not promote someone to the status of a peer"+
            " or higher.\n");
        return 1;
    }
    SET_HANDSHAKE(str)
        if (grantee->set_wiz_level(handshake))
            write("wiz_level "+str+" granted.\n");
    grantee = 0;
}

