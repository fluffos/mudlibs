ACTION_FS ACTION_SECURE
edit(file)
{
    CHECK_SECURE;
    if (wiz_level < CREATE) return 0;
    if (!file) {
        write("Edit what file ?\n");
        return 1;
    }
    file = valid_read(file);
    if (!file) {
        write("Permission denied.\n");
        return 1;
    }
    tell_object(myself,"editing: "+file +"\n");
    "modules/ed"->ed_start(file, this_object(), "finish_ed");
    this_player()->redirect_input(this_object(), "catch_ed");
    return 1;
}

catch_ed(s)
{

    if ("modules/ed"->ed_cmd(myself, s))
        this_player()->redirect_input(this_object(), "catch_ed");
    return 1;
}

finish_ed()
{
    myself->set_prompt(myself->query_store("ed_prompt"));
    myself->add_store("ed_prompt", 0);
    return 1;
}


ACTION_FS
set_pager(NewPager)
{
    CHECK_SECURE;
    if (NewPager == "more" || NewPager == "view")
        myself->add_store("wiz_pager", NewPager);
    else
        write("The pager must be either \"more\" or \"view\".\n");
    return 1;
}

ACTION_FS ACTION_SECURE
page_file(file)
{
    string wpage = myself->query_store("wiz_pager");
    CHECK_SECURE;
    if (wpage == 0)
    {
    write("Please set your pager first, using either: \"pager more\" "
        +"or \"pager view\"\n");
    }
    else if (wpage == "more")
        more_file(file);
    else if (wpage == "view")
        view_file(file);
    return 1;
}

ACTION_FS ACTION_SECURE
view_file(file)
{
    int argc, i;
    array argv;
    string FileName;

    CHECK_SECURE;
    if (this_player()->query_term_type() == "vt100")
        write("Remember, your correct terminal type can be set "
                +"using: terminal <type>\n");
    this_player()->push_caution(MORE_CAUTION);
    argc = 0;
    argv = allocate(0);
    if (file != 0)
    {
        array Wotcha;
        Wotcha = explode(file, " ");
        for (i = 0; i < sizeof(Wotcha); i++)
        {
            FileName = "/" + valid_read(Wotcha[i]);
            if (FileName)
            {
                argv = (argv+ ({ argc }));
                argv[argc-1] = FileName;
            }
        }
        
#if 0
        FileName = "/" + valid_read(WotsLeft);
        argv = argv+ ({ argc });
        argv[argc-1] = FileName;
#endif
    }
    external_program("view", "visual_edit_done", argv);
    write("View is starting...");
    return 1;
}


ACTION_FS ACTION_SECURE
visual_edit(file)
{
    int argc;
    array cwd;
    array argv;
    string WotsLeft;
    string WotchaGot;
    string FileName;

    CHECK_SECURE;
    if (this_player()->query_term_type() == "vt100")
        write("Remember, your correct terminal type can be set "
                +"using: terminal <type>\n");

    argc = 1;
    argv = allocate(0);
    if (file != 0)
    {
        array Wotcha;
        int i;
        string subpath = "";

        Wotcha = explode(file, " ");
        for (i = 0; i < sizeof(Wotcha); i++)
        {
            FileName = valid_read(Wotcha[i]); 
	    FileName = "/" + fill_in_extension(FileName);
            cwd = explode(FileName, "/");
            if (sizeof(cwd) > 1 && cwd[1] != myself->query_real_name())
            {
                write("You can only edit in your home directory.\n");
                return 1;
            }
            if (sizeof(cwd) > 2)
                FileName = implode(cwd[2..], "/");

            if (FileName)
            {
                if (Wotcha[i][0] != '/') FileName = "/" + FileName;
                argv = (argv+ ({ argc }));
                argv[argc-1] = FileName;
            }
            argc++;
        }
    }
    if ( backup_file( FileName ) == BACKUP_FAILED )
    {
        write("Aborting edit!\n");
    }
    else
    {
	string msg = getenv("vimsg");

	if (msg)
	    myself->checked_say(myself->query_name() + " " + msg+".\n");
        if (stringp(FileName))
            LOG_FILESYSTEM( FileName, "edited", 0 );
        this_player()->push_caution(VI_CAUTION);
        external_program("elvis", "visual_edit_done", argv);
        write("vi is starting...");
    }
    return 1;
}

fill_in_extension(FileName) {
    if (FileName &&
	index(FileName, ".") == -1 &&
	file_size(FileName) == -1 &&
	file_size(FileName + ".lpc") != -1)
		return FileName + ".lpc";
	return FileName;
	} 

ACTION_GD
nslookup(s) 
{
    int i;
    object ob;

    CHECK_SECURE;

    notify_fail("Usage: nslookup a.b.c.d e.f.g.h i.j.k.l ...\n");
    if (!stringp(s)) return 0;

    array args = explode(s, " ")[..10];
    for (i = 0; i < sizeof(args); i ++)
    {
        ob = find_living(args[i]);
        if (ob)
            args[i] = query_ip_number(ob);
    }
    external_program("nslookup", "nslookup_done", args, 1, 1, 1);
    write("Looking...\n");
    return 1;
}

nslookup_done() { write("done\n"); return 1; }

ACTION_FS ACTION_SECURE
diff(s) 
{
    string f1,f2,out;
    array args;

    CHECK_SECURE;
    if (!stringp(s)) 
    {
        notify_fail( "Usage: diff <file1> <file2> <outputfile>\n" );
        return 0;
    }
    args = explode(s, " ");
    if (sizeof(args) != 3) return 0;
    f1 = pwd + args[0];
    f2 = pwd + args[1];
    out = pwd + args[2];
    if (!valid_read (f1) || !valid_read (f2)) 
    {
        notify_fail("diff: You can not read the input files.\n");
        return 0;
    }
    if (!valid_write (out)) 
    {
        notify_fail("diff: You can not write to " + out + ".\n");
        return 0;
    }
    if (file_size (out) != ENOFILE) 
    {
        notify_fail("diff: "+ out + " already exists.\n");
        return 0;
    }
    external_program("diff", "diff_done", ({f1,f2}), 1, out, 1);
    write ("Starting diff...\n");
    return 1;
}

diff_done () 
{
    tell_object(myself,"Diff complete.\n");
    return 1;
}

ACTION_GD
epi(s) 
{
    string prog, in, out, err;
    array onearg;
    array allargs;
    int x;

    CHECK_SECURE;
    notify_fail("Usage: epi prog arg in out err\n");
    if (!stringp(s)) 
    {
        return 0;
    }
    allargs = explode(s, " ");
    if (sizeof(allargs) < 5) return 0;

    prog = allargs[0];
    onearg = allargs[1];
    in = allargs[2];
    out = allargs[3];
    err = allargs[4];

    if (!stringp(prog)) return 0;

    if (!stringp(onearg))
        onearg = ({ });
    else
        onearg = ({ onearg });

    if (in == "-") in = 0;
    if (out == "-") out = 0;
    if (err == "-") err = 0;

    write("Prog: \"" + prog + "\"; in: \"" + in + "\"; out = \"" 
        + out + "\"; err = \"" + err + "\"\n");
/*
    if (!stringp(in)) 
    {
        notify_fail("epi: Won't take input from a terminal; you currently "
                +"have no way to send EOF\n");
        return 0;
    }
*/
    external_program(prog, "epi_done", onearg, in, out, err);
    write("Starting\n");
    return 1;
}

epi_done(ret) 
{
    write("Exit code: " + ret + "\n");
}


visual_edit_done(ret)
{
    myself->pop_caution();
    tell_object(myself, "> ");
}


ACTION_FS ACTION_SECURE
list_files( (int|string) strn) 
{
array ret,match,switches;
int size,show_size = 0,show_time = 0;
string path=0;
/* The -s flag is the same as with the unix ls command. means show 
 * file sizes
 * The -l flag means show both the file size and the last time the file was
 * modified.
 */
    CHECK_SECURE;
    if ( stringp(strn) ) 
    {
          switches = COMARGS -> split_args (strn, ({ "s","l" }), ({ }));
        show_size = switches[1][0];
        show_time = switches[1][1];
        if (sizeof(switches[0]))
            path = switches [0][0];
    }
    if (!path)
        path = "/" + pwd;
    if (path[0..1] == "//")         /* remote directory? */
    {
    int j = index(path, "/", 2);
    string servername = path[2..j-1];
        RCALL->remote_call( servername, "list_files_remote", "lib/ls", 
                "query_ls", path[j+1..], ({ path, show_size, show_time }) );
        return 1;
    }
    if (!(path = valid_dir_read(path))) 
    {
        notify_fail("Illegal path in \"ls\". Path was " + path + ".\n");
        return 0;
    }
    size = file_size (path + "/");
    if (size >= 0) 
    { 
        /* Dredd loves doing this... */
        match = split_path (path);
        ret = ls (match[0]);
        size = index (ret[0], match[1]); /* Find the bugger */
        ret[0] = ({ ret[0][size] });
        ret[1] = ({ ret[1][size] });
        ret[2] = ({ ret[2][size] });
        write ("ls : /" + path + "\n" +
             OUTPUT_FILE -> format_ls (ret,78,show_size,show_time)+"\n");
        return 1;
    }
    if (size == ENOFILE) 
    {
        match = split_path (path);
        if (query_valid_file(match[0] + "/", "r")) 
        {
            path = match [0];
        }
        else 
        {
            write(path + " doesn't exist.\n" + match[0] + " is unreadable.\n");
            return 1;
        }
        size = file_size (path + "/");
        if (size == ENOFILE) 
        {
            write (path + " is unreadable.\n");
            return 1;
        }
        if (size != EISDIR) 
           {
             write (path + " is not a directory.\n");
             return 1;
        }
    }
    if (pointerp (match)) 
    {
            write("ls : "+path+ "/" + match[1] +"\n");
        ret = ls_match (match[1], ls(path));
    }
    else 
    {
          ret = ls(path);
          write ("ls : " +path +"\n");
    }
/* Hunter wanted it piped into more. I will give it a go and see if
 * I like it :L */
/* Aparently he liked it, because it is still there :-) -H */
    if (ret)
        MORE -> more (OUTPUT_FILE -> format_ls (ret,78,show_size,show_time));
    else 
        write("No matching files.\n");
    return 1;
}

list_files_remote( ret, info )
{
array result;
    if (pointerp(ret))
    {
        result = ({ "", "ls : " + info[0] })
        + explode(OUTPUT_FILE->format_ls( ret, 78, info[1], info[2]), "\n");
    }
    else
    {
        result = ({ "", "ls : " + info[0] , "is unreadable" });
    }
    if (this_player())
        MORE->more( result );
    else
        tell_object(myself, implode(result, "\n") + "\n");
}

pls(foo) { return ls(foo); }

array ls_match (string pattern, array ls_files)
{
array matched,ret = ({ ({}), ({}), ({ }) });
int size,i,last = 0;
    size = sizeof (pattern);
    if (!size)
        return ls_files; /* Match everything */
    pattern = fix_pattern (pattern);
    matched = M_REGEXP->match(pattern,ls_files[0]);
    for (i = 0; i <sizeof (matched); i++)
    {
        last = index (ls_files[0],matched[i],last);
        if (last == EINDEX)
        {
            throw "Error! wiz_soul->ls_match() couldnt find a match";
            return;
        }
        ret[0] += ({ ls_files[0][last] });
        ret[1] += ({ ls_files[1][last] });
        ret[2] += ({ ls_files[2][last] });
    }
    return ret;
}

/* Takes a path and returns an array of everything before the last slash
 *   and everything after. ie for path = "std/object/a",
 *   ret = ({ "std/object","a"  });
 */
array split_path (string path)
{
int pos;
    pos = sizeof (path)-1;
    while (pos>=0 && path[pos] != '/')
        pos--;
    if (pos == -1)
        return ({ path, "" });
    return ({ path [..pos-1], path [pos+1..] });
}

/* Patterns as used by the regexp () efun and the normal unix
 *  like shells dont correspond exactly. This function
 *  maps the unix shell into the internal regexp model
 */
string fix_pattern (string pattern) {
int size;
    if (!(size = sizeof (pattern)))
        return pattern;
    if (pattern[0] == '*')
    {
        pattern = pattern [1..];
        size --;
    }
    else
    {
          pattern = "^" + pattern;   /* Force matching at begining of line */
        size ++;
    }
    if (pattern [size-1] != '*')
        pattern += "$"; /* Force matching at end on line */
    else
        pattern = pattern [..size-2];
    return pattern;
}


ACTION_FS ACTION_SECURE
cat_file(path) {
int i,size;
    CHECK_SECURE;
    if (!path) return 0;
    if (!(path = valid_read(path))) {
        notify_fail("Illegal path in \"cat\".\n");
        return 0;
    }
    size = file_size (path);
    if (size < 0) {
            write ("Invalid file.\n");
            return 1;
            }
    for (i = 0;i < (size/MAX_CHAR) + 1 ; i++) {
      call_out ("slow_cat",i*10,({path,i }));  
        /* 10 seconds between each listing */
      }
    return 1;
}

slow_cat (array path_count ) {
string words;

           words = grab_chunk(path_count[0], path_count[1]);
    OUTPUT_FILE->scat(words);
        if (find_call_out ("slow_cat") >= 0) write ("!PAUSE BREAK!");
}

grab_chunk(string name, int segment)
{
int size;
string words;
    size = file_size(name);
    if (size < 0) return 0;
    if (segment >= 0)
        words = grab_file(name, segment*MAX_CHAR,((segment+1)* MAX_CHAR)-1);
    else
    {
        words = grab_file(name, size - MAX_CHAR, size);
    }
    return words;
}

ACTION_FS ACTION_SECURE
tail_file(path) {
int size;
string words;

    if (path != "/bad.log") // naughty little hack for 'err' by Jenna, Mar 01
        CHECK_SECURE;
    if (!path) return 0;
    if (!(path = valid_read(path))) {
        notify_fail("Illegal path in \"tail\".\n");
        return 0;
    }
    words = grab_chunk(path, -1);
    if (OUTPUT_FILE->scat(words, -1, 20) < 0) {
        write("Bad file name.\n");
        return 1;
    }
    return 1;
}

