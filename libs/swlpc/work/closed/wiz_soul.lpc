/*
 * Try and figure out what they typed, then schedule
 */
ACTION_FS ACTION_SECURE
grep (strn) {
string path;
int i,recurse=0, listall = 0, verbose = 0;
array switches;

  CHECK_SECURE;
  notify_fail ("Grep syntax is: grep [-r] [-verbose] [-listall] "
        +"<search string> [<path>].\n");
  if ( !stringp (strn)) return ;

  switches = COMARGS -> split_args (strn, ({ "r","listall","verbose" }),
        ({ }));
  if (!sizeof(switches[0]) || !switches[0][0]) return 0;
  strn = switches[0][0];
  recurse = switches[1][0];
  listall = switches[1][1];
  verbose = switches[1][2];
  if (sizeof (switches[0]) == 2) {
          if (!(path = valid_dir_read(switches[0][1]))) {
            notify_fail("Illegal path in \"ls\". Path was "
                + switches[0][1] + ".\n");
            return 0;
            }
    }
    else path = pwd;
        LOG -> log ("MORE", capitalize (name)
            + " did a grep search of the path " + path + ".\n");
        write ("Searching for " + strn + " in /"+ path + "\n" +
          "Recurse is " + (recurse? "ON" : "OFF") +
          " and list all is " + (listall ? "ON" : "OFF") + ".\n");
        main_grep (strn, path,recurse,listall,verbose);
        return 1;
}

nosave int GrepFileCount;

main_grep(
        string pattern, 
        path, 
        int recurse, 
        int listall, 
        int verbose
        )
{
    array files, match ;
    int size,i;
    string pat;

    if (path[sizeof(path)-1..] == "*")
        path = path[..sizeof(path)-2];
    size = file_size (path);

    if (size >= 0)
    {  
        /* Was only one file */
        GrepFileCount ++;
        scan_file(pattern,path,listall,verbose);
        return 1;
    }
    if (verbose)
        write ("Starting scan of the directory " + path + "\n");
    if (size == EISDIR)
    { /* A simple directory, no regexp stuff in path */
        files = ls (path);
        files = files[0];  /* Ditch the file sizes,timestamps */
        for (i = sizeof (files); i --; )
        {
              if (file_size (path + files[i]) == EISDIR && !recurse) continue;
                call_out ("main_grep",20+i,pattern, path+files[i],
                        recurse,listall,verbose);
        }
            return 1;
    }
        /* We have (probably) a regexp to do */
    match = split_path (path);
    if (file_size (match[0]) != EISDIR) {
        write ("Invalid path /" + match[0] + "\n");
        return 1;
    }
    files = ls (match[0]);
    files = files[0];
    if (recurse)
    {
        for (i = sizeof (files);i--;)
        {
            if (file_size (match[0]+"/" + files[i]) == EISDIR)  
                /* A directory */
                call_out ("main_grep",20+i,pattern, match[0]+"/"
                        +files[i]+match[1],recurse,listall,verbose);
        }
    }
    pat = fix_pattern(match[1]);
    files = M_REGEXP->match(pat,files);
    for (i = sizeof (files);i--;)
    {
        if (file_size (match[0]+"/" + files[i]) != EISDIR) 
                /* Not a directory */
        {
            GrepFileCount ++;
            call_out ("scan_file",i,pattern, match[0]+"/"+files[i],
                listall,verbose);
        }
    }
    return 1;
}


scan_file(string pattern, string path,int show_failure, int verbose)
{
    int bottom,top,size,last=0,matches=0;
    string data;
    array mat;

    GrepFileCount --;
    if (!(path = valid_read("/"+path) ) ) return 0;

    size = file_size (path);
    for ( bottom = 0,top = 10240; bottom < size;)
    {
        if (top > size) top = size;
        data = grab_file(path,bottom,top);

        mat = M_REGEXP->match(pattern, [ data ]);
        if (mat && sizeof(mat))
        {
            if (verbose)
                write ("Found a match in /" + path + "\n");
            else
                write("/"+path+"\n");
            return;
        }
        bottom = top;
        top += 10240;
    }
    if (show_failure)
        write ("Not in /" + path + "\n");
    if (GrepFileCount == 0)        /* any more files left? */
    {
        /*write( "Grep done\n" );*/
    }
}

query_backups()
{
    return getenv("edit backups");
}

set_backups(int i)
{
    return setenv("edit backups", i);
}

int
backup_file( string filename )
{
string backupname = filename+"~";
    if ( query_backups() )
    {
        write( "creating backup of "+filename+" to "+backupname+"\n");
        if (filename[0..0] == "/")
        {
            filename = filename[1..];
            backupname = backupname[1..];
        }
        if (file_size(backupname) != ENOFILE)        /* backup exists? */
        {
            rm(backupname);
        }
        cp( filename, backupname );
        if ( file_size( filename ) != file_size( backupname ) )
        {
            write("ERROR! Could not create backup, file system problems?\n");
            return BACKUP_FAILED;        /* failure */
        }
        else
            return BACKUP_SUCCESS;        /* success */
    }
    return BACKUP_NONE;                /* no attempt */
}

query_cd_prompt()
{
    return getenv("cdprompt");
}

int ACTION_GD
action_unset( str )
{
    CHECK_SECURE;
    notify_fail( "unset <variable>\n");
    return myself->remove_store( str );
}

int ACTION_GD
action_set( str )
{
    array p;
    int arg;

    CHECK_SECURE;
    if ( !str || !stringp(str)) return 0;

    if (!(p = STRINGS->split_first(str, " ")))
    {
        notify_fail( "set <variable> <value>\n" );
        return 0;
    }
    arg = ARG_PARSER->make_args(p[1]);
    if (pointerp(arg))
        arg = arg[0];
    else
        arg = 0;
    setenv(p[0], arg);
    return 1;
}

nosave array PrivateStore = ({ 
/*        "alias", "old_store_name", "new_store_name", */
        "clone", "clone_message", "clonemsg",
        "dest", "destruct_message", "destmsg",
        "home", "home_message", "homemsg",
        "tin", "t_in", "tinmsg",
        "tout", "t_out", "toutmsg",
        "soul", "soulname", "soulname",
	"vi", "vi_more_message", "vimsg"
        });

getenv(string label, passwd)
{
int i;
int Private = 0;
(int|array|string) value;
string foo;
/* coax the label into the new preferred name */
/* temporary code, remove after Sept 1995 */
    for (i = 0; i < sizeof(PrivateStore); i += 3)
    {
        if (label == PrivateStore[i] || label == PrivateStore[i+1]
                || label == PrivateStore[i+2])
        {
            label = PrivateStore[i+2];
            Private = 1;
            if ( (value = myself->query_store( foo = PrivateStore[i] ))
                || (value = myself->query_store( foo = PrivateStore[i], 
                    myself->query_real_name()[0] ))
                || (value = myself->query_store( foo = PrivateStore[i+1] ))
                || (value = myself->query_store( foo = PrivateStore[i+1], 
                    myself->query_real_name()[0] ))
                )
            {
                myself->remove_store( foo );
                myself->remove_store( foo, myself->query_real_name()[0] );
                myself->add_store( label, value );
                if (pointerp(value)) value = value + ({ });
                return value;
            }
        }
    }
    value = myself->query_store( label, passwd );
    if (pointerp(value)) value = value + ({ });
    return value;
}

int
setenv(string label, value, passwd)
{
int i;
int Private = 0;
/* coax the label into the new preferred name */
    for (i = 0; i < sizeof(PrivateStore); i += 3)
    {
        if (label == PrivateStore[i] || label == PrivateStore[i+1])
        {
            label = PrivateStore[i+2];
            Private = 1;
            myself->remove_store( PrivateStore[i] );
            myself->remove_store( PrivateStore[i], 
                myself->query_real_name()[0] );
            myself->remove_store( PrivateStore[i+1] );
            myself->remove_store( PrivateStore[i+1], 
                myself->query_real_name()[0] );
        }
    }
    return myself->add_store(label, value, passwd);
}

