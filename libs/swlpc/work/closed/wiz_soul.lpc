// Jenna Dec 00
exec(str)
{
    string dir = "players/" + 
	this_player()->query_real_name() + "/open/";
    string on = dir + "exec-tmp";
    string fn = on + ".lpc";
    

    notify_fail("Usage: exec <code>\n");
    if (!str)
	return 0;
    if (file_size(dir) != -2)
    {
	notify_fail("You need an /open directory to use 'exec'.\n");
	return 0;
    }
    if (file_size(fn) > 0)
    {
	notify_fail("File "+fn+" already exists -- "+
	    "exec will not overwrite this file.\n");
	return 0;
    }
    if (index(str, "return ") == -1)
	str = "return " + str;
    if (index(str, ";") == -1)
	str += ";";
    write_file(fn, "inherit \"RO/Servers\";\n\nmy_fun() { " + str + "}");
    update_file("/"+on);
    call_out("execute_exec", 2, on, str);
    call_out("cleanup_exec", 4, fn);
    return 1;
}

execute_exec(on, str)
{
    object me = find_object(on);
    if (!me)
	write("Failed to execute: " + str + "\n");
    else
    {
	log_action("executes", str);
        call_feedback(me->my_fun(), [ "EXEC", str, 0 ]);
    }
}

cleanup_exec(fn)
{
    rm(fn);
}




