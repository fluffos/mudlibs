/*
 * Functions Follow:
 */
reset(arg)
{
    if (arg) return;
    if (myself) return;                /* no spoofing! once only. */

    myself = caller();                 /* get the cloner */
    if (!myself) return;               /* base object */
    name = myself->query_real_name();
    if (!name) return;
    Ticket = (-1);                     /* guaranteed invalid */
    last_object = 0;
}

query_soul() {  return this_object();  }
query_soul_type() {  return "wizard/wiz_soul";  }
query_myself() { return myself; }

get() {  return 1;  }
drop() {  return 1;  }

id(str)
{
    return str == "wiz_soul" || str == "soul" || str == "ND";
}

query_ids()
{
    return ({ "wiz_soul", "soul", "ND" });
}

(int|string)
short()
{
    string sdesc;

    if (!myself || !name) return 0;
    sdesc = getenv("soulname");
    if (sdesc && stringp(sdesc)) return sdesc;
    return "A heart of gold";
}

long()
{
    write( query_long() );
}

query_long()
{
    return ("A malleable magical soul.  Neat huh?  "
        +"Try \"set soul <blah>\".\n");
}

