soul_init(who)
{
    effsoul = who->query_soul("wizard/effects");
    if ( !objectp(effsoul) )
        tell_object( myself, "! You have no wiz_effects soul !\n" );
    else
        effsoul->set_owner(this_object());
}

int 
switchinto(str)
{
    object o;

    CHECK_SECURE;
    notify_fail("switch <what>.\n");
    if (!str) return 0;

    o = find_item(str);
    if (arrayp(o)) o = o[0];
    if (!o)
    {
        notify_fail("Unable to find "+str+".\n");
        return 0;
    }
    if (!o->query_npc())
    {
        notify_fail("switch to non-players only.\n");
        return 0;
    }
    
    switch_interactive(o);
    write("You have now switched bodies.\n");
    return 1;
}

/*
 * A command that confers extra powers on an object.
 * Works with SW security kernal.  Use it carefully!
 * syntax: trust item level (level is an integer)
 * kernal ensures you can't give out more power than you have.
 */
ACTION_GD ACTION_SECURE
trust(s)
{
    object o;
    string oname;
    int lev;
    string na;
    string oldsu;
    array allargs;
    
    CHECK_SECURE;
    na = name;
    if (!stringp(s)) return 0;

    allargs = explode(s, " ");
    if (sizeof(allargs) < 2) return 0;

    oname = allargs[0];
    lev = atoi(allargs[1]);

    if (sizeof(allargs) > 2) na = implode(allargs[2..], " ");

    o = find_item(oname);
    if (intp(o)) 
    {
        notify_fail("Can't find " + oname + "\n");
        return 0;
    }
    o = o[0];
    oldsu = show_su(o);
    set_uid_me(o, lev, na);
    write_stdout(oname + ": was suid " + oldsu + ", now " +
        show_su(o) + "\n");
    return 1;
}

/* show_su() used by lfun/trust() and lfun/stat() */
nosave string
show_su( object o )
{
string s;
    /*CHECK_SECURE;*/
    s = query_su_name(o);
    if (!s)
        s = "Game driver";
    s = s + "(" + query_su_level(o) + ")";
    return s;
}

/*
 * A command to set the uid bit on one of your files - when the
 * object is loaded, it'll be incremented one level, which is
 * enough to allow it to do file writes other than log() and
 * save_object().
 */
ACTION_FS ACTION_SECURE
su_file(s)
{
    array ex;
    string file, mode;
    int m;
    m = 0;
    string ret;

    CHECK_SECURE;
    notify_fail("suid file [on/off]\n");
    if (!s) return 0;
    if (!(ex = STRINGS->split_first(s, " "))) return 0;
    if (!(file = valid_write(file))) return 0;

    file = ex[0];
    mode = ex[1];
    if (mode == "on")
    {
        m = 1;
        ret = ("Enhancing");
    }
    else
        ret = ("Resetting");
    notify_fail("failed.\n");
    write_stdout(ret + " capabilities of " + file + "\n");
    return set_uid_file(file, m);
}

ACTION_FS
pwd()
{
    CHECK_SECURE;
    write_stdout("pwd : "+pwd+"\n");
    return 1;
}

ACTION_GD
stat(str)
{
object ob;
string it;
(string|int) arg;
(int|string|array) ret;
array cml;
    CHECK_SECURE;
    notify_fail(query_verb()+" what?\n");
    if (!name)
         return 0;
    cml = COMARGS -> split_args (str, ({ }), ({ }));
    if (!sizeof(cml[0]))
        return 0;
    it = cml[0][0];
    if (sizeof(cml[0]) > 1)
        arg = cml[0][1];
    str = it;
    it = lower_case(it);
#if 0
    ob = find_player(it);
    if (!ob) ob = find_living(it);        /* find_item() does this for us */
#endif
    if (!ob)
        ob = find_item(str);        /* don't lowercase it */
    if (intp(ob)) 
    {
        notify_fail("No such person/item exists at the moment.\n");
        return 0;
    }
    if (pointerp(ob))
        ob = ob[0];
    if (ob->is_player())
        log_action("stats", ob->query_real_name());
    write_stdout("Ob: " + file_name(ob) + "; " + show_su(ob) + "\n");
    ret = STAT_SERV->show_stats(ob, arg);
    if (stringp(ret) || pointerp(ret))
    {
        MORE->more(ret);
    }
    else
    {
        OLDCODE->add( "show_stats", explode(file_name(ob), "#")[0] );
        if (myself->query_real_name() == "hunter")        /* G */
            write("Notice: this object did not return it's show_stats info "
                +"as an array\n");
    }
    return 1;
}

array
show_stats()
{
    return ({ "No stats available on the wiz_soul." });
}

ACTION_PLAYER ACTION_SECURE
rmplayer (arg) 
{
    object pl;
    CHECK_SECURE;
    if (!arg) {
        notify_fail("remove who?\n");
           return 0;
        }
    arg = lower_case (arg);
    if (!(pl = PLAYER_SERV -> load_player(arg)))
    {
        write_stderr("No such player.\n");
        return 1;
    }
   if (query_su_level (pl) <= GOD) { /* They arnt logged in */
     set_uid_me (pl,GOD+1, arg);
     pl -> restart_player();
     }
   move_object(pl, environment(myself));
   pl -> add_stat ("pow",-(pl->query_stat ("pow")));
   pl -> ultimate_death();
   write_stdout("Power deathed the bugger.\n");
   return 1;
}

ACTION_GD ACTION_SECURE
disass(s) 
{
    object ob;
    string func, it, rest, oname;
    int lines, start, x;
    array allargs;


    CHECK_SECURE;
    notify_fail(query_verb()+" <ob> <func> [start] [nlines]\n");
    if (!s) return 0;

    allargs = explode(s, " ");
    if (sizeof(allargs) < 2) return 0;
    func = allargs[1];

    if (sizeof(allargs) == 2) rest = "";
    it = lower_case(allargs[0]);
    ob = find_item(allargs[0]);
    if (intp(ob)) 
    {
        notify_fail("No such person/item exists at the moment.\n");
        return 0;
    }
    if (pointerp(ob)) ob = ob[0];
    if (!"modules/disass"->function_exists(func, ob)) 
    {
        notify_fail(file_name(ob) + ": no function \"" + func + "\".\n");
        return 0;
    }

    if (sizeof(allargs) == 4)
    {
        start = atoi(allargs[2]);
        lines = atoi(allargs[3]);
    }

    if (x < 2) lines = 200;
    if (x < 1) start = 0;
#if 0
    if (ob->is_player())
                log_action("disass", ob->query_real_name());
#endif
    write("Ob: " + file_name(ob) + "func: \"" + func + "\"\n");
#if 0
    MORE->more(disassemble(ob, func, start, lines));
#endif
    return 1;
}

ACTION_GD
shut_down_game(arg) 
{
string str, tmp;
int time_left;
    CHECK_SECURE;
    if (wiz_level < SHUTDOWN) {        /* low level chars can shut it if its been up 5 hours */
        if (SHUT_DAEMON->query_uptime() < (5*3600)) {
            return 0;
            }
        }
    if (arg == "now") {        /* just in case - G */
        shutdown();
        return 1;
        }
    if (stringp(arg)) {
        if (arg == "stop" || arg == "halt") {
            SHUT_DAEMON->stop_shut();
            return 1;
        }
        time_left = atoi( arg );
        SHUT_DAEMON->shut( time_left );
        return 1;
    }
    return 0;
}


int ACTION_GD
clone(str) 
{
    object ob;
    string x;
    string template;
    string sht, nam;
    string what, who;
    object target;
    int count = 1;
    array switches;

    CHECK_SECURE;

    notify_fail("Clone what object?\n");
    if (!str) return 0;

    switches = COMARGS->split_args( str, ({ "q" }), ({ "n", "o" }) );
    what = switches[0][0];
    who = 0;
    if ( sizeof(switches[0]) == 3 )
    {
        if ( switches[0][1] == "onto" )
        {
            what = switches[0][0];
            who = switches[0][2];
          }
        else
        {
            notify_fail("clone <x> onto <y>\n");
            return 0;
        }
    }
    else if ( stringp(switches[2][1]) )
    {
        who = switches[2][1];
    }
    if ( stringp(switches[2][0]) )
    {
        count = atoi(switches[2][0]);
    }
    if (stringp(who))
    {
        target = find_item(who);
        if (intp(target))
        {
            notify_fail("Can't find "+who+" to receive "+what+"\n");
            return 0;
        }
        else
        {
            target = target[0];
        }
    }
    what = valid_read(what);
    if (!what) {
        write("Invalid file.\n");
        return 1;
    }
    while ( count > 0 )
    {
        x = catch( ob = clone_object(what));;
        if (x || !ob) 
        {
            write("Error Cloning \""+what+"\":  "+x+"\n");
            return 1;
        }
        catch (sht = ob->short());;
        catch (nam = ob->query_name());;
        if (!switches[1][0])
        {
            template = getenv( "clonemsg" );
            if (!stringp(template))
                template = "$w fetches something from another dimension.";
            template = STRINGS->format_string(
                        template, ({ "w", myself->query_name(),
                                "s", (sht?sht:"A Something"),
                                "n", (nam?nam:"Something") }) );
            if (!stringp(template))
                template = myself->query_name()+" fetches something from "+
                        "another dimension.";
    /* template wildcards :
                '$s' == object short()
                '$n' == object query_name()
                '$w' == wizards name
        */
            myself->checked_say(template+"\n");
        }
        if (target)                /* "clone X onto Y" ? */
        {
            move_object(ob, target);
        }
        else
        {
            if (ob->get()) {
                move_object(ob, myself);
            }
            else {
                move_object(ob, environment(myself));
            }
        }
        last_object = ob;        /* set "it" */
        count --;
    }
    tell_object(myself,"Ok.\n");
    return 1;
}

/*
 * 941215 Hunter             added support for desting wildcards
 * 950819 Hunter        added check for wiz_soul desting itself if
 *                        "closed/wiz_soul" cannot be loaded to replace it.
 */
ACTION_GD ACTION_SECURE
destruct_local_object(str) 
{
    (array|object) ob;
    string x;
    int Living;
    string msg;
    string template;
    string filename;
    int i;
    int many;

    CHECK_SECURE;

    notify_fail("Destruct what?\n");
    if (!str) return 0;

    if (str == "all") str = "*";
    ob = find_item(str);
    if (intp(ob))
        ob = find_item(lower_case(str));
    if (intp(ob)) 
    {
        notify_fail("No " + str + " visible.\n");
        return 0;
    }

    if ( !pointerp(ob) )
        ob = ({ ob });

    many = (sizeof(ob) > 1);

    for (i = 0; i < sizeof(ob); i ++)
    {
        filename = file_name(ob[i]);
        if ( ob[i] == this_object() && !find_object("closed/wiz_soul"))
        {
            write("!\n! Refused to dest your wiz_soul as the core wiz_soul "
                +"cannot be loaded!\n"
                +"! If I did dest your wiz_soul, you would be stuffed, even "
                +"if you tried to\n! 'soul on'\n!\n");
        }
        else if (many && ob[i]->id("ND"))
        {
            write("Refused to dest "+filename+" (\"ND\" id)\n");
        }
        else
        {
            msg = Catch(x = ob[i]->short());
            if (msg) {
                write("Err on ob->short - " + msg);
            }
            msg = Catch(Living = ob[i]->query_living());
            if (msg) {
                    write("Err on ob->query_living - " + msg);
            }
            template = getenv("destmsg");
            if (!stringp(template))
                template = "$s is disintegrated by $w";
            template = STRINGS->format_string(
                        template, ({ "w", myself->query_name(),
                        "s", (stringp(x)?x:"Something")
                }) );
            if (destruct(ob[i]))
            {
                myself->checked_say(template+"\n");
                if (Living)
                    log_action("dests",x);
                write("Destructed "+filename+" ok\n");
            }
            else
                write("Failed to dest "+filename+"\n");
        }
    }
    return 1;
}


// nosave ACTION_GD ACTION_SECURE
load(str)
{
    object env;
    string err;

    CHECK_SECURE;

    notify_fail("Load what?\n");
    if (!str) return 0;

    str = valid_read(str);
    if (!str) {
        write("Invalid file name.\n");
        return 1;
    }
    err = catch str->stupid_fucking_load_up_func();;
#if 0
    env = environment(myself);
    move_object(myself, str);
    move_object(myself, env);
#endif
    if (err) write("Loading error: "+err+"\n");
    else write("Ok.\n");
    return 1;
}

object mob_snoop;
ACTION_PLAYER ACTION_SECURE
snoop_on(str) 
{
    object target;

    CHECK_SECURE;
    if (wiz_level < CREATE)
	return 0;
    if (!str && mob_snoop) {
	destruct(mob_snoop);
	write("Ok.\n");
	return 1;
	}
    if (str) {
	target = present(str, environment(myself));
	if (target && target->query_npc()) {
	    if (mob_snoop) 
		destruct(mob_snoop);
	    mob_snoop = clone_object("closed/msnooper");
	    move_object(mob_snoop, target);
	    mob_snoop->go(myself);
	    return 1;
	    }
	}
    if (wiz_level < SNOOP) return 0;

    SET_HANDSHAKE(str)
    myself->remote_snoop(handshake);
    return 1;
}

