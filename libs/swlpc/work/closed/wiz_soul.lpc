/*
 * Shattered World's wiz-soul - heavily modified from the US original.
 *                              - some bits taken from The Tracer (Genesis).
 * by - geoff@bruce.cs.monash.edu.au   (Dredd)
 *    - mmcg@bruce.cs.monash.edu.au    (Gandalf)
 *    - zik@bruce.cs.monash.edu.au     (Billy)
 *    - rendell@bruce.cs.monash.edu.au (Rhys)
 *    - wigs@yoyo.cc.monash.edu.au     (Hunter)
 *    - paulbr@mullauna.cs.mu.oz.au    (Calthron)
 *    - twilight@yoyo.cc.monash.edu.au (Llati)
 * (not necessarily in the above order either! :) )
 *
 * This soul contains all wizard related functions that require
 * the object to have a suid level of greater than 0.
 * All other functions are in the wiz_effects.c soul,
 * in /obj/souls/ (which should be suid 0)
 *
 * Security Note:
 *   This object is trusted (potentially) to GOD. Be carefull what you
 *   #include into this file. Likewise, consider what security aspects
 *   you may change when you modify this file.
 *
 *   Also, be careful what you call from this object in processing commands.
 *   Other objects (such as STRINGS and COMARGS) have the potential to
 *   modify the command typed by a wizard. Those other objects should
 *   also be secure.
 */

/*
 * 921002 Hunter            added makefiles
 * 940615 Hunter            added SERVLIST support to find_item()
 * 940620 Hunter            added "clone X onto W"
 * 941215 Hunter            added wildcards to find_item()
 * 941215 Hunter            added support for desting wildcards
 * 950104 Hunter            added last_object ("it") to find_item()
 * 950109 Hunter            changed all call_other() to X->Y() or X->(Y)()
 * 950123 Hunter            added auto-backup ability to edits
 * 950202 Hunter            added prompt change on cd()
 * 950527 Hunter            added "me" to find_item()
 * 950528 Hunter            added remote object supprt to find_item()
 * 950529 Hunter            added support for rcall for call command.
 *                          moved sdesc from being global variable to local 
 *                            to short().
 * 950530 Hunter            cleaned up code. added comments to global stuff.
 *                          commented out 'muffled' global variable to see if 
 *                            anything breaks. :-). Added #include <errors.h>.
 * 950605 Hunter            added #include <types.h> 
 * 950618 Hunter            finally got rcall support for 'call' working.
 *                            added remote filesystem support for 'ls'
 * 950722 Hunter            added 'set' and 'unset' commands.
 * 950802 Ivory             fixed crappy 'update_object'.
 * 950808 Hunter            fixed 'trust' bug
 * 950809 Hunter            clone action: "it" set to last thing cloned
 * 950819 Hunter            removed 'cleanroom' action ('dest env:*' does the 
 *                            same thing). Added ACTION_* flags to commands.
 *                            Added strong type-checking where obviously needed.
 * 950819 Hunter            Added test to 'destruct' so that your wiz_soul will
 *                             dest itself if /closed/wiz_soul cannot be loaded.
 * 950915 Hunter        find_item(), and other code required by it,
 *                        shifted to separate file (/closed/find_item).
 * 950916 Hunter        removed all code dealing with 'muffled'. It doesn't
 *                        appear to be used anywhere (see note 950530).
 * 950930 Hunter        added display of '.message' to 'cd' command
 * 980702 Dredd         Couple of external program fixes.
 * 990611 Jenna		fill_in_extension to defaul to .lpc files (lazy Jen)
 * 000229 Jenna		Allowed snooping of monsters
 * 000802 Jenna		Altered vi, ed, more cautions
 * 001208 Jenna		Added 'exec' fun
 * 010220 Jenna		Added 'err'
 * 010719 Jenna		Moved in_room() from wiz_effects soul, since
 *			changes to command() left that without enough
 *			permissions to execute
 */

