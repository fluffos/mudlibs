/*
 * Virtual ls here - some dirs may want to return different
 * things depending on the uid & level of the caller.
 * Neat implementation, btw.
 */

virtual_ls( str ) 
{
    object ob;
    array ret;
    array vls;
    int i;
    int c;

    notify_fail( "vls <object>\n" );
    if (!str) return 0;

    ob = find_item(str);
    if (intp(ob)) return 0;

    vls = ob[0]->GetVirtualLS();        /* get Virtual filesystem */
    if (vls == 0)
    {
        notify_fail( "No virtual directory for "
        + (objectp(ob[0])?file_name(ob[0]):ob[0])+"\n");
        return 0;
    }
    ret = allocate(1 + sizeof(vls[0]));
    ret[0] = "vls : " + (objectp(ob[0])?file_name(ob[0]):ob[0])+"/";
    i = 0; c = 1;
    for (i = 0; i < sizeof(vls[0]); i ++)
    {
        if (stringp(vls[0][i]))
        {
            ret[c] = "  " + vls[0][i] 
                + ("modules/disass"->function_exists( "GetVirtualLS", vls[1][i] )?"/":"");
            c ++;
        }
    }
    ret = ret[..c-1];
    MORE->more(ret);
    return 1;
}

