/*
 * needs to be cleaned up - with a sensible syntax added for multiple
 * args. *sigh*.
 * ACTION_SECURE because objects being called may check wiz_level of
 * caller.
 */
int ACTION_FS ACTION_SECURE
call(str) 
{
    string with, what, item, func_name, vb;
    object ob;
    int result; /* could be anything - not just int */
    int callmany = 0;        /* flag set if we are doing a callall */
    int callcount;        /* count of objects to call */
    int moveresult;        /* flag if the result of the call should be moved */
                        /* onto the wizard */
    int i;
    int call_remote;
    int powercall;
    array allargs;
    array ret;
    array printme = ({ });        /* info to be printed */

    myself->notify_fail("format: call <item> <function> [args].\n");
    CHECK_SECURE;
    if (!str) return 0;

    allargs = explode(str, " ");
    if (sizeof(allargs) < 2) return 0;

    item = allargs[0];
    with = allargs[1];

    if (sizeof(allargs) > 2) what = implode(allargs[2..], " ");

    vb = query_verb();
    if (vb == "call!" || vb == "callall!") powercall = 1;
    if (vb == "callall" || vb == "callall!") callmany = 1;

    ob = find_item(item);
    if ( intp(ob) )
    {
        notify_fail("Unable to find "+item+".\n");
        return 0;
    }

    notify_fail("Call failed: tail /bad.log for error.\n"); /* Jenna 2000 */

    if (!pointerp(ob))
        ob = ({ ob });                /* coax ob into an array */
    if (callmany)
        callcount = sizeof(ob);
    else
        callcount = 1;
    for (i = 0; i < callcount; i ++)
    {
        call_remote = (stringp(ob[i]) && ob[i][0..1] == "//");
        if ( !call_remote )
            func_name = "modules/disass"->function_exists(with, ob[i]);
        if ( call_remote || (func_name && sizeof(func_name) > 0) )
        {
            log_action("called",str);
                result = eval_func(ob[i], with, what, "call_feedback", 
                ({ ob[i], with, powercall }) );
#if 0
                ret = DUMP->dump(result,10, 0, -1);
                if (stringp(ret))
                    ret = explode(ret, "\n");
                ret[0] = "Returned: "+ret[0];
                printme += ret + ({ "From "+ file_name(ob[i])+"->"
                +with+"(...)" });
#endif
        }
        else
        {
            write("Function does not exist (Effective return value 0).\n");
        }
    }
    return 1;
}

call_feedback( ret, info )
/* info is: ({ objectname, funcname }) */
{
array result;
    result = DUMP->dump(ret,10, 0, -1);
    if (stringp(result))
        result = explode(result, "\n");
    result[0] = "Returned: "+result[0];
    result = ({ "" }) + result + ({ "From "+ info[0]+"->" +info[1]+"(...)" });

#if 0
    if (this_player())
        MORE->more( result );
    else
#endif
        tell_object( myself, implode(result, "\n")+"\n");


    if (info[2] && objectp(ret))
    {
        move_object(ret, myself);
    }
}

rcall_back( foo )
{
    tell_object( myself, "Got Return Value for remote call.\n");
}

// Moved from wiz/effects (where it no longer worked) 
// by Jenna, July 2001
int ACTION_PLAYER ACTION_SECURE
in_room(str)
{
    object place, old_room;
    string cmd, verb, room;
    array allargs;

    if (this_player() != myself)
	return 0;

    notify_fail("in <location> <command>\n");

    if (!str) return 0;

    allargs = STRINGS->split_first(str, " ");
    if (sizeof(allargs) < 2) return 0;
    room = allargs[0];
    cmd = allargs[1];
    verb = query_verb();
    place = find_item(room);
    if (pointerp(place))
        place = place[0];
    if (!place) place = find_living(room);
    if (!place) 
    {
        write("Invalid location.\n");
        return 1;
    }
    old_room = environment(myself);
    if (verb == "in") move_object(myself, place);
    else
	move_object(myself, environment(place));
    command(cmd, myself);
    move_object(myself, old_room);
    return 1;
}

/* no caller level check - this is to CUT DOWN wiztoys :) */

/* Called from another soul to check if we are busy */

query_busy() {
/*    if (in_editor(myself)) return "editing"; */
    return myself->query_caution();
}


/* ask another soul if they are busy, print a message if so.  Returns 0
 * if this is a retry of the same player within CONFIRM_TIME HBs,
 * in any case, if the other player is busy, it prints their caution
 * message.
 */

check_if_busy(ob) {
    object theirsoul;
    string their_reason;

    if (!ob)                /* sanity check */
        return 0;

    theirsoul = ob->query_soul(query_soul_type());

    if (!theirsoul)        /* soul off can't be editing :) */
        return 0;

    their_reason =  theirsoul->query_busy();

/* If they aint busy, we clear out the pending player (so next time
 * he is queried, we are warned again).
 */
    if (!their_reason) {
        busy_player = 0;
        busy_check_time = 0;
        return 0;
        }

/*
 * See if this is a confirm
 */
    if (ob == busy_player) {
        if (busy_check_time + CONFIRM_TIME > (myself->query_age())) {
            write("Ok - but they are still busy " + their_reason + ".\n");
            busy_player = 0;
            busy_check_time = 0;
            return 0;
            }
        write("Your last \"confirm\" on " + ob->query_real_name() +
              " timed out.\n");
        }
/*
 * Different player or busy check timed out - print the message.
 */
     busy_player = ob;
     busy_check_time = myself->query_age();
     write(ob->query_real_name() + " is busy " + their_reason + ".\n");
     write("To confirm your command, try again within " + CONFIRM_TIME +
           " seconds.\n");
     return their_reason;
    }


/* Gandalf the Nasty */

snoop_trace(str) 
{
  int i, p;
  object scan_ob,ob;
  array on_list, by_list,people;

    p = 0;

  CHECK_SECURE;
  if (mob_snoop)
	write("You are snooping "+mob_snoop->describe_me()+".\n");
  if (str == "*") {
      array o = users();
      for (i = 0; i < sizeof(o); i++)
          if (o[i]->query_tracked())
              write(o[i]->query_real_name() + " ");
      write("Ok.\n");
      return 1;
      }

  if (str)
  {
      if (!(ob = find_living(lower_case(str))))
      {
          write ("No such player.\n");
          return 1;
      }
      if (!(ob = query_snoop(ob)))
          write (str + " is not snooped.\n");
      else
          write (str + " is snooped by " + ob->query_real_name() + ".\n");
      return 1;
  }

  people = users();
  on_list = allocate(sizeof(people)); /* array of who they snoop */
  by_list = allocate(sizeof(people)); /* who snoops them */

  /* thank God (dredd) for index() - makes this much faster... */
  for (i = 0; i < sizeof(people); i ++)
  {
       scan_ob = people[i];
       ob = query_snoop(scan_ob);
       if (ob) {
           by_list[i] = index(people, ob) + 1; /* 0 = not snooped */
           on_list[by_list[i] - 1] = i + 1;
           }
  }

  /* Now print out the snoop traces. */
  for (i=0; i<sizeof(people); i++) {
      if (!by_list[i]) {  /* top of a sequence, if snooping at all */
          if (on_list[i]) { /* snooping - traverse the on_list */
              int j;
              j = i + 1;
              p = 1;        /* flag - we found one */
              while (j) {
                  int tmp;
                  write(people[j-1]->query_real_name()); /* our name */
                  tmp = on_list[j - 1]; /* save who we snoop */
                  on_list[j - 1] = 0;   /* avoid loops later */
                  if (tmp) {
                      write(" -> ");
                      by_list[tmp - 1] = 0; /* dont terminate prematurely */
                      }
                  else
                      write("\n");
                  j = tmp; /* and go print his trace */
                  }
              }
           } /* (!by_list - i.e. trace) */
  } /* for i in people */
  if (!p)
      write("No snoops found.\n");
  return 1;
}

/*
 * Send a note to someone's what-happened buffer.
 */

/*
 * More stuff - hunter and calthron
 */

more_file(path)
{
    int ret;
    string msg;
	
    if (this_player() != myself) return;
    if (!path) return;
    if (!(path = valid_read(path))) {
        notify_fail("Illegal path in \"more\".\n");
        return 0;
    }

    path = fill_in_extension(path);

    ret = file_size(path);
    if (ret == ENOFILE )
    {
        notify_fail("The file " + path + " doesn't exist.\n");
        return 0;
    }
    if (ret == EISDIR)
    {
        notify_fail("You cannot more a directory.\n");
        return 0;
    }

    if (myself->query_caution())
    {
        notify_fail("Use more only from the command line!\n");
        return 0;
    }

    msg = getenv("vimsg");
    if (msg)
	myself->checked_say(myself->query_name() + " " + msg+".\n");

    this_player()->push_caution(MORE_CAUTION);
    more_file = path;

    Ticket = random(1000000) + 1;

    MORE->more(Ticket, "more_done");
    return 1;
}

more_done()
{
    Ticket = (-1);
    myself->pop_caution();
    more_file = "";
    tell_object(myself, "Ok.\n");
}

/* Line oriented file read.  Will go away */

request_page(tckt, strt, fend) {
  array hack, temp;

  if (tckt != Ticket && tckt)
    return ({ 0 , ({ "" }) });
  if (strt > fend)
  {
    int t;
    t = fend;
    fend = strt;
    strt = t;
  }
  /* temp hack to fix stuff */
  hack = explode(grab_file(more_file), "\n");
  temp = hack[strt..fend];
/*  temp = grab_file(more_file, strt, fend);
  if (stringp(temp))
    return ({ Ticket = random(1000000), explode(temp, "\n") }); */
  if (pointerp(temp))
    return ({ Ticket = random(1000000), temp });
  tell_object(myself, "File " + more_file + " does not exist.\n");
  return ({ 0 , ({ "" }) });
}

/*
 * String-oriented file access request.  strt, fend are
 * character locations.
 */

request_file_chunk(tckt, strt, fend) {
  string hack;

  if (tckt != Ticket && tckt)
    return ({ 0 , ({ "" }) });
  if (strt > fend)
  {
    int t;
    t = fend;
    fend = strt;
    strt = t;
  }
  if (strt < 0)
    strt = 0;
#if 0
  if (fend >= file_size(more_file) && file_size(more_file) > 0)
    fend = 0;
#endif
  hack = grab_file(more_file, strt, fend);
  if (stringp(hack))
    return ({ Ticket = random(1000000) + 1, hack });
  tell_object(myself, "File " + more_file + " does not exist.\n");
  return ({ 0 , ({ "" }) });
}

more_size(num) {
  int result;
  result = (num * 100) / file_size(more_file);
  if (result < 0)
    return 0;
  if (result > 100)
    return 100;
  return result;
}

query_more_size() { return file_size(more_file); }

