ACTION_FS ACTION_SECURE
rmlog(str)
{
    CHECK_SECURE;
    if (!log) log = "/log/"+myself->query_real_name();
    if (!str) return simple_remove_file("/log/"+log);
    return simple_remove_file("/log/" + str);
}

ACTION_FS ACTION_SECURE
rmerr(str) {
    CHECK_SECURE;
    if (!log) log = myself->query_real_name();
    if (!str) return simple_remove_file("/log/" + log + ".err");
    return simple_remove_file("/log/" + str + ".err");
}

ACTION_FS ACTION_SECURE
rmrep(str) {
    CHECK_SECURE;
    if (!log) log = myself->query_real_name();
    if (!str) return simple_remove_file("/log/" + log + ".rep");
    return simple_remove_file("/log/" + str + ".rep");
}

/* required by ACTION_FS commands */
nosave simple_remove_file(string str) 
{
    if (!(str = valid_write(str))) return 0;
    if (rm(str))
    {
        LOG_FILESYSTEM( str, "deleted", 0 );
        write("Removed "+str+"\n");
    }
    else write("Failed to remove " + str + ".\n");
    return 1;
}


ACTION_FS ACTION_SECURE
action_remove_file(str)
{
    array switches;
    int recurse;

    CHECK_SECURE;
    notify_fail ("Remove [-r] file[s]\n");
    if (!str) return;

    switches = COMARGS -> split_args (str, ({ "r" }), ({ }));
    recurse = switches[1][0];
    str = switches[0][0];
    str = compute_path(str);
    return remove_file(str, recurse);
}

/* required by ACTION_FS commands */
/*SPLIT*/
nosave remove_file(string str,int recurse)
{
    int size,i;
    array file,match;

    size = file_size (str);
    if (size >= 0) return simple_remove_file ("/" + str);

    /* Got a directory remove */
    if (size == EISDIR)
    { 
        string nstr;
        if (!recurse) {
            write("You cant remove directories using rm, except when "
                +"the -r flag is used. Single directories can be removed "
                +"using rmdir.\n");
            return 1;
        }
        if (wiz_level < SENIOR && sizeof (file))
        {
            write ("Only wizards of level " + SENIOR
                + " can do file operations on more than one file at once.\n");
            return 1;
        }
        file = ls (str)[0];
        nstr = str + "/";
        for (i = 0 ; i < sizeof (file);i ++)
            remove_file (nstr +file[i],recurse);
        if (rmdir(str))
            write ("Removed directory " + str + "\n");
        else
            write ("Could not remove the directory " + str + "\n");
        return 1;
    }

    match = split_path (str);
    file = ls (match[0]);
    file = file[0]; /* Just the file names */
    if (recurse)
    {
        for (i = sizeof (file); i--; )
        {
            if (file [i][sizeof(file[i])-1] == '/')
            { /* A directory */
                remove_file (match[0] + "/" + file[i] + match[1], recurse);
            }
        }
    }
    match [1] = fix_pattern (match[1]);
    file = M_REGEXP->match(match[1],file); /* Files is 1D now */
    if (!sizeof(file))
    {
        write ("No matching files.\n");
        return 1;
    }
    str = match[0] + "/";
    for (i=0; i< sizeof (file); i++ )
    {
        if (file[i][sizeof (file[i])-1] != '/')   /* not a directory */
            simple_remove_file ( "/" +str + file[i]);
        else {
            if (recurse)
                remove_dir ("/" +str + file[i]);
            else
                write ("Directory /" + str + file[i] + " ignored.\n");
        }
    }
    return 1;
}

ACTION_FS ACTION_SECURE
make_dir(str)
{
    CHECK_SECURE;
    if (!(str = valid_write(str))) /* like making a file; no slash */
        return 0;
    if (file_size (str) == EISDIR)
    {
        write ("The directory  " + str + " already exists!\n");
        return 0;
    }
    mkdir(str);
    LOG_FILESYSTEM( str+"/", "made", 0 );
    write ("Made new directory " + str + "\n");
    return 1;
}

ACTION_FS ACTION_SECURE
remove_dir(str) 
{
array files;

    CHECK_SECURE;
    if (!(str = valid_write(str))) return 0;
    if (file_size (str) != EISDIR) {
            write (str + " is not a directory.\n");
            return 1;
            }
    files = ls (str);
    if (sizeof (files[0])) {
            write ("You can not remove a directory with files in it.\n");
            return 1;
            }
    if (rmdir(str))
    {
        LOG_FILESYSTEM( str+"/", "deleted", 0 );
        write("Removed /"+str+"\n");
    }
    else write("Failed to remove /" + str + "\n");
    return 1;
}

/* Clean the command up a bit, and normalise it */
ACTION_FS ACTION_SECURE
action_copy_file(str)
{
string src, dst;
array args;
int x;
    CHECK_SECURE;
    notify_fail("Copy what to where?\n");
    if (!stringp(str))
        return 0;
    args = explode (str," ");
    if ((x = sizeof (args)) == 2) {
        src = args[0];
        dst = args[1];
    }
    else if (x ==1) {
        src = args[0]; 
        /* Perhaps should also set dst = 0, but not necessary */
    }
    else
        return 0;
    src = compute_path (src);
    if (dst) {
        dst = compute_path(dst);
    }
    else {
        dst = remove_trailing_slash( pwd );
    }
    return copy_file (src,dst);
}

/* required by ACTION_FS commands */
/*SPLIT*/
copy_file (src, dst)
{
int x, s_size,d_size;
array match,files;
    s_size = file_size (src);
    d_size = file_size (dst);

    /* Do the case of a single simple file copy */
    if (s_size >= 0) {
        if (d_size == EISDIR) { /* dst is a directory */
            match = split_path (src);
            dst += "/" +  match[1];
        }
        simple_copy (src,dst);
        return 1;
    }
    if (wiz_level < SENIOR) {
        write ("Only wizards of level " + SENIOR
                + " can do file operations on more than one file at once.\n");
        return 1;
    }
    /* Directory copies. Copies the directory recursively,
     * down the whole tree */
    if (s_size == EISDIR && d_size == EISDIR) {
        if (index (dst,src) >= 0) {
            write ("You cant set up recursive loops! Thats BAD!!!\n");
            return 1;
        }
        files = ls (src);
        files = files[0];
        if (src[sizeof(src)-1] != '/')
            src = src + "/";
        if (dst[sizeof(dst)-1] != '/')
            dst = dst + "/";
        for (x = 0; x < sizeof (files) ; x++ )
        {
            if (files[x][sizeof (files[x])-1] == '/')  {
                        /* Need a bloody leading slash */
                make_dir ("/" + dst + files[x]);
            }
            copy_file (src + files[x], dst + files[x]);
        }
        return 1;
    }
    /* regexp matching. DOESNT (and shouldnt!) do recursive copies */
    if (d_size != EISDIR) {
        write ("You must specify a directory for the destination.\n");
        return 1;
    }
    match = split_path (src);
    match [1] = fix_pattern (match[1]);
    if (file_size (match[0]) == ENOFILE) {
        write ("Invalid source path.\n");
        return 1;
    }
    files = ls (match[0]);
    files = M_REGEXP->match(match[1],files[0]); /* Files is 1D now */
    if (!sizeof (files)) {
        write ("No matching source file.\n");
        return 1;
    }
    src = match[0] + "/";
    dst = dst + "/";
    for (x=0; x< sizeof (files); x++ ) {
        if (files[x][sizeof (files[x])-1] != '/' )
            simple_copy (src + files[x], dst + files[x]);
    }
    return 1;
}

/* required by ACTION_FS commands */
/*SPLIT*/
simple_copy (string src, string dst)
{
    if (!(src = valid_read("/" + src))) {
        write("Illegal source file\n");
        return 1;
    }
    if (!(dst = valid_write("/" + dst))) {
        write("Illegal destination\n");
        return 1;
    }
    if ((src != dst) && cp(src, dst)) 
    {
        LOG_FILESYSTEM( dst, "created", "copied from "+dst );
        write("Copied "+src+" to "+dst+"\n");
    }
    else
        write("Failed to copy "+src+" to "+dst+".\n");
    return 1;
}

 /* Clean the command up a bit, and normalise it */
ACTION_FS ACTION_SECURE 
action_rename_file(str) 
{
    string src, dst;
    array args;
    int x;

    CHECK_SECURE;

    notify_fail("Move what to where?\n");

    if (!stringp(str)) return 0;
    args = explode (str," ");

    if ((x = sizeof (args)) == 2) 
    {
        src = args[0];
        dst = args[1];
    }
    else if (x ==1) 
    {
        /* Perhaps should also set dst = 0, but not necessary */
        src = args[0]; 
    }
    else return 0;

    src = compute_path (src);
    if (dst) 
    {
        dst = compute_path(dst);
    }
    else 
    {
        dst = pwd;
        dst = remove_trailing_slash( pwd );
    }

    return rename_file (src,dst);
}


ACTION_FS ACTION_SECURE
nosave rename_file (src, dst) 
{
    int x, s_size,d_size;
    array match,files;

    s_size = file_size (src);
    d_size = file_size (dst);

    /* Do the case of a single simple file rename */
    if (s_size >= 0) 
    {
        /* dst is a directory */
        if (d_size == EISDIR) 
        { 
            match = split_path (src);
            dst += "/" +match[1];
        }
        simple_rename (src,dst);
        return 1;
    }

    if (wiz_level < SENIOR) {
        write ("Only wizards of level " + SENIOR 
                + " can do file operations on " +
                "more than one file at once.\n");
        return 1;
    }

        /* Directory renames. */
        if (s_size == -2 && d_size < 0) {  
        /* Could be an invalid destination, but simple_rename will 
         * pick that up */
                simple_rename (src, dst);
                return 1;
        }

        /* regexp matching. DOESNT (and shouldnt!) do recursive renames */
        if (d_size != EISDIR) {
                write ("You must specify a directory for the destination.\n");
                return 1;
                }
        match = split_path (src);
        match [1] = fix_pattern (match[1]);
        if (file_size (match[0]) == ENOFILE) {
                write ("Invalid source path.\n");
                return 1;
                }
        files = ls (match[0]);
        files = M_REGEXP->match(match[1],files[0]); /* Files is 1D now */
        if (!sizeof (files)) {
                write ("No matching source file.\n");
                return 1;
                }
        src = match[0] + "/";
        dst = dst + "/";
        for (x=0; x< sizeof (files); x++ ) {
                        if (files[x][sizeof (files[x])-1] != '/')
                    simple_rename (src + files[x], dst + files[x]);
                        }
        return 1;
}

/* required by ACTION_FS commands */
/*SPLIT*/
nosave simple_rename (string src, string dst)
{
    if (!(src = valid_read("/" + src))) 
    {
        write("Illegal source file\n");
        return 1;
    }
    if (!(dst = valid_write("/" + dst))) {
        write("Illegal destination\n");
        return 1;
    }
    if ((src != dst) && rename(src, dst)) 
    {
        write("Renamed "+src+" to "+dst+"\n");
        LOG_FILESYSTEM( src, "created", "moved from "+dst);
    }
    else write("Failed to rename "+src+" to "+dst+".\n");
    return 1;
}

ACTION_GD ACTION_SECURE
snapshot(arg) 
{
    array ex;
    string str, dest;
    object ob;

    CHECK_SECURE;
    notify_fail("snapshot <object> [ <destination of .o file> ]\n");
    if (!arg) return 0;
    if (!(ex = STRINGS->split_first(arg, " "))) 
    {
        str = arg;
            dest = "open/snapshot";
        }
    else 
    {
        str = ex[0];
            dest = compute_path(ex[1]);
        }
    ob = find_item(str);
    if (intp(ob)) {
        notify_fail("Unable to find "+str+".\n");
        return 0;
    }
    ob = ob[0];
    if (ob->query_no_external_save()) {
        notify_fail("object \""+arg+"\" cannot be dumped to a .o file\n");
        return 0;
    }
    save_object(dest, ob);
    write(file_name(ob) + " dumped to " + dest + ".o\n");
    return 1;
}

ACTION_GD 
update_object(str)
{
    /* changes to this and update_file()  ivory 950802 */
    CHECK_SECURE;

    if (!str) str = "env";
    if (update_file(str)) write("Done.\n");

    return 1;
}


int
update_file(str)
{
(object|array) ob;  
object bag;
array inv;
int item;
string x;
    ob = find_object( compute_path( str ) );
    /* check so that a "wiz_soul" in the current directory will be found
     * before the wiz_soul in your inventory.
     */
    if(intp(ob))   
        ob = find_item(str);
    if (intp(ob)) 
    {
        tell_object(myself,"No such object: "+str+"\n");
        return 0;
    }
    if(objectp(ob)) ob = ({ ob });
    str = file_name(ob[0]);
    if( is_cloned( ob[0] )) {
        tell_object(myself,"Not updating a clone.\n");
        return 0;
        }
    tell_object(myself,"Attempting to update : "+file_name(ob[0]) + "\n");
    /* save everything in the room first... */
    bag = clone_object("std/object");
    bag -> add_property ("CONTAINER",0,100000);
    inv = contents(ob[0]);
    for (item = 0; item < sizeof(inv); item++)
        move_object(inv[item], bag);
    destruct(ob[0]);        /* this will take .1 secs.. */
    ud_where = str;
    ud_bag = bag;
    call_out("move_back", 0.5,inv);
    return 0;
}

move_back(inv)
{
string x;
int item;
    /* need to reload ob after destructing it! */
    /* destructs take time! */
    x = catch ud_where->stupid_fucking_load_up_func();;
    if (x) {
        tell_object(myself,"Reload failed: "+x+".\n");
        return 0;
    }
    tell_object(myself, "Reloaded "+ud_where+"\n");
    for (item = 0; item < sizeof(inv); item++)
        move_object(inv[item], ud_where);
    destruct(ud_bag);
    return 1;
}

/* makefile added by Hunter, 2nd Oct 1992 */
ACTION_FS ACTION_SECURE
make_file(str) {
array files;
int i;
string t;
    CHECK_SECURE;
        if (!str)
                str = "makefile";
            if (!(str = valid_read(str))) {
                notify_fail("Illegal path in \"make\".\n");
                return 0;
            }
        files = SCRIPTS->filterscript(grab_file(str));
        for (i = 0; i < sizeof(files); i ++)
        {
                t = strip_whitespace(files[i]);
                if ((t[0..0] != "#") /* not a remark */ &&
                        (sizeof(t) >= 1))
                        call_out("update_file", 0,t);
        }
        call_out("make_ud",0,0);
        return 1;
}

