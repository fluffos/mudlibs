/*
 * Snoop object for the dot command in the wiz soul.
 * By Billy / Zik - zik@bruce.cs.monash.edu.au
 * Transplanted to /closed on general principle - G :)
 */

object Subject;
object Listener;
int EnvirMode;
int FollowMode;


reset(NotFirst)
{
if (!NotFirst)
    {
    enable_commands();
    }
}


set_subject(Sub, Envir, Follow)
{
Subject = Sub;
FollowMode = Follow;
EnvirMode = Envir;
follow();
}


change_subject(Sub)
{
Subject = Sub;
follow();
}


set_listener(List)
{
Listener = List;
}


query_status()
{
string Ret;
if (EnvirMode)
    Ret = "at";
else
    Ret = "to";
return Ret + " " + file_name(Subject);
}


get()
{
return 0;
}

drop()
{
return 0;
}

id(str)
{
return str == "snooper" || str == "ND";
}


catch_tell(str)
{
if (!Listener)
    destruct(this_object());
else
    {
    tell_object(Listener, "*" + str);
    if (FollowMode)
        follow();
    }
}


follow()
{
if (EnvirMode)
    {
    if (!Subject)
    	{
        destruct(this_object());
        return;
        }
    	
    if (environment(Subject) != environment(this_object()))
        {
        move_object(this_object(), environment(Subject));
        if (!Listener)
            destruct(this_object());
        else
            tell_object(Listener, "*--> " + file_name(Subject) + " moved to " + 
                        file_name(environment(Subject)) + ".\n");
        }
    }
else
    {
    if (Subject != environment(this_object()))
        {
        if (!Subject)
            {
            destruct(this_object());
            return;
            }
        move_object(this_object(), Subject);
        if (!Listener)
            destruct(this_object());
        else
            tell_object(Listener, "*--> Moved to " + file_name(Subject) + ".\n");
        }
    }
}


query_destruct()
{
if (Listener && Listener != this_player())
    tell_object(Listener, "* HELP! I am being destructed by " + 
                   capitalize(this_player()->query_real_name()) + "!\n");
}
