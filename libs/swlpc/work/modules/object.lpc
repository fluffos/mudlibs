#if 0
/*
 * LPC / C interface
 *
 * save/restore objects to a file
 *
 */
#endif

int handle;

reset()
{
    int x;

    handle = load_shared_object("object.so");
}

query_destruct()
{
    unload_shared_object(handle);
}

int save_object(object ob, string file)
{
    return ext_c_call(handle, "save_object", ob, file);
}

int restore_object(object ob, string file)
{
    return ext_c_call(handle, "restore_object", ob, file);
}


