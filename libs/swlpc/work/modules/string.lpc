int handle;

reset()
{
    int x;

    handle = load_shared_object("modules/string.so");
}

query_destruct()
{
    unload_shared_object(handle);
}

string capitalize(string str)
{
    return ext_c_call(handle, "lpc_capitalize", str);
}

string lowercase(string str)
{
    return ext_c_call(handle, "lpc_downcase", str);
}

int atoi(string str)
{
    return ext_c_call(handle, "lpc_atoi", str);
}

real ator(string str)
{
    return ext_c_call(handle, "lpc_ator", str);
}

array sscanf(string str, string fmt)
{
    return ext_c_call(handle, "lpc_sscanf", str, fmt);
}

int index(string str, int char, int skip)
{
}

array index_all(string str, int char)
{
}

array split(string str, string pat, int max)
{
    return ext_c_call(handle, "lpc_split", str, pat);
}

string join(array strarr, string del)
{
    return ext_c_call(handle, "lpc_join", strarr, del);
}

