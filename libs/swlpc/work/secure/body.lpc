string	desc_hook;

/*
 * set it to 0 (not x).
 */

set_is_guest(x) {
	is_guest = 0;
	return 1;
	}

query_guest() 
{
/* "guest" is always a guest */
    if (query_real_name() == "guest")
	return 1;
    else
	return is_guest;
}

query_no_external_save(ob) 
{
    if (ob && (query_su_level(ob) >= GOD)) return 0;
    return 1;
}

query_no_external_restore(ob) 
{
    if (/* ob && */ (query_su_level(ob) < GOD)) { /* I wanna know if this fucks up */
        illegal_patch("Restore to body.lpc");
        return 1;
	}
    return 0;
}

/* Last time they actually typed 'save' - can use this (sometimes) to
 * work out who is using game crashing bugs to save their items.
 */

int real_save_time = 0;

save_character() 
{
    real_save_time = time();
    save_me();
    write("Ok.\n");
    return 1;
}

/* This makes sure the amount we claim to be carrying is correct. */
nosave int last_money;

array alii;

reset(arg) {
    if (arg) {
	if (query_wiz()) return;
	/* These occasionally get screwed up.  Don't ask me why. */
	if (ghost == 1 /* name == NAME_OF_GHOST */) {
	    ghost = 1;
	    msgin = "drifts around";
	    msgout = "blows";
	} else {
	    ghost = 0;
	    msgin = "arrives";
	    msgout = "leaves";
	}
	recalc_carry();	    /* Make sure we're carrying the right amount. */
	return;
    }
    /*
     * With arg = 0 this function should only be entered once!
     */
    enable_commands();
    if (myself) return;
#if 0
    if (creator(this_object())) {
        illegal_patch("cloned player.lpc");
	dest_player();
	return;
    }
#endif
    level = -1;
    name = "logon";
    cap_name = "Logon";
    msgin = "arrives"; msgout = "leaves";
    add_store("t_in", "arrives in a puff of smoke");
    add_store("t_out", "disappears in a puff of smoke");
    title = "the title-less";
    if (!alii)
	alii = [ ];
    gods = [NO_GOD];
    /* treasure = 0; */
    gender = 0;
}

set_god(al) 
{
	if (!al) return;
	if (lower_case(al) == lower_case(NO_GOD)) return;
	if (query_gods(al)) return;
    if (gods[0] == NO_GOD)
	    gods[0] = al;
	else
		gods = gods + [ al ];
    USER_SERV->update_who(this_object());
	return 1;
}

query_gods(name)
{
    if (!name) return gods;
	if (my_index(gods, name) > -1) return 1;
	return 0;
}

remove_god(name)
{
	int i;

    if (!name) return;
	if (lower_case(name) == lower_case(NO_GOD)) return;
    if ((i = my_index(gods, name)) < 0) return;
	if (sizeof(gods) == 1)
		gods[0] = NO_GOD;
	else if (i == 0)
		gods = gods[1..];
	else
		gods = gods[..i-1] + gods[i+1..];
    USER_SERV->update_who(this_object());
    return 1;
}

my_index(arr, elt)
{
	int i;
	for (i = 0; i < sizeof(arr); i++)
        if (lower_case(arr[i]) == lower_case(elt)) return i;
	return -1;
}

show_gods()
{
	int i;
	string ret;

	if (!gods) return;
	for (i = 0; i < sizeof(gods); i++)
		if (i == 0) ret = gods[0];
		else ret += ", "+gods[i];
	return ret;
}

short() 
{

	int	i;

	string	Caution,
		NamePart,
		Second, dh, race;

	dh = query_desc_hook();
	if (dh && dh != "") 
    {
		int	rtmp;
		catch { rtmp = dh->short(); };
		if (rtmp) return rtmp;
	}

	Caution = query_caution();

	if (!Caution)
		Caution = "";
	else
		Caution = " <" + Caution + ">";

	if (query_guest())
		Caution += " [guest]";

	if (!query_ip_number(this_object()))
		Caution += " [link-dead]";

	if (query_current_action())
		Second = query_current_action();
	else
		Second = query_title();

	if (query_pretitle())
		NamePart = query_pretitle() + " " + cap_name + " " +
			Second;
	else
		NamePart = cap_name + " " + Second;

	i = query_invis();

    race = query_race();
    if (!race) race = "Human";
    else race = capitalize(race);
    if (race == "Vampire") race = "Human";

	if (i < 0)
		return cap_name + " " + query_title() + " (" +
			race + ") (" + query_invis() + ")" + Caution;

	if (i >= NO_SHORT)
		return 0;

	if (ghost) return "ghost of " + cap_name;

	return NamePart + " (" + race + ")" + Caution;

}

set_current_action(str) { current_action = str; }

query_current_action() {

	return current_action;

}

long() 
{
	string s;
    string gods;
    string subj;
    object dh;

	if (dh = query_desc_hook()) 
    {
		int	rtmp;
		catch { rtmp = dh->long(); };
		if (rtmp)
			return 0;
	}

	// Jenna Nov 00 - to stop "0 (male draconian)" at Stadium, etc
	s = short();
	if (!s) s = cap_name + " (invisible)";

	write(s + " (" + capitalize(gender) + ").\n");

	if (this_player()->query_wiz() && query_wiz()) {
		if (query_wiz() >= GOD) {
			write("==> god\n");
		}
		else if (query_wiz() >= ELDER) {
			write("==> elder wizard\n");
		}
		else if (query_wiz() >= SENIOR) {
			write ("==> senior wizard\n");
		}
		else if (query_wiz() > EXPLORE) {
			write("==> wizard\n");
		}
		else if (query_wiz()) {
			write("==> apprentice wizard\n");
		}
	}

	if (description) write(cap_name + description + ". ");

	if (ghost) 
    {
        write("\n");
        return 0;
    }

#if 0
    gods = show_gods();
    if (gender == "male") subj = "He ";
    else subj = "She ";
    if (gods) write(subj +" appears to worship "+gods+". ");
#endif

    write(show_appearance());

	return 1;

}

query_long() { return long(); }

/* Identify ourself. */
id(str) {
    int i;

    i = query_invis();
    if (this_player())
        i = query_invis(this_player()->query_wiz());
    if (i < 0 && str == name)
        return 1;
    if (i >= NO_ID)
        return 0;
    if (ghost)
	return str == "ghost of " + name;
    if (str == name)
	return 1;
    if (index(alii, str) >= 0)
	return 1;
    return 0;
}

// alii (alias) functions
// by Jenna Jun 2001
// I don't know who wrote alii or how long ago, but it looks
// handy so I've added these functions to manipulate it

query_alii() { return alii + [ ]; }

add_alii(str)
{
    int i;

    if (arrayp(str))
    {
	for (i = 0; i < sizeof(str); i++)
	    add_alii(str[i]);
	return 1;
    }
    if (!stringp(str))
	return;
    if (index(alii, str) == -1)
    {
	alii += [ str ];
	return 1;
    }
}

remove_alii(str)
{
    int i, x;

    if (arrayp(str))
    {
	for (i = 0; i < sizeof(str); i++)
	    remove_alii(str[i]);
	return 1;
    }
    if (!stringp(str))
	return;
    x = index(alii, str);
    if (x != -1)
    {
	alii = alii[..x-1] + alii[x+1..];
	return 1;
    }
}


query_title() {

	return title;

}

destruct_inventory(flag)
{
    array con;
    int i;
    object e;

    con = contents(this_object());
    while(i < sizeof(con)) 
    {
	if (con[i]) 
        {
            if (flag) 
            {
            	if (!(con[i]->query_auto_load()))
	                destruct(con[i]);
            }
	    else destruct(con[i]);
        }
	i++;
    }
}

