recalc_carry(flag) {
array obj;
int i;

    if (!myself) return 0;
    if (last_money != money || flag) {
    local_weight = 0;
    obj = contents (myself);
    i = sizeof (obj);
    while (i--) {
	local_weight += obj[i] -> query_weight();
    }
    local_weight += money / 5000;
    last_money = money;
    }
}

switch_me(ob)
{
    if (query_su_level(caller()) < GOD) return 0;
    switch_interactive(ob);
    ob->kickstart();
    return 1;
}

nosave array action_processors = [ ];

add_action_processor(object o) {
    if (index(action_processors, o) < 0) {
	int x = index(action_processors, 0);
	if (x >= 0)
	    action_processors[x] = o;
	else
	    action_processors = action_processors + [ o ];
	}
    if (wiz_level) {
	tell_object(this_object(), "Action catcher " + file_name(o) + " added by " + file_name(caller()) + "\n");
	}
    return 1;
}

/*
 * Called after other possible actions are processed (this is currently
 * invoked by an add_action of length 0).  Won't be called if another
 * action succeeded.
 */

nosave post_catch_action(s) {
    int x = sizeof(action_processors);
    while (x-- > 0) {
	object o = action_processors[x];
	if (o) {
	    int ret;
	    if (!(catch {ret = o->catch_action(this_player(), query_verb(), s); } )) {
		if (ret)
		    return 1;
		}
	    }
	}
    return 0;
}

/*
 * A neat-o little hack for when you go link dead - Gandalf.
 * NB: the catch_tell array IS saved (for when you return).
 */

catch_tell(s) {
    if (receive_host) remote_output(s);
    else if (!query_ip_number(this_object())) {
	add_note(s);
	}
}

add_note(s) {
	if (!stringp(s))
	    return 0;
	while ( sizeof(s) && (s[sizeof(s) - 1] == "\n")) {
	    s = s[..sizeof(s) - 2];
	    }
	if (!pointerp(catch_buf)) {
	    catch_buf = [ s ];
	    return 1;
	    }
	if (sizeof(catch_buf) < 70) {
	    catch_buf += [ s ] ;
	    return;
	    }
	catch_buf = catch_buf[1..] + [ s ];
        return;
}

/* this usurps all of more, so it's written to manage multiples later... */


query_catch() { return catch_buf; }

set_catch(x) { catch_buf = x; }

/*
 * Switch_interactive stuff.  This is temporary while we
 * decide on soul stuff; we need a better system than having
 * to log them in and link-death them, and providing
 * passwords all the time!
 */

nosave failswitch(who) {
	notify_fail(capitalize(who) + " not logged in (log them in and link-death them).\n");
	return 0;
	}

nosave object other_me;

nosave switch_player(who) {

    if (!who || !stringp(who)) return 0;
    other_me = find_player(who);
    if (!other_me)
	other_me = find_living(who);
    if (!other_me) {
	failswitch(who);
	return 0;
	}
    if (other_me->query_invis() >= NO_SHORT) {
	failswitch(who);
	return 0;
	}
    if (query_su_level(other_me) < GOD) {
#if 0
	if (wiz_level < GOD) { /* gods have a test feature :) */
	    failswitch(who);
	    return 0;
	    }
#endif
	write("Note: Changing to " + who + " will make it impossible to change back!\n");
	}

    /* cant let them just switch - maybe site restrictions. */
    if (query_ip_number(other_me) && wiz_level < GOD) {
	notify_fail(capitalize(who) + " is already connected to another character.\n");
	return 0; /* hmm - should test whether ignoring this will crash it. */
	}

    if (!other_me->query_password_ok("")) {	/* if a random string works, no passwd */
	write("Password: ");
	input_to("otherpass", 1);
	return 1;
	}
    return otherpass(0);
}

nosave otherpass(s) {
    string pass;
    if (!other_me->query_password_ok(s)) {
	write("Password incorrect.\n");
	return 1;
	}
    write("Switching to " + other_me->query_real_name() + "\n");
    tell_object(other_me, capitalize(query_real_name()) + " inhabits your soul.\n");
    switch_interactive(other_me);
    command("glance", other_me);
    return 1;
}

set_ip_number(ip) {
    if (query_su_level(caller()) < GOD)
	return 0;
    called_from_ip = ip;
    return 1;
}

get_ip_number() {
    return called_from_ip;
    }


