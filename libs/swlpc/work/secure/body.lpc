/* The quit command */

nosave object route = 0;
nosave int to_home = 0;

nosave cmdquit() {
    if (query_real_name() != "gandalf" && query_wiz())	/* testing */
	return quit();
    if (this_object()->query_attack()
	&& present(this_object()->query_attack(), environment(this_object()))) {
	write("You can't quit while fighting!\n");
	return 1;
        }
    command ("halt",this_object()); /* Stop following anyone, or being followed */      
    call_out("quit", 60);		/* assume a problem after 1 minute */
    if (route) {
#if 0
	return quit();
#endif
	if (to_home) {
	    tell_object(this_object(), "You give up your homeward journey and head straight for the exit instead.\n");
	    been_home();
	    return 1;
	    }
#if 1
	return quit(); /* Jenna Dec 99 - while we're having mapper trouble */
#endif
	tell_object(this_object(), "You are already leaving.\n");
	return 1;
	}

    string err = catch { 
        move_object((route = clone_object("std/map/track")), this_object());
        };
    if (err)
    {
	    tell_object(this_object(), "I am too disoriented to guide you back to reality...\n");
	    return quit();	/* don't let them get trapped in bugs */
	}

    route->set_can_pick(0);		/* non skeleton key (if they are carrying a key, the router will make them unlock it) */
    (int|string) h = query_home();	/* check for their home. */

    if (stringp(h)) {
	object o = find_object(h);
	if (!o) {
	    catch h->load_up_you_stupid_prick();;
	    o = find_object(h);
	    }
	if (o) {
	    if (o == environment(this_object())) { /* if they are at home, they have probably dropped what they want to */
		quit();
		return 1;
		}
    	    route->set_sf_callbacks("at_home", "been_home");
	    if (!route->goto(h)) {
		to_home = 1;
		tell_object(this_object(), "You start off homewards.\n");
		return 1;
		}
	    tell_object(this_object(), "You have no idea how to get home from here.\n");
	    tell_object(this_object(), "(Ok, *I* have no idea how to get you home)\n");
	    }
	else
	    tell_object(this_object(), "If you have a home, something aint working at the moment.\n");
	}

    been_home();

    flush_output();
#if 0
    if (!disconnect_player()) {
        write("Bye...\n");
        flush_output();
	return quit();
	}
#endif
    return 1;
    }

at_home() {
    if (!route || caller() != route)
	return 0;
    tell_object(this_object(), "Home at last...\n");
/*
    command("drop all", this_object());
*/
    catch environment(this_object())->exit();;
    tell_object(this_object(), "You sleep...\n");
    quit();	/* make this been_home() to have them journey to the exit */
    }

been_home() {
    if (to_home) {
	tell_object(this_object(), "You change your mind.\n");
	}
    to_home = 0;
    route->clear_track();
    route->set_sf_callbacks("quit", "quit");
    if (route->goto("room/city/quit")) {
	tell_object(this_object(), "Game driver says: I should have learned to read maps better.\n");
	quit();
	return 1;
	}
    tell_object(this_object(), "You head towards the reality exit.\n");
    }

disconnect_player() {
    if (query_su_level(caller()) < GOD)
	return 0;
    object ob;
    if (catch ob = clone_object("secure/Logons/Null");)
	return 0;
    switch_interactive(ob, this_object());
    ob->start();
    return 1;
    }

quit() 
{
    string err;

    if (find_call_out("im_quitting") != -1)
    {
	write("You are already quitting.\n");
	return 1;
    }
    if (time() - query_last_login() < 5) // no fast logouts - inv issues
    {
            write("Preserving inventory...\n");
            call_out("quit", 5);
            return 1;
    }
    call_out("im_quitting", 10); // just a flag - Jenna Mar 01
    err = catch {
    power = 0;
    hunting = 0;
    if (query_in_temp_brief()) brief =0;
#if 0
    if (find_call_out("restore_objects") != -1)
    {
	restore_objects();
	restore_souls();
//	write("You're quitting too fast!\n"+
//		"Quit aborted because you are attempting to quit "+
//		"before your inventory was restored.\n");
//	return 1;
    }
#endif
    drop_unique_items();
    save_me(1);
    if(objectp(environment(this_object())))
        catch { environment(this_object())->exit(this_object()); };
    destruct_inventory();
    inventory = 0;
    LOGIN_SERVER->notify_logout(this_object());	/* added Hunter 951015 */
    tell_object(this_object(), "Saving " + capitalize(name) + ".\n");
    checked_say(cap_name + " left the game.\n");
    if (is_guest) {
	  log_enter("(gone)");
	  /* "std/banish"->add(name, -300); *//* Don't banish the name for 5 mins */
	  }
	else log_enter("(leaves)");
    flush_output();
    };
    catch if (err) LOG->log("QUIT", err);;
    dest_player();
    return 1;
}

drop_unique_items() 
{
    int i = -1;
    array con = contents(this_object());
    while (++i < sizeof(con))
        if (con[i]->query_property("unique")) 
            command("drop " + con[i]->query_name(), this_object());
}

im_quitting() { }

valid_attack(ob) {
    return 1;
}

wimp_out() {
    if (!random(query_san()+1)) {
	checked_say(cap_name + " cackles manically.\n");
	tell_object(this_object(), "You know you should run, but you are possesed by a manic fury and stay!\n");
	}
	else run_away();
}

test_dark() {
    if (query_total_light () <= 0 && !query_store ("infravision")) {
	write("It is dark.\n");
	return 1;
    }
    return 0;
}

query_weight() { return (query_siz() * 8) + local_weight; }

add_weight(w) {
    int max;

    recalc_carry();
    max = query_str() + query_siz();
    if (disable && index(disable, "handle") > -1) max = max / 2;
    if (w + local_weight > max || w + local_weight < 0) return 0;
    local_weight += w;
    return 1;
}

