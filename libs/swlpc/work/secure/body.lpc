/* Brief stuff - moved to RO/living */
nosave int in_temp_brief = 0;
nosave int lastmovechecktime;
#endif
nosave int was_interactive;
nosave int still_idle = 0;

autoregular()
{
    call_out("autoregular", INTERVAL_BETWEEN_REGULAR);
    if (query_ip_number(this_object())) was_interactive = LINK_ALIVE;
    if (was_interactive && !query_ip_number(this_object())
                 && environment(this_object())) 
    {
	    /* this implements a delay in link death --D */
        if (was_interactive == LINK_ALIVE) save_me(1);
	    if (was_interactive > 0) was_interactive--;
	    if (was_interactive <= 0)
	    {
        	tell_room(environment(this_object()), query_name() +
                 " just died a link death.\n");
#ifdef TRACK_ACTION
		    track_action("LOGINS", "link-death", "");
#endif
		    LOGIN_SERVER->notify_linkdeath(this_object());
	    }
    }

    if (still_idle == 0 && query_idle() > IDLE_THRESHOLD)
    {
        still_idle = 1;
        USER_SERV->update_who(this_object());
    }
    else if (query_idle() <= IDLE_THRESHOLD)
    {
        still_idle = 0;
        USER_SERV->update_who(this_object());
    }
}

