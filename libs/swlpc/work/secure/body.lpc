/* call_outs should really be restarted from saved values */
start_call_outs() 
{
int i;
    while (remove_call_out("timeout") != -1) i = 0;
    call_out("autoheal", INTERVAL_BETWEEN_HEALING);
    call_out("autosanity", INTERVAL_BETWEEN_SANITY);
    call_out("sleeper_check", 1, 0);
    call_out("autoregular", INTERVAL_BETWEEN_REGULAR);
    if (!query_wiz()) call_out("hunger", INTERVAL_BETWEEN_FOOD);
}

autosanity()
{
	add_skill("elan",1);
    call_out("autosanity", INTERVAL_BETWEEN_SANITY);
}

start_attack_cycle() 
{
	if (!combat_soul) {
		combat_soul = find_object(query_name()+"/combat");
		if (!combat_soul) return;
	}
	combat_soul->start_attack_cycle();
}

add_hp(int arg) {
    hit_point += arg;
    if (hit_point > max_hp()) hit_point = max_hp();
    if (hit_point < 0) hit_point = 0;
}

set_wimpy(x) {
	if (!intp(x)) return;
	wimpy = x;
}

query_monitor() { return monitor; }

toggle_monitor() {
    monitor = !monitor;
    if (monitor)
        write("HP monitoring mode.\n");
    else
        write("That's-only-a-flesh-wound mode.\n");
    return 1;
}

save_me(flag) {
    if (query_su_level(this_object()) < GOD)	/* pointless to try, though one day the save system will change */
	return;
	query_age();			/* ensure age is updated */
    compute_auto_str();
    compute_inventory(flag);
    catch "std/top_list"->update(name, query_quest_points(), query_age());;
    if ((name != "guest")) {
	if (!is_guest) {
	    save_object(PLAYER_SERV -> GetPlayerSavefile(name, this_object()));
#ifdef TRACK_ACTION
	    track_action("SAVEFILE", "save", "age="+query_age());
#endif
	    }
	else
	    rm(PLAYER_SERV -> GetPlayerSavefile(name, this_object()) + ".o");
	}
}

/* This is a fucking ugly piece of work.  It's used by the logon
 * code when someone tries to log on AND no savefile is found AND
 * find_player() on the playername returns an object - we save a temp
 * savefile copy in "closed/kickstart_player".
 *
 * Hmm - this should now be redundant (with the switching stuff) - G.
 */
request_kickstart_save() {
    compute_auto_str();
    compute_inventory(1); /* no inventory cloned up */
    save_object("closed/kickstart_player");
    return 1;
}

illegal_patch(what) {
    write("You are struck by a mental bolt from the interior of the game.\n");
    LOG->log("ILLEGAL",
	     capitalize(this_player()->query_real_name()) + " " +
	     what + "\n");
    return 0;
}

compute_inventory(flag)
{
int x,i;
#if 0
	inventory = contents(this_object());
#else
	remember_persistence();	/* hack to put it here */
#endif

	if (!inventory) return;
	x = sizeof(inventory);
	for (i = 0; i < x; i++) {
		if (objectp(inventory[i])) {
		if (living(inventory[i])) inventory[i] = 0;
		else if (inventory[i]->query_auto_load()) inventory[i] = 0;
		else if (inventory[i]->id("soul")) inventory[i] = 0;	
		else if (flag && !inventory[i]->query_always_save()) inventory[i] = 0;
		}
	}
	
}

describe(str) {
    string junk1,junk2;
    if (!str) {
	description = 0;
	write("Your description has been cleared.\n");
	return 1;
    }
    if (str) description = " " + str;
    write("Your description now says:\n");
    write(cap_name + description + ".\n");
    return 1;
}

remote_cmd(key) {
    string str;
    str = soul->get_handshake(key);
    if (str) command(str);
}

remote_snoop(key) {
    object ob;
    int ob_level;
    string str;
    private;
    str = soul->get_handshake(key);
    if (!str) {
	snoop();
	return 1;
    }
    ob = find_living(str);
    if (!ob) {
	write("No such player.\n");
	return 1;
    }
    if (query_wiz() < SNOOP) {
	write("You fail.\n");
	return 1;
    }
    ob_level = ob->query_wiz();
    if (ob_level >= query_wiz() && query_wiz() < ALL_POWER) {
	write("You fail.\n");
	return 1;
    }
    snoop(ob);
}

/* giggle - G */
query_destruct(ob) 
{ 
    object tp;
    string stp;

    tp = this_player();
    if (tp) stp = ", user " + tp->query_real_name();
    if (!wiz_level) return 0;

    if (!soul) 
    {
	    if (ob && (wiz_level > query_su_level(ob))) 
        {
	        tell_object(this_object(), "Your wiz soul has been destructed!\n");
	        tell_object(this_object(), "Object " + file_name(ob) + stp +
			    " attempted to destruct you.\n");
	        return 1;	/* no destruct */
	    }

        USER_SERV->remove_user(name);
        "RO/living"::query_destruct(ob);
	    return 0;
	}

    if (ob && (query_su_level(soul) > query_su_level(ob))) 
    {
	    tell_object(this_object(), "Object " + file_name(ob) + stp +
			" attempted to destruct you.\n");
	    return 1;	/* no destruct */
    }

    USER_SERV->remove_user(name);
    "RO/living"::query_destruct(ob);

    return 0;		/* destruct ok */
}

remote_say(str, ignore) {
    if (ignore)
        say(str, ignore);
    else
        say(str);
}

set_ac(num) 
{
    private;
    base_armour = num;
}

catch_shout(str)
{
    int flag;
    object who = this_player();

    if (environment(myself) && 
        environment(myself)->query_property("block_shout")) return 1;

    if (who && who->query_wiz() && !query_wiz()) flag = 1;
#if 0
    if (who && (who->query_wiz() > 9999)) flag = 1; 
    "players/jenna/jfuns"->tell_jen("[SHOUT]: Checking for " + myself->query_name() + "...\n");
#endif

    if ((!muffled) || (str[0] == '!') || flag) 
    {
    	if (query_caution()) add_note(str);
    	else 
        {
            string append = "";
		    if (str[sizeof(str)-1..] == "\n") 
            {
			    str = str[..sizeof(str)-2];
                append = "\n";
            }
            tell_object(this_object(), ANSI->scolor(ANSI->hilite(this_object(),
                    "shout"), str) + append);
	    }
    }
    return 1;
}

query_muffled() { return muffled; }

update (num) {
    if (num == 6) muffled = soul->query_muffled();
}

is_player() { return 1; }

query_call_outs() 
{
    return query_call_out( "timeout" )
	+ query_call_out( "intoxicate" )
	+ query_call_out( "autoheal" )
	+ query_call_out( "hunger" )
	+ query_call_out( "auto_bleed" )
	+ query_call_out( "breath_routine" )
	+ query_call_out( "fail_breath" )
	+ query_call_out( "test_breath" )
	+ query_call_out( "finished_casting" );
}

query_call_out( str )
{
int i;
    if ( (i = find_call_out(str)) != -1)
	return [ str, i ];
    return [ ];
}

dump_call_out(str) {
    int i;
    if ((i = find_call_out(str)) >= 0)
        write(str + ":\t" + i + "\n");
}

/* Was nosave, but i changed it temporarily to debug with  :L */
dest_player() {
    kill_callouts("timeout");
    kill_callouts("intoxicate");
    kill_callouts("autoheal");  
    kill_callouts("hunger");
    flush_output();
    terminate_all_windows();
#ifdef TRACK_ACTION
    track_action("LOGINS", "destruct", "");
#endif
    destruct(this_object());
    }

kill_callouts(s) {
int i;
    while ((remove_call_out(s)) != -1) 
	i = 0	;  /* changed this, dredd */
}

echo_string(str) 
{
    if (!str || str == "") write("\n");
    else if (str[..1] == "-n")
    {
    	write(str[3..] + "\n");
	}
    else
	{
	    write(str);
	}
    return 1;
}


