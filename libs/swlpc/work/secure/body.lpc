light(str) {
    if (query_verb() == "light") if (!query_wiz()) return;
    if (str == "on") set_light(1);
    if (str == "off") set_light(-1);
    return 1;
}

// Jenna July 01 -- removed message broadcasting from
// these funs -- it should be handled by whatever is
// setting the invis level. (Ditto for vis().)
// invis((string|int) str, (string|int) alt_msg) 
invis((string|int) str)
{
    int invis;
    
    if (stringp(str)) 
       invis = atoi (str);
    else
       invis = str;

    if (!invis)
        return 0;

//    if (!alt_msg)
//	alt_msg = "disappears.";

    if (invis >= 100 && query_wiz() < ALL_POWER)
       invis = 100;
/*
    if (invis >= INV7 && query_wiz() < CINV7) invis = INV7 - 1;
    if (invis >= INV6 && query_wiz() < CINV6) invis = INV6 - 1;
    if (invis >= INV5 && query_wiz() < CINV5) invis = INV5 - 1;
    if (invis >= INV4 && query_wiz() < CINV4) invis = INV4 - 1;
    if (invis >= INV3 && query_wiz() < CINV3) invis = INV3 - 1;
    if (invis >= INV2 && query_wiz() < CINV2) invis = INV2 - 1;
    if (invis >= INV1 && query_wiz() < CINV1) invis = INV1;
*/
    if (is_invis)
	vis();
    is_invis = invis;

//    if (query_verb() == "invis")
//	    write("You are now invisible = "+is_invis+".\n");
//
//    if (is_invis < INVIS_ACTION)
//        remote_say(cap_name + " " + alt_msg + "\n");

    if (is_invis >= SOMEONE)
        cap_name = "Someone";

    if (is_invis >= 100)  /* Jenna Mar 01 */
	USER_SERV->remove_who(name);

    if (soul) soul->update(2);

    return 1;
}

vis() 
{
    if (!is_invis) {
	tell_object(this_object(),"You are not invisible.\n");
	return 1;
    }
    if (is_invis >= 100)
	USER_SERV->add_who(this_object());
    is_invis = 0;
    cap_name = capitalize(name);

//    if (query_verb() == "vis") {
//	    tell_object(this_object(),"You are now visible.\n");
//	    remote_say(cap_name + " appears in puff of smoke.\n");
//	}

    if (soul) soul->update(2);
    return 1;
}

