/*
 * secure/master: Loaded, suid GOD*2, at the start of the game.
 * Nothing can update this - it requires a reboot.
 *
 * It is suid'd *before* reset is called.  Reset is NOT caught-applied!
 * it MUST NOT FAIL.
 *
 * Currently does the following:
 *    Loads all the objects named in the initial_objects entry in its
 * savefile;
 *    Loads armageddon (RO/shut), trusts him up to SHUTDOWN level
 *    Loads closed/log/comands, and trusts it to GOD
 */

#include "security.h"
#include "Servers.h"
/* is including Servers.h a security problem?? */

#define    SAVE    "closed/master_save"

array log_list;

query_destruct(who) 
{
    write("Destructing " + file_name(this_object()) + 
                " could be bad for your health!\n");
    return 1;
}

array initial_objects;

int started = 0;

reset(arg) 
{
    if (arg || started) return;
    started = 1;

    call_out("start", 0);
}

trust_logger() 
{
    object o;

    catch "RO/logger"->load_me_up();;
    o = find_object("RO/logger");
    if (o) set_uid_me(o, ED_LOG + 2);

#if 0
    catch "secure/data_log"->load_me_up();;
    o = find_object("secure/data_log");
    if (o) set_uid_me(o, GOD + 2);
#endif
}

int ransetup = 0;

nosave start() 
{
    int x;
    string err;

    /* don't run twice */
    if (ransetup) return;

    /* Log our start up */
    trust_logger();
    catch LOG->log_now("GAME_LOG", query_host_name()
        + ", Master loaded.\n");;
    catch LOG->log_now("ENTER", query_host_name() + " rebooted.\n");;

    restore_object(SAVE);

    /* Virtual object root directory */
    err = catch 
    {
        object o = clone_object("RO/Root/RootDir");
        set_uid_me(o, GOD + 2);
        rename_object(o, "");
        o->start_virtual();
    };

    /* Wizard logging stuff */
    wizard_logging();

    if (err) LOG->log_now("STARTUP", "master.c:1:"+err+"\n");

    /* Load saved initial objects */
    if (initial_objects && !("secure/which_mud"->is_wiz_mud()))
    for (x=0; x < sizeof(initial_objects); x++)
        call_out("load_initial_object", 0.1, initial_objects[x]);


    /* Shutdown stuff */
    suid_armageddon();

    /* Datagram server */
    catch OBJ_DATAGRAM_SERV -> reset (); ;


    /* We're basically setup */
    ransetup = 1;

    /* we're living? */ 
    enable_commands();

    /* Virtual object support - on */
    set_forecurse_ok();
}    

wizard_logging()
{
    string err;

    err = catch {
    "closed/log/commands"->ping();
    object o = find_object("closed/log/commands");
    set_uid_me(o, GOD + 2 );
    o->start();
    };

    if (err) LOG->log_now("STARTUP", "master.c:1:"+err+"\n");
}

rumour_handler()
{
    catch 
    {
        object o = clone_object("P/special/Src/Rumour");
        set_uid_me(o, GOD+2);
        o->start_virtual();
    };
}


suid_dg_serv() 
{
    object o;

    o = find_object (OBJ_DATAGRAM_SERV);
    if (!objectp(o)) 
    {
        throw "Master could not find OBJ_DATAGRAM_SERV to suid, shouldnt be possible!\n";
        return;
    }
    set_uid_me(o, SEND_DATAGRAM);
}

/*
 * Game shutdown code.
 */
quit() 
{
    AUTOSAVE_SERV->save_me(1);
}

suid_armageddon() 
{
    object o;

    /* SHUT_DAEMON calls this, so should already be loaded */
    catch SHUT_DAEMON->load_me_up(1);;
    catch set_uid_me(find_object(SHUT_DAEMON), SHUTDOWN+101);;
}

nosave log_shout(str) 
{
    SHOUT->shout("Game driver shouts:" + str);
    LOG->log("GAME_DRIVER", str);
}

nosave load_initial_object(what) 
{
    string err;
    //if (caller() != 0) return;
    if (arrayp(what))
    {
        object o;
        int l;

        if (sizeof(what) == 2)
        {
            o = load_object(what[0]);
            l = what[1];
        }
        else if (sizeof(what) == 3)
        {
            o = load_object(what[0]);
            if (o) o = o->(what[1])();
            l = what[2];
        }

        if (index(what[0], "players") == -1)
        {
            if (o && l) 
            {
                LOG->log_now("STARTUP", "trusting "+file_name(o));
                set_uid_me(o, l);
                err = catch what[0]->reset(1);;
                if (err) LOG->log_now("STARTUP", "error: " + err);
            }
        }
    }
    else
    {
        what->reset(1);
    }
}

/*
 * Reload master object.
 */

#if 0
/* sigh - the driver keeps a pointer to master */

reload_master() 
{
    if (caller() && (query_su_level(caller()) < GOD))
    return 0;
    if (find_object("secure/mistress")) {
    write("Already a secure/mistress (what the hell is going on here?)\n");
    return 0;
    }
    rename_object(this_object(), "secure/mistress");
    (int|string) k = catch "secure/master"->load_me_up(1);;
