/*
 * Re-instatement for armageddon
 */
armageddon_dested() 
{
    if (this_player() && (this_player()->query_wiz() > SHUTDOWN))
        return;
    call_out("suid_armageddon", 1);
}

check_should_log(s) 
{
    if (query_su_level(previous_object()) < GOD)
    return random(10);
    if (!pointerp(log_list))
    return 0;
    if (index(log_list, lower_case(s)) >= 0)
    return 1;
    return 0;
}

add_log_entry(s) 
{
    if (query_su_level(previous_object()) < GOD) return random(10);
    if (check_should_log(s)) return 1;

    log_list += ({ lower_case(s) });
    save_me();
    return 1;
}

nosave save_me() 
{
    save_object(SAVE);
 }

dgram_recv(a) 
{
    call_out("do_dgr", 0.0, a);
}

#define SPOTCODE "<SPOTTY>"

do_dgr(a) 
{

#if 0
    if (pointerp(a) && (sizeof(a) == 3)
    && (pointerp(a[2]) && (sizeof(a[2]) > 0) && a[2][0] == SPOTCODE)) {
        catch "players/gandalf/closed/spotty/rec"->recv(a);;
        return;
        }
#endif

    catch "secure/remote/rwho"->recv(a);;
}

/*
 * Name: compile_error
 * Purpose: compiler biffed a compiler error - log it! 
 */
compile_error(errs)
{
    int i;

    for (i = 0; i < sizeof(errs); i++)
    {
        LOG->smartlog(errs[i]);
    }

    /* force a save so a wiz can see what's happened */
    LOG->save_me();
}

/*
 * This is called on any find_object which (a) wants
 * to load the object, and (b) didn't find the object
 * in the hash table.  Looks for a loaded object whose
 * name is a prefix of the requested object; if one is
 * found, GetVirtualObject is called in the found object.  If an
 * object is returned, it is renamed.  Currently, longer
 * filenames (that exist) override calls to GetVirtualObject
 * in shorter filenames.  It is nice in some ways (less
 * programming to do), but somewhat limiting in others.
 *
 * This is a likely cause of unloadable object
 * errors when the game is just starting up,
 * as it will not recursively look for objects
 * to load (to prevent *inadvertent* crashes).
 * It is unclear how to solve this without a driver rewrite - G.
 *
 * NB: This requires that your "virtual room controllers"
 * all be loaded (and treated as directories).
 */

int forecurse = 0;

set_forecurse_ok() 
{
    forecurse = 1;
}

nosave object last_found;
nosave string last_query;

FindObject(string s) 
{
    string st;

    if (!forecurse)    /* initglobals is called after reset!  sheesh */
        return 0;    /* that's why 0 means "in recursion" */
    forecurse = 0;

#if 0
    catch ("(Master loads:) " + s)->spug();;    /* so I can see it on console - G */
#endif

    array components = explode(s, "/");
    (object|string) c = 0;
    if (s[0] == '/') st = "/";
    else st = "";

    int x = sizeof(components);
    int y = x;

    /* find a loaded prefix OR valid file name */

    while ((!c) && (--x >= 0)) 
    {
        string oname = st + implode(components[..x], "/");
#if 0
    catch ("(Master loads:) " + oname)->spug();;    /* so I can see it on console - G */
#endif
        c = find_object(oname);
        if (!c) 
        {
            string j = oname + ".lpc"; /* a hack */
            if (file_size(j) > 0) c = oname;
        }
    }

    if (x == (sizeof(components) - 1)) /* used to be || !c */
    {    
        /* couldn't find an appropriate .c file or prefix object */
        set_forecurse_ok();
        return(0);
    }

    /* use the root object, created earlier. */
    if (!c) 
    {    
        c = "";
        if (!find_object(c)) 
        {    
            /* looks wierd, eh? :) */
            set_forecurse_ok();
            return(0);
        }
    }

/* If we have a string here, and x = sizeof(components)-1, the full filename
 * existed.  If c is a string, a partial match exists.  If c is an object,
 *  we have a direct match on a controller.
 */

    object o;
    string cerr = catch { o = c->GetVirtualObject(s); };    
            /* error means C didn't load; this is ok. */
    set_forecurse_ok();

    if (cerr) 
    {
        if (objectp(c))
            "RO/logger"->log("VIRTUAL", file_name(c) + ": " + cerr);
        else 
            "RO/logger"->log("VIRTUAL", c + ": " + cerr);
        return 0;
    }

    if (o) 
    {
        if (objectp(o)) 
        {
            if (file_name(o) != s) rename_object(o, s);

            last_query = s;
            last_found = o;
            return o;
        }
    }
    return 0;
}

show_stats()
{
    write("Master Stats:\n");
    write("Forecurse = "+forecurse+"\n");
    if (last_found)
    write("Last object found = "+file_name(last_found)+"\n");
    write("Last query = "+last_query+"\n");
}

