/*
 * LOGIN_SERVER - Gatekeeper
 * Shattered Worlds Mudlib
 *
 * Gatekeeper is used to monitor Player Logins, and uses Hooks to
 * maintain a contact list of character game enters and exits.
 */

/*
 * 951015 Hunter	prototype
 * 980914 Dredd	    some changes to work with USER_SERV directly
 */

inherit "RO/Servers";
inherit "RO/hooks";

reset( arg )
{
}

/*
 * notify_login gets called when a player logs in normally
 */
notify_login( )
{
    object who = previous_object();

    USER_SERV->add_user(who);

    test_advisory_hook( "enter", "enter", who );
}

/*
 * notify_logout gets called when a player quits cleanly
 */
notify_logout( )
{
    object who = previous_object();

    USER_SERV->remove_user(who->query_real_name());

    test_advisory_hook( "exit", "exit", who );
}

/* 
 * notify_reconnect gets called when a link-death player reconnects
 */
notify_reconnect( )
{
    object who = previous_object();

    test_advisory_hook( "reenter", "reenter", who );
}

/*
 * notify_start gets called when a new player enters the game
 */
notify_start( )
{
    object who = previous_object();

    test_advisory_hook( "start", "start", who );
}

/*
 * notify_linkdeath( ) gets called when a player link-dies
 */
notify_linkdeath( )
{
object who = previous_object();
    test_advisory_hook( "linkdeath", "linkdeath", who );
}

/* notify_attach( ) gets called when someone connects to the mud
 */
notify_attach( )
{
object who = previous_object();
    test_advisory_hook( "connect", "connect", who );
}

