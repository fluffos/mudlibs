/*
 * Maintains a list of the Servers defined in /RO/Servers.h
 * - Hunter <wigs@yoyo.cc.monash.edu.au> 940615
 * 
 * 950707 Hunter    now reads from 'const's in /RO/Servers.c
 */

inherit "RO/Servers";

nosave array servers = ({ });

show_stats()
{
    return "Known servers: " + sizeof(servers) + "\n";
}

reset(arg) 
{
    if (!arg)
    {
	read_servers("RO/Servers.lpc");
	// read_servers("RO/Servers.h");
	read_servers("RO/Config.h");
	read_servers("RO/Consts.h");
	read_servers("RO/Objects.h");
	read_servers("include/cult.h");
    }
}

string strip_string(string foo)
{
string bar = "";
int i;
int last_space = 1;
    for ( i = 0; i < sizeof(foo); i ++ )
    {
	if ( (foo[i..i] == " ") || (foo[i..i] == "\t") )
	{
	    if (last_space)
	    {
	    }
	    else
	    {
	    	bar += " ";
		last_space = 1;
	    }
	}
	else
	{
	    bar += foo[i..i];
	    last_space = 0;
	}
    }
    return bar;
}

	
read_servers(string includefile) 
{
    string ROservers;
    array lines;
    array allargs;
    int i;
    string servername, serverfile;

    ROservers = grab_file(includefile);
    lines = explode(ROservers, "\n");

    for (i = 0; i < sizeof(lines); i ++ )
    {
	if ( lines[i][0..6] == "#define" )
	{
	    lines[i] = strip_string(lines[i]);
        allargs = STRINGS->split_first(lines[i][8..], " ");
        if (allargs && sizeof(allargs) == 2
            && allargs[1][0] == '"' && allargs[1][sizeof(allargs[1])-1] == '"')
	    {
            /* should probably handle ints too */
	        servers += ({ includefile, allargs[0], allargs[1][1..(sizeof(allargs[1])-2)]  });
	    }
	}
	if ( lines[i][0..4] == "const" )
	{
	    lines[i] = strip_string(lines[i]);
        allargs = STRINGS->split_first(lines[i][6..], " = ");
        if (allargs && sizeof(allargs) == 2 && allargs[1][0] == '"' &&
            allargs[1][sizeof(allargs[1])-2] == '"')
	    {
	        servers += ({ includefile, allargs[0], allargs[1][1..(sizeof(allargs[1])-3)]  });
	    }
	}

    }
}

query_servers() { return servers; }

/*
** query_server: returns the actual string locating a particular
**      server (give by name: ie. ARMOURER)
*/
(string|int)
query_server( string label )
{
int i;
    i = index(servers, label);
    if (i == -1) return 0;
    if ((i % 3) != 1) return 0;
    return servers[i+1];
}


(string|int)
query_label( string server )
{
int i;
    i = index(servers, server);
    if (i == -1) return 0;
    if ((i % 3) != 2) return 0;
    return servers[i-1];
}


