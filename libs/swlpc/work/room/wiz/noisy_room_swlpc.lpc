/* 
 * This room name appears in the root directory.
 * If you update this room, the root dir won't be
 * able to tell us what's going on.
 */

inherit "room/room";

reset(arg) {
	::reset(arg);
	if (arg) return 0;
	outdoorness = 0;
	set_short("Noisy room");
	set_long("This is where the game driver objects congregate, to moan loudly at anyone who will listen.\n");
	set_light(5); /* Bright! */
	add_property("city");
        set_dest_dir([ "room/wiz/changeroom","south" ] );
}

log(string who, string str) {
    tell_room(this_object(), who + ": " + str + "\n");
    }
