/*
 * Noisy room — /room/wiz/noisy_room.
 * Original SWLPC source preserved as /room/wiz/noisy_room_swlpc.lpc.
 */

mapping exits;

void create() {
  exits = ([
    "west": "/room/city/inn",
    "w": "/room/city/inn",
    "down": "/room/city/inn",
    "d": "/room/city/inn",
    "south": "/room/city/inn",
    "s": "/room/city/inn",
  ]);
}

string query_short() { return "Noisy room"; }

string query_long() {
  return "This is where the game driver objects congregate, to moan loudly at\n"
    "anyone who will listen.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Obvious exits: west (or south, down).\n";
}

int id(string str) {
  return str == "noisy_room" || str == "room" || str == "here";
}
