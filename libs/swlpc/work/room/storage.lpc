/*
 * Generic storage room — /room/storage.
 * Original SWLPC source preserved as /room/storage_swlpc.lpc.
 */

mapping exits;

void create() {
  exits = ([
    "up": "/room/city/inn",
    "u": "/room/city/inn",
  ]);
}

string query_short() { return "Don't be here!"; }

string query_long() {
  return "Don't be here!\n"
    "A generic room where dumped items are kept without decaying.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Obvious exits: up.\n";
}

int id(string str) {
  return str == "storage" || str == "here";
}
