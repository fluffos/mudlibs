/*
 * Common Sleeping Quarters — Sanom City Inn (mlib-0.9.1 /room/city/inn).
 * Original SWLPC source preserved as /room/city/inn_swlpc.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/room/wiz/noisy_room",
    "e": "/room/wiz/noisy_room",
    "up": "/room/wiz/noisy_room",
    "u": "/room/wiz/noisy_room",
    "down": "/room/storage",
    "d": "/room/storage",
    "west": "/RO/void",
    "w": "/RO/void",
  ]);
  extras = ([
    "fireplace": "A bright blaze glows within it.\n",
    "bed rolls": "They look comfortable and warm.\n",
    "blaze": "It's too hot to go near.\n",
    "sign": "Try 'read sign'.\n",
  ]);
}

string query_short() { return "Common Sleeping Quarters"; }

string query_long() {
  return "Simple bed rolls lay strewn about. This is a common sleeping\n"
    "quarters. It is a bright cheery place with a warm\n"
    "fireplace.\n"
    "You may use the 'emote' (aka ':') command here.\n"
    "A wooden sign hangs beside the fireplace.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Obvious exits: east (or up), down, west.\n";
}

string query_item(string s) {
  if (s == "clock") {
    return "You look out a window at the clocktower. The clock tower stands above\n"
      "almost everything else in Sanom City, so you can see it clearly.\n"
      "Current driver time: " + ctime(time()) + ".\n";
  }
  if (!extras || !s)
    return 0;
  return extras[s];
}

string query_read(string s) {
  if (s == "sign") {
    return "Welcome to the Shattered World Core Mudlib (mlib-0.9.1)!\n"
      "Core rooms: Common Sleeping Quarters (here), Noisy Room (east/up),\n"
      "Storage (down), and The Void (west).\n";
  }
  return 0;
}

int id(string str) {
  return str == "inn" || str == "quarters" || str == "here";
}
