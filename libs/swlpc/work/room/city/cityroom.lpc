/* 
 * This room is used by all rooms in the city which can see the clocktower.
 * Hunter 11/9/1991
 *
 * 19980316 Dredd Make the rats regenerate.
 */


inherit "room/room";

reset(arg) 
{
	::reset(arg);
	add_item( "clock", "@look_time");
	add_property("city");
	add_property("npc_non_aggressive");
	add_property("no_player_combat");
    call_out("make_monster", 3);
}

make_monster()
{
	object rat;
    int x = random(10);
	if (x < 2) 
    {
			rat = MONSTERER->make("rat", 2, "male", "none");
			if (rat) 
            {
                rat->set_long("A nasty scrawny rat.\n");
                move_object(rat, this_object());
            }
	}
    else if (x == 2)
    {
			rat = MONSTERER->make("cat", 3, "male", "none");
			if (rat) 
            {
                rat->set_long("An ugly mangy cat.\n");
                move_object(rat, this_object());
            }
    }
}

eject(who)
{
    who->move_player("X","room/bh1");
}

set_items(arg) {
	::set_items( arg + [ "clock", "@look_time" ] );
}

query_long(str) {
	if (str != "clock")
		return ::query_long(str);
	else return look_time();
}

look_time() {
    string ret = "";
	if (query_outdoors() < 2) {
		ret = "You cannot see the clock tower from here";
        return ret;
	}
	if (query_outdoors() == 2)
		ret = "You look out a window at the clocktower. "; 
	ret = ret + "The clock tower stands above almost everything else in "+
	"Sanom City, so you can see it clearly.\n"+
	"You make the time to be about "+ (CLOCK->query_time_12());
	return ret;
}
