#include "/RO/Config.h"

inherit "room/city/cityroom";

reset(arg) 
{
	::reset(arg);
	if (arg) return;
	set_dest_dir([ "room/city/pub2", "down" ]);
	set_short("Common Sleeping Quarters");
	set_long("Simple bed rolls lay strewn about. This is a common sleeping " +
        "quarters. It is a bright cheery place with a warm\n"+
		"fireplace.\nYou may use the 'emote' (aka ':') command here.\n");  
	set_items([ "fireplace", "A bright blaze glows within it",
		"bed rolls", "They look comfortable and warm",
        "blaze", "It's too hot to go near" ]);
	set_outdoors(1);
	set_light(1);
	add_property("city");
/*
 * Have to be a little careful with making sure the inn works OK.
 */
	(int|string) err = catch {
	    object o = clone_object("room/city/obj/inn_sign");
	    move_object(o, this_object());
	    };
	if (err) {
	    LOG->log("errors.err", "room/city/inn: inn sign failed to load");
	    }
}

/*
 * required or the guide screws itself - G.
 * besides, it'sa nice to have a room without the leading period.
 */

#if 1
init() {
	::init();	
	add_action("help", "rules");
	add_action("help", "local");
	add_action("emote", "emote");
	add_action("emote",":", -1);
}

help(str)
{
    notify_fail("Perhaps try typing: read sign\n");
    return 0;
}

emote(str) {
	if (!str) return;
	say(this_player()->query_name() + " " + str + "\n");
	write("You emote: "+this_player()->query_name()+" "+str+"\n");
	return 1;
}
#endif
