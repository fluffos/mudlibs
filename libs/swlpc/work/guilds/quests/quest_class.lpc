/* If you change this definition in ANY way you MUST also modify the 
 *  main quest reader function load_quest_list() to reflect these changes */


string name;    /* Name of the quest, used in the code */
string short;   /* The name that the player sees */
string desc;    /* A long description of the quest, with a hint how to start it */
string rating;  /* The number of quest points the author thought it was worth */
array reward;   /* Stats that they are given */
int freq;       /* Number of times its been done */
