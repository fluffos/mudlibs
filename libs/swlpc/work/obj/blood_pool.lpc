inherit"std/object" ;

int dryness;
int blood_type;

reset(arg) {
	if (arg) return ;
	set_short("a pool of blood") ;
	set_id( [ "blood", "pool", "blood_pool", "blood pool" ] ) ;
	set_long("A pool of someone's vital life fluid, and it smells"
		+" ooooooh, so goood.\n") ;
	call_out("dry_me", 30) ;
	add_property("DECAY","The pool of blood dries without a trace.\n",
		  60) ;
}

set_type(string str) { blood_type = str; }

query_type() { return blood_type; }

get() 
{
	if (dryness) {
		write("You pick at the dried bits to no avail.\n") ;
		return ;
	}
	write("You run your fingers through the pool of blood, then lick "
		+"them clean.\n") ;
	return ;
}

dry_me() 
{
	dryness = 1 ;
	set_short("a drying pool of blood") ;
	set_long("A pool of blood that has started to dry and crack at the"
		+" edges.\n") ;
}
