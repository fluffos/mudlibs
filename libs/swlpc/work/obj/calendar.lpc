inherit "std/object";
#include <Servers.h>

reset(arg)
{
	::reset(arg);
	if (!arg)
	{
		set_id( [ "calendar", "astrolabe", "clock", "water clock" ] );
		set_short("The astrolabe water clock");
		set_long(
			"This very large and complicated device looks like the "+
			"ravings of a madman described into a set of iron rings, "+
			"tubing and thingumijigs. It apparently tells the time, "+
			"date, season and moon phase. Impressive huh?\n");
		add_property("no_get");
  		/* enable_commands();		 why? */
	}
}

query_long(str)
{
    string ret;
    int day;	
	ret = ::query_long(str);
	day = CLOCK->query_day();
	ret = ret + 
       		"\nThe astrolabe says the current date is the "
		+day+((day%10 == 1)?"st":((day%10 == 2)?"nd":
			((day%10 == 3)?"rd":"th")))
		+" day of "+CLOCK->query_month_s()
		+" of the year "+CLOCK->query_year()+".  "
		+"Another dial says it is "+CLOCK->query_season()
		+" and that the moon is "+CLOCK->query_moon()+".\n"
		+"The current time of day is "+CLOCK->query_time_12() + "\n";
	return ret;
}

