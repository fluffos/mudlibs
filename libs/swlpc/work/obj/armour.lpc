set_ac(a)  { ac = a; }


set_type(t) 
{
int x;
	array AwkwardTypes = ({
		"armour", "helmet", "shield", "ring", "amulet",
		"boot", "glove", "cloak"
//		, "vambrace", "gauntlet",
//		"greave", "cuiras", "sleeve", "pant"
		});
	array Cover = ({
		({ "chest", "abdomen" }), ({ "head" }), ({ "chest" }),
		({ "hand" }), ({ "all" }), ({ "foot" }), ({ "hand" }),
		({ "chest", "abdomen" })
		});
	array NewTypes = ({
		"hauberk", "helmet", "shield", "ring", "amulet",
		"boots", "gauntlets", "cloak"
//		, "vambraces", "gauntlets",
//		"greaves", "cuirass", "sleeves", "pants"
		});

	type = t;

	add_id(t);

	if ( (x = index(AwkwardTypes, type)) != -1) {
		set_cover(Cover[x]);
		type = NewTypes[x];
	}

}

set_arm_light(l) { set_light(l); }
set_robust(n) { change_property("break",0,n); }

wear_ob() 
{
    object ob = environment(this_object())->wear(this_object());

    if (!ob) wear_object(environment());
    return(ob);
}


find_covering(arg)
{
    array temp;

    if (arg)
        temp = query_coverings();
    else
        temp = query_covered();

    return (sizeof(temp) != 0);
}


int query_under_clothing(int arg) { return arg > layer; }
int query_over_clothing(int arg) { return (arg <= layer); }
int query_layer() { return layer; }


int query_does_it_cover(array coverage)
{
    return (sizeof(ARRAY->common(coverage, query_cover())) > 0);
}


query_clothing() { return 1; }
query_partial() { return partial; }

string find_covering_name(int over)
{
    array covering = query_coverings();
    int largest_layer;
    int lindex;
    int i;

    if (sizeof(covering) == 0) return "";
    largest_layer = covering[0]->query_underclothing();
    lindex = 0;
    i = 1;
    while (i < sizeof(covering))
    {
        if (covering[i]->query_layer() > largest_layer)
        {
            lindex = i;
            largest_layer = covering[i]->query_layer();
        }
        i ++;
    }
    return covering[lindex]->query_name();
}

/* 
 * returns: an array of everything possibly covered by this item of clothing 
 */
array query_covered()
{
    array stuff = contents(environment());
    array retv = allocate(sizeof(stuff));
    int retc = 0;
    int i;

    /* if (!query_worn()) return ({ }); */

    for (i = 0; i < sizeof(stuff); i ++)
    {
	if (stuff[i] && stuff[i]->query_clothing() 
		&& stuff[i]->query_under_clothing(layer)
		&& stuff[i]->query_worn()
		&& stuff[i]->query_does_it_cover(query_cover())
	)
	{
	    retv[retc] = stuff[i];
	    retc ++;
 	}
    }
    retv = retv[..retc-1];
    return retv;
}


/* 
 * RETURNS: an array of everything possibly covering this item of clothing 
 */
array query_coverings()
{
    array stuff = contents(environment());
    array retv = allocate(sizeof(stuff));
    int retc = 0;
    int i;
    int layer_adj = 0;

    if (query_worn()) layer_adj = 1;

    for (i = 0; i < sizeof(stuff); i ++)
    {
	if (stuff[i] && stuff[i]->query_clothing() 
		&& stuff[i]->query_over_clothing(layer + layer_adj)
		&& stuff[i]->query_worn()
		&& stuff[i]->query_does_it_cover(query_cover())
	)
	{
	    retv[retc] = stuff[i];
	    retc ++;
 	}
    }
    retv = retv[..retc-1];
    return retv;
}


set_layer(int arg) { layer = arg; }
set_partial(array i) { partial = i; }


int no_non_partial_coverings() 
{
array coverings = query_coverings();
array areas = query_cover();
int i;
    for (i = 0; i < sizeof(coverings); i ++)
	areas = "lib/arrays"->subtract(areas, coverings[i]->query_full_cover());
    return (sizeof(areas) != 0);
}


array query_full_cover()
{
    return ARRAY->subtract(query_cover(), partial);
}


query_naked() 
{
    if (!find_worn())
    	return 1;
    return (find_worn()->query_decency() == 0);
}


find_worn()
{
    test_worn_clothing();
    return worn_clothing;
}


test_worn_clothing()
{
    if (!worn_clothing && environment() && environment()->living())
    {
	worn_clothing = present("worn_clothing", environment());
#if 0
	if (!worn_clothing)
	{
	    worn_clothing = clone_object(PATH+"worn_clothing");
    	move_object(worn_clothing, environment());
	}
#endif
    }
}

set_color(string str) { color = str; }
query_color() { return color; }


/* to distinguish clothing from armour
 * query_is_clothing will return 1 if it is clothing
 * Zeni Sept 15 '99
 */

int is_clothing;

set_is_clothing(i)
{
    is_clothing = i;
}

query_is_clothing()
{
   return is_clothing;
}
