inherit "std/wearable";
inherit "std/protection";	/* Jenna July 99 */

#include "materials.h"

object worn_clothing;
array partial = ({ });
string type;
string color;
int layer;
int size;
int ac;

show_stats()
{
    ::show_stats();
    write(
	"type    : " + type + "\t" +
	"ac      : " + ac + "\n"
    );
    write("worn_clothing : "); DUMP->dump(worn_clothing);
    write("layer    : "+layer+"\tsize     : <unimplemented>\n");
    write("partial  : "+implode(partial, ", ")+"\n");
}
 	   
reset() 
{
    ::reset();
    set_material(MAT_CLOTH);
    add_id("armour");
    add_property("wear");
    type = "armour";
}

short()
{
    if (query_worn()) return 0;
    return ::short();
}

short_string()
{
    string temp;
    int len;

    if (!(temp = ::short())) return 0;

    len = sizeof(temp);
    if (len < 7)
        return 0;
    if (temp[len - 7..] == " (worn)")
        if (!find_covering(1) || no_non_partial_coverings())
            return temp[..len - 8];
    return 0;
}

query_long()
{
    if (query_worn() && find_covering(1) && !no_non_partial_coverings())
        return ("You can't see through your " + find_covering_name(1) + ".\n");
    return ::query_long() + "It " + damage_status() + ".\n";
}

damage_status() 
{
    int x;
    array Messages;

    Messages = DAMAGE_STATUS->query_messages();
    if (!query_property("BREAK")) return Messages[0];
    else if (query_damage() >= query_property("BREAK")[2])
	    return Messages[sizeof(Messages)-1];
    else
    {
        x = query_damage() * 10 / query_property("BREAK")[2];
        if (x >= sizeof(Messages)) x = sizeof(Messages) -1;
        if (x < 0) x = 0;
	    return Messages[x];
    }
}

test_type(String) 
{
    return (String == type ? this_object() : 0);
}

armour_class() { return ac; }
query_type() { return type; }

query_armour(locn) 
{
    int i;
    array cover = this_object()->query_cover();

/*  if (cover) return; */ /* EVERYTHING HAS COVER! */
    if (!locn) return ac;
    for (i = 0; i <  sizeof(cover); i++) 
	if (locn && stringp(locn) && index(locn, cover[i]) != -1)
	    return ac;
}

int can_wear(object who)
{
    array failed;
    string error;

    if (!::can_wear(who)) return 0;

    /* can the armour be worn by someone? */
    failed = test_wearers_body(who);
    if (sizeof(failed) != 0)
    {
	failed = collapse_cover(failed);
	error = "To wear "+short()+" you need to have ";
	if (sizeof(failed) == 1)
	{
		error += failed[0] + ".\n";
 	}
	else
 	{
        error += implode(failed[..sizeof(failed)-2], ", ")+" and "
		    +failed[sizeof(failed)-1]+".\n";
	}
	notify_fail(error);
	return 0;
    }
    return 1;
}

int wear(str) 
{
    object who;
    object ob;

    if ( !(id(str)) ) return 0;

    if (layer == 0) ARMOURER->fix_layer(this_object());

    /* find any layers >= this one ... */
    if (find_covering(1))
    {
        notify_fail("You can't put your " + query_name() + " on over your "
        + find_covering_name(0) + "!\n");
        return 0;
    }

    if ( !(::wear(str)) ) return 0;

    test_worn_clothing();
    if (worn_clothing) worn_clothing->add_worn_object();

#if 0
    who = environment();
    ob = wear_ob();
    if (!ob) 
    {
        return 1;
    }
    notify_fail("You already have an armour, " 
        + ob->query_name() + ", of class " + type + ".\n");
#endif

    return 1;
}

int remove(str)
{
    if (!id(str)) return 0;
    if (!query_worn()) 
    {
        notify_fail("You aren't wearing your "+query_name()+".\n");
        return 0;
    }
    if (find_covering(1))
    {
        notify_fail("You have to remove your " + find_covering_name(1)
        + " first.\n");
        return 0;
    }
    if (!::remove(str)) return 0;
    if (worn_clothing)
        worn_clothing->add_worn_object();
    return 1;
}

// Commented out by Jenna Oct 00 - I think this is a relic from
// before armour inherited std/wearable. There's nothing here armour
// needs to do that all wearable items don't.
