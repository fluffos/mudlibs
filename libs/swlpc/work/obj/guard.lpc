
/*
 * Generic 'guard' soul. 
 * 
 * Functions:
 *
 *     set_guard_location(string direction|room_file)
 *
 */

inherit "obj/souls/base_soul";

array guarded_dirs = [ ];
array guarded_dests = [ ];
string stop_message;

reset(arg)
{
    ::reset(arg);
    add_id("guard_soul");
    add_id("guard");
    set_short("A nifty guard soul.\n");
    set_stop_msg("prevents your move");
    set_soul_type("generic", "guardsoul");
}

init()
{
    ::init();
    myself->set_init_ob(this_object());
}

monster_init(me)
{
    if(!this_player()) return 0;
    if(!this_player()->query_move_hook(this_object(), "moving"))
	this_player()->add_move_hook(this_object(), "moving");
}

moving(who, dir, dest)
{
    if(!present(who, environment(myself)))
    {
    	who->remove_move_hook(this_object());
        return 0;
    }
    if((index(guarded_dirs, dir) != -1 || index(guarded_dests, dest) != -1)
		&& who->query_previous_room() != dest)
    {
		write(myself->query_name()+" "+stop_message+".\n");
		return 1;
    }    
    return 0;
}

show_stats()
{
    int i;
    ::show_stats();
    write("Directions guarded:\n");
    for(i=0; i<sizeof(guarded_dirs); i++)
    	write(" ("+(i+1)+") "+guarded_dirs[i]+" ");
    write("\nDestinations guarded:\n");
    for(i=0; i<sizeof(guarded_dests); i++)
    	write(" ("+(i+1)+") "+guarded_dests[i]+" ");
    write("\n");
}

set_stop_msg(str) { stop_message = str; }
query_stop_msg()  { return stop_message; }

add_guard_dir(dir)
{
    guarded_dirs += [ dir ];
}

add_guard_dest(dest)
{
    guarded_dests += [ dest ];
}

