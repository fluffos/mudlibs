/*
 *
 * 	Shattered World's Standard Weapon File.
 *
 *	Originally written by: Unknown.
 *
 *	Warning: Don't just copy this file. Use the /std/weaponer or
 *		inherit it if you have to.
 *
 * Revision History
 * 921013 Rattcherryh - updated and damage_status() added
 * 940314 Hunter      - now inherits /std/wieldable.c
 * 950601 Jenna	      - made show_stats() return weapon_class(), not
 *                      class_of_weapon
 * 950831 Jenna	      - several minor modifications so that this file
 *			meshes well with new /obj/distance_weapon.c.
 *			Includes mods to show_stats(), query_long().	
 * 951121 Darkryln    - minimum strength and dex requirements added.
 * 990901 Jenna	      - damage type added.	
 * 991208 Jenna	      - stopped "weapon_name" command using add_id(),
 *			because it allows players to abuse shops 
 *			("weapon_name plate").	
 * 000928 Jenna	      - added 'weapon_type'
 * 010330 Jenna	      - changed hit_func from an object (ie only one
 *			hit_func could exist for each wep) to an array,
 *			to allow multiple hooks	
 */

inherit "std/wieldable";

#define File(x) file_name(x)

int class_of_weapon, def_bonus, off_bonus;
int min_str, min_dex;
string cap_name, name_of_weapon, familiar, very_short, weapon_type;
// object hit_func;
array hit_func;

array dam_type;

show_stats() 
{
    int i;
    string hf = "";

    ::show_stats();
    if (hit_func)
	for (i = 0; i < sizeof(hit_func); i++)
	    hf += (objectp(hit_func[i]) ? File(hit_func[i]) :
		  hit_func[i]) + "\n";
    else
	hf = "none";

    write(
		"name_of_weapon: " + name_of_weapon + "\n" +
		"cap_name: " + cap_name + "\n" +
		"weapon_type: " + weapon_type + "\n" +
		"class_of_weapon: " + this_object()->weapon_class() + "\n" +
                "off_bonus: " + off_bonus + "\n" +
                "def_bonus: " + def_bonus + "\n" +
		"hit_func: " + hf + "\n"
		);
}

reset(NotFirst) 
{
    ::reset(NotFirst);

    if (NotFirst)
	return;

    add_id("weapon"); 		/* all weapons id to `weapon' */
    value = 0;
}

init (arg) 
{
    ::init(arg);
    add_action("set_familiar","weapon_name");
}

set_familiar (name) 
{
array idies = query_ids();

	very_short = idies[1];

	if (!name) {
		if (!query_familiar()) {
			write("The "+very_short+" has no name.\n");
			write("To name it : weapon_name <title>.\n");
			return 1;
		}
		write("This "+very_short+" is named "+query_familiar()+".\n");
		return 1;
	}

/*
	notify_fail("The "+very_short+" has already been named.\n");
	if (query_familiar()) return 0;
*/

	familiar=name;
/*	add_id(name);   */ /* Jenna Dec 99 */
	write("You name your "+very_short+" "+query_familiar()+".\n");
	return 1;
}

query_familiar () 
{
    if (familiar) 
	return capitalize(familiar);
}


query_long()
{
string ret = ::query_long();
    if (weapon_class()) /* Don't supply damage status on stuff like rocks */
 	   ret += "It " + damage_status() +  ".\n";
    if (query_familiar())
	ret += "This "+very_short+" has been named  "+query_familiar()+".\n";
    return ret;
}

damage_status() 
{
array Messages;

    Messages = DAMAGE_STATUS->query_messages();

    if (!query_property("BREAK"))
	return Messages[0];
    else if (query_damage() >= query_property("BREAK")[2])
	return Messages[9];
    else
	return Messages[query_damage() * 10 / query_property("BREAK")[2]];
}

weapon_class() 
{
    if (this_object()->query_broken())
	return 1;
    return (class_of_weapon > 25 ? 25 : class_of_weapon);
}

damage_type() { 
    int i, total;
    int r = random(100) + 1;

    if (!pointerp(dam_type))
	dam_type = [ "impact", 100 ]; /* temporary thang */
    if (sizeof(dam_type) < 3)
	return dam_type[0];
    for (i = 0, total = 0; i < sizeof(dam_type); i += 2) {
	if (r <= dam_type[i+1] + total)
	    return dam_type[i];
	total += dam_type[i+1];
	}
    return dam_type[0]; /* should never get to this */
    } 

hit(attacker, hitloc) 
{
    int i, ret, tmp;

    if (hit_func && !attacker->query_wiz())
    {
	for (i = 0; i < sizeof(hit_func); i++)
	{
	    if (!hit_func[i]) /* dested object */
	    {
		hit_func = hit_func[..i-1] + hit_func[i+1..];
	    }
	    else
	    {		
		tmp = hit_func[i]->weapon_hit(attacker, hitloc);
		if (tmp == -1)
		    ret = -1;
		else if (ret != -1)
		    ret += tmp;
	    }
	}
	return ret;
    }
    return 0;
}

set_name(Name) 
{
    add_id(Name);
    name_of_weapon = Name;
    cap_name = capitalize(Name);
    if (!short_desc)
	set_short(cap_name);
}

set_short(Short) 
{
    short_desc = Short;
    if (!long_desc)
	set_long(short_desc + ".\n");
}

set_alt_name(n) { add_id(n); }
set_class(c) { class_of_weapon = c; }
set_def_bonus(i) { def_bonus = i; }

set_hit_func(ob) 
{
    if (!ob)
	return remove_hit_func(caller()); // backwards compat
    return add_hit_func(ob); 
}

add_hit_func(object ob)
{
    if (!hit_func)
	hit_func = [ ];
    if (objectp(ob) && index(hit_func, ob) == -1)
        hit_func += [ ob ];
}

remove_hit_func(object ob)
{
    int x;

    if (!hit_func)
	hit_func = [ ];
    x = index(hit_func, ob);
    if (x != -1)
	hit_func = hit_func[..x-1] + hit_func[x+1..];
}

set_off_bonus(i) { off_bonus = i; }
set_requirements(st, dx) { min_str=st; min_dex=dx; }
set_robust(n) { add_property("BREAK", 0, n); }
set_skill(st) { }
set_type(cl) { weapon_type = cl; }
set_wep_light(l) { set_light(l); }
set_damage_type(a) { dam_type = a; }

query_def_bonus() { return def_bonus; }
query_hit_func(ob) 
{
    if (!hit_func)
	hit_func = [];
    if (!ob) return hit_func;
    return index(hit_func, ob) != -1;
}
query_name() { return name_of_weapon; }
query_off_bonus() { return off_bonus; }
query_short() { return short_desc; }
query_requirements() { return ({ min_str, min_dex }); }
query_damage_type() { return dam_type; }
query_type() { return weapon_type; }
query_weapon_type() { return weapon_type; }
