inherit "std/object";
/*
	locking / unlocking object. ie. a key 
*/

string type;
string code;

show_stats() {
	::show_stats();
	write("type: "+type+"\ncode: "+code+"\n");
}

reset(arg) {
	if (arg) return;
	set_id("key");
	set_short("A key");
}

long() { 
    if (type == 0) write("This is a nondescript key.\n");
    else write("This is a " + type + " key.\n");
	::long();
 }

query_weight() { return 0; }
query_type() { return type; }
query_code() { return code; }
set_type(str) { type = str; 
	add_id(type+" key");
	}
set_code(str) { code = str; }

/* backward hack for std/door.h */
set_key_data(str) 
{
    string t,c;
    array allargs;

    allargs = STRINGS->split_first(str, " ");
    if (sizeof(allargs) != 2) return 0;
	set_type(allargs[0]);
	set_code(allargs[1]);
	return 1;
}
	
query_key() { return 1; }
