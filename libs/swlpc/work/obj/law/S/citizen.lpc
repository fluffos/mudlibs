list_all_citizens() { return query_all_citizens(1, 1); }

/* Number of citizens logged in between 'since' and now */
int query_active_since ( int since) 
{
int i,count=0;

	for (i = sizeof (last_on); i--;) {
		if (last_on[i] > since) count ++;
		}
	return count;
}

query_active_citizens(int since)
{
    int i,count=0, x;

	for (i = sizeof (last_on); i--;) 
    {
		if (last_on[i] > since) count ++;
	}

    array who = allocate(count);

	for (i = sizeof (last_on); i--;) 
    {
        if (last_on[i] > since)
        {
            who[x] = citizens[i];
            x++;
        }
	}
    return who;
}
	
clear_inactive_citizens()
{
	int i,count,x=0;

	for (i = sizeof(last_on); i--;) 
	{
		if (last_on[i] < (time() - 4838400)) count++;
	}

	if (count) {
		array who = allocate(count);
	
		for (i = sizeof(last_on); i--;) 
		{
			if (last_on[i] < (time() - 4838400))
			{
				who[x] = citizens[i];
				x++;
			}
		}
		for (i = sizeof(who); i--;)
		{
			remove_citizen(who[i]);
		}
		LAW_BOARD->create_note("Law Scribes",
		    "Citizenship revoked",
		    "\nThe Law Offices wish to advise that due to inactivity" +
		    " as stipulated in law 543, the following players have" +
		    " had their citizenship revoked:\n\n" +
		    implode(STRINGS->cap_array(who), ", ") + ".\n");
        }
	return 1;
}

