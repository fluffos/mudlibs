inherit "std/object";

/*
 * This is a boring torch.
 * Modified by Billy to use /std/light, and Roam to give random fuel.
 */

reset(arg) {
    ::reset(arg);
    if (!arg)
        {
        set_id("torch");
	set_short("a torch");
        set_lit_desc("It is made of straw and tar. It burns feebly.\n");
        set_unlit_desc("It is made of straw and tar. It doesn't look " +
        	"like it would last very long.\n");
	set_water(0, "The " + query_name() + " fizzles and goes out.\n");
        set_fuel(400+random(200));
        }
}

