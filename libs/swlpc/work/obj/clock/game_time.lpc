/* Orignally from the game_clock.c, this file was 
		heavily changed by Llati, 1/94 */

#include <Servers.h>
#include <time.h>

inherit BASE;

#define SAVETIME 1800	/* seconds between saves of clock */

#define MINUTES 60
#define HOURS 24
#define DAYS 28
/* If you change the number of months, you MUST change the query_month_s()
   function, or else things will not always work correctly.
*/
#define MONTHS 12

show_stats() {
int count;
int t;
	write("current time: "+time ()+"    ("+query_time()+" "+
	query_date()+")\n");
}
  

reset(arg) {
    if(!arg) {
    add_id ("game_clock");
    }
    return;
}
/* Will return the number of MINUTES that has passed since creation */ 
int query_gtime(int time) {	/* What is the current game time? */
  if (time) return time/REAL_SEC_TO_GAME_MIN;
	return time() /REAL_SEC_TO_GAME_MIN;
	}

string query_month_s(int month)
{
array Months = [ 
    "Jonevar", "Feyevar", "Marris", "Avril",
     "Maia", "Yuven", "Yulen", "Anitul",
     "Septander", "Octander", "Novander", "Decander"
     ] ;

    if (!month) month = query_month();
    else if (month > MONTHS) month = query_month(month);
    if (month <= MONTHS) return Months [month-1];
    return "error";
}

/* time is the number of real world seconds! */
int query_day(int time) {
    if (!time) time = time();
    return time/(REAL_SEC_TO_GAME_MIN*MINUTES*HOURS)%DAYS + 1;
}
int query_month(int time) {
    if (!time) time = time();
    return time/(REAL_SEC_TO_GAME_MIN*MINUTES*HOURS*DAYS)%MONTHS + 1;
}
int query_year(int time) {
    if (!time) time = time();
    return time/(REAL_SEC_TO_GAME_MIN*MINUTES*HOURS*DAYS*MONTHS);
}
string query_date(int time) { 
		if (!time) time = time();
		return query_day(time)+"/"+query_month(time)+"/"+query_year(time); 
		}
int date_to_seconds (string date) {
	  array dt;
	  int i;
	  dt = explode (date,"/");
	  for (i =3; i--; ) dt[i] = atoi (dt[i]);
	  return ( dt[0]-1 + (dt[1]-1)*DAYS + dt[2]*DAYS*MONTHS)*HOURS*MINUTES*REAL_SEC_TO_GAME_MIN;
	  }
	  		
string query_date_s(int time) { 
		if (!time) time = time();
		return query_month_s(time)+" "+query_day(time)+", "+query_year(time);  
		}
int query_minute(int time) {
    if (!time) time = time();
    return (time/REAL_SEC_TO_GAME_MIN)%MINUTES;
}
int query_24_hour(int time) {
    if (!time) time = time();
    return (time/(REAL_SEC_TO_GAME_MIN*MINUTES))%HOURS;
}
int query_12_hour(int time)
{
    int hour;
    hour = query_24_hour(time);
    return (hour > HOURS/2) ? hour-HOURS/2:((hour == 0) ? HOURS/2:hour);
}
int query_hour(int time) { return query_24_hour(time); }
int query_am(int time) { return (query_24_hour(time) < HOURS/2); }
int query_pm(int time) { return (query_24_hour(time) >= HOURS/2); }
int query_midnight(int time) { return (query_24_hour(time) == HOURS && !query_minute(time)); }
int query_noon(int time) { return (query_hour(time) == HOURS/2 && !query_minute(time)); }
string query_am_pm(int time) {
    if(query_am(time)) return "am";
    else if(query_pm(time)) return "pm";
    else if(query_noon(time)) return "noon";
    else return "midnight";
}
/* appended by xerces 28/2/95 */

int query_em(int time) {return ((query_24_hour(time) > 8) && (query_24_hour(time) <= 10));}
int query_lm(int time) {return ((query_24_hour(time) > 10) && (query_24_hour(time) <= 12));}
int query_an(int time) {return ((query_24_hour(time) > 12) && (query_24_hour(time) <= 16));}
int query_ev(int time) {return ((query_24_hour(time) > 16) && (query_24_hour(time) <= 20));}

string query_day_phase(int time) {
    if(query_em(time)) return "early morning";
    else if(query_lm(time)) return "morning";
    else if(query_an(time)) return "afternoon"; 
    else if(query_ev(time)) return "evening";
    else return "night";
}
/* end of insert */ 
string query_time(int time) { 
    int hour, minutes;
    hour = query_24_hour(time);
    minutes = query_minute(time);
    return (((hour>9)?""+hour:"0"+hour)+ ":" +
	    ((minutes>9)?""+minutes:"0"+minutes)); 
}
int query_time_24(int time) { return query_time(time); }
string query_time_12(int time) {
    int hour, minutes;
    hour = query_12_hour(time);
    minutes = query_minute(time);
    return(((hour>9)?""+hour:"0"+hour)+ ":" +
           ((minutes>9)?""+minutes:"0"+minutes))+ " "+query_am_pm(time);
}

/* This is an important function! If you want to know the number of
	RL seconds that x,y game hours,minutes so that you can schedule an
	alarm for the right time */
int convert_hours_minutes(int h, int m) { return (h*MINUTES + m)*REAL_SEC_TO_GAME_MIN; }

int minutes_in_hour () { return MINUTES; }
int hours_in_day () { return HOURS; }
int days_in_month () { return DAYS; }
int months_in_year () { return MONTHS; }
int query_abs_day() { return query_gtime()/(MINUTES*HOURS); }
int query_abs_time() { return time(); }

#define AUTUMN_MONTH 3
#define WINTER_MONTH 6
#define SPRING_MONTH 9
#define SUMMER_MONTH 12

#define DARKMOON 3
#define WAXING_CRES 5
#define WAXING_GIB 11
#define FULLMOON 17
#define WANING_GIB 19
#define WANING_CRES 26

query_moon(day) {
    if (!day) day = query_day();
    else if (day > DAYS) day = query_day(day);
    if(day >= DARKMOON && day < WAXING_CRES) return "new";
    if(day >= WAXING_CRES && day < WAXING_GIB) return "waxing crescent";
    if(day >= WAXING_GIB && day < FULLMOON) return "waxing gibbous";
    if(day >= FULLMOON && day < WANING_GIB) return "full";
    if(day >= WANING_GIB && day < WANING_CRES) return "waning gibbous"; 
    if(day >= WANING_CRES || day < DARKMOON) return "waning crescent"; 
    return "error";
}
query_season(month) {
    if (!month || month > MONTHS)
	month = query_month(month);
    if (month >= AUTUMN_MONTH && month < WINTER_MONTH) return "autumn";
    if (month >= WINTER_MONTH && month < SPRING_MONTH) return "winter";
    if (month >= SPRING_MONTH && month < SUMMER_MONTH) return "spring";
    if (month >= SUMMER_MONTH || month < AUTUMN_MONTH) return "summer";
    return "error";
}
