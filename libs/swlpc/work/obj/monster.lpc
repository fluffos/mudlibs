string regen_home = "room/city/endo";

int set_regen_home(string spot)
{
    if (load_object(spot))
    {
        regen_home = spot;
        return 1;
    }
    else return 0;
}

second_life() 
{
    disable = ({ });
    if (query_hp() < 0) set_hp(max_hp());
    attacker_ob = 0;
    call_out("check_fucked_mapper", 6, environment(this_object()));
/*    num_deaths++; */
    if (environment(this_object())) { /* && !random(num_deaths)) */
        walk_soul = present("tracker_soul", this_object());
        if (walk_soul) {
 	    walk_soul->set_move_speed(3.0);
	    walk_soul->set_sf_callbacks("remove_ghost", "dest_me");
	    call_out("off_you_go", 3);
    	    return 1;
	    }
        }

    if (query_store("dead_again") == 1) return 0;
    if (!no_regenerate && create_room &&
	(index(I_breathe, "air") != -1 || index(I_breathe, "anything") != -1))
	    return start_vampire();
    return 0;
}

off_you_go()
{
    this_object()->init_command("walk " + regen_home);
}

start_vampire() 
{
    walk_soul = clone_object("std/map/track");
    move_object(walk_soul, this_object());
    if (!walk_soul)
	return 0;
    walk_soul->set_move_speed(3.0);
    walk_soul->set_sf_callbacks("make_vampire", "dest_me");
    this_object()->init_command("walk room/city/endo");
    return 1;
}

make_vampire() 
{
    add_store("dead_again",1);
    remove_ghost();
}

remove_ghost()
{
    if (!ghost) return 0;
    add_store("dead_again",0);
    remote_say("Some mist disappears.\n");
    remote_say(cap_name + " appears in a solid form.\n");
    ghost = 0;
    /* set_light(-1); */
    msgin = "arrives";
    msgout = "leaves";
    walk_soul = present("tracker_soul", this_object());
    if (walk_soul)
    {
        walk_soul->set_sf_callbacks(0, 0);
        if (create_room)
	    this_object()->init_command("walk "+file_name(create_room));
    }
    return 1; 
}

/* If mob is a ghost and not moving, it's been fucked by the mapper.
 * If the mapper errors out, the fail function (dest_me) is never
 * called - Jenna March 2000
 */
check_fucked_mapper(where_was_i) {
    if (ghost && environment(this_object()) == where_was_i)
	dest_me();
    }

dest_me() 
{ 
    if (!random(4))
	SHOUT->shout("A ghost wails eerily.\n");
    destruct(this_object());
}
/*
 * This is called before a creature is allowed to die.
 * If it returns 0 the monster will die, otherwise it will survive.
 * Note that if the monster survives, its exp_points should be set back
 * to a higher value.
 */
creature_immortal()
{
    int tmp = 0;

	if (dead_ob)
		tmp= dead_ob->monster_died(this_object());

	test_loop++;
	if ((tmp!=0) && (test_loop>5)) 
	{
	log_file("qarath","\nCreature : "+file_name(this_object())+"\n"+
	 "Location :"+file_name(environment(this_object()))+"\n"+
	 "Attacker (last) : "+query_attack()+"\n"+
	 "Attacker (owner): "+query_attack()->query_owner()+"\n"+
	 "->monster_died() = "+tmp+"\n");
		destruct(this_object());
		return 0;
	}
	return tmp;
}

set_random_pick(r) { random_pick = r; }

pick_any_obj() { /* Jenna Dec 99 */
    int i;
    array c;

    if (!objectp(environment(this_object())) ) 
	return;
    if (!query_NPC())
	return;
    if (present("corpse", environment(this_object())))
	init_command("get all from corpse");
    init_command("get all");
    c = contents(this_object());
    for (i = 0; i < sizeof(c); i++)
      if (c[i])
	if (c[i]->id("corpse") || c[i]->query_quest_item())
	    init_command("drop "+c[i]->query_short_desc());
    init_command("wear all");
    wield_best_weapon();
    }

