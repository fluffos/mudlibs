dumpa(str) 
{
    string foo;
    if (STRINGS->match_head(str, ({ "players/" })) ) return 0;
    if(!str) str = "MONSTER_DUMP";
    save_object(str);
}

set_init_ob(ob) { init_ob = ob; }

init() 
{
    int i;
    if (!create_room && me) create_room = environment();
    if (this_player() == this_object()) return;
    if (query_ghost()) return;
    if (init_ob)
      if (init_ob->monster_init(this_object())) return;
    if (this_player() -> query_invis() >= NO_SHORT) return;
    object tsoul = present("thief soul", this_player());
    if (tsoul && tsoul->ignore_me(this_object())) return;
    if (attacker_ob) 
    {
	    if (attacker_ob == this_player())
		    attacker_ob->start_attack_cycle();
	    start_attack_cycle();
	}
    if (!this_object()->query_NPC())
	return 0;
    if (this_player()->query_living() && valid_attack(this_player())) {
  	kill_ob = FIGHT_SERV->next_attacker(this_object());
        if (aggressive > 1)
            kill_ob = this_player();
        if (aggressive) {	/* kill 'em if they aint too wimpy */
  	    if (this_player()->query_max_hp() * query_chu() >= (max_hp * this_player()->query_chu() / 4))
       	       kill_ob = this_player();
	start_attack_cycle();
  	}
    }
    if (this_player()->is_player()) {
	if (!is_talking && chat_head && sizeof(chat_head))
		if (find_call_out("start_talking") < 0)
			call_out("start_talking", 2);
	}
    if (sizeof(xtra_add_actions)) 
    {
        for(i=0; i<sizeof(xtra_add_actions); i=i+3)
            add_action("xtra_add_act", xtra_add_actions[i]);
    }
}

xtra_add_act(str)
{ 
    int i=index(xtra_add_actions, query_verb());
    if (i == -1) return 0;
    if (xtra_add_actions[i+1])
		return xtra_add_actions[i+1]->(xtra_add_actions[i+2])(str);
}

add_xtra_action(comm, ob, func)
{
    if(index(xtra_add_actions, comm) == -1)
        xtra_add_actions += ({ comm, ob, func });
}

do_spell_attack(str) {
    int i, x;
    string tmp1, tmp2;

    if (!spells || !sizeof(spells))
	return 0;
    for (x = -1, i = 0; i < sizeof(spells); i += SIZEOF_SPELLS)
	if (str == spells[i+SPELL_CMD_OFFSET])
	    x = i;
    if (x == -1)
	return 0;
    if (query_sp() < spells[x+SPELL_SP_OFFSET])
	return 0;
    add_sp(-spells[x+SPELL_SP_OFFSET]);

    tmp1 = STRINGS->string_replace(spells[x+SPELL_MSG_OFFSET],
	"$m", query_name());
    tmp2 = STRINGS->string_replace(tmp1, "$v", attacker_ob->query_name());
    say(capitalize(tmp2) + "\n", attacker_ob);
    tmp2 = STRINGS->string_replace(tmp1, "$v", "you");
    FIGHT_SERV->combat_msg(attacker_ob, capitalize(tmp2) + "\n");
    tmp1 = STRINGS->string_replace(spells[x+SPELL_MSG_OFFSET],
	"$v", attacker_ob->query_name());
    tmp2 = STRINGS->string_replace(tmp1, "$m", "you");
    FIGHT_SERV->combat_msg(this_object(), capitalize(tmp2) + "\n");

    return attacker_ob->hit_player(spells[x+SPELL_DTYPE_OFFSET],
	spells[x+SPELL_DAM_OFFSET]);
    }

query_spells() { return spells; }

list_spells() {
    int i;
    string ret, dis;
    array others = [ ], c;

    dis = "";
    c = contents(this_object());
    for (i = 0; i < sizeof(c); i++)
        if (c[i]->id("distance weapon") && !c[i]->short() && c[i]->query_shootable())
            dis += " \"" +
                FORMAT->left_justify("fire "+c[i]->query_shootable_name()+" <direction>\"", 18) +
                FORMAT->left_justify(c[i]->query_shoot_damage() + " dam", 10) +
                FORMAT->left_justify(c[i]->query_sp_cost() + " sp", 10) + "\n"; 
    if (dis != "" || (spells && sizeof(spells))) {
	ret = "You have the following special attacks:\n";
	if (arrayp(spells))
	  for (i = 0; i < sizeof(spells); i += SIZEOF_SPELLS)
	    ret +=  " \"" + 
		FORMAT->left_justify(spells[i+SPELL_CMD_OFFSET] + "\"", 18) +
		FORMAT->left_justify(spells[i+SPELL_DAM_OFFSET] + " dam", 10) +
		FORMAT->left_justify(spells[i+SPELL_SP_OFFSET] + " sp", 10) +
		"\n";
	if (dis)
	    ret += dis;
	}
    if (commands && sizeof(commands)) {
	if (!ret)
	    ret = "You";
	else
	    ret += "You also";
	ret += " have the following powers:\n " + implode(commands, ", "); 
	}
    if (!ret)
	ret = "You have no special attacks or powers.\n";
    MORE->more(ret);
    return 1;
    }

query_spell_commands() {
    array ret = [ ];
    int i;

    if (!spells) return ret;
    for (i = 0; i < sizeof(spells); i += SIZEOF_SPELLS)
	ret += [ spells[i+SPELL_CMD_OFFSET] ];
    return ret;
    }

start_attack_cycle() {
int react_time;

    if (!is_talking && a_chat_head && sizeof(a_chat_head))
		 call_out("start_talking", 3);

    wield_best_weapon(); 
	/* This is called even if combat is continuing, not starting
	   (tested in the next line), because it enables the monster
	   to switch between a distance weapon and a close-up weapon. 
		Jenna 950828 */
    if (find_call_out("attack_cycle") > -1) return;
    react_time = 120 / (1 + query_str() + query_chu() + query_dex());
    if (react_time < 1) react_time = 1;
    if (react_time > 5) react_time = 5;
    in_combat = 1;
    call_out("attack_cycle", react_time);
}

start_talking()
{
    int next_time, c;
    string next_chat;

    is_talking = 1;

    if(query_ghost() || !query_NPC()) return;
    if (attacker_ob && (0 <= index(contents(environment(this_object())), attacker_ob)) && a_chat_head && sizeof(a_chat_head)) 
    {
    	if (!a_chat_chance) return;			
        c = random(sizeof(a_chat_head));
        remote_say(a_chat_head[c]);
    	next_time = random(TALK_FREQ/a_chat_chance) + 1;
    } else if (!attacker_ob && chat_head && sizeof(chat_head)) 
    {
    	if (!chat_chance) return;		/*To stop errors when chat is stoped */
        if (!rumours || (random(2) == 0))
            next_chat = chat_head[random(sizeof(chat_head))];	/* -Squawk */
        else
            next_chat = cap_name + " says: " + RUMOUR->get_rumour();
        remote_say(next_chat);
    	next_time = random(TALK_FREQ/chat_chance) + 1;
    }

    if (random_pick) random_pickup();

    if (next_time < MIN_TALK_DELAY)
	next_time = MIN_TALK_DELAY;	/* Jenna Dec 98 */

    if (test_if_any_here()) call_out("start_talking", next_time);
    else is_talking = 0;
}

attack_cycle() 
{
    int x, c, react_time;
    object attack_soul;

    if (query_ghost()) return;
    in_combat = 1;
    if (!attacker_ob && kill_ob && present(kill_ob, environment(this_object())))
    {
    	attack_object(kill_ob);
    	kill_ob = 0;
   	react_time = 120 / (query_str() + query_chu() + query_dex());
    if (react_time < 1) react_time = 1;
    if (react_time > 5) react_time = 5;
	call_out("attack_cycle", react_time);
    	return; 
    }

    if (attacker_ob && present(attacker_ob, environment(this_object()))
  	&& !attacker_ob->query_ghost() && query_NPC()) 
    {
        /* temporary Hack until combat soul has such usage */
	if (xtra_attack_ob) 
        {
	        call_other(xtra_attack_ob,xtra_attack_func, this_object(),
		    attacker_ob );	
	}
        /* end of hack */

	if (spells && sizeof(spells)) 
	{
	    x = random(sizeof(spells)/SIZEOF_SPELLS)
		* SIZEOF_SPELLS;

        /* less special attacks when no sp */
	    if (spells[x+SPELL_CHANCE_OFFSET] > random(100)
	        && query_sp() > random(50)) 
	             init_command(spells[x+SPELL_CMD_OFFSET]);
	}

        else if (random(100) < comm_chance && extra_comm)
        {
            if (commands && sizeof(commands) > 0)
	            command(commands[random(sizeof(commands))], this_object()); 
        }
    }
    FIGHT_SERV->attack(this_object());
    if (attacker_ob && (wimpy==0) && (hit_point < max_hp/4) && random(2))
	    this_object()->run_away();
    else if (attacker_ob && (wimpy>0) && (hit_point <= wimpy) && random(2))
	    this_object()->run_away();
   

    if (test_if_any_here()) {
	react_time = 120 / (query_str() + query_chu() + query_dex() + 1);
        if (react_time < 1) react_time = 1;
        if (react_time > 5) react_time = 5;
	call_out("attack_cycle", react_time);
    }
    else {
	in_combat = 0;
	return;
    }
}

set_xtra_attack(ob, fun) {
	if (!ob || !fun || !stringp(fun)) return 0;
	xtra_attack_ob = ob;
	xtra_attack_func = fun;
	return 1;
}
 	
