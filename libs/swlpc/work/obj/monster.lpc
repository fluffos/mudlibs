set_can_kill(a) { can_kill = a; }
/*
 * Now some functions for setting up spells !
 */

/*  The percent chance of casting a spell.  */
set_chance(c) { spell_chance = c; }

/* Can a monster regenerate after death? - default yes. */
set_no_regenerate(c) { no_regenerate = c; }

/* Message to the victim. */
set_spell_mess1(m) { 
	spell_mess1 = m; 
	call_out("log_for_jen", 3);
	}
set_spell_mess2(m) { spell_mess2 = m; }
set_spell_dam(d) { spell_dam = d; }

query_spell_chance() { return spell_chance; }
query_spell_mess1() { return spell_mess1; }
query_spell_mess2() { return spell_mess2; }
query_spell_dam() { return spell_dam; }

log_for_jen() {
	catch {
		LOG->log("SPELLS", short() + " (" + file_name(this_object()) +
		") in " + environment(this_object())->short() + " ("+
		file_name(environment(this_object())) + ")");
	       };	
	}

add_attack(string cmd, string msg, int dam, string dtype, int chance, int sp) {
    object csoul = present("generic/combat", this_object()); 

    if (!csoul)
	return 0;
    if (!spells)
	spells = [ ];
    if (index(spells, msg) != -1)
        return;
    spells += [ cmd, msg, dam, dtype, chance, sp ];
    csoul->add_spell_attack(cmd);
    return 1;
    }

/*
 * Set the wimpy mode
 * 0 = is wimpy on max_hp/4
 * > 0 is a hp value to wimp out at
 * -1 = is not wimpy.
 * Bizarre, yes. But all in the name of backward compatibility. *sigh*
 */
set_wimpy(int wimp_value) { wimpy = wimp_value; }
query_wimpy() { return wimpy; }

/*
 * Force the monster to do a command. The force_us() function isn't
 * always good, because it checks the level of the caller, and this function
 * can be called by a room.
 */
init_command(cmd) { return command(cmd, this_object()); }
					// last arg added by Jenna Mar '01

/* Load chat */

set_chat_chance(c) { chat_chance = c; }
set_a_chat_chance(c) { a_chat_chance = c; }

remove_chat(str) { 
int x;
array a, b;
    x = index(chat_head, str);
    if (x == -1) return;
    chat_head = chat_head[0..x-1] + chat_head[x+1..];
    if (!sizeof (chat_head)) set_chat_chance (0);
}

query_chat() { return chat_head; }
query_a_chat() { return a_chat_head; }

load_chat(strs, chance) 
{
    if (pointerp(strs)) {
	chat_head += strs;
    }
    else {
    chat_head = ({ strs }) + chat_head;    
    }
    if (chance) chat_chance = chance;
}

set_rumours(int on, int chance)
{
   rumours = on; 
   if (chance) chat_chance = chance;
}

/* Load attack chat */
load_a_chat(strs, chance) {

    if (pointerp(strs)) {
	a_chat_head += strs;    
    }
    else {
        a_chat_head = ({ strs }) + a_chat_head;    
    }
    if (chance) a_chat_chance = chance;
}

/* Catch the talk */

#define BEGIN 1
#define END 2

query_catch_shout_ob() {
        int i;

        if (pointerp(talk_ob)) 
        {
            for (i = 0; i < sizeof(talk_ob); i++)
                if (!talk_ob[i]) talk_ob = ARRAY->delete(talk_ob, i, 1);
		    return sizeof(talk_ob);
		}
        return 0;
	}

add_catch_shout_ob(object ob) 
{ 
    SHOUT->listen(this_object());
    return set_object(ob); 
}

set_object(object ob) 
{ 
    if (!talk_ob) talk_ob = [ ob ];
    else if (index(talk_ob, ob) != -1) return 0;
    else talk_ob = [ ob ] + talk_ob;
    return 1;
}

set_function(str) { hold_func = str; }
set_type(str) { hold_type = str; }

set_match(ob, func, Ttype, match)
{
    int i;

    if (!func)     /* assume old-style set up sequence */
    {
        match = ob;
        func = hold_func;
        Ttype = hold_type;
	    ob = 0;
    }
    if (!func || !Ttype || !match) return 0;	
    query_catch_shout_ob(); /* removes dested items from talk_ob */	
    if (ob) set_object(ob);
    match = lower_case(match);
    if (!pointerp(talk_func))
    {    
        talk_func =  ({ func }) ;
        talk_type =  ({ Ttype }) ;
        talk_match = ({ match });
    }
    else
    {
        talk_func =  talk_func + ({ func });
        talk_type =  talk_type + ({ Ttype });
        talk_match = talk_match + ({ match });
    }
    talk_alpha = allocate(sizeof(talk_match));
    for (i = 0; i < sizeof(talk_alpha); i++)
    {
        talk_alpha[i] = 0;
        if (talk_match[i] && sizeof(talk_match[i]) > 0)
        {
            if (test_alpha(talk_match[i][0..0]))
                talk_alpha[i] = BEGIN;
            if (test_alpha(talk_match[i][strlen(talk_match[i])-1..strlen(talk_match[i])-1]))
                talk_alpha[i] = talk_alpha[i] | END;
        }
    }
}

/* test the overheard string against those in the talk_* arrays */
test_match(str) 
{
    string tmp, str1, str2;
    int i;
    real cotim = 0.0;

    if (!talk_match || !talk_type || !talk_func || !talk_alpha) return;
    if (!stringp(str)) return;

    str = lower_case(str);
    while (i < sizeof(talk_match) && i < sizeof(talk_alpha) &&
		i < sizeof(talk_type) && i < sizeof(talk_func) )
    {
        array allargs;

	if (!talk_ob || !sizeof(talk_ob))
	    set_object(this_object());

        if (talk_type[i])
             allargs = STRINGS->split_first(str, " " + talk_type[i]);

        if (allargs && sizeof(allargs) == 2)
        {
            if (!talk_match[i] || talk_match[i] == "") 
            {
		        cotim = cotim + 0.2;
                call_out("delayed_fcall", cotim, ({ talk_ob[0],talk_func[i],str}));
		        return;
	        }
            allargs = STRINGS->split_first(allargs[1], talk_match[i]);
            while (allargs && sizeof(allargs) == 2)
            {
                str1 = allargs[0];
                str2 = allargs[1];
                if ((str1 == "" || !(talk_alpha[i]&BEGIN) || !test_alpha(str1[strlen(str1)-1..strlen(str1)-1])) &&
                    (str2 == "" || !(talk_alpha[i]&END) || !test_alpha(str2[0..0])))
                {
#if 1
		            cotim = cotim + 0.2;
                    call_out("delayed_fcall", cotim, ({ talk_ob[0],talk_func[i],str}));
		            return;	
#endif
                }
                allargs = STRINGS->split_first(allargs[1], talk_match[i]);
            }
        }
        i += 1;
    }
}

/* To prevent recursive loops and stuff */
delayed_fcall(ofs) {
    if(objectp(ofs[0]) || (stringp(ofs[0]) && find_object(ofs[0])))
        call_other(ofs[0], ofs[1], ofs[2]);
    busy_catch_tell = 0;
    return;
}

/* is a given chatacter alpha? */
test_alpha(char)
{
    string c;

    c = lower_case(char);
    if (c[0] >= "a"[0] && c[0] <= "z"[0])
        return 1;
    else
        return 0;
}

