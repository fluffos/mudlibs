/* Add any combat-type commands the monster has. Kind of a hack
 * because it can't use many commands properly (it doesn't do
 * args, for example).
 */
add_commands(locals)
{
    array nope = [ "help", "load", "unload", "fire", "shoot", "weapon_name" ];
    int i;
  
    for(i=0; i< sizeof(locals); i=i+3)
 	if(stringp(locals[i]) && locals[i+1]->id("soul") )
	    if(!locals[i+1]->id("handle") && !locals[i+1]->id("generic"))
		if(index(commands, locals[i]) == -1 
		   && index(nope, locals[i]) == -1)
		    commands+= ({ locals[i] });   
    extra_comm=1;
}

query_commands() { return commands; }

