can_put_and_get(str) 
{
    if (!str) return 0;
    return 1;
}

catch_tell(str)
{
    string temp;

    /* For remote logins by players! */
    if (receive_host) {
        remote_output(str);
    }
    if (query_catch_tell_ob()) {
	int i;

	if (!pointerp(catch_tell_ob))
		"players/jenna/jfuns"->tell_jen("No array catch_tell_ob in " + file_name(this_object()) + ".\n");
	for (i = 0; i < sizeof(catch_tell_ob); i++)
		catch_tell_ob[i]->catch_tell(str);
	}

    /* in case test_match generates text */
    if (busy_catch_tell)    return;

/* quick hack to prevent self-catches - G.  I'm unsure whether monsters
 * should hear themselves - it seems reasonable, but then...
 * Probably should be in the communication soul, if anything.
 */
    {
      array allargs;
      allargs = STRINGS->split_first(str, " ");
      if (allargs && !find_player(lower_case(allargs[0]))) return;
               /* I *said* it was a hack! */
    }

    busy_catch_tell = 1;
    if (talk_match) {
		string kludge;

		busy_catch_tell = 1;
		kludge = catch test_match(str);;
		if (kludge) alert_wizard(kludge);
		
/*		busy_catch_tell = 0; */
    }
    busy_catch_tell = 0; 
}

set_shout(str) 
{
	SHOUT->listen(this_object());
	shout_function = str;
}

catch_shout(str)
{
    string temp;

    if (query_catch_shout_ob())
    {
        int i;

        for (i = 0; i < sizeof(talk_ob); i++)
		if (talk_ob[i] != this_object())
                	talk_ob[i]->catch_shout(str);

	/* Support for old-style catch_shout */
        if (shout_function && shout_function != "catch_shout")
		call_out("send_shout", 1, str);
    }
}

send_shout(str)
{
	if (arrayp(talk_ob) && sizeof(talk_ob) > 0)
		talk_ob[0]->(shout_function)(str);
}

/*
 * Call the following functions to setup the monster.
 * Call them in the order they appear.
 */

set_name(n)
{
    name = lower_case(n);
    set_living_name(name);
    cap_name = capitalize(n);
    add_id(cap_name);
    add_id(name);
    if (!short_desc) short_desc = cap_name;
    if (!long_desc) long_desc = "You see nothing special.\n";

    if (!body_locations) set_body(MONSTERER->body("biped"));
}

/* A level booster so monsters can grow .. */
boost_level(int x)
{
    level = level + x;
    add_str((x+x*3/4+random(x*2))/3);
    add_con((x+x*3/4+random(x*2))/3);
    add_pow((x+x*3/4+random(x*2))/3);
    add_dex((x+x*3/4+random(x*2))/3);
    add_chu((x+x*3/4+random(x*2))/3);
    add_san((x+x*3/4+random(x*2))/3);
    add_siz((x+x*3/4+random(x*2))/3);
    add_int((x+x*3/4+random(x*2))/3);
    add_wis((x+x*3/4+random(x*2))/3);
}

set_level(int l)
{
    level = l;
    wimpy = 0;
    if (!weapon_class)
    weapon_class = WEAPON_CLASS_OF_HANDS;
    if (!query_str()) add_str(3+(l+l*3/4+random(l*2))/3);
    if (!query_con()) add_con(3+(l+l*3/4+random(l*2))/3);
    if (!query_pow()) add_pow(3+(l+l*3/4+random(l*2))/3);
    if (!query_dex()) add_dex(3+(l+l*3/4+random(l*2))/3);
    if (!query_chu()) add_chu(3+(l+l*3/4+random(l*2))/3);
    if (!query_san()) add_san(3+(l+l*3/4+random(l*2))/3);
    if (!query_siz()) add_siz(random(8)+random(8)+random(8));
    if (!query_int()) add_int(2+(l+l*3/4+random(l*2))/3);
    if (!query_wis()) add_wis(2+(l+l*3/4+random(l*2))/3);
	call_out("set_up_skills", 0.0);

    action = 0;
    if (!reaction) reaction = 2;
    max_hp = max_hp();
    if (!hit_point) hit_point = max_hp;
    if (!sp) sp = max_sp();
}

set_up_skills() {
	array sk = "RO/living/StatsTrack"->get_mon_skills();
	int l = level;

	if (arrayp(sk)) 
    {
		int x;
		for (x = 0; x < sizeof(sk); x = x + 4) 
        {
            /* binomial distribution */
			int rnd_skill = random(real2int(sk[x+1]) * l/2)  
						  + random(real2int(sk[x+1]) * l/2)
						  + random(real2int(sk[x+1]) * l/2)
						  + random(real2int(sk[x+1]) * l/2); 
			add_skill(sk[x], rnd_skill / 11); /* 10 is `average' level */
		}
	}

	/*
	 * Just in case the skills tracker is stuffed.
	 */

	if (!query_skill("offense"))
			add_skill("offense",10 + l * 8+random(l*4));
	if (!query_skill("defence"))
			add_skill("defence",10 + l * 8+random(l*4));
	if (!query_skill("dodge"))
			add_skill("dodge",10 + l * 8);
	if (!query_skill("rob_resist"))
			add_skill("rob_resist",10 + l * 4+random(l*4));
	if (!query_skill("distance-attacks"))
			add_skill("distance-attacks", 10 + l * 4+random(l*4)); 
	if (query_skill("immunity") < 20)
			add_skill("immunity", 20 + (l * 5));
	}

