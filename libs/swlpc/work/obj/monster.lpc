/* Make a monster wield the best weapon it has 
	Jenna */

wield_best_weapon() {
	array stuff = contents(this_object());
	int i, best_wep, best_wc;
	object current_wep;

	if (!query_NPC())
		return;
	for (best_wep = 0, best_wc = 0, i = 0; i < sizeof(stuff); i++)
		if (stuff[i]->id("weapon"))
			if (stuff[i]->weapon_class() > best_wc) {
				best_wc = stuff[i]->weapon_class();
				best_wep = i;
				}
	if (!best_wc)
		return;
	if (current_wep = this_object()->query_wielded()) {
		if (current_wep == stuff[best_wep])
			return; /* Already wielding best weapon */
		init_command("unwield " + current_wep->query_name());
		}
	init_command("wield " + stuff[best_wep]->query_name());
	return 1;
	}

regen_sp(n) {
	if (!n || find_call_out("regen_sp") != -1) return;
	add_sp(n);
	call_out("regen_sp", 30, n);
	}

query_NPC() { return !(this_object()->query_owner()); }

query_owner() {
	/* Search NPC souls for an owner */
	array a = contents(this_object());
	int i;

	for (i = 0; i < sizeof(a); i++)
		if (a[i]->id("npc soul") && a[i]->query_owner())
			return a[i]->query_owner();
	return 0;
	}


