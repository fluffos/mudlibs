	object iq = present("monster_IQ", this_object());
	if (iq)
		iq->react(arg1, arg2, arg3, arg4);
	}

set_catch_tell_ob(o) { return add_catch_tell_ob(o); }

add_catch_tell_ob(o) {
	if (!catch_tell_ob)
		catch_tell_ob = ({ });
	if (stringp(catch_tell_ob) || objectp(catch_tell_ob))
		catch_tell_ob = ({ catch_tell_ob });
	if (index(catch_tell_ob, o) != -1)
		return 0;
	catch_tell_ob += ({ o });
	return 1;
	}

query_catch_tell_ob() { 
	int i;

	if (pointerp(catch_tell_ob)) 
		for (i = 0; i < sizeof(catch_tell_ob); i++)
			if (!catch_tell_ob[i])
				catch_tell_ob = ARRAY->delete(catch_tell_ob, i, 1);
	return catch_tell_ob; 
	}

