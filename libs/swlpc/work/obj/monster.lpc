/* 950203 Ormuzd */

int able_to_wander=1;
int leaves_room=0;

wander()
{
    object attacker= this_object()->query_attack();

    if(!attacker) return;
	if(environment(attacker) != environment(this_object())) return;
    if(!able_to_wander) return;

    if(leaves_room > 2)
    {
        call_out("random_move",1,1);
        leaves_room=0;
    }
    else
       leaves_room++; 
}

set_can_wander(int allow) { able_to_wander=allow; }
query_can_wander() { 
	if (!able_to_wander && !present("distance weapon", this_object()))
		LOG->log("EASYMEAT", this_object()->query_name() +
			" the " + this_object()->query_std_mon_type() +
			" in " + file_name(environment(this_object())) +
			" is NO_WANDER without a distance weapon.\n");
	return able_to_wander; 
	}

