show_stats() {
	write("can_kill: "+can_kill+"\n");
	if (kill_ob) write("kill_ob: "+file_name(kill_ob)+" (\""+kill_ob->short()+"\")\n");
	if (query_info()) write("info: "+query_info()+"\n");
	write("body array: "+
	(pointerp(query_body())?MONSTERER->dump_body_array(query_body()):
		"<none>")+"\n");
}

/* currently testing these overrides of living.c Oct98 Dredd */
query_no_external_save() { return !is_persistent; }
query_no_external_restore() { return 0; }

set_persist(int x)
{
    is_persistent = x;
    if (x != 0)
    {
        AUTOSAVE_SERV->set_auto_save(this_object());
        /* set_persistent_id("P/npc/"+query_real_name()); */
    }
    else
    {
        /* set_persistent_id(0); */
    }
}

query_destruct()
{
    if (is_persistent) save_me();
    "RO/living"::query_destruct();
}

save_me(int final)
{
    NPC_PERSIST_SERV->save_npc(query_name());
    AUTOSAVE_SERV->set_auto_save(this_object());
}

valid_attack(ob) {
    /* Don't attack other monsters unless specifically allowed to. */
    if (!objectp(ob)) return can_kill;
	/* Don't attack in the city unless attacked */
	if (environment(this_object())) {
		if (environment(this_object())->query_property("npc_non_aggressive"))
			return 0;
		if (environment(this_object())->query_property("city"))
			return 0;
		}
	/* Otherwise, kill any non NPC, or NPCs if we are allowed to */
    return (!ob->query_npc(0) || can_kill);
}

reset(arg)
{
    ::reset(arg);
    if (arg) return;
    /* Only let this monster kill other monsters if specifically allowed. */
    can_kill = 0;
    is_npc = 1;
    no_regenerate = 0;
    enable_commands();
/*    me = this_object(); */
    create_room = 0;
    set_match(this_object(), "wander","leaves"," ");
    add_store("newbie_channel", 1); // off by default	
}

/*
 * The one in living only lets gods do it.
 */

set_race(r) { race = r; }

add_no_enter(r)
{
    int i;
    array tmp = this_object()->query_store("no_enter");

    if (stringp(r))
	r = [ r ];
    if (!arrayp(r)) return 0;
    if (tmp)
	r += tmp;
    for (i = sizeof(r) - 1; i >= 0; i--)
    	if (index(r, r[i]) < i)
    	    r = r[..i-1] + r[i+1..];
    this_object()->add_store("no_enter", r);
    return 1;
}

random_move(int nowander)
{
    array dd, no_go;
    int j;
    object o;

    o = environment(this_object());
    if (!o) return;
    dd = o->query_dest_dir();
    no_go = this_object()->query_store("no_enter");
    if (dd && no_go)
    {
	for (j = sizeof(dd) - 2; j >= 0; j -= 2)
	{
	    if (index(no_go, dd[j]) != -1)
	        dd = dd[..j-1] + dd[j+2..];
	}
    }
    if (dd && sizeof(dd))
    {
        j = (random((sizeof(dd))/2))*2 + 1;
        if (j < sizeof(dd))
            init_command(dd[j]);
    }
    if (random_pick) random_pickup();
    return 1;
}


random_pickup() 
{
int c;
    c = random(100);
    if(c < random_pick) this_object()->pick_any_obj();
}

short() {
	return short_desc+(sizeof(gods)?show_gods():"");
}

query_short() { return short_desc; }

long() 
{
    write(this_object()->query_long());
    write(this_object()->show_appearance());
}

