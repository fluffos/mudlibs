/* set_ac(int ac) { base_armour = ac; } */  /* Jenna Sep 99 */
set_ac(int i) { ac = i; }
query_ac() { return ac; }

#define MAXCO 256
set_move(n) 
{
    // This call_out is because otherwise the mob makes a move
    // immediately upon being loaded, which gives you no chance to
    // override it if you want, say, a cat that doesn't wander.
    // Jenna Apr 2001

    if (!n)
    {
	next_move(0); // to halt wandering, remove call_outs
	call_out("next_move", 2, 0); // to stop souls overriding
	return;
    }

    call_out("next_move", 5, n);
}

next_move(n)
{
    int i;

    if (n == 0 || !query_can_wander())
    {
	while (find_call_out("next_move") != -1 && i < MAXCO)
	{
	    remove_call_out("next_move");
            i++;
        }
	return;
    }
    object attacker=this_object()->query_attack();
    if (attacker && (environment(attacker) == environment(this_object()))
	|| !query_NPC()) /* dont move controlled mobs - Jenna 99 */
    {
        call_out("next_move", random(n)+random(n)+1, n);
        return;
    }

    if (random(n)) call_out("random_move",1,1);
    call_out("next_move", (random(n)+random(n)+1)*2, n);
}

