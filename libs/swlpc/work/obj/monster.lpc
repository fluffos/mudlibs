nosave alert_wizard(mess)
{
	string wiz;
	object them;

	mess = "test_match error: "+mess+"monster: "+short();
	if (create_room)
		mess += " from "+file_name(create_room);
	if (create_room && (wiz = query_su_name(create_room)))
