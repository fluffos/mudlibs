/*
*/

inherit "std/object";

object worn;

reset(arg) {
	if (arg) return;
	set_id( [ "backpack", "rucksack", "pack" ] );
	set_short("A backpack");
	set_long(
	"A sturdy adventurers backpack.\n");
	set_weight(1);
	set_value(30);
	add_property("CONTAINER","",30);
	add_property("CAN_OPEN");
}
 
show_stats() {
	::show_stats();
	if (worn) write("worn Ob: "+file_name(worn)+"\n");
}

init() {
    ::init();
    add_action("wear","wear");
    add_action("remove","remove");
}

short() {
    if (worn) return short_desc + " (worn)";
    return short_desc;
}

query_worn() { return worn; }
armour_class() { return 0; }

wear(str)
{
    object ob;
    object who;
	
    notify_fail("What would you like to wear?\n");
    if (!id(str)) return 0;
    if (environment() != this_player()) {
	notify_fail("You must get it first!\n");
	return 0;
    }
    who = environment(this_object());
    if (worn) {
	notify_fail("You're already wearing it!\n");
	return 0;
    }
	write("You slide the backpack up onto your back.\n");
	worn = this_player();
	return 1;
}

drop(silently) {
    if (worn) {
	worn = 0;
	if (!silently)
	    catch write("You drop your backpack.\n");;
    }
    return 0;
}

remove(str) {
    if (!id(str)) return 0;
    if (!worn)  return 0;
    write("You remove the backpack.\n");	
    worn = 0;
    return 1;
}

