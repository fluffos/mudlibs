/* special because of the frog curse.  sigh. */
comm_kiss(str) {
    object who;
    if (ghost() || !str)
        return 0;
    who = present(str, environment(this_player()));
    if (!who || !who->query_living() || who == this_player())
        return 0;
    tell_object(who, cap_name + " kisses you.\n");
    str = capitalize(str);
    say(cap_name + " kisses " + str + ".\n", who);
    write("You kiss " + str + ".\n");
    return 1;
}

