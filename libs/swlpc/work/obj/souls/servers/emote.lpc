}

/* drunk and happy - G :)  Verses off the net. */

comm_sing(str) {
    array ret;
    if (random(500) < this_player()->query_percent_intoxication()) {
	ret = "std/emotes"->sing_verse(this_player(), -1); /* random verse */
	}
    else
	ret = "std/emotes"->action(this_player(), "sing");
    if (ret && pointerp(ret)) {
	tell_object(this_player(), ret[0]);
	say(ret[1], this_player());
	return 1;
        }
    }

comm_ising(str) {
    string string1, string2;
    int temp;

    if (!str) return general("You sing about your tiny genitals.",
        "sings about "+GENDER->pos()+" tiny genitals.");
    str = capitalize(str);
    temp = random(4);
    if (temp == 0) {
        string1 = "what a boofhead "+str+" is.";
        string2 = "what a boofhead you are.";
    }
    if (temp == 1) {
        string1 = "the poultry "+str+" has had the pleasure to have known.";
        string2 = "the poultry you have had the pleasure to have known.";
    }
    if (temp == 2) {
        string1 = str+"'s tiny genitals.";
        string2 = "your tiny genitals.";
    }
    if (temp == 3) {
        string1 = "the pus leaking out of the sores on "+str+"'s bottom.";
        string2 = "the pus leaking out of the sores on your bottom.  "+
                  "(How the !@#$ did "+GENDER->sub()+" find out about them?!?)";
    }
    return specific("You sing about "+string1, "sings about "+string1, str,
        "sings about "+string2);
}

comm_insult(str) {
    int temp;
    string inslt;

    if (random(17)+15 < this_player()->query_int())
	return "players/thumpa/obj/book"->abuse(str);

    if (!str) return general("Insult WHO, you stupid geek?", 
        "insults "+GENDER->obj()+"self.");
    temp = random(8);
    str = capitalize(str);
    if (temp == 0) inslt = " a fetid dingo kidney";
    if (temp == 1) inslt = " a pool of putrescent pus";
    if (temp == 2) inslt = " a boiled eye-ball gobbling hairy-nosed git";
    if (temp == 3) inslt = " a geriatric pensioner molesting pervert";
    if (temp == 4) inslt = " a scabby-bottomed spotted toad";
    if (temp == 5) inslt = " an embryo sucking fiend";
    if (temp == 6) inslt = " a shaved gerbil tail puller";
    if (temp == 7) inslt = " the product of a bored housewife and a crazed "+
        "rottweiller";
    return specific ("You call "+str+inslt+".",
        "calls "+str+inslt+"!", str,
        "calls you"+inslt+"!");
}

