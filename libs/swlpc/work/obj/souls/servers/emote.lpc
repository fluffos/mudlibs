/* test emote server.  This is probably a bad example because
 * of the local state (call out to remove the "is smiling" hack).
 * G.
 */
#include <Servers.h>
#include "gender.h"

#define cap_name this_player()->query_name()

/*
	This soul_com.c has been extensively modified and extended
	(from the standard US release - who knows who is responsible?)
	at The Shattered World Lpmud. Ideas came from many,
	most of the hard work was done by  roddi@bruce.cs.monash.oz.au
	(aka Thumpa).
*/

array vsimple;

reset(arg)
{
    return 1;
}
		
ghost() { return call_other(this_player(), "query_ghost"); }

#define WHINGE "std/priority"

catch_action(player, qv, str) {
string arg;
string who;
array ret;
int i;
if (!qv)
    return 0;
/* bug catcher by Hunter of Shattered World */
	if (qv == "shout" && str && 
		index(lower_case(str), " bug ") >= 0)
	{
		if (!(who = WHINGE->get_whinge_to() )) {
			write("Mail "+capitalize
			(WHINGE->query_liason())+" :)\n");
		}
		else
		{
			tell_object(find_player(who), this_player()->query_name()+
			" has come across a bug and requests your assistance!!\n");
			write(capitalize(who)+" has been summoned.\n");
		}
		return 0;
	}
    if (call_other(this_object(), "comm_"+qv, str))
	return 1;
    ret = "std/emotes"->action(this_player(), qv, str);
    if (ret && pointerp(ret)) {
	while (remove_call_out("remove_action") > 0) i++;
	tell_object(this_player(), ret[0]);
	say(ret[1], this_player());
	this_player()->set_current_action(ret[2]);
	call_out("remove_action", 3, this_player()); 
	return 1;
    }
}

remove_action(pob)
{
	pob->set_current_action(0);
}

nosave general(self, others) {
    if (ghost()) return 0;
    write(self + "\n");
    say(cap_name + " " + others + "\n");
    return 1;
}

nosave specific(self, others, whom, target) {
    if (ghost()) return 0;
    whom = present(lower_case(whom), environment(this_player()));
    if (!whom || !whom->query_living() || whom == this_player()) return 0;
    write(self + "\n");
    tell_object(whom, cap_name + " " + target + "\n");
    say(cap_name + " " + others + "\n", whom);
    return 1;
}

simple(arg,nverb,head,tale)
{
object who;
  if (ghost()) return 0;
  if (!arg) return 0;
  if (head) head=" "+head;
  else head="";
  
  if (!tale) tale=".";
  who = present(lower_case(arg), environment(this_player()));
  if (!who || !who->query_living() || who == this_player()) return 0;
  arg = capitalize(arg);
  write("You "+nverb+head+" "+arg+tale+"\n");
  tell_object(who, cap_name+ " "+nverb+"s"+head+" you"+tale+"\n");
  say(cap_name+" "+nverb+"s"+head+" "+arg+tale+"\n",who);
  return 1;
}

