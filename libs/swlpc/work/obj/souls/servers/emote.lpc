{ if (!str) return general("Beep Beep!", "goes \"Beep! Beep!\"");
   return simple(str, "beep", 0, " on the nose."); }

comm_boggle(str)
{
  if (!str)
    return general("You boggle at the concept.",
      "boggles at the concept.");
  else
    return simple(str,"boggle","at");
}


comm_caress(str)
{
  if (!str) return 0;
  str = capitalize(str);
    return specific(
