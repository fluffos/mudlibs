comm_comp(str) {
    object who;
    string sex, string1, string2, string3, name, what;
    int temp;

    if (str) who = present(lower_case(str), environment(this_player()));
    if (!str || !who) return general("Compliment WHO, you lovely person ?",
        "compliments "+GENDER->obj()+"self.");
    sex = possessive(who);
    what = subjective(who);
    str = capitalize(str);
    name = capitalize(call_other(this_player(), "query_name"));
    string1 = "";
    string2 = "";
    string3 = "";
    temp = random(6);
    if (temp == 0) {
        string1 = "You compliment "+str+" on "+sex+" breasts.";
        string2 = "compliments "+str+" on "+sex+" breasts.";
        string3 = "compliments you on your breasts.";
    }
    if (temp == 1) {
        string1 = "You compliment "+str+" on "+sex+" personality.";
        string2 = "compliments "+str+" on "+sex+" personality, but "+
            "thinks better of it.";
        string3 = "compliments you on your personality, but thinks "+
            "better of it.";
    }
    if (temp == 2) {
        string1 = "You compliment "+str+" on "+sex+" choice of armour.";
        string2 = "compliments "+str+" on "+sex+" choice of "+
            "rather gauche armour.";
        string3 = "compliments you on your choice of armour, and then "+
            "snickers.";
    }
    if (temp == 3) {
        string1 = "You compliment "+str+" on "+sex+" physique.";
        string2 = "compliments "+str+" on "+sex+" voluptuous body - "+
            "well, voluptuous if you're a toad fish.";
        string3 = "compliments you on your voluptuous body, and then "+
                  "adds 'If you're a toad fish.'";
    } 
    if (temp == 4) {
        string1 = "You compliment "+str+" on "+sex+" personal hygiene, "+
             "but then again, you ARE standing upwind of "+str+".";
        string2 = "compliments "+str+" on "+sex+" personal hygiene, but "+
             "then again, "+name+" IS standing upwind of "+str+".";
        string3 = "compliments you on your personal hygiene, but then "+
             "again, "+name+" IS standing upwind of you.";
    }
    if (temp == 5) {
        string1 = "You say "+str+" looks much better without "+sex+
            " moustache, but then realize "+what+
            " has just pulled the hairs out of "+sex+" nose.";
        string2 = "says "+str+" looks much better without "+sex+
            " moustache, but you only recall "+sex+
            " screams as "+what+" took "+
            "the hairs out of "+sex+" nose in the morning.";
        string3 = "says you look much better without your moustache, "+
            "but you only remember pulling the hairs out of your nose "+
            "this morning.";
    }
    return specific(string1, string2, str, string3);
}


