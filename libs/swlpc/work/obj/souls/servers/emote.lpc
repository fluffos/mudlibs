    if (!str) return general("You drop your trousers.",
        "drops "+GENDER->pos()+"trousers.");
    str = capitalize(str);
    return specific(
        "You flash "+str+".",
        "flashes "+str+".",str,
        "unzips "+GENDER->pos()+" pants and shows you "+GENDER->pos()+" pride.");
}

comm_give(str)
{
  string dest;
  array args;

  if (!str) return 0;
  args = STRINGS->split_first(str, " ");

  if (sizeof(args) == 2 && args[1] == "finger")
    return simple(args[0],"give",0," the finger.", who);

  return 0;
}

