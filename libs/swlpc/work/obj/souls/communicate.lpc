show_stats()
{
    ::show_stats();
    write("translator : "); DUMP->dump(translator);
}

reset(arg)
{
        ::reset(arg);
        if (arg) return;
        add_id( "communicate" );
        set_soul_type("generic", "communicate");
}

init()
{
    ::init();
    if (myself == this_player()) {
        string com = "communicate";
        int can_talk = 1;
        if (myself->query_npc()
            && index(CAN_TALK, myself->query_race()) == -1) 
            {
                can_talk = 0;
                com = "nonhuman_communicate";
            }
	if (myself->is_player())
        	SHOUT->listen(myself);
        add_action(com,"ask");
        add_action(com,"say");
        add_action(com, "Say");
#if XVERB
        add_action(com); add_xverb("\"");
        add_action(com); add_xverb("'");
        if (can_talk)
            add_action("emote"); add_xverb(":");
#else
        add_action(com, "\"", -1);
        add_action(com, "'", -1);
        if (can_talk)
            add_action("emote", ":", -1);
#endif
        if (can_talk)
        {
            add_action("shout_to_all", "shout");
            add_action("whisper","whisper",3);
            add_action("tell","tell");
            add_action("ignore", "ignore");
            add_action("converse","converse",4);
#if 0
            add_action("emergency","emergency");
#endif
            add_action("emote", "emote");
            add_action("guild_yell","yell");
            add_action("lord_shout","lord");
            /* if (myself->query_wiz() || WHOIS->is_test_char()) */

            add_action("set_language","talk");
            /* added by zaphoid 951121 */
            add_action("respond","respond",3);
                /*add_action("respond","reply",3);*/ /* Me bad -- conflict with
wiz command. Bel. */
            /* remote stuff */
            add_action("send_rtell", "rtell");
            add_action("rwho", "rwho");
            if (this_player()->query_wiz())
                    add_action("rwho", "rhosts");
            add_action("chat","chat");
            add_action("newbie_yell","newbie");
            add_action("advice","advice");
	    add_action("ooc_shout", "ooc");
        }
    }
}


/* ooc_shout added by Greebo 010703 */
ooc_shout(str) 
{   
    notify_fail("Possible Syntax: \"ooc <message>\", \"ooc on\", " +
	 "\"ooc off\"\n");
    if (!stringp(str)) return 0;
    if (myself->query_ghost())
    {
        notify_fail("You'll have to regenerate first.\n");
        return 0;
    }
    if (str == "on") {
        if (myself->query_store("ooc_channel") != 0) {
            myself->remove_store("ooc_channel");
            write("Ooc channel turned on.\n");
        } else {
            write("Ooc channel is already turned on.\n");
        }
        return 1;
    }
    if (str == "off") {
        if (myself->query_store("ooc_channel") == 0) {
            myself->add_store("ooc_channel",1);
            write("Ooc channel turned off.\n");
        } else {
            write("Ooc channel is already turned off.\n");
        }
        return 1;
    }
    if (myself->query_store("ooc_channel") != 0) {
        write("Your ooc channel is turned off.\n");
        return 1;
    }
    if (myself->query_sp() < 0)
    {
        write("You are too low on spell points.\n");
        return 1;
    }
    if (translator) str = translator->translate(str);
    SHOUT->shout(myself->query_name()+" ooc shouts: "+str+"\n", "test_ooc");
    return 1;
}


test_ooc(who)
{
    if (who->query_store("ooc_channel") == 1) return 0;
    return 1;
}


/* Newbie channel yell by Dodinas 7-Apr-01 */
newbie_yell(str) 
{   
    notify_fail("Possible Syntax: \"newbie <message>\", \"newbie on\", "
        + "\"newbie off\"\n");
    if (!stringp(str)) return 0;
/*    if (myself->query_ghost())
    {
        notify_fail("You'll have to regenerate first.\n");
        return 0;
    } */
    if (str == "on") {
        if (myself->query_store("newbie_channel") != 0) {
            myself->remove_store("newbie_channel");
            write("Newbie channel turned on.\n");
        } else {
            write("Newbie channel is already turned on.\n");
        }
        return 1;
    }
    
    if (str == "off") {
        if (myself->query_store("newbie_channel") == 0) {
            myself->add_store("newbie_channel",1);
            write("Newbie channel turned off.\n");
        } else {
            write("Newbie channel is already turned off.\n");
        }
        return 1;
    }
 
    if (myself->query_store("newbie_channel") != 0) {
        write("Your newbie channel is turned off.\n");
        return 1;
    }
    
    if (myself->query_sp() < 0)
    {
        write("You are too low on spell points.\n");
        return 1;
    }

    if (translator) str = translator->translate(str);

    SHOUT->shout(myself->query_name()+" newbie yells: "+str+"\n",
"test_newbie");

    return 1;
}

test_newbie(who)
{
    if (who->query_store("newbie_channel") == 1) return 0;
    return 1;
}

/* Advice channel - added by Dodinas 09/04/2001

   Players can't actually talk on this channel, but they can switch it on and
   off.  Messages are broadcast to this channel by a seperate object. */

advice(str) 
{   
    if (str == "on") {
        if (myself->query_store("advice_channel") != 0) {
            myself->remove_store("advice_channel");
            write("Advice channel is now ON.\n");
        } else {
            write("Advice channel is already ON.\n");
        }
        return 1;
    }
    
    if (str == "off") {
        if (myself->query_store("advice_channel") == 0) {
            myself->add_store("advice_channel",1);
            write("Advice channel is now OFF.\n");
        } else {
            write("Advice channel is already OFF.\n");
        }
        return 1;
    }

    if (myself->query_store("advice_channel") == 0) {
        myself->add_store("advice_channel",1);
        write("Advice channel is now OFF.\n");
    } else {
        myself->remove_store("advice_channel");
        write("Advice channel is now ON.\n");
    }

    return 1;
}

test_advice(who)
{
    if (who->query_store("advice_channel") == 1) return 0;
    return 1;
}

/* guild yell by Nostromo 9-Oct-92  - Fixed by Darkryln */
guild_yell(str) 
{   
    array memberships;
    notify_fail("Guild shout what?\n");
    if (!stringp(str)) return 0;
    if (myself->query_ghost())
    {
        notify_fail("You'll have to regenerate first.\n");
        return 0;
    }
    memberships = GUILD_SERV->find_all(myself->query_real_name());
    notify_fail("You are not part of a guild.\n");
    if (!memberships || sizeof(memberships) == 0) return 0;
    if (myself->query_sp() < 0)
    {
        write("You are too low on spell points.\n");
        return 1;
    }

    if (translator) str = translator->translate(str);

    SHOUT->shout(myself->my_name()+" guild yells: "+str+"\n", "test_gods");

    return 1;
}

test_gods(who)
{
    array tmp = ARRAY->common(who->query_gods(), myself->query_gods());
    if (sizeof(tmp)) return 1;
    return 0;
}

/* lord shout by Greebo - 990526 */
/* Fixed so that Wizzes can use and hear lord shouts 990629 Zeni*/
lord_shout(str) 
{   
    notify_fail("Lord shout what?\n");
    if (!stringp(str)) return 0;
    if (myself->query_ghost())
    {
        notify_fail("You'll have to regenerate first.\n");
        return 0;
    }

    notify_fail("You are not a Lord.\n");
  if (this_player()->query_wiz() < 1) {
    if (PEERAGE_SERV->query_station_value(myself->query_real_name()) < 0) return
0;
    if (myself->query_sp() < 0)
    {
        write("You are too low on spell points.\n");
        return 1;
    }
}
    if (translator) str = translator->translate(str);

    SHOUT->shout(myself->query_name()+" lord yells: "+str+"\n", "test_lord");

    return 1;
}

test_lord(who)
{
    if (who->query_wiz() < 1) {
        if (PEERAGE_SERV->query_station_value(who->query_real_name()) < 0)
        return 0;
    }
        return 1;
}

shout_to_all(str)
{
    int i;

    notify_fail("Shout what?\n");

    if (myself->query_sp() < 0) 
    {
            write("You are too low on power.\n");
            return 1;
    }
    if (!str)  return 0; 
    if (myself->query_ghost()) 
    {
            write("You shout silently.\n");
            return 1;
    }
        /* check for wizards put in by Hunter, 921017 */
    if (!myself->query_wiz())
    {
        shout_count++;
            for (i = 0; i < sizeof(no_shout); i++)
        {
                if (index(lower_case(str), no_shout[i]) != -1) 
            {
                    write("You feel like you're trying to use someone's name in vain!\n");
                return 1;
                }
        }
    }
    if (translator) str = translator->translate(str);
    SHOUT->shout(capitalize(myself->my_name()) + " shouts: " + str + "\n");

/* 
    write("Ok.\n"); 
    if (!myself->query_wiz()) myself->add_sp(-20);
*/

    int xx = myself->query_store("shout_restrict");
    if (xx && shout_count > xx)
    {
        object ob;
        ob = clone_object("obj/shout_curse");
        ob->start(myself, 600);                          
        shout_count = 0;
    }
    
    return 1;
}

ignore(arg)
{
    array ignorees;
    string ret;
    int x;

    notify_fail("Ignore who?\n");
    if (!arg) return;
    arg = lower_case(arg);

    ignorees = myself->query_store("ignorees");

    if (!ignorees) ignorees = ({ });

    if (arg == "list") /* added Greebo 990807 */
                        /* re-written & added "guest" - Jenna 000419 */
    {
        int i;
        array tmp;

        if (!ignorees || !sizeof(ignorees)) {
            write("You are not ignoring anyone.\n");
            return 1;
            }
        tmp = STRINGS->cap_array(ignorees);
        i = index(tmp, "Guest");
        if (i != -1)
            tmp[i] = "all guest characters";
        write("You are ignoring: " + STRINGS->array2string(tmp) + ".\n");
        return 1;
    }

    ret = (arg == "guest" ? "guest characters" : capitalize(arg));

    x = index(ignorees, arg);
    if (x != -1)
    {
        /* listen to them again */
        ignorees = ignorees[..x-1] + ignorees[x+1..];
        write("You are no longer ignoring \"tell\"s from " + ret + ".\n");
    }
    else
    {
        ignorees = ignorees + ({ arg });
        write("You are now ignoring \"tell\"s from " + ret + ".\n");
    }
    myself->add_store("ignorees", ignorees);

    return 1;
}

tell(arg)
{
    array exp_arg, ignorees;
    object ob;
    string who, msg, bus, rn;
    int is_player, lvl, x;

    notify_fail("Tell who what?\n");
    if (!arg) return;
    if (!(exp_arg = STRINGS->split_first(arg, " "))) return 0;
    who = lower_case(exp_arg[0]);
    msg = exp_arg[1];
    is_player = 1;
    ob = find_player(who);
    if (!ob) {
        ob = find_living(who);
        is_player = 0; }
    if (!ob) { 
        array users = users();
        int i,match;
        match = 0;
        for (i = 0; i < sizeof(users); i++) {
            if (index(users[i]->query_name(),capitalize(who)) == 0) {
                ob = users[i];
                match++;
                is_player =1;
            }
        }
        if (match > 1) {
            notify_fail("More than one person currently matches those letters.\n");
            return 0;
        }
        
        if (!ob) {
            notify_fail("No living thing with that name.\n"); 
            return 0;
        }
    }

    if (!myself->query_wiz()) 
    {
            if (myself->query_ghost()) 
        {
                write("You have trouble in your current state.\n");
                return 1; 
        }
            if (myself->query_sp() < 0) 
        {
                write("You are low on power.\n");
                return 1; 
        }
    }

    if (!myself->query_wiz() && (ob->query_invis() > 30) &&
          !myself->query_store(ob->query_real_name()+"'s favour")) 
    {
            write("No living thing with that name.\n");
            return 1; 
    }

/* check for linkdeath - idea seen and stolen from LPswat - G. */
    if (is_player && !query_ip_number(ob)) 
    {
        write(ob->query_name() + " is link dead and cannot hear you (now).\n");
/*      return 1; */
/* what's wrong with the link-death buffer? Hmm?  -- D */
        }

    /* is the target ignoring us? */
    ignorees = ob->query_store("ignorees");
    if (ignorees) 
    {
        x = -1;
        if (myself->query_npc())
            x = index(ignorees, "mobiles");
        if (x == -1 && myself->query_guest())
            x = index(ignorees, "guest");
        if (x == -1)
            x = index(ignorees, myself->query_real_name());
        if (x != -1)
        {
            tell_object(myself, ob->query_name() + " is ignoring you.\n");
            return 1;
        }
    }

    /* Check for WIZARD_ELAN added, Hunter 921201     */ 
    /* takes elan to talk to wizards, if wizards wish */
    if ((ob->query_wiz() > CREATE) && !myself->query_wiz() && 
        ob->query_store("WIZARD_ELAN") &&
        !myself->query_store(ob->query_real_name()+"'s favour")) {
        lvl = elan_worth(ob->query_wiz());
            if (myself->query_skill("elan") < lvl) 
        { 
            tell_object(myself, "You don't have enough elan to tell " + 
                ob->query_name() + " anything.\n");
            return 1; 
        }
            myself->add_skill("elan", (-lvl)); 
    }

    if (translator) msg = translator->translate(msg);

/* if we get to this point, the tell will work */
    tell_object( myself, "You tell " + ob->query_name() + ": " +msg +"\n");

    rn = "";
    if (ob->query_wiz()) {
        if (myself->query_invis())
            rn = " ("+ myself->query_real_name() + ")";
        else if (myself->query_npc())
            catch rn = " ("+ myself->query_owner()[0] + ")";;
        }
    if (bus = ob->query_caution()) {
        tell_object(myself,ob->query_name() + " is " + bus + ".\n");
        ob->add_note(capitalize(myself->my_name()) + rn +
                 " tells you: " + msg + "\n");
        /* added by Zaphoid 951121 */
        comm = ob->query_soul("generic/communicate");
        if (comm) {
                comm->set_responce_how("tell");
                comm->set_responce_who(myself->query_name());
        }
        return 1; }

    msg = capitalize(myself->my_name()) + rn +
                        " tells you: " + msg;
    msg = ANSI->scolor(hilite(ob, "tell"), msg);

    tell_object(ob, msg + "\n");
        /* added by Zaphoid 951121 */
    comm = ob->query_soul("generic/communicate");
    if (comm) {
        comm->set_responce_how("tell");
        comm->set_responce_who(myself->query_name());
    }
    return 1;
}

/* This function return how many times a wiz level can by divided 2 */
/* Effectively it is working out log(wiz_level) base 2 */
elan_worth(int arg) 
{
    int l, n;

        if (arg < CREATE) return;
        n = 0;
        l = arg - CREATE;
        while (l) { n ++; l >>= 1; }
        return n;
}

whisper(arg) 
{
    object ob;
    string who, msg, it;
    array ex;

    notify_fail("Whisper what?\n");
    if (myself->query_ghost() || !query_can_talk()) {
        notify_fail("You fail to whisper.\n");
        return 0;
    }
    if (!arg) return  0;

    if (!(ex = STRINGS->split_first(arg, " "))) return 0;
    who = ex[0];
    msg = ex[1];

    it = lower_case(who);
    ob = find_living(it);
    if (!ob || !present(it, environment(myself))) {
        notify_fail("There is no-one called \"" + capitalize(it) +
                "\" here.\nTry \"whisper <name> <message>\".\n");
        return 0;
    }
    if (ob == myself)
    {
        write("You mutter to yourself.\n");
        myself->checked_say(myself->query_name() + " mutters to "+
            GENDER->obj(myself) + "self.\n");
        return 1;
    }
    if (translator) msg= translator->translate(msg);
    tell_object(ob, this_player()->query_name() + " whispers to you: " + msg +
"\n");
    write("You whisper \""+msg+"\" to "+ob->query_name()+".\n");
    myself->checked_say(this_player()->query_name() + " whispers something to "
+ capitalize(who) + ".\n", ob);
        /* added by Zaphoid 951121 */
    comm = ob->query_soul("generic/communicate");
    if (comm) {
        comm->set_responce_how("whisper");
        comm->set_responce_who(myself->query_name());
    }
    return 1;
}

set_responce_how(how) {
        responce_method = how;
        return 1;
}

set_responce_who(who) {
        responce_person = who;
        return 1;
}

query_responce_how() { return responce_method; }
query_responce_who() { return responce_person; }
 
respond(mes) 
{
        if (query_responce_who() == 0 || query_responce_how() == 0) 
        {
            write("You don't know who to reply to!\n");
            return 1;
        }

        if (!mes) 
        {
                write("What do you wish to "+query_responce_how()+" to "+query_responce_who()+".\n");
                return 1;
        }

        switch (query_responce_how()) 
        {
                case "tell":
                        tell(query_responce_who()+" "+mes);
                        break;
                case "whisper":
                        whisper(query_responce_who()+" "+mes);
                        break;
                default:
                        break;
        }
        return 1;
}

nosave string conversing_with;

converse(who) 
{
    conversing_with = who;
    if (who && !present(who, environment(myself)))
    {
        notify_fail(capitalize(who)+" is not here!\n");
        return 0;
    }
    if (who && !present(who, environment(myself))->query_living())
    {
        notify_fail(capitalize(who)+" is not living!\n");
        return 0;
    }
    write("Give '**' to stop.\n");
    write("]");
    input_to("converse_more");
    return 1;
}

 converse_more(said) 
 {
    string nsaid;

    if (!said || said == "") {
        write("]");
        input_to("converse_more");
        return 1;
    }
    if (said == "**") {
        write("Ok.\n");
        return 1;
    }
    if (nsaid = STRINGS->match_head(said, ({ "\"", "'" })))
    {
            communicate(nsaid);
    }
    else if (!conversing_with || !present(conversing_with, environment(myself)))
    {
            communicate(said);
    }
    else
    {
            communicate(conversing_with+", "+said);
    }
    write("]");
    input_to("converse_more");
    return 1;
}

hilite_say(string str,object notob)
{
    int i;
    array objs;

    if (!myself) return 0;
    if (!environment(myself)) return 0;
    if (myself->query_invis() >= INVIS_ACTION) return;

    objs = contents(environment(myself));
    for (i = 0; i < sizeof(objs); i++)
    {
        if (!(objs[i] == 0 || objs[i] == notob ||
            objs[i] == myself)) 
        {
            tell_object(objs[i], ANSI->scolor(hilite(objs[i], "say"), str));
        }
    }
        tell_object(environment(myself),str); /* MUST do this.!!!!:L */  
    /* probably should have a hilight check */
}

/*
 * Added an extra hook so we can tell them they said something
 * other than what they really said, if you see what I'm saying :)
 */

/* 
 * 'ask' instead of 'say' added by Hunter, Sept 1992
 * 'exclaims' added, 29th Sept 1992 - Hunter
 */
communicate(said, cheat) 
{
    string first_part;
    string who_to, the_rest, msg;
    array ex;
    object them;
    int question = 0;
    int exclaimed = 0;
    int continues = 0;
    string action;

    /* can the character actually communicate in this environment? */
    notify_fail("You are too busy holding your breath.\n");

    if (!query_can_talk()) return 0;

    /* are we mumbling? */
    if (!said || strlen(said) < 1) 
    {
        write("You mumble incoherently.\n");
        say(this_player()->query_name() + " mumbles incoherently.\n");
        return 1;
    }

    if (myself->query_ghost()) 
        first_part = capitalize (myself->short());
    else
        first_part = this_player()->query_name();

/* add_action("ask") added by hunter, 921209 */
    if (query_verb() == "ask" && index(said, "?") == -1)
    said = said + "?";

    if (ex = STRINGS->split_first(said, ","))
    {
        who_to = ex[0];
        the_rest = ex[1];
        if ( (them = present(lower_case(who_to), environment(myself))) &&
            them->query_living())
        {
            the_rest = STRINGS->strip_whitespace(the_rest);
            if (the_rest == "") 
            { /* added 5/6/98 Greebo */
                write("You mumble incoherently to "+them->query_name()+".\n");
                myself->checked_say(this_player()->query_name()+" mumbles incoherently to "+them->query_name()+".\n",them);
                tell_object(them, this_player()->query_name()+" mumbles incoherently to you.\n");
            return 1;
            }
            if (who_to != lower_case(who_to))
                said = capitalize(the_rest);
            else
                said = the_rest;
        }
    }
    else them = 0;
    continues = (said[0..1] == "..");

    if (question = said[sizeof(said)-1..] == "?")
    {
        action = "ask";
        if (sizeof(said) > 1 && said[sizeof(said)-2..] == "??")
        action = ({"madly","persistently","insanely","wildly"})[random(4)]
        +" ask";
    }
    else if (exclaimed = said[sizeof(said)-1..] == "!")
    {    
        action = "exclaim";
        if (sizeof(said) > 1 && said[sizeof(said)-2..] == "!!")
        action = "insanely exclaim";
        /* Don't you know multiple exclamation marks are a sign of
           insanity? :-) - Hunter 921208 */
    }
    /* else if (query_verb() == "ooc") action = "ooc"; */
    else action = "say";

    if (translator) said= translator->translate(said);
    if (!cheat)  cheat = said;
    if (them && them != myself)
    {
        hilite_say(first_part + " " + action +"s " + 
        (question?"":"to ") + them->query_name()+": " + said + "\n",  them);
        msg = first_part + " " + action + "s " + 
        (question ? "":"to ") + "you: " + said + "\n";
        msg = ANSI->scolor(hilite(them, "say"),msg);
        tell_object(them, msg);
        if (myself->query_brief()) write("Ok.\n");
        else
        {
            write("You "+action+ (question?" ":" to ")
            + them->query_name()+": " + cheat + "\n");
        }
    }
    else if (them == myself)
    {
        hilite_say(first_part + " "+ action + "s " +(question?"":"to ")
        +objective(myself)+"self: " + said + "\n");
        write("You "+action+ (question?"":" to") + " yourself: "+ cheat+"\n");
    }
    else
    {
        /* Wizards talking in a room now boosts players' elan ! - P */
        hilite_say(first_part + " " + action +"s: "+ said + "\n");
        if (myself->query_brief())
            write("Ok.\n");
        else
            write("You "+action+": "+cheat+"\n");
    }
    return 1;
}

/* Jenna Feb 2000 */
nonhuman_communicate(str) 
{
    array replace = [ "feline", "mee-ow", "canine", "woof", 
        "rodent", "squeeeeak", "fish", "blbbbb", "insect", "skktcch",
        "centipede", "skktcch", "crustacean", "chhk-chkk" ];
    int i, j, x;
    string r, punc;


    x = index(replace, myself->query_race());
    if (x != -1) {
        punc = str[sizeof(str)-1..];
        if (stringp(str))
            i = sizeof(explode(str, " "));
        if (i) {
            str = "";
            for (j = 1; j <= i; j++)
                str += replace[x+1] + " ";
            if (punc == "!" || punc == "?" || punc == ".")
                str = str[..(sizeof(str)-2)] + punc;
            }
        }
    return communicate(str);
}

free_emote()
{
    if ((myself->query_wiz() || myself->query_NPC() 
        || myself->query_store("free_emote") != 0) ) return 1;
    return 0;
}

emote(str) 
{
    string ename;
    int x;

    if ((!stringp(str)) || sizeof(str) < 1) {
        notify_fail("Emote what?\n");
        return 0;
    }
    if (!free_emote()) ename = "."+myself->query_name();
    else ename = myself->query_name();
    if (str[0] != "'"[0])
    ename = ename + " ";
    myself->remote_say(ename + str + "\n");
    if (myself->query_brief()) write("Ok.\n");
    else 
    {
        if (!free_emote()) write("You emote: " + ename[1..] + str + "\n");
        else write("You emote: " + ename + str + "\n");
    }
    return 1;
}

chat(str) {
        notify_fail("Format: chat <on/off>\n");
        if (str == "on") {
                if (!myself->query_store("chat"))
                        myself->add_store("chat",1);
                write("Chat Mode On.\nCommands not understood will be interpreted "+
                        "as speech.\n");
                }
        else if (str == "off") {
                myself->remove_store("chat");
                write("Chat Mode Off.\n");
                }
        else
                return 0;
        return 1;
        }

set_translator((int|object|string) trans)
{
    translator = trans;
    return 1;
}

query_translator()
{
    return translator;
}

set_language(str, silent) {
   object serv = "std/lang/lang_serv";
/* object serv = "players/paladin/lang/lang_serv"; */
array all;
        all = serv->query_spoken();
        if (!all) return; 
        notify_fail ("Usage: talk <language>\n");
        if (!str) return;
        if (str == "normal") {
          translator = 0;
          if(!silent) write("Ok.\n");
          return 1;}
        translator = serv->get_translator(str);
        if (translator) {
          if(!silent) write("Ok.\n");
          return 1;}
        write ("Languages spoken are : ");
        write (implode(all, ", ")+", normal.\n");
        return; }  

extra_look()  {
string ret;
        if (translator) ret = translator->extra_look(); 
        if (ret) ret = capitalize(subjective(myself))+" "+ret;
        return ret;}

/*
 * Test the medium the character is in, and what they can breathe
 * 940212 Added by Hunter
 */
int 
query_can_talk()
{
/* Added this to track those places that dont have mediums, and fix them :L */
    object m;
    array media;

    m = environment(myself);
    /* Should be able to talk to escape */
    if (!m) return 1; 
    media = m->query_medium();
    if (media == 0)
    {
        LOG->log( "INVALID_MEDIUM",
            "Found (via the comm. soul) an env. with an invalid medium. ("
            + file_name (environment(myself)) + ").\n");
    }
    else
    {
        array can_breathe = myself->query_I_breathe();
        array common = ARRAY->common(media, can_breathe);
        if (myself->query_wiz()) return 1;
        return (sizeof(common));
    }
}

rwho(s) {
    if (myself->query_guest() || myself->query_npc() ||
        myself->query_store("no_rtell"))
    {
        write("You are not allowed to use rwho.\n");
        return 1;
    }
    if (query_verb() == "rwho")
        RWHO->show_who();
    else
        RHOST_SERV ->list_hosts(s == "all");
    return 1;
}

const RTELL_COST = 10;

send_rtell(s) 
{
    string who, what;
    array ex;
    notify_fail("Usage: " + query_verb() + " <name> message\n");
    if (!s) return 0;

    if (!(ex = STRINGS->split_first(s, " "))) return 0;

    who = ex[0];
    what = ex[1];

    if (myself->query_wiz() == 0) 
    {
            if (myself->query_sp() < RTELL_COST) {
                write("Not enough spell points to rtell.\n");
                return 1;
            }
            myself->add_sp(-RTELL_COST);
    }
    /* yup - after removing the sp. :-) */
    if (myself->query_guest() || myself->query_npc() ||
        myself->query_store("no_rtell"))
    {
        write("You are not permitted to rtell.\n");
        return 1;
    }
    RTALK->send_rtell(myself->query_real_name(), lower_case(who),
 what + "\n");
    return 1;
}
