/*
 *      Standard player communication soul.
 *
 *      Dredd. - modified original stuff in player.c (US version).
 */

/*
 * 940212 Hunter    Added check for environment mediums, and can_breathe.
 * 950527 Hunter    changed existing calls to RO/Servers.h #define'd labels
 * 950912 Darkryln  Fixed up guild yell.
 * 951002 Belgarion Disallowed npcs, guests from rtell/rwho; added a check
 *                  for no_rtell in player store.
 * 951018 Hunter        changed msg to myself for 'tell'
 * 951022 Hunter        changed 'rwho' server
 * 951027 Hunter        fixed grammer for 'tell'
 * 951121 Zaphoid       added a reply command for 'tell' and 'whisper'
 * 990122 Jenna     Added "chat <on/off>" command 
 * 991231 Jenna     Rewrote "whisper" to use notify_fail()
 * 000215 Jenna     Allowed non-human communication
 * 000419 Jenna     Allowed "ignore guest"
 * 010221 Jenna     Added "demon" as a race which can talk
 * 010407 Dodinas   Added newbie shouts
 * 010408 Dodinas   Changed "tell" so you don't need to spell out the full name
 * 010703 Greebo    Changed "ooc" to be shout based instead of room based
 */

inherit "obj/souls/base_soul";

#include "security.h"
#include "gender.h"
#include "ansi.h"

/* if a shouted string contains any fragments listed in no_shout, 
 * then that  shout will not succede
 */
array no_shout = ({
        "dredd", "gandalf", "greebo", /* "jenna", */ "rhys",
        "armageddon", "game driver"
});

/* translator is the object that can filter a string
 * before it is said/shouted/etc.
 *  newstring = translator()->translate(oldstring)
 */
object translator = 0;

/* some variables used with the respond function */
/* Zaphoid 951122 */
string responce_method, responce_person;
object comm; 

/* shout restrictions */
int shout_count = 0;
int max_shout = 30;
#define MAX_SHOUT 

#define CAN_TALK        [ "humanoid", "demon" ]

