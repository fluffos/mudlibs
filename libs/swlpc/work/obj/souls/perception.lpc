/* 
 * look at the roof if indoors look at weather if outdoors and look
 * at rocs if any above 
 */
look_sky()
{
    string sh;

    notify_fail("What sky?\n");
    if (room->query_outdoors() < 2) 
    {
        write("You look up and see the ceiling of the room "
        +"you are in.\n");
        return 1;
    }
    else if (room->query_weather_obj())
    {
        sh = room->query_weather();
        if (sh == 0)
            write("You look towards the sky and see that the " +
                "weather controller is playing silly buggers.\n");
        else
            write(sh);
        return 1;
    }
    return 0;
}

look_living(object ob, quiet)
{
    int i, x;
    array special;

    if (ob != myself && !quiet) 
    {
        if (!myself->query_invis()) 
        tell_object(ob, myself->query_name() + " looks you over.\n");
        myself->checked_say(myself->query_name() + " examines " 
        + ob->query_name() + ".\n", ({ myself, ob }) );
    }
    special = contents(ob);
    if (special) special = special + ob->GetAliasedLS(0)[1];
    else special + ob->GetAliasedLS(0)[1];
    if (special) x = sizeof(special);
            
    string extra_str = "";
    for (i = 0; i < x; i ++) 
    {
        if (special[i]->query_disguised()) return 1;
        string tmp_extra_str;
        tmp_extra_str = special[i]->extra_look();
        if (tmp_extra_str) 
        {
            tmp_extra_str = "lib/emote"->emote_string( ob, tmp_extra_str );
            extra_str += (tmp_extra_str + "\n");
        }
    }
    write(extra_str);
    return 1;
}

look_room(int remote)
{
    string sh;
    array temp, ex;
    int i;

    room = environment(myself);
    if (remote && myself->query_brief()) 
    {
	    int hilite = 0;
        string tempitem = "";
        string rs = room_short();

        if (!rs) rs = "A dark room";
        write(rs);
	    if (myself->is_player())
		hilite = ANSI->hilite(myself, "exits");
        temp = room->query_dest_dir(1);
        if (temp) 
        {
            ex = allocate(sizeof(temp)/2);
            for (i = 0; i < sizeof(temp); i += 2) 
            ex[i/2] = explode(temp[i+1], "#")[0]; 
            /* Bel 2 July '95 */
            if (sizeof(ex)) 
            tempitem = " " + ANSI->scolor(hilite,"<"+implode(ex, " ") + ">") + ".\n";
        }
        if (tempitem == "" ) tempitem =  ".\n";
        write(tempitem);
    } 
    else 
    {
            room_long();
    }
    sh = LOOK->query_contents_look(room, myself);
    if( sh && sh != "" )
    {
#ifdef NORTH_MUDLIB
            write(sh);
#else
            write("You see " + sh);
#endif
    }
    return 1;
}
/*
 * this is a whopping big function that caters for a shitload of 
 * special cases. It probably should be broken up a bit - Hunter 951217
 */
look(str, remote)
{
    object ob; 
    string local_item, item, sh;
    int weight, i, done;
    array temp;
    array allargs;

    if (cant_see()) return 1;   
    if (myself->test_dark()) return 1;
    if (!((stringp(room) && load_object(room)) || (objectp(room))))
        room = environment(myself); /* Just in case: Belgarion. */

    if (!str) return look_room(remote);

    notify_fail("Look at what?\n");

    allargs = STRINGS->split_first(str, " ");

    if (allargs && sizeof(allargs) > 1)
    {
        if ((allargs[0] == "at")  || (allargs[0] == "in"))
            item = lower_case(allargs[1]);
        else
            item = lower_case(implode(allargs, " "));
        
    }
    else
    {
        item = lower_case(str);
    }

    if (item == "") return 0;

    local_item = room->query_item_description(item);
    if (local_item != 0) 
    {
            write(local_item+".\n");
            return 1;
    }    

#if 0
    if (item == "door")
        return look_door(local_item);
    allargs = STRINGS->split_first(item, " ");
    if (allargs && (sizeof(allargs) > 1) && (allargs[1] == "door"))
        return look_door(allargs[0]);
#endif

    if (item == "sky") return look_sky();
    if (item == "prints" || item == "footprints" || item == "floor") 
    {
        if (room->query_prints() == 1 && !(room->query_medium("water"))) 
           write(room->query_prints_long());
        else 
        write("You don't seem to be able to leave prints here.\n");
        return 1;
    }
    ob = present(item, myself);
    if (!ob && room->id(item)) 
        ob = room;
    if (!ob) 
        ob = present(item, room);
    if (!ob)
	ob = room->find_door(item);
    if (!ob) 
    {
        int j = peer(str);
        notify_fail("There is no "+item+" here.\n");
        return j;
    }
    catch {temp = ob->query_ids();};
    if (pointerp(temp) && sizeof(temp)) 
    {
        if (index(temp, item) == -1) 
        item = temp[0];
    }
    ob->long(item);
    weight = ob->query_weight();
    if (!living(ob)) 
    {
        if (weight >= 5)
        write("It looks very heavy.\n");
        else if (weight >= 3)
        write("It looks heavy.\n");
    }
    if (!ob->can_put_and_get(item)) return 1;
    if (living(ob)) look_living(ob);
    if (ob == room)  return 1;  /* Jenna 7/94 */
    sh = LOOK->query_contents_look(ob);
    if (sh && sh != "")  
    {
        if (living(ob)) 
            write(capitalize(item) + " is carrying: "+sh);
        else 
            write(capitalize(item) + " contains: "+sh);
    }
    return 1;
}

do_read(str)
{
    object out;
    object it;
    string local_item;

    if (cant_see()) return 1;   
    notify_fail("Read What?\n");
    if (!str) return 0;

    it = present(str, this_player());
    out = environment(this_player());
    if (!it) it = present(str, out);
    if (it) return it->read(str);

    if (room) local_item = room->query_item_description(str);
    if (local_item)
    {
        write(local_item+".\n");
        return 1;
    }
    return 0;
}

old_diagnoses()
{
int i, x;
array body_locations, body_hps;
    
    body_locations = myself->query_body();
    body_hps = myself->query_hp("all");
        x = sizeof(body_locations);
        if (!body_hps) myself->setup_hps();
        for (i = 0; i <x; i+=2) {
          tell_object(myself, body_hps[i+1] + " of " + body_hps[i] +
                        " in "+ body_locations[i] + "\n");
        }
        return 1;
}

/* New diags - Jenna Nov 99 */
diagnoses() {
    write("You have " + myself->query_hp() + " hit points (of " + 
        myself->max_hp() + ") and " + myself->query_sp() + 
        " spell points (of " + myself->max_sp() +").\n");
    tell_object (myself, diags());
    if (this_player()->query_wiz())
        old_diagnoses();
    return 1; 
    }

diags(alt) {
  object me;
  real calc;
  string ret = "";
  string label;
  int i, j, redo, range;
  array body, hps, dtype1, dtype2;
  array dam = [ "minimal", "minor", "significant", "great", "major",
        "severe", "extreme" ];
  string blanks = "                              ";

    if (alt && objectp(alt))
        me = alt; /* Alternative */
    else 
        me = myself;
    range = sizeof(dam) - 1;
    body = me->query_body();
    hps = me->query_hp("all");
    for (i = 0; i < sizeof(body); i+=2) {
     if (hps[i] != hps[i+1]) {
       ret += capitalize(body[i])+blanks[..(20-sizeof(body[i]))];
       if (stringp(hps[i+1])) 
        ret += capitalize(hps[i+1])+"\n";
      else {
        if (hps[i+1] > hps[i]) 
                hps[i+1] = hps[i];
        if (hps[i] > 400) 
                redo = 1;    /* Check if their body hp sounds right */
        calc = range-range*(hps[i+1]+hps[i])/(hps[i]+hps[i]);
        if (hps[i+1] <= -hps[i]) 
                ret += ("Severed");
        else 
                ret += (capitalize(dam[real2int(calc)])); 
        dtype1 = me->query_body_damage(body[i]);
	if (pointerp(dtype1)) {
            for (j = 0, dtype2 = [ ]; j < sizeof(dtype1); j += 2) {
	      label = "std/damage"->query_live_effect(dtype1[j], 
                            (dtype1[j+1] * 3 / hps[i]) + 1);
	      if (label)
		dtype2 += [ label ];		
	      }	
            ret += " (" + STRINGS->array2string(dtype2) + ")";
	    }
	ret += "\n";
        }
       }         
      }
    if (sizeof(ret))
        ret = "Body Location        Damage\n"+
              "----------------------------------------\n" + ret;
    if (redo) 
        me->setup_hps();
    return ret;
    }

#if 0
