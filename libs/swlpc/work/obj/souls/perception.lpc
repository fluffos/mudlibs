    write(myself->query_hp() + " hit points (of " + myself->max_hp() + ") and ");
    write(myself->query_sp() + " spell points (of " + myself->max_sp() +").\n");
    tell_object (myself, diags()); 
    if (this_player()->query_wiz()) old_diagnoses(); 
    return 1; }

