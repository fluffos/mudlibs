inherit "obj/souls/base_soul";
inherit "RO/Servers";

#include "security.h"


#define write(x) tell_object(myself,x)

int temp_blind;
object room; 

reset(arg)
{
    ::reset(arg);    
    if (!arg) {
        add_id("perception");
        set_soul_type("generic", "perception");
    }
}

init() 
{
    ::init();
    if (myself == this_player()) 
    {
        add_action("look", "look", 1);
        add_action("scan", "scan");
        add_action("examine", "examine", 3);
        add_action("glance", "glance", 3);
        add_action("who", "who");
        add_action("whoami", "whoami");
        add_action("idle","idle");
        add_action("inventory", "i");    
        add_action("inventory", "inv");    
        add_action("inventory", "inventory");    
        add_action("do_read", "read");
        add_action("diagnoses", "diagnoses", 4);
        add_action("diagnoses", "diagnosis");
        add_action("diagnoses", "hp");
        add_action("diagnoses", "sp");
	    add_action("old_diagnoses", "body");
        add_action("peer","peer",0);
        add_action("consider","consider",3);
        add_action("smell","smell");
        /* add_action("taste","taste"); */
    }
}

smell(str)
{
    object o;
    string msg;

    notify_fail("Smell what?\n");

    if (!str) return 0;

    o = present(str,myself);
    if (!o) o = present(str, environment(myself));
    if (!o) return 0;

    msg = o->query_property("smell");

    if (!msg) 
    {
        write("That doesn't have much of an odor.\n");
        return 1;
    }

    write(msg[1]);
    return 1;
}

consider(str)
{
    object ob;
    int mystr, obstr;

    notify_fail("Consider what?\n");
    if (!str) return 0;

    ob = present(lower_case(str), environment(myself));

    if (!ob) 
    {
        write("No " + str + " here !\n");
        return 1;
    }
    if (!living(ob)) 
    {
        write(str + " is not a living thing !\n");
        return 1;
    }
    if (ob == myself) 
    {
        write("You're as good as yourself!\n");
        return 1;
    }

    mystr = myself->query_str() * 4 + myself->query_con() * 4 + 
            myself->query_siz() * 4 + myself->query_dex() * 4 +
            myself->query_skill("offense") + myself->query_skill("defence");

    obstr = ob->query_str() * 4 + ob->query_con() * 4 + 
            ob->query_siz() * 4 + ob->query_dex() * 4 +
            ob->query_skill("offense") + ob->query_skill("defence");


    if (mystr * 2 < obstr)
    {
        write("You feel very scared about combat with " + ob->query_name() + ".\n");
    }
    else if (mystr + 60 < obstr)
    {
        write("You feel weaker than " + ob->query_name() + ".\n");
    }
    else if (mystr / 2 > obstr)
    {
        write("You feel very confident about combat with " + ob->query_name() + ".\n");
    }
    else if (mystr - 60 > obstr)
    {
        write("You feel stronger than " + ob->query_name() + ".\n");
    }
    else
    {
        write("You feel about the same as " + ob->query_name() + ".\n");
    }
    return 1;
}

idle()
{
    array idle = USER_SERV->query_idle();
    int i;
    string tmp;

    for (i = 0; i < sizeof(idle); i+=2)
    {
	if (idle[i] <  1)
	    tmp = "{Gactive}";
	else if (idle[i] < 5)
	    tmp = "{Y"+idle[i]+"}";
	else
	    tmp = "{R"+idle[i]+"}";
	COLOUR->cwrite(FORMAT->right_justify(tmp, 9) +
	    "  " + idle[i+1] + "\n");
    }
    return 1;
}

who()
{
    int ansi;
    string out;

    ansi = myself->query_store("hilite_on");

    if (ansi)
        out = USER_SERV->ansi_who();
    else
        out = USER_SERV->who();

    write(out);
    return 1;
}

whoami()
{
    write(myself->short()+"\n");
    return 1;
}



inventory()
{
    object ob;
    string str, w_dif;
    int i, x, siz, kg;
    int money;

    if (cant_see()) return 1;   
    if (myself->test_dark()) return 1;
    str = LOOK->query_contents_look(myself);
    siz = myself->query_siz() * 8;
    myself->recalc_carry();  /* Ensure they have the right amount. */
    kg = myself->query_weight_carried();
    money = myself->query_money();

    if ((!str || str == "")&& (money ==0)) 
        write("You are carrying nothing.\n");
    else 
    {
	write("Inventory: ");
    if (money != 0)
    {
        write(NUMBERS_SERV->int_to_english(money, myself->query_int()) +
        " gold coin"+ ((myself->query_money()!=1)?"s":""));
    }
    if (str)
    {
        if (money) write(", " + str);
        else write(str);
    }
    else write(".");
    x = 100 * kg / myself->query_max_can_carry();
    w_dif = x > 90 ? "(with extreme difficulty) " :
	x > 75 ? "(with great difficulty) " :
	x > 50 ? "(with some difficulty) " : "";
    if(kg > 0)
	  write("\nYou are carrying "+w_dif+
	    "approximately "+ENGLISH->int_to_english(kg, 
	     myself->query_int())+" stone in weight.\n"); /* Dark. 24/7/95 */
    else if (kg == 0)
        write("\nYou're carrying no weight.\n");
    }
    return 1;
}

// Rewritten by Jenna for new doors
// Sep 2000
scan()
{
    object where, ex, door;
    array dd;
    int i, flag;
    string desc, exit;

    where = environment(myself);

    dd = where->query_dest_dir();

    if (!dd)
	return 0;
    for (i = 1; i < sizeof(dd); i += 2)
    {
        ex = find_object(dd[i-1]);
        if (ex)
        {
	    door = where->query_door(dd[i]);
	    if (door && door->is_closed())
		desc = "a closed door.\n";
	    else
                desc = LOOK->query_living_contents(ex);
            if (desc)
            {
                write("To the " + dd[i] + " there is: " + desc);
                flag = 1;
            }
        }
    }
    if (!flag)
        write("There is nothing around you.\n");
    return 1;
}

