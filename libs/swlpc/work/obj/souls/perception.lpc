/* Blindness added by squawk */

cant_see() 
{
    if ( (temp_blind) || !(index(myself->query_disable(),"blind")==-1) )
    { 
        write("You are unable to see.\n");
        return 1;
    }
    return 0;
}

query_blindness()
{
    if ( (temp_blind) || !(index(myself->query_disable(),"blind")==-1) ) return 1;
    return 0;
}

blind(time)
{
    if (!time) return 0;
    temp_blind=1;
    tell_object(myself,"You suddenly go blind.\n");
    SKILL_SERV->add_skill(myself,"defence", -20, time);
    SKILL_SERV->add_skill(myself,"offense", -20, time);
    SKILL_SERV->add_skill(myself,"dodge", -20, time);
    call_out("end_blindness",(time));
    return 1;
}

end_blindness() 
{
    temp_blind=0;
    tell_object(myself,"Your sight returns to you!\n");
    return;
}

/* perception stuff taken from room/room and room/door and placed here. 
     - Zaphoid 950602 (2nd June 1995) */


/* function set_room() gets called whenever they enter a room */
set_room(obj) { room = obj; }

query_look(Exception)
{
    return query_room_look() +
     LOOK->query_contents_look(room, Exception);
}

query_room_look(int remote)
{
    string Error;
    string roomdesc;
    string exit; 
    string t;
    array OutStr;
    int OutPos;

    OutStr = allocate(4);

    /* need to change this for new light system */
    if (!room || room->query_light() == 0) 
        return "It is dark.\n";

    /* long desc */
    OutPos = 0;
    if (t = room->query_long())
        OutStr[OutPos++] = t;
    else if (t = room->long())
        OutStr[OutPos++] = t;

    /* extra look */
    catch {OutStr[OutPos] = room->extra_look();};
    if (OutStr[OutPos])
        OutPos++;

    /* weather */
    if (room->query_weather_obj() && room->query_outdoors())
        OutStr[OutPos++] = room->query_weather();

    /* footprints */
    if (room->query_prints())
    OutStr[OutPos++] = room->query_prints_short();

    /* changed from query_dest_dir: Bel 2 July '95 */
    if (remote == 0)
    {
        if (room->describe_exits() == 0) exit = "";
	    else exit = room->describe_exits();
    }
    else exit = "";

    roomdesc = implode(OutStr[0..OutPos-1], "");
    if (roomdesc == 0) roomdesc = "";
//    roomdesc = ANSI->scolor(hilite(myself, "rooms"),roomdesc); 
    
    return roomdesc + exit; 
}


room_long(str, int remote) 
{
    int i;
    if (!room) return; /* ? */

    if (room->query_light() <= 0) /* have to change for new light system */
    {
       write("It is dark.\n");
       return;
    }
    if (!str)
    {
        write(query_room_look(remote));
        return;
    }
}

/* 960222 Belgarion - finally fixed it to work with the new system. */

peer (dir)
{
    array DestDir = room->query_dest_dir();
    object ob;
    array lookwhere;
    string seen;
    int targ_light, i;
    object old_room = room;

    notify_fail("Peer where?\n");
    if (!DestDir)
        return;
    if (!dir)
        return;
    lookwhere = VISION->rooms_seen(this_player(), dir);
    if (!lookwhere)
        return;

/* should be a property? */
    if (room->stop_peer(dir))
    {
        write ("You cannot see that way.\n");
        return 1;
    }
    targ_light = lookwhere[0]->query_light();
    if (targ_light < 1)
    {
        write ("You peer into darkness.\n");
        if (!this_player()->query_wiz())
            return 1;
    }
    tell_object(this_player(), "Nearby you see:\n");
    room = lookwhere[0];
    room_long(0,1);
    seen = LOOK->query_contents_look(lookwhere[0], 0);
    if (seen && seen != "")
        tell_object(this_player(), "There you see: "+ seen);

    seen = "";
    for (i = 1; i < sizeof(lookwhere); i++)
    {
        targ_light = lookwhere[i]->query_light();
        if (targ_light < 1)
        {
            seen = seen +  "Darkness.\n";
            if (!this_player()->query_wiz())
                break;
        }
        seen = seen + lookwhere[i]->short() + ".\n";
    }
    if (seen != "")
        tell_object(this_player(), "In the distance you see:\n"+seen);
    room = old_room;
    return 1;
}

room_short() {
    return room->short();
}
