/*                              NPC AI Soul 
 *                              -----------
 *
 * Makes monsters do smart things in response to various situations. It's
 * intended that this soul will grow as more responses are coded.
 *
 * To make a monster react, call monster->react("to_what", arg1, arg2...).
 * For example, obj/projectile calls monster->react("distance_weapon").
 * Obj/monster calls this soul (if present). It also makes sure that the
 * monster isn't under player control. 
 *
 * Coding New Monster Reactions:
 * -----------------------------
 * Please follow the formats below. In particular, explicitly stating
 * all possible monster responses *before* formulating rules helps
 * to predict a wide range of scenarios.
 *
 * Current Reactions:
 * ------------------
 *  1. 	Monster is hit (nearly hit) by a distance weapon
 *	Args:
 *		- "distance_attack"
 *		- object attacker
 * 		- string direction of attacker
 *	Possible responses:
 *		1. Monster does nothing.
 *		2. Monster fires back own distance weapon.
 *		3. Monster charges at attacker.
 *		4. Monster runs off somewhere else.
 * 	Rules:
 *		1. Else if hp below wimpy, run off somewhere else.
 *		2. If has shootable weapon, almost always fire it.
 *		3. If has throwable weapon, 50% chance of throwing it.
 *		4. Else 75% chance of running at attacker.
 *		5. Else do nothing.
 *
 * 2.	Monster's distance attack succeeds
 *	Args:
 *		- "sucessful_distance_attack"
 *		- object target
 *		- string direction of target
 *	Possible responses:
 *		1. Monster does nothing.
 *		2. Monster attacks again.	
 *	Rules:
 *		1. 75% chance of attacking again.
 *		2. Else do nothing.
 *
 * 3.   Monster is attacked and attacker leaves.
 *      Args:
 *		- object attacker
 *		- string direction attacker leaves
 *	Possible responses:
 *		1. Monster does nothing
 *		2. Monster does distance attack
 *		3. Monster chases attacker
 *	Rules:
 *		1. If no_wander, mob sick or random chance, stay put
 *              2. Else chase player/monster 
 *		3. Special rules for leaving onto Rocs
 *
 * 950831 Jenna		Coded initial IQ soul, including "distance_attack".
 * 000808 Jenna		Mobs chasing players try to open doors
 */

#define DEBUG 0

inherit "obj/souls/base_soul";

reset(arg) 
{
	::reset(arg);
	if (!arg) {
		add_id( [ "soul", "ND", "monster_IQ", "monster_intelligence" ] );
		set_soul_type("npc", "iq");
		}
	// if (is_cloned(this_object())) call_out("check_env", 2);
}

// check_env() { if (!environment(this_object())) destruct(this_object()); }

init() 
{
	::init();
	if (!myself || !myself->query_NPC()) return;
    add_action("kill", "kill");

#if 0
    // some stuff for non-human NPCs who aren't getting all
    // the "standard" souls.
    add_action("nonhuman_communicate","ask");
    add_action("nonhuman_communicate","say");
    add_action("nonhuman_communicate", "Say");
    add_action("nonhuman_communicate", "\"", -1);
    add_action("nonhuman_communicate", "'", -1);
#endif

	myself->set_catch_tell_ob(this_object());
}

