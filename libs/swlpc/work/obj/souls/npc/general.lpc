/*
 * An npc soul for monsters who don't have a specific one
 * 
 * Jenna Sep 99
 * 
 * Sets up AC as a protection
 */

inherit "obj/souls/races/race_soul";

reset()
{
    ::reset();
}

init()
{
    ::init();
    if (myself && myself->query_ac())
        add_protection("physical",myself->query_ac());
}

