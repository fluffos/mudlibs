
inherit "obj/souls/races/galandrian/galandrian";

init()
{
    ::init();
    myself->setup_commands();
    myself->add_skill("bond", (myself->query_level() * 4));
    myself->add_skill("punch", (myself->query_level() * 4));
    myself->add_skill("claw", (myself->query_level() * 4));
    myself->add_skill("kick", (myself->query_level() * 4));
}
