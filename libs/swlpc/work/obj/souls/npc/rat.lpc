/*
 * A rat soul
 *
 * Actually gives them some simple rat hunting behaviour...
 */

inherit "obj/souls/races/race_soul";

init()
{
    ::init();
}

soul_init()
{
    call_out("hide", 3);
    myself->set_move(60);
    myself->set_wimpy(myself->query_max_hp(0) / 2);
    myself->set_rumours(0,0);
}

hide()
{
    object ob;
    ob = present("cat", environment(myself));
    if (ob && ob->query_living())
    {
       myself->run_away();
    }
    call_out("hide", 30);
}

