
inherit "players/jenna/sguild/ssoul";


init()
{
    int i;	
    ::init();
    braid = 1;
    powers = [ "scream", "blast", "powersong" ];
    if (myself->query_level() < 30) {
	braid = 2;
	powers = [ "scream", "blast" ];
	}
    if (myself->query_level() < 20) {
	braid = 3;
	powers = [ "scream" ];
	}
    if (myself->query_level() < 14)
	braid = 4;
    if (myself->query_level() < 8)
	braid = 5;	
    for (i = 0; i < sizeof(powers); i++)
	add_action(powers[i], powers[i]);
    myself->setup_commands();
    myself->add_god("Psyche");
    myself->add_skill("song", (myself->query_level() * 4));
}
