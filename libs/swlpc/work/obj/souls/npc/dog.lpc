/*
* A dog soul
*
* Actually gives them some simple rat hunting behaviour...
* Should also eat the corpses after killing them..
* Now they do - Dredd
* Now they grow - Greebo
* and are more efficient at killing cats.
* 
* Fixed bug which had dog gaining multiple bonuses for eating
* just one corpse (due to call_out in destruct()) - Jenna
*
*/

inherit "obj/souls/races/race_soul";

#define HUNT "cat"
#define HUNT_TIME 120

int MAX_GROW = 5;
int grows = 0;
int cats_eaten = 0;

init()
{
    ::init();
    add_action("trap", "trap");
}

soul_init()
{
    call_out("hunt", HUNT_TIME);
    myself->set_move(90);
    myself->set_rumours(0,0);
}

hunt()
{
    object ob;
    ob = present("corpse of a cat", environment(myself));

    if (find_call_out("hunt") != -1)
        remove_call_out("hunt");                /* jenna */

    if (ob)
    {
        myself->checked_say(myself->query_name() + " eats the "
            + ob->short() + ".\n");
        destruct(ob);
        cats_eaten++;
        if (cats_eaten >= (myself->query_siz()*myself->query_size()))
            call_out("grow_me", 10);
        call_out("hunt", HUNT_TIME);
        return;
    }
    ob = present(HUNT, environment(myself));
    if (ob && ob->query_living())
    {
        myself->init_command("kill "+HUNT); 
    }
    call_out("hunt", HUNT_TIME);
}

grow_me()
{
    if (grows >= MAX_GROW) return;
    grows++;
    myself->add_str(1);
    myself->add_con(1);
    myself->add_pow(1);
    myself->add_dex(1);
    myself->add_chu(1);
    myself->add_san(1);
    myself->add_siz(1);
    myself->add_int(1);
    myself->add_skill("offense",10);
    myself->add_skill("defence",10);
    myself->add_skill("dodge",10);
    myself->checked_say(myself->query_name() + " grows in size.\n");
    cats_eaten=0;
}

trap()
{
    object ob;
    int diff_str;
    
    ob = myself->query_attack();    
    
    if(!ob)
        return 0;
    if((!ob->query_living()) || (!ob->id(HUNT)))
        return 0;
    
    if ((ob->query_dex() <= myself->query_dex()) && !random(2)) {
        myself->checked_say(myself->query_name() + " traps the "
            + ob->short() + " around the neck and savages it.\n");
        
        diff_str=myself->query_str() - ob->query_str();
        if(diff_str < 1)
            diff_str = 3;
        diff_str *= 10;
        ob->hit_player(diff_str, "head");
    }
    else
    {
        myself->checked_say(myself->query_name() + " tries to trap the "
            + ob->short() + " by the tail, but misses.\n");
    }
    return 1;
}

