
#include "Servers.h"
inherit "obj/souls/races/race_soul";

#define ARMOUR_BONUS 2
int t=time();

reset(arg)
{
    ::reset(arg);
    if(arg) return;
    set_soul_type("race","wolf");
}

init()
{
    ::init();
    if(myself != this_player()) return;
    myself->add_base_armour(ARMOUR_BONUS);
    myself->set_body(MONSTERER->test("wolf"));
    add_action("maul","maul");
}

maul(who)
{
object enemy;
int diff_str;

    if(who==myself->query_real_name()) return 0;
    notify_fail("Maul who?\n");
    if(!who)
    {
	if(!myself->query_attack()) return 0;
	enemy= myself->query_attack();	
    }
    else
	enemy= present(who,environment(myself));
    if(!enemy) return 0;
    if(!enemy->query_living()) return 0;
    if((time() - t) > (10 - myself->query_store("berserk_level")))
    {
    	t=time();
	enemy->attacked_by(myself);
	if(enemy->query_dex() < myself->query_dex() && !random(2)) 
        {
	    tell_object(enemy, myself->query_name()+" mauls you savagely.\n");
	    say(myself->query_name()+" mauls "+enemy->query_name()+" savagely.\n",enemy);
	    write("You maul "+enemy->query_name()+"!\n");
	    diff_str=myself->query_str() - enemy->query_str();
	    if(diff_str < 1) diff_str= 5;
	    enemy->hit_player(diff_str); 
	}
	else
	{
	    say(myself->query_name() +" tries to maul "+enemy->query_name()+" but misses!\n");
	    write("You try to maul "+enemy->query_name()+", but miss.\n");
	}
    }
    else
	write("You have to recover a little bit longer.\n");
    return 1;
}



