inherit "obj/souls/communicate";

#include <Servers.h>
#include "security.h"
#include "gender.h"

reset(arg)
{
	::reset(arg);
	if (arg) return;
	add_id("communicate");
	add_id("ghost_communicate");
	set_soul_type("generic", "ghost/communicate");
}

init(arg) {
	if (myself && !myself->query_ghost()) destruct(this_object());
	::init(arg); }

shout_to_all(str)
{
	write("You muster all your energy and produce some rustling sounds.\n");
	return 1;
}

tell(arg)
{
	write("You make faint whistling sounds.\n");
	return 1;
}

whisper(arg) {
object ob;
string who, msg, it;

	write("You produce a rushing sound.\n");
	return 1;
}
