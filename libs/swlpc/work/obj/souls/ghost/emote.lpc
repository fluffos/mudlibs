inherit "obj/souls/emote";
#include <Servers.h>

reset(arg)
{
	::reset(arg);
	if (!arg)
	{
		add_id("emote_soul");
		add_id("ghost_emote_soul");
		set_soul_type("generic", "ghost/emote");
	}
}

init(arg) {
	if (myself && !myself->query_ghost()) destruct(this_object());
	::init(arg); }

dead_cry(str) { 
    return general("Waaaaah!", "bursts into tears.");
}

dead_mumble() { return general("You mumble to yourself.", "mumbles to "
	+GENDER->obj()+"self."); }

dead_punch(str) {
    return general("You do some ghost boxing!", "ghost boxes!");
}

dead_smile(str) {
        write("You smile inwardly.\n");
	return 1;
}

query_prefix() { return "dead_"; }

