inherit "obj/souls/handle";

reset(arg) 
{
	::reset(arg);
	if (!arg) {
		add_id( "handle" );
		set_soul_type("generic", "ghost/handle");
	}
}

init(arg) 
{
	if (myself && !myself->query_ghost()) destruct(this_object());

    ::init(arg);

    add_action("notsolid","give");
    add_action("notsolid","drop");
    add_action("notsolid", "put");

    add_action("notsolid", "get");
    add_action("notsolid","take");

    add_action("notsolid", "wield");
    add_action("notsolid", "unwield");
    add_action("notsolid", "remove");
    add_action("notsolid", "wear");
    add_action("notsolid", "worn");
    add_action("notsolid", "eat");
    add_action("notsolid", "consume");
    add_action("notsolid", "devour");

}

notsolid() 
{
	write("You aren't solid enough to do that!\n");
	return 1; 
}

