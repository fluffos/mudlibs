/* ghost combat soul.   */
inherit "obj/souls/combat";

#define	write(x) tell_object(myself, (x))
#include "Servers.h"

reset(arg)
{
	::reset(arg);
	if (!arg) {
		set_soul_type("generic", "ghost/combat");
		add_id("combat");
		add_id("ghost_combat");
		}
}

init(arg) {
	if (myself && !myself->query_ghost()) destruct(this_object());
	::init(arg); }

nosave suicide_c() {
	write("You are already dead!\n");
	return 1;
}

nosave kill(str)
{
	write("You thrash about wildly!\n");
	return 1;
}

