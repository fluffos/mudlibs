inherit "obj/souls/support";

reset(arg)
{
	::reset(arg);
	if (!arg) {
		add_id( "support" );
		add_id( "ghost_support" );
		set_soul_type("generic", "ghost/support");
	}
}

score() {
	write("You are in an immaterial state with no scores.\n");
	return 1;
}

init(arg) {
	if (myself && !myself->query_ghost()) destruct(this_object());
	::init(arg); }
