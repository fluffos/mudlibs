inherit "obj/souls/perception";

reset(arg)
{
	::reset(arg);	
	if (!arg) {
		add_id( "perception" );
		add_id( "ghost_perception" );
		set_soul_type("generic", "ghost/perception");
	}
}

init(arg) {
	if (myself && !myself->query_ghost()) destruct(this_object());
	::init(arg); }

diagnoses() 
{
    write ("You are immaterial.\n");
    return 1;
}		

inventory()
{
    if (myself->test_dark()) return 1;
    write("You are a ghost and can't carry anything.\n");
    return 1;
}
