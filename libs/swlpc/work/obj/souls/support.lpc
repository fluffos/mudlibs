reset(arg)
{
	"obj/souls/base_soul"::reset(arg);
	"std/txted"::reset(arg);
	if (!arg) {
		add_id("support");
		add_id("support soul");
		set_soul_type("generic", "support");
		MoreLength = 0;
	}
}

set_prompt(str)
{
    notify_fail("prompt <string>\n");
    if (str == 0) return 0;
    if (str == "off") 
    {
        myself->set_prompt("");
    }
    else if (lower_case(str) == "cronus")
    {
        if (myself->query_store("hilite_on"))
            myself->set_prompt(COLOUR->colour("{k[{wHP=%c{w/{G%H{w SP=%C{w/{G%S{k] "));
        else
            myself->set_prompt("[HP=%h/%H SP=%s/%S] ");
    }
    else if (lower_case(str) == "oceanus")
    {
        if (myself->query_store("hilite_on"))
            myself->set_prompt(COLOUR->colour("{c[{CHealth: %p%{c] "));
        else
            myself->set_prompt("[Health: %p%] ");
    }
    else if (lower_case(str) == "rhea")
    {
        if (myself->query_store("hilite_on"))
            myself->set_prompt(COLOUR->colour("{r[{R%h{r/{R%H{rhp {R%s{r/{R%S{rsp] "));
        else
            myself->set_prompt("[%h/%Hhp %s/%Ssp] ");
    }
    else if (lower_case(str) == "atlas")
    {
        if (myself->query_store("hilite_on"))
            myself->set_prompt(COLOUR->colour("{G<< {Y%h/%Hhp {C%s/%Ssp {G>> "));
        else
            myself->set_prompt("<< %h/%Hhp %s/%Ssp >> ");
    }
    else if (lower_case(str) == "themis")
    {
        if (myself->query_store("hilite_on"))
            myself->set_prompt("%c/%C:");
    }
    else
    {
        if (index(str,"{") != -1) str = COLOUR->colour(str);
        myself->set_prompt(str + " ");
    }
    write("Ok.\n");
    return 1;
}

