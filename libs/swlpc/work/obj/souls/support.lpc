nosave object execr = 0;	/* execution soul */
nosave int input_window = 0;

/*
 * find & initialise executor.
 * basic program:
 *	L ALIAS_LOOP:
 *	    S ALIAS:
 *		pause
 *	L<ALIAS_LOOP
 * new commands are C]'d to alias
 * immediate commands are C['d
 */

int find_execr() {
string go = "[Command start]";
string stop = "[Command end]"; 
    if (objectp(execr))
	return 1;
    execr = myself->query_soul("generic/executor");
    if (!execr) return 0;
    execr->do_program( "LMALIAS_LOOP:TM"+"PITM"
	+"LMCMD_LOOP:CECMD_REG:L>CMD_LOOP:L<CMD_LOOP:"
	+"L<ALIAS_LOOP:smirk");
#if 0
    execr->do_program( "LMALIAS_LOOP:TM"+stop+"\nPITM"+go
	+"\nLMCMD_LOOP:CECMD_REG:L>CMD_LOOP:L<CMD_LOOP:"
	+"L<ALIAS_LOOP:smirk");
#endif
    }

string more_file;
int Ticket, MoreLength;
/* The alias stuff is below */
array commands;			/* Save storage for commands */
array subs;			/* What is substituted. each command is 
