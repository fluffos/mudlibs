review_buf(str)
{
    array catch_buf;

    if (str) return 0;

    catch_buf = myself->query_catch();
    
    if (!pointerp(catch_buf)) 
    {
        write("Nothing.  How boring.\n");
        return 1;
    }

    MORE->more(implode(catch_buf, "\n"), "catch_seen");
    return 1;
}

catch_seen() 
{
    write("Do you want to delete your what-happened buffer (default is 'yes')? ");
    input_to("catch_buf_del");
    return 1;
}

catch_buf_del(s) 
{
    write("What-happened buffer ");
    if ((!stringp(s)) || s[0..0] == "n") {
    write("retained.\n");
    return 1;
    }
    write("deleted.\n");
    myself->set_catch(0);
    return 1;
}


