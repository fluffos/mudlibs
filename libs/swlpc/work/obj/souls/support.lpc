array harr = [ "on", "off", "list" ] + ANSI->query_hilite_list();

hilite(str, quiet)
{
    int x, i, col;
    array words, rest;

    array schemes = [
	"standard",
	[ "tell", YELLOW, "say", GREEN, "shout", RED,
	  "exits", PURPLE, "roomnames", WHITE,
	  "things", FAINT_YELLOW, "people", FAINT_GREEN,
	  "combat", FAINT_RED, "hits", RED ],
	"bright",
	[ "tell", YELLOW, "say", CYAN, "shout", WHITE,
	  "exits", PURPLE, "roomnames", WHITE,
	  "things", YELLOW, "people", GREEN,
	  "combat", RED, "hits", INVERSE_RED ],
	"subdued",
	[ "tell", GREEN, "say", FAINT_GREEN, "shout", FAINT_PURPLE,
	  "exits", FAINT_CYAN, "roomnames", CYAN,
	  "things", FAINT_GREEN, "people", FAINT_PURPLE,
	  "combat", FAINT_RED, "hits", RED ]
	];

    notify_fail("Usage: hilite <" + implode(harr, ", ") + ">\n");
    if (!str) return 0;
    words = explode(str, " ");
    if (index(harr, words[0]) == -1)
    {
	x = index(schemes, words[0]);
	if (x == -1)
		return 0;
	write("Your hilite settings now use the \""+words[0]+
	    "\" scheme.\n");
	for (i = 0; i < sizeof(schemes[x+1]); i+=2)
	    myself->add_store("hilite_"+schemes[x+1][i], schemes[x+1][i+1]);
	return 1;	    
    }
    if (words[0] == "on")
    {
       myself->add_store("hilite_on", 1);
       // myself->set_prompt(ANSI->faint(ANSI->scolor(0,"> ")));
       write("Hilighting turned " + ANSI->bold("on") + ".\n");
    }
    else if (words[0] == "off")
    {
        myself->add_store("hilite_on", 0);
        // myself->set_prompt("> ");
	write("Hilighting turned off.\n");
    }
    else if  (words[0] == "list")
    {
	array tmp = [];

	for (i = 0; i < sizeof(schemes); i += 2)
	    tmp += [ "\"" + schemes[i] + "\"" ];
	color_list();
	write("Available hilite schemes: " +
	    STRINGS->array2string(tmp) + ".\n");
    }
    else
    {
        if (sizeof(words) < 2) return 0;
        rest = implode(words[1..], " ");
        col = ANSI->get_color(rest);
        if (col == 0 && rest != "normal")
        {
            write("Available colors include: normal, black, white, red, "+
		"blue, green, yellow, cyan, grey. Most of these may also "+
		"be preceeded by inverse or faint.\n");
            return 1;
        }
        myself->add_store("hilite_"+words[0], col);
	if (!quiet)
            write("Hilighting for \""+words[0]+"\":  " + rest + ".\n");
    }
    return 1;
}

color_list()
{
        array list = ANSI->query_hilite_list();
        string str;
        int x,i;
        object ob = this_player();
        
        write("\t\t\tHilite Preferences\n");
        
        for (i=0;i<sizeof(list);i++)
        {
                x=ob->query_store( ("hilite_"+list[i]) );
                if (x<=0)
                str = "undefined";
                else str = ANSI->get_color_str(x);

                if (list[i] != "wiz" || ob->query_wiz())
                  write ( capitalize (list[i]) + " color is: "
                        + ANSI->scolor(x,str) + ".\n");

        }
}               
                        /* added color_reset function here */
color_reset()
{
        array list=
        ({"tell","say","shout","exits","rooms","roomnames","exits","combat"});
        
        string str;
        int x;
        int i;
        for (i=0;i<sizeof(list);i++){
                str = list[i];
                if (str == "tell") x = YELLOW;
                else if (str == "say") x= GREEN;
                else if (str == "shout") x= RED;
                else if (str == "exits") x= PURPLE;
                else if (str == "wiz") x= CYAN;
                else if (str == "roomnames") x = WHITE;
                else if (str == "rooms") x = WHITE;
                else if (str == "combat") x = WHITE;
          this_player()->add_store("hilite_"+str, x);
                
                }
     write ("Hilite reset.\n");
}

room_reset() 
{
    object o = environment(myself);
    if (o) {
        tell_object(myself, "Already reset.\n");	/* heh */
	}
    return 1;
}

split_screen((string | int) cmd)
{
    notify_fail("split <on | off> to turn split-screen mode on or off\n");
    if (cmd == "on")
    {
	if (input_window > 0 && myself->query_window_data(input_window))
	{
	    write("Split screen mode already on.\n");
	    return 1;
	}
	if (myself->query_store("hilite_on") == 0)
	    write("WARNING: split screen mode uses ANSI escapes.  You have " +
		    "hilite mode off, which implies your terminal does not " +
		    "support them.\n");
	input_window = myself->create_window(WIN_INPUT, WIN_BOTTOM, 2);
	if (input_window > 0)
	{
	    myself->set_current_input_window(input_window);
	    myself->add_store("splitscreen_on", 1);
	}
    }
    else if (cmd == "off")
    {
	if (input_window > 0)
	{
	    myself->delete_window(input_window);
	    input_window = 0;
	    myself->add_store("splitscreen_on", 0);
	}
	else
	    write("Split screen mode not currently on anyway.\n");
    }
    else
	return 0;
    return 1;
}

