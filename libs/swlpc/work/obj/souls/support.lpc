ear_muffs(str)
{
    notify_fail("Earmuffs on or earmuffs off?\n");
    if (!str) {
    if (myself->query_muffled()) write("Your earmuffs are currently on.\n");
    else write("Your earmuffs are currently off.\n");
    return 1;
    }
    if (str == "on") myself->set_muffled(1);
    else if (str == "off") myself->set_muffled(0);
    else return 0;
    write("Ok.\n");
    return 1;
}

