inherit "obj/souls/base_soul";

array vsimple;
#if 0
string cap_name;
#endif

#define EMOTES    "std/emotes"

reset(arg)
{
    ::reset(arg);
    if (!arg)
    {
    add_id("emote_soul");
    set_soul_type("generic", "emote");
    }
}
        
init() 
{ 
    ::init();
    add_action("poss_soul_cmd", "", -1);
    add_action("emote_hook", "", -1);
}
    

cap_name() 
{
    if (myself->query_ghost()) 
    return "Something";
    else 
    return myself->query_name();
}

nosave array preps = ({
    "to", "on", "in", "at", "under", "behind"
    });

string qv;        /* The current emotion */

int
poss_soul_cmd(str) 
{
    string arg;
    string who;
    array ret, arr;
    int i;

    qv = lower_case(myself->query_verb());
    if (!qv) return 0;
    if (str) 
    {
        str = lower_case(str);
        arr = explode(str, " ");
        if (sizeof(arr) > 1) 
        {
            if (index(preps, arr[0]) > -1) str = implode(arr[1..], " ");
        }
/* Next four lines added to [hopefully] fix the invis problem. - Belgarion */
        who = str;
        if (present(who, environment(myself)))
        {
            object o = present(who, environment(myself));
            if (o) str = o->query_name();
            else str = "Someone";
        }
    }
    if (this_object()->(this_object()->query_prefix()+qv)(str, who)) return 1;
    ret = EMOTES->action(myself, qv);
    if (ret && pointerp(ret)) 
    {
    while (remove_call_out("remove_action") > 0) i++;

    tell_object(myself, ret[0]);
    myself->checked_say(ret[1]);
    myself->set_current_action(ret[2]);
    call_out("remove_action", 3, myself); 
    return 1;
    }
}

remove_action(pob)
{
    pob->set_current_action(0);
}

ghost() 
{
    return myself->query_ghost(); 
}

nosave 
general(mymesg, others) 
{
    write(mymesg + "\n");
    myself->checked_say(this_object()->cap_name() + " " + others + "\n");
    return 1;
}

nosave 
specific(mymesg, others, whom, target) 
{
    if (this_object()->ghost()) 
    return 0;
    whom = present(lower_case(whom), environment(myself));
    if (!whom || !whom->query_living() || whom == myself) 
    return 0;
    write(mymesg + "\n");
    myself->checked_say (this_object()->cap_name() + " " + others + "\n", whom);
    if (whom->query_npc()) 
        whom->emoted(qv);
/*    else   */
    tell_object(whom, this_object()->cap_name() + " " + target + "\n");
    return 1;
}

/* recip param added 9/1/95 by Belgarion to fix "Someone" bug. */
simple(arg,nverb,head,tale, recip)
{
object who;
    if (!arg) 
    return 0;
    if (head) 
    head=" "+head;
    else 
    head="";
    if (!tale) 
    tale=".";
    if (recip == 0) recip = arg;
    who = present(lower_case(recip), environment(myself)); /* B. */
    if (!who || !who->query_living() || who == myself) 
    return 0;
    arg = capitalize(arg);
    write("You "+nverb+head+" "+arg+tale+"\n");
    myself -> checked_say (this_object()->cap_name()+" "+nverb+"s"+head+" "+arg+tale+"\n",
        who);
    if (who->query_npc()) 
        who->emoted(qv);   // ?? Jenna wonders why, Mar 2001 
/*    else  */
    tell_object(who, this_object()->cap_name()+ " "+nverb+"s"+head+" you"+tale+"\n");
    return 1;
}

