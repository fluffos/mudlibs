/* special because of the frog curse.  sigh. */
comm_kiss(str, recip) {
    object who;
    if (this_object()->ghost() || !str)
        return 0;
    who = present(recip, environment(myself));
    if (!who || !who->query_living() || who == myself)
        return 0;
    tell_object(who, this_object()->cap_name() + " kisses you.\n");
    str = capitalize(str);
    myself -> checked_say (this_object()->cap_name() + " kisses " + str + ".\n", who);
    write("You kiss " + str + ".\n");
    return 1;
}

