/* OBSOLETE */

#include "Servers.h"
int money;

reset(arg) {
    if (arg) return;
    money = 1;
}

query_weight() { return money/5000; }

short() {
    if (money == 0) return 0;
    return NUMBERS_SERV->int_to_english(money, this_player()->query_int())+
    	" gold coins";
}

long() { return short() + ".\n"; }
/*
 * If we are picked up by a player, then move the money to his "purse",
 * and destruct this object.
 */
init() {
	object other;
    if (environment())
	{
		if (living(environment(this_object()))) {
			environment(this_object())->add_money(money);
			money = 0;
			check_used ();
		} else {
			other = present("money 2", environment());
			if (other && other != this_object())
			{
				other->set_money(other->query_money()+money);
				money = 0;
				check_used();
			}
		}
	}
	return 1;
}

get() { return 1; }

set_money(m) {
    if (m < 1) m = 0;
    money = m;
}

query_money() { return money; }
query_value() { return money; }

/*
	A nasty hack so we can id any coins to a certain
	number of coins (if the number is < the amt we have)

	Dredd 1992.
*/
#define MAX_COINS 10000000
id(str) 
{
    int l, x;
    object o;
    array allargs;

	if (str == "coins" || str == "money") return 1;
    allargs = STRINGS->split_first(str, " ");
    if (sizeof(allargs) < 2) return 0;
    if (allargs[1] != "coins") return 0;
    x = atoi(allargs[0]);
	if (x < money) 
    {
		if (x < 0) x = 0;
		if (x > MAX_COINS) x = MAX_COINS;
        l = money - x;
        o = MONEYER->make(l, this_player());
		o->mmm(environment());
		money = x;
		return 1;
	}
}

mmm(o) { call_out("mmmm", 1, o); }
mmmm(o) { move_object(this_object(), o); }

check_used() {
    if (money < 1)
	destruct(this_object());
    else call_out ("check_used",60);
}

