/*
 * Base Guild Soul
 * All Guild souls must inherit this object.
 */

/*
 * History
 * 950922 Hunter		Created guild_soul.c as part of widespread cleanup of soul
 */

inherit "obj/souls/base_soul";

#define DUES_SERV	"guilds/dues"

reset(argh)
{
    ::reset(argh);
    add_id("guild_soul");
}

soul_init()
{
	if(find_call_out("check_dues") == -1)
		call_out("check_dues", random(30) + 40);
}

check_dues()
{
	if (!myself->is_player()) return;
		/* Only check players */
	if (!GUILD_SERV->god_exists(soul_specific)) return;
		/* Not really a guild soul */
	if (!GUILD_SERV->member(soul_specific, myself->query_real_name())) {
		remove_soul();
		return;
		}
	string why_not = GUILD_SERV->can_join(soul_specific, myself);
	if (why_not)
	{
		if (!random(10))
		{
			tell_object(myself, "You are overcome with the stress of "+
				"your conflicting guilds! " +  why_not);
			remove_soul();
			return;
		}
		tell_object(myself, "You feel stress at your conflicting guild "+
			"associations! " + why_not);	 
                call_out("check_dues", (random(10) + 1) * 10);
		return;
	}
	if (DUES_SERV->can_enter(soul_specific, myself->query_real_name()))
		return;	/* No further action - player is ok */
	if (!random(10))
	{ 
		tell_object(myself, "You are overcome with guilt at your "+
			"outstanding guild dues.\n");
		remove_soul();
	}
	else
	{
		tell_object(myself, "You begin to feel a little guilty about "+
			"your outstanding " + capitalize(soul_specific) +
			" guild dues.\n");
		call_out("check_dues", (random(10) + 3) * 100);
	}
}

remove_soul()
{
	tell_object(myself, "You lose your faith.\n");
	destruct(this_object());
}


