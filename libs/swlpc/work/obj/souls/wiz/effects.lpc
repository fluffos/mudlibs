int
long_local_commands(s) 
{
    object ob;
    array c;
    array d, ret;
    array switches;
    int x,i;
    string f,t ;
    string action;
    string obj;
    object o;	
    string func;

    if (this_player() != myself) return;
    ob = this_player();
    if (s)
    {
	switches = COMARGS->split_args( s, [ ], [ "a", "o", "f" ] );
	if (sizeof(switches[0]) != 0)	/* look for another character */
	{
	    ob = mywiz->find_item(switches[0][0]);
	    if (intp(ob))
	    {
		notify_fail("localcmd: could not find object " 
			+ switches[0][0]+"\n");
		return 0;
	    }
	    else
		ob = ob[0];
	}
	action = switches[2][0];
	obj = switches[2][1];
	func = switches[2][2];
	if (stringp(obj))
	{	
		if (obj == "")
		{
			notify_fail("localcmd: no object specified\n");
			return 0;
		}
		o = mywiz->find_item(obj);
		if (pointerp(o))
		    o = o[0];
		if (o)
		    obj = file_name(o);
	}
    } 
	notify_fail("Localcmd Who?\n");
    if (!objectp(ob)) return 0;

    ret = (ob->query_actions())->show_stats();
    MORE->more(ret);

#if 0
    c = localcmd(ob);
    d = allocate(sizeof(c)/3+1);
    d[0] = "Command       Object->Function()";
    i = 1;
    for (x=0; x<sizeof(c); x+= 3) {
	f = file_name(c[x+1]);
	if (action && action != c[x][..sizeof(action)-1]) {}
	else if (func && func != c[x+2][..sizeof(func)-1]) {}
 	else if (!objectp(c[x+1]))
	{
	    d[i] = "'"+c[x]+"' - no object binding!";
	}
	else if (obj && obj != file_name(c[x+1])[..sizeof(obj)-1]) {}
	else
	{ 
		t = "'"+c[x]+"'";
		d[i] = FORMAT->left_justify(t,14) +  
			f+"->"+ c[x+2]+"()";
		i = i +1;
	}
    }
    MORE->more(d[..i-1]);
#endif
    return 1;
}

int
query_local_commands(s) 
{
    object ob, commobj;
    array ret, cmd;
    string funct, command;
    int i;

    if (this_player() != myself) return;
    ob = this_player();
    if (s != "")
    {
	    ret = ob->query_actions()->query(s);
	    if (ret && sizeof(ret) > 0)
        {
	    for (i=0; i < sizeof(ret); i++)
            {
                commobj = ret[i][0];
                funct   = ret[i][1];
                command = ret[i][2];
                write(file_name(commobj)+"->"+funct+"() ("+command+")\n");
            }
        }
        else
        {
            write("Action not currently defined.\n");
        }
    }
    else
    {
        notify_fail("which: no command specified\n");
        return 0;
    }
    return 1;
}

echo(str) {
    if (this_player() != myself) return;
    if (!str) {
        notify_fail("Echo what?\n");
        return 0;
    }
    write("You echo: ");
    tell_room(environment(myself), str + "\n");
    return 1;
}

echo_to(str) 
{
    object ob, it;
    string msg;
    array allargs;

    notify_fail("Echoto what ?\n");
    if (this_player() != myself) return 0;

    allargs = STRINGS->split_first(str, " ");
    if (sizeof(allargs) < 2) return 0;

    it = lower_case(allargs[0]);
    msg = allargs[1];

    ob = find_player(it);
    if (!ob) ob = find_living(it);
    if (!ob) ob = mywiz->find_item(it);
    if (pointerp(ob))
	ob = ob[0];
    if (!ob) {
        write("No player with that name.\n");
        return 1;
    }
    tell_object(ob, msg + "\n");
    write("You echo: " + msg + "\n");
    return 1;
}

echo_all(str) {
    if (this_player() != myself) return;
    if (!str) {
        notify_fail("Echoall what?\n");
        return 0;
    }
    SHOUT->shout(str + "\n");
    write("You echo: " + str + "\n");
    log_action("echoalls",str);	
    return 1;
}

