date()
{
    write("The date and time are:  "+ctime(time())+"\n");
    return 1;
}

wiz_shout(str)
{
    string msg;
    array list;
    int i;

    if (!str) return 0;
    if (this_player() != myself) return;
    list = users();
    while (i < sizeof(list)) {
        if (list[i]->query_wiz() && list[i] != myself
            && environment(list[i])) { /* for people getting on but not giving p
asswd */
                if (list[i]->query_caution())
                        list[i]->add_note(capitalize(myself->query_real_name()) 
                                +" wizshouts: "+str+"\n");
                else 
                {
                    msg = capitalize(myself->query_real_name())+
                            " wizshouts: "+str+"\n";
                    msg = ANSI->scolor(ANSI->hilite(list[i], "wiz"), msg);
                    tell_object(list[i], msg);
                }
                
        }
        i++;
    }
    write("You wizshout: "+str+"\n");
    return 1;
}

string
switches_row(array sw, array st)
{
int i, pos;
array ret = allocate(sizeof(sw));
string adds;
    pos = 0;
    for (i = 0; i < sizeof(sw); i ++)
    {
	if (sw[i])
	{
	    adds = FORMAT->left_justify( st[i*2], st[i*2+1] );
	    if (st[i*2+1]&& (sizeof(adds) > st[i*2+1]))
	        adds = adds[0..st[i*2+1]-2] + "..";
	    ret[pos++] = adds;
	}
    }
    return implode(ret, "");
}

list_users(list, options) 
{
int i=0,j,tmpl, tmpi, pos, strt, lend, rpos;
(int|string) tmpr;
object fred;
array switches;
array ret = allocate(2 + sizeof(list));
object o_wiz_soul;
    if (!options || options == "")
                options = "-a -b -n -l -i -env";
    switches = COMARGS->split_args(options, 
	[ "a", "b", "ear", "n", "sex", "r", "l", "i", "env" ],
	[ ] );
    ret[0] = "Load Average : "+M_DISASS->command_load() + " cmds/s, " +
        M_DISASS->compile_load() + " compiled lines/s";
    ret[1] = switches_row(switches[1], [
                "Address", 16,
                "B", 1,
                "E", 1,
                " Name", 14,
                "Sex", 4, 
                "Race", 10,
                "Level", 9,
                "Idle", 6,
                "Location",0
        ] );
    rpos = 2;
    strt = 0;
    while(i<sizeof(list)) {
        string name;
        string outstr;
        string ip1, ip2;
        int invis;
        string idle;

        pos = strt;
        ip1 = list[pos]?query_ip_number(list[pos]):"ZZZZZZZ";   
        for (j =strt + 1 ; j < sizeof(list); j ++)
        {
                if (list[j] && (ip2 = query_ip_number(list[j])) < ip1)
                {
                        pos = j;
                        ip1 = ip2;
                }
        }
/*
        if (pos == strt+1) 
                strt = pos; 
*/
        invis = (list[pos]->short() == 0);
        name = list[pos]->query_real_name();
        if (!name) name = list[pos]->query_name();
        if (!name) name = "[login]";    
        name = capitalize(name);        

        idle = (list[pos]->query_idle())/60;
        if (idle < 0) 
                idle = 0;
        idle = (idle?(idle+"m"):"");

        if (environment(list[pos]))
        {
/*        array t; what's this for? */
            tmpr = file_name(environment(list[pos]));
            if (tmpr[0..1] == "P/") {
		string inside;
                if (environment(list[pos]))
		  inside = environment(list[pos])->query_real_name();
                if (inside) tmpr = "inside "+ capitalize(inside) +" ("+tmpr+")";}
            tmpr = FILENAME->contract(tmpr);
        }
        else 
                tmpr = "<no environment>";

        if (!(present("hidden_peo", list[pos]) && myself->query_wiz() < SENIOR))
        ret[rpos++] = switches_row(switches[1], [
                ip1, 16,
                ( (o_wiz_soul = list[pos]->query_soul("wizard/wiz_soul") )
			&& o_wiz_soul->query_busy( ))?"*":" ", 1,
                (list[pos]->query_muffled()?"*":" "), 1,
                (invis?("("+name+")"):(" "+name+" ")), 14,
                (list[pos]->query_gender() == "male")?" M":
                        ((list[pos]->query_gender() == "female")?" F":" ?"), 4,
                list[pos]->query_race(), 10,
                LEVELS->query_desc(list[pos]), 9,
                idle, 6,
                tmpr,0
        ] );

        list[pos] = 0;  
        i += 1;
    }
    ret = ret[..(rpos - 1)];
    MORE->more( ret );
    return 1;
}

int
set_store(str)
{
string mess, curr;
array alist;
int i;
    notify_fail("Set <clone, home, dest, in, out, tin, tout, soul> message?\n"
        +"Set <elan> (on|off)?\n");
    if (!str) 
	return 0;
    if (str[0..3] == "elan")
    {
		curr = "";
		if (str == "elan on")
                        mywiz->setenv("WIZARD_ELAN", 1);
                else if (str == "elan off")
                        mywiz->setenv("WIZARD_ELAN", 0);
                else
                	curr = "currently ";
		write("You have "+curr+["disabled","enabled"]
		    [myself->query_store("WIZARD_ELAN")] +
		    " elan cost for people 'telling' you stuff.\n");
		int n = "obj/souls/communicate"->elan_worth(myself->query_wiz());
		write("Elan cost to talk to you is " + n + ".\n") ;
                return 1;
        }
        alist = explode(str, " ");
        if (sizeof(alist) < 2) return;
        str = alist[0];
        mess = implode(alist[1..], " ");
        if (str == "in" || str == "out") {
                myself->("setm"+str)(mess);
                write("Ok.\n");
                return 1;
        }
#if 0
        alist = [
                "clone", "clone_message", 1,
                "dest",  "destruct_message", 1,
                "home", "home_message", 0, 
                "tin",  "t_in", 0, 
                "tout", "t_out", 0,
                "soul", "soulname", 1
        ];
    for (i = 0; i < sizeof(alist); i += 3) 
    {     
        if (str == alist[i]) 
 	{  
#if 0
            if (alist[i+2]) 
	 	mywiz->setenv(alist[i+1], mess, 
			myself->query_real_name()[0]);
            else 
#endif
		mywiz->setenv(alist[i+1], mess);
            write("Ok.\n");
            return 1;
        }
    }
#endif
    return;
}



review() {
int p;
    write(  "out:\t\t" + myself->query_msgout() +
	  "\nin:\t\t" + myself->query_msgin() +
	  "\ntout:\t\t" + mywiz->getenv("t_out") +
	  "\ntin:\t\t" + mywiz->getenv("t_in") + 
	  "\nhome:\t\t" + mywiz->getenv("homemsg")+
          "\nvi/more:\t"+ mywiz->getenv("vimsg")+
	  "\nclone:\t\t" + mywiz->getenv("clonemsg")+
	  "\ndest:\t\t"+ mywiz->getenv("destmsg",p)+
	  "\ni! defaults:\t"+mywiz->getenv("I!_DEFAULTS")+
	  "\ncaution:\t");
    myself->display_cautions();
    write(  "elan cost:\t"+ myself->query_soul("generic/communicate")->elan_worth(myself->query_wiz()) +
	" ("+(myself->query_store("WIZARD_ELAN")?"on":"off")+")\n");
    write(  "backups:\t"+ (mywiz->query_backups()?"on":"off")+"\n");
    return 1;
}


query_help(what) {
    if (this_player() != myself) return;

    if (what == "wiz_levels" || what == "wiz_level") {
	write("Any Wizard can:\n");
	write("        wizl)ist, peo)ple, wiz)shout,\n        set <home, in, tin, out, tout, clone, dest, soul> review,\n");
	write("        caution, title, god, xgod, light.\n");
	write("Apprentice Wizards (level "+APPRENTICE+") can:\n");
        write("        ls, cd, pwd, man, pager,\n        cat, more, tail, view, page, goto.\n");
	if (wiz_level >= CREATE) {
	    write("Level "+CREATE+" Wizards can:\n");
	    write("        get!, drop!, give!, put!,\n        echoto, echo (#), echoall,\n        at, in, zap!, heal, gag, rgag, dot, map,\n");
	    write("        ori)gin, whe)re, sta)t, dump, i!,\n        cl)one, des)truct\n");
	    write("        upd)ate (ud), loa)d, log, err, rep, rmlog, rmrep, rmerr\n        tra)ns, trans!, cli)mbin, exit, hom)e,\n");
	    write("        rm, mkdir, rmdir, cp, mv,\n        call, loc)alcmd, clean)room, trust, force, date, work, vi.\n");
	}
        if (wiz_level >= INVIS)
	    write("Level "+INVIS+" Wizards can: invis, vis\n");
        if (wiz_level >= STAT)
            write("Level "+STAT+" Wizards can: read other wizard's files\n");
        if (wiz_level >= SNOOP)
            write("Level "+SNOOP+" Wizards can: snoop\n");
        if (wiz_level >= SENIOR) 
            write("Level "+SENIOR+" Wizards can: edit other wizard's files\n");
        if (wiz_level >= SHUTDOWN)
            write("Level "+SHUTDOWN+" Wizards can: shutdown, time, promote\n");
        if (wiz_level >= EDIT_STANDARD)
            write("Level "+EDIT_STANDARD+" Wizards can: edit files in /room and /obj, and log files.\n");
        return "--";
    }
    return 0;
}

/* Zaphoid Jul 2001 - redefined bugs command to call the bug board and list
   outstanding bugs - in arg supplied then read individual bug */
bug_list(num)
{
	object reader, board;
	board = find_object("obj/bulletin/board_serv/bug");
	if (!num)
	{
		board->list_unaddressed_notes();
		return 1;
	}
	else
	{
		reader = clone_object("obj/bulletin/board_reader");
		move_object(reader, this_player());
		reader->init_reader(board);
		reader->read_note(num);
		destruct(reader);
		return 1;
	}
}

/* Zaphoid Jul 2001 - added fixed and notabug to the wiz soul - bugs can
			now be fixed from anywhere. */
bug_fix(num)
{
	if (!num)
	{
		notify_fail("Usage: bugfix <post number>\n");
		return 0;
	}
	else
	{
		"room/wiz/bugroom"->fixed(num);
		return 1;
	}
}

bug_not(num)
{
	if (!num)
	{
		notify_fail("Usage: notabug <post number>\n");
		return 0;
	}
	else
	{
		"room/wiz/bugroom"->notabug(num);
		return 1;
	}
}

// Jenna Feb 2001 - made non-nosave
/* nosave */ read_log(arg)
{
string which, who;
array logs;
int i;

        which = query_verb();
        if (arg) who = arg;
        else who = mywiz->query_log(); /* should get directory we're working in */

        logs = [
                "typos", "TYPO",
                "ideas", "IDEA",
                "bugs", "BUGS",
                "rep", who + ".rep",
            /*  "err", who + ".err", */
                "log", who
        	];
        for (i = 0; i < sizeof(logs); i += 2) {
                if (which == logs[i])
                        return mywiz->more_file("/log/"+logs[i+1]);
        }
        return;
}

cmd_rpeople( )
{
    "RO/remote/rwho"->show_people();
    return 1;
}

list_peoples(options) {
    object list = users();
    	return list_users(list, options);	
}

list_wizards(options) {
array user = users();
array list = allocate(sizeof(user));
int count, pos;
    pos = 0;
    for (count = 0; count < sizeof(user); count ++)
	if (user[count]->query_wiz()) 
		list[pos++] = user[count];
    return list_users(list[..(pos - 1)],options);
}

list_players(options) {
array user = users();
array list = allocate(sizeof(user));
int count, pos;
    pos = 0;
    for (count = 0; count < sizeof(user); count ++)
	if (!user[count]->query_wiz()) list[pos++] = user[count];
    return list_users(list[..(pos - 1)],options);
}

set_home(str) {
string x;
	if (!str) {
		notify_fail("sethome <path to room>\n");
		return 0;
	}
	write("Checking to see if that room exists ..\n");
	x = catch str->reset(1);;
	if (x) {
		write("That room did not load :\n"+x+"\n");
		return 1;
	}
	this_player()->set_home(str);
	write("Ok, your starting home is set to "+str+"\n");
	return 1;
}

do_set_pretitle(str) {
        if (this_player() != myself) return;
	if (str) write("Pretitle set to \""+str+"\".\n");
	else write("Pretitle cleared.\n");
	this_player()->set_pretitle(str);
	return 1;
}
 
user_caution(str)
{
string Caution;
    	if (this_player() != myself) return;
	if (str == 0)
    	{ /* pop a caution */
    		Caution = this_player()->query_caution();
    		if (Caution != 0)
        	{
        		write("Removing <" + Caution + ">\n");
        		this_player()->pop_caution();
        	}
    		else
        	{
        		write("No caution to remove\n");
        		return 1;
        	}
    	}
	else
    		this_player()->push_caution(str);
	write("Caution stack: ");
	this_player()->display_cautions();
	return 1;
}

postitnote(str)
{
    string who;
    string what;
    object p;
    string msg;
    array allargs;


	notify_fail("Usage: " + query_verb() + " who <message>\n");
    if (!str) return 0;

    allargs = STRINGS->split_first(str, " ");
    if (sizeof(allargs) < 2) return 0;

    what = allargs[1];
    who = lower_case(allargs[0]);
    p = find_player(who);
    if (!p) {
	notify_fail(capitalize(who) + " not found.\n");
	return 0;
	}
    msg = capitalize(myself->query_real_name()) + " (" + ctime(time()) + "): " + what + "\n";
    p -> add_note(msg);
    if (query_ip_number(p))
       tell_object(p, "NOTE: " + msg);
    return 1;
}

wizmud() { 
    if (WHICH_MUD->is_wiz_mud())
        write("You are on the Wizard mud.\n");
    else
        write("You are on the Player mud.\n");
    return 1;
}

gag_it(str)
{
object liv, ob;
    if (this_player() != myself) return; 
    notify_fail("gag <player>\n");
    if (!str) return;
    liv = find_player(str);
    if (!liv) 
	liv = mywiz->find_item(str);
    if (intp(liv)) 
    {
        notify_fail("Can't find "+str+".\n");
        return 0;
    }
    if (arrayp(liv))
	liv = liv[0];
    if (liv->query_wiz() > myself->query_wiz()) {
        write("You are not allowed to do that!\n");
        return 1;
    }
    ob = present("shout_curse", liv);
    if (query_verb() == "gag") {
     	if (ob) {
    	    write(str + " already has a sore throat.\n");
       	    return 1;
    	}
	ob = clone_object("obj/shout_curse");
	ob->set_wiz_curse();
	ob->start(liv);
    }
    else {
    	if (!ob) {
       		write(str + " has no sore throat.\n");
        	return 1;
    	}
    	tell_object(liv, "Your throat feels better now.\n");
    	move_object(ob, environment(liv));
    	destruct(ob);
    }
    write("Done.\n");
    return 1;
}

spell_zap(arg) {
    object ob;
    if (this_player() != myself) return;
    if (!arg) ob = myself->query_attack();
    else ob = present(lower_case(arg), environment(myself));
    if (!ob) 
    {
 	ob = mywiz->find_item(arg);
	if (pointerp(ob))
	    ob = ob[0];
    }
    if ((!ob || !living(ob)) || (ob == myself)) 
    {
	notify_fail("At whom?\n");
	return 0;
    }
    ob->damage("death",1000000);
    return 1;
}

heal(name) {
object ob, it;
    notify_fail("Usage: heal <living creature>\n");
    if (!name) return 0;
    it = lower_case(name);
    ob = find_player(it);
    if (!ob) ob = find_living(it);
    if (!ob) 
    {
	ob = mywiz->find_item(it);
	if (pointerp(ob))
	    ob = ob[0];
    }
    if (!ob) {
	notify_fail("No such person/item is playing now.\n");
	return 0;
    }
    ob->heal_self(100000);
    if (myself->query_invis(0) < INVIS_ACTION)
        tell_object(ob, "You are healed by " + myself->query_name() + ".\n");
    write("Ok.\n");
    return 1;
}

