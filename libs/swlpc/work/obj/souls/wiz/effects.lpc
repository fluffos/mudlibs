 *
 */
home() {
    object old_env, pers_soul;

    if (myself->query_invis() < INVIS_TELEPORT)
        myself->remote_say((myself->query_name()) + " " 
		+ mywiz->getenv("home_message") + ".\n");
    if (myself->query_home())
    {
	/*
        move_object(myself, myself->query_home());
	*/
	myself->move_player("home",myself->query_home());
    }
    else
    {
	/*
        move_object(myself,PlayerHome(myself->query_real_name()) 
		+ "/workroom");
	*/
	myself->move_player("home",PlayerHome(myself->query_real_name())+"/workroom");
    }
    if (myself->query_invis() < INVIS_TELEPORT)
        myself->checked_say(myself->query_name() + " " +
	mywiz->getenv("t_in") + ".\n");
/*
    tell_object(myself, "You return to " + 
	environment(myself)->query_short_desc() +
	".\n");
    pers_soul = find_object("perception",myself);
    pers_soul->glance();
*/
    return 1;
}

wiz_light(str) {
int state;
    notify_fail("light { on | off } - to turn your wiz light on or off.\n");
    	if (!str || ((state = index( [ "off", "on" ], str)) < 0))
            return;
    mywiz->setenv("wiz_light", state, myself->query_real_name()[0]);
    if (state) 
	myself->add_light(10);
    else
	myself->add_light(-10);
    write("light now at "+myself->query_total_light()+"\n");
    return 1;
}

