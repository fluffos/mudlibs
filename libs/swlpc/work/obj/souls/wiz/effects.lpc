                info+"\n");
}

send_rwiz(s) {
    notify_fail("Usage: " + query_verb() + " message\n");
    if (!s)
        return 0;
    RTALK->send_rwiz(myself->query_real_name(), s + "\n");
    return 1;
}

list_servers(foo)
{
int i, pos;
array ret;
string server, label;
array servlist;
    servlist = SERVLIST->query_servers();
    ret = allocate((sizeof(servlist) / 3) + 3);
    pos = 3;
    for (i = 0; i < sizeof(servlist); i += 3)
    {
        ret[pos++] = FORMAT->left_justify(servlist[i], 20)
                + " " + FORMAT->left_justify(servlist[i+1], 20)
                + " " + servlist[i+2];
    }
    ret[1] = FORMAT->left_justify("Include File", 20) + " "
        + FORMAT->left_justify("Label", 20)
        + "Object";
    ret[2] =
        "-------------------- ------------------- ----------------------------------";
    if (stringp(foo))
    {
        /* regexp doesn't like 0s in its arrays */
        ret = M_REGEXP->match(foo, ret[1..]); 
        ret = [ "Servers matching \""+foo+"\"" ] + ret;
    }
    else
    {
        ret[0] = "Servers:";
    }
    MORE->more(ret);
    return 1;
}

do_ring() {
    write("You ring the bell loudly!\n");
    myself->checked_say(capitalize (myself-> query_name()) + 
        " rings a bell." + 
        "\n"); 
    return 1;
}

// Originally written by Paladin
// Fixed by Llati
// Tweaked by Jenna (Dec 00)
new_notes(arg) 
{
    int i,ltime;
    object board;
    array boards;
    string ret;

    boards = BOARD_SERV -> query_boards ();
    if (arg && arg != "all")
    {
	array unread_notes;
        object reader;

        if (index(boards, arg) == EINDEX) 
	{
            write ("No such board! Use \"notes all\" to list all boards.\n");
            return 1;
        }
        board = load_object (BOARD_SERV + "/" +arg);
        ltime = this_player()->query_store("brd/"+arg);
        unread_notes = board->threaded_notes(ltime, 1);
        reader = clone_object (BBOARD_NOTE_READER);
        move_object (reader,this_player());
        reader -> display (unread_notes,arg);
        return 1;
    }
    ret = "";
    for (i = 0; i < sizeof(boards); i++) 
    {
        int number;

	board = load_object (BOARD_SERV + "/" +boards[i]);
        ltime = this_player()->query_store("brd/"+boards[i]);
        unread_notes = board->threaded_notes(ltime, 0);
        number = sizeof(unread_notes);
	if (arg == "all" || number)
	{
            ret += FORMAT->left_justify(capitalize(boards[i])+":", 20) +
		   FORMAT->left_justify(
			NUMBERS_SERV->int_to_english(number, 100),
			20) + 
		   " " + ctime(ltime) + "\n";
	}
    }
    if (ret != "")
	write("Status of unread notes:\n" +
	      "Board name:\t    Unread notes:\t" +
	      " Last read on:\n" + ret);
    else
	write("There are no unread notes on any board.\n");
    return 1;
}

/* info_which added, Hunter 941214 */
int
info_which(str)
{
(int|array|object) res;
int i;
    if (!stringp(str))
    {
	notify_fail("which <objectspec>\n");
	return 0;
    }
    res = mywiz->find_item(str);
    if (intp(res))
    {
	write(str+" - no match (or equivalent to zero)\n");
	return 1;
    }
    if (!pointerp(res))
    {
	res = [ res ];	/* cast into array */
    }
    write(str+" matches:\n");
    for (i = 0; i < sizeof(res); i ++)
    {
	if (objectp( res[i] )) 
 	{
	    write( "  object: " + file_name(res[i]) );
	    if (environment(res[i]))
	        write("(in "+file_name(environment(res[i]))+")");
	    write("\n");
	}
	else if (stringp( res[i] ))
	{
	    write( "  string: \"" + res[i]+"\"\n");
	}
	else if (pointerp(res[i]))
	{
	    write( "  array: (hah! want me to print it)\n");
 	}
	else if (intp(res[i]))
	{
	    write( "  integer: " + res[i]+"\n" );
	}
    }
    return 1;
}

set_backups(str)
{
    if (str == "on")
    {
	mywiz->set_backups(1);
    }
    else if (str == "off")
    {
	mywiz->set_backups(0);
    }
    write("Backups set to "+ (mywiz->query_backups()?"on":"off")+"\n");
    return 1;
}

mftp( str )
{
array switches;
    notify_fail("Usage: mftp <Server> <file>\n");
    if (!str)
	return 0;
    switches = COMARGS->split_args(str,  [], [] );
    if ( sizeof(switches[0]) != 2)
	return 0;
    "RO/remote/mftp"->request_ftp( switches[0][0], switches[0][1] );
    return 1;
}

query_destruct()
{
    if (snooper)		/* don't leave snoopers laying around */
	destruct(snooper);
    return 0;
}

virtual_ls( str ) 
{
    object ob;
    array ret;
    array vls;
    int i;
    int c;

    notify_fail( "vls <object>\n" );
    if (!str) return 0;

    ob = mywiz->find_item(str);
    if (intp(ob)) return 0;

    vls = ob[0]->GetVirtualLS();	/* get Virtual filesystem */
    if (vls == 0)
    {
	    notify_fail( "No virtual filesystem available for "
    	+ (objectp(ob[0])?file_name(ob[0]):ob[0])+"\n");
    	return 0;
    }
    ret = allocate(1 + sizeof(vls[0]));
    ret[0] = "vls : " + (objectp(ob[0])?file_name(ob[0]):ob[0])+"/";
    i = 0; c = 1;
    for (i = 0; i < sizeof(vls[0]); i ++)
    {
	if (stringp(vls[0][i]))
	{
	    ret[c] = "  " + vls[0][i] 
		+ (vls[1][i]->GetVirtualLS()?"/":"");
	    c ++;
	}
    }
    ret = ret[..c-1];
    MORE->more(ret);
    return 1;
}

