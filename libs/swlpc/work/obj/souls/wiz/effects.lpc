dump_status()
{
    M_DISASS->dump_status();
    return 1;
}

profile(arg)
{
    int i;
    int x;
    array topfuns;

    notify_fail("profile <top number of functions>\n");
    if (!arg) return 0;
    x = atoi(arg);
    if (x == 0) return 0;

    topfuns = M_DISASS->top_functions();

    x = x * 3;
    if (x > sizeof(topfuns)) x = sizeof(topfuns);

    for (i = 0; i < x; i+=3)
    {
        write(topfuns[i+2] + ": " + topfuns[i] + "->" + topfuns[i+1] + "\n");
    }
    return 1;
}

visible(str)
{
    myself->vis(str);
    write(display_invis_level() + "\n");
    return 1;
}

invisible(str)
{
    if (!str || str == "")
    {
	write("Your current invisibility level is "+
	    myself->query_invis()+".\n");
	return 1;
    }
    myself->invis(str);
    write(display_invis_level() + "\n");
    return 1;
}

display_invis_level()
{
    return (myself->query_invis() ? "You are now at invisibility level " + 
	myself->query_invis() + "." : "You are now visible.");
}

