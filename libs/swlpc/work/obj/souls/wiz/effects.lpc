/*
 * Boring wizard stuff; effects etc in this soul.
 *  All wizards can do this stuff.
 *
 * Dredd 1992 - cut from Shattered World's wiz_soul
 * which is getting too big for it's own good.
 */

/*
 * 941114 Hunter     	changed switch uses to COMARGS-> ...
 * 941214 Hunter     	added -m switch to pow_dump()
 * 950404 Hunter     	sent output from 'people' to MORE
 * 950527 Hunter     	general cleanup
 * 950723 Hunter     	fixing up find_item() calls to match new usage
 *		     	of find_item()
 * 950816 Hunter     	added 'mftp' command
 * 950827 Hunter	added query_destruct() function - to clean up
 *			snoopers. snooper objects are also renamed when
 *			cloned.
 * 950828 Darkryln      modified pointer to /obj/souls/communication
 *                       to /obj/souls/communicate.
 * 950911 Hunter	wiz_soul now dests itself if you are not a wizard.
 * 950918 Hunter	added 'vls' command.
 * 951017 Hunter	file shifted from obj/souls/wiz_effects.c to
 *			obj/souls/wiz/effects.c
 * 960216 Belgarion	removed most array addition in the people (and
 *			similar) commands, and server listings.
 * 010220 Jenna		Moved 'err' to wiz_soul to use '/bad.log'
 * 010718 Zaphoid	Changed the 'bugs' command to use the bug list code
 *			in the bugs Bulletin Board (Jennas work)
 * 010718 Zaphoid	Removed Hunters "which" command and added new one.
 * 010719 Jenna		Moved 'in' and 'at' to wiz_soul.
 * 010725 Zaphoid	Added the fixed and notabug commands so bug reports 
 *			can be fixed from anywhere. (calls Jenna's functs.)
 * 			Also added a check to clear any cautions when first
 *			loaded.
 * 010814 Zaphoid	Fixed home() so it displays room desc and moves you
 *			nicly to your home.
 */

