show_stats()
{
array ret = ::show_stats();
    return ret + [ "mywiz    : " + DUMP->dump(mywiz, 0, 0, -1) ];
}

reset(arg)
{
    string Caution;
    ::reset(arg);
    if (!arg) 
    {
        set_soul_type("wizard", "effects");
        add_id( [ "wiz_effects", "ND", "soul" ] );
	/* clear any cautions */
	Caution = this_player()->query_caution();
	while (Caution != 0)
	{
	    this_player()->pop_caution();
	    Caution = this_player()->query_caution();
	}
    }
}

