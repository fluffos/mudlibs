force_player(str)
{
    string who, what;
    object ob;
    int flag;
    array allargs;

    if (this_player() != myself) return;
    if (myself->query_wiz() < CONTROL) return 0;

    notify_fail("Force <who> <what>?\n");
    if (!str) return 0;

    allargs = STRINGS->split_first(str, " ");
    if (sizeof(allargs) < 2) return 0;
    who = lower_case(allargs[0]);
    what = allargs[1];

	ob = find_player(who);
	if (ob) flag = 1;
	if (!ob) ob = find_living(who);
	if (!ob) ob = mywiz->find_item(who);
	if (pointerp(ob))
	    ob = ob[0];
	if (!ob) return 0;
	ob->force_us(what);
	if (flag && ob) 
		log_action("forces " + ob->query_real_name(), what);
	write("Ok.\n");
	return 1;
}

enter(str) {
    object ob;

    if (!str || this_player() != myself) return 0;
    ob = present(str,environment(myself));
    if (!ob) ob = mywiz->find_item(str);
    if (pointerp(ob))
	ob = ob[0];
    if (!ob) return 0;
    move_object(myself,ob);
    command("glance", myself);
    return 1;
}

sexit() {
    object ob;

    ob = environment(environment(myself));
    if (ob) {
        move_object(myself,ob);
        command("glance", myself);
    } 
    else write("Nowhere to exit to.\n");
    return 1;
}

pacifism_curse(str)
{
object Target;
object Curse;
	if (this_player() != myself) return;
	if (!str) return;
	notify_fail(capitalize(str) + " is not logged on.\n");
	Target = find_player(str);
	if (!Target) return;
	Curse = clone_object("players/freeze/obj/pacifism_curse");
	if (Curse) Curse->start(Target);
	return 1;
}

int
teleport(dest)
{
    object ob, old_env;
    string x; 
    int i;

    if (!dest) 
    {
        notify_fail("Teleport where?\n");
        return 0;
    }
    ob = find_player(dest);
    if (ob && mywiz->check_if_busy(ob)) 
    { /* if they are busy, warn and await confirm */
	return 1;
    }
    if (!ob) ob = find_living(dest);
    if (ob) ob = environment(ob);
    if (!ob) ob = mywiz->find_item(dest);
    if (pointerp(ob))
	ob = ob[0];
/*    if (!ob) ob = pwd + dest;  */
    if (ob) {
	myself -> move_player ("X",ob);
        return 1;
    }

    dest = mywiz->valid_read(dest);  /* only for wizzes... */

    if (!dest) 
    {
        write("Invalid monster name or file name.\n");
        return 1;
    }

/*    if (file_size(dest) < 1) dest = pwd + dest; */
    x = catch myself->move_player("X",dest);;
    if (x) write("Goto "+dest+" Error: "+x+"\n");

    return 1;
}

/* emergency goto - can go from nowhere */
teleportd(dest)
{
    object ob, old_env;
    string x; 
    int i;

    if (!dest) 
    {
        notify_fail("Teleport where?\n");
        return 0;
    }

    if (ob && mywiz->check_if_busy(ob)) 
    { /* if they are busy, warn and await confirm */
	    return 1;
    }
    ob = mywiz->find_item(dest);
    if (pointerp(ob)) ob = ob[0];

    if (ob) 
    {
	    move_object(myself, ob);
        return 1;
    }
    return 1;
}

map(str)
{
    string Item;
    int Size, MapBrief;
    object Place;
    array allargs;

    MapBrief = myself->query_store("map_brief");
    if (str && (str[..4] == "brief"))
    {
        MapBrief = atoi(str[6..]);
        write("Mapper brief mode set to " + MapBrief + "\n");
	    myself->add_store("map_brief", MapBrief);
        return 1;
    }
    
    Place = environment(myself);
    Size = 30;
    if (str)
    {
        allargs = STRINGS->split_first(str, " ");
        Item = allargs[0];
        if (sizeof(allargs) == 2)
        {
            Size = atoi(allargs[1]);
            Place = mywiz->find_item(Item);
	        if (pointerp(Place)) Place = Place[0];
        }
        else
        {
            if (index("0123456789", str[..1][0]) >= 0)
            {
                    Size = atoi(str);
            }
            else
	        {
                Place = mywiz->find_item(str);
	            if (pointerp(Place)) Place = Place[0];
	        }
        }
    }

    if (!Place) return 0;
    
    "players/billy/etc/mapper"->map(Place, Size, MapBrief);
    return 1;
}


/* dot commands added by Billy */
dot_help()
{
write("Dot commands:\n" + 
"(\".\" can be used as an abbreviation for \"dot \")\n\n" +
"dot <object>             - place your dot on an object, for instance:\n" +
"dot env                  - place the dot at your environment\n" +
"dot                      - tell you where the dot is\n" +
"dot <direction>          - move your dot in a dest_dir direction\n" +
"dot <command>            - execute the command at the dot\n" +
"dot l                    - look at the surrounds of the dot\n" +
"dot listen to            - listen to sounds inside the dot\n" +
"dot listen at            - listen at the environment of your dot\n" +
"dot listen               - does \"listen to\" for rooms or \"listen at\" otherwise\n" +
"dot quiet                - don't listen at the dot\n" +
"dot help                 - this message\n\n" +
"Also using \".\" in other commands is valid: eg.\n" +
"    call . query_short\n");
}

dot_cmd(str)
{
int Which;
object NewDot;
object OldEnv;
array TranslateFrom;
array TranslateTo;
int Size;
int NewBrief;

    if (this_player() != myself) return;
    TranslateFrom = DIRECTION->query_abbreviated();
    TranslateTo = DIRECTION->query_standard();

    /* kick any snooper into its right position */
    if (snooper) snooper->follow();
    
    /* dot location report */
    if (!str || sizeof(str) == 0)
    { /* say where we are */
    if (dot)
        write("Dot is at: " + file_name(dot) + "\n");
    else
        write("Dot is in limbo.\n");
    return 1;
    }

/* help */
if (str == "help" || str == "?")
    { /* give help */
    dot_help();
    return 1;
    }

/* listening */
if (str[0..5] == "listen")
    {
    if (dot)
        {
        if (str == "listen" || str == "listen to" || str == "listen at")
            { /* a command for us */
            if (snooper)
                { /* already there! */
                notify_fail("You are already listening " + 
                                            snooper->query_status() + ".\n");
                return 0;
                }
            if (str == "listen")
                { /* listen either to or at depending on whether it is a room */
                if (environment(dot) == 0)
                    str = "listen to";
                else
                    str = "listen at";
                }
            if (str == "listen to")
                { /* listen inside the dot object */
                snooper = clone_object("closed/snooper", "snooper");
                if (snooper)
                    {
                    move_object(snooper, dot); /* this will tell wizzes */
                    snooper->set_listener(this_player());
                    snooper->set_subject(dot, 0, 0);
                    write("Now listening to " + file_name(dot) + ".\n");
                    }
	        return 1;
                }
            else 
                { /* listen at the dot object's environment */
                snooper = clone_object("closed/snooper");
                if (snooper)
                    {
                    /* tell higher-level wizzes */
                    if (dot->wiz_level() >= wiz_level)
                        tell_object(dot, myself->query_name() +
                                 " has put a snoop on you.\n");
                    
                    /* put the snooper there */
                    move_object(snooper, environment(dot));
                    snooper->set_listener(this_player());
                                                        /* follow if living */
                    snooper->set_subject(dot, 1, living(dot));
                    write("Now listening at " + file_name(dot) + ".\n");
                    }
	        return 1;
                }
            }
        }
    }

if (str == "quiet")
    { /* get rid of the snooper */
    if (!snooper)
        {
        notify_fail("You weren't listening!\n");
        return 0;
        }
    destruct(snooper);
    snooper = 0;
    write("Listening turned off.\n");
    return 1;
    }

/* look */
if (str == "l")
    {
    object AtObj;
    object InObj;
    int Count;
    array Contents;
    string Cont;
    for (AtObj = dot; AtObj != 0; AtObj = environment(AtObj))
        {
        write("********** " + file_name(AtObj) + 
                                            " **********\n");
        if (AtObj->query_room())
            write(AtObj->query_look());
        else
            {
            AtObj->long();
            Contents = contents(AtObj);
            for (Count = 0; Count < sizeof(Contents); Count++)
                Contents[Count] = Contents[Count]->short();
            Cont = implode(Contents, ", ");
            if (Cont)
                write("Contains: " + Cont + ".\n");
            write("\n");
            }
        }
    return 1;
    }

/* try a destination direction */
if (dot)
    {
    array DestDir;
    int Trans;
    /* try to translate to a direction */
    Trans = index(TranslateFrom, str);
    if (Trans != EINDEX)
        str = TranslateTo[Trans];
        
    /* see if str is in the dest_dir first */
    DestDir = dot->query_dest_dir();
    if (DestDir)
        {
        Which = index(DestDir, str);
        if (Which % 2 == 1)
            { /* make sure it's matching a direction */
            (DestDir[Which-1])->stupid_fucking_loadup_function();
            NewDot = find_object(DestDir[Which-1]);
            if (NewDot)
                { /* update the dot */
                dot = NewDot;
                write("New dot: " + file_name(dot) + ".\n");
                if (snooper)
                    snooper->change_subject(dot);
                return 1;
                }
            }
        }
    }

/* wasn't a direction so try find_item */
    NewDot = mywiz->find_item(str);
    if (pointerp(NewDot))
    { /* new dot */
        dot = NewDot[0];
        write("New dot: " + file_name(dot) + ".\n");
        if (snooper)
            snooper->change_subject(dot);
        return 1;
    }

/* wasn't anything else so do a command at the dot */
write("At " + file_name(dot) + ":\n");
OldEnv = environment(myself);
move_object(myself, dot);
command(str, myself);
move_object(myself, OldEnv);
return 1;
}

query_dot() { return dot; }

/* array addition in here probably should be fixed up... */
pow_dump(str) 
{
/* switches allowed:
 * -l	living()
 * -o	object filename
 * -c	creator()
 * -u	suid name and level
 * -v	value
 * -w	weight
 * -s	short desc
 * -i	id's
 * -d "<default switches>"
 * -m <id>  display objects that id to
 */
    array switches;
    array checkwho;
    object who;
    array gear;
    int i, j;
    string defaults;
    int short_width, id_width; 	
    array ret = [ ];
    string line = "";
	if (!str) str = "";
	defaults = mywiz->getenv("I!_DEFAULTS");
	if (!stringp(defaults))
		defaults = " -o -s";
	if (index(str,"-d") < 0)
		str = str + " "+defaults;	/* add defaults */
	switches = COMARGS->split_args(str,
		[ "l","o","c","u","v", "w", "s", "i" ],
		[ "d", "S", "I", "m" ]
		);
	if (stringp(switches[2][0]))		/* setting defaults */
	{
		mywiz->setenv("I!_DEFAULTS",switches[2][0]);
		write("Setting i! defaults to \""+switches[2][0]+"\"\n");
		return 1;
	}	
	if (stringp(switches[2][1])) 
	{	
		short_width = atoi(switches[2][1]);
	}
	else
	{
		short_width = 20;
	}
	if (stringp(switches[2][2])) 
	{	
		id_width = atoi(switches[2][2]);
	}
	else
	{
		id_width = 20;
	}
	if (sizeof(switches[0]) == 0)
	{
		checkwho = [this_player()];
	}
	else
	{
	    checkwho = [];
	    for (i = 0; i < sizeof(switches[0]); i ++)
	    {
		who = mywiz->find_item(switches[0][i]);
		if (intp(who))
		    ret+=[ "Could not find "+switches[0][i] ];
		else if (pointerp(who))
		    checkwho += who;
		else 
		    checkwho += [ who ];
	    }
	}
    for (j = 0; j < sizeof(checkwho); j ++)
    {
	who = checkwho[j];
	ret += [ "Inventory for "+who ];
	gear = contents(who);

    // hack for now to get souls.
    array gls;
    gls = who->GetAliasedLS(0);
    if (gls) gear += gls[1];

/*	write(" # GD"); */
	line = " # "; 

			/* print out the header, depending on switches */
	line += switches_row(switches[1], [
		"L", 2,
		"Object",30,
		"Creator",12,
		"Suid",12,
		"Value",6,
		"Wght",5,
		"Short", short_width+1,
		"Id's", id_width+1
		] ) ;
	ret += [ line ];
	if (sizeof(gear) == 0)
	{
	    ret += [ "nothing in inventory" ];
   	}
	else for (i = 0; i < sizeof(gear); i = i + 1)
	{
	    string tmp = FORMAT->right_justify((i+1) +":", 3);
#if 0
		/* annoying because it effects the items! -- Dredd */
		/* hence gear[i] can become 0 - people aren't wielding etc */
		tmp = tmp + (gear[i]->get()?"G":" ");
		tmp = tmp + (gear[i]->drop()?" ":"D");
#endif
		if (switches[1][0])
			tmp = tmp + (living(gear[i])?"L":" ");
		tmp = tmp + " ";
		if (switches[1][1])
		{
	 	    string t2;
			t2 = file_name(gear[i]);
			if (t2[0..7] == "players/")
				t2 = "~"+t2[8..];
			tmp += FORMAT->left_justify(t2, 30);
		}
		if (switches[1][2])
			tmp += FORMAT->left_justify(query_su_name(
				gear[i]), 12);
		if (switches[1][3])
		{
		    string s = query_su_name(gear[i]);
			tmp += FORMAT->left_justify(
				(stringp(s)?(s+"("):"<none>(")+	/* constant-fold bug if "(" is outside */
				query_su_level(gear[i])+")", 12);
		}
		if (switches[1][4])
		{
			tmp += FORMAT->right_justify(
				""+gear[i]->query_value(), 5)+" ";
		}
		if (switches[1][5])
		{ 
			tmp += FORMAT->right_justify(
				""+gear[i]->query_weight(), 4)+" ";
		}
		if (switches[1][6])
		{
		    string shrt;
			catch shrt = gear[i]->short();; 
			if (!shrt)
				shrt = "<no short>";
			if (sizeof(shrt) > short_width)
				shrt = shrt[..short_width-3]+"..";
			tmp += FORMAT->left_justify(shrt, short_width)+" ";
		}
		if (switches[1][7])
		{
		    string ids;
			catch ids = gear[i]->query_ids();;
			if (!ids)
				ids = "<no Id's>";
			else	
				ids = implode(ids,",");
			if (sizeof(ids) > id_width)
				ids = ids[..id_width-3]+"..";
			tmp += FORMAT->left_justify(ids, id_width);
		}
		if ( stringp(switches[2][3]) && !gear[i]->id(switches[2][3]))
		{
		    /* do nothing */
		}
		else
		{
		    ret += [ tmp ];
		}
	}
    }
    MORE->more(ret);
    return 1;	
}

power_trans(str) { 
    return trans("! "+str); 
}

trans(arg)
{
    string str, dest;
    object ob, where_from, to;
    string out, sh;
    array allargs;

    notify_fail("trans <who> [<where>]\n");
    if (!arg) return 0;

    allargs = STRINGS->split_first(arg, " ");
    if (allargs && allargs[1]) 
    {
        str = allargs[0];
        dest = allargs[1];
    }
    else
    { 
        str = arg;
        /* dest = "@"+myself->query_real_name();  */
    }

    ob = find_player(str);
    if (ob && mywiz->check_if_busy(ob))
        return 1;
    if (!ob) ob = find_living(str);
    if (!ob) 
	ob = mywiz->find_item(str);
    if (pointerp(ob))
	ob = ob[0];
    if (!ob) {
        notify_fail("Unable to find "+str+".\n");
        return 0;
    }
    where_from = environment(ob);
        sh = ob->query_name();
        if (!sh) sh = ob->short();
        if (!sh) sh = "Something";
    out = ob->query_store("t_in");
    if (!out)
        out = sh + " arrives in a puff of smoke.\n";
    else
        out = sh + " " + out + ".\n";
    if (dest)
        to = mywiz->find_item(dest);
    if (pointerp(to)) to = to[0];

    if (to) 
    {
        tell_room(to, out);
        move_object(ob, to);
    } 
    else 
    {
        tell_room(environment(myself),out);
        move_object(ob, environment(myself));
    }
    out = ob->query_store("t_out");
    if (!out)
        out = sh + " dissappears in a puff of smoke.\n";
    else
        out = sh + " " + out + ".\n";
    if (where_from) tell_room(where_from, out);
    tell_object(ob, "\nYou are magically transfered somewhere...\n\n");
    log_action("transes", ob->query_real_name() );
    command("glance", ob);
    return 1;
}

power_get(str) {
object handle;
    handle = myself->query_soul("generic/handle");
    return handle->pick_up(str);
}
power_divest(str) {
object handle;
    handle = myself->query_soul("generic/handle");
    return handle->divest(str);
}

whereis(str) {
    object ob;
    if (!str)
        return 0;
    ob = find_player(str);
    if (!ob) ob = find_living(str);
    if (!ob) ob = find_object(str);
    if (!ob) ob = mywiz->find_item(str);
    if (pointerp(ob))
	ob = ob[0];
    if (!ob) {
        write(str + " not found.\n");
        return 1;
    }
    ob = environment(ob);
    if (!ob) {
        write(str + " is not in a place.\n");
        return 1;
    }
    write(ob);
    write("\n"+ob->short()+".\n");
    return 1;
}

