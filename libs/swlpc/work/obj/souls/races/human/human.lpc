inherit "obj/souls/races/race_soul";

reset(arg)
{
	::reset(arg);
	if (!arg) {
		add_id("race_soul");
		set_soul_type("race", "human");
		}
}

init()
{
	::init();
	if (myself == this_player()) {
	  	add_action("com", "missile", 2);
  		add_action("com", "fireball", 2);
  		add_action("com", "shock", 2);
		add_action("human_help","help");
	}
}

human_help (arg) {
	if (arg == "powers" || arg == "missile" || arg == "shock" ||
		arg == "fireball" || arg == "human powers" ||
		arg == "race powers") 
	{
"obj/souls/races/show_powers"->show_powers("obj/souls/races/human/human_help");
#if 0
	"std/more" -> more (grab_file ("obj/souls/races/human/human_help",0));
#endif
	return 1;
	}
	return 0;
}

com(str) {
string sp, cb;
object pob, aob;
int time;
	sp = query_verb();
	pob = myself;
	if (sp[0] == 'm') {
		notify_fail("Missile who?\n");
		cb = "guilds/adv_guild/spells.missile";
		time = 0;
	}
	else if (sp[0] == 's') {
		notify_fail("Shock who?\n");
		cb = "guilds/adv_guild/spells.shock";
		time = 1;
	}
	else if (sp[0] == 'f') {
		notify_fail("Fireball who?\n");
		cb = "guilds/adv_guild/spells.fireball";
		time = 2;
	}
	else return 0;
	if (!str) aob = pob->query_attack();
	else if (!aob && str) aob = present(str, environment(pob));	
	notify_fail(capitalize(sp)+" who?\n");
	if (!aob) return 0;
	if (!living(aob)) return 0;
	aob->attacked_by(this_object());
	pob->attacked_by(aob);
	pob->add_spell(time, cb);	
	return 1;
}

start_character () {
object me;
	me = environment (this_object());
	me -> add_skill ("missile",me -> query_int() *2 );
	me -> add_skill ("shock",me -> query_int());
	me -> add_skill ("fireball",4);
	return 1;
}

fix_body()
{
    myself->set_body(MONSTERER->test("human"));
    return 1;
}
