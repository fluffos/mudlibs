inherit "obj/souls/base_soul";

#define SAVE_INTERVAL 2400
#define MAX_QUIET_TIME 300
#define IDLE_TIME 180

reset(arg)
{
    ::reset(arg);
    if (!arg) {
    add_id("state_soul", "worn_clothing");
    set_soul_type("generic", "state");
    }
}

init()
{
    ::init();
    if (myself != this_player()) return;
    add_action("save_character", "save");
    add_action("terminal", "terminal");
    if (myself->is_player()) start_call_outs();
}

terminal(str)
{
    notify_fail("terminal <term-type>.\n");
    if (!str) return 0;

    this_object()->add_store("term", str);
    write("Terminal type set to " + str + "\n");
    return 1;
}

save_character(str)
{
    notify_fail("Save what?\n");
    if (str) return 0;

    myself->save_character();
    write("Ok.\n");
    return 1;
}

/*
 * Patches to destruct sleepers.  If called twice while player is non-
 * interactive, it will destroy the player and inventory.  Called every
 * MAX_QUIET_TIME seconds, currently 5 mins, so a player gets 5-10
 * mins of grace after a disconnect.  Hacked to also check login times
 * and warn the user of his impending demise.  Further hacked to implode
 * them if they are idle for too long.
 *
 * Players do NOT get reimbursed for their inventory - too easy to make
 * too much money...
 *
 * Gandalf's patch.
 * Dredd's repatch to state.c :-)
 */

int telltime;
 
sleeper_check(arg) 
{
    object o;

    int is_interactive = query_ip_number(myself);
    int time_ok = 1; /* still in hours - let reboot do the work */
 
    if (!myself || myself->query_wiz()) return;

    if (is_interactive)
    {
        if (myself->query_idle() > MAX_QUIET_TIME*2) 
        {
            /* quick hack - force a destruct */
            is_interactive = 0;
            arg = 1;
        }
#if 0
        else if (myself->query_idle() > IDLE_TIME)
        {
            myself->push_caution("idle");
        }
        else
        {
            if (myself->query_caution() == "idle") myself->pop_caution();
        }
#endif
        if (time_ok) 
        {
            call_out("sleeper_check", MAX_QUIET_TIME, 0);
            return 1;
        }


        if (!arg) 
        {
            tell_object(myself, "You had better get to the shop!!!\n" +
                 "The MUD is closing soon!\n");
                       telltime = MAX_QUIET_TIME / 60 + 1;
                       call_out("sleeper_check", 60, 1);
                       return 1;
        }
        else 
        {
            if (telltime <= 0) 
            {
                write("Your time is up - see you later.\n");
                myself->log_enter("(thrown off)");
                dest_player();
                return(1);
            }
            else 
            {
                telltime = telltime - 1;
                write("You have " + telltime +
                    " minutes to sell your stuff and quit!!!!\n");
                call_out("sleeper_check", 60, 1);
                return(1);
            }
        }
    }

    if (!arg) 
    {
        call_out("sleeper_check", MAX_QUIET_TIME, 1);
        return 1;
    }

    /* non interactive twice in a row - self destruct */
    o = environment(myself);
    if (o) tell_room(o, myself->short() + " implodes from sheer boredom.\n" +
                                  "Nothing remains.\n");
    myself->log_enter("(implodes)");
    dest_player();
}


