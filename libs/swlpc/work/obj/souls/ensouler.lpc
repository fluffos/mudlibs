/*
 * Ensouler object - ensouls the specified object with souls
 * Hunter, 6/4/93
 */

#include <Servers.h>

array souls = ({ "combat.lpc", "communicate.lpc", "emote.lpc",
	"handle.lpc", "perception.lpc", "state.lpc", "support.lpc" });

reset() {}

ensoul(object who)
{
    int i;
    object newsoul;
	write("Starting to ensoul "); DUMP->dump(who);
	for (i = 0; i < sizeof(souls); i ++)
	{
		newsoul = clone_object("obj/souls/"+souls[i]);
		newsoul->override_myself(who);
		move_object(newsoul, who);
	}
    	return 1;
}

