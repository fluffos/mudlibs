/*
	A generic potion for modifying skills/stats.
	Clone this before making your own if possible.
	A message maybe added (see std/object.c). -- Dredd's Dreadful Potions.
*/

inherit "std/object";

string color = "colorless";	/* Color of liquid inside */
string type = "str";		/* Stat to be added to */
string long_type = "Strength";	/* Stat on the label */
int amount = 1;			/* How much gets added on */
int duration = 10;		/* How long it lasts for */

reset(arg) { 
	::reset(arg);
	if (arg) return; 
	set_id([ color +" potion", "potion", "vial" ]);
	add_property ("magic");
	set_short("small "+color+" potion");
	set_long("A small glass vial containing a "+color+" fluid.\n"+
	 "It has a small inscription written on the side of it.\n");
	set_value(600);
	set_read("A Product of Dredd's Legal Liquor's.\n");
	}

query_id() { return "Potion of "+long_type; }

init() {
	::init();
	add_action("drink", "drink", 0);
	add_action("drink", "quaff", 0);
	add_action("_throw", "throw", 0);
}	

gone() {
	    move_object (this_object(), "RO/storage");
	    destruct (this_object());
}

drink(str) {
	if (!id(str)) return 0;
	if (!type) return 0; /* sensibility check */
	if (duration < 1) duration = 1;

	this_player()->add_stat(type, amount, duration);
	write("You quaff down the "+short()+".\n");
	write("You feel your "+long_type+" magically increase!\n"); 
	write("The vial evaporates after use!\n");
	this_player()->checked_say(capitalize(this_player()->query_name()) + 
	    " quaffs down a "+short()+".\n", this_player());	
	gone();
	return 1;
}

_throw(str) 
{
    string pot, who;
    object ob;
    array allargs;

    if (!str) return 0;
    allargs = STRINGS->split_first(str, " at ");
    if (sizeof(allargs) != 2) return 0;

    pot = allargs[0];
    who = allargs[1];

	if (!id(pot)) return 0;
	if (!type) return 0;
	if (!who || !(ob = present(who, environment(this_player()))))
 	{	/* randomly smash it on the ground */
  	    write("You throw the "+pot+" and it crashes into splinters on the ground nearby.\n");
	    say(capitalize(this_player()->query_name()) + " throws a small vial and it smashes into splinters on the ground nearby.\n", this_player());
	    gone();
	    return 1;
	}
	else if (find_living(who)) { 	/* at someone */
	     write("You throw the "+pot+" at "+capitalize(who)+".\n");
	     say(capitalize(this_player()->query_name()) + " throws a small vial at "+capitalize(who)+".\n", ob); 
	     tell_object(ob, capitalize(this_player()->query_name()) + " throws a small vial at you!\nIt crashes over you and evaporates on you!\n");
	    if (duration < 2) duration = 2;
	    ob->add_stat(type, amount/2, duration/2);
	    gone();	
	    return 1;
	}
	else { /* at something */
	     write("You throw the "+pot+" at "+capitalize(who)+".\n");
	     say(capitalize(this_player()->query_name()) + " throws a small vial at "+capitalize(who)+".\n", this_player()); 
	    tell_room(this_player(),"It crashes into thousands of pieces!\n");	
	    gone();
	    return 1;		
	}
        return 0;
}
set_type(tm) {
array types = [ "red", "Strength", "str",
		 "orange", "Constitution", "con",
		 /* What use is a sanity potion ? */
		 "yellow", "Size", "siz",
		 "green", "Dexterity", "dex",
		 "blue", "Power", "pow",
		 "indigo", "Intelligence", "int",
		 "violet", "Chutzpah", "chu"
		];
int where;
	if (tm) where = index(types, tm); 
	if (where < 1) where = random(sizeof(types)/3)*3+2;
	type = types[where];
	long_type = types[where-1];
	color = types[where-2];
	reset();
	return 1;}

set_strength(tm) { amount = tm;}
set_duration(tm) { duration = tm; }

show_stats() 
{
	::show_stats();
	write ("Type\t: "+type+"\tStrength: "+amount+"\tDuration: "+duration+"\n");
}
