#include <Config.h>

legal_status(string name)
{
int age;
string gender, objective;
object o;
 o = load_object(PLAYER_SERV->GetPlayerObjName(name));
 if (!o) return "No such player as "+capitalize(name)+".\n";
 age = o->query_age();
 gender = o->query_gender();
	if (gender == "male")
		objective = "him";
	else
		objective = "her";
	if (age < 3600*4)
		return capitalize(name)+" is a minor.  Give "+objective+" a spanking.\n";
	return 0;
}
