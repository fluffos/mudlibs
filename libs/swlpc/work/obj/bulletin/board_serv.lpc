/*
 *
 * Bulletin board virtual object manager. It keeps track of all
 * the boards and allows objects to use the find_object() efun.
 *
 * Also allows for 'special' boards to be used, in the case where they
 * needed to be modified to deal with a special situation. All of the
 * recognised boards are in the all_boards array.
 *
 * Perhaps one day I will modify this to use the data file stuff...
 *
 * To add a new board:
 *     a) add it to the all_boards array in this file
 *     b) add the code to the board room:
 *                #include <board.h>
 *                  ......
 *                board = load_board (BOARD_SERV + "/" + the_board_name );
 *                transfer (board,this_object());
 *
 * 941114 Llati
 * 951012 Qarath : Added 2 boards, healer and druid.
 */

#include <board.h>

inherit "RO/virtual";

   /* all_boards format: [ "board_name", (0|board_path), ...]  
    * the board path is an optional field which will load the specified
    *    board instead of the default one. It is assumed that this file will
    *    inherit the standard one 
    */
array all_boards =  [
   "SW_code_board",0,
   "SW_wizard_board",0,
   "advertiser",0,
   "berserkers",0,	
   "bountyboard","players/dredd/law/bounty_board",
   "bug_typo",0,
   "camarilla","players/rattcherryh/vampire/cemetary/new_bulletin",
   "change",0,
   "idea",0,
   "knight","guilds/kguild/board",
   "law_discussion",0,
   "lordboard",0,
   "masquerade_bb","players/rattcherryh/vampire/cemetary/new_bulletin",
   "merenth",0,
   "player_board",0,
   "siren",0,
   "healer",0,
   "druid",0,
   "magick", 0,
   "thieves", 0,
   "GL", 0,
   "world", 0,
   "mages", 0
   ];

   
/* Setup the virtual object controller */
reset (arg) {
int i;

	if (arg) return;
	for (i = 0; i < sizeof (all_boards);i+=2) {
		name_virtual_object (all_boards[i],"make_board");
		}
}	

object make_board (string b_name,int not_used) {
object brd;
int i;

	i = index (all_boards,b_name);
	if (all_boards[i+1]) {
		brd = clone_object (all_boards[i+1]);
		}
	 else {
	  brd = clone_object (BBOARD);
	  }
	brd -> set_board_name (b_name);
	return brd;
}

array query_boards () {
int i;
array brds = [ ];
	for (i = 0; i < sizeof (all_boards) ; i+= 2) {
		brds += [ all_boards[i] ];
		}
	return brds;
}
