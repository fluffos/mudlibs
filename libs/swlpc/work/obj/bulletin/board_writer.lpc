
 /*
  * Shattered World bulletin board editor.
  *
  * Its task is to add and edit notes. For more info read the main 
  * bulletin board code.
  *
  */

#include <board.h>

inherit "std/txted";
inherit "std/object";

import BBOARD_CLASS c_board;

object bboard;
class c_board note;
int in_edit = 0;
object callb;

reset(second)
{
  :: reset (second);
  add_id ( [ "board_editor" ] );
  add_id("inhibit_insanity");
  add_property ("NO_GET");
}

start_new_note (object bb, class c_board nnote, callbo)
{
    bboard = bb;
    note = nnote;
    callb = callbo;
    this_player() -> push_caution ("writing a note");
    get_message();
}

start_followup (object bb, class c_board nnote)
{
    bboard = bb;
    note = nnote;
    write ("Subject: (" +note.title + ") ");
    this_player() -> push_caution ("writing a note");
    input_to ("get_title");
}

get_title (arg) 
{

	if (arg && sizeof(arg)) note.title = arg;
	get_message();
}

start_edit  (object bb, class c_board to_edit)
{
    bboard = bb;
    note = to_edit;
    in_edit = 1;
    this_player() -> push_caution ("editing a note");
    edit_file (note.body);
}

aborted_msg() {
   write ("You stop writing your note and discard it.\n");
   this_player() -> pop_caution ();
   destruct (this_object());
}

finished_msg (string msg) 
{
   this_player() -> pop_caution ();
   if (in_edit) bboard -> remove_note (note.date);
   note.body = msg;
   write ("You finish your note and add it to the board.\n");
   bboard -> add_local_note (note);
   if (callb) callb->note_done(note);
   destruct (this_object());
}
