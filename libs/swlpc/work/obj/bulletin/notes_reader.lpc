
 /* 
  * Shattered Worlds stripped back notes reader.
  *    used by the wiz command 'notes' to provide a 
  *    nice interface. To some extent it duplicates the
  *    code in the board_reader, and changes here will probably
  *    need to be made there as well.
  *
  */
  
#include <Servers.h>

inherit "std/object";

array notes_to_read =[];
int started_reading;
string board_name;

reset(second)
{
  if (!second) {
		add_id ( "board_reader" );
		add_property ("NO_GET");
  }
}


set_last_read (int timestamp) {
    this_player()->add_store("brd/" + board_name,timestamp);
}    

display(array notes, string brd) {
  board_name = brd;
  started_reading = time();
  notes_to_read = notes;
  this_player()->push_caution("reading notes");
  next_note ();
  return 1;
}

grab_input () { 
	write ("> "); 
	input_to ("next_note"); 
}

next_note (arg) {
string tmp;

  if (arg && sizeof (arg)) {
    notes_to_read = [ ];
	  this_player() -> pop_caution ();
	  command (arg,this_player());
	  destruct (this_object());
	  return 0;
	  }
	if (!sizeof (notes_to_read) ) {
	  write ("Finished.\n");
	  this_player() -> pop_caution ();
	  set_last_read (started_reading);
	  destruct (this_object());
	  return 1;
	  }  
  tmp = notes_to_read[0];
  notes_to_read = notes_to_read [1..];  
	"std/more" -> more (tmp,"grab_input");
}	  
