/*
 * Use lib/dump; I'm not fixing this one as well - G
 */

#if 0

reset() {}

/* quick hack to return it as a string.  Inefficient - don't use this (except
 * for testing)
 */

dump(arg, tab, inhibit) /* dump to this_player the contents of the variable 'arg' */
{
	string o = "";

	if (!inhibit)
		o += indent(tab);
	if (intp(arg))
	{
	    string Out;
		Out = arg+"";
		Out = "           "[sizeof(Out)..]+Out;    
		o += ("integer : "+Out+"\t0x"+"lib/hex"->int2hex(arg)+"\n");
	}
	else if (realp(arg))
	{
		o += ("real    : "+arg+"\n");
	}
	else if (stringp(arg))
	{
		arg = "lib/strings"->string_replace(arg, "\"", "\\\"");
		arg = "lib/strings"->string_replace(arg, "\n", "\\n\n");
		o += ("string  : \""+arg+"\"\n");
		if ("lib/bitstr"->is_bitstr(arg))
		{
			o += (tab);
			o += ("(bitstr)? "+"lib/range"->bitstr2range(arg,0)+"\n");
		}
	}
	else if (objectp(arg))
	{
	    string shrt;
		catch shrt = arg->short();;
		o += ("object  : <"+file_name(arg)+"> "+
		(stringp(shrt)?"\""+shrt+"\"":"") +"\n");
	}
	else if (pointerp(arg))
	{
	    int i;
	    array a = allocate(sizeof(arg));
		for (i = sizeof(arg) - 1; i >= 0; i --)
		{
			a[i] = (tab + 2) + ("["+i+"] ") + dump(arg[i], tab + 2, 1);	
		}
		o += ("array of size "+sizeof(arg)+" : {\n") + implode(a, "")
		 + indent(tab)
		 + ("}\n");
	}
	else
		o += ("Unknown data type.\n");
    return(o);
}

nosave indent(tab)
{
	return("                                            "[..tab-1]);
}

#endif
