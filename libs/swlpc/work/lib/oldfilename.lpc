array Wizards;

#include "Servers.h"

reset(arg)
{
array temp;
int i;
	if (!arg)
	{
	/* work out the list of wizards */
		Wizards = [ ];	
		temp = "std/wiz_list"->query_wiz_list();
		for (i = 0; i < sizeof(temp); i ++)		
			if (stringp(temp[i]))
				Wizards += [ capitalize(temp[i]) ];
	}
}

query_wizards() { return Wizards; }

string
find_wizard(string wiz)
{
int i;
	if (capitalize(wiz) != wiz)
		return wiz;
	i = 0;
	while (i  < sizeof(Wizards) )
	{
		if (wiz == Wizards[i][..sizeof(wiz)-1])
			return (lower_case(Wizards[i]));
		i ++;
	}
	return wiz;
}

/* add cwd, strip leading and trailing '/' off names */

string
normalise_filename(str,string home,string pwd) {
    string file;

    if (!str)
        str = "";
    if (str[0] != '/' && str[0] != '~')
        str = pwd + str;
    if (str[0] == '~') {
        if (str == "~" || str[1] == '/')
            str = home + str[1..];
        else
            str = "/players/" + str[1..];
    }
/* hook in the wizard name completion here */
    str = compute_path(str,home,pwd);
    while (str[0] == '/') str = str[1..];
    while (str[strlen(str) - 1] == '/') str = str[..strlen(str) -2];
    return str;
}
/* L: Oct 92
	Fiddled things a bit, cos it was causing errors.
	Also removed a variable, by making stack dynamic
 */

string compute_path(string str, string home, string pwd)
{
    array exploded, stack;
    int i = 0;

    str = "lib/strings"->strip_whitespace(str);
/*
    if (str[..0] != "/" && str[sizeof(str)-1..] != "/") 
	str = pwd + str;
*/
    exploded = explode(str, "/");
    if (!pointerp(exploded)) 
	return "/";
    stack = [ ];
    while (i < sizeof(exploded))
    {
	if (exploded[i] == ".." && sizeof(stack) > 0)  
	{
		stack = stack[..sizeof(stack)-2];
	}
	else if (exploded[i] == "~")
	{
		stack = [home];
	}
	else if (exploded[i][..0] == "~")
	{
		stack = ["players", find_wizard(exploded[i][1..]) ] ;
	}
	else if (exploded[i] != ".")
	{
		stack += [ exploded[i] ];
	}
	i = i + 1;
    }
    if (!sizeof(stack)) 
	return "/"; 
    return "/"+implode(stack, "/");
}

string contract(string filename)
{
	if (filename[0..7] == "players/")
		return "~"+filename[8..];
	return filename;
}
