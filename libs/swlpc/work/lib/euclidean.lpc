/*
 * don't use recursion unless necessary - G.
 *
 * This belongs in lib/imath!  In fact, I've put a copy in there - G.
 */

int gcd(int A, int B) {

	int Larger, Smaller, Remainder;

	if (A < 1 || B < 1)
		return 0;	/* will never otherwise be 0 */

	if (A > B) {
		Larger = A;
		Smaller = B;
	}
	else {
		Larger = B;
		Smaller = A;
	}

	while (1) {
	    Remainder = Larger % Smaller;	/* remainder < smaller */
	    if (!Remainder)
		return Smaller;
	    Larger = Smaller;
	    Smaller = Remainder;
	    /* return(gcd(Smaller, Remainder)); - G */
	    }
}

