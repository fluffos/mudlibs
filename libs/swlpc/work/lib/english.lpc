/*
 * English Library
 * Shattered Worlds Mudlib
 *
 * Various English-language generation routines, including things like
 *  - integer to english converters
 *  - fraction to english converters
 */

/* 
 * 951117 Hunter	added real_fraction_to_english()
 */

/*
 * Fixed so that if intel < 0 then intel check is not used.
 * So that the fuck up with negative numbers no longer occurs.
 * Rattcherryh.  06th October 1992
 */

string
int_to_english(int num,int intel) 
{
array ret;
int temp;
string last;
string res;
int neg, max;
	ret = [ ];
	/* no intelligence checks yet */
	if (!num) 
		return "zero";	
	if (intel >= 0) {
		max = intel*intel*intel;
		if (max < intel) /* overflow if stupid wiz has ridiculous int */
			max = intel;
		if (num > max*10)
		{
		    if (intel < 6)
			return "many";
		    else if (num > 1000000)
			return "millions of";
		    else if (num > 1000)
		    	return "thousands of";
		    else if (num > 100)
		    	return "hundreds of";
		}
		if (num > max)	/* fudge the result */
			num = max + ((num - max)*(75 + random(50))/100);
	}
	neg = (num < 0);
	num = neg?-num:num;
	if (num >= 1000000)
	{
		ret += [ int_to_english(num/1000000, intel)+" million"];
		num = num % 1000000;	
	}			
	if (num >= 1000)
	{
		ret += [ int_to_english(num/1000, intel)+" thousand"];
		num = num % 1000;
	}
	if (num >= 100)
	{
		ret += [ int_to_english(num/100, intel)+" hundred"];
		num = num % 100;
	}
	last = "";
	if (num >= 20)
	{
		temp = num / 10;
		last = ["ten", "twenty", "thirty", "forty","fifty",
			"sixty", "seventy","eighty", "ninety" ][temp-1] ;
		num = num % 10; 	
	}
	if (num)
	{
		last += (temp?" ":"")+
			[ "one", "two", "three", "four", "five", "six",
				"seven","eight","nine", "ten",
			"eleven","twelve","thirteen","fourteen","fifteen",
			"sixteen","seventeen","eighteen","nineteen"][num-1];
	}
	res = sizeof(ret)?implode(ret, ", "):"";
	if (sizeof(res) && sizeof(last))
		res += " and ";
	res += last;	
	res = (neg?"minus ":"") + res;
	return res;
}

