/*
 * /lib/adverbs.c
 * Shattered World Mudlib
 *
 * Adverbs server, provides a list of English adverbs.
 */

/*
 * History:
 * 951002 Hunter	incept
 */

inherit "RO/Servers";

const AdverbFile = "lib/adverbs";
nosave array Adverbs;			/* flat array of strings */

reset(arg)
{
    if (!arg)
    {
	load_adverbs();
    }
}

load_adverbs()
{
string f = grab_file( AdverbFile );
    if (stringp(f))
        Adverbs = explode( f, "\n" );
}

query_adverbs()
{
    return Adverbs;
}

