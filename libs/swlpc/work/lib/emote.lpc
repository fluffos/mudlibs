/*
 * lib/emote.c
 * Shattered Worlds Mudlib
 *
 * Various bits of useful things to make emotes a little more
 * generic
 */

/*
 * History:
 * 951217 Hunter	created lib/emote.c
 * 951218 Hunter	made emote_string() a little more robust
 * 960308 Belgarion - hacked around to fix the problem with sirens.
 */

inherit "RO/Servers";

reset( ) { } /* do-nothing reset */

/*
 * emote_string takes a string of text (typically the message
 * that will be displayed when someone does something), the
 * verb of that action, and a target object (optional).
 */
string
emote_string( 
	object myself, 		/* the actor of the action */
	string str, 		/* the message with symbols */
	(int|string) verb, 	/* the verb (optional) */
	(int|object) target 	/* the target (optional) */
	)
{
array arr;
(int|string) s;
(int|string) s1, s2; /* hack until the GD is fixed. Bel. */
string pass1;
    if (intp(verb))
	verb = "";
    arr = [ 
	"n", myself->query_name(),
	"hc", (stringp(s = myself->query_store("hair colour"))?s:""),
	"ec", (stringp(s1 = myself->query_store("eye colour"))?s1:""),
	"sc", (stringp(s2 = myself->query_store("skin colour"))?s2:""),
	"g", myself->query_gender(),
	"s", GENDER->sub( myself ),
	"o", GENDER->obj( myself ),
	"p", GENDER->pos( myself ),
	"r", myself->query_race(),
	"v", verb
	];
    if (objectp(target))
    {
	arr += [ "N", target->query_name(),
		"G", target->query_gender(),
		"S", GENDER->sub( target ),
		"O", GENDER->obj( target ),
		"P", GENDER->pos( target )
	];
    }
    pass1 = STRINGS->format_string( str, arr );
    if (stringp( pass1 ))
        return ENGLISH->fix_up_english( pass1 );
    return "Something broken in /lib/emote->emote_string\n"; /* hmmm */
}

