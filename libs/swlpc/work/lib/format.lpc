/*
 * String functions: Formating
 *
 */
/* See also /lib/strings.c, /lib/printf.c
 */

nosave string blank_string;

reset(arg) {
	if (!arg)
	{
		blank_string = "                                           "+
	"                                                      ";
	}
}

string left_justify((int|string) str,int  width)
/* pad out the string with spaces */
{
    if (intp(str))
	str = str + "";
    return str+ blank_string[..width-sizeof(str)-1];
}

string right_justify((int|string) str,int width)
{
    if (intp(str))
	str = str + "";
    return blank_string[..width-sizeof(str)-1] +str;
}

string center_justify((int|string) str,int width)
{
    if (intp(str))
	str = str + "";
    str = left_justify(str, (width+sizeof(str))/2);
    return right_justify(str, width);
}

