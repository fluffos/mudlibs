bitstr2int(str)
/* warning - this does not handle numbers effectivly larger than 
 * 32 bits */
{
int r;
int i;
int c;
	r = 0;
	i = 0;
	c = 1;	
	while (i < sizeof(str))
	{
		r += c * (str[i] - "!"[0]+1);
		i ++;
		c *= 64;
	}
	return r;
}

is_bitstr(str)
{
int i;
	i = 0;
	while (i < sizeof(str))
	{
		if (str[i] < "!"[0] || str[i] > "_"[0])
			return 0;
		i ++;
	}
	return 1;
}
