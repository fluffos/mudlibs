/* 
 * Handy array efuns
 * 950919 Fuck me - the originals were stupidly inefficient.  Rewritten - G.
 *
 * NB: lots of array addition can cause pretty nasty lag.  Generally
 * best to allocate an array large enough to hold the result (within
 * reason), then return the initial segment - G.
 */

array diff(array one,array two) { /* return array of elements not in both */
    array ret = allocate(sizeof(one) + sizeof(two)); 
    int i;
    int x = 0;
	for (i = 0; i < sizeof(one); i ++)
		if (index(two, one[i]) == -1) 
			ret[x++] = one[i];
	for (i = 0; i < sizeof(two); i ++)
		if (index(one, two[i]) == -1)
			ret[x++] = two[i];
	return ret[..x-1];
}

/*
 * (dredd?) return array of elements common to both arrays
 */
array common(array one,array two) {
	array ret; 
	int i;
	int x = 0;
	if (sizeof(one) > sizeof(two))
		ret = allocate(sizeof(two));
	else
		ret = allocate(sizeof(one));
	for (i = 0; i < sizeof(one); i ++)
		if (index(two, one[i]) != -1) 
			ret[x++] = one[i];
	return ret[..x-1];
}

array
delete(array arr,int  beg,int  c) { /* return new array with arr[beg..beg+c] removed */
	return arr[..beg-1]+arr[beg+c+1..];
}

/*	Dredd - 1992	*/
array remove(arr, ele,int siz) {
	int x;
	if (!pointerp(arr)) return [ ];
	if (!siz) siz = 1;
	x = index(arr, ele);
	if (x < 0) return arr;
	return (arr[..x-1] + arr[x+siz..]);
}

/*
 * Hunter, 931213 - return array one after any occurances of two have been removed
 * (eg set difference).
 */

array subtract(array one, array two) {
    array retv = allocate(sizeof(one));
    int retc = 0;
    int i;
    for (i = 0; i < sizeof(one); i ++) {
	if (index(two, one[i]) == -1) {
	    retv[retc] = one[i];
	    retc ++;
	    }
        }
    retv = retv[..retc-1];
    return retv;
}

/* 
 * Darkryln, 950214: return a randomized version of arr 
 * 950919 Stupidly inefficient.  Rewritten - G.
 */

array randomize(array old) {
    array arr = old + [ ];				/* just in case caller wants to keep the original */
    int upto = 0;

    while(upto < sizeof(arr)) {
	int choice = random(sizeof(arr) - upto);	/* choose one of the remaining elts (for flat random distribution) */
	int tmp = arr[choice];				/* swap it with the elt we're up to */
	arr[choice] = arr[upto];
	arr[upto] = tmp;
	upto++;
    }
    return arr;
}

