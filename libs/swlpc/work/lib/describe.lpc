/*
	Dredd 1992 - Shattered World.

	arg - arg should be a string.

	could do nice multiple descriptions too!
*/

#define MAX_LOOK 30
string
add_commas(arg)
{
int item, pos, y;
string desc;
array a, b, itemcount = [ ];

    for (item = 0; item < sizeof(arg); item++)
    {
	desc = arg[item];
	if (desc)
	{
	    if (desc[..1] == "A ")
		desc = "a "+desc[2..];
	    if (desc[..2] == "An ")
		desc = "an "+desc[3..];
	    pos = index(itemcount, desc);
	    if (pos < 0)
		itemcount += [1, desc];
	    else
		itemcount[pos-1]++;
	}
    }
    for (item = 0; item < sizeof(itemcount); item+=2)
    {
    	if (itemcount[item] == 1)
	    itemcount[item] = 0;
	else
	{
	    itemcount[item] = "lib/english"->int_to_english(itemcount[item], 20) + " ";
	    itemcount[item+1] = "lib/plural"->plural(itemcount[item+1]);
	}
	if (item > 0)
	    if (item < sizeof(itemcount) - 2)
	    	itemcount[item-1] += ", ";
	    else
	    	itemcount[item-1] += " and ";
    }
    if (sizeof(itemcount))
	return implode(itemcount, "");
    else
    	return 0;
}
