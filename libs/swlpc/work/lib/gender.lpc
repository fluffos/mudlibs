/*
 * lib/gender
 * Standard Gender Object.
 *
 * Define functions to return the proper third person pronoun based on
 * gender. Amongst other things.
 */

/*
 * 951007 Hunter	shifted code from std/gender (where it doesn't
 *			belong), and added sibling(), parent(), child()
 *			Added type checks to existing functions.
 * 951011 Hunter	added single() and plural()
 * 951015 Hunter	added spouse()
 * 951024 Hunter	made _gender() more watertight.
 * 951029 Hunter	added various royalty-type gender strings
 * 951113 Hunter	made _gender() even more watertight
 * 951120 Hunter	_gender() bug with file_name() fixed.
 * 960331 Belgarion	hacked around to make the _gender error message
 *                      clearer(?)
 */

inherit "RO/Servers";

/*
 * The contents of Genders matches with the arrays inside
 * GenderTable (below). If you want to add more genders,
 * you will need to add appropriate strings to all the
 * nested arrays.
 */
nosave array Genders = [ "male", "female", "neuter" ];

nosave array GenderTable = [
/* pronouns ... */
    "possessive", 	[ "his", "her", "its" ],
    "objective", 	[ "him", "her", "it" ],
    "subjective", 	[ "he", "she", "it" ],
/* plural, singular: */
    "single", 		[ "man", "woman", "thing" ],
    "plural", 		[ "men", "women", "things" ],
/* relations ... */
    "sibling", 		[ "brother", "sister", "sibling" ],
    "parent", 		[ "father", "mother", "parent" ],
    "child", 		[ "son", "daughter", "child" ],
    "kid", 		[ "boy", "girl", "kid" ],
    "spouse", 		[ "husband", "wife", "spouse" ],
/* misc. honourifics (not nobility - see later) ... */
    "honourific",	[ "mister", "miss", "mister" ],
/* nobility ... */
    "knight", 		[ "sir", "lady", "sir" ],
    "chief",		[ "chief", "chieftess", "chief" ],
    "lord", 		[ "lord", "lady", "lord" ],
    "baronial", 	[ "baron", "baroness", "baron" ],
    "county", 		[ "count", "countess", "count" ],
    "earl",		[ "earl", "earless", "earl" ],
    "ducial", 		[ "duke", "duchess", "duke" ],
    "royal", 		[ "king", "queen", "king" ],
    "imperial", 	[ "emperor", "empress", "emperor" ],
/* occupational and guild ... */
    "patriarchal", 	[ "patriarch", "matriarch", "neutiarch" ],
    "witch",		[ "warlock", "witch", "witch" ],
    "enchanter", 	[ "enchanter", "enchantress", "enchanter" ],
    "sorcerer",		[ "sorcerer", "sorceress", "sorcerer" ],
    "shaman",		[ "shaman", "shamaness", "shaman" ],
    "druid",		[ "druid", "druidess", "druid" ],
/* religious ... */
    "priest",		[ "priest", "priestess", "priest" ],
    "monk", 		[ "monk", "nun", "monk" ]
    ];

reset()
{
}

/*
 * _gender() is used internaly, to normalize the gender of whatever
 * is passed to it
 */
string
_gender( (int|object|string) ob, (int|object) po )
{
/* object po = previous_object(); */
object tp = this_player();
    if (caller() != this_object())
        po = caller();
    if (stringp(ob))		/* "male" or "female" ? */
	return ob;
    if (intp(ob))		/* nothing, so use this_player() */
    {
	if (!objectp(tp))
	{
	    if (objectp(po))
	        throw("GENDER: no gender specified by call from " 
		+ file_name(po) );
	    else
		throw("GENDER: no gender specified by call from Game Driver(?)");
	}
	return tp->query_gender();
    }
    if (objectp(ob))
        return ob->query_gender();	/* assume ob is object at this point */
    /* if we got this far, then the type-checking died */
   throw( "GENDER: type-checking died in _gender()" ); 
}

/*
 * _gender_string() is used internally as the core lookup function
 */
string
_gender_string( (int|object|string) ob, string code, (int|object) po )
{
int i = index( GenderTable, code );
string gender = _gender(ob, po);
int g = index( Genders, gender );
    if (caller() != this_object())
        po = caller();
    if (i == -1)
	throw("GENDER: unknown code \""+code+"\"");
    if (g == -1)
	g = index( Genders, "neuter" );
    return GenderTable[i+1][g];
}

/*
 * now for all the service functions. It would be nice if an object
 * could 'export' a dynamically created function, it would eliminate
 * the need for the following. Ahh well.
 */
string
sub( (int|object|string) ob )
{
    return _gender_string( ob, "subjective", caller() );
}

string
obj( (int|object|string) ob)
{
    return _gender_string( ob, "objective", caller() );
}

string
pos( (int|object|string) ob)
{
    return _gender_string( ob, "possessive", caller() );
}

string
sibling( (int|object|string) ob)
{
    return _gender_string( ob, "sibling", caller() );
}

string
parent( (int|object|string) ob)
{
    return _gender_string( ob, "parent", caller() );
}

string
child( (int|object|string) ob)
{
    return _gender_string( ob, "child", caller() );
}

string
kid( (int|object|string) ob)
{
    return _gender_string( ob, "kid", caller() );
}

string
single( (int|object|string) ob)
{
    return _gender_string( ob, "single", caller() );
}

string
plural( (int|object|string) ob)
{
    return _gender_string( ob, "plural", caller() );
}

string
spouse( (int|object|string) ob)
{
    return _gender_string( ob, "spouse", caller() );
}

string
ducal( (int|object|string) ob)
{
    return _gender_string( ob, "ducal", caller() );
}

string
baronial( (int|object|string) ob)
{
    return _gender_string( ob, "baronial", caller() );
}
