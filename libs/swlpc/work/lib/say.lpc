/*
 * Ho hum - a tell function - like checked_say I guess.
 */

inherit "RO/Servers";

tell_all(object me, string verb, string output, not_us)
{
	tell_object(me, "You "+verb+" "+output+".\n");
	me->checked_say(me->query_name() + " " + PLURAL->plural(verb)
	+" "+output+".\n", not_us);
}

rtell(object env, string what)
{
	msay(what, contents(env), 0);
}


msay(string what, (int|array) who, (int|array) not_us)
{
int i;
	for (i = 0; i < sizeof(who); i++) {
		if (!not_us || index(not_us, who[i]) == -1) {
			if (who[i]) {
			if (who[i]->query_muffled()) who[i]->add_note(what);
			else tell_object(who[i], what);
			}
		}
	}
}

rsay(object who, string what, (int | object) someone)
{
int i;
array others;
	others = contents(environment(who));
	if (someone)
		msay(what, others, [ who, someone ] );
	else
		msay(what, others, [ who ] );
}
