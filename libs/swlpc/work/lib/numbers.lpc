/*
 * see also lib/imath.c - G.
 */

reset(arg) {
}

int abs(int n) { /* return absolute value of n */
	return (n < 0)?-n:n;
}

int sum(array data) { /* array data of integers */
int tot, i;
	for (i = tot = 0; i < sizeof(data); i ++)
		if (intp(data[i]))
			tot += data[i];
	return tot;
}

int mean(array data) { /* array data of integers */
int num, tot, i;
	for (i = tot = num = 0; i < sizeof(data); i ++)
		if (intp(data[i])) 	
		{
			tot += data[i];
			num ++;
		}
	return tot / num;
}	

int factorial(int n,int m) { /* non-recursive n! function */ 
int res, i;
	res = 1;
	i = m;
	while (n > i++)
		res = res * i;
	return res;
}

int permutations(int n,int m) { return factorial(n,m); }

int combinations(int n,int m) { return factorial(n)/(factorial(m)*factorial(n-m)); }
