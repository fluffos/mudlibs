 *
 * Shattered World Mud.
 * 
 */
#include "security.h"

add_action(string func, string verb, int match)
{
    object o = this_player();

    if (!o) 
    {
        throw("Invalid player in add_action().\n");
        return;
    }
   
#if 0
    "RO/logger"->log_now("IO", "add_action: " + file_name(o) + ", " +
                file_name(caller()) + ":" + func + "->" + verb + "\n");
#endif

    o->add_action(caller(), func, verb, match, caller());
}


notify_fail(string str)
{
    object o = this_player();

    if (!o) 
    {
        throw("Invalid player in notify_fail().\n");
        return;
    }

    o->notify_fail(str);
}

object currentTP;

command(string s, (int|object) o)
{
    object oldTP = currentTP;
    int r;
    if (!o) 
    {
        o = caller();
    }

    // security check
    if (o->query_wiz() && query_ip_number(o) &&
                query_su_level(caller()) < GOD) return 0;

    currentTP = o;
    r = o->catch_input(s);
    currentTP = oldTP;
    return r;
}

set_this_player((int|object) x)
{
#if 0
    "RO/logger"->log_now("IO", "set_this_player: by " + file_name(caller()) + 
        ": to " + file_name(x) + "\n");
#endif
    currentTP = x;
}

this_player()
{
    return currentTP;
}

query_verb()
{
    object o = currentTP;

    if (!o) 
    {
        throw("Invalid player in query_verb().\n");
        return;
    }

    return o->query_verb();
}

