
//
// 001117 Jenna	 Transfer now sends an arg to ob->prevent_insert()
//		 Added to let some containers only store certain objects
//		 (e.g. keyrings)
//

int
transfer(object o, (string|object) dest)
{
object from, tmpo;
int weight;

        weight = o->query_weight();
        if (!intp(weight)) {
                throw ("Fucked type returned from query_weight() in "+
                                file_name(o)+".\n");
                return;
        }
        if (stringp(dest)) {
                catch dest->stupidfuckingloadup();;
                tmpo = find_object(dest);
                if (!tmpo) {
                        throw ("transfer() - object "+dest+" not found.\n");
                        return;
                }
                dest = tmpo;
        }
        from = environment(o);
        if (from && from->query_living() && o->drop()) return 2;
        if (!o) return 2;       /* it may have been dested :( */
        if (from && environment(from) && !(from->query_living()) &&
                (from->can_put_and_get() != 1)) return 3;
	/* if (!from) return 3; */

        /* we must have a destination */
        if (!(dest->query_living())) {
                if (!dest) return 4;
                /* if (o->prevent_insert()) return 4; */

		// below line previously had no 'o' arg - Jenna Nov 00
                if (dest->prevent_insert(o)) return 4;

                if (!dest) return 4;
                if (!dest->can_put_and_get()) return 5;
                if (!dest) return 5;
        }
        else {
                if (o->get() == 0) return 6;
                if (!dest) return 6;
        }
        if (weight && environment(dest) &&
                (dest->add_weight(weight) == 0)) return 1;
        if (from && weight) {
                from->add_weight(-weight);
        }
        move_object(o, dest);
        return 0;
}
