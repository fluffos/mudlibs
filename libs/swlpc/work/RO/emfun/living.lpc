
#define LIVING_HANDLER "S/living"

#if 0
enable_commands()
{
    // do nothing!
}
#endif

set_living_name(string name)
{
    object o = caller();

    LIVING_HANDLER->set_living_name(o, name);
}

object find_living(string name)
{
    return LIVING_HANDLER->find_living(name);
}

object find_player(string name)
{
    return "/P/p"->find_player(name);
}

