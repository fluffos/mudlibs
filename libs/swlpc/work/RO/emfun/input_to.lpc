input_to(string func, int echo, pob)
{
    object o;
    
    if (!objectp(pob))
	pob = this_player();

	if (!objectp(pob)) 
    {
		throw("No valid player in input_to().\n");
		return;
	}
	o = caller();
	pob->redirect_input(o, func, echo);
}
