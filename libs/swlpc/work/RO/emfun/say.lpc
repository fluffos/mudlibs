/*
 *
 * say (string message [, (object|array) avoid])
 *
 *  if (avoid  == 0 ) {
 *    Tell the message to all living objects in the inventory and environment
 *    of this_player(). The surrounding environment is then told.
 *    }
 *  else {
 *    Tell the message to all living objects in the inventory and environment
 *    of caller() excluding those specified in avoid.
 *    The surrounding environment is then told.
 *    Avoid can be a null array.
 *    }
 *    
 */                        
 
say(string str,(object|array|int) avoid)
{
object origin, env;
array whoto;
int i;

        if (objectp(avoid)) avoid = ({ avoid });

        if (!avoid) {
          origin = this_player ();
          avoid = ({ origin });
          }
         else {
          origin = caller();
          avoid += ({ origin });
          }

        /* do the tell_object stuff */
        if (origin == 0) return;
        env = environment(origin);
        whoto = contents (origin);
        if (env) whoto += contents(env);


        for (i = sizeof(whoto); i--; ){
          if (living(whoto[i]) && (index (avoid, whoto[i]) <0) ) 
             tell_object(whoto[i], str);
        }
        if (env) tell_object(env, str);
}
