/*
 * Generic Hooks
 * Shattered Worlds Mudlib
 * Aaron Wigley <wigs@yoyo.cc.monash.edu.au>
 *
 * Maintains a list of object->function() hooks, and provides
 * various ways of polling those hooks.
 */

/*
 * History:
 * 950821 Hunter	prototype
 * 950822 Hunter	cleaned/speeded up usage of arrays
 * 960402 Hunter	tightened up security 
 */

/*
 * HooksTable is an array of the form:
 * ({ ..., string hookname, ({ ..., object o_n, string f_n, ... }), ... })
 *
 * hookname:	the unique label of this hook
 * o_n:		object/string pointer to object to call
 * f_n:		string function name to call
 *
 * We don't want HooksTable to save, as a lot of the object pointers
 * will become invalid upon reloading, so make it nosave. Rather,
 * upon reloading, the HooksTable should be rebuilt dynamically.
 */
nosave array HooksTable = ({ });

/*
 * HooksTableLock is a flag, if set it causes any changes to HooksTable
 * to be delayed via a call_out. It is set when the HooksTable is
 * about to be polled, and cleared when the poll is done.
 */
nosave int HooksTableLock = 0;

reset( arg )
{
    /* do nothing, but it should be called anyway */
}

/*
 * Used (eventually) by STAT_SERV:
 */

array query_hooks( /*(int|string)*/ hookcode )
{
int x;
    if (!stringp( hookcode ))
    {
        return HooksTable;	
			/* don't bother returning a copy only, as we can */
			/* only protect the outer layer easily. */
			/* ie. we must trust whatever is calling this */
			/* function. */
    }
    x = hook_index( hookcode );
    if (x == -1)
    {
	return ({ });	/* no such hooks */
    }
    return hook_original( x );
}

int
hook_index( string hookname )
{
int i;
    i = index( HooksTable, hookname );
    return i;
}

array 
hook_copy( int hookpos )
{
    if (hookpos < 0)
	return ({ });
    return HooksTable[ hookpos + 1 ] + ({ });
	/* this array addition is tricky to avoid. I'll try to -H */
}

array
hook_original( int hookpos )
{
    if (hookpos < 0)
	return ({ });
    return HooksTable[ hookpos + 1];
}

/*
 * General mechanism to add a hook:
 * for now (960402), we will assert that obj must be caller(),
 * due to security considerations. In future, this may be relaxed
 * - Hunter
 */
int
add_hook( string hookname, (string|object) obj, string func )
{
int i;
int j;
object calling_object = previous_object();
    /* security test... */
#if 0
    if ( stringp(obj) && (obj != explode(file_name(calling_object),'#')[0]) )
    {
        return -2; /* disallow */
    }
    else if ( objectp(obj) && (obj != calling_object) )
    {
        return -2; /* also disallow */
    }
#endif
    if ( HooksTableLock )
    {
	/* delay the table change - it is currently in use */
	call_out( "add_hook", 0.1, hookname, obj, func );
	return -1;
    }
    i = hook_index( hookname );
    if (i == -1)
    {
	/* note - we also add some empty slots, to save on costly array
 	 * addition later, when/if more hooks are added.
	 */
	HooksTable += ({ hookname, ({ obj, func, 0, 0, 0, 0, 0, 0 }) });
	return 1;
    }
    else
    {
	for (j = 0; j < sizeof( HooksTable[i+1] ); j += 2)
	{
	    if ( HooksTable[i+1][j] == obj && HooksTable[i+1][j+1] == func )
	    {
		/* avoid duplicates */
		return 0;	/* not added */
	    }
	    if ( intp(HooksTable[i+1][j]) )
	    {
		/* found empty slot, let's fill it */
		HooksTable[i+1][j] = obj;
		HooksTable[i+1][j+1] = func;
		return 1;
	    }
  	}
	/* if we got to here, there are no empty slots */
	/* add hook to end, along with some empty slots */
	HooksTable[i+1] += ({ obj, func, 0, 0, 0, 0, 0, 0 });
   	return 1;
    }
    return 0;	/* failed to add hook. Shouldn't actually get here */
}

/*
 * General mechanism to remove a hook
 */
int
remove_hook( string hookname, (string|object) obj, (int|string) func )
{
int i;
int j = 0;
int c = 0;
    if ( HooksTableLock )
    {
	/* delay the table change - it is currently in use */
	call_out( "remove_hook", 0.1, hookname, obj, func );
	return -1;
    }
    i = hook_index( hookname );
    if (i == -1)
	return 0;		/* no hooks by that name */
    while (j < sizeof(HooksTable[i+1]) )
    {
	if (HooksTable[i+1][j] == obj)
	{
	    /* partial match, on object so far */
	    if ( intp(func) || func == HooksTable[i+1][j+1] )
	    {
		/* match made - remove the hook by zeroing the elements */
	 	/* don't implode the array - costly on performance */
		HooksTable[i+1][j] = 0;
		HooksTable[i+1][j+1] = 0;
		c ++;		/* increment count of hooks removed */
	    }
	}
	else
	    j += 2;
    }
    return c;	/* return number of matches found, may be 0 */
}

/*
 * semaphore functions for locking HooksTable
 */
nosave 
lock_hooks( )
{
    /* at this point, if HooksTableLock is already set, it's most probably
     * an error condition. Anyway...
     */
    HooksTableLock ++;
}

nosave
unlock_hooks( )
{
    HooksTableLock --;
}

/*
 * Poll each hook, and if any of the hooks returns non-zero, return 1,
 * otherwise zero. We won't need to test all, if an early one bombs out.
 */
test_binary_hook( string hookname, arg1, arg2, arg3, arg4 )
{
int i;
array Hooks;
int j;
int r;
    i = hook_index( hookname );
    if (i == -1)
	return 0;	/* no hooks, so no need to test */
    lock_hooks();
    Hooks = hook_original( i );	/* grab original of array, use semaphore 
				 * to prevent changes */
    for (j = 0; j < sizeof( Hooks ); j += 2)
    {
	if ( !intp(Hooks[j]) )	/* does the object still exist? */
	{
	    catch { r = Hooks[j]->(Hooks[j+1])( arg1, arg2, arg3, arg4 ); };
	    if (r)
	    {
    		unlock_hooks();
	        return Hooks[j];	/* bomb out time */
	    }
	}
    }
    unlock_hooks();
    return 0;		/* if we get here, no objections to hook */
}

/*
 * Poll each hook, ignoring any responses from the hook functions.
 * This can be used as a notification mechanism.
 */
test_advisory_hook( string hookname, arg1, arg2, arg3, arg4 )
{
int i;
array Hooks;
int j;
int r;
    i = hook_index( hookname );
    if (i == -1)
	return 0;	/* no hooks, so no need to test */
    lock_hooks();
    Hooks = hook_original( i );	/* grab original of array, trust in 
				 * semaphore to avoid changes */
    for (j = 0; j < sizeof( Hooks ); j += 2)
    {
	if ( !intp( Hooks[j] ) )
	{
	    catch { r = Hooks[j]->(Hooks[j+1])( arg1, arg2, arg3, arg4 ); };
	}
    }
    unlock_hooks();
}

/*
 * Poll each hook, and simply store the return values of each
 * call.
 */
array
test_results_hook( string hookname, arg1, arg2, arg3, arg4 )
{
array ret;	/* someplace to store the results in */
int i; /* loop counter */
array Hooks; /* temp reference to the current hooks to test */
int j;
int r;
    i = hook_index( hookname );
    if (i == -1)
        return 0;
    lock_hooks();
    Hooks = hook_original( i );
    ret = ({ allocate( sizeof(Hooks[j])), allocate( sizeof(Hooks[j]) ) });
    for (j = 0; j < sizeof( Hooks ); j += 2)
    {
        catch { r = Hooks[j]->(Hooks[j+1])(arg1, arg2, arg3, arg4); };
        ret[0][j] = r;
        ret[1][j] = Hooks[j];
    }
    unlock_hooks();
    return ret;
}


/*
 * Poll each hook, and, expecting an int int the range 0..10,
 * treat the int as a rating, and return the results sorted
 * in descending order. (Could be used for 'reccomendations').
 */
array
test_rated_hooks( string hookname, arg1, arg2, arg3, arg4 )
{
}


/*
 * returns Hooks owned by a specific object
 */
array
query_hooks_by_object( object target )
{
array ret = allocate( sizeof( HooksTable ) / 2 );
int i;
int j = 0;
    for (i = 0; i < sizeof(HooksTable); i += 2)
    {
	if (index(HooksTable[i+1], target) != -1)
	{
	    ret[j] = HooksTable[i];
	    j ++;
	}
    }
    ret = ret[..j-1];
    return ret;
}

