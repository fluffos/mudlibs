/*
 * Colored mana system - for collections of different colored mana,
 * which are all `fed' by the available magic, but which drift at
 * different speeds, have different conversion efficiencies, and where
 * a player has a different sized available reservoir of each color.
 *
 * We store colorless mana as an (independently drifting) value, having as
 * its default maximum the player's magic reserves, which is essentially
 * fed by (or to) the environment.  Each color drifts as well, towards its
 * default storage level; however, a player's actual 
 */

inherit "RO/living/points_store";

array mana_colors = [ ];
