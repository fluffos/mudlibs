/*
 * This is really a brutal hack to prevent wizzes from fucking up with stats.
 *
 * Moved from secure/death.h by Jenna April 2000 to allow monsters to stat-die.
 */

stat_zero(x) {
    if (this_object()->query_ghost()) return 0;
    if (stringp(x))
        stat_death(x);
    else if (arrayp(x)) {
        stat_death(x[0]);
        }
    }

stat_death(ty) {
    int x;

    while (find_call_out("stat_death") != -1)
        remove_call_out("stat_death");

    if (ty == "str") tell_object(this_object(), "Your strength is reduced to "+
	"nothing.\nYou cannot breathe, your heart is too weak to pump blood!\n");
    else if (ty == "con") tell_object(this_object(), "Your constitution is "+
	"totally drained.\nYour internal organs pack it in!\n");
    else if (ty == "int") tell_object(this_object(), "Your intelligence is "+
	"destroyed.\nYour brain falls apart.\n");
    else if (ty == "wis") tell_object(this_object(), "Your instincts have "+
	"deserted you.\nYour autonomic nervous system fails\n");
    else if (ty == "chu") tell_object(this_object(), "You have no chutzpah!  You "+
	"die of embarrasement...\n");
    else if (ty == "san") tell_object(this_object(), "Your sanity leaves you "+
	"totally!  Your mind floats free...\n");
    else if (ty == "dex") tell_object(this_object(), "Your dexterity is reduced "+
	"to nothing!  You trip and split your skull open.\n");
    else if (ty == "siz") tell_object(this_object(), "Your body has shrunk to "+
	"nothing!  You leave this plane for another.\n");
    else tell_object(this_object(), "Your " + ty + " is reduced to 0!\n");
    x = query_stat(ty, 1); /* perm stats only */
    if (x < 1)
	add_stat(ty, 1-x);
    /* stat_death_adjust() takes care of any temp stats */
    this_object()->death();
    }

/*
 * stat_death_adjust: if we get killed, we lose all skill learning we
 * were doing, and expire all physically based tmp modifies.
 * Ultimately, we would like to make physical stats based solely on
 * the body, meaningless until we inhabit a new one, and mental stats take a
 * small random change from death (intel/wis may change up or down - death is
 * a real learning experience, but a bit of a shock to the system; power
 * and sanity will decrease).  Chu is un tmp-modified because it could
 * go either way :)
 * Skills are decreased by random(5) if > 33%.
 */

nosave stat_death_adjust() {
    array physical = ({ "str", "con", "dex", "chu", "siz" });
    skill_learn = ({ });
    stat_learn = ({ });
    array new_ts = allocate(sizeof(tmp_stat_adjust));
    int x = 0, y = 0;
    /*
     * Expire the tmp stats - have to reorder array.
     * Make 2 passes - put modified skills at the front first.
     */
    while (x < sizeof(tmp_stat_adjust)) {
	if (index(physical, tmp_stat_adjust[x]) >= 0) {
	    new_ts[y++] = tmp_stat_adjust[x];	/* name */
	    new_ts[y++] = tmp_stat_adjust[x+1];	/* amt */
	    new_ts[y++] = 0;			/* expiry */
	    new_ts[y++] = tmp_stat_adjust[x+3];	/* callback */
	    new_ts[y++] = tmp_stat_adjust[x+4];	/* param */
	    tmp_stat_adjust[x] = 0;	/* it has been moved */
	    }
	x += 5;
	}
    /* copy the remainder in */
    x = 0;
    while (x < sizeof(tmp_stat_adjust)) {
	if (tmp_stat_adjust[x]) {		/* copied already? */
	    new_ts[y++] = tmp_stat_adjust[x];	/* name */
	    new_ts[y++] = tmp_stat_adjust[x+1];	/* amt */
	    new_ts[y++] = tmp_stat_adjust[x+2];	/* expiry */
	    new_ts[y++] = tmp_stat_adjust[x+3];	/* callback */
	    new_ts[y++] = tmp_stat_adjust[x+4];	/* param */
	    }
	x += 5;
	}
    tmp_stat_adjust = new_ts;
    new_expire_time(0);				/* fix the callout */
/* Now subtract a little from the learned skills */
    for (x = 0; x < sizeof(skill_names); x++)
	if (perm_skills[x] > 33)
	    perm_skills[x] -= random(5);
    }

/*
 * Backward compat hooks.
 * Probably useful for preventing misspellings in standard stat names :)
 */

add_str(int am) { return add_stat("str", am, 0, 0, 0, caller()); }
add_int(int am) { return add_stat("int", am, 0, 0, 0, caller()); }
add_dex(int am) { return add_stat("dex", am, 0, 0, 0, caller()); }
add_con(int am) { return add_stat("con", am, 0, 0, 0, caller()); }
add_san(int am) { return add_stat("san", am, 0, 0, 0, caller()); }
add_chu(int am) { return add_stat("chu", am, 0, 0, 0, caller()); }
add_pow(int am) { return add_stat("pow", am, 0, 0, 0, caller()); }
add_siz(int am) { return add_stat("siz", am, 0, 0, 0, caller()); }
add_wis(int am) { return add_stat("wis", am, 0, 0, 0, caller()); }

