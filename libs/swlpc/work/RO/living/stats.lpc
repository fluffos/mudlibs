query_vision(f) { return 14 ; } /* temp hack */
query_str(f) { return query_stat("str", f) - query_weakness();}
query_int(f) { return query_stat("int", f);}
query_dex(f) { return query_stat("dex", f);}
query_con(f) { return query_stat("con", f);}
query_san(f) { return query_stat("san", f);}
query_chu(f) { return query_stat("chu", f);}
query_pow(f) { return query_stat("pow", f);}
query_siz(f) { return query_stat("siz", f);}
query_wis(f) { return query_stat("wis", f);}

/*
 * start_stats - should be called from the startup for
 * the living object, after restore_object and check_old_stats if
 * necessary.  Starts callouts, deletes expired stats, etc.
 */

nosave start_stats() {
    new_expire_time(0);
    }

/*
 * clean_stats() - clean up before a save_object().
 */

nosave clean_stats() {
    }

/*
 * check_old_stats() - crud to restore players from old savefiles.
 * This will disappear when the old files are deleted (the function
 * will remain, though empty, in case new changeovers are required).
 */

#include "/RO/stats.h"

array stats = 0;		/* stat values - should be restored normally */

nosave check_old_stats() {
    int x;
    int avg;
    array s = STATNAMES;
    if (arrayp(stats)) {
	write("Very old version of savefile - talk to a god\n");
	this_object()->flush_output();
	destruct(this_object());
	return 0;
	}
    if ((!arrayp(last_stat)) || (sizeof(last_stat) != sizeof(stat_names)))
	last_stat = allocate(sizeof(stat_names));
    if ((!arrayp(last_learn)) || (sizeof(last_learn) != sizeof(skill_names)))
	last_learn = allocate(sizeof(skill_names));
    }

query_heroism(int x) {
    return heroism;
    }

query_skill_avg(int x) {
    return skill_avg;
    }
