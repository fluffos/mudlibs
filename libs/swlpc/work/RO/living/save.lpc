/*
 * Keep track of last save time, etc.
 */

int age = 0;				/* saved - logged in seconds */
int creation_time = time();		/* saved - meant to be set here */

nosave int last_age_time = time();	/* last time we queried age while in-game */

int query_age() {
    int now = time();
    age += now - last_age_time;
    last_age_time = now;
    return age;
    }

int query_creation_date() {
    return creation_time;
    }

/*
 * Just for stats.  An argument of 0 gives the actual age as a short
 * string; nonzero arguments are sometimes used internally (to print
 * offsets), but this may change in future.
 */

string query_age_short(int a) {
	int age = a;
	if (age == 0)
		age = query_age();
	int d = age / 86400;	/* days */
	string s = "";
	if (d)
		s = d + "+";
	age %= 86400;		/* strip days */
	d = age / 3600;		/* hours */
	if ((s == "") || (d > 9))
		s += d + ":";
	else
		s += "0" + d + ":";
	age %= 3600;		/* strip hours */
	d = age / 60;		/* minutes */
	if (d > 9)
		s += d + ":";
	else
		s += "0" + d + ":";
	d = age%60;
	if (d > 9)
		s += d;
	else
		s += "0" + d;
	return s;
}

/*
 * The full stringified version.  This used to divide minutes by 30
 * (probably because ages used to be incremented in heart beat).
 */

query_age_string(int i) {
	if (!i)
		i = query_age();
	string ret = "";
	int x = i/86400;
	if (x > 1)
		ret = (x + " days ");
	else if (x > 0)
		ret = (x + " day ");
	i %= 86400;
	x = i/3600;
	if (x > 1)
		ret += (x + " hours ");
	else if (x > 0)
		ret += (x + " hour ");
	i %= 3600;
	x = i/60;
	if (x > 1)
		ret += (x + " minutes ");
	else if (x > 0)
		ret += (x + " minute ");
	x = i % 60;
	if (x > 1)
		ret += (x + " seconds");
	else if (x > 0)
		ret += (x + " second");
	return ret;
}

show_age() {
	write("age:\t" + query_age_string() + ".\n");
}
