
/*
** Some support for persistence (ie query_auto_load())
** Loading support in /secure/body.c
**
** Dredd 1998
**
** Basic interface:
**      query_auto_load() returns an tuple (2-element array),
**          first element - a server to create the object or file to clone
**          second element - array of arguments to be passed to
**              make_auto() in a server (usually an array)
**              init_arg() in a cloned object (string or array)
*/

string persistobj;
array  persistargs;

array query_auto_load()
{
    array args;

    args = this_object()->query_auto_args();

    if (args) 
    {
        if (persistargs)
            args = persistargs + args;
    }
    else
    {
        args = persistargs;
    }

    if (persistobj == 0) return 0;

    return ({ persistobj, args });
}

set_auto(string pobj, (array|string|int) parg)
{
    persistobj = pobj;
    if (!arrayp(parg))
        persistargs = ({ parg });
    else
        persistargs = parg;
}


