/*
 * RO/base/medium.c
 * Shattered Worlds Mudlib
 * 
 * This is a Shattered World's Base Object Component
 *
 * Atmospheric Medium Code
 * -----------------------
 * This object is intended to be inherited, not cloned. All it provides
 * is a set of functions that gives the object an atmosphere, possibly
 * intended to be breathed.
 */

/*
 * History:
 *  951121 Hunter	created RO/base/medium.c from code in room/room.c
 *  960606 Hunter         fixed bug with remove_medium()
 */

inherit "RO/Servers";

/*
 * medium is the medium(s) of the room, for breathing purposes.  
 * The default value players breath is "air".  If medium is set 
 * to "magical", anything can breath it.
 */
array medium;

reset(arg) 
{
    /* Null function, just to make the parents happy*/ 
    /* All objects should still call reset() in this object though,
     * as in future something may be added to it -Hunter */
}

array
show_stats()
{
array ret;
    ret = ({ "medium(s): "+
        (pointerp(medium)?implode(medium,", "):"<none (air)>")  });
    return ret;
}


(int|array)
query_medium(arg)
{
    if (!medium)
        medium = ({"air"});
    if (stringp(medium))
        medium = ({medium});
    if (!arg)
	return medium;
    if (index(medium, arg) < 0)
        return 0;
    return 1;
}

int
add_medium( (array|string) arg )
{
    if (stringp(arg))
        arg = ({arg});
    if (medium)
        medium += arg;
    else
        medium = arg;
    test_all_breath();
}

int
set_medium( (array|string) arg )
{ /* for backward compat. should do an old_code trap on it */
    OLDCODE->add("set_medium in room/room", "");
    return add_medium(arg);
}

int
remove_medium( string arg )
{
int med;
    if (!medium)
        medium = ({"air"});
    med = index(medium, arg);
    if (med < 0)
        return 0;
    medium[med] = medium[sizeof(medium)-1];
    medium = medium[..sizeof(medium)-2];
    test_all_breath();
    return 1;
}

test_all_breath()
{
int Count;
array Contents;
    Contents = contents(this_object());
    for (Count = 0; Count < sizeof(Contents); Count++)
        Contents[Count]->test_breath();
}

