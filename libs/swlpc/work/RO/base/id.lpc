/*
 * RO/base/idable.c
 * Shattered Worlds Mudlib
 * 
 * This is a Shattered World's Base Object Component
 *
 * ID Code
 * -------
 * This object is intended to be inherited, not cloned. All it provides
 * is a set of functions that gives the object an identifier (an id).
 */

/*
 * History:
 *  951025 Hunter	cleaned up array slicing of remove_id(), so that
 * 			there is only one array slice.
 *  951120 Hunter	shifted id functions from RO/base_object to
 *			RO/base/idable.c
 *  951122 Hunter	added 'set_id()', for some strange reason it
 *			was omited in base_object.c
 *  000513 Dredd    Fixed some really slow expensive code in add_id().
 */

inherit "RO/Servers";

/*
 * provide some global variables (non-nosave because this stuff may
 * be dumped to a save file sometime).
 */

array name_list = [];	/* a list of matching nouns */

reset(arg) 
{
    /* All objects should still call reset() in this object though,
     * as in future something may be added to it -Hunter */
}

/* 
 * Variable format:
 *	name_list is 
 *	({ ids })
 *
 */

/* id handlers */
/*
 * If no arguement is supplied, then it returns the entire name_list 
 * If a string is passed, it returns 1 if it identifies with it 
 */

id(str)
{
    // if (!str) return (name_list + []);	
    if (index(name_list,str) > -1) return 1;			
    return 0;
}

/*
 * remove_id:
 *   remove id's from the object. can give a single id, or an array of
 *   id's.
 */
int 
remove_id((string|array)str)
{
    int x,size,pos;
    int idsRemoved = 0;
    if (!str) return 0;
    if (!pointerp(str)) str = [ str ];

    size = sizeof(name_list);
    x = sizeof(str);
    while (x--) 
    {
        /* for each (possible) id, if it exists in the list, replace it
        * with the id at the end of the array. Later, we drop the end of 
        * the array */
        pos = 0;
        if (str[x]) while ((pos = index(name_list, str[x], pos)) >= 0)
        {
            name_list[pos] = name_list[size-1];
            idsRemoved++;
            size--;
        }
    }

    /* didn't remove anything */
    if (idsRemoved == 0) return 0;			
    
    /* otherwise we removed some ids - trim the array */
    /* because we can't really assume that '0's in the array are safe 
     * that other code may assume non-zeros *sigh*, we clean up the
     * array */ 
    name_list = name_list[..size-1]; 
    return 1;
}

/*
 * add_id:
 *  add id's to the object. can add a single id, or an array of id's
 *
 * Would have to rewrite this if name_list ever had some importance
 * attached to any particular ordering of the array
 */
int
add_id( (string|array) str)
{
    int i;

    if (stringp(str)) // && (index(name_list, str) == -1)) 
    {
        if (index(name_list,str) == -1)
            name_list = name_list + [ str ];
    }
    else
    {
        name_list = name_list + str;
    }
#if 0
    i = sizeof(str);
    while (i--) 
    {
        if (!id(str[i])) 
	    name_list += ({ str[i] });
	/* this function is a slightly intensive, with
	 * it's array additions. A possible way of getting around it
	 * would be to trim down the array str, and then add a
	 * once-only slice of str to name_list, but it's debatable
	 * as to how quicker it would be, given that there would
	 * be only a handful of possible id's added at any point
 	 * -H */
    }
#endif
}

/*
 * set_id() - set the id's of this object, wiping any existing
 * id's the object may have. Usually, this is not a good thing,
 * objects which inherit things which inherit idable should use
 * add_id instead of set_id.
 */
int
set_id( (string|array) ids )
{
    /* fast erase */
    name_list = [];	
    // return this_object()->add_id(ids);
    return add_id(ids);
}

/*
 * Stats.
 */

array show_stats(arg) 
{
    array ret = allocate(sizeof(name_list) + 1);
    int i = 0;

    if (sizeof(name_list))
	ret[i++] = "Id        : \"" + implode(name_list, "\", \"") + "\"";
    else
        ret[i++] = "Id        : <none>";

    return ret[..i-1];
}


array query_ids()
{
	return name_list + [];
}
