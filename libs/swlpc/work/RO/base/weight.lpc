/*
 * RO/base/weight.c
 * Shattered Worlds Mudlib
 * 
 * This is a Shattered World's Base Object Component
 *
 * Weight Code
 * -----------
 * This object is intended to be inherited, not cloned. All it provides
 * is a set of functions that gives the object a weight.
 */

/*
 * History:
 *  951120 Hunter	created RO/base/weight.c
 */

inherit "RO/Servers";

/*
 * provide some global variables (non-nosave because this stuff may
 * be dumped to a save file sometime).
 */

real mass;			/* the mass of the object in kilograms */

reset(arg) 
{
    /* Null function, just to make the parents happy*/ 
    /* All objects should still call reset() in this object though,
     * as in future something may be added to it -Hunter */
}

/*
 * Set the weight of the object. Fails if we try to set it to have
 * a negative weight. Optionally, you can give it the unit of weight
 */
set_weight( (int|real) w, (int|string) unit )
{
    if ( w < 0 )		/* sanity check */
    {
	return 0;
    }
    mass = 0;
    return add_weight( w, unit );
}


/*
 * Add weight to the object - you can add negative weight, but if
 * the weight removed would drop below zero, it is silently set
 * to zero.
 */
add_weight( (int|real) w, (int|string) unit )
{
real m;
    if (stringp(unit))		/* conversion required? */
    {
	m = "lib/metrics/convert"->convert_weight( w, unit, "kilogram" );
    }
    else
    {
	m = w;
    }
    if (intp(m))		/* coerce into real */
	m = int2real(m);
    mass = w;
    if (mass < 0)
	mass = 0.0;
    return 1;
}

/*
 * return the weight of the object in kilograms
 */
real
query_weight( )
{
    return mass;
}

