/*
 * Affiliations - track characteristics that define our social circles (and
 * what those circles think of us).  For use by cults, races, etc;
 * can set this to a number, -1.0->1.0.  May
 * be used to store guild & cult levels, record curses,
 * and, in general, record other peoples' opinions of us.
 *
 * Don't overuse it; just update your guild/cult/whatever's
 * entry here whenever their status changes in the cult.
 * It's here as a per-player information server to support
 * the opinion stuff - it isn't meant to store values for
 * use by the guilds themselves.
 *
 * Standard affiliations:
 *	Guilds, cults: store the level (experience, whatever) normalised 0.0->1.0
 *	Race: store 1.0 for the player's race :)
 *	Curses, etc - use add_to_affiliation(-0.5), etc, depending on the
 * severity of the curse.
 */

/*
 * Affiliations may be -ve if someone is cursed by a guild, etc.
 * These aren't automatically tracked - they should be set explicitly.
 */

array affiliations = ({ });	/* "guild/knight", 0.7, "guild/healer", -0.3 */

set_affiliations(array a) {
    affiliations = a;
    }

real set_affiliation(string cl, string in, real val) {
    string aname = cl + "/" + in;
    int x = index(affiliations, aname);
    if (x < 0) {
	affiliations = ({ aname, val }) + affiliations;
	x = 0;
	}
    else
	affiliations[x+1] = val;
    return affiliations[x+1];
    }

/*
 * Add an increment to an affiliation
 */

real add_to_affiliation(string cl, string in, real val) {
    string aname = cl + "/" + in;
    int x = index(affiliations, aname);
    if (x < 0) {
	affiliations = ({ aname, val }) + affiliations;
	x = 0;
	}
    else {
	affiliations[x+1] += val - val * affiliations[x+1];
	}
    return affiliations[x+1];
    }

/*
 * Retrieve a single affiliation, or all.
 */

array query_affiliations() {
    return affiliations;
    }

int remove_affiliation(string cl, string in) {
    string aname = cl + "/" + in;
    int x = index(affiliations, aname);
    if (x < 0) 
	return 0;
    affiliations = affiliations[..x-1] + affiliations[x+2..];
    return 1;
    }

(real|int) query_affiliation(string cl, string in) {
    string aname = cl + "/" + in;
    int x = index(affiliations, aname);
    if (x < 0) 
	return 0;
    return affiliations[x+1];
    }

array query_affiliation_class(string cl) {
    int x = 0;
    int l = sizeof(cl) - 1;
    array a = ({ });
    while (x < sizeof(affiliations)) {
	if (affiliations[x][..l] == cl)
	    a += ({ affiliations[x] });
	x += 2;
	}
    return a;
    }
