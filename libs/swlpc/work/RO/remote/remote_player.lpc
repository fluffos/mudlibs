
/*
	Object to handle remote player datagrams.

	Receiving.
	----------
	* Needs to track all players in remote mode
	* Needs to send commands to the correct player
	  object which should then perform the command.


	-- we need a capability system for security.

	Sending.
	--------
	* Player objects should simply re-route commands
	  to this handler which are then sent on to the handler
	  at the remote site.
	* Initial connection should establish a player #
	* Send on what a player "sees" back to originating site.
	
	Copyright (C) 1995 - Geoff Wong 
	aka Dredd @ Shattered World.
*/


inherit "RO/cap_user";
inherit "RO/cap_provider";

#include <Servers.h>
#define RPLAYER "rplayer"

/* #define D(x) catch tell_object(find_player("dredd"), x); */
#define D(x) 1

#include "/RO/remote/remote_player.h"

reset(arg)
{
	invalidate_cap (RPLAYER);
	OBJ_DATAGRAM_SERV -> request_service(RPLAYER,make_cap(RPLAYER, 0)); 
}

dg_capability (int dg_cap, int verify_cap) {

        if (!auth_user (RPLAYER, verify_cap)) return;
        add_cap (RPLAYER, dg_cap);
}

/* 
	This function should be invoked and the object name
	which wants the success information should be passed
	as well as the host being connected to.

	** Initiation sequence **
	- object should call here with initiate(playerob, destination)

	(it'd be cool to send a players save file down the line;
	 and restore it at the other end!)
*/

object local_obj[MAX_REMOTE];

bootmon(string host)
{
array where;
int i;
        notify_fail("add a.b.c.d.port\n");
        where = explode(host, ".");
        if (sizeof(where) < 5) return 0;
        for (i = 0; i < sizeof(where); i++)
                where[i] = atoi(where[i]);

	initiate(this_player(), where, [ "human", 10 ] );
}

bootplayer(string host)
{
array where;
int i;
string pin;
        notify_fail("add a.b.c.d.port\n");
        where = explode(host, ".");
        if (sizeof(where) < 5) return 0;
        for (i = 0; i < sizeof(where); i++)
                where[i] = atoi(where[i]);

	save_object("open/tmp_boot", this_player());
	pin = grab_file("open/tmp_boot.o");
	initiate(this_player(), where, [ "player", pin ] );
}

initiate(object obj, array host, pinfo) 
{
int x;

	x = index(local_obj, 0);
	if (x == -1) return 0; /* failed */

	local_obj[x] = obj;	/* remember for the return notice */

	send(host, [ RINIT, x,  pinfo] );
}

send(array host, data) 
{
	OBJ_DATAGRAM_SERV->tx_dgram(RPLAYER, lookup_cap(RPLAYER),
			host, data);
}

dg_capability (int dg_cap, int verify_cap) 
{
	if (auth_user(RPLAYER, verify_cap)) add_cap(RPLAYER, dg_cap);
}    
    
/* Receiving End */
object remote_players[MAX_REMOTE];
int next_player = 0;

recv(int verify_cap, array calling_ip,data) 
{
int i;
array cont;
string name;
string cap, command;
int pid;

	/*data :  message */
	D("remote_player: recv()\n");
	if (!auth_user (RPLAYER, verify_cap)) {
		D("unauthorised cap\n");
		return;
	}
	if (pointerp(data)) {
	 if (data [0] == RINIT) {	/* request a remote body */
		D("RINIT(recv): "+data[2]+"\n");
		next_player = index(remote_players, 0);
		if (next_player > -1) {
			remote_players[next_player] = 
			"RO/remote_start"->start(calling_ip, data[1], data[2]);
			send(calling_ip, [ RACK, data[1], next_player ]);
		}
		else {
			send(calling_ip, [ NACK,  data[1] ]);
		}
	 }
	 else if (data[0] == RCOMMAND) {
		D("RCOMMAND(recv): "+data[2]+"\n");
		pid = data[1];
		command = data[2];
		(remote_players[pid])->remote_input(command);
	 }
	 else if (data[0] == RRESPONSE) {
		D("RRESPONSE(recv): "+data[2]+"\n");
		local_obj[data[1]]->remote_output(data[2]);
	 }
	 else if (data[0] == RACK) {
		local_obj[data[1]]->set_transmit(calling_ip, data[1]);
	 }
	 else if (data[0] == NACK) {
		/* failed */
		local_obj[data[1]]->set_transmit(0);
	 }
	 else if (data[0] == RFLUSH) {	/* any use? */
		local_obj[data[1]]->flush_output(data[2]);
	 }
	 else if (data[0] == RPROMPT) {
		local_obj[data[1]]->set_prompt(data[2]);
	 }
	 else if (data[0] == RHANGUP) {
		local_obj[data[1]]->set_transmit(0);
	 }
	 else {
		D("Unknown recv(): "+data[0]+"\n");
	}
	}    
}

show_stats()
{
int i;
	::show_stats();
	write("Local objects (transmitting) -- ");
	DUMP->dump(local_obj);

	write("Remote objects (being receivede) -- ");
	DUMP->dump(remote_players);
}
