/*
 * This is a simple server which records `significant goals'
 * that a player has achieved.  Its initial use (i.e. now) is
 * to provide a uniform interface for the plan inference code;
 * later, it may be useed to keep a history of the world.
 * Talk to a god if you reckon you have something worth notifying
 * the daemon about.
 *
 * Note that quest completions are auto-notified by the player object.
 */

reset() {
    return 1;
    }

/* eg: "gandalf", "QUEST", "desting_newbies_quest"
 *     "dredd",   "PURCHASED", "players/wizname/house/name"
 *     "dredd",   "JOINED", "guild_name"
 *     "dredd",   "ADVANCED", "guild_name, level"
 */

/*
 * At the moment, we just send them to the logger.
 */

event_notify(playername, type, iden) {
    object o = find_player(playername);
    if (!o) return;
    o->track_action("NOTIFY", type+"", iden+"");
    }
