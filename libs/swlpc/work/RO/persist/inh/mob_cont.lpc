/*
 * Mobile containers (e.g. NPCs, backpacks, ..., but not rooms
 * or swords).
 */

inherit "RO/persist/parts/id";
inherit "RO/persist/parts/inventory";
inherit "RO/persist/parts/location";
inherit "RO/persist/inh/auto";

remember_persistence() {
	remember_inventory();
	remember_location();
	}

recover_persistence() {
	locn_start();
	recover_inventory();
	}
