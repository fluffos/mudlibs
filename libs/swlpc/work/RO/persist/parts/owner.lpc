/*
 * owner.c - inherited by a persistent object that can `own'
 * other persistent objects (other than casually, by having
 * them as inventory items).  The corresponding owned objects
 * should inherit `owned.c' from this directory.  An object
 * can have multiple owners.
 *
 * This is used to link persistent objects with controllers (a
 * persistent NPC is owned by the area controller for the room
 * in which it last checkpointed), mail objects with players,
 * characters with players, and players with characters.  It will
 * also eventually be used to link guilds, etc, with players.
 *
 * Experimental.
 */

inherit "RO/persist/parts/check";

array persist_owner_of = [ ];

/*
 * Add an owned object to our list.
 * It is ignored if it does not have a persistent name (because there's
 * no point in saving it).
 */

add_owned_object((object|string) s) {
	if (objectp(s))
		s = name_of(s);
	if (objectp(s))
		return;
	if (index(persist_owner_of, s) >= 0)
		return;
	int x = index(persist_owner_of, 0);
	if (x < 0) {
		x = sizeof(persist_owner_of);
		persist_owner_of += allocate(1 + x);
		}
	persist_owner_of[x] = s;
	catch { s-> add_owner_object(this_object()); };
	return s;
	}

