/*
 * Persistent objects should always be referenced by object name!
 * Especially when saving inventories and lists of people you hate :)
 */

/*
 * If an object has a persistent id, return its name.
 * Otherwise, if the object is uncloned, return its file name.
 * Otherwise, return the object handle - it isn't considered to have
 * a name.
 */

name_of((array|object) s) {
	(int|string) handle;

	if (objectp(s)) {
		handle = persistent_name_of(s);
		if (stringp(handle))
			return handle;
		if (!is_cloned(s))
			return file_name(s);
		return s;
		}
	
	int x = sizeof(s);
	while (x > 0) {
		x--;
		if (objectp(s[x])) {
			handle = persistent_name_of(s[x]);
			if (stringp(handle))
				s[x] = handle;
			else if (!is_cloned(s[x]))
				s[x] = file_name(s[x]);
			}
		}
	return s;
	}

/*
 * This is true if the object has the persistence code,
 * AND has been given a persistent ID (which presumably means
 * it can save or be recreated).  It's used to decide whether
 * or not to ask the general location server to remember
 * which persistent items are in a nonpersistent room's
 * inventory (i.e. the room has a name, so must be a valid location to
 * remember across reboots, but doesn't necessarily maintain its
 * own savefile).  Note that persistent items within non-containers
 * or nonpersistent containers may be lost this way (never loaded,
 * because the inventory was never saved); the item is out of the game
 * until its `usual' creator decides it has expired and recreates or
 * moves it, or until something else references it (at which point it
 * should create, be unable to load into a room, and snap back to its
 * home location).  
 */

persistent_name_of(object o) {
	string handle;
	catch { handle = o->query_persistent_id(); };
	return handle;
	}
