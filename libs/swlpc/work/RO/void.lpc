/*
 * The Void — Shattered World Mudlib (/RO/void).
 * Original SWLPC source preserved as /RO/void_swlpc.lpc.
 */

mapping exits;

void create() {
  exits = ([
    "east": "/room/city/inn",
    "e": "/room/city/inn",
  ]);
}

string query_short() { return "The Void"; }

string query_long() {
  return "Swirling mists surround you... how have you gotten here?\n"
    "There must have been a terrible rendering in reality...\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Obvious exits: east.\n";
}

int id(string str) {
  return str == "void" || str == "here";
}
