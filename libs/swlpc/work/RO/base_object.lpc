/*
 * History:
 *  94???? Llati        created base_object.c
 *  940817 Hunter       cleaned comments up. cleaned show_stats() up.
 *  950110 Hunter       changed show_stats() to return array, not write()
 *  950120 Hunter       add debuglevel support
 *  950809 Gandalf	piffed debug stuff, which inherits from insecure dirs.
 *  950925 Gandalf	renamed the FUCKING STUPID add(), remove(), query() 
 *			fns to add_prop(), remove_prop(), etc.
 *  951025 Hunter	cleaned up array slicing of remove_id(), so that
 * 			there is only one array slice.
 *  951120 Hunter  	split id code into base/id.c. 
 *			split store code into base/storage.c
