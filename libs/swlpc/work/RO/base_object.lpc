inherit "RO/Servers";
inherit "RO/base/id";
inherit "RO/base/storage";
inherit "RO/modules";

reset(arg) 
{
    "RO/base/id"::reset(arg);
    "RO/base/storage"::reset(arg);
}


/* prohibit the object from being saved */
/* NB: driver calls this hook, not LPC - G */

query_no_external_save(obj) 
{
    return query_property("no_save");
}

/*
 * Stats.
 */
array show_stats(arg)
{
    array ret;
    ret = "RO/base/id"::show_stats(arg) + "RO/base/storage"::show_stats(arg);
}

