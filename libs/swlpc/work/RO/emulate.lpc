
/*
        Emulate efuns() in here.
        Efuns() may be overriden with function of the same
        name here too. To access the original driver efun
        use ::efun().

        Only functions defined at the top level (ie in this file)
        get defined as emulated efuns.

        DO NOT EVER EVER DESTRUCT THIS OBJECT.
*/


inherit "RO/nodest";

#include "/RO/emfun/say.lpc"
#include "/RO/emfun/transfer.lpc"
#include "/RO/emfun/input_to.lpc"
#include "/RO/emfun/add_action.lpc"
#include "/RO/emfun/living.lpc"


/*
 * load_object: This one's here because it shits me having to write
 *      catch "name"->load_up_you_stupid_prick();; everywhere.
 *
 * Returns the object pointer, or zero if it didn't load.
 * It's only used in secure, RO at the moment. 
 * G.
 */

(int|object) 
load_object(string s) 
{
    object o = find_object(s);
    if (!o) {
        catch {
	    s->why_the_hell_do_we_write_shit_like_this();
	    o = find_object(s);
	    };
	}
    return o;
}

tell_room((string|object) room, string what) 
{
(int|object) tmpo;
array things;
int i;
        if (stringp(room)) {
		tmpo = load_object(room);
                if (!tmpo)
		    throw ("tell_room() - object "+room+" not found.\n");
                room = tmpo;
        }
        things = contents(room);
        if (!things || sizeof(things) < 1) return;
        for (i = 0; i < sizeof(things); i++) {
                if (things[i] && living(things[i]))
                        tell_object(things[i], what);
        }
    tell_object (room,what);    
}

log_file(string where, string what)
{
	"RO/logger"->log(where, what);
}


tell_object(object ob, string what)
{
    if (query_ip_number(ob))
    {
        ob->catch_output(what);
        /* ob->flush_output(0); -- flush after command is complete */
    }
    else
    {
        ob->catch_tell(what);
    }
}

write(what)
{
    object who = this_player();

    if (!who) throw("Invalid this_player() in write()\n");
    if (stringp(what)) tell_object(who, what);
    else if (objectp(what)) tell_object(who, "OBJ("+file_name(what)+")");
    else if (pointerp(what)) tell_object(who, "<ARRAY>");
    else 
    {
        what = ""+what;
        tell_object(who, what);
    }
}

ctime(int x)
{
    return "modules/misc"->ctime(x);
}

#if 0
function_exists(string func, object ob)
{
    return "modules/disass"->function_exists(func,ob);
}

extract(a,b,c)
{
    return a[b..c];
}
#endif

