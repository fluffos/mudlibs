/*
 * A simplified logon object that is used
 * by connect, etc, to determine how it
 * should create a given player.
 */

#include "/RO/Config.h"
#include "/secure/passwd.h"

string name;
string passswd;
string logon_ob;	/* default (0) should be assumed as secure/body */
int last_login;
int age;
int created;

query_name() {
    return name;
    }

query_logon_ob() {
    return logon_ob;
    }
