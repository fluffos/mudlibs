/*
 * Capability manager for users of other capabilities.
 * These vars should never be dumped to savefiles.
 * Deleted show_stats, deleted throw() - G, sept 95.
 * Should rewrite it to be more array friendly - these
 * might start being used a lot.
 */

/*
 * Our (internal) names for capabilities we have been given
 */

nosave array theircapnames = [];	

/*
 * Capability values (these may be N-use)
 */

nosave array theircaps = [];		

/*
 * store_cap - add a capability to our list, possibly overwriting its
 * old value.
 */

nosave int add_cap(string name, int val) {
    int x = index(theircapnames, name);
    if (x >= 0)
	theircaps[x] = val;
    else {
	theircaps += [ val ];
	theircapnames += [ name ];
	}
    }

/*
 * lookup_cap(name): recover a capability value.
 */

nosave int lookup_cap(string name) {
    int x = index(theircapnames, name);
    if (x < 0)
	return 0;
    return theircaps[x];
    }

/*
 * Delete our record of an externally provided capability.
 * Be sure you don't fuck up between delete_cap and invalidate_cap 
 * (in cap_provider).
 */

nosave delete_cap(string name) {
    int x = index(theircapnames, name);
    if (x >= 0) {
	theircapnames = theircapnames[..x-1] + theircapnames[x+1..];
	theircaps = theircaps[..x-1] + theircaps[x+1..];
	}
    }
