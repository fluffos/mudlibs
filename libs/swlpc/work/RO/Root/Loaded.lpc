/*
 * Loaded - inheritable object used to keep track of the
 * loaded objects in a virtual directory.  Will not save.
 * Currently, a backward compatibility hack.
 */

inherit "RO/Root/Aliased";

/*
 * Add a managed object to the list.  Choose a slot by
 * finding a deleted object (i.e. a null one).
 */

nosave int loaded_object(string name, object obj) {
    return aliased_object(name, obj);
    }

/*
 * retrieve an object, given its full name (this_object must
 * be a prefix of the object name).  Use GetAliasedObject to
 * just get subobjects.
 */

GetVirtualObject(string name) {
    string myname = file_name(this_object());
    if (name == myname)
	return this_object();
    if (name[..sizeof(myname)] != (myname + "/"))
	return 0;
    return GetAliasedObject(name[sizeof(myname) + 1..]);	/* without the slash */
    }

/*
 * Retrieve a directory of the objects known by this object.
 * If you give a pathname, returns only those objects.
 */

GetVirtualLS((int | string) name) {
    string myname = file_name(this_object());
    if ((name == myname) || !name)
	return GetAliasedLS(0);
    if (name[..sizeof(myname)] != (myname + "/"))
	return 0;
    return GetAliasedLS(name[sizeof(myname) + 1..]);
    }
