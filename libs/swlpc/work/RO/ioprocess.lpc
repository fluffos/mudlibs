inherit "RO/Servers";
#include <ansi.h>
#include "/RO/remote/remote_player.h"
#include "windows.h"

#define DEFAULT_PROMPT "> "

/* #define R(X) catch tell_object(find_player("rhys"), X);; */

nosave array output = allocate(30);	/* quick output allocation */
nosave int outfilled = 0;
nosave int last_input = time();
nosave show_prompt = 0;

string prompt = "";

int term_cols = 80;
int term_rows = 24;
int term_wrap = 1;

nosave array redirect = 0;		/* input_to sim stuff */
nosave array receive_host = 0;
nosave array transmit_host = 0;
nosave int remote_pid;

nosave string prefix;
nosave int prefix_len = 0;
nosave int prefix_persist = 1;	/* should prefix survive after next prompt? */

nosave int tab_stop = 8;

nosave array windows;
nosave int top_win_num = 0;
nosave int bottom_win_num = 0;
nosave int num_free_lines = -1;
nosave int curr_output_window = 0;
nosave int curr_input_window = 0;

set_prefix((string | int) pref, int persist)
{
    /* should do remote host stuff :-P */
    /* flush the output, so that setting a prefix half-way through some
    output comes out as expected */
    if (outfilled > 0)
	flush_output();
    prefix = pref;
    if (intp(pref))
	prefix_len = 0;
    else
	/* TODO: should probably account for the possibility of ansi stuff
	in the prefix... */
	prefix_len = sizeof(prefix);
    prefix_persist = persist;
}

query_prefix()
{
    if (prefix_len > 0)
	return prefix;
    else
	return 0;
}

query_prefix_persist() { return prefix_persist; }

/* are we receiving output for a remote site? */
set_receive((int|array) a, int x)
{
    receive_host = a;
    remote_pid = x;
    transmit_host = 0;
}

query_receive_host() { return receive_host; }

/* are we receiving transmitted commands to a remote site? */
set_transmit((int|array) a, int x)
{
    transmit_host = a;
    remote_pid = x;
    receive_host = 0;
}

query_transmit_host() { return transmit_host; }

remote_output(string str)
{
    catch_output(str);
}

set_prompt(p)
{
    if (receive_host)
    {
	"RO/remote/remote_player"->send(receive_host, [ RPROMPT, remote_pid, p ]);
	return;
    }

    if (stringp(p)) prompt = p;
    else prompt = DEFAULT_PROMPT;
}

query_prompt() { return prompt; }

display_prompt()
{
    int x, i, h;

    array ret[10];
    array out;

    x = index(prompt, '%');
    if (x > -1)
    {
        out = explode(prompt, "%");
        ret[0] = out[0];
        if (x > 1) x = 1;
        for (i = x; i < sizeof(out); i++)
        {
            switch (out[i][0])
            {
                case 'h':
                    ret[i] = ""+this_object()->query_hp() + out[i][1..];
                    break;
                case 'H':
                    ret[i] = ""+this_object()->query_max_hp() + out[i][1..];
                    break;
                case 's':
                    ret[i] = ""+this_object()->query_sp() + out[i][1..];
                    break;
                case 'S':
                    ret[i] = ""+this_object()->max_sp() + out[i][1..];
                    break;
                case 'p':
                    ret[i] = ""+((100*this_object()->query_hp())/this_object()->query_max_hp()) + out[i][1..];
                    break;
                case 'P':
                    ret[i] = ""+((100*this_object()->query_sp())/this_object()->max_sp()) + out[i][1..];
                    break;
                case 'c':
                    h = this_object()->query_hp();
                    ret[i] = ""+ cond_colour(h, this_object()->query_max_hp(), h) 
                            + out[i][1..];
                    break;
                case 'C':
                    h = this_object()->query_sp();
                    ret[i] = ""+ cond_colour(h, this_object()->max_sp(), h) + out[i][1..];
                    break;
                case 'd': 
                    ret[i] = " type pwd " + out[i][1..];
                    break;
                default:
                    ret[i] = "%" + out[i];
            }
        }
        return implode(ret, "");
    }
    else return prompt;
}

/* This function returns str with eith red, yellow or green colour codes
   based on what % a is of b */
cond_colour(int a, int b, str) 
{
    return ((100*a/b)>=50)?COLOUR->colour("{G"+str,this_object()):
           ((100*a/b)>=25)?COLOUR->colour("{Y"+str,this_object()):
           COLOUR->colour("{R"+str,this_object());
}

terminate_all_windows()
{
    if (num_free_lines != -1 && sizeof(windows) > 1)
    {
        out_to_term(SET_SCROLL_REGION(0, 0) + MOVE_CURSOR(1, term_rows));
	curr_output_window = 0;
	curr_input_window = 0;
    }
}

query_destruct()
{
    terminate_all_windows();
}

init_windows()
{
    windows =
	({ ({ WIN_MIXED, WIN_FREE, term_rows, 1, term_rows, -1, -1, 1 }) });
    num_free_lines = term_rows;
}

set_term_rcw(int rows, int cols, int wrap)
{
    int delta;
    int win_num;
    string output;

    delta = rows - term_rows;
    if (num_free_lines == -1) init_windows();
    num_free_lines += delta;
    output = SET_SCROLL_REGION(1, rows);
    if (delta < 0)
    {
	output += MOVE_CURSOR(1, windows[0][WINDAT_TOP_LINE]) +
		DELETE_LINE(-delta);
    }
    else
    {
	output += MOVE_CURSOR(1, windows[0][WINDAT_BOTTOM_LINE]) +
		INSERT_LINE(delta);
    }
    for (win_num = bottom_win_num; win_num != -1;
	    win_num = windows[win_num][WINDAT_NEXT_WIN])
    {
	if (win_num > 0)
	    windows[win_num][WINDAT_TOP_LINE] += delta;
	windows[win_num][WINDAT_BOTTOM_LINE] += delta;
    }
    output += SET_SCROLL_REGION(windows[curr_input_window][WINDAT_TOP_LINE],
	    windows[curr_input_window][WINDAT_BOTTOM_LINE]) +
	    MOVE_CURSOR(windows[curr_input_window][WINDAT_CURR_COL],
	    windows[curr_input_window][WINDAT_TOP_LINE]);
    out_to_term(output);
    term_rows = rows;
    term_cols = cols;
    term_wrap = wrap;
}

query_term_wrap() { return term_wrap; }

query_term_cols() { return term_cols; }

query_term_rows() { return term_rows; }

/*
    type = WIN_INPUT or WIN_OUTPUT: the type of window being created
    where = WIN_TOP, WIN_UP, WIN_DOWN, WIN_BOTTOM: where, vertically, window is
    num_lines = number of lines the window should be
*/
int create_window(int type, int where, int num_lines)
{
    array new_win_data;
    int new_win_num;
    int win_num, prev_win_num;
    int top_line;
    string output;

    if (num_free_lines == -1) init_windows();
    if ((type != WIN_INPUT && type != WIN_OUTPUT) ||
	    (where != WIN_TOP && where != WIN_UP && where != WIN_DOWN &&
	    where != WIN_BOTTOM) || num_lines <= 0)
	return -1;
    if (num_lines > num_free_lines)
	return -2;
    new_win_data = allocate(WINDAT_SIZE);
    new_win_data[WINDAT_TYPE] = type;
    new_win_data[WINDAT_POSITION] = where;
    num_free_lines -= num_lines;
    new_win_data[WINDAT_HEIGHT] = num_lines;
    new_win_data[WINDAT_CURR_COL] = 1;
    /* locate a space to store the new window.  Index is new window number */
    new_win_num = index(windows, 0);
    if (new_win_num < 0)
    {
	new_win_num = sizeof(windows);
	windows += ({ new_win_data });
    }
    else
	windows[new_win_num] = new_win_data;
    /* insert new window into window lists */
    if (where == WIN_TOP || where == WIN_UP)
	win_num = top_win_num;
    else
	win_num = bottom_win_num;
    prev_win_num = -1;
    while (windows[win_num][WINDAT_POSITION] <= where)
    {
	prev_win_num = win_num;
	win_num = windows[win_num][WINDAT_NEXT_WIN];
    }
    new_win_data[WINDAT_PREV_WIN] = prev_win_num;
    new_win_data[WINDAT_NEXT_WIN] = win_num;
    if (prev_win_num == -1)	/* first of its position */
    {
	if (where == WIN_TOP || where == WIN_UP)
	{
	    top_line = 1;
	    top_win_num = new_win_num;
	}
	else
	{
	    top_line = term_rows - num_lines + 1;
	    bottom_win_num = new_win_num;
	}
    }
    else
    {
	windows[prev_win_num][WINDAT_NEXT_WIN] = new_win_num;
	if (where == WIN_TOP || where == WIN_UP)
	    top_line = windows[prev_win_num][WINDAT_BOTTOM_LINE] + 1;
	else
	    top_line = windows[prev_win_num][WINDAT_TOP_LINE] - num_lines;
    }
    new_win_data[WINDAT_TOP_LINE] = top_line;
    new_win_data[WINDAT_BOTTOM_LINE] = top_line + num_lines - 1;
    /* create actual space on the screen for the new window */
    output = SET_SCROLL_REGION(1, term_rows) +
	    /* delete lines from the top of win 0 downwards */
	    MOVE_CURSOR(1, windows[0][WINDAT_TOP_LINE]) +
	    DELETE_LINE(num_lines) +
	    /* insert blank lines at the top of the new window */
	    MOVE_CURSOR(1, windows[new_win_num][WINDAT_TOP_LINE]) +
	    INSERT_LINE(num_lines);
    for (; win_num != -1; win_num = windows[win_num][WINDAT_NEXT_WIN])
	if (where == WIN_TOP || where == WIN_UP)
	{
	    windows[win_num][WINDAT_TOP_LINE] += num_lines;
	    if (win_num > 0)
		windows[win_num][WINDAT_BOTTOM_LINE] += num_lines;
	}
	else
	{
	    if (win_num > 0)
		windows[win_num][WINDAT_TOP_LINE] -= num_lines;
	    windows[win_num][WINDAT_BOTTOM_LINE] -= num_lines;
	}
    /* change back to the input window */
    output += SET_SCROLL_REGION(windows[curr_input_window][WINDAT_TOP_LINE],
	    windows[curr_input_window][WINDAT_BOTTOM_LINE]) +
	    MOVE_CURSOR(windows[curr_input_window][WINDAT_CURR_COL],
	    windows[curr_input_window][WINDAT_BOTTOM_LINE]);
    tell_object(this_object(), output);
    return new_win_num;
}

/* remove window win_num from the screen. */
int delete_window(int win_num)
{
    int where, num_lines;
    int prev, next;
    int win;
    string output;

    if (num_free_lines == -1) init_windows();
    if (win_num <= 0 || win_num >= sizeof(windows) || windows[win_num] == 0)
	return 0;
    where = windows[win_num][WINDAT_POSITION];
    num_lines = windows[win_num][WINDAT_HEIGHT];
    prev = windows[win_num][WINDAT_PREV_WIN];
    next = windows[win_num][WINDAT_NEXT_WIN];
    windows[next][WINDAT_PREV_WIN] = prev;
    if (prev != -1)
	windows[prev][WINDAT_NEXT_WIN] = next;
    else if (where == WIN_TOP || where == WIN_UP)
	top_win_num = next;
    else
	bottom_win_num = next;
    /* delete window from the screen */
    output = SET_SCROLL_REGION(1, term_rows) +
	    /* delete the window */
	    MOVE_CURSOR(1, windows[win_num][WINDAT_TOP_LINE]) +
	    DELETE_LINE(num_lines);
    for (win = next; win != -1; win = windows[win][WINDAT_NEXT_WIN])
    {
	if (where == WIN_TOP || where == WIN_UP)
	{
	    windows[win][WINDAT_TOP_LINE] -= num_lines;
	    if (win > 0)
		windows[win][WINDAT_BOTTOM_LINE] -= num_lines;
	}
	else
	{
	    if (win > 0)
		windows[win][WINDAT_TOP_LINE] += num_lines;
	    windows[win][WINDAT_BOTTOM_LINE] += num_lines;
	}
    }
    if (win_num == curr_input_window)
	set_current_input_window(0);
    if (win_num == curr_output_window)
	set_current_output_window(0);
    /* insert blank lines at the top of window 0 */
    output += MOVE_CURSOR(1, windows[0][WINDAT_TOP_LINE]) +
	    INSERT_LINE(num_lines) +
	    /* change back to the input window */
	    SET_SCROLL_REGION(windows[curr_input_window][WINDAT_TOP_LINE],
	    windows[curr_input_window][WINDAT_BOTTOM_LINE]) +
	    MOVE_CURSOR(windows[curr_input_window][WINDAT_CURR_COL],
	    windows[curr_input_window][WINDAT_BOTTOM_LINE]);
    tell_object(this_object(), output);
    windows[win_num] = 0;
    return 1;
}

array query_input_windows()
{
    array result = ({ curr_input_window });
    int pos;

    if (num_free_lines == -1) init_windows();
    for (pos = 0; pos < sizeof(windows); pos++)
	if (windows[pos] != 0)
	    if (pos != curr_input_window &&
		    windows[pos][WINDAT_TYPE] != WIN_OUTPUT)
		result += ({ pos });
    return result;
}

array query_output_windows()
{
    array result = ({ curr_output_window });
    int pos;

    if (num_free_lines == -1) init_windows();
    for (pos = 0; pos < sizeof(windows); pos++)
	if (windows[pos] != 0)
	    if (pos != curr_output_window &&
		    windows[pos][WINDAT_TYPE] != WIN_INPUT)
		result += ({ pos });
    return result;
}

array query_window_data(int win_num)
{
    if (num_free_lines == -1) init_windows();
    if (win_num < 0 || win_num >= sizeof(windows) || windows[win_num] == 0)
	return 0;
    /* make sure I'm only giving out a copy of the window data */
    return windows[win_num] + ({ });
}

int query_current_input_window() { return curr_input_window; }

int query_current_output_window() { return curr_output_window; }

int query_num_free_lines()
{
    if (num_free_lines == -1) init_windows();
    return num_free_lines;
}

int query_output_height()
{
    if (num_free_lines == -1) init_windows();
    return windows[curr_output_window][WINDAT_BOTTOM_LINE] -
	    windows[curr_output_window][WINDAT_TOP_LINE] + 1;
}

string erase_window(int win_num)
{
    int line;
    string result;

    if (num_free_lines == -1) init_windows();
    if (win_num < 0 || win_num >= sizeof(windows) || windows[win_num] == 0)
	return "";
    /* do it this way, rather than using DELETE_LINE(x), so the scrolling */
    /* region doesn't matter */
    result = MOVE_CURSOR(1, windows[win_num][WINDAT_TOP_LINE]) + ERASE_LINE;
    for (line = windows[win_num][WINDAT_TOP_LINE] + 1;
	    line <= windows[win_num][WINDAT_BOTTOM_LINE]; line++)
	result += CURSOR_DOWN(1) + ERASE_LINE;
    result += MOVE_CURSOR(windows[curr_output_window][WINDAT_CURR_COL],
	    windows[curr_output_window][WINDAT_BOTTOM_LINE]);
    return result;
}

set_current_input_window(int win_num)
{
    if (num_free_lines == -1) init_windows();
    if (win_num < 0 || win_num >= sizeof(windows) || windows[win_num] == 0)
	return 0;
    if (windows[win_num][WINDAT_TYPE] == WIN_OUTPUT) return -1;
    if (outfilled > 0) flush_output();
    curr_input_window = win_num;
    out_to_term(SET_SCROLL_REGION(windows[win_num][WINDAT_TOP_LINE],
	    windows[win_num][WINDAT_BOTTOM_LINE]));
    windows[win_num][WINDAT_CURR_COL] = 1;
    show_prompt = 1;
    return 1;
}

int set_current_output_window(int win_num)
{
    if (num_free_lines == -1) init_windows();
    if (win_num < 0 || win_num >= sizeof(windows) || windows[win_num] == 0)
	return 0;
    if (windows[win_num][WINDAT_TYPE] == WIN_INPUT) return -1;
    if (outfilled > 0) flush_output();
    curr_output_window = win_num;
    return 1;
}

/* does no checking for vailidity of win_num - therefore nosave */
nosave change_to_output_win(int win_num)
{
    return SAVE_CURSOR +
	    SET_SCROLL_REGION(windows[win_num][WINDAT_TOP_LINE],
	    windows[win_num][WINDAT_BOTTOM_LINE]) +
	    MOVE_CURSOR(windows[win_num][WINDAT_CURR_COL],
	    windows[win_num][WINDAT_BOTTOM_LINE]);
}

nosave return_to_input_win()
{
    return SET_SCROLL_REGION(windows[curr_input_window][WINDAT_TOP_LINE],
	    windows[curr_input_window][WINDAT_BOTTOM_LINE]) + RESTORE_CURSOR;
}

/*
 * Called by write(), etc.
 */
catch_output(str)
{
    if (receive_host)
    {
	    "RO/remote/remote_player"->send(receive_host, ({ RRESPONSE, 
		remote_pid, str }));
	    return;
    }
    if (!intp(outfilled)) outfilled = 0;
    if (!pointerp(output))
    {
	    output = allocate(30);
	    outfilled = 0;
    }
    if (!stringp(str)) str = "";
    if (outfilled >= sizeof(output)) flush_output();
    output[outfilled] = str;
    outfilled++;
}

/*
 * Flush it in 5K chunks, coz we could crash otherwise.
 * Called by driver (when no commands in inbuf and time
 * has passed).  Flush_output should always flush _all_
 * output.
 */

flush_output()
{
	/* should send off "remote" flushes! */
    string s;
    int x;
    int upto;

    if (num_free_lines == -1) init_windows();
    if (outfilled)
    {
	if (receive_host)
	{
	    "RO/remote/remote_player"->send(receive_host,
		    ({RFLUSH, remote_pid, show_prompt}));
	    show_prompt = 0;
	    return;
	}

	if (!pointerp(output)) return;
	if (!intp(outfilled)) outfilled = 0;

	s = implode(output[..outfilled - 1], "");
	if (!stringp(s)) s = "";

	if (curr_input_window != curr_output_window)
	    s = change_to_output_win(curr_output_window) + s +
		    return_to_input_win();

	if (term_wrap) s = wrap_text(s, curr_output_window);
	else if (prefix_len) s = prefix + s;
	
	x = sizeof(s);
	upto = 0;
	outfilled = 0;
	while (upto < x)
	{
	    out_to_term(s[upto..upto+5000]);
	    upto += 5001;
	}

	output = allocate(30);	/* piff old strings */
	if (redirect || transmit_host) return;
	if (curr_input_window == curr_output_window) show_prompt = 1;
    }

    /* Jenna Jun 01 */
    if (this_object()->query_caution()) show_prompt = 0;    

    if (show_prompt)
    {
	show_prompt = 0;
	if (curr_input_window == curr_output_window)
	{
	    out_to_term(display_prompt());
	    windows[curr_input_window][WINDAT_CURR_COL] = 1;
	    /* prompt might contain esc sequences */
	    wrap_text(display_prompt(), curr_input_window);
	}
	else
	{
	    out_to_term(MOVE_CURSOR(1,
		    windows[curr_input_window][WINDAT_TOP_LINE]) +
		    DELETE_LINE(windows[curr_input_window][WINDAT_HEIGHT]) +
		    display_prompt());
	    windows[curr_input_window][WINDAT_CURR_COL] = 1;
	    /* prompt might contain esc sequences */
	    wrap_text(display_prompt(), curr_input_window);
	}
	if (prefix_len && !prefix_persist) prefix_len = 0;

    }
}

string wrap_text(string s, int win_num)
{
    int current_col;
    int cr_pos, tab_pos, esc_pos;
    int s_start, s_len;
    int s_col;
    int raw_end;
    int extra_chars;
    int pos;
    int prefix_pos = -2;
    string curr_char;
    string result = "";

    if (num_free_lines == -1) init_windows();
    if (!stringp(s))
	s = "";
    s_len = sizeof(s);
    s_start = 0;
    current_col = windows[win_num][WINDAT_CURR_COL] - 1;
    while (s_start <= s_len)
    {
	/* Ok - we're adding another single line of output to 'result'. */
	raw_end = s_start + term_cols - current_col;
	/* raw_end is the point in the string the edge of the screen will
	 * be hit, as long as 's' just contains normal printable characters
	 * up to that point.  Can be > s_len. */
	/* However, there might be \n, tab or escape somewhere on the line */
	cr_pos = index(s, "\n", s_start);
	if (cr_pos < 0)
	    cr_pos = s_len + 1;
	tab_pos = index(s, "\t", s_start);
	if (tab_pos < 0)
	    tab_pos = s_len + 2;
	esc_pos = index(s, "", s_start);
	if (esc_pos < 0)
	    esc_pos = s_len + 2;
	/* extra_chars is the effective number of extra characters that
	 * tabs (+ve) and escapes (-ve, since they're invisible) insert
	 * into the output */
	extra_chars = 0;
	if (current_col == 0 && prefix_len)
	{
	    if (esc_pos > s_start)
		prefix_pos = s_start;
	    else
		prefix_pos = -1;
	    extra_chars = prefix_len;
	}
	s_col = current_col - s_start;
	while ((tab_pos < raw_end - extra_chars && tab_pos < cr_pos) ||
		(esc_pos < raw_end - extra_chars && esc_pos < cr_pos))
	{
	    if (tab_pos < esc_pos)
	    {
		/* a tab introduces space on the screen, equivalent to
		0-7 extra characters */
		extra_chars += tab_stop -
			(s_col + tab_pos + extra_chars)%tab_stop - 1;
		tab_pos = index(s, "\t", tab_pos + 1);
		if (tab_pos < 0)
		    tab_pos = s_len + 2;
	    }
	    else
	    {
		/* escapes are invisible, and therefore count as a
		negative number of extra characters */
		extra_chars -= 2;
		pos = esc_pos + 2;
		/* need a terminal db that can return then length of a term
		 * escape, and whether it does anything special (like go to
		 * a certain column.)
		 * For now, use the general rule: an ANSI escape is ESC
		 * plus 1 char, unless that char is [, in which case it
		 * goes until it finds a single letter.
		*/
		if (s[esc_pos + 1..esc_pos + 1] == "[")
		{
		    curr_char = "[";
		    while (pos < s_len && curr_char < "a" || curr_char > "z")
		    {
			curr_char = lower_case(s[pos..pos]);
			pos++;
			extra_chars--;
		    }
		}
		esc_pos = index(s, "", pos);
		if (esc_pos < 0)
		    esc_pos = s_len + 2;
		if (prefix_pos == -1 && esc_pos > pos)
		    prefix_pos = pos;
	    }
	}
	if (prefix_pos == -1 || prefix_pos >= s_len)
	{
	    /* oops - we counted the length of a prefix in the length of
	     * this line, but it doesn't actually include a prefix */
	    extra_chars -= prefix_len;
	    prefix_pos = -1;
	}
	raw_end -= extra_chars;
	if ((!term_wrap || cr_pos <= raw_end) && cr_pos < s_len)
	{
	    if (prefix_pos >= 0)
		result += s[s_start..prefix_pos - 1] + prefix +
			s[prefix_pos..cr_pos];
	    else
		result += s[s_start..cr_pos];
	    s_start = cr_pos + 1;
	    current_col = 0;
	}
	else if (!term_wrap || raw_end >= s_len)
	{
	    if (prefix_pos >= 0 && prefix_pos < s_len)
		result += s[s_start..prefix_pos - 1] + prefix + s[prefix_pos..];
	    else
		result += s[s_start..];
	    current_col += s_len - s_start + extra_chars;
	    s_start = s_len + 1;
	}
	else
	{
	    curr_char = "x";
	    for (pos = raw_end; curr_char != " " && curr_char != "\t" &&
		    pos >= s_start; pos--)
		curr_char = s[pos..pos];
	    pos++;
	    if (pos == s_start)
	    {
		if (prefix_pos >= 0)
		    result += s[s_start..prefix_pos - 1] + prefix +
			    s[prefix_pos..raw_end] + "\n";
		else
		    result += s[s_start..raw_end] + "\n";
		s_start = raw_end + 1;
	    }
	    else
	    {
		if (prefix_pos >= 0)
		    result += s[s_start..prefix_pos - 1] + prefix +
			    s[prefix_pos..pos - 1] + "\n";
		else
		    result += s[s_start..pos - 1] + "\n";
		s_start = pos + 1;
	    }
	    while (s_start < s_len && (s[s_start..s_start] == " " ||
		    s[s_start..s_start] == "\t"))
		s_start++;
	    current_col = 0;
	}
    }
    windows[win_num][WINDAT_CURR_COL] = current_col + 1;
    return result;
}

/*
 * Called before any actions are processed (passed the input).
 */

redirect_input(object obj, string func, int echo)
{
    // out_to_term("redirect_input: " + func + "\n");
	redirect = [ obj, func, echo ];
}

clear_redirect()
{
    redirect = 0;
}

catch_input(s) 
{
    array tmp;
    int ret;
    object oldTP = this_player();
    string oldverb;
    
    if (oldTP) oldverb = query_verb();

    // out_to_term("catch_input: " + file_name(this_object()) + ": " + s + "\n");
    set_this_player(this_object());
    if (num_free_lines == -1) init_windows();
    last_input = time();
    if (curr_input_window != curr_output_window)
	catch_output(display_prompt() + s + "\n");
    windows[curr_input_window][WINDAT_CURR_COL] = 1;
    show_prompt = 1;
    /* transmission must be first cause they might be in input_to() elsewhere */
    if (transmit_host)	
    {
	    "RO/remote/remote_player"->send(transmit_host, ({ RCOMMAND, 
						    remote_pid, s}) );
        set_this_player(oldTP);
	    return 1;
    }
    else if (redirect && pointerp(redirect)) 
    {
	    /* replace the old input_to() shit */
	    tmp = redirect;
	    redirect = 0;
	    if (tmp[0] && tmp[1] && (tmp[0])->(tmp[1])(s)) 
        {
            set_this_player(oldTP);
            return 1;
        }
        set_this_player(this_object());
    }

    // out_to_term("catch_input: handle_action\n");
    ret = this_object()->handle_action(s);
    set_this_player(oldTP);
    return ret;
}

/*
 * Not unless you're using capabilities.  Call @dredd remote_input "dest @dredd"
 * (yes, it worked on me).
 * Now Ifdef'd out - "nosave" doesnt seem to do the right thing
 * in inherited objects.
 */

#if 0

nosave remote_input(str) {
/*	D("remote_input "+str+"\n"); */
  	last_input = time();
	current_col = 0;	/* he just pressed return */
	/* possibility of nested transmission? bad probably */
	if (!catch_input(str)) {	 
		if (str != "" && !command(str)) {
			catch_output("What are you babbling about?\n");
		}
		show_prompt = 1;
  		flush_output();
		out_to_term(display_prompt());
	}
	else {
		flush_output();
	}
	return 0;
}

#endif


/* 
 * Returns how many seconds have pasted since we received some input 
 */
query_idle()
{
    return time() - last_input ;
}
