
/*
	Start a player calling remotely.
	
	- Can either start as an arbitrary monster
	  or as a player.
*/

#include "Servers.h"
#include "security.h"

array souls = ({
	"obj/souls/communicate",
	"obj/souls/perception",
	"obj/souls/emote",
	"obj/souls/support",
	"obj/souls/state"
});

object
start(a, pid, info)
{
object o;
int i;
	if (info[0] == "player") {
		write_file("open/tmp_player.o", info[1]);
		o = clone_object("secure/body");
		restore_object("open/tmp_player", o);
		/* should check for multiple names! */
		rename_object(o, "R/"+o->query_name());
		set_uid_me(o, GOD+1, o->query_name());
		o->set_receive(a, pid);
		o->start_noninteractive();

		move_object(o, "room/city/inn");
		return o;
	}
	else {
		o = MONSTERER->make(info[0], info[1], "male");	
		o->set_receive(a, pid);
		for (i =0; i  < sizeof(souls); i++)
			move_object(clone_object(souls[i]), o);


		move_object(o, "room/city/inn");
		return o;
	}
}
