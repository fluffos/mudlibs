/*
        In game light - to replace the stupid set_light() efun,
        and ridiculous game driver support!

        Other support includes
        * init() in room.c
        * exit() in room.c
        * get() & drop() in the handle soul.
        
        Dredd
*/
#include "Servers.h"

nosave int light;       /* the light level of this object */

add_light(int x)
{
object env = environment();
        light += x;
        if (env) env->add_light(x);     
        /* notice this affects the light level of the object it is
                within */
        return query_total_light();
}

query_light() {  return light; }

query_total_light()
{ 
object e;
        e = environment();
        if (!e) return light;
        while (environment(e)) e = environment(e);
        return e->query_light();
}

#ifdef NO_SET_LIGHT
set_light(int x)
{
        if (!x) return query_total_light();
        return add_light(x);
}
#endif

