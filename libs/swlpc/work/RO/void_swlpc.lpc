/*
 * The Void
 * Shattered World Mudlib
 *
 * This room is used as a place to be droped into, when all else fails.
 * It *must* load.
 */

inherit "room/room"; // Jenna Sep 00 - required for transfer(ob,"RO/void");

reset(arg)
{
	set_short("The Void");
	set_long("Swirling mists surround you... how have you gotten "+
	    "here? There must have been a terrible rendering in reality...\n");
	set_dest_dir ( [ "room/city/endo", "endo" ] );
	set_light(1);
	set_outdoors(0);
    call_out("clean_up", 60);
    add_property("no_teleport");
    return;
}

clean_up() 
{
    array obs;
    int i;

    call_out("clean_up", 600);
    obs = contents(this_object());
    i = sizeof (obs);
    /* Clear everything that's not a player out of the void */
    while (i--) {
        /* Don't destruct players.  It makes them mad. :)  So? */
        if (!obs[i]->is_player()) {
            destruct(obs[i]);
        }
    }
}


