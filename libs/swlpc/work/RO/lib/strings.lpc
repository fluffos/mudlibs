inherit "RO/Servers";
/*
 * String functions
 */
 
 
/* function  : string_replace
 * author    : Hunter of Shattered Worlds aka Aaron Wigley
 * arguments : original text, find string, replace string
 * return    : new text
 * purpose   : does a textual find and replace on the entire string
 */ 
string string_replace(string text, string find, string replace) {
int pos, lastpos;
	if (!text || !find || !replace || !stringp(text) || !stringp(find) || 
		!stringp(replace)) return 0;
	lastpos = 0;
	while ( (pos = index(text, find, lastpos)) != -1) {
		text = text[..pos-1] + replace + 
			text[pos+sizeof(find)..];
/* Modified by Calthron.  18/4/92. */
		lastpos = pos + sizeof(replace);
	}
	return text;
}

/* function  : split_string 
 * author    : Hunter of shattered worlds aka Aaron Wigley 
 * arguments : single string, optional integer, optional delimiter
 * return    : array of strings - no string is greater than 80 char default, or
 *      the second arg 
 */
array split_string(string str, int len, delimt) 
{
int pos;
string outtext;
array ret;
    if (!str) 
	return ({ "" });
    ret = ({});
    if (!delimt)
	delimt = " ";
    if (!intp(len) || len < -1) 
	len = 80;
    while (sizeof(str) > len ) 
    {
	pos = index(str, delimt, len);
	if (pos == -1) 
	    break; 
	outtext = str[0..pos];
	ret += ({outtext});
	str = str[pos+1..];
    }
    ret += ({ str });
    return ret;
}

/* function  : strip_string 
 * author    : Hunter of shattered worlds aka Aaron Wigley 
 * arguments : 1:string (original text) 2:string to strip out
 * return    : string, the original text with all arg2 strings stripped out 
 */
string strip_string(string text, string omit) {
int i, ic;
	if (!omit || sizeof(omit) == 0) return text;
	while (((i = index(text, omit)) >=0) && ic++ < 50)
		text = text[..i-1]+text[i+sizeof(omit)..];
	return text;
}

/* function  : strip_whitespace
 * author    : Hunter of Shattered Worlds
 * argument  : single string to be stripped of preceeding and following 
 *     whitespace	
 * return    : stripped string
 */
string strip_whitespace(string text) {
int i, j;
	/* strip preceeding whitespace */
	if (!stringp(text)) return;
	if (sizeof(text) == 0)
		return "";
	i = 0;
	while (text[i] <= 32 && i <= sizeof(text))
		i ++;
	j = sizeof(text)-1;
	while (text[j] <= 32 && j >= 0)
		j --;	
	return text[i..j];
}

string format_string(string text,array frmt)
/*
 * string text, array frmt ({ "a", "aaron" ,.. })
 * etc. 
 * eg. format_string("$w causes $n to appear in a puff of smoke",
 *		({ "w", "Hunter", "n", "<object's name>" }) )
 *	== "Hunter causes <object's name> to appear in a puff of smoke"
 *
 */
{
int i;
	for (i = 0; i < sizeof(frmt); i += 2)	
		text = string_replace(text, "$"+frmt[i], frmt[i+1]);
	return text;
}

/*
	Strips - strip the 's' or 'es' from a word.
	Dredd 1992.
	return: the string stripped of trailing s's etc. 
*/

string strips(string str)
{
int x;

    if (!str) return;
    if (str[sizeof(str) -1] == 's') {
	x = 2;
	/* if (str[strlen(str) - 2] == 'e') x = 3; */
	str = str[..(strlen(str) - x)];
	}
    return str;
}

int is_consonant(string ch)
{
	ch = lower_case(ch);
	return (is_alpha(ch) && index(({ "a","e","i","o","u"}), ch ) == -1);
}

int is_alpha(string ch)
{
	return (ch >= "A" && ch <= "Z") || (ch >= "a" && ch <= "z");
}

int is_vowel(string ch)
{
	return (!is_consonant(ch));
}

int is_numeric(string ch)
{
    return (ch >= "0" && ch <= "9");
}

is_upper(string str)
{
    if (!str || str == "") return 0;
    return (str >= "A" && str <= "Z"); 
}

indefinite(string str)
{
    if (is_vowel(str[..0]))
        return "an";
    return "a";
}
 
int all_capitals(string str)
{
    int i;
    int a = "a"[0];
    int z = "z"[0];

    for (i = 0; i < sizeof(str); i ++)
	if (str[i] >= a && str[i] <= z)
		return 0;
    return 1;
}

// Jenna Sep 00
// Turns "Hello there!" into "HELLO THERE!"
capitalize_all(string arg)
{
    int i;
    string tmp;

    string ret = "";
    for (i = 0; i < sizeof(arg); i++)
        ret += capitalize(arg[i..i]);
    return ret;
}

cap_words(string str)
{
    array tmp = explode(str, " ");
    return implode(cap_array(tmp), " ");
}

/* function   : string_count
 * arguments  : string - searchee, string - searched value
 * return     : in
 *   returns the munber of occurances of the string in the substring
 */
int string_count(string who, string what)
{
int count = 0; 
int lastpos = 0;
int i;
	while ((i = index(who, what, lastpos)) != -1)
	{
		count = count +1;
		lastpos =  i + sizeof(what);
	}
	return count;
}
  
/*
 * Refill - format to (more than) 72 cols.  To keep dredd happy.
 * Replace newlines by spaces, then insert newlines at the first space
 * after each 72 chars.  Tabs are assumed to start a new line (ergh -
 * so it's cheat formatting, but faster than the rewrite we'd otherwise
 * have to do).
 */

string refill(string str) {
    string nstr = "";
    int x;
    int upto = 0;

    str = implode(explode(str, "\n"), " ");
    str = implode(explode(str, "\t"), "\n\t"); /* so I'm in a hurry :) */

    while (1) {
	if ((x = index(str, "\n", upto)) >= 0 && (x < upto + 72)) {
	    nstr = nstr + str[upto..x];
	    upto = x+1;
	    }
	else if ((x = index(str, " ", upto + 72)) > 0) {
	    nstr = nstr + str[upto..x-1] + "\n";
	    upto = x + 1;
	} else {
	    nstr = nstr + str[upto..] + "\n";
	    break;
	    }
	}

    return nstr;
}


/* Function: itoa(num)
 * Turns 1234567 into "1,234,567", etc.
 *
 * This is probably horribly inefficent so if you ever find a professionally
 * written version of this, don't show me it.
 *
 *      Jenna, May 95
 */


itoa(int number) {
	int i, tmp, flag;
	string num;

	if (number < 0) {
		number *= -1;
		flag = 1;
		}
	if (number > 999999999) 
		return number;
	for (i = 3; IMATH->exp(10,i) <= number;) 
		i += 3;
	for (i -= 3; i >= 0; i -= 3) {
		tmp = number / IMATH->exp(10, i);
		if (num && tmp < 100) {
			num += "0";
			if (tmp < 10)
				num += "0";
			}
		if (!num)
			num = (flag) ? "-" : "";
		num += "" + tmp;
		if (i > 0) {
			num += ",";
			number -= tmp * IMATH->exp(10,i);
			}
		}
	return num;
	}

/* Function: array2string(a)
 * Arg: array
 * Returns: string
 *
 * Turns ({"one","two","three","four"}) into "one, two three and four"
 *
 *       Jenna, June 99
 */

array2string(array a) {
        string ret = "";

        if (!sizeof(a))
		return "";
        if (sizeof(a) == 1) 
		return a[0];
        ret = implode(a[..(sizeof(a) - 2)], ", ") +
                " and " + a[sizeof(a) - 1];
        return ret;
        }


/* Function: marray2string(a)
 * Arg: mixed array (can be string, int or both)
 * Returns: string
 *
 * array2string is more efficient, so use it if you can
 *  
 * Turns ({1,"two",3,"four"}) into "1, two, 3 and four"
 *
 *       Greebo, June 99
 */
marray2string(array a) {
        string ret = "";
        int i;

        if (!sizeof(a))
                return "";
        if (sizeof(a) == 1) {
                ret += a[0];
        }
        else {
                for (i=0; i != (sizeof(a)-2); i++) {
                        ret += a[i] + ", ";
                }
                ret += a[i] + " and " + a[i+1];
        }
        return ret;
}


/* Function: cap_array(a)
 * Arg: array
 * Returns: array
 *
 * Turns ({"one","two","three"}) into ({"One","Two","Three"})
 *
 *       Jenna, June 99
 */

cap_array(array a) {
        int i;

        array ret = allocate(sizeof(a));
        for (i = 0; i < sizeof(a); i++)
                ret[i] = capitalize(a[i]);
        return ret;
        }


string spaces = "                                                          "+
"                                                                           "+
"                                                                           ";

indent( string str, int first_indent, int rest_indent, int width )
/* 'str' : original string (w/o newlines)
 * 'first_indent' : how many spaces the first line should be indented.
 * 'rest_indent' : how many spaces the rest of the lines should be
 *        indented.
 * 'width' : the total maximum width of any line (including the
 *        indented spaces.
 * Returns : a single string, with newlines, taken from
 *        the 'str' argument, word-wrapped and indented according
 *        to the other arguments.
 */
{
    int pos,bite_size,line_num,size,wrap_point,i,last_i;
    string line,tab;
    array ret;

    if(width == 0) width = 75;
    if(width <= first_indent || width <= rest_indent
        || first_indent < 0 || rest_indent < 0 )
        throw("Invalid argument in indent");


   str = strip_string(str,"\n");
    pos = 0; line_num = 1;
    line = ""; ret = ({ });
    size = sizeof(str);

    while( pos < size )
    {
        if( line_num == 1 )
        {
            tab = spaces[..(first_indent-1)];
            bite_size = width - first_indent;
            wrap_point = width - (bite_size/3);
        }
        else if( line_num == 2 )
        {
            tab = spaces[..(rest_indent-1)];
            bite_size = width - rest_indent;
            wrap_point = width - (bite_size/3);
        }

        line = str[pos..(pos+bite_size-1)];

        i = bite_size - 1;
        if( (pos+i) < size )
            while( (i>=wrap_point) && (line[i] != ' ') )
                i--;
        if( line[i] != ' ' ) i = bite_size - 1;

        line = line[..i];
        ret += ({ tab + line });
        line_num++;

        pos = pos + i + 1;
    }

    return implode(ret,"\n"); /* you add your own final newline. */
}

string
indent_message( string prefix, string text )
/* a quick and easy indenting function.  returns
 * the prefix + text, with subsequent lines of the text indented
 * to the prefix's length
 * note: there really shouldn't be any newlines in the prefix or text.
 */
{
    string ret = prefix + text;
    int prefix_length = sizeof(prefix);

    ret = indent( ret, 0, prefix_length, 70 );

    return ret;
}


/*
 * Given a list of fragments - attempts to match them to 
 * the head (start) of a given string. Returns the rest that
 * doesn't match or 0 on failure.
 */
string
match_head(string instr, array matchfrags)
{
    int i, l, il;

    for (i = 0; i < sizeof(matchfrags); i++)
    {
        l = strlen(matchfrags[i]);
        if (instr[0..l-1] == matchfrags[i])
        {
            return instr[l..];
        }
    }
    return 0;
}

/*
 * split_first
 * Splits at the first given string match
 * Returns an array of the two matching parts; otherwise 0
 */

array split_first(string instr, string match)
{
    int i, l;
    array ret;

    i = index(instr, match);
    if (i == -1) return 0;

    l = sizeof(match);
    ret = [ instr[0..i-1], instr[i+l..] ];
    return ret;
}

/*
 * split_around
 * Splits around the first given instance of an array of possible matches, 
 * returns an 2 element array of matched stuff [ before, after ] or 0
 */

array split_around(string instr, array match)
{
    int i, l;
    array ret;

    for (i = 0; i < sizeof(match); i++)
    {
        ret = split_first(instr, match[i]);
        if (ret) return ret;
    }

    return 0; 
}

/*
 * Name: split_explode
 * Purpose: Explodes around a string possible char matches
 * Returns: an array of elements
 */

array split_explode(string instr, string match)
{
    int m, i, l = 0;
    array ret = [];

    for (i = 0; i < sizeof(instr); i++)
    {
        if (index(match, instr[i]) != -1)
        {
            ret = ret  + [ instr[l..i-1] ];
            l = i+1;
        }
    }
    ret = ret + [ instr[l..] ];

    return ret; 
}
