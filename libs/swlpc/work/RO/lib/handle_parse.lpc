
inherit "RO/Servers";

/*
	Parses strings players type.
	Returns a an array containing 2 arrays:
	0 - stuff that is here.
	1 - object pointers that are here.
	2 - stuff that is not here!
	3 - stuff that fails the test ob->func == not!

	returns 0 for failure.

	Dredd 1992 - Shattered World Lpmud.

	str - string to process.
	environ - environment to check for objects within.
	pow - recognise souls?
	func - extra function to check / should return
		an object if true.
	not - value for the function to match.

	* should fix up the money problem.
	FUCK COINS.

*/

#define PRESENT2 "RO/lib/present2"

array
parse((int|string) str, object environ, int pow, func, not)
{
array items, not_here, here, failed, here_obj, some, objarr;
int i, hc, nhc, fc, yap, sc, q;
string name;

	if (!str) return;
	if (str == "all") 
    {
		some = contents(environ);
		items = allocate(sizeof(some));
		for (i = 0; i < sizeof(some); i++) {
			if (some[i] && !some[i]->query_living() && !some[i]->id("soul") && !pow) {
				items[sc] = some[i];
				sc++;
			}
			else if (pow && (some[i] != environ) && !some[i]->id("soul")) {
				items[sc] = some[i];
				sc++;
			}
		}
		items = items[..sc-1];
	}
	else 
    {
		str = strip_and(str);

		items = explode(str, ",");
		for (i = 0; i < sizeof(items); i++) {
			while (items[i][0] == ' ') items[i] = items[i][1..];
		}
	}

	here = allocate(sizeof(items) + 15);
	here_obj = allocate(sizeof(items) + 15);
	not_here = allocate(sizeof(items) + 15);
	failed = allocate(sizeof(items) + 15);

	for (i = 0; i < sizeof(items); i++) 
    {
		if (stringp(items[i]))
			objarr = PRESENT2->Present(items[i], environ);
		else 
            objarr = ({ items[i] });

		if (sizeof(objarr)) for (q = 0; q < sizeof(objarr); q++)
		{
			if (objarr[q] && objectp(objarr[q])) 
            {
				if (func) yap = call_other(objarr[q], func, 1);
				if (!objarr[q]) continue; /* obj destructued in func */
				if ((!objarr[q]->id("soul") && (yap == not)) || pow) 
                {
					name = objarr[q]->short();
					if (!name) name = "something";
					here[hc] = lower_case(name);
					here_obj[hc] = objarr[q];
					hc++;
				}
				else 
                {
					name = objarr[q]->short();
					if (name) {
						failed[fc] = lower_case(name);
						fc++;
					}
				}
			}	
		}
		else 
        {
			not_here[nhc] = items[i];
			nhc++;
		}
	}
	here = here[0..hc-1];
	here_obj = here_obj[0..hc-1];
	not_here = not_here[0..nhc-1];
	failed = failed[0..fc-1];
	
	return ({ here,  here_obj,  not_here, failed });
}


strip_and(str)
{
int x;
	x = index(str, " and ");
	if (x > -1) return str[0..x-1]+","+str[x+5..];
	return str;
}

/*
 * Returns: all objects in env() match id
 */
present_all(string id, object env)
{
    array c = contents(env);
    array ret = allocate(sizeof(c));
    int i, count;

    for (i = 0; i < sizeof(c); i++)
    {
        if (c[i]->id(id))
        {
            ret[count++] = c[i];
        }
    }
    return ret;
}
