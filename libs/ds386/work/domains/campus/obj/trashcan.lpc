#include <lib.h>

inherit LIB_STORAGE;

/* An invisible fixture of its room, like LIB_DUMMY: isDummy() and the invisibility are what
 * LIB_BASE_DUMMY adds to an item that anything here uses (its knock, scratch and enter verbs only ever
 * refused).  Inheriting it next to LIB_STORAGE gave the object two copies of everything the two share. */
int isDummy(){ return 1; }

protected void create() {
    storage::create();
    SetInvis(1);
    SetKeyName("trashcan");
    SetId(({"can","container"}));
    SetAdjectives("trash");
    SetShort("a trashcan");
    SetLong("A container for discarding waste.");
    SetMass(1500);
    SetDollarCost(15);
    SetMaxCarry(900);
    SetInventory( ([ 
                "/domains/campus/obj/key1" : 1,
                ]) );
    SetPreventGet("It is firmly attached to the ground.");
}
void init(){
    ::init();
}
