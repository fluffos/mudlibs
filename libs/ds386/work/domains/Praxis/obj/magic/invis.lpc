#include <lib.h>

inherit LIB_ITEM;

int __InvisTime;
mixed *__Invis;

void create() {
    ::create();
    SetKeyName("invis");
    SetId( ({ "invis" }) );
    SetInvis(1);
    SetPreventPut("What are you doing?");
    SetPreventDrop("What are you doing?");
}

int test_invis(object whom);
void create_invis(object who, string what, int x) {
    __Invis = ({ who, what });
    __InvisTime = time() + x;
    who->SetInvis( (: test_invis :) );
    eventMove(who);
}

/* GetInvis() hands the pointer the one who is looking, not the Nightmare (invisible one, viewer) pair. */
int test_invis(object whom) {
    if(!__Invis) {
        if(this_object()) this_object()->reeventMove();
        return 0;
    }
    if(__InvisTime < time()) {
        message("environment", "You are feeling more vulnerable now.",
                __Invis[0]);
        this_object()->reeventMove();
        return 0;
    }
    if(!whom || whom == __Invis[0]) return 0;
    if(whom->GetRace() == __Invis[1]) return 1;
    return 0;
}

int remove() {
    int x;

    //if(!__Invis || !sizeof(__Invis)) return ::reeventMove();
    //if(__Invis[0])
    //  __Invis[0]->remove_invis_test( (: test_invis :) );
    //x = ::reeventMove();
    if(!this_object()) return x;
    else __Invis[0]->SetInvis( (: test_invis :) );
    return x;
}
