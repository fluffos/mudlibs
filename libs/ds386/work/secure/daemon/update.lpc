#include <lib.h>
#include <daemons.h>

inherit LIB_DAEMON;

nosave void eventUpdate(){}

nosave void create(){
    object *prevs = previous_object(-1);
    object lu = find_object("/secure/cmds/admins/liveupgrade");
    daemon::create();
    if(lu && sizeof(prevs) && member_array(lu, prevs) != -1){
        cp("/secure/daemon/update.patch","/secure/daemon/update.lpc");
        RELOAD_D->eventReload("/secure/daemon/update.lpc", 2);
    }
    else {
        call_out((: eventUpdate :), 60);
    }
}
