#include <cfg.h>
#include <daemons.h>
#include <localtime.h>

string *zones_cfg = explode((read_file(CFG_TIMEZONES)|| ""), "\n");

varargs string timestamp(mixed tz){
    string rawtz;
    int *t, offset;

    if(tz){
        tz = upper_case(tz);
        if(member_array(tz, zones_cfg) == -1) tz = 0;
    }

    if(!tz) rawtz = query_tz();
    else rawtz = tz;
    if(!rawtz) rawtz = upper_case(localtime(time())[LT_ZONE]);
    // timestamp() is a simul_efun called from master.lpc's error_handler()
    // for EVERY compile warning/error, including ones that fire while
    // some OTHER file is still mid-compile (e.g. preload). TIME_D isn't
    // preloaded, so an unguarded call-other here triggers a lazy compile
    // of /daemon/time from inside that in-progress compile, which this
    // driver forbids ("Object cannot be loaded during compilation.") --
    // and since that failure is itself logged via the same error handler,
    // it recurses into a self-perpetuating error storm for the rest of
    // boot (AGENTS.md section 7.60's CHANNEL_D pattern, here via TIME_D).
    // Guard with find_object() and fall back to no offset (UTC) until
    // TIME_D is actually resident.
    if( find_object(TIME_D) ) offset = TIME_D->GetOffset(rawtz);
    else offset = 0;
    offset += EXTRA_TIME_OFFSET;
    t = localtime(time()+(offset*3600));
    return sprintf("%04d.%02d.%02d-%02d.%02d,%02d", t[LT_YEAR], (t[LT_MON])+1, t[LT_MDAY], t[LT_HOUR], t[LT_MIN], t[LT_SEC]);
}
