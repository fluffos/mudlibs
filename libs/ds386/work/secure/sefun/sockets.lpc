// socket_status() is only defined when the driver is built with the
// sockets package (WASM builds are not -- AGENTS.md 1.3c). This file is
// #included directly into /secure/sefun/sefun.lpc (the simul_efun
// object), so an unconditional reference here is a COMPILE-time
// "Undefined function" error that takes down the whole simul_efun
// object -- and therefore the entire boot -- not just these three
// functions. None of the three are called anywhere else in this
// mudlib (admin-only socket diagnostics), so they are stubbed under
// __WASM__ rather than reimplemented.
#ifdef __WASM__

string dump_socket_status() {
    return "socket_status() unavailable: WASM builds have no sockets package.\n";
}

mixed *socket_names(){
    return ({});
}

string socket_ip(int fd){
    return "0";
}

#else

string dump_socket_status() {
    string ret;
    string *finalsocks, *sock_array = ({});
    int i, quant = sizeof(socket_status());
    for(i = 0; i < quant; i++){
        sock_array += ({ socket_status(i) });
    }
    finalsocks = sock_array;

    ret = "";
    ret += "        Fd    State      Mode       Local Address          Remote Address";
    ret += "        --  ---------  --------  ---------------------  ---------------------";

    foreach (mixed *item in finalsocks) {
        int memb = member_array(item, finalsocks);
        ret += sprintf("%2d  %|9s  %|8s  %-21s  %-21s\n", memb, item[1], item[2], item[3], item[4]);
    }

    return ret;
}

mixed *socket_names(){
    string *finalsocks, *sock_array = ({});
    int i, quant;
    i = catch( quant = sizeof(socket_status()) );
    if(i){
        return ({});
    }
    for(i = 0; i < quant; i++){
        mixed *tmp = socket_status(i);
        tmp[0] = i;
        sock_array += ({ tmp });
    }
    finalsocks = sock_array;

    return finalsocks;
}

string socket_ip(int fd){
    string ret = "0";
    mixed sock_stat = socket_status(fd);
    if(sock_stat) ret = implode(explode(sock_stat[4],".")[0..3], ".");
    return ret;
}

#endif
