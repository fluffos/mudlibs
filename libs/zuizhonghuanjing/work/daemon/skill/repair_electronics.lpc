// repair_electronics.c
// SKILL: repair electronics

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("electronics") < 45 
		|| (int)me->query_skill("machinary") < 20 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("electronics", 5 );
	me->improve_skill("machinary", 5 );
}

string learn_failed()
{
	return "學習 [電器維修] 知識需要先修 [電子學 45] [機械學 20].\n";
}
