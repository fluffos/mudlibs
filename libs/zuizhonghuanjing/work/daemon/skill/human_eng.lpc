// human_eng.c
// SKILL: human body engineering

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("human_anatomy") < 35
		|| (int)me->query_skill("physics") < 60
		|| (int)me->query_skill("medicine") < 40 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("human_anatomy", 5 );
	me->improve_skill("physics", 5 );
	me->improve_skill("medicine", 5 );
}

string learn_failed()
{
return "學習 [人體工學] 知識需要先修 [人體解剖 35] [物理學 60] [醫學 40].\n";
}
