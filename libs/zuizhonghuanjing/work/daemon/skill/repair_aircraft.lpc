// repair_aircraft.c
// SKILL: repair aircraft

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("repair_electronics") < 60 
		|| (int)me->query_skill("repair_machinary") < 75 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("repair_electronics", 5 );
	me->improve_skill("repair_machinary", 5 );
}

string learn_failed()
{
	return "學習 [飛行器維修] 知識需要先修 [電子維修 60] [機械維修 75].\n";
}
