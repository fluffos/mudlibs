// demolition.c
// SKILL: demolition

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("physics") < 35 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("physics", 5 );
}

string learn_failed()
{
	return "學習 [爆破] 知識需要先修 [物理學 35].\n";
}

