// cyborg_m.c
// SKILL: cyborg manufacture

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("human_anatomy") < 90
		|| (int)me->query_skill("human_eng") < 98
		|| (int)me->query_skill("biochemistry") < 95
		|| (int)me->query_skill("pharmacology") < 80
		|| (int)me->query_skill("medicine") < 95
		|| (int)me->query_skill("cybernetic_eng") < 98
		|| (int)me->query_skill("make_electronics") < 98
		|| (int)me->query_skill("make_machinary") < 98 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("human_anatomy", 5 );
	me->improve_skill("human_eng", 5 );
	me->improve_skill("biochemistry", 5 );
	me->improve_skill("pharmacology", 5 );
	me->improve_skill("medicine", 5 );
	me->improve_skill("cybernetic_eng", 5 );
	me->improve_skill("make_electronics", 5 );
	me->improve_skill("make_machinary", 5 );
}

string learn_failed()
{
	return @LONG 
學習 [生化軀體製造] 知識需要先修 [人體解剖 90] [人體工學 98] [生物化學 95]
				 [藥物學 80] [醫學 95] [神經機械工程 98]
				 [電器製造 98] [機械製造 98].
LONG;
}
