// eletronics.c
// SKILL: electronics

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("physics") < 25 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("physics", 5 );
}

string learn_failed()
{
	return "學習 [電子學] 知識需要先修 [物理 25].\n";
}