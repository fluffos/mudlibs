// make_drug.c
// SKILL: make drug

inherit SKILL;

mixed type() { return ({ "dex", "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("pharmacology") < 70 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("pharmacology", 5 );
}

string learn_failed()
{
	return "學習 [藥物製造] 知識需要先修 [藥物學 70].\n";
}
