// biochemistry.c
// SKILL: biochemistry

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("biology") < 35 
		|| (int)me->query_skill("chemistry") < 40 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("biology", 5 );
	me->improve_skill("chemistry", 5 );
}

string learn_failed()
{
	return "學習 [生物化學] 知識需要先修 [生物學 35] 及 [化學 40].\n";
}