// surgery.c
// SKILL: surgery

inherit SKILL;

mixed type() { return ({ "int", "dex", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("diagnosis") < 60 
		|| (int)me->query_skill("human_anatomy") < 70
		|| (int)me->query_skill("pharmacology") < 45 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("diagnosis", 5 );
	me->improve_skill("human_anatomy", 5 );
	me->improve_skill("pharmacology", 5 );
}

string learn_failed()
{
	return "學習 [外科手術] 知識需要先修 [診斷學 60] [人體解剖 70] [藥物學 45].\n";
}
