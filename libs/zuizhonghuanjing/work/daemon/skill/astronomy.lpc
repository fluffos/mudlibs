// astronomy.c
// SKILL: astronomy

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("mathmatics") < 15 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("mathmatics", 5 );
}

string learn_failed()
{
	return "學習 [天文學] 知識需要先修 [數學 15].\n";
}
