// repair_vehicle.c
// SKILL: repair vehicle

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("repair_electronics") < 35 
		|| (int)me->query_skill("repair_machinary") < 55 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("repair_electronics", 5 );
	me->improve_skill("repair_machinary", 5 );
}

string learn_failed()
{
	return "學習 [車輛維修] 知識需要先修 [電子維修 35] [機械維修 55].\n";
}
