// sneak.c

inherit SKILL;

mixed type() { return ({ "dex" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("hide") < 25 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("hide", 5 );
}

string learn_failed()
{
	return "學習 [潛行] 知識需要先修 [躲藏 25].\n";
}
