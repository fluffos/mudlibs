// revive.c
// SKILL: revive

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("first_aid") < 40 
		|| (int)me->query_skill("diagnosis") < 30 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("first_aid", 5 );
	me->improve_skill("diagnosis", 5 );
}

string learn_failed()
{
	return "學習 [昏迷復甦] 知識需要先修 [急救 40] [診斷 30].\n";
}
