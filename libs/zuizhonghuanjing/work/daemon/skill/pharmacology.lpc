// pharmacology.c
// SKILL: pharmacology

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("biochemistry") < 50 
		|| (int)me->query_skill("chemistry") < 60 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("biochemistry", 5 );
	me->improve_skill("chemistry", 5 );
}

string learn_failed()
{
	return "學習 [藥物學] 知識需要先修 [生物化學 50] 及 [化學 60].\n";
}