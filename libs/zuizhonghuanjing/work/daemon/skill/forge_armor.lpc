// forge_armor.c
// SKILL: forge armor

inherit SKILL;

mixed type() { return ({ "dex", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("metallurgy") < 60 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("metallurgy", 5 );
}

string learn_failed()
{
	return "學習 [金屬護甲打造] 知識需要先修 [冶金學 60].\n";
}
