// medicine.c
// SKILL: medicine

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("biology") < 30 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("biology", 5 );
}

string learn_failed()
{
	return "學習 [醫學] 知識需要先修 [生物學 30].\n";
}
