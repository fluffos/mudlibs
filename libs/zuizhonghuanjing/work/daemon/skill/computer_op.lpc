// computer_op.c
// SKILL: computer operation

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("mathmatics") < 20 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("mathmatics", 5 );
}

string learn_failed()
{
	return "學習 [電腦操作] 知識需要先修 [數學 20].\n";
}
