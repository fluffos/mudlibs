// forge_weapon.c
// SKILL: forge weapon

inherit SKILL;

mixed type() { return ({ "dex", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("metallurgy") < 50 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("metallurgy", 5 );
}

string learn_failed()
{
	return "學習 [金屬武器打造] 知識需要先修 [冶金學 50].\n";
}
