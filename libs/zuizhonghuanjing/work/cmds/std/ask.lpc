// ask.c
// ask someone for some information.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.3.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

string *msg_dunno = ({
	"$n 搖搖頭, 說道: 沒聽說過.\n",
	"$n 睜大眼睛望著 $N, 顯然不知道 $P 在說什麼.\n",
	"$n 聳了聳肩, 很抱歉地說: 無可奉告.\n",
	"$n 馬上說道: 不, 我不知道...\n",
	"$n 說道: 嗯....這我可不清楚, $N 最好問問別人吧.\n",
	"$n 想了一會兒, 說道: 對不起, $N 問的事我實在沒有印象.\n",
	"$n 努力地想了許久, 最後只搖著頭說: 不清楚.\n",
});

int main(object me, string arg)
{
	string dest, topic, msg;
	object ob;
	mapping inquiry;

	seteuid(getuid());

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( !arg || sscanf(arg, "%s about %s", dest, topic)!=2 )
		return notify_fail("你要問誰什麼事 ?\n");

	if( !objectp(ob = present(dest, environment(me))) )
		return notify_fail("這裡沒有這個人.\n");

	if( !ob->is_character() ) {
		message_vision("$N 對著 $n 自言自語......\n", me, ob);
		return 1;
	}

	if( !ob->query("can_speak") ) {
		message_vision("$N 向 $n 詢問 " + topic + " 的事, 但是 $p 顯然聽不懂 $N 的話. \n", me, ob);
		return 1;
	}

	me->time_unit_loss( 5 );

	if( !INQUIRY_D->parse_inquiry(me, ob, topic) )
		message_vision("$N 向 $n 詢問 " + topic + " 的事.\n", me, ob);

	if( userp(ob) ) return 1;
	if( !living(ob) ) {
		message_vision("但是很顯然的, $n 現在的狀況沒有辦法給 $N 任何答覆.\n",
			me, ob);
		return 1;
	}

	if( msg = ob->query("inquiry/" + topic) ) {
		if( stringp(msg) ) {
			message_vision( "$N" CYN "說道 :\n" + msg + "\n" NOR, ob);
			return 1;
		}
	} else
		message_vision(msg_dunno[random(sizeof(msg_dunno))], me, ob);

	return 1;
}

int help(object me)
{
   write( @HELP
指令格式: ask <someone> about <something>
時間消耗: 5 單位.

這個指令在冒險時很重要, 通常必須藉由此一指令才能
獲得進一步的資訊.

通常所有的非玩家人物都可以問其姓名 (name) 和職業
 (job), 不過, 你得先會講他們聽得懂的語言. 某些時
候還可以問當地情形 (here) 和打聽消息 (rumor).
HELP
   );
   return 1;
}
