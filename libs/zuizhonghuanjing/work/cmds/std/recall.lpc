// recall.c
// Hyperspace jumping into transporter room or maniac city park.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.May.21.

inherit F_CLEAN_UP;
inherit F_CMD;

int main( object me )
{
	if( me->is_busy() )
		return notify_fail("你的上一個動作還未完成.\n");

	if( me->is_fighting() )
		return notify_fail("你正在戰鬥中.\n");

	if( me->query_time_unit() <= 0 )
		return notify_fail("你的行動沒那麼快.\n");

	if( me->query("position") == "sleep")
		return notify_fail("你仍在睡夢中.\n");

	if( me->query("newbie") )
		return notify_fail("你仍在新手學院.\n");

	if( me->is_ghost() )
		me->move( "/d/death/transporter" );
	else
		me->move( "/d/maniac/central_park_1" );

	return 1;
}

int help( object me)
{
	write(@HELP
指令格式: recall
時間消耗: 無時間消耗.

讓你回到梅尼亞克市中央公園. 如果你是鬼魂, 則回到傳送室.
HELP
	);
        return 1;
}
