// make.c
// Make an item from some components.
// Author: Spock @ FF	97.Mar.6.
// Last modified by Spock @ FF	98.Aug.28.

inherit F_CLEAN_UP;
inherit F_CMD;

varargs int do_make_list( object me, int number );
int help( object me );

int main( object me, string arg )
{

// (1) The usage of variables below:
//
// valid_make			valid_make mapping of player.
// arg_components		Temparilly store the components argument.
// arg_name			The target item which player specified.
// components			The components player input.
// base_name_list		The array list of items available. 
// base_name_map		Get the mapping data of target item of player's own.
// *check_obj_component_bnames	Get the correct component base name list from target object.
// str				Temporarilly store some string in it.
// i, j				for loop interger counter.
// correct_components		The counter for checking the numbers of correct components.
// obj				The target object.
// present_components		The components objects player have.
//
// (2) player object variables:
//
// six arrays of strings:
// valid_make/base_name_list			The array list of item's file name.
// valid_make/BASE_NAME_MAP/name		The list of item names.
// valid_make/BASE_NAME_MAP/cname		The list of item's Chinese name.
// valid_make/BASE_NAME_MAP/component_names	The array list of item's component names.
// valid_make/BASE_NAME_MAP/component_cnames	The array list of item's component Chinese names.
// valid_make/BASE_NAME_MAP/component_bnames	The array list of item's component base names.
//
// (3) target item variables:
//
// components/base_name	The list of the file names of components.
// components/name	The list of the English names of components (reserved).
// components/cname	The list of the Chinese names of components (reserved).
//
	mapping base_name_map, valid_make;
	string arg_components, *components, *check_obj_component_bnames, *base_name_list, str;
	int arg_number, i, j, correct_components;
	object obj, *present_components;

	if( (string)me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

	if( (int)me->query_time_unit() <= 0 )
		return notify_fail("你的動作不夠快 !\n");

	if( !arg ) {
		do_make_list( me );
		return 1;
	}

	if( sscanf( arg, "check %d", arg_number ) == 1 ) {
		if( arg_number < 1 || arg_number > sizeof( me->query("valid_make/base_name_list") ) )
			return notify_fail("不正確的物品編號, 請用 make 查詢編號.\n");
		do_make_list( me, arg_number );
		return 1;
	}

	if( sscanf( arg, "%d from %s", arg_number, arg_components ) != 2 )
		return notify_fail("你想用什麼零件製造物品 ?\n");

	base_name_list = me->query("valid_make/base_name_list");

	if( ( i = sizeof( base_name_list ) ) < 1 )
		return notify_fail("你目前沒有能力製造任何物品.\n"); 

	if( arg_number < 1 || arg_number > i )
		return notify_fail("不正確的物品編號, 請用 make 查詢編號.\n");

	arg_number --;

// Check component present in player's inventory or environment.

	present_components = allocate( sizeof( components = explode( arg_components, "," ) ) ); 
	
	i = sizeof( components );
	while( i -- ) {
		present_components[i] = present( components[i], me );
		if( !present_components[i] || living( present_components[i] ) )
			present_components[i] = present( components[i], environment( me ) );
		if( !present_components[i] || living( present_components[i] ) )
			return notify_fail("這裡沒有這樣零件: " + components[i] + "\n");
	}
		
	valid_make = me->query("valid_make");
	if( !mapp( base_name_map = valid_make[base_name_list[arg_number]] ) ) {
		if( base_name_map ) {
			map_delete( valid_make, base_name_list[arg_number] );
			me->set("valid_make", valid_make );
		}
		base_name_list -= ({ base_name_list[arg_number] });
		me->set("valid_make/base_name_list", base_name_list );
		return notify_fail("此物品的學習紀錄有問題, 已將此部分紀錄刪除.\n");
	}
	if( base_name_map == ([ ]) ) {
		if( base_name_map ) {
			map_delete( valid_make, base_name_list[arg_number] );
			me->set("valid_make", valid_make );
		}
		base_name_list -= ({ base_name_list[arg_number] });
		me->set("valid_make/base_name_list", base_name_list );
		return notify_fail("此物品的學習紀錄有問題, 已將此部份紀錄刪除.\n");
	}
	if( sizeof( components ) != sizeof( base_name_map["component_bnames"] ) )
		return notify_fail("零件數目錯誤.\n");
		
	
// First, we check the player's own record.

	write("開始組合零件:\n");
	i = sizeof( base_name_map["component_bnames"] );
	j = sizeof( present_components );
	correct_components = 0;
	while( j -- ) {
		write( (string)present_components[j]->name() );
		while( i-- ) {
			if( base_name_map["component_bnames"][i] == base_name( present_components[j] ) ) {
				correct_components ++;
				write("        [正確]");
				break;
			}
		}
		write("\n");
	}

	if( correct_components != sizeof( base_name_map["component_bnames"] ) )
		return notify_fail("你的某些零件不正確或是零件不足.\n");

// Now, we compare the record of target item & player's own.

	if( !(obj = new( base_name_list[arg_number] ) ) ) {
		str = "系統中不存在此物品, 請將以下訊息通知巫師:\n[make 指令錯誤報告]\n";
		str += "[檔案] " + base_name_list[arg_number] + " 失蹤.\n";
		return notify_fail( str );
	}

	check_obj_component_bnames = obj->query("components/base_name");
	
	i = sizeof( check_obj_component_bnames );
	j = sizeof( base_name_map["component_bnames"] );
	correct_components = 0;
	while( i -- ) {
		while( j-- ) {
			if( check_obj_component_bnames[i] == base_name_map["component_bnames"][j] ) {
				correct_components ++;
				break;
			}
		}
	}

	if( correct_components != sizeof( check_obj_component_bnames ) ) {
		write( sprintf("%d\n%O\n%O\n", correct_components, check_obj_component_bnames, base_name_map["component_bnames"]) );
		valid_make[base_name_list[arg_number]] = ([ "component_bnames" : check_obj_component_bnames ]);
		me->set("valid_make", valid_make );
		return notify_fail("此物品的組合方式已有更動, 已更新此物品的組合方式紀錄. 請您用 make 查閱新方式.\n");
	}
	if( obj->move( me ) ) {
		message_vision( sprintf("$N 使用一些零件製造出一%s%s.\n",
			obj->query("unit"), obj->name() ), me );
		me->time_unit_loss( 1000 - ( me->query("tec") * 20 ) - ( me->query("not") * 5 ) );

		i = sizeof( present_components );
		while( i-- ) {
			destruct( present_components[i] );
		}

		return 1;
	} else if( obj->move( environment( me ) ) ) {
		message_vision( sprintf("$N 使用一些零件製造出一%s%s, 放在房間中.\n",
			obj->query("unit"), obj->name() ), me );
		me->time_unit_loss( 1000 - ( me->query("tec") * 20 ) - ( me->query("not") * 5 ) );

		i = sizeof( present_components );
		while( i-- ) {
			destruct( present_components[i] );
		}

		return 1;
	} else 
		return 0;
}

varargs int do_make_list( object me, int number )
{
	int i, j;
	string *base_name_list, *component_names, *component_cnames, msg;
	mapping valid_make;
	
	if( !arrayp( base_name_list = me->query("valid_make/base_name_list") )
		|| !mapp( valid_make = (mapping)me->query("valid_make") )
		|| ( ( i = sizeof( base_name_list ) ) < 1 ) ) {
		msg = "你目前沒有能力製造任何物品.\n"; 
	} else if( number ) {
		number --;
		msg = valid_make[base_name_list[number]]["cname"] 
			+ " (" + valid_make[base_name_list[number]]["name"] + ") 的零件:\n";
		j = sizeof( component_cnames = valid_make[base_name_list[number]]["component_cnames"] );
		component_names = valid_make[base_name_list[number]]["component_names"];
		while( j-- ) {
			msg += sprintf("%-30s %-30s\n", component_cnames[j], "(" + component_names[j] + ")" );
		}
	} else {
		msg = "你目前可以製造的物品名稱如下 :\n";
	
		j = 0;
		while( j < i ) {
			msg += sprintf("[%3d] %-30s %-30s\n", j + 1, valid_make[base_name_list[j]]["cname"], valid_make[base_name_list[j]]["name"] );
			j++;
		}
	}

	write( msg );
	return 1;
}

int help( object me )
{
	write( @HELP
指令格式: make
	  make check <欲查詢的物品編號>
	  make <欲製造的物品編號> from <零件 1>,<零件 2>, ....

範例:     make check 2
          make 2 from pistel_c_a,pistel_c_b,pistel_c_c,pistel_c_d
注意:     零件之間的逗號 (,)  之間不可夾雜空白.

時間消耗: 製造物品 1000, 受[技術]及[注意]兩屬性之影響.

這個指令可以讓你使用一些零件製造物品.
如果只打 make 則可以列出你目前有能力製造的物品及編號.
make <物品編號> 可以查詢如何組裝該物品.
HELP
    );
    return 1;
}
