// attack.c
// attack a vehicle !
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.15.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object obj;
	string *killer, callname;
	object *inv;
	int i, flag;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行.\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

	if( environment(me)->query("no_fight") )
		return notify_fail("<神諭> 這裡不准戰鬥.\n");

	if( !arg )
		return notify_fail("你想攻擊什麼?\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("這裡沒有這個載具.\n");

	if( !obj->is_vehicle() || obj->is_trash() )
		return notify_fail("看清楚一點, 那個不是載具.\n");

	inv = all_inventory( obj );

	message_vision("\n$N 突然開始攻擊 $n !!\n", me, obj);
	me->kill_ob(obj);
	me->set_temp("last_opponent", obj );

	return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : attack <載具>
 
這個指令讓你主動開始攻擊一個載具.

其他相關指令: kill
HELP
    );
    return 1;
}
 
