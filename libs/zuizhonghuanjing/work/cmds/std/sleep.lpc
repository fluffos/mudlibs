// sleep.c

inherit F_CLEAN_UP;
inherit F_CMD;

int main( object me )
{
	if( me->is_busy() )
		return notify_fail("你的上一個動作還未完成.\n");

	if( me->is_fighting() )
		return notify_fail("你正在戰鬥中.\n");

	if( me->query_time_unit() <= 0 )
		return notify_fail("你的行動沒那麼快.\n");

	if( me->query("position") == "sleep") {
		return notify_fail("你已經睡著了.\n");
	} else {
		message_vision("$N 找了個地方躺下來睡覺.\n", me );
		me->set("position", "sleep");
	}
	return 1;
}