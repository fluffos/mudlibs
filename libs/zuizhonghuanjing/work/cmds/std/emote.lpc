// emote.c (Mon  09-04-95)
// To show certain expression by user input.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.3.

#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_CMD;
 
int main(object me, string str)
{
	string my_pro, msg;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

	my_pro = gender_self(me->query("gender"));

	if (!str) {
	        write(CYN + my_pro + "看起來表情豐富.\n"NOR);
        	tell_room(environment(me), CYN+(string)me->name()+
			"看起來表情豐富.\n" +NOR, me);
        	return 1;
    	}
//    	write(CYN + my_pro + str + "\n"NOR);
//    	tell_room(environment(me), CYN+(wizardp(me)? "":"->")+(string)me->name()+
//      str+"\n"+NOR, me);
	msg = CYN + "$N" + CYN + str + "\n" + NOR;
	message_vision( msg, me);
	me->time_unit_loss( 1 );
	return 1;
}
 
int help(object me)
{
	write(@HELP
指令格式: emote <動作詞>
時間消耗: 1 單位.

這個指令可以讓你表達一個系統沒有預設的動作詞, 系統會將你所輸入
的文字加上你的姓名後顯示給所有在同一個地方的生物看.

範例: emote 表演吞劍, 劍刃一不小心卡在喉嚨裡...呃...
你會看見: 你表演吞劍, 劍刃一不小心卡在喉嚨裡...呃...
其他人會看到: 某甲表演吞劍, 劍刃一不小心卡在喉嚨裡...呃...

其中, 某甲就是你的名字.

相關指令: semote
HELP
	);
        return 1;
}
