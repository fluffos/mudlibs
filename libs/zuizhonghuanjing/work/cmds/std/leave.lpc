// leave.c
 
inherit F_CLEAN_UP;
inherit F_CMD;

#include <ansi.h>

int help();
 
int main( object me)
{
	object inside;
	int i;
 
	if( me != this_player(1) ) return 0;
 
	if( !environment( me )->is_vehicle() && !environment( me )->is_space_ship_room() )
		return notify_fail("你不在任何載具或是宇宙船艦中.\n");
//	if( !environment( me )->is_vehicle() )
//		return notify_fail("你不在任何載具中.\n");
//	else if( !environment( me )->is_space_ship_room() )
//		return notify_fail("你不在任何宇宙船艦中.\n");

	if( environment( me )->is_space_ship_room() 
		&& !environment( me )->query("bridge") )
		return notify_fail("你不在艦橋中.\n");
		
	if( environment( me )->is_vehicle() ) {		
		if( !me->query_temp("command"))
			return notify_fail(sprintf("你並沒有駕駛這%s%s.\n",
			environment(me)->query("unit"),
			environment(me)->query("name")));
					
		me->delete_temp("command");
		message_vision 
		(sprintf(CYN" %s"CYN"停止駕駛這%s%s"CYN"。\n"NOR,
		me->query("name"), environment(me)->query("unit"),
		environment(me)->query("name")), me);
	} else if( environment( me )->is_space_ship_room() ) {
		if( !me->query_temp("ss_command"))
			return notify_fail(sprintf("你並沒有駕駛這%s%s.\n",
			environment(me)->query("unit"),
			environment(me)->query("name")));
					
		me->delete_temp("ss_command");
		message_vision 
		(sprintf(CYN" %s"CYN"停止駕駛這%s%s"CYN"。\n"NOR,
		me->query("name"), environment( environment(me))->query("unit"),
		environment( environment(me))->query("name")), me);
	}
	return 1;
}
 
int help()
{
	write(@HELP
指令格式﹕leave
 
這個指令可以讓你停止駕駛載具。

參考: drive, pilot 
HELP
	);
	return 1;
}
