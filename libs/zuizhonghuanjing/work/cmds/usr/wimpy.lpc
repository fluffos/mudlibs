// wimpy.c
// Set what condition character should automatic flee from combat.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

inherit F_CLEAN_UP;
inherit F_CMD;

int display_wimpy( object me);
int help( object me);

int main(object me, string arg)
{
	string wmp;
	int percent;

	if( !arg ) {
		display_wimpy( me);
		return 1;
	}

	if( sscanf( arg, "%d", percent) == 1 && percent >= 0 && percent <= 100) {
		me->set("wmp_spi", percent);
		me->set("wmp_hit", percent);
		me->set("wmp_mov", percent);
		me->set("wmp_vital", percent);

		display_wimpy( me);
		return 1;
	}

	if( sscanf( arg, "%s %d", wmp, percent) == 2 && percent >= 0 && percent <= 100) {
		if( wmp == "spi" || wmp == "hit" || 
			wmp == "mov" || wmp == "vital")
			me->set( "wmp_" + wmp, percent);
		display_wimpy( me);
		return 1;
	}

	return help(me);
}

int display_wimpy( object me)
{
	string message;

	message = "戰鬥當中自動開溜的狀況設定 :\n";
	message += sprintf("[精神] %3d %%    [體能] %3d %%", 
			me->query("wmp_spi"), me->query("wmp_hit"));
	message += sprintf("    [移動] %3d %%    [重要部位] %3d %%\n", 
			me->query("wmp_mov"), me->query("wmp_vital"));
	write( message);
	return 1;
}
int help(object me)
{
	write(@HELP
指令格式 :  wimpy [<設定種類>] [<自動逃跑時的狀況百分比>]
	    wimpy [<所有狀況值通用的百分比>]

這個指令讓你設定當體能、精神或移動點數剩下百分之多少時, 就會
自動開始逃跑. 百分比的範圍是 0 ~ 100.

可以設定的種類: spi (精神), hit (體能), mov (移動), 
		vital (重要部位, 頭部和身體)

參考: body, hp, score
HELP
	);
	return 1;
}

