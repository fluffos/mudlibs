// signature.c
// Change user's signature.
// Author:	Spock @ FF	97.Dec.2.
// Last modified by Spock @ FF	97.Dec.2.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me );

int main(object me, string arg)
{
	object ob;

	if( !arg ) {
		help( me );
		return 1;
	}
	if( strlen(arg) > 500 || sizeof( explode( arg, "\n" ) ) > 6 )
		return notify_fail("您設定的個人簽名太長了.\n");

	arg = CHINESE_D->ansi_color( arg );

	ob = me->link();
	ob->set("signature", arg );
	ob->save();

	write("Ok.\n");
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : signature <您的簽名內容>
	   to signature		-- 使用多行輸入
 
這個指令可以讓您更改自己的簽名內容. 最多六行, 500 bytes.
本指令支援色彩指定值, 請見 help color.

參考: finger, cname, email, profile
HELP
        );
        return 1;
}
