// time.c
// Display game & real life time.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5. 

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	write("現在是" + NATURE_D->game_time() + ".\n");
	return 1;
}

int help(object me)
{
     write(@HELP
指令格式: time

這個指令顯示現在的時間.

參考: uptime
HELP
    );
    return 1;
}
