// profile.c
// Change user's profile data.
// Author:	Spock @ FF	97.Dec.2.
// Last modified by Spock @ FF	97.Dec.2.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me );

int main(object me, string arg)
{
	object ob;

	if( !arg ) {
		help( me );
		return 1;
	}
	if( strlen(arg) > 1000 || sizeof( explode( arg, "\n" ) ) > 15 )
		return notify_fail("您設定的個人名片太長了.\n");

	arg = CHINESE_D->ansi_color( arg );

	ob = me->link();
	ob->set("profile", arg );
	ob->save();

	write("Ok.\n");
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : profile <您的名片內容>
	   to profile			(使用多行輸入)
 
這個指令可以讓您更改自己的名片內容. 最多 15 行, 1000 bytes.
本指令支援色彩指定, 請見 help color.

參考: finger, cname, nick, email, signature
HELP
        );
        return 1;
}
