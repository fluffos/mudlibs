// skills.c
// List learned skills.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object ob;
	mapping skl, lrn;
	string *sname, *type, type_list;
	int i, j;

	seteuid(getuid());

	if(!arg)
		ob = me;
	else{
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if (!ob) return notify_fail("你要察看誰的技能 ?\n");
	}

	if( ob!=me && !wizardp(me) && !ob->is_apprentice_of(me)
	&& !me->is_apprentice_of(ob) )
		return notify_fail("只有巫師或有師徒關係的人能察看他人的技能.\n");

	skl = ob->query_skills();
	if(!sizeof(skl)) {
		write( (ob==me ? "你" : ob->name()) + "目前並沒有學會任何技能.\n");
		return 1;
	}
	write( (ob==me ? "你" : ob->name()) +"目前所學過的技能 :\n\n");
	sname  = sort_array( keys(skl), (: strcmp :) );
	
	lrn = ob->query_learned();
	if( !mapp(lrn) ) lrn = ([]);
	
	for(i=0; i<sizeof(skl); i++) {
		printf("%s%-40s" NOR " - ", 
			(lrn[sname[i]] >= (skl[sname[i]]+1) * (skl[sname[i]]+1)) ? HIM : "",
			to_chinese(sname[i]) + " (" + sname[i] + ")",
		);

		type_list = "";
		for( j = 0; j < sizeof( type = SKILL_D(sname[i])->type() ); j++ ) {
			type_list += sprintf("[%s] ", to_chinese( type[j] ) );
		}

		printf("%21s- %3d/%5d\n", 
			type_list, skl[sname[i]], (int)lrn[sname[i]],
		);
	}
	write("\n");
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : skills [<某人>]

這個指令可以讓你(妳)查詢所學過的技能.
你也可以指定一個和你有師徒關係的對象, 用 skills 可以查知對方
的技能狀況. 巫師可以查詢任何人或 NPC 的技能狀況.

參考: body, hp, score
HELP
    );
    return 1;
}
