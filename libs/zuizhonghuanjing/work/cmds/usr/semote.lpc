// semote.c
// List all emote commands available.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

#include "/doc/help.h"

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	string *e;
	int i;

	e = sort_array(EMOTE_D->query_all_emote(), 1);

	for(i=0; i<sizeof(e); i++)
		printf("%-15s%s", e[i], (i%5==4)?"\n": "");
	write("\n");
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : semote

這個指令可以列出, 目前您所能使用的 emote 動作.

參考: emote
HELP
    );
    return 1;
}
