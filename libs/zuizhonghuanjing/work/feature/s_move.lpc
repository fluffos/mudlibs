// s_move.c

nomask int query_encumbrance() { return 10000000000; }
nomask int query_max_encumbrance() { return 10000000000; }

int move( mixed dest )
{
	object ob;

	if( objectp(dest) )
		ob = dest;
	else if( stringp(dest) ) {
		call_other(dest, "???");
		ob = find_object(dest);
		if(!ob) return notify_fail("move: destination unavailable.\n");
	} else
		return notify_fail(sprintf("move: invalid destination %O.\n", dest));

	if( this_object()->is_shuttle() )
		this_object()->set_temp("location", random( (int)ob->query("mov_cost") ) );

	move_object(ob);
}

