// liquid.c

#include <dbase.h>
#include <name.h>

inherit ITEM;

int is_water_container() { return 1; }

string query_autoload()
{
	return query("liquid/type") + "@" + query("liquid/name");
}

string extra_long()
{
	int amount, max;
	string str;

	if( amount = query("liquid/remaining") ) {
		max = query("max_liquid");
		if( amount == max )
			str = "裡面裝滿了" + query("liquid/name") + ".\n";
		else if( amount > max/2 )
			str = "裡面裝了七、八分滿的" + query("liquid/name") + ".\n";
		else if( amount >= max/3 )
			str = "裡面裝了五、六分滿的" + query("liquid/name") + ".\n";
		else if( amount > max/2 )
			str = "裡面裝了少許的" + query("liquid/name") + ".\n";
		return str;
	}
	else return 0;
}
