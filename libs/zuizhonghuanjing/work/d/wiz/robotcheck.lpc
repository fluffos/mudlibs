// Room: /d/wiz/courthouse.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "測試室");
	set("long", @LONG
這裡是 The Final Frontier 的巫師測試玩者是否為機器人的房間, 你一定是被
人檢舉或是行為太像機器人, 才會來到這裡, 如果你無法適當地回答審判官的三個問
題, 就會被做上記號, 超過三次的人將會被處以極刑而刪除檔案. 請小心了.
LONG
	);
	set("no_fight", 1);
	set("no_magic", 1);
	set("no_spells", 1);
	set("objects", ([
		__DIR__"npc/judge":1 ]) );

	setup();
}

void test_me(object me)
{
	me->set_temp("old_startroom", me->query("startroom"));
	me->set("startroom", __FILE__);
	me->set_temp("last_location", base_name(environment(me)));
	message_vision("忽然一陣閃光罩住了$N.\n", me);
	me->move(this_object());
}
