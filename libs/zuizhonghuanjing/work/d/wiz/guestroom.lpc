// entrance.c

#include <login.h>
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "FF 管理中心一樓----巫師會客室");
        set("long", @LONG
你看到一間寬敞而明亮的房間, 有著簡樸的裝潢. 四周牆上掛著
巫師的肖像. 在你面前有一個櫃臺, 一位負責聯絡巫師的服務員正等
著為您服務. 櫃臺上有一個牌子寫著: 如果你有什麼意見或問題要讓
巫師們知道, 請在這裡留言. 不過請您先確定我們提供的說明文件裡
沒有說明, 再提出您的疑問. 巫師的主要職責是維護系統的運作, 而
不是教玩家如何玩這個遊戲. 
    樓上是巫師交誼廳, 只有巫師才能進入. 在你的腳下有一扇半透
明的門 (door).
LONG
        );
        set("exits", ([
                "down" : "/d/maniac/central_park_1",
                "up" : __DIR__"hall1",
        ]) );
//        set("no_fight", 1);

        set("objects", ([
                "/obj/board/query_b" : 1,
        ]) );

	set("doors", ([
		"down"	:	([
				"data" : "透明的門",
				"other_side_dir" : "up",
				"status" : DOOR_CLOSED,
				]),
	]) );
//	create_door("down", "半透明的門", "up", DOOR_CLOSED);

        setup();
}

int valid_leave(object me, string dir)
{
        if( dir=="up" && !wizardp(me) )
                return notify_fail("那裡只有巫師才能進去.\n");
        return ::valid_leave(me, dir);
}
