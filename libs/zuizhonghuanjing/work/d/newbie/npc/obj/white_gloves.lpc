// white_gloves.c

#include <armor.h>

inherit GLOVES;

void create()
{
	set_name("白色女用手套", ({ "white gloves", "white", "gloves" }) );
        set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "雙");
		set("long", @LONG
一雙有點髒汙的白色女用手套.
LONG
	);
                set("value", 15);
		set("armor_prop/traditional_armor", 1);
	}
	setup();
}
