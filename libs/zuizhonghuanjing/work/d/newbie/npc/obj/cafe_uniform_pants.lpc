// cafe_uniform_pants.c

#include <armor.h>

inherit PANTS;

void create()
{
	set_name("服務生制服長褲", ({ "waiter pants", "waiter", "pants" }) );
        set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "條");
		set("long", @LONG
一件深藍色的長褲. 這是新手學院餐廳服務生的制服長褲.
LONG
	);
                set("value", 9);
		set("armor_prop/traditional_armor", 2);
	}
	setup();
}
