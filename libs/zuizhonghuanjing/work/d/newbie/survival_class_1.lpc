#include <ansi.h>
#include <room.h>

inherit ROOM;

//______05________10________15________20________25________30________35________40
 
void create()
{
	set("short", "求生知識教室");
	set("long", @LONG
    這裡是新手學院訓練中心一樓入口的咨詢櫃檯. 四週擺設著許多
室內盆栽植物 (plants).  坐在櫃檯後面的是一位美麗的小姐, 如果
你有什麼問題, 她也許可以為你解答. 在牆上有一面公佈欄 (board)
, 上面貼著一些公告.
    在櫃檯旁有一臺供應開水的飲水機, 打 drink 即可喝水.
    往西是學院大廳, 往南是通往各層的樓梯. 往北通往職員辦公室.
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"south" : __DIR__"stairs_1",
		"west" : __DIR__"entrance",
	]));

	set("objects", ([
		__DIR__"npc/info_lady" : 1,
	]) );

	set("resource/water", "飲水機" );
	set("no_fight", 1);

	set("detail/board", @DETAIL
  了解 look 的用法了嗎 ?  現在我們詳細解釋 go 這個命令:
打 go west = west = w,  只要是東、西、南、北、上、下六個方向
都能簡寫為 e, w, s, n, u, d.  移動是需要消耗移動值的喔.

打 help 可以顯示求助的資料, help cmds 列出所有你可以使用的命
令. 如果你打 help look, 就可以看到 look 命令的詳細說明.

  接下來在此我們認識一下「非玩者人物」(NPC),  也就是電腦控制
的角色. NPC,  所負責的任務有: 讓你砍殺以練功、握有解開謎題或
進行任務的關鍵、買賣物品、裝飾....在 FF 中, 對 NPC  有意義的
命令有: ask, say, give  等等, 少數情況甚至連 bow  這種表情動
作也有作用. 不過學院中的 NPC  都不會接受你的贈與, 這個你可以
放心. 在你面前不是有一位美麗的小姐嗎 ? 現在就從
ask lady about name, ask lady about job 開始吧.
DETAIL
	);
	set("detail/plants", @DETAIL
  這些植物有變葉木、蘇鐵等等, 雖然在室內也顯得生氣勃勃. 可見
得它們都有受到良好的照顧.
DETAIL
	);
	set("mov_cost", 5);

	setup();

	replace_program(ROOM);
	}
