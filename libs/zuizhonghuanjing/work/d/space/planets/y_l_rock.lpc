// y_l_rock.c

#include <room.h>

inherit SPACE;
inherit PLANET;

void create()
{
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("short", "大型岩質行星");
		set("long", @LONG
一顆年青的大型行星. 地表成份為融熔狀態的岩石, 核心成份為融熔的重金屬.
行星有大量而不穩定的地質活動.
LONG
		);
		set("habitability", 0 );
	}

	setup();
}
