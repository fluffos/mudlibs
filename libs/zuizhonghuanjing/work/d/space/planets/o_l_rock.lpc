// o_l_rock.c

#include <room.h>

inherit SPACE;
inherit PLANET;

void create()
{
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("short", "大型岩質行星");
		set("long", @LONG
一顆老年的大型行星. 地表成份為固態岩石, 核心成份為固態的金屬.
行星無任何地質活動.
LONG
		);
		set("habitability", 0 );
	}

	setup();
}
