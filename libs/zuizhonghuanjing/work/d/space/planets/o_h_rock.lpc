// o_h_rock.c

#include <room.h>

inherit SPACE;
inherit PLANET;

void create()
{
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("short", "巨型岩質行星");
		set("long", @LONG
一顆老年的巨型行星. 地表成份為固態岩石, 核心成份為融熔的重金屬.
行星有少量的地質活動.
LONG
		);
		set("habitability", 0 );
	}

	setup();
}
