// asteriod.c

#include <room.h>

inherit SPACE;
inherit PLANET;

void create()
{
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("short", "小行星帶");
		set("long", @LONG
小行星帶由許多大小不等的小型岩石所組成, 岩石直徑由數公里
至數十公里不等. 在恆星系成形的過程中, 此處的軌道上運行的是一
顆岩質的星球. 後來因不明的原因而破碎成小行星帶.
LONG
		);
		set("habitability", 0 );
	}

	setup();
}
