// ceres_space_station.c

inherit SPACE_STATION;

void create()
{
	set_name("賽芮絲太空站", ({"ceres space station", "ceres", "space", "station"}));
	set("long", @LONG
    這是賽芮絲太空站, 目前屬於地球的烏托邦政權 (Utopia).
LONG
	);

	set("env_space", __DIR__"earth" );
	set("space_station", 1 );
	set("rooms", ({
		__DIR__"ceres_boarding_tube_1",
		__DIR__"ceres_boarding_hall",
		__DIR__"ceres_shuttle_bay",
	}) );
	set("boarding_tubes", ({ __DIR__"ceres_boarding_tube_1", }) );
	set("shuttle_bay", __DIR__"ceres_shuttle_bay" );
	set("no_get", 1 );

	setup();
}
