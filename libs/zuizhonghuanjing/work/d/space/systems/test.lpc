// test.c

#include <room.h>

inherit SPACE;

void create()
{
	set("short", "'測試星系");
	set("long", @LONG
 [座標] ( 1, 3, 5 )
 [恆星] 一顆中年的恆星 (M 級星球).
 [行星] 九顆, 於第六與第七行星間有小行星帶.
LONG
	);
	set("coord_1", ({ 1, 3, 5, }));

	set("planets/name", ({
		"恆星",
		"第一行星",
		"第二行星",	
		"第三行星",	
		"第四行星",	
		"第五行星",	
		"第六行星",	
		"小行星帶",
		"第七行星",	
		"第八行星",
		"第九行星",
	}) );
	set("planets/file", ({
		"/d/space/suns/m.lpc",
		"/d/space/planets/m_s_rock.lpc",
		"/d/space/planets/m_m_gas.lpc",
		"/d/space/planets/m_m_rock.lpc",
		"/d/space/planets/m_m_rock.lpc",
		"/d/space/planets/m_l_gas.lpc",
		"/d/space/planets/m_h_gas.lpc",
		"/d/space/planets/asteroid.lpc",
		"/d/space/planets/m_l_gas.lpc",
		"/d/space/planets/m_l_gas.lpc",
		"/d/space/planets/m_m_gas.lpc",
	}) );

	setup();
}
