inherit NPC;
inherit F_VENDOR;

void prepare_kill();

int on_service = 0;

void create()
{
	set_name("酒館老闆", ({ "bartender", "Mark", "mark", "Mark Simons" }) );
	set("title", "平民");
	set("gender", "男性");
	set("age", 43);

	set("long", @LONG
    一位約四十出頭的中年男子. 他的容貌和藹, 頭髮微禿, 正忙著招
呼吧台旁點酒的客人.
LONG
	);
	set("str", 9);
	set("dex", 10);
	set("int", 8);
	set("wis", 15);
	set("not", 12);
	set("cha", 10);
	set("con", 10);
	set("tec", 5);
	set("level", 40 );
	set("combat_exp", 160000 );
	set("attitude", "friendly");
	set("group", ({"maniac", "maniac_citizen"}));
	set("score", 40 );
	set("positive_fame", 37 );
	set("negative_fame", 5 );
	
	set("welcome_msg", "$N 喃喃說道: 不知道這位知不知道她的下落....\n" );

	set("inquiry", ([
		"name" :
"我是馬克˙西蒙斯 (Mark Simons) , 我是這裡的老闆, 也是調酒師.",
		"job" :
"這裡有一張價目表 (list), 如果您要點酒或食物, 請告訴我名字.",
		"stage" :
"你應該聽說過, 我們黃玉酒店有全市最美麗的舞者 (dancer) 吧 ?\n",
		"asso"	:
"那個混帳王八蛋, 拐跑了我女兒 (daughter) !!\n",
		"dancer" :
"就是我女兒瑪莉娜 (Marina)!  她可是全市最好的舞者, 不只是人漂亮而已.\n",
		"daughter" :
"我女兒瑪莉娜 (Marina) 跟一個名不見經傳的小白臉跑了! 他居然敢這樣對我 !!\n",
		"Marina" :
"追求瑪莉娜的人何其多, 家財萬貫的人更是不勝計數, 結果呢 ? 跟傑克 (Jack) 跑了 !\n",
		"Jack"	:
"你說傑克? 哼! 他不過是整天無所事事, 到處靠那張臉騙 (lure) 女孩子!\n",
		"lure"	:
"早知道, 我就先揍他一頓, 看他敢不敢接近我的女兒! ... 我可憐 (poor) 的女兒...\n",
		"poor"	:
"唉... 可憐的孩子, 一定會被那個渾小子拋棄的... 不知道她現在在哪 (where)...\n",
		"where" :
"拜託你! 你如果有聽到她的消息, 一定要馬上告訴我! 拜託!!\n",
	]));

	set("chat_chance", 3);
	set("chat_msg", ({
"$N 拿起一塊乾淨的抹布, 擦了擦面前的吧台.\n",
"$N 皺了一下眉頭, 像是想到什麼心事.\n",
"$N 突然呆呆地望著酒店中央的舞臺 (stage), 不知道想起了什麼事...\n",
"$N 拿起一塊白色的布擦拭著手中的調酒器.\n",
"$N 喃喃道: 怎麼會這樣呢 ?  這混蛋 (asso) 實在太過分了...\n",
"$N 嘆了口氣道: 自從她走了以後, 生意也大不如前了啊.\n",
	}) );

	set("chat_chance_combat", 50 );
	set("chat_msg_combat", ({
"$N 氣憤地叫道: 混蛋 !!\n",
	}) );

	set("begin_fighting", ({
		(: prepare_kill :),
	}) );
	set("after_fighting", ({
		(: command, "unwield dagger" :),
	}) );

	set("merchandise", ([
		"/obj/drink/grapewine": 40,
		"/obj/food/wheat_bread": 5,
//		__DIR__"obj/pork": 30,
//		__DIR__"obj/roast_chicken": 30
	]));

	set_skill("dodge", 35);
	set_skill("unarmed", 40);
	set_skill("melee_weapon", 30);

	setup();
	
	add_money("gold", 1);
	add_money("silver", 15);
	add_money("copper", 130);
	carry_object("/obj/coat")->wear();
	carry_object("/obj/pants")->wear();
	carry_object(__DIR__"obj/dagger");
	
	set("home_name", ({
		"/d/maniac/topaz_pub.lpc",
	}) );

}

void init()
{
	::init();
	add_action("do_vendor_list", "list");
}


mixed affirm_merchandise(object customer, string item_name)
{
	if( on_service )
		return notify_fail("老闆正忙著招呼其他客人, 請您等一會兒.\n");
	return ::affirm_merchandise(customer, item_name);
}

private void handover(object customer, mixed item)
{
	on_service = 0;
	if( !customer || environment(customer)!=environment() ) {
		command("say 剛剛那位客人呢 ? 怎麼付了錢人卻不見了 ? ....");
		message_vision("$N 把端出來的" + item->name() + "放回身後.\n", this_object());
		return;
	}
	command("say 您的" + item->name() + "調好了.");
	message_vision("$N 把剛調好的" + item->name()
		+ "送到 $n 面前. \n", this_object(), customer);
	::deliver_merchandise(customer, item);
}

void deliver_merchandise(object customer, mixed item)
{
	command("say " + item->name() + "? 請您稍等一下.");
	message_vision("$N 拿出玻璃杯和調酒器, 開始製作 " + item->name() + ".\n", this_object() );
	on_service = 1;
	do_chat((: handover, customer, item :));
}

void prepare_kill()
{
	if( query_temp("pending/prepare_kill") ) return;

	command("wield dagger");
	command("say 哼 !  你這個殺人兇手 !!");
	set_temp("pending/prepare_kill", 1 );
}
