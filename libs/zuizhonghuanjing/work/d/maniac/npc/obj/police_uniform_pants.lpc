#include <armor.h>

inherit PANTS;

void create()
{
	set_name("警備隊員制服長褲", ({ "uniform pants", "uniform", "pants" }) );
        set_weight( 1000 );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件" );
		set("long",
"這是一件黑色的梅尼亞克警備隊員的制服長褲.\n");
                set("value", 50 );
		set("armor_prop/traditional_armor", 4 );
	}
	setup();
}
