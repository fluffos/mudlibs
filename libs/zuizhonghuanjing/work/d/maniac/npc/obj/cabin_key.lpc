// cabin_key.c

inherit ITEM;

int is_key() { return 1; }

void create()
{
	set_name("小木屋的鑰匙", ({ "key of cabin", "key" }) );
	set_weight( 50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "這是一把銅製的鑰匙.\n");
		set("unit", "把");
		set("value", 50);
		set("key_id", "maniac/cabin_key");
	}
}
