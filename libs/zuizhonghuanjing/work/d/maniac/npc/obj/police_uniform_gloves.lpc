#include <armor.h>

inherit GLOVES;

void create()
{
	set_name("黑色皮手套", ({ "black leather gloves", "black", "leather", "gloves" }) );
        set_weight( 300 );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "雙" );
		set("long",
"這是一雙梅尼亞克警備隊員制服使用的黑色手套.\n");
                set("value", 20 );
		set("armor_prop/traditional_armor", 2 );
	}
	setup();
}
