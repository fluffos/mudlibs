#include <armor.h>

inherit HEAD;

void create()
{
	set_name("警備隊員制服扁帽", ({ "uniform cap", "uniform", "cap" }) );
        set_weight( 800 );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "頂" );
		set("long",
"這是一頂黑色的梅尼亞克警備隊員制服扁帽, 前面有一枚警徽.\n");
                set("value", 30 );
		set("armor_prop/traditional_armor", 2 );
	}
	setup();
}
