// sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("軍用長劍", ({ "sword" }) );
	set_weight(5000);
//	seteuid( getuid() );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
                set("long", "這是一把梅尼亞克軍人的配劍, 長 90 公分.\n");
		set("value", 1500);
                set("material", "鋼");
                set("wield_msg", "$N「唰」地一聲抽出一把 $n 握在手中.\n");
                set("unwield_msg", "$N 將手中的 $n 插入腰間的劍鞘.\n");
	}
        init_sword( 2, 5, 7, 1, 2);
	setup();
}
