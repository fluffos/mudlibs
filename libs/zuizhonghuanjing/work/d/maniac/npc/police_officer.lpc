// post_officer.c
// Author: Spock @ FF        97.Mar.22.

inherit NPC;
inherit F_POLICE;

void prepare_kill();
void stop_kill();
void ask_drop_weapon();
void check_drop_weapon( object ob );

void create()
{
        set_name("梅尼亞克市警備隊員", ({ "police", "clark", "clark asimov",}) );
        set("title", "軍人");
        set("gender", "男性" );
        set("age", 22);
        set("long", @LONG
    他身著黑色的警員制服, 左胸前有一枚梅尼亞克市警備隊的警徽
. 他的身材短小精悍, 雙臂有著結實的肌肉. 他的腰間配著一把稀有
的鋼製長劍.
LONG
        );
        set("str", 13);
        set("dex", 14);
        set("int", 11);
        set("wis", 17);
        set("not", 13);
        set("cha", 8);
        set("con", 15);
        set("tec", 7);
        set("level", 65);
        set("combat_exp", 65 * 65 * 100 );
        set("attitude", "friendly");
        set("group", ({"maniac", "maniac_officer"}));
        set("score", 15 );
        set("positive_fame", 45 );
        set("negative_fame", 10 );

        set("pursuer", 1 );
        set("legal_wield_weapon/maniac", 1 );

        set("inquiry", ([
                "name" : 
"我是克拉克--艾西摩夫 (Clark Asimov).",
                "job" : 
"我是個警察, 看到我的制服和警徽也該知道吧 ?",
        ]) );

        set("chat_chance", 10 );
        set("chat_msg", ({
"$N 向四周巡視一回, 似乎在尋找可疑的人.\n",
                (: random_move :),
                (: ask_drop_weapon :),
        }) );

        set("after_fighting", ({
                (: stop_kill :),
                (: command, "follow none" :),
        }) );

        set("chat_chance_combat", 10 );
        set("chat_msg_combat", ({
"$N 大叫道: 膽子很大嘛 !  不過是個小流氓而已 !\n",
                (: prepare_kill :),
        }) );

        set_skill("dodge", 45 );
        set_skill("unarmed", 60 );
        set_skill("melee_weapon", 50 );
        setup();
        add_money("silver", 2);
        add_money("copper", 30);
        carry_object(__DIR__"obj/police_uniform_coat")->wear();
        carry_object(__DIR__"obj/police_uniform_pants")->wear();
        carry_object(__DIR__"obj/police_uniform_cap")->wear();
        carry_object(__DIR__"obj/police_uniform_gloves")->wear();
        carry_object(__DIR__"obj/police_uniform_boots")->wear();
        carry_object(__DIR__"obj/rod")->wield();
        carry_object(__DIR__"obj/sword");
}
