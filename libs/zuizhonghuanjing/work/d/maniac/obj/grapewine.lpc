// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("高腳酒杯", ({ "glass", "wine glass" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一個玻璃酒杯.\n");
		set("unit", "個");
		set("value", 10);
		set("max_liquid", 5);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "wine",
		"name": "葡萄酒",
		"remaining": 5,
	]) );
}
