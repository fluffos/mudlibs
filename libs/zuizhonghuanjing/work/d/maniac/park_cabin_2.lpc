// /d/maniac/park_cabin_2.c 
#include <room.h>

inherit ROOM;

void create()
{
	set("short", "公園北側小徑");
	set("long", @LONG
你發現西邊有一棟小木屋 (cabin)  隱藏在濃密的樹蔭下, 似乎正
靜靜地等待著訪客. 
    小木屋的門 (door) 上有一塊黃銅製的名牌 (plaque).
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
		"north" : __DIR__"south_river_bank_1",
		"south" : __DIR__"park_cabin_1.lpc",
		"west"	: __DIR__"park_cabin_3.lpc",
]));

	set("no_clean_up", 0);
	set("mov_cost", 15 );
	set("outdoors", 1);

	set("detail", ([
		"cabin":
"這棟小木屋完全是由原木建造的, 外表上也沒有塗上任何灰泥還是油
漆什麼的東西. 但是你發現建造這棟小木屋的手藝可以算得上是精巧.\n",

		"plaque":
"名牌上刻著某個人名字的簡寫: L.Y.\n",
	]));
	set("doors", ([
		"west"	:	([
				"data"		:	"小木屋的門",
				"other_side_dir":	"east",
				"status"	:	DOOR_LOCKED,
				"key_id"	:	"maniac/cabin_key",
				]),
	]) );

//	create_door("west", "小木屋的門", "east", DOOR_LOCKED, "maniac/cabin_key");

	setup();
}

