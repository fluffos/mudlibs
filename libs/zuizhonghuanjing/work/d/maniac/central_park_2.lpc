// Room: /d/maniac/central_park_2.c

inherit ROOM;

void create()
{
	set("short", "中央公園");
	set("long", @LONG
    你籠罩在濃密的樹蔭底下, 四周種植著高大的落葉樹 (trees). 
往東隱約可以看到高大的紀念碑.
LONG
	);
	set("night_long", @LONG
    濃密的樹蔭遮住了夜空, 在你四周種植著高大的落葉樹. 
你隱隱約約只看到四周黝黑樹幹的影子, 這裡幾乎伸手不見五指.
LONG
	);

	set("mov_cost", 50 );

	set("exits", ([ /* sizeof() == 3 */
		"east" : __DIR__"central_park_1",
		"south" : __DIR__"central_park_3",
		"west" : __DIR__"f_road_1",
	]));

	set("detail", ([
		"trees":
"你四周都是一些在秋天葉子會凋落的樹木. 你注意到在樹上有一團
鮮紅色的影子 (red image).\n",
		"red image":
"你仔細一看, 發現那一團紅色的影子是兩隻漂亮的小鳥, 身上大部
分是火紅的顏色, 而在胸腹間有著七彩的顏色.\n",
	]));
	set("objects", ([
		__DIR__"npc/park_dog" : 1 ]) );

	set("outdoors", 1);
	setup();
	replace_program(ROOM);
}
