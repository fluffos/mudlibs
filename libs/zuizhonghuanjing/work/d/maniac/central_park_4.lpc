// Room: /d/maniac/central_park_4.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "中央公園雕塑廣場");
	set("long", @LONG
    南方是一座有所殘缺的大理石鐘塔 (tower)  矗立在你面前, 圍
繞在塔周圍的是一尊尊的裸體人像 (statues). 每一尊人像或多或少
有些破損, 有男有女, 有老有少. 有的面容喜樂, 也有的哀悽而痛苦
. 而大理石塔的頂部有一座大時鐘 (clock).
    鐘塔的底部有一道木製的大門, 看來已經年久失修. 
LONG
	);

	set("mov_cost", 100 );
	set("exits", ([ /* sizeof() == 4 */
		"west" : __DIR__"central_park_3",
		"north" : __DIR__"central_park_1",
		"east" : __DIR__"central_park_5",
		"south" : __DIR__"central_park_tower_1",
]));

	set("detail", ([

		"tower":
"這座鐘塔大約有二十多公尺高, 用的是白色的大理石建材. 可是外表
上有許多累累的彈痕, 令人怵目驚心. 鐘塔的木門已有腐壞, 門上貼著
一張告示 (paper).\n",

		"statues":
"每座石像上都有累累的彈痕, 可以想見當年戰爭的激烈和悽慘.\n",

		"clock":
"時鐘上的指針已經停了, 停在三時五十二分上.\n",

		"paper":
"警告 :
由於鐘塔內部已經年久失修, 多所損壞, 請勿進入鐘塔內部.\n",
	]) );

	set("outdoors", 1);
	set("doors", ([
		"south"	:	([
				"data" : "鐘塔大門",
				"other_side_dir" : "north",
				"status" : DOOR_CLOSED,
				"key_id" : "maniac/tower_key",
				]),
	]) );//	create_door("south", "鐘塔大門", "north", DOOR_CLOSED, "maniac/tower_key");

	setup();
}

