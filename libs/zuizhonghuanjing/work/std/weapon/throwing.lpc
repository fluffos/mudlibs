// throwing.c

#include <weapon.h>

inherit COMBINED_ITEM;
inherit F_EQUIP;

varargs void init_throwing(int damage, int flag)
{
	if( clonep(this_object()) ) return;

	set("weapon_prop/damage", damage);
	set("flag", flag);
	set("unknown_type", "投擲武器");
	if( !query("max_durability") )
		set("max_durability", 50 );
	if( !query("durability") )
		set("durability", 50 );
	if( !query("attack") )
		set("attack", 80 );
	if( !query("defence") )
		set("defense", 5 );
	if( !query("armor_piercing") )
		set("armor_piercing", 10 );

	return;
}

void setup()
{
	// ::setup();
	seteuid(getuid());

	if( clonep(this_object()) ) return;

	set("damage_type", "traditional" );
	set("skill_type", "throwing");

	set("verbs", ({ "throw" }) );
}
