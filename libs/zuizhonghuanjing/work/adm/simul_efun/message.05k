// message.c
// Process message output.
// Author unknown.
// Last modified by Spock @ FF   97.Feb.19.

varargs void tell_vehicle( string msg, object vehicle, object target )
{
	string str;
	object *inv;
	int i, end_i;

	str = "  [" + vehicle->name() + "外] " + msg;
	inv = all_inventory( vehicle );

	end_i = sizeof( inv );
	for( i = 0; i < end_i; i++  ) {
		if( inv[i]->query("position") == "sleep")
			continue;
                if( target ) {
                        if( !inv[i]->visible( target ) ) {
                                if( target->is_vehicle() ) {
                                        str = replace_string( str, "$P", "某巨大物體");
                                        str = replace_string( str, "$N", "某巨大物體");
                                        str = replace_string( str, "$p", "某巨大物體");
                                        str = replace_string( str, "$n", "某巨大物體");
                                }
                                if( target->is_character() ) {
                                        str = replace_string( str, "$P", "某人");
                                        str = replace_string( str, "$N", "某人");
                                        str = replace_string( str, "$p", "某人");
                                        str = replace_string( str, "$n", "某人");
                                } else {
					str = replace_string( str, "$P", target->name());
					str = replace_string( str, "$N", target->name());
					str = replace_string( str, "$p", target->name());
					str = replace_string( str, "$n", target->name());
				}
                        } else {
				str = replace_string( str, "$P", target->name());
				str = replace_string( str, "$N", target->name());
				str = replace_string( str, "$p", target->name());
				str = replace_string( str, "$n", target->name());
                        }
                }
		message("outside", str, inv[i] );
	}
	return;
}

void tell_object( object ob, string str )
{
	message("tell_object", str, ob);
}

varargs void tell_room( mixed ob, string str, object *exclude)
{
	object *inv, *inside_inv;
	int i, j, end_i, end_j;
	int flag = 0;

	if( ob ) {
		end_i = sizeof( inv );
		for( i = 0; i < end_i; i++ ) {
			if( inv[i]->query("position") == "sleep")
				continue;
			end_j = sizeof( exclude );
			for( j = 0; j < end_j; j++ ) {
				if( inv[i] == exclude[j] ) {
					flag = 1;
					break;
				}
			}
			if( flag == 0 ) {
				if( inv[i]->is_vehicle() ) {
					tell_vehicle( str, inv[i], ob);
				} else {
					message("tell_room", str, inv[i]);
				}
			}
		}
	}
}

void shout(string str)
{
	message("shout", str, users(), this_player());
}

void write(string str)
{
	if( this_player() )
		message("write", str, this_player());
	else if( previous_object() )
		message("write", str, previous_object());
	else
		efun::write(str);
}

varargs void say(string str, mixed exclude)
{
	if( living(previous_object()) )
		message("say", str, environment(previous_object()), previous_object());
	else if( this_player() )
		message("say", str, environment(this_player()), this_player());
}

varargs void message_vision( string msg, object me, object you)
{
	string my_gender, your_gender, my_name, your_name;
	string str1, str2, str3;
	object *inv;
	int i, end_i;

// str1 is the message which object me receives.
// str2 is which object you receives.
// str3 is which to all objects present in environment excepts you and me.

	if( me->is_vehicle() ) {
		str1 = replace_string( msg,  "$P", me->name());
		str1 = replace_string( str1, "$N", me->name());

		if( !objectp( you ) )
	                tell_vehicle( str1, me );
	} else {
		my_name = me->name();
		my_gender = me->query("gender");
		str1 = replace_string( msg,  "$P", gender_self(my_gender));
		str1 = replace_string( str1, "$N", gender_self(my_gender));

		if( !objectp( you ) )
			message("vision", str1, me );
	}

	if( objectp( you ) ) {
		if( you->is_vehicle() ) {
			str2 = replace_string( msg,  "$p", you->name());
			str2 = replace_string( str2, "$n", you->name());

			tell_vehicle( str2, you, me );

			if( me->is_vehicle() ) {
				tell_vehicle( str1, me, you );
			} else {
				if( !me->visible( you )) {
					str1 = replace_string( str1, "$p", "某巨大物體");
					str1 = replace_string( str1, "$n", "某巨大物體");
				} else {
					str1 = replace_string( str1, "$p", you->name() );
					str1 = replace_string( str1, "$n", you->name() );
				}
			}

			if( me->query("position") != "sleep")
				message("vision", str1, me );
		} else {
			your_name = you->name();
			your_gender= you->query("gender");
			str2 = replace_string( msg,  "$p", gender_self(your_gender));
			str2 = replace_string( str2, "$n", gender_self(your_gender));

			if( !you->visible( me )) {
				str2 = replace_string( str2, "$P", "某人");
				str2 = replace_string( str2, "$N", "某人");
			} else {
				str2 = replace_string( str2, "$P", gender_pronoun(my_gender));
				str2 = replace_string( str2, "$N", my_name);
			}
			if( you->query("position") != "sleep")
				message("vision", str2, you);
			if( !me->visible( you )) {
				if( you->is_character() ) {
					str1 = replace_string( str1, "$p", "某人");
					str1 = replace_string( str1, "$n", "某人");
				} else {
					str1 = replace_string( str1, "$p", you->name() );
					str1 = replace_string( str1, "$n", you->name() );
				}
			} else {
				str1 = replace_string( str1, "$p", gender_pronoun(your_gender));
				str1 = replace_string( str1, "$n", your_name);
			}
			if( me->query("position") != "sleep")
				message("vision", str1, me );
		}
	}

	inv = all_inventory( environment( me ));
	end_i = sizeof( inv );
	for( i = 0; i < end_i; i++ ) {
		if( inv[i] == me || inv[i] == you )
			continue;
		if( inv[i]->query("position") == "sleep" )
			continue;
		if( inv[i]->visible( me )) {
			str3 = replace_string( msg,  "$P", me->name() );
			str3 = replace_string( str3, "$N", me->name() );
		} else if( me->is_character() ) {
			str3 = replace_string( msg,  "$P", "某人" );
			str3 = replace_string( str3, "$N", "某人" );
		} else if( me->is_vehicle() ) {
			str3 = replace_string( msg,  "$P", "某巨大物體" );
			str3 = replace_string( str3, "$N", "某巨大物體" );
		}
                if( you ) {
			if( inv[i]->visible( you )) {
				str3 = replace_string( str3, "$p", you->name() );
				str3 = replace_string( str3, "$n", you->name() );
			} else if( you->is_character() ) {
				str3 = replace_string( str3, "$p", "某人" );
				str3 = replace_string( str3, "$n", "某人" );
			} else if( you->is_vehicle() ) {
				str3 = replace_string( str3, "$p", "某巨大物體" );
				str3 = replace_string( str3, "$n", "某巨大物體" );
			} else {		
				str3 = replace_string( str3, "$p", you->name() );
				str3 = replace_string( str3, "$n", you->name() );
			}
		}
		if( inv[i]->is_vehicle() ) {
			tell_vehicle( str3, inv[i] );
		} else {
			message("vision", str3, inv[i] );
		}
	}
}

varargs void message_vision_exclude( string msg, object me, object *exclude )
{
	string my_gender, my_name;
	string str1, str3;
	object *inv;
	int i, j, end_i, end_j;
	int flag = 0;

// str1 is the message which object me receives.
// str3 is which to all objects present in environment excepts exclude objects.

	if( me->is_vehicle() ) {
		str1 = replace_string( msg,  "$P", me->name());
		str1 = replace_string( str1, "$N", me->name());

		end_j = sizeof( exclude );
		for( j = 0; j < end_j; j++ ) {
			if( me == exclude[j] ) {
				flag = 1;
				break;
			}
		}
		if( flag == 0 )
		        tell_vehicle( str1, me );
	} else {
		my_name = me->name();
		my_gender = me->query("gender");
		str1 = replace_string( msg,  "$P", gender_self(my_gender));
		str1 = replace_string( str1, "$N", gender_self(my_gender));

		end_j = sizeof( exclude );
		for( j = 0; j < end_j; j++ ) {
			if( me == exclude[j] ) {
				flag = 1;
				break;
			}
		}
		if( flag == 0 )
			message("vision", str1, me );
	}

	flag = 0;
	inv = all_inventory( environment( me ));
	end_i = sizeof( inv );
	for( i = 0; i < end_i; i++ ) {
		if( inv[i] == me )
			continue;
		if( inv[i]->query("position") == "sleep" )
			continue;
		end_j = sizeof( exclude );
		for( j = 0; j < end_j; j++ ) {
			if( inv[i] == exclude[j] ) {
				flag = 1;
				break;
			}
		}
		if( flag == 1 )
			continue;

		if( inv[i]->visible( me )) {
			str3 = replace_string( msg,  "$P", me->name() );
			str3 = replace_string( str3, "$N", me->name() );
		} else if( me->is_character() ) {
			str3 = replace_string( msg,  "$P", "某人" );
			str3 = replace_string( str3, "$N", "某人" );
		} else if( me->is_vehicle() ) {
			str3 = replace_string( msg,  "$P", "某巨大物體" );
			str3 = replace_string( str3, "$N", "某巨大物體" );
		}
		if( inv[i]->is_vehicle() ) {
			tell_vehicle( str3, inv[i] );
		} else {
			message("vision", str3, inv[i] );
		}
	}
}
