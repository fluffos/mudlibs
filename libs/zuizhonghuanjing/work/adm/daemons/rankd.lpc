// rankd.c

#include <ansi.h>

string query_rank(object ob)
{
	switch(ob->query("gender")) {
	case "女性":
		switch(wizhood(ob)) {
			case "(admin)":			return HIW "【壹級巫師】" NOR;
			case "(arch)":			return HIY "【貳級巫師】" NOR;
			case "(wizard)":		return HIG "【參級巫師】" NOR;
			case "(apprentice)":		return HIC "【實習巫師】" NOR;
			case "(immortal)":		return HIM "【見習巫師】" NOR;
			default:
				switch(ob->query("class")) {
					case "soldier":		return "【 軍  人 】";
					case "police":		return "【 警  察 】";
					case "doctor":		return "【 醫  師 】";
					case "scholar":		return "【 學  者 】";
					case "technician":	return "【 技  師 】";
					default:		return "【 平  民 】";
			}
		}
	default:
		switch(wizhood(ob)) {
			case "(admin)":			return HIW "【壹級工友】" NOR;
			case "(arch)":			return HIY "【貳級工友】" NOR;
			case "(wizard)":		return HIG "【參級工友】" NOR;
			case "(apprentice)":		return HIC "【實習工友】" NOR;
			case "(immortal)":		return HIM "【見習工友】" NOR;
			default:
				switch(ob->query("class")) {
					case "soldier":		return "【 軍  人 】";
					case "police":		return "【 警  察 】";
					case "doctor":		return "【 醫  師 】";
					case "scholar":		return "【 學  者 】";
					case "technician":	return "【 技  師 】";
					default:		return "【 平  民 】";
			}
		}
	}
}

string query_respect(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/respect")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "女性":
			{ /* was: switch(class) default-only */
				if( age < 18 ) return "小姑娘";
				else if( age < 50 ) return "女士";
				else return "婆婆";
			}
		case "男性":
		default:
			{ /* was: switch(class) default-only */
				if( age < 20 ) return "小兄弟";
				else if( age < 50 ) return "先生";
				else return "老爺";
			}
	}
}

string query_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/rude")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "女性":
			{ /* was: switch(class) default-only */
				if( age < 30 ) return "小賤人";
				else return "死老太婆";
			}
		default:
			{ /* was: switch(class) default-only */
				if( age < 20 ) return "小王八蛋";
				if( age < 50 ) return "混帳";
				else return "老王八";
			}
	}
}

