}

string query_self_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self_rude")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "女性":
			{ /* was: switch(class) default-only */
				if( age < 30 ) return "本姑娘";
				else return "老娘";
			}
		default:
			{ /* was: switch(class) default-only */
				if( age < 50 ) return "本大爺";
				else return "老子";
			}
