// water.c

inherit F_CONTAINER;

void create()
{
	set_name("開水", ({ "water" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一瓶裝在玻璃罐中, 煮過的開水.\n");
		set("unit", "瓶");
		set("value", 1 );
		set("max_liquid", 5 );
		set("destruct_if_empty", 1 );
	}

// The liquid contained in the container is independent, we set a copy
// in each cloned copy.
	set("liquid", ([
		"type": "water",
		"name": "清水",
		"remaining": 5,
	]) );
}
