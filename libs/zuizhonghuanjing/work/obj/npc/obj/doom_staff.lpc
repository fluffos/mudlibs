// doom_staff.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name( HIY "毀 滅 法 杖" NOR, ({ "doom_staff", "staff" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "一根金色的、約兩公尺長的法杖.\n");
		set("material", "gold");
		set("value", 100000);
	}
	init_staff(5, 10, 10, 2, 1);

	setup();
}
