// doromy.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name( HIR "毀滅女神" HIW "朵若密" NOR, ({ "doromy" }) );
	set("long",
		"毀滅女神朵若密的身影飄搖在你面前, 她高大的身軀襯著身上的黑袍, 眼中\n"
		"一股可怕的肅殺之氣壓迫得你喘不過氣來.\n");
	set("inquiry", ([
		"name": "吾即司掌毀滅之神----朵若密. 快離開 FF 吧! 人類 !",
		"job": "一級巫師召換吾神前來毀去宇宙萬物. 人類, 快離開 FF 吧 !",
	]) );

	set("gender", "女性");
	set("age", 35);
	set("pursuer", 1);

	set("str", 25);
	set("dex", 25);
	set("not", 25);
	set("int", 23);
	set("wis", 25);
	set("con", 25);
	set("cha", 25);
	set("tec", 10);

	set("dice_number", 20);
	set("dice_roll", 5);
	set("damage_bonus", 20);
	set("round", 2);
	set("legal_wield_weapon/maniac", 1 );

	set("level",1000);

	set_skill("staff", 100);
	set_skill("unarmed", 100);
	set_skill("parry", 100);
	set_skill("dodge", 100);

	set_temp("apply/attack", 10);
	set_temp("apply/defense", 10);

	setup();

	carry_object(__DIR__"obj/doom_staff")->wield();
	carry_object(__DIR__"obj/black_robe")->wear();
}

void start_shutdown( int min )
{
	if( geteuid(previous_object()) != ROOT_UID ) return;

	message("system",
		HIR "\n你聽到天空中隱隱傳來一陣可怖的聲音 ....\n"
		RED	"毀滅女神" HIW "朵若密" HIR "用她陰森的聲音說道:\n"
			"\t\t神之語, 命吾毀去一切有形之物.\n"
			"\t\t"+ CHINESE_D->chinese_number( min ) +"分鐘後, 汝等之宇宙將不復存.\n"
			"\t\t毀天滅地, 絕古滅今, 吾所職司 !\n" NOR,
		users() );
	call_out("countdown", 60, min);
}

private void countdown(int min)
{
	min--;
	if( min ) {
		message("system",
			RED "\n毀滅女神" HIW "朵若密" HIR "可怖的聲音再度傳來:\n"
				"\t\t再" + chinese_number(min) + "分鐘之期, 天地滅絕.\n"
				"\t\t汝等請儘速離去, 不可多所留戀.\n" NOR,
			users() );
		call_out("countdown", 60, min);
	} else {
		message("system",
			RED "\n毀滅女神" HIW "朵若密" HIR "低沈的聲音從天界傳來:\n"
				"\t\t古往今來, 天地四方, 宇宙洪荒, 一切殺滅!\n"
				"\t\t神威降臨! 毀天滅地!\n" NOR,
			users() );
		call_out("do_shutdown", 3);
	}
}

private void do_shutdown()
{
	message("system",
		RED "\n毀滅女神" HIW "朵若密" HIR "用她陰森森的聲音唱道:\n"
		HIW "\t\t神之怒火! 終極連鎖分解!!  ∼∼∼∼ !!\n"
		HIR "\t\t此時天空變得血紅, 不......你眼前的一切都變得血紅......\n"
			"\t\t所有的一切都在瞬間陷入火海......\n"
			"\t\t熾熱的火燄, 灼燒著你的全身, 永無止盡......\n" NOR,
		users() );
	shutdown(0);
}

void die()
{
	object ob;

	if( !ob = query_temp("last_damage_from") )
		ob = this_player(1);

	if( !ob ) return;

	message("system",
		HIR "\n\n你聽到一聲冰冷的聲音在天空中迴盪著.\n"
		RED "毀滅女神" HIW "朵若密" HIR "喊著: 滅神的 " NOR + ob->name(1) + HIR ", 汝等必遭天譴∼∼∼\n"
			"然後一道火柱呼嘯著衝上雲端, 大地又恢復了寧靜.\n" NOR,
		users() );
	destruct(this_object());
}
