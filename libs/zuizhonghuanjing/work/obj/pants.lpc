// pants.c
//
// This is the basic equip for players.

#include <armor.h>

inherit PANTS;

void create()
{
	set_name("長褲", ({ "pants" }) );
        set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long",
"一套普通的麻布長褲.\n");
                set("material", "麻布");
                set("value", 30);
		set("armor_prop/traditional_armor", 1);
	}
	setup();
}
