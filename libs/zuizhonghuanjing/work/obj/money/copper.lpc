// coin.c

inherit MONEY;

void create()
{
        set_name("銅幣", ({"copper", "coin", "copper_coin", "copper_money" }));
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("money_id", "copper");
		set("long", "這是流通單位最小的貨幣, 約要一百枚銅幣才值得一枚銀幣.\n");
		set("unit", "些");
		set("base_value", 1);
		set("base_unit", "枚");
                set("base_weight", 3);
	}
	set_amount(1);
}

