// silver.c

inherit MONEY;

void create()
{
        set_name("銀幣", ({"silver", "silver_coins", "silver_money"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "silver");
                set("long", "梅尼亞克市鑄造的銀幣, 份量和純度十足.\n");
		set("unit", "些");
		set("base_value", 100);
		set("base_unit", "枚");
		set("base_weight", 5);
	}
	set_amount(1);
}

