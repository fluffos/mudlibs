// cloak.c

#include <armor.h>

inherit CLOAK;

void create()
{
	set_name("披風", ({ "cloak" }) );
        set_weight(1200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long",
"一件普通的麻布披風.\n");
                set("value", 40);
		set("armor_prop/traditional_armor", 2);
	}
	setup();
}
