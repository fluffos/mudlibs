// jelly_bread.c

inherit F_FOOD;

void create()
{
	set_name("果醬麵包", ({ "jelly bread", "jelly", "bread" }) );
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一塊塗著蘋果果醬的小麵包.\n");
		set("unit", "塊");
		set("value", 3 );
		set("food/remaining", 5 );
		set("food/supply", 10 );
		set("food/water", 3 );
	}
	setup();
}
