// sandwich.c

inherit F_FOOD;

void create()
{
	set_name("三明治", ({ "sandwich" }) );
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一份有各種蔬菜和肉片的綜合三明治.\n");
		set("unit", "份");
		set("value", 4 );
		set("food/remaining", 5 );
		set("food/supply", 10 );
		set("food/water", 6 );
	}
	setup();
}
