// chinese_meal.c

inherit F_FOOD;

void create()
{
	set_name("中式套餐", ({ "chinese meal", "chinese", "meal" }) );
	set_weight(750);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一份有「蔥爆牛肉」、「蝦仁滑蛋」、「金鑲玉板」三道菜的中式套餐.\n");
		set("unit", "份");
		set("value", 8 );
		set("food/remaining", 12 );
		set("food/supply", 15 );
		set("food/water", 10 );
	}
	setup();
}
