// vehicle.c

#include <vehicle.h>

inherit GROUND_CAR;

void create()
{
	set_name("測試用車", ({"car"}));
	set_weight( 100000);
	set_max_encumbrance( 500000);
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "輛");
		set("long", "這是一輛測試用的車子.\n");
		set("inside_look", "這只是輛最簡陋的車子.\n");
		set("skill_type", "drive");
		set("value", 1000000);

		set("armors_hit", ({ 300, 150, 100, 100, 50,}));
		set("armors_max_hit", ({ 300, 150, 100, 100, 50,}));

		set("fuel", 1000);
		set("material", "鋼");
	}
	setup();
}
