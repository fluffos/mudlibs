// trash.c

inherit ITEM;

int decayed;

void create()
{
	set_name("廢鐵的殘骸", ({ "a pile of trash", "trash" }) );
	set("long", "這是一堆廢鐵的殘骸.\n");
	set("unit", "堆" );
	decayed = 0;
	if( clonep(this_object()) ) call_out("decay", 120, 1);
}

int is_trash() { return decayed < 2; }
int is_vehicle() { return decayed < 1; }
int is_container() { return 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void decay(int phase)
{
	decayed = phase;
	switch(phase) {
		case 1:
			say( query("name") + "開始生鏽了.\n" );
			set("long",	"這堆生鏽的殘骸顯然已經在這裡好一段時間了.\n");
			call_out("decay", 120, phase + 1);
			break;
		case 2:
			say( query("name") + "已經鏽朽了.\n" );
			set_name("一堆生鏽的廢鐵", ({ "metal", "trash" }) );
			set("long", "這堆廢鐵已經在這裡很久了.\n");
			call_out("decay", 60, phase + 1);
			break;
		case 3:
			say( "一陣風吹過, 把" + query("name") + "吹散了.\n" );
			destruct(this_object());
			break;
	}
}

