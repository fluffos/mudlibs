// wizard_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("工友留言板", ({ "board" }) );
	set("board_id", "wizard_b");
	set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "這是一個供各位工友留言記事的留言板.\n" );
		set("unit", "個");
		set("capacity", 100);
		set("value", 10 );
	}
	setup();
}
