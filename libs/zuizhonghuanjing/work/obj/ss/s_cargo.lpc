// s_cargo.c

#include <space_ship.h>

inherit SMALL_CARGO_SHIP;

void create()
{
	set_name("測試用宇宙船", ({"cargo ship", "cargo", "ship"}));
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("no_get", 1 );
		set("unit", "艘");
		set("long", "這是一艘測試用的小型宇宙貨船.\n");
		set("inside_look", "這只是輛最簡陋的小型宇宙貨船.\n");
		set("boarding_tube", "/obj/ss/s_cargo_1" );
		set("skill_type", "pilot_ss");
		set("value", 1000000000);

		set("max_velocity", 10);
	}
	seteuid( getuid() );

	make_inventory("/obj/ss/s_cargo_1");
	make_inventory("/obj/ss/s_cargo_2");

	setup();

	return;
}
