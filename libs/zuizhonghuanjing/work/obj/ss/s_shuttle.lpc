// s_shuttle.c

inherit SHUTTLE;

void create()
{
	set_name("小型太空梭", ({"small shuttle", "small", "shuttle"}));
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("no_get", 1 );
		set("unit", "艘");
		set("long", "這是一艘最輕型的太空梭.\n");
		set("boarding_tube", ({ "/obj/ss/s_shuttle_1",}) );
		set("bridge", ({ "/obj/ss/ss_shuttle_1", }) );
		set("skill_type", "pilot_ss");
		set("value", 10000000);

		set("lock", 0 );
		set("objects", ({
			"/obj/ss/s_shuttle_1",
		}) );
	}

	setup();

	return;
}
