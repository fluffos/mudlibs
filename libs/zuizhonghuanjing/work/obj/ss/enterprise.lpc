// enterprise.c
// Star ship Enterprise
// Author: Spock @ FF	98.Aug.31.
// Lastmodified by Spock @ FF	98.Aug.31.

inherit SPACE_SHIP;

void create()
{
	set_name("企業號 NCG-1701", ({"enterprise", "NCG-1701", "ncg", "1701"}));
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("no_get", 1 );
		set("unit", "艘");
		set("long", "聯邦星艦企業號, 有著巨大的碟型艦首, 兩具曲速引擎分別連接在船身兩旁.\n");
		set("boarding_tube", ({ "/obj/ss/enterprise_3",}) );
		set("bridge", ({ "/obj/ss/enterprise_1", }) );
		set("value", 10000000);

		set("max_velocity", 10);
		set("lock", 0 );
		set("objects", ({
			"/obj/ss/enterprise_1",
			"/obj/ss/enterprise_2",
			"/obj/ss/enterprise_3",
			"/obj/ss/enterprise_4",
			"/obj/ss/enterprise_5",
		}) );
	}

	setup();

	return;
}
