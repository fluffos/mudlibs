// dagger.c

#include <weapon.h>

inherit DAGGER;

void create()
{
	set_name("匕首", ({ "dagger" }) );
	set_weight(1500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
                set("long", "這是一把鋼製的匕首.\n");
		set("value", 600);
                set("material", "鋼");
                set("wield_msg", "$N「唰」地一聲抽出一把 $n 握在手中.\n");
                set("unwield_msg", "$N 將手中的 $n 插入腰間的刀鞘.\n");
	}
        init_dagger(1, 6, 3, 1, 1);
	setup();
}
