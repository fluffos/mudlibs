// chicken_leg.c

inherit F_FOOD;

void create()
{
	set_name("烤雞腿", ({ "fried chicken leg", "chicken", "leg" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一枝烤得香噴噴的雞腿, 令人看了直吞口水.\n");
		set("unit", "根");
		set("value", 10);
		set("food/remaining", 4 );
		set("food/supply", 40 );
		set("food/water", 5 );
	}
	setup();
}

int finish_eat()
{
	set_name("啃得精光的雞腿骨頭", ({ "bone" }) );
	set_weight(150);
	set("long", "一根啃得精光的雞腿骨頭.\n");
	return 1;
}
