// updatep.c
// 辅助编译一个目录下的 .lpc 档案。
//
// 2026-09-13 重构（改用驱动内建的 promise / async 能力）
//
// 一、修正 .lpc 后缀判定
//     原式  files[i][(size - 2)..size] == ".lpc"
//     在本驱动恒不成立：arr[a..b] 实际取到的是 a+1..b
//     （实测 "foo.lpc"[5..7] == "pc"），长度也差一位。
//     结果是这个指令从来没编译过任何档案（total 恒为 0）。
//
// 二、改成 async 分片编译
//     每个档案之间 await async_yield() 让出事件回圈一次：
//       * 每个 resumption 都拿到全新的 evaluation budget，
//         所以目录再大也不会撞上 "too long evaluation"；
//         （原本的 set_eval_limit(1) 在本驱动是空操作，
//           它只回传目前的 maximum evaluation cost）
//       * 中间驱动照常 poll socket、跑 timer，不卡住其他连线。
//     main() 本身不能是 async：命令解析器会把回传 promise 的动词函数
//     当作「拒绝执行」（见 docs/concepts/general/async.md），
//     所以由 main() 启动 worker 后立刻返回。
//
// 三、已载入的档案默认改用 recompile_object() 就地热更新
//     master copy 与所有 clone 一起换掉，变数状态、物件身份、库存、
//     heart_beat、call_out 全部保留
//     （见 docs/concepts/general/hot_reload.md）。
//     原本的 destruct() + load_object()（会归零状态、碰不到 clone）
//     保留为 -f。
//
// 四、-s 智慧跳过
//     原始码与它 include 过的标头档都没动过，而且整条祖先链也没动过，
//     才跳过；要重编时按「父类优先」的顺序连祖先一起编，
//     否则子类会绑到记忆体里过期的父类 program。
//
// 用法：updatep [-safRqk] [目录]
//
// 五、-a 连祖先链；「强制全部重编」不需要旗标
//     -s 才会跳过没变动的档案。不加 -s 时目录里每个 .lpc 都会重编一次，
//     但预设只编档案自己；要连 /std/、/feature/ 这类父类也强制重编一遍，
//     就加 -a（父类优先，同一个档案整批只编一次）。

#include <ansi.h>
#include <stat.h>

inherit F_CLEAN_UP;

#define UP_SMART   1
#define UP_FORCE   2
#define UP_RECURSE 4
#define UP_QUIET   8
#define UP_KILL   16
#define UP_ALL    32

// 正在跑的那一批的 promise。用来避免同时跑两批，也用来实现 -k 取消。
// promise_status() == 0 表示还在跑；被取消后是 3（cancelled，见 bin/docs 的
// promise_cancel：这颗驱动器比纯源码树的文档更新，已支持取消）。
promise running;

// 我们自己记录的「上次编完时的内容签名」：真实路径 -> 签名字串。
// 不用驱动 stat() 的第 2 项（该档物件的编译时间）当基准，因为
// recompile_object() 不会刷新它（实测 before == after），
// 会让「改过又编过」的档案永远看起来是脏的、每次 -s 都重编一次。
//
// 全域 mapping 一开始是 null，所以用一个 int 旗标来判断要不要建立
// （不用 mappingp()：本 mudlib 没有这个 efun；也不用 !snapshots：
//   空容器在 LPC 里的真假语义不值得赌）。
mapping snapshots;
int snapshots_ready;

// ------------------------------------------------------------------
// 小工具
// ------------------------------------------------------------------

// 字串是否以 suffix 结尾。用 strsrch(...,-1) 找最后一次出现的位置，
// 不依赖 arr[a..b] 的边界语义。
private int ends_with(string s, string suffix) {
  int n;

  n = sizeof(suffix);
  if (sizeof(s) < n) return 0;
  return strsrch(s, suffix, -1) == sizeof(s) - n;
}

// 把 inherit_list() / include_list() 给的拼写还原成真正存在的档案路径。
// 搜寻路径可能产生双斜线；inherit_list() 不给副档名。
private string real_file(string f) {
  string g;

  if (!stringp(f)) return 0;

  g = resolve_path("/", f);
  if (file_size(g) != -1) return g;
  if (file_size(g + ".lpc") != -1) return g + ".lpc";
  return 0;
}

// 解析 -safRqk；有看不懂的字元回传 -1。
private int parse_flags(string s) {
  string rest;
  int f;

  rest = s;
  rest = replace_string(rest, "-", "");
  rest = replace_string(rest, "s", "");
  rest = replace_string(rest, "f", "");
  rest = replace_string(rest, "R", "");
  rest = replace_string(rest, "q", "");
  rest = replace_string(rest, "k", "");
  rest = replace_string(rest, "a", "");
  if (sizeof(rest)) return -1;

  f = 0;
  if (strsrch(s, "s") != -1) f |= UP_SMART;
  if (strsrch(s, "f") != -1) f |= UP_FORCE;
  if (strsrch(s, "R") != -1) f |= UP_RECURSE;
  if (strsrch(s, "q") != -1) f |= UP_QUIET;
  if (strsrch(s, "k") != -1) f |= UP_KILL;
  if (strsrch(s, "a") != -1) f |= UP_ALL;
  return f;
}

// ------------------------------------------------------------------
// 目录梭巡
// ------------------------------------------------------------------

// 列出目录下的 .lpc（dir 必须以 / 结尾）。recurse 非 0 则连子目录。
private string *list_dir(string dir, int recurse) {
  mixed *info;
  string *out;
  int i;

  out = ({});
  info = get_dir(dir, -1);
  if (!pointerp(info)) return out;

  for (i = 0; i < sizeof(info); i++) {
    if (info[i][1] == -2) {                       // -2 == 子目录
      if (recurse) out += list_dir(dir + info[i][0] + "/", 1);
      continue;
    }
    if (ends_with(info[i][0], ".lpc")) out += ({ dir + info[i][0] });
  }

  return out;
}

// ------------------------------------------------------------------
// 脏判定：全部靠驱动自带的 stat() / include_list() / inherit_list()，
// 不需要自己维护任何时间戳表。
// ------------------------------------------------------------------

// 档案的「内容签名」= 自身原始码 + 它 include 过的所有标头档的最后修改时间。
// 标头档自己没有 program，没人会 reload 它，只能靠重编「包含过它」的档案。
// 读不到、或物件还没载入时回传 0（呼叫者一律当作脏）。
private string file_signature(string file) {
  object ob;
  string *headers, h, sig;
  mixed *info;
  int i;

  info = stat(file);
  if (!pointerp(info) || sizeof(info) != 4) return 0;
  if (!intp(info[STAT_LAST_MODIFIED])) return 0;

  sig = "" + info[STAT_LAST_MODIFIED];

  ob = find_object(file);
  if (!objectp(ob)) return 0;

  headers = include_list(ob);
  for (i = 0; i < sizeof(headers); i++) {
    h = real_file(headers[i]);
    if (!stringp(h)) return 0;

    info = stat(h);
    if (!pointerp(info) || sizeof(info) != 4) return 0;
    if (!intp(info[STAT_LAST_MODIFIED])) return 0;

    sig += ":" + info[STAT_LAST_MODIFIED];
  }

  return sig;
}

// 这个档案需要重编吗？任何读不到的情况一律当作脏（宁多编不漏编）。
private int source_changed(string file, mapping snap) {
  mixed *info;
  string real, sig;

  real = real_file(file);
  if (!stringp(real)) return 1;

  sig = file_signature(real);
  if (!stringp(sig)) return 1;

  if (snap[real] == sig) return 0;              // 我们编过，而且之后没变
  if (snap[real]) return 1;                     // 我们编过，签名变了

  // 还没记录过（例如本次开机后没编过）：退回驱动自己的判据当基准
  info = stat(real);
  if (!pointerp(info) || sizeof(info) != 4) return 1;
  if (!intp(info[STAT_LAST_MODIFIED])) return 1;

  return (info[STAT_LAST_MODIFIED] >= info[STAT_TIME_OBJECT_LOADED]);
}

// file 自己、或它的任何祖先需要重编吗？memo: 1=要, 2=不要
private int need_reload(string file, mapping memo, mapping snap) {
  object ob;
  string real, *parents;
  int i;

  real = real_file(file);
  if (!stringp(real)) return 0;
  if (memo[real] == 1) return 1;
  if (memo[real] == 2) return 0;

  memo[real] = 2;                               // 先占位，防继承成环时死循环
  if (source_changed(real, snap)) {
    memo[real] = 1;
    return 1;
  }

  ob = find_object(real);
  if (!objectp(ob)) {                           // 没载入过 -> 当作要编
    memo[real] = 1;
    return 1;
  }

  parents = inherit_list(ob);
  for (i = 0; i < sizeof(parents); i++) {
    if (need_reload(parents[i], memo, snap)) {
      memo[real] = 1;
      return 1;
    }
  }

  return 0;
}

// 依「父类优先」顺序，回传 file 与需要重编的祖先（去重）。
// 注意：这里必须「回传」新阵列，不能用 out 参数。
// LPC 的 out += ({...}) 只是把参数这个局部变数重新绑定到新阵列，
// 呼叫者手上的阵列不会变 —— 用参数当输出会让编辑清单静默变空。
private string *gather_reload(string file, mapping memo, mapping seen, mapping snap) {
  object ob;
  string real, *parents, *out;
  int i;

  real = real_file(file);
  if (!stringp(real) || seen[real]) return ({});

  seen[real] = 1;
  out = ({});

  ob = find_object(real);
  if (objectp(ob)) {
    parents = inherit_list(ob);
    for (i = 0; i < sizeof(parents); i++) {
      if (need_reload(parents[i], memo, snap))
        out += gather_reload(parents[i], memo, seen, snap);
    }
  }

  return out + ({ real });
}

// 同上，但不做任何变更检测：把 file 与它整条祖先链都收进来（父类优先）。
// -a 用的就是这一支。
private string *gather_all(string file, mapping seen) {
  object ob;
  string real, *parents, *out;
  int i;

  real = real_file(file);
  if (!stringp(real) || seen[real]) return ({});

  seen[real] = 1;
  out = ({});

  ob = find_object(real);
  if (objectp(ob)) {
    parents = inherit_list(ob);
    for (i = 0; i < sizeof(parents); i++)
      out += gather_all(parents[i], seen);
  }

  return out + ({ real });
}

// ------------------------------------------------------------------
// 重载
// ------------------------------------------------------------------

// 正在执行中的物件不能就地换 program（驱动会拒绝），先挡掉。
private int is_running_file(string file, object ob) {
  string base;

  if (!objectp(ob)) return 0;

  base = base_name(ob);
  return (file == base || file == base + ".lpc");
}

// 重新载入一个档案。成功回传 0，失败回传错误字串。
private string reload_one(string file, int force) {
  object obj, *inv, *moved;
  string err;
  int i;

  if (force) {
    // 传统做法：destruct 旧物件再重新载入（全域变数归零、clone 不跟著换）
    obj = find_object(file);
    moved = ({});

    if (objectp(obj)) {
      // 玩家与玩家的附身兽先搬去 VOID_OB，编完再搬回来；
      // 其余库存照旧 destruct（重编后由 reset() 重新生成）
      inv = all_inventory(obj);
      for (i = 0; i < sizeof(inv); i++) {
        if (userp(inv[i]) || inv[i]->query("possessed")) {
          inv[i]->move(VOID_OB, 1);
          moved += ({ inv[i] });
        } else {
          destruct(inv[i]);
        }
      }

      destruct(obj);
      if (obj) return "无法清除旧程式码。";
    }

    err = catch(load_object(file));
    if (!err && !objectp(find_object(file)))
      err = "载入后找不到物件，编译可能失败（详细错误见 log/log）。";

    if (!err) {
      obj = find_object(file);
      for (i = 0; i < sizeof(moved); i++) {
        if (moved[i]) moved[i]->move(obj, 1);
      }
    }

    return err ? (stringp(err) ? err : sprintf("%O", err)) : 0;
  }

  obj = find_object(file);

  // 还没载入过的档案，单纯载入一次。
  // 注意 load_object() 编译失败时丢出的错误是笼统的 "*No program in object ..."，
  // 真正的编译错误在处理过程中就被 master 的 error_handler 写进 log/log，
  // LPC 这边拿不到，所以这里再确认一次物件是否真的存在
  // （档案不存在时 load_object() 甚至回传 0 而不报错）。
  if (!objectp(obj)) {
    err = catch(load_object(file));
    if (!err && !objectp(find_object(file)))
      err = "载入后找不到物件，编译可能失败（详细错误见 log/log）。";
    return err ? (stringp(err) ? err : sprintf("%O", err)) : 0;
  }

  // 已载入：就地换掉 program（master copy 与所有 clone 一起换），
  // 物件身份与变数状态都保留。
  err = catch(recompile_object(obj));
  return err ? (stringp(err) ? err : sprintf("%O", err)) : 0;
}

// ------------------------------------------------------------------
// 异步 worker
// ------------------------------------------------------------------

// 逐档编译，每档之间让出事件回圈一次。
async void compile_dir(object me, string dir, string *files, int flags) {
  int i, j, total, ok, failed, skipped, cancelled;
  string file, err, sig;
  string *targets, *failures;
  mapping memo, seen, reloaded;

  total = sizeof(files);
  ok = 0;
  failed = 0;
  skipped = 0;
  cancelled = 0;

  // 全域 mapping 初始是 null，第一次用到要先建好
  if (!snapshots_ready) {
    snapshots = ([]);
    snapshots_ready = 1;
  }

  failures = ({});
  memo = ([]);
  reloaded = ([]);

  for (i = 0; i < total; i++) {
    // 先让出回圈：main() 立刻回到玩家手上，
    // 之后每一个档案都在自己的 evaluation budget 里编。
    //
    // 用 acatch 把「取消请求」接下来：promise_cancel() 会在 await 处抛出
    // "*async function cancelled"，接住它之后这个 promise 会正常 fulfilled
    // （而不是变成 cancelled 状态），所以还能把统计好好印完再收工。
    err = acatch(await async_yield());
    if (err) {
      cancelled = 1;
      break;
    }

    if (!me) return;                            // 玩家断线就停手

    file = files[i];

    if (is_running_file(file, me) || is_running_file(file, this_object())) {
      skipped++;
      tell_object(me, "  跳过（正在执行中）" + file + "\n");
      continue;
    }

    if (flags & UP_SMART) {
      // 智慧：先看自己与整条祖先链有没有变动，没变就跳过。
      // （-a 管的是「要动的时候动多大范围」，不是「要不要动」，
      //   所以这里不看 -a，否则智慧就失去意义了。）
      if (!need_reload(file, memo, snapshots)) {
        skipped++;
        continue;
      }
      seen = ([]);
      targets = (flags & UP_ALL) ? gather_all(file, seen)
                                 : gather_reload(file, memo, seen, snapshots);
    } else if (flags & UP_ALL) {
      // 强制：目录里每个档案都编，而且连整条祖先链一起（父类优先）。
      seen = ([]);
      targets = gather_all(file, seen);
    } else {
      // 强制全编，但只编档案自己。
      targets = ({ file });
    }

    for (j = 0; j < sizeof(targets); j++) {
      if (reloaded[targets[j]]) continue;       // 本次已经编过了
      // -a 会把祖先链也拉进来，里面可能有我们自己、或玩家正在执行的档案，
      // 一样不能就地换掉。
      if (is_running_file(targets[j], me) ||
          is_running_file(targets[j], this_object()))
        continue;

      err = reload_one(targets[j], flags & UP_FORCE);
      reloaded[targets[j]] = 1;

      if (err) {
        failed++;
        failures += ({ targets[j] });
        tell_object(me, HIR "  失败 " NOR + targets[j] + "\n");
        tell_object(me, "    " + err + "\n");
        // load_object()/recompile_object() 在编译失败时丢出的错误很笼统
        // （"*No program in object ..."），真正的编译错误被 master 的
        // error_handler 写进 log/log 了，这里提醒一下。
        if (strsrch(err, "program in object") != -1 ||
            strsrch(err, "loading object") != -1)
          tell_object(me, "    （详细编译错误见 log/log）\n");
      } else {
        ok++;
        // 记下编完时的内容签名，下一次 -s 就用它判断有没有变
        sig = file_signature(targets[j]);
        if (stringp(sig)) snapshots[targets[j]] = sig;
        if (!(flags & UP_QUIET)) tell_object(me, "  " + targets[j] + " => OK\n");
      }
    }
  }

  if (!me) return;

  tell_object(me, HIW "．．．" + dir + "文档夹编译完成。\n" NOR);
  tell_object(me, sprintf("　　　共梭巡到 %d 个档案：成功 %d、失败 %d、跳过 %d。\n",
    total, ok, failed, skipped));

  if (cancelled)
    tell_object(me, HIY "（已取消，只做到第 " + (ok + failed + skipped) + " 个。）\n" NOR);

  if (failed) {
    tell_object(me, HIR "以下档案编译失败：" NOR "\n");
    for (i = 0; i < sizeof(failures); i++) {
      tell_object(me, "  " + failures[i] + "\n");
    }
  }

  log_file("UPDATE_LOG",
    sprintf("(%s)\n%s updatep %s : ok=%d fail=%d skip=%d\n",
      ctime(time()), me->query("name"), dir, ok, failed, skipped));
}

// ------------------------------------------------------------------
// 指令入口
// ------------------------------------------------------------------

int main(object me, string arg) {
  string dir, flagstr, target, one, rest;
  string *files;
  int flags;

  seteuid(getuid());
  seteuid(geteuid(me));

  flagstr = 0;
  target = 0;

  if (stringp(arg) && sizeof(arg)) {
    // 开头的旗标可能分成多个词（例如 "updatep -s -R /d/"），全部吃掉，
    // 剩下的才是目录；也可以合并写成 "updatep -sR /d/"。
    target = arg;
    while (stringp(target) && sizeof(target) && strsrch(target, "-") == 0) {
      if (sscanf(target, "%s %s", one, rest) == 2) {
        flagstr = stringp(flagstr) ? flagstr + one : one;
        target = rest;
      } else {
        flagstr = stringp(flagstr) ? flagstr + target : target;
        target = 0;
        break;
      }
    }
  }

  if (stringp(flagstr)) {
    flags = parse_flags(flagstr);
    if (flags == -1)
      return notify_fail("不认识的旗标。只支持 -s（智慧跳过）、-a（连祖先链）、-f（旧式重载）、-R（连子目录）、-q（安静）、-k（取消）。\n");
  } else {
    flags = 0;
  }

  // -k：取消正在跑的那一批。
  // promise_cancel() 是合作式取消：批次会在下一个档案的 await 处收到错误而
  // 停下来，不会硬中断，所以收尾（统计、日志）仍然会跑到。
  if (flags & UP_KILL) {
    if (!promisep(running) || promise_status(running) != 0)
      return notify_fail("现在没有正在跑中的批次。\n");

    promise_cancel(running);
    write(HIW "已送出取消请求：这一批会在下一个档案之后停下来。\n" NOR);
    return 1;
  }

  if (promisep(running) && promise_status(running) == 0)
    return notify_fail("已经有一批在跑了；要停下来请先用 updatep -k。\n");

  if (!stringp(target)) target = me->query("cwd");
  if (!stringp(target))
    return notify_fail("请指定目录名，例如 updatep /d/baiyun/。\n");

  dir = resolve_path(me->query("cwd"), target);
  if (file_size(dir) != -2)
    return notify_fail("没有这个文档夹：" + dir + "\n");
  if (!ends_with(dir, "/")) dir += "/";

  files = list_dir(dir, flags & UP_RECURSE);
  files = sort_array(files, 1);

  write(HIW "正在梭巡" + dir + "文档夹．．．\n" NOR);

  if (!sizeof(files)) {
    write("．．．这个文档夹里没有 .lpc 档案。\n");
    return 1;
  }

  write(sprintf("共找到 %d 个 .lpc 档案，开始分批编译（不会卡住其他连线）。\n",
    sizeof(files)));

  // main() 不能是 async，所以交给 worker 去做，这里立刻返回。
  // worker 会先 await async_yield() 让出一次，所以玩家马上拿到提示符号。
  running = compile_dir(me, dir, files, flags);

  // 观察这个 promise：worker 里任何没被拦下来的错误都在这里回报给玩家，
  // 而不是只留下 "Unhandled promise rejection" 在 debug log 里。
  // （promise_then(p, 0, f) 是错的：给了第 3 个参数时第 2 个就必须是函式，
  //   所以只挂 rejection 处理只能用 promise_catch。）
  promise_catch(running, function(mixed err) {
    object who;

    who = this_player();          // 挂上处理函式时的 this_player() 会被还原
    if (!who) return;

    if (stringp(err) && strsrch(err, "cancelled") != -1)
      tell_object(who, HIY "批次已取消。\n" NOR);
    else
      tell_object(who, HIR "批次异常中断：" + sprintf("%O", err) + "\n" NOR);
  });

  return 1;
}

int help(object me) {
  write(@HELP
[0;1;37m────────────────────────────────[0m
[0;1;36m巫师指令格式 : 	updatep [-safRqk] [目录]	[0m
[0;1;37m────────────────────────────────[0m

编译一个目录下的所有 .lpc 档案，不指定目录时使用当前工作目录（cwd）。

-s	智慧更新：只重新编译「原始码或它 include 过的标头档已经变动」的
	档案，以及因为继承而变脏的祖先与子档。没变的一律跳过。
	不加 -s 就是强制全部重编：目录里每个 .lpc 都会重新编译一次，
	不看有没有改动。
-a	连整条祖先链一起编（父类优先）。不加时只编目录里的档案自己，
	所以想连 /std/、/feature/ 这类父类也强制重编一遍就用它。
-k	取消正在跑的那一批（合作式取消：会在下一个档案之后停下来）。
	同一个时间只允许跑一批。
-f	改采旧式的 destruct + 重新载入（全域变数会归零、clone 不跟著
	换）。不指定时改用驱动内建的 recompile_object() 就地热更新，
	状态与物件身份都保留。
-R	连子目录一起梭巡。
-q	安静：只报告失败的档案与最后总结。

每个档案之间会让出事件回圈一次，所以再大的目录也不会「too long
evaluation」，也不会卡住其他连线；玩家断线时自动停手。

updatep /d/baiyun/	编译 /d/baiyun/ 下的所有档案。
updatep -sR /d/		递归梭巡 /d/，只编译变动过的档案。
[0;1;37m────────────────────────────────[0m
HELP
  );
  return 1;
}