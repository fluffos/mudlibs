// tail.c

inherit F_CLEAN_UP;

string tail_file(string file);
int help(object me);

int main(object me, string arg) {
  string file;

  seteuid(geteuid(me));
  if (!arg) return help(me);
  file = resolve_path(me->query("cwd"), arg);
  if (file_size(file) < 0) return notify_fail("没有这个档案。\n");
  write(tail_file(file));
  return 1;
}

// fluffos 没有 tail() efun，这里用 read_file 实现（取末尾 20 行）
string tail_file(string file) {
  string content, out;
  string *lines;
  int i, start;

  content = read_file(file);
  if (!content) return "没有这个档案。\n";
  lines = explode(content, "\n");
  start = sizeof(lines) - 20;
  if (start < 0) start = 0;
  out = "";
  for (i = start; i < sizeof(lines); i++)
    out += lines[i] + "\n";
  return out;
}

int help(object me) {
  write(@HELP
[0;1;37m────────────────────────────────[0m
[0;1;36m巫师指令格式 : 	tail <档案>[0m
[0;1;37m────────────────────────────────[0m   

此指令可让你直接读取某档案最末尾的几行。

[0;1;37m────────────────────────────────[0m   
HELP
  );
  return 1;
}
