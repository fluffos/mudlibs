// Silencer@fengyun workgroup	June.2005
// Modified so it won't update "possessed pet". It doesn't care about player/non-player pet though.
//
// 2026-09-13  移植自 oxidus-mudlib 的 cmds/object/update.lpc：
//   -s   智慧更新：只重编「自身源码、或它 include 过的标头档变过」的档案，
//        以及因为继承而变脏的档案（继承图由深到浅走一遍）。
//   -r   连同直接父类一起重编。
//   -R   连同整棵继承树一起重编。
//   另加：错误会指出是图里哪个档案失败、跳过数量统计、禁止更新 update 指令自己。
//   判脏依据是驱动自带的 stat() 第 2 项（该档物件编译时间）与 include_list()，
//   不需要自己维护任何时间戳表。

#include "/doc/help.h"
#include <stat.h>

inherit F_CLEAN_UP;

int update_player(object me);
private string *leaf_list(object ob, int recurse);
private string *build_graph(string file, object ob, string kind);
private string *uniq_list(string *list);
private string *prune_graph(string *graph, string anchor);
private int source_changed(string file);
private int includes_changed(string file, int loaded);
private int inherits_stale(string file, mapping stale);
private string reload_one(string file);

int main(object me, string arg) {
  string kind, flag, rest, target, file, err;
  string *graph, *kept;
  object obj, *inv, *moved;
  int i, skipped;

  seteuid(geteuid(me));

  if (wiz_level(me) < 4)
    return notify_fail("你的权限不能重新编译文件。\n");

  kind = "single";
  target = arg;

  if (target && sizeof(target) > 1 && target[0] == '-') {
    if (sscanf(target, "%s %s", flag, rest) == 2)
      target = rest;
    else {
      flag = target;
      target = 0;
    }

    switch (flag) {
      case "-s": kind = "smart";   break;
      case "-r": kind = "shallow"; break;
      case "-R": kind = "deep";    break;
      default:
        return notify_fail("参数只支持 -s（智慧）、-r（含父类）、-R（含整棵继承树）。\n");
    }
  }

  if (!target) target = me->query("cwf");
  if (!target)
    return notify_fail("你要重新编译什麽档案？\n");

  if (environment(me) && (obj = present(target, environment(me))) && interactive(obj))
    return update_player(obj);

  if (target == "me")
    return update_player(me);

  file = resolve_path(me->query("cwd"), target);
  if (!sscanf(file, "%*s.lpc")) file += ".lpc";

  if (file_size(file) == -1)
    return notify_fail("没有这个档案。\n");

  me->set("cwf", file);

  obj = find_object(file);
  if (objectp(obj) && obj == environment(me) && file_name(obj) == VOID_OB)
    return notify_fail("你不能在 VOID_OB 里重新编译 VOID_OB。\n");

  graph = build_graph(file, obj, kind);

  if (member_array(base_name(this_object()), graph) != -1 ||
      member_array(base_name(this_object()) + ".lpc", graph) != -1)
    return notify_fail("不能用这个方式更新 update 指令自己，请先 dest 它，下次使用时会自动载入。\n");

  skipped = 0;
  if (kind == "smart") {
    kept = prune_graph(graph, file);
    skipped = sizeof(graph) - sizeof(kept);
    graph = kept;
  }

  // 先把目标物件里的玩家搬到 VOID_OB，重编完成后再搬回来
  moved = ({});
  if (objectp(obj)) {
    inv = all_inventory(obj);
    for (i = 0; i < sizeof(inv); i++) {
      if (userp(inv[i]) || inv[i]->query("possessed")) {
        inv[i]->move(VOID_OB, 1);
        moved += ({ inv[i] });
      } else {
        destruct(inv[i]);
      }
    }
  }

  if (skipped)
    printf("智慧更新：跳过 %d 个未变更的档案。\n", skipped);

  err = 0;
  for (i = 0; i < sizeof(graph); i++) {
    err = reload_one(graph[i]);
    if (err) {
      printf("重新编译 %s 失败（%s）：\n%s\n", file, graph[i], err);
      break;
    }
    write("  " + graph[i] + " => OK\n");
  }

  if (err)
    return 1;

  write("重新编译 " + file + "：成功！\n");
  log_file("UPDATE_LOG", sprintf("(%s)\n%s updated %s\n", ctime(time()), me->query("name"), file));

  if (obj = find_object(file)) {
    for (i = 0; i < sizeof(moved); i++)
      if (moved[i] && (userp(moved[i]) || moved[i]->query("possessed")))
        moved[i]->move(obj, 1);
  }

  return 1;
}

// 由深到浅收集继承图（先收子节点，再收自己）
private string *leaf_list(object ob, int recurse) {
  string *result, *list;
  int i;

  result = ({});
  if (!objectp(ob)) return result;

  list = inherit_list(ob);
  if (recurse) {
    for (i = 0; i < sizeof(list); i++)
      result += leaf_list(load_object(list[i]), recurse);
  }
  if (sizeof(list)) result += list;

  return result;
}

// 去重（保留原顺序）：fluffos 没有 uniq_array()，unique_array() 是分组，语义不同
private string *uniq_list(string *list) {
  string *result;
  int i;

  result = ({});
  for (i = 0; i < sizeof(list); i++)
    if (member_array(list[i], result) == -1)
      result += ({ list[i] });

  return result;
}

private string *build_graph(string file, object ob, string kind) {
  string *graph;

  graph = ({});

  if (kind != "single" && objectp(ob)) {
    if (kind == "shallow")
      graph = leaf_list(ob, 0);
    else
      graph = leaf_list(ob, 1);
  }

  graph += ({ file });

  return uniq_list(graph);
}

// 只留下「脏」的档案，以及继承链上被带脏的。图是最深优先，所以只看直接父类就够。
private string *prune_graph(string *graph, string anchor) {
  mapping stale;
  string *kept, f;
  int i;

  stale = ([]);
  kept = ({});

  for (i = 0; i < sizeof(graph); i++) {
    f = graph[i];
    if (f != anchor && !source_changed(f) && !inherits_stale(f, stale))
      continue;
    stale[f] = 1;
    kept += ({ f });
  }

  return kept;
}

// 源码比编译产物新吗？头档变过也算。任何读不到的情况一律当作脏（宁多编不漏编）。
private int source_changed(string file) {
  mixed *info;

  info = stat(file);
  if (!pointerp(info) || sizeof(info) != 4) return 1;
  if (!intp(info[STAT_LAST_MODIFIED])) return 1;
  if (info[STAT_LAST_MODIFIED] >= info[STAT_TIME_OBJECT_LOADED]) return 1;

  return includes_changed(file, info[STAT_TIME_OBJECT_LOADED]);
}

// 标头档自己没有 program，没人会 reload 它，只能重编「包含过它」的档案。
private int includes_changed(string file, int loaded) {
  object ob;
  string *headers;
  mixed *info;
  int i;

  ob = find_object(file);
  if (!objectp(ob)) return 1;

  headers = include_list(ob);
  for (i = 0; i < sizeof(headers); i++) {
    // 搜寻路径解析可能产生双斜线，stat() 打不开
    info = stat(resolve_path("/", headers[i]));
    if (!pointerp(info) || sizeof(info) != 4) return 1;
    if (!intp(info[STAT_LAST_MODIFIED])) return 1;
    if (info[STAT_LAST_MODIFIED] >= loaded) return 1;
  }

  return 0;
}

// 继承了脏程式码的档案自己也是脏的
private int inherits_stale(string file, mapping stale) {
  object ob;
  string *parents;
  int i;

  ob = find_object(file);
  if (!objectp(ob)) return 1;

  parents = inherit_list(ob);
  for (i = 0; i < sizeof(parents); i++)
    if (stale[parents[i]]) return 1;

  return 0;
}

private string reload_one(string file) {
  object obj;
  string err;

  obj = find_object(file);

  if (objectp(obj)) {
    destruct(obj);
    if (obj) return "无法清除旧程式码。";
  }

  err = catch(load_object(file));
  if (err) return err;

  return 0;
}

int update_player(object me) {
  object env, link_ob, obj;

  env = environment(me);

  // First, create the new body.
  link_ob = me->query_temp("link_ob");
  obj = LOGIN_D->make_body(link_ob);
  if (!obj) return 0;

  // Save the data and exec the player to his/her link object.
  me->save();
  exec(link_ob, me);
  destruct(me);

  // Restore new body and exec to it via enter_world in LOGIN_D
  obj->restore();
  LOGIN_D->enter_world(link_ob, obj, 1);

  write("身体更新完毕。\n\n");
  obj->move(env);
  obj->write_prompt();

  return 1;
}

int help(object me) {
  write(@HELP
[0;1;37m────────────────────────────────[0m
[0;1;36m巫师指令格式 : 	update [-s|-r|-R] [<档名|me|玩家名>][0m
[0;1;37m────────────────────────────────[0m

这个指令可以更新档案, 并将新档的内容载入记忆体内. 若目标为
'me' 则更新自己的人物. 若目标为玩家则可更新玩家物件. 不指定
目标时使用上次更新的档案（cwf）。

-s  智慧更新：只重新编译「原始码或它 include 过的标头档已经变
    动」的档案，以及因为继承而跟着变脏的档案。
-r  连同直接父类一起重新编译。
-R  连同整棵继承树一起重新编译。

[0;1;37m────────────────────────────────[0m
 
HELP
  );
  return 1;
}
