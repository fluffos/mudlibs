/*
 * /z/Schiffe/Linienschiffe/i/make_skipper.c
 *
 * Kann von Schiffen verwendet werden, die sich von einem NPC-Skipper 
 * steuern lassen wollen.
 *
 * Mit
 *
 *	set_skipper(string filename, string bruecke)
 *
 * setzt man den Filenamen des Skippers und den Filenamne des command_rooms
 * des Schiffes.
 *
 * Beim Aufruf von
 *
 *	make_skipper()
 *
 * wird der Skipper geladen und in den command_room gesetzt.
 *
 */

#pragma save_types

#include <move.h>

string skipper;
string bruecke;

/*
FUNKTION: set_skipper
DEKLARATION: void set_skipper(string filename_skipper, string filename_bruecke)
BESCHREIBUNG:
Mit set_skipper setzt man den Filenamen des Skippers und den Filenamen der
Bruecke eines Schiffes.
VERWEISE: make_skipper
GRUPPEN: schiff
*/
void set_skipper(string skip, string room) {
  
  skipper = skip;
  bruecke = room;
}

/*
FUNKTION: make_skipper
DEKLARATION: int make_skipper()
BESCHREIBUNG:
Mit make_skipper kann man einen Kapitaen in einem Schiff erschaffen. Die 
Rueckgabewerte von make_skipper bedeuten:

	1 : Der Skipper wurde erfolgreich erschaffen oder stand schon auf seiner
	    Bruecke,

	2 : Der Skipper existiert schon, befindet sich aber schon irgendwo anders
	    in UNItopia. Der Skipper wird dann nicht auf die Bruecke gemoved!

	-1: Es ist etwas schiefgelaufen, entweder falsche Filenamen fuer dei Bruecke
	    oder den skipper, oder der move ist schiefgelaufen.
VERWEISE: 
GRUPPEN: schiff
*/
int make_skipper()
{
    object skip, room, place, ship;
  
    if ((!skipper || skipper == "" || !(skip = touch(skipper)))
        || (!bruecke || bruecke == "" || !(room = touch(bruecke))))
        return -1;
    if (place = environment(skip))
	if (place != room)
	    return 2;
	else {
	    this_object()->set_commander (skip);
            this_object()->set_linienschiff (1);
	    return 1;
	}
    if ((int)skip->move(room) != MOVE_OK)
	return -1;
    if ((skip->set_bruecke(),ship = (object)room->query_type("mein_schiff"))) {
        this_object()->set_commander (skip);
        this_object()->set_linienschiff (1);
        return 1;
    }
    return 0;
}

void reset()
{
    this_object()->make_skipper();
}
