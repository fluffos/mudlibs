#pragma save_types

#include <apps.h>
#include <config.h>

/*
FUNKTION: get_environment
DEKLARATION: object get_environment(object ob)
BESCHREIBUNG:
Liefert den logisch aeussersten Raum von ob.
Dabei werden Schiffe und andere Objekte mit den Typen "repraesentant" oder
"umgebung" beachtet.
VERWEISE: peilepol, peilexy
GRUPPEN: schiff
*/
object get_environment(object ob)
{
    object env=ob;
    object new_env;
    while(env)
    {
        if (new_env = environment(env))
	    env = new_env;
        else if (new_env = touch(env->query_ship()))
            env = environment(new_env);
        else if(objectp(new_env = env->query_type("repraesentant")))
            env = environment(new_env);
        else if(objectp(new_env = env->query_type("umgebung")))
            env = new_env;
        else
            break;
    }
    return env;
}

private int *peile_system(object ob)
{
    return KOORDINATEN_MASTER->get_cartesian_coordinates(ob);
}

/*
FUNKTION: peilexy
DEKLARATION: int *peilexy(object ob)
BESCHREIBUNG:
Gibt die Differenz zum Map-Raum m0_0 in kartesischen Koordinaten wieder;
kurz um, die xy Koordinaten der Umgebung des Objektes ob; bzw. des Objektes
ob selber, wenn es ein Raum ist.
peile[0] x-Koordinate
peile[1] y-Koordinate

Ist sind in einem Raum die Typen
		     x_koordinate      | im Raum setzen mit:
	     und     y_koordinate      |  add_type("x_koordinate",-142);

gesetzt, werden diese zurueckgegeben.
Befindet die das Object ob in keinem Map-Raum, so wird der Mittelpunkt
der Domain genommen, in der der Raum liegt.

Im Fehlerfall werden folgende Werte in peile[0] zurueckgegeben:

     -1      ob existiert nicht
     -2      ob hat keine Umgebung

VERWEISE: peilepol, peile
GRUPPEN: schiff
*/

int *peilexy(object ob)
{
  return KOORDINATEN_MASTER->get_cartesian_coordinates(ob);
}

/*
FUNKTION: peilepol
DEKLARATION: int *peilepol(object ob)
BESCHREIBUNG:
Gibt die Richtung und die Distanz vom Standort des Objektes ob
in der Map zum Map-Raum m0_0 zurueck.

     peile[0]:       Richtung
     peile[1]:       Distanz

Ist sind in einem Raum die Typen
		     x_koordinate      | im Raum setzen mit:
	     und     y_koordinate      |  add_type("x_koordinate",-142);

gesetzt, werden diese zurueckgegeben.
Befindet die das Object ob in keinem Map-Raum, so wird der Mittelpunkt
der Domain genommen, in der der Raum liegt.

Im Fehlerfall werden folgende Werte in peile[0] zurueckgegeben:

     -1      ob existiert nicht
     -2      ob hat keine Umgebung

VERWEISE: peilexy
GRUPPEN: schiff
*/

int *peilepol(object ob)
{
  int *pol;

  pol=KOORDINATEN_MASTER->get_cartesian_coordinates(ob);
  pol = xy2pol(pol[0],pol[1]);
  pol[0] += 180;
  pol[0] %= 360;
  return pol;
}

/*
FUNKTION: peile
DEKLARATION: int *peile(object ob)
BESCHREIBUNG:
siehe peilepol
VERWEISE: peilepol, peilexy
GRUPPEN: schiff
*/
int *peile(object ob)
{
  return peilepol(ob);
}
