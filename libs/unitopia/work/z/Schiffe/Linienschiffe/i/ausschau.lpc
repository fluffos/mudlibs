#pragma save_types

/*
 * /z/Schiffe/Linienschiffe/i/ausschau.c
 *
 * Hilfs-File fuer /z/Schiffe/Linienschiffe/i/*_room.c
 *
 */
int ausschau;
int depht;

string query_ship();

/*
 * /z/Schiffe/Linienschiffe/i/ship_room.c
 *
 * Dieser File ist fuer alle normalen Schiffs-Raeume gedacht; fuer den
 * Raum, von dem aus man das Schiff steuern koennen sollte, muss man den
 * Inherit-File /z/Schiffe/Linienschiffe/i/command/room benutzen.
 *
 * Funktionen:
 *
 *      set_ship(string schiffsname)    unbedingt notwendig.
 *
 *      set_ausschau(1)                 Ist im create() aufzurufen,
 *                                      wenn man das Kommando "halte ausschau"
 *                                      zulassen moechte.
 *
 *      set_depht(int wieviel)          Damit kann man angeben, wie weit
 *                                      man Ausschau halten kann.
 *                                      0:      (default) man sieht nur die
 *                                              Umgebung des Schiffes.
 *                                      >0:     Man sieht die angegebene Anzahl
 *                                              Raeume zusaetzlich in die
 *                                              bei halte ausschau  angegebene
 *                                              Richtung.
 *
 *      set_messages(1)                 Ist aufzurufen, wenn man die Bewegungs-
 *                                      meldungen des Schiffes hoeren will.
 *
 *      set_leave(1)                    Ist aufzurufen, wenn man innerhalb
 *                                      dieses Raumes das Schiff verlassen
 *                                      koennen sollte.
 *
 * Kommandos:
 *
 *      verlasse                        zum Verlassen
 *      ausgang                         des
 *      springe                         Schiffes
 *
 *      halte ausschau                          Raumbeschreibung der Umgebung
 *      halte ausschau <nach himmelsrichtung>   des Schiffes und der Nachbar-
 *                                              Raeume.
 *
 * Gegebenenfalls mit :: weiterzureichende Funktionen:
 *
 *      init()
 *
 *
 */


/*
FUNKTION: set_depht
DEKLARATION: void set_depht(int depht)
BESCHREIBUNG:
Damit kann man angeben, wie weit man Ausschau halten kann.
	0  :	(default) man sieht nur die Umgebung des Schiffes.

	>0 : 	Man sieht die angegebene Anzahl Raeume zusaetzlich in die
		bei 'halte ausschau' angegebene Richtung.
VERWEISE: query_depht
GRUPPEN: schiff
*/
void set_depht(int a) { depht = a; }

/*
FUNKTION: query_depht
DEKLARATION: int query_depht()
BESCHREIBUNG:
Damit kann man abfragen, wie weit man Ausschau halten kann.
VERWEISE: set_depht
GRUPPEN: schiff
*/
int query_depht() { return depht; }

varargs void halte_ausschau(string str) {
  int i;

  i = query_ship()->look_out(str, depht);
  if (!this_player()->query_invis())
    say(wrap(Der(this_player())+" haelt"+ (i ? "" : " vergeblich") +
    " Ausschau" + (str && (str != "") ? " nach "+capitalize(str) : "")+ "."));
}

int look_out(string str) {

#define RICHTUNGEN ({"norden","nordosten","osten","suedosten",\
		"sueden","suedwesten","westen","nordwesten"})

  string dir;
  int a;

  if (!query_ship()) {
    notify_fail("Ohne Schiff?\n");
    return 0;
  }
  if (!str || str == "") {
    notify_fail("Halte was?\n");
    return 0;
  }
  if ((str = lower_case(str)) == "ausschau") {
    halte_ausschau();
    return 1;
  }
  if (!sscanf(str,"ausschau nach %s",dir))
    if (!sscanf(str,"ausschau %s",dir)) {
      notify_fail("Halte was?\n");
      return 0;
    }
//  if ((a = member_array(dir,({"n","no","o","so","s","sw","w","nw" }))) >= 0)
  if ((a = member( ({"n","no","o","so","s","sw","w","nw" }), dir)) >= 0)
    dir = RICHTUNGEN[a];
//  if(member_array(dir, RICHTUNGEN) >= 0)
  if(member(RICHTUNGEN, dir) >= 0)
    halte_ausschau(dir);
  else {
    notify_fail("Wohin willst Du Ausschau halten?\n");
    return 0;
  }
  return 1;
}

/*
FUNKTION: set_ausschau
DEKLARATION: void set_ausschau(int flag)
BESCHREIBUNG:
Damit kann man festlegen, ob man von diesem Schiffsraum aus Ausschau halten
darf: bei flag=0 darf man nicht, sonst darf man nicht. Defaultmaessig
darf man nicht!
VERWEISE: query_ausschau
GRUPPEN: schiff
*/
void set_ausschau(int a) { ausschau = (a != 0); }

/*
FUNKTION: query_ausschau
DEKLARATION: int query_ausschau()
BESCHREIBUNG:
Liefert 1 zurueck, wenn man von diesem Schiffsraum aus Ausschau halten darf.
VERWEISE: set_ausschau
GRUPPEN: schiff
*/
int query_ausschau() { return ausschau; }
