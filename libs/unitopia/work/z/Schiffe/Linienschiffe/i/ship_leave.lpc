//                      geaendert, sodass man auch ueber Wanderstoecke 
//                      oder seinen eigenen Schatten springen kann
// Sissi  (10.03.2001)  beim Verlassen des Schiffs die Syntax so
//                      geaendert, dass "verlasse schiff" wieder
//                      geht und auch "ausgang" und "verlasse".
// Wyvern (26.02.2012)  Zeitungsschiff als Ausnahme im leaver() hinzu


/*
 * File fuer /z/Schiffe/Linienschiffe/i/*_room.c
 */

#pragma save_types

#include <move.h>

int leave;

string query_ship();

// Syntax: Verb ohne was - man springt
//     <verb> [vo(n|m)] (bord|schiff)
// <verb> kann 'spring', 'verlasse' oder 'ausgang' sein
int leave(string str) 
{
  object schiff_ob, env;
  string raus, rein, t;

  if (str) str = lower_case (str);
  else str = "";
  // man sollte darauf achten, dass "verlasse schiff" trotzdem
  // noch geht.
  if ((query_verb()[0] == 'a') && str && str!="") {
      notify_fail ("Noch mehr als Ausgang? Was meinst Du damit?\n");
      return 0;
  }
  else if ((query_verb()[0] == 's') &&
      ((strstr(str,"von") + strstr (str,"vom") == -2) ||
      (strstr(str,"schiff") + strstr (str,"bord") == -2)))
  {
      notify_fail("springe wohin? Vielleicht von Bord?\n");
      return 0;
  }
  else if ((query_verb()[0] == 'v') && (str != "") &&
      (strstr(str,"schiff") + strstr (str,"bord") == -2))
  {
      notify_fail ("Was willst Du verlassen? Vielleicht das Schiff?\n");
      return 0;
  }
  
  if (query_ship() &&
      (schiff_ob = touch(query_ship())) &&
      (env = environment(schiff_ob)) ) {
    if (!(raus = schiff_ob->query_leave_messages()[1]))
      raus = "$Der() verlaesst das Schiff";
    if (!(rein = schiff_ob->query_leave_messages()[0]))
      rein = "$Der() verlaesst "+den(schiff_ob);
  }
  if (env) {
    // Gefaehrliche Falle. Das Verlassen unter der Fahrt ist nur bei
    // Faehren unerwuenscht, bei Privatschiffen sollte es doch schon
    // moeglich sein!
    if (!env->query_type("hafen") && 
      (t = map2domain(object_name(env),1)) && (t[0..3] == "/map") &&
      strstr(object_name(),"/werft/")==-1 &&
      strstr(object_name(),"/Werft/")==-1 &&
      strstr(object_name(),"/spieler/")==-1 &&
      strstr(object_name(),"/Bardengilde/")==-1 &&
      strstr(object_name(),"/Zeitungsschiff/")==-1 &&      
      strstr(object_name(),"/w/")==-1)
      write ("Mitten auf dem Meer? Willst Du ertrinken? Noenoe, lass mal.\n");
    else
      this_player()->move(env,MOVE_NORMAL,raus,rein);
  }
  else
    this_player()->move("/room/void",1,"verlaesst das Schiff",
                        "kommt verduzt hereingestolpert");
  return 1;
}
/*
FUNKTION: set_leave
DEKLARATION: void set_leave(int flag)
BESCHREIBUNG:
Damit legt man fest, ob man von diesem Raum aus das Schiff verlassen kann.
Bei flag=1 darf man, per Default darf man nicht.
VERWEISE: query_leave
GRUPPEN: schiff
*/
void set_leave(int a) { leave = (a != 0); }
/*
FUNKTION: query_leave
DEKLARATION: int query_leave()
BESCHREIBUNG:
Liefert 1 zurueck, wenn man von diesem Schiffsraum aus ein Schiff verlassen 
darf.
VERWEISE: set_leave
GRUPPEN: schiff
*/
int query_leave() { return leave; }
