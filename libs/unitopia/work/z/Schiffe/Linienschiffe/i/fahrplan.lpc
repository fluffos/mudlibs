inherit "/i/item";
inherit "/i/move";
inherit "/i/value";

string hafen;
object hafen_raum;

int set_hafen(string str)
{
  hafen = str;
  hafen_raum = touch(hafen);
  if (hafen_raum)
    return 1;
}

string query_hafen() {return hafen;}

object get_hafen()
{
  return hafen_raum || (hafen && (hafen_raum=touch(hafen)));
}

void create()
{
  set_id( ({"fahrplan","plan"}) );
  set_name("Fahrplan");
  set_gender("maennlich");
  set_weight(1);
  set_value(10);
  set_material(({"papier"}));
  seteuid(getuid());
}

string query_long(object who)
{
  object kurstafel;

  if (!get_hafen() || !(kurstafel = present("kurstafel",hafen_raum)))
    return "Der Fahrplan ist leer.\n";

  return kurstafel->query_long(who);
}

string query_short(object viewer) {
	string name;
	object kurstafel;

  if (!get_hafen() || !(kurstafel = present("kurstafel",hafen_raum)))
    return "Ein Fahrplan";
  name = (string)hafen_raum->query_type("hafen");
  return "Der Fahrplan des Hafens von "+capitalize(name);
}

varargs string query_read(string rest, string str, object leser)
{
    return query_long(leser);
}
