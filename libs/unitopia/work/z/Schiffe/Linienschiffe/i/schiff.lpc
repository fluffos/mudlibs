private string convert_steer_command(string str)
{
   object env = environment();
   int sm, grad;
   string exit;
   int * xy;

   str = ([ "n" : "norden", "no" : "nordosten",
            "o" : "osten",  "so" : "suedosten",
            "s" : "sueden", "sw" : "suedwesten",
            "w" : "westen", "nw" : "nordwesten" ])[str] ||
         str;


   if(!objectp(env))
   {
       return str;
   }

   else
   {
       string name = object_name(env);

       if(map_object(name))
       {
           // Umgebung ist ein Map-Raum
           if(is_direction(str, DIR_NUR_HIMMELSRICHTUNGEN))
           {
               exit = env->query_one_exit(str, 0);

               if(!stringp(exit) || !strlen(exit) || map_object(exit))
               {
                   switch(str)
                   {
                       case "norden":
                           return "1 sm 0 grad";
                           break;

                       case "nordosten":
                           return "1 sm 45 grad";
                           break;

                       case "osten":
                           return "1 sm 90 grad";
                           break;

                       case "suedosten":
                           return "1 sm 135 grad";
                           break;

                       case "sueden":
                           return "1 sm 180 grad";
                           break;

                       case "suedwesten":
                           return "1 sm 225 grad";
                           break;

                       case "westen":
                           return "1 sm 270 grad";
                           break;

                       case "nordwesten":
                           return "1 sm 315 grad";
                           break;
                   }
               }
           }
       }

       else
       {
           // Umgebung ist kein Map-Raum

           if((sscanf(str, "%d sm %d grad", sm, grad) == 2 ||
               sscanf(str, "%d grad %d sm", grad, sm) == 2) &&
               sm == 1 && grad >= 0 && grad <= 360)
           {
               xy = pol2xy(grad, 1);

               switch(sprintf("%d%d", xy[0], xy[1]))
               {
                   case "01":
                      return "norden";
                      break;

                   case "0-1":
                       return "sueden";
                       break;

                   case "11":
                       return "nordosten";
                       break;

                   case "10":
                       return "osten";
                       break;

                   case "1-1":
                       return "suedosten";
                       break;

                   case "-11":
                       return "nordwesten";
                       break;

                   case "-10":
                       return "westen";
                       break;

                   case "-1-1":
                       return "suedwesten";
                       break;

                  default:
                      raise_error("Illegal Dircode: "+sprintf("%d%d", xy[0],
                                  xy[1])+"\n");
               }
           }
       }
   }

   return str;
}

int steer_ship (string dest) {
  int distanz, kurs, ret;
  object env;

  if(!TP) return 0;
  if(TP->query_ghost() && playerp(TP))
      return notify_fail(wrap("Das ist unmoeglich in deinem nichtmateriellen Zustand."));
  if (TI && (TP != TI))
    return 0;
    // gegen verbloedetes Pantheon:
    // zwinge kapitaen steure norden darf nicht gehen
  if (linienschiff && (commander != TP)) {
    notify_fail ("Du willst doch das Linienschiff nicht vom Kurs "
      "abbringen?\n");
    return 0;
  }
  if (!commander)
    commander=TP;
  else {
    if (TP != commander &&
            (env = environment(commander)) && object_name(env) == command_room) {
      notify_fail(Der(commander)+" haette wohl etwas dagegen.\n");
      return 0;
    }
//    if (playerp (commander)) Wozu hier playerp?
      commander=TP;
  }

  if (!dest || dest == "" || member(dest,'/') != -1) {
    notify_fail("Steuere welche Richtung bzw\n"+
                "steuere wieviel sm wieviel Grad?\n");
    return 0;
  }

  dest = convert_steer_command(dest);

  if (sscanf(dest = lower_case(dest),"%d sm %d grad",distanz, kurs) == 2 ||
      sscanf(dest,"%d grad %d sm",kurs, distanz) == 2 ||
      // Ab 3.3.712 ist sscanf strenger:
      sscanf(dest,"%d sm %d",distanz, kurs) == 2 ||
      sscanf(dest,"%d grad %d",kurs, distanz) == 2 )
    return starte_kreuz(kurs, distanz);

  if (stopped) {
    if (playerp(TP)) {
      write("Das geht im Moment nicht.\n");
      return 1;
    }
    /*
     * Die automatischen Kapitaene wiederholen die
     * Steuer-Kommandos nicht freiwillig. Ausserdem
     * warten sie auf den Call:   kreuz_ende()  ,
     * bevor sie das naechste Kommando abschicken.
     * Wir merken uns hier das Kommando und fuehren
     * es dann aus, wenn das Schiff wieder weiter-
     * fahren darf.
     */
    command_stack = dest;
    return 1;
  }

  if (playerp(commander))
    init_spread_skill();

  ret = fahre(dest);

  if (ret == MOVE_OK) {
    last_time = time();
    verkuende(move_message);
    logge++;

    if (playerp(commander))
      spread_skill();
    else
      commander->kreuz_ende();
  }
  else{
    // Mirak: query_not_moved_reason() eingebaut
    write(query_not_moved_reason()||"Das ist nicht moeglich.\n");
  }

  return 1;
}

void ursprung() {

  remove_call_out("kreuze");
  on_tour = 0;
}

int stop_kreuz(string str) {
  object env;

  if (!str || strstr(lower_case(str),"kreuz")) {
    notify_fail("Stoppe was?\n");
    return 0;
  }

  if (commander != TP) {
    if (!commander || !(env = environment(commander)) ||
        object_name(env) != command_room)
      commander = TP;
    else {
      write(Der(commander)+" haette wohl etwas dagegen.\n");
      return 1;
    }
  }
  if (!on_tour)
    write(Der()+" befindet sich nicht auf einem Kreuzschlag.\n");
  else
    tell_command_room("Der Kreuzschlag wurde von "+
                        dem(TP)+" vorzeitig abgebrochen.\n");
  ursprung();
  return 1;
}

int remove()
{
  object env, room, *inv;
  int a, b;
  object *all_rooms;

  env = environment();

  if (!objectp(env)) {
    destruct(TO);
    return 1;
  }

  verkuende_an_alle("\n"+Der()+" geht unter.\n\n");
  if (env)
    tell_room(env,"\n"+Der()+" geht unter.\n\n");
  set_short(Der(0,"untergehend"));

  if (command_room && (room = find_object(command_room)))
    all_rooms = ({ room });
  else
    all_rooms = ({});
  if (sizeof(ship_rooms))
  {
    ship_rooms -= ({0});
    all_rooms += ship_rooms;
  }

  for (a = sizeof(all_rooms); a--;)
  {
    room = all_rooms[a];
    if (env && sizeof(inv = all_inventory(room)))
      for (b = sizeof(inv); b--;)
      {
        if (interactive(inv[b]))
          inv[b]->move(env);
        if (inv[b]->query_animal())
          inv[b]->move(env);
      }
    room->remove();
    if (room)
      destruct(room);
  }
  destruct(TO);
  return 1;
}


int versenke(string str) {

  if (!me(str)) {
    notify_fail("Versenke was?\n");
    return 0;
  }
  remove();
  return 1;
}
