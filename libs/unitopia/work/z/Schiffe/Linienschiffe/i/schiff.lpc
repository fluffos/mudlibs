void kreuze() {
  int x, y, ret;
  string e_dest;

  if (stopped) {
    call_out("kreuze",e_etmal);
    return;
  }

  etappen--;
  call_out("kreuze",e_etmal);

  if (playerp(commander))
    init_spread_skill();

#ifdef USE_NEW_KURSMASTER
  if(etappen <= 0 && (!neue_schiffslogik || (!pointerp(k_inf) || k_inf[2])))
#else
  if (etappen <= 0 && (!neue_schiffslogik || (!pointerp(k_inf) || !k_inf[0])))
#endif
   {
    DEBUG("Final Move...");

    if (object_name(environment(TO)) != dest)
      ret = TO->move(dest, MOVE_NORMAL,
                                     "$Der() entfernt sich auf "+kurs+" Grad");
    remove_call_out("kreuze");
    on_tour = 0;
    if (ret == MOVE_OK) { DEBUG("... MOVE_OK");
      last_time = time();
      verkuende(move_message);
      logge = logge_new;
      tell_command_room("Der Kreuzschlag wurde erfolgreich beendet.\n");
      if (commander) {
        if (playerp(commander))
          spread_skill();
        else
          commander->kreuz_ende();
      }
    }
    else { DEBUG("... MOVE_FAIL");
          tell_command_room(wrap("Der Kreuzschlag wurde vorzeitig abgebrochen, "
            "da das Schiff sonst auf Grund laufen wuerde.")); }

    return;
  }

  if (sscanf(object_name(environment(TO)),"/map/m%d_%d",x,y) != 2) {
    remove_call_out("kreuze");
    on_tour = 0;
    tell_command_room("Der Kreuzschlag wurde vorzeitig abgebrochen; "
                      "in diesen Gewaessern\nkann man nicht kreuzen.\n");
    return;
  }


#ifdef USE_NEW_KURSMASTER
  if(neue_schiffslogik && pointerp(k_inf) && !k_inf[2])
  {
      DEBUG("CHECK: This etappe may be the failing one");

      // k_inf[2] == 0, d.h. der Kurse-Master war der Meinung, dass der
      // Kurs nicht zu Ende gefahren werden kann.

      // Pruefen, ob wir diesen Punkt in dieser Etappe ueberschreiten
      if(query_distanz(x, y, x+e_coords[0], y+e_coords[1]) >=
         query_distanz(x, y, k_inf[0], k_inf[1]))
      {
          // Wir wuerden in diesem Schritt gegen Land fahren.
          // Punkt vor dem Land bestimmen.

          k_inf = pol_xy_xy(x, y, k_inf[0], k_inf[1]); // Kreuzschlag auf den Landpunkt
          k_inf[1] -= 2 + random(5); // Per Zufall ein paar sm vorher halten

          // Nur weiterfahren, wenn wir nich schon zu dicht am Land sind
          if(k_inf[1] > 0)
          {
              k_inf += xy_xy_pol(x, y, k_inf); // Zielkoordinaten ermitteln

              if(TO->move("/map/m"+k_inf[2]+"_"+k_inf[3],
                     MOVE_NORMAL, "$Der() entfernt sich auf Kurs "+kurs+" Grad")
                 == MOVE_OK)
              {
                  logge += k_inf[1];
                  verkuende(move_message);
              }
          }
#else
  if(neue_schiffslogik && pointerp(k_inf) && k_inf[0])
  {
      if(touch(KURSMASTER)->calc_laenge(x,y,x+e_coords[0],
                                                     y+e_coords[1]) >
         touch(KURSMASTER)->calc_laenge(x,y,k_inf[2],k_inf[3]))


        {

          k_inf = xy2pol(k_inf[2]-x,k_inf[3]-y);
          k_inf = pol2xy(k_inf[0], (k_inf[1]>5 ? k_inf[1] - 3 : k_inf[1]) );

          if(TO->move("/map/m"+(x+k_inf[0])+"_"+(y+k_inf[1]),
               MOVE_NORMAL,"$Der() entfernt sich auf Kurs "+kurs+" Grad")==
              MOVE_OK)

          {
              logge += round(touch(KURSMASTER) ->
                                   calc_laenge(x,y,x+k_inf[0], y+k_inf[1]));

              verkuende(move_message);
          }
#endif

          remove_call_out("kreuze");
          on_tour = 0;
          tell_command_room(wrap("Der Kreuzschlag wurde vorzeitig abgebrochen, "
            "da das Schiff sonst auf Grund laufen wuerde."));

          return;

        }

    }

  if (TO->move((e_dest = "/map/m" + (x+e_coords[0]) +
                               "_"+ (y+e_coords[1])), MOVE_NORMAL,
                               "$Der() entfernt sich auf Kurs "+
                               kurs+" Grad") != MOVE_OK) {
    remove_call_out("kreuze");
    on_tour = 0;
          tell_command_room(wrap("Der Kreuzschlag wurde vorzeitig abgebrochen, "
            "da das Schiff sonst auf Grund laufen wuerde."));
    return;
  }
  last_time = time();
  logge += e_distanz;
  verkuende(move_message);
}

int starte_kreuz(int dir, int dist) {
  object env;
  int x, y, *coords, eta;

  if (!speed)
    speed = 150;
  if (!etmal)
    etmal = 10;
  if (!max_etappen)
    max_etappen = 15;

  if (on_tour) {
    notify_fail("Das Schiff ist bereits auf einem Kreuzschlag.\n");
    return 0;
  }
  if (dist <= 0) {
    notify_fail("Eine Strecke von "+dist+" sm, wie soll das gehen?\n");
    return 0;
  }
  if (dist >=10000) {
    notify_fail("Eine Strecke von "+dist+" sm, das ist zu weit!\n");
    return 0;
  }

  if (dir == 360)
    dir = 0;
  if (dir > 360 || dir < 0) {
    notify_fail("Ein Kurs von "+dir+" Grad, wie soll das gehen?\n");
    return 0;
  }

  if (!(env = environment(TO))) {
    notify_fail("Das Schiff hat keine Umgebung.\n");
    return 0;
  }
  if (sscanf(object_name(env),"/map/m%d_%d",x,y) != 2) {
    notify_fail("Kreuzschlaege kann man nur auf offener See fahren.\n");
    return 0;
  }

  coords = pol2xy((kurs = dir),(distanz = dist));
  if (coords[0] == 0 && coords[1] == 0) {
    notify_fail("Das Ziel liegt hier im Raum.\n");
    return 0;
  }
  dest_coords = ({ x + coords[0] , y + coords[1] });
  dest = "/map/m"+dest_coords[0]+"_"+dest_coords[1];

  // Testweise
  CALL_KURSE(update_room(0, dest));

  if(dist == 1)
  {
      int * xy;
      string direction;

      xy = pol2xy(dir, 1);

      switch(sprintf("%d%d", xy[0], xy[1]))
      {
          case "01":
              direction = "Norden";
              break;

          case "0-1":
              direction = "Sueden";
              break;

          case "11":
              direction = "Nordosten";
              break;

          case "10":
              direction = "Osten";
              break;

          case "1-1":
              direction = "Suedosten";
              break;

          case "-11":
              direction = "Nordwesten";
              break;

          case "-10":
              direction = "Westen";
              break;

          case "-1-1":
              direction = "Suedwesten";
              break;

          default:
              raise_error("Illegal Dircode: "+sprintf("%d%d", xy[0], xy[1])+"\n");
      }

      if(move(dest, MOVE_NORMAL, "$Der() entfernt sich nach "+direction,
                                 "$Der() naehert sich von "+
    capitalize(opposite_direction(lower_case(direction)))) == MOVE_OK)
      {
          logge += 1;
          verkuende(move_message);
          if(objectp(commander) && !playerp(commander)) commander->kreuz_ende();
          return 1;
      }

      else
      {
          notify_fail("Das ist nicht moeglich.\n");
          return 0;
      }
  }

  etappen = (etappen = ((eta = ((distanz * 60) / speed)) / etmal)) < 1 ?
              1 :
              etappen > max_etappen ?
                max_etappen :
                etappen;

  e_etmal = (eta / etappen);

  e_coords = pol2xy(kurs,(e_distanz = (distanz / etappen)));

  if (e_coords[0] == 0 && e_coords[1] == 0)
    etappen = 1;

  on_tour = 1;
  logge_new = logge+distanz;

  tell_command_room("Das Schiff beginnt einen Kreuzschlag.\n");

  k_inf = 0;

  if(neue_schiffslogik)
  {
#ifdef USE_NEW_KURSMASTER
      DEBUG("Asking Kursmaster check_step...");

      k_inf = apply(#'call_other, NEW_KURSMASTER, "check_step",
                  query_koordinaten(TO) + dest_coords);
#else
      k_inf = touch(KURSMASTER)->check_kreuzschlag(
              TO, dir, dist );
#endif
  }

  // Kurze Kreuzschlaege duerfen nicht schneller sein als ein langer
  call_out("kreuze",e_etmal+2);

  return 1;
}

/*
FUNKTION: query_logge
DEKLARATION: int query_logge()
BESCHREIBUNG:
Liefert die Anzahl Seemeilen, die ein Schiff seit dem Laden zuruecklegt hat,
zurueck.
VERWEISE: add_logge
GRUPPEN: schiff
*/
int query_logge() {

  return logge;
}

/*
FUNKTION: add_logge
DEKLARATION: void add_logge(int seemeilen)
BESCHREIBUNG:
Damit kann man die Logge eines Schiffes um 'seemeilen' verstellen.
VERWEISE: add_logge
GRUPPEN: schiff
*/
void add_logge(int a) {

  logge += a;
}


