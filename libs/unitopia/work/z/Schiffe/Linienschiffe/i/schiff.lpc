Damit setzt man den Schifstyp bei Schiffen, zB Brigantine, Galeasse, Dampfer...
VERWEISE: query_typ
GRUPPEN: schiff
*/
void set_typ(string str) {

  typ = str;
}


/*
FUNKTION: query_passagiere
DEKLARATION: object *query_passagiere(string dummy)
BESCHREIBUNG:
Liefert ein Feld mit Objektpointern auf alle Passagiere des Schiffs
zurueck.
VERWEISE:
GRUPPEN: schiff
*/
object *query_passagiere(string str)
{
  int a, b;
  object room, *inv, *passagiere;
  object *rooms;

  rooms = (command_room && (room = find_object(command_room))) ?
            ({ room }) :
            ({});
  if (ship_rooms)
  {
    ship_rooms -= ({0});
    rooms += ship_rooms;
  }
  passagiere = ({});
  for (a = sizeof(rooms); a--;)
  {
    inv = all_inventory(rooms[a]);
    for (b = sizeof(inv); b--;)
      if (living(inv[b]))
        passagiere += ({ inv[b] });
  }
  return passagiere;
}


/*
FUNKTION: stop_ship
DEKLARATION: void stop_ship()
BESCHREIBUNG:
Damit kann man ein Schiff mitten in der Fahr anhalten, zB fuer einen
Piratenueberfall. Das SChiff kann nicht mehr bewegt werden, bis
restart_ship aufgerufen wurde.
VERWEISE: query_stopped, restart_ship
GRUPPEN: schiff
*/
void stop_ship() {

  stopped = 1;
}

/*
FUNKTION: query_stopped
DEKLARATION: int query_stopped()
BESCHREIBUNG:
Liefert 1 zurueck, wenn das ein Schiff mit stop_ship angehalten wurde.
VERWEISE: stop_ship, restart_ship
GRUPPEN: schiff
*/
int query_stopped() {

  return stopped;
}

/*
FUNKTION: restart_ship
DEKLARATION: void restart_ship()
BESCHREIBUNG:
Startet ein mit stop_ship angehaltenes Schiff wieder.
VERWEISE: stop_ship, query_stopped
GRUPPEN: schiff
*/
void restart_ship() {

  if (stopped && find_call_out("do_restart") == -1)
    call_out("do_restart",5);
}

void do_restart() {

  stopped = 0;
  if (!command_stack)
    return;

  if (fahre(command_stack) == MOVE_OK) {
    last_time = time();
    verkuende(move_message);
    logge++;
    if (commander)
      commander->kreuz_ende();
  }
  command_stack = 0;
}

int forbidden(string message, varargs mixed data) {
  data = expand(data);
  if (message == "take" || message == "push") {
    tell_object(data[0],wrap("Das kannst Du mit "+dem(TO)+
      " nicht machen!"));
    return 1;
  }
  return ::forbidden(message, data);
}

varargs int move(mixed dest, int way, string out, string in) {
int i;
  if(schiff_debug)
  {
     DEBUG(sprintf("%Q->move(%Q, %Q, %Q, %Q)", TO, dest, way, out, in));
  }

  if (objectp(dest) && !dest->query_room())
    return MOVE_NOT_ALLOWED;
  i = ::move(dest, way, out, in);
  if(schiff_debug) { DEBUG(sprintf(" -- MOVE == %d", i)); }

  // Testweise. Wir wollen, dass das die alten Schiffe nicht behindert.
  // Daher catched.
  if(i == MOVE_OK)
  {
      CALL_KURSE(update_room(environment(), 0));

      // Segelskill
      catch(touch("/z/Schiffe/Werft/master_object")->spread_skill(
            TO, environment(), commander
            ); publish);
  }

  else
  {
      if(stringp(dest) && is_direction(dest) && environment())
      {
          CALL_KURSE(update_room(0, environment()->query_one_exit(dest)));
      }

      else
      {
          CALL_KURSE(update_room(dest, dest));
      }
  }

  return i;
}

/*
FUNKTION: set_enter_messages_wait
DEKLARATION: void set_enter_messages_wait(string aussen, string innen, string spieler)
BESCHREIBUNG:
Setzt die Meldungen, die beim Betreten des Schiffes an die Umgebung (aussen), an
den betretenen Raum (innen), sowie an den Wartenden (spieler) geschickt werden.

Die Benutzung von Pseudoclosures ist erlaubt.
$Der('vehikel) bezeichnet hierbei das Schiff.
VERWEISE: query_enter_messages_wait
GRUPPEN: schiff
*/
private string *enter_messages_wait;

void set_enter_messages_wait(string aussen, string innen, string spieler){
    enter_messages_wait=({aussen, innen, spieler});
}

/*
FUNKTION: query_enter_messages_wait
DEKLARATION: string *query_enter_messages_wait()
BESCHREIBUNG:
Liefert die Meldungen, die beim Betreten des Schiffes an die Umgebung (aussen),
an den betretenen Raum (innen), sowie an den Wartenden (spieler) geschickt
werden.

    Der Rueckgabewert ist ({string aussen, string innen, string spieler}).

Die drei Meldungen koennen Pseudoclosures enthalten.
VERWEISE: set_enter_messages_wait
GRUPPEN: schiff
*/

string *query_enter_messages_wait(object einsteiger){
    string aussen, innen, spieler;

    aussen=enter_messages_wait[0];
    innen=enter_messages_wait[1];
    spieler=enter_messages_wait[2];
    
    if(!einsteiger) einsteiger = TP;

    aussen =  CTS(MTC(aussen, ({'vehikel, 'tp}), 1, 1),({TO, einsteiger }));
    innen =   CTS(MTC(innen,  ({'vehikel, 'tp}), 1, 1),({TO, einsteiger }));
    spieler = CTS(MTC(spieler,({'vehikel, 'tp}), 1, 1),({TO, einsteiger }));

    return ({aussen, innen, spieler});
}

/*
FUNKTION: set_leave_messages_wait
DEKLARATION: void set_leave_messages_wait(string aussen, string innen, string spieler)
BESCHREIBUNG:
Setzt die Meldungen, die beim Verlassen des Schiffes an die Umgebung (aussen),
an den betretenen Raum (innen), sowie an den Wartenden (spieler) geschickt
werden.

Die Benutzung von Pseudoclosures ist erlaubt.
$Der('vehikel) bezeichnet hierbei das Schiff.
VERWEISE: query_leave_messages_wait
GRUPPEN: schiff
*/
private string *leave_messages_wait;

void set_leave_messages_wait(string aussen, string innen, string spieler){
    leave_messages_wait=({aussen, innen, spieler});
}

/*
FUNKTION: query_leave_messages_wait
DEKLARATION: string *query_leave_messages_wait()
BESCHREIBUNG:
Liefert die Meldungen, die beim Verlassen des Schiffes an die Umgebung (aussen),
an den betretenen Raum (innen), sowie an den Wartenden (spieler) geschickt
werden.

    Der Rueckgabewert ist ({string aussen, string innen, string spieler}).

Die drei Meldungen koennen Pseudoclosures enthalten.
VERWEISE: set_leave_messages_wait
GRUPPEN: schiff
*/

string *query_leave_messages_wait(object aussteiger){
    string aussen, innen, spieler;

    aussen=leave_messages_wait[0];
    innen=leave_messages_wait[1];
    spieler=leave_messages_wait[2];

    if(!aussteiger) aussteiger = TP;

    aussen =  CTS(MTC(aussen, ({'vehikel, 'tp}), 1, 1),({TO, aussteiger }));
    innen =   CTS(MTC(innen,  ({'vehikel, 'tp}), 1, 1),({TO, aussteiger }));
    spieler = CTS(MTC(spieler,({'vehikel, 'tp}), 1, 1),({TO, aussteiger }));

    return ({aussen, innen, spieler});
}


void reset()
{
    "*"::reset();
    TO->make_skipper();
}

void create() {

  ::create();
  set_vehikel("schiff");
  set_msg("$Der() entfernt sich $dir().", "$Ein() naehert sich $dir().", 1);
  set_mmsg("$Der() verschwindet zwischen den Wellen.",
           "$Ein() taucht aus den Wellen auf.");
  set_id("schiff");
  set_name("schiff");
  set_gender("saechlich");
  set_long("Ein ganz normales Schiff.\n");
  move_message = "Das Schiff kaempft sich durch die Wellen.\n";
  set_enter_messages("$Der() betritt das Schiff.","$Ein() kommt an Bord.");
  set_enter_messages_wait("$Der() wird von ein paar Matrosen, die von "
                          "$dem('vehikel) kommen, an Bord gebracht.",
                          "$Der() wird von ein paar Matrosen an Bord gebracht.",
                          "Du wirst von ein paar Matrosen an Bord gebracht.");
  set_leave_messages_wait("$Der() wird von einigen Matrosen, die von "
                          "$dem('vehikel) kommen, von Bord gebracht.",
                          "$Der() wird von einigen Matrosen von Bord gebracht.",
                          "Du wirst von einigen Matrosen von Bord gebracht.");
  last_time = time();
  add_controller(({"concerned_strike"}));
}

mixed brenn_problem(object womit, mixed was, mixed melder, object wer)
{
    return Der()+" "+ist()+" einfach zu feucht, zum Brennen!";
}
