/*
FUNKTION: set_move_message
DEKLARATION: void set_move_message(string str)
BESCHREIBUNG:
Damit kann man die Bewegungsmeldung eines Schiffe, die in allen Raeumen
verkuendet wird, setzen. Sie wird nur in den Raeumen verkuendet, die mit
add_message_room im Schiff eingetragen wurden.
VERWEISE: verkuende, add_message_room, query_message_room
GRUPPEN: schiff
*/
void set_move_message(string str) {
  move_message = str;
}

string query_move_message() {
  return move_message;
}

/*
FUNKTION: verkuende
DEKLARATION: nosave void verkuende(string message)
BESCHREIBUNG:
Erzeugt eine Meldung in allen Raeumen des Schiffes, die mit add_message_room
eingetragen wurden. Diese Funktion kann nur vom Schiffsobjekt selbst
aufgerufen werden.
VERWEISE: add_message_room
GRUPPEN: schiff
*/
nosave void verkuende(string message) {
  int a;

  if (!message || message == "")
    return;
  if (message_rooms)
    message_rooms -= ({0});
  for (a = sizeof(message_rooms); a--;)
    tell_room(message_rooms[a],message);
  tell_command_room(message);
}

/*
FUNKTION: verkuende_an_alle
DEKLARATION: void verkuende_an_alle(string message)
BESCHREIBUNG:
Erzeugt eine Meldung in allen Raeumen des Schiffes, die mit add_ship_room
eingetragen wurden. Diese Funktion kann nur vom Schiffsobjekt selbst
aufgerufen werden.
VERWEISE: add_ship_room
GRUPPEN: schiff
*/
void verkuende_an_alle(string message)
{
  int a;

  if (!message || message == "")
    return;
  if (ship_rooms)
    ship_rooms -= ({0});
  for (a = sizeof(ship_rooms); a--;)
    tell_room(ship_rooms[a],message);
  tell_command_room(message);
}

