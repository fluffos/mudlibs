void set_schiff_debug(int i) { schiff_debug = i; }
/*
FUNKTION: set_neue_schiffslogik
DEKLARATION: int set_neue_schiffslogik(int wert)
BESCHREIBUNG:
Diese Funktion aktiviert in einem Schiffs-Objekt die neue Schiffslogik,
die verhindert, dass Schiffe ueber Land springen koennen.
Der Funktionsname ist nur temporaer, die neue Schiffslogik nur im
Testbetrieb. Sie ist daher standardmaessig bei Schiffen deaktiviert und
sollte auf _keinen_ Fall bei Faehren oder Schiffen aktiviert werden.
VERWEISE: query_neue_schiffslogik
GRUPPEN: schiff
*/
int set_neue_schiffslogik(int i)

  {

    if(intp(i))

      neue_schiffslogik = i;

    return neue_schiffslogik;

  }

/*
FUNKTION: query_neue_schiffslogik
DEKLARATION: int query_neue_schiffslogik()
BESCHREIBUNG:
Diese Funktion liefert einen Wert != 0, sofern die Logik bei einem Schiff
aktiviert wurde.
VERWEISE: set_neue_schiffslogik
GRUPPEN: schiff
*/
int query_neue_schiffslogik() { return neue_schiffslogik; }

void tell_command_room(string str) {
  object ob;

  if (command_room && (ob = find_object(command_room)))
    tell_room(ob,str);
}

/*
FUNKTION: set_leave_messages
DEKLARATION: void set_leave_message(string min,string mout)
BESCHREIBUNG:
Hier werden die Meldungen beim Verlassen des Schiffes gesetzt.
VERWEISE: query_leave_messages, set_enter_messages
GRUPPEN: schiff
*/
void set_leave_messages(string min,string mout)
{
  lmsg_in=min; lmsg_out=mout;
}

/*
FUNKTION: query_leave_messages
DEKLARATION: string* query_leave_messages()
BESCHREIBUNG:
Liefert die Meldungen beim Verlassen des Schiffes zurueck.
VERWEISE: set_leave_messages, set_enter_messages
GRUPPEN: schiff
*/
string *query_leave_messages()
{
  return ({lmsg_in,lmsg_out});
}

