varargs int look_out(string str, int depth)
{
  object out;
  string room;
  int a;


  if (!(out = environment(TO)))
  {
    write(Der()+" befindet sich im Nirwana.\n");
    return 0;
  }
  if (!str || str == "")
  {
  
    write(center(" In der Umgebung "+des()+" siehst du: ",79,"-")+"\n"+
          TP->describe_room(out,
                               EYE_FORCE_LONG|EYE_NO_EXITS|EYE_FORCE_LIGHT)+
          copies("-",79)+"\n");
    return 1;
  }
  if (!(room = out->query_one_exit(str = lower_case(str))) || room =="")
  {
    write("In dieser Richtung gibt es nichts zum Anschauen.\n");
    return 0;
  }
  if (depth < 1)
    depth = 1;
  while (room && room != "" && a < depth)
  {
    a++;
    switch(a) {
    case 1:
      write(center("In Richtung "+capitalize(str)+" siehst du: ",79,"-")+"\n");
      break;
    case 2:
      write(center("Noch ein Stueckchen weiter siehst du: ",79,"-")+"\n");
      break;
    default:
      write(center("Und noch ein Stueckchen weiter siehst du: ",79,"-")+"\n");
      break;
    }
    write(TP->describe_room(out = touch(room),
                               EYE_FORCE_LONG|EYE_NO_EXITS|EYE_FORCE_LIGHT));
    room = out->query_one_exit(str);
    write(copies("-",79)+"\n");
  }
  //write(TP->describe_room(out,EYE_FORCE_LONG|EYE_NO_EXITS));
  return 1;
}

/*
FUNKTION: set_default_room
DEKLARATION: void set_default_room(string default_room)
BESCHREIBUNG:
Damit wird der Heimathafen eines Schiffe gesetzt.
VERWEISE: query_default_room
GRUPPEN: schiff
*/
void set_default_room(string str) {

  default_room = str;
}

/*
FUNKTION: query_default_room
DEKLARATION: string query_default_room()
BESCHREIBUNG:
Damit kann man den Heimathafen des Schiffe abfragen.
VERWEISE: set_default_room
GRUPPEN: schiff
*/
string query_default_room() {
  object startraum;

  // Goetterschiffe haben einen Startraum jwd
  if(default_room &&
     strstr(object_name(TO), "/w/") == 0 &&
     (startraum=touch(default_room, NO_LOG | NO_WRITE)) &&
      startraum->query_room_domain() != "Pantheon")
  {
      return "/map/m1234567890_1234567890";
  }

  return default_room;
}

