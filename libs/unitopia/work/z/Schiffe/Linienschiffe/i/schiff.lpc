/*
FUNKTION: query_ship_rooms
DEKLARATION: object *query_ship_rooms()
BESCHREIBUNG:
query_ship_rooms liefert ein Objekt-Feld aller Schiffsraeume, ohne den
command_room eines Schiffes zurueck.
VERWEISE: add_ship_room, query_command_room
GRUPPEN: schiff
*/
object *query_ship_rooms() {
  return ship_rooms;
}

/*
FUNKTION: add_ship_room
DEKLARATION: void add_ship_room(string str|object ob)
BESCHREIBUNG:
Mit dieser Routine kann man dem Schiff mitteilen, welche Raeume zu dem Schiff
gehoeren. Die eingetragenen Raeume kommen dann alle in den Genuss der
verschiedenen Features auf Schiffen, wei zB die Moeglichkeit, das Schiff dort
zu verlassen oder Meldungen vom Kapitaen zu empfangen.
VERWEISE: query_ship_rooms, verkuende_an_alle
GRUPPEN: schiff
*/
void add_ship_room(mixed ob)
{
  if (!ship_rooms)
    ship_rooms = ({});
  else
    ship_rooms -= ({0});
  if (!objectp(ob))
    ob = find_object(ob);
  if (ob)
  {
    if (member(ship_rooms, ob) < 0)
      ship_rooms += ({ ob });
    if (commander)
      commander->add_ship_room(ob);
  }
}


/*
FUNKTION: query_message_rooms
DEKLARATION: object *query_message_rooms()
BESCHREIBUNG:
Diese Funktion lifert alle Schiffsraeume zurueck, die Meldungen
mit der Funktion verkuende empfangen sollen.
VERWEISE: add_message_room, verkuende
GRUPPEN: schiff
*/
object *query_message_rooms() {
  return message_rooms;
}

/*
FUNKTION: add_message_room
DEKLARATION: void add_message_room(string str|object ob)
BESCHREIBUNG:
add_message_room fuegt zu der Liste der Schiffsraeume, die
Meldungen von der Funktion verkuende empfangen sollen, den Raum str
hinzu.
VERWEISE: query_message_rooms, verkuende
GRUPPEN: schiff
*/
void add_message_room(mixed ob)
{
  if (!message_rooms)
    message_rooms = ({});
  else
    message_rooms -= ({0});
  if (!objectp(ob))
    ob = find_object(ob);
  if (ob)
  {
    if (member(message_rooms, ob) < 0)
      message_rooms += ({ ob });
    if (commander)
      commander->add_message_room(ob);
  }
}

