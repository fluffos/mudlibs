#include <udp.h>

#define DEBUG(msg)	if (find_player("freaky"))\
			tell_object(find_player("freaky"), msg)

void udp_ping(mapping data) {

//  DEBUG("In ping: "+mixed2str(data)+"\n\n");

    INETD->send_udp(data[NAME], ([
	REQUEST: REPLY,
	RECIPIENT: data[SENDER],
	ID: data[ID],
	DATA: LOCAL_NAME + " laeuft.\n"
    ]) );
}
