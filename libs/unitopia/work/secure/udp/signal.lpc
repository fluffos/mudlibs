#include <udp.h>
#include <apps.h>

void create()
{
}

void udp_signal(mapping data)
{
    if(object_name(previous_object()) != INETD)
	return;

    if (!stringp(data["TYPE"]))
    {
	sys_log("UDP-Signal","Invalid udp-signal: No type.\n");
	return;
    }
    
    switch(data["TYPE"])
    {
	case "enzy":
	    HELP_TOOL->do_read();
	    break;
	case "udptest":
	    INETD->send_udp(data[NAME], ([
    		REQUEST: REPLY,
	        RECIPIENT: data[SENDER],
		ID: data[ID],
		DATA: "*"*64615
	    ]) );
	case "zz":
	    {
		object ob = find_object(data[DATA]);
		if(ob)
		    destruct(ob);
	    }
	    break;
    }
    return;
}
