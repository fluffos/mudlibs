#include <rpc.h>
#include <config.h>

#ifdef Orbit
#define PEEPROOM "/room/church"

nosave string show()
{
    return PEEPROOM->query_long();
}

void send_room_message(string msg)
{
    if(object_name(previous_object()) != PEEPROOM)
        return;

    RPC_SERVER->daemon_call(0, "peep", "message", msg);
}

void call(closure cb, mixed* args)
{
    if(object_name(previous_object()) != RPC_SERVER)
        return;

    funcall(cb, apply(#'call_other, this_object(), args));
}
#endif
