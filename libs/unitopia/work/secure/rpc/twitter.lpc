// Twitter-Interface fuer UNItopia
//
//

// Im Wesentlichen leiten wir die Aufrufe weiter ans TWITTERD bzw.
// in umgekehrter Richtung ans RPC-Interface.
// Dieses Objekt dient daher vor allem als Sicherheitsfilter.

#include <rpc.h>
#include <apps.h>

nosave void receive(mapping msg)
{
    TWITTERD->receive(msg);
}

void call(closure cb, mixed* args)
{
    if(object_name(previous_object()) != RPC_SERVER)
	return;
    
    funcall(cb, apply(#'call_other, this_object(), args));
}

void sendunimsg(string msg)
{
    if(object_name(previous_object()) != TWITTERD)
        return;

    RPC_SERVER->daemon_call(0, "twitter", "sendunimsg", msg);
}

void get_auth_url(closure cb)
{
    if(!playerp(previous_object()))
        return;

    RPC_SERVER->daemon_call(cb, "twitter", "get_auth_url");
}

void authorize(closure cb, string token, string secret, string pin)
{
    if(!playerp(previous_object()))
        return;

    RPC_SERVER->daemon_call(cb, "twitter", "authorize", token, secret, pin);
}

void send_player_msg(closure cb, string msg, string token, string secret)
{
    if(!playerp(previous_object()))
        return;

    RPC_SERVER->daemon_call(cb, "twitter", "send_player_msg", msg, token, secret);
}
