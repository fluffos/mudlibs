 * Original authors: Garthan, Kurdel, Sissi, Freaky, Tmm, Gnomi, Myonara.
 * Original LDMud room is preserved as /room/church_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "westen": "/room/rathaus/treppe",
    "west": "/room/rathaus/treppe",
    "w": "/room/rathaus/treppe",
    "norden": "/room/kirche/unten",
    "north": "/room/kirche/unten",
    "n": "/room/kirche/unten",
  ]);
  extras = ([
    "stein":
    "An der Seitenwand in der Kathedrale steht ein grosser Stein, die "
    "vielen Buchstaben, die auf ihm stehen, deuten darauf hin, dass es "
    "sich dabei um eine Gedenktafel handelt, auf der man lesen kann, wer "
    "wann woran gestorben ist.\n",
    "gedenktafel":
    "An der Seitenwand in der Kathedrale steht ein grosser Stein, die "
    "vielen Buchstaben, die auf ihm stehen, deuten darauf hin, dass es "
    "sich dabei um eine Gedenktafel handelt.\n",
    "gruft":
    "Im Innern herrscht tiefe Dunkelheit, so dass du keine Einzelheiten "
    "erkennen kannst.\n",
    "portal":
    "Von innen wirkt das Portal im Gegensatz zum Anblick von Aussen "
    "recht schlicht.\n",
    "schild":
    "Es ist etwas draufgeschrieben.\n",
    "uhr":
    "Die grosse Kirchenuhr ueber dem Westportal zeigt die Tadmor-Zeit an.\n",
    "fenster":
    "Es ist eines jener bunten Motivfenster, die vollgestopft sind mit "
    "irgendwelchen Gestalten aus dem Pantheon. In einem der Teilfenster "
    "meinst du eine Darstellung eines Turmes zu erkennen, der Dich an den "
    "Stuttgarter Fernsehturm erinnert. Hinter den Fenstern erkennst du nur "
    "schemenhaft einen kleinen Friedhof.\n",
    "mauer":
    "Die Mauer ist schlicht gehalten, in der Naehe des Westportals fuehrt "
    "eine kleine Tuer nach Norden.\n",
  ]);
}

string query_short() { return "Kathedrale"; }

string query_long() {
  return "Du befindest dich in der Kathedrale von Tadmor.\n"
    "In der Mitte des Chores ist eine tiefe Gruft eingelassen. Die Leute "
    "sagen, dass manchmal die Geister der Toten hierher kommen und in der "
    "Hoffnung, zum Leben wiedererweckt zu werden, anfangen zu beten.\n"
    "In der Naehe des Ausgangs steht ein Schild, und ueber dem Portal im "
    "Westen haengt eine grosse Uhr. Im Osten erkennst du ein grosses, "
    "buntes Kirchenfenster. An der Seitenmauer steht ein grosser Stein. An "
    "der noerdlichen Mauer, in der Naehe des Portals, fuehrt eine schmale "
    "Tuer in einen Nebenraum.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt zwei sichtbare Ausgaenge: norden und westen.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_read(string item) {
  if (!item)
    return 0;
  if (lower_case(item) == "schild")
    return "Zum Kloster der Barmherzigen Magyrianerinnen nach Westen.\n";
  if (lower_case(item) == "uhr")
    return "Es ist jetzt " + ctime(time())[11..15] + " Uhr in Tadmor.\n";
  if (lower_case(item) == "stein" || lower_case(item) == "gedenktafel")
    return "Die Totenglocke 'Verdombde' traegt die Namen der Gefallenen ueber Tadmor.\n";
  return 0;
}
