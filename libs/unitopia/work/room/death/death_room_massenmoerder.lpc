// description.h includen.
//
// Revision 1.2  2006/12/30 01:08:48  gnomi
// Lars ist nur dann sichtbar, wenn er laut Sequenz da ist.
//
// Revision 1.1  2003/11/14 03:40:45  gnomi
// Massenmoerdertod.
//
//

inherit "/i/room/death_room";

#include <level.h>
#include <description.h>

object death;

void get_tod ()
{
   if (!death) 
      death = touch("/room/death/death_massenmoerder");
   if (!present (death))
      death->move(this_object());
}

void create()
{
   ::create ();
   set_nicht_tot_meldung ("Der Tod sagt: WAS TUST DU HIER? "
                           "DEINE ZEIT IST NOCH NICHT REIF!\n\n");
   set_ende_meldung ("Der Tod sagt: DU KANNST DEM TOD NICHT ENTRINNEN!\n");
   set_short("Arbeitszimmer des Todes");
   set_long(
      "Ein dunkler Raum, erleuchtet von dunklem Licht, das sich der Dunkelheit "
      "nicht so sehr zu widersetzen scheint, indem es leuchtet, als dass es " 
      "der dunkelste Punkt in einer weniger dunklen Umgebung ist. "
      "Im seltsamen Licht siehst du einen zentral aufgestellen Schreibtisch, "
      "der mit Diagrammen und Buechern bedeckt ist. "
      "Die Waende verschwinden hinter Regalen, die gefuellt sind mit in Leder "
      "gebundenen, dunklen Waelzern, von denen geheimnisvolle Runen leuchten.");
   add_v_item(([
      "name": "lars",
      "gender": "maennlich",
      "personal": 1,
      "living":1,
      "invis": T_OR(T_LESSER("sequence", 55),T_GE("sequence",75)),
      "long":"Lars Pensjoe, eine historische Gestalt aus der Gruenderzeit der "
	     "Muds. Warum er hier noch rumgeistert bleibt wohl sein Geheimnis.",      ]));
}

int do_sequence (object wer, int nr)
{
#define WRITE(x) tell_object(wer, x)
#define SPEAK(x) tell_object(wer, "Der Tod sagt: " + x)

    int female;
    if (nr > 125) return -1; // sollte an sich nie passieren.
    female =  wer->query_gender()=="weiblich";
    switch(nr) {
        case 10:
	    SPEAK("DIE ZEIT IST REIF!\n");
	    WRITE("\nDer Tod hebt einen Arm und macht eine winkende Bewegung.\n"
		  "Du bist recht sicher, dass, falls Du noch am Leben waerest, Du vor Angst auf\n"
		  "der Stelle gestorben waerest. Seltsamerweise fuehlst Du gar nichts derartiges.\n"
		  "Lediglich eine leichte Neugier.\n\n");
	    return 0;
	case 15:
	    SPEAK("KEINE DRUESEN, DAS IST DER GRUND.\n");
	    WRITE("\nDer Tod scheint ein wenig zu laecheln. Andererseits ist das ein bisschen schwer\n" 
		  "zu sagen. Das koennte ebensogut sein normaler Gesichtsausdruck sein...\n\n");
	    return 0;
	case 20:
	    SPEAK("OHNE DRUESEN FUEHLST DU NICHTS, UEBERHAUPT NICHTS.\n");
	    WRITE("\nNun, er scheint Recht zu haben. Statt vor Angst verrueckt zu werden, beginnst\n"
	          "Du dich zu langweilen. Du wuenschst Dir, dass sehr bald etwas passieren moege.\n\n");
	    return 0;
	case 27:
	    SPEAK("KOMM ZU MIR, ICH MUSS IN DEINER SEELE LESEN.\n");
	    WRITE("\nDer Tod kommt naeher, streckt seine Knochenhand direkt in Deinen Koerper\n"
	          "und greift darin nach etwas! Du fuehlst ein seltsames Reissen in Deinem\n"
		  "Inneren, als Deine Seele fuer die Untersuchung entfernt wird... Ploetzlich\n"
		  "sammelt der Tod Deine koerperlose Existenz mit einer umfassenden,\n"
		  "wischenden Bewegung seiner Skeletthand und legt Dich in eine kleine\n"
		  "Glasschale, die er in seine rechte Augenhoehle einsetzt! Du fuehlst ein\n"
		  "komisches, blaues Licht aus seinem augenlosen Schaedel in Dich eindringen,\n"
		  "als er sich ueber das Diagramm beugt.\n\n");
	    return 0;
	case 40:
	    SPEAK("DEINER SUENDEN SIND SO VIELE WIE SANDKOERNER IN DER WUESTE.\n"
		  "VIELLEICHT BIST DU EIN SCHLIMMERES WESEN ALS ICH! HAHAHAHAHAHA!\n\n");
	    return 0;
	case 47:
	    SPEAK("NUN, ICH GLAUBE, DAS WAR'S ERSTMAL FUER DICH. WIR SEHEN UNS AM\n"
		  "JUENGSTEN TAG! HAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAH!\n\n");
	    WRITE("Der Tod entfernt die Schale aus seinem Auge und steht auf. Ploetzlich dreht er\n"
		  "sich um und verlaesst den Raum durch die naechste Wand. Dabei haelt er Dich im-\n"
		  "mer noch in seiner Hand. Er geht schnell durch einen dunklen, sich windenden\n"
		  "Korridor, eine Wendeltreppe herunter zum tiefsten Raum in seinem Keller.\n"
		  "Schliesslich stoppt er vor einer Tuer, auf der in schwarzen Buchstaben das\n"
		  "Wort 'EWIGKEIT' steht. Auf dem Boden siehst Du eine kleine Luke, die der Tod\n"
		  "oeffnet und aus der Du dann das Murmeln von vielen Millionen Seelen hoerst.\n"
		  "Langsam bewegt er Dich auf das gaehnende Loch zu.\n\n");
	    return 0;
	case 55:
	    WRITE("Lars erscheint durch einen Riss im Vorhang der Welten.\n");
	    return 0;
	case 58:
	    WRITE("Lars laechelt Dich an.\n");
	    return 0;
	case 61:
	    WRITE("Lars fluestert dem Tod etwas zu.\n");
	    return 0;
	case 63:
	    SPEAK("WAS? KOMMT GAR NICHT IN FRAGE! DAS WEISST DU DOCH, LARS!\n\n");
	    return 0;
	case 66:
	    WRITE("Lars seufzt tief.\n"); 
	    return 0;
	case 69:
	    WRITE("Lars fluestert dem Tod etwas zu.\n");
	    return 0;
	case 72:
	    SPEAK("REINKARNATION? FUER DIESE"+(female?"":"N")+" HIER? "
	          "DAS IST "+(female?"SIE":"ER")+" NICHT WERT!\n"
	          "BITTE SEI VERNUENFTIG, LARS!\n\n");
	    return 0;
	case 75:
	    WRITE("Lars sagt: Ja, da hast Du eigentlich recht.\n");
	    WRITE("Lars seufzt.\n");
	    WRITE("Lars verschwindet durch einen Riss im Vorhang der Welten.\n");
	    return 0;
	case 82:
	    WRITE("Der Tod schaut Dich an mit einem Blick, der etwas ausdrueckt, das Ekel\n"
		  "sein muss, auch wenn es schwer zu sagen ist. Sein Gesicht ist nicht sehr gut\n"
		  "geeignet, Gefuehle auszudruecken, aber diesmal bist du einigermassen sicher.\n\n");
	    return 0;
	case 86:
	    SPEAK("DANN MAL HURTIG ANS WERK.\n");
	    WRITE("Der Tod schwingt pruefend seine Sense.\n");
	    return 0;
	case 90:
	    WRITE("Der Tod schwingt seine Sense mitten durch dich hindurch.\n"
	          "Du spuerst einen stechenden Schmerz, und doch spuerst du nichts.\n"
	          "Du merkst nur, dass etwas von dir fehlt... dein Wissen, deine Erfahrung.\n");
	    return 0;
	case 94:
	    WRITE("Der Tod schwingt wieder seine Sense, und wieder mitten durch dich hindurch.\n"
	          "Du spuerst wieder einen stechenden Schmerz, und obwohl du nichts spuerst,\n"
	          "fuehlt es sich diesmal ganz anders an.\n"
	          "Es fuehlt sich wieder an, als ob Dir etwas wichtiges verloren gegangen ist.\n"
	          "So als ob Ausdauer und Staerke dahinschwinden.\n");
	    return 0;
	case 98:
	    WRITE("Der Tod schwingt erneut seine Sense, diesmal mit einer voellig merkwuerdigen\n"
	          "Bewegung, und wieder mitten durch dich hindurch.\n"
	          "Du kommst dir voellig ungeschickt vor... und dumm wie ein Kartoffelsack.\n"
	          "Du schaemst dich.\n");
	    return 0;

	case 102:
	    WRITE("Lars erscheint durch einen Riss im Vorhang der Welten.\n");
	    return 0;
	case 106:
	    WRITE("Lars seufzt tief.\n");
	    return 0;
	case 108:
	    WRITE("Lars fluestert dem Tod etwas zu.\n");
	    return 0;
	case 112:
	    SPEAK("EWIGEN FRIEDEN? DU HAST RECHT, DEN HAT DIESE"
	        +(female?"":"N")+" HIER NICHT VERDIENT!\n");
	    return 0;
	case 116:
	    WRITE("Lars schmunzelt.\n");
	    WRITE("Lars verschwindet durch einen Riss im Vorhang der Welten.\n");
	    return 0;
	case 120:
	    WRITE("Der Tod schaut Dich an mit einem Blick, der etwas ausdrueckt, das Schadenfreude\n"
		  "sein muss, auch wenn es schwer zu sagen ist. Sein Gesicht ist nicht sehr gut\n"
		  "geeignet, Gefuehle auszudruecken, aber diesmal bist du einigermassen sicher.\n\n");
	    return 0;
	case 124:
	       SPEAK("SO LEBE DEIN SCHRECKLICHES LEBEN WEITER. BIS ZUM NAECHSTEN MAL!\n\n");
	       WRITE("Ploetzlich schleudert der Tod Dich in die Luft, Du hast eine seltsame Empfin-\n"
		     "dung als Du durch die Waende des Gebaeudes, hinaus in die frische Luft, durch\n"
		     "einige andere Waende und ziemlich ueberraschte Pferde fliegst und schliesslich\n"
		     "in einem anderen Gebaeude landest. Es wirkt vage vertraut...\n");
	       return -1;
        default: return 0;
    }
}

