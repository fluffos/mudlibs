string query_short() { return "Das Nirwana"; }

string query_long() { return "Du bist im Nirwana.\n"; }

string query_exit(string dir) {
  if (dir == "runter" || dir == "down" || dir == "d" || dir == "raus")
    return "/room/church";
  return 0;
}

string query_exit_string() { return "Der sichtbare Ausgang ist runter.\n"; }
