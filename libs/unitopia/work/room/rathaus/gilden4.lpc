mapping exits;

void create() {
  exits = ([
    "osten": "/room/rathaus/gilden3",
    "east": "/room/rathaus/gilden3",
    "o": "/room/rathaus/gilden3",
    "e": "/room/rathaus/gilden3",
    "westen": "/room/rathaus/gilden5",
    "west": "/room/rathaus/gilden5",
    "w": "/room/rathaus/gilden5",
  ]);
}

string query_short() { return "Gang der Gilden"; }

string query_long() {
  return "In den Raeumen links und rechts von diesem Gang praesentieren sich "
    "saemtliche, ueber Magyra verteilte Gilden. Noerdlich von hier befindet "
    "sich der Raum der Sehergilde; im Sueden hoerst Du Musik aus dem Raum "
    "der Bardengilde.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt zwei sichtbare Ausgaenge: osten und westen.\n";
}
