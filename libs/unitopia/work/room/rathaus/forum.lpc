mapping exits;
mapping extras;

void create() {
  exits = ([
    "runter": "/room/rathaus/reinkarnation",
    "unten": "/room/rathaus/reinkarnation",
    "down": "/room/rathaus/reinkarnation",
    "d": "/room/rathaus/reinkarnation",
    "nische": "/room/rathaus/nische",
  ]);
  extras = ([
    "kuppel":
    "Die gold-blau getuenchte Kuppel mit ihren seitlichen Oberlichtern "
    "gibt dem grossen Raum eine angenehme Atmosphaere.\n",
    "lakaien":
    "Geschaeftige Lakaien wandeln von einem Buero zum naechsten und "
    "sorgen fuer rege Betriebsamkeit im Forum.\n",
    "nische":
    "Eine helle Fensternische oeffnet sich zur Seite.\n",
  ]);
}

string query_short() { return "Das Forum"; }

string query_long() {
  return "Du stehst im kreisrunden Forum der Goetter, zu allen Seiten erstrecken "
    "sich Ausgaenge, die in die diversen Verwaltungsraeume des Rathauses "
    "fuehren. Dies ist das Herz UNItopias. Saemtliche Informationen werden "
    "hier erfasst und verarbeitet. Geschaeftige Lakaien wandeln von einem "
    "Buero zum naechsten und sorgen fuer rege Betriebsamkeit im Forum. "
    "Die gold-blau getuenchte Kuppel mit ihren seitlichen Oberlichtern "
    "gibt dem grossen Raum eine angenehme Atmosphaere. Eine Treppe fuehrt "
    "nach unten zu den Sterblichen.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt zwei sichtbare Ausgaenge: runter und nische.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
