inherit "%room";
inherit "%rauswurf_tuer";

#include <apps.h>
#include <level.h>
#include <message.h>

void reset()
{
    "*"::reset();
}

void create()
{
    "*"::create();
    set_short("Gang der Spielerratsraeume");
    set_long(
      "Du stehst im Ostfluegel des Rathauses in einem breiten Gang, "
      "der in Ost - West - Richtung verlaeuft. Westlich von hier "
      "muendet der Gang ins Foyer des Rathauses, weit im Osten "
      "fuehrt der Gang auf ein grosses Fenster zu. "
      "In den Raeumen suedlich und noerdlich des Ganges befinden sich "
      "die Raeumlichkeiten des Spielerrates.");
    add_v_item ((["name":"gang","gender":"maennlich",
      "long":"Ein Gang. Er fuehrt von Osten nach Westen, oder von Westen "
             "nach Osten, oder beides gleichzeitig. Und Du stehst mitten "
             "drin; weiter im Westen fuehrt er ins Foyer des Rathauses, "
             "weiter entfernt im Osten fuehrt er auf ein grosses Fenster "
             "zu."
    ]));
    add_v_item((["name":"fenster","gender":"saechlich",
        "long":"Der Gang fuehrt weiter entfernt im Osten auf ein grosses "
               "Fenster zu, von hieraus kannst Du allerdings noch nichts "
               "erkennen.",
        "look_msg":"$Der(OBJ_TP) schaut in Richtung Osten zum grossen "
               "Fenster hinueber, kann von hier aus allerdings anscheinend "
               "nichts erkennen"
    ]));

    set_exits( ({ abs_path("../foyer"),
            "gang2",
            "raum1",
            "raum2",
            "archivkeller",          }),
            ({ "westen", "osten", "norden", "sueden","runter" }) );
            
    set_tuer_richtung("norden");   
    reset();
}

int filter_sueden(object ob)
{
    if(wizp(ob) || SPIELERRAT->is_spielerrat(ob))
	return 0;
    else
    {
	tell_object(ob,wrap("Dieser Raum ist exklusiv fuer den "
	    "Spielerrat UNItopias, Du darfst hier leider nicht hinein."));
	return 1;
    }
}

void moved_in(object move_objekt, object woher, string dir, int way)
{ 
    if(object_name(woher)=="/room/rathaus/foyer" && this_player()==move_objekt)
        call_out("send_message_to", 1, this_player(),
	    MT_NOTIFY, MA_UNKNOWN,
    	    "Dies ist ein Bereich ausserhalb des Spieles.\n");
}
