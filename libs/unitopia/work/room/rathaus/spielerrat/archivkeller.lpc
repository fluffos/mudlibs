inherit "%room";

#include <apps.h>
#include <invis.h>
#include <level.h>
#include <message.h>
#include <misc.h>
#include <move.h>

#define DEBUGGER "myonara"
#include <debug.h>

#define PR_INDEX "/obj/protokollindex"

void reset()
{
    "*"::reset();
}

string query_long(object viewer)
{
    string text = ::query_long(viewer);
    if (wizp(viewer) || spielerratp(viewer))
    {
        return text
              +wrap("An der einen Wand faellt dir ein Protokollindex auf.");
    }
    return text;
}

string take_index(mapping vitem)
{
    if (wizp(TP) || spielerratp(TP))
    {
        if (present_clone(PR_INDEX,TP))
            return wrap("Du besitzt bereits einen Protokollindex.");
        object ob = clone_object(PR_INDEX);
        if (ob->move(TP,MOVE_ERR_REMOVE) == MOVE_OK)
            return wrap("Du nimmst dir einen Protokollindex, probiere "
                "pr:? aus.");
        else
            return wrap("Du hast keinen Protokollindex nehmen koennen.");
    }
    return 0; // Da gibt es nichts zu holen.
}
int invis_index(mapping vitem)
{
    if (wizp(TP) || spielerratp(TP))
    {
        return V_HIDDEN;
    }
    return V_INVIS;
}

void create()
{
    "*"::create();
    set_short("Archivkeller der Spielerratsraeume");
    set_long(
      "Du befindest dich im Protokollarchiv des Spielerrates, dass im Keller "
      "des Rathauses untergebracht ist. Hinter einem Gitter befinden sich "
      "lange Reihen von Regalen mit vielen Ordnern.");
    add_v_item ((["name":"gitter","gender":"saechlich","id":({"gitter","tuer"}),
      "long":"Ein robustes Gitter ohne erkennbare Tuer."
    ]));
    add_v_item((["name":"regale","gender":"saechlich","plural":1,
        "id" : ({ "regale","regal","ordner" }),
        "long":"Du kannst nur erkennen, dass es viele Ordner gibt, "
        "aber nicht, was da enthalten ist.",
        "look_msg": "$Der(OBJ_TP) schaut in die Weiten der Regalreihen.",
        "smell":"Die Regale riechen nach Staub, das kitzelt in der Nase.",
        "smell_msg":"$Der(OBJ_TP) muss kraeftig niesen.",
    ]));
    add_v_item(([
        "name":"index","gender":"maennlich",
        "id":({"index","protokollindex"}),
        "long" : "Der Protokollindex hilft dem Spielerrat oder Gott, "
                 "die Protokolle anzusehen. Du kannst den Index nehmen.",
        "look_msg": "$Der(OBJ_TP) schaut in die Weiten der Regalreihen.",
        "take": #'take_index,
        "invis" : #'invis_index,
    ]));
    

    set_exits( ({ "gang1" }), ({ "hoch" }) );

    reset();
}

int filter_sueden(object ob)
{
    if(wizp(ob) || SPIELERRAT->is_spielerrat(ob))
	return 0;
    else
    {
	tell_object(ob,wrap("Dieser Raum ist exklusiv fuer den "
	    "Spielerrat UNItopias, Du darfst hier leider nicht hinein."));
	return 1;
    }
}

void moved_in(object move_objekt, object woher, string dir, int way)
{ 
    if(object_name(woher)=="/room/rathaus/foyer" && this_player()==move_objekt)
        call_out("send_message_to", 1, this_player(),
	    MT_NOTIFY, MA_UNKNOWN,
    	    "Dies ist ein Bereich ausserhalb des Spieles.\n");
}
