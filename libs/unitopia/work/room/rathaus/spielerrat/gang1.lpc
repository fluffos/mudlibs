mapping exits;
mapping extras;

void create() {
  exits = ([
    "westen": "/room/rathaus/foyer",
    "west": "/room/rathaus/foyer",
    "w": "/room/rathaus/foyer",
  ]);
  extras = ([
    "gang":
    "Ein Gang. Er fuehrt von Osten nach Westen, oder von Westen nach "
    "Osten, oder beides gleichzeitig. Weiter im Westen fuehrt er ins "
    "Foyer des Rathauses.\n",
    "fenster":
    "Der Gang fuehrt weiter entfernt im Osten auf ein grosses Fenster "
    "zu, von hier aus kannst Du allerdings noch nichts erkennen.\n",
  ]);
}

string query_short() { return "Gang der Spielerratsraeume"; }

string query_long() {
  return "Du stehst im Ostfluegel des Rathauses in einem breiten Gang, der in "
    "Ost-West-Richtung verlaeuft. Westlich von hier muendet der Gang ins "
    "Foyer des Rathauses, weit im Osten fuehrt der Gang auf ein grosses "
    "Fenster zu. In den Raeumen suedlich und noerdlich des Ganges befinden "
    "sich die Raeumlichkeiten des Spielerrates.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Der sichtbare Ausgang ist westen.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
