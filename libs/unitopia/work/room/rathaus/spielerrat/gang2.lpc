inherit "%room";
inherit "%rauswurf_tuer";

#include <apps.h>
#include <level.h>

void reset()
{
    "*"::reset();
}

void create()
{
    "*"::create();
    set_short("Gang der Spielerratsraeume");
    set_long(
      "Du stehst im Ostfluegel des Rathauses am Ende eines breiten Ganges, "
      "der von hier nach Westen fuehrt. Weit westlich von hier muendet "
      "der Gang ins Foyer des Rathauses, oestlich von Dir befindet sich "
      "ein grosses Fenster. "
      "In den Raeumen suedlich und noerdlich des Ganges befinden sich "
      "die Raeumlichkeiten des Spielerrates. "
      "Deutlich faellt Dir ein sehr wichtig aussehendes Dokument "
      "an der oestlichen Wand auf.");
    add_v_item ((["name":"gang","gender":"maennlich",
      "long":"Ein Gang. Er fuehrt von hier nach Westen in Richtung Foyer. "
    ]));
    add_v_item (([
	"name":"wand",
	"gender":"weiblich",
	"adjektiv":({"oestlich"}),
	"long": "Eine Wand. Einzig auffaellig daran ist ein Pergament, "
	        "welches schoen eingerahmt an dieser Wand haengt."
    ]));
    add_v_item((["name":"fenster","gender":"saechlich",
        "id":({"fenster","aus"}),
        "long":"Von hier aus hast Du einen herrlichen Blick auf den Dijala, "
               "wie er nordoestlich von hier in oestlicher Richtung "
               "dem Meer entgegen durch seine "
               "wunderschoenen Uferwiesen fliesst. Weiter weg im Osten "
               "siehst Du ihn unter der Nordbruecke verschwinden. "
               "Sued-oestlich von hier ragt die grosse Kathedrale Tadmors "
               "hoch in den Himmel.",
        "look_msg":"$Der(OBJ_TP) schaut ueberwaeltigt von der herrlichen "
               "Aussicht aus dem Fenster."
    ]));

    add_v_item(([
               "name"   : "kodex des Spielerrates",
               "id"     : ({"kodex","spielerratskodex","srkodex","pergament",
                            "blatt","papier","pergamentblatt","pergamentpapier",
			    "dokument"}),
               "gender" : "maennlich",
               "long"   : "Eine recht frisch aussehendes Pergamentblatt, "
                          "auf welchem der Kodex des Spielerrates von "
                           MUD_NAME " geschrieben steht.",
               "read"   : (:this_player()->more("/nosave/adm/SPIELERRATSKODEX");
                            return "";
                          :)
               ]));

    set_exits( ({ "gang1",
		  "raum3",
		  "raum4" }),
	       ({ "westen", "norden", "sueden" }) );
	       
    set_tuer_richtung("sueden");
    reset();
}

int filter_norden(object who)
{
    if(wizp(who) || SPIELERRAT->is_spielerrat(who))
	return 0;
    else
    {
	tell_object(who,wrap("Dieser Raum ist exklusiv fuer den "
	    "Spielerrat UNItopias, Du darfst hier leider nicht hinein."));
	return 1;
    }
}
