	    getraenk(26);
	    return 1;
        case "orange-Kiwi-Saft":
        case "kiwisaft":
        case "orangekiwisaft":
	    getraenk(27);
	    return 1;
        case "heidelbeersaft":
	    getraenk(28);
	    return 1;
        case "gummibaersaft":
	    getraenk(29);
	    return 1;
    }
    notify_fail("Was willst Du Dir mixen?\n");
    return 0;
}

int let_not_out(object wer,object wohin,string dir)
{
    object *ob;
    if(object_name(wohin) == "/room/void") 
	return 0;
	
    if(wizp(wer) || deep_present(wohin,this_object()))
        return ::let_not_out(wer,wohin,dir);

    if(wer->query_stay_in_pub() ||
       cond_deep_present(0, wer, CDP_DEPTH_FIRST, "query_stay_in_pub"))
    {
        wer->set_not_moved_reason("Geniess Dein Getraenk doch lieber hier.");
	return 1;
    } 
    
    return ::let_not_out(wer,wohin,dir);
}   

void moved_out(object wer, object wohin, string dir, int wie)
{
    if(!wizp(wer) && !deep_present(wohin,this_object()))
    {
	if(wer->query_stay_in_pub())
	    call_out((: $1 && $1->remove() :), 0, wer);
	else
	    filter_objects(deep_inventory(wer), "query_stay_in_pub")->remove();
    }

    ::moved_out(wer, wohin, dir, wie);	
}
