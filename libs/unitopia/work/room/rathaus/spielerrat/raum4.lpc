	    return 1;
        case "karottensaft":
	    getraenk(17);
	    return 1;
        case "aprikosensaft":
	    getraenk(18);
	    return 1;
        case "waldmeistersaft":
	    getraenk(19);
	    return 1;
        case "himbeersaft":
	    getraenk(20);
	    return 1;
        case "johannissaft":
        case "johannisbeersaft":
	    getraenk(21+random(2));
	    return 1;
        case "brombeersaft":
	    getraenk(23);
	    return 1;
        case "birnensaft":
	    getraenk(24);
	    return 1;
        case "tropicsaft":
	    getraenk(25);
	    return 1;
        case "marakujasaft":
        case "orangemarakujasaft":
