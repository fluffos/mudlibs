 * This file was originally part of UNItopia MUDlib.
 * Original authors: Kurdel, Tmm, Gnomi, Myonara.
 * Original LDMud room is preserved as /room/rathaus/treppe_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "osten": "/room/church",
    "east": "/room/church",
    "o": "/room/church",
    "e": "/room/church",
    "norden": "/room/rathaus/foyer",
    "north": "/room/rathaus/foyer",
    "n": "/room/rathaus/foyer",
  ]);
  extras = ([
    "tafel":
    "Auf der Tafel an der Wand steht etwas geschrieben.\n",
    "treppe":
    "Fuenf Stufen aus Marmor.\n",
    "portal":
    "Vor dir steht ein maechtiger, aus einem massiven Sandsteinblock "
    "gehauener und mit Ornamenten verzierter Rundbogen.\n",
    "ornamente":
    "Du siehst sechs Linien, die sich auf ihrem Weg laengs des Bogens "
    "mehrmals verknaeueln und wieder entwirren.\n",
    "rathaus":
    "Der aus grossen Sandstein-Quadern gemauerte zweistoeckige, aber "
    "recht schmale Giebel wird nur durch wenige, kleine Fenster "
    "durchbrochen. Links und rechts schliessen sich jedoch augenscheinlich "
    "juengere, einstoeckige, nach Fachwerkart gebaute Fluegel an.\n",
    "tuerfluegel":
    "Zwei maechtige, aus altem Eichenholz gebaute und mit viel Eisen "
    "beschlagene Tuerfluegel stehen einladend offen.\n",
  ]);
}

string query_short() { return "Rathaustreppe"; }

string query_long() {
  return "Du stehst auf den Treppen vor dem Portal des Rathauses. An der Wand "
    "neben dem linken Tuerfluegel haengt eine Tafel. Meistens treiben sich "
    "hier ein paar Bettler herum.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt zwei sichtbare Ausgaenge: norden und osten.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_read(string item) {
  if (!item)
    return 0;
  if (lower_case(item) == "tafel" || lower_case(item) == "wand")
    return "\n"
      "          +-------------------------------+\n"
      "          |                               |\n"
      "          |     BETTELN UND HAUSIEREN     |\n"
      "          |          VERBOTEN !           |\n"
      "          |                               |\n"
      "          |            Der Buergermeister.|\n"
      "          +-------------------------------+\n\n";
  return 0;
}
