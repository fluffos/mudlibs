/*
 * This file was originally part of UNItopia MUDlib.
 * Original authors: Tmm, Gnomi, Tiberian.
 * Original LDMud room is preserved as /room/rathaus/foyer_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "sueden": "/room/rathaus/treppe",
    "south": "/room/rathaus/treppe",
    "s": "/room/rathaus/treppe",
    "norden": "/room/rathaus/reinkarnation",
    "north": "/room/rathaus/reinkarnation",
    "n": "/room/rathaus/reinkarnation",
    "westen": "/room/rathaus/gilden1",
    "west": "/room/rathaus/gilden1",
    "w": "/room/rathaus/gilden1",
    "osten": "/room/rathaus/spielerrat/gang1",
    "east": "/room/rathaus/spielerrat/gang1",
    "o": "/room/rathaus/spielerrat/gang1",
    "e": "/room/rathaus/spielerrat/gang1",
  ]);
  extras = ([
    "treppe":
    "Eine massive Steintreppe fuehrt entlang einer der Waende hinauf "
    "in den ersten Stock des Gebaeudes.\n",
    "wegweiser":
    "Ein grosser, stabiler Wegweiser steht hier direkt vor Deiner Nase "
    "und zeigt nach Norden, Sueden, Osten, Westen und auch nach oben. Du "
    "kannst ja mal lesen, was auf den einzelnen Schildern steht.\n",
    "torbogen":
    "Durch den Torbogen gelangt man in die Halle der Reinkarnation. Er "
    "besteht aus weissem Marmor und laesst erahnen, wie wichtig diese "
    "Halle sein muss.\n",
  ]);
}

string query_short() { return "Das Rathausfoyer"; }

string query_long() {
  return "Du stehst im Foyer des Rathauses von Tadmor. Hier im Rathaus kannst Du "
    "Dir Informationen ueber Gilden sowie Raetsel und Spiele beschaffen, "
    "dem schwarzen Brett Informationen entnehmen und auf diesem auch Deine "
    "Meinungen kund tun. Schliesslich kannst Du in der Halle der "
    "Reinkarnation den Schritt vollziehen, der Dich in die Schar der "
    "Engel erhebt.\n"
    "Zwei breite Gaenge fuehren nach Westen und Osten, noerdlich liegt "
    "hinter einem Torbogen eine grosse Halle. Der Ausgang des Rathauses "
    "liegt suedlich von Dir. Direkt vor Dir steht ein grosser Wegweiser.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt vier sichtbare Ausgaenge: norden, sueden, osten und westen.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_read(string item) {
  if (!item)
    return 0;
  if (lower_case(item) == "wegweiser" || lower_case(item) == "schilder")
    return "Auf dem Schild des Wegweisers, das nach Norden zeigt, steht "
      "\"Halle der Reinkarnation\", auf dem Schild, dessen Spitze nach "
      "Westen zeigt, steht \"Gildeninformationsraeume\". Auf dem Schild, "
      "welches in den Gang nach Osten zeigt, steht \"Spielerrat\", und "
      "auf dem Schild nach Sueden steht \"Tadmor / Magyra\".\n";
  return 0;
}

string query_smell(string item) {
  if (item && lower_case(item) == "wegweiser")
    return "Der Wegweiser riecht aeusserst angenehm nach Holz.\n";
  return "Der Marmor im Foyer ist voellig geruchsneutral.\n";
}

string query_feel(string item) {
  if (item && lower_case(item) == "torbogen")
    return "Der Torbogen fuehlt sich schoen glatt und ein wenig kuehl an.\n";
  if (item && lower_case(item) == "wegweiser")
    return "Der Wegweiser fuehlt sich sehr rauh an, wie festes, stabiles Holz.\n";
  return 0;
}
