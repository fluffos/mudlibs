mapping exits;

void create() {
  exits = ([
    "osten": "/room/rathaus/gilden1",
    "east": "/room/rathaus/gilden1",
    "o": "/room/rathaus/gilden1",
    "e": "/room/rathaus/gilden1",
    "westen": "/room/rathaus/gilden3",
    "west": "/room/rathaus/gilden3",
    "w": "/room/rathaus/gilden3",
  ]);
}

string query_short() { return "Gang der Gilden"; }

string query_long() {
  return "In den Raeumen links und rechts von diesem Gang praesentieren sich "
    "saemtliche, ueber Magyra verteilte Gilden. Suedlich befindet sich der "
    "Praesentationsraum des Hexenvolks. Aus der noerdlichen Kammer weht "
    "Dir feuchte Luft entgegen.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt zwei sichtbare Ausgaenge: osten und westen.\n";
}
