mapping exits;
mapping extras;

void create() {
  exits = ([
    "forum": "/room/rathaus/forum",
    "raus": "/room/rathaus/forum",
    "out": "/room/rathaus/forum",
  ]);
  extras = ([
    "kloster":
    "Ueber die Abteistrasse hinweg liegt das Kloster der Barmherzigen "
    "Magyrianerinnen.\n",
    "tul-o-mat":
    "Ein ziemlich unfoermiges Gebilde voller Werkzeuge fuer angehende "
    "Goetter.\n",
  ]);
}

string query_short() { return "Fensternische"; }

string query_long() {
  return "Du stehst in einer Fensternische. Von hier aus hast du einen schoenen "
    "Blick ueber die Abteistrasse hinweg auf das Kloster.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Der sichtbare Ausgang ist forum.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
