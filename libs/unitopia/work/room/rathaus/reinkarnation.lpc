 * This file was originally part of UNItopia MUDlib.
 * Original authors: Croft, Copper, Nethar, Gnomi, Sissi, Freaky, Myonara.
 * Original LDMud room is preserved as /room/rathaus/reinkarnation_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "sueden": "/room/rathaus/foyer",
    "south": "/room/rathaus/foyer",
    "s": "/room/rathaus/foyer",
    "hoch": "/room/rathaus/forum",
    "oben": "/room/rathaus/forum",
    "up": "/room/rathaus/forum",
    "u": "/room/rathaus/forum",
  ]);
  extras = ([
    "boden":
    "Die Marmorplatten bilden ein geometrisches Muster aus ineinander "
    "verschlungenen Doppelspiralen. In der Mitte der Halle ist eine "
    "grosse schwarze Platte eingelassen, auf deren Zentrum die Saeule "
    "der Weisheit steht.\n",
    "platte":
    "Die Platte ist kreisrund und eine Inschrift ist spiralfoermig von "
    "aussen nach innen eingemeisselt: 'Folge dem EINEN Weg und Du wirst "
    "es nicht bereuen, denn es ist der Weg der Goetter.'\n",
    "saeule":
    "Du siehst eine fuenf Meter hohe und ein Meter durchmessende Saeule "
    "aus weissem Marmor, die mit mehreren eingemeisselten Inschriften "
    "versehen ist.\n",
    "treppe":
    "Die Treppe ist wohl uralt, die Stufen schon ziemlich mitgenommen, "
    "sie fuehrt nach oben.\n",
    "schriftzeichen":
    "Zeichen eben, man kann sie lesen, wenn man kann.\n",
  ]);
}

string query_short() { return "Halle der Reinkarnation"; }

string query_long() {
  return "Du bist in der Halle der Reinkarnation. Sie hat einen quadratischen "
    "Grundriss von etwa 20 Metern Kantenlaenge; ihr Boden ist mit einem "
    "Mosaik aus verschiedenfarbigen Marmorplatten ausgelegt. Eine "
    "stattliche Anzahl von an den Waenden befestigten Fackeln taucht die "
    "Halle in ein unruhiges Daemmerlicht und die Decke verliert sich in "
    "einem Gewirr von russgeschwaerzten Balken.\n"
    "Rechts und links neben dem Torbogen befindet sich jeweils eine "
    "mannshohe Tafel. In der Mitte des Raumes steht auf einer grossen "
    "schwarzen Platte die Saeule der Weisheit. An der oestlichen Seite der "
    "Halle fuehrt eine alte, ausgetretene Treppe nach oben.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt zwei sichtbare Ausgaenge: sueden und hoch.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}

string query_read(string item) {
  if (!item)
    return 0;
  if (lower_case(item) == "platte")
    return "                        Folge dem EINEN Weg\n"
      "                        und Du wirst es nicht bereuen,\n"
      "                        denn es ist der Weg der Goetter.\n";
  if (lower_case(item) == "schriftzeichen")
    return "$B)hs0-*(k/ZDFInisoTndzxfQSDJH!\n"
      "Dir kommt das reichlich spanisch vor...\n";
  return 0;
}

string query_feel(string item) {
  if (item && lower_case(item) == "saeule")
    return "Der Marmor fuehlt sich glatt und etwas kuehl an.\n";
  if (item && lower_case(item) == "boden")
    return "Der Boden fuehlt sich glatt und sauber an.\n";
  return 0;
}
