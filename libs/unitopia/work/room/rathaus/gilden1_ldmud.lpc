// Description: Rathaus, Gildenraeume #1
//
// $Log: gilden1.c,v $
// Revision 1.3  2001/04/07 00:23:55  gnomi
// Header und/oder CVS-Log eingebaut.
//

inherit "/i/room";

void create()
{
    add_type("kunstlicht",1);
    add_type("kaempfen_verboten",1);
    add_type("landeplatz","treppe");
    set_own_light(1);
    set_short("Gang der Gilden");
    set_long(
      "In den Raeumen links und rechts von diesem Gang praesentieren sich "
      "saemtliche, ueber Magyra verteilte Gilden. "
      "Noerdlich von hier befindet sich der Raum der Abenteurergilde, aber die "
      "Tuere ist seltsamerweise verschlossen. Und suedlich ist der Raum"
      " der Druidengilde.");
    add_v_item( ([
		"name": "tuer",
		"id"  : ({ "tuer","tuere" }),
		"gender":"weiblich",
		"long":"Ein Zettel haengt an der geschlossenen Tuer:\n"
		      "\n"
       "             Kommt uns doch in unserem Gilden-Haus besuchen.\n"
       "          Es befindet sich im Westen des Kartukultininurta-Platzes.\n"
	    ]) );
	    set_exits( ({ "foyer",
		  "gilden2",
		  "/z/Gilden/Druidengilde/room/praesentation" }),
	       ({ "osten", "westen", "sueden" }) );
}

