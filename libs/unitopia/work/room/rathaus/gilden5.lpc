mapping exits;

void create() {
  exits = ([
    "osten": "/room/rathaus/gilden4",
    "east": "/room/rathaus/gilden4",
    "o": "/room/rathaus/gilden4",
    "e": "/room/rathaus/gilden4",
  ]);
}

string query_short() { return "Gang der Gilden"; }

string query_long() {
  return "In den Raeumen links und rechts von diesem Gang praesentieren sich "
    "saemtliche, ueber Magyra verteilte Gilden. Noerdlich von hier siehst Du "
    "einen ziemlich leeren Raum, im Sueden den Raum der alten "
    "Beschwoerergilde.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Der sichtbare Ausgang ist osten.\n";
}
