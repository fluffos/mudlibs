int filter_hoch(object who)
{
   if(!wizp(who))
      {
        tell_object(who, wrap(
            "Du betrittst die Treppe, die nach oben fuehrt; doch bereits "
            "nach der dritten Stufe verwandelt sie sich unter Deinen Fuessen "
            "in eine glatte Rutschbahn, die Du auch prompt runterrutschst. "
            "Sofort verwandelt sich die Rutsche wieder zurueck in eine "
            "Treppe und tut so, als ob nichts gewesen waere."));
        tell_room(this_object(), wrap(
            Der(who)+" betritt die Treppe, die nach oben fuehrt; doch bereits "
            "nach der dritten Stufe verwandelt sich diese unter den Fuessen "+
            des(who)+" in eine glatte Rutschbahn, die "+
            der(who)+" auch prompt runterrutscht. "
            "Sofort verwandelt sich die Rutsche wieder zurueck in eine "
            "Treppe und tut so, als ob nichts gewesen waere."),
            ({who}));
        return 1;
    }
}
