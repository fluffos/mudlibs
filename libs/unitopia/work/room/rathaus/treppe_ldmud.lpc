inherit "/i/room";
#ifdef UNItopia
#include "/d/Vaniorh/sys/vaniorh_exports.h"
inherit TOTENGRAEBERINHERIT;
#endif

#include <stats.h>
#include <config.h>
#include <deklin.h>
#include <invis.h>
#include <message.h>
#include <room.h>
#include <touch.h>
#include <umfragen.h>

int bereits_geholt;

void init()
{
  add_action("kratze","kratze",-5);
}

void reset()
{
  object ob,tisch;

  bereits_geholt = 0;
  if (!present("messer"))
  {
    object tmp;

    tmp = clone_object("/obj/nahkampf_waffe");
    tmp->set_id("messer");
    tmp->set_value(35);
    tmp->set_name("messer");
    tmp->set_long("Ein scharfes Messer. "
                  "Als reines Essutensil geht das nicht mehr durch. "
                  "Es besteht aus Metall.");
    tmp->set_gender("saechlich");
    tmp->set_material("metall");
    tmp->set_weight(2);
    tmp->set_skill_path(({ "skill", "offensiv", "scharf", "messer" }));
    tmp->set_used_stats(({ STAT_STR, STAT_DEX, STAT_DEX, STAT_INT }));
    tmp->set_damage(2,7);
    tmp->set_life(100);
    tmp->move(this_object());
  }

#ifdef UNItopia
  ob = touch(BETTLER);
  if (ob && !environment(ob))
    ob->move(this_object());
  if (!present("tisch",this_object()))
  {
    tisch=clone_object("/p/Item/Install/obj/desk");
    tisch->move(this_object());
    clone_object(ZEITUNG)->move(tisch); // Inhaltstyp festlegen
    tisch->reset(); // Auffuellen
  }
#endif
}

int hat_wendeltreppe()
{
    object master = touch(UMFRAGE_MASTER, NO_LOG|NO_WRITE);
    return master && master->ist_wolke_aktiv();
}

int filter_hoch(object wer)
{
    if (hat_wendeltreppe())
        return 0;
    wer->send_message_to(wer, MT_NOTIFY, MA_UNKNOWN,
        "Da geht's nicht weiter.\n");
    return 1;
}

string query_long(object wer)
{
    string t = ::query_long(wer);
    if (hat_wendeltreppe())
    {
        t+= wrap("Ueber dem Rathaus schwebt eine goldene Wolke, "
            "eine goldene Wendeltreppe fuehrt hoch zu ihr.");
    }
    return t;
}

void create()
{
  set_short("Rathaustreppe");
  set_long("Du stehst auf den Treppen vor dem Portal des Rathauses. An der "
           "Wand neben dem linken Tuerfluegel haengt eine Tafel. Meistens "
	   "treiben sich hier ein paar Bettler herum.");
  add_type("graben_verboten",
           "Hier auf der Treppe graben? Wie soll das "
             "gehen?");
  set_exits(({
#ifdef UNItopia
  K_PLATZ_NW,
#else
  "/room/church",
#endif
              "foyer"}),
            ({
#ifdef UNItopia
            "sueden",
#else
            "osten",
#endif
            "norden"}));
  add_exit("aufderwendeltreppe","hoch",EXIT_NOLIST);
  add_v_item(([
      "name"   : "tafel",
      "gender" : "weiblich",
      "id"     : ({"tafel", "wand"}),
      "long"   : "Auf der Tafel an der Wand steht etwas geschrieben.",
      "read"   : "\n"
                 "          +-------------------------------+\n"
                 "          |                               |\n"
                 "          |     BETTELN UND HAUSIEREN     |\n"
                 "          |          VERBOTEN !           |\n"
                 "          |                               |\n"
                 "          |            Der Buergermeister.|\n"
                 "          +-------------------------------+\n\n"]));
  add_v_item(([
               "name"   : "treppe",
               "gender" : "weiblich",
               "id"     : ({"treppe", "treppen"}),
               "long"   :"Fuenf Stufen aus Marmor."
            ]));
  add_v_item(([
               "name"   : "portal",
               "gender" : "saechlich",
               "id"     : ({"portal", "rundbogen", "bogen"}),
               "long"   : "Vor dir steht ein maechtiger, aus einem massiven "
                          "Sandsteinblock gehauener und mit Ornamenten "
                            "verzierter Rundbogen."]));
  add_v_item(([
               "name"   : "ornamente",
               "plural" : 1,
               "gender" : "saechlich",
               "id"     : ({"ornamente", "ornament"}),
               "long"   : "Du siehst sechs Linien, die sich auf ihrem Weg "
                        "laengs des Bogens mehrmals verknaeueln und wieder "
                        "entwirren."]));
  add_v_item(([
               "name"     : "linien",
               "gender"   : "weiblich",
               "plural"   : 1,
               "id"       : ({"linie", "linien", "gold", "spur", "spuren"}),
               "long"     : "Taeuscht das oder sind die Linien tatsaechlich "
                            "vergoldet?",
               "look_msg" : "$Der(OBJ_TP) sieht sich die Ornamente ganz genau "
                            "an"]));
  add_v_item(([
               "name"   : "rathaus",
               "gender" : "saechlich",
               "id"     : ({"rathaus", "haus", "gebaeude", "quader",
                            "sandsteinquader", "sandstein-quader", "giebel",
                            "fachwerk"}),
               "long"   : "Der aus grossen Sandstein-Quadern gemauerte "
                        "zweistoeckige, aber recht schmale Giebel wird "
                        "nur durch wenige, kleine Fenster durchbrochen. "
                        "Links und rechts schliessen sich jedoch "
                        "augenscheinlich juengere, einstoeckige, nach "
                        "Fachwerkart gebaute Fluegel an."]));
  add_v_item(([
               "name"   : "tuerfluegel",
               "gender" : "maennlich",
               "plural" : 1,
               "id"     : ({"tuer", "fluegel", "tuerfluegel", "eisen",
                            "eichenholz","holz"}),
               "long"   : "Zwei maechtige, aus altem Eichenholz gebaute und "
                        "mit viel Eisen beschlagene Tuerfluegel stehen "
                        "einladend offen."]));
  add_v_item(([
               "name"     : "stufen",
               "gender"   : "weiblich",
               "plural"   : 1,
               "id"       : ({"stufe", "stufen", "treppenstufe",
                            "treppenstufen", "marmor"}),
               "long"     : "Vier Meter breit, 30 cm hoch und aus Marmor.",
               "look_msg" : lambda(({}),({#'wrap,({#'+,({#'+,({#'+,({#'Der,
                            ({#'this_player})})," mustert "}),
                            ({#'seinen,(["name":"fuesse", "gender":"maennlich",
                            "plural":1]),0,({#'this_player})})}),
                            " - oder die Treppe?"})}))]));
  add_v_item(([
               "name"     : "wendeltreppe",
               "gender"   : "weiblich",
               "attribut" : ({ "golden" }),
               "id"       : ({"wendeltreppe", "treppe"}),
               "long"     : "Eine goldene Wendeltreppe fuehrt hoch in eine "
                            "goldene Wolke.",
               "invis"    : (: hat_wendeltreppe() ? V_VIS : V_INVIS :),
            ]));
  add_v_item(([
               "name"     : "wolke",
               "gender"   : "weiblich",
               "attribut" : ({ "golden" }),
               "id"       : ({"wolke"}),
               "long"     : "Eine goldene Wolke schwebt ueber dem Rathaus, "
                            "eine Wendeltreppe fuehrt hoch zu ihr.",
               "invis"    : (: hat_wendeltreppe() ? V_VIS : V_INVIS :),
            ]));
  reset();
}

int kratze(string str)
{
  object staub;
  string junk1, junk2;

  if (!str || !here(lower_case(str),"gold"))
  {
    notify_fail("Kratze was ?\n");
    return 0;
  }
  if (bereits_geholt)
  {
    write(wrap("Da war wohl bereits einer vor dir da, saemtliches Gold "+
 	       "ist bis auf Spuren abgekratzt."));
    return 1;
  }
  if (this_player()->free_hand()<0)
  {
    write("Ohne eine freie Hand?\n");
    return 1;
  }
  bereits_geholt = 1;
  write(wrap("Du kratzt etwas von dem Gold ab, das herunterfaellt."));
  say(wrap(Der(this_player())+" kratzt mit blossen Haenden an den Ornamenten "
           "des Portals herum."));
  this_player()->set_handeln();
  this_player()->add_align(-3*ALIGN_STRETCH);
  staub = clone_object("/obj/schatz");
  staub->set_id(({"staub","goldstaub","gold"}));
  staub->set_name("goldstaub");
  staub->set_gender("maennlich");
  staub->set_long("Ein kleines Haeufchen Goldstaub.");
  staub->set_smell("Es riecht nach Reichtum.");
  staub->set_menge((["name":"haeufchen","gender":"saechlich"]));
  staub->set_value(100);
  staub->set_material("edelmetall");
  staub->move(this_object());
  return 1;
}
