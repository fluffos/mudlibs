inherit "/i/item";
inherit "/i/install";
inherit "../i/new_tip";

#include <message.h>
 
void create()
{
    set_name ("Formblatt fuer neue Tips");
    set_gender ("saechlich");
    set_id (({"formblatt","blatt","form"}));
    set_weight (0);
    set_no_move_reason (wrap_say("Das Formblatt sagt:",
        "Es ist nicht gestattet, mich wegzulegen, wegzustecken "
        "oder wegzugeben. Du musst mich schon ausfuellen.")
        +"Das Formblatt laechelt Dich froehlich an.");
    set_long ("Ein oedes, langweiliges Formblatt, wie man es "
        "eben in Rathaeusern bekommt. Wie es sich fuer ein richtiges "
        "Formblatt gehoert, kann man es lesen. Das Aufregendste "
        "an dem Formblatt duerfte allerdings sein, dass Du es ausfuellen "
        "kannst, schliesslich ist das Ausgefuelltwerden der ganze "
        "Lebensinhalt eines solchen Formblattes. Wahrscheinlich wuerde "
        "es Dir auch Spass machen, das Formblatt zu zerreissen; das "
        "Formblatt wuerde davon allerdings eher nicht begeistert "
        "sein.");
    set_read ("Oben auf dem Formblatt steht eine grosse Ueberschrift: "
        "\"Einziges behoerdlich zugelassenes Formblatt fuer einen "
        "Tipvorschlag\". So in der Art hast Du es "
        "Dir auch vorgestellt. Unter dieser Ueberschrift steht \"Bitte "
        "hier den Vorschlag fuer den neuen Tip in leserlicher "
        "Handschrift eintragen:\", als ob Du jemals in Deinem Leben "
        "eine unleserliche Handschrift gehabt haettest... Frechheit. "
        "Danach sind dann einige Zeilen frei, die den Text fuer einen "
        "Tip aufnehmen und festhalten sollen. Darunter steht dann: "
        "\"Dieser Tip ist geeignet fuer:\", daneben sind vier Kaestchen zum "
        "Ankreuzen mit den Texten \"Anfaenger\", \"normale Spieler\", "
        "\"Engel\" und \"Goetter\" angebracht. Natuerlich sind alle "
        "gleich gross. Na dann viel Spass beim Ausfuellen.");
    set_smell ("Papiergeruch, kein Zweifel.");
    set_noise ("Du hoerst, wie sich das Formblatt darauf freut, von "
        "Dir ausgefuellt zu werden.");
    set_feel ("Fuehlt sich aalglatt an. Wie es sich fuer Formblaetter "
        "gehoert.");
}

void init ()
{
    add_action ("fuelle","fuelle",-5);
    add_action ("zerreisse","zerreisse",-8);
}


nosave int fuelle (string s)
{
    notify_fail ("fuelle was? Vielleicht das Formblatt aus?\n");
    if (me (s) != "aus") return 0;
    this_player()->send_message (
        MT_LOOK, MA_USE,
        wrap (Der(this_player())+" beginnt, "+den()+" auszufuellen."),
        wrap ("Du beginnst, "+den()+" auszufuellen. "
            +(random(10)==3 ? Der()+" freut sich sichtlich darueber. Ach "
                "Quatsch, das bildest Du Dir sicher nur ein.":"")),
        this_player());
    new_tip ();
    return 1;
}

nosave int zerreisse (string s)
{
    if (!me (s)) {
        notify_fail (("Was willst Du zerreissen? Vielleicht "+den()+"?"));
        return 0;
    }
    send_message (MT_LOOK, MA_USE,
        wrap (Der(this_player())+" zerreisst mit sichtlichem Genuss "
           +den()+" in lauter kleine Fetzen, die sofort vom Wind "
           "davongetragen werden. Welcher Wind? Naja, der Wind halt, "
           "der kleine Fetzen von zerrissenen Formblaettern sofort "
           "davontraegt."),
        wrap ("Du zerreisst mit sichtlichem Genuss "
           +den()+" in lauter kleine Fetzen, die sofort vom Wind "
           "davongetragen werden. Welcher Wind? Naja, der Wind halt, "
           "der kleine Fetzen von zerrissenen Formblaettern sofort "
           "davontraegt."),
        this_player());
    remove ();
    return 1;
}

void new_tip_done ()
{
    object leo;
    leo = present ("leo",environment(this_player()));
    this_player()->send_message (
        MT_LOOK, MA_USE,
        wrap (Der(this_player())+" hat "+den()+" fertig "
            "ausgefuellt."),
        "",
        this_player());
    if (leo) {
        this_player()->send_message (
            MT_LOOK, MA_MOVE,
            wrap (Der(this_player())+" gibt "+den()+" an "
                +den (leo)+"."),
            wrap ("Du gibst "+den()+" an "+den(leo)+"."),
            this_player());
        leo->do_command ("sage Dankeschoen fuer den neuen Tipvorschlag.");
        leo->send_message (
            MT_LOOK, MA_MOVE,
            wrap ("Leo macht eine merkwuerdige Geste mit den Fingern, und "
               +der()+" ist verschwunden. Hoffentlich kommt "
               +er()+" auch da an, wo "+er()+" ankommen soll."));
    } else
        send_message (MT_LOOK, MA_MOVE,
            wrap (Der()+" leuchtet kurz auf und ist dann verschwunden."),
            wrap (Dein()+" leuchtet kurz auf und ist dann verschwunden."),
            this_player());
    remove ();
}
        
