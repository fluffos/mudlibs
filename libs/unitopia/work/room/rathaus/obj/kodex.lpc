//
// Revision 1.2  2001/04/07 00:15:53  gnomi
// Header oder CVS-Log eingebaut.
//

inherit "/i/object/buch";

#include <level.h>
#define PATH "/nosave/goetter/kodex"

void create() {
    ::create();
    set_page_names(({PATH+"/kodex*", PATH+"/anhang"}));
    set_page_mode("more");
    set_verzeichnis(PATH+"/inhalt");
    add_id (({"kodex","goetterkodex","goetter-kodex",
        "verhaltenskodex","verhaltens-kodex"}));
    set_name("Goetterkodex");
    set_gender("maennlich");
    set_weight(1);
    set_value(30);
    set_no_store(1);
    set_short ("Der Goetterkodex");
    set_long("Ein dickes handgeschriebenes Buch.\n"+
"Das in weisses Leder gebundene Buch traegt auf der Vorderseite ein\n" +
"goldenes Ausrufezeichen mit einem grossen Punkt.\n"
"Mitglieder des Obersten Rates hauen es gerne Goettern um die Ohren,\n"
"die sich nicht an den Kodex halten.\n");
    set_hlp_book (1);
    // Engel muessen das lesen koennen, schliesslich unterschreiben
    // sie beim Gott werden, dass sie sich an den Kodex halten werden.
}
