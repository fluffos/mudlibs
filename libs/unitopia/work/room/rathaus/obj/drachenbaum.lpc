inherit "/i/item";
inherit "/i/move";

void create() {
    set_name("drachenbaum");
    set_gender("maennlich");
    set_id(({"baum","drachenbaum","pflanze","baeumchen","drachenbaeumchen"}));
    set_smell("Diese Pflanze scheint ausser Erde, in der sie waechst, "
              "absolut nichts an wahrnehmbaren Geruechen von sich zu geben.");
    set_noise("Sie ist so lange still, bis Du ihre Blaetter in Bewegung "
              "versetzt, woraufhin sie eine Weile sanft raschelt.");
    set_feel("Vorsichtig faehrst Du durch die abstehenden Blaetter, die "
             "sanft ueber Dich hinwegstreichen.");
    set_long("Dein erster Eindruck ist: Buschige Mini-Palme. Das Baeumchen "
             "ist keinen Meter gross und hat einen Stamm, der eine gute "
             "Handbreit ueber der Erde in fuenf Staemme uebergeht, an deren "
             "oberen Enden viele lange, duenne Blaetter ringsum abstehen. "
             "Es handelt sich also um einen gluecklichen Drachenbaum, denn "
             "andernfalls wuerden die Blatter nicht so abstehen, sondern dicht "
             "am Stamm herunterhaengen.");
    set_adjektiv(({"gluecklich"}));
    set_material("pflanzlich");
    add_v_item(([
	 "name" : "stamm",
       "gender" : "maennlich",
	 "long" : "Der Stamm sieht ein wenig so aus, als waere er aus flachen "
                  "Baendern geflochten, was durch die ehemaligen "
                  "Blattansaetze kommt. Er ist zwar etwas holzig und "
                  "beige-braun, wirkt aber so, als haette er sich noch nicht "
                  "weit vom Dasein als junges gruenes Pflanzenteil entfernt. "
                  "Dazu passt auch, dass er, bevor er sich aufteilt, gerade mal "
                  "gut einen Daumen dick ist und das, was danach kommt, jeweils "
                  "nicht mal mehr die Dicke eines kleinen Fingers erreicht.",
	 "feel" : "Fuehlt sich schuppig an. Man fuehlt deutlich die "
                  "versetzten Kanten, an denen vor mehr oder weniger langer "
                  "Zeit noch Blaetter angewachsen waren. Wenn man von unten "
                  "nach oben darueberfaehrt, merkt man noch, dass sich "
                  "zwischen den Kanten eine glatte Oberflaeche befindet, in die "
                  "Gegenrichtung ueberwiegt eindeutig der Widerhaken-Effekt.",
	"smell" : "Der Stamm scheint keinerlei Geruch abzugeben.",
	   "id" : ({"stamm"}),
                ]));
    add_v_item(([
	 "name" : "blaetter",
       "gender" : "saechlich",
       "plural" : 1,
	 "long" : "Die ausgewachsenen Blaetter sind eine Elle lang und "
                  "hoechstens so breit wie ein kleiner Finger, also sehr "
                  "lang und schmal. Sie sind dunkelgruen und haben einen "
                  "weinroten Rand. Sie sind direkt am Stamm angewachsen, den "
                  "sie an ihrem Ende versetzt jeweils eine gute halbe "
                  "Umdrehung einwickeln.",
     "adjektiv" : "laenglich",
	 "feel" : "Die Oberseite fuehlt sich wachsartig glatt an, wogegen die "
                  "Unterseite eher samtig glatt ist, wodurch man leichter und "
                  "ungebremster darueberfahren kann.",
	"smell" : "Die Blaetter scheinen keinerlei Geruch abzugeben.",
	"noise" : "Ihks! Du hast mit einem der spitzen Blattenden Dein Ohr "
                  "getroffen! Du versuchst es nochmals mit mehr "
                  "Sicherheitsabstand und bemerkst, dass die Blaetter "
                  "gemeinsam ein beruhigendes Rascheln erzeugen, solange sie "
                  "in Bewegung sind.",
     "hear_msg" : "$Der(OBJ_TP) halt $seinen(([name:ohr,gender:saechlich]),"
                  "ein,OBJ_TP) dicht an die Blaetter des Drachenbaumes - und "
                  "schreckt zurueck, als ein Blatt das Ohr mit der Spitze "
                  "trifft. Manchmal scheint Lauschen ein echtes Abenteuer zu "
                  "sein!",
	   "id" : ({"blatt","blaetter"}),
                ]));
    add_v_item(([
	 "name" : "zweige",
       "gender" : "maennlich",
       "plural" : 1,
	 "long" : "Eigentlich hat ein Drachenbaum keine Zweige, sondern nur "
                  "einen Stamm. Allerdings koennen aus solch einem Stamm "
                  "mehrere neue Staemme spriessen, wenn er abbricht. Und "
                  "genau das wurde hier eine Handbreit ueber der Erde "
                  "fachmaennisch provoziert. Daher sieht es so aus, als "
                  "haette der Baum fuenf Zweige.",
	 "feel" : "Fuehlt sich schuppig an. Man fuehlt deutlich die "
                  "versetzten Kanten, an denen vor mehr oder weniger langer "
                  "Zeit noch Blaetter angewachsen waren. Wenn man von unten "
                  "nach oben darueberfaehrt, merkt man noch, dass sich "
                  "zwischen den Kanten eine glatte Oberflaeche befindet, in die "
                  "Gegenrichtung ueberwiegt eindeutig der Widerhaken-Effekt.",
	"smell" : "Die Zweige scheinen keinerlei Geruch abzugeben.",
	   "id" : ({"zweige","zweig","aeste","ast"}),
                ]));
    add_v_item(([
	 "name" : "wurzeln",
       "gender" : "weiblich",
       "plural" : 1,
	 "long" : "Du kannst nur den Wurzelansatz sehen, wo der eine Stamm "
                  "in ein Bueschel runder, relativ glatter, holziger Wurzeln "
                  "uebergeht.",
         "feel" : "Fuehlt sich fast so an, als habe sich beim Giessen dort "
                  "Kalk abgelagert.",
        "smell" : "Du riechst deutlich die Erde, aber nichts von der Wurzel.",
	   "id" : ({"wurzel","wurzeln","wurzelansatz"}),
                ]));
    add_v_item(([
	 "name" : "erde",
       "gender" : "weiblich",
	 "long" : "Ganz normale Erde, in der dieses Baeumchen zuhause ist.",
         "feel" : "Fuehlt sich etwas feucht an.",
        "smell" : "Riecht kraeftig erdig und feucht.",
        "noise" : "Du meinst noch immer etwas Wasser darin versickern zu "
                  "hoeren.",
	   "id" : ({"erde"}),
                ]));
}
