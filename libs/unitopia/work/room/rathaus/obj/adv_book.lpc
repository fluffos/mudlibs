#include <move.h>

inherit "/i/object/buch";

int installed;

varargs int move(mixed dest, int way, string out, string in)
{
   if(installed)
   {
      write("Das Buch ist angekettet! - ");
      return MOVE_NOT_ALLOWED;
   }
   installed = 1;
   return ::move(dest,way,out,in);
}
