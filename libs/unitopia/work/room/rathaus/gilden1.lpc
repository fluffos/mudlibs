mapping exits;
mapping extras;

void create() {
  exits = ([
    "osten": "/room/rathaus/foyer",
    "east": "/room/rathaus/foyer",
    "o": "/room/rathaus/foyer",
    "e": "/room/rathaus/foyer",
    "westen": "/room/rathaus/gilden2",
    "west": "/room/rathaus/gilden2",
    "w": "/room/rathaus/gilden2",
  ]);
  extras = ([
    "tuer":
    "Ein Zettel haengt an der geschlossenen Tuer:\n\n"
    "             Kommt uns doch in unserem Gilden-Haus besuchen.\n"
    "          Es befindet sich im Westen des Kartukultininurta-Platzes.\n",
    "tuere":
    "Ein Zettel haengt an der geschlossenen Tuer:\n\n"
    "             Kommt uns doch in unserem Gilden-Haus besuchen.\n"
    "          Es befindet sich im Westen des Kartukultininurta-Platzes.\n",
  ]);
}

string query_short() { return "Gang der Gilden"; }

string query_long() {
  return "In den Raeumen links und rechts von diesem Gang praesentieren sich "
    "saemtliche, ueber Magyra verteilte Gilden. Noerdlich von hier befindet "
    "sich der Raum der Abenteurergilde, aber die Tuere ist seltsamerweise "
    "verschlossen. Und suedlich ist der Raum der Druidengilde.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt zwei sichtbare Ausgaenge: osten und westen.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
