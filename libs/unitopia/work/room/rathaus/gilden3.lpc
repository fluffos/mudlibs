mapping exits;
mapping extras;

void create() {
  exits = ([
    "osten": "/room/rathaus/gilden2",
    "east": "/room/rathaus/gilden2",
    "o": "/room/rathaus/gilden2",
    "e": "/room/rathaus/gilden2",
    "westen": "/room/rathaus/gilden4",
    "west": "/room/rathaus/gilden4",
    "w": "/room/rathaus/gilden4",
  ]);
  extras = ([
    "absperrbaender":
    "Die Absperrbaender sind schwarz-gelb gestreift und tragen die "
    "Aufschrift: POLIZEILICHE ABSPERRUNG - BETRETEN VERBOTEN.\n",
    "siegel":
    "Ein wachsgelbes Siegel der Tadmorer Stadtwache klebt an der Tuer.\n",
  ]);
}

string query_short() { return "Gang der Gilden"; }

string query_long() {
  return "In den Raeumen links und rechts von diesem Gang praesentieren sich "
    "saemtliche, ueber Magyra verteilte Gilden. Noerdlich von hier befindet "
    "sich die Tuer zum Raum der Diebesgilde. Im Sueden riecht es dagegen "
    "deutlich nach Chemikalien.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Es gibt zwei sichtbare Ausgaenge: osten und westen.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
