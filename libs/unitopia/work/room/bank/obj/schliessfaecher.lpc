private mapping *vitems_inhalt,*vitems_faecher;
private string *liste_faecher;
private int init_vitems = 0;

public nomask int is_bank_safes()
{
    return 1;
}

int query_no_move()
{
    return 1;
}

string query_no_move_reason()
{
    return wrap("Die Schliessfaecher lassen sich nicht bewegen.");
}

int forbidden_shadow(object shadow, object victim)
{
    return victim == TO;
}

int remove()
{
    if (!TO) return 1;
    destruct(TO);
    return 1;
}

void notify_remove(object ob)
{
    if (ob == fach)
    {
        init_vitems = 0; // Anzeige aktualisieren!
    }
}

private <string|object> inhalt_laden(object tp, string ob_file, mixed ob_data, 
        mapping* sh_data, mixed mud_data, string factory,string factory_id, 
        mapping m_origin)
{
    string sh_file,str,new_file;
    object sh,ob;
    mapping shd;
    mixed dataline;
    int ret;
    if (stringp(factory) && factory != "")
    {
        ob = factory->get_conservation_object(factory_id, ob_data);
        if (ob == 0) 
            raise_error(wrap(sprintf("Factory %s liefert kein Objekt auf %s",
                factory,factory_id||"")));
    }
    else
    {
        new_file = ZENTRALBANK->replace_bank_safe_file(ob_file,ZB_BANK_ACTIVE);
        if (new_file && new_file != "") ob_file = new_file;
        ob = clone_object(ob_file);// Fehler ueber catch abgefangen
        ob->init_conservation_arg(ob_data);
    }
    if (pointerp(mud_data) && sizeof(mud_data))
    {
        foreach(dataline : mud_data)
        {
            apply(#'call_other,ob,dataline[0],dataline[1]);
        }
    }
    foreach (shd : sh_data||({}) )
    {
        if (!sizeof(shd)) continue;
        sh_file = m_indices(shd)[0];
        if (shd[sh_file]==0) continue; // spaet aber besser als nie...
        new_file = ZENTRALBANK->replace_bank_safe_file(sh_file,ZB_BANK_ACTIVE);
        if (!new_file || new_file == "") new_file = sh_file;
        sh = clone_object(new_file);
        sh->init_conservation_shadow_arg(shd[sh_file]);
        if (sh && (ret=sh->init_shadow(ob))!=SHADOWING_OK)
        {
            ZB_DEBUGLOG(sprintf("shadows-reject-init=%Q,%Q,%Q",ob,sh,shd),
                DB_DBGLVL_ERROR,RNAME(tp),"schliessfaecher:auslagern");
            sh->remove();
            ob->remove();
            return "Ein schattenhafter Fehler verhinderte das Auslagern.";
        }
    }
    if (mappingp(m_origin)&&sizeof(m_origin))
    {
        ob->set(P_ORIGIN,m_origin);
    }
    return ob;
}

private string inhalt_auslagern(object tp,object con,mapping* content_data)
{
    mapping vi;
    <string|object> strobj;
    string str;
    int flag_close;
    if (!sizeof(content_data) || !con->query_container())
        return 0; // ok bzw ist kein Container mehr.
    flag_close = con->query_con_close();
    if (flag_close)
        con->open_con();
    foreach (vi: content_data)
    {
        strobj = inhalt_laden(tp, vi[ARMA_LOAD_FILE], 
            vi[ARMA_OBJECT_DATA], vi[ARMA_SHADOW_DATA], vi[ARMA_MUDLIB_DATA],
            vi[ARMA_FACTORY],vi[ARMA_FACTORY_ID],
            vi[ARMA_ORIGIN_INFO]);
        if (stringp(strobj))
            return strobj;
        if (objectp(strobj))
        {
            switch (strobj->move(con))
            {
                case MOVE_OK:
                    continue; // Alles ok im container.
                case MOVE_NO_ROOM:
                    str = Der(strobj)+" passt nicht in "+den(con)+".";
                    strobj->remove();
                    con->close_con();
                    con->remove();
                    return str;
                case MOVE_NOT_ALLOWED:
                case MOVE_DEST_CLOSED:
                case MOVE_ENV_CLOSED:
                case MOVE_NO_DEST:
                default:
                    str = "Fehler in "+dem(con)+": "+Der(strobj)+".";
                    strobj->remove();
                    con->close_con();
                    con->remove();
                    return str;
            }
        }
    }
    if (flag_close)
        con->close_con();
    return 0;
}

private <string|object> auslagern(object tp, string ob_file, mixed ob_data, 
        mapping* sh_data, mixed mud_data, string factory,string factory_id, 
        mapping m_origin,mapping* content_data)
{
    int ret;
    string str;

    object ob = inhalt_laden(tp,ob_file,ob_data,sh_data,mud_data,factory,
            factory_id,m_origin);
    if (objectp(ob))
    {
        inhalt_auslagern(tp,ob,content_data);
    }
    else
    {
        raise_error("Kein Objekt!\n");
    }
    fach = clone_object(ZB_SCHLIESSFACH);
    fach->init_fach(bank_id,tp,calc_rent,valuta,valutas,v_gender);
    fach->add_controller("notify_remove",TO);
    fach->open_con(); // sicher ist sicher.
    switch (ob->move(fach))
    {
        case MOVE_OK:
            break; // Alles ok im fach.
        case MOVE_NO_ROOM:
            str = Der(ob)+" passt nicht in "+den(fach)+".";
            ob->remove();
            fach->remove();
            return str;
        case MOVE_NOT_ALLOWED:
        case MOVE_DEST_CLOSED:
        case MOVE_ENV_CLOSED:
        case MOVE_NO_DEST:
        default:
            str = "Fehler in "+dem(fach)+": "+Der(ob);
            ob->remove();
            fach->remove();
            return str;
    }
    switch (fach->move(tp))
    {
        case MOVE_OK:
            return fach; // Alles ok im fach.
        case MOVE_NO_ROOM:
            str = "Du hast nicht genug Platz(?) fuer "+den(fach)+".";
            ob->remove();
            fach->close_con();
            fach->remove();
            return str;
        case MOVE_NOT_ALLOWED:
        case MOVE_DEST_CLOSED:
        case MOVE_ENV_CLOSED:
        case MOVE_NO_DEST:
        default:
            str = "Fehler bei "+dem(fach)+": "+Der(ob);
            ob->remove();
            fach->close_con();
            fach->remove();
            return str;
    }
}

// dynamische vitems
string vitem_take(mapping vi)
{
    if (HAS_ID(vi,"schliessfach"))
    {
        return wrap("Willst Du das Schliessfach aus der Wand reissen? "
            "Oeffne doch das Schliessfach Deiner Wahl.");
    }
    return wrap("Oeffne das Schliessfach, um an den Gegenstand zu kommen.");
}

private void initialize_vitems()
{
    if (!bank_id || !playerp(owner))
    {
        vitems_inhalt = vitems_faecher = ({});
        liste_faecher = ({});
        return;
    }
    vitems_inhalt = ZENTRALBANK->retrieve_bank_safe(bank_id,RNAME(owner))
                    ||({});
    liste_faecher = map(vitems_inhalt, function string (mapping m)
        {
            return m["short"];
        });
    vitems_faecher = map(vitems_inhalt, function mapping (mapping m)
        {
            return ([
       "environment" : TO,
       "origin"      : TO,
        "debug_info" : (m["debug_info"]||([])),
          "name"     : "schliessfach",
          "cap_name" : "Schliessfach",
          "gender"   : "saechlich",
          "id"       : ({"schliessfach","fach"}),
          "short"    : "Ein Schliessfach mit: "+m["short"],
          "long"     : m["long"],
          "seher_info": m["seher_info"],
          "look_msg" : "",
          "read_msg" : "",
          "take_msg" : "",
          "feel_msg" : "",
          "smell_msg": "",
          "hear_msg" : "",
          "take": #'vitem_take,
          ARMA_SPECIAL_ID: m[ARMA_SPECIAL_ID],
          ]);
        });
}

private int check_entry(mapping entry, string ids, string *adj)
{
    if (mappingp(entry) && HAS_ID(entry,ids)) {
        if (adj) {
            foreach(string str : adj) {
                if (member(entry["adjektiv"]||({}),str) == -1) {
                    return 0;
                }
            }
        }
        return 1;
    }
    return 0;
}

varargs mapping query_v_item(mixed *pfad, int flag)
{
    mapping ret, what, *visa;
    string id, *adj;
    int anzahl, nummer;

    if (objectp(fach))
    {
        visa = ({});
        init_vitems = 0;
    }
    else if (!init_vitems)
    {
        initialize_vitems();
        visa=(vitems_faecher||({}))+(vitems_inhalt||({}));
        init_vitems = 1;
    }
    else
    {
        visa=(vitems_faecher||({}))+(vitems_inhalt||({}));
    }
    if (init_vitems && !sizeof(visa))
    {
        visa += ({ ([ 
            "name" : "schliessfach",
            "id": ({ "schliessfach","fach"}),
            "gender": "saechlich",
            "adjektiv":({"leer"}),
            "long":"Ein leeres Schliessfach, du kannst es oeffnen.",
              "look_msg" : "",
              "read_msg" : "",
              "take_msg" : "",
              "feel_msg" : "",
              "smell_msg": "",
              "hear_msg" : "",
        ]) });
    }
    if(!(ret = ::query_v_item(pfad,flag)) &&
       sizeof(pfad)==1)
    {
        if(stringp(pfad[0]))
        {
            id = lower_case(pfad[0]);
        }
        else if(mappingp(pfad[0]))
        {
            id = lower_case(pfad[0]["name"]);
            adj = pfad[0]["adjektiv"];
            nummer=pfad[0]["nummer"];
        }
        visa=filter(visa,#'check_entry,id,adj);
        if(anzahl=sizeof(visa))
        {
            if(nummer > 1)
            {
                if(sizeof(visa)>=nummer)
                    what = visa[nummer-1];
                else
                    return 0;
            } else {
                what = visa[0];
            }
            ret = what + ([
              "environment"   : TO,
              "v_item_master" : TO,
              "take" : #'vitem_take,
                              ]);
        }
    }
    return ret;
}

mixed *query_all_v_items()
{
    mapping *visa;
    if (objectp(fach))
    {
        visa = ({});
        init_vitems = 0;
    }
    else if (!init_vitems)
    {
        initialize_vitems();
        visa=(vitems_faecher||({}))+(vitems_inhalt||({}));
        init_vitems = 1;
    }
    else
    {
        visa=(vitems_faecher||({}))+(vitems_inhalt||({}));
    }
    if (init_vitems && !sizeof(visa))
    {
        visa += ({ ([ 
            "name" : "schliessfach",
            "id": ({ "schliessfach","fach"}),
            "gender": "saechlich",
            "adjektiv":({"leer"}),
            "long":"Ein leeres Schliessfach, du kannst es oeffnen.",
              "look_msg" : "",
              "read_msg" : "",
              "take_msg" : "",
              "feel_msg" : "",
              "smell_msg": "",
              "hear_msg" : "",
        ]) });
    }
    return (::query_all_v_items()||({}))
            +map(visa,
                 function(mapping entry)
                 {
                     return entry + ([
                 "environment"   : TO,
                 "v_item_master" : TO,
                 "take" : #'vitem_take,
                                 ]);
                     });
}

int my_notify_move(string cntr, object wer, object woher, object wohin, 
            string dir, int wie, string verlassen, string ankommen)
{
    if (owner == wer && env != wohin)
    {
        remove();
    }
}

private string get_value_in_current_valuta(int amount)
{
    return ZENTRALBANK->get_value_in_current_valuta(to_float(amount),
        valuta,valutas,v_gender);
}

int bezahlen_cmd(string str)
{
    string *split = explode(lower_case(space(str))," ");
    int result,ix;
    if (!check_security() || TP!=ENV_TO)
    {
        FAILWP("Kein Zugriff auf die Bezahlung der Miete.",FAIL_INTERNAL);
    }
    if (sizeof(split)<3 || strstr(split[0],"miet")==-1 || split[1]!="fuer")
    {
        FAILWP("bezahle Miete fuer (x.Schliessfach|diese Bank|alle Banken)?",
            FAIL_NOT_OBJ);
    }
    query_all_v_items(); // initialisieren...
    if (sizeof(split)>3 && split[3]=="banken" && split[2] == "alle")
    {
        result = ZENTRALBANK->update_rent_for_safes(TP);
    }
    else if (sizeof(split)>3 && split[3]=="bank" && split[2] == "diese")
    {
        result = ZENTRALBANK->update_rent_for_safes(TP,bank_id);
    }
    else if ((sscanf(split[2],"%d.schliessfach",ix)==1 )
        || (sscanf(split[2],"%d.fach",ix)==1 )
        || ((sizeof(split)>3) 
            && sscanf(split[2]||split[3],"%d.schliessfach",ix)==1 )
        || ((sizeof(split)>3) 
            && sscanf(split[2]||split[3],"%d.fach",ix)==1 ))
    {
        if (ix < 1 || ix > sizeof(vitems_inhalt))
        {
            FAILWP("Ungueltiges Schliessfach.",FAIL_INTERNAL);
        }
        result = ZENTRALBANK->update_rent_for_safes(TP,bank_id,
            vitems_inhalt[ix-1][ARMA_SPECIAL_ID]);
    }
    else
    {
        FAILPW("bezahle Miete fuer (x.Schliessfach|diese Bank|alle Banken)?",
            FAIL_NOT_OBJ);
    }
    if (result > 0) 
    {
        send_message_to(TP,MT_NOTIFY,MA_UNKNOWN,wrap(
            "Es wurde insgesamt "
            +get_value_in_current_valuta(result)+" verrechnet."));
        return 1;
    }
    else if (result < 0)
    {
        send_message_to(TP,MT_NOTIFY,MA_UNKNOWN,wrap(
            "Dein Konto hatte fuer "
            +get_value_in_current_valuta(-result)+" nicht genug."));
        return 1;
    }
    else
    {
        FAILWP("Interner Fehler beim Verrechnen der Miete.",FAIL_INTERNAL);
    }
}

int oeffnen_cmd(string str)
{
    string match,err;
    <string|object> strobj;
    int ix,deltakonto,max_faecher;
    if (!check_security() || TP!=ENV_TO)
    {
        FAILWP("Du darfst die Schliessfaecher nicht oeffnen.",FAIL_INTERNAL);
    }
    if (objectp(fach))
    {
        init_vitems = 0;
        FAILWP("Zur selben Zeit kann immer nur ein Fach geoeffnet sein. "
            "Z.B. muss fuer ein weiteres leeres Fach dieses eine erstmal "
            "nach dem Fuellen geschlossen werden.",FAIL_INTERNAL);
    }
    else if (!init_vitems)
    {
        initialize_vitems();
        init_vitems = 1;
    }
    if (this_player()->free_hand() < 0)
        return notify_fail(wrap("Du hast keine Hand frei, um "
            "ein Schliessfach zu oeffnen."), FAIL_INTERNAL);
    str = lower_case(space(str));
    if (strstr(str,"fach")==-1)
    {
        FAILWP("oeffne x. schliessfach|oeffne leeres schliesfach?",
            FAIL_NOT_OBJ);
    }
    if (strstr(str,"leer")!=-1 || strstr(str,"neu")!=-1 || 
        sizeof(vitems_inhalt)==0)
    {
        max_faecher = apply(calc_max_count,this_player());
        if (sizeof(vitems_inhalt) >= max_faecher)
        {
            FAILWP("Mehr als "+max_faecher+" Schliessfaecher darfst du "
                "zur Zeit in dieser Bank nicht haben.",FAIL_INTERNAL);
        }
        deltakonto = ZENTRALBANK->update_rent_for_safes(TP,bank_id);
        if (deltakonto > 0)
        {
            send_message_to(TP, MT_NOTIFY, MA_UNKNOWN, wrap(
                "Es wurden ca. "
                +get_value_in_current_valuta(deltakonto)+" fuer die Miete "
                "aller Schliessfaecher dieser Bank bezahlt."));
        }
        err = ZENTRALBANK->check_bank_safe_locks(bank_id,TP);
        if (stringp(err))
        {
            FAILWP("Du erhaeltst kein weiteres leeres Fach. Grund:\n"+err,
                FAIL_INTERNAL);
        }
        fach = clone_object(ZB_SCHLIESSFACH);
        fach->init_fach(bank_id,TP,calc_rent,valuta,valutas,v_gender);
        fach->add_controller("notify_remove",TO);
        switch (fach->move(TP))
        {
            case MOVE_OK:
                send_message_to(TP, MT_NOTIFY,MA_UNKNOWN,wrap(
                    "Du oeffnest ein leeres Schliessfach."));
                return 1; 
            case MOVE_NO_ROOM:
                str = "Du hast nicht genug Platz(?) fuer "+den(fach)+".";
                fach->remove();
                FAILWP(str,FAIL_INTERNAL);
            case MOVE_NOT_ALLOWED:
            case MOVE_DEST_CLOSED:
            case MOVE_ENV_CLOSED:
            case MOVE_NO_DEST:
            default:
                str = "Fehler bei "+dem(fach)+".";
                fach->remove();
                FAILWP(str,FAIL_INTERNAL);
        }
    }
    match = regmatch(str,"[0-9]+");
    if (str2int(match||"1",&ix) || ix <= 0)
    {
        FAILWP("oeffne x. schliessfach?|oeffne leeres schliesfach?",
            FAIL_INTERNAL);
    }
    if (ix > sizeof(vitems_inhalt))
    {
        FAILWP("So viele Schliessfaecher besitzt Du nicht.", FAIL_INTERNAL);
    }
    mapping vi = vitems_inhalt[ix-1];
    deltakonto = ZENTRALBANK->update_rent_for_safes(
        TP,bank_id,vi[ARMA_SPECIAL_ID]);
    if (deltakonto > 0)
    {
        send_message_to(TP, MT_NOTIFY, MA_UNKNOWN, wrap(
            "Es wurden ca. "
                +get_value_in_current_valuta(deltakonto)+" fuer die Miete "
            "des "+ix+". Schliessfaches dieser Bank bezahlt."));
    }
    if (ZENTRALBANK->check_bank_safe_lock(vi[ARMA_SPECIAL_ID]))
    {
        FAILWP("Das Schliessfach ist gesperrt, nutze 'bezahle miete', "
            "um das Fach oder alle Faecher zu entsperren.", FAIL_INTERNAL);
    }
    if (err=catch(strobj=auslagern(TP, vi[ARMA_LOAD_FILE], 
            vi[ARMA_OBJECT_DATA], vi[ARMA_SHADOW_DATA], vi[ARMA_MUDLIB_DATA],
            vi[ARMA_FACTORY],vi[ARMA_FACTORY_ID],
            vi[ARMA_ORIGIN_INFO],vi[ARMA_CONTENT_DATA]); publish))
    {
        ZB_DEBUGLOG(sprintf("oeffnen-fail-1=%Q %Q",
            err,vi[ARMA_SPECIAL_ID]),
            DB_DBGLVL_ERROR,RNAME(TP),"schliessfaecher:oeffnen_cmd");
        ZENTRALBANK->report_error_bank_safe(
                vi[ARMA_SPECIAL_ID],RNAME(TP),0);
        FAILWP("Aufgrund eines Lochs im RaumZeitGefuege konnte "
            +ein(vi)+" nicht ausgelagert werden.",FAIL_INTERNAL);
    }
    if (stringp(strobj))
    {
        ZB_DEBUGLOG(sprintf("oeffnen-fail-2=%Q %Q",
            strobj,vi[ARMA_SPECIAL_ID]),
            DB_DBGLVL_WARNING,RNAME(TP),"schliessfaecher:oeffnen_cmd");
        FAILWP(strobj+" "+Der(vi)+" verbleibt in "+dem(TO)+".",FAIL_INTERNAL);
    }
    ZENTRALBANK->leave_bank_safes(vi[ARMA_SPECIAL_ID],RNAME(owner),
        vi[ARMA_FILE_COUNTER]); // TODO auf 1 pruefen!!!
    ZB_DEBUGLOG(sprintf("oeffnen-success=%Q %Q",
            strobj,vi[ARMA_SPECIAL_ID]),
            DB_DBGLVL_INFO,RNAME(owner),"schliessfaecher:oeffnen_cmd");
    send_message_to(TP,  MT_NOTIFY,MA_UNKNOWN,wrap(
                    "Du oeffnest dein Schliessfach."));
    return 1;
}

// Aufruf vom Inherit schliessfachaddon.c
void init_faecher(string bid,object own,string val,string vals,string vgen,
    closure crent,closure cmaxcount)
{
    if (own && !owner) owner = own;
    bank_id = bid;
    valuta = val;
    valutas = vals;
    v_gender = vgen;
    calc_max_count = cmaxcount;
    calc_rent = crent;
    ZENTRALBANK->update_bank_information(bid,val,vals,vgen);
}
    
void init()
{
    "*"::init();
    if (TP && TP == ENV_TO && ENV(TP))
    {
        if (owner)
        {
            if (owner != TP)
            {
                call_out("remove",0);
                return;
            }
        }
        else
        {
            owner = TP;
        }
        env = ENV(TP);
        TP->add_controller("notify_move",#'my_notify_move);
        add_action("oeffnen_cmd","oeffne");
        add_action("oeffnen_cmd","eroeffne");
        add_action("bezahlen_cmd","bezahle",-6);
        add_action("bezahlen_cmd","zahle",-4);
        return;
    }
}

string query_long(object viewer)
{
    string str,text;
    int max_count = apply(calc_max_count,owner);
    if (objectp(fach))
    {
        init_vitems = 0;
        if (viewer != owner)
            return wrap("Es ist ein Schlieessfach fuer "+den(owner)+
                " gerade offen, die anderen Schliessfaecher sind "
                "nicht zu sehen.");
        return wrap("Ein Schliessfach ist offen, man kann es betrachten. "
            "Solange ein Fach offen ist, kann man die anderen Faecher "
            "nicht sehen. Daneben haengt eine Tafel mit einer Anleitung.");
    }
    else if (!init_vitems)
    {
        initialize_vitems();
        init_vitems = 1;
    }
    if (!sizeof(liste_faecher))
    {
        if (viewer != owner)
            return wrap("Es sind keine Schliessfaecher fuer "+den(owner)+
                " eroeffnet.");
        return wrap("Es sind keine der "+max_count+" Schliessfaecher "
            "fuer Dich eroeffnet. "
            "Mit 'oeffne leeres schliessfach' kannst Du das Einlagern "
            "beginnen. Daneben haengt eine Tafel mit einer Anleitung.");
    }
    if (viewer != owner)
        text = Des(owner)+" Schliessfaecher mit Inhalt sind zu sehen:\n";
    else
        text = "Die Tafel mit einer Anleitung haengt neben den "
            "Schliessfaechern. Folgende deiner bis zu "+max_count
            +" Schliessfaecher mit armageddon-sicherem Inhalt sind zu sehen:\n";
    int i = 0;
    foreach (str : liste_faecher)
    {
        text += wrap_say(sprintf("%2d: ",++i),str);
    }
    return text;
}

string query_anleitung_read(string parse_rest, string str, 
        mapping was, object leser)
{
    leser->more(ZB_ANLEITUNG_SF,0,0,M_AUTO_END);
    return "";
}

void create() 
{
    "*"::create();
    set_id( ({"schliessfaecher","faecher",ZB_SCHLIESSFAECHER_ID}) );
    set_name("schliessfaecher");
    set_gender("saechlich");
    set_plural(1);
    set_long("Eine Reihe von Schliessfaechern, daneben haengt eine Tafel "
        "mit einer Anleitung.");
    set_invis(V_NOLIST);
    set_weight(0);
    set(P_LOOK_MSG,"");
    set(P_READ_MSG,"");
    set(P_SMELL_MSG,"");
    set(P_HEAR_MSG,"");
    set(P_FEEL_MSG,"");
    set(P_TAKE_MSG,"");
    
    add_v_item( ([
        "name" : "anleitung",
        "id" : ({ "anleitung","tafel" }),
        "gender": "weiblich",
        "long" : "Die Tafel mit der Anleitung kann man lesen.",
        "read" : #'query_anleitung_read,
          "look_msg" : "",
          "read_msg" : "",
          "take_msg" : "",
          "feel_msg" : "",
          "smell_msg": "",
          "hear_msg" : "",
    ]) );
    add_controller("forbidden_shadow",TO);
    init_security_for_actions();
}

