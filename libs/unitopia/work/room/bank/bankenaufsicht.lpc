int cmd_menue(string str)
{
    if (!check_security())
    {
        FAILWP("Zugriffsproblem.", FAIL_INTERNAL);
    }
    dynamic_browse( ([ B_TYPE: "search_mask" ]) );
    return 1;
}

void init()
{
    "*"::init();
    add_action("cmd_menue","menue",-4);
}

void create()
{
  "*"::create();

  set_own_light(1);
  add_type("kunstlicht",1);
  add_type("nocleanup",1);
  set_room_domain("Pantheon");
  set_short("Nirgends");
  set_long("Dies ist die Bankenaufsicht. Befehl: menue");
        
    init_security_for_actions();
    
  add_exit("test_schliessfaecher","runter",0,"Testbank");

}

