nosave mixed bank_safe_files_init(mapping old)
{
    old[B_START_LINE] = 0;
    return old;
}

nosave int bank_safe_files_total(mapping menue)
{
    return ZENTRALBANK->retrieve_bank_safe_files(menue,1);
}

nosave string * bank_safe_files_display(mapping menue)
{
    string * lines = ZENTRALBANK->retrieve_bank_safe_files(
        menue+([
            DB_DBG_LIMIT:menue[B_NUM_LINES],
            DB_DBG_OFFSET:menue[B_CURRENT_LINE]
            ]),0);
    if (lines == 0 || !pointerp(lines))
        return ({ "Keine Anzeige." });
    for (int i = 0;i<sizeof(lines);i++)
    {
        lines[i] = sprintf("%3d %s",i+1+menue[B_CURRENT_LINE],lines[i]);
    }
    return lines;
}

nosave string bank_safe_files_prompt(mapping menue)
{
    string title = "Unbekannt";
    switch (menue[ZB_BANK_OUTPUT])
    {
        case ZB_BANK_FILE:   title = "Ausgelagerte Dateien";break;
        case ZB_BANK_ITEMID: title = "Ausgelagerte Gegenstaende";break;
        case ZB_BANK_ID:     title = "Banken mit ausgelagerten Dateien";break;
        case ZB_BANK_OWNER:  
            title = "Eigentuemer mit ausgelagerten Dateien";break;
    }
    return sprintf("%s (%d/%d) [<nr>,z,q]",
        title,menue[B_CURRENT_LINE], bank_safe_files_total(menue));
}

nosave mixed bank_safe_files_action(string str, mapping * menues)
{
    mapping menue = menues[<1];
    string mtype;
    mixed lines;
    int i;
    if (!str2int(space(str),&i) && i>0 && i <= bank_safe_files_total(menue))
    {
        lines = ZENTRALBANK->retrieve_bank_safe_files(
            menue+([ ZB_BANK_OUTPUT:0, DB_DBG_LIMIT:1, DB_DBG_OFFSET:i-1, ]),0);
        if (sizeof(lines))
        {
            switch (menue[ZB_BANK_OUTPUT])
            {
                case ZB_BANK_FILE:   
                    return menues + ({ menue + ([
                        B_TYPE: "bank_safe_files",
                        ZB_BANK_OUTPUT: ZB_BANK_ITEMID,
                        ZB_BANK_SORTBY: ZB_BANK_ITEMID,
                        ZB_BANK_FILE: lines[0][0]
                    ]) });
                case ZB_BANK_ITEMID: 
                    return menues + ({ ([
                        B_TYPE: "bank_safe_item",
                        ZB_BANK_ITEMID: lines[0][1],
                    ]) });
                case ZB_BANK_ID:
                    return menues + ({ menue + ([
                        B_TYPE: "bank_safe_files",
                        ZB_BANK_OUTPUT: ZB_BANK_ITEMID,
                        ZB_BANK_SORTBY: ZB_BANK_ITEMID,
                        ZB_BANK_ID: lines[0][2],
                    ]) });
                case ZB_BANK_OWNER:
                    return menues + ({ menue + ([
                        B_TYPE: "bank_safe_files",
                        ZB_BANK_OUTPUT: ZB_BANK_ITEMID,
                        ZB_BANK_SORTBY: ZB_BANK_ITEMID,
                        ZB_BANK_OWNER: lines[0][3],
                    ]) });
            }
       }
    }

    return B_NOTHING;
}

//-------------------------------------------------------------------------

private string * get_bank_safe_item(mapping menue)
{
    string *lines=({});
    mixed result = ZENTRALBANK->retrieve_bank_safe_files(
            ([ ZB_BANK_ITEMID:menue[ZB_BANK_ITEMID] ]),0);
    //bwf.file,bwf.itemid, bw.bank_id, bw.owner, bw.item, bw.error_count
    mapping vitem;
    if (!sizeof(result))
    {
        return ({ "Ungueltiger Gegenstand, Datenfehler!" });
    }
    vitem = restore_value(result[0][4]);
    lines += ({ "Itemid: "+result[0][1] + " Errors: "+result[0][5] });
    lines += ({ "Bank: "+result[0][2]+" Eigentuemer: "+result[0][3] });
    lines += ({ "Name: "+vitem["name"] });
    lines += explode(wrap("IDs: "+liste(vitem["id"],", ")),"\n");
    lines += explode(wrap("LONG:\n"+vitem["long"]),"\n");
    lines += ({ "Dateien:" });
    lines += map(result,(: $1[0] :));
    return lines;
}

nosave mixed bank_safe_item_init(mapping old)
{
    old[B_START_LINE] =0;
    return old;
}

nosave int bank_safe_item_total(mapping menue)
{
    return sizeof(get_bank_safe_item(menue));
}

nosave string * bank_safe_item_display(mapping menue)
{
    menue[B_DATA] = get_bank_safe_item(menue);
    return staticmore_display(menue);
}

nosave string bank_safe_item_prompt(mapping menue)
{
    return sprintf("Gegenstandsanzeige %d,%d [z,q]",menue[B_CURRENT_LINE],
        sizeof(get_bank_safe_item(menue)));
}

nosave mixed bank_safe_item_action(string str, mapping * menues)
{
    return B_NOTHING;
}

//-------------------------------------------------------------------------
nosave mixed bank_request_files_init(mapping old)
{
    old[B_START_LINE] =0;
    return old;
}

nosave int bank_request_files_total(mapping menue)
{
    return ZENTRALBANK->get_file_requests(menue,1);
}

nosave string * bank_request_files_display(mapping menue)
{
    string * lines = ZENTRALBANK->get_file_requests(
        menue+([
            DB_DBG_LIMIT:menue[B_NUM_LINES],
            DB_DBG_OFFSET:menue[B_CURRENT_LINE]
            ]),0);
    if (lines == 0 || !pointerp(lines))
        return ({ "Keine Anzeige." });
    for (int i = 0;i<sizeof(lines);i++)
    {
        lines[i] = left(sprintf("%3d %s",
                        i+1+menue[B_CURRENT_LINE],lines[i]),78);
    }
    return lines;
}

nosave string bank_request_files_prompt(mapping menue)
{
    return sprintf("Antraege nach Dateiname %d,%d [<nr>,f <nr>,z,q]",
        menue[B_CURRENT_LINE], bank_request_files_total(menue));
}

nosave mixed bank_request_files_action(string str, mapping * menues)
{
    mapping menue = menues[<1];
    string mtype,*split;
    mixed lines;
    int i;
    split = explode(space(str)," ");
    switch (lower_case(split[0]))
    {
        case "f":
            if (sizeof(split)==2)
            {
                if (!str2int(space(split[1]),&i) && i>0 
                    && i <= bank_request_files_total(menue))
                {
                    lines = ZENTRALBANK->get_file_requests(
                        menue+([ ZB_BANK_OUTPUT:0, 
                                 DB_DBG_LIMIT:1, 
                                 DB_DBG_OFFSET:i-1, ]),0);
                    if (!sizeof(lines))
                    {
                        browse_write_line("Fehler bei der Auswahl der Datei!");
                        return B_DONE;
                    }
                    lines = explode(lines[0]," ");
                    if (!sizeof(lines))
                    {
                        browse_write_line("Fehler bei der Auswahl der Datei.");
                        return B_DONE;
                    }
                    if (!adminp(TP))
                    {
                        browse_write_line("Keine Freigaberecht!");
                        return B_DONE;
                    }
                    if (sizeof(lines)>2)
                    {
                        if (!ZENTRALBANK->release_bank_safe_factory_file(
                            lines[0],lines[1],lines[2][1..<2]))
                        {
                            browse_write_line("Interner Fehler!");
                            return B_DONE;
                        }
                    }
                    else if (!ZENTRALBANK->release_bank_safe_file(lines[0]))
                    {
                        browse_write_line("Interner Fehler.");
                        return B_DONE;
                    }
                    browse_write_line("Freigabe erteilt, Antraege geloescht.");
                    return B_REBUILT;
                }
            }
            browse_write_line("f <nr>   fuer Freigabe der Datei.");
            return B_DONE;
        default:
            if (!str2int(space(str),&i) && i>0 
                    && i <= bank_request_files_total(menue))
            {
                lines = ZENTRALBANK->get_file_requests(
                    menue+([ ZB_BANK_OUTPUT:0, 
                             DB_DBG_LIMIT:1, 
                             DB_DBG_OFFSET:i-1, ]),0);
                if (!sizeof(lines))
                {
                    browse_write_line("Fehler bei der Auswahl der Datei!");
                    return B_DONE;
                }
                lines = explode(lines[0]," ");
                if (!sizeof(lines))
                {
                    browse_write_line("Fehler bei der Auswahl der Datei.");
                    return B_DONE;
                }
                return menues + ({([
                    B_TYPE : "bank_requests_per_file",
                    ZB_BANK_FILE : lines[0],
                    ])});
            }
    }
    return B_NOTHING;
}

