//-------------------------------------------------------------------------
nosave mixed main_menu_init(mapping old)
{
    old[B_START_LINE]=0;
    old[B_DATA] = ({
        "- 1- 'Meine' Daten filtern.",
        "- 2- Daten generell filtern."
        "- 3- 'Alle' Daten anzeigen.",
        
        "- 1- AdHoc-Suchmaske",
    });
    old[B_DATA] = ({
        "- 1- Alle Banken",
        "- 2- Meine Banken mit Schreibzugriff",
        "- 3- Alle ausgelagerten Dateien",
        "- 4- Alle auslagernden Banken",
        "- 5- Alle auslagernden Eigentuemer",
        "- 6- Alle ausgelagerten, fehlerbehafteten Dateien",
        "- 7- Alle ausgelagerten, fehlerbehafteten Dateien mit Schreibzugriff",
        "- 8- Alle Antraege",
    });
}

nosave int main_menu_total(mapping menue)
{
    return sizeof(menue[B_DATA]);
}

nosave string * main_menu_display(mapping menue)
{
    return staticmore_display(menue);
}

nosave string main_menu_prompt(mapping menue)
{
    return sprintf("Hauptmenu %d,%d [<nr>,q]",menue[B_CURRENT_LINE],
        sizeof(menue[B_DATA]));
}

nosave mixed main_menu_action(string str, mapping * menues)
{
    int i;
    mapping menue = menues[<1];
    if (!str2int(space(str),&i) && i>0 && i <= sizeof(menue[B_DATA]))
    {
        switch(i)
        {
            case 1:
                return menues + ({([ B_TYPE:"banks" ])});
            case 2:
                return menues + ({([ B_TYPE:"banks_with_access" ])});
            case 3:
                return menues + ({([ B_TYPE:"bank_safe_files",
                                ZB_BANK_OUTPUT: ZB_BANK_FILE,
                                ZB_BANK_SORTBY: ZB_BANK_FILE,
                ]) });
            case 4:
                return menues + ({([ B_TYPE:"bank_safe_files",
                                ZB_BANK_OUTPUT: ZB_BANK_ID,
                                ZB_BANK_SORTBY: ZB_BANK_ID,
                ]) });
            case 5:
                return menues + ({([ B_TYPE:"bank_safe_files",
                                ZB_BANK_OUTPUT: ZB_BANK_OWNER,
                                ZB_BANK_SORTBY: ZB_BANK_OWNER,
                ]) });
            case 6:
                return menues + ({([ B_TYPE:"bank_safe_files",
                                ZB_BANK_OUTPUT: ZB_BANK_FILE,
                                ZB_BANK_SORTBY: ZB_BANK_FILE,
                                ZB_BANK_WITH_ERROR: 1,
                ]) });
            case 7:
                return menues + ({([ B_TYPE:"bank_safe_files",
                                ZB_BANK_OUTPUT: ZB_BANK_FILE,
                                ZB_BANK_SORTBY: ZB_BANK_FILE,
                                ZB_BANK_WITH_ERROR: 1,
                                ZB_BANK_WIZARD: TP,
                ]) });
            case 8:
                return menues + ({([ B_TYPE:"bank_request_files" ])});
        }
    }
    return B_NOTHING;
}

