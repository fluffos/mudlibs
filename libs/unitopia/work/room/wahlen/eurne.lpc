inherit "/i/object/urne";

#include <level.h>

// dont clone me!

void create()
{
   ::create();
   set_long(
      "Eine Wahlurne. Hier kann ueber engelspezifische Themen "
      "abgestimmt werden.");
}

varargs nosave int may_vote(object who, string subject, mixed subject_data, string topic, mixed topic_data)
{
   return hlpp(who);
}

nosave mixed may_add_subject (object who, string subject)
{
   return hlpp(who) || adminp(who);
}
