void create()
{
    ::create();
    set_short("Terminabstimmung fuer das Staedtetournier");
    set_long(
        "Die Urne steht am Rand der grossen Treppe.\n"
        "Um Termine fuer die weiteren Runden beim Staedtetournier vorzuschlagen, "
        "kannst Du - sofern Du ein Teamsprecher einer Stadt beim Tournier bist - in der "
        "entsprechenden Rubrik einen Vorschlag machen und auch fuer beliebige "
        "Vorschlaege stimmen.\n"
        "Weitere Informationen zum Tournier gibt's am Brett Spieler, Allgemeines "
        "im Artikel 16522 und folgende.");
    add_id(({"termin","termine","terminabstimmung","abstimmung",}));
    set_name("terminliste");
    set_gender("weiblich");
}
