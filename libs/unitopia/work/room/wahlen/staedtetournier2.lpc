inherit "/i/object/urne";

#define DEBUGGER "sorcerer"
#include <debug.h>

#include <level.h>

#define BETEILIGTE ({"kathrina","alpenrose",\
                     "arkas",\
                     "appolonia",\
                     "tadu",\
                     "elcapone",\
                     "hammurabi",\
                     "loisa",\
                     "hooky",\
                     "theokrates",})

private int has_name(string text, string rn)
{
    return member(regexplode(lower_case(text), "[a-z]*"), rn)>=0;
}

nosave mixed may_add_subject(object who, string subject)
{
    if (adminp(who))
        return 1;
    // Niemand.
    return 0;
}

varargs nosave int may_delete(object who, string subject, mixed subject_data, string topic, mixed topic_data)
{
    if(adminp(who))
        return 1;

    if(!topic || !playerp(who))
        return 0;

    return (has_name(topic, who->query_real_name()) || lower_case(topic_data) == who->query_real_name());
}

varargs nosave int may_delete_empty_subject(object who, string subject, mixed subject_data, string topic, mixed topic_data)
{
    if (adminp(who) && !topic)
      return 1;
    return may_delete(who, subject, &subject_data, topic, &topic_data);
}

varargs nosave mixed may_add_topic(object who, string subject, mixed subject_data, string topic)
{
    return (adminp(who) || member(BETEILIGTE, who->query_real_name())!=-1);
}

nosave void do_add_topic(closure callback, object who, string subject, mixed subjectdata, string topic)
{
    funcall(callback, who->query_real_cap_name());
}

varargs nosave int may_vote(object who, string subject, mixed subject_data, string topic, mixed topic_data)
{
    if(!playerp(who))
        return 0;

    if(adminp(who))
        return 1;

    if(member(BETEILIGTE, who->query_real_name())!=-1)
    {
 //       topic_data = who->query_real_cap_name();
        return 1;
    }
}
