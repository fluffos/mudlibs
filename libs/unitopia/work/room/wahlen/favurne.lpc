inherit "/i/object/urne";

#include <level.h>
#include <config.h>
#include <apps.h>
#include <time.h>
#include <more.h>

#pragma no_clone
// dont clone me!

// Wahl nur im Juli
#define WAHLENDE (timearray(time())[TM_MON]!=7)

void create() {
  ::create();
  set_short("Die Urne fuer die Wahl des UNItopia-Favicons");
  set_long("Diese Wahlurne dient zur Wahl des UNItopia-Favicons. "
           "Die Vorschlaege koennen unter\n\n"
           "     http://www.unitopia.de/favicon.html\n\n"
           "eingesehen werden. Um Deine Stimme abzugeben, lies die Listen.");
  return;
}

varargs nosave mixed may_add_topic(object who, string subject, 
                                   mixed subject_data, string topic) {
  return adminp(who);
}

varargs nosave mixed may_add_subject(object who, string subject) {
  return adminp(who);
}

varargs nosave int may_delete(object who) {
  return adminp(who);
}

varargs nosave int may_delete_empty_subject(object who) {
  return adminp(who);
}

nosave int geheim() {
  if (this_interactive() && adminp (this_interactive())) return 0;
  if (WAHLENDE)
    return 1;
  return 2;
}

varargs nosave int may_vote(object who, string subject, mixed subject_data, 
                            string topic, mixed topic_data) {
  if (WAHLENDE) {
    write ("Die Wahl laeuft nur im Juli 2012.\n");
    return 0;
  }

  if (!wizp(who)) {
    if (who->query_age() < 432000) {
      write ("Du bist noch zu jung zum waehlen.\n");
      return 0;
    }
    if (who->query_stat(0)+who->query_stat(1)+who->query_stat(2)+
        who->query_stat(3)<140) {
      write ("Deine Faehigkeiten reichen noch nicht aus zum Waehlen.\n");
      return 0;
    }
  }

  return 1;
}
