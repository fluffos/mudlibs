mapping exits;
mapping extras;

void create() {
  exits = ([
    "sueden": "/room/church",
    "south": "/room/church",
    "s": "/room/church",
    "raus": "/room/church",
  ]);
  extras = ([
    "hebel":
    "Ein hoelzerner Hebel, direkt neben der Tuer.\n",
    "treppe":
    "Die steinerne Treppe schraubt sich in die Hoehe und fuehrt wohl in "
    "den Glockenturm hinauf.\n",
    "fackelhalter":
    "Ein schwarzes, metallenes Behaeltnis, in dem einst eine Fackel "
    "steckte.\n",
    "aussenmauer":
    "Die Aussenmauer wurde mit Absicht so dick gebaut, um dem darauf "
    "lastenden Glockenturm ein solides Fundament zu geben.\n",
  ]);
}

string query_short() { return "Im Kirchturm"; }

string query_long() {
  return "Im Sockel des Nordturms.\n"
    "Hier drin ist es ziemlich duster, da der Raum selbst keine Fenster hat. "
    "Nur von oben, ueber die hier endende Spindeltreppe faellt ein "
    "Lichtschimmer herab. An der ziemlich dicken Aussenmauer ist ein "
    "Fackelhalter befestigt. Eine Tuer fuehrt nach Sueden hinaus in den "
    "Westteil des gewaltigen Mittelschiffs der Kathedrale.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Der sichtbare Ausgang ist sueden.\n";
}

string query_item(string item) {
  if (!extras || !item)
    return 0;
  return extras[lower_case(item)];
}
