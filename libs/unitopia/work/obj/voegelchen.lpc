// Twitter-Interface fuer UNItopia
//

inherit "/i/monster/monster";

#include <apps.h>
#include <deklin.h>
#include <message.h>

void create()
{
    "*"::create();
    
    initialize("vogel", 25);
    set_name("voegelchen");
    set_id(({"voegelchen", "vogel"}));
    set_gender("saechlich");
    set_adjektiv(({"hellblau"}));
    set_long("Das hellblaue Voegelchen ist schon weit herumgekommen, es "
        "scheint als koenne es mit der gesamten Welt kommunizieren. "
        "Es hoert dir auch bestimmt gern zu, wenn du etwas zu ihm sagst, "
        "und wird es in das Twitter-Universum zwitschern.");
    
    TWITTERD->add_controller(({"notify_twitter", "notify_send_global"}), this_object());
    add_controller("notify_comm", this_object());
    set_max_internal_encumbrance(1);
    allow_only(({}), "$Der() moechte $wen('what,"+ART_KEIN+").");
}

void notify_twitter(mapping msg)
{
    send_message(MT_NOISE, MA_COMM, wrap_say(
        Der()+" zwitschert von "+msg["user"]["screen_name"]+":",
        msg["asciitext"]));
}

void notify_send_global(string msg, string orig, object player, object sender)
{
    if(sender == this_object() || !player)
        return;

    send_message(MT_NOISE, MA_COMM, wrap_say(
        Der()+" zwitschert von " + player->query_real_cap_name() + ":",
        orig));
}

void notify_comm(object wer, mixed wen, string what, string adverb, int flags,
    int msg_typ_wer, int msg_typ_wen, int msg_typ_andere)
{
    string str, prefix = "";
    string orig = adverb;

    if(wen != this_object() || !playerp(wer) || !sizeof(adverb))
        return;

    while(sizeof(adverb) && adverb[0] == '@')
    {
        int pos = strstr(adverb, " ");
        if(pos < 0)
            break;
        prefix = prefix + adverb[0..pos];
        adverb = adverb[pos+1..<1];
    }

    str = prefix + wer->query_real_cap_name() + " " + what + "t: " + adverb;
    if(sizeof(str) <= 140)
        TWITTERD->send_global(str, adverb, wer, this_object());
    else
        send_message(MT_LOOK, MA_EMOTE, wrap(Der() + " schaut ueberfordert."));
}
