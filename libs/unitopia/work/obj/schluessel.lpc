inherit "/i/item";
inherit "/i/move";
inherit "/i/value";
inherit "/i/object/key";

void create()
{
   set_name("schluessel");
   set_gender("maennlich");
   set_id("schluessel");
   set_material("metall");
   set_long("Ein zierlicher, kleiner Schluessel.");
   set_weight(1);
   set_value(5);
   set_no_store(1);
}
