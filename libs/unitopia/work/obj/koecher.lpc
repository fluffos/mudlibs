/*
 * Ein (Beispiel-) Koecher fuer /obj/schuss_waffe.
 */
inherit "/i/object/tasche";
 
void create()
{
    ::create();
    set_id(({"koecher"}));
    set_name("koecher");
    set_gender("maennlich");
    set_long("Ein Koecher augenscheinlich fuer Pfeile.\n");
    set_smell("Er riecht nach Leder.\n");
    set_material(({"leder"}));
    set_weight(3);
    set_max_internal_encumbrance(10);
    allow_only(({"pfeil"}),"Der Koecher ist nur fuer Pfeile geeignet.");
    set_value(20);
    clear_initial_conservation_data();
}
