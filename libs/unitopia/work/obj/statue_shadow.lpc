inherit "/i/shadow";

string query_short(object viewer)
{
    return Ihr((["name":"statue","gender":"weiblich"]),0,query_shadow_owner());
}

// Damit Statuen nicht getoetet werden koennen.
varargs int add_hp(int i, mapping infos)
{
    return -1;
}

int let_not_in(object move_objekt, object ursprung, string dir)
{
    return 1;
}

int let_not_out(object move_objekt, object ziel, string dir)
{
    return 1;
}

int id(string str)
{
    if (str == "statue")
	return 1;
    return query_shadow_owner()->id(str);
}

string *query_id()
{
    return (query_shadow_owner()->query_id() || ({}))+({"statue"});
}

string query_noise()
{
    return "Du vernimmst kein einziges Geraeusch von der Statue.\n"
           "Doch - wenn Du ganz still bist, hoerst Du etwas Knacken und Rascheln,\n"
           "als wenn sich Risse bilden wuerden.\n";
}

string query_smell()
{
    return "Du riechst - gar nichts. Es ist fast so, als ob die Statue nie gelebt haette.\n";
}
