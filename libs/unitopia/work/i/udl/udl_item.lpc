    add_udl_tag("add_id","udl_add_id");
    add_udl_tag("gender","udl_set_gender");
    add_udl_tag("name","udl_set_name");
    add_udl_tag("feel","udl_set_feel");
    add_udl_tag("plural","udl_set_plural");
    add_udl_tag("plural_id","udl_set_plural_id");
    add_udl_tag("material","udl_set_material");
    add_udl_tag("add_material","udl_add_material");
    add_udl_tag("class_id","udl_set_class_id");
    add_udl_tag("invis","udl_set_invis");
    add_udl_tag("personal","udl_set_personal");
    add_udl_tag("personal_title","udl_set_personal_title");
    add_udl_tag("eigen","udl_set_eigen");
    add_udl_tag("noise","udl_set_noise");
    add_udl_tag("read","udl_set_read"); 
    add_udl_tag("smell","udl_set_smell");
    add_udl_tag("weight","udl_set_weight");
    add_udl_tag("hidden_until_next_move","udl_set_hunm");
    add_udl_tag("add_v_item","udl_add_v_item");
    add_udl_tag("delete_v_item","udl_delete_v_item");
    add_udl_tag("add_v_item_master","udl_add_v_item_master");
    add_udl_tag("delete_v_item_master","udl_delete_v_item_master");
//    add_udl_tag("","udl_set_short");
//    add_udl_tag("","udl_set_short");


}

