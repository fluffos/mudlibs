void udl_set_invis(string udl_desc)
{
    string dummy;
    
    dummy=udl_build_string(udl_desc);
    switch(dummy)
    {
	case "VIS":
	    this_object()->set_invis(V_VIS);
	    break;
        case "NOLIST":
            this_object()->set_invis(V_NOLIST);
            break;
	case "HIDDEN":
	    this_object()->set_invis(V_HIDDEN);
	    break;
        case "SHIMMER":
            this_object()->set_invis(V_SHIMMER);
            break;
	case "INVIS":
	    this_object()->set_invis(V_INVIS);
	    break;
	default:
	    do_error(dummy +" ist kein Wert fuer INVIS.");
    }
}

void udl_add_v_item(string udl_desc)
{
    mapping v_item;
    string tag_desc;

    v_item = ([]);

    tag_desc = get_tag_content("name",udl_desc);
    if (tag_desc != "")
	v_item= v_item+ ([ "name":udl_build_string(tag_desc)]);

    tag_desc = get_tag_content("long",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "long":udl_build_string(tag_desc)]);

    tag_desc = get_tag_content("noise",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "noise":udl_build_string(tag_desc)]);

        tag_desc = get_tag_content("smell",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "smell":udl_build_string(tag_desc)]);

    tag_desc = get_tag_content("read",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "read":udl_build_string(tag_desc)]);

    tag_desc = get_tag_content("feel",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "feel":udl_build_string(tag_desc)]);
    
    tag_desc = get_tag_content("look_msg",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "look_msg":udl_build_string(tag_desc)]);
	    
    tag_desc = get_tag_content("hear_msg",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "hear_msg":udl_build_string(tag_desc)]);
		    
    tag_desc = get_tag_content("smell_msg",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "smell_msg":udl_build_string(tag_desc)]);
				
    tag_desc = get_tag_content("read_msg",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "read_msg":udl_build_string(tag_desc)]);
					
    tag_desc = get_tag_content("feel_msg",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "feel_msg":udl_build_string(tag_desc)]);
						
    tag_desc = get_tag_content("take",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "take":udl_build_string(tag_desc)]);

    tag_desc = get_tag_content("take_msg",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "take_msg":udl_build_string(tag_desc)]);
    
    tag_desc = get_tag_content("attack",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "attack":udl_build_string(tag_desc)]);
	
    tag_desc = get_tag_content("attack_msg",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "attack_msg":udl_build_string(tag_desc)]);
    
    tag_desc = get_tag_content("gender",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "gender":udl_build_string(tag_desc)]);

    tag_desc = get_tag_content("adjektiv",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "adjektv":udl_build_array(tag_desc)]);

    tag_desc = get_tag_content("id",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "id":udl_build_array(tag_desc)]);

    tag_desc = get_tag_content("gender",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "gender":udl_build_string(tag_desc)]);

    tag_desc = get_tag_content("soul",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "soul":udl_build_string(tag_desc)]);

    tag_desc = get_tag_content("plural",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "plural":to_int(udl_build_string(tag_desc))]);

    tag_desc = get_tag_content("far",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "far":to_int(udl_build_string(tag_desc))]);

    tag_desc = get_tag_content("living",udl_desc);
    if (tag_desc != "")
        v_item= v_item+ ([ "living":to_int(udl_build_string(tag_desc))]);

    this_object()->add_v_item(v_item);
}
	
