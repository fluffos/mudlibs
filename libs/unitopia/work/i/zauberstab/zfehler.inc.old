#define ERRORS     m[0][BR_USER]["Errors"]
#define ERROR_NUMS m[1][BR_USER]["Error_Numbers"]
#define ERROR_LINES m[1][BR_USER]["Error Lines"]
#define WIZ        m[0][BR_USER]["Opt"]["args"][m[1][BR_PATH]-1]

#define OSTATUS        (member(OPT,"o")?\
                        "Objekt:\""+OPT["o"]+"\" ":\
                        (OPT["f"]?\
                         "File:\""+OPT["f"]+"\" "+\
                         (OPT["v"]?\
                          "Verursacher:\""+OPT["v"]+"\" ":""):\
                         (OPT["v"]?\
                          "Verursacher:\""+OPT["v"]+"\" ":"")))
#define RSTATUS         OSTATUS + "[<,>,q,<nr>,?] "
#define SSTATUS         lambda(({'more_line,'max_line}),({#'sstatus,'more_line,'max_line,quote(m)}))
#define MSTATUS 	OSTATUS + WIZ + " [+-<>/lmvq?] "

#define CLIPIT(x) 	x=trim(x[1..]);
#define MFLAGS  	M_LINE_NUMBERS | M_DO_NOT_END | M_FRAME
#define MFLAGS2  	M_DO_NOT_END | M_FRAME
#define BHELP(x) 	return read_file(HILFE_PFAD+"fbrowser"+x);
#define ERROR_NAMES 	([EDB_FEHLER    : "FEHLER",			\
	 		  EDB_IDEE      : "IDEE",	        	\
           		  EDB_RUNTIME   : "RUNTIME ERROR",		\
	 		  EDB_COMPILE   : "COMPILE ERROR",              \
                          EDB_LOB       : "WUERDIGUNG",                 \
                          EDB_TYPO      : "TYPO",			\
			  EDB_DETAIL    : "DETAIL"])


