#define CHECK_INT \
    if (this_object()->query_stat(STAT_INT) < MIN_INT_COMM) \
    { \
	notify_fail("Dazu bist du nicht intelligent genug.\n"); \
	return 0; \
    }
#else
#define CHECK_INT ;
#endif

