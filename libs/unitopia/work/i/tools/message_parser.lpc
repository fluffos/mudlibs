#pragma save_types

// Diese Funktionen werden im Prinzip nur von /i/move.c
// und /i/room.c gebraucht, um die Bewegungsmeldungen 
// von beweglichen Objekten zu realisieren.

// string_parser() ist eine simul_efun aus /secure/deklin
closure message_parser(string str)
{
   return str && lambda(({'tp,'richtung }), string_parser(str,0,1));
}

// Diese Funktion wird zur Konvertierung von alten Bewegungsmeldungen 
// benoetigt.
string message_converter(string str, int rein, int magic)
{
   if(strstr(str,"$") < 0)
   {
#if 0
      sys_log("message_converter", sprintf("%s %-=70s\n", shorttimestr(time()),
        sprintf("%O, %O: %O\n", this_object(), caller_stack(), str)));
#endif
      return (rein ? "$Ein() " : "$Der() ") + str + (magic ? "" : " $dir()");
   }
   return str;
}
