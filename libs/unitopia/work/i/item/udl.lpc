// Geclonte Objekte, die mit UDL erstellt wurden, koennen nicht auf den
// Namen der UDL Datei umbenannt werden, um die UrsprungsDatei des Objektes
// zu speichern wird hier set_original_udl_file() und query_originail_udl
// _file() definiert. Die Funktion set_original_udl_file() wird von 
// Funktion clone_object() augerufen.

#pragma save_types
#pragma strong_types

#include <config.h>

private string udl_file;

/* 
 FUNKTION: set_udl_file
DEKLARATION: void set_udl_file(string file)
BESCHREIBUNG:
Die Funktion wird beim clonen eines UDL - Files aufgerufen. Im Objekt wird
dann der Original-File-name gespeichert. Diese Funktion darf nur vom
Master aufgerufen werden.
VERWEISE: query_udl_file
GRUPPEN: udl
*/

void set_udl_file(string file)
{
    if (!udl_file && (object_name(previous_object()) == MASTER_OB))
	udl_file = file;
}

/*
 FUNKTION: query_udl_file
DEKLARATION: string query_udl_file()
BESCHREIBUNG:
Die Funktion liefert, welches Original File die Beschreibung des Objektes
enthaelt.
VERWEISE: set_original_udl_file
GRUPPEN: udl
*/
string query_udl_file()
{
    return udl_file;
}

int process_udl(string udl_desc)
{
    touch("/apps/udl")->process_udl(udl_desc,this_object());
}

int read_udl_file(string filename)
{
    string fullfilepath, udl_desc;

    fullfilepath = abs_path(filename) + ".udl";
    udl_desc = read_file(fullfilepath);
    if (!udl_desc || udl_desc == "")
    {
        //    do_error("Kein Inhalt im File: " + fullfilepath + "\n");
            return 0;
        }
    return process_udl(udl_desc);
}
