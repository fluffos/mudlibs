#include <v_item.h>
#include <invis.h>

private static mixed *v_items;
private static int v_item_count;
private string *v_item_master;
private int share_v_items;

private int check_adjektiv(mixed *adjektiv, string str)
{
   int i,s,t,t0,t1, bonus;
   string stamm;
   if(!stringp(str))
      return 0;
   s = strlen(str);
   if (pointerp(adjektiv))
      for(i = 0; i < sizeof(adjektiv); i++)
      {
         string orig;
         
         stamm = query_deklin_ein_adjektiv(adjektiv[i], -1);
         if(stringp(adjektiv[i]))
            orig = adjektiv[i];
         else
            orig = adjektiv[i][0];
         
         if(stamm == orig && (stamm[<2..] == "er" || stamm[<2..] == "en"))
            stamm = stamm[..<3] + stamm[<1..<1]; // Ohne 'e' als Alternative
         
         t0 = strlen(orig);
         t1 = strlen(stamm);
         bonus = abs(t0 - t1);
         if(str[<1]==',')
            bonus++;
         if((s >= t0 && s <= t0+bonus+2 && str[0..t0-1] == orig) ||
            (s >= t1 && s <= t1+bonus+2 && str[0..t1-1] == stamm))
            return i+1;
      }
   return 0;
}

static mapping search_v_item(mixed *v_i, mixed path, int flag)
{
    string name, *adj, *ids;
    int i, j, p, num;
    int *sorted, *unsorted=({});
    mapping tmp;

    if ((!mappingp(path) && !pointerp(path)) || (pointerp(path) && !sizeof(path)) || !sizeof(v_i))
	return 0;

    if (mappingp(path))
    {
	// Wir haben direkt ein V-Item uebergeben bekommen.
	// Wir koennen uns also den ganzen Spass unten sparren.
	int *nrs;
	mapping pvitem;
	
	// Isses ueberhaupt unser V-Item?
	if(path["v_item_master"]!=this_object())
	    return 0;
	    
	nrs = path["v_item_path"];

	// Erstes V-Item finden.
	for(i=0;i<sizeof(v_i);i++)
	    if(v_i[i]["v_item_path"][<1]==nrs[0])
	        break;
	
	if(sizeof(nrs)==1)
	{
	    if (flag & VV_DELETE)
	    {
		v_i = arr_delete(v_i,i);
		return ([]);
	    }
	    if (flag & VV_CHANGE)
		return v_i[i];
	    if (flag & VV_QUERY)
	    {
		tmp = copy(v_i[i]);
		if (!(flag & VV_NO_ROOM_ENV))
		    tmp["environment"] = this_object();
		return tmp;
	    }
	    return v_i[i];
	}
	
	pvitem = v_i[i];
	i = sizeof(pvitem["v_item"]);
	
	foreach(int nr:nrs[1..<1])
	{
	    mixed vitems = pvitem["v_item"];
	    if(i<sizeof(vitems)) // Nicht die erste Runde.
	    {
		pvitem = vitems[i];
		vitems = pvitem["v_item"];
		if(!vitems)
		    return 0;
	    }
	    for(i=0;i<sizeof(vitems);i++)
		if(vitems[i]["v_item_path"][<1]==nr)
		    break;
	    if(i==sizeof(vitems))
		return 0;
	}
	// Das Ergebnis ist in pvitem["v_item"][i]
	if (flag & VV_DELETE)
	{
	    pvitem["v_item"] = arr_delete(pvitem["v_item"],i);
	    return ([]);
	}
	if (flag & VV_CHANGE)
	    return pvitem["v_item"][i];
	if (flag & VV_QUERY)
	{
	    tmp = copy(pvitem["v_item"][i]);
	    if (!(flag & VV_NO_ROOM_ENV))
		tmp["environment"] = this_object();
	    return tmp;
	}
	return pvitem["v_item"][i];
    }
    else if (mappingp(path[0]))
    {
	name = path[0]["name"];
	adj = path[0]["adjektiv"];
	num = path[0]["nummer"];
	if (num<1)
	    num = 0;
    }
    else
    {
	name = path[0];
	num = 0;
    }
    
    if(num>1000) return 0; // Soviele V-Items gibbet nich.
    
    sorted = ({-1})*(num+2);

    for (i = 0; i < sizeof(v_i); i++)
	if ((((ids = v_i[i]["id"]) && (p=member(ids,name)) >= 0) ||
	     ((!ids && v_i[i]["name"] == name) && (p=-1) )) &&
	    ((flag&VV_INVIS) ||
	     !(funcall(v_i[i]["invis"],v_i[i])&V_ATOM_INVIS)))
	{
	    if (adj)
	    {
		for (j = 0; j<sizeof(adj); j++)
		    if (!check_adjektiv(v_i[i]["adjektiv"],adj[j]))
			break;
		if (j < sizeof(adj))	/* Nicht alle Adjektive stimmen :( */
	    	    continue;
	    }
	    if(member(v_i[i],"nummer"))
	    {
		if(!pointerp(v_i[i]["nummer"]))
		    j = v_i[i]["nummer"];
		else if(p<0)
		    j = v_i[i]["nummer"][0];
		else
		    j = v_i[i]["nummer"][p];
		    
	        if(j <= num+1 && j >= 0)
		    sorted[j] = i;
		if(j == num)
		    break;
	    }
	    else
	        unsorted+=({i});
	}

    // Nun Behandlung der Nummern...
    
    i=sorted[num];
    if(i==-1)	// Kein direkt numeriertes V-Item gefunden
    {
	if(!num)
	{
	    num++;
	    i=sorted[num];
	} 
	if(i==-1)
	{
           i=sizeof(filter(sorted[1..num-1],(:$1==-1:)));	// Wieviel Luecken gibt
	   if(i>=sizeof(unsorted))		        // es?
	       return 0;
	   i=unsorted[i];
	}
    }
    
    if (sizeof(path) == 1)
    {
	if (flag & VV_DELETE)
	{
	    v_i = arr_delete(v_i,i);
	    return ([]);
	}
	if (flag & VV_CHANGE)
	    return v_i[i];
	if (flag & VV_QUERY)
	{
	    tmp = copy(v_i[i]);
	    if (!(flag & VV_NO_ROOM_ENV))
		tmp["environment"] = this_object();
	    return tmp;
	}
	return v_i[i];
    }
    if ((tmp=search_v_item(&(v_i[i]["v_item"]),path[1..],flag)) &&
	flag & VV_QUERY)
    {
	mapping tmp2, env, env2;

	tmp = copy(tmp);
	tmp2 = copy(v_i[i]);
	if (!(flag & VV_NO_ROOM_ENV))
	    tmp2["environment"] = this_object();
	env = tmp;
	while(mappingp(env2 = env["environment"]))
	    env = env2;
	env["environment"] = m_delete(tmp2,"v_item");
    }
    return tmp;
}

#if 0
static mapping check_shared_v_item(mapping item, mixed *path)
{
    string *inherits, *ind, indi;
    mapping tmp_item;
    object ob;
    int i, j, k, found;

    inherits=inherit_list(this_object());
