FUNKTION: query_book
DEKLARATION: int query_book()
BESCHREIBUNG:
Liefert bei einem Buch 1 zurueck.
VERWEISE:
GRUPPEN: buch
*/
int query_book()
{
    return 1;
}


string query_short (object betrachter)
{
    if (open_close && (current_page >= 0))
        return ::query_short(betrachter)+" (aufgeschlagen)";
    return ::query_short(betrachter);
}
