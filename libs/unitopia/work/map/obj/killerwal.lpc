//
// Revision 1.2  2009-01-15 09:03:12  gnomi
// "far"-Eintrag fuer die Zaehne.
//
// Revision 1.1  2008-05-14 17:40:36  gnomi
// Neuer Killerwal von Anin eingebaut.
//

inherit "/map/i/stranden";

#include <message.h>

string query_leiche_kurz()
{
  return "Die Leiche eines grossen Schwertwals";
}

string query_leiche_lang()
{
  return "Die Leiche eines grossen Schwertwals, der auf das Land geraten ist.";
}

void create()
{
    ::create();
    initialize("killerwal",50);
    set_name("schwertwal");
    set_adjektiv(({"gross"}));
    set_gender("maennlich");
    set_id(({"wal","killerwal","orca","schwertwal", "map fish"}));
    set_long("Oberkopf, Brustflossen sowie Ruecken- und Schwanzflosse dieses "
             "grossen Schwertwals sind schwarz, die Kehle und der Bauch "
             "weiss. Die Seiten und der Ruecken sind tief schwarz mit Ausnahme "
             "eines weissen, ovalen Flecks hinter dem Auge. Hinter der grossen "
             "Rueckenfinne ist noch ein graeulicher Sattelfleck. Der Killerwal "
             "hat riesige scharfe Zaehne in seinem Maul!");
    set_noise("Im Moment scheint er gerade nicht mehr zu singen.");
    set_aggressive(1);
    set_align(-30);

    load_chat(5,
              ({ ({ MT_LOOK, MA_MOVE,
                    "$Der() springt aus dem Wasser." }),
                 ({ MT_LOOK, MA_MOVE,
                    "$Der() schwimmt um dich herum." }),
                 ({ MT_LOOK, MA_CRAFT,
                    "$Der() macht Wellen, die dich ordentlich "
                    "durchschaukeln." }),
                 ({ MT_LOOK, MA_CRAFT,
                    "$Der() hebt den Oberkoerper aus dem Wasser, indem "
                    "$er() mit den Brustflossen rudert." }),
                 ({ MT_LOOK, MA_CRAFT,
                    "$Der() zeigt dir seine Zaehne." }),
                 ({ MT_LOOK, MA_MOVE,
                    "$Der() springt aus dem Wasser." }),
                 ({ MT_NOISE, MA_NOISE,
                    "Du hoerst den Walgesang $des()." }),
                 ({ MT_LOOK, MA_CRAFT,
                    "$Der() taucht auf und pustet eine Blaswolke aus seinem "
                    "Blasloch." }),
                 ({ MT_NOISE, MA_NOISE,
                    "Die Schwanzfluke $des() klatscht laut auf die "
                    "Wasseroberflaeche." }),
                 }) );

    if(clonep())
    {
        add_v_item_master(load_name());
    }
    else
    {
        add_v_item(([
	   "name"     : "zaehne",
	   "gender"   : "maennlich",
	   "plural"   : 1,
	   "id"       : ({"zahn", "zaehne", "maul", "mund", "kiefer",
                          "oberkiefer", "unterkiefer", "natural#weapon"}),
	   "long"     : "Du schaetzt, dass da gut 50 grosse konische Zaehne "
                        "auf ein Opfer warten. Hoffentlich stehst du nicht auf "
                        "dem Speiseplan!",
           "far"      : "Du traust dich nicht nahe genug ran!",
	]));
        add_v_item(([
           "name"     : "ruecken",
           "gender"   : "maennlich",
           "id"       : ({"ruecken","oberseite","dorsalseite","nacken"}),
           "long"     : "Hinter der Finne liegt ein graeulicher Fleck auf dem "
                        "sonst komplett schwarzen Ruecken. Diesen nennt man "
                        "Sattelfleck.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "sattelfleck",
           "gender"   : "maennlich",
           "id"       : ({"sattelfleck","sattel","klammer"}),
           "adjektiv" : ({"graeulich"}),
           "long"     : "Hinter der Finne liegt der graeuliche Sattelfleck. "
                        "Bei diesem Schwertwal sieht er aus wie eine riesige "
                        "geschweifte Klammer.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "flossen",
           "gender"   : "weiblich",
           "plural"   : 1,
           "id"       : ({"flossen","flosse","walflosse","walflossen",
       	                  "fischflosse","fischflossen"}),
           "long"     : "Du findest eine Schwanzflosse, zwei Brustflossen, "
                        "und eine Rueckenflosse.",
           "look_msg" : "$Der() sucht den Walkoerper nach Flossen ab.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "brustflossen",
           "gender"   : "weiblich",
           "plural"   : 1,
           "id"       : ({"brustflossen","brustflosse","flipper"}),
           "long"     : "Du beobachtest die Brustflossen des Schwertwals: Die "
                        "Flipper sind paddelfoermig und ungefaehr einen Meter "
                        "lang.",
           "look_msg" : "$Der() beobachtet die Bewegungen der Brustflossen.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "rueckenflosse",
           "gender"   : "weiblich",
           "id"       : ({"rueckenflosse","finne","rueckenfinne"}),
           "long"     : "Die Finne ist bestimmt einen Meter hoch und spitz.",
           "look_msg" : "$Der() laesst $seinen(([name:blick,gender:maennlich]),"
       	                "0,OBJ_TP) ueber den Ruecken des Schwertwals wandern.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "schwanzflosse",
           "gender"   : "weiblich",
           "id"       : ({"schwanzflosse","fluke","schwanz","hinterende",
                          "schwanzfluke"}),
           "long"     : "Die Fluke ist schwarz und an der Unterseite weiss. Sie "
                        "ist leicht gebogen, deutlich gekerbt und laeuft an den "
                        "Enden spitz aus.",
           "look_msg" : "$Der() begutachtet die Schwanzflosse des Schwertwals.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "kopf",
           "gender"   : "maennlich",
           "id"       : ({"kopf","walkopf","oberkopf","vorderende","schnauze",
                          "unterkopf"}),
           "long"     : "Der Kopf ist abgeflacht und hat eine kurze, leicht "
                        "abgesetzte Schnauze. Der Oberkopf einschliesslich "
                        "Oberkiefer ist komplett schwarz, der untere Teil "
                        "komplett weiss.",
           "look_msg" : "$Der() schaut sich den Kopf des Schwertwals an.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "unterseite",
           "gender"   : "weiblich",
           "id"       : ({"unterseite","kehle","bauch"}),
           "long"     : "Die komplette Unterseite von Unterkiefer ueber Kehle "
                        "und Bauch bis zur Fluke ist weiss.",
           "look_msg" : "$Der() begutachtet den Schwertwal so gut $er() kann "
                        "von unten.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "augen",
           "gender"   : "saechlich",
           "plural"   : 1,
           "id"       : ({"augen","auge","fleck"}),
           "long"     : "Hinter den dunklen Augen ist jeweils ein weisser "
                        "Fleck zu sehen.",
           "look_msg" : "$Der() versucht, dem Schwertwal in die Augen zu "
                        "schauen.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "blasloch",
           "gender"   : "saechlich",
           "id"       : ({"blasloch","loch","atemwegsoeffnung","atemloch",
                          "atemoeffnung"}),
           "long"     : "Zwischen Kopf und Ruecken des Schwertwals kannst du "
                        "sein Blasloch entdecken, welches ihm als Atemoeffnung "
                        "dient.",
           "look_msg" : "$Dem() gelingt es, einen Blick auf das Blasloch "
                        "des Schwertwals zu werfen.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
        add_v_item(([
           "name"     : "haut",
           "gender"   : "weiblich",
           "id"       : ({"haut","oberflaeche","farbe","hautfarbe","blubber",
                          "natural#armour"}),
           "long"     : "Die Grundfarben das Schwertwals sind eindeutig "
                        "Schwarz und Weiss. Einzig der Sattelfleck ist grau. "
                        "Die grobe Aufteilung ist auch recht einfach gehalten: "
                        "Oben schwarz, unten weiss.",
           "look_msg" : "$Der() betrachtet den Walkoerper von allen "
       	                "moeglichen Seiten.",
           "far"      : "Du kommst nicht nahe genug ran!",
                        ]));
    }
}
