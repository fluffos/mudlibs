// Twitter-Interface fuer UNItopia
//

inherit "/i/item/control";

#include <message.h>

#define ESECURE	(object_name(previous_object()) == "/secure/rpc/twitter")

// Aufrufe von /secure/rpc/twitter.c
void receive(mapping msg)
{
    if(!ESECURE)
	return;

    notify("twitter", msg);
}

// Bitte alle Aufrufe mit Gnomi absprechen.
void send_global(string msg, string orig, object player, object sender)
{
    "/secure/rpc/twitter"->sendunimsg(msg);
    notify("send_global", msg, orig, player, sender);
}

void prepare_renewal() {}
void finish_renewal(object neu)
{
    foreach(string func, mixed contr: query_controller())
        if(pointerp(contr))
            foreach(mixed ob: contr - ({0}))
                neu->add_controller(func, ob);
        else if(contr)
            neu->add_controller(func, contr);
}

void abort_renewal() {}
