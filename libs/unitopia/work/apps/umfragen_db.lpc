            raise_error("Tabelle userinfo konnte nicht "
                    "erstellt werden:"+query_db_error());
        }
    }
    if (db_check_table("userignore") == -1)
    {
        db_debug("Tabelle userignore anlegen", 
            DB_DBGLVL_INFO, DB_DBG_BUFFER_MSG);
        flag++;
        db_query("CREATE TABLE IF NOT EXISTS userignore ("
            "wer TEXT, was TEXT, id INTEGER )");
        if (query_db_error())
        {
            db_debug("Tabelle userignore anlegen fehlgeschlagen", 
