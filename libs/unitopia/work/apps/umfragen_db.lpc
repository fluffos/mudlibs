public string query_database_description()
{
    return "Diese Datenbank dient zur Verwaltung von Ideen und Umfragen. "
    "Zum Verwalten gibt es /room/rathaus/obj/uiko. " 
    "Fuer Admins gibt es speziell die Lfuns sql und db_get_table.";
}

private void init_db()
{
    int flag = 0;
    if (!init_debuglog(UMFRAGE_DBFILE, RETENTION_DAYS))
    {
        raise_error("Datenbank "+UMFRAGE_DBFILE
            +" konnte nicht geoeffnet werden.\n");
    }
    db_debug(0,0,DB_DBG_CREATE); // Anlegen falls nicht vorhanden
    debuglog("Start Initialisierung Umfrage-Master", DB_DBGLVL_INFO, 0,
        "init_db"); // applikations log
    db_debug("Start Initialisierung Umfrage-Master", DB_DBGLVL_INFO, 
        DB_DBG_BUFFER_MSG); // erstmal nur buffern im db-log
    if (db_check_table("umfragen") == -1)
    {
        db_debug("Tabelle umfragen anlegen", 
            DB_DBGLVL_INFO, DB_DBG_BUFFER_MSG);
        flag++;
        db_query("CREATE TABLE IF NOT EXISTS umfragen ("
            "u_id INTEGER CONTRAINT pk_umfragen PRIMARY KEY, frage TEXT, "
            "ersteller TEXT, status INTEGER, "
            "i_id INTEGER, pantheon INTEGER )");
        if (query_db_error()) 
        {
            db_debug("Tabelle umfragen anlegen fehlgeschlagen", 
                DB_DBGLVL_ERROR, DB_DBG_FLUSH_BUFFER);
            raise_error("Tabelle umfragen konnte nicht "
                    "erstellt werden:"+query_db_error());
        }
        setup_counter("u_id",0);
    }
    if (db_check_table("antworten") == -1)
    {
        db_debug("Tabelle antworten anlegen", 
            DB_DBGLVL_INFO, DB_DBG_BUFFER_MSG);
        flag++;
        db_query("CREATE TABLE IF NOT EXISTS antworten ("
            "u_id INTEGER, a_id INTEGER CONTRAINT pk_antworten PRIMARY KEY, "
            "antwort TEXT)");
        if (query_db_error()) 
        {
            db_debug("Tabelle antworten anlegen fehlgeschlagen", 
                DB_DBGLVL_ERROR, DB_DBG_FLUSH_BUFFER);
            raise_error("Tabelle antworten konnte nicht "
                    "erstellt werden:"+query_db_error());
        }
        setup_counter("a_id", 0);
    }
    if (db_check_table("erhebung") == -1)
    {
        db_debug("Tabelle erhebung anlegen", 
            DB_DBGLVL_INFO, DB_DBG_BUFFER_MSG);
        flag++;
        db_query("CREATE TABLE IF NOT EXISTS erhebung ("
            "u_id INTEGER, a_id INTEGER, pantheon INTEGER, "
            "e_id INTEGER CONTRAINT pk_erhebung PRIMARY KEY, wer TEXT)");
        if (query_db_error())
        {
            db_debug("Tabelle erhebung anlegen fehlgeschlagen", 
                DB_DBGLVL_ERROR, DB_DBG_FLUSH_BUFFER);
            raise_error("Tabelle erhebung konnte nicht "
                    "erstellt werden:"+query_db_error());
        }
        setup_counter("e_id", 0);
    }
    if (db_check_table("ideen") == -1)
