private int check_userinfo(string wer)
{
    mixed *r = db_query("SELECT last_time FROM userinfo WHERE wer = ?",wer);
    return (sizeof(r) > 0);
}

private int check_status(int st)
{
    switch (st)
    {
    case UMFRAGE_S_NEU:
    case UMFRAGE_S_STANDARD:
    case UMFRAGE_S_BEREIT:
    case UMFRAGE_S_AKTIV:
    case UMFRAGE_S_OFFEN:
    case UMFRAGE_S_BEENDET:
    case UMFRAGE_S_ABGELEHNT:
    case UMFRAGE_S_ARCHIVIERT:
        return 1;
    }
    return 0;
}

private int check_u_id(int u_id, int* valid_status)
{
    mixed * result = db_query("SELECT status FROM umfragen WHERE u_id = ?",u_id);
    if (query_db_error())
        return 0;
    int st = get_one_int(result);
    return (!pointerp(valid_status) && st > 0)
           || (member(valid_status,st)!=-1);
}

int add_umfrage(string frage, string ersteller, int st,
        int i_id, int pantheon)
{
    if (!check_security() || !check_status(st) || !stringp(frage)
        ||!stringp(ersteller) || !find_player(ersteller) || i_id < 0
        || pantheon < 0 || pantheon > 1)
    {
        return 0;
    }
    int u_id;
    mixed * result = 
        db_query("SELECT u_id FROM umfragen WHERE status = 0 LIMIT 1");
    if (sizeof(result))
    {
        u_id = get_one_int(result);
        if (u_id <= 0) 
            return 0;
        db_query("UPDATE umfragen "
            "(SET frage = ?, ersteller = ?, status = ?, i_id = ?, "
            "pantheon = ? WHERE u_id = ? ",
            frage,ersteller,st,i_id,pantheon,u_id);
    }
    else
    {
        u_id = increment_counter("u_id");
        if (u_id <= 0) 
            return 0;
        db_query("INSERT INTO umfragen "
            "(u_id,frage,ersteller,status,i_id,pantheon) "
            "VALUES (?,?,?,?,?,?)",u_id,frage,ersteller,st,i_id,pantheon);
    }
    if (query_db_error()) 
        return 0;
    return u_id;
}

int add_antwort(int u_id, string antwort)
{
    if (!check_security() || !stringp(antwort))
    {
        return 0;
    }
    if (!check_u_id(u_id, ({UMFRAGE_S_NEU, 
                            UMFRAGE_S_STANDARD, 
                            UMFRAGE_S_BEREIT,
                            }) ) )
    {
        return 0;
    }
    int a_id = increment_counter("a_id");
    if (a_id <= 0) 
        return 0;
    db_query("INSERT INTO antworten "
        "(u_id,a_id,antwort) "
        "VALUES (?,?,?)",u_id,a_id,antwort);
    if (query_db_error()) 
        return 0;
    return a_id;
}

int copy_antworten(int from_u_id, int to_u_id)
{
    if (!check_security())
    {
        return 0;
    }
    if (!check_u_id(from_u_id, 0) || !check_u_id(to_u_id, ({
                            UMFRAGE_S_NEU, 
                            })))
    {
        return 0;
    }
    // nicht wenn schon antworten existieren
    mixed * result = db_query("SELECT a_id FROM antworten WHERE u_id = ?", 
            to_u_id);
    if (query_db_error() || sizeof(result))  
        return 0;
    // nicht wenn keine Antworten bei der quelle existieren
    result = db_query("SELECT antwort FROM antworten WHERE u_id = ?", 
            from_u_id);
    if (query_db_error() || !sizeof(result))  
        return 0;
    //PDBG(sprintf("copy_antworten %Q %Q",result,
    //        filter(result, (: add_antwort($2, $1[0]) :), to_u_id) ));
    return 1;
}

int hat_gewaehlt(int u_id, string wer)
{
    if (!check_security() || !stringp(wer) || !player_exists(wer))
    {
        return 0;
    }
    if (!check_u_id(u_id, 0 ) )
    {
        return 0;
    }
    mixed * result = 
        db_query("SELECT a_id FROM erhebung WHERE u_id = ? AND wer = ?",
            u_id,wer);
    if (sizeof(result)==1)
    {
        return get_one_int(result);
    }
    return 0;
}

int add_erhebung(int a_id, string wer, int pantheon)
{
    int e_id, delete_flag;
    if (!check_security() || !stringp(wer) || !find_player(wer)
            || pantheon < 0 || pantheon > 1)
    {
        return 0;
    }
    mixed r1 = db_query("SELECT u_id FROM antworten WHERE a_id = ?",a_id);
    int u_id = get_one_int(r1);
    if (!check_u_id(u_id, ({UMFRAGE_S_AKTIV }) ) )
    {
        return 0;
    }
    // vorherige Auswahl loeschen:
    delete_flag = (a_id == hat_gewaehlt(u_id,wer));
    db_query("UPDATE erhebung SET u_id = 0, wer = '', a_id = 0, pantheon = 0 "
             "WHERE u_id = ? AND wer = ?", u_id, wer);
    if (delete_flag)
    {
        return a_id;
    }
    // freie e_id suchen
    mixed * result = 
        db_query("SELECT e_id FROM erhebung WHERE u_id = 0 LIMiT 1");
    if (sizeof(result))
    {
        e_id = get_one_int(result);
        if (e_id <= 0) 
            return 0;
        db_query("DELETE FROM erhebung WHERE e_id = ?",e_id); // freigeben
    }
    else
    {
        e_id = increment_counter("e_id"); // neue e_id
        if (e_id <= 0) 
            return 0;
    }
    db_query("INSERT INTO erhebung "
        "(u_id,a_id,e_id,wer,pantheon) "
        "VALUES (?,?,?,?,?)",u_id,a_id,e_id,wer,pantheon); // neu einfuegen
    if (query_db_error()) 
        return 0;
    return a_id;
}

private int get_erhebung_pro_antwort(int a_id)
{
    mixed r = db_query("SELECT COUNT(e_id) FROM erhebung WHERE a_id = ?",
            a_id);
    if (query_db_error() || r == 0) 
        return 0;
    return get_one_int(r);
}

private string get_erhebung_pro_umfrage(int u_id)
{
    mixed r = db_query("SELECT a_id FROM antworten WHERE u_id = ?",u_id);
    string result = "";
    if (query_db_error() || r == 0) 
        return "";
    for (int i=0;i<sizeof(r);i++)
    {
        result += sprintf("%03d.",get_erhebung_pro_antwort(r[i][0]));
    }
    return strlen(result)?result[..<2]: "";
}

mixed * get_erhebung_alle_ideen(mapping options)
{
    string q;
    if (!check_security())
    {
        return 0;
    }
    options ||= ([]);
    q = "SELECT u.u_id, u.i_id, i.titel FROM umfragen u, ideen i ";
    q+= "WHERE u.i_id = i.i_id AND u.i_id > 0 ";
    q+= "AND u.status >= ? AND u.status <= ? ";
    if (options[UI_OPT_PANTHEON] == 0)
    {
        q+= "AND u.pantheon = 0 AND i.pantheon = 0 ";
    } else if (options[UI_OPT_PANTHEON] == -1)
    {
        q+= "AND (u.pantheon = 1 OR i.pantheon = 1) ";
    }
    mixed r = db_query(q, UMFRAGE_S_AKTIV, UMFRAGE_S_OFFEN);
    if (query_db_error() || r == 0 || !sizeof(r)) 
        return 0;
    mixed * result = map(r, (: 
        ({ get_erhebung_pro_umfrage($1[0]),$1[0],$1[1],$1[2] }) :) );
    return sort_array(result, (: $1[0] < $2[0] :) );
}

string * get_auswertung_prozent(int u_id)
{
    if (!check_security())
    {
        return 0;
    }
    if (!check_u_id(u_id, ({UMFRAGE_S_AKTIV,UMFRAGE_S_BEENDET,
            UMFRAGE_S_ARCHIVIERT }) ) )
    {
        return 0;
    }
    mixed * r1 = db_query(
        "SELECT COUNT(e_id) FROM erhebung WHERE u_id = ?",u_id);
    int total = get_one_int(r1);
    if (total==0) 
    {
        return ({ "Keine Stimmen." });
    }
    mixed * r2 = db_query(
        "SELECT COUNT(e.e_id), a.a_id, a.antwort "
        "FROM antworten a LEFT JOIN erhebung e "
        "WHERE e.a_id=a.a_id AND a.u_id = ? "
        "GROUP BY a.a_id, a.antwort ",
        u_id);
    if (query_db_error()) 
        return ({ query_db_error() });
    return map(r2, (: sprintf("%s=%.1f",$1[2],(100.0*$1[0])/(1.0*$2)) :), 
                total );
}

int add_idee(string titel, string inhalt, string ersteller, int st, 
             int pantheon)
{
    if (!check_security() || !check_status(st) || !stringp(titel)
        ||!stringp(inhalt) || pantheon < 0 || pantheon > 1
        ||!stringp(ersteller) || !find_player(ersteller) )
    {
        return 0;
    }
    int i_id;
    mixed * result = 
        db_query("SELECT i_id FROM ideen WHERE status = 0 LIMIT 1");
    if (sizeof(result))
    {
        i_id = get_one_int(result);
        if (i_id <= 0) 
            return 0;
        db_query("UPDATE ideen "
            "(SET titel = ?, inhalt = ?, ersteller = ?, "
            "status = ?, pantheon = ? "
            "WHERE i_id = ? ", titel, inhalt, ersteller, st, pantheon, i_id);
    }
    else
    {
        i_id = increment_counter("i_id");
        if (i_id <= 0) 
            return 0;
        db_query("INSERT INTO ideen "
            "(i_id,titel,inhalt,ersteller,status,pantheon) "
            "VALUES (?,?,?,?,?,?)",i_id,titel,inhalt,ersteller,st,pantheon);
    }
    if (query_db_error()) 
        return 0;
    return i_id;
}

int aktiviere_idee_und_umfrage(int i_id, int u_id)
{
    if (!check_security())
    {
        return 0;
    }
    // TODO transaktionskontrolle und fehlerbehandlung.
    db_query("UPDATE umfragen SET status = ? WHERE u_id = ? AND i_id = ?",
                UMFRAGE_S_BEREIT, u_id, i_id);
    db_query("UPDATE ideen SET status = ? WHERE i_id = ?",
                UMFRAGE_S_BEREIT, i_id);
    return 1;
}

int aktualisiere_ideen_status(int i_id, int st)
{
    if (!check_security() || !check_status(st))
    {
        return 0;
    }
    db_query("UPDATE ideen SET status = ? WHERE i_id = ?",
                st, i_id);
    return 1;
}

int aktualisiere_umfragen_status(int u_id, int st)
{
    if (!check_security() || !check_status(st))
    {
        return 0;
    }
    db_query("UPDATE umfragen SET status = ? WHERE u_id = ?",
                st, u_id);
    return 1;
}

mixed get_ideen_diskussion(mapping options)
{
    mixed * r1, *r2;
    string q;
    int last_i_id,i_id, u_id, i, *st_arr;
    if (!check_security())
    {
        return 0;
    }
    options ||= ([]);
    if (options[UI_OPT_COUNTALL])
    {
        q = "SELECT COUNT(*) ";
    }
    else
    {
        q = "SELECT i.i_id, d.d_id, i.titel, d.pantheon ";
    }
    q+= "FROM ideen i LEFT JOIN diskussion d ";
    if (intp(i_id = options[UI_OPT_I_ID]) && i_id > 0)
    {
        if (options[UI_OPT_PANTHEON] == 0)
        {
            q+= "ON (i.i_id = d.id AND d.was ='ideen' AND d.pantheon = 0 "
                    "AND i.status <= d.status) ";
            q+= "WHERE i.i_id = "+i_id+" ";
        }
        else
        {
            q+= "WHERE d.id = i.i_id AND d.was ='ideen' "; 
            q+= "AND i.i_id = "+i_id+" ";
        }
    }
    else
    {
        return 0; // Falscher Aufruf...
    }
    if (pointerp(options[UI_OPT_STATUS]) 
        && sizeof(st_arr =options[UI_OPT_STATUS]) )
    {
        q+= "AND i.status IN (";
         for (i=0; i< sizeof(st_arr); i++)
         {
            if (i>0) q+=",";
            q+=st_arr[i];
         }
         q+= ") ";
    }
    if (pointerp(options[UI_OPT_STATUS]) 
        && sizeof(st_arr =options[UI_OPT_STATUS]) )
    {
        q+= "AND d.status IN (";
         for (i=0; i< sizeof(st_arr); i++)
         {
            if (i>0) q+=",";
            q+=st_arr[i];
         }
         q+= ") ";
    }
    if (stringp(options[UI_OPT_SUCHFILTER]))
    {
        q+= "AND (i.titel LIKE '%"+options[UI_OPT_SUCHFILTER]+"%' ";
        q+= "OR i.inhalt LIKE '%"+options[UI_OPT_SUCHFILTER]+"%') ";
    }
    if (stringp(options[UI_OPT_ERSTELLER]))
    {
        q+= "AND (u.ersteller = '"+options[UI_OPT_ERSTELLER];
        q+= "' OR i.ersteller = '"+options[UI_OPT_ERSTELLER]+"') ";
    }
    if (!options[UI_OPT_COUNTALL])
    {
        // sortieren nach erhebung, titel,
        q+= "ORDER BY i.i_id, d.d_id ";
        if (options[UI_OPT_LIMIT] > 0)
        {
            q+= "LIMIT "+options[UI_OPT_LIMIT]+" ";
        }
        if (options[UI_OPT_OFFSET] > 0)
        {
            q+= "OFFSET "+options[UI_OPT_OFFSET]+" ";
        }
    }
    r1 = db_query(q);
    //PDBG(sprintf("get_ideen_diskussion: %s => %Q",q,r1));
    if (query_db_error()) 
        return 0;
    if (options[UI_OPT_COUNTALL])
    {
        return get_one_int(r1);
    }
    r2 = ({ });
    foreach( mixed line : r1) // i.i_id, d.d_id, i.titel, d.pantheon
    {
        if (line[1] > 0)
        {
            r2 += ({ ({ "Diskussion", line[0], 
                         (line[3]?"Pantheon":"Spieler")
                         +(ist_diskussion_ungelesen(line[1], TP_RN)?
                            " ungelesen":""),
                         line[1] }) });
                                          // U,i_id,p/s,d_id
        }
    }
    //PDBG(sprintf("get_ideen_diskussion: ===> %Q",r2));
    return r2;
}

mixed get_ideen_wahl(mapping options)
{
    mixed * r1, *r2;
    string q;
    int last_i_id,i_id, u_id, i, *st_arr;
    if (!check_security())
    {
        return 0;
    }
    options ||= ([]);
    if (options[UI_OPT_COUNTALL])
    {
        q = "SELECT COUNT(*) ";
    }
    else
    {
        q = "SELECT i.i_id, u.u_id, i.titel, u.frage ";
    }
    q+= "FROM ideen i LEFT JOIN umfragen u ";
    if (intp(i_id = options[UI_OPT_I_ID]) && i_id > 0)
    {
        if (options[UI_OPT_PANTHEON] == 0)
        {
            q+= "ON (u.i_id = i.i_id AND u.pantheon = 0) ";
            q+= "WHERE i.i_id = "+i_id+" ";
        }
        else
        {
            q+= "WHERE u.i_id = i.i_id "; 
            q+= "AND i.i_id = "+i_id+" ";
        }
    }
    else if (intp(u_id = options[UI_OPT_U_ID]) && u_id > 0)
    {
        q+= "WHERE u.i_id = i.i_id "; 
        q+= "AND u.u_id = "+u_id+" ";
        if (options[UI_OPT_PANTHEON] == 0)
        {
            q+= "AND u.pantheon = 0 AND i.pantheon = 0 ";
        }
    }
    else
    {
        return 0; // Falscher Aufruf...
    }
    if (pointerp(options[UI_OPT_STATUS]) 
        && sizeof(st_arr =options[UI_OPT_STATUS]) )
    {
        q+= "AND i.status IN (";
         for (i=0; i< sizeof(st_arr); i++)
         {
            if (i>0) q+=",";
            q+=st_arr[i];
         }
         q+= ") ";
    }
    if (pointerp(options[UI_OPT_STATUS]) 
        && sizeof(st_arr =options[UI_OPT_STATUS]) )
    {
        q+= "AND u.status IN (";
         for (i=0; i< sizeof(st_arr); i++)
         {
            if (i>0) q+=",";
            q+=st_arr[i];
         }
         q+= ") ";
    }
    if (stringp(options[UI_OPT_SUCHFILTER]))
    {
        q+= "AND (i.titel LIKE '%"+options[UI_OPT_SUCHFILTER]+"%' ";
        q+= "OR i.inhalt LIKE '%"+options[UI_OPT_SUCHFILTER]+"%') ";
    }
    if (stringp(options[UI_OPT_ERSTELLER]))
    {
        q+= "AND (u.ersteller = '"+options[UI_OPT_ERSTELLER];
        q+= "' OR i.ersteller = '"+options[UI_OPT_ERSTELLER]+"') ";
    }
    if (!options[UI_OPT_COUNTALL])
    {
        // sortieren nach erhebung, titel,
        q+= "ORDER BY u.i_id, u.u_id ";
        if (options[UI_OPT_LIMIT] > 0)
        {
            q+= "LIMIT "+options[UI_OPT_LIMIT]+" ";
        }
        if (options[UI_OPT_OFFSET] > 0)
        {
            q+= "OFFSET "+options[UI_OPT_OFFSET]+" ";
        }
    }
    r1 = db_query(q);
    //PDBG(sprintf("get_ideen_wahl: %s => %Q",q,r1));
    if (query_db_error()) 
        return 0;
    if (options[UI_OPT_COUNTALL])
    {
        r2 = get_ideen_diskussion(options);
        return get_one_int(r1) + pointerp(r2) ? sizeof(r2) : 0;
    }
    r2 = ({ });
    last_i_id = 0;
    foreach( mixed line : r1) // u.i_id, u.u_id, i.titel, u.frage
    {
        if (last_i_id != line[0])
        {
            last_i_id = line[0];
            r2 += ({ ({ "Idee", line[0], line[2], 0 }) });  // I,i_id,titel,0
        }
        if (line[1] > 0)
        {
            r2 += ({ ({ "Umfrage", line[0], line[3], line[1] }) });
                                                          // U,i_id,frage,u_id
        }
    }
    r1 = get_ideen_diskussion(options);
    if (pointerp(r1)&&sizeof(r1))
    {
        r2 += r1;
    }
    //PDBG(sprintf("get_ideen_wahl: ===> %Q",r2));
    return r2;
}

int toggle_ignore_idee(int i_id, string wer)
{
    mixed * r1;
    string q;
    if (!check_security())
    {
        return 0;
    }
    q = "SELECT COUNT(*) FROM userignore ";
    q+= "WHERE wer = ? AND id = ? AND was ='ideen' ";
    r1 = db_query(q,wer,i_id);
    if (get_one_int(r1)>0)
    {
        q = "DELETE FROM userignore WHERE wer = ? AND id = ? ";
        q+= "AND was = 'ideen' ";
        db_query(q,wer,i_id);
        return -1;
    }
    else
    {
        q = "INSERT INTO userignore (wer,was,id) VALUES (?,'ideen',?) ";
        db_query(q,wer,i_id);
        return 1;
    }
}

private string get_ideen_wahl_query(mapping options, string prefix)
{
    string q, *st_arr;
    int i;
    q = prefix;
    if (stringp(options[UI_OPT_ERSTELLER]))
    {
        q+= "AND i.ersteller = '"+options[UI_OPT_ERSTELLER]+"' ";
    }
    else if (options[UI_OPT_PANTHEON] == 0)
    {
        q+= "AND i.pantheon = 0 ";
    }
    if (options[UI_OPT_OHNE_DISKUSSION] == 1)
    {
        q+= "AND i.i_id NOT IN (SELECT DISTINCT id FROM diskussion ";
        q+= "WHERE was = 'ideen') ";
    }
    else if (options[UI_OPT_DISKUSSION] == 1)
    {
        q+= "AND i.i_id IN (SELECT DISTINCT id FROM diskussion ";
        q+= "WHERE was = 'ideen') ";
    }
    if (options[UI_OPT_IGNORELIST] == 0)
    {
        q+= "AND i.i_id NOT IN (SELECT DISTINCT id FROM userignore ";
        q+= "WHERE was = 'ideen' AND wer = '"+TP_RN+"') ";        
    }
    else if (options[UI_OPT_IGNORELIST] == 2)
    {
        q+= "AND i.i_id IN (SELECT DISTINCT id FROM userignore ";
        q+= "WHERE was = 'ideen' AND wer = '"+TP_RN+"') ";        
    }
    if (options[UI_OPT_UMFRAGE_OFFEN] == 1)
    {
        q+= "AND i.i_id IN (SELECT i_id FROM umfragen ";
        q+= "WHERE u_id NOT IN (SELECT U_ID FROM erhebung ";
        q+= "WHERE wer = '"+TP_RN+"')) ";
    }
    if (stringp(options[UI_OPT_SUCHFILTER]))
    {
        q+= "AND (i.titel LIKE '%"+options[UI_OPT_SUCHFILTER]+"%' ";
        q+= "OR i.inhalt LIKE '%"+options[UI_OPT_SUCHFILTER]+"%') ";
    }
    if (pointerp(options[UI_OPT_STATUS]) 
        && sizeof(st_arr =options[UI_OPT_STATUS]) )
    {
        q+= "AND i.status IN (";
         for (i=0; i< sizeof(st_arr); i++)
         {
            if (i>0) q+=",";
            q+=st_arr[i];
         }
         q+= ") ";
    }
    if (stringp(options[UI_OPT_I_ID]))
    {
        q+= "AND i.i_id = "+options[UI_OPT_I_ID]+" ";
    }
    return q;
}

mixed get_ideen_wahl_uebersicht(mapping options)
{
    mixed * r1, *r2;
    string q;
    int last_i_id, * st_arr, i;
    if (!check_security())
    {
        return 0;
    }
    options ||= ([]);
    if (options[UI_OPT_COUNTALL])
    {
        q = "SELECT COUNT(*) ";
    }
    else
    {
        q = "SELECT i.i_id, i.titel ";
    }
    q+= "FROM ideen i ";
    q+= "WHERE 1 ";
    q = get_ideen_wahl_query(options, q);
    if (!options[UI_OPT_COUNTALL])
    {
        // sortieren nach erhebung, titel,
        q+= "ORDER BY i.i_id ";
        if (options[UI_OPT_LIMIT] > 0)
        {
            q+= "LIMIT "+options[UI_OPT_LIMIT]+" ";
        }
        if (options[UI_OPT_OFFSET] > 0)
        {
            q+= "OFFSET "+options[UI_OPT_OFFSET]+" ";
        }
    }
    r1 = db_query(q);
    //PDBG(sprintf("get_ideen_wahl_uebersicht: %s => %Q",q,r1));
    if (query_db_error()) 
        return 0;
    if (options[UI_OPT_COUNTALL])
    {
        return get_one_int(r1);
    }
    
    return r1;
}

