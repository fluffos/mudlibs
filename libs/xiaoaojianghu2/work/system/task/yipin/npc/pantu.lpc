// pantu.c 一品堂叛徒 ( 用于 task )

// by lnwm 97-11-26

inherit NPC;

string *first_id_random = ({
  "zhang", "li", "wang", "zhao", "yun", "ouyang", "quan", "cheng", "he", "jiang", "xu", "ye",
  "yang", "zhao", "lin"
});

string *last_id_random = ({
  "tian", "yiliang", "hai", "shixue", "qian", "gu", "yuan", "ke",
  "bie", "xue", "lang", "yin", "guan", "bing", "chu", "dan", "fu", "jing",
  "bing", "bao", "tianci", "heizi", "jing", "peng", "qi", "shunzi", "fugui", "yi"
});

string get_cfirst(string first_id);
string get_clast(string last_id);

void create() {
  string first_id, last_id, id, name;

  first_id = first_id_random[random(sizeof(first_id_random))];
  last_id = last_id_random[random(sizeof(last_id_random))];

  id = first_id + " " + last_id;

  name = get_cfirst(first_id) + get_clast(last_id);

  set_name(name, ({ id, first_id }));
  set("gender", "男性");
  set("age", 20 + random(30));
  set("kee", 400 + random(300));
  set("max_kee", 400 + random(300));
  set("eff_kee", 400 + random(300));
  set("sen", 400 + random(300));
  set("max_sen", 400 + random(300));
  set("eff_sen", 400 + random(300));

  set("marks/normal", 1);
  set("long",
    "这是一名看起来平平常常的普通人，没有什么特殊的地方。\n");
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("combat_exp", 100000 + random(400000));
  set("social_exp", 100000 + random(400000));
  set("attitude", "friendly");
  setup();
  carry_object(CLONE_DIR + "wear/cloth/cloth1")->wear();
  set("possitive_score", 100 - random(400));
}

string get_cfirst(string first_id) {
  string cfirst;

  switch (first_id) {
    case "he": cfirst = "贺"; break;
    case "jiang": cfirst = "蒋"; break;
    case "xu": cfirst = "徐"; break;
    case "ye": cfirst = "叶"; break;
    case "yang": cfirst = "杨"; break;
    case "zhao": cfirst = "赵"; break;
    case "lin": cfirst = "林"; break;
    case "zhang": cfirst = "张"; break;
    case "li": cfirst = "李"; break;
    case "wang": cfirst = "王"; break;
    case "ouyang": cfirst = "欧阳"; break;
    case "zhao": cfirst = "赵"; break;
    case "yun": cfirst = "云"; break;
    case "quan": cfirst = "全"; break;
    case "cheng": cfirst = "成"; break;
    default: cfirst = "云"; break;
  }
  return cfirst;
}

string get_clast(string last_id) {
  string clast;

  switch (last_id) {
    case "tian": clast = "天"; break;
    case "yiliang": clast = "一亮"; break;
    case "hai": clast = "海"; break;
    case "shixue": clast = "石雪"; break;
    case "qian": clast = "钱"; break;
    case "gu": clast = "古"; break;
    case "yuan": clast = "远"; break;
    case "ke": clast = "坷"; break;
    case "bie": clast = "别"; break;
    case "xue": clast = "学"; break;
    case "lang": clast = "浪"; break;
    case "yin": clast = "胤"; break;
    case "guan": clast = "纶"; break;
    case "bing": clast = "秉"; break;
    case "chu": clast = "楚"; break;
    case "dan": clast = "丹"; break;
    case "fu": clast = "辅"; break;
    case "jing": clast = "荆"; break;
    case "bing": clast = "兵"; break;
    case "bao": clast = "豹"; break;
    case "tianci": clast = "天赐"; break;
    case "heizi": clast = "黑子"; break;
    case "jing": clast = "靖"; break;
    case "peng": clast = "鹏"; break;
    case "qi": clast = "祁"; break;
    case "shunzi": clast = "顺子"; break;
    case "fugui": clast = "富贵"; break;
    case "yi": clast = "毅"; break;
    default: clast = "石头"; break;
  }
  return clast;
}

int refuse_killing(object me) {
  //here is a mistake, I add sth to change it...--lala
  if (!this_object()->query("marks/normal"))
    return 0;
  this_object()->delete("marks/normal");
  message_vision(@LONG
$N楞了一楞。
忽然眼露杀机，然后嗖地从身后抽出一把明晃晃的钢刀。
LONG
    , this_object());
  this_object()->carry_object("/clone/weapon/blade/gangdao_t")->wield();
  return 0;
}
