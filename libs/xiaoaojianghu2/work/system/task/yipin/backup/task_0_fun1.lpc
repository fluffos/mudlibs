// test task 1.

private string get_npc();

inherit GROUP_TASK;

void create()
{
    string ob;
    ob = get_npc();
    group_task::create();
    SetExistenceTime( 50 ); //完成时间
//    SetTermType( "long" ); //短期或长期
    SetKeyName( "kill lala" ); //索引
    SetGroupName( "yipin" );  //隶属组织
    SetLevel( 0 );   //task等级(申请的等级)
    SetAct( "BeginningAct", ([
        "time"      : 0,  //开始时间条件 if 0 no 条件
                          //否则是X月X日被触发
        "message"   : "一个声音传来。你去杀了木灵子。", //message
        "character" : ob,
        "follow"    : 0, // 0 || 1 是否是开始   
    ]) );
    SetAct( "SuccessAct", ([
        "message"   : "除去木灵子。好！\n\n", //message
        "bonus"     : 1024,                  //也可以是string
        "follow"    : "kill trill next 1",   //可以给出下一个的keyname
    ]) );
    SetAct( "FailAct", ([
        "message"   : "连木灵子都杀不了。呵呵。苯.\n",
        "bonus"     : -39,
    ]) );
    SetTaskEvent( ([
        "verb"      : "kill",
        "event"     : "kill " + ob->query("id"), //give kill 
                                                     //send buy learn
    ]) );
}

void heart_beat()
{
    group_task::heart_beat();
    // 如果需要可以扩展heart_beat()，也可以完全重载。
}

int CanBegin( object ppl )
{
    // 自己扩展。                        // 
    return group_task::CanBegin( ppl );  //只对本task有效
}

int CanEnd( object ppl ) 
{ 
    // 可以自己扩展。                    //return 0 则不结束
    return group_task::CanEnd( ppl ); 
}

void PerformBegin( object ppl ) 
{
    object ob;

    ob = new( "/clone/misc/bag");
    ob->move( ppl );
    message_vision("如果你需要易容药膏。可持此令去领取。\n", ppl );
    return;
}  //在message完了以后结束

void PerformSuccess( object ppl ) {}

void PerformFail( object ppl ) 
{
    message_vision("连这点小事都完不成。去死吧！\n", ppl );
    return;
}

private string get_npc()
{
    return "/d/city/yangzhou/npc/xiaoer1";
}
