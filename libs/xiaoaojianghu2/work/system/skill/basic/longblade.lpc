//   longblade.c.马上长刀

// 基本刀法的一种



inherit SKILL;

mapping *action = ({
  ([ "action": "$N紧握手中的$w，大喝一声，向$n$l砍去......",
    "lian": "$N把手中$w舞的密不透风，也看不出是什么招式......",
    "jibie": 5,
    "sen": 1,
    "damage": 50,
    "wound": 40,
    "damage_type": "砍伤" ]),
  ([ "action": "$N手握$w，用力朝$n$l砍去......",
    "lian": "$N手握$w，横削直劈，颇为用力......",
    "jibie": 10,
    "sen": 1,
    "damage": 50,
    "wound": 45,
    "damage_type": "砍伤" ]),
  ([ "action": "$N拨马躲过$n的攻势，刀峰一转，斜劈下来......",
    "lian": "$N使出刀峰一抖，直劈前方......",
    "jibie": 20,
    "sen": 1,
    "damage": 70,
    "wound": 50,
    "damage_type": "割伤" ]),
  ([ "action": "$N刀把一转，$w横削$n$l......",
    "lian": "$N纵刀横削，呼呼有声......",
    "jibie": 30,
    "sen": 1,
    "damage": 75,
    "wound": 65,
    "damage_type": "砍伤" ]),
  ([ "action": "只听$N大喝一声，反手一招「立马关公」，手中$w舞作一团，向$n的$l削去......",
    "lian": "$N反手一招「立马关公」...",
    "jibie": 38,
    "sen": 1,
    "damage": 80,
    "wound": 65,
    "damage_type": "割伤" ]),
  ([ "action": "$N俯身向$n从下往上挑起......",
    "lian": "$N俯身低头，刀光霍霍......",
    "jibie": 50,
    "limb": "腿上",
    "sen": 1,
    "damage": 90,
    "damage_type": "割伤" ]),
  ([ "action": "又见$N一拨马头，马儿人立起来，$N一式「刀劈乾坤」，向$n$l一劈！",
    "lian": "$N一式「刀劈乾坤」$w凌空一劈......",
    "jibie": 60,
    "sen": 1,
    "damage": 80,
    "wound": 70,
    "damage_type": "砍伤" ]),
  ([ "action": "$N掉转马头，拨刀把，刀峰斜左，飞削$n$l......",
    "lian": "$N刀峰斜左，飞削前方......",
    "jibie": 70,
    "sen": 1,
    "damage": 95,
    "wound": 70,
    "damage_type": "砍伤" ]),
});

string *parry_msg = ({
  "$p使出一招「横刀立马」，手中的$v架开了$P的$w。\n",
  "$p立刀横拦，将$N的$w「当」的一声挡住了。\n",
  "$n使出一招「围魏救赵」，手中的$v直攻$N$l，化解了$P的攻势\n",
});

string *unarmed_parry_msg = ({
  "$p将$v一阵乱舞，逼得$P不能近身。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;
  if (!me->query_temp_marks("is_riding"))
    return notify_fail("马上长刀必须骑在马上才能练。\n");
  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "long_blade")
    return notify_fail("你必须先找一把长刀才能练刀法。\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() { return "long"; }
string query_weapon_type() { return "long_blade"; }

// 返回这路武功的等级, 第十等返回 1, 第一等返回 10.
int query_dengji() { return 4; }

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 50; }


int query_parry_ratio() { return 50; }
