
#include <ansi.h>

int exert(object me, object target, int amount)
{
 
    int ratio = 10;

    if( me->is_fighting() )
        return notify_fail("战斗中运功？找死吗？\n");
    if( !amount ) amount=50;
        if( me->query("force") < amount )
                return notify_fail("你的真气不够。\n");
        if( me->query("max_force") < 2*amount )
                return notify_fail("你的内功不够深厚，无法运用那么多真气。\n");
    
    if( time() - me->query_temp("lnwm/done_heal") < 
                    40 - me->query_jibie("duanshi-xinfa")/5 )
        return notify_fail("你刚刚曾运气疗伤，现在真气尚未凝聚。\n");//lnwm
      
    if( target == me )
        {
        if( me->query_jibie("duanshi-xinfa") < 50 )
                    return notify_fail("你的段氏心法等级不够，无法运气。\n");
            if( target->query("sen") == target->query("max_sen") )
            return notify_fail("你没有受到内伤。\n");
            if( target->query("eff_kee") < target->query("max_kee") / 4 )
                    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
            if( me->query_jibie("yiyang-zhi") > 80 )
            {
                ratio += ( me->query_jibie("yiyang-zhi") - 80 )/10;
                message_vision(GRN"$N伸出右手食中二指，抵在自己的丹田之上，催动内力开始运气恢复。\n"NOR,me);
            }
            else
                message_vision(YEL"$N盘膝坐下，掌心朝天，开始运气恢复。\n"NOR, me);
                me->receive_curing("kee", 1 );
    }
        else
        {
        return 0;
    }
      me->add("force", -amount);
        me->add("gin",amount*2);
        me->add("sen",amount*2);
        me->set_temp("lnwm/done_heal",time() );
        message_vision(HIY"$N运气恢复，觉得浑身充满活力。\n"NOR, target);
  return 1;
}
