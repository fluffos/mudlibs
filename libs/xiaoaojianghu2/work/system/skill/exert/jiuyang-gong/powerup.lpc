// jiuyang-gong/powerup.c writen by tea 10.15.98

#include <ansi.h>
int powerup(object me);
int exert(object me,string arg)
{

    if(me->query_temp("powerup"))
    { me->delete_temp("powerup");
      me->delete_temp("force_factor");    
    message_vision(HIY"$N双臂外推，然后划弧内收，收敛了护体真气。\n"NOR, me);
    return 1;
      }  
    if( me->query_jibie("jiuyang-gong") < 180 )
                        return notify_fail("你的少林九阳功等级不够，无法施展九阳功的威力。\n");
    if( me->query("force") < 4000 )
                return notify_fail("你的内力不够浑厚。\n");    
    me->add("force",-1000);
    me->set_temp("force_factor",(int)me->query("force_factor")*11/10);	    
    message_vision(HIC"$N爆喝一声，身体微蹲，双臂一张，浑厚的九阳神功游走全身。\n"NOR, me);
    me->set_temp("powerup",1);
    call_out("powerup",5,me);
    return 1;
}
int powerup(object me)
{
    if(!me)
    return 1;
    if(me->query_temp("mask/dazuo")||!living(me)||me->is_busy())
    { me->delete_temp("powerup");
      me->delete_temp("force_factor");    
      message_vision(HIY"$N的护体真气消散了。\n"NOR, me);
      return 1;
      }   
       if (me->query_temp("powerup"))
        {
   	me->add("force",-me->query("force")/10);
        if(!random(2))
	message_vision(HIW "$N衣衫汩汩，浑厚的内力充斥了丈许空间！\n" NOR,me );
	if( me->query("force")<2000 ) 
	{
	me->delete_temp("powerup");	
        me->delete_temp("force_factor");	
	message_vision(HIG "$N内力消耗殆尽，停止了施展九阳神功。\n" NOR,me );	
	return 1;
        }	
        call_out("powerup",5,me); 
        }
        return 1;     

}