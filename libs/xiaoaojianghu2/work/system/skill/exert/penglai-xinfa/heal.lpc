#include <ansi.h>

int exert(object me, object target, int amount) {
  if (target != me) return notify_fail("你只能用内功疗自己的伤。\n");
  if (me->is_fighting())
    return notify_fail("战斗中运功疗伤？找死吗？\n");

  if (time() - me->query_temp("lnwm/done_heal") <
    20 - me->query_jibie("duanshi-xinfa") / 10)
    return notify_fail("你刚刚曾运气疗伤，现在真气尚未凝聚。\n");  //lnwm                

    if (!amount) amount = 200;
  if (me->query("force") < amount)
    return notify_fail("你的真气不够。\n");
  if (me->query("max_force") < 2 * amount)
    return notify_fail("你的内功不够深厚，无法运用那么多真气。\n");
  if (me->query_jibie("penglai-xinfa") < 60)
    return notify_fail("你的蓬莱心法等级不够，无法运气疗伤。\n");
  if (target->query("eff_kee") == target->query("max_kee"))
    return notify_fail("你没有受到内伤。\n");
  if (target->query("eff_kee") < target->query("max_kee") / 4)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
  message_vision(HIY "$N盘膝坐下，开始运功疗伤。\n" NOR, me);
  me->receive_curing("kee", amount * me->query_jibie("penglai-xinfa") / 240);
  /*    me->start_busy(5);
    call_out("heal_over", 10, me, amount);
    return 1;
}

void heal_over(object me, int amount)
{
*/
  me->add("force", -amount);
  me->add("gin", -amount / 6);
  me->add("sen", -amount / 6);
  me->set_temp("lnwm/done_heal", time());  //两次疗伤间必须有时间距离。lnwm990406
  message_vision(HIY "$N神色渐缓，脸上红润起来。\n" NOR, me);

  return 1;
}
