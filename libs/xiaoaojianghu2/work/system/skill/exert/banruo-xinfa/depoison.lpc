/* banruo-xinfa.c 
 * 般若心法的Exert--depoison
 * for xo lib @1.0
 * Created by Hydra at 1999/3/8
 */

#include <ansi.h>

int exert(object me, object target, int amount)
{
int cond;
 

    if( me->is_fighting() )
        return notify_fail("战斗中运功逼毒？找死吗？\n");
    if( !amount ) amount=300;
    if( me->query("force") < amount )
    {
        return notify_fail("你的真气不够。\n");
    }
    if( me->query("max_force") < 2*amount )
    {
        return notify_fail("你的内功不够深厚，恐怕无法逼出体内毒素。\n");
    }
    
    if( time() - me->query_temp("lnwm/done_depoison") <
                    50 - me->query_jibie("banruo-xinfa")/8 )
        return notify_fail("你刚刚曾运气逼毒，现在真气尚未凝聚。\n");//lnwm
        
    if( target == me )
    {
        if( me->query_jibie("banruo-xinfa") < 80 )
            return notify_fail("你的般若心法等级不够，不能逼毒。\n");
        if( target->query_condition("snake_poison") <= 0 )
            return notify_fail("你并没有中毒。\n");
        if( target->query("eff_kee") < target->query("max_kee") / 4 )
            return notify_fail("你已经受伤过重，再运真气恐怕毒发作更快！\n");
        message_vision(GRN"$N双手合十，微合双目，屏息运功。\n"NOR, me);
        cond = (int)(target->query_condition("snake_poison") - amount * me->query_jibie("banruo-xinfa")/2500);
        if ( cond <= 0)
        {
        	target->apply_condition("snake_poison",0);
        	message_vision(HIY"$N脸色红润，看起来毒素已经完全逼尽了。\n"NOR, target);        	
        }
        else
        {
        	target->apply_condition("snake_poison",cond);
        	message_vision(HIY"$N脸色由发黑转红，看起来好多了。\n"NOR, target);        	
        }
    }
    else
    {
        if( me->query_jibie("banruo-xinfa") < 100 )
            return notify_fail("你的般若心法等级不够，无法替别人逼毒。\n");
        if( target->is_fighting() )
            return notify_fail( gender_pronoun(target) + "现在战斗中，你无法给他运功逼毒。\n");
        if( target->query_condition("snake_poison") <= 0)
            return notify_fail(target->name()+"没有中毒。\n");
        if( me->query("eff_kee") < me->query("max_kee") / 2 )
            return notify_fail("你真气运走不畅，还是先给自己疗伤吧！\n");
        message_vision(HIY"$N盘膝坐下，双掌贴在$n的丹田，开始给$n运功逼毒。\n"NOR, me, target );
        cond = (int)(target->query_condition("snake_poison")-amount*me->query_jibie("banruo-xinfa")/5000);
        if ( cond <= 0 )
        {
        	target->apply_condition("snake_poison",0);
        	message_vision(HIY"$N脸色红润，看起来毒素已经完全逼尽了。\n"NOR, target);        	
		}
        else
        {
        	target->apply_condition("snake_poison",cond);
        	message_vision(HIY"$N脸色由发黑转红，看起来好多了。\n"NOR, target);        	
        }
//        target->start_busy(4);
//        target->disable_command("verb","你现在正在疗伤中。\n");   
    }

    me->add("force", -amount);
    me->add("gin",-amount/5);
    me->add("sen",-amount/5);
    me->set_temp("lnwm/done_depoison",time() );//两次疗伤间必须有时间距离。lnwm990406


        return 1;
}
