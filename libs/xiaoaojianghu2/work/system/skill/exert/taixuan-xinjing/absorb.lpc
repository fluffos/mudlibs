// jiuyang-gong/powerup.c writen by tea 10.15.98
#include <ansi.h>

int exert(object me, object target, int amount) {
  if (!me->is_fighting() || !target->is_fighting())
    return notify_fail("只能在战斗中吸取敌人的内力。\n");
  if (me->query("force") > me->query("max_force") * 2)
    return notify_fail("你现在内力浑厚,用不着吸别人的内力。\n");
  if (!userp(target))
    return notify_fail("此招只能对玩家试用。\n");
  if (time() - me->query_temp("locker/absorb") < 10)
    return notify_fail("你内力尚未凝聚，不能再吸取内力了。\n");
  if (!target || target == me)
    return notify_fail("你要吸取谁的内力?\n");
  if (me->query_jibie("taixuan-xinjing") < 200)
    return notify_fail("你的太玄心经等级不够，无法吸取内力。\n");
  amount = target->query("force") / 2;
  me->add("force", amount / 2);
  target->add("force", -amount);
  message_vision(HIM "$N正在运功吸$n的内力，太可怕了!\n" NOR, me, target);
  me->set_temp("locker/absorb", time());
  return 1;
}
