// file   :  cuixin-zhang.c
// attrib :  skill
// name   :  摧心掌(青城派武功，unarmed 2)
// write  :  xli
// date   :  1998.10
// include:
// 一上高城万里愁 蒹葭杨柳似汀洲 溪云初起日沉阁 山雨欲来风满楼
// 鸟下绿芜秦苑夕 蝉鸣黄叶汉宫秋 行人莫问当年事 故国东来渭水流
// 诗出：咸阳城西楼晚眺(许浑)
// 诗意：
//       一登上高高的城台便生出无边的悲愁，望见了芦苇丛生杨柳轻摆就象江南水乡的沙洲。
//       溪边飞来云朵太阳没入寺阁，山雨就要来临凉风吹满空阔的城楼。
//       暮色中秦都的故地杂草丛生鸟儿翻飞，秋光里当年汉代的宫殿黄叶满树蝉鸣枝头。
//       远行的人别去追寻那久远的往事了，可叹我东来这秦汉故地只见悠悠的渭水向东流。

#include <ansi.h>


inherit SKILL;

mapping *action = ({/*size = 8*/
    ([  "action": "$N身形一纵，一式"+GRN"「一上高城万里愁」"NOR+"，平地拔高三丈，双手罩向$n的头顶",
        "lian"  : "$N身形一纵，一式"+GRN"「一上高城万里愁」"NOR+"，平地拔高三丈，双手一合，向下罩去",
        "zhaoshi":GRN"「一上高城万里愁」"NOR,
        "jibie" :10,
        "limb"  :"头部",
        "sen"   :3,
        "damage":30,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N左腿斜斜滑出，闪至$n身侧，使出一招"+CYN"「蒹葭杨柳似汀洲」"NOR+"，掌风扑向$n",
        "lian"  : "$N左腿斜斜滑出，闪至一旁，使出一招"+CYN"「蒹葭杨柳似汀洲」"NOR+"，交替拍出数掌",
        "zhaoshi":CYN"「蒹葭杨柳似汀洲」"NOR,
        "jibie" :20,
        "limb"  :"右臂",
        "sen"   :3,
        "damage":35,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出"+HIR"「溪云初起日沉阁」"NOR+"，左臂作势一挡，右掌从$n双手之间穿过，击向$n当胸",
        "lian"  : "$N使出"+HIR"「溪云初起日沉阁」"NOR+"，左臂作势一挡，右掌向前击出",
        "zhaoshi":HIR"「溪云初起日沉阁」"NOR,
        "jibie" :30, 
        "limb"  :"前胸",
        "sen"   :3,
        "damage":40,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N身形忽然凝重，一招"+HIC"「山雨欲来风满楼」"NOR+"，双掌缓缓推出\n"+
                  "$n只觉掌风甚为厚重，心下暗自一惊，不敢怠慢",
        "lian"  : "$N身形忽然凝重，一招"+HIC"「山雨欲来风满楼」"NOR+"，双掌携带一股厚重的掌风，缓缓推出",
        "zhaoshi":HIC"「山雨欲来风满楼」"NOR,
        "jibie" :40, 
        "limb"  :"前胸",
        "sen"   :3,
        "damage":45,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N一式"+HIG"「鸟下绿芜秦苑夕」"NOR+"，脚走阴阳，双掌交替，翻出无数掌影，击向$n下盘",
        "lian"  : "$N一式"+HIG"「鸟下绿芜秦苑夕」"NOR+"，脚走阴阳，双掌交替，翻出无数掌影，向前拍出",
        "zhaoshi":HIG"「鸟下绿芜秦苑夕」"NOR,
        "jibie" :50,
        "limb"  :"小腹",
        "sen"   :3,
        "damage":50,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N口中长啸一声，一式"+HIK"「蝉鸣黄叶汉宫秋」"NOR+"，跃身向前，冲$n连拍数掌",
        "lian"  : "$N口中长啸一声，一式"+HIK"「蝉鸣黄叶汉宫秋」"NOR+"，跃身向前，连拍数掌",
        "zhaoshi":HIK"「蝉鸣黄叶汉宫秋」"NOR,
        "jibie" :60, 
        "limb"  :"前胸",
        "sen"   :3,
        "damage":55,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N移形换影，瞬间飘向$n背后，一式"+WHT"「行人莫问当年事」"NOR+"，右掌携风，推向$n后心",   
        "lian"  : "$N移形换影，瞬间飘出数尺，一式"+WHT"「行人莫问当年事」"NOR+"，右掌携风，向来路推出",
        "zhaoshi":WHT"「行人莫问当年事」"NOR,
        "jibie" :70,
        "limb"  :"后心",
        "sen"   :4,
        "damage":60,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使一式"+HIB"「故国东来渭水流」"NOR+"，面带哀色，身形围绕$n晃动，趁隙拍出",
        "lian"  : "$N使一式"+HIB"「故国东来渭水流」"NOR+"，面带哀色，身形围绕$n晃动，趁隙拍出",
        "zhaoshi":HIB"「故国东来渭水流」"NOR,
        "jibie" :80,  
        "sen"   :5,
        "damage":65,
        "damage_type" : "瘀伤"
    ]),
});

string *parry_msg = ({
    "$n不退不让，双臂一横，硬接$N的来势。\n",
    "$n左脚向后退出一步，以卸去$N的来势，同时双掌发力击出。\n",
    "$n脚下扎稳马步，双手置于胸前，缓缓推出，似要将$N攻势包围于两掌之间。\n",
    "$n袍袖一挥，闪身至二尺开外，堪堪躲过$n的进攻。\n",
});

string *unarmed_parry_msg = ({
    "$n不退不让，双臂一横，硬接$N的来势。\n",
    "$n左脚向后退出一步，以卸去$N的来势，同时双掌发力击出。\n",
    "$n脚下扎稳马步，双手置于胸前，缓缓推出，似要将$N攻势包围于两掌之间。\n",
    "$n袍袖一挥，闪身至二尺开外，堪堪躲过$n的进攻。\n",
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("拿着兵器怎么能练拳法呢？\n");
    if( me->query("max_force") < 120 )
        return notify_fail("摧心掌要配合一定的内力来练，你内力不足，强练会伤害身体的！\n");
    if( me->query_xiuwei_by_type("dodge") <60 ) 
        return notify_fail("练摧心掌需要一定的轻功修为，你轻功修为不够，不足以领悟其中奥妙！\n");
    if( me->query_jibie("songfeng-xinfa") <40 )
        return notify_fail("青城武功讲究根基扎实，你松风心法还未到一定火候，不能练习摧心掌！\n");
    return 1;
}

string query_xiuwei_type() { return "unarmed";}

string query_weapon_type() { return "unarmed";}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_dengji() { return 2;}

int query_youxiao_jibie() { return 8; }

int query_parry_ratio() { return 6; }

