// 松柏常青  竹影夜摇  踏雪寻梅

#include <ansi.h>


inherit SKILL;

mapping *action = ({/*size = 3*/
    ([  "action": "$N面色凝然，内力不停流转于全身，真气却汇聚于手中$w之上，正是一式「松柏常青」，\n"+
                  "$n只觉周围隐隐散发着寒气，而$w就在不经意间迅疾闪到了面前，心下不禁大骇。",
        "lian"  : "$N面色凝然，内力不停流转于全身，真气却汇聚于手中$w之上，正是一式「松柏常青」，\n"+
                  "周围隐隐散发着寒气，而$w就在不经意间迅疾闪出，一丝破空之声甚为骇人。",
        "zhaoshi":"「松柏常青」",
        "jibie" :10,
        "sen"   :6,
        "damage":75,
  	"wound":70,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N将一股真气凝聚于丹田之中，身形一晃，脚踏四象，衣袖带起阵阵轻风，一式「竹影夜摇」，\n"+
                  "$n眼前顿时幻出无数身影，其中夹杂着数道$w的寒光，竟似同时攻向自己周身各处要穴。",
        "lian"  : "$N将一股真气凝聚于丹田之中，身形一晃，脚踏四象，衣袖带起阵阵轻风，一式「竹影夜摇」，\n"+
                  "顿时幻出无数身影，其中夹杂着数道$w的寒光，竟似同时攻向前方各处。",
        "zhaoshi":"「竹影夜摇」",
        "jibie" :40,
        "sen"   :7,
        "damage":80,
  	"wound":80,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N暗运内力，提气纵身，飘然前行，竟似在冰上滑行，瞬间便来到了$n身前，一式「踏雪寻梅」，\n"+
                  "手掌翻飞，$w自下而上，带着丝丝风声，划向$n。",
        "lian"  : "$N暗运内力，提气纵身，飘然前行，竟似在冰上滑行，瞬间便纵出数丈，一式「踏雪寻梅」，\n"+
                  "手掌翻飞，$w自下而上，带着丝丝风声，发力划出。",
        "zhaoshi":"「踏雪寻梅」",
        "jibie" :70, 
        "sen"   :8,
        "damage":90,
  	"wound":90,
        "damage_type" : "划伤"
    ]),
});

string *parry_msg = ({
    "$n看准$N来势，手中$v迎向$N的$w，硬接$N的来势。\n",
    "$n左脚向后退出一步，以卸去$N的来势，同时$v刺向$N的掌心，正是以攻为守。\n",
});

string *unarmed_parry_msg = ({
    "$n不退不让，双臂一横，硬接$N的来势。\n",
    "$n左脚向后退出一步，以卸去$N的来势，同时双掌发力击出。\n",
    "$n脚下扎稳马步，双手置于胸前，缓缓推出，似要将$N攻势包围于两掌之间。\n",
    "$n袍袖一挥，闪身至二尺开外，堪堪躲过$n的进攻。\n",
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    object ob;
    ob = me->query_temp("weapon");
    if ( !ob || (string)ob->query("weapon_type") != "short" )
        return notify_fail("你必须拿着短兵刃才能练习三友探春这门武功。\n");

    if( me->query("max_force") < 600 )
        return notify_fail("三友探春要配合一定的内力来练，你内力不足，强练会伤害身体的！\n");
    if( me->query_jibie("yunv-zhen") <60)
        return notify_fail("青城武功讲究根基扎实，你城字十二破的功夫还未到一定火候，不能练习三友探春！\n");
//    if( me->query_jibie("songfeng-xinfa") <60)
//        return notify_fail("青城武功讲究根基扎实，你松风心法的功夫还未到一定火候，不能练习三友探春！\n");

    return valid_learn( me );
}

string query_xiuwei_type() { return "short";}

string query_weapon_type() { return "short";}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_dengji() { return 5;}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 10; }

