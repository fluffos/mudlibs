// file   :  shier-po.c
// attrib :  skill
// name   :  城字十二破(青城派武功，short 2)
// write  :  xli
// date   :  1998.10
// include:
//降龙式 伏虎式 飞云式 破月式 射日式 揽星式 劈山式 挽水式 拂柳式 撼松式 摘桃式 献果式
#include <ansi.h>


inherit SKILL;
mapping *action = ({/*size = 12*/
    ([  "action": "$N暗提一口真气，一招「降龙式」，平地拔高一丈，右手锤敲向$n的头顶",
        "lian"  : "$N暗提一口真气，一招「降龙式」，平地拔高一丈，右手锤向下敲去",
        "zhaoshi":"「降龙式」",
        "jibie" :10,
        "limb"  : "头顶",
        "sen"   :3,
        "damage":5,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N身体前冲，闪至$n面前，使出一招「伏虎式」，左手锥从下往上撩向$n小腹",
        "lian"  : "$N身体前冲，闪开两步，使出一招「伏虎式」，左手锥从下往上撩出",
        "zhaoshi":"「伏虎式」",
        "jibie" :17,
        "limb"  : "小腹",
        "sen"   :3,
        "damage":10,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N使出一招「飞云式」，右手锤向上一挡，左手锥向着$n脸部平平划出",
        "lian"  : "$N使出一招「飞云式」，右手锤向上一挡，左手锥向前平平划出",
        "zhaoshi":"「飞云式」",
        "jibie" :25, 
        "limb"  : "脸部",
        "sen"   :3,
        "damage":15,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N移步换形，原地一踏，向前冲出几步，一招「破月式」，左手锥疾刺$n右眼",
        "lian"  : "$N移步换形，原地一踏，向前冲出几步，一招「破月式」，左手锥疾刺而出",
        "zhaoshi":"「破月式」",
        "jibie" :32, 
        "limb"  : "右眼",
        "sen"   :3,
        "damage":20,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N左手锥尖一斜，右手锤抵住锥尾，一招「射日式」，直刺$n左眼",
        "lian"  : "$N左手锥尖一斜，右手锤抵住锥尾，一招「射日式」，直刺斜上方",
        "zhaoshi":"「射日式」",
        "jibie" :38,
        "limb"  : "左眼",
        "sen"   :3,
        "damage":25,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N右手锤平平敲出，左手锥则由下至上向$n撩出，似刺似划，正是一招「揽星式」",
        "lian"  : "$N右手锤平平敲出，左手锥则由下至上撩出，似刺似划，正是一招「揽星式」",
        "zhaoshi":"「揽星式」",
        "jibie" :45,
        "limb"  : "前胸",
        "sen"   :3,
        "damage":30,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N右手锤由右向左，发力敲向$n腰间，左手锥则高举过$n头顶，向下划出，一招「劈山式」使得虎虎有风",
        "lian"  : "$N右手锤由右向左，发力敲向$n腰间，左手锥则高举过头，向下划出，一招「劈山式」使得虎虎有风",
        "zhaoshi":"「劈山式」",
        "jibie" :52,
        "limb"  : "头顶",
        "sen"   :3,
        "damage":35,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N身形一矮，右手锤敲向$n膝盖，左手锥使出一招「挽水式」，刺向$n脚面，并顺势上挑",
        "lian"  : "$N身形一矮，右手锤向前敲出，左手锥使出一招「挽水式」，向下一刺，并顺势上挑",
        "zhaoshi":"「挽水式」",
        "jibie" :60,
        "limb"  : "脚面",
        "sen"   :3,
        "damage":40,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N移步换形，右手锤挡住$n来势，左手锥向$n腰间疾划而出，正是一招「拂柳式」",
        "lian"  : "$N移步换形，右手锤一挡，左手锥斜向疾划而出，正是一招「拂柳式」",
        "zhaoshi":"「拂柳式」",
        "jibie" :66,
        "limb"  : "腰间",
        "sen"   :3,
        "damage":45,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N真气渐渐凝聚，大喝一声，右手锤使一招「撼松式」，发力敲向$n小腹",
        "lian"  : "$N真气渐渐凝聚，大喝一声，右手锤使一招「撼松式」，发力直直敲向前方",
        "zhaoshi":"「撼松式」",
        "jibie" :72,
        "limb"  : "小腹",
        "sen"   :3,
        "damage":50,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N左手锥迅疾刺向$n咽喉，右手锤则趁$n格挡之时发力敲向$n面门，正是一招「摘桃式」",
        "lian"  : "$N左手锥迅疾平平刺出，右手锤则后发先至，发力敲向正前方，正是一招「摘桃式」",
        "zhaoshi":"「摘桃式」",
        "jibie" :80,
        "limb"  : "脸部",
        "sen"   :3,
        "damage":55,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N手形虚晃，右手锤作势敲向$n面门，而左手锥则使一招「献果式」，直刺$n腰间",
        "lian"  : "$N手形虚晃，右手锤作势向前方敲出，而左手锥则使一招「献果式」，直刺中盘",
        "zhaoshi":"「献果式」",
        "jibie" :85,
        "limb"  : "腰间",
        "sen"   :3,
        "damage":65,
        "damage_type" : "刺伤"
    ]),
    
});

string *parry_msg = ({
    "$n看准$N来势，右手锤敲向$N的$w，硬接$N的来势。\n",
    "$n左脚向后退出一步，以卸去$N的来势，同时左手锥刺向$N的掌心，正是以攻为守。\n",
});

string *unarmed_parry_msg = ({
    "$n不退不让，双臂一横，硬接$N的来势。\n",
    "$n左脚向后退出一步，以卸去$N的来势，同时双掌发力击出。\n",
    "$n脚下扎稳马步，双手置于胸前，缓缓推出，似要将$N攻势包围于两掌之间。\n",
    "$n袍袖一挥，闪身至二尺开外，堪堪躲过$n的进攻。\n",
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    object ob;
    ob = me->query_temp("weapon");
    if ( !ob || (string)ob->query("weapon_type") != "short" ||
       (string)ob->query("name")!=BLU"雷公轰"NOR )
        return notify_fail("你必须先找一套雷公轰才能练习城字十二破这门武功。\n");

    if( me->query_jibie("zhaodi-hong") <60 )
        return notify_fail("青城武功讲究根基扎实，你着地轰的功夫还未到一定火候，不能练习城字十二破！\n");
    return valid_learn( me );
}

string query_xiuwei_type() { return "short";}

string query_weapon_type() { return "short";}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_dengji() { return 3;}

int query_youxiao_jibie() { return 8; }

int query_parry_ratio() { return 6; }

