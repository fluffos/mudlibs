int valid_learn(object me) {
  if (me->query("str") < 20)
    return notify_fail("你体质较弱，不适宜学习这门功夫。\n");
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");

  if (!weapon || weapon->query("weapon_type") != "whip")
    return notify_fail("你必须先找一根鞭子才能练。\n");

  if (me->query("force") < 4)
    return notify_fail("你的内力已经用光了，没有力气再练了。\n");

  if (me->query("kee") < 5)
    return notify_fail("这么不要命的练呀，还是先歇歇吧。\n");

  if (me->query("max_force") < 300)
    tell_object(me, "你觉得一阵气血翻涌，似乎是内力不足以练习这门功夫。\n");

  return 1;
}

mapping query_action(int jibie) {
  object user;
  int i, size;

  user = this_player();
  if (user->query("max_force") < 300) {
    user->receive_damage("kee", random((300 - user->query("max_force")) / 30) + 1);
    user->add("force", -2);
  }
  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "whip";
}
string query_weapon_type() { return "whip"; }

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 3;
}
string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }

  return "";
}


string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 7; }

string exert_action_file(string action) {
  return PERFORM_DIR + "sanhua-zhang/" + action;
}
