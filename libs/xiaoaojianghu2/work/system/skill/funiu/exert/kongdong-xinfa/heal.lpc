#include <ansi.h>

int exert(object me, object target, int amount) {
  //       if( target != me )return
  //               notify_fail("你只能用内功疗自己的伤。\n");

  if (me->is_fighting())
    return notify_fail("战斗中运功疗伤？找死吗？\n");
  if (!amount) amount = 200;
  if (me->query("force") < amount)
    return notify_fail("你的真气不够。\n");
  if (me->query("max_force") < 2 * amount)
    return notify_fail("你的内功不够深厚，无法运用那么多真气。\n");

  if (target == me) {
    if (me->query_jibie("kongdong-xinfa") < 50)
      return notify_fail("你的崆峒心法等级不够，无法疗伤。\n");
    if (target->query("eff_kee") == target->query("max_kee"))
      return notify_fail("你没有受到内伤。\n");
    if (target->query("eff_kee") < target->query("max_kee") / 4)
      return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
    message_vision(HIY "$N盘膝坐下，开始运功疗伤。\n", me);
    me->receive_curing("kee", amount * me->query_jibie("kongdong-xinfa") / 200);
  } else {
    if (me->query_jibie("kongdong-xinfa") < 80)
      return notify_fail("你的崆峒心法等级不够，不能给别人疗伤。\n");
    if (target->is_fighting())
      return notify_fail("他现在战斗中，你无法给他运功疗伤。\n");
    if (target->query("eff_kee") == target->query("max_kee"))
      return notify_fail(target->name() + "没有受到内伤。\n");
    if (me->query("eff_kee") < me->query("max_kee") / 2)
      return notify_fail("你真气运走不畅，还是先给自己疗伤吧！\n");
    message_vision(HIY "$N盘膝坐下，双掌贴在$n的后背，开始给$n运功疗伤。\n" NOR, me, target);
    target->receive_curing("kee", amount * me->query_jibie("kongdong-xinfa") / 320);
    //		target->start_busy(4);
    //		target->disable_command("verb","你现在正在疗伤中。\n");   
  }

  /*	me->start_busy(4);
	call_out("heal_over", 10, me, target, amount);
	return 1;
}

void heal_over(object me, object target, int amount)
{
*/
  me->add("force", -amount);
  me->add("gin", -amount / 5);
  me->add("sen", -amount / 5);
  message_vision(HIY "$N脸上一阵红一阵白，不久，吐出了一口瘀血。\n" NOR, target);

  return 1;
}
