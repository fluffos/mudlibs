//  chuiliu-ianfa.c    垂柳剑法
//  实在佩服这相当十二级修为的抄功哇！
//  我似乎在每一门功夫里都能看见鸳鸯刀法的影子，唉。
//  既然叫垂柳剑法，就得和垂柳有关系才行
//  现在这路剑法使用时剑身多颤，犹如柳叶在轻轻的春风中摇摆，很美吧，
//  这才叫设计功夫。唉，粗制滥造害了多少人呀。



inherit SKILL;

mapping *action = ({
  ([ "action": "$N一招「春风拂柳」，手中$w一转，剑尖抖了两抖，刺向$n$l！",
    "lian": "$N一招「春风拂柳」，手中$w一转，剑尖抖了两抖。",
    "jibie": 8,
    "zhaoshi": "「春风拂柳」",
    "sen": 2,
    "damage": 30,
    "damage_type": "刺伤" ]),
  ([ "action": "$N一招「新新柳色」，手中$w斜刺而出，腕力抖动，剑尖轻颤。",
    "lian": "$N一招「新新柳色」，手中$w斜刺而出，腕力抖动，剑尖轻颤。",
    "jibie": 16,
    "zhaoshi": "「新新柳色」",
    "sen": 2,
    "damage": 35,
    "damage_type": "割伤" ]),
  ([ "action": "只见$N一招「柳丝随风」，手中$w拖出一条剑影，转身反刺，犹如柳丝随风。",
    "lian": "只见$N一招「柳丝随风」，手中$w拖出一条剑影，转身反刺，犹如柳丝随风。",
    "jibie": 24,
    "zhaoshi": "「柳丝随风」",
    "sen": 2,
    "parry": 5,
    "damage": 40,
    "damage_type": "刺伤" ]),
  ([ "action": "又见$N一式「垂柳丝黄」，身子左转，剑身挺出，全身侧成一条直线。",
    "lian": "又见$N一式「垂柳丝黄」，身子左转，剑身挺出，全身侧成一条直线。",
    "jibie": 32,
    "zhaoshi": "垂柳丝黄",
    "sen": 3,
    "dodge": 10,
    "damage": 45,
    "damage_type": "刺伤" ]),
  ([ "action": "$N身子一侧，一招「柳影婆娑」，剑身一转，划了一个很小的圈子，反腕斜\n"
    "刺而出。",
    "lian": "$N身子一侧，一招「柳影婆娑」，剑身一转，划了一个很小的圈子，反腕斜\n"
    "刺而出。",
    "jibie": 40,
    "sen": 2,
    "zhaoshi": "「柳影婆娑」",
    "parry": 10,
    "damage": 50,
    "damage_type": "刺伤" ]),
  ([ "action": "$N将$w换至左手，一招「相与谁近」，反手一掌推出。",
    "lian": "$N将$w换至左手，一招「相与谁近」，反手一掌推出。",
    "jibie": 48,
    "zhaoshi": "「相与谁近」",
    "sen": 2,
    "damage": 55,
    "damage_type": "刺伤" ]),
  ([ "action": "$N提剑踏上一步，剑尖在腕力的驱使下抖动不已，正是一招「乱发齐天」。",
    "lian": "$N提剑踏上一步，剑尖在腕力的驱使下抖动不已，正是一招「乱发齐天」。",
    "jibie": 56,
    "zhaoshi": "「乱发齐天」",
    "sen": 3,
    "parry": 10,
    "damage": 55,
    "damage_type": "刺伤" ]),
  ([ "action": "$N一招「斜阳疏影」，身形一跃，斜冲向前，右手挥动$w向下直斩向$n$l。",
    "lian": "$N一招「斜阳疏影」，身形一跃，斜冲向前，右手挥动$w向下直斩。",
    "jibie": 64,
    "zhaoshi": "「斜阳疏影」",
    "sen": 3,
    "parry": 20,
    "damage": 65,
    "damage_type": "刺伤" ]),

});

string *parry_msg = ({
  "$n使出一招「杨柳楼台」，手中的$v舞成一团剑花，架开了$N的$w。\n",
  "$n立剑胸前，顺手将$N的$w「当」的一声挡住了。\n",
  "$n使出一招「不著死灰」，身形反转，手中的$v向后急刺....\n",
});

string *unarmed_parry_msg = ({
  "$n使出一招「杨柳楼台」，手中的$v舞成一团剑花，架开了$N。\n",
  "$n立剑胸前，顺手将$N的攻势挡住了。\n",
  "$n使出一招「不著死灰」，身形反转，手中的$v向后急刺....\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}


string query_xiuwei_type() {
  return "sword";
}

int query_dengji() {
  return 2;
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 7; }

int query_parry_ratio() { return 6; }
