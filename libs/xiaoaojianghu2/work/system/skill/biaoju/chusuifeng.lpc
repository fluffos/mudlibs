// Dodge : chusuifeng.c 出随风
// by trill 05/27/97
// reedit by lin 97-7-29



inherit SKILL;

mapping *action = ({
  ([ "action": "$n借着$N攻来的劲风，一式「乘风而行」向后滑出。",
    "lian": "$N双脚一点地面，向后滑出。",
    "jibie": 10,
    "sen": 3,
    "zhaoshi": "「乘风而行」",
  ]),
  ([ "action": "$n身形急速闪动，一招「出窈入冥」转向$N的身后。",
    "lian": "$N身形急速闪动，一晃而出数尺",
    "jibie": 20,
    "sen": 3,
    "zhaoshi": "「出窈入冥」",
  ]),
  ([ "action": "$n身子转动，一式「出随风」人随风动，飘到一旁。",
    "lian": "$N身子转动，一式「出随风」人随风动，飘到一旁。",
    "jibie": 30,
    "sen": 3,
    "zhaoshi": "「出随风」",
  ]),
  ([ "action": "$n急速闪动，使出一式「遨游八极」。",
    "lian": "$N身形急速闪动，脚下急走，使出一式「遨游八极」。",
    "jibie": 40,
    "sen": 4,
    "zhaoshi": "「遨游八极」",
  ]),
  ([ "action": "$n长啸一声，使出一式「离形得似」，人影急转。",
    "lian": "$N长啸一声，使出一式「离形得似」，人影急转。",
    "jibie": 50,
    "sen": 4,
    "zhaoshi": "「离形得似」",
  ]),
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() { return "dodge"; }

int query_dengji() { return 3; }

string *query_lian() {
  string *lian_msg;
  mapping lian_act;

  lian_msg = allocate(sizeof(action));
  for (int i = 0; i < sizeof(action); i++) {
    lian_act = action[i];
    lian_msg[i] = (string)lian_act["lian"];
  }
  return lian_msg;
}
