// yueman-qiankun 玉壁剑之月满乾坤
// by lnwm on 98/4/2

#include <ansi.h>

int perform(object me, object target)
{
    object weapon;
    
    weapon = me->query_temp("weapon");

    if ( !target->is_character() ||
         !me->is_fighting(target) )
        return notify_fail("月满乾坤只能对战斗中的对手使用。\n");

    if ( me->query_temp("perform/attack") )
            return notify_fail("你正在施展绝技，不能施展新的绝技。\n");

    if ( !weapon || weapon->query("weapon_type") != "sword" ) 
        return notify_fail("你手中无剑，如何使用剑法？！\n");		
	
    if ( (int)me->query_lingwu("yubi-jian", 1) < 50 )
        return notify_fail("你的“玉壁月华明”不够娴熟，不会施展月满乾坤。\n");

    me->set_temp("perform/attack",
        ([
            "name" : PERFORM_DIR "yubi-jian/yueman-qiankun",
            "call" : "action",
            "target"  : target,
            "delay" : 1,
        ]) );
    write("OK。\n");
    return 1;
}

int action(object me, object target)
// 这里没有target什么事，所以不加target参数。 
{
    int per = me->query_per(), dex = me->query_dex();
    mapping action;

    if ( !target || !present( target, environment( me )  ) ){
        write("你的对手逃跑了。\n");
	me->delete_temp("perform/attack");
	return 0;
    }

    //printf("时辰%d，日期%d\n",query_shichen(),query_day());
    //一天12个时辰，一月30天。    1-12          1-30
    if( ( query_shichen() <= 3 || query_shichen() >= 10 ) && 
        ( query_day() <= 20 && query_day() >= 10 )  &&
        ( me->query_lingwu("yubi-jian") >= 70 ) )
    {
        message_vision( HIB "皓月当空，$P手中剑忽做龙吟之声。\n", me );
	action = ([ "sen"       :20,
		    "dodge"     :75,
		    "parry"     :75,
		    "damage_type" : "刺伤"
		]);
	if( random(2) )
	{
            action["action"]=HIR"只见$N执剑月下，剑尖透出青光，正是“月满乾坤”"NOR;
            action["wound"]=70+per+dex;
	}
	else
	{
	    action["action"]=HIR"$N仗剑月下，剑尖忽然冲出一道青气，将$n影在一片光华之中。"
		+"\n$N“月满乾坤”淋漓尽致地使出。。\n"NOR;
	    action["wound"]=80+per+dex;
	}    

    }
    else    
    {
        message_vision( HIB "$N身行突变，剑锋破空。\n" NOR , me );
	action =
	([  "action"    :YEL"$N“月满乾坤”使出，但见剑气纵横，笼罩数丈之内的空间。"NOR,
	    "sen"       :20,
	    "dodge"     :50,
	    "parry"     :50,
	    "wound"	:70+random(per+dex),
	    "damage_type" : "刺伤"
	]);
    }    

    me->set_temp("attack_skill","yubi-jian");
    me->set_temp("perform/attack/action",action);
    me->delete_temp("perform/attack/call");
    return 1;
}
