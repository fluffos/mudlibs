string *parry_msg = ({
    "$n脚走阴阳，使出「四像妆神」，化解了$N的招式。\n",
    "$n使出一招「八阵图成」，身形化作数条人影，绕得$N失了目标。\n",
    "$n使出一招「五月渡泸」，右手倒挂金钩，反手击向$N的$l。\n",
    "$n使一招「两朝开济」，双掌硬接了$N的招式。\n",
});
int valid_learn(object me)
{
    if ( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("学习卧龙掌必须空手。\n");
    if ( me->query_jibie("duanshi-xinfa") < 70 )
        return notify_fail("你的段氏心法火候不足，无法练卧龙掌。\n");
    if ( me->query("max_force") < 800 )
        return notify_fail("你的内力太弱，无法练卧龙掌。\n");
    return 1;
}
int valid_lian( object me )
{
    if ( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("你必须先放下手中的兵刃，才能练习掌法。\n");
    return 1;
}
mapping query_action(int jibie)
{
        int i, size;
        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}
string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}
string query_xiuwei_type() { return "unarmed"; }
int query_dengji() { return 5; }
string query_parry_msg(object weapon)
{
    return parry_msg[random(sizeof(parry_msg))];
}
int query_youxiao_jibie() { return 12; }
int query_parry_ratio() { return 11; }
