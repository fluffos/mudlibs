#include <ansi.h>



inherit SKILL;

string type() { return "knowledge"; }

int valid_learn( object me ) { return 1; }

int is_knowledge() { return 1; }

string query_xiuwei_type() { return "enigma"; }

int query_dengji(){ return 1;}

void skill_improved(object me)
{
    int temp;

    if( !objectp(me) ){
	write(WHT"您胸中激起一种莫名的感觉!\n"NOR);
        return ;
    }
    temp=me->query("bellicosity")/10;
    if( temp && random(2) ){
	me->add("bellicosity", -temp );
	me->add("enigme/bellicosity",temp);
    }
/*    temp=me->query( "PKS" )/100;
    if( temp && random(2) ){
	me->add("PKS", -temp);
	me->add("enigme/PKS",temp);
    }
    temp=me->query( "MKS" )/10;
    if( temp && random(2) ){
	me->add("MKS", -temp);
	me->add("enigme/MKS",temp);
    }
 */   tell_object( me, "你心中一阵混乱，感到莫名其妙。\n" );
    return ;
}
