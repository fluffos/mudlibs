string *parry_msg = ({
    "一声嗤响，$n小指发出一道剑气，将$w轻轻挑开。\n",
    "$n如闲庭散步，轻抬右手食指，已将$N的$w振开。\n",
    "突然间$n变掌为指，嗤的一声疾响，点向$N手中$w，振得$N倒退了一步。\n",
});
string *unarmed_parry_msg=({
    "$n轻轻一笑，眼露突放精光，发出一道剑气挡在$N面前。\n",
    "$n急凝真气，母指剑气如虹，逼得$N身形急退。\n",
    "$n真气一送一收，$N的招式已被轻描淡写的化开。\n",
});

int valid_learn(object me)
{
    if ( me->query("max_force") < 2600 )
	return notify_fail("你内力太低，无法使出六脉神剑。\n");
        return 1;
}

int valid_lian( object me )
{
    if (  me->query_temp("weapon") )
        return notify_fail("六脉神剑虽称剑，实为指，怎能拿着武器练！\n");
    return valid_learn( me );
}

string query_xiuwei_type() { return "unarmed"; }     

string query_weapon_type() { return "unarmed";}

int query_dengji() { return 8; }

mapping query_action(int jibie)
{
    int i;

    for(i=0;i<sizeof(action);i++)    
	if ( jibie < action[i]["jibie"] ){
	    i++;
	    break;
	}
    return action[random(i)];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 20; }

int query_parry_ratio() { return 20; }
