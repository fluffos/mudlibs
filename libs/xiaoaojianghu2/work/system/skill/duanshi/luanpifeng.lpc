//luanpifeng-gun
//    乱披风棍法;
//横扫千军，力劈华山，烈火燎原，一夫当关，怪蟒翻身
//飞沙走石，盘古开天，乌云蔽日，飞星逐月，雷动九天


inherit SKILL;

mapping *action = ({
  ([ "action": "$N一招「力劈华山」，手中$w猛力直上直下劈向$n",
    "lian": "$N一招「力劈华山」，手中$w猛力直上直下劈去",
    "jibie": 10,
    "sen": 5,
    "dodge": 5,
    "parry": 30,
    "damage": 60,
    "wound": 30,
    "damage_type": "劈伤" ]),
  ([ "action":
    "$N一式「怪蟒翻身」，手中的$w从下向上斜挑向$n",
    "lian":
    "$N一式「怪蟒翻身」，手中的$w从下向上斜挑",
    "jibie": 20,
    "sen": 6,
    "dodge": 10,
    "parry": 30,
    "damage": 65,
    "wound": 35,
    "damage_type": "淤伤" ]),
  ([ "action":
    "$N使出「飞星逐月」，双脚点地一蹬，连人带棍平飞起来直撞向$n",
    "lian":
    "$N双脚点地一蹬，连人带棍平飞起来直撞向前",
    "jibie": 25,
    "limb": "胸口",
    "sen": 8,
    "dodge": 10,
    "parry": 40,
    "damage": 70,
    "wound": 35,
    "damage_type": "淤伤" ]),
  ([ "action":
    "$N把$w舞成一团巨大的棍影，如「烈火燎原」般向$n卷去",
    "lian":
    "$N把$w舞成一团巨大的棍影，向前卷去",
    "jibie": 40,
    "limb": "身体",
    "sen": 7,
    "dodge": 20,
    "parry": 20,
    "damage": 80,
    "wound": 40,
    "damage_type": "淤伤" ]),
  ([ "action":
    "$N使出「横扫千军」，$w拦腰向$n横扫，带着无边的劲气，几乎令$n无法招架",
    "lian":
    "$N$w拦腰横扫，劲气十足",
    "jibie": 55,
    "limb": "腰部",
    "sen": 6,
    "damage": 90,
    "dodge": 0,
    "parry": 40,
    "wound": 45,
    "damage_type": "劈伤" ]),
  ([ "action":
    "$N纵身一跃，从半空里犹如晴天霹雳一般向$n劈去，正是最后一式「雷动九天」",
    "lian":
    "$N纵身一跃，从半空里犹如晴天霹雳一般劈下",
    "jibie": 70,
    "sen": 7,
    "dodge": 5,
    "parry": 50,
    "damage": 100,
    "wound": 55,
    "damage_type": "刺伤" ]),
});

string *parry_msg = ({
  "$n暴喝一声，使出一招「飞沙走石」，$v舞得犹如狂风一般，泼水难进。\n",
  "$n使出「盘古开天」，反击$N头部。\n",
  "$n横棍一封一架，气势凌然，真是所谓「一夫当关」。\n",
  "$n见情势紧急，以「乌云蔽日」将$N的$w砸开。\n",
});
string *unarmed_parry_msg = ({
  "$n暴喝一声，使出一招「飞沙走石」，$v舞得犹如狂风一般，泼水难进。\n",
  "$n使出「盘古开天」，反击$N头部。\n",
  "$n横棍一封一架，气势凌然，真是所谓「一夫当关」。\n",
});

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}


string query_xiuwei_type() {
  return "long";
}
string query_weapon_type() { return "staff"; }

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 4;
}

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 9; }

int valid_learn(object me) {
  if (me->query("max_force") < 300)
    return notify_fail("你的内力太弱，无法练这门武功。\n");
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "staff")
    return notify_fail("你必须先找一条棍才能练棍法。\n");

  return 1;
}
