#include <ansi.h>



inherit SKILL;

string type() { return "knowledge"; }

int is_knowledge()
{
	return 1;
}

int valid_study( object me)
{
    if( me->query_jibie("literate") < 60 )
        return notify_fail("你读了一会儿,发现根本读不懂书上说的东西.\n");
    return 1;
}

int valid_qingjiao( object me)
{
    if( me->query_jibie("literate") <60 )
        return notify_fail("你的文化程度难以领悟这么深奥的问题.\n");
    return 1;
}

string query_xiuwei_type()
{
	return "suogu-gong";
}
