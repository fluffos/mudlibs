string *parry_msg = ({
  "$n一招《连环反踢》，一个转身避开$N的$w，左腿无声无息地反身踢出",
  "$n提气转身，两腿一先一后向$N踢到，登时将$N的$w荡了开去",
  "$n身子急转，两腿连续踢出，在$N身前舞成一片，一时竟分不出哪是身，哪是影",
  "$n使出《鹞子翻身》，左腿一转，猛地向$N$w踢出，竟是要踢掉$N手中的兵刃",
});

string *unarmed_parry_msg = ({
  "$n一招《连环反踢》，一个转身避开$N的攻势，左腿无声无息地反身踢出",
  "$n提气转身，两腿一先一后向$N踢到，登时将$N的双手荡了开去",
  "$n身子急转，两腿连续踢出，在$N身前舞成一片，一时竟分不出哪是身，哪是影",
  "$n使出《鹞子翻身》，左腿一转，猛地向$N踢出，竟是要反踢$N，令其回招自救",
});


int valid_learn(object me) {
  if (me->query("dex") < 12 || me->max_food_capacity() > 400)
    return notify_fail("你的身子太笨重了，还是练上身的功夫吧。\n");
  if (me->query_xiuwei_by_type("dodge") < 150)
    return notify_fail("腿脚上的功夫是要求一定轻功基础的。\n");
  return 1;
}

int valid_lian(object me) {
  object weapon;
  weapon = me->query_temp("weapon");
  if (weapon)
    return notify_fail("你必须空手练习无敌鸳鸯腿.\n");
  if (me->query("dex") < 12 || me->max_food_capacity() > 400)
    return notify_fail("你的身子太笨重了，还是练上身的功夫吧。\n");
  if (me->query_xiuwei_by_type("dodge") < 150)
    return notify_fail("腿脚上的功夫是要求一定轻功基础的。\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

string query_xiuwei_type() {
  return "unarmed";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 3;
}

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() {
  return 9;
}

int query_parry_ratio() {
  return 14;
}
