string *parry_msg = ({
  "$n使出一招「夸夫追日」，掌力一吐，身子斜向左方，挡开了$N的$w。\n",
  "$n一招「漫天飞雪」，掌风似墙一般将$N的$w挡了回去。\n",
  "$n使出「盘古开天」，反攻$N$l，化解了$N的攻势\n",
  "$n掌开乾坤，双掌一上一下，内力吐出，将$N的攻势化解了.\n",
  "$n左手伸出，两跟手指想钳子一般紧紧夹住了$N的$w!!\n",
});

string *unarmed_parry_msg = ({
  "$n使出一招「夸夫追日」，掌力一吐，身子斜向左方，挡开了$N。\n",
  "$n一招「漫天飞雪」，掌风似墙一般将$N的攻势挡了回去。\n",
  "$n使出「盘古开天」，反攻$N$l，化解了$N的攻势\n",
  "$n掌开乾坤，双掌一上一下，内力吐出，将$N的攻势化解了.\n",
});
int valid_learn(object me) {
  if ((int)me->query("max_force") < 800)
    return notify_fail("你的内力不够，没有办法练大力鹰爪手。\n");
  else
    return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (weapon)
    return notify_fail("你必须空手练习鹰爪手.\n");

  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "falconclaw/" + action;
}
mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "unarmed";
}

int query_dengji() {
  return 4;
}

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }

  return "";
}

int query_youxiao_jibie() { return 20; }

int query_parry_ratio() { return 6; }
