string *parry_msg = ({
    "$n往地下一滚，甩起刀来，“咣”的一响，将$w砍出一个缺口。\n",
    "$n竟突然掉转刀锋，以刀柄打击$w，迫使$N变招。\n",
    "$n忙沉$v一架，“当”的一响，双刃相交，火光四溅。\n",
    "$n一招「反身劈山」，身形一转，反手就劈，破了$N的必中一招。\n",
});
string *unarmed_parry_msg=({
    "但$n抢了先着，$N双手还未尽展，被$n左右连环两刀，逼了回去。\n",
    "$n将刀一晃，似进似退，$N稍一犹豫，便已被$n跳开数丈。\n",
    "$n不架不让，竟抢对攻，一招「削耳撩腮」，举刀斜砍，$N急忙跃开。\n",
    "$n已成竹在胸，收刀侧身一带，$N脚下一个不稳，险些摔倒。\n",
});

int valid_learn(object me)
{
        return 1;
}

int valid_lian( object me )
{
    object ob;
    ob = me->query_temp("weapon");
    if ( !ob || (string)ob->query("weapon_type") != "blade" )
        return notify_fail("你不拿刀就想练胡家刀法？不太可能吧。\n");
    return valid_learn( me );
}

string query_xiuwei_type() { return "blade"; }     

string query_weapon_type() { return "blade";}

int query_dengji() { return 6; }

mapping query_action(int jibie)
{
    int i;

    for(i=0;i<sizeof(action);i++)    
	if ( jibie < action[i]["jibie"] ){
	    i++;
	    break;
	}
    return action[random(i)];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 18; }

int query_parry_ratio() { return 18; }
