int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    int encu;
    encu = me->query_encumbrance() * 100 / me->query_max_encumbrance();
    if( encu < 10 )
    return notify_fail("轻功必须负重练习。\n");

    if( me->query("force") < 10 )
        return notify_fail("你的内力没有了，还是先歇歇吧。\n");
   
    if( me->query("kee") < 10 )
        return notify_fail("这么不要命的练呀，还是歇歇吧。\n");
        
    if( me->query("max_force") < 500 )
        tell_object( me, "你内力不够，如果练习或使用这门功夫，会对身体有害\n");

    return 1;
}

mapping query_action(int jibie)
{
    object user;
    int i, size;
    user = this_player();
/*    if( user->query("max_force") < 500 )
    {   //内力不够却强行要使用，就会造成身体的损害
        user->receive_damage( "kee" , random( ( 500 - user->query( "max_force" ) )
          / 30 ) + 1 );
        tell_object( user, "你只觉得气血一阵翻涌\n");
    }
*/    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
            if ( action[ i ][ "jibie" ] > jibie )
            {
                    size = i;
                    break;
            }
    return action[ random( size ) ];
}
string query_xiuwei_type()
{
        return "dodge";
}

int query_dengji()
{
    return 4;
}

string *query_lian()
{
    string *lian_msg;
    mapping lian_act;
    object user;

    user = this_player();
    if( user->query("max_force") < 500 )
    {   //内力不够却强行要使用，就会造成身体的损害
        user->receive_damage( "kee" , random( ( 500 - user->query( "max_force" ) )
          / 60 ) + 1 );
        tell_object( user, "你只觉得气血一阵翻涌\n");
    }
    lian_msg = allocate( sizeof( action ) );
    for ( int i = 0; i < sizeof( action ); i++ )
    {
            lian_act = action[ i ];
            lian_msg[ i ] = (string)lian_act[ "lian" ];
    }
    return lian_msg;
}
