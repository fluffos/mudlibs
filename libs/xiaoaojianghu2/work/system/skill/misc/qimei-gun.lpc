string *parry_msg = ({
        "$n举$v上格，架开了$N的$w.\n",
        "$n抽身而退，反手$v横扫\n",
        "$n用手中兵器一晃，闪身而退\n",
});
string *unarmed_parry_msg = ({
        "$n举$v上格，架开了$N.\n",
        "$n抽身而退，反手$v横扫\n",
        "$n用手中兵器一晃，闪身而退\n",
});
int valid_learn(object me)
{   
    return 1;
}

int valid_lian( object me )
{
	object weapon;

	weapon = me->query_temp( "weapon" );
    if ( !weapon || weapon->query("weapon_type") != "staff" )
        return notify_fail("你必须先找一齐眉棍来才能练，或者木杖也行呀。\n");

	return 1;
}

mapping query_action(int jibie)
{
	int i, size;

	size = sizeof( action );
	for ( i = 0; i < sizeof( action ); i++ )
		if ( action[ i ][ "jibie" ] > jibie )
		{
			size = i;
			break;
		}
    return action[ random( size ) ];
}


string query_xiuwei_type()
{
	return "long";
}                    
string query_weapon_type()
{
    return "staff";
}

int query_dengji()
{
	return 2;
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 10; }
