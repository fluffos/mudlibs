string *parry_msg = ({
    "$n一招《灵蛇出洞》，身子有如游蛇一般，三转两闪避开$N的$w",
    "$n提气转身，两腿一先一后向$N踢到，登时将$N的$w荡了开去",
    "$n身子急转，在$N身前舞成一片，猛然一招《蛇型刁手》，反击$N，逼其不得不回招自救",
    "$n使出《九天鹤舞》，左腿一转，猛地向$N$w踢出，竟是要踢掉$N手中的兵刃",
});

string *unarmed_parry_msg = ({
    "$n一招《灵蛇出洞》，身子有如游蛇一般，三转两闪避开$N的攻势",
    "$n提气转身，两腿一先一后向$N踢到，登时将$N的力道荡了开去",
    "$n身子急转，在$N身前舞成一片，猛然一招《蛇型刁手》，反击$N，逼其不得不回招自救",
    "$n使出《九天鹤舞》，左腿一转，猛地向$N踢出",
});



int valid_learn(object me)
{
    if( me->query("dex") < 22 || me->max_food_capacity() > 350 )
        return notify_fail("你的身子太笨重了，还是练上身的功夫吧。\n");
    if( me->query_xiuwei_by_type("dodge") < 250 )
        return notify_fail("腿脚上的功夫是要求一定轻功基础的。\n");
    return 1;
}

int valid_lian( object me )
{
    object weapon;
    weapon = me->query_temp( "weapon" );
    if ( weapon )
        return notify_fail("你必须空手练习.\n");
    if( me->query("dex") < 22 || me->max_food_capacity() > 350 )
        return notify_fail("你的身子太笨重了，还是练上身的功夫吧。\n");
    if( me->query_xiuwei_by_type("dodge") < 250 )
        return notify_fail("腿脚上的功夫是要求一定轻功基础的。\n");

    return 1;
}

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
	return "";
}

string query_xiuwei_type()
{
        return "unarmed";
}

int query_dengji()
{
        return 4;
}

string query_parry_msg(object weapon)
{
    if ( objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie()
{
    return 11;
}

int query_parry_ratio() 
{ 
    return 12; 
}
