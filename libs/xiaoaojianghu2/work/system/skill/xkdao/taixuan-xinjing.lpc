#include <ansi.h>
inherit FORCE;

string query_xiuwei_type(){ return "force"; }

int valid_learn(object me)
{
    return 1;
}

int valid_lian(object me)
{
        return notify_fail("内功只能通过修炼或者是使用来增加领悟度。\n");
}
int query_level() {     return 6; }

string query_type() { return "yang"; }

int valid_xiulian( object me )
{
    if ( me->query("max_force")<2000&& me->query("max_force")> me->query("age")*100)
        return notify_fail("你年纪尚小，实在是领悟不到真谛，连不下去了。\n");
    if( environment( me )->query("short") != YEL"石洞"NOR &&environment( me )->query("short") != YEL"石厅"NOR )
        return notify_fail("你无论如何修练,都无法再想起石壁上的任何东西.\n");
    if( me->query("force")>me->query("max_force") *1.5&&me->query("max_force") > 6099+me->query("rendumai") *10  )
     {

    return notify_fail(HIY"你的内功修为已经到了你根骨经脉的最高限制。"NOR"
"HIC"你需要用静修的方法打通任督二脉后，才能获得更高的内功修为。\n"NOR );

     }
    return 1;
}

string exert_function_file(string func)
{
        return EXERT_DIR + "taixuan-xinjing/" + func;
}

