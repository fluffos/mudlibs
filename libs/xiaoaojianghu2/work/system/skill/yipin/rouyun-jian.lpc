        "damage_type":"割伤"    ]),
    
    ([  "action":"$N一招「耿耿银河」，手中$w横削，随即千头万绪般乱点下来，真若天上繁星一般。",
        "lian"  :"$N手中$w向前千头万绪般乱点下去，正是一招「耿耿银河」。",
        "sen"   :30,
        "jibie" :20,
        "dodge" :30,
        "parry" :60,
        "zhaoshi":"「耿耿银河」",
        "damage" :105,
        "wound":80,
        "damage_type":"刺伤"    ]),
    ([  "action":"只见$N弓步上前，双手紧握$w，一招「春云乍展」，向$n的头部由下而上一撩。",
        "lian"  :"$N一个弓步，使出一招「春云乍展」，手中$w往上一撩。",
        "sen"   :40,
        "jibie" :30,
        "dodge" :20,
        "parry" :70,
        "zhaoshi":"「春云乍展」",
        "damage" :110,
        "wound":80,
        "damage_type":"割伤"    ]),
    ([  "action":"$N手拿$w，一招「斗柄南指」，向$n的$l飞速一击。",
        "lian"  :"$N手拿$w，一招「斗柄南指」，快速击出。",
        "sen"   :50,
        "jibie" :40,
        "dodge" :20,
        "parry" :75,
        "zhaoshi":"「斗柄南指」",
        "damage" :115,
        "wound":85,
        "damage_type":"割伤"    ]),
([	"action":"$N一招「白虹贯日」，手中$w划出一道彩虹，闪电般刺向$n的$l。",
        "lian"  :"$N一招「白虹贯日」，手中$w一抖，闪电般向前刺出。",
        "sen"   :60,
        "jibie" :100,
        "dodge" :100,
        "parry" :100,
       "zhaoshi":"「白虹贯日」",
       "damage" :135,
         "wound":100,
   "damage_type":"刺伤"   ]),
});

string *parry_msg = ({
    "$n使出一招「白虹贯日」，手中的$v化作一条彩虹，磕开了$N的$w。\n",
    "$n使出一招「耿耿银河」，手中的$v化做漫天繁星，荡开了$N的$w。\n",
    "$n手中的$v一抖，一招「春云乍展」，向$N拿$w的手腕削去。\n",
    "$n反手一招「杏花春雨」，击出。\n",
    "$n使出一招「斗柄南指」，$w直刺$N的双手。\n",
});

string *unarmed_parry_msg = ({
    "$n双手舞得密不透风，使出「三环套月」，封住了$N的攻势。\n",
    "$n反手一招「春云乍展」，避开了$N的这一招。\n",
    "$n使出一招「耿耿银河」，架住了$N的攻势。\n",
    "但见$n一招「白虹贯日」，迫得$N连连后退。\n",
});

int valid_learn(object me)
{
    if ( me->query("max_force") < 1500 )
    {   
        return notify_fail("你的内力不够，没有办法练柔云剑术。\n");
    }
    return 1;
}

int valid_lian( object me )
{   
    object ob = me->query_temp("weapon");
    if ( !ob || (string)ob->query("weapon_type") != "sword" )
    {   
        write("你必须先找一把剑才能练剑法。\n");
        return 0;
    }
    return valid_learn(me);
}

mapping query_action(int jibie)
{
	int i, size;

	size = sizeof( action );
	for ( i = 0; i < sizeof( action ); i++ )
		if ( action[ i ][ "jibie" ] > jibie )
		{
			size = i;
			break;
		}
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_xiuwei_type() { return "sword"; }         
string query_weapon_type() { return "sword"; }

int query_dengji() { return 6; }

int query_youxiao_jibie() { return 8; }

int query_parry_ratio() { return 7; }

string perform_action_file( string action )
{
    return PERFORM_DIR + "rouyun-jian/" + action;
}

