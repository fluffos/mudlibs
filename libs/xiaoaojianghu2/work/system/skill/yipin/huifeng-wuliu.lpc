// Dodge : huifeng-wuliu.c
//回风舞柳



inherit SKILL;

mapping *action = ({
    ([  "action" : "但见$n脚尖轻轻一点，一招「天马行空」，飞身跃入天空。\n",
        "lian"   : "但见$N脚尖轻轻一点，一招「天马行空」，飞身跃入天空。\n",
        "jibie"  : 15,
        "sen"    :  2, 
        ]),
    ([  "action" : "$n身形随风飘出，一式「斜风细雨」，掠出三丈开外。\n",
        "lian"   :"$N身形随风飘出，一式「斜风细雨」，掠出三丈开外。\n",
        "jibie"  : 30,
        "sen"    :  2, 
        ]),
    ([  "action" :"$n一式「一泻千里」，身形犹如闪电，直退出去，衣带飘飞，疑是仙人。\n",
        "lian"   :"$N一式「一泻千里」，身形犹如闪电，直退出去，衣带飘飞，疑是仙人。\n",
        "jibie"  : 45,
        "sen"    :  4, 
        ]),
    ([  "action" :"$n一招「天花乱坠」，身形直飘出去，尤如一片青云飘浮在空中。\n",
        "lian"   :"$N一招「天花乱坠」，身形直飘出去，尤如一片青云飘浮在空中。\n",
        "jibie"  : 60,
        "sen"    :  3, 
        ]),
    ([  "action" :"却见$n「一飞冲天」，冲天而起，一波三折，端是美观。\n",
        "lian"   :"却见$N「一飞冲天」，冲天而起，一波三折，端是美观。\n",
        "jibie"  : 75,
        "sen"    :  2, 
        ]),
    ([  "action" :"只见$n一招「左右逢源」，倒掠身形，凌空两个翻转，退出两丈开外。\n",
        "lian"   :"只见$N一招「左右逢源」，倒掠身形，凌空两个翻转，退出两丈开外。\n",
        "jibie"  : 90,
        "sen"    :  3, 
        ]),
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    return 1;
}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
            {
                size = i;
                break;
            }
    return action[ random( size ) ];
}

string query_xiuwei_type() { return "dodge"; }

int query_dengji() { return 6; }

string *query_lian()
{
    string *lian_msg;
    mapping lian_act;

    lian_msg = allocate( sizeof( action ) );
    for ( int i = 0; i < sizeof( action ); i++ )
    {
        lian_act = action[ i ];
        lian_msg[ i ] = (string)lian_act[ "lian" ];
    }
    return lian_msg;
}
