//eyu-jianfa.c
//鳄鱼剪法
//长兵刃,构思于南海鳄神岳老三的鳄鱼剪.
//最好帮这门武功写一个独门兵刃

inherit SKILL;

mapping *action = ({
  ([ "action": "$N剪尖内收，一招「开门楫盗」，$w自下而上划了个半弧，向$n的$l挥去",
    "lian": "$N剪尖内收，一招「开门楫盗」，$w自下而上划了个半弧，向外挥去",
    "jibie": 8,
    "zhaoshi": "「开门楫盗」",
    "limb": "腰间",
    "sen": 3,
    "dodge": 20,
    "damage": 40,
    "damage_type": "瘀伤" ]),
  ([ "action": "$N一招「恶蟒出洞」，跨上一步，双手发力，$w欲脱手而出，暴长二尺，径点$n$l",
    "lian": "$N一招「恶蟒出洞」，手中$w欲脱手而出。。。。。。",
    "jibie": 16,
    "zhaoshi": "「恶蟒出洞」",
    "sen": 5,
    "dodge": 10,
    "parry": 20,
    "damage": 50,
    "damage_type": "刺伤" ]),
  ([ "action": "$N一招「以退为进」，$w绕颈而过，刷地一声自上而下向$n猛劈",
    "lian": "$N一招「以退为进」，$w绕颈而过，刷地一声自上而下向外猛劈",
    "jibie": 24,
    "zhaoshi": "「以退为进」",
    "sen": 4,
    "dodge": 20,
    "damage": 70,
    "damage_type": "瘀伤" ]),
  ([ "action": "$N右手反执剪柄，一招「旁敲侧击」，猛一挫身，$w直向$n的颈中剪去",
    "lian": "$N右手反执剪柄，一招「旁敲侧击」，猛一挫身，$w直剪而出",
    "jibie": 32,
    "zhaoshi": "「旁敲侧击」",
    "sen": 3,
    "dodge": 20,
    "damage": 80,
    "damage_type": "割伤" ]),
  ([ "action": "$N双手合执$w，一招「鲍鱼之肆」，拧身急转，剪尖直刺向$n的双眼",
    "lian": "$N双手合执$w，一招「鲍鱼之肆」，拧身急转，剪尖直刺向敌人双眼",
    "jibie": 48,
    "zhaoshi": "「鲍鱼之肆」",
    "sen": 2,
    "damage": 80,
    "parry": 50,
    "damage_type": "刺伤" ]),
  ([ "action": "$N大喝一声，$w向$n当头直挥，至中途却突然一转，击向$n$l",
    "lian": "$N一招「伏兵十面」，$w中途一转。",
    "jibie": 56,
    "zhaoshi": "「伏兵十面」",
    "sen": 3,
    "dodge": 20,
    "parry": 20,
    "damage": 90,
    "damage_type": "瘀伤" ]),
});

string *parry_msg = ({
  "$n剪尖平指，一招「大海沉沙」，一片片切骨罡气如飓风般裹住自己全身",
  "$n一招「汉将当关」，无数剪尖化作点点繁星，只听一阵叮叮之声,封住了$N的所"
  "有攻势",
});
string *unarmed_parry_msg = ({
  "$n左手持剪,右手急点而出，架开了$N.\n",
  "$n用手中兵器一晃，闪身而退\n",
});
int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "qiang")
    return notify_fail("你必须先找一把剪才能练\n");
  if (me->query("max_force") < 400)
    return notify_fail("你的内力太弱，无法练这门武功。\n");
  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}


string query_xiuwei_type() {
  return "long";
}
string query_weapon_type() {
  return "long";
}

int query_dengji() {
  return 5;
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 14; }

int query_parry_ratio() { return 8; }
