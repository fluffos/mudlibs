string *parry_msg = ({ /* size = 10*/
    "$n不退不让，使出「力劈华山」，硬接$N的来势。\n",
    "$n以“钻”字诀「冲天一炮」，左掌接住$N的来势，右手直向前打去，逼得$N退出三步。\n",
    "$n一招「一索横江」，脚下步伐窜动，双臂挥舞，一副万夫不挡之勇。\n",
    "$n一招「扑天盖地」，身随拳走，恰恰让过$N的攻势。\n",
    "$n一声长啸，一招「山崩地裂」，双拳封挡，$N的攻势顿时落在空处。\n",
});

string *unarmed_parry_msg = ({
    "$n不退不让，使出「力劈华山」，硬接$N的来势。\n",
    "$n以“钻”字诀「冲天一炮」，左掌接住$N的来势，右手直向前打去，逼得$N退出三步。\n",
