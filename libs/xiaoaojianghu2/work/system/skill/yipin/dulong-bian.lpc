                "damage_type":  "刺伤"
        ]),
        ([      "zhaoshi" : "「龙归大海」",
                "action": "$N展身虚步，提腰跃落，一招「龙归大海」，$w一卷，拦腰击向$n",
                "lian" : "$N展身虚步，提腰跃落，一招「龙归大海」，$w一卷，拦腰击出",
                "jibie": 40,
                "limb" : "面门",
                "sen"  : 4,
                "dodge": 10,
                "parry": 20,
                "damage": 95,
		"wound":  70,
