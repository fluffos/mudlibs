string *parry_msg = ({
  "$n左脚向左成撇步站定，左掌顺势向前以一式「」圈手封出，挡住了$N的一招。",
  "$n顺势收左手扣腰，右掌以封手封向左方，化$N的攻势于无形。",
  "却见$n身形不变，收左右手向上撩手，轻而易举的挡开了$N这招。",
  "但$n不退反进，一式「」随即身体转正，右手向右甩出，以刁手向$N刁出，迫得$N中途收招。",
});

int valid_learn(object me) {
  int budd_jibie, skill_jibie;
  budd_jibie = me->query_jibie("buddhism");
  skill_jibie = me->query_jibie("jimie-zhua");

  if (14 * skill_jibie / 25 + 60 > budd_jibie)
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  if ((int)me->query("max_force") < 400)
    return notify_fail("你的内力不够，没有办法练寂灭抓。\n");

  //    if ( (string)me->query("using_force") != "banruo-xinfa" )
  //        return notify_fail("没有般若心法，练寂灭抓很容易走火入魔。\n");

  return 1;
}

int valid_lian(object me) {
  if (me->query_temp("weapon"))
    return notify_fail("拿着兵器练爪法，开玩笑吧。\n");

  return valid_learn(me);
}

string query_xiuwei_type() { return "unarmed"; }

string query_weapon_type() { return "unarmed"; }

int query_dengji() { return 5; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  //    if ( !weapon )
  return parry_msg[random(sizeof(parry_msg))];
  //    else
  //        return 0;//med_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 12; }

int query_parry_ratio() { return 11; }
