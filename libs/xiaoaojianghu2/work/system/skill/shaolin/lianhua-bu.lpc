inherit SKILL;

mapping *action = ({
([     
    "action": "只见$N一招「飘如浮云」，身体笔直向上纵起丈余，躲过$N这一招。\n",
    "lian" :  "$N脚尖轻轻一点，一招「飘如浮云」，笔直向上跃起。\n",
    "jibie": 4,
    "sen"  : 3,
]),
([     
    "action": "但见$N使出「忭风舞润」，身形飘忽，轻轻一纵，早已避开。\n",
    "lian" : "$N使出「忭风舞润」，身形飘忽，轻轻一纵，横跃出很远\n",
    "jibie": 12,
    "sen"  : 3,
]),
([     
    "action": "$N一招「春露秋霜」，身行随意转，倏地挪开了三尺，避过了这一招。\n",
    "lian" : "$N一式「春露秋霜」，身行随意转，倏地挪开了三尺。\n",
    "jibie": 23,
    "sen"  : 3,
]),
([     
    "action": "$N一招「风恬月朗」，身形微晃，有惊无险地避开了$N这一招。\n",
    "lian" : "$N一招「风恬月朗」，身形微晃，已在数丈之外。\n",
    "jibie": 30,
    "sen"  : 2,
]),
([     
    "action": "却见$N「随波逐流」，足不点地，往旁窜开数尺，躲了开去。\n",
    "lian" : "$N足不点地，一招「随波逐流」，，往旁窜开数尺。\n",
    "jibie": 40,
    "sen"  : 2,
]),
});

mapping query_action(int jibie)
{
    int i, size;
    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_xiuwei_type()
{
    return "dodge";
}

int query_dengji()
{
    return 2;
}

