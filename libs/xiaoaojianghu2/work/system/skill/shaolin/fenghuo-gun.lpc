inherit SKILL;

mapping	* action=({
    ([	"action":
"$N抬右脚踢棍跟向后，同时身体左转，原地跳成弓步，$w向前刺出，攻向$n$l\n"
"正是一招「乌龙翻江」",
        "lian"  :
"$N抬右脚踢棍跟向后，同时身体左转，原地跳成弓步，$w向前刺出...",
        "jibie" :0,
        "zhaoshi":"「乌龙翻江」",
        "sen"   :9,
        "dodge" :10,
        "parry" :10,
        "damage":20,
        "damage_type":"刺伤"   ]),
    ([  "action":
"$N两腿屈膝成马步，一招「顽石点头」，$w随身轮一个五花，眼瞟向$n右侧，\n"
"$w却刺向$n左侧",
        "lian"  :
"$N两腿屈膝成马步，一招「顽石点头」，$w随身轮一个五花，眼瞟向右，\n"
"$w却刺向左侧",
        "jibie" :20,
        "zhaoshi":"「顽石点头」",
        "sen"   :7,
        "dodge" :0, 
        "parry" :40,
        "damage":55,
        "wound":15,
        "damage_type":"刺伤"    ]),
    ([  "action":
"$N使出「黑风展翅」，两脚不动，棍梢向上向后轮起，一溜向前，挑向$n$l",
        "lian"  :
"$N使出「黑风展翅」，两脚不动，棍梢向上向后轮起，一溜向前挑阳。",
        "jibie" :60,
        "zhaoshi":"「黑风展翅」",
        "sen"   :10,
        "dodge" :10,
        "parry" :30,
        "damage":60,
        "wound" :20,
        "damage_type":"割伤"    ]),
    ([  "action":
"$N使出一式「孤雁出群」，上体稍右转，$w由右向左下方打，接着左脚向前\n"
"棍由左向右轮过，横扫$n",
        "lian"  :
"$N使出一式「孤雁出群」，上体稍右转，$w由右向左下方打，接着左脚向前\n"
"棍由左向右轮过，横扫一圈。",
        "jibie" :90,
        "zhaoshi":"「孤雁出群」",
        "sen"   :9,
        "dodge" :30,
        "parry" : 30,
        "damage":75,
        "wound" :20,
        "damage_type":"淤伤"    ]),
    ([  "action":
"$N一招「铁牛耕地」，左脚上前一步，$w由上向下打，不待$n反应，又由下向上\n"
"撩向$n下阴",
        "lian"  :
"$N一招「铁牛耕地」，左脚上前一步，$w由上向下打，又由下向上撩起。",
        "jibie" :120,
        "sen"   :7,
        "zhaoshi":"「铁牛耕地」",
        "dodge":0,
        "parry" :30,
        "damage" : 80,  
        "wound"  : 30,    
        "damage_type":"瘀伤"   ]),
});

string *parry_msg = ({
    "$n一招「霸王开弓」，双手撑住$v，架向$N$w。\n",
    "$n使出「苏秦背剑」，$w舞成一圈，使$N地攻势尽化于空幻。\n",
    "$n不理$N来势，一招「秦王挎剑」，提起$v攻向$N，迫$N收招。\n",
    "$n一招「二郎担柴」，身体轻侧，同时$v在$N$w上一拨，恰好躲开了$N的攻势。\n",
});

string *unarmed_parry_msg = ({
    "$n一招「霸王开弓」，双手撑住$v，架向$N来势。\n",
    "$n使出「苏秦背剑」，$v舞成一圈，使$N的攻势尽化于空幻。\n",
    "$n不理$N来势，一招「秦王挎剑」，提起$v攻向$N，迫$N收招。\n",
    "$n一招「二郎担柴」，身体轻侧，恰好躲开了$N的攻势。\n",
});
int valid_learn(object me)
{      
    if ( !me->query_jibie("buddhism"))
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");

    return 1;
}

int valid_lian( object me )
{
	object weapon;
	weapon = me->query_temp( "weapon" );
	if ( !weapon || 
         ((string)weapon->query("weapon_type") != "gun" 
       && (string)weapon->query("weapon_type") != "long"
       && (string)weapon->query("weapon_type") != "staff"
         )
       )
        return notify_fail("你必须先找一根棍棒来才能练。\n");

	return valid_learn(me);
}

mapping query_action(int jibie)
{
	int i, size;

	size = sizeof( action );
	for ( i = 0; i < sizeof( action ); i++ )
		if ( action[ i ][ "jibie" ] > jibie )
		{
			size = i;
			break;
		}
    return action[ random( size ) ];
}


string query_xiuwei_type()
{
	return "long";
}                    
string query_weapon_type()
{
    return "staff";
}

int query_dengji()
{
	return 4;
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 9; }

int query_parry_ratio() { return 8; }
