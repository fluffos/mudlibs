        "zhaoshi":"「横空出世」",
        "jibie"     :45,
        "sen"       : 3,
        "parry"     :10,
        "damage"    :30,
    	"damage_type" : "内伤"
    ]),
    ([  "action": "$N左掌划一半圆，一式「长虹贯日」，右掌斜穿而出，疾拍$n的胸前大穴",
    	"lian"  : "$N左掌划一半圆，右掌奋力穿出，「长虹贯日」",
        "zhaoshi":"「长虹贯日」",
        "jibie"     :50,
        "sen"       : 2,
    	"parry"     :10,
        "damage"    :40,
        "damage_type" : "内伤"
    ]),
    ([  "action": "$N使一式「云断秦岭」，右掌上引，左掌由后而上一个甩劈，斩向$n的$l",
    	"lian"  : "$N使一式「云断秦岭」，右掌上引，左掌由后而上一个甩劈",
        "zhaoshi":"「云断秦岭」",
        "jibie"     :55,
        "sen"       : 2,
        "damage"    :35,
        "damage_type" : "劈伤"
    ]),
