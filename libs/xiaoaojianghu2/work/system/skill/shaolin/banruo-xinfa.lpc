inherit FORCE;

string query_xiuwei_type() { return "force"; }

int valid_learn(object me) {
  if (me->query("gender") != "男性")
    return notify_fail("般若心法只有男性才能学。\n");
  if (me->query("max_force") < 300)
    return notify_fail("你的内功修行还不够学习这门内功。\n");
  return 1;
}

int valid_lian(object me) {
  return notify_fail("少林心法只能通过修炼或者是使用来增加领悟度。\n");
}
int query_level() {
  return 3;
}

string query_type() {
  return "yang";
}

int valid_xiulian(object me) {
  if (me->query("shaolin/announced"))
    return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
  if ((int)me->query("bellicosity") < 200)
    return 1;
  else
    return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
}

string exert_function_file(string func) {
  return EXERT_DIR + "banruo-xinfa/" + func;
}
