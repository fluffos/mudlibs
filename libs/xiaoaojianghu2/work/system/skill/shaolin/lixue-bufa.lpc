inherit SKILL;

mapping *action = ({
([     
    "action": "$n一招「阳春白雪」，$N只觉眼前一花，不见了$n的身影。\n",
    "lian" :  "$N一招「阳春白雪」，身形飘浮不定，难以捉摸。\n",
    "jibie": 6,
    "sen"  : 4,
]),
([     
    "action": "只见$n身子向后一翻，一招「月白风清」，后荡而起，掠向一旁。\n",
    "lian" : "$N身子向后一翻，一招「月白风清」，后荡而起，掠向一旁。\n",
    "jibie": 15,
    "sen"  : 3,
]),
([     
    "action": "却见$n「一飞冲天」，冲天而起，一波三折，端是美观。\n",       
    "lian" : "$N一式「一飞冲天」，冲天而起，一波三折，端是美观。\n",
    "jibie": 25,
    "sen"  : 3,
]),
([     
    "action":  "只见$n一招「左右逢源」，倒掠身形，凌空两个翻转，退出两丈开外。\n",
    "lian" : "$N一招「左右逢源」，倒掠身形，凌空两个翻转，退出两丈开外。\n",
    "jibie": 40,
    "sen"  : 4,
]),
([     
    "action":  "$n息气上升，意存玉枕，一招「莺歌燕舞」，身子飘然而起。\n",
    "lian" : "$N息气上升，意存玉枕，一招「莺歌燕舞」，身子飘然而起。\n",
    "jibie": 65,
    "sen"  : 4,
]),
});

mapping query_action(int jibie)
{
    int i, size;
    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_xiuwei_type()
{
    return "dodge";
}

int query_dengji()
{
    return 4;
}

