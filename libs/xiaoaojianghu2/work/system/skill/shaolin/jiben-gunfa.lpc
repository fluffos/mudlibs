inherit SKILL;

mapping *action = ({
    ([  "action":"$N一招[伏虎式]，冲$n猛地挥出一棍",
        "lian"  :"$N一招[伏虎式]，向前猛地挥出一棍，慢慢体会其中诀窍。",
        "jibie" :5,
        "sen"   :1,
        "damage_type":"瘀伤"
    ]),
    ([  "action":"$N一招[定胜式]，手中$w划了一个圈，往$n砸去",
        "lian"  :"$N一招[定胜式]，手中$w划了一个圈，往前砸去。",
        "jibie" :20,
        "sen"   :1,
        "damage_type":"砍伤"
    ]),
    ([  "action":"$N一招[潜龙式]，$w虚晃一下，左掌猛地拍向$n",
        "lian"  :"$N一招[潜龙式]，$w虚晃一下，左掌猛地拍向前去。",
        "jibie" :25,
        "sen"   :1,
        "damage_type":"瘀伤"
    ]),
    ([  "action":"$N一招[提枪式]，$w由下向上撩向$n",
        "lian"  :"$N一招[提枪式]，$w由下向上撩去，$w差点脱手。",
        "jibie" :30,
        "sen"   :1,
        "damage_type":"戳伤"
    ]),
    ([  "action":"$N一招[穿袖式]，$w迅疾向$n刺出",
        "lian"  :"$N一招[穿袖式]，$w迅疾向前刺出，却一不小心滑了一下。",
        "jibie" :40,
        "sen"   :1,
        "damage_type":"刺伤"
    ]),
    ([  "action":"$N一招[披身式]，$w由身后抽出，横扫向$n",
        "lian"  :"$N一招[披身式]，$w由身后抽出，横扫一圈。",
        "jibie" :47,
        "sen"   :1,
        "damage_type":"瘀伤"
    ]),
    ([  "action":"$N一招[骑马式]，双脚跨开成马步，双手紧握$w，往$n当头砸去",
        "lian"  :"$N一招[骑马式]，双脚跨开成马步，双手紧握$w，由上而下砸来。",
        "jibie" :55,
        "sen"   :1,
        "damage_type":"瘀伤"
    ]),
});

string *parry_msg = ({
    "$n轮起$v，挡开了$N的进攻。\n",
    "$n$v护住要害，成功的架开了$N的攻势。\n",
});

string *unarmed_parry_msg = ({
    "$n挥$v一格，架住$P的这招。\n",
    "$n$v与$N一对，双方全身均是一震。\n",
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    object weapon;

    weapon = me->query_temp( "weapon" );
	if ( !weapon || 
         ((string)weapon->query("weapon_type") != "gun" 
       && (string)weapon->query("weapon_type") != "long"
       && (string)weapon->query("weapon_type") != "staff"
         )
       )
        return notify_fail("你必须找跟棍子才能练习。\n");

    return 1;
}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
                size = i;
                break;
        }
    return action[ random( size ) ];
}

string query_xiuwei_type() { return "long"; }

string query_weapon_type()
{
    return "staff";
}


// 返回这路武功的等级, 第一等返回 1, 第十等返回 10.
int query_dengji() { return 1; }

string query_parry_msg(object weapon)
{
    if ( !objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int query_youxiao_jibie() { return 7;}
int query_parry_ratio() { return 6; }

