string *parry_msg = ({
  "$n使一招「魔自心生」，$v猛地自下而上反撩。\n",
  "$n双手齐举$v，迎面而上，大喝一声，只听「当」的一声大响，架住了$N的$w\n",
  "$n使出一招「驱魔行天」，$v反点$N\n",
});
string *unarmed_parry_msg = ({
  "$n使一招「魔自心生」，$v猛地自下而上反撩。\n",
  "$n双手齐举$v，迎面而上，大喝一声，架住了$N\n",
  "$n使出一招「驱魔行天」，$v反点$N\n",
});
int valid_learn(object me) {
  if (me->query_jibie("buddhism") < 80)
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  if ((me->query("str") * 20 + me->query("max_force")) < 1100)
    return notify_fail("你的膂力过小，需要格外多修习内功加以辅助，方可学习这门功夫\n");
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon ||
    ((string)weapon->query("weapon_type") != "gun"
      && (string)weapon->query("weapon_type") != "long"
      && (string)weapon->query("weapon_type") != "staff"
    )
  )
    return notify_fail("你必须先找一根棍棒来才能练，或者木杖也行呀。\n");

  return valid_learn(me);
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}


string query_xiuwei_type() {
  return "long";
}
string query_weapon_type() {
  return "staff";
}

int query_dengji() {
  return 6;
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 11; }

int query_parry_ratio() { return 10; }
