inherit SKILL;

mapping *action = ({
([     
    "action": "但见$n脚尖轻轻一点，一招「天马行空」，飞身跃入天空。",
    "lian" :  "$N脚尖轻轻一点，一招「天马行空」，飞身跃入天空。",
    "jibie": 20,
    "sen"  : 5,
]),
([     
    "action": "$n身形随风飘出，一式「斜风细雨」，掠出三丈开外。\n",
    "lian" : "$N身形随风飘出，一式「斜风细雨」，掠出三丈开外。\n",
    "jibie": 40,
    "sen"  : 4,
]),
([     
    "action": "$n一式「一泻千里」，身形犹如闪电，直退出去，衣带飘飞，疑是仙人。\n",
    "lian" : "$N一式「一泻千里」，身形犹如闪电，直退出去，衣带飘飞，疑是仙人。\n",
    "jibie": 60,
    "sen"  : 4,
]),
([     
    "action": "$n一招「啸傲湖山」，身形飞转，直窜入天空。\n",
    "lian" : "$N一招「啸傲湖山」，身形飞转，直窜入天空。\n",
    "jibie": 80,
    "sen"  : 5,
]),
([     
    "action": "$n一招「天花乱坠」，身形直飘出去，尤如一片青云飘浮在空中。\n",
    "lian" : "$N一招「天花乱坠」，身形直飘出去，尤如一片青云飘浮在空中。\n",
    "jibie": 100,
    "sen"  : 4,
]),
});

mapping query_action(int jibie)
{
    int i, size;
    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_xiuwei_type()
{
    return "dodge";
}

int query_dengji()
{
    return 6;
}

