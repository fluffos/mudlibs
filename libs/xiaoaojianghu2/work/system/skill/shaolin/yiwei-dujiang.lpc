int valid_lian(object me)
{
	return valid_learn(me);
}

int valid_learn(object me)
{
    int budd_jibie,skill_jibie;
    budd_jibie = me->query_jibie("buddhism");
    skill_jibie = me->query_jibie("yiwei-dujiang");
    
    if ( 8*skill_jibie /25+ 120 > budd_jibie )
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    if((int)me->query("max_force")<1000)
        return notify_fail("你内力修为不够，不能练一苇渡江。\n");
//    if((string)me->query("using_force")!="banruo-xinfa")
//        return notify_fail("你的内功心法不适合练一苇渡江。\n");
    return 1;
}

int query_youxiao_jibie() {return 10;}

