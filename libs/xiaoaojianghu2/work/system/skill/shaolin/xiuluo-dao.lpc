string *parry_msg = ({
        "$n大喝一声，使出一招「回头是岸」，手中$w斜劈，向$N撩去......\n",
        "$n立刀胸前，顺手将$N的$w「当」的一声挡住了。\n",
        "$n使出一招「悬崖勒马」，身形急退，手中的$v向前挥出....\n",
});
string *unarmed_parry_msg=({
        "$n使出一招「回头是岸」，手中$w横刺，向$N撩去......\n",
        "$n立刀胸前，挡住了$N的攻势.\n",
        "$n使出一招「悬崖勒马」，身形急退，手中的$v向前挥出....\n",
});

int valid_lian( object me )
{
	object weapon;

	weapon = me->query_temp( "weapon" );   
        if ( me->query("max_force") < 100 || me->query("force") < 10 )
	    return notify_fail("你的内力不够强，不能练习修罗刀法。\n");
        if ( !weapon || (string)weapon->query("weapon_type") != "blade" )
            return notify_fail("你必须先找一把刀才能练刀法。\n");

	return 1;
}

int valid_learn(object me)
{
    if ( me->query_jibie("buddhism") < 60 )
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");      
    return valid_lian(me);
}

mapping query_action(int jibie)
{
	int i, size;

	size = sizeof( action );
	for ( i = 0; i < sizeof( action ); i++ )
		if ( action[ i ][ "jibie" ] > jibie )
		{
			size = i;
			break;
		}
    return action[ random( size ) ];
}


string query_xiuwei_type()
{
	return "blade";
}                    
string query_weapon_type() { return "blade";}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji()
{
	return 4;
}

string query_parry_msg(object weapon)
{   
    if ( objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }

    return "";
}
             
int query_youxiao_jibie() { return 8; }

int query_parry_ratio() { return 7 ; }

