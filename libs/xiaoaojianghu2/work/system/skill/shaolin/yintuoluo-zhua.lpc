mapping *action = ({
  ([ "action": "$N上前一步，左手微晃，右手五指成爪，一式「道无量」向$n的$l连抓三掌",
    "lian": "$N上前一步，左手微晃，右手五指成爪，揣度「道无量」的含义",
    "zhaoshi": "「道无量」",
    "damage": 20,
    "parry": 5,
    "dodge": 5,
    "jibie": 0,
    "sen": 6,
    "damage_type": "抓伤",
  ]),
  ([ "action": "$N向左跨一步，双手分抓$n上身四处大穴，手法之快，令人大惊失色，\n"
    "不愧有「魔心乱」之名",
    "lian": "$N向左跨一步，双手分别虚抓空中四处，体会到「魔心乱」出手迅猛之关键",
    "zhaoshi": "「魔心乱」",
    "damage": 30,
    "parry": 10,
    "dodge": 10,
    "jibie": 10,
    "sen": 5,
    "damage_type": "抓伤",
  ]),
  ([ "action": "$N右跨一步，双手成爪，连抓数记，$n正在躲闪之际，$N突然左足飞\n"
    "踢$n的$l，正是「行无涯」之虚实不定之意",
    "lian": "$N右跨一步，双手成爪，连抓数记，突然左足飞起一踢",
    "zhaoshi": "「行无涯」",
    "damage": 40,
    "parry": 20,
    "dodge": 20,
    "jibie": 25,
    "sen": 6,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$n对$N一阵暴风骤雨般的急攻，$N后退一步，左手抓向$n的$l，右手却\n"
    "反扣$n的头颈，姿态优美宛如「火中莲」",
    "lian": "$N后退一步，转守势为攻势，双手分抓了出去",
    "zhaoshi": "「火中莲」",
    "damage": 50,
    "parry": 30,
    "dodge": 0,
    "jibie": 35,
    "sen": 7,
    "damage_type": "抓伤",
  ]),
  ([ "action": "$N身形不动，却突然抢至$n身边，正在$n手足无措之时，$N一式「智无边」，\n"
    "幻化满天爪影向$n抓去",
    "lian": "$N仔细体味「智无边」攻敌不备之意，幻化出满天爪影",
    "zhaoshi": "「智无边」",
    "damage": 60,
    "parry": 0,
    "dodge": 30,
    "jibie": 50,
    "sen": 6,
    "damage_type": "抓伤",
  ]),
  ([ "action": "$N左手划圈，封住$n的退路，右手成爪，中心突入，抓向$l，正是『因陀螺抓』\n"
    "的第六式「菩提心」",
    "lian": "$N左手划圈，右手成爪，中心突入",
    "zhaoshi": "「菩提心」",
    "damage": 70,
    "parry": 30,
    "dodge": 30,
    "jibie": 60,
    "sen": 7,
    "damage_type": "抓伤",
  ]),
  ([ "action": "$N使出「度无数」，忽地一纵而起，自上而下，双手抓向$n的上三路，其势威猛难当",
    "lian": "$N忽地一纵而起，自上而下，双手扑抓",
    "zhaoshi": "「度无数」",
    "damage": 80,
    "wound": 80,
    "parry": 40,
    "dodge": 0,
    "jibie": 75,
    "sen": 6,
    "damage_type": "抓伤",
  ]),
  ([ "action": "$N全身一震，双掌急攻而直，突然$N暴喝一声，左手化爪为剑，直刺$n的丹田，原来\n"
    "是『因陀螺抓』的最后一式「智慧剑」",
    "lian": "$N双掌急挥，突然化爪为剑，向前直刺",
    "zhaoshi": "「智慧剑」",
    "damage": 90,
    "parry": 40,
    "dodge": 40,
    "jibie": 90,
    "sen": 8,
    "damage_type": "刺伤",
  ])
});

string *parry_msg = ({
  "$n忽地一纵而起，避开了$N的一击，随即自上而下，双手抓向$N的上三路",
  "$n后退半步，身子一侧，沉肩下滑，让开了$N的攻势",
  "$n看定$N的来势，双手反抓$n的$l",
  "$n大喝一声，双抓快速飞抓数手，挡住了$N的攻势",
});

int valid_learn(object me) {
  if ((int)me->query("max_force") < 250)
    return notify_fail("你的内力不够，没有办法练因陀螺抓。\n");

  return 1;
}

int valid_lian(object me) {
  if (me->query_temp("weapon"))
    return notify_fail("拿着兵刃练爪法，开玩笑吧。\n");

  return valid_learn(me);
}

string query_xiuwei_type() { return "unarmed"; }

string query_weapon_type() { return "unarmed"; }

int query_dengji() { return 3; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (!weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return 0;  //med_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 9; }
