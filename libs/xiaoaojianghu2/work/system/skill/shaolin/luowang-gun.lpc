  ([ "action":
    "$N往前猛奔数步，一招「三郎担山赶太阳」，猛地跃空而起，手中$w挟风势直攻$n$l",
    "lian":
    "$N往前猛奔数步，一招「三郎担山赶太阳」，猛地跃空而起，手中$w挟风\n势直攻向前。",
    "jibie": 0,
    "zhaoshi": "「三郎担山赶太阳」",
    "sen": 9,
    "dodge": 10,
    "parry": 10,
    "damage": 90,
    "wound": 80,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N一招「玉女赴古城」，身形微晃，已到$n身后，同时$w直取$n后脑",
    "lian":
    "$N一招「玉女赴古城」，身形微晃，已跳开数丈远，同时$w直刺出去。",
    "jibie": 20,
    "zhaoshi": "「玉女赴古城」",
    "sen": 7,
    "dodge": 0,
    "parry": 40,
    "damage": 100,
    "wound": 90,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N使出「吕布托戟战」，双手紧握$w，缓缓向前击出，激起一股气墙压向$n",
    "lian":
    "$N使出「吕布托戟战」，双手紧握$w，缓缓向前击出，激起一股气墙。",
    "jibie": 60,
    "zhaoshi": "「吕布托戟战」",
    "sen": 10,
    "dodge": 10,
    "parry": 30,
    "damage": 110,
    "wound": 100,
    "damage_type": "淤伤" ]),
  ([ "action":
    "$N忽地转身，拖棍回走，乘$n赶上的瞬间，猛回头，一棍直取$n$l，\n正是「敬德倒拉鞭」",
    "lian":
    "$N忽地转身，拖棍回走几步，又猛回头拍出一掌。",
    "jibie": 90,
    "zhaoshi": "「敬德倒拉鞭」",
    "sen": 9,
    "dodge": 30,
    "parry": 30,
    "damage": 120,
    "wound": 120,
    "damage_type": "淤伤" ]),
  ([ "action":
    "$N双脚碾地右转半身，一招「陈香劈华山」，右手$w随身向下劈去，连取$n数\n"
    "处要穴，同时左手向$n当胸拍出",
    "lian":
    "$N双脚碾地右转半身，一招「陈香劈华山」，右手$w随身向下劈去，同\n时左手向前拍出。",
    "jibie": 120,
    "sen": 7,
    "zhaoshi": "「陈香劈华山」",
    "dodge": 0,
    "parry": 30,
    "damage": 150,
    "wound": 150,
    "damage_type": "瘀伤" ]),
});

string *parry_msg = ({
  "$n一招「玉女赴古城」，身形直晃，躲避$N的来势。\n",
  "$n一招「吕布拖戟战」，$w向前一横，封住了$N的所有攻势。\n",
  "$n一招「陈香劈华山」，不守反攻，$v架向$N$w，同时左掌直取$N胸前。\n",
});

string *unarmed_parry_msg = ({
  "$n一招「玉女赴古城」，身形直晃，躲避$N的来势。\n",
  "$n一招「吕布拖戟战」，$w向前一横，封住了$N的所有攻势。\n",
  "$n一招「陈香劈华山」，不守反攻，$v架向$N，同时左掌直取$N胸前。\n",
});
int valid_learn(object me) {
  int budd_jibie, skill_jibie;
  budd_jibie = me->query_jibie("buddhism");
  skill_jibie = me->query_jibie("luowang-gun");

  if (8 * skill_jibie / 25 + 120 > budd_jibie)
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不足，强练罗王棍会走火入魔。\n");

  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon ||
    ((string)weapon->query("weapon_type") != "gun"
      && (string)weapon->query("weapon_type") != "long"
      && (string)weapon->query("weapon_type") != "staff"
    )
  )
    return notify_fail("你必须先找一根棍棒来才能练。\n");

  return valid_learn(me);
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}


string query_xiuwei_type() {
  return "long";
}
string query_weapon_type() {
  return "staff";
}

int query_dengji() {
  return 7;
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 18; }

int query_parry_ratio() { return 18; }
