int valid_learn(object me) {
  if (me->query_jibie("buddhism") < 40)
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  if ((int)me->query("max_force") < 600)
    return notify_fail("你的内力不够,无法练梅花刀！\n");
  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "blade")
    return notify_fail("你必须先找一把刀才能练！\n");
  return valid_learn(me);
}

mapping query_action(int jibie) {
  int i, size;
  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

string query_xiuwei_type() {
  return "blade";
}

string query_weapon_type() {
  return "blade";
}

int query_dengji() {
  return 5;
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

int query_youxiao_jibie() {
  return 9;
}

int query_parry_ratio() {
  return 8;
}
