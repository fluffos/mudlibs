string *parry_msg = ({ /* size = 4*/
    "$n不退不让，左掌按出，硬接$N的来势。\n",
    "$n一招「意动念出」，身随拳走，恰恰让过$N的攻势。\n",
    "$n身形滴溜留一个旋身，将将让开$N的攻势。\n",
    "$n卓立不动，双手置于胸前，拳不拳掌不掌。\n$N只觉其中暗藏无数变化，不敢贸然进击。\n",
});

int valid_learn( object me )
{
    int budd_jibie,skill_jibie;
    budd_jibie = me->query_jibie("buddhism");
    skill_jibie = me->query_jibie("jingang-zhang");
    
    if ( 8*skill_jibie /16+ 120 > budd_jibie &&budd_jibie<220)
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    if( (int)me->query("max_force") < 1200 )
        return notify_fail("你内功练得不到家，还需多加努力才行\n");
    if ( (int)me->query("str") < 20 || (int)me->query("con") < 20 )
        return notify_fail("你的天赋不适合练大金刚掌。\n");
    return 1;
}
int valid_lian( object me )
{
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练习大金刚掌，不必手持兵刃。\n");
    return 1;
}

string query_xiuwei_type() { return "unarmed";}

string query_weapon_type() { return "unarmed";}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    return parry_msg[random(sizeof(parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_dengji() { return 7;}

int query_youxiao_jibie() { return 15; }

int query_parry_ratio() { return 15; }


