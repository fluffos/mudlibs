//shaolind.c
//by Hydra


#define DADIAN      "d/menpai/shaolin/longshu_dadian"
#define FATANG     "d/menpai/shaolin/fatang"
#define XUANJI      "d/menpai/shaolin/npc3/xuanji"

#include <ansi.h>
#include <localtime.h>

inherit F_DBASE;

void KnockBell();
void eventKnock();
int filter_listener(object);

void before_lecture();
void eventLecture(object);
void afterlecture();
public int blnKnocked = 0;    //记录今天是否敲过钟的布尔型变量
//呵呵,VB用多了,变量的前缀用了bln:PPP
//Hydra modified at 99/3/31

void create() {
  seteuid(ROOT_UID);
  set("name", "敲钟使者");
  set("id", "knocker");
  eventKnock();
}

void eventKnock() {
  int time;
  time = NATURE_D->QueryShiChen();
  if (time == 3 && !blnKnocked) {
    blnKnocked = 1;
    KnockBell();
    before_lecture();
  } else {
    blnKnocked = 0;
  }
  call_out("eventKnock", 60);
}


//执行敲钟的过程，所有在少林寺里面的人能听到
void KnockBell() {
  object *listener;
  int i;
  listener = filter_array(users(), "filter_listener", this_object());
  message("qiaozhong", CYN "当。。。当。。。当。。。\n\n" NOR, listener);
  message("qiaozhong", CYN "你听到远处钟楼的钟声响了起来。。。\n" NOR, listener);

  for (i = 0; i < sizeof(listener); i++) {
    if (listener[i]->query("family/family_name") == "少林派")
      tell_object(listener[i], HIY "看来是做早课的时间到了。。。你得赶紧法"
        "堂听课了。\n" NOR);
    else
      tell_object(listener[i], HIY "原来是少林弟子做早课的时间到了。\n\n" NOR);
  }
}


//ppl在少林这个区域里面，return 1，else return 0;
int filter_listener(object ppl) {
  string filename, *dir;
  if (!environment(ppl)) return 0;
  filename = file_name(environment(ppl));
  dir = explode(filename, "/");
  if (dir[2] == "shaolin")
    return 1;
  else
    return 0;
}

//开始讲课前，把玄寂从龙树院大殿搬到法堂
void before_lecture() {
  object room1, room2;
  object ob;
  if (!room1 = find_object(DADIAN))
    room1 = load_object(DADIAN);
  if (!room2 = find_object(FATANG))
    room2 = load_object(FATANG);
  if (ob = present("xuan ji", room1)) {
    message("vision", "玄寂大师听到钟声，站起身来，往外走了去。\n", room1);
    destruct(ob);
  }
  if (!ob = present("xuan ji", room2)) {
    ob = new(XUANJI);
    ob->move(room2);
    room2->set("can_zuo", 1);
    message("vision", "玄寂大师慢慢走了过来，准备开始讲经。\n"
      "你只见少林寺的僧人都坐了下来。。。\n", room2);

  }
  call_out("eventLecture", 15, room2);
}

//讲课的过程
//精神恢复满，加五次可以读佛经的机会，记录这次听课的时间
void eventLecture(object room) {
  message("vision", "玄寂大师清清嗓子，翻开经书，讲了起来。。。\n\n", room);
  call_out("endLecture", 10, room);
  call_out("after_lecture", 30);
}

void endLecture(object room) {
  object *inv;
  int i;
  string msg;
  inv = all_inventory(room);
  msg = YEL "你静静地听着玄寂大师讲经。。。\n\n\n";
  msg += GRN "只觉得有一种奇怪的感觉慢慢涌上心头。。。\n";
  msg += "这种感觉是水中月、镜里花、空中的鸟迹、雪上的鸿痕，活生生地\n";
  msg += "在心头跳跃，却又无法用语言文字来计量、形容。。。\n\n";
  msg += "你只觉得心中一片清明，浑身充满了精力。\n" NOR;
  for (i = 0; i < sizeof(inv); i++)
    if (inv[i]->query_temp("shaolin/ready_listen")) {
      inv[i]->add("shaolin/can_read_jing", 10);
      inv[i]->set("shaolin/last_lecture", time());
      inv[i]->set("gin", inv[i]->query("eff_gin"));
      inv[i]->delete_temp("shaolin/ready_listen");
      inv[i]->enable_path();
      tell_object(inv[i], msg);
    }

}

void after_lecture() {
  object room1, room2;
  object ob;
  if (!room1 = find_object(DADIAN))
    room1 = load_object(DADIAN);
  if (!room2 = find_object(FATANG))
    room2 = load_object(FATANG);
  if (ob = present("xuan ji", room2)) {
    message("vision", "玄寂大师讲完了课，站起身来，回龙树院去了。\n", room2);
    room2->delete("can_zuo");
    destruct(ob);
  }
  if (!ob = present("xuan ji", room1)) {
    ob = new(XUANJI);
    ob->move(room1);
    message("vision", "玄寂大师走了过来，看来他是刚讲完了经。\n", room1);
  }
}
