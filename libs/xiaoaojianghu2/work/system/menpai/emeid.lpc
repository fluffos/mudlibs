{
    // 因为要写文件，方便。
    seteuid( ROOT_UID );
    set( "name" , "峨眉祖师之灵" );// 这个名字有道理～！呵呵
    set( "id" , "emei" );
    set_heart_beat(1);
    //updateDizi();
    restore();
}
//  heart_beat()
void heart_beat()
{
    if ( ( nHeartBeatNumber++ ) % HEART_BEAT_TICK )
        return;
    //  执行设定需要定时执行的函数
    // 1.每个时辰检查一次峨眉NPC的位置。
    //SendNpc();
    //  执行AutoAction
    //RunAction();
    save();
//    tell_object( find_player("amber"), "hello!\n" );
}

mixed GetActionRecord( string ObName, string EventID )
{
    if ( !m_ActionData
        || !( m_ActionData[ ObName ] ) )
        return 0;
    return m_ActionData[ ObName ][ EventID ];
}

void SetActionRecord( string ObName, string EventID, mixed status )
{
    if ( !m_ActionData )
        m_ActionData = ([ ObName : ([ EventID : status ]) ]);
    else if ( !m_ActionData[ ObName ] )
        m_ActionData[ ObName ] = ([ EventID : status ]);
    else
        m_ActionData[ ObName ][ EventID ] = status;
    save();
}
// 存盘文件
string query_save_file()
{
    return "/data/place/emei";
}
///////////////////////////////////////////////////////////////////////
object * FindMembers( int IsUser )
{
    object *npcs = ({});
    if ( IsUser )
        foreach( object user in users() )
        {
            if ( user->query("family/family_name") == "峨眉派" )
                npcs += ({ user });
        }
    else// emeid记录每个还存在的NPC的object指针
        npcs = query_temp( "npc/峨眉弟子" );
    return npcs;
}
///////////////////////////////////////////////////////////////////////
class Pair GetBestXiuweiType( object who )
{
    class Pair xiuwei = new( class Pair );
    string * xiuwei_type = ({ "blade","sword","whip","short","long","dodge"
        ,"unarmed" });
    string tmp, type;
    int i = 0, j = 0;
    foreach( tmp in xiuwei_type )
    {
        j = who->query_xiuwei_by_type( tmp );
        if ( j > i )
        {
            i = j;
            type = tmp;
        }
    }
    xiuwei->Key = type;
    xiuwei->Value = i;
    return xiuwei;
}
////////////////////////////////////////////////////////////////////////
string GetDayPhase()
{
    int shichen = NATURE_D->QueryShiChen();
    if ( shichen >= 3 && shichen < 5 )
        return "早晨";
    else if ( shichen >= 5 && shichen < 7 )
        return "上午";
    else if ( shichen >=7 && shichen < 10 )
        return "下午";
    else
        return "晚上";
}
//  给出两个人的师门关系（f_ob对t_ob的称呼）
string FamilyRespect( mixed f_ob, mixed t_ob )
{
    int f_age, t_age;
    if ( objectp( f_ob ) )
        f_age = f_ob->query("age");
    else
        f_age = f_ob;
    if ( objectp( t_ob ) )
        t_age = t_ob->query("age");
    else
        t_age = t_ob;
    if ( f_age > t_age )
        return "师妹";
    else
        return "师姐";
}
//  恢复一个人的所有力量
void Full( object who )
{
    int gin, kee, sen, force;
    if ( !who )
        who = previous_object();
    if ( !who )
        return;
    gin = who->query("max_gin");
    kee = who->query("max_kee");
    sen = who->query("max_sen");
    force = who->query("max_force");
    who->set( "eff_gin", gin );
    who->set( "eff_kee", kee );
    who->set( "eff_sen", sen );
    who->set( "gin", gin );
    who->set( "kee", kee );
    who->set( "sen", sen );
    who->set( "force", force );
    who->start_busy(0);
}
