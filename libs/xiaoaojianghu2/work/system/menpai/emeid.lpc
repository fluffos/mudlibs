//  /system/daemon/menpai/emeid.c EMEI_D
//  Edit by Amber On 1997-12-20
//  地区性的DAEMON实际上相当于一个库，保存了各种放到哪儿都不太对的信息。以便
//  可以在任何情况下没有错误地调用到。数据大量可以使用dbase和tmp_dbase变量进行
//  处理
//  Amber reEdit on 1998 Apr ~ July.    Program for XO edition 1.0, 1.5
//  Amber@XO reEdit in 1999.1~2 for XO 1.5~2.0
//  我准备在区域性的DAEMON里加很多东西，把DAEMON变得很大，而相应缩小ROOM，人物
//  和秘密等。附加的各种函数会按照类别单独建立一些.h文件。甚至更多的是一些单独
//  的.c文件，daemon启动时是不调用的，只有用到的时候才会用call_other来调用。这
//  是为了应付一些平时基本上不会调用的程序，比如秘密，大的对话等等。
//  区域性的DAEMON是preload的。由于峨眉派的NPC不多，所以EMEI_D启动时将所有门派
//  弟子一起启动了，并开始按照弟子的所在位置分配，位置固定的调入房间（需要调入
//  的房间正好也不超过10个）。


inherit F_SAVE;
inherit F_DBASE;

#include <emei.h>
#include "emeid.h"
//#include EMEI_DIR "std/emeiskill.h"

