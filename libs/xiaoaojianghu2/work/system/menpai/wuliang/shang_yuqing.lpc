// shang_yuqing.c

inherit NPC;

#include "east_master.h"

string *wugong = ({
	"基本拳法(unarmed)",
    "基本剑法(sword)",
    "基本轻功(jiben-qinggong)",
    "凌霄拿云手(linxiao-shou)",
    "南山六式(nanshan-liushi)",
}); 

string ask_qingjiao(object who);
string ask_wugong(object who);

void create()
{
	set_name("商余庆", ({ "shang yuqing", "shang", "yuqing" }) );

    set("gender", "男性" );
    set("age", 36);
    create_family("无量剑派东宗", 6, "弟子");
    
    set_wugong("unarmed",70,70,1);
    set_wugong("taizu-quan",30);
    set_wugong("wuliang-shenfa",30);
    set_wugong("jiben-qinggong",70,70,1);
    set_wugong("force",40);
    set_wugong("sword",40);
    set_wugong("sword",70,70,1);
    set_wugong("wuliang-jian",30);
    set_wugong("parry",40);
	set_wugong("haoran-zhengqi",30);
    set_xiuwei("unarmed",40);
    set_xiuwei("sword",50);
    
    set("max_force",500);
    set("force",500);
    set("force_factor",5);
    set("combat_exp",20000);

    set( "inquiry", ([
        "请教" : (: ask_qingjiao :),     
        "学习" : (: ask_qingjiao :),
        "职责" : "我同曲连兴负责看守通往后山的要道, 同时我们也传授刚入门的"
				 "师弟们本门的基本武功.",
        "后山" : "后山是本门禁地, 未得掌门人同意, 不能进入.",
        "功夫" : (: ask_wugong :),
        "武功" : (: ask_wugong :),
    ]) );

    setup();
    //carry_object(__DIR__"obj/cloth")->wear();
}

void init() 
{
    add_action("do_leave", "go");
}

int do_leave(string arg)
{
    if ( arg == "eastup" )
	{
    	object me;

      	me = this_player();
      	message_vision("商余庆拦住了$N，说：'后山是本派重地，你请回吧。'\n",me);
      	return 1;
    }
}

string ask_qingjiao(object who)
{
	return "如果掌门人让你来向我请教，我倒是很乐意教你本门基本武功。";
}

string ask_wugong(object who)
{
    if ( random( 100 ) > 70 )
    	return "你可以向我学..." + wugong[ random(sizeof(wugong)) ] + "...";
    else if ( random( 100 ) > 50 )
    	return "要学" + wugong[ random(sizeof(wugong)) ] + "的话，你可以找我。";
    else
        return "你难道不知道入门该学什么基本武功吗？";
}

