        {
        case "bonze":
            if( age < 50 ) return "贫尼";
            else return "老尼";
            break;
        default:
            if( age < 30 ) return "本姑娘";
            else return "老娘";
            break;
        }
            case "无性":
        {
            if( age < 18 ) return "小的";
            else if( age < 50 ) return "咱家";
            else return "咱家";
        break;
        }
    case "男性":
    default:
        switch(ob->query("class"))
        {
        case "bonze":
        case "bonze1" :
            if( age < 18 ) return "小和尚我";
            if( age < 30 ) return "和尚我";
            if( age < 50 ) return "大和尚我";
            else return "老衲";
            break;
        case "taoist":
            return "本山人";
            break;
