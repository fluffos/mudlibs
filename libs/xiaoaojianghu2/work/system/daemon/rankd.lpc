string query_normal(object ob)
{
	int age;
	string str;
        if( stringp(str = ob->query_temp_marks("apply/normal")))
        	return str;
	if( stringp(str = ob->query("rank_info/normal")) )
		return str;

	age = ob->query_age();
	switch(ob->query("gender"))
    {
	case "女性":
        switch(ob->query("class"))
        {
        case "bonze":
            if( age < 18 ) return "小尼姑";
            else if( age <30) return "尼姑";
            else if( age <50 ) return "中年女尼";
            else return "老师太";
            break;
        case "taoist":
            if( age < 18 ) return "小道姑";
            else if( age < 38 ) return "道姑";//加了 8岁，再年轻几年好了。:) by lnwm
            else if( age < 50) return "中年道姑";
            else return "老道姑";
            break;
        case "alchemist":
            if( age < 18 ) return "小仙女";
            else if( age < 38 ) return "女侠";//加了 8岁，再年轻几年好了。:) by lnwm
            else if( age < 50) return "中年女侠";
            else return "侠女";
            break;
        default:
            if( age < 18 ) return "小姑娘";
            else if( age < 38 ) return "姑娘";//这也一样。:) by lnwm
            else if( age < 50 ) return "中年妇女";
            else return "老婆婆";
            break;
        }
            case "无性":
        {
            if( age < 18 ) return "小太监";
            else if( age < 50 ) return "太监";
            else return "太监";
        break;
        }
    case "男性":
    default:
        switch(ob->query("class"))
        {
        case "bonze":
        case "bonze1":
            if( age < 18 ) return "小和尚";
            else if(age < 30) return "年轻和尚";
            else if(age < 50) return "中年僧人";
            else return "大师";
            break;
        case "taoist":
            if( age < 18 ) return "小道士";
            else if( age < 30) return "年轻道士";
            else if( age < 50) return "中年道士";
            else return "老道长";
            break;
        case "fighter":
        case "swordsman":
            if( age < 18 ) return "少侠";
            else if( age < 30) return "侠士";
            else if( age < 50 ) return "中年侠士";
            else return "老英雄";
            break;
       default:
            if( age < 18 ) return "少年";
            else if( age < 30 ) return "小伙子";
            else if( age < 50 ) return "中年壮汉";
            else return "老者";
            break;
       }
    }
}
// new func

string query_me_target(object ob)
{
    int a1, a2;

	if ( objectp(ob) )
	{
        if ( a2 = (int)ob->query("mud_age") )
            a1 = this_player()->query("mud_age");
        else 
        { 	
            a1 = this_player()->query_age();
            a2 = ob->query_age();
		}
	}
    else
	{	
        a1 = this_player()->query_age();
	 	a2 = 0;
	}
			
    switch (ob->query("gender"))
    {
    case "女性" :
        if (a1 >= a2)
            return "妹子";
        else
            return "姐姐";
        break;
    default :
        if (a1 >= a2)
            return "小兄弟";
        else
            return "大哥";
    }
}

string query_target_me(object ob)
{
    int a1, a2;

    if (objectp(ob))
	{
        if ( a2 = (int)ob->query("mud_age") )
            a1 = this_player()->query("mud_age");
        else 
        { 	
            a1 = this_player()->query_age();
            a2 = ob->query_age();
        }
    }
    else
    {
        a1 = this_player()->query_age();
  	 	a2 = 0;
    }
		
    switch (this_player()->query("gender"))
    {
    case "女性" :
        if (a1 >= a2)
            return "姐姐我";
        else
            return "小妹我";
        break;
    default :
        if (a1 >= a2)
            return "愚兄我";
        else
            return "小弟我";
    }
}


