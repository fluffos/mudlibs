string query_rank(object ob)
{
    string str;
    if( ob->is_ghost() ) return HIB "【 孤  魂 】" NOR;
    if( stringp(str = ob->query("rank_info/rank")) )
        return str;
    
    switch(ob->query("gender"))
    {
    case "女性":
        switch(wizhood(ob))
        {
        case "(admin)":		return BMAG RED "【 神  仙 】" NOR;
        case "(arch)":		return BYEL BLU "【 女  神 】" NOR;
        case "(wizard)":		return BCYN YEL "【 仙  女 】" NOR;
        case "(apprentice)":	return BBLU MAG "【 小仙女 】" NOR;
        case "(immortal)":		return BGRN MAG "【 小精灵 】" NOR;
        default:
            if( ((int)ob->query("PKS") > 100) &&
              ((int)ob->query("MKS") > 800 )
              )
                return "【 杀人魔 】";
            switch (ob->query("class"))
            {
            case "kunlun":              return BWHT GRN"【 女剑客 】" NOR;
            case "bonze":		return BYEL MAG"【 尼  姑 】" NOR;
            case "taoist":		return BYEL HIB"【 女  冠 】" NOR;
            case "bandit":		return BBLU BLK"【 女飞贼 】" NOR;
            case "dancer":		return HBBLU RED"【 舞  妓 】" NOR;
            case "scholar":		return HBWHT HIC"【 才  女 】" NOR;
            case "officer":		return HBRED YEL"【 女  官 】" NOR;
            case "fighter":		return HBYEL CYN"【 女武者 】" NOR;
            case "swordsman":	        return HBWHT HIC"【 女剑士 】" NOR;
            case "alchemist":        	return MAG"【 女  侠 】" NOR;
            case "shaman":		return YEL"【 巫  医 】" NOR;
            case "taijian":		return WHT"【 太  监 】" NOR;
            case "weishi":		return YEL"【 东郡侯 】" NOR;
            case "duanshi":     	return HBYEL HIW"【 侍  女 】" NOR;
            case "beggar":		return BYEL BLU"【 女叫化 】" NOR;
            case "qingcheng" :  return CYN"【 女道士 】" NOR;      // add by xli
            default:			return "【 平  民 】" ;
            }
        }
        default:
            switch(wizhood(ob))
            {
            case "(admin)":		return BMAG RED "【 精  灵 】" NOR;
            case "(arch)":		return BRED WHT "【 大  神 】" NOR;
            case "(wizard)":		return BCYN YEL "【 神  仙 】" NOR;
            case "(apprentice)":	return BBLU MAG "【 仙  人 】" NOR;
            case "(immortal)":	return BGRN MAG "【 半  仙 】" NOR;
            default:
                if( ob->query("PKS") > 100)
                    return "【 杀人魔 】";
                switch(ob->query("class"))
                {
                case "bonze":		return BYEL MAG"【 和  尚 】" NOR;
                case "taoist":		return BYEL HIB"【 道  士 】" NOR;
                case "bandit":		return BRED BLK"【 盗  贼 】" NOR;
                case "scholar":	        return HBWHT HIC"【 书  生 】" NOR;
                case "officer":		return HBRED YEL"【 官  差 】" NOR;
                case "fighter":		return HBYEL CYN"【 武  者 】" NOR;
                case "swordsman":	return HBWHT HIC"【 剑  士 】" NOR;
                case "alchemist":	return MAG"【 方  士 】" NOR;
                case "shaman":	        return YEL"【 巫  医 】" NOR;
                case "taijian":		return WHT"【 太  监 】" NOR;
                case "weishi":		return YEL"【 东郡侯 】" NOR;
                case "beggar":		return BYEL BLU"【 叫化子 】" NOR;
                case "duanshi":     	return HBYEL HIW"【 侍  从 】" NOR;
                case "kunlun":          return BWHT  GRN"【 剑  客 】" NOR;
                case "qingcheng" :      return CYN"【 道  士 】" NOR;      // add by xli                
                default:		return "【 平  民 】";
                }
            }
    }
}

string query_zhiye(object ob)
{
    string str;
    if( stringp(str = ob->query("rank_info/zhiye")) )
        return str;
    if ( ob->is_ghost() )
        return "鬼魂";
    switch (ob->query("gender"))
    {
    case "女性":
    switch (wizhood(ob))
    {
        case "(admin)":		return "女神";
        case "(arch)":		return "仙女";
        //case "(wizard)":		return "仙女";
        case "(apprentice)":	return "小仙女";
        //case "(immortal)":		return "仙姑";
        default:
        if ( ((int)ob->query("PKS") > 100) &&
         //   ((int)ob->query("PKS") > (int)ob->query("MKS")) 
           ((int)ob->query("MKS") > 800 )
           )
            return "杀人魔";
        if ( (int)ob->query("thief") > 500 ) return "惯窃";
        switch(ob->query("class"))
        {
        case "kunlun" :     return "女剑客";
        case "bonze":		return "尼姑";
        case "bonze1":      		return "武僧";
        case "taoist":			return "女冠";
        case "bandit":		return "女飞贼";
        case "dancer":		return "舞女";
        case "scholar":		return "才女";
        case "officer":		return "女官";
        case "fighter":		return "女武者";
        case "swordsman":		return "女剑士";
        case "alchemist":		return "女侠";
        case "shaman":		return "巫医";
        case "taijian":		return "太监";
        case "weishi":		return "东郡侯";
        case "duanshi":     		return "侍女";
        case "beggar":		return "叫化子";
        case "qingcheng" :  return "女道士";      // add by xli        
        default:			return "平民";
        }
    }
	default:
        switch(wizhood(ob))
        {
        case "(admin)":		return "天神";
        case "(arch)":		return "神仙";
        //case "(wizard)":		return "神仙";
        case "(apprentice)":	return "仙人";
        //case "(immortal)":		return "半仙";
        default:
            if( ((int)ob->query("PKS") > 100) &&
          //      ((int)ob->query("PKS") > (int)ob->query("MKS")) 
              ((int)ob->query("MKS") > 800 )
              )
                return "杀人魔";
            if( (int)ob->query("thief") > 500 ) return "惯窃";
            switch(ob->query("class"))
            {
            case "bonze":		return "僧人";
            case "bonze1":    	return "武僧";
            case "taoist":		return "道士";
            case "bandit":		return "盗贼";
            case "kunlun" :     return "剑客";
            case "scholar":		return "书生";
            case "officer":		return "官差";
            case "fighter":		return "武者";
            case "swordsman":	return "剑士";
            case "alchemist":	return "方士";
            case "shaman":		return "巫医";
            case "taijian":		return "太监";
            case "weishi":		return "东郡侯";
            case "duanshi":    	return "侍从";
            case "beggar":		return "叫化子";
            case "qingcheng" :  return "道士";      // add by xli                    
            default:			return "平民";
            }
        }
    }
}

string query_respect(object ob)
{
    int age;
    string str;
    
    if( stringp(str = ob->query("rank_info/respect")) )
        return str;

    age = ob->query_age();
    switch(ob->query("gender"))
    {
    case "女性":
        switch(ob->query("class"))
        {
        case "bonze":
        	if( age < 20 ) return "小师太";
            else return "师太";
            break;
        case "taoist":
            if( age < 20 ) return "小仙姑";
            else return "仙姑";
            break;
        case "alchemist":
            if( age < 20 ) return "小仙女";
            else return "仙女";
            break;
        default:
            if( age < 18 ) return "小姑娘";
            else if( age < 50 ) return "姑娘";
            else return "老婆婆";
        break;
        }
    case "无性":
        {
            if( age < 18 ) return "小家伙";
            else if( age < 50 ) return "公公";
            else return "公公";
        break;
        }
    case "男性":
    default:
        switch(ob->query("class")) {
        case "bonze":
        case "bonze1" :
            if( age < 20 ) return "小师父";
            else return "大师";
            break;
        case "taoist":
            if( age < 18 ) return "道兄";
            else return "道长";
            break;
        case "scholar":
            if( age < 18 ) return "小官人";
            else if( age < 50 ) return "官人";
            else return "老先生";
            break;
        case "fighter":
        case "swordsman":
            if( age < 18 ) return "小兄弟";
            else if( age < 50 ) return "壮士";
            else return "老前辈";
            break;
        default:
            if( age < 18 ) return "小兄弟";
            else if( age < 50 ) return "壮士";
            else return "老爷子";
            break;
        }
    }
}

string query_rude(object ob)
{
    int age;
    string str;

    if( stringp(str = ob->query("rank_info/rude")) )
    	return str;

    age = ob->query_age();
    switch(ob->query("gender"))
    {
    case "女性":
        switch(ob->query("class"))
        {
    case "bonze":    return "贼尼"; break;
    case "taoist":   return "妖女"; break;
    case "alchemist":   return "妖女"; break; 
    default:
        if( age < 18 ) return "小贱人";
        if( age < 30 ) return "贱人";
        else return "死老太婆";
        break;
    }
    case "无性":
        {
            if( age < 18 ) return "小太监";
            else if( age < 50 ) return "死太监";
            else return "死太监";
        break;
        }
    case "男性":
    default:
        switch(ob->query("class"))
        {
        case "bonze":
        case "bonze1" :
            if( age < 18 ) return "小秃驴";
            if( age < 30 ) return "秃驴";
            if( age < 50 ) return "死秃驴";
            else return "老秃驴";
            break;
        case "taoist":
            if( age < 30 ) return "牛鼻子";
            return "死牛鼻子";
            break;
        default:
            if(age < 18)
                return "小王八蛋";
            if(age < 50)
                return "臭贼";
            return "老匹夫";
            break;
        }
    }
}

string query_self(object ob)
{
    int age;
    string str;

    if( stringp(str = ob->query("rank_info/self")) )
        return str;

    age = ob->query_age();
    switch(ob->query("gender"))
    {
    case "女性":
        switch(ob->query("class"))
        {
        case "bonze":
            if( age < 50 ) return "贫尼";
            else return "老尼";
            break;
        default:
            if( age < 25 ) return "小女子";
            else return "妾身";
            break;
        }
            case "无性":
        {
            if( age < 18 ) return "小人";
            else if( age < 50 ) return "咱家";
            else return "咱家";
        break;
        }
    case "男性":
    default:
        switch(ob->query("class"))
        {
        case "bonze":
		    if( age < 50 ) return "贫僧";
            else return "老衲";
            break;
        case "taoist":
            return "贫道";
            break;
        default:
            if( age < 50 ) return "在下";
            else return "老头子";
            break;
        }
    }
}

string query_self_respect(object ob)
{
    int age;
    string str;

    if( stringp(str = ob->query("rank_info/self_respect")) )
        return str;

    age = ob->query_age();
    switch(ob->query("gender"))
