// /system/daemon/network/services/finger.c
// for XO object lib 1.5
// the 'daemon' handling the who request and reply.
// created by nerd@xo 98-5-2
// Last modified : 98-5-2

#define SERVICE_FINGER

void eventReceiveFingerRequest(string mud, string from, string to, mixed * data)
{
    mixed * writeback = FINGER_D->GetRemoteFinger( data[0] );
    if ( ! writeback || !sizeof ( writeback ) )
    {
        SendToUser( "error", mud, from,
                ({ "unk-user", "没有这个玩家：" + capitalize(data[0]) }) );
        return;
    }
    //NBUG ( writeback );
    SendToUser( "finger-reply", mud, from, writeback );
}

void eventReceiveFingerReply(string mud, string from, string to, mixed * packet)
{
    object caller;
    string msg;

    if ( ! caller = find_player( to ) )
        return;
    if ( sizeof ( packet ) < 9 )
    {
        SendToMud( "error", mud, ({ "你送到XO的finger-reply数据包不全。" }) );
        return;
    }
    msg = "来自" + mud + "的关于玩家" + packet[8] + "信息：\n"; // 14: extra info: id
    msg += "英文代号：" + (string)packet[8] + "\n";
    msg += "姓    名：" + (string)packet[0] + "\n";
    msg += ("权限等级：" + ((string)packet[7]?packet[7]:"未知") + "\n");
    msg += ("电子邮件地址：" + ((string)packet[3]?packet[3]:"未知") + "\n");
    msg += ("上次连线地址：" + ((string)packet[4]?packet[4]:"未知") + "\n");
    if ( (int) packet[5] == -1 )
        msg += "目前不在线上。\n";
    else
        msg += "目前正在连线中。\n";
    message("vision", msg, caller);
}

void eventSendFingerRequest(string fingerwho,  string mud)
{
    SendToMud( "finger-req", mud,({ fingerwho }) );
}
