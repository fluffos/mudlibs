// the 'daemon' handling the who request and reply.
// created by nerd@xo 98-5-2
// Last modified : 98-5-2
#define SERVICE_WHO

#include <ansi.h>

void eventReceiveWhoRequest(string mud, string from, string to, mixed *packet) {
  mixed *userinfo = ({});
  if (!sizeof(users()))           // no user on line
  {
    SendToUser("who-reply", mud, from, ({}));
    return;
  }
  foreach (object ob in users()) {
    if (environment(ob)) {
      userinfo += ({ ({ ob->query("name"), query_idle(ob), ob->query("id") }) });
    }
  }
  SendToUser("who-reply", mud, from, userinfo);
}

/*
