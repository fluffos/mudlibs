{
    if ( undefinedp ( MudList->List [ mud ] ) )
        return 0;
    return MudList->List [ mud ];
}
*/

void eventReceiveWhoReply(string mud, string from, string to, mixed *packet) {
  object theppl;
  string line, name;
  int i;
  mixed *mudinfo, *userdata;
  if (!to || !(theppl = find_player(to)))
    return;  // the ppl quit?
    mudinfo = INTERMUD_D->GetMudInfo(mud);      // Get the host info(name)
    if (!mudinfo)
      return;
  line = "目前 ◎" GRN + mudinfo[5] + NOR "◎ 线上的玩家有：\n";
  line += "-------------------------------------------------------------------\n";
  for (i = 0; i < sizeof(packet); i++)  // print the users...with idle time..
  {
    userdata = packet[i];
    name = sprintf(
      "%s(%s)<发呆:%d秒>",
      userdata[0],
      capitalize(userdata[2]),
      userdata[1] > 10 ? userdata[1] : 0
    );
    line += sprintf("%-35s%s", name, (i % 2 != 1) ? "" : "\n");
  }
  if (i % 2)
    line += "\n";
  line += "-------------------------------------------------------------------\n";
  line + "共有" + chinese_number(sizeof(userdata)) + "使用者连线中。\n";
  message("vision", line, theppl);
}

void eventSendWhoRequest(string targetmud) {
  SendToMud("who-req", targetmud, ({}));
}
