string chinese_season(int season)
{
    return c_season[ season - 1 ];
}

string chinese_time(mixed local)
{
    if ( !arrayp( local ) )
//      local = localtime( (int) local );//原来的。
        local = NATURE_D->RealTime( (int) local );
	if( local[ND_SHIKE ] == 0 )
	    return sprintf( "%s时整",
            sym_dee [ local[ ND_SHICHEN ] ],
		    );
	else
	    return sprintf( "%s时%s刻",
            sym_dee [ local[ ND_SHICHEN ] ],
		    chinese_number( local[ ND_SHIKE ] )
		    );
}
