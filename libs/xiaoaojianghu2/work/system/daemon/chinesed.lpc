#include <localtime.h>

#define ND_YEAR         0
#define ND_SEASON       1
#define ND_MONTH        2
#define ND_DAY          3
#define ND_SHICHEN      4
#define ND_SHIKE        5
#define ND_MIN          6

#define DICTIONARY DATA_DIR + "daemon/chinese"

inherit F_SAVE;

private nosave string *c_digit =
	({ "零","十","百","千","万","亿","兆" });
private nosave string *c_num =
	({ "零","一","二","三","四","五","六","七","八","九","十"});
private nosave string *sym_tien =
	({ "甲","乙","丙","丁","戊","己","庚","辛","壬","癸" });
private nosave string *sym_dee =
	({ "子","丑","寅","卯","辰","巳","午","未","申","酉","戌","亥" });
private nosave string *c_season =
    ({ "春","夏","秋","冬" });

