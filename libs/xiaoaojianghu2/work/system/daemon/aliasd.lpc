// filename : /adm/daemons/aliasd.c

// checked by lnwm&nerd 98/01/20

mapping global_alias = 
([
    "l":    "look",
    "n":    "go north",
    "e":    "go east",
    "w":    "go west",
    "s":    "go south",
    "nu":    "go northup",
    "eu":    "go eastup",
    "wu":    "go westup",
    "su":    "go southup",
    "nd":    "go northdown",
    "ed":    "go eastdown",
    "wd":    "go westdown",
    "sd":    "go southdown",
    "ne":    "go northeast",
    "se":    "go southeast",
    "nw":    "go northwest",
    "sw":    "go southwest",
    "u":    "go up",
    "d":    "go down",
    "i":    "inventory",
    "sha":  "kill",
    "qiecuo":"fight",
    "sc":"score",
    "sk":"skills",
    "sa":"skills",
    "o":"out",
    "oo":"chat& 很高兴的说：“今天晚上我做东，报告大家吃圈圈。”",
]);

string process_global_alias(string arg)
{
    string *word;

    //if ( arg[ 0 ] == '\'' ) 
        //return "say " + arg[ 1..strlen( arg ) - 1 ];
    switch(arg[0])
    {
        case '\'':
            return "say " + arg[1..];
            break;
        case '/':
            if (newbiep(this_player()))
                return "new " + arg[1..];
            else
                return "chat " + arg[1..];
            break;
        case '"':
            if (newbiep(this_player()))
                return "new* " + arg[1..];
            else
                return "chat* " + arg[1..];
            break;
    }

    word = explode( arg, " " );
    if ( sizeof(word) && !undefinedp(global_alias[ word[ 0 ] ]) ) 
    {
        word[ 0 ] = global_alias[ word[ 0 ] ];
        return implode( word, " " );
    }

    return arg;
}
