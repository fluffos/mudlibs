// 玩家自创组织的入口daemon

inherit F_SAVE;
inherit F_DBASE;

string query_save_file();
int auto_save();
int SAVE_TIME = 300;
void create() {
  seteuid(getuid());
  set("name", "组织精灵");
  set("id", "orgnized");
  restore();
  call_out("auto_save", SAVE_TIME);
}

string query_save_file() {
  return DATA_DIR + "daemon/organized";
}

int auto_save() {
  save();
  CHANNEL_D->do_channel(this_object(), "sys", "组织精灵自动存储完毕！");
  call_out("auto_save", SAVE_TIME);
}
