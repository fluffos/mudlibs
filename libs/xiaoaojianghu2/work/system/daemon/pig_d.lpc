//寻猪的记录。
//modified by xli

#include <ansi.h>
#define PIG_DIR "/log/find_pig/"
inherit F_DBASE;
int status=0;

void create()
{
    seteuid(ROOT_UID);
    set("name", "记录精灵");
    set("id", "pig_d");
}

int do_read_me( object me )
{
	string filename=PIG_DIR+me->query("name");
	int i,number;
	string str;
	if(file_size(filename)<=0)
		return 0;
	str=read_file(filename);
	i=sscanf(str,"%d",number);
	return number;	
}

int do_write_me( object me, int number )
{
	string filename=PIG_DIR+me->query("name");
	return write_file(filename,sprintf("%d",number),1);
}

int do_read_all()
{
	string filename=PIG_DIR"pig_all";
	int i,number;
	string str;
	if(file_size(filename)<=0)
		return 0;
	str=read_file(filename);
	i=sscanf(str,"%d",number);
	return number;
}

int do_write_all(int number)
{
	string filename=PIG_DIR"pig_all";
	return write_file(filename,sprintf("%d",number),1);
}

int do_write_reward(string str)
{
	string filename=PIG_DIR"reward_log";
	return write_file(filename,str);
}

void do_start_game()
{
	status=1;
}

int query_start_game()
{
	return status;
}

void do_stop_game()
{
	status=0;
}

int do_read_number()
{
	string filename=PIG_DIR"reward_number";
	string str;
	int i,number;
	if(file_size(filename)<=0)
		return 0;
	str=read_file(filename);
    i=sscanf(str,"%d",number);
    return number;
}

