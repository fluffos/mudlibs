// 登录失败的函数:)
void die( object ob )
{
//    write( RED"\n登录失败：原因：" + BAN_D->get_last_error() + "\n\n"NOR );
    destruct( ob );
}

void StartLogon( object ob )
{
    int hour, users;

    if ( BAN_D->IsBannedSite( query_ip_number( ob ) ) )
        return die(ob);

    cat(WELCOME); //"/system/etc/title");
    printf("\n");
    // add by lnwm 98-08-25
    hour = (time() % 86400) / 3600 + 8; // 东八区
    if( hour>5 && hour<=11 )
        printf(YEL"早上好！欢迎光临笑傲江湖！\n"NOR);
    else if( hour>11 && hour<=13 )
        printf(YEL"中午好！欢迎光临笑傲江湖！\n"NOR);
    else if( hour>13 && hour<=18 )
        printf(YEL"下午好！欢迎光临笑傲江湖！\n"NOR);
    else if( hour>18 && hour<=24 )
        printf(YEL"晚上好！欢迎光临笑傲江湖！\n"NOR);
    else
        printf(YEL"你好！感谢你在深夜光临笑傲江湖，不过请注意休息。\n"NOR);

#ifdef LOGIN_DELAY
    if ( time() - startup_time < LOGIN_DELAY_TIME )
    {
        printf(YEL"对不起，为了系统稳定，请在系统起动 %d 秒后再登录。\n"NOR,
                LOGIN_DELAY_TIME);
        destruct(ob);
        return;
    }
#endif

    if ( wiz_lock_level > 0 )
        printf(RED "           >>> 本ＭＵＤ暂时关闭，只有巫师等级" +
            chinese_number( wiz_lock_level )+ "的用户可以连线。 <<<\n" NOR );

    printf("笑傲江湖从二⊙⊙三年四月一日以来已经有"GRN"%s"NOR"人次登录。\n",
                STATIC_D->GetLoginStatus() );
    if ( uptime() < 10 )
        printf( YEL + mud_name() + "刚启动" );
    else
        printf( YEL + mud_name() + "已经运行了" + UPTIME_CMD->main() );

    if ( users = sizeof( filter( users(), (:environment($1):) ) ) )
        printf( "，目前共有%s位玩家在这个世界中。"NOR"\n",
            chinese_number( users) );
    else
        printf( "，目前没有玩家连线。\n" );

    printf(CYN"您好，请输入您的英文名字。(如果要新建一个人物，请输入new)\n"NOR);
    printf(CYN"您的英文名字："NOR);
    input_to( (: get_id :), ob );
}

protected void get_id(string arg, object ob)
{
    if (arg == "")
    {
        write("那么好吧，欢迎下次再来。\n");
        destruct (ob);
        return;
    }
    arg = lower_case(arg);

#ifdef MAX_USERS
    if ( !wiz_level(arg) && sizeof(filter(users(),(:environment($1):)) ) >= MAX_USERS )
    {
        object ppl = find_body( arg );

        // Only allow reconnect an interactive player when MAX_USERS exceeded.
        if ( !ppl || !interactive( ppl ) || !wizardp( ob ) )
        {
            write(YEL "对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来。\n" NOR);
            destruct( ob );
            return;
        }
    }
#endif

    if ( wiz_level(arg) < wiz_lock_level ) //&& !ALLOW_D->is_allowed(arg) )
    {
        write(RED "对不起，" + MUD_NAME + "目前限制神仙等级 " +
                        wiz_lock_level + " 以上的人才能连线。\n" NOR);
        destruct(ob);
        return;
    }
    switch( arg )
    {
        case "quit":
            printf("记得下次再来！\n");
            destruct(ob);
            return;
        case "new":
            if ( BAN_D->IsTimeAllowed(ob) )//5 min 才准有一个。
            {
                if ( 1 )
                {
                    printf("欢迎光临" + mud_name() +"\n");
                    printf("请选择你的英文名字：");
                    input_to( (: GetNewId :), ob );
                return;
                }
                else
                    return die(ob); // 告之 multi not allowed
            }
            return die(ob); // 告之 time not allowed
        case "guest":    // we should check dup ip ah?
            ob->set("id","guest");
            if ( 1 )
                confirm_id("Yes", ob);
            else
                return die(ob);
            return;
        default:
            if ( (string)ob->set("id", arg) != arg )
            {
                write(RED "Failed setting user name.\n" NOR);
                destruct(ob);
                return;
            }
            if ( file_size(ob->query_save_file() + __SAVE_EXTENSION__) <= 0 )
                printf("对不起，这个id还没有登录过，请用new来起用这个id.\n");
            else
            {
                BeginLogin(arg, ob);
                return;
            }
    }
    printf(CYN"您的英文名字；"NOR);
    input_to( (: get_id :), ob );
}

void BeginLogin(string arg, object ob)
{
    if ( !BAN_D->IsLegalID(arg) )
        return die(ob);
        
//    if ( BAN_D->IsMultiLogin(arg,ob) )
//        return die(ob);

    if ( ob->restore() )
    {
        write(BLU "请输入您的密码：" NOR);
        input_to("get_passwd", 1, ob, 1);
    }
    else
    {
        write(YEL"您的角色存盘数据出了问题，请利用 guest 通知神仙处理。\n"NOR);
        write(YEL"或者emailto:  locker@china.com.cn  陈述。\n"NOR);
        destruct(ob);
    }
}

protected nomask void get_passwd(string pass, object ob, int repeat)
{
    string my_pass, msg;
    object user;
    
    write("\n");
    
    if ( my_pass = ob->query("password") )
    {
        ob->set_passwd( my_pass );
        //ob->delete("password");
        ob->save();
    }
    else
        my_pass = ob->get_passwd();
              
    if ( crypt(pass, my_pass) != my_pass )
    {
        if ( repeat >= 3 )
        {
            write("还是不对。。。\n如果真的忘了或者被改，请emailto: locker@china.com.cn \n\n");
//            CHANNEL_D->do_channel( this_object(), "sys",
//                ob->query("id") + " cast wrong passwd at [ " + query_ip_name(ob) 
//                + " ]" );
            if ( wiz_level( ob->query("id") ) )
            {
                msg = sprintf("%s error login at %s from %s\n",
                    ob->query("id"), ctime(time()), query_ip_name( ob ) );
                log_file( WIZ_LOGIN_ERR_LOG, msg );
            }
            destruct(ob);
            return;
        }
        printf("嗯，我再给你一次机会。\n请输入密码：");
        input_to( (: get_passwd :), 1, ob, repeat +1 );
        return;
    }

//    if (BAN_D->IsMultiLogin(ob->query("id"),ob))
//        return die(ob);
        
    user = find_body( ob->query("id") );

    if ( user )
    {
        if ( user->query_temp("netdead") )
        {
            reconnect(ob, user);
            return;
        }
        write(YEL"您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)"NOR);
        input_to("confirm_relogin", ob, user);
        return;
    }

    user = make_body(ob);
    if ( objectp(user) )
    {
        if ( user->restore() )
        {
            log_login( ob, user, "%s(%s) loggined from %s (%s)\n" );
            enter_world( ob,user);
            //revise_illegal_data( user );
            return;
        }
        else
        {
            write(YEL"您的角色存盘数据出了问题，请利用 guest 通知神仙处理。\n"NOR);
            write(YEL"或者emailto:  locker@china.com.cn 陈述。\n"NOR);
            destruct(user);
        }
    }
    write(HIW "请您重新创造这个人物。\n" NOR);
    confirm_id("y", ob);
}

protected void confirm_relogin(string yn, object ob, object user)
{
    object old_link;

    if ( yn == "" )
    {
        write(YEL "您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)" NOR);
        input_to("confirm_relogin", ob, user);
        return;
    }

    if ( yn[0] != 'y' && yn[0] != 'Y' )
    {
        write("好吧，欢迎下次再来。\n");
        destruct(ob);
        return;
    }
    else if (user)
    {
        message("system",HIW "有人从别处( " + query_ip_name(ob)
                + " )连线取代你所控制的人物。\n" NOR, user);
        log_login( ob, user, "%s(%s) replaced by %s (%s)\n" );
    }

//    if (BAN_D->IsMultiLogin(ob->query("id"),ob))
//        return die(ob);

    // Kick out tho old player.
   if ( user->is_html_user() ) // html support - be nerd 99.8
   {
   	destruct(ob);
        return;}
    else
  {
        old_link = user->query_temp("link_ob");
        if ( old_link )
        {
            exec(old_link, user);
            destruct(old_link);
        }
    }

    reconnect(ob, user);
}

// begin new player section.
protected void GetNewId(string id, object ob)
{
    if ( ! id || id == "quit" )
    {
        printf("欢迎下次再来。\n");
        destruct(ob);
        return;
    }
	id = lower_case(id);
    if ( !BAN_D->IsLegalID( id ) )
    {
        write("非法名字：" + BAN_D->get_last_error() + "\n请重新选择您的英文名字：");
        input_to((: GetNewId :), ob);
        return;
    }
    if ( (string)ob->set("id", id) != id )
            {
                write(RED "Failed setting user name.\n" NOR);
                destruct(ob);
                return;
            }
    if ( file_size(ob->query_save_file() + __SAVE_EXTENSION__) > 0 ||
            0 != find_object( id ) )
    {
        printf("这个名字已经有人使用了，请换一个别的：");
        input_to( (:GetNewId:), ob );
        return;
    }
    if ( (string) ob->set( "id", id ) != id )
    {
        printf("Fail to set user id...\n");
        destruct(ob);
        return;
    }
    printf(YEL "使用%s这个名字将会在笑傲江湖中创造一个新的生命，您确定吗(y/n)？" NOR,
        capitalize(lower_case(id)) );
    input_to( (: confirm_id :), ob );
}

protected void confirm_id(string yn, object ob)
{
    if ( yn == "" )
    {
        write(YEL "使用这个名字将会在笑傲江湖中创造一个新的生命，您确定吗(y/n)？" NOR );
        input_to("confirm_id", ob);
        return;
    }

    if ( yn[0] != 'y' && yn[0] != 'Y' )
    {
        write(HIW "好吧，那么请给您的角色重新起个英文名字：" NOR);
        input_to("GetNewId", ob);
        return;
    }

    write(@TEXT

    那么请您为您即将在XO MUD里使用的新生命起一个中文名字吧!!您
可以用这个名字赋予他（她）与众不同的个性和气质。要注意，您起的
名字不要太古怪，不要金庸小说里人物的名字，更不要取一些不雅或容
易造成他人困惑的名字，否则XO将视情况要求你修改你的名字。
TEXT);
    write( HIR"    名字一旦输入就终生不能再自行修改，请务必慎重。\n\n" NOR);
    write(HIW "您的中文名字：" NOR);
    input_to("get_name", ob);
}

protected void get_name(string arg, object ob)
{
    if (!BAN_D->IsLegalName(arg) )
    {
        write( "非法的中文名：" + BAN_D->get_last_error() + "\n您的中文名字：" );
        input_to("get_name", ob);
        return;
    }

    ob->set("name", arg);
    write( "请设定您的密码：" );
    input_to("new_password", 1, ob);
}


protected void new_password(string pass, object ob)
{
    write("\n");
    if ( strlen(pass) < 6 )
    {
        write( "密码的长度至少要六个字符，请重设您的密码：" );
        input_to("new_password", 1, ob);
        return;
    }
    ob->set_passwd( crypt(pass,0) );
    write( "请再输入一次您的密码，以确认您没记错：" );
    input_to("confirm_password", 1, ob);
}

protected void confirm_password(string pass, object ob)
{
    string old_pass;

    write("\n");
    old_pass = ob->get_passwd();
    if ( crypt(pass, old_pass) != old_pass )
    {
        write( "您两次输入的密码并不一样，请重新设定一次密码：" );
        input_to("new_password", 1, ob);
        return;
    }

    write( "您的电子邮件地址：" );
    input_to("get_email",  ob);
}

protected void get_email(string email, object ob)
{
    object user;

    if (email == "" || !strsrch(email,"@") || !strsrch (email,".") || strlen(email) < 8|| strlen(email) >20 )
    {
        write("您的电子邮件地址是不正确的，请重新输入：");
        input_to("get_email",ob);
        return;
    }
    ob->set("email", email);

    // If you want do race stuff, ask player to choose one here, then you can
    // set the user's body after the question is answered. The following are
    // options for player's body, so we clone a body here.
    ob->set("body", USER_OB);
    user = make_body(ob);
    if ( !objectp( user ) )
        return;

    write(HIW "您要扮演男性(m)的角色或女性(f)的角色？" NOR);
    input_to("get_gender", ob, user);
}

protected void get_gender(string gender, object ob, object user)
{
    if ( gender == "" )
    {
        write(YEL "您要扮演男性(m)的角色或女性(f)的角色？" NOR);
        input_to("get_gender", ob, user);
        return;
    }

    if ( gender[0] == 'm' || gender[0] == 'M' )
        user->set("gender", "男性");
    else if ( gender[0] == 'f' || gender[0] == 'F' )
        user->set("gender", "女性" );
    else
    {
        write("好主意，不过目前你只能选择做男的或者女的。\n");
        write("你到底要那一种呢？(f/m):");
        input_to("get_gender", ob, user);
        return;
    }

    log_login( ob, user, "%s(%s) was created from %s (%s)\n" );
    init_new_player(user);
    enter_world(ob,user);
}

object make_body(object ob)
{
    string err;
    object user;
    //int n;

    user = new(ob->query("body"));
    if (!user)
    {
        write("现在可能有人正在修改使用者对象的程序，无法进行复制。\n");
        write(err+"\n");
        return 0;
    }
    seteuid(ob->query("id"));
    export_uid(user);
    export_uid(ob);
    seteuid(getuid());
    user->set("id", ob->query("id"));
    user->set_name( ob->query("name"), ({ ob->query("id")}) );
    return user;
}

protected void init_new_player(object user)
{
    user->set("title", "普通百姓");
    user->set("birthday", time() );

    user->set("str", 10 + new_random());
    user->set("cps", 10 + new_random());
    user->set("int", 10 + new_random());
    user->set("cor", 10 + new_random());
    user->set("con", 10 + new_random());
    user->set("spi", 10 + new_random());
    user->set("per", 10 + new_random());
    user->set("kar", 10 + new_random());
    user->set("dex", 10 + new_random());

    user->set("food", ((int)user->query("str")+10)*10);
    user->set("water",((int)user->query("str")+10)*10);

    user->set("channels", ({ "new", "chat", "rumor", "family", "sysinfo" ,"xo"}) );
        // add sysinfo channels at start by akuma on 1999/8/20
    user->set("max_age", select_max_age( user ) );
//  user->set("social_exp", 50);
//  user->set("combat_exp", 100);
}

// required function: to press enter.
void do_nothing()
{
}

varargs void enter_world(object ob, object user, int silent)
{
    object cloth;
    object mb;
    string startroom;
    int * screen;
    int i;
    int allmoney=0,invmoney=0;

    object* things;

    user->set_temp("link_ob", ob);
    ob->set_temp("body_ob", user);
    exec(user, ob);
//    write("目前权限：" + wizhood(user) + "\n");
    user->setup();
    if (user->query("peaceful"))
    if (BAN_D->IsMultiLogin(user->query("id"),user))
        {
        write( RED"\n登录失败：原因：" + BAN_D->get_last_error() + "\n\n"NOR );
        destruct( user );	
        return;
        }    
    // In case of new player, we save them here right after setup
    // compeleted.
    user->set("last_save_time",time());// autosave requires.
    //lin:here needs modify:add more kind of cloth.
    if( !user->is_ghost() )
    {
        switch( user->query("family/family_name") )
        {
            case "少林派" :
                cloth = new(CLOTH_DIR + "sengyi1");
                break;
             case "峨嵋派" :
                cloth = new("/clone/wear/skirt/bailing_qunzi");
                break;    
             case "华山派" :
             	if(user->query("gender")=="男性")
                cloth = new("/d/menpai/huashan/npc/obj/xuesongshan");
                else
                cloth = new("/d/menpai/huashan/npc/obj/xuesongqun");              
                break;   
            default:
                cloth = new(CLOTH_DIR + "cloth1");
                break;
         }
        cloth->move(user);
        cloth->wear();
        //xli 2000.9.7 add for mailbox
        mb = new("/clone/misc/box");
        mb->move(user);
//        kouzhao = new("/clone/wizard/kouzhao");
 //       kouzhao->move(user);
 //       kouzhao->wear();
        //xli end
    }
        screen = (int *)ob->GetScreen();
    if (screen)
        user->SetScreen(screen[0], screen[1]);
    if ( !silent )
    {
        cat(MOTD);
        if ( wizardp(user))
        {
              cat(SYSTEM_CONFIG_DIR "wizmotd");
/*              if(user->query("id")=="locker" || user->query("id") == "zhaoke")
              if (strsrch(read_file("/etc/wizip"), user->query("id")+"*"+query_ip_number(user))==-1 )
              {destruct(user);
              return;}
*/        }      
        if ( ob->query("last_on") )
        write(sprintf("你上次是在 "YEL"%s"NOR" 从 "YEL"%s"NOR
                       " 连往「笑傲江湖」。\n",
                    ctime(ob->query("last_on")), ob->query("last_from")));
        ob->set("last_on", time());
      
        write("————————\n");
        input_to( (: do_nothing :) );
        // 这里程序继续运行, 但输出信息被屏蔽..暂时缓存
        write("————————\n");        
        input_to( (: do_nothing :) );              
        if ( user->is_ghost() && !wizardp(user) )
            startroom = DEATH_ROOM;
        else if ( !stringp(startroom = user->query("startroom")) )
        {
            startroom = select_start_room(user);
            rm( LOG_D->query_log_file( user->query("id") ) );
            LOG_D->do_log( user, sprintf("你充满传奇色彩的一生就从%s开始。",
                load_object( startroom )->query("short") ));
        }
        if ( catch(load_object(startroom)) )
        {
            startroom = select_start_room(user);
            user->set("startroom", startroom);
        }
        if (newbiep(user))
        user->move("/d/place/newbie/start");
        else
        user->move(startroom);
        //user->eventLogin();
        //replace_some_mark( user );
        MARRY_D->check_will_marry( user );
        MARRY_D->check_marriage( user );
        tell_room(startroom, user->query("name") +
                        "蹑手蹑脚地摸了过来。\n", ({user}));
    }

    //add by lnwm 玩家身上钱数的最大限制。990902
    //newbie 10gold player 50gold high_mortal 100gold
    allmoney = user->query("savemoney");
    
    things=all_inventory(user);
    for(i=0;i<sizeof(things);i++)
    {
        if(things[i]->query("id")=="thousand-cash" 
        || things[i]->query("id")=="gold"
        || things[i]->query("id")=="silver"
        || things[i]->query("id")=="coin")
        {
            invmoney = invmoney+things[i]->value();
        }
    }
    allmoney += invmoney;
    if(newbiep(user) )
    {   if( allmoney > 1000000)
        {
        foreach(object obj in things)
        {
            if( obj ->value() )
                destruct(obj);
        }
        user->set("savemoney",1000000);
         write(RED"最近发行新版货币，系统已经替你自动兑换所有的旧版货币，
并存入钱庄，请注意查收。\n"NOR);
        }
     }
    else if(high_mortalp(user) )
    {   if( allmoney > 10000000)
        {
        foreach(object obj in things)
        {
            if( obj ->value() )
                destruct(obj);
        }
        user->set("savemoney",10000000);
         write(RED"最近发行新版货币，系统已经替你自动兑换所有的旧版货币
，并存入钱庄，请注意查收。\n"NOR);
        }
     }
    else 
    {
        if(allmoney > 5000000)
        {    
        foreach(object obj in things)
        {
            if( obj ->value() )
                destruct(obj);
        }
        user->set("savemoney",5000000);
         write(RED"最近发行新版货币，系统已经替你自动兑换所有的旧版货币
,并存入钱庄，请注意查收。\n"NOR);
        }
     }
     //till here
    if( !wizardp( user ) )
    {
        STATIC_D->try_top(user);
    }
//add by lnwm for some problem
if( user->query("age") > 200 )
	user->add("mud_age",-35078400);

    CHANNEL_D->do_channel( this_object(), "sys",
        sprintf("%s(%s)login from %s.", user->name(), geteuid(user),query_ip_name(user)) );
    if(avatarp(user))
CHANNEL_D->do_channel( this_object(), "xo",
        sprintf("%s很礼貌的鞠了个躬，说道：“大家好，我又回来啦！”", user->name()) );    
    // 一些扫尾工作。
    // 你能看到系统信息频道么？如果不能，我来帮帮你吧 hehe :)
 /*   chl=user->query("channels");
    if( member_array("sysinfo",chl) == -1)
    {
        chl += ({ "sysinfo" });
        user->set("channels", chl);
    }
 */   user->save();
    ob->save();
    // changed for old players to add sysinfo by akuma on 1999/8/20
    UPDATE_D->check_user(user);
    USER_D->CheckUserLevel(user); // check for high level  ppls
    STATIC_D->AddNewLogin();
    if( !wizardp( user )&&!avatarp(user)&&!user->query("no_top") )
    TOPTEN_D->topten_checkplayer(user);
    write(HIW"敬请关注help new，近期将有大的扩充。\n"NOR);
    if(user->query("age")< 20)
    {
	write(HIR"受不了pk的可以做和平居民，详情 peaceful detail。\n"NOR);	
//	user->unconcious();
    }       
}

varargs void reconnect(object ob, object user, int silent)
{
    user->set_html_user(0);
    user->set_temp("link_ob", ob);
    ob->set_temp("body_ob", user);
    exec(user, ob);

    user->reconnect();
    if ( !silent )
    {
        tell_room(environment(user), user->query("name") +
                        "轻轻地张开了双眼。\n", ({user}));
    }
    CHANNEL_D->do_channel( this_object(), "sys",
        sprintf("%s(%s) relogin from %s.", user->query("name"),
                geteuid(user), query_ip_name(user)) );
    UPDATE_D->check_user(user);
}

object find_body(string id)
{
    mixed user = find_player(id);
    if (user)
        return user;
    //user = filter(children(HTML_USER_OB), (: clonep($1) &&
     //           getuid($1) == $(id) :) );
    //if ( !sizeof(user) )
    user = filter( children(USER_OB), (: clonep($1) &&
                    getuid($1) == $(id) :) );
    if (sizeof(user))
        return user[0];
    return 0;
}

int set_wizlock(int level)
{
    if ( wiz_level(this_player(1)) <= level )
        return 0;
    if ( geteuid(previous_object()) != ROOT_UID )
        return 0;
    wiz_lock_level = level;
    return 1;
}

//Modified hydra 1998/10/05
//给新出生的人加上标记，注明是中原还是西域人
string select_start_room(object user)
{
    string start_room;
    start_room = start_rooms[ random( sizeof( start_rooms ) ) ];
    if ( start_room == "/d/city/gaochang/center" )
    {
        user -> set( "hydra/desert/from","西域" );
    }
    else
    {
        user -> set( "hydra/desert/from","中原" );
    }
    return start_room;
}

void log_login( object ob, object user, string format )
{
    if ( wiz_level( user->query("id") ) )
        log_file( WIZ_USAGE_LOG, sprintf( format,
            user->query("id"), user->query("name"),
            query_ip_name(ob), ctime(time()) ) );
    else
        log_file( PPL_USAGE_LOG, sprintf( format,
            user->query("id"), user->query("name"),
            query_ip_name(ob), ctime(time()) ) );
}

int select_max_age(object user)
{
    int max_age;
    int per, Int, spi, con;

    per = user->query( "per" );
    Int = user->query( "int" );
    spi = user->query( "spi" );
    con = user->query( "con" );
    max_age = BASE_MAX_AGE + new_random();
    max_age -= ( per - 20 ) / 3 + ( Int - 20 ) / 3 + ( spi - 20 ) / 3;
    max_age += con / 6;
    return max_age;
}

