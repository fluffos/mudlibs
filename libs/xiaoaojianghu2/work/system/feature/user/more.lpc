// filename : /feature/more.c

#include <ansi.h>

private nosave string *text;
private nosave int line;
private nosave int fNum = 0;

void refresh(int height)
{
    int i;
    for (i = line + height; line < sizeof(text) && line < i; line ++ )
    {
        if ( fNum )
            printf("%4d ", line + 1);
        printf( "%s\n", text[line] );
    }
}

void EndMore()
{
    text = 0;
    line = 0;
    fNum = 0;
}

void more(string cmd)
{
    int i;
    int height = this_object()->GetScreen()[1];
    if ( !height )
        height = 24;
    height --;

	switch ( cmd )
	{
		case "":
		    refresh(height);
			if ( line >= sizeof( text ) )
			{
			    EndMore();
				return;
			}
			break;

		case "b":
			line = line - height *2;
			if ( line < 0 )
			{
			    EndMore();
			    return;
			}
			refresh(height);
			break;

        case "n":
            if ( wizardp(this_player()) )
            {
                fNum = !fNum;
                line -= height;
                if (line < 0)
                    line = 0;
            }
            refresh(height);
            break;

		case "q":
		    EndMore();
			return;
		
		default:
		    if ( wizardp(this_player()) )
		    {
		        if( sscanf(cmd, "g %d", i) == 1 )
		        {
		            if ( i < 0 || i > sizeof (text) )
		            {
		                printf("行号超出范围。最大为：%d。\n",sizeof(text) + 1);
		            }
		            else
		            {
		                line = i - height / 2;
		                if ( line < 0 )
		                    line = 0;
		                refresh (height);
		            }
		        }
		    }
	}
	printf( BBLU " == 下面还有哦 " YEL "%d%%" NOR BBLU
	        " == (ENTER 下一页，q 离开，b 上一页 )" NOR,
		    ( line * 100 / sizeof( text ) ) );
	input_to( "more" );
}

void start_more(string msg)
{
    text = explode (msg, "\n" );
    line = 0;
	more( "" ); //, explode( msg, "\n" ), 0 );
}
