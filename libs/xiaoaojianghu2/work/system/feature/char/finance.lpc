// can_afford() checks if this_object() can afford a price, it returns:
//
//      0:      cannot afford.
//      1:      can afford with proper money(coins).
//      2:      如果身上的硬通货不够，但是有银票 return 2。
//
int can_afford(int amount)
{
	int total;
    object gold, silver, coin, cash, this;

    this = this_object();
    // 如果使用 this 作为参数, ppl 只能使用身上的 money
    // 去买东西, 而不能用 env 中的.
    gold = present("gold_money", this);
    silver = present("silver_money", this);
    coin = present("coin_money", this);
    cash = present("thousand-cash_money", this);

    total = 0;
    if ( gold ) 
		total += gold->value();
    if ( silver ) 
		total += silver->value();
    if ( coin ) 
		total += coin->value();

    if ( total < amount )
    {
	    if ( cash ) return 2;
	    else return 0;
	}

    return 1;
}
// 用来查看玩家身上钱的数量。
// add this by tea 12.6.98
int query_money()
{
    int total;
    object gold, silver, coin, cash, this;

    this = this_object();
    gold = present("gold_money", this);
    silver = present("silver_money", this);
    coin = present("coin_money", this);
    cash = present("thousand-cash_money", this);

    total = 0;
    if ( cash ) 
		total += cash->value();
    if ( gold ) 
		total += gold->value();
    if ( silver ) 
		total += silver->value();
    if ( coin ) 
		total += coin->value();

    return total;
}

int pay_money(int amount)
{
    int total, cashn, gn, sn, cn;
    object cash, gold, silver, coin, this;

    this = this_object();
    cash = present("thousand-cash_money");
    gold = present("gold_money");
    silver = present("silver_money");
    coin = present("coin_money");

    total = 0;
    if ( cash ) total += cash->value();
    if ( gold ) total += gold->value();
    if ( silver ) total += silver->value();
    if ( coin ) total += coin->value();

    if ( total < amount ) return 0;

    total -= amount;

    cashn = total / 1000000;
    total -= cashn * 1000000;
    gn = total /10000;
    total -= gn * 10000;
    sn = total /1000;
    cn = total - sn * 1000;

	if ( cash ) cash->set_amount(cashn);
	else if ( cashn )
        {
		cash = new( MONEY_DIR + "thousand-cash" );
		cash->set_amount( cashn );
		cash->move( this );	
	}
	if ( gold ) gold->set_amount(gn);
	else if ( gn )
        {
		gold = new( MONEY_DIR + "gold" );
		gold->set_amount( gn );
		gold->move( this );	
	}
	if ( silver ) silver->set_amount(sn) ;
	else if ( sn )
        {
		silver = new( MONEY_DIR + "silver" );
		silver->set_amount( sn );
		silver->move( this );
	}
	if ( coin ) coin->set_amount(cn);
	else if ( cn )
        {
		coin = new( MONEY_DIR + "coin" );
		coin->set_amount( cn );
		coin->move( this );
	}
	
	return 1;	    

}