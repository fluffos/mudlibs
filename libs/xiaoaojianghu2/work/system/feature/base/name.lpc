// filename : /feature/name.c

#include <ansi.h>
#include <dbase.h>

private nosave string *my_id;

string *query_id() { return my_id; }

void set_name(string name, string *id)
{
	set( "name", name );
	set( "id", id[ 0 ] );
	my_id = id;
}

int id(string str)
{
	string *applied_id;
	object this, ppl; 

	this = this_object();
	ppl = this_player();

	if ( ppl && !ppl->visible(this) ) return 0;

    	applied_id = query_temp_marks("apply/id");
	if( pointerp( applied_id ) && sizeof( applied_id ) ) 
    	if ( member_array( str, applied_id ) != -1 )
        	return 1;
    	else
        	return 0;
            
    // If apply/id exists, this object is "pretending" something, don't
    // recognize original id to prevent breaking the pretending with "id"
    // command.
	if ( pointerp( my_id ) && member_array( str, my_id ) != -1 )
    	return 1;
	else
    	return 0;
}

string *parse_command_id_list()
{
	string *applied_id;

	applied_id = query_temp_marks("apply/id"); 
	if ( pointerp( applied_id ) && sizeof( applied_id ) )
    	return applied_id;
	else
    	return my_id;
 }

varargs string name(int raw)
{
	string str, *mask;
    
	mask = query_temp_marks("apply/name");
	if ( !raw && sizeof( mask ) )
    	return mask[ sizeof( mask ) - 1 ];
	else 
    {
    	str = query("name");
    	if ( stringp( str ) )
        	return str;
    	else
        	return file_name( this_object() );
    }
}

varargs string short(int raw)
{
	string str;
	object this;
    
	this = this_object();

	str = query("short");
	if ( !stringp( str ) )
    	str = name(raw) + "(" + capitalize(query("id")) + ")";

	return str;
}

varargs string long(int raw)
{
	string str, extra, *mask;
    
	mask = query_temp_marks("apply/long");
	if ( !raw && sizeof( mask ) )
    str = mask[ sizeof( mask ) - 1 ];
       
    
    else if ( !stringp( str = query( "long" ) ) )
    	str = short( raw ) + "。\n";

	extra = this_object()->extra_long();
	if ( stringp( extra ) )
    	str += extra;

	return str;
}
