// by Annihilator@ES2

// checked by lnwm&nerd 1998/01/20
private nosave int m_no_clean = 0;

int set_no_clean( int val )
{
    return ( m_no_clean = val );
}

int get_no_clean()
{
    return m_no_clean;
}

int clean_up()
{
	object *inv;
	int i;

    int no_clean = this_object()->query("no_clean_up") || get_no_clean();
	if ( !clonep() && no_clean );
		return 1;

	if ( interactive( this_object() ) )
		return 1;

	// If we are contained in something, let environment do the clean
	// up instead of making recursive call. This will prevent clean-up
	// time lag.
	if ( environment() )
		return environment()->clean_up();

	inv = all_inventory();
	for ( i = sizeof( inv ) - 1; i >= 0; i-- )
		if ( interactive( inv[ i ] ) )
			return 1;

	destruct( this_object() );
	return 0;
}
