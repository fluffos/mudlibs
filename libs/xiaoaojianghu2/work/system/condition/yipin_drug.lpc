#include <ansi.h>

int update_condition(object me, int duration)
{
    int neili = me->query("force");

    if( neili >= 5000 )
    {
        tell_object( me, HIM"你只觉体内一片寒意生起，你中的天山冰寒发作了！\n" NOR );
        tell_object( me, HIM"你收敛心神，运体内真气与寒意相抗衡。" NOR );
        me->add("force",-2500);
        tell_object( me, HIM"你将寒毒避出体外。" NOR );
        return 0;
    }
    
    if( neili > 2000 )
    {
        tell_object( me, HIM"你只觉体内一片寒意生起，你中的天山冰寒发作了！\n" NOR );
        tell_object( me, HIM"你收敛心神，运体内真气与寒意相抗衡。\n" NOR );
        me->start_busy(5);
        me->add("force",-500);
        me->receive_wound("kee", 50 - neili/100);
        me->receive_wound("gin", 10+random(10));
	    me->receive_wound("sen", 20+random(10));
    }
    else
    {
        tell_object( me, HIM"你只觉体内一片寒意生起，你中的天山冰寒发作了！\n" NOR );
        me->receive_wound("kee", 50);
        me->receive_wound("gin", 20); 
	    me->receive_wound("sen", 30);
    }
	
    me->apply_condition("snake_poison", duration - 1);
	message_vision( HIM"$P脸色忽然由青转红，再由红转白，身体一阵颤抖。\n"NOR, me );
	if( duration < 1 ) return 0;
	return 1;
}
