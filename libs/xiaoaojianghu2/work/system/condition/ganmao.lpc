// ganmao.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (me->query("eff_gin") > me->query("max_gin") / 2)
    me->receive_wound("gin", 2);
  else {
    me->set("eff_gin", me->query("max_gin") / 2);
  }
  if (me->query("eff_sen") > me->query("max_sen") * 3 / 4)
    me->receive_wound("sen", 2);
  else {
    me->add("sen", -1);
    me->set("eff_sen", me->query("max_sen") * 3 / 4);
  }

  me->apply_condition("ganmao", duration - 1);

  message_vision(HIW "$N打了个喷嚏，感冒又发作了！\n" NOR, me);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}
