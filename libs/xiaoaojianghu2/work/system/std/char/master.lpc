// modify qyz 1997-3-26
// Amber reEdit on 1997-12-19
// to Expand Quest Power
// 增加quest的功能，如改变赏罚比例，调用函数特殊处理等等。
// Amber 97-12-20 增加了evaluate接口代替call_other()（仍保留）
// 在quest_file中使用"函数名"（英文）和(: 函数名 :)都是合法的。

#define QUEST(x) ("/quest/" + x )

#include <dbase.h>
#include <login.h>
#include <ansi.h>
#include "include/master.h" //变量赋值

int time_period(int timep, object me);
string GetQuestFile( object who, string family );

private string get_quest_reward_msg();
private string get_quest_fail_msg();
private string get_quest_delay_msg();
private string get_quest_refuse_msg();

/////////////////////////////////////////////////////////////////////////////

int give_quest()
{
    mapping quest;
    object who,me,send_obj;
    int timep, bonus, penals,positive_score, negative_score;  
    string his_class, my_class, his_class_id,quest_file;
    mixed msg;

    who = this_player();
    me = this_object(); 

    if ( who->is_tongshi_of( me ) )
    {
        his_class = who->query("zuzhi/zuzhi_name");
        my_class = me->query("zuzhi/zuzhi_name");
    }
    else
    {
        his_class = who->query("family/family_name");
        my_class = me->query("family/family_name");
    }
    his_class_id = get_family_id( his_class );
    if ( his_class != my_class )  
    {
         tell_object( who, me->name() + "疑惑地看着你：“这位"+RANK_D->query_respect( who )
            + "有何贵干？”\n" );
         return 1;
    }
    if ( quest = who->query( "quest" ) )
    {
        if ( quest[ "class" ] != his_class_id )
        {
            tell_object( who, me->name()+"疑惑地看着你：“这位" + RANK_D->query_respect( who )
                + "想要干什么？”\n" );
            return 1;
        }

        quest_file = quest["quest_file"];

        if ( who->query("done_quest") == quest["quest"] )
        {
            if ( who->query("task_time") && who->query("task_time") < time() )
            {
                msg = quest["delay_msg"];
                if ( !msg )
                    tell_object( who, me->name() + get_quest_delay_msg() );
                // Amber: here to detect funcp to penal delay   97-12
                // 提供evaluate的接口，可能比call_other快。
                else if ( functionp( msg ) )
                {
                    msg = evaluate( msg, who, me );
                    if ( stringp( msg ) )
                        tell_object( who, msg );
                    else if ( msg )
                        return 1;
                }
                else if ( is_chinese( msg ) )
                    tell_object( who, msg );
                else
                {
                    msg = call_other( quest_file, msg, who, me );
                    if ( stringp( msg ) )
                        tell_object( who, msg );
                    else if ( msg )
                        return 1;
                    // 这里用来自己修改"quest"的标志
                    // 实际可以用来继续发给下一个quest（连续性）。
                }
                who->set_marks( "last_quest", quest["quest"] );
                who->set_marks( "quest_result", "delay" );
                who->delete("done_quest");
                who->delete("quest");
                return 1;
            }
            else
            {
                // Amber: here to detect funcp to reward 1997-12-17
                // Amber: 加了一个reward的通用语 97-12-18
                msg = quest["reward_msg"];
                if ( !msg )
                    tell_object( who, me->name() + get_quest_reward_msg() );
                else if ( functionp( msg ) )
                {
                    msg = evaluate( msg, who, me );
                    if ( stringp( msg ) )
                        tell_object( who, msg );
                    else if ( msg )
                        return 1;
                }
                else if ( is_chinese( msg ) )
                    tell_object( who, msg );
                else
                {
                    msg = call_other( quest_file, msg, who, me );
                    if ( stringp( msg ) )
                        tell_object( who, msg );
                    else if ( msg )
                        return 1;
                    // 这里用来自己修改"quest"的标志
                    // 实际可以用来继续发给下一个quest（连续性）。
                }
                bonus = quest["bonus"];
                bonus += random((int)who->query("kar"))/10;
                who->add( "class_score/" + his_class , bonus );
                printf(RED"->你对" + his_class + "的忠诚度升高 %s 点\n"NOR
                    ,chinese_number(bonus) );
                if ( positive_score = quest["positive_score"])
                {
                    positive_score *= ( 1 + random((int)who->query("kar"))/15);
                    who->add("positive_score",positive_score);
                    printf(GRN"->正评价升高 %s 点\n"NOR
                        , chinese_number(positive_score ));
                }
                if( negative_score = quest["negative_score"])
                {
                    negative_score *= ( 1 + random((int)who->query("kar"))/15 );
                    who->add("negative_score",negative_score);
                    printf(CYN"->负评价升高 %s 点\n"NOR
                        , chinese_number(negative_score ));
                }
                who->set_marks( "last_quest", quest["quest"] );
                who->set_marks( "quest_result", "done" );
                who->delete("done_quest");
                who->delete("quest");
                return 1;
            }
        }

        else 
        {
            if( ( who->query("task_time") >  time() ) || !quest["time"] )
                  return 0;
            else
            {
                msg = quest["fail_msg"];
                if ( !msg )
                    tell_object( who, me->name() + get_quest_fail_msg() );
                else if ( functionp( msg ) )
                {
                    msg = evaluate( msg, who, me );
                    if ( stringp( msg ) )
                        tell_object( who, msg );
                    else if ( msg )
                        return 1;
                }
                else if ( is_chinese( msg ) )
                    tell_object( who, msg );
                else
                {
                    msg = call_other( quest_file, msg, who, me );
                    if ( stringp( msg ) )
                        tell_object( who, msg );
                    else if ( msg )
                        return 1;
                    // 这里用来自己修改"quest"的标志
                    // 实际可以用来继续发给下一个quest（连续性）。
                }
                // Amber: 加入一项新的参数penals用来和bonus分开处理惩罚的忠诚度
                penals = quest["penals"];
                if ( !penals )
                    penals = quest["bonus"]/3;
                who->add( "class_score/" + his_class,-penals);
                if ( penals )
                    printf(HIY"->你对" + his_class + "的忠诚度下降 %s 点\n"NOR
                       ,chinese_number( penals ) ); 
                who->set_marks( "last_quest", quest["quest"] );
                who->set_marks( "quest_result", "fail" );
                who->delete("done_quest");
                who->delete("quest");
                return 1;
            }
        }            
    }
    if ( who->query("task_time") && ( who->query("task_time") > time() ) ) 
    {                     
        message_vision( get_quest_refuse_msg(), me, who );
        return 1;
    }

    quest_file = GetQuestFile( who, his_class );
    quest = quest_file->query_quest();
    if ( !mapp( quest ) )
        return 1;
    msg = quest[ "quest_msg" ];
    if ( functionp( msg ) )
    {
        msg = evaluate( msg, who, me );
        if ( stringp( msg ) )
            tell_object( who, msg );
        else if ( msg )
            return 1;
        if ( quest[ "send_ob" ] )
        {
            send_obj =     new( quest[ "send_ob" ] );
            if ( send_obj->is_character() || !send_obj->move( who ) )
                send_obj->move( environment( me ) );
        }
    }
    else if ( is_chinese( msg ) )
    {
        tell_object( who, msg );
        if ( quest["send_ob"] )
        {
            send_obj = new( quest["send_ob"] );
            if ( send_obj->is_character() || !send_obj->move( who ) )
            // Amber: 避免玩家拿不了时出错。97-12-18
                send_obj->move( environment( me ) );
            // 另外这样可以实现护送NPC的功能了，OB就可以是NPC。
        }
    }
    else
    {
        msg = call_other( quest_file, msg, who, me );
        if ( stringp( msg ) )
            tell_object( who, msg );
        else if ( msg )
            return 1;
        if ( quest[ "send_ob" ] )
        {
            send_obj =     new( quest[ "send_ob" ] );
            if ( send_obj->is_character() || !send_obj->move( who ) )
                send_obj->move( environment( me ) );
        }
    }
    quest[ "class" ] = his_class_id;// 门派标志
    quest[ "quest_file" ] = quest_file;// 这是新加的一项。quest所在文件。
    who->set( "quest", quest );// 这是quest的标志mapping
    who->delete("task_time" );
    if ( timep = quest["time"] )
    {
        time_period( timep, who );
        who->set("task_time", time() + quest["time"]);
    }
    return 1;
}

int time_period(int timep, object me)
{
    int t, d, h, m, s;
    string time;
    t = timep;
    s = t % 60; t /= 60;
    m = t % 60; t /= 60;
    h = t % 24; t /= 24;
    d = t;

    if ( d ) time = chinese_number(d) + "天";
    else time = "";

    if ( h ) time += chinese_number(h) + "小时";
    if ( m ) time += chinese_number(m) + "分";
    time += chinese_number(s) + "秒";

    tell_object(me,HIW "你有" + time + "的时间\n去完成你师傅给的任务。\n"NOR);
    return 1;
}

string GetQuestFile( object who, string family )
// Amber:这段分出来用来寻找quest_file;
// Amber:用来找到现在可以领到的或身上有的quest是属于哪个文件的
{
    int score;
    string tag;

    score = who->query( "class_score/" + family );

    if ( random( score ) < 300 )
        tag = get_family_id( family ) + "/quest0";
    else if ( random( score ) < 1000 )
        tag = get_family_id( family ) + "/quest1";
    else if ( random( score ) < 3000 )
        tag = get_family_id( family ) + "/quest2";
    else
        tag = get_family_id( family ) + "/quest3";

    return QUEST(tag);
}

int accept_object( object who, object ob )
{
    string quest_file , who_class, my_class, who_class_id;
    object me;
    mixed msg;
    mapping quest;
    int bonus, p_score, n_score;
    //p_score is positive_score, n_score is negative_score.

    me = this_object();
    // Qyz 把收到的物品销毁.
    call_out( "destruct_quest_object", 2, me, ob );

    if ( who->is_tongshi_of( me ) )
    {
        my_class = me->query( "zuzhi/zuzhi_name" );
        who_class = who->query( "zuzhi/zuzhi_name" );
    }
    else
    {
        my_class = me->query("family/family_name");
        who_class = who->query("family/family_name");
    }
    who_class_id = get_family_id( who_class );
    if ( my_class != who_class || 
        who->query( "quest/class" ) != who_class_id )
    {
        tell_object( who, me->name() + "疑惑地看着你：这位" +
            RANK_D->query_respect(who) + "是什么意思？\n" );
        return 0;
    }
    if ( !(quest = who->query("quest")))
    {
        tell_object(who, me->name() + "笑道：你给我东西干什么？\n");
        return 0;
    }
    if ( "取" + ob->name(1) != quest["quest"] || userp(ob) )
    {
        tell_object(who, me->name() + "皱眉说：我当初可不是让你去找这个呀！\n");
        return 0;
    }
    quest_file = quest["quest_file"];
    if ( who->query("task_time") && ( who->query("task_time") < time() ) )
    {
        msg = quest["delay_msg"];
        if ( !msg )
            tell_object( who, me->name() + get_quest_delay_msg() );
        else if ( functionp( msg ) )
        {
            msg = evaluate( msg, who, me );
            if ( stringp( msg ) )
                tell_object( who, msg );
            else if ( msg )
                return 1;
        }
        else if ( is_chinese( msg ) )
            tell_object( who, msg );
        else
        {
            msg = call_other( quest_file, msg, who, me );
            if ( stringp( msg ) )
                tell_object( who, msg );
            else if ( msg )
                return 1;
            // 这里用来自己修改"quest"的标志
        }
        who->set_marks( "last_quest", quest["quest"] );
        who->set_marks( "quest_result", "delay" );
        who->delete("quest");
        return 1;
    }
    else
    {
        msg = quest["reward_msg"];
        if ( !msg )
            tell_object( who, me->name() + get_quest_reward_msg() );
        else if ( functionp( msg ) )
        {
            msg = evaluate( msg, who, me );
            if ( stringp( msg ) )
                tell_object( who, msg );
            else if ( msg )
                return 1;
        }
        else if ( is_chinese( msg ) )
            tell_object( who, msg );
        else
        {
            msg = call_other( quest_file, msg, who, me );
            if ( stringp( msg ) )
                tell_object( who, msg );
            else if ( msg )
                return 1;
            // 这里用来自己修改"quest"的标志
        }
        bonus = quest["bonus"];
        bonus += random(me->query("kar"))/5;
        who->add( "class_score/" + who_class, bonus );
        printf(HIR"->你对" + my_class + "的忠诚度升高 %s 点\n"NOR,
            chinese_number(bonus) );
        if ( p_score = quest["positive_score"])
        {
            p_score *= (1+random(me->query("kar"))/15);
            who->add("positive_score",p_score);
            printf(HIG"->正评价升高 %s 点\n"NOR, chinese_number(p_score) );
        }
        if( n_score = quest["negative_score"])
        {
            n_score *= (1+random(me->query("kar"))/15);
            who->add("negative_score",n_score);
            printf(HIC"->负评价升高 %s 点\n"NOR
            ,chinese_number(n_score) );
        }
        who->set_marks( "last_quest", quest["quest"] );
        who->set_marks( "quest_result", "reward" );
        who->delete("quest");
        return 1;
    }
}

void destruct_quest_object( object me, object ob )
{
    if ( environment(ob) == me )
        destruct(ob);
}

private string get_quest_fail_msg()
{
    return quest_fail_msg[ random( sizeof( quest_fail_msg ) ) ];
}

private string get_quest_delay_msg()
{
    return quest_delay_msg[ random( sizeof( quest_delay_msg ) ) ];
}

private string get_quest_refuse_msg()
{
    return quest_refuse_msg[ random( sizeof( quest_refuse_msg ) ) ];
}
private string get_quest_reward_msg()
{
    return quest_reward_msg[ random( sizeof( quest_reward_msg ) ) ];
}
