void cat(string file) {
  if (this_player())
    message("write", read_file(file), this_player());
}

void log_file(string file, string text) {
  // New bug class (this lib): an uncaught write_file() error (e.g. the
  // target's parent directory doesn't exist -- happened here, see
  // NOTES.md/AGENTS.md: /log/nosave/ was missing from the shipped
  // archive, a classic "RAR/zip drops empty dirs" case) silently aborts
  // the ENTIRE caller chain with no visible error to the connecting
  // player and no debug.log entry -- only the mudlib's own error_handler
  // logs it, to /log/runtime/<X>, and even that is only shown to the
  // player if this_player() happens to resolve at that exact point (it
  // didn't, here, mid-registration). Since log_file() is called from
  // dozens of places purely for best-effort bookkeeping, a failed write
  // should never be allowed to abort whatever real work the caller was
  // doing -- wrap in catch() so it degrades to a no-op instead.
  catch(write_file(LOG_DIR + file, text));
}

void assure_file(string file) {
  string path, *dir;
  int i;

  if (!stringp(file)) return;
  if (file_size(file) != -1)
    return;

  seteuid(ROOT_UID);
  dir = explode(file, "/");
  dir = dir[0..sizeof(dir) - 2];
  path = "/";
  for (i = 0; i < sizeof(dir); i++) {
    path += dir[i];
    mkdir(path);
    path += "/";
  }
}

string base_name(object ob) {
  string file;

  if (!ob)
    return 0;
  if (sscanf(file_name(ob), "%s#%*d", file) == 2)
    return file;
  else
    return file_name(ob);
}

string sin_name(object ob)  //用来返回不带目录的文件名--(by lnwm)
{
  string file, *dir;

  dir = explode(base_name(ob), "/");
  file = dir[sizeof(dir) - 1];
  return file;
}

int file_exists(string file) {
  return (file_size(file) >= 0);
}
