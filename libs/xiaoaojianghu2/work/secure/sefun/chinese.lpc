string chinese_place_name(string str)
{
    return CHINESE_D->chinese_place_name(str);
}

string chinese_number(int i)
{
    return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
    return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
    // AGENTS.md §15h: this driver's strings are UTF-8 native -- str[0] is
    // a full Unicode codepoint, not a raw GBK lead byte, and strlen()
    // counts characters, not bytes. The original GBK byte-range check
    // (str[0] > 160 && str[0] < 255, requiring >=2 bytes for one 2-byte
    // GBK character) never matches real Chinese text under UTF-8; replaced
    // with a CJK Unified Ideographs codepoint range check, and the length
    // guard is now ">= 1" (one full character), not ">= 2" (two bytes).
    if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff)
        return 1;
    return 0;
}

string time_string(int time)
{
	int month, day, hour, min, sec;
	sec = time % 60;
	time /= 60;
	min = time % 60;
	time /= 60;
	hour = time % 24;
	time /= 24;
	day = time % 30;
	time /= 30;
	month = time % 12;
	time /= 12;
	return ( time ? time + "年" : "" ) +
			( month ? month + "月" : "" ) +
			( day ? day + "天" : "" ) +
			( hour ? hour + "小时" : "" ) +
			( min ? min + "分" : "" ) +
			( sec ? sec + "秒" : "" ); 
}
