// get the string lenght while trip the colors(ansi)
// bugs: if a string contains a escape char but is not a ansi
// will cause a very fun result.
int strnlen(string str)
{
    int ansi = 0, len = 0;
    if (! str || !stringp(str) )
        return 0;
    foreach(int ch in str)
    {
        if ( ch == 0x1b ) // char ESC
        {
            ansi = 1;
        }
        if ( !ansi )
            len ++;
        else if ( ch == 'm' || ch == 'J' || ch == 'H' || ch == 'f' )
        {
            ansi = 0;
        }
    }
    return len;
}

// format string:
// format a string with ansi and Chinese chars
// wrap is the line to wrap, default is 70
varargs string format_string(string str, int wrap, int ignore_return)
{
    string tmp = "";
    int len= 0, ansi = 0, clen = 0;   // clen 是已出现的汉字个数。
    if (!str || !stringp(str))
        return 0;
    if (!wrap)
        wrap = 70;
    foreach ( int ch in str )
    {
        if ( ch == '\n' && ignore_return)       // return char
            continue;           // ignore it.
        tmp += sprintf("%c", ch);
        if ( ch == 0x1b )       // esc char
        {
            ansi = 1;
        }
        if ( !ansi )
        {
            len ++;
            if (ch > 127)
                clen ++;
//        printf("ch %c clen: %d len %d ch=%d\n", ch, clen,len,ch);
        }
        else if ( ch == 'm' || ch == 'H' || ch == 'J' )
        {
            ansi = 0;
        }
        if ( len >= wrap )
            if ( ( ! (clen%2) ) || ( ch == ' ' ) )
        {
//            printf("str: %s ch %c clen: %d len %d ch=%d\n", tmp, ch, clen,len,ch);
            tmp += "\n";
            len = 0;
        }
    }
    return tmp + "\n";
}

// trip_ansi.
// return a string which trip the ansi(s) of the argument.
// but I don't think this function useful
string trip_ansi(string str)
{
    string tmp = "";
    int ansi = 0;
    if ( !str || !stringp (str) )
        return 0;
    foreach (int ch in str)
    {
        if ( ch == 0x1b )
            ansi = 1;
        if ( !ansi )
            tmp += sprintf("%c", ch);
        else if ( ch == 'm' || ch == 'J' || ch== 'K' || ch == 'H' )
            ansi = 0;
    }
    return tmp;
}

// center a string on screen...
varargs string center(string str, int x)
{
    int y;

    if(!x)
        x= 80;
    x--;
    if((y = strnlen(str)) >= x)
        return str;
    x = x + strlen(str) - y;
    return sprintf(sprintf("%%|%ds", x), str);
}

string translate( string msg )
{
	mapping trans = ([
		"30" : "black",
		"31" : "red",
		"32" : "green",
		"33" : "yellow",
		"34" : "blue",
		"35" : "magenta",
		"36" : "cyan",
		"37" : "white",
	]);
	mapping spec = ([
		"1" : "strong",
		"4" : "u",
		"5" : "blink",
	]);
	string ret = "";
	string ansi = 0;
	int i;
	msg = replace_string( msg, "&", "&amp" );
	msg = replace_string( msg, "<", "&lt" );
	msg = replace_string( msg, ">", "&gt" );
	//msg = replace_string( msg, "\n", "<br>\n" );
	while ( ( i = strsrch( msg, 0x1b ) ) >= 0 )
	{
		int start;
		string tmp;
		string fmt = "%s";
		if ( msg[++i] != '[' )
		{
			ret += msg[0..i];
			msg = msg[i..];
			continue;
		}
		start = i+1; 
		while ( msg[++i] != 'm' )
			;
		tmp = msg[start..i-1];
		if ( ansi )
		{
			foreach ( string s in explode( ansi, ";" ) )
			{
				if (trans[s])
					fmt = sprintf("<font color=%s>%s</font>",
						trans[s], fmt);
				if ( spec[s] )
					fmt = sprintf("<%s>%s</%s>",spec[s],
						fmt, spec[s]);
			}
		}
		ret += sprintf(fmt,msg[0..start-3]);
		if ( tmp == "0" || tmp == "2;37;0" )
		{
			ansi = 0;
		}
		else
			ansi = tmp;
		msg = msg[i+1..];
	}
	ret += msg;
	return ret;
}

string trim(string str)
{
    int j, i = 0;
	string sp = " \t\r\n";
    if ( ! strlen( str ) )
        return str;
    j = strlen(str) - 1;
    while ( i<j && strsrch(sp, str[i]) >= 0 )//( str[i] == ' ' || str[i] == '\t' ) )
        i++;
    while ( i<j && strsrch(sp, str[j]) >=0 )
        j--;
    return str[i..j];
}
