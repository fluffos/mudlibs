//#undef DEBUG

varargs void message_vision(string msg, object me, object you)
{
    string my_gender, your_gender, my_name, your_name;
    string str1, str2, str3;

    my_name = me->name();
    my_gender = me->query("gender");
    str1 = replace_string(msg, "$P", gender_self(my_gender));
    str1 = replace_string(str1, "$N", gender_self(my_gender));
    str1 = replace_string(str1, "$F", RANK_D->query_respect(me));
    str1 = replace_string(str1, "$f", RANK_D->query_rude(me));
    str3 = replace_string(msg, "$P", my_name);
    str3 = replace_string(str3, "$N", my_name);
    str3 = replace_string(str3, "$F", RANK_D->query_respect(me));
    str3 = replace_string(str3, "$f", RANK_D->query_rude(me));
    if (you)
    {
        your_name = you->name();
        your_gender = you->query("gender");
        str2 = replace_string(msg, "$P", gender_pronoun(my_gender));
        str2 = replace_string(str2, "$p", gender_self(your_gender));
        str2 = replace_string(str2, "$N", my_name);
        str2 = replace_string(str2, "$n", gender_self(your_gender));
        message("vision", str2, you);
        str1 = replace_string(str1, "$p", gender_pronoun(your_gender));
        str1 = replace_string(str1, "$n", your_name);
        str3 = replace_string(str3, "$p", your_name);
        str3 = replace_string(str3, "$n", your_name);
    }
    message("vision", str1, me);
    message("vision", str3, environment(me), ({ me, you }));
}

varargs void combat_message(string msg, object me, object you)
{
    int i;
    object *inv, *exclude;
    string str1, str2, str3;
    string my_gender, your_gender, my_name, your_name;

    my_name = me->name();
    my_gender = me->query("gender");
    str1 = replace_string(msg, "$P", gender_self(my_gender));
    str1 = replace_string(str1, "$N", gender_self(my_gender));
    str3 = replace_string(msg, "$P", my_name);
    str3 = replace_string(str3, "$N", my_name);
    if (you)
    {
        your_name = you->name();
        your_gender = you->query("gender");
        str2 = replace_string(msg, "$P", gender_pronoun(my_gender));
        str2 = replace_string(str2, "$p", gender_self(your_gender));
        str2 = replace_string(str2, "$N", my_name);
        str2 = replace_string(str2, "$n", gender_self(your_gender));
        if (!you->query_combat_brief())
        {
            message("vision", str2, you);
        }
        str1 = replace_string(str1, "$p", gender_pronoun(your_gender));
        str1 = replace_string(str1, "$n", your_name);
        str3 = replace_string(str3, "$p", your_name);
        str3 = replace_string(str3, "$n", your_name);
    }
    if (!me->query_combat_brief())
    {
        message("vision", str1, me);
    }

    exclude = ({ me, you });
    inv = all_inventory(environment(me));
    for (i = sizeof(inv) - 1; i >= 0; i--)
        if (inv[i]->is_character() && inv[i]->query_combat_brief())
            exclude += ({ inv[i] });
    //write_file( "/open/combat_log",
    //    sprintf( "inv %O, exclude %O, env %O\n", inv, exclude,
    //    environment( me ) ) );
    message("vision", str3, environment(me), exclude);
}

void tell_object(object ob, string str)
{
    message("tell_object", str, ob);
}

void tell_wizard(mixed ob, string str)
{
#ifdef DEBUG
    if (ob && stringp(ob))
        ob = find_player(ob);
    if (ob && wizardp(ob))
        message("tell_wizard", str + "\n", ob);
#endif
}

varargs void tell_room(mixed ob, string str, object * exclude)
{
    if (ob)
        message("tell_room", str, ob, exclude);
}

void shout(string str)
{
    message("shout", str, users(), this_player());
}

void write(string str)
{
    //object ob;

    if (this_player())
