#define MIN_HM_POINT 10000
inherit F_SAVE;
// problem: should be private :(( but my mudos's wrong ...kick
string * avatars;
string * hms;
private nosave object* users;

private void create()
{
    seteuid(ROOT_UID);
    restore();
    if ( ! pointerp( avatars) )
    {
        hms = ({ });
        avatars = ({ });
    }
    users = users();
    if (!users)
        users = ({ });
}

int is_avatar(mixed ob)
{
    if ( objectp(ob) )
        ob = geteuid(ob);
    if (!ob|| ! stringp(ob))
        return 0;
    if ( ! sizeof( avatars ) )
        return 0;
    return member_array( ob, avatars )!= -1;
}

string* get_avatars()
{
    return avatars;
}

string* get_high_mortals()
{
    return hms;
}

void CheckUserLevel(object ob)
{
    int x;
    string * known = 
        ({ "sword","blade","unarmed","dodge","short","whip","long","zonggang"});
    mapping xiuwei = ob->query_xiuwei_map();
    x = 0;
    
    if ( wizardp( ob ) )
        return ;

    if ( sizeof ( xiuwei ) )
        foreach ( string type, int num in xiuwei )
            if ( member_array(type, known) != -1 )
                x+=num * num;
    x = sqrt (x);
    x += ob->query("max_force")/1.2;
    x += ob->query("combat_exp")/2000;
    if ( x > MIN_HM_POINT // && ob->query("PKS") < 10
        && ob->query("betrayer") < 5 
        && !ob->query("high_mortal") )
    {    // this is a high mortal lah..
        ob->set("high_mortal",1);
        hms += ({ geteuid(ob) });
        message("vision","恭喜！由于你的勤学苦练，从今天起，你就是武林名士啦！\n",ob);
        save();
    }
    else if ( (x <= MIN_HM_POINT //|| ob->query("PKS") >= 10 
            || ob->query("betrayer") >=5)
        && (ob->query("high_mortal")) )
    {
        hms -= ({ geteuid(ob) });
        ob->set("high_mortal",0);
        message("vision","很抱歉，由于你的懒惰或恶行，从今天开始，你降为武林人士。\n",ob);
        save();
    }
}

string query_save_file()
{
    return DATA_DIR "daemon/userd";
}

// should this be open to any program? possible no...
string add_avatar(string who)
{
    // add security control here :)
    avatars += ({ who });
    save();
}

string delete_avatar(string who)
{
    //should be deleted. by lnwm
    if(member_array(who,avatars)+1)
        avatars -= ({ who });
    save();
}

void add_user( object* user )
{
    if ( !clonep(user))
        return;
    if ( !user )
        return;
    users += ({ user });
}

void remove_user( object* user )
{
    users -= ({ user });
}

object* get_users()
{
    users = filter( users, (: $1 :) );
    return users;
}

int remove()
{
    save();
    return 1;
}
