//
// File:     sefun.c
// Purpose:  This object is loaded at boot time.
//           Functions defined in this object can be called by any object
//             in the game in the same way efuns are called, and are said
//             to be simulated efuns (or sefuns for short).
//
// 96-10-02     Falcon
//

void create() {
  seteuid(ROOT_UID);
}

#include "/secure/sefun/atoi.lpc"
#include "/secure/sefun/chinese.lpc"
#include "/secure/sefun/gender.lpc"
#include "/secure/sefun/file.lpc"
#include "/secure/sefun/string.lpc"
#include "/secure/sefun/object.lpc"
#include "/secure/sefun/path.lpc"
#include "/secure/sefun/system.lpc"
#include "/secure/sefun/wizard.lpc"
#include "/secure/sefun/math.lpc"
#include "/secure/sefun/message.lpc"
#include "/secure/sefun/get_object.lpc"
#include "/secure/sefun/to_object.lpc"
//#include "/secure/sefun/command.lpc"
#include "/secure/sefun/task.lpc"
#include "/secure/sefun/time.lpc"
#include "/secure/sefun/filter.lpc"
#include "/secure/sefun/user.lpc"
#include "/secure/sefun/shop.lpc"
#include "/secure/sefun/pointers.lpc"

varargs object snoop(object who, object target) {
  if (!target) return efun::snoop(who);
  if (!wizardp(who)) return 0;
  if (userp(target)) {
    log_file("acct/snoop", sprintf("[%s] %s(%s) snoops %s(%s).\n",
      ctime(time())[4..15], who->name(1),
      getuid(who), target->name(), getuid(target)));
  }
  return efun::snoop(who, target);
}

varargs void shutdown(object who, int code) {
  if (!who || !userp(who) || !wizardp(who))
    return 0;
  log_file("acct/shutdown", sprintf("[%s] %s(%s)开始shutdown XO.\n",
    ctime(time())[4..15], who->name(), getuid(who)));
  foreach (object ob in previous_object(-1)) {
    if (ob != who)
      log_file("acct/shutdown", sprintf("%s(%s)好象和本次shutdown有关系。\n",
        ob->name(), getuid(ob)));
  }
  return efun::shutdown(code);
}

void destruct(object ob) {
  string err;

  if (ob) {
    if (previous_object())
      err = catch(ob->remove(geteuid(previous_object())));
    else
      err = catch(ob->remove(0));
    if (err) {
      log_file("destruct",
        sprintf("[%s]%O\n%s\n", ctime(time()), ob, err));
      if (userp(ob) && geteuid(previous_object()) != ROOT_UID)
        return;
    }
    efun::destruct(ob);
  }
}

int query_idle(object ob) {
  if (!ob || !objectp(ob) || !interactive(ob))
    return 0;
  if (ob->is_html_user()) {
    object link = ob->query_input_ob();
    if (link)
      return efun::query_idle(link);
    else
      return -1;
  } else
    return efun::query_idle(ob);
}
