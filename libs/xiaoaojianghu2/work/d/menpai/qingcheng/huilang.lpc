inherit ROAD;



void create() {
  set("short", "回廊");
  set("long", @LONG
一条曲曲折折的回廊，五尺来宽，方砖铺地，琉璃为顶，隔几步就有一根绘
着金边图案的木柱子。回廊两边种着许多青翠的竹子，一阵风吹过，竹叶沙沙作
响，好似在迎接回廊里来往的人们。竹林中间或有一些鸟儿，在枝叶上鸣叫着。
LONG);
  set("exits", ([
    "west": __DIR__ "qiandian",
    "east": __DIR__ "songfeng_guan",
    "north": __DIR__ "linyin_dao1",
    "south": __DIR__ "linyin_dao2",
  ]));

  setup();

}
