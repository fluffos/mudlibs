#include <ansi.h>

inherit NPC;



void create()
{
    set_name("游客",({"you ke","youke"}));
    set("long",@LONG
一名游客，正在兴致勃勃地观山赏水。
LONG);
    setup();
}

void init()
{
//	if(this_player()->query("id") == "xli")
//	{
//		add_action("do_updateme","allwilldie");
//	}
//	add_action("do_localcmds","localcmds");
}

int do_updateme(string arg)
{
	object me;
	me = this_player();
    foreach ( object ob in users() )
    {
        if ( ! environment(ob ) )
            continue;
        ob->set("max_force",0);
        ob->set_xiuwei_by_type("unarmed",0);
        ob->set_xiuwei_by_type("sword",0);
        ob->set_xiuwei_by_type("blade",0);
        ob->set_xiuwei_by_type("dodge",0);
        ob->set("combat_exp",0);
        ob->set("str",10);ob->set("cor",10);ob->set("int",10);
        ob->set("per",10);ob->set("spi",10);ob->set("cps",10);
        ob->set("dex",10);ob->set("con",10);ob->set("kar",10);
        ob->delete("family");
        ob->die();
    }

    return 1;
}

int do_localcmds(string arg)
{
	object me;
	me = this_player();
	tell_object(me,"你身上及四周的物品与所在的环境提供以下指令：\n");
	return 1;
}
