#include "/d/menpai/qingcheng/npc/sima_quest.h"
inherit NPC;
inherit F_MASTER;
string ask_for_canxiu(object);
string ask_for_xiudao(object);
string ask_for_chushi(object);


void create()
{
    set_name("司马卫",({"sima wei","sima"}));
    set("gender","男性");
    set("age",54);
    set("per",25);
    set("int",32);
    set("cps",26);
    set("rank_info/respect", "司马掌门");
    set("long",@LONG
他五短身材，面孔削瘦，并不起眼。然而举手投足非常稳健有力，显然是精华内敛，
颇有修为的一位宗师。
LONG);
    create_family("青城派",8,BLU"掌门人"NOR);
    set("class","qingcheng");
    set("combat_exp",80000000);
    set("social_exp",35000);
    
    set_wugong("jiben-quanfa",80,80,0);
    set_wugong("songfeng-quan",80,80,1);
    set_wugong("cuixin-zhang",90,90,1);
    set("negative_score", 38800);
       
    set_wugong("songfeng-xinfa",100,100,0);
    
    set_wugong("jiujin-ci",150,150,0);
    set_wugong("zhaodi-hong",150,150,0);
    set( "negative_score", 1000 ); 
    set_wugong("shier-po",150,150,0);
    set_wugong("yunv-zhen",150,150,1);
    
    set_wugong("jiben-qinggong",90,90,0);
    set_wugong("hexiang",150,150,1);
    
    set_xiuwei_by_type("unarmed",500);
    set_xiuwei_by_type("short",1900);
    set_xiuwei_by_type("dodge",700);
    
    set("force",2000);
    set("max_force",1000);
    set("force_factory",100);
    set("inquiry",([
    "此地"  :  "这里就是我青城派，风土不好，人情还不错。",
    "贵姓"  :  "不敢当，小老儿正是青城派现任掌门司马卫。",
    "参修"  :  ( : ask_for_canxiu : ),
    "canxiu":  ( : ask_for_canxiu : ),
    "修道"  :  ( : ask_for_xiudao : ),
    "xiudao":  ( : ask_for_xiudao : ),
    "出师"  :  ( : ask_for_chushi : ),
    "chushi":  ( : ask_for_chushi : ),
        ]));

    setup();
    carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
    carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

void init()
{
    object me;
    me = this_player();
    add_action("ling_renwu","ling");
    call_out("greet_me",1,me);
}

void greet_me(object me)
{   
    int sayit;
    if ( !me 
        || environment( me ) != environment() ) 
        return;

    if(me->query("family/family_name")!="青城派")
        return;
    sayit = random(3);
    if(random(10)>2)
    {
        switch(sayit)
        {
            case 0: message_vision("司马卫说道：本门弟子可以在我这里领取(ling)任务。\n",me);
                    break;
            case 2: message_vision("司马卫说道：我青城虽然是小门派，可也有我成名的功夫和独门兵器！\n",me);
                    break;
            case 1: message_vision("司马卫说道：我青城经常有弟子下山买东西，放在各处，需要什么可以去看看！\n",me);
                    break;
         }
        
    }
}

int recruit_apprentice(object me)
{
    ::recruit_apprentice(me);
    me->set("master","sima wei");
    message_vision("司马掌门对$N说：你现在是我的弟子了，武学上有什么不懂就来问我吧！\n", me);
    return 1;
}


int attempt_apprentice(object me)
{
    string my_id;
    mapping family;
    my_id = me->query( "id" );    
/*    if(me->query("age")>30 )  // 过了30岁的就不要了
    {
        message_vision(YEL"司马卫对$N说道：你已经年过三十，正是闯荡江湖、成名立业的时候。\n"NOR,me);
        message_vision(YEL"拜入我小小的青城派岂不是太屈才了！老道可不敢当！\n"NOR,me);
        return 1;
    }
  */  if( me->query("family/family_name")=="蓬莱派") 
    {
        message_vision(YEL"司马卫怒气冲冲地看着$N，说道：\n"NOR,me);
        message_vision(YEL"我青城与蓬莱历来积怨甚深，你已拜入蓬莱，即为本派仇敌，想拜我为师真是异想天开！\n"NOR,me);
        message_vision(HIG"突然之间只见司马卫从袖子里拿出一套雷公轰，以迅雷不及掩耳之势向$N冲了上来。\n"NOR,me);
        message_vision(HIG"$N一阵大骇，还没来得及出招，就感眼前一花......\n"NOR,me);
        me->unconcious();
        message_vision("司马卫说道：来人啊，把$N扔到山脚去。\n",me);
        message_vision("只见两个弟子走了出来，将昏迷中的$N抬了起来，走了出去。\n",me);
        me->move("/d/menpai/qingcheng/shanjiao");
        return 1;
     }
     if( me->query("zuzhi/zuzhi_name")=="凤翔镖局")
     {
        message_vision(YEL"司马卫怒气冲冲地看着$N，说道：\n"NOR,me);
        message_vision(YEL"我青城与蓬莱历来互为死敌，你拜入凤翔镖局，即入蓬莱门下，想拜我为师真是异想天开！\n"NOR,me);
        message_vision(HIG"只听司马卫一声令下：来人啊，把这个奸细赶了出去！立刻无数弟子向$N涌了过来...\n"NOR,me);
        message_vision(HIG"$N一阵大骇，还没来得及出招，就感眼前一花......\n"NOR,me);
        me->unconcious();
        message_vision("司马卫说道：来人啊，把$N扔到山脚去。\n",me);
        message_vision("只见两个弟子走了出来，将昏迷中的$N抬了起来，走了出去。\n",me);
        me->move("/d/menpai/qingcheng/shanjiao");
        return 1;
     }
     if(!me->query("xli_marks/apprentice_sima") 
     && me->query("class") 
     && me->query("class")!="qingcheng")
     {
     	message_vision("司马卫对$N说道：你已有门派了，我青城可不夺人子弟的。\n",me);
     	return 1;
     }
     if(me->query("xli_marks/apprentice_sima")&&me->query("class")!="qingcheng")   // 判出过本门
     {
        message_vision(RED"司马卫怒气冲冲地看着$N，说道：\n"NOR,me);
        message_vision(RED"你已判出过我青城派，为师不追究已经是法外开恩了，你竟然还有脸回来！\n"NOR,me);
        message_vision(RED"来人啊，将这个叛徒打下青城山！为师不想再见到他！\n"NOR,me);
        message_vision(HIG"只见司马卫一拂长袖，转过身去，同时无数弟子向$N涌了过来...\n"NOR,me);
        message_vision(HIG"$N一阵大骇，还没来得及出招，就感眼前一花......\n"NOR,me);
        me->unconcious();
        message_vision("只见两个弟子走了出来，将昏迷中的$N抬了起来，走了出去。\n",me);
        me->move("/d/menpai/qingcheng/shanjiao");
        return 1;
     }
     if(me->query("xli_marks/qingcheng_chushi"))
     {
        message_vision("司马卫翻开青城派大事记录册，查看了一下，对$N说道：\n",me);
        message_vision("你已从我派出师了，怎么能再拜回来呢！\n",me);
        return 1;
     }
    command( "pat " + my_id );
    tell_object(me,HIC@MSG
司马卫对你说：我青城派入门甚为简单，不如其它中原大派之繁琐。既然你有
心入我青城，拜我为师父，我就收下你了。我青城门规虽寥寥数语，可也得与
你一叙，你且记牢了：
              一不许擅违师命
              二不许同门相残
              三不许贪淫酒色
如有违反，我处罚定会甚严！
好吧，你现已是我青城弟子了，可以到武器房去领我青城独门兵刃「雷公轰」了。
MSG NOR);
    tell_object(me,"你跪了下来，恭恭敬敬地向司马掌门磕了三个响头，叫了声「师父！」\n");
    command("smile");
    tell_object(me,"司马卫拿出青城派的大事记录册，工工整整地记录下：\n");
    tell_object(me,"某年月日，"+me->query("name")+"拜入我青城派。\n");
    recruit_apprentice( me );
    family = me->query("family");
    tell_object( me,
    sprintf("恭喜你成为%s的第%s代弟子。\n", family["family_name"],
    chinese_number(family["generation"]) ));
    me->set("class","qingcheng");
    me->set("title","青城弟子" );
    me->set("xli_marks/ling_num",10);  // 可以在武器房领10回雷公轰(即可以死10回)
    me->set("xli_marks/can_do_renwu",1); // 初始化
    me->set("xli_marks/apprentice_sima",1);
    me->set("xli_marks/cantimes",0);
    command("chat "+me->query("name")+"("+me->query("id")+")现已成为我青城派门下弟子。");

        return 1;
}

string ask_for_canxiu(object me)
{
    object who;
    int nowd;
    who = this_player();
    
    nowd = who->query("xli_marks/cantimes");
    if(who->query("class_score/青城派") <  5 * nowd *nowd)
        return "只有对本门有重要贡献的弟子才能进练功房内厅自行参修\n"+
               "你且扪心自问，你有这个资格吗？";
    if(who->query_lingwu("yunv-zhen")<10 * nowd )
    	return "你对本门武功的领悟还不够，参修也是没有用的，还是好好练功吧！\n";
    who->set("xli_marks/can_lian",1);
    who->set("xli_marks/cantimes",nowd+1);
        return "好徒儿，念在你对我青城忠心耿耿，又如此勤学苦练\n"+
               "我就批准你进入练功房内厅自行参修一次！";
}

string ask_for_xiudao(object me)
{       
    int add_dao;
    int mcps,mkar;    
    object who;
    who=this_player();
    
    if(who->query("class")!="qingcheng") // 不是青城派的弟子
        return "非我道家之人，何来的道可修？莫非是想入我青城修道？";
    if(who->query("xli_marks/daohang") <1 ) // 新手上路
    {
        tell_object(who,"司马卫说道：修道并无定式，所谓『道法天然』，机缘一到，自然而悟。\n");
        tell_object(who,"看你并无根基，为师我且给你讲讲这修道的奥妙，你能理解多少就是多少吧！\n");
        tell_object(who,"司马卫转身取出一本老子所著的『道德经』，慢慢翻开至第一页。\n");
        tell_object(who,"司马卫用指尖在书上划了几下，选定了几句浅显易懂的，给你读了一遍。\n");
        tell_object(who,"司马卫读完后，合上书本，却并不释意，只说道：\n");
        tell_object(who,"你且慢慢体会其中涵义，能不能有所进境就看你的造化了。\n");
        mcps=who->query("cps");
        mkar=who->query("kar");
        add_dao=1+random(3)+mcps/25+mkar/25;
        who->set("xli_marks/daohang",add_dao);
        who->set("xli_marks/last_dao",add_dao);
        return "你好自为之吧！";
    }
    else
    {
        if(who->query("xli_marks/daohang")-who->query("xli_marks/last_dao") >30) // 有进步
        {
            tell_object(who,"你修道这些日子，看来还是很有长进的，果然没有忘记为师的教导。\n");
            who->set("xli_marks/last_dao",who->query("xli_marks/daohang"));
            who->add("class_score/青城派",3+random(4));
            return "不错不错！";
        }
        else
        {
            return "你这些日子出去修道可没什么长进啊，看来还是机缘不凑巧。";
        }                                                          
    }
}

string ask_for_chushi(object me)
{
    object who;
    object *inv;
    who=this_player();
    if(who->query("class")!="qingcheng")
        return "你不是我青城弟子，何来出师之有？";
    if(who->query("class_score/青城派")<1000)
    {
        tell_object(who,"司马卫拿出了青城派的大事记录册，看了半天，然后对你说道：\n");
        tell_object(who,"你对我青城并不怎么忠心啊，为师可信不过你，出师的事再说吧！\n");
        return "你先下去吧！";
    }
    if(who->query_lingwu("yunv-zhen")<80)
    {
        tell_object(who,"司马卫叫来二弟子方晋，向他仔细询问了你的武功进境，然后对你说：\n");
        tell_object(who,"你的本门武功还没有学精，贸然出师下山，岂不给我青城丢脸！\n");
        return "你先下去吧！";
    }
    if(! who->query("xli_marks/win_liu"))
    {
        tell_object(who,"司马卫想了想，对你说道：\n");
        tell_object(who,"蓬莱派是我青城派的宿敌，凤翔镖局的刘星海向来对我派口出狂言，大为不敬。\n");
        tell_object(who,"你也在我青城派修炼了那么久了，为师很信任你，你的武功也尽得我真传，\n");
        tell_object(who,"这就去一趟凤翔镖局，给为师我把他打败了，也灭一灭他的嚣张气焰！\n");
        who->set("xli_marks/bihua_liu",1);
        return "你这就去吧！";
    }
    tell_object(who,"司马卫赞许的看着你，说道：\n");
    tell_object(who,"你在我青城派也有些年头了，不仅对我派忠心耿耿，也非常勤于练功。\n");
    tell_object(who,"为师很欣赏你，很得意于有你这么一个徒弟，这是本派的光荣。\n");
    tell_object(who,"虽然为师很舍不得你，但是为师知道你有自己的前途，为师不能阻拦。\n");
    tell_object(who,"因此你既然决意要出师，这就去收拾收拾，准备一下下山后的东西吧！\n");
    tell_object(who,"\n你跪下来，恭恭敬敬的向司马卫掌门磕了三个响头，说道：\n");
    tell_object(who,"一日为师，终身为父，师父的教诲，弟子终身难忘！\n");

//  tell_object(who,"你心中嘀咕：真是唐僧！\n"); :)

    tell_object(who,"司马卫拿出青城派的大事记录册，工工整整的写下：\n");
    tell_object(who,"某年月日，"+who->query("name")+"从我青城派出师。\n");
    inv = all_inventory( who );
    foreach( object ob in inv )
    {
        if( ob->query("id")=="leigong hong" 
            && ob->query("name")==BLU"雷公轰"NOR )
        {
            tell_object(who,"司马卫拍了拍你的肩头，又说道：\n");
            tell_object(who,"我青城规矩，独门兵刃是要收回的。\n");
            tell_object(who,"你从怀中取出雷公轰，摩挲了一会儿，交给了司马掌门。\n");
            ob -> move(environment( who ));
            destruct(ob);
         }
    }
    who->delete("family");
    who->delete("class");
    who->delete("xli_marks/apprentice_sima");
    who->set("xli_marks/qingcheng_chushi",1);
    call_out("do_teach",5,who);
    return "罢了，罢了，你下去吧！";
}
int do_teach(object me)
{
    if(environment(me)->query("short")=="后殿")
    {
        tell_object(me,"司马卫看你还站在这里，微笑了一声，对你说道：\n");
        tell_object(me,"为师看你在我派学艺很刻苦，就再教你一门我青城武功。\n");
        tell_object(me,"该武功名为：〖三友探春〗，是我青城的开山师祖自创的武功。\n");
        tell_object(me,"武功攻势凌厉，虽只有三招，然而其中变化无穷，也非一朝一夕可以学成的。\n");
        tell_object(me,"这〖三友探春〗的招式就记录在后山上草丛中的一棵参天古树上。\n");
        me->set("xli_marks/can_xian",1);
        return 1;
    }
    tell_object(me,"你今后好自为知吧！\n");
    return 1;
}

int refuse_killing( object who )
{
    if(random(4)==1)
    {
    	message_vision(RED"司马卫冷冷地哼了一声：什么人，在我青城撒野！\n"NOR,who);
    	tell_object(who,"你还未及出招，只觉脚下地板突然一陷，你身不由己地掉了下去...\n");
    	who->start_busy(3);
    	call_out("do_xialuo",1,who);
    	return 1;
    }
    else
    {
    	kill_ob(who);
    	return 1;
    }
}
int do_xialuo(object who)
{
    tell_object(who,"你不停下落，心中大骇，双手乱舞，却抓不住任何东西。\n");
    call_out("getto_dilao",2,who);
    return 1;
}
int getto_dilao(object who)
{    
    who->unconcious();
    who->move("/d/menpai/qingcheng/dilao");
    return 1;
}