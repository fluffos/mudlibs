// file    :    jieyin_dizi.c
// attrib  :    npc
// name    :    青城接引弟子弟子
// use     :    青城派看守厢房的弟子
// write   :    xli
// date    :    1998.11

#include <ansi.h>
inherit NPC;



void create() {
  set_name("接引弟子", ({ "jieyin dizi", "dizi" }));
  set("long", @LONG
一位年轻的青城弟子，恭恭敬敬地站在那里。
LONG);
  if (random(3) > 0)
    set("gender", "男性");
  else
    set("gender", "女性");
  set("age", 22);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  set_wugong("unarmed", 100, 100, 1);
  setup();
}

void init() {
  add_action("do_duilian", "duilian");
  add_action("do_qingjiao", "qingjiao");
  call_out("greet_me", 1, this_player());
}

void greet_me(object me) {
  if (me->query("family/family_name") != "青城派")
    tell_object(me, CYN "接引弟子说道：客人累了可以进厢房歇息。\n" NOR);
}

int do_duilian(string arg) {
  object me;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能和他对练呢？\n");
    return 1;
  }
  if (arg == "jieyin dizi" || arg == "dizi") {
    message_vision("$N向接引弟子一恭身，说道：" + me->query("name") + "恭请指教。\n", me);
    command("say 师父命我在此处看守，没有时间和你对练。");
    return 1;
  }

}


int do_qingjiao(string arg) {
  object me;
  string skill, who;
  me = this_player();

  if (arg) {
    if ((sscanf(arg, "%s from %s", skill, who) == 2) ||
      (sscanf(arg, "%s %s", who, skill) == 2))

    {
      if (who == "jieyin" || who == "dizi") {
        message_vision("$N向接引弟子一恭身道：" + me->query("name") + "对于本门武学有些疑问，想请教一下。\n", me);
        command("say 我武功甚为低微，岂敢妄加指点，真是折杀我了！");
        return 1;
      }
    }
  }

}
