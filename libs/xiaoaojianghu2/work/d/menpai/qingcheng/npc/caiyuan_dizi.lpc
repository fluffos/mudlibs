// file    :    caiyuan_dizi.c
// attrib  :    npc
// name    :    青城菜园弟子
// use     :    青城派在菜园种地的弟子
// write   :    xli
// date    :    1998.11

#include <ansi.h>
inherit NPC;



void create()
{
    set_name("菜园弟子",({"caiyuan dizi","dizi"}));
    set("long",@LONG
一位年轻的青城弟子，正在菜园里辛勤地种着菜。
LONG);
    if(random(3)>0)
        set("gender","男性");
    else
        set("gender","女性");
    set("age",22);
    create_family("青城派",9,"弟子");
    set("class","qingcheng");
    setup();
}

void init()
{   
    add_action("do_duilian","duilian");
    add_action("do_qingjiao","qingjiao");
}

int do_duilian(string arg)
{
    object me;
    me = this_player();
    if( me->query("class") != "qingcheng" ) 
    {
        tell_object(me,"你不是青城弟子，怎能和他对练呢？\n");
        return 1;
    }
    if(arg =="caiyuan dizi" || arg =="dizi")
    {
        command("say 我的工作是在菜园种菜，哪有时间和你对练。");
        return 1;
    }
    
}

int do_qingjiao(string arg)
{
    object me;
    string skill,who;
    me = this_player();
    
    if ( arg )
    {
        if (( sscanf(arg, "%s from %s", skill, who) == 2 ) ||
            ( sscanf(arg, "%s %s", who, skill) == 2 ))

        {
            if(who == "caiyuan" || who == "dizi" )
            {
                message_vision("$N向菜园弟子一恭身道："+me->query("name")+"对于本门武学有些疑问，想请教一下。\n",me);
                command("say 我武功甚为低微，岂敢妄加指点，真是折杀我了！");
                return 1;
            }
        }
    }
    
}

