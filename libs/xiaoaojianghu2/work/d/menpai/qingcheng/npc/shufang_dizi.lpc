// file    :    shufang_dizi.c
// attrib  :    npc
// name    :    青城书房弟子
// use     :    青城派书房的弟子
// write   :    xli
// date    :    1999.1

#include <ansi.h>
inherit NPC;



void create()
{
    set_name("书房弟子",({"shufang dizi","dizi"}));
    set("long",@LONG
一位年轻的青城弟子，恭恭敬敬地站在那里。
LONG);
    if(random(3)>0)
        set("gender","男性");
    else
        set("gender","女性");
    set("age",22);
    create_family("青城派",9,"弟子");
    set("class","qingcheng");    
    setup();
}

void init()
{   
    add_action("do_duilian","duilian");
    add_action("do_qingjiao","qingjiao");
    call_out("greet_me",1,this_player());
}

void greet_me(object me)
{
     if( me->query("xli_marks/can_record") )
        tell_object(me,CYN"书房弟子说道：书房里笔墨纸砚齐全，需要的话，可以领取使用（ling 纸)。\n"NOR);
     if( me->query("xli_marks/can_zhuangding") == 2 )
        tell_object(me,CYN"书房弟子说道：有什么零散的纸张需要订成书的可以在这里装订（zhuangding 书名 )。\n"NOR);
}

int do_duilian(string arg)
{
    object me;
    me = this_player();
    if( me->query("class") != "qingcheng" ) 
    {
        tell_object(me,"你不是青城弟子，怎能和他对练呢？\n");
        return 1;
    }
    if(arg =="jieyin dizi" || arg =="dizi")
    {
        message_vision("$N向书房弟子一恭身，说道："+me->query("name")+"恭请指教。\n",me);
        command("say 我没有什么武功根基，就不在此献丑了。");
        return 1;
    }
    
}


int do_qingjiao(string arg)
{
    object me;
    string skill,who;
    me = this_player();
    
    if ( arg )
    {
        if (( sscanf(arg, "%s from %s", skill, who) == 2 ) ||
            ( sscanf(arg, "%s %s", who, skill) == 2 ))

        {
            if(who == "jieyin" || who == "dizi" )
            {
                message_vision("$N向书房弟子一恭身道："+me->query("name")+"对于本门武学有些疑问，想请教一下。\n",me);
                command("say 我武功甚为低微，岂敢妄加指点，真是折杀我了！");
                return 1;
            }
        }
    }
    
}

