// file   : luo_xuan.c
// attrib : NPC
// name   : 罗煊  四师兄，在大理城内闲逛，有关于他的小秘密
// writer : xli
// date   : 1998.10

#include <ansi.h>

inherit NPC;



void create() {
  set_name("罗煊", ({ "luo xuan", "luo" }));
  set("gender", "男性");
  set("age", 24);
  set("title", GRN "青城派四师兄" NOR);
  set("long", @LONG
他是青城派现任四师兄，名列青城四秀之末，却因带艺拜师，武功颇不凡。
LONG);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  set("combat_exp", 150000);
  set("social_exp", 30000);

  set_wugong("jiben-quanfa", 75, 75, 0);
  set_wugong("songfeng-quan", 80, 80, 1);
  set_wugong("cuixin-zhang", 80, 80, 1);

  set_wugong("songfeng-xinfa", 30, 30, 0);

  set_wugong("blade", 80, 80, 0);
  set_wugong("ditang-dao", 50, 50, 1);

  set_wugong("jiujin-ci", 75, 75, 0);
  set_wugong("zhaodi-hong", 70, 70, 0);
  set_wugong("shier-po", 70, 70, 0);
  set_wugong("yunv-zhen", 80, 80, 1);

  set_xiuwei_by_type("unarmed", 450);
  set_xiuwei_by_type("short", 880);
  set_xiuwei_by_type("dodge", 200);

  set_xiuwei_by_type("blade", 200);

  set("force", 300);
  set("max_force", 300);
  set("force_factor", 20);

  setup();
  carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

void init() {
  add_action("do_qingjiao", "qingjiao");
  add_action("do_duilian", "duilian");
}

int do_duilian(string arg) {
  object me;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能和他对练呢？\n");
    return 1;
  }
  if (arg == "luo xuan" || arg == "luo") {
    message_vision("$N向罗煊一恭身，说道：师弟" + me->query("name") + "恭请师兄指教。\n", me);
    command("say 我云游四方，现在没有时间和你对练。");
    return 1;
  }


}

int do_qingjiao(string arg) {
  object me;
  string skill, who;
  me = this_player();

  if (me->query("class") != "qingcheng") {
    tell_object(me, "罗煊看了你一眼，说道：\n");
    tell_object(me, "我与你又不是同门，你请教我，恐怕是找错了人了！\n");
    return 1;
  }

  if (arg) {
    if ((sscanf(arg, "%s from %s", skill, who) == 2) ||
      (sscanf(arg, "%s %s", who, skill) == 2))

    {
      if (who == "luo") {
        if (skill != "ditang-dao") {
          message_vision("$N向罗煊一恭身道：" + me->query("name") + "对于本门武学有些疑问，想请教一下师兄。\n", me);
          command("say 我与你同为司马掌门弟子，武学上有何不懂的，应该问师父才是。");
          return 1;
        }

        return 1;
      }
    }
  }

}
