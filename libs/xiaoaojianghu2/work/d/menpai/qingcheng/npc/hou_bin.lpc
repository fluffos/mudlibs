// file   : hou_bin.c
// attrib : NPC
// name   : 侯斌，青城大师兄，负责在前殿接待客人，可以发路费(小秘密)
// writer : xli
// date   : 1998.10

#include <ansi.h>

inherit NPC;



void create()
{
    set_name("侯斌",({"hou bin","hou"}));
    set("gender","男性");
    set("age",28);
    set("title",CYN"青城派大师兄"NOR);
    set("long",@LONG
他是青城派大师兄，名列青城四秀之首，最受师父司马卫的器重。
LONG);
    create_family("青城派",9,"弟子");
    set("class","qingcheng");
    set("combat_exp",110000);
    set("social_exp",25000);

    set_wugong("jiben-quanfa",70,70,0);
    set_wugong("songfeng-quan",80,80,1);
    set_wugong("cuixin-zhang",80,80,1);
       
    set_wugong("songfeng-xinfa",30,30,0);
    
    set_wugong("jiujin-ci",75,70,0);
    set_wugong("zhaodi-hong",70,70,0);
    set_wugong("shier-po",70,70,0);
    set_wugong("yunv-zhen",80,80,1);
    
    set_xiuwei_by_type("unarmed",450);
    set_xiuwei_by_type("short",900);
    set_xiuwei_by_type("dodge",300);
    
    set("force",320);
    set("max_force",320);
    set("force_factor",20);                          
    
    setup();
    carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
    carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

void init()
{
    add_action("do_qingjiao","qingjiao");
    add_action("do_ling","ling");
}

int do_qingjiao(string arg)
{
    object me;
    string skill,who;
    me = this_player();
    if( me->query("class") != "qingcheng" ) 
    {
        tell_object(me,"你不是青城弟子，怎能向他请教武功呢？\n");
        return 1;
    }       
        
    if ( arg )
    {
        if (( sscanf(arg, "%s from %s", skill, who) == 2 ) ||
            ( sscanf(arg, "%s %s", who, skill) == 2 ))

        {
            if(who == "hou" )
            {
                message_vision("$N向侯斌一恭身道："+me->query("name")+"对于本门武学有些疑问，想请教一下师兄。\n",me);
                command("say 我与你同为司马掌门弟子，武学上有何不懂的，应该问师父才是。");
                return 1;
            }
        }
    }
    
}

int do_ling(string arg)
{
    object givemoney,me;
    me = this_player();
    if(!arg || arg !="路费")
        return notify_fail("你要领什么？\n");
    if( me->query("xli_marks/ling_lufei") )
    {
        tell_object(me,"侯斌对你说道：师父既然派你去做事，我且按本门规矩发给你四两银子作为路费。\n");
        tell_object(me,"一个弟子从后面捧出了一个托盘，里面放着四两纹银，送到你面前。\n");
        tell_object(me,"你恭敬地向侯斌作了一个揖，伸手取了那四两银子，小心地放回袖中。\n");
        givemoney=new("/clone/money/silver");
        givemoney->set_amount(4);
        givemoney->move(me);
        
        me->delete("xli_marks/ling_lufei");
        return 1;
    }
    else
        return notify_fail("师父没有叫你出去做事，拿什么路费啊！\n");
}