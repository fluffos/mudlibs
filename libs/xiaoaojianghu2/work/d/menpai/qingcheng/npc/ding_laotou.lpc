//   (ding_laotou)       
// file   : ding_laotou.c
// attrib : NPC
// name   : 丁老头，菜园管事
// writer : xli
// date   : 1998.10

#include <ansi.h>

inherit NPC;
string do_caiyuan_bangmang(object);
string *caiyuan_things = ({
  "一包白菜籽", "一包萝卜籽", "一包青菜籽", "一包西瓜籽", "一包苹果籽", "一袋桃子核",
  "一把锄头", "一个菜篮", "一把铲子", "一架梯子", "一把砍刀", "一根草绳",
});
string *things_where = ({
  "前殿", "后殿", "半山亭", "厢房", "松风观", "武器房", "练武厅"
});


void create() {
  set_name("丁老头", ({ "ding laotou", "ding", "laotou" }));
  set("gender", "男性");
  set("age", 54);
  set("title", CYN "菜园管事" NOR);
  set("long", @LONG
他是青城派菜园的管事，在菜园里领着几个弟子辛劳地工作了很多年了。
LONG);
  create_family("青城派", 8, "弟子");
  set("class", "qingcheng");
  set("combat_exp", 20000);
  set("social_exp", 55000);

  set_wugong("songfeng-quan", 50, 50, 1);

  set_wugong("songfeng-xinfa", 15, 15, 0);

  set_wugong("jiujin-ci", 35, 35, 0);
  set_wugong("shier-po", 20, 20, 1);

  set_xiuwei_by_type("unarmed", 120);
  set_xiuwei_by_type("short", 310);
  set_xiuwei_by_type("dodge", 80);

  set("force", 180);
  set("max_force", 180);
  set("force_factor", 10);
  set("inquiry", ([
    "帮忙": ( : do_caiyuan_bangmang: ),
  ]));

  setup();
  carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

void init() {
  add_action("do_qingjiao", "qingjiao");
  add_action("do_duilian", "duilian");
}

int do_duilian(string arg) {
  object me;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能和他对练呢？\n");
    return 1;
  }
  if (arg == "ding laotou" || arg == "ding" || arg == "laotou") {
    message_vision("$N向丁老头一恭身，说道：师侄" + me->query("name") + "恭请师伯指教。\n", me);
    command("say 我正忙着种菜，现在没有时间和你对练。");
    return 1;
  }

}

int do_qingjiao(string arg) {
  object me;
  string skill, who;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能向他请教武功呢？\n");
    return 1;
  }
  if (arg) {
    if ((sscanf(arg, "%s from %s", skill, who) == 2) ||
      (sscanf(arg, "%s %s", who, skill) == 2))

    {
      if (who == "ding" || who == "laotou") {
        message_vision("$N向丁老头一恭身道：" + me->query("name") + "对于本门武学有些疑问，想请教一下师伯。\n", me);
        command("say 我已不问本门武功多年，武学上有何不懂的，应该问你的师父才是。");
        return 1;
      }
    }
  }

}

string do_caiyuan_bangmang(object me) {
  int place;
  int now_thing;
  int things_place;
  me = this_player();

  place = me->query("xli_marks/renwu_where");
  if (!me->query("xli_marks/do_renwu"))  // 不是派来帮忙的
  {
    command("say 你真是勤快，不过菜园现在并不忙。");
    return "你就不用到这里来帮我了，还是多多练功吧！\n";
  }
  if (place != 3)  // 不是派到这里来的
  {
    command("say 司马掌门可没说要你到这里来帮忙啊！");
    return "是不是你记错地方了？\n";
  }
  if (me->query("xli_marks/finish_renwu"))  // 这个任务已经完成了
    return "你已经完成司马掌门的任务了，这就回去复命吧！\n";

  now_thing = me->query("xli_marks/now_thing");
  if (now_thing > 10) {
    now_thing = random(10);
    me->set("xli_marks/now_thing", now_thing);
  }
  if (now_thing)  // 已经给任务了
  {
    command("say 不是叫你取「" + caiyuan_things[now_thing - 1] + "」吗？");
    command("? " + me->query("id"));
    return "还不快去拿?\n";

  }
  now_thing = random(sizeof(caiyuan_things)) + 1;
  things_place = random(sizeof(things_where)) + 1;
  command("say 现在菜园里正缺「" + caiyuan_things[now_thing - 1] + "」，你就去取一下吧！");
  me->set("xli_marks/now_thing", now_thing);       // 要取的东西
  me->set("xli_marks/things_place", things_place);  // 要取的地方
  return "记得尽快拿回来。\n";

}

int accept_object(object ppl, object obj) {
  object me;
  me = this_player();
  if (me->query("xli_marks/renwu_where") == 3 && me->query("xli_marks/find")) {
    command("smile " + me->query("id"));
    tell_object(me, me->query("name") + "真不错，很勤快！\n");
    me->delete("xli_marks/renwu_where");
    me->delete("xli_marks/do_renwu");
    me->set("xli_marks/finish_renwu", 1);
    tell_object(me, "你可以回去向司马掌门复命了！\n");
    return 1;
  } else
    return 0;
}
