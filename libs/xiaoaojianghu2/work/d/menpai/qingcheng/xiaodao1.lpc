inherit ROAD;



void create()
{
    set("short","小道");
    set("long", @LONG
一条弯弯曲曲的小道，磐石铺就，石缝中间杂有许多小石头，少的可怜的一
点泥土里竟然有着一些矮小的绿草。道旁隔几步就有一棵柳树，柳枝轻飘，柳絮
随风四处飞扬，如入仙境。
LONG);
    set("exits",([
    "south"  : __DIR__"lianwu_ting",
    "west"   : __DIR__"chufang",
    "north"  : __DIR__"mofang",
    ]));

    setup();

}

