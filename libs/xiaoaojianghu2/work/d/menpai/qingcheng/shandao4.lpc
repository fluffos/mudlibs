inherit ROAD;



void create()
{
    set("short","山道");
    set("long", @LONG
一条曲折的山道，一眼看不到头，走的人不多，路面很狭窄，坑坑洼洼的。
旁边杂草丛生，野花处处，时有野兔等窜出。夏夜还经常可以听到蛐蛐在草丛中
低鸣，甚为清净闲适。
LONG);
    set("exits",([
    "northdown"  : __DIR__"caiyuan",
    "westup"     : __DIR__"shandao5",
    "eastup"     : __DIR__"shandao6",
    ]));

    setup();

}

