// file : pantao.c
// name : 千年蟠桃
// attrib : ITEM 青城作quest所用之物
// write : xli
// date : 1998.12

#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;


void create()
{
    set_name(GRN"千年蟠桃"NOR,({"pan tao","tao"}));
    set("long","一盒"+GRN"千年蟠桃"NOR+"，香气四溢，据说吃了后能延年益寿，还有贮颜养容之功效。");
    set("weight",1000);
    if( clonep() )
        set_default_object(__FILE__);
    else 
    {
        set("unit", "盒");
        set("cant_sell", "这虽说是蟠桃，可也容易腐烂，小店不收！\n");
        set("value", 100000);
        set("material", "wood");   // :)
    }
    setup();
}

void init()
{
    add_action("do_eat","eat");
   add_action("do_give","give");
}

int do_eat(string arg)
{   
    object me;
    int now_class_score;
    me = this_player();
    now_class_score=me->query("class_score/青城派");    
    if(!arg || (arg != "pan tao" && arg !="tao") )
        return 0;    
    if(me->query("class")=="qingcheng")
    {
        tell_object(me,HIY"你从怀里拿出师父给的"NOR+GRN"千年蟠桃"NOR+"，忍不住一口咬下...\n"NOR);
        tell_object(me,"你刚刚啃下一小块来，忽然觉得大事不好！\n");
        tell_object(me,"原来一位青城弟子从你身边匆匆走过，看见你手中的蟠桃，马上停了下来。\n");
        tell_object(me,"他对你怒气冲冲地说道：\n");
        tell_object(me,RED"这是司马掌门给你祝寿用的蟠桃，你竟然敢自己偷吃，真是目无师门！\n"NOR);
        tell_object(me,RED"我回去一定禀告师父，真为我青城丢脸！\n"NOR);
        tell_object(me,"青城弟子看了你一眼，匆匆离开了，嘴里还不住骂骂咧咧的。\n"NOR);
        tell_object(me,CYN"你耳边隐约响起了一个声音：你这个倒霉鬼！呵呵!\n"NOR);
        // me->set("class_score/青城派",now_class_score-10);
        me->set("xli_marks/eat_pantao",1); // 作一个吃过蟠桃的记号
        return 1;
    }      
    tell_object(me,"你从怀里拿出"+GRN"千年蟠桃"NOR+"，仔细看了看。\n");
    tell_object(me,"你心中起念：不知道我吃了这千年蟠桃会如何？\n");    
    tell_object(me,"你张开嘴，一口咬了下去...\n");
    
    if( random(20)==0 
     && me->query("kar")>25 && me->query("kar")<30 
     && me->query("mud_age")%100000 <200
      )
    {
        tell_object(me,"蟠桃甜甜的汁水流了你满嘴。\n");
        tell_object(me,"你只觉香气四溢，精神为之一振！\n");
        me->add("max_age",1); // 延年益寿
        me->add("per",1);     // 贮颜养容
        destruct(this_object());
        return 1;
    }
    tell_object(me,"一个声音突然从天空中传到了你耳中：\n");
    tell_object(me,GRN"千年蟠桃"NOR+"是千年难遇的宝物，竟然被你私自吃下，好大的胆子！\n");
    message_vision(HIY"突然一个晴空霹雳，不偏不倚，正打在$N的头顶。\n"NOR,me);
    message_vision(HIY"$N当场全身焦黑，一阵抽搐，昏倒过去！\n"NOR,me);
    if( (16+me->query("mud_age")/86400 ) < me->query("max_age") )
        me->add("max_age",-1);
    if( me->query("per")>12 )
        me->add("per",-1);
    
    me->unconcious();
        
    destruct(this_object());
    return 1;
}

int do_give(string arg)
{ 
	return 1;
	}