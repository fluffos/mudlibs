#include <weapon.h>
inherit SHORT;


void create()
{
    set_name("东西",({"item"}));
    set("long","一个东西");
  	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
        set("cant_sell", "这是什么东西？我不认识！\n");
		set("value", 1);
		set("material", "steal");
         }
	init_short(1);
	setup();
}

