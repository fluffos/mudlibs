//   attrib:   room of QingCheng
//   name  :   厨房
//   writer:   xli
//   date  :   1998.10
//  这里的厨房我想做个尝试，就是让吃饭更有意思，起码在描述上
//   Last Modified:xli 1999.9

inherit ROOM;
#include <ansi.h>


void create()
{
    set("short","厨房");
    set("long", @LONG
这里是青城派自己的厨房，负责提供上下人众的一日三餐。几位厨师正在灶
下忙着，旁边有些桌椅，一些青城弟子正坐在那里吃饭谈话，有说有笑的，显得
很热闹，几个年青的烧火弟子正站在桌子旁服侍着，忙着端菜送水。青城弟子饿
了的时候，就到这里来吃饭(ZUO)。
LONG);
    set("exits",([
    "east"  : __DIR__"xiaodao1",
    ]));
    set("objects",([
    __DIR__"npc/liu_chushi" : 1,
    __DIR__"npc/shaohuo_dizi" : 2+random(2),
    ]));

    setup();
}

void init()
{
    add_action("do_zuo","zuo");
}

int do_zuo()
{
    object me;
    string *cai_name = ({
    RED"爆炒扁豆"NOR,WHT"清蒸豆腐"NOR,GRN"素烩白菜"NOR,CYN"炒土豆丝"NOR,
    YEL"油煎鸡蛋"NOR,HIK"蘑菇竹笋"NOR,MAG"青椒黄瓜"NOR,BLU"凉拌粉丝"NOR
    });
    me = this_player();
    message_vision("$N大叫一声：拿菜单来啊！\n",me);
    if(me->query("family/family_name") != "青城派")
    {
        message_vision("刘厨师冲$N说道：你不是青城弟子，来这里吃饭干嘛？\n",me);
        message_vision("$N讪讪地站了起来，一声不吭地走了出去。\n",me);
        me->move(__DIR__"xiaodao1");
        return 1;
    }
    message_vision("一个烧火弟子拿来了一份菜单。\n",me);
    message_vision("$N翻开菜单，点了一道"+cai_name[random(sizeof(cai_name))]+"、一碗饭，吃了起来\n", me);
    me->start_busy(1);
    me->set("food", (int)me->max_food_capacity());
    me->set("water", (int)me->max_water_capacity());
    message_vision("$N满意地擦了一下嘴，站了起来。\n",me);
    return 1;
}

