#include <ansi.h>
inherit ROAD;



void create()
{
    set("short","碎石小径");
    set("long", @LONG
一条碎石铺就的小径，斑斑点点的路面显得很有生机。西边隐隐传来练武厅
里弟子们练功的喊声，而东边则是宁静的观主卧室。小径两侧有几张石椅石桌，
芳草遍地，野花间杂其间。
LONG);
    set("exits",([
    "west"  : __DIR__"lianwu_ting",
    "east"  : __DIR__"guanzhu_woshi",
    "north" : __DIR__"liangong_fang",
    ]));

    set("objects",([
    __DIR__"npc/yu_qiang" : 1,
    ]));
    setup();
}

int valid_leave(object me, string dir)
{
    if ( dir == "east" )
        return notify_fail(YEL"那是青城派掌门的卧室，怎能随便闯入呢？\n"NOR);
    return ::valid_leave(me, dir);
}

