inherit ROOM;



void create()
{
    set("short","观主卧室");
    set("long", @LONG
一间幽雅的卧室，干净整洁的床铺，木板拼接成的小柜子紧靠床放着，一盆
散发着幽香的兰花放置于墙角。墙上挂着几张字幅和丹青，皆为观主亲手书画。
房间内的布置简单且古朴，透出一份观主的闲逸和与世无争。
LONG);
    set("exits",([
    "west"  : __DIR__"stone_xiaojing",
    ]));

    setup();

}

