inherit ROOM;
#include "/d/menpai/qingcheng/qc_room.h"


void create() {
  set("short", "后殿");
  set("long", @LONG
这里就是青城派松风观后殿，青砖铺地，琉璃为瓦，雕梁画栋，气派不凡。
只见正中坐着一个身穿青色道袍的矮小道人，约莫有五十来岁年纪，脸孔瘦削，
瞧他这副模样，最多不过七八十斤重。若非亲见，又怎能相信这位道人便是青城
派现任掌门，名满天下的司马卫司马掌门！
LONG);
  set("objects", ([
    __DIR__ "npc/sima_wei": 1,
  ]));
  set("exits", ([
    "west": __DIR__ "songfeng_guan",
    "east": __DIR__ "lianwu_ting",
  ]));

  setup();
  call_other(CLONE_DIR "board/qc_b", "???");
}
