inherit ROOM;
#include "/d/menpai/qingcheng/qc_room.h"


void create() {
  set("short", "松风观");
  set("long", @LONG
这里就是青城派的松风观，屋顶非常高，进门正面摆放着一张清漆木桌，上
面摆放着一个香炉，袅袅青烟的后面墙上挂着一幅画，画上一位老人仙风道骨，
正是青城派开山祖师长青子的画像。两边各摆放着一排靠椅和几张茶几。
LONG);
  set("exits", ([
    "north": __DIR__ "pianfang",
    "south": __DIR__ "wuqifang",
    "west": __DIR__ "huilang",
    "east": __DIR__ "houdian",
  ]));

  setup();

}
