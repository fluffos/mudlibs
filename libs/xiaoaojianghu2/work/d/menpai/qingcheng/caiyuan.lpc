inherit ROAD;


void create()
{
    set("short","菜园");
    set("long", @LONG
这里原一片杂草地，经过青城弟子们的努力，现在已经是青城派的菜园了。
虽然地方不大，但各菜垄井井有条，菜地里长满了各种蔬菜，菜地旁边还种了一
些果树。这里负责为众人每日三餐供应蔬菜，并提供招待客人用的水果。
LONG);
    set("objects",([
    __DIR__"npc/ding_laotou" : 1,
    __DIR__"npc/caiyuan_dizi" : 2+random(2),
    ]));
    set("exits",([
    "southup"  : __DIR__"shandao4",
    "northwest": __DIR__"xiaodao2",
    ]));

    setup();

}

