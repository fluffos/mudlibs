#include <ansi.h>
inherit ROOM;



void create()
{
    set("short","练功房");
    set("long", @LONG
这里是青城派本门的练功房，里面有三间内厅，供青城弟子练习武功所用。
只有经过了掌门司马卫的允许，才能得以进入里面的三个内厅自行参修武功，
以获得武学上的精进。房门上有一张告示(paper)。
LONG);
    set("exits",([
    "south" : __DIR__"stone_xiaojing",
    "west"  : __DIR__"neiting1",
    "east"  : __DIR__"neiting2",
    "north" : __DIR__"neiting3",
    ]));

    set("item_desc", ([
            "paper" : (@LONG
            ==========================================
                     【本派弟子参修须知】           
            ------------------------------------------
            得到司马掌门的许可后方可进入内厅参修本门的
            武功，进入内厅后时间有限，时间一到，必须自
            行出来。中途不得换内厅，如未到限定的时间出
            内厅即为自动放弃本次机会，未经司马掌门允许，
            不得再次进入内厅。
            ------------------------------------------
LONG), 
    ]) );

    setup();
}

int valid_leave(object me, string dir)
{
    if ( dir == "west" || dir == "north" || dir == "east" ) 
    {
        if(  me->query( "family/family_name" ) != "青城派" )
            return notify_fail(YEL"内厅是青城派的本门之地，你进去有所不妥吧！\n"NOR);
        if(! me->query("xli_marks/can_lian"))
            return notify_fail(YEL"你未得司马掌门许可，不得擅自入内参修！\n"NOR);
        me->delete("xli_marks/can_lian");
        me->set("xli_marks/can_canxiu",1); // 可以开始参修了
        call_out("pull_out",180,me);
    }
    return ::valid_leave(me, dir);
}

int pull_out(object me)
{
   if(!objectp(me)) return 1; //这样做很不好啊，quit以后记号就去不掉了。sigh,凑合一下先
    if(living(me) && (environment(me)->query("short") == "归鹤厅"
                     || environment(me)->query("short") == "流云厅"
                     || environment(me)->query("short") == "听松厅") )
    {
        tell_object(me,CYN"突然门外响起了一个声音：你参修时间已到，就请出来吧！\n"NOR);
        tell_object(me,"你说道：是，弟子这就出去。\n");
        me->delete("xli_marks/can_canxiu");   // 去掉参修的记号，必须出来了
        if( !me->can_act() || me->is_fighting() )
            return 1; // 可以将本次参修完成
        me->move("/d/menpai/qingcheng/liangong_fang"); // 闲着的话就出来吧！
    }
    return 1;    
}
