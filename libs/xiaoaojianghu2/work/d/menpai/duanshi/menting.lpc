#include <room.h>
#include <ansi.h>

inherit DOOR_ROOM;

void create() {
  set("short", "门厅");
  set("long", @LONG
从王府大院一进来，是一间门厅。这里是通往王府上层人物日常活动的中心。
房间并不大，靠墙是一排供客人们放大衣和披风的雕花檀木柜子。左右各有一条
走廊通向内宅。前面是两扇巨大的雕花朱漆大门，通向王府大厅。
LONG
  );
  set("exits", ([
    "west": __DIR__ "zoulang13",
    "east": __DIR__ "zoulang28",
    "south": __DIR__ "wangfu_dayuan",
    "north": __DIR__ "dating",
  ]));
  set("objects", ([
    __DIR__ "npc/weishi1": 4,
  ]));
  create_door("north", "两扇巨大的雕花朱漆大门", "south", DOOR_CLOSED);
  setup();
}

int valid_leave(object me, string dir) {
  object *inv;
  string name, firstname;
  int i;
  inv = all_inventory(this_object());

  if (dir == "east" || dir == "west" || dir == "north") {
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("title") == YEL "镇南王府卫士" NOR
        && !inv[i]->is_killing()
        && living(inv[i])
        && !userp(inv[i])) {
        if (me->query("class") != "duanshi") {
          if (me->query("positive_score") <= 2000)
            return notify_fail(
              inv[i]->query("name") + "走上前恭声说道：“王爷身体不适，不便见外客。请改日再来！”\n"
            );
          else {
            name = me->query("name");
            firstname = name[0..1];
            message_vision(HIY "$N朗声说道：“原来是" +
              name + firstname + RANK_D->query_respect(me) + "来访。请进请进！”\n" NOR, inv[i]);
          }
        }
        if (me->query("class") == "duanshi") {
          if (me->query("title") == "镇南王府见习家丁"
            || me->query("title") == "镇南王府家丁"
            || me->query("title") == BLU "镇南王府家丁" NOR)
            return notify_fail(
              inv[i]->query("name") + "喝道：“你级别不够，不能擅自进入内宅！”\n"
            );
        }
        i = sizeof(inv);
      }
    }
  }
  return ::valid_leave(me, dir);
}
