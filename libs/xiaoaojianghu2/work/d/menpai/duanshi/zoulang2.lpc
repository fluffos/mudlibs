#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "走廊");
	set("long", @LONG
这是条连接王府内宅各个部分的走廊，飞檐红柱，大理石铺就的地面一尘不
染，两个衣着光鲜的小丫鬟认真的在擦洗两边的栏杆和柱子，不时有值班的卫士
走过来。向走廊周围望去，可以看到绚丽的茶花丛中隐现着一座座殿宇院落。
LONG
	);
    set("exits", ([ 
			"north" : __DIR__"zoulang1",
			"east"  : __DIR__"zoulang3",
        ]));
	set("objects", ([
			__DIR__"npc/shinv2" : 2*random(2),
			__DIR__"npc/weishi1"    : random(2),
		]));
	setup();
	//place_program(ROOM);
}                       

