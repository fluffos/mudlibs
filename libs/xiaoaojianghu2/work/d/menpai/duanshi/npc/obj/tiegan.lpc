//tiegan.c
#include <weapon.h>

inherit WHIP;

void create()
{
    set_name("铁竿", ({ "tie gan","gan" }) );
    set_weight(2000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long","褚万里的独门兵刃，看似普通的渔竿，然而竿是铁打的，钓线是钢丝拧成。\n");
        set("unit", "条");
        set("value", 2000);
        set("material", "steel");
    }
    init_whip(50);

    set("wield_msg", "$N从身后抽出一条$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n绑在身后。\n");

    setup();
}

