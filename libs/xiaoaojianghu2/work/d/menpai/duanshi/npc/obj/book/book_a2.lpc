inherit ITEM;

void create()
{
    set_name("「快歌行」", ({ "kuaige xing", "book", "shu" }));
    set_weight(250);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "a2");
    set("long", "这是一本薄薄的诗集，由于看的人多，都有点卷边了。\n");
    set("value", 150);
    set("material", "paper");
    set("skill", ([
        "name"              :"kuaige-dao",
        "xiuwei_required"   : 80,
        "literate_required" : 70,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 80,
        "max_lingwu"        : 80,
        "bonus_jilei"       : 2+random(5),
        ]) );
    }
}   

#include "duan_book.h"
         