// banfu1.c  
#include <weapon.h>

inherit TWOHANDS_AXE;

void create()
{
        set_name("板斧", ({ "ban fu","axe" }) );
        set_weight(3600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "对");
                set("long", "一对沉重的板斧，上面工整地镌刻着“镇南王府 段”。\n");
                set("value", 800);
                set("material", "iron");
                set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");
                set("wield_msg", "$N抽出两把$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
        init_twohands_axe(30);
        setup();
}
