inherit ITEM;

void create()
{
    set_name("「杖法探奥」", ({ "zhangfa tanao", "book", "shu" }));
    set_weight(250);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "b0");
    set("long", "这是一本比较深入讲述杖法的书。\n");
    set("value", 240);
    set("material", "paper");
    set("skill", ([
        "name"              :"staff",
        "xiuwei_required"   : 10,
        "literate_required" : 5,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 60,
        "max_lingwu"        : 60,
        "bonus_jilei"       : 2+random(5),
        ]) );
    }
}   

#include "duan_book.h"
         