// jadeblade 碧玉钢刀 writen by tea 10.17.98

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
	set_name(HIG"碧玉钢刀"NOR, ({ "jade blade" , "blade" }) );
	set_weight(2500);
        set("long","一把精钢打制的刀，长约二尺半，柄镶碧玉，刀峰寒气凌人，上面工整地镌刻着“镇南王府 段”\n");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value",25000);
		set("material", "steel");
		set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");

	}
	init_blade(35);
	set("wield_msg", "$N「唰」的一声抽出一把闪亮的$n提在手中。\n");
	set("unwield_msg", "$N将手中的$n插入腰间。\n");
	setup();
}
