#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(MAG"紫铜鼎"NOR, ({ "tong ding", }));
    set_weight(300000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "口");
    set("long", "这是一口巨大的"MAG"紫铜鼎"NOR"，鼎身上铭刻着花纹，有些仿佛是文字。\n");
    set("value", 50000);
    set("material", "steel");
    set("skill", ([
        "name"              :"dingnan-dao",
        "literate_required" : 120,
        "gin_cost"          : 30+random(10),
        "max_jibie"         : 100,
        "max_lingwu"        : 100,
        "bonus_jilei"       : 0,
        ]) );
    }
}   

#include "duan_book.h"
