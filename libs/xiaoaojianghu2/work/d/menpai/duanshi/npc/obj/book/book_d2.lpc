inherit ITEM;

void create()
{
    set_name("「天虹步」", ({ "tianhong bu", "book", "shu" }));
    set_weight(100);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "d2");
    set("long", "这是一本讲述天虹步的书，已经不全了。\n");
    set("value", 150);
    set("material", "paper");
    set("skill", ([
        "name"              :"tianhong",
        "xiuwei_required"   : 100,
        "literate_required" : 50,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 30,
        "max_lingwu"        : 30,
        "bonus_jilei"       : 2+random(5),
        ]) );
    }
}   

#include "duan_book.h"
         