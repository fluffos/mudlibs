inherit NPC;
inherit F_MASTER;

#include <ansi.h>

string *chat_msg = ({
	"古笃诚警惕地向四周望了望，回身向屋里看了一眼，见一切正常，似乎略放了放心。\n",
	"古笃诚抽出腰间的两把板斧，爱惜地看看，又插回腰间。\n",
	"古笃诚挺了挺胸膛，又紧了紧腰带，显得更加英武神气。\n",
});

void create()
{
	set_name("古笃诚", ({ "gu ducheng", "gu", "ducheng" }) );
	set("title",CYN"大理国"GRN"四大卫护"NOR);
	set("gender", "男性");
	set("age", 39);
	set("attitude", "peaceful");
	set("class", "duanshi");
	set("long", @LONG
古笃诚身为大理国四大卫护之一，是这四者中最象武士的一个。他生得满面
络腮胡须，善使一对板斧，膂力过人，对段家忠心耿耿。
LONG);
	set("str", 34);
	set("int", 22);
	set("spi", 25);
	set("con", 27);
	set("cps", 27);
	set("cor", 22);
	set("per", 20);
	set("force", 1700);
	set("max_force", 1700);
	set("force_factor", 15);
	set("max_kee",600);
	set("kee",600);
	set("max_sen",800);
	set("sen",800);

	set("class_score/镇南王府", 800);
	set("combat_exp", 50000);
	set("social_exp", 300000);
	set("positive_score", 10000);

	set_wugong("jiben-qinggong",160,160,0);
	set_wugong("unarmed",140,140,0);
	set_wugong("duanshi-neigong",160,160,1);
	set_wugong("blade",160,160,0);       
	set_wugong("kuaige-dao",140,140,0);
	set_wugong("zuiliu-dao",120,120,1);
	set_wugong("haofeng-quan",120, 120, 0);
	set_wugong("zhuifeng-quan",90,90,1);
	set_wugong("tianhong",140,140,0);
	set_wugong("shenxing",120,120,1);
	set_wugong("pangencuojie",100,100,1);

	set_xiuwei_by_type("blade",900);
	set_xiuwei_by_type("unarmed",700);
	set_xiuwei_by_type("dodge",700);
        set_xiuwei_by_type("zonggang",700);

	set("env/attack", 60);

	create_family("镇南王府", 1, "卫护");

	setup();

	carry_object(CLONE_DIR"wear/boots/wuyun_xue")->wear();
	carry_object(CLONE_DIR"wear/waist/chahe_luandai")->wear();
	carry_object(CLONE_DIR"wear/cloth/baizhu_sipao")->wear();
	carry_object(CLONE_DIR"wear/head/qingsha_jin")->wear();
	carry_object(__DIR__"obj/banfu")->wield();
}
#include "weihu.h";
#include "teach.h";