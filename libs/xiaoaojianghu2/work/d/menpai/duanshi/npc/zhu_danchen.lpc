inherit NPC;
inherit F_MASTER;

#include <ansi.h>

string *chat_msg = ({
	"朱丹臣低声吟道：“‘仗剑行千里，微躯敢一言。’好诗好诗……”\n",
	"朱丹臣高声颂道：“‘曾为大梁客，不负信陵恩。’倜傥慷慨，真令人倾倒！”\n",
	"朱丹臣一边吟诗，一边用手在空中摹写诗句。\n",
	"“映门淮水绿，留骑主人心。明月随良椽，春潮夜夜深。”朱丹臣吟罢，不由得兴奋得击节赞叹。\n",
});

void create()
{
	set_name("朱丹臣", ({ "zhu danchen", "zhu", "danchen" }) );
	set("title",CYN"大理国"GRN"四大卫护"NOR);
	set("gender", "男性");
	set("age", 35);
	set("attitude", "peaceful");
	set("class", "duanshi");
	set("long", @LONG
朱丹臣身为大理国四大卫护之一，一身功夫自是颇为不弱，而更令人惊奇的
是他的文采也非常的好，他几乎手不释卷，总拿着一本书抽空阅读。看起来
他更象一位文生公子，而不怎么象一个纠纠武夫。
LONG);
	set("str", 22);
	set("int", 33);
	set("spi", 30);
	set("con", 25);
	set("cps", 30);
	set("cor", 23);
	set("per", 28);
	set("force", 1500);
	set("max_force", 1500);
	set("force_factor", 15);
	set("max_kee",600);
	set("kee",600);
	set("max_sen",700);
	set("sen",700);

	set("class_score/镇南王府", 800);
	set("combat_exp", 40000);
	set("social_exp", 300000);
	set("positive_score", 8000);

	set_wugong("jiben-qinggong",140,140,0);
	set_wugong("unarmed",120,120,0);
	set_wugong("duanshi-neigong",150,150,1);
	set_wugong("blade",140,140,0);       
	set_wugong("kuaige-dao",120,120,0);
	set_wugong("zuiliu-dao",100,100,1);
	set_wugong("haofeng-quan",100,100, 0);
	set_wugong("zhuifeng-quan",85,85,1);
	set_wugong("tianhong",120,120,0);
	set_wugong("shenxing",100,100,1);
	set_wugong("shuhuai-bifa",100,100,1);
	set_wugong("literate",120,120,0);

	set_xiuwei_by_type("blade",600);
	set_xiuwei_by_type("unarmed",600);
	set_xiuwei_by_type("dodge",600);
	set_xiuwei_by_type("short",900);
        set_xiuwei_by_type("zonggang",600);

	set("env/attack", 55);	

	create_family("镇南王府", 1, "卫护");

	setup();

	carry_object(CLONE_DIR"wear/boots/wuyun_xue")->wear();
	carry_object(CLONE_DIR"wear/waist/chahe_luandai")->wear();
	carry_object(CLONE_DIR"wear/cloth/baizhu_sipao")->wear();
	carry_object(CLONE_DIR"wear/head/qingsha_jin")->wear();
	carry_object(__DIR__"obj/golden_pen")->wield();
}

