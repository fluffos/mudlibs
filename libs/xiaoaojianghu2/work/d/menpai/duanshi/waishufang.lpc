#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "外书房");
	set("long", @LONG
镇南王的外书房，地上铺着厚厚的地毯，踩在上面就象踩在棉花堆上一样，
一点声音也没有。三面是高达屋顶的书架，上面摆放着无数书籍。这些书中，固
然有很多诗词歌赋，但是也许有一些不是非常重要的武学典籍，因为镇南王本人
也是位武学名家啊。窗前是一张巨大的书桌，上面摆放着文房四宝。桌子上有一
张纸(paper)。  
LONG
	);
    set("exits", ([ 
	        "west"  : __DIR__"zhengyuan",
        ]));
    set("item_desc", ([
            "paper" : (@LONG
            ==========================================
            |           【本府家人借书单】           |
            |----------------------------------------|     
            |    〖刀法类〗     |    〖轻功类〗      |              
            |a0.「醉柳拂风图」  |d0.「化书」         |
            |a1.「醉柳刀法」    |d1.「雨后虹霓图」   |
            |a2.「快歌行」      |d2.「天虹步」       |
            |a3.「横刀六式精要」|d3.「轻功秘奥」     |
            |a4.「横刀六式」    |d4.「提纵之术」     |
            |                   |d5.「闪躲之术」     |
            |----------------------------------------|
            |    〖棍法类〗     |    〖鞭法类〗      |
            |b0.「杖法探奥」    |e0.「狂风鞭法残本」 |
            |b1.「基本杖法」    |e1.「鞭法精要」     |
            |                   |e2.「基本鞭法」     |
            |----------------------------------------|
            |    〖拳脚类〗     |    〖短兵类〗      |
            |c0.「大风歌」      |f0.「魏征诗集」     |
            |c1.「追风秘本」    |f1.「短兵战技」     |
            |c2.「浩风拳谱」    |f2.「近身搏斗术」   | 
            |c3.「拳脚入门」    |                    |
            ==========================================
LONG), 
    ]) );

	set("objects", ([
			__DIR__"npc/shutong" : 1,
		]));

    set("bookstore_a0", 1);
    set("bookstore_a1", 1);
    set("bookstore_a2", 1);
    set("bookstore_a3", 2);
    set("bookstore_a4", 2);
    set("bookstore_b0", 1);
    set("bookstore_b1", 2);
    set("bookstore_c0", 1);
    set("bookstore_c1", 1);
    set("bookstore_c2", 2);
    set("bookstore_c3", 2);
    set("bookstore_d0", 1);
    set("bookstore_d1", 1);
    set("bookstore_d2", 1);
    set("bookstore_d3", 2);
    set("bookstore_d4", 2);
    set("bookstore_d5", 2);
    set("bookstore_e0", 1);
    set("bookstore_e1", 2);
    set("bookstore_e2", 2);
    set("bookstore_f0", 1);
    set("bookstore_f1", 2);
    set("bookstore_f2", 2);

	setup();
}                       

