// whip.c 1
inherit ITEM;
void create()
{
    set_name("基本鞭法", ({ "jiben bianfa", "shu", "book" }));
    set_weight(300);
        if( clonep() )
            set_default_object(__FILE__);
        else {
        set("unit","本");
        set("long","这是一本介绍基本鞭法的书，看起来颇为高深。\n");
        set("value", 2000);
        set("material", "paper");
        set("skill", ([
                "name"             : "whip",
                "xiuwei_required"  : 0,
                "literate_required": 5,
                "gin_cost"         : 10+random(10),
                "max_jibie"        : 60,
                "bonus_jilei"      : 0,
                "bonus_xiuwei"     : 2,
                "max_xiuwei"       : 150,
                "bonus_combat_exp" : 5,
                "max_combat_exp"   : 1000,
                "bonus_social_exp" : 0,
                "max_social_exp"   : 0,
                ]) );
        }
}
