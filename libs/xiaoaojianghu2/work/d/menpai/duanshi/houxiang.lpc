#include <room.h>
#include <ansi.h>

inherit ROOM;

string *things = ({
        CLONE_DIR + "book/shu",
        CLONE_DIR + "book/guwen",
		CLONE_DIR + "eat/food/yougao",
		CLONE_DIR + "eat/fruit/mangguo",
		CLONE_DIR + "eat/liquid/hulu",
		CLONE_DIR + "wear/cloth/cloth3",
                });

void create()
{
	set("short", "帐房后厢");
	set("long", @LONG
这里是镇南王府的帐房后厢，光线昏暗，略显凌乱，靠墙是张小床，挂着不
甚干净的帐子，边上是一张木桌和几把椅子，角落里还有个柜子。这里是崔先生
的住处，花老爷子平时晚上住在大理东街自己家里，白白天来王府管事，最近病
了以后就由住这里的管杂务的霍先生掌管帐房了。霍先生孤身一人在王府呆了十
多年了。平时和下人们喝酒赌博嘻嘻哈哈很随便的，下人们和他很合的来。
LONG
	);
    set("exits", ([ 
	        "west"  : __DIR__"zhangfang",
        ]));
	if (random(2))
	{
	    set("search_things",([
    	        "柜子" :  things[random(sizeof(things))],
        	]) );
	}
	setup();
	//place_program(ROOM);
}                       

