inherit ROOM;

void create()
{
	set("short", "柴房");
	set("long", @LONG
这里是伙房后面的柴房。地上有不少折断的小树枝，四周堆放着一捆捆的干
柴。王府上因为人口很多，所以每天消耗的烧柴的量也很大，不时地派人出去购
买烧柴，偶尔也派些家丁上山砍柴。东面通向伙房。
LONG
	);
    set("exits", ([ 
	        "east"  : __DIR__"huofang",
        ]));
	setup();
	//place_program(ROOM);

