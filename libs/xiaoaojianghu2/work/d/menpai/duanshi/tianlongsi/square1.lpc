#include <room.h>
inherit ROOM;

void create()
{
	set("short", "大道");
	set("long",@LONG
走入寺门，眼前青石铺地，一条宽阔的大道，直通正殿。远远便射出道道金
光，其势可与中原五台、普陀、九华、峨嵋诸处佛门胜地的名山大寺媲美，只是
僻处南疆，其名不显而已。 
LONG
        );
	set("outdoors", "tianlongsi");
	set("exits", ([
            "south" : __DIR__"square",
	    "north" : __DIR__"baodian",
	]));
	setup();
}
