// kurong.c 枯荣 writen by tea 9.20.98

inherit NPC;

void create()
{
    set_name( "枯荣" , ({ "ku rong", "ku", "rong" }) );
    set("gender", "男性" );
    set("age", 90 );
    set("long", @LONG
枯荣长老在天龙寺中辈份最高，面壁已数十年，天龙寺诸僧众，谁也没见过他
真面目。你一看之下，笑容登时僵住，原来眼前所出现的那张面容奇特之极，
左边的一半脸色红润，皮光肉滑，有如婴儿，右边的一半却如枯骨，除了一张
焦黄的面皮之外全无肌肉，骨头突了出来，宛然便是半个骷髅骨头。
LONG    );
    
    set("force", 4000); 
    set("max_force", 4000); 
    set("force_factor", 250);

    set_wugong("duanjia-shenfa" , 200, 200, 1);
    set_wugong("duanshi-xinfa"  , 200, 200, 1);
    set_wugong("yiyang-zhi"     , 160, 160, 1);
    set_xiuwei_by_type("dodge"  , 4300);
    set_xiuwei_by_type("unarmed", 5301);
    set("combat_exp", 12000000);
    set("social_exp", 90000);
    set("max_kee",3000);
    set("title","天龙寺神僧");

    setup();

    carry_object( __DIR__"obj/cloth4")->wear();
}

int refuse_killing()
{
	set_wugong("liumai-shenjian",  75,  75, 1);
	add("force_factor",100);
	command("sigh");
	command("say 没想到面壁十几年，竟出了如此人物。");
	return 0;
}
