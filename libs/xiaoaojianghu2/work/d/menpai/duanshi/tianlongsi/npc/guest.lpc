// guest.c 进香客 cry

inherit NPC;

void create()
{
    set_name( "进香客" , ({ "guest" }) );
    set("gender", "男性" );
    set("age", 24+random(10) );
    set("long", @LONG
天龙寺是远近闻名的大寺院，每天都有很多慕名而来的进香客。
LONG    );
    
    set("force", 1000); 
    set("max_force", 1000); 
    set("force_factor", 100);

    set_wugong("dodge"          , 120, 120, 1);
    set_wugong("unarmed"        , 120, 120, 1);
    set_wugong("haoran-zhengqi" , 100, 100, 1);
    set_xiuwei_by_type("dodge"  , 1000);
    set_xiuwei_by_type("unarmed", 1000);
    set("combat_exp", 30000);
    set("social_exp", 10000);

    setup();

    carry_object( CLOTH_DIR "zhifeng_kuanshan")->wear();
    carry_object( BOOTS_DIR "sifeng_huangxue" )->wear();
    carry_object( HEAD_DIR "sanshan_mao"      )->wear();
}