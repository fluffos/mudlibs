#include <ansi.h>

inherit NPC;

void create()
{
    set_name( "讼经老僧" , ({ "lao seng", "seng", "monk" }) );
    set("gender", "男性" );
    set("age", 70 );
    set("long", @LONG
他是一个每天在三元宫讼经的老僧，佛法高深，已点化无数来此敬香的人。
LONG    );
    
    set("force", 2000); 
    set("max_force", 2000); 
    set("force_factor", 200);

/*
    set_wugong("enigma"		, 150, 150, 0);
*/
    set_wugong("duanjia-shenfa" , 120, 120, 1);
    set_wugong("duanshi-xinfa"  , 120, 120, 1);
    set_wugong("yiyang-zhi"     ,  80,  80, 1);
    set_xiuwei_by_type("dodge"  , 2600);
    set_xiuwei_by_type("unarmed", 2600);
    set("combat_exp", 9000000);
    set("social_exp", 60000);
    set("title","天龙寺");

    setup();

    carry_object( __DIR__"obj/cloth4")->wear();
}

void init()
{
	add_action("do_kill","kill");
}


int do_kill(string arg)
{
	object obj,me=this_player();

	if ( objectp(obj = present(arg, environment(me))) )
	if ( obj->is_character() && !obj->is_corpse() )
	if ( obj != this_object() ){
	    obj=this_object();
	    command("say 此乃佛门圣地，施主应好自为之！");
	    me->bihua_ob(obj);
	    obj->bihua_ob(me);
	    return 1;
	}
	return 0;
}

int accept_fight( object me )
{
	command("say 看施主心浮气燥，应多讼经文，以求修心养性。");
	return 0;
}
