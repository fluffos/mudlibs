// benguan.c 本观 writen by tea 9.20.98

inherit NPC;

void create()
{
    set_name( "本观" , ({ "ben guan", "guan" }) );
    set("gender", "男性" );
    set("age", 73 );
    set("long", @LONG
这枯黄精瘦的僧人法名本观，是本因方丈的师兄，仍天龙寺牟尼堂的一位高僧。
LONG    );
    
    set("force", 3000); 
    set("max_force", 3000); 
    set("force_factor", 200);

    set_wugong("duanjia-shenfa" , 150, 150, 1);
    set_wugong("duanshi-xinfa"  , 145, 145, 1);
    set_wugong("yiyang-zhi"     , 130, 130, 1);
    set_xiuwei_by_type("dodge"  , 4000);
    set_xiuwei_by_type("unarmed", 4400);
    set("combat_exp", 20000000);
    set("social_exp", 70000);
    set("max_kee",2000);
    set("title","天龙寺神僧");

    setup();

    carry_object( __DIR__"obj/cloth4")->wear();
}

int refuse_killing()
{
	set_wugong("liumai-shenjian",  60,  60, 1);
	add("force_factor",100);
	command("say 施主仍然如此无礼，就休怪老僧了。");
	return 0;
}
