// xiaoshami.c 小沙弥 cry

inherit NPC;

void create()
{
    set_name( "小沙弥" , ({ "xiao shami", "shami" }) );
    set("gender", "男性" );
    set("age", 12+random(6) );
    set("long", @LONG
一个小沙弥，每天负责接送普通的香客，并为老和尚们担水做饭。
LONG    );
    
    set("force", 200); 
    set("max_force", 200); 
    set("force_factor", 20);

    set_wugong("dodge"          , 100, 100, 1);
    set_wugong("unarmed"        , 100, 100, 1);
    set_wugong("duanshi-neigong", 100, 100, 1);
    set_xiuwei_by_type("dodge"  , 200);
    set_xiuwei_by_type("unarmed", 200);
    set("combat_exp", 6000);
    set("social_exp", 6000);
    set("title","天龙寺");

    setup();

    carry_object( __DIR__"obj/cloth1")->wear();
}

void welcome_visitor()
{
	object me=this_player();

	tell_object(me,"小沙弥对着你说：这位"+RANK_D->query_respect(me)
+"是来敬香还是来还愿呀？\n");
}
