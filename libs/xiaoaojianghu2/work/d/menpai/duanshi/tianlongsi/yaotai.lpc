#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", MAG"清都瑶台"NOR);
        set("long",@LONG
周围团花簇锦，百尺传芳，未入其门，却先得其香，恐怕连皇宫内院也没有
如此美景。花草之中一碧水清池，微波荡漾，令你魂魄已飞出九宵云外。置身于
此，夫复何求？
LONG
        );
	set("outdoors","tianlongsi");
        set("exits", ([
	    "east": __DIR__"huangtian", 
	    "enter": __DIR__"pool", 
	]));
        setup();
}

int valid_leave(object me, string dir)
{
	int i;
	object obj,ob=this_object(),*all;

	if(objectp(obj=find_object(__DIR__"pool"))){
	    all=all_inventory(obj);
	    if(sizeof(all))
		return notify_fail("一股奇异的花香将你挡了出来。\n");
	}
	all=all_inventory(me);
	if(dir=="enter")
	{
	    if(me->query("gender")=="女性")
		message_vision("$N除去身上所有的杂物，缓步走入水池！\n",me);
	    else
		message_vision("$N除去身上所有的杂物，一下跳入水池！\n",me);
	    for(i=0;i<sizeof(all);i++)
		all[i]->move(ob);
	}
	return 1;
}