// linggui.c cry
inherit ROOM;

void create()
{
        set("short", "灵龟门");
        set("long",@LONG
这是通往天龙寺休息之处的门户。泛出金辉的门楼上豁然趴着一只玉龟。低
头再看铜门槛早已被踩踏得锃亮，可知人们经常从这里进进出出。抬头向南还可
望见点苍山耸立云天。
LONG
        );
	set("outdoors","tianlongsi");
        set("exits", ([
	    "west": __DIR__"square",
	    "north": __DIR__"luodi",
	]));
        setup();
}
