// wule.c cry
inherit ROOM;

void create()
{
        set("short", "无乐阁");
        set("long",@LONG
这是历代大理王爷前来进香还愿时休息的地方。阁内檀象宝炉，软榻矮几，
虽然不是鲜艳务必，豪华奢侈，却也一应俱全。阁中非常清静，然而也隐然透出
一丝富贵之象。
LONG
        );
        set("exits", ([
	    "west" : __DIR__"lang3",
	]));
	set("objects",([
                __DIR__"npc/shami" : 1,
        ]));
        setup();
}
