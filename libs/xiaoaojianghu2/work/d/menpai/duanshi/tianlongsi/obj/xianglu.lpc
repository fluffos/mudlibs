// xianglu.c writen by cry 9.18.98

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "香炉" NOR, ({ "xiang lu", "lu" }));
  set_weight(150000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个寺里常见的香炉，里面有许多支香，炉烟四处弥漫。\n");
    set("value", 100);
    set("material", "copper");
  }
  setup();
}

void init() {
  add_action("do_put", "put");
}

int do_put(string arg) {
  string str1, str2;
  object me = this_player(), ob = this_object(), obj1, obj2;
  int ra;

  if (!arg || sscanf(arg, "%s in %s", str1, str2) != 2)
    return 0;
  if (!objectp(obj1 = present(str1, me)))
    return 0;
  if (ob != (obj2 = present(str2, environment(ob))))
    return 0;
  if (base_name(obj1) != __DIR__ "xiang"
    || !obj1->is_burning())
    return 0;  //added by adame. 不然什么东东都可以往香炉里放了.
    ra = 32 - me->query_kar();
  if (ra < 2) ra = 2;
  obj1->set("no_get", 1);
  if (me->query_temp("cry/jianpu") == 3 && !random(ra)) {
    ob = new(__DIR__ "liumai-jianpu");
    ob->move(me);
    ob->set("cant_move", 1);
    tell_object(me, "你忽然觉得香在插下时被什么挡住了！"
      + "你扒开香灰，发现了一个本书。\n");
    return 1;
  }
  obj1->move(obj2);
  message_vision("$N把一柱香插进香炉，拜了两拜。\n", me);
  return 1;
}
