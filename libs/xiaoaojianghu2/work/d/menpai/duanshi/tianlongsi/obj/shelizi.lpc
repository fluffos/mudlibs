// shilizi.c cry

#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(HIW"舍利子"NOR, ({ "she li zi" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("long", "这是一枚珍贵的舍利子。\n");
		set("value", 10000);
		set("cant_sell","这么珍贵的舍利子，小的可不敢冒犯！\n");
		set("material", "bone");
	}
	setup();
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object me=this_player(),ob=this_object();

	if(!arg || arg!=ob->query("id")) return 0;
	message_vision("$N张开大嘴巴，“咕咚”一声把舍利子吞了下去。\n",me);
	if( random(200)==100 )
	    me->add("cor",1);
	destruct(ob);
	return 1;
}