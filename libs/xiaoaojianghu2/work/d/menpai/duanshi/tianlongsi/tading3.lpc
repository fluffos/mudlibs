// tading3.c cry

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "塔顶");
        set("long",@LONG
这是天龙寺塔塔顶，室中空无一物，只有地上画着一个银色的六角星。四面
是严丝合缝的砖墙，没有一扇窗户，只有几座古灯发出昏暗的光照亮着室内。一
个老年僧人正坐在一个蒲团上打坐修炼。
LONG
        );
	set("not_startroom",1);
        set("exits", ([
	    "down" : __DIR__"ta3",
        ]));
	set("objects",([
	    __DIR__"npc/taseng3" : 1,
	]) );
        set("detail",([
	    "六角星" : "这是一个银白色的六角星，你仔细一看，旁边写着"
+"一行小字："+YEL"通往天涯海角，梦的尽头！\n"NOR,
        ]));	
	setup();
}

void init()
{
	add_action("do_fly","fly");
}

int do_fly(string arg)
{
	object me=this_player();
	int i;
    int hehe;
    hehe=random(10)+5;
    for(i=0;i<hehe;i++)
	    tell_object(me,"你突然感觉被一团轻烟包围，身子情不自禁地飘了起来......\n");
    tell_object(me,"过了好一会儿，你才觉得脚踏实地了！\n");
    return 1;
}
