// yuhua.c cry
inherit ROOM;

void create()
{
        set("short", "雨花院");
        set("long",@LONG
相传当年佛祖降临天龙寺传法时，此院中遍地碎石瞬间化为五彩斑斓的雨花
石。后人甚为奇之，乃将此院命名为雨花院。院中常年檀香四溢，清净幽雅，踱
步其中，令人心旷神怡。
LONG
        );
	set("outdoors","tianlongsi");
        set("exits", ([
	    "east" : __DIR__"doushuai",
	    "north" : __DIR__"banruo",
	]));
        setup();
}
