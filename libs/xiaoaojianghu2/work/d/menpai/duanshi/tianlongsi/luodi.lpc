// luodi.c cry
inherit ROOM;

void create()
{
        set("short", "罗地门");
        set("long",@LONG
向北望去可见后寺中亭台楼阁规模宏大，构筑精丽，加之金砖玉瓦，碧光掩
映天空好不气派。罗地门的东面是慈悲院，可听到阵阵诵经之声，不绝于耳，虽
然不是甚懂，但心中不禁有一丝佛意。
LONG
        );
	set("outdoors","tianlongsi");
        set("exits", ([
	    "south": __DIR__"linggui",
	    "north": __DIR__"youyou",
	    "east": __DIR__"cibei",
	]));
        setup();
}
