// ta2.c cry
inherit ROOM;

void create()
{
        set("short", "天龙寺塔");
        set("long",@LONG
这是天龙三塔之一，建于唐初。这是天龙三塔中第二高的一座，高约二百尺，
共有十二级。传说每年的某个月圆之夜，在此塔上默许心愿，塔顶便会出现圣光，
助你达成心愿。
LONG
        );
        set("outdoors", "tianlongsi");
        set("exits", ([
	    "east" : __DIR__"talin",
	    "up" : __DIR__"tading2",
        ]));
	set("objects",([
	    __DIR__"npc/taseng" : 1,
        ]));
        setup();
}

#include "ta.h"