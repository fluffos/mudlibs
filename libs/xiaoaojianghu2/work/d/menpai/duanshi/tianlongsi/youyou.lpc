// youyou.c cry
inherit ROOM;

void create()
{
        set("short", "有有界");
        set("long",@LONG
一片水池静卧眼前，一座精雕木桥横跨其上，倒影映在碧绿的水面之中，与
其恰成一圆。水中鱼虾游动，荷花盛开，微风轻拂，使你心中似有所动。仿佛体
会到了众生之源，万物之本的真谛。
LONG
        );
	set("outdoors","tianlongsi");
        set("exits", ([
	    "east": __DIR__"zhaitang",
	    "west": __DIR__"sanyuan",
	    "south": __DIR__"luodi",
	    "north": __DIR__"lang2",
	]));
        setup();
}
