// muni.c cry

#include <room.h>
inherit DOOR_ROOM;

void create() {
  set("short", "牟尼堂");
  set("long", @LONG
这是高僧们的静修之处。你伸手缓缓推门，板门吱吱咯咯的作响，显是平时
极少有人启闭。室中有四个和尚分坐四个蒲团。三僧面外，其中二僧容色枯槁，
另一个半大魁梧。东首的一个和尚脸朝里壁，一动不动。 
LONG
  );
  set("exits", ([
    "east": __DIR__ "muni_men",
  ]));
  set("objects", ([
    __DIR__ "npc/kurong": 1,
    __DIR__ "npc/bencan": 1,
    __DIR__ "npc/benguan": 1,
    __DIR__ "npc/benxiang": 1,
  ]));
  create_door("east", "小木门", "west", DOOR_CLOSED);
  setup();
}
