// mishi.c cry

inherit ROOM;

void create()
{
	set("short", "密道");
	set("long",@LONG
四周一片漆黑，不知道是什么地方，地下软软的好像有一个蒲团。
LONG
	);
        set("search_things", ([
		"蒲团" : __DIR__"obj/letter",
	]));
	setup();
}

void init()
{
	add_action("do_open","open");
}

int do_open(string arg)
{
	object obj,me=this_player(),ob=this_object();

	if ( !arg || arg!="字画" && arg!="picture" ) return 0;
	if ( ob->query("exits/east") )
		return notify_fail("字画已经被揭开了。\n");
	if ( objectp(obj=find_object(__DIR__"cibei")) )
		tell_room(obj,"墙上的一张字画悄悄的移开了。\n");
	else
		obj=load_object(__DIR__"cibei");
	message_vision("$N用手推开字画，露出了出口！\n",me);
	set("exits/west",__DIR__"cibei");
	obj->set("exits/east",__DIR__"mishi");
	call_out("close_exit", 2, ob, obj);
	return 1;
}

void close_exit(object ob,object obj)
{
	tell_room(ob,"字画荡了回来，挡住了出口。\n");
	tell_room(obj,"字画荡了回来，挡住了密道。\n");
	delete("exits/west");
	obj->delete("exits/east");
}