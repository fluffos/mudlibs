// changed by tea 2.8.99

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", CYN"碧水清池"NOR);
        set("long",@LONG
你全身浸在碧水之中，只觉清爽异常，微波荡漾如腾云驾雾一般，四周溢满
芳香，波光粼粼，恍惚间如置身仙境，不禁脸上露出十分陶醉的样子，心中荡起
无限遐想！
LONG
        );
        set("exits", ([
	    "out": __DIR__"yaotai", 
	]));
        setup();
}

void init()
{
	object me=this_player();

	remove_call_out("do_wash");
	call_out("do_wash",20,me);
}

void do_wash(object me)
{
	if( environment(me) != this_object() )
	    return ;
	tell_object(me, "你的身上无一不爽洁清新了！\n");
}
