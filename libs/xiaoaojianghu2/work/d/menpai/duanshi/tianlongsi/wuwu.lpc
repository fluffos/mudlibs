// wuwu.c cry
inherit ROOM;

void create()
{
        set("short", "无无境");
        set("long",@LONG
一片天然的水池静卧眼前，一座未经雕琢木桥横跨其上，映着空灵的水面，
水中除了些杂草，并无一物。使你心中似有所动。仿佛体会到了众生之源，万物
之本的真谛。
LONG
        );
	set("outdoors","tianlongsi");
        set("exits", ([
	    "east": __DIR__"sanyuan",
	    "south": __DIR__"huangtian",
	    "north": __DIR__"doushuai",
	]));
        setup();
}
