#include <room.h>
#include <ansi.h>


inherit DOOR_ROOM;

void create()
{
        set("short", "王府西院");
        set("long", @LONG
这里是王府的西院，也就是镇南王妃的居所。雅致的小院里当中有一处小小
的葡萄架，旁边开满艳丽的茶花。院子里一遛高大的北房是王妃的卧室。右面是
王妃弹琴消闲的琴房。左面是王妃平时刺绣的绣房。然而前一段时间王爷和王妃
发生了些别扭，王妃一气之下出走。这件事王府的下人们几乎都知道，但是没有
人敢公然地说出来。
LONG
        );
    set("exits", ([ 
                "north"  : __DIR__"woshi2",
                        "east"   : __DIR__"qinfang",
                        "west"   : __DIR__"xiufang",
                "south"  : __DIR__"yueliang_men2",
        ]));
        set("objects", ([
                        __DIR__"npc/shinv"       : 2,
                        __DIR__"npc/weishi1"     : 4,
                ]));
        set("outdoors", "dali");
        create_door("north",([
                        "name"   : "雕花朱漆门",
                        "lock"   : "段_lock005",
                        "status" : 3,
                        "id"     : ({ "north","door"}),
                        "other_side_dir": "south",
                        ]),
                        "south");
        create_door("east",([
                        "name"   : "琴房门",
                        "lock"   : "段_lock006",
                        "status" : 3,
                        "id"     : ({ "east","door"}),
                        "other_side_dir": "west",
                        ]),
                        "south");
        create_door("west",([
                        "name"   : "绣房门",
                        "lock"   : "段_lock007",
                        "status" : 3,
                        "id"     : ({ "west","door"}),
                        "other_side_dir": "east",
                        ]),
                        "south");
        setup();
}                       

int valid_leave(object me, string dir)
{
      object ob;

        if (dir!="south" 
                && ( ob=present("shi nv") || ob=present("wei shi") )
                && ( ob->can_act() ) )
        {
                message_vision("$N施礼道：“这位"+RANK_D->query_respect(me)+
                "，王妃不在府内，任何人不经允许不得擅入！”\n", ob, me);
                return notify_fail("");
        }
        return ::valid_leave(me, dir);
}
