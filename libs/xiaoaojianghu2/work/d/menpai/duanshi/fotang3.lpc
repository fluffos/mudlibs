#include <room.h>
#include <ansi.h>

inherit ROOM;

string *things = ({
  CLONE_DIR + "eat/fruit/guiyuan",
  CLONE_DIR + "eat/fruit/mangguo",
  CLONE_DIR + "eat/fruit/lizhi",
  CLONE_DIR + "eat/fruit/yangmei",
});

void create() {
  set("short", YEL "佛堂" NOR);
  set("long", @LONG
这是王妃的小佛堂，平素任何人不得随便入内。大理是个佛教国家，上至皇
帝下至黎庶，人人信奉佛教。这座佛堂里供着观音大士，菩萨白衣飘飘，手拿杨
柳净瓶，柔和地注视着每一个进来的人。佛前摆放着四色供果，屋里的香炉点着
檀香，四周挂着杏黄色的幔帐。
LONG
  );
  set("exits", ([
    "south": __DIR__ "zoulang30",
  ]));
  set("objects", ([
  ]));
  set("search_things", ([
    "供果": things[random(sizeof(things))],
  ]));
  setup();
  //place_program(ROOM);
}
