#include <room.h>
inherit ROOM;



void create()
{
    set("short", "菜园");
    set("long", @LONG
你来到了一个不小的菜园，西宗弟子吃的蔬菜基本由这里提供。园子里的菜地分
成了好几畦，分别种着白菜，萝卜，韭菜，边上有几个小棚子，养了一些鸡鸭。一些
女弟子在田间做些农活，另一些弟子在喂鸡喂鸭，大家说说笑笑，园子里好不热闹。
西北角上有扇小竹门，中间有口井。
LONG
    );
    set("no_clean_up", 0);
    set("exits", ([ /* sizeof() ==  */
        "west" : __DIR__"chufang",
        "northwest"  : __DIR__"huayuan",
]));
    set( "no_kill", "west_liang" );
    set("fillplace", "井");
    set("resource/water", 1);
    set("objects" , ([ /* sizeof() == 1 */
        __DIR__"npc/xing" : 1,
    ]));
    
//     create_door("northwest", "小竹门", "southeast", DOOR_CLOSED);
    setup();
}

void init()
{
   add_action("do_work", ({"work", "ganhuo"}));
}

int do_work()
{
    object ob, me;
    
    me = this_player();
    if ( me->query_temp("worked") )
    {
        tell_object(me,"你已经干过活了，就不劳烦了。\n");
        return 1;
    }
    if ( me->query( "kee" ) < 10 || me->query( "sen" ) < 30 )
        return notify_fail( "你太累，先去睡觉吧。\n" );
    if ( objectp( ob = present( "xing laotou", (environment(me)) ) ) &&
        ob->can_act() )
    {
        message_vision("$N辛苦的工作终于结束了，可人也累的要死\n", me);
        me->add("kee",-10);
        me->add("sen",-30);
        ob = new( MONEY_DIR "coin");
        ob->set_amount( 300 );
        ob->move(me);
        me->set_temp("worked",1);
        message_vision("邢老头对$N说：这是你的工钱。\n", me);
        return 1;
    }
    return notify_fail("你想帮谁干活啊？\n");
}


