//Npc: /d/menpai/wuliang/west/npc/xin_shuangqing.c 辛双清
//copied from zuo_zimu.c modified by trill
//Changed by lala 1997/09/08

#define NEITING "/d/menpai/wuliang/west/neiting"
#define KETING  "/d/menpai/wuliang/west/keting"

#include <ansi.h>

string ask_jianhugong();

string change_master(object);
string master_name(object);
string about_yubi(object me);
string leave_west(object);
void get_sword(object);

inherit NPC;
inherit F_MASTER;

inherit "/system/std/char/marry_npc.lpc";

#include "west.h"
#include "west_master.h"



void create() {
  set_name("辛双清", ({ "xin shuangqing", "xin", "shifu", "master", }));
  set("class", "swordsman");
  set("gender", "女性");
  set("age", 46);
  set("str", 22);
  set("cor", 30);
  set("cps", 30);
  set("int", 28);
  set("ker", 28);
  set("kar", 30);
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 30);
  set("no_kill", "west_wuliang");
  set("positive_score", 10000);
  set("using_force", "haoran-zhengqi");

  set("rank_info/respect", "辛道长");
  set("class", "swordsman");
  set("long", @LONG
她是一位中年道姑，脸色严峻，嘴唇紧闭，不苟言笑。一付心事重重的样子。
不过脸上却没有一丝皱纹，头上没有一丝白发，可能是内功精湛，驻颜有术。
LONG
  );

  create_family("无量剑派西宗", 5, "掌门人");

  set("combat_exp", 400000);
  set("social_exp", 20000);

  set_wugong("lingxiao-shou", 100, 100, 1);
  set_wugong("nanshan-liushi", 100, 100, 0);
  set_wugong("jiben-qinggong", 100, 100, 0);

  set_wugong("literate", 50, 50, 0);

  set_wugong("wuliang-shenfa", 100, 100, 0);
  set_wugong("yanxing", 100, 100, 1);

  set_wugong("haoran-zhengqi", 100, 100, 1);

  set_wugong("wuliang-jian", 100, 100, 0);
  set_wugong("liuyun-jian", 120, 100, 1);

  set_xiuwei_by_type("sword", 1300);
  set_xiuwei_by_type("unarmed", 1100);
  set_xiuwei_by_type("dodge", 1100);
  set_xiuwei_by_type("zonggang", 500);

  set("inquiry", ([
    //                "剑湖宫" : (: ask_jianhugong :),
    "此地": "这里便是无量剑派西宗。",
    "姓名": "嗯，你既知我姓辛，怎会不知在下便是无量西宗掌门人辛双清？,
        " 指 点 武 功 " : (: change_master :),
        " 结 婚 " : (: ask_about_marry :),
        " 玉 壁 " : (: about_yubi :),
        " 出 师 " : (: leave_west :),
        ]) );

    setup();
    carry_object(__DIR__" obj / sword ")->wield();
    carry_object(__DIR__" obj / daopao ")->wear();
}

void init()
{
    object this, env, me;

    ::init();
    add_action(" do_kneel ", ({ " kneel ", " ketou " }) );
        add_action(" give_quest "," quest ");
    this = this_object();
    env = environment( this );
    if(!objectp(env))  return;
    me = this_player();
    if ( me->query_condition( " kill_west_wuliang " ) &&
         me->query(" family / family_name ") != " 无 量 剑 派 西 宗 "  )
    {
        message_vision(" 辛 双 清 对 $N 大 喝 ： 大 胆 狂 徒 ， 以 为 无 量 山 是 你 随 便 杀 人 放 火 的 地 方 吗 ？ \ n 视 我 们 西 宗 为 无 物 吗 ？ \ n ", me );
        set(" force_factor ", 150);
        set(" env / attack ", 80);
        me->set_temp(" no_leave_west ", 1);
        command( " kill " + me->query( " id " ) );
        return ;
    }
    if (( env->query( " short " ) == " 内 厅 " ) &&
        ( this->query_temp( " bai_xin " ) == me->query( " id " ) ))
    {
        remove_call_out( " tell_mengui " );
        call_out( " tell_mengui ", 1, me );
    }
}

int attempt_apprentice(object me)
{
    object this, env;
    string my_id;

    my_id = me->query( " id " );
    this = this_object();
    env = environment( this );
    
    if( me->query(" hydra / 出 师 / 无 量 剑 派 西 宗 ") )
    {
        message_vision(CYN" $N 对 $n 说 道 ： “ 你 既 已 离 开 师 门 ， 怎 么 又 回 来 "
" 了 呢 ？ ” \ n "NOR,this,me);
        return 0;
    }
        
    if ( env->query(" short ") == " 客 厅 " )
    {
        message_vision(" 辛 双 清 向 西 一 指 ， 对 $N 说 ： 你 先 去 内 厅 等 我 。 \ n ", me);
    }
    if ( this->query_temp( " bai_list / " + my_id ) )
    {
        command( " heng " + my_id );
        message_vision(" 辛 双 清 冷 冷 地 对 $N 说 ： 你 品 性 不 正 ， 不 配 入 我 门 。 \ n ", me);
        return 1;
    }
    command( " nod " + my_id );
    this->set_temp( " bai_xin ", my_id );
    this->set_temp( " bai_list / " + my_id, 1 );
    call_out( " back_dating ", 100 );
    message_vision(" 辛 双 清 对 $N 说 ： 既 然 这 样 ， 先 拜 过 祖 师 爷 。 \ n ", me);
        message_vision(" 辛 双 清 往 西 离 去 。 \ n ", me);
        move(NEITING);
        return 1;
}

void back_dating()
{
    if ( environment( this_object() )->query(" short ") == " 内 厅 " )
                move(KETING);    
}

void tell_mengui( object me )
{
    message_vision(YEL@MSG
辛双清对$N说: 既然入我门下，第一便是要恪守本派门规。你听好了，我无量剑派

        首戒欺师灭祖，不敬尊长；  二戒同门操戈，兄弟不和。
        三戒心猿意马，不用心练功；四戒恃强凌弱，擅伤无辜。
        五戒奸淫好色，调戏妇女；  六戒口出妄言，行事不正。
        
这些门规，你要记牢了，如有违反，我定严惩不殆！！
好了，给祖师爷磕头吧！
MSG NOR, me);
    me->set_temp( " bai_xin ", 1 );
}

int do_kneel(string arg)
{
    object sword, me, this;
    mapping family;

    me = this_player();
    this = this_object();
    if ( environment( this )->query(" short ") != " 内 厅 " )
    {
        tell_object( me, " 你 打 算 给 谁 磕 头 啊 ？ \ n " ); 
        return 1;
    }
    if ( me->query_temp( " bai_xin " ) )
    {
        message_vision(" $N 对 着 墙 上 挂 着 的 祖 师 像 拜 了 八 拜 ， 站 起 身 来 。 \ n ", me);
        message_vision(" 辛 双 清 高 兴 对 $N 笑 了 笑 ， 说 ： 很 好 很 好 。 \ n ", me);
        message_vision(" $n 决 定 收 $N 为 弟 子 。 \ n \ n "
                " $N 跪 了 下 来 向 $n 恭 恭 敬 敬 地 磕 了 四 个 响 头 ， 叫 道 ： 「 师 父 ！ 」 \ n ",
                me, this);
        recruit_apprentice( me );
        me->set( " no_kill ", " west_wuliang " );
        family = me->query(" family ");
        tell_object( me,
            sprintf(" 恭 喜 您 成 为 % s 的 第 % s 代 弟 子 。 \ n ", family[" family_name "],
            chinese_number(family[" generation "]) ));
        me->set(" class "," swordsman ");
        sword = new(__DIR__" obj / peijian ");
        sword->move( me );
        sword->set(" long "," 一 把 无 量 剑 派 本 门 使 用 的 长 剑 ， 剑 上 刻 着 " + HIY " 无 量 剑 " +
            me->query(" name ") + NOR" \ n ");
        me->delete_temp( " bai_xin " );
        this->delete_temp( " bai_xin " );
        this->delete_temp( " bai_list / " + me->query(" id ") );
        message_vision(" 辛 掌 门 将 一 把 刻 着 $N 名 字 的 长 剑 交 给 了 $N ， 说 ： 这 把 剑 就 归 你 "
                   " 随 身 携 带 使 用 。 \ n 记 住 ， 剑 在 人 在 ， 剑 亡 人 亡 ！ \ n ", me);
        command( " go south " );
        command( " go south " );
        command( " go east " );
        return 1;
    }
    return 0; 
}

int recruit_apprentice(object me)
{
    ::recruit_apprentice(me);
    me->set(" master "," zhu guangquan ");
    message_vision(" 辛 双 清 对 $N 说 ： 你 现 在 先 去 跟 褚 师 兄 学 点 本 门 的 基 本 功 夫 吧 。 \ n ", me);
    return 1;
}

string change_master(object who)
{
      string msg;
    object me;

    me = this_player(); 
    if ( me->query( " marks / 悟 剑 居 " ) )
        return " 你 的 武 功 已 经 不 低 于 师 父 我 了 。 \ n ";
    if ( me->query(" family / family_name ") != " 无 量 剑 派 西 宗 " )
        return " 这 位 " + RANK_D->query_respect(me) + " 说 笑 了, 贫 道 无 德 无 能, 何 言 指 点.\ n ";
    if ( !me->query(" master ") )
        {
        me->set( " master ", " zhu guangquan " );
                msg = " 从 今 天 起 ， 你 就 去 跟 褚 光 泉 师 兄 学 习 本 门 基 本 武 功 吧 。 \ n ";
        }
    else if ( me->query_temp(" defeat_master ")!=me->query(" master ") )
    {
        if ( !me->query_temp(" fight_master ") )
        {
            me->set_temp(" fight_master ", me->query(" master "));
            msg = sprintf( " 辛 双 清 沉 思 了 一 会 ... \ n 好 ， 你 跟 % s 比 试 一 下 ， 再 做 决 定 吧 。 \ n ",
                master_name(me) );
        }
        else
        {
            printf( " 辛 双 清 有 些 不 高 兴 ， 皱 了 皱 眉 头 。 \ n " );
            msg = sprintf( " 好 高 骛 远 ， 是 学 不 好 功 夫 的 ， 你 还 是 先 跟 % s 多 学 点 东 西 再 说 。 \ n ",
                master_name(me));
            me->add(" class_score / 无 量 剑 派 西 宗 ", -1);
        }
    }
        else
        {
        me->delete_temp(" defeat_master ");
        me->delete_temp(" fight_master ");
        switch ( me->query(" master ") )
                {
                case " zhu guangquan ":
                me->set( " master ", " ge guangpei " );
                msg = " 好 ， 你 现 在 可 以 去 跟 葛 光 佩 师 姐 学 习 了 。 \ n ";
                break;

            case " ge guangpei ":
                me->set( " master ", " lin shuangxiu " );
                msg = " 嗯 ， 不 错 ， 现 在 就 让 你 林 师 叔 来 指 导 你 吧 。 \ n ";
                break;
        
            case " lin shuangxiu ":
                me->set( " master ", " xin shuangqing " );
                msg = " 好 徒 儿 ， 从 今 天 开 始 ， 为 师 亲 自 指 点 于 你 ！ \ n ";
                break;

            case " xin shuangqing ":
                me->set( " marks / 悟 剑 居 ", 1 );
                msg = " 你 武 功 已 至 如 此 境 界 ， 看 来 足 以 领 悟 悟 剑 居 中 本 派 的 武 学 精 华 。 \ n ";
                break;
                }
        }
    return msg;
}

string master_name( object me )
{
    string master_id;
    master_id = me->query(" master ");
    switch ( master_id )
    {
        case " zhu guangquan " : return " 你 褚 师 兄 ";
        case " ge guangpei " : return " 你 葛 师 姐 ";
        case " lin shuangxiu " : return " 你 林 师 叔 ";
        case " xin shuangqing " : return " 为 师 我 ";
        default : error( " master_name " );
    }
}

//lnwm:here is for 四川的无名老人

string about_yubi( object me )
{
        string msg;
        
        me = this_player();

        if ( me->query(" family / family_name ") != " 无 量 剑 派 西 宗 " )
        {
                message_vision(CYN" \ n 辛 双 清 冷 冷 地 看 了 $P 一 眼 ： 这 是 我 无 量 的 地 方 ， 关 你 什 么 事 ？ ！ \ n "NOR, me );
                msg = " 以 后 请 不 要 再 问 这 个 问 题 。 ";
                return msg;
        }
        
        if ( me->query(" lnwm / maowu / 问 左 子 穆 ") == 1 )
        {
                if ( me->query(" class_score / 无 量 剑 派 西 宗 ") >= 500 )
                {
                        if ( !random(20) )
                        {
                                tell_object( me, CYN" \ n 辛 双 清 稍 稍 犹 豫 了 一 下 ： 你 最 好 不 要 再 问 这 个 问 题 。 \ n "NOR);
                                tell_object( me, CYN" 辛 双 清 深 深 地 看 了 你 一 眼 ： 当 年 你 的 一 位 师 叔 就 是 在 参 看 玉 壁 的 秘 密 后 突 然 失 踪 的 。 \ n "NOR);
                                me->delete(" lnwm / maowu / 问 左 子 穆 ");
                                me->set(" lnwm / maowu / 师 叔 " , 1 );
                                msg = " 玉 壁 是 我 无 量 的 秘 密 ， 你 现 在 还 是 不 知 道 的 好 些 ， 去 吧 。 \ n ";
                                return msg;                             
                        }               
                        else
                        {
                                msg = " 玉 壁 是 我 无 量 的 秘 密 ， 你 现 在 还 是 不 知 道 的 好 些 ， 去 吧 。 \ n ";
                                return msg;                                     
                        }       
                }
                else
                {
                        tell_object( me, CYN" \ n 辛 双 清 略 微 有 些 不 快 ： 你 问 这 个 问 题 做 什 么 ？ \ n "NOR);
                        msg = " 你 还 是 想 想 如 何 为 师 门 多 做 些 贡 献 吧 。 ";
                        return msg;
                }       
        }       
        else
        {
                tell_object( me , CYN" \ n 辛 双 清 一 脸 茫 然 。 \ n "NOR);
                msg = " 你 怎 么 想 起 来 问 这 个 问 题 呢 ？ ";     
                return msg;
        }
}

string ask_jianhugong()
{
    return " 这 个 你 现 在 还 不 到 知 道 的 时 候 。 \ n ";
}

//Hydra:add for 出师 19980507
string leave_west( object me )
{
    object this;
    me = this_player();
    this = this_object();

    if( me->query(" hydra / 出 师 / 无 量 剑 派 西 宗 "))
    {
        return " 你 不 是 已 经 出 师 了 吗 ？ ";
    }
    if( me->query(" family / family_name ") != " 无 量 剑 派 西 宗 " )
    {
        command( " ? "+me->query(" id ") );
        return " 你 又 不 是 我 无 量 西 宗 之 人 ， 何 来 出 师 之 说 。 ";
    }

    if( me->query( " class_score / 无 量 剑 派 西 宗 " ) < 1000 )
    {
        message_vision(CYN" $N 对 $n 道 ： “ 你 在 我 门 下 多 年 ， 却 不 尽 心 为 师 门 "
" 效 力 ， 怎 么 就 想 离 开 了 呢 ？ ” \ n "NOR,this,me );
        if(me ->query(" class_score / 无 量 剑 派 西 宗 ")>10)
            me -> add( " class_score / 无 量 剑 派 西 宗 ",-10);
        return " 你 还 是 先 为 光 大 师 门 多 干 点 事 吧 ！ \ n ";
    }

        if( me->query_jibie(" liuyun - jian ") > 90 )
    {
        if(!me->query(" marks / 悟 剑 居 ") )
        {
            if(me ->query(" class_score / 无 量 剑 派 西 宗 ")>10)
                me -> add( " class_score / 无 量 剑 派 西 宗 ",-10);
            return " 你 功 夫 未 成 ， 还 是 在 我 手 下 多 学 几 年 吧 。 \ n ";
        }
        else if( me->query(" age ") < 20 )
        {
            message_vision(CYN" $N 对 $n 说 道 ： “ 你 年 纪 轻 轻 就 出 去 ， 人 家 会 以 为 我 无 量 "
" 无 人 的 。 ” \ n "NOR,this,me);
            if(me ->query(" class_score / 无 量 剑 派 西 宗 ")>10)
                me -> add( " class_score / 无 量 剑 派 西 宗 ",-10);            
            return " 过 两 年 再 说 吧 。 \ n ";
        }
        else
        {
             command( " chat * snow "+me->query(" id "));
             message_vision(CYN" $N 看 看 了 $n ， 道 ： “ 既 然 这 样 ， 我 也 知 道 留 你 不 住 了 。 "
" 出 去 了 可 不 要 忘 了 为 师 和 你 的 师 兄 弟 们 啊 。 \ n "NOR,this,me);
             me -> delete(" marks / 悟 剑 居 ");
             me -> delete(" master ");
             me -> set(" title "," 普 通 百 姓 ");
             me -> delete(" family ");
             me -> delete(" class ");
             me -> set(" hydra / 出 师 / 无 量 剑 派 西 宗 ",1);
             get_sword( me );
             LOG_D->do_log(me,sprintf(" 你 获 得 了 辛 双 清 的 允 许 ， 从 无 量 西 宗 出 师 。 \ n "));
             log_file(" chushi ",sprintf(" % s(% s) 于 % s 顺 利 从 无 量 西 宗 出 师 。 \ n ",me->query(" name "),
                getuid(me),ctime(time()) ) );
             message_vision(" $N 恭 恭 敬 敬 地 跪 了 下 来 ， 向 $n 磕 了 四 个 响 头 。 \ n ",me,this);
             return " 罢 了 ， 罢 了 。 。 。 ";
         }
    }
    else
    {
        return " 学 艺 未 精 ， 出 去 岂 非 给 我 无 量 西 宗 丢 脸 ！ ";
    }
    return " ";
}        

void get_sword( object me )
{
    object *inv;
    inv = all_inventory( me );
    foreach( object ob in inv )
    {
        if( ob->query(" id ")==" chang jian " 
            && ob->query(" name ")==HIY" 长 剑 "NOR )
        {
            say(CYN" 辛 双 清 说 道 ， “ 你 身 上 的 剑 就 不 要 带 着 了 吧 。 \ n "
            " 说 着 把 你 身 上 的 长 剑 拿 走 了 。 \ n "NOR );
            ob -> move(environment(me));
            destruct(ob);
         }
    }
}
//add by xli 1999.3 for qingcheng quest
int accept_object(object ppl, object obj)
{
    if(ppl->query(" class ")==" qingcheng ") // 青城弟子
    {
        if(ppl->query(" xli_marks / higher_renwu ")==2 ) // 是给辛送蟠桃的任务
        {
            if(obj->query(" name ")==GRN" 千 年 蟠 桃 "NOR )
            {
                tell_object(ppl," 你 恭 恭 敬 敬 地 从 怀 里 拿 出 包 裹 着 的 蟠 桃 ， 交 给 了 辛 道 长 。 \ n ");
                tell_object(ppl," 你 说 道 ： 家 师 司 马 卫 掌 门 闻 听 辛 道 长 今 年 五 十 大 寿 ， 特 命 弟 子 前 来 拜 寿 。 \ n ");
                tell_object(ppl," 奉 上 千 年 蟠 桃 一 个 ， 祝 辛 掌 门 福 如 东 海 ， 寿 比 南 山 ！ \ n ");
                tell_object(ppl," 辛 双 清 很 高 兴 地 看 着 你 ， 命 徒 儿 拿 过 蟠 桃 ， 仔 细 端 详 起 来 ... \ n ");
                destruct(obj);
                if(ppl->query(" xli_marks / eat_pantao ") ) // 吃过蟠桃
                {
                    tell_object(ppl," 辛 双 清 突 然 一 皱 眉 ， 说 道 ： \ n ");
                    tell_object(ppl," 这 个 蟠 桃 上 面 缺 了 一 小 块 ， 却 又 是 谁 给 偷 吃 了 ？ \ n ");
                    tell_object(ppl," 你 师 父 送 这 样 一 个 蟠 桃 来 却 是 何 意 ？ \ n ");
                    ppl->delete(" xli_marks / eat_pantao ");
                }
                else
                {
                    tell_object(ppl," 这 个 蟠 桃 红 艳 无 比 ， 香 气 四 溢 ， 果 然 是 人 间 极 品 ！ \ n ");
                    tell_object(ppl," 你 回 去 替 我 谢 谢 司 马 道 长 的 好 意 ， 改 日 司 马 道 长 做 寿 ， 辛 某 一 定 前 往 道 贺 ！ \ n ");
                    ppl->set(" xli_marks / higher_finish ",1);
                }
                return 1;
            }
            tell_object(ppl," 师 父 让 你 送 的 可 不 是 这 个 东 西 啊 ！ \ n ");
            return 1;
        }
        return ::accept_object(ppl,obj);
    }
    return ::accept_object(ppl,obj);
}
