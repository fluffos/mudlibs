//NPC

inherit NPC;
#include "west.h"
int ask_me(object me);



void create()
{
        set_name("小丫鬟", ({ "ya huan","dizi" }) );

        set("title","");
        set("gender", "女性" );
        set("age",18);
	set_wugong("unarmed", 60, 60, 1);
	set_xiuwei_by_type("unarmed", 80);
        set("combat_exp",2000);
      
    set("no_kill", "west_wuliang");
        setup();
//        carry_object(__DIR__"obj/cloth4")->wear();
}

int accept_object(object me,object obj)
{
	if ( me->query("family") && 
 		(string)me->query("family/family_name") =="无量剑派西宗" ) {
   		write ("小丫鬟对你摇摇头，说道：何必花这冤枉钱呢，去休息室吧。\n");
   		return 0;
   	}
	if ( (int)obj->value() >=1000 ) {
		me->set_temp("marks/money",1);
 		message_vision("小丫鬟对$N笑道：请进厢房休息。\n", me);
 		return 1;
 	}
 	return 0;
}


