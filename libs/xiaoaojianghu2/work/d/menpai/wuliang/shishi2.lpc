#include <room.h>

inherit ROOM;



void create()
{
	set("short","石室");
	set("long",@LONG
迎面只见一个宫装美女，手持长剑，剑尖对准了你的胸膛，原来是一座白
玉雕成的玉像(yuxiang)，玉像前有两个蒲团，似是供人磕头(ke tou)之用，
室内东壁写了许多字，都是“庄子”中的句子，大都出自“逍遥游”，“养生
主”，“秋水”，“至乐”几篇，笔法飘逸，似以极强腕力用利器刻成，文末
题着一行字：“逍遥子为秋水妹书。洞中无日月，人间至乐也。”壁上还镶了
许多明珠钻石，宝光交相辉映，西边壁上又镶有六块大水晶，映得石室中明亮
非常。
LONG 
);
	set("exits", ([
    	"west" : __DIR__"shiji1",
        "east" : __DIR__"shishi3",
        "north" : __DIR__"shiji",
         ]));
    set("item_desc",([
                    "yuxiang" : @TEXT
这玉像与生人一般大小，身上一件淡黄绸衫微微颤动，双眸莹然有光，神采飞
扬，脸上白玉的纹理中隐隐透出晕红之色，与常人肌肤无异，头上的头发是真的人
发，云鬓如雾，松松挽着一髻，鬓边插着一支玉钏，上面镶了两粒小指头般大的明
珠，莹然生光。
TEXT
]));
    setup();
}

void init()
{
    add_action("do_ke","ke");
}

void check_trigger()
{
    object me;    
    me=this_player();
    if((int)query("trigger")==15
    &&       !query_temp("蒲团/appear"))
    {
        //message("vision",
        message_vision(
        "蒲团上一层薄薄的蒲草已然破裂，露出了一个绸包。\n",
                      me, environment());
        set("蒲团/appear",1);
        
        __DIR__"obj/choubao"->move(this_object());
        delete("trigger");
     }
}

int do_ke(string arg)
{
    if( !arg || arg=="" )
    {
         write("你要干什么？\n");
         return 1;
     }

    if( arg=="tou")
    {
         add("trigger", 1);
         write("你一下一下地磕头，只觉腰越来越酸....\n");
         check_trigger();
         return 1;
     }
}
void reset()
{
    ::reset();
    delete("trigger");
}
