inherit ROOM;


void create()
{
	set("short","大厅后院");
	set("long",@LONG
这里很是幽静，一条窄窄的石板路通向后面的悟剑居，石板上已满是青苔，
一不留神就要滑倒，往西是一个花园，不时有蜂蝶飞过来绕个圈子又飞回去，往
南就是剑湖宫的大厅。
LONG 
);
	set("exits",
	([
          "west" : __DIR__"huayuan",
          "north": __DIR__"wujian_ju",
	  "south": __DIR__"dating",
        ]));
        set("objects",([
        __DIR__"npc/laotou" : 1,]) );
        set("blocks",([
	"north" : "guai laotou",]));
        set("block_msg","怪老头正仗剑拦在悟剑居门口！\n");
        setup();
}
int valid_leave(object me,string dir)
{
        object *all;
        int i;

        if ( dir=="north" ) 
        {
            all=all_inventory(me);
            for(i=0;i<sizeof(all);i++)
                if(userp(all[i])){
                    message_vision("$N把$n往地下一摔，独自走了进去。\n",me,all[i]);
                    all[i]->move("/clone/misc/void");
                }
        }
        return 1;
}
