// /d/menpai/wuliang/milin3.c changed by cry 9.17.98

inherit ROOM;


void create()
{
	set("short","密林");
	set("long",@LONG
这里是无量剑派的禁地，林荫蔽日，人迹罕至，不禁令人感到有些阴森。脚
下很多腐烂的树叶，一不小心就会摔上一跤。前面远远地传来了瀑布的轰隆声。
LONG);
	set("exits",
	(["north"     : __FILE__,
	"east" : __DIR__"houshan",
	"west" : __DIR__"milin2",
	  "south"     : __FILE__,
	]));
	set("woods",1);
	setup();
}

void init()
{
	object dating, obj, ob=this_object();

	if( !random(4) && !objectp(obj=present("gan ghao",ob)) )
		if( objectp(dating=find_object(__DIR__"dating")) )
			if( objectp(obj=present("gan ghao", dating)) ){
				tell_room(dating,"干光豪匆匆忙忙的离开了。\n");
				destruct(obj);
				obj=new(__DIR__"npc/gan1");
				obj->move(ob);
                        tell_room(ob,"干光豪悄悄地走了过来。\n");
			}
}
