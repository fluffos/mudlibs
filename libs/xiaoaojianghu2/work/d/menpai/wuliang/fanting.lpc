inherit ROOM;


void create()
{
  set("short","饭厅");
  set("long",@LONG
这里是平时无量弟子们吃饭的地方。饭厅很大，足可以让一百多人同时吃
饭。大厅正中有一扇屏风将屋子隔成两半，凳子椅子摆得整整齐齐，分别供男
女弟子坐下来(zuo)用餐(yao)；地上打扫得干干净净。墙壁上挂着几幅字。饭
厅的东面是厨房。向北穿过一条走廊就是练武大厅。
LONG);
  set("exits",([
    "east"   : __DIR__"chufang",
    "north"   : __DIR__"lianwu_ting",
  ]));
    set("objects",([
         __DIR__"obj/shichu" : 1,
    ]));
  setup();
}

void init()
{
	add_action("do_zuo",({"zuo","sit"}));
	add_action("do_yao","yao");
}

int do_zuo()
{
	object me = this_player();

    if ( me->query("family") 
    	&& (string)me->query("family/family_name") == "无量剑派东宗") {
 		message_vision("$N找了个空位子坐了下来。\n", me);
 		me->set_temp("marks/zuo",1);
 		return 1;
 	}
  	return notify_fail("你想吃白食啊？\n");
}

int do_yao()
{
    object me = this_player();
    object Food, Tea;
	int f,t;

    if (!(me->query_temp("marks/zuo"))) 
    	return notify_fail("你还是先找个位置坐下吧。\n");    
    f = 0;
    t = 0;
    if (((int)me->query("food")) >= ((int)me->max_food_capacity())) {
    	write("你已经吃饱了，吃的过饱可对身体不好。\n");
    	f = 1;
    }
	else {
	    Food=new(__DIR__"obj/baozi");
 	    write("伙工给了你一个包子。\n");
	    Food->move(me);
	}
	if (((int)me->query("water")) >= ((int)me->max_water_capacity())) {
 	   	write("你已经喝足了，喝的过多可对身体不好的。\n");
 	   	t = 1;
 	}
	else {
		Tea=new(__DIR__"obj/tea");
 		write("伙工给了你一碗茶。\n");
		Tea->move(me);
		return 1;
	}
    if ( f && t ) 
    	if (me->query_temp("marks/zuo")) {
   		 	message_vision("$N站了起来。\n", me);
   		 	me->set_temp("marks/zuo",0);
   		 }
   	return 1;
}

int valid_leave(object me,string dir)
{
	if (me->query_temp("marks/zuo")) {
		message_vision("$N站了起来。\n", me);
		me->delete_temp("marks/zuo");
	}
	if ( present("xiang cha",me) || present("bao zi",me) )
		return notify_fail("请吃完再走。\n");
	return 1;
}
