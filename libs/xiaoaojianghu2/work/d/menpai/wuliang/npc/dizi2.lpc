inherit NPC;



void create()
{   set_name("守门弟子", ({ "shoumen dizi","dizi" }) );
    set("gender", "男性" );
    set("age",25);
    set("per",25);
    set_wugong("unarmed",60,60,1);
    set_wugong("sword",100,100,1);
    set_wugong("wuliang-jian",50,50,1);
    set_xiuwei("unarmed",590);
    set_wugong("wuliang-shenfa",20);
    set_xiuwei("dodge",400);
    set_xiuwei("sword",600);
    set("combat_exp",10000);
    set("social_exp",2000);
    setup();
    carry_object(__DIR__"obj/cloth")->wear();
    add_money("coin",5);
}
