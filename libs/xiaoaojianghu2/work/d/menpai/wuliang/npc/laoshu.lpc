
inherit NPC;



void create()
{   set_name("大老鼠", ({ "lao shu" , "shu"}) );
    set("race", "野兽");
    set("age", 5);
    set("long", "一只恶心的大老鼠，用一双灰溜溜的眼睛看着你。\n");
    set("limbs", ({ "头部", "身体", "尾巴" }) );
    set("verbs", ({ "bite" }) );
    set("kee",200);
    set("max_kee",200);
    set("chat_chance", 35);
    set("chat_msg", ({
            (: random_move :)
    }) );

    set_wugong("dodge",70);
    set_xiuwei_by_type("dodge",100);
    set("combat_exp",200);

    setup();
}
