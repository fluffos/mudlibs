// yu_Gbiao.c
#include <ansi.h>
inherit NPC;



void create()
{
    set_name("郁光标", ({ "yu gbiao", "yu" }) );
        set("title","无量剑派东宗第弟子");
        set("title","无量剑派东宗第六代弟子");
    set("gender", "男性" );
    set("age", 32);
    set("str", 25);
    set("int", 15);
    set("per", 15);
    set("long","郁光标长得腰粗膀圆，一双恶狠狠的眼睛随时在到处打量。\n");
    set("combat_exp", 20000);
    set("social_exp", 1000);
    set("attitude", "herosim");

    set("force", 1000);
    set("max_force", 1000);
    set("force_factor", 100);
    set("kee",300);
    set("max_kee",300);


    set_wugong("unarmed", 60);
    set_wugong("lingxiao-shou", 60,60,1);
    set_wugong("dodge", 50);
    set_wugong("force",40);
    set_wugong("haoran-zhengqi",50);
    set_wugong("sword",70);
    set_wugong("wuliang-jian",100,100,1);
    set_xiuwei("dodge",700);
    set_xiuwei("unarmed",600);
    set_xiuwei("sword",1000);
        
    setup();
    carry_object(__DIR__"obj/cloth")->wear();
    carry_object(__DIR__"obj/changjian")->wield();
    add_money("coin",300);
}

void init()
{
    object ob;
    ::init();
    if(interactive(ob=this_player()) && !is_fighting()){
        remove_call_out("greeting");
        call_out("greeting",1,ob);
        }
}

void greeting(object ob)
{
   if(!ob||!present(ob,environment(this_object())))return;
   if( environment(this_object())->query("short") != "屋后" ) return; 
   say("郁光标大喝一声："+HIM"什么人！闯到这里来干什么！\n"NOR);
    kill_ob(ob);
    ob->fight_ob(this_object());
}
