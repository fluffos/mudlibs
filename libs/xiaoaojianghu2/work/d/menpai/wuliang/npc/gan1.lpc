#include <ansi.h>
inherit NPC;

int about_ge();
int about_ge1();


void create() {
  set_name("干光豪", ({ "gan ghao", "gan" }));
  set("title", "无量剑派东宗第六代弟子");
  set("long", "干光豪长相俊逸，但眉目之间透着一股奸诈之色。\n");
  set("gender", "男性");
  set("age", 25);  //gifts
  set("str", 25);
  set("int", 25);
  set("per", 24);
  set("combat_exp", 200000);  //other 参数
  set("social_exp", 100000);
  set("positive_score", 1000);
  set("negative_score", 3000);
  set("class_score", 700);
  set("attitude", "herosim");
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 5);
  set("kee", 500);
  set("max_kee", 500);
  //skills
  set_wugong("unarmed", 70, 70, 0);
  set_wugong("nanshan-liushi", 60);
  set_wugong("haoran-zhengqi", 40, 30, 1);
  set_wugong("sword", 70);
  set_wugong("wuliang-jian", 50, 40, 1);
  //set_wugong("parry",50,30,1);
  set_xiuwei("sword", 100);
  set_xiuwei("dodge", 100);
  set_xiuwei("unarmed", 100);
  create_family("无量剑派东宗", 6, "弟子");
  set("inquiry", ([
    "葛光佩": (: about_ge :),
    "葛妹": (: about_ge1 :),
  ]));
  set("chat_chance", 1);
  set("chat_msg", ({
    "干光豪自言自语的说道：葛妹怎么还不来呀，急死我了。\n",
  }));

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/jian2")->wield();
  add_money("silver", 1);
}

void welcome_visitor() {
  tell_object(this_player(), CYN "干光豪说道：“这里是无量剑派的禁地，你来干什么？”\n" NOR);
}

int about_ge() {
  object me = this_player();

  command("tell " + me->query("id") + " 你还知道什么？快说，不然。。。 ");
  command("hehe");
  command("follow " + me->query("id"));
  remove_call_out("kill_me");
  call_out("kill_me", 10, me);
  return 1;
}

int about_ge1() {
  object me = this_player();

  command("sneer " + me->query("id"));
  return 1;
}

void kill_me(object me) {
  object ob = this_object();

  ob->kill_ob(me);
  me->kill_ob(ob);
}
