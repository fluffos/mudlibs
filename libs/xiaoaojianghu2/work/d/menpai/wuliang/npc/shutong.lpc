// shutong.c

inherit NPC;



void create()
{
    set_name("书童", ({ "shu tong", "tong" }) );
    set("gender", "男性" );
    set("age", 17);
    set("str", 14);
    set("int", 30);
	set("per",30);
    set("long","这个小书童长得眉清目秀，正在收拾书架。\n");
    set("combat_exp", 1000);
    set("attitude", "friendly");

    set("force", 120);
    set("max_force", 120);
    set("force_factor",2);
    set_wugong("unarmed",30, 30, 1);
    set_xiuwei("unarmed",40);
    setup();
    carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{
        object ob;
        ::init();
        if(interactive(ob=this_player()) && !is_fighting()){
            remove_call_out("greeting");
            call_out("greeting",1,ob);
            }
}

void greeting(object ob)
{
        if(!ob||!present(ob,environment(this_object())))return;
        say("小书童转过身来：“你进书房来干什么？快出去。\n"
        "别让左先生知道了怪罪下来就难办了。”\n");
        }

//Changed by lala Aug. 2, 97
int accept_object(object who,object ob)
{
    if(ob->query("id")=="yang mei")
	{
	    message_vision("小书童对$N嘻嘻一笑：“哟，真是不好怪意思的……\n"
			"这本书你就拿去看吧。”\n", who);                     
		remove_call_out("now_chat");
		new(__DIR__"obj/shu")->move(who);
    	return 1;
    }
	else
	{	
		command("shake");
		command("say 唉～～可不敢再要了，那天被左先生发现，痛打了我一顿……");
		command("poor");
		remove_call_out("now_chat");
		call_out("now_chat", 5+random(8) );
		return 0;
	}
}

void now_chat()
{   
	command("say 咦～那天从左先生那儿弄了点杨梅吃，真好吃啊～～可惜都吃完了。");
}	
