// force_book.c

inherit ITEM;

int cannot_search( object me );



void create()
{
        set_name("百家姓", ({ "shu" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                "这本书的纸张都已经泛黄了，看上去相当破旧。\n");
                set("value", 70);
                set("material", "paper");
                set("skill", ([
                        "name":"literate",
                        "xiuwei_required" : 0,
                        "gin_cost" : 10+random(10),
                        "difficulty":   20,
                        "max_jibie" : 30,
                ]) );
        }
}

int cannot_search( object me )
{
    if( (int)me->query("social_exp") > 60 )
    {
        message_vision("$N敏锐的眼光已经看到了里面的藏书。\n",me);
        return 0;
    }
    return 1;
}
