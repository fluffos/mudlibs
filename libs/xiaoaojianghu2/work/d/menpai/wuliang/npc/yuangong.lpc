
inherit NPC;



void create()
{   set_name("园工", ({ "yuan gong" }) );
    set("gender", "男性" );
    set("age", 52);
    set("long", "一位满脸风霜的老园工。\n");
	set("str", 12);
    set("int", 24);
    set("combat_exp", 500);
    set("attitude", "friendly");
    set_wugong("sword", 60,60,1);
    set_wugong("jiben-qinggong", 30);
    set_xiuwei("sword", 500);
    set_xiuwei("dodge", 500);

	setup();
	add_money("coin", 50);
	carry_object(__DIR__"obj/jianzi")->wield();
	carry_object(__DIR__"obj/cloth")->wear();
}

