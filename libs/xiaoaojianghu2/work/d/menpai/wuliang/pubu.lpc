#include <room.h>

inherit ROOM;



void create()
{
	set("short","大瀑布");
	set("long",@LONG
只觉耳旁隆隆声不绝，一声声巨响直如打雷一般，一条白练似的瀑布从高处
直泻而下，冲到巨石上，激起无数水花，水花化为雾气，弥漫于四周，到处一片
迷蒙，竟似下雨一般，北面是一片已被冲刷得光润如玉的石壁。
LONG 
);
	set("exits", ([
    	"east" : __DIR__"gudi",
        "north" : __DIR__"yubi",
         ]));
        set("outdoors","wuliang");
        setup();
	//place_program( ROOM );
}
