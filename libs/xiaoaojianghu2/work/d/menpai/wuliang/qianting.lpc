inherit ROOM;


void create() {
  set("short", "前厅");
  set("long", @LONG
这是一间很宽敞的大厅，南面是一排大窗格，絮暖的阳光透过窗子直射进来
，照得厅上亮堂堂的，东边穿过走廊是一个干干净净的院子直通大门和正厅。北
面是供招待客人用膳的地方。
LONG
  );
  set("exits", ([
    "east": __DIR__ "qianyuan",
  ]));
  set("need_clean", "无量剑派东宗");

  setup();
}

void init() {
  add_action("da_sao", "sao");
  add_action("da_sao", "clean");
}

int da_sao(string arg) {
  object me;
  mapping quest;
  me = this_player();
  if (!me->can_act()) return notify_fail("你现在无法打扫。\n");

  if (call_other("/cmds/verb/clean", "main", me, arg)) {
    if (quest = me->query("quest")) {
      if (quest["quest"] == "扫前厅")
        me->set("done_quest", "扫前厅");
      return 1;
    }
    return 1;
  }
  return 0;
}
