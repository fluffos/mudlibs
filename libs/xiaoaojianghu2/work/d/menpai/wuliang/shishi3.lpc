#include <room.h>

inherit ROOM;



void create()
{
	set("short","石室");
	set("long",@LONG
这里是一间石室，角落上有张石床，床前摆着一张小小的木制摇篮，墙壁上
悬了一张七弦琴，玄线俱已断绝，床左有张石几，几上刻了十九道棋盘，又有两
座烛台，兀自插着半截残烛，烛台的托盘上放着火石火刀和纸媒；只见那棋局上
还布着二百馀枚棋子，黑白对峙，并没有下完。向北是一个月洞门，门旁壁上凿
着四个字：“琅寰福地”。
LONG 
);
	set("exits", ([
    	"west" : __DIR__"shishi2",
        "north" : __DIR__"fudi",
         ]));

    setup();

    //place_program(ROOM);
}
