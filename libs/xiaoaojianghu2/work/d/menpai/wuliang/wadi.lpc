inherit ROOM;


void create() {
  set("short", "洼地");
  set("long", @LONG
这里是一片洼地，非常潮湿，地上长满了青苔，一条山溪从路旁汩汩流过，
只听溪水的声音叮叮咚咚，在山间回响，甚是动听，山水清澈见底，令人忍不住
要俯下身去掬一口来喝，再往山里进去是一处山坳，往下是一条羊肠小道。
LONG
  );
  set("exits",
    ([
      "northwest": __DIR__ "shanao",
      "southeast": __DIR__ "xiaodao2",
    ]));
  set("outdoors", "wuliang");
  set("objects", ([
    __DIR__ "npc/x_dizi": 5, ]));
  setup();
  //place_program( ROOM );
}
