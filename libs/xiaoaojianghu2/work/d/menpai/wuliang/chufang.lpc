#include <room.h>
inherit DOOR_ROOM;



void create()
{
  set("short","厨房");
  set("long",@LONG
这里每天要为无量派全派一百多名弟子准备三餐，虽然有四五个火工厨子
干活也还觉得忙碌，靠南墙一排大灶，墙壁都已熏得黝黑；灶下堆着尚未燃尽
的柴禾，两个伙计坐在西边地下拣菜。北面有一扇门,因许久没有打开，门轴
都已生锈，西面是饭厅。
LONG);
  set("exits",([
    "north"  : __DIR__"dongmen",
    "southeast"   : __DIR__"chaifang",
    "west"   : __DIR__"fanting",
  ]));
        set("search_things", ([
                "灶下" : __DIR__"obj/chaidao",
                ]) );
   create_door("north","木门","south",DOOR_CLOSED);
   set("need_clean", "无量剑派东宗");
  setup();
}
void init()
{
        add_action("do_open","open");
}
int do_open(string arg)
{
        write("这扇木门多年未用，门轴已经锈死了\n");
        return 1;
}        
