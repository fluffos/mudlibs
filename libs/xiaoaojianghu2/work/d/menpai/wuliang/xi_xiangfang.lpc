#include <room.h>
inherit DOOR_ROOM;



void create() {
  set("short", "西厢房");
  set("long", @LONG
你进入西厢房来，地下面西放着四张椅子，上面都铺着锦垫，椅子边有一对
高几，几上搁一茶盘，盘中六色果子细点，茶盏齐备，一壶清茶居中，布置极是
雅致，凭窗望去可看到山间秀色，西面红门外是一条碎花小径。南面一扇木门隔
断，挂着绣缎门帘。
LONG
  );
  set("exits",
    ([
      "west": __DIR__ "xiaojing",
      "east": __DIR__ "shufang",
      "south": __DIR__ "woshi",
    ]));
  create_door("south", "绣缎门帘", "north", DOOR_CLOSED);
  create_door("west", "红门", "east", DOOR_CLOSED);
  setup();
}
