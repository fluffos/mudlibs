#include "kl_r.h"



void create()
{
    set("short", "谷地");
    set("long", @LONG
在莽莽昆仑山的群山之间，竟然有一片广为开阔的谷地。这里是山花烂漫，
不分冬夏。昆仑山山头是一片冰雪，这块谷地，确是别有一番景色。令人流连忘
返。但是仔细看去，这里明显有人工的痕迹。有人经常从此处路过。
LONG );
    set( "exits", ([ /* sizeof() == 2 */
    "south" : __DIR__"gudi1",
    "northup" : __FILE__,
]) );
    set( "item_desc",([
    "northup" : "山势陡峭，实在是难以上去...\n",
]) );
    set( "no_clean_up", 0);
    set( "outdoors","kunlun");
    setup();
}

int valid_leave(object me,string dir)
{
    if(dir=="northup")
        return notify_fail("上不去啊——\n");
    return ::valid_leave(me,dir);
}
