#include "kl_r.h"



void create() {
  set("short", "沙漠边缘");
  set("long", @LONG
在茫茫沙漠之中，路途很难认清楚，上无飞鸟，下无走兽，复无水草。只能
寻着人畜骨骸，马粪以辨认前进，不时会遇到一些结伴而行的商侣。东北面是那
宽广的大沙漠的腹地。往南已经可以隐约看见那昆仑山脉的轮廓了。
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "southwest": __DIR__ "mouth",
    "northeast": "d/map/xiyu/nanjiang4",
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "southwest")
    write(CYN "......渐渐地.......一望无际的昆仑山脉渐渐清晰起来......\n" NOR);
  return ::valid_leave(me, dir);
}
