#include  "kl_r.h"

string * app_room = ({
__DIR__"tingzi",    __DIR__"shandao01", __DIR__"shandao02",
__DIR__"shandao03", __DIR__"xiaolu01",  __DIR__"xiaolu02",
});


void eventEscape( object );



void create()
{
    set( "short", "密室" );
    set( "long", @LONG
这是一间很小的房间，四面无窗，仅在屋顶有一小天窗，室内光线不够，只
有刚才进来的一扇隔墙隐约透进来一点光亮，借助这点光亮，只看见靠墙的地方
放着一张木板床，床上有简单的棉被等物，显见是很久没有人来过了。墙角堆放
着宝剑、刀、枪……横七竖八的，显得这里十分的神秘。
LONG );
    set("not_startroom",1);
    setup();
}
void init()
{
    object me = this_player();
//    if(kl_mark("query",me,"old_man/see_man",1,1) ) {
//     add_action("do_search","search");
//     }
    write( "你钻了进来，身后的暗门又合上了。\n" );
    add_action( "do_push", "push" );
    remove_call_out( "eventEscape" );
    call_out( "eventEscape",1,me );
}

//when ppl enter here,he may be see some person escape from here
//ffox say it's a quest
//Hydra 19980425

void eventEscape( object me )
{
    int my_kar,my_spi,point;
    string current_room;
    object room,ob;
    my_kar = me->query( "kar" );
    my_spi = me->query( "spi" );

    if( query( "no_person" ) ) return;    
//    if(kl_mark("query",me,"old_man/see_man",1,1))return;
   if( me->query("kl_mark/see_man")+14-me->query("age")>0) return;
    point = my_kar + my_spi + random( 100 );
    if( wizardp(me) ) write("参数为："+chinese_number(point)+"。\n");
    if( point >125 )
    {
        tell_object( me,"你隐约看到一个人从天窗跳了出去。。。\n" );
        current_room = app_room[ random( sizeof( app_room ) ) ];
        set( "no_person",1 );
        if(!room=find_object(current_room)){
             room = load_object( current_room );
        }
        me->set("kl_mark/see_man",me->query("age")-13);
        kl_mark("set",me,"old_man/see_man",1,1);
        ob = new( __DIR__"npc/shenmi" );
        ob -> move( room );
    }
}

int do_push(string arg)
{
    object me = this_player();
    if( query("open") ) return 0;
    if( !arg || arg != "隔墙" )  return 0;
    message_vision( "$N用力将隔墙推了一下，露出一个不大的暗门。
                      \n", me );
    add( "exits/out", __DIR__"guangbi" );
    set( "open", 1 );
    remove_call_out( "do_close" );
    call_out( "do_close", 3, me );
    return 1;
}
int do_close( object me )
{
    delete( "exits/out" );
    delete( "open" );
    tell_room( __FILE__, "过了一会儿，隔墙又缓缓移回原位。\n" );
    write( "    暗门又关上了！\n" );
    return 1;
}

