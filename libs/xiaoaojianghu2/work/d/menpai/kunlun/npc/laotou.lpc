// laotou.c 老头
// Ffox 98-4-22 14:19

#include "kl_p.h"
#include "shupuwork.h"
#include "work.h"
string do_give_work();
string ask_shucai();


void create()
{
    set_name( "高老头", ({ "lao tou", "laotou", }) );
    set( "gender", "男性" );
    set( "title", "昆仑派蔬圃" );
    set( "attitude", "peaceful" );
    set( "age", 65 );
    set( "per", 25 );
    set( "long", @LONG
一个瘦瘦的老头，整日在地里忙活，将这一片蔬圃拨弄得到处绿油油的，蔬菜长
势极好，看来他这一辈子，功夫也在这园艺、农活上了，当然也很有成就。
LONG );
    set( "inquiry", ([
        "干活" : (:do_give_work:),
        "帮什么忙" : (:do_give_work:),
        "蔬菜" : (:ask_shucai:),
        "此地" : (:about_here:),
    ]) );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "高老头自言自语地说：“看来这片地今年收成不错啊。”\n",
        "高老头感叹万分：“要摆弄这些地，真不容易呀！”\n",
        "高老头看了看地里，低头又挖了起来。\n",
     }));
    
    setup();
    carry_object( "/clone/wear/cloth/cloth2" )->wear();
}

string do_give_work()
{
    return(give_work("蔬圃","高老头"));
}

string ask_shucai( )
{
    object me = this_player();
    if( !kl_dizi(me) ) return ("这地里的蔬菜长势真是不错。一年四季常青那。");
    if(kl_mark("query",me,"kunlun_work",1,1)) {
        kl_mark("set",me,"shupu/shucai", 1,0  );
        return ("这地里蔬菜差不多都成熟了，你自己可以去地里去看一下啦……");
       }
    command( "sigh" );
    return ( "问我关于蔬菜的事情，莫非想帮我干活？" );
}