#include "kl_p.h"
#include "yaofangwork.h"
#include "work.h"

string do_give_work();
int CanTeach();



void create()
{
    set_name( "药师", ({ "yao shi", "yaoshi", }) );
    set( "gender", "男性" );
//    create_family( "昆仑派", 3, "弟子" );
    set( "can_teach",1);
    set( "title", "昆仑派" );
    set( "attitude", "peaceful" );
    set( "age", 60 );
    set( "per", 35 );
    set( "long", @LONG
仙风道骨，飘逸红尘，制药本领在这里是众人皆知，大伙凡有什么，均来这里请
求帮忙，真是手到病除。在这里呆了几十年，大家都称他为活神仙。有他在这里
，也可以算是昆仑派的一件幸事。
LONG );
    set( "inquiry", ([
     "干活"      :   (: do_give_work:),
     "帮什么忙"  :   (: do_give_work:),
     "学功夫"    :   (: CanTeach    :),
     "此地"      :   (: about_here  :),
]) );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "药师尝了尝手中的药，皱了皱眉头。\n",
        "药师将几味药放进了钵盂，捣了几下。\n",
        "药师从旁边的框里面挑选出几种草药，仔细加工了起来。\n",
     }));
    set_wugong( "haoran-zhengqi", 100, 100, 0 );
    set_wugong( "unarmed",130,130,1 );
    set_wugong( "liangyi-jian", 120, 120, 1 );
    set_wugong( "panheng-zhang", 120, 120, 1 );
    set_wugong( "yinzhi-bufa", 120, 120, 1 );
    set_wugong( "sword", 140, 140, 0 );
    set_wugong( "liangyi-xinfa", 120, 120, 1 );
    set_wugong( "literate", 120, 120, 0 );
    set_xiuwei( "sword", 5300 );
    set_xiuwei( "dodge", 2700 );
    set_xiuwei( "unarmed", 2700 );
    set( "max_force", 2400 );
    set( "force", 2400 );
    set( "force_factor", 240 );
    set( "combat_exp", 500000 );
    setup();
    carry_object( "/clone/wear/cloth/cloth2" )->wear();
}

string do_give_work()
{
    return(give_work("药房","药师"));
}


int valid_teach( object ppl, string skill )
{
    if( !kl_dizi(ppl) ) return 0;
    if ( !kl_mark("query",ppl,"marks/yaoshi",1,1 ) )      //如果没有学功夫的标记
    {
        command( "say “你想学功夫？”" );
        return 0;
    }
    if ( !query_jibie( skill ) )
        return 0;
    if( skill=="literate" || skill == "unarmed" ||
        skill=="sword" || skill=="haoran-zhengqi" ) return 1;
    command( "say “这些功夫嘛，你还是向师傅去请教啦！”" );
    return 0;
}

int zhongcheng( object ppl, string skill )  //不检查忠诚度
{
    return 1;
}

int CanTeach()
{
    object ppl = this_player();
    if( !kl_dizi(ppl) ) 
        return 0;
    if ( !kl_mark("query",ppl,"marks/yaoshi",1,1 ) )       //没有记号则可以学功夫。
    {
        message_vision( "$N高兴地哈哈大笑起来，用力地拍了拍$n的肩膀。\n", 
            this_object(), ppl );
        command( "nod" );
        command( "say “既然你有心学，俺就教你些功夫罢了！”" );
        kl_mark("set",ppl,"marks/yaoshi", 1,1 );       //可以学功夫的标记。
        return 1;
     }
     command( "pat" + ppl->query( "id" ) );
     return 1;
}

int tell_skills(object ppl)
{
    if ( !kl_mark("query",ppl,"marks/yaoshi",1,1 ) )     //如果没有记号就不回答。
        return notify_fail( "药师不想回答你这个问题。\n" );

    message_vision( @TEXT
$N对$n说：“你可以学：
    读书识字  〖literate〗
    浩然正气  〖haoran-zhengqi〗
    基本剑法  〖sword 〗
    基本拳法  〖unarmed 〗
TEXT
    , this_object(), ppl );

    return 1;
}

void init()
{
    call_out("greeting",1,this_player());
}
