// watdizi 挑水弟子
// Ffox 98-5-16 9:53

#include "kl_p.h"

string where_to_go();
string* get_tong = ({
"southeast", "south", "east", "east", "north", "north",
});
string* get_shui = ({
"south", "south", "west", "west", "north", "northwest", 
});



void create()
{
    set_name( "挑水弟子", ({ "di zi", "dizi" }) );
    create_family("昆仑派", 4, "弟子");
    set( "title", "昆仑派第四代弟子" );
    set( "long", @LONG
昆仑派门下弟子，在昆仑派里成为一名弟子，的确是一件自豪的事情。但昆仑派
里也要作很多的活计，现在就是在厨房帮忙。
LONG );
    set( "gender", "男性" );
    set( "age", 20 );
    set("chat_chance", 55);
    set("chat_msg", ({
        (: where_to_go :),
    }));
    set( "attitude", "peaceful" );
    set( "inquiry", ([
        "此地" : (:about_here:),
    ]) );  
    set_wugong( "kunwu-jian", 100, 100, 1 );
    set_wugong( "baihe-quan", 100, 100, 1 );
    set_wugong( "kunlun-bu", 100, 100, 1 );
    set_wugong( "liangyi-xinfa", 50, 50, 1 );
    set_wugong( "literate", 130, 130, 0 );
    set_xiuwei( "sword", 1101+random(230) );
    set_xiuwei( "dodge", 1000+random(200) );
    set_xiuwei( "unarmed", 1100 );
    set( "max_force", 1000 );
    set( "force", 1000 );
    set( "force_factor", 50 );
    set( "combat_exp", 80000 );
    setup();
    carry_object( "/clone/wear/cloth/cloth1" )->wear();
    carry_object( "/clone/weapon/sword/changjian" )->wield();
}

string where_to_go()
{
    int i;
    object room;
    room = environment(this_object());
    if( !objectp(room) ) {
           destruct( this_object() );
           return ".\n";
          }
    if( !room->query("kunlun/water") ) {
      tell_room( room, "挑水弟子突然听到什么信息……一个转身，不见了。\n", this_object() );
     destruct( this_object() );
    return "\n";
    }
    if( !query("dashui") ) {
        add( "ffox/num", 1);
        i = query( "ffox/num" );
        if( i < 6 ) {
        command( "go "+get_tong[i] );
        command( "sigh " );
        return "挑水弟子叹了一口气，真累啊！\n";
        }
        if( i==6 ) command ( "dao shui" );
        if( i==7 ){ command ( "fang tong" ); set( "dashui", 1 ); }
        command( "xixi" );
        return "挑水弟子得意地笑了笑！\n";
    }
    add( "ffox/num", -1 );
    i = query( "ffox/num" );
    if( i==6 ) { command( "tiao tong" ); return ""; }
    if( i>=0 && i<6 ){
        command( "go "+get_shui[5-i] );
        command( ":(" );
        return "挑水弟子呼哧、呼哧喘了几口气。\n";
      }
    command( "da shui" );
    delete( "dashui" );
    command( ":)" );
    return "挑水弟子满意地看着水桶。\n";
}

void init()
{
    call_out("greeting",1,this_player());
}
int valid_teach( object ppl, string skill )
{
    return 0;
}
