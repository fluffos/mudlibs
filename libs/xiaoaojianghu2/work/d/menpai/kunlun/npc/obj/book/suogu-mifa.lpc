// suogu-mifa.c
// 缩骨密法

inherit ITEM;



void create()
{
    set_name("「缩骨密法」", ({ "suogu mifa", "mifa", "book", "shu", }));
    set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("unit", "本");
        set("long","这是本新书，墨迹依然，上书「缩骨密法」几个字。\n");
        set("value", 0);
        set("no_give",1);
        set("no_drop",1);
        set("material", "paper");
       set("skill", ([
			"name"             :  "suogu-gong",  
	    		"xiuwei_required"  : 0,
		        "literate_required" : 60,
	        	"gin_cost"         : 40+random(10),
			"max_lingwu"        : 150,
		        "bonus_jilei"      : 40,
		        "bonus_social_exp" : 10,
            		"max_social_exp"   : 50000,
		]) );
	}
}
