inherit ITEM;



void create()
{
    set_name("「瑶台飞仙图」", ({ "yaotaifeixian tu", "tu" }));
    set_weight(30);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "幅");
    set("long", "这是一幅精美的「瑶台飞仙图」。\n");
    set("value", 400);
    set("material", "paper");
    set("skill", ([
        "name"              :"kunlun-bu",
        "xiuwei_required"   : 200,
        "literate_required" : 80,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 70,
        "max_lingwu"        : 70,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 800,
        ]) );
    }
}   
         