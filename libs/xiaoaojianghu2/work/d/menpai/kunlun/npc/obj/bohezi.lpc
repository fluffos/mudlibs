// bohezi.c   薄荷子
// Ffox 98-4-20 20:20

inherit ITEM;



void create()
{
    set_name( "薄荷子", ({ "bohe zi","zi" }) );
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set( "unit", "把" );
        set( "long", "一些薄荷种子，可以供种植薄荷用。\n");
        set( "value", 10);
    }
    setup();
}
