// baicaizi.c   白菜子
// Ffox 98-4-20 20:20

inherit ITEM;



void create()
{
    set_name( "白菜子", ({ "baicai zi","zi" }) );
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set( "unit", "把" );
        set( "long", "一些白菜的种子，可以供种植白菜用。\n");
        set( "value", 10);
    }
    setup();
}
