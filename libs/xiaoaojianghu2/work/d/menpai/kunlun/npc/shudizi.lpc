#include "kl_p.h"



void create() {
  set_name("种菜弟子", ({ "di zi", "dizi" }));
  create_family("昆仑派", 4, "弟子");
  set("title", "昆仑派第四代弟子");
  set("long", @LONG
昆仑派门下弟子，在昆仑派里成为一名弟子，的确是一件自豪的事情。但昆仑派
里也要作很多的活计，现在就是在蔬圃帮忙。
LONG);
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");
  set("inquiry", ([
    "此地": (: about_here :),
  ]));
  set("chat_chance", 5);
  set("chat_msg", ({
    "种菜弟子在地里面席地而坐，打起了盹来。\n",
    "种菜弟子很不情愿地扛起锄头，挖起地来。\n",
    "种菜弟子拿起了木桶，往菜地里面浇起水来。\n",
  }));
  set_wugong("kunwu-jian", 100, 100, 1);
  set_wugong("baihe-quan", 100, 100, 1);
  set_wugong("kunlun-bu", 100, 100, 1);
  set_wugong("liangyi-xinfa", 50, 50, 1);
  set_xiuwei("sword", 1026 + random(200));
  set_xiuwei("dodge", 1026 + random(200));
  set_xiuwei("unarmed", 1100);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 50);
  set("combat_exp", 80000);

  setup();
  carry_object("/clone/wear/cloth/cloth1")->wear();
  carry_object("/clone/weapon/sword/changjian")->wield();
}
void init() {
  call_out("greeting", 1, this_player());
}
