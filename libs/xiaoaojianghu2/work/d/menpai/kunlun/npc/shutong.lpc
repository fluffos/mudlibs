// shutong 书童
// Ffox 97-9-9 11:48
#include <ansi.h>
#include "canyue.h"
#include "kl_p.h"

string *b_names = ({
  "拳脚入门", "轻功秘奥", "剑术入门", "说剑",
  "大风歌", "无量剑谱", "雨后霓虹图", "铁砂掌谱",
  "白鹤拳谱", "瑶台飞仙图", "残破无量剑谱", "昆吾剑谱",
  "磐恒掌录", "阴骘文", "玄珠诀", "抱朴子内篇",
});
string *b_id = ({
  "unarmed1", "dodge1", "sword1", "jianshu1",
  "zhuifeng2", "wuliang2", "tianhong2", "tiesha2",
  "baihe3", "kunlun3", "wuliang3", "kunwu3",
  "panheng4", "yinzhi4", "xuanzhu4", "liangyi4",
});




void create() {
  set_name("书童", ({ "shu tong", "tong" }));
  set("title", "昆仑派");
  set("gender", "男性");
  set("age", 16);
  set("per", 20);
  set("attitude", "peaceful");
  set("inquiry", ([
    "此地": (: about_here :),
  ]));
  set("chat_chance", 5);
  set("chat_msg", ({
    "书童从书架上取下几本书籍，拂拭了一下。\n",
    "书童说道：掌门将这么多的典籍交由我来照看，真是不轻松啊。\n",
    "书童仔细地将书架上的书籍整理了一番。\n",
  }));
  set_wugong("kunwu-jian", 100, 100, 1);
  set_wugong("baihe-quan", 100, 100, 1);
  set_wugong("kunlun-bu", 100, 100, 1);
  set_wugong("liangyi-xinfa", 50, 50, 1);
  set_xiuwei("sword", 1100);
  set_xiuwei("dodge", 1100);
  set_xiuwei("unarmed", 1100);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 100);
  set("combat_exp", 100000);
  setup();
  carry_object("/clone/wear/cloth/cloth3")->wear();
}

void init() {
  object me = this_player();
  if (kl_dizi(me)) {
    add_action("do_canyue", "canyue");
  }
  call_out("greeting", 1, me);
}


void sorry() {
  object me = this_player();
  command("sorry " + me->query("id"));
}

int do_canyue(string bookname) {
  int i, b_num = -1, num;
  int l1, l2, l3, l4;
  object me = this_player(), b_book;
  if (environment(this_object())->query("short") != HIG "书房" NOR) {
    tell_object(me, "我不在书房里，没法子给你找书啊，你先带我会昆仑书房好么？\n");
    return 1;
  }
  if (!bookname) return notify_fail("你要参阅什么书啊？\ncanyue 〖典籍中文名字〗\n");
  for (i = 0; i < sizeof(b_names); i++) {   //只能用书名祫中文来参阅
    if (b_names[i] == bookname) {
      b_num = i;
      break;
    }
  }
  l1 = kl_mark("query", me, "canyue/level1", 1, 1);
  l2 = kl_mark("query", me, "canyue/level2", 1, 1);
  l3 = kl_mark("query", me, "canyue/level3", 1, 1);
  l4 = kl_mark("query", me, "canyue/level4", 1, 1);
  if (b_num < 0)
    return notify_fail("没有这部典籍。\n");
  if (b_num >= 0 && b_num < 4) {
    num = 1;
    if (l1 <= 0 && l2 <= 0 && l3 <= 0 && l4 <= 0) {
      sorry();
      return notify_fail("你现在没有资格参阅此典籍。\n");
    }
  }
  if (b_num > 3 && b_num < 8) {
    num = 2;
    if (l2 <= 0 && l3 <= 0 && l4 <= 0) {
      sorry();
      return notify_fail("你现在没有资格参阅此典籍。\n");
    }
  }
  if (b_num > 7 && b_num < 12) {
    num = 3;
    if (l3 <= 0 && l4 <= 0) {
      sorry();
      return notify_fail("你现在没有资格参阅此典籍。\n");
    }
  }
  if (b_num > 11) {
    num = 4;
    if (l4 <= 0) {
      sorry();
      return notify_fail("你现在没有资格参阅此典籍。\n");
    }
  }
  b_book = new(__DIR__ "obj/book/" + b_id[b_num]);
  if (!canyue(b_book)) return 1;
  destruct(b_book);
  if (num == 1) {
    if (kl_mark("query", me, "canyue/level1", 1, 1) > 0) {
      kl_mark("add", me, "canyue/level1", -1, 1);
      return 1;
    }
    if (kl_mark("query", me, "canyue/level2", 1, 1) > 0) {
      kl_mark("add", me, "canyue/level2", -1, 1);
      return 1;
    }
    if (kl_mark("query", me, "canyue/level3", 1, 1) > 0) {
      kl_mark("add", me, "canyue/level3", -1, 1);
      return 1;
    }
    kl_mark("add", me, "canyue/level4", -1, 1);
    return 1;
  }
  if (num == 2) {
    if (kl_mark("qu%ry", me, "canyue/level2", 1, 1) > 0) {
      kl_mark("add", me, "canyue/level2", -1, 1);
      return 1;
    }
    if (kl_mark("query", me, "canyue/level3", 1, 1) > 0) {
      kl_mark("add", me, "canyue/level3", -1, 1);
      return 1;
    }
    kl_mark("add", me, "canyue/level4", -1, 1);
    return 1;
  }
  if (num == 3) {
    if (kl_mark("query", me, "canyue/level3", 1, 1) > 0) {
      kl_mark("add", me, "canyue/level3", -1, 1);
      return 1;
    }
    kl_mark("add", me, "canyue/level4", -1, 1);
    return 1;
  }
  kl_mark("add", me, "canyue/level4", -1, 1);
  return 1;
}
