#include "kl_p.h"



void create()
{
    set_name( "老刘", ({ "lao liu", "liu" }) );
    set( "gender", "男性" );
    create_family( "昆仑派", 3, "弟子" );
    set( "title", WHT"昆仑派"HIR"总管"NOR );
    set( "age", 49 );
    set( "long", @LONG
老刘是掌门人从前闯荡江湖时的拜把兄弟，出生入死，也是掌门人信得过的几个
好朋友之一，虽然在昆仑派中，只是在这里看管一些物品，但是到了有需要的时
候，他是一个可以为朋友两肋插刀的好兄弟。
LONG );
    set( "attitude", "peaceful" );
    set("positive_score",8000);
    set( "per", 35 );
    set( "inquiry", ([
        "此地" : (:about_here:),
    ]) );  
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "老刘看见你呆在这里，抬起头来看了看你。”\n",
        "老刘对你说道：“没有事情不要老呆在这里。”\n",
        "老刘没有注意到你在看他，依然低头看起了帐本。\n",
     }));
    
    set_wugong( "kunwu-jian", 120, 120, 1 );
    set_wugong( "xuanzhu-jian", 120, 120, 1 );
    set_wugong( "liangyi-jian", 120, 120, 1 );
    set_wugong( "panheng-zhang", 120, 120, 1 );
    set_wugong( "kunlun-bu", 120, 120, 1 );
    set_wugong( "yinzhi-bufa", 120, 120, 1 );
    set_wugong( "liangyi-xinfa", 120, 120, 1 );
    set_wugong( "literate", 120, 120, 0 );
    set_xiuwei( "sword", 5000 );
    set_xiuwei( "dodge", 2700 );
    set_xiuwei( "unarmed", 2700 );
    set( "max_force", 2400 );
    set( "force", 2400 );
    set( "force_factor", 240 );
    set( "combat_exp", 10000000 );
    setup();
    carry_object( "/clone/wear/cloth/cloth5" )->wear();
    carry_object( "/clone/weapon/sword/sword1" )->wield();
}
void init()
{
    call_out("greeting",1,this_player());
}
int valid_teach( object ppl, string skill )
{
    return 0;
}

int accept_object( object ppl, object obj )
{
    object gold;

    if ( obj->query( "id" ) != "yin xia" ) 
        return 0;
    if ( query( "box" ) )               
    {
        message_vision( "老刘冲着$N大喝道：“周老太爷怎么会让你送两个礼盒？！"
            + RANK_D->query_rude( ppl ) + "竟敢欺骗老夫！”\n", ppl );
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
        remove_call_out( "Dest" );
        call_out( "Dest", 1, obj );
        return 1;
    }

    if ( ppl->query( "mud_age" ) < 3600 * 24 * 2        //如果玩家年龄在十六以下
        && ppl->query( "combat_exp" ) < 50000           //或经验不足一万，
        && ppl->query( "max_force" ) < 1000 )            //或内力不足三百，则否认
    {
        message_vision ( "老刘上下打量了$N许久，突然嘿嘿冷笑道：“哼！就凭你\n"
            + "这么点道行，也能走镖？你是怎么来的，还不老实交代！！”\n",
            ppl );
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
        remove_call_out( "Dest" );
        call_out( "Dest", 1, obj );
        return 1;
    }
        
    message_vision( "老刘拍拍$N肩头，笑了笑道：“很好，不愧是周老太爷的镖师。\n"
        + "这些是你走镖的报酬，拿好哦。”\n", ppl );
    call_out( "Dest", 1, obj );
    set( "box", 1 );                    
    gold = new( MONEY_DIR + "gold" );       
    gold->set_amount( 60 );
    gold->move( ppl );
    command("chat 恭喜，"+ppl->query("name")+"("+ppl->query("id")+")"+"走镖成功，获得六十两金子的报酬。");
    return 1;
}

void Dest( object obj )
{
       destruct( obj );
}
