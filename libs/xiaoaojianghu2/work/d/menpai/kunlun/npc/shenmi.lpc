// shenmi.c 神秘人
// Ffox 98-4-25 20:47
#ifdef DEBUG_HERE
#undef DEBUG_HERE
#endif

#include <kunlun.h>
inherit NPC;
string why_surprise();
void wait( int waittime )
{
    return;
}
void do_init( object );



void create()
{
    set_name( "神秘人", ({ "shenmi ren", "ren" }) );
    set( "gender", "男性" );
    set( "long", @LONG
只见他脸上蒙着一块黑巾……………………
LONG );
    set( "attitude", "peaceful" );
    set( "inquiry", ([
    "吃惊"     : (:why_surprise:),
    "surprise" : (:why_surprise:),
    ]) );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "只见他往四周看了一看。\n",
        "只见他将手放在了腰间的宝剑上。”\n",
        "神秘人看见了你，目光就凝视着你。。\n",
     }));
    set( "age", 54 );
    set( "per", 30 );
    set_wugong( "liangyi-jian", 120, 120, 1 );
    set_wugong( "yinzhi-bufa", 150, 150, 1 );
    set_wugong( "liangyi-xinfa", 100, 100, 1 );
    set_wugong( "suogu-gong",150,150,1 );
    set_xiuwei( "sword", 5300 );
    set_xiuwei( "dodge", 3201 );
    set( "max_force", 4400 );
    set( "force", 4400 );
    set( "force_factor", 440 );
    set( "combat_exp", 18000000 );
    setup();
//    carry_object( __DIR__"obj/book/suogu-mifa" );
    carry_object( __DIR__"obj/windsword" )->wield();
    carry_object( "/clone/wear/cloth/cloth5" )->wear();
}


void init()
{
    object me=this_player();
    call_out( "do_init", 1, me );
}
void do_init( object me )
{
    if(kl_mark("query",me,"old_man/see_man",1,1)){
       remove_call_out("do_drop");
       call_out("do_drop",1,me);
       }
    if( environment(me)->query("short")!="石屋" ) return;
    if( !kl_mark("query",me,"old_man/see_man",1,1 ) ) return ;
    remove_call_out( "greeting2" );
    call_out( "greeting2", 1, me );
}

void do_drop(object me)
{
    object ob=this_object();
    if(environment(ob)->query("short")=="石屋") return;
    command("xixi "+me->query("id") );
    command("say "+"咱俩算是有缘，我就成全你好了。");
    command("drop sword");
    message_vision("$N呆呆地看着神秘人突然消失了。\n",me);
    destruct(ob);
    return;
}

void greeting2()
{
    object me = this_player();
    object ob = this_object();
    if( kl_mark("query",me,"old_man/see_man",1,1 )==2 ){
        tell_object( me, "这里的主人对你的到来感到很“吃惊”！\n" );
        return;
    }
    if (!ob->query_temp("havegive"))
    if( kl_mark("query",me,"old_man/see_man",1,1 )==3 ){
//        ob->create_family( "昆仑派", 3, "弟子" );
        ob->set( "title", "平民" );
        command( "nod "+me->query("id") );
        message_vision("$N很郑重的递给$n一本武功秘籍。\n",ob,me);
        new(__DIR__"obj/book/suogu-mifa")->move(me);
        ob->set_temp("havegive",1);
        return;
    }
    command( "ah "+me->query("id") );
    kl_mark("set",me,"old_man/see_man", 2, 1 );
    return;
}

string why_surprise()
{
    object me = this_player();
    object ob = this_object();
    if( kl_mark("query",me,"old_man/see_man",1,1)!=2||ob->query("id")=="shen ziyi" ) {
        command("? "+me->query("id") );
        return ("你在说什么？");
      }
    call_out( "i_know_you", 1, me, ob, 0 );
    return( "人老了，怀恋在这里度过的时光，所以隐居于此……" );
}
void i_know_you( object me, object ob , int number )
{
    int i;
    i=number + 1;
    switch( i ) {
    case 1:
    command( "nod "+me->query("id") );
    break;
    case 2:
    message_vision( "只见神秘人将面纱轻轻揭开…………露出脸来。\n",me );
    break;
    case 3:
    write( "哇！这是一张多么和蔼的脸哪！\n" );
    write( "神秘人告诉你道：你知道我是谁么？\n");
    break;
    case 4:
    command( "sigh" );
    break;
    case 5:
    write( "神秘人接着告诉你：我也是昆仑派的人啊！\n");
    break;
    case 6:
    write( "神秘人说：准确说来，我应该是你师父的师兄，你的师伯。\n" );
    break;
    case 7:
    write( "神秘人接着说：因为我喜好游荡江湖，在江湖上行侠仗义，江湖朋友也送我一个外号：\n");
    break;
    case 8:
    write( "              [ 白衣飞剑客 ]，道号：青灵子。\n");
    break;
    case 9:
    command( "think" );
    break;
    case 10:
    write( "神秘人又说：现在的昆仑派也是日日兴旺，我这师弟确实是一个人材啊！\n");
    break;
    case 11:
    write( "神秘人说：这几年里面，我潜心钻研了了一门技艺：[ 缩骨功 ]，我和你有缘。\n");
    break;
    case 12:
    write( "          就传授于你好了，希望将来有所用途。\n" );
    break;
    case 13:
    command( "give book to "+me->query("id") );
    break;
    case 14:
    write( "神秘人以沉重的口气说到：以后你到这里来的时候，我还是依然蒙面，\n");
    break;
    case 15:
    write( "                        我在昆仑附近的事情不要让别的人知道！\n");
    break;
    default:
    set_name( "沈子伊", ({ "shen ziyi", "ziyi", "shen" }) );
    create_family( "昆仑派", 3, "弟子" );
    set( "title", WHT"白衣"YEL"飞"NOR"剑客" );
    set( "long", @LONG
一代隐侠！人称：青灵子。
LONG );
    kl_mark( "set", me, "old_man/see_man", 3, 1 );
//    me->set( "locker/suogu",1);
    log_file( "kl_suogu-gong",me->query("name")+"("+geteuid(me)+")奇遇沈子伊，开始学习缩骨功！\n" );
    return;
    }
    call_out( "i_know_you", 2, me, ob, i );
    return;
}


int valid_teach( object ppl, string skill )
{
    if( kl_mark( "query", ppl, "old_man/see_man", 1, 1 ) < 3 )
   {
        command( "say “你想学功夫？”" );
       return 0;
    }

    if ( skill != "suogu-gong" )
    {
        command( "say “这些功夫嘛，你应该向师父好好学习 。”" );
        return 0;
    }
    return 1; 
}

int zhongcheng( object ppl, string skill )  //不检查忠诚度
{
    return 1;
}
