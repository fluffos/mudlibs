#include "kl_p.h"



void create()
{
    set_name( "女弟子", ({ "di zi", "dizi" }) );
    create_family("昆仑派", 4, "弟子");
    set( "title", "昆仑派第四代弟子" );
    set( "long", @LONG
昆仑派门下弟子，在昆仑派里成为一名弟子，的确是一件自豪的事情。他们一个
个显得英姿勃发，看来功夫也必定不低的了。
LONG );
    set( "gender", "女性" );
    set( "age", 20 );
    set( "attitude", "peaceful" );
    set( "inquiry", ([
        "此地" : (:about_here:),
    ]) );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "女弟子嘻嘻地笑了两声，很高兴的样子。\n",
        "女弟子摆开架势，练起了剑法。\n",
        "女弟子练起了轻功，身态很是优美。\n",
     }));
    set_wugong( "kunwu-jian", 100, 100, 1 );
    set_wugong( "baihe-quan", 100, 100, 1 );
    set_wugong( "kunlun-bu", 100, 100, 1 );
    set_wugong( "liangyi-xinfa", 50, 50, 1 );
    set_xiuwei( "sword", 1101+random(230) );
    set_xiuwei( "dodge", 1101+random(230) );
    set_xiuwei( "unarmed", 1100 );
    set( "max_force", 1000 );
    set( "force", 1000 );
    set( "force_factor", 50 );
    set( "combat_exp", 80000 );
    setup();
    carry_object( "/clone/wear/cloth/cloth1" )->wear();
    carry_object( "/clone/weapon/sword/changjian" )->wield();
}
void init()
{
    call_out("greeting",1,this_player());
}
int valid_teach( object ppl, string skill )
{
    return 0;
