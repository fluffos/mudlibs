inherit NPC;


void create() {
  set_name("陌生剑客", ({ "jian ke", "guest", "ke" }));
  set("long", @LONG
陌生人，不知他具体是从何处来的，从服饰和打扮来看，是中原人氏，到昆仑这
边是来作什么的呢？前一段时间掌门人亲自将他带了回来，不许大家问，只是让
大家好生款待就是了。就因其如此，才显得这人有些奇怪。身边随身还有一把琴
、一只箫，没事常见他摆弄几下，好生让人捉摸不透。
LONG);
  set("gender", "男性");
  set("attitude", "peaceful");
  set("age", 24);
  set("per", 30);
  set("chat_chance", 5);
  set("chat_msg", ({
    "陌生剑客摸了摸身上的宝剑，沉思不语。\n",
    "陌生剑客从身边拿出一只箫，呜呜地吹了起来···\n",
    "陌生剑客爱惜地将刚才用过的一把琴包好，收了起来。\n",
  }));

  set_wugong("kunwu-jian", 120, 120, 1);
  set_wugong("xuanzhu-jian", 120, 120, 1);
  set_wugong("kunlun-bu", 120, 120, 1);
  set_wugong("yinzhi-bufa", 150, 150, 1);
  set_wugong("taixuan-xinjing", 100, 100, 1);
  set_wugong("literate", 150, 150, 0);
  set_xiuwei("sword", 2500);
  set_xiuwei("dodge", 2500);
  set("max_force", 2400);
  set("force", 2400);
  set("force_factor", 240);
  set("combat_exp", 400000);
  setup();
  carry_object("/clone/weapon/sword/sword1")->wield();
  carry_object("/clone/wear/cloth/cloth5")->wear();
}
