// yahuan  丫鬟
// Ffox 98-4-25 19:25

#include "kl_p.h"

string give_zhenxian();



void create()
{
    set_name( "丫鬟", ({ "ya huan", "huan" }) );
    set( "title", "昆仑派" );
    set( "gender", "女性" );
    set( "age", 16 );
    set( "per", 20 );
    set( "attitude", "peaceful" );
    set( "inquiry", ([
    "此地" : (:about_here:),
    "针线" : (: give_zhenxian :),
]) );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "丫鬟看你来了，抬头看了看，笑了一笑。\n",
        "丫鬟低头做起了自己的针线活！”\n",
        "丫鬟拿起了绣花针，将一根绿线穿了过去。\n",
     }));
    set_wugong( "kunwu-jian", 100, 100, 1 );
    set_wugong( "baihe-quan", 100, 100, 1 );
    set_wugong( "kunlun-bu", 100, 100, 1 );
    set_wugong( "liangyi-xinfa", 50, 50, 1 );
    set_wugong( "literate", 130, 130, 0 );
    set_xiuwei( "sword", 1700 );
    set_xiuwei( "dodge", 1100 );
    set_xiuwei( "unarmed", 1100 );
    set( "max_force", 1000 );
    set( "force", 1000 );
    set( "force_factor", 100 );
    set( "combat_exp", 80000 );
    set( "needle", 5 );
    setup();
    carry_object( "/clone/wear/cloth/cloth1" )->wear();
}

string give_zhenxian()
{
    object me=this_player();
    if(!kl_dizi(me))
       return ("我们女孩儿家用的东西，怎么好随便给你呢？");
    if( !query("needle") )
        return ("已经被别人要完了。");
    new(__DIR__"obj/needle")->move(me);
    add( "needle", -1 );
    if(kl_mark("query",me,"woshi/give_needle",0,0) ){
      command("xixi "+me->query( "id" ) );
      return ("刚才不是给了你一根针了么？怎么老来要啊？");
      }
    message_vision("丫鬟从荷包里面拈出一根针，给了$N。\n",me);
    kl_mark("set",me,"woshi/give_needle", 1 ,0 );
    return ( "你拿去用好了。" );
}

void init()
{
    call_out("greeting",1,this_player());
}