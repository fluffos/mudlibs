#include "kl_p.h"



void create() {
  set_name("老王", ({ "lao wang", "wang" }));
  set("gender", "男性");
  create_family("昆仑派", 3, "弟子");
  set("title", WHT "昆仑派" HIR "副总管" NOR);
  set("age", 54);
  set("long", @LONG
他和老刘一样，是掌门人现在的好兄弟。象昆仑这样的一个门派，总得有些人来
支撑，老王就是这样的人，他自己默默无闻，但却视昆仑派的荣辱为他自己的荣
辱。
LONG);
  set("attitude", "peaceful");
  set("positive_score", 8000);
  set("per", 15);
  set("str", 50);
  set("int", 50);
  set("inquiry", ([
    "此地": (: about_here :),
  ]));
  set("chat_chance", 5);
  set("chat_msg", ({
    "老王再墙角拿出一把剑，擦拭了几下。\n",
    "老王很机警地看了看周围。\n",
    "老王看了看你，让你不要老呆再这里。\n",
  }));
  set_wugong("kunwu-jian", 120, 120, 1);
  set_wugong("xuanzhu-jian", 120, 120, 1);
  set_wugong("liangyi-jian", 120, 120, 1);
  set_wugong("baihe-quan", 120, 120, 1);
  set_wugong("panheng-zhang", 120, 120, 1);
  set_wugong("kunlun-bu", 120, 120, 1);
  set_wugong("yinzhi-bufa", 120, 120, 1);
  set_wugong("liangyi-xinfa", 120, 120, 1);
  set_wugong("literate", 120, 120, 0);
  set_xiuwei("sword", 5300);
  set_xiuwei("dodge", 2700);
  set_xiuwei("unarmed", 2700);
  set("max_force", 2400);
  set("force", 2400);
  set("force_factor", 240);
  set("combat_exp", 10000000);

  setup();
  carry_object("/clone/wear/cloth/cloth7")->wear();
  carry_object("/clone/weapon/sword/sword1")->wield();
}
void init() {
  call_out("greeting", 1, this_player());
}
