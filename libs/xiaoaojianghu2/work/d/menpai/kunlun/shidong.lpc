// shidong 石洞
// Ffox 96-5-14 14:05

#include "kl_r.h"
#define BK __DIR__"juebi"
#define FT __DIR__"cuigu"
string look_front();
string look_back();
void no_enter();
void restore_ffox();



void create()
{
    set("short","石洞");
    set("long",@LONG
一个黑忽忽的石洞，刚好可以容一个人的大小，什么也看不清楚……
LONG 
);
    set("item_desc", ([
    "front" : (: look_front :),
    "back"  : (: look_back :),
]) );
    set("no_fight", 1);
    set("not_startroom",1);
    set("exits",
    ([
        "front" : __FILE__,
        "back"  : __FILE__,
        ]));
    setup();
}

void reset()
{
    return;
}

void init()
{
    object me = this_player();
    kl_mark("set",me,"hole/checking",1,0);
    call_out( "check",1,me );
}

void check()
{
    int point,lv;
    object me = this_player();
/*    if(!kl_mark("query",me,"hole/enterhole",0,0)||me->query_jibie("suogu-gong")<10){
        write("你怎么可能进来呢？\n");
        me->die();
        return;
      }
*/    point = kl_mark( "query",me,"hole/where",0,0 );
    lv = me ->query_jibie( "suogu-gong" );
    if( lv<150 ) write(HIR"你只感觉胸口越来越闷得慌……\n"NOR);
    if( lv<30 && point >0 ) { call_out( "no_enter",1,me );  return; }
    if( lv<60 && point >1 ) { call_out( "no_enter",1,me );  return; }
    if( lv<90 && point >2 ) { call_out( "no_enter",1,me );  return; }
    if( lv<120 && point >3 ) { call_out( "no_enter",1,me );  return; }
    if( lv<150 && point >4 ) { call_out( "no_enter",1,me );  return; }
    kl_mark( "delete",me,"hole/checking",0,0 );
    return;
}

void no_enter()
{
    object me = this_player();
    kl_mark( "delete",me,"hole/checking",0,0 );
    tell_object( me, "你的不太熟练的缩骨功好象不太够用了。\n" );
    tell_object( me, HIR"你再也不能再支撑下去了……………\n"NOR );
    tell_object( me, "不可以再往前了。\n" );
    me->receive_damage( "kee", 500 );
    me->uncouncise();
}

int valid_leave( object me, string dir )
{
    if(kl_mark("query",me,"hole/checking",0,0)) 
        return notify_fail( BLU"不要急，慢慢地来………\n"NOR );
    if(kl_mark("query",me,"hole/where",0,0)==5) write( YEL"你眼前出现一点亮光！\n"NOR );
    if(kl_mark("query",me,"hole/back",0,0)){
        if(dir=="front") {
            kl_mark("add",me,"hole/where",1,0);
            write("你憋足力气往前又爬了一步。\n");
            }
        if(dir=="back") {
            if(kl_mark("query",me,"hole/where",0,0)>2)
            return notify_fail("你再也难以找到着力处…\n");
            kl_mark("add",me,"hole/where",-1,0);
            write("你磨磨蹭蹭地往后挪了一步。\n");
            }
        if(kl_mark("query",me,"hole/where",0,0)<1) {
            me->move( FT );
            restore_ffox();
            return notify_fail("你又回到了翠谷…\n");
          }
        if(kl_mark("query",me,"hole/where",0,0)>5) {
            me->move( BK );
            restore_ffox();
            return notify_fail("你终于爬出了石洞！\n");
          }
    return ::valid_leave(me,dir);
      }

        if(dir=="front") {
            kl_mark("add",me,"hole/where",1,0);
            write("你憋足力气往前又爬了一步。\n");
            }
        if(dir=="back") {
            if(kl_mark("query",me,"hole/where",0,0)>2)
            return notify_fail("你再也难以找到着力处…\n");
            kl_mark("add",me,"hole/where",-1,0);
            write("你磨磨蹭蹭地往后挪了一步。\n");
            }
        if(kl_mark("query",me,"hole/where",0,0)<1) {
            me->move( BK );
            restore_ffox();
            return notify_fail("你终于还是退了出来…\n");
          }
        if(kl_mark("query",me,"hole/where",0,0)>5) {
            me->move( FT );
            restore_ffox();
            return notify_fail("你爬出了石洞！到达了什么地方呢？？\n");
          }
    return ::valid_leave(me,dir);
}

string look_front()
{
    return ("黑忽忽的一个石洞，不知道怎么样才能到达尽头……\n");
}

string look_back()
{
    tell_object( this_player(),WHT"往后看实在是不方便，这么一方寸之地，你还想转身么？\n"NOR );
    return ( "什么也看不见。\n" );
}

void restore_ffox()
{
    object me = this_player();
    kl_mark("delete",me,"hole",0,0);
}
