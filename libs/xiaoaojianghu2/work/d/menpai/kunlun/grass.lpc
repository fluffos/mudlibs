#include "kl_r.h"

string do_look();



void create()
{
    set( "short", GRN"草坪"NOR );
    set( "long", @LONG
一块宽阔的草坪，草丛中不时传来昆虫的鸣叫声，声声入耳，也不时有些小
虫从草丛中间跳出来，与山外的世界比起来，这里恍如隔世。这里就可以说是到
了昆仑派所在的山坳了。西边是通往山坳外的小路，南面是上山的山道，北边是
也是一条小路，东边看去，就是一个巨大的庄院。
LONG );
    set( "kunlun/water", 1 );
    set( "item_desc", ([
    "东边" : (: do_look :),
    "east" : (: do_look :),
]) );
    add( "search_things", ([
    "草丛" : __DIR__"obj/chongcao",
]) );
    set( "exits", ([ /* sizeof() == 4 */
    "west" : __DIR__"xiaojing",
    "north" : __DIR__"xiaolu01",
    "east" : __DIR__"damen",
    "southup" : __DIR__"shandao01",
]) );
    set( "outdoors", "kunlun" );
    setup();
}

string do_look()
{
    object me=this_player();
    message_vision( BLU"$N向东边久久的凝视，好象被什么吸引住了。\n"NOR, me);
    return(@TEXT

