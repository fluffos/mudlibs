#include <ansi.h>
#include <room.h>
inherit ROOM;


void create() {
  set("short", YEL "霜雪阁" NOR);
  set("long", @LONG
这里是昆仑派为了提供弟子相互切磋学习的练功房，白鹿子
专门培养了一批侍女用于陪昆仑弟子练功，昆仑弟子可以在这
里请(qing shinv)陪自己练功，不过如果要离开的话，千万不
要忘记(qing hui)请侍女姐姐回房休息，注意礼貌啊。
LONG
  );
  set("exits", ([
    "out": "/d/menpai/kunlun/liange",
  ]));
  set("not_startroom", 1);
  set("no_quit", 1);
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_qing", "qing");
  add_action("do_exert", "exert");
  add_action("do_kill", "kill");
  add_action("do_bihua", "bihua");
  add_action("do_fight", "fight");
}

int do_exert(string arg) {
  if (strsrch(arg, "roar") == -1)
    if (strsrch(arg, "xiao") == -1) {
      return 0;

    } else {
      write("在昆仑派撒野？小心白鹿子不放过你哦！！\n");
      return 1;
    }
}

int do_kill(string arg) {
  if (arg == "shi" || arg == "nv" || arg == "shi nv") {
    write("在昆仑派撒野？小心白鹿子不放过你哦！！！\n");
    return 1;
  } else {
    write("在昆仑派撒野？小心白鹿子不放过你哦！！！\n");
    return 1;
  }
}

int do_bihua(string arg) {
  if (arg == "shi" || arg == "nv" || arg == "shi nv") {
    write("在昆仑派撒野？小心白鹿子不放过你哦！！！\n");
    return 1;
  } else {
    write("在昆仑派撒野？小心白鹿子不放过你哦！！！\n");
    return 1;
  }
}

int do_fight(string arg) {
  if (arg == "shi" || arg == "nv" || arg == "shi nv") {
    write("在昆仑派撒野？小心白鹿子不放过你哦！！！\n");
    return 1;
  } else {
    write("在昆仑派撒野？小心白鹿子不放过你哦！！！\n");
    return 1;
  }
}

int do_qing(string arg) {
  object me, env, npc;
  string mesg;
  object *obnpc;
  int idx;
  me = this_player();
  env = this_object();
  mesg = query("pei_owner");
  if (!arg || arg == "") {
    write("你要干什么？\n");
    return 1;
  }
  if (me->query("marks/昆仑/陪练B") > 0)
    return notify_fail("你已经在其它阁里请了陪练侍女了啊，不需要再请了吧！！！\n");
  if (me->query("marks/昆仑/陪练C") > 0)
    return notify_fail("你已经在其它阁里请了陪练侍女了啊，不需要再请了吧！！！\n");
  if (me->query_temp("will_quit"))
    return notify_fail("你不是要退出了么，不需要请陪练侍女了吧！！！\n");
  if (mesg && (arg == "hui") && (mesg == me->query("id"))) {
    delete("pei_owner");
    add("peilians", -1);
    me->delete("marks/昆仑/陪练A");
    obnpc = all_inventory(env);
    for (idx = 0; idx < sizeof(obnpc); idx++) {
      if (!objectp(obnpc[idx]))
        continue;
      if (userp(obnpc[idx]))
        continue;
      destruct(obnpc[idx]);
      message_vision("$N恭请侍女姐姐回房休息。\n", me);
    }
    return 1;
  }

  if (me->query("class_score/昆仑派") < 1300) {
    write("你的昆仑派的门忠太低，没资格请阁里的侍女陪练武功！！！\n");
    return 1;
  }

  if (arg == "shinv" && me->query("family/family_name") == "昆仑派") {
    if (query("peilians") == 0) {
      add("peilians", 1);
      me->add("marks/昆仑/陪练A", 1);
      set("pei_owner", me->query("id"));
      message_vision("$N请了一位霜雪阁的侍女姐姐陪练武功。\n", me);
      npc = new(__DIR__ "npc/shinv");
      me->add_temp("peilian", 1);
      me->add("class_score/昆仑派", -1 * me->query("class_score/昆仑派") / 100);
      npc->move(this_object());
      return 1;
    }
    if (query("peilians") >= 1) {
      if (mesg == me->query("id")) {
        message_vision("$N请了一位霜雪阁的侍女姐姐陪练武功。\n", me);
        npc = new(__DIR__ "npc/shinv");
        me->add_temp("peilian", 1);
        me->add("class_score/昆仑派", -1 * me->query("class_score/昆仑派") / 100);
        npc->move(this_object());
        return 1;
      } else {
        write("这里已经有人在练功了！\n");
        return 1;
      }
    } else {
      write("昆仑派的侍女不陪外人练武！！！！！\n");
      return 1;
    }
  }
}
