inherit ROAD;


void create()
{
    set( "short", "小径" );
    set( "long", @LONG
山坳里微风习习，让人心旷神怡，在这里仿佛置身于一个与外界完全隔绝的
世外桃源。四周的山野空旷，远方的雪山显得纯洁无暇。是如此的灿烂，微风中
送来一股青草的香味，向东看去，是一块青色的草坪。往西是一片很大的竹林。
LONG );
    set( "no_clean_up", 0 );
    set( "exits", ([ /* sizeof() == 2 */
    "northwest" : __DIR__"zhulin2",
//    "west" : __DIR__"xiaodao01",
    "east" : __DIR__"grass",
 //   "south" : __DIR__"dangpu",
    ]) );
    setup();
}

int valid_leave(object me,string dir)
{
    object zhulin2;
    if(dir=="northwest") {
        zhulin2 = new(__DIR__"zhulin2");
        tell_room( environment(me),me->query("name")+"往西北方向走去。\n",me);
        me->move(zhulin2);
        return notify_fail("你走入了一片青翠的竹林。\n");
    }
    return 1;
}


