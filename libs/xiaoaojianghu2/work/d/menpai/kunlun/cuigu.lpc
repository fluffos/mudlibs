}

int valid_leave( object me, string dir )
{
    if(dir=="enter"){
        if( objectp( present( "gujian jue", me ) ) )
            return notify_fail( HIR"你突然想起来，还是不要将书带出这里的好。\n"NOR );
        kl_mark("set",me,"hole/enterhole",1,0);
        kl_mark("set",me,"hole/back",1,0);
      }
    return ::valid_leave(me,dir);
}
