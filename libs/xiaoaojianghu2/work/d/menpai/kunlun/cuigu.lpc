{
    object me = this_player();
//    if( me->query_jibie("suogu-gong") < 150 ){
//        write( HIC"你还在想着来到这里的历程！\n"NOR );
 //       write( HIY"突然你有一种说不出来的恐惧！\n"NOR );
 //       me->die();
