#include "kl_r.h"



void create()
{
	set("short","翠谷");
	set("long",@LONG
闭著眼定一定神，再睁开眼来，面前竟是个花团锦簇的翠谷，红花绿树，交
相掩映。脚下踏著的是柔软细草，鼻中闻到的是清幽花香，鸣禽间关，鲜果悬枝
，哪想得到在这黑黝黝的洞穴之后，竟会有这样一个洞天福地？在山壁上有一山
洞，离地竟然不过丈许。
LONG );
	set("exits", ([
    	"enter" : __DIR__"shidong",
        "north" : __DIR__"cuigu2",
         ]));
        set("outdoors","kunlun");
        setup();
}

