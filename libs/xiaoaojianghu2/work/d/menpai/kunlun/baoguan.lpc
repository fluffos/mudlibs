#include "kl_r.h"

string sign();


void create()
{
    set( "short", "保管室" );
    set( "long", @LONG
昆仑派的保管室，在这里，可以将自己的东西保管起来，对本门弟子是免费
的，而对别派的就要收取合理的手续费。有时东西带在身上总是不便，所以保管
就成了一个很好的方法。一个很大的柜台，柜台上压着张告示(sign)，总管老刘
在后面笑眯眯的看着你，一副很随和的样子。
LONG );
    set( "item_desc", ([
    "sign" : (: sign :),
]) );
    set( "no_clean_up", 0);
    set( "exits", ([ /* sizeof() == 2 */
    "east" : __DIR__"langdao01",
    "south" : __DIR__"dating",
]) );
    set( "objects", ([
    __DIR__"npc/liu" : 1,
]) );

    setup();
}

string sign()
{
    return(YEL"    现在还不能保存任何东西，抱歉！\n"NOR );
}

int valid_leave(object me,string dir)
{
    if(dir=="east"){
     if( !kl_dizi( me ) ) {
        if(present("lao liu",environment(me) ) ) {
          message_vision("老刘对$N喊道：里面是昆仑派的内室，请不要随便闯入。\n",me);
          return notify_fail("你被老刘给拦住了。\n");
          }
        }
     }
    return ::valid_leave(me,dir);
}