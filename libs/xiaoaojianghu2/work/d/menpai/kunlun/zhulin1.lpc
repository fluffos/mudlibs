#include "kl_r.h"
string do_dir();
string  *leave =({
    "west", "north", "northwest", "southwest",
    "northeast", "southeast", "south", "east", });

void create()
{
    set( "short", GRN"竹林"NOR );
    set( "long", @LONG
一片茂密的竹林，其势足有三四人高，走来走去，俱是成簇成垄的青竹，置
身其间，只感到散漫清朗，纤巧清秀，竹荫浓郁，使得幽谷更加清幽。
LONG );
    set( "no_clean_up", 0 );
    set( "exits", ([ 
    "southeast" : __DIR__"zhulin2",
    "northwest" : __DIR__"zhulin",

]) );
/*
    set("item_desc", ([
    "east" : (:do_dir:),
    "west" : (:do_dir:),
    "north" : (:do_dir:),
    "south" : (:do_dir:),
    "southeast" : (:do_dir:),
    "northwest" : (:do_dir:),
    "northeast" : (:do_dir:),
    "southwest" : (:do_dir:),
]) );
*/
    set("not_startroom",1);
    setup();
}

string do_dir()
{
    return(WHT"一片清新幽静的竹林，怎么也看不够！\n"NOR);
}
  
int valid_leave(object me,string dir)
{
    object zhulin2;
    if(dir=="southeast") {
        zhulin2 = new(__DIR__"zhulin2");
        tell_room( environment(me),me->query("name")+"往西北方向走去。\n",me);
        me->move(zhulin2);
        return notify_fail("你走入了另一片青翠的竹林。\n");
    }
    return 1;
}
