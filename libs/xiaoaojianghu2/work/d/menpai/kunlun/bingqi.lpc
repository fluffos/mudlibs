#include "kl_r.h"

// 可以领的东西列表，可以往里面加东西。
string *things=({
    "sword",
});

//判断在列表里面是否有这样东西。
int have_thing(string thing)
{
    int i;
    for( i=0;i<sizeof(things);i++ )
        if(thing==things[i]) return i+1;
    return 0;
}

//告示内容：
string ling_things()
{
    object me = this_player();
    if( !kl_dizi(me) )
       return ( "这是一张昆仑派传达消息的告示。\n" );
    return( YEL"昆仑弟子现在可以从这里领取如下东西：\n"+
        RED"    sword :    钢剑 \n"NOR );
}

// 如果身上已经有了这个id 的物品，就不能再给了，下面判读是否有。
int cannot_give( string thing )
{
    if( present( thing, this_player()) ) return 1;
    return 0;
}


void create()
{
    set( "short", "兵器室" );
    set( "long", @LONG
昆仑派有自己的兵器室，门下弟子可以到这里来领取武器。这里武器很多，
到处堆得是，显得杂乱无章的，管发放武器的老王显然是一个很随便的人。在门
背后贴着一张告示(sign)。
LONG );
    set( "item_desc", ([
    "sign" : (: ling_things :),
]) );
    set( "exits", ([ /* sizeof() == 2 */
    "north" : __DIR__"dating",
    "east" : __DIR__"langdao03",
]) );
    set( "objects", ([
    __DIR__"npc/wang" : 1,
]) );
    setup();
}

void init()
{
    object me = this_player();
    if( kl_dizi(me) )
        add_action( "do_ling", "ling" ); //领物品
}

//领东西
int do_ling(string give_thing)
{
    object me = this_player();
    object wang, sword;
//  object give_money;
    int what;
//  object dengji;
    wang = present( "lao wang", environment( me ) );
    if ( !objectp( wang ) ) 
        return notify_fail( "呵呵！现在老王不在的说，你向谁去领东东噢？\n" );
    if ( !wang->can_act() || wang->is_fighting() || wang->is_duilianing() ){
        message_vision( "老王对$N叫道：没有看见我正忙着吗？\n", me );
        return 1;
        }
    if ( !me->can_act() || me->is_fighting() || me->is_duilianing() )
        return notify_fail( "你还是先将你手中的活放下，再去领东西吧。\n" );
    if ( !give_thing ) return notify_fail( "你要领什么东西？\n" );
    if ( !(what=have_thing(give_thing)) ) return notify_fail( "没有这样东西可领。\n" );
    if ( cannot_give( give_thing ) ) {
        message_vision( "老王无奈地对$N摇了摇头。叹道：真是贪得无厌那！\n", me );
        return 1;
        }
    switch (what){
    case 1:
        message_vision( "老王小心翼翼地打开角落里的一个箱子，翻出一把剑，递给了$N。\n", me );
        sword = new( __DIR__"obj/sword" );
        sword->set("owner", me->query( "id" ) );
        sword->set( "long" , "这是一柄"WHT"昆仑派"NOR"特制的精钢剑，只有"+
              WHT"昆仑派"YEL+this_player()->query("name")+""NOR+"才能使用。\n");
        sword -> move( me );    
        message_vision( "老王对$N告诫：“"+RED"剑在人在·剑去人亡"NOR+"”，记住啦！\n", me );
        break;
    default:
       message_vision( "老王对$N嘟噜道：这样东西现在不能领了！\n", me );
    }
    return 1;
}

int valid_leave(object me,string dir)
{
    if(dir=="east"){
     if(!kl_dizi(me)){
        if(present("lao wang",environment(me) ) ) {
          message_vision("老王对$N喊道：里面是昆仑派的内室，请不要随便闯入。\n",me);
          return notify_fail("你被老王给拦住了。\n");
          }
        }
     }
    return ::valid_leave(me,dir);
}