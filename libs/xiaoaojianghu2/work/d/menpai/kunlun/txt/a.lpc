#include <ansi.h>
inherit ROOM;


void create()
{
set( "short", "short" );
set( "long", "\n\n\n\n" );
setup();
}
void init()
{
object me = this_player();
me->set("env/msg_mout","\n只见"+RED+"风雨如晦"+NOR+
"，飞狐心有所感，当下腰悬"+GRN+"木剑"+NOR+
"，身披"+CYN+"敝袍，\n"+NOR+
"        悄然西去，自此足迹所至，踏遍了中原江南之地。 \n");
me->set("env/msg_min","\n");
return;
}
