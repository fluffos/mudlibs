#include "kl_r.h"



void create()
{
    set( "short", "回廊" );
    set( "long", @LONG
一道回廊，在练武场的周围，供人行走方便。回廊是木质结构，雕花栏杆，
很有特色，显现得很有气派的样子。回廊里会不时有弟子走过，大家都在忙着自
己的事情，行色匆匆，没有人来和你说话，这也显得昆仑派对本派弟子的严格要
求。
LONG );
    set( "exits", ([ /* sizeof() == 3 */
    "north" : __DIR__"wuchang",
    "south" : __DIR__"nansleep",
    "east" : __DIR__"huilang04",
]) );
    setup();
}

int valid_leave(object me,string dir)
{
    if( dir=="south" ) 
        if( me->query( "gender" )!= "男性" )
        return notify_fail( "你进那儿作什么，也不怕被调戏？\n" );
    return ::valid_leave( me,dir );
}