#include "kl_r.h"



void create()
{
    set( "short", "后花园" );
    set( "long", @LONG
一阵儿浓，一阵儿淡的花香，引着人们往前走，这里是一片青天，一团一团
，一组一组，有多少种颜色，有多少花啊！红艳艳的山丹，娇黄的金钟儿，白玉
般的蔷薇，粉妆的二度梅，雅淡的西府海棠，香味浓郁的月桂，苍翠的棕竹，墨
紫的红叶……………哇，这里竟然有这么多的花！
LONG );
    set( "exits", ([ /* sizeof() == 3 */
    "southeast" : __DIR__"shupu",
    "west" : __DIR__"xiaolu02",
    "north" : __DIR__"cemen",
]) );
    set("woods",1);

    set( "outdoors", "kunlun" );
    setup();
}

void init()
{
    add_action("zhai_juhua","zhai");
    add_action("tear_muer","tear");
    add_action("cai_mogu","cai");
    
}

int zhai_juhua(string str)
{
    object me = this_player();
    if(str!="菊花"&&str!="juhua")
      return notify_fail("你要摘什么？\n");
    if(me->query("sen")<10||me->query("gin")<10)
      return notify_fail("你现在累得很，还是休息一下的好。\n");
    me->add("sen",-50);
    me->add("gin",-50);
    message_vision("$N在花丛中寻寻觅觅————\n",me);
    if(query("juhua")>3) 
      return notify_fail("这里的菊花都被摘完了。\n");
    if(kl_mark("query",me,"kunlun_work/object_name",1,1)!="菊花" && random(8)!=0)
      return notify_fail("你什么也没有发现！\n");
    new(__DIR__"obj/juhua")->move(me);
    add("juhua",1);
    message_vision("$N摘下一朵菊花！\n",me);
    return 1;
}
int tear_muer(string str)
{
    object me = this_player();
    if(str!="木耳"&&str!="muer")
      return notify_fail("你要找什么？\n");
    if(me->query("sen")<10||me->query("gin")<10)
      return notify_fail("你现在累得很，还是休息一下的好。\n");
    me->add("sen",-20);
    me->add("gin",-20);
    message_vision("$N在树丛中寻寻觅觅————\n",me);
    if(!random(10)||random(me->query_kar())>25)
    {
    	write("你什么也没有发现！\n");
    	return 1;
    	}
    new(__DIR__"obj/muer")->move(me);
    message_vision("$N撕下一片木耳！\n",me);
    return 1;
}
int cai_mogu(string str)
{
    object me = this_player();
    if(str!="蘑菇花"&&str!="mogu")
      return notify_fail("你要采什么？\n");
    if(me->query("sen")<10||me->query("gin")<10)
      return notify_fail("你现在累得很，还是休息一下的好。\n");
    me->add("sen",-10);
    me->add("gin",-10);
    message_vision("$N在草丛中寻寻觅觅————\n",me);
    if(!random(8)||random(me->query_kar())>20)
    {
    	write("你什么也没有发现！\n");
    	return 1;
    	}
    if (random(2))
   { new(__DIR__"obj/mogu1")->move(me);
    message_vision("$N采到一个新鲜的红蘑菇！\n",me);
   }
    else
   { new(__DIR__"obj/mogu2")->move(me);
    message_vision("$N采到一个新鲜的青蘑菇！\n",me);
    }
    return 1;
}