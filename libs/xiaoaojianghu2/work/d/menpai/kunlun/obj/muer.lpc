#include "kl_o.h"



void create()
{
    set_name( "木耳", ({ "mu er","muer" }) );
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set( "unit", "丛" );
        set( "long", "一丛新鲜的木耳，做菜很好吃的哦。\n");
        set( "value", 100);
    }
    setup();
}
