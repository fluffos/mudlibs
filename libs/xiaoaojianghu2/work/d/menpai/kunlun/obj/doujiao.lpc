#include "kl_o.h"
inherit F_FOOD;



void create()
{
    set_name("豆角", ({"doujiao" }) );
    set_weight(20);//一两
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "串");
        set("value", 15);
        set("food_remaining", 1);
        set("food_supply", 10);
         
    }
    setup();
}
