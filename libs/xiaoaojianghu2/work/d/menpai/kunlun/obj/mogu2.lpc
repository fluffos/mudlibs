#include "kl_o.h"



void create()
{
    set_name( CYN"青"NOR"蘑菇", ({ "mo gu","mogu", }) );
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set( "unit", "朵" );
        set( "long", "一朵"CYN"青"NOR"蘑菇，不知道有毒无毒。\n");
    }
    setup();
}
