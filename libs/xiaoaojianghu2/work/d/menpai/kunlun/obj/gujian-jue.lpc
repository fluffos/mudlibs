// gujian-jue.c
// ffox 98-5-17 11:40

#include "kl_o.h"
string look_book();



void create()
{
    set_name("古剑决", ({ "gujian jue", "gujian", "book" }));
    set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("unit", "本");
        set("long",	(:look_book:) );
        set("value", 10000);
        set("no_get",1);
        set("no_drop",1);
        set("no_give",1);
        set("material", "paper");
       set("skill", ([
            // 提高的 技能的名字
			"name"             :  "daya-jian",  
            // 该 player 的 xiuwei 必须大于 xiuwei_required  
    		"xiuwei_required"  : 3000,
            // 该 player 的 literate 必须大于 literate_required 
            // 否则读不懂
		"literate_required": 140,
            // 每次耗的精神 
        	"gin_cost"         : 40+random(10),
            // 能读到的最高的jibie
			"max_jibie"        : 150,
            // 如果这本书是涨 jilei 的 那么不再判断领悟比是否小于 < 90
            // 否则 就当 领悟比 < 90 必须去练了
            "bonus_jilei"      : 0,
            // 每次获得的xiuwei 
            "bonus_xiuwei"     : 10,
            // 最高可能获得的修为，就是当PLAYER的修为大于max_xiuwei
            // 就不能再涨修为了
            "max_xiuwei"       : 8700,
            // 以下是涨combat_exp 和 social_exp 和修为类似
            "bonus_combat_exp" : 10,
            "max_combat_exp"   : 500000,
            "bonus_social_exp" : 10,
            "max_social_exp"   : 40000,
		]) );
	}
}

string look_book()
{
    string hehe="";
    hehe+=WHT"          ┏━━━━┓\n"NOR;
    hehe+=WHT"          ┃      □┃\n"NOR;
    hehe+=WHT"          ┃ "YEL"古"WHT"   □┃\n"NOR;
    hehe+=WHT"          ┃ "YEL"剑"WHT"   □┃\n"NOR;
    hehe+=WHT"          ┃ "YEL"诀"WHT"   □┃\n"NOR;
    hehe+=WHT"          ┃      □┃\n"NOR;
    hehe+=WHT"          ┃      □┃\n"NOR;
    hehe+=WHT"          ┗━━━━┛\n"NOR;
    hehe+="     从年代久远来看，乃是上古年间所著，书中记载的是久已\n";
    hehe+="     绝传的《大雅古剑法》，著者自称为[ "BLU"卷阿氏"NOR" ]，其号不\n";
    hehe+="     可考。书中称：得此书者，万不可携带此书离开此谷，以\n";
    hehe+="     免造成无穷之"HIR"杀劫"NOR"……\n";
    hehe+="     书云：可以在得书处将书藏回原处[ hide_book ]。\n";
    return hehe;
}