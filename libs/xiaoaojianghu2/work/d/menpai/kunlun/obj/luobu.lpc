#include "kl_o.h"
inherit F_FOOD;



void create()
{
    set_name("萝卜", ({"luo bu","luobu" }) );
    set_weight(50);//一两
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "个");
        set("value", 20);
        set("food_remaining", 2);
        set("food_supply", 10);
         
    }
    setup();
}
