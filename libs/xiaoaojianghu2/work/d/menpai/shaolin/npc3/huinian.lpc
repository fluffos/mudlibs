#include <ansi.h>

inherit __DIR__ "hui.lpc";
inherit F_MASTER;




void create() {
  seteuid(getuid());
  set_name("慧念", ({ "hui nian", "nian", "hui", "bonze" }));
  set("long", @LONG
少林龙树院的慧念师傅。他是慧字辈中年龄最老的，内力最高的一
位了。他座下的弟子也都以内力高著称。
LONG
  );
  set("title", RED "少林寺" BLU "龙树院" HIW "武僧" NOR);
  set("gender", "男性");
  set("age", 62);
  set("class", "bonze");

  set("str", 35);
  set("int", 24);
  set("spi", 30);
  set("con", 34);

  set("force", 2700);
  set("max_force", 2700);
  set("force_factor", 80);
  set("kee", 1500);
  set("max_kee", 1500);

  set_wugong("buddhism", 100, 100, 0);
  set_wugong("wuding-zhi", 100, 100, 1);      //大智无定指 5
  set_wugong("duoluoye-zhi", 185, 185, 0);      //多罗叶指 4
  set_wugong("yintuoluo-zhua", 195, 195, 0);      //因陀螺抓 3
  set_wugong("banruo-shenfa", 90, 90, 1);      //般若身法 3
  set_wugong("lianhua-bu", 130, 130, 0);    //莲花步 2
  set_wugong("banruo-xinfa", 135, 135, 0);    //般若心法

  set_wugong("fengyun-jian", 80, 80, 0);
  set_wugong("dahong-quan", 70, 70, 0);

  set_xiuwei_by_type("unarmed", 1500);
  set_xiuwei_by_type("sword", 1000);
  set_xiuwei_by_type("dodge", 1200);
  set_xiuwei_by_type("zonggang", 1000);

  set("combat_exp", 600000);
  set("social_exp", 500000);
  set("positive_score", 32000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", BLU "龙树院" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();

}

#include "hui_master.h";

int lose_bihua(object ppl) {
  if (ppl->query_temp("hydra/shaolin/fight_master") == query("id")) {
    command("smile " + ppl->query("id"));
    command("say 好徒儿，有出息！");
    ppl->set_temp("hydra/shaolin/defeat_master", 1);
    ppl->delete_temp("hydra/shaolin/fight_master");
    command("say 你去找你慧正师叔说吧！");
  }
  return 1;
}
