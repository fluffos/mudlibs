#include <ansi.h>

#define DATING "/d/menpai/shaolin/luohan_zhen/luohan_dating"

inherit __DIR__"xuan.lpc";
inherit F_MASTER;



void create()
{
    seteuid(getuid());
    set_name("玄悲", ({"xuan bei","xuanbei","xuan","bei"}));
    set("long",
        "他是一位慈眉善目的老僧，须眉皆白。\n"
        "他是少林罗汉堂首座玄悲，掌管着众多少林武僧。\n"
    );
    set("title",RED"少林寺"YEL"罗汉堂"HIM"首座"NOR);
    set("rank_info/respect", "玄悲大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze");
    set("family",([
        "title"         :   "罗汉堂长老",
        "generation"    :   36,
        "family_name"   :   "少林派",
        "master_name"   :   "灵门",
        "master_id"     :   "ling men",
        "belong"        :   YEL"罗汉堂"NOR,
        ]) );

    set("age", 70);
    set("str", 34);
    set("int", 29);
    set("con", 35);
    set("spi", 30);
    set("per", 30);

    set("max_kee", 1500);
    set("kee", 1500);
    set("max_sen",1000);
    set("max_gin",1000);

    set("max_force", 4800);
    set("force", 4800);
    set("force_factor", 200);

    set("combat_exp", 8000000);
    set("social_exp", 200000);
    set("class_score", 50000);
    set("positive_score",150000);


    set_wugong("literate", 110,110,0);
    set_wugong("buddhism", 150,150,0);
    set_wugong("xumishan-zhang",180,180,1);    //须弥山掌 6
    set_wugong("weituo-chu",220,220,1);       //韦陀杵 6
    set_wugong("banruo-zhang",250,250,0);      //般若掌 5
    set_wugong("banruo-xinfa",150,150,0);     //般若心法
    set_wugong("jiuyang-gong",185,185,0);       //少林九阳功
    set_wugong("ruying-suixing",180,180,1);     //如影随形 5
    set_wugong("lixue-bufa",180,180,0);         //立雪步法 4


    set_xiuwei_by_type("unarmed",4700);
    set_xiuwei_by_type("long",900);
    set_xiuwei_by_type("dodge",4000);
    set_xiuwei_by_type("zonggang",2000);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

    set("no_kill","shaolin");
	setup();
    carry_object(CLOTH_DIR"jiasha1")->wear();
}

void welcome_visitor( object me)
{
    if( !me->query("hydra/shaolin/havemeet") )
    {    
    if( me->query("hydra/shaolin/闯罗汉阵") )
    {
        if( me->query("hydra/shaolin/闯阵成功") )
        {
            if(environment(me) != environment(this_object()) ) return;
            command("nod "+me->query("id") );
            command("chat "+me->query("name")+"闯过罗汉阵。可喜可贺。");
            command("say 不错！不错！赶快向方丈汇报吧。");
            me->set("hydra/shaolin/havemeet",1);
          me->delete("hydra/shaolin/闯阵成功");
          me->set("locker/passluohan",1) ;
        }
        else
        {
            command("sigh "+me->query("id") );
            command("say 你还要努力啊！");
            me->delete("hydra/shaolin/闯阵失败");
        }
        me->delete("hydra/shaolin/闯罗汉阵");
        delete("hydra/sb_in_luohanzhen");
    }
    }
}

int accept_object( object ppl,object obj )
{
    if( obj->query( "id" ) != "tuijian xin" )
    {
        command("say 多谢了，不过这东西贫僧不需要。");
        return 0;
    }
    if( query("hydra/sb_in_luohanzhen") )
    {
        command("say 现在有人正在过阵，你等一会儿在来吧！");
        return 0;
    }
    command( "say 哦，是一封信！");
    message_vision("$N拆开信阅读了起来。。。\n",this_object());
    remove_call_out("read_letter");
    call_out( "read_letter",1,ppl,obj );
    return 1;
}

void read_letter( object ppl,object obj )
{    
    if( obj->query("chuang_luohan_zhen") != ppl->query("id") )
    {
        command("say 不过这封信推荐的不是你啊？");
    }
    else if ( ppl->query("hydra/shaolin/闯罗汉阵时间")>time()-3600)
    {
    	command("say 你先休息一个钟头吧。");
	}
    else
    {
        command("say 原来是推荐你来闯罗汉阵的。。。");
        message_vision(CYN"$N道：敢闯罗汉阵，勇气可嘉。不过也要小心啊。\n\n"
            YEL"说着，在$n背上轻轻一拍，把$n送到了另外一个地方。\n\n"NOR,
            this_object(),ppl);
        ppl->set("hydra/shaolin/闯罗汉阵时间",time());
        ppl -> set("hydra/shaolin/闯罗汉阵",1);
        ppl -> move( DATING );
        set("hydra/sb_in_luohanzhen",1);
    }    
}    
    

