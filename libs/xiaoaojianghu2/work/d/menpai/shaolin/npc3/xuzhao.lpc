#include <ansi.h>

inherit "/d/menpai/shaolin/npc/xu";



void create() {
  set_name("虚照", ({ "xu zhao", "xu", "zhao", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
虚照是很受方丈赏识的罗汉堂武僧，并不是因为他武功出众，而是因为他做事
一丝不苟，本本份份，寺院里要做什么事，交给他是最放心的。
LONG);
  set("age", 33);

  set("max_force", 800);
  set("force", 800);

  set_wugong("luohan-quan", 100, 100, 1);
  set_wugong("weituo-zhang", 100, 100, 1);
  set_wugong("shaolin-neigong", 60, 60, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);

  set_xiuwei_by_type("unarmed", 250);
  set_xiuwei_by_type("dodge", 301);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}

