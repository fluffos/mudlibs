#include <ansi.h>

inherit F_MASTER;
inherit __DIR__ "hui.lpc";



void create() {
  seteuid(getuid());
  set_name("慧端", ({ "hui duan", "duan", "hui", "bonze" }));
  set("long", @LONG
少林达摩院的师傅，负责教达摩院弟子武功。慧端以其聪慧的天资
赢得了达摩院首座玄难大师的青睐，因而如此年轻就进入了达摩院。
LONG
  );
  set("title", RED "少林寺" MAG "达摩院" HIW "武僧" NOR);
  set("gender", "男性");
  set("age", 35);
  set("class", "bonze");

  set("str", 35);
  set("int", 34);
  set("spi", 30);
  set("con", 34);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);
  set("kee", 1100);
  set("max_kee", 1100);
  set("max_sen", 1000);
  set("sen", 1000);

  set_wugong("buddhism", 80, 80, 0);
  set_wugong("yuanhou-gun", 100, 100, 0);
  set_wugong("fenghuo-gun", 120, 100, 0);
  set_wugong("xiangmo-zhang", 70, 70, 1);
  set_wugong("xiuli-qiankun", 100, 100, 1);      //袖里乾坤 5
  set_wugong("yingzhua-gong", 150, 150, 0);    //鹰爪功 4
  set_wugong("yintuoluo-zhua", 140, 140, 0);      //因陀螺抓 3
  set_wugong("banruo-shenfa", 120, 120, 1);    //般若身法 3
  set_wugong("lianhua-bu", 170, 170, 0);    //莲花步 2
  set_wugong("banruo-xinfa", 110, 110, 0);     //般若心法

  set_xiuwei_by_type("unarmed", 1000);
  set_xiuwei_by_type("dodge", 1900);
  set_xiuwei_by_type("long", 1901);
  set_xiuwei_by_type("zonggang", 1000);

  set("combat_exp", 800000);
  set("social_exp", 500000);
  set("positive_score", 20000);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", MAG "达摩院" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
  carry_object(WEAPON_DIR "long/qimei_gun")->wield();
}

#include "hui_master.h";

int lose_bihua(object ppl) {
  if (ppl->query_temp("hydra/shaolin/fight_master") == query("id")) {
    command("smile " + ppl->query("id"));
    command("say 好徒儿，有出息！");
    ppl->set_temp("hydra/shaolin/defeat_master", 1);
    ppl->delete_temp("hydra/shaolin/fight_master");
    command("say 你去找你慧贞师叔说吧！");
  }
  return 1;
}
