#define HOUYUAN "d/menpai/shaolin/luohan_houyuan"
#include <ansi.h>

inherit __DIR__"xuan.lpc";
inherit F_MASTER;
void destruct_xin( object obj )
{
    destruct( obj );
}



void create()
{
    seteuid(getuid());
    set_name("玄生", ({"xuan sheng","xuansheng","xuan","sheng"}));
    set("long",@LONG
他是一位须眉皆白的老僧，他目光炯炯有神，太阳穴微微突起，显然功夫
极高。他是少林寺罗汉堂的长老，是罗汉堂首座玄悲的得力助手。
LONG   );
    set("title",RED"少林寺"YEL"罗汉堂"HIR"长老"NOR);
    set("rank_info/respect", "玄生大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze");
    set("family",([
        "title"         :"少林寺罗汉堂首座",
        "generation"    :36,
        "family_name"   :"少林派",
        "master_name"   :"灵门",
        "master_id"     :"ling men",
        "belong"        :YEL"罗汉堂"NOR,
        ]) );

    set("age", 64);
    set("str", 35);
    set("int", 34);
    set("con", 32);
    set("per", 24);

    set("max_kee", 1500);
    set("kee", 1500);
    set("max_sen", 1000);
    set("sen",1000);

    set("max_force", 5000);
    set("force", 5000);
    set("force_factor", 200);

    set("combat_exp", 10000000);
    set("social_exp", 400000);
    set("class_score", 200000);
    set("positive_score",130000);
 
    //玄生会六门少林七十二绝技
    set_wugong("buddhism",170,170,0);           //禅宗心法
    set_wugong("jingang-zhang",160,160,1);      //大金刚掌 6
    set_wugong("nianhua-zhi" ,150,150,1);       //拈花指 6
    set_wugong("mohe-zhi"    ,180,180,0);       //摩诃指 5
    set_wugong("banruo-zhang",200,200,0);       //般若掌 5
    set_wugong("ruying-suixing",180,180,0);    //如影随形 5
    set_wugong("yiwei-dujiang",150,150,1);      //一苇渡江 6
    set_wugong("lixue-bufa"     ,208,208,0);    //立雪步法
    set_wugong("banruo-xinfa", 160,160,1);     //般若心法
    set_wugong("jiuyang-gong", 180,180,0);      //少林九阳功
        set("chat_chance_combat", 20);      
        set("chat_msg_combat", ({
        (: SKILL_D("jingang-zhang")->perform_action(this_object(), "jingang-xiansheng") :),
           }) );  

    set_xiuwei_by_type("unarmed",5301);
    set_xiuwei_by_type("dodge",4000);
    set_xiuwei_by_type("zonggang",3000);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

    set("no_kill","shaolin");
    setup();
    carry_object(CLOTH_DIR"jiasha2")->wear();
}

void init()
{
    object me = this_player();
    call_out( "greeting",1,me );
}

void give_letter( object ppl )
{
    object letter,me;
    string lon;
    me = this_object();
    letter = new( __DIR__"obj/letter1" );
    lon = "                    "RED"推荐函"NOR"        \n\n";
    lon += "    "+ppl->query("family/belong")+HIB"弟子"NOR;
    lon += ppl->query("name")+"("+ppl->query("id")+")";
    lon += "已战胜降龙伏虎罗汉，特此证明。\n\n";
    lon += "                "+me->query("title")+"  "+me->query("name");
    letter -> set("long",lon);
    letter -> set("owner",ppl->query("id"));
    letter -> move( ppl );
    ppl -> set("hydra/shaolin/can_apprentice_xuan",1);
    tell_object( ppl,me->query("name")+"给你一封推荐函。\n");
}

void welcome_visitor( object me)
{
    if( me->query("hydra/shaolin/in_chuang") )
    {
        if( me->query_temp("hydra/shaolin/defeat_xianglong")
            && me->query_temp("hydra/shaolin/defeat_fuhu") )
        {
            if(environment(me) != environment(this_object()) ) return;
            command("nod "+me->query("id") );
            command("say 不错！不错！你拿我的推荐函去拜一个师傅吧。");
            me->delete_temp("hydra/shaolin/defeat_xianglong");
            me->delete_temp("hydra/shaolin/defeat_fuhu");
            give_letter(me);
        }
        else
        {
            command("sigh "+me->query("id") );
            command("say 你还要努力啊！");
        }
        me->delete("hydra/shaolin/in_chuang");
        delete("hydra/sb_in_houyuan");
    }
}       

int accept_object( object ppl,object obj )
{
    if( obj->query( "id" ) != "tuijian xin" )
    {
        command("say 多谢了，不过这东西贫僧不需要。");
        return 0;
    }
    if( query("hydra/sb_in_houyuan") )
    {
        command("say 现在有人正在过阵，你等一会儿在来吧！");
        return 0;
    }
    command( "say 哦，是一封信！");
    message_vision( "$N拆开信阅读了起来。。。\n", this_object() );
    call_out( "destruct_xin", 2 , obj );
    remove_call_out("read_letter");
    call_out( "read_letter",1,ppl );
    return 1;
}

void read_letter( object ppl )
{    
	object *all;
	int i;
	all=all_inventory(this_player());
    if( !ppl->query_temp("hydra/shaolin/can_chuang") )
    {
        command("say 不过这封信推荐的不是你啊？");
    }
    else
    {
        command("say 原来是推荐你来闯罗汉阵的。。。");
        command("say 你先试着能否打败降龙伏虎罗汉！\n");
	    for(i=0;i<sizeof(all);i++)
		if(userp(all[i]))
		{
		    message_vision("$N把$n往地下一摔。\n",ppl,all[i]);
		    all[i]->move("/clone/misc/void");
		    }
        ppl->clear_condition("jin-chuangyao");
        ppl->clear_condition("healing");
        write(CYN"玄生道：你去后院试试吧，说着打开了身后的门，你昂首走了进去！\n\n"NOR);
        ppl -> delete_temp("hydra/shaolin/can_chuang");
        ppl -> set("hydra/shaolin/in_chuang",1);
        ppl -> move( HOUYUAN );
        set("hydra/sb_in_houyuan",1);
    }    
}    
    
