#include <ansi.h>

inherit __DIR__ "xuan.lpc";
inherit F_MASTER;



void create() {
  seteuid(getuid());
  set_name("玄难", ({ "xuan nan", "xuannan", "xuan", "nan" }));
  set("long", @LONG
他是一位须眉皆白的老僧，脸上一付慈祥的表情。
这位威严的老僧便是少林寺达摩院的首座。
LONG);
  set("title", RED "少林寺" MAG "达摩院" HIM "首座" NOR);
  set("rank_info/respect", "玄难大师");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("family", ([
    "title": "少林寺达摩院首座",
    "generation": 36,
    "family_name": "少林派",
    "master_name": "灵门",
    "master_id": "ling men",
    "belong": MAG "达摩院" NOR,
  ]));

  set("age", 76);
  set("str", 30);
  set("int", 35);
  set("con", 30);
  set("spi", 30);
  set("per", 28);

  set("max_kee", 1500);
  set("kee", 1500);
  set("max_sen", 1000);
  set("sen", 1000);

  set("max_force", 5400);
  set("force", 5400);
  set("force_factor", 500);

  set("combat_exp", 7000000);
  set("social_exp", 200000);
  set("class_score", 500000);
  set("positive_score", 150000);

  set_wugong("buddhism", 190, 190, 0);
  set_wugong("xiangmo-zhang", 200, 200, 0);
  set_wugong("fumo-zhang", 200, 200, 0);
  set_wugong("luowang-gun", 100, 100, 1);
  set_wugong("longzhua-shou", 120, 120, 1);      //龙爪手 6
  set_wugong("xiuli-qiankun", 240, 240, 0);      //袖里乾坤 5
  set_wugong("banruo-xinfa", 150, 150, 1);      //般若心法
  set_wugong("jiuyang-gong", 185, 185, 1);       //少林九阳功
  set_wugong("ruying-suixing", 190, 190, 1);     //如影随形
  set_wugong("lixue-bufa", 210, 210, 0);         //立雪步法
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: SKILL_D("luowang-gun")->perform_action(this_object(), "xiangyao-chumo") :),
  }));

  set_xiuwei_by_type("unarmed", 4000);
  set_xiuwei_by_type("dodge", 4000);
  set_xiuwei_by_type("long", 7000);
  set_xiuwei_by_type("zonggang", 3000);

  set("inquiry", ([
    "武功": "少林僧人习武只为健体强身，可不是为了逞强好胜。",
  ]));

  set("no_kill", "shaolin");
  setup();
  carry_object(WEAPON_DIR "long/jinnaluo_gun")->wield();
  carry_object(CLOTH_DIR "jiasha2")->wear();
}
