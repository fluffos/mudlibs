#include <ansi.h>

inherit __DIR__ "xuan.lpc";
inherit F_MASTER;



void create() {
  seteuid(getuid());
  set_name("玄渡", ({ "xuan du", "xuandu", "xuan", "du" }));
  set("long", @LONG
他是一位须眉皆白的老僧，脸上一付慈祥的表情。
这位威严的老僧便是少林寺达摩院的长老，是玄难大师的得力助手。

LONG);
  set("title", RED "少林寺" MAG "达摩院" HIR "长老" NOR);
  set("rank_info/respect", "玄渡大师");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("family", ([
    "title": "少林寺达摩院长老",
    "generation": 36,
    "family_name": "少林派",
    "master_name": "灵门",
    "master_id": "ling men",
    "belong": MAG "达摩院" NOR,
  ]));

  set("age", 65);
  set("str", 30);
  set("int", 24);
  set("con", 30);
  set("spi", 23);
  set("per", 26);

  set("max_kee", 1300);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("max_force", 5000);
  set("force", 5000);
  set("force_factor", 200);

  set("combat_exp", 9000000);
  set("social_exp", 490000);
  set("class_score", 400000);
  set("positive_score", 100000);

  set_wugong("buddhism", 150, 150, 0);
  set_wugong("xiangmo-zhang", 200, 200, 0);
  set_wugong("fumo-zhang", 200, 200, 0);
  set_wugong("luowang-gun", 120, 120, 1);
  set_wugong("tianzhufo-zhi", 160, 160, 0);     //天竺佛指 4
  set_wugong("nianhua-zhi", 200, 200, 1);       //拈花指 6
  set_wugong("banruo-xinfa", 115, 115, 0);     //般若心法
  set_wugong("jiuyang-gong", 185, 185, 0);        //少林九阳功
  set_wugong("ruying-suixing", 190, 190, 1);     //如影随形 5
  set_wugong("lixue-bufa", 230, 230, 0);         //立雪步法 4

  set_xiuwei_by_type("unarmed", 3600);
  set_xiuwei_by_type("dodge", 3700);
  set_xiuwei_by_type("long", 5301);
  set_xiuwei_by_type("zonggang", 2600);

  set("inquiry", ([
    "武功": "少林僧人习武只为健体强身，可不是为了逞强好胜。",
  ]));

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "jiasha2")->wear();
  carry_object(WEAPON_DIR "long/jinnaluo_gun")->wield();
