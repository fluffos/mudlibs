// /d/shaolin/xuanji.c  玄寂
//modifid by hydra 19980505

#include <ansi.h>

inherit __DIR__ "xuan.lpc";
inherit F_MASTER;



void create() {
  seteuid(getuid());
  set_name("玄寂", ({ "xuan ji", "xuanji", "xuan", "ji" }));
  set("long", @LONG
他是一位须眉皆白的老僧，脸上一付慈祥的表情。
这位威严的老僧便是少林寺龙树院的首座，他负责给少林弟子每天
讲经说法。
LONG);
  set("title", RED "少林寺" BLU "龙树院" HIM "首座" NOR);
  set("rank_info/respect", "玄寂大师");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("family", ([
    "title": "少林寺龙树院首座",
    "generation": 36,
    "family_name": "少林派",
    "master_name": "灵门",
    "master_id": "ling men",
    "belong": BLU "龙树院" NOR,
  ]));

  set("age", 65);
  set("str", 30);
  set("int", 32);
  set("con", 30);
  set("spi", 23);
  set("per", 32);

  set("max_kee", 2400);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("max_force", 6000);
  set("force", 6000);
  set("force_factor", 300);

  set("combat_exp", 6000000);
  set("social_exp", 240000);
  set("class_score", 400000);
  set("positive_score", 80000);

  //龙树院以内力见长，所以玄寂的内力极高
  set_wugong("buddhism", 250, 250, 0);           //禅宗心法
  set_wugong("yipai-liangsan", 120, 100, 0);     //一拍两散 5
  set_wugong("wuxiangjie-zhi", 70, 70, 1);      //无相劫指 6
  set_wugong("wuding-zhi", 220, 220, 0);      //大智无定指 4
  set_wugong("banruo-xinfa", 180, 180, 1);    //般若心法
  set_wugong("jiuyang-gong", 190, 190, 1);     //少林九阳功
  set_wugong("ruying-suixing", 180, 180, 1);   //如影随形 5
  set_wugong("lixue-bufa", 205, 205, 0);       //立雪步法 4
  //其它门派的功夫
  set_wugong("liuyun-jian", 80, 80, 0);
  set_wugong("kongling-jian", 70, 70, 0);

  set_xiuwei_by_type("unarmed", 3400);
  set_xiuwei_by_type("sword", 1500);
  set_xiuwei_by_type("dodge", 3300);
  set_xiuwei_by_type("zonggang", 1920);

  set("inquiry", ([
    "武功": "少林僧人习武只为健体强身，可不是为了逞强好胜。",
  ]));

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "jiasha2")->wear();
}
