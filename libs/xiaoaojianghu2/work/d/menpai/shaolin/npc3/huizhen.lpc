#include <ansi.h>

inherit __DIR__ "hui.lpc";
inherit F_MASTER;

string change_master(object);
void give_letter(object);




void create() {
  seteuid(getuid());
  set_name("慧贞", ({ "hui zhen", "zhen", "hui", "bonze" }));
  set("long", @LONG
少林达摩院知事慧贞师傅，协助玄难大师处理达摩院日常事务，
同时教授弟子功夫。
LONG
  );
  set("title", RED "少林寺" MAG "达摩院" HIC "知事" NOR);
  set("gender", "男性");
  set("age", 55);
  set("class", "bonze");

  set("inquiry", ([
    "升级": (: change_master :),
    "比武": (: change_master :),
  ]));

  set("str", 35);
  set("int", 28);
  set("spi", 30);
  set("con", 34);

  set("force", 1600);
  set("max_force", 1600);
  set("force_factor", 50);
  set("kee", 1500);
  set("max_kee", 1500);
  set("max_sen", 800);
  set("sen", 800);

  set_wugong("buddhism", 85, 85, 0);
  set_wugong("yuanhou-gun", 110, 100, 0);
  set_wugong("fenghuo-gun", 110, 100, 0);
  set_wugong("xiangmo-zhang", 80, 80, 1);
  set_wugong("xiuli-qiankun", 105, 105, 1);      //袖里乾坤 5
  set_wugong("yingzhua-gong", 120, 120, 0);    //鹰爪功 4
  set_wugong("yintuoluo-zhua", 160, 160, 0);      //因陀螺抓 3
  set_wugong("banruo-shenfa", 135, 135, 1);    //般若身法 3
  set_wugong("lianhua-bu", 160, 160, 0);    //莲花步 2
  set_wugong("banruo-xinfa", 120, 120, 0);     //般若心法

  set_xiuwei_by_type("unarmed", 1700);
  set_xiuwei_by_type("dodge", 1600);
  set_xiuwei_by_type("long", 2100);
  set_xiuwei_by_type("zonggang", 1000);

  set("combat_exp", 1500000);
  set("social_exp", 500000);
  set("positive_score", 21000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", MAG "达摩院" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
  carry_object(WEAPON_DIR "long/qimei_gun")->wield();
}

#include "hui_master.h";
#include "zhishi.h";
