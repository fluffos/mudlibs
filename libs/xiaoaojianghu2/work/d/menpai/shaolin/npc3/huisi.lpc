//huisi.c 十八罗汉之降龙罗汉
#include <ansi.h>

#define DATING "/d/menpai/shaolin/luohan_zhen/luohan_dating"

inherit NPC;

int change_master();



void create()
{
    seteuid(getuid());
	set_name("慧思",({ "hui si","hui","monk" }) );
	set("long",@LONG
这就是十八罗汉之首降龙罗汉，他身材瘦高，须发花白，身穿一袭金边红色袈裟。
太阳穴高高鼓起，分明身怀绝世武功。
LONG	);


	set("title", RED"降龙罗汉"NOR);
	set("gender", "男性");
	set("attitude", "friendly");
	set("class", "bonze");

	set("age", 52);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
    set_hp("kee",1000);
    set_hp("sen",900);
	set("force", 2000);
	set("max_force", 1500);
    set("force_factor",150);
	set("combat_exp", 1000000);
	set("class_score", 5000);
    set("positive_score",3000);
    set("social_exp",5000);
//   set_temp("apply/armor",50);
    set("env/attack",60);// write by xli
    

    set_wugong("shaolin-shenfa", 185,160,1);
    set_wugong("shaolin-xinfa",120,100,1);
    set_wugong("xumishan-zhang",60,60,1);
//    set_wugong("fuhu-quan",60);

    set_xiuwei_by_type("unarmed",3200);
    set_xiuwei_by_type("dodge",2000);
//    set_xiuwei_by_type("zonggang",500);

	create_family("少林派", 37, "弟子");
	
	setup();

    carry_object(CLOTH_DIR "hong-jiasha")->wear();
}

void killed_enemy( object me )
{
    object this = this_object();
    object ob;
    if( !query("is_killing_enemy") ) return;
    message_vision("$N长宣一声佛号：“阿弥陀佛！”转身迅速离去！\n",this);
    if(objectp(ob = present("hui tong",environment(this) ) ) )
        message_vision("$N也飞身跟随$n而去！\n",ob,this);
    call_out("destruct_me",1,this,ob);
}

void destruct_me( object me,object ob )
{
    destruct( ob );
    destruct( me );
}        

void heart_beat()
{
    ::heart_beat();
    if( stringp(query("is_killing_enemy")))
    {
        if( !present(query("is_killing_enemy"),environment(this_object())))
        {
            message_vision("$N急急忙忙地离开了。\n",this_object());
            destruct( this_object() );
        }
    }
}  

int lose_bihua( object ppl )
{
    /* begin write by xli  */
//    object ob;
    if( ppl->query("xli_marks/闯罗汉阵"))
    {
        if ( ppl->query("xli_marks/defeat_huitong"))    // 已经打败过慧通
        {
            ppl->set("xli_marks/闯阵成功",1);
            tell_object(ppl,CYN"慧思道：你果然深得少林武功之精要，就请与我同回大厅。\n\n");
            tell_object(ppl,HIY"只见慧思在墙上一拂，突然出现了一道暗门。\n\n");
            tell_object(ppl,"慧思从中踱步而出，你赶紧跟了出去。\n\n");
            move(DATING);           
            call_out("MoveDating",1,ppl);
        }   
        else
        { 
            tell_object(ppl,YEL"慧思道：敢闯罗汉阵，果然了得。\n"NOR);
            tell_object(ppl,YEL"慧思身形一纵，跳了开去。\n\n"NOR);
            ppl->set("xli_marks/defeat_huisi",1);
            move(DATING);
        }
    }
    /* end of write by xli */
    
    if( ppl->query("hydra/shaolin/in_chuang") )
    {
        tell_object(ppl,"慧思对你点了点头，不错，不错！");
        ppl -> set_temp("hydra/shaolin/defeat_xianglong",1);
        if( ppl->query_temp("hydra/shaolin/defeat_fuhu") )
        {
            ppl -> set_temp("hydra/shaolin/finish_fight",1);
        }
    }
    return 1;
}

int win_bihua( object ppl )
{
    /* begin write by xli  */
//    object ob;
    if( ppl->query("xli_marks/闯罗汉阵") == 1)
    {
        if( !ppl->is_ghost() )
        {
            tell_object(ppl,"你还须努力修炼，现在就与我同回大厅吧！\n");
            move(DATING);
            call_out("MoveDating",1,ppl);
        }
        return 1;
    }
    /* end of write by xli */
    
    if( ppl->query("hydra/shaolin/in_chuang") )
    {
        tell_object(ppl,"慧思对你摇了摇头，看来你还要努力啊！");
        ppl -> set_temp("hydra/shaolin/finish_fight",1);
    }
    return 1;
}

void MoveDating(object ppl)
{
    ppl->move(DATING);
}
