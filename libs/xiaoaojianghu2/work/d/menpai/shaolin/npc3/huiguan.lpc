#include <ansi.h>

inherit F_MASTER;
inherit __DIR__"hui.lpc";



void create()
{
    seteuid(getuid());
	set_name("慧观", ({ "hui guan", "hui", "guan", "bonze" }) );
	set("long",	@LONG
少林般若堂的师傅，负责教授般若堂弟子的功夫，他精通江湖各大
门派的武功，但是于本门功夫却有些荒废了。
LONG
	);
	set("title",RED"少林寺"GRN"般若堂"HIW"武僧"NOR);
	set("gender", "男性");
	set("age", 45);
	set("class", "bonze");

	set("str", 35);
	set("int", 24);
	set("spi", 30);
	set("con", 34);

    set("force", 2000);
    set("max_force", 2000);
    set("force_factor", 50);
    set("kee",1300);
    set("max_kee",1300);

    set_wugong("buddhism"       ,70,70,0);  
    set_wugong("mohe-zhi"       ,110,110,1);      //摩诃指 5
    set_wugong("duoluoye-zhi"	,140,140,0);    //多罗叶指 4
    set_wugong("fuhu-quan"      ,180,180,0);    //伏虎拳 3
    set_wugong("banruo-shenfa"  ,100,100,1);    //般若身法 3
    set_wugong("lianhua-bu"     ,190,190,0);    //莲花步 2
    set_wugong("banruo-xinfa"  ,115,115,0);    //般若心法
    set_wugong("shaolin-dandao",100,100,0);
    set_wugong("xiuluo-dao"    ,100,100,1);
    set_wugong("damo-jian"      ,100,100,0);
    set_wugong("longxing-jian"  ,110,110,1);
    
    set_xiuwei_by_type("unarmed",1800);
    set_xiuwei_by_type("dodge",1500);
    set_xiuwei_by_type("blade",1200);
    set_xiuwei_by_type("sword",1300);
    set_xiuwei_by_type("zonggang",1000);

    set("combat_exp", 800000);
    set("social_exp", 500000);
    set("positive_score",22000);
    set("negative_score",0);
    set("class_score",10000);

    create_family("少林派", 37, "弟子");
    set("family/belong",GRN"般若堂"NOR);

    set("no_kill","shaolin");	
    setup();
    carry_object(CLOTH_DIR"sengyi3")->wear();

}

#include "hui_master.h";

int lose_bihua( object ppl )
{
    if( ppl->query_temp("hydra/shaolin/fight_master") == query("id"))
    {
        command( "smile "+ppl->query("id"));
        command( "say 好徒儿，有出息！");
        ppl->set_temp("hydra/shaolin/defeat_master",1);
        ppl ->delete_temp("hydra/shaolin/fight_master");    
        command( "say 你去找你慧鸣师叔说吧！");        
    }
    return 1;
}
