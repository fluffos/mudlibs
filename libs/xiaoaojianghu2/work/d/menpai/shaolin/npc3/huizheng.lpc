// huizheng.c 慧正--龙树院的知事
// written by hydra 19980513 


#include <ansi.h>

inherit __DIR__ "hui.lpc";
inherit F_MASTER;

string change_master(object);
void give_letter(object);



void create() {
  seteuid(getuid());
  set_name("慧正", ({ "hui zheng", "zheng", "hui", "bonze" }));
  set("long", @LONG
少林龙树院知事慧正师傅。据说他为人正直，在出家前由于打抱不平
时被玄寂大师遇上，大师因其为人而受他为徒。
LONG
  );
  set("title", RED "少林寺" BLU "龙树院" HIC "知事" NOR);
  set("gender", "男性");
  set("age", 60);
  set("class", "bonze");

  set("inquiry", ([
    "比武": (: change_master :),
    "升级": (: change_master :),
  ]));

  set("str", 35);
  set("int", 23);
  set("spi", 30);
  set("con", 34);

  set("force", 1200);
  set("max_force", 1200);
  set("force_factor", 50);
  set("kee", 1500);
  set("max_kee", 1500);

  set_wugong("buddhism", 100, 100, 0);
  set_wugong("wuding-zhi", 105, 105, 1);      //大智无定指 5
  set_wugong("duoluoye-zhi", 160, 160, 0);      //多罗叶指 4
  set_wugong("yintuoluo-zhua", 165, 165, 0);      //因陀螺抓 3
  set_wugong("banruo-shenfa", 85, 85, 1);      //般若身法 3
  set_wugong("lianhua-bu", 140, 140, 0);    //莲花步 2
  set_wugong("banruo-xinfa", 130, 130, 0);    //般若心法

  set_wugong("wuliang-jian", 80, 80, 0);
  set_wugong("haofeng-quan", 70, 70, 0);
  set_wugong("kuaige-dao", 60, 60, 0);

  set_xiuwei_by_type("unarmed", 2300);
  set_xiuwei_by_type("dodge", 1700);
  set_xiuwei_by_type("blade", 400);
  set_xiuwei_by_type("zonggang", 1100);

  set("combat_exp", 2400000);
  set("social_exp", 500000);
  set("positive_score", 30000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", BLU "龙树院" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();

}

#include "hui_master.h";
#include "zhishi.h";
