#include <ansi.h>

inherit __DIR__"xuan.lpc";
inherit F_MASTER;



void create()
{
    seteuid(getuid());
    set_name("玄苦", ({"xuan ku","xuanku","xuan","ku"}));
    set("long",@LONG
他是一位须眉皆白的老僧，脸上一付慈祥的表情。
这位威严的老僧便是少林寺般若堂的首座，他对别派武功深有研究。
LONG   );
    set("title",RED"少林寺"GRN"般若堂"HIM"首座"NOR);
    set("rank_info/respect", "玄苦大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze1");
    set("family",([
        "title"         :"少林寺般若堂首座",
        "generation"    :36,
        "family_name"   :"少林派",
        "master_name"   :"灵门",
        "master_id"     :"ling men",
        "belong"        :GRN"般若堂"NOR,
        ]) );

    set("age", 74);
    set("str", 30);
    set("int", 32);
    set("con", 30);
    set("spi", 23);
    set("per", 26);

    set("max_kee", 1500);
    set("kee", 1500);
    set("max_sen",1000);
    set("sen",1000);

    set("max_force", 5200);
    set("force", 5200);
    set("force_factor", 200);

    set("combat_exp", 8000000);
    set("social_exp", 600000);
    set("class_score", 500000);
    set("positive_score",120000);

    set_wugong("xiuluo-dao",120,120,0);
    set_wugong("meihua-dao",160,160,0);
    set_wugong("buddhism",190,190,0);
    set_wugong("fengmo-dao",140,140,0);
    set_wugong("ranmu-daofa",120,120,1);       //燃木刀法 6
    set_wugong("wuding-zhi",250,250,1);        //大智无定指 5
    set_wugong("mohe-zhi",200,200,0);        //摩诃指 5
    set_wugong("ruying-suixing",180,180,1);     //如影随形 5
    set_wugong("lixue-bufa",220,220,0);         //立雪步法 4    
    set_wugong("banruo-xinfa", 150,150,1);     //般若心法
    set_wugong("jiuyang-gong",185,185,1);         //少林九阳功

    //应该还有一些其他门派的功夫，以后再加。。
        set("chat_chance_combat", 20);      
        set("chat_msg_combat", ({
        (: SKILL_D("ranmu-daofa")->perform_action(this_object(), "caomu-jiebing") :),
           }) );  

    set_xiuwei_by_type("unarmed",3800);
    set_xiuwei_by_type("dodge",4000);
    set_xiuwei_by_type("sword",1500);
    set_xiuwei_by_type("blade",5301);
    set_xiuwei_by_type("zonggang",2000);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

    set("no_kill","shaolin");
    setup();
    carry_object(CLOTH_DIR"jiasha2")->wear();
    carry_object(__DIR__"obj/jiedao")->wield();
}

