// huijue.c

//Last modified by Hydra 19990512
//xli怎么给所有新入门的都加50忠诚度，为什么，刚入门都为0嘛，少林为什么要不同
//加上不接受杀人过多的玩家，也是为了避免玩家一加入少林，就被关到戒律院。

#include <ansi.h>

inherit NPC;

inherit __DIR__"hui_quest.lpc";
string *prename =({ "虚",
                        "悟",
                        "圆",
                        "空",                               
                        });
string ask_for_join();
string ask_for_nofamily();
string ask_for_out();
string change_name();



void create()
{
    set_name("慧觉", ({ "hui jue", "hui", "jue", "he shang",
                        "seng ren", "bonze" }) );
    set("long",    "一个四五十岁的中年僧人。\n");
    set("gender", "男性");
    set("age", 51);
    set("attitude", "friendly");
    set("class", "bonze");

    set("str", 17);
    set("int", 30);
    set("spi", 30);
    set("con", 30);
    set("cps", 30);
    set("cor", 20);
    set("per", 30);
    set("kar", 30);

    set("force", 2000);
    set("max_force", 2000);
    set("force_factor", 20);
    set("kee",1000);
    set("max_kee",1000);
  
    set_wugong("luohan-quan"    , 80, 80,1);
    set_wugong("weituo-zhang"   , 80, 80,1);
    set_wugong("fuhu-quan"      ,108,108,1);
    set_wugong("shaolin-shenfa" , 80, 80,1);
    set_wugong("shaolin-neigong", 80, 80,1);
    set_xiuwei_by_type("unarmed",1000);
    set_xiuwei_by_type("dodge",1000);

    set("combat_exp", 200000);
    set("social_exp", 100000);
    set("positive_score",1000);
    set("negative_score",3000);
    set("class_score",700);

    set("inquiry", ([
        "剃度" : (: ask_for_join :),
        "还俗" : (: ask_for_out :),
        "出家" : (: ask_for_join :),
        "另投明师" : (: ask_for_nofamily :),
        "恢复名字" : (: change_name :),
    ]) );
    create_family("少林派", 37, "弟子");
    set("title","少林寺法堂执事");

    set("no_kill","shaolin");
    setup();
    carry_object(CLOTH_DIR "sengyi3")->wear();
}

void init()
{
    add_action("do_kneel", "gui");
    add_action("give_quest","quest");
}

string ask_for_join()
{
    object me;

    me = this_player();

    if( (string)me->query("class")=="bonze" )
        return "阿弥陀佛！你我同是出家人，何故跟贫僧开这等玩笑？\n";
    if( (string)me->query("gender") == "女性" )
        return "阿弥陀佛！女施主，这里是寺庙，请你到尼姑庵去剃度吧。\n";
 //   if( (string)me->query("gender") == "无性" )
  //      return "阿弥陀佛！早知如此，何必当初呢？\n";        
    if( me->query("marks_leonhart/和尚") )
        return "阿弥陀佛！施主既已从少林中叛逃出门，与我佛门无缘，当难再返。\n"; 
    if( me->query("PKS") > 10 || me->query("MKS") > 1000 )
        return "阿弥陀佛！施主身上杀孽太重，即使归依我佛，也难于领悟佛法真谛。\n";
    if( me->query("shaolin/kickout") )
    {
        command("heng");
        return "你这孽徒还有脸回来！";
    }
    me->set_temp("pending/join_shaolin", 1);
    if( me->query("family") )
        return "要皈依我佛,需要废除你原来门派的武功,如果愿意的话,就请跪下受戒。\n";
    else
        return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下受戒。\n";
}
string ask_for_nofamily()
{
    object ob;
    ob = this_player();
    if( (string)ob->query("title") != "少林第三十八代俗家弟子" )
        return " 阿弥陀佛,你不是少林的俗家弟子,你的师傅不会让你叛出师门的!\n";
    ob -> set("title","普通百姓");
    ob -> delete("family");
    ob -> delete("class");
    ob ->set("name",ob->query("locker/shaolinname"));
    return "阿弥陀佛,施主既与少林无缘,另投明师,定当有所造就!\n";
}
string ask_for_out()
{
    object ob;

    ob = this_player();

    if( ob->query("family/master_id") )
        return "阿弥陀佛，你既已拜师，从此青灯古佛，怎能再为凡俗事物所扰！\n"; 
    if( (string)ob->query("class") != "bonze" )
        return " 阿弥陀佛！施主本非佛门中人，何故跟贫僧开这等玩笑？\n";
    if( ! ob->query("lnwm/pass_muren") )
        return "阿弥陀佛，我少林百年寺规，要想还俗耄愕孟裙四救讼镌偎怠n";
    //need to add here!/leonhart
      
    ob->set("name",FINGER_D->acquire_login_ob(ob->query("id"))->query("name")); 
//    ob->delete("class");
//    ob->delete("family");
//    ob->delete("lnwm/pass_muren");  
    ob->set("title","少林第三十八代俗家弟子");
    ob->set("marks_leonhart/和尚",1);
    //Hydra added log for 还俗 at 19980518
    LOG_D->do_log( ob,sprintf("你得到慧觉的允许，还俗成为%s。",
            ob->query("title")));
    return "阿弥陀佛，施主既然与佛门无缘，这就收拾收拾下山去吧。\n";
}

int do_kneel()  
{
    
    string name, new_name;
    object ob;

    ob=this_player();
    if( !ob->query_temp("pending/join_shaolin") ) return 0;
    // added by xli 99.3.29
    // 新手给点奖励
    if( (!ob->query("family"))
      && (ob->query("mud_age")<172800)
      && (ob->query_xiuwei_by_type("unarmed")<100)
      )
      {
          tell_object(ob,"慧觉说道：你初入我佛门，念你一心向佛，我很满意！\n");
          tell_object(ob,"看你没有什么根基，我且教你一些基本的防身之术吧！\n");
          tell_object(ob,"慧觉给你讲述了一下少林的基本防身术，你虽然颇为不懂，倒还感觉有些裨益。\n");
          ob->set_xiuwei_by_type("unarmed",150);
          ob->set_wugong("jiben-quanfa",10,5,0);
      }
    
    //Hydra added 98/10/25
    //判师过来的弟子，减他拳脚修为和内力，呵呵
    if( ob->query("family") )
    {
        tell_object(ob,CYN""+ @MSG
慧觉道：你在原来师傅那里学的拳脚功夫与少林修身养性之道，于你学习少林绝技
有害，我还是替你废掉他吧。
说着，手掌在你背上轻轻一拍，你只觉丹田一片空荡，数年来学的拳脚修为大减。
MSG 
+""NOR
);
        ob->set_xiuwei_by_type("unarmed",ob->query_xiuwei_by_type("unarmed")/2);
        tell_object(ob,"慧觉又道：你所习的内功与我少林内功颇有不合之处，我还是替你减弱一些吧！\n");
        ob->set("max_force",ob->query("max_force")*2/3);
        ob->set("force",ob->query("force")*2/3);
        ob->set("yang",ob->query("yang")*2/3);
        ob->set("yin",ob->query("yin")*2/3);
        ob->set("force_factor",ob->query("force_factor")*2/3);
    }
    
    message_vision(
        HIC "$N双手合十，恭恭敬敬地跪了下来。\n"
            "$n伸出手掌，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。\n" NOR,
        ob, this_object() );
    name = ob->query("name");
    ob->set("locker/shaolinname",name);
    new_name = prename[random(sizeof(prename))] + name[2..3];
    command("say 从今以後你的法名叫做" + new_name + "。");
    command("smile");
    ob->delete_temp("pending/join_shaolin");
    ob->set("name", new_name);
    ob->set("class", "bonze");
    ob->delete_family();  
    ob->create_family("少林派",38,"弟子");
    ob->set("marks_leonhart/和尚",1);
    if ( ob->query( "quest" ) )
        ob->delete( "quest" );
    if ( ob->query( "done_quest" ) )
        ob->delete( "done_quest" );
    if ( ob->query( "task_time" ) )
        ob->delete( "task_time" );
    // add by xli
    ob->set("class_score/少林派",0);
    LOG_D->do_log(ob,"你决定投身佛门，成为少林第三十八代弟子。");
    return 1;
}

void attempt_apprentice(object ob)
{
    if( (string)ob->query("gender") != "男性" )
        command("say 阿弥陀佛，女施主不要跟贫僧开玩笑。");
    else if( ob->query("class") != "bonze" )
        command("say 未得方丈准许，贫僧不敢擅收俗家弟子。施主还是请回吧。");
    else if( ob->query("lnwm/pass_muren") )
        command("say 贫僧向来不收弟子，你去找其他师傅看看吧！");
    else        
        command("say 不要急，不要急。等你过了木人巷，自然有师傅可拜。");
}

int accept_fight(object me)
{
    if( (string)me->query("class")=="bonze" )
        command("say 阿弥陀佛！出家人戒逞强恶斗！贫僧不敢违反清规。");
    else
        command("say 施主既然身负绝艺，贫僧佩服便是，也不必较量了。");
    
    return 0;
}

int valid_teach(object me, string skill)
{
    message_vision(CYN"慧觉道：贫僧向来只管少林事务，不教徒弟的。\n"NOR,me);
    return 0;
}

string change_name()
{
    object me;
    string msg;
    me = this_player(); 
            if ( !me->query("locker/passluohan") || me->query("locker/shaolinchange")) 
       {      msg = "呵呵，哪有那么便宜的事情？\n";
            return msg;}
     me->set("locker/pshaolinchange",1);
     me->set("name",me->query("locker/shaolinname"));
     msg="唔,这样啊,好吧,这样对我少林也好一定的好处.";      

    return msg;
}
