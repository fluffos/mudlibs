#include <ansi.h>

inherit __DIR__ "hui.lpc";
inherit F_MASTER;

string change_master(object);
string ask_arrest(object);
void give_letter(object);



void create() {
  seteuid(getuid());
  set_name("慧鸣", ({ "hui ming", "hui", "ming", "bonze" }));
  set("long", @LONG
少林般若堂知事，负责般若堂日常事务，兼教授般若堂弟子武功。
LONG
  );
  set("title", RED "少林寺" GRN "般若堂" HIC "知事" NOR);
  set("gender", "男性");
  set("age", 47);
  set("class", "bonze");

  set("inquiry", ([
    "升级": (: change_master :),
    "比武": (: change_master :),
    "缉拿杀人魔": (: ask_arrest :),
    "杀人魔": (: ask_arrest :),
  ]));

  set("str", 35);
  set("int", 26);
  set("per", 28);
  set("spi", 30);
  set("con", 34);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);
  set("kee", 1300);
  set("max_kee", 1300);

  set_wugong("buddhism", 90, 90, 0);
  set_wugong("mohe-zhi", 100, 100, 1);      //摩诃指 5
  set_wugong("duoluoye-zhi", 170, 170, 0);    //多罗叶指 4
  set_wugong("fuhu-quan", 200, 200, 0);    //伏虎拳 3
  set_wugong("banruo-shenfa", 100, 100, 1);    //般若身法 3
  set_wugong("lianhua-bu", 140, 140, 0);    //莲花步 2
  set_wugong("banruo-xinfa", 110, 110, 0);    //般若心法
  set_wugong("xiuluo-dao", 100, 100, 0);
  set_wugong("meihua-dao", 120, 120, 1);

  set_xiuwei_by_type("unarmed", 1600);
  set_xiuwei_by_type("dodge", 1500);
  set_xiuwei_by_type("blade", 1600);
  set_xiuwei_by_type("zonggang", 1000);

  set("combat_exp", 1100000);
  set("social_exp", 500000);
  set("positive_score", 20000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", GRN "般若堂" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
  carry_object(__DIR__ "obj/jiedao")->wield();

}

string ask_arrest(object ppl) {
  object ob;
  string msg, *path;
  ppl = this_player();
  if (!ppl->query("hydra/shaolin/kaoyan_arrest"))
    return "杀人魔真是可恶。";
  if (ob = find_player(ppl->query("hydra/shaolin/kaoyan_arrest"))) {
    if (objectp(ob) && environment(ob)) {
      path = explode(file_name(environment(ob)), "/");
      msg = "据般若堂最新消息" RED + ob->query("name") + "(" + ob->query("id") + ")";
      msg += CYN "现正在" + CHINESE_D->chinese_place_name(path[2]) + "一带做恶。";
    } else {
      msg = "他现在远遁他方，我们戒律院也没有了他的消息。";

    }
  } else {
    msg = "他现在远遁他方，我们戒律院也没有了他的消息。";
  }
  return msg;
  //   return "杀人魔真是可恶。";
}

#include "hui_master.h";
#include "zhishi.h";
