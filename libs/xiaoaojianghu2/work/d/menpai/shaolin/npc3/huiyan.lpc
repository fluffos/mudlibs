// huiyan.c 慧严--藏经阁知事
// Hydra edit 98/10/7

#include <ansi.h>

inherit F_MASTER;
inherit __DIR__ "hui.lpc";

string do_accept(string msg, object me);
string change_master(object);
void greeting(object);



void create() {
  seteuid(getuid());
  set_name("慧严", ({ "hui yan", "hui", "bonze" }));
  set("long", "一个四十多岁的中年僧人。\n");
  set("gender", "男性");
  set("age", 41);
  set("attitude", "friendly");
  set("class", "bonze");

  set("str", 17);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 20);
  set("per", 30);
  set("kar", 30);

  set("force", 2200);
  set("max_force", 2200);
  set("force_factor", 50);
  set("kee", 2000);
  set("max_kee", 2000);

  set_wugong("buddhism", 80, 80, 0);
  set_wugong("banruo-zhang", 100, 100, 1);
  set_wugong("lianhua-bu", 140, 140, 0);
  set_wugong("banruo-xinfa", 100, 100, 0);
  set_xiuwei_by_type("unarmed", 2000);
  set_xiuwei_by_type("dodge", 1600);
  set_xiuwei_by_type("zonggang", 1300);

  set("combat_exp", 1000000);
  set("social_exp", 500000);
  set("positive_score", 40000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("title", RED "少林寺" YEL "藏经阁" HIC "知事" NOR);
  set("family/belong", YEL "藏经阁" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();

}

int welcome_visitor(object ppl) {
  int i;
  object *inv;

  if (ppl->query("family/family_name") == "少林派")
    return 1;
  if (!objectp(environment())) return 1;

  inv = all_inventory(environment());
  for (i = 1; i < sizeof(inv); i++)
    if (inv[i] != this_object() && !inv[i]->weigong(ppl))
      continue;
  message_vision("$N" + RED "大叫一声：大胆狂徒，居然潜入藏经阁。\n" NOR,
    this_object());
  kill_ob(ppl);
  return 1;
}

int weigong(object who) {
  kill_ob(who);
  return 1;
}
