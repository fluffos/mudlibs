//huinenng.c 十八罗i汉之清净罗汉
#include <ansi.h>
inherit NPC;



void create() {
  set_name("慧能", ({ "hui neng", "hui", "monk" }));
  set("long", @LONG
他是一位须发花白的老僧，身穿一袭金边红色袈裟。他身材瘦高，
太阳穴高高鼓起，似乎身怀绝世武功。
LONG);

  set("title", YEL "清净罗汉" NOR);
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 42);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set_hp("kee", 1000);
  set_hp("sen", 500);
  set_force(3000, 3000, 300);
  set("combat_exp", 2300000);
  set("class_score", 5000);
  set("positive_score", 3000);
  set("social_exp", 5000);
  set("env/attack", 75);

  set_wugong("banruo-shenfa", 185, 160, 1);
  set_wugong("shaolin-xinfa", 100, 90, 1);
  set_wugong("luowang-gun", 90, 100, 1);
  set_wugong("weituo-zhang", 160);

  set_xiuwei_by_type("long", 8701);
  set_xiuwei_by_type("dodge", 2000);
  set_xiuwei_by_type("zonggang", 3000);

  create_family("少林派", 37, "弟子");

  setup();

  carry_object(CLOTH_DIR "hong-jiasha")->wear();
  carry_object(LONG_DIR "qimei_gun")->wield();
}


#include "xli_hui.h"
