inherit ROOM;



void create()
{
    set("short","密道");
    set("long",@LONG
这是一条伸手不见五指的密道，四周任何光亮都没有，伸出手来摸索经常就
碰到了坚硬的石壁，上面略有粗糙，干燥而完整无缝的石块摸上去都是一模一样
的，毫无路径的指示。你只能凭着各种感觉走动。
LONG
    );
    set("exits",([
