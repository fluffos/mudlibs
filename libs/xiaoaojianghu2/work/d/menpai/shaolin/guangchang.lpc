inherit ROOM;



void create() {
  set("short", "广场");
  set("long", @LONG
空旷宽阔的广场上，一群少林武僧正在认真地练武。从广场上不断的传出武
僧们的“嚯、哈”之声，甚为洪亮，引人不禁驻足观瞻。一位罗汉堂的僧人正在
认真地纠正着他们的错误。
LONG
  );
  set("exits", ([
    "east": __DIR__ "guangchang_dongshou",
    "west": __DIR__ "guangchang_xishou",
    //      "south"     : __DIR__"fatang",
    "north": __DIR__ "lixue_ting",
  ]));
  set("outdoors", "shaolin");
  setup();
  //place_program(ROOM);
