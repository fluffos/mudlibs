#include <ansi.h>

inherit ROOM;



void create()
{
	set("short", CYN"天王殿"NOR);
	set("long", 
"少林寺天王殿，大殿正中是弥勒金身坐像。但见弥勒笑容可鞠，坦胸露腹，
一派笑尽天下事的坦荡模样。弥勒两边是四大天王立像，个个面目凶恶，铜铃般
的眼睛直瞪着你。四大天王分持"+CYN"剑."NOR+HIC"鞭."NOR+GRN"伞."NOR+MAG"琴."NOR+"。专管天下不平之事。
弥勒和四大天王脚下各有香案，案上香炉中插着上好的檀香，青烟缭绕，凭添几
分神秘。香案前摆放着蒲团，供僧人和香客顶礼膜拜。\n"
	);
	set("exits", ([ /* sizeof() == 1 */
	    "north": __DIR__"qingshi-lu2.lpc",
        "south": __DIR__"lifuo-dian.lpc",
		"west" : __DIR__"tianwang-dian1.lpc",
        "east" : __DIR__"tianwang-dian2.lpc",
	]));
	set("need_clean", "少林派");
	
	setup();
}

void init()
{
        add_action("da_sao", "sao");
        add_action("da_sao", "clean");
}

int da_sao(string arg)
{
    object me;
    mapping quest;
    me = this_player();
    if( !me->can_act() ) return notify_fail("你现在无法打扫。\n");

    if( call_other("/cmds/verb/clean", "main", me, arg ) )
    {
        if( quest = me->query("quest") )
        {
            if( quest["quest"] == "打扫天王殿" )
            me->set("done_quest", "打扫天王殿" );
            return 1;
        }
        return 1;
    }
    return 0;
}

