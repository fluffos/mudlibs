#include <room.h>

inherit ROOM;



void create()
{
    set("short", "药王院正厅");
    set("long", @LONG
空地上东一堆西一堆地摊着一些药草，你仔细看看，大都是常见的止血药。
西边是院门，东边是一座小小的茅屋，南北两边都是连成一体的草堂。一位老僧
的脸在北边草堂的窗口晃了一下，又消失不见了。你忽然意识到，原来这里就是
药王院了。
LONG
    );
    set("exits", ([ 
        "east"      : __DIR__"yaowang_yuan3",
        "west"      : __DIR__"yaowang_yuan1",
        "south"     : __DIR__"yaowang_yuan6",
        "north"     : __DIR__"yaowang_yuan7",
    ]));
	set("objects", ([
		__DIR__"npc/heshang2"   : 1,
		__DIR__"npc/huwei"     : 2,
		]) );
    set("outdoors", "shaolin");
    setup();
    //place_program(ROOM);
}                       
