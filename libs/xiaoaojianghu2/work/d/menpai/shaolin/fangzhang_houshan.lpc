  set("short", "后山");
  set("long", @LONG
方丈精舍后有一小块空地，东西各有一道游廊通往方丈精舍的正门，往北是
好大一片竹林，一眼望去，看不到头。有一条羊肠小道，弯弯曲曲，直引入竹林
深处......
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "fangzhang_youlang2e",
    "southwest": __DIR__ "fangzhang_youlang2w",
    "north": __DIR__ "houshan_zhulin1",
