inherit ROOM;



void create()
{
    set("short", "草堂");
    set("long", @LONG
一间空荡荡的草堂，西首摆着两张竹床，两个蒲团。东首靠着一个书架。北
边窗外可以看到一片竹林。在稀疏的竹影那边，几间房屋隐约可见。一张桌子靠
在窗下，桌上摊着几味草药，一位灰衣老僧坐在桌旁，不时捡起一枝来递给身边
的白衣僧人，随后又对他说了些什么。白衣僧人总是接过来看一看，再嗅一嗅，
有时还咬上一点点尝尝，再放回去。
LONG
    );
    set("exits", ([
        "south"     : __DIR__"yaowang_yuan2.lpc",
    ]));

    setup();
    //place_program(ROOM);
}
