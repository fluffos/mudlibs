inherit ROOM;



void create()
{
    set("short", MAG"达摩院正门"NOR);
    set("long", @LONG
这里是达摩院的正门。一块简易的门匾挂在门头，上面书有“达摩院”三个
大字，虽历经年月沧桑，然而因为笔势苍劲有力，入木三分，所以依然颇显少林
气势。两个护卫僧在此看守院门。
LONG
    );
    set("exits", ([ 
