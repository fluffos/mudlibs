// 藏经阁东走廊 : /d/shaolin/cangjing_zoulang3.c

inherit ROOM;



void create() {
  set("short", "走廊");
  set("long", @LONG
这是藏经阁二楼的东走廊。走廊上一个人也没有，非常宁静，似有曲径通幽
的感觉。这里往北是藏经阁的东阁，往西走可以到达藏经阁的北阁和西阁。有一
道楼梯盘旋而下，通向藏经阁东厅。
LONG
  );
  set("exits", ([
    "down": __DIR__ "cangjing_ge1e",
    "west": __DIR__ "cangjing_zoulang2",
    "north": __DIR__ "cangjing_dongge"
  ]));

  setup();
}
