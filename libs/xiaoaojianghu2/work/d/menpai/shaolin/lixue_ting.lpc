// room:/d/shaolin/lixue_ting.c

#include <room.h>
#include <ansi.h>

inherit ROOM;



void create()
{
    set("short", CYN"立雪亭"NOR);
    set("long", @LONG
这是一座八面临风的小亭。亭子的正上方挂着一块匾额，上书“立雪亭”三
个苍劲有力的大字。亭东是供奉观音大士的白衣殿，西边是供奉地藏王菩萨的地
藏殿。出亭往南是少林僧人习武的广场，不时传来兵器交击的声响。亭北不远处
是一道院墙，正中开有一道门。墙那边就是少林寺的重地了。你抬头望向亭顶，
顶上画着一幅精巧的图画(tuhua)。
LONG
    );
    set("exits", ([ 
        "north"     : __DIR__"zhulin_xiaodao1",
        "south"     : __DIR__"zhongyang_guangchang7",
        "west"      : __DIR__"dizang_dian",
        "east"      : __DIR__"baiyi_dian",
        ]));
    set("item_desc", ([
        "tuhua"     : @TEXT
相传二祖慧可追随达摩习佛时，在一个寒风飘雪的日子里，在这里断臂明志，飞
溅的鲜血将漫天飞雪染红，终于以坚定的道心赢得了祖师的信任，得受衣钵，成
为禅宗的继承人。后人建此亭，亭顶图案描写的正是这惊心动魄的一幕。
TEXT
        ]));    
	set("objects", ([
		__DIR__"npc/heshang1" : 1,
		]) );
    setup();
    //place_program(ROOM);
}                       

