// 藏经后楼 : /d/shaolin/cangjing_houlou.c

inherit ROOM;



void create()
{
    set("short","藏经后楼大厅");
    set("long",@LONG
这是藏经后楼的底楼大厅，大厅较为宽敞，方砖铺地，厅内无甚事物。边上
有一道楼梯盘旋而上，通往二楼。这里的西南方有一个小小的出口，隐约看去，
好象通向一处秘道。
LONG
    );
    set("exits",([
        "southwest" : __DIR__"cangjing_midao",
        "up" : __DIR__"houlou_shuge",
    ]) );

    setup();
}
