// mianbi_exit.c  面壁处出口
//Hydra 19980521

inherit ROOM;

void init();



void create() {
  set("short", "面壁出口处");
  set("long", @LONG
这里是少林面壁处的出口，面壁处是少林寺惩戒违规僧众的地方。这里四面
都是坚硬的巨石堆砌起来的墙，头顶上也被封死了，不见阳光。只有正前方的墙
上有一个小洞，大小刚够一个人容身，外面隐隐约约传来说话的声音。
LONG
  );

  set("exits", ([
    "out": __DIR__ "houshan_pubu",
  ]));

  setup();
}
