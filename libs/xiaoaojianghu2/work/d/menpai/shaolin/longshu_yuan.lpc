// long shu yuan : /d/shaolin/longshu_yuan.c

inherit ROOM;



void create()
{
    set("short","龙树院");
    set("long",@LONG
这是一座很大的院子，四周围着很高很厚的围墙。院中一片寂静，间或传来
声声鸟鸣。院子的东侧长着一株高大茂密的古树，像一柱巨大坚实的屏风挡在那
里，所以这里的白天往往显得格外幽暗。往北则是龙树院的大殿，大殿的门前挂
着一块匾额(sign)。在龙树院大门之外，则有一条小径，通往竹林小道。
LONG
    );
    set("exits",([
        "southwest" : __DIR__"zhulin_xiaodao3",
        "east" : __DIR__"longshu",
        "north" : __DIR__"longshu_dadian",
    ]) );

    set("item_desc", ([
        "sign" : "龙树院\n",
    ]) );
    
    set("objects",([
        __DIR__"npc3/huizheng":1,
        __DIR__"npc/huwei"    :2,
    ]) );

    setup();
}
