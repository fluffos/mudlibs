// 藏经阁东阁 : /d/shaolin/cangjing_dongge.c

inherit ROOM;



void create() {
  set("short", "藏经阁东阁");
  set("long", @LONG
这是一间收拾得极为朴素的楼阁，中间放着一张长长的石桌，有几位僧人坐
在蒲团上正翻阅着经书。他们有的面无表情，有的冥思苦想，似乎与外面的世界
全然隔离了开来。往北是藏经阁的东阁书库，往南是一条长长的走廊。
LONG
  );
  set("exits", ([
    "south": __DIR__ "cangjing_zoulang3",
    "north": __DIR__ "cangjing_shukue",
  ]));

  set("objects", ([
    __DIR__ "npc/huwei3": 2,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  object ob;
  if (me->query("family/family_name") != "少林派"
    && dir == "north"
    && objectp(ob = present("huwei seng", this_object()))
    && living(ob)) {
    message_vision("$N拦住$n，“你不是少林弟子，不能进去！”\n",
      ob, me);
    return notify_fail("你只得收住脚步。\n");
  }
  return ::valid_leave(me, dir);
}
