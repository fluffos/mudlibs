// 藏经后楼书阁 : /d/shaolin/houlou_shuge.c

inherit ROOM;



void create() {
  set("short", "藏经后楼书阁");
  set("long", @LONG
这是一间收拾得极为朴素的楼阁，里面除了几张蒲团之外一无所有。有几位
僧人坐在蒲团上边翻阅着武功秘籍，边在冥思苦想。往北是藏经后楼的书库。沿
往着楼梯往下走，是藏经后楼的底楼大厅。
LONG
  );
  set("exits", ([
    "down": __DIR__ "cangjing_houlou",
    "north": __DIR__ "houlou_shuku",
  ]));

  set("objects", ([ /*sizeof()==3*/
    __DIR__ "npc/huwei5.lpc": 2,
    __DIR__ "npc3/huiyan.lpc": 1,
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  object ob;

  if (me->query("hydra/shaolin/allow_enter_shuku") <= 0
    && dir == "north") {
    if (objectp(ob = present("hui yan", this_object()))
      && living(ob)) {
      message_vision("$N拦住$n，“你未获方丈允许，不得进去参阅典籍。”\n",
        ob, me);
      return notify_fail("你只得收住脚步。\n");
    } else if (objectp(ob = present("huwei seng", this_object()))
      && living(ob)) {
      message_vision("$N拦住$n，“你未获方丈允许，不得进去参阅典籍。”\n",
        ob, me);
      return notify_fail("你只得收住脚步。\n");
    }
  }
  if (me->query("shaolin/qu_miji3")
    && dir == "down") {
    if (objectp(ob = present("hui yan", this_object()))
      && living(ob)) {
      message_vision("$N拦住$n，“你先把从书库取的书还回去才能离开这里。”\n",
        ob, me);
      return notify_fail("你只得收住脚步。\n");
    } else if (objectp(ob = present("huwei seng", this_object()))
      && living(ob)) {
      message_vision("$N拦住$n，“你先把从书库取的书还回去才能离开这里。”\n",
        ob, me);
      return notify_fail("你只得收住脚步。\n");
    }
  }

  if (dir == "north")
    me->add("hydra/shaolin/allow_enter_shuku", -1);
  return ::valid_leave(me, dir);
}
