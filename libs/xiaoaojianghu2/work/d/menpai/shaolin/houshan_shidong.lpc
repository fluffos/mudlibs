// hou shan shi dong : /d/shaolin/houshan_shidong.c
#include <ansi.h>
private int gain_points( object me );
private int gain_xiuwei( object me );
inherit ROOM;

void init();
int do_look(string);



void create()
{
    set("short","后山石洞");
    set("long",@LONG
这是一个小小的石洞，洞里空无一物。墙上光秃秃的，却有些人工雕琢的痕
迹。洞口挂着一道瀑布，象一道门帘，把这里和外界隔绝开来。水声淙淙，掩盖
了里外的所有声音。
LONG
    );
    set("not_startroom",1);
    set("exits", ([
        "out" : __DIR__"houshan_pubu",
    ]) );

    setup();
}


void init()
{
    add_action("can_xiu", "canxiu");
    add_action("do_look", "look");
}

int can_xiu( string arg )
{
    object me;
    me = this_player();
    if ( me->query_temp("shaolin/damo")!=3)
      return notify_fail(HIB"你是怎么进来的？去死吧！呵呵，吓唬你的！下次按照规矩进来！\n"NOR);
    if( !me->can_act() || me->is_fighting() )
        return notify_fail(HIB"你现在哪儿有心思去琢磨这个石洞的秘密，先解决自己的事情吧。\n"NOR);
    if (me->query("PKS")>10)
        return notify_fail(HIB"你杀孽太多，无法进入佛学最高境界，不配领悟佛学玄功。\n"NOR);
    tell_object( me, WHT"你惊奇的发现墙上有一些姿势各异的小人形图案，觉得有些蹊跷，便对着小人比划起来。\n"NOR);
    me->disable_command("verb", HIB"一心岂能二用！? ！\n"NOR);
    call_out("start_canxiu", 10, me );
    return 1;
}

void start_canxiu( object me )
{
    int time;

    if( !me ) return;
    if( environment(me) != this_object() )
    {
        me->enable_path();
        me->receive_damage("gin", 50 );
        return;
    }

    if( me->query_xiuwei_by_type("sword") < 5000 )
    {
        me->enable_path();
        me->receive_damage("gin", 50 );
        tell_object( me, YEL"你对着墙上那莫名其妙的图形比划了半天，累得气踹吁吁\n"
                         YEL"但一点心得也没有,想必是还没有进入佛家最高境界吧，\n"
                         YEL"没有达到心中有佛的境界怎然无法领悟佛学宗级武学:P\n"NOR);
        return;
    }
    if (!me->query_jibie("damo-jianfa"))
    {           me->enable_path();      
        me->improve_jibie("damo-jianfa", 1);
            tell_object( me, WHT"你突然感悟到图形里面所包含的那种无我的精神，。\n"NOR
                             HIG"恭喜你！你领悟到了少林至高玄功！\n"NOR
                             HIM"你的『达摩剑法』进步了！\n" NOR);
             return;
        }
    tell_object( me, WHT"你慢慢的比划着那墙上的小人儿图形，心中突然灵光一闪，慢慢的\n"
                    WHT"结合少林禅宗心法，进入佛学无为入定境界，人不再随图而动，但\n"
                    WHT"墙上的图案如天马行空般略过心头，心里也默然上升一种激动的情绪\n"
                    WHT"你痴醉其中久久不醒......\n"NOR);
    me->set_temp("block_msg/all", 1);
    time = 30 ;
    call_out("get_gain", time, me );
}

void get_gain( object me )
{
    string msg;
    int point;

    if( !me ) return;

    me->delete_temp("block_msg/all");

    if( environment(me) != this_object() )
    {
        me->enable_path();
        me->receive_damage("gin", 50 );
          return;
    }

    msg = CYN"不知道过了许久，你才从痴醉中醒来，发现你已经被深深地吸引住了。\n"NOR;
    if ( me->query_lingwu_ratio( "damo-jianfa" )<90)
    {       point=0;
            msg += WHT"只感到墙上的图案真是是玄妙万分，却仅仅只是莫名其妙的激动，\n"
               "却不只所以然，但刚才的经历却让你此生难忘。\n" NOR;
     }
    else if ( me->query_jibie( "damo-jianfa" )>199)
    {       point=0;
            msg += WHT"只觉得墙上的一招仪式都已经了熟于心了。\n" NOR;
     }     
    else {
    point = me->query_xiuwei("sword")/1500-3;
    msg += HIM"只觉得这墙上的图形舒缓了你长期以来心中的心结，使得你的心境更加\n"
               "开阔,佛学修为更加精深，由此对『剑道』的理解也就更深了一层。\n" NOR; 
        if( !me->query_jibie("damo-jianfa") )
            msg += HIM"你通过领悟图形中的感动终于明白这是达摩祖师传下来的剑法\n"NOR;
     
        msg += HIG "你的『达摩剑法』进步了！\n" NOR;
        me->improve_jibie("damo-jianfa", 1);
        me->improve_xiuwei("sword", point ); 
        msg += HIW"你的〖 剑 术 〗的修为有所提高。"NOR;
            me->improve_xiuwei("zonggang", random(point) );        
            msg += HIW"在〖 武 学 〗上的造诣也更深了。\n"NOR;
    }
    
    tell_object( me, msg );
    me->receive_damage("gin", 100);
    me->enable_path();
}

int do_look(string arg)
 {
    object me = this_player();

    if (arg != "wall" ) return command("look "+arg);

    message_vision(HIR"上面有很多姿势各异的小人儿在比划些什么。\n"NOR, me);

    return 1;
}
int valid_leave(object me,string dir)
{

        if ( dir!="out" ) return 1;
         message_vision("$N看准旁边一块突出的岩石，一跃而起，跳了上去。\n",me);
            return 1;

}
