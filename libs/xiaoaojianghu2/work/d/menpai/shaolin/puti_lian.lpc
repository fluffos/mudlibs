
#include <ansi.h>
inherit ROOM;



void create()
{
        set("short", YEL"菩提武场"NOR);
        set("long", @LONG
这里就是菩提院的练武场，四周建造有三个僧舍，是供僧人们练功的
地方，罗汉堂为菩提院提供了一些武僧作为陪练。少林的僧人可以来这里
请一些师兄来陪自己练武
LONG
        );
       set("no_quit",1);
       set( "not_startroom",1 );
        set("exits", ([
                 "north":__DIR__"xianglong",
                 "west":__DIR__"mile",
                 "east":__DIR__"puti_yuan",
                 "south":__DIR__"fuhu",               
        ]));
        
        setup();

}

int valid_leave(object me, string dir)
{
      if ( dir=="east" ) 
       {
        if( me->query("marks/少林/陪练A") > 0 )
        {
  
        return notify_fail(HIR + "请先回到你请过陪练师兄的地方，用(qing hui)请师兄回去休息后才能离开。\n" + NOR);
          }
        if( me->query("marks/少林/陪练B") > 0 )
        {
  
        return notify_fail(HIR + "请先回到你请过陪练师兄的地方，用(qing hui)请师兄回去休息后才能离开。\n" + NOR);
          }
        if( me->query("marks/少林/陪练C") > 0 )
        {
  
        return notify_fail(HIR + "请先回到你请过陪练师兄的地方，用(qing hui)请师兄回去休息后才能离开。\n" + NOR);
          }
       }
       return 1;
}
