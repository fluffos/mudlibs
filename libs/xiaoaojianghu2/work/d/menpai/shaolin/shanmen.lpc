// Room: /d/shaolin/shanmen.c

//Hydra added check_break_law at 19980519

#include <room.h>
#include <ansi.h>
inherit ROOM;

void greeting(object);
int check_break_law( object );



void create()
{
    set("short", CYN"少林寺山门"NOR);
    set("long",@LONG
兴建于北魏的百年名寺少林寺，自唐少林得朝廷荫庇而发扬光大后，少林武
功、佛法名满天下。经数百年而流传不衰。在十七级青石垂带式台阶上是两扇厚
重的山门。山门用厚厚的杉木制成，上面包铜，镶满巨大的铜钉。
    山门正上方悬着一块黑漆大匾，上面写着

LONG
"                " BBLK YEL "※※※※※※※※※※※※※※※" NOR "\n"
"                " BBLK YEL "※※" RED "    少    林    寺    " YEL "※※" NOR "\n"
"                " BBLK YEL "※※※※※※※※※※※※※※※" NOR "\n"
@LONG

三个大字。字迹苍劲挺拔，相传为唐王李世民所题。虽年代久远依然光彩夺目。
门口有两头巨大的青石雄狮，石狮旁站着两个高大威猛的僧人。
LONG    );

    set("exits", ([
        "north" : __DIR__"dadao2",
        "south" : __DIR__"shanmen_guangchang",
    ]));
    set("objects", ([
        __DIR__"npc/xuzhao" : 1,
        __DIR__"npc/xuyuan" : 1,
    ]));

    set("outdoors", "shaolin");
    setup();
}

int valid_leave(object me, string dir)
{
    object *inv;
    mapping myfam;
    int i;
    string msg;

    msg="";
    if (me->query("gender") == "女性" && dir == "north" ) 
	{
        if(objectp(present("xu yuan", environment(me))))
            msg += "虚缘伸手拦住你白眼一翻说道：“数百年以来，少林向不许"
                "女流擅入。\n" + RANK_D->query_respect(me) +"请下山去吧，免得"
                "自讨没趣。”\n";
        if(objectp(present("xu zhao", environment(me))))
            msg += "虚照迈步挡在你身前，双手合什说道：“阿弥陀佛，"
                "这位" + RANK_D->query_respect(me) + "请留步，\n恕小寺不接待女"
                "客。女施主倘若一心向佛，何妨去峨眉山随喜？”\n";
        if (msg!="") return notify_fail(msg);
    }

    myfam = (mapping)me->query("family");

    if ((!myfam || myfam["family_name"] != "少林派" ) && dir == "north") 
	{
        inv = deep_inventory(me);
        for(i=sizeof(inv)-1; i>=0; i--)
            if(inv[i]->query("weapon_prop"))
            {
               if(objectp(present("xu yuan", environment(me))))
                   msg += "虚缘拦住你说道：“这位"+RANK_D->query_respect(me) + 
                       "请放下兵刃。少林数百年的规矩，外客\n不得持兵刃上山。”\n";
               if(objectp(present("xu zhao", environment(me))))
                   msg += "虚照迈步挡在你身前，双手合什说道：“阿"
                        "弥陀佛，这位" + RANK_D->query_respect(me) + "请收起"
                        "\n兵刃。佛门清静之地，不便随意舞刀弄剑。还请施主见谅。”\n";
                if(msg!="") return notify_fail(msg);
            }
    }
    if ( myfam && (myfam["family_name"] == "少林派") 
        && ( ! me->query("lnwm/pass_muren"))
        && dir == "south" ) 
    {
        if(objectp(present("xu yuan", environment(me))))
            msg += "虚缘伸手拦住你白眼一翻说道："
                "“木人巷都没过就想下山？哪有这么\n便宜的事？”\n";
        if(objectp(present("xu zhao", environment(me))))
            msg += "虚照迈步挡在你身前，双手合什说道：“这位师弟请留步，"
                "本寺的规\n矩从来都是打过木人巷之后才能下山的。”\n";
        if(msg!="") return notify_fail(msg);
    }
    
    if ( myfam && (myfam["family_name"] == "少林派") 
         && dir == "north" && check_break_law( me ) ) 
    {
        if(objectp(present("xu zhao", environment(me))))
        {
            message_vision( CYN"虚照对$N说道：戒律院首座让你到戒律院去一趟，禀"
"告有无违反戒律。\n"NOR,me );
            return 1;
        }
        if(objectp(present("xu yuan", environment(me))))
            message_vision( CYN"虚缘对$N说道：戒律院首座让你到戒律院去一趟，禀"
"告有无违反戒律。\n"NOR,me );
        return ::valid_leave( me,dir );
    }
    //Hydra added at 19980519 for penalty
    if ( myfam && (myfam["family_name"] == "少林派") 
        && me->query("shaolin/announced")
        && dir == "south" ) 
    {
        if(objectp(present("xu yuan", environment(me))))
            msg += "虚缘伸手拦住你白眼一翻说道："
                "“违反了戒律还想下山？想逃跑吗？”\n";
        if(objectp(present("xu zhao", environment(me))))
            msg += "虚照迈步挡在你身前，双手合什说道：“这位师弟请留步，"
                "还是先去戒律院一趟吧”\n";
        if(msg!="") return notify_fail(msg);
    }
    if ( me->query("shaolin/kickout")
        && dir == "north" ) 
    {
        if(objectp(present("xu yuan", environment(me))))
            msg += "虚缘伸手拦住你白眼一翻说道："
                "“被逐出山门还有脸回来！”\n";
        if(objectp(present("xu zhao", environment(me))))
            msg += "虚照迈步挡在你身前，双手合什说道：“这位"+RANK_D->query_respect(me)
            +"请留步，被逐出山门\n的弟子是不允许再回少林的。”\n";
        if(msg!="") return notify_fail(msg);
    }        
    //Hydra added 19980517 for jina players who killed in shaolin
    //If there is xianglong or fuhu luohan is killing him
    if( me->query_temp("shaolin/being_jina") && dir == "south" )
    {
        if(present("hui si",environment(me)))
            return notify_fail("慧思拦在你前面，杀了人想跑吗？\n");
        if(present("hui tong",environment(me)))
            return notify_fail("慧通拦在你前面，杀了人想跑吗？\n");
        return ::valid_leave( me,dir );
    }
    
    return ::valid_leave(me, dir);
}

//Hydra added at 19980519
//判断少林弟子是否违反杀戒
int check_break_law( object ppl )
{
    int PKS,MKS;    
    int last_penalty_age,age;               //last penalty age
    int last_penalty_PKS,last_penalty_MKS;
    PKS = ppl -> query( "PKS" );
    MKS = ppl -> query( "MKS" );
    last_penalty_age = ppl -> query("shaolin/last_penalty_age");
    age = ppl -> query("age");
    last_penalty_PKS = ppl -> query("shaolin/last_penalty_PKS");
    last_penalty_MKS = ppl -> query("shaolin/last_penalty_MKS");
    
    if( ppl -> query("shaolin/announced") )
        return 1;
    
    //PK数量不能大于10
    //如果因PK而受过处罚，last_penalty_PKS!=0，以后的PKS不能超过上次那个数
    if( ! last_penalty_PKS )
    {
        if( PKS > 10 )
        {
            ppl -> set("shaolin/announced","because_pk");
            return 1;
        }    
    }
    else
    {
        if( PKS > last_penalty_PKS +2)
        {
            ppl -> set("shaolin/announced","because_pk");
            return 1;
        }
    }
    //允许MKS数量sqrt(age-13)*80，开始允许较多，以后减少
    //年龄<=16 不作惩罚
    if( !last_penalty_MKS )
    {
        if( MKS > sqrt(age-14)*80 && age > 15 )
        {
            ppl -> set("shaolin/announced","because_mk");
            return 1;
        }
    }
    else
    {
        if( age != last_penalty_age && (MKS-last_penalty_MKS)  > 
            ( sqrt(age-13)*100 - sqrt(last_penalty_age-13)*100 ) 
            && sqrt(age-13) > sqrt(last_penalty_age-13) )
        {
            ppl -> set("shaolin/announced","because_mk");
            return 1;
        }
    }
    return 0;
}
