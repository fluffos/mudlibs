#include <ansi.h>
inherit __DIR__"wuseng.lpc";



void create()
{
    set_name(RED"武僧"NOR, ({ "wu seng","seng","monk" }) );
    set("age",30 );
    set_wugong("duoluoye-zhi",44,44,1);
    set_xiuwei_by_type("unarmed",1200+random(500));
    set_wugong("shaolin-shenfa",100,100,1);
    set_xiuwei_by_type("dodge",1200+random(500));
    set("max_force",1000+random(1000));
    set("force",1000+random(1000));
    set("combat_exp",100000+random(100000));

    setup();
    carry_object( CLOTH_DIR "sengyi3")->wear();
}

