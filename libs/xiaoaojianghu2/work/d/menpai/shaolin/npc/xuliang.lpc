#include <ansi.h>

inherit __DIR__ "xu";



void create() {
  set_name("虚亮", ({ "xu liang", "xu", "liang", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
    一个看起来比较木讷的和尚，好象颈椎练功受过什么伤，所以脖子老是直直地
挺着，转头时不是扭头，而是连脖子一起慢慢地转过来，让你看着都觉得累。不过
虚亮脾气很好。大家拿他开玩笑他也不生气。
LONG
  );
  set("age", 25);

  set("max_force", 700 + random(100));
  set("force", 700 + random(100));

  set_wugong("luohan-quan", 80, 80, 1);
  set_wugong("weituo-zhang", 80, 80, 1);
  set_wugong("jiben-gunfa", 100, 100, 0);
  set_wugong("yuanhou-gun", 70, 70, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_xiuwei_by_type("unarmed", 280);
  set_xiuwei_by_type("dodge", 280);
  set_xiuwei_by_type("long", 500);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
  carry_object(WEAPON_DIR "long/qimei_gun")->wield();
}
