#include <ansi.h>
inherit __DIR__"wuseng.lpc";



void create()
{
    set_name(YEL"年轻武僧"NOR, ({ "nianqing wuseng","seng","monk" }) );
    set("age",18);

    set_wugong("luohan-quan"    ,100);
    set_wugong("shaolin-shenfa" , 70);
    
    set_xiuwei_by_type("unarmed",200);
    set_xiuwei_by_type("dodge"  ,170);

    setup();
    carry_object( CLOTH_DIR "sengyi1")->wear();
}

