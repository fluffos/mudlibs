#include <ansi.h>

inherit __DIR__"xu";



void create()
{
    set_name("虚若", ({ "xu ruo", "xu", "ruo", "he shang", 
                        "seng ren", "bonze", "monk" }) );
    set("long",	@LONG
    虚若看起来有些木讷，但做事很有恒心，所以很得器重。
LONG
    );
    set("age", 36 );

    set( "max_force", 700 + random (100) );
    set( "force", 700 + random (100) );
    set( "force_factor", 20);

    set_wugong("luohan-quan",80,80,1);
    set_wugong("shaolin-shenfa",80,80,1);
	set_wugong("cibei-dao", 80,80,1);
	set_wugong("blade", 120);
    set_xiuwei_by_type("unarmed",400);
    set_xiuwei_by_type("dodge",400);
	set_xiuwei_by_type("blade", 500);

    setup();
    carry_object(CLOTH_DIR "sengyi1") -> wear();
	carry_object( CLONE_DIR + "weapon/blade/jiedao" )->wield();
}
