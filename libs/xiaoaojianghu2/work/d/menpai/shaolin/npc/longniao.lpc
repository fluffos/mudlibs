// long niao : /d/shaolin/npc/longniao.c

inherit NPC;



void create() {
  set_name("龙鸟", ({ "long niao", "bird", "niao" }));
  set("race", "野兽");
  set("age", 10);
  set("long", "一只凶狠的大鸟。\n它双目如电，似乎想要把你撕成碎片！\n");

  set("attitude", "aggressive");
  set("limbs", ({ "头部", "身体", "左翅", "右翅", "尾巴" }));
  set("verbs", ({ "bite" }));

  set("combat_exp", 50000);
  set("env/wimpy", 0);

  set("chat_chance", 4);
  set("chat_msg", ({
    "龙鸟用一种凶狠的目光注视着你。\n"
    "龙鸟对天长啸，发出一阵尖利的叫声----\n",
  }));
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/damage", 40);
  set_temp("apply/armor", 100);

  setup();
}
