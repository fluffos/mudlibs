#include <ansi.h>

inherit __DIR__"xu";



void create()
{
    seteuid( getuid() );
    set_name("虚静", ({ "xu jing", "xu", "jing", "he shang", 
                        "seng ren", "bonze" }) );
    set("long", @LONG	
    虚静的武功在罗汉堂顶多算中游水平，但却是少有用功的几个之一，每天除
早午晚三课的时间，他几乎都在不停地练拳。晚上也常常打坐练功到深夜。方丈
感他执着，常常亲自指点他两招。
LONG
    );
    set( "age", 26 );

    set( "max_force", 400 + random (50) );
    set( "force"    , 400 + random (50) );

    set_wugong("luohan-quan"    , 80, 80,1);
    set_wugong("weituo-zhang"   , 80, 80,1);
    set_wugong("shaolin-shenfa" , 60, 60,1);
    set_wugong("fumo-jian"      ,60,60,1);
    set_xiuwei_by_type("unarmed" ,250);
    set_xiuwei_by_type("dodge"   ,250);

    set("social_exp",  2000);

    setup();
    carry_object(CLOTH_DIR "sengyi1") -> wear();
}
