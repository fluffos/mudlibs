inherit __DIR__"guard.lpc";



void create()
{
    set_name("灰衣护卫僧", ({ "huwei seng","seng","monk", "guard", "monk guard" }) );
    set( "age", 35+ random(10));
    create_family("少林派", 37, "弟子");

    set_wugong("unarmed",100,100,0);
    set_wugong("weituo-zhang",100,100,1);
    set_wugong("fuhu-quan",108,108,1);
    set_wugong("shaolin-shenfa",80,100,1);
    set_wugong("shaolin-neigong",60,100,1);
    set_xiuwei_by_type("unarmed" ,800);
    set_xiuwei_by_type("dodge"   ,800);
    
    setup();
    carry_object(CLOTH_DIR "sengyi3") -> wear();
}
