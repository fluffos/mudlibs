inherit NPC;


void create()
{
    set_name("练武僧人", ({ "lianwu seng","seng","monk" }) );
    set("gender", "男性" );
    set("class","bonze");
    set("age",23);
    create_family("少林派", 38, "弟子"); 
set("title", 0);
	set( "chat_chance", 6 );
	set("chat_msg", ({
			"练武僧人举起了一个石锁，脸憋得通红。\n",
			"练武僧人坐到旁边，开始歇息。\n",
			"练武僧人挠了挠头：这招到底怎么出好呢？\n",
			}) );
    set_wugong("unarmed", random(100));
    set_wugong("jiben-qinggong",random(100));
    set_xiuwei("dodge",100 + random(200));
    set_xiuwei("unarmed",100 + random(200));
        set("social_exp",2000);
        set("combat_exp",10000);
        setup();
}

