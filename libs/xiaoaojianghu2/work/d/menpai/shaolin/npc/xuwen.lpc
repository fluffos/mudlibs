// Filename : /d/menpai/shaolin/npc/xuwen.c

#include <ansi.h>

inherit __DIR__ "xu";

int ask_armor1();
int ask_armor2();
int ask_armor3();



void create() {
  set_name("虚闻", ({ "xu wen", "xu", "wen", "he shang",
    "sen ren", "bonze" }));
  set("long", "据说虚闻修习内功相当刻苦，再加上他根骨也相当出众，\n"
    "比起普通的虚字辈同门来说，他已经远远超出许多了。\n");

  set("age", 23);

  set("max_force", 800 + random(100));
  set("force", 800 + random(100));
  set("force_factor", 10);

  set_wugong("luohan-quan", 80, 80, 1);
  set_wugong("weituo-zhang", 80, 80, 1);
  set_wugong("fuhu-quan", 30, 29, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_wugong("shaolin-neigong", 80, 80, 0);
  set_xiuwei_by_type("unarmed", 310);
  set_xiuwei_by_type("dodge", 310);

  set("social_exp", 8000);

  set("inquiry", ([
    "袈裟": (: ask_armor1 :),
    "僧鞋": (: ask_armor2 :),
    "绑腿": (: ask_armor3 :),
  ]));
  setup();
}

int ask_armor1() {
  object me, ob, armor;
  string my_id;
  int mud_age;

  ob = this_object();
  me = this_player();
  my_id = me->query("id");
  mud_age = me->query("mud_age");

  if (present("jiasha", me)) {
    say("虚闻眉头一皱，说道：“你不已经有一件袈裟了吗？”\n");
    command("shake " + my_id);
    return 1;
  }

  if (present("jiasha", environment(ob))) {
    say("虚闻说道：“地上这不有一件吗？ 你要的话就捡走吧。”\n");
    command("look " + my_id);
    return 1;
  }
  /*
    last_get = (int) me->query_temp("/mark/shaolin/jiasha_time");      
    nowtime = mud_age - last_get;
    if ( nowtime < 500 )
    {
        say("你不是刚刚才要过袈裟吗？ \n");
        command( "heng " + my_id );
        return 1;
    }
	
    me->set_temp("/mark/shaolin/jiasha_time",mud_age);
*/
  armor = new(__DIR__ "obj/jiasha1");
  armor->move(me);
  message_vision("$N交给$n一件土黄袈裟。\n", ob, me);

  return 0;
}
