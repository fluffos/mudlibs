#include <ansi.h>

inherit __DIR__ "xu";



void create() {
  seteuid(getuid());
  set_name("虚音", ({ "xu yin", "xu", "yin", "he shang",
    "seng ren", "bonze" }));
  set("title", "和尚院僧人");
  set("long", @LONG
虚音是虚字辈人缘最好的一个，他入寺时间长，又不以老字辈倨傲。相反却常常帮助
刚刚入寺的小弟子，十分热心，大家都很喜欢他。
LONG
  );

  set("age", 38);

  set("max_force", 800 + random(100));
  set("force", 800 + random(100));

  set_wugong("luohan-quan", 80, 80, 0);
  set_wugong("weituo-zhang", 80, 80, 0);
  set_wugong("fuhu-quan", 100, 100, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_wugong("jiben-gunfa", 80, 60, 1);
  set_wugong("yuanhou-gun", 60, 40, 1);
  set_wugong("shaolin-neigong", 80, 80, 1);
  set_xiuwei_by_type("unarmed", 750);
  set_xiuwei_by_type("dodge", 550);
  set_xiuwei_by_type("long", 500);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}
