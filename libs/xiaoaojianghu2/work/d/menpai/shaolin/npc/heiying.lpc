// hei ying : /d/shaolin/npc/heiying.c

inherit NPC;

void die();



void create()
{
    set_name("黑鹰",({"hei ying","ying","hawk"}));
    set("race","野兽");
    set("age",10);
    set("long","一只凶狠的老鹰。\n它双目如电，似乎想要把你撕成碎片！\n");

    set("attitude", "aggressive");
    set("limbs", ({ "头部", "身体", "左翅", "右翅", "尾巴" }) );
    set("verbs", ({ "bite" }) );

    set("combat_exp", 50000);

    setup();
}

void die()
{
	object ob;
	message_vision("$N哀号了几声，死了。\n", this_object());
	message_vision("鸟窝里隐隐可以看见，有一只很大的黑鹰蛋。\n",this_player());
	ob = new(__DIR__"obj/yingdan");
	ob->move(environment(this_object()));
	destruct(this_object());
}
