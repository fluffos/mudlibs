inherit __DIR__ "seng.lpc";



void create() {
  set_name("诵经和尚", ({ "songjing heshang", "heshang", "monk" }));
  set("age", 35 + random(10));
  set("chat_chance", 3);
  set("chat_msg", ({
    "诵经和尚手里捧着一本经书，喃喃地诵念着。\n",
    "诵经和尚虔诚地俯身一拜，又接着诵读经文。\n",
  }));
  set_wugong("unarmed", 50, 50, 1);
  set_wugong("jiben-qinggong", 50, 50, 1);
  set_xiuwei("dodge", 50);
  set_xiuwei("unarmed", 50);
  setup();
  carry_object(CLONE_DIR + "book/jingwen");
}
