inherit __DIR__ "seng.lpc";



void create() {
  set_name("扫地僧人", ({ "saodi sengren", "seng", "sengren" })); set("chat_chance", 3);
  set("chat_msg", ({
    "扫地僧人拿了一把扫帚，在不紧不慢地扫地。\n",
  }));
  set("age", 100);
  set("per", 40);
  set("combat_exp", 90000000);
  set_wugong("yijing", 150, 150);
  set_wugong("luohan-quan", 1000, 1000, 1);
  set_force(8000, 8000, 800);
  set_xiuwei("unarmed", 25001);
  set_xiuwei_by_type("zonggang", 25001);
  setup();
}
