inherit __DIR__"seng.lpc";



void create()
{
    set_name("捣药和尚", ({ "daoyao heshang","heshang","monk" }) );
	set_wugong("unarmed",50,50,1);
	set_wugong("jiben-qinggong",30,30,1);
	set_xiuwei("dodge",70);
	set_xiuwei("unarmed",70);
    setup();
//    carry_object(__DIR__"obj/cloth4")->wear();
}
              
void init()
{
        object ob;
        ::init();
        if(interactive(ob=this_player()) && !is_fighting()){
            remove_call_out("greeting");
            call_out("greeting",1,ob);
            }
}

void greeting(object ob)
{
    if(!ob||!present(ob,environment(this_object()))) return;
    message_vision("捣药和尚抬起头看了$N一眼。\n", ob);
}