inherit __DIR__"seng.lpc";



void create()
{
    set_name("扫地和尚", ({ "saodi heshang","heshang","monk" }) );
    set("chat_chance", 3 );
    set("chat_msg", ({
        "扫地和尚拿了一把扫帚，在不紧不慢地扫地。\n",
        "扫地和尚站起身来，捶了捶腰。\n",
        (: random_move :)
        }) );
    set_wugong("unarmed",30,30,1);
    set_wugong("jiben-qinggong",10,10,1);
    set_xiuwei("dodge",30);
    set_xiuwei("unarmed",30);
    setup();
//    carry_object(__DIR__"obj/cloth4")->wear();
}

