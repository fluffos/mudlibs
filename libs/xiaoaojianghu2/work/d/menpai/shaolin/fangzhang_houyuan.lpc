// fang zhang jing she hou yuan : /d/shaolin/fangzhang_houyuan.c

inherit ROOM;

void init();
int do_look(string);
int do_enter(string);



void create()
{
    set("short","方丈精舍后院");
    set("long",@LONG
这里是方丈精舍的后院，竹影梅枝掩映，四季清翠，四周静得可以听见竹叶
落到地上的声音。有一条幽幽小径通往东去，那里隐隐约约可以看到一间石屋的
一角。那是一间既没有门，也没有窗的石屋(shiwu) ，很少有人知道它的存在，
更不用说如何走入了。后院往南可以回到书房。
LONG
    );
    set("exits",([
        "south" : __DIR__"fangzhang_shufang",
    ]) );

    setup();
}

void init()
{
    add_action("do_look", "look");
    add_action("do_enter", "enter");
}


int do_look(string arg)
{
    object me = this_player();

    if (arg != "shiwu") return command("look "+arg);

    if( me->query_temp("marks/关2") ) 
        message_vision("方丈石屋--历代方丈闭关处。\n",me);
    else
    {
        message_vision("一间既没有门，也没有窗的石屋。\n",me);
        me->set_temp("marks/关1", 1);
    }

    return 1;
}

int do_enter(string arg)
{
    object me = this_player();

    if (arg != "shiwu") return command("enter "+arg);

    if( me->query_temp("marks/关2") ) 
    {
        me->set_temp("marks/关1", 0);
        me->set_temp("marks/关2", 0);
        message_vision("$N走进了方丈石屋，闭关静修。\n",me);
        me->move(__DIR__"fangzhang_shiwu");
    }
    else
    {
        message_vision("你想要干什么？\n",me);
    }

    return 1;
}
