inherit ROOM;



void create()
{
	set("short", "御碑亭");
	set("long", @LONG
这里有一座八角形的亭子，它就是著名的御碑亭了。亭子里有一块石碑，相
传是唐太宗李世民亲自撰写的碑文，记载了少林武僧的救驾护主的英雄事迹。由
于石碑保护的很好，所以碑文依然十分清楚。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
		"west" : __DIR__"qingshi-lu1.lpc",
	]));
	setup();
}

void init()
{
        add_action("ca_bei", "ca");
}

int ca_bei(string arg)
{
        object me;
        me = this_player();
        if( !arg || ( arg != "碑" && arg != "bei" ) )
            return notify_fail("你要擦什么？\n");

        if( !me->can_act() ) return notify_fail("你现在无法擦洗石碑。\n");

        if( arg == "碑" || arg == "bei" )
        {
             if( query_temp_marks("cabei_times") >= 5 )
             return notify_fail("这块石碑已经被擦的干干净净了。\n");
             if( (int)me->query("sen") < 30 )
             return notify_fail("你现在太累了，先休息一会吧。\n");
             else
             {
                tell_object(me,"你拿起一块湿抹布，擦起石碑来。\n"
                                "石碑上的字迹已经很模糊了。\n");
                add_temp_marks("cabei_times", 1);
                me->disable_command("verb", "你正在擦洗石碑呢。");
                call_out("done_cabei",4,me);
                return 1;
              }
        }
}

int done_cabei( object me )
{
    mapping quest;
    tell_object(me,"石碑终于被你擦得焕然一新。\n");
    me->receive_damage("sen",30);
    me->enable_path();
    if( quest = me->query("quest") )
    {
        if( quest["quest"] == "擦石碑" )
            me->set("done_quest", "擦石碑" );
        return 1;
    }
    return 1;
}

