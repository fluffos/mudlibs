// fang zhang chan fang : /d/shaolin/fangzhang_chanfang.c

inherit ROOM;

void init();
void close(object room);
int do_move(string);



void create() {
  set("short", "方丈禅房");
  set("long", @LONG
这里是方丈日常起居的禅房。屋中摆设十分简洁，除了一蒲团一书几外别无
它物。几上放有一册厚厚的经书，书页也有些泛黄了。北边墙上挂有一张达摩坐
禅图(damotu)，往西则回到大厅。
LONG
  );
  set("exits", ([
    "west": __DIR__ "fangzhang_hall",
  ]));

  set("item_desc", ([
    "damotu": "画上达摩祖师正在面壁打坐\n",
  ]));

  setup();
}

void init() {
  add_action("do_move", "move");
}

int do_move(string arg) {
  object me = this_player();

  if (arg != "damotu") return command("move " + arg);

  message_vision("$N将墙上的达摩图拉开。\n", me);
  message_vision("$N墙上顿时出现一个入口。\n", me);

  set("exits/north", __DIR__ "fangzhang_mishi");

  remove_call_out("close");
  call_out("close", 5, this_object());

  return 1;
}

void close(object room) {
  message("vision", "一阵风吹过，达摩图又将入口掩上了。\n", room);
  room->delete("exits/north");
}
