// 藏经后楼书库 : /d/shaolin/houlou_shuku.c

#include <ansi.h>
inherit ROOM;



void create() {
  set("short", "后楼书库");
  set("long", @LONG
这里是藏经后楼的书库，少林七十二技中的高深功夫的秘籍大部分藏在这里
。书库中间和四周墙边密密地排满了书架(shelf)。 书架上的书放得整整齐齐，
显得多而不乱。你一进门就看见门口立着一个牌子(sign)。
LONG
  );
  set("exits", ([
    "south": __DIR__ "houlou_shuge",
  ]));
  set("not_startroom", 1);
  set("item_desc", ([
    "shelf": "书架上摆满了武功秘籍。\n",
    "sign": "少林弟子过罗汉阵方可来此研读武学秘籍。\n",
  ]));
  setup();
}

void reset() {
  string s_obj;
  ::reset();
  switch (random(21)) {
    case 0:
      s_obj = __DIR__ "book/jingangzhangfa";
      break;
    case 1:
      s_obj = __DIR__ "book/nianhuazhi-jue";
      break;
    case 2:
      s_obj = __DIR__ "book/ranmudaofa";
      break;
    case 3:
      s_obj = __DIR__ "book/weituochu";
      break;
    case 4:
      s_obj = __DIR__ "book/wuxiangjiezhi-pu";
      break;
    case 5:
      s_obj = __DIR__ "book/xumizhang";
      break;
    case 6:
      s_obj = __DIR__ "book/luowanggun";
      break;
    case 7:
      s_obj = __DIR__ "book/longzhuashou";
      break;
    default:
      s_obj = __DIR__ "obj/fozhu";
      break;
  }
  set("search_things", ([
    "书架": s_obj,
  ]));

}
