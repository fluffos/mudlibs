// muren_xiang/exit.c

inherit ROOM;



void create()
{
    set("short","木人巷出口");
    set("long",@LONG
这里就是木人巷的出口了，有石阶通向地面。你入巷时被拿走的物品都堆放
在这里。如果你是成功的打出来的话，那么从这里出去你就可以拜一个真正的师
父啦！如果你是被木人打出来的话，也别灰心，再努力吧，争取下次过关。
LONG);
    set("exits", ([
	//    "up" : "/d/menpai/shaolin/luohan_tang1",
	]) );
    set( "not_startroom", 1 );
    setup();
}

void init()
{
    add_action("do_get", "get");
    add_action("do_drop", "drop");
    add_action("do_quit", "quit");
    call_out( "get_all", 1 );
    call_out( "do_greet", 2, this_player() );
}

int do_quit(string arg)
{
    write("临阵脱逃？逃不掉啦，打吧！\n");
    return 1;
}

void do_greet(object me)
{
    object ob;
    object this;
    string msg;
    int room_index;
    ob = me->query_temp( "huilun" );
    this = this_object();
    room_index = this->query("room_index");
    if ( objectp( ob ) )
    {
		ob->delete_call_murenxiang();
	}

    if ( !me->query_temp( "be_defeated" ) )
    {
        tell_object(me,@LONG
恭喜你终于闯过了木人巷，可以正式成为少林弟子了！去找师傅吧... 哈哈....
LONG);
        me->set("lnwm/pass_muren",1);
        msg = sprintf( "少林寺第" +
            CHINESE_D->chinese_number( me->query("family/generation") ) +
            "代弟子" + me->name() + "闯过木人巷八关。");
            CHANNEL_D->do_channel( me, "chat", msg );  
        LOG_D->do_log( me,sprintf("经过努力，你顺利地闯过了少林寺木人巷。"));
    }
    me->delete_temp("be_defeated");
	me->move( "/d/menpai/shaolin/luohan_tang1" );
    return;
}

int do_get(string arg)
{
    write("拣什么拣？是你的吗？！当和尚还这么贪财？！！\n");
    return 1;
}

int do_drop(string arg)
{
    write("怎么一点好习惯都没有啊？不要乱丢垃圾！\n");
    return 1;
}

void get_all()
{
    object me, *inv, env;
    int i;
    me = this_player();
    env = environment(me);
    inv = all_inventory(env);

    for(i=1;i<sizeof(inv);i++)
    {
        if (!inv[i]->is_character())  inv[i]->move(me);
    }
    
    if ( me->can_act() )
    {
        message_vision("$N从地上拣起了属于自己的东西。\n",me);
    }
    else
    {
    message_vision("一位年轻僧人拣起了$N的东西，塞到了昏迷不醒的$N身上。\n",me);
    }

}
