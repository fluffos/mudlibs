//nianhuazhifa.c拈花指法
//dou
inherit ITEM;

//Added hydra 98/10/7
int invalid_study(object me) {
  if (me->query("shaolin/can_read_miji") <= 0) {
    tell_object(me, "你发现你现在的佛法难于化解你习武带来的戾气，结果什么"
      + "都没有学习进去\n");
    return 1;
  } else {
    me->add("shaolin/can_read_miji", -8);
    return 0;
  }
}



void create() {
  set_name("拈花指诀", ({ "nianhua zhijue", "zhi jue", "shu" }));
  set_weight(600);
  set("cant_sell", "这么一本破书，你还拿来卖！\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书看起来已很破旧，书页已发黄卷曲，这就是少林的绝学“拈花指” \n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
      //提高技能的名字
      "name": "nianhua-zhi",
      //该player的修为必须大于xiuwei_required
      "xiuwei_required": 1600,
      //该player的literate必须大于literate_required,否则读不懂。
      "literate_required": 100,
      //每次耗的经神
      "gin_cost": 11 + random(10),
      //能读到的最高级别。
      "max_jibie": 160,
      //如果这本书是长级别的，那麽不再判断领悟比
      //是否小于<90,否则就当领悟比小于<90,必须去练了。
      "bonus _jibie": 0,
      //每次获得的修为
      "bonus_xiuwei": 0,
      //最高可获得的修为，即当player修为大于
      //max_xiuwei就不能再长修为了。
      "max_xiuwei": 1700,
      //以下是长combat_exp和social_exp,和修为类似
      "bonus_combat_exp": 20,
      "max_combat_exp": 25000,
      "bonus_social_exp": 20,
      "max_social_exp": 25000,
    ]));
  }
}
