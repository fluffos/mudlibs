inherit ROOM;



void create() {
  set("short", "走廊");
  set("long", @LONG
这是藏经阁二楼的走廊。走廊上一个人也没有，非常宁静，似有曲径通幽
的感觉。往北一直通往藏经阁的北阁，往西走可以到达藏经阁的西阁，往东走
可以通向藏经阁的东阁。
LONG
  );
  set("exits", ([
    "west": __DIR__ "cangjing_zoulang1",
    "east": __DIR__ "cangjing_zoulang3",
    "north": __DIR__ "cangjing_zoulang4",
  ]));
  set("objects", ([
    __DIR__ "npc/super": 1,
  ]));

  setup();
