#include <ansi.h>

inherit ROOM;



void create()
{
	set("short", CYN"大雄宝殿"NOR);
	set("long", @LONG
少林的大雄宝殿。是少林僧人们日常早午晚三课念经修行的地方。大殿正中
央高高在上供奉着佛祖释迦牟尼的金身塑像。佛祖神态安详，双目微合，安坐于
莲花台之上。左右两边供着文殊和观音两位菩萨立像。每到清晨，僧人们坐早课
之时，整个大殿里青烟缭绕，整洁肃穆，僧人们端坐于蒲团之上。梵唱之声直入
云霄。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
		"north": __DIR__"fatang.lpc",
		"west" : __DIR__"babu-tianlong1.lpc",
		"east" : __DIR__"babu-tianlong2.lpc",
		"south": __DIR__"qingshi-lu1.lpc",
	]));
	set("objects", ([
		__DIR__"npc/heshang3" : 2,
		]) );
	set( "need_clean", "少林派");
	setup();
}


void init()
{
        add_action("da_sao", "sao");
        add_action("da_sao", "clean");
}

int da_sao(string arg)
{
    object me;
    mapping quest;
    me = this_player();
    if( !me->can_act() ) return notify_fail("你现在无法打扫。\n");

    if( call_other("/cmds/verb/clean", "main", me, arg ) )
    {
        if( quest = me->query("quest") )
        {
            if( quest["quest"] == "打扫大雄宝殿" )
            me->set("done_quest", "打扫大雄宝殿" );
            return 1;
        }
        return 1;
    }
    return 0;
}

