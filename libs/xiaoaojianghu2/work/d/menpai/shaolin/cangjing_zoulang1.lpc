// 藏经阁西走廊 : /d/shaolin/cangjing_zoulang1.c

inherit ROOM;



void create()
{
    set("short","走廊");
    set("long",@LONG
这是藏经阁二楼的西走廊。走廊上一个人也没有，非常宁静，似有曲径通幽
的感觉。往北是藏经阁的西阁，往东走可以到达藏经阁的北阁和东阁。有一道楼
梯盘旋而下，通向藏经阁西厅。
LONG
    );
    set("exits",([
        "down" : __DIR__"cangjing_ge1w",
        "east" : __DIR__"cangjing_zoulang2",
        "north" : __DIR__"cangjing_xige"
    ]) );

    setup();
}
