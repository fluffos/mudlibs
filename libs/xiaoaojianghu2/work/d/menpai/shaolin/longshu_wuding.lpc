// long shu yuan wu ding : /d/shaolin/longshu_wuding.c

inherit ROOM;

void init();
int do_jump(string);



void create()
{
    set("short","龙树院屋顶");
    set("long",@LONG
这里是龙树院的屋顶，上面铺着滑溜溜的琉璃瓦，看样子一不小心很容易摔
下去。屋顶东侧开着一扇天窗(window)，下面黑黝黝地，什么都看不见。南边的
龙树上，有一枝粗大的树枝伸向屋顶，从这里，可以走到龙树树梢上。
LONG
    );
    set("exits",([
        "south" : __DIR__"longshu_shushao",
    ]) );

    set("item_desc", ([
        "window" : "龙树院东厢房天窗\n",
    ]) );

    setup();
}

void init()
{
    add_action("do_jump", "jump");
}


int do_jump(string arg)
{
    object me = this_player();

    if (arg != "window") return command("jump "+arg);

    message_vision("$N纵身从天窗跳了下去。\n", me);

    me->move(__DIR__"longshu_dongfang");

    return 1;
}

