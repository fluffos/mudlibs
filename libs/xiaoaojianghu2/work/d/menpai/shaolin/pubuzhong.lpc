// pubuzhong.c 瀑布水中
// qinr 03-5-10 16:48

#include <room.h>
#include <ansi.h>
#ifdef KL_DOOR
inherit DOOR_ROOM;
#else
inherit ROOM;
#endif



void create()
{
        set("short","水中");
        set("long",
HIW"身在瀑布中，四周都是飞速下流的水,形成一道道绚丽的水幕。\n"NOR
HIW"而你正在穿越这一道道水幕，你在穿越瀑布的同时也在下降....\n"NOR
 );
    set( "not_startroom",1);
        setup();
}
void init()
{
    object me = this_player();
    add_action("do_look","look");
    write(YEL"你正在穿越瀑布，四周的水幕向后逝去。\n"NOR);
    me->disable_command("verb", HIB"小心泄了真气，掉下去摔死了。\n"NOR);
    call_out("do_check",6,me);
}

int do_look()
{   
	  object me = this_player();  
    write(HIR"你四周看了看，但水中速度过快，什么都看不清楚，却松了一口真气。\n"NOR);             
    write(HIR"只听得“扑通”一声，你一下子倒栽在了小溪里面，失去了知觉………\n"NOR);             
            me->set("eff_kee",me->query("eff_kee")/2);
            me->set("eff_sen",me->query("eff_sen")/2);
            me->set("eff_gin",me->query("eff_gin")/2);
            me->set("water",me->query("water")/2);
            me->set("food",me->query("food")/2);
            me->set("sen",1);
            me->set("gin",1);
            me->set("kee",1);
            me->set("force",me->query("force")/2);
            me->move(__DIR__"houshan_xiaoxi.lpc",1);
        if(me->query("eff_kee")<me->query("max_kee")/6)
        me->die();
        else if (!random(10))
        me->die();
        else
        me->uncouncious();
        remove_call_out();
        me->enable_path();
        return 1;
}

void do_check()
{
    object me = this_player();
    if( (me->query("kar")+random(100)) <115 ) {
        write(HIY"只听得“扑通”一声，你一下子倒栽在了小溪里面，失去了知觉………\n"NOR);
            me->set("eff_kee",me->query("eff_kee")/2);
            me->set("eff_sen",me->query("eff_sen")/2);
            me->set("eff_gin",me->query("eff_gin")/2);
            me->set("water",me->query("water")/2);
            me->set("food",me->query("food")/2);
            me->set("sen",1);
            me->set("gin",1);
            me->set("kee",1);
            me->set("force",me->query("force")/2);
            me->move(__DIR__"houshan_xiaoxi.lpc",1);
        if(me->query("eff_kee")<me->query("max_kee")/6)
        me->die();
        else if (!random(10))
        me->die();
        else
        me->uncouncious();
        me->enable_path();
        return ;
    }
    tell_object( me, HIG"你觉得四周水花都没有了，原来瀑布后另有天地。\n"NOR );
    me->set_temp("shaolin/damo",3);
    me->move( __DIR__"houshan_shidong" );
    me->enable_path();
    return;
}
