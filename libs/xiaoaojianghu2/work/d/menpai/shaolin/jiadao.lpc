inherit ROOM;


void create()
{
set("short","夹道");
set("long",@LONG
这里是一条夹道，人来人往十分热闹。北面炊烟缭绕，隐约可以闻见素菜的
香味，好象是少林寺的斋院和香积厨，少林寺所有僧人的斋饭就是在该处做的。
西面有一片房舍，库房就在那里。
LONG);
set("exits",([ //3
    "north" : __DIR__"zhaiyuan.lpc",
    "east" : __DIR__"qingshi-lu1.lpc",
    "west" : __DIR__"kufang.lpc",
]));
    set("objects", ([
        __DIR__"npc/huwei2" :1,
    ]));
    set("outdoors", "shaolin");
setup();
}

int valid_leave( object who, string dir )
{
    if( dir == "west" && !wizardp(who)
        && who->query("family/family_name") != "少林派" ) 
    {
        if(objectp(present("huwei seng")))
        {
            message_vision("灰衣护卫僧双手一张，拦住去路：\n"
                "“都说了不能乱闯。你怎么不听呀！”\n",who);
            return notify_fail("你只好收住了脚。\n");
        }
    }

    return ::valid_leave( who, dir );
}