
#include <ansi.h>
#include <room.h>
inherit ROOM;


void create()
{
    set("short", YEL"伏虎舍"NOR);
    set("long", @LONG
这里是少林为了增加僧人的相互切磋武功而设立的僧舍，罗汉堂
为这里提供了一些各种修为不同的武僧作为陪练和切磋的僧人。少林
弟子可以在这里(qing seng)请师兄们陪自己练习武功，但是如果要离
开的话，一定要记得(qing hui)请师兄们回去休息，这是基本的武德。
LONG
        );
    set("exits", ([ 
		"out"      :	     "/d/menpai/shaolin/puti_lian",
	]));
	    set("not_startroom",1);
	    set("no_quit",1);
            set("no_clean_up", 0);
    setup();
}
void init()
{
	add_action("do_qing","qing");
	add_action("do_exert","exert");
        add_action("do_kill","kill");
        add_action("do_bihua","bihua");
        add_action("do_fight","fight");
}

int do_exert(string arg)
{
        if(strsrch(arg,"roar")==-1)
        if(strsrch(arg,"xiao")==-1)
    {
    	return 0;
        
    }
    else {write("在少林寺里撒野？小心巡寺武僧不放过你哦！！\n");
        return 1;}
}

int do_kill(string arg)
{
    if(arg=="seng"||arg=="wu"||arg=="wu seng")
    {
      write("在少林寺里撒野？小心巡寺武僧不放过你哦！！！\n");
        return 1;
    }
    else 
    {
      write("在少林寺里撒野？小心巡寺武僧不放过你哦！！！\n");
        return 1;
     }
  }

