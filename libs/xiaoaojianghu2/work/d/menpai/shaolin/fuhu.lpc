int do_fight(string arg)
{
    if(arg=="seng"||arg=="wu"||arg=="wu seng")
    {
      write("在少林寺里撒野？小心巡寺武僧不放过你哦！！！\n");
        return 1;
    }
    else 
    {
      write("在少林寺里撒野？小心巡寺武僧不放过你哦！！！\n");
        return 1;
     }
  }



int do_qing(string arg)
{
    object me, env,npc;
    string mesg;
    object* obnpc;
    int idx;
    me = this_player();
    env = this_object();
    mesg = query("pei_owner");
    if(!arg || arg=="")
    {
        write("你要干什么？\n");
        return 1;
    }
   if( me->query("marks/少林/陪练A") > 0 )
    return notify_fail( "你已经在其它僧舍请了陪练师兄了啊，不需要再请了吧！！！\n" );
   if( me->query("marks/少林/陪练C") > 0 )
    return notify_fail( "你已经在其它僧舍请了陪练师兄了啊，不需要再请了吧！！！\n" );
    if( me->query_temp("will_quit") )
        return notify_fail( "你不是要退出了么，不需要请陪练师兄了吧！！！\n" );
   if (mesg && (arg == "hui") && (mesg == me->query("id")))
      {
                delete("pei_owner");
                add("peilians", -1);
                me->delete("marks/少林/陪练B");
                obnpc = all_inventory(env);
                for(idx=0; idx<sizeof(obnpc); idx++) 
                    {
                        if (!objectp(obnpc[idx]))
                                continue;
                        if (userp(obnpc[idx]))
                                continue;
                        destruct(obnpc[idx]);
          message_vision("$N恭请陪练师兄回房休息。\n", me);
                }
                return 1;
         }

     if(me->query( "class_score/少林派" ) < 1000  )
    {
        write("你的少林派的门忠太低，没资格请罗汉堂的师兄陪练武功！！！\n");
        return 1;
    }
      
        if( arg == "seng" &&me->query("family/family_name") == "少林派" )
        {   
          if( query("peilians") == 0 )
          {
          add("peilians", 1);
          me->add( "marks/少林/陪练B", 1 );
          set("pei_owner", me->query("id"));
           message_vision("$N请了一位罗汉堂的师兄陪练武功。\n", me);
           npc = new(__DIR__"npc/peilian");
           me->add_temp("peilian",1);
           me->add( "class_score/少林派" , -1*me->add( "class_score/少林派")/100  );
           npc->move(this_object());
           return 1;
           }
          if( query("peilians") >= 1 )
          {
            if(mesg == me->query("id"))
             {
        message_vision("$N请了一位罗汉堂的师兄陪练武功。\n", me);
        npc = new(__DIR__"npc/peilian");
        me->add_temp("peilian",1);
        me->add( "class_score/少林派" , -1*me->add( "class_score/少林派")/100  );
        npc->move(this_object());
        return 1;
          }
        else
         {
      write("这里已经有人在练功了！\n");
        return 1;
        }
       }
       else
       {
        write("少林寺罗汉堂的武僧不陪外人练武！！！！！\n");
        return 1;
      }
  }
}