inherit ITEM;
inherit F_FOOD;



void create()
{
    set_name("芹菜", ({"qin cai" }) );
    set_weight(50);//一两
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "把");
        set("value", 20);
        set("food_remaining", 1);
        set("food_supply", 10);
         
    }
    setup();
}
