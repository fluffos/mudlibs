// luobu.c
//by leonhart

inherit ITEM;
inherit F_FOOD;



void create() {
  set_name("萝卜", ({ "luobu" }));
  set_weight(50);  //一两
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 20);
    set("food_remaining", 2);
    set("food_supply", 10);

  }
  setup();
}
