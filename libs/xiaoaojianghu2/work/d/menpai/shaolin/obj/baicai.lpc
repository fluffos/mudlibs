// baicai.c by nerd 05/17/97 03:59PM

inherit ITEM;
inherit F_FOOD;



void create()
{
    set_name("白菜", ({"bai cai","cai"}));
    set("cant_sell","少林的庙产，小的可不敢收。\n");
    set_weight(100 + random(100));//呵呵，个头有大小
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一棵大白菜。\n");
        set("unit", "棵");
        set("value", 10);
        set("food_remaining", 3);
        set("food_supply", 40);
    }
}
