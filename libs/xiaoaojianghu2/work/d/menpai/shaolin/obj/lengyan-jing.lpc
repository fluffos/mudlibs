// lengyan-jing.c    楞严经

inherit ITEM;

mapping skill = ([
    "name"              :   "buddhism",
    "jibie_required"   :   54,
    "literate_required" :   100,
    "bonus_jilei"       :   18,
    "max_lingwu"        :   108,
]);

//Hydra 98/10/7
int invalid_study( object me)
{
    if ( me->query("shaolin/can_read_jing") < 0 )
    {
        write("你发现佛经上的内容过于艰深，看来需要去听听玄寂"
            "大师的讲课了。\n");
        return 1;
    }
    else
    {
        if ( me->query("gin") < me->query("max_gin")/2 )
        {
            write("研读佛经必须全神贯注，可是你现在的精神似乎不太好。\n");
            return 1;
        }
    
        me -> add( "gin",-(me->query("max_gin")/2) );    
        me -> add( "shaolin/can_read_jing",-1 );    
        me -> add( "shaolin/can_read_miji",1 );
        return 0;
    }
}       



void create()
{
    set_name("「楞严经」", ({ "fo jing", "jing", "shu" }));
    set_weight(300);
    if( clonep() )
        set_default_object(__FILE__);
    else
    {
        set("unit", "本");
        set("long","这本佛经，封皮有点旧，上面写着「楞严经」几个字。\n");
        set("value", 150);
        set("material", "paper");
        set("skill",skill);
    }
}