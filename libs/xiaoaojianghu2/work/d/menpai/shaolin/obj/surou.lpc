// 素肉
//surou.c
//by leonhart

inherit ITEM;
inherit F_FOOD;



void create()
{
    set_name("素肉", ({"su rou", "rou" }) );
    set_weight(120);//一两
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "份");
        set("value", 200);
        set("food_remaining", 3);
        set("food_supply", 30);
        set("gifts", ([
            "dix" : 2,
        ]));
    }
    setup();
}
