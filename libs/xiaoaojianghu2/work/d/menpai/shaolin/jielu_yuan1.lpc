// Room: /d/shaolin/jielu_yuan1.c

#include <ansi.h>
inherit ROOM;

void processing(object me);
void penalty_mark( object me );
void decide1(object me);
void decide2(object me);
void decide3(object me);
int valid_leave(object me, string dir);



void create()
{
    set("short", CYN"戒律院正厅"NOR);
    set("long", @LONG
厅堂正上方挂了一块匾额，上书“谨言慎行”四个大字。少林威名得以百年
不坠，不光是因为武学精湛，更是因为戒律严明。上至方丈，下至刚入门的弟子
，只要是触犯戒律的，都要受罚，决无情面可言。这里大概是少林僧人最不愿涉
足的地方了。但少林弟子每次下山归来，都要先到这里禀告有无犯规。实是不得
不来。
LONG
    );
    set("exits", ([
        "east"      : __DIR__"jielu_yuan0",
        "west"      : __DIR__"jielu_yuan2",
        "south"     : __DIR__"jielu_yuan3",
        "north"     : __DIR__"jielu_yuan4",
    ]));
    set("objects", ([
	__DIR__ "npc/huwei" : 2,
	__DIR__ "npc/huwei1": 2,
	__DIR__ "npc3/huijian":1,
	]));
    setup();
}

void init()
{
    object me, ob;
    me = this_player();
    if ( me->query("shaolin/announced") 
        && (ob = present("hui jian", this_object()))
        && ob->can_act() )
    {
        remove_call_out("processing");
        call_out("processing", 1, me);
    }
}

void processing(object me)
{
    message_vision(HIY @LONG

只听一声大喝，$N战战兢兢地抬头观瞧：戒律院的执事僧坐在大殿正中，狠恨地盯着$N；

周围的戒律院僧兵个个横眉立目，身前身后摆放着各种各样的刑具，令人不寒而栗。

$N不由得双腿打颤，“咕咚”一声跪倒在大殿上，不敢抬头再看。

LONG NOR, me);
    //第一次违规罚面壁
    //第二次关入水牢
    //第三次逐出师门
    if( !me->query("shaolin/break_law") )
    {
        remove_call_out("decide1");
        call_out("decide1", 3, me);
    }
    else if( me->query("shaolin/break_law") == 1 )
    {
        remove_call_out("decide2");
        call_out("decide2",3,me);
    }
    else
    {
        remove_call_out("decide3");
        call_out("decide3",3,me);
    }
}

void penalty_mark( object me )
{
    me -> set( "shaolin/last_penalty_age", me->query("age") );
//    if( me->query("shaolin/announced") == "because_pk" )
        me -> set( "shaolin/last_penalty_PKS", me->query("PKS") );
//    if( me->query("shaolin/announced") == "because_mk" )
        me -> set( "shaolin/last_penalty_MKS", me->query("MKS") );
}

void decide1(object me)
{
    int i;
    message_vision(GRN @LONG
慧见盯了$N一会儿，缓缓说道：
    “$N身为佛门弟子，居然杀害生灵，犯我僧家诸戒之首戒！
     念你是初犯，杖责五十，并罚后山面壁思过。下次如若再
     犯，定当打入水牢。
     众僧兵！给我用力打！” 
LONG NOR, me);
    message_vision(RED "\n众僧兵答应一声：“是！”一顿乱棍打来，$N疼得昏死过去……\n"NOR, me);
	i = me->query("eff_gin");
	me->set("eff_gin", i*5/6);
	i = me->query("eff_kee");
	me->set("eff_kee", i*5/6);
	i = me->query("eff_sen");
	me->set("eff_sen", i*5/6);
	penalty_mark( me );
    me->delete("shaolin/announced");	
	me->add("shaolin/break_law",1);
	LOG_D->do_log(me,"由于你不守清规戒律，被罚后山面壁思过。");	
	me->unconcious();
	me->move(__DIR__"mianbi");
    me->apply_condition("shaolin_mianbi", 20);
}

void decide2(object me)
{
    int i;
    message_vision(YEL @LONG
慧见盯了$N一会儿，缓缓说道：
    “$N身为佛门弟子，居然杀害生灵，屡次犯戒！按律当重责一
     百，打入水牢。下次如若再犯，定当逐出山门！
     众僧兵！给我用力打！” 
LONG NOR, me);
    message_vision(RED "\n众僧兵答应一声：“是！”一顿乱棍打来，$N疼得昏死过去……\n"NOR, me);
	i = me->query("eff_gin");
	me->set("eff_gin", i*5/6);
	i = me->query("eff_kee");
	me->set("eff_kee", i*5/6);
	i = me->query("eff_sen");
	me->set("eff_sen", i*5/6);
	
	penalty_mark( me );
    me->delete("shaolin/announced");	
	me->add("shaolin/break_law",1);    
	me->unconcious();
	me->move(__DIR__"shuilao1");
	LOG_D->do_log(me,"由于你不守清规戒律，被打入水牢。");
    me->apply_condition("shuilao", 30);
}

void decide3(object me)
{
    int i;
    message_vision(RED @LONG
慧见盯了$N一会儿，缓缓说道：
    “$N身为佛门弟子，居然杀害生灵，屡教不改！犯戒已过三次，
     按律该当杖责200，逐出山门！    
     众僧兵！给我用力打！” 
LONG NOR, me);
    message_vision(RED "\n众僧兵答应一声：“是！”一顿乱棍打来，$N疼得昏死过去……\n"NOR, me);
	i = me->query("eff_gin");
	me->set("eff_gin", i*1/3);
	i = me->query("eff_kee");
	me->set("eff_kee", i*1/3);
	i = me->query("eff_sen");
	me->set("eff_sen", i*1/3);
	me->move(__DIR__"shanmen");
	me->delete("shaolin");
	me->set("shaolin/kickout",1);
	me->delete("class");
	me->set("title","平民百姓");
	me->delete("family");
	
	//family != 0,这样就不能让他拜入段府，赫赫。
	me->set("family/kickout",1);
	LOG_D->do_log(me,"由于你屡次犯戒，被少林逐出山门。");
	me->unconcious();
    me->delete("shaolin/announced");
}
        
int valid_leave(object me, string dir)
{
	object ob;
	int i;
	if ( me->query("shaolin/announced") 
	&& ( ob = present("hui jian", this_object()) )
	&& ( living(ob) ) )
	{
//	    remove_call_out( "processing" );
		message_vision(GRN 
"慧见大喝一声：“大胆刁徒，不真心思过，居然还想潜逃不成！执法僧兵何在？！”\n\n"YEL +
"众僧兵一起应道：“弟子在！”\n\n"GRN +
"慧见喝道：“将此刁蛮顽劣之徒重责三百!”\n\n"YEL +
"众僧兵答应一声：“是！”一顿乱棍打来，$N疼得昏死过去……\n"NOR, me);
		i = me->query("eff_gin");
		me->set("eff_gin", i/2);
		i = me->query("eff_kee");
		me->set("eff_kee", i/2);
		i = me->query("eff_sen");
		me->set("eff_sen", i/2);
    	        me->unconcious();
		return 1;
	}
	return ::valid_leave(me, dir);
}
