// STANDARD FOOD FOR XO MUD. edit by lin on March 7,1997
// common food in city and class . edit by lin on March 4.1997
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name("包子", ({"bao zi","bao"}));
        set_weight(150);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个热气腾腾的肉包子。\n");
                set("unit", "个");
                set("value", 4);//很便宜，（基本食物都应该很便宜）.  
                set("over_value",0);
                //over_value是当吃过后这个东西的价值，如果省略就是0。
                set("food_remaining", 3);
                set("food_supply", 25);//正常饭量的人一顿吃二斤。 
                set("eat_msg","$N拿起$n咬了一口.\n");
                //吃的msg
                set("end_msg","$N将剩下的$n吃的干干净净.\n");
                //吃完了的msg
                set("over_msg","别吃太多了，会闹肚子的耶（古时候哪儿有卫生检疫呢？）.\n");
                //当food>max_food_capacity时的msg(不能吃了)
                //以上三者均可省略。
        }
}
int eat_effect(object me,object this)   //可以省略
{//这个函数允许在吃的时候加一些动作。。。。。。
    if( me->query_temp("eat_effect/baozi") < 10 )
    {
        me->add_temp("eat_effect/baozi",1);
        return 0;//返回1，则不再继续吃的过程，不等于1则继续吃的过程。
        //实际上在这个函数可以把吃的过程接下来。
    }
    if( me->query_temp("eat_effect/baozi") >= 10 )//for fun.
    {
        message_vision("$N突然感到一阵肚子疼！！！哇，不好。。。。。。\n",me);
        me->start_busy(4);
        tell_object(me,"最好先找个僻静的地方......，要不有碍观瞻的呦!\n");
        me->delete_temp("eat_effect/baozi");
        return 1;
    }
    else return 0;
}
int finish_eat( object me , object this )//也可以省略。
//这个函数用来在吃完后剩下点什么。
{
    this->set_name("油皮纸",({"youpi zhi","zhi","paper" }));
    this->set("long","一张用来包包子的纸，已经被油浸透了。\n");
    this->set("unit","张");
    this->set("value",0);
    this->set_weight(1);
    return 1;//返回1则不再destroy这个物品。
}
