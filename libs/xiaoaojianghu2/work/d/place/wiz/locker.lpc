#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
void create()
{
	set_name(HIG "斗士" NOR, ({ "locker" }) );
        set( "title", HIR"社会"NOR );
        set( "nickname", CYN"民主"NOR );
	set("race", "人类");
	set_weight(25000);
        set("cor",30);
        set("dex",30);
        set("gender","男性");
	set("no_get",1);
        set_wugong("liumai-shenjian",150,150,1);
//        set_wugong("qiushui-qingyun",150,150,1);
        set_wugong("duanjia-shenfa",150,150,1);
	set("long", "一位大侠，似乎很友好.....\n");
        set_xiuwei("unarmed",20000);
        set("str",1000);
        set("max_gin",1000);
        set("max_sen",2000);
        set("combat_exp", 3000000000000);
        set( "vendor_goods", ([
        "月饼"    :   CLONE_DIR + "wizard/mooncake",
        "鲜橙多"      :   CLONE_DIR + "wizard/xian",
    ]) );
	setup();
        carry_object( "/clone/wear/surcoat/zhanpao" )->wear();
 

}


void init()
{
   object ppl = this_player();
          add_action( "do_vendor_list", "list" );
    call_out( "Greeting", 1, ppl );
     call_out("get_all",2,this_object());
add_action("do_jiaoliang","jiaoliang");
   add_action("do_perform","perform");  

   return; 
}
int get_all(object me)
{
    object *inv,env;
    int i;      
//    if( me->is_fighting() ) return 1;
//    if( me->is_busy() ) return 1;
    env = environment(me);       
    if( !env ) return 1;
    inv = all_inventory(environment(me)); 
    if ( !sizeof(inv) ) return 1;   
    for( i = 0; i < sizeof( inv ); i++ )
    {   
        if( !inv[i]->is_character() && !inv[i]->query("no_get") )
        {   
            inv[i]->move(me);
            message_vision(HIW"$N高兴的扫着地，一边还唱着：啦啦啦啦。。。。。。\n"NOR,me);
            destruct(inv[i]);
        }
    }
    return 1;
}
void Greeting( object ppl )
{       
     if( !ppl 
        || environment( ppl ) != environment() ) 
        return;
    if ( !userp( ppl ) )
    return ; 
     command( "look "+ ppl->query( "id" ) );
     command( "pat "+ ppl->query( "id" ) );
     command( "say “我们来较量（jiaoliang)一下子如何？”" );
    
}
int do_jiaoliang()
{
      object me,obj;
      me = this_player();
      obj = this_object(); 
      if(me->query("combat_exp")<800000)
      {command("heng "+me->query("id"));
      return 1;
      }
      if ( me->is_fighting() )
      return notify_fail("locker同学正在较量呢！\n");
      if(obj->is_fighting())
      return notify_fail("locker同学正在较量呢！\n");
     
      message_vision(HIR"$N和斗士较量起来....\n"NOR,me);
      obj->set_temp("apply/damage",30+me->query_temp("apply/damage"));
      obj->set_temp("apply/armor",20+me->query_temp("apply/armor"));
      obj->set("combat_exp",me->query("combat_exp"));
      obj->set_xiuwei_by_type("zonggang",me->query_xiuwei_by_type("zonggang"));
      obj->set_xiuwei("dodge",me->query_xiuwei("dodge"));
      obj->set_xiuwei("unarmed",me->query_xiuwei("unarmed"));
      obj->set("max_force",me->query("max_force"));
      me->set("force",me->query("max_force"));
//      me->set("eff_kee",me->query("max_kee"));
//      me->set("kee",me->query("max_kee"));
      obj->set("kee",me->query("max_kee"));
      obj->set("force",me->query("force"));
      obj->set("str",me->query("str"));
      obj->set("force_factor",me->query("max_force")/10);
      obj->set("max_kee",me->query("max_kee"));
      obj->set("kee",obj->query("max_kee"));
      obj->set("eff_kee",obj->query("max_kee"));
      if(me->query("env/attack")<=40)
      obj->set("env/attack",40);
      if(me->query("env/attack")>=75)
      obj->set("env/attack",75);
      if(me->query("env/attack")>40&&me->query("env/attack")<75)
      obj->set("env/attack",me->query("env/attack"));
      if(obj->query_xiuwei("unarmed")<=me->query_xiuwei("blade"))
             obj->set_xiuwei("unarmed",me->query_xiuwei("blade")+1000);
      if(obj->query_xiuwei("unarmed")<me->query_xiuwei("sword"))
             obj->set_xiuwei("unarmed",me->query_xiuwei("sword")+1000);
      me->bihua_ob( obj );
      obj->bihua_ob( me );
      return 1;
}
int do_perform()
{return 1;}

void die()
{
    message_vision(HIG"只见斗士“哈哈”一阵大笑，突然来了个漂亮的后空翻，就此不见了。\n"NOR,this_object());
    destruct(this_object());
}
int refuse_killing(object me)
{
     if( me->query_temp("kill_locker") ){
        command("chat* nokill "+me->query("id"));
        me->unconcious();
        me->move("/d/city/yangzhou/jiulou2.lpc");
    }else{
        me->set_temp("kill_locker",1);
        command("nokill "+me->query("id"));
    }
    return 1;
}
