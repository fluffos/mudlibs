#include <channels.h>
inherit NPC;
#include <ansi.h>
void create()
{
    set_name(HIW"破烂王"NOR, ({ "polan" }) );
    set("rank_info",HIG"破烂王"NOR);
    set("title",HIY"好人"NOR);
    set("gender", "男性" );
    set("age", 80);
    set("long", "~~~~~~~~~~~~~~~~~~~~~~~~__~~~~~~~~~~~~~~~~~~~~~\n");
    set("env/wimpy",100);
    set("env/attack",60);
    set("justice",200);
    setup();
    set("chat_chance", 50);
    set_temp("apply/armor",100);
    set("chat_msg", ({
    	 (: random_move :),
     }) );
}

void init()
{
           call_out("get_all",2,this_object());
}
int get_all(object me)
{
    object *inv,env;
    int i;      
//    if( me->is_fighting() ) return 1;
//    if( me->is_busy() ) return 1;
    env = environment(me);       
    if( !env ) return 1;
    inv = all_inventory(environment(me)); 
    if ( !sizeof(inv) ) return 1;   
    for( i = 0; i < sizeof( inv ); i++ )
    {   
        if( !inv[i]->is_character() && !inv[i]->query("no_get") )
        {   
            inv[i]->move(me);
            message_vision(HIW"$N高兴的捡着破烂。\n"NOR,me);
            destruct(inv[i]);
        }
    }
    return 1;
}

int refuse_killing( object ppl )          
{ 
   this_player()->unconcious();
    return 0;
}
