#include <channels.h>
inherit NPC;
#include <ansi.h>
int ask_me();
void create()
{
    set_name(HIW"杀人魔"NOR, ({ "mowang" }) );
    set("rank_info",HIG"杀人成性的大魔头"NOR);
    set("title",HIY"坏人"NOR);
    set("gender", "男性" );
    set("age", 40+random(10));
    set("long", "你只看见一把血光闪闪的刀和一张凶神恶煞的脸。\n");
    set("combat_exp", random(20)*1000000);
    set("str", 40);
    set("force", (4+random(3))*1500);
    set("max_force", (4+random(3))*1000);
    set("force_factor", 450);
    set_wugong("sharen-daofa",200,200,1);
    set_wugong("meihua-bu",150,150,1);
    set_wugong("jiuyang-gong",200,200,1);
    set("env/wimpy",10);
    set("env/attack",60);
    set_xiuwei("blade",(100+random(1500))*10);
    set_xiuwei("dodge",(100+random(1500))*10);
    set_xiuwei_by_type("zonggang",1901);
    setup();
    carry_object( "/clone/weapon/blade/sidao" )->wield();
    add_money( "gold", 5 );             
    set("chat_chance", 50);
    set_temp("apply/armor",75);
    set("chat_msg", ({
    	 (: random_move :),
   HIR"杀人魔王低喝道：“烧光~~~~~~抢光~~~~~~~~~~杀光~~~~~~~~~~~~!”\n"NOR
       
     }) );
}

void init()
{
	if(!wizardp(this_player())&&this_player()->query("age")>30&&this_player()->query("age")<50)
           call_out("greeting",3,this_player());
           call_out("get_all",2,this_object());
                   add_action("do_perform","perform"); 
                   add_action("do_consider","consider");
}
int do_consider(string arg)
{ 
	object npc=this_object();
	object me=this_player();
	int xiuwei;
	xiuwei=(int)npc->query_xiuwei("blade")*(1+(random(20)-10)/40.0)*(1-1000000.0/(2000000+me->query("combat_exp")));
//	xiuwei=(int)npc->query_xiuwei("blade")*(1+(random(100)-50)/100.0)*(1+(me->query("age")-50)/40.0);
	if (arg=="mowang")
	{	
         tell_object( me, HIY"你估计魔王的修为大约在 "+xiuwei+"左右。\n"NOR);
         return 1; 
	}
	else return 0;
	
	
   
}
int get_all(object me)
{
    object *inv,env;
    int i;      
//    if( me->is_fighting() ) return 1;
//    if( me->is_busy() ) return 1;
    env = environment(me);       
    if( !env ) return 1;
    inv = all_inventory(environment(me)); 
    if ( !sizeof(inv) ) return 1;   
    for( i = 0; i < sizeof( inv ); i++ )
    {   
        if( !inv[i]->is_character() && !inv[i]->query("no_get") )
        {   
            inv[i]->move(me);
            message_vision("$N经过之处，内力激荡，一切仿佛在瞬间化为碎片。\n",me);
            destruct(inv[i]);
        }
    }
    return 1;
}
void greeting(object ob)
{
   object npc=this_object();
  
        if(!ob||!present(ob,environment(this_object())))return;
     if(ob->query("name")==HIW"杀人魔"NOR) return;
   say("杀人魔王对着"+ob->query("name")+"暴喝一声："+HIM"老子杀了你！\n"NOR);
    command("follow "+ob->query("id"));
    kill_ob(ob);
    npc->set("force",5000); 
    npc->set("eff_kee",npc->query("max_kee"));
    npc->set("kee",npc->query("max_kee")); 
     if(npc->query("killed")>=10)
    destruct(npc);
    ob->fight_ob(this_object());
}
int do_perform(string arg)
{
return 1;}
     
int refuse_killing( object ppl )            //被杀时的反应
{
   object npc = this_object();
    npc->set_temp("apply/armor", 100);
    npc->set_temp("apply/damage", 75);
    npc->set("force",5000); 
    message_vision( "$N正杀的兴起，疯狂的挥舞着手中的长刀！！\n", npc);   
    return 0;
}

void killed_enemy( )
{
       this_object()->add("killed",1);
    message_vision("$N轻轻地擦去刀上的血，狞然长笑....\n", this_object() );  
}
void die()
{ 
	object npc = this_object();
	object killer = npc->query_temp( "last_damage_from" );
        command( "rumor " + "杀人魔王终于被"+killer->query("name")+"杀死了！" );
    killer->add("justice",2);
    message_vision(HIR "$N惨然长笑，老夫终于得到了解脱~~~~~~~~~”\n"NOR, this_object() );
    destruct(this_object());
} 