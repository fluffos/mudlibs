int do_sleep()
{
    object ppl;
    string my_id, owner_id;

    ppl = this_player();                    //ppl：玩家自身。
    my_id = ppl->query( "id" );             //my_id：玩家自身的id。
    owner_id = query( "owner" );            //owner_id：房主的id。
    if ( my_id != owner_id                  //若非房主或其配偶，则指令无效。
        && ppl->query( "have_married/id") != owner_id )
    {
        tell_object( ppl, "这里不是你睡觉的地方。\n" );
        return 1;
    }
    return 0;                               //如果是合法用户，那么正常执行
                                            //sleep命令。
}

int do_letout( string arg )                 //赶走客人的函数。
{                                           //arg：客人的id。
    object ppl, ob;
    string my_id, owner_id;
    
    ppl = this_player();                    //ppl：玩家自身。
    my_id = ppl->query( "id" );             //my_id：玩家自身的id。
    owner_id = query( "owner" );            //owner_id：房主的id。
    if ( my_id != owner_id                  //若非房主或其配偶，则指令无效。
        && ppl->query( "have_married/id") != owner_id
        && !wizardp(ppl) )
        return 0; 
    if ( !arg )                             //如果没有参数，指令无效。
        return notify_fail( "你想赶走谁？\n" );
    if ( arg == my_id )                     //如果要赶出去的是自己，指令无效。
        return notify_fail( "你要赶走自己？那自己走出去吧。\n" );
    if ( objectp( ob = present( arg, this_object() ) ) )    //如果目标在室内。
    {
        if ( userp( ob )                    //如果是邀请来的玩家。
            && ob->query_temp( owner_id + " invited" ) )
        {                                   
            message_vision( "$N对$n说道：“我不再欢迎你呆在这里啦，" 
                + "请出去吧！”\n说着，就把$n推了出去。\n", ppl, ob );      
            ob->delete_temp( owner_id + " invited" );       //删除邀请标记。
            ob->move( query("exits/out") );  //挪到出口房间。  
            tell_object( ob, "你被" + ppl->query("name") + "赶出了" 
                + query( "short" ) + "。\n", ppl, ob );
            message( "vision", "一位" + RANK_D->query_normal( ob ) 
                + "从路旁的住宅里走出来。\n", environment( ob ), ob );
            return 1;
        }
        write( "你只能把被邀请来的客人赶出去，\n"           //失败信息。
               + "对于象" + ob->query("name") 
               + "这样闯进来的不速之客是行不通的。\n" );
        tell_object( ob, GRN"看来主人发逐客令了，要不要溜之大吉呢？\n"NOR );
        return 1;
    }
    write( "这个人在哪儿啊？\n" );
    return 1;
}

int restore_me( string id )
{
    int i = 0;
    string * lines;
    string datafile = sprintf(DATA_DIR "room/%c/%s", id[0], id);    
    if ( file_size(datafile) <= 0 )
        return 0;
    lines = explode( read_file(datafile), "\n" );
    while ( i < sizeof(lines) )
    {
        mixed key, val;
        string line = lines[i];
        if (line[0] == ' ')
            return 0;
        if (sscanf(line, "%s=%s", key, val)==2)
        {
            if (val == "")
            {
                while ( line != "end" && i < sizeof(lines) - 1 )
                {
                    i++;
                    line = lines[i];
                    if ( line[0] != ' ' )
                        continue;
                    val += line[1..] + "\n";
                }
            }
            set(key,val);
        }
        i++;
    }
    set("owner", id);
    set("exits", ([ "out" : "/d/city/yangzhou/tongsi_jie" ]) );
    return 1;
}

int save_me()
{
    string datafile, data;
    mapping db;
    string id = query("owner");
    if (!id)
        return 0;
       datafile = sprintf(DATA_DIR "room/%c/%s", id[0], id);    
    db = query_entire_dbase();
    data = "";
    foreach( string key, mixed val in db )
    {
        if(key == "owner")
            continue;
        if( stringp(val) && strlen(val) >= 1 ) //&&
        {
            data += key + "=";
            if (  strsrch(val, "\n") >= 0 )
            {
                data += "\n" + implode( map(explode(val,"\n"), (: " " + $1 :) ),"\n");
                data += "\nend\n";
            }
            else
                data += sprintf("%s\n",val);
        }
    }
    return write_file( datafile, data, 1 );//overwrite
}
