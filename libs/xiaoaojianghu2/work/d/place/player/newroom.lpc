#include <ansi.h>
inherit ROOM;

int save_me();

void create()
{
    set( "not_startroom",   1 );            //不是可以存储的地点。
    set( "sleep_room",  "inn" );            //是可以睡觉的地方。  
    set( "short", "空空屋" );
    set( "long" , "这里就是著名的迷雾之岛了.\n");
    set("item_desc", ([ "out" : "从门口看出去，可以看到繁华的通泗街。\n" ]) );
    setup();
}

void init()
{
    string my_id, owner;
    owner= query("owner");
    my_id = getuid(this_player());
    if ( my_id == owner ||
         this_player()->query("have_married/id") == owner
         || wizardp(this_player()) )
    {
        add_action( "do_change", ({"change", "gaibian" }) );  //改变描述的函数。
        add_action( "do_invite", ({"invite", "yaoqing" }) );  //邀请玩家的函数。
        add_action( "do_letout", ({ "letout", "ganzou" }) );  //赶走客人的函数。
        add_action( "do_sleep",  "sleep" );                   //控制睡觉的函数。
    }
}

int do_change( string arg )                 //改变描述的函数。
{                                           //arg：要改变的对象。                
    string long; //, my_id, owner_id;
/*    object ppl;

    ppl = this_player();                    //ppl：玩家本身。
    my_id = ppl->query( "id" );             //my_id：玩家id。
    owner_id = query( "owner" );            //owner_id：房间的主人id。
    if ( my_id != owner_id                  //若非房主或其配偶，指令无效。
        && !ppl->query( "have_married/" + owner_id ) )
        return 0; */
    switch ( arg )
    {
        case "short" : case "住宅名称" :    //改变住宅的名称。
            write( @TEXT
───────────────────────────────────────
你想对你的住宅起什么名称？（请用二十个以内的汉字命名）
TEXT
            );
            write( "->" );                  //显示提示符。
            input_to( "change_short" );     //调用efun输入。
            break;
        case "long" : case "住宅描述" :     //改变住宅的描述。
            write( @TEXT
───────────────────────────────────────
你想怎样装修你的住宅？（用“.”结束输入）
TEXT
            );
            write( "->" );                  //显示提示符。
            long = "";                      //long：新的长描述。
            input_to( "change_long", long );
            break;
        default :                           //没有参数的提示。
            write( @TEXT
    你能改变房子的如下性质：
    住宅的名称：    change/gaibian 住宅名称(short)
    住宅的描述：    change/gaibian 住宅描述(long)
    比如: change long 
TEXT    
            );
            break;
    }
    return 1;
}

int change_short( string msg )              //改变短描述的函数。
{                                           //msg：短描述内容。
    if ( msg                                //若长度在一个汉字以内，重新输入。
        && strlen( msg ) < 2 )         
    {
        write( "你输入的住宅名称不合要求。请重新输入。\n->" );
        input_to( "change_short" );
        return 1;
    }
    else if ( strlen( msg ) > 40 )          //若长度在八个汉字以外，重新输入。
    {
        write( "你起的住宅的名称请控制在二十个中文字以内。\n" );
        return 1;
    }
    set( "short", msg );                    //改变内存中的短描述。
    save_me();                            //调用函数改变文件中的描述。
    write( "住宅名称改变完毕。\n" );
    return 1;
}

int change_long( string msg, string long )  //改变长描述的函数。
{                                           //msg：终止符号。
                                            //long：长描述内容。
    if ( msg=="." )                         //若收到终止符号，则终止。
    {
        if ( !long || strlen(long) < 4 )
        {
            printf("你的描述短了一点点吧．\n");
            return 0;
        }
        write( "住宅描述改变完毕。\n" );
        set( "long", long );
                //+ long,70,1//)[4..] );  //改变内存中的长描述。
        save_me();                        //调用函数改变文件中的描述。
        return 1;
    }
    long = long + msg + "\n";               //没有受到终止符号的时候，就继续
    write("->");                            //接收msg， 加在long的后面。
    input_to("change_long", long);          
    return 1;
}

int do_invite( string arg )                 //邀请玩家的函数。
{                                           //arg：受邀请的对象id。
    object ob, ppl;
    string my_id, owner_id;

    ppl = this_player();                    //ppl：玩家自身。
    my_id = ppl->query( "id" );             //my_id：玩家自身的id。
    owner_id = query( "owner" );            //owner_id：房主的id。
    if ( my_id != owner_id                  //若非房主或其配偶，则指令无效。
        && ppl->query( "have_married/id") != owner_id )
    {
        return 0;
    }
    if ( ! arg )                            // specify the user to invited.
        return notify_fail( "你要邀请谁啊?\n");
    if ( arg == my_id )                     //如果对象是玩家自身，无效。
        return notify_fail( "你邀请自己？有没有搞错啊？\n " );
    ob = find_player( arg );                //ob：受邀请的玩家。
    if ( !ob || !ppl->visible(ob) )              //如果找不到指定玩家，失败。
    {
        write( "你确信这个玩家现在在线上吗？\n" );
        return 1;
    }
    if ( environment( ob ) == environment( ppl ) )  //如果受邀请的玩家已经在
    {                                               //这里，指令无效。    
        write( ob->name() + "不就在你的身边吗？\n" );
        return 1;
    }
    if ( (int)ob->query_temp( owner_id + " invited" ) > 2 )
    {
        write( "邀请也要适当而止，不能强求吧。\n" );
        return 1;
    }
    ob->add_temp( owner_id + " invited", 1 );//受邀请的玩家得到邀请标志
    tell_object( ob, REV MAG BWHT"\n" + ppl->name() + "邀请你去" + ppl->name()
        + "的家：" + query( "short" ) + "。"NOR"\n" );//显示讯息。
    tell_object( ppl, GRN"已经成功地向"             //显示成功讯息。
        + ob->name() + "发出邀请。\n"NOR );
    return 1;
}

