//boat1.c.海船
//date:1997.8.19
//by dan

#include <room.h>
#include <ansi.h>
//#include <localtime.h>
#include <nature.h>

inherit ROOM;

void create() {
  set("short", HIC "海船" NOR);
  set("long", @LONG
这是一艘渔民用来捕鱼的海船，渔民把船的两侧凿出小孔，让水灌入船底。
若捉到鱼后，便把鱼放到船底水中，可以让鱼活上数日。看这船还比较结实，不
是否能经得起海浪......不敢说，毕竟用了几十年，听渔夫说好象刚大修过, 不
过凑合着坐用吧......好危险啊!
LONG
  );
  set("exits/out", __DIR__ "shore1");
  set("not_startroom", 1);
  setup();
}

void init() {
  object me;
  me = this_player();
  if (me->query("xk_boat") == 1) {
    if (objectp(present("fishman", environment(me)))) {
      message_vision("渔夫对$N说：准备好了没有？好了，点头(nod)告诉我 。\n", me);
    }
  }
  add_action("do_nod", "nod");
  add_action("do_kaichuan", "kaichuan");
  return;
}

int do_nod() {
  object me, room1, room2;
  me = this_player();
  if (!room1 = find_object(__DIR__ "boat1"))
    room1 = load_object(__DIR__ "boat1");
  if (!room2 = find_object(__DIR__ "shore1"))
    room2 = load_object(__DIR__ "shore1");
  if (me->query("xk_boat") == 1) {
    if (objectp(present("fishman", environment(me)))) {
      message_vision("渔夫对$N说：开船(kaichuan)啦.... \n", me);
      me->set("xk_boat", 2);
      room1->delete("exits/out");
      room2->delete("exits/enter");
      room2->set("long", (string)room2->query("long1"));
      room2->set("xk_shore", 1);
      remove_call_out("sea");
      call_out("sea", 10, me);
      remove_call_out("sea1");
      call_out("sea1", 30, me);
      remove_call_out("help1");
      call_out("help1", 35, me);
      remove_call_out("hun");
      call_out("hun", 40, me);
      remove_call_out("move1");
      call_out("move1", 50, me);
      return 1;
    }
    message_vision(YEL "渔夫开没来，你不等他了....\n" NOR, me);
    return 1;
  }
  message_vision(YEL "$N瞎点什么头.\n" NOR, me);
  return 1;
}

int do_kaichuan() {
  object me, room1, room2;
  me = this_player();
  me->add("locker_kaichuan", 1);
  if (!room1 = find_object(__DIR__ "boat1"))
    room1 = load_object(__DIR__ "boat1");
  if (!room2 = find_object(__DIR__ "shore1"))
    room2 = load_object(__DIR__ "shore1");
  if (objectp(present("fishman", environment(me)))) {
    message_vision(YEL "渔夫大吼:$N不要动我的船!....\n" NOR, me);
    return 1;
  }
  if (me->query_temp("kaichuan")) {
    if (random(2) > 0) {
      message_vision(YEL "船在海上行驶，在风浪中颠簸.....\n" NOR, me);
    } else {
      message_vision(YEL "船开得很快，$N有些想吐.....\n" NOR, me);
    }
    return 1;
  }
  message_vision(YEL "$N乘渔夫不在，偷偷把船开跑了......\n" NOR, me);
  me->set_temp("kaichuan", 1);
  room1->delete("exits/out");
  room2->delete("exits/enter");
  room2->set("long", (string)room2->query("long1"));
  room2->set("xk_shore", 1);
  remove_call_out("sea");
  call_out("sea", 10, me);
  remove_call_out("sea1");
  call_out("sea1", 30, me);
  if (me->query("justice") >= 1000) {
    remove_call_out("move2");
    call_out("move2", 35, me);
    return 1;
  }
  if (NATURE_D->GetSeaon() == WINTER) {
    if (random(6) > 4) {
      remove_call_out("move2");
      call_out("move2", 35, me);
      return 1;
    }
  }
  if (random(5) > 2) {
    remove_call_out("help2");
    call_out("help2", 35, me);
    remove_call_out("hun");
    call_out("hun", 40, me);
    remove_call_out("move1");
    call_out("move1", 50, me);
    return 1;
  }
  if (random(5) > 1) {
    remove_call_out("die");
    call_out("die", 35, me);
    return 1;
  }
  if (random(20) > 18) {
    remove_call_out("move2");
    call_out("move2", 35, me);
    return 1;
  }
  remove_call_out("help3");
  call_out("help3", 35, me);
  remove_call_out("hun");
  call_out("hun", 40, me);
  remove_call_out("move3");
  call_out("move3", 50, me);
  return 1;
}

int sea(object me) {
  message_vision("$N站在船头，两边是一望无际的大海，海风拂面，浪击船头..\n", me);
  return 1;
}

int sea1(object me) {
  message_vision("突然刮起一阵狂风，船只受损，开始进水.....\n", me);
  return 1;
}

int help1(object me) {
  message_vision("渔夫一把抓住$N，跳进海中......\n", me);
  return 1;
}

int help2(object me) {
  message_vision("一艘商船开过来，把$N救上去......\n", me);
  return 1;
}

int help3(object me) {
  message_vision("一艘海盗船开过来，把$N拉了上去......\n", me);
  return 1;
}

int hun(object me) {
  me->unconcious();
  return 1;
}

int move1(object me) {
  object ob, *inv;
  int i;
  if (objectp(present("fishman", environment(me)))) {
    ob = present("fishman", environment(me));
    ob->move(__DIR__ "village");
  }
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i])) {
      inv[i]->die();
      continue;
    }
    destruct(inv[i]);

  }

  me->move(__DIR__ "shore1");
  me->delete_temp("kaichuan");
  remove_call_out("fuyuan");
  call_out("fuyuan", 1, me);
  return 1;
}

int move2(object me) {
  object *inv;
  int i;
  remove_call_out("fuyuan");
  call_out("fuyuan", 1, me);
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i])) {
      inv[i]->die();
      continue;
    }
    destruct(inv[i]);
  }
  me->move(__DIR__ "shore");
  me->add("locker_up", 1);
  me->set_temp("dan/正常", 1);
  me->delete_temp("kaichuan");
  return 1;
}

int move3(object me) {
  object *inv, boat;
  int i, flag;
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i])) {
      inv[i]->die();
      continue;
    }
    destruct(inv[i]);
  }
  remove_call_out("fuyuan");
  call_out("fuyuan", 1, me);
  if (!boat = find_object(__DIR__ "boat3"))
    boat = load_object(__DIR__ "boat3");
  foreach (object ob in deep_inventory(boat)) {
    if (userp(ob))
      flag = 1;
  }
  if (flag != 1) {
    me->add("locker_haidao", 1);
    me->move(__DIR__ "boat3");
    me->delete_temp("kaichuan");
  } else
    call_out("move3", 50, me);
  return 1;
}

int die(object me) {
  remove_call_out("fuyuan");
  call_out("fuyuan", 1, me);
  me->delete_temp("kaichuan");
  me->die();
  return 1;
}

int fuyuan(object me) {
  object room1, room2;
  if (!room1 = find_object(__DIR__ "boat1"))
    room1 = load_object(__DIR__ "boat1");
  if (!room2 = find_object(__DIR__ "shore1"))
    room2 = load_object(__DIR__ "shore1");
  room1->set("exits/out", __DIR__ "shore1");
  room2->set("exits/enter", __DIR__ "boat1");
  room2->set("long", (string)room2->query("long2"));
  room2->set("xk_shore", 0);
  return 1;
}
