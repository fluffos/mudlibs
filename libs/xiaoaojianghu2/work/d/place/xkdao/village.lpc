#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIB "海边渔村" NOR);
  set("long", @LONG
你眼前豁然一阵开阔, 芦苇荡都已在你的脑后, 你面前出现了一片茫茫的大
海。面前是靠在海边的小渔村。由于民风淳朴，家家户户的大门都向外敞开着，
里面还不时传来欢声笑语。门口和屋顶上都晾着捕获的海鱼。这一切让你感到非
常的和睦安康，远离武林中人的仇杀。南面是一望无际的大海。北面是村外的芦
苇荡。
LONG
  );
  set("exits", ([
    "north": __DIR__ "luwei_dang",
    "south": __DIR__ "shore1",
  ]));
  set("objects", ([
    __DIR__ "npc/fishman": 1,
  ]));
  set("outdoor", "zhongyuan");
  set("not_startroom", 1);
  setup();
}
