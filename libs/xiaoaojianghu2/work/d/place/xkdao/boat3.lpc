//boat3.c.海盗船
//date:1997.8.19  
//by dan 

#include <room.h>
#include <ansi.h>
inherit ROOM;

private int visited;

private string long1 = @LONG
这是一只海盗船，船大而坚固，比其你刚才死里逃生的小海船不可同日而语. 
一群海盗衣冠不整，在甲板上开怀畅饮。四周堆着一些货物, 各种各样什么都有，
看来海盗的生意很不错。在货物边上还捆了一个人，好象是一来往客商，他正在
看着你，似乎在用目光肯求你解救(jiejiu shangren)他.
LONG ;

private string long2 = @LONG
这是一只海盗船，船大而坚固，比其你刚才死里逃生的小海船不可同日而语. 
四周堆着一些货物, 各种各样什么都有，经过刚才一阵恶战，已一片狼藉，海盗
们被打得跳海或跪在一边.
LONG ;

void create()
{
    set("short", HIC"海盗船"NOR);
    set("long", long1 );
    set("not_startroom",1);    
    set("objects",([
         __DIR__"npc/haidao": 3,
         __DIR__"npc/keshang": 1,
    ]));
    visited = 0;
    setup();
}

void init()
{
   add_action("do_jiejiu","jiejiu");
}

int do_jiejiu(string arg)
{
    object me,user;
    me = this_player();
    if ( visited )
       return notify_fail("客商已被救走了....好象没有人可救了，救海盗...?\n");
    if ( !arg )
       return notify_fail("你要救谁啊?....客商大叫救我....help me...\n");
    if ( arg !="shangren" )
       return notify_fail("好象这里没有这人......也许早被海盗扔海里去了!\n");
    if( objectp(present("hai dao", environment(me))) )
       return notify_fail("海盗不让你救啊...怎么办...快杀了海盗吧...\n");
    user = new(__DIR__"npc/keshang");
    user->move ( this_object() );
    visited = 1; // wait for next reset..
    message_vision("$N解开客商身上的绑绳，客商对$N万分感谢!\n",me);
    set( "long", long2 );
    return 1;
}

void reset()
{
    visited = 0;
	set ( "long", long1 );
    ::reset();
}
