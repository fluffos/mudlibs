inherit NPC;

void create()
{
	set_name("象", ({ "xiang"}));
    set("race", "野兽");
	set("age", 20);
	set("long",
		"这是一种神仙们养的象，也是这里唯一的驯兽...\n");  
    set("attitude","aggressive");
    set("str", 50);
    set("cor", 50);
    set("max_kee",5000);
    set("eff_kee",5000);
    set("kee",5000);
    set("limbs", ({ "头部", "身体", "鼻子", "後脚", "尾巴" }) );
    set("verbs", ({ "bite", "claw" }) );
    set("combat_exp", 100000);   
    
    setup();
}

void init()
{ 
	object me=this_player();
   
   if (wizardp(me) )
        return;
   kill_ob( me );
}   