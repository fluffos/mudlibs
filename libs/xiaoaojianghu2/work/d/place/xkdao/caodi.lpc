//date:1997.8.19
// by dan 

#include <ansi.h>
#include <nature.h>
#include <room.h>
//#include <localtime.h>

inherit ROOM;    

void create()
{
    set("short",GRN"草地"NOR);
    set("long",@LONG
这里是靠近沙滩的一片草地, 亚热带的海风吹拂着人的发鬓，一群群鲣鸟在
上空飞翔，还有一些不知名的海鸟在远处的海面上捕食。北面是一望无际的大海,
南面是一片丛林，经常有一些动物从中窜出，远远好象听见熊的吼声, 这是南海
诸岛上少有的猛兽. 草丛里似乎有什么东西......
LONG);
    set("exits", ([ /* sizeof() == 2 */
       "north" : __DIR__"shore",
       "south" : __DIR__"milin",
    ]));  
    set("outdoor","xkdao");                 
    set("not_startroom",1);
    set("search_things",([
       "草丛": __DIR__"npc/obj/firestone",
      ]));
    setup();
}                            

void init()
{
    object me,room1,room2,room3;
    me = this_player();
    if ( !room1 = find_object(__DIR__"caodi") )
          room1 = load_object(__DIR__"caodi");
    if ( !room2 = find_object(__DIR__"shore") )
          room2 = load_object(__DIR__"shore");        
    if ( !room3 = find_object(__DIR__"sea") )
          room3 = load_object(__DIR__"sea");
    if ( room1->query("typhoon") )
    {
       message_vision(RED"台风正在逼近小岛......\n",me);
       return ;
    } 
    if ( room2->query("typhoon") )
    {
       message_vision(RED"台风正在逼近小岛......\n",me);
       return ;
    } 
    if ( room3->query("typhoon") )
    {
       message_vision(RED"台风正在逼近小岛......\n",me);
       return ;
    } 
    if ( NATURE_D->GetSeason() == AUTUMN )
    {
       if ( random( 5 ) < 4 ) return;
    }   
    if ( random( 10 ) > 0 ) return;
    message_vision(RED"台风来了，风量慢慢变大了......\n"NOR,me);
    room1->set("typhoon",1);
    room2->set("typhoon",1);
    room3->set("typhoon",1);
    remove_call_out("typhoon");
    call_out("typhoon",30,me);
    return;
}

int typhoon(object me)
{
    object room1,room2,room3,*inv;
   int j;
    if ( !room1 = find_object(__DIR__"caodi") )
          room1 = load_object(__DIR__"caodi");
    if ( !room2 = find_object(__DIR__"shore") )
          room2 = load_object(__DIR__"shore");        
    if ( !room3 = find_object(__DIR__"sea") )
          room3 = load_object(__DIR__"sea"); 
    message_vision(RED"台风卷过海岛，杀死了一切生气......\n"NOR,me); 
    room1->set("typhoon",0);
    room2->set("typhoon",0);
    room3->set("typhoon",0);
    inv = all_inventory( room1 );
    for ( j = 0; j < sizeof(inv); j++ )
    {  
       if ( living( inv[j] ) )   
       {
           inv [j] ->die();
       }
       else
       {
           if ( inv[j]->query("id") != "mu wu"  )
           destruct( inv[j] );
       }                       
    }
    inv = all_inventory( room2 );
    for ( j = 0; j < sizeof(inv); j++ )
    {  
       if ( living( inv[j] ) )   
       {
           inv [j] ->die();
       }
       else
       {
           destruct( inv[j] );
       }                       
    }
    inv = all_inventory( room3 );
    for ( j = 0; j < sizeof(inv); j++ )
    {  
       if ( living( inv[j] ) )   
       {
           inv [j] ->die();
       }
       else
       {
           destruct( inv[j] );
       }                       
    }                      
    return 1;
}   
