//boat2.c.木筏//date:1997.8.19  
//by dan 

#include <ansi.h>
#include <nature.h>

inherit ITEM;

void create()
{
    set_name(HIC"木筏"NOR, ({"mu fa"}));
    set_weight(1500000);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long","这是一只用木材和树皮作成的木筏......好象不太结实的说....");
        set("unit", "只");
        set("value", 20);
        set("can_fire",1);
     }
}

void init()
{
       add_action("do_kaichuan","kaichuan");
       return ;
}

int do_kaichuan()
{
      object me,room,*inv,ob;
      int i;
      me = this_player();
      ob = this_object();
      room = environment(me);
      if( room->query("short")!=HIC"浅海"NOR )
      {
            message_vision(YEL"这里开不动木筏啊...\n"NOR,me);
            return 1;
      }
      message_vision(YEL"$N把木筏推上海面，一跃而上......\n"NOR,me);
      inv = all_inventory(me);
      for ( i = 0; i < sizeof(inv); i++ )
      {
        destruct( inv[i] );
      }
      if( NATURE_D->QueryMonth() == 6 ) // kick lnwm. why not GetMonth
      {
          if (random(3) > 1)
          {
               message_vision(YEL"木筏顺流而行,很快.....\n"NOR,me);
               me->unconcious();
               me->move("/d/place/xkdao/shore1");
               destruct( ob );
               return 1;
          }
      }
      if (random(3) > 1)
      {
            message_vision(YEL"风浪很大，木筏一下翻了.......\n\n\n\n"NOR,me);
            message_vision(YEL"有一艘商船开了过来,把$N救了上去....\n"NOR,me);
            me->unconcious();
            me->move("/d/place/xkdao/shore1");
            destruct( ob );
            return 1;
       }
      me->die();
      destruct ( ob );
      return 1;
}        
