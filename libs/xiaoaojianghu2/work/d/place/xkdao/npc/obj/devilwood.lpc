#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(HIC"木屋"NOR, ({"mu wu"}));
    set_weight(1500000);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long","这是一间用木材和树皮作成的木屋......好象不太结实的说....");
        set("unit", "间");
        set("value", 20);
     }
}

