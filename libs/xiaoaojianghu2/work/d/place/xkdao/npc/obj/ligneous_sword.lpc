// ligneous_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("木剑", ({ "mu jian", "jian", "sword"}) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 1);
                set("material", "wood");
                set("can_fire",1);
                set("long", 
"这是一把用木头削成的木剑,但很重.....n");
                set("wield_msg", "$N拿出一把练剑用的$n，握在手中。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_sword(10);
        setup();
}
 
