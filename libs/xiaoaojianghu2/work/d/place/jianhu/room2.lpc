// room2.c  cry

#include <ansi.h>
inherit DOOR_ROOM;


void create()
{
    set("short", WHT"石阶"NOR);
    set("long", @LONG
一条向下倾斜的石级，由玉石铺成，地面闪闪必亮，向下十余级后，面前
隐隐约约的似有一门。
LONG
       );
    set("valid_startroom", 1);
    set("no_fight",1);
    set("exits", ([
        "east" : __DIR__"room3",
        "west" : __DIR__"room1",
    ]) );
    create_door("east",([
        "name" : "一扇玉石门",
        "status": 1,
        "id"  : ({ "east","玉石门","door"}),
        "other_side_dir": "west",
    ]) );
    setup();
}
