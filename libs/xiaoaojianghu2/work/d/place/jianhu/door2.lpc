// door2.c  cry

#include <room.h>
inherit DOOR_ROOM;


void create() {
  set("short", "洞内");
  set("long", @LONG
洞中仍然漆黑一片，不论你眼睛睁得多大，仍然看不到任何物事，只觉霉气
刺鼻，似乎洞内已久无人居。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "north": __DIR__ "door1",
    "south": __DIR__ "room1",
  ]));
  create_door("north", "两扇紫铜门", "south", DOOR_CLOSED);
  create_door("south", "一扇石门", "north", DOOR_CLOSED);
  setup();
}
