#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", WHT"石阶"NOR);
    set("long", @LONG
你隐隐听到轰隆轰隆的水声，又行二百余级，水声已然震耳欲聋，前面并
有光亮透入。你加快脚步，直奔石级的尽头。
LONG
       );
    set("valid_startroom", 1);
    set("exits", ([
        "up" : __FILE__,
        "down" : __FILE__,
    ]) );
    setup();
}

int valid_leave(object me,string dir)
{
	if (dir=="up" && !random(4)) {
	    	this_player()->move(__DIR__"bush");
		return -1;
	}
	if (dir=="down" && !random(4)) {
	    	this_player()->move(__DIR__"road13");
		return -1;
	}
 	return ::valid_leave(me,dir);
}