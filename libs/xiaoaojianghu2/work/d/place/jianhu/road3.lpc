// road3.c  writen by cry 9.30.98

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "洞中");
	set("long", @LONG
洞中漆黑一片。你双手伸出，摸索著一步一步向前走着，脚下地面平整光滑，
便似走在石板路上一般，料想洞中道路必是经过人工修整。
LONG
	);
	set("valid_startroom", 1);
	set("exits",([
		"southeast" : __DIR__"road2",
		"northdown" : __DIR__"road4",
	]) );
	setup();
}

void init()
{
	remove_call_out("dest_road");
}

int valid_leave(object me, string dir)
{
	call_out("dest_road",2,dir);
	return 1;
}

void dest_road(string dir)
{
	if ( query("exits/"+dir) )
		destruct(this_object());
}