#include <ansi.h>

inherit NPC;

void create()
{
    set_name("云中鹤",({"yun zhonghe", "yun", "zhonghe"}));
    set("long",@LONG
四大恶人之四，据说此人轻功甚佳，处事狡猾，打不过就跑。
LONG );
    set("nickname",HIC"穷凶极恶"NOR);
    set("gender", "男性" );
    set("age", 39);
    
    set("vendetta_mark", "eren");
    set("str", 25 );    set("cor", 20 );    set("int", 26 );
    set("per", 22 );    set("spi", 30 );    set("cps", 20 );
    set("dex", 35 );    set("con", 30 );    set("kar", 25 );
    
    set_force( 2000, 2000, 200 );
    set("using_force","haoran-zhengqi");

    set_wugong("huifeng-wuliu"  , 150, 150, 1);
    set_wugong("haoran-zhengqi" , 200, 200, 1);
    set_wugong("panheng-zhang"  , 150, 150, 1);
    set_wugong("luoying-xiaofa" , 100, 100, 1);
    set_xiuwei_by_type("dodge"  , 5301);
    set_xiuwei_by_type("unarmed", 1901);
    set_xiuwei_by_type("short"	, 3201);
    set("combat_exp", 10000000);
    set("social_exp", 35000);
    set("title","四大恶人");
    set("bellicosity",10000);
        set("max_kee",3000);
    set_temp("apply/armor",100);

//    set("env/wimpy",40);

    setup();

    carry_object( __DIR__"obj/cloth3")->wear();
    carry_object( __DIR__"obj/yindao")->wield();
}

int accept_fight( object me )
{
	command("heng");
	return 1;
}
void welcome_visitor()
{
	if( query("eff_kee") < query("max_kee"))
	{this_object()->set("force",3000);
	this_object()->set("eff_kee",this_object()->query("max_kee"));}
	this_object()->kill_ob(this_player());
	this_player()->apply_condition( "snake_poison", 120 );
}
void die()
{ 
        object npc = this_object();
        object killer = npc->query_temp( "last_damage_from" );
        command( "rumor " + "恶人终于被"+killer->query("name")+"杀死了！" );
    killer->add("justice",1);
            destruct(this_object());
} 
