#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        set_name(HIG"柳叶刀"NOR, ({"liuye dao", "blade"}) );
        set_weight(800);
        set("long","一把形如柳叶的短刀，散着阵阵香气。\n" NOR);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value",25000);
                set("material", "steel");
        }
        init_blade(55);
        set("wield_msg", "$N稍稍抽出一把精亮的$n。\n");
        set("unwield_msg", "$N将$n插入腰间。\n");
        setup();
}
