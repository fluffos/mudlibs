// mangpi.c cry

#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
	set_name(BYEL HIW"花斑蟒皮"NOR, ({ "mang pi","pi" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long","一张花斑巨蟒的皮。\n");
		set("value", 10000);
		set("material", "leather");
		set("armor_prop/armor", 25);
	}
	setup();
}
