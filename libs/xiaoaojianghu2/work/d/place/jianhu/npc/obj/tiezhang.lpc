// qingtie_zhang.c writen by tea 10.27.98

#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create() {
  set_name(CYN "青铁杖" NOR, ({ "qingtie zhang", "zhang", "staff" }));
  set_weight(2500);
  set("long", @LONG
一对四尺余长的铁杖，通体青色，为精铁打就，上刻「段延庆」。
LONG);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("value", 18000);
    set("material", "iron");
  }
  init_staff(55);
  set("wield_msg", "$N抽出一对$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n戳到地上。\n");
  setup();
}
