
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIC"玄铁山"NOR);
        set("long", @LONG
这里就是昆仑山脉的一个分支，由于盛产玄铁矿石，人们都叫它玄铁山。
山上多含红铜，整个山似乎在燃烧，远处看去如同火焰一般。
LONG
        );
        set("exits", ([
                 "down": "/d/map/xiyu/shanjiao",  
        ]));       
        setup();
}

void init()
{
        add_action("dig_kuang", "dig");
}

int dig_kuang(string arg)
{
        object me;
        me = this_player();
        if( !arg || ( arg != "矿" && arg != "kuang" ) )
            return notify_fail("你要挖什么啊？？？?\n");

        if( !me->can_act() ) return notify_fail("你现在无法挖矿。\n");
        if( !present("tie gao",me) )
        return notify_fail("不要铁镐你也能种挖矿石？真佩服你了！！！\n");

        if( arg == "矿" || arg == "kuang" )
        {
             if( query_temp_marks("dig_times") >= 2 )
             return notify_fail("矿石都被挖光了，你还等等吧。。。。。\n");
             if( (int)me->query("sen") < 90 )
             return notify_fail("你现在的精神足够发现矿石，先休息一会吧。\n");
              if( (int)me->query("force") < 1000 )
             return notify_fail("你的内力不够，无法有足够的力气挖矿。\n");
             else
             {
                tell_object(me,"你发现有块大矿石，你挥动起铁镐.......\n"
                                "你不停的挥动着铁镐，汗如雨下。。。。。\n"
                                "你似乎有的虚脱了。。。。。。。\n"
                                "四周尘土飞扬。。。。。\n");
                add_temp_marks("dig_times", 1);
                me->disable_command("verb", "你正在用力的挖着矿石呢！！！！。");
                call_out("done_dig",50,me);
                return 1;
              }
        }
}

int done_dig( object me )
{
    object kuang;
    tell_object(me,"你用尽全力，终于挖出了一快大矿石。。。。。\n");
    me->receive_damage("sen",90);
    me->add("force",-1000);
    me->enable_path();
    kuang = new( "/d/map/xiyu/obj/kuang" );
    kuang->move(me);
    return 1;
}
