// shitou.c
inherit ITEM;

void create()
{
	set_name("玄铁矿石", ({ "kuang shi","shi" }) );
	set_weight(60000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一块西域的玄铁矿石。\n");
		set("unit", "块");
		set("value", 20);
	}
}

void init()
{
    add_action("do_xuan",({"xuan","rong"}));
}

int do_xuan(string arg)
{
        object me;
        me = this_player();
        if( !arg || ( arg != "铁" && arg != "tie" ) )
            return notify_fail("你要炼什么啊？？？?\n");

        if( !me->can_act() ) return notify_fail("你现在无法炼玄铁。\n");

        if( arg == "铁" || arg == "tie" )
        {
             if( query_temp_marks("xuan_times") >= 1 )
             return notify_fail("矿石已经被炼过了，还是换一块炼好了。。。。。\n");
             if( (int)me->query("sen") < 300 )
             return notify_fail("你现在的精神足够炼玄铁，先休息一会吧。\n");
              if( (int)me->query("force") < 5000 )
             return notify_fail("你的内力不够，无法用内力熔化矿石。\n");
              if( (int)me->query("max_force") < 5000 )
             return notify_fail("你的内力不够，无法用内力熔化矿石。\n");
             else
             {
                tell_object( me,"你盘膝坐下，紧闭双目，开始蓄积内力。。。。\n"
                                "你将双手放在矿石上。。。。。\n"
                                "你的内力顺着双掌注入到矿石中。。。。。。。\n"
                                "矿石开始变的柔软了。。。。。。\n"
                                "矿石被你的内力熔化了。。。。。。。\n");
                add_temp_marks("xuan_times", 1);
                me->disable_command("verb", "你正在用内力熔炼着矿石呢！！！！。");
                me->start_busy( 15 );
                call_out("done_xuan",30,me);
                return 1;
              }
        }
}

int done_xuan( object me )
{
    object tie;
    tell_object(me,"你用尽内力，终于将矿石熔练成了玄铁。。。。。\n");
    me->receive_damage("sen",300);
    me->add("force",-5000);
    me->enable_path();
    tie = new( "/d/map/xiyu/obj/tie" );
    tie->move(me);
    return 1;
}

