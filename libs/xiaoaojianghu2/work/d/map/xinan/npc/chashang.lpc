// chashang.c

inherit NPC;

string *tea = ({
    "tuocha",
    "hongcha",
    "lvcha",
    "huacha",
    "moguo",
});
            


void create()
{
	set_name("茶商", ({ "cha shang","trader"}));
    set("gender", "男性" );
	set("age", 15+random(50));
	set("str", 20 + random(40) );
	set("kee",400);
	set("max_kee",400);
	set("eff_kee",400);
	set("sen",400);
	set("max_sen",400);
	set("eff_sen",400);
	
	set("long",
		"这是一名远道去大理采购茶叶的茶商，他满面风尘之色。\n");
	set("chat_chance", 6);
        set("chat_msg", ({
(: random_move :)
 }));
	set("combat_exp", 10000+random(40000));
    set("social_exp", 10000+random(40000));
	set("attitude", "friendly");
    set_wugong("unarmed",50 + random(100) );
    set_wugong("blade", 50 + random(100) );
    set_xiuwei("unarmed", 200 + random(300) );
    set_xiuwei("blade", 200 + random(300) );
	setup();
    carry_object( CLONE_DIR + "weapon/blade/miandao")->wield();
   	carry_object( CLONE_DIR + "wear/cloth/cloth4")->wear();
    carry_object( CLONE_DIR + "misc/" + tea[random(sizeof(tea))] );
    carry_object( CLONE_DIR + "misc/" + tea[random(sizeof(tea))] );
	set("possitive_score",100-random(400));
}

