// keshang.c

inherit NPC;

string *goods = ({
    "/d/city/yangzhou/obj/douli",
    "/d/city/yangzhou/obj/qisha_yan",
    "/d/city/yangzhou/obj/zizhu_xiao",
	"/d/city/lanzhou/npc/obj/jin_zanzi",
	"/d/city/lanzhou/npc/obj/shou_wu",
	"/d/city/lanzhou/npc/obj/yin_zanzi",
	"/d/city/lanzhou/npc/obj/yu_zhuozi",
	CLONE_DIR + "book/bianfa",
    CLONE_DIR + "book/jianshu",
    CLONE_DIR + "book/daoshu",
	CLONE_DIR + "book/shuowen",
	CLONE_DIR + "book/qinggong",
});
                          
string *first_name = ({
    "张", "李", "王", "赵", "杨", "花", "白", "周", 
                    });

string *last_name = ({
    "大", "二", "三" ,"四", "五", "六", "七", "八",
                    });                                              


void create()
{
    string name;
    name = first_name[random(sizeof(first_name))];
    name += last_name[random(sizeof(last_name))];
	set_name( name , ({ "ke shang", "trader", "shang" }));
    set("title", "过路客商" );
    set("gender", "男性" );
	set("age", 15+random(50));
	set("kee",400);
	set("max_kee",400);
	set("eff_kee",400);
	set("sen",400);
	set("max_sen",400);
	set("eff_sen",400);
	
	set("long",
		"这是一名来往于各大城市之间的客商，身边带了不少货物。\n");
	set("chat_chance", 10);
        set("chat_msg", ({
(: random_move :),
"客商说：听说前面有强盗？也不知是不是真的.....\n",
"客商站到路边歇了口气。\n",
 }));
	set("combat_exp", 100000+random(400000));
    set("social_exp", 100000+random(400000));
	set_xiuwei("unarmed", 300 + random(300) );
	set("attitude", "friendly");
	setup();
   	carry_object( CLONE_DIR + "wear/cloth/cloth4")->wear();
/*
	carry_object( goods[random(sizeof(goods))]);
	carry_object( goods[random(sizeof(goods))]);
	carry_object( goods[random(sizeof(goods))]);
*/
	set("possitive_score",100-random(400));
}

int refuse_killing( object who )
{
	object *inv;
	int i;
	message_vision("客商大叫道：“有人抢东西呀！ 快来救命！！”\n", who);
	inv = all_inventory( environment(this_object()) );
	for ( i = 0; i < sizeof(inv); i++ )
	{
		if( inv[i]->query("id") == "ke shang" )
		inv[i]->kill_ob(who);
	}
	return 0;
} 

