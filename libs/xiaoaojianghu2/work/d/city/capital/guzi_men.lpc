#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit GATE;
void create()
{
	set("short",HIW "肃政门" NOR);
	set("long", @LONG
肃政门又叫金辉门，但是人们习惯叫它固子门，据说固子乃“顾子”之义，
因为汴京外城形似卧牛，北临黄河，顾黄河如子，则子不敢害其母也。这也不过
是大家的一种愿望罢了。
LONG
	);
	set("objects", ([ 
                  __DIR__"npc/gate_shibing" : 2,
                  __DIR__"npc/gate_dutou" : 1,
         ]));
	set("exits", ([ 
                  "northeast" : __DIR__"ansu_men",
                  "south" : __DIR__"wans_men",
         ]));
        set("detail",([
        ]));
        set("outdoors", "capital");
	setup();
}
