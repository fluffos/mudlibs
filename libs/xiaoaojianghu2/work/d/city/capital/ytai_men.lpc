#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit GATE;
void create()
{
	set("short", HIW "新酸枣门" NOR);
	set("long", @LONG
新酸枣门也叫永泰门，门内即是旧城酸枣门。环绕汴京的外城城墙是用从郑
州虎牢关取来的土筑成，城墙多曲折，顺着地势而走，形似卧牛。城门除了南熏
，新郑，朝阳和通天四正门设直门两重以通御路外，其余的都是翁城相套，三重
城墙，城门都不在一条直线上。城外直通延津县，就是酸枣县。
LONG
	);
	set("outdoors", "capital");
	set("objects", ([ 
                  __DIR__"npc/gate_shibing" : 2,
         ]));
	set("exits", ([ 
                  "east" : __DIR__"cheq_men",
                  "west" : __DIR__"ansu_men",
         ]));
        set("detail",([
        ]));
	setup();
}
