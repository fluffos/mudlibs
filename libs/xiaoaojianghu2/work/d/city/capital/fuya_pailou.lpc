//汴京 ROOM: fuya_pailou.c
#include <ansi.h>
#include <room.h>
#include "bianjing.h"
inherit BROOM;
void create() {
  set("short", HIY "牌楼" NOR);
  set("long", "\n" +
    "正面前方有一座高大的木结构牌楼，三间七楼，墨绿色的琉璃瓦。牌楼正面\n" +
    "上写着:\n" + RED
    "            尔  奉  尔  禄        民  脂  民  膏\n" NOR +
    "背面写着：\n" + RED
    "            下  民  易  虐        上  苍  难  欺\n" NOR);
  set("exits", ([
    "south": __DIR__ "fuya_damen",
    "north": __DIR__ "fuya_zhengtang",
  ]));
  set("objects", ([
  ]));
  set("detail", ([
  ]));
  set("outdoors", "capital");
  setup();
}
