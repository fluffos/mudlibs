// 汴京     /d/city/capital/dxgs_shengrong_ge.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"

inherit BROOM;  
void create()
{
    set("short",HIR "圣容阁" NOR);
    set("long",@LONG
圣容阁大殿是相国寺的正殿，供奉的就是当年游方僧慧云化缘集资建寺时铸
造的弥勒大佛。大殿地基六亩三分，完全用木攒成，不用砖灰；九明十一暗，四
六隔扇，上盖一片绿色的琉璃瓦。大佛铜像高达一丈八尺，雄伟庄严，是王温修
装之圣容，金粉肉色，如同真人；四壁上彩绘壁画皆是名家手笔：文殊，维摩像
乃是吴道子所画；另有高益奉旨所绘阿育王像等，与大佛并列于相国寺十绝之位
。
LONG);
    set("exits",([
        "south"    : __DIR__"dxgs_dayuan2",
        "west"     : __DIR__"dxgs_xijing",
        "east"     : __DIR__"dxgs_dongjing",
        "north"    : __DIR__"dxgs_zisheng_men",
    ]));
    setup();
}
