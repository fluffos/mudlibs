//汴京 Npc : gate_shibing.c 
inherit "/d/city/capital/npc/soldier0";

#include "bianjing.h"
#include <ansi.h>

void create() {
  set_name(comm_man_name(), ({ "shi bing", "bing", "soldier" }));
  set("title", CYN "侍卫亲军" + RED "虎翼军" NOR + "士兵");
  set("age", 18 + random(20));
  set("long", "    一名侍卫亲军司的禁军士兵，负责京师的防卫。但见他全副武装；\n" +
    "脸上左颊刺有黑色纹记「虎翼」二字。\n");
  set("combat_exp", 8000);
  set("talk_msg", ({
    "当今之世，蕃戎内侵，边事不断，不知道哪一天我就会被派到西北前线去送了性命，唉！\n",
    "要进城吗？－－－－先把武器藏起来，别让当官的看见，我就不拦你了。\n",
    "一个月才发四百文，够干什么的呢？\n",
  }));
  SetPower("soldier", 1);
  setup();
  SetEquipment("soldier");
}
