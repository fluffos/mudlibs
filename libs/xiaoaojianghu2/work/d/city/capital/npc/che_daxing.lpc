// 汴京NPCs:   che_daxing.c
 
inherit NPC;
inherit F_VENDOR;

#include <ansi.h>
#include "bianjing.h"     

void create()
{
    set_name("车大行", ({ "che da xing","che","boss"}) );
    set("gender", "男性" );
    set("age",50 );
    set_hp("gin", 500);
    set_hp("kee", 600);
    set_hp("sen", 600);
    set("title","炭店老板");
    set("attitude", "friendly");
    set("vendor_goods", ([  
        "火折"        : BIANJING_ITEM "huozhe1",
    ]) );
    
    set("no_kill","capital");
    set("positive_score", 100);
    set("negative_score", 500);
    set("combat_exp", 10000);
    set("social_exp", 4000);
    setup();
    carry_object(CLOTH_DIR "mancloth2" )->wear();
    add_money("coin",120);
}
void init()
{
        add_action("do_vendor_list", "list");
}