//汴京 Npc : gate_yuhou.c
inherit "/d/city/capital/npc/soldier0"; 
#include "bianjing.h"
#include <ansi.h>
string call_others(object who); 
void create()
{
    set_name("虞候", ({ "yu hou", "hou","soldier" }));
    set("title",CYN "侍卫亲军" + RED "虎翼军" NOR);    
    set("age", 30 );
    set("long", "    禁军中每都设有虞候将校，协助军使理事。\n");
    set("combat_exp", 28000);
    set("max_force",1000); 
    set("force",1000);
    set("force_factor",40);     
    set("talk_msg",({
        "庶民之家，断不可存片甲兵刃，若有违反，杀无赦！！！！！\n",
        "好男儿当为国效力，看你身材体格不错，当兵吧？\n", 
        "什么时候才能当上指挥使呢？\n",
    }));
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        (: call_others :),
    })); 
    SetPower("yuhou",1);                   
    setup();
    SetEquipment("yuhou");
}
