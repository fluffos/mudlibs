//汴京 Npc : gate_yuhou.c
inherit SOLDIER; 
#include "bianjing.h"
#include <ansi.h>
string call_others(object who); 
void create()
{
    set_name("都头", ({ "du tou","tou","soldier" }));
    set("title",RED "禁军军官" NOR);    
    set("age", 30 );
    set("long","    禁军中每百人约为一都，每都设军使一人，步军中人都习惯称\n其为都头。\n");
    set("combat_exp", 8000);
    set("max_force",1000); 
    set("force",1000);
    set("force_factor",40);     
    set("talk_msg",({
        "庶民之家，断不可存片甲兵刃，若有违反，杀无赦！！！！！\n",
        "好男儿当为国效力，看你身材体格不错，当兵吧？\n", 
        "什么时候才能当上指挥使呢？\n",
    }));
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        (: call_others :),
    }));                    
    SetPower("dutou",TEACHER_STYLE);
    setup();
    SetEquipment("dutou");
}
