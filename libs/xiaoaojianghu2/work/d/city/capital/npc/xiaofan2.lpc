// 汴京NPCs:   xiaofan1.c
 
inherit NPC;
inherit F_VENDOR;

#include <ansi.h>
#include "bianjing.h"     

void create()
{
    set_name(comm_man_name(), ({ "xiao fan","fan","waiter"}) );
    set("gender", "男性" );
    set("age",20+ random(10) );
    set_hp("gin", 200);
    set_hp("kee", 400);
    set_hp("sen", 500);
    set("title","卖冷饮的小贩");
    set("attitude", "friendly");
    set("vendor_goods", ([  
        "麻腐鸡皮"     : BIANJING_FOOD "mafujipi",
        "冰雪冻丸子"   : BIANJING_FOOD "bingxue_wanzi",
        "冻鱼头"       : BIANJING_FOOD "dong_yutou", 
        "甘草冰雪凉水" : BIANJING_FOOD "gancao_liangshui",
        "绿豆汤"       : BIANJING_FOOD "lvdou_tang",
    ]) );
    set("positive_score", 100);
    set("combat_exp", 1000);
    set("social_exp", 400);
    set_wugong("unarmed",100,100,1);
    set_xiuwei_by_type( "unarmed",200 );
    setup();
    carry_object(CLOTH_DIR "mancloth1" )->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        message_vision("小贩对$N笑道：“客官，来些冷饮去去暑气吧？”\n",ob);
}
