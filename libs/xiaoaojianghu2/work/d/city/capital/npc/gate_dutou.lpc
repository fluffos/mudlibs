//汴京 Npc : gate_dutou.c 
inherit SOLDIER; 

#include "bianjing.h"

#include <ansi.h>

string call_others(object who); 

void create()
{
    set_name("都头", ({ "du tou", "tou","soldier" }));
    set("title",CYN "侍卫亲军" + RED "虎翼军" NOR);    
    set("class","soldier");
    set("age",30);
    set("long", "    禁军中每百人约为一都，每都设军使一人，步军中人都习惯称\n"+
                "其为都头。\n");
    set("combat_exp", 8000);
    set("max_force",1000); 
    set("force",1000);
    set("force_factor",50);     
    set("talk_msg",({
        "庶民之家，断不可存片甲兵刃，若有违反，杀无赦！！！！！\n",
        "好男儿当为国效力，看你身材体格不错，当兵吧？\n",
    }));
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        (: call_others :),
    })); 
    SetPower("dutou",1);                   
    setup();
    SetEquipment("dutou");
}
