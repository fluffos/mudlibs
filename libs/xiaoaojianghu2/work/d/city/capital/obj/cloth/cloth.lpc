#include <armor.h>

inherit CLOTH;
inherit F_CLOTHNAME;

void create()
{
    set_name(comm_man_cloth(), ({ "cloth" }) );
    set_weight(400);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "套");
        set("material", "cloth");
        set("armor_prop/armor", 1);
    }
    setup();
}
