// 汴京 FRUITs:    meizi.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create() {
  set_name(GRN "梅子" NOR, ({ "mei zi", "mei", "fruit" }));
  set_weight(30);
  set("long", @LONG
    一个绿色的梅子，看上去碧绿碧绿的。
LONG);
  set("unit", "个");
  set("value", 600);
  set("fruit_remaining", 1);
  set("food_supply", 3);
  set("water_supply", 10);
  set("end_msg", "$N仔细的啃完了$n。(酸咧~~~@!#@!~~~)\n");
  set("gifts", ([
    "per": 1,
  ]));
  set("core", "梅子核");
  set("core_id", ({ "meizi hu", "hu", "core" }));

  setup();
}
void init() {
  add_action("do_eat", "eat");
}
