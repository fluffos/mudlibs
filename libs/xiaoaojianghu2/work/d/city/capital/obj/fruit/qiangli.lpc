// 汴京 FRUITs:    jin_tao.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create()
{
    set_name(RED "羌李"NOR, ({"qiang li","li","fruit"}));
    set_weight(10);
    set("long", "一个从河西运来的李子，不知道是什么滋味。");
    set("unit", "个");
    set("value", 300);
    set("fruit_remaining", 2); //可以吃5口
    set("food_supply", 5);   //每口加10的food
    set("water_supply", 10);  //每口可以加10的water
    set("eat_msg", "$N拿起$n，咬了一口--好甜呀!!\n"); 
    set("end_msg", "$N仔细的啃完了这个$n。\n");  
    set("core", "李子核");     //name
    set("core_id", ({"lizi hu", "core"}) ); //id
    set("core_unit", "个");    //unit
    set("core_long", "一个李子核。\n"); //long
    set("gifts",([
        "cor" : 2,
    ]));
    setup();
}
void init()
{
    add_action("do_eat","eat");
}
