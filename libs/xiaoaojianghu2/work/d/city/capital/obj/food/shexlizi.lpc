//汴京 FOODs:  shexlizi.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(GRN"麝香栗子"NOR, ({"shexiang lizi","lizi","food"}));
    set_weight(100);
    set("long",@LONG    
    栗子是汴京城里人们都非常喜爱的一种食品，上自皇帝，下至平民都
  很爱吃。用小的新荷叶包起来，其中掺上一点麝香，芳凉无比，外头再
  用红绳系起来，倒也小巧可爱。
LONG);
    set("unit", "包");
    set("value", 1800);
    set("over_value",0);
    set("food_remaining", 10);
    set("gifts",([
        "per" : 1,
        "spi" : 2,
        "cor" : -1,
    ]));
    set("food_supply", 5);
    set("eat_msg","$N从荷叶包里面拿出一个$n贪婪地放进嘴里--"CYN"麝香的气味沁透肺腑，好爽耶！！\n"NOR);
    set("end_msg","$N从荷叶包里面拿出最后一个$n放进嘴里.\n");
}
int eat_effect(object me,object this) 
{
    if( me->query("water") >0 ) 
        me->add("water",-2);     
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name(GRN"荷叶"NOR,({"he ye","ye" }));
    this->set("long",@LONG  
    一张小小的荷叶，用来包裹食物的。
LONG);
    this->set("unit","张");
    this->set("value",0);
    this->set_weight(10);
    return 1;
}
