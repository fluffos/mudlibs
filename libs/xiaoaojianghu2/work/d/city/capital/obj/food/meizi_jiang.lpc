//汴京 FOODs:   梅子酱meizi_jiang.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(HIR "梅子酱" NOR, ({ "mei zi jiang", "jiang", "food" }));
  set_weight(150);
  set("long", @LONG
    一碗梅子捣成的酱，里面可能还掺了些糖。
LONG);
  set("unit", "碗");
  set("value", 1500);
  set("over_value", 0);
  set("food_remaining", 3);
  set("food_supply", 15);
  set("gifts", ([
    "per": 2,
    "con": 2,
    "int": 1,
    "spi": 1,
  ]));
  set("eat_msg", "$N拿起碗喝了一口里面的$n.好甜呀！！\n");
  set("end_msg", "$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") < me->max_water_capacity())
    me->add("water", 5);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name(GRN "竹碗" NOR, ({ "zhu wan", "wan" }));
  this->set("long", @LONG
    一个用来盛食物用的竹碗，已经用久了。
LONG);
  this->set("unit", "只");
  this->set("value", 0);
  this->set_weight(30);
  return 1;
}
