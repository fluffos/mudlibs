//汴京： FOODs :    盘兔肉panturou.c
                       
#include <weapon.h>
inherit HAMMER;
inherit F_FOOD;

#include <ansi.h> 

void create()
{
    set_name(HIR"盘兔肉"NOR, ({"pan tu rou","rou","food"}));
    set_weight(1000);
    set("long",@LONG               
    一大块香喷喷的兔肉。
LONG);
    set("unit", "块");
    set("value", 3000);
    set("over_value",0);                                  
    set("food_remaining", 3);
    set("food_supply", 100);
    set("eat_msg","$N拿起$n咬了一口.\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me,object this)
{
    if( me->query( "water" ) < me->max_water_capacity() )
        me->add( "water" , -5);    
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name("兔子骨头",({"tu gu","gu","bone" }));
    this->set("long",@LONG  
    一根粗大的兔后腿骨。
LONG);
    this->set("unit","根");
    this->set("value",0);
    this->set_weight(300);    
    this->set("material","bone");
    this->set( "weapon_prop/damage", 4 );
    this->set( "flag", 0);
    this->set( "skill_type", "short" );
    this->set( "weapon_type" ,"hammer");
    this->set( "verbs", ({ "bash", "crush", "slam" }) );
    setup();
    return 1;
}
