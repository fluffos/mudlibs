//汴京： FOODs :   charou_mian.c 

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(YEL"插肉面"NOR, ({"cha rou mian","mian","food"}));
    set_weight(300);
    set("long",@LONG   
    一碗热气腾腾的面条，上面放着几块烤肉。是四川馆子里面的特色食品。 
LONG);
    set("unit", "碗");
    set("value", 2000);
    set("over_value",0);                                  
    set("food_remaining", 3);
    set("food_supply", 35);
    set("eat_msg","$N拿起筷子使劲往嘴里扒拉着面条....\n");
    set("end_msg","$N将剩下的肉片有些舍不得地吃了个干干净净，连面汤也喝干了.\n");
}
int eat_effect(object me,object this)
{
    if( me->query("water") < me->max_water_capacity() ) 
        me->add("water",20);     
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name(HIY"竹碗"NOR,({"zhu wan","wan" }));
    this->set("long",@LONG    
    一个用旧了的竹碗。
LONG);
    this->set("unit","个");
    this->set("value",0);
    this->set_weight(30);  
    return 1;
}
