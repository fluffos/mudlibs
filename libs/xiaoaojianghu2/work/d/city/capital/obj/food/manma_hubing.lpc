//汴京 FOODs:   manma_hubing.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name("满麻胡饼", ({"man ma hubing","hubing","bing","food"}));
    set_weight(200);
    set("long",@LONG   
    一个烤得外皮焦黄的芝麻胡饼,两面都沾满了芝麻。
LONG);
    set("unit", "个");
    set("value", 500);
    set("over_value",0);
    set("food_remaining", 3);  
    set("food_supply", 25);
    set("eat_msg","$N拿起$n咬了一口.\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me,object this) 
{
    if( me->query("water") > 0  ) 
        me->add("water",-1);     
    return 0;
}
