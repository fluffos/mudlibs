//汴京 FOODs:   laluobu.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name("辣萝卜", ({ "la luobu", "luobu", "food" }));
  set_weight(150);
  set("long", @LONG      
    一包用来就稀饭的小菜。
LONG);
  set("unit", "包");
  set("value", 400);
  set("food_remaining", 4);
  set("food_supply", 5);
  set("eat_msg", "$N拿起几根$n放进嘴里.\n");
  set("end_msg", "$N将剩下的$n吃的干干净净.\n");
  set("over_msg", "别吃太多了，会闹肚子的耶（古时候哪儿有卫生检疫呢？）.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") > 0)
    me->add("water", -12);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name("油皮纸", ({ "youpi zhi", "zhi", "paper" }));
  this->set("long", "一张用来包食物的纸，已经被油浸透了。\n");
  this->set("unit", "张");
  this->set("value", 0);
  this->set_weight(1);
  return 1;
}
