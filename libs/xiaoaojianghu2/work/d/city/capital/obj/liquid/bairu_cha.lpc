//汴京 LIQUIDs:  bairu_cha.c 

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create()
{
    set_name(WHT"白乳"NOR, ({ "bairu cha","cha","water" }));
    set_weight(800);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", @LONG     
        一壶热气腾腾的茶，是用高级的贡品茶叶「白乳」沏的，一股
  清新的茶香从壶里冒出来。
LONG);
        set("unit", "壶");
        set("value", 13000);           
        set("over_value",5);
        set("max_liquid", 10); 
        set("drink_msg","$N从茶壶中倒了一杯$n,仔细地品味着。\n");
    }
    set("liquid", ([
        "type": "tea",
        "name": WHT"白乳"NOR,
        "remaining": 10,
        "drink_apply": 20,
    ]));
}                 
int do_fill( string arg )
{
    object this, who;
    this = this_object();
    who = this_player();            
    
    if( !who->can_act() ) return 0;
    if( !this->id( arg ) ) return 0;
    
    if( !objectp( present( "cha boshi", environment( who ) ) ) )
        return notify_fail("这里没有茶博士\n");
        
    if( this->query( "liquid/remaining" ) ) 
        return notify_fail("你壶里的茶还没有喝完呢！\n");
    if( this->query( "fill_time" ) >= 3 )
     {
        message_vision("茶博士瞧了瞧$N面前的$n,笑了笑说：“这位客官，您的茶已经泡不出颜色来啦！\n"
        "还是再换一壶吧？\n", who, this );
        return 1;
     }
    message_vision("茶博士提着一大壶滚水走到$N跟前，将$N面前的茶壶中续满了水\n", who);
    this->set( "liquid/remaining" , this->query( "max_liquid" ) );     
    this->add( "fill_time", 1 );
    return 1;
}
int drink_effect(object who,object this)
{
}
