//汴京 LIQUIDs: yanggao_jiu1.c 

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create()
{
    set_name("羊羔酒", ({"yanggao jiu","jiu"}));
    set_weight(300);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", @LONG
        一个储存陈年老酒的大坛子，里面能装三十来斤酒。
LONG);
        set("unit", "整坛");
        set("value", 17000);
        set("max_liquid", 100); 
        set("drink_msg","$N端起坛子喝了一大口羊羔酒。\n");
    }
    set("liquid", ([
        "type": "alcohol",
        "name": "羊羔酒",
        "remaining": 100,
        "drink_apply": 30,
        "drunk_apply": 4,
    ]));
}   
void init()
{
    add_action("do_drink","drink");
}

int drink_effect(object who,object this)
{
}
