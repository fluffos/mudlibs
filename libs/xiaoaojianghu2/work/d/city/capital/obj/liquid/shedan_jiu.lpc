//汴京 LIQUIDs:  shedan_jiu.c 

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create()
{
    set_name(YEL"蛇胆酒"NOR, ({"shedan jiu","jiu"}));
    set_weight(300);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", @LONG
        一个竹子制成的大酒杯，里面恰好能装一角酒。
LONG);
        set("unit", "杯");
        set("value", 3000);
        set("max_liquid", 3); 
        set("drink_msg","$N端起酒杯喝了一大口蛇胆酒。\n");
    }
    set("liquid", ([
        "type": "alcohol",
        "name": "蛇胆酒",
        "remaining": 3,
        "drink_apply": 20,
        "drunk_apply": 5,
    ]));
}   
void init()
{
    add_action("do_drink","drink");
}

int drink_effect(object who,object this)
{
    who->add("gifts_jilei", ([
             "spi" : 3,
             "int" : 2,
          ]));
    return 0;
}
