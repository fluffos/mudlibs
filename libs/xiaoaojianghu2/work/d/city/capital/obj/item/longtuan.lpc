// 汴京 TEA :      longtuan.c

inherit TEA;
              
#include <ansi.h>
#include "bianjing.h"

void create()
{
    set_name(YEL"龙团茶"NOR, ({ "longtuan cha","cha","tea","dragon tea" }) );
    set("long",@LONG 
    龙团茶乃是茶中最珍贵的精品，系惊蜇时分，在一个多雾无日的清晨，由
  茶农从山上背阴凉爽之处采得才刚发芽的新叶，焙干后经过十几道加工，制
  成饼茶，外涂蜂蜡，光泽闪耀，内加麝香，冰片等香料，馨香无比。每年由
  南方各省采制入贡，一年也才得几百饼而已。
LONG);
    set("unit","饼");
    set("value",500000);
    set_weight(50);
    setup();
}
