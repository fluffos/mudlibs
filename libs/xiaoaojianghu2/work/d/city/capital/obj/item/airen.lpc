// 汴京 ITEM :      airen.c

#include <armor.h>

inherit WAIST;
              
#include <ansi.h>
#include "bianjing.h"

void create()
{
    set_name(HIY"艾人"NOR, ({ "ai ren","ren" }) );
    set("long",@LONG 
    这是一个用菖蒲刻成的人形饰物，据说有避邪的作用。就如王沂公的诗句
  所说： 
          明朝知是天中节，旋刻菖蒲要辟邪。
LONG);
    set("unit","个");
    set("value",15);
//    set("cant_sell","这样东西不值钱。\n");
    set_weight(20);
    set("material","wood");
    set("armor_prop/armor",10);
    setup();
}
