inherit ROOM;

string query_room_type()
{
    return "capital_smallroom";
}
int can_sleep( object me )
{
    if( me->query("class") == "soldier" || me->query("class") == "government" )
    {
        if( objectp( present( "shi bing",environment(me) ) ) )
            return 0;
        else if( objectp( present( "shi bing",environment(me) ) ) )
            return 0;
        else 
            return 1;
    }
    else 
        return 0;
}  
