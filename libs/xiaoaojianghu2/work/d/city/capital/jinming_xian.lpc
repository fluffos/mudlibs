// 汴京     /d/city/capital/jinming_xian.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create()
{
  set("short",GRN "西岸" NOR);
  set("long",@LONG
沿着金明池西岸，也是一条牙道柳径，脚下青草茵茵，小径曲曲折折，绿树
掩映。中有空地如坪者，是都中游人击逑游戏的场所。这里的环境非常幽静；池
边有些人在钓鱼，不过，要先向管理的卫士买一个牌子才能钓的。
LONG GRN @TEXT
    一阵阵微风吹来，夹着池水的气息，让人联想起了江南的风光。
TEXT NOR);
  set("exits",([
    "southeast"  : __DIR__"hengjie0",
  ]));
  set("outdoors","capital");
  set("objects",([
//          __DIR__"npc/youren1" : 1,
  ]));
  setup();
}
