// 汴京     /d/city/capital/dxgs_dayuan1.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"

inherit BROOM;
void create()
{
  set("short",HIW "                        大        院" NOR);
  set("long",@LONG
相国寺寺院规模宏大，殿阁楼台无不令行人驻足赞叹。正中的大院更是象个
大广场一般。每个月举行五次大型的贸易集市，就设在大院中，买卖各方总共有
数万人之多，江南西北各地的商人，都把他们的货物运到这里，互相直接用货物
交易，动辄值数十万之巨。东西两廊也都是货摊。北面是一间高大的门楼。
LONG);
  set("exits",([
    "south"    : __DIR__"dxgs_shanmen",
    "west"     : __DIR__"dxgs_xita",
    "east"     : __DIR__"dxgs_dongta",
    "north"    : __DIR__"dxgs_sanmen",
  ]));
  set("outdoors","capital");
  setup();
}
