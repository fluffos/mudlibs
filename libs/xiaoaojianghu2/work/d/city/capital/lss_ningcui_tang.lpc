#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit SROOM;
void create()
{
	set("short",GRN "凝翠堂" NOR);
	set("long", @LONG
一座气派的堂宇正厅，四面皆是镂空雕花的檀木大窗，垂着文锦彩绣的缎帐，
地下铺着西域贡来的毛毯，主客之位皆是席地绣锦团垫，几条楠木小桌，上面摆
着香鼎，茶具；并一架陈旧的古琴。门前挂着斑竹垂帘，隐隐可见门外秀水翠枝，
盆池假山，世俗之念一洗皆去。
LONG
	);
	set("objects", ([ 
         ]));
	set("exits", ([  
	    "north" : __DIR__"lss_tingyuan",
	    "east" : __DIR__"lss_houyuan",
         ]));     
    set("detail",([
    ]));
	setup(); 
}
