// 汴京     /d/city/capital/bianhe_matou.c
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create()
{
  set("short",CYN "汴河码头" NOR);
  set("long",@LONG
汴河又叫通济渠，是隋炀帝时开凿用来运送江南的粮食物资到洛阳去的重要
运河。自宋建朝以来，为了保证东京乃至整个中原地区的物资供应，对汴河进行
了工程浩大的整修，每年有近千万石的粮食从这里运达汴京。通商的船只更是不
计其数。码头上停着几十只大大小小的船只。
LONG);
  set("exits",([
    "north"  : __DIR__"xinz_men",
    "south"  : "/d/place/donggong/matou",
  ]));
  set("objects",([
//           __DIR__"npc/xiaowei" : 2,
//           __DIR__"npc/shibing" : 3,
  ]));
   set("outdoors","capital");
  setup();
}

int valid_leave(object me,string dir)
{

        if ( dir!="south" ) return 1;
       if (this_player()->query("gender")!="无性")
      	return notify_fail( "对不起，官府拨了一批银两，这条路正在修整。\n" );
            return 1;

}

