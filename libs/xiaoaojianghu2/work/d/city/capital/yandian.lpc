#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit BROOM;
void create()
{
  set("short",RED "宴  殿" NOR);
  set("long",@LONG
这里是皇帝在检阅了水师后，设大宴款待众臣的地方。大殿正中有先帝手书
一块赤金匾额写着
LONG HIY @TEXT
                     与   民   同   乐     
TEXT NOR @AAAA
御驾降临的时候，这里还是宫中妃嫔们休息的地方，所以是不准百姓进来的。北
面有游廊直通建在高台之上的宝津楼。
AAAA);
  set("exits",([
    "northup"  : __DIR__"baojin_lou",
    "north"    : __DIR__"chimen_guangchang",
  ]));
  setup();
}
