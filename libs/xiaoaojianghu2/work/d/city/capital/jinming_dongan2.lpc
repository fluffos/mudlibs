// 汴京     /d/city/capital/jinming_dongan2.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create()
{
  set("short",GRN "东岸" NOR);
  set("long",@LONG
池的东岸，临水近墙之处，都是垂杨依依；两旁有许多彩棚，幕帐，专门出
租给游人观赏池中的风光和表演项目。东面有许多酒食店面，也有赌博的场所。
不过这些地方到了园子对百姓关闭的时候就都出让了。东北面有一个巨大的船
坞，是停放龙舟的御船坊。
LONG GRN @TEXT
    一阵阵微风吹来，夹着池水的气息，让人联想起了江南的风光。
TEXT NOR);
  set("exits",([
    "south"      : __DIR__"jinming_dongan1.lpc",
  ]));
  set("outdoors","capital");
  set("objects",([
//          __DIR__"npc/youren1" : 1,
  ]));
  setup();
}
