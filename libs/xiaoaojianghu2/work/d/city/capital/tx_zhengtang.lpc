#include "bianjing.h"

#include <room.h>
#include <ansi.h>    

inherit DOOR_ROOM;
//inherit BROOM;
void create()
{
    set("short",RED"太学正堂"NOR);
    set("long", @LONG
正堂上摆放着先圣孔子，诸先师大儒，以及当今圣上的牌位。每日朝拜，不
敢辍弃。堂内各房中朗朗的读书声，先生的讲书声隐隐传来。不时有学生从身边
匆匆走过，手里大都拿着书卷。
LONG);
    set("exits", ([ 
        "south"     : __DIR__"taixue",
        "west"      : __DIR__"tx_xiashe", 
        "north"     : __DIR__"tx_shangshe",
        "east"      : __DIR__"tx_zhongshe",
        "southeast" : __DIR__"tx_zhaitang",
    ]));
    create_door("south","太学大门","north",DOOR_CLOSED);
    create_door("southeast","小门","northwest");
//    set("detail",([
//    ]));
    setup();
}
