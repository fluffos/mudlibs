// 汴京   bianhe_jie2.c
#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit STREET;
void create() {
  set("short", HIW "汴河大街" NOR);
  set("long", @LONG
横连新郑门到新宋(朝阳)门的大街是汴京城中最宽的大街(天街除外)，但是
也只有三十步宽。大街沿着汴河的北岸，两边都是临街的大店铺，花红柳绿，车
马喧沸。北面是一家大宅院，不知是哪个达官贵人的府第。东面是有名的大相国
寺了，寺前一座石桥横跨汴河。
LONG
  );
  set("objects", ([
  ]));
  set("exits", ([
    "west": __DIR__ "bianhe_jie1",
    "southeast": __DIR__ "dxgs_qiao",
  ]));
  set("detail", ([
  ]));
  setup();
}
