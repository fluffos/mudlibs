#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit DOOR_ROOM;

void create()
{
        set("short","小甜水巷");
        set("long", @LONG
一条宽仅数步的小巷，因小巷中有井水甘可口，故而名之。这里已经是汴京
城的街巷深处，四面离大街均很远；路上车马渐少，行人却是很多。路边有几家
食品小店，多卖些南味小吃。东边是一家妓院，北边是一个十字路口。南面就是
著名的大相寺的后门。
LONG
        );
        set("objects", ([ 
         ]));
        set("exits", ([   
            "south" : __DIR__"dxgs_houmen",
            "north" : __DIR__"shizi_lukou1",
         ]));
        create_door("south","院门","north",DOOR_CLOSED);
        set("outdoors", "capital");
        setup();
}
