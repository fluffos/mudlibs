#include "bianjing.h"
inherit SROOM;
void create() {
  set("short", CYN "梅花堂" NOR);
  set("long", @LONG
后院天井之中有一株高大的腊梅树，孤立挺拔，奇形兀立，每年冬天，傲立
雪中，花香四溢，人以为奇；后来就建一堂于后院，称“梅花堂”。两侧还有拱
奎堂，清治堂等等，斗士知府平日休息之所。
LONG);
  set("exits", ([
    "south": __DIR__ "fuya_zhengtang",
    "east": __DIR__ "fuya_huayuan",
  ]));
  set("objects", ([
  ]));
  set("detail", ([
  ]));
  setup();
}
