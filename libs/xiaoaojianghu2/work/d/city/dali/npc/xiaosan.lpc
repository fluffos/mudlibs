inherit NPC;

inherit F_VENDOR;

void create() {
  set_name("小三", ({ "xiao san", "san" }));
  set("title", "酒保");
  set("gender", "男性");
  set("age", 16);
  set("combat_exp", 10000);
  set("attitude", "friendly");

  set("vendor_goods", ([
    "女儿红": __DIR__ "obj/nver",
    "竹叶青": __DIR__ "obj/zhuye",
    "大理黄酒": __DIR__ "obj/huangjiu",
    "糯米酒": __DIR__ "obj/nuomi",
    "蛇酒": __DIR__ "obj/shejiu",
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !this_object()->can_act()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}
void greeting(object ob) {
  message_vision("小三正忙上忙下地给客人送酒，似乎没看到$N进来。\n", ob);
}
