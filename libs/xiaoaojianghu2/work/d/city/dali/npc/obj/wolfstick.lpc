#include <weapon.h>
inherit STAFF;
void create()
{
        set_name("狼牙棒", ({ "wolf stick","stick" }) );
        set_weight(12000);//一种很重的武器。
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("value", 1000);
                set("material", "steel");
                set("long", "这是一根实心镔铁大棒，入手沉重，棒上满是狼牙倒刺。\n");
                set("wield_msg", "$N拿起沉甸甸的$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰间。\n");
        }
        init_staff(60);//因为很重，所以DAMAGE很大。
        setup();
}
