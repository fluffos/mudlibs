//qimei_gun.c
#include <weapon.h>
#include <armor.h>
#include <ansi.h>
inherit STAFF;
void create()
{
	set_name("熟铜齐眉棍", ({"shutong qimeigun","tong gun","gun","staff"}) );
	set_weight(12000);
	if( clonep() )
		set_default_object(__FILE__);
	else {               
	    set("long",@LONG
      一根长逾四尺的熟铜齐眉棍，是傅思归赖以成名的兵刃。
LONG);
		set("unit", "根");
		set("value",200);
		set("material", "copper");
        set("armor_prop/armor",1);
	}
	init_staff(30);
	set("wield_msg", "$N将一根$n紧握在胸前。\n");
	set("unwield_msg", "$N将手中的$n放下。\n");
	setup();
}
