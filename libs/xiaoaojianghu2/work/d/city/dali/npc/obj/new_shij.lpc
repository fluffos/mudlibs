inherit ITEM;
void create()
{
        set_name( "史记", ({ "shi ji", "book" }));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("long", "一本经过修补装订的古书\n");
     
       set("value",1200);
                set("material", "paper");
                set("skill", ([
                        "name": "literate",        // name of the skill
                        "exp_required": 30000,     // minimum combat experience required
                        "sen_cost": 20+random(20),// jing cost every time study this
                        "difficulty":   40,     // the base int to learn this skill
                        "max_skill":    101      // the maximum level you can learn
                ]) );
        }
}
