#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "北走廊");
	set("long", @LONG
这是条连接内宅和外宅的走廊，呈“T ”字型，飞檐红柱，大理石铺就的地
面一尘不染，两个衣着光鲜的小丫鬟认真正在擦洗两边的栏杆和柱子，不时见丫
鬟们匆匆走过。偶尔传来银铃般的笑声。东面是一条长廊，北面是内堂。南面就
是通往外宅的走廊了。
LONG
	);
    set("exits", ([ 
	        "east"  : __DIR__"changlang",
	        "north"  : __DIR__"neitang",
	        "south"  : __DIR__"zoulang",
        ]));
	
	setup();
	//place_program(ROOM);
}                       

