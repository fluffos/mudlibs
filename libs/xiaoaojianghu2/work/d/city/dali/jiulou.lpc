#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "太白楼");
  set("long", @LONG
这是长安太白楼大理分店，是一座很漂亮的两层塔式建筑, 老板娘正在门口
热情地招呼着客人, 酒保上上下下忙乱地奔跑着吆喝着, 生意很是兴容, 这儿以
"太白陈酿"和"东坡肘子"而闻名 ,其它的菜也做的很地道。墙角的桌子旁坐着几
个人模样十分可疑。
LONG
  );
  set("safeplace", 1);
  set("exits", ([
    "west": __DIR__ "nanjie1",
  ]));

  set("objects", ([
    __DIR__ "npc/xiaosan": 1,
    "/d/menpai/duanshi/npc/wuwei": 1,
    "/d/place/wiz/locker": 1,
    "/d/place/wiz/polan": 1,
    "/d/place/wiz/mumu": 1,
  ]));

  setup();
  //place_program(ROOM);
}
void init() {
  add_action("do_kill", "kill");
  //       add_action("do_exert","exert"); 

}

int do_kill(string arg) {

  tell_object(this_player(), "大理可是段家的天下，你在这里对段无畏动武不是找死么？有什么过节找其他场合吧。\n");
  return 1;
}
int do_exert(string arg) {
  tell_object(this_player(), "满酒楼的人呢，做这么奇怪的动作，你不怕人家笑话你呀。\n");
  return 1;
}
