//  By lin
//  Changed by Lala, 1998-03-12

inherit ROOM;

void create() {
  set("short", "广场");
  set("long", @LONG
广场地处城市中心，四面皆是宽阔的街道。正中有一个四方形的木栏，是供
旅客拴马休息用的，栏下是一排石槽，几匹马正在低头向槽中吃草。正东是威武
气派的将军府和驻军大营，西边是一条大街，直通西门；南边则是热闹的集市，
叫卖声不断传来。
LONG
  );
  set("outdoors", "lanzhou");
  set("exits", ([
    "north": __DIR__ "beijie",    //兰州北街
    "south": __DIR__ "nanjie1",   //兰州南街
    "west": __DIR__ "xijie1",    //兰州西街
    "east": __DIR__ "dongchang",  //兰州东广场
  ]));
  set("objects", ([
    __DIR__ "npc/daxia": 1,
  ]));

  setup();
}
