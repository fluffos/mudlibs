//  By lin
// Changed by lala, 1998-03-16

inherit ITEM;

void create() {
  set_name("麻袋", ({ "ma dai", "madai", "dai", "bag" }));
  set_weight(200);                      //四市两；
  set_max_encumbrance(15000);           //容量：三十市斤；
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("value", 20);                 //价格：２０文／只
    set("material", "cloth");         //质地：麻布。
  }
}

int is_container()                          //是容器。
{
  return 1;
}
