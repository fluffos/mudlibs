//  扁担    /clone/weapon/staff/biandan.c

#include <weapon.h>

inherit STAFF;

void create()
{
    set_name( "扁担", ({ "bian dan", "biandan", "pole" }) );
    set_weight( 3000 );                     //六市斤；
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {               
        set( "long", "一根挑东西用的扁担。\n" );
        set( "unit", "根" );
        set( "value", 112 );                //价格：(1*100)攻击力价格
                                            //+(4*3)木价格=112总价格；
        set( "material", "wood" );          //质地：木（单价４文／千克）
    }
    init_staff( 1 );                        //攻击力：1；

    set( "wield_msg", "$N将一根$n紧握在胸前。\n" );
    set( "unwield_msg", "$N将手中的$n放下。\n" );

    setup();
}
