inherit ROOM;

void create() {
  set("short", "兵营大门");
  set("long", @LONG
为了巩固兰州城防，联合吐蕃对抗西夏，朝廷在城内外一共部署了数千精兵。
虽然这些军爷给城中的日常生活带来了许多不便，但回想起过去西夏军队的抢劫
洗掠，老百姓们心里总算能踏实了许多。
    门内营盘齐整，一队队士兵走来走去，中间空地上有士兵正在练习阵法。南
面是马厩。
LONG
  );
  set("outdoors", "lanzhou");
  set("exits", ([
    "south": __DIR__ "dongchang",  //兰州东广场
  ]));
  set("objects", ([
    __DIR__ "npc/shibing": 2,      //士兵
  ]));

  setup();
}
