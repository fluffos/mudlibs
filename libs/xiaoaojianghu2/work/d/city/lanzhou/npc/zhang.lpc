inherit NPC;
inherit F_VENDOR;
void create() {
  set_name("张铁匠", ({ "zhang" }));
  set("gender", "男性");
  set("age", 38);
  set("combat_exp", 400);
  set("inquiry", ([
    "铲子": "对不起，小人店里的铲子都给人订走了。\n",
  ]));
  set_xiuwei_by_type("short", 120);
  set("talk_msg", ({
    "上好的兵器，这位侠士来一件？\n",
  }));
  set("vendor_goods", ([
    "朴刀": __DIR__ "obj/blade",
    "铁剑": __DIR__ "obj/sword",
    "佩刀": __DIR__ "obj/blade1",
    "佩剑": __DIR__ "obj/sword1",
    "铁护心甲": __DIR__ "obj/kaijia",
    //                "长枪" : __DIR__"obj/gun",
    "头盔": __DIR__ "obj/toukui",
    "铁锤": __DIR__ "obj/hammer",
    "扁担": __DIR__ "obj/biandan",
  ]));

  setup();
  carry_object(__DIR__ "obj/cloth2")->wear();
  carry_object(__DIR__ "obj/hammer")->wield();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}
void greeting(object ob) {
  say("铁匠说道：“客官想买什么？”\n");
}
