//  和尚    /d/city/lanzhou/npc/monk.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//        零级修为（      ０－  １００）一级武功（    ０－  ６０）
//        经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-28

inherit NPC;

void create()
{
    set_name( "和尚", ({ "he shang", "heshang", "monk" }) );
    set( "title","佛光寺僧人" );
    set( "gender", "男性" );                //性别：男
    set( "attitude", "friendly" );          //态度：友善
    set( "long", @LONG
    这是个佛光寺本寺的常住和尚。
LONG
    );
       
    set( "chat_chance", 4 );
    set( "chat_msg", ({
        "和尚喃喃道：“南无阿弥托佛……”\n",
    }) );

    setup();

    carry_object( CLOTH_DIR + "sengyi2" )->wear();      //粗布僧衣
}

int accept_object( object ppl, object obj )
{
    command( "smile" );
    command( "say 多谢这位" + RANK_D->query_respect( ppl )
        + "，您好心一定会有好报的！" );
    if ( random( 20 ) == 1                  //给和尚钱的好处。
        && ppl->query( "combat_exp" ) < 1000 
        && obj->value() > 0 )
        ppl->add( "combat_exp", 1 );
    return 1;
}

int accept_fight( object ppl )
{
    command( "say “" + RANK_D->query_respect( ppl ) 
        + "，我佛慈悲为怀，人生在世怎可好勇斗狠？阿弥托佛,善哉善哉！”\n" );
    return 0;
}

int query_answer( object who )
{
    command( "sigh" );
    command( "say “眼下世风是一年不如一年了，连作道士都有不守本分的。”" );
    command( "poor" );
    command( "say “尤其流言蜚语，又是更大一害。”" );
    return 1;
}
