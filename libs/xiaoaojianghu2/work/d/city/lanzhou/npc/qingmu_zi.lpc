//  青木子：星宿派一般弟子（现在还没有星宿）    /d/city/lanzhou/npc/qingmu_zi.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
//  ★
//  〖三级〗一级修为（  １０１－  １５０）一级武功（  ６０－１００）
//          经验（  ７５００－１５０００）声望（        ７５－       １５０）
//          内力（      ０－      ２００）体能、生命（  ２００－     ２５０）
//  By Lin
//  Changed Lala, 1998-03-28

#include <ansi.h>

inherit NPC;

void create()
{
    set_name( "青木子", ({ "qingmu zi", "zi", "qingmu", "qingmuzi" }) );
    set( "title", HIY"星宿弟子"NOR );
    set( "gender", "男性" );                //性别：男
    set( "age", 24 );                       //年龄：24
    set( "per", 14 );                       //容貌：14
    set( "attitude", "killer" );            //态度：嗜杀
    set( "negative_score", 150 );           //负声望：150
    set( "long", @LONG
    青木子一脸的不屑之色，只管自顾自地喝酒。
LONG
    );

    set_wugong( "blade",        100,    100,    1 );    //横刀六式：    一级

    set_wugong( "unarmed",       80,     80,    1 );    //基本拳法：    一级

    set_wugong( "qinggong",      80,     80,    1 );    //基本轻功：    一级

    set_xiuwei_by_type( "blade",    130 );  //刀法修为：    一级
    set_xiuwei_by_type( "unarmed",  100 );  //拳脚修为：    零级
    set_xiuwei_by_type( "dodge",     80 );  //轻功修为：    零级

    set( "max_force",   160 );              //内力：    160
    set( "force",       160 );

    set_hp( "kee",      240 );              //生命、体能：  240
    set_hp( "sen",      240 );

    set( "combat_exp",  13000 );            //战斗经验：13000

    set( "chat_chance", 1 );
    set( "chat_msg", ({
        "青木子高声叫道：“快拿好酒来！”\n",
        "青木子边喝边嘟囔着：“这样差的地方，也算是雅座？哼！”\n"
            + "老板娘狠狠地瞪了他一眼。\n",
    }) );

    setup();

    carry_object( CLOTH_DIR + "cloth3" )->wear();       //紫布长衫
    carry_object( BLADE_DIR + "blade2" )->wield();      //单刀
    add_money( "coin", random( 20 ) * 50 ); //一千文以内的铜钱
}

int accept_fight( object ppl )
{       
    if ( !ppl->query_temp( "defeate_qingmu_zi" ) )
    {
        command( "say “" + RANK_D->query_rude( ppl ) 
            + "，居然敢和大爷动手？！”\n" );
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
        return 1;
    }        
    command( "admire " + ppl->query( "id" ) );
    return 0;
}

int accept_bihua( object ppl )
{
    return accept_fight( ppl );
}

int be_defeated( object ppl )
{
    ppl->set_temp( "defeate_qingmu_zi", 1 );
}
