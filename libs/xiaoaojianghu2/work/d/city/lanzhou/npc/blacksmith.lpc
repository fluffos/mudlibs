//  张铁匠：铁匠，卖兵器    /d/city/lanzhou/npc/zhang.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//        零级修为（      ０－  １００）一级武功（    ０－  ６０）
//        经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-25

inherit NPC;
inherit F_VENDOR;

int eventKillKickor(object who, object nouse, string arg) {
  if (!arg || arg != "door")
    return 0;
  message_vision("老铁匠对$N大喝：“干什么！！”\n", who);
  kill_ob(who);
  return 1;
}

void create() {
  set_name("张铁匠",
    ({ "zhang tiejiang", "zhang", "tiejiang",
      "zhangtiejiang", "blacksmith" }));
  set("gender", "男性");                //性别：男
  set("age", 68);                       //年龄：68
  set("str", 28);                       //臂力：28
  set("long", @LONG
    张铁匠是个从军中退役的老铁匠，在这里买打铁为生。
LONG
  );

  set_xiuwei_by_type("short", 80);   //短兵刃修为：80

  set("combat_exp", 6000);              //战斗经验：6000

  set("inquiry", ([
    "铲子": "对不起，小人店里的铲子都给人订走了。",
  ]));
  set("talk_msg", ({
    "“上好的兵器，这位侠士来一件？”",
  }));
  set("vendor_goods", ([
    "朴刀": BLADE_DIR + "blade1",
    "单刀": BLADE_DIR + "blade2",
    "铁剑": __DIR__ "obj/sword",
    "长剑": __DIR__ "obj/sword1",
    "铁护心甲": __DIR__ "obj/kaijia",
    "头盔": __DIR__ "obj/toukui",
    "铁锤": __DIR__ "obj/hammer",
    "扁担": __DIR__ "obj/biandan",
  ]));
  set("EnvEffect", ([
    "kick": ([
      "int_level": 4,
      "funcname": (: eventKillKickor :),
    ]),
  ]));

  setup();

  carry_object(CLOTH_DIR + "cloth2")->wear();        //粗布衣
  carry_object(SHORT_DIR + "hammer")->wield();       //铁锤
}

void init() {
  object ppl;

  ::init();

  if (!userp(ppl = this_player())
    || !can_act())
    return;

  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);
  add_action("do_vendor_list", "list");  //商人列表的函数。
}

void Greeting(object ppl) {
  command("say “客官想买什么？”");
}
