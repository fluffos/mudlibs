//  西域胡商：闲人  /d/city/lanzhou/npc/trader.c
//  等级：
//  【丁等】大门派的三级师傅、中等门派的二级师傅、小门派的一级师傅
//  ★★☆
//  〖三级〗二级修为（  ４５１－  ６００）三级武功（  ６０－１００）
//          经验（      ６万－１２、５万）声望（       ６００－    １２５０）
//          内力（  ６００－      ９００）体能、生命（   ３５０－    ４２５）
//  By lin
//  Changed by lala, 1998-03-29

inherit NPC;

void create()
{
    set_name( "西域胡商", ({ "hu shang", "hushang", "shang", "trader" }) );
    set( "gender", "男性" );                //性别：男
    set( "age", 28 + random( 20 ) );        //年龄：28～47
    set( "positive_score", 600 );           //正声望：600
    set( "negative_score", 300 );           //负声望：300
    set( "long", @LONG
    这是一名从西域长途跋涉来到中原的胡商。
LONG
    );

    set_wugong( "xueying-jian",  60,     60,    1 );    //天山雪影剑：  三级
    set_wugong( "unarmed",      100,    100,    1 );    //基本拳法：    一级

    set_xiuwei_by_type( "sword",    450 );  //剑术修为：    二级
    set_xiuwei_by_type( "unarmed",  130 );  //拳脚修为：    一级

    set( "combat_exp",  80000 );            //战斗经验：80000

    set( "max_force",   600 );              //内力：    600
    set( "force",       600 );
    set( "force_factor", 30 );              //加力：    30(5%)

    set_hp( "kee",      350 );              //生命、体能：  350
    set_hp( "sen",      350 );

    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "商人高兴地自言自语道：“终于踏上东方的土地了。”\n",
        "商人感叹万分：“真不容易呀！”\n",
        "商人叹了口气，要不是我在高昌买到了几头骆驼，这个沙漠还真难过。\n",
        "商人舔了舔干裂的嘴唇。\n",
     }));
    set( "inquiry",([/* sizeof() ==2 */
        "骆驼"    :   "我是在高昌波斯铺老板那里买的。",
        "买骆驼"  :   "我是在高昌波斯铺老板那里买的。",
    ]));
    setup();

    if ( random( 100 ) > 80 )
        carry_object( SWORD_DIR + "sword1" )->wield();  //长剑
    carry_object( CLOTH_DIR + "mancloth2" )->wear();    //高级服装
    add_money( "coin", 500 + random( 1001 ) );          //五百至一千五百文铜钱
}
