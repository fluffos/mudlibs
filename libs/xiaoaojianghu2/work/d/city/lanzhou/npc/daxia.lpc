#include <ansi.h>
inherit NPC;
string ask_about_help();
void create()
{
    seteuid(getuid());
    set_name("大侠", ({"da xia","daxia"}));
set( "long", @LONG
    果然是大侠，他看起来气派不凡。然而此时的他一脸严肃，不只是何缘故。
LONG
    );
        set( "title", HIR"江湖豪杰"NOR );
        set( "nickname", CYN"侠义的化身"NOR );
    set("rank_info/respect", "大侠");
    set("gender", "男性");
    set("attitude", "friendly");
    set("age", 45);
    set("str", 30);
    set("int", 32);
    set("con", 30);
    set("spi", 23);
    set("per", 32);
    set("justice",1000);
    set("env/attack",60);
    set("max_kee", 4000);
    set("max_gin",1000);
    set("max_sen",1000);
    set("no_get_from",1);
    set("max_force", 5000);
    set("force", 10000);
    set("force_factor", 500);

    set("combat_exp", 20000000);
    set("social_exp", 240000);
    set("class_score", 400000);
    set("positive_score",120000);
    set_wugong("lingbo-weibu",150,150,1);          
    set_wugong("xiangsi-dao",150,150,1);   
    set_wugong("wuxing-quan",150,150,1); 
//    set_wugong("sanhua-juding",160,160,1); 
    set_xiuwei_by_type("unarmed",25001);
    set_xiuwei_by_type("blade",25001);
    set_xiuwei_by_type("dodge",25001);
    set_xiuwei_by_type("zonggang",8701);
	set("chat_chance_combat", 80);      
        set("chat_msg_combat", ({
        (: SKILL_D("xiangsi-dao")->perform_action(this_object(), "ganchang-cunduan") :),
           }) );      
    set( "chat_chance", 6 );
    set( "chat_msg", ({
        GRN "大侠叹了一声气：”唉，不知我女儿现在何处？”\n" NOR, 
        YEL "大侠又叹了一声气：”唉,不知何时才能等到一个可以打败我的人！”\n" NOR,
        CYN "大侠不无感慨地说道：”我这件皮氅，就是三年前在沙漠中捡到的，当时差点丧命! ”\n"NOR,
    }) );
//        set("chat_chance_combat", 20);      
//        set("chat_msg_combat", ({
//        (: SKILL_D("yunv-jianfa")->perform_action(this_object(), "tiannv-sanhua") :),
 //          }) );   
    set("inquiry",([
        "武功" : "我靠，贼嚣张，敢来比活比活么？",
        "女儿" : "我女儿叫陆丽仙，十年之前失散了，不知现在何处？",
        "help" :   (: ask_about_help :),
        "陆丽仙": "孩子，你是说的扬州的陆丽仙？可惜她不是我的女儿，我的女儿武艺高强，怎么会去做舞女呢？",
    ]) );

    setup();
    
    carry_object( "/d/place/desert/obj/pichang" )->wear();
    carry_object( "/d/zuzhi/yipin_tang/xuanwu_tang/npc/obj/xiangsidao" )->wield();
    carry_object( "/d/menpai/kunlun/npc/obj/diaoqiu" )->wear();
    add_money( "gold", 10 ); 
}

void init()
{
    object ppl;
    ::init();

    if ( !userp( ppl = this_player() ) 
        || !can_act() ) 
        return;
    remove_call_out( "get_out" );
    call_out( "get_out", 0, ppl );
    remove_call_out( "Greeting" );
    call_out( "Greeting", 1, ppl );
	add_action("do_update","update"); 
        add_action("do_perform","perform"); 
    
}
void Greeting( object ppl )
{       
    object npc = this_object();
    npc->set("force",5000);
    if(npc->query("eff_kee")<2000)
    {npc->set("eff_kee", npc->query("eff_kee")+random(2000));
     npc->set("kee", npc->query("eff_kee"));    
     message_vision( HIR "$N从怀里摸出一根人参，咬了几口。\n" NOR, npc );}
     if ( random(10)>7)
     ppl->apply_condition("ganmao", 10);

}
int get_out(object me)
{
    object *inv,env;
    int i;      
    env = environment(me);       
    if( !env ) return 1;
    inv = all_inventory(environment(me)); 
    if ( !sizeof(inv) ) return 1;   
    for( i = 0; i < sizeof( inv ); i++ )
    {  if( userp(inv[i])&&(inv[i]->is_duilianing()||inv[i]->is_bihuaing()) )
      {    message_vision( WHT"大侠很不客气地挥了挥衣袖，$N只觉一阵强大的气团袭来，\n[嘭]的一声被撞出老远。\n"NOR, inv[i] );
           if(inv[i]->query("family/family_name")!="峨嵋派")
           inv[i]->set("kee",inv[i]->query("kee")/2);	
           inv[i]->move("/d/city/lanzhou/majiu");
      	}    	
}
}
int do_update(string arg)
{
	
return 1;}
int do_perform(string arg)
{
    message_vision(HIR"$N只觉得四周激荡着大侠的浩然真气，威力发挥不出来。\n"NOR, this_player() );

return 1;}

int accept_fight( object ppl )
{

    if (random(2)==1)
    {ppl->apply_condition("ganmao", 10);
    message_vision(HIR"$N感觉不太好，好像也感冒了。\n"NOR, ppl );
        }
    if (ppl->query("combat_exp")<5000000)
    {
    
    message_vision(HIR"大侠看了$N一眼，突地皱了皱眉头。对$N说道：“你还是回去练几年再来吧。”\n"NOR, ppl );
    return 0;
    
    }
    else
     message_vision( RED"只见大侠身形未动,$N已觉胸中一阵气闷。\n"NOR,ppl );
 //   command( "fight "+ppl->query("id") );
    return 1;

}

int accept_bihua( object ppl )
{
    return accept_fight( ppl );
}

int refuse_killing( object ppl )            //被杀时的反应
{
   
    if (ppl->query("combat_exp")<500000)
    {
    message_vision( HIG "大侠对$N哼道：“你这点本事，还是不要在江湖上混的好。“\n" NOR+
                    HIY "大侠左手潇洒的挥舞了一圈，只见$N像只风筝一样飞起老高。\n"NOR+
                    HIC "满城百姓都仰望天空，对着这个不明飞行物指指点点。\n"NOR+
                    HIM "其中一个小伙子说道：“肯定又是哪个不自量力的家伙想谋害大侠了。“\n" NOR ,ppl);
    command( "rumor "+ppl->query("name")+"掉到兰州枯井里了。");  
    ppl->move("/d/city/lanzhou/yipin_tang/jing");
    return 1;
    }
    else
    {object npc = this_object();
    npc->set("force", 5000);
    command( "guard cancel");  
    command( "chat " + ppl->name() + "心术不正,各位一定要小心！" );
    message_vision( "$N看了$n一眼，冷笑道：“居然有你这么不知天高地厚的狂妄之"
        "徒，哼哼，待大侠我今天好好收拾你！！\n", npc, ppl );   
     if(random(5)>=3&&npc->query("eff_kee")<1000)
    {npc->set("eff_kee", npc->query("eff_kee")+random(2000));
     message_vision( HIR "$N从怀里摸出一根人参，咬了几口。\n" NOR, npc );}   
        return 0;}
}
string ask_about_help()
{
    object ppl = this_player();
    if (ppl->query("combat_exp")<5000000)
    {
    command( "guard " + ppl->query( "id" )); 
    return "此乃武林中人份内之事。你就站在这里，看谁敢来杀你！";
     }
    else
    {
    command( "?" ); 
    return 0;
    }
}

void die()
{
    command( "rumor " + HIR"大侠被人害死了！"NOR );
    message_vision(CYN "$N惨然一笑，对天长叹道：“用这种卑鄙手段打败我，我死不瞑目啊...\n" NOR
                    CYN "我本还打算将女儿嫁给能打败我的人，岂料如此，唉...”\n" NOR
                    CYN "大侠大笑三声，倒在地上....\n" NOR, this_object() );
    if (random(3))
    destruct(this_object());
    else
    ::die();
   
}   
