inherit NPC;
void create()
{
        set_name("旅客", ({ "lu ke","ke"}) );
       set("combat_exp", 500);
        set_jibie("unarmed",15);
        set_lingwu("unarmed",10);
        enable_skill("unarmed");
        set("chat_chance", 15);
        set("chat_msg", ({
             (: random_move :)
        }) );
        setup();
        if(random(3) == 1){
        carry_object(__DIR__"obj/cloth1")->wear();
        }
        else{ carry_object(__DIR__"obj/cloth4")->wear();}
        if(random(5) == 1){
        carry_object("/clone/money/silver");}
}
