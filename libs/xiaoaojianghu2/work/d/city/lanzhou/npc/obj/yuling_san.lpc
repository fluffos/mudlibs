//  玉灵散：兰州解谜用  /d/city/lanzhou/npc/obj/yuling_san.c
//  By lin
//  Changed by lala, 1998-03-16

inherit ITEM;

void create()
{
    set_name( "玉灵散", ({ "yuling san", "yulingsan", "san" }) );
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "unit", "付" );
        set( "long", "这是一种能起死回生的伤药。\n" );
        set( "value", 1000 );               //价格：白银一两。
    }

    setup();
}

void init()
{
    add_action( "do_drink", "tun" );        //吞咽药物的动作函数。
}

int do_drink()
{
    object ppl = this_player();
    message_vision( "$N将玉灵散放入口中，随即盘坐在地……\n", ppl );
    ppl->disable_player( "<打坐中>" );
    remove_call_out( "effect" );
    call_out( "effect", 5, ppl );
    return 1;
}

int effect( object ppl )                    //药效发生函数。
{
    ppl->set( "eff_kee", ppl->query("max_kee") );
    ppl->set( "kee", ppl->query("max_kee") );
    ppl->set( "eff_gin", ppl->query("max_gin") );
    ppl->set( "gin", ppl->query("max_gin") );
    ppl->set( "eff_sen", ppl->query("max_sen") );
    ppl->set( "sen", ppl->query("max_sen") );
    message_vision( "$N站了起来。\n", ppl );
    tell_object( ppl, "你觉得精神焕发～\n" );
    ppl->enable_player();
    destruct(this_object());
    return 1;
}
