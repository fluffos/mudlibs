#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("粉红衫子", ({ "pink cloth", "cloth" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这件粉红色的绸衫上面绣著几只黄鹊，闻起来还有一股淡香。\n");
                set("unit", "件");
                 set("value",200);
                set("material", "cloth");
                set("armor_prop/armor", 1);
                set("armor_prop/personality", 3);
                set("female_only", 1);
        }
        setup();
}
