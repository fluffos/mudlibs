#include <armor.h>
inherit CLOTH;
void create() {
  set_name("棉布衣衫", ({ "cloth" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件朴素的女式布衣\n");
    set("unit", "件");

    set("armor_prop/armor", 1);
    set("material", "cloth");


    set("female_only", 1);
  }
  setup();
}
