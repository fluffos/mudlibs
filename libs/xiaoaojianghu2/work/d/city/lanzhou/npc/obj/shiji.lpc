//  未修补过的史记：解谜之用    /d/city/lanzhou/npc/shiji.c

inherit ITEM;

void create()
{
    set_name( "史记", ({ "shi ji", "shiji", "book" }) );
    set_weight( 200 );                      //四市两；    
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "unit", "卷" );
        set( "long", "一本很古旧的线装书，兰皮上写着两个篆字“史记”，里面的\n"
            + "内容很多都已经模糊不清。\n");
        set( "material", "paper" );         //质地：纸（无价值）
    }
}

void init()
{
    add_action( "do_read", "study" );       //读书的动作函数。 
}

int do_read( string arg )                   //读书的动作函数。 
{                                           //arg：书名。
    if ( id( arg ) )
    {
        write( "这本书太破旧了，现在没法读。\n" );
        return 1;
    }
}
