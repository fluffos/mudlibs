//short blade in lanzhou; edit by lin on March 3,  97
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
//inherit F_SAVE;
//inherit F_AUTOLOAD;
void create()
{
	set_name(HIY "短刀" NOR, ({ "duan dao","blade"}) );
	set_weight(1500);
        set("long","一把精光闪闪，一尺多长的短刀，刃闪青光，背显雕纹；看起来似乎是\n"
                   "一对鸳鸯刀中的一把。\n");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value",2000);
		set("material", "steel");
	}
	init_blade(30);
	set("wield_msg", "$N「唰」的一声抽出一把$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n插入刀鞘。\n");
	setup();
}
