//  阔少：闲人  /d/city/lanzhou/npc/kuoshao.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-26

inherit NPC;

void create()
{
    set_name( "阔少", ({ "kuo shao", "kuoshao", "shao", "childe" }) );
    set( "gender", "男性" );                //性别：男
    set( "age", 23 );                       //年龄：23
    set( "per", 24 );                       //容貌：24
    set( "long", @LONG
    一位衣着华丽的阔少爷，不知是那个豪门的子弟。
LONG
    );

    set_wugong( "unarmed",       20,     20,    1 );    //基本拳法：    一级

    set_wugong( "qinggong",      20,     20,    1 );    //基本轻功：    一级

    set( "talk_msg", ({
        "“兰州城真是个穷地方，只有这客栈还不错。”",
    }) );

    setup();

    carry_object( CLOTH_DIR + "mancloth2" )->wear();    //高级服装
}

int accept_fight( object ppl )
{
    command( "say “"+ RANK_D->query_rude( ppl ) 
        + ",你不怕王法吗？来人呀！”\n" );
    return 0;
}
