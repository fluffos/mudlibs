//  金湘玉：龙门客栈老板娘，有秘密  /d/city/lanzhou/npc/jin_xiangyu.c
//  等级：
//  【丁等】大门派的三级师傅、中等门派的二级师傅、小门派的一级师傅
//  ★★★☆
//  〖一级〗三级修为（  ９０１－１１００）四级武功（  ８０－１１０）
//          经验（    ２５万－    ５０万）声望（    ２５００－    ５０００）
//          内力（  １２００－  １８００）体能、生命（  ５００－    ７５０）
//  By Lin
//  Changed Lala, 1998-03-25

#define LANZHOU_DIR "/d/city/lanzhou/"

#include <ansi.h>

inherit NPC;

string AskMe();
int query_answer( object ppl );

void create()
{
    set_name( MAG"金湘玉"NOR, 
        ({ "jin xiangyu", "jin", "xiangyu", "jinxiangyu", "boss" }) );
    set( "title", MAG"龙门客栈老板娘"NOR );
    set( "nickname", RED"桃花夫人"NOR );
    set( "gender", "女性" );                //性别：女
    set( "age", 28 );                       //年龄：28
    set( "per", 25 );                       //容貌：25
    set( "int", 30 );
    set( "bellicosity", 500 );              //杀气：500
    set( "negative_score", 510 );         
    set( "attitude", "friendly" );          //态度：友善
    set( "long", @LONG
    金湘玉是龙门客栈的老板娘。她一身披红挂绿，行动招摇，言语风骚。虽然
是将个客栈经营得蒸蒸日上，却也免不了招来许多背地里的闲言碎语。
LONG
    );

    set_wugong( "blade",        100,    100,    0 );    //横刀六式：    一级
    set_wugong( "liuhe-dao",    100,    100,    0 );    //六合刀法：    二级
    set_wugong( "yuanyang-dao",  100,     100,    1 );    //鸳鸯刀法：    四级

    set_wugong( "unarmed",      100,    100,    0 );    //基本拳法：    一级
    set_wugong( "taizu-quan",   100,    100,    0 );    //太祖长拳：    二级
    set_wugong( "yuanyang-tui", 100,    100,    1 );    //鸳鸯连环腿：  三级

    set_wugong( "qinggong",     100,    100,    0 );    //基本轻功：    一级
    set_wugong( "feiyan-zoubi", 100,    100,    1 );    //飞檐走壁之术：二级
    set_wugong( "feiyan-gong",  100,    100,    1 );    //飞燕功：      三级

    set_xiuwei_by_type( "blade",   2050 );  //刀法修为：    四级
    set_xiuwei_by_type( "unarmed",  1900 );  //拳脚修为：    三级
    set_xiuwei_by_type( "dodge",    1901 );  //轻功修为：    三级
    set_xiuwei_by_type( "zonggang", 3201 );  //总纲修为：    一级

    set( "max_force",   2500 );             //内力：    1500
    set( "force",       2500 );
    set( "force_factor",  100 );             //加力：    30(2%)

    set_hp( "kee",      575 );              //生命、体能：  575
    set_hp( "sen",      575 );

    set( "combat_exp",  250000 );           //战斗经验：25万
    set( "social_exp",  25000 );            //江湖阅历：25000

    set( "inquiry", ([
        "武功"      :   (: AskMe :),
        "skill"     :   (: AskMe :),
        "skills"    :   (: AskMe :),
        "wugong"    :   (: AskMe :),
    ]) );

    setup();

    carry_object( WRISTS_DIR + "yu_zhuozi" )->wear();   //玉镯子
    carry_object( HEAD_DIR + "jin_zanzi" )->wear();     //金簪子
    carry_object( CLOTH_DIR + "xiaoao" )->wear();       //大红对襟团凤镶边小袄
    carry_object( BOOTS_DIR + "xiuhua_xie2" )->wear();  //葱绿绣花鞋
    carry_object( __DIR__ "obj/yuanyang-dao" );
}

void init()
{
    object ppl;

    ::init();

    if ( userp( ppl = this_player() ) 
        && can_act() ) 
    {
        remove_call_out( "Greeting" );
        call_out( "Greeting", 1, ppl );
    }
}

void Greeting( object ppl )
{
    object ye, there;
    object npc = this_object();
    object here = environment();

    if ( !ppl 
        || environment( ppl ) != here ) 
        return;

    if ( here != find_object( LANZHOU_DIR + "yazuo" )   //只有在雅座和柴堆才有
        && here != find_object( LANZHOU_DIR + "chaidui" ) )     //戏看
        return;

    if ( here == find_object( LANZHOU_DIR + "yazuo" ) ) //这是在雅座上的反应。
    {
        if ( present( "duan dao", ppl)      //如果来人有短刀而且没有发现秘密
            && !ppl->query( "marks/lin/兰州秘密A" ) )
        {
            object blade = present( "duan dao", this_object() );
            message_vision( "$N突然冲着$n喝道：“你的短刀是从哪儿来的？！”\n"
                , npc, ppl);
            if (blade)
                blade->wield();
            //else
            //carry_object( __DIR__"obj/yuanyang-dao" )->wield(); //装备鸳鸯刀
            //刀的BUG: 多次可以卖钱哦
            kill_ob( ppl );
            ppl->fight_ob( npc );
            return;
        }
        if ( ppl->query( "marks_lin/kill_ye_maozi" ) )  //来者曾经为了谋求破带
                                                        //鱼施舍的二十两金子，
                                                        //狠心将夜猫子交给了官
                                                        //府
        {
            message_vision( "$N一见到$n，突然象发疯了一样地冲了上来！\n", 
                npc, ppl );
            carry_object( __DIR__"obj/yuanyang-dao" )->wield(); //装备鸳鸯刀
            set( "env/attack", 100 );       //全力以赴
            kill_ob( ppl );
            ppl->fight_ob( npc );
            return;
        }
        if ( !ppl->query( "marks/lin/兰州秘密A" ) )     //来人和秘密无关
        {
            if ( ppl->query( "gender" ) == "男性"         //成年男子
                && ppl->query( "age" ) > 17 )
                message_vision( "$N笑眯眯地迎着$n道：“哎呦呦～这位大官人，\n"
                    + "小店有您捧场真是福大运大呀！您请坐！” \n", npc, ppl );
            else                                        //其他人
                message_vision( "$N看了$n一眼，又去招呼别的客人去了。\n", 
                    npc, ppl );
        }
        //故事：在搭救了金湘玉及其爱人夜猫子后。过了三个月，有一天，你正象
        //这些日子以来一贯的那样来到雅座上(:P)向金湘玉请教武功，可是......
        //戏的第二部分
        if ( ( ppl->query( "marks/lin/兰州秘密A" ) != 2 ) //没救过夜猫子  
            || !npc->can_act()              //金湘玉不能动
            || ppl->query( "mud_age" )    //不到三个月以上
                - ppl->query( "marks/lin/兰州秘密A开始时间" ) < 21600 )
                return;
/*        if ( ( ppl->query( "mud_age" )  //如果在六个月以上，时间太长了。
            - ppl->query( "marks/lin/兰州秘密A开始时间" ) ) > 43200 ) 
        {
            //又不能继续向金学了，这条线索就此中断，以后你不可能再与金发生
            //什么关系啦，呵呵——Lin（狠毒的带鱼）
            ppl->set( "marks/lin/兰州秘密A", -1 );
            message_vision( "$N看了$n一眼，又转过了头去。\n", 
                npc, ppl);
            tell_object( ppl, "好象发生了什么你不清楚的事情了，嗯，是长时间没"
                + "来的缘故吧。\n" );
            return;
        }
*/
        ppl->disable_command( "verb", "不想知道后面将发生什么？\n" );
        message_vision( "$N看到$n上来，便四面看了一看，装作很随便的样子走到$n"
            + "旁边。\n", npc, ppl );
        command( "whisper " + ppl->query( "id" ) + " 你听了可别着急，我有点事情"
            + "要告诉你。" );
        command( "whisper " + ppl->query( "id" ) + " 你知道我有个师哥也在这城里"
            + "么？" );
        tell_object( ppl, name() + CYN"边留意着四周的人，边对你耳语道：“\n" 
            + @TEXT
     我这个师兄，其实就在龙门镖局中干事，他姓汤，你们可能见过的。
     他从小和我与业师学习武功，只是他为人很是奸猾，我一直就看不  
     他那样的人，所以很是讨厌他，师傅也不喜欢他，连本门精华的武  
     功也不肯教给他。为此他反说是我挑拨了他和师傅的关系。从此就  
     恨上了我。
TEXT
            NOR );
        call_out( "Story1", 2, ppl );
        return;
    }
    //身在柴堆，与夜锚子在一起……戏的第一部分：演出开始了
    if ( !npc->can_act()                    //如果金湘玉不能动
        || ppl->query( "marks/lin/兰州秘密A" )          //如果已经有了第一步  
        || ppl->query_temp( "marks/lin/兰州秘密A发现" ) )   //如果已经发现了
        return;

    if ( !ye = present( "ye maozi", here ) )//没有夜猫子在场
    {
        message_vision( "$N一见到$n钻进来，登时尴尬地走了出去。\n",
            npc, ppl );
        if ( !there = find_object( LANZHOU_DIR + "yazuo" ) )
            there = load_object( LANZHOU_DIR + "yazuo" );
        if ( !present( "jin xiangyu", there ) )         //如果雅座上没有
        {
            npc->move( there );             //挪过去。
            tell_room( there, name() + "悄悄地从楼下上来。\n" );
            return;
        }
        destruct( npc );                    //就地销毁。
        return;
    } 
    //金湘玉看到有人发现了自己的心上人--躲在柴堆中养伤的大盗夜猫子       
    message_vision( "$N见到$n进来，大吃一惊，飞快地抽出一把亮晃晃的短刀握在手"
        + "中。\n" ,npc, ppl );
    if ( !npc->query_temp( "weapon" ) )      //如果没拿刀
    {
        new( __DIR__"obj/yuanyang-dao" )->move( npc );
        command( "wield blade" );
    }
    command( "say “你怎么知道这里？你是不是官府派来的？！？老娘这就和你拼了"
        "！！”" );
    tell_object( ppl, RED"看来" + name() + RED"想杀死你！！！\n"NOR );
    if ( !living( ye )         //这时如果夜猫子无力劝阻……
        || random(100) > 30
        || sizeof( all_inventory( here ) ) > 3 
        || ppl->query( "kar" ) < 20 )
    {
        npc->kill_ob( ppl );
        ppl->fight_ob( npc );
        if ( living( ye ) )
            message_vision( "$N呻吟了一声，似乎要出手阻止，却是半点力气也没有"
                + "。\n", ye );
        return;
    }
    //恰好夜猫子担心湘玉受到牵连，而出手阻拦
    ppl->disable_command( "verb", "不想看看他们想对你作什么？" );
    message_vision( "$N说：“不要！！湘玉，你冷静一下！！”\n", ye );
    message_vision( "$N挣扎着想站起来。\n", ye );
    remove_call_out( "SayStop" );
    call_out( "SayStop", 2, ye, ppl, 1 );
}

void SayStop( object ye, object ppl, int step )
{
    switch( step )
    {
        case 1  :
            command( "unwield blade" );
            message_vision( "$N喘着气说：“也许这个人是咱们的最后希望了……”"
                "\n", ye );
            remove_call_out( "SayStop" );
            call_out( "SayStop", 3, ye, ppl, 2 );
            break;
        case 2  :            
            command( "say “你是说……”" );
            message_vision( "$N点了点头。\n", ye ); 
            call_out( "GiveQuest", 5, ppl );
            break;
    }
}

void Story1( object ppl )
{
    object tmp;

    tell_object( ppl, CYN @TEXT
    后来他学不到师傅的真传，就一气之下下山来到兰州当镖师。不久
    我也来到了这里，靠着秦大官人的本钱帮忙办起了这个客栈。可是
    他心里总是存着报复我的意思。倒霉的是这回咱们救夜猫子的事，
    也不知道他是从哪儿打听到的。我看事情不太妙了，你还是快快离
    开吧。虽说你帮过我的大忙，不过老娘向来一人做事一人当，不要
    旁人来垫背。
TEXT
    NOR );
    tell_object( ppl, CYN"    这是五十两银子，先给你作路费，尽快离开城里，有"
        + "什么事以后再说。”\n"NOR );
    command( "sigh" );
    ppl->set( "marks/lin/兰州秘密A", 3 );   //收了银子
    ppl->enable_path();
    tmp = new( MONEY_DIR + "silver" );
    tmp->set_amount( 50 );
    tmp->move( ppl );
}

int valid_teach( object ppl, string skill )
{
    if ( !query_jibie( skill ) )
        return 0;

    if ( !ppl->query( "marks/lin/兰州秘密A" ) )         //没破秘密的不教
        return ::valid_teach( ppl, skill );

    if ( ppl->query( "marks/lin/兰州秘密A" ) == 1 )       //救过夜猫子的可以教
        return query_answer( ppl );

    if ( ppl->query( "marks/lin/兰州秘密A" ) ==-1  )
        return 0;
    
    if ( ppl->query( "marks/lin/兰州秘密A" ) != 3  )    //如果拿了银子的就不教
        return 1;
    
    write( name() + 
        "瞪了你一眼，着急地小声说：“怎么还不走？迟了就来不及了！！\n" ); 
    return 0;
}

string AskMe()
{
    object ppl = this_player();

    if ( valid_teach( ppl, "taizu-quan" ) )
        return @TEXT
你可以学：
    横刀六式     〖blade〗     
    飞燕功       〖feiyan-gong〗  
    飞檐走壁之术 〖feiyan-zoubi〗   
    六合刀法     〖liuhe-dao〗   
    基本轻功     〖qinggong〗   
    太祖长拳     〖taizu-quan〗    
    基本拳法     〖unarmed〗    
    鸳鸯刀法     〖yuanyang-dao〗   
    鸳鸯腿       〖yuanyang-tui〗  
TEXT
    ;
    return "我不知道什么武功的事，阁下请便吧。";
}

int query_answer( object ppl )
{
    switch( ppl->query( "marks/lin/兰州秘密A" ) )
    {
        case 0  :
            return 0;
        case 1  :                           //救过人，可以教功夫
            command( "whisper " + ppl->query( "id" ) 
                + CYN" “刚才的事多亏你啦！要不是你正巧撞进来，真不知道" 
                + "会出什么事咧！”"NOR );
            command( "whisper " + ppl->query( "id" ) + CYN" “我看你也是个学武"
                + "的，正好，没有别的可以帮你，要是有什么不懂的，就问我吧。"
                + NOR );
            message_vision( "$N用感激的眼光看了看$n，很快就转过头去招呼顾客了"
                + "。\n", this_object(), ppl );

            ppl->set( "marks/lin/兰州秘密A" , 2 );          //作秘密开始的标记
            ppl->set( "marks/lin/兰州秘密A开始时间", ppl->query( "mud_age" ) );
                                            //开始计时
            return 1;
        default :
            command( "xixi " + ppl->query( "id" ) );
            command( "whisper " + ppl->query( "id" ) 
                + " “我不是说了嘛？可不要随便乱说呦！”" NOR );
            return 1;
    }
}

int GiveQuest( object ppl )
{
    object there, npc = this_object();

    command( "think" );
    command( "ok" );
    message_vision( "$N转过头去，匆匆写了一张纸条，塞给$n。\n", npc, ppl );
    message_vision( @TEXT 
$N说：“ 
这是我们两人的最后希望了。外面官府看的紧，这里不少人知道我和
我和天翔的关系，他一出事，门外就开始有不少捕快查来查去。我一
直想将消息带给王太医，就是出不得门。阁下如果愿意帮助，不妨就
作点好事吧，小女子一辈子感激你的大恩大德。你快把这纸条交给泰
仁堂的王太医，他知道该如何办。我还要出去照顾客人，免得大家起
疑，你快去快回！！”
TEXT
    , npc );
    ppl->set_temp( "marks/lin/兰州秘密A发现", 1 );      //开始接触秘密了
    new( __DIR__"obj/zhitiao" )->move( ppl );
    message_vision( "$N匆匆地拨开柴草，小心地看了看外面，才走了出去。\n", 
    npc );
    if ( !there = find_object( LANZHOU_DIR + "yazuo" ) )
        there = load_object( LANZHOU_DIR + "yazuo" );
    if ( !present( "jin xiangyu", there ) )
    {
        npc->move( there );
        tell_room( there, name() + "悄悄地从楼下上来。\n" );
    }
    else
        destruct( npc );
    ppl->enable_path();
    return 1;
}


int refuse_killing( object o )
{
    object blade = present("duan dao",this_object());
    if ( blade )
        blade->wield();
    return 0;
}
