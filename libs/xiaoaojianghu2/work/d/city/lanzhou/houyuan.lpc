//  龙门客栈后院    /d/city/lanzhou/houyuan.c
//  By lin
//  Changed by Lala, 1998-03-12

inherit ROOM;

void create() {
  set("short", "后院");
  set("long", @LONG
后院堆满了杂物。南头有几堆柴禾，堆得有一人高，西墙根下几块大石头，
旁边放着一把斧子；地下几堆碎木块，一把鸡毛边扔着一柄亮晃晃的菜刀，刀上
满是血迹。北边是厨房，一股油呛味从里面冒出来。
LONG
  );
  set("outdoors", "lanzhou");
  set("item_desc", ([
    "shuzhi": "一大堆树枝堆在南墙前，足有一人高。\n",
    "chai": "一大堆树枝堆在南墙前，足有一人高。\n",
    "柴": "一大堆树枝堆在南墙前，足有一人高。\n",
    "south": "一大堆树枝堆在南墙前，足有一人高。\n",
    "柴堆": "一大堆树枝堆在南墙前，足有一人高。\n",
    "chai dui": "一大堆树枝堆在南墙前，足有一人高。\n",
    "chaidui": "一大堆树枝堆在南墙前，足有一人高。\n",
  ]));
  set("exits", ([
    "east": __DIR__ "changyuan",  //龙门客栈场院
  ]));

  setup();
}

void init() {
  add_action("do_che", "zuan");         //一个钻的动作函数。
}

int do_che(string arg)                    //一个钻的动作函数。
{                                           //arg：动作目标。
  object ppl = this_player();
  if (arg == "chaidui"
    || arg == "chai dui"
    || arg == "柴堆") {
    message_vision("$N拨开散在表面的树枝，钻进柴堆里。\n", ppl);
    ppl->move(__DIR__ "chaidui");
    return 1;
  }
  write("你要钻什么？\n");
  return 1;
}
