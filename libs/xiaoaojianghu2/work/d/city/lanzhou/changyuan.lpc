//  龙门客栈场院    /d/city/lanzhou/changyuan.c
//  By lin
//  Changed by Lala, 1998-03-11

inherit ROOM;

void create()
{
    set( "short", "场院" );
    set( "long", @LONG
这里是客店的大院，南北各有几间客房，可供租住。因为龙门镖局的势力很
大，很少有人敢在这里捣乱，因此住店很安全。朝南面的客房前悬着一根晾衣服
用的绳子。西南角上有一口水井。
    西边是后院。
LONG
    );
    set( "outdoors", "lanzhou" );
    set( "resource/water", 1 );             //有补充水的地点
    set( "fillplace", "水井" );             //补充地点：水井
    set( "exits", ([
        "east"      :   __DIR__"kezhan",    //龙门客栈
        "west"      :   __DIR__"houyuan",   //龙门客栈后院
        "north"     :   __DIR__"kefang1",   //客栈客房
        "south"     :   __DIR__"kefang2",   //客栈客房
        "southeast" :   __DIR__"kefang3",   //客栈客房
    ]) );
    
    setup();
}
