//  风雷刀：龙门镖局镖师装备。  /d/city/lanzhou/npc/obj/fenglei-dao.c

#include <weapon.h>
#include <armor.h>
#include <ansi.h>

inherit BLADE;

void create()
{
    set_name( "风雷刀", ({ "fenglei dao", "fenglei-dao", "dao", "blade"}) );
    set_weight( 6000 );                     //十二市斤；
    set( "long", "一把明晃晃的钢刀，拿在手里沉甸甸的，一看就知道是好刀。\n" );
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "unit", "把" );
        set("value", 15000);
                                            //+(150*6)钢价格=4400总价格；
        set( "material", "steel" );         //质地：钢（单价１５０文／千克）
    }
    init_blade( 35 );                       //攻击力：+35；
    set( "wield_msg", "$N「唰」的一声抽出一把明晃晃的$n握在手中。\n" );
    set( "unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");

    setup();
}
