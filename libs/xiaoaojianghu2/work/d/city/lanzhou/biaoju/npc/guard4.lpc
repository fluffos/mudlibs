//  成镖头：龙门镖局镖师    /d/city/lanzhou/npc/guard4.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
//  ★☆
//  〖二级〗一级修为（  １５１－  ３００）二级武功（  ４０－  ８０）
//          经验（１５０００－３００００）声望（      １５０－       ３００）
//          内力（  ２００－      ３００）体能、生命（  ２５０－     ２７５）
//  By Lin
//  Changed Lala, 1998-03-25
inherit NPC;

void create()
{
    set_name( "成镖头", 
        ({ "cheng biaotou", "biaotou", "cheng", "chengbiaotou", "guard" }) );
    set( "title", "龙门镖局镖师" );
    create_family( "龙门镖局", 3, "镖头" );       

    set( "gender", "男性" );                //性别：男
    set( "age", 28 );                       //年龄：28
    set( "per", 21 );                       //容貌：21
    set( "str", 23 );                       //臂力：23
    set( "positive_score", 250 );           //正声望：250
    set( "long", @LONG
    成镖头是龙门镖局一个很一般的镖头，不怎么受重视，功夫也比较差。
LONG
    ); 

    set_wugong( "blade",         80,     80,    0 );    //横刀六式：    一级
    set_wugong( "ditang-dao",    60,     60,    1 );    //地趟刀：      二级

    set_wugong( "qinggong",     100,    100,    1 );    //基本轻功：    一级

    set_xiuwei_by_type( "blade",    300 );  //刀法修为：    一级
    set_xiuwei_by_type( "dodge",    150 );  //轻功修为：    一级

    set( "max_force",   240 );              //内力：    240
    set( "force",       240 );
    set( "force_factor", 12 );              //加力：    12(5%)

    set_hp( "kee",      260 );              //生命、体能：    260
    set_hp( "sen",      260 );

    set( "combat_exp",  24000 );            //战斗经验：24000
    set( "social_exp",  2400 );             //江湖阅历：2400

    setup();
      
    carry_object( BLADE_DIR + "blade2" )->wield();      //单刀
    carry_object( CLOTH_DIR + "jinzhuang1" )->wear();   //黑色劲装
}
