//  趟子手：龙门镖局趟子手  /d/city/lanzhou/npc/fighter.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
//  ★
//  〖三级〗一级修为（  １０１－  １５０）一级武功（  ６０－１００）
//          经验（  ７５００－１５０００）声望（        ７５－       １５０）
//          内力（      ０－      ２００）体能、生命（  ２００－     ２５０）
//  By Lin
//  Changed Lala, 1998-03-25
inherit NPC;

void create() {
  set_name(comm_man_name(),
    ({ "tangzi shou", "tangzi shou", "shou", "fighter" }));
  set("title", "龙门镖局 趟子手");
  set("gender", "男性");                //性别：男
  set("age", 28 + random(10));        //年龄：28～37
  set("str", 25);                       //臂力：25
  set("positive_score", 150);           //正声望：150
  set("long", @LONG
    一位正当壮年的黑脸汉子，身上的肌肉一块块凸起来，好不魁梧。
LONG
  );

  set_wugong("unarmed", 100, 100, 1);    //基本拳法：    一级

  set_wugong("blade", 80, 80, 1);    //横刀六式：    一级

  set_wugong("qinggong", 85, 80, 1);    //基本轻功：    一级

  set_xiuwei_by_type("unarmed", 130);  //拳脚修为：    一级
  set_xiuwei_by_type("blade", 80);  //刀法修为：    零级
  set_xiuwei_by_type("dodge", 80);  //轻功修为：    零级

  set("max_force", 160);              //内力：    160
  set("force", 160);

  set_hp("kee", 240);              //生命、体能：  240
  set_hp("sen", 240);

  set("combat_exp", 13000);            //战斗经验：13000

  set("talk_msg", ({
    "“练武之人要能吃苦，吃得了苦才能练成好功夫！”",
    "“咱们总镖头的武功，不是天下第一也差不多。”",
  }));

  setup();

  add_money("coin", random(10));      //十文以内的铜钱。

  carry_object(BLADE_DIR + "blade1")->wield();      //朴刀
  carry_object(CLOTH_DIR + "cloth2")->wear();       //粗布衣
}

int refuse_killing(object ppl)            //被杀时则加力到最大。
{
  set("force_factor", 16);              //加力：    16
  return 0;
}

int accept_bihua(object ppl)              //比划时则不加力。
{
  delete("force_factor");
  return 1;
}
