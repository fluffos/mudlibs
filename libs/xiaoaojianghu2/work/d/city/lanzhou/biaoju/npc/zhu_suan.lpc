#include <ansi.h>
inherit NPC;
void delay_quest(object me, int num);
void fail_quest(object me);

void create() {
  set_name("朱算", ({ "zhu suan", "zhusuan", "zhu", "sir" }));
  set("title", "帐房先生");
  create_family("龙门镖局", 3, "账房");
  set("gender", "男性");                //性别：男
  set("age", 56);                       //年龄：56
  set("attitude", "friendly");          //态度：友善
  set("long", @LONG
    朱算来镖局已有十来年了。他心思敏捷，打得一手好算盘又颇懂经营之道，
这二年不但使镖局财源滚滚，还办起了其他行当的买卖。
LONG
  );

  set("chat_chance", 5);
  set("chat_msg", ({
    "朱算把算盘拨得“哗哗”响，嘴里不住念叨着什么。\n",
    "朱算说道：“什么时候我也能发笔财就好了！\n”",
  }));
  set_wugong("literate", 100, 100);
  setup();
  carry_object(CLOTH_DIR + "cloth5")->wear();       //紫绸长衫
}

void init() {   //  领任务
  ::init();
  add_action("give_quest", "quest");
}
int give_quest() {
  int questnumber;
  object me = this_player();
  object ob = this_object();

  if (me->query("family/family_name") != "龙门镖局") {
    message_vision("$N奇怪的看着$n道：“你何必来开玩笑，快快离开。”\n", ob, me);
    return 1;
  }
  if (time() - me->query_temp("quest") < 30) {
    message_vision("$N不满的对$n说道：“怎么这么猴急啊!”\n", this_object(), me);
    return 1;
  }
  if (me->query("quest")) {
    fail_quest(me);
    return 1;
  }
  me->set_temp("quest", time());
  questnumber = random(26) + 1;
  remove_call_out("give_quest_" + questnumber);
  call_out("give_quest_" + questnumber, 1, me);
  return 1;
}

void give_quest_1(object me) {



  me->set("quest", ([
    "quest": "取" + "无量剑谱",
    "bonus": 5 + random(5),
  ]));
  tell_object(me,
    HIW "朱算沉思了一会说道：“总镖头要研究一下无量剑谱，你这就去找一本来。\n" NOR);
}

