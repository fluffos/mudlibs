int accept_object(object me, object obj) {
  int bonus;
  if (me->query("family/family_name") != "龙门镖局") {
    command("say “你这是什么意思，送我礼物啊？。。。”");
    return 0;
  }
  if (!me->query("quest/bonus") ||
    "取" + obj->name() != me->query("quest/quest")) {
    tell_object(me, "朱算疑惑的看着你说：这个不是我让你取的啊？做事要认真点啊。\n");
    return 0;
  }
  if (me->query("quest/time") && (me->query("quest/time") < time())) {
    delay_quest(me, 0);
  } else {
    bonus = me->query("quest/bonus");
    me->add("class_score/龙门镖局", bonus);
    message_vision(
      "$N高兴的拍了拍$n道：“不错不错，果然办事利落。”\n", this_object(), me);
    printf(HIR "->你对龙门镖局的忠诚度升高 %s 点\n" NOR,
      chinese_number(bonus));
    me->set_marks("last_quest", me->query("quest/quest"));
    me->set_marks("quest_result", "reward");
    me->delete("quest");
  }
  call_out("destruct_mo_object", 1, obj);
  return 1;
}

void destruct_mo_object(object obj) {
  destruct(obj);
}

void delay_quest(object me, int num) {
  object ob = this_object();
  num = random(20);
  message_vision(
    "$N白了$n一眼道：“怎么这样磨蹭，这么久才回来！我真是看错了人。”\n", ob, me);
  tell_object(me, HIW
    "->你对龙门镖局的忠诚度下降了 " + chinese_number(num) + " 点！\n" NOR);
  me->add("class_score/龙门镖局", -num);
  me->set("quest/time", time());
  me->set_marks("last_quest", me->query("quest/quest"));
  me->set_marks("quest_result", "delay");
  me->delete("quest");
}

void fail_quest(object me) {
  delay_quest(me, 10);
  me->set_marks("quest_result", "fail");
}
