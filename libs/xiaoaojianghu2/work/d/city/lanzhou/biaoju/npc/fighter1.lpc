//  趟子手：龙门镖局趟子手  /d/city/lanzhou/npc/fighter1.c

inherit NPC;

void create() {
  set_name(comm_man_name(),
    ({ "tangzi shou", "tangzi shou", "shou", "fighter" }));
  set("title", "龙门镖局 趟子手");
  set("gender", "男性");                //性别：男
  set("age", 18 + random(20));        //年龄：18～47
  set("long", @LONG
    他是镖局中的一名趟子手，因为功夫不够高，所以老是摊不着好差事。
LONG
  );
  set_wugong("unarmed", 40, 40, 1);    //基本拳法：    一级

  set_wugong("qinggong", 30, 30, 1);    //基本轻功：    一级

  set_xiuwei_by_type("unarmed", 40);  //拳脚修为：    零级
  set_xiuwei_by_type("dodge", 40);  //轻功修为：    零级

  set("combat_exp", 6000);             //战斗经验：6000

  set("talk_msg", ({
    "“练武之人要能吃苦，吃得了苦才能练成好功夫！”",
    "“咱们总镖头的武功，不是天下第一也差不多。”",
  }));

  setup();

  carry_object(CLOTH_DIR + "cloth2")->wear();       //粗布衣
}
