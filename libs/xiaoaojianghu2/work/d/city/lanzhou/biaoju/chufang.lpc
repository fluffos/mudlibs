#include <ansi.h>
#include <room.h>
inherit ROOM;



void create()
{
    set("short", "厨房");
    set("long", @LONG
这里是龙门镖局的厨房，总镖头很好客，特地吩咐厨房免费招待各方豪杰。想吃饭的
话，只要说句“恭喜发财”，就会有伙计送上饭菜来。也正因为这一条规矩，很多过
路英雄宁可去龙门客栈花钱吃饭。 
LONG
    );
    set("no_clean_up", 0);
    set("exits", ([
        "north" : __DIR__"xiangfang"
    ]));
    set("objects", ([ 
    __DIR__"npc/shike" : 2,
    ]));
    setup();
}

void init()
{
    add_action( "do_zuo", "zuo" );
}

int do_zuo()
{
    object me = this_player();
    if( !me->can_act() )
        return notify_fail("你现在正忙着呢！\n");
    else 
    {
        message_vision( "$N一屁股坐了下去，大喊一声：“恭喜发财，上菜！”\n", me );
        message_vision( "一个小伙计给$N送上一些吃的，$N开始吃喝起来。\n", me );
        me->start_busy(5);
        remove_call_out( "eating" );
        call_out( "eating", 7, me );
        return 1;
    }
}

int eating(object me)
{
    message_vision("$N吃饱喝足，站了起来。\n", me);
    me->set("food", (int)me->max_food_capacity());
    me->set("water", (int)me->max_water_capacity());
}

