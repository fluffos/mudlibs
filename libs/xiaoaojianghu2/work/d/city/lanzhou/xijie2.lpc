inherit ROOM;

void create()
{
    set( "short", "西大街" );
    set( "long", @LONG
脚下是青石铺成的路面，整齐干净，不时有行人从身边擦肩而过。北面有一
家布庄，路南是一间书坊，经营市卖的各种传奇小说；再向西走就是城门了。东
面不远处有一个广场，人来人往很是热闹。路边有几个乞丐正在乞讨，一个和尚
念着经文低头走来走去。
LONG
    );
    set( "outdoors", "lanzhou" );
    set( "exits", ([
        "north"     :   __DIR__"buzhuang",  //布庄
        "south"     :   __DIR__"shufang",   //书坊
        "east"      :   __DIR__"xijie1",    //西大街
        "west"      :   __DIR__"ximen",     //西门
    ]) );
    set( "objects", ([
         __DIR__"npc/monk"      :   1,      //和尚 
    ]) ); 

    setup();
}
