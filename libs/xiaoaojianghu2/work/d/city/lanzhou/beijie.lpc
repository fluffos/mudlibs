//  兰州北大街  /d/city/lanzhou/beijie.c
//  By lin
//  Changed by Lala, 1998-03-11

inherit ROOM;

void create() {
  set("short", "北大街");
  set("long", @LONG
宽敞的大街是用青石铺成，不时有马蹄踏过的“多多”声，却不见有尘土扬
起。北面是城门，城墙上旌旗招展，一队队士兵在往返巡逻；街的西面是一家客
栈，榆木店门前挂着块白底的招牌(zhao pai)，挑着一个画着个金黄酒葫芦的幌
子；东边是间相当气派的临街大店铺，红色的大门上左右各写着个“当”字。南
面是一个广场，可以看到广场中央的围栏上拴了好几匹马。
LONG
  );
  set("outdoors", "lanzhou");
  set("item_desc", ([
    "招牌": "招牌上写着“龙门客栈”。\n",
    "zhao pai": "招牌上写着“龙门客栈”。\n",
    "zhaopai": "招牌上写着“龙门客栈”。\n",
    "广场": "一个不大的广场，当中有个拴马的四方木栏。\n",
  ]));
  set("exits", ([
    "north": __DIR__ "beimen",    //兰州北门
    "south": __DIR__ "guangchang",  //中心广场
    "west": __DIR__ "kezhan",    //龙门客栈
    "east": __DIR__ "dangpu",    //兰州当铺
  ]));
  set("objects", ([
    __DIR__ "npc/he_san": 1,      //地痞何三  
  ]));

  setup();
}
