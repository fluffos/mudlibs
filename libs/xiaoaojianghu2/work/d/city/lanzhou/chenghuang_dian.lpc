//  兰州城隍殿  /d/city/lanzhou/chenghuang_dian.c
//  By lin
//  Changed by Lala, 1998-03-12

inherit ROOM;

void create()
{
    set( "short", "城隍殿" );
    set( "long", @LONG
这里供奉的是本城城隍。供桌上放着炉鼎，鼎里满是香灰，还有二十几根香
在燃着，散出浓浓的香烟；供桌后面一尊黑脸大汉的雕像( diao xiang )身穿戎
服手握大刀，威武有神。有人说这位城隍是当年汉武帝手下的飞将军李广，也有
的说就是本朝的名将狄青大将军。殿两厢的木栏后架着十八般兵器；殿后一道小
门通向后院佛寺。殿外是个集市，热闹非凡。
LONG
 );
    set( "item_desc", ( [
        "雕像":         "你盯着神像看了看，只觉得神圣无比，令你不"
                        + "由自主地想跪下去磕头( ke tou )。\n",
        "diao xiang":   "你盯着神像看了看，只觉得神圣无比，令你不"
                        + "由自主地想跪下去磕头( ke tou )。\n",
        "diaoxiang" :   "你盯着神像看了看，只觉得神圣无比，令你不"
                        + "由自主地想跪下去磕头( ke tou )。\n",
    ] ) );
    set( "exits", ( [
        "out"       :   __DIR__"nanjie1",   //兰州南街
        "in"        :   __DIR__"foguang_ge",//佛光阁
    ] ) );
    set( "objects", ( [
        __DIR__"npc/oldwoman"   :   1,
    ] ) );

    setup();
}

void init()
{
      add_action( "do_ketou", "ke" );       //一个磕头的动作函数。
}

int do_ketou( string arg )                  //一个磕头的动作函数。
{                                           //arg：tou（头）。
    object ppl = this_player();
    int my_kee, my_beli;

    if ( !arg                               //如果没有后缀，无效。
        || arg == "" )
        return 0;

    if ( arg != "tou" )                     //如果不是磕头，无效。
        return 0;

    my_kee = ppl->query( "kee" );           //my_kee：玩家的“生命”值。
    if ( my_kee < 5 )                       //如果生命不足５，则晕倒。
    {
        tell_object( ppl, "你一个头磕下去，只觉得头晕眼花，一个趔趄……\n" );
        ppl->unconcious();
        return 1;
    }

    message_vision( "$N虔诚地磕了个头……\n", ppl );

    my_beli = ppl->query( "bellicosity" );  //my_beli：玩家的“杀气”值。

    if ( my_beli > 500 )                    //如果杀气大于１００，
    {
        my_beli = my_beli / 100 + random( 2 );          //杀气下降１％（＋１）。
        ppl->add( "bellicosity", -my_beli*5 );
        ppl->receive_damage( "kee", my_beli*5 );          //生命下降相同值。
        tell_object( ppl, "你觉得心中的恶念在一点点地消除……\n"  );
        return 1;
    }

    if( my_beli <= 0 )                      //如果杀气小于等于０，
    {                                       //则设为０，生命下降１。
        ppl->set( "bellicosity", 0 );
        ppl->receive_damage( "kee", 1 );
        return 1;
    }

    ppl->receive_damage( "kee", 1 );        //如果杀气在０～１００之间，
    ppl->add( "bellicosity", -5 );          //杀气下降１，生命下降１。
    tell_object( ppl, "你觉得心中的恶念在一点点地消除……\n" );
    return 1;
}
