inherit ROOM;

void create() {
  set("short", "井中");
  set("long", @LONG
原来这里是一口井，周围是砖砌的井壁，下面数尺远就是水面，向上看大约离
井口有七八尺远。井壁是向内倾斜的，而且由于多年的阴湿长满了青苔，滑不留手，
真要爬起来恐怕是难于上青天。要是这会儿有人从上面用绳子拉你一下就好了。
LONG
  );
  set("exits", ([
    "in": __DIR__ "andao",         //暗道
    "up": "/d/city/lanzhou/zhaimen",          //深宅大门
  ]));

  setup();
}

int valid_leave(object ppl, string dir)   //怕不上去。
{
  if (dir == "up")
    return notify_fail("井壁又湿又滑，根本爬不上去。\n");
  return ::valid_leave(ppl, dir);
}
