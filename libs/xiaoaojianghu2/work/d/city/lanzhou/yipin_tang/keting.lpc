//  一品堂在兰州的情报站的客厅  /d/city/lanzhou/yipin_tang/keting.c 
//  By Lala, 1998-03-20

inherit DOOR_ROOM;

void create()
{
    set( "short", "深宅客厅" );
    set( "long", @LONG
一间宽敞而又雅致的房间，四周垂挂着许多幔帐，隐隐可见有众多的门户，
不知通向什么地方。客厅的上首正中摆放着一张紫檀木八仙桌。两旁各有一张太
师椅，桌上放着时鲜果品，桌后香炉中点燃的檀香发出阵阵香气。你正在疑惑间，
一名满脸长着络腮胡须的高大汉子走了进来。
LONG
    );
    set( "exits", ([
        "south"     :   "/d/city/lanzhou/zhaimen",      //深宅大门
    ]) );
    set( "objects", ([
        __DIR__"npc/helian_changzai"    :   1,          //赫连长在
    ]) );

    setup();
    create_door( "south", ([                //南面有个锁着的朱漆大门
        "name"              :   "朱漆大门",
        "lock"              :   "一品堂_lock003",
        "status"            :   3,
        "id"                :   ({ "south", "gate" }),
        "other_side_dir"    :   "north",
        ]),
        "north"
    );
}

