#include <room.h>
inherit ROOM;

void create()
{
        set("short","柯府秘室");
        set("long",@LONG
这里是柯府的秘室。实际就是井壁旁边挖的一间小屋子，看起来这里什么也
没有，似乎早已闲置不用了很长时间。地上散乱地放着很多的杂物，屋角有一个
书架.
LONG);
        set("exits",([
        	"up"       :    "/d/city/nanyang/houyuan",
          
        ]));

    setup();
    //place_program(ROOM);

}

void init()
{
    object me = this_player();
    if (me->query("marks/left_funiu")!=1)
    {
        message_vision("你怎么进来的.....死去吧.....\n",me);
        me->die();
    }
   
}
void reset()
{
	string s_obj;
	::reset(); 
	switch(random(10))
	{
	case 0:
	case 1:
	case 2:	
		s_obj = __DIR__"obj/book1";
		break;
	case 3:
		s_obj = __DIR__"obj/book2";
		break;
	case 4:
		s_obj = __DIR__"obj/book3";
		break;	
	case 5:
        case 6:
	case 7:
		s_obj = __DIR__"obj/book4";
		break;							
	default:
		s_obj = __DIR__"obj/book5";
		break;
	}
	set("search_things", ([
		"书架" :  s_obj,
		]) );
}