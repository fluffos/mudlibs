inherit ROOM;
void create()
{
    set("short","厢房");
    set("long",@LONG
一溜厢房共有四间，全是硬山单背，青砖砌就；屋檐下挂着些日杂物事，窗
台下码放着几双千层底黛面布靴。这里是供家丁，佣人门居住的场所；白天，屋
里的人都出去干活去了，屋子里静悄悄的，靠窗是一溜几张木床。
LONG);
    set("exits",([
        "south" : __DIR__"qianyuan",
        "east"  : __DIR__"huilang",
    ]));
    set("sleep_room","伏牛派");
    setup();
    call_other("/clone/board/funiu_b","???");      
}
