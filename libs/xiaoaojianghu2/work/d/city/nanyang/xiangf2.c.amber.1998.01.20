#include <ansi.h>
#include <room.h>
inherit ROOM;
void wakeup(object,object);
void create()
{
    set("short","南厢房");
  set("long",@LONG
这是一间专门供上府求助的江湖侠客们小住的客房。来这里的人，有的是缺
钱，有的是躲仇人；对于这些人，只要没有大恶，伏牛派一律予以热情款待。东
墙下有一张方桌，两把椅子；床头上一张高几，茶具，香炉一一齐备。屋里打扫
得干干净净。
LONG);
  set("exits",([
    "north" : __DIR__"dating",
  ]));
  set("objects",([
        __DIR__"npc/lv" : 1,
  ]));
    set("need_clean","伏牛派");
     create_door("north","木门","south",DOOR_CLOSED);
  setup();
}
void init()
{
        add_action("do_sleep","sleep");
}

int do_sleep()
{
	mapping fam;
	object me;
    me=this_player();
    if( !me->can_act() ) 
        return 0;
	if ( !me->query_temp("lin_marks/暂住"))
             return notify_fail("这里不是让你睡的地方。\n");
	if ( me->query_condition("sleeped"))
	return notify_fail("你可不能整天睡觉呀，该出去活动活动了。\n");

	write("你躺到自己的床上，闭上眼睛，开始睡觉。\n");
	write("不一会儿，你就进入了梦乡。\n");
	me->set_temp("block_msg/all",1);
	message_vision("$N一歪身，倒在床上，不一会便鼾声大作，进入了梦乡。\n",me);

//	environment()->set("no_fight", 1);
//	environment()->add_temp("sleeping_person", 1);

    set("no_fight", 1);
    add_temp("sleeping_person", 1);
	me->set("no_get", 1);	
	me->set("no_get_from", 1);	
	me->apply_condition("sleeped",300);
	me->disable_player("<睡梦中>");
	call_out("wakeup",random(45 - me->query("con")+45), me, environment());
	return 1;
}

void wakeup(object me,object where)
{
	me->set("kee",    me->query("eff_kee"));
	me->set("gin",  me->query("eff_gin"));
	me->add("force", me->query("max_force")/2 - me->query("force")/2 );
	me->enable_player();

	message_vision("$N一觉醒来，精力充沛地活动了一下筋骨。\n",me);
	me->set_temp("block_msg/all", 0);
	write("你一觉醒来，只觉精力充沛。该活动一下了。\n");

	if (!where->query("sleep_room") && !where->query("hotel"))
		where->delete("no_fight");
     
	where->add_temp("sleeping_person", -1);
	me->delete("no_get");	
	me->delete("no_get_from");	
 
}
