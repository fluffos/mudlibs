// liang.c

#include <ansi.h>

inherit __DIR__"funiu";

void create()
{
    set_name("家丁", ({ "jia ding","guard" }) );
    set("gender", "男性" );
    set("title","柯府");
    set("str",30);
    set("age", random(10)+22);
    set_wugong("unarmed",60,60,1);
    create_family("伏牛派",2,"家丁");
    set_xiuwei_by_type("unarmed",50);
    set_wugong("qinggong",60,60,1);
    set_xiuwei_by_type("dodge",60);
    set("no_kill","funiu");

    set("talk_msg",({
        "这里是南阳城",
            "柯府老爷为民除害，大家都感恩待德呀！",
            "伏牛山上有一伙强盗，经常下山为害百姓。",
            "武林上的人物，到了南阳，怎么也得先来拜见我们柯老爷子。",
            "柯老爷善使软鞭，一手百胜鞭法使出来，就算是少林高僧也要佩服三分",                    
    }));

        set("chat_chance_combat", 20);
        set("chat_msg_combat",({
                "家丁喊道：'你干什么？如此无理？！！！'\n",
                "家丁边打边喊：'敢来柯府撒野？反了你的！！！'\n",
        }) );
        set("inquiry", ([
                "伏牛派" : "伏牛派在这里可是大大的有名，全仗着柯老太爷的威风，伏牛山上那群\n"
+"强盗才不敢轻举妄动。",
                "here"   : "这里是柯府，你有事吗？！",
                "name"   : "老子是柯府的大总管，快磕头吧！哈哈哈哈！！",
        ]) );
    set("combat_exp", 2000);

    setup();
    carry_object(__DIR__"obj/luojin")->wear();
    carry_object(__DIR__"obj/cloth1")->wear();
}
