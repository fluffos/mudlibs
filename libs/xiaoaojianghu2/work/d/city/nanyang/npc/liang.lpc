// liang.c

#include <ansi.h>

inherit __DIR__"funiu";

void create()
{
    set_name("梁仲成", ({ "liang zhongcheng","liang" }) );
    set("gender", "男性" );
    set("age", 23);
    set("max_force", 500);
    set("force", 500);
    create_family("伏牛派", 2,  "弟子" );
    set("combat_exp", 7000);
    set("class_score/伏牛派",400);
    set("social_exp", 200);
    set("talk_msg",({
        "北门外的伏牛山风景很好的，要不是有一伙歹徒盘踞在山上，城里的人肯定都会经常\n"
        "到山上去游玩的。\n",
        "几次想象师兄们一样去帮助官府围剿强盗，师傅就是不让，唉！\n",
        "你到过大理么？那里肯定很好玩吧？\n",
    }));
    set_wugong("kuangf-bian",70,70,1);
    set_wugong("taizu-quan",80,80,1);
    set_xiuwei_by_type("whip",300);        
    set_xiuwei_by_type("unarmed",300);
    set_wugong("whip",80,80,1);
    set_wugong("ke-xinfa",50,50,1);
    set_wugong("qinggong",60,60,1);
    set_wugong("xingyun-shenfa",60,60,1);
    set_xiuwei_by_type("dodge",300);
    set("no_kill","funiu");
    setup();
    carry_object(CLOTH_DIR"cloth3")->wear();
    carry_object(__DIR__"obj/whip")->wield();
}

int recognize_apprentice(object me)
{
    if ( !me->query("family/family_name") ||
         me->query("family/family_name") != "伏牛派" )
    {
        return 0;
    }
    return 1;
}
int refuse_killing(object who)
{
    this_object()->set("force_factor",33);
    return 0;
}

