// liang.c

#include <ansi.h>

inherit __DIR__"funiu";

void create()
{
    set_name("弟子", ({ "di zi","zi" }) );
    set("title","伏牛派");
    create_family("伏牛派",2,"弟子"); 
    set("age", random(10) + 18 );
    set_wugong("unarmed",80,80,1);
    set_xiuwei_by_type("unarmed",170);
    set_wugong("whip",80,80,1);
    set_wugong("kuangf-bian",30,30,1);
    set_xiuwei_by_type("whip",80);
    set_wugong("qinggong",80,80,1);
    set_xiuwei_by_type("dodge",170);
    set("no_kill","funiu");
    set("combat_exp", 1000);

    set("talk_msg",({
            "这里是南阳城",
            "柯府老爷为民除害，大家都感恩待德呀！",
            "伏牛山上有一伙强盗，经常下山为害百姓。",
            "要不是咱们跟那帮土匪干了几仗，哼哼。。",
            "武林上的人物，到了南阳，怎么也得先来拜见我们柯老爷子。",
            "柯老爷善使软鞭，一手百胜鞭法使出来，就算是少林高僧也要佩服三分",
            "快快去见过柯老爷吧。",
    }));

        set("chat_chance_combat", 20);
        set("chat_msg_combat",({
                "弟子边打边喊：'敢来柯府撒野？反了你的！！！'\n",
        }) );
        set("inquiry", ([
                "伏牛派" : "伏牛派在这里可是大大的有名，全仗着柯老太爷的威风，
伏牛山上那群\n"
+"强盗才不敢轻举妄动。",
                "here"   : "这里是柯府，你有事吗？！",
        ]) );
    setup();
    carry_object(__DIR__"obj/whip")->wield();
    if( random(2) == 1)
         carry_object(CLOTH_DIR"cloth4")->wear();
    else
         carry_object(CLOTH_DIR"cloth3")->wear();
}
int accept_fight(object me)
{
    if( this_player()->query("family/family_name") != "伏牛派")
            return 0;
    else    return 1;
}
int refuse_killing(object me)
{
    this_object()->set("bellicosity",800);
    return 0;
}

