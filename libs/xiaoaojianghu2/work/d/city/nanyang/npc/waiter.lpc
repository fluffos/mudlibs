// waiter.cr.c
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
void create()
{
        set_name("马老二", ({ "ma 2","ma","waiter"}) );
        set("gender", "男性" );
        set("age", 46);
        set("long",
          "马老二是这间店铺的店主，他身上穿着一件半旧的蓝布短衫，手上沾满了油迹。\n"
        );
        set("combat_exp", 6000);
        set("chat_chance_combat", 5);
        set("chat_msg_combat",({
                "马老二狠狠地说：“臭小子还真不好对付咧！n",
                (: random_move :),
        }) );
        set("inquiry", ([
                "伏牛派" : "伏牛派在这里可是大大的有名，全仗着柯老太爷的威风，伏牛山上那群\n"
+"强盗才不敢轻举妄动。客官要找柯府，出门向北一拐就是了。",
                "here"   : "这里是南阳城，南阳诸葛祠，天下闻名耶！",
                
        ]) );
        set("talk_msg",({
            "这里是南阳城",
            "柯府老爷为民除害，大家都感恩待德呀！",
            "南阳城北接中原，南渡汉水，客官想去哪里呀？",
            "伏牛山上有一伙强盗，经常下山为害百姓。",
            
        }));
        set("attitude", "friendly");
        set("rank_info/respect", "老哥");
        set("rank_info/rude","老王八蛋");
        set("vendor_goods", ([
                "黄酒": __DIR__"obj/hulu",
                "整坛黄酒" : __DIR__"obj/jiutanzi",
                "白面馒头": __DIR__"obj/mantou",
                "馅饼": __DIR__"obj/xianbing",
                "大碗清茶": __DIR__"obj/cha",
        ]) );
        setup();
        carry_object(CLOTH_DIR"cloth6")->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(2) ) {
                case 0:
                        say( "马老二笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，进来歇歇腿吧。\n");
                        break;
                case 1:
                        say( "马老二用油乎乎的毛巾擦了擦桌子，说道：这位" + RANK_D->query_respect(ob)
                                + "，来点什么？\n");
                        break;
        }
}
int refuse_killing(object me)
{
     command("look "+me->query("id"));
     command("grin");
     message_vision("马老二恶狠狠地对$N道：“这真是天堂有路你不走，地狱无门你却偏要闯进来，哈哈!!”\n",me);
     set_wugong("taizu-quan",100,100,1);
     set_xiuwei_by_type("unarmed",300);
     set("bellicosity",1000);
     return 0;
}
