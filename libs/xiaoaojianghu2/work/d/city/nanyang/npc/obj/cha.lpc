//tea.c
inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("大碗清茶", ({ "dawan cha", "tea", "cha" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一大碗热茶，悠悠地冒着热气～～～\n");
    set("unit", "碗");
    set("value", 1);
    set("max_liquid", 30);
  }
  set("liquid", ([
    "type": "water",
    "remaining": 3,
    "drink_apply": 120,
    "name": "茶水",
  ]));
  setup();
}
