// wumei.c
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name(MAG"乌梅"NOR, ({"wu mei","mei"}));
    set_weight(1000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一捆乌梅枝，上面至少有上百个熟透的乌梅。\n");
        set("unit", "把");
        set("value",23);
        set("over_value",0);
        set("food_remaining", 10);
        set("food_supply", 10);//正常饭量的人一顿吃二斤。 
        set("eat_msg","$N摘下几个$n放进嘴里\n");
        set("end_msg","$N将剩下的$n吃的干干净净.\n");
    }
    setup();
}
int eat_effect(object me,object this)   //可以省略
{
    if( me->query("water") < me->query("food") )
        me->add("water",10);
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name("乌梅枝",({"wumei zhi","zhi"}));
    this->set("long","一大捆乌梅树的树枝。上面的乌梅已经被摘光了。\n");
    this->set("unit","捆");
    this->set("value",0);
    this->set_weight(500);
    return 1;
}
