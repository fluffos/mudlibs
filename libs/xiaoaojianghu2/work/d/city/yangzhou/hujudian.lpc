
inherit ROOM;

#include <ansi.h>



void create()
{
    set("short", WHT"南宫凌云阁"NOR);
    set("long", @LONG
一座古朴安静的小楼，门前放着几个普通的石桌椅，这里就是以前威名远扬的
南宫世家的住处，没想到现在如此萧条，南宫家的人也只好靠贩卖点兵器护具为生了。
来来往往的多是手持刀枪的武林中人，还是小心为妙。
LONG
    );
    set("no_fight", 1);
    set("no_kill",  "yangzhou");
    set("exits", ([
        "west"      : __DIR__"rishengjie",
        ]));
    set("objects", ([
        __DIR__"npc/nangong"  :   1,
    ]));        
    setup();
}
