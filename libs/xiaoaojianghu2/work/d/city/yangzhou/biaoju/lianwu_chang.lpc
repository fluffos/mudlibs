
#include <ansi.h>
inherit ROOM;



void create()
{
    set("short", "练武场");
    set("long", @LONG
练武场青石铺地，南边倚墙靠着个兵器架，插着各式器械。东头一个沙坑，
边上放着几个石锁，石磨盘，北面立着几个木桩。几个弟子在对练，一个中年人
在边上指点。北面的木桩前有个年轻人在对着木桩击打。
LONG
    );
    set("exits", ([
        "east" : __DIR__"biaoju_tingyuan",
    ]));
    set("objects", ([
        __DIR__"npc/tangzi_shou1" : 2,
        __DIR__"npc/biaoshi1" : 1,
        __DIR__"npc/biaoshi2" : 1,
        SWORD_DIR "changjian" : 1,
        __DIR__"obj/shitou" : 2,
        SWORD_DIR "zhujian" : 2,
    ]));
    set("outdoor", "yangzhou");
    setup();
}
