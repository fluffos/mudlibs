#include <ansi.h>
#include <room.h>
inherit ROOM;



void create()
{
    set("short", "大厅");
    set("long", @LONG
北墙贴着一张八仙过海图，倚墙放着一张红木桌，两张太师椅。桌上放置着
一盘盆景。左右两边的廊柱下放着一排红木椅，间隔着放着几张茶几，茶几摆放
一些时鲜花木。北边的太师椅上坐着一个中年人，看到你的进来，缓缓的站了起
来。两侧各有一门廊通向后面。
LONG
    );
    set("no_clean_up", 0);
    set("exits", ([
        "north" : __DIR__"biaoju_tingyuan",
        "southeast" : __DIR__"tianjing",
        "southwest" : __DIR__"tianjing",
    ]));
    set("objects", ([
        __DIR__"npc/liu_xinghai" : 1,
    ]));
    set("no_kill", "penglai");
    setup();
}
