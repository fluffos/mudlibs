inherit NPC;
#include "biaoju_npc.h"
#include "biaoju_master.h"



void create()
{
    set_name("许镖师", ({"xu biaoshi", "xu", "biaoshi"}) );
    set("gender", "男性");
    create_zuzhi( "凤翔镖局", 3, "镖师" );
    set("long", @LONG
这是凤翔镖局的一个镖师，年级不大，但据说功夫还是很利害的。
LONG
    );
    set("str", 21);
    set("con", 22);
    set("age", 28);
    set( "combat_exp", 5000 );
    set( "social_exp", 500 );
    set_wugong( "jiben-quanfa", 60, 60, 1 );
    set_wugong( "changquan", 50, 50, 1 );
    set_wugong( "jiben-qinggong", 70, 70, 1 );
    set_wugong( "xingyun-shenfa", 50, 50, 1 );
    set_wugong( "penglai-xinfa", 40, 40, 1 );
    set_xiuwei_by_type( "unarmed", 300 );
    set_xiuwei_by_type( "dodge", 280 );
    
    setup();
    carry_object(CLOTH_DIR "cloth6")->wear();
}

