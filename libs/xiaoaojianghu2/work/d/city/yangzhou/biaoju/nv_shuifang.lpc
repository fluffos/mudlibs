#include <ansi.h>
#include <room.h>
inherit ROOM;



void create()
{
    set("short", "女弟子睡房");
    set("long", @LONG
几张木板床一字排开，床的被褥叠的整整齐齐，床头各有一个小柜子，柜子
上放了一面铜镜。除了这些，屋内就别无它物。看来镖局弟子虽然在扬州这繁华
之地，生活也是很清苦的。
LONG
    );
    set("no_clean_up", 0);
    set("exits", ([
        "northeast" : __DIR__"tianjing",
        "south" : __DIR__"neifang",
    ]));
    set("objects", ([ ]));
    set("no_kill", "penglai");
    set("sleep_room", "inn");

    setup();
}

int valid_leave(object me,string dir)
{
	object *all;
	int i;

	if ( dir!="south" ) return 1;
		    all=all_inventory(me);
	    for(i=0;i<sizeof(all);i++)
		if(userp(all[i])){
		    message_vision("$N把$n往地下一摔，独自走了进去。\n",me,all[i]);
		    all[i]->move("/clone/misc/void");
		}
	    return 1;

}