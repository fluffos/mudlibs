
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;


void create()
{
    set_name( WHT "陆辜" NOR, 
		({ "lv gu","lv","seller" }) );
    set("gender", "男性" );
    set("title", YEL"悬壶济世"NOR );
    set("age", 66);
    set("per", 20);
    set("long", @LONG
一位高明的老医师，曾经当过御医，号称阎王愁，救过无数英雄豪杰。
LONG
    );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "现在SARS病横行啊，买点板蓝根吧！\n",
        "老了，不能把脉了，您就买点补药吃吃吧。\n",
        "客官，伤身可以治疗，伤心就无药可治了！\n",
    }));
    set("inquiry", ([
        "看病" : "啊，老了，您还是另请高明好了。",
        "和仁堂"   : "咳！您看到了，我们「和仁堂」可是供奉御药的哦！",
   	]) );
    set("attitude", "friendly");
    set("vendor_goods", ([
        "板蓝根"   : "/clone/medicine/banlangen",      
   
    ]) );
    set("no_kill", "yangzhou");
    set("combat_exp",1000);
    set("social_exp",1000);
    setup();
    carry_object( "/clone/wear/cloth/cloth5")->wear();
}
void init()
{
    object ob = this_player();
    ::init();
    if( this_object()->can_act() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    message_vision("陆辜捋了捋花白的胡须的说道：“杀人伤身，害人害己啊，不如归隐山林!!!”\n",ob);
}

