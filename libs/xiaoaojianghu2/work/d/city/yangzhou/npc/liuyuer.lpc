
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;


void create()
{
    set_name( WHT "柳玉儿" NOR, 
		({ "liu yuer","yuer","seller" }) );
    set("gender", "女性" );
    set("title", YEL"鸳鸯楼待女"NOR );
    set("age", 19);
    set("per", 30);
    set("long", @LONG
一位美丽可爱的小妇人，明亮的双眼似乎在说着什么，鸳鸯楼是
扬州新开的大酒楼，而这位可人的小妇人仿佛也刚来到扬州，满口
的关外口音。
LONG
    );
    set("talk_msg",({
        "哎？客官，不尝尝可口的五香牛肉么？",
        "哦，人真多啊，好热闹啊，客官去过移花宫么？",
        "您等等，我这儿忙完了就过来。",
        "客官，连移花宫主都长来我这里喝酒请客的哦！",
    }));
    set("inquiry", ([
        "请客" : "啊，是啊是啊，鸳鸯楼是最雅致的请客的地方！",
        "here"   : "咦！您家看了，「鸳鸯楼」这大招牌不是明摆着的么？",
   	]) );
    set("attitude", "friendly");
    set("vendor_goods", ([
        "平桥豆腐"   : "/clone/eat/food/pingqiao_doufu",      
        "红烧鲤鱼"   : "/clone/eat/food/hongshaoyu",     
        "白斩鸡"     : "/clone/eat/food/baizhanji",      
        "五香酱牛肉"  : "/clone/eat/food/niurou",       
        "玉珍烤鸭"    : "/clone/eat/food/kaoya",               
        "鸡汤蒲菜"    : "/clone/eat/food/jitang_pucai",        
    ]) );
    set("no_kill", "yangzhou");
    set("combat_exp",1000);
    set("social_exp",1000);
    set_xiuwei_by_type("unarmed",150);
    setup();
    carry_object( "/clone/wear/cloth/danhuang_shayi")->wear();
}
void init()
{
    object ob = this_player();
    ::init();
    if( this_object()->can_act() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    message_vision("柳玉儿高兴的说道：“开张大吉！欢迎大家常来光顾啊！”\n",ob);
}

