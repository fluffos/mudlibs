

#include <ansi.h>

inherit NPC;



void create()
{
    set_name( "贼人", ({ "zei ren", "zeiren", "ren" }) );
    set( "title", BLU"强"RED"盗"NOR );
    set( "gender", "男性" );                
    set( "age", 30 );                       
    set( "str", 40 );                       
    set( "positive_score", 150);            
    set( "negative_score", 150);            
    set( "attitude", "killer" );            
    set( "bellicosity", 250 );              
    set( "long", @LONG
    这是一名在江湖上的强盗，专门打劫压镖的镖师。
脾气一般都不好，不要招惹他才是。
LONG
    );

    set_wugong( "blade",        200,    100,    1 );    //横刀六式：    一级

    set_wugong( "unarmed",      200,    100,    1 );    //基本拳法：    一级

    set_wugong( "qinggong",     200,    100,    1 );    //基本轻功：    一级

    set_xiuwei_by_type( "blade",    1500 );  
    set_xiuwei_by_type( "unarmed",  1500 );  
    set_xiuwei_by_type( "dodge",    1500 );  

    set( "max_force",   1000 );              
    set( "force",       1000 );
    set( "force_factor", 50 );              

    set_hp( "kee",      1050 );              

    set( "combat_exp",  555000 );            

    set( "env/attack",  80 );

    setup();
    carry_object( BLADE_DIR + "blade2" )->wield();      
    carry_object( CLOTH_DIR + "cloth5" )->wear();      
    carry_object( BOOTS_DIR + "wuyun_xue" )->wear();    
}

void init()
{
    object ppl;

    ::init();

    if ( !userp( ppl = this_player() ) 
        || !can_act() )
        return;
    remove_call_out( "Greeting" );
    call_out( "Greeting", 1, ppl );
}

void Greeting( object ppl )
{
    if ( !ppl 
        || environment( ppl ) != environment() ) 
        return;
    if ( present( "mu xia", ppl ) )          
    {
        message_vision( "贼人冲着$N阴笑道：“哈哈，原来你就是走镖的，快快把东西给老夫！”\n", ppl );
        set_leader(ppl);
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
     }
}

int accept_fight( object ppl )
{
    command( "say “我看你今天是活得不耐烦了, "+ RANK_D->query_rude(ppl)
        + ", 去死吧！”" );
    say( RED"只听得贼人一声大喝：“他妈的，找死，兄弟们砍死他！”\n"NOR );
    message_vision( RED"只见四周里冲出来很多贼人，个个持刀向$N砍下，"
        + "登时将$N砍翻在地！！\n"NOR, ppl );
    ppl->unconcious(); 
    ppl->move( "/d/city/yangzhou/yangzhou_dangpu" );  
    message_vision( "$N被一群贼人丢弃在这里。\n", ppl );
    return 1;
}

int accept_bihua( object ppl )
{
    return accept_fight( ppl );
}

int refuse_killing( object me )
{
    message_vision( 
"$N冷笑了两声，大呵道：“你也敢黑吃黑啊！！......”\n" +
"$N说罢吹了声口哨，几十个贼人冲出来，乱刀向你砍来！！！！！！\n\n", this_object(), me );
    me->unconcious(); 
    me->move( "/d/city/yangzhou/yangzhou_dangpu" );
    return 1;
}   
