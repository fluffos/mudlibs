#include <armor.h>

inherit WAIST;



void create()
{
	set_name("皂丝绦", ({"zao sitao", "yaodai", "waistband"}));
	set_weight(1000);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一条黑色的丝带。\n");
		set("unit", "根");
		set("value", 550);
		set("material", "silk");
		set("armor_prop/armor", 1);
	}
	setup();
}



