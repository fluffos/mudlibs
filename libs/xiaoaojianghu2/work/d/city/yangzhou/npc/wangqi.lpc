
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;


void create()
{
    set_name( WHT "王七" NOR, 
		({ "wang qi","wang","seller" }) );
    set("gender", "男性" );
    set("title", YEL"鸳鸯楼酒保"NOR );
    set("age", 20);
    set("per", 30);
    set("long", @LONG
一位帅气的小哥，勤快而豁达，很能喝酒哦，也很懂酒道。
如果你有时间可以和他切磋一下酒道和酒量哦！
LONG
    );
    set("talk_msg",({
        "哎？客官，不来杯五粮液，好酒啊！酒中自有神仙在。",
        "哦，何以解忧，唯有茅台，劝君再进一杯酒，忘去一切烦脑。",
        "您等等，我们再来两百杯，看谁先成仙。",
        "客官，连移花宫主都常来我这里买酒哦！",
    }));
    set("inquiry", ([
        "酒" : "啊，酒乃长久之意思，喝酒可以让你和朋友的情义天长地久！",
        "here"   : "咦！您家看了，「鸳鸯楼」这大招牌不是明摆着的么？",
   	]) );
    set("attitude", "friendly");
    set("vendor_goods", ([
        "女儿红": "/d/city/dali/npc/obj/nver",
        "桂花酒": "/clone/eat/liquid/guihua_jiu",
        "糊涂仙": "/clone/eat/liquid/hutuxian",
        "茅台酒": "/clone/eat/liquid/maotaijiu",
        "五粮液": "/clone/eat/liquid/wuliangye",
        "糯米酒": "/d/city/dali/npc/obj/nuomi",
        "鲜橙多": "/clone/wizard/xian",      
    ]) );
    set("no_kill", "yangzhou");
    set("combat_exp",1000);
    set("social_exp",1000);
    set_xiuwei_by_type("unarmed",100);
    setup();
    carry_object( "/clone/wear/cloth/cloth7")->wear();
}
void init()
{
    object ob = this_player();
    ::init();
    if( this_object()->can_act() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    message_vision("王七提着一壶糊涂仙高兴的说道：“难的糊涂！酒中自有颜如玉！酒中自有金万两！”\n",ob);
}

