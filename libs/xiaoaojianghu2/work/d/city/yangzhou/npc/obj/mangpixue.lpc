#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name(YEL"莽皮战靴"NOR, ({"mangpi xue", "pi xue", "xue"}));
        set_weight(300);
        if ( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一双用千年莽皮做的靴子，精美耐用，水火不侵。\n");
                set("unit", "双");
                set("value", 100000);
                set("material", "leather");
                set("cant_sell","这样的宝物小的没胆气收下，还是贵人您自己保管好了。\n");
                set("wear_msg","只听见「咯」地一声，$N的脚上已经穿上一双精美的--$n。\n");
                set("armor_prop/armor", 20);

        }
        setup();
}
