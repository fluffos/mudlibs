#include <armor.h>
#include <ansi.h>
inherit ARMOR;
void create() {
  set_name(YEL "蚕丝软猬甲" NOR, ({ "ruanwei jia", "jia", "armor", }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一套天山冰蚕丝做柔软坚韧的铠甲.\n");
    set("unit", "套");
    set("value", 500000);
    set("cant_sell", "这样的宝物小的没胆气收下，还是贵人您自己保管好了。\n");
    set("wear_msg", "只听见「簌」地一声，$N的身上已经多了一套金色柔软贴身的铠甲--$n。\n");
    set("armor_prop/armor", 45);
    set("armor_prop/defence", 10);

  }
  setup();
}
