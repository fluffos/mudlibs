//jin_jie.c

#include <ansi.h>
#include <armor.h>

inherit FINGER;



void create()
{
	set_name(YEL"金戒指"NOR, ({"jin jiezhi", "jiezhi", "finger"}));
	set_weight(500);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "黄金雕成的戒指，金光灿烂\n");
		set("unit", "枚");
		set("value", 150000);
		set("material", "gold");
		set("armor_prop/armor", 10);
	}
	setup();
}



