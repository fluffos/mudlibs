//by lnwm /d/city/yangzhou/npc/yu_fan.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;



void create()
{
    set_name("冷郁然" , ({ "leng yuran", "leng" }) );
	set("rank_info/zhiye","玉店老板");
    set("gender", "男性" );
    set("age",45);
    set("combat_exp", 1500000);
    set_jibie("unarmed",200);
    set_lingwu("unarmed",200);
	set_xiuwei_by_type("unarmed",1200);
	set("max_force",1000);
	set("force", 1000 );
	set("force_factor",20);
    enable_skill("unarmed");


    set("attitude", "friendly");
    set("vendor_goods", ([
            CYN"玉戒指"NOR  	:   __DIR__ "obj/yu_jie",
			CYN"玉带"NOR		: 	__DIR__ "obj/yu_dai",
			CYN"玉发簪"NOR		:	__DIR__ "obj/yu_fa",
			CYN"玉手镯"NOR		:	__DIR__ "obj/yu_shou",
			WHT"玉如意"NOR		:	__DIR__ "obj/yu_ruyi",
			WHT"玉杯"NOR		:	__DIR__ "obj/yu_bei",
			WHT"玉盏"NOR		:	__DIR__ "obj/yu_zhan",    
	]) );
    setup();
    carry_object( CLOTH_DIR "cloth1")->wear();
}

void init()
{
    object ob;
    ::init();
    if( interactive(ob = this_player()) && !is_fighting() ) {
            remove_call_out("greeting");
            call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	message_vision("玉店老板对$P笑脸相迎：请随便看看。\n",ob);
    return;
}
                  