//Npc : shibing.c
//by trill 05/02/97

#include <ansi.h>
inherit NPC;



void create()
{
    set_name(YEL "士兵" NOR, ({ "shi bing", "bing" }));
    set("title","扬州守备");
    set("age", 25);
    set("gender", "男性");
    set("long", "一个士兵，略略显的成熟一点，却一副老兵油子的模样。\n");
    set("str", 30);
    set("con", 30);
    set("no_kill", "yangzhou");
    set("combat_exp", 8000);
    set("max_gin",200);
    set("max_kee",400);
    set("max_sen",400);
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        "士兵喝道：大胆刁民，竟敢杀官，莫不是想造反不成？\n",
        "士兵喝道：你还能逃出大宋国界不成，还是乖乖投降吧！\n",
    }));
    set("talk_msg", ({
        "边上的那个新兵真烦，整天问这问哪的。\n",
        "扬州可真是个花花世界。\n",
        "站了三年岗了，很快就可以回家了！\n",
        "那个新兵，当了几天兵就想媳妇，哼！\n",
    }));

    set_wugong("sharen-daofa", 120, 120, 1);
    set_xiuwei_by_type("blade", 600);
    set_wugong("jiben-qinggong", 100, 100, 1);
    set_xiuwei_by_type("dodge", 500);
    setup();
    carry_object( BLADE_DIR + "changdao" )->wield();
    carry_object( CLOTH_DIR + "junfu" )->wear();
    carry_object( ARMOR_DIR + "kaijia2" )->wear();
    carry_object( WAIST_DIR + "yaopai" )->wear();
}

void init()
{
    ::init();
    if( can_act() ) 
    {
        remove_call_out("greeting");
        call_out("greeting", 1);
    }
}
void greeting()
{
    object me = this_player();
    if( me->query_condition("kill_yangzhou") )
    {
        message_vision( "士兵对着$N大喝一声：“杀人放火的刁民，快快受死吧！！！” \n", me );
        kill_ob(me);
    }
}

int accept_fight(object me)
{
    object *all;
    int i;
    if ( random(5) == 0 )
    {
        command("say 军爷我今天心情好，别烦我，滚！！！！\n");
        return 0;   
    }
    command("say 我看你今天是活得不耐烦了,"+ RANK_D->query_rude(me)+",去死吧！\n"); 
    me->apply_condition("kill_yangzhou", 360);
    CRIME_D->set_crime(me, "yangzhou");
    all = all_inventory(environment(me));
    for ( i = 0; i < sizeof( all ); i ++ )
    {
        if ( all[ i ]->id("shi bing") || all[ i ]->id("xiao wei") 
            || all[ i ]->id("wu jiang") )
            all[ i ] -> kill_ob(me);
    }
    return 1;
}

int refuse_killing(object me)
{
    object *all;
    int i;

    me->apply_condition("kill_yangzhou", 360);
    CRIME_D->set_crime(me, "yangzhou");
    all = all_inventory(environment(me));
    for ( i = 0; i < sizeof( all ); i ++ )
    {
        if ( all[i]->id("shi bing") || all[i]->id("xiao wei") 
            || all[i]->id("wu jiang") )
            all[i] -> kill_ob(me);
    }
    return 0;
}
