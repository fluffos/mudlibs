// xunbu.c
// by trill

#include <ansi.h>

inherit NPC;



void create() {
  set_name(YEL "捕快" NOR, ({ "bu kuai", "bu" }));
  set("gender", "男性");
  set("age", 35);
  set("title", "扬州城"),
    set("long", "他是一个捕快，腰跨钢刀，一副精明干练的样子。\n");

  set("no_leave_yangzhou", 1);

  set("str", 30);
  set("con", 30);

  set_wugong("sharen-daofa", 150, 150, 1);
  set_wugong("jiben-qinggong", 200, 200, 1);
  set_xiuwei_by_type("dodge", 4101);
  set_xiuwei_by_type("blade", 4101);
  set_force(3000, 3000, 300);

  set("combat_exp", 500000);
  set("chat_chance", 30);
  set("chat_msg", ({
    "捕快大喝一声：“闲杂人等一律避开，不要妨碍大爷办事！”\n",
    "“那几个泼皮真讨厌，整天要盯着他们。”捕快唠叨着。\n",
    (: random_move :),
    (: random_move :),  // 跑的快点
    (: random_move :)
  }));

  setup();
  carry_object(__DIR__ "obj/yaodao")->wield();
  carry_object(CLOTH_DIR + "xunbu_fu")->wear();
  carry_object(BOOTS_DIR + "zaoxue")->wear();
}

void init() {
  ::init();
  if (interactive(this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1);
  }
}

void power_up() {
  int yourForce;
  object me = this_player();
  if (!me)
    return;
  //add by xli 2000.5.11
  //捕快遇强则强
  if (random(4) > 0)    // 3/4的几率
  {
    int mx = 0;
    mapping xiuwei = me->query_xiuwei_map();
    if (sizeof(xiuwei))
      foreach (string x, int v in xiuwei) {
        if (v > mx) mx = v * 5 / 4;
      }
    if (mx < 4000) mx = 3000;
    set_xiuwei_by_type("blade", mx * 5 / 4);
    yourForce = me->query("max_force");
    set_force(yourForce, yourForce, yourForce / 10);
    set("combat_exp", me->query("combat_exp") * 5 / 4);
    // setup()
    // setup();  多此一举，画蛇添足，费力不讨好。
  }
  //add end
}

void greeting() {
  object me = this_player();
  if (me->query_condition("kill_yangzhou")) {
    message_vision("捕快对着$N大喝一声：“大胆刁民，竟敢杀人放火，想置我们与何地？！！” \n", me);
    power_up();
    set_leader(me);
    kill_ob(me);
  }
}

int accept_fight(object me) {
  object *all;
  int i;
  if (random(5) == 0) {
    command("say 大爷我今天心情好，别烦我，滚！！！！\n");
    return 0;
  }
  command("say 我看你今天是活得不耐烦了," + RANK_D->query_rude(me) + ",去死吧！\n");
  me->apply_condition("kill_yangzhou", 360);
  CRIME_D->set_crime(me, "yangzhou");

  all = all_inventory(environment(me));
  for (i = 0; i < sizeof(all); i++) {
    if (all[i]->id("shi bing") || all[i]->id("xiao wei")
      || all[i]->id("wu jiang"))
      all[i]->kill_ob(me);
  }
  return 1;
}

int refuse_killing(object me) {
  object *all;
  int i;

  me->apply_condition("kill_yangzhou", 360);
  CRIME_D->set_crime(me, "yangzhou");

  power_up();

  all = all_inventory(environment(me));
  for (i = 0; i < sizeof(all); i++) {
    if (all[i]->id("ya yi") || all[i]->id("bu tou")
      || all[i]->id("xun bu"))
      all[i]->kill_ob(me);
  }
  return 0;
}
