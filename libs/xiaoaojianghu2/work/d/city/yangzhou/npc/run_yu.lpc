//by lnwm /d/city/yangzhou/npc/run_yu.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;



void create()
{
    set_name( WHT"润玉"NOR , ({ "run yu", "yu" }) );
    set("rank_info/zhiye", MAG"卖花姑娘"NOR );
    set("gender", "女性" );
    set("age",16);
    set("per",32);
    set("combat_exp", 1500);
    set_jibie("unarmed",20);
    set_lingwu("unarmed",20);
    enable_skill("unarmed");
    set("attitude", "friendly");
    set("chat_chance",1);
	set("chat_msg", ({ (: random_move :), }) );
    set("vendor_goods", ([
            RED"红玫瑰"NOR    :   HEAD_DIR "hong_m",
            YEL"黄玫瑰"NOR    :   HEAD_DIR "huang_m",
            WHT"白玉兰"NOR    :   HEAD_DIR "bai_yu",
            MAG"紫蔷薇"NOR    :   HEAD_DIR "qiang_w",
            HIB"勿忘我"NOR    :   HEAD_DIR "wu_wang",
            YEL"郁金香"NOR    :   HEAD_DIR "yu_jin",
    ]) );
    setup();
    carry_object( __DIR__"obj/cloth1")->wear();
    carry_object( HEAD_DIR "yu_jin")->wear();
    carry_object( "/clone/wizard/bone");
}

void init()
{
    object ob;
    ::init();
    if( interactive(ob = this_player()) && !is_fighting() ) {
            remove_call_out("greeting");
            call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
    if( !ob || environment(ob) != environment( this_object() ) )
    return;
      
    if ( ob->query("gender") == "女性" )
    {
        if ( ob->query("age") <  30 )
        {
            message_vision("卖花姑娘冲$P甜甜一笑：姑娘不买朵郁金香吗？\n",ob);
            return;
        }
    }
    else
    {
        if ( ob->query("have_married" ) )
        {
            message_vision("卖花姑娘冲着$P笑着：不给您的妻子买束花吗？\n",ob);
            return;
        }
        else
        {
            message_vision("卖花姑娘冲着$P笑着：不给心上人买束红玫瑰吗？\n",ob);
            return;
        }
    }                  
    return;
}
                  