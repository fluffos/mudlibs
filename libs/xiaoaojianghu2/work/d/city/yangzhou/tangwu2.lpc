// Room: /d/city/yangzhou/tangwu2.c
inherit ROOM;


void create()
{
    set("short", "堂屋");
    set("long", @LONG
屋之南北饰一雕花窗栏隔扇，东西两山墙辟有大块窗格，四面空明。正中壁
上悬一巨制梅桩中堂，笔力遒劲，墨气飞动，左右挂一楹联。倚墙设一套红木条
几，上陈古瓶，盆景。几前一海梅雕花方桌，桌旁一对海梅雕花太师椅。设竹榻，
榻旁一架古书，缥湘零乱。
LONG
    );
    set("exits", ([ /* sizeof() == 2 */
        "south" : __DIR__"rongxi_yuan",
    ]));
    set("objects", ([ /* sizeof() == */
        __DIR__"npc/qiu_haoshi" : 1
    ]));
    set("detail", ([
        "楹联" : @LONG
                  ┌─┐          ┌─┐ 
                  │倚│          │登│
                  │栏│          │楼│
                  │潜│          │清│
                  │窥│          │听│
                  │鸟│          │市│
                  │梦│          │声│
                  │闲│          │远│
                  └─┘          └─┘
LONG,
    ]));
    set("no_clean_up", 0);
    setup();
    //place_program(ROOM);
}
