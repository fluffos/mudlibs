// /d/city/yangzhou/yangzhou_dangpu.c
// modify by akuma 
// 1999/12/3
// for newbie to know what to do in dangpu
inherit HOCKSHOP;

#include <ansi.h>



void create()
{
    set("short",YEL"扬州当铺"NOR);
    set("long",@LONG
这是家远近闻名的当铺。一块写着『铺』字的白布幡在当铺门外迎风招展。
进来后，明显的给人一种非常压抑的感觉，你却又说不上来这种感觉来自何处。
霹雳啪啦的算盘声不绝于耳，看来这里的生意不错。可是当铺生意兴隆，百姓的
日子就不是那么好过了！柜台上方挂着一块牌子（sign），上书几个大字：你情
我愿，概不赊欠，后边还有几行小字，不仔细看似乎看不清楚。
LONG);
    set("exits",([
       	"west"   : __DIR__"xincheng_cangjie",        
    ]));
    set("dangpu_location","yangzhou");
    set("item_desc",([
    	"sign":"这是一块古老的木牌，上面写着几个大字：『你情我愿，概不赊欠』。下边还有\n几行小字：\n        典当：		pawn\n        赎取：		redeem\n	查看：		pawnlist\n	查看过期物：	list\n",
    ]));
    setup();
}
