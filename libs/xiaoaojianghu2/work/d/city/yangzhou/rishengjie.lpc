

inherit ROOM;
#include <ansi.h>



void create()
{
    set("short", YEL"新日升街"NOR);
    set("long", @LONG
你的面前是扬州的新城，笔直的青石大道上人头涌动，车水马龙。
西边是老字号的“和仁堂”药店，东边是南宫世家开的兵器店。北边是
百年钱庄“彦明钱庄”。街市的正中央是豪华热闹的鸳鸯酒楼。
LONG
    );
    set("no_clean_up", 0);
    set("outdoors", "yangzhou");
    set("no_kill", "yangzhou");

    set("exits", ([ /* sizeof() == 2 */
        "north" : __DIR__"qianzhuang",
        "west" : __DIR__"herentang",
        "up" : __DIR__"yuanyang",
        "east" : __DIR__"hujudian",
        "south" : __DIR__"xincheng_cangjie",
        "enter" : __DIR__"guandici",
    ]));

    setup();
    //place_program(ROOM);
}


