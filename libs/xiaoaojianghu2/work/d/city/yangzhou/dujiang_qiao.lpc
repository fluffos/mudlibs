#define __MATOU__  "/d/city/matou/"
inherit ROOM;



void create()
{
	set("short","渡江桥");
	set("long",@LONG
一座三拱石桥横卧在大运河上，桥的侧栏上由知州欧阳修题着「渡江桥」,
桥下各色船只穿流不息。东边是扬州最大的码头，漕运的粮食，两淮产的盐，多
在此装卸。过了桥就是扬州的南门：安定门。
LONG    
	);
	set("exits",([ /* sizeof() ==  */
		"south" : __MATOU__"yangzhou_yidao",
		"north" : __DIR__"anding_men"
	]));
	set("outdoors", "yangzhou");
	setup();
}


                  
                 
