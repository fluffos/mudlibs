inherit ROOM;
#include <ansi.h>


void create()
{
    set("short", YEL "关帝祠" NOR);
    set("long",@LONG
这里是供奉关公关羽的关帝祠。供桌上放着炉鼎，鼎里满是香灰，还有二十几根香
在燃着，散出浓浓的香烟，供桌后面一尊红脸关帝关羽的雕像身穿戎服,手握青龙偃月
刀，威武神圣。当年刘关张，桃园三结义，关羽可谓义气千秋。所以后人常在关帝面前
结拜兄弟，希望关帝护佑，兄弟情义永存。
LONG);
    set("exits",([
        "out"   : "/d/city/yangzhou/rishengjie",
    ]));
    setup();
}


            
          


