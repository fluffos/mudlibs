#include <ansi.h>
inherit NPC;

void create()
{
    set_name(MAG"客商"NOR, ({ "ke shang" }));
    set( "age", 28 + random( 5 ) );
    set("title","大食");
    set("gender", "男性");
    set("long", "他是一名大食客商，从事宋汴京和大食之间的丝绸买卖，刚刚被马鹞军搜查过. \n");
    set("str",40);
    set("per", 25);
    set("combat_exp", 5000);
    set("max_gin",300);
    set("max_kee",700);
    set_wugong("qinggong",100,100,1); 
    set_xiuwei_by_type("dodge",400);
    set_wugong("taizu-quan",100,100,1);
    set_xiuwei_by_type("unarmed",400); 

    set("chat_chance",5);
    set("chat_msg",({
        (:random_move:),
    }) );

    setup(); 
    carry_object(__DIR__"obj/cloth3")->wear();
    carry_object(__DIR__"obj/zao_sitao")->wear();
    carry_object(__DIR__"obj/pixue")->wear(); 
}
