// 楚州士兵 /d/city/chuzhou/npc/shibing1.c
// by lala, 1997-12-13

#include <ansi.h>
inherit NPC;

void create()
{
    set_name( "士兵", ({ "shi bing", "bing" }) );
    set( "title", YEL"楚州"GRN"守备"NOR );
    set( "age", 25 );
    set( "gender", "男性" );
    set( "long", "一个士兵，一副稚嫩的新兵模样。\n" );
    set( "str", 30 );
    set( "con", 30 );
    set( "no_kill", "yangzhou" );
    set( "combat_exp", 8000 );
    set( "max_gin", 200 );
    set( "max_kee", 400 );
    set( "max_sen", 400 );
    set( "max_force", 1000 );
    set( "force_factor", 10 );
    set( "chat_chance_combat", 10 );
    set( "chat_msg_combat", ({
        "士兵喝道：“大胆刁民，竟敢杀官，莫不是想造反不成？”\n",
        "士兵喝道：“你还能逃出大宋国界不成，还是乖乖投降吧！”\n",
    }));
    set("talk_msg", ({
        "“我刚当兵没几天，一切都不太熟悉。”",
        "“楚州可比俺家乡繁华多了。”",
        "“整天站岗，真是无聊啊～～～！”",
        "“不知道什么时候能回家，俺娘给俺说了门媳妇呢！”",
    }));
    
    set_wugong( "sharen-daofa", 100, 100, 1 );
    set_xiuwei_by_type( "blade", 600 );
    set_wugong( "jiben-qinggong", 100, 100, 1 );
    set_xiuwei_by_type( "dodge", 500 );
    setup();
    carry_object( BLADE_DIR + "changdao" )->wield();
    carry_object( CLOTH_DIR + "junfu" )->wear();
    carry_object( ARMOR_DIR + "kaijia2" )->wear();
    carry_object( WAIST_DIR + "yaopai" )->wear();
}

void init()
{
    ::init();
    if( can_act() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1);
    }
}
void greeting()
{
    object me = this_player();
    if( me->query_condition("kill_yangzhou") )
    {
        message_vision( "士兵对着$N大喝一声：“杀人放火的刁民，快快受死吧！！！” \n", me );
        kill_ob(me);
    }
}

int accept_fight(object me)
{
    object *all;
    int i;
    if ( random(5) == 0 )
    {
        command("say 军爷我今天心情好，别烦我，滚！！！！\n");
        return 0;   
    }
    command("say 我看你今天是活得不耐烦了,"+ RANK_D->query_rude(me)+",去死吧！\n"); 
    me->apply_condition("kill_yangzhou", 360);
    CRIME_D->set_crime(me, "yangzhou");
    all = all_inventory(environment(me));
    for ( i = 0; i < sizeof( all ); i ++ )
    {
        if ( all[ i ]->id("shi bing") || all[ i ]->id("xiao wei") 
            || all[ i ]->id("wu jiang") )
            all[ i ] -> kill_ob(me);
    }
    return 1;
}

int refuse_killing(object me)
{
    object *all;
    int i;

    me->apply_condition("kill_yangzhou", 360);
    CRIME_D->set_crime(me, "yangzhou");
    all = all_inventory(environment(me));
    for ( i = 0; i < sizeof( all ); i ++ )
    {
        if ( ( all[i]->id("shi bing") || all[i]->id("xiao wei")
            || all[i]->id("wu jiang") ) && all[i] != this_object() )
            all[i] -> kill_ob(me);
    }
    return 0;
}

