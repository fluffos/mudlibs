//NPC:/d/city/luoyang/npc/xiaofan edit by Happyman Mar.25.97
inherit NPC;
inherit F_VENDOR;
void create()
{
        set_name("小贩", ({ "xiao fan","fan","seller"}) );
        set("gender", "男性" );
        set("age", 22+random(2));
        set("long", "这是一位城里的小贩，一脸精明。\n"
            );
        set("attitude","friendly");
        set("combat_exp",100);
        set_wugong("unarmed",5,5,1);
        set("vendor_goods",([
            "金簪子":__DIR__"obj/jin_zanz",
            "银簪子":__DIR__"obj/yin_zanz",
            "玉镯子":__DIR__"obj/yu_zhuoz"
            ]));
        setup();
	carry_object(__DIR__"obj/cloth2")->wear();
        add_money("coin",100);
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
   


