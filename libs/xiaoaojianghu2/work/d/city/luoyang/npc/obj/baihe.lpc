#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIW "百合花" NOR, ({ "jian", "sword" }));
  set_name(HIW "百合花" NOR, ({ "baihe", "hua", "baihe hua" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "大把");
    set("long", "一大把芬芳馥郁的百合花，毫无心事地灿烂地开着。\n");
    set("value", 2000);
    set("material", "steel");
    set("wield_msg", "$N抱起一把百合花，根本没有把对手放在眼里。\n");
    set("unwield_msg", "$N将手中的$n藏在背后，很得意的样子。\n");
  }
  init_sword(30);
  setup();
}
