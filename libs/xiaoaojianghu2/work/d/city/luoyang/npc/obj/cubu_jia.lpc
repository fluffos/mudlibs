#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("粗布珈裟", ({ "cloth" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "套");
                set("material", "cloth");
                set("armor_prop/armor",1);
              
        }
        setup();
}
