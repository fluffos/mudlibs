#include <armor.h>
inherit HEAD;
void create()
{
        set_name("头盔", ({ "tou kui", }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
               
                set("unit", "只");
                set("value",300);
                set("material", "iron");
                set("armor_prop/armor", 1);
             
        }
        setup();
}
