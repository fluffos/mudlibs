//NPC:/d/city/luoyang/npc/youke edit by Happyman Mar.25.97
inherit NPC;
void create()
{
        set_name("游客", ({ "youke"}) );
        set("gender", "男性" );
        set("age",25+random(5));
        set("long", "这是一位从城外来的游客，脸上一种进了洛阳城的兴奋之色。\n"
            );
        set("combat_exp",6000+random(1000));
        set_wugong("unarmed",30,30,1);
        set("attitude","friendly");
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}
