inherit NPC;
void create()
{
        set_name("唐老板", ({ "tang","laoban" }) );
        set("title","酒楼老板");
        set("gender", "男性" );
        set("age", 40);
        set("long", "唐老板经营这里以经好些年了，把这里搞得风风火火。\n"
           );
        set("attitude","friendly");
        set("combat_exp",30000);
//        set("sword",55,55,1);
        setup();
        carry_object(__DIR__"obj/cloth5")->wear();
//        carry_object(__DIR__"obj/sword2")->wield();
        add_money("gold",2);
}
