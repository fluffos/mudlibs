inherit NPC;
void create()
{
        set_name("少妇", ({ "shao fu","fu","woman" }) );
        set("gender", "女性" );
        set("age", 20);
        set("per", 25);
        set("long", "这是一位大户人家的媳妇，看样子是出来买些东西。\n");
        set("attitude","friendly");
        set("combat_exp",300);
        set_wugong("unarmed",10,10,1);
        setup();
        carry_object(__DIR__"obj/wocloth2")->wear();
        carry_object(__DIR__"obj/yin_zanz")->wear();
        add_money("silver",1);
}
