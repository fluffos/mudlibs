//NPC:/d/city/luoyang/npc/jinxiangke edit by Happyman Mar.25.97
inherit NPC;
void create()
{
        set_name("进香客", ({ "jinxiang ke","ke" }) );
        set("gender", "男性" );
        set("age", 30+random(10));
        set("long", "这是一位来进香的人，一脸虔诚的表情。\n"
            );
        set("combat_exp",200000+random(100000));
        set_wugong("baxian-zhang",100,100,1);
        set_wugong("baxian-shenfa",100,100,1);
        set("max_force",2000);
        set("social_exp",1000);
        set("force", 2000);
        set_xiuwei("unarmed",3201+random(1000));
        set("wimpy",30);
        set_xiuwei("dodge",3201);
   //     set("attitude","friendly");
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}
