//NPC:/d/city/luoyang/npc edit by Happyman Mar.25.97
inherit NPC;
void create()
{
        set_name("旅客", ({ "lvke","ke" }) );
        set("gender", "男性" );
        set("age", 30);
        set("long", "这是一位从城外来的旅客，一脸风尘仆仆。\n"
            );
        set("attitude","friendly");
        set("combat_exp",5000+random(1000));
        set_wugong("unarmed",35,35,1);
        setup();
        carry_object(__DIR__"obj/cloth1")->wear();
        add_money("silver",1);
}
