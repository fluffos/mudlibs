inherit ROOM;

void create()
{
	set("short", "仙客来酒楼");
	set("long", @LONG
这里是仙客来的二楼，红木地板上只摆着几张桌子，能来此用餐的不是官府
的大官，也是富甲一方的商贾。屋脚坐着一位色艺双绝的艺妓在弹着琵琶，唱着
小曲，在这里用餐的商人们在小声谈着生意。从窗户可以看到窗外繁华的洛阳城
的景象。
LONG
	);
        set("exits", ([ 
	        "down"    : __DIR__"jiulou1",
        ]));
        set("objects", ([
             __DIR__"npc/tanglaoban": 1,
             __DIR__"npc/yiji":1,   
             __DIR__"npc/shangren":1 
        ])); 
	setup();
	//place_program(ROOM);
