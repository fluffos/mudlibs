//Cloth :heiyi.c

#include <armor.h>
inherit CLOTH;

void create()
{
	set_name("黑布衣", ({ "hei yi", "cloth"}) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("value", 200);
		set("unit", "套");
		set("material", "cloth");
		set("armor_prop/armor", 5);
	}
	setup();
}
