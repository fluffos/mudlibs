#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short",CYN "汴河码头" NOR);
	set("long",@LONG
汴河又叫通济渠，是隋炀帝时开凿用来运送江南的粮食物资到洛阳去的重要
运河。自宋建朝以来，为了保证东京乃至整个中原地区的物资供应，对汴河进行
了工程浩大的整修，每年有近千万石的粮食从这里运达汴京。通商的船只更是不
计其数。码头上停着几十只大大小小的船只。
    岸边停靠着一条客船。
LONG);
	set("long1",@LONG
汴河又叫通济渠，是隋炀帝时开凿用来运送江南的粮食物资到洛阳去的重要
运河。自宋建朝以来，为了保证东京乃至整个中原地区的物资供应，对汴河进行
了工程浩大的整修，每年有近千万石的粮食从这里运达汴京。通商的船只更是不
计其数。码头上停着几十只大大小小的船只。
LONG);
	set("long2",@LONG
汴河又叫通济渠，是隋炀帝时开凿用来运送江南的粮食物资到洛阳去的重要
运河。自宋建朝以来，为了保证东京乃至整个中原地区的物资供应，对汴河进行
了工程浩大的整修，每年有近千万石的粮食从这里运达汴京。通商的船只更是不
计其数。码头上停着几十只大大小小的船只。
    岸边停靠着一条客船。
LONG);
	set("exits",([
                "north" : "/d/city/capital/xsng_men",
                "southwest" : "/d/city/capital/xhua_men",
//                "south" : "/d/place/donggong/matou",
//    "east"   : "/d/place/donggong/yunhe_an",
	]));
	set("objects",([
