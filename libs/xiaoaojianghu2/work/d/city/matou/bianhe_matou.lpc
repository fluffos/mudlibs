void init()
{	
	object boat;
	if ( !boat = find_object(__DIR__"kechuan") )
		boat = load_object(__DIR__"kechuan");
	if ( boat = find_object(__DIR__"kechuan") ) 
		if (!boat->query("moving") ) {
			if ( !query("exits/enter") ) {
				set("exits/enter",__DIR__"kechuan");
				boat->set("exits/out", __FILE__);
			}
			remove_call_out("on_river");
			call_out("on_river", 10, boat, this_object(), 0);
			boat->set("moving", 1);
		}
	return ;
}

void boat_start(int i)
{
	switch ( i ) {
		case 0 : 
			remove_call_out("open_yangzhou");
			call_out("open_yangzhou",1);
			break;
		case 1 : 
			remove_call_out("open_capital");
			call_out("open_capital",1);
			break;
		default : i = 1 ;break;
	}
}

void open_capital()
{
	object boat;
	if ( !boat=find_object(__DIR__"kechuan") )
		boat=load_object(__DIR__"kechuan");
	if ( boat=find_object(__DIR__"kechuan") ){
		message("vision", "只见客船渐渐慢了下来，陈大冲客舱喊了一声：“汴梁到了！ ”\n", 
			boat );
		boat->set("exits/out", __FILE__);
		message("vision", "一条客船渐渐靠上了岸，一个船工把一架木梯搭上了岸。\n", this_object() );
		set("exits/enter", __DIR__"kechuan");
		set("long", (string)this_object()->query("long2") );
	}
	remove_call_out("on_river");
	call_out("on_river", 10, boat, this_object(), 0);
}

void open_yangzhou()
{
	object boat, room;
	if ( !room = find_object(__DIR__"yangzhou_matou") )
		room = load_object(__DIR__"yangzhou_matou");
	if ( room == find_object(__DIR__"yangzhou_matou") ) {
		message("vision", "一条客船渐渐靠上了岸，一个船工把一架木梯搭上了岸。\n", room);
		room->set("exits/enter", __DIR__"kechuan");
		room->set("long", (string)room->query("long2") );
	}
	if ( !boat = find_object(__DIR__"kechuan") )
		boat = load_object(__DIR__"kechuan");
	if ( boat == find_object(__DIR__"kechuan")) {
		message("vision", "只见客船渐渐慢了下来，陈大冲客舱喊了一声：“扬州到了！ ”\n", 
			boat);
		boat->set("exits/out", __DIR__"yangzhou_matou");
	}
	remove_call_out("on_river");
	call_out("on_river", 10, boat,room, 1);
}

void on_river(object boat, object room,int i)
{
	room->set("long", (string)room->query("long1") );
	message("vision", "陈大喊了一声“开船了~~~~~~~”，收起木梯，几个船工一点长\n"+
	"篙，客船缓缓开动了。\n", boat);
	boat->delete("exits/out");
	message("vision", "陈大喊了一声“开船了~~~~~~~”，收起船上的木梯，几个船工\n"+
	"一点长篙，客船缓缓向河中央驶去。\n", room);
	room->delete("exits/enter");
	remove_call_out("boat_start");
	call_out("boat_start", 30, i);
	return ;
}

