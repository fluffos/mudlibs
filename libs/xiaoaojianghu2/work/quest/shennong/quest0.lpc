#include <ansi.h>

inherit SKILL;

string *medicine = ({
"竹参", HIW"银耳"NOR, "五味子", "天麻", "蛇毒药", "黄连", "凤党", "杜仲",
"大黄", "云南白药",
});

string *npc = ({
"小丫鬟", "青衣小厮", "书童", "仆人",
});

mapping query_quest()
{
    string name;
    if( random(2) )
	{
		name = medicine[random(sizeof(medicine))];
	    return
   		([      "quest":                "取" + name ,
        	    "time":                 400 + random(200),
            	"bonus":                5 + random(6),
	            "quest_msg":
"司空玄想了一想，说：“现在帮里要配药对付无量派，你去弄些\n"
+ name + "回来吧。”\n",
                "reward_msg":
"司空玄点了点头说：“嗯，回来的还算及时，休息去吧。”\n",
        ]); 
	}
    name = npc[random(sizeof(npc))];
	return
    ([      "quest":                "杀" + name,
            "time":                 300 + random( 300 ),
            "bonus":                8 + random(5),
            "quest_msg":
"司空玄冷笑一声：“哼，你去杀一个无量派的狗东西，……以你\n"
"的功夫，就杀" + name + "吧，快去快回。”\n",
                "reward_msg":
"司空玄点头道：“好好，给本帮扬威立万，叫他们知道我们的厉害！”\n",
    ]);
}
