#include <ansi.h>

inherit SKILL;

string *medicine1 = ({
BLK"何首乌"NOR, HIW"山参"NOR, HIM"灵芝"NOR, MAG"甘草"NOR, "毒蛇", "金创药", 
"蜜蜂","党参", "败耳草", HIY"虎骨"NOR,
});

string *medicine2 = ({
"无量剑谱", "青道袍", "悬泉剑", "残破无量剑谱", 
});        

string *npc1 = ({
"练功弟子", "守门弟子", "巡山弟子", "无量弟子", "女弟子", "西宗弟子", 
"小郎", "邢小玉",
});  

string *npc2 = ({
"龚光杰", "干光豪", "吴光胜", "葛光佩", "商余庆",
"曲连兴", "褚光泉", "道姑",   "怪老头", "郁光标",
});

mapping query_quest()
{
    string name;
    if( random(4) == 0 )
	{
		name = medicine1[random(sizeof(medicine1))];
	    return
   		([      "quest":                "取" + name ,
        	    "time":                 500 + random(300),
            	"bonus":                3 + random(3),
	            "quest_msg":
"司空玄郑重地说：“无量派的家伙手上还是有点功夫的，要配厉害的\n"
"药才能对付，现在缺些重要的药物，嗯，你去弄些" + name + "回来。”\n",
                "reward_msg":
"司空玄一笑：“不错，有了这" + name + "本帮就又多了一分把握。\n",
        ]); 
	}
    if( random(4) == 1 )
	{
        name = npc1[random(sizeof(npc1))];
	    return
        ([      "quest":                "杀" + name,
                "time":                 400 + random( 400 ),
                "bonus":                4 + random(3),
                "quest_msg":
"司空玄沉思片刻道：“你去试试无量的家伙们手上的功夫怎样，\n" +
"估计左老头你打不过，你就杀个" + name + "吧，快去快回。”\n",
                "reward_msg":
"司空玄点头道：“看来无量派的功夫不怎么样啊！”\n",
        ]);
    }
    if( random(4) == 2 )
	{
		name = medicine2[random(sizeof(medicine2))];
	    return
   		([      "quest":                "取" + name ,
        	    "time":                 500 + random(300),
            	"bonus":                6 + random(5),
	            "quest_msg":
"司空玄神秘地一笑，说：“知己知彼才能百战百胜，我们得对无量派的\n" + 
"各种东西研究研究。听说无量派的" + name + "有些古怪，你去弄回来看看。”\n",
                "reward_msg":
"司空玄仔细看看" + name + "笑道：“" + name + "原来就是这么个东西，没什么古怪。\n”",
        ]); 
	}
    if( random(4) == 3 )
	{
        name = npc2[random(sizeof(npc2))];
	    return
        ([      "quest":                "杀" + name,
                "time":                 400 + random( 400 ),
                "bonus":                8 + random(6),
                "quest_msg":
"司空玄傲慢地说：“无量派的家伙狂妄自大，老夫有好生之德，\n" +
"你就杀了" + name + "给他们个警告，如果他们自断右臂退出剑湖宫，\n" +
"老夫可以放他们一条生路。”\n",
                "reward_msg":
"司空玄嘿嘿冷笑：“无量派的狗东西们现在该慌了手脚了罢！～”\n",
        ]);
    }
}
