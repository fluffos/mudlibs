#include <ansi.h>

inherit SKILL;

mapping *quest = ({
        ([      "quest":		"杀毒蛇",               
                "time":  		600,
                "bonus":                8,
                "quest_msg":            
"辛双清沉吟了一下：“听说近来后山上常有毒蛇出没，伤及人畜，\n"
"你就去把它杀死吧。”\n",
                "reward_msg":  	     
"辛双清用欣赏的眼光看着你：“看来你也是个可造之材呀，日后定会\n"
"好好栽培于你。”\n",
                "fail_msg":             
"辛双清对着你摇了摇头，说：“连这点事都做不好.....下去吧。”\n",
                "delay_msg":            
"辛双清似乎有些不满：“怎么现在才办好这件事？，你。。。”\n",
        ]),
        ([      "quest":                "杀衙役",
                "time":                 1000,
                "bonus":                10,
                "positive_score":       40,
                "quest_msg":
"辛双清看了你一眼，郑重地对你说：“大理衙门里那个衙役平常作威\n"
"作福，欺压百姓，鱼肉乡里，现在我命你下山去把他杀了，为大理百\n"
"姓除掉这个祸害！”\n",
                "reward_msg":
"辛双清大喜，对你说：“你能办成这件事，实乃大理黎民之福也，日\n"
"后我必将倾囊相授，令你成为武林奇葩！”\n",
                "fail_msg":
"辛双清叹了一口气，说：“那贼子果然厉害，也难怪你敌不过他，只\n"
"是，如此一来，那恶贼必将愈加猖獗，唉～～”\n",
                "delay_msg":
"辛双清舒了一口气：“你一去不返，我等均以为凶多吉少，如今你终\n"
"于杀掉那恶贼而平安归来，还属天助呀！”\n",
        ]),
        ([      "quest":                "杀关东刀客",
                "time":                 1000,
                "bonus":                12,
                "positive_score":       70,
                "quest_msg":
"辛双清突然想起了什么，急切地对你说：“速速下山除掉大理城中的\n"
"关东刀客，此人乃一名大盗假扮，意欲对我大理国不利，此事甚急，\n"
"你快点下山去办吧！”\n",
                "reward_msg":
"辛双清如释重负，欣然对你说，“所幸你及时除掉关东刀客，否则我\n"
"大理百姓又要遭受磨难了。”\n",
                "fail_msg":
"辛双清焦急地搓着双手，眉头紧皱，看着你叹了一口气说：“看来得\n"
"再派个人去。。。。要不然。。。”\n",
                "delay_msg":
"辛双清点了点头：“嗯，迟了一点，还好没出大事。”\n",
        ]),
/*        ([      "quest":                "杀冷锋",
                "time":                 2000,
                "bonus":                15,
                "positive_score":       80,
                "quest_msg":
"辛双清凝重地注视着你，小声对你说：“本门曾经有个叛徒，名叫冷锋\n"
"，很多年来四处搜捕他都不见踪影，最近有人告诉我，他就躲在大理城\n"
"内，隐姓埋名，你就下山去仔细寻访，若是发现他，即刻处死。”\n",
                "reward_msg":
"辛双清猛一拍膝盖：“太好了！  这个逆徒曾经作恶多端，败坏我无量\n"
"门风，但是行踪无定，所以一直找不到他，今天你终于为师门除去这个\n"
"恶徒，可谓师门之幸呀。”\n",
                "fail_msg":
"辛双清长叹道：“那个恶徒天资颇高，本是无量新一辈中的佼佼者，也\n"
"怪不得你敌不过他，但我对你期望确也过高了，唉～～”\n",
                "delay_msg":
"辛双清点点头：“嗯，你终于回来了，怎么那么费劲呢？看来杀这恶徒\n"
"确实比较棘手，花了那么多时间。”\n",
        ]),            */
        ([      "quest":                "取勾魂刀",
                "time":                 1000,
                "bonus":                12,
                "quest_msg":
"辛双清瞄了你一眼说：“有件事情看来只有派你去了，听说江湖上出现了一\n"
"把勾魂刀，你这就下山去寻访，取回来吧。”\n",
                "reward_msg":
"辛双清凝视着你递给他的勾魂刀，叹道：“果然是一把好刀呀！”\n",
        ]),             
/*         ([      "quest":                "取七星碧玉刀",
                "time":                 1500,
                "bonus":                10,
                "quest_msg":
"辛双清瞄了你一眼说：“有件事情看来只有派你去了，听说江湖上出现了一\n"
"把七星碧玉刀，你这就下山去寻访，取回来吧。”\n",
                "reward_msg":
"辛双清凝视着你递给他的七星碧玉刀，叹道：“果然是一把好刀呀！”\n",
        ]),             */
        ([      "quest":                "取「十八学士」",
                "time":                 1200,
                "bonus":                10,
                "quest_msg":
"辛双清笑了一声，说：“花园里缺几盆茶花，我听说「十八学士」乃是名花\n"
"你就下山去买一盆来吧。”\n",
                "reward_msg":
"辛双清点了点头说：“这「十八学士」果然是上品呀！”\n",
        ]),             
        ([      "quest":                "取「羽衣霓裳」",
                "time":                 1200,
                "bonus":                10,
                "quest_msg":
"辛双清笑了一声，说：“花园里缺几盆茶花，我听说「羽衣霓裳」乃是名花\n"
"你就下山去买一盆来吧。”\n",
                "reward_msg":
"辛双清点了点头说：“这「羽衣霓裳」果然是上品呀！”\n",
        ]),             
        ([      "quest":                "取「步步生莲」",
                "time":                 1200,
                "bonus":                10,
                "quest_msg":
"辛双清笑了一声，说：“花园里缺几盆茶花，我听说「步步生莲」乃是名花\n"
"你就下山去买一盆来吧。”\n",
                "reward_msg":
"辛双清点了点头说：“这「步步生莲」果然是上品呀！”\n",
        ]),             
        ([      "quest":                "取「恨天高」",
                "time":                 1200,
                "bonus":                10,
                "quest_msg":
"辛双清笑了一声，说：“花园里缺几盆茶花，我听说「恨天高」乃是名花\n"
"你就下山去买一盆来吧。”\n",
                "reward_msg":
"辛双清点了点头说：“这「恨天高」果然是上品呀！”\n",
        ]),            
        ([      "quest":                "取"BLU"鱼肠剑"NOR,
                "time":                 1600,
                "bonus":                40,
                "positive_score":       100,
                "quest_msg":
"辛双清说道：“听说有人在大理城得了一把宝剑，这等宝物若是落在\n"
"凡夫俗子手中，只怕会招人窥觑，若是被心术不正之徒拿到，势将为\n"
"他人，你这就下山去跑一趟吧。”\n",
                "reward_msg":
"辛双清接过宝剑，拉出匣中看了看点了点头道：“嗯，倒也难为你了\n"
"，先下去休息休息吧。“\n", 
                "fail_msg":
"辛双清皱了皱眉头沉吟道：“看来得我亲自下山一趟了。”\n",
                "delay_msg":
"辛双清接过剑来看了看，淡淡地说道：“这点小事都费这么长时间，\n"
"罢了，你先下去吧。”\n",
        ]), 
	([      "quest":                "取辣椒油",
                "time":                 2000,
                "bonus":                10,
                "quest_msg":
"辛双清想了想：“最近有很多川北武林中人来拜访我们无量，但总嫌这里的\n"
"饭菜不够味道。为师命你跑趟川北，取正宗的辣椒油回来。“\n",
                "reward_msg":
"辛双清点了点头：“好，十分及时，跑了这么远的路，一定累了，\n"
"下去歇歇吧。”\n",
                "fail_msg":
"辛双清看上去很不高兴，皱了皱眉头对你说：“下去歇着吧。”，嘴\n"
"里嘟囔着：“真是没用。。。。”\n",
                "delay_msg":
"辛双清很不高兴地看了你两眼，一言不发，又把身子转了过去。。。\n",
        ]), 
});


mapping query_quest()
{
        return quest[random(sizeof(quest))];
}
