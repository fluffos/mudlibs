#include <ansi.h>

int main(object who, string type) {
  string Top = GRN "\n         〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓" NOR;
  string Tops;

  switch (type) {
    case "sword":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”剑法英雄榜      " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "unarmed":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”拳法英雄榜      " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "blade":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”刀法英雄榜      " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "dodge":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”轻功英雄榜      " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "long":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”长兵刃英雄榜      " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "neili":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”内力英雄榜      " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "age":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”年龄英雄榜      " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "pker":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”恶人榜     " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "short":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”短兵刃英雄榜     " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "whip":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”鞭法英雄榜     " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "money":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”富人榜     " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    case "exp":
      {
        Top += YEL "\n         " + GRN "☆" NOR + YEL "      “笑傲江湖”经验英雄榜     " NOR + GRN "☆\n" NOR;
        Top += GRN "         ¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤¤\n" NOR;
        break;
      }
    default:
      {
        Top = HIG "	指令格式：top <参数>\n	目前有以下排行榜：\n" NOR;
        Top += HIW "	拳法	unarmed\n	剑法	sword\n	刀法	blade\n	轻功	dodge\n	长兵刃	long\n	短兵刃	short\n	鞭法	whip\n	内力	neili\n	年龄	age\n	钱财	money\n	经验	exp\n	杀人数	pker\n" NOR;
        write(Top);
        return 1;
      }
  }
  Tops = TOPTEN_D->topten_query(type);
  Top += Tops;
  Top += GRN "         〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓\n\n" NOR;
  write(Top);
  return 1;
}


int help() {
  write(@HELP

指令格式：top <参数>
<参数>也可以是英文，依次为unarmed，sword，blade，dodge，long，neili,age,pker,
观看目前这些功夫排名前十五的玩家。

HELP);
  return 1;
}

void do_nothing(string nothing) {
  return;
}
