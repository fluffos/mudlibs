// chfn.c
// Change Finger Info of Users...
//

object login_ob;

void create()
{
    seteuid(getuid());
}

int main(object me, string arg)
{
    login_ob = me->query_temp("link_ob");
    if ( !login_ob )
        return notify_fail("你没有login物件，无法改变finger信息。\n");
    printf("改变你的finger信息。\n\n");
    printf("以下信息都是可选的，你可以输入正确的或错误的信息，\n");
    printf("但是都会在别人finger你或者在www页面上显示。\n");

    printf("请输入你的真实姓名：");
    input_to( "GetRealName" );
    return 1;
}

void GetRealName(string name)
{
    if ( !name || name == "")
        name = "不告诉你";
    login_ob->set("real_name",name);
    printf("你的email地址：");
    input_to("GetEmail");
}

void GetEmail(string email)
{
    if ( email )
        login_ob->set("email", email);
    printf("你的主页：");
    input_to ("GetHomePage");
}

void GetHomePage(string url)
{
    if ( url )
    {
        if ( strlen(url) > 6 && lower_case(url[0..6]) != "http://" )
            url = "http://" + url;
        login_ob ->set("homepage",url);
    }
    printf("目前所在位置或者单位（比如，北京）：");
    input_to("GetLocation");
}

void GetLocation(string loc)
{
    if (loc)
    {
        login_ob->set("location",loc);
    }
    printf("联系方式（电话，住址等）：");
    input_to("GetAddr");
}

void GetAddr(string type)
{
    if (type)
        login_ob->set("contact",type);
    login_ob->save();
    printf("O.K.\n");
}

int help(object ob)
{
    printf("这个指令用来改变别人finger你时的信息。\n");
    return 1;
}

