// /cmds/comm/score.c
// Dispaly the infos of player(or npc)
//rewrited by qyz , modified by nerd 97/03/30
//rewrited by qyz 97/4/2
//modified by trill 05/15/97
//remodified by lin on March 21,1997
//modified by nerd 7/8/97 11 : 给xiuwei加上颜色。
//modified by lnwm 97/09/30 加zuzhi_score
// modified by xli 99/07/19 修正了修为的计算公式，加入了对family师傅的判断
#include <ansi.h>
#include <combat.h>
#include <marry.h>


inherit F_CLEAN_UP;

private string * xiuwei=
    ({ "unarmed","dodge","sword","blade","short","whip","long","zonggang"});
private string * xiuwei_chinese=
    ({ "拳  脚","轻  功","剑  术","刀  法","短兵刃","鞭  法","长兵刃",MAG"总  纲" NOR});
private string * gift_ranking =
    ({BLU"下 等", MAG"中 下", CYN"中 等",GRN"中 上", YEL"上 等",RED"特 等",HIW"绝 顶"});
private string * gift_types=
    ({"膂力","胆识","悟性","容貌","灵性","定力","机敏","根骨","福缘"});
private string * gifts=
    ({"str","cor","int","per","spi","cps","dex","con","kar",});

private mapping query_gifts(object);
private string get_xiuwei_color(int point,int jibie);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
    object ob;
    mapping my, my_gifts, fam, marry;
    string line, zuzhi_id, gender;
    int i, class_score, wiz_flag, age, death;

    seteuid(getuid(me));

    if ( !arg || me->id( arg ) )
        ob = me;
    else if (wizardp(me)||me->query("id")=="hoho")
    {
        ob = get_object( arg );
        if ( !ob || !ob->is_character() )
            return notify_fail("你要察看谁的状态？\n");
    }
    else 
        return notify_fail("只有巫师能察看别人的状态。\n");

    // dbase and xiuwei
    my = ob->query_entire_dbase();
    wiz_flag = (wizardp(me) && me->query("env/score") && wiz_level(me)>1);

    // general info
    line = " " + RANK_D->query_rank(ob);
    line +=ob->query("title");
    line +=" ";
    if(ob->query("nickname"))
        line+="["+ob->query("nickname")+"] " ;
    line += ob->short(1) + "\n";
    gender = my["gender"];
    age = (int)my["age"];
    line += sprintf(" 你是一%s%s岁的%s%s，%s生。\n",
        ob->query("unit"), chinese_number(age), gender, ob->query("race"),
        CHINESE_D->chinese_date((int)my["birthday"] ) );

    // add marriage info.
    if ( mapp(marry = ob->query("have_married")) )
    {
        if ( gender == "男性" )
        {
                if( ob->query("have_married/id") && 
                    ob->query("have_married/name") )
                    line+=" 你现已成家，你的爱妻是"+
                                        ob->query("have_married/name")+
                                    "("+ob->query("have_married/id")+")。\n";
                else
                        line+=" 你现已成家,行走江湖,不免多了一份羁绊。\n";
        }
        else if ( gender == "女性" )
        {
                if(ob->query("have_married/id")
                && ob->query("have_married/name") )
                    line+=" 你现已成家，你的夫君是"+
                                ob->query("have_married/name")+
                                "("+ob->query("have_married/id")+")。\n";
                else
           line+=" 你现在已经有了夫君，江湖之中，不免时常要为他牵肠挂肚。\n";
        }
    }
    else if ( gender == "男性" && age >= MIN_MALE_AGE )
    {
        line += " 你目前仍是一人独自闯荡江湖。\n";
    }
    else if ( gender == "女性" && age >= MIN_FEMALE_AGE )
    {
        line += " 你目前仍是一人独自闯荡江湖。\n";
    }
    // family info
    if ( mapp(fam = my["family"]) )
    {
        if( fam["master_name"] )
            line += sprintf( " 你已拜在"CYN"%s"NOR"的"CYN"%s"NOR"门下，是"CYN"%s"NOR
                "的第"CYN"%s"NOR"代弟子。\n",
                    fam["family_name"], fam["master_name"],fam["family_name"],
                    chinese_number(fam["generation"]) );
        else 
     line += sprintf( " 你已拜入了"CYN"%s"NOR"，是"CYN"%s"NOR"的第"CYN"%s"NOR"代弟子。\n",
    fam["family_name"], fam["family_name"],chinese_number(fam["generation"]) );
       
        if ( ob->query("family") )
        {
            class_score = ob->query( "class_score/" + fam["family_name"] );
        }
        else        // kick trill, kick 镖局
        {
            class_score = ob->query( "class_score/" + ob->query( "zuzhi/zuzhi_name" ) );
        }
        line += sprintf( " 你对你的师门有"CYN"%d"NOR"点的忠诚度。\n" ,
            class_score );
    }

    // zuzhi info (changed by lnwm)
    if ( ob->JoinedZuzhiNumber() > 0 )
    {
        for( i=0; i < ob->JoinedZuzhiNumber(); i++ )
        {
            zuzhi_id = ob->GetZuzhiId()[ i ];
            line += sprintf(
                " 你已加入"YEL"%s"NOR"，现在是一名"YEL"%s%s."NOR"\n",
                ob->ZuzhiName( zuzhi_id ),
                ob->ZuzhiZhiwu( zuzhi_id ),
                ob->ZuzhiTouxian( zuzhi_id ) );
        }
    }
    //加入组织信任度，苯带鱼的 group 没法 query。:(  ( by lnwm 97/09/30 )
    if ( ob->JoinedZuzhiNumber() > 0 )
    {
        for( i=0; i < ob->JoinedZuzhiNumber(); i++ )
        {
             line += sprintf(
                    YEL" "YEL"%s"NOR"对你的信任度有"CYN"%d"NOR"点。\n"NOR,
                    ob->ZuzhiName( ob->GetZuzhiId()[ i ] ),
                    ob->ZuzhiScore( ob->GetZuzhiId()[ i ] ) );
        }
    }

    // MKS & PKS
    line += sprintf(" 你亲手结束过%s个生命，其中包括"RED"%s"NOR"位玩家。\n",
        chinese_number(my["MKS"] + my["PKS"]), chinese_number(my["PKS"]) );
    death = (int)my["death"];
    if ( death )
        line += sprintf(" 你经历过%s次死亡，其中被玩家杀害了%s次。",chinese_number(death),chinese_number(my["PKED"]) );
    else
        line += sprintf(" 你还没有体会到死亡的痛苦。");

    // other info
    if ((int) my["bellicosity"])
        line += sprintf(" 仍有" RED "%d" NOR "点的杀气。", my["bellicosity"]);
    line += sprintf("\n 你有%d点实战经验,%d点江湖阅历,%d点正气和%d点戾气。\n",
            (int)my["combat_exp"], (int)my["social_exp"],
            (int)ob->query("positive_score") , (int)ob->query("negative_score") );

    line += "\n";
    // gifts,can this be modify better?too long
    my_gifts = query_gifts(ob);
    if ( wiz_flag || (int)ob->query("age") >= 14 )
    {
        for(i=0;i<sizeof(gifts);i++)
        {
            string ranking;
            int val = my_gifts[gifts[i]];;
            if ( val > 34 )
                ranking = gift_ranking[6];
//            if ( val > 29 )
//                ranking = gift_ranking[5];
            else if ( val < 10 )
                ranking = gift_ranking[0];
            else
                ranking = gift_ranking[(val-10)/4];
            if( wiz_flag ||ob->query("locker/super"))
                line+=sprintf(" %s：[%s"NOR"](%-2d)%s",
                    gift_types[i], ranking, val,
                    (i+1)%3?"    ":"\n");
            else
//                line+=sprintf(" %s：[%s"NOR"](%-2d)%s",
//                    gift_types[i], ranking, val,
                line+=sprintf( " %s：[%s"NOR"]%s",
                    gift_types[i], ranking,
                    (i+1)%3?"    ":"\n");
        }
        line += "\n";
    }
    // display xiuwei
    line+=" 你目前的各项修为列表如下：\n";
    for ( i = 0; i < sizeof(xiuwei); i++ )
    {
        int xiuwei_jibie;
        int xiuwei_point = (int) ob->query_xiuwei_by_type(xiuwei[i]);
       if (xiuwei_point<0)
       ob->set_xiuwei_by_type(xiuwei[i],0);
        xiuwei_jibie = (int) ob->query_xiuwei_jibie(xiuwei[i]);
        line += sprintf(" %s: %s%3s级" NOR,
                xiuwei_chinese[i],
                get_xiuwei_color(xiuwei_point,xiuwei_jibie),
                chinese_number(xiuwei_jibie) );
        if ( wiz_flag ||ob->query("locker/super"))
            line += sprintf("(%6d)",xiuwei_point);
        if ( i%2 )
            line += "\n";
        else
            line += "      ";
    }
    line+="\n";
    if (me->query("no_get"))
    me->delete("no_get");
    if (me->query("no_get_from"))
    me->delete("no_get_from");
    write(line);
    return 1;
}

private string get_xiuwei_color(int point,int jibie)
{
        //                       这里的修为计算点数原来有问题，导致score中显示不正确
        //                        0 100 200 300 500  800  1300 2100 3400 5500 
    int * xiuwei_interval = ({0,100,300,600,1100,1900,3200,5300,8700,14200,23100,37500 });
    string * colors = ({ "", MAG, BLU, CYN, GRN, YEL, RED });
    int i,jiange;
    if(jibie > 9 ) return "";
    jiange = ( xiuwei_interval[jibie+1] - xiuwei_interval[jibie] ) / sizeof(colors);
    for(i = 0; i<sizeof(colors); i++)
    {
        if( (point >= ( xiuwei_interval[jibie] + i * jiange )) &&
            (point < ( xiuwei_interval[jibie] + (i+1) * jiange )) )
            return colors[i];
    }
    return RED;
}

private mapping query_gifts(object ob)
{
    mapping l_gifts = allocate_mapping(sizeof(gifts));

    foreach (string g in gifts)
    {
        l_gifts[g] = (int)call_other(ob,"query_" + g);
    }
    return l_gifts;
}

int help(object me)
{
    write(@HELP
指令格式 : score

这个指令可以显示你的基本资料。
其中在修为中的颜色表示你修为的目前状态。
由无色变为粉红、蓝、青、绿、黄、红，表示你的修为正在逐渐上升。

see also : hp
HELP
    );
    return 1;
}
