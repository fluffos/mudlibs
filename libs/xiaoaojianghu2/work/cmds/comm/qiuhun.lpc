// qiuhun.c
// by trill 06/14/97



inherit F_CLEAN_UP;

int main(object me, string str)
{
    object ob, other;
    string my_gender, your_gender, msg, log_msg, *id, other_id;
    mapping prop;
    int i;

    if ( me->query( "will_marry" ) )
        return notify_fail( "你还是先认真准备自己的婚事要紧。\n" );

    if ( me->query( "gender" ) == "女性" )
    {
        if ( me->query( "have_married" ) )
        {
            write( "你已经嫁人了。\n" );
            return 1;
        } 
        prop = me->query_temp( "be_proposed" );
        if ( !prop ) 
            msg = "暂时还没人向你求婚。\n";
        else
        {
            id = keys( prop );
            msg = "现在向你求婚的有：\n";
            for( i = 0; i <sizeof( id ); i ++ )
                msg = sprintf( "%s    %s(%s)\n", msg, 
                    prop[ id[ i ] ], id[ i ] );
        }
        write( msg );
        return 1;
    }

    if (!str)
        return notify_fail( "指令格式：qiuhun <某个玩家的id>\n" );
    if ( !me->can_act() )
        return notify_fail( "你正忙着呢，还是先做完别的事吧。\n" );
    if ( me->query( "class" ) == "bonze" || me->query( "bonze" ) )
        return notify_fail("你也想求婚？和尚动凡心，菩萨会怪罪的！！！！。\n" );
    if ( me->query("gender") == "无性" )
        return notify_fail("你也想求婚？你好象少点什么吧，嘿嘿。你已经不是男人了啊！！！！。\n" );
    if ( me->query( "age" ) < 20 )
        return notify_fail( "还是等你到了二十岁，长大成人了，再考虑婚姻大事吧。\n" );
    if ( me->query( "have_married" ) )
        return notify_fail( "你小子胆子够大的，这么花心，结了婚还来凑这个热闹。\n" );
     
    // 好戏上演了...大家可以看热闹了 :-)
    if ( (ob = present( str, environment( me ) )) && userp(ob) )
    {
        my_gender = me->query( "gender" );
        your_gender = ob->query( "gender" );
        if ( my_gender == "男性" )
        {
            if ( your_gender != "女性" )
            {
                write( "有没有搞错啊，看仔细一点，那是女子吗？\n" );
                return 1;
            }
            if ( ob->query( "age" ) < 18 )
            {
                write( ob->name() + "的年纪也小了一点，等长成大姑娘，你再求婚也不迟啊。\n" );
                return 1;
            }
            if ( me->query_temp( "proposing" ) )
            {
                other_id = me->query_temp( "proposing" );
                if ( find_player( other_id ) )
                {
                    other = find_player( other_id );
                    if ( other != ob )
                    {
                        msg = me->name() + "改变主意了，不再向你求婚了。\n";
                        tell_object( other, msg );
                        other->delete_temp( "be_proposed/" + me->query( "id" ) );
                        if ( other->query_temp( "be_proposed" ) == ([]) )
                            other->delete_temp( "be_proposed" );  
                        // return 1;
                    }
                }
            }
            if ( stringp( msg = me->query( "env/qiuhun_msg" ) ) ) 
            {
                // 记录qiuhun_msg, 以后可以看看谁的最cool
                message_vision( msg, me, ob );
                log_msg = replace_string( msg, "$N", me->name() );
                log_msg = replace_string( log_msg, "$n", ob->name() );
                log_msg = sprintf( "        %s vs. %s\n%s\n", 
                    me->query( "id" ), ob->query( "id" ), log_msg );
                log_file( "nosave/QIUHUN_MSG", log_msg );
            }
            else
                message_vision( "$N勇敢的向$n跪下来，深情的注视着$n的双眸，说道：\n" +
                    "你是我今生唯一爱的、爱过的、会爱的人，" + ob->name() + "嫁给我吧，\n" +
                    "我们将是江湖最令人艳羡的一对的！\n", me, ob );
            tell_object( ob, me->name() + "向你求婚，如果愿意就点点头, 如果不同意就摇摇头，如果你太为难就不理他了，\n" + 
                "如果你想考验他的诚意，就提出个要求看看他能不能做到。\n" );
            me->set_temp( "proposing", ob->query( "id" ) );
            ob->set_temp( "be_proposed/" + me->query( "id" ), me->name() );
            return 1;
        }
        write( "你是男人吗？？\n" );
        return 1;
    }
    write( "你的身边有这个玩家吗？\n" );
    return 1;
}

int help(object me)
{
	write(@HELP
指令格式: qiuhun <玩家的 ID>

如果你是男性，这个指令是用来向和你在同一个房间的某个玩家求婚。
如果你是女性，这个指令可以看到现在有谁向你求婚。

相关的帮助：help marriage

HELP
	);
	return 1;
}


