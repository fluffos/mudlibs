

inherit F_CLEAN_UP;
void create()
{
    seteuid(getuid());
}

int main(object me)
{
    string msg;
    msg="你总共玩了"+FINGER_D->age_string( (int)me->query("mud_age"))+"。\n";
    me->start_more(msg);
    return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : mudage 
 
查看总共玩游戏的时间。
HELP
    );
    return 1;
}
 
