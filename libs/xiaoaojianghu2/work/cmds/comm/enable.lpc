//last change by akuma 1999/9/16

#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg) {
  mapping map;
  string *skills, skill;
  int i;

  seteuid(getuid());

  if (!arg) {
    map = me->query_enable_map();
    if (!mapp(map) || sizeof(map) == 0)
      return notify_fail("您现在没有设定任何用于战斗的技能。\n");

    skills = sort_array(keys(map), (: strcmp :));
    write("以下是您在战斗中使用的技能。\n");
    for (i = 0; i < sizeof(skills); i++) {
      printf("  %-45s\n",
        to_chinese(skills[i]) + HIY " 〖" + skills[i] + "〗" NOR);
    }
    return 1;
  }

  if (sscanf(arg, "%s", skill) != 1)
    return notify_fail("指令格式：enable <技能名称>\n");

  if (skill == "all") {
    map = me->query_jibie_map();
    if (!sizeof(map)) {
      write("对你来说用不用这个命令都没关系吧。\n");
      return 1;
    }
    skills = sort_array(keys(map), (: strcmp :));
    for (i = 0; i < sizeof(skills); i++)
      me->enable_skill(skills[i]);
    write("OK.\n");
    return 1;
  }

  if (!me->valid_skill(skill))
    return notify_fail("您不会这种技能。\n");
  if (!me->query_jibie(skill))
    return notify_fail("您不会这种技能。\n");
  if (SKILL_D(skill)->query_xiuwei_type() == "force") {
    if (me->query_temp("exercise_cost") || me->query_temp("jingxiu_cost"))
      return notify_fail("你正在修炼啦!\n");
    me->set("using_force", skill);
    printf(HIW "你决定以后使用  %-45s\n" NOR,
      to_chinese(skill) + HIY " 〖" + skill + "〗" NOR);


    //	 me->set("force",me->query("force"));
    //	 if(me->query_temp( "exercise_cost")||!random(10))
    //	 me->unconcious();
    return 1;
  }
  if (SKILL_D(skill)->is_knowledge())
    return notify_fail("这不是用于战斗的技能。\n");

  //    if ( !me->query_lingwu( skill ) )
  //	    return notify_fail("您还没有领悟这门武功呢。\n");

  if (SKILL_D(skill)->is_native_skill())
    return notify_fail("天生的技能不用 enable 就能使用。\n");

  if (!me->enable_skill(skill))
    return notify_fail("您还没有领悟这门武功呢。\n");

  //me->reset_action();
  write("您决定将 " + GRN + to_chinese(skill) + "(" + skill + ")" + NOR + " 这门武功用于实战和对练当中。\n");

  //    if ( ski == "force" )
  //	{
  //        write("您改用另一种内功，内力必须重新锻炼。\n");
  //        me->set("force", 0);
  //        me->receive_damage("kee", 0);
  //	}
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : enable <技能名称>

这个指令让您指定战斗要用的技能，不加参数则会显示出您目前所使用的技能名称。
 
HELP
  );
  return 1;
}
