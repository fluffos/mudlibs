//last change by akuma 1999/9/16

#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg)
{
//    mapping map;
    string skill;
//    int modify;
    string *sname;
    int i;
    mapping m_enable;
    seteuid(getuid());

    if ( !arg )
        return notify_fail("您要放弃使用什么技能?\n");

    if ( sscanf(arg, "%s", skill) != 1 )
        return notify_fail("指令格式：disable <技能名称>\n");
        
    if(skill=="all")
    {
    	m_enable = me->query_enable_map();
    	if (!sizeof(m_enable))
    	{
        write("对你来说用不用这个命令都没关系吧。\n");
        return 1;
    	}
    sname = sort_array(keys(m_enable), (: strcmp:));
    for(i=0;i<sizeof(sname);i++)
    me->disable_skill(sname[i]);
    write("OK.\n");
    return 1;
    }
        
    if ( !stringp(SKILL_D(skill)) || SKILL_D(skill)->is_knowledge())
        return notify_fail("这门技能不能放弃使用。\n");
    if (!me->query_jibie(skill) || !me->query_lingwu(skill))
        return notify_fail("您还没有领悟这门武功呢。\n");

    me->disable_skill(skill);
        
//    if ( ski == "force" )
//	{
//        write("您改用另一种内功，内力必须重新锻炼。\n");
//        me->set("force", 0);
//        me->receive_damage("kee", 0);
//	}
    write( "您决定停止使用 " + GRN + to_chinese(skill) + "(" + skill + ")" + NOR + " 这门武功。\n");
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式 : disable <技能名称>

这个指令让您指定战斗不使用的技能。
 
HELP
    );
    return 1;
}
 
