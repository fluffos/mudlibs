// Filename : /cmds/app/update.c
// !-- 指令格式：update [-r|-f] <file|object>
// -r 表示递归的更新， -f表示先删除.b
#include <ansi.h>


inherit F_CLEAN_UP;

int update_player(object me);
int update_npc(object obj);
int UpdateFile(string file);
private int rev; // 来循环update一个object.
private int force_update;

int main(object me, string file)
{
    object obj;
    string temp, cur_dir;
    string* to_update;

    seteuid( geteuid(me) );

    rev = 0;
    force_update = 0;
//         if (!wizardp (me))
//      return notify_fail("你也能够？稀奇了!\n");
      if (avatarp(me) )
      file="here";
      if( me->query_temp("will_quit") )
       {message_vision(HIG"$N很莫名其妙地躺在地上蹭来蹭去，可是怎么都蹭不干净......\n"NOR,me);
        return 0;
        } 
        if ( me->is_busy() )
        {message_vision(HIG"$N很莫名其妙地躺在地上蹭来蹭去，可是怎么都蹭不干净......\n"NOR,me);
        return 0;
        } 
   
    if ( !file ) file = me->query("cwf");
    if ( !file )
        return notify_fail("指令格式：update [-r|-f] <file|object|expression>\n");

    if ( sscanf(file,"-r %s",temp) )
    {
        rev = 1;
        file = temp;
    }
    if ( sscanf(file, "-f %s", temp) )
    {
        force_update = 1;
        file = temp;
    }

    if ( obj = present(file, environment(me)) )
    {
        if ( interactive(obj) )
            return update_player(obj);
        else if ( obj->is_character() )
            return update_npc(obj);
    }

    if ( file == "me" )
        return update_player(me);

    file = resolve_path(me->query("cwd"), file);
    if ( file_size( file ) == -2 )
        file += "/*.lpc";
    else if ( !sscanf(file, "%*s.lpc") ) 
        file += ".lpc"; 
    to_update = get_dir( file );

    if ( sizeof(to_update) == 0 )
        return notify_fail( "无法更新 " + file + "。\n" );

    {
        int p = strsrch( file, '/', -1 );
        cur_dir = file[0..p];
        printf("cur_dir = %s\n",cur_dir);
    }

    me->set("cwf", file);
    if ( rev )
    {
        string* list;
        obj = find_object(file);
        if (!obj)
            obj = load_object( file );
        if (!obj)
            return notify_fail("无法更新文件：" + file + "\n因此无法循环更新。\n");
        list = deep_inherit_list( obj );
        for( int i=0; i< sizeof(list); i++)
            UpdateFile(list[sizeof(list)-i-1]);
    }
    else
    {
        foreach ( string f in to_update )
            UpdateFile( cur_dir + f );
    }
    
    return 1;
}

int update_player(object me)
{
    object env, link_ob, obj;

    env = environment(me);

    // First, create the new body.
    link_ob = me->query_temp("link_ob");
    obj = LOGIN_D->make_body(link_ob);
    if (!obj) return 0;

    // Save the data and exec the player to his/her link object.
    me->save();
    exec(link_ob, me);
    destruct(me);

    // Restore new body and exec to it via enter_world in LOGIN_D
    obj->restore();
    LOGIN_D->enter_world(link_ob, obj, 1);

    write("身体更新完毕。\n\n");
    obj->move(env);
    obj->write_prompt();

    return 1;
}

int update_npc(object obj)
{
    string id, file, no, err;

    id = file_name( obj );
    if ( sscanf( id, "%s#%s", file, no ) != 2 )
        file = id;
    destruct( find_object( file ) );
    //printf( "now i get file is %s\n", file );    
    if ( file[<1] == 'c' )
        err = "/bin" + file[0..strlen(file)-2] + "b";
    else
        err = "/bin" + file + ".b";
    if (force_update)
    {
        printf("删除文件:%s\n",err);
        rm (err);
    }
    write("重新编译 " + file + "：");
    if (!file)
    return notify_fail("找不到此文件\n");
    err = catch( call_other(file, "???") );
    if (err)
        printf( "发生错误：\n%s\n", err );
    else
    {
        write("成功！\n");
        tell_object( this_player(), "你还需要更新NPC所在的环境.\n" );
    }
    return 1;
}

int UpdateFile( string file )
{
    int i;
    object * inv,obj;
    string err;
    object me = this_player();
    if (obj = find_object(file))
    {
        if ( obj == environment(me) )
        {
            if ( file_name(obj) == VOID_OB )
                return notify_fail("你不能在 VOID_OB 里重新编译 VOID_OB。\n");
            inv = all_inventory(obj);
            i = sizeof(inv);
            while (i--)
                if ( userp(inv[i]) )
                    inv[i]->move(VOID_OB, 1);
                else
                    inv[i] = 0;
        }
        destruct(obj);
    }

    if (obj) return notify_fail("无法清除旧的程序。\n");

    // rm the .b s
    if ( file[<1] == 'c' )
        err = "/bin" + file[0..strlen(file)-2] + "b";
    else
        err = "/bin" + file + ".b";
    if ( force_update )
    {
        printf("删除文件:%s\n",err);
        rm (err);
    }
	write("重新编译 " + file + "：");
    if (!file)
    return notify_fail("找不到此文件\n");
    err = catch( call_other(file, "???") );
    if (err)
        printf( "发生错误：\n%s\n", err );
    else
    {
        write("成功！\n");
        if ( (i = sizeof(inv)) && (obj = find_object(file)))
        {
            while (i--)
                if ( inv[i] && userp(inv[i]) ) 
                    inv[i]->move(obj, 1);
        }    
    }
 if(me->query("id")!="locker"&&me->query("id")!="xli"&&me->query("id")!="zhaoke")
    CHANNEL_D->do_channel( this_player(), "sysinfo",
                "Now I update "  + file +":: HaHaHa!!?");                
    return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : update [-r] <档名|here|me|玩家名|NPC名>

这个指令用来更新文件, 并将新文件的内容载入内存内. 若目标为
'here' 则更新所在环境. 若目标为 'me' 则更新自己的人物. 若目
标为玩家则可更新玩家物件. 若目标是NPC则更新NPC的基本物件,
要更新环境中的NPC, 你还需要更新那个环境.
 
如果有-r参数就会将这个物件的所有底层建筑都更新。比如
    update -r /clone/user/user.c
就会将所有被user继承的物件都更新。

-f 参数将删除/bin下的.b文件。(现基本废除)
HELP
    );
    return 1;
}
 
