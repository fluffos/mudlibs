// which.c
// find a command...
// todo: add entry for add_action...
// by nerd

int main(object me , string arg)
{
    string * path;
    string cmd;

    if ( ! arg )
        return notify_fail("指令格式: which <command>\n");

    path = me->query_path();

    if ( cmd = COMMAND_D->find_command(arg,path) )
    {
        printf("\n%s\n\n",cmd);
    }
    else
    {
        printf("没有这个指令。\n");
    }
    return 1;
}
