
#define TYPE_ATTACK     0
#define TYPE_DODGE      1
#define TYPE_PARRY      2



inherit F_CLEAN_UP;

int *power_ratio =
({
    0, 1, 11, 42, 122, 299, 677, 1440, 2976, 5934, 11598
});

int wugong_power(object, string, int);

int main(object me, string arg)
{
    string *wugong, target, skill, type, weapon_type;
    int power;
    object ob;
    string result;

    if ( !arg ) return 0;
    if ( sscanf( arg, "%s %s", target, skill ) != 2)
        return notify_fail("format error\n");
    if ( !objectp( ob = present( target, environment( this_player() ) ) ) )
        return notify_fail("Not find target.\n");
    if ( !ob->valid_skill( skill ) && skill != "kongshou" && skill != "wuqi" ) 
        return notify_fail("Not find this skill.\n");
    result = sprintf( "\n探测目标 ：%s , 武功 %s \n", (string)ob->name(), skill);
    if ( (int)ob->query_lingwu( skill ) )
    {
        type = SKILL_D( skill )->query_xiuwei_type();
        if ( !weapon_type = SKILL_D( skill )->query_weapon_type() )
            weapon_type = type;
    }
    else if ( skill == "kongshou" )
        type = "unarmed";
    else 
    {
        if ( ob->query_temp( "weapon" ) )
            type = ob->query_temp( "weapon" )->query( "skill_type" );
        return notify_fail( "目标没有武器。\n" ); 
    }
    result += sprintf("该项武功的修为类型是：%s \n", type);
    result += sprintf(type + "修为 = %d  修为等级 = %d \n",
        (int)ob->query_xiuwei_by_type( type ),
        (int)ob->query_xiuwei_jibie( type ) );
    result += sprintf("武学修为 = %d  修为等级 = %d \n",
        (int)ob->query_xiuwei_by_type( "zonggang" ),
        (int)ob->query_xiuwei_jibie( "zonggang" ));
    if (  wugong = ob->query_wugong_list( weapon_type ) )
    {
        result += sprintf("同修为的武功有：\n");
        for ( int i = 0; i < sizeof( wugong ); i ++ )
            result += sprintf("%15s 等级 %8d 领悟 %8d \n", wugong[ i ],
                SKILL_D( wugong[ i ] )->query_dengji(),
                (int)ob->query_lingwu( wugong[ i ] ) );
    }
    result += sprintf( "%s的实战经验：%d\n", ob->name(), (int)ob->query("combat_exp") );

    if( type == "dodge" )
    {
        power = COMBAT_D->wugong_power( ob, skill, TYPE_DODGE );
        result += sprintf( "%s使用"+skill+"来躲闪的power = %d \n", ob->name(), power);
    }
    else 
    {
        power = COMBAT_D->wugong_power( ob, skill, TYPE_ATTACK);
        result += sprintf( "%s使用"+skill+"来攻击的power = %d \n", ob->name(), power);
        power = COMBAT_D->wugong_power( ob, skill, TYPE_PARRY);
        result += sprintf( "%s使用"+skill+"来招架的power = %d \n", ob->name(), power);
    }
    write( result );
    return 1;
}

int wugong_power(object ob, string skill, int usage)
{
    int i ,j, power;
    int xiuwei, xiuwei_jibie;
    int wugong_dengji, wugong_dengji_temp;
    int wugong_lingwu;
    int skill_dengji;
    string type, *wugong,weapon_type;

    if ( !living( ob ) ) return 0;

    // combat_exp 提供的 wugong_power

    power = ob->query( "combat_exp" ) / 200;

    // 如果手持武器，攻防提高一点。
    if ( ob->query_temp( "weapon" ) ) power += 30;

    // 天赋对武功的影响
    switch ( usage )
    {
    case TYPE_ATTACK:
        power += ob->query_str()/2 + 1;
        break;

    case TYPE_DODGE:
        power += ob->query_dex()/2 + 1;
        break;

    case TYPE_PARRY:
        power += ob->query_cps()/2 + 1;
        break;
    }

    // 以下计算xiuwei提供的wugong_power
    // 这里的xiuwei是总修为。
    xiuwei = (int)ob->query_xiuwei_by_type( "zonggang" );
    xiuwei_jibie = (int)ob->query_xiuwei_jibie( "zonggang" ) + 1;
    power += xiuwei * xiuwei_jibie * xiuwei_jibie / 10;

    if ( skill == "kongshou" )
    {
        type = "unarmed"; 
        weapon_type = type;
        skill_dengji = 0;
    }
    else if ( skill == "wuqi" )
    {
        object weapon = ob->query_temp( "weapon" );
        type = weapon->query( "skill_type" );  
        weapon_type = weapon->query("weapon_type");
        skill_dengji = 0;
    }
    else
    {
        type = SKILL_D( skill )->query_xiuwei_type(); 
        weapon_type = SKILL_D( skill )->query_weapon_type();
        if( !weapon_type )
            weapon_type = type;
        //这样的话，对于不同的兵器，虽然修为是一样的，但是攻防将不加。
        //ACTION也将不用。
        skill_dengji = SKILL_D( skill )->query_dengji();
    }

    // 这里的修为是某种技能的修为
    xiuwei = (int)ob->query_xiuwei_by_type( type );
    xiuwei_jibie = (int)ob->query_xiuwei_jibie( type ) + 1;
    power += xiuwei * xiuwei_jibie * xiuwei_jibie * 2 / 5;

    // 以下计算技能产生的wugong_power       

    if ( undefinedp( ob->query_temp( "sort_wugong/" + weapon_type ) ) )
        ob->sort_wugong( weapon_type );
    wugong = ob->query_temp( "sort_wugong/" + weapon_type );
    
    if ( sizeof( wugong ) )
    {
        // ap依赖wugong_lingwu的(1+2/(wugong_dengji+1))次方的
        // 这样在xiuwei较低时，技能提供的power随着技能的提高能
        // 增长的更多。

        for ( i = 0 ; i < sizeof( wugong ); i ++ )
        {
            wugong_dengji_temp = wugong_dengji;

            wugong_dengji = SKILL_D( wugong[ i ] )->query_dengji();
            if ( skill_dengji < wugong_dengji )
                wugong_dengji = ( wugong_dengji + skill_dengji ) / 2;
            wugong_lingwu = (int)ob->query_lingwu( wugong[ i ] );
            // 计入有效级别
            wugong_lingwu = wugong_lingwu *
                SKILL_D( wugong[ i ] )->query_youxiao_jibie() / 10;

            if ( wugong_dengji < wugong_dengji_temp ) j = 0;
            j++;
            power += power_ratio[ wugong_dengji ] * wugong_lingwu
                * pow( wugong_lingwu / 60.0, 2.0 / ( wugong_dengji + 1 ) );
        }
    }

    // 调整攻防比的影响
    switch ( usage )
    {
    case TYPE_ATTACK:
        power = power * ob->query_gongfang() / 50;
        break;

    case TYPE_DODGE:
        power = power * ( 100 - ob->query_gongfang() ) / 50;
        break;

    case TYPE_PARRY:
        power = power * ( 100 - ob->query_gongfang() ) / 50;
        power = power * SKILL_D( skill )->query_parry_ratio() / 10;
        break;
    }

    // 实力比的影响
    power = power * ob->query_shili() / 100;

    if ( ob->is_busy() ) power /= 3;
    return power;
}
