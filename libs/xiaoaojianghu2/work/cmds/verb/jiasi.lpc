#include <ansi.h>
int main (object me)
{
    if( me->is_busy() ) return notify_fail( "你现在正忙着呢。\n" );
    if (me->query("age")<70)
	return notify_fail("只有老人才能享受此特权。^-^\n");
    message( "vision",me->name() + "突然仰天倒下，躺在地上一动不动了。\n",
        environment( me ),({ me }) );
    write( "你仰天躺在地上，摒住呼吸，开始装死。\n" );
    me->disable_player("< 假死中 >");
    me->remove_all_enemy ();
    me->remove_all_bihua ();
    me->remove_all_killer();
    me->set_temp("block_msg/all",1);
    me->set_temp("no_get",1);
    me->set_temp("no_get_from",1);
    call_out("revive",10,me);
    return 1;
}

int revive(object me)
{
 	me->enable_player();
    me->delete_temp("block_msg/all");
    me->delete_temp("no_get");
    me->delete_temp("no_get_from");
 	return 1;
}

int help (object me)
{
    write (@HELP
指令格式 : jiasi

老头子可以使用此指令装死

HELP
	);
    return 1;
}
