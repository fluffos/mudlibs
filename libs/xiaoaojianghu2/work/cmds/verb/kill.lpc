// kill.c
// rewrited by qyz

#include <ansi.h>



inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int main(object ppl, string arg) {
  object obj, here = environment(ppl);
  string callname;


  if (here->query("wiz"))
    return notify_fail(HIR "这是属于神的房间，不能用来练功\n" NOR);

  if (here->query("no_fight"))
    return notify_fail("这里不准战斗。\n");
  //    if(avatarp(ppl))
  //    return notify_fail( "先向 Locker 同学报告一下。\n" );
  if (here->query("no_kill") == 1)
    return notify_fail("这里不准杀人。\n");
  if (!arg)
    return notify_fail("你想杀谁？\n");

  if (!objectp(obj = present(arg, here)))
    return notify_fail("看清楚些，这里没有这个人。\n");

  if (!obj->is_character()
    || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (!living(obj)
    && obj->query("disable_type") == "<睡梦中>")
    return notify_fail("在光天化日之下杀一个正在睡觉的人？还是等他醒来再较量吧。\n");
  if (obj == ppl)
    return notify_fail("用 suicide 指令会比较快。:P\n");

  if (ppl->query_lianing())
    return notify_fail("练习时就想杀人，呵呵，你真行。\n");

  if (ppl->is_duilianing())
    return notify_fail("等对练结束了再杀人也不迟嘛。\n");
  if (ppl->query_temp("will_quit"))
    return notify_fail("你不是要退出了么？\n");
  callname = RANK_D->query_rude(obj);
  if (obj->query("locker/nopk") && obj->query("age") < 26)
    return notify_fail("你不要命了？他可是杀不得的！\n");
  //    if (userp(obj)&&!obj->query("high_mortal"))   
  //    	return notify_fail( "什么日子？春节哦，歇几天吧?这几天只能杀高级玩家了。\n" );     	
  if (userp(obj)) {
    if (ppl->query("peaceful"))
      return notify_fail("和平居民不可以杀其他玩家的。\n");
    if (obj->query("peaceful"))
      return notify_fail("杀和平居民会触犯王法，可是要全家抄斩的！\n");
    ppl->set("env/combat_brief", 0);
    if (newbiep(obj))
      return notify_fail("这么小的孩子你也杀？太残忍了。\n");
    if (newbiep(ppl))
      return notify_fail("你自己还需要人保护呢，就别动手杀人了。\n");
    if (time() - obj->query_temp("out_from_death") < 500 - obj->query("age") * 10)
      return notify_fail("他刚从地府出来呢，还是等会儿再杀他吧。\n");
    if (time() - ppl->query_temp("out_from_death") < 500 - ppl->query("age") * 10)
      return notify_fail("你刚从地府出来呢，还是休整一下再动手吧。\n");
  }

  message_vision("\n$N对着$n喝道：「"
    +callname + "！今日不是你死就是我活！」\n\n", ppl, obj);
  if (userp(obj)) {
    ppl->set_temp("beginkill", time());
    ppl->kill_ob(obj);
    obj->fight_ob(ppl);
    if (obj->query_temp("exercise_cost") || obj->query_temp("jingxiu_cost")) {
      message_vision(HIY "$N停止了修炼，慌忙应战。\n" NOR, obj);
      obj->delete_temp("exercise_cost");
      obj->delete_temp("jingxiu_cost");
    }
    if (ppl->query_temp("exercise_cost") || ppl->query_temp("jingxiu_cost")) {
      message_vision(HIY "$N停止了修炼，猛下杀手。\n" NOR, ppl);
      ppl->delete_temp("exercise_cost");
      ppl->delete_temp("jingxiu_cost");
    }
    if (!obj->is_killing(ppl->query("id"))) {
      /*   		 if(ppl->query_temp_marks("apply/name"))
            tell_object( obj, HIR"看来" + ppl->query_temp_marks("apply/name") 
                +"想杀死你，你如果想跟这个人性命相搏，不死不休,请你也对\n"
                "这个人下一个 kill 指令\n"NOR );     
                else 
*/ tell_object(obj, HIR "看来" + ppl->query("name")
        + "( " + ppl->query("id") + " )" +
        "想杀死你，你如果想跟这个人性命相搏，不死不休,请你也对\n"
        "这个人下一个 kill 指令\n" NOR);
    }

  } else if (!userp(obj)) {
    /*        if ( random(10)>5&& !(ppl->is_busy()) ) 
     {   
    message_vision( HIG "一位大侠正好路过，看见了$N的恶行，喝道：“是谁在撒野？！”\n" NOR, 
        ppl );
    message_vision( HIR "只见大侠一抬手，一把飞刀簌的飞向$N，$N突然觉得真气有些阻塞，看来不太妙！\n" NOR,ppl);
    ppl->set("eff_kee",ppl->query("eff_kee")*4/5);
//    ppl->start_busy(5);
        } 
        
  */ if (obj->refuse_killing(ppl))
      return 1;
    ppl->kill_ob(obj);
    obj->kill_ob(ppl);
    obj->remove_all_bihua();
    ppl->remove_all_bihua();
    obj->set("force_factor", obj->query("max_force") / 10);
    obj->set("force", obj->query("max_force"));
  }
  if (here->query("no_kill") && userp(ppl))
    CRIME_D->set_crime(ppl, here->query("no_kill"));
  return 1;
}

int help(object ppl) {
  write(@HELP
指令格式 : kill <某人> | sha <某人>
 
这个指令让你主动开始攻击一个人物，并且尝试杀死对方，由于 kill 只需要单方
面一厢情愿就可以成立，因此你对任何人使用 kill 指令都会开始战斗，通常如果
对方是 NPC 的话，他们也会同样对你使用 kill。

当有人对你使用 kill 指令时会出现红色的字样警告你，对于一个玩家而言，如果
你没有对一名敌人使用过 kill 指令，你将会反击直到将敌人打昏为止，当然，也
可能存在失手将对方打死的可能性。

其他相关指令: bihua( tiaozhan ), duilian, qiecuo( fight ) 

HELP
  );
  return 1;
}
