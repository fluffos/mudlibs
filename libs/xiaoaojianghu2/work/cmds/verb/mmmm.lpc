// clean.c
#include <weapon.h>
#include <ansi.h>


inherit F_CLEAN_UP;

int main( object me )
{   
    if (me->query("gender")=="女性"&&me->query("str")>20)
   { me->add("str",-1);
     me->add("dex",1);
     message_vision(GRN"$N轻轻地闭上双眼，默默的祈祷上天。\n"NOR, me);
     message_vision(GRN"$N忽然觉得身子轻盈了许多，莫不是真的有神仙？\n"NOR, me);     
     return 1;
    }
    else
    return 0;
}
