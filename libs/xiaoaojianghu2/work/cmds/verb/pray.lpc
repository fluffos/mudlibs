// pray.c
// 用来过年过节发礼物。

// by lnwm 98/01/25

#include <ansi.h>



inherit F_CLEAN_UP;

string * gift_type =
    ({"膂力","胆识","悟性","容貌","灵性","定力","机敏","根骨","福缘"});
string * gift=
    ({"str","cor","int","per","spi","cps","dex","con","kar" });

string * xiuwei_type =
    ({"刀法","剑术","拳脚","轻功","短兵刃","长兵刃","鞭法", "总纲" });

string * xiuwei =
    ({"blade","sword","unarmed","dodge","short","long","whip", "zonggang" });

int main(object me, string str)
{
//    int i;
    string my_family;
    
    my_family = me->query( "family/family_name" );

//    if( !environment( me )->query("pray_room") )
//    {
//        tell_object(me, "祈祷要虔诚，哪能象你这样随便找个地方？！\n");
//        return 1;
//    }
//    if (me->query("age")<15)
//    return notify_fail("还是等你长大点再说吧?\n");
    if ( str=="count")
    {
    	tell_object(me,"你目前已经使用了"+me->query("locker/pray")+"次祈祷。\n");
    	return 1;
     }
    if( !str || str == "" )
    {
        tell_object(me, "你要祈祷什么？(可以help pray)\n");
        return 1;
    }
if( me->query("locker/pray" ) > 2 )
    {
        tell_object(me, GRN"呵呵，就算是猴年了，也不能太贪心啊。:P \n");
        tell_object(me, "等下次过节吧。还有好多节要过呢。:)\n");
        return 1;
    }
    else if( member_array( str, gift ) + 1 ) 
    {
        me->add( str, 1 );
        me->add( "locker/pray", 1 );
        tell_object( me, CYN"你双手合十，默默祈祷着。。\n" +
                        "你忽然有种祥和的感觉，身体里好象发生了一些变化。\n"NOR);
        tell_object( me, MAG"你的" + gift_type[ member_array( str, gift) ] +
                        "增加了。\n"NOR);
        return 1;
    }
    else if( member_array( str, gift_type ) + 1 )
    {    
        me->add( gift[ member_array( str, gift_type ) ], 1 );
        me->add( "locker/pray", 1 );
        tell_object( me, CYN"你双手合十，默默祈祷着。。\n" +
                        "你忽然有种祥和的感觉，身体里好象发生了一些变化。\n"NOR);
        tell_object( me, MAG"你的" + gift_type[ member_array( str, gift_type ) ] +
                        "增加了。\n"NOR);
        return 1;
    }
    else if( str == "寿命" || str == "max_age" )
    {
        me->add("max_age", 1 );
        me->add( "locker/pray", 1 );
        tell_object(me, CYN"你双手合十，默默祈祷着。。\n" +
                        "你忽然有种祥和的感觉，身体里好象发生了一些变化。\n"NOR);
        tell_object(me, MAG"你的寿命延长了。\n"NOR);
        return 1;        
    }
    else if( str == "师门忠诚度" || str == "class_score" )
    {
        if( !me->query( "family" ) )
        {
            tell_object(me, "你还没拜过师呢。\n");
            return 1;
        }
        me->add( "class_score/"+ my_family , 100+random(200) );
        me->add( "locker/pray", 1 );
        tell_object(me, CYN"你双手合十，默默祈祷着。。\n" +
                        "你忽然有种奇怪的感觉，好象有人在你心里说话。\n"NOR);
        tell_object(me, MAG"你的师门忠诚度增加了。\n"NOR);
        return 1;
    }
    else if( member_array( str, xiuwei_type ) + 1 )
    {
        if( str == "总纲" )
            me->improve_xiuwei( xiuwei[ member_array( str, xiuwei_type ) ] , 30+random(20) );
        else    
            me->improve_xiuwei( xiuwei[ member_array( str, xiuwei_type ) ] , 20+random(30) );
        me->add( "locker/pray", 1 );
        tell_object( me, CYN"你双手合十，默默祈祷着。。\n" +
                        "你心中忽然一动，仿佛忽然明白了些什么。\n"NOR );
        tell_object( me, MAG"你的" + str +"修为增加了。\n"NOR);
        return 1;
    }
    else if( str == "实战经验" || str == "combat_exp" )
    {
        tell_object( me, CYN"你双手合十，默默祈祷着。。\n" +
                        "你心中忽然一动，仿佛忽然明白了些什么。\n"NOR);
        tell_object( me, MAG"你的实战经验增加了。\n"NOR);
        me->add( "locker/pray", 1 );
        me->add( "combat_exp", 3000 + random(1000) );
        return 1;    
    }
    else if( str == "杀人数"  )
    {
        tell_object( me, CYN"你双手合十，默默念叨着。。\n" +
                        "我忏悔，我再也不敢胡乱杀人了。\n"NOR);
        tell_object( me, MAG"你的恶行减少了。\n"NOR);
        me->add( "locker/pray", 1 );
        if (me->query("PKS")>3)
        me->add( "PKS", -2-random(2) );
        return 1;    
    }    
    else if( str == "死亡数"  )
    {
        tell_object( me, CYN"你双手合十，默默念叨着。。\n" +
                        "我和善良的来百姓，不该遭受这么多的杀戮啊……\n"NOR);
        tell_object( me, MAG"你的死亡次数减少了。\n"NOR);
        me->add( "locker/pray", 1 );
        if (me->query("death")>3)
        me->add( "death", -2-random(2) );
        return 1;    
    }      
    else if( str == "女人" || str == "媳妇" || str == "girl" || 
             str == "woman"|| str == "老婆" || str == "太太"  )
    {
        tell_object(me, MAG"呵呵。这个嘛。。咳。。嗯。。。\n");
        tell_object(me, "我们神仙自己还找不到呢。:PP :) \n");
        tell_object(me, "嘻嘻。。共同努力啦。\n"NOR);
        return 1;
    }
    else if ( str == "钱"  || str == "红包" || str == "利市" ||
            str == "money" || str == "gold" || str == "黄金" )
    {
  //      ob = new(MONEY_DIR"gold");
  //      ob->set_amount(100);
  //      ob->move(me);
 //       me->add( "locker/pray", 1 );
        tell_object(me, "哇！！！好多金子从天空掉了下来!但是掉到哪里去了呢? \n");        
        return 1;
    }  
    tell_object(me, GRN"这个。老兄，什么？别的还行……这个“"+str+"”我可没那么大的本事给你。\n"NOR);
    return 1;
}

int help(object obj)
{
  write(@HELP
指令格式 :  pray <内容> 或 pray count

你可以祈祷你想要的东西。比如增加你的天赋(膂力，悟性。。。)啦，
增加你的寿命(max_age)啦，让你的师傅更喜欢你(class_score)啦。。等等。。
或者你想不劳而获的一些武功的进境，还可以祈祷增加你的武功修为
（剑术，刀法。。)，或者实战经验。。，也可以是杀人数，死亡数等等。。。
祈祷的次数有限，要想好再祈祷哟。:)
HELP
    );
    return 1;
}
