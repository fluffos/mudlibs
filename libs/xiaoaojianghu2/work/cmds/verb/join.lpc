// filename: /cmds/verb/join.c
// attrib:指令  用以参加比武大会的报名
// write: xli
// date:  1999.6.25
// last modify:xli 1999.6.25
// For XO_Group
 
#include <ansi.h>
#include <biwu.h>
 


inherit F_CLEAN_UP;
 
int main(object me,string arg)
{
    string room;
    object tai=load_object("/d/place/biwu/biwutai");
 
    if ( !tai->query_temp("biwu/baoming"))
        return notify_fail( "现在不是报名时间，你不能去报名。\n" );
    
    if ( me -> is_busy() )
        return notify_fail( "你现在正忙着呢！\n" );
        
    if ( me -> is_fighting() )
        return notify_fail( "你先停下战斗再说。\n" );
    
    if ( me -> is_duilianing() )
        return notify_fail( "你还是先停止对练吧。\n" );
    
    if ( me -> is_ghost() )
        return notify_fail( "你现在是鬼耶！还是等还阳了再去吧:-)\n" );
    if("/cmds/app/xplor"->QueryLevel( me )<10000) 
                    return notify_fail( "你功夫不够，现在上台去比武是要被人笑话的。\n" );
    
    if ( objectp( environment(me) ) )
    {
        if ( !environment(me) -> query( "not_startroom" ) )
            room = file_name( environment( me ) );
        else
            return notify_fail( "你还是换个地方再去吧，现在这里人烟稀少:-)\n" );
    }
    else
        room = "/clone/misc/void";
    
    me -> set( "startroom" ,room );    
    
    write ( YEL"你决定报名参加这次比武大会。\n\n"NOR );
    message_vision ( GRN"只见空中飘来一朵白云，把$N围了起来。。。\n"NOR,me );
    if(me->query("hydra/desert/from")=="西域")
        me->move(BAOMING_ROOM2);
    else    
        me->move(BAOMING_ROOM);
        
    write( GRN"你只觉身体轻飘飘的不知到了何处，转眼间就落了下来。\n"NOR );
    message("vision", GRN"只见一阵烟雾散开，"+me->name()+"从里面走了出来。\n"NOR,environment(me),me );
    tell_object(me,"如果想回去，请使用ＢＡＣＫ指令。\n");
    return 1;
}   

