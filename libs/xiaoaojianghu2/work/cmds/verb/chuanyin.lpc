// shout.c

#include <ansi.h>



inherit F_CLEAN_UP;
int main(object me, string arg)
{
        if(!high_mortalp(me)&&!wizardp(me))
          return notify_fail("只有高级玩家才可以使用千里传音。\n");
        if(me->query("force") < 8000 )
                return notify_fail("以你目前的内力不够充沛，无法用澎湃内力千里传音。\n");   
        if (!arg) return notify_fail("你想要千里传音什么？\n");
        me->add("force", -7000);
        efun::shout( "\n" + HIW+HBRED + me->name() + "千里传音：" + arg + NOR + "\n");
        write(HIW+HBRED + "你千里传音：" + arg + NOR + "\n");
        return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : chuanyin <讯息>
 
这个指令让你将 <讯息> 用内力激发后，千里传音送出去, 所有正在游
戏中的人都会听见你的话。
HELP
    );
    return 1;
}
