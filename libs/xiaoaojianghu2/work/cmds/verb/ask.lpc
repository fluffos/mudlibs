// ask.c
// Changed by lala, on March 8, 1998
//主要是添加了对一些问题的回答，另外把自己问自己屏蔽掉了。

#include <ansi.h>



inherit F_CLEAN_UP;

int answer( object, object, string );

string *msg_dunno = ({
    "$n摇摇头，说道：“没听说过。”\n",
    "$n睁大眼睛望著$N，显然不知道$P在说什么。\n",
    "$n耸了耸肩，很抱歉地说：“无可奉告。”\n",
    "$n说道：“嗯……这我可不清楚，你最好问问别人吧。”\n",
    "$n想了一会儿，说道：“对不起，你问的事我实在没有印象。”\n"
});

// the following ask message are add by nerd 1997/03/08
string *ask_msg = ({
    "$N向$n打听有关“$T”的消息。\n",
    "$N对$n一拱手，道：“请问这位$R是否知道有关‘$T’的消息？”\n",
    "$N对$n说：“在下$W，请教这位$R是否听说过‘$T’？”\n"
});

int main(object ppl, string arg)
{
    string dest, topic, msg;
    object ob;
    //mapping inquiry;

    seteuid(getuid());

    if( !arg 
        || sscanf( arg, "%s about %s", dest, topic ) != 2 )
        return notify_fail("你要问谁什么事？\n");

    if( arg == ppl->query( "id" ) )
        return notify_fail("自己问自己？问了也没有用呀。\n");
    if( !objectp( ob = present( dest, environment(ppl) ) ) )
        return notify_fail("这里没有这个人。\n");

    if( !ob->is_character() )
    {
        message_vision("$N对著$n自言自语……\n", ppl, ob);
        return 1;
    }

    if( !ob->query( "can_speak" ) )
    {
        message_vision( "$N向$n打听有关‘" 
            + topic + "’的消息，但是$p显然听不懂$N的话。\n", ppl, ob );
        return 1;
    }

    if( !INQUIRY_D->parse_inquiry( ppl, ob, topic ) )
    {       
        msg = ask_msg[ random( sizeof( ask_msg ) ) ];
        msg = replace_string( msg, "$T", topic );
        msg = replace_string( msg, "$R", RANK_D->query_respect(ob) );
        msg = replace_string( msg, "$W",ppl->name() );
        message_vision( msg, ppl, ob );
    }
    if( !living(ob) )
    {
        message_vision( "但是很显然的，$n现在的状况没有办法给$N任何答覆。\n", 
            ppl, ob );
        return 1;
    }
    if( userp(ob) 
        && msg = (string)ob->query( "trill_ask/" + topic ) )
    {
        message_vision( msg, ob );
        return 1;
    }
    if( msg = ob->query("inquiry/" + topic) )
    {
        if( stringp(msg) )
        {
            message_vision( CYN "$N说道：“" + msg + "”\n" NOR, ob);
            return 1;
        }
        return 1;
    }

    //Qyz 增加回答功夫的内容
    if( !userp(ob) 
        && ( topic == "武功" 
        || topic == "功夫" 
        || topic == "skills" 
        || topic == "wugong" ) )
        return ob->tell_skills( ppl );

    if( topic == "name" 
        || topic == (string)ob->query( "id" ) 
        || topic == (string)ob->query( "name" ) 
        || topic == "姓名" )
    {
        message_vision( CYN "$N说道：“不敢不敢，"+ RANK_D->query_self(ob) + 
            "就是$N。”\n"NOR, ob, ob );
        return 1;
    }

    if( topic == "here"
        || topic == environment( ob )->query( "short" ) )
    {
        message_vision( CYN "$N看了看$n，道：“这里是" 
            + environment( ob )->query( "short" )
            + "啊，难道你不知道？”\n" NOR, ob, ppl );
        return 1;
    }

    if ( !ob->query_ask_answer( ppl, topic ) )
        message_vision(msg_dunno[random(sizeof(msg_dunno))], ppl, ob);

    return 1;
}

int help(object ppl)
{
   write( @HELP
指令格式：ask <someone> about <something>

这个指令在解谜时很重要, 通常必须藉由此一指令才能
获得进一步的消息。

HELP
   );
   return 1;
}
