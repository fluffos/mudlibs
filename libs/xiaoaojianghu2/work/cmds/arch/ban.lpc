/* /cmds/arch/ban.c
 * from xo lib
 * version @(#) 1.5@(#)
 * Last Modified by hydra 19991211
 *      给ban增加了一些功能，添加对于双登IP的处理
 *      增加ban ID
 */
 
#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string option,site;

    if (!arg)
        return notify_fail("指令格式错误：请参看help ban。\n");
    if (arg == "-s")
	{
		write (sprintf(CYN"目前被%s封禁的IP地址为：\n"NOR,mud_name()));
        return BAN_D->PrintSites();
	}
	
    if (arg == "-a")
	{
		write ( sprintf(CYN"目前%s中允许双登的IP地址为：\n"NOR,mud_name()));
		return BAN_D->PrintMultiAllow();
	}
	
    if (arg == "-d")
	{
		write (sprintf(CYN"目前%s中不允许双登的IP地址为：\n"NOR,mud_name()));
		return BAN_D->PrintMultiDeny();
	}
	
    if (arg == "-i")
	{
		write(sprintf(CYN"目前被%s封禁的ID为：\n"NOR,mud_name()));
        return BAN_D->PrintID();
	}
	
    if (sscanf(arg, "-%s %s",option,site) == 2)
    {
        switch (option)
        {
            case "s":
            {
                if ( BAN_D->AddSite(site) )
                {
                    log_file(BAN_LOG,sprintf("[%s] %s(%s)封禁IP %s\n",ctime(time())[4..15],
                        me->query("name"),getuid(me),site));
                    write(CYN"你把"+site+"这个IP封禁掉了。\n要解除封禁请修改"+BANNED_SITES+"文件。\n"NOR);
                }
                else
                    write("封禁失败。请参看help ban。\n");
                break;
            }
            case "i":
            {
                if ( BAN_D->AddID(site) )
                {
                    log_file(BAN_LOG,sprintf("[%s] %s(%s)封禁ID %s\n",ctime(time())[4..15],
                        me->query("name"),getuid(me),site));
                    write(CYN"你把"+site+"这个ID封禁掉了。\n要解除封禁请修改"+BANNED_ID+"文件。\n"NOR);
                }
                else
                    write("封禁失败。请参看help ban。\n");
                break;
            }            
            case "a":
            {
                if ( BAN_D->AddMultiAllow(site) )
                {
                    log_file(BAN_LOG,sprintf("[%s] %s(%s)修改multi.allow如下%s\n",ctime(time())[4..15],
                        me->query("name"),getuid(me),site));
                    write(CYN"你修改了multi.allow文件。\n要取消请修改"+MULTI_ALLOW+"文件。\n"NOR);
                }
                break;
            }
            case "d":
            {
                if ( BAN_D->AddMultiDeny(site) )
                {
                    log_file(BAN_LOG,sprintf("[%s] %s(%s)修改multi.deny如下%s\n",ctime(time())[4..15],
                        me->query("name"),getuid(me),site));
                    write(CYN"你修改了multi.deny文件。\n要取消请修改"+MULTI_DENY+"文件。\n"NOR);
                }
                else
                    write("修改失败。请参看help ban。\n");
                break;
            }
            default:
            {
                write("指令格式错误：请参看help ban。\n");
                break;
            }
        }
        
    }
    else write("指令格式错误：请参看help ban。\n");
    return 1;

}

int help(object me)
{
    me->start_more(@HELP
    
指令说明：这个指令有多个作用，报告封禁ＩＰ，封禁ＩＤ，设定允许（禁止）双登的ＩＰ

指令格式：ban -option [IP_list]

          参数option是你要选择的功能。含义如下：
                s   封禁ＩＰ。
                i   封禁ＩＤ
                a   设定允许双登的ＩＰ
                d   设定禁止双登的ＩＰ
          可选参数 IP_list根据参数option的不同有不同的格式，说明如下：
              如果option为s
                  缺省(不指明IP_list)为打印出被封禁的ＩＰ。
                  否则为要封禁的机器（主机名或者IP地址）
              如果option为i
                  缺省(不指明IP_list)为打印出被封禁的ＩＤ。
                  否则为要封禁的ＩＤ
              如果option为a
                  缺省(不指明IP_list)为打印出允许双登的ＩＰ。
                  否则为要设定的允许双登的ＩＰ，格式为：
                        ip:number_of_id
                    或者ip:id_list(以逗号格开)
                  例如：
                    ban -a 202.112.55.68:5               允许这个ip有5个人双登
                    ban -a 202.112.55.68:test1,test2     允许这个ip有test1和test2登陆                  
              如果option为d
                  缺省(不指明IP_list)为打印出禁止双登的ＩＰ。
                  否则为要设定的双登双登的ＩＰ。
               
        相关帮助:  BanHowTo
HELP
    );
    return 1;
}



