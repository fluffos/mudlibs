// perform.c



inherit F_CLEAN_UP;

int main(object me, string arg) {
  //    object weapon;
  string skill, action;
  //    int result;
  mapping m_enable = me->query_enable_map();

  seteuid(getuid());

  //反正combatd 会判断的，所以我们就不管了吧。
  //也许有些perform不管busy不busy都要有效，那就在skill的perform()里实现吧。
  //if ( me->is_busy() )
  //    return notify_fail("你上一个动作还没有完成，不能施展绝技。\n");

  if ((!arg) || (sscanf(arg, "%s.%s", skill, action) != 2))
    return notify_fail("指令格式：perform <武功种类>.<绝技名称> [<施用参数>]\n");
  notify_fail("你所使用的武功中没有这种功能。\n");

  if (!m_enable || !m_enable[skill])  // 否则会出value being index bye 0
    return notify_fail("你现在没有使用这门武功。\n");

  if (SKILL_D(skill)->perform_action(me, action)) {
    //使用perform对技术的增进先不考虑了。
    //if( random(120) < (int)me->query_lingwu(skill) )
    //    me->improve_jilei(skill, 1, 1);
    return 1;
  }
  return 0;
}

int help(object me) {
  write(@HELP
指令格式：perform <武功种类>.<绝技名称> <施用对象> [<施用参数>]

如果你所学的武功(拳脚、剑法、刀法....)有一些特殊的招式或
功能，可以用这个指令来使用，如：

     玉壁剑------------------月满乾坤
     一阳指------------------沙场点兵
     金刚掌------------------金刚显圣
     大雅剑------------------风雨如晦
     罗王棍------------------降妖除魔
    玉箫仙风-----------------天外清音
    寒烟素指-----------------飞花雪影
    胡家刀法-----------------威震八方
    燃木刀法-----------------草木皆兵
    太乙灵瀚-----------------剑心通明
    达摩剑法-----------------胜佛
    打狗棒法-----------------天下无狗
    六脉神剑-----------------气冲斗牛
    辟邪剑法-----------------刺目
    玉女剑法-----------------天女散花
    火焰刀-------------------火浴莲花

绝技的威力如下，降低对方的安全值，使对方受内伤(每回合减气血，必然)
和外伤(直接降气血，取决于命中)，并附有其他的特殊效果(比方说打散对
方的护体真气); 武功的本身等级越高，武功的熟练度越高，使用绝技的间
隔越短;绝技的命中率跟对方的轻功和自己的武术修为有极大的关系。

HELP
  );
  return 1;
}
