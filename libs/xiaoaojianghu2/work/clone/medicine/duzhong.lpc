inherit ITEM;



void create()
{
    set_name( "杜仲", ({"du zhong", "duzhong"}));
    set_weight( 200 );
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", query("name") + "是一种中药材。\n");
        set("unit", "包");
        set("value", 200 + random( 500 ) );
    }
}
