#include <ansi.h>
inherit ITEM;


void create() {
  set_name(HIB "板蓝根" NOR, ({ "ban langen", "yao" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一块板蓝根，看起来很好吃哦。\n");
    set("unit", "块");
    set("value", 1000);
  }
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me;
  me = this_player();
  if (!me->can_act()) return notify_fail("你现在无法吃东西。\n");
  if (!arg || this_object() != present(arg, me))
    return notify_fail("你要吃什么？\n");
  if (me->query_condition("ganmao") <= 4) {
    tell_object(me, "你从怀里掏出一块" + HIB "板蓝根" NOR + "，咬了一口，津津有味地吃了起来。\n");
    call_out("dest_me", 1, this_object());
    return 1;
  }
  //    return notify_fail("你从怀里掏出一块"+HIB"板蓝根"NOR+"，咬了一口，津津有味地吃了起来。\n"); 
  message_vision("$N从怀里掏出一块" + HIB "板蓝根" NOR + "，咬了一口，津津有味地吃了起来。\n", me);
  tell_object(me, HIG "你殷切地期待着感冒早点好，心里想着以后一定要多穿点衣服了。\n" NOR);
  call_out("dest_me", 1, this_object());
  me->apply_condition("ganmao", me->query_condition("ganmao") - 5);
  return 1;
}

void dest_me(object ob) {
  destruct(ob);
}
