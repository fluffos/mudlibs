// 片仔黄 /clone/medicine/pianzi_huang.c
// by lala, 1997-12-16

inherit ITEM;
inherit F_FOOD;



void create() {
  set_name("片仔黄", ({ "pianzi huang", "pianzihuang" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", query("name") + "是福建的一种名贵的补药。\n");
    set("unit", "包");
    set("value", 40000 + random(5000));
    set("food_remaining", 1);
    set("food_supply", 30);
    set("gifts", ([
      "kar": 100 * (random(3) - 1),
    ]));
  }
}
