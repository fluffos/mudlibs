// mmis from结婚喜字红包

inherit ITEM;
#include <ansi.h>


void create() {
  set_name(RED "喜字红包" NOR, ({ "hong bao", "hong", "bao" }));
  set("unit", "封");
  set("long", @LONG
[1;31;40m○●○●○●○●○●○●○●○●○●○●○●○●○[0m
[1;31;40m●                                              ●[0m
[1;31;40m○[0m    [1;33;40m恭贺新婚  永结同心  白头偕老  合家幸福[0m[1;31;40m    ○[0m
[1;31;40m●                                              ●[0m
[1;31;40m○●○●○●○●○●○●○●○●○●○●○●○●○[0m

祝你新婚快乐 ! !
LONG);
  set("no_give", 1);
  setup();
}

void init() {
  add_action("do_si", "si");
}

int do_si(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "红包" && arg != "hong bao"))
    return notify_fail("你要撕开什么啊？？？?\n");

  if (!me->can_act()) return notify_fail("你现在无法撕开红包。\n");

  if (arg == "红包" || arg == "hong bao") {
    if (query_temp_marks("hongbao_times") >= 1)
      return notify_fail(HIY "这个红包已经被撕开过了。:)\n" NOR);
    else {
      tell_object(me, YEL "你轻轻的撕开鼓鼓的红包。。。\n" NOR
        CYN "心里默默的许下对未来和爱情的祝福。。。\n" NOR);
      add_temp_marks("hongbao_times", 1);
      call_out("done_si", 2, me);
      return 1;
    }
  }
}

int done_si(object me) {
  object cash;
  tell_object(me, RED "哇！！！酷啊！！！从红包里掉出十张银票。。。\n" NOR);
  tell_object(me, HIG "XO全体玩家及巫师恭祝你：新婚大喜，心想事成 !\n" NOR);
  cash = new(MONEY_DIR + "thousand-cash");
  cash->set_amount(10);
  cash->move(me);
  return 1;
}
