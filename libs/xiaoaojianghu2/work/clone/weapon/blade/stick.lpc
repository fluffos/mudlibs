//standard weapon for stick
//stick.c
#include <weapon.h>
#include <ansi.h>
inherit STICK;


void create()
{
	set_name("木棍", ({"mu gun","wood gun","woodstick","gun","stick"}) );
	set_weight(1200);
	if( clonep() )
		set_default_object(__FILE__);
	else {               
	    set("long",@LONG
      一根三尺不到，手腕粗细的榆木棍子；靠近一头镶着一个铁圈，拴着一条油
    浸的麻绳。
LONG);
		set("unit", "根");
		set("value",12);
		set("material", "wood");
	}
	init_stick(5);
	set("wield_msg", "$N将一根$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n插入腰间。\n");
	setup();
}
