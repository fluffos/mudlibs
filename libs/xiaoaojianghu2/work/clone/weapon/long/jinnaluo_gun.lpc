//  少林紧那罗棍
//Xli 1998/10/14

#include <weapon.h>
#include <ansi.h>

inherit STAFF;



void create()
{
	set_name(YEL"紧那罗棍"NOR, ({ "jinnaluo gun","gun","long"}) );
	set_weight(1500);
        set("long","据说是少林棍法创始人紧那罗王用过的棍，一直流传至今。\n");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 800);
		set("material", "wood");
	}
	init_staff(65);
	set("wield_msg", "$N抽出一根$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n插在地上。\n");
	setup();
}
