// zhudao.c 竹刀
// 可以卖的竹刀，2两银子
// Write by Xli 1999.11.9
#include <ansi.h>
#include <weapon.h>

inherit STAFF;



void create()
{
        set_name(HIG"神秘棍"NOR, ({ "shenmi gun", "gun"}) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("value", 1000000);
                set("material", "bamboo");
                set("long", 
"这是一根神秘的棍，掂起来很有些沉，棍身乌黑，似乎充满了一种神秘的力量。\n");
                set("wield_msg", "$N从背后抽出一根棍子，握在手中。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
	init_staff(10);
        setup();
}
 
int query_autoload()
{
     if( !this_player() ) return 0;
     return 1;
}
int IsAutoLoad() { 
   
    return 1;
}