inherit ITEM;



void create()
{
    set_name( "银花", ({"yin hua"}));
    set_weight( 200 );
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", @LONG
这是一种河南特产的茶叶。
LONG
        );
        set("unit", "包");
        set("value", 500 + random( 800 ) );
    }
}
