// 紫笋茶 /clone/misc/zisun_cha.c

inherit ITEM;



void create()
{
    set_name( "紫笋茶", ({"zisun cha", "cha"}));
    set_weight( 200 );
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", @LONG
宜兴特产的紫笋茶相当有名，称为“阳羡唐贡茶”。
LONG
        );
        set("unit", "包");
        set("value", 2500 + random( 800 ) );
    }
}
