// tree.c
inherit TREE;
#include <ansi.h>
mapping *type = ({
    ([    "name"        : "李子树",
          "id"          : "lizi shu",
          "fruitname"   : FRUIT_DIR "lizi" ,
    ]),
    ([    "name"        : "柿子树",
          "id"          : "shizi shu",
          "fruitname"   : FRUIT_DIR "shizi",
    ]),
    ([    "name"        : "石榴树",
          "id"          : "shiliu shu",
          "fruitname"   : FRUIT_DIR "shiliu",
    ]),
});


void create()
{                 
    int i; 
//    string *typekey;
//    typekey = keys( type );
    i = random( sizeof( type ) );
    set_name(GRN + type[ i ] [ "name" ] + NOR, ({ type[ i ] [ "id" ], "shu","tree" }));
    set_weight(2000000);
    set_max_encumbrance(15000);
    set("unit", "棵");
    set("no_get","树是拔不起来的。\n"); 
    set("long","一棵生长在野外的"+type[i]["name"]+"\n");
    set("fruit",random(3) + 3 );
    set("fruitname",type[i]["fruitname"]);
    setup();
}    
int is_container()
{
    return 1;
}

int move( mixed dest ,int silent )
{
    int i;
    object guo;
    for( i = 0; i < sizeof( all_inventory( this_object() )); i++)
         destruct( all_inventory( this_object() )[ i ] );
    for( i = 0; i < query("fruit"); i++ )
    {
        guo = new( query("fruitname") );
        guo->move( this_object());
        guo->set("value",0);
    }
    return ::move( dest, silent );
}

    
