// 毛尖茶 /clone/misc/maojia_cha.c

inherit ITEM;



void create() {
  set_name("毛尖茶", ({ "maojian cha", "cha", "tea" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
这是信阳著名特产绿茶——毛尖。清香宜人。
LONG
    );
    set("unit", "包");
    set("value", 3000);
  }
}
