// by lnwm 981001

#include <ansi.h>

inherit ITEM;
private int IsBurn = 0;
private int BurnTime = 0;
private int BurnFlag = 0;
int IsBurn();
int CheckBurn(object ob, object me);
void dest(object ob, object me);

int IsFire() {
  return 1;
}


void create() {
  set_name("火折子", ({ "fire" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一支江湖人士常用的火折子。\n");
    set("unit", "支");
    set("value", 50);
  }
  BurnTime = 60;
  IsBurn = 0;
  BurnFlag = 0;
  setup();
}

void init() {
  add_action("do_burn", "burn");
}

int do_burn(string arg) {
  if (!arg)
    return notify_fail("你要点什么？\n");
  if (arg == "cancel") {
    BurnFlag = 1;
    IsBurn = 0;
    return notify_fail("你熄灭了火折子。\n");
  }
  if (arg != "fire")
    return notify_fail("你不能点这个。\n");
  else {
    message_vision(YEL "$N从怀中掏出一支火折子，迎风一展。\n"
      "一团橘黄色的火苗照亮了周围。\n" NOR, this_player());
    set_name("燃烧的火折子", ({ "fire" }));
    call_out("CheckFire", 1, this_object(), this_player());
    IsBurn = 1;
    //        printf("fire: %d.\n", IsBurn());
    return 1;
  }
  return 0;
}

int CheckFire(object ob, object me) {
  remove_call_out("CheckFire");
  if (BurnTime == 0) {
    call_out("dest", 1, ob, me);
    return 1;
  }
  BurnTime--;
  if (BurnFlag == 1) {
    BurnFlag = 0;
    set_name("火折子", ({ "fire" }));
    remove_call_out("CheckFire");
    return 1;
  }
  //    printf("FireRemaining.%d",BurnTime );
  call_out("CheckFire", 1, ob, me);
  return 1;
}

void dest(object ob, object me) {
  if (objectp(me))
    message_vision(BLK "火折子烧完了。\n" NOR, me);
  destruct(ob);
}

int IsBurn() {
  return IsBurn;
}
