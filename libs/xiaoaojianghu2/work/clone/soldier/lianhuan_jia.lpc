// standard soldieritem   lin 06/26/97

#include <armor.h>

inherit ARMOR;
#include <ansi.h>


void create()
{
    set_name(CYN"连环锁子甲"NOR, ({"lianhuan jia","jia", "armor", }) );
    set_weight(3000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
        set("long",@LONG
一套银光闪闪的铠甲，乃是用精钢打就的上千个钢环连接而成，既轻巧
通风，又结实耐用。是禁军军官们最喜爱的护身甲胄。
LONG);
        set("unit", "套");
        set("value",1000);
        set("cant_sell","官军的装备也来买卖，不要脑袋了么？！\n");
        set("material", "steel");
        set("armor_prop/armor", 4);
        set("armor_prop/defence", 10);
      
    }
    setup();
}
int is_soldier_use(object me)
{
    return 1;
}
