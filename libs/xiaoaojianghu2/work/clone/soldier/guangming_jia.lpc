// 汴京 ARMOR ：tiejia.c for soldier by lin on March 4, 1997
#include <armor.h>
inherit ARMOR;


void create()
{
        set_name("光明细铁甲", ({ "tie jia", "armor" ,"jia" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","禁军中统一制作的护心甲，家内垫有厚布，以免磨伤肌肤。\n");
                set("unit", "套");
                set("value",300); 
                set("cant_sell","官军的装备也来买卖，不要脑袋了么？！\n");
                set("material", "iron");
                set("armor_prop/armor", 4);
                set("armor_prop/defence", 4);
          
        }
        setup();
}
int is_soldier_use(object me)
{
    return 1;
}