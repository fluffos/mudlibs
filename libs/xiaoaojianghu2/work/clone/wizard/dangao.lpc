// 楚州金丝茶馓 /clone/eat/food/chasan.c
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;




void create() {
  set_name(HIR "生日蛋糕" NOR, ({ "shengri dangaon", "dangao" }));
  set_weight(50);  //一两
  set("long", @LONG
好大的生日蛋糕啊，看的人垂涎欲滴。
LONG
  );
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 55);
    set("food_remaining", 5);
    set("food_supply", -5);
    set("gifts", ([
      "per": 2,
      "int": 2,
    ]));
  }
  setup();
}
