#include <armor.h>
inherit ARMOR;


void create()
{
        set_name("骨头", ({"gu tou", "bone", }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一根骨头.\n");
                set("unit", "根");
                set("value",1000);
                set("material", "steel");
                set("armor_prop/armor", 4);
                set("armor_prop/defence", 10);
          
        }
        setup();
}
