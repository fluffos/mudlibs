
#include <ansi.h>

inherit ITEM;

//int do_fu( string arg );



void create()
{
	set_name( WHT"九花玉露丸"NOR, ({"yulu wan", "wan" }));
	set_weight(200);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", @LONG
江湖上有名的疗伤圣物--九花玉露丸，治疗内伤有奇效。
LONG
    );
		set("unit", "颗");
		set("value", 5000);
	}
	setup();
}

void init()
{
    add_action("do_fu", "fu");
}    

int do_fu( string arg )
{
    object me = this_player();
    if( !arg ||( arg != "yulu wan"  && arg != "wan" && arg !="yulu")      )
    {tell_object(me,"你要服用什么药物?\n");
    return 1;}
    if ( !me->can_act() )
    {tell_object(me,"你现在忙着别的事呢！\n");
    return 0;}
    if(!me->query_condition("performed"))
    {tell_object(me,"这么宝贵的丹药，你又没受伤，吃了岂不浪费！\n");
    return 1;}
    message_vision(YEL"$N摸出一粒"+WHT"九花玉露丸"NOR+YEL"，咕咚一下子就吞了下去。\n"NOR, me);
    message_vision(YEL"药力散发开来，$N不由的闭目运功吸纳，感到身体清爽，精神奕奕。\n"NOR, me);    
    me->clear_condition("performed");
    destruct(this_object());
    return 1;
}    