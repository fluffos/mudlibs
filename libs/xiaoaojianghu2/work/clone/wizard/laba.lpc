inherit ITEM;
int effect(object me);

#include <ansi.h>



void create()
{
    parse_init();
    set_name(WHT"腊八粥"NOR,({"laba zhou","zhou"}));
    set_weight(10);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long","一碗喷香的"+WHT"腊八粥"NOR+"，正冒着腾腾的热气。。。。。。");
        set("unit", "碗");
        set("value", 0);
        set("remaining", 10);
        set("drunk_apply",10);
    }
}

void init()
{
 add_action("do_drink", "drink");
}


int do_drink(string arg)
{
     object me;
     me = this_player();
     if(arg == "zhou"||arg == "laba zhou"){
     message_vision( HIW "$N双手捧着一碗"+WHT"腊八粥"NOR+HIW",嗅了嗅飘起的香气。\n"NOR,me);
     remove_call_out("effect");
     call_out("effect",5,me);
     return 1;
      }
     else 
     { write("你想喝什么？\n\n");
        return 1;
     } 
}
int effect(object me)
{     
   if(!objectp(me)) return 0;
   message_vision(HIM"$N毫不犹豫地喝一口，感觉味道很不错.\n"NOR,me);
    if (random(me->query_kar())>25&&!random(10))
    {
    if( me->query("locker/y2003") < me->query("age")/2)
    
    {me->add("max_force",random(me->query("max_force")/1000)+1);
    me->add("locker/y2003",1);
    message_vision( HIR "$N的身体正起着奇妙的变化。\n"NOR,me);
    }
    }
      return 1;
}
