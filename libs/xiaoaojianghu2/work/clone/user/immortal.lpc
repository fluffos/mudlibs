// Use a tick with longer period than heart beat to save cpu's work
private int bVisible    = 1;        // 1: 所有可见，0:巫师可见。
private string strShort = 0;



void create()
{
    // so LOGIN_D can export uid to us
    seteuid( 0 );
    set_name("使用者物件", ({ "user object", "user", "object" }) );
}

string query_save_file()
{
    string id;

    id = geteuid();
    if ( !id ) 
		id = getuid();
    if ( !stringp(id) ) 
		return 0;
    return
		sprintf( DATA_DIR "user/%c/%s", id[0], id );
}

int save()
{
    int res;

    save_autoload();
    res = ::save();
    clean_up_autoload();        // To save memory
    return res;
}

// Use this function to identify if an object is a character.
int is_character() { return 1; }

// setup: used to configure attributes that aren't known by this_object()
// at create() time such as living_name (and so can't be done in create()).
void setup()
{
    seteuid( getuid( this_object() ) );
    set_heart_beat( 1 );
    enable_player();
    CHAR_D->setup_char( this_object() );
    restore_autoload();
//    efun::add_action("FullMe",({"fullme"}));
//    efun::add_action("do_to", ({ "to" }));
}

void do_sth(string arg, string str)
{
    if ( ! str &&  ! arg )
        return;
    if( arg )
        command(arg + " " + str);
    else
        command(str);
}

int do_to(string arg)
{
    edit( (: do_sth, arg :) );
    return 1;
}

int FullMe()
{
    return "/cmds/imm/full"->main(this_object());
}

void heart_beat()
{
    remove_all_killer();
}

int is_ghost()
{   return 0;   }

int unshow(object who)
{
    if ( wizardp(who) || bVisible )
        return 0;
    return 1;
}

int visible(object ob)
{
    return 1;   // see every thing.... :)
}

int query_char_ratio( string type )
{
    if ( type != "gin" && type != "kee" && type != "sen" )
        error("STD_CHAR: 种类只能是 gin, kee, sen 其中之一。\n");
    return query( type ) * 100 / query( "max_" + type );
}

int query_char_eff_ratio( string type )
{
    if ( type != "gin" && type != "kee" && type != "sen" )
    error("STD_CHAR: 种类只能是 gin, kee, sen 其中之一。\n");
    return query( type ) * 100 / query( "eff_" + type );
}

int query_lingwu_ratio( string skill ){    return 100;  }

int query_jilei_ratio( string skill ){    return 100;   }

int query_gongfang(){   return 50;  }

int query_shili(){    return 50;    }

int query_combat_brief()
{
    int combat_brief;

    if( !userp(this_object()) )
        return 1;
    if ( undefinedp( query("env/combat_brief") ) ||
     !intp( query("env/combat_brief") ) )
    {
    combat_brief = 0;
    }
    else
    {
    combat_brief = query("env/combat_brief");
    }
    return combat_brief;
}

