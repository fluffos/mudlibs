}

// -- overrides ------------
string short(int raw)
{
    string str = name::short(raw);
    string mask = query_temp_marks("apply/short");
    
    if ( strShort )
    {
        if ( strsrch(strShort,"$N") >= 0 )
            str = replace_string(strShort, "$N", str);
        else
            str = strShort + " " + str;
        return str;
    }

    if ( sizeof( mask ) )
        str = (string)mask[ sizeof( mask ) - 1 ];
    else if (!raw)
    {
        string nick = query("nickname");
        if ( stringp( nick ) )
            str = sprintf( "「%s」%s", nick, str );
    }

    if ( !raw )
    {
        if ( is_ghost() )
            str = HIB "(鬼气) " NOR + str;
        else if ( query_temp( "netdead" ) )
            str += "断线了。";
        else if ( in_input() )
            str += "正在输入文字。"; 
        else if ( query_temp( "mask_exercising" ) )
            str += "正在修炼内力。";
        else if ( query_temp( "mask/dazuo" ) )
            str += "正在修炼内力。";
        else if ( in_edit() )
            str += "在编辑什么东西。";
        else if ( interactive( this_object() ) && query_idle( this_object() ) > 120 )
            str += "站在这里发呆。";
        if ( !living(this_player()) )
            str += HIR + query("disable_type") + NOR;
        // if NPC is not human, no title for it
        if ( query( "race" ) == "人类" && !sizeof( mask ))
        {
            string title = query("title");
            // if NPC has title, don't display zhiye
            // add for hms and wizad to free change title :)
            if (( !userp( this_object() ) ) && stringp( query( "title" ) ))
            {
                str = sprintf( "%s %s", query( "title" ), str );
            }
            else
                str = sprintf( "%s %s",RANK_D->query_zhiye(this_object()),str);
        }
    }
    return str;
}

protected void user_dump(int type)
{
}

// net_dead: called by the gamedriver when an interactive player loses
// hir network connection to the mud.
private void net_dead()
{
    object link_ob;

    set_heart_beat(0);
    if ( objectp(link_ob = query_temp("link_ob")) )
        destruct(link_ob);

    // Stop fighting, we'll be back soon.
    remove_all_enemy();

    set_temp("netdead", 1);
    if ( userp(this_object()) )
    {
        tell_room(environment(), query("name") + "断线了。", this_object());
        CHANNEL_D->do_channel(this_object(), "sys", "断线了。");
    }
}

// reconnect: called by the LOGIN_D when a netdead player reconnects.
void reconnect()
{
    set_heart_beat(1);
    set_temp("netdead",0);
    remove_call_out("user_dump");
    tell_object(this_object(), "重新连线返回。\n");
}

// process-input
private string process_input(string cmd)
{
	string ret = editor::process_input(cmd);
	if ( ret == "" )
		return "";
    if ( strsrch ( cmd, ';' ) != -1 )
    {
        string *arrCmd = explode(cmd,";");
        if ( sizeof(arrCmd) > 10 )
        {
            printf("指令个数太多。。不能大于10个。。\n");
            return "";
        }
        foreach (string s in arrCmd)
        {
            if ( s != "" )
                command(s);
        }
        return "";
    }
	return alias::process_input(cmd);
}

