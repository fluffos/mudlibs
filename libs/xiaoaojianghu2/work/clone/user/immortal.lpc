varargs int move(mixed dest, int silent)
{
    if ( ::move(dest,silent) )
    {
        if ( living(this_object())
            && interactive(this_object()) && !silent )
        {
            eventDescribeEnv(environment(), (int)query("env/brief"));
            environment()->welcome_visitor(this_object());
        }
        return 1;
    }
    return 0;
}

