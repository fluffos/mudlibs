// jianshu.c

inherit ITEM;



void create()
{
    set_name("「古文志」", ({ "guwen zhi", "book", "shu" }));
    set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("unit", "本");
        set("long","这本书封皮有点旧，上面写着「古文志」几个字。\n");
        set("value", 2000);
        set("material", "paper");
        set("skill", ([
            "name"             :  "literate",  
            "xiuwei_required"  : 0,
            "literate_required" : 100,
            "gin_cost"         : 40+random(10),
            "max_jibie"        : 200,
            "bonus_jilei"      : 50,
            "bonus_xiuwei"     : 2,
            "bonus_social_exp" : 20,
            "max_social_exp"   : 100000,
		]) );
	}
}
