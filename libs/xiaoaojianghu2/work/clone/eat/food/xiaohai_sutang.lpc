// 小孩酥糖 /clone/eat/food/xiaohai_sutang.c
// by lala, 1997-12-16

inherit ITEM;
inherit F_FOOD;



void create()
{
    set_name( "小孩酥糖", ({"xiaohai sutang","sutang"}) );
    set_weight( 20 );
    if ( clonep() )
            set_default_object( __FILE__ );
    else {
        set( "long", @LONG
一块样子象小婴孩的酥糖，是徐州的特产，号称“群酥之冠”。
LONG
        );
        set( "unit", "块" );
        set( "value", 200 + random (100) );
        set( "food_remaining", 1 );
        set( "food_supply", 5 );
    }
}
