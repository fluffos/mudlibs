inherit ITEM;
inherit F_FOOD;


void create()
{
    set_name("包子", ({"bao zi","bao"}));
    set_weight(150);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long", "一个热气腾腾的肉包子。\n");
        set("unit", "个");
        set("value", 500);//很便宜，（基本食物都应该很便宜）.
        set("food_remaining", 3);
        set("food_supply", 25);//正常饭量的人一顿吃二斤。
    }
}
