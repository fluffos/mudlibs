#include <ansi.h>
inherit ITEM;
inherit F_FOOD;



void create()
{
    set_name(WHT "白斩鸡" NOR, ({"baizhan ji", "ji"}));
    set_weight(1000);
    set("long", @LONG
这是南方最有名气的白斩鸡,肉美味鲜，滑嫩爽口。
LONG
    );        
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "盘");
        set("value", 3500);
        set("food_remaining", 9);
        set("food_supply", 40);
    }
    setup();
}
