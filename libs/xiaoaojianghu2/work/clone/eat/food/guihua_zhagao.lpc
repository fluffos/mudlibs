// 桂花楂糕 /clone/eat/food/guihua_zhagao.c
// by lala, 1997-12-16

#include <ansi.h>

inherit ITEM;

inherit F_FOOD;



void create()
{
    set_name( REV BRED YEL"桂花楂糕"NOR, ({"guihua zhagao", "zhagao"}) );
    set_weight( 50 );
    if ( clonep() )
            set_default_object( __FILE__ );
    else {
        set( "long", @LONG
酸甜可口，富有弹性的桂花楂糕，是徐州的土特产。
LONG
        );
        set( "unit", "块" );
        set( "value", 400 + random (10) );
        set( "food_remaining", 2 );
        set( "food_supply", 15 );
    }
}
