// 芝麻糖 /clone/eat/food/zhima_tang.c
// by lala, 1997-12-16

inherit ITEM;

inherit F_FOOD;



void create()
{
    set_name( "芝麻糖", ({"zhima tang", "tang"}) );
    set_weight( 50 );
    if ( clonep() )
            set_default_object( __FILE__ );
    else {
        set( "long", @LONG
这是常州乡下的土特产，香松脆甜，是馈赠亲友的佳品。
LONG
        );
        set( "unit", "包" );
        set( "value", 300 + random( 100 ) );
        set( "food_remaining", 2 );
        set( "food_supply", 5 );
    }
}
