inherit ITEM;
inherit F_LIQUID;



void create()
{
    //实际玩家买到应该是个茶壶。一开始是满的。
    set_name("富春茶",({"fuchun cha", "cha hu", "hu","cha"}));
    set_weight(100);
    if (clonep())
         set_default_object(__FILE__);
    else {
        set("long", "一壶新沏的富春茶，悠悠地冒着香气~~~~~~\n");
        set("unit", "壶");
        set("value", 400);

    }
    set("liquid", ([
        "type": "water",
        "name": "富春茶",
        "remaining": 10,
        "drunk_apply": 10,
    ]));
    set("max_liquid",40);
    setup();

}
