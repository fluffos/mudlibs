// 毛尖茶酒 /clone/eat/liquid/maojian_chajiu.c

inherit ITEM;
inherit F_LIQUID;



void create()
{
    set_name("毛尖茶酒", ({ "maojian chajiu", "chajiu" }));
    set_weight(300);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一个小小的装着毛尖茶酒的小酒壶。\n");
        set("unit", "壶");
        set("value", 1250 + random(500) );
        set("max_liquid", 20);
    }
    // because a container can contain different liquid
    // we set it to contain wine at the beginning
    set("liquid", ([
        "type": "water",
        "name": "毛尖茶酒",
        "remaining": 17,
        "drunk_apply": 10,
    ]));
}

void init()
{
    this_object()->delete("value");
    add_action("do_drink","drink");
}
