#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;



void create()
{
    set_name(YEL"糊涂仙"NOR, ({ "hutu xian", "jiu" }));
    set_weight(300);
    if (clonep())
        set_default_object(__FILE__);
    else 
    {
        set("long", "一个葫芦状的小酒壶，刻着几个小字..难得糊涂。\n");
        set("unit", "壶");
        set("value", 3500);
        set("max_liquid", 25);
    }
    // because a container can contain different liquid
    // we set it to contain wine at the beginning
    set("liquid", ([
        "type": "alcohol",
        "name": YEL"糊涂仙"NOR,
        "remaining": 9,
        "drunk_apply": 9,
    ]));
}

void init()
{
    this_object()->delete("value");
	add_action("do_drink","drink");
}
