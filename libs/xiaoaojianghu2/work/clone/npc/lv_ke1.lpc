//  标准中级旅客    /clone/npc/lv_ke1.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
//  ★
//  〖三级〗一级修为（  １０１－  １５０）一级武功（  ６０－１００）
//          经验（  ７５００－１５０００）声望（        ７５－       １５０）
//          内力（      ０－      ２００）体能、生命（  ２００－     ２５０）
//  By lin
//  Changed by lala, 1998-04-03

inherit NPC;



void create()
{
    set_name( comm_man_name(),  ({ "lv ke", "lvke", "lv", "traveller" }) );
    set( "title", "旅客" );
    set( "gender", "男性" );                //性别：男
    set( "age", 17 + random( 60 ) );        //年龄：17～76
    set( "positive_score", 75 + random( 36 ) );         //正声望：75～110
    set( "long", @LONG
    一名长途跋涉来到此地的旅客，脸上颇有风尘劳顿之态。
LONG
    );

    set_wugong( "unarmed",       85,     85,    1 );    //基本拳法：    一级

    set_xiuwei_by_type( "unarmed",  125 );  //拳脚修为：    一级

    set( "combat_exp", 7500 + random( 7501 ) );         //战斗经验：7500～15000

    set( "chat_chance", 6 );
    set( "chat_msg", ({
        (: random_move :)
    }) );

    setup();
    carry_object( CLOTH_DIR + "mancloth1" )->wear();    //一般服装
    add_money( "coin", query( "combat_exp" ) / 15 );    //五百至一千文铜钱
}
