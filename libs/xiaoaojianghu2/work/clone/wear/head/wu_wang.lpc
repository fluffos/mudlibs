#include <flower.h>



void create() {
  set_name(HIB "勿忘我" NOR, ({ "wu wangwo" }));
  set_weight(100);
  set("long", "一朵明丽的" + query("name") + "。\n");
  set("unit", "朵");
  set("value", 20);
  set("armor_prop/armor", 1);
  set("armor_type", "head");
  set("female_only", 1);
  setup();
}

int init() {
  add_action("do_wear", "wear");
  add_action("do_remove", "remove");
  add_action("do_smell", "smell");
  add_action("do_smell", "wen");
}
