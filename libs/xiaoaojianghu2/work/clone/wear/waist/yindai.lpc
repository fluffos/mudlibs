#include <ansi.h>
#include <armor.h>
inherit WAIST;


void create() {
  set_name("双搭尾龟背银带", ({ "yin dai", "yaodai", "waistband" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 1000);
    set("material", "silver");
    set("armor_prop/armor", 3);
    set("armor_prop/personality", 1);
  }
  setup();
}
