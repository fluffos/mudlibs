#include <armor.h>
inherit CLOTH;


void create()
{
    set_name("粗布僧衣", ({"cubu sengyi", "sengyi", "cloth" }) );
    set("long", "一件粗麻织就的粗布僧衣，虽然穿起来不很舒服，\n"
                "但结实耐磨，又透气吸汗，最要紧的是它便宜。\n");
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "套");
        set("material", "cloth");
        set("armor_prop/armor", 1);
    }
    setup();
}
