//Cloth :heibu_yi.c

#include <armor.h>
inherit CLOTH;



void create()
{
	set_name("黑布衣", ({ "heibu yi", "cloth"}) );
	set_weight(400);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("value", 100);
		set("unit", "套");
		set("material", "cloth");
		set("armor_prop/armor", 1);
	}
	setup();
}
