
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// AGENTS.md §8.1: this driver's strlen()/str[i] are codepoint-based,
	// not the raw-GBK-byte semantics this was originally written against
	// (str[i] used to be a lead byte, strlen>=2 used to mean "a full
	// 2-byte GBK pair"). Check the codepoint range of the first
	// character instead.
	if( !strlen(str) ) return 0;
	return str[0] >= 0x4e00 && str[0] <= 0x9fff;
}
