// tail.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string file, *lines;
	int n;

	seteuid(geteuid(me));
    if (!arg) return help(me);
	file = resolve_path(me->query("cwd"), arg);
	if( file_size(file)<0 ) return notify_fail("没有这个档案。\n");
	// AGENTS.md driver-compat fix: tail() was never a real efun on
	// MudOS/FluffOS -- reimplemented with read_file()+explode() since
	// this driver's read_file() has no "start from end" mode either.
	lines = explode(read_file(file), "\n");
	n = sizeof(lines);
	write( implode(lines[ (n>15 ? n-15 : 0) .. ], "\n") );
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : tail <档案>

此指令可让你(□)直接读取某档案最末尾的几行。
HELP
    );
    return 1;
}
