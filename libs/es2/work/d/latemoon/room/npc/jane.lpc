inherit NPC;
 
void create()
{
        set_name("娟姐", ({ "Jane","jane" }) );
        set("gender", "女性" );
         set("age",37);
        set("long", @TEXT
TEXT
);
        set("attitude", "peaceful");
       set("class", "dancer");
       set("combat_exp", 5000000);
       set("score", 7000);
        set_skill("unarmed",100);
        set_skill("dodge", 100);
        set_skill("force", 100);
        set("force", 7000);
        set("max_force", 7000);
        set("force_factor", 30);
        create_family("晚月庄", 1, "前辈");

        object ob;

        setup();
        // AGENTS.md §7.11/§7.25 guard shape: these items live under a
        // sibling d/latemoon/{obj,npc/obj}/ directory, not this file's
        // own __DIR__ (pre-existing content-tree drift); guard rather
        // than crash create().
        if( ob = carry_object(__DIR__"obj/deer_boot") ) ob->wear();
        if( ob = carry_object(__DIR__"obj/redbelt") ) ob->wear();
}

void attempt_apprentice(object ob)
{
     command("say 拜师! 不敢当，我都老了!你去找「芷萍」好了，看她收不收你? ");
     return 0;
}
