// atoi.c

int atoi(string str) {
  int v;

  if (!stringp(str) || !sscanf(str, "%d", v))
    return 0;
  return v;
}

string strip(string str) {
  string prefix, suffix;

  if (!stringp(str))
    return str;
  while (sscanf(str, "%s[%*sm%s", prefix, suffix) == 3)
    str = prefix + suffix;
  return str;
}
//这个函数替换到SQL语句的特殊字符，避免WEB出错。
string specialchars(string arg) {

  arg = replace_string(arg, "'", "’");
  return arg;
}
