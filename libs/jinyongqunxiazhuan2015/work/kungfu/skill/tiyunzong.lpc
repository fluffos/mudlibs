// tiyunzong.c 梯云纵

inherit SKILL;

mapping *action = ({
([	"action" : "$n往$N的胯下一钻，轻松躲了开去。\n",
	"dodge"  : 10
]),
([	"action" : "$n纵身一跃，竟然跳到$N的鼻尖稳稳立住。\n",
	"dodge"  : 20
]),
([	"action" : "$n微微一笑，蹦到$N的肩膀，还轻轻地摸了摸$N的耳朵。\n",
	"dodge"  : 30
]),
([	"action" : "$n身形随意一晃，就到了$N的屁股后面。\n",
	"dodge"  : 40
]),
([	"action" : "$n轻身一跳，踩在了$N的头顶上。\n",
	"dodge"  : 50
]),
([	"action" : "$n双目一瞪，$N吓得赶紧缩了回去。\n",
	"dodge"  : 60
]),
([	"action" : "$n一个喷嚏，$N立忙撤了回来。\n",
	"dodge"  : 70
]),
([	"action" : "只见$n一招「白鹤冲天」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
	"dodge"  : 80
]),
([	"action" : "$n一个「鹞子翻身」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
	"dodge"  : 90
]),
([	"action" : "$n使出「大鹏展翅」，向一旁飘然纵出，轻轻着地。\n",
	"dodge"  : 100
]),
});

mapping query_action(object me, object weapon)
{
	int zhaoshu, level;

	zhaoshu = sizeof(action);
	level   = (int) me->query_skill("tiyunzong");

	return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
	return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
	return 1;
}

string query_dodge_msg(string limb)
{
	object me, ob;
	mapping action;

	me = this_player();
	action = query_action(me, ob);

	return action["action"];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，不能练梯云纵。\n");
	me->receive_damage("qi", 20);
	return 1;
}
