//Cracked by Roath

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target)
{ int i;
	string weapon;
	object weapon1;
	int    lvl1, lvl2, amount;
  
  if ( (me->query("family/family_name") != "星宿派"))
	  	return notify_fail("你不是星宿派弟子，无法领会「无边无德」。\n");
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("无边无德只能对战斗中的对手使用。\n");

	weapon1 = me->query_temp("weapon");
        if( !objectp(weapon1) || weapon1->query("skill_type") != "staff" )
                return notify_fail("你手中无杖，如何施展无边无德？\n");
  if( me->query_skill("huagong-dafa", 1) < 80 )
		return notify_fail("你的化功大法修为不够，施展不出无边无德！\n");
	if( me->query_skill("tianshan-zhang", 1) < 80 )
		return notify_fail("你的天山杖法火候未到，无法施展无边无德！\n");

	lvl1=me->query_skill("force");

	lvl2=me->query_skill("staff");

	amount = (lvl1+lvl2) / 15;

	if ( amount < 40 ) amount = 40;
	if ( amount > 80 ) amount = 80;

	if( me->query("neili") <= amount*4 )
		return notify_fail("你的内力不够使用灵蛇出洞！\n");
	
	weapon = me->query_temp("weapon");
  
	me->add_temp("apply/damage", amount/4);
	me->add_temp("apply/attack", amount/3);
	me->add_temp("apply/dodge", amount/3);

	message_vision(HIC "\n$N怪叫一声「"+HIM"奸杀你老婆！"+HIC"」,手杖向$n霹雳般轰来！\n\n" NOR, me, target);
  i=random(2);
  if (i==1) {
	  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  else {
  	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	}
  me->start_busy(2);
	me->add_temp("apply/damage", -amount/4);
	me->add_temp("apply/attack", -amount/3);
	me->add_temp("apply/dodge", -amount/3);
	me->add("neili", -amount*2);
	return 1;
}
