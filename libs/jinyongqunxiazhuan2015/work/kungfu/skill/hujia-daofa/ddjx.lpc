#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int lvl1, lvl2, amount, count;

  if (!me->is_fighting())
    return notify_fail("「刀刀见血」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("neili") < 200)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("yunlong-shengong") < 60)
    return notify_fail("你的云龙神功还不够，无法领会胡家刀法的诀窍。\n");
  if ((int)me->query_skill("blade") < 60 ||
    me->query_skill_mapped("blade") != "hujia-daofa")
    return notify_fail("你的胡家刀法还不到家，无法使用「刀刀见血」！\n");

  lvl1 = me->query_skill("force");

  lvl2 = me->query_skill("blade");

  amount = (lvl1 + lvl2) / 15;

  if (amount < 40) amount = 40;
  if (amount > 80) amount = 80;
  me->add_temp("apply/damage", amount / 2);
  me->add_temp("apply/attack", amount);
  me->add_temp("apply/dodge", amount);
  msg = HIY "$N长啸一声“去死吧！”，一片刀光猛地劈了过来。\n" NOR;
  message_vision(msg, me);

  me->clean_up_enemy();
  ob = me->select_opponent();

  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
  me->add_temp("apply/damage", -amount / 2);
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/dodge", -amount);
  me->add("neili", -amount * 2);
  me->start_busy(1);

  return 1;
}
