//Cracked by RWZ
//jiujian.c 九剑合一 

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target)
{
	string weapon;
	object weapon1;
	int    lvl1, lvl2, amount;
  mapping my_fam  = me->query("family");
	if(userp(me) && !wizardp(me) && (string)me->query("family/family_name")!="华山派")
		return notify_fail("你不是华山派弟子，不能使用「九剑合一」。\n");
	
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「九剑合一」只能对战斗中的对手使用。\n");

	weapon1 = me->query_temp("weapon");
        if( !objectp(weapon1) || weapon1->query("skill_type") != "sword" )
                return notify_fail("你手中无剑，如何使得「九剑合一」？\n");
  if( userp(me) && !wizardp(me) && me->query_skill("zixia-shengong", 1) < 120 )
		return notify_fail("你的紫霞神功修为不够，施展不出「九剑合一」！\n");
	if( me->query_skill("dugu-jiujian", 1) < 120 )
		return notify_fail("你的独孤九剑火候未到，无法施展「九剑合一」！\n");

	lvl1=me->query_skill("force");

	lvl2=me->query_skill("sword");

	amount = (lvl1+lvl2) / 15;

	if ( amount < 40 ) amount = 40;
	if ( amount > 80 ) amount = 80;

	if( me->query("neili") <= amount*4 )
		return notify_fail("你的内力不够使用九剑合一！\n");

	weapon = me->query_temp("weapon");

	me->add_temp("apply/damage", amount/2);
	me->add_temp("apply/attack", amount);
	me->add_temp("apply/dodge", amount);

	message_vision(HIM "\n$N大吼一声「"+HIW"干你娘！"+HIM"」,顷刻间向$n一连攻出九剑！\n" NOR, me, target);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	me->start_busy(1);
	me->add_temp("apply/damage", -amount/2);
	me->add_temp("apply/attack", -amount);
	me->add_temp("apply/dodge", -amount);
	me->add("neili", -amount*2);

	return 1;
}
