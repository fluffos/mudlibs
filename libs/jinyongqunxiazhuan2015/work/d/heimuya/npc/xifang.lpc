#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("西方失败", ({ "xifang shibai", "xifang", "shibai" }));
  set("nickname", RED "屡战屡败" NOR);
  set("gender", "女性");
  set("age", 33);
  set("long",
    "她是个风骚的女人，由于屡战屡败，因此有一称号为「西方失败」。\n");
  set("attitude", "peaceful");

  set("str", 10);
  set("int", 10);
  set("con", 10);
  set("dex", 10);

  set("chat_chance", 10);
  set("chat_msg", ({
    "西方失败叹了口气道：“唉 …… 奴家屁眼好痒，谁能帮奴家舔舔？”\n",
  }));
  set("inquiry", ([
    "东方不败": "奴家是西方失败。\n",
    "西方失败": "不要嘲笑奴家了。\n",
  ]));

  set("qi", 1);
  set("max_qi", 1);
  set("jing", 1);
  set("max_jing", 1);
  set("neili", 0);
  set("max_neili", 0);
  set("jiali", 0);
  set_skill("throwing", 1);
  set("combat_exp", 0);
  set("score", 0);
  create_family("日月神教", 2, "性奴");

  setup();
  carry_object(__DIR__ "obj/kuihuazhen")->wield();
  carry_object(__DIR__ "obj/hongchouxiaoshan")->wear();

}

void attempt_apprentice(object ob) {
  if (ob->query_int() < 30) {
    command("say 我不收悟性差的弟子，您请回吧！\n");
    return;
  }

  command("say 很好，很好。\n");
  command("recruit " + ob->query("id"));
}
