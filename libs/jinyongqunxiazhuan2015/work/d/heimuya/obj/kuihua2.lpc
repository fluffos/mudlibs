inherit ITEM;
inherit F_UNIQUE;
 
void create()
{
        set_name("「葵花宝典」下册", ({ "kuihua baodian2","book", }));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
             set("long",
        "这是一本用薄绢写成的书。上书：“「葵花宝典」下册”。\n"
        "书皮泛黄，看来已经保存很久了。\n",

        );
                set("value", 0);
                set("material", "silk");
                set("skill", ([
                        "name":       "kuihua-xinfa",
		"exp_required":1000,
                        "jing_cost":  60,
                        "difficulty": 20,
                        "max_skill":  30
                ]) );
        }
}
