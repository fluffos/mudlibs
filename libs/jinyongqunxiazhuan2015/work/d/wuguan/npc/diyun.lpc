#include <ansi.h>
inherit NPC;

void create ()
{
	set_name("狄云", ({"di yun","di"}));
	set("long", "他长脸黝黑，颧骨微高，粗手大脚，腿有点瘸，象是湘西乡下常见的庄稼汉子。\n");
	set("gender", "男性");
	set("nickname",HIG"瘸腿侠"NOR);
	set("age", 24);
	set("combat_exp", 900000);
	set("str", 24);
	set("int", 15);
	set("dex", 18);
	set("con", 25);
	set("per", 15);
  set("shen", 300000);
  set("neili",3000);
  set("max_neili",2300);
  set("jiali",100);
  set("jingli",180);
  set("max_qi",2100);
  set("qi",2100);
  set("food",340);
  set("water",340);
  set("max_jingli",180);
	set_skill("force", 200);
	set_skill("unarmed", 200);
	set_skill("dodge", 200);
	set_skill("blade", 200);
	set_skill("yanfly", 200);
	set_skill("shenzhao-jing", 200);
	set_skill("literate",50);
	set_skill("xue-dao", 200);
	map_skill("force", "shenzhao-jing");
	map_skill("blade", "xue-dao");
	map_skill("parry", "xue-dao");
	map_skill("unarmed", "shenzhao-jing");
	map_skill("dodge", "yanfly");
	set("inquiry", ([
		"水笙" : "你知道水笙姑娘在哪里么？我好想念她……",
	]));
	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "blade.shendao" :),
		(: exert_function, "recover" :),
	}) );
	setup();
	create_family("连城武馆", 3, "馆主");
	carry_object("/d/city/obj/cloth")->wear();
	carry_object("/d/wuguan/obj/xuedao")->wield();
}
void attempt_apprentice(object ob)
{
	command("say “好吧，我就收你为徒弟了！”");
	command("recruit " + ob->query("id"));
}