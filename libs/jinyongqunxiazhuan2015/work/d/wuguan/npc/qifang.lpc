inherit NPC;

void create()
{
set_name("戚芳",({ "qi fang", "qi", "fang" }) );
        set("gender", "女性");
        set("age", 18);
        set("long", 
          "她脸蛋好看，身材很苗条。\n");
	set("combat_exp", 3000);
	set("shen_type", 1);
        set("per", 26);
		set("str", 19);
        set("dex", 21);
        set("con", 19);
        set("int", 18);
        set("attitude", "friendly");
        set("qi", 450);
        set("max_qi", 450);
        set("neili", 200);
        set("max_neili", 200);
        set_skill("force",40);
        set_skill("unarmed",40);
		set_skill("sword",40);
        set_skill("literate",40);
		set_skill("huashan-jianfa",40);
		set_skill("parry",40);
        set_skill("dodge",40);
		map_skill("sword","huashan-jianfa");
        map_skill("parry","huashan-jianfa");
		set("inquiry", ([
		"万圭" : "他是小女子的情郎。",
		"狄云" : "我已经把他忘记了。",
	]));
	
	setup();
	create_family("连城武馆",3,"弟子");
 carry_object("/d/city/obj/changjian")->wield();
  carry_object("/d/city/npc/obj/pink_cloth")->wear();
	add_money("silver", 90);
}
void attempt_apprentice(object ob)
{command("say 小女子哪有资格收徒弟啊？");}