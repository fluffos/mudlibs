// jingyu.c 鲸鱼

inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name("鲸鱼", ({"jingyu", "fish"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "这是一条从海洋里捕来的大鲸鱼。\n");
		set("value", 100000);
	}
	setup();
}

int do_eat(string arg)
{
	if (!id(arg))
		return notify_fail("你要吃什么？\n");
	if ((int)this_player()->query("food") >=(int)this_player()->query("max_food") && (int)this_player()->query("water")>=(int)this_player()->query("max_water"))
		return notify_fail("你已经吃得太饱了。\n");
	else {
		this_player()->add("food", 10000);
		this_player()->add("water",10000);
		message_vision("$N将一条大鲸鱼吃得干干净净。\n", this_player());
		destruct(this_object());
		return 1;
	}
}

