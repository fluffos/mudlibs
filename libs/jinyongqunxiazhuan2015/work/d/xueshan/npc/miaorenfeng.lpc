// miaorenfeng.c
#include <ansi.h>
inherit NPC;
void do_kill(object ob);

void create()
{
	set_name("苗人凤", ({"miao renfeng", "miao", "renfeng"}));
	set("gender", "男性");
	set("nickname", HIY"金面佛"NOR);
	set("age", 45);
	set("long", 
		"他就是江湖上鼎鼎大名的苗人凤大侠，因其武功绝顶，\n"
		"在江湖上人送外号「金面佛」。\n");
	set("attitude", "heroism");
	set("shen",300000);
	set("str", 40);
	set("int", 30);
	set("con", 30);
	set("dex", 28);
	set("chat_chance", 30);
	set("chat_msg", ({
		"苗人凤叹了口气道:“胡一刀才是天下第一高手！”\n",
	}));
	set("shen",100000);
	set("qi", 3000);
	set("max_qi", 3000);
	set("jing", 1000);
	set("max_jing", 1000);
	set("jingli",500);
	set("max_jingli",500);
	set("neili", 5000);
	set("max_neili", 4000);
	set("jiali", 100);
	set("combat_exp", 1500000);
	set("score", 20000);
	set("food",800);
	set("water",800);
	set_skill("force", 180);             // 基本内功
	set_skill("miaojia-jianfa", 190);    // 苗家剑法	
	set_skill("sword", 190);           // 基本剑法
	set_skill("literate",50);
	set_skill("hunyuan-yiqi", 150);   // 混元一气功
	set_skill("dodge", 180);           // 基本躲闪
	set_skill("shaolin-shenfa", 180);   // 飞狐身法
	set_skill("parry", 170);         // 基本招架
	set_skill("cuff",150);
	set_skill("jingang-quan",150);
	map_skill("force", "hunyuan-yiqi");
	map_skill("cuff", "jingang-quan");
	map_skill("sword", "miaojia-jianfa");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("parry", "miaojia-jianfa");
	prepare_skill("cuff", "jingang-quan");
 
  set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "sword.jingtian" :),
		(: exert_function, "recover" :),
	}) );
	setup();
	carry_object("/d/city/obj/gangjian")->wield();
  carry_object("/d/city/obj/cloth")->wear();
 
}
