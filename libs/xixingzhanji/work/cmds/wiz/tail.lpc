// tail.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string file;

	seteuid(geteuid(me));
    if (!arg) return help(me);
	file = resolve_path(me->query("cwd"), arg);
	if( file_size(file)<0 ) return notify_fail("没有这个档案。\n");
	// AGENTS.md §8e: tail() was never a real FluffOS efun -- reimplement
	// in plain LPC (last 10 lines of the file).
	{
		string content, *lines;
		int start;
		content = read_file(file);
		if( stringp(content) ) {
			lines = explode(content, "\n");
			start = sizeof(lines) - 10;
			if( start < 0 ) start = 0;
			write(implode(lines[start..], "\n") + "\n");
		}
	}
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : tail <档案>

此指令可让你直接读取某档案最末尾的几行。
HELP
    );
    return 1;
}
