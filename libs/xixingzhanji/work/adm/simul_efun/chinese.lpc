//Cracked by Roath

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

int is_chinese(string str) {
  // AGENTS.md §15h: this driver's strings are native UTF-8 -- str[0] is
  // already a full Unicode codepoint, not a GBK lead byte, and a single
  // Chinese character is one codepoint (not 2 bytes), so the length
  // floor drops from 2 to 1. Check against the CJK Unified Ideographs
  // codepoint range instead of the old GBK lead-byte range (160-255).
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff) return 1;
  return 0;
}
