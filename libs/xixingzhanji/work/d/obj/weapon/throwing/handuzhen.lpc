#include <weapon.h>

inherit THROWING;

void create()
{
        set_name("寒毒针", ({"handu zhen", "handuzhen", "zhen"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("base_unit", "根");
                set("long",    "一把细小的寒毒针，闪着点点寒芒。\n");
                set("base_weight", 5);
                set("value", 200);
        }
        set_amount(random(10)+1);
        init_throwing(20);
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 0 ) return 0;
   victim->apply_condition("ice_poison", 3);
   message_vision("$N中了寒毒针上的寒毒！\n", victim);
}

