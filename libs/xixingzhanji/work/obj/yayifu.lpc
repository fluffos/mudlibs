// yayi_cloth.c



#include <armor.h>
#include <ansi.h>

inherit CLOTH;



void create()

{

        set_name(YEL"衙役服"NOR, ({ "yayi cloth", "cloth" }));

        set("long", "这是一件崭新的衙役服。\n");

        set_weight(2000);

        if (clonep())

                set_default_object(__FILE__);

        else {

                set("material", "cloth");

                set("unit", "件");

                set("value", 150);

                set("armor_prop/armor", 20);

        }

        setup();

}


