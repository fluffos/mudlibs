#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
//   set("no_get","你手里一松"+this_object()->query("name")+"丹从指间滑落！\n");
//   set("no_give","这么珍贵的药，哪能随便给人？\n");
//   set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
     set("no_sell","这东西有什么价值呢？还是自己留着吧。\n");
  }                                    
  add_action("do_eat", "eat");
}

void create()
{
  set_name("绸袍" NOR, ({"choupao","pao","pao"}));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件丝绸长袍，质的和裁剪都不错．\n");
    set("value", 600);
    set("drug_type", "补品");
  }
  
  setup();
}

int do_eat(string arg)
{
  object me = this_player();
  
  if (!id(arg))
    return notify_fail("你要穿什么？\n");
  
  me->set("food", (int)me->max_food_capacity());
  me->add_maximum_force(3818);
  me->add_maximum_mana(3816);
  me->add("combat_exp",1898012);
  me->add("daoxing",2898012);
  me->add_skill("bainiao-jian",286);
  me->add_skill("sword",298);
  me->add_skill("force",290);
  me->add_skill("ningxie-force",289);
  me->add_skill("spells",302);
  me->add_skill("dengxian-dafa",301);
  me->add_skill("dodge",253);
  me->add_skill("xiaoyaoyou",218);

  me->add_skill("parry",280);
  me->add_skill("literate",139);
  me->add_skill("throwing",260);
  me->add_skill("blade",128);
  me->add_skill("bingpo-blade",125);
  me->add_skill("unarmed",172);
  me->add_skill("bingpo-blade",168);
  me->add("mud_age",691200);
  message_vision(YEL "$N穿上一件绸袍。\n" NOR, me);
  destruct(this_object());
  return 1;
}




