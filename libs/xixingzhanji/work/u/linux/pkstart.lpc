#include <ansi.h>

int update_condition(object killer, int duration) {
  if ((int)killer->query_condition("no_pk_time") > 480)
    killer->receive_wound("sen", 100);
  killer->receive_damage("kee", 100);
  killer->unconcious();
  tell_object(killer, HIG "你的耳边禁不住响起:还~我~命~来~\n" NOR);
  if (duration < 1) return 0;
  return 1;
}
