#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;



int update_condition(object me, int duration) {
  me->receive_wound("sen", 50);
  me->receive_damage("kee", 50);
  me->unconcious();
  tell_object(me, HIG "你的耳边禁不住响起:还~我~命~来~\n" NOR);
  me->apply_condition("killer", duration - 1);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}
