// outdoor.c zip@hero 2000.1.27 房子门口
#include <ansi.h>
#define ID 201
inherit ROOM;
void create() {
  string *dir = ({ "东", "西" });
  set("short", HIG "西游街" + chinese_number(ID / 100) + "号" + dir[ID % 2] + NOR);
  set("long", @LONG
西游街，西游城内风云人物居住的地方，能在这里拥有一间房子是无数人的
梦想。秋风的[1;32m听[1;33m=[1;34m雨[1;35m=[1;36m轩[2;37;0m就在这里。郁郁葱葱的松林，鸟语花香。
有两层楼，全都是窗子。
LONG);
  set("exits", ([
    "east": __DIR__ "street" + (string)(ID / 100),
  ]));
  set("owner", "kissl");
  set("coor/x", 40 + (ID % 2) * 20);
  set("coor/y", 20 + (ID / 100) * 10);
  set("coor/z", 0);
  setup();
}
#include "outdoor_func.lpc"
