// Item: chatroom.c
// by jjgod

#define CHASI          "/d/huafu/zhting"

#include <ansi.h>
inherit ITEM;

int change_long();

void create()
{
    seteuid( getuid() );
    set( "short", "聊天室" );
    set( "long",@LONG
一间用屏风隔开的单间，中间摆着一张木桌，边上随意放着几张凳子。
边上有块牌子写着：
LONG
    );
    set( "title", "大家先随便聊聊吧。" );
    set( "desc", "这里就是聊天室！\n" );
    set_max_encumbrance(400000000);
    setup();
}
void init()
{
	object me=this_player();
	if (!query_temp("owner")){add_temp("owner",me->query("name"));
	me->add_temp("owner",1);}
    // 可以用来改变聊天室的short名和聊天主题
    add_action( "do_change", ({ "change", "gaibian" }) );
    // 可以搞点吃的。
    add_action( "do_yao", "yao" );
    add_action( "do_leave", ({ "leave", "likai" }) );
    add_action( "do_invite", ({ "invite", "yaoqing" }) );
    add_action( "do_letout", ({ "letout", "ganzou" }) );
    change_long();
}
int change_long()
{
    string str;
    str = query( "title" );
    str = sprintf( "%s    本聊天室的主题是：%s\n" + 
        "    本聊天室的主人是：%s\n", 
        query( "desc" ), query( "title" ), query_temp("owner"));
    set( "long", str );
    return 1;
}
int do_change( string arg )
{
    string item, msg, cons;
    object me;

    me = this_player();
    cons = @LONG
    你能改变的是：
    聊天室的名字： gaibian 聊天室名字 某某
    聊天室的主题： gaibian 聊天室主题 某某
    聊天室的属性： gaibian 聊天室属性 私有 或 公用
LONG;
    if (!me->query_temp( "owner" ))
        return notify_fail("就凭你？");
    if ( !arg || sscanf( arg, "%s %s", item, msg ) != 2 )
    {
        // 写出能change的项目
        write( cons );
        return 1;
    }
    switch ( item )
    {
        case "聊天室名字" : case "short" :
            if ( strlen( msg ) > 20 )
                write( "请把聊天室名字控制在10个汉字以内。" );
            else
                set( "short", msg );
            break;
        case "聊天室主题" : case "title" :
            if ( strlen( msg ) > 30 )
                write( "请把聊天主题控制在15个汉字以内。\n" );
            else
                set( "title", msg );
                change_long();
            break;
        case "聊天室属性" : case "pravite" :
            switch ( msg )
            {
                case "公用" :
                    set( "pravite", 0 );
                    write( "本聊天室为公用聊天室。\n" );
                    break;
                case "私有" :
                    if ( me->query( "positive_socre" ) > 10000 || wizardp( me ) )
                    {
                        write( "本聊天室被设为私人聊天室。\n" );
                        set( "pravite", 1 );
                    }
                    else
                        write( "你的武林声望不够，不允许改变聊天室的属性。\n" );
                    break;
                default :
                    write( "你想把聊天室设成什么属性？\n" );
                    break;
            }
            break;
        case "immortal" :
            if ( wizardp( me ) )
            {
                write( query( "short" ) + "被设成巫师专用的了。\n" );
                set( "immortal", 1 );
            }
            else
            {
                write( cons );
            }
            break;
        default :
            write( cons );
            if ( wizardp( me ) )
            {
                write( "    change immoral 1 将使本聊天室成为巫师专用。\n" );
            }
            break;
    }
    return 1;
}

int do_invite( string arg )
{
    object ob, me;

    me = this_player();
    if ( me != query_temp( "owner" ) ) return 0;
    if ( arg == me->query( "id" ) )
        return notify_fail( "你邀请自己参加聊天？有没有搞错啊？\n " );
    if ( !find_player( arg ) )
    {
        write( "你确信现在线上有这个玩家吗？\n" );
        return 1;
    }
    ob = find_player( arg );
    set( "invited/" + ob->query( "id" ), 1 );
    tell_object( ob, me->name() + "邀请你去" + me->name() + 
        query( "short" ) + "聊天。\n" );
    return 1;
}
int do_yao( string arg )
{
    return 0;
}

int do_leave( string arg )
{
    object *all, me;

    me = this_player();

    all = all_inventory(environment(me));
    if ( sizeof( all ) == 1 )
    {
        remove_call_out( "dest" );
        call_out( "dest", 180, this_object() );
    }
    message( "vIsion", me->query( "name" ) + "离开了这里。\n", 
        environment( me ), ({ me } ) );
    me->move( CHASI );
    tell_object( me, "你进入南楼中厅。\n" );
    message( "vision",RANK_D->query_normal(me) + "进入这里。\n",
        environment( me ), me );
    return 1;
}

int do_letout( string arg )
{
    object me, ob;

    me = this_player();
    if ( me != query_temp( "owner" ) )
        return 0;
    if ( !arg ) return notify_fail( "你想赶走谁？\n" );
    if ( me->query( "positive_score" ) < 10000 )
        return notify_fail( "你的武林声望不够高。\n" );
    if ( objectp( ob = present( arg, this_object() ) ) )
    {
        if ( userp( ob ) )
        {
            message_vision( "$N对$n说道：我不欢迎你呆在这里，请出去。\n"
                "说着，就把$n推了出去。\n", me, ob );
            ob->move( CHASI );
            tell_object( "ob", "你被赶出了" + query( "short" ) );
            message( "vision",RANK_D->query_nomal( ob ) + "进入这里。\n",
                environment( ob ), ob );
            return 1;
        }
    }
    write( "你只能把这里的玩家赶出去。\n" );
    return 1;
}

void dest( object ob )
{
    object record, owner;

    if ( sizeof( all_inventory( ob ) ) ) return;
    record = new("/obj/record" );
    if ( !record )
    {
        write( "not find record\n" );
        return;
    }
    record->restore();
    owner = query_temp( "owner" );
    record->delete( "owner/" + owner->query( "id" ) );
    record->save();
    destruct( record );
    destruct( ob );
}
