
#include <ansi.h>
#include <weapon.h>

inherit SWORD; 

void create()
{
        set_name(  "圆珠笔" , ({ "sword" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",

"这是一把普普通通的圆珠笔，从上到下没有任何起眼之处。你可以把它放回（back）文具盒里。\n"
);
                set("material", "steel");
                set("rigidity", 100000);
                set("weapon_prop/agility", 2);
                set("weapon_prop/intelligence", 1);
                set("weapon_prop/courage", 1);
                set("weapon_prop/composure", 1);
        }

        init_sword(12);
        setup();

}
 
void init()
{
	object ob;
	add_action("do_make","back");
	if( this_player() && environment()==this_player() ) {
	set_name( this_player()->name(1) + "的圆珠笔", ({ "sword"}) );
	}
}


int do_make()
{
	object me;
	object obj;
	me=this_player();
	obj=new(__DIR__"wjhe");
	obj->move(me);
        if(query("equipped")) unequip();
        tell_object(me,"你拿出文具盒，将手中的"+query("name")+"又放回文具盒里。\n");
        destruct(this_object());
	return 1;
}          
  
