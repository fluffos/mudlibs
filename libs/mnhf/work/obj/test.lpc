// sword.c : an example weapon

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("长生剑", ({ "sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这就是七种兵器里的长生剑。\n");
    set("value", 4000);
    set("material", "steel");
    set("wield_msg", "$N微微一笑，$n已经出现在手中。\n");
    set("unwield_msg", "$N脸色一变，$n自行飞回剑鞘。\n");
  }
  init_sword(225);
  setup();
}
int query_autoload() { return 1; }
