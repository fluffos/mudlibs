// gold.c

inherit MONEY;

void create() {
  set_name("一百元人民币", ({ "gold", "100yuan", "gold_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "gold");
    set("long", "上面有敬爱的毛主席头像的新版百元大钞。货币种类：gold\n");
    set("unit", "些");
    set("money_id", "gold");
    set("base_value", 10000);
    set("base_unit", "张");
    set("base_weight", 37);
  }
  set_amount(1);
}
