// coin.c

inherit MONEY;

void create()
{
	set_name("分币", ({"coin", "coins", "coin_money" }));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "coin");
		set("long", "这是流通中单位最小的货币，要一百枚分币才值得一元人民币。货币种类：coin\n");
		set("unit", "些");
		set("money_id", "coin");
		set("base_value", 1);
		set("base_unit", "枚");
		set("base_weight", 1);
	}
	set_amount(1);
}

