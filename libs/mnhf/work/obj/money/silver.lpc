// silver.c

inherit MONEY;

void create()
{
	set_name("人民币", ({"silver", "1rmb", "silver_money"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "silver");
		set("long", "一张一元人民币，不值多少钱。货币种类：silver\n");
		set("unit", "些");
		set("money_id", "silver");
		set("base_value", 100);
		set("base_unit", "元");
		set("base_weight", 37);
	}
	set_amount(1);
}

