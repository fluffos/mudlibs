#include <room.h>
inherit ROOM;

void create()
{
      set("short","赏梅亭");
      set("long",@LONG
霎时之间，你又来到了冰天雪地之中，踏雪寻梅，不亦快哉？
漫山红梅白雪间，一座小亭显得特别可爱，亭子正是最好的赏梅之
处，廊柱上也刻着前人咏梅的诗句，是你不由诗兴大发。
LONG);
      set("exits",([ /* sizeof() == 1 */
          "south" : __DIR__"workroom",
      ]));
      setup();
}
