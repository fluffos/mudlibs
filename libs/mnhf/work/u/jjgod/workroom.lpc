inherit ROOM;
#include <room.h>

void create() {
  set("short", "阿飞的工作室");
  set("long", @LONG
这是阿飞工作学习的地方，屋角有一张电脑桌，上面放着一台Pentium3 866，
靠近窗台放着一张表面被阿飞写写划划得千沟万壑的木桌和一条木椅，桌的左首是一
盏台灯，右边则凌乱地摆放着几本中考复习资料，可现在都已没有用了。但因为懒，
阿飞一直不去收拣。中央用铜镇纸压着一幅书法，龙飞凤舞般地写着六个大字：“天
下第一聪明人”。显见主人聪明之极。床边是两个高大的书橱，收藏了阿飞爱看的一
些书籍，你若有兴趣当巫师，不妨读一读，书橱边是一块留言版，各位玩家都可以在
这里留言发表自己对这间房间和房间主人的看法。这个房间的上边是一间搏饼屋，什
么意思？去看看不就知道了。东边是听松居，西边是品竹楼，南边是赏梅亭。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "bobing",
    "east": __DIR__ "song",
    "west": __DIR__ "zhu",
    "north": __DIR__ "mei",
    "south": __DIR__ "chcshi",
    "down": "/d/huafu/juqing",
  ]));
  set("valid_startroom", "1");
  call_other("/cmds/usr/news", "???");
  setup();
  create_door("south", "储藏室门", "north", DOOR_CLOSED);
  create_door("down", "通天门", "up", DOOR_LOCKED);
}
