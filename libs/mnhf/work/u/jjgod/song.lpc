#include <room.h>
inherit ROOM;

void create()
{
      set("short","听松居");
      set("long",@LONG
转眼间，你竟来到一个植满青松的树林，一眼望去，漫山遍野
尽是松林，秋风吹来，松涛阵阵，实在是引人入胜，是你不由陶醉
在悦耳的松涛，飞瀑，流泉之中……
LONG);
      set("exits",([ /* sizeof() == 1 */
          "west"  : __DIR__"workroom",
      ]));
      setup();
}
