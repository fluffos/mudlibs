#include <ansi.h>
inherit ITEM;
void create()
{
    set_name("期末考题", ({ "kti" }) );
//    set_name(WHT"期末考题" NOR, ({ "kaoti" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "张");
            set("material", "paper");
            set("long", "一张期末考的试卷，考试的题目：

			论素质教育\n");
          }

    setup();
}
