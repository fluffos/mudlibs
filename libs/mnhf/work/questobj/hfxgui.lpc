#include <ansi.h>
inherit ITEM;
void create() {
  set_name("华附校规", ({ "gui" }));
  //    set_name(CYN"华附校规"NOR, ({ "hfxgui" }) );
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("material", "paper");
    set("long", "一本华师附中的校规，上面写着：…… 你晕了。\n");
  }

  setup();
}
