// JJGOD@VRHF
inherit SKILL;
mapping *action = ({
  ([ "action":
    "$N低头一看语文书，向$n发问道：“议论文的三要素是什么？！",
    "damage": 120,
    "dodge": 40,
    "parry": 40,
    "force": 80,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N连忙翻动手中的语文书，大吼一声：$n小儿！给我解释“等死，死国可乎”！",
    "damage": 150,
    "dodge": 20,
    "parry": 60,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N一挥手道：“数风流人物，还看$n！",
    "damage": 200,
    "dodge": 10,
    "parry": 40,
    "force": 150,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N双手合击，大叫：“鲁提辖拳打$n！这是第一拳！",
    "damage": 300,
    "dodge": -10,
    "parry": -40,
    "force": 120,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N陡然问道：“请以「生活的启示」为题写一篇800字的文章，$n你不行吧？",
    "damage": 310,
    "dodge": 100,
    "parry": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),

});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练语文拳必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "unarmed") || (usage == "parry");
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够练这门拳法，还是先休息休息吧。\n");
  me->receive_damage("kee", 30);
  return 1;
}
int effective_level() { return 10; }

string *parry_msg = ({
  "$n冉冉腾空而起，逼问$N道：“谁是最可爱的人？”\n",

});

string *unarmed_parry_msg = ({
  "$n轻轻一跃，缓缓说道：“海内存知己，$N若比邻。\n",

});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 30;
}
int practice_bonus() {
  return -30;
}
int black_white_ness() {
  return 320;
}

string perform_action_file(string action) {
  return CLASS_D("huafu") + "/yuwen/" + action;
}
