//shuxuesword.c

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N大喝一声，向$n问道：“$w 加 $l等于几？",
    "dodge": -20,
    "damage": 300,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N厉声道：“$n！快点给我求出从$n的大脑到$n的$l的函数解析式！",
    "dodge": -20,
    "damage": 300,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N一招「求表面积公式」，身形陡然滑出数尺，用手中$w画出一个优美的圆锥，将$n牢牢套住！",
    "dodge": -30,
    "damage": 200,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N手中$w中宫直进，轻松作出$n的$l处的切线！",
    "dodge": -40,
    "damage": 400,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N纵身一跃，手中$w对准$n的$l斜斜划出以$w为纵坐标，$l为横坐标的函数图像",
    "dodge": -40,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N的$w凭空一指，一招「圆幂定理」解开$n的“$l猜想”",
    "dodge": 20,
    "damage": 400,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中$w向外一分，画出一条辅助线，反手对准$n$l一剑刺去",
    "dodge": 80,
    "damage": 200,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N横剑上前，用手中$w指着$n的$l道：“方程要验根，$n你知不知道？！",
    "dodge": -30,
    "damage": 500,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练数学剑法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习数学剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所学练了一遍数学剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("huafu") + "/shuxue/" + action;
}

int effective_level() { return 15; }

string *parry_msg = ({
  "$n使出一招「第九大题」，手中的$v化作一把三角板，磕开了$N的$w。\n",
  "$n使出「△大于0」字诀，将$N的$w封于丈外。\n",
  "$n使出一招「分母不等于0」，手中的$v化做漫天分子，荡开了$N的$w。\n",
  "$n手中的$v一抖，一招「传送纸条」，向$N拿$w的手腕削去。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n反手一招「抄袭答案」，整个人消失在一团剑光之中。\n",
  "$n使出一招「第九大题」，$v直刺$N的双手。\n",
  "$n将手中的$v化做七条剑气，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 10;
}
int black_white_ness() {
  return 15;
}
