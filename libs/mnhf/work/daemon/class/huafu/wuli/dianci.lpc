#include <ansi.h>

int exert(object me, object target, int amount)
{       
	int skill,force;  
	skill = me->query_skill("wuli",1);  
	if(skill < 40) return notify_fail("你的物理神功太差了，不能用电磁感应！\n"); 
	if( !target || target == me)  return notify_fail("你要对谁使用物理神功？\n" );
        if( me->is_fighting() || target->is_fighting())
                return notify_fail("战斗中无法使用物理神功！\n");
	if((int)me->query("max_force") < 400)
                return notify_fail("你的电量不够强。\n");
	if((int)me->query("max_force") <= (int)target->query("max_force"))	
		return notify_fail("你的电量还没有"+target->name()+"的强，不能传送电流！\n"); 
        message_vision(
                YEL "$N坐了下来运起物理神功，应用“电磁感应”定理，将手掌贴在$n背心，缓缓地将电流输入$n体内....\n\n"
                "过了不久，$n浑身舒服的不断抽动，$N却昏倒在地。\n" NOR,
                me, target );
	me->set_skill("wuli",1);
	me->add("max_force",-400);
	me->set("force",0);
	target->add("max_force",200);
	me->unconcious();
        return 1;
}
