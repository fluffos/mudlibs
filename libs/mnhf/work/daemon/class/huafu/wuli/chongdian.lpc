// heal.c

#include <ansi.h>

int exert(object me, object target, int amount)
{
        if( target != me ) return 
                notify_fail("你只能用物理神功给自己充电。\n");

	if( me->is_fighting() )
		return notify_fail("战斗中充电？找死吗？\n");

	if((int)me->query("force") < 50 )
		return notify_fail("你的电量不够。\n");

	if( (int)me->query("eff_kee") < (int)me->query("max_kee") / 4 )
		return notify_fail("你已经受伤过重，只怕一充电便有生命危险！\n");

	write( WHT "你全身放松，坐下来开始给自己充电。\n" NOR);
	message_vision(WHT "$N坐下来充电，脸上一阵青一阵绿，不久，舒服的神了一个懒腰，脸色看起来好多了。\n" NOR, me);
	me->receive_curing("kee", 10 + (int)me->query_skill("force")/5 );
	me->add("force", -50);
	me->set("force_factor", 0);

	return 1;
}
