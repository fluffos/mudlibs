// jjgod@vrhf
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("zhengzhi", 1);
  if (extra < 50) return notify_fail("你的[政治刀法]还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［精神文明建设］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  msg = MAG "$N凝聚起党中央发展精神文明建设的坚定信心，一式－精－神－文－明－建－设－如细雨春风般劈向$n！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = BLU "$N朗声对$n宣扬“马克思列宁主义”！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = RED "$N细心向$n介绍“毛泽东思想”！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = WHT "$N详细地向$n解释“邓小平理论”！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = YEL "$N最后仍然不忘提醒$n：“$n同志呀，精神文明建设和物质文明建设要两手抓，两手都要硬！”" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->start_busy(5);
  return 1;
}
