// board_list.c
#include <mudlib.h>

inherit F_CLEAN_UP;

private mapping vaild_boards = ([
//	board_id : {board_name,allow post}
	"wizard_j"	: ({"巫师玩家交流版",1}),
	"zhting_b"  : ({"校园公告板",1}),
	"player"   : ({"玩家建议留言板",1}),
]);

string gateway() {
	int i;
	string str, *list;

	list = keys(vaild_boards);
	sort_array(list,1);

	str = sprintf(
			"<title>BBS</title>"
			"<body background=/www/images/mainbg.jpg><font color='#ff0000' face='宋体'>"
			"<h3 align='center'>%s</font><font face='宋体'> "
			"%s</font></h3><p><hr></p>",
			CHINESE_MUD_NAME,
			"BBS"
			);

	str += "<center><table border=3>";

	for( i=0;i<sizeof(list);i++) {
		str +=	sprintf(
				"<tr><td><center><a href=board_read?%s&0&9999><font size=3 face='宋体'>%s</font></td></a></center>"
				"<td><font size=3 face='宋体'>%s</font></td>",
				list[i],
				vaild_boards[list[i]][0],
				vaild_boards[list[i]][1]==1?"读写":"只读"
				);
	}

	str += "</table></center></body>";
	return str;
}

mapping query_boards() {
	return vaild_boards;
}
