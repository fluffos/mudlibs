// uptime.c

inherit F_CLEAN_UP;
#include <ansi.h>
#define START_TIME 975800000 //1410056519为最大值
#define TIME_TICK1 ((time()-900000000)*60)
int main() {
  int t, d, h, m, s;
  string time, season, get_month;
  int year = (time() - START_TIME) / 240 / 365;
  get_month = CHINESE_D->chinese_month(TIME_TICK1);

  switch (get_month) {
    // 春天花会开:)
    case "三": season = "早春"; break;
    case "四": season = "春分"; break;
    case "五": season = "暮春"; break;
    // 夏日炎炎正好眠:)
    case "六": season = "初夏"; break;
    case "七": season = "夏至"; break;
    case "八": season = "盛夏"; break;
    // 秋凉请注意保暖
    case "九": season = "清秋";
    case "十": season = "中秋";
    case "十一": season = "深秋"; break;
    // 冬天，寒冷的冬天！
    case "十二": season = "初冬"; break;
    case "一": season = "隆冬"; break;
    case "二": season = "数九"; break;
    default: season = "虚空";
  }
  t = uptime();
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  //	write(RED "现在时间：" +time() + "\n" NOR); ///24/3600/365
  //	write(RED "现在时间：" + "/cmds/usr/rtime"->chinese_time(5, ctime(time())) + "\n" NOR); ///24/3600/365
  //	write(BLU "创始年代：" + END_TIME + "\n" NOR);
  if (year == 0) { write(GRN "创始时间：不到一年\n" NOR); } else write(GRN "游戏时间：模拟华附新纪元第" + chinese_number(year) + "年 " + season + "\n" NOR);
  write(CYN "运行时间：" + time + "\n" NOR);
  write(MAG "当机原因：");
  if (stringp(read_file("/log/nosave/LASTCRASH")))
    write(read_file("/log/nosave/LASTCRASH"));
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : uptime
 
这个指令告诉你模拟华附已经连续运行了多久。
 
HELP
  );
  return 1;
}
