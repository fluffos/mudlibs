// 谁与争锋　/cmds/usr/semote.c
//modified by ytan Dec 18 1996
//by llm 修改，加入巫师检查新编emote功能，改变玩家查看处理方式

inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
    mapping emote;
    string *e;
    int i;
    string str1,str;
/*，由于过去的semote是直接调用emote.o文件，玩家每次查看都是调用一次，实际上
是对系统资源的一种浪费，如果有人不停地semote???加上伤精伤气也只是消极应付方
式，而且对于MUD设计来说，无现实理由的伤精伤气也有些牵强，于是，我修改成由巫
师定期加-a参数生成最新的emote的文本，甚至还可以将这个文本里加上emote的例句
让玩家更清楚某条emote的大意，这个大家有兴趣还可以再改写：
*/
    if(!wizardp(me)||!arg||arg=="")
    {
    	me->start_more(read_file("/doc/help/emote"));//玩家或不加参数就直接查看文本文件
    	write("\n");
    	return 1;
    }
    if(arg == "-a")//巫师可用-a参数
	{
    	str="";
    	e = sort_array(EMOTE_D->query_all_emote(), 1);//取出所有emote的关键词，也就是单词名，并排序
	    for(i=0; i<sizeof(e); i++)
    	{
            str1=sprintf("%-12s%s", e[i], (i%6==5)?"\n": "");//每六个词换一行
        	str+=str1;
    	}
    	write_file("/doc/help/semote",str,1);//最后加1参数表示覆盖原文件，否则越来越大的喔！
    	write("整理成功！\n");
    	return 1;
    }
    if(arg == "new")//查看
	{
        str="以下是玩家新近编制未经巫师审查的emote：\n\n";
        e = EMOTE_D->query_all_emote();//取关键词
        emote = EMOTE_D->query_allemote();//取出所有的内容
        for(i=0; i<sizeof(e); i++)
    	{
            if(!emote[e[i]]["new"]) continue;//有new参数则表示是
            str1=sprintf("%-15s %s", e[i],emote[e[i]]["others"]);//加入一个例句
        	str+=str1;
    	}
    	me->start_more(str);
    	write("\n");
    	return 1;
    }
}
 
int help(object me)
{
  write(@HELP
指令格式 : semote
 
这个指令可以列出目前所能使用的emote.
HELP
    );
    return 1;
}