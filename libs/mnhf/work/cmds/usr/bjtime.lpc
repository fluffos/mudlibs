// time.c                                          
#include <ansi.h>

// #define END_TIME 87442556
#define END_TIME 89111111111
#define FETEDAY "中秋节"
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int time, date;
  time = time();
  date = (END_TIME - time) / 24 / 3600;
  //	printf("现在的时间是北京时间 " + ctime( time ) + "。\n");
  printf(END_TIME - time() + "。\n");
  if (date > 1) {
    printf("距离" + FETEDAY + "还有" BBLU YEL "%s" NOR "天。\n",
      chinese_number(date));
  } else if (date == 1) {
    printf("现在的时间是北京时间 " + ctime(time) + "。\n");
    printf(BBLU YEL "\n\t\t明天就是" + FETEDAY + "了！\n\n" NOR);
  } else if (!date) {
    printf(BBLU YEL "\n\t\t今天是" + FETEDAY + "！\n\n" NOR);
  } else printf(BBLU YEL "\n\t" + FETEDAY + "已经过了！\t\n\n" NOR);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: time

这个指令告诉你现实世界中现在的时间。

HELP
  );
  return 1;
}
