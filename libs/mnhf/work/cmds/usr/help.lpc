// help.c

#include "/doc/help.h"
#include <ansi.h>

inherit F_CLEAN_UP;

string *default_search = DEFAULT_SEARCH_PATHS;

int main(object me, string arg)
{
	int i;
	string file, *search,output;

	// 如果没有指定主题，显示帮助主题
	if( !arg ) {
		output = CYN"≡"YEL"─模拟华附帮助文件───────────────────────────"CYN"≡\n"NOR;
		output +=read_file("/doc/help/topics");
		output += CYN"≡"YEL"──────────────────────模拟华附最终测试版─────"CYN"≡"NOR;
		me->start_more(output);
		return 1;
	}

	// 然后尝试一个已存在的指令（其实这样的顺序不好）
	seteuid(getuid());
	if( stringp(file = me->find_command(arg)) ) {
		notify_fail("有这个指令存在，但是并没有详细的说明文件。\n");
		return file->help(me);
	}

	// 搜索单独搜索路径
	if( pointerp(search = me->query("help_search_path")) ) {
		i = sizeof(search);
		while(i--) if( file_size(search[i] + arg)>0 ) {
			output = CYN"≡"YEL"─模拟华附帮助文件───────────────────────────"CYN"≡\n"NOR;
			output +=read_file(search[i] + arg);
			output += CYN"≡"YEL"──────────────────────模拟华附最终测试版─────"CYN"≡"NOR;
			me->start_more(output);
			return 1;
		}
	}

	// Support efun/lfun help with same name as other topics such as
	// ed() and ed command.
	sscanf(arg, "%s()", arg);

	// 最后搜索默认搜索路径
	if( pointerp(default_search) ) {
		i = sizeof(default_search);
		while(i--) if( file_size(default_search[i] + arg)>0 ) {
			output = CYN"≡"YEL"─模拟华附帮助文件───────────────────────────"CYN"≡\n"NOR;
			output +=read_file(default_search[i] + arg);
			output +=CYN"\n≡"YEL"──────────────────────模拟华附最终测试版─────"CYN"≡"NOR;
			me->start_more(output);
			return 1;
		}
	}

	return notify_fail("对不起，没有针对这项主题的说明文件。\n");
}

int help(object me)
{
	write(@HELP
指令格式：help <主题>              例如：> help map

这个指令提供你针对某一主题的详细说明文件，若是不指定主题，则提供你有关
主题的文件。
HELP
	);
	return 1;
}

