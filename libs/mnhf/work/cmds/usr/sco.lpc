#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
        object ob;
        mapping my;
        string line, str, skill_type, *marks;
        object weapon;
        int i, attack_points, dodge_points, parry_points;

        seteuid(getuid(me));
        if(!arg)
                ob = me;
        else if (wizardp(me)) {
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
                if (!ob) return notify_fail("你要察看谁的状态？\n");
        } else
                return notify_fail("只有巫师能察看别人的状态。\n");

        my = ob->query_entire_dbase();

        line = sprintf( BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(ob), ob->short(1) );

        str = "";
        if( mapp(my["family"]) ) {
                if( my["family"]["master_name"] ) str = my["family"]["master_name"];
        }
        line += sprintf( " " CYN"≡"YEL"—模拟华附最终测试版人物学籍表———————————————————"CYN"≡"NOR"\n\n");
        line += sprintf( " 姓名：[%s% 6s%s]  性别：[%s% 6s%s] 年龄：[%s% 6s%s]"NOR"\n",
                BBLU CYN, ob->query("name"), NOR,
                BBLU CYN, ob->query("gender"), NOR,
                BBLU GRN, chinese_number(ob->query("age")), NOR );
                
        line += sprintf( " 种类：[%s% 6s%s]  勇气：[%s% 8d%s] 头衔：[%s%-25s%s]\n",
                BBLU CYN, ob->query("race"), NOR,
                BBLU MAG, ob->query("bellicosity"), NOR,
                BBLU CYN, ob->query("title"), NOR );
                                
        if( str != "" ) line += sprintf( " 师承：[%s% 6s%s]  生日：[%s%-42s%s] \n",BBLU CYN, str, NOR,
                                BBLU YEL, CHINESE_D->chinese_date(((int)ob->query("birthday") -14*365*24*60) * 60), NOR );

        if( objectp(weapon = ob->query_temp("weapon")) )
                skill_type = weapon->query("skill_type");
        else
                skill_type = "unarmed";

        attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
        parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
        dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

        line += sprintf( " 魅力：[%s %4s %s]  ",
                BBLU, display_attr(my["str"], ob->query_per()), NOR );
        line += "精力  " + tribar_graph(my["gin"], my["eff_gin"], my["max_gin"], BMAG, WHT ,RED)
                + sprintf( "  [%s%4d%s / %s%4d%s , %s%4d%s]\n", BBLU WHT, my["gin"], GRN,
                MAG, my["max_gin"], GRN, RED, my["max_gin"] - my["eff_gin"], NOR );

        line += sprintf( " 评价：[%s %4d %s]  ",
                BBLU YEL, "/cmds/usr/top"->get_score(ob), NOR );
                                
        line += "气血  " + tribar_graph(my["kee"], my["eff_kee"], my["max_kee"], BMAG, WHT ,RED)
                + sprintf( "  [%s%4d%s / %s%4d%s , %s%4d%s]\n", BBLU WHT, my["kee"], GRN,
                MAG, my["max_kee"], GRN, RED, my["max_kee"] - my["eff_kee"], NOR );

        line += sprintf( " 悟性：[%s %4s %s]  ",
                BBLU, display_attr(my["str"], ob->query_int()), NOR );
        line += "心神  " + tribar_graph(my["sen"], my["eff_sen"], my["max_sen"], BMAG, WHT ,RED)
                + sprintf( "  [%s%4d%s / %s%4d%s , %s%4d%s]\n", BBLU WHT, my["sen"], GRN,
                MAG, my["max_sen"], GRN, RED, my["max_sen"] - my["eff_sen"], NOR );

        if( my["food"] * 100 / ob->max_food_capacity() > 10 ) str = CYN + "正常";
        else str = RED + "缺食";
        line += sprintf( " 膂力：[%s %4s %s]  ",
                BBLU, display_attr(my["str"], ob->query_str()), NOR );
        line += "食物：" + tribar_graph(my["food"], ob->max_food_capacity(),
                ob->max_food_capacity(), BBLU, CYN ,RED)
                + sprintf( "  [%s%4d%s / %s%4d%s , %4s%s]\n", BBLU CYN, my["food"], GRN,
                CYN, ob->max_food_capacity(), GRN, str, NOR );

        if( my["water"] * 100 / ob->max_water_capacity() > 10 ) str = CYN + "正常";
        else str = RED + "缺水";
        line += sprintf( " 根骨：[%s %4s %s]  ",
                BBLU, display_attr(my["str"], ob->query_con()), NOR );
        line += "饮水：" + tribar_graph(my["water"], ob->max_water_capacity(),
                ob->max_water_capacity(), BBLU, CYN ,RED)
                + sprintf( "  [%s%4d%s / %s%4d%s , %4s%s]\n", BBLU CYN, my["water"], GRN,
                CYN, ob->max_water_capacity(), GRN,  str, NOR );

        line += sprintf( " 速度：[%s %4s %s]  ",
                BBLU,display_attr(my["str"], ob->query_dur()), NOR );
        line += "无常：" + tribar_graph(my["PKS"], my["MKS"] + my["PKS"],
                my["MKS"] + my["PKS"], BBLU, RED ,RED)
                + sprintf( "  [%s%4d%s +%s%5d%s =%s%5d%s]\n", BBLU RED, my["PKS"], RED,
                MAG, my["MKS"], RED, RED, my["MKS"] + my["PKS"], NOR );

        line += sprintf( " 杀生："GRN"["BBLU WHT"%6d"NOR""GRN"]"NOR"  ",
                ob->query("MKS") );
        line += sprintf("攻击：[%s%12d%s (%s+%4d%s)%s]  躲闪：[%s%12d%s]%s\n" NOR,
                BBLU CYN, attack_points + 1, GRN, WHT, ob->query_temp("apply/damage"), GRN, NOR,
                BBLU CYN, dodge_points + 1, GRN, NOR);

        line += sprintf( " 杀人："GRN"["BBLU RED"%6d"NOR""GRN"]"NOR"  ",
                ob->query("PKS") );
        line += sprintf("防御：[%s%12d%s (%s+%4d%s)%s]  招架：[%s%12d%s]%s\n"NOR,
                BBLU CYN, (dodge_points + (weapon ? parry_points: (parry_points/10))) + 1, GRN,
                WHT, ob->query_temp("apply/armor"), GRN, NOR,
                BBLU CYN, parry_points + 1, GRN, NOR);

        line += sprintf(" 死亡：[%s% 6d%s]  学分：["BLINK"%s%20d%s"NOR"]  潜能[%s%14d%s] \n\n",
                BBLU RED, ob->query("dietimes"), NOR,
                BBLU GRN, ob->query("combat_exp"), NOR,
                BBLU YEL, (int)ob->query("potential") - (int)ob->query("learned_points"), NOR );
                
        line += sprintf( " " CYN"≡"YEL"——————————————————————————————————"CYN"≡"NOR"\n\n");
         
        write(line+BBLK);
        return 1;
}

string display_attr(int gift, int value)
{
        if( value > gift ) return sprintf( YEL "%4d", value );
        else if( value < gift ) return sprintf( CYN "%4d", value );
        else return sprintf("%3d", value);
}

string status_color(int current, int max)
{
        int percent;

        if( max ) percent = current * 100 / max;
        else percent = 100;

        if( percent > 100 ) return CYN;
        if( percent >= 90 ) return GRN;
        if( percent >= 60 ) return YEL;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return RED;
        return RED;
}

string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor)
{
        string ret;
        int i, n, eff_n, max_n = 20;

        if( max == 0 ) max = 1;
        n = val * 100 / max / 5;
        eff_n = eff * 100 / max / 5;

        if( n < 0 ) n = 0;
        if( eff_n < 0 ) eff_n = 0;
        if( n > max_n ) n = max_n;
        if( eff_n > max_n ) eff_n = max_n;

        ret = NOR "[" + bcolor + fcolor ;
        for( i = 0 ; i < max_n; i ++ ) {
                if( i > eff_n ) ret += dcolor;
                if( i < n )  ret += "O";
                else ret += "-";
        }
        ret += fcolor + NOR "]";
        return ret;
}
int help(object me)
{
        write(@HELP
指令格式：score
          score <对象名称>      （巫师专用）

显示自己或者指定对象（含怪物）的基本资料。此指令可以“sc”代替。

相关讯息：hp
HELP
        );

        return 1;
}
