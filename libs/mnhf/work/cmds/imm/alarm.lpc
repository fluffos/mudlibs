// Add by jjgod
#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);
          void create() {seteuid(getuid());}
int main(object me, string arg)
{object ob;
string target, msg, mud,from,punish;
object obj;
if( !arg || sscanf(arg, "%s %s for %s", target, msg,punish)!=3 ) return help(me);obj = find_player(target);
write(RED "\n 你以模拟华附巫师的名义警告" + obj->name(1) + "：\n \n" + "
      由于你的"+msg +"行为违反了游戏规则，造成了不良影响，如果再犯，\n"+"      将被处以"+punish+"！\n \n" NOR);
tell_object(obj, sprintf( RED "\n %s以模拟华附巫师的名义警告你：\n \n"+"
      由于你的%s行为违反了游戏规则，造成了不良影响，如果再犯，\n"+"      将被处以"+punish+"！\n \n" NOR,me->name(1), msg,punish));
return 1;
}
int help(object me)
{
write(@HELP
指令格式：alarm <某人> <原因> for <处罚方法>
你可以用这个指令警告任何人。
HELP
);
return 1;
}
