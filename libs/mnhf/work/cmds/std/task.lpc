#include <ansi.h>
int main(object me, string str)
{
	string output;
	me->add("sen",-5);
	output = RED"◎ 模拟华附无线电测向小组任务列表◎\n" NOR;
	output += CYN"≡"YEL"─任务物品─物品ＩＤ──────────────任务目标──────"CYN"≡\n"NOR;
	output += TASK_D->dyn_quest_list();
	output += CYN"≡"YEL"────────────────────模拟华附最终测试版─────"CYN"≡\n"NOR;
	me->start_more(output);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式: tasks

这个指令是用来得知目前的所有使命.

HELP
	);
	return 1;
}
