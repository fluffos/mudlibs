// 由JJGOD为模拟华副制作
#include <ansi.h>

inherit F_CLEAN_UP;
int main(object ob, string arg) {
  int i, j;
  int n = random(100);
  string qob;
  object *inv, *invme, obj, npc;
  object me = this_player();
  qob = me->query("quest/quest");
  if (!arg) return notify_fail("你要从哪个人或者物上寻找？\n");
  if ((!me->query("quest/quest"))) return notify_fail("你都不在做quest，找什么找？\n");
  if (((string)me->query("quest/quest_type") == "杀")) return notify_fail("你的任务是去杀" + me->query("quest/quest") + "，怎么来找东西了？\n");
  npc = present(arg, environment(me));
  if (!npc) return notify_fail("你要从哪个人或者物上寻找？\n");
  if ((int)me->query("combat_exp") > npc->query("combat_exp") * 10) return notify_fail("你比人家强那么多，还问人家要东西，羞也不羞？\n");
  invme = all_inventory(me);
  for (i = 0; i < sizeof(invme); i++)
    if (((string)(invme[i]->name()) == qob)) return notify_fail("你要找的东西就在你身上，还想骗谁？\n");
  inv = all_inventory(npc);
  for (i = 0; i < sizeof(inv); i++)
    if (((string)(inv[i]->name()) == qob)) {
      write("你从头到脚打量了一下" + npc->query("name") + "，突然欣喜若狂的大叫：“就是这个" + inv[i]->name() + "！
我找了好久了，" + npc->query("name") + "你送给我好不好？”\n");
      if (n > 50 && n < 80) {
        write(npc->query("name") + "叹了口气，说道：“罢了罢了，反正我留着也没有用，你拿去吧。”\n");
        write("说着" + npc->query("name") + "递过来一" + inv[i]->query("unit") + inv[i]->name() + "。\n");
        obj = new(base_name(inv[i]));
        obj->move(me);
        return 1;
      } else {
        write(npc->query("name") + "一副吝啬的样子，叫到：" + inv[i]->name() + "可是宝贝，我才不给你！\n");
        return notify_fail("看来这位" + npc->query("name") + "并不想把" + inv[i]->name() + "给你。\n");
      }
    }
  write("你从头到脚打量了一下" + npc->query("name") + "，然后摇摇头，叹了口气。\n");
  return notify_fail("看来这位" + npc->query("name") + "身上并没有你想要的东西。\n");
}

int help(object me) {
  write(@HELP
指令格式 : lookup <id>
 
这个指令可以帮助你找到任务需要的物品。
HELP
  );
  return 1;
}
