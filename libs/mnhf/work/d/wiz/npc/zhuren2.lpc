
inherit NPC;
#include <ansi.h>
void create()
{
	set_name("训导处主任", ({ "xun" }) );
	set("gender", "男性" );
	set("age", 69);
	set("long",
		"这位训导处正用黑多白少的双眼盯着你。\n");
	set("combat_exp", 500000);
	set("attitude", "friendly");
	set("per",10);
	set_skill("unarmed",200);
	set_skill("dodge",200);
	setup();
	carry_object("/obj/cloth")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(10) ) {
		case 0:
message_vision("$N冷冷的扫了$n一眼．\n",this_object(),ob);
			break;
		case 1:
message_vision("$N踮起脚，拍了拍$n的脑袋，说道：这位"+RANK_D->query_respect(ob)+
"不用怕，好好改造，从新做人!\n",this_object(),ob);
			break;
		case 2:
message_vision("$N问$n：你想不想减刑……？\n",this_object(),ob);
	}
}
int accept_object(object who, object ob)
{
       int val;
       object juqing;

       val = ob->value();
	juqing=load_object("/d/huafu/juqing");
       if( !val )
                return 0;
       if( val >= 2000) {
	message_vision("训导处主任说道：哈哈，这位" + RANK_D->query_respect(who)
                + "，行了，看你认错态度好，出去吧！\n",who);
	who->move(juqing);
        }
        say( "训导处主任说道：哼，想贿赂我？没门！\n");
        return 1;
}

