// xiaohui.c
// 校徽，这个东西挺重要的。

inherit  ITEM;

void  create()
{
                set_name("校徽",  ({  "xiaohui"  }));
                set_weight(150);
	set("long",  "这是个普普通通的校徽。\n"  );
                if(  clonep()  )
                                set_default_object(__FILE__);
                else  {
                                set("unit",  "个");
                                set("material",  "silver");
                set("value",  1500);
                set("no_get",  1);
	set("no_drop",  1);
                set("amount",30);
                }
                setup();
}
int query_autoload() { return 1; }