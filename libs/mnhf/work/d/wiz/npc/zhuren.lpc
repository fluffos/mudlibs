inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create()
{
	set_name("教学处主任", ({ "jiao" }) );
	set("gender", "男性");
	set("age", 69);
	set("long",
		"这位教学处主任正用白多黑少的双眼盯着你。\n");
	set("combat_exp", 500000);
	set("attitude", "friendly");
	set("per",30);
	set("vendor_goods", ([
                __DIR__"obj/jieshu":30,
                __DIR__"obj/xiaohui":30,
	]) );
	set_skill("unarmed",200);
	set_skill("dodge",200);
	setup();
	carry_object("/obj/cloth")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(10) ) {
		case 0:
message_vision("$N用白多黑少的眼睛盯了$n一眼．\n",this_object(),ob);
			break;
		case 1:
message_vision("$N阴阴一笑，说道：这位"+RANK_D->query_respect(ob)+
"要办什么？\n",this_object(),ob);
			break;
		case 2:
message_vision("$N哼道：办借书证还是买校徽？\n",this_object());
	}
}
