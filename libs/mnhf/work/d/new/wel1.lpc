inherit ROOM;

void create() {
  set("short", "模拟华附军训课程");
  set("long", @LONG
教官说道：
“你混混沌沌的来到了一个陌生的世界，模拟华附的世界是一个以现代社
会的中学校园为背景的网络游戏，所以，它和以往的武侠游戏大不相同，首先
你最好先看看巫师专门写的帮助文件（help），这将对你以后的学习生活大有
帮助。然后，你再使用hp、score、i这几个指令熟悉一下模拟华附中的人物属
性模式。再用maphere指令察看一下你正在那里。熟悉一下模拟华附的地形。
这样你就对这个校园有初步了解了。你明白了吗？”
LONG
  );
  set("exits", ([
    "east": __DIR__ "wel2",
    "south": __DIR__ "welx",

  ]));
  set("objects", ([
    __DIR__ "npc/jieyinshi": 1,
  ]));
  set("no_fight", 1);
  setup();
}
