// jieyinshi.c 接客童子
// CLEANSWORD 1996/2/2

inherit NPC;
#include <ansi.h>

void create() {
  set_name("军训教官", ({ "jiao guan", "jiao" }));
  set("long", "这是一位专门训练新生的教官。来自广州武警四支队。\n");
  set("gender", "男性");
  set("age", 18);
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say("教官说道：这位" + RANK_D->query_respect(ob)
    + "，听明白了我的话吗？明白了就跟我去西边。\n");


}
