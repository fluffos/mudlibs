// jieyinshi.c 接客童子
// CLEANSWORD 1996/2/2

inherit NPC;
#include <ansi.h>

void create()
{
	set_name("军训教官", ({ "jiao guan", "jiao" }));
	set("long", "这是一位专门训练新生的教官。来自广州武警四支队。\n");
	set("gender", "男性");
	set("age", 18);

	set("shen_type", 1);
	setup();

	carry_object("/obj/cloth")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
		say("教官说道：“这位"+ RANK_D->query_respect(ob)
				+ ",好啦，军训就训到这里，你要准备开始正式的学习生活了。\n"+
		"一通向学校的中心——"WHT"聚清园。\n"NOR+
		"二通向老师上课的地方——"GRN"西教学楼。\n"NOR+
		"三通向巫师办公的地方——"YEL"办公楼。\n"NOR+
		"四通向学习知识的地方——"CYN"图书馆。\n"NOR+
		"五通向校外的"YEL"麦当劳"RED"餐厅。\n"NOR+
		"六通向法轮邪教的势力范围——"MAG"后门花园。\n"NOR+
		"请您选择你要去的地方。”\n");
}

