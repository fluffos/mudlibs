// jieyinshi.c 军训教官
// 发放新生帮助
// jjgod 2000/10/13

inherit NPC;
#include <ansi.h>
int bangzhu();

void create() {
  set_name("军训教官", ({ "jiao guan", "jiao" }));
  set("long", "这是一位专门训练新生的教官。来自广州武警四支队。\n");
  set("gender", "男性");
  set("age", 38);
  set("inquiry", ([
    "帮助": (: bangzhu :),
    "help": (: bangzhu :),
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say("教官说道：这位" + RANK_D->query_respect(ob)
    + "，如果你军训实在觉得累的话，可以问我要帮助" + CYN + "(ask jiao about 帮助)。\n" NOR);

}

int bangzhu() {
  object ob, me = this_player();
  int i = me->query_temp("silver");
  int j = me->query("bangzhu");
  int k = 50 + random(300);
  int x = 50 + random(150);
  if (i < 10 && j < 10) {
    ob = new("/obj/money/silver");
    ob->set_amount(k / 100);
    ob->move(me);
    message_vision("教官给$N" + chinese_number(k / 100) + "元人民币。\n", me);
    i = i + 1;
    me->set_temp("silver", i);
    me->add("combat_exp", k);
    me->add("potential", x);
    me->add("bangzhu", 1);
    message_vision(WHT "教官给$N增加了" + k + "点学分和" + x + "点潜能。\n" NOR, me);
  } else message_vision(WHT "教官怒道：“$N，你怎么这么贪得无厌！”\n" NOR, me);
  return 1;
  return 1;
}
