inherit ROOM;
#include <room.h>
void create() {
  set("short", "游泳池");
  set("long", @LONG
这里是华师附中的游泳池。也许是来游泳的人比较少的缘故吧，这个游
泳池保养得很新，平时大家只有游泳课时才来这里。碧绿的池水波光粼粼，
倒是挺可爱的。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "panda",
    "north": __DIR__ "pool",
  ]));
  set("valid_startroom", 1);
  set("outdoors", "华师附中");
  set("objects", ([
    __DIR__ "obj/pool": 1,
  ]));
  set("coor/x", 40);
  set("coor/y", 80);
  set("coor/z", 0);
  setup();
  create_door("north", "水闸", "south", DOOR_CLOSED);
}
void init() {
  add_action("do_swim", "swim");
}

int do_swim() {
  object me;
  object room;
  me = this_player();
  message_vision("$N跳进水中，开始游泳．．．\n", me);
  room = load_object(__DIR__ "pool");
  me->move(room);
  me->add("gin", -40);
  me->add("kee", -40);
  return 1;
}
