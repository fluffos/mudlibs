// Room:/d/huafu/dinglou.c
// 顶楼，涉及谜题

inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "顶楼阳台");
  set("long", @LONG
这里就是21层楼顶的阳台了，也是整个华附里和天堂最接近的地方，仰望碧蓝的天
空，平视朵朵白云，俯瞰下边渺小的华附，再想想沉重的学习负担，你不由产生了一种
想纵身一跃，解脱所有束缚的冲动。一看旁边地上，发现和你有同样想法的人还不少。
LONG
  );
  set("no_magic", 1);
  set("objects", ([
    __DIR__ "obj/yishu": 1,
  ]));
  set("valid_startroom", 1);
  set("coor/x", 60);
  set("coor/y", 0);
  set("coor/z", 200);
  setup();
}
void init() {
  add_action("do_jump", "jump");
}
int do_jump(string arg) {
  object ob;
  object me;
  me = this_player();
  if (!me->query("marks/21层教工宿舍的古怪")) {
    message_vision("$N潇洒的一挥手，从21层高楼楼顶向下纵身一跃，永远的离开了这个喧嚣的世界……\n", me);
    message_vision(CYN "$N成功的破解了“21层教工宿舍的古怪”谜题，获得了一些学分和潜能的奖励！\n" NOR, me);
    me->add("gin", -300);
    me->add("kee", -280);
    me->add("sen", -300);
    if (!(ob = find_object("/d/huafu/hgarden")))
      ob = load_object("/d/huafu/hgarden");
    me->move(ob);
    me->add("combat_exp", 30 + random(10));
    me->add("potential", 30 + random(10));
    me->set("marks/21层教工宿舍的古怪", 1);
    return 1;
  } else
    return notify_fail("跳过了还跳，你真的那么想死？");
}
