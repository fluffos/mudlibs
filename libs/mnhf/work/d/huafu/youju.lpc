
inherit ROOM;

void create()
{
	set("short", "石牌邮局");
	set("long", @LONG
喜讯！特大喜讯！石牌邮局寄信不收钱！虽然寄信速度慢点、服务态度差点、
邮局人手少点、顾客埋怨多了点、邮局的商业气氛浓了点、空调坏的次数多了点……
之外，就没有什么特别大的不妥之处了，免费第一嘛，将就点儿。
LONG
	);
	set("valid_startroom",1);
	set("exits", ([ /* sizeof() == 1 */
		"southup" : __DIR__"tianqiao",
		"south"   : __DIR__"zhshdadao",
		"east" : __DIR__"bank",
		"west" : __DIR__"xjjicun",
	]));
	set("objects", ([
		__DIR__"npc/officer": 1
	]) );
	set("no_kill",1);
	set("no_fight", 1);
	set("coor/x",0);
	set("coor/y",140);
	set("coor/z",0);
	setup();
}

int valid_leave(object me, string dir)
{
	object mbox;

	if( mbox = me->query_temp("mbox_ob") ) {
		tell_object(me, "你将信箱交回邮局。\n");
		destruct(mbox);
	}
	return 1;
}
