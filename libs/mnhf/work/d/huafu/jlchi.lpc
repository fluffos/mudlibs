// Date:  jjgod    00/10/15
// 钓鱼job

#include <ansi.h>
inherit ROOM;

void create()
{
    set("short",  GRN "锦鲤池" NOR );
    set("long", @LONG
这是办公楼边上的一个小小的锦鲤池，池中不少各色锦鲤游来游去，
四处觅食，几个同学正坐在池边在钓鱼，真所谓是偷得浮生半日闲，好不
逍遥。
LONG
    );
	

        set("exits", ([
                "east" :"/d/wiz/jobroom",
        ]));
    	set("coor/x",-80);
	set("coor/y",20);
	set("coor/z",0);
    set("outdoors", "华师附中");
    setup();
	}

int init()
{
	add_action("do_fishing","fighing");
	add_action("do_fishing","diao");
	add_action("do_fishing","钓");
}

int do_fishing( string arg )

{	object me=this_player();
	
	if (!arg || arg=="") return notify_fail("你要钓什么？\n");
	if (arg == "yu" || arg=="fish")
	if(!present("gan" , me)) return notify_fail("空手捉鱼吗？\n");	
	if ((int)me->query_temp("a")) return notify_fail("你不是正在钓着吗？\n");
	if ((int)me->query("gin")  < 20 ) return notify_fail("你太累了，别钓了吧。\n");
	message_vision("$N把鱼竿一甩，坐在池边上钓起鱼来。\n",me);
	me->set_temp("a",1);
	remove_call_out("diao");
	call_out("diao",3,me);
	return 1;
}


void diao( object me )
{	
	object yu,silver;
	int n=random(10);
	if (!n) 
	{yu=new(__DIR__"obj/daliyu");
	 yu->move(me);
	me->add("combat_exp",5+random(5));
	message_vision("哇！$N钓到了一条大鲤鱼，看来运气不错。\n",me);  }
	else if  ( n>5 && n< 8 ) 
		{ yu=new(__DIR__"obj/yu");
		 yu->move(me); 
		 message_vision("$N钓到了一条小鱼，有收获。\n",me);
		me->add("combat_exp",2+random(5));
		 }
		else message_vision("$N钓上了一条鱼，可惜被一个跑过来的人丢给一块钱，把鱼抢走了。\n",me);
	silver=new("/obj/money/silver");
	silver->move(me);
	me->add("gin", -5);
	me->delete_temp("a");
	
}
int valid_leave(object me, string dir)
{
	if(me->query_temp("a"))
	return notify_fail("你不是正在钓鱼吗？怎么就想走了？\n");
	else return 1;
}