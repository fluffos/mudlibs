// 天铃鸟
inherit NPC;
void create() {
  set_name("小鸟", ({ "bird" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "一只美丽的小鸟。\n");
  set("attitude", "friendly");
  set("max_kee", 100 + random(50));
  set("kee", 100 + random(50));
  set("gin", 100);
  set("max_gin", 100);
  set("max_sen", 100);
  set("sen", 100);
  set("eff_sen", 100);
  set("limbs", ({ "嘴", "翅膀", "爪子" }));
  set("verbs", ({ "bite", "claw" }));
  set("combat_exp", 100 + random(50));
  set_temp("apply/attack", 5 + random(5));
  set_temp("apply/defense", 5 + random(5));
  set_temp("apply/damage", 5 + random(5));
  setup();
}
