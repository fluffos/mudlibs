// cxyi_up.c
// jjgod为完善task系统而开发的。
#include  <ansi.h>

inherit  ITEM;

void  create()
{
                set_name("测向仪",  ({  "cx yi","yi","mac"}));
                set_weight(2000);
	set("long",  "这是一台可以永久使用的小型无线电测向仪。\n"  );
                if(  clonep()  )
                                set_default_object(__FILE__);
                else  {
                                set("unit",  "台");
                                set("material",  "iron");
                set("value",  200000);
                set("no_get",  1);
	set("no_give",  1);
	set("no_drop",  1);
                }
                setup();
}
int query_autoload() { return 1; }