// sword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("圆珠笔", ({ "ball point pen", "pen" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枝");
    set("value", 700);
    set("material", "iron");
    set("long", "这是一枝不知是否为假货的圆珠笔。\n");
    set("wield_msg", "$N抽出一枝$n拿在手中。\n");
    set("unequip_msg", "$N将手中的$n收好，塞回口袋里。\n");
  }
  init_sword(15);
  setup();
}
