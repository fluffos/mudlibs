#include <ansi.h>
inherit ITEM;

void create()
{
  set_name("银翘解毒丸",({"pill","yq pill"}));
  set("long",
      "这是一片白色的银翘解毒丸，\n"
      "可以用来解（ｃｕｒｅ）你中了的毒。\n");
  set("value",3000);
  set("unit","片");
}

void init()
{
  if(this_player()==environment())
  add_action("do_cure","cure");
}

int do_cure()
{
	object me;
	me = this_player();
	message_vision("$N拿出一篇银翘解毒丸服了下去。\n",me);
	me->clear_condition();
	message_vision("$N的腹内＂隆隆＂作响！\n",me);
	if (!me->query("marks/巧解生化楼奇毒")){
	me->add("combat_exp",25+random(10));
	me->add("potential",25+random(10));
	me->set("marks/巧解生化楼奇毒",1);
	message_vision(CYN"$N成功的破解了“巧解生化楼奇毒”谜题，获得了一些学分和潜能的奖励！\n"NOR,me);}
	destruct(this_object());
	return 1;
}
