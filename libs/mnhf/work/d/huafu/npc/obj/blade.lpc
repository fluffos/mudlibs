// blade.c

#include <weapon.h>

inherit BLADE;

void create() {
  set_name("水果刀", ({ "blade" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 700);
    set("material", "iron");
    set("long", "这是一把不大伤得到人的水果刀。\n");
    set("wield_msg", "$N抽出一把表面斑驳的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n收好，塞回口袋里。\n");
  }
  init_blade(25);
  setup();
}
