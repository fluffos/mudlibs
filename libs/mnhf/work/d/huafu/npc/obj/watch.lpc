
#include <armor.h>
#include <ansi.h>
inherit FINGER;

void create()
{
	set_name(YEL "金手表" NOR, ({ "watch"}) );
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个金色的俗不可耐的手表。\n");
		set("unit", "个");
		set("value", 100000);
		set("armor_prop/armor", 0);
		set("armor_prop/personality", 3);
		set("wear_msg", "$N轻轻地把一个$n戴在手腕上。\n");
		set("unwield_msg", "$N轻轻地把$n从手腕上除了下来。\n");


	}
	setup();
}

