// medicine.c

inherit ITEM;

void create() {
  set_name("阿斯匹灵", ({ "asipiling" }));
  set_weight(60);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一包阿斯匹灵，可以用（yong）来治伤 。\n");
    set("unit", "包");
    set("value", 2000);
  }
}

void init() {
  if (this_player() == environment())
    add_action("apply_medicine", "yong");
  add_action("apply_medicine", "use");
  add_action("apply_medicine", "eat");
}

int apply_medicine() {
  int value = 20;
  int diff;

  if (this_player()->is_fighting())
    return notify_fail("战斗中不能用药！！\n");
  diff = this_player()->query("max_kee") - this_player()->query("eff_kee");
  if (!(diff)) return notify_fail("你没有受伤！\n");
  if (value > diff) value = diff;

  message_vision("$N一口气吃下一大包阿斯匹灵药片。\n", this_player());
  this_player()->add("eff_kee", value);
  destruct(this_object());
  return 1;
}
