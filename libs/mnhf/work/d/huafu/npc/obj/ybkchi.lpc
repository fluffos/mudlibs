// blade.c

#include <weapon.h>

inherit BLADE;

void create() {
  set_name("游标卡尺", ({ "ybkchi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 2000);
    set("material", "iron");
    set("long", "这是一把精确度为0.02mm的游标卡尺。\n");
    set("wield_msg", "$N抽出一把$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n收好，塞回口袋里。\n");
  }
  init_blade(55);
  setup();
}
