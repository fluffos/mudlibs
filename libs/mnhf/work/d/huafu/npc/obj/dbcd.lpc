#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("盗版光盘" , ({ "daobancd" , "光盘"}) );
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "堆");
		set("long", "一堆满是划痕的盗版光盘。\n");
		set("value", 1000);
		set("base_unit", "张");
		set("base_weight", 1);
		set("base_value", 1);
	}
	set_amount(20);
	init_throwing(15);
	setup();
}



