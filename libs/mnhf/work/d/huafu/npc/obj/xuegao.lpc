// chicken_leg.c

#include <weapon.h>

inherit HAMMER;
inherit F_FOOD;

void create()
{
	set_name("雪糕", ({ "xuegao" }) );
	set_weight(250);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一根冰凉美味的雪糕。\n");
		set("unit", "根");
		set("value", 200);
		set("food_remaining", 4);
		set("food_supply", 60);
		set("wield_msg", "$N抓起一根$n，握在手中当武器。\n");
		set("material", "bone");
	}
	init_hammer(1);
	setup();
}

int finish_eat()
{
	if( !query("weapon_prop") ) return 0;
	set_name("舔干净的雪糕棍儿", ({ "stick" }) );
	set_weight(150);
	set("long", "一根舔干净的雪糕棍儿。\n");
	return 1;
}
