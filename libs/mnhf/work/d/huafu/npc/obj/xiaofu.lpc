// cloth.c
//

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name("校服", ({ "xiaofu" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是华师附中的校服。\n");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
