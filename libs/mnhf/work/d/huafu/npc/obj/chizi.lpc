// blade.c

#include <weapon.h>

inherit BLADE;

void create()
{
        set_name("刻度尺", ({ "chizi" }) );
        set_weight(50);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 700);
                set("material", "iron");
                set("long", "刻度尺，在物理上说，是一种测量的工具，在数学上说，是尺规作图的工具，
		语文上说是某种衡量的标准……\n");
                set("wield_msg", "$N抽出一把$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n收好，塞回口袋里。\n");
        }
        init_blade(15);
        setup();
}
