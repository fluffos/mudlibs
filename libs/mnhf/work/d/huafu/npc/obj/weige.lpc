// medicine.c

inherit ITEM;

void create() {
  set_name("伟哥药片", ({ "weige" }));
  set_weight(60);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一片伟哥， 你说用来补什么？\n");
    set("unit", "片");
    set("value", 20000);
  }
}

void init() {
  if (this_player() == environment())
    add_action("apply_medicine", "yong");
}

int apply_medicine() {
  int value = 20;
  int diff;

  if (this_player()->is_fighting())
    return notify_fail("战斗中不能用药！！\n");
  if (this_player()->query("str") >= 40)
    return notify_fail("你已经够强壮的了！！\n");
  diff = this_player()->query("max_gin") - this_player()->query("eff_gin");
  if (!(diff)) return notify_fail("你没有受伤！\n");
  if (value > diff) value = diff;

  message_vision("$N吞下一片伟哥，顿时……昏了过去。\n", this_player());
  this_player()->add("eff_gin", value);
  this_player()->add("str", value / 3);
  destruct(this_object());
  return 1;
}
