#include <weapon.h>
#include <ansi.h>
inherit DAGGER;

void create() {
  set_name("小手枪", ({ "gun" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把黑亮的不知是真是假的小手枪。\n");
    set("value", 4000);
    set("material", "steel");
    set("wield_msg", "$N「唰」地一声把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");
  }
  init_dagger(25);
  setup();
}
