// teacher.c

inherit NPC;
string ask_me();
void create() {
  set_name("体育馆管理员", ({ "tiyu guan", "guan" }));
  set("gender", "男性");
  set("age", random(20) + 20);
  set("int", 26);
  set("long",
    "他是一名华附初中体育馆的管理员，一向特别爱向学生指派工作。\n");
  set("chat_chance", 15);
  set("chat_msg", ({
    "管理员对你说：“小同学，你想不想去扫地？”\n",
    "管理员对你说：“小同学，想扫地的话，问我要扫把就行了！”\n",
  }));
  set("inquiry", ([
    "扫地": (: ask_me :),
    "扫把": (: ask_me :),
  ]));
  set("attitude", "peaceful");
  set("class", "huafu");
  set_skill("literate", 40);
  set("combat_exp", random(50));
  set_skill("dodge", random(5));
  setup();
}
string ask_me() {
  mapping fam;
  object ob;

  if (present("broom", this_player()))
    return RANK_D->query_respect(this_player()) + "你已经有扫把了，还要干什么！";
  if (!(fam = this_player()->query("family")) || fam["family_name"] != "华师附中")
    return "你不是我们学校的，来凑什么热闹！一边去！";
  ob = new("/d/huafu/obj/saozou");
  ob->move(this_player());
  return "“好了，扫把给你，快去扫地吧！”说完体育馆管理员递给你了一个扫把。";
}
int accept_object(object who, object ob) {
  if ((string)ob->query("id") == "broom") {
    message_vision("体育馆管理员说道：扫完了，好，记住以后要认真扫噢！\n", who);
    // 下面设的东西也太多了，唉，我懒的改了。
    who->delete_temp("clean_floor1");
    who->delete_temp("clean_floor2");
    who->delete_temp("clean_floor3");
    who->delete_temp("clean_floor4");
    who->delete_temp("clean_floor5");
    who->delete_temp("clean_floor6");
    return 1;
  }
  return notify_fail("体育馆管理员问道：你把这个给我干什么？");
}
