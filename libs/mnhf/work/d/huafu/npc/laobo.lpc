// laobo.c
// 人物功能：work、要鱼竿

#include <ansi.h>

inherit NPC;
string yugan();
void create() {
  set_name(MAG "老伯" NOR, ({ "laobo", "bo" }));
  set("long",
    "华附看管自行车的老伯，老师学生都很尊重他。\n");

  set("gender", "男性");
  set("str", 27);
  set("cor", 26);
  set("class", "huafu");
  set("cps", 25);
  set("age", 69);
  set("combat_exp", 0);
  set("inquiry", ([
    "鱼竿": (: yugan :),
    "钓鱼": (: yugan :),
    "fishing": (: yugan :),
  ]));
  setup();
  carry_object("obj/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_work", "work");

}
int do_work(string arg) {
  object me;
  me = this_player();
  if (me->is_busy()) return notify_fail("你的动作还没有完成，不能工作。\n");
  if (me->query("gin") <= 10 || me->query("kee") <= 10) return notify_fail("你现在太累了，还是歇歇吧。\n");
  message_vision("$N呆呆的蹲在门口，开始看守起自行车来。\n", me);
  me->set_temp("disable_inputs", 1);
  me->set_temp("block_msg/all", 1);
  me->set_temp("is_unconcious", 1);
  me->set("disable_type", GRN "<运动中>" NOR);
  me->add("combat_exp", 5 + random(5));
  me->add("gin", -random(10));
  me->add("kee", -random(10));
  call_out("wake", random(7), me);
  return 1;
}
string yugan() {
  object me = this_player();
  object ob;

  if (present("yu gan", me))
    return "你身上带着一根，还想要！\n";
  ob = new("/d/huafu/npc/obj/yugan");
  ob->move(me);
  return "这根鱼杆借给你，记住要小心保管！\n";
}
void wake(object me) {
  object ob;
  int i = random(10);
  me->delete_temp("disable_inputs");
  me->delete("disable_type");
  me->delete_temp("block_msg/all");
  me->delete_temp("is_unconcious");
  if (i > 7) {
    me->improve_skill("unarmed", 5 + random(3));
    message_vision(CYN "$N觉得在自行车的搬运中对扑击格斗之技有了切身的理解！\n" NOR, me);
  }
  if (!me->is_ghost())
    message_vision("上了年纪的老伯对$N说：“好啦，回去吧，这是对你热爱看管自行车事业精神的回报。”\n", me);
  tell_object(me, "你觉得身心疲惫了很多。\n");
  me->start_busy(random(3));
  ob = new("/obj/money/silver");
  ob->move(me);
}
