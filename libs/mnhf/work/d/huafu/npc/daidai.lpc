// daidai.c
inherit NPC;
#include <ansi.h>
int do_play(string arg);
int kill_virus();
void create() {
  set_name("呆呆", ({ "daidai" }));
  set("gender", "男性");
  set("age", 34);
  set("str", 27);
  set("per", 5);
  set("long", "他是电子阅览室的管理员，人称“呆呆”，长得就呆的可以。\n");
  set("combat_exp", 200000);
  set("attitude", "peaceful");
  set("class", "huafu");
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 100);
  set("inquiry", ([
    "杀毒": (: kill_virus :),
    "virus": (: kill_virus :),
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  set("chat_chance", 5);
  set("chat_msg", ({
    name() + "叹道：生逢乱世，病毒横行啊！\n",
    name() + "问道：可有谁愿去为我校杀毒吗？\n",
  }));

  seteuid(getuid());
  setup();
  add_money("silver", 500);
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_play", "play");
  remove_call_out("greeting");
  call_out("greeting", 1, this_player());
}

void greeting(object ob) {
  message_vision(CYN "呆呆对$N傻傻的笑了笑，说到:嘿，小子，可别想又玩MUD，抓住了有你好看的。\n" NOR, ob); command("grin");
  return;
}

int do_play(string arg) {
  if (!arg || arg != "mud")
    return notify_fail("你想玩什么？");
  this_object()->kill_ob(this_player());
  this_player()->fight_ob(this_object());
  this_player()->add("score", 10);
  return 1;
}
int kill_virus() {
  object me;
  int i = random(60);
  me = this_player();
  if (me->query("combat_exp") >= 100000 + random(30000)) {
    message_vision("呆呆呆呆一笑，说道：“唉，今天的" + i + "号机子又感染上了病毒，你去帮我杀了它吧！”\n", me);
    message_vision("说着，呆呆把$N送去" + i + "号机子杀毒了。\n", me);
    me->move("/d/huafu/computer");
    return 1;
  } else {
    message_vision("呆呆阴阴一笑：“就你这样子也去杀毒？趁早滚蛋吧！”\n", me);
    return 1;
  }
  return 0;
}
