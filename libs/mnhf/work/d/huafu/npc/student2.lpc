
inherit NPC;

void create()
{
        set_name("女学生", ({ "student", "nusheng","mm"}) );
        set("gender", "女性" );
        set("age", 15);
	set("per", 15+random(5));
        set("long", "这是一位普普通通的华附女生。\n");
        set("combat_exp", 5000+random(3000));
        set("attitude", "peaceful");
        set_skill("sword", 90);
	set("class","huafu");
	set_skill("shuxue", 90);
	set_skill("dodge", 100);
        set("chat_chance", 3);
        set("chat_msg", ({
                "学生一边低头看书一边读道：“VACATION，V-A-C-A-T-I-O-N，VACATION，GENERAL，G-E-.....\n",
                (: random_move :),
        }) );
	
	setup();
	add_money("silver", 30);
        carry_object(__DIR__"obj/xshcloth")->wear();
        carry_object(__DIR__"obj/gbi")->wield();
}
void die()
{
        object ob;
        if( !ob = query_temp("last_damage_from") )
                ob = this_player(1);
	if(ob)
        CHANNEL_D->do_channel(this_object(),"chat",sprintf("我被%s杀了，同学们要为我报仇啊！",ob->name(1)));
        ::die();
}
