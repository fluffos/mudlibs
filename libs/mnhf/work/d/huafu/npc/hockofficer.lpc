#include <ansi.h>

inherit NPC;
inherit F_PAWNOWNER;
inherit F_VENDOR;
void create() {
  set_name("邮局工作人员乙", ({ "vendor" }));
  set("gender", "女性");
  set("age", 29);
  set("long",
    "不管怎么说，跟隔壁那个比，她还算比较善良的。\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  set("per", 30);
  set("no_arrest", 1);
  set_skill("unarmed", 200);
  set("richness", 50000);
  set_skill("dodge", 200);
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_value", "value");
  add_action("do_pawn", "pawn");
  add_action("do_sell", "sell");
  add_action("do_redeem", "redeem");
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("gender") == "男性") {
    switch (random(5)) {
      case 0:
        message_vision("$N和气地说道：哎呦呦呦呦．．．这位" + RANK_D->query_respect(ob) +
          "，你也来寄存东西呀！\n", this_object(), ob);

        break;
      case 1:
        message_vision("$N抬头望了$n一眼，笑咪咪地说道：这位" + RANK_D->query_respect(ob) +
          "，你要寄存什么？\n", this_object(), ob);
        break;
    }
  } else {
    switch (random(5)) {
      case 0:
        message_vision("$N瞥$n一眼，说道：这位" + RANK_D->query_respect(ob) +
          "，两个字形容你：可爱，可怜……\n", this_object(), ob);

        break;
    }


  }
}

int accept_object(object who, object ob) {
  message_vision("$N对$n说到：谢谢。\n", this_object(), who);
  return 1;
}
