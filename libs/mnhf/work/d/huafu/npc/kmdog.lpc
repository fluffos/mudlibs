// Npc:/d/huafu/kmdog.c
// 守门保安，还算有用

#include <ansi.h>
inherit NPC;
void create() {
  set_name("守门保安", ({ "kmdog", "baoan" }));
  set("long",
    "这是个正在执行守门任务的保安，虽然和许多学生比起来，保安们的学识\n"
    "实在平常，但他们是有校规撑腰的保安，谁也不轻易地招惹他们。\n"
    "[31m你最好也不要招惹他们。 [37m\n");
  set("attitude", "heroism");
  set("pursuer", 1);
  set("vendetta_mark", "authority");
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("class", "huafu");
  set("combat_exp", 100000 + random(4000000));
  set("chat_chance_combat", 45);
  set("chat_msg_combat", ({
    "保安喝道：别做梦了，我绝不收受贿赂！\n",
    "保安喝道：大胆学生，竟敢逃离学校？反了！反了！\n",
    (: perform_action, "dodge.shiyan" :),
  }));

  set_skill("unarmed", 70 + random(100));
  set_skill("spear", 10 + random(50));
  set_skill("parry", 70 + random(100));
  set_skill("dodge", 70 + random(100));
  set_skill("move", 100 + random(100));
  set_skill("yuwen", 151);
  set_skill("huaxue", 151);
  map_skill("dodge", "huaxue");
  map_skill("unarmed", "yuwen");
  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 30 + random(200));
  set_temp("apply/armor", 70);
  set_temp("apply/move", 100);

  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
}

int accept_object(object who, object ob) {
  if ((int)ob->value() >= 500000) {
    say("保安呵呵的笑道：好说，好说...\n");
    who->set("vendetta/authority", 0);
    who->remove_all_killer();
    return 1;
  } else {
    say("保安说道：这点钱还不够大爷喝酒的呢！\n");
    return 0;
  }
  return 0;
}
