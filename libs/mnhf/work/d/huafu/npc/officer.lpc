// post_officer.c

inherit NPC;

string send_mail();
string receive_mail();

void create() {
  set_name("邮局工作人员甲", ({ "officer", "post officer" }));
  set("gender", "女性");
  set("age", 43);
  set("long",
    "这个工作人员态度差得出了名，但还年年被评为先进工作者，\n");
  set("combat_exp", 800);
  set("attitude", "friendly");
  set("inquiry", ([
    "邮局": "没错... 这里就是石牌邮局，要寄信就快点，别磨磨蹭蹭的！",
    "寄信": (: send_mail :),
    "收信": (: receive_mail :),
    "mail": (: receive_mail :),
  ]));
  set_skill("literate", 70);
  setup();
  add_money("silver", 70);
}

string send_mail() {
  object mbox;

  if (this_player()->query_temp("mbox_ob"))
    return "不是给了你信箱了吗？！不懂？问阿飞去!\n";
  if (!environment()
    || base_name(environment()) != query("startroom"))
    return "等一下再来！别堵着门口！\n";
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  return "寄信？喏，这是你的信箱，寄信的方法问阿飞去！别来烦我！\n";
}

string receive_mail() {
  object mbox;

  if (this_player()->query_temp("mbox_ob"))
    return "不是给了你信箱了吗？！不懂？问阿飞去!\n";
  if (!environment()
    || base_name(environment()) != query("startroom"))
    return "等一下再来！别堵着门口！\n";
  seteuid(getuid());
  mbox = new(MAILBOX_OB);
  mbox->move(this_player());
  return "收信？喏，这是你的信箱，收信的方法问阿飞去！别来烦我！\n";
}
