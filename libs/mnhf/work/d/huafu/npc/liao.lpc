// Npc: /d/huafu/npc/liao.c 廖要粮
// 负责杀小流氓的任务
inherit NPC;
#include <ansi.h>
int ask_job();
void create()
{
        set_name(WHT"廖要粮"NOR, ({ "liao yaoliang","liao" }) );
        set("gender", "男性" );
        set("age", 45);
        set("title", GRN "不要受弯道的诱导" NOR);
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 27);
        set("int", 27);
        set("intellgent",1);
        set("attitude", "peaceful");
        set("chat_chance", 20);
        set("chat_msg", ({
                (: random_move :),
        }) );
        set("max_atman", 300);
        set("atman", 300);
        set("max_force", 3000);
	set("class","huafu");
        set("force", 3000);
        set("max_mana", 300);
        set("mana", 300);
        set("long",     "廖要粮是学生处副主任之一。\n");
        set("combat_exp", 999999);
        set_skill("unarmed", 120);
        set_skill("throwing", 100);
        set_skill("dodge", 100);
        set_skill("force", 130);
        set_skill("parry", 150);
        set_skill("literate", 70);
        set_skill("wuli", 100);
        set_skill("yuwen", 80);
        set_skill("huaxue", 10);
        map_skill("unarmed", "yuwen");
        map_skill("dodge", "huaxue");
        map_skill("parry", "yuwen");
        map_skill("force", "wuli");
        set("inquiry", ([
                "小流氓" : (: ask_job :),
                "工作" : (: ask_job :),
                "job" : (: ask_job :),
]));
        setup();
        carry_object(__DIR__"obj/fenbi")->wield();
        carry_object(__DIR__"obj/hfcloth")->wear();
}
int ask_job()
{
	object me;
	me=this_player();
	if (me->query_temp("kill_liumang")==0){
	message_vision("廖要粮缓缓说道：“$N，你真的想为我分忧？那就去把那些讨厌的小流氓给杀了！再回来找我！”\n", me);
	me->set_temp("kill_liumang",1);
	return 1;}
	else if (me->query_temp("kill_liumang")==1){
	message_vision("廖要粮哈哈大笑：“那些小流氓平日为非作歹，想不到还有今天！小同学，干得好啊干得好！”\n", me);
	me->delete_temp("kill_liumang");
	me->add("combat_exp",50+random(100));
	me->add("potential",random(50));
	write("廖要粮奖励了你一些学分和潜能！\n");
	return 1;}
	return 0;
}
