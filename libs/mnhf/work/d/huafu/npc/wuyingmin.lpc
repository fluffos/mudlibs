// Npc:/d/huafu/wuyingmin.c 吴瘾酩
// 有关值日工作以及正负校长谜题

inherit NPC;
#include <ansi.h>
int do_zhiri();
void create()
{
	set_name(CYN"吴瘾酩"NOR, ({ "headwu","wu" }) );
	set("gender", "男性" );
	set("age", 52);
	set("long",
		"这位光头伯伯正笑咪咪地闲著，还不时用手拍拍你的头。\n");
	set("combat_exp", 500000);
	set("attitude", "friendly");
                set("title","华师附中校长");
	set("rank_info/respect", "光头伯伯");
	set("zhiri", 1);
	set("class","huafu");
	set_skill("unarmed", 80);
	set_skill("sword", 100);
	set_skill("force", 100);
	set_skill("parry", 100);
	set_skill("dodge", 100);
	set_skill("literate", 100);
	set_skill("yuwen", 100);
	map_skill("unarmed","yuwen");
	set_skill("huaxue", 100);
	map_skill("dodge","huaxue");
	set("inquiry", ([
            "值日": (: do_zhiri :),
            "duty": (: do_zhiri :),
        ]) );

	setup();
}

void init()
{	
	object ob;


	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
			say( "吴颖民笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，欢迎你来到华师附中。\n");
			break;
		case 1:
			say( "吴颖民用脖子上的毛巾擦了擦皮鞋，说道：这位" + RANK_D->query_respect(ob)
				+ "，欢迎欢迎，热烈欢迎！\n");
			break;
		case 2:
			say( "吴颖民说道：这位" + RANK_D->query_respect(ob)
				+ "，你要坚决拥护党中央的领导哦！\n");
			break;
	}
}
int do_zhiri()
{
        object me = this_player();
        if ( me->query_temp("zhiri"))
        {
               if (time() - me->query_temp("zhiri/time") > 300)
               {
                      message_vision("$N对着$n说：你去哪里值日了？这么久！肯定趴哪打嗑睡了！\n", this_object(), me);
                      command("slap "+me->query("id"));
                      return 1;
               }
               if (!me->query_temp("zhiri/juqing"))
               {
                      message_vision("$N对着$n说：你聚清园都没去看看？这算值的什么日？\n", this_object(), me);
                      return 1;
               }
               if (!me->query_temp("zhiri/zhgate"))
               {
                      message_vision("$N对着$n说：你正门没去看看？这算值的什么日？\n", this_object(), me);
                      return 1;
               }
               if (!me->query_temp("zhiri/hgate"))
               {
                      message_vision("$N对着$n说：你后门没去看看？这算值的什么日？\n", this_object(), me);
                      return 1;
               }
               if (!me->query_temp("zhiri/elou"))
               {
                      message_vision("$N对着$n说：你怎么没去东教学楼？这算值的什么日？\n", this_object(), me);
                      return 1;
               }
               if (!me->query_temp("zhiri/wlou"))
               {
                      message_vision("$N对着$n说：你到了西教学楼去了？这算值的什么日？\n", this_object(), me);
                      return 1;
               }
               if (!me->query_temp("zhiri/panda"))
               {
                      message_vision("$N对着$n说：你到奥校楼去看过了？这算值的什么日？\n", this_object(), me);
                      return 1;
               }
               message_vision("$N对着$n说：不错，辛苦了。你这就去休息去吧。\n", this_object(), me);
               me->delete_temp("zhiri");                      
               me->add("combat_exp", random(100));
	add("zhiri", 1);
               return 1;
        }
        else
        {
               if ( query("zhiri") > 3)
               {
                      message_vision("$N对着$n说：今天已经有人值日去了。你明天再来吧。\n", this_object(), me);
                      return 1;
               }
               if( me->query("family/family_name") != "华师附中")
               {
                      message_vision("$N对着$n大喝一声：本校学生才能值日。你是哪来的奸细？\n", this_object(), me);
                      this_object()->kill_ob(me);
                      return 1;
               }
               else
               {
                      add("zhiri", -1);
                      message_vision("$N对着$n说：本校学生都应该值日。你，很好，很好！这就去吧。\n", this_object(), me);
                      me->set_temp("zhiri/start", 1);
                      me->set_temp("zhiri/time", time());
                      return 1;
               }
        }
}
void die()
{
        object ob;
        if( !ob = query_temp("last_damage_from") )
                ob = this_player(1);
        if(ob){ 
        ob->set_temp("killed_headmaster",1);
        CHANNEL_D->do_channel(this_object(),"chat",sprintf("我被%s杀了，大家为我报仇啊！",ob->name(1)));
        if (ob->query_temp("kill_headmaster")){
        ob->delete_temp("kill_headmaster");
        tell_object(ob,WHT"你干掉了郑吃请的眼中钉，倒是可以去问问他有没有奖赏。\n"NOR);}}
        ::die();
}