inherit NPC;
void create()
{
        set_name("法轮邪教教徒", ({ "falun tu", "tu"}) );
        set("gender", "女性" );
        set("age", 10+random(50));
        set("long", "这是法轮邪教的一名虔诚的教徒。\n");
        set("combat_exp", 8000+random(5000));
        set("attitude", "heroism");
        set_skill("unarmed", 15+random(30));
        set_skill("falun-strike",15+random(30));
        set_skill("falun-steps",10+random(10));
        set_skill("dodge", 10+random(30));
        map_skill("dodge","falun-steps");
        map_skill("unarmed","falun-strike");
	set("class","falun");
        create_family("法轮邪教", 3, "教徒");
	setup();
	add_money("silver", 15);
        carry_object(__DIR__"obj/yellowrobe")->wear();
}

