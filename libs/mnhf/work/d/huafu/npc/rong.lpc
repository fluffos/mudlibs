inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name(RED "熔尸红" NOR, ({ "rong shihong", "rong", "et" }));
  set("nickname", WHT "NO.1" NOR);
  set("gender", "男性");
  set("age", 16);
  set("int", 40);
  set("spi", 21);
  set("cor", 15);
  set("class", "huafu");
  set("con", 20);
  set("per", 15);
  set("str", 30);
  set("attitude", "peaceful");
  set("max_force", 9500);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);
  set("max_gin", 5000);
  set("max_kee", 100000);
  set("max_sen", 500);
  set("long",
    "熔尸红总是考第一，所以人称“E.T”，但人看起来却和普通人没什么不同，
除了有时会刻意模仿一班的学生之外，其余的打扮都是在普通不过的附中人
的装束，唯一可惜的是，他除了学习，就找不到什么优点了。\n"
  );

  create_family("华师附中", 45, "掌门弟子");
  set("combat_exp", 1100000);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "sword.gedebahe" :),
    (: perform_action, "dodge.shiyan" :),
  }));

  set_skill("move", 250);
  set_skill("blade", 250);
  set_skill("parry", 250);
  set_skill("dodge", 250);
  set_skill("force", 250);
  set_skill("unarmed", 250);
  set_skill("wuli", 250);
  set_skill("zhengzhi", 250);
  set_skill("literate", 250);
  set_skill("sword", 250);
  set_skill("shuxue", 250);
  set_skill("yuwen", 250);
  set_skill("huaxue", 250);
  map_skill("force", "wuli");
  map_skill("parry", "shuxue");
  map_skill("sword", "shuxue");
  map_skill("dodge", "huaxue");
  map_skill("move", "huaxue");
  map_skill("blade", "zhengzhi");

  setup();
  carry_object("/d/huafu/obj/saozou")->wield();
  carry_object("/obj/cloth")->wear();
}


void attempt_apprentice(object ob) {
  call_out("do_recruit", 0, ob);
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "huafu");
}
void do_recruit(object ob) {
  command("smile");
  command("say 很好，很好，很好。");
  command("recruit " + ob->query("id"));
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 3200) {
    student->set("title", "华附初一学生");
    return;
  } else if (exp <= 6400) {
    student->set("title", "华附初二学生");
    return;
  } else if (exp <= 12800) {
    student->set("title", "华附初三学生");
    return;
  } else if (exp <= 25600) {
    student->set("title", "华附高一学生");
    return;
  } else if (exp <= 51200) {
    student->set("title", "华附高二学生");
    return;
  } else if (exp <= 102400) {
    student->set("title", "华附高三学生");
    return;
  } else if (exp <= 153600) {
    student->set("title", "华附常胜将军");
    return;
  } else if (exp <= 230400) {
    student->set("title", "华附不败神话");
    return;
  } else if (exp <= 345600) {
    student->set("title", "华附天才中的天才");
    return;
  } else if (exp <= 518700) {
    student->set("title", "华附第一聪明人");
    return;
  } else if (exp <= 2624400) {
    student->set("title", "华附荣诗弘第二");
    return;
  } else
    student->set("title", "打遍华附无敌手");
  return;

}
