// Npc:/d/huafu/npc/tofu.c
// 负责器材室的工作（绝大部分函数在他身上）
/*有关器材室借器材由一点要注意的就是所有的记号是
   用set/add而不是用set_temp/add_temp，之所
   以这样是想让玩家上次压的钱下次连进来还有用，结
   果就造成了，借的东西假如你不小心丢掉了（比如说
   退出）就无法再借东西了，有关这个问题的解决我是
   采用增加一个accept_object()函数收玩家的钱，他
   丢掉了要自己负责嘛，收了钱就帮他把那个借了某物
   的标记去掉。*/

inherit NPC;
#include <ansi.h>
int do_list(string arg);
int do_ya(int arg);
int do_jie(string arg);
int do_huan(string arg);
string ask_money();
void create()
{
	set_name("豆腐乳", ({"dou furu","doufu", "tofu","fu","teacher"}) );
	set("title", "体育老师");
	set("gender", "男性" );
	set("age",47);
	set("int", 26);
	set("str", 56);
	set("combat_exp",5000000);
	set("long",
		"他是一名体育老师，负责管理器材室的工作。\n");
	set("attitude", "peaceful");
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_skill("move", 100);
	set_skill("unarmed", 100);
	set("class","huafu");
	set("borrow_goods", ([
                __DIR__"obj/pingpong" : 10,
                __DIR__"obj/football" : 20,
                __DIR__"obj/basketball" : 20,
                __DIR__"obj/shadai" : 20,
                __DIR__"obj/badminton" : 30,
	]) );
 	set("inquiry", ([
                "抵押" : (: ask_money :),
                "money" : (: ask_money :),
                "押金" : (: ask_money :),
]));
	setup();
}
void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_list", "list");
	add_action("do_jie", "jie");
	add_action("do_jie", "borrow");
	add_action("do_ya", "ya");
	add_action("do_return", "return");
	add_action("do_return", "huan");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
message_vision("$N警惕的望了$n一眼。\n",this_object(),ob);
			break;
		case 1:
message_vision("$N笑道：哼，"+RANK_D->query_rude(ob)+
"，就凭你，也来借东西？\n",this_object(),ob);
			break;
		case 2:
message_vision("$N说道：你如果想知道你一共抵押了多少钱，就问我"WHT"（ask fu about 抵押）"NOR"吧。\n",this_object());
	}
}
string ask_money()
{
	object me=this_player();
	string money=chinese_number(me->query("qicai/yaed")/100);
	if (me->query("qicai/yaed")){
	return "“你一共压了"+money+"元钱在我这里。”";
	}
	else return "“你还没有在我抵押什么吧？”";
}
string price_string(int v)
{
	if( v%10000 == 0 )
		return (v/10000) + "00元";
	if( v%100 == 0 )
		return (v/100) + "元";
	return v + "分";
}

// 类似商人的list的列表功能。
int do_list(string arg)
{
	mapping goods;
	string list, *name;
	int i;

	if( !mapp(goods = query("borrow_goods")) ) return 0;
	if( arg && !this_object()->id(arg) ) return 0;
	name = keys(goods);
	if(!sizeof(name))
		return notify_fail("器材室的东西全部被借光了。\n");
	list = "你可以借下列这些东西：\n";
		list += sprintf(CYN"≡"YEL"─器材名称─器材ＩＤ───────借用押金────剩余数量─────────"CYN"≡\n"NOR);
	for(i=0; i<sizeof(name); i++)
	list += sprintf("  %-12s %-20s ：%-10s  ：%d%s\n",
			name[i]->query("name"),name[i]->query("id"),
			price_string(name[i]->query("value")),goods[name[i]],name[i]->query("unit"));
		list += sprintf(CYN"≡"YEL"────────────────────────────%-6s───────"CYN"≡\n"NOR,
			environment(this_object())->query("short"));
	write(list);
	return 1;	
}
int do_jie(string arg)
{
	object me=this_player();
	object obj;
	int value,i;
	mapping goods;
	string ob_file;
	if (me->query("qicai/jieed_obj"))
	return notify_fail("豆腐恼怒的骂道：“什么？你上次借的东西还没还，又想借？！”\n");
	if (!arg) return notify_fail("豆腐恼怒的问道：“借什么？说清楚点！”\n");
	if (arg!="shadai"&&arg!="basketball"&&arg!="football"&&arg!="badminton"&&arg!="pingpong")
		return notify_fail("豆腐恼怒的问道：“你要借什么？这里怎么可以借这件东西呀！”\n");
	obj=new("/d/huafu/npc/obj/"+arg);
	if (!obj) return notify_fail("豆腐疑惑的问道：“你要借什么？没有这件东西呀！”\n");
	value=obj->query("value");
	if (!me->query("qicai/yaed")) return notify_fail("豆腐大吼一声：“没交押金就想拿走？想得美！\n");
	if (me->query("qicai/yaed")<value)
	return notify_fail("豆腐慢条斯理的说道：“你交的押金还不够，要"+chinese_number(obj->query("value")/100)+"元钱才行。\n");
else {
	obj->move(me);
	me->add("qicai/yaed",-value);
	me->set("qicai/jieed_obj",arg);
	me->set("qicai/time",time());
	goods = query("borrow_goods");
	ob_file="/d/huafu/npc/obj/"+arg;
//	write(""+ob_file);
	goods[ob_file]--; // 借的时候要注意在mapping 中减去一个该物品。
	if(goods[ob_file] <= 0)	map_delete(goods,ob_file);// 像卖东西的list一样，当那件东西的数量达到0时，就从列表里删去
	message_vision("豆腐递给$N一"+obj->query("unit")+obj->query("name")+"，说道：“拿好，小心别丢了！”\n",me);
	return 1;
	}
}

// 压的东西即可以是钱，也可以是物品，钱的价值是根据value()函数计算的，
// 所以这里就需要支持数量的指定。当然物品不能分开压上，所以我就用该物品
// 上是否有money_id属性来判断是不是钱。而物品的价值是根据query("value")
// 得到的，一般值钱的东西都可以拿来压，我还没有想到可以加什么限制（比如食物
// 不能拿来压？）
int do_ya(string arg)
{
	object me=this_player();
	int value,amount,oldvalue;
	object obj;
	string item;
	if (me->is_busy()) return notify_fail("你现在正忙着呢！\n");
	if (me->is_fighting()) return notify_fail("你正在战斗中，无暇顾及押金的问题！\n");
	if ( !living(me)) return notify_fail("你发疯了？\n");
	if (!arg) return notify_fail("你要压什么？\n");
	if(sscanf(arg, "%d %s",amount, item)==2) {
		if (me->query("qicai/yaed_obj")) return notify_fail("你已经压了东西，不能再压钱下去。\n");
		if(!objectp(obj = present(item,me))) return notify_fail("你没有这样东西。\n");
		if( !obj->query_amount() ) return notify_fail( obj->name() + "不能被分开压上。\n");
		if( !obj->query("money_id") ) return notify_fail( obj->name() + "不是钱，不能分开压上。\n");
		if( amount < 1 ) return notify_fail("钱的数量至少是一。\n");
		if( amount > obj->query_amount() ) return notify_fail("你没有那么多的" + obj->name() + "。\n");
		else if( amount == (int)obj->query_amount() ) {
			message_vision("$N交给豆腐"+chinese_number(amount)+obj->query("base_unit")+obj->query("name")+"，当作押金。\n",me);
			me->add("qicai/yaed",value);
			destruct(obj);
			return 1;
		} else {
			oldvalue=obj->value();
//			write("原值："+oldvalue);
			obj->set_amount((int)obj->query_amount() - amount);
			value=oldvalue-obj->value();
//			write("现在值："+value);
			me->add("qicai/yaed",value);
			message_vision("$N交给豆腐"+chinese_number(amount)+obj->query("base_unit")+obj->query("name")+"，当作押金。\n",me);
			return 1;
		}
	}
	else {
	if(!objectp(obj=present(arg,me))) return notify_fail("你没有这样东西。\n");
	if (!obj->query("value")) return notify_fail("这样东西并不值钱。\n");
	value=obj->query("value");
	me->add("qicai/yaed",value);
	me->set("qicai/yaed_obj",base_name(obj));
	message_vision("$N交给豆腐一"+obj->query("unit")+obj->query("name")+"，当作抵押。\n",me);
	destruct(obj);
	return 1;
	}
}

// 这里会出一点小问题就是因为还东西有可能会出现存的数量，
// 还大于一开始在create()中设的数量的情况，不过也没太大
// 问题，反正一会之后就会reset，不过谁想改也可以改一改，
// 在goods[ob_file]++处加一个判定，假如大于等于多少就
// 不加了，不过好像挺麻烦，怎么返回create()时的值呢？

int do_return(string arg)
{
	object me=this_player();
	string jieed_obj=me->query("qicai/jieed_obj");
	string ob_file="/d/huafu/npc/obj/"+arg;
	object obj,yaed_obj,silver;
	mapping goods= query("borrow_goods");
	if (!arg||arg!=jieed_obj) return notify_fail("豆腐大惑不解的望着你，好像在说：“你并没有借过这个东西吧？\n");
	if(!objectp(obj=present(arg,me))) return notify_fail("你没有这样东西。\n");
	else if (time()-me->query("qicai/time")>500) {
	message_vision("豆腐一看"+obj->query("name")+"，火了，怒道：“这个东西你怎么现在才还？！你押的钱物没收了！”\n",me);
//	me->add("qicai/yaed",-(obj->query("value")));
	me->delete("qicai/yaed_obj");
	me->delete("qicai/time");
	me->delete("qicai/jieed_obj");
	goods[ob_file]++; // 假如一样东西已经被前面的程序在列表中删去了，这里一加，又会重新出现（废话）
	destruct(obj);
	return 1;
	}
	else {
	message_vision("豆腐一看"+obj->query("name")+"，笑道：“还的还挺准时！呵呵。”\n",me);
		if (me->query("qicai/yaed_obj")){
		yaed_obj=new(me->query("qicai/yaed_obj"));
		me->add("qicai/yaed",yaed_obj->query("value"));
		yaed_obj->move(me);
		me->delete("qicai/yaed_obj");
		me->delete("qicai/time");
		me->delete("qicai/jieed_obj");
		goods[ob_file]++;
		message_vision("豆腐递给$N一"+yaed_obj->query("unit")+yaed_obj->query("name")+"，说道：“呐，你压的东西还给你。”\n",me);
		destruct(obj);
		return 1;
		}
		else {
		message_vision("豆腐爱理不理的对$N说道：“嗯，行了，这是你的钱，按百分之九十还给你。”\n",me);
		silver=new(SILVER_OB);
		silver->set_amount(obj->query("value")*9/1000);
		silver->move(me);
//		me->add("qicai/yaed",obj->query("value"));
		me->delete("qicai/time");
		me->delete("qicai/jieed_obj");
		goods[ob_file]++;
		destruct(obj);
		return 1;
		}
	}
}

// 假如借东西的人不小心或者因为退出搞丢了那个东西……
int accept_object(object who, object ob)
{
	if (!who->query("qicai/jieed_obj")) {
	say("豆腐乳说道：“开什么玩笑，你都没在器材是借过东西，给我钱干什么？\n");
	return 0;
	}
	if((int)ob->value()>=TOP_D->get_score(who)/2) {
	say("豆腐乳呵呵的笑道：“哈哈，小同学，看你有诚意，好吧，\n这次弄丢器材的事就算了！但你的押金，哼，我看你也不需要了吧？”\n");
                who->delete("qicai/jieed_obj");
	who->delete("qicai/time");
                return 1;
                } else {
                    say("豆腐乳说道：“你想干什么？行贿？NOWAY！\n");
                        return 0;
                }
        return 0;
} 