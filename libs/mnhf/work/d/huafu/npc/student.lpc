inherit NPC;

void create() {
  set_name("学生", ({ "student", "sheng" }));
  set("gender", "男性");
  set("age", 15);
  set("long", "这是一位普普通通的华附学生。\n");
  set("combat_exp", 5000 + random(5000));
  set("attitude", "herosim");
  set("class", "huafu");
  set_skill("unarmed", 50 + random(30));
  set_skill("dodge", 50 + random(30));
  set("chat_chance", 20);
  set("chat_msg", ({
    "学生摇头晃脑地说：“环滁皆山也，其西南诸峰．．．\n",
    (: random_move :),
  }));

  setup();
  add_money("silver", 50 + random(20));
  carry_object(__DIR__ "obj/xiaofu")->wear();
}
void die() {
  object ob;
  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);
  if (ob) {
    CHANNEL_D->do_channel(this_object(), "chat", sprintf("我被%s杀了，同学们要为我报仇啊！", ob->name(1)));
    ::die();
  }
}
