// waiter.c

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create() {
  set_name("天桥小贩", ({ "seller" }));
  set("gender", "男性");
  set("age", 31);
  set("long",
    "这位可怜的小贩叫破了喉咙，可还是没人来买他的东西。\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("per", 10);
  set("vendor_goods", ([
    __DIR__ "obj/dbcd": 10,
    __DIR__ "obj/mingbi": 20,
    __DIR__ "obj/xshzheng": 20,
    __DIR__ "obj/blade": 20,
    "/d/huafu/obj/sleepbag": 30,
  ]));
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(8)) {
    case 0:
      message_vision("$N对$n说道：小同学，买什么？\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N望了$n一眼，再一扫货物，道：当然是真的啦！哈哈哈哈哈哈哈……\n", this_object(), ob);
      break;
  }
}
