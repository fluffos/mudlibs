// teacher.c

inherit NPC;

void create() {
  int i, amun;
  string *order = ({ "张", "王", "李", "赵", "孙", "徐", "郑", "周", "吴",
    "关", "沈", "杨", "苗", "江", "罗", "魏", "谢", "林", "柳", "朱" });
  set_name(order[random(20)] + "老师", ({ "teacher", "laoshi" }));
  set("title", "考死人不赔命");
  set("gender", "女性");
  set("age", random(20) + 20);
  set("int", 36);
  set("str", 36);
  set("class", "huafu");
  set("long",
    "她是一名普普通通的华附教师，但如果你想向她学点什么功课的话，它还是乐意教你的。\n");
  set("chat_chance", 15);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("skill_public", 1);
  set("attitude", "peaceful");
  set_skill("literate", 40);
  set("combat_exp", 10000 + random(50));
  set_skill("dodge", random(5));
  setup();
}
int recognize_apprentice(object ob) {
  return 1;
}
void die() {
  object ob;
  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);
  if (ob) {
    CHANNEL_D->do_channel(this_object(), "chat", sprintf("我被%s杀了，同志们要为我报仇啊！", ob->name(1)));
    ::die();
  } else {
    CHANNEL_D->do_channel(
      this_object(),
      "chat",
      sprintf("毒！毒！原来%s有毒！大家要小心啊……", environment(this_object())->query("short"))
    );
    ::die();
  }
}
