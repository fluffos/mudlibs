// kuliman.c

inherit NPC;

void create() {
  set_name("乒乓球运动员", ({ "player" }));
  set("gender", "男性");
  set("age", 22);
  set("long", "这个运动员正满头大汗气喘吁吁的在球场上打球。 \n");

  set("combat_exp", 1000);
  set("attitude", "heroism");
  set_skill("unarmed", 10);
  set_skill("parry", 10);
  set("class", "huafu");
  set_skill("dodge", 10);
  setup();
  add_money("silver", 1);
  carry_object(__DIR__ "obj/xshcloth")->wear();

}
