// guanliyuan.c
inherit NPC;
int go_dinglou(object);
void create() {
  set_name("电梯管理员", ({ "dianti guan", "guan", "dianti" }));
  set("long", "她就是这栋21层教工宿舍的管理员，你若要去顶楼，问问她有关坐电梯的事就行了。\n");
  set("gender", "女性");
  set("age", 52);
  set("int", 20);
  set("per", 15);
  set("cps", 20);
  set("gin", 200);
  set("max_gin", 200);
  set("eff_gin", 200);
  set("max_kee", 400);
  set("eff_kee", 400);
  set("kee", 400);
  set("max_sen", 500);
  set("sen", 500);
  set("class", "huafu");
  set("eff_sen", 500);
  set("combat_exp", 50000);
  set("max_atman", 300);
  set("atman", 300);
  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10);
  set("attitude", "friendly");
  set("inquiry", ([
    "坐电梯": (: go_dinglou :),
    "电梯": (: go_dinglou :),
  ]));
  set("chat_chance", 5);
  set("chat_msg", ({
    "电梯管理员阴阴一笑，道：“小同学，这里是教工宿舍，没事别瞎跑！”\n",
    "电梯管理员笑道：“没有我，你怎么坐电梯？”\n",
    "电梯管理员问道：“你可是想坐电梯？”\n",
  }));

  setup();
  carry_object(__DIR__ "obj/hfcloth")->wear();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

int greeting(object me) {

  if (!me || environment(me) != environment()) return 1;
  command("sing3");
  return 1;
}
go_dinglou() {
  object me, dinglou;
  string myfile;
  me = this_player();
  if (!(dinglou = find_object("/d/huafu/dinglou")))
    dinglou = load_object("/d/huafu/dinglou");
  command("say 想坐电梯？好吧，我带你去。");
  tell_object(me, "电梯管理员带你进了电梯，胡乱按了几下按钮，你只觉得都快到天堂了，可电梯还没停下。\n");
  me->move(dinglou);
  return 1;
}
