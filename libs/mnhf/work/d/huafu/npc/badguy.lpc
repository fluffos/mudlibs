// Npc:/d/huafu/npc/badguy.c
// 小流氓 很重要的一个npc，涉及一个job和natured的定时出现

#include <ansi.h>
inherit NPC;
void create()
{
        set_name("小流氓", ({ "liumang", "xiao liumang" }) );
        set("long",
"一个不在学校好好读书却出来打劫的家伙。\n");
        set("attitude", "aggressive");
        set("vendetta/authority",1);
        set("per", 1);
        set("intellgent",1);
	set("pursuer",1);
        set("combat_exp", 10000+random(400000));
	set("bellicosity", 10000);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                "小流氓喝道：哼哼！小同学，借点前来用用你不会反对吧？！\n",
                "小流氓笑道：不给？去死吧！\n",
		(: random_move :),
        }) );
        set("chat_chance", 80);
        set("chat_msg", ({
                (: random_move :),
        }) );

        set_skill("unarmed", 70+random(50));
        set_skill("blade", 70+random(50));
        set_skill("parry", 70+random(50));
        set_skill("dodge", 70+random(50));
        set_skill("move", 50+random(100));
        set_skill("falun-blade", 50+random(100));
        map_skill("blade","falun-blade");
        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/armor", 70);
        set_temp("apply/damage", 30+random(400));
        set_temp("apply/move", 100);

        setup();

        carry_object(__DIR__"obj/xshcloth")->wear();
        carry_object(__DIR__"obj/xblade")->wield();
}
void init()
{
        remove_call_out("hunting");
	if(!environment()->query("no_fight"))
        call_out("hunting",1);
}

void hunting()
{
	int i;
        object *ob;
        ob = all_inventory(environment());
        for(i=sizeof(ob)-1; i>=0; i--) {
                if( !ob[i]->is_character() || ob[i]==this_object() || !living(ob[i])) continue;
		if(ob[i]->query("vendetta/authority")) continue;
                kill_ob(ob[i]);
                ob[i]->fight(this_object());
        }
}
void die()
{
        object ob;
        if( !ob = query_temp("last_damage_from") )
                ob = this_player(1);
	if(ob){
        if(ob->query_temp("kill_liumang")) 
        ob->add_temp("kill_liumang",-1);
        CHANNEL_D->do_channel(this_object(),"chat",sprintf("我被%s杀了，老大，你们要为我报仇啊！",ob->name(1)));}
        ::die();
}