// keeper.c

inherit NPC;

void create() {
  set_name("生活指导", ({ "zhidao" }));
  set("gender", "女性");
  set("age", 44);
  set("long",

    "她就是初中的生活指导老师，来这个宿舍检查的，出了名的爱管闲事儿，爱找碴儿。\n");
  set("combat_exp", 1);
  set("class", "huafu");
  set("attitude", "friendly");
  setup();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("生活指导说道：这位" + RANK_D->query_respect(ob)
    + "，你有没有发现你这间宿舍还有什么做得不够的地方？\n");
}

int accept_object(object who, object ob) {
  int val;

  val = ob->value();
  if (!val)
    return notify_fail("生活指导皮笑肉不笑道：“这不是贿赂吗？这怎么可以？！”。\n");
  else if (val > 100) {
    if ((who->query("bellicosity") > 0)
      && (random(val / 10) > (int)who->query("kar")))
      who->add("bellicosity", -
        (random((int)who->query("kar")) + val / 1000));
  }
  say("生活指导小声对你说道：多谢这位" + RANK_D->query_respect(who)
    + "，嘿嘿，我一定帮你们宿舍美言几句。\n");

  return 1;
}
void die() {
  object ob;
  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);
  CHANNEL_D->do_channel(this_object(), "chat", sprintf("我被%s杀了，同志们要为我报仇啊！", ob->name(1)));
  ::die();
}
