// Room: /d/shaolin/zhonglou1.c
#include <ansi.h>

inherit ROOM;



string look_floor();
int do_sao(string arg);


void create()
{
	set("short", "钟楼一层");
	set("long", @LONG
这里是钟楼的第一层，一缕缕阳光从墙上的花砖缝隙里透射
进来，在青砖地上投下别致的光影，如同一格格棋盘相似。往上
看，长长的砖楼梯盘绕而上，似乎永无尽头。墙角，梯级都相当
洁净，看来经常有同学打扫。
LONG
	);

	set("exits", ([
		"westdown" : __DIR__"tyuguan",
		"up" : __DIR__"zhonglou2",
	]));
	set("coor/x",-50);
	set("coor/y",-20);
	set("coor/z",0);
	set("item_desc",([
		"floor"		:	(: look_floor :),
	]));

	set("objects",([
		__DIR__"npc/tiguan" : 1,
	]));
	setup();
}


void init()
{
	add_action("do_sao", "sao");
}

int do_sao(string arg)
{
	object room, me;
           me=this_player();
	

	if(!arg && arg != "di" && arg!="floor")
                return notify_fail("你要扫什么？\n");
	
	if(!present("broom", me))
                return notify_fail("没扫地的家伙怎么行？\n");
      
         if((int)me->query_temp("clean_floor1")>=2){
          return notify_fail("地下已经够干净不用扫了！\n"NOR);
}
          me->add("combat_exp",3+(random(8))); 
          me->add("potential",1+(random(3)));
          
        if((int)me->query("gin") <20)
                return notify_fail(RED"你已经太累了，还是歇歇吧！\n"NOR);
        message_vision(CYN"$N挥舞着大扫帚扫起地来。\n"NOR, me);
        write(CYN"眼前灰尘弥漫，你什么也看不见了。\n"NOR);
        message_vision(CYN"$N抹了一把汗，看了看自己干的结果，得意的笑了。\n"NOR, me);
        me->receive_damage("gin", 20+(random(15)));
	  me->add_temp("clean_floor1", 1);
        return 1;
        }
 


string look_floor()
{
	return
	"这是木制的地板，地下很脏，看来今天没人打扫。\n";
}
