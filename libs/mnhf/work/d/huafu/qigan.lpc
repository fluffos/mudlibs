inherit ROOM;
void create()
#include <ansi.h>
{
        set("short", "国旗旗杆");
        set("long", @LONG
大操场的西面，就是每天升降国旗的旗杆了，一段台阶通向竖有三根旗杆的升旗台，
台上正中是最高的国旗旗杆，每天初三6班国旗班的同学都要来这里升旗。
LONG
        );
	set("valid_startroom",1);
        set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"playgrnd2",
  "northwest": __DIR__"tyuguan",
  "south": __DIR__"playgrnd4",
]));
        set("item_desc",([
"旗杆":"飘扬着一面五星红旗的高大旗杆。\n",
"国旗旗杆":"飘扬着一面五星红旗的高大旗杆。\n",
]));
	set("outdoors", "华师附中");
	set("coor/x",-60);
	set("coor/y",-40);
	set("coor/z",0);
	setup();
}
void init()
{
	object me=this_player();
	add_action("do_climb", "climb");
	if(me->query_temp("run/circle"))
	call_out("do_run",7,this_player());
}
int do_climb(string arg)
{
        object ob;
        object me;

        me = this_player();

 if ( !arg || ( arg != "旗杆" ) &&(!me->query("marks/奇妙的旗杆"))) {
 return notify_fail("你要爬什么？\n");
   }
else 
{
message_vision("$N趁大家不注意，三下两下竟爬到了旗杆顶上，还向下面的人群挥手致意！\n",me);
message_vision("一个声音突然响起来：“是那个吃了豹子胆的在上面！还不快给我下来！\n",me);
message_vision("$N吓得赶紧手忙脚乱的要爬下来，一不小心一脚踏空，竟从半空中摔了下来！\n",me);
me->add("gin",-random(500));
me->add("kee",-500);
	if (!(ob=find_object("/d/huafu/xiaoyishi")))
	ob=load_object("/d/huafu/xiaoyishi");
	me->move(ob);
message_vision(CYN"$N成功的破解了“奇妙的旗杆”谜题，获得了一些学分的奖励！\n"NOR,me);
me->add("combat_exp",25+random(10));
me->set("marks/奇妙的旗杆",1);
return 1;
}
return 1;
}
void do_run(object me)
{
	int i=random(me->query_skill("force")/2);
	if(!me || environment(me) != this_object())
                return;
	tell_object(me,"你深吸一口气，奋力向前跑去……\n");
	me->receive_damage("kee",i);
	if (random(3)>2) me->improve_skill("move",random(me->query("agi"))/2);
	me->add_temp("run/circle",-1);
	me->move(__DIR__"playgrnd4");
}