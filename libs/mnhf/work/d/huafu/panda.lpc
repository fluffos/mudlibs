inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "奥校楼");
  set("long", @LONG
这里就是广东省奥校所在地，同时也是全校每个年级一班上课的地方——奥校楼了，
因为是1997才完工的整座大楼显得比较新，也比较空旷，到了晚上，黑漆漆的很是怕人，
你不要以为一班的都是乖孩子，比如说最近，他们就在这里摆了个赌局，说是可以提高
数学水平云云。你若有兴趣，也可以一起玩玩。教室门口的木门(men)上就写着规则。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "swimrm",
    "west": __DIR__ "ehroad",
    "south": __DIR__ "ssushe",
  ]));
  set("valid_startroom", 1);
  set("objects", ([
    __DIR__ "npc/fjcong": 1,
  ]));
  set("item_desc", ([
    "men": @TEXT


骰子的赌法：

ｂｅｔ　＜种类＞　＜人民币量＞

种类：　０，１，２，３到１８
０：　		赌小	（３－１０）	一赔一
１：  		赌大	（１１－１８）	一赔一
２：　		赌围骰	（三粒骰子同点）一赔三十六
３－１８	赌单点  		一赔八

例子：
ｂｅｔ　０　５０
赌五十元在小上

TEXT
  ]));
  set("coor/x", 40);
  set("coor/y", 60);
  set("coor/z", 0);
  setup();
}
void init() {
  object me;
  me = this_player();
  if (me->query_temp("zhiri")) {
    me->set_temp("zhiri/panda", 1);
    message_vision(WHT "$N按照校长的指示，在奥校楼逛了一圈。\n" NOR, me);
  }
  if (me->query("gamble/amount")) {
    me->delete("gamble/amount");
    me->decrease_skill("betting", 1);
  }
}
