// inn.c

inherit ROOM;


void create()
{
	set("short", "邮局小件寄存收买处");
	set("long", @LONG
这里就是邮局开办的小件寄存收买处了，专门供顾客把小件物品暂时寄存在这里
或者拿出来换点钱花，但名声却不大好，如果你要寄存东西，最好留点心。门口挂着
一块牌子（ｓｉｇｎ）。
LONG
	);
		set("valid_startroom",1);
	set("exits", ([
  "east" : __DIR__"youju",
  "west" : __DIR__"mdc",
	]) );
        set("item_desc", ([
                "sign": @TEXT
这里是邮局小件寄存收买处，目前我们提供的服务有：

pawn	    寄存货物。
value       估价货物。
sell        卖断货物。
redeem      取回货物。

TEXT
        ]) );


	set("objects", ([
		__DIR__"npc/hockofficer" : 1,

			]) );


	set("coor/x",-20);
	set("coor/y",140);
	set("coor/z",0);
	setup();
}
