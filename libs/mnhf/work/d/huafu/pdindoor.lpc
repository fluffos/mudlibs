// jjgod 00.11.22
// Room:/d/huafu/pdindoor 室内跑道
// 为运动队小组设计
#include <ansi.h>
inherit ROOM;
int do_ju(string arg);
int do_jia(int arg);
int do_xie(string arg);
int do_look(string arg);
void create() {
  set("short", "室内跑道");
  set("long", @LONG
这是间长长的房子，十分宽阔，中间是长长的一条胶塑跑道。当下雨的时候，同学
们多半会来这里上课。室内跑道的上边就是主席台了。旁边的一个房间是器材室。也就
是借用体育器材的地方。最靠北边的地方，有不少高大威猛们在这里汗流浃背的苦练着
举重，看来他们是学校运动队的成员。地上有一些练习用的工具，墙边摆着一排杠铃
（gangling）和配重的铁饼（tiebing）。
LONG);
  set("exits", ([
    "up": __DIR__ "zhuxitai",
    "west": __DIR__ "desert",
    "east": __DIR__ "playgrnd3",
    "north": __DIR__ "playgrnd1",
    "enter": __DIR__ "qicairm",
  ]));
  set("item_desc", ([
    "gangling": "一个杠铃，供人举起（ju）练习臂力。\n",
    "tiebing": "一些铁饼，供人加在杠铃上（jia）练习臂力。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/pangzi": 1,
  ]));

  set("valid_startroom", 1);
  set("coor/x", 0);
  set("coor/y", -60);
  set("coor/z", 0);
  setup();
}

void init() {
  object me = this_player();
  add_action("do_ju", "ju");
  add_action("do_jia", "jia");
  add_action("do_xie", "xie");
  add_action("do_look", "look");
  if (me->query_temp("run/circle"))
    call_out("do_run", random(7), this_player());
}
int do_ju(string arg) {
  object me = this_player();
  int costj, costq;
  int num = (me->query_skill("unarmed", 1) + me->query("str")) / 2;
  int weight = me->query_temp("weight");
  if (me->is_busy()) return notify_fail("你现在正忙着呢！\n");
  if (me->is_fighting()) return notify_fail("你正在战斗中，无法专心练功！\n");
  if (!living(me)) return notify_fail("你发疯了？\n");
  if (objectp(me->query_temp("weapon"))) return notify_fail("只有空手才能举杠铃。\n");
  if (!arg || arg != "gangling") return notify_fail("你要举什么？举手吗？\n");
  costj = random((int)me->query("con")) + 1;
  costq = random((int)me->query("str")) + 1;
  if (num < weight) {
    return notify_fail("你奋力抓起杠铃一举！可惜没举起来。\n看来你现在至少需要减去" + chinese_number(weight - num) + "公斤的重量才行。\n");
  }
  if ((int)me->query("gin") < costj || (int)me->query("kee") < costq) {
    message_vision("$N马步一松，一不小心杠铃掉了下来，险些脑袋不保！\n", me);
    me->unconcious();
    return 1;
  }
  me->receive_damage("gin", costj);
  me->receive_damage("kee", costq);
  message_vision("$N站好马步，运气于臂，缓缓举起杠铃。\n", me);
  if (me->query("guild/name") == "运动队" && random(10) > 6 ||
    me->query("guild/name") != "运动队" && me->query_skill("unarmed", 1) < 50 && random(10) > 6) {
    write(MAG "你在和举重的过程中领悟了不少扑击格斗之技！\n" NOR);
    me->improve_skill("unarmed", me->query("int") / 5 + me->query_temp("weight") / 2);
    me->start_busy(2);
  }
  return 1;
}
int do_jia(string arg) {
  object me = this_player();
  int weight;
  if (me->is_busy()) return notify_fail("你现在正忙着呢！\n");
  if (me->is_fighting()) return notify_fail("你正在战斗中，无法专心练功！\n");
  if (!living(me)) return notify_fail("你发疯了？\n");
  if (!arg || sscanf(arg, "%d kilo", weight) != 1) return notify_fail("请指定一个数值，比如jia 10 kilo。\n");
  if (weight < 5) return notify_fail("增加的重量至少是五公斤！\n");
  if (weight % 5 != 0) return notify_fail("增加的铁饼重量只能是五的倍数！\n");
  me->add_temp("weight", weight);
  message_vision("$N弯下腰，从旁边搬来一个" + chinese_number(weight) + "公斤重的铁饼。\n加在杠铃上。\n", me);
  return 1;
}
int do_xie(string arg) {
  object me = this_player();
  int weight;
  if (me->is_busy()) return notify_fail("你现在正忙着呢！\n");
  if (me->is_fighting()) return notify_fail("你正在战斗中，无暇顾及杠铃上的铁饼！\n");
  if (!living(me)) return notify_fail("你发疯了？\n");
  if (!arg || sscanf(arg, "%d kilo", weight) != 1) return notify_fail("请指定一个数值，比如xie 10 kilo。\n");
  if (weight <= 0) return notify_fail("卸除的重量至少是一公斤！\n");
  if (me->query_temp("weight") < weight) return notify_fail("开什么玩笑，杠铃上面总共还没有" + chinese_number(weight) + "公斤！\n");
  //	write(weight);
  me->add_temp("weight", -weight);
  message_vision("$N弯下腰，从杠铃上卸下一个" + chinese_number(weight) + "公斤重的铁饼。\n", me);
  return 1;
}
int do_look(string arg) {
  object me = this_player();
  int weight = me->query_temp("weight");
  if (arg != "gangling") return 0;
  if (weight <= 0) return 0;
  write("这是个上面加有" + chinese_number(weight) + "公斤的铁饼的杠铃，你可以试着举(ju)一举或者\n把上面的铁饼卸(xie)掉。\n");
  return 1;
}
int valid_leave(object me, string dir) {
  if (me->query_temp("weight")) {
    message_vision(YEL "$N临走前卸掉了所有杠铃上的铁饼。\n" NOR, me);
    me->delete_temp("weight");
    return 1;
  } else return 1;
}
void do_run(object me) {
  int i = random(me->query_skill("force") / 2);
  if (!me || environment(me) != this_object())
    return;
  tell_object(me, "你深吸一口气，奋力向前跑去……\n");
  me->receive_damage("kee", i);
  if (random(3) > 2) { me->improve_skill("force", i); }
  me->add_temp("run/circle", -1);
  me->move(__DIR__ "playgrnd1");
}
