
inherit ROOM;

void create()
{
        set("short", "小卖部");
        set("long", @LONG
这个小卖部是华师附中里中卖东西最多，最快的地方。因为这里有不少同学们喜
欢的食品、饮料。这里好像随时都是挤得满满的，有的同学，每天都在这里吃午饭，
自然也抢去了饭堂不少生意。
LONG
        );
        set("exits", ([
		"east" : __DIR__"tyuguan",
        ]));
        set("objects", ([
                __DIR__"npc/seller": 1,
        ]) );
	set("valid_startroom",1);
        set("coor/x",-80);
	set("coor/y",-40);
	set("coor/z",20);
	setup();
        replace_program(ROOM);
}

