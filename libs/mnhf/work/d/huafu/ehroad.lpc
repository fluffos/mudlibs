// Room:/d/huafu/ehroad.c
// 环校东路，初学LPC时的小作品，现在懒的删掉了。
inherit ROOM;
void create() {
  set("short", "环校东路");
  set("long", @LONG
这条环校东路向东通向奥校楼，向南也可以前往宿舍，一般都比较冷清，但最
近因为芒果熟了，虽然品种很差，滋味儿也不好，但还是有不少同学在这里偷偷摸
摸的摘芒果吃。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "xhui",
    "south": __DIR__ "ehroad2",
    "east": __DIR__ "panda",
  ]));
  set("objects", ([
    __DIR__ "npc/student": 1,
  ]));
  set("item_desc", ([
    "tree": "这是一棵结着一大堆青黄不接的芒果的芒果树。\n",
  ]));
  set("valid_startroom", 1);
  set("outdoors", "华师附中");
  set("coor/x", -20);
  set("coor/y", 60);
  set("coor/z", 0);
  setup();
}
void init() {
  add_action("do_zhai", "zhai");
  add_action("do_zhai", "摘");
}
int do_zhai(string arg) {
  object ob;
  object me;

  me = this_player();

  if (!arg || (arg != "芒果")) {
    return notify_fail("你要摘什么？\n");
  } else {
    message_vision("$N踮起脚，从树上摘下一个芒果来。\n", me);
    ob = new(__DIR__ "obj/mangguo");
    ob->move(me);
    return 1;
  }
  return 1;
}
