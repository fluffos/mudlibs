// Room: /d/huafu/21loum.c
// 法论邪教迷宫

//inherit VRM_SERVER;
inherit "/adm/daemons/vrm_server";

void create()
{
	// 迷宫房间所继承的物件的档案名称。
	set_inherit_room( ROOM );

	//迷宫房间里的怪物。
	set_maze_npcs(__DIR__"npc/faluntu");

	//迷宫的单边长
	set_maze_long(5);

	//入口方向(出口在对面)
	set_entry_dir("west");

	//入口与区域的连接方向
	set_link_entry_dir("west");

	//入口与区域的连接档案名
	set_link_entry_room(__DIR__"playgrnd3");

	//出口与区域的连接方向
	set_link_exit_dir("east");

	//出口与区域的连接档案名
	set_link_exit_room(__DIR__"hgarden");

	//入口房间短描述
	set_entry_short("后门花园口");

	//入口房间描述
	set_entry_desc(@LONG
这里是后门花园的入口，虽然平时见到后门花园很小，但细细
一看其实不然，而且似乎内藏玄机，如果你不大会走迷宫就不要进
去了，万一困在里面出不来就不好了。但听说后门花园里有神秘的
法轮邪教出没，如果你想探一探险倒是不妨的。
LONG
);

	//出口房间短描述
	set_exit_short("小路尽头");

	//出口房间描述
	set_exit_desc(@LONG
你走到了小路尽头，眼见前面就是法轮邪教的根据地——后门花园
的中心了，赶快进去呀！
LONG
);

	//迷宫房间的短描述
	set_maze_room_short("后门花园");

	//迷宫房间的描述，如果有多条描述，制造每个房
	//间的时候会从中随机选择一个。
	set_maze_room_desc(@LONG
你似乎走到了一个莫名其妙的迷阵，本来看起来不大的后门花
园竟然变得这么奇怪，你怎么走也走不出去，也许你抱定向一个方
向走的信念会好一点吧。
LONG
);
	// 迷宫房间是否为户外房间？
	set_outdoors(1);
}
