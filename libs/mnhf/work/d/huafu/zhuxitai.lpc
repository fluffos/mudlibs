#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "主席台");
        set("long", @LONG
这里是华附大操场的主席台，每个星期一，校长都要在这里发表讲话，每逢校运会
这里也是各班大本营的所在，红、黄、蓝三色组成的座位显得很悦目，相比下面的操场
来说，这里是很高的了，如果谁敢纵身一跃，尸骨都很难找全。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "down" : __DIR__"pdindoor",
  "northdown" : __DIR__"playgrnd1",
  "westdown" : __DIR__"desert",
  "eastdown" : __DIR__"playgrnd3",
]));
        set("objects", ([
        __DIR__"npc/zhengfu" : 1,
        __DIR__"npc/student" : 3,
                        ]) );
	set("valid_startroom",1);
	set("coor/x",0);
	set("coor/y",-60);
	set("coor/z",20);
	setup();
}
void init()
{
        add_action("do_jump", "jump");
}
int do_jump(string arg)
{
        object ob;
        object me;
        me = this_player();
if (!me->query("marks/主席台的下面")){
message_vision("$N从主席台上向下纵身一跃，摔了个狗啃泥！\n",me);
me->add("gin",-350);
me->add("sen",-350);
me->move("/d/huafu/desert");
me->add("combat_exp",35+random(10));
me->set("marks/主席台的下面",1);
message_vision(CYN"$N成功的破解了“主席台的下面”谜题，获得了一些学分的奖励！\n"NOR,me);
return 1;}else
return notify_fail("你疯了？跳过了还跳？\n");
}
