// Room:/d/huafu/library.c
// 用于借书
inherit ROOM;
void create() {
  object con, item;
  set("short", "图书馆二楼开架书库");
  set("long", @LONG
华附学生学习的地方。靠窗是一排长方形的桌子，左面靠墙是一排书架，整整齐齐
地摆著许多书籍。任你随意取阅。有不少同学在这里埋头苦读着，使你不由也想拿一本
下来读一读。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "up": __DIR__ "eread",
    "down": __DIR__ "libzixi",
    "east": __DIR__ "library2",
    "west": __DIR__ "library3",
  ]));
  set("objects", ([
    __DIR__ "obj/shelf": 1,
    __DIR__ "obj/wall": 1,
    __DIR__ "npc/guan": 1,
  ]));
  set("coor/x", -80);
  set("coor/y", 0);
  set("coor/z", 20);
  setup();
}

void init() {
  add_action("do_get", "get");
}
void reset() {
  object *inv;
  object con, item;
  int i;
  ::reset();
  con = present("shelf", this_object());
  inv = all_inventory(con);
  if (sizeof(inv) != 5) {
    for (i = sizeof(inv) - 1; i >= 0; i--) destruct(inv[i]);
    item = new(__DIR__ "obj/book");
    item->move(con);
    item = new(__DIR__ "obj/parrybook");
    item->move(con);
    item = new(__DIR__ "obj/unarmedbook");
    item->move(con);
    item = new(__DIR__ "obj/dodgebook");
    item->move(con);
    item = new(__DIR__ "obj/movebook");
    item->move(con);
  }

}
int do_get(string arg) {
  string obj, from;
  object me, wall, shelf, table, target, taro;

  if (sscanf(arg, "%s from %s", obj, from) == 2) {
    if (obj == "all") {
      write("一次只能拿一本，这是规定。\n");
      return 1;
    }
    table = present("table", this_object());
    wall = present("wall", this_object());
    shelf = present("shelf", this_object());
    target = present(from, this_object());
    me = this_player();
    if (target == table || target == wall || target == shelf) {
      taro = present(obj, target);
      if (taro && random(10) > 4) {
        message_vision("$N拿了点东西，收了起来。\n", me);
        me->set_temp("marks/借书", 1);
      }
    }
  }
  return 0;
}

int valid_leave(object me, string dir) {
  object *inv;
  object ob;
  int i;
  if (userp(me)) {
    if (dir == "down" && me->query_temp("marks/借书") && ob = present("guan", this_object())) {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++) {
        if (((string)(inv[i]->name()) == "借书证"))
          return 1;
      }
      return notify_fail(ob->name() + "向你喝道：没有借书证不能把书带走！\n");
    }
    if (dir == "up" && me->query_temp("marks/借书") && ob = present("guan", this_object())) {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++) {
        if (((string)(inv[i]->name()) == "借书证"))
          return 1;

      }
      return notify_fail(ob->name() + "向你喝道：没有借书证不能把书带走！\n");
    }

    return 1;
  } else
    return 1;
}
