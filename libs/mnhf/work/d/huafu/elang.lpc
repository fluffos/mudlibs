// Room:/d/huafu/elang.c
// 西走廊，有可能摔倒。

inherit ROOM;

void create()
{
        set("short", "东走廊");
        set("long", @LONG
这里是从南楼中厅通往东教学楼的东走廊，沿着这条走廊行走，你也可以一览聚清
园的风光，走廊的南边是校医室。你若是有病，倒不妨去看一看。走廊的地是水磨石的，
小心会滑到。
LONG
        );
        set("exits", ([
                   "west" : __DIR__"zhting",
	"southeast" : __DIR__"elou1",
                   "south":__DIR__"xiaoyishi",
        ]));
	set("valid_startroom",1);
        set("coor/x",20);
	set("coor/y",20);
	set("coor/z",0);
	setup();
}
int valid_leave(object me, string dir)
{
           if( random((int)me->query("kar")) < 2 )
              {
               message_vision("$N脚下一个不稳，四脚朝天地摔在地上。然后又狼狈的爬起来。\n",me);
               this_player()->add("gin",-15);
               this_player()->add("kee",-15);
               return notify_fail("");
  }
return 1;
}	
