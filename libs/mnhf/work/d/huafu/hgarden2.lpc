inherit ROOM;

void create()
{
        set("short", "后门花园");
        set("long", @LONG
这是新建的花园，除了多了几座假山之外，其他的跟普通街边草坪没有
什么分别，也不见有什么名贵的花，一条白石小径通向一座亭子，平时这里
的人倒不多，偶尔有些工人会来剪草灌花。但据说最近这里成了邪教组织的
藏匿地点,不知是真是假。
LONG
        );
	set("valid_startroom",1);
        set("exits", ([ 
  "north" : __DIR__"hgarden",
  "south" : __DIR__"hgarden2",
  "west" : __DIR__"hgarden",
  "east" : __DIR__"hgarden2",
]));
        set("objects", ([
        __DIR__"npc/gang2" : 1,
                        ]) );

	set("outdoors","华师附中");
        set("coor/x",80);
	set("coor/y",-60);
	set("coor/z",10);
	setup();
        replace_program(ROOM);

