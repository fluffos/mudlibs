// Room: /d/huafu/elou1.c
// 东教学楼一楼，吴周伟在此问问题。

#include <ansi.h>
void test_me(object me);
inherit ROOM;

void create() {
  set("short", "东教学楼");
  set("long", @LONG
这里是华附初中的教学楼——东教学楼，也是大家学习和考试的地方，每天都有不
少同学在这里参加测试以提高自己的水平，好好考吧，胜利就在眼前，如果考不好，后
过不堪设想……
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "eroad1",
    "northwest": __DIR__ "elang",
    "east": __DIR__ "ricerm",
    "up": __DIR__ "elou2",
  ]));
  set("objects", ([
    __DIR__ "npc/wuzhouwei": 1 ]));

  set("coor/x", 40);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
void init() {
  object ob;
  object me = this_player();
  if (interactive(ob = this_player()))
    test_me(ob);
  if (me->query_temp("zhiri")) {
    me->set_temp("zhiri/elou", 1);
    message_vision(WHT "$N按照校长的指示，在东教学楼逛了一圈。\n" NOR, me);
  }
  return;
}
void test_me(object me) {
  me->set_temp("old_startroom", me->query("startroom"));
  me->set("startroom", __FILE__);
}
