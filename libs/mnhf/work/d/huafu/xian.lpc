inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "冼星海塑像");
  set("long", @LONG
这里是冼星海的头像，头像是铜制的，上面刻着冼星海同志的生
卒年份，看起来没有什么特别，不过，据说考前在这里拜一拜，冼星
海就会显灵保佑，这当然是迷信的说法，虽然学校屡禁不止，但还是
常有同学在这里膜拜（ｍｏｂａｉ）。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "east": __DIR__ "zhxd1",
    "west": __DIR__ "whroad2",
    "northwest": __DIR__ "whroad",
  ]));
  set("item_desc", ([
    "冼星海": "
冼星海塑像高六尺，型貌活灵活现，宛如真人一般。\n",
  ]));
  set("outdoors", "华师附中");
  set("coor/x", -20);
  set("coor/y", 40);
  set("coor/z", 0);
  setup();
}

void init() {
  add_action("do_mobai", "mobai");
}

int do_mobai() {
  object who;
  who = this_player();
  if ((int)who->query("sen") <= 50)
    return notify_fail("你的神不够。\n");
  message_vision("$N虔诚地跪在冼星海塑像前磕了个头。\n", who);
  who->receive_damage("sen", 50);
  if ((int)who->query("bellicosity") > 0)
    who->add("bellicosity", (random((int)who->query("kar")) + 7));
  message_vision("$N身上的勇气似乎增加了。 \n", who);
  add("number", 1);
  if ((int)query("number") == random(40) + 20) {
    message_vision(RED "\n\n$N觉得眼前一花，冼星海似乎动了一下！！！！\n\n" NOR, who);
    if (!who->query("marks/巧遇冼星海")) {
      who->add("combat_exp", 100 + random(50));
      who->add("potential", 100 + random(50));
      who->set("marks/巧遇冼星海", 1);
      message_vision(CYN "$N成功的破解了“巧遇冼星海”谜题，获得了一些潜能和学分的奖励！\n" NOR, who);
    }
    who = new(__DIR__ "npc/xian");
    who->move(this_object());
  }
  return 1;
}

void reset() {
  object obj;
  ::reset();
  delete("number");
  if (objectp(obj = present("master xian", this_object())))
    destruct(obj);
}
