// 可以自习
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "图书馆一楼");
        set("long", @LONG
图书馆一楼是大家自习和阅读书报、上阅读课的地方，每天都有不少每天都有不
少同学为求清静来这里自习(zixi)，只要你用心学，有朝一日说不定也能考上北大清
华。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"wlou1",
  "up" : __DIR__"library",
  "north" : "/d/wiz/jobroom",
]));
	set("valid_startroom",1);
        set("objects", ([
        __DIR__"npc/student" : 1,
        __DIR__"npc/student2" : 1,
        __DIR__"npc/student3" : 1,
        __DIR__"npc/bkseller" : 1,
                         ]) );

	set("coor/x",-60);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
void init()
{
        add_action("do_zixi", "zixi");
        add_action("do_zixi", "read");
}
int do_zixi(string arg)
{
        object ob;
        object me;
	int i=random(10);
        me = this_player();
if(me->is_busy()) return notify_fail("你还在自习之后的回味之中，不能继续自习。\n");
	if ((int)me->query("gin")>10 &&  (int)me->query("sen")>10) 
{
message_vision("$N非常认真的自习了半天，真辛苦真累！但收获也挺大的。\n",me);
me->improve_skill("literate", random(5));
me->add("gin",-(10+random(10)));
me->add("sen",-(10+random(10)));
if (i>6){
me->add("potential",i-3);
me->improve_skill("literate", 10+random(15));
message_vision(CYN"$N在自习中豁然贯通，似乎明白了什么！\n"NOR,me);
}
me->start_busy(2);
return 1;
}
return notify_fail("你现在过于劳累，学习要劳逸结合呀！\n");
}