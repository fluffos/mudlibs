// Room:/d/huafu/tyuguan4.c
// 用来打羽毛球，也算是和运动队一起的吧
// 这个东东基本上用的是羽毛球的代码，改了一下描述而已。

#include <ansi.h>
inherit ROOM;
string look_sign();
int do_play(string arg);
void finish_play(object me,object ob,int point);

// 球的种类，我懒得翻书了，也不知准不准确，你可以自己加上一些
string *ball = ({
	YEL "高球" NOR,YEL "低球" NOR,RED "网前球" NOR,
	GRN "抽球" NOR,WHT "提拉球" NOR,CYN "吊球" NOR,
	RED "扣杀" NOR,BLU "长球" NOR,CYN "短球" NOR,
});

void start_play(object me,object ob,int point);
void create()
{
        set("short", "羽毛球场");
        set("long", @LONG
这里就是体育馆的羽毛球场了，这里的人一向很多，因为羽毛球谁不会打？
可惜这里穿了钉鞋就不能进了，旁边的墙上挂着一张打羽毛球须知（sign）。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"tyuguan2",
]));
	set("valid_startroom",1);
	set("item_desc", ([
	"sign" : (:look_sign:),
	]));
	set("coor/x",-20);
	set("coor/y",-40);
	set("coor/z",0);
	setup();
}

// 总共只有一个add_action耶！
void init()
{
        add_action("do_play", "play");
}

string look_sign()
{
	object me=this_player();
	string str;
	str=YEL"体育馆羽毛球场入场须知\n"NOR;
	str+="\n羽毛球场打羽毛球的方法：\n请想打球者把“"WHT"play with <id> for <分数>"NOR"”指令互相使用一次即可。\n";
	str+="分数是指两人打到多少人为胜者。两人指定的分数必须相同。\n";
	str+="羽毛球场是公用场地，最多允许2队同时上场。每队2人。\n";
	str+=YEL"\n请遵守以上规章制度。\n"NOR;
	return str;
}

// 准备开打！
int do_play(string arg)
{
	object me= this_player();
	object ob,obj;
	string who;
	int point;
	if(!arg || sscanf(arg, "with %s for %d", who,point)!=2 ) return notify_fail("指令格式：play with <id> for <分数>\n");
	if (!ob=present(who,environment(me))) return notify_fail("没有这个人耶……\n");
	if (ob->query("id")==me->query("id")) return notify_fail("和自己打？好创意！不过没用。\n");
	if (query("playing")>2) return notify_fail("目前这里的人已经够多了，等别人打完再打吧！\n"); // 人数限制
	if (!objectp(obj=present("badminton",me))) return notify_fail("你都没有羽毛球具，怎么打？\n"); // 器材室的用场都在这里
	if (point>15) return notify_fail("按照羽毛球规则，最多只能打15分。\n"); // 这个限制其实是为了防止打太久
	if (point<5) return notify_fail("才两个人，打那么少分，有什么意思？\n"); // 当然打太短也不行
	else {
		if(userp(ob))
		{
			if(ob->query_temp("playpp/with")!=me->query("id")) {
			message_vision("$N对著$n说道：" + ob->name()+"，我想和你打一场羽毛球，\n总分数为"+chinese_number(point)+"分，好吗？\n\n", me, ob);
			me->set_temp("playym/with",ob->query("id"));
			me->set_temp("playym/maxpoint",point);
			tell_object(ob, YEL "如果你愿意和对方打羽毛球，请你输入play with "+me->query("id")+" for "+point+"。\n" NOR);
			write(YEL "由于对方是由玩家控制的人物，你必须等对方同意才能和他打羽毛球。\n" NOR);
			return 1;
			}
			if (ob->query_temp("playym/maxpoint")!=point) return notify_fail("你们俩指定的分数都不一样，请想好再下指令吧。\n");
			else {
			message_vision("$N对着$n说道：好吧，咱们这就开始打！\n", me, ob);
			tell_object(me,"你和"+ob->name()+"开始了总分为"+point+"分的激烈的羽毛球赛！\n");
			tell_object(ob,"你和"+me->name()+"开始了总分为"+point+"分的激烈的羽毛球赛！\n");
			me->set_temp("disable_inputs",1); 
			me->set_temp("is_unconcious",1); 
			me->set("disable_type",GRN "<羽毛球运动中>" NOR);
			ob->set_temp("disable_inputs",1); 
			ob->set_temp("is_unconcious",1); 
			ob->set("disable_type",GRN "<羽毛球运动中>" NOR);
			add("playing",1);
			start_play(me,ob,point);
			return 1;
			}
		}
		else return notify_fail("他（她、它）都不是玩家，你怎么能和她打球呢？\n"); // 只能和玩家打！
	}
}

// 整个打球过程的函数
void start_play(object me,object ob,int point)
{
	int mypt=me->query_temp("playym/point");
	int obpt=ob->query_temp("playym/point");

// 先判断假如谁先到达预定的分数，这场球就结束
	if (mypt==point){
	tell_object(me,"这场球打完了，祝贺你！你以"+chinese_number(mypt-obpt)+"分的优势"+mypt+"："+obpt+"战胜了"+ob->name()+"！\n");
//	write("你的分数："+mypt+"。\n");
	tell_object(ob,"这场球打完了，"+me->name()+"以"+chinese_number(mypt-obpt)+"分的优势"+obpt+"："+mypt+"战胜了你，不过别灰心！\n");
//	write(ob->name()+"的分数："+obpt+"。\n");
	call_out("finish_play",0,me,ob,point);
	return;
	}
	if (obpt==point){
	tell_object(ob,"这场球打完了，祝贺你！你以"+chinese_number(obpt-mypt)+"分的优势"+obpt+"："+mypt+"战胜了"+me->name()+"！\n");
//	write("你的分数："+obpt+"。\n");
	tell_object(me,"这场球打完了，"+ob->name()+"以"+chinese_number(obpt-mypt)+"分的优势"+mypt+"："+obpt+"战胜了你，不过别灰心！\n");
//	write(ob->name()+"的分数："+mypt+"。\n");
	call_out("finish_play",0,ob,me,point);
	return;
	}
	switch(random(20)) { // 取了20以内随机，但只设了8个可以得分的情况，其他的都是平安的打来打去，sigh
		case 0:
	message_vision("$N沉着冷静，对着$n一球"+ball[random(8)]+"打来，\n$n眼一花，球从拍边飞过！\n", me, ob);
	me->add_temp("playym/point",1); // 得分了！
	call_out("start_play",3,me,ob,point); // 3秒的callout会不会短了点？
	break;
		case 2:
	message_vision("$n轻挥球拍，对着$N一球"+ball[random(8)]+"打去，\n$N一挡，羽毛球不争气的下网了。\n", me, ob);
	ob->add_temp("playym/point",1);
	call_out("start_play",3,me,ob,point);
	break;
		case 4:
	message_vision("$N一步踏前，横身一球"+ball[random(8)]+"向$n打了过去，\n$n尽管飞身跳起，但还是没打着这球！\n", me, ob);
	me->add_temp("playym/point",1);
	call_out("start_play",3,me,ob,point);
	break;
		case 6:
	message_vision("$n反过球拍，从本来没有可能打出的地方一球"+ball[random(8)]+"打来，\n$N不禁大惊失色，手忙脚乱的把这球打了下网！\n", me, ob);
	ob->add_temp("playym/point",1);
	call_out("start_play",3,me,ob,point);
	break;
		case 8:
	message_vision("$N纵身一跳，凌空一球"+ball[random(8)]+"重重向$n打去，\n$n再难接住这球！\n", me, ob);
	me->add_temp("playym/point",1);
	call_out("start_play",3,me,ob,point);
	break;
		case 10:
	message_vision("$n反手轻轻一档，没想到这个"+ball[random(8)]+"过了$N这边竟急飞转下，$N一挑，唉，又下网了！\n", me, ob);
	ob->add_temp("playym/point",1);
	call_out("start_play",3,me,ob,point);
	break;
		case 12:
	message_vision("$N大力一球"+ball[random(8)]+"，没想到用力过猛，眼见就要出界，\n正在后悔之际，只听$n叹道：“唉，砸界球！”竟赢了这一球！\n", me, ob);
	me->add_temp("playym/point",1);
	call_out("start_play",3,me,ob,point);
	break;
		case 14:
	message_vision("$n身形一晃，眼见就要不慎摔倒，没想到正好一球"+ball[random(8)]+"向$N打来，\n正好落在边角上！$N只好望球兴叹。\n", me, ob);
	ob->add_temp("playym/point",1);
	call_out("start_play",3,me,ob,point);
	break;
		default:
	message_vision("$N和$n你一球我一球，正打得难分难解。\n", me, ob);
	call_out("start_play",3,me,ob,point);
	break;
	}
}

void finish_play(object me,object ob,int point)
{
	int i=random(me->query("int")+me->query("agi"))+point; // 这个是给胜者加的，比失败者多一些，hehe
	int j=random(ob->query("int")+ob->query("agi"));
// 删掉这一对正在打球的
	if (query("playing")>0)
	{
	add("playing",-1);
	}
	me->delete_temp("is_unconcious");
	me->delete_temp("disable_inputs");
	me->delete_temp("playym");
	me->delete("disable_type");
	me->receive_damage("gin",point/2);
	me->receive_damage("kee",point/2);
	me->improve_skill("blade",i);
	tell_object(me,RED"你觉得自己十分疲惫，但基本刀法方面有了不少进步。\n"NOR);

	ob->delete_temp("disable_inputs");
	ob->delete_temp("playym");
	ob->delete("disable_type");
	ob->receive_damage("gin",point/2);
	ob->receive_damage("kee",point/2);
	ob->improve_skill("blade",j);
	tell_object(ob,RED"你觉得自己十分疲惫，但基本刀法方面有了一些进步。\n"NOR);
	return;
}