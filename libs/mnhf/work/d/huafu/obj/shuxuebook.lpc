// An example book

inherit ITEM;

void create()
{
	set_name("数学剑法读本" , ({ "shuxuebooka" }) );
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本介绍数学剑法的课本。\n");
        set("value", 1000);
        set("skill", ([
                "name":                 "shuxue",      
                "exp_required": 0,       
                "sen_cost":             30,
                "difficulty":   20,  
                "max_skill":    300     
        ]) );
}
 
