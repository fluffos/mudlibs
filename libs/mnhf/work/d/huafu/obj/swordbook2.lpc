// An example book

inherit ITEM;

void create()
{
	set_name("高中剑法读本" , ({ "swordbookb" ,"book"}) );
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本介绍剑法的高中课本。\n");
        set("value", 2000);
        set("skill", ([
                "name":                 "sword",      
                "exp_required": 200000,       
                "sen_cost":             30,
                "difficulty":   2,  
                "max_skill":    200     
        ]) );
}
 
