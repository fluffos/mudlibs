// An example book

inherit ITEM;

void create()
{
        set_name("初中刀法入门" , ({ "bladebooka","book" }) );
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本介绍刀法的初中课本。\n");
        set("value", 20);
        set("skill", ([
                "name":                 "blade",      
                "exp_required": 0,       
                "sen_cost":       15,
                "difficulty":   10,  
                "max_skill":    100     
        ]) );
}
 
