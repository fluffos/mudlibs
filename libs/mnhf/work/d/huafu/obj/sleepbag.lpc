// bed.c 
// standard bed for players.
// by jjgod

#include <ansi.h>
inherit ITEM;
//int do_dp(string arg);

void create()
{
     set_name("睡袋",({"sleep bag","bag"}));
     set("long", @LONG
一个睡袋。 
LONG
     );
set("unit", "只");
     set_weight(1000);
     set("value", 500);
     seteuid(getuid());
     set("sleep_bag",1);
     set("no_drop", 1);
     set("no_get", 1);
     set("no_give", 1);
     setup();
}

void init()
{
     object me=this_player();
     me->add_temp("sleep",1);	
//     add_action("do_dp","drop");
}
