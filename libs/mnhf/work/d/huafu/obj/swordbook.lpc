// An example book

inherit ITEM;

void create()
{
	set_name("初中剑法入门" , ({ "swordbooka" }) );
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本介绍剑法的初中课本。\n");
        set("value", 20);
        set("skill", ([
                "name":                 "sword",      
                "exp_required": 0,       
                "sen_cost":     15,
                "difficulty":   20,  
                "max_skill":    100     
        ]) );
}
 
