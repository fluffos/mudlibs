// jjgod@vrhf
#include <ansi.h>
#include <login.h>
#define MAX_EXP 5000
inherit NPC;
string *death_msg = ({
  HIW "监考官那锐利的目光象把刀一样在你身上扫来扫去。\n\n" NOR,
  HIW "监考官翻了翻勾魂簿，叹道：又一个没考好的学生。\n\n" NOR,
  HIW "监考官合上簿子说道：没到考试期限？罢了罢了，你走吧。\n\n" NOR,
  HIW "一股阴冷的浓雾突然出现，很快地包围了你。\n\n" NOR,
});
string *revive_loc = ({
  "/d/huafu/juqing",
  "/d/huafu/zhting",
});

void create() {
  set_name("监考官", ({ "kaoguan", "ghost judge" }));
  set("long",
    "高考的监考官，专勾画天下学生的生死。\n");
  set("attitude", "peaceful");
  set("chat_chance", 15);
  set("chat_msg", ({
    (: random_move :),
    "监考官喝道：语文，数学老师何在？\n"
  }));
  set("age", 217);
  set("combat_exp", 20000);
  set("max_gin", 900);
  set("max_kee", 900);
  set("max_sen", 200);
  set_skill("dodge", 40);
  set_skill("unarmed", 40);
  setup();
}

void init() {
  ::init();
  if (!previous_object()
    || !userp(previous_object())
    || wizardp(previous_object())) return;
  if (previous_object()->query_temp("death_stage_active")) return;
  previous_object()->set_temp("death_stage_active", 1);
  call_out("death_stage", 3, previous_object(), 0);
}

void death_stage(object ob, int stage) {
  if (!ob || !present(ob) || (int)ob->query("combat_exp") > MAX_EXP) {
    if (ob) ob->delete_temp("death_stage_active");
    return;
  }

  tell_object(ob, death_msg[stage]);
  if (++stage < sizeof(death_msg)) {
    call_out("death_stage", 3, ob, stage);
    return;
  } else if (ob->is_ghost())
    ob->reincarnate();

  ob->delete_temp("death_stage_active");
  ob->move(revive_loc[random(sizeof(revive_loc))]);
  ob->set("startroom", base_name(environment(ob)));
  message("vision",
    "你忽然发现前面多了一个人影，不过那人影又好像已经在那里\n"
    "很久了，只是你一直没发觉。\n", environment(ob), ob);
}
