// TIE@FY3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "阎罗殿办公室");
  set("long", @LONG
经过一路走来的闷热，乍进门来，空调的凉爽让你一阵舒服，定下神
来，红木座椅的王座上端坐着一位黑面老师，正是掌握六道轮回，万物来
世的级组长。两侧四名老师，各捧生死簿册——试卷，语文，数学老师，
各拿钢笔，横眉怒目，当堂责罚学生。
LONG
  );
  set("objects", ([
    __DIR__ "npc/yanwang": 1,
    __DIR__ "npc/panguan2": 4,
    __DIR__ "npc/niutou": 3,
    __DIR__ "npc/mamian": 3,
  ]));
  set("coor/x", -1020);
  set("coor/y", -30);
  set("coor/z", -100);
  setup();
}
void init() {

  remove_call_out("letgo");
  call_out("letgo", 15, this_player());
}

void letgo(object me) {
  object room;
  if (!me || environment(me) != this_object()) return;
  message_vision("\n\n\n级组长长叹一口气：＂算了，算了，让$N四处逛逛，
知道这里是赏罚分明，只要$N下次再也不敢胡作非为就可以了！＂\n\n", me);
  message_vision("\n\n一阵冷风吹散了$N的冤魂．．．\n\n", me);
  room = load_object(__DIR__ "dizang");
  if (objectp(room)) me->move(room);
}
