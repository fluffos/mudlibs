// JJGOF@VRHF
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "高三剥皮狱");
  set("long", @LONG
几只大钩子悬于半空，上悬数人，几个语文，数学老师以极为熟
练的手法在人犯头顶开口，然后灌入水银，旋即剥下一张完整的人皮，
令人做呕，高三之酷刑，一至于斯，一个语文老师似乎看穿了你的心
思，淡然说道“成绩太差的学生，非此不能降其心啊，高三之中，虽残
酷但自有公道”。话虽如此，你还是忍耐不住，向下面的磨捱狱走去。
LONG
  );
  set("exits", ([
    "up": __DIR__ "bashe",
    "down": __DIR__ "moai",
  ]));
  set("coor/x", -1020);
  set("coor/y", -70);
  set("coor/z", -160);
  setup();
  replace_program(ROOM);
}
