#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "奈河");
        set("long", @LONG
许多人只知道奈何桥，却不知道奈河，其实奈河桥名来自奈河，奈
河贯穿高三，内有差生，过枉死城后则只有金色鲤鱼，桥上通体翡翠，
巧夺天工，桥身雕刻得极为精细，不愧为鬼神妙手。由此过去便是高三
最后一站，高考驿。
LONG
        );
        set("exits", ([
		"north" : __DIR__"pingan",
		"south" : __DIR__"mengpo",
        ]) );
	set("coor/x",-1020);
	set("coor/y",-90);
	set("coor/z",-290);
	setup();
        replace_program(ROOM);
}
 
