#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "高三吊筋狱");
  set("long", @LONG
这里是高三的第一层，地狱共十八层，每三层关押同一类学生，故实际
关押六种学生。这第一种三层关押的是“寂寂寥寥，烦烦恼恼，尽是生前作
下千般业，死后通来受罪名”，在这吊筋狱中关押的皆是成绩较好之人，受
挑筋之苦，遍地血腥，呻吟声此起彼伏，几个老师来回逡巡，再往下便是幽
枉狱。
LONG
  );
  set("exits", ([
    "up": __DIR__ "diyu",
    "down": __DIR__ "yiuwang",
  ]));
  set("coor/x", -1020);
  set("coor/y", -70);
  set("coor/z", -110);
  setup();
  replace_program(ROOM);
}
