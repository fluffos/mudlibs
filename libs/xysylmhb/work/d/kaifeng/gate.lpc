#include <room.h>

inherit ROOM;

string look_gaoshi();

void create()
{
	set("short", "开封府大门");
	set("long", @LONG
这就是大名鼎鼎的开封府,到了这里可得小心噢!你抬头看见一块闪闪的大匾:
		  ≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡
		 ‖                                 ‖
		 ‖    开        封           府    ‖
		 ‖                                 ‖
		  ≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡
墙上还贴着一张告示(gaoshi),有许多带刀侍卫在这儿,你还是快走的好.
LONG
	);

	set("item_desc", ([
		"gaoshi" : "碶n从今天后,玩家可以告状.\n包龙星手笔\n",
	]));

	set("exits", ([
		"west" : __DIR__"tieta",
		"north" : __DIR__"road1",
	]));
	set("objects", ([
		"/d/kaifeng/npc/zhaohu" : 1,
		"/d/kaifeng/npc/zhanglong" : 1,
		"/d/kaifeng/npc/shiwei" : 2,
	]));
	set("outdoors", "kaifeng");
	setup();
}

string look_gaoshi()
{
       return FINGER_D->get_killer() + "\n开封府\n包龙星\n";
}
