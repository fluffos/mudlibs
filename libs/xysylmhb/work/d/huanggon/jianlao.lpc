// unix 1998.11

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "石门");
	set("long", "这是一道用大理石制成的石门, 也许你可以推(tui)开它!\n");
	setup();
}
	void init()
{
	add_action("do_push", "tui");
}
	int do_push(string arg)
{
	if(!arg||arg!="shimen")
{
	write("你要推什么啊!\n");
return 1;
}
	if(arg=="shimen")
{
	if((int)this_player()->query("str")<20)
{
	message_vision(HIY"你用尽全力猛推石门, 可石门连动都不动一下!\n"NOR,this_player(
));
return 1;
}
else
	if((int)this_player()->query("str")>=20)
{
	message_vision(HIY"$N将丹田之气惯传全身, 你混身上下发出『砒啪』之声!\n"NOR+
HIW"		$N大喝一声『开』, 只见石门顿时被$N推了出去, $N迅速闪入!\n"NOR,this_player());
		this_player()->move("/d/huanggon/jianlao2");
return 1;
}
}
}
