// 商人.c
inherit F_DEALER;
inherit NPC;

void create()
{
	set_name("商人", ({ "dealer", "shang ren" }) );
	set("gender", "男性" );
	set("age", 22+random(20));
	set("long",
		"这是个中年人商人。\n");
	set("combat_exp", 100+random(10000));
	set("attitude", "friendly");
        set("vendor_goods", ({
                "/d/city2/npc/obj/yangxin",
                "/d/city2/npc/obj/shouwu",
        }));
	setup();
}

void init()
{	
	object ob;

	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
        if( this_object()->query("move") == 0 ) {
          this_object()->set("move",1);
          remove_call_out("move_dealer");
          call_out("move_dealer", 180,ob);  }
        add_action("do_buy","buy");
        add_action("do_list","list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
		say( "商人笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，想买点什么吗？我这里应有尽有。\n");
}
void move_dealer(object ob)
{
    this_object()->set("move",1);
    message_vision("$N匆匆离去了。\n",this_object());
    destruct(this_object());
    return ;
}
