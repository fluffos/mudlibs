// xiaoer2.c 酒店小二
inherit NPC;
inherit F_DEALER;
void create() {
  set_name("游戏精灵", ({ "playboy" }));
  set("gender", "男性");
  set("age", 14);
  set("long",
    "这是火云世界最有趣的精灵。\n"); set("combat_exp", 1000000);
  set("attitude", "friendly");
  set("rank_info/respect", "小精灵");
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
void init() {
  int time;
  string dir;
  object ob, who;

  ob = this_object();
  who = this_player();

  ::init();
  if (dir == "enter") {
    if (interactive(who) && !is_fighting()) {
      if (time() - who->query("wqa's room/flag") >= 100000) {
        remove_call_out("saying"); call_out("saying", 0, who);
      } else {
        remove_call_out("greeting"); call_out("greeting", 1, who);
      }
    }
  }
  void greeting(object who) {
    if (!who || environment(who) != environment()) return;
    switch (random(2)) {
      case 0:
        say("游戏精灵笑咪咪地说道：这位" + RANK_D->query_respect(who) + "，和我一起做游戏吧。\n");
        break;
      case 1:
        say("游戏精灵笑咪咪地说道：这位" + RANK_D->query_respect(who) + "，请进请进。\n");
        break;
    }
  }
  void saying(object who) {
    if (!who || environment(who) != environment()) return;

    say("\n我累了，等一会再玩吧！\n\n");
    remove_call_out("kicking");
    call_out("kicking", 1, who);
  }
  void kicking(object who) {
    if (!who || environment(who) != environment()) return;
    who->move("/d/room/chat_room");
    message("vision", "只见一朵火云闪过" + who->query("name") + "出现在现实世界里。\n", environment(who), who);
  }
