inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg)
{
if (me->query_condition("no_kill"))
 {
 write("妖魔不在，你还是等一会儿吧。\n");
  return 1;
}
if (me->query("no_kill")!=1)
{
write("你已经是江湖中人了。\n");
return 1;
}
        write("你决定重出江湖，踏上杀戮之路。\n");
 message("channel:rumor",HIM"〖无中生有〗"+me->query("name")+"：我决定决定重出江湖，踏上杀戮之路。\n"NOR,users());
        me->delete("no_kill");
   me->apply_condition("no_kill",50);
        return 1;
}

