int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_force") < 100)
		return notify_fail("你的内力不够怎么练剑。\n");
        if ((int)me->query("force") < 100)
		return notify_fail("你的内力不够怎么练剑。\n");
}
mapping query_action(object me, object weapon)
{
    int i, level;
int s=random(me->query_str());
int ran=random(10);
    level   = (int) me->query_skill("huanhua-jianfa",1);
       if (!me) me = this_object();
  if (ran>7 && s > 150 )
       {   
              return ([
"action": HIC"$n窥准$N一招华山剑法「有凤来仪」的趋势，准备进行反击
"WHT"却见$N突然虚步提腰，使出酷似武当「蜻蜓点水」的一招"NOR,
                "force" : 850,
                "dodge" : 5,
                "damage" : 650,
                "damage_type" : "刺伤",     
                ]); 
        }  
  if (ran<4 && s > 150) 
        {   
           me->add("force", -30);    
              return ([
"action": HIR"$N剑势忽缓而不疏，剑意有余而不尽，化恒山剑法为一剑，向$n慢慢推去
"HIM"这似有招似无招的一剑,虽一剑却暗藏无数后着，$n手足无措，不知如何是好"NOR,
                "force" : 850,
                "dodge" : 5,
                "damage" : 650,
                "damage_type" : "刺伤",     
                ]); 
        }  
  if (ran>7 && s < 150 && s >50)
       {   
              return ([
"action": HIR"\n但见$N又抱剑旋身，转到$n身后，杂乱无章地向$n刺出一剑，不知使的是什么剑法"NOR,
                "force" : 850,
                "dodge" : 10,
                "damage" : 650,
                "damage_type" : "刺伤",     
                ]); 
        }  
   if (ran<4 && s <=150 && s > 50) 
        {   
              return ([
"action": HIR"$N左手剑诀斜引，画个半圆，平搭在$n背脊上，劲力传出，$n登时一沉！"NOR,
                "force" : 850,
                "dodge" : 5,
                "damage" : 650,
                "damage_type" : "刺伤",     
                ]); 
        }  
  for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

