//摩云手
// 修改于2000.6.27
// by fly

#include <ansi.h>
inherit SKILL;

mapping *action = ({
   ([   "action":   HIM"$N一招"YEL"『螳螂捕蝉式』"HIM"，左手抓向$n的丹田，就在$n回身自防的一瞬间，右手却已掐上了$n的$l"NOR,
     "dodge":     10,
     "parry":     10,
     "force":     160,
     "damage_type":   "刺伤",
                        "weapon":     "右手食指",
   ]),
   ([   "action": HIC"$N双手一翻，出"CYN"『梅花五朵』"HIC"，双手如穿花蝴蝶一般上下翻飞。\n"CYN"$n看花了眼，刹那间$N已欺身到了眼前"NOR,
     "dodge":     5,
     "parry":     -15,
     "force":     180,
     "damage_type":   "内伤",
                        "weapon":     "右手",
   ]),
   ([   "action":     HIY"只见$N一转身，一指由胁下穿出，疾刺$n的$l，却正是一招"BLU"『穿针引线』"NOR,
     "dodge":     5,
     "parry":     10,
     "force":     100,
     "damage_type":   "刺伤",
                        "weapon":     "左手食指",
   ]),
   ([   "action":     HIR"$N双掌一错，掌心向外横推而出，这一招"MAG"『力士推山』"HIR"带着一股罡风扑向$n的$l"NOR,
     "dodge":     20,
     "parry":     20,
     "force":     140,
     "damage_type":   "内伤",
                        "weapon":     "左手", 
   ]),
([   "action":     YEL"$N一招"RED"『乌龙翻江』"YEL"，左手在空中虚划了个半弧，拍向$n的$l"NOR,
     "dodge":     30,
     "parry":     10,
     "force":     70,
     "damage_type":   "内伤",
                        "weapon":     "左手",
   ]),
([   "action":     BLU"忽听$N一声怒吼，右手高高举起，一式"HIY"『力劈华山』"BLU"，砍向$n的$l"NOR,
     "dodge":     10,
     "parry":     -10,
     "force":     220,
     "damage_type":   "砍伤",
                        "weapon":     "右手",
   ]),
});

int valid_learn(object me)
{
   
   if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
     return notify_fail("练摩云手必须空手。\n");
   return 1;
}

int valid_enable(string usage)
{
return usage=="unarmed" || usage=="parry"; 
}

mapping query_action(object me, object weapon)
{
int ran=random(6);
        if (!me) me = this_object();
  if (ran>2 && random(me->query_str()) > 250 && 
          random(me->query("force")) > 500)
       {   
              return ([
                "action": HIY"$N左掌阳，右掌阴，目光凝视$n，两掌向$p慢慢合拢，竟是凝重如山，却又轻灵似羽！"NOR,
                "force" : 1050,
                "dodge" : 10,
                "damage" : 650,
                "damage_type" : "内伤",     
                ]); 
        }  
  if (ran<2 && random(me->query_str()) > 25 
         && random(me->query("force")) > 500)
        {   
           me->add("force", -30);    
              return ([
                "action": HIR"不料$N双手一圈，如抱太极，一股雄浑无比的力道组成了一个旋涡，只带得$p在原地急转七八下，
如转陀螺，如旋纺锤，好容易使出“千斤坠”之力定住身形，却已满脸胀得通红，狼狈万状！
慌乱中只听见$N大喝一声[天马流星],胸口已中圈"NOR,
                "force" : 1050,
                "dodge" : 10,
                "damage" : 850,
                "damage_type" : "内伤",
                       
                ]); 
        }  
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
   if( (int)me->query("mud_age") > 100 )
     return notify_fail("摩云手只能学，不能练。\n");
   
   return 1;
}
void skill_improved(object me)
{
        if ((int)me->query_skill("kugu-blade", 1) % 10 == 0 ) {
                tell_object(me, "\n你高兴之余，忽觉一口真气提不上来，腿一软，坐到了地上。\n\n");
                me->add("max_force", -10);
     me->start_budy(5+random(2));
        }
}

