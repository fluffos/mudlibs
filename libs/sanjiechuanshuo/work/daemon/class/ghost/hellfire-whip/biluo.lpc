#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        string str;
        int extra;
        object weapon;
        extra = me->query_skill("hellfire-whip",1);

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "whip")
                        return notify_fail("你使用的武器不对。\n");
        
        if( !target ) target = offensive_target(this_player());
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
               return notify_fail(HIR"「魂断蓝桥」"NOR"只能对战斗中的对手使用。\n");
        weapon = me->query_temp("weapon");
        if(extra < 120)
            return notify_fail("你的烈火鞭还不够纯熟！\n");
        if(me->query("family/family_name")!="阎罗地府")
           return notify_fail(HIR"「魂断蓝桥」只有阎罗地府门人才可以用！\n"NOR);
        if(me->query("max_force") < 500)
            return notify_fail("你的内力还不够，不要勉强了！\n"); 
        if(me->query("force") < 1000)
            return notify_fail("你的真气不够，不要勉强了！\n"); 
              
        
        if(extra >= 400)  extra = 400;
        
        me->add_temp("apply/attack",extra/3);
        me->add_temp("apply/damage",extra/3);
        me->add_temp("apply/strength", extra/10);
        message_vision(HIR"$N手中前指的鞭尾突然像着火一般，“砰”地炸出一团紫红色的火焰，绕
着通红透亮的枪身燃烧起来！！“刷”地拉出一道火红中映着紫焰的流光，
哗啦啦地就是一片遮天的火舌，往$n的头上盖去！"NOR,me,target);
         message_vision(HIY"$N将全身真气集中到手中的"+weapon->query("name")+ HIY"上面，对着$n使出了
 菩提祖师的独门绝招「「魂断蓝桥」」！"NOR,me,target);
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,str);
        message_vision(HIY  "$N手中的"+weapon->query("name")+ HIY"好像具有了$N的神力，朝着$n砸了过来！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,str);
message_vision( weapon->query("name")+ HIY"在$N的手中挥洒自如，$n有些招架不住了！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,str);
         if( !userp(target) ){
    if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))  
                       {str=target->name()+HIM"被"+me->name()+HIM"用阎罗地府烈火鞭的绝招"HIW"「魂断蓝桥」"HIM"杀死了，听说全身烧焦而亡！";
//                         message("channel:rumor",HIM"〖无中生有〗某人："+str+"\n"NOR,users());
                       }
}else{      if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))  
                       {str=target->name()+HIM"被"+me->name()+HIM"用阎罗地府烈火鞭的绝招"HIW"「魂断蓝桥」"HIM"杀死了，听说全身骨骼尽断而亡！";
//                         message("channel:rumor",HIM"〖无中生有〗某人："+str+"\n"NOR,users());
                       }
}
 me->add_temp("apply/attack",-extra/3);
        me->add_temp("apply/damage",-extra/3);
        me->add_temp("apply/strength", -extra/10);

        me->start_busy(3/2);
        return 1;
}

