// autoheal.c

#include <ansi.h>

int cast(object me, object target)
{

        if( (int)me->query("mana") < 300 )
                return notify_fail("你的法气不够。\n");
    if((int)me->query_skill("buddhism", 1) < 50)
                return notify_fail("你的大乘佛法等级不够，不能使用！\n");

 message_vision(HIR"$N高喝一身佛号，只见天外飞来几道光芒直飞入$N的身体。\n"NOR,me,target);    
        me->add("mana", -300);
        me->set_temp("autoheal",1);
        remove_call_out("autoheal");
        call_out("autoheal",random(5),me,target);
        return 1;
}

int autoheal(object me,object target)
{
if (me->query_temp("autoheal")>10)
return 1;
me->add_temp("autoheal",1);
if (me->is_fighting())
{
int heal=(int)me->query_skill("buddhism",1);
if (me->query("eff_kee")<(me->query("max_kee")-heal))
{
message_vision(HIW"只见$N身上发出无数光芒，$N觉得感觉好了很多。\n"NOR,me,target);
me->add("eff_kee",heal);
me->add("kee",heal);
}
else
if (me->query("eff_kee")<me->query("max_kee") && me->query("kee")<(me->query("max_kee")-heal))
{
message_vision(HIC"只见$N身上发出无数光芒，$N觉得感觉非常好。\n"NOR,me,target);
me->set("eff_kee",me->query("max_kee"));
me->add("kee",heal);
}
else
if (me->query("eff_kee")<me->query("max_kee") && me->query("kee")<me->query("max_kee"))
{
message_vision(HIY"只见$N身上发出无数光芒，$N觉得已经完全恢复了。\n"NOR,me,target);
me->set("eff_kee",me->query("max_kee"));
me->set("kee",me->query("max_kee"));
}
else
if (me->query("kee")<(me->query("max_kee")-heal))
{
message_vision(HIC"只见$N身上发出无数光芒，$N觉得感觉非常好。\n"NOR,me,target);
me->add("kee",heal);
}
else
if (me->query("kee")<me->query("max_kee"))
{
message_vision(HIC"只见$N身上发出无数光芒，$N觉得已经完全恢复了。\n"NOR,me,target);
me->set("kee",me->query("max_kee"));
}

}
call_out("autoheal",random(5),me,target);


}
