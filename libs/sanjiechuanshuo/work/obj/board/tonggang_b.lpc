inherit BULLETIN_BOARD;

void create()
{
        set_name("天神童钢留言板", ({ "board" }) );
        set("location", "/u/tonggang/workroom1.lpc");
        set("board_id", "tonggang_b");
        set("long",     "由于童钢比较忙，所以有什么事童钢会在这里留言，这个留言板也是大家和童钢通讯的工具。:)\n" );
        setup();
        set("capacity", 30);
        replace_program(BULLETIN_BOARD);
}

