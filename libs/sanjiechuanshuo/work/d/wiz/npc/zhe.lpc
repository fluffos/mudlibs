inherit NPC;
string ask_dong();
#include <ansi.h>

void create()
{
   set_name(HIR"杀手乐园守护者"NOR, ({ "shouhu zhe", "shouhu", "zhe"}));
   set("long", @LONG

LONG);
   set("gender", "男性");
   set("age", 20);
   set("attitude", "peaceful");
   set("per",100);//means no rong-mao description.
   set("max_kee", 120000);
   set("max_gin", 140000);
   set("max_sen", 120000);
   set("force", 60000);
   set("max_force", 60000);
   set("force_factor", 5000);
   set("max_mana", 30000);
   set("mana", 90000);
   set("mana_factor", 6000);
   set("combat_exp", 300000000);
   set("daoxing", 30000000);
   set_skill("spells", 1500);
   set_skill("unarmed", 1500);
   set_skill("jienan-zhi", 1500);
   set_skill("dodge", 1500);
   set_skill("lotusmove", 1500);
   set_skill("parry", 1500);
   set_skill("force", 1500);
   set_skill("lotusforce", 1500);
   set_skill("staff", 1500);
   set_skill("lunhui-zhang", 1500);
   map_skill("spells", "buddhism");
   map_skill("unarmed", "jienan-zhi");
   map_skill("dodge", "lotusmove");
   map_skill("force", "lotusforce");
   map_skill("parry", "lunhui-zhang");
   map_skill("staff", "lunhui-zhang");
   set("chat_chance_combat", 80);
   set("chat_msg_combat", ({
                (: cast_spell, "bighammer" :),
        }) );

   set("inquiry",([
      "杀手乐园": (: ask_dong:) ,
      "单挑": (: ask_dong:),
      "pk": (: ask_dong:),
]));

   setup();
  carry_object("/d/obj/armor/jinjia")->wear();
   }

string ask_dong()
{
        object ob = this_object();
        object me = this_player();
        if( me->query("combat_exp") > 100000 && !me->query("enter_number") > 4 )
       {
         
me->move("/d/wiz/pk17");
//me->add("enter_number",1)
//me->delete_temp("cantpk");
//me->delete_temp("canpk")
return "当心了，里面杀人不用偿命!\n
你可要注意了,如果你死了,不要怪别人!";
        }
        return "过关了，武学不够都不能过。";
}
