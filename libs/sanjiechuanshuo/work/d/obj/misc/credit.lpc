inherit ITEM;
void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("信用丹", ({"xinyong dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是一颗极其珍贵的三界传说玩家信用丹。\n");
                set("no_get", "嘿嘿，做梦吧! \n");
   		set("no_give","这么珍贵的信用丹，哪能随便给人？\n");
                set("no_drop","这么宝贵的信用丹，哪能乱扔! \n");
   		set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");

        }
}
int do_eat(string arg)
{
        string *skills;
        mapping all_skills;
        object me;
        int i, force, mana;
        if (!id(arg))
             return notify_fail("你要吃什么药？\n");
 	else{
	me=this_player();
       	force = (int)me->query("max_force");
       	mana  = (int)me->query("max_mana");
       	me->set("eff_kee",me->query("max_kee"));
       	me->set("kee",me->query("max_kee"));
       	me->set("eff_gin",me->query("max_gin"));
       	me->set("gin",me->query("max_gin"));
       	me->set("eff_sen",me->query("max_sen"));
       	me->set("sen",me->query("max_sen"));
       	me->set("force",force*2);
       	me->set("mana",mana*2);
       	me->set("food",me->max_water_capacity()*3);
       	me->set("water",me->max_food_capacity()*3);
        me->add("daoxing",20000);        
        me->add("combat_exp",10000);
        me->add("potential",5000);
        message_vision("$N吃下一颗三界传说信用丹,发现对这个站的信心增加了许多。\n", me);
        destruct(this_object());
        return 1;
        }
}