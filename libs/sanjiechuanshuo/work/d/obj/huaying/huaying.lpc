// huaying.c 化影盒
// last updated by xueyi 5.8.2002

inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(WHT"化影"+HIC"盒"NOR, ({ "huaying" , "玉盒"}) );
	set_weight(50);
                set("unit", "只");
		set("long", "    这是一神秘的盒子，上面刻了“化影”俩字，还刻了些奇怪的花
纹，玉盒不时发出暗红色的光茫．一看到这一只玉盒，你分明感到一
种神奇的力量．\n");
		set("value", 10000);
}

void init()
{
  if(this_player()==environment())
  add_action("do_huaying1","combine_hero");
  add_action("do_huaying2","combine_leizhu");
  add_action("do_huaying3","combine_xiyu");
  add_action("do_huaying4","combine_exp");
  add_action("do_huaying5","combine_dx");
}

int do_huaying1()
{
int i,j1=0,j2=0,j3=0,j4=0,j5=0,j6=0,j7=0,j8=0,j9=0,j0=0;
object obj,me, *inv;
object k1,k2,k3,k4,k5,k6,k7,k8,k9,k0;
me = this_player();
inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
			if(inv[i]->query("name") == "风雷锏")   {j1 = 1; k1 = inv[i];}
                        if(inv[i]->query("name") == "大斧")     {j2 = 1; k2 = inv[i];}
                        if(inv[i]->query("name") == "金蛟剪")   {j3 = 1; k3 = inv[i];}
                        if(inv[i]->query("name") == "神枪")     {j4 = 1; k4 = inv[i];}
                        if(inv[i]->query("name") == "轮回棒")   {j5 = 1; k5 = inv[i];}
                        if(inv[i]->query("name") == "铜锏")     {j6 = 1; k6 = inv[i];}
                        if(inv[i]->query("name") == "木桃剑")   {j7 = 1; k7 = inv[i];}
                        if(inv[i]->query("name") == "绣花针")   {j8 = 1; k8 = inv[i];}
                        if(inv[i]->query("name") == "朱笔")     {j9 = 1; k9 = inv[i];}
                        if(inv[i]->query("name") == "木笛子")   {j0 = 1; k0 = inv[i];}
		}
if( j1 && j2 && j3 && j4 && j5 && j6 && j7 && j8 && j9 && j0 )
{
	destruct(k1);
	destruct(k2);
	destruct(k3);
	destruct(k4);
	destruct(k5);
	destruct(k6);
	destruct(k7);
	destruct(k8);
	destruct(k9);
	destruct(k0);
        me->add("daoxing",2000);
        me->add("combat_exp",2000);
        me->add("potential",2000);
	obj = new(__DIR__"hero");
	obj->move(me);
        message_vision("$N把手里的几件兵器放入化影盒摆弄了几下．一阵红光闪过，你得到了一个戒指。\n",this_player());
        CHANNEL_D->do_channel(me,"rumor","传说$N完成了BigTask，合成了英雄之戒!");
}
else
        message_vision("$N把手里的几件兵器放入化影盒摆弄了几下．\n",this_player());   
return 1;
}

