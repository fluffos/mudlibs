// xiyu.c 细雨
// last updated by xueyi 8.8.2002

#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
	set_name(HIC"细雨"NOR, ({ "xiyu", "jiezhi", "ring" }));
	set("weight", 400);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 200000);
		set("long",HIC"这是一个神秘的戒指。能够给你带来好运。\n"NOR);
		set("material", "gold");
		set("armor_prop/armor", 30);
		set("armor_prop/personality", 10);
		set("armor_prop/karma", 10);
}
	setup();
}
