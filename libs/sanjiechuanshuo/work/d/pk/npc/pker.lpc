#include <ansi.h>

inherit NPC;

string *names = ({
  "八部天神",
  "武曲星君",
  "得道高僧",
  "千年仙人",
  "幽冥饿鬼",
});

void create()
{
   string str;
   set_name(names[random(sizeof(names))], ({"pker", "yao", "guai"}));
   set("long", "PK岛上闲着没事儿的妖怪！\n");
   set("title", HIR"走火入魔的"NOR);
   set("gender", "男性");
  set("combat_exp", 2000000+random(2000000));
  set("daoxing", 2000000+random(5000000));
  set("age", 30);
  set("per", 25);
  set("attitude", "aggressive");
  set("shen_type", 1);
  set("people", "people");
  set("force_factor",200);
  set("mana_factor",300);
  set("max_gin",6000);
  set("max_kee",6000);
  set("max_sen",6000);
  set("max_force",8000);
  set("max_mana",8000);
  set_skill("unarmed", 600);
  set_skill("dodge", 600);
  set_skill("parry", 600);
  set_skill("force", 600);
   set_skill("wuxing-quan", 500);
   set_skill("baguazhen", 500);
   set_skill("parry", 600);
   set_skill("blade", 600);
   set_skill("yange-blade", 500);
   set_skill("zhenyuan-force", 600);
   map_skill("force", "zhenyuan-force");
   map_skill("unarmed", "wuxing-quan");
   map_skill("dodge", "baguazhen");
   map_skill("blade", "yange-blade");
  setup();
  carry_object("/d/obj/armor/tongjia")->wear();
  carry_object("/d/obj/weapon/blade/blade")->wield();
  set("no_nk_reward",1);
}

void init ()
{
  object ob = this_player();
  object me = this_object();

  if(living(ob))
  call_out("greeting", 1, ob);
}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() ) return;
  if (ob && interactive(ob))
  {
    if (! ob->query_temp("weishi_kill"))
      message_vision ("$N对$n喝道：大胆贱民，敢来闯我PK岛。受死吧！\n",this_object());
    this_object()->kill_ob(ob);
    ob->set_temp("weishi_kill",1);
  }
}
void die()
{
        object ob, me, corpse;
        
        ob = this_object();
        me = query_temp("last_damage_from");
        
        message_vision(HIW"$N大叫一声,$n你给我等着!!咱们走着瞧。\n"NOR,ob,me);
//        message("vision", me->name() + "由于成功的击败了$N,得到了100天道行和400点潜能。\n", me);
        message_vision(HIC"$n由于成功的击败了$N,得到了一年道行和500点潜能。\n"NOR,ob,me);
                me->add("daoxing",1000);
        me->add("potential",500);
        destruct(ob);
        return;
}

