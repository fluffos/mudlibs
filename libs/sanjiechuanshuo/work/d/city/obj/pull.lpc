// plll.c
//by toto

#include <ansi.h>
inherit ITEM;

int do_eat(string);
void init();
void create()
{
        set_name(HIR "PULL丹" NOR, ({"pull dan", "pull"}));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一颗火红的丹药，据说有起死回生的功效。\n");
                set("unit", "颗");
                set("value", 8000);
                set("weight", 70);
	set("base_unit","颗");
                
        }
        setup();
}

void init()
{
	add_action("do_eat","eat");
}

int do_eat(string arg)
{
        object me=this_player();

       if( !id(arg))
                {
                	write("你使用什么药？\n");
                         return 1;
                 }
                	
        me->set("kee",me->query("max_kee"));
        me->set("sen",me->query("max_sen"));
        
        message_vision(HIR "$N吞下一颗PLLL丹，脸上精神焕发。\n" NOR, me);
        destruct(this_object());
        return 1;
}
