inherit NPC;
#include <ansi.h>
  int give_bonnet();
    int give_dan();
int answer_me();
   int accept_object(object who, object ob)
{
                    if( (string)ob->query("id")=="loyal bonnet" )
{
who->set("yudian/bonnet",0);
                    command("say 好借好还，再借不难。");
    return 1;
}
}
void create()
{
         set_name(HIG"小丸子"NOR, ({"wan zi","wan"}));
   set ("long", @LONG
他是在这里负责给大家发礼物(gift)哦，
他身上还有天师法冠(bonnet)呢!
不信你就去问问(ask)他。记得，天师法冠用完了要还哦！
LONG);
           set("gender", "女性");
           set("title",HIY"动画"NOR);
                 set("age", 20);
        set("per", 40);
       set("attitude", "peaceful");
       set("shen_type", 1);
//  carry_object("/u/yudian/weapon/mmjian")->wield();
//  carry_object("/u/yudian/hak")->wear();
set("inquiry", ([
           "bonnet":(:give_bonnet:),
          "gift":(:give_dan:),
            "礼物":(:give_dan:),
            "天师法冠":(:give_bonnet:),
            "法冠":(:give_bonnet:),
           "name":(:answer_me:),
]));
        setup();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
}
}
int answer_me()
{
command("say 我是动画小丸子，在这里
发放天师法冠和送礼物给大家的。\n");
return 1;
}
int give_dan()
{
object dan;
object who=this_player();
if (!userp(who))
{
command("heng");
command("say 什么小猫小狗也来要礼物？！");
command("qi");
return 1;
}
         if (this_player()->query("yudian/gift")=="got")
{
          message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
       command("say 礼物只有一份！领过就不给了！");
  return 1;
}
who->add("combat_exp",99999);
who->add("daoxing",99999);
who->add("force",888);
who->add("max_force",888);
who->add("max_mana",888);
who->add("mana",888);
who->add("maximum_force",888);
who->add("maximum_mana",888);
who->add("potential",60000);
who->set_skill("force",66);
who->set_skill("spells",66);
who->set_skill("literate",66);
who->set_skill("dodge",66);
who->set_skill("parry",66);
who->set_skill("unarmed",66);
message_vision("$N念动咒语：好好学习天天向上!\n$N手一指，$n只觉得周身气血翻腾，似乎武学、道行和技能都有所进境。\n",this_object(),this_player());
     who->set("yudian/gift","got");
return 1;
}
 int give_bonnet()
 {
 object bonnet;
 object who=this_player();
if (!userp(who))
{ 
command("heng");
command("say 什么小猫小狗也来要东西？！");
command("qi");
return 1;
}
          if (this_player()->query("yudian/bonnet")=="got")
 {
           message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
          command("say 上次给你的还没还呢！不给了！");
   return 1;
  }
      bonnet=new("/d/lingtai/obj/faguan");
  bonnet->move(who);
message_vision("$N念动咒语：好好学习天天向上!只见漫天雪飞，$N变出一个天师法冠。\n$N给$n一顶天师法冠。\n",this_object(),this_player());
      who->set("yudian/bonnet","got");
           command("say 用完了记得还我哦，否则下次不给了！");
 return 1;
  }
void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
say(name()+"神秘地说：“想要礼物吗？找我啊！不过，你只有一次机会哦！哈哈！”\n"NOR);

}

