#include <ansi.h>

inherit NPC; 
// inherit F_DEALER; 
inherit F_VENDOR;
void consider();
int ask_cake();
void create()
{
        set_name("精灵", ({ "spirit" }) );
        set("nickname", HIW "生辰" NOR);
        set("gender", "女性" );
         set("age", 20);
        set("long", 
"精灵楼的主人，管理着精灵楼的一切事务。\n" );
        set("attitude", "friendly");
//      set("shen_type", 1);
        set("class", "swordman");
        
        set("str",21);
        set("int",28);
        set("con",40);
        set("dex",40);
        set("per",100);


        set("kee", 2000);
        set("max_kee", 2000);
        set("sen", 1000);
        set("max_sen", 1000);
        set("force", 3000);
        set("max_force", 3000);
        set("enforce", 100);
        
        set("combat_exp", 1000000);
 //       set("score", 200000);
 //       set("shen", 100000);
        
      set("inquiry", ([
            "精灵物语" : "“那是我最喜欢的书哦，绝对不给人！”\n", 
	    "birth" : (: ask_cake :),
            "生日" : (: ask_cake :),
            "生日礼物" : (: ask_cake :),
            "birthday" : (: ask_cake :),      ]));
 
      set("chat_chance",30);
      set("chat_msg", ({
            "生辰精灵拿出一本"+HIW"《精灵物语》"NOR+"，专心地读了起来。\n", 
            "生辰精灵随着光芒一闪一闪，无聊地说：“怎么没人来领礼物呢？”\n",
            "生辰精灵笑嘻嘻地说：“要礼物，找我就对了。”\n",      }) );
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "shield" :),
        }) );
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: exert_function, "eyes" :),
        }) ); 
        set("vendor_goods", ([
                "candle": "/u/sys/obj/candle",
//                "cake": "/u/sys/obj/cake",
        ]));

        setup();
 //       carry_object("/d/city/npc/cloth/moon-dress")->wear();
 //       carry_object("/d/city/obj/gangdao")->wield(); 
}

int ask_cake()
{ 
        object ob;
        if (this_player()->query("birth/gift"))    {
            command("say 恭喜恭喜，祝你生日快乐！\n");
     this_player()->move("d/city/cake");
        message_vision("\n$N给了$n走进了生日礼物室。\n",  this_object(),this_player());
//         this_player()->delete("birth/gift"); 
        return 1;
	}
	else
        command("say 你的生日还没有到啊！！！\n");
        return 1;
}
 
void init()
{ 
        add_action("do_vendor_list", "list");
        add_action("do_faint", "18mo");
        add_action("do_faint", "kiss");
        add_action("do_faint", "taste"); 
        add_action("do_faint", "hug");
        add_action("do_faint", "beg");
}
 
void unconcious ()
{
  die ();
}  
void die()
{
        object ob;
        command("sigh");
        message_vision("\n$N背上长出一对透明的羽翼，一开一合间，$N又变得神采奕奕。\n", this_object());
        ob = new("/d/city/npc/spirit");  //人物的路径，自定义。目的是不死....
        ob->move(environment(this_object()));
        destruct(this_object());
} 


int do_faint()
{
        object me, ob;
        me=this_object();
        ob=this_player();
message_vision("$N脸一红，说：“哎呀，你怎么能对我做这么丢脸的事呢？”\n" NOR, me);
     message_vision("说罢，口中念了句咒语，$N眼前一黑，晕了过去。\n",ob);
        ob->set("immortal",0);
        ob->delete("immortal");
        ob->unconcious();
        return 1;
}

