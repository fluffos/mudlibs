inherit NPC;
#include <ansi.h>
int give_dan();
int accept_object(object who, object ob)
{
        if( (string)ob->query("id")=="loyal bonnet" )
        {
                who->set("yudian/bonnet",0);
                command("say 好借好还，再借不难。");
                return 1;
        }
}
void create()
{
         set_name(HIG"生日礼物使者"NOR, ({"birthman","man","birth"}));
   set ("long", @LONG
生日礼物使者，可以问他要(生日礼物)！
LONG);
        set("gender", "男性");
        set("title",HIW"使者"NOR);
        set("age", 20);
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("inquiry", ([
                "生日礼物":(:give_dan:),
                "birthday":(:give_dan:),
                "birth":(:give_dan:),
        ]));
        setup();
}

int give_dan()
{
object dan;
object who=this_player();
if (!userp(who))
{
command("heng");
command("say 什么小猫小狗也来要礼物？！");
command("qi");
return 1;
}
         if (this_player()->query("birth/gift")=="got")
{
       message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
       command("say 生日礼物不是已经发生了，你等下一次过生日吧!!加油，加油！");
  return 0;

}
who->add("combat_exp",10000);
who->add("daoxing",10000);
who->add("potential",10000);
message_vision("$N送$n一份生日礼物。\n",this_object(),this_player())
;
who->set("birth/gift","got")
;
return 1;
}

