inherit NPC;
#include <ansi.h>
int give_bug();

void create()
{
	set_name("索罗斯", ({"suo luosi", "suo", "luosi"}));
	set("title",HIY"股神"NOR);
	set("gender", "男性");
	set("age", 38);
	set("kee", 5000); 
	set("max_kee", 5000);
	set("sen", 5000);
	set("max_sen", 5000);	
	set("combat_exp", 5000000);
	set("daoxing",5000000);
	set("attitude", "friendly");
	set("env/wimpy", 50);
	set("chat_chance", 10);
	set_skill("parry", 600);
	set_skill("unarmed", 600);
	set_skill("dodge", 600);
	set_skill("force",600);
	set_skill("spells",600);
	set_skill("literate",800);
set("inquiry", ([
        "bug":(:give_bug:),
        "hack":(:give_bug:),
]));
	setup();
	add_money("coin", 1);
}

int give_bug()
{
	object who=this_player();
	if (!userp(who))
	{
		command("heng");
		command("say 什么小猫小狗也来问bug？！");
		command("qi");
		return 1;
	}
	if (who->query("stock/bug")=="asked")
	{
//       		message_vision("$N对着$n哼了一声。\n",this_object(),who);
//       		command("say 你已经问过bug了，还想问啊，那还有啥bug！");
		return 0;
	}
	else
	{
		if (random(100)==13)
		{
		who->add("stock/total",100000);
		message_vision("$N拿出电脑，回车键一按，告诉了$n一条股市的bug,自己去体会吧。\n",this_object(),who);
		}
		else
		message_vision("$N拿出电脑，回车键一按，告诉$n这里根本就没有任何bug,好好炒股吧。\n",this_object(),who);
		who->set("stock/bug","asked");
		who->save();
		return 1;
	}
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) 
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
	say(name()+HIW "宣布：“月宫黄金股配股分红方案即将出台，请大家等候消息！！！”\n"NOR);
}
