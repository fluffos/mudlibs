//qisi.c

inherit ITEM;

int do_eat(string);
void init();
void create()
{
set_name("起死丸" , ({"qisi wan", "wan","qisi","plll"}));
 set_weight(10);
 if (clonep())
 set_default_object(__FILE__);
  else {
       set("long", "一颗圆圆的丹药，不知吃了有什么用。\n");
   set("unit", "颗");
  set("value", 1000);
  set("weight", 70);
  set("base_unit","颗");
                
      }
   setup();
}

void init()
{
add_action("do_eat","eat");
}
int do_eat(string arg)
{
  object me=this_player();
if( !id(arg))
  {
    write("你要吃什么药？\n");
 return 1;
  }
 me->set("kee",me->query("max_kee"));
 me->set("sen",me->query("max_sen"));
  message_vision("$N吞下一颗起死丸，脸色好多了。\n", me);
destruct(this_object());
  return 1;
}
