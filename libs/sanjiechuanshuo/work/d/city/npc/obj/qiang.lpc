#include <ansi.h>
#include <dbase.h>
#include <armor.h>

inherit NECK;

int do_wear(string arg);
int do_remove(string arg);

object offensive_target(object me);

void create()
{
        set_name(HIY "农民腔" NOR, ({"nong min", "qiang"}) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "套");
                set("material", "crystal");
		set("no_steal",1);
                set("value",888);
                set("no_drop", "如此正宗的腔调再世难求啊。\n");
                set("no_give", "这种腔调恐怕别人不会要吧?\n");
                set("no_sell", "农民哪能不要农民腔!\n");
                set("long","传说中十八代农民才可以配带，佩之可成为正宗农民，并可发出农民法术。\n为农民所必需之物。");
                set("bb",1);
                set("armor_prop/armor", 1);
                set("spells/earth", 1);
        }
        setup();
}

int init()
{
        add_action("do_wear","wear");
        add_action("do_remove", "remove");
        return 1;
}

// This function selects a random target for offensive spells/functions.
object offensive_target(object me)
{
        int sz;
        object *enemy;

        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}

int do_wear (string arg)
{
  object me = this_player();
  object zhu = this_object();
  string name = zhu->query("name");
  string msg;

if(arg!="all" && arg != "tuzhu" &&  arg != "tu lingzhu" )
    return notify_fail("你要装什么？\n");
  msg = "$N装出"+name+"，一付十足的农民企业家样子。\n"; 
  zhu->set("wear_msg",msg);
remove_call_out("tuzhuconditions");
call_out("tuzhuconditions",1,me,zhu);
  return 0;
}

int do_remove (string arg)
{
  object me = this_player();
  object zhu = this_object();
  string name = zhu->query("name");
  string msg;

if (arg != "all" && arg != "tuzhu" && arg != "tu lingzhu")
    return notify_fail("你要进城不做农民了？\n");

  msg = "$N将"+name+"轻轻地去掉……\n"; 
  zhu->set("unequip_msg",msg);
  remove_call_out("tuzhuconditions");
  return 0;
}

void tuzhuconditions(object who,object ob)
{
     object target;
     int ap,dp,damage,dx;
     string msg;
string type;
type = ob->query("armor_type");
if( who->query_temp("armor/" + type) && ob->query("equipped")!="worn")
return;
  if( who->is_fighting())
     {
        target = offensive_target(who);
        if( ! target ) return ;
 if( ! present( target,environment(who)) ) return ;    
        msg = HIY"农民腔越积越重，$n的身上笼罩着一股巨大的农民气息，只见农民腔一起迸发，\n
向$n的身上冲去！\n"NOR;
//divid by 10;
	ap = 200000;
       	dp = target->query("combat_exp");
                if( random(ap + dp) > dp )
                 {
                  	dx = (int)target->query("daoxing") /1000;
                        dx += (int)target->query("combat_exp")/1000;                        
                        damage = dx/2+random(dx/2);
//                        damage -= (int)target->query("max_mana") / 40 + random((int)target->query("eff_sen") / 20);
//                        damage -= random((int)target->query("mana_factor"));
                      	if( damage > random(1000) ) 
                        {
                                msg += HIC "结果$n躲避不及，被农民腔罩个正着！呼吸困难。\n" NOR;
                                target->receive_damage("sen", damage/2);
                                target->receive_wound("sen", damage/4);
                                target->receive_damage("kee", damage/2);
                                target->receive_wound("kee", damage/4);
                        } 
            else
//here, cast failed and the target's mana_factor will be added to the previous
//damage to hurt yourself:(...note damage<0.
                msg += HIC "\n谁知$n毫无反应。\n" NOR;   
                }
                else
                        msg += "但是被$n躲开了。\n";

                message_vision(msg, who, target); 
        }
// call_out("tuzhuconditions",7,who,ob);
}
