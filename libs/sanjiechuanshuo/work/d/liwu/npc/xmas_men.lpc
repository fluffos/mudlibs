#include <ansi.h>
inherit NPC;
string ask_for_present();
void create()
{
    set_name("礼物老人", ({ "liwu man", "man" }) );
	set("title", HIY"礼物"+HIW" 使者"NOR);
	set("gender", "男性" );
	set("age", 400);
	set("long",
		"咦？这个礼物老人怎么和圣诞老人张得一模一样，呵呵...\n"
                "他正在那里发红包，看来你可以向他要。(ask man about 礼物)\n" );
        set("daoxing", 800000);
        set("shen_type", 1);
        set_skill("unarmed", 160);
        set_skill("dodge", 160);
        set_skill("parry", 160);
        set_skill("whip", 160);
	set_skill("force", 160);
	set_skill("spells", 160);
	set_skill("dao", 160);
	map_skill("spells", "dao");
        set("force", 800);
	set("max_force", 800);
	set("force_factor", 80);
	set("mana", 2000);
	set("max_mana", 1200);
	set("mana_factor", 80);
        set("max_kee", 1200);
	set("max_sen", 1200);
        set("eff_dx", 120000);
        set("nkgain", 300);
	set("combat_exp", 8000000);
	set("attitude", "friendly");
	set("inquiry", ([
		"礼物"   : (: ask_for_present :),
		"gift"   : (: ask_for_present :),
	]) );

	set("kee", 5000);
	set("max_kee", 5000);
	set("sen", 5000);
	set("max_sen", 5000);
	set("force", 5000);
	set("max_force", 5000);
        set("jiali",300);
	setup();
        carry_object("/d/liwu/obj/yuyi")->wear();
}

void init()
{
	object ob;

	::init();

	if( interactive(ob=this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
		call_out("greeting",1,ob);
	}
}


void greeting(object ob)
{
	if(!ob || environment(ob)!=environment()) return;

      command("say 你是来拿礼物的吧？\n");
}

string ask_for_present()
{ 
mapping *holiday= ({

	          ([
                      "name":             HIR"元旦"NOR,
                      "year":             "either",
                      "month":            "Jan",
                      "day":              "01",
                  ]),
  
                  ([
                      "name":             HIW"清明节"NOR,
                      "year":             "either",
                      "month":            "Apr",
                      "day":              "05",
                  ]),

                   ([
                     "name":             HIC"愚人节"NOR,
                      "year":             "either",
                      "month":            "Apr",
                      "day":              "01",
                  ]),
                  ([
                      "name":             HIR"劳动节"NOR,
                      "year":             "either",
                      "month":            "May",
                      "day":              "01",
                  ]),

                  ([
                      "name":             HIW"青年节"NOR,
                      "year":             "either",
                      "month":            "May",
                      "day":              "04",
                  ]),

                  ([
                      "name":             HIR"儿童节"NOR,
                      "year":             "either",
                      "month":            "Jun",
                      "day":              "01",
                  ]),

                  ([
                      "name":             HIR"建党日"NOR,
                      "year":             "either",
                      "month":            "Jul",
                      "day":              "01",
                  ]),

                  ([
                      "name":             HIR"建军节"NOR,
                      "year":             "either",
                      "month":            "Aug",
                      "day":              "01",
                  ]),

                  ([
                      "name":             HIR"国庆节"NOR,
                      "year":             "either",
                      "month":            "Oct",
                      "day":              "01",
                  ]),

       		  ([
                      "name":             HIR"情人节"NOR,
                      "year":             "eihter",
                      "month":            "Feb",
                      "day":              "14",                    
                  ]),

                  ([
                      "name":             HIW"圣诞节"NOR,
                      "year":             "either", 
                      "month":            "Dec",
                      "day":              "24",
                  ]),



                  ([
                      "name":             HIR"春"+HIC"节"NOR,
                      "year":             "2002",
                      "month":            "Feb",
                      "day":              "12",
                  ]),

                  ([
                      "name":             HIR"元宵"NOR+"节",
                      "year":             "2002",
                      "month":            "Feb",
                      "day":              "26",
                  ]),
               
                  ([
                      "name":             HIR"端午"NOR+"节",
                      "year":             "2000",
                      "month":            "Jun",
                      "day":              "11",
                  ]),
                      
       		  ([
                      "name":             HIY"补过中秋"NOR+"节",
                      "year":             "2001",
                      "month":            "Oct",
                      "day":              "02",                    
                  ]),

       		  ([
                      "name":             HIY"重阳"NOR+"节",
                      "year":             "2001",
                      "month":            "Oct",
                      "day":              "25",                    
                  ]),
                	
                  });
    object me,ob;
    mapping skl, today;
    string *sname;
    int i,how=0,what_day=100;
    string week, month, year, day, time;
    string check;
    
    sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
   if(day=="")
    sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time,year);

    for(i=0;i<sizeof(holiday);i++)
      {  today = holiday[i];
	      tell_object(me,today["month"] +" \n");
              if(month==today["month"]&&day==today["day"])
               what_day=i;
      }
    if(what_day==100)
      return "今天好象不是什么节日耶！\n";

    today = holiday[what_day];   
    check=year+today["name"];
    me = this_player();
    me->delete("goodday_gift");
    me->delete("goodday_gift_time");     
    me->add("goodday_gift_count",1);
/*
    if (me->query("goodday_gift_count")>10)
    {
		if (me->query("potential")>10000)
			me->add("potential",-10000);
		else
			me->set("potential",0);
		if (me->query("daoxing")>20000)
			me->add("daoxing",-20000);
		else
			me->set("daoxing",0);
		if (me->query("combat_exp")>15000)
			me->add("combat_exp",-15000);
		else
			me->set("combat_exp",0);
		me->start_busy(20);
        	return "呸，贪心不足，我要惩罚你，自己看看吧，都少了啥，活该！！！\n";    	
    }
*/
    if(me->query("goodday_gift_got")==check)
       	return "每个人一份，不要这么贪心好不好,再多问我要惩罚了！\n";
    if ((int)me->query("combat_exp") <400000 || (int)me->query("mud_age")<3600*12)
	{
		me->add("potential",10000);
		me->add("daoxing",20000);
		me->add("combat_exp",15000);
		me->set("goodday_gift_got",check);
		me->start_busy(10);
        	return "嘿嘿，想用新玩家来骗我,武学和您的年龄太低，就给你一点小礼物吧！。\n";
      
      	}
    if ((int)me->query("combat_exp") >=400000 ) 
         {
	    	skl = me->query_skills();
      		if(skl) sname  = keys(skl);
            	for(i=0; i<sizeof(skl); i++)
                if (skl[sname[i]] >= 120) how=how+1; 
                if(how<5)
                {
			me->add("potential",20000);
			me->add("daoxing",40000);
			me->add("combat_exp",30000);
                	me->set("goodday_gift_got",check);
                	me->start_busy(5);
                	return "您应该有五门功夫在120级以上了才来找我，现在就只能意思意思了！。\n";
          	}
          } 
     ob = new("/d/liwu/obj/red");
     ob->move(me);
     me->set("goodday_gift_got",check);
     return today["name"]+"快乐！\n"+"礼物老人给"+me->query("name")+"一个"+HIR"红包"NOR+"。\n";
}


  
