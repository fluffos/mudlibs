#include <ansi.h>

inherit F_AUTOLOAD;  
inherit ITEM;

void create()
{
        set_name(HIG"信用卡"NOR, ({ "credit card", "card", "ka"}));
	set_weight(50);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "张");
                set("value", 200000);
                  set("no_drop",1);
                  set("no_give",1);
                  set("no_get",1);
		set("material", "steel");
	}
	setup();
}

void init()
 {
   add_action("do_look","look");
   add_action("do_qu","shuaka");
   add_action("do_full","huifu");
 }

   int do_look(string arg)  
 {
        if(arg!="card"&&arg!="credit card")
        return 0;
     tell_object(this_player(),"这是一张银行的信用卡,现在你银行的存款是：\n"
    +MONEY_D->money_str(this_player()->query("balance"))+"，你可以刷卡(shuaka)取钱的。\n");
      return 1;
 }
   int do_full(string arg)  
 {
    object me,ob;
    int jin, qi, neili, fali, shiwu, yinshui;
    me=this_player();
    if (me->query("balance") < 100000)
    {
     tell_object(me,"你的帐户里有这么多钱吗，想透支啊！！！\n");
     return 1;
    }
    ob=new("/obj/money/gold");
    ob->set_amount(1);
    ob->move(me);
    me->add("balance",-100000);
        jin = me->query("max_sen");
        qi =me->query("max_kee");
        fali = me->query("max_mana");
        neili = me->query("max_force");
        shiwu = me->max_food_capacity();
        yinshui = me->max_water_capacity();
        me->set("eff_sen", jin);
        me->set("eff_kee", qi);
        me->set("sen", jin);
        me->set("kee", qi);
        me->set("mana", fali);
        me->set("force", neili);
        me->set("food", shiwu);
        me->set("water", yinshui);
        write("Ok.\n");
    return 1;
 }
int do_qu(string arg)
{
    object me,ob;
    me=this_player();
    if (me->query("balance") < 10000)
    {
     tell_object(me,"你的帐户里有这么多钱吗，想透支啊！！！\n");
     return 1;
    }
    ob=new("/obj/money/gold");
    ob->set_amount(1);
    ob->move(me);
    me->add("balance",-10000);
    tell_object(me,"你刷卡取出一两黄金带在身上。\n");
    return 1;
}

int query_autoload() { return 1; }
void owner_is_killed()
{
destruct(this_object());
}
  

