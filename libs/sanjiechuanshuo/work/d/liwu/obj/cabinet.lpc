

#include <ansi.h>

inherit ITEM;


void create()
{
        set_name("礼品柜", ({ "cabinet",  }) );
        set_weight(3000);
        set_max_encumbrance(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "这是一个很大的礼品柜，每到一个周末你都可以到这里来拿（na all from cabinet）一件你的礼物。\n");
                set("value", 1000);
                set("material", "wood");
                set("no_get",1);
                set("no_drop",1);
                set("amount",30);
        }
        setup();

}


void init()
{
     add_action("do_qu","na");
}


int do_qu(string arg)
{ 
    object me,ob;
    mapping skl;
    string *sname;
    int i,how=0;
    string week, month, day, time, year;
    string item,from,check;
    
     if ( !arg )
          return notify_fail("命令格式： na all from cabinet \n");     

     sscanf(arg, "%s from %s", item,  from);

     if(from!="cabinet")
          return notify_fail("命令格式： na all from cabinet \n");     

            
     if(item!="all"&&item!="礼品盒")
          return notify_fail("你想拿什么？\n");     


     sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
     if(day=="")
      sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time, year);
     me = this_player();
    if(week!="Sat")
 	{
 	    if (day=="12" && year=="2001" && month=="Sep") tell_object(me,"对不起,中国点心害得我这样,给你一个小礼物请谅解我的难处！\n");
      	    else return notify_fail("今天好象不是周末耶！\n");
    	}
 
    if ((int)me->query("combat_exp") <300000 || (int)me->query("mud_age")<3600*6)
        return notify_fail("嘿嘿，想登新玩家来骗我，没门！。\n");
      
    if ((int)me->query("combat_exp") >=200000 ) 
         {
	    skl = me->query_skills();
            sname  = keys(skl);
            for(i=0; i<sizeof(skl); i++)
                   if (skl[sname[i]] >= 160)how=how+1; 
                          if(how<1)
                            return notify_fail("你好意思去拿,总要有门像样的功夫吧？再练一会吧！\n");
          } 
     
     check=year+month+day;            
     if(me->query("weekend_gift")==check)
       return notify_fail("你好象拿过了耶,下周再来吧！\n");
     ob = new("/d/liwu/obj/happybox");
     ob->move(me);
     me->set("weekend_gift",check);
     return notify_fail("你从礼品柜里拿出一个"+HIR"礼品盒"NOR+"。\n");
}


void owner_is_killed()
{
destruct(this_object());
}
  
