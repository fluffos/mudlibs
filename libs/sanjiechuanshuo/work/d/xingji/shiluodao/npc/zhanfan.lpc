inherit NPC;

void create()
{
  set_name("战犯", ({"zhan fan", "fan"}));
  set("gender", "男性");
  set("long", "他是未来世界的格斗天尊，身上有很多的宝贝，如果你想得到，那么你就把他杀掉吧。\n");
  set("looking", "已经看不清楚脸上的相貌了，唯一看的清楚的就是他的眼睛，发出的光带有一种寒气。");
  set("combat_exp", 2500000);
  set("daoxing", 2500000);
  set("age", 30);
  set("str", 40);
  set("int", 40);
  set("per", 30);
  set("con", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("max_gin",3000);
  set("max_kee",3000);
  set("max_sen",3000);
  set("max_force",4000);
  set("force_factor", 200);
  set("force",6000);
  set("mana",6000);
  set("max_mana",4000);
  set("mana_factor", 200);
  set_skill("unarmed", 250);
  set_skill("dodge", 250);
  set_skill("moshenbu", 250);
  set_skill("spells", 250);
  set_skill("parry", 250);
  set_skill("iori-spells", 250);
  set_skill("iori-kuihua", 250);
  map_skill("spells", "iori-spells");
  map_skill("parry", "iori-kuihua");
  map_skill("dodge", "moshenbu");
  map_skill("unarmed", "iori-kuihua");
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
          (: perform_action, "unarmed", "three" :),
          (: cast_spell, "bazhinu" :),
        }) );
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("u/ling/shiluodao/obj/dxdan");
  set("no_nk_reward",1);
}

