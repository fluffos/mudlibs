#include <ansi.h>
inherit NPC;

void create()
{
  set_name(HIW"白马"NOR, ({"horse", "ma"}));
  set("race", "野兽");
  set("age", 10);

  set_skill("dodge", 60);
  set("combat_exp", 10000);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
  set("verbs", ({ "bite"}));

  set("chat_chance", 1);

  set("ride/msg", "骑");
  set("ride/dodge", 10+random(6));
  set_temp("apply/attack", 10);
  set_temp("apply/armor", 20);

  setup();
}

