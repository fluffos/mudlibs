// mozhong.c 魔种
// last updated by xueyi 9.8.2002

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIC"魔种---鼠神之心"NOR, ({ "mozhong", "zhong", "xin", "heart" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "        一个血淋淋的心脏，暗红色，散发出一股神奇的魔力。似乎
是鼠魔的心脏，孕育着魔界诸魔的神力。你可以尝试用（zhong ）来
把魔种植入你的心灵。\n");
                set("value", 0);
}
}
void init()
{
  if(this_player()==environment())
  add_action("do_zhong","zhong");
}

int do_zhong()
{
object me, ob;
me = this_player();
ob = this_object();
        me->add("wudidong/sell_reward",300);
        me->add("combat_exp",-50000);
        me->add("daoxing",-50000);
        if(me->query("family/family_name")!="陷空山无底洞")
                   return notify_fail("只有陷空山无底洞之人才可以种下魔种！\n");
        if( (int)me->query("mana") <= 1000 )
                   return notify_fail("你的法力不够，强种魔种会走火入魔！\n");  
        me->set("wudidong/mojie","zhong");
        me->set("title",HIC"蚀日鼠魔"NOR);
        message_vision("$N运起妖法，吸取了魔种的精华。\n",this_player());
        CHANNEL_D->do_channel(me,"rumor",HIC"传说$N种下了魔种，成为蚀日鼠魔。领悟了枯骨刀的秘诀。"NOR);
        destruct(ob);
}
