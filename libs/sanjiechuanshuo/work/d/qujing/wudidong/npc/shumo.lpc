// shumo.c 鼠魔
// last updated by xueyi 9.8.2002;

#include <ansi.h>

inherit NPC;

void create()
{
   string str;
  set_name(HIY"通天鼠魔"NOR, ({"shu mo","shumo", "mo"}));
   set("long", "参透了枯骨刀秘笈的魔界鼠神！\n");
   set("title", HIR"魔道鼠神"NOR);
   set("gender", "男性");
  set("combat_exp", 1000000+random(1000000));
  set("daoxing", 1000000+random(1000000));
  set("age", 80);
  set("per", 25);
  set("attitude", "aggressive");
  set("shen_type", 1);
  set("force_factor",50);
  set("mana_factor",50);
  set("max_gin",6000);
  set("max_kee",6000);
  set("max_sen",6000);
  set("max_force",2000);
  set("max_mana",2000);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("force", 200);
  set_skill("yinfeng-zhua", 200);
  set_skill("spells", 200);
  set_skill("yaofa", 200);
  set_skill("blade", 200);
  set_skill("kugu-blade", 200);
  set_skill("huntian-qigong", 200);
  map_skill("force", "huntian-qigong");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("dodge", "lingfu-steps");
  map_skill("blade", "kugu-blade");
  map_skill("parry", "kugu-blade");
  setup();
  carry_object("/d/obj/armor/tongjia")->wear();
  carry_object("/d/obj/weapon/blade/blade")->wield();
  set("no_nk_reward",1);
}

void init ()
{
  object ob = this_player();
  object me = this_object();

  if(living(ob))
  call_out("greeting", 1, ob);
}

void greeting(object ob)
{
  if( !ob || environment(ob) != environment() ) return;
  if (ob && interactive(ob))
{
    if (! ob->query_temp("weishi_kill"))
      message_vision (HIW"$N大声喝道：大胆晚辈，敢来闯我鼠神禁地。受死吧！\n"NOR,this_object());
    this_object()->kill_ob(ob);
    ob->set_temp("weishi_kill",1);
}
}
void die()
{
        object ob, me, corpse, obj;

        ob = this_object();
        me = query_temp("last_damage_from");

        message_vision(HIW"$N大叫一声，借土遁走了。\n"NOR,ob,me);
	obj = new("d/qujing/wudidong/obj/mozhong");
	obj->move(me);
        destruct(ob);
        return;
}
