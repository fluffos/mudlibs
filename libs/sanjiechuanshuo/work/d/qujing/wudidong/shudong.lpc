#include <ansi.h>
inherit ROOM;
 
void create()
{
  set("short", YEL"老鼠洞"NOR);
  set("long", YEL"    这是一神秘的暗洞，周围灰蒙蒙的，脚下坑坑洼洼，一不小心就
会踩空，隐约中你仿佛看到一小个灰色的人影。\n"NOR);
  set("objects", ([
		   __DIR__"npc/shumo" : 1,
		   ]));
  set("outdoors", 0);
  set("exits", ([ 
		 "up" : __DIR__"inner-tang",
		 ]));
  setup();
}
