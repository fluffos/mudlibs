// /d/qujing/jindou/kuang/npc/sellman.c
#include <ansi.h>
inherit NPC;
void create()
{
 set_name(HIW"收矿工作着"NOR,({"worker"}));
 set("age", 40);
 set("gender", "男性");
 set("long", HIC"一为国家工作者。\n"NOR);
 set("combat_exp", 1000);
 set("attitude", "peaceful");
 set("per", 20+ random(20));
 setup();
 add_money ("silver", 5);
}

