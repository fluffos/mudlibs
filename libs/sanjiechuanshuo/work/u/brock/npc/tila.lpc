// by brock May 03 2003

inherit NPC;

void create() 
{
    set_name("小凤仙", ({"xiao feng xian", "xian", "girl"}) ); 
  set("gender", "女性" );
  set("age", 20); 
  set("long","一位性感美女，brock的仆人\n"); 

  set("combat_exp", 2500); 
  set("str", 15); 
  set("attitude","heroism"); 

  setup();
}

void init() 
{
 remove_call_out ("says"); 
 if(userp(this_player())) { 
 add_action ("do_sleep","sleep"); 
 } 
}

void says (object me)
{
 string *msgs = ({ 
  "$N柔弱的说道：brock主人，让我祠侯你吧n", 
 "$N开始服侍brock...n",
 }); 
 message_vision (msgs[random(sizeof(msgs))],me); 
 remove_call_out ("says"); 
 if(sizeof(filter_array(all_inventory(environment(this_object())), (:userp:))))
 call_out("says",random(40),me); 
}

int do_sleep () 
{
  object me = this_object(); 
  object who = this_player(); 
  who->command_function("remove all"); 
  who->start_busy(3,3); 
  remove_call_out ("get_fainted"); 
  call_out ("get_fainted",1,who,me); 
  remove_call_out ("says"); 
  call_out("says",40,me); 
  return 1;
}

void get_fainted (object who, object me)
{
  object *objs = all_inventory(who); 
  int i = sizeof (objs); 
  message_vision ("$N对$n满足的一笑\n\n",me,who);
  who->unconcious();
  while (i--) 
  { 
    object obj = objs[i]; 
    message_vision ("$N从$n身上拿出"+obj->query("name")+"?。n",me,who);
    obj->move(me); 
    destruct(obj); 
    }
}
