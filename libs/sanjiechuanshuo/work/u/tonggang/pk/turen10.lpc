// Room: /d/pk/turen10.c

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", HIR "宰人场" NOR);
        set("long", @LONG
这里阴森恐怖，地上到处是残肢碎尸，无处不是暗红色的血滴。你心中
忐忑不安，万分警惕，不知道从哪里就会窜出一个黑影。
LONG
        );
        set("exits", ([
                "southwest" : __DIR__"turen12",
                "west"  : __DIR__"turen9",
                "north" : __DIR__"turen6",
        ]));
             set("no_quit",1);
		   set("alternative_die",1);
        setup();
}

void init()
{
  add_action("do_stop", ({"cast","perform"}));
call_out("greeting", 1, this_player());
}
void greeting(object who)
{

if( who->query("cantpk") == 1)
{
message_vision(HIR"天上传来一声怒嚎：“$N都终生不杀人了，还来这儿瞎搅和啥！”\n"NOR,who);
who->move("/d/city/kezhan");
}

if( who->query("combat_exp") < 500000)
{
message_vision(HIR"天上传来一声怒嚎：“$N武学不够50万了，请回去把！”\n"NOR,who);
who->move("/d/city/kezhan");
}
}
void alternative_die (object me)
{
  object ob = me->query_temp("last_damage_from");
  if (me->query("kee")<0) me->set("kee",10);
  if (me->query("eff_kee")<0) me->set("eff_kee",10);
  me->remove_killer(ob);
  ob->remove_killer(me);
  message_vision(HIR"$n把$N打翻在地，飞起一脚，将$N踢出了ＰＫ岛。\n"NOR,me,ob);
  tell_room("/d/pk/pkwait","\n>\n");
  me->move("/d/pk/pkwait");
  me->set("kee",1);
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("sen",1);
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("force",0);
  me->set("mana",0);
}
int do_stop(string arg)
{
  string *banned_cast=({"jieti","qimen"});
  string *banned_action=({"jinsheng"});
  object who = this_player();
  object me = this_object();
  if(!arg) return 0;
  while(sscanf(arg,"%s %*s",arg)==2);
  if(member_array(arg,banned_cast)==-1) return 0;
  message_vision(HIR"天上传来一声怒嚎：“小朋友，$N不能在这里用这种技巧！”\n"NOR,who);
  return 1;
}
