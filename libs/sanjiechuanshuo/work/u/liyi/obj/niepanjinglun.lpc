// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit HAMMER;

void create()
{
        set_name(HIG "涅盘经轮" NOR, ({ "niepanjinglun" ,"hammer" }) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "如来神掌第五式迎佛西天护法佛兵。\n");
                set("value", 200000);
                set("material", "iron");
        }
        init_hammer(140);
        set("wield_msg", "$N拿出一把$n，试了试重量，然后握在手中。\n");
        set("unwield_msg", "$N放下手中的$n。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("sen",dam/50);
        victim->receive_damage("kee",dam/50);
        return HIG "身行急转，现出如来法相手结转法轮印砸出一式迎佛西天。\n" NOR;
}

