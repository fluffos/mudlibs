// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit AXE;

void create()
{
        set_name(WHT "刑天斧" NOR, ({ "xingtianfu" ,"axe" ,"fu" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "刑天的随身兵刃。\n");
                set("value", 200000);
                set("material", "iron");
        }
        init_axe(140);
        set("wield_msg", "$N拿出一把$n，握在手中当作武器。\n");
        set("unwield_msg", "$N放下手中的$n。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("sen",dam/50);
        victim->receive_damage("kee",dam/50);
        return WHT "$N口中叫道刑天到天地灭手中巨斧寒光大现!\n" NOR;
}

