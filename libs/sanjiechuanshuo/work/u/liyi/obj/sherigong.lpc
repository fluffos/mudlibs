// LLY@FYSY 


#include <weapon.h>
#include <ansi.h>
inherit BOW;

void create()
{
        set_name(HIR "射日弓" NOR, ({ "sherigong" ,"bow" ,"gong" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long", "当年后羿射日时使用的神弓。\n");
                set("value", 200000);
                set("material", "steel");
        }
        init_bow(140);
        set("wield_msg", "$N抓起一张$n，握在手中当武器。\n");
        set("unwield_msg", "$N将手中的$n放下。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("sen",dam/50);
        victim->receive_damage("kee",dam/50);
        return HIR "$N就像后羿般神勇，拉开神弓射向$n。\n" NOR;
}

