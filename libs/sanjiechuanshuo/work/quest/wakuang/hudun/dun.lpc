#include <ansi.h>
#include <armor.h>

inherit SHIELD;

void create()
{
        set_name(YEL"盾"NOR, ({ "jia" }) );
        set_weight(200);
     if ( clonep() )
     set_default_object(__FILE__);
  else {
   set("unit", "件");
   set("value", 1000);
    set("material", "crimsonsteel");
   set("no_sell", 1);
   set("no_drop", 1);
   set("no_put", 1); 
set("no_give", "这是你的心血啊怎么能轻易送人呢?\n");
   set("armor_prop/armor", 10);
   set("armor_prop/dodge", -2); 
  set("unique", 1);
  }
  setup();
 }

