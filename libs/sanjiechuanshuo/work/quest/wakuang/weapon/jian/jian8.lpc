// LLY@FYSY 
// sword.c : an example weapon

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIC"昆 吾 剑" NOR, ({ "shelisword" ,"sword" ,"jian" ,}) );
        set_weight(13000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "十大神器之中排行第三，乃剑中之祖,天外天的力量，终于被爆成粉碎，惟有一根完整的脊椎骨化成了一柄剑,因其现于昆仑，因此叫昆吾剑。\n");
                set("value", 200000);
                set("material", "steel");
        }
        init_sword(150+random(50));
        set("wield_msg", "$N心中默念昆吾$n自行越出在$N身边急速旋转，$n与$N不分你我合二为一周身现出无形剑气");
        set("unwield_msg", "$N将$n收回,身上的剑气猛的消失无影无踪，看上去与长人无异。\n");
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        if (random(100)>40)
        {dam = (int) me->query("force");
        victim->receive_damage("sen",dam/75);
        victim->receive_damage("kee",dam/75);
        return BLINK "临⊙兵⊙斗⊙者⊙皆⊙阵⊙列⊙在⊙前\n" NOR;
}
else
return 1;
}

