// rankd.c

#include <ansi.h>

string query_rank(object ob)
{
	if( ob->is_ghost() ) return HIB " 碍  活 " NOR;
	switch(ob->query("gender")) {
	case "┦":
		switch(wizhood(ob)) {
			case "(admin)":			return HIM "    " NOR;
			case "(arch)":			return HIM " 臸 " NOR;
			case "(wizard)":		return HIM " 臸   " NOR;
			case "(apprentice)":		return HIM " 臸 " NOR;
			case "(immortal)":		return HIM "    " NOR;
			default:
	if( ((int)ob->query("PKS") > 100) && ((int)ob->query("PKS") > (int)ob->query("MKS")) )
			return " 炳臸 ";
	if( (int)ob->query("thief") > 10 )
			return " 篋  叛 ";
				switch(ob->query("class")) {
					case "bonze":		return " ェ  ﹉ ";
					case "taoist":		return "   玜 ";
					case "bandit":		return " 搁 ";
					case "dancer":		return " 籖  Р ";
					case "scholar":		return "    ";
					case "officer":		return "   ﹛ ";
					case "fighter":		return " 猌 ";
					case "swordsman":		return " 糃 ";
					case "alchemist":		return " よ   ";
					case "shaman":		return "   洛 ";
					case "beggar":		return " て ";
					case "teacher":		return " ρ畍 ";
					case "student":		return " 厩ネ ";
					case "soldier":		return " 瓁 ";					case "sage":		return " 藉   ";
					case "beggar":		return " て ";		
					default:			return " キ  チ ";
			}
		}
	default:
		switch(wizhood(ob)) {
			case "(admin)":			return HIG " ぱ   " NOR;
			case "(arch)":			return HIG " 畍 " NOR;
			case "(wizard)":		return HIG "   畍 " NOR;
			case "(apprentice)":		return HIG "畍厩畕" NOR;
			case "(immortal)":		return HIG "    " NOR;
			default:
	if( ((int)ob->query("PKS") > 100) && ((int)ob->query("PKS") > (int)ob->query("MKS")) )
			return " 炳臸 ";
	if( (int)ob->query("thief") > 10 ) 
			return " 篋  叛 ";
				switch(ob->query("class")) {
					case "bonze":		return " 宫   ";
					case "taoist":		return " 笵   ";
					case "bandit":		return " 祍  搁 ";
					case "scholar":		return "   ネ ";
					case "officer":		return " ﹛  畉 ";
					case "fighter":		return " 猌   ";
					case "swordsman":		return " 糃   ";
					case "alchemist":		return " よ   ";
					case "shaman":		return "   洛 ";
					case "beggar":		return " て ";
					case "teacher":		return " ρ  畍 ";
					case "student":		return " 厩  ネ ";
					case "sage":		return " 藉   ";
					case "soldier":		return " 瓁   ";					default:			return " キ  チ ";
			}
		}
	}
}

string query_respect(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/respect")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "┦":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 18 ) return "畍び";
				else return "畍び";
				break;
			case "taoist":
				if( age < 18 ) return "﹉";
				else return "﹉";
				break;
			default:
				if( age < 18 ) return "﹉甉";
				else if( age < 50 ) return "﹉甉";
				else return "盋盋";
				break;
			}
		case "╧┦":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 18 ) return "畍";
				else return "畍";
				break;
			case "taoist":
				if( age < 18 ) return "笵";
				else return "笵";
				break;
			case "fighter":
			case "swordsman":
				if( age < 18 ) return "ρ";
				else if( age < 50 ) return "Ё";
				else return "ρ玡晋";
				break;
			default:
				if( age < 20 ) return "";
				else if( age < 50 ) return "Ё";
				else return "ρ份";
				break;
			}
	}
}

string query_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/rude")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "┦":
			switch(ob->query("class")) {
			case "bonze":
				return "搁ェ";
				break;
			case "taoist":
				return "Н";
				break;
			default:
				if( age < 30 ) return "解";
				else return "ρび盋";
				break;
			}
		case "╧┦":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "╮苆";
				else return "ρ╮苆";
				break;
			case "taoist":
				return "惑";
				break;
			default:
				if( age < 20 ) return "矹";
				if( age < 50 ) return "搁";
				else return "ρでひ";
				break;
			}
	}
}

string query_self(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "┦":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "砲ェ";
				else return "ρェ";
				break;
			default:
				if( age < 30 ) return "";
				else return "ヽō";
				break;
			}
		case "╧┦":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "砲宫";
				else return "ρ";
				break;
			case "taoist":
				return "砲笵";
				break;
			default:
				if( age < 50 ) return "";
				else return "ρ繷";
				break;
			}
	}
}

string query_self_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self_rude")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "┦":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "砲ェ";
				else return "ρェ";
				break;
			default:
				if( age < 30 ) return "セ﹉甉";
				else return "ρ甉";
				break;
			}
		case "╧┦":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "㎝﹟и";
				else return "ρ㎝﹟и";
				break;
			case "taoist":
				return "セ";
				break;
			default:
				if( age < 50 ) return "份и";
				else return "ρ";
				break;
			}
	}
}
