// channeld.c

#include <ansi.h>
#include <net/dns.h>
mapping channels = ([
  "sys": ([ "msg_speak": HIB "【系統】%s﹕%s\n" NOR,
    "msg_emote": HIB "【系統】%s" NOR,
    "wiz_only": 1 ]),
  "wiz": ([ "msg_speak": HIY "【巫師】%s﹕%s\n" NOR,
    "msg_emote": HIY "【巫師】%s" NOR,
    "wiz_only": 1 ]),
  "gwiz": ([ "msg_speak": HIG "【網際巫師】%s﹕%s\n" NOR,
    "msg_emote": HIG "【網際巫師】%s" NOR,
    "wiz_only": 1, "intermud": GWIZ, "channel": "CREATOR",
    "filter": 1 ]),
  "es": ([ "msg_speak": CYN "【東方故事】%s﹕%s\n" NOR,
    "msg_emote": CYN "【東方故事】%s" NOR,
    "intermud": GCHANNEL, "channel": "es",
    "filter": (: $1["MUDLIB"] == "Eastern Stories" :) ]),
  "twiz": ([ "msg_speak": HIR "【台灣巫師】%s﹕%s\n" NOR,
    "msg_emote": HIR "【台灣巫師】%s" NOR,
    "wiz_only": 1, "intermud": GCHANNEL, "channel": "twiz",
    "filter": (: $1["HOSTADDRESS"][0..2] == "140" :) ]),

  "chat": ([ "msg_speak": HIC "【寒喧】%s﹕%s\n" NOR,
    "msg_emote": HIC "【寒喧】%s" NOR,
  ]),
  "rumor": ([ "msg_speak": HIM "【謠言】%s﹕%s\n" NOR,
    "msg_emote": HIM "【謠言】%s" NOR,
    "anonymous": "某人",
    "someone": "某人" ]),
  "music": ([ "msg_speak": HIG "【音樂】%s : %s\n" NOR,
    "msg_emote": HIG "【音樂】%s" NOR, ]),
  "sammy": ([ "msg_speak": HIW "【無言不語】%s : %s\n" NOR,
    "msg_emote": HIC "【無言不語】%s" NOR, ]),
  "cc": ([ "msg_speak": HIY "【門派】" NOR "%s : %s\n" NOR,
    "msg_emote": HIY "【門派】" NOR "%s" NOR,
    "cc_only": 1 ]),
]);

void create() {
  seteuid(getuid());      // This is required to pass intermud access check.
}
varargs int do_channel(object me, string verb, string arg, int emote) {
  object *ob;
  string *tuned_ch, who;

  if (verb == "") return 0;
  if (verb[<1] == '*') {
    emote = 1;
    verb = verb[0..<2];
  }
  if (!mapp(channels) || undefinedp(channels[verb]))
    return 0;
  if (userp(me)) {
    if (channels[verb]["wiz_only"] && !wizardp(me))
      return 0;
    if (arg == (string)me->query_temp("last_channel_msg"))
      return notify_fail("用交談頻道說話請不要重複相同的訊息。\n");
    // If we speaks something in this channel, then must tune it in.
    tuned_ch = me->query("channels");
    if (!pointerp(tuned_ch))
      me->set("channels", ({ verb }));
    else if (member_array(verb, tuned_ch) == -1)
      me->set("channels", tuned_ch + ({ verb }));
  }

  if (channels[verb]["anonymous"])
    who = channels[verb]["anonymous"];
  else if (userp(me) || !stringp(who = me->query("channel_id")))
    who = me->query("name") + "(" + capitalize(me->query("id")) + ")";
  if (emote && !channels[verb]["intermud_emote"]) {
    string vb, emote_arg;
    if (!arg)
      arg = (string)me->name() + "看起來表情豐富。\n";
    else {
      if (sscanf(arg, "%s %s", vb, emote_arg) != 2) {
        vb = arg;
        emote_arg = "";
      }
      arg = EMOTE_D->do_emote(me, vb, emote_arg, 1, channels[verb]["anonymous"]);
      if (!arg)
        arg = me->name() + vb + " " + emote_arg + "\n";
    }
    if (channels[verb]["anonymous"])
      arg = replace_string(arg, me->name(), channels[verb]["anonymous"]);
  }
  // Ok, now send the message to those people listening us.
  ob = filter_array(users(), "filter_listener", this_object(), channels[verb], me);
  if (!arg) arg = "...";
  if (emote) {
    string msg;
    if (!channels[verb]["msg_emote"])
      return notify_fail("這個頻道不能 emote。\n");
    msg = sprintf(channels[verb]["msg_emote"], arg);
    message("channel:" + verb, msg, ob);
    if (verb == "rumor") {
      string vb, emote_arg;

      if (!arg)
        arg = (string)me->name() + "看起來表情豐富。\n";
      else {
        if (sscanf(arg, "%s %s", vb, emote_arg) != 2) {
          vb = arg;
          emote_arg = "";
        }
        arg = EMOTE_D->do_emote(me, vb, emote_arg, 1);
        if (!arg)
          arg = me->query("name") + "(" + capitalize(me->query("id")) + ")" + vb + " " + emote_arg;
      }
      msg = sprintf(channels["sys"]["msg_emote"], arg);
      message("channel:" + verb, msg, ob);
    }
  } else {
    message("channel:" + verb,
      sprintf(emote ? channels[verb]["msg_emote"] : channels[verb]["msg_speak"], who, arg), ob);
    if (verb == "rumor") {
      if (userp(me) || !stringp(who = me->query("channel_id")))
        who = me->query("name") + "(" + capitalize(me->query("id")) + ")";
      message("channel:" + verb,
        sprintf(emote ? channels["sys"]["msg_emote"] : channels["sys"]["msg_speak"], who, arg), ob);
    }
  }
  if (arrayp(channels[verb]["extra_listener"])) {
    channels[verb]["extra_listener"] -= ({ 0 });
    if (sizeof(channels[verb]["extra_listener"]))
      channels[verb]["extra_listener"]->relay_channel(me, verb, arg);
  }

  if (!undefinedp(channels[verb]["intermud"])
    && base_name(me) != channels[verb]["intermud"])
    channels[verb]["intermud"]->send_msg(
      channels[verb]["channel"], me->query("id"), me->name(1), arg, 0,
      channels[verb]["filter"]);

  if (userp(me))
    me->set_temp("last_channel_msg", arg);

  return 1;
}
int filter_listener(object ppl, mapping ch, object me) {
  if (!environment(ppl)) return 0;
  if (ch["wiz_only"]) return wizardp(ppl);
  if (ch["cc_only"] && me->query("family/family_name") != ppl->query("family/family_name")) return 0;
  return 1;
}
void register_relay_channel(string channel) {
  object ob;

  ob = previous_object();
  if (undefinedp(channels[channel]) || !ob) return;
  if (arrayp(channels[channel]["extra_listener"])) {
    if (member_array(ob, channels[channel]["extra_listener"]) >= 0) return;
    channels[channel]["extra_listener"] += ({ ob });
  } else
    channels[channel]["extra_listener"] = ({ ob });
}
