// human.c

// A normal human is at least 40 kg weight
#define BASE_WEIGHT 40000

inherit F_DBASE;

mapping *combat_action = ({
	([	"action":		"$N揣ю阑$n$l",
		"damage_type":	"凤端",
	]),
	([	"action":		"$N┕$n$lъ",
		"damage_type":	"ъ端",
	]),
	([	"action":		"$N┕$n$l金竲",
		"damage_type":	"凤端",
	]),
	([	"action":		"$N矗癬繷┕$n$l川",
		"damage_type":	"凤端",
	]),
	([	"action":		"$N癸非$n$lノ揣",
		"damage_type":	"凤端",
	]),
});

void create()
{
	seteuid(getuid());
	set("unit", "︗");
	set("gender", "╧┦");
	set("can_speak", 1);
	set("attitude", "peaceful");
	set("limbs", ({
		"繷场",	"繴场",	"",	"み",	"オ",	"",	"オ羥",
		"羥",	"オも",	"も",	"竬丁",	"浮",	"オ籐",	"籐",
		"オ竲",	"竲"
	}) );
}

void setup_human(object ob)
{
	mapping my;

	my = ob->query_entire_dbase();

	ob->set("default_actions", (: call_other, __FILE__, "query_action" :));
	
	if( undefinedp(my["level"]) ) my["level"] = random(20) + 1;//穝糤
	
if( undefinedp(my["age"]) ) my["age"] = random(30) + 15;
ob->set_default_object(__FILE__);
if( !ob->query_weight() ) ob->set_weight(BASE_WEIGHT + (my["str"] - 10)* 2000);
if(userp(ob) )
{
 my["max_int"] =240;
my["max_wis"] =240;
 my["max_con"] =240;
 my["max_str"] =240;
my["max_air"] =240;
  my["max_dex"] =240;
my["max_lck"]=240;
my["max_mus"]=240;
}
}

mapping query_action()
{
	return combat_action[random(sizeof(combat_action))];
}
