
#define RMK_VERSION "(v1.0)"

inherit ITEM;
inherit F_AUTOLOAD;

string *special_props = ({
	"short", "long" });

int save_npc_file(string yn, string file, string str);

void create()
{
	set_name("NPC絪胯竟" + RMK_VERSION, ({ "npc maker", "maker","npc" }) );
	set_weight(100);
        set("value",200);
	set("unit", "" );
	set("long", @LONG
硂琌ノㄓе硉籹硑┬丁ㄣ腊丁ぃ┪Τ腨  lag 畍
ノ絬块籹硑虏虫┬丁ぃ筁狦稱矗蔼︑跋办┬丁珇借程
ぃ璶びㄌ苦硂狥﹁ㄏノ碭

mknpc <NPC郎>             : 承硑穝 NPC ,礛腊ウ砞﹚妮┦

nset <┬丁妮┦> <妮┦ず甧>  : 砞﹚NPC妮┦ age score 单

savenpc                     : 盢┮承硑NPC郎

carry <窥计> <臸ホ计> <珇郎> 

nname <璣ゅ> <いゅ> <┦> <闹>

att <驹矮> <单> <ю阑> <ň縨> <羘辨>

LONG
	);
}

int query_autoload() { return 1; }

void init()
{
		seteuid(getuid(environment()));
		add_action("do_mknpc", "mknpc");
		add_action("do_nset", "nset");
		add_action("do_savenpc", "savenpc");
		add_action("do_carry", "carry");
		add_action("do_att", "att");
		add_action("do_nname", "nname");
}


int do_mknpc(string arg)
{
	string file, dir, code;
        object npc;

	if( !arg ) return notify_fail("Αmknpc <NPC郎>\n");
	if( sscanf(arg, "%s %s", file, dir)!=2 )
		file = arg;
	seteuid(geteuid(this_player()));
	file = resolve_path(this_player()->query("cwd"), file) + ".lpc";
	if( file_size(file)!=-1 )
		return notify_fail("郎 " + file + " 竒\n");
	if( !write_file(file, @ROOM_CODE
