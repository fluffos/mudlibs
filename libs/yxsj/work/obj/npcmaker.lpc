#define RMK_VERSION "(v1.0版)"

inherit ITEM;
inherit F_AUTOLOAD;

string *special_props = ({
  "short", "long" });

int save_npc_file(string yn, string file, string str);

void create() {
  set_name("NPC編輯器" + RMK_VERSION, ({ "npc maker", "maker", "npc" }));
  set_weight(100);
  set("value", 200);
  set("unit", "個");
  set("long", @LONG
這是一個用來「快速」製造房間的工具﹐幫助時間不多或有嚴重  lag 的巫師
利用線上輸入製造簡單的房間﹐不過如果你想提高自己區域房間的品質﹐最好
不要太依賴這個東西﹐你可以使用以下幾個指令﹕

mknpc <NPC檔名>             : 創造出一個新的 NPC 人物,然後你可以幫它設定屬性。

nset <房間屬性> <屬性內容>  : 設定NPC的屬性﹐如 age ﹐score 等。

savenpc                     : 將你所創造的NPC存檔。

carry <金錢數> <魔石數> <物品檔> 

nname <英文名> <中文名> <性別> <年齡>

att <戰鬥力> <等級> <攻擊力> <防禦力> <聲望>

LONG
  );
}

int query_autoload() { return 1; }

void init() {
  seteuid(getuid(environment()));
  add_action("do_mknpc", "mknpc");
  add_action("do_nset", "nset");
  add_action("do_savenpc", "savenpc");
  add_action("do_carry", "carry");
  add_action("do_att", "att");
  add_action("do_nname", "nname");
}


int do_mknpc(string arg) {
  string file, dir, code;
  object npc;

  if (!arg) return notify_fail("指令格式﹕mknpc <NPC檔名>\n");
  if (sscanf(arg, "%s %s", file, dir) != 2)
    file = arg;
  seteuid(geteuid(this_player()));
  file = resolve_path(this_player()->query("cwd"), file) + ".lpc";
  if (file_size(file) != -1)
    return notify_fail("檔案 " + file + " 已經存在了。\n");
  if (!write_file(file, @ROOM_CODE
// NPC

#include <ansi.h>
inherit NPC;

void create()
{
	set_name("新的NPC", ({"new npc","npc","new"}));
	set("long", "新的NPC。\n");
        set("age",21);
        set("score",1);
        set("combat_exp",10);
        set_temp("apply/attack",30);
        set_temp("apply/armor",10);
        set("level",10);
        set_temp("carry","/d/obj/weapon/short_sword");
        set_temp("coin",30);
        set_temp("rock",1);
	setup();
}
ROOM_CODE
  )) return notify_fail("你沒有寫入檔案(" + file + ")的權利。\n");
  message_vision("只聽到$N的房間編輯器「嗶」的一聲﹐你覺得這個世界又多了一個NPC。\n", this_player());
  this_player()->set("cwd", file);
  npc = new(this_player()->query("cwd"));
  npc->move(environment(this_player()));
  return 1;
}

int do_nset(string arg) {
  string prop, str;
  mixed data;
  object npc;

  if (!arg || sscanf(arg, "%s %s", prop, str) != 2)
    return notify_fail("指令格式﹕nset <屬性> <屬性內容>\n");

  if (sscanf(str, "%d", data) != 1)
    data = str;
  if (prop == "long")
    str = str + "\n";

  npc = present("new npc", environment(this_player()));
  if (!objectp(npc)) {
    npc = new(this_player()->query("cwd"));
    npc->move(environment(this_player()));
  }
  npc->set(prop, str);
  write("Ok.\n");
  return 1;
}

int do_carry(string arg) {
  string obj;
  object npc;
  int coin, rock;

  if (!arg || sscanf(arg, "%d %d %s", coin, rock, obj) != 3)
    return notify_fail("指令格式﹕carry <金錢數> <魔石數> <物品檔>\n");

  npc = present("new npc", environment(this_player()));

  npc->set_temp("coin", coin);
  npc->set_temp("rock", rock);
  npc->set_temp("carry", obj);
  write("Ok.\n");
  return 1;
}

int do_att(string arg) {
  object npc;
  int exp, level, attack, armor, score;

  if (!arg || sscanf(arg, "%d %d %d %d %d", exp, level, attack, armor, score) != 5)
    return notify_fail("指令格式﹕att <戰鬥力> <等級> <攻擊力> <防禦力> <聲望>\n");

  npc = present("new npc", environment(this_player()));

  npc->set("combat_exp", exp);
  npc->set("level", level);
  npc->set_temp("apply/attack", attack);
  npc->set_temp("apply/armor", armor);
  npc->set("score", score);

  write("Ok.\n");
  return 1;
}

int do_nname(string arg) {
  object npc;
  int age;
  string id, name, gender;

  if (!arg || sscanf(arg, "%s %s %s %d", id, name, gender, age) != 4)
    return notify_fail("指令格式﹕nname <英文名> <中文名> <性別> <年齡>\n");

  npc = present("new npc", environment(this_player()));

  npc->set("name", name);
  npc->set("id", id);
  npc->set("gender", gender);
  npc->set("age", age);

  write("Ok.\n");
  return 1;
}

int do_savenpc(string arg) {
  object npc;
  string str, *name, file;
  mapping prop;
  int i;

  npc = present("new npc", environment(this_player()));
  if (!npc) {
    npc = new(this_player()->query("cwd"));
    npc->move(environment(this_player()));
  }
  npc->delete("default_actions");
  npc->delete("actions");
  npc->delete("mana");
  npc->delete("skill");
  npc->delete("max_mana");
  npc->delete("max_skill");
  npc->delete("eff_sen");
  npc->delete("eff_kee");
  npc->delete("sen");
  npc->delete("kee");
  npc->delete("max_sen");
  npc->delete("max_kee");
  npc->delete("kar");
  npc->delete("con");
  npc->delete("per");
  npc->delete("cps");
  npc->delete("spi");
  npc->delete("int");
  npc->delete("cor");
  npc->delete("str");
  npc->delete("env");

  file = this_player()->query("cwd");
  str = "// Room: " + file + @NPC_CODE

#include <ansi.h>
inherit NPC;

void create()
{
NPC_CODE;
  str += sprintf("\tset_name(%O, ({%O}));\n", npc->query("name"), npc->query("id"));
  str += sprintf("\tlevel(%O);\n", npc->query("level"));

  npc->delete("id");
  npc->delete("name");
  npc->delete("level");
  prop = npc->query_entire_dbase();
  name = keys(prop);
  for (i = 0; i < sizeof(name); i++) {
    if (member_array(name[i], special_props) != -1) continue;
    str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]]);
  }
  str += sprintf("\tset_temp(\"apply/attack\", %O);\n", npc->query_temp("apply/attack"));
  str += sprintf("\tset_temp(\"apply/armor\", %O);\n", npc->query_temp("apply/armor"));
  str += "\n\tsetup();\n";
  str += sprintf("\tcarry_object(%O);\n", npc->query_temp("carry"));
  str += sprintf("\tadd_money(\"coin\",%O);\n", npc->query_temp("coin"));
  str += sprintf("\tadd_money(\"magic_rock\",%O);\n", npc->query_temp("rock"));
  str += "}\n";

  if (file_size(file) != -1) {
    write("檔案 " + file + " 已存在﹐要刪除舊檔嗎﹖[y/n]");
    input_to("save_npc_file", file, str);
    return 1;
  }

  return save_npc_file("y", file, str);
}


int save_npc_file(string yn, string file, string str) {
  if (strlen(yn) < 1 || yn[0] != 'y') return 1;

  rm(file);
  write("存檔 " + file + "....");
  if (write_file(file, str)) {
    write("Ok.\n");
    return 1;
  } else
    return notify_fail("你沒有寫入這個檔案(" + file + ")的權利。\n");
}

void owner_is_killed() { destruct(this_object()); }
