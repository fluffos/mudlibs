// roc.c

inherit NPC;

void create()
{
	set_name("腜", ({ "roc" }) );
	set("long",
		"硂琌贺ㄓ︑緼尘╡揣笆籋辈癬咙р禲\n");

	set("race", "偿脋");
	set("age", 200);

	set("max_gin", 500);
	set("max_kee", 2000);
	set("max_sen", 1100);

	set("str", 80);
	set("cor", 40);
	set("spi", 40);
	set("int", 20);

	set("limbs", ({ "繷场", "ō砰", "籋", "Юぺ" }) );
	set("verbs", ({ "bite", "claw", "poke" }) );

	set_temp("apply/attack", 80);
	set_temp("apply/damage", 40);
	set_temp("apply/dodge", 70);
	set_temp("apply/armor", 30);

	set("combat_exp", 70000);
	setup();
}
