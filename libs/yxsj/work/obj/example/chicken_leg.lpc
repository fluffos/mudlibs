// chicken_leg.c

#include <weapon.h>

inherit HAMMER;
inherit F_FOOD;

void create()
{
	set_name("疦蔓籐", ({ "fried chicken leg", "chicken", "leg" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "狵疦眔糛糛蔓籐临礢枯ぐ或非称璆睪\n");
		set("unit", "");
		set("value", 30);
		set("food_remaining", 4);
		set("food_supply", 40);
		set("wield_msg", "$Nъ癬$n搐もい讽猌竟\n");
		set("material", "bone");
	}
	init_hammer(1);
	setup();
}

int finish_eat()
{
	if( !query("weapon_prop") ) return 0;
	set_name("百眔弘蔓籐癌繷", ({ "bone" }) );
	set_weight(150);
	set("long", "百眔弘蔓籐癌繷\n");
	return 1;
}
