// dragon.c

inherit NPC;

void create()
{
	set_name("き纒", ({ "dragon" }) );
	set("long",
		"硂琌唉ネ件き纒╡ō澎皗皗祇帝模泊▇\n");

	set("race", "偿脋");
	set("age", 600);
	set("attitude", "friendly");

	set("max_gin", 4000);
	set("max_kee", 6000);
	set("max_sen", 3000);

	set("str", 170);
	set("cor", 150);
	set("cps", 100);
	set("spi", 70);
	set("int", 40);

	set("limbs", ({ "繷场", "ō砰", "玡", "", "Юぺ" }) );
	set("verbs", ({ "bite", "claw" }) );

	set_temp("apply/attack", 100);
	set_temp("apply/dodge", 100);
	set_temp("apply/armor", 60);

	set("combat_exp", 1000000);
	setup();
}
