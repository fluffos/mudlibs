// dagger.c : an example weapon

#include <weapon.h>

inherit DAGGER;

void create()
{
	set_name("", ({ "dagger" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", "硂琌р癬讽炊硄\n");
		set("value", 50);
		set("material", "steel");
	}
	init_dagger(4);

// These properties are optional, if you don't set them, it will use the
// default values.

	set("wield_msg", "$N眖胔い篘р$n搐もい\n");
	set("unwield_msg", "$N盢もい$n旅胔い\n");

// The setup() is required.

	setup();
}
