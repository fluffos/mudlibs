// roommaker.c
#define RMK_VERSION "(v1.0)"

inherit ITEM;
inherit F_AUTOLOAD;

string *special_props = ({
  "short", "long" });

int save_room_file(string yn, string file, string str);
//11
void create() {
  set_name("技能編輯器" + RMK_VERSION, ({ "skill maker", "maker", "skill", "ski", "mak", "m", "s" }));
  set_weight(100);
  //        set("value",200);
  set("unit", "個");
  set("long", @LONG
這是一個用來「快速」製造技能的工具﹐幫助時間不多或有嚴重  lag 的巫師
利用線上輸入製造簡單的技能﹐不過如果你想提高自己創作的技能的品質﹐最好
不要太依賴這個東西﹐你可以使用以下幾個指令﹕

mkski <技能檔名> <技能中文名>
    造出一個「新的」技能﹐之後你可以用小作家等文書處理軟體把技能檔
    叫出,以更改其敘述或屬性。
               例:  mkski fly 飛行之術

delski <技能檔名>
    刪除一個已存在之技能。   例:   delski fly

LONG
  );
}
//31
int query_autoload() { return 1; }
//33
void init() {
  seteuid(geteuid(this_player()));
  add_action("do_mkski", "mkski");
  add_action("do_delski", "delski");
}

private int new_skill(string file, string chinz);

//42
int do_mkski(string arg) {
  string file, file2, dir, prop, chinz;
  //46
  if (!arg || sscanf(
    arg,
    "%s %s",
    file,
    chinz
  ) != 2) return notify_fail("指令格式﹕mkski <技能檔名> <技能中文名> \n");
  //50
  file2 = "/daemon/skill/" + file + ".lpc";
  if (file_size(file2) != -1)
    return notify_fail("檔案 " + file + " 已經存在了。\n");
  new_skill(file, chinz);
  return 1;
}

int do_delski(string arg) {
  string file, dir, prop;
  //46
  if (!arg) return notify_fail("指令格式﹕delski <技能檔名> \n");
  if (sscanf(arg, "%s %s", file, dir) != 2)
    file = arg;
  //50
  file = "/daemon/skill/" + file + ".lpc";
  if (file_size(file) != -1)
    rm(file);
  write("ok\n");
  return 1;
}
//58
private int new_skill(string file, string chinz) {
  string file2;
  file2 = "/daemon/skill/" + file + ".lpc";

  if (!write_file(file2, @ROOM_CODE
// This is skill made by skillmaker

inherit SKILL;

ROOM_CODE
  ))
    return notify_fail("你沒有寫入檔案(" + file2 + ")的權利。\n");
  message_vision("只聽到$N的技能編輯器「嗶」的一聲﹐這個世界上又多了一種技能。\n", this_player());
  CHINESE_D->add_translate(file, chinz);
  write(file + " == " + chinz + "\nOk.\n");
  return 1;
}
