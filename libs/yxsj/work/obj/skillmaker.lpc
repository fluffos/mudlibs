// roommaker.c
#define RMK_VERSION "(v1.0)"

inherit ITEM;
inherit F_AUTOLOAD;

string *special_props = ({
	"short", "long" });

int save_room_file(string yn, string file, string str);
//11
void create()
{
	set_name("м絪胯竟" + RMK_VERSION, ({ "skill maker", "maker","skill","ski","mak","m","s" }) );
	set_weight(100);
//        set("value",200);
	set("unit", "" );
	set("long", @LONG
硂琌ノㄓе硉籹硑мㄣ腊丁ぃ┪Τ腨  lag 畍
ノ絬块籹硑虏虫мぃ筁狦稱矗蔼︑承м珇借程
ぃ璶びㄌ苦硂狥﹁ㄏノ碭

mkski <м郎> <мいゅ>
    硑穝мぇノ產单ゅ矪瞶硁砰рм郎
    ,эㄤ痹瓃┪妮┦
               ㄒ:  mkski fly ︽ぇ砃

delski <м郎>
    埃ぇм   ㄒ:   delski fly

LONG
	);
}
//31
int query_autoload() { return 1; }
//33
void init()
{
  	        seteuid( geteuid(this_player()) );
		add_action("do_mkski", "mkski");
		add_action("do_delski", "delski");
}

private int new_skill(string file,string chinz);

//42
int do_mkski(string arg)
{
	string file,file2, dir, prop,chinz;
//46
	if( !arg || sscanf(arg,"%s %s",file,chinz)!=2) return notify_fail("Αmkski <м郎> <мいゅ> \n");
//50
	file2 = "/daemon/skill/"+ file + ".lpc";
	if( file_size(file2)!=-1 )
		return notify_fail("郎 " + file + " 竒\n");
        new_skill(file,chinz);
	return 1;
}

int do_delski(string arg)
{
	string file, dir, prop;
//46
	if( !arg ) return notify_fail("Αdelski <м郎> \n");
	if( sscanf(arg, "%s %s", file, dir)!=2 )
		file = arg;
//50
	file = "/daemon/skill/"+ file + ".lpc";
	if( file_size(file)!=-1 )
        rm(file);
        write("ok\n");
	return 1;
}
//58
private int new_skill(string file,string chinz)
{
      string file2;
      file2 = "/daemon/skill/"+ file + ".lpc";
      
	if( !write_file(file2, @ROOM_CODE
// This is skill made by skillmaker

inherit SKILL;

ROOM_CODE
	) )
        return notify_fail("⊿Τ糶郎(" + file2 +")舦\n");
	message_vision("钮$Nм絪胯竟雇羘硂贺м\n", this_player());
	CHINESE_D->add_translate(file, chinz);
	write( file + " == " + chinz + "\nOk.\n");
	return 1;
}
