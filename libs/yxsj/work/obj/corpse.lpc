// corpse.c

inherit ITEM;

int decayed;

void create()
{
	set_name("礚砰", ({ "corpse" }) );
	set("long", "硂琌ㄣ礚砰\n");
	set("unit", "ㄣ" );
	decayed = 0;
	if( clonep(this_object()) ) call_out("decay", 120, 1);
}

int is_corpse() { return decayed < 2; }
int is_character() { return decayed < 1; }
int is_container() { return 1; }

string short()
{
	return name()+"("+capitalize(query("id"))+")";
}

void decay(int phase)
{
	decayed = phase;
	switch(phase) {
		case 1:
			say( query("name") + "秨﹍籊年祇螟籇碿\n" );
			switch(query("gender")) {
				case "╧┦":
					set_name("籊年╧", ({ "corpse", "砰" }) );
				case "┦":
					set_name("籊年", ({ "corpse", "砰" }) );
				default:
					set_name("籊年砰", ({ "corpse", "砰" }) );
			}
			set("long",	"硂ㄣ砰陪礛竒仅硂柑Τ琿丁タ床祇帝籊笵\n");
			call_out("decay", 120, phase + 1);
			break;
		case 2:
			say( query("name") + "砆爱跑Θㄣ纄癌\n" );
			set_name("ㄣ琝\爱纄癌", ({ "skeleton", "纄癌" }) );
			set("long", "硂捌纄癌竒仅硂柑\n");
			call_out("decay", 60, phase + 1);
			break;
		case 3:
			say( "皚筁р" + query("name") + "てΘ癌η床\n" );
			/*if( environment() ) {
				object *inv;
				int i;
				
				inv = all_inventory(this_object());
				for(i=0; i<sizeof(inv); i++) inv[i]->move(environment());
			}*/
			destruct(this_object());
			break;
	}
}

object animate(object who, int time)
{
	object zombie;

	if( !environment() ) return 0;

	seteuid(getuid());
	zombie = new("/obj/npc/zombie");
	zombie->set_name( (string)query("victim_name") + "鞮", ({ "zombie" }) );
	zombie->move(environment());
	zombie->animate(who, time);

	destruct(this_object());
	return zombie;
}
