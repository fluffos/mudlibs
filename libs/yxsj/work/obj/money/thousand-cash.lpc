// thousand.c

inherit MONEY;

void create() {
  set_name("千元大鈔", ({ "thousand-cash", "thousand-cash_money", "cash" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "thousand-cash");
    set("long", "一張面額值一千元的鈔票。\n");
    set("unit", "疊");
    set("base_value", 1000);
    set("base_unit", "張");
    set("base_weight", 3);
  }
  set_amount(1);
}
