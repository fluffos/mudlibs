// thousand.c

inherit MONEY;

void create()
{
	set_name("じ秗", ({"thousand-cash", "thousand-cash_money", "cash"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "thousand-cash");
		set("long", "眎肂じ秗布\n");
		set("unit", "舼");
		set("base_value", 1000);
		set("base_unit", "眎");
		set("base_weight", 3);
	}
	set_amount(1);
}

