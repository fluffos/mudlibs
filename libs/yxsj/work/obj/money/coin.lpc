// coin.c

inherit MONEY;

void create() {
  set_name("硬幣", ({ "coin", "coins", "coin_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "coin");
    set("long", "這是流通中單位最小的貨幣﹐要一百個硬幣才值得一張百元鈔票。\n");
    set("unit", "些");
    set("base_value", 1);
    set("base_unit", "元");
    set("base_weight", 1);
  }
  set_amount(1);
}
