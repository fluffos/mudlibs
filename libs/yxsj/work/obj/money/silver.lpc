// silver.c

inherit MONEY;

void create()
{
	set_name("蝗", ({"silver", "ingot", "silver_money"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "silver");
		set("long", "フ蝗ǎ稲蝗\n");
		set("unit", "ㄇ");
		set("base_value", 100);
		set("base_unit", "ㄢ");
		set("base_weight", 37);
	}
	set_amount(1);
}

