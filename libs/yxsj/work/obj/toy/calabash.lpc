// bottle.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("獵脯莫", ({ "green calabash", "calabash" }) );
	set_weight(400);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌貉厚︹脯莫獵柑硓独肅︹だ癚尺稲\n");
		set("unit", "");
		set("value", 80);
		set("max_liquid", 60);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "water",
		"name": "ヌ瑄",
		"remaining": 60,
	]) );
}
