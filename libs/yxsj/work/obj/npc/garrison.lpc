// garrison.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("郡﹛", ({ "town garrison", "garrison" }) );
	set("long",
		"硂琌タ磅︽そ叭郡﹛瘤礛㎝砛\猌狶ゑ癬ㄓ﹛\n"
		"猌\龟祡肞キ盽琌琌Τ舱麓Τ驹街ぃ\n"
		"淮┷稴\n");

	set("attitude", "heroism");
	set("vendetta_mark", "authority");
	set("pursuer", 1);

	set("str", 27);
	set("cor", 26);
	set("cps", 25);

	set("combat_exp", 100000);

	set("chat_chance", 10);
	set("chat_msg", ({
		(: random_move :),
	}) );

	set("chat_chance_combat", 15);
	set("chat_msg_combat", ({
		"郡﹛耻笵临ぃе猌竟も碞浚\n",
		"郡﹛耻笵義チ澈幢┶はは\n"
	}) );

	set_skill("unarmed", 70);
	set_skill("sword", 70);
	set_skill("parry", 70);
	set_skill("dodge", 70);
	set_skill("move", 100);

	set_temp("apply/attack", 70);
	set_temp("apply/defense", 70);
	set_temp("apply/damage", 30);
	set_temp("apply/armor", 70);
	set_temp("apply/move", 100);

	setup();

	carry_object("/obj/cloth")->wear();
	carry_object("/obj/longsword")->wield();
}

