// demongorgon.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name( HIW "玍ぱ碍" NOR, ({ "demogorgon" }) );
	set("long",
		"玍ぱ碍薄镀玡蔼ō逻蛤部\n"
		"┤炳タ溃眔碭齿ぃ筁ㄓみ柑Τ羘\n"
		"禗 е 発 \n");

	set("age", 7006);
	set("pursuer", 1);

	set("max_gin", 5000);
	set("max_kee", 5000);
	set("max_sen", 5000);

	set("max_atman", 9999);
	set("atman", 9999);
	set("max_force", 5000);
	set("force", 5000);
	set("max_mana", 5000);
	set("mana", 5000);

	set("str", 100);
	set("cor", 100);
	set("cps", 100);
	set("spi", 100);
	set("int", 100);
	set("con", 100);
	set("kar", 0);
	set("per", 0);

	set("combat_exp", 5000000);

	set_skill("staff", 100);
	set_skill("unarmed", 100);
	set_skill("parry", 100);
	set_skill("dodge", 100);

	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);
	set_temp("apply/armor", 100);
	set_temp("apply/damage", 100);

	setup();

	carry_object(__DIR__"obj/demon_staff")->wield();
}

void start_shutdown()
{
	if( geteuid(previous_object()) != ROOT_UID ) return;

	message("system",
		HIR "\n钮ぱい肚ㄓ皚┤〩 ....\n\n"
		HIW	"玍ぱ碍" HIR "ノ綺φ饼扭羘耻笵\n\n"
			"\t\t ぱ   渤 ネ 倒 и 钮 帝 \n\n"
			"\t\tきだ牧ずри繷芵ユㄓ \n\n"
			"\t\tぃ 礛  杠 .....  ..  \n\n" NOR,
		users() );
	call_out("countdown", 60, 15);
}

private void countdown(int min)
{
	min--;
	if( min ) {
		message("system",
			HIW "\n玍ぱ碍" HIR "ノ綺φ饼扭羘耻笵\n\n"
				"\t\t临Τ" + chinese_number(min) + "だ牧丁ユи繷芵\n\n"
				"\t\tぃ璶㏑碞倒и篊篊╈\n\n" NOR,
			users() );
		call_out("countdown", 60, min);
	} else {
		message("system",
			HIW "\n玍ぱ碍" HIR "ノ綺φ饼扭羘耻笵\n\n"
				"\t\t.....痷琌....\n\n"
				"\t\t籥ぱ摆° 摆°  瑅摆°  渤ネ摆°\n\n" NOR,
			users() );
		call_out("do_shutdown", 3);
	}
}

private void do_shutdown()
{
	message("system",
		HIW "\n\n玍ぱ碍" HIR "ノ綺φ饼扭羘耻笵\n\n"
		HIW "\t\t硄 硄 ㎝ и  癬   夯  °°°° \n\n"
		HIR "\t\t羘拨ぱミㄨ跑眔﹀ぃ....泊玡ち常跑眔﹀...\n\n"
			"\t\t┮Τち常俐丁炒....\n\n"
			"\t\t礛泊玡琌堵穞....礚ゎ荷堵穞....\n\n" NOR,
		users() );
	shutdown(0);
}

void die()
{
	object ob;

	if( !ob = query_temp("last_damage_from") )
		ob = this_player(1);

	if( !ob ) return;

	message("system",
		HIR "\n\n钮羘盿帝极佩籔偿脋〩羘臫过俱ぱ\n\n"
		HIW "玍ぱ碍" HIR "糝白帝碿" + ob->name(1) + "и﹚穦厨こ°°°\n\n"
			"礛笵堵︹礙㊣糞帝侥冻狠確圭繰\n\n" NOR,
		users() );
	destruct(this_object());
}
