// battle_armor.c

#include <armor.h>

inherit ARMOR;

void create()
{
	set_name("祘Α驹矮杆ヒ", ({ "battle armor <P>", "armor" }) );
	set_weight(50000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "ン");
		set("material", "gold");
		set("value", 9000);
		set("armor_prop/armor", 50);
		set("armor_prop/dodge", -20);
	}
	setup();
}
