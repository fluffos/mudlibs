// golden_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("網糃", ({ "golden sword" }) );
	set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", "р皗皗祇帝糃\n");
		set("value", 3400);
		set("material", "gold");
	}
	init_sword(40);

// These properties are optional, if you don't set them, it will use the
// default values.

	set("wield_msg", "$N詜羘┾р$n搐もい\n");
	set("unwield_msg", "$N盢もい$n础竬丁糃繲\n");

// The setup() is required.

	setup();
}
