// demon_staff.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name( RED "* 呐 ﹀ ぱ 臸 猄 *" NOR, ({ "demon staff", "staff" }) );
	set_weight(400000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", "р穞︹ㄢエ猄\n");
		set("material", "crimson gold");
	}
	init_staff(100);

	setup();
}
