// sys_b.c

inherit BULLETIN_BOARD;

void create() {
  set_name("系統公告簿", ({ "system board", "system", "sys" }));
  set("location", "/d/wiz/sysboard");
  set("board_id", "sys_b");
  set("long",
    "這是一個公告系統事項的留言板。\n");
  setup();
  set("capacity", 50);
  replace_program(BULLETIN_BOARD);
}
