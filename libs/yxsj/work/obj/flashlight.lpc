// flashlight.c

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "手電筒" NOR, ({ "flashlight", "flash", "light" }));
  set("weight", 500);
  set("long", "這是一把有用的手電筒，可以幫助你在黑暗中照明物體。\n"
    "要打開手電筒請打(open_light)，要關閉請打(close_light)。\n");
  set("value", 200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
  }
  set("battery_usage", 2);
  setup();
}

void init() {
  add_action("do_open_light", "open_light");
  add_action("do_close_light", "close_light");
}

int using_battery() {
  set("power", query("power") - 10);
  if (query("power") == query("max_power") / 5) message_vision(
    YEL "$N手上的手電筒燈光開始閃爍黯淡，似乎已經用掉了許\多電力。\n" NOR,
    this_player()
  );
  if (query("power") <= 0) {
    message_vision(YEL "$N手上的手電筒燈光迅速黯淡下來，在閃了幾下後燈光就滅了，電池似乎已經用完了。\n" NOR, this_player());
    set("power", 0);
    set("light_up", 0);
  }
  if (query("power")) call_out("using_battery", 10);
}

int do_open_light() {
  if (query("light_up")) return notify_fail("手電筒已經打開了。\n");
  if (!query("power")) {
    message_vision("$N試著要打開手電筒的開關，但是手電筒一直沒有反應。\n", this_player());
    return 1;
  }
  message_vision(HIY "$N打開了手電筒的開關，手電筒亮了起來照明了四周的物體。\n" NOR, this_player());
  set("light_up", 1);
  using_battery();
  return 1;
}

int do_close_light() {
  if (!query("light_up")) return notify_fail("手電筒已經關上了。\n");
  message_vision(YEL "$N關上了手電筒的開關，手電筒暗了下來。\n" NOR, this_player());
  set("light_up", 0);
  return 1;
}
