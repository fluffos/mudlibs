// cloudstaff.c

inherit SKILL;

mapping *action = ({
	([	"action":		"$Nㄏ┷ぱ瞷もい$w苯$n絃",
		"damage":		40,
		"dodge":		10,
		"parry":		-40,
		"damage_type":	"端"
	]),
	([	"action":		"$N揣癬$w┷獴锤ю$n$l",
		"damage":		40,
		"dodge":		20,
		"parry":		-60,
		"damage_type":	"端"
	]),
	([	"action":		"$N绢筁もい$wㄏ疊冻糶種阑$n$l",
		"damage":		40,
		"dodge":		10,
		"parry":		-40,
		"damage_type":	"端"
	]),
	([	"action":		"$Nㄏ┷村纒冻$w疾$n$l",
		"damage":		40,
		"dodge":		10,
		"parry":		-40,
		"damage_type":	"端"
	]),
});

int valid_learn(object me)
{
	if( (int)me->query("str") + (int)me->query("max_force") / 10 < 50 )
		return notify_fail("籑临ぃ镑砛\赣絤絤ずㄓ糤眏秖\n");

	return 1;
}

int valid_enable(string usage)
{
	return (usage=="staff") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	object weapon;

	if( !objectp(weapon = me->query_temp("weapon"))
	||	(string)weapon->query("skill_type") != "staff" )
		return notify_fail("ゲ斗тれ┪琌摸猌竟絤猭\n");

	if( (int)me->query("kee") < 60 )
		return notify_fail("砰ぃ镑絤硂猭临琌ヰヰ\n");
	me->receive_damage("kee", 60);
	return 1;
}
