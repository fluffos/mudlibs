string *dodge_msg = ({
	"$pも得だㄏ"HIG"ォ種も"NOR"╊┷咀盢$Nю阑て礚\n",
	"$p砰ず痷笲锣笲ì\ㄏ荡м"HIY"ネ筽"NOR"\n"
	"ǎ$p玡瞷糷痷毁纠ㄏ$Nю阑荷计砆ず\n",
	"$pō跑ㄏ"HIY"琍津冻˙"NOR"ō猭笲︽ゆ琍よ︗淮磷筁$Nю阑\n",
	"$pō锣ㄏ"HIM"癵萝˙"NOR"竲い津今よ︗淮ォ皗筁$Nю阑\n",
	"$pō猭еㄏ"HIC"だ︽て紇"NOR"ミて计ō紇ㄏ$Nю阑辅店Τ\n",
});

int practice_skill(object me)
{
	if( (int)me->query("kee") < 25
	||	(int)me->query("force") < 10 )
		return notify_fail("ず┪ぃ镑⊿Τ快猭絤策フ浆猌\\n");
	me->receive_damage("kee", 25);
	me->add("force", -10);
	write("帝┮厩絤筂フ浆猌\\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage=="force" || usage=="unarmed" || usage=="dodge" || usage=="parry" || usage=="move" || usage=="spells" || usage=="magic";
}

mapping query_action(object me)
{
	return unarmed_msg[random(sizeof(unarmed_msg))];
}

string query_dodge_msg(object weapon)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

string perform_action_file(string action)
{
	return CLASS_D("sage") + "/su-sk/" + action;
}

string exert_function_file(string func)
{
	return CLASS_D("sage") + "/su-sk/" + func;
}