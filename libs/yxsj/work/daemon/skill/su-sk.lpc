// su-sk.c

#include <ansi.h>

inherit SKILL;

mapping *unarmed_msg = ({
  ([ "action": "$N運起全身功\力，使出『" HIY "石破天驚混元掌" NOR "』，只見$N的兩手微合，運氣於之間。\n$N忽然兩手分合，由真氣發出一道宏大無比的氣功\，排山倒海的向$n而去",
    "damage": 150,
    "damage_type": "瘀傷"
  ]),
  ([ "action": "$N運起體內千年龍氣，使出『" HIG "龍氣劍" NOR "』，化為一把閃爍的氣劍直直的向$n飛去",
    "damage": 130,
    "damage_type": "瘀傷"
  ]),
  ([ "action": "$N大喝一聲，發出極招『" HIY "風雷神擊" NOR "』，破空向$n發出一道無堅不催的強大氣勁",
    "damage": 70,
    "damage_type": "瘀傷"
  ]),
  ([ "action": "$N流轉真氣，使出『" HIR "托天真陽" NOR "』，發出一道渾厚的陽剛之氣向$n的$l飛去",
    "damage": 60,
    "damage_type": "瘀傷"
  ]),
  ([ "action": "$N倒轉行氣，用出至寒絕招『" HIC "百氣寒霜指" NOR "』﹐一股冷冽的勁風快速的撲向$n",
    "damage": 100,
    "damage_type": "瘀傷"
  ]),
  ([ "action": "$N使出太黃君成名絕技『" HIM "波幻迷掌" NOR "』，發出一道變幻莫測的氣功\向$n的$l襲去",
    "damage": 80,
    "damage_type": "瘀傷"
  ]),
  ([ "action": "$N筋脈充滿真氣，使出『" HIR "昊陽震宇" NOR "』發出一道震撼天地的氣功\向$n飛去",
    "damage": 80,
    "damage_type": "瘀傷"
  ]),
  ([ "action": "$N長嘆一聲，使出佛家絕技『" HIG "苦海無涯" NOR "』向$n的$l發出一陣強大的震盪氣流",
    "damage": 90,
    "damage_type": "瘀傷"
  ]),
});

string *dodge_msg = ({
  "$p手腕一分，使出了「" HIG "七巧如意手" NOR "」，拆招擋格，將$N的攻擊化為無形。\n",
  "$p體內真氣運轉，運足功\力，使出了絕技「" HIY "九州生氣峙風雷" NOR "」！\n"
  "只見$p面前出現了一層真氣的障壁，使$N的攻擊盡數被吸納入內。\n",
  "$p身形一變，使出「" HIY "七星踩雲步" NOR "」，身法運行北斗七星方位，輕易避過了$N的攻擊。\n",
  "$p身形一轉，使出「" HIM "八卦迷蹤步" NOR "」，腳中踩踏八卦方位，輕巧的閃過了$N的攻擊。\n",
  "$p身法一快，使出「" HIC "分行化影" NOR "」，立即化為數個身影，使$N的攻擊落為虛有。\n",
});

int practice_skill(object me) {
  if ((int)me->query("kee") < 25
    || (int)me->query("force") < 10)
    return notify_fail("你的內力或氣不夠﹐沒有辦法練習白蓮武功\。\n");
  me->receive_damage("kee", 25);
  me->add("force", -10);
  write("你按著所學練了一遍白蓮武功\。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "force" || usage == "unarmed" || usage == "dodge" || usage == "parry" || usage == "move" || usage == "spells" || usage == "magic";
}

mapping query_action(object me) {
  return unarmed_msg[random(sizeof(unarmed_msg))];
}

string query_dodge_msg(object weapon) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

string perform_action_file(string action) {
  return CLASS_D("sage") + "/su-sk/" + action;
}

string exert_function_file(string func) {
  return CLASS_D("sage") + "/su-sk/" + func;
}
