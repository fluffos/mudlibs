// fonxansword.c

inherit SKILL;

mapping *action = ({
	([	"action":		"$Nㄏ┷癹ほ筿もい$wほ兵痚$n$l",
		"dodge":		-20,
		"damage":		30,
		"damage_type":	"端"
	]),
	([	"action":		"$Nㄏぱ撤紇糃い流窰紇$w硈揣糃繬繬辟$n$l",
		"dodge":		-20,
		"damage":		30,
		"damage_type":	"澄端"
	]),
	([	"action":		"$N┷摧锭酚撤羇ō钠秨计へもい$w辟$n$l",
		"dodge":		-30,
		"damage":		20,
		"damage_type":	"澄端"
	]),
	([	"action":		"$Nもい$wい甤秈Αé璱癸非$n$l糃",
		"dodge":		-40,
		"damage_type":	"端"
	]),
	([	"action":		"$N羇ō臘もい$w┷筽留癸非$n$l弊弊糃",
		"dodge":		-40,
		"damage_type":	"端"
	]),
	([	"action":		"$N$w咎┷耞ホ疶废$n$l",
		"dodge":		20,
		"damage":		40,
		"damage_type":	"端"
	]),
});

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 50 )
		return notify_fail("ずぃ镑⊿Τ快猭絤撤紇糃猭\n");

	if( (string)me->query_skill_mapped("force")!= "snowshade-force")
		return notify_fail("撤紇糃猭ゲ斗皌ぱ臸毙縒撤紇み猭絤\n");

	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "sword" )
		return notify_fail("ゲ斗тр糃絤糃猭\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
		return notify_fail("ず┪ぃ镑⊿Τ快猭絤策撤紇糃猭\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	write("帝┮厩絤筂撤紇糃猭\n");
	return 1;
}
