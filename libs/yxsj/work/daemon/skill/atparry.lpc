// atparry.c
#include <ansi.h>
inherit SKILL;

string *parry_msg = ({
  "$p冷冷的說道:「" + HIY "AT絕對領域" + NOR "可是神聖而不可侵犯的領域」\n",
  "$p的身前出現了一道半透明的" + HIR "光壁" + NOR "抵擋了$N的攻擊\n",
  "$p把手微微的舉了起來，張開了" + HIY "AT絕對領域" + NOR "阻止了$N的攻勢\n",
  "$p說道:「沒用的，你的攻擊對我是沒有用的．」\n",

});

string *unarmed_parry_msg = ({
  "$p冷冷的說道:「" + HIY "AT絕對領域" + NOR "可是神聖而不可侵犯的領域」\n",
  "$p的身前出現了一道半透明的" + HIR "光壁" + NOR "抵擋了$N的攻擊\n",
  "$p把手微微的舉了起來，張開了" + HIY "AT絕對領域" + NOR "阻止了$N的攻勢\n",
  "$p說道:「沒用的，你的攻擊對我是沒有用的．」\n",


});

string *dodge_msg = ({
  "$p冷冷的說道:「" + HIY "AT絕對領域" + NOR "可是神聖而不可侵犯的領域」\n",
  "$p的身前出現了一道半透明的" + HIR "光壁" + NOR "抵擋了$N的攻擊\n",
  "$p把手微微的舉了起來，張開了" + HIY "AT絕對領域" + NOR "阻止了$N的攻勢\n",
  "$p說道:「沒用的，你的攻擊對我是沒有用的．」\n",

});


int valid_enable(string usage) {
  return usage == "dodge" || usage == "parry";
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_dodge_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(dodge_msg))];
  else
    return dodge_msg[random(sizeof(dodge_msg))];

}
