// yangsword.c

#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action": "$N使一招『" HIR "檣傾楫摧" NOR "』﹐手中$w猛烈揮舞砍向$n的$l",
    "damage": 50,
    "damage_type": "砍傷"
  ]),
  ([ "action": "$N使出岳陽劍法中的『" HIM "百廢俱興" NOR "』﹐劍光霍霍斬向$n的$l",
    "damage": 40,
    "damage_type": "割傷"
  ]),
  ([ "action": "$N使出岳陽劍法中的『" HIC "氣象萬千" NOR "』﹐手中$w劍光變幻刺向$n的$l",
    "damage": 40,
    "damage_type": "刺傷"
  ]),
  ([ "action": "$N一招『" HIC "浩浩湯湯" NOR "』﹐$w氣勢磅礡揮向$n的$l",
    "damage": 30,
    "damage_type": "割傷"
  ]),
  ([ "action": "$N手中$w中宮直進﹐一式『" HIC "上下天光" NOR "』由上而下砍向$n的$l",
    "damage": 50,
    "damage_type": "割傷"
  ]),
  ([ "action": "$N手中$w到處揮舞，一招『" HIM "陰風怒號" NOR "』激起一股劍氣向$n的$l攻去",
    "damage": 40,
    "damage_type": "刺傷"
  ]),
  ([ "action": "$N運起內力使出『" HIR "虎嘯猿啼" NOR "』，$w與嘯聲一同攻向$n",
    "dodge": 20,
    "damage": 30,
    "damage_type": "震傷"
  ]),
  ([ "action": "$N凝神不動﹐憑空一招『" HIG "靜影沉碧" NOR "』刺向$n的$l",
    "damage": 20,
    "damage_type": "刺傷"
  ]),
  ([ "action": "$N手中$w劍芒閃爍﹐使一招『" HIY "浮光耀金" NOR "』劍鋒下下起伏挑向$n的$l",
    "damage": 20,
    "damage_type": "刺傷"
  ]),
  ([ "action": "$N橫劍上前﹐身形一轉手中$w使一招『" HIG "一碧萬頃" NOR "』畫出一道光弧斬向$n的$l",
    "damage": 50,
    "damage_type": "割傷"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的內力不夠﹐沒有辦法練岳陽劍法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必須先找一把劍才能練劍法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的內力或氣不夠﹐沒有辦法練習岳陽劍法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所學練了一遍岳陽劍法。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("swordsman") + "/yangsword/" + action;
}
