// su-sword.c

#include <ansi.h>

inherit SKILL;

mapping *sword_msg = ({
  ([ "action": "$N用出日月才子絕招「" HIG "明聖劍法" NOR "」﹐只見$w化出無數劍光襲往$n的$l",
    "dodge": -60,
    "damage": 50,
    "damage_type": "刺傷"
  ]),
  ([ "action": "$N使出「" HIR "日" HIY "月" HIC "同天" NOR "」﹐手中的$w化為日月再交會成一把巨劍向$n的$l飛去",
    "dodge": -50,
    "damage": 70,
    "damage_type": "刺傷"
  ]),
  ([ "action": "只見$N身形一變﹐使出「" HIM "旋空斬" NOR "」化為一道金光﹐連人帶劍旋轉著攻向$n",
    "dodge": -40,
    "damage": 30,
    "damage_type": "割傷"
  ]),
  ([ "action": "$N手中$w連揮﹐使出「" HIR "怒斬宇宙" NOR "」﹐發出一股猛烈的劍氣砍向$n的$l",
    "dodge": -50,
    "damage": 40,
    "damage_type": "割傷"
  ]),
  ([ "action": "$N運起真氣﹐舉起$w用出「" HIY "天河怒流" NOR "」﹐發出一道道劍氣綿綿不絕的飛向$n",
    "dodge": -40,
    "damage": 30,
    "damage_type": "刺傷"
  ]),
});

int practice_skill(object me) {
  if ((int)me->query("kee") < 20
    || (int)me->query("force") < 3)
    return notify_fail("你的內力或氣不夠﹐沒有辦法練習白蓮劍法。\n");
  me->receive_damage("kee", 15);
  me->add("force", -3);
  write("你按著所學練了一遍白蓮劍法。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword";
}

mapping query_action(object me) {
  return sword_msg[random(sizeof(sword_msg))];
}

string perform_action_file(string action) {
  return CLASS_D("sage") + "/su-sk/" + action;
}
