// su-sword.c

#include <ansi.h>

inherit SKILL;

mapping *sword_msg = ({
	([	"action":		"$Nノらる荡┷"HIG"竧糃猭"NOR"ǎ$wて礚计糃脓┕$n$l",
		"dodge":		-60,
		"damage":		50,
		"damage_type":	"端"
	]),
	([	"action":		"$Nㄏ"HIR"ら"HIY"る"HIC"ぱ"NOR"もい$wてらるユ穦Θрエ糃$n$l",
		"dodge":		-50,
		"damage":		70,
		"damage_type":	"端"
	]),
	([	"action":		"ǎ$Nō跑ㄏ"HIM"臂辟"NOR"て笵硈盿糃臂锣帝ю$n",
		"dodge":		-40,
		"damage":		30,
		"damage_type":	"澄端"
	]),
	([	"action":		"$Nもい$w硈揣ㄏ"HIR"辟﹝"NOR"祇瞨疨糃$n$l",
		"dodge":		-50,
		"damage":		40,
		"damage_type":	"澄端"
	]),
	([	"action":		"$N笲癬痷羭癬$wノ"HIY"ぱ猠瑈"NOR"祇笵笵糃壶壶ぃ荡$n",
		"dodge":		-40,
		"damage":		30,
		"damage_type":	"端"
	]),
});

int practice_skill(object me)
{
	if( (int)me->query("kee") < 20
	||	(int)me->query("force") < 3 )
		return notify_fail("ず┪ぃ镑⊿Τ快猭絤策フ浆糃猭\n");
	me->receive_damage("kee", 15);
	me->add("force", -3);
	write("帝┮厩絤筂フ浆糃猭\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage=="sword";
}

mapping query_action(object me)
{
	return sword_msg[random(sizeof(sword_msg))];
}

string perform_action_file(string action)
{
	return CLASS_D("sage") + "/su-sk/" + action;
}