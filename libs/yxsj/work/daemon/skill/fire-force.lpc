// fonxansword.c

inherit FORCE;

mapping *action = ({


	([	"action":		"$Nㄏ┷ホ瘆ぱ佩睼じ磝绰帝$n笲阑磝",
		"dodge":		-40,
		"damage_type":	"綺端"
	]),

	([	"action":		"$Nㄏ┷κ蹲﹙癸非$n$l祇笵玪",
		"dodge":		-40,
		"damage_type":	"綺端"
	]),



















});

int valid_learn(object me)
{
	object ob;
	return 1;
}

int valid_enable(string usage)
{
	return usage=="dodge" || usage=="force" || usage=="parry" || usage=="move" || usage=="unarmed";
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}


int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
		return notify_fail("ず┪ぃ镑⊿Τ快猭絤策糃猭\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	write("帝┮厩絤筂ぱ眘糃瑈\n");
	return 1;
}
string perform_action_file(string action)
{
	return CLASS_D("swordsman") + "/fonxansword/" + action;
}

string exert_function_file(string func)
{
	return CLASS_D("fighter") + "/fire-force/" + func;
}