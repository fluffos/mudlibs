// snowwhip.c

#include <ansi.h>

inherit SKILL;

mapping *action = ({
	([	"name":			"碒癬ぜ",
		"action":		"$Nㄏ┷碒癬ぜもい$wл眔掸$n$l硈计聾",
		"dodge":		-10,
		"damage":		30,
		"damage_type":	"端"
	]),
	([	"name":			"憨ぱ撤",
		"action":		"$Nō锣┷憨ぱ撤$wほ骸ぱ聾紇店店龟龟脓$n$l",
		"dodge":		-50,
		"damage":		20,
		"damage_type":	"凤端"
	]),
	([	"name":			"撤健健",
		"action":		"$N砮$w┷撤健健翴翴聾紇钠疊ぃ﹚翴$n$l",
		"dodge":		-40,
		"damage":		25,
		"damage_type":	"端"
	]),
	([	"name":			"縩撤へ",
		"action":	        "$Nもい$wл┷縩撤へ┣钵à┕$n絃辈",
		"dodge":		-40,
		"damage":		30,
		"damage_type":	"凤端"
	]),
        ([
		"name":			"╣艼撤",
		"action":		"$Nもい候ㄏ┷╣艼撤も柑$w聾钡帝聾ぃ氨┾$n$l",
		"dodge":		-50,
		"damage":		100,
		"damage_type":   "聾端"
        ]),
	([	"name":			"撤ユ",
		"action":		"$N┷撤ユもい$w籖聾紇苯$nō",
		"dodge":		-60,
		"damage":		150,
		"damage_type":	"凤端"
	]),
});

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 150 )
		return notify_fail("ずぃ镑⊿Τ快猭絤碒撤聾猭, 絤ㄇずㄓ\n");

	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "whip" )
		return notify_fail("ゲ斗т兵聾絤聾猭\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage=="whip";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 5 )
		return notify_fail("ず┪ぃ镑⊿Τ快猭絤策碒撤聾猭\n");
	me->receive_damage("kee", 30);
	me->add("force", -5);
	write("帝┮厩絤筂碒撤聾猭\n");
	return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

