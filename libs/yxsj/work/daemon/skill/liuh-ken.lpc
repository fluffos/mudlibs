// liuh-ken.c

inherit SKILL;

mapping *action = ({
	([	"action":		"$Nㄏ┷猀本る癸非$n$l㊣",
		"dodge":		-40,
		"parry":		40,
		"damage_type":	"凤端"
	]),
	([	"action":		"$N喘癬繷┷镀撤宾獽┕$n$l┷㊣筁",
		"dodge":		-30,
		"parry":		30,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nオも店﹖盫钮儡┕$n$l阑",
		"dodge":		-30,
		"parry":		30,
		"damage_type":	"凤端"
	]),
	([	"action":		"$N˙糹↖オ┰秨ㄏ阑$n$l",
		"dodge":		-30,
		"parry":		30,
		"damage_type":	"凤端"
	]),
});

int valid_learn(object me)
{
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("絤琱產猭ゲ斗も\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30 )
		return notify_fail("砰ぃ镑ヰ絤\n");
	me->receive_damage("kee", 30);
	return 1;
}
