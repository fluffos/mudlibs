// servant.c

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("孽ぱ猌", ({ "master champion", "champion", "master" }) );
	set("title", "废徽肚\ㄏ");
	set("nickname", "ぱǜ");
	set("gender", "╧┦");
	set("age", 54);
	set("long",
		"孽ぱ猌琌讽さ琌拨ネ瞉猌厩ヌ腀┻斌篴地碔\n"
		"传废徽肚\ㄏ戮獽綷\弄废徽い┮旅猌厩ㄥ膟礚阶\n"
		"Τぐ或猌厩好螟常秆氮\n");

	set("attitude", "peaceful");
	set("combat_exp", 1000000);
	set("score", 200000);

	set("str", 30);
	set("int", 30);
	set("cor", 30);
	set("cps", 30);
	set("con", 30);

	set("force", 4000);
	set("max_force", 2200);
	set("force_factor", 30);

	set("inquiry", ([
		"猌厩": "猌厩ぇ笵....垛....種穦ぃē畴\n",
		"废徽": "废徽琌菌猌狶幅︽繻Τぐ或ㄆ璶ǎ猌狶幅\n",
		"畍": "瓳....ρひㄓΤ砏痻琌稱и畍眔钡и┷ぃ稱刚刚(accept test)\n"
	]) );

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :),
	}) );
	create_family("ぱǜ", 15, "");
	assign_apprentice("", 0);

	set_skill("force", 100);
	set_skill("unarmed", 100);
	set_skill("sword", 80);
	set_skill("blade", 80);
	set_skill("parry", 100);
	set_skill("dodge", 80);
	set_skill("throwing", 50);

	set_skill("celestial", 100);
	set_skill("celestrike", 100);
	set_skill("spring-blade", 80);
	set_skill("pyrobat-steps", 90);

	map_skill("force", "celestial");
	map_skill("unarmed", "celestrike");
	map_skill("blade", "spring-blade");
	map_skill("dodge", "pyrobat-steps");

	setup();

	carry_object(__DIR__"houndbane")->wield();
}

void init()
{
	::init();
	add_action("do_accept", "accept");
}


int do_accept(string arg)
{
	mapping guild;

	if( arg== "test" ) {
		say("\n孽ぱ猌翴翴繷弧笵硂琌材┷....\n\n");
		COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon"));
		if( (int)this_player()->query("kee") < 0 
		|| !present(this_player(), environment())) {
			say("孽ぱ猌鼓弧笵硈材┷常嫉ぃ筁痷琌︑ぃ秖....\n");
			return 1;
		}
		say("\n孽ぱ猌弧笵硂琌材┷....\n\n");
		COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon"));
		if( (int)this_player()->query("kee") < 0 
		|| !present(this_player(), environment())) {
			say("孽ぱ猌羘弧笵獽琌Τ硂砛\ぃ┤趁ル....\n");
			return 1;
		}
		say("\n孽ぱ猌弧笵材┷ㄓ....\n\n");
		COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon"));
		if( (int)this_player()->query("kee") < 0 
		|| !present(this_player(), environment())) {
			say("孽ぱ猌鼓笵堡螟笵ρひō猌\澈礚肚....\n");
			return 1;
		}
		say("\n孽ぱ猌弧笵さらρひ沧砎眔硑ぇ\n\n");
		command("recruit " + this_player()->query("id") );
		return 1;
	}
	return 0;
}

