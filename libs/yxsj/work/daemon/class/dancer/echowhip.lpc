// echowhip.c

#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
	set_name( HIM "臸聾健膎" NOR, ({ "echo whip", "whip" }) );
	set_weight(17000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "兵");
		set("value", 10000);
		set("material", "leather");
		set("rigidity", 70);
		set("wield_msg", "$N眖竬丁秆兵$n搐もい\n");
		set("unwield_msg", "$N盢もい$n鸟竬丁\n");
	}
	init_whip(53);
	setup();
}
