// invocation.c

inherit SSERVER;

int cast(object me, object target)
{
	object soldier;

	if( !me->is_fighting() )
		return notify_fail("Τ驹矮い酬ぱ盢\n");
	
	if( (int)me->query("mana") < 100 )
		return notify_fail("猭ぃ镑\n");

	if( (int)me->query("sen") < 60 )
		return notify_fail("弘礚猭栋い\n");

	message_vision("$N充充├碭〨粂\n", me);

	me->add("mana", -100);
	me->receive_damage("sen", 60);

	if( random(me->query("max_mana")) < 200 ) {
		message("vision", "琌ぐ或⊿Τ祇ネ\n", environment(me));
		return 1;
	}

	seteuid(getuid());
	if( random(1) )
		soldier = new("/obj/npc/heaven_soldier");
	else
		soldier = new("/obj/npc/hell_guard");

	soldier->move(environment(me));
	soldier->invocation(me);

	return 1;
}
