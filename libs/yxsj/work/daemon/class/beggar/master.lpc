// master.c

inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
	set_name("嘲眔癩", ({ "beggarhead", "beggar" }) );

	set("nickname", "堵ヱ惦");
	set("gender", "╧┦");
	set("age", 52);
	set("long",
		"嘲眔癩琌待ō偶ぜぜρあ捌礚弘ゴ璶ぃ妓琌\n"
		"猌狶い常醚眔ōゴ帝挡ブ皊舗硂ぃ琌档穦\n"
		"纒繷獺琌马簔玭堵ヱ惦縒竟ぃ筁嘲眔癩\n"
		"︽萝皋盞沮弧矪繦常Τ蠢ō矪笆┮\n"
		"螟絋﹚泊玡硂嘲眔癩┏琌ぃ琌痷\n" );
	set("attitude", "peaceful");

	set("str", 30);
	set("int", 24);
	set("cor", 30);
	set("cps", 30);

	set("force", 1800);
	set("max_force", 1800);
	set("force_factor", 20);

	set("combat_exp", 1000000);
	set("score", 200000);
	set("env/wimpy", 50);
	
	set("chat_chance", 30);
	set("chat_msg", ({
		(: random_move :)
	}) );
/*
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: consider :),
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :)
	}) );
*/
	set_skill("unarmed", 80);
	set_skill("staff", 90);
	set_skill("blade", 70);
	set_skill("throwing", 60);
	set_skill("force", 100);
	set_skill("parry", 60);
	set_skill("dodge", 100);
	set_skill("perception", 80);
	set_skill("stealing", 40);

	set_skill("spicyclaw", 100);
	set_skill("serpentforce", 100);

	map_skill("unarmed", "spicyclaw");
	map_skill("force", "serpentforce");

	create_family("档穦", 4, "纒繷");

	setup();
}


void attempt_apprentice(object me)
{
	command("look " + me->query("id"));
	if( me->can_afford(100) ) {
		command("say и档穦Μて" + RANK_D->query_respect(me)
			+ "眤临琌ㄉ褐\n");
		return;
	} else {
		command("nod");
		command("recruit " + me->query("id"));
	}
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "beggar");
}


