// blackthorn.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("ト默糃", ({ "blackthorn sword", "blackthorn", "sword" }) );
	set_weight(15000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long",
			"硂琌р硄砰翶堵糃ネ骸綰筥琌踌潮琱產\n"
			"菌肚腳糃沮弧硂р糃炳ぃ猤﹀ッ环玂炳\n");
		set("value", 2400);
		set("material", "blacksteel");
		set("wield_msg", "钮ǎ腂羘$Nもい竒р碒甮腳糃$n\n");
		set("unequip_msg", "$N盢もい$n础竬丁糃繲\n");
	}
	init_sword(58);
	setup();
}
