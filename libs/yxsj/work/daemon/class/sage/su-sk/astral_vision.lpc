// astral_vision.c

#include <ansi.h>

inherit SSERVER;

int exert(object me) {
  int skill;

  if (me->query_temp("apply/astral_vision"))
    return notify_fail("你已經施展過" + HIC + "慧眼穿雲" + NOR + "了。\n");

  if ((int)me->query("force") < 30)
    return notify_fail("你的內力不夠。\n");

  skill = me->query_skill("force");

  me->add("force", -30);
  me->receive_damage("sen", 5);

  message_vision(
    "$N微一凝神﹐閉上眼睛運起心法﹐施展「" HIC "慧眼穿雲" NOR "」！\n" NOR, me);

  me->add_temp("apply/astral_vision", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me) {
  me->add_temp("apply/astral_vision", -1);
  tell_object(me, HIC + "慧眼穿雲" + NOR + "失效了。\n");
}
