// bulletes.c

#include <ansi.h>

inherit SSERVER;

int exert(object me)
{
	int targetnum, i, dp, fp, pp, choice, damage, add, lv;
	object target, *ob, tempobj;
	string t, temp;
	mapping skl;

	if( !me->is_fighting() )
		return notify_fail(HIR""HIY"ト"HIC""HIY"\"HIR""NOR"驹矮いㄏノ\n");
	if( me->query_temp("perform_delay") )
		return notify_fail(HIR"饼ㄏ"HIY"ト"HIC""HIY"\"HIR"琌谋眔ぃ眖み礚猭矗癬痷\n"NOR);

	skl = me->query_skills();
	lv = skl["force"];
	if ( lv < 60 ) return notify_fail("ず\み猭单ぃ镑蔼ぃㄏノ"HIR""HIY"ト"HIC""HIY"\"HIR""NOR"\n");
	lv = skl["bullets"];
	if ( lv < 60 ) return notify_fail("ト\单ぃ镑蔼ぃㄏノ"HIR""HIY"ト"HIC""HIY"\"HIR""NOR"\n");
	if ( me->query("force") < 300 ) return notify_fail("ずぃ镑ぃㄏノ"HIR""HIY"ト"HIC""HIY"\"HIR""NOR"\n");

	message_vision(
HIM"\n$N┛礛ミ﹚ぃ笆ォМだ猭笲癬ōず玪竒いだ瑈锣"NOR"
"HIY"ō痷籈も$N耻羘羇臘いㄏ"HIR""HIC"ト\"HIR""HIY""NOR"
"HIG"ǎ$Nい蛮も硈揣よ祇κ笵玪\n\n"NOR
, me );

	ob = all_inventory(environment(me));
	for(i=0; i<sizeof(ob); i++) {
		if( me->is_fighting(ob[i]) ) targetnum++; }

	for(i=0; i<sizeof(ob); i++)
	{
	if ( !me->is_fighting(ob[i]) ) continue;
	target = ob[i];
	t = ob[i]->query("name");
	fp = target->query_skill("force") / 2 - 35;
	if (fp > 100) fp = 100;
	dp = target->query_skill("dodge") / 2 - 35;
	if (dp > 100) dp = 100;
	pp = target->query_skill("parry") / 2 - 35;
	if (pp > 100) pp = 100;
	if (random(fp) > 50) choice = 3;
	else choice = 4;
	if (random(dp) > 50) choice = 2;
	if (random(pp) > 50) choice = 1;
	add = (me->query_skill("force")*0.6-33);
	if (add > 100) add = 100;

	message_vision(
HIC"いΤ"+CHINESE_D->chinese_number((int)(3000/targetnum))+
"笵玪绰帝"+t+"忌獴硉\n"NOR
	, this_player() );
	if (choice == 1) {
damage = 3000/targetnum/10+random(3000/targetnum*0.15)+(pp-50)*2*3000/targetnum/10/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		tempobj = target->query_temp("weapon");
		if (tempobj) temp = tempobj->query("name");
		else temp = "蛮も";
		target->receive_damage("kee", damage, me);
		if (damage > 0) message_vision(
HIG+t+"ǎ玪ㄓ非よ︗喘癬"+temp+HIG+"笲锣钡场だю阑"NOR"
"HIR"ごΤㄇ玪ゴい"+t+"硑Θㄇ砛\端甡"NOR" ( "+HIR+damage+NOR+" )\n"
		, me ); }

	if (choice == 2) {
damage = 3000/targetnum/20+random(3000/targetnum*0.3)-(dp-50)*2*3000/targetnum*0.15/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		skl = me->query_skill_map();
		temp = to_chinese(skl["dodge"]);
		if (temp == "フ浆猌\") temp = "癵萝˙";
		if (!temp) temp = to_chinese("dodge");
		target->receive_damage("kee", damage, me);
		message_vision(
HIC+t+"ǎ玪霖︓ō锣ㄏ"+temp+"ㄤい濒皗磷"NOR"
"HIR"ごΤㄇ玪ゴい"+t+"硑Θㄇ砛\端甡"NOR" ( "+HIR+damage+NOR+" )\n"
	, me ); }

	if (choice == 3) {
damage = 3000/targetnum/2.5+random(3000/targetnum*0.4)-(fp-50)*2*3000/targetnum/5/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		target->receive_damage("kee", damage, me);
		target->receive_wound("kee", damage/5, me);
		message_vision(
HIM+t+"ǎ薄猵ぃМ礚猭磷秨眔笲癬ōず祑咀"NOR"
"HIR"玪阑い"+t+""+t+"磂计羘珃羘翧﹀"NOR" ( "+HIR+damage+NOR+" )\n"
		, me ); }

	if (choice == 4) {
damage = 3000/targetnum*3/4+random(3000/targetnum/4);
		damage = (damage*add)/100;
		if (damage < 0) damage = random(200);
		target->receive_damage("kee", damage, me);
		target->receive_wound("kee", damage/2, me);
		message_vision(
HIY+t+"ǎ佩ア︹稱磷秨筐˙玪荷计阑い"+t+NOR"
"HIR+t+"硈羘篏ō砆玪ゴブ秨ψ红"NOR" ( "+HIR+damage+NOR+" )\n"NOR
		, me ); }
	COMBAT_D->report_status(target);
	message_vision("\n", me);
	}
	me->set("force", me->query("force") - 300);
	me->set_temp("perform_delay", 1);
	me->start_busy(3);
	call_out("receive_perform", 10);
	return 1;
}

void receive_perform()
{
	write(HIC"谋眔ず惮ㄏノ"HIR""HIY"ト"HIC""HIY"\"HIR""HIC"\n"NOR);
	this_player()->set_temp("perform_delay", 0);
}
