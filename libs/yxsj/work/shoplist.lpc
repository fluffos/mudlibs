mapping sells=([]);
mapping names=([]);
mapping short=([]);
mapping v=([]);
mapping tradename=([]);
inherit ROOM;

int do_list_some(string str)
{
 object ob,obj;
 string k;
 int i,u;
 write(" "+query("short")+"┮Τ "+str+" 凝:\n");
 for(i=0;i<sizeof(tradename);i++)
 {
  if(str==tradename[i] || /* tradename[i] 碞单и璶т str */
     strsrch(tradename[i],str) /* tradename[i] いΤи璶т str */
    )
  {
   k=keys(sells)[i]; // 弄材 i  sells  keys.
   printf("%-50s     基:%8d猅簧狾\n",sells[k],v[k]);
  }
 }
 return 1;
}
