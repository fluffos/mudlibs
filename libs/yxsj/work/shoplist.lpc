mapping sells = ([]);
mapping names = ([]);
mapping short = ([]);
mapping v = ([]);
mapping tradename = ([]);
inherit ROOM;

int do_list_some(string str) {
  object ob, obj;
  string k;
  int i, u;
  write(" " + query("short") + "所有的 " + str + " 一覽:\n");
  for (i = 0; i < sizeof(tradename); i++) {
    if (str == tradename[i] || /* tradename[i] 就等於我們要找的 str */
      strsrch(tradename[i], str) /* tradename[i] 中有我們要找的 str */
    ) {
      k = keys(sells)[i];  // 讀取第 i 個 sells 的 keys.
      printf("%-50s     價值:%8d枚銅板\n", sells[k], v[k]);
    }
  }
  return 1;
}
