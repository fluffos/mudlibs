// liquid.c

#include <dbase.h>
#include <name.h>

void init()
{
	add_action("do_drink", "drink");
	add_action("do_fill", "fill");
}

string extra_long()
{
	int amount, max;
	string str;

	if( amount = query("liquid/remaining") ) {
		max = query("max_liquid");
		if( amount == max )
			str = "柑杆骸" + query("liquid/name") + "\n";
		else if( amount > max/2 )
			str = "柑杆だ骸" + query("liquid/name") + "\n";
		else if( amount >= max/3 )
			str = "柑杆きせだ骸" + query("liquid/name") + "\n";
		else if( amount > max/2 )
			str = "柑杆ぶ砛\" + query("liquid/name") + "\n";
		return str;
	}
	else return 0;
}

int do_drink(string arg)
{
	if( !this_object()->id(arg) ) return 0;
	if( this_player()->is_busy() )
		return notify_fail("笆临⊿ΤЧΘ\n");
	if( !query("liquid/remaining") )
		return notify_fail( name() + (query("liquid/name") ? "竒砆耻眔簑ぃ逞":"琌\n"));
	if( (int)this_player()->query("water") >= (int)this_player()->max_water_capacity() )
		return notify_fail("竒耻び拈ぃ簑\n");

	add("liquid/remaining", -1);
	message_vision("$N癬" + name() + "〣翽翽耻碭" + query("liquid/name")
		+ "\n", this_player());
	this_player()->add("water", 30);
	if( this_player()->is_fighting() ) this_player()->start_busy(2);
	if( !query("liquid/remaining") )
		write("竒盢" + name() + "柑" + query("liquid/name")
			+ "耻眔簑ぃ逞\n");

	// This allows customization of drinking effect.
	if( query("liquid/drink_func") ) return 1;

	switch(query("liquid/type")) {
		case "alcohol":
			this_player()->apply_condition("drunk",
				(int)this_player()->query_condition("drunk") 
				+ (int)query("liquid/drunk_apply"));
			break;
	}
	
	return 1;
}

int do_fill(string arg)
{
	if( !this_object()->id(arg) ) return 0;
	if( this_player()->is_busy() )
		return notify_fail("笆临⊿ΤЧΘ\n");
	if( !environment(this_player())->query("resource/water") )
		return notify_fail("硂柑⊿Τよ杆\n");

	if( query("liquid/remaining") )
		message_vision("$N盢" + name() + "柑逞" + query("liquid/name") + "奔\n", this_player());
	message_vision("$N盢" + name() + "杆骸睲\n", this_player());

	if( this_player()->is_fighting() ) this_player()->start_busy(2);

	set("liquid/type", "water");
	set("liquid/name", "睲");
	set("liquid/remaining", query("max_liquid"));
	set("liquid/drink_func", 0);

	return 1;
}
