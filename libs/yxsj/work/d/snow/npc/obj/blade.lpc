// blade.c

#include <weapon.h>

inherit BLADE;

void create()
{
	set_name("虫", ({ "blade" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "琡");
		set("value", 500);
		set("material", "iron");
		set("long", "硂琌碝盽虫秖せょ\n");
		set("wield_msg", "$N┾р$n搐もい\n");
		set("unequip_msg", "$N盢もい$n础竬丁繲\n");
	}
	init_blade(25);
	setup();
}
