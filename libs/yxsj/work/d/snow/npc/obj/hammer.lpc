// hammer.c

#include <weapon.h>

inherit HAMMER;

void create()
{
	set_name("臟埋", ({ "hammer" }) );
	set_weight(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", "硂琌р℉臟埋ゴ硑讽绊龟\n");
		set("value", 3);
		set("material", "iron");
		set("wield_msg", "$Nр$n刚刚秖礛搐もい\n");
		set("unwield_msg", "$Nもい$n\n");
	}

	init_hammer(15);
	setup();
}
