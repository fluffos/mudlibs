// oneline.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create() {
  set_name("一線生", ({ "oneline man", "oneline", "man", "one", "line" }));
  set("nickname", HIG "隱" HIY "避" HIR "紅塵" NOR);
  set("title", HIC "琉璃仙境" NOR);
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("long",
    "他便是武林上人稱清香白蓮的素還真，智慧高深而富計謀。\n"
    "他是中原武林的領導者，正道的棟樑，這數十年來一直始終如一。\n"
    "聽說他在三歲時便已出道，驚動武林，歸隱兩百年後又再復出。\n"
    "其實，他也有另外一面，如做事常為自己的利益著想。\n"
    "他做事從不與人硬碰硬，總是以高超的計謀解決事情。\n"
    "武林中有傳言說他的若干好友都是被他所犧牲，不知他個性到底如何。\n"
  );

  set("combat_exp", 20000);
  set("score", 100);
  set("rank_info/respect", "道友");

  set("chat_chance", 5);
  set("chat_msg", ({
    "素還真說：請問找劣者有甚麼事嗎？\n",
    "素還真凝立不動，似乎正在思考著事情。\n",
  }));

  set("force", 500);
  set("max_force", 500);
  set("force_factor", 20);

  set("inquiry", ([
    "幫忙": "劣者恐怕無法為力。",
    "歡喜佛": (: command("emote 深深的嘆了一口氣。"), command("say 可憐的歡喜佛，可憐呀～～～") :),
    "歧路人": (: command("emote 深深的嘆了一口氣。"),
    command("say 英雄末劫，黃土埋骨。"),
    command("say 羅網乾坤，靈塔葬魂。"),
    command("say 歧路人，素某對不起你啊～～～") :),
    "素續緣": "續緣吾兒，為父好想和你長久相處啊！",
    "一線生": "他是我的好友，為我做了許\多事，也善機關巧計。",
    "石腦": "它便在琉璃仙境的一個洞穴裡，你可以去看看。",
    "風采鈴": "想當年風采鈴為江南第一才女，唉...素某虧欠她太多了。",
  ]));

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: command("help!") :),
  }));

  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set_skill("move", 50);

  setup();

  carry_object("/d/pili/glass/obj/blkrobe")->wear();
  carry_object("/d/pili/glass/obj/lotushat")->wear();
  carry_object("/d/pili/glass/obj/whisk")->wear();
  carry_object("/d/pili/glass/obj/purplesw");
  carry_object("/d/pili/glass/obj/bulletsb");

  add_money("gold", 1);
}

int accept_fight(object me) {
  command("say 哎哎哎，你就饒了我這把老骨頭吧。");
  return 0;
}
