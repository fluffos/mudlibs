// blksuit.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(WHT "深色長袍" NOR, ({ "black suit", "black", "suit" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是素續緣穿的一件長袍，聞起來有一股清香的藥味，想必是平時行醫所穿的。\n");
    set("unit", "件");
    set("value", 10000);
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 20);
    set("armor_prop/force", 15);
    set("armor_prop/spells", 15);
    set("armor_prop/magic", 15);
  }
}
