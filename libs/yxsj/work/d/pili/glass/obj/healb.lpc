// bulletsb.c

inherit ITEM;

void create() {
  set_name("神農醫譜", ({ "heal book", "book", "heal" }));
  set_weight(500);
  set("unit", "本");
  set("long", "這是一本由素還真所寫，之後送給素續緣的醫書。\n"
    "其書之中包含了各種不同的醫術，是醫學界的寶典。\n");

  set("value", 100000);
  set("skill", ([
    "name": "cure",  // name of the skill
    "exp_required": 50000,   // minimum combat experience required
    // to learn this skill.
    "sen_cost": 40,    // sen cost every time study this
    "difficulty": 30,    // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 150    // the maximum level you can learn
    // from this object.
  ]));
}
