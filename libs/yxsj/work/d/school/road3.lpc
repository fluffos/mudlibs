// Room: /d/school/road3.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "隔");
	set("long", @LONG
タǐ兵毙厩加玭娩隔隔娩贺ㄇ攫れ硂兵隔琌
パ︹︽縥鏓Θǐ硂柑留毙厩加ǐ碮ㄆ娩
臟逆琌ňゎ珇奔の毙蹦ノ┕狥ǐ琌獴巨
初┕﹁ǐ琌巨初临玭娩Τ兵胺眃˙笵Τㄇ夹粂
(sign)刚帝ǐǐ(walk)
LONG
	);
	set("item_desc", ([ /* sizeof() == 2 */
  "sign" : " 
"HIR"	胺眃
	叫叉綾"NOR"
"
]));

	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/clearstu" : 1,
]));
	set("outdoors", "1");
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"pground3",
  "east" : __DIR__"road4",
]));

	setup();
}

void init()
{
	add_action("do_walk", "walk");
}

int do_walk()
{
	object me;
	me = this_player();
	if ( me->query_temp("armor/boots") )
		return notify_fail("胺眃叫叉綾\n");
	if ( me->query("kee") < 11 )
		return notify_fail("稰竲┏礹龟琌ǐぃ\n");
	me->improve_skill("dodge", 10);
	me->receive_damage("kee", 10);
	message_vision("$N叉綾骸肸硁ホ胺眃˙笵ǐ癬隔ㄓ\n", me);
	return 1;
}