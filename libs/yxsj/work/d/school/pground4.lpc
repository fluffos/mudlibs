// Room: /d/school/pground4.c
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "操場");
  set("long", @LONG
這裡是逸俠中學的操場，地面完全用PU舖設，整齊順眼。操場上有一圈
200公尺的跑道，及一些籃球架和排球架。在圍牆邊有種樹，還有一些雙槓。
這裡往東是教學大樓，往北有一條小路。你可以在這裡舉(lift)雙槓
(horizontal bars)，以增加武術。
LONG
  );
  set("outdoors", "1");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "road1",
    "east": __DIR__ "teach1",
    "west": __DIR__ "pground5",
    "south": __DIR__ "pground3",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/clearstu": 1,
  ]));
  setup();
}
void init() {
  add_action("do_lift", "lift");
}

int do_lift(string arg)

{
  object me;
  me = this_player();
  if (!arg || (arg != "horizontal bars" && arg != "bars" && arg != "bar"))
    return notify_fail("你要舉什麼﹖\n");
  if (me->query("combat_exp") > 10000) return notify_fail("你的武術值夠高了﹐已經無法從舉雙槓提昇能力。\n");
  if (me->query("combat_exp") < 100) return notify_fail("你的武術值不夠高﹐沒辦法舉雙槓。\n");
  if (me->query("kee") < 15) return notify_fail("你已經累了﹐休息一下再舉吧。\n");
  message_vision("$N在雙槓上努力的作運動。\n", me);
  me->receive_damage("kee", 15);
  me->add("combat_exp", 1);
  return 1;
}
