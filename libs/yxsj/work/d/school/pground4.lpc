// Room: /d/school/pground4.c
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "巨初");
	set("long", @LONG
硂柑琌秇獿い厩巨初ЧノPU鏓砞俱霍抖泊巨初Τ伴
200そへ禲笵のㄇ膞瞴琜㎝逼瞴琜瞅鲤娩Τ贺攫临Τㄇ蛮篵
硂柑┕狥琌毙厩加┕Τ兵隔硂柑羭(lift)蛮篵
(horizontal bars)糤猌砃
LONG
	);
	set("outdoors", "1");
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"road1",
  "east" : __DIR__"teach1",
  "west" : __DIR__"pground5",
  "south" : __DIR__"pground3",
]));
	set("objects", ([ /* sizeof() == 1 */
  	__DIR__"npc/clearstu" : 1,
]));
	setup();
}
void init()
{
        add_action("do_lift","lift");
}

int do_lift(string arg)

{
        object me;
        me=this_player();
        if (!arg || (arg!="horizontal bars" && arg!="bars" && arg!="bar"))
		return notify_fail("璶羭ぐ或\n");
        if (me->query("combat_exp")>10000) return
                notify_fail("猌砃镑蔼竒礚猭眖羭蛮篵矗狜\n");
        if (me->query("combat_exp")<100) return
                notify_fail("猌砃ぃ镑蔼⊿快猭羭蛮篵\n");
        if (me->query("kee")<15) return
                notify_fail("竒仓ヰ羭\n");
        message_vision("$N蛮篵笲笆\n",me);
        me->receive_damage("kee",15);
        me->add("combat_exp",1);
        return 1;
}