// C4.c

#include <weapon.h>

inherit EXPLOSIVE;

void create()
{
	set_name("C4蔼脄媚", ({ "C4 high explosive charge", "C4", "c4", "charge", "HE" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "ㄇ");
		set("base_unit", "");
		set("base_weight", 5000);
		set("base_value", 2000);
		set("value", 2000);
		set("long", 
"C4媚琌贺砰縩蔼脄媚眏\n"
"疭贺场钉盽ノウㄓ磅︽弘非瘆胊ヴ叭\n"
);
	}
	set("wield_msg", "$N盢$n羭癬搐もい\n");
	set("unwield_msg", "$N盢もい$n\n");
	set("verbs", ({ "collapse" }) );
	set_amount(6);
	setup();
	init_explosive(20);
}