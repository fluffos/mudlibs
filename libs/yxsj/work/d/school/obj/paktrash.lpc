// paktrash.c

inherit ITEM;

#include <ansi.h>

void create()
{
	set_name("竕"WHT"︰В砋"NOR, ({ "packed trash bag", "packed", "bag", "trash" }) );
	set_weight(7200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "");
		set("long", "硂琌杆骸︰В堵︹鹅溅︰В砋砋竒竕候\n");
		set("value", 100);
		set("packed_trash", 1);
		set("no_drop", 1);
		set("no_sac", 1);
	}
}
int query_autoload() { return 1; }