// nuke.c

#include <weapon.h>
#include <ansi.h>

inherit MISSILE;


void create()
{
	set_name(HIR"紆"NOR, ({ "nuclear missile","nuclear","missile","nuke" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
"パが玂靡篟反の踞み瓣悔林阶猌竟驹初莱ノ
硋亥祡ぶウご琌程Τ猌竟
硂猅紆拟盿帝窾痉"HIR"紆繷"NOR"癸ヴ︙ヘ夹硑ΘЧ瘆胊
璶钡ま脄紆繷块(explode)
");
		set("unit", "ㄇ");
		set("base_unit", "猅");
		set("base_weight", 100000);
		set("base_value", 1000000);
		set("value", 1000000);
	}
	set_amount(1);
	init_missile(1000000);
	setup();
}

void init()
{
	add_action("do_explode", "explode");
}

int do_explode()
{

	int i, damage;
	object *ob;

	message_vision(
	HIR "$Nま脄猅紆耻羘: " NOR, this_player());
	message_vision(
	HIY "  磕  脄!!\n" NOR, this_player());
	message_vision(
	RED "                -----------                           :  \n" NOR, this_player());
	message_vision(
	RED "          --------        -------                     :  \n" NOR, this_player());
	message_vision(
	RED "        ---                 --------                  : \n" NOR, this_player());
	message_vision(
	HIY "          ---            ------             ° °° °° °   \n" NOR, this_player());
	message_vision(
	HIY "            ------------------- \n" NOR, this_player());
	message_vision(
	RED "                                      °° °                      : \n" NOR, this_player());
	message_vision(
	RED "                  :                                                : \n" NOR, this_player());
	message_vision(
	RED "                  :                               ---------------  : \n" NOR, this_player());
	message_vision(
	HIR "                  :                          -------          ------- \n" NOR, this_player());
	message_vision(
	HIY "                   ° °° °° °        ---                 ---------- \n" NOR, this_player());
	message_vision(
	HIR "         :                             --------                 -- \n" NOR, this_player());
	message_vision(
	RED "         :                                 ---               ---------  \n" NOR, this_player());
	message_vision(
	HIR "         :                                   ------------------- \n" NOR, this_player());
	message_vision(
	RED "        -----------   \n" NOR, this_player());
	message_vision(
	HIR "   --------        -------    \n" NOR, this_player());
	message_vision(
	RED "---                 --------        :             \n" NOR, this_player());
	message_vision(
	HIY "  ---              ------           : ° °° °° °  \n" NOR, this_player());
	message_vision(
	RED "    -------------------             :       \n" NOR, this_player());
	message_vision(
	HIR "                                    : \n" NOR, this_player());

		
	damage = (((int)this_player()->query("throwing") * 10) + 100000);
	ob = all_inventory(environment(this_player()));
	for(i=0; i<sizeof(ob); i++) {
		if( !living(ob[i]) ) continue;
		damage = (damage - ((int)ob[i]->query("dodge") * 10));
		if( damage > 0 ) {
			ob[i]->receive_damage("kee", damage);
			ob[i]->receive_wound("kee", damage/2);
			tell_object(ob[i], "泊玡┛礛瞷笵フ,縉奔┮Τㄆ!!\n");
		}
		
		if( userp(ob[i]) ) ob[i]->fight_ob(this_player());
		else if( !ob[i]->is_killing(this_player()) ) ob[i]->kill_ob(this_player());
	}
	add_amount(-1);
	return 1;
}