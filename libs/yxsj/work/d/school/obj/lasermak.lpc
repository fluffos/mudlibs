// lasermak.c

#include <ansi.h>
#include <weapon.h>

inherit ITEM;

void create()
{
	set_name(HIR"筽甮"NOR"夹﹚竟", ({ "laser marker","laser","marker","LASER" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
"硂琌パ玡狠甮筽甮玛﹚ヘ夹夹﹚竟疭驹场钉盽ノウㄓ\n"
"蠢紆┪紆夹﹚ヘ夹笷Ч非絋ヘ\n"
"硂夹﹚竟钡硈钡瞴矫琍﹚︗╰参旧矫琍祇甮瞒\n"
"俐丁═てヘ夹璶夹﹚ヘ夹块(Target ヘ夹)\n"
);
		set("unit", "р");
		set("value", 10000);
		set_weight(5000);
	}
	setup();
}

void init()
{
	add_action("do_target", "target");
}

int do_target(string arg)
{
	object ob;
	string name2;

	if (!arg) return notify_fail("Α: target ネ\n");
	ob = present(arg, environment(this_player()));
	if (!ob) return notify_fail("тぃ硂ネ.\n");
	name2 = (string)ob->query("name");
	write("筽甮夹﹚竟秨闽甮笵灿"HIR"絬筽甮"NOR"核非"+name2+"\n");
	message_vision((string)this_player()->query("name")+"羭癬も"HIR"筽甮"NOR"夹﹚竟癸非"+name2+"\n", this_player());
	this_player()->start_busy(20);
	call_out("countdown", 1, 30, arg, ob);
	return 1;
}

private void countdown(int sec, string arg, object ob)
{
	object mark_ob;
	string name2;
	sec = sec - 5;
	if (sec > 0) {
		write("夹﹚竟陪ボ"HIC"矫琍"NOR""+sec+"碞﹚︗\n");
		if (sec == 5) message_vision("稰いΤ翴钵笆㏄瞅砰钩秨﹍玻ネ繰筿\n", this_player());
		call_out("countdown", 5, sec, arg, ob);
	} else {
	mark_ob = present(arg, environment(this_player()));
	if (ob != mark_ob) {
	write("夹﹚竟陪ボ"HIC"矫琍"NOR"アヘ夹\n\n");
	message_vision(
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
" \n\n"
	, this_player());
	message_vision(
HIY+"ぱ摆ぱ┛礛甮笵"HIW"フ︹"HIY"蔼瞒阑いō娩ぃ环ぇ矪\n"+NOR+
HIR+"硂笵蔼瞒钡牟玻ネ霖脄盢计へ糴瑌\n"+NOR
	, this_player());
	destruct(this_object());
	} else {
	name2 = (string)ob->query("name");
	write("夹﹚竟陪ボ"HIC"矫琍"NOR"竒碞狐"HIR"タ祇甮猌竟\n\n"NOR);
	message_vision(
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
"			"HIY""NOR"			\n"
" \n\n"
	, this_player());
	message_vision(
HIY"ぱ摆ぱ┛礛甮笵"HIW"フ︹"HIY"蔼瞒ぃ熬ぃ酚"+name2+"ō\n"+NOR
HIR+"ǎ"+name2+"篏羘蔼瞒窱"+name2+"ō砰玻ネ粿疨は莱\n"+NOR
NOR+name2+"ō常脄"HIR"刮刮瞴"NOR"ど伐蔼放ì═て妮\n"
HIY"弧筐êе碞タ佩钵硂辊礛玻ネ皚脄獹ㄏ窩ぃ秨泊\n"+NOR
"单筁ㄓ"+name2+"ア礚紇礚萝逞瑌临玙帝羂\羂\フ废\n"
	, this_player());

	ob->receive_damage("kee", 4000);
	ob->receive_wound("kee", 2000);
	destruct(ob);
	destruct(this_object());
		}
	}
}