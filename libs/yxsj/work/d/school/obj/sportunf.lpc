// sportunf.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("體育服", ({ "sport uniform", "uniform", "sport", "uni" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件上體育課時所穿的衣服，白色T-shirt，綠色長褲
看起來是高一的學長穿的。\n");
    set("unit", "件");
    set("value", 200);
    set("material", "cloth");
    set("armor_prop/dodge", 4);
    set("armor_prop/armor", 2);
  }
  setup();
}
