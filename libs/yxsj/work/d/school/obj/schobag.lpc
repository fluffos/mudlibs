// schobag.c

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(GRN "書包" NOR, ({ "schoolbag", "bag" }));
  set_weight(500);
  set_max_encumbrance(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "個");
    set("long", "這是學校的書包，外面繡有" BGRN + HIY "逸俠中學" NOR "四個大字。\n");
    set("value", 200);
    set("container", 1);
  }
}

int query_autoload() { return 1; }
