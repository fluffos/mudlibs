// schobag.c

inherit ITEM;

#include <ansi.h>

void create()
{
	set_name(GRN""NOR, ({ "schoolbag","bag" }) );
	set_weight(500);
	set_max_encumbrance(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "");
		set("long", "硂琌厩赂Τ"BGRN + HIY"秇獿い厩"NOR"\n");
		set("value", 200);
		set("container", 1);
	}
}

int query_autoload() { return 1; }