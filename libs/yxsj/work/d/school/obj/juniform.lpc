// juniform.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("國中制服", ({ "junior uniform", "uniform", "uni" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件國中部的制服，米色襯衫，黑色短褲。\n");
    set("unit", "件");
    set("value", 100);
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
int query_autoload() { return 1; }
