// C4.c

#include <weapon.h>

inherit WARHEAD;

void create() {
  set_name("200磅高爆彈頭", ({ "200 pound HE warhead", "200", "HE", "warhead" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "些");
    set("base_unit", "個");
    set("base_weight", 15000);
    set("base_value", 100000);
    set("value", 100000);
    set("long", "一個200磅的高爆彈頭。\n");
  }
  set("wield_msg", "$N將$n舉起，握在手中。\n");
  set("unwield_msg", "$N將手中的$n放下。\n");
  set_amount(1);
  setup();
  init_warhead(50);
}
