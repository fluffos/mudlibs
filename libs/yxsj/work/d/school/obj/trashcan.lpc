// trashcan.c

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name("︰В表", ({ "trash can", "trash", "can" }) );
	set("weight", 2000);
	set("long", "硂琌炊硄鹅溅︰В表р︰Вメ柑\n"
"腊︰В表传︰В砋(change)睲埃柑︰В\n");
	set_max_encumbrance(7000);
	set("value", 100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "");
	}
	set("container", 1);
	set("no_get", 1);
	set("no_sac", 1);
	setup();
}

void init()
{
	add_action("do_change", "change");
}

void change_bag(object ob)
{
	object *inv;
	int i;
	message_vision("$Nр︰В表柑"NOR+WHT"︰В砋"NOR"ㄓ传穝"NOR+WHT"︰В砋"NOR"\n", this_player());
	inv = all_inventory(this_object());
	for(i=0; i<sizeof(inv); i++) {
		inv[i]->move(ob);
	}
}

int do_change(string arg)
{
	object ob, me;
	me = this_player();
	if( me->is_busy())
		return notify_fail("瞷⊿\n");
        if(!arg) return notify_fail("璶ノぐ或狥﹁ㄓ传︰В砋\n");
        ob=present(arg,environment(me));
        if(!ob) ob=present(arg,me);
        if(!ob) return notify_fail("硂よ㎝ō⊿Τ硂兜珇\n");
	if( ob->query("trashbag") ) {
		change_bag(ob);
		return 1;
	}
	else {
		return notify_fail("硂狥﹁ぃ琌︰В砋\n");
		return 1;
	}
}