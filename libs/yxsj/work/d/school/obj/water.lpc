// water.c

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create()
{
	set_name(HIC"膓瑄"NOR, ({ "water" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "炊硄膓瑄瞺甧秖500cc琌砰▅揭Ч厩ネ程稲\n");
		set("unit", "瞺");
		set("value", 20);
		set("max_liquid", 7);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "water",
		"name": "",
		"remaining": 7,
	]) );
}
