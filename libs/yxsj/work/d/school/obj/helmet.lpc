//helmet.c 

#include <armor.h> 

inherit HEAD; 

void create() 
{ 
	set_name("葵帛", ({ "helmet","hel" }) ); 
	set_weight(1000); 
	set("long", "硂琌郴厩ネ盺┪紋┮盿葵帛癬ㄓぃ\n"); 
	set("value",200);
	set("unit", "郴"); 
	set("material", "steel"); 
	set("armor_prop/head", 10);
	set("armor_type","head");
	setup(); 
}
 