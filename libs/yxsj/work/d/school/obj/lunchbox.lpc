// lunchbox.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("便當", ({ "lunch box", "lunch", "box" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一個飯盒公司所做的便當，看起來真是便宜又又好吃。\n");
    set("unit", "個");
    set("value", 50);
    set("food_remaining", 10);
    set("food_supply", 100);
  }
}
