// schobelt.c 

#include <armor.h>
#include <ansi.h>

inherit WAIST;

void create() {
  set_name("制服" WHT "皮帶" NOR, ({ "school belt", "belt" }));
  set_weight(500);
  set("long", "這是一條學校的制服" WHT "皮帶" NOR "，" WHT "皮帶" NOR "扣上有一個逸俠中學的校徽，看起來很普通。\n");
  set("value", 100);
  set("unit", "條");
  set("armor_type", "waist");
  set("material", "leather");
  set("armor_prop/armor", 1);
  set("armor_prop/defense", 1);
  setup();
}
int query_autoload() { return 1; }
