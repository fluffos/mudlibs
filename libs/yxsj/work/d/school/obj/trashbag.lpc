// trashbag.c

inherit ITEM;

#include <ansi.h>

void create() {
  set_name(WHT "垃圾袋" NOR, ({ "trash bag", "bag", "trash" }));
  set_weight(200);
  set_max_encumbrance(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "個");
    set("long", "這是一個黑色的塑膠垃圾袋，用來放在垃圾桶裡裝垃圾。\n"
      "你可以在裝垃圾後將帶口綁緊(pack)。\n"
    );
    set("value", 50);
    set("container", 1);
    set("trashbag", 1);
  }
}

void init() {
  add_action("do_pack", "pack");
}

int do_pack() {
  object ob;
  ob = new("/d/school/obj/paktrash");
  message_vision("$N把裝滿垃圾的" NOR + WHT "垃圾袋" NOR "帶口綁緊，提在手上。\n", this_player());
  ob->move(this_player());
  destruct(this_object());
  return 1;
}
