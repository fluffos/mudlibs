// armyunif.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
	set_name(HIG"嘲瓁狝"NOR, ({ "army uniform","uniform","uni" }) );
	set_weight(2500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン厚︹嘲瓁狝籋临赂帝ㄢ宾\n");
		set("unit", "ン");
		set("value", 500);
		set("material", "cloth");
		set("armor_prop/armor", 8);
	}
	setup();
}