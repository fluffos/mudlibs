#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("厩砊", ({ "science suit", "science", "suit" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "ン");
		set("material", "cloth");
		set("armor_prop/armor", 2);
	}
	setup();
}
