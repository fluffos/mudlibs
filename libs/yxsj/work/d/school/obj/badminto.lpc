// badminto.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("πを瞴", ({ "badminton","ball" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","聋砰▅揭┮ノπを瞴\n");
		set("unit", "ㄇ");
		set("base_unit", "聋");
		set("base_weight", 500);
		set("base_value", 10);
	}
	set_amount(1);
	init_throwing(2);
	setup();
}
