// bread.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("麵包", ({ "bread" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一個塑膠包裝，剛從店裡送來的麵包。\n");
    set("unit", "個");
    set("value", 10);
    set("food_remaining", 5);
    set("food_supply", 60);
  }
}
