// lightswo.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(HIY "光劍" NOR, ({ "light sword", "sword", "light" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "這是一把絕地武士用的" HIY "光劍" NOR "，使用高能量來打擊敵人，威力強大。\n");
    set("value", 10000);
  }
  init_sword(50);

  set("wield_msg", "$N按下開關「嗡」地一聲啟動了$n，產生了耀眼的" HIY "光束" NOR "。\n");
  set("unwield_msg", "$N將手中的$n關閉，" YEL "光芒" NOR "漸漸的收了回去。\n");

  setup();
}
int query_autoload() { return 1; }
