// lightswo.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
	set_name(HIY"糃"NOR, ({ "light sword", "sword", "light" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", "硂琌р荡猌ノ"HIY"糃"NOR"ㄏノ蔼秖ㄓゴ阑寄眏\n");
		set("value", 10000);
	}
	init_sword(50);

	set("wield_msg", "$N秨闽朵羘币笆$n玻ネ模泊"HIY""NOR"\n");
	set("unwield_msg", "$N盢もい$n闽超"YEL"▇"NOR"亥亥Μ\n");

	setup();
}
int query_autoload() { return 1; }