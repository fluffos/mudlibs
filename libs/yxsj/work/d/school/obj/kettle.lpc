// kettle.c

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create() {
  set_name(HIC "水壺" NOR, ({ "kettle" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一個裝水的水壺，容量750cc，看起來很堅固耐用。\n");
    set("unit", "個");
    set("value", 200);
    set("max_liquid", 10);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "水",
    "remaining": 0,
  ]));
}
int query_autoload() { return 1; }
