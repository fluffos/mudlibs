// kettle.c

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create()
{
	set_name(HIC"除"NOR, ({ "kettle" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "杆除甧秖750cc癬ㄓ绊㏕瑻ノ\n");
		set("unit", "");
		set("value", 200);
		set("max_liquid", 10);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "water",
		"name": "",
		"remaining": 0,
	]) );
}
int query_autoload() { return 1; }