// tstpaper.c

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name(HIR + HBWHT "考卷" NOR, ({ "test paper", "test", "paper", }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一疊測驗學生學習程度的考卷，似乎不甚容易。\n");
    set("unit", "疊");
    set("base_unit", "張");
    set("base_weight", 10);
    set("base_value", 10);
    set("value", 200);
  }
  set_amount(50);
  init_throwing(500);
  setup();
}
