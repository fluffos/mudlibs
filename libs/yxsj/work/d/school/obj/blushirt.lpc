// blushirt.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
	set_name(HIB"屡︹浓璵"NOR, ({ "blue T-shirt","blue","T-shirt","shirt" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン睱屡︹兵浓璵癬ㄓ瑻\n");
		set("unit", "ン");
		set("value", 1000);
		set("armor_type", "cloth");
		set("material", "cloth");
		set("armor_prop/armor", 10);
	}
	setup();
}