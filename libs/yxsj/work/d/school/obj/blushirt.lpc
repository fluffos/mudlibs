// blushirt.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIB "藍色襯衫" NOR, ({ "blue T-shirt", "blue", "T-shirt", "shirt" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件淺藍色條紋的襯衫，看起來很耐穿。\n");
    set("unit", "件");
    set("value", 1000);
    set("armor_type", "cloth");
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
