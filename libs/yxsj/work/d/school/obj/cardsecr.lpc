// card.c

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIY"盞ID"NOR, ({ "Secret ID Card", "ID", "card", "secret", "ID card" }) );
	set("weight", 100);
	set("long", "硂琌眎ノㄓ侩醚ōIDㄓ单蔼ウ虑パ疭杆竚砆弄\n");
	set("value", 500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "眎");
	}
	set("place", "office3");
	setup();
}
int query_autoload() { return 1; }