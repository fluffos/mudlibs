// card.c

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "秘密ID卡" NOR, ({ "Secret ID Card", "ID", "card", "secret", "ID card" }));
  set("weight", 100);
  set("long", "這是一張用來辨識身份的ID卡，看來等級很高，它可以藉由特殊裝置被讀取。\n");
  set("value", 500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "張");
  }
  set("place", "office3");
  setup();
}
int query_autoload() { return 1; }
