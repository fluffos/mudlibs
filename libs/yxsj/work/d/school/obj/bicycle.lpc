// bicycle.c

inherit ITEM;

void create()
{
	set_name("竲今ó", ({ "bicycle", "bike" }) );
	set("weight", 2000);
	set("long", "硂琌进炊硄竲今óㄓ绊㏕瑻ノ刚帝肕(ride)ウ\n");
	set("value", 3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "进");
	}
	set("ridable", 1);
	set("no_get", 1);
	set("prop/dodge", 5);
	set("prop/move", 10);
	set("skill_limit", 10);
	setup();
}