// SM-2.c

#include <weapon.h>

inherit MISSILE;

void create()
{
	set_name("夹非紆", ({ "Standard Missile-2","SM-2","standard","missile","SM" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
"夹非ň紆琌瓣ヘ玡程眏ň猌竟\n"
"穎皌╰参篶Θ驹磨礚獻デň臔呼\n");
		set("unit", "ㄇ");
		set("base_unit", "猅");
		set("base_weight", 300);
		set("base_value", 100000);
		set("value", 10000000);
		set("wield_msg", "$N盢$n恶祇甮╰参暗祇甮非称\n");
		set("unwield_msg", "$N盢$n︑祇甮╰参い更\n");
	}
	set_amount(122);
	init_missile(1000);
	setup();
}
int query_autoload() { return 1; }
