// SM-2.c

#include <weapon.h>

inherit MISSILE;

void create() {
  set_name("標準二型飛彈", ({ "Standard Missile-2", "SM-2", "standard", "missile", "SM" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "標準二型防空飛彈是美國目前最強的防空武器，\n"
      "搭配神盾系統，構成戰艦無可侵犯的防護網。\n");
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 300);
    set("base_value", 100000);
    set("value", 10000000);
    set("wield_msg", "$N將$n填入垂直發射系統，做好發射的準備。\n");
    set("unwield_msg", "$N將$n自垂直發射系統中卸載取出。\n");
  }
  set_amount(122);
  init_missile(1000);
  setup();
}
int query_autoload() { return 1; }
