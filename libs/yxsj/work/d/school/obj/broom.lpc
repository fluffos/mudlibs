// broom.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create() {
  set_name(YEL "掃把" NOR, ({ "broom" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "隻");
    set("long", "一隻普通的掃把。\n");
    set("material", "wood");
  }
  init_staff(5);

  setup();
}
