// broom.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name( YEL"苯р"NOR, ({ "broom" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "唉");
		set("long", "唉炊硄苯р\n");
		set("material", "wood");
	}
	init_staff(5);

	setup();
}
