// baktball.c

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name(HIR "籃球" NOR, ({ "basketball", "ball" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一顆體育課時所用的籃球。\n");
    set("unit", "些");
    set("base_unit", "顆");
    set("base_weight", 5000);
    set("base_value", 200);
  }
  set_amount(1);
  init_throwing(50);
  setup();
}
