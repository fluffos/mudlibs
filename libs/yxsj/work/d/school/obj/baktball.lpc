// baktball.c

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
	set_name(HIR"膞瞴"NOR, ({ "basketball","ball" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","聋砰▅揭┮ノ膞瞴\n");
		set("unit", "ㄇ");
		set("base_unit", "聋");
		set("base_weight", 5000);
		set("base_value", 200);
	}
	set_amount(1);
	init_throwing(50);
	setup();
}
