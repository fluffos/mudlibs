// bread.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("逗刮", ({ "rice" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "帝璦柑琌逗逗刮\n");
		set("unit", "");
		set("value", 20);
		set("food_remaining", 5);
		set("food_supply", 60);
	}
}
