// sticks.c

#include <weapon.h>

inherit STICK;

void create()
{
	set_name("竉", ({ "sticks", "stick" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "蛮");
		set("long", "蛮炊硄λ竉\n");
		set("material", "bamboo");
	}
	setup();
	init_stick(10);
}