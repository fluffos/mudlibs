// sticks.c

#include <weapon.h>

inherit STICK;

void create() {
  set_name("筷子", ({ "sticks", "stick" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "雙");
    set("long", "一雙普通的竹筷子。\n");
    set("material", "bamboo");
  }
  setup();
  init_stick(10);
}
