// TLAM.c

#include <weapon.h>

inherit MISSILE;

void create()
{
	set_name("驹ю紆", ({ "Tomahawk Land Attack Missile","TLAM","tomahawk","missile","SLCM","land","attack" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
"驹ю紆琌程Τゴ阑猌竟\n"
"ウㄢΩ猧芖驹いだ揣ウ疭ㄏ幅瓁搭ぶ砛\端\n"
"ウ猽帝华蔼︽跟磷筽笷盎代\n"
"禫计κそń非絋阑いヘ夹粇畉ぃ禬筁10そへ\n");
		set("unit", "ㄇ");
		set("base_unit", "猅");
		set("base_weight", 2000);
		set("base_value", 500000);
		set("value", 5000000);
		set("wield_msg", "$N盢$n恶祇甮╰参暗祇甮非称\n");
		set("unwield_msg", "$N盢$n︑祇甮╰参い更\n");
	}
	set_amount(10);
	init_missile(50000);
	setup();
}
int query_autoload() { return 1; }
