// blkcoat.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
	set_name(WHT"堵︹甅"NOR, ({ "black jacket", "black", "jacket" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン堵︹甅借稰ぃ岿谋眔ウΤ艶\n");
		set("unit", "ン");
		set("value", 5000);
		set("material", "cloth");
		set("armor_type", "cloth");
		set("armor_prop/armor", 15);
		set("armor_prop/spells", 10);
	}
}