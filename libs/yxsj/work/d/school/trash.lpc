// Room: /d/school/trash.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "垃圾場");
  set("long", @LONG
這裡是逸俠中學的垃圾場，每天的中午和放學時，學生都會把垃圾拿到
這裡來丟。你走到這裡，也不覺得有什麼臭味。學校嚴格要求學生，要把垃
圾袋袋口綁好才能丟進垃圾場。你看到垃圾場的壁上有一些字(words)，你
可以在這裡把垃圾袋丟(throw)進垃圾場。
LONG
  );
  set("outdoors", "1");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "sidedoor",
    "north": __DIR__ "smground",
  ]));
  set("item_desc", ([
    "words": "
	" HIG "<-" HIR "可燃" NOR "｜" HIC "不可燃" HIG "->" NOR "

" ]));
  setup();
}

void init() {
  add_action("do_throw", "throw");
}

int do_throw(string arg) {
  object ob, me;
  me = this_player();
  if (me->is_busy())
    return notify_fail("你現在沒空﹗\n");
  if (!arg) return notify_fail("你要要將什麼東西丟進垃圾場？\n");
  ob = present(arg, environment(me));
  if (!ob) ob = present(arg, me);
  if (!ob) return notify_fail("這個地方和你的身上並沒有這項物品。\n");
  if (ob->query("trashbag")) {
    write("垃圾袋要裝垃圾，帶口要紮緊才能丟進垃圾場。\n");
    return 1;
  }
  if (ob->query("packed_trash")) {
    message_vision("$N爬上數階階梯，手臂一揮一甩，將" + ob->query("name") + "丟進垃圾場裡。\n", me);
    destruct(ob);
    return 1;
  }
  if (ob->query("trashbag")) {
    write("垃圾袋要裝垃圾，帶口要紮緊才能丟進垃圾場。\n");
    return 1;
  } else {
    return notify_fail("這個東西不能丟進垃圾場！\n");
  }

}
