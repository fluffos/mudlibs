// Room: /d/school/pground2.c

inherit ROOM;

void create()
{
	set("short", "巨初");
	set("long", @LONG
硂柑琌秇獿い厩巨初ЧノPU鏓砞俱霍抖泊巨初Τ伴
200そへ禲笵のㄇ膞瞴琜㎝逼瞴琜瞅鲤娩Τ贺攫临Τㄇ蛮篵
巨初禲笵薄ぃ︑窽稱禲碭伴(run)硂柑玭娩獽琌
筿加狥娩玥琌┕毙厩加
LONG
	);
	set("outdoors", "1");
	set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"pground3",
  "west" : __DIR__"pground1",
  "north" : __DIR__"pground5",
  "south" : __DIR__"sbuild",
]));
	set("no_clean_up", 0);
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/estudent" : 1,
]));

	setup();
}

void init()
{
	add_action("do_run", "run");
}

int do_run()
{
	object me;
	me = this_player();
	if ( me->query("kee") < 11 )
		return notify_fail("砰ぃや\n");
	me->improve_skill("move", 10);
	me->receive_damage("kee", 10);
	message_vision("$N今禲笵秨﹍露帝巨初篊禲\n", me);
	return 1;
}