// Room: /d/school/office3.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "快そ");
	set("long", @LONG
硂琌丁ぐ或⊿Τ┬丁
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"office4",
  "out" : __DIR__"teach2",
  "north" : __DIR__"office2",
]));
	set("no_clean_up", 0);
	set("objects", ([ /* sizeof() == 3 */
	  __DIR__"npc/techwu" : 1,
	  __DIR__"obj/lunchbox" : 1,
]));
	setup();
}
void init()
{
	add_action("do_input", "input");
}

void open_passage()
{
	object room;

	set("exits/west", "/d/school/secret");
	message_vision("筿福玛秆埃玛﹚,秨币穞\n",this_player());
	call_out("close_passage", 10);
	
}

void close_passage()
{
	object room;
	message_vision("筿福玛縊腹锣" HIR "︹" NOR ",穞闽\n",this_player());
	delete("exits/west");
}


int do_input(string arg)
{
	object ob, me;
	me = this_player();
	if( me->is_busy())
		return notify_fail("瞷⊿\n");
        if(!arg) return notify_fail("璶ノぐ或狥﹁琵筿福玛浪琩\n");
        ob=present(arg,environment(me));
        if(!ob) ob=present(arg,me);
        if(!ob) return notify_fail("硂よ㎝ō⊿Τ硂兜珇\n");
	if( ob->query("place") == "office3" ) {
		message_vision("$N盢"+ob->query("name")+"筁筿福玛\n", me);
		message_vision("筿福玛┛礛雇羘,縊腹锣" HIG "厚︹" NOR "\n", me);
		open_passage();
		return 1;
	}
	else {
		message_vision("$N刚帝"+ob->query("name")+"琵筿福玛浪琩琌⊿Τヴ︙は莱\n", me);
		return 1;
	}

}


void reset()
{
	::reset();
}
