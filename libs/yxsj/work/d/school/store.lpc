// Room: /d/school/store.c

#include <ansi.h>

inherit STORE;

void create() {
  set("short", HIY "福利社" NOR);
  set("long", @LONG
這裡是逸俠中學的福利社，也是下課時學校裡最熱鬧的地方。現在你充
分的體會到了這種感覺，只見一大堆學生擁擠的想要填飽他們的肚子，你擠
在他們之中，正在努力的拿到想要的商品。要知道有甚麼可以買請打(list)
，要買商品請打(buy)。
LONG
  );
  set("no_magic", "1");
  set("no_clean_up", 0);
  //	set("no_fight", "1");
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "lab",
  ]));
  set("list", @list

             福利社販售的物品及價格列表如下:

               便當(lunch box)        50 元
               包子(dumpling)         15 元
               飯團(rice)             20 元
               麵包(bread)            10 元
               飲料(drink)            15 元
               礦泉水(water)          20 元
               手電筒(flashlight)    200 元
               電池(battery)         100 元
               課本(textbook)        200 元
               書包(schoolbag)       200 元
               制服皮帶(school belt) 100 元
list
  );

  set("dumpling", "/d/school/obj/dumpling");
  set("school belt", "/d/school/obj/schobelt");
  set("belt", "/d/school/obj/schobelt");
  set("schoolbag", "/d/school/obj/schobag");
  set("water", "/d/school/obj/water");
  set("bag", "/d/school/obj/schobag");
  set("drink", "/d/school/obj/drink");
  set("lunch box", "/d/school/obj/lunchbox");
  set("rice", "/d/school/obj/rice");
  set("bread", "/d/school/obj/bread");
  set("textbook", "/d/school/obj/book");
  set("book", "/d/school/obj/book");
  set("flashlight", "/obj/flashlight");
  set("battery", "/obj/battery");
  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/storboss": 1,
    __DIR__ "npc/buystu": 3,
  ]));

  setup();

}
