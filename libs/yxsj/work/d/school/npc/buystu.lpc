// buystu.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("買東西的學生", ({ "buying student", "buying", "student", "stu" }));
  set("chat_chance", 10);
  set("chat_msg", ({
    "學生說：老闆，一個雞腿便當！\n",
    "學生說：這些東西你幫我拿一下，我先回教室。\n",
    "學生問：可不可以先借我一百塊？\n",
    "學生說：借過一下。\n",
    "學生說：喂，等我一下！\n",

  }));
  set("long",
    "他是一個正在福利社裡買東西的學生。\n");
  set_temp("apply/damage", 10);
  set_temp("apply/armor", 1);
  set("age", 14);
  set("combat_exp", 200);
  setup();
  carry_object("/d/school/obj/juniform")->wear();
  carry_object("/d/school/obj/schobelt")->wear();
  carry_object("/d/school/obj/schoshoe")->wear();
  add_money("coin", 300);
}
