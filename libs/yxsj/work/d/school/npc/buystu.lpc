// buystu.c

#include <ansi.h>
#include <login.h>

inherit NPC;
	
void create()
{
	set_name("禦狥﹁厩ネ", ({ "buying student", "buying","student","stu" }) );
        set("chat_chance", 10);
	set("chat_msg", ({
	    "厩ネ弧ρ馏蔓籐獽讽\n",
            "厩ネ弧硂ㄇ狥﹁腊ии毙\n",
	    "厩ネ拜ぃиκ遏\n",
            "厩ネ弧筁\n",
            "厩ネ弧侈单и\n",

	}));
	set("long",
		"琌タ褐柑禦狥﹁厩ネ\n");
	set_temp("apply/damage", 10);
	set_temp("apply/armor", 1);       
	set("age",14);
      	set("combat_exp",200);
	setup();
	carry_object("/d/school/obj/juniform")->wear();
	carry_object("/d/school/obj/schobelt")->wear();
	carry_object("/d/school/obj/schoshoe")->wear();
        add_money("coin",300);
}


