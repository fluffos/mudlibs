// beast.c
#include <ansi.h>

inherit NPC;

void create() {
  set_name("北極熊", ({ "polar bear", "polar", "bear" }));
  set("nickname", HIR "可" HIW "口" HIR "可" HIW "樂" NOR);
  set("chat_chance", 50);
  set("chat_msg", ({

    "北極熊看著你說：嘿！老兄，你是從哪裡來的啊？\n",
    "北極熊說：你可以陪我玩捉迷藏嗎？\n",
    "北極熊說：好無聊喔！  說著用舌頭舔了舔你。\n",
    "北極熊唱著：一隻小鳥在樹上...\n",
    "北極熊說：嘿！老兄，來瓶可口可樂吧。\n",

  }));
  set("race", "野獸");
  set("age", 3);
  set("long", "一隻北極特產的熊，牠看起來孔武有力。\n");
  set("combat_exp", 3500);

  set("str", 99);
  set("cor", 99);

  set("limbs", ({ "頭部", "身體", "前腳", "後腳", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 100);
  set_temp("apply/armor", 300);
  setup();

}

void init() {
  add_action("do_kill", "kill");
}

int do_kill(string str) {
  if (str == "polar") {
    command("say 嘿！老兄來瓶可口可樂吧。");
    return 1;
  }
  if (str == "bear") {
    command("say 小子，找死啊！！");
    return 1;
  }
}
