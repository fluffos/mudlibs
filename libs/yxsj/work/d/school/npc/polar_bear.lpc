// beast.c
#include <ansi.h>

inherit NPC;

void create()
{
	set_name("伐旱", ({ "polar bear","polar","bear"}) );
	set("nickname", HIR""HIW""HIR""HIW"贾"NOR);
        set("chat_chance", 50);
	set("chat_msg", ({

	    "伐旱帝弧糑ρ琌眖柑ㄓ摆\n",
	    "伐旱弧抄и癵旅盾\n",
            "伐旱弧礚册翅  弧帝ノ︕繷籕籕\n",
            "伐旱佰帝唉尘攫...\n",
	    "伐旱弧糑ρㄓ瞺贾\n",
	
         }));
	set("race", "偿脋");
	set("age", 3);
	set("long", "唉伐疭玻旱╡癬ㄓふ猌Τ\n");
	set("combat_exp", 3500);

	set("str", 99);
	set("cor", 99);

	set("limbs", ({ "繷场", "ō砰", "玡竲", "竲", "Юぺ" }) );
	set("verbs", ({ "bite", "claw" }) );
	
	set_temp("apply/attack", 100);
	set_temp("apply/armor", 300);
	setup();
	
}

void init()
{
	add_action("do_kill", "kill");
}

int do_kill(string str)
{
	if(str=="polar") {
		command("say 糑ρㄓ瞺贾");
		return 1; }
	if( str=="bear") {
		command("say т摆");
		return 1; }
}

