// operator.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create()
{
	set_name("巨", ({ "operator"}) );
	set("title", HIC"厩產"NOR);
	set("gender", "╧┦" );
	set("age", 40);
	set("long",
		"琌厩╯诀篶秇獿い厩м砃\n"
		"璽砫巨硂柑狡馒肚癳獽厩ㄏノ\n"
		"ō厩產Τ帝略稸み篈繦絋玂杆竚タ盽笲\n");

	set("chat_chance", 5);
	set("chat_msg", ({
	    "巨タ杆竚筿福诀块戈\n",
	    "巨タ籈弘穦秸俱祸竟ㄇ秨闽\n",
	    "巨癬唉掸㎝秨﹍硋琩癸祸竟计\n",
	    "巨弧笵Τ借璶肚癳盾\n",
	}));

	set("inquiry", ([
		"start" : (: call_out("do_start", 0) :),
	]) );

	setup();
	carry_object("/d/school/obj/scisuit")->wear();
	
}

int accept_object(object me, object obj)
{
	if( !(me->query_temp("trans_pos")) ) {
		command("say 叫匡拒翴");
		return 0; }
	if( obj->value() != 1000 ) {
		command("say 狝叭禣肂琌1000じ");
		return 0; }
	if ( !(this_player()->query_temp("hanger")) ) {
		command("say 叫肚癳康絋粄");
		return 0; }
	me->set_temp("trans_pay", 1);
	command("say 币笆肚癳狝叭");
	return 1;
}

int do_start()
{
	object transroom;
	if( !(this_player()->query_temp("trans_pos")) ) {
		command("say 叫匡拒翴");
		return 0; }
	if ( !(this_player()->query_temp("trans_pay")) ) {
		command("say 叫狝叭禣");
		return 0; }
	if ( !(this_player()->query_temp("hanger")) ) {
		command("say 叫肚癳康絋粄");
		return 0; }
	if ( !(environment(this_player())->query_door("hanger", "status")) ) {
		command("say 叫闽肚癳康");
		return 0; }
	transroom = this_player()->query_temp("hanger");
	transroom->do_prepare(transroom);
	tell_room(environment(this_object()), "巨祸竟碭秙筿福棵辊块ㄇ戈\n");
	tell_room(transroom, "谋眔ㄆ薄钩ぃび癸玪㏄瞅肚癳╰参钩竒秨﹍\n");
	command("say 肚癳杆竚竒币笆盢肚癳");
	call_out("do_move", 30);
	return 1;
}

int do_move()
{
	object transroom;
	transroom = this_player()->query_temp("hanger");
	transroom->do_move(transroom);
	tell_room(transroom, HIY"ぱ摆ǎ㏄瞷笵笵皗钡帝皚エ臫碞ア谋\n"NOR);
	tell_room(transroom, HIC"磡磡泊眶筁ㄓ临琌谋眔繷福等┣硂柑琌ぐ或よ\n"NOR);
	tell_room(environment(this_object()), HIY"钮羘エ臫肚癳康祇皚皗ち耴キ繰\n"NOR);
	all_inventory(this_player()->query_temp("hanger"))->move(this_player()->query_temp("trans_pos"));
	command("say 肚癳ЧΘ");
	this_player()->delete_temp("hanger");
	this_player()->delete_temp("trans_pos");
	this_player()->delete_temp("trans_pay");
	return 1;
}