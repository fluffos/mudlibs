// guardstu.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("站崗學生", ({ "guard student", "guard", "student", "stu", "gua" }));
  set("chat_chance", 15);
  set("chat_msg", ({
    "站崗學生說：敬禮！\n",
    "站崗學生向進校門的老師敬禮。\n",
    "站崗學生說：老師好！\n",
    "站崗學生說：禮畢！\n",
  }));
  set("attitude", "heroism");
  set("long",
    "他們是自願在校門口站崗的高中學生，\n"
    "大多數學生都視此為一項光榮。\n");
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 3);
  set("age", 17);
  set("combat_exp", 1000);
  setup();
  carry_object("/d/school/obj/suniform")->wear();
  carry_object("/d/school/obj/helmet")->wear();
  carry_object("/d/school/obj/schobelt")->wear();
  carry_object("/d/school/obj/schoshoe")->wear();
  add_money("coin", 100);
}
