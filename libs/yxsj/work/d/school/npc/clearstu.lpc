// clearstu.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("清掃學生", ({ "clear student", "clear", "student", "stu" }));
  set("chat_chance", 20);
  set("chat_msg", ({
    (: random_move :),
    (: command, "get corpse" :),
    (: command, "get all" :),
    "清掃學生正在努力的掃地。\n",
  }));
  set("long",
    "他是一個正在做外掃工作的學生，正在努力的清掃地面。\n");
  set_temp("apply/damage", 15);
  set_temp("apply/armor", 1);
  set("age", 16);
  set("combat_exp", 600);
  setup();
  carry_object("/d/school/obj/suniform")->wear();
  carry_object("/d/school/obj/schobelt")->wear();
  carry_object("/d/school/obj/schoshoe")->wear();
  carry_object("/d/school/obj/broom")->wield();
  carry_object("/d/school/obj/schobag");
  carry_object("/d/school/obj/trashbag");
  add_money("coin", 100);
}
