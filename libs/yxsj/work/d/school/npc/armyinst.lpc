// armyinst.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create()
{
	set_name("毙﹛", ({ "army instructor", "army", "instructor", "ins", "inst" }) );
	set("title", HIG"嘲瓁"NOR);
	set("nickname", HIY"い"NOR);
	set("gender", "╧┦" );
	set("class", "soldier");
	set("age", 40);
	set("force", 1000);
	set("max_force", 1000);
	set("force_factor", 50);
	set("chat_chance", 5);
	set("attitude", "heroism");
	set("long",
		"琌秇獿い厩嘲瓁毙﹛タ帝秈ㄓ厩ネ\n"
		"㎝ㄤ毙﹛妓羪Τ腨德薄\n");

	set("chat_msg", ({
	    "嘲瓁毙﹛弧ê︗厩氨ㄓр︾狝\n",
	    "嘲瓁毙﹛弧ê︗厩或ぃ么ブ盿㎡\n",
            "嘲瓁毙﹛弧硂︗厩Τ或ㄆ盾\n",
            "嘲瓁毙﹛弧\n",
	    "毙﹛弧毙﹛\n",
	}));

	set("combat_exp", 100000);

	set_skill("unarmed", 40);
	set_skill("parry", 50);
	set_skill("dodge", 40);
	set_skill("force", 50);

	set("inquiry", ([
		"狝祸浪琩" : "搂琌狝祸浪琩癘眔芭繷緑",
		"秇獿い厩" : "硂琌ぱ尝秇獿┮承快い厩辨├",
	]) );

	setup();
	carry_object("/d/school/obj/armyunif")->wear();
        add_money("thousand-cash", 2);
	
}
