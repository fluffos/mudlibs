// estudent.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("學生", ({ "electronic student", "electronic", "student", "stu" }));
  set("title", "電子科");
  set("chat_chance", 7);
  set("chat_msg", ({
    "學生說：不知這次月考考的怎麼樣。\n",
    "學生問：今天有甚麼作業？\n",
    "學生問：下節課上甚麼？\n",
    "學生問：這題好難，應該怎麼解？\n",
    "學生說：呼！終於把作業做完了。\n",

  }));
  set("long",
    "他是一個逸俠中學電子科的學生。\n");
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 3);
  set("age", 17);
  set("combat_exp", 700);
  setup();
  carry_object("/d/school/obj/euniform")->wear();
  carry_object("/d/school/obj/schobelt")->wear();
  carry_object("/d/school/obj/schoshoe")->wear();
  add_money("coin", 250);
}
