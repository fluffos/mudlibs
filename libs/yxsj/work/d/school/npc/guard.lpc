// armyinst.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("守衛", ({ "guard" }));
  set("title", HIC "逸俠中學" NOR);
  set("gender", "男性");
  set("age", 55);
  set("max_force", 100);
  set("force", 100);
  set("force_factor", 10);
  set("long",
    "他是逸俠中學的守衛，負責學校的安全。\n"
    "他看起來年紀不小，所以才來做這無聊的工作。\n"
    "不過雖然如此，他還是盡心盡力,努力的做好自己份內的工作。\n");

  set("combat_exp", 100000);

  set_skill("unarmed", 40);
  set_skill("parry", 50);
  set_skill("dodge", 40);
  set_skill("force", 50);

  set("inquiry", ([
    "寄放": (: call_out("say_words", 0) :),
  ]));

  setup();
  carry_object("/d/school/obj/cloth")->wear();

}

int say_words() {
  message_vision("\n", this_player());
  command("say 你要寄放東西？好吧！但是要繳管理費100元。");
  command("say 這些是寄放的指令：");
  message_vision("\n", this_player());
  command("say list   查看你存放在這裡的物品。");
  command("say saveeq <物品名> 將身上的物品存放在這裡。");
  command("say geteq  <物品名> 將存放在這裡的物品提出。");
  command("say geteq all  將存放在這裡的所有物品提出。\n");
  return 1;
}
