	HIG "瓣厩ネ", NOR
	HIM "瓣厩ネ", NOR
	HIB "瓣厩ネ", NOR
	HIG "蔼厩ネ", NOR
	HIM "蔼厩ネ", NOR
	HIB "蔼厩ネ", NOR
	HIC "拨穨ネ", NOR
	HIY "龟策"HIG"ρ畍", NOR
	HIG "ρ畍", NOR
	HIC "戈瞏"HIG"ρ畍", NOR
	HIM "舱"HIY"舱", NOR
	HIB "砞称舱"HIY"舱", NOR
	HIC "矫ネ舱"HIY"舱", NOR
	HIG "癡旧"HIY"ヴ", NOR
	HIR "毙叭"HIY"ヴ", NOR
	HIG "ね穦"HIC"穦", NOR
	HIR "產穦"HIC"穦", NOR
	HIG "赋ㄆ", NOR
	HIY "捌", NOR
	HIR "赋"HIG"ㄆ"HIM"穦"HIC"穦" NOR
});
	
void create()
{
	set_name(HIY"菏σρ畍"NOR, ({ "test teacher", "test", "teacher", "tech"}) );
	set("title", HIC"秇獿い厩"NOR);
        set("chat_chance", 10);
	set("chat_msg", ({
		"菏σρ畍タ矪ǐ笆\n",
		"菏σρ畍ǐ毙Τ⊿Τ厩国\n",
		"菏σρ畍Г慈ヘ筿苯甮\n",
		"菏σρ畍癬セ癬ㄓ\n",
		"菏σρ畍厩泊\n",
	}) );
	set("long",
		"琌硂丁σ初菏σρ畍璽砫菏服厩σ刚\n"
		"菏服σ初т蝶﹚厩策Θ罿\n"
		"璶叫σ︑祘叫ゴ(testme)\n"
	);
//	set_temp("apply/damage", 50);
//	set_temp("apply/armor", 10);
	set("force", 1500);
	set("max_force", 1500);
	set("force_factor", 75);
	set("age",40);
     	set("combat_exp",1000000);
	setup();
	carry_object("/d/school/obj/chkshirt")->wear();
	carry_object("/d/school/obj/tstpaper")->wield();
        add_money("thousand-cash",5);
}

void init()
{
	add_action("do_testme", "testme");
}

string rank_level(int value)
{
	int grade;
	grade = value * 19 / 150;
	if( grade >= sizeof(title_ranking) )
		grade = sizeof(title_ranking)-1;
	return title_ranking[grade]+NOR;
}

int do_testme()
{
	object ob;
	mapping skl;
	int lv;
	string name;
	ob = this_player();
	name = (string)ob->query("name");
	if( ob->query("family/family_name") != "秇獿い厩" ) {
		command("emote 癸"+name+"弧笵厩硂柑琌秇獿い厩ǐ岿毙蛊");
		return 1; }
	skl = ob->query_skills();
	lv = skl["literate"];
	ob->set("title", HIC+"秇獿い厩-"+NOR+rank_level(lv));
	command("say "+HIG+"璶把σ刚");
	command("emote 祇倒"+name+"眎σ");
	command("emote 琵"+name+"糶Чσ");
	command("emote 盢σΜ");
	command("emote 盢σэЧ");
	command("hmm");
	command("say "+HIG+"и笵祘");
	command("say "+HIG+name+"иど戮︗"+rank_level(lv)+"");
	command("say "+HIG+name+"璶＋");
	command("smile "+ob->query("id"));
	return 1;
}