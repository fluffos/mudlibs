// techwu.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create()
{
	set_name("紈", ({ "Teacher Wu", "Teacher", "teacher", "tech", "minnder", "Wu", "wu" }) );
	set("nickname", HIC+"minnder"+NOR);
	set("title", HIC"秇獿い厩-"HIG"瞶ρ畍"NOR);
	set("gender", "╧┦" );
	set("age", 35);
	set("attitude", "friendly");
	set("class", "teacher");

	set("force", 600);
	set("max_force", 600);
	set("force_factor", 30);

	set("rank_info/respect", "砞称舱");

	set("long",
		"琌秇獿い厩瞶ρ畍の砞称舱蔼璂\n"
		"癬ㄓ捌家妓尺舧狥﹁盽盽獽讽\n"
		"来眔瞶の瓁ㄆ醚尺舧暗家\n"
		"キ盽ρ畍璶ノщ紇诀┪跌钮毙常琌т\n");

	create_family("秇獿い厩", 3 , "瞶ρ畍");

	set("combat_exp", 50000);
	set("score", 150000);
        set("chat_chance", 5);
	set("chat_msg", ({
		(: command, "eat lunch box" :),
            "紈弧厩Τ或ㄆ盾\n",
            "紈弧\n",
	    "弧ρ畍\n",
	}));

	set_skill("unarmed", 30);
	set_skill("parry", 40);
	set_skill("dodge", 60);
	set_skill("force", 30);
	set_skill("literate", 60);
	set_skill("throwing", 50);
	set_skill("stick", 70);
	set_skill("move", 50);

	set_skill("Aegis", 120);

	map_skill("parry", "Aegis");
	map_skill("dodge", "Aegis");
	map_skill("force", "Aegis");

	set("inquiry", ([
		"尝秇獿" : "盽盽ㄓти酵ぱの癚阶琌厩厩ネ",
		"Н＂" : "垛,Τ穦ㄓти拜ㄇ拜肈芞Τ承硑",
		"跌钮毙" : (: call_out("studio_room", 0) :),
		"щ紇诀" : "痷ぃォщ紇诀竒砆ㄤ痁ǐ竊揭ㄓ",
		"换北差" : "иΤ看换北差芞",
	]) );

	setup();
	carry_object("/d/school/obj/sticks")->wield();
	carry_object("/d/school/obj/blushirt")->wear();
	carry_object("/d/school/obj/lunchbox");
	carry_object("/d/school/obj/lunchbox");

        add_money("thousand-cash",3);
}

void attempt_apprentice(object ob)
{
	command("say 璶и厩策?");
	command("smile");
	command("say 摆" + RANK_D->query_respect(ob) + "Τ拜肈鲸恨ㄓти\n");
	command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "student");
}

int studio_room()
{
	object ob;
	if (this_player()->query_temp("got_studio_key") == 1) {
		command("?");
		command("say иぃ琌竒倒芲巴盾");
		return 1; }
	ob = new("/d/school/obj/keystdio");
	command("say 跌钮毙瞷竒俱");
	command("say 穝杆店览龟挂砞称Τ");
	ob->move(this_object());
	this_player()->set_temp("got_studio_key", 1);
	command("give "+this_player()->query("id")+" key");
	command("smile");
}