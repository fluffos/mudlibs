// TASM.c

#include <login.h>

inherit NPC;
	
void create()
{
	set_name("驹は磨紆", ({ "Tomahawk Anti-Ship Missile","TASM","tomahawk","missile","SSM","anti-ship" }) );
        set("chat_chance", 50);
	set("chat_msg", ({
		(: random_move :),
           	"驹は磨紆タ卑帝︽\n",
	}));
	set("long",
"驹は磨紆琌瓣ヘ玡甮祘程环は磨紆\n"
"ウ琌驹紆は磨甮祘伐环眏\n"
"琌差磨ぃ┪猌竟\n");
	set_temp("apply/damage", 1000);
	set_temp("apply/armor", 50);
	set("attitude", "killer");
	set_skill("throwing", 100);
	set_skill("dodge", 30);
	set("age",3);
      	set("combat_exp",300);
	setup();
	carry_object("/d/school/obj/whead200")->wield();
}

void fire(object who)
{
	int i;
	object *enemy;

	message("vision",
		"臚羘" + name(who) + "祇甮猅驹ǖ紆"
		,environment(), this_object() );
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
	}
	set_leader(who);
}