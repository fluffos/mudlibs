// armyinst.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create()
{
	set_name("毙﹛", ({ "navy instructor", "navy", "instructor", "ins", "inst" }) );
	set("title", HIB"瓁"NOR);
	set("nickname", HIY"ぶ"NOR);
	set("gender", "╧┦" );
	set("age", 40);
	set("class", "soldier");
	set("force", 750);
	set("max_force", 750);
	set("force_factor", 40);
	set("attitude", "heroism");
	set("chat_chance", 5);
	set("long",
		"琌秇獿い厩瓁毙﹛タ帝秈ㄓ厩ネ\n"
		"㎝ㄤ毙﹛妓羪Τ腨德薄\n");

	set("chat_msg", ({
	    "瓁毙﹛弧ê︗厩氨ㄓр︾狝\n",
	    "瓁毙﹛弧ê︗厩或ぃ么ブ盿㎡\n",
            "瓁毙﹛弧硂︗厩Τ或ㄆ盾\n",
            "瓁毙﹛弧\n",
	    "毙﹛弧毙﹛\n",
	}));

	set("combat_exp", 50000);

	set_skill("unarmed", 30);
	set_skill("parry", 40);
	set_skill("dodge", 30);
	set_skill("force", 40);

	set("inquiry", ([
		"狝祸浪琩" : "搂琌狝祸浪琩癘眔芭繷緑",
		"秇獿い厩" : "硂琌ぱ尝秇獿┮承快い厩辨├",
	]) );

	setup();
	carry_object("/d/school/obj/navyunif")->wear();
        add_money("thousand-cash",1);
	
}
