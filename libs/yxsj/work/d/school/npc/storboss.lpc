// storboss.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create()
{
	set_name("褐ρ馏", ({ "store boss", "store","boss"}) );
	set("long",
		"琌褐柑ρ馏タ禦狥﹁厩ネΜ窥\n"
		"–ぱ常璶ó厩ネ┮キ盽ぶ弧杠\n"
		"埃揭丁キ盽璶璽砫干砯单\n");
	set("age", 35);
      	set("combat_exp",50000);
	set_skill("unarmed", 40);
	set_skill("parry", 40);
	set_skill("dodge", 30);
	setup();
	carry_object("/d/school/obj/cloth")->wear();
        add_money("gold",1);
}
