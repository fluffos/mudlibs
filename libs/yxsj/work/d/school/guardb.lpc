// Room: /d/school/guardb.c

inherit ROOM;

void create() {
  set("short", "守衛室");
  set("long", @LONG
這是一間什麼也沒有的空房間。
LONG
  );
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/guard2": 1,
  ]));
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "sidedoor",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  object mbox;

  if (mbox = me->query_temp("mbox_ob")) {
    tell_object(me, "你將信箱交回給守衛。\n");
    destruct(mbox);
  }
  return 1;
}
