// mastersu.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create() {
  set_name("素還真", ({ "Master su", "Master", "master", "master su", "su", "Su" }));
  set("nickname", HIC "清香" NOR "白蓮");
  set("title", HIC "琉璃仙境-" HIR "日" HIY "才子" NOR);
  set("gender", "男性");
  set("age", 210);
  set("attitude", "peaceful");
  set("mate", "風采玲");
  set("long",
    "他便是武林上人稱清香白蓮的素還真，智慧高深而富計謀。\n"
    "他是中原武林的領導者，正道的棟樑，這數十年來一直始終如一。\n"
    "聽說他在三歲時便已出道，驚動武林，歸隱兩百年後又再復出。\n"
    "其實，他也有另外一面，如做事常為自己的利益著想。\n"
    "他做事從不與人硬碰硬，總是以高超的計謀解決事情。\n"
    "武林中有傳言說他的若干好友都是被他所犧牲，不知他個性到底如何。\n"
    "他的師父是八指麒麟。\n"
  );

  set("combat_exp", 1000000);
  set("score", 10000000);
  set("rank_info/respect", "素賢人");
  set("class", "sage");
  set("max_kee", 10000);

  set("str", 40);
  set("int", 70);
  set("cor", 30);
  set("cps", 70);
  set("spi", 70);
  set("con", 70);
  set("kar", 40);
  set("per", 50);

  set("chat_chance", 5);
  set("chat_msg", ({
    "素還真說：請問找劣者有甚麼事嗎？\n",
    "素還真凝立不動，似乎正在思考著事情。\n",
  }));

  set("force", 5000);
  set("max_force", 5000);
  set("force_factor", 200);

  set("atman", 5000);
  set("max_atman", 5000);

  set("mana", 5000);
  set("max_mana", 5000);
  set("mana_factor", 400);

  set("inquiry", ([
    "幫忙": "劣者恐怕無法為力。",
    "歡喜佛": (: command("emote 深深的嘆了一口氣。"), command("say 可憐的歡喜佛，可憐呀～～～") :),
    "歧路人": (: command("emote 深深的嘆了一口氣。"),
    command("say 英雄末劫，黃土埋骨。"),
    command("say 羅網乾坤，靈塔葬魂。"),
    command("say 歧路人，素某對不起你啊～～～") :),
    "素續緣": "續緣吾兒，為父好想和你長久相處啊！",
    "一線生": "他是我的好友，為我做了許\多事，也善機關巧計。",
    "石腦": "它便在琉璃仙境的一個洞穴裡，你可以去看看。",
    "風采鈴": "想當年風采鈴為江南第一才女，唉...素某虧欠她太多了。",
  ]));

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: call_out("fight_check", 0) :),
    (: command("exert bullets") :),
    (: command("exert astral_vision") :),
    (: command("exert recover") :),
  }));

  create_family("琉璃仙境", 1, "日才子");

  set_skill("literate", 250);
  set_skill("magic", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("unarmed", 250);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("move", 150);
  set_skill("sword", 200);

  set_skill("su-sk", 250);
  set_skill("su-sword", 150);
  set_skill("buddhism", 150);
  set_skill("taoism", 150);

  map_skill("force", "su-sk");
  map_skill("spells", "su-sk");
  map_skill("magic", "su-sk");
  map_skill("unarmed", "su-sk");
  map_skill("dodge", "su-sk");
  map_skill("parry", "su-sk");
  map_skill("sword", "su-sword");

  setup();

  carry_object("/d/pili/glass/obj/blkrobe")->wear();
  carry_object("/d/pili/glass/obj/lotushat")->wear();
  carry_object("/d/pili/glass/obj/whisk")->wear();
  carry_object("/d/pili/glass/obj/purplesw");
  carry_object("/d/pili/glass/obj/bulletsb");

  add_money("gold", 30);
}

void can_speak_poetry() {
  delete("speaking_poetry");
}

void speak_poetry() {
  if (!query("speaking_poetry")) {
    message_vision("\n", this_object());
    command("say 半神半聖亦半仙，");
    command("say 全儒全道是全賢。");
    command("say 腦中真書藏萬卷，");
    command("say 掌握文武半邊天。");
    set("speaking_poetry", 1);
    call_out("can_speak_poetry", 5);
  }
}

void init() {
  ::init();
  call_out("speak_poetry", 0);
}

int attempt_apprentice(object ob) {
  command("say 不敢當，劣者如何能做" + this_player()->query("name") + "的師父？。");
  return 0;
}

int accept_fight(object me) {
  command("say 劣者如何是" + this_player()->query("name") + "的對手？");
  return 0;
}

int fight_check() {
  int max_kee, kee;
  max_kee = this_object()->query("max_kee");
  kee = this_object()->query("kee");
  if ((kee < max_kee * 0.4) && (this_object()->query_temp("flag") != 1)) {
    message_vision("\n", this_object());
    command("wield sword");
    message_vision("\n", this_object());
    command("shout \n" HIR "日為陽，" HIY "月為陰，" HIR "日" HIY "月" HIC "合璧誅百邪，" HIY "陰" HIR "陽" HIM "調配滅千魔\n");
    this_object()->set_temp("flag", 1);
    return 1;
  }
  return 1;
}

int accept_object(object me, object obj) {
  command("say 感謝" + RANK_D->query_respect(me) + "送我這" + obj->query("unit") + obj->query("name") + "。");
  command("bow " + me->query("id"));
  obj->move(this_object());
  return 1;
}
