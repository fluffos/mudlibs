// patient.c

inherit NPC;

#include <ansi.h>

void create() {
  set_name("病人", ({ "patient" }));
  set("gender", "男性");
  set("age", 20);
  set("long", "他是一個來此求醫的病患，全身滿是傷痕。\n"
    "幸好遇上了素續緣，才得以保住一條性命。\n"
  );

  set("combat_exp", 1000);
  set("score", 1000);
  set("eff_kee", 170);
  set("kee", 170);

  set("chat_chance", 5);
  set("chat_msg", ({
    (: command("emote 努力的忍著疼痛") :),
    (: command("emote 的傷口出了一點血") :),
    (: unconcious() :),

  }));

  setup();

  carry_object("/obj/cloth")->wear();

  add_money("silver", 1);
}
