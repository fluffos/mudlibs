#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "琉璃仙境入口");
  set("long", @LONG
此地就是武林的觀光名勝，一代神人素還真的住所－琉璃仙境。放眼望
去只見一片好山好水，風景清聖優雅，自然天成，不愧被稱為仙境。你現在
就在這一片人間仙境的入口處，心中已迫不即待的想要入內參觀了。門口有
一塊大石碑(stone)，從這還可以看到裡面有一座小橋流水，真是一個不可
多得的好地方。
LONG
  );
  set("outdoors", "1");
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "bridge",
  ]));

  set("item_desc", ([ /* sizeof() == 1 */
    "stone":
    "
            石碑上寫著：

		" HIC "琉

		" HIG "璃

		" HIY "仙

		" HIM "境" NOR "

",
  ]));

  set("no_clean_up", 0);

  setup();
}
