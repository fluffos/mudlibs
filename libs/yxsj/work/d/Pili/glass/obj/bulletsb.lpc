// bulletsb.c

inherit ITEM;

void create()
{
	set_name("ト\覦", ({ "bullets force book", "book", "bullets", "force", "bullets force" }));
	set_weight(600);
	set("unit", "セ");
	set("long",
		"硂琌セパ临痷┮糶ざ残Θ猌\⌒ト\⌒覦\n"
		"眖厩翴Τ闽ト\而\n");
	set("value", 100000);
	set("skill", ([
		"name": 		"bullets",		// name of the skill
		"exp_required":	50000,			// minimum combat experience required
										// to learn this skill.
		"sen_cost":		40,				// sen cost every time study this
		"difficulty":	30,				// the base int to learn this skill
										// modify is gin_cost's (difficulty - int)*5%
		"max_skill":	100				// the maximum level you can learn
										// from this object.
	]) );
}
