// bluehat.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create()
{
	set_name(HIC"屡胡"NOR, ({ "blue hat", "blue", "hat" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌尿絫拦郴胡癬ㄓ倦キ睭玱Τ蔼懂\n");
		set("unit", "郴");
		set("value", 2000);
		set("armor_type", "head");
		set("armor_prop/head", 10);
		set("armor_prop/literate", 10);
		set("armor_prop/cure", 30);
	}
}