// bluehat.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create() {
  set_name(HIC "水藍綸巾" NOR, ({ "blue hat", "blue", "hat" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是素續緣戴的一頂綸巾，看起來樸素平淡，卻有一股高雅的氣息。\n");
    set("unit", "頂");
    set("value", 2000);
    set("armor_type", "head");
    set("armor_prop/head", 10);
    set("armor_prop/literate", 10);
    set("armor_prop/cure", 30);
  }
}
