// purplesw.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
	set_name(HIM"档璱腳糃"NOR, ({ "purple sword", "sword", "purple" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", 
"硂琌р临痷档璱腳糃础璉︹糃甅柑琌エ━さ贺竟ぇ\n"
"パ临痷伐ぶㄓノ筁┮琌良\n"
		);
		set("value", 50000);
		set("material", "steel");
		set("weapon_prop/sword", 50);
	}
	init_sword(120);

	set("wield_msg", "$N眖璉"HIR"︹糃甅"NOR"柑р$n搐もい\n");
	set("unwield_msg", "$N盢もい$n础璉"HIR"︹糃甅"NOR"\n");

	setup();
}
int query_autoload() { return 1; }