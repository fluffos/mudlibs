#include <ansi.h>
inherit ROOM;
void create()
{
        set("short","霉簙绑");
        set("long", @LONG

    硂柑琌艶︱返キ策猌よэ圭繰不㎝猑硂柑癹历
帝缠腨德縫いァΤㄌ沮琍盝┮逼ㄓれ(wood)皚硂ㄇれ癬
ㄓ常绊㏕刚帝篤ゴれ(hit) 

LONG
        );
        set("exits", ([ /* sizeof() == 1 */
        "south" : __DIR__"room5",
]));
        set("no_fight", 1);
        set("no_magic", 1);
        set("no_transmit",1);
        set("light_up", 1);
        set("no_clean_up", 0);

        setup();
}
void init()
{
        add_action("do_hit","hit");
}

int do_hit(string arg)

{
        object me;
        me=this_player();
        if (!arg || arg!="wood") return
                notify_fail("璶ゴぐ或\n");
        if (me->query("combat_exp")>200000) return
                notify_fail("猌砃镑蔼竒礚猭眖阑ゴれ嘉矗狜\n");
        if (me->query("combat_exp")<20000) return
                notify_fail("猌砃ぃ镑蔼礚猭眖阑ゴれ嘉矗狜\n");
        if (me->query("sen")<15) return
                notify_fail("竒仓ヰ絤\n");
        message_vision("$N竲霍琁癸帝れ嘉ō皚ゴ阑\n",me);
        me->receive_damage("sen",15);
        me->add("combat_exp",1);
        return 1;
}