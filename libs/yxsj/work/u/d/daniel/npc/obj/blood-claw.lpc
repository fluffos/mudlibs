#include <weapon.h>
#include <ansi.h>
inherit CLAW;
void create() {
  set_name(HIR "血" NOR + RED "龍" NOR + HIR "爪" NOR, ({
    "blood dragon claw", "claw", "blood", "dragon" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");

    set("long", "一件上面有斑斑深色血跡和龍形花紋，有著神秘力量的爪。\n");
    set("value", 12000);
    set("material", "?");
    set("armor_prop/armor", 30);
    set("weapon_prop/strength", 5);
    set("weapon_prop/courage", 5);
    set("weapon_prop/claw", 5);
    set("no_drop", 1);
    set("no_give", 1);
  }
  init_claw(70);

  set("wear_msg", HIR "$N將$n" HIR "穿在手上，瞬間$N的身邊圍繞著一股無名的氣息。\n" NOR);
  set("unequip_msg", HIR "$N將$n" HIR "脫了下來，無名的氣息慢慢的從$N的身邊散去。\n" NOR);

  setup();
}
