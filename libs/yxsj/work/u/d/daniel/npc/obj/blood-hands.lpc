#include <ansi.h>
#include <armor.h>

inherit HANDS;

void create() {
  set_name(
    HIR "血" NOR + RED "龍指" HIR "環" NOR,
    ({ "blood dragon hands", "dragon", "ring", "hands" })
  );
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只上面有斑斑深色血跡和龍形花紋，有著神秘力量的指環。\n");
    set("armor_prop/heal", 10);
    set("material", "???");
    set("armor_type", "ring");
    set("armor_prop/armor", 3);
    set("armor_prop/parry", 3);
    set("light/brightness", 5);
    set("armor_prop/force", 13);
    set("class", "red-sword");
  }
  set("wear_msg", HIR "$N將$n" HIR "戴上，瞬間$N的身邊圍繞著一股無名的氣息。\n" NOR);
  set("unequip_msg", HIR "$N將$n" HIR "脫了下來，無名的氣息慢慢的從$N的身邊散去。\n" NOR);
  set("no_give", 1);
  set("no_drop", 1);
}
int query_autoload() {
  if (this_player()->query("class") == "red-sword")
    return 1;
  else
    return 0;
}
