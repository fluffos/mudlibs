#include <ansi.h>
#include <armor.h>

inherit WAIST;

void create()
{
        set_name(HIR"﹀"NOR+RED"纒竬"HIR""NOR, ({"blood dragon waist", "dragon", "waist", "blood"}));
        set_weight(200);
        if( clonep() )
        set_default_object(__FILE__);
        else {
        set("long","Τ闯闯瞏︹﹀格㎝纒Τ帝秖竬\n");
        set("unit", "");
        set("material", "?");
        set("armor_prop/armor", 5);
        set("armor_prop/parry", 5);
        set("armor_prop/force", 13);
	  set("class", "red-sword");
        }
        set("wear_msg", HIR"$N盢$n"HIR"瞅竬场俐丁$Nō娩瞅露帝礚\n"NOR);
        set("unequip_msg", HIR"$N盢$n"HIR"叉ㄓ礚篊篊眖$Nō娩床\n"NOR);
	  set("no_drop", 1);
	  set("no_give", 1);
        setup();
}
int query_autoload()
{
	if ( this_player()->query("class") == "red-sword" )
		return 1;
	else
		return 0;
}