#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create()
{
        set_name(HIR"﹀"NOR+RED"纒驹"HIR"ヒ"NOR, ({"blood dragon armor", "dragon", "armor", "blood"}));
        set_weight(3500);
        if(clonep())
        set_default_object(__FILE__);
        else {
        set("long","ンΤ闯闯瞏︹﹀格㎝纒Τ帝秖臔ヒ\n");
        set("unit", "ン");
        set("meterial", "???");
        set("armor_prop/armor", 40);
        set("armor_prop/heal", 10);
        set("armor_prop/parry", 10);
        set("armor_prop/constitution", 5);
        set("armor_prop/force", 13);
	  set("class", "red-sword");
        }
        set("wear_msg", HIR"$N盢$n"HIR"ō俐丁$Nō娩瞅露帝礚\n"NOR);
        set("unequip_msg", HIR"$N盢$n"HIR"叉ㄓ礚篊篊眖$Nō娩床\n"NOR);
	  set("no_drop", 1);
	  set("no_give", 1);
        setup();
}
int query_autoload()
{
	if ( this_player()->query("class") == "red-sword" )
		return 1;
	else
		return 0;
}
