#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name(HIR"﹀"NOR+RED"纒"HIR"箄"NOR, ({"blood dragon shoes", "dragon", "shoes", "blood"}));
        set_weight(600);
        if( clonep() )
        set_default_object(__FILE__);
        else {
        set("long","蛮Τ闯闯瞏︹﹀格㎝纒Τ帝秖箄\n");
        set("unit", "蛮");
        set("value", 10000);
        set("armor_prop/dodge", 20);
        set("armor_prop/move", 10);
        set("armor_prop/armor", 15);
        set("armor_prop/force", 13);
	  set("class", "red-sword");
        }
        set("wear_msg", HIR"$N盢$n"HIR"竲俐丁$Nō娩瞅露帝礚\n"NOR);
        set("unequip_msg", HIR"$N盢$n"HIR"叉ㄓ礚篊篊眖$Nō娩床\n"NOR);
	  set("no_give", 1);
	  set("no_drop", 1);
        setup();
}
int query_autoload()
{
	if ( this_player()->query("class") == "red-sword" )
		return 1;
	else
		return 0;
}