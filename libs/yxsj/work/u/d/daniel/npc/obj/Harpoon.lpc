// Harpoon.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("辰紆", ({ "Harpoon missile","harpoon","missile"}) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	
"辰は磨紆琌瓣夹非は磨紆\n"
"瘤礛甮祘ぃ琌Block II腹竒э秈\n"
"ю阑ヴ︙よ︓琌翠柑差磨ヘ夹\n"
"τ炊筂皌称琌Τノ猌竟\n");
		set("unit", "ㄇ");
		set("base_unit", "猅");
		set("base_weight", 1000);
		set("base_value", 100000);
		set("value", 1000000);
		set("wield_msg", "$N盢$n恶Ю狠祇甮琜暗祇甮非称\n");
		set("unwield_msg", "$N盢$n︑祇甮琜い更\n");
	}
	set_amount(8);
	init_throwing(5000);
	setup();
}
int query_autoload() { return 1; }
