#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(HIR"﹀"NOR+RED"纒驹"HIR"砊"NOR, ({"blood dragon cloth", "dragon", "cloth", "blood"}));
        set_weight(600);
        if( clonep() )
        set_default_object(__FILE__);
        else {
        set("long","脓Τ闯闯瞏︹﹀格㎝纒Τ帝秖驹砊\n");
        set("unit", "脓");
        set("value", 10000);
        set("armor_prop/armor", 25);
        set("armor_prop/heal", 5);
        set("armor_prop/parry", 5);
        set("armor_prop/composure", 10);
        set("armor_prop/force", 13);
	  set("class", "red-sword");
        }
        set("wear_msg", HIR"$N盢$n"HIR"ō俐丁$Nō娩瞅露帝礚\n"NOR);
        set("unequip_msg", HIR"$N盢$n"HIR"叉ㄓ礚篊篊眖$Nō娩床\n"NOR);
	  set("no_drop", 1);
	  set("no_give", 1);
        setup();
}
int query_autoload()
{
	if ( this_player()->query("class") == "red-sword" )
		return 1;
	else
		return 0;
}