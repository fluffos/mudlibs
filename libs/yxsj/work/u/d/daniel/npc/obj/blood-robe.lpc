#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create() {
  set_name(HIR "血" NOR + RED "龍" HIR "覆" NOR, ({ "blood dragon robe", "dragon", "robe", "blood" }));
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件上面有斑斑深色血跡和龍形花紋，有著神秘力量的外衣。\n");
    set("unit", "件");
    set("value", 10000);
    set("material", "cloth");
    set("armor_type", "robe");
    set("armor_prop/armor", 15);
    set("armor_prop/spells", 20);
    set("armor_prop/force", 13);
    set("class", "red-sword");
  }
  set("wear_msg", HIR "$N將$n" HIR "披在上身，瞬間$N的身邊圍繞著一股無名的氣息。\n" NOR);
  set("unequip_msg", HIR "$N將$n" HIR "脫了下來，無名的氣息慢慢的從$N的身邊散去。\n" NOR);
  set("no_give", 1);
  set("no_drop", 1);
}
int query_autoload() {
  if (this_player()->query("class") == "red-sword")
    return 1;
  else
    return 0;
}
