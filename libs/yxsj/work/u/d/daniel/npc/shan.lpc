// shan.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_pill();
void create()
{
        set_name("ト痷", ({ "shan jun","shan","jun" }) );
        set("gender", "╧┦");
        set("age", 24);
        set("long",@LONG
琌笵毙笵いト痷ㄓ讽淮ㄤ礚┒└
沮弧礚ゑぃぶ臸毙常┒ぇ
┮臸毙ǎ常跟磷笿ǎ琌┤

LONG);

        set("attitude", "peaceful");
        create_family("笵毙", 1, "笵");
        set("title",HIY"笵毙"NOR"-"HIW"笵"NOR);
        set("class", "taoist");
        set("str", 26);
        set("int", 24);

        set("combat_exp", 900000);
        set("max_kee", 6000);
        set("max_sen", 5600);
        set("max_gin", 5600);
        set("atman", 5000);
        set("max_atman", 2500);
        set("force", 6000);
        set("max_force", 3000);
        set("force_factor", 150);
        set("mana", 5000);
        set("max_mana", 2500);                     
        set("mana_factor", 150);
        set("warexp",150);
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: cast_spell, "thunder" :),
                (: cast_spell, "power" :),
                (: cast_spell, "centbody" :),
                (: command, "exert armor" :),
                (: command, "exert powerup" :),
                (: command, "perform six" :),
      }) );
         set("inquiry",([
		  "芬う砃": (: ask_pill :),
         ]));
        set_skill("unarmed", 130);
        set_skill("parry", 160);
        set_skill("dodge", 150);
        set_skill("tao-steps", 160);
        set_skill("force", 160);
        set_skill("sky-ground-force", 160);
        set_skill("necromancy", 150);
        set_skill("spells", 150);
        set_skill("archery", 180);
        set_skill("god-arrow",180);
        map_skill("parry","god-arrow");
        map_skill("spells","necromancy");          
        map_skill("force","sky-ground-force");     
        map_skill("archery","god-arrow");
        map_skill("dodge","tao-steps");
        set_temp("apply/dodge", 220);
        set_temp("apply/sword", 220);
        set_temp("apply/damage", 220);
        set_temp("apply/armor", 220);
                                                   
        setup();

          carry_object(__DIR__"obj/robe_s")->wear();
          carry_object(__DIR__"obj/shoe_s")->wear();
          carry_object(__DIR__"obj/hat_s")->wear();
          carry_object(__DIR__"obj/arrow_bow")->wield();
}
void init()
{
        object ob;
        ::init();
        if(interactive(ob =this_player()) && !is_fighting() )
        {
        remove_call_out("greeting");
        call_out("greeting",2,ob);
        }
}
void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
        command("hmm "+ob->query("id"));
        command("say ネ秪留さ沧ゎ");
        command("say ˙打礚荷戳");
        command("sigh");
}
int recognize_apprentice(object me)
{
     if (me->query("marks/ト痷"))
      return 1;
}
int prevent_learn(object me,string skill)
{
       if(me->query("marks/ト痷")&&
              me->query("class")=="taoist")
              //笵毙Τmarks碞厩
       {
               if( skill == "god-arrow" ||
                       skill == "archery" )
                       //厩硂ㄢsk
                       return 0;
       }
       return 1;
}

int accept_object(object me,object ob)
{
        if(ob->query("name")=="ざ残獺" &&
                ob->query("give") == me)
        {
                command("say 琂礛琌┕笵ざ残ㄓи碞р礚餐└Α(god-arrow)肚甭倒\n");
                command("say 璶厩膀セ砃(archery)ぃ礛⊿猭厩и礚餐└猌厩\n");
                me->set("marks/ト痷",1);
                return 1;
        }
}
int ask_pill()
{
	object me=this_player();

	if ( me->query("marks/芬う砃") < 2 )
	{
		command("think");
		command("say 硂...弧");
		return 1;
	}

	if ( me->query("marks/芬う砃") == 2 ) {
		command("hmm");
		command("say $HIC$\n\n"
"и琌弘笵毙芬う砃琌硂砃猭笵毙ぃ肚ぇ盞и礚猭淮肚甭籔
垛....硂妓獵锭承ミ穦篙炳笵のタ龟セぇ
璶笵毙睲瞶めи碞盢芬う砃肚甭籔\n");

		me->set("marks/芬う砃", 3); }
	else if ( me->query("marks/芬う砃") == 4 ) {
		command("say ");
		command("say $HIC$\n\n"
"琂礛竒ЧΘи┮ユヴ叭и碞肚甭倒芬う砃砕
パ笵毙猌\猭砃盽帝猭よ笵毙芬う砃︑礛绰硂よ祇甶
璶盢タ絋媚芬う膌ずノずぉ荐獽干猭
秖ド瑌じうび睲郴う┪琌地≧貉う单う媚媚よ㎝
笵皘柑把潦禦τ笵毙芬う膌び店挂斗Τ絫眔ǎ
硂碞琌и禗辨猳\n");
		me->set("marks/芬う砃", 5); }
	else
		command("say 硂...弧");

	return 1;
}

