		"damage":		80,
		"damage_type":	"凤端"
	]),
	([	"action":		"$N鼓羘ㄏ︱產荡м"HIG"璚礚睵"NOR"$n$l祇皚眏綺历瑈",
		"damage":		90,
		"damage_type":	"凤端"
