// mastersu.c

inherit NPC;

#include <ansi.h>

int bullets();

void create()
{
	set_name("临痷", ({ "Master su", "Master", "master", "master su", "su", "Su"}));
	set("nickname", HIC"睲"NOR"フ浆");
	set("title", HIC"痆件挂-"HIR"ら"HIY""NOR);
	set("gender", "╧┦");
	set("age", 210);
	set("attitude", "peaceful");
	set("long",
		"獽琌猌狶嘿睲フ浆临痷醇紌蔼瞏τ碔璸垦\n"
		"琌い猌狶烩旧タ笵瓷假硂计ㄓ﹍沧\n"
		"钮弧烦獽笵佩笆猌狶耴留ㄢκ確\n"
		"ㄤ龟Τ暗ㄆ盽︑痲帝稱\n"
		"暗ㄆ眖ぃ籔祑窱祑羆琌蔼禬璸垦秆∕ㄆ薄\n"
		"猌狶いΤ肚ē弧璝ね常琌砆┮碾ぃ┦┏︙\n"
		"畍琌腝棚\n"
		"ヾ琌\n"
	);

	set("combat_exp", 1000000);
	set("score", 10000000);
	set("rank_info/respect", "藉");
	set("class", "taoist");
	set("max_kee", 10000);

	set("str", 40);
	set("int", 70);
	set("cor", 30);
	set("cps", 70);
	set("spi", 70);
	set("con", 70);
	set("kar", 40);
	set("per", 50);

        set("chat_chance", 5);
	set("chat_msg", ({
		"临痷弧叫拜тΤ或ㄆ盾\n",
		"临痷井ミぃ笆タσ帝ㄆ薄\n",
	}));

	set("force", 5000);
	set("max_force", 5000);
	set("force_factor", 200);

	set("atman", 5000);
	set("max_atman", 5000);

	set("mana", 5000);
	set("max_mana", 5000);
	set("mana_factor", 400);

	set("inquiry", ([
		"腊Γ": "┤礚猭",
		"舧尺︱": (: command("emote 瞏瞏鼓"), command("say 鸡舧尺︱鸡°°°") :),
		"尿絫": "尿絫ㄠ稱㎝矪摆",
		"絬ネ": "琌иねи暗砛\ㄆ到诀闽ォ璸",
		"ホ福": "ウ獽痆件挂瑌マ柑",
		"筧": "稱讽筧玭材...琘莲ろび",
	]) );

	set("marks/糃猭", 2);

	set("chat_chance_combat", 150);
	set("chat_msg_combat", ({
		(: call_out("fight_check", 0) :),
		(: bullets :),
		(: command("cast astral_vision") :),
		(: command("exert recover") :),
	}) );

	create_family("痆件挂", 1, "ら");

	set_skill("literate", 250);
	set_skill("magic", 200);
	set_skill("force", 200);
	set_skill("spells", 200);
	set_skill("unarmed", 250);
	set_skill("parry", 150);
	set_skill("dodge", 150);
	set_skill("move", 150);
	set_skill("sword", 200);

	set_skill("buddhism", 150);
	set_skill("taoism", 150);
	set_skill("necromancy", 200);
	set_skill("sky-ground-force", 200);
	set_skill("wo-che-sword", 200);
	set_skill("nine-sword", 200);

	map_skill("spells", "necromancy");
	map_skill("force", "sky-ground-force");
	map_skill("sword", "nine-sword");
	
	setup();

	carry_object(__DIR__"obj/blkrobe")->wear();
	carry_object(__DIR__"obj/lotushat")->wear();
	carry_object(__DIR__"obj/whisk")->wear();
	carry_object(__DIR__"obj/purplesw");
	carry_object("/u/g/guo/temp/test");

	add_money("gold", 30);

    set("default_actions", (: call_other, __FILE__,"query_action" :));
    reset_action();

}

void can_speak_poetry()
{
	delete("speaking_poetry");
}

void speak_poetry()
{
	if ( !query("speaking_poetry") ) {
		message_vision("\n",this_object());
		command("say 竧ョ");
		command("say 晶笵琌藉");
		command("say 福い痷旅窾");
		command("say 磝搐ゅ猌娩ぱ");
		set("speaking_poetry", 1);
		call_out("can_speak_poetry", 5); }
}

void init()
{
	::init();
	call_out("speak_poetry", 0);
}

int attempt_apprentice(object ob)
{
	command("say ぃ幢讽︙暗"+this_player()->query("name")+"畍");
	return 0;
}

int accept_fight(object me)
{
	command("say ︙琌"+this_player()->query("name")+"癸も");
	return 0;
}

int fight_check()
{
	int max_kee, kee;
	max_kee = this_object()->query("max_kee");
	kee = this_object()->query("kee");
	if ( ( kee < max_kee * 0.4 ) && ( this_object()->query_temp("flag") != 1 ) ) {
		message_vision("\n", this_object());
		command("wield sword");
		message_vision("\n", this_object());
		message_vision("临痷糞笵\n"HIR"ら锭"HIY"る潮"HIR"ら"HIY"る"HIC"聑篙κǜ"HIY"潮"HIR"锭"HIM"秸皌防臸\n\n"NOR, this_object());
		this_object()->set_temp("flag", 1);
		return 1; }
	return 1;
}

int accept_object(object me, object obj)
{
	command("say 稰谅"+RANK_D->query_respect(me)+"癳и硂"+obj->query("unit")+obj->query("name")+"");
	command("bow "+me->query("id"));
	obj->move(this_object());
	return 1;
}
