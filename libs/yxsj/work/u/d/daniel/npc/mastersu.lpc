});

string *dodge_msg = ({
	"$pも得だㄏ"HIG"ォ種も"NOR"╊┷咀盢$Nю阑て礚\n",
	"$p砰ず痷笲锣笲ì\ㄏ荡м"HIY"ネ筽"NOR"\n"
	"ǎ$p玡瞷糷痷毁纠ㄏ$Nю阑荷计砆ず\n",
	"$pō跑ㄏ"HIY"琍津冻˙"NOR"ō猭笲︽ゆ琍よ︗淮磷筁$Nю阑\n",
	"$pō锣ㄏ"HIM"癵萝˙"NOR"竲い津今よ︗淮ォ皗筁$Nю阑\n",
	"$pō猭еㄏ"HIC"だ︽て紇"NOR"ミて计ō紇ㄏ$Nю阑辅店Τ\n",
});
mapping query_action()
{
	return unarmed_msg[random(sizeof(unarmed_msg))];
}

string query_dodge_msg(object weapon)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int doit(string cmd)
{
	command(cmd);
	return 1;
}
int bullets()
{
	int targetnum, i, dp, fp, pp, choice, damage, add, lv;
	object target, *ob, tempobj, me;
	string t, temp;
	mapping skl;

	me = this_object();

	if( !me->is_fighting() )
		return notify_fail(HIR""HIY"ト"HIC""HIY"\"HIR""NOR"驹矮いㄏノ\n");
	if( me->query_temp("perform_delay") )
		return notify_fail(HIR"饼ㄏ"HIY"ト"HIC""HIY"\"HIR"琌谋眔ぃ眖み礚猭矗癬痷\n"NOR);

	skl = me->query_skills();

	message_vision(
HIM"\n$N┛礛ミ﹚ぃ笆ォМだ猭笲癬ōず玪竒いだ瑈锣"NOR"
"HIY"ō痷籈も$N耻羘羇臘いㄏ"HIR""HIC"ト\"HIR""HIY""NOR"
"HIG"ǎ$Nい蛮も硈揣よ祇κ笵玪\n\n"NOR
, me );

	ob = all_inventory(environment(me));
	for(i=0; i<sizeof(ob); i++) {
		if( me->is_fighting(ob[i]) ) targetnum++; }

	for(i=0; i<sizeof(ob); i++)
	{
	if ( !me->is_fighting(ob[i]) ) continue;
	target = ob[i];
	t = ob[i]->query("name");
	fp = target->query_skill("force") / 2 - 35;
	if (fp > 100) fp = 100;
	dp = target->query_skill("dodge") / 2 - 35;
	if (dp > 100) dp = 100;
	pp = target->query_skill("parry") / 2 - 35;
	if (pp > 100) pp = 100;
	if (random(fp) > 50) choice = 3;
	else choice = 4;
	if (random(dp) > 50) choice = 2;
	if (random(pp) > 50) choice = 1;
	add = (me->query_skill("force")*0.6-33);
	if (add > 100) add = 100;

	message_vision(
HIC"いΤ"+CHINESE_D->chinese_number((int)(3000/targetnum))+
"笵玪绰帝"+t+"忌獴硉\n"NOR
	, this_player() );
	if (choice == 1) {
damage = 3000/targetnum/10+(3000/targetnum*0.15)*0.5+(pp-50)*2*3000/targetnum/10/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		tempobj = target->query_temp("weapon");
		if (tempobj) temp = tempobj->query("name");
		else temp = "蛮も";
		target->receive_damage("kee", damage, me);
		if (damage > 0) message_vision(
HIG+t+"ǎ玪ㄓ非よ︗喘癬"+temp+HIG+"笲锣钡场だю阑"NOR"
"HIR"ごΤㄇ玪ゴい"+t+"硑Θㄇ砛\端甡"NOR" ( "+HIR+damage+NOR+" )\n"
		, me ); }

	if (choice == 2) {
damage = 3000/targetnum/20+(3000/targetnum*0.3)*0.5-(dp-50)*2*3000/targetnum*0.15/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		skl = me->query_skill_map();
		temp = to_chinese(skl["dodge"]);
		if (temp == "フ浆猌\") temp = "癵萝˙";
		if (!temp) temp = to_chinese("dodge");
		target->receive_damage("kee", damage, me);
		message_vision(
HIC+t+"ǎ玪霖︓ō锣ㄏ"+temp+"ㄤい濒皗磷"NOR"
"HIR"ごΤㄇ玪ゴい"+t+"硑Θㄇ砛\端甡"NOR" ( "+HIR+damage+NOR+" )\n"
	, me ); }

	if (choice == 3) {
damage = 3000/targetnum/2.5+(3000/targetnum*0.4)*0.5-(fp-50)*2*3000/targetnum/5/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		target->receive_damage("kee", damage, me);
		target->receive_wound("kee", damage/5, me);
		message_vision(
HIM+t+"ǎ薄猵ぃМ礚猭磷秨眔笲癬ōず祑咀"NOR"
"HIR"玪阑い"+t+""+t+"磂计羘珃羘翧﹀"NOR" ( "+HIR+damage+NOR+" )\n"
		, me ); }

	if (choice == 4) {
damage = 3000/targetnum*3/4+(3000/targetnum/4)*0.5;
		damage = (damage*add)/100;
		if (damage < 0) damage = random(200);
		target->receive_damage("kee", damage, me);
		target->receive_wound("kee", damage/2, me);
		message_vision(
HIY+t+"ǎ佩ア︹稱磷秨筐˙玪荷计阑い"+t+NOR"
"HIR+t+"硈羘篏ō砆玪ゴブ秨ψ红"NOR" ( "+HIR+damage+NOR+" )\n"NOR
		, me ); }
	COMBAT_D->report_status(target);
	message_vision("\n", me);
	}
	me->set("force", me->query("force") - 300);
	me->start_busy(3);
	return 1;
}

int forceb(string cmd)
{
	command(cmd);
}