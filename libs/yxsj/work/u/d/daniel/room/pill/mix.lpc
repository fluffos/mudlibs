// cmds mix.c
// last revision by cls (97.08.16)
// modified by Lavita@3rd of Jan, 2000 for new medicine system

// Modify by Clear
#include <ansi.h>
#include "/doc/help.h"
#define PILL_DIR "/d/medicine/obj/pill/"

inherit F_CLEAN_UP;
int main(object me) {
  object pill, bowl;
  int gin = 0, kee = 0, sen = 0, atman = 0, force = 0, mana = 0, nianna = 0, farmana = 0;
  int check = 0, val = 0, level = me->query_skill("medicine", 1);
  int p_lv = 0;
  int map, r = random(100);
  string special, nval = "", p_type;

  seteuid(geteuid(me));

  if (me->is_fighting()) return notify_fail("你現在沒有空﹗\n");
  if (me->is_busy()) return notify_fail("你現在沒有空﹗\n");
  if (!level)
    return notify_fail("你並不懂藥理知識﹐如何配藥﹖\n");
  else if (level < 20)
    return notify_fail("你的藥理知識不足﹐無法配藥。\n");

  // modify by malados  2001/3/9   需聲望30k 以上方能配藥  解決藥機
  if (me->query("prize") < 30000)
    return notify_fail("你的聲望不夠﹐無法配藥。\n");

  bowl = present("king bowl", me);
  if (!bowl)
    return notify_fail("你並沒有任何可以製藥的器材﹐無法配藥。\n");

  if (!bowl->query("cap"))
    return notify_fail("藥缽中並沒有任何藥材﹐無法配出藥來。\n");
  if (bowl->query("cap") < 2)
    return notify_fail("只有一種藥材怎樣混也是那種藥材吧﹖\n");
  if (bowl->query("cap") < 3)
    return notify_fail("你得放入三種不同的藥材才能將藥配出來。\n");
  if (me->query("sen") < 30)
    return notify_fail("你目前的精神狀態不佳﹐無法配出藥來。\n");

  // 取出存在藥缽中的參數, 並加以判斷找出最大項.
  // 參數項目: gin、kee、sen、atman、force、mana、nianna、farmana

  gin = bowl->query("trait/gin");
  kee = bowl->query("trait/kee");
  sen = bowl->query("trait/sen");
  atman = bowl->query("trait/atman");
  force = bowl->query("trait/force");
  mana = bowl->query("trait/mana");
  nianna = bowl->query("trait/nianna");
  farmana = bowl->query("trait/farmana");

  if (bowl->query("trait/special") != "clear")
    special = bowl->query("trait/special");

  val = gin;
  nval = "gin";
  //原定值
  //以下為值的比較，以判斷最大val
  if (kee > val) { nval = "kee"; val = kee; }
  if (sen > val) { nval = "sen"; val = sen; }
  if (atman > val) { nval = "atman"; val = atman; }
  if (force > val) { nval = "force"; val = force; }
  if (mana > val) { nval = "mana"; val = mana; }
  if (nianna > val) { nval = "nianna"; val = nianna; }
  if (farmana > val) { nval = "farmana"; val = farmana; }
  //fix val值,以免有人亂寫藥材,做出不會失敗的藥
  if (val > 100) val = 100;
  //決定藥丸等級(請保持此處愈簡單愈好)
  if ((string)me->query_skill_mapped("medicine") == "long-life-medicine")
    map = me->query_skill("long-life-medicine", 1);
  if ((string)me->query_skill_mapped("medicine") == "ninja-medicine")
    map = me->query_skill("ninja-medicine", 1);
  if ((string)me->query_skill_mapped("medicine") == "devil-medicine")
    map = me->query_skill("devil-medicine", 1);
  if (map == 0)
    return notify_fail("請你先 enable 一種藥理技能。\n");
  check = map * level * val / 220 / 220;
  if (r < check) {
    p_lv = 1;
  } else if (r < (3 * check)) {
    p_lv = 2;
  } else {
    p_lv = 3;
  }

  switch (me->query_skill_mapped("medicine")) {
    case "long-life-medicine":
      {
        //----------------------
        // new system by Lavita
        //    p_lv ranges from 1(best) to 3(worst)
        //    p_type supports now:
        //      babo(八寶系列):補-氣,內(1/5,1/3,1/2)
        //      depo(解毒系列):回復中毒狀態
        //      rgin(補精系列):補精(1/3,1/2,1/1)
        //     rsen(補神係列):補神(1/3,1/2,1/1)
        //     rkee(補氣係列):補氣(1/3,1/2,1/1)
        //----------------------
        //依藥性決定藥物


        if (!special) {
          switch (nval) {
            case "force":
              p_type = "babo";
              break;
            default:
              p_type = "nouse";
              break;
          }
        } else  //特定之藥材於此設定
        {
          switch (special) {
            case "depoison":
              p_type = "depo";
              break;
            case "full":
              p_type = "full";
              break;
            case "rgin":
              p_type = "rgin";
              break;
            case "rkee":
              p_type = "rkee";
              break;
            case "rsen":
              p_type = "rsen";
              break;
            default:
              p_type = "nouse";
              break;
          }
        }


        if (!p_type) p_type = "rgin";
        if (!p_type) p_type = "rkee";
        if (!p_type) p_type = "rsen";
        if (!p_type) p_type = "babo";
        if (!p_lv) p_lv = 3;
        // 依所設的p_type及p_lv, 判斷clone那個pill檔
        switch (p_type) {
          case "babo":
            switch (p_lv) {
              case 1:
                pill = new(PILL_DIR "babogold.lpc");  //八寶金丹
                break;
              case 2:
                pill = new(PILL_DIR "babosilver.lpc");  //八寶銀丹
                break;
              default:  // p_lv==3
                pill = new(PILL_DIR "babo.lpc");  //八寶桂丸
                break;
            }
            break;
          case "rgin":
            switch (p_lv) {
              case 1:
                pill = new(PILL_DIR "r_eff_gin_pill3.lpc");  //翔翎霞丹
                break;
              case 2:
                pill = new(PILL_DIR "r_eff_gin_pill2.lpc");  //翔翎霧丹
                break;
              default:  // p_lv==3
                pill = new(PILL_DIR "r_eff_gin_pill1.lpc");  //翔翎雲丹
                break;
            }
            break;
          case "rkee":
            switch (p_lv) {
              case 1:
                pill = new(PILL_DIR "r_eff_kee_pill3.lpc");  //九轉還魂丹
                break;
              case 2:
                pill = new(PILL_DIR "r_eff_kee_pill2.lpc");  //七轉還魂丹
                break;
              default:  // p_lv==3
                pill = new(PILL_DIR "r_eff_kee_pill1.lpc");  //五轉還魂丹
                break;
            }
            break;
          case "rsen":
            switch (p_lv) {
              case 1:
                pill = new(PILL_DIR "r_eff_sen_pill3.lpc");  //熾火炎丹
                break;
              case 2:
                pill = new(PILL_DIR "r_eff_sen_pill2.lpc");  //炙火炎丹
                break;
              default:  // p_lv==3
                pill = new(PILL_DIR "r_eff_sen_pill1.lpc");  //烈火炎丹
                break;
            }
            break;
          case "depo":
            switch (p_lv) {
              case 1:
                pill = new(PILL_DIR "depoice.lpc");
                break;
              case 2:
                pill = new(PILL_DIR "depolotus.lpc");
                break;
              default:  // p_lv==3
                pill = new(PILL_DIR "depoblack.lpc");
                break;
            }
            break;
            // add new p_type above this line
          case "nouse":
          default:
            pill = new(PILL_DIR "nouse_pill.lpc");
            break;
        }
        if (me->query("force") < 50)
          return notify_fail("你的內力不足﹐無法配出藥來﹗\n");
        pill->move(me);
        bowl->delete("cap");
        bowl->delete("MedicinalName");
        bowl->delete("trait");
        me->add("force", -50);
        me->receive_damage("sen", 30);

        if (level < 35)
          message_vision("$N粗陋地將藥缽蓋\上﹐舉起藥缽拼老命的左右搖動小屁屁。\n", me);
        else {
          message_vision("$N雙手按在藥缽上﹐緩緩的將內力注入藥缽﹐" +
            "只見一縷\縷\的青煙自缽頂飄散而出。\n", me);
          if ((me->query("sen") > (me->query("max_sen") / 4 * 3)) && random(2) > 1)
            if (random(10) > 7) me->add("combat_exp", 1);
        }

        if (me->query_skill("medicine", 1) <= 219)
          me->improve_skill("medicine", random(level / 2), 0);
        if (me->query_skill("long-life-medicine", 1) <= 219)
          me->improve_skill("long-life-medicine", random(level / 4), 0);
      }
      break;
    case "ninja-medicine":
      {
        switch (special) {
          case "renianna":
            p_type = "renianna";
            break;
          default:
            p_type = "nouse";
            break;
        }
        if (!p_type) p_type = "nouse";
        if (!p_lv) p_lv = 3;
        switch (p_type) {
          case "renianna":
            switch (p_lv) {
              case 1:
                pill = new(PILL_DIR "r_nianna_pill13.lpc");  //紫氣戀櫻丹
                break;
              case 2:
                pill = new(PILL_DIR "r_nianna_pill2.lpc");  //紫玉戀櫻丹
                break;
              case 3:
                pill = new(PILL_DIR "r_nianna_pill1.lpc");  //紫聖戀櫻丹
                break;
            }
            break;
          case "nouse":
            pill = new(PILL_DIR "nouse_pill.lpc");
            break;
        }
        if (me->query("nianna") < 50)
          return notify_fail("你的念力不足﹐無法配出藥來﹗\n");
        pill->move(me);
        bowl->delete("cap");
        bowl->delete("MedicinalName");
        bowl->delete("trait");
        me->add("nianna", -50);
        me->receive_damage("sen", 30);

        if (level < 35)
          message_vision("$N粗陋地將藥缽蓋\上﹐舉起藥缽拼老命的左右搖動小屁屁。\n", me);
        else {
          message_vision("$N雙手按在藥缽上﹐緩緩的將念力注入藥缽﹐" +
            "只見一縷\縷\的冰霜之氣自缽頂飄散而出。\n", me);
          if ((me->query("sen") > (me->query("max_sen") / 4 * 3)) && random(2) > 1)
            if (random(10) > 7) me->add("combat_exp", 1);
        }

        if (me->query_skill("medicine", 1) <= 219)
          me->improve_skill("medicine", random(level / 2), 0);
        if (me->query_skill("ninja-medicine", 1) <= 219)
          me->improve_skill("ninja-medicine", random(level / 4), 0);
      }
      break;
    case "devil-medicine":
      {
        switch (special) {
          case "refarmana":
            p_type = "refarmana";
            break;
          default:
            p_type = "nouse";
            break;
        }
        if (!p_type) p_type = "nouse";
        if (!p_lv) p_lv = 3;
        switch (p_type) {
          case "refarmana":
            switch (p_lv) {
              case 1:
                pill = new(PILL_DIR "r_farmana_pill3.lpc");  //五毒邪魔丹
                break;
              case 2:
                pill = new(PILL_DIR "r_farmana_pill2.lpc");  //五毒狂魅丹
                break;
              case 3:
                pill = new(PILL_DIR "r_farmana_pill1.lpc");  //五毒冥魋丹
                break;
            }
            break;
          case "nouse":
            pill = new(PILL_DIR "nouse_pill.lpc");
            break;
        }
        if (me->query("farmana") < 50)
          return notify_fail("你的魔力不足﹐無法配出藥來﹗\n");
        pill->move(me);
        bowl->delete("cap");
        bowl->delete("MedicinalName");
        bowl->delete("trait");
        me->add("farmana", -50);
        me->receive_damage("sen", 30);

        if (level < 35)
          message_vision("$N粗陋地將藥缽蓋\上﹐舉起藥缽拼老命的左右搖動小屁屁。\n", me);
        else {
          message_vision("$N雙手按在藥缽上﹐緩緩的將魔力注入藥缽﹐" +
            "只見一縷\縷\的魔氣自缽頂飄散而出。\n", me);
          if ((me->query("sen") > (me->query("max_sen") / 4 * 3)) && random(2) > 1)
            if (random(10) > 7) me->add("combat_exp", 1);
        }

        if (me->query_skill("medicine", 1) <= 219)
          me->improve_skill("medicine", random(level / 2), 0);
        if (me->query_skill("devil-medicine", 1) <= 219)
          me->improve_skill("devil-medicine", random(level / 4), 0);
      }

  }
  // 添增巫師使用時顯示各狀態, 以便測試
  if (wizardp(me)) printf(
    "\n special= %s﹐nval= %s﹐val= %d﹐check=%d,map=%d\n",
    special,
    nval,
    val,
    check,
    map
  );
  if (wizardp(me)) printf(
    "\n gin= %d﹐kee= %d﹐sen= %d﹐atman= %d﹐force= %d﹐mana= %d﹐nianna= %d﹐farmana= %d\n",
    gin,
    kee,
    sen,
    atman,
    force,
    mana,
    nianna,
    farmana
  );
  if (wizardp(me)) printf(" p_type = %s﹐p_lv = %d,r = %d \n", p_type, p_lv, r);
  message_vision("$N擦擦額頭的汗，打開缽蓋\﹐從中取出了一粒藥丸。\n", me);
  me->start_busy(random(4) + 1);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式﹕mix
 
製藥(pill)的指令﹐但首先你必須先要有三樣以上的藥
材﹐與一個可以製藥的器具。
 
HELP
  );
  return 1;
}
