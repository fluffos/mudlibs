inherit COMBINED_ITEM;
#include <ansi.h>
void create()
{
        set_name(HIY""HIR"地"HIC"≧"HIG"貉"HIM"う"NOR,({"mana pill", "mana", "pill"}));
        set("long","硂琌采確猭媚\n");
        set("value", 20000);
        set("unit", "采");
        set("base_unit", "采");
        set("base_weight", 100);
        set_amount(1);
        setup();
}
void init()
{
        add_action("do_eat","eat");
}
int do_eat(string arg)
{
        int kee , gin , sen ;
        object ob,me=this_player();
        if (me->query_temp("block_msg/all"))
                return notify_fail("穡临稱媚?\n");
        if (me->is_busy()) return notify_fail("瞷⊿Τ硂\n");
        if (!arg) return notify_fail("璶ぐ或?\n");
        arg=lower_case(arg);
        if (!ob = present(arg,me)) return notify_fail("ō⊿硂狥﹁\n");
        if (ob != this_object()) return 0;
        me->start_busy(1);
        message_vision("$N癬采"HIY""HIR"地"HIC"≧"HIG"貉"HIM"う"NOR"い\n",me);
        write("谋眔穢種眖瞉ㄓō滴篫礚ゑ\n");
        if((me->query("mana") + me->query("max_mana")/2) >= me->query("max_mana")*2)
                me->set("mana", me->query("max_mana")*2);
        else me->add("mana", me->query("max_mana")/2);
        add_amount(-1);
        return 1;
}
