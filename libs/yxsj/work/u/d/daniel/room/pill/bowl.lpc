// bowl.c
// healer 製藥用的指令! 與mix並用!
// writen by aip and acord
// revision by cls (97.08.16)


#include <ansi.h>


inherit F_CLEAN_UP;

int do_add(object me, object bowl, string herb);
int do_adds(object me, object bowl, string herb1, string herb2, string herb3);
int do_clean(object me, object bowl);
int do_check(object me, object bowl);
int do_use(object me);

mixed main(object me, string arg) {
  string command, herb, herb1, herb2, herb3;

  object bowl = present("king bowl", me);
  if (!bowl)
    return notify_fail("你並沒有任何可以製藥的器材﹐無法配藥。\n");

  if (me->is_busy()) return notify_fail("你現在沒有空﹗\n");

  if (!arg)
    return notify_fail("你要做什麼﹖\n");

  if (arg != "use" && me->is_fighting())
    return notify_fail("在戰鬥中做藥？\n");

  if (arg == "use")
    return do_use(me);
  else if (sscanf(arg, "%s %s %s %s", command, herb1, herb2, herb3) == 4) {
    if (command == "adds")
      return do_adds(me, bowl, herb1, herb2, herb3);
    else
      return notify_fail("指令有錯﹐請 help bowl 瞭解用法...\n");
  } else if (sscanf(arg, "%s %s", command, herb) == 2) {
    if (command == "add")
      return do_add(me, bowl, herb);
    else
      return notify_fail("指令有錯﹐請 help bowl 瞭解用法。\n");
  } else if (arg == "clean")
    return do_clean(me, bowl);
  else if (arg == "check")
    return do_check(me, bowl);
  else if (arg == "use")
    return do_use(me);

  return notify_fail("指令有錯﹐請 help bowl 瞭解用法!\n");
}

int do_clean(object me, object bowl) {

  if (bowl->query("cap")) {
    write("你打開缽蓋\﹐將藥缽裡的藥材跟殘渣倒在一旁。\n");
    bowl->delete("cap");
    bowl->delete("MedicinalName");
    me->start_busy(1);
  } else
    return notify_fail("這個藥缽裡並未放入任何藥材。\n");
  return 1;
}

int do_check(object me, object bowl) {
  if (bowl->query("cap")) {
    write("藥缽中已經放進了的藥材有﹕");
    if (bowl->query("MedicinalName/1")) write(bowl->query("MedicinalName/1"));
    if (bowl->query("MedicinalName/2")) write("﹐" + bowl->query("MedicinalName/2"));
    if (bowl->query("MedicinalName/3")) write("﹐" + bowl->query("MedicinalName/3"));
    write("。\n");
  } else return notify_fail("這個藥缽裡並未放入任何藥材。\n");

  return 1;

}


int do_add(object me, object bowl, string herb) {
  int gin, kee, sen, force;
  object ob;
  ob = present(herb, me);
  if (!ob) return notify_fail("你身上並沒有這樣藥材。\n");
  if (ob->query("raw/type") != "herb")
    return notify_fail("你只能把藥材放進藥缽裡。\n");
  if (bowl->query("cap") > 2) return notify_fail("藥缽已經放不下任何藥材了。\n");

  if (bowl->query("MedicinalName/1") == ob->query("name")
    || bowl->query("MedicinalName/2") == ob->query("name")
    || bowl->query("MedicinalName/3") == ob->query("name"))  //    return notify_fail("藥缽中已經有了這種藥材﹐必須要有三種不同的藥材才能配藥。\n");
  {
    message_vision("$N把藥材放進了藥缽內。\n", me);
    ob->add_amount(-1);
    me->start_busy(1);
    return 1;
  }

  if (!bowl->query("MedicinalName/1"))
    bowl->set("MedicinalName/1", ob->query("name"));
  else if (!bowl->query("MedicinalName/2"))
    bowl->set("MedicinalName/2", ob->query("name"));
  else bowl->set("MedicinalName/3", ob->query("name"));

  // modify by cls
  // latest modified by Lavita@3rd of Jan,2000 adding nianna and farmana
  // 屬性欄位增為 gin、kee、sen、atman、force、mana、nianna、farmana 共八種
  bowl->set("trait/gin", bowl->query("trait/gin") + ob->query("trait/gin"));
  bowl->set("trait/kee", bowl->query("trait/kee") + ob->query("trait/kee"));
  bowl->set("trait/sen", bowl->query("trait/sen") + ob->query("trait/sen"));
  bowl->set("trait/atman", bowl->query("trait/atman") + ob->query("trait/atman"));
  bowl->set("trait/force", bowl->query("trait/force") + ob->query("trait/force"));
  bowl->set("trait/mana", bowl->query("trait/mana") + ob->query("trait/mana"));
  bowl->set("trait/nianna", bowl->query("trait/nianna") + ob->query("trait/nianna"));
  bowl->set("trait/farmana", bowl->query("trait/farmana") + ob->query("trait/farmana"));

  // modify by cls
  // 特別欄位增加優先順序, 由level決定各特別欄位(special)是否存入.
  // level 較高者優先存入.
  if ((ob->query("trait/special") && ob->query("trait/level") > bowl->query("trait/level"))
    || !bowl->query("trait/special")) {
    bowl->set("trait/special", ob->query("trait/special"));
    bowl->set("trait/level", ob->query("trait/level"));
  }
  bowl->set("cap", bowl->query("cap") + 1);
  message_vision("$N把藥材放進了藥缽內。\n", me);
  ob->add_amount(-1);
  me->start_busy(1);
  return 1;
}


int do_adds(object me, object bowl, string herb1, string herb2, string herb3) {
  int gin, kee, sen, force, tmp;
  int t1, t2, t3;
  object ob1, ob2, ob3;

  ob1 = present(herb1, me);
  ob2 = present(herb2, me);
  ob3 = present(herb3, me);

  if ((!ob1) || (!ob2) || (!ob3))
    return notify_fail("你身上並沒有這樣藥材。\n");

  if ((ob1->query("raw/type") != "herb") || (ob2->query("raw/type") != "herb")
    || (ob3->query("raw/type") != "herb"))
    return notify_fail("你只能把藥材放進藥缽裡。\n");

  if (bowl->query("cap") > 0)
    return notify_fail("藥缽已經有藥材在裡面了。\n");

  if ((ob1->query("name") == (ob2->query("name")))
    || (ob1->query("name") == (ob3->query("name")))
    || (ob2->query("name") == (ob3->query("name"))))
    return notify_fail("必須要有三種不同的藥材才能配藥。\n");


  // modify by cls
  // latest modified by Lavita@3rd of Jan,2000 adding nianna and farmana
  // 屬性欄位增為 gin、kee、sen、atman、force、mana、nianna、farmana 共八種
  bowl->set("trait/gin", bowl->query("trait/gin") + ob1->query("trait/gin"));
  bowl->set("trait/kee", bowl->query("trait/kee") + ob1->query("trait/kee"));
  bowl->set("trait/sen", bowl->query("trait/sen") + ob1->query("trait/sen"));
  bowl->set("trait/atman", bowl->query("trait/atman") + ob1->query("trait/atman"));
  bowl->set("trait/force", bowl->query("trait/force") + ob1->query("trait/force"));
  bowl->set("trait/mana", bowl->query("trait/mana") + ob1->query("trait/mana"));
  bowl->set("trait/nianna", bowl->query("trait/nianna") + ob1->query("trait/nianna"));
  bowl->set("trait/farmana", bowl->query("trait/farmana") + ob1->query("trait/farmana"));

  if ((ob1->query("trait/special") && ob1->query("trait/level") > bowl->query("trait/level"))
    || !bowl->query("trait/special")) {
    bowl->set("trait/special", ob1->query("trait/special"));
    bowl->set("trait/level", ob1->query("trait/level"));
  }

  bowl->set("trait/gin", bowl->query("trait/gin") + ob2->query("trait/gin"));
  bowl->set("trait/kee", bowl->query("trait/kee") + ob2->query("trait/kee"));
  bowl->set("trait/sen", bowl->query("trait/sen") + ob2->query("trait/sen"));
  bowl->set("trait/atman", bowl->query("trait/atman") + ob2->query("trait/atman"));
  bowl->set("trait/force", bowl->query("trait/force") + ob2->query("trait/force"));
  bowl->set("trait/mana", bowl->query("trait/mana") + ob2->query("trait/mana"));
  bowl->set("trait/nianna", bowl->query("trait/nianna") + ob2->query("trait/nianna"));
  bowl->set("trait/farmana", bowl->query("trait/farmana") + ob2->query("trait/farmana"));

  if ((ob2->query("trait/special") && ob2->query("trait/level") > bowl->query("trait/level"))
    || !bowl->query("trait/special")) {
    bowl->set("trait/special", ob2->query("trait/special"));
    bowl->set("trait/level", ob2->query("trait/level"));
  }

  bowl->set("trait/gin", bowl->query("trait/gin") + ob3->query("trait/gin"));
  bowl->set("trait/kee", bowl->query("trait/kee") + ob3->query("trait/kee"));
  bowl->set("trait/sen", bowl->query("trait/sen") + ob3->query("trait/sen"));
  bowl->set("trait/atman", bowl->query("trait/atman") + ob3->query("trait/atman"));
  bowl->set("trait/force", bowl->query("trait/force") + ob3->query("trait/force"));
  bowl->set("trait/mana", bowl->query("trait/mana") + ob3->query("trait/mana"));
  bowl->set("trait/nianna", bowl->query("trait/nianna") + ob3->query("trait/nianna"));
  bowl->set("trait/farmana", bowl->query("trait/farmana") + ob3->query("trait/farmana"));

  if ((ob3->query("trait/special") && ob3->query("trait/level") > bowl->query("trait/level"))
    || !bowl->query("trait/special")) {
    bowl->set("trait/special", ob3->query("trait/special"));
    bowl->set("trait/level", ob3->query("trait/level"));
  }


  bowl->set("cap", 3);
  message_vision("$N把藥材一起放進了藥缽內。\n", me);
  bowl->set("MedicinalName/1", ob1->query("name"));
  bowl->set("MedicinalName/2", ob2->query("name"));
  bowl->set("MedicinalName/3", ob3->query("name"));
  ob1->add_amount(-1);
  ob2->add_amount(-1);
  ob3->add_amount(-1);
  me->start_busy(3);
  return 1;
}


int do_use(object me) {
  object ob;
  int max_kee = me->query("max_kee") / 30;
  int lv = me->query_skill("medicine") / 10;
  int llv = me->query_skill("medicine", 1);
  if (ob != present("King bowl", this_player())) return 0;
  if (me->query("marks/五大QUEST") == "靈泉山莊" && me->is_fighting()) {

    if (me->query_skill("medicine", 1) > 20 && (me->query("sen") > (max_kee + lv))) {
      me->receive_damage("sen", max_kee / 2 + lv / 4 + random(lv / 2));
      me->receive_curing("kee", max_kee / 2 + lv / 4 + random(lv));
      me->receive_heal("kee", max_kee / 2 + lv / 4 + random(lv / 2));
      me->add("force", -((llv / 5) + 60));
      message_vision(
        HIG "\n$N手上的" HIY "藥王缽" HIG "突然放出一陣青光籠罩在$N的身上．．．．\n"
        HIC "$N的傷勢看來好了不少。\n\n" NOR, me);
      me->start_busy(1);
    }
  } else
    return notify_fail(CYN "似乎沒有什麼奇怪的事發生。\n" NOR);

  return 1;
}


int help(object me) {
  write(@HELP
指令格式﹕bowl <command> [<Herb>]
 
bowl add  <herd name>                           將藥材放入藥缽中
bowl adds <herd name> <herd name> <herd name>   將三種藥材一起放入藥缽中
bowl check                                      列出已經放入藥缽內的東西
bowl clean                                      清除藥缽內的東西
bowl use                                        自我治療 (醫者專用, 須在戰鬥中)
  
相關指令﹕mix
HELP
  );
  return 1;

}
