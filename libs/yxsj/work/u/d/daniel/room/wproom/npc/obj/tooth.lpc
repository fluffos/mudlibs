inherit EQUIP;
void create()
{
	set_name("瑀", ({ "tooth" }) );
	set_weight(200);
	set("unit","聋");
	set("skill_type", "unarmed");
	set("flag",0);
	set("weapon_prop/damage",1);
	if (!query("actions")){
	   set("actions", (: call_other,"/adm/daemons/race/beast.lpc","query_action" :) );
	   set("verbs", ({ "bite"}) );
        }
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int j;
        j = victim->query_condition("spiderpoison");
        victim->apply_condition("spiderpoison",20+j);
}
void owner_is_killed() { destruct(this_object()); }
