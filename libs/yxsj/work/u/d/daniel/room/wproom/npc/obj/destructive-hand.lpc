#include <ansi.h>
#include <armor.h>

inherit HANDS;

void create() {
  set_name(
    HIC "毀" NOR + CYN "天" HIY "滅" NOR + YEL "地" NOR,
    ({ "destructive hand", "destructive", "hand" })
  );
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "正如其名，只要穿戴上它，就能具有強大的攻擊力。仔細觀看之下，除了佈滿\n"
      "不知名的符號外，其他一切有關此物的來源皆無法得知，可說是百世難得一見的神器。\n");
    set("material", "???");
    set("value", 100000);
    set("armor_type", "hands");
    set("armor_prop/attack", 100);
    set("armor_prop/unarmed", 30);
    set("class", "taoist");
    set("no_pawn", 1);
  }
  set("wear_msg", HIR "$N將$n" HIR "戴在手上，$N好像突然具有源源不絕的神力。\n" NOR);
  set("unequip_msg", RED "$N將$n" RED "從手上卸了下來，神力也漸漸消散了。\n" NOR);
}
int query_autoload() {
  return 1;
}
