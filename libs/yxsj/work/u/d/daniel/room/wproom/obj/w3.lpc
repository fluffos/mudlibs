#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit BLADE;

void create() {
  set_name(HIY "犀" HIC "角" HIW "刀" NOR, ({ "rhinoceros@ blade", "blade" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "這是一把犀利非常的寶刀，為一刀萬殺所有，是神兵之一，具有削金斷石的威力。\n");
    set("value", 15000);
    set("material", "steel");
    set("wield_msg", "$N從背上的刀鞘中拔出$n握在手中，刀身發出渾渾的吼聲。\n");
    set("unwield_msg", "$N將手中的$n收進背上的刀鞘中。\n");
  }
  init_blade(30, SECONDARY);

  setup();
}
