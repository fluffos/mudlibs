#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit SWORD;

void create() {
  set_name(HIG "疾" HIM "‧" HIC "風" HIM "‧" HIR "斬" NOR, ({ "torando sword", "sword" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "這是一劍萬生的配劍，是當年他橫掃天下無敵手的利器，亦屬神兵之一。\n");
    set("value", 3500);
    set("material", "steel");
    set("wield_msg", "$N低喝一聲『$n』，只見$n飛上半空迴\了一圈握在手中。\n");
    set("unwield_msg", "$N將手中的$n收進背後的劍鞘。\n");
  }
  init_sword(40, SECONDARY);
  setup();
}
