#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIC "道觀密室" NOR);
  set("long", @LONG

　　你一踏進這個房間，便覺得有一股不比尋常的凝重氣氛，抬起頭來一看
，才發現你現在身在一個玄武道觀的密室內。這個房間裡最令你好奇的是一
套在房間裡面的神秘寶刀(weapon)。這把寶刀被放置在一個檀木神桌上，正
發出著令人無法直視的光芒。就在此時，你看到了你的身邊閃出了兩個武功
高深的道士，似乎無時無刻不在守護著這把寶刀。

LONG
  );
  set("no_transmit", 1);
  set("no_drift", 1);
  set("exits", ([ /* sizeof() == 5 */
    "north": __DIR__ "wproom2",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/phoenix": 1,
    __DIR__ "npc/dratle": 1,
  ]));

  set("item_desc", ([ /* sizeof() == 1 */
    "weapon": "這把寶刀正被放在神桌上，你可以試著把它拿下來(take)\n",
  ]));


  setup();
}
void init() {
  add_action("do_take", "take");
}
int do_take() {
  object guard, me, blade;
  me = this_player();
  guard = present("tao", environment(me));

  if (guard) {
    message_vision(HIY "四聖使大喝道：作什麼！\n" NOR, me);
  } else {
    if (query("blade_taken") == 1)
      return notify_fail("寶刀已經被拿走了！\n");
    blade = new(__DIR__ "obj/w3");
    tell_object(
      users(),
      "\n\n　　　　　" + HIY + me->query("name") + HIR + "打敗了玄武道觀四聖使中的朱雀、玄武，順利取得" + blade->name() + HIR + "了！！\n\n\n" + NOR
    );
    message_vision(HIG "你拿起了寶刀，只見" + blade->name() + HIG + "發出了耀眼的光芒！！\n\n" NOR, me);
    blade->move(me);
    set("blade_taken", 1);
  }

  return 1;
}
int valid_leave(object me, string dir) {
  object guard;
  guard = present("tao", environment(me));

  if ((dir == "north") && guard) {
    message_vision(HIY "四聖使擋在你的面前，把你擋了回來。\n" NOR, me);
    return notify_fail("\n");
  } else return 1;
}
