inherit NPC;
#include <ansi.h>
void create() {
  set_name(HIY "黃金鼠" NOR, ({ "golden mouse", "mouse", "golden" }));
  set("long", "這是一隻平時很少見的黃金鼠，不知道為什麼會在這裡出現。\n");
  set("race", "野獸");
  set("verbs", ({ "bite" }));
  set("limbs", ({ "頭部", "身體", "尾巴" }));
  set("age", 5);
  set("combat_exp", 10000);
  set("max_kee", 1000);
  set("max_gin", 700);
  set("max_sen", 700);
  set("chat_chance", 8);
  set("chat_msg", ({
    CYN "黃金鼠正到處跑來跑去。\n" NOR,
  }));
  setup();
}
