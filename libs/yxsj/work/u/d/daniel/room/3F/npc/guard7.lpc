int ask_pill()
{
	object me=this_player();

	if ( me->query("marks/芬う砃") == 0 ) {
		command("hmm");
		command("say $HIC$\n"
"垛и琌笵翴Τ闽芬う砃ㄆ薄
芬う砃程Ν琌パ簙芬う砃仓る盢贺借媚ㄓ荐玱
τパㄤい―眔ネぃρ媚┪琌ㄏㄤ跑Θ独τ笵毙芬う砃眖讽笵Τ
瘆┦祇甶瞷竒镑暗ノㄓ糤秈猭媚琌и癸硂よ⊿
Τ瞏╯┪砛\拜拜ψぱ边常媚莱赣
睲贰Τ闽硂よ戈");

		me->set("marks/芬う砃", 1); }
	else
		command("say иぃ琌竒㎝弧筁Τ闽芬う砃ㄆ薄盾猳");

	return 1;
}
