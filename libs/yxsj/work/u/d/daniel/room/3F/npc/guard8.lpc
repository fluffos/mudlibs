#include <ansi.h>
inherit NPC;
int ask_pill();
void create() {
  set_name(HIY "小拜格大肉包" NOR, ({ "taoist byg", "byg", "taoist" }));
  set("race", "人類");
  set("gender", "男性");
  set("title", HIC "道教護衛" HIW "-" HIM "上" NOR + HIW "清" NOR + HIR "靈" NOR + HIG "寶" NOR + HIW
    "天尊" NOR);
  create_family("道教", 2, "弟子");
  set("nickname", HIR "我好肉...我好肉..." NOR);
  set("class", "taoist");
  set("age", 22);
  set("con", 30);
  set("str", 29);
  set("max_mana", 2500);
  set("mana_factor", 100);
  set("max_gin", 8000);
  set("max_kee", 10000);
  set("max_sen", 8000);
  set("max_atman", 2500);
  set("max_force", 2500);
  set("force_factor", 100);
  set("force", 5000);
  set("mana", 5000);
  set("warexp", 70);
  set("long",
    "你所看到的這個人..恐怕是這個遊戲中最有愛心的道士了.....
如果你有問題可以問問他...只要他知道的事一定會告訴你....
可惜的是...他的實力是最肉的.....而且是最笨的.....
只要你的武術有50k...就可以打敗他了
不要懷疑...
他就是這麼肉....\n");
  set_skill("sword", 120);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("force", 120);
  set_skill("spells", 170);
  set_skill("taoism", 100);
  set_skill("sky-ground-force", 120);
  set_skill("necromancy", 170);
  set_skill("tao-steps", 100);
  set_skill("wo-che-sword", 120);

  map_skill("parry", "wo-che-sword");
  map_skill("force", "sky-ground-force");
  map_skill("sword", "wo-che-sword");
  map_skill("dodge", "tao-steps");
  map_skill("spells", "necromancy");
  set_temp("apply/dodge", 200);
  set_temp("apply/sword", 200);
  set_temp("apply/damage", 200);
  set_temp("apply/armor", 200);

  set("combat_exp", 500000);
  set("chat_chance", 20);
  set("chat_msg", ({
    CYN "小拜格大肉包手按劍柄，紋風不動，一副不怒而威的模樣。\n" NOR,
    CYN "小拜格大肉包雙目如電，注視著你的一舉一動。\n" NOR,
    (: command, "hmm" :),
  }));
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: cast_spell, "thunder" :),
    (: cast_spell, "power" :),
    (: command, "exert recover" :),
    (: command, "exert regenerate" :),
    (: command, "exert refresh" :),
    (: command, "exert armor" :),
    (: command, "exert powerup" :),
    (: perform_action, "sword.sky-ground-root" :),
  }));
  set("inquiry", ([
    "玄真君": "他經常不在道教的, 聽說在離愁谷..但不知道在那? ?...",
    "道尊": "你問咱們祖師爺呀﹖聽說他老人家去閉關了, 不要打擾他喔..",
    "青陽子": "你找他做什麼??  你還是請回吧!.....",
    "黑暗道": "那是很可怕的地方...我勸你還是不要去的好!....",
    "道院": "它在道教後山吧..自己去找找我可忙的很.....",
    "煉丹術": (: ask_pill :),
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/boots")->wear();
  carry_object(__DIR__ "obj/hat")->wear();
  carry_object(__DIR__ "obj/sword33")->wield();
  add_money("gold", 2);
}
void die() {
  object winner = query_temp("last_damage_from");
  if (winner) {
    CHANNEL_D->do_channel(
      this_object(),
      "chat",
      winner->query("family/family_name") + "的" + winner->query("name") + "﹗打敗了所有玄武道院紫觀樓的護衛了～～\n"
    );
  }
  ::die();
}
int ask_pill() {
  object me = this_player();

  if (me->query("marks/煉丹術") < 1) {
    command("think");
    command("say $CYN$這...我不太清楚ㄝ...");
    return 1;
  }

  if (me->query("marks/煉丹術") == 1) {
    command("hmm");
    command("say $HIC$\n\n"
      "你要問煉丹術ㄚ？沒問題，我可以和你說一些有關這方面的事情。

 煉丹分「火法」與「水法」兩種。

「火法」包括：「段」，即長時間的高溫加熱

「煉」，即乾燥物質的加熱
「炙」，即局部烘
「熔」，即加熱溶解
「抽」，即蒸餾
「飛」，即昇華
「伏」，即加熱使藥物變性

「水法」包括：「化」，即溶解

「淋」，即用水溶解固體的一部份
「封」，即封閉反應物，並長時間靜置
「煮」，物質在大量熱水中加熱
「熬」，即在水中長時間加熱
「養」，即長時間低溫加熱
「澆」，即傾出溶液，讓它冷卻
「漬」，即用冷水在容器外部降溫

我有經常在研究這方面的事物，也有常常作藥給郭逸俠吃。
如果你要學的話，可以去問問看玄真君，他對醫學藥理
頗有研究，應可以教授你這方面的學問。
\n");

    me->set("marks/煉丹術", 2);
  } else
    command("say 我不是已經和你說過有關煉丹術的事情了嗎，好好加油吧！");

  return 1;
}
