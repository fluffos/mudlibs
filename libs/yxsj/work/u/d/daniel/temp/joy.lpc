// joy.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg, ob;
	int damage, ap, dp;

	if( !target ) target = offensive_target(me);

	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "sword" )
		return notify_fail("ゲ斗тр糃ㄏノ糃猭\n");

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(""HIY"贾︙伐"NOR"驹矮いㄏノ\n");

	if( !target
	||	!target->is_character()
	||	target->is_corpse()
	||	target==me)
		return notify_fail("璶癸街琁甶硂糃猭\n");

	if((int)me->query("force") < 400 )
		return notify_fail("ずぃ镑\n");

	if((int)me->query("kee") < 50 )
		return notify_fail("⊿Τ快猭Τ栋い\n");

	me->add("force", -200);
	me->receive_damage("kee", 20);

msg =  HIC "\n$N$nㄏ┄锭糃猭伐┷⌒" + HIY + " 贾 ︙ 伐" + HIC + "  \n" NOR
HIG "$N盿稬,笲癬ōずもい糃祇皗皗\n糃皗脅籖Θ胑糃\n"
HIR "┛礛丁┮Τ糃礛锣眏よ$n筁\n"
HIY "ǎ$n泊玡礚矪ぃ琌ㄓ脓糃┷ㄏΤ眏溃稰\n\n" NOR;

	message_vision(msg, me, target);
	ap = me->query_skill("sword") / 100 + 1 + me->query_skill("yangsword") / 100;
	ap = ( ap * ap * ap / 4 ) * (int)me->query("kee") / 100;
	dp = target->query_skill("dodge") / 100 + target->query("combat_exp") / 10000;
	if( (random(ap) + 1) * 4 > dp ) {
	damage = (int)target->query("force_factor") + (int)me->query_skill("sword") * 5;
	damage += random( damage / 10 );
		if (damage < 0)
			damage = 0;
		if( damage > 0 ) {
msg = HIY "$nǎ伐饼磷秨糃筐˙\n"
"$Nもい糃祇網▇糃钡$nō砰\n"
HIR "翧﹀眖承舩琕きせず " NOR "(" + HIR + damage + NOR + ")\n" NOR;
			message_vision(msg, me, target);
			target->receive_damage("kee", damage, me);
			target->receive_wound("kee", damage/3, me);
			damage = (int)target->query("max_force") / -10 + random((int)me->query("kee"));
			if (damage < 0)
				damage = 0;
			if( damage > 0 ) COMBAT_D->report_status(target);
			message_vision("\n", me, target);
msg = HIC "$N祇糃┷緇玪ゼ$N计羘\n"
"祇待玴玪$n\n"
HIR "$nぃ┋い┷窱羘翧﹀" NOR "(" + HIR + damage + NOR + ")\n" NOR;
			message_vision(msg, me, target);
			target->receive_damage("kee", damage, me);
			target->receive_wound("kee", damage, me);
		}
	} else {
		msg = HIY "$nǎΓㄏ淮\ō锣秜緑ぇ悔発秨\n" NOR;
		message_vision(msg, me, target); }

	if( damage > 0 ) COMBAT_D->report_status(target);

	if( !target->is_fighting(me) ) {
		if( living(target) ) {
			if( userp(target) ) target->fight_ob(me);
			else 				target->kill_ob(me);
		}
		me->kill_ob(target);
	}

	message_vision("\n", me, target);
	me->start_busy(2);
	return 1;
}