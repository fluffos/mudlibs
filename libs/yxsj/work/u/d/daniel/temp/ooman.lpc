inherit NPC;
int ask_dragon();
void create() {
  set_name("老伯", ({ "oldman" }));
  set("long", "他是負責清掃清掃道觀的歐吉桑。\n");
  set("gender", "男性");
  set("race", "人類");
  set("age", 70);
  set("combat_exp", 120000);
  set("max_kee", 750);
  set("max_gin", 600);
  set("max_sen", 600);
  set("max_force", 300);
  set("force", 600);
  set("force_factor", 30);
  set("warexp", 10);
  set_skill("dodge", 5);
  set_skill("parry", 10);
  set("class", "taoist");
  set_temp("apply/dodge", 30);
  set_temp("apply/sword", 30);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 30);
  set("inquiry", ([
    "信物": "你是說那顆奇怪的石頭嗎，那是一隻身上有金紋的龍給我的。\n",
    "金紋的龍": (: ask_dragon :),

  ]));


  setup();
  carry_object("/d/reason/obj/broom.lpc")->wield();
  carry_object("/obj/cloth.lpc")->wear();
}
int ask_dragon() {
  object me = this_player();

  say(CYN "老伯說道:" HIY "有一次我在打掃道觀二樓的時候，突然刮起一陣狂風，\n"
    "一隻身上帶有金紋的龍從天而降，把我嚇了一大跳，然\n"
    "後二話不說，就把我帶進了一個奇怪的房間。臨走前，\n"
    "祂給了我一顆閃著異光的石頭，不過我把它給扔了，你\n"
    "去二樓找找看吧。\n" NOR);
  me->set("marks/dragon", 1);
  return 1;
}
