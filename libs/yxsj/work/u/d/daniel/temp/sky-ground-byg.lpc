// edit by cou
#include <combat.h>
#include <ansi.h>
#include <skill_busy.h>
inherit SSERVER;

void fly_dragon(object);
int perform(object me, object target)
{
        object weapon, ob;
        int ap, dp, m_pl, m_un, m_dg, m_ff, m_ad, t_dg, t_pa, damage1, d1, time;

        string msg;

        if ( !target ) target = offensive_target(me);

        if ( me->query("class") != "taoist" )
             return notify_fail(HIC"獶ψ礚猭琁甶 ぱ   ψ  \n"NOR);

        if ( !target 
             || !target->is_character()
             || !me->is_fighting(target) )
             return notify_fail(HIM""HIR"ぱ"NOR""RED"ψ"NOR""HIR""NOR""HIM""NOR"驹矮いㄏノ\n");

        if ( me->query("force") < 300 )
                return notify_fail(HIW"ずぃ镑礚猭琁甶 ぱ   ψ  \n"NOR);

        if(!(ob=me->query_temp("weapon"))||(string)ob->query("skill_type")!="sword")
                return notify_fail(HIW"惠璶р糃ㄏノ\n"NOR);

        if ( me->query("eff_kee") < me->query("max_kee") / 10 )
                return notify_fail(HIR"竒端筁┤笲痷獽Τネ㏑繧\n"NOR);

        if((string)me->query_skill_mapped("sword")!="wo-che-sword")
                return notify_fail(HIW"Τㄏノψ糃猭ㄏノ瓳\n"NOR);

        if ( me->query_skill("sword", 1) < 60 )
             return notify_fail(HIW"膀セ糃砃ぇм\ぃì礚猭琁甶 ぱ   ψ  \n"NOR);

        if((string)me->query_skill_mapped("force")!="sky-ground-force")
                return notify_fail(HIW"ゲ斗笲ノセみ猭琁甶眔瓳\n"NOR);

        if (me->query_skill("taoism",1) < 60)
                  return notify_fail(HIW"ψタ笵ぃ镑蔼礚猭ㄏノ┷\n"NOR);

        if ( me->query_skill("wo-che-sword", 1) < 60 )
              return notify_fail(HIW"礚伐糃猭ぃ镑獼礚猭琁甶 ぱ   ψ  \n"NOR);

        if(me->query_temp("temp/performing") && userp(me))

        {
                tell_object(me,HIR"弘筁ō砰猵ぃ璽颤τ碭翧﹀\n"NOR);
                tell_room(environment(me),HIR"ǎ"+me->name()+"羪︹礛祇フ碭翧﹀ㄓ\n"NOR,me);

                me->receive_wound("kee",30);
                me->receive_wound("gin",30);
                me->receive_wound("sen",100);

                me->start_busy(1);

                return 1;
        }

        me->set_temp("temp/performing", 1);

        message_vision(

HIY"\nǎ$N礛ミ﹚ミぃ笆"NOR+HIR""NOR+HIW"ψ"YEL""HIY"み"HIC"方"HIR""HIY"笲癬ōψ玪繦ぇ竒猰乃瑈\n"NOR
HIR"箉$Nō砰て眏ψ玪繦帝瞅露︘$N矪祇杆ψ墩\n\n"NOR
HIW"$N蛮竲今"NOR+HIC""NOR+HIW"杆"HIY"ψ"MAG"˙猭"NOR+HIC""NOR+HIW"礛耻羘"NOR+HIC""HIR"ぱψ"HIC"\n\n"NOR
HIC"ǎ$Nもい籡泞绢砮揣┛礛$N㏄籈癬礚计皗脅废铭\n"NOR
HIG"$N盢ぱ杆ψぇ蹲籈Θㄨ丁祇ㄢ聋綺狙ぱψ\n"NOR

        NOR, me, target);
        m_pl = me->query_skill("wo-che-sword", 1);
        m_un = me->query_skill("sword");
        m_dg = me->query_skill("dodge");
        m_ff = me->query("force_factor",1);
        m_ad = me->query_temp("apply/damage");

        t_dg = target->query_skill("dodge",1);
        t_pa = target->query_skill("parry",1);

        ap = m_un*3 + m_pl*3 + random(m_dg)/2;
        dp = t_dg + t_pa + random(t_pa)/2;

        damage1 = ( (m_ff)*3+(m_pl)*5+(m_un)*4+(random(m_dg)/2) - ((t_pa)+random(t_dg)/2) );
        //if (damage1 > 2500) damage1 = 2450+random(50);

        if (ap > dp) 
        {
          d1 = damage1;
          message_vision(

HIM"\n$N祇┷叉も计笵ψ罽籈ΘЩψ阑"HIW"$n"HIM""HIW"$n"HIM"癶磷ぃの\n"NOR
HIC"痺泊丁ψゴ"HIW"$n"HIC"砰ず癶计环矪ψ繾癴芦陆乃ぃ\n\n"NOR
HIW"$n"HIM"礛帮翧﹀ō砰皚礹矪 . . . . . .  "HIY"("+HIR+d1+NOR+HIY+")\n"NOR
NOR"\n"NOR
            NOR, me, target);

                target->receive_damage("kee", d1,me);
                target->receive_wound("kee", (d1/3),me);
              //target->receive_damage("sen", d1,me);
              //target->receive_wound("sen", (d1),me);
                COMBAT_D->report_status(target);
                target->set_temp("last_damage_from", me);

                me->add("force", -300);
                me->start_busy(2);
                target->start_busy(0);
        }

        else
        {
                message_vision(

                  HIW"\n$n醚瘆$N┷Α$n玱琁甶淮睝往ぇ畉淮肞跟筁$N眏玪ю墩\n\n"NOR

                NOR, target);

                me->add("force", -200);
                me->start_busy(2);
                target->start_busy(0);
        }

        time = 130 - me->query_skill("wo-che-sword",1);
        if (me->query("class")=="taoist") time/=2;
        if (time < 5) time = 5;
        call_out("reaction", time, me);
        return 1;
}


void reaction(object ob)
{
        ob->delete_temp("temp/performing");
        tell_object(ob,HIC"谋弘篊篊ど!!"NOR""HIW"ㄏノ"NOR""HIM""HIR"ぱ"NOR""RED"ψ"NOR""HIR""NOR""HIM""NOR"瓳\n"NOR);
}
