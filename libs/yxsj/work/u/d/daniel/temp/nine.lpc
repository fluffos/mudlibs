// by guo

#include <ansi.h>
#include <skill_busy.h>

inherit SSERVER;

int perform(object me, object target) {
  int time;
  string msg, weapon;
  object ob, tempobj;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIY "『" HIG "天" NOR + GRN "地九" HIG "思" HIY "』" NOR "只能在戰鬥中使用﹗\n");
  if (me->query("force") < 300)
    return notify_fail("你的內力不夠﹗\n");
  if (me->query("combat_exp") < 1000000)
    return notify_fail("你的經驗不足,無法使用九思劍法﹗\n");
  if (me->query("kee") < 200)
    return notify_fail("你的身體狀況不好﹐不能使用這招！\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你需要一把劍才能使用。\n");
  if ((string)me->query_skill_mapped("sword") != "nine-sword")
    return notify_fail("只有在使用九思劍法才能使用哦。\n");
  if (me->query("marks/九思劍法") < 2)
    return notify_fail("你尚未精透九思劍法的真義，無法使出連環精義！\n");
  if (me->query_skill("sword", 1) < 160)
    return notify_fail("你的基本劍法修為不夠高無法使用此招。\n");
  if (me->query_skill("nine-sword", 1) < 160)
    return notify_fail("你的九思劍法修為不夠高無法使用此招。\n");
  if (me->query_skill("buddhism", 1) < 60)
    return notify_fail("你的大乘佛法修為不夠高無法使用此招。\n");

  if (me->query_temp("temp/performing") && userp(me)) {
    tell_object(me, HIR "你因為精力消耗過多﹐身體狀況不能負荷﹐而吐了幾口鮮血﹗\n" NOR);
    tell_room(environment(me), HIR "只見" + me->name() + "臉色突然發白﹐吐了幾口鮮血出來﹗\n" NOR, me);
    me->receive_wound("kee", random(20) + 20);
    me->receive_wound("gin", random(30) + 10);
    me->receive_wound("sen", random(30) + 15);
    me->start_busy(2);
    return 1;
  }

  //me->set_temp("temp/performing", 1);

  tempobj = me->query_temp("weapon");
  weapon = tempobj->query("name");

  msg = HIC "\n$N" HIC "由心所發大嘆一聲。\n\n" NOR;
  msg += "              「" HIC "無" NOR + CYN "色     " HIG "無" NOR + GRN "欲     " HIY "無" NOR + YEL "心     " HIM "無" NOR + MAG "念     " HIR "無" NOR + RED "魔" NOR " 」\n\n" NOR;

  msg += "                               " HIC "天" HIG "地" HIY "九" HIR "思\n\n" NOR;

  msg += HIC "只見天地間射出一道慧光直往$N" HIC "身上照，此時慧光穿過$N" HIC "身上的各穴門並由雙眼\n" NOR;
  msg += NOR "再度射出直往$N手中的" + weapon + "射去，四周黯然下去並吹起一陣微風。\n" NOR;
  msg += HIY "無意中，$N" HIY "接連發出了讓$n" HIY "措手不及的六道劍氣！！\n\n" NOR;
  message_vision(msg, me, target);

  message_vision(
    HIR "$N" HIR "以指御氣一招「" HIC "無" NOR + CYN "色" HIR "」直逼$n" HIR "右掌，颼的一聲已穿過了$n" HIR "的右掌！\n" NOR,
    me,
    target
  );
  COMBAT_D->report_status(target);
  message_vision(
    HIM "$N" HIM "以指御氣一招「" HIG "無" NOR + GRN "欲" HIM "」直逼$n" HIM "左掌，颼的一聲已穿過了$n" HIM "的左掌！\n" NOR,
    me,
    target
  );
  COMBAT_D->report_status(target);
  message_vision(
    HIB "$N" HIB "以指御氣一招「" HIY "無" NOR + YEL "心" HIB "」直逼$n" HIB "右腳，颼的一聲已穿過了$n" HIB "的右腳！\n" NOR,
    me,
    target
  );
  COMBAT_D->report_status(target);
  message_vision(
    HIG "$N" HIG "以指御氣一招「" HIM "無" NOR + MAG "念" HIG "」直逼$n" HIG "左腳，颼的一聲已穿過了$n" HIG "的左腳！\n" NOR,
    me,
    target
  );
  COMBAT_D->report_status(target);
  message_vision(
    HIC "$N" HIC "以指御氣一招「" HIR "無" NOR + RED "魔" HIC "」直逼$n" HIC "胸膛，颼的一聲已穿過了$n" HIC "的胸膛！\n" NOR,
    me,
    target
  );
  COMBAT_D->report_status(target);
  message_vision(
    HIY "$N" HIY "以指御氣並喊出「" HIB "無" NOR + BLU "佛無" HIB "思" HIY "」劍氣刷的一聲已穿入$n" HIY "各穴門，\n" NOR,
    me,
    target
  );
  message_vision(HIM "$n" HIM "大叫一聲後劍氣再由各穴門穿刺而出！\n" NOR, me, target);
  COMBAT_D->report_status(target);

  msg = CYN "\n$N" CYN "忽然消失在地平面上，而空中出現了耀眼光芒。$n" CYN "無意的瞧上一眼，\n" NOR;
  msg += HIC "卻看不清楚哪發光物是啥？只聽見上方傳來一句" HIM "『" HIY "照" NOR + YEL "普" HIY "光" HIM "』" HIC "！$N" HIC "落地之後再度\n" NOR;
  msg += NOR "疾然躍起，手中" + weapon + "順勢而起，在空中轉了兩圈半直直地斬向$n！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->report_status(target);

  msg = HIG "\n$N再度發招，手中" + weapon + HIG "無回頭之勢使出了" HIM "『" HIR "佛" NOR + RED "現魔" HIR "滅" HIM "』" HIG "，手中" + weapon + "\n" NOR;
  msg += GRN "如獲生命般地直往$n" GRN "腦門前鑽，$n" GRN "經不起這一擊被震飛了數十丈！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->report_status(target);

  msg = "\n在$n還沒落地前，$N已衝到了$n面前喊道" HIM "『" HIC "九" NOR + CYN "思歸" HIC "一" HIM "』" NOR "，說完\n" NOR;
  msg += weapon + "便貫穿$n，射出了無數劍氣從$n身後暴出。此時$N雙掌\n" NOR;
  msg += "再度合十聚力，一推掌人劍合而為一，只見咻的一聲$N已穿過$n的胸膛，\n" NOR;
  msg += "出現在$n身後口唸：「亦佛即無魔，亦魔即無佛，阿彌陀佛」\n" NOR;
  msg += "$N念完後$n隨即無力，直直往地上倒了下去。\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->report_status(target);

  message_vision("\n$N在$n身上共烙下了" HIR "(" HIY "3000" HIR ")" NOR "的傷害\n\n" NOR, me, target);

  time = 13;
  call_out("reaction", time, me);
  return 1;
}

void reaction(object ob) {
  if (ob) {
    ob->delete_temp("temp/performing");
    tell_object(
      ob,
      HIC "你覺的精氣慢慢回升了！！" NOR "" HIW "你可以使用" NOR "" HIM "『" HIG "天" NOR + GRN "地九" HIG "思" HIM "』" NOR "哦。\n" NOR
    );
  }
}
