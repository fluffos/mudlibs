// smoke-move.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg;
  int damage, ap, a2p, mp, dp, tsu;
  object ob;

  if (!target) target = me;

  if (me->query_skill("spells") < 30)
    return notify_fail("你還沒學會這咒術﹗\n");

  if (me->is_fighting())
    return notify_fail("你在戰鬥中,請先離開,再使用這咒術﹗\n");

  if (me->query_temp("PkIng"))
    return notify_fail("在 PK 中不能勞跑﹗\n");

  if ((int)me->query("mana") < 50)
    return notify_fail("你的法力不夠﹗\n");

  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神沒有辦法有效集中﹗\n");

  if (target->query("board_id") == "taoist_b" && me->query("marks/道祖") == 1)
    tsu = 1;
  else
    tsu = 0;

  me->add("mana", -50);
  me->receive_damage("sen", 30);

  if (random(me->query("max_mana")) < 50) {
    write("你失敗了。\n");
    return 1;
  }

  msg = HIW "$N大喝一聲「奇門遁甲」﹗口中唸唸有辭﹐忽地一陣濃霧起來﹐頓時濃霧四起、風雲遮天﹗\n\n" NOR;
  if (tsu == 1)
    msg += HIY "$N眼前的" + target->query("name") + HIY + "忽然發出閃閃金光，籠罩著$N的全身！\n";
  message_vision(msg, me);
  ap = me->query_skill("spells");
  mp = me->query("max_mana");
  if (random(mp * ap) > (ap * 50)) {
    msg = HIC "只見一陣濃霧過後﹐$N已消失不見了。\n" NOR;
    message_vision(msg, me);
    if (me->query("class") == "taoist") {
      if (tsu == 1)
        me->move("/d/reason/tsu/m1.lpc");
      else
        me->move("/d/reason/house1.lpc");
      tell_room(environment(me),
        "忽然飄起一陣濃霧﹐濃霧過後﹐" + (string)me->query("name") + "突然出現" + "在你眼前。\n", me);
      if (tsu == 1)
        tell_object(me, HIY "由於奇門五行之術和道教總壇的法力幫助，頓時你來到道祖所居住的仙境。\n" NOR);
      else
        tell_object(me, HIY "由於奇門五行之術，頓時你來到道教的入口處。\n" NOR);
    }
    me->improve_skill("spells", 1);
  } else {
    msg = HIY "濃霧過後﹐只見$N仍呆呆的佇立在原地。\n" NOR;
    message_vision(msg, me);
  }
  if (target != me) me->start_busy(2);
  return 1;
}
