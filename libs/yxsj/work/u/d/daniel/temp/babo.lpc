inherit COMBINED_ITEM;
int decayed;
 
void create()
{
	set_name("腳",({"pill"}));
	set("long",
"硂琌聋き眒闯你腳κ媚ぇいぃ癬泊沮弧狝ノ
ぇ祔稬搭淮痟骋\n");
	set("value", 1200);
	set("unit", "帮");
	set("base_unit", "采");
        set("base_weight", 300);
	set_amount(1);
        if( clonep(this_object()) ) call_out("decay", 50, 1);
}
void init()
{
	add_action("do_eat","eat");
}
int do_eat(string arg)
{
	object ob,me=this_player();

	if (me->is_busy()) return notify_fail("瞷⊿Τ硂\n");
	if (!arg) return notify_fail("璶ぐ或?\n");
	if (!ob = present(lower_case(arg),me)) return notify_fail("ō⊿硂狥﹁\n");
	if (ob != this_object()) return 0;
	me->start_busy(1);

	// 干
	if((int)me->query("max_kee") < 200)
	{
		me->receive_heal("kee", 200);
		me->receive_curing("kee", 200);
	}
	else
	{
		me->receive_heal("kee", (int)me->query("max_kee")/20);
		me->receive_curing("kee", (int)me->query("max_kee")/20);
	}

	//干ず
	if((me->query("force") + me->query("max_force")/5) >= me->query("max_force")*2)
		me->set("force", me->query("max_force")*2);
	else me->add("force", me->query("max_force")/5);
 
	message_vision("$N癬采媚い\n",me);
	write("谋眔弘κ纄ぃ氨瑈笆帝\n");
	add_amount(-1);
	return 1;
}
void decay(int phase)
{
        decayed = phase;
        switch(phase) {
                case 1:
                        message_vision( query("name") + "秨﹍籊年祇螟籇笵\n", this_player() );
                        set("long", "硂聋媚陪礛竒暗Τ琿丁タ床祇帝螟籇笵\n");
                        call_out("decay", 10, phase + 1); 
                        break;
                case 2:
                        message_vision( "皚筁р" + query("name") + "てΘη床\n", this_player() );
                        destruct(this_object());
                        break;
        }
}
