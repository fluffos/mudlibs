#include <armor.h>
#include <command.h>
int chest_found = 0;
inherit NPC;
void create() {
  object ob;
  set_name("道童", ({ "boy" }));
  set("long", "他是一位小童﹐在此清掃。\n");
  set("gender", "男性");
  set("race", "人類");
  set("age", 14);
  set("combat_exp", 1200);
  set("max_kee", 750);
  set("max_gin", 600);
  set("max_sen", 600);
  set("max_force", 300);
  set("force", 600);
  set("force_factor", 30);
  set("warexp", 10);
  set_skill("dodge", 5);
  set_skill("parry", 10);
  set("class", "taoist");
  set_temp("apply/dodge", 30);
  set_temp("apply/sword", 30);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 30);
  set("chat_chance", 4);
  set("chat_msg", ({
    (: command, "east" :),
    (: command, "west" :),
  }));
  set("inquiry", ([
    "信物": "這個你要問一個老伯，他可能會知道。\n",
    "老伯": "上次有人看到他在『翠竹林道』掃地，你去那邊找找吧。\n",
    "翠竹林道": "我沒去過耶，抱歉！不過我聽說在道觀的西北方有一片竹林。\n",

  ]));


  setup();
  carry_object("/d/reason/obj/broom.lpc")->wield();
  carry_object("/obj/cloth.lpc")->wear();
}
int accept_object(object who, object ob) {

  if (ob->id("blue stone")) {
    command("consider");
    command("giggle");
    command("say 嗯，老伯答允你了哦，那你可以進去囉。\n");
    command("addoil");
    who->set_temp("marks/可以進入", 1);
    return 1;
  }
}
