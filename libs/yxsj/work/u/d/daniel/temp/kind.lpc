// Modify by Oyes
#include <ansi.h>
inherit NPC;
string ask_me(object who);
void do_power();
void create()
{
        set_name("疵", ({ "offin kind", "kind" }) );
        set("title", "炊硄κ﹎");
        set("gender", "╧┦" );
        set_weight(123456789);
        set("age", 26);
        set("str", 29);
        set("cor", 30);
        set("cps", 30);
        set("int", 11);
        set("long",
                "琌硂︘め琌┣鞭ヱ⊿笵羆琌暗裕\n"
                "猌美ぃ畓玱ぃ畍┯︙矪ぃ筁羆谋眔钩玡猌狶い\n"
                "臸繷ぃ筁灿杆шぃび钩\n");
        set("combat_exp", 4000);
        set("attitude", "friendly");
        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
                "疵弧笵讽и琌街幢ㄓ蓟偿\n",
                "疵弧笵稱и绑绑........硈и硂炊硄κ﹎常Μ珺\n",
                "疵┛礛ㄏΑ┷计弘琌ゴい硚┛礛钩琌稱癬ぐ或ΓΜ┷\n",
                "疵弧笵еǐさぱ那㏑碞衡и块罢....\n"
        }) );
        set("inquiry", ([
                "碍疵": (: ask_me :),
                "硚": (: ask_me :)
        ]) );
        set("chat_chance", 30);
        set("chat_msg", ({
                (: command, "hmm" :),
                (: command, "say" :),
                (: command, "think" :)
 
        }) );
        set_skill("parry", 10);
        set_skill("dodge", 10);
        set_skill("unarmed", 25);
        setup();
        carry_object("/obj/cloth")->wear();
}
void init()
{
        if (query("ask_id")) if (query("ask_id")!=this_player()->query("id")) return;
        ::init();
}
string ask_me(object who)
{
        object *ob;
        int i;
        who=this_player();
        if(query("marks/量筁")) return "琂礛笵иōださらヰ稱㏑\n";
        who->set("marks/量筁", 1);
        if( who->query("marks/量筁") ) {
                if( is_killing(who) ) return "琂礛笵иōださらヰ稱㏑\n";
                else{
                        kill_ob(who);
                        who->kill_ob(this_object());
        set_temp("apply/attack", 100);
        set_temp("apply/dodge", 100);
        set_temp("apply/parry", 100);
        set_temp("apply/armor", 100);
        set_temp("apply/damage", 100);

        set_skill("move", 100);
        set_skill("dodge", 100);
        set_skill("blade", 100);
        set_skill("parry", 100);
        set_skill("unarmed", 100);
        set_skill("iceforce", 120);
        set_skill("force", 120);

        map_skill("force", "iceforce");

        set("max_kee", 10000);
        set("max_sen", 10000);
        set("max_gin", 10000);
        set("eff_kee", 10000);
        set("eff_sen", 10000);
        set("eff_gin", 10000);
        set("kee", 10000);
        set("sen", 10000);
        set("gin", 10000);
        set("max_force", 2500);
        set("force", 10000);
        set("force_factor", 10);
        set("warexp",50) ;
        set_name("碍疵", ({ "offin kind", "kind" }) );
        set("title", "硚");
        set("nickname", HIR"窾碿臸繷"NOR);
        set("long",
                "讽碿疵妓繷芵ㄓ讽皋钵泊氟ぃ甮炳..\n");
 
        message("system",
                HIB "\n\n碍疵皚笵\n"
                HIY"\n糑糑糑.....彪ぱ硂ρ╮苆澈礛т癸и碞琵ǎ醚碍疵痷タ龟罢\n\n"NOR
               HIG""+ this_player()->name() +HIR"ㄓ璶┣碞┣彪ぱê╮苆\n\n"NOR,
                users());

        message("vision",
                HIY"碍疵耻笵ρ跟彪ぱ旅纒瞷玂盞㏑㏑ㄓ\n"
                "碍疵礛ǜ﹀ぃ猤┷计弘℉瞨欢㎝虏璝ㄢ\n"NOR,
                environment(), this_object() );
        set("pursuer", 1);
        set_leader(who);

        set("attitude", "aggressive");
        set("vendetta/authority", 1);

        set("chat_chance", 30);
        set("chat_msg", ({
                (: command, "hehe" :),
                (: command, "angry" :),
                (: command, "pk" :),
                (: random_move :)
        }) );

        set("chat_chance_combat", 5);
        set("chat_msg_combat", 
        ({
                (: command, "say " :),
                (: command, "say ρ﹚璶р遏" :),
                (: command, "unwield blade" :),
                (: do_power :),
                (: command, "wield blade" :),
                (: command, "exert recover" :),
                (: do_power:),
        }) );
        set("default_actions", (: call_other, __FILE__,"query_action" :));
        reset_action();
        set("bellicosity", 30000);
        set("combat_exp", 450000);
        set("pursuer", 1);
        set("marks/量筁", 1);
 
        ob = all_inventory(environment());
        for(i=sizeof(ob)-1; i>=0; i--) {
                if (environment(this_object())->query("no_fight")) break;
                if( !userp(ob[i]) || ob[i]==this_object() ) continue;
                kill_ob(ob[i]);
                ob[i]->fight(this_object());
        }
        if (environment(this_object())->query("no_fight")){
           kill_ob(who);
           command("follow "+who->query("id"));
           set("ask_id",who->query("id"));
           set("bellicosity", 0);
           set("combat_exp", 100000);
        }
        carry_object("/d/snow/npc/obj/blade_book");
        if (!find_object("/d/snow/npc/obj/ghostblade"))
            carry_object("/d/snow/npc/obj/ghostblade")->wield();
        else carry_object("/d/snow/obj/blade")->wield();
//        carry_object("/obj/cloth")->wear();
        carry_object("/d/snow/npc/obj/snow-lan")->set_amount(50+random(10));
 
       return "㏑ㄓ";
        }
}
}
mapping *action = ({
/*([  "action" :  "$N磝い笲繩礛┷ま耴炳禜ǎ刮档︹玪パ磝い癸非$n$l阑",
                "dodge"     :   60,
                "parry"     :   50,
                "damage"    :  280,
                "force"     :  280,
                "damage_type":   "睯端",
   ]),*/
//эΘ疭/
([  "action" :  "$N磝い笲繩礛┷"HIR"合格"NOR"ǎ兵档眖$n竲甮",
                "dodge"     :   60,
                "parry"     :   50,
                "damage"    :  300,
                "force"     :  300,
                "damage_type":   "睯端",
   ]),
  });
mapping query_action()
{
     return action[random(sizeof(action))];
}
void die()
{
      if (this_object()->query("marks/量筁"))
       {
        object winner = query_temp("last_damage_from");
        if (winner)
        {
        message("system",HIB"\n\n环よ肚ㄓ碍疵礹璚玸纙\n\n"NOR
        HIM"\摆糉甡 "HIY+ winner->name() + HIM"狦礛Τㄓ菌 \n\n"NOR
        HIR"\摆ぃヌみ穨硚艶浮い厨こ﹀摆\n"NOR,users()) ;
        }
       }
        :: die();
}
void do_power()
{
        object me=this_object();
        object target=me->query_temp("last_opponent");
        int
damage=random(500)+200+this_object()->query("str")*3;
        if (target->query("combat_exp")>10000)
      {
message_vision(HIG"\n$Nも磝绢羭拈羥ōぃ╄咀墩侥ㄓ°°\n"NOR,me);
message_vision(NOR+GRN"ǎ$N阁˙臘礛虫磝は糀焚皚パㄤ$N芦㏄ぇ獹\n"NOR,me);
message_vision(HIW"$N礛ㄏ"HIY""HIB"ま"NOR+BLU"耴炳"HIB"禜"HIY""HIW"ぇ眫荡炳┷$n阑\n"NOR,me,target);
message_vision(HIR"ǎ▇い獹﹀紇$nōい荡┷耞絬哄"NOR+RED"("HIR+damage+NOR+RED")\n"NOR,me,target);

        target->receive_damage("kee",damage);
        target->receive_wound("kee",damage/3);
        COMBAT_D->report_status(target);
      }
}
