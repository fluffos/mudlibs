// hsien.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg, head;
  int damage, ap, a2p, mp, dp, count;

  if (!target) target = offensive_target(me);

  if (me->query_skill("spells") < 80)
    return notify_fail("你咒術還沒學會這道術﹗\n");

  if (!target
    || target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要對什麼施展這個道術﹖\n");
  //      if ( wizardp(me) )
  //        printf("%s\n",target->query("armor_type") );

  if ((target->query("armor_type") != "armor")
    && (target->query("skill_type") != "sword")
    && (target->query("skill_type") != "unarmed")
    && (target->query("skill_type") != "axe")
    && (target->query("skill_type") != "archery")
    && (target->query("armor_type") != "surcoat")
    && (target->query("armor_type") != "hands")
    && (target->query("armor_type") != "leggings")
    && (target->query("armor_type") != "head")
    && (target->query("armor_type") != "neck")
    && (target->query("armor_type") != "finger")
    && (target->query("armor_type") != "cloth")
    && (target->query("armor_type") != "waist")
    && (target->query("armor_type") != "boots")
    && (target->query("armor_type") != "ring")
    && (target->query("armor_type") != "mask")
    && (target->query("armor_type") != "locks")
    && (target->query("armor_type") != "robe")
    && (target->query("armor_type") != "wrists")
    && (target->query("armor_type") != "shield"))
    return notify_fail("這東西不合用法術。\n");

  if (target->query("make_armor"))
    return notify_fail("這防具已被法力精鍊過了。\n");

  if (target->query("equipped"))
    return notify_fail("你正在使用這個防具﹐無法對它使用法術。\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神沒有辦法集中﹗\n");

  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不夠﹗\n");

  me->add("mana", -50);
  me->receive_damage("sen", 30);

  if (random(me->query("max_mana")) < 100) {
    write("你法術失敗了。\n");
    return 1;
  }

  message_vision(
    HIY "$N照道術奧義，口中喃喃自語，雙手在空中比劃一般揮舞著！\n"
    HIC "此時，$N大喝一聲：" HIW "「天靈仙術」" NOR " \n\n"
    HIR "頓時，天空一道光茫射入$n裡，$n霎那之間發出陣陣光茫！！\n"
    NOR, me, target);
  ap = me->query_skill("spells");
  mp = me->query("max_mana");
  if (random(mp) > 200) {
    message_vision(HIY + "$N將$n" + HIY + "經道術化後，陣陣光茫迴盪。\n" + NOR, me, target);
    target->set("name", HIC + "Ψ" + target->query("name") + NOR);

    target->set("armor_prop/armor",
      target->query("armor_prop/armor") + ap / 25);
    target->set("armor_prop/dodge",
      target->query("armor_prop/dodge") + ap / 30);
    target->set("armor_prop/spells",
      target->query("armor_prop/spells") + ap / 25);
    target->set("weapon_prop/spells",
      target->query("weapon_prop/spells") + ap / 25);
    target->set("weapon_prop/parry",
      target->query("weapon_prop/parry") + ap / 25);
    target->set("weapon_prop/axe",
      target->query("weapon_prop/axe") + ap / 20 + 30);
    target->set("weapon_prop/unarmed",
      target->query("weapon_prop/unarmed") + ap / 20 + 30);
    target->set("weapon_prop/bow",
      target->query("weapon_prop/archery") + ap / 20 + 30);
    target->set("weapon_prop/sword",
      target->query("weapon_prop/sword") + ap / 20 + 30);
    target->set("no_drop", 1);
    target->set("make_armor", 1);
    me->improve_skill("spells", 1, 1);
    if (count >= 10) me->delete_temp("armoring_count");
    else me->add_temp("armoring_count", 1);
  } else {
    message_vision(HIG + "$N施法過度， $n" + HIG + "竟被光茫燒盡。\n" + NOR, me, target);
    destruct(target);
  }
  return 1;
}
