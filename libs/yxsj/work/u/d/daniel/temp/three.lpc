//test by lulu // タ&&穝糤 by killiom
#include <ansi.h>
#include <skill_busy.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int m_att, t_def, damage, damage2, damage3, t_ar, check, time;
        object ob;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIY""HIC"硈"NOR+CYN"吏せ"HIC"Α"HIY""NOR"驹矮いㄏノ\n");
        if( me->query("force") < 300 )
                return notify_fail("ずぃ镑\n");
        if( me->query("combat_exp") < 600000 )
                return notify_fail("竒喷ぃì,礚猭ㄏノ糃猭\n");
        if( me->query("kee") < 200 )
                return notify_fail("ō砰猵ぃぃㄏノ硂┷\n");
        if(!(ob=me->query_temp("weapon"))||(string)ob->query("skill_type")!="sword")
                return notify_fail("惠璶р糃ㄏノ\n");
        if((string)me->query_skill_mapped("sword")!="nine-sword")
                return notify_fail("Τㄏノ糃猭ㄏノ瓳\n");
        if (me->query("marks/糃猭") < 2 )
                return notify_fail("﹟ゼ弘硓糃猭痷竡礚猭ㄏ硈吏弘竡\n");
        if (me->query_skill("sword",1) < 100)
                  return notify_fail("膀セ糃猭ぃ镑蔼礚猭ㄏノ┷\n");
        if (me->query_skill("nine-sword",1) < 100)
                  return notify_fail("糃猭ぃ镑蔼礚猭ㄏノ┷\n");

        if(me->query_temp("temp/performing") && userp(me))
        {
                tell_object(me,HIR"弘筁ō砰猵ぃ璽颤τ碭翧﹀\n"NOR);
                tell_room(environment(me),HIR"ǎ"+me->name()+"羪︹礛祇フ碭翧﹀ㄓ\n"NOR,me);
                me->receive_wound("kee",random(20)+20);
                me->receive_wound("gin",random(30)+10);
                me->receive_wound("sen",random(30)+15);
                me->start_busy(2);
                return 1;
        }

        m_att = ( ( me->query_skill("sword") ) * 2 + ( me->query_skill("nine-sword", 1) ) *2 );
        t_def = ( ( target->query_skill("dodge") ) * 1.5 + target->query_skill("parry", 1) );
           damage = (me->query_skill("sword",1)*1 + me->query_skill("nine-sword", 1)*1.5 + (me->query("force_factor"))*3 - random(t_def/10));      
           damage2 = damage/2 + damage/3 + random(m_att/10);
           damage3 = (damage2)/2+(m_att/2)+random(50);
        if(target->query("combat_exp")*3 > (int)me->query("combat_exp")*4){
        damage -= 200 + random(150);
        damage2 -= 200 + random(100);
        damage3 -= 200 + random(200);
         }// add by killiom
        if(me->query("kee") < (int)me->query("max_kee")/4){
        damage -= damage/2;
        damage2 -= damage2/2;
        damage3 -= damage3/2;
        } //add by killiom

        me->set_temp("temp/performing", 1);

        msg = HIM"\nǎ$N絯ō钠癬窾驰笵"YEL"みいΤ臸︱Θ臸みいΤ︱臸ョ琌︱"HIM"\n"NOR;
        msg+= MAG"$N锣矗もい糃陆乃癹臂ぇ墩锣$n炳箉ぇ丁ぱ穞租竣瞒\n"NOR;
        msg+= WHT"\n$N驰"HIW"糃﹚て酚╯地礚蛮"NOR+WHT"\n"NOR;
        message_vision(msg,me,target);
        if ( m_att + m_att/2 + random(m_att)/2 >= (t_def)/2 + random(t_def)/2 )
        {
//           damage = (me->query_skill("sword",1)*1 + me->query_skill("nine-sword", 1)*1.5 + (me->query("force_factor"))*3 - random(t_def/10));
//           damage2 = damage/2 + damage/3 + random(m_att/10);
//           damage3 = (damage2)/2+(m_att/2)+random(50);

           me->add("force",-100);
           me->receive_damage("kee", 50);
           message_vision(HIY+"\n$N锣糃Α"NOR+YEL"├礚睵"HIY"瑅叉舩荷糀窾辟糃蝗耞荡$n"HIM"("HIY+damage+NOR+MAG")\n"NOR, me, target);
           COMBAT_D->report_status(target);
       target->set_temp("last_damage_from", me);
           target->receive_damage("kee", damage);
           target->receive_wound("kee", damage);
           me->start_busy(2);

           if ( m_att + m_att/2 +random(m_att)/2 >= (t_def)/2 + random(t_def)/2 + 25 )
           {
            message_vision(HIC+"\n$N钡糃羇铬︓$nぱ蔼"NOR+CYN"礚"HIC"肚甮糃购$n"HIR""HIM"("HIY+damage2+NOR+MAG")\n"NOR, me, target);
            COMBAT_D->report_status(target);
         target->set_temp("last_damage_from", me);
            me->add("force",-100);
            target->receive_damage("kee", damage2,me);
            target->receive_wound("kee", damage2,me);
           }
           if ( m_att + m_att/2 +random(m_att)/2 >= (t_def)/2 + random(t_def)/2 + 60 )
           {
            message_vision(HIR+"\n$N揣阑ぱ艶腳郴ま┮Τ肩"NOR+RED"跑"HIR"ほΘ糃纒糞阑$n"HIM"("HIY+damage3+NOR+MAG")\n"NOR, me, target);
            COMBAT_D->report_status(target);
         target->set_temp("last_damage_from", me);
            me->add("force",-150);
            target->receive_damage("kee", damage3,me);
            target->receive_wound("kee", damage3,me);//эby killiom 
           }
        }
        else
        {
           me->receive_damage("kee",10);
           me->add("kee",-150);
           message_vision(
           HIY+"$N谋﹀陆撮いごゎぃ︘翧﹀函癶碭˙"HIR"("HIY+damage2+NOR+RED")\n\n"
           NOR,target);
           target->receive_damage("kee", damage2);
           me->start_busy(2);
        }

         time = 11;
         call_out("reaction", time, me);
         return 1;
}

void reaction(object ob)
{
if(ob)
{
        ob->delete_temp("temp/performing");
        tell_object(ob,HIW"谋ア弘確ㄇ\n"NOR);
}
}
