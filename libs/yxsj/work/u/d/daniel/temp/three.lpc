//test by lulu // 修正&&新增 by killiom
#include <ansi.h>
#include <skill_busy.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int m_att, t_def, damage, damage2, damage3, t_ar, check, time;
  object ob;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIY "『" HIC "連" NOR + CYN "環六" HIC "式" HIY "』" NOR "只能在戰鬥中使用﹗\n");
  if (me->query("force") < 300)
    return notify_fail("你的內力不夠﹗\n");
  if (me->query("combat_exp") < 600000)
    return notify_fail("你的經驗不足,無法使用九思劍法﹗\n");
  if (me->query("kee") < 200)
    return notify_fail("你的身體狀況不好﹐不能使用這招！\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你需要一把劍才能使用。\n");
  if ((string)me->query_skill_mapped("sword") != "nine-sword")
    return notify_fail("只有在使用九思劍法才能使用哦。\n");
  if (me->query("marks/九思劍法") < 2)
    return notify_fail("你尚未精透九思劍法的真義，無法使出連環精義！\n");
  if (me->query_skill("sword", 1) < 100)
    return notify_fail("你的基本劍法修為不夠高無法使用此招。\n");
  if (me->query_skill("nine-sword", 1) < 100)
    return notify_fail("你的九思劍法修為不夠高無法使用此招。\n");

  if (me->query_temp("temp/performing") && userp(me)) {
    tell_object(me, HIR "你因為精力消耗過多﹐身體狀況不能負荷﹐而吐了幾口鮮血﹗\n" NOR);
    tell_room(environment(me), HIR "只見" + me->name() + "臉色突然發白﹐吐了幾口鮮血出來﹗\n" NOR, me);
    me->receive_wound("kee", random(20) + 20);
    me->receive_wound("gin", random(30) + 10);
    me->receive_wound("sen", random(30) + 15);
    me->start_busy(2);
    return 1;
  }

  m_att = ((me->query_skill("sword")) * 2 + (me->query_skill("nine-sword", 1)) * 2);
  t_def = ((target->query_skill("dodge")) * 1.5 + target->query_skill("parry", 1));
  damage = (me->query_skill(
    "sword",
    1
  ) * 1 + me->query_skill(
    "nine-sword",
    1
  ) * 1.5 + (me->query("force_factor")) * 3 - random(t_def / 10));
  damage2 = damage / 2 + damage / 3 + random(m_att / 10);
  damage3 = (damage2) / 2 + (m_att / 2) + random(50);
  if (target->query("combat_exp") * 3 > (int)me->query("combat_exp") * 4) {
    damage -= 200 + random(150);
    damage2 -= 200 + random(100);
    damage3 -= 200 + random(200);
  }  // add by killiom
  if (me->query("kee") < (int)me->query("max_kee") / 4) {
    damage -= damage / 2;
    damage2 -= damage2 / 2;
    damage3 -= damage3 / 2;
  }  //add by killiom

  me->set_temp("temp/performing", 1);

  msg = HIM "\n只見$N緩身飄起，氣宇萬千喊道：「" YEL "心中有魔，佛也成魔。心中有佛，魔亦是佛。" HIM "」\n" NOR;
  msg += MAG "$N轉提手中利劍，以翻騰迴旋之勢，轉向$n殺去，頓時之間天昏地暗，光逤縈離！\n" NOR;
  msg += WHT "\n$N大喊：「" HIW "九思劍，氣定神合一，化照大千，究華無雙！" NOR + WHT "」\n" NOR;
  message_vision(msg, me, target);
  if (m_att + m_att / 2 + random(m_att) / 2 >= (t_def) / 2 + random(t_def) / 2) {
    //           damage = (me->query_skill("sword",1)*1 + me->query_skill("nine-sword", 1)*1.5 + (me->query("force_factor"))*3 - random(t_def/10));
    //           damage2 = damage/2 + damage/3 + random(m_att/10);
    //           damage3 = (damage2)/2+(m_att/2)+random(50);

    me->add("force", -100);
    me->receive_damage("kee", 50);
    message_vision(
      HIY + "\n$N低轉劍式，「" NOR + YEL "一念無涯" HIY "」洋脫灑盡，千劈萬斬劍刀銀光，斷絕了$n的氣息！" HIM "(" HIY + damage + NOR + MAG ")\n" NOR,
      me,
      target
    );
    COMBAT_D->report_status(target);
    target->set_temp("last_damage_from", me);
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage);
    me->start_busy(2);

    if (m_att + m_att / 2 + random(m_att) / 2 >= (t_def) / 2 + random(t_def) / 2 + 25) {
      message_vision(
        HIC + "\n$N接回飛劍，縱跳至$n半天高，以「" NOR + CYN "九思無垠" HIC "」傳射一股劍氣尖劃向$n" HIR "﹗" HIM "(" HIY + damage2 + NOR + MAG ")\n" NOR,
        me,
        target
      );
      COMBAT_D->report_status(target);
      target->set_temp("last_damage_from", me);
      me->add("force", -100);
      target->receive_damage("kee", damage2, me);
      target->receive_wound("kee", damage2, me);
    }
    if (m_att + m_att / 2 + random(m_att) / 2 >= (t_def) / 2 + random(t_def) / 2 + 60) {
      message_vision(
        HIR + "\n$N揮擊天靈寶頂，引出所有潛能，「" NOR + RED "九思變" HIR "」一出幻成劍龍，長吼嘯擊向$n﹗" HIM "(" HIY + damage3 + NOR + MAG ")\n" NOR,
        me,
        target
      );
      COMBAT_D->report_status(target);
      target->set_temp("last_damage_from", me);
      me->add("force", -150);
      target->receive_damage("kee", damage3, me);
      target->receive_wound("kee", damage3, me);  //修改by killiom 
    }
  } else {
    me->receive_damage("kee", 10);
    me->add("kee", -150);
    message_vision(
      HIY + "$N只覺一股氣血翻湧，口中仍止不住鮮血滲出，向後退了幾步！" HIR "(" HIY + damage2 + NOR + RED ")\n\n"
      NOR, target);
    target->receive_damage("kee", damage2);
    me->start_busy(2);
  }

  time = 11;
  call_out("reaction", time, me);
  return 1;
}

void reaction(object ob) {
  if (ob) {
    ob->delete_temp("temp/performing");
    tell_object(ob, HIW "你覺的失去的精力恢復了一些。\n" NOR);
  }
}
