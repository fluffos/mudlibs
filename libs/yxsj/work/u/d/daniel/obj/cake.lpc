// lunchbox.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(HIR "生" HIC "日" HIG "大" HIM "蛋" HIY "糕" NOR, ({ "super cake", "super", "cake" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一個有十層樓高的超級大蛋糕，是Guo專門為Cou作的ㄛ！\n" HIR "祝Cou生日快樂！！\n" NOR);
    set("unit", "座");
    set("value", 50);
    set("food_remaining", 10);
    set("food_supply", 100);
  }
}
