// TASM.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("驹は磨紆", ({ "Tomahawk Anti-Ship Missile","TASM","tomahawk","missile","SSM","anti-ship" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
"驹は磨紆琌瓣ヘ玡甮祘程环は磨紆\n"
"ウ琌驹紆は磨甮祘伐环眏\n"
"琌差磨ぃ┪猌竟\n");
		set("unit", "ㄇ");
		set("base_unit", "猅");
		set("base_weight", 1500);
		set("base_value", 300000);
		set("value", 3000000);
		set("wield_msg", "$N盢$n恶祇甮╰参暗祇甮非称\n");
		set("unwield_msg", "$N盢$n︑祇甮╰参い更\n");
	}
	set_amount(10);
	init_throwing(10000);
	setup();
}
int query_autoload() { return 1; }
