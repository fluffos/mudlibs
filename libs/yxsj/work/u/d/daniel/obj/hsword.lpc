// 道祖之信物－道心劍
// Edited by Army
// modified from 神刀門之冰刀

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  object me;
  string na;

  me = this_player();
  na = (me->name(0));

  if (me)
    set_name(na + "的" HIC "道" NOR + CYN "心" HIW "劍" NOR, ({ "tao-sword", "sword" }));
  else
    set_name(HIC "道" NOR + CYN "心" HIW "劍" NOR, ({ "sword" }));

  set_weight(1000);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "這是道教-道祖門人的信物。\n"
      "這劍身上刻著幾句真言，似乎可以念(speak)看看？\n");
    set("no_auc", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_pawn", 1);
    set("wield_msg", "$N從腰間的劍鞘拔出$n握在手中﹗\n");
    set("unwield_msg", "$N將手中的$n收回腰間的劍鞘裡。\n");
    set("material", "gold");
  }

  init_sword(0, SECONDARY);
  set("weapon_prop/sword", 5);
  set("weapon_prop/spells", 7);
  setup();
}

int query_autoload() {
  object me = this_player();

  if (me->query("class") != "taoist")
    return 0;

  return 1;
}

void init() {
  add_action("do_speak", "speak");
}

int do_speak() {
  object me = this_player();
  object ob = this_object();
  string room, str1, str2, str3;
  room = file_name(environment(me));
  sscanf(room, "/%s/%s/%s", str1, str2, str3);
  if ((str1 == "d" && str2 == "ghost" && str3 == "kill") || (str1 == "d" && str2 == "pkroom" && str3 == "fight")) {
    tell_object(me, "你不可以在這種地方使用道心劍唷。\n");
    return 1;
  } else {
    if (me->is_fighting())
      return notify_fail("你在戰鬥中,請先離開,再使用﹗\n");
    if (me->query("marks/道祖") != 1)
      return notify_fail("你沒拜道祖，你不能使用這把劍！\n");

    tell_object(me, BBLU + HIW "你念著『大道無形　生育天地　大道無情　運行日月‧‧』，化一股光芒離去。" NOR "\n");
    message_vision(HIC "$N舉起手中道心劍，喃喃地念了幾句，忽然化成道光芒往外逝去！" NOR "\n", me);
    me->move("/d/reason/tsu/m1.lpc");
    message_vision(BYEL + HIW "一道強光由外射入，只見$N從光影中走了出來。" NOR "\n", me);
  }
  return 1;
}
