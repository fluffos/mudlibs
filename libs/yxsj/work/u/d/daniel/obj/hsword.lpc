#include <ansi.h> 
#include <weapon.h>

inherit SWORD;

void create()
{
        object me;
    string na;

        me = this_player();
        na = (me->name(0));

        if(me)
                set_name(na+""HIC"笵"NOR+CYN"み"HIW"糃"NOR, ({ "tao-sword","sword" }));
        else
                set_name(HIC"笵"NOR+CYN"み"HIW"糃"NOR, ({ "sword" }));

        set_weight(1000);

        if( clonep() )
                set_default_object(__FILE__);
        else
        {
                set("unit", "琡");
                set("long","硂琌笵毙-笵獺\n"
                           "硂糃ōㄨ帝碭痷ē├(speak)\n");
                set("no_auc",1);
                set("no_put",1);
                set("no_give",1);
                set("no_drop",1);
                set("no_sell",1);
                set("no_pawn",1);
                set("wield_msg","$N眖竬丁糃繲┺$n搐もい\n");
                set("unwield_msg","$N盢もい$nΜ竬丁糃繲柑\n");
                set("material", "gold");              
       }

        init_sword(0, SECONDARY);
        set("weapon_prop/sword", 5);
        set("weapon_prop/spells", 7);
        setup();
}

int query_autoload()
{
        object me=this_player();

        if(me->query("class")!="taoist")
                return 0;

        return 1;
}

void init()
{
        add_action("do_speak", "speak");
}

int do_speak()
{
        object me=this_player();
        object ob=this_object();
string room,str1,str2,str3;
room = file_name(environment(me));
sscanf(room,"/%s/%s/%s",str1,str2,str3);
if ((str1== "d" && str2 == "ghost" && str3 =="kill") || (str1 == "d" && str2 == "pkroom" && str3 =="fight"))
{
tell_object(me,"ぃ硂贺よㄏノ笵み糃\n");
return 1;
}
else
{
if(me->is_fighting())
   return notify_fail("驹矮い,叫瞒秨,ㄏノ\n");
if (me->query("marks/笵") != 1)
   return notify_fail("⊿笵ぃㄏノ硂р糃\n");

tell_object(me,BBLU+HIW"├帝笵礚ネ▅ぱ笵礚薄笲︽らるて▇瞒"NOR"\n");
message_vision(HIC"$N羭癬もい笵み糃充充├碭┛礛てΘ笵▇┕硊"NOR"\n",me);
me->move("/d/reason/tsu/m1.lpc");
message_vision(BYEL+HIW"笵眏パ甮ǎ$N眖紇いǐㄓ"NOR"\n",me);
}
return 1;
}
