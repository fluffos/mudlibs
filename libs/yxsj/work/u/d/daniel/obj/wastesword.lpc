// wastesword.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(BRED + HIY "核廢料劍" NOR, ({ "waste sword", "waste", "sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "這是一把由神秘的台電公司，把核三場的萬年核廢料熔化後\n"
      "由快滋生反應爐處理過所鑄成的劍，有可怕的威力。\n"
    );
    set("value", 50000);
    set("material", "steel");
    set("weapon_prop/sword", 200);
  }
  init_sword(500);

  set("wield_msg", "$N先穿上了核生化防護衣，再從背後的十公分厚鉛版劍套\n"
    "裡拿出了一把$n，握在帶著手套的手中。\n");
  set("unwield_msg", "$N先用帶著手套的手將手中的$n，小心翼翼地插入\n"
    "背後的十公分厚鉛版劍套，再脫下核子防護衣，看起來鬆了口氣。\n");

  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int Temp;

  Temp = victim->query_condition("Poisoner");
  victim->apply_condition("Poisoner", 10 + Temp);

  Temp = victim->query_condition("aip");
