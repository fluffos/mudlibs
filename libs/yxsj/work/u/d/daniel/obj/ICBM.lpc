#include <ansi.h>
inherit ITEM;
 
void create() {
    set_name("瑆悔紆笵紆", ({"ICBM", "icbm" }));
    set_weight(1);
    set("unit","眎");
    set("no_sell",1);
    set("no_pawn",1);
    set("value", 100);
    set("long","硂琌猅ノㄓ倒眤拜眤狟ねノ瑆悔紆笵紆\n");
}
 
void init()
{
 
     add_action("send", "send");
}
 
int send(string arg) {
    object ob ;
    string sex;
    if (this_object()->query("sended")) 
        return notify_fail("硂猅紆竒祇甮筁舘ぃ璶ê或竊稽\n");
    if (!arg) return notify_fail("癳紆ゴ街\n");
    if (! (ob = find_player(arg)) )
        return notify_fail("硂產ぃ翅\n");
    if( !this_player()->visible(ob) ) return notify_fail("硂產ぃ翅\n");
    if ((string)ob->query("gender")=="╧┦") sex="";
    else sex="﹑";
    write("北籓砞﹚ヘ夹︹祇甮秙ǎ玡紆┕ぱ\n");
    tell_object(ob,HIR"\nぱ冻铭砆綺猧侥床瞴讽いΤ猅瑆悔紆笵紆甮ㄓ\n"HIW);
    tell_object(ob,HIY"帝いゴ筁ㄓ罢娩ъ葵帛币笆フ︗皚筽笷㎝稲瓣紆\n"HIW);
    tell_object(ob,HIR"稲瓣紆抖ゴい紆笵紆琌遏窰瘂ㄓ俐丁р㏄跑Θ\n"HIW);
    tell_object(ob,HIG"嘿帝ō逻眖紆皚紀糣柑癬ㄓ娩Τ眎ブ縉礘堵钠ㄓ\n\n"HIW);
    tell_object(ob,sex+"钡帝ê眎灿弄帝\n\n");
    tell_object(ob,HIC"ね程"+sex+"盾盚ね剿拜籔闽胔讽"+sex+"比秨玝ê腀尺舧磖\n\n"NOR);
    tell_object(ob,HIG"                                           "+this_player()->name()+"\n\n"NOR);
    this_object()->set_name(
        HIG""+(string)this_player()->name()+""NOR+"癳倒"+sex+"瑆悔紆笵紆",({"ask card","card"}));
    this_object()->set("sended",1);
    write("瓣ňや穿矫琍陪ボ瑆悔紆笵紆竒非絋甮"+ ob->query("name") +"繷舘\n\n");
    return 1;
}
