// bygdog.c
#include <ansi.h>
inherit NPC;
inherit MOUNT;

void create() {
  set_name(HIG "小拜格" HIY "肉包狗" NOR, ({ "byg dog", "dog", "byg" }));
  set("race", "野獸");
  set("age", 100);
  set("long", "這是一隻極有靈性的狗，武功\非常高強，你可以試著騎(mount)看看。\n");
  set("value", 100000);
  set("str", 200);
  set("cor", 260);

  set("limbs", ({ "頭部", "身體", "前腳", "頸腳", "腹部", "後腳", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("chat_chance", 10);
  set("chat_msg", ({
    (: command, "dog" :),
    (: command, "roll" :),
    (: command, "worm" :),
    (: command, "say 我好肉..." :),
  })
  );

  set("food", 150);
  set("combat_exp", 10000);  //騎乘這匹馬所需高於的exp(因為有人拿馬來練功\so..
  //以後直接以riding lv 來判定需要的等級....)
  set("move", 50);  //騎乘這匹馬所增加的move lv
  set("dodge", 50);  //騎乘這匹馬所增加的dodge lv
  set("power", 100);  //騎乘這匹馬所增加的攻擊力
  set("armor", 100);  //騎乘這匹馬所增加的防禦力
  set_skill("riding", 100);  //騎乘這匹馬所需的riding lv
  set("addmove", 5000);  //騎乘這匹馬所能增加的負重
  set("type", "horse");
  setup();
}
