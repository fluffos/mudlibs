#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIW "十二無敵" NOR, ({ "twelve sword", "sword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "這是一把黑鏖粗柄的神兵，是劍君的第十二恨，威力無窮。\n");
    set("value", 3400);
    set("material", "blacksteel");
    set("weapon_prop/sword", 50);
    set("weapon_prop/strength", 20);
    set("wield_msg", "只聽見「颼」地一聲﹐$N的手中已經多了一把$n。\n");
    set("unequip_msg", "$N將手中的$n往上一拋，$n順勢插入背上的劍鞘。\n");
  }
  init_sword(140);
  setup();
}
