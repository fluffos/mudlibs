// lotushat.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create() {
  set_name(HIR "蓮冠" NOR, ({ "lotus hat", "lotus", "hat" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一頂素還真戴的蓮冠，冰清玉潔，正象徵了他的品德。\n");
    set("unit", "頂");
    set("value", 2000);
    set("armor_type", "head");
    set("armor_prop/head", 10);
    set("armor_prop/literate", 20);
  }
}
