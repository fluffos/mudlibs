// lasermak.c

#include <ansi.h>
#include <weapon.h>

inherit ITEM;

void countdown(int sec, string arg, object ob);

void create() {
  set_name(HIR "雷射" NOR "標定器", ({ "laser marker", "laser", "marker", "LASER" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "這是一個可由前端射出雷射光以鎖定目標的標定器，特戰部隊常用它來\n"
      "替飛彈或砲彈標定目標，以達到完全準確的目的。\n"
      "這個標定器直接連接到全球衛星定位系統，可導向衛星發射離子炮，\n"
      "在瞬間汽化目標。要標定目標，可輸入(Fire 目標)。\n"
    );
    set("unit", "把");
    set("value", 10000);
    set_weight(5000);
  }
  setup();
}

void init() {
  add_action("do_fire", "fire");
}

int do_fire(string arg) {
  object ob;
  string name2;

  if (!arg) return notify_fail("指令格式: fire 生物\n");
  ob = find_living(arg);
  if (!ob) return notify_fail("找不到這個生物.\n");
  name2 = (string)ob->query("name");
  write("你按下了雷射標定器的開關，射出一道細長的" HIR "紅外線雷射" NOR "光束，瞄準了" + name2 + "。\n");
  message_vision(
    (string)this_player()->query("name") + "舉起了手上的" HIR "雷射" NOR "標定器，對準了" + name2 + "\n",
    this_player()
  );
  this_player()->start_busy(5);
  countdown(30, arg, ob);
  return 1;
}

void countdown(int sec, string arg, object ob) {
  string name2;
  sec = sec - 5;
  if (sec > 0) {
    write("標定器顯示" HIC "衛星" NOR "在" + sec + "秒後就定位。\n");
    if (sec == 5) message_vision("你感到空氣中有點異動，你周圍的氣體好像開始產生靜電。\n", this_player());
    countdown(sec, arg, ob);
  } else {
    name2 = (string)ob->query("name");
    write("標定器顯示" HIC "衛星" NOR "已經就緒，" HIR "正在發射武器。\n\n" NOR);
    message_vision(
      "\n			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      " ───────────────────────────────\n\n"
      , ob);
    message_vision(
      HIY "天啊，天上忽然垂直射下一道" HIW "白色" HIY "的高能離子束，不偏不倚的照在" + name2 + "的身上！！\n" + NOR
      HIR + "只見" + name2 + "慘叫一聲，高能離子碰到" + name2 + "的身體，產生了劇烈的反應！\n" + NOR
      NOR + name2 + "的全身上下，都爆出" HIR "團團火球" NOR "，升到極高的溫度，足以汽化金屬\n"
      HIY "說時遲那時快，就在你正驚異於這一幕時，突然產生了一陣大爆炸，亮光使你睜不開眼！\n" + NOR
      "等你回過神來，" + name2 + "已消失的無影無蹤，只剩下地上的一個大洞，還冒著縷\縷\白煙。\n"
      , ob);
    message_vision(
      "\n			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      "			" HIY "██████" NOR "			\n"
      " ───────────────────────────────\n\n"
      , this_player());
    message_vision(
      HIY "天啊，天上忽然垂直射下一道" HIW "白色" HIY "的高能離子束，不偏不倚的照在" + name2 + "的身上！！\n" + NOR
      HIR + "只見" + name2 + "慘叫一聲，高能離子碰到" + name2 + "的身體，產生了劇烈的反應！\n" + NOR
      NOR + name2 + "的全身上下，都爆出" HIR "團團火球" NOR "，升到極高的溫度，足以汽化金屬\n"
      HIY "說時遲那時快，就在你正驚異於這一幕時，突然產生了一陣大爆炸，亮光使你睜不開眼！\n" + NOR
      "等你回過神來，" + name2 + "已消失的無影無蹤，只剩下地上的一個大洞，還冒著縷\縷\白煙。\n"
      , this_player());

    if (wiz_level(ob) > 1) {
      ob->receive_damage("kee", 4000);
      ob->receive_wound("kee", 2000);
      ob->die();
    }
    destruct(this_object());
  }
}
