#include <ansi.h>
#define divide "\n"
 
inherit ROOM;
 
void create()
{
	set("short", "[1;36m徊ぱ[2;37;0m");
	set("long", @LONG

硂柑碞琌肚弧い畍徊ぱ㏄尘粂
㏄Τ砛ゅ懂蔼酵溜阶临Τㄇ紆礮綷竒
ぃ窽稱ǐ玡酵ぱ阶さ硂睲繰秪懂よ临
玡Τ俱逼秈筿福㎝籓筽诀Τㄇ帝フ砊
厩產タ甀祇甶贺程秈硁砰琵臨艵ゼㄓ

LONG
	);

	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"secret",
  "out" : "/d/wiz/hall1",
  "tao" : "/d/reason/house4",
  "pk" : "/d/pkroom/w/pkr0",
]));

        set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/mastersu" : 1,
]));

	set("no_clean_up", 0);
	set("valid_startroom", 1);

	setup();
	call_other("u/g/guo/guo_b.lpc","???");
}
void init()
{
      add_action("do_wizs","wizlist");
	add_action("do_forceb", "forceb");
	add_action("do_listen", "listen");
	add_action("do_message", "message");
}
string get_status(object ob)
{
        if( in_edit(ob) || in_input(ob) )
                return " (絪胯い)";
        return "";
}

string get_idle(object ob)
{
        int val;
        switch( val = query_idle(ob) )
        {
                case 0..59    : return "";
                case 60..3599 : return sprintf( HIY" [祇%2dだ牧]"NOR, val / 60
 );
        default       : return sprintf( HIY" [祇%2d]"NOR, val / 3600 );
        }
}

string get_invis(object ob)
{
        return ob->visible(this_player()) ? "" : HIC" [留い]"NOR;
}

string get_id(object ob)
{
        return ob->query("name") + "(" + capitalize(ob->query("id")) + ")";
}

string get_env(object ob)
{
        return CYN" ("+file_name(environment(ob))+")"NOR;
}

int do_wizs(string str)
{
        object *wizs;
        int i;

        wizs = filter_array( users(), "filter_wizards", this_object() );
        wizs = sort_array( wizs, "sort_wizards", this_object() );
        i    = sizeof(wizs);
        str  = divide;

        while(i--)
                str = sprintf( "%s %s %s%s%s%s%s%s%s\n",
                        str, wizs[i]->rank(),wizs[i]->query("title"),
                        wizs[i]->query("nickname"), get_id(wizs[i]),
                        get_status(wizs[i]), get_idle(wizs[i]),
                        get_invis(wizs[i]), get_env(wizs[i]));

        write( sprintf( "\n%s\t\t   ヘ玡Τ %d 畍絬\n%s%s",
                divide, sizeof(wizs), str, divide ) );
        return 1;
}

int filter_wizards(object ob)
{
        return wizardp(ob);
}

int sort_wizards(object ob1, object ob2)
{
        return wiz_level(ob1) - wiz_level(ob2);
}
int do_forceb(string arg)
{
        object ob;
        string victim, cmd;

        if (!arg || arg == "" || (sscanf(arg, "%s to %s", victim, cmd) != 2
           && sscanf(arg, "%s %s", victim, cmd) != 2))
              return notify_fail("Α : force <琘> to <暗ぐ或>\n");

	  ob = present(victim, environment(this_player()));
        if (!ob)
              return notify_fail("тぃ硂\n");

        ob->forceb(cmd);

        return 1;
}
int do_listen(string arg)
{
	object me = this_player();
	string *tuned_ch;

	tuned_ch = me->query("channels");
	if( !arg ) {
		if( !pointerp(tuned_ch) || !sizeof(tuned_ch) )
			write("瞷⊿ΤΜ钮ヴ︙繵笵\n");
		else
			write("瞷Μ钮繵笵" + implode(tuned_ch, ", ") + "\n");
		return 1;
	}

		write("ゴ秨 " + arg + " 繵笵\n");
		tuned_ch += ({ arg });
		me->set("channels", tuned_ch);
		return 1;
}
int msgg(object me)
{
        tell_object(users(), CYN+"\n\n环よ羘Τタ瘆τㄓ\n" NOR);
        call_out("msg",3,me);
        return 1;
}
int msg(object me)
{
        tell_object(users(), HIG+"\n\nㄓΤ璶肚笷璶猌狶诀盞倒\n"NOR);
        call_out("msg1",4,me);
        return 1;
}
int msg1(object me)
{
        tell_object(users(), HIY+"\n\nτㄓрウ钡︘\n"NOR);
        call_out("msg2",4,me);
        return 1;
}
int msg2(object me)
{
        tell_object(users(), HIW"\n\n弧笵垛ㄓрゴ秨ㄓ\n"NOR);
        call_out("msg3",4,me);
        return 1;
}
int msg3(object me,string arg)
{
        tell_object(users(), HIR"\n\n"+(string)me->query("name")+"Ξ種"+(string)me->query_temp("speak")+"\n"NOR);
        call_out("msg4", 4, me);
        return 1;
}
int msg4(object me)
{
       tell_object(users(), GRN"\n\nЧ格繦ぇア盢獺Μ\n"NOR);
       return 1;
}
int do_message(string arg)
{
	  object me;
	  me = this_player();
        if (!arg) {
                write("癟瑿...ぃ癳翅\n");
        return 1;}
        call_out("msgg",3,me);
        me->set_temp("speak",arg);
        return 1;
}
