// store.c by Daniel Guo

inherit ROOM;

void init()
{
	add_action("do_list", "list");
  	add_action("do_buy_obj", "buy");
}

private int check_money_enough(object ob);

int do_list()
{
	string list;

	list=environment(this_player())->query("list");
	if(!list)
		return notify_fail("╆簆,セ┍狥﹁场扳Ч,叫筁碭ぱㄓ....\n");
	write(list+"\n");
	return 1;
}

int do_buy_obj(string what)
{  
	string obj;
	object ob;
	if(!what) {
		write("ボ: buy <狥﹁璣ゅ嘿> \n");
		return 1; }
	obj = environment(this_player())->query(what);
	if(!obj) {
		write("╆簆,セ┍⊿Τ芥硂妓狥﹁!!\n");
		return 1; }
	ob = new(obj); 
	if(!ob) {
		write("╆簆,セ┍⊿Τ芥硂妓狥﹁!!\n");
		return 1; }
	check_money_enough(ob);
	return 1;
}

private int check_money_enough(object ob)
{
	int money;
	object me;
	me = this_player();
	money = ob->query("value");

	if ( !me->can_afford(money) ) {
		write("ō⊿Τê或窥\n");
		return 1; }
	me->pay_money(money);
	ob->move(me);
	message_vision("$N禦" + ob->query("unit") + ob->query("name") + "\n", me);
	return 1;
}