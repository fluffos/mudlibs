// store.c by Daniel Guo

inherit ROOM;

void init() {
  add_action("do_list", "list");
  add_action("do_buy_obj", "buy");
}

private int check_money_enough(object ob);

int do_list() {
  string list;

  list = environment(this_player())->query("list");
  if (!list)
    return notify_fail("很抱歉,本店的東西已全部售完,請過幾天再來....\n");
  write(list + "\n");
  return 1;
}

int do_buy_obj(string what) {
  string obj;
  object ob;
  if (!what) {
    write("指令格示: buy <東西英文名稱> \n");
    return 1;
  }
  obj = environment(this_player())->query(what);
  if (!obj) {
    write("很抱歉,本店並沒有賣這樣東西!!\n");
    return 1;
  }
  ob = new(obj);
  if (!ob) {
    write("很抱歉,本店並沒有賣這樣東西!!\n");
    return 1;
  }
  check_money_enough(ob);
  return 1;
}

private int check_money_enough(object ob) {
  int money;
  object me;
  me = this_player();
  money = ob->query("value");

  if (!me->can_afford(money)) {
    write("你身上沒有那麼多錢。\n");
    return 1;
  }
  me->pay_money(money);
  ob->move(me);
  message_vision("$N買下了一" + ob->query("unit") + ob->query("name") + "。\n", me);
  return 1;
}
