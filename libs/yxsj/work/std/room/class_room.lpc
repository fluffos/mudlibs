inherit ROOM;
#include <ansi.h>

void create() {
  ::setup();
}

void init() {
  add_action("do_join", "join");      //加入公會
  add_action("do_betray", "betray");   //背叛公會
  add_action("do_advance", "advance");  //增加等級
  add_action("do_train", "train");     //增加技能等級
  add_action("do_list", "list");       //列處此處所有能學的技能
}

private int save_old_status();
private int check_exp_enough(int level_exp);
private int change_level(string what, string kind);


int do_list() {
  string list;
  list = environment(this_player())->query("list");
  if (!list) return notify_fail("很抱歉,本公會的資深會員現在都不在,因此沒有人可以教你...\n");
  write("\n" + list + "\n");
  return 1;
}

int do_join() {
  object me;
  string class1, title1;

  me = this_player();
  //	if( stringp(me->query("class")))
  if (me->query("class") && me->query("class") != "")
    return notify_fail("您已經參加了其他公會。\n");
  class1 = environment(me)->query("class");

  if (!class1) return notify_fail("很抱歉!!本公會已不收會員了。\n");
  else {
    title1 = environment(me)->query("title");
    if (!title1) return notify_fail("很抱歉!!本公會已不收會員了。\n");
    else {
      me->set("class", class1);
      //	          write("\n恭喜﹐從今天起您已經成為一名"+title1+"﹗\n\n");
      message_vision("\n恭喜﹐從今天起$N正式成為一名" + title1 + "﹗\n", me);

    }
  }
  return 1;
}

int do_betray() {
  object me, money2;
  string class_env, class_user, title1;

  me = this_player();
  class_env = environment(me)->query("class");
  title1 = environment(me)->query("title");
  class_user = me->query("class");

  //*********檢查user的職業是否與此公會的職業相同??****************

  if (!class_env || !class_user || !title1)
    return notify_fail("很抱歉!!本公會找不到您的資料,可能您並未加入本公會而您記錯了....!!\n");
  else {
    if (class_env != class_user)
      return notify_fail("很抱歉!!本公會找不到您的資料,可能您並未加入本公會而您記錯了....!!\n");
    else {
      money2 = present("coin_money", me);
      if (!money2) {
        return notify_fail("你必須支付10000個銅幣才能退出本公會。\n");
        return 1;
      }
      if ((int)money2->query_amount() < 10000) {
        return notify_fail("你必須支付10000個銅幣才能退出本公會。\n");
        return 1;
      }

      money2->add_amount(-10000);

      me->set("class", "");
      message_vision("\n$N為某種原因拋棄了" + title1 + "的身份了！\n", me);
      //	write("\n您為某種原因拋棄了您"+title1+"的身份了﹗\n\n");
      return 1;
    }
  }
}

int do_advance() {
  object me;
  int level_exp, lv_limit;
  string class_env, class_user;

  me = this_player();
  class_env = environment(me)->query("class");
  class_user = me->query("class");

  if (class_env == class_user) {
    if (me->query("level") > 0) {

      // ***********加入此處所能提昇的level限制****************
      lv_limit = environment(me)->query("lv_limit");
      if (!lv_limit) lv_limit = 100;
      if (me->query("level") > lv_limit) return notify_fail("你已是本公會裡數一數二的高手了，已經沒有人可以再教你什麼了!!\n");
      // ******************************************************

      level_exp = me->query("level_exp");
      check_exp_enough(level_exp);
      return 1;
    }
  }
  write("您不是本公會會員,不能在此增加等級!!\n");
  return 1;
}


private int check_exp_enough(int level_exp) {
  object me;
  int exp;

  me = this_player();
  exp = this_player()->query("exp");

  if (exp < level_exp) {
    write("您的經驗值不足。\n");
    return 1;
  } else {
    exp = exp - level_exp;
    me->set("exp", exp);
    change_level("level", "level");
  }
}

private int change_level(string what, string kind) {
  int level, level_exp, str, cor, int1, spi, cps, per, con, kar, max_kee, max_mana, max_skill;
  object me;
  me = this_player();

  if (what == "level") {
    level = me->query("level");
    level = level + 1;
    level_exp = me->query("level_exp");

    // ******昇級所須EXP的計算公式*******
    if (level < 10) {
      level_exp = level_exp * 2;
    } else if (level >= 10 && level < 20) {
      level_exp = level_exp * 1.4;
    } else if (level >= 20 && level < 30) {
      level_exp = level_exp * 1.3;
    } else { level_exp = level_exp * 1.2; }
    // **********************************

    me->set("level_exp", level_exp);
    me->set("level", level);

    if (sscanf(environment(me)->query("status"), "%d %d %d %d %d %d %d %d %d %d %d",
      str, cor, int1, spi, cps, per, con, kar, max_kee, max_skill, max_mana) == 11) {
      me->add("str", str);
      me->add("cor", cor);
      me->add("int", int1);
      me->add("spi", spi);
      me->add("cps", cps);
      me->add("per", per);
      me->add("con", con);
      me->add("kar", kar);
      me->add("max_kee", max_kee);
      me->add("max_skill", max_skill);
      me->add("max_mana", max_mana);
    }
  }
  message_vision("\n經過一番的學習後,$N的等級提昇為 " HIC + level + NOR " 級！\n\n", me);
  //          write("\n您的等級上昇了﹗\n\n");
  return 1;

}



int do_train(string arg) {
  object me;
  int exp, exp_need, skill_lv, i, skill_lv1, lv_limit;
  mapping temp_skill;
  string class_env, class_user, *sname;
  string skill1, skill2, skill3, skill4, skill5, skill6, skill7, skill8, skill9, skill10;

  if (!arg) return notify_fail("指令格式﹕train <技能名稱>\n");

  me = this_player();
  class_env = environment(me)->query("class");
  class_user = me->query("class");

  if (class_env == class_user) {
    sscanf(environment(me)->query("skills"), "%s %s %s %s %s %s %s %s %s %s %s %s %s %s %s",
      skill1, skill2, skill3, skill4, skill5, skill6, skill7, skill8, skill9, skill10);

    if (arg != skill1 && arg != skill2 && arg != skill3 && arg != skill4 && arg != skill5
      && arg != skill6 && arg != skill7 && arg != skill8 && arg != skill9 && arg != skill10) {
      write("抱歉!!本公會不提供此種技能.\n");
      return 1;
    }

    temp_skill = me->query_skills();
    exp = me->query("exp");            //玩家身上的exp剩多少??

    if (!sizeof(temp_skill)) { exp_need = 1; } else {
      sname = sort_array(keys(temp_skill), (: strcmp :));

      for (i = 0; i < sizeof(temp_skill); i++) {
        if (sname[i] == arg) {
          skill_lv = temp_skill[sname[i]];
          skill_lv1 = skill_lv + 1;
        }        //技能的等級為多少??
      }

      // ***********加入此處所能提昇的level限制****************
      lv_limit = environment(me)->query("sklv_limit");
      if (!lv_limit) lv_limit = 100;
      if (skill_lv > lv_limit) return notify_fail("你已是本公會裡數一數二的高手了，已經沒有人可以再教你什麼了!!\n");

      // ******技能昇級所須EXP的計算公式*******
      if (skill_lv < 10) {
        exp_need = pow(1.9, skill_lv);
      }

      else if (skill_lv > 10 && skill_lv < 20) {
        skill_lv = skill_lv;
        exp_need = pow(1.8, skill_lv) + 613;
      }

      else if (skill_lv > 20 && skill_lv < 46) {
        skill_lv = skill_lv + 24;
        exp_need = pow(1.3, skill_lv);
      } else {
        skill_lv = skill_lv + 146;
        exp_need = pow(1.3, skill_lv);
      }

      // *************************************
    }

    if (exp_need > exp) {
      printf("您的經驗值不足!!.....下次昇級須要" + exp_need + "點的經驗值!!\n");
      return 1;
    }
    me->add("exp", -exp_need);
    //      me->add("learned_points", 1);
    me->improve_skill(arg, 100);
    message_vision("\n經過一番的學習後,$N的技能提昇為 " HIC + skill_lv1 + NOR " 級！\n\n", me);
    return 1;
  }
  write("您不是本公會會員,不能在此學習技能!!\n");
  return 1;
}
