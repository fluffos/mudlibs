// bank.c by Daniel Guo

inherit ROOM;

void init()
{
	add_action("do_convert", "convert");
	add_action("do_deposit", "deposit");
        add_action("do_withdraw", "withdraw");
	add_action("do_balance", "balance");
}

int do_convert(string arg)
{
	string from, to;
	int amount, bv1, bv2;
	object from_ob, to_ob;

	if( !arg || sscanf(arg, "%d %s to %s", amount, from, to)!=3 )
		return notify_fail("Αconvert <计秖> <砯刽贺摸> to <砯刽贺摸>\n");

	from_ob = present(from + "_money", this_player());
	to_ob = present(to + "_money", this_player());
	if( !to_ob && file_size("/obj/money/" + to + ".lpc") < 0 )
		return notify_fail("稱传贺窥\n");

	if( !from_ob )		return notify_fail("ō⊿Τ硂贺砯刽\n");
	if( amount < 1 )	return notify_fail("传砯刽Ω︓ぶ璶传\n");
		
	if( (int)from_ob->query_amount() < amount )
		return notify_fail("ō⊿Τê或" + from_ob->query("name") + "\n");

	bv1 = from_ob->query("base_value");
	if( !bv1 ) return notify_fail("硂贺狥﹁ぃ窥\n");

	bv2 = to_ob ? to_ob->query("base_value") : call_other("/obj/money/" + to, "query", "base_value" );

	if( bv1 < bv2 ) amount -= amount % (bv2 / bv1);
	if( amount==0 )	return notify_fail("硂ㄇ" + from_ob->query("name") + "基び传ぃ癬\n");

	if( !to_ob ) {
		to_ob = new("/obj/money/" + to);
		to_ob->move(this_player());
		to_ob->set_amount(amount * bv1 / bv2);
	} else
		to_ob->add_amount(amount * bv1 / bv2);

	message_vision( sprintf("$N眖ō%s%s%s传Θ%s%s%s\n",
		chinese_number(amount), from_ob->query("base_unit"), from_ob->query("name"),
		chinese_number(amount * bv1 / bv2), to_ob->query("base_unit"), to_ob->query("name")),
		this_player() );

	from_ob->add_amount(-amount);

	return 1;
}


int do_deposit(string deposit_amount1)
{
	object amount;
        string kind;
        int deposit_amount,deposit_amount2;
        int old_money;

        old_money=this_player()->query("money");

	if(!deposit_amount1 || sscanf(deposit_amount1, "%d %s", deposit_amount,kind)!=2 )
		return notify_fail("Αdeposit <计秖> <砯刽贺摸>\n");

        deposit_amount2=deposit_amount;
	amount = present(kind+"_money", this_player());
	if( !amount ) return notify_fail("ō⊿Τ硂贺砯刽\n");
	if ( (int)amount->query_amount() < deposit_amount )
           return notify_fail("ō⊿Τê或窥\n");

        else {
                amount->add_amount(-deposit_amount);
                if (kind=="silver")
                   deposit_amount=deposit_amount*100;
                if (kind=="gold")
                   deposit_amount=deposit_amount*10000;
                if (kind=="thousand-cash")
                   deposit_amount=deposit_amount*1000;

                this_player()->set("money",(int)old_money+deposit_amount);

		message_vision("$N眖ō"+
		chinese_number(deposit_amount2)+amount->query("base_unit")+
		amount->query("name")+"蝗︽\n", this_player());
//                amount->add_amount(-deposit_amount);
             }      
      
	return 1;

}

int do_withdraw(string withdraw_amount1)
{
	object amount,new_money,ob;
        int withdraw_amount,withdraw_amount2;
        int old_money;
        string kind;

        old_money=this_player()->query("money");

	if(!withdraw_amount1 || sscanf(withdraw_amount1, "%d %s", withdraw_amount,kind)!=2 )
		return notify_fail("Αwithdraw <计秖> <砯刽贺摸>\n");

	amount = present(kind+"_money", this_player());

        withdraw_amount2=withdraw_amount;
        if(kind=="silver")
          withdraw_amount2=withdraw_amount2*100;
        if(kind=="gold")
          withdraw_amount2=withdraw_amount2*10000;
        if(kind=="thousand-cash")
          withdraw_amount2=withdraw_amount2*1000;

	if( old_money < withdraw_amount2 )
          return notify_fail("め繷柑⊿Τê或窥\n");

        else this_player()->set("money",(int)old_money-withdraw_amount2);

	ob = present(kind + "_money", this_player());
        if(!amount){
		new_money = new("/obj/money/"+kind);
		new_money->move(this_player());
		new_money->set_amount(withdraw_amount);
     	        ob = new_money;
          }
        else{amount->add_amount(withdraw_amount);}

		message_vision("$N眖蝗︽矗"+
		chinese_number(withdraw_amount)+ob->query("base_unit")+
		ob->query("name")+"\n", this_player());      

	return 1;

}

int do_balance()
{
	int money;
	money = this_player()->query("money");
	write("め繷柑Τ\n\n");
	write("      "+(int)(money / 10000)+"  旷独\n");
	write("      "+((money % 10000)-(money % 100))/100+"  ㄢフ蝗\n");
	write("      "+(money % 100)+"  じ祑刽\n\n");
	return 1;
}