// pwd.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  string name;
  if (this_player()->query("env/invisibility") == 1)
    return notify_fail("你已經隱身了喔...\n");
  name = (string)me->query("name");
  if (!arg) {
    me->set("env/invisibility", 1);
    tell_room(environment(me),
      name + "[1;36m突然從身後抽出一件隱身衣並且披在身上,只見其身影已消失於空氣之中...\n[0m"
      , ({ me }));
    write(HIY "你穿上隱身衣,好像要『與世隔絕』般的消失在空氣中...\n" NOR);
    return 1;
  }
}
