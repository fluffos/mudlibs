// pwd.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	string name;
	if(this_player()->query("env/invisibility") == 1) 
		return notify_fail("竒留ō翅...\n");
	name=(string)me->query("name");
	if( !arg ) {
		me->set("env/invisibility",1);
		tell_room(environment(me),
name+"[1;36m礛眖ō┾ン留ō︾┸ō,ǎㄤō紇アぇい...\n[0m"
		,({me}));
		write(HIY"留ō︾,钩璶籔筳荡アい...\n"NOR);
	return 1;
	}
}