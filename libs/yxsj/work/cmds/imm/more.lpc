// cat.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string file;
	object ob;

	seteuid(geteuid(me));
	if (!arg) return notify_fail("Α : more <郎>|<ン> \n");
	file = resolve_path(me->query("cwd"), arg);
	if( file_size(file) < 0 ) {
		ob = present(arg, me);
		if( !ob ) ob = present(arg, environment(me));
		if( !ob ) return notify_fail("⊿Τ硂郎\n");
		file = base_name(ob) + ".lpc";
	}
	me->start_more( read_file(file));
	return 1;
}

int help(object me)
{
write(@HELP
Α : more <郎>|<ン>
 
だ陪ボ郎ず甧
 
more 家Α:
q      : 瞒秨 more.
b      : 陪ボ玡ず甧.
[ENTER]: 陪ボず甧.

HELP
    );
    return 1;
}
