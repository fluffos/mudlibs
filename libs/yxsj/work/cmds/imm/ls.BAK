#include <ansi.h>
 
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	int mark_loaded;
	int i, j, w, col;
	string dir;
	mixed *file;
 
	seteuid(geteuid(me));
	dir = resolve_path(me->query("cwd"), arg);
	if( file_size(dir)==-2 && dir[strlen(dir)-1] != '/' ) dir += "/";
	file = get_dir(dir, -1);
	if( !sizeof(file) )
	{if (file_size(dir) == -2) return notify_fail("ヘ魁琌\n");
		else
		return notify_fail("⊿Τ硂ヘ魁\n");
	}
 
	i = sizeof(file);
	w = 0;
	while(i--) {
		if (file[i][1]==-2) file[i][0] += "/";
		if (strlen(file[i][0])>w) w = strlen(file[i][0]) + 1;
	}
	write("ヘ魁" + dir + "\n");
	col = 70 / (w+6);
	if (sizeof(file))
		for(i=0, j = sizeof(file); i<j; i++) {
			int mode=0;	// unloaded file
			
			if (strsrch(file[i][0], "/") >= 0) mode = 1; // dir
			else if (find_object(dir+file[i][0])) mode =2; // loaded file
 
			printf("%4d %-*s%s", file[i][1]/1024 + 1, w+1+
				(mode>0? 16: 9),
                                (mode==1? HIB: mode==2? HIG: "") +
				file[i][0] + (mode==2? "*": " ") + NOR,
				((i+1)%col)?"  ":"\n");
                }
	else write("    ⊿Τヴ︙郎\n");
	write("\n");
	
	return 1;	
}
 
int help(object me)
{
	write(@HELP
Αls [<隔畖>]
 
ヘ魁┮Τヘ魁の郎狦⊿Τ﹚ヘ魁玥┮ヘ魁
ず甧┮郎い玡夹ボ * 腹琌竒更ン
 
絛ㄒ:
'ls /' 穦┮Τ︗ヘ魁郎のヘ魁
 
闽cdpwd
HELP
	);
	return 1;
}
