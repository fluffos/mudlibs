// edemote.c

inherit F_CLEAN_UP;

int in_use;

int main(object me, string arg)
{
	mapping emote;

	if( !arg ) return notify_fail("璶絪胯ぐ或 emote\n");

	if( sscanf(arg, "-d %s", arg) ) {
		write("埃 emote" + arg + "\n");
		EMOTE_D->delete_emote(arg);
		return 1;
	}

	if( sscanf(arg, "-p %s", arg) ) {
		emote = EMOTE_D->query_emote(arg);
		printf("\n");
		printf("     %s     %s\n", arg, emote["name"]);
		printf("\n");
		printf("Ωэ%s\n", emote["updated"]);
		printf("\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n",
			emote["myself"], emote["others"], emote["myself_self"],
			emote["others_self"], emote["myself_target"], emote["target"],
			emote["others_target"] );
		return 1;
	}

	emote = EMOTE_D->query_emote(arg);
	emote = (["updated":geteuid(me)]);

	write("絪胯 emote" + arg + "\n");
	write("癟Τ碭︽ノ . ボ挡\n");
	write("癟いㄏノ把计Τ碭贺\n");
	write("  $N  ︑\n");
	write("  $n  ㄏノ癸禜\n");
	write("  $P  ︑嘿迭﹑╡ウ\n");
	write("  $p  ㄏノ癸禜嘿迭﹑╡ウ\n");
	write("\n");
	write("硂 emote 嘿\n->");
	input_to("get_msg_name", emote, arg);
	return 1;
}
int get_msg_name(string msg, mapping emote, string pattern)
{
	if (msg==".") {
		write("ぃ﹚癸禜ㄏノ硂 emote ︑癟\n->");
		input_to("get_msg_myself", emote, pattern);
		return 1;
	}
	emote["name"] = msg;
	write("->");
	input_to("get_msg_name", emote, pattern);
	return 1;
}

int get_msg_myself(string msg, mapping emote, string pattern)
{
	if (msg==".") {
		if( !undefinedp(emote["myself"]) ) emote["myself"] += "\n";
		write("ぃ﹚癸禜ㄏノ硂 emote ㄤ癟\n->");
		input_to("get_msg_others", emote, pattern);
		return 1;
	}
	if( !undefinedp(emote["myself"]) )
		emote["myself"] += msg + "\n";
	else emote["myself"] = msg;
	write("->");
	input_to("get_msg_myself", emote, pattern);
	return 1;
}

int get_msg_others(string msg, mapping emote, string pattern)
{
	if (msg==".") {
		if( !undefinedp(emote["others"]) ) emote["others"] += "\n";
		write("癸︑ㄏノ硂 emote ︑癟\n->");
		input_to("get_msg_myself_self", emote, pattern);
		return 1;
	}
	if( !undefinedp(emote["others"]) )
		emote["others"] += msg + "\n";
	else emote["others"] = msg;
	write("->");
	input_to("get_msg_others", emote, pattern);
	return 1;
}

