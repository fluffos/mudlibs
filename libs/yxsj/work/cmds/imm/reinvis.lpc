// pwd.c
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  if (this_player()->query("env/invisibility") != 1) return notify_fail("你現在沒有隱身喔!!!\n");
  if (!arg) {
    me->delete("env/invisibility");
    write(HIC "你脫掉身上的隱身衣,身影漸漸浮現在空氣之中....\n" NOR);
    return 1;
  }
}
