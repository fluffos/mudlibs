// snoop.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;

	if( !arg ) {
		if( objectp(ob = query_snooping(me)) )
			write("瞷タ菏钮" + ob->query("name") + "┮Μ癟\n");
		return 1;
	} else if( arg=="none" ) {
		if( objectp(ob = query_snooping(me))
		&&	wiz_level(ob) >= wiz_level(me) )
			tell_object(ob, HIW + me->name(1) + "氨ゎ菏钮┮Μ癟\n" NOR);
		snoop(me);
		write("Ok.\n");
		return 1;
	}

	ob = find_player(arg);
	if(!ob) ob = find_living(arg);
	if(!ob || !me->visible(ob)) return notify_fail("⊿Τ硂\n");

	if( wizhood(me) != "(admin)"
	&&	wiz_level(me) <= wiz_level(ob) )
		return notify_fail("⊿Τ菏钮" + ob->name() + "┮Μ钮癟舦\n");

	if( me==ob ) return notify_fail("叫ノ snoop none 秆埃菏钮\n");
		
	snoop(me, ob);
	write("瞷秨﹍叛钮" + ob->name(1) + "┮Μ癟\n");
	if( userp(ob) ) log_file("SNOOP_PLAYER",
		sprintf("%s(%s) snoops %s on %s.\n", me->name(1), geteuid(me), ob->name(1),
			ctime(time()) ) );
	if( wizardp(ob) && wizhood(me) != "(admin)")
		tell_object(ob, HIW + me->name(1) + "秨﹍菏钮┮Μ癟\n" + NOR);

	return 1;
}

int help()
{
	write(@TEXT
Αsnoop <琘>|none

菏钮ㄤㄏノ┮Μ钮癟snoop none 玥菏钮
TEXT
	);
	return 1;
}
