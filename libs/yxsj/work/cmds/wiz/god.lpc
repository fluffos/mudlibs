// god command..

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str) {
  object ob;
  int i;
  if (!str) ob = me;  //return notify_fail("<Syntax>: god <player id>\n");
  else ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail(HIW "< 此人不在這個時空。 >\n" NOR);
  // moving
  message("system",
    HIW "\n\t\t\t< 忽 然 天 上 閃 過 一 道 光 芒 >\n\n\n\n" NOR,
    users());
  tell_room(environment(ob), HIW "< 你看到許\多小天使把" HIY +
    (string)ob->query("name") + HIW "抓了起來, 然後不見了 >\n" NOR, ob);
  tell_object(ob, HIW "<一群 " HIY "小天使" HIW "將你抓起.飛往空中 >\n" NOR);
  if (ob == me) {
    if (me->query("born") == "東方") {
      me->move("/d/east/inn");
    } else {
      me->move("/d/west/recall");
    }
  } else ob->move(environment(me));
  ob->reincarnate();
  ob->set("water", me->max_water_capacity());
  ob->set("food", me->max_food_capacity());
  ob->set("kee", me->query("max_kee"));
  ob->set("gin", me->query("max_gin"));
  ob->set("sen", me->query("max_sen"));
  tell_object(me, HIG "< 你成功\的把" HIY + (string)ob->query("name") + HIG "復活了 >.\n" NOR);
  tell_object(ob, HIW "< 你醒來時發現是" HIY + (string)me->query("name") +
    HIW "把你復活的 >\n" NOR);
  tell_room(environment(ob), HIG "< " + (string)ob->query("name") + HIW "被幾位小天使" +
    "慢慢的從天空放了下來 >\n" NOR, ({ me, ob }));
  return 1;
}
