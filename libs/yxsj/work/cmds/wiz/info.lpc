// info.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	object obj;
	string str;

	if (!arg) return help(me);

	seteuid(geteuid(me));

	if( arg=="me" ) obj = me;
	else if( arg=="my link" ) obj = me->query_temp("link_ob");
	else {
		obj = present(arg, me);
		if (!obj) obj = present(arg, environment(me));
		if (!obj) obj = find_object( resolve_path(me->query("cwd"), arg) );
		if (!obj) return notify_fail("⊿Τ硂妓ン....\n");
	}

	printf("ン [%O]\n-----------------------------------------------------\n", obj);
	write("郎\t\t" + base_name(obj) + ".c\n");
	write("烩办\t\t" + domain_file(base_name(obj)) + "\n");
	write("\t\t" + author_file(base_name(obj)) + "\n");
	write("舦\t\tuid = " + getuid(obj) + ", euid = " + geteuid(obj) + "\n");
	write("单\t\t" + wizhood(obj) + "\n");
	write("ㄏノ癘拘砰\t" + memory_info(obj) + "\n");
	str = "";
	if( living(obj) ) 		str += "ネ ";
	if( userp(obj) )		str += "ㄏノ ";
	if( interactive(obj) )	str += "絬 ";
	if( wizardp(obj) ) 		str += "畍 ";
	if( clonep(obj) ) 		str += "狡籹 ";
	if( virtualp(obj) ) 	str += "店览 ";
	if( query_heart_beat(obj) ) str += "み铬:" + query_heart_beat(obj) + " ";
	write("妮┦\t\t" + str + "\n");
	write("狡籹计\t" + sizeof(children(base_name(obj)+".lpc")) + "\n");
	write("把σ硈挡\t" + refs(obj) + "\n");

	return 1;
}

int help(object me)
{
  write(@HELP
Α : info <ンぇ嘿┪郎>

ノ眔ㄇΤ闽赣ン戈癟
HELP
    );
    return 1;
}
