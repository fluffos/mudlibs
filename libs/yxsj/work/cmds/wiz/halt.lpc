// halt.c

#include "/doc/help.h"
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if( !me->is_fighting() )
		return notify_fail("瞷⊿Τ驹矮\n");
	me->remove_all_killer();
	message_vision("$Nノ畍氨ゎ硂初ゴ矮\n", me);
	write("Ok.\n");
	return 1;
}

int help(object me)
{
   write(@HELP
Α: halt

氨ゎ┮Τ籔(﹑)Τ闽驹矮
HELP
   );
   return 1;
}
