// smash.c 2-22-95
 
#include "/doc/help.h"

inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	object ob;
	string cmd, obj;

	if (!arg) return notify_fail("Α: force <ネ> to <>\n");

	sscanf(arg, "%s to %s", obj, cmd);

	if (!cmd) return notify_fail("Α: force <ネ> to <>\n");
	ob = present(obj, environment(me));
	if (!ob) return notify_fail("тぃ硂ネ.\n");

	write("㏑"+ob->query("name")+" "+cmd+"\n");
	if (!ob->force(ob->process_input(cmd))) write(ob->query("name")+"礚猭ЧΘ硂笆\n");
	return 1;
}
 
int help(object me)
{
   write(@HELP
Α: force <ネ> to <>

眏笆
 
HELP
   );
   return 1;
}
