// smash.c 2-22-95

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  string cmd, obj;

  if (!arg) return notify_fail("指令格式: force <生物> to <指令>\n");

  sscanf(arg, "%s to %s", obj, cmd);

  if (!cmd) return notify_fail("指令格式: force <生物> to <指令>\n");
  ob = present(obj, environment(me));
  if (!ob) return notify_fail("找不到這個生物.\n");

  write("你命令" + ob->query("name") + " " + cmd + "。\n");
  if (!ob->force(ob->process_input(cmd))) write(ob->query("name") + "無法完成這個動作。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: force <生物> to <指令>

強迫作動作
 
HELP
  );
  return 1;
}
