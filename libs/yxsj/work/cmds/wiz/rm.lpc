// rm.c

#include "/doc/help.h"

inherit F_CLEAN_UP;
int help(object me);

int main(object me, string file)
{
	seteuid(geteuid(me));
    if (!file) return notify_fail("璶埃ê郎?\n");
	if( rm(resolve_path(me->query("cwd"), file)) )
		write("Ok.\n");
	else
		write("⊿Τ埃硂郎舦\n");
	return 1;
}

int help(object me)
{
  write(@HELP
Α : rm <郎>

琵(﹑)埃Τ舦э郎
HELP
    );
    return 1;
}
