// For MudOS For WIN 95/98/NT
// 因為 /data/emote.o 是 Binary 檔
// Made By 天空騎士 - 御天(skyrider) skyrider@uw.mud.tw

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  mapping emote;
  string *e;
  int i;

  //        if("/adm/daemons/common.lpc"->no_action(me,"dmpemote")==0)
  //          return 0;

  e = sort_array(EMOTE_D->query_all_emote(), 1);

  write(" START DUMP EMOTE \n");

  for (i = 0; i < sizeof(e); i++) {
    emote = EMOTE_D->query_emote(e[i]);
    printf("─> %s <─\n%s%s%s%s%s%s%s", e[i],
      emote["myself"], emote["others"], emote["myself_self"],
      emote["others_self"], emote["myself_target"], emote["target"],
      emote["others_target"]);
  }

  write(" END DUMP EMOTE \n");
  return 1;
}


int help(object me) {
  write(@HELP
指令格式 : dmpemote

這個指令可以列出目前所能使用 emote 的詳細資料。

  "myself"
  "others_self"
  "others_target"
HELP
  );
  return 1;
}
