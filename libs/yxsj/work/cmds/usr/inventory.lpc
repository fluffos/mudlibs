//inventory.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int i;
	object *inv, ob;

	if( wizardp(me) && arg ) {
		ob = find_player(arg);
		if( !ob ) ob = find_living(arg);
		if( !ob ) ob = present(arg, environment(me));
	}

	if( !ob ) ob = me;

	inv = all_inventory(ob);
	if( !sizeof(inv) ) {
		write((ob==me)? "ヘ玡ō⊿Τヴ︙狥﹁\n"
			: ob->name() + "ō⊿Τ拟盿ヴ︙狥﹁\n");
		return 1;
	}
	printf("%sō盿帝硂ㄇ狥﹁ ( 璽 %d%% )\n%s",
		(ob==me)? "": ob->name(),
		(int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance(),
		implode(map_array(inv, "inventory_desc", this_object()), "") );
		

	return 1;
}

string inventory_desc(object ob)
{
	if ( ob->query("equipped") && this_player()->query("env/eqs") )
		return "";
	return sprintf("%s%s\n",
		ob->query("equipped")? HIC "＞" NOR:"  ",
		ob->short()
	);
}

int help (object me)
{
        write(@HELP
Α: inventory
 
(﹑)ヘ玡ō┮拟盿┮Τ珇
 
爹 :  " i " 蠢
 
HELP
);
        return 1;
}
