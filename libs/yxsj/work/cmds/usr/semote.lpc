// semote.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *e, chinese, buf;
  mapping e_map;
  int i;

  seteuid(geteuid(me));
  e = sort_array(EMOTE_D->query_all_emote(), 1);

  buf = "目前的動作(emote)語法有下列﹕\n";
  for (i = 0; i < sizeof(e); i++) {
    e_map = EMOTE_D->query_emote(e[i]);
    buf += sprintf("%-8s %-10s ",
      (stringp(e_map["chinese"]) ?
        replace_string(e_map["chinese"], "\n", "") :
        ""
      ), e[i]
    );
    if (i % 4 == 3) buf += "\n";
  }
  buf += "\n";
  this_player()->start_more(buf);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式﹕semote
 
這個指令可以列出目前所有能使用的動作(emote)語法。
 
相關指令﹕emote . chat* rumor*
HELP
  );
  return 1;
}
