// tune.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string *tuned_ch;

	tuned_ch = me->query("channels");
	if( !arg ) {
		if( !pointerp(tuned_ch) || !sizeof(tuned_ch) )
			write("瞷⊿ΤΜ钮ヴ︙繵笵\n");
		else
			write("瞷Μ钮繵笵" + implode(tuned_ch, ", ") + "\n");
		return 1;
	}

	if( pointerp(tuned_ch) && member_array(arg, tuned_ch)!=-1 ) {
		write("闽超 " + arg + " 繵笵\n");
		tuned_ch -= ({ arg });
		me->set("channels", tuned_ch);
		return 1;
	} else {
		write("璶ゴ秨琘繵笵璶ノ赣繵笵弧杠\n");
		return 1;
	}
}

int help(object me)
{
	write(@HELP
Αtune [<繵笵嘿>]

硂琵匡拒琌璶Μ钮琘繵笵癟狦⊿Τ﹚繵笵嘿碞穦
ヘ玡Μ钮い繵笵狦﹚繵笵ㄓΜ钮い碞穦闽奔はぇゴ秨

狦癸⊿ΤΜ钮い繵笵量杠穦︑笆盢ウゴ秨
璶癸繵笵量杠璶ノ

<繵笵嘿> <癟> ....

ㄒ
  chat hello everyone!
  
ノ help channels 琩高ヘ玡Τㄇ繵笵Μ钮

see also : shout
HELP
	);
	return 1;
}

