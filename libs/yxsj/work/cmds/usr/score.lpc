inherit F_CLEAN_UP;

string *gift_ranking = ({"单", "畉玪", "菠畉", "炊硄", "祔", "ぃ岿", "纔单", "伐ㄎ"});

string bar_string = "〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗〗";
string blank_string = "〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖〖";
//string bar_string = "〈ⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳⅳ";
//string blank_string= "〈";

string display_attr(int gift, int value);
string status_color(int current, int max);
string tribar_graph(int val, int eff, int max, string color);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
	object ob;
	mapping my;
	string line, str, skill_type, condition;
	object weapon;
	int attack_points, dodge_points, parry_points, birthday;

	seteuid(getuid(me));

	if(!arg)
		ob = me;
	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if (!ob) return notify_fail("璶诡街篈\n");
	} else
		return notify_fail("Τ畍诡篈\n");

	my = ob->query_entire_dbase();

	birthday = ((int)ob->query("birthday")) * 60;

	line = sprintf( BOLD "\n%s" NOR "%s\n\n", RANK_D->query_rank(ob), ob->short(1) );
	line += sprintf(HIM + "    琌%s%s烦%s%s秇獿句%sネ\n\n" + NOR,
		ob->query("unit"),
		NOR + CYN + chinese_number(ob->query("age")) + HIM,
		ob->query("gender"),
		NOR + CYN + ob->query("race") + NOR + HIM,
		NOR + CYN + CHINESE_D->chinese_date(birthday) + HIM );


	if( wizardp(me) || (int)ob->query("age") >= 18 ) {
		line += sprintf(
			HIG"籑"NOR"[%s]  "HIG"義醚"NOR"[%s]  "HIG"┦"NOR"[%s]"
			" "HIG"艶┦"NOR"[%s]\n"HIG"﹚"NOR"[%s]  "HIG"甧华"NOR"[%s]"
			"  "HIG"癌"NOR"[%s] "HIG"褐絫"NOR"[%s]\n\n",
			display_attr(my["str"], ob->query_str()),
			display_attr(my["cor"], ob->query_cor()),
			display_attr(my["int"], ob->query_int()),
			display_attr(my["spi"], ob->query_spi()),
			display_attr(my["cps"], ob->query_cps()),
			display_attr(my["per"], ob->query_per()),
			display_attr(my["con"], ob->query_con()),
			display_attr(my["kar"], ob->query_kar()));
/*
			my["str"], my["cor"], my["int"], my["spi"],
			my["cps"], my["per"], my["con"], my["kar"]);

			gift_evaluation(my["str"]), gift_evaluation(my["cor"]),
			gift_evaluation(my["int"]), gift_evaluation(my["spi"]),
			gift_evaluation(my["cps"]), gift_evaluation(my["per"]),
			gift_evaluation(my["con"]), gift_evaluation(my["kar"]));*/
	}

	if( mapp(my["family"]) ) {
		if( my["family"]["master_name"] )
			line = sprintf("%s    畍%s\n\n",
				line, CYN + my["family"]["family_name"] + " " + my["family"]["master_name"] + NOR );
	}

	line += " "HIC"<弘>"NOR"  " + tribar_graph(my["gin"], my["eff_gin"], my["max_gin"], GRN) + "\n";
	line += " "HIC"<>"NOR"  " + tribar_graph(my["kee"], my["eff_kee"], my["max_kee"], HIR) + "\n";
	line += " "HIC"<>"NOR"  " + tribar_graph(my["sen"], my["eff_sen"], my["max_sen"], HIB) + "\n";
/*
	line += sprintf(" 弘 %s%4d/ %4d %s(%3d%%)" NOR "    艶 %s%4d / %4d (+%d)\n" NOR,
		status_color(my["gin"], my["eff_gin"]),	my["gin"],	my["eff_gin"],
		status_color(my["eff_gin"], my["max_gin"]),	my["eff_gin"] * 100 / my["max_gin"],
		status_color(my["atman"], my["max_atman"]),	my["atman"], my["max_atman"],
		my["atman_factor"] );
	line += sprintf("  %s%4d/ %4d %s(%3d%%)" NOR "    ず %s%4d / %4d (+%d)\n" NOR,
		status_color(my["kee"], my["eff_kee"]),	my["kee"], my["eff_kee"],
		status_color(my["eff_kee"], my["max_kee"]),	my["eff_kee"] * 100 / my["max_kee"],
		status_color(my["force"], my["max_force"]),	my["force"], my["max_force"],
		my["force_factor"] );
	line += sprintf("  %s%4d/ %4d %s(%3d%%)" NOR "    猭 %s%4d / %4d (+%d)\n" NOR,
		status_color(my["sen"], my["eff_sen"]),	my["sen"], my["eff_sen"],
		status_color(my["eff_sen"], my["max_sen"]),	my["eff_sen"] * 100 / my["max_sen"],
		status_color(my["mana"], my["max_mana"]), my["mana"], my["max_mana"],
		my["mana_factor"] );
*/


/*	line += sprintf(" %d/%d都%d/%d\n\n",
		my["food"], ob->max_food_capacity(), my["water"], ob->max_water_capacity());
*/
	if( objectp(weapon = ob->query_temp("weapon")) )
		skill_type = weapon->query("skill_type");
	else
		skill_type = "unarmed";

	attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
	parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
	dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

	line += sprintf("\n  "HIG"驹矮ю阑"NOR" " HIW "%d (+%d)" NOR "\t\t"HIG"驹矮ň縨 " HIW "%d (+%d)\n" NOR,
		attack_points/100 + 1, ob->query_temp("apply/damage"),
		(dodge_points + (weapon? parry_points: (parry_points/10)))/100 + 1, ob->query_temp("apply/armor"));

/*	line += " " + tribar_graph(my["food"], ob->max_food_capacity(), ob->max_food_capacity(), YEL) + "\n";
	line += " 都" + tribar_graph(my["water"], ob->max_water_capacity(), ob->max_water_capacity(), CYN) + "\n";
*/

    if(ob->query_condition("drunk")>(ob->query("con")+(int)ob->query("max_force")/50)*2)
		condition=HIY"皊綤"NOR;
    else if((ob->query("max_kee")*0.2)>ob->query("kee") )
		condition=HIR"端"NOR;
    else 
		condition=NOR"タ盽";

	line += sprintf("\n    ヘ玡ゎ羆炳 "HIR"%d"NOR" ㄤいΤ "HIR"%d"NOR" 琌ㄤ產\n",
		my["MKS"] + my["PKS"], my["PKS"]);

	line += sprintf("    "HIC"炳    "NOR" " HIR "%d\n" NOR, ob->query("bellicosity") );
	line += sprintf("    "HIC"厩策肩"NOR" " HIY "%d (%d%%)\n" NOR,
		(int)ob->query("potential") - (int)ob->query("learned_points"),
		(1 + (int)ob->query("learned_points")) * 100 / (1 + (int)ob->query("potential")) );

	line += sprintf("    "HIC"猌    砃"NOR" " HIM "%d\n" NOR, ob->query("combat_exp") );
	line += sprintf("    "HIC"羘    辨"NOR" " HIC "%d\n" NOR, ob->query("score") );
	line += sprintf("    "HIC"ヘ玡篈"NOR" " HIC "%s\n" NOR, condition );

	write(line);
	return 1;
}

string rank_gift(int value)
{
	int grade;
	grade = (value - 10) / (20 / 7);
	if( grade >= sizeof(gift_ranking) )
		grade = sizeof(gift_ranking)-1;
	return gift_ranking[grade];
}

string display_attr(int gift, int value)
{
	if( value > gift ) return sprintf( HIY "%s" NOR, rank_gift(value) );
	else if( value < gift ) return sprintf( CYN "%s" NOR, rank_gift(value) );
	else return sprintf("%s", rank_gift(value) );
}

string status_color(int current, int max)
{
	int percent;

	if( max ) percent = current * 100 / max;
	else percent = 100;

	if( percent > 100 ) return HIC;
	if( percent >= 90 ) return HIG;
	if( percent >= 60 ) return HIY;
	if( percent >= 30 ) return YEL;
	if( percent >= 10 ) return HIR;
	return RED;
}

string tribar_graph(int val, int eff, int max, string color)
{
	return color + bar_string[0..(val*25/max)*2-1]
		+ ((eff > val) ? blank_string[(val*25/max)*2..(eff*25/max)*2-1] : "") + NOR;
}

