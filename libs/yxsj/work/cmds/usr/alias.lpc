// alias.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int i;
	mapping alias;
	string verb, replace, *vrbs;

	if( !arg ) {
		alias = me->query_all_alias();
		if( !sizeof(alias) ) {
			write("ヘ玡⊿Τ砞﹚ヴ︙ alias\n");
			return 1;
		} else  {
			write("ヘ玡砞﹚ alias Τ\n");
			vrbs = keys(alias);
			for(i=0; i<sizeof(vrbs); i++)
				printf("%-15s = %s\n", vrbs[i], alias[vrbs[i]]);
			return 1;
		}
	}

	if( sscanf(arg, "%s %s", verb, replace)!=2 )
		me->set_alias(arg, 0);
	else if( verb=="alias" )
		return notify_fail("ぃ盢 \"alias\" 砞﹚ㄤノ硚\n");
	else if( verb=="" )
		return notify_fail("璶砞ぐ或 alias\n");
	else
		return me->set_alias(verb, replace);

	write("Ok.\n");
	return 1;
}

int help (object me)
{
	write(@HELP
Α : alias <饼砞﹚ぇ> <╰参矗ㄑぇ>
 
Τ╰参┮矗ㄑぇ惠璶块﹃, ㄏノ(ぷㄤ琌竒盽ノ)
┪砛穦稰谋ぃよ獽, (﹑)ノ砞﹚蠢Τぇ
 
絛ㄒ:
	'alias sc score' 穦 sc  score 
	'alias' ぃ把计玥┮Τ蠢
	'alias sc' 穦埃 sc 硂蠢 (狦Τ砞杠)
 
ㄤいノ $1, $2, $3 .... ㄓ材材材把计┪琌 $* 
┮Τ把计
	'alias pb put $1 in $2'

玥–讽(﹑)ゴ
	pb bandage bag

碞穦Θ
	put bandage in bag
	
HELP
);
        return 1;
}
