// skills.c

#include <ansi.h>

inherit F_CLEAN_UP;

string *skill_level_desc = ({
  HIB "若有若無" NOR,
  HIB "初學乍練" NOR,
  HIC "粗通皮毛" NOR,
  HIC "半生不熟" NOR,
  HIC "馬馬虎虎" NOR,
  HIG "駕輕就熟" NOR,
  HIG "得心應手" NOR,
  HIY "觸類旁通" NOR,
  HIY "隨心所欲" NOR,
  HIY "技壓群雄" NOR,
  /* 100+ */
  HIC "出類拔萃" NOR,
  HIC "無以倫比" NOR,
  HIC "宏遠無儔" NOR,
  HIY "神乎其技" NOR,
  HIY "出神入化" NOR,
  HIC "登峰造極" NOR,
  HIW "一代宗師" NOR,
  HIW "萬夫莫敵" NOR,
  HIW "驚世駭俗" NOR,
  HIW "深不可測" NOR
});

string *knowledge_level_desc = ({
  HIB "新學乍用" NOR,
  HIB "初窺門徑" NOR,
  HIB "略知一二" NOR,
  HIC "馬馬虎虎" NOR,
  HIC "已有小成" NOR,
  HIG "心領神會" NOR,
  HIG "了然於胸" NOR,
  HIG "豁然貫通" NOR,
  HIC "舉世無雙" NOR,
  HIC "震古鑠今" NOR,
  /* 100+ */
  HIW "學富五車" NOR,
  HIW "一代鴻儒" NOR,
  HIW "光風霽月" NOR,
  HIW "國士無雙" NOR,
  HIW "言泉百氏" NOR,
  HIW "握素懷鉛" NOR,
  HIW "通經制用" NOR,
  HIW "深不可測" NOR
});

string skill_level(string, int);

int main(object me, string arg) {
  object ob;
  mapping skl, lrn, map;
  string *sname, *mapped;
  int i;

  seteuid(getuid());

  if (!arg)
    ob = me;
  else {
    ob = present(arg, environment(me));
    //        if ( ob->query("SPSKILLS",1)  ) return ob->skills();		 
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看誰的技能﹖\n");
  }

  if (ob != me && !wizardp(me) && !ob->is_apprentice_of(me)
    && !me->is_apprentice_of(ob))
    return notify_fail("只有巫師或有師徒關係的人能察看他人的技能。\n");

  skl = ob->query_skills();
  if (!sizeof(skl)) {
    write((ob == me ? "你" : ob->name()) + "目前並沒有學會任何技能。\n");
    return 1;
  }
  write((ob == me ? "你" : ob->name()) + "目前所學過的技能﹕\n\n");
  sname = sort_array(keys(skl), (: strcmp :));

  map = ob->query_skill_map();
  if (mapp(map)) mapped = values(map);
  if (!mapped) mapped = ({});

  lrn = ob->query_learned();
  if (!mapp(lrn)) lrn = ([]);

  for (i = 0; i < sizeof(skl); i++) {
    printf("%s%s%-40s" NOR " - " HIR "[" NOR "%-10s" HIR "]" NOR " %3d/%5d\n",
      (lrn[sname[i]] >= (skl[sname[i]] + 1) * (skl[sname[i]] + 1)) ? HIM : "",
      (member_array(sname[i], mapped) == -1 ? "  " : HIY "ˇ" NOR),
      to_chinese(sname[i]) + " (" + sname[i] + ")",
      skill_level(SKILL_D(sname[i])->type(), skl[sname[i]]),
      skl[sname[i]], (int)lrn[sname[i]],
    );
  }
  write("\n");
  return 1;
}

string skill_level(string type, int level) {
  int grade;

  grade = level / 10;

  switch (type) {
    case "knowledge":
      grade = grade;
      if (grade >= sizeof(knowledge_level_desc))
        grade = sizeof(knowledge_level_desc) - 1;
      return knowledge_level_desc[grade];
    default:
      grade = grade;
      if (grade >= sizeof(skill_level_desc))
        grade = sizeof(skill_level_desc) - 1;
      return skill_level_desc[grade];
  }
}

int help(object me) {
  write(@HELP
指令格式 : skills [<某人>]

這個指令可以讓你(妳)查詢所學過的技能。

你也可以指定一個和你有師徒關係的對象﹐用 skills 可以查知對方的技能狀況。

巫師可以查詢任何人或 NPC 的技能狀況。

HELP
  );
  return 1;
}
