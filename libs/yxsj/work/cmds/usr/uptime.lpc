// uptime.c

inherit F_CLEAN_UP;

// This command is also called by LOGIN_D, so we don't want it use 
// arguments.
int main()
{
	int t, d, h, m, s;
	string time;

	t = uptime();
	s = t % 60;		t /= 60;
	m = t % 60;		t /= 60;
	h = t % 24;		t /= 24;
	d = t;

	if(d) time = chinese_number(d) + "ぱ";
	else time = "";

	if(h) time += chinese_number(h) + "";
	if(m) time += chinese_number(m) + "だ";
	time += chinese_number(s) + "\n";

write("[1;33m秇獿[1;36m竒币笆"+time+"[m\n");
	return 1;
}

int help(object me)
{
	write(@HELP
Α : uptime
 
硂禗竡竒硈尿磅︽.
 
HELP
    );
    return 1;
}

