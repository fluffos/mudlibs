// reply.c

#include <ansi.h>
#include <net/dns.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string target, mud;
	object obj;

	if( !arg || arg=="" )
		return notify_fail("璶氮ぐ或\n");

	if( !stringp(target = me->query_temp("reply")) )
		return notify_fail("⊿Τ㎝弧筁杠\n");

	if( sscanf(target, "%s@%s", target, mud)==2 ) {
		GTELL->send_gtell(lower_case(mud), lower_case(target), me, arg);
		write("呼隔癟癳璶祔眔莱\n");
		return 1;
	}

	obj = find_player(target);
	if( !obj )
		return notify_fail("㎝弧杠瞷礚猭钮ǎ┪竒瞒秨笴栏\n");
	write(GRN "氮" + obj->name(1) + "" + arg + "\n" NOR);
	tell_object(obj, sprintf(GRN"%s氮%s\n"NOR,
		me->name(1), arg ));

	obj->set_temp("reply", me->query("id"));
	return 1;
}

int help(object me)
{
	write(@HELP
Αreply <癟>

ノ硂㎝ノ tell ㎝弧杠ㄏノ弧杠

see also : tell
HELP
	);
	return 1;
}
