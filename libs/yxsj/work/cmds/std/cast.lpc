// cast.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string spells, spl, trg;
	object target;
	
	seteuid(getuid());

	if( me->is_busy() )
		return notify_fail("( 笆临⊿ΤЧΘぃ├〨ゅ)\n");

	if( environment(me)->query("no_magic") )
		return notify_fail("硂柑ぃ├〨ゅ\n");

	if( !arg ) return notify_fail("Αcast <猭砃> [on <ヘ夹>]\n");
	if( sscanf(arg, "%s on %s", spl, trg)==2 ) {
		target = present(trg, environment(me));
		if( !target ) target = present(trg, me);
		if( !target ) return notify_fail("硂柑⊿Τ " + trg + "\n");
	} else {
		spl = arg;
		target = 0;
	}

	spl = replace_string( spl, " ", "_");

	if( stringp(spells = me->query_skill_mapped("spells")) )
		return (int)SKILL_D(spells)->cast_spell(me, spl, target);
		
	return notify_fail("叫ノ enable 匡拒璶ㄏノ〨ゅ╰\n");
}

int help (object me)
{
        write(@HELP
Αcast <〨ゅ嘿> [on <琁〨癸禜>]
 
琁猭ゲ惠璶﹚<〨ゅ嘿><琁〨癸禜>玥Τ礚
ㄏノ琘〨ゅぇ玡ゲ斗ノ enable ㄓ﹚璶ㄏノ〨ゅ╰
 
爹狦э跑︑〨ゅ╰セ籛縩猭ぃ钡锣传筁ゲ斗
    眖 0 秨﹍
 
HELP
        );
        return 1;
}
