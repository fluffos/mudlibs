// buy.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string item, targ;
	object ob, owner;
	int price, afford;

	if( !arg || sscanf(arg, "%s from %s", item, targ)!=2 )
		return notify_fail("Αbuy <琘> from <琘>\n");

	if( !objectp(owner = present(targ, environment(me))) )
		return notify_fail("璶蛤街禦狥﹁\n");

	if( userp(owner) ) {
		message_vision("$N稱$n潦禦" + item + "\n", me, owner);
		return 1;
	}

	notify_fail("癸よ钩ぃ腀種蛤ユ\n");
	if( (price = owner->buy_object(me, item)) < 1 ) return 0;

	if( afford = me->can_afford(price) ) {
		if( afford==2 ) 
			return notify_fail("⊿Τì镑箂窥τ癸よтぃ秨...\n");
		me->pay_money(price, 0);
		owner->compelete_trade(me, item);
		return 1;
	} else
		return notify_fail("窥ぃ镑\n");
}

int help(object me)
{
   write( @HELP
Α: buy <something> from <someone>

硂琵眖琘ㄇō禦珇
HELP
   );
   return 1;
}
