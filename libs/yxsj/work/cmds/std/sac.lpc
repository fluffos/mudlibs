inherit F_VENDOR;
inherit F_CLEAN_UP;

int main(object me, string str)
{
	object ob,amount,new_money;
	int money;

	if( me->is_fighting())
		return notify_fail("瞷⊿\n");
        if(!str) return notify_fail("璶膍ぐ或狥﹁倒ぱ?\n");
        ob=present(str,environment(me));
        if(!ob) ob=present(str,me);
        if(!ob) return notify_fail("硂よ㎝ō⊿Τ硂兜珇\n");
        if(ob==me) {
message_vision("$N稱盢︑膍倒ぱ琌钩⊿瞶窧\n",me);
                return 1;
        }
        if(ob->query("money_id")) return
notify_fail("ぱ琌ぃ钡窥\n");

if(!ob->is_corpse()) 
{
        if(ob->is_character()) return
notify_fail("埃獶玥稱!\n");
}

	if(ob->query("no_sac")) return notify_fail("硂兜珇礚猭膍\n");
        if(ob->query("equipped")) return
notify_fail("ゲ惠盢硂兜珇秆埃杆称\n");
        money=ob->query("value")/(random(3)+7);
        if(money<1) money=1;

	message_vision("$N蛮渐各癅港盢["+ob->short()+"]膍倒ぱ...\n",me);
        write("ぱ倒"+price_string(money)+"贱洁\n");
	  if(ob->is_container())
		all_inventory(ob)->move(environment(ob));
        destruct(ob);
	me->pay_money(-money);

        return 1;

}

int help(object me)
{
        write(@HELP
Α: sac <thing>

讽Τ筁┪ぃ惠璶珇盢ウ膍倒ぱ
讽礛穦眔ㄇ砛厨

HELP
);
        return 1;
}
