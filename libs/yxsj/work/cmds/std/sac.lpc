// sacrifice modify by 幽魂 ghoster@ms14.url.com.tw 1999.07.28

inherit F_VENDOR;
inherit F_CLEAN_UP;

int main(object me, string str) {
  object ob, amount, new_money;
  int money;

  if (me->is_fighting())
    return notify_fail("你現在沒空﹗\n");
  if (!str) return notify_fail("你要奉獻什麼東西給天神?\n");
  ob = present(str, environment(me));
  if (!ob) ob = present(str, me);
  if (!ob) return notify_fail("這個地方和你的身上並沒有這項物品。\n");
  if (ob == me) {
    message_vision("$N想將自己奉獻給天神，但是好像沒人理睬。\n", me);
    return 1;
  }
  if (ob->query("money_id")) return notify_fail("天神是不接受金錢的。\n");

  if (!ob->is_corpse()) {
    if (ob->is_character()) return notify_fail("除非他死了，否則別想!\n");
  }

  if (ob->query("no_sac")) return notify_fail("這項物品無法奉獻。\n");
  if (ob->query("equipped")) return notify_fail("你必需先將這項物品解除裝備。\n");
  money = ob->query("value") / (random(3) + 7);
  if (money < 1) money = 1;

  message_vision("$N雙膝跪地，很虔誠地將[" + ob->short() + "]奉獻給天神...\n", me);
  write("天神給你" + price_string(money) + "作為獎賞。\n");
  if (ob->is_container())
    all_inventory(ob)->move(environment(ob));
  destruct(ob);
  me->pay_money(-money);

  return 1;

}

int help(object me) {
  write(@HELP
指令格式: sac <thing>

當你有過多或不需要的物品，可以將它奉獻給天神。
當然，你也會得到些許的回報。

HELP
  );
  return 1;
}
