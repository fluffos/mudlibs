// surrender.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	
	if( !me->is_fighting() )
		return notify_fail("щ瞷⊿Τゴ摆....\n");

	ob = me->query_temp("last_opponent");
	if( objectp(ob) && living(ob) && ob->is_killing(me) ) {
		message_vision("$N$n―那琌$N羘弧笵"
			+ RANK_D->query_rude(me) + "紀杠ぶ弧㏑ㄓ\n", ob, me);
		return 1;
	}

	me->remove_all_enemy();
	if( (int)me->query("score") >= 50 )
		me->add("score", -50 );
	else
		me->set("score", 0);

	message_vision( HIW "\n$N弧笵ぃゴぃゴищ....\n\n" NOR, me);
	return 1;
}
int help(object me)
{
  write(@HELP
Α : surrender
 
硂琵寄щτ沧ゎ驹矮
 
HELP
    );
    return 1;
}
 
