// learn.c

#include <skill.h>

inherit F_CLEAN_UP;

string *reject_msg = ({
	"弧笵眤び硂或幢讽\n",
	"钩琌胐璝佩妓弧笵叫毙硂或幢讽\n",
	"帝弧笵眤ǎи硂翴繨挛м镑戈翴眤ぐ或\n",
});

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string skill, teacher, master;
	object ob;
	int master_skill, my_skill, gin_cost;
	if(!arg || sscanf(arg, "%s from %s", skill, teacher)!=2 )
		return notify_fail("Αlearn <м> from <琘>\n");

	if( me->is_fighting() )
		return notify_fail("羬皚縤簀ㄓぃの罢\n");

	if( !(ob = present(teacher, environment(me))) || !ob->is_character())
		return notify_fail("璶街―毙\n");

	if( !living(ob) )
		return notify_fail("垛....眔р" + ob->name() + "眶弧\n");

	if( !me->is_apprentice_of(ob) ) {
		if( (string)me->query("family/family_name") != (string)ob->query("family/family_name")
		||	(int)ob->query("family/privs") != -1 ) {
			notify_fail( ob ->name() + reject_msg[random(sizeof(reject_msg))] );
			if( !(ob->recognize_apprentice(me)) ) return 0;
		}
	}

	if( !master_skill = ob->query_skill(skill, 1) )
		return notify_fail("硂兜м┤ゲ斗т厩\n");

	notify_fail(ob->name() + "ぃ腀種毙硂兜м\n");
	if( ob->prevent_learn(me, skill) )
		return 0;

	my_skill = me->query_skill(skill, 1);
	if( my_skill >= master_skill )
		return notify_fail("硂兜м祘竒ぃ块畍\n");

	notify_fail("ㄌヘ玡⊿Τ快猭厩策硂贺м\n");
	if( !SKILL_D(skill)->valid_learn(me) ) return 0;

	gin_cost = 150 / (int)ob->query("int") + 150 / (int)me->query("int");

	if( !my_skill ) {
		gin_cost *= 2;
		me->set_skill(skill,0);
	}

	if( (int)me->query("learned_points") >= (int)me->query("potential") )
		return notify_fail("肩竒祇揣伐⊿Τ快猭Θ\n");
	printf("%s叫毙Τ闽%s好拜\n", ob->name(),
		to_chinese(skill));

	if( ob->query("env/no_teach") )
		return notify_fail("琌" + ob->name() + "瞷ぃ非称氮拜肈\n");

	tell_object(ob, sprintf("%s叫毙Τ闽%s拜肈\n",
		me->name(), to_chinese(skill)));

	if( (int)ob->query("sen") > gin_cost/5 + 1 ) {
		if( userp(ob) ) ob->receive_damage("sen", gin_cost/5 + 1);
	} else {
		write("琌" + ob->name() + "陪礛び仓⊿Τ快猭毙ぐ或\n");
		tell_object(ob, "琌び仓⊿Τ快猭毙" + me->name() + "\n");
		return 1;
	}
		

	if( (int)me->query("gin") > gin_cost ) {
		if( (string)SKILL_D(skill)->type()=="martial"
		&&	my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp") ) {
			printf("砛\琌龟驹竒喷癸%s氮羆琌礚猭烩穦\n", ob->name() );
		} else {
			printf("钮%s旧Τㄇみ眔\n", ob->name());
			me->add("learned_points", 1);
			me->improve_skill(skill, random(me->query("int")));
		}
	} else {
		gin_cost = me->query("gin");
		write("さぱび仓挡狦ぐ或⊿Τ厩\n");
	}

	me->receive_damage("gin", gin_cost );

	return 1;
}

int help(object me)
{
        write(@HELP
Α : learn <м> from <琘>
 
硂琵叫毙Τ闽琘贺м好螟拜肈讽礛叫毙癸禜硂
兜м硑岗ゲ斗ゑ蔼τ竒パ硂贺よΑ厩策眔ㄓмぃ蔼┮叫
毙礛τ硂贺厩策よΑ讽贺竒喷肚┯厩策弧琌剪眡
贺穝м程еよ猭

硄盽厩贺穝м琌ぃ穦Τぐ或好螟拜肈τ琌竒パ龟悔莱ノい
綝笿拜肈硂ㄇ拜肈癸厩策贺穝м筁祘琌璶ぷㄤ琌贺ㄤм
膀娄膀セм惠璶竒パ祇瞷拜肈秆∕拜肈筁祘眔耕狦
и盢硂贺祇瞷拜肈筁祘ノ肩芠├ボ镑︑祇瞷琘ㄇ拜
肈ボ()Τ秆∕硂兜拜肈肩讽ㄣΤ硂妓肩碞ノ硂
ㄓㄤ叫毙τ莉眔秈˙
(PS. 肩临Τㄤ約竡﹚竡硂柑琌ㄤいぇ )

厩策惠璶ㄇ弘τ弘蛤︑籔厩策癸禜┦Τ闽

︓︙笵眖癸よ厩ぐ或м狦癸よ琌畍ノ skills 
钡琩狦ぃ琌畍ê或硄盽穦Τㄤ矗ボ︑稱快猭

ㄤ闽 : practicestudy
HELP
        );
        return 1;
}
