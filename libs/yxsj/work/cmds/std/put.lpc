// put.c

inherit F_CLEAN_UP;

int do_put(object me, object obj, object dest);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string target, item;
	object obj, dest, *inv, obj2;
	int i, amount;

	if(!arg) return notify_fail("璶盢ぐ或狥﹁秈柑\n");

	if( sscanf(arg, "%s in %s", item, target)!=2 )
		return notify_fail("璶倒街ぐ或狥﹁\n");

	dest = present(target, me);
	if( !dest || living(dest) ) dest = present(target, environment(me));
	if( !dest || living(dest) )
		return notify_fail("硂柑⊿Τ硂妓狥﹁\n");

	if(sscanf(item, "%d %s", amount, item)==2) {
		if( !objectp(obj = present(item, me)) )
			return notify_fail("ō⊿Τ硂妓狥﹁\n");
		if( !obj->query_amount() )
			return notify_fail( obj->name() + "ぃ砆だ秨\n");
		if( amount < 1 )
			return notify_fail("狥﹁计秖︓ぶ琌\n");
		if( amount > obj->query_amount() )
			return notify_fail("⊿Τê或" + obj->name() + "\n");
		else if( amount == (int)obj->query_amount() )
			return do_put(me, obj, dest);
		else {
			obj->set_amount( (int)obj->query_amount() - amount );
			obj2 = new(base_name(obj));
			obj2->set_amount(amount);
			return do_put(me, obj2, dest);
		}
	}

	if(item=="all") {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
			if( inv[i] != dest ) do_put(me, inv[i], dest);
		write("Ok.\n");
		return 1;
	}

	if(!objectp(obj = present(item, me)))
		return notify_fail("ō⊿Τ硂妓狥﹁\n");
	return do_put(me, obj, dest);
}

int do_put(object me, object obj, object dest)
{
	if( obj->move(dest) ) {
		message_vision( sprintf("$N盢%s%s秈%s\n",
			obj->query("unit"), obj->name(), dest->name()),
			me );
		return 1;
	}
	else return 0;
}

int help(object me)
{
write(@HELP
Α : put <珇嘿> in <琘甧竟>
 
硂琵盢琘妓珇秈甧竟讽礛璶局Τ硂妓珇
 
HELP
    );
    return 1;
}
