// stop.c

#include "/doc/help.h"
inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!me->is_fighting())
    return notify_fail("你現在並沒有在戰鬥。\n");
  me->remove_all_enemy();
  message_vision("$N縱身一躍，脫離了這場戰局。\n", me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: stop

可以停止你(妳)與別人的戰鬥，但別人
可能會搶到先機攻擊。
HELP
  );
  return 1;
}
