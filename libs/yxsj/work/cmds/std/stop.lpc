// stop.c

#include "/doc/help.h"
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if( !me->is_fighting() )
		return notify_fail("瞷⊿Τ驹矮\n");
	me->remove_all_enemy();
	message_vision("$N羇ō臘叉瞒硂初驹Ы\n", me);
	return 1;
}

int help(object me)
{
   write(@HELP
Α: stop

氨ゎ(﹑)籔驹矮
穦穖诀ю阑
HELP
   );
   return 1;
}
