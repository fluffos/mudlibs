// enable.c

#include <ansi.h>

inherit F_CLEAN_UP;

mapping valid_types = ([
	"unarmed":	"竲",
	"sword":	"糃猭",
	"blade":	"猭",
	"stick":	"匆猭",
	"staff":	"猭",
	"throwing":	"穞竟",
	"force":	"ず\",
	"parry":	"┷琜",
	"dodge":	"淮\",
	"magic":	"猭砃",
	"spells":	"〨ゅ",
	"move":		"︽笆",
	"array":	"皚猭",
    "whip":     "聾猭",
]);

int main(object me, string arg)
{
	mapping map;
	string *types, *skill, ski, map_to;
	int i, modify;

	seteuid(getuid());

	if( !arg ) {
		map = me->query_skill_map();
		if( !mapp(map) || sizeof(map)==0 )
			return notify_fail("瞷⊿Τㄏノヴ︙疭м\n");

		skill = keys(valid_types);
		write("琌ヘ玡ㄏノい疭м\n");
		for (i=0; i<sizeof(skill); i++) {
			if( undefinedp(valid_types[skill[i]]) ) {
				map_delete(map, skill[i]);
				continue;
			}
			if( !me->query_skill(skill[i]) ) continue;
			modify = me->query_temp("apply/" + skill[i]);
			printf("  %-20s %-20s  Τ单%s%3d\n" NOR, 
				valid_types[skill[i]] + " (" + skill[i] + ")",
				undefinedp(map[skill[i]]) ? "礚" : to_chinese(map[skill[i]]),
				(modify==0 ? "" : (modify>0 ? HIC : HIR)),
				me->query_skill(skill[i]));
		}
		return 1;
	}

	if( arg=="?" ) {
		write("琌ㄏノ疭м贺摸\n");
		skill = sort_array(keys(valid_types), (: strcmp :) );
		for(i=0; i<sizeof(skill); i++) {
			printf("  %s (%s)\n", valid_types[skill[i]], skill[i] );
		}
		return 1;
	}

	if( sscanf(arg, "%s %s", ski, map_to)!=2 )
		return notify_fail("Αenable [<м贺摸> <м嘿>|none]\n");

	if( undefinedp(valid_types[ski]) )
		return notify_fail("⊿Τ硂м贺摸ノ enable ? 琩Τㄇ贺摸\n");

	if( map_to=="none" ) {
		me->map_skill(ski);
		me->reset_action();
		write("Ok.\n");
		return 1;
	} else if( map_to==ski ) {
		write("" + to_chinese(ski) + "琌┮Τ" + valid_types[ski] + "膀娄ぃ惠璶 enable\n");
		return 1;
	}

	if( !me->query_skill(map_to, 1) )
		return notify_fail("ぃ穦硂贺м\n");

//	if( !me->query_skill(ski, 1) )
//		return notify_fail("硈" + to_chinese(ski) + "常⊿厩穦矗"
//			+ to_chinese(map_to) + "\n");

	if( !SKILL_D(map_to)->valid_enable(ski) )
		return notify_fail("硂мぃ讽Θ硂贺ノ硚\n");

	me->map_skill(ski, map_to);
	me->reset_action();
	write("Ok.\n");
	
	if( ski=="magic" ) {
		write("эノ贺猭砃╰艶ゲ斗穝岭铃\n");
		me->set("atman", 0);
		me->receive_damage("gin", 0);
	} else if( ski=="force" ) {
		write("эノ贺ず\ずゲ斗穝岭铃\n");
		me->set("force", 0);
		me->receive_damage("kee", 0);
	} else if( ski=="spells" ) {
		write("эノ贺〨ゅ╰猭ゲ斗穝芬\n");
		me->set("mana", 0);
		me->receive_damage("sen", 0);
	}

	return 1;
}
int help(object me)
{
        write(@HELP
Α : enable [<м贺摸> <м嘿> | none]
           enable ?

硂琵﹚┮璶ノм惠м贺摸㎝м嘿狦ぃ把
计玥穦陪ボм贺摸のヘ玡┮ㄏノм嘿 狦 ? 穦
┮Τㄏノ疭мм贺摸
 
HELP
        );
        return 1;
}
