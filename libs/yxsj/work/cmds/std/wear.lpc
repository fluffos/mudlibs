// wear.c

#include <ansi.h>

inherit F_CLEAN_UP;

int do_wear(object me, object ob);

int main(object me, string arg)
{
	object ob, *inv;
	int i, count;

	if( !arg ) return notify_fail("璶拦ぐ或\n");

	if(arg=="all") {
		inv = all_inventory(me);
		for(count=0, i=0; i<sizeof(inv); i++) {
			if( inv[i]->query("equipped") ) continue;
			if(do_wear(me, inv[i]) ) count ++;
		}
		write("Ok.\n");
		return 1;
	}

	if( !objectp(ob = present(arg, me)) )
		return notify_fail("ō⊿Τ硂妓狥﹁\n");

	if( ob->query("equipped") )
		return notify_fail("竒杆称帝\n");

	return do_wear(me, ob);
}

int do_wear(object me, object ob)
{
	string str;

	if( ob->query("female_only")
	&&	(string)me->query("gender") != "┦" )
		return notify_fail("硂琌︾璵╧稱槽ぃ槽\n");

	if( ob->wear() ) {
		if( !stringp(str = ob->query("wear_msg")) )
			switch( ob->query("armor_type") ) {
				case "cloth":
				case "armor":
				case "boots":
					str = YEL "$N" + ob->query("unit") + "$n\n" NOR;
					break;
				case "head":
				case "neck":
				case "wrists":
				case "finger":
				case "hands":
					str = YEL "$N拦" + ob->query("unit") + "$n\n" NOR;
					break;
				case "waist":
					str = YEL "$N盢" + ob->query("unit") + "$n竕竬丁\n" NOR;
					break;
				default:
					str = YEL "$N杆称$n\n" NOR;
			}
		message_vision(str, me, ob);
		return 1;
	} else
		return 0;
}

int help(object me)
{
	write(@HELP
Αwear <杆称嘿>
 
硂琵杆称琘ンňㄣ
 
HELP
    );
    return 1;
}
