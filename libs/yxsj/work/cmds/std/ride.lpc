//ride.c

inherit F_CLEAN_UP;

int do_ride(object me, object obj);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object obj, *inv, obj2;
        int i, amount;
        string item,ridon;

	if(arg=="off") {
		if( !(me->query_temp("ridon")) )
			return notify_fail("⊿ΤГヴ︙狥﹁\n");
		message_vision("$N眖"+me->query_temp("ridon")+"铬ㄓ\n",me);
		obj = me->query_temp("ridon_obj");
		obj->move(environment(me));
		me->set_temp("apply/dodge", me->query_temp("apply/dodge")-obj->query("prop/dodge"));
		me->set_temp("apply/move", me->query_temp("apply/move")-obj->query("prop/move"));
		this_player()->delete_temp("ridon");
		this_player()->delete_temp("ridon_obj");
		return 1;
	}
	if( me->query_temp("ridon") )
		return notify_fail("瞷タГ"+me->query_temp("ridon")+"\n");
      if(!arg) return notify_fail("璶Гぐ或狥﹁\n");

                if( !objectp(obj = present(arg, environment(me))) )
                        return notify_fail("⊿Τ硂妓狥﹁\n");
                if(!obj->query("ridable") )
                        return notify_fail("硂狥﹁ぃГ\n");
		if( me->query_skill("ride") < obj->query("skill_limit") )
		{
			message_vision("$N沽刚帝璶Г"+obj->query("name")+",琌竒喷ぃì,眖"+obj->query("name")+"篖ㄓ\n", me);
			me->receive_damage("kee", 10);
			return 1;
		}

	return do_ride(me, obj);
}

int do_ride(object me, object obj)
{
	mixed no_drop;
	object ob;

	ob = obj;
	if( ob->is_character() )
		message_vision("$N┕$n肕\n", me, ob);
	else
		message_vision( "$NГ$n\n", me, ob );

me->set_temp("ridon",obj->query("name"));
me->set_temp("ridon_obj", base_name(obj));
me->set_temp("apply/dodge", me->query_temp("apply/dodge")+obj->query("prop/dodge"));
me->set_temp("apply/move", me->query_temp("apply/move")+obj->query("prop/move"));
destruct(obj);
                return 1;
        }

int help(object me)
{
        write(@HELP
Α : ride(Г) <ネ,珇>
ride <off> ぃГ
 
HELP
    );
    return 1;
}
 
