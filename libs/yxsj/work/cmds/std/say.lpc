// say.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if (!arg) {
		write("︑ē︑粂ぃ笵弧ㄇぐ或\n");
		message("sound", me->name() + "︑ē︑粂ぃ笵弧ㄇぐ或\n",
			environment(me), me);
		return 1;
	}
	if( (int)me->query("kee") < (int)me->query("max_kee") / 5 ) {
		arg = replace_string(arg, " ", " ... ") + " ...";
	}

	write( HIC "弧笵"+GRN+ arg + "\n" NOR);
	message("sound", HIC + me->name() + "弧笵"+GRN+  arg + "\n" NOR,
		environment(me), me);

	// The mudlib interface of say
	all_inventory(environment(me))->relay_say(me, arg);

	return 1;
}

int help (object me)
{
	write(@HELP
Α: say <癟>
 
弧杠┮Τ蛤┬丁常穦钮弧杠
 
爹: セノ ' .
 
HELP
	);
	return 1;
}
