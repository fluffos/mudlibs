// apprentice.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob, old_app;
	mapping family, skills;
	int i;
	string *skname;

	if( !arg ) return notify_fail("Αapprentice [cancel]|<癸禜>\n");

	if( arg=="cancel" ) {
		old_app = me->query_temp("pending/apprentice");
		if( !objectp(old_app) )
			return notify_fail("瞷⊿Τヴ︙畍種\n");
		write("э跑種ぃ稱" + old_app->name() + "畍\n");
		tell_object(old_app, me->name() + "э跑種ぃ稱畍\n");
		me->delete_temp("pending/apprentice");
		return 1;
	}

	if( !(ob = present(arg, environment(me)))
	||	!ob->is_character() )
		return notify_fail("稱街畍\n");

	if( !living(ob) ) return notify_fail("ゲ斗р" + ob->name() + "眶\n");

	if( ob==me ) return notify_fail("︑畍種....ぃ筁⊿Τノ\n");

	if( me->is_apprentice_of(ob) ) {
		message_vision("$N穛穛$n絎繷叫笵畍\n", me, ob);
		return 1;
	}

	if( !mapp( ob->query("family") ) )
		return notify_fail(ob->name() + "琂ぃ妮ヴ︙⊿Τ秨ミぃ畍\n");

	// If the target is willing to recruit us already, we do it.
	if( (object)ob->query_temp("pending/recruit") == me ) {

		if( (string)me->query("family/family_name") != (string)ob->query("family/family_name") ) {
			message_vision(
				"$N∕﹚璉玵畍эщ$n\n\n"
				"$N各ㄓ$n穛穛絎臫繷笵畍\n\n",
				me, ob);
			me->set("score", 0);
			me->add("betrayer", 1);
		} else
			message_vision(
				"$N∕﹚$n畍\n\n"
				"$N各ㄓ$n穛穛絎臫繷笵畍\n\n",
				me, ob);

		ob->recruit_apprentice(me);
		ob->delete_temp("pending/recruit");

		tell_object(ob, "尺穝Μ\n");
		family = me->query("family");
		printf("尺眤Θ%s材%s\n", me->query("family/family_name"),
			chinese_number( me->query("family/generation")));

		return 1;
	
	} else {

		old_app = me->query_temp("pending/apprentice");
		if( ob==old_app )
			return notify_fail("稱" + ob->name() + "畍琌癸よ临⊿Τ氮莱\n");
		else if( objectp(old_app) ) {
			write("э跑種ぃ稱" + old_app->name() + "畍\n");
			tell_object(old_app, me->name() + "э跑種ぃ稱畍\n");
		}

		message_vision("$N稱璶$n畍\n", me, ob);
		me->set_temp("pending/apprentice", ob );
		if( userp(ob) ) {
			tell_object(ob, YEL "狦腀種Μ" + me->name() + "ノ recruit \n" NOR);
		} else 
			ob->attempt_apprentice(me);
	
		return 1;
	}
}


int help(object me)
{
        write(@HELP
Α : apprentice [cancel]|<癸禜>
 
硂琵琘畍狦癸よ氮莱璶Μ畕杠碞穦ミ︽
畍ぇ搂玥璶单癸よノ recruit ΜタΑ畍

叫猔種竒Τ畍璉玵畍щ┮Τм穦搭
蝶基穦箂

狦癸畍ㄏノ硂穦跑Θ畍叫
 
叫把σ闽 expellrecruit
HELP
        );
        return 1;
}
