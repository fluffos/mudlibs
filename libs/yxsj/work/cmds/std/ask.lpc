// ask.c

#include <ansi.h>

inherit F_CLEAN_UP;

string *msg_dunno = ({
	"$n穘穘繷弧笵⊿钮弧筁\n",
	"$n窩泊氟辨帝$N陪礛ぃ笵$P弧ぐ或\n",
	"$n羜羜╆簆弧礚\n",
	"$n弧笵垛....硂иぃ睲贰程拜拜\n",
	"$n稱穦ㄠ弧笵癸ぃ癬拜ㄆи龟⊿Τ禜\n"
});

int main(object me, string arg)
{
	string dest, topic, msg;
	object ob;
	mapping inquiry;

	seteuid(getuid());

	if( !arg || sscanf(arg, "%s about %s", dest, topic)!=2 )
		return notify_fail("璶拜街ぐ或ㄆ\n");

	if( !objectp(ob = present(dest, environment(me))) )
		return notify_fail("硂柑⊿Τ硂\n");

	if( !ob->is_character() ) {
		message_vision("$N癸帝$n︑ē︑粂....\n", me, ob);
		return 1;
	}

	if( !ob->query("can_speak") ) {
		message_vision("$N$nゴ钮Τ闽" + topic + "琌$p陪礛钮ぃ来杠\n", me, ob);
		return 1;
	}

	if( !INQUIRY_D->parse_inquiry(me, ob, topic) )
		message_vision("$N$nゴ钮Τ闽" + topic + "\n", me, ob);

	if( userp(ob) ) return 1;
	if( !living(ob) ) {
		message_vision("琌陪礛$n瞷猵⊿Τ快猭倒$Nヴ︙氮滦\n",
			me, ob);
		return 1;
	}

	if( msg = ob->query("inquiry/" + topic) ) {
		if( stringp(msg) ) {
			message_vision( CYN "$N弧笵" + msg + "\n" NOR, ob);
			return 1;
		}
	} else
		message_vision(msg_dunno[random(sizeof(msg_dunno))], me, ob);

	return 1;
}

int help(object me)
{
   write( @HELP
Α: ask <someone> about <something>

硂秆良璶, 硄盽ゲ斗虑パ
莉眔秈˙戈癟
HELP
   );
   return 1;
}
