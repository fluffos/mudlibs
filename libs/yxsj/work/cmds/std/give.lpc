// give.c

inherit F_CLEAN_UP;

int do_give(object me, object obj, object who);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string target, item;
	object obj, who, *inv, obj2;
	int i, amount;

	if(!arg) return notify_fail("璶倒街ぐ或狥﹁\n");

	if( sscanf(arg, "%s to %s", item, target)==2
	|| sscanf(arg, "%s %s", target, item)==2 );
	else return notify_fail("璶倒街ぐ或狥﹁\n");

	if(!objectp(who = present(target, environment(me))) || !living(who))
		return notify_fail("硂柑⊿Τ硂\n");

	if(sscanf(item, "%d %s", amount, item)==2) {
		if( !objectp(obj = present(item, me)) )	
			return notify_fail("ō⊿Τ硂妓狥﹁\n");
		if( obj->query("no_drop") )
			return notify_fail("硂妓狥﹁ぃ繦獽倒\n");
		if( !obj->query_amount() )	
			return notify_fail( obj->name() + "ぃ砆だ秨倒\n");
		if( amount < 1 )
			return notify_fail("狥﹁计秖︓ぶ琌\n");
		if( amount > obj->query_amount() ) 
			return notify_fail("⊿Τê或" + obj->name() + "\n");
		else if( amount == (int)obj->query_amount() )
			return do_give(me, obj, who);
		else {
			obj->set_amount( (int)obj->query_amount() - amount );
			obj2 = new(base_name(obj));
			obj2->set_amount(amount);
			return do_give(me, obj2, who);
		}
	}

	if(arg=="all") {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++) {
			do_give(me, inv[i], who);
		}
		write("Ok.\n");
		return 1;
	}

	if(!objectp(obj = present(item, me)))
		return notify_fail("ō⊿Τ硂妓狥﹁\n");
	return do_give(me, obj, who);
}

int do_give(object me, object obj, object who)
{
	if( obj->query("no_drop") )
		return notify_fail("硂妓狥﹁ぃ繦獽倒\n");

	if( !interactive(who) && !who->accept_object(me, obj) )
		return notify_fail("ㄓ"+who->query("name")+"钩ぃ腀種Μ狥﹁\n");

	if( !userp(who) && obj->value() ) {
		message_vision("$N" + obj->short() + "倒$n\n", me, who);
		destruct(obj);
		return 1;
	} else if( obj->move(who) ) {
		printf("倒%s%s%s\n", who->name(), obj->query("unit"),
			obj->name());
		message("vision", sprintf("%s倒%s%s\n", me->name(),
			obj->query("unit"), obj->name()), who );
		message("vision", sprintf("%s倒%s%s%s\n", me->name(), who->name(),
			obj->query("unit"), obj->name()), environment(me), ({me, who}) );
		return 1;
	}
	else return 0;
}
int help(object me)
{
write(@HELP
Α : give <珇嘿> to <琘>
      ┪ : give <琘> <珇嘿>
 
硂琵盢琘妓珇倒, 讽礛, 璶局Τ硂妓珇.
 
HELP
    );
    return 1;
}
