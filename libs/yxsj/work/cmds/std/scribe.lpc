// scribe.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string spells, name, ob_name;
	object ob;

	// We might need to load new objects.
	seteuid(getuid());

	if( me->is_fighting() )	return notify_fail("驹矮ぃ礶才\n");
	if( (int)me->query("sen") < 30 )
		return notify_fail("弘び畉礚猭礶才\n");

	if( !arg
	||	sscanf(arg, "%s on %s", name, ob_name)!= 2 )
		return notify_fail("Αscribe <才〨> on <珇>\n");

	if( !objectp(ob = present(ob_name, me)) )
		return notify_fail("ō⊿Τ硂妓狥﹁\n");

	if( stringp(spells = me->query_skill_mapped("spells")) ) {
		notify_fail("┮厩猭砃⊿Τ硂贺才\n");
		if( SKILL_D(spells)->scribe(me, ob, name) ) {
			me->receive_wound("kee", 1);
			me->receive_damage("sen", 30);
			return 1;
		}
		return 0;
	} else 
		return notify_fail("叫ノ enable 匡拒璶ㄏノ〨ゅ╰\n");

	return 1;
}

int help (object me)
{
        write(@HELP
Αscribe <才〨嘿> on <珇嘿>

礶才ノ才(paper seal)┪ㄤ珇礶才ㄏ琌才〨礶ぃ
珇ΤΤぃ狦

礶才ぇ玡ゲ斗ノ enable ㄓ﹚璶ㄏノ〨ゅ╰

爹礶才穦璝(璶玶瘆もノ翧﹀礶)籔礶Θ才〨ノ attach
    盢ウ禟ヘ夹ō
 
HELP
        );
        return 1;
}
