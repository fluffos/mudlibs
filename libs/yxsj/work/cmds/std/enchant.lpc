// enchant.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int pts;

	if( !arg || !sscanf(arg, "%d", pts) ) 
		return notify_fail("Αenchant <艶翴计>\n");

	if( pts > ((int)me->query("atman")/50+1) )
		return notify_fail("艶ぃì祇ぃê或眏\n");

	if( pts < 0 ) return notify_fail("艶翴计ゲ斗琌タ计\n");	
	me->set("mana_factor", pts);
	write("Ok.\n");
	return 1;
}

int help (object me)
{
	write(@HELP
Α: enchant <艶翴计>
 
硂琵砞﹚ㄏノ臸猭猌竟璶ノㄓ旧ま猌竟臸┮ノ艶眏
ぃ猌竟┮惠艶ぃぃ妓Τㄇ臸眏猌竟狦ㄏノ
礚猭祇ì緍犊ウ艶碞Τ玻ネ┤狦

HELP
	);
	return 1;
}
