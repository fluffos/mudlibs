// fight.c

void create() { seteuid(ROOT_UID); }

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj, old_target;

	if( me->query("born")=="﹁よ" )
		return notify_fail("ぐ或\n");

	if( environment(me)->query("no_fight") )
		return notify_fail("硂柑ぃ驹矮\n");

//	if( !wizardp(me) && environment(me)->query("no_fight") )
//		return notify_fail("硂柑窽ゎ驹矮\n");

	if(!arg || !objectp(obj = present(arg, environment(me))))
		return notify_fail("稱ю阑街\n");

	if( !obj->is_character() )
		return notify_fail("睲贰翴êぃ琌ネ\n");

	if( obj->is_fighting(me) )
		return notify_fail("猳猳猳\n");

	if( !living(obj) )
		return notify_fail(obj->name() + "竒礚猭驹矮\n"); 

	if(obj==me)	return notify_fail("ぃю阑︑\n");

	if( userp(obj) && (object)obj->query_temp("pending/fight")!=me ) {
		message_vision("\n$N癸帝$n弧笵" 
			+ RANK_D->query_self(me) 
			+ me->name() + "烩毙"
			+ RANK_D->query_respect(obj) + "蔼┷\n\n", me, obj);
		if( objectp(old_target = me->query_temp("pending/fight")) )
			tell_object(old_target, YEL + me->name() + "㎝ゑ刚├繷\n" NOR);
		me->set_temp("pending/fight", obj);
		tell_object(obj, YEL "狦腀種㎝癸よ秈︽ゑ刚叫癸" + me->name() + "("+(string)me->query("id")+")"+ "Ω fight \n" NOR);
		write(YEL "パ癸よ琌パ產北ゲ斗单癸よ種秈︽ゑ刚\n" NOR);
		return 1;
	}

	if( obj->query("can_speak") ) {
		message_vision("\n$N癸帝$n弧笵" 
			+ RANK_D->query_self(me) 
			+ me->name() + "烩毙"
			+ RANK_D->query_respect(obj) + "蔼┷\n\n", me, obj);

		notify_fail("癬ㄓ" + obj->name() + "ぃ稱蛤耕秖\n");
		if( !userp(obj) && !obj->accept_fight(me) ) return 0;

		me->fight_ob(obj);
		obj->fight_ob(me);
	} else {
		message_vision("\n$N耻羘秨﹍癸$n祇笆ю阑\n\n", me, obj);
		me->fight_ob(obj);
		obj->kill_ob(me);
	}

	return 1;
}
int help(object me)
{
  write(@HELP
Α : fight <>
 
硂琵癚毙┪琌ち絉猌美硂贺Α驹矮洪琌
翴ゎ穦砰ぃ穦痷端琌ぃ琌┮Τ  NPC 常尺舧
ゴ琜Τ惠猵ゑ猌璶―穦砆┶荡
 
ㄤ闽: kill

PS. 狦癸よぃ腀種钡珼驹ご礛硍︽ノ kill 秨﹍驹矮Τ
    闽 fight 蛤 kill 跋だ叫 'help combat'.
HELP
    );
    return 1;
}
 
