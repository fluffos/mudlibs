// reboot.c

#include <login.h>
#include <obj.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string wiz_status;
	object npc;

	if( me != this_player(1) ) return 0;
	
	wiz_status = SECURITY_D->get_status(me);
	if( wiz_status != "(admin)" && wiz_status != "(arch)" )
		return notify_fail("Τ (arch) 畍穝币笆" + MUD_NAME + "\n");

	seteuid(getuid());

	npc = new(NPC_DEMOGORGON);
	npc->move(START_ROOM);
	npc->start_shutdown();

	write("Ok\n");

	return 1;
}

int help (object me)
{
        write(@HELP
Α: reboot
 
穝癬笆笴栏, ╰参穦秨﹍计璸, きだ牧穝癬笆
 
HELP
);
        return 1;
}
 
