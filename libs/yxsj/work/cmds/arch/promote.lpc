// promote.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	string old_status, new_status;
	int my_level, ob_level, level;

	if( me!=this_player(1) ) return 0;

	if( !arg || sscanf(arg, "%s %s", arg, new_status)!=2 )
		return notify_fail("Αpromote <ㄏノ> <单>\n");

	if( wiz_level(new_status) < 0 ) return notify_fail("⊿Τ硂贺单\n");

	if( !objectp(ob = present(arg, environment(me))) 
	||	!userp(ob) )
		return notify_fail("э跑ㄏノ舦\n");

	if( wiz_level(me) < wiz_level(new_status) )
		return notify_fail("⊿Τ硂贺舦\n");

	old_status = wizhood(ob);

        if(new_status[0..0]=="(") return notify_fail("Αpromote <ㄏノ> <单>\n");
	seteuid(getuid());
	if( !(SECURITY_D->set_status(ob, "("+new_status+")")) )
		return notify_fail("эア毖\n");

	message_vision("$N盢$n舦眖 " + old_status + " э " +"("+ new_status +")"+ " \n", me, ob);
	seteuid(getuid());
	ob->setup();

	return 1;
}

int help(object me)
{
write(@HELP
Α : promote <琘> <舦单>        (ex:promote daniel admin)

ノㄓ矗ど舦单, (player) (immortal) (apprentice) (wizard)
(arch) (admin)
 admin 矗ど舦︓ヴ︙单, τ arch 矗ど︓ arch
HELP
    );
    return 1;
}
