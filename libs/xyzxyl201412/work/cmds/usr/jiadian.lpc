inherit F_CLEAN_UP;

int get_biaoshi(string biaoshi, object ob);
int get_shuxing_num(string arg, object ob);

int main(object me, string arg) {
  object ob;

  if (me != this_player(1))
    return 0;

  ob = me->query_temp("link_ob");

  if (!ob)
    return 0;

  while (ob && ob->is_character())
    ob = ob->query_temp("link_ob");

  if (!me->query("xyzx_sys/shuxingdian", 1) || me->query("xyzx_sys/shuxingdian", 1) < 1)
    return notify_fail(HIY "你的属性点不足，无法进行加点。\n" NOR);

  write(HIY "为了安全起见要求验证身份标识,请输入你的身份标识：" NOR);
  input_to("get_biaoshi", 1, ob);
  return 1;
}

int get_biaoshi(string biaoshi, object ob) {
  string old_biaoshi;

  old_biaoshi = ob->query("biaoshiold");

  write("\n");

  if (crypt(biaoshi, old_biaoshi) != old_biaoshi
    && md5crypt(biaoshi, old_biaoshi) != old_biaoshi) {
    write(HIR "身份标识验证失败！\n" NOR);
    return 0;
  }

  write(HIG "[一]、精准：影响攻击命中率，数值越高击中对手的几率越大。\n" +
    HIM "[二]、灵性：影响对技能绝招的洞悉力，这个值越高技能绝招施用的成功机会就越大。\n" +
    HIW "[三]、敏捷：影响闪避率，数值越高越不容易被对手击中。\n" +
    HIC "[四]、反应：影响格挡几率，有效地格挡可以消减对手大部分伤害。\n" +
    //HIR"[五]、技能点：允许你把属性点转换成相应的技能点，每提高"+MAX_SKILLS_ABOUT_DIAN+"级技能需要消耗掉一个技能点。\n" + 
    HIY "共有五项属性，请选择你要提升的属性" HIR " [1～4]" HIY "，键入" WHT " 0 " HIY "则取消该次操作：" NOR);

  input_to("get_shuxing_num", 1, ob);
  return 1;
}

int get_shuxing_num(string arg, object ob) {
  object me = this_player();
  int i;

  write("\n");

  if (sscanf(arg, "%d", i) == 1 && i >= 0 && i < 5) {
    switch (i) {
      case 1:
        write(HIG "恭喜你！你的精准提升了。\n" NOR);
        me->add("xyzx_sys/jingzhun", 1);
        me->add("xyzx_sys/shuxingdian", -1);
        break;
      case 2:
        write(HIM "恭喜你！你的灵性提升了。\n" NOR);
        me->add("xyzx_sys/lingxing", 1);
        me->add("xyzx_sys/shuxingdian", -1);
        break;
      case 3:
        write(HIW "恭喜你！你的敏捷提升了。\n" NOR);
        me->add("xyzx_sys/minjie", 1);
        me->add("xyzx_sys/shuxingdian", -1);
        break;
      case 4:
        write(HIC "恭喜你！你的反应提升了。\n" NOR);
        me->add("xyzx_sys/fanying", 1);
        me->add("xyzx_sys/shuxingdian", -1);
        break;
        /*case 5:
				write(HIC"你成功转换了一个技能点。\n"NOR);
				me->add("xyzx_sys/skill_dian",1);
				me->add("xyzx_sys/shuxingdian",-1);
				me->add("xyzx_sys/dianswitchdian", 1, 1); // 几率一共转换了多少点
				break;*/
      default:
        write(HIY "你取消了这次加点操作。\n" NOR);
    }
  } else
    write(HIY "没有这项属性，加点失败。\n" NOR);

  return 1;

}

int help() {
  write(@TEXT
指令格式：jiadian
这个指令可以让你把属性点分配到 [精准、灵性、敏捷、反应] 四项属性上。
[一]、精准：影响攻击命中率，数值越高击中对手的几率越大；
[二]、灵性：影响对技能绝招的洞悉力，这个值越高技能绝招施用的成功机会就越大；
[三]、敏捷：影响闪避率，数值越高越不容易被对手击中；
[四]、反应：影响格挡几率，有效地格挡可以消减对手大部分伤害；
[五]、技能点：允许你把属性点转换成相应的技能点，每提高十级技能需要消耗掉一个技能点。
TEXT
  );
  return 1;
}
