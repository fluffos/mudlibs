// gangdao.c
#include <weapon.h>
inherit BLADE;
void create()
{
set_name(HIW"雪"HIR"饮"HIY"狂"HIC"刀"NOR, ({ "xueyin kuangdao","blade" }));	
	set_weight(7000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
set("long", "寒.......阴极之刀。\n");	
		set("value", 500000);
		set("material", "steel");
set("wield_msg", "$N抽出一柄$n握在手中顿感不对,不禁大呼:上当................。\n");	
set("unwield_msg", "$N无奈地摇了摇头,忧闷将手中的$n插回刀鞘。\n");
	}
        init_blade(20,2);
	setup();
}
int query_autoload() { return 1; }
