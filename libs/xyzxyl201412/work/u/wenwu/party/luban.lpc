int ask_party(string arg)
{
    object me;
    object lu;
    lu=this_object();	
    me=this_player();
    if (me->query("more_money") < 100)  
    {
	command("say 对不起，你的资金不足,买不起地盘。");
	return 1;
    }
    write("请输入帮派英文名称：");	
    input_to("get_partyid", 1, me );	
    return 1;
}
int get_partyid(string str,object me)
{
if( file_size("d/" + "party/" + "str/" + "dating.lpc") > 0 && me->query("partyid",1) )      	
return notify_fail("该帮派名称已经存在！\n");        	
{
write(YEL"该帮派名称已经存在或你现在已有自己的帮派,请重新设定你的帮派英文名称："NOR);	
input_to("get_new_partyid", 1, me );            	
    return 1;
}
}
int get_new_partyid(string str,object me)   	
{
me->set("partyid",str);	
me->set("bangzhu",1); 	
me->add("more_money",-100);	
mkdir("d/" + "party/" + me->query("partyid"));           	
