// party.c	
#include "/doc/help.h"	
inherit F_CLEAN_UP;
int main(object me, string arg)
{
object room,ob,*obj;	
	string msg;
if( file_size("d/" + "party/" + me->query("partyid") + "/dating.lpc") <= 0 )      	
return notify_fail("你还没有加入任何帮派。\n");	
if (me->is_busy())		
return notify_fail("你上一个动作还没有完成！\n");
if (me->is_fighting())	
return notify_fail("你现在正忙着打架,等会再说吧！\n");	
if(me->is_ghost())	
return notify_fail("鬼魂随便跑出去会吓着人的！\n");		
ob=first_inventory(me);	
while(ob){	
if (ob->is_character() && !ob->is_corpse() )  
return notify_fail(ob->name()+"不能和你一起时空运转！\n");	
ob=next_inventory(ob);	
}	
if( stringp(msg = me->query("env/msg_party")) )	
		message_vision(msg + "\n", me);
message_vision(MAG+"只见一阵烟雾过後，$N的身影已经不见了。\n"+NOR, me);	
me->move("d/" + "party/" + me->query("partyid") + "/dating.lpc"); 
message_vision(MAG+"$N的身影突然出现在一阵烟雾之中。\n"+NOR, me);	
	return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : gohome        	
利用此一指令可回到自己的帮派里。	
HELP
    );
    return 1;
}
