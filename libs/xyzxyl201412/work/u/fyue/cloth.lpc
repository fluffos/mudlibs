// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
 set_name(HIR"凤凰浴火铠"NOR, ({ "yuhuo kai","armor","kai" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
 set("long", "传说中的神器之一，用凤凰浴火重生散落的羽毛编织成的铠甲，据说拥有不可思议的神奇力量。\n");
                set("unit", "件");
                set("material", "cloth");
set("no_put",1);
set("no_get",1);
set("no_give","神器耶，给别人你舍得吗？\n");
 set("no_drop","你真的要丢？不再考虑考虑?\n");
set("no_sell","这个是无价之宝，谁买的起?\n");
set("no_steal","你好象摸到了一团火焰，烫的你哇哇叫!\n");
set("armor_prop/intelligence", 10);
set("armor_prop/armor_vs_force", 20);
                set("armor_prop/armor", 1);
set("wear_msg", HIC"只闻一声凤鸣，天空中忽然出现一只传说中的"+HIR+"火凤凰"+HIM",只见它向天鸣叫几声，在$N头顶盘旋几圈，忽地化做一团"+HIR+"火焰"+HIC"，向$N直冲过来，顿时，$N被"+HIR+"火焰"+HIM"吞没，"+HIR+"火焰"+HIC+"逐渐淡去，$N的身上多了一件"+HIR+"火红的铠甲。\n"NOR);  
set("remove_msg", HIM"$N双肩一抖，一团火焰从$N身上飞出，化做一只"+HIR+"浴火凤凰"+HIM+",只见它向着$N鸣叫一声，冲天而去，瞬时不见。\n" NOR);
        }
 setup();
}
void owner_is_killed() { destruct(this_object()); }
int query_autoload() { return 1; }
