// zixuan pifeng.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
set_name(HIG"青龙圣甲"NOR, ({ "qinglong shengjia", "qinglong","shengjia" }));
set_weight(2000);
if (clonep())
set_default_object(__FILE__);
else {
set("long", HIM"传说中的圣灵装备之"HIG"青龙甲"HIM"。\n");
set("material", "cloth");
set("unit", "件");
set("armor_prop/karma", 10);
set("armor_prop/armor_vs_force", 10);
set("value", 200000);
set("armor_prop/armor", 1500);
}
setup();
}