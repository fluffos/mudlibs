// board_list.c

#include <net/daemons.h>
#include <net/macros.h>

inherit F_CLEAN_UP;
string gateway(string pattern) {
  string map;

  if (file_size("/adm/daemons/vrm_server.map") <= 0) return "没有可显示的地图";
  if (stringp(map = read_file("/adm/daemons/vrm_server.map"))) return map;

  return "没有可显示的地图";
}
