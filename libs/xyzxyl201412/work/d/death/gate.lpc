// gate.c
#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", HIW "鬼门关" NOR);
	set("long", 
		"这里就是著名的阴间入口「鬼门关」，在你面前矗立著一座高大的\n"
		"黑色城楼，许多亡魂正哭哭啼啼地列队前进，因为一进鬼门关就无法再\n"
		"回阳间了。\n");
	set("exits", ([
		"north" : "/d/death/gateway",
	]) );
	set("valid_startroom", 1);
        set("no_fight", 1);
	set("objects", ([
		__DIR__"npc/wgargoyle":1
	]) );
	setup();
}
void init()
{
	object ob;
	ob = this_player();
	ob->set("startroom","/d/death/gate");
	//if (!wizardp(this_player()) ) 
        //add_action("block_cmd","",1);
//call_out("green", 2, this_player());	
}

int block_cmd()
{
      if((string)query_verb() == "look") return 0;    	
      if((string)query_verb() == "go") return 0;
      if((string)query_verb() == "quit") return 0;
        return 1;
}

void green()
{
        tell_room(environment(this_player()),
                "一个空洞的声音在你耳边响起：\n\n"+
                "自作孽，不可活！！！因果轮回，你不下地狱谁下地狱～～\n\n"
                );
        return;
}
