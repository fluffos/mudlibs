inherit ROOM;
void create() {
  set("short", "迷雾堡大门");
  set("long",
    "巨大的大门由百年的巨木制成，看起来相当地笨重，没有几十个\n"
    "人是不可能打开的。大门由卫队长斯巴达统领的战士们守卫。\n"
  );
  set("exits", ([
    "south": __DIR__ "dajie1",
    "north": __DIR__ "miwubao8",
  ]));
  set("objects", ([
    __DIR__ "npc/menwei1": 1,
    __DIR__ "npc/menwei2": 1,
  ]));
  setup();
  //replace_program(ROOM);
}
