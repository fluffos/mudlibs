// #include <ansi.h>
inherit ROOM;
void create() {
  set("short", "武器店");
  set("long",
    "墙上挂满了各种武器。有斧子，刀剑，棍棒，以及各种鞭子。与\n"
    "索非亚的魔法武器不同的是，这里的武器都比较笨重，比较适合\n"
    "战士们使用。\n"
  );
  set("exits", ([
    "south": __DIR__ "dajie6",
    "west": __DIR__ "shudian",
    "east": __DIR__ "wuqidian2",
  ]));

  set("objects", ([
    __DIR__ "npc/shopkeeper3": 1,
  ]));
  setup();
  //replace_program(ROOM);
}
