inherit ROOM;
void create()
{
	set("short", "大街");
	set("long",
"宽敞的大街，自从三十年前伟大的战士迈西斯接管迷雾岛以来，\n"
"一直致力于迷雾岛的建设。现在地迷雾岛已经相当繁华，世界各\n"
"地的商人，旅客都蜂拥而至。北方通往神圣广场。那是整个迷雾\n"
"岛的中心广场。\n"
);
	set("exits",([
	"south" : __DIR__"damen2",
	"north" : __DIR__"dajie11",
	]));

	set("objects",([
	__DIR__"npc/dog":1,
	]));

	setup();
//replace_program(ROOM);
}
