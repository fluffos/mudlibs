"店。\n"
);
	set("exits",([
	"south" : __DIR__"fangjudian1",
	"north" : __DIR__"wuqidian1",
	"west" : __DIR__"datiepu",
	"east" : __DIR__"dajie7",
	]));

	set("objects",([
	__DIR__"npc/fighter":1,
	__DIR__"npc/localruffian":1,
	]));

	setup();
//replace_program(ROOM);
}
