inherit ROOM;
void create() {
  set("short", "荒野");
  set("long",
    "无人的荒野，周围长满了各种叫不出名字的花花草草。偶尔不知\n"
    "道从哪里跑出来的小动物飞快的从你的身边闪过。\n"
  );
  set("exits", ([
    "south": __DIR__ "zhaoze2",
    "north": __DIR__ "dadao2",
    "west": __DIR__ "huangye3",
    "east": __DIR__ "huangye2",
  ]));
  setup();
  //replace_program(ROOM);
}
