// #include <ansi.h>
inherit ROOM;
void create() {
  set("short", "大街");
  set("long",
    "干净宽敞的大街是迷雾岛一贯的风格。整个迷雾岛的规划相当地\n"
    "好，大街的北边是迷雾岛的药店，南边是珠宝店。再往东走就是\n"
    "迷雾岛的钱庄和当铺。旅馆，花店，道具店则在大街东边的尽头。\n"
  );
  set("exits", ([
    "south": __DIR__ "zhubaodian",
    "north": __DIR__ "yaodian",
    "west": __DIR__ "dajie5",
    "east": __DIR__ "dajie9",
  ]));

  set("objects", ([
    __DIR__ "npc/lansquenet": 2,
  ]));
  setup();
  //replace_program(ROOM);
}
