inherit ROOM;
void create()
{
	set("short", "旅馆");
	set("long",
"迷雾岛的旅馆，只此一家。是给来自世界各地的旅客们提供休息\n"
"的。\n"
);
	set("exits",([
	"south" : __DIR__"huadian",
	"west" : __DIR__"dangpu",
	]));

	set("objects",([
	__DIR__"npc/graham":1,
	]));

	setup();

//replace_program(ROOM);
}
