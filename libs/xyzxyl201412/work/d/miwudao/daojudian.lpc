// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "道具店");
	set("long",
"一个面积不大的小屋，货架上面零零散散的放了一些小玩意儿。\n"
"这就是巴特勒的道具店，不过看起来似乎生意不怎么好，皆因货\n"
"源不充足，似乎没有什么东西可卖。\n"
);
	set("exits",([
	"north" : __DIR__"huadian",
	"west" : __DIR__"qianzhuang",
	]));

	set("objects",([
	__DIR__"npc/butler":1,
	]));

	setup();
//replace_program(ROOM);
}
