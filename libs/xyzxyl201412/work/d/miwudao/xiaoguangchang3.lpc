// #include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "小广场");
	set("long",
	    "这里是迷雾岛的小广场。广场上不时的走过一两个巡逻兵。看起\n"
	    "来迷雾岛的治安相当的严密。\n"
	);
	set("exits",([
		"north" : __DIR__"guangchang",
		"west" : __DIR__"mofazhu3",
		"east" : __DIR__"mofazhu4",
		"south" : __DIR__"dajie10",
	    ]));

	set("objects",([
		__DIR__"npc/prowlman1":1,
		__DIR__"npc/prowlman2":1,
	    ]));

	setup();
	//replace_program(ROOM);
}
