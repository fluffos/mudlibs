#pragma save_binary

inherit ITEM;
inherit F_FOOD;

void create() {

  if (random(2) == 1) {
    set_name("蜥蜴尾巴", ({ "lizard tail", "tail" }));
    set("long", "半截烤的喷香的蜥蜴尾巴,味道也应该不错\n");
  } else {
    set_name("蜥蜴肉蒲", ({ "lizard meat", "meat" }));
    set("long", "一块烤的香喷喷的蜥蜴肉蒲.\n");
  }

  set_weight(350);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 30);
    set("food_remaining", 8);
    set("food_supply", 40);
  }
  setup();
}
