#pragma save_binary

// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("大地战恺", ({ "mother earth armor" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 20);
    set("armor_prop/armor_vs_fire", 10);
    //set("armor_prop/armor_vs_ice",15);
    //set("armor_prop/armor_vs_magic",15);
    //set("armor_prop/armor_vs_lightning",15);
    set("value", 2000);
    set("long", "传说中的大地战恺,由迷雾森林的矿石为原料,防御极好\n");
  }
  setup();
}
