// longsword.c 长鞭

#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("力量之剑", ({ "power sword" }));
	set_weight(1000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("icon", "10035");
		set("long", "有名的力量之剑,锋利无比,可惜有些笨重。\n");
		set("value", 1000);
		set("material", "leather");
		set("wield_msg", "$N「唰」的一声举起一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回腰间。\n");
	}
	init_sword(45);
	setup();
}
