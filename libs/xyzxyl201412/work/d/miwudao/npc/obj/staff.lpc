#pragma save_binary
//魔法法杖,
#include <weapon.h>
inherit STAFF;

void create() {
  set_name("迷雾之杖", ({ "magic staff" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "一根魔法法杖,散发出幽幽的蓝色光芒,蕴藏着神秘的力量,\n");
    set("value", 1500);
    set("rigidity", 100);
    set("material", "steel");
    set("wield_msg", "$N将$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n放回背囊。\n");

  }
  init_staff(50);
  set("weapon_prop/armor_vs_fire", 25);  //设置魔防属性应该将语句写在init_sfaff后面
  setup();
}
