#pragma save_binary
// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	int i;
	i=random(6);
	switch(i)
	{
		case 0:
			set_name("伏特加",({"vodka"}));	
		break;	
		case 1:
			set_name("白兰地",({"aquavit"}));	
		break;	
		case 2:
			set_name("鸡尾酒",({"cocktail"}));	
		break;	
		case 3:
			set_name("威士忌",({"barley-bree"}));
		break;	
		case 4:
			set_name("葡萄酒",({"wine"}));	
		break;	
		case 5:
			set_name("啤酒",({"beer"}));	
		break;	

	}

	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{

	set("unit", "个");
	set("value", 30);
	set("max_liquid", 25);

	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("long", "一瓶"+query("name")+"\n");
	set("liquid", ([
		"type": "alcohol",
		"name": query("name"),
		"remaining": 25,
		"drunk_apply": 40,
	]) );
}
