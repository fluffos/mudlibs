#pragma save_binary

#include <ansi.h>

inherit NPC;
void create() {
  string *elf, *beast, *id;
  elf = ({
    "火精灵",
    "水精灵",
    "矮精灵",
    "小矮人",
    "侏儒",
    "小天使",
    "森林精灵",
    "魔法精灵",
  });
  beast = ({
    "三头龙",
    "双头蛇",
    "巨蜥",
    "火龙",
    "巨蟒",
    "长毛狮",
    "红眼狮",
    "喷火兽",
    "绿毛猿",
    "响尾蛇"
  });
  id = ({
    "bugbear",
    "hobgoblin",
    "ogre",
  });
  if (random(2) == 1) {
    set_name(elf[random(8)], ({ "elf" }));
    set("long", "由于此类精灵一直生活在恶劣的环境当中,弱肉强食的环境让他们具有\n"
      "极大的侵略性,通常碰到异类,便会发动攻击.");
  } else {
    set_name(beast[random(10)], ({ id[random(3)] }));
    set("long", "面目丑陋的怪物,此类怪物原本并非如此,只是由于迷雾岛周围的异常环境\n"
      "加速了他们的进化.\n");
    set("race", "野兽");
    set("limbs", ({ "头部", "身体", "尾巴" }));
    set("verbs", ({ "bite", "claw" }));

  }

  set("per", 30);
  set("str", 30);
  set("cor", 30);
  set("cps", 25);

  set("kee", 1000);
  set("force", 1000);
  set("max_force", 1000);
  set("max_sen", 1000);
  set("sen", 1000);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("sen", 1000);
  set("max_mana", 1000);
  set("mana", 1000);

  set("combat_exp", 300000);

  set_skill("parry", 10);
  set_skill("dodge", 10);

  set("attitude", "aggressive");

  setup();

  add_money("silver", random(120));

  if (this_object()->query("id") == "elf") {
    carry_object(__DIR__ "obj/cloth")->wear();
  }
}
