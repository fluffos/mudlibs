inherit NPC;
void create()
{
        set_name("小男孩", ({ "little boy"}) );
        set("nickname", "战士");
        set("gender", "男性");
        set("age", 8);
        set("long","可爱的小男孩,也不知道是谁家的孩子.\n");

        set("combat_exp", 500);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

        setup();
}
 
