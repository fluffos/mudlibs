// taolord.c

inherit NPC;
inherit F_MASTER;
inherit F_QUEST;
void create() {
  set_name("比尔", ({ "bill" }));
  set("nickname", "初级魔法师");
  set("gender", "男性");
  set("age", 25);
  set("long", "比尔原本是一个手脚伶俐的盗贼,后来却做了传说中的大魔法师恩利斯的徒弟\n"
    "转职做了魔法师,虽然比尔的天赋很高,但是毕竟刚刚开始做魔法师,只能使用\n"
    "一些初级魔法,对付一些小怪物绰绰有余.\n");

  set("combat_exp", 1000000);

  set("class", "divine");
  set("occupation", "enchanter");
  set("appointed", "star");  //在战斗中会自动使用star(流星风暴)魔法对敌人进行攻击
  set_temp("magic_armor", 1);  //魔法盾
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("mana_factor", 100);

  set("mana", 5000);
  set("max_mana", 5000);

  set_skill("magic", 100);
  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("divinemagic", 120);

  map_skill("magic", "divinemagic");
  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  setup();

  add_money("gold", 1);
}

int heal_up() {
  object me;
  me = this_object();
  if (!objectp(me->query_temp("cast_elf")))
    command("cast elf");
  ::heal_up();

}
