#include <ansi.h>;
inherit NPC;
void kill_ob(object ob);
void fight_ob(object ob);
void create()
{
        set_name("迈西斯", ({ "fighter masis","masis"}) );
        set("nickname", "传说中的伟大战士");
        set("gender", "男性");
        set("age", 55);
        set("long","传说中的伟大战士迈西斯,三十年前跟他的伙伴恩利斯一起最终封印了\n"
                   "黑龙王,自此之后就一直居住在迷雾岛.随着岁月的流失,皱纹开始悄悄\n"
                   "爬到迈西斯的脸庞,英雄也抵挡不住岁月的力量,现在的迈西斯看上去\n"
                   "显得老态龙钟了.\n");

        set("combat_exp", 1500000);

        set("occupation","fighter");
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",150);
      	set_skill("parry",150);
      	set_skill("dodge",150);
	//set_skill("xiyang-quan",150);
        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);
	
	//map_skill("unarmed","xiyang-quan");
       // map_skill("parry","xiyang-quan");
        setup();
	carry_object(__DIR__"obj/armor")->wear();
        carry_object(__DIR__"obj/head_armor")->wear();
        carry_object(__DIR__"obj/boots_armor")->wear();
        carry_object(__DIR__"obj/mesword")->wield();
        add_money("gold",1);
}

void kill_ob(object ob)
{
	int i;
	object *npc;
	npc=allocate(200);
	npc=all_inventory(environment());
	for(i=0;i<sizeof(npc);i++)
	{
		if(!living(npc[i])) continue;
		if(userp(npc[i])) continue;
		if(npc[i]->query("id")=="enchanter"
		||npc[i]->query("id")=="guardsman"
		||npc[i]->query("id")=="captain sparta")
		{
			npc[i]->kill_ob(ob);
			ob->kill_ob(npc[i]);
		}
	}
	::kill_ob(ob);
	return ;
}

