//shopkeeper9.c
//存钱的地方

#include <ansi.h>;
inherit NPC;


void create() {
  set_name("艾博特", ({ "shopman abott", "abott" }));
  set("nickname", "钱庄老板");
  set("gender", "男性");
  set("age", 25);
  set("long", "迷雾岛最富有的应该就是钱庄老板艾博特了.\n"
    "\n");

  set("combat_exp", 500000);

  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("divinemagic", 90);

  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  setup();

  add_money("silver", random(50) + 1);
}
