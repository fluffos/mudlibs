// taolord.c

inherit NPC;
void create()
{
        set_name("旅行者", ({ "traveller"}) );
        set("gender", "男性");
        set("age", 25);
        set("long","普通的旅行者,周游世界,见识广泛.\n");

        set("combat_exp", 50000);
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",50);
      	set_skill("parry",50);
      	set_skill("dodge",50);

        setup();
        
}
 
