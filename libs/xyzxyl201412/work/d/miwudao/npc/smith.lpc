#pragma save_binary
// zhang.c
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("史密斯", ({ "black smith","smith" }) );
        set("gender", "男性" );
        set("nickname","铁匠");
        set("age", 52);
        set("long","史密斯是迷雾堡最有名的打铁匠,一身打铁功夫名不虚传，\n"
                   "他打出的铁器经久耐用．\n");
        set("combat_exp", 5);
        set("attitude", "friendly");
        setup();
        carry_object("/d/miwudao/npc/obj/cloth")->wear();

}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_ding", "ding");
	add_action("do_update","updateweapon");

}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(5) ) {
                case 0:
                        say( "史密斯粗声粗气地说道：这位" + RANK_D->query_respect(ob)
                                + "，要什么？\n");
                        break;
                case 1:
                        say( "史密斯满脸汗水说道：这位" + RANK_D->query_respect(ob)
                                + "，我太忙了，帮不了你。\n");
                        break;
        }
}

int do_ding(string arg)
{
	string ctype;
	object me,ob;
	string filename;
	me = this_player();
    if(!arg || sscanf(arg,"%s",ctype) != 1)
        return notify_fail("指令格式：ding <type>\n");
	if(me->is_busy())
	return notify_fail("你上一个动作还没有完成。\n");
    if(me->query("potential")-me->query("learned_points")<1000)
    return notify_fail("你没有足够的潜能。\n");
	if(!me->can_afford(100000))
		return notify_fail("你身上没那么多钱了。\n");
	filename = "/d/fy/npc/obj/weapon/";
	switch( ctype ) {
		case "sword":
			  filename += "sword";
			  break;
        case "blade":
			  filename +="blade";
              break;
        case "spear":
			  filename +="spear";
              break;
        case "staff":
			  filename +="staff";
              break;
        case "whip":
			  filename +="whip";
              break;
        case "hammer":
			  filename +="hammer";
              break;
		default:
			return notify_fail("这里不会做你要的东西．\n");
	}
	ob = new(filename);
	if(ob&&ob->move(me)){
        	ob->autoload("40/0");
		me->pay_money(100000);
        	me->add("potential",-1000);
		write("ＯＫ\n");
		return 1;
	}
	return 0;
}


int do_update(string arg)
{
	object weapon,me;
	int i;
	me=this_player();
if(!arg)
	return notify_fail("您要升级什么武器？\n");
	weapon=present(arg,me);
if(!weapon)
	return notify_fail("你要升级什么武器???\n");
if(!weapon->query("skill_type"))
	return notify_fail("我只会升级武器!!!\n");
if(!weapon->query_autoload())
        return notify_fail("这样武器好象不用升级了吧？\n");
if(weapon->query("lost_prop")>0)
	return notify_fail("客官。您还是先修好再升级吧。\n");
        i=weapon->query("weapon_prop/damage")+query("lost_prop")-40;
	i++;
	if(i<0)
		return notify_fail("您的武器有错误。不能升级\n");
        if(i>160)
            return notify_fail(CYN"史密斯呵呵笑道:我能力有限。只能做到这个样子了。\n");
if(!me->can_afford(i*10000))
	return notify_fail("您这次升级所需费用为"+i+"两黄金，可惜你没有这么多钱!\n");
	me->pay_money(i*10000);
        weapon->unequip(); 
	weapon->add("weapon_prop/damage",1);
	write("您这次用于"+weapon->name()+"的升级费用为"+i+"两黄金。多谢光临！欢迎再来！！！");
        me->save();
}
