//shopkeeper5.c
//专门为玩家治病,疗伤.
inherit NPC;
void create()
{
        set_name("马休斯", ({ "shopman matthews","matthews"}) );
        set("nickname","药店老板");
        set("gender", "男性");
        set("age", 45);
        set("long","马休斯的医术非常出名,一般的战士们如果有个头痛脑热的,都会来找他\n");

        set("combat_exp", 500000);

        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

        setup();
        
        add_money("silver",random(50)+1);
}
 
