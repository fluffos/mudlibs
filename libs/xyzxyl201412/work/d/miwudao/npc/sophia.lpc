//shopkeeper11.c
//sophia,含有智慧的意思
//贩卖魔法师用品的商店,魔法书籍,魔法药水,魔法卷轴,法杖.

inherit F_VENDOR;
inherit NPC;

void create() {
  set_name("索非亚", ({ "shopman sophia", "sophia" }));
  set("nickname", "高级魔法师");
  set("gender", "女性");
  set("age", 35);
  set("long", "可爱美丽的索非亚,拥有魅力无比的容颜,引起迷雾岛许多好色之徒的垂涎\n"
    "不过因为惧怕索非亚可怕的魔法,因此没有一个人敢打她的主意.不过仍然\n"
    "有许多人经常来商店闲逛,当然其目的不是买东西....\n");

  set("combat_exp", 1500000);

  set("per", 30);
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("divinemagic", 120);
  set_skill("magic", 120);

  map_skill("magic", "divinemagic");

  set("occupation", "enchanter");
  set("appointed", "star");
  set_temp("magic_armor", 1);

  set("mana_factor", 100);
  set("mana", 2000);
  set("max_mana", 2000);

  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  set("vendor_goods", ([
    __DIR__ "obj/magicstaff": 5,
  ]));
  setup();
  carry_object(__DIR__ "obj/mcloth")->wear();
  add_money("silver", random(50) + 1);
}

int init() {
  add_action("do_vendor_list", "list");
}
