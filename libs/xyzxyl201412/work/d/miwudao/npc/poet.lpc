inherit NPC;
void create() {
  set_name("佛格森", ({ "poet fergusson", "fergusson" }));
  set("nickname", "吟游诗人");
  set("gender", "男性");
  set("age", 25);
  set("long", "吟游诗人佛格森\n");

  set("combat_exp", 500000);

  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  setup();

  add_money("silver", random(50) + 1);
}
