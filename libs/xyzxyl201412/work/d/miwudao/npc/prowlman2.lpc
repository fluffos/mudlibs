inherit NPC;
void create()
{
        set_name("巡逻兵", ({ "enchanter cop"}) );
        set("nickname", "初级魔法师");
        set("gender", "男性");
        set("age", 25);
        set("long","一名身着魔法长袍的男子,手持法杖,双眼机警的扫视着街上来来往往\n"
                   "的人群,不放过任何一个形迹可疑的人.保卫城堡的安全是他们的职责\n");

        set("combat_exp", 200000);

        set("class", "divine");
        set("occupation","enchanter");
        set("appointed", "fengya");//
	set_temp("magic_armor",1);//
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);


        set("mana", 500);
        set("max_mana", 500);

     	set_skill("magic",60);
      	set_skill("unarmed",60);
      	set_skill("parry",20);
      	set_skill("dodge",20);
      	set_skill("divinemagic",60);

        map_skill("magic","divinemagic");

        setup();
        
        add_money("silver",random(10)+1);
}

int heal_up()
{
        object me;
        me=this_object();
        if(!objectp(me->query_temp("cast_elf")))
        command("cast elf");
        ::heal_up();

}
