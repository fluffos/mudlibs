inherit NPC;
void create() {
  set_name("凯萨琳", ({ "enchanter catherine" }));
  set("nickname", "高级魔法师");
  set("gender", "女性");
  set("age", 20);
  set("long", "温柔可爱的女孩,和比尔,隆一起冒险,后来认识隐藏了自身力量的恩利斯\n"
    "一起和恩利斯进行一些冒险活动\n");

  set("combat_exp", 1000000);

  set("class", "divine");
  set("occupation", "enchanter");
  set("appointed", "blade");  //在战斗中会自动使用star(流星风暴)魔法对敌人进行攻击
  set_temp("magic_armor", 1);  //魔法盾
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("mana_factor", 100);

  set("mana", 5000);
  set("max_mana", 5000);

  set_skill("magic", 80);
  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("divinemagic", 90);

  map_skill("magic", "divinemagic");
  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  setup();

  add_money("gold", 1);
}
