inherit NPC;
void create()
{
        set_name("卡罗琳", ({ "enchanter caroline","caroline"}) );
        set("nickname", "高级魔法师");
        set("gender", "女性");
        set("age", 35);
        set("long","迈西斯的妻子,是一位高级魔法师,在整个迷雾岛上,除了大祭祀和\n"
                   "迈西斯本人,几乎没有人是她的对手\n");
        set("combat_exp", 1200000);

        set("occupation","enchanter");
        set("appointed", "storm");//
	set_temp("magic_armor",1);//魔法盾
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("per", 30);
        set("spi", 30);

        set("mana_factor",100);

        set("mana", 3000);
        set("max_mana", 3000);

      	set_skill("literate", 100);
     	set_skill("magic",120);
      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);
      	set_skill("divinemagic",150);

        map_skill("magic","divinemagic");
        set_temp("apply/dodge", 100);
        set_temp("apply/armor", 100);
        setup();
        
	carry_object(__DIR__"obj/carmor")->wear();
        carry_object(__DIR__"obj/chead_armor")->wear();
        carry_object(__DIR__"obj/cboots_armor")->wear();
        //carry_object(__DIR__"obj/staff")->wield();
	//手中有武器者无法施放高级魔法
        add_money("silver",random(100)+1);
}
 
