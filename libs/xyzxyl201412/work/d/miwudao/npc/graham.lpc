//shopkeeper7.c
//就是东方的客栈.贩卖酒品和食物.
//迷雾堡堡主迈西斯的烦恼
inherit F_VENDOR;
inherit NPC;

void create() {
  set_name("格雷厄姆", ({ "shopman graham", "graham" }));
  set("nickname", "旅馆老板");
  set("gender", "男性");
  set("age", 55);
  set("long", "格雷厄姆三十年前就来到了迷雾岛,然后在这里建起了旅馆,供来来往往的商客休息\n");

  set("combat_exp", 500000);

  set("where", "south");
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("divinemagic", 90);

  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);

  set("vendor_goods", ([
    "/obj/example/wineskin": 150,
    "/obj/torch": 25,
    "/obj/obj/candle": 10,
    __DIR__ "obj/lizard": 150,
  ]));

  setup();
  carry_object("/d/miwudao/npc/obj/cloth")->wear();
  add_money("silver", random(50) + 1);
}

int init() {
  add_action("do_vendor_list", "list");

  if (random(20) == 1) {
    remove_call_out("greeting");
    call_out("greeting", 1, this_player());
  }
}

int greeting(object player) {
  string msg, name1, name2;
  int i;
  name1 = this_object()->name();
  name2 = player->name();
  msg = name1 + "见$N走了进来人,忙不迭的过去招待\n";
  message_vision(msg, player);
  msg = name1 + "对$N说道:这位客人,您要来点什么吗?我们这里最出名的是蜥蜴尾巴,\n"
    "蜥蜴肉蒲,请问您要不要尝尝?\n";
  message_vision(msg, player);
  return 1;
}
