// #include <ansi.h>

inherit ROOM;
int flag=0;
void create()
{
	set("short", "船上");
	set("long", @LONG
遗忘之海的景色很迷人

LONG
);
//	set("exits",([
//	]));

	//set("objects",([
	//__DIR__"npc/hughes":1,
	//]));
	setup();

}

int init()
{
	object me;
	me=this_player();
	call_out("greeting",5,me);
	return 1;
}

int greeting(object me)
{
	string *msg;
	
	if(flag<=5)
	{
		msg=({
		"海浪轻轻的拍打着船舷\n",
		"遗忘之海的景色异常的迷人...\n",
		"几只海鸥追随着船尾,愉快的捕食被船惊吓的鱼儿\n",
		"你心中不断的祷告:慈祥的主阿,千万不要发生风暴\n",
		"天际和海面相接的地方已经黑压压的一片,暴风雨快要来临了\n",
		"一只鲸鱼在船的附近浮出水面换了口气。\n",
		});
		flag++;
		tell_room(this_object(),msg[random(5)],({}));
		call_out("greeting",5,me);
		return 1;
	}
	else
	{
		flag=0;
		if(me->query_temp("mark/back"))
		{
			me->move("/d/west/miwudao/gangkou");
			tell_object(me,"经过艰苦的航行,终于到达了迷雾岛的港口\n");
			return 1;
		}
		else
		{
			me->move(__DIR__"haitan1");
			tell_object(me,"经过艰苦的航行,终于到达了恶龙岛\n");
			return 1;
			
		}
	}
}