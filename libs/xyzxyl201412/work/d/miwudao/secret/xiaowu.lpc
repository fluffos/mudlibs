inherit ROOM;

void create() {
  set("short", "神秘小屋");
  set("long",
    "神秘小屋,阴暗寒冷...屋子里面凌乱的摆着各种瓶子，里面装着\n"
    "药水和一些奇怪的小生物的尸体。屋子的最里边放着一个陈旧的\n"
    "桌子，桌子上面摆放着一面镜子。\n"
  );
  set("objects", ([
    __DIR__ "npc/virginia": 1,
  ]));

  set("exits", ([
    "east": "/d/miwudao/zhaoze7",
  ]));

  setup();
  //	replace_program(ROOM);
}
