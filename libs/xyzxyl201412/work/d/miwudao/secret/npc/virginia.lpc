inherit NPC;
int ask_me();
int move_dixiashi();
int move_huadian();
int set_mark();
int kill_this_player();
int del_mark1();
int del_mark2();
int del_mark3();
private int step=0;
mixed query_story_message(int step,int num);

private mixed *story1 = ({
    "隐隐约约,传来对话的声音,你连忙细看,原来维吉尼亚正在对着一面镜子自言自语\n",
    "维吉尼亚对着镜子说道:魔镜啊魔镜,请问迷雾岛上谁最漂亮?\n",
    "从镜子里面传来的声音说道:啊,我尊敬美丽的主人,今天是您第56次问我这个问题了.\n",
    "从镜子里面传来的声音说道:即使您问我一百遍,答案都一样!您是最漂亮的人.\n",
    "从镜子里面传来的声音说道:别说迷雾岛,就是整个世界上,都找不到象您这样高贵,\n"
    "                      大方,美丽不凡,可爱的小女孩\n",
    "维吉尼亚露出满足的笑容,说道:哦,你说我还是个小女孩子吗?我太高兴了.\n",
    "从镜子里面传来的声音说道:是的,主人,您是那么的年轻,美丽,善良.\n",
    "从镜子里面传来的声音说道:您的声音犹如那悦耳的银铃.\n",
    "从镜子里面传来的声音说道:您的美貌如盛开的鲜花.\n",
    "从镜子里面传来的声音说道:您笑起来犹如花枝乱颤.\n",
    "从镜子里面传来的声音说道:可惜我在镜子的世界,不然的话。。。。。。\n",
    "维吉尼亚满意的笑了起来:呵呵,魔镜啊魔镜,你太会说话了...^_^\n",
    "维吉尼亚发现你的到来,停止了自言自语。\n",
    (:del_mark1:),
});
private mixed *story2 = ({
    "维吉尼亚说道:哼!这件事情过去了三年了,怎么现在还有人提起此事?\n",
    "你说道:少罗嗦,是不是你对苏西下的诅咒?\n",
    "维吉尼亚说道:是又怎样?不是又怎样?谁叫她当初过生日的时候没有邀请我?\n",
    "维吉尼亚说道:哼!这分明是轻视我!我从来不会让人轻视!\n",
    "你气愤的说道:一派胡言,为了安吉拉忘记邀请你,你就对苏西下如此毒手?\n",
    "你气愤的说道:你分明是妒忌,你妒忌苏西的美貌.\n",
    "维吉尼亚说道:呵呵,妒忌她的美貌?我是世界上最美丽的女人,怎么会妒忌她呢?\n",
    "你哈哈大笑:老实说,对你的容貌,我实在不敢恭维...\n",
    "维吉尼亚怒道:什么?你竟然侮辱我美丽的容貌!\n",
    "维吉尼亚怒道:难道你一点也看不出来我是如此地高贵！文雅！美丽么?\n",
    "你听了维吉尼亚的话，觉得胃里开始翻腾。。。\n",
    "维吉尼亚怒道:你要为你的话付出代价！\n",
    (:kill_this_player:),
    (:del_mark2:),
});

private mixed *story3 = ({
    "维吉尼亚喊道:别杀我,求求你别杀我,我愿意告诉你恢复苏西容貌的办法\n",
    "你连忙停止了攻击,上前揪住维吉尼亚的衣服喝道:快说!不然小心你的狗命！\n",
    "维吉尼亚说道:我说,我说。\n"
    "维吉尼亚说道：苏西受到的诅咒,我也没有办法解开...\n",
    "你气得两眼发直,喝道:你自己下的诅咒自己都无法解开?\n",
    "维吉尼亚说道:是的.这个世界上唯一能够恢复苏西容貌的办法只有一个。\n",
    "你喝道:快说！\n",
    "维吉尼亚连忙说道:在遗忘之海的一个叫恶龙岛的小岛上,恶龙守护这[神圣之水]。\n",
    "维吉尼亚说道:只有服下[神圣之水],苏西才能够恢复容貌。\n",
    "维吉尼亚说道:不过,神圣之水被恶龙守护着,没有这么容易得到。\n",
    "你说道:作为一个勇者,我不惧怕任何危险。我一定会弄到[神圣之水]。\n",
    (:del_mark3:),
});


void create()
{
	set_name("维吉尼亚", ({ "hag virginia","virginia"}) );
	set("nickname","女巫");
	set("gender", "女性");
	set("age", 40);
	set("long","维吉尼亚拥有可怕的魔法力量\n");

	set("combat_exp", 500000);

	set("per",5);
	set("str", 30);
	set("int", 30);
	set("cor", 20);
	set("cps", 30);
	set("spi", 30);

	set_skill("unarmed",60);
	set_skill("parry",80);
	set_skill("dodge",80);

	set("inquiry", ([ 
		"苏西":     (:ask_me:),
		"susie":     (:ask_me:),
		"安吉拉":     (:ask_me:),
		"angela":     (:ask_me:),
	    ]) );


	setup();
	carry_object("/d/miwudao/npc/obj/cloth")->wear();
	add_money("silver",random(50)+1);
}


void init()
{       
	object ob;
	ob=this_player();

	if(!this_object()->is_fightning()&&!query_temp("talking")&&!query_temp("display_story")
	    &&ob->query("mark/susie's smile")=="asked angela")

	{
		//remove_call_out("displayer_story");
		set_temp("display_story",1);//设置一个标记,表明当前显示的是故事1
		set_temp("talking",1);//标记,表明当前该物件正在说话.对后面的程序有用
		call_out("display_story",1,ob);
	}

}


int ask_me()
{
	object me;
	me=this_player();

	if(me->query("combat_exp")<=1000000)
	{
		tell_object(me,"维吉尼亚仔细打量了你半天,叹了口气,对你说道:哼!我的事情,不用你管.\n");
		return 1;
	}
	if(query_temp("display_story"))
	{
		tell_object(me,"维吉尼亚正在和他人聊天,没空理你\n");
		return 1;
	}
	if(me->query("mark/susie's simle")&&me->query("mark/susie's simle")!="asked angela")
	{
		tell_object(me,"我不是已经告诉了你么,要恢复苏西的容貌,必须到恶龙岛上面找到神圣之水给苏西服用\n"
		    "别怪我事先没有告诉你,恶龙岛上的恶龙非常厉害.到时候死掉了别怪我.^_^\n");
		return 1;
	}

	if(me->query("mark/susie's smile")=="asked virginia")
	{
		tell_object(me,"你不是已经知道了这件事情么?明知故问?赶快行动吧...\n");
		return 1;
	}

	if(me->query("mark/susie's smile")=="asked angela")
	{
		set_temp("talking",1);
		set_temp("display_story",2);
		call_out("display_story",1,me);
		return 1;	
	}
	else
	{
		tell_object(me,"维吉尼亚似乎不愿意提起此事\n");
		return 1;
	}
	return 0;
}
int display_story(object me)
{
	mixed line;

	if(environment(me)!=environment(this_object()))
	{
		delete_temp("talking");	
		step=0;
		return 1;
	}
	if(this_object()->is_fighting()) return 1;
	//	tell_object(me,step+"asdasdasd\n");
	line=query_story_message(step,query_temp("display_story"));
	if (functionp(line)) catch(line = evaluate(line));
	else if(stringp(line))
	{
		tell_object(me,line);
		//message_vision(line,me,this_object());

	}
	if(line)
	{
		step++;
		call_out("display_story",4,me);	
		return 1;
	}
	else
	{
		step=0;
		delete_temp("talking");
		remove_call_out("display_stroy");
		return 1;
	}
}

mixed query_story_message(int step,int num)
{

	switch(num)
	{
	case 1:
		return step < sizeof(story1) ? story1[step] : 0;
		break;
	case 2:
		return step < sizeof(story2) ? story2[step] : 0;
		break;

	case 3:
		return step < sizeof(story3) ? story3[step] : 0;
		break;
	default:
		return 0;

	}

}

int set_mark()
{
	object me;
	me=this_player();
	if(me) me->set("mark/susie's smile",1);
	return 1;
}

void unconcious()
{
	die();
	return ;	
}
int die()
{
	object player,virginia;
	player=query_temp("last_damage_from");
	if(player->query_temp("protecting")) player=player->query_temp("protecting");
	if(!objectp(player))
	{
		::die();
		return 1;
	}
	if(player&&player->query("mark/susie's smile")
	    &&stringp(player->query("mark/susie's smile"))
	    &&player->query("mark/susie's smile")=="asked virginia")
	{//玩家只有问过了维吉尼亚之后才能够继续剧情

		virginia=new(__DIR__"virginia");
		if(virginia)
		{
			//玩家可以去港口.在港口处租船出海.
			player->set("mark/susie's smile","can go to haven");
			virginia->set_temp("display_story",3);
			virginia->move(environment(player));
			virginia->start_speak(player);
			destruct(this_object());
			return 1;
		}
		else
		{
			command("say 呵呵,程序出错了,赶快通知巫师");
		}

	}
	::die();

}


int start_speak(object me)
{
	environment(me)->set("no_fight",1);
	set_temp("display_story",3);
	call_out("display_story",1,me);
}


int kill_this_player()
{
	object me;
	me=this_player();
	me->set("mark/susie's smile","asked virginia");
	kill_ob(me);
	return 1;	
}

int del_mark1()//每次显示完故事内容应该把设置的标记删除
{
	if(query_temp("display_story")==1)
		delete_temp("display_story");
}
int del_mark2()
{
	if(query_temp("display_story")==2)
		delete_temp("display_story");
}
int del_mark3()
{
	if(query_temp("display_story")==3)
		delete_temp("display_story");
}
