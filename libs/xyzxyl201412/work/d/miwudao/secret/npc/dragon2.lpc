inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("青龙", ({ "dragon"}) );
        set("gender", "男性");
        set("age", 20);
        set("long","安吉拉的女儿苏西,以前是迷雾岛最有名的美女,自从被女巫诅咒之后,就一直是这个样子.\n");

        set("combat_exp", 500000);

        set("per", 5);
        set("str", 30);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

      	set_skill("unarmed",60);
      	set_skill("parry",80);
      	set_skill("dodge",80);


        setup();
        carry_object("/d/miwudao/npc/obj/cloth")->wear();
        add_money("sliver",random(50)+1);
}
 
