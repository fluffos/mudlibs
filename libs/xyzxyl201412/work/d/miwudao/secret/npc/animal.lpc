#pragma save_binary

#include <ansi.h>

inherit NPC;

void create()
{
	string *name;
	name=allocate(8);
	name=({
	    "野兔","小刺猬","小狗熊","小狐狸","豺狼","山羊","巨蜥","巨蟒",
	});
	set_name(name[random(8)], ({ "animal" }) );	
	set("long","一只小动物.\n");
	set("per",30);
	set("str",30);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 3000);
	set("race","野兽");
	set("limbs", ({ "头部", "身体", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

	setup();
}


