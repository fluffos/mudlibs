// taolord.c

inherit NPC;
int ask_me();
int say_hello(object me);
int can_go_to_elongdao(object me);
int greeting(object me);
void create() {
  set_name("兰姆", ({ "boatman lamb", "lamb" }));
  set("nickname", "船夫");
  set("gender", "男性");
  set("age", 40);
  set("long", "船夫兰姆,造船手艺一流,\n");


  set("combat_exp", 1500000);

  set("class", "divine");
  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set_skill("unarmed", 60);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("divinemagic", 90);

  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 100);


  set("inquiry", ([
    "出海": (: ask_me :),
    "租船": (: ask_me :),
    "造船": (: ask_me :),
  ]));

  setup();

  add_money("gold", 1);
}

int init() {
  object me;
  me = this_player();
  if (me->query_temp("mark/susie's smile/time") != 0 &&
    time() - me->query_temp("mark/susie's smile/time") >= 7200
    || me->query("mark/susie's smile") == "go to elongdao")
    call_out("can_go_to_elongdao", 1, me);
  if (me->query("mark/susie's smile") == "killed the dragon") {
    call_out("say_hello", 1, me);
    return 1;
  }
  if (random(10) == 1)
    call_out("greeting", 1, me);
}

int say_hello(object me) {
  printf("%s高兴的和你打招呼:上帝保佑，你总算平安的回来了。\n", this_object()->name());
  return 1;
}
int can_go_to_elongdao(object me) {
  tell_object(me, "兰姆看到你,对你说,船已经造好了,出发吧\n");
  me->set("mark/susie's smile", "go to elongdao");
  environment(me)->add("exits", ([
    "enter": "/d/west/miwudao/secret/chuanshang",
  ]));

}
int greeting(object me) {
  command("say 要租船么?");
  return 1;
}


int ask_me() {
  object me;
  me = this_player();
  if (me->query("mark") == "lumber") {
    command("say 造一条船需要10棵大树...赶快去迷雾岛南边的树林里砍伐一些树木回来交给我");
    return 1;
  }

  if (me->query_temp("mark/susie's smile/time")) {
    command("say 造一条船需要一个月的时间,一个月之后你再来领船吧.");
    return 1;
  }
  if (me->query("mark") != "can go to haven") {
    command("say 我的船在上次的风暴当中全部被毁掉了");
    command("say 你要是急用,可以去树林里砍伐一些木材,我马上给你做");
    command("say 哦，树林就在迷雾沼泽的旁边。");
    me->set("mark/susie's smile", "lumber");
    return 1;
  }

  else {
    command("say 我的船在上次的风暴当中全部被毁掉了,唉...");
    return 1;
  }
  return 0;
}

int accept_object(object me, object obj) {
  if (obj->query("id") == "wood") {
    if (me->query_temp("lumber") < 10) {
      me->add_temp("lumber", 1);
      command("say 呵呵,总共需要10棵上好的木材才能够造一条好船");
      return 1;
    } else {
      command("say 好,一个月以后来取货");
      //me->delete_temp("lumber");
      me->set_temp("mark/susie's smile/time", time());
    }
  } else if (obj->query("money_id")) {
    if (obj->value() < 100) {
      printf("去哈柏港的船费是一个银币。\n");
      return 1;
    } else {
      printf("船片刻之后就会启程，麻烦您在此等候片刻。\n");
      call_out("go_habaigang", 5, me);
      return 1;
    }
  }
  return 1;
}

int go_habaigang(object me) {
  if (!objectp(me)) return 0;
  me->move("/d/west/habour/habour.lpc");
  return 1;
}
