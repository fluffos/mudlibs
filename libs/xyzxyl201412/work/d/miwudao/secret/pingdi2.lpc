// #include <ansi.h>
inherit ROOM;
void create() {
  set("short", "平地");
  set("long",
    "一块很平的区域，周围光秃秃的什么都没有。平地的北方是一个\n"
    "小水潭，西方是一片小树林。\n"
  );

  set("exits", ([
    "north": __DIR__ "shuitan",
    "west": __DIR__ "shulin3",
  ]));
  setup();
  //	replace_program(ROOM);
}
