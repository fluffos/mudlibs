// #include <ansi.h>
inherit ROOM;
void create() {
  set("short", "小树林");
  set("long",
    "一片小型树林，各种小型动物在树林中出没。从树林中不时传来\n"
    "一声声不知名的鸟叫声和动物的长嚎。\n"
  );
  set("exits", ([
    "north": __DIR__ "pingdi",
    "west": __DIR__ "shangang",
    "east": __DIR__ "pingdi2",
    "south": __DIR__ "haitan2",
  ]));
  set("objects", ([
    __DIR__ "npc/animal": 2,
  ]));

  setup();
  //	replace_program(ROOM);
}
