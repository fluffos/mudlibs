#pragma save_binary

// cloth.c
//
// This is the basic equip for players just login.

inherit ITEM;

void create()
{
	set_name("木材", ({ "wood" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "棵");
		set("material", "cloth");
		set("value",2000);
		set("long","一棵木材\n");
	}
	setup();
}
