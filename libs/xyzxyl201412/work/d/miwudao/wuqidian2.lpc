inherit ROOM;
void create()
{
	set("short", "魔法武器店");
	set("long",
"迷雾岛最出名的魔法武器店。墙上挂满了各种各样的武器。不但\n"
"有战士使用的，也有魔法师使用的。慕名而来的人很多，因为这\n"
"里的武器都被店主施加了魔法，可以在战斗中发挥很大的作用。\n"
);
	set("exits",([
	"south" : __DIR__"dajie7",
	"west" : __DIR__"wuqidian1",
	]));

	set("objects",([
	__DIR__"npc/sophia":1,	
	]));
	setup();
//replace_program(ROOM);
}
