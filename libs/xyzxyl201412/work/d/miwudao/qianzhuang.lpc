inherit ROOM;
int do_apply(string arg);
void create() {
  set("short", "银行");
  set("long",
    "迷雾岛唯一的银行，由大富翁艾波特掌管。在这里你可以自由的\n"
    "兑换钱币，申请银行帐户。在房间的大门口放置了一块醒目的牌\n"
    "子(sign)。上面写明了银行的各种服务。\n"
  );
  set("exits", ([
    "north": __DIR__ "dajie9",
    "west": __DIR__ "zhubaodian",
    "east": __DIR__ "daojudian",
  ]));

  set("objects", ([
    __DIR__ "npc/abott": 1,
  ]));


  //add_light(this_object(),1);//该房间不需要照明  不知道是什么东西by wenwu 2005-5-17

  set("item_desc", ([
    "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

convert     兑换钱币。
apply card  申请信用卡
TEXT
  ]));

  setup();
}

void init() {
  add_action("do_apply", "apply");
}

int do_apply(string arg) {
  object me, book, *ob;
  int s;
  me = this_player();
  if (!arg) return 0;
  if (arg != "card") return 0;
  ob = all_inventory(me);
  s = sizeof(ob);
  while (s--) {
    if (!stringp(ob[s]->query("id"))) continue;
    if (ob[s]->query("id") == "account card") {
      tell_object(me, "你已经有金龙卡了!\n");
      return 1;
    }
  }
  book = new("/obj/a_book.lpc");
  book->set("master_id", me->query("id"));
  book->set("rich", 0);
  book->move(me);
  if (file_size(book->query_save_file() + ".o") > 0) book->restore();
  tell_object(me, "你忽然觉得腰包一鼓, 好象多了点什么.\n");
  tell_room(this_object(), "钱庄老板艾博特把金龙卡递给" + me->query("name") + ".\n", me);
  return 1;
}
