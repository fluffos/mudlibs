// #include <ansi.h>
inherit ROOM;
int do_command();
void create() {
  set("short", "神圣广场");
  set("long",
    "神圣广场是整个迷雾岛的中心地带，广场的中央是一个约100平\n"
    "方米的水池。水池的中央是一个人造喷泉。广场的北部有一道石\n"
    "头砌成的台阶，台阶向上延伸，上面便是迷雾岛最著名的竞技场。\n"
  );
  set("exits", ([
    "south": __DIR__ "xiaoguangchang3",
    "north": __DIR__ "xiaoguangchang1",
    "west": __DIR__ "xiaoguangchang2",
    "east": __DIR__ "xiaoguangchang4",
    "up": __DIR__ "jingjichang1",
  ]));

  set("resource/water", 1);
  set("liquid/name", "清水");
  set("liquid/type", "alcohol");
  set("liquid/drunk_apply", 10);

  set("item_desc", ([
    "水池": "水清澈见底。可以饮用(fill)。\n",
  ]));

  setup();
  //replace_program(ROOM);
}
