// #include <ansi.h>
inherit ROOM;
void create() {
  set("short", "竞技场");
  set("long",
    "迷雾岛的竞技场。这里没有死亡，伤口也会很快复原，因此玩家\n"
    "可以在这里放心的较量。\n"
  );
  set("exits", ([
    "down": __DIR__ "jingjichang1",
  ]));

  set("no_death_penalty", 1);
  set("no_die", 1);
  set("chat_room", 1);
  set("no_arrest", 1);
  set_temp("light", 1);
  set("size/x", 7);
  set("size/y", 7);


  setup();
  //replace_program(ROOM);
}

void init() {
  add_action("do_command", "");
}

int do_command() {
  string *limit = ({
    "study", "pratice", "read", "selflearn", "research",
    "beg", "du", "conj", "follow", "drop",
  });
  if (member_array(query_verb(), limit) != -1) {
    if (wizardp(this_player())) return 0;
    else return 1;
    //            return !wizardp(this_player());
  }
  return 0;
}



int die_in_here(object me) {
  object killer;
  if (userp(me)) me->revive(1);
  if (objectp(killer = me->query_temp("last_damage_from"))) {
    message_vision("$n将$N逼到台边，尽全力一招向$N攻去，$N脚下踏空，翻落台下。\n", me, killer);
  } else {
    message("vision", me->name() + "脚下一个不稳，顿时跌下台去。\n", environment(me), ({ me }));
    tell_object(me, "你脚下一个不稳，跌下台去。\n");
  }
  tell_room(__DIR__ "jingjichang1", me->name() + "从台上摔了下来。\n");
  me->remove_all_killer();
  all_inventory(this_object())->remove_killer(me);
  me->dismiss_team();
  me->reincarnate();
  me->move(__DIR__ "jingjichang1");
  me->unconcious();
  return 1;
}
int valid_leave(object me, string dir) {
  if (me->is_fighting()) return 0;
  return 1;
}
