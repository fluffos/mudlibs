// azi.c 新手导师
inherit NPC;
inherit F_MASTER;
string ask_me();
void create() {
  set_name("新手导师", ({ "xinren daoshi", "xinren", "daoshi" }));
  set("title", HIG "新人技能导师" NOR);
  set("long",
    "她专门在这儿负责给予新人一些小小帮助。\n"
    "她容颜俏丽，总是笑着面对每一个人。\n");
  set("gender", "女性");
  set("age", 17);
  set("per", 30);
  set("attitude", "peaceful");
  set("no_get", 1);
  //set("no_fight", 1);
  set("shen_type", -1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 10000000);
  set("max_jing", 10000000);
  set("neili", 30000000);
  set("max_neili", 30000000);
  set("max_jing", 30000000);
  set("jingli", 30000000);
  set("jiali", 100000);
  set("combat_exp", 2100000000);
  set("score", 10000);
  set_skill("force", 5000);
  set_skill("taixuan-gong", 2000);
  set_skill("dodge", 5000);
  set_skill("shaolin-shenfa", 1000);
  set_skill("unarmed", 5000);
  set_skill("mantianhuayu", 2000);
  set_skill("parry", 5000);
  set_skill("sword", 5000);
  set_skill("blade", 5000);
  set_skill("throwing", 5000);
  //set_skill("babulongnv-jian", 5000);
  set_skill("literate", 10000);
  map_skill("force", "taixuan-gong");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("throwing", "mantianhuayu");
  map_skill("parry", "taixuan-gong");
  map_skill("unarmed", "taixuan-gong");
  create_family("星宿派", 2, "弟子");
  setup();
  //carry_object("/d/xingxiu/obj/xxqingxin-san");
  //carry_object("/d/xingxiu/obj/xxqingxin-san");
  carry_object("/clone/misc/cloth")->wear();
}
void attempt_apprentice(object ob) {
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
}
