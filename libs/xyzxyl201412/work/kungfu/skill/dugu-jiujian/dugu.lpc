#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


void remove_effect(object me, int a_amount, int d_amount);

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, ob;
  int skill, ap, dp;
  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「独孤情仇」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("「 独孤情仇 」必须用剑才能施展。\n");

  if ((int)me->query_skill("dugu-jiujian", 1) < 500)
    return notify_fail("你的「 独孤九剑 」不够娴熟，不会使用「独孤情仇」。\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力不够。\n");

  //    skill = me->query_skill("dugu-jiujian");        	
  /*   msg = HIC       "$N弹指抚剑神情漠然,"+weapon->name()    +"信手挥出,「独孤九剑」总诀式应手而出，剑影闪动"+weapon->name() +"直直击向$n。\n";      	
{
ap = me->query_skill("sword") + skill;	
dp = target->query_skill("force") / 2;	
if( dp < 1 )	
dp = 1;	
if (random(me->query_skill("force")) > target->query_skill("force")/5 )	
{	
damage = damage +  (int)me->query_skill("force", 1);	
damage = damage +  (int)me->query_skill("dugu-jiujian", 1);
target->receive_damage("qi", damage*5);		
target->receive_wound("qi", (damage/2)*5);		
me->add("neili", -damage);	
}      	
msg = HIR "$n顿时觉得眼前剑影闪动,不知来剑究竟指向何处，只觉一阵刺痛已然中招！\n" NOR;	
// };      	
// message_vision(msg, me, target);        	
//   return 1;                  	
*/
  //   msg = HIC "$N使出独孤九剑之「独孤九剑」,寂寞之意油然而起,手中" + weapon->name() + HIC "随意挥舞击刺,剑式变幻九剑诀连绵递出！\n"NOR; 
  msg = HIC "$N弹指抚剑神情漠然," + weapon->name() + "" HIC "信手挥出,「独孤九剑」总诀式应手而出，剑影闪动" + weapon->name() + "" HIC "直直击向$n。\n" NOR;
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 2) {
    skill = me->query_skill("dugu-jiujian");
    damage = damage + (int)me->query_skill("force", 1);
    damage = damage + (int)me->query_skill("dugu-jiujian", 1);
    message_vision(msg, me, target);

    me->add("neili", -200);

    me->clean_up_enemy();
    ob = me->select_opponent();
    msg = HIR "$n顿时觉得眼前剑影闪动,不知来剑究竟指向何处，只觉一阵刺痛已然中招！\n"
      HIC "$N神游虚外,已然忘我,手中" + weapon->name() + HIC "自然而然随意击划,剑式变幻九剑诀连绵递出！\n" NOR;
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    target->receive_damage("qi", damage * 5);
    target->receive_wound("qi", (damage / 2) * 5);
    me->add("neili", -damage);
    message_vision(msg, me, target);
    msg = HIR "破箭式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIY "破鞭式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
    msg = HIC "破刀式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIG "破枪式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIM "破索式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = CYN "破掌式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = RED "破锤式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIB "破剑式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIW "破气式！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);


    if (me->is_fighting()) me->start_busy(2);
    target->start_busy(3);
  } else {
    msg = HIG "$n心下一惊,急急出招迎向来势,匆忙中险险架住了$N的" + weapon->name() + HIG "。\n" NOR;
    me->start_busy(1 + random(2));
    message_vision(msg, me, target);
  }
  return 1;
}
