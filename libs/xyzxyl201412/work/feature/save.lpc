// save.c

#define DATAKEY_LOG "/log/key"

varargs int save(string data)
{
	string file, datakey_file, datakey;

	if ( data && data != "" )
	{
		assure_file(data + __SAVE_EXTENSION__);
		if ( save_object(data) )
		{
			if ( sscanf(data, "%*sdata/login/%*s") 
				|| sscanf(data, "%*sdata/user/%*s") 
				|| sscanf(data, "%*sdata/item/%*s") )
			{
				datakey_file = DATAKEY_FILE + data;
				assure_file(datakey_file + __SAVE_EXTENSION__);
				datakey = crypt(read_file(data + __SAVE_EXTENSION__), "wenwu");
				write_file(datakey_file + DATAKEY_NAME, datakey, 1);
			}
			return 1;
		} else {
			return 0;
		}
	}

	if( stringp(file = this_object()->query_save_file()) )
	{
		assure_file(file+ __SAVE_EXTENSION__);
		if ( save_object(file) )
		{
			if ( sscanf(file, "%*sdata/login/%*s") 
				|| sscanf(file, "%*sdata/user/%*s") 
				|| sscanf(file, "%*sdata/item/%*s") )
			{
				datakey_file = DATAKEY_FILE + file;
				assure_file(datakey_file + __SAVE_EXTENSION__);
				datakey = crypt(read_file(file + __SAVE_EXTENSION__), "wenwu");
				write_file(datakey_file + DATAKEY_NAME, datakey, 1);
			}
			return 1;
		} else {
			return 0;
		}
	}
	
	return 0;
}

varargs int restore(string data)
{
	string file, datakey_file, datakey, data_src, log_file;

	if ( data && data != "" )
	{
		if ( get_system_config(DATA_CONFIG_DIR "system.h", "DATAKEY") 
			&& (/*sscanf(data, "%*sdata/login/%*s") 
				||*/ sscanf(data, "%*sdata/user/%*s") 
				|| sscanf(data, "%*sdata/item/%*s")) )
		{
			datakey_file = DATAKEY_FILE + data + DATAKEY_NAME;
			log_file = DATAKEY_LOG + data + ".log";
			if ( file_size(data + __SAVE_EXTENSION__) < 1 )
			{
				//message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据文件 "HIG"%s"HIW" 不存在，无法加载\n"NOR, data+__SAVE_EXTENSION__), users());
				return 0;
			}
			if ( !(data_src = read_file(data + __SAVE_EXTENSION__)) )
			{
				//message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据文件 "HIG"%s"HIW" 无法读取，无法正常加载数据\n"NOR, data+__SAVE_EXTENSION__), users());
				return 0;
			}
			if ( file_size(datakey_file) < 1 )
			{
				message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据安全文件 "HIG"%s"HIW" 不存在，不能正常加载数据\n"NOR, datakey_file), users());
				assure_file(log_file);
				write_file(log_file, sprintf("%s : 数据安全文件(%s)不存在\n", CHINESE_D->chinese_time(7, 0), datakey_file));
				return 0;
			}
			if ( !(datakey = read_file(datakey_file)) )
			{
				message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据安全文件 "HIG"%s"HIW" 无法读取，不能正常加载数据\n"NOR, datakey_file), users());
				assure_file(log_file);
				write_file(log_file, sprintf("%s : 数据安全文件(%s)无法读取\n", CHINESE_D->chinese_time(7, 0), datakey_file));
				return 0;
			}
			if ( crypt(data_src, "wenwu") != datakey )
			{
				message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据文件 "HIG"%s"HIW" 已损坏，不能正常加载\n"NOR, data+__SAVE_EXTENSION__), users());
				assure_file(log_file);
				write_file(log_file, sprintf("%s : 数据文件已损坏\n", CHINESE_D->chinese_time(7, 0)));
				return 0;
			}
		}
		return restore_object(data);
	}

	if( stringp(file = this_object()->query_save_file()) )
	{
		if ( get_system_config(DATA_CONFIG_DIR "system.h", "DATAKEY") 
			&& (/*sscanf(file, "%*sdata/login/%*s") 
				||*/ sscanf(file, "%*sdata/user/%*s") 
				|| sscanf(file, "%*sdata/item/%*s")) )
		{
			datakey_file = DATAKEY_FILE + file + DATAKEY_NAME;
			log_file = DATAKEY_LOG + file + ".log";
			if ( file_size(file + __SAVE_EXTENSION__) < 1 )
			{
				//message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据文件 "HIG"%s"HIW" 不存在，无法加载\n"NOR, file+__SAVE_EXTENSION__), users());
				return 0;
			}
			if ( !(data_src = read_file(file + __SAVE_EXTENSION__)) )
			{
				//message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据文件 "HIG"%s"HIW" 无法读取，无法正常加载数据\n"NOR, file+__SAVE_EXTENSION__), users());
				return 0;
			}
			if ( file_size(datakey_file) < 1 )
			{
				message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据安全文件 "HIG"%s"HIW" 不存在，不能正常加载数据\n"NOR, datakey_file), users());
				assure_file(log_file);
				write_file(log_file, sprintf("%s : 数据安全文件(%s)不存在\n", CHINESE_D->chinese_time(7, 0), datakey_file));
				return 0;
			}
			if ( !(datakey = read_file(datakey_file)) )
			{
				message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据安全文件 "HIG"%s"HIW" 无法读取，不能正常加载数据\n"NOR, datakey_file), users());
				assure_file(log_file);
				write_file(log_file, sprintf("%s : 数据安全文件(%s)无法读取\n", CHINESE_D->chinese_time(7, 0), datakey_file));
				return 0;
			}
			if ( crypt(data_src, "wenwu") != datakey )
			{
				message("channel:sys", sprintf(HIR"【数据安全】"HIW"数据文件 "HIG"%s"HIW" 已损坏，不能正常加载\n"NOR, file+__SAVE_EXTENSION__), users());
				assure_file(log_file);
				write_file(log_file, sprintf("%s : 数据文件已损坏\n", CHINESE_D->chinese_time(7, 0)));
				return 0;
			}
		}
		return restore_object(file);
	}
	
	return 0;
}