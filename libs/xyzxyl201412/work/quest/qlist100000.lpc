mapping *quest = ({
  ([ "quest": "绣花鞋",
    "diff": 2,
  ]),
  ([ "quest": "蛇肉",
    "diff": 2,
  ]),
  ([ "quest": "铜号",
    "diff": 2,
  ]),
  ([ "quest": "香茶",
    "diff": 2,
  ]),
  ([ "quest": "绣花针",
    "diff": 2,
  ]),
  ([ "quest": YEL "黄玫瑰" NOR,
    "diff": 3,
  ]),
  ([ "quest": "道德经",
