#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "权力楼二层");
	set("long", @LONG
LONG);
	set("valid_startroom",1);
	set("area","归昧");
	set("exits", ([
                        "down" : __DIR__"quanlilou",
                        "up" : __DIR__"quanlilou2",
	]));
        replace_program(ROOM);
	setup();
}
