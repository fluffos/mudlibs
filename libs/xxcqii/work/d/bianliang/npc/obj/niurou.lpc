// jitui.c 鸡腿

#include <ansi.h>
inherit F_FOOD;
inherit ITEM;

void create()
{
	set_name(YEL"酱牛肉"NOR, ({ "jiang niurou", "jiang", "niurou", "rou" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一块散发着酱香的酱牛肉。\n");
		set("unit", "块");
		set("value", 200);
		set("food_remaining", 4);
		set("food_supply", 40);
	}
	setup();
}