// by jing 2000.7.14


inherit F_VENDOR_SALE;

void create()
{
  reload("xuyi_maihua_nu");
  set_name("杜鹃", ({"du juan", "du", "maihua nu", "nu"}));
  set("title", "卖花女");
  set("shop_id", ({"girl", "nu"}));
  set("gender", "女性");
  set("combat_exp", 5000);
  set("age", 16);
  set("per", 40);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set("vendor_goods", ([
        "flower": "/d/city/obj/flower",
        "hualan": "d/xuyi/obj/hualan",
        "rose": "/d/obj/flower/hua",
        "rose999": "/d/obj/flower/rose999",
             ]) );

  setup();
  carry_object("/d/xuyi/obj/ziskirt")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
  add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {  // 1/3 chance to greet.
            case 0 : command("say 买花吗？我的花是全城最漂亮的！"); break;
        }
}

