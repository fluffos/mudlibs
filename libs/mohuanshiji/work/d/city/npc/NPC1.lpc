// [lsg 2000/11/20 ]
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_me();
int ask_surrender();
void do_heal();

void create()
{
       string *menpai=({"方寸","将军府","月宫",});
       object me, ob;
       int skills,ages;
       skills=this_player()->query_skill("force",1);
       ages=this_player()->query("age");
       if(ages < 20)       ages = 20;
       me = this_object();
              set("attitude", "peaceful");
       set("age", ages);
       set("shen_type", 1);
        set("killer_job",1);

       set("str", 21+random(10));
       set("dex", 21+random(10));
       set("int", 21+random(10));
       set("con", 21+random(10));

       set("max_kee",this_player()->query("max_kee")/10*(11+random(8)));
       set("max_sen",this_player()->query("max_sen")/10*(8+random(8)));
              set("force",this_player()->query("max_force")/10*(8+random(8)));
       set("max_force",this_player()->query("max_force")
                      /10*(8+random(5)));
       set("combat_exp",this_player()->query("combat_exp")
                      /10*(8+random(20)));
       set("daoxing",this_player()->query("daoxing")
                      /10*(8+random(5)));                      

       set_skill("force",skills-(random(skills/2)));
       set_skill("dodge",  skills-(random(skills/2)));
       set_skill("parry", skills-(random(skills/2)));
       set_skill("literate",skills-(random(skills/2)));

       set("chat_chance_combat",20);
       set("chat_msg_combat", ({
              (: do_heal :),
        }) );
//        set("inquiry", ([  "讨教": (:ask_me:),
//                                        ]) ); 
        switch(menpai[random(sizeof(menpai))])
        {
        //start case 1(fm)
        case "方寸" :
        set_name("老道黑", ({"lao daohe"}));
        set("title",HIG"皇宫逃犯"NOR);
 set("gender", "男性");
        set_skill("jindouyun", skills-(random(skills/2)));
   set_skill("puti-zhi", skills-(random(skills/2)));
        set_skill("dao", skills-(random(skills/2)));
        set_skill("wuxiangforce", skills-(random(skills/2)));
        set_skill("unarmed", skills-(random(skills/2)));
                set_skill("qianjun-bang", skills-(random(skills/2)));
           set_skill("stick", skills-(random(skills/2)));

        map_skill("force", "wuxiangforce");
        map_skill("dodge", "jindouyun");
                map_skill("stick", "qianjun-bang");
        map_skill("unarmed", "puti-zhi");
                map_skill("spells", "dao");

       
        setup();
        switch(random(3)) 
        {
        case 0: carry_object("/d/lingtai/obj/bang")->wield();
                break;
        case 1: carry_object("/d/lingtai/obj/bang")->wield();
            break;
        }
        break;     

      //start case 3(hh)
      case "将军府":
        set_name("周正刚", ({"zhou zhengang","zhou"}));
        set("title",HIG"皇宫逃犯"NOR);
        set("gender", "男性");
        set_skill("unarmed", skills-(random(skills/2)));
             set_skill("spear", skills-(random(skills/2)));
        set_skill("changquan", skills-(random(skills/2)));
   set_skill("yanxing-steps", skills-(random(skills/2)));
   set_skill("bawang-qiang", skills-(random(skills/2)));
        set_skill("lengquan-force", skills-(random(skills/2)));
             map_skill("force", "lengquan-force");
        map_skill("unarmed", "changquan");
        map_skill("dodge", "yanxing-steps");
        map_skill("spear", "bawang-qiang");        


       
        setup();
         carry_object("/d/obj/weapon/spear/tieqiang")->wield();
        
             //start case 2(hh)
      case "月宫":
        set_name("菊影", ({"shade"}));
        set("title",HIG"皇宫逃犯"NOR);
        set("gender", "女性");

        set_skill("unarmed", skills-(random(skills/2)));
             set_skill("sword", skills-(random(skills/2)));
        set_skill("moondance", skills-(random(skills/2)));
   set_skill("moonforce", skills-(random(skills/2)));
   set_skill("moonshentong", skills-(random(skills/2)));
        set_skill("snowsword", skills-(random(skills/2)));

             map_skill("force", "moonforce");
        map_skill("unarmed", "moonshentong");
        map_skill("dodge", "moondance");
                map_skill("sword", "snowsword");


       
        setup();

// carry_object("/d/obj/weapon/sword/snow_sword")->wield();
 
//        }
        

}
}
void do_heal()
{
   command("exert recover");
   command("exert refresh");
}
void die()
{
        object me, corpse;
                int i,exp,pot,money;
        me = query_temp("last_damage_from");
        if( me->query("lsgquest") == 1 ){
            message_vision(HIR"\n$N口吐鲜血栽倒在地断气了。\n"NOR, this_object());
  exp=random(700);
     pot=random(400);
           me->add("combat_exp",exp);
           me->add("potential",pot);

           tell_object(me,sprintf(HIY"你成功的杀死一名皇宫逃犯，共获得了%d点武学经验，%d点潜能值。\n"NOR,exp,pot));  
            corpse = new("/obj/corpse");
            corpse->set("name",HIY" 皇宫逃犯的死尸"NOR);
            corpse->move(environment(this_object()));
            destruct(this_object());
            return;
        }
        else{
            message_vision(HIR"\n$N口吐鲜血栽倒在地断气了。\n"NOR, this_object());
            corpse = new("/obj/corpse");
            corpse->set("name",HIC"皇宫逃犯的死尸"NOR);

            corpse->move(environment(this_object()));
            destruct(this_object());
            return;
        }
}

