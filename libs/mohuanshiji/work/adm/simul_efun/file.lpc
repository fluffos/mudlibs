// file.c

void cat(string file) {
  write(read_file(file));
}

void log_file(string file, string text) {
  write_file(LOG_DIR + file, text);
}

void assure_file(string file) {
  string path, *dir;
  int i;

  if (file_size(file) != -1) return;

  seteuid(ROOT_UID);
  dir = explode(file, "/");
  dir = dir[0..sizeof(dir) - 2];
  path = "/";
  for (i = 0; i < sizeof(dir); i++) {
    path += dir[i];
    mkdir(path);
    path += "/";
  }
}

string base_name(object ob) {
  string file;

  if (sscanf(file_name(ob), "%s#%*d", file) == 2)
    return file;
  else
    return file_name(ob);
}

// AGENTS.md §15b: db_affected(db) (affected-row count after db_exec()) was
// only ever called, never defined anywhere in this lib -- this driver's DB
// package has no such efun either, and db_exec() itself returns 0 for
// INSERT/UPDATE/DELETE (no result set), so there's no real affected-row
// count obtainable through this driver's DB API at all. Every call site
// already checks db_exec()'s own return for the real success/failure
// signal, so a stub assuming >=1 row is a documented compromise, not a
// silent lie. Only reachable from adm/daemons/databased.lpc, which isn't
// on the preload list.
int db_affected(int db) {
  return 1;
}
