
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// AGENTS.md §15h: this driver indexes strings by Unicode codepoint
	// and counts strlen() in characters, not GBK bytes -- the original
	// `str[0] > 160 && str[0] < 255` GBK lead-byte check is now always
	// false against a real codepoint (e.g. 0x4e2d for 中). Use the CJK
	// Unified Ideographs codepoint range instead.
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
