// bamboo_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("λ糃", ({ "bamboo sword", "sword" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("value", 100);
		set("material", "bamboo");
		set("long", "硂琌р絤策糃猭ノλ糃糃矪ノガ癬ㄓ粇端︸\n");
		set("wield_msg", "$Nр絤糃ノ$n搐もい\n");
		set("unequip_msg", "$Nもい$n\n");
	}
	init_sword(10);
	setup();
}
