// pink_cloth.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("瑚璵", ({ "pink cloth", "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂ン︹瑚璵赂帝碭唉独腘籇癬ㄓ临Τ睭\n");
		set("unit", "ン");
		set("value", 600);
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("armor_prop/personality", 3);
		set("female_only", 1);
	}
	setup();
}

