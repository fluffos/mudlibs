// thin_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("灿糃", ({ "thin sword", "sword" }) );
	set_weight(1400);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("value", 700);
		set("material", "steel");
		set("long", "硂琌р灿糃淮钠钠钩琌產種\n");
		set("wield_msg", "$N┾р糃ō灿糃搐もい\n");
		set("unequip_msg", "$Nもい$n\n");
		set("weapon_prop/courage", -4);
	}
	init_sword(16);
	setup();
}
