// lumber_axe.c

#include <weapon.h>

inherit AXE;

void create()
{
	set_name("臟", ({ "lumber axe", "axe" }) );
	set_weight(22000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", "硂琌р℉臟ノㄓ\n");
		set("value", 11);
		set("wield_msg", "$Nрノ$n搐もい讽猌竟\n");
		set("unwield_msg", "$Nもい$n\n");
	}
	init_axe(11, TWO_HANDED);
	setup();
}
