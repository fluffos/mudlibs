inherit ROOM;

void create()
{
	set("short", "鯶常");
	set("long", @LONG
瞷ㄓ畒堵︹加ぇ玡加ㄨ帝鯶常┕
玭ぃ环矪Τ畒爵爵碍紇糽糽琌玱钮ぃ翴羘┕ǐ秈
加ǎ堵海海Τぶ砛穞︹璝留璝瞷皗脅帝
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"north" : "/d/death/road1",
		"south" : "/d/death/gate",
	]));
	set("objects", ([
		__DIR__"npc/bgargoyle": 1
	]) );

	setup();
