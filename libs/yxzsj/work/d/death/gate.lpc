// gate.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", HIW "碍闽" NOR);
	set("long", 
		"硂柑碞琌帝潮丁碍闽玡坯ミ帝畒蔼\n"
		"堵︹加砛\活タ弛弛钉玡秈秈碍闽碞礚猭\n"
		"锭丁\n");
	set("exits", ([
		"north" : "/d/death/gateway",
	]) );
	set("objects", ([
		__DIR__"npc/wgargoyle":1
	]) );
	setup();
	replace_program(ROOM);
}
