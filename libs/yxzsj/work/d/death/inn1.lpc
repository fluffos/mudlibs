void init()
{
        add_action("redirect_ask","ask");
}
 
int redirect_ask(string str)
{
        object ob;
        string name, tmp1, tmp2;
        ob = this_player();
        name=(string)ob->query("id");
	if (!str) return 0;
        if (sscanf(str,"%s about %s",tmp1, tmp2) == 2) {
                if (tmp1 == name && tmp2 =="產") 
                        return do_stuff(ob);
                        else return 0;
        }
        else return 0;
        return 0;
}
 
int do_stuff(object ob)
{
        write("ǐ玡, 羘ê眔蛤妓高拜產ㄆ.\n");
        tell_room(environment(ob),(string)ob->query("name")+
        "┕纠膌êǐ, ㎝竤堵紇ぃ弧ㄇぐ或.\n",
        ({this_object(), ob}));
        tell_room(environment(ob),
        "痺泊\ひ"+(string)ob->query("name")+"澈礛ぃǎ.\n",
        ({this_object(), ob}));
        write("ê杠ぃ弧碞┕硂娩疾筁ㄓ, 泊玡皚堵....\n");
	ob->reincarnate();
        ob->move("/d/school/heal");
        message("vision",
                "┛礛祇瞷玡紇ぃ筁ê紇钩竒ê柑\n"+
                "琌⊿祇谋\n", environment(ob), ob);
        return 1;
}
