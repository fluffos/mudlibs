// lightswo.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(HIY "流螢劍" NOR, ({ "light sword", "sword", "light" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "這是一把刀狂劍癡葉小釵用過的劍，是一頁書從巨書岩翻出來送給葉小釵的。\n"
      "它是古今十八種神器之一。\n"
      "”刀行如掛日，劍走似流螢。”便是一頁書形容它的最佳寫照。\n"
    );
    set("value", 10000);
    set("material", "steel");
    set("weapon_prop/sword", 40);
  }
  init_sword(100);

  set("wield_msg", "$N「唰」地一聲從刀劍套中抽出一把$n，握在手中。\n");
  set("unwield_msg", "$N將手中的$n插入背上的刀劍套。\n");

  setup();
}
int query_autoload() { return 1; }
