// healersu.c

inherit NPC;

#include <ansi.h>

void create() {
  set_name("素續緣", ({ "Healer su", "Healer", "healer", "healer su", "su", "Su" }));
  set("nickname", HIG "真" HIC "神仙" NOR);
  set("title", HIC "琉璃仙境" NOR);
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");
  set("long", "他便是素還真和風采鈴的兒子，看起來眉清目秀。\n"
    "他的臉上也有一顆藍珠，還有像他爸爸的漩渦眉。\n"
    "他一出生便被送到滅境，讓慈航渡的師弟大圓覺來教導。\n"
    "慈航渡為了提早讓素續緣除魔，使用了誕登挫骨法加速成長。\n"
    "後來他又殺了萬魔天指吸收魔氣而入魔，變為天下第一。\n"
    "再被龍末九殺死而進入葬屍江後，化為不知名在七彩雲天出現。\n"
    "又因救素還真，進入達願石變為道教的歸元聖童，後來被釋放。\n"
    "接著，他在鄉下開設醫館，懸壺濟世，救人無數，又遇到了許\多事。\n"
    "最後，他變回本來的面貌，和素還真過著快樂的生活。\n"
    "他的師父是大圓覺。\n"
  );

  set("combat_exp", 500000);
  set("score", 500000);
  set("rank_info/respect", "天下第一");
  set("class", "sage");
  set("max_kee", 5000);

  set("str", 40);
  set("int", 70);
  set("cor", 30);
  set("cps", 70);
  set("spi", 70);
  set("con", 70);
  set("kar", 40);
  set("per", 50);

  set("chat_chance", 3);
  set("chat_msg", ({
    "素續緣說：請問是來看診的嗎？\n",
    "素續緣正在忙著幫病人上藥。\n",
    "素續緣幫病人寫好診斷書。\n",
    "素續緣開好了一張藥方給病人。\n",
  }));

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 100);

  set("atman", 2000);
  set("max_atman", 2000);

  set("mana", 2000);
  set("max_mana", 2000);
  set("mana_factor", 200);

  set("inquiry", ([
    "素還真": "父親，能和你相處真好...",
    "一線生": "他是我父的一個朋友，很善機關巧計。",
    "風采鈴": "母親，你為了替我換血而亡，孩兒真對不起你...",
  ]));

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: command("exert bullets") :),
    (: command("exert astral_vision") :),
    (: command("exert recover") :),
  }));

  create_family("琉璃仙境", 2, "真神仙");

  set_skill("literate", 200);
  set_skill("magic", 150);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("move", 100);
  set_skill("cure", 250);

  set_skill("su-sk", 150);
  set_skill("buddhism", 100);
  set_skill("taoism", 100);

  map_skill("force", "su-sk");
  map_skill("spells", "su-sk");
  map_skill("magic", "su-sk");
  map_skill("unarmed", "su-sk");
  map_skill("dodge", "su-sk");
  map_skill("parry", "su-sk");

  setup();

  carry_object("/d/pili/glass/obj/blksuit")->wear();
  carry_object("/d/pili/glass/obj/bluehat")->wear();
  carry_object("/d/pili/glass/obj/healb");

  add_money("gold", 10);
}

void can_speak_poetry() {
  delete("speaking_poetry");
}

void speak_poetry() {
  if (!query("speaking_poetry")) {
    message_vision("\n", this_object());
    command("say 毫霜擲罷倚天寒，");
    command("say 任作淋漓淡墨看。");
    command("say 何敢自矜醫國手，");
    command("say 藥方只販古時丹。");
    set("speaking_poetry", 1);
    call_out("can_speak_poetry", 5);
  }
}

void init() {
  ::init();
  call_out("speak_poetry", 0);
}

void attempt_apprentice(object ob) {
  command("say 對不起，我最近忙著醫治病人，實在抽不出時間。");
}

int accept_fight(object me) {
  command("say 在下懸壺濟世，不爭武功\。");
  return 0;
}

void die() {
  string str;
  object killer, su, place;
  place = find_object("/d/pili/glass/glass");
  su = present("Master su", place);
  killer = this_object()->query_temp("last_damage_from");
  str = "               孤雛在天涯，雙親何所依？三更未歸巢，四顧心淒迷。\n"
    "               喚兒五六聲，淚\已七八滴；九泉在何處？十方不可覓。\n"
    "               百思千腸斷，望汝萬劫難；歷歷童顏在，班班白髮衣。\n";
  str = "\n\n" HIR "               素還真痛吟道：\n\n" HIY + str + "\n\n" NOR;
  shout(str);
  if (!(killer && su)) tell_room(environment(this_object()), str);
  if (killer && su) {
    str = HIC "    冤有頭，債有主。續緣，就讓為父為你盡最後一份心吧！\n"
      HIG "    素還真悄然起身，來到" + killer->query("name") + "的面前。\n" NOR;
    str = str + "\n\n";
    shout(str);
    //tell_room(environment(this_object()), str);
    su->move(environment(killer));
    su->kill_ob(killer);
    su->force("exert bullets");
  }
  ::die();
}
