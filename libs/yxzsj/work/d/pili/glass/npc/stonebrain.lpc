// stonebrain.c

inherit NPC;

#include <ansi.h>

void create() {
  set_name(HIY "石腦" HIW, ({ "stone brain", "stone", "brain" }));
  set("age", 1000);
  set("long", "石腦。\n"
  );

  set("combat_exp", 10000);
  set("score", 10000);

  set("chat_chance", 5);
  set("chat_msg", ({
    (: command("say 你的腦什麼時候要給我吃？") :),
    (: command("say 你的腦看起來不錯，很好吃。") :),
    (: command("emote 閉上眼睛開始冬眠。") :),

  }));


  setup();
}

varargs int receive_damage(string type, int damage, object who) {
  int val;

  if (damage < 0) error("F_DAMAGE: 傷害值為負值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 傷害種類錯誤( 只能是 gin, kee, sen 其中之一 )。\n");

  if (objectp(who)) {
    set_temp("last_damage_from", who);
    val = (int)who->query(type) - damage * 2;
    if (val >= 0) who->set(type, val);
    else who->set(type, -1);
    tell_room(
      environment(this_player()),
      HIR + "結果" + who->query("name") + HIR + "的攻擊竟然被" + query("name") + HIR + "變為兩倍反彈了回去，正好擊中了他自己！！\n" NOR
    );
  }

  set_heart_beat(1);

  return damage;
}

varargs int receive_wound(string type, int damage, object who) {
  int val;

  if (damage < 0) error("F_DAMAGE: 傷害值為負值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 傷害種類錯誤( 只能是 gin, kee, sen 其中之一 )。\n");

  if (objectp(who)) {
    set_temp("last_damage_from", who);
    val = (int)who->query("eff_" + type) - damage * 2;
    if (val >= 0) who->set("eff_" + type, val);
    else {
      who->set("eff_" + type, -1);
      val = -1;
    }
    if ((int)who->query(type) > val) who->set(type, val);
    tell_room(
      environment(this_player()),
      HIR + "結果" + who->query("name") + HIR + "的攻擊竟然被" + query("name") + HIR + "變為兩倍反彈了回去，正好擊中了他自己！！\n" NOR
    );
  }

  set_heart_beat(1);

  return damage;
}
