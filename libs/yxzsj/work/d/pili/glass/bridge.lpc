// Room: /d/pili/glass/bridge.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小橋");
  set("long", @LONG
這裡是一座連接琉璃仙境入口的小橋，走在上面，看著底下流水潺潺，
也別有一番風味。從這你可以看到在泉水的源頭，竟然有一座絹絲般的瀑布
在沖刷而下，使人不禁讚嘆大自然的鬼斧神工。聽到流水聲，你的心情也逐
漸好了起來，從這可以看到水中還有一些魚兒(fish)，在悠遊自在的游著。
或許你可以用手去摸(touch)看看。
LONG
  );
  set("outdoors", "1");
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "glass",
    "west": __DIR__ "entrance",
  ]));
  set("no_clean_up", 0);
  set("fall", 1);

  setup();
}

void init() {
  add_action("do_touch", "touch");
  call_out("bgtext", 5);
}

int do_touch(string arg) {
  if (arg != "fish")
    return notify_fail("你要摸什麼？\n");
  write(HIC "\n遠處傳來一陣聲音說：" + RANK_D->query_respect(this_player()) + HIC + "請住手。\n\n" NOR);
  return 1;
}

void bgtext() {
  if (environment(this_player())->query("fall") == 1) {
    tell_room(environment(this_player()), HIC "瀑布的水淙淙的流下，聽起來真是動聽。\n" NOR);
    call_out("bgtext", 10);
  }
}
