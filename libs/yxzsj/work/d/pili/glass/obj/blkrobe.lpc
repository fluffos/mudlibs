// blkrobe.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(WHT "玄衣" NOR, ({ "black robe", "black", "robe" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件素還真穿的玄衣，神秘深沉，就如同他的個性一般。\n");
    set("unit", "件");
    set("value", 10000);
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 30);
    set("armor_prop/force", 20);
    set("armor_prop/spells", 20);
    set("armor_prop/magic", 20);
  }
}
