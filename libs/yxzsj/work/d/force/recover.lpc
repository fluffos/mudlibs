// recover.c

inherit SSERVER;

int exert(object me, object target)
{
	if( target != me ) return notify_fail("ノず\秸っ︑\n");

	if( (int)me->query("force") < 20 )
		return notify_fail("ずぃ镑\n");

	me->receive_heal("kee", 10 + (int)me->query_skill("force")/3 );
	me->add("force", -20);

	message_vision("$N瞏瞏碭羪︹癬ㄓ\n", me);

	if( me->is_fighting() ) me->start_busy(1);

	return 1;
}
