#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "羅漢堂");
  set("long", @LONG

    這裡是靈佛殿平時習武的地方﹐一改寧靜祥和的氣氛﹐這裡的空氣迴盪
著莊嚴肅穆﹐中央有一個依據星宿所排出來的木人(wood)陣﹐這些木人看起
來都很堅固﹐你可以試著敲打木人(hit) 看看。

LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "room5",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_transmit", 1);
  set("light_up", 1);
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_hit", "hit");
}

int do_hit(string arg)

{
  object me;
  me = this_player();
  if (!arg || arg != "wood") return notify_fail("你要打什麼﹖\n");
  if (me->query("combat_exp") > 200000) return notify_fail("你的武術值夠高了﹐已經無法從擊打木樁提昇能力。\n");
  if (me->query("combat_exp") < 20000) return notify_fail("你的武術值不夠高﹐並無法從擊打木樁提昇能力。\n");
  if (me->query("sen") < 15) return notify_fail("你已經累了﹐休息一下再練吧。\n");
  message_vision("$N拳腳齊施對著木樁身上一陣打擊。\n", me);
  me->receive_damage("sen", 15);
  me->add("combat_exp", 1);
  return 1;
}
