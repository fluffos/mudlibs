#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
	set("short", "借肚癳");
	set("long", @LONG
硂柑琌借肚癳ず场泊玡Τ帮筿福㎝筿杆竚硂ㄇ
诀竟笲瞶獶盽狡馒璓ㄓ弧琌р借だ秆Θ竒パ丁肚癳
ヘ穝舱ウ琵程еよΑ盢借肚癳ㄇ
暗借舱疭翴鲤Τ陪泊棵辊(monitor)陪ボ帝狝叭
よΑの弧
LONG
	);
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/operator" : 1,
]));
	set("exits", ([ /* sizeof() == 1 */
  "out" : __DIR__"transout",
  "hanger" : __DIR__"transrm",
]));
	set("item_desc", ([ /* sizeof() == 1 */
  "monitor" :"
"HIG"舧ㄏノ借肚癳呼隔⌒秇獿い厩"NOR"

竒パ借肚癳呼隔и伐祏丁ず盢ヴ︙珇肚癳
肚癳沮翴パ秖м砃Θ剪借だ秆の舱м砃竒
ぃ琌拜肈琌иご礛某タ盽ㄏノ肚癳磷祇ネぃゲ璶繧

"HIM"璶ㄏノ肚癳叫宽酚˙艼"NOR"

"HIY"1."NOR"叫盢璶肚癳珇肚癳康(hanger)ずず絋粄闽康
"HIY"2."NOR"匡拒肚癳翴(select)狝叭煤ユ狝叭禣ヘ玡琌1000じ┪ㄢ蝗
"HIY"3."NOR"狝叭璶―(ask)币笆肚癳狝叭(start)

"HIM"ヘ玡矗ㄑ肚癳翴Τ"NOR"

"HIY"1."HIC"痆件挂"NOR"

Ω谅谅眤叫ノセ狝叭

",
]));

	set("no_clean_up", 0);
	set("no_fight", 1);
	set("no_magic", 1);

	setup();
	create_door("hanger", HIG"肚癳康"NOR, "out", 0);
}

void init()
{
	add_action("do_select", "select");
}

int do_select(string arg)
{
	if( !arg ) {
		if( this_player()->query_temp("trans_pos") )
			write("瞷匡拒肚癳翴琌"+this_player()->query_temp("trans_name")+"\n");
		else
			return notify_fail("瞷⊿Τ匡拒ヴ︙肚癳翴\n");
		return 1; }
	if( arg == "1" ) {
		write("肚癳翴匡拒"HIC"痆件挂"NOR"\n");
		message("vision", (string)this_player()->name()+"匡拒"HIC"痆件挂"NOR"肚癳翴\n", environment(this_player()), this_player());
		this_player()->set_temp("trans_pos", "/d/Pili/glass/airport");
		this_player()->set_temp("trans_name", HIC"痆件挂"NOR);
		return 1; }
	return notify_fail("叫块タ絋翴絪腹select <絪腹> \n");
}