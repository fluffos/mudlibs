// Room: /d/school/trans.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "物質傳送站");
  set("long", @LONG
這裡是物質傳送站的內部，你的眼前有一大堆的電腦和電子裝置，這些
機器運作的原理非常複雜。大致上來說是把物質分解成原子，經由空間傳送
後在目的地加以重新組合。它可以讓你以最快的方式將物質傳送到一些可以
做物質重組的特殊地點，牆上有一個顯眼的螢幕(monitor)，顯示著服務的
方式及說明。
LONG
  );
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/operator": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "transout",
    "hanger": __DIR__ "transrm",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "monitor": "
" HIG "歡迎使用物質傳送網路－逸俠中學站" NOR "

經由物質傳送網路，我們可以在極短的時間內，將任何的物品傳送到世界各
地的各個傳送據點。由於量子技術的成熟，物質的分解及重組在技術上已經
不是問題，但是我們仍然建議你正常的使用傳送站，避免發生不必要的危險。

" HIM "要使用各地的傳送站，請遵照下列步驟：" NOR "

" HIY "1." NOR "請先將要傳送的物品放入傳送艙(hanger)內，並於內確認，再關上艙門。
" HIY "2." NOR "選擇傳送地點(select)，並向服務人員繳交服務費，目前是1000元或十兩銀子。
" HIY "3." NOR "向服務人員要求(ask)啟動傳送服務(start)。

" HIM "目前提供的傳送地點有：" NOR "

" HIY "1." HIC "琉璃仙境" NOR "

再次謝謝您的合作，請多加利用本服務。

",
  ]));

  set("no_clean_up", 0);
  set("no_fight", 1);
  set("no_magic", 1);

  setup();
  create_door("hanger", HIG "傳送艙門" NOR, "out", 0);
}

void init() {
  add_action("do_select", "select");
}

int do_select(string arg) {
  if (!arg) {
    if (this_player()->query_temp("trans_pos"))
      write("你現在選擇的傳送地點是：" + this_player()->query_temp("trans_name") + "。\n");
    else
      return notify_fail("你現在並沒有選擇任何傳送地點。\n");
    return 1;
  }
  if (arg == "1") {
    write("傳送地點選擇：" HIC "琉璃仙境" NOR "\n");
    message(
      "vision",
      (string)this_player()->name() + "選擇了" HIC "琉璃仙境" NOR "作為傳送地點。\n",
      environment(this_player()),
      this_player()
    );
    this_player()->set_temp("trans_pos", "/d/Pili/glass/airport");
    this_player()->set_temp("trans_name", HIC "琉璃仙境" NOR);
    return 1;
  }
  return notify_fail("請輸入正確地點編號：select <編號> \n");
}
