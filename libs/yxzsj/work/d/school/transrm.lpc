// Room: /d/school/transrm.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "傳送艙");
  set("long", @LONG
這裡是物質傳送站的傳送艙內，你感到周圍有各式各樣的電磁場環
繞，你可以把要傳送的東西放在這裡，放好後打(check)。你心想還是
不要在這個地方待的太久為妙，離去後別忘了關門(close door)。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "trans",
  ]));
  set("no_clean_up", 0);

  setup();
  create_door("out", HIG "傳送艙門" NOR, "hanger", 0);
}

void init() {
  add_action("do_check", "check");
}

int do_check() {
  this_player()->set_temp("hanger", environment(this_player()));
  message_vision("$N把東西放好後，在牆上電腦面板上選了確認選項。\n", this_player());
  return 1;
}
