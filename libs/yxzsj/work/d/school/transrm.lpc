// Room: /d/school/transrm.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
	set("short", "肚癳康");
	set("long", @LONG
硂柑琌借肚癳肚癳康ず稰㏄瞅ΤΑ妓筿合初吏
露р璶肚癳狥﹁硂柑ゴ(check)み稱临琌
ぃ璶硂よびМ瞒а闽(close door)
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "out" : __DIR__"trans",
]));
	set("no_clean_up", 0);

	setup();
	create_door("out", HIG"肚癳康"NOR, "hanger", 0);
}

void init()
{
	add_action("do_check", "check");
}

int do_check()
{
	this_player()->set_temp("hanger", environment(this_player()));
	message_vision("$Nр狥﹁鲤筿福狾匡絋粄匡兜\n", this_player());
	return 1;
}