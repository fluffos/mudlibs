inherit BANK;

void create() {
  set("short", "辦公室");
  set("long", @LONG
這裡是逸俠中學出納組的辦公室，平時因不須接觸學生，
所以辦公室位置在地下室。所有學生的註冊繳費等，都是
經由出納組管理，常常處理大量的金額。他們平時較有空閒，
很樂意順便幫學生忙，牆上有一個告示(sign)，說明他們
可以幫學生處理的事項。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "teach2d",
  ]));
  set("item_desc", ([
    "sign": @TEXT
這裡是出納組，目前我們幫學生提供的服務有﹕

deposit     存款
withdraw    提款
convert     兌換錢幣
balance     查詢餘額
TEXT
  ]));

  setup();
}
