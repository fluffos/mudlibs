// C4.c

#include <weapon.h>

inherit WARHEAD;

void create()
{
	set_name("200絊蔼脄紆繷", ({ "200 pound HE warhead", "200", "HE", "warhead"}) );
	set_weight(15000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "ㄇ");
		set("base_unit", "");
		set("base_weight", 15000);
		set("base_value", 100000);
		set("value", 100000);
		set("long", "200絊蔼脄紆繷\n");
	}
	set("wield_msg", "$N盢$n羭癬搐もい\n");
	set("unwield_msg", "$N盢もい$n\n");
	set_amount(1);
	setup();
	init_warhead(50);
}