// Harpoon.c

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("魚叉飛彈", ({ "Harpoon missile", "harpoon", "missile" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "魚叉反艦飛彈是美國標準的反艦飛彈，\n"
      "雖然射程不是很長，但Block II型號經改進，\n"
      "可攻擊在任何地方，甚至是港口裡的船艦目標。\n"
      "而且可以普遍配備，是很有用的武器。\n");
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 1000);
    set("base_value", 100000);
    set("value", 1000000);
    set("wield_msg", "$N將$n填入尾端的發射架，做好發射的準備。\n");
    set("unwield_msg", "$N將$n自發射架中卸載取出。\n");
  }
  set_amount(8);
  init_throwing(5000);
  setup();
}
int query_autoload() { return 1; }
