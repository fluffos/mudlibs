// watch.c

#include <ansi.h>
#include <localtime.h>

inherit ITEM;

void create() {
  set_name("手錶", ({ "watch" }));
  set("weight", 200);
  set("long", "這是一隻Swatch手錶，樣式新穎，它能告訴你現在遊戲中的時間(watch)。\n");
  set("value", 1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "隻");
  }
  setup();
}

void init() {
  add_action("do_watch", "watch");
}

int do_watch() {
  mixed *local;
  local = localtime(time() * 60);
  write("現在時刻：" + local[LT_HOUR] + ":" + local[LT_MIN] + "\n");
  return 1;
}
