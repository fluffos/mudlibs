// watch.c

#include <ansi.h>
#include <localtime.h>

inherit ITEM;

void create()
{
	set_name("も况", ({ "watch" }) );
	set("weight", 200);
	set("long", "硂琌唉Swatchも况妓Α穝縪ウ禗瞷笴栏い丁(watch)\n");
	set("value", 1500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "唉");
	}
	setup();
}

void init()
{
	add_action("do_watch", "watch");
}

int do_watch()
{
	mixed *local;
	local = localtime(time()*60);
	write("瞷ㄨ"+local[LT_HOUR]+":"+local[LT_MIN]+"\n");
	return 1;
}