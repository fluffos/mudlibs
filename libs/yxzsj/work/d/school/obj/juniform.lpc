// juniform.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("瓣い狝", ({ "junior uniform","uniform","uni" }) );
	set_weight(1500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン瓣い场狝μ︹浓璵堵︹祏壳\n");
		set("unit", "ン");
		set("value", 100);
		set("material", "cloth");
		set("armor_prop/armor", 1);
	}
	setup();
}
int query_autoload() { return 1; }