// budbook.c

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY + "大悲心陀羅尼經" + NOR, ({ "book" }));
  set_weight(1000);
  set("unit", "本");
  set("long",
    "這是一本佛經，看來其中佛理甚為深奧。\n");
  set("value", 500);
  set("skill", ([
    "name": "buddhism",  // name of the skill
    "exp_required": 1000,   // minimum combat experience required
    // to learn this skill.
    "sen_cost": 40,   // sen cost every time study this
    "difficulty": 30,   // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 200   // the maximum level you can learn
    // from this object.
  ]));
}
