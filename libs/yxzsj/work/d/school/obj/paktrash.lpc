// paktrash.c

inherit ITEM;

#include <ansi.h>

void create() {
  set_name("綁好的" WHT "垃圾袋" NOR, ({ "packed trash bag", "packed", "bag", "trash" }));
  set_weight(7200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long", "這是一包裝滿垃圾的黑色塑膠垃圾袋，袋口已經綁緊。\n");
    set("value", 100);
    set("packed_trash", 1);
    set("no_drop", 1);
    set("no_sac", 1);
  }
}
int query_autoload() { return 1; }
