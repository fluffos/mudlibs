// bread.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("飯團", ({ "rice" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一個外面包著海苔，裡面是飯的飯團。\n");
    set("unit", "個");
    set("value", 20);
    set("food_remaining", 5);
    set("food_supply", 60);
  }
}
