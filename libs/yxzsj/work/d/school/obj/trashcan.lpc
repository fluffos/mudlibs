// trashcan.c

#include <ansi.h>

inherit ITEM;

void create() {
  set_name("垃圾桶", ({ "trash can", "trash", "can" }));
  set("weight", 2000);
  set("long", "這是一個普通的塑膠垃圾桶，你可以把垃圾丟在裡面。\n"
    "你可以幫垃圾桶換垃圾袋(change)，清除裡面的垃圾。\n");
  set_max_encumbrance(7000);
  set("value", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "個");
  }
  set("container", 1);
  set("no_get", 1);
  set("no_sac", 1);
  setup();
}

void init() {
  add_action("do_change", "change");
}

void change_bag(object ob) {
  object *inv;
  int i;
  message_vision(
    "$N把垃圾桶裡的" NOR + WHT "垃圾袋" NOR "拿出來，換上一個新的" NOR + WHT "垃圾袋" NOR "。\n",
    this_player()
  );
  inv = all_inventory(this_object());
  for (i = 0; i < sizeof(inv); i++) {
    inv[i]->move(ob);
  }
}

int do_change(string arg) {
  object ob, me;
  me = this_player();
  if (me->is_busy())
    return notify_fail("你現在沒空﹗\n");
  if (!arg) return notify_fail("你要用什麼東西來換垃圾袋？\n");
  ob = present(arg, environment(me));
  if (!ob) ob = present(arg, me);
  if (!ob) return notify_fail("這個地方和你的身上並沒有這項物品。\n");
  if (ob->query("trashbag")) {
    change_bag(ob);
    return 1;
  } else {
    return notify_fail("這個東西不是垃圾袋﹗\n");
    return 1;
  }
}
