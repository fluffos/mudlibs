// schobelt.c 

#include <armor.h>
#include <ansi.h>

inherit WAIST; 

void create() 
{ 
	set_name("狝"WHT"ブ盿"NOR, ({ "school belt","belt" }) ); 
	set_weight(500); 
	set("long", "硂琌兵厩狝"WHT"ブ盿"NOR""WHT"ブ盿"NOR"ΙΤ秇獿い厩啦癬ㄓ炊硄\n"); 
	set("value",100);
	set("unit", "兵"); 
	set("armor_type","waist");
	set("material", "leather"); 
	set("armor_prop/armor", 1);
	set("armor_prop/defense", 1);
	setup(); 
} 
int query_autoload() { return 1; }