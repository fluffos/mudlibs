// suniform.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("蔼い狝", ({ "senior uniform","uniform","uni" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン蔼い场狝μ︹浓璵μ︹壳\n");
		set("unit", "ン");
		set("value", 150);
		set("material", "cloth");
		set("armor_prop/armor", 2);
	}
	setup();
}
int query_autoload() { return 1; }