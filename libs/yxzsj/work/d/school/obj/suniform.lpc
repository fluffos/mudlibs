// suniform.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("高中制服", ({ "senior uniform", "uniform", "uni" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件高中部的制服，米色襯衫，米色長褲。\n");
    set("unit", "件");
    set("value", 150);
    set("material", "cloth");
    set("armor_prop/armor", 2);
  }
  setup();
}
int query_autoload() { return 1; }
