// bread.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("难", ({ "bread" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "鹅溅杆眖┍柑癳ㄓ难\n");
		set("unit", "");
		set("value", 10);
		set("food_remaining", 5);
		set("food_supply", 60);
	}
}
