// donbox.c

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "捐獻箱" NOR, ({ "donation box", "donation", "box", "don" }));
  set("weight", 500);
  set("long", "這是一個用來捐募的小箱子，你可以把想捐的東西放在裡面。\n");
  set_max_encumbrance(10000000000);
  set("value", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "個");
  }
  set("container", 1);
  set("no_get", 1);
  set("no_sac", 1);
  setup();
}
