// donbox.c

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIY"膍絚"NOR, ({ "donation box", "donation", "box", "don" }) );
	set("weight", 500);
	set("long", "硂琌ノㄓ兑絚р稱狥﹁柑\n");
	set_max_encumbrance(10000000000);
	set("value", 100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "");
	}
	set("container", 1);
	set("no_get", 1);
	set("no_sac", 1);
	setup();
}