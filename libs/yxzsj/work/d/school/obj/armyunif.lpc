// armyunif.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIG "陸軍制服" NOR, ({ "army uniform", "uniform", "uni" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件綠色的陸軍制服，肩膀上還繡著兩個梅花。\n");
    set("unit", "件");
    set("value", 500);
    set("material", "cloth");
    set("armor_prop/armor", 8);
  }
  setup();
}
