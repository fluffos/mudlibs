// drink.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("飲料", ({ "drink" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一瓶普通的飲料，好像還蠻好喝的。\n");
    set("unit", "瓶");
    set("value", 15);
    set("max_liquid", 5);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "飲料",
    "remaining": 5,
  ]));
}
