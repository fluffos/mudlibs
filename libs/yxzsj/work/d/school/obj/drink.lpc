// drink.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("都", ({ "drink" }) );
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "瞺炊硄都钩临芞耻\n");
		set("unit", "瞺");
		set("value", 15);
		set("max_liquid", 5);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "water",
		"name": "都",
		"remaining": 5,
	]) );
}
