// water.c

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create() {
  set_name(HIC "礦泉水" NOR, ({ "water" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一個普通的礦泉水瓶，容量500cc，是體育課完學生的最愛。\n");
    set("unit", "瓶");
    set("value", 20);
    set("max_liquid", 7);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "水",
    "remaining": 7,
  ]));
}
