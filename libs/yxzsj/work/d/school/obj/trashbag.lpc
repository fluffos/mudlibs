// trashbag.c

inherit ITEM;

#include <ansi.h>

void create()
{
	set_name(WHT"︰В砋"NOR, ({ "trash bag", "bag", "trash" }) );
	set_weight(200);
	set_max_encumbrance(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "");
		set("long", "硂琌堵︹鹅溅︰В砋ノㄓ︰В表柑杆︰В\n"
			"杆︰В盢盿竕候(pack)\n"
		);
		set("value", 50);
		set("container", 1);
		set("trashbag", 1);
	}
}

void init()
{
	add_action("do_pack", "pack");
}

int do_pack()
{
	object ob;
	ob = new("/d/school/obj/paktrash");
	message_vision("$Nр杆骸︰В"NOR+WHT"︰В砋"NOR"盿竕候矗も\n", this_player());
	ob->move(this_player());
	destruct(this_object());
	return 1;
}