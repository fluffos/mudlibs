// schoshoe.c
 
#include <armor.h> 

inherit BOOTS; 

void create() 
{ 
	set_name("布鞋", ({ "school shoes", "shoes","shoe" }) );
	set("long", "這是一雙學校規定穿的鞋子，雖然沒有NIKE球鞋好，但也挺舒適。\n"); 
	set_weight(2000); 
	if( clonep() ) 
		set_default_object(__FILE__); 
	else { 
		set("armor_type","boots");
		set("armor_prop/dodge", 5);
		set("armor_prop/boots", 5); 
		set("unit", "雙"); 
                set("value",800);
	} 
	setup(); 
} 
int query_autoload() { return 1; }