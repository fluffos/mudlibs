// schoshoe.c
 
#include <armor.h> 

inherit BOOTS; 

void create() 
{ 
	set_name("ガ綾", ({ "school shoes", "shoes","shoe" }) );
	set("long", "硂琌蛮厩砏﹚綾瘤礛⊿ΤNIKE瞴綾滴続\n"); 
	set_weight(2000); 
	if( clonep() ) 
		set_default_object(__FILE__); 
	else { 
		set("armor_type","boots");
		set("armor_prop/dodge", 5);
		set("armor_prop/boots", 5); 
		set("unit", "蛮"); 
                set("value",800);
	} 
	setup(); 
} 
int query_autoload() { return 1; }