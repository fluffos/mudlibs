// bicycle.c

inherit ITEM;

void create() {
  set_name("腳踏車", ({ "bicycle", "bike" }));
  set("weight", 2000);
  set("long", "這是一輛普通的腳踏車，看來很堅固耐用。你可以試著去騎(ride)它。\n");
  set("value", 3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "輛");
  }
  set("ridable", 1);
  set("no_get", 1);
  set("prop/dodge", 5);
  set("prop/move", 10);
  set("skill_limit", 10);
  setup();
}
