// TLAM.c

#include <weapon.h>

inherit MISSILE;

void create() {
  set_name(
    "戰斧攻地飛彈",
    ({ "Tomahawk Land Attack Missile", "TLAM", "tomahawk", "missile", "SLCM", "land", "attack" })
  );
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "戰斧攻地飛彈是最有名的地面打擊武器，\n"
      "它在兩次波灣戰爭中，充分飛揮了它的特長，使盟軍減少許\多死傷。\n"
      "它可以沿著地貌作低高度飛行，躲避雷達偵測，\n"
      "並在飛越數百公里後，準確的擊中目標，誤差不超過10公尺。\n");
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 2000);
    set("base_value", 500000);
    set("value", 5000000);
    set("wield_msg", "$N將$n填入垂直發射系統，做好發射的準備。\n");
    set("unwield_msg", "$N將$n自垂直發射系統中卸載取出。\n");
  }
  set_amount(10);
  init_missile(50000);
  setup();
}
int query_autoload() { return 1; }
