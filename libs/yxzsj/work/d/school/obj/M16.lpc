// M16.c

#include <weapon.h>

inherit GUN;

void create() {
  set_name("M16步槍", ({ "M16 rifle", "M16", "rifle", "m16" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "M16步槍是美軍步兵的標準配備，火力強大。\n"
      "它的射程遠且故障率低，在步槍中是數一數二的。\n"
    );
  }
  set("wield_msg", "$N將$n舉起，握在手中。\n");
  set("unwield_msg", "$N將手中的$n放下。\n");
  setup();
  init_gun(20);
}
int query_autoload() { return 1; }
