// M16.c

#include <weapon.h>

inherit GUN;

void create()
{
	set_name("M16˙簀", ({ "M16 rifle", "M16", "rifle", "m16" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long",
"M16˙簀琌瓁˙夹非皌称眏\n"
"ウ甮祘环珿毁瞯˙簀い琌计计\n"
);
	}
	set("wield_msg", "$N盢$n羭癬搐もい\n");
	set("unwield_msg", "$N盢もい$n\n");
	setup();
	init_gun(20);
}
int query_autoload() { return 1; }