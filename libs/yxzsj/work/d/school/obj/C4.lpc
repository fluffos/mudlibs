// C4.c

#include <weapon.h>

inherit EXPLOSIVE;

void create() {
  set_name("C4高爆炸藥", ({ "C4 high explosive charge", "C4", "c4", "charge", "HE" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "些");
    set("base_unit", "捆");
    set("base_weight", 5000);
    set("base_value", 2000);
    set("value", 2000);
    set("long",
      "C4炸藥是一種體積小的高爆炸藥，威力強大\n"
      "特種部隊常用它來執行精準的破壞任務。\n"
    );
  }
  set("wield_msg", "$N將$n舉起，握在手中。\n");
  set("unwield_msg", "$N將手中的$n放下。\n");
  set("verbs", ({ "collapse" }));
  set_amount(6);
  setup();
  init_explosive(20);
}
