// tstpaper.c

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
	set_name(HIR + HBWHT"σ"NOR, ({ "test paper", "test", "paper", }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","硂琌舼代喷厩ネ厩策祘σぃ甧\n");
		set("unit", "舼");
		set("base_unit", "眎");
		set("base_weight", 10);
		set("base_value", 10);
		set("value", 200);
	}
	set_amount(50);
	init_throwing(500);
	setup();
}
