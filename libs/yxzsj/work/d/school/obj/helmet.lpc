//helmet.c 

#include <armor.h> 

inherit HEAD; 

void create() 
{ 
	set_name("鋼盔", ({ "helmet","hel" }) ); 
	set_weight(1000); 
	set("long", "這是一頂學生站崗或校慶時所帶的鋼盔，看起來不重。\n"); 
	set("value",200);
	set("unit", "頂"); 
	set("material", "steel"); 
	set("armor_prop/head", 10);
	set("armor_type","head");
	setup(); 
}
 