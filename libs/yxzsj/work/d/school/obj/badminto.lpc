// badminto.c

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("羽毛球", ({ "badminton", "ball" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一顆體育課時所用的羽毛球。\n");
    set("unit", "些");
    set("base_unit", "顆");
    set("base_weight", 500);
    set("base_value", 10);
  }
  set_amount(1);
  init_throwing(2);
  setup();
}
