// nuke.c

#include <weapon.h>
#include <ansi.h>

inherit MISSILE;


void create() {
  set_name(HIR "核子飛彈" NOR, ({ "nuclear missile", "nuclear", "missile", "nuke" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "由於互相保證摧毀及擔心國際輿論，核子武器在戰場上的應用
已逐漸稀少。但它仍是世界上最有威力的武器。
這枚飛彈攜帶著十萬噸級的" HIR "核子彈頭" NOR "，可對任何目標造成完全的破壞。
要直接引爆彈頭，可輸入(explode)。
");
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 100000);
    set("base_value", 1000000);
    set("value", 1000000);
  }
  set_amount(1);
  init_missile(1000000);
  setup();
}

void init() {
  add_action("do_explode", "explode");
}

int do_explode() {

  int i, damage;
  object *ob;

  message_vision(
    HIR "$N引爆了一枚核彈﹐大喝一聲: " NOR, this_player());
  message_vision(
    HIY "核  融  爆!!\n" NOR, this_player());
  message_vision(
    RED "                -----------                           :  \n" NOR, this_player());
  message_vision(
    RED "          --------        -------                     :  \n" NOR, this_player());
  message_vision(
    RED "        ---                 --------                  : \n" NOR, this_player());
  message_vision(
    HIY "          ---            ------             ～ ～～ ～～ ～   \n" NOR, this_player());
  message_vision(
    HIY "            ------------------- \n" NOR, this_player());
  message_vision(
    RED "                                      ～～ ～                      : \n" NOR, this_player());
  message_vision(
    RED "                  :                                                : \n" NOR, this_player());
  message_vision(
    RED "                  :                               ---------------  : \n" NOR, this_player());
  message_vision(
    HIR "                  :                          -------          ------- \n" NOR, this_player());
  message_vision(
    HIY "                   ～ ～～ ～～ ～        ---                 ---------- \n" NOR, this_player());
  message_vision(
    HIR "         :                             --------                 -- \n" NOR, this_player());
  message_vision(
    RED "         :                                 ---               ---------  \n" NOR, this_player());
  message_vision(
    HIR "         :                                   ------------------- \n" NOR, this_player());
  message_vision(
    RED "        -----------   \n" NOR, this_player());
  message_vision(
    HIR "   --------        -------    \n" NOR, this_player());
  message_vision(
    RED "---                 --------        :             \n" NOR, this_player());
  message_vision(
    HIY "  ---              ------           : ～ ～～ ～～ ～  \n" NOR, this_player());
  message_vision(
    RED "    -------------------             :       \n" NOR, this_player());
  message_vision(
    HIR "                                    : \n" NOR, this_player());


  damage = (((int)this_player()->query("throwing") * 10) + 100000);
  ob = all_inventory(environment(this_player()));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i])) continue;
    damage = (damage - ((int)ob[i]->query("dodge") * 10));
    if (damage > 0) {
      ob[i]->receive_damage("kee", damage);
      ob[i]->receive_wound("kee", damage / 2);
      tell_object(ob[i], "你眼前忽然出現了一道白光,並燒掉了所有的事物!!\n");
    }

    if (userp(ob[i])) ob[i]->fight_ob(this_player());
    else if (!ob[i]->is_killing(this_player())) ob[i]->kill_ob(this_player());
  }
  add_amount(-1);
  return 1;
}
