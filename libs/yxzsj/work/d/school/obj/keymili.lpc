// keymili.c

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name("瓁瘪芲巴", ({ "weapons room key", "weapons", "room", "key" }) );
	set("weight", 200);
	set("long", "硂琌唉瓁瘪芲巴ノㄓ秨玛\n");
	set("value", 100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "唉");
	}
	set("place", "/d/school/miliroom");
	setup();
}