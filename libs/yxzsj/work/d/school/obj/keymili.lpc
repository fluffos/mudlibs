// keymili.c

#include <ansi.h>

inherit ITEM;

void create() {
  set_name("軍械室鑰匙", ({ "weapons room key", "weapons", "room", "key" }));
  set("weight", 200);
  set("long", "這是一隻軍械室的鑰匙，可以用來開鎖。\n");
  set("value", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "隻");
  }
  set("place", "/d/school/miliroom");
  setup();
}
