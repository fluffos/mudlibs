// chkshirt.c

inherit EQUIP;

void create() {
  set_name("襯衫", ({ "T-shirt", "t-shirt", "shirt" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件看來普通的襯衫，你覺得好像是有學問的人穿的。\n");
    set("unit", "件");
    set("value", 5000);
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 7);
    set("armor_prop/literate", 20);
  }
}
