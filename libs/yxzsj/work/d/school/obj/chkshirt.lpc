// chkshirt.c

inherit EQUIP;

void create()
{
	set_name("浓璵", ({ "T-shirt", "t-shirt", "shirt" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ンㄓ炊硄浓璵谋眔钩琌Τ厩拜\n");
		set("unit", "ン");
		set("value", 5000);
		set("material", "cloth");
		set("armor_type", "cloth");
		set("armor_prop/armor", 7);
		set("armor_prop/literate", 20);
	}
}