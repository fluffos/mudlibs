// sportunf.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("砰▅狝", ({ "sport uniform","uniform","sport","uni" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン砰▅揭┮︾狝フ︹T-shirt厚︹壳
癬ㄓ琌蔼厩\n");
		set("unit", "ン");
		set("value", 200);
		set("material", "cloth");
		set("armor_prop/dodge", 4);
		set("armor_prop/armor", 2);
	}
	setup();
}
