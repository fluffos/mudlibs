// blkcoat.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(WHT "黑色外套" NOR, ({ "black jacket", "black", "jacket" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件黑色的外套，質感不錯，你似乎覺得它有一股的靈氣。\n");
    set("unit", "件");
    set("value", 5000);
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 15);
    set("armor_prop/spells", 10);
  }
}
