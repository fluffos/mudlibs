// suniform.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("筿狝", ({ "electronic uniform","uniform","uni" }) );
	set_weight(2500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン筿狝μ︹浓璵μ︹壳\n");
		set("unit", "ン");
		set("value", 200);
		set("material", "cloth");
		set("armor_prop/armor", 3);
	}
	setup();
}
int query_autoload() { return 1; }