// navyunif.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("瓁狝", ({ "navy uniform","uniform","uni" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン脚︹瓁狝籋临赂帝宾\n");
		set("unit", "ン");
		set("value", 300);
		set("material", "cloth");
		set("armor_prop/armor", 6);
	}
	setup();
}