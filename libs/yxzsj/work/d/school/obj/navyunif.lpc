// navyunif.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("海軍制服", ({ "navy uniform", "uniform", "uni" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一件褐色的海軍制服，肩膀上還繡著一個梅花。\n");
    set("unit", "件");
    set("value", 300);
    set("material", "cloth");
    set("armor_prop/armor", 6);
  }
  setup();
}
