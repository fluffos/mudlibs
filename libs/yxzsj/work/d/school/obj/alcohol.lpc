// alcohol.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("皊弘", ({ "pure alcohol", "alcohol" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "瞺龟喷柑ノ皊弘甧秖琌500ml\n");
		set("unit", "瞺");
		set("value", 500);
		set("max_liquid", 7);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
		"name": "皊弘",
		"remaining": 7,
		"drunk_apply": 200,
	]) );
}
