// alcohol.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("純酒精", ({ "pure alcohol", "alcohol" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一瓶實驗室裡用的純酒精，容量是500ml。\n");
    set("unit", "瓶");
    set("value", 500);
    set("max_liquid", 7);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "alcohol",
    "name": "酒精",
    "remaining": 7,
    "drunk_apply": 200,
  ]));
}
