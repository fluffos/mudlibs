// lunchbox.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("獽讽", ({ "lunch box","lunch","box" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "逗舶そ┮暗獽讽癬ㄓ痷琌獽﹜\n");
		set("unit", "");
		set("value", 50);
		set("food_remaining", 10);
		set("food_supply", 100);
	}
}
