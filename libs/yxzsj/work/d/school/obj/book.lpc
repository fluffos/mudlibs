// book.c

inherit ITEM;

void create() {
  set_name("課本", ({ "textbook", "book" }));
  set_weight(600);
  set("unit", "本");
  set("long",
    "這是一本普通的課本，教導基本的知識。\n");
  set("value", 200);
  set("skill", ([
    "name": "literate",  // name of the skill
    "exp_required": 0,   // minimum combat experience required
    // to learn this skill.
    "sen_cost": 15,   // sen cost every time study this
    "difficulty": 15,   // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 20   // the maximum level you can learn
    // from this object.
  ]));
}
