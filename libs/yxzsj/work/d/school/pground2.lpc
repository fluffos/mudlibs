// Room: /d/school/pground2.c

inherit ROOM;

void create() {
  set("short", "操場");
  set("long", @LONG
這裡是逸俠中學的操場，地面完全用PU舖設，整齊順眼。操場上有一圈
200公尺的跑道，及一些籃球架和排球架。在圍牆邊有種樹，還有一些雙槓。
你看到操場的跑道，似乎也情不自禁的想去跑幾圈(run)。這裡的南邊便是
電子科大樓，東邊則是往教學大樓。
LONG
  );
  set("outdoors", "1");
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "pground3",
    "west": __DIR__ "pground1",
    "north": __DIR__ "pground5",
    "south": __DIR__ "sbuild",
  ]));
  set("no_clean_up", 0);
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/estudent": 1,
  ]));

  setup();
}

void init() {
  add_action("do_run", "run");
}

int do_run() {
  object me;
  me = this_player();
  if (me->query("kee") < 11)
    return notify_fail("你的體力不支了。\n");
  me->improve_skill("move", 10);
  me->receive_damage("kee", 10);
  message_vision("$N踏上跑道，開始繞著操場慢跑。\n", me);
  return 1;
}
