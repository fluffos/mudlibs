// Room: /d/school/office3.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "辦公室");
  set("long", @LONG
這是一間什麼也沒有的空房間。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "office4",
    "out": __DIR__ "teach2",
    "north": __DIR__ "office2",
  ]));
  set("no_clean_up", 0);
  set("objects", ([ /* sizeof() == 3 */
    __DIR__ "npc/techwu": 1,
    __DIR__ "obj/lunchbox": 1,
  ]));
  setup();
}
void init() {
  add_action("do_input", "input");
}

void open_passage() {
  object room;

  set("exits/west", "/d/school/secret");
  message_vision("電腦鎖解除了鎖定,開啟了一個暗門。\n", this_player());
  call_out("close_passage", 10);

}

void close_passage() {
  object room;
  message_vision("電腦鎖上的燈號轉為" HIR "紅色" NOR ",暗門又關上了。\n", this_player());
  delete("exits/west");
}


int do_input(string arg) {
  object ob, me;
  me = this_player();
  if (me->is_busy())
    return notify_fail("你現在沒空﹗\n");
  if (!arg) return notify_fail("你要用什麼東西讓電腦鎖檢查？\n");
  ob = present(arg, environment(me));
  if (!ob) ob = present(arg, me);
  if (!ob) return notify_fail("這個地方和你的身上並沒有這項物品。\n");
  if (ob->query("place") == "office3") {
    message_vision("$N將" + ob->query("name") + "刷過電腦鎖。\n", me);
    message_vision("電腦鎖忽然嗶的一聲,上面的燈號轉為" HIG "綠色" NOR "。\n", me);
    open_passage();
    return 1;
  } else {
    message_vision("$N試著放入" + ob->query("name") + "讓電腦鎖檢查，但是沒有任何反應。\n", me);
    return 1;
  }

}


void reset() {
  ::reset();
}
