// storboss.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("福利社老闆", ({ "store boss", "store", "boss" }));
  set("long",
    "他是福利社裡的老闆，正在為買東西的學生收錢。\n"
    "因為每天都要看到十卡車的學生，所以平常很少看到他說話。\n"
    "除了下課時間以外，平常他也要負責補貨等的工作。\n");
  set("age", 35);
  set("combat_exp", 50000);
  set_skill("unarmed", 40);
  set_skill("parry", 40);
  set_skill("dodge", 30);
  setup();
  carry_object("/d/school/obj/cloth")->wear();
  add_money("gold", 1);
}
