// armyinst.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("教官", ({ "navy instructor", "navy", "instructor", "ins", "inst" }));
  set("title", HIB "海軍" NOR);
  set("nickname", HIY "少校" NOR);
  set("gender", "男性");
  set("age", 40);
  set("class", "soldier");
  set("force", 750);
  set("max_force", 750);
  set("force_factor", 40);
  set("attitude", "heroism");
  set("chat_chance", 5);
  set("long",
    "他是逸俠中學的海軍教官，正站在門口看著進來的學生。\n"
    "和其他的教官一樣，他的臉上也有一股嚴肅的神情。\n");

  set("chat_msg", ({
    "海軍教官說：那位同學，停下來把衣服穿好。\n",
    "海軍教官說：那位同學，你怎麼不繫皮帶呢？\n",
    "海軍教官說：這位同學，有甚麼事嗎？\n",
    "海軍教官說：你好！\n",
    "你向教官說：教官好！\n",
  }));

  set("combat_exp", 50000);

  set_skill("unarmed", 30);
  set_skill("parry", 40);
  set_skill("dodge", 30);
  set_skill("force", 40);

  set("inquiry", ([
    "服儀檢查": "下禮拜一是服儀檢查，記得剪頭髮。",
    "逸俠中學": "這是天神郭逸俠所創辦的中學，希望你能好好念書。",
  ]));

  setup();
  carry_object("/d/school/obj/navyunif")->wear();
  add_money("thousand-cash", 1);

}
