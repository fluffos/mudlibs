// techchk.c

#include <ansi.h>
#include <login.h>

inherit NPC;

string *title_ranking = ({
  HIG "國一學生", NOR
  HIM "國二學生", NOR
  HIB "國三學生", NOR
  HIG "高一學生", NOR
  HIM "高二學生", NOR
  HIB "高三學生", NOR
  HIC "畢業生", NOR
  HIY "實習" HIG "老師", NOR
  HIG "老師", NOR
  HIC "資深" HIG "老師", NOR
  HIM "出納組" HIY "組長", NOR
  HIB "設備組" HIY "組長", NOR
  HIC "衛生組" HIY "組長", NOR
  HIG "訓導" HIY "主任", NOR
  HIR "教務" HIY "主任", NOR
  HIG "校友會" HIC "會長", NOR
  HIR "家長會" HIC "會長", NOR
  HIG "董事", NOR
  HIY "副校長", NOR
  HIR "董" HIG "事" HIM "會" HIC "會長" NOR
});

void create() {
  set_name(HIY "監考老師" NOR, ({ "test teacher", "test", "teacher", "tech" }));
  set("title", HIC "逸俠中學" NOR);
  set("chat_chance", 10);
  set("chat_msg", ({
    "監考老師正在四處走動。\n",
    "監考老師走到教室後面，看有沒有同學作弊。\n",
    "監考老師坐在椅子上，目光如電的掃射。\n",
    "監考老師拿起了一本書看了起來。\n",
    "監考老師看了一個同學一眼。\n",
  }));
  set("long",
    "他是這間考場的監考老師，負責監督同學的考試。\n"
    "在監督考場秩序的同時，你也可以找他評定你的學習成績。\n"
    "要請他考核自己的程度，請打(testme)。\n"
  );
  //	set_temp("apply/damage", 50);
  //	set_temp("apply/armor", 10);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 75);
  set("age", 40);
  set("combat_exp", 1000000);
  setup();
  carry_object("/d/school/obj/chkshirt")->wear();
  carry_object("/d/school/obj/tstpaper")->wield();
  add_money("thousand-cash", 5);
}

void init() {
  add_action("do_testme", "testme");
}

string rank_level(int value) {
  int grade;
  grade = value * 19 / 150;
  if (grade >= sizeof(title_ranking))
    grade = sizeof(title_ranking) - 1;
  return title_ranking[grade] + NOR;
}

int do_testme() {
  object ob;
  mapping skl;
  int lv;
  string name;
  ob = this_player();
  name = (string)ob->query("name");
  if (ob->query("family/family_name") != "逸俠中學") {
    command("emote 對" + name + "說道：同學，這裡是逸俠中學，你走錯教室嘍！");
    return 1;
  }
  skl = ob->query_skills();
  lv = skl["literate"];
  ob->set("title", HIC + "逸俠中學-" + NOR + rank_level(lv));
  command("say " + HIG + "你要參加考試？好的。");
  command("emote 發給" + name + "一張考卷。");
  command("emote 讓" + name + "寫完考卷。");
  command("emote 將考卷收了回去。");
  command("emote 將考卷改完。");
  command("hmm");
  command("say " + HIG + "好了，我知道你的程度了！");
  command("say " + HIG + name + "，我升你的職位為" + rank_level(lv) + "。");
  command("say " + HIG + name + "，要好好努力ㄚ！");
  command("smile " + ob->query("id"));
  return 1;
}
