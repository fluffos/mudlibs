// armyinst.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("守衛", ({ "guard" }));
  set("title", HIC "逸俠中學" NOR);
  set("gender", "男性");
  set("age", 55);
  set("max_force", 100);
  set("force", 100);
  set("force_factor", 10);
  set("long",
    "他是逸俠中學的守衛，負責學校的安全。\n"
    "他看起來年紀不小，所以才來做這無聊的工作。\n"
    "不過雖然如此，他還是盡心盡力，努力的做好自己份內的工作。\n");

  set("combat_exp", 100000);

  set_skill("unarmed", 40);
  set_skill("parry", 50);
  set_skill("dodge", 40);
  set_skill("force", 50);

  set("inquiry", ([
    "寄信": (: call_out("mail", 0) :),
  ]));

  setup();
  carry_object("/d/school/obj/cloth")->wear();

}

int mail() {
  object mailbox;
  if (mailbox = this_player()->query_temp("mbox_ob")) {
    command("say 你的信箱還在吧﹖用信箱就可以寄信了。");
    return 1;
  }
  command("say 哦... 要寄信是嗎﹖這是你的信箱﹐寄信的方法信箱上有說明");
  mailbox = new("/obj/mailbox.lpc");
  mailbox->move(this_player());
  return 1;
}
