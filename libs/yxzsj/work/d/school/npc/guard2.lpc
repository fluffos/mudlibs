// armyinst.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create()
{
	set_name("矫", ({ "guard"}) );
	set("title", HIC"秇獿い厩"NOR);
	set("gender", "╧┦" );
	set("age", 55);
	set("max_force", 100);
	set("force", 100);
	set("force_factor", 10);
	set("long",
		"琌秇獿い厩矫璽砫厩\n"
		"癬ㄓぃ┮ㄓ暗硂礚册\n"
		"ぃ筁瘤礛临琌荷み荷暗︑ず\n");

	set("combat_exp", 100000);

	set_skill("unarmed", 40);
	set_skill("parry", 50);
	set_skill("dodge", 40);
	set_skill("force", 50);

	set("inquiry", ([
		"盚獺" : (: call_out("mail", 0) :),
	]) );

	setup();
	carry_object("/d/school/obj/cloth")->wear();
	
}

int mail()
{
	object mailbox;
	if( mailbox = this_player()->query_temp("mbox_ob") ) {
		command("say 獺絚临ノ獺絚碞盚獺");
		return 1; }
	command("say 瓳... 璶盚獺琌盾硂琌獺絚盚獺よ猭獺絚Τ弧");
	mailbox = new("/obj/mailbox.lpc");
	mailbox->move(this_player());
	return 1;
}