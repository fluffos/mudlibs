#include <ansi.h>

inherit NPC; 

void create()
{

           set_name("胺毙ρ畍", ({ "health teacher", "health","teacher","tech" }) );
           set("age", 40);
           set("long",@STORY
琌厩柑胺毙ρ畍キ盽常玂胺柑
眖玡瞷ぷㄤ琌êΩ厩ㄆ常厩ネ
旧笲笆璶狦Τ端硂柑ㄓ琵
腊蚕滦砰ゴhealme
STORY
              );
           set("chat_chance", 10);
           exert_function(10);
	   set("chat_msg", ({
	    "胺毙ρ畍端厩蚕端\n",
	    "胺毙ρ畍弧厩﹚璶猔種笲笆摆\n",
            "胺毙ρ畍厩端媚\n",
	    }));

        set("gender","┦");
      	set("combat_exp",5000);
        set("score",99999);
	set_skill("dodge", 30);
	set_skill("unarmed", 30);
	set("inquiry", ([
		"ㄆ": "
êΩΤ瓣厩–ぱ筁逗碞ゴ瞴
挡狦Τぱいとゴ瞴ゴ獽フ猨
癳玂胺竒利ふ临ゼ洛皘碞
胺毙ρ畍瞏瞏鼓°°°"
,
		"厩ㄆ": 
"êΩΤ瓣厩–ぱ筁逗碞ゴ瞴
挡狦Τぱいとゴ瞴ゴ獽フ猨
癳玂胺竒利ふ临ゼ洛皘碞
胺毙ρ畍瞏瞏鼓°°°",
		"框ē": 
"钮弧弧程杠琌...
デ砏....",
	]) );

	setup();
}

void init()
{
	add_action("do_heal_me", "healme");
}

int do_heal_me(object ob, string arg)
{
           ob = this_player();     
	if( ob->is_busy() )
		return notify_fail("( 笆临⊿ΤЧΘ)\n");
           ob->set("eff_kee",(ob->query("max_kee")+ob->query("eff_kee"))/2 );
	   ob->set("kee",ob->query("eff_kee") );
	   message_vision(HIY"胺毙ρ畍腊$N端揽媚蚕矪瞶\n"NOR, ob);
	   write(HIC+"竒筁胺毙ρ畍臔瞶稰谋端\n"NOR);
	   ob->start_busy(10);
	   return 1;    
	     	
}





