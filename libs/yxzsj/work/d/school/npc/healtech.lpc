//healtech.c

#include <ansi.h>

inherit NPC;

void create() {

  set_name("健教老師", ({ "health teacher", "health", "teacher", "tech" }));
  set("age", 40);
  set("long", @STORY
她是學校裡的健教老師，平常大都待在保健室裡。
從以前到現在，尤其是那次同學出事後，她都一直在向學生
宣導運動安全的重要。如果你有受傷，你可以到這裡來讓她
幫你包紮，並回覆體力，打healme即可。
STORY
  );
  set("chat_chance", 10);
  exert_function(10);
  set("chat_msg", ({
    "健教老師在為一個受傷的同學包紮傷口。\n",
    "健教老師說：同學們，一定要注意運動安全啊！\n",
    "健教老師在為一個同學的傷口上藥。\n",
  }));

  set("gender", "女性");
  set("combat_exp", 5000);
  set("score", 99999);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  set("inquiry", ([
    "出事": "
那次有一個國三的同學，每天吃過飯就去打球
結果有一天中午，他打球打到一半便倒了下去，口吐白沫。
送到保健室時已經瞳孔放大，還未到醫院就去世了。
健教老師深深的嘆了口氣～～～"
    ,
    "同學出事":
    "那次有一個國三的同學，每天吃過飯就去打球
結果有一天中午，他打球打到一半便倒了下去，口吐白沫。
送到保健室時已經瞳孔放大，還未到醫院就去世了。
健教老師深深的嘆了口氣～～～",
    "遺言":
    "聽說他說的最後一句話是...
犯規....",
  ]));

  setup();
}

void init() {
  add_action("do_heal_me", "healme");
}

int do_heal_me(object ob, string arg) {
  ob = this_player();
  if (ob->is_busy())
    return notify_fail("( 你上一個動作還沒有完成。)\n");
  ob->set("eff_kee", (ob->query("max_kee") + ob->query("eff_kee")) / 2);
  ob->set("kee", ob->query("eff_kee"));
  message_vision(HIY "健教老師幫$N在傷口上擦藥，並且包紮處理好。\n" NOR, ob);
  write(HIC + "經過健教老師的護理，你感覺傷口好了很多！\n" NOR);
  ob->start_busy(10);
  return 1;

}
