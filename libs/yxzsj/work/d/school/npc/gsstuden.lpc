// sstudent.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("女學生", ({ "senior girl student", "girl", "senior", "student", "stu" }));
  set("title", "高中部");
  set("chat_chance", 7);
  set("chat_msg", ({
    "女學生說：不知這次月考考的怎麼樣。\n",
    "女學生問：今天有甚麼作業？\n",
    "女學生問：下節課上甚麼？\n",
    "女學生問：這題好難，應該怎麼解？\n",
    "女學生說：呼！終於把作業做完了。\n",

  }));
  set("long",
    "她是一個逸俠中學高中部的女學生。\n");
  set_temp("apply/damage", 12);
  set_temp("apply/armor", 2);
  set("gender", "女性");
  set("age", 17);
  set("combat_exp", 400);
  setup();
  carry_object("/d/school/obj/suniform")->wear();
  carry_object("/d/school/obj/schobelt")->wear();
  carry_object("/d/school/obj/schoshoe")->wear();
  add_money("coin", 200);
}
