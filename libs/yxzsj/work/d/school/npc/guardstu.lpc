// guardstu.c

#include <ansi.h>
#include <login.h>

inherit NPC;
	
void create()
{
	set_name("盺厩ネ", ({ "guard student", "guard", "student", "stu","gua" }) );
        set("chat_chance", 15);
	set("chat_msg", ({
	    "盺厩ネ弧穛搂\n",
	    "盺厩ネ秈ρ畍穛搂\n",
            "盺厩ネ弧ρ畍\n",
            "盺厩ネ弧搂拨\n",
	}));
	set("attitude", "heroism");
	set("long",
		"琌︑腀盺蔼い厩ネ\n"
		"计厩ネ常跌兜篴\n");
	set_temp("apply/damage", 20);
	set_temp("apply/armor", 3);       
	set("age",17);
      	set("combat_exp",1000);
	setup();
	carry_object("/d/school/obj/suniform")->wear();
	carry_object("/d/school/obj/helmet")->wear();
	carry_object("/d/school/obj/schobelt")->wear();
	carry_object("/d/school/obj/schoshoe")->wear();
        add_money("coin",100);
}


