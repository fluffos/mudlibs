// armyinst.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("教官", ({ "army instructor", "army", "instructor", "ins", "inst" }));
  set("title", HIG "陸軍" NOR);
  set("nickname", HIY "中校" NOR);
  set("gender", "男性");
  set("class", "soldier");
  set("age", 40);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 50);
  set("chat_chance", 5);
  set("attitude", "heroism");
  set("long",
    "他是逸俠中學的陸軍教官，正站在門口看著進來的學生。\n"
    "和其他的教官一樣，他的臉上也有一股嚴肅的神情。\n");

  set("chat_msg", ({
    "陸軍教官說：那位同學，停下來把衣服穿好。\n",
    "陸軍教官說：那位同學，你怎麼不繫皮帶呢？\n",
    "陸軍教官說：這位同學，有甚麼事嗎？\n",
    "陸軍教官說：你好！\n",
    "你向教官說：教官好！\n",
  }));

  set("combat_exp", 100000);

  set_skill("unarmed", 40);
  set_skill("parry", 50);
  set_skill("dodge", 40);
  set_skill("force", 50);

  set("inquiry", ([
    "服儀檢查": "下禮拜一是服儀檢查，記得剪頭髮。",
    "逸俠中學": "這是天神郭逸俠所創辦的中學，希望你能好好念書。",
  ]));

  setup();
  carry_object("/d/school/obj/armyunif")->wear();
  add_money("thousand-cash", 2);

}
