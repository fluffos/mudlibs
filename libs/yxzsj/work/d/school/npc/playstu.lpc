// playstu.c

#include <ansi.h>
#include <login.h>

inherit NPC;
	
void create()
{
	set_name("ゴ瞴厩ネ", ({ "playing student", "playing","student","stu" }) );
        set("chat_chance", 10);
	set("chat_msg", ({
	    "厩ネ弧╭瞴╭瞴\n",
            "厩ネ弧е瑍瞴ゴ初\n",
	    "厩ネ盢瞴肚倒钉ね\n",
            "厩ネ笲帝瞴皗筁ň\n",
            "厩ネ眖钉ねもい钡筁瞴非絋膞щ\n",
            "詜厩ネщ膞眔だ\n",
            "厩ネデ砏\n",

	}));
	set("long",
		"琌タ巨初ゴ膞瞴厩ネㄓм砃ぃ岿\n");
	set_temp("apply/damage", 20);
	set_temp("apply/armor", 2);       
	set("age",17);
      	set("combat_exp",300);
	setup();
	carry_object("/d/school/obj/sportunf")->wear();
	carry_object("/d/school/obj/schoshoe")->wear();
        add_money("coin",250);
}


