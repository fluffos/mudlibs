// playstu.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("在打球的學生", ({ "playing student", "playing", "student", "stu" }));
  set("chat_chance", 10);
  set("chat_msg", ({
    "學生說：秀球，秀球！。\n",
    "學生說：快洗球，再打一場。\n",
    "學生將球傳給隊友。\n",
    "學生運著球，努力閃過在防守的人。\n",
    "學生從隊友的手中接過球，準確的向籃框投去。\n",
    "唰！學生投籃得分！\n",
    "學生叫：犯規！\n",

  }));
  set("long",
    "他是一個正在操場上打籃球的學生，看來技術不錯。\n");
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 2);
  set("age", 17);
  set("combat_exp", 300);
  setup();
  carry_object("/d/school/obj/sportunf")->wear();
  carry_object("/d/school/obj/schoshoe")->wear();
  add_money("coin", 250);
}
