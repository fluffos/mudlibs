// techkuo.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create() {
  set_name("何景國", ({ "Teacher Kuo", "Teacher", "teacher", "Kuo", "tech", "kuo" }));
  set("nickname", HIY "禪" NOR);
  set("gender", "男性");
  set("age", 55);
  set("title", HIC "逸俠中學-" HIM "數學" HIG "老師" NOR);
  set("attitude", "peaceful");
  set("long",
    "他是逸俠中學的資深數學老師，看起來一副仙風道骨的樣子。\n"
    "他是臺大數學系畢業的，曾用Derive數學軟體做研究。\n"
    "他平日常在鑽研禪學及佛經，對人生有很大的體悟。\n"
    "他對超自然現象也有興趣，有時講課到一半會講起飛碟來。\n"
    "你一看到他，就覺得他好像一個道士一般。\n");

  set("combat_exp", 400000);
  set("score", 1000000);

  set("class", "taoist");

  set("str", 25);
  set("int", 50);
  set("cor", 25);
  set("cps", 30);
  set("spi", 50);

  set("chat_chance", 5);
  set("chat_msg", ({
    "何景國說：有甚麼事嗎？\n",
    "何景國發出一陣像OM的聲音，好像正在冥思。\n",
    (: command, "study book" :),
  }));

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 100);

  set("atman", 2000);
  set("max_atman", 2000);

  set("mana", 2000);
  set("max_mana", 2000);
  set("mana_factor", 300);

  set("inquiry", ([
    "人生的目的": "何景國微笑著，說道：人生的目的，就待你自己去發現了。",
    "郭逸俠": "他能夠多方面學習，努力向學，將來前途不可限量。",
  ]));

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "netherbolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "invocation" :),
    (: cast_spell, "astral vision" :),
  }));

  create_family("逸俠中學", 2, "數學老師");

  set_skill("literate", 80);
  set_skill("magic", 100);
  set_skill("force", 100);
  set_skill("spells", 100);
  set_skill("scratching", 80);
  set_skill("chanting", 110);
  set_skill("unarmed", 80);
  set_skill("parry", 60);
  set_skill("dodge", 70);
  set_skill("move", 90);

  set_skill("gouyee", 100);
  set_skill("lotusforce", 120);
  set_skill("buddhism", 150);
  set_skill("essencemagic", 120);
  set_skill("taoism", 150);
  set_skill("necromancy", 120);

  map_skill("force", "gouyee");
  map_skill("spells", "necromancy");
  map_skill("magic", "essencemagic");

  setup();

  carry_object("/d/school/obj/blkcoat")->wear();
  carry_object("/d/school/obj/budbook");

  add_money("thousand-cash", 5);
}

void attempt_apprentice(object ob) {
  command("say 嗯... 想學習禪理﹖也好....");
  command("recruit " + ob->query("id"));
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "student");
}
int accept_fight(object me) {
  if ((string)me->query("class") == "student") {
    command("hmm");
    command("smile");
    command("say 像你這樣的學生，應該先把課業弄好，不是想找人比較武藝。\n");
  }

  else
    command("say 對不起，我對武藝沒興趣，抱歉不能陪你切磋。\n");

  return 0;
}
