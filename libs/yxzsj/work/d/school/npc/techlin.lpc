// techlin.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create()
{
	set_name("狶緼藉", ({ "Teacher Lin", "Teacher", "teacher", "Lin", "tech", "lin"}));
	set("nickname", HIY"罥"NOR);
	set("gender", "╧┦");
	set("age", 40);
	set("title", HIC"秇獿い厩-"HIM"计厩"HIG"ρ畍"NOR);
	set("long",
		"琌秇獿い厩戈瞏计厩ρ畍癬ㄓ捌笵癌妓\n"
		"琌籓计厩╰拨穨纯ノDerive计厩硁砰暗╯\n"
		"キら盽苝罥厩の︱竒癸ネΤ砰\n"
		"癸禬︑礛瞷禜Τ砍届Τ量揭穦量癬盒ㄓ\n"
		"碞谋眔钩笵\n");

	set("combat_exp", 500000);
	set("score", 500000);

	set("class", "sage");

	set("str", 40);
	set("int", 50);
	set("cor", 30);

        set("chat_chance", 5);
	set("chat_msg", ({
		"︙春瓣弧Τ或ㄆ盾\n",
		"︙春瓣祇皚钩OM羘钩タ\n",
		(: command, "study book" :),
	}));

	set("force", 5000);
	set("max_force", 5000);
	set("force_factor", 300);

	set("inquiry", ([
		"ネヘ": "︙春瓣稬帝弧笵ネヘ碞︑祇瞷",
		"尝秇獿" : "镑よ厩策厩盢ㄓ玡硚ぃ秖",
	]) );

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: cast_spell, "drainerbolt" :),
		(: cast_spell, "netherbolt" :),
		(: cast_spell, "feeblebolt" :),
		(: cast_spell, "invocation" :),
		(: cast_spell, "astral vision" :),
	}) );

	create_family("秇獿い厩", 3, "计厩ρ畍");

	set_skill("literate", 80);
	set_skill("magic", 100);
	set_skill("force", 100);
	set_skill("spells", 100);
	set_skill("scratching", 80);
	set_skill("chanting", 110);
	set_skill("unarmed", 80);
	set_skill("parry", 60);
	set_skill("dodge", 70);
	set_skill("move", 90);

	set_skill("gouyee", 100);
	set_skill("lotusforce", 120);
	set_skill("buddhism", 150);
	set_skill("essencemagic", 120);
	set_skill("taoism", 150);
	set_skill("necromancy", 120);

	map_skill("force", "gouyee");
	map_skill("spells", "necromancy");
	map_skill("magic", "essencemagic");

	setup();

	carry_object("/d/school/obj/blkcoat")->wear();
	carry_object("/d/school/obj/budbook");

      add_money("thousand-cash",5);
}

void attempt_apprentice(object ob)
{
	command("say 垛... 稱厩策罥瞶....");
	command("recruit " + ob->query("id") );
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "student");
}
int accept_fight(object me)
{
	if( (string)me->query("class")=="student" )
{		command("hmm");
		command("smile");
		command("say 钩硂妓厩ネ莱赣р揭穨ぃ琌稱тゑ耕猌美\n");}

	else
		command("say 癸ぃ癬и癸猌美⊿砍届╆簆ぃ抄ち絉\n");
	
	return 0;
}

