// operator.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create() {
  set_name("操作人員", ({ "operator" }));
  set("title", HIC "科學家" NOR);
  set("gender", "男性");
  set("age", 40);
  set("long",
    "他是科學研究機構在逸俠中學的技術人員。\n"
    "他負責操作這裡複雜的傳送站，以便利學校使用。\n"
    "身為一名科學家，他也有著謹慎小心的態度，隨時確保裝置的正常運作。\n");

  set("chat_chance", 5);
  set("chat_msg", ({
    "操作人員正在裝置的電腦主機上輸入資料。\n",
    "操作人員正在聚精會神的調整儀器的一些開關。\n",
    "操作人員拿起一隻筆和紙，開始逐一查對儀器上的數值。\n",
    "操作人員說道：有物質要傳送嗎？\n",
  }));

  set("inquiry", ([
    "start": (: call_out("do_start", 0) :),
  ]));

  setup();
  carry_object("/d/school/obj/scisuit")->wear();

}

int accept_object(object me, object obj) {
  if (!(me->query_temp("trans_pos"))) {
    command("say 請先選擇地點。");
    return 0;
  }
  if (obj->value() != 1000) {
    command("say 服務費的金額是1000元。");
    return 0;
  }
  if (!(this_player()->query_temp("hanger"))) {
    command("say 請先在傳送艙確認。");
    return 0;
  }
  me->set_temp("trans_pay", 1);
  command("say 你可以啟動傳送服務了。");
  return 1;
}

int do_start() {
  object transroom;
  if (!(this_player()->query_temp("trans_pos"))) {
    command("say 請先選擇地點。");
    return 0;
  }
  if (!(this_player()->query_temp("trans_pay"))) {
    command("say 請先付服務費。");
    return 0;
  }
  if (!(this_player()->query_temp("hanger"))) {
    command("say 請先在傳送艙確認。");
    return 0;
  }
  if (!(environment(this_player())->query_door("hanger", "status"))) {
    command("say 請關上傳送艙門。");
    return 0;
  }
  transroom = this_player()->query_temp("hanger");
  transroom->do_prepare(transroom);
  tell_room(environment(this_object()), "操作人員在儀器上按下了幾個按鈕，在電腦螢幕上輸入了一些資料。\n");
  tell_room(transroom, "你覺得事情好像不太對勁，周圍的傳送系統好像已經開始充能。\n");
  command("say 傳送裝置已經啟動，將於三十秒後傳送。");
  call_out("do_move", 30);
  return 1;
}

int do_move() {
  object transroom;
  transroom = this_player()->query_temp("hanger");
  transroom->do_move(transroom);
  tell_room(transroom, HIY "天啊！只見四周出現了一道道閃光，接著一陣巨響，你就失去知覺了。\n" NOR);
  tell_room(transroom, HIC "你揉揉眼醒了過來，還是覺得頭昏腦脹，奇怪，這裡是什麼地方？\n" NOR);
  tell_room(environment(this_object()), HIY "只聽到一聲巨響，傳送艙發出了一陣閃光後，一切歸於平靜。\n" NOR);
  all_inventory(this_player()->query_temp("hanger"))->move(this_player()->query_temp("trans_pos"));
  command("say 傳送已完成。");
  this_player()->delete_temp("hanger");
  this_player()->delete_temp("trans_pos");
  this_player()->delete_temp("trans_pay");
  return 1;
}
