// techwu.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create() {
  set_name("吳明德", ({ "Teacher Wu", "Teacher", "teacher", "tech", "minnder", "Wu", "wu" }));
  set("nickname", HIC + "minnder" + NOR);
  set("title", HIC "逸俠中學-" HIG "物理老師" NOR);
  set("gender", "男性");
  set("age", 35);
  set("attitude", "friendly");
  set("class", "teacher");

  set("force", 600);
  set("max_force", 600);
  set("force_factor", 30);

  set("rank_info/respect", "設備組長");

  set("long",
    "他是逸俠中學的物理老師及設備組長，長的又高又胖。\n"
    "他看起來一副呆呆的模樣，喜歡吃東西，常常在吃便當。\n"
    "他懂得很多物理及軍事的知識，也喜歡做模型。\n"
    "平常老師要用投影機或借視聽教室，都是找他。\n");

  create_family("逸俠中學", 3, "物理老師");

  set("combat_exp", 50000);
  set("score", 150000);
  set("chat_chance", 5);
  set("chat_msg", ({
    (: command, "eat lunch box" :),
    "吳明德說：同學，有甚麼事嗎？\n",
    "吳明德說：你好！\n",
    "你說：老師好！\n",
  }));

  set_skill("unarmed", 30);
  set_skill("parry", 40);
  set_skill("dodge", 60);
  set_skill("force", 30);
  set_skill("literate", 60);
  set_skill("throwing", 50);
  set_skill("stick", 70);
  set_skill("move", 50);

  set_skill("Aegis", 120);

  map_skill("parry", "Aegis");
  map_skill("dodge", "Aegis");
  map_skill("force", "Aegis");

  set("inquiry", ([
    "郭逸俠": "他常常來找我談天及討論，是一個努力好學的學生。",
    "妖ㄑ": "嗯,他有時會來找我問一些問題，蠻有創造力的。",
    "視聽教室": (: call_out("studio_room", 0) :),
    "投影機": "真不巧，投影機已經被其他班借走了，你下一節課再來看看。",
    "遙控船": "我也有一艘遙控帆船，蠻好玩的。",
  ]));

  setup();
  carry_object("/d/school/obj/sticks")->wield();
  carry_object("/d/school/obj/blushirt")->wear();
  carry_object("/d/school/obj/lunchbox");
  carry_object("/d/school/obj/lunchbox");

  add_money("thousand-cash", 3);
}

void attempt_apprentice(object ob) {
  command("say 你要向我學習?");
  command("smile");
  command("say 好啊﹐" + RANK_D->query_respect(ob) + "有問題儘管來找我。\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "student");
}

int studio_room() {
  object ob;
  if (this_player()->query_temp("got_studio_key") == 1) {
    command("?");
    command("say 我不是已經給你鑰匙了嗎？");
    return 1;
  }
  ob = new("/d/school/obj/keystdio");
  command("say 視聽教室現在已經整修好了，");
  command("say 新裝了虛擬實境的設備，有空可以去看看。");
  ob->move(this_object());
  this_player()->set_temp("got_studio_key", 1);
  command("give " + this_player()->query("id") + " key");
  command("smile");
}
