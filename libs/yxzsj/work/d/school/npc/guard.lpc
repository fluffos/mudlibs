// armyinst.c

#include <ansi.h>
#include <login.h>

inherit NPC;

void create()
{
	set_name("矫", ({ "guard"}) );
	set("title", HIC"秇獿い厩"NOR);
	set("gender", "╧┦" );
	set("age", 55);
	set("max_force", 100);
	set("force", 100);
	set("force_factor", 10);
	set("long",
		"琌秇獿い厩矫璽砫厩\n"
		"癬ㄓぃ┮ㄓ暗硂礚册\n"
		"ぃ筁瘤礛临琌荷み荷,暗︑ず\n");

	set("combat_exp", 100000);

	set_skill("unarmed", 40);
	set_skill("parry", 50);
	set_skill("dodge", 40);
	set_skill("force", 50);

	set("inquiry", ([
		"盚" : (: call_out("say_words", 0) :),
	]) );

	setup();
	carry_object("/d/school/obj/cloth")->wear();
	
}

int say_words()
{
	message_vision("\n", this_player());
	command("say 璶盚狥﹁琌璶煤恨瞶禣100じ");
	command("say 硂ㄇ琌盚");
	message_vision("\n", this_player());
	command("say list   琩硂柑珇");
	command("say saveeq <珇> 盢ō珇硂柑");
	command("say geteq  <珇> 盢硂柑珇矗");
	command("say geteq all  盢硂柑┮Τ珇矗\n");
	return 1;
}
