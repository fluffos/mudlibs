// jstudent.c

#include <ansi.h>
#include <login.h>

inherit NPC;
	
void create()
{
	set_name("厩ネ", ({ "junior student", "junior","student","stu" }) );
	set("title", "瓣い场");
        set("chat_chance", 7);
	set("chat_msg", ({
	    "厩ネ弧ぃ硂Ωるσσ或妓\n",
            "厩ネ拜さぱΤ或穨\n",
	    "厩ネ拜竊揭或\n",
            "厩ネ拜硂肈螟莱赣或秆\n",
            "厩ネ弧㊣沧р穨暗Ч\n",

	}));
	set("long",
		"琌秇獿い厩瓣い场厩ネ\n");
	set_temp("apply/damage", 10);
	set_temp("apply/armor", 1);       
	set("age",14);
      	set("combat_exp",200);
	setup();
	carry_object("/d/school/obj/juniform")->wear();
	carry_object("/d/school/obj/schobelt")->wear();
	carry_object("/d/school/obj/schoshoe")->wear();
        add_money("coin",100);
}


