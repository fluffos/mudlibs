// TASM.c

#include <login.h>

inherit NPC;

void create() {
  set_name(
    "戰斧反艦飛彈",
    ({ "Tomahawk Anti-Ship Missile", "TASM", "tomahawk", "missile", "SSM", "anti-ship" })
  );
  set("chat_chance", 50);
  set("chat_msg", ({
    (: random_move :),
    "戰斧反艦飛彈正在「咻」的掠著海面飛行。\n",
  }));
  set("long",
    "戰斧反艦飛彈是美國目前射程最遠的反艦飛彈，\n"
    "它是戰斧飛彈的反艦型，射程極遠且威力強大，\n"
    "是神盾級船艦不可或缺的武器。\n");
  set_temp("apply/damage", 1000);
  set_temp("apply/armor", 50);
  set("attitude", "killer");
  set_skill("throwing", 100);
  set_skill("dodge", 30);
  set("age", 3);
  set("combat_exp", 300);
  setup();
  carry_object("/d/school/obj/whead200")->wield();
}

void fire(object who) {
  int i;
  object *enemy;

  message("vision",
    "轟咻的一聲，" + name(who) + "發射了一枚戰斧巡弋飛彈！"
    , environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
}
