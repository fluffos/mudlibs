// Room: /d/school/trash.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "︰В初");
	set("long", @LONG
硂柑琌秇獿い厩︰В初–ぱいと㎝厩厩ネ常穦р︰В
硂柑ㄓメǐ硂柑ぃ谋眔Τぐ或厩腨璶―厩ネ璶р︰
В砋砋竕メ秈︰В初︰В初纠Τㄇ(words)
硂柑р︰В砋メ(throw)秈︰В初
LONG
	);
	set("outdoors", "1");
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"sidedoor",
  "north" : __DIR__"smground",
]));
	set("item_desc", ([ 
"words": "
	"HIG"<-"HIR"縐"NOR""HIC"ぃ縐"HIG"->"NOR"

"	]));
	setup();
}

void init()
{
	add_action("do_throw", "throw");
}

int do_throw(string arg)
{
	object ob, me;
	me = this_player();
	if( me->is_busy())
		return notify_fail("瞷⊿\n");
        if(!arg) return notify_fail("璶璶盢ぐ或狥﹁メ秈︰В初\n");
        ob=present(arg,environment(me));
        if(!ob) ob=present(arg,me);
        if(!ob) return notify_fail("硂よ㎝ō⊿Τ硂兜珇\n");
	if( ob->query("trashbag") ) {
		write("︰В砋璶杆︰В盿璶蚕候メ秈︰В初\n");
		return 1;
	}
	if( ob->query("packed_trash") ) {
		message_vision("$N计顶顶辫も羥揣ハ盢"+ob->query("name")+"メ秈︰В初柑\n", me);
		destruct(ob);
		return 1;
	}
	if( ob->query("trashbag") ) {
		write("︰В砋璶杆︰В盿璶蚕候メ秈︰В初\n");
		return 1;
	}
	else {
		return notify_fail("硂狥﹁ぃメ秈︰В初\n");
	}

}