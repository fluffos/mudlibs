// Room: /d/school/road3.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小路");
  set("long", @LONG
你正走在一條教學大樓南邊的小路上，路邊種了一些樹木，這條小路是
由紅色人行磚舖成的，走在這裡可以隱約看到教學大樓走廊上的事物。北邊
的鐵欄杆是為了防止物品掉下及為地下的教室採光用的。往東走去是風雨操
場，往西走去是操場，你還可以看到南邊有一條健康步道，上面有一些標語
(sign)，你可以試著去走走看(walk)。
LONG
  );
  set("item_desc", ([ /* sizeof() == 2 */
    "sign": " 
" HIR "	為了你的健康，
	請脫鞋。" NOR "
"
  ]));

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/clearstu": 1,
  ]));
  set("outdoors", "1");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "pground3",
    "east": __DIR__ "road4",
  ]));

  setup();
}

void init() {
  add_action("do_walk", "walk");
}

int do_walk() {
  object me;
  me = this_player();
  if (me->query_temp("armor/boots"))
    return notify_fail("為了你的健康，請脫鞋。\n");
  if (me->query("kee") < 11)
    return notify_fail("你感到腳底刺痛，實在是走不下去了。\n");
  me->improve_skill("dodge", 10);
  me->receive_damage("kee", 10);
  message_vision("$N脫了鞋，在佈滿鵝軟石的健康步道上走起路來。\n", me);
  return 1;
}
