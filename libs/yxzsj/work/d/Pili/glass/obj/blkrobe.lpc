// blkrobe.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
	set_name(WHT"ト︾"NOR, ({ "black robe", "black", "robe" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌ン临痷ト︾瞏↖碞┦\n");
		set("unit", "ン");
		set("value", 10000);
		set("material", "cloth");
		set("armor_type", "cloth");
		set("armor_prop/armor", 30);
		set("armor_prop/force", 20);
		set("armor_prop/spells", 20);
		set("armor_prop/magic", 20);
	}
}