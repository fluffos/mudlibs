// Room: /d/pili/glass/bridge.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "爵");
	set("long", @LONG
硂柑琌畒硈钡痆件挂爵ǐ帝┏瑈茧茧
Τ礷眖硂瑄方繷澈礛Τ畒竓捣聄ガ
≧τㄏぃ窽苂鼓︑礛碍钮瑈羘み薄硋
亥癬ㄓ眖硂い临Τㄇ辰ㄠ(fish)眣笴︑村帝
┪砛ノも篘(touch)
LONG
	);
	set("outdoors", "1");
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"glass",
  "west" : __DIR__"entrance",
]));
	set("no_clean_up", 0);
	set("fall", 1);

	setup();
}

void init()
{
	add_action("do_touch", "touch");
	call_out("bgtext", 5);
}

int do_touch(string arg)
{
	if ( arg != "fish" )
		return notify_fail("璶篘ぐ或\n");
	write( HIC"\n环矪肚ㄓ皚羘弧"+RANK_D->query_respect(this_player())+HIC+"叫︘も\n\n"NOR);
	return 1;
}

void bgtext()
{
	if ( environment(this_player())->query("fall") == 1 ) {
		tell_room(environment(this_player()), HIC"聄ガ睩睩瑈钮癬ㄓ痷琌笆钮\n"NOR);
		call_out("bgtext", 10); }
}