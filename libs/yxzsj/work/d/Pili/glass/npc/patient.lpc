// patient.c

inherit NPC;

#include <ansi.h>

void create()
{
	set_name("痜", ({ "patient"}));
	set("gender", "╧┦");
	set("age", 20);
	set("long", "琌ㄓ―洛痜眞ō骸琌端勃\n"
			"┋笿尿絫眔玂︘兵┦㏑\n"
	);

	set("combat_exp", 1000);
	set("score", 1000);
	set("eff_kee", 170);
	set("kee", 170);

      set("chat_chance", 5);
	set("chat_msg", ({
		(: command("emote г帝痥礹") :),
		(: command("emote 端翴﹀") :),
		(: unconcious() :),

	}));

	setup();

	carry_object("/obj/cloth")->wear();

	add_money("silver", 1);
}