// oneline.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create()
{
	set_name("絬ネ", ({ "oneline man", "oneline", "man", "one", "line"}));
	set("nickname", HIG"留"HIY"磷"HIR"剐"NOR);
	set("title", HIC"痆件挂"NOR);
	set("gender", "╧┦");
	set("age", 50);
	set("attitude", "peaceful");
	set("long",
		"獽琌猌狶嘿睲フ浆临痷醇紌蔼瞏τ碔璸垦\n"
		"琌い猌狶烩旧タ笵瓷假硂计ㄓ﹍沧\n"
		"钮弧烦獽笵佩笆猌狶耴留ㄢκ確\n"
		"ㄤ龟Τ暗ㄆ盽︑痲帝稱\n"
		"暗ㄆ眖ぃ籔祑窱祑羆琌蔼禬璸垦秆∕ㄆ薄\n"
		"猌狶いΤ肚ē弧璝ね常琌砆┮碾ぃ┦┏︙\n"
	);

	set("combat_exp", 20000);
	set("score", 100);
	set("rank_info/respect", "笵ね");

      set("chat_chance", 5);
	set("chat_msg", ({
		"临痷弧叫拜тΤ或ㄆ盾\n",
		"临痷井ミぃ笆タσ帝ㄆ薄\n",
	}));

	set("force", 500);
	set("max_force", 500);
	set("force_factor", 20);

	set("inquiry", ([
		"腊Γ": "┤礚猭",
		"舧尺︱": (: command("emote 瞏瞏鼓"), command("say 鸡舧尺︱鸡°°°") :),
		"猍隔": (: command("emote 瞏瞏鼓"),
		command("say 璣动ソ独甀癌"),
		command("say 霉呼爱艶娥府活"),
		command("say 猍隔琘癸ぃ癬摆°°°") :),
		"尿絫": "尿絫ㄠ稱㎝矪摆",
		"絬ネ": "琌иねи暗砛\ㄆ到诀闽ォ璸",
		"ホ福": "ウ獽痆件挂瑌マ柑",
		"筧": "稱讽筧玭材...琘莲ろび",
	]) );

	set("chat_chance_combat", 20);
	set("chat_msg_combat", ({
		(: command("help!") :),
	}) );

	set_skill("force", 50);
	set_skill("unarmed", 50);
	set_skill("parry", 50);
	set_skill("dodge", 50);
	set_skill("move", 50);

	setup();

	carry_object("/d/pili/glass/obj/blkrobe")->wear();
	carry_object("/d/pili/glass/obj/lotushat")->wear();
	carry_object("/d/pili/glass/obj/whisk")->wear();
	carry_object("/d/pili/glass/obj/purplesw");
	carry_object("/d/pili/glass/obj/bulletsb");

	add_money("gold", 1);
}

int accept_fight(object me)
{
	command("say 玼玼玼碞那и硂рρ癌繷");
	return 0;
}
