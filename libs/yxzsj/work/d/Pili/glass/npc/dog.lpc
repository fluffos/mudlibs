// dog.c

inherit NPC;

void create()
{
	set_name("", ({ "dog" }) );
	set("race", "偿脋");
	set("age", 5);
	set("long", 
		"硂唉琌瘆盵笆笰缠柑唉臔矫ぇ琌╡磝舦璶竟\n"
		"╡︑砆瘆盵蚌緄癸瘆盵┚璼ぃ\n"
	);
	set("attitude", "aggressive");	
	set("max_kee", 500);

	set("limbs", ({ "繷场", "ō砰", "玡竲", "竲", "Юぺ" }) );
	set("verbs", ({ "bite", "claw" }) );

	set("combat_exp", 100000);

	set_temp("apply/attack", 10000);
	set_temp("apply/armor", 5000);

	setup();
}