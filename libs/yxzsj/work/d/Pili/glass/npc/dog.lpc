// dog.c

inherit NPC;

void create() {
  set_name("大狗", ({ "dog" }));
  set("race", "野獸");
  set("age", 5);
  set("long",
    "這隻大狗是拿破崙在動物農莊裡的九隻護衛之一，是牠掌權的重要利器。\n"
    "牠自小被拿破崙培養長大，對拿破崙忠貞不二。\n"
  );
  set("attitude", "aggressive");
  set("max_kee", 500);

  set("limbs", ({ "頭部", "身體", "前腳", "後腳", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("combat_exp", 100000);

  set_temp("apply/attack", 10000);
  set_temp("apply/armor", 5000);

  setup();
}
