// healersu.c

inherit NPC;

#include <ansi.h>

void create()
{
	set_name("尿絫", ({ "Healer su", "Healer", "healer", "healer su", "su", "Su"}));
	set("nickname", HIG"痷"HIC""NOR);
	set("title", HIC"痆件挂"NOR);
	set("gender", "╧┦");
	set("age", 20);
	set("attitude", "peaceful");
	set("long", "獽琌临痷㎝筧ㄠ癬ㄓ睲ヘ╭\n"
			"羪Τ聋屡痌临Τ钩簒歹\n"
			"ネ獽砆癳防挂琵稯寸畍蛾谋ㄓ毙旧\n"
			"稯寸矗Ν琵尿絫埃臸ㄏノ较祅癌猭硉Θ\n"
			"ㄓ炳窾臸ぱΜ臸τ臸跑ぱ材\n"
			"砆纒ソ炳τ秈府てぃ眒冻ぱ瞷\n"
			"毕临痷秈笷腀ホ跑笵毙耴じ竧担ㄓ砆睦\n"
			"钡帝秏秨砞洛繻腶除蕾毕礚计笿砛\ㄆ\n"
			"程跑セㄓ华㎝临痷筁帝е贾ネ\n"
			"畍琌蛾谋\n"
	);

	set("combat_exp", 500000);
	set("score", 500000);
	set("rank_info/respect", "ぱ材");
	set("class", "sage");
	set("max_kee", 5000);

	set("str", 40);
	set("int", 70);
	set("cor", 30);
	set("cps", 70);
	set("spi", 70);
	set("con", 70);
	set("kar", 40);
	set("per", 50);

        set("chat_chance", 3);
	set("chat_msg", ({
		"尿絫弧叫拜琌ㄓ禘盾\n",
		"尿絫タΓ帝腊痜媚\n",
		"尿絫腊痜糶禘耞\n",
		"尿絫秨眎媚よ倒痜\n",
	}));

	set("force", 2000);
	set("max_force", 2000);
	set("force_factor", 100);

	set("atman", 2000);
	set("max_atman", 2000);

	set("mana", 2000);
	set("max_mana", 2000);
	set("mana_factor", 200);

	set("inquiry", ([
		"临痷": "克㎝矪痷...",
		"絬ネ": "琌и狟ね到诀闽ォ璸",
		"筧": "ダ克蠢и传﹀τㄠ痷癸ぃ癬...",
	]) );

	set("chat_chance_combat", 30);
	set("chat_msg_combat", ({
		(: command("exert bullets") :),
		(: command("exert astral_vision") :),
		(: command("exert recover") :),
	}) );

	create_family("痆件挂", 2, "痷");

	set_skill("literate", 200);
	set_skill("magic", 150);
	set_skill("force", 150);
	set_skill("spells", 150);
	set_skill("unarmed", 150);
	set_skill("parry", 100);
	set_skill("dodge", 100);
	set_skill("move", 100);
	set_skill("cure", 250);

	set_skill("su-sk", 150);
	set_skill("buddhism", 100);
	set_skill("taoism", 100);

	map_skill("force", "su-sk");
	map_skill("spells", "su-sk");
	map_skill("magic", "su-sk");
	map_skill("unarmed", "su-sk");
	map_skill("dodge", "su-sk");
	map_skill("parry", "su-sk");

	setup();

	carry_object("/d/pili/glass/obj/blksuit")->wear();
	carry_object("/d/pili/glass/obj/bluehat")->wear();
	carry_object("/d/pili/glass/obj/healb");

	add_money("gold", 10);
}

void can_speak_poetry()
{
	delete("speaking_poetry");
}

void speak_poetry()
{
	if ( !query("speaking_poetry") ) {
		message_vision("\n",this_object());
		command("say 睝流耏絵ぱ碒");
		command("say ヴ睴簐睭茎");
		command("say ︙幢︑洛瓣も");
		command("say 媚よ砪う");
		set("speaking_poetry", 1);
		call_out("can_speak_poetry", 5); }
}

void init()
{
	::init();
	call_out("speak_poetry", 0);
}

void attempt_apprentice(object ob)
{
	command("say 癸ぃ癬и程Γ帝洛獀痜龟┾ぃ丁");
}

int accept_fight(object me)
{
	command("say 腶除蕾ぃ猌\");
	return 0;
}

void die()
{
	string str;
	object killer, su, place;
	place = find_object("/d/pili/glass/glass");
	su = present("Master su", place);
	killer = this_object()->query_temp("last_damage_from");
	str =
"               ﹖满ぱ睵蛮克︙┮ㄌゼ耴盻臮み瞃癵\n"
"               酬ㄠきせ羘瞈\簑瑄︙矪よぃ砎\n"
"               κ竮耞辨窾螟菌菌担肅痁痁フ緑︾\n";
	str = "\n\n"HIR"               临痷礹笵\n\n" HIY + str + "\n\n"NOR;
	shout ( str );
	if (!(killer && su)) tell_room(environment(this_object()), str);
	if ( killer && su ) {
	str = 
HIC"    Τ繷杜Τ尿絫碞琵荷程み\n"
HIG"    临痷礛癬ōㄓ"+killer->query("name")+"玡\n"NOR;
	str = str + "\n\n";
	shout ( str );
	//tell_room(environment(this_object()), str);
	su->move(environment(killer));
	su->kill_ob(killer);
	su->force("exert bullets"); }
	::die();
}