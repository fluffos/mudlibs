#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIC "琉璃仙境" NOR);
  set("long", @LONG
這裡便是琉璃仙境的中心，也是平日素還真所在的地方。從此地向外看
，只見所有琉璃仙境的風光一覽無遺，美不勝收。而在此地，可以看到一個
仙風道骨，眉目清俊，紅顏白髮的超世高人立於此地。襯托上美好的風景，
更能突顯出他的輕逸自在，你不禁從心裡生起了一股景仰之情。
LONG
  );
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/mastersu": 1,
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "road",
    "west": __DIR__ "bridge",
  ]));
  set("valid_startroom", 1);
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
