// lightswo.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
	set_name(HIY"瑈棵糃"NOR, ({ "light sword", "sword", "light" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", 
"硂琌р╣糃猫腑肠ノ筁糃琌眖エ━陆ㄓ癳倒腑肠\n"
"ウ琌さ贺竟ぇ\n"
"〃︽本ら糃ǐ瑈棵〃獽琌甧ウ程ㄎ糶酚\n"
		);
		set("value", 10000);
		set("material", "steel");
		set("weapon_prop/sword", 40);
	}
	init_sword(100);

	set("wield_msg", "$N詜羘眖糃甅い┾р$n搐もい\n");
	set("unwield_msg", "$N盢もい$n础璉糃甅\n");

	setup();
}
int query_autoload() { return 1; }