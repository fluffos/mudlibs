// entrance.c

#include <login.h>
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "畍穦");
	set("long",
		"硂柑琌畍㎝產册ぱよ狦Τぐ或種ǎ璶琵畍笵硂柑\n"
	"痙ē琌程е硚畖ぃ筁狦琌癸笴栏い拜肈叫眤絋﹚и矗ㄑ弧\n"
	"ゅン柑⊿Τ弧矗好拜畍璶戮砫ぃ琌毙產︙\n"
	"    荡诀竟眤硂柑浪羭(accuse)琘產赣產穦砆ъ\n"
	"暗ㄇ代喷ヘ玡硂兜\﹟ゼ暗ヴ︙叫づノㄓ奶耑\n");
	set("exits", ([
		"west" : __DIR__"hall1",
		"down":"/d/school/gate",
		"north": __DIR__"sysboard",
        ]) );
	set("no_fight", 1);
	set("no_magic", 1);

	setup();
	call_other( "/obj/board/query_b", "???" );
}

int valid_leave(object me, string dir)
{
	if( dir=="west" && !wizardp(me) )
	return notify_fail("ê柑Τ畍秈\n");
	return ::valid_leave(me, dir);
}

void init()
{
	add_action("do_accuse", "accuse");
}

int do_accuse(string arg)
{
	object ob;
	string s;

	if( (int)this_player()->query("age") < 15 )
		return notify_fail("び⊿Τ浪羭舦\n");

	if( !arg ) return notify_fail("璶浪羭街\n");
	if( ob = find_player(arg) ) {
		if( ob==this_player() )
			return notify_fail("璶浪羭︑\n");
		if( ob->is_ghost() )
			return notify_fail( ob->name(1) + "竒皑\n");
		if( wizardp(ob) )
			return notify_fail("ぃ浪羭畍\n");
		tell_object(ob, HIW + this_player()->name(1) + "浪羭琌诀竟叫钡代喷\n" NOR);
		ROBOT_CHECK->test_me(ob);
		write("Ok. 竒盢浪羭癸禜癳暗代喷\n");
		write("磷Τノ诀竟睹浪羭奶耑叫钡代喷\n");
		ROBOT_CHECK->test_me(this_player());
		log_file("robot_accuse",
			sprintf("%s accused %s on %s.\n", this_player()->query("id"), ob->query("id"), ctime(time())));
		return 1;
	}
	return notify_fail("ヘ玡絬⊿Τ硂︗產\n");
}

