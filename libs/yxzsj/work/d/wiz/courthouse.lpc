// Room: /d/wiz/courthouse.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "猭皘");
	set("long", @LONG
硂柑琌狥よ珿ㄆ畍糵拜诀竟猭皘﹚琌砆浪羭┪琌
︽び钩诀竟穦ㄓ硂柑狦氮ぃ糵﹛拜肈穦
砆暗癘腹禬筁Ω盢穦砆矪伐氮
LONG
	);
	set("no_fight", 1);
	set("no_magic", 1);
	set("no_spells", 1);
	set("objects", ([
		__DIR__"npc/judge":1 ]) );

	setup();
}

void test_me(object me)
{
	me->set_temp("old_startroom", me->query("startroom"));
	me->set("startroom", __FILE__);
	me->set_temp("last_location", base_name(environment(me)));
	message_vision("┛礛皚皗竛︘$N\n", me);
	me->move(this_object());
}
