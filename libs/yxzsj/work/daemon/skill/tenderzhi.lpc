// tenderzhi.c

inherit SKILL;

mapping *action = ({
	([	"action":		"$Nオも揣┷碘加蹦るも翴$n$l",
		"dodge":		-30,
		"parry":		30,
		"force":		80,
		"damage_type":	"端",
		"weapon":		"も",
	]),
	([	"action":		"$Nㄏ┷撤爵纟宾ō紇┛玡┛礛锣ōオも┕$n$l翴",
		"dodge":		-30,
		"parry":		30,
		"force":		90,
		"damage_type":	"端",
		"weapon":		"オもい",
	]),
	([	"action":		"$Nō猭祔箉オも喘ㄏ琱獸炉┕$n$l翴",
		"dodge":		-30,
		"parry":		30,
		"force":		140,
		"damage_type":	"端",
		"weapon":		"オもい",
	]),
	([	"action":		"ǎ$N胖竬耚\皛礛菲计へも抖帝ㄓ墩┷糥汲胶┕$n$l翴",
		"dodge":		-30,
		"parry":		30,
		"force":		90,
		"damage_type":	"端",
		"weapon":		"も",
	]),
});

int valid_learn(object me)
{
	if( (string)me->query("gender") != "┦" )
		return notify_fail("琗璱琌Τ絤猌\\n");
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("絤琗璱ゲ斗も\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("sen") < 30 )
		return notify_fail("﹑弘礚猭栋いヰ絤\n");
	if( (int)me->query("force") < 10 )
		return notify_fail("﹑ずぃ镑\n");

	me->receive_damage("sen", 30);
	me->add("force", -10);

	return 1;
}
