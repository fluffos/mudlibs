#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action": "$N手中$w劍影分散數道，『" NOR + HIB "悲" BLU "痛莫" HIB "名" NOR "』隨招而出向$n的$l劃出數道血痕。",
    "damage_type": "砍傷" ]),
  ([ "action": "$N手中$w化成劍影，『" NOR + HIY "劍" YEL "流" HIY "雲" NOR "』隨著內力化成各種武器，在$n的手臂上劃出一條長長的口子！",
    "damage_type": "砍傷" ]),
  ([ "action": "$N緊握住$w勁提氣，往上躍了數十丈，『" NOR + CYN "劍流星" NOR "』由天而降向$n猛刺了一劍！！\n結果在$n的$l砍出一個缽大的傷口。",
    "damage_type": "砍傷" ]),
  ([ "action": "$N將手中的$w以內力摧動，竟跟軟鞭無異『" NOR + HIR "劍" RED "流" HIR "痕" NOR "』隨即在$n的身上刺了數百個血窟窿！！",
    "damage_type": "砍傷" ]),
  ([ "action": "$N把$w倒轉，橫臥胸前『" NOR + WHT "莫" HIM "名奇" WHT "妙" NOR "』$N幻化成數十人，每個人影都在$n的$l疾刺數劍！！",
    "damage_type": "砍傷" ])

});
int valid_learn(object me) {
  object ob;
  if (me->query_skill("sword", 1) < 100)
    return notify_fail("你的基本劍術火侯不夠，無法學習驚雲劍法。\n");
  return 1;
}
int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 40)
    return notify_fail("你的體力不夠了﹐休息一下再練吧。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你的內力不夠了﹐休息一下再練吧。\n");
  me->receive_damage("kee", 40);
  me->add("force", -5); ;
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("beggar") + "/cloud-sword/" + action;
}
