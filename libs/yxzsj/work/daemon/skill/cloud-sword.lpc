#include <ansi.h>

inherit SKILL;

mapping *action = ({
        ([      "action":               "$Nもい$w糃紇だ床计笵"NOR+HIB"磀"BLU"礹馋"HIB""NOR"繦┷τ$n$l购计笵﹀勃",
			"damage_type":  "端" ]),
      ([      "action":               "$Nもい$wてΘ糃紇"NOR+HIY"糃"YEL"瑈"HIY"冻"NOR"繦帝ずてΘ贺猌竟$nも羥购兵",
			"damage_type":  "端"]),
        ([      "action":               "$N候搐︘$w玪矗┕臘计"NOR+CYN"糃瑈琍"NOR"パぱτ$n瞨糃\n挡狦$n$l糙端",
             "damage_type":  "端"]),
      ([      "action":               "$N盢もい$wず篟笆澈蛤硁聾礚钵"NOR+HIR"糃"RED"瑈"HIR"勃"NOR"繦$nō计κ﹀竇罧",
                "damage_type":  "端"]),
       ([      "action":               "$Nр$w锣绢玡"NOR+WHT"馋"HIM""WHT"М"NOR"$NほてΘ计–紇常$n$l痚计糃",
                "damage_type":  "端"])
  
});
int valid_learn(object me)
{
        object ob;
        if( me->query_skill("sword",1)<100 )
                return notify_fail("膀セ糃砃獼ぃ镑礚猭厩策佩冻糃猭\n");
              return 1;
}
int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}
 
int practice_skill(object me)
{
	if( (int)me->query("kee") < 40 )
		return notify_fail("砰ぃ镑ヰ絤\n");
	if( (int)me->query("force") < 5 )
		return notify_fail("ずぃ镑ヰ絤\n");
	me->receive_damage("kee", 40);
	me->add("force", -5); ;
	return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("beggar") + "/cloud-sword/" + action;
}