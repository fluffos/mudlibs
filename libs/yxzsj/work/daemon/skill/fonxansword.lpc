// fonxansword.c

inherit SKILL;

mapping *action = ({
	([	"action":		"$Nㄏ┷畃癹隔锣もい$w兵蝗矰$n$l",
		"dodge":		-20,
		"damage":		30,
		"damage_type":	"端"
	]),
	([	"action":		"$Nㄏ糃猭い尘粂糃繬繬辟$n$l",
		"dodge":		-20,
		"damage":		30,
		"damage_type":	"澄端"
	]),
	([	"action":		"$N┷眘τ︽ō皛礛菲计へもい$w辟$n$l",
		"dodge":		-30,
		"damage":		20,
		"damage_type":	"澄端"
	]),
	([	"action":		"$Nもい$wい甤秈ΑΠら狥狜癸非$n$l糃",
		"dodge":		-40,
		"damage_type":	"端"
	]),
	([	"action":		"$N羇ō臘もい$w┷耺癸非$n$l弊弊糃",
		"dodge":		-40,
		"damage_type":	"端"
	]),
	([	"action":		"$N$w咎┷担ま隔$n$l",
		"dodge":		20,
		"damage":		40,
		"damage_type":	"端"
	]),
	([	"action":		"$Nもい$wだㄏ┷琱穞はも癸非$n$l糃",
		"dodge":		-20,
		"damage":		20,
		"damage_type":	"端"
	]),
	([	"action":		"$N绢糃玡ō锣もい$wㄏ┷é璱礶笵┓辟$n$l",
		"dodge":		-30,
		"damage":		10,
		"damage_type":	"澄端"
	]),
});

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 50 )
		return notify_fail("ずぃ镑⊿Τ快猭絤糃猭\n");

	if( (string)me->query_skill_mapped("force")!= "fonxanforce")
		return notify_fail("糃猭ゲ斗皌ず\絤\n");

	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "sword" )
		return notify_fail("ゲ斗тр糃絤糃猭\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
		return notify_fail("ず┪ぃ镑⊿Τ快猭絤策糃猭\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	write("帝┮厩絤筂糃猭\n");
	return 1;
}

string perform_action_file(string action)
{
	return CLASS_D("swordsman") + "/fonxansword/" + action;
}
