// fonxansword.c

inherit FORCE;

mapping *action = ({


  ([ "action": "$N使出一招「石破天驚混元掌」朝著$n運氣擊出一掌",
    "dodge": -40,
    "damage_type": "震傷"
  ]),

  ([ "action": "$N使出一招「百川匯宗」對準$n的$l發出一道氣勁",
    "dodge": -40,
    "damage_type": "震傷"
  ]),



















});

int valid_learn(object me) {
  object ob;
  return 1;
}

int valid_enable(string usage) {
  return usage == "dodge" || usage == "force" || usage == "parry" || usage == "move" || usage == "unarmed";
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}


int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的內力或氣不夠﹐沒有辦法練習封山劍法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所學練了一遍飛天御劍流。\n");
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("swordsman") + "/fonxansword/" + action;
}

string exert_function_file(string func) {
  return CLASS_D("fighter") + "/fire-force/" + func;
}
