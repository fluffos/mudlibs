	([	"action":		"$Nㄏ┄锭糃猭い"HIM"κ紀砍"NOR"糃繬繬辟$n$l",
		"damage":		40,
		"damage_type":	"澄端"
	]),
	([	"action":		"$Nㄏ┄锭糃猭い"HIC"禜窾"NOR"もい$w糃跑ほ$n$l",
		"damage":		40,
		"damage_type":	"端"
	]),
