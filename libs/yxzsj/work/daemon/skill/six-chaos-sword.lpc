// six-chaos-sword.c

#include <ansi.h>

inherit SKILL;

mapping *action = ({
	([	"name":			"竤臸睹籖",
		"action":		"$Nㄏ┷竤臸睹籖もい$w╣艼獴$n$l硈ю计糃",
		"dodge":		50,
		"damage":		170,
		"damage_type":	"端"
	]),
	([	"name":			"糉碍鸟ō",
		"action":		"$Nō锣┷糉碍鸟ō$w辟$n$l",
		"dodge":		-50,
		"damage":		20,
		"damage_type":	"端"
	]),
	([	"name":			"κ碍︽",
		"action":		"$N籖笆$w┷κ碍︽帝皗皗糃$n$l",
		"dodge":		-40,
		"damage_type":	"端"
	]),
	([	"name":			"緅碍膁隔",
		"action":		"$Nもい$wлㄏ緅碍膁隔┕$n$l糃",
		"dodge":		-40,
		"damage":		40,
		"damage_type":	"端"
	]),
	([	"name":			"碍紇糽糽",
		"action":		"$Nもい$w糃忌┷碍紇糽糽┕$n$l",
		"dodge":		-60,
		"damage":		20,
		"damage_type":	"端"
	]),
	([	"name":			"糥碍佰",
		"action":		"$Nもい$w$n$l┷糥碍佰祇笹糃",
		"dodge":		-20,
		"damage":		50,
		"damage_type":	"端"
	]),
});

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 100 )
		return notify_fail("ずぃ镑⊿Τ快猭絤せ潮發活糃\n");

	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "sword" )
		return notify_fail("ゲ斗тр糃絤糃猭\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 5 )
		return notify_fail("ず┪ぃ镑⊿Τ快猭絤策せ潮發活糃\n");
	me->receive_damage("kee", 30);
	me->add("force", -5);
	write("帝┮厩絤筂せ潮發活糃猭\n");
	return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

void skill_improved(object me)
{
	if( (int)me->query_skill("six-chaos-sword", 1)	% 10 == 0 ) {
		tell_object(me,
			RED "\n礛谋眔碿侥み繷谋眔稱炳....\n\n" NOR);
		me->add("bellicosity", 1000);
	} else
		me->add("bellicosity", 100);
}
