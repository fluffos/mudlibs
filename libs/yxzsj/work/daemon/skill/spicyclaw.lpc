// spicyclaw.c

inherit SKILL;

mapping *action = ({
	([	"action":		"$Nオ磝稬だもㄏ┷瑀纒汲︵ъ$n$l",
		"dodge":		-30,
		"parry":		-70,
		"force":		160,
		"damage_type":	"ъ端"
	]),
	([	"action":		"$N翱锣ō蛮も陆跬羚も徼$n$l",
		"dodge":		-10,
		"parry":		-60,
		"force":		140,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nō稬弊繦阁˙オも┛磝┛ㄏ技ηも╃$n$l",
		"dodge":		-30,
		"parry":		-40,
		"force":		120,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nㄏ獵矰琿繟蛮も菲啡钵盽癸非$n$lъ",
		"dodge":		10,
		"parry":		-60,
		"force":		140,
		"damage_type":	"ъ端"
	]),
	([	"action":		"$Nオも店磝钠钠┷假阑$n$l",
		"dodge":		-20,
		"parry":		-50,
		"force":		150,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nㄏ挤碝糹臘癬ぃň辅玡癸非$n$l金竲",
		"dodge":		-70,
		"parry":		-40,
		"force":		180,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nも$n$l购筁繦┷繦匆ōオよ︗ъ",
		"parry":		-90,
		"force":		100,
		"damage_type":	"ъ端"
	]),
});

int valid_learn(object me)
{
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("絤猳瑈陈もゲ斗も\n");
	if( (int)me->query("max_force") < 80 )
		return notify_fail("ずび畓礚猭絤猳瑈陈も\n");
	return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 25 )
		return notify_fail("砰ぃ镑ヰ絤\n");
	if( (int)me->query("force") < 3 )
		return notify_fail("ずぃ镑ヰ絤\n");
	me->receive_damage("kee", 25);
	me->add("force", -3);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if( damage_bonus < 100 ) return 0;

	if( random(damage_bonus/2) > victim->query_str() ) {
		victim->receive_wound("kee", (damage_bonus - 100) / 2 );
		switch(random(3)) {
			case 0: return "钮池罢羘淮臫澈琌癌窰羘\n";
			case 1: return "$N玪$n$l祇池羘脄臫\n";
			case 2: return "钮ǎ$n$l池羘 ...\n";
		}
	}
}
