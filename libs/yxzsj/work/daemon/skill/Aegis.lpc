// Aegis.c
#include <ansi.h>
inherit SKILL;

string *parry_msg = ({
  "$p發射了數枚長程防空飛彈,在遠處就將$N的攻勢化為無形。\n",
  "$p發射了數枚中程防空飛彈,擊毀了$N的攻擊。\n",
  "$p發射了數枚點防禦飛彈,立刻將$N的攻擊炸的粉碎。\n",
  "$p使用了方陣近迫武器系統,數管火神機炮" + HIY "(巴爾幹炮)" + NOR "精準的擊潰了$N的攻勢。\n",
  "$p啟動了電子干擾系統,使$N的招式偏離了準頭。\n",
  "$p發射出數管干擾絲,籠罩了整個外型,使$N摸不清$p正確的位置。\n",

});

string *dodge_msg = ({
  "$p發射了數枚長程防空飛彈,在遠處就將$N的攻勢化為無形。\n",
  "$p發射了數枚中程防空飛彈,擊毀了$N的攻擊。\n",
  "$p發射了數枚點防禦飛彈,立刻將$N的攻擊炸的粉碎。\n",
  "$p使用了方陣近迫武器系統,數管火神機炮" + HIY "(巴爾幹炮)" + NOR "精準的擊潰了$N的攻勢。\n",
  "$p啟動了電子干擾系統,使$N的招式偏離了準頭。\n",
  "$p發射出數管干擾絲,籠罩了整個外型,使$N摸不清$p正確的位置。\n",

});


int valid_enable(string usage) {
  return usage == "dodge" || usage == "force" || usage == "parry" || usage == "move";
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];

}

string query_dodge_msg(object weapon) {
  return dodge_msg[random(sizeof(dodge_msg))];

}
string exert_function_file(string func) {
  return CLASS_D("fighter") + "/Aegis/" + func;
}
