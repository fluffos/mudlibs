	"$pㄏノよ皚猌竟╰参,计恨诀"+HIY"(ぺ焊稦)"+NOR"弘非阑检$Nю墩\n",
	"$p币笆筿耑╰参,ㄏ$N┷Α熬瞒非繷\n",
	"$p祇甮计恨耑捣,泞竛俱,ㄏ$N篘ぃ睲$pタ絋︗竚\n",

});

string *dodge_msg = ({
	"$p祇甮计猅祘ň紆,环矪碞盢$Nю墩て礚\n",
	"$p祇甮计猅い祘ň紆,阑反$Nю阑\n",
	"$p祇甮计猅翴ň縨紆,ミㄨ盢$Nю阑窰\n",
	"$pㄏノよ皚猌竟╰参,计恨诀"+HIY"(ぺ焊稦)"+NOR"弘非阑检$Nю墩\n",
	"$p币笆筿耑╰参,ㄏ$N┷Α熬瞒非繷\n",
