// celestrike.c

inherit SKILL;

mapping *action = ({
	([	"action":		"$Nㄏ┷ぱ霉Α磝阑$n$l",
		"dodge":		-30,
		"parry":		10,
		"force":		200,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nㄏ┷ぱ霉Αオ磝て店龟阑$n$l",
		"dodge":		-10,
		"parry":		-30,
		"force":		170,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nㄏぱǜ磝猭ぱ霉Α碍緔篡︓$nō玡磝╃$n$l",
		"dodge":		-30,
		"parry":		10,
		"force":		150,
		"damage_type":	"凤端"
	]),
	([	"action":		"$N蛮磝岿ㄏ撤锭硈る癸非$n$l硈尿╃磝",
		"dodge":		10,
		"parry":		-30,
		"force":		260,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nオ磝礶伴伴磝崩┷艶笆きよ躬阑$n$l",
		"dodge":		-20,
		"parry":		-30,
		"force":		240,
		"damage_type":	"凤端"
	]),
	([	"action":		"$Nㄏ筽琍耞ō床矪$n$l磝ю阑",
		"dodge":		-70,
		"parry":		-10,
		"force":		280,
		"damage_type":	"凤端"
	]),
	([	"action":		"$N喘羘┷举ぱ蛮磝ㄖ崩",
		"parry":		-40,
		"force":		320,
		"damage_type":	"凤端"
	]),
});

int valid_learn(object me)
{
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("絤ぱǜ磝ゲ斗も\n");
	if( (int)me->query_skill("celestial", 1) < 20 )
		return notify_fail("ぱǜ\ぃì礚猭絤ぱǜ磝猭\n");
	if( (int)me->query("max_force") < 100 )
		return notify_fail("ずび畓礚猭絤ぱǜ磝猭\n");
	return 1;
}

int valid_enable(string usage) { return usage=="unarmed"; }

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30 )
		return notify_fail("砰ぃ镑ヰ絤\n");
	if( (int)me->query("force") < 5 )
		return notify_fail("ずぃ镑ヰ絤\n");
	me->receive_damage("kee", 30);
	me->add("force", -5);
	return 1;
}
