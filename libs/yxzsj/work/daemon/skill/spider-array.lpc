// sword.c

#include <ansi.h>

inherit SKILL;

int valid_enable(string usage) { return usage=="array"; }

int form_array(object leader)
{
	object *member;

	member = leader->query_team();
	if( sizeof(member) != 8 )
		return notify_fail("艶碉糃皚惠ぶ常ぃ︽\n");
	message_vision( HIG "$N瞯烩渤﹚よ︗舱Θ艶碉糃皚\n" NOR, leader);
	return 1;
}
