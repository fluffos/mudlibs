// astral_vision.c

#include <ansi.h>

inherit SSERVER;

int exert(object me)
{
	int skill;

	if( me->query_temp("apply/astral_vision") )
		return notify_fail("竒琁甶筁"+HIC+"紌泊冻"+NOR+"\n");

	if( (int)me->query("force") < 30 )
		return notify_fail("ずぃ镑\n");

	skill = me->query_skill("force");

	me->add("force", - 30);
	me->receive_damage("sen", 5);

	message_vision(
		"$N稬井超泊氟笲癬み猭琁甶"HIC"紌泊冻"NOR"\n" NOR, me);

	me->add_temp("apply/astral_vision", 1);
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), skill);

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me)
{
	me->add_temp("apply/astral_vision", -1);
	tell_object(me, HIC+"紌泊冻"+NOR+"ア\n");
}
