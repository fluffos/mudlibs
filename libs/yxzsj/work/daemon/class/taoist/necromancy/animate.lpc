// animate.c

inherit F_CLEAN_UP;

int cast(object me, object target)
{
	if( me->is_fighting() )	return notify_fail("タ驹矮い\n");
	
	if( !target || !target->is_corpse() ) return notify_fail("璶臱笆ㄣ砰\n");
	
	if( (int)me->query("mana") < 50 ) return notify_fail("猭ぃ镑\n");

	message_vision(
		"$N癸帝$n充充├碭〨粂$n┾輟碭澈癬ㄓ\n", me, target);

	target->animate(me, (int)me->query_skill("spells") * 3 + 30);

	me->add("mana", -50);
	me->receive_damage("sen", 30);

	return 1;
}
