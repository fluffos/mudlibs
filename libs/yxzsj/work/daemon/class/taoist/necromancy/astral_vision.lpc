// astral_vision.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
	int skill;

	if( me->query_temp("apply/astral_vision") )
		return notify_fail("竒琁甶筁潮锭泊猭砃\n");

	if( (int)me->query("mana") < 30 )
		return notify_fail("猭ぃ镑\n");

	skill = me->query_skill("spells");

	me->add("mana", - 30);
	me->receive_damage("sen", 5);

	message_vision(
		HIB "$N稬井超帝泊氟├碭〨粂琁甶潮锭泊猭砃\n" NOR, me);

	me->add_temp("apply/astral_vision", 1);
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), skill);

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me)
{
	me->add_temp("apply/astral_vision", -1);
	tell_object(me, "潮锭泊猭砃ア\n");
}
