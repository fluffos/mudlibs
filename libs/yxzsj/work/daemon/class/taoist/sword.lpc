// sword.c

#include <ansi.h>

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name( HIR "〨糃" NOR, ({ "sword" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long",
			"硂琌рれ繨Θ糃籇癬ㄓΤ糃ōㄨ帝砛\眖ゼǎ筁〨\n"
			"ゅΤ糃琡场Τㄢㄌ祡侩粄絝   \n");
		set("value", 18000);
		set("material", "steel");
		set("wield_msg", "$N詜羘┾р$n搐もい\n");
		set("unequip_msg", "$N盢もい$n础竬丁糃繲\n");
	}

	init_sword(44);
	setup();

	set("weapon_prop/spirituality", 30);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int damage;

	if( victim->is_ghost() ) {
		if( random(me->query("max_atman")) > (int)victim->query("atman")/2 ) {
			damage = me->query_spi();
			victim->receive_wound("gin", damage);
			me->receive_heal("gin", damage);
			me->receive_heal("kee", damage);
			me->receive_heal("sen", damage);
			return HIY "糃祇︹覾\瑈筂$Nō\n" NOR;
		}
		return random(me->query_spi());
	}
}
