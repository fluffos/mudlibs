// drift_sense.c

#include <ansi.h>

inherit SSERVER;

int conjure(object me, object target)
{
	if( me->is_fighting() )
		return notify_fail("驹矮い礚猭ㄏノ笴醚硄\n");
	if( me->query("atman") < 75 )
		return notify_fail("艶ぃ镑\n");
	if( target )
		return notify_fail("笴醚硄癸︑ㄏノ\n");
	write("璶簿笆ō娩");
	input_to( (: call_other, __FILE__, "select_target", me :));
	return 1;
}

void select_target(object me, string name)
{
	object ob;

	if( !name || name=="" ) {
		write("いゎ琁猭\n");
		return;
	}

	ob = find_player(name);
	if( !ob || !me->visible(ob) || wizardp(ob) )
		ob = find_living(name);
	if( !ob || !me->visible(ob) || wizardp(ob) ) {
		write("礚猭稰硂艶 ....\n");
		write("璶簿笆ō娩");
		input_to( (: call_other, __FILE__, "select_target", me :));
		return;
	}
	if( me->is_fighting() ) {
		write("驹矮い礚猭ㄏノ笴醚硄\n");
		return;
	} else if( me->query("atman") < 75 ) {
		write("艶ぃ镑\n");
		return;
	}

	me->add("atman", -75);
	me->receive_damage("gin", 30);
	
	message_vision( HIY "$N繷超ヘ秨﹍琁甶笴醚硄 ....\n" NOR, me);
	if( random(ob->query("max_atman")) < (int)me->query("atman") / 2 ) {
		write("稰癸よ艶琌ぃ镑眏疨\n");
		return;
	}
	if( random(me->query_skill("magic")) < (int)ob->query("atman") / 50 ) {
		write("ぃ镑剪絤τア毖\n");
		return;
	}
	message( "vision", HIY "\n笵模泊▇┛礛竛︘" + me->name() 
		+ "碭牧▇㎝霍ア眔礚紇礚萝\n\n", environment(me), ({ me }) );
	me->move(environment(ob));
	message( "vision", HIY "\n泊玡礛瞷刮模泊▇▇い疊瞷紇\n\n" NOR,
		environment(ob), ({ me }) );
}

