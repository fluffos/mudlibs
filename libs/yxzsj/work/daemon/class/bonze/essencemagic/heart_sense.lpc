// heart_sense.c

#include <ansi.h>

inherit SSERVER;

int conjure(object me, object target)
{
	if( !target || !target->is_character() )
		return notify_fail("璶癸街ㄏノみ醚硄\n");
	if( target->is_corpse() )
		return notify_fail("ㄓぃのΤ毕眶\n");

	if( (int)me->query("atman") < 50 ) return notify_fail("艶ぃ镑\n");
	me->add("atman", -50);
	me->receive_damage("sen", 30);
	message_vision( HIY "$Nも$nぱ艶籠\も禟$nみ超泊氟絯絯 ...\n" NOR,
		me, target );
	if( random(me->query("max_atman")) > 100 )
		target->revive();
	else
		me->unconcious();
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;
}
