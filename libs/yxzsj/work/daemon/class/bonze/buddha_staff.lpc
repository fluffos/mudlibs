// buddha_staff.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name( HIY "敌矗罥" NOR, ({ "buddha staff", "staff" }) );
	set_weight(80000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "兵");
		set("long", "兵彩獶盽℉独簧罥芧帝せ簧吏\n");
		set("value", 6200);
		set("material", "brass");
		set("wield_msg", "$N篱礛$n搐もい\n");
		set("unwield_msg", "$Nもい$n\n");
	}

	init_staff(93);
	setup();
}
