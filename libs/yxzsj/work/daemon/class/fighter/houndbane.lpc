// houndbane.c

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
	set_name( GRN "Н監" NOR, ({ "houndbane blade", "houndbane", "blade" }) );
	set_weight(17000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", "硂琌р穞厚︹碍繷もい℉╨╨\n");
		set("value", 42000);
		set("material", "crimsonsteel");
		set("wield_msg", "$N腂羘┾р璉玴痢$n搐もい\n");
		set("unequip_msg", "$N盢もい$n础竬丁繲\n");
	}

	init_blade(96);
	set("weapon_prop/courage", 10);
	setup();
}
