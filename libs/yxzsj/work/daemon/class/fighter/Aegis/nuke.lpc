// nuke.c

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target) {
  object *ob;
  int i, skill, damage;

  if ((int)me->query("force") < 300)
    return notify_fail("你的內力不夠。\n");

  skill = me->query_skill("force");

  me->add("force", -300);
  me->receive_damage("kee", 10);

  message_vision(
    HIR "$N發射了一枚核彈﹐大喝一聲: " NOR, me);
  message_vision(
    HIY "核  融  爆!!\n" NOR, me);
  message_vision(
    RED "                -----------                           :  \n" NOR, me);
  message_vision(
    RED "          --------        -------                     :  \n" NOR, me);
  message_vision(
    RED "        ---                 --------                  : \n" NOR, me);
  message_vision(
    HIY "          ---            ------             ～ ～～ ～～ ～   \n" NOR, me);
  message_vision(
    HIY "            ------------------- \n" NOR, me);
  message_vision(
    RED "                                      ～～ ～                      : \n" NOR, me);
  message_vision(
    RED "                  :                                                : \n" NOR, me);
  message_vision(
    RED "                  :                               ---------------  : \n" NOR, me);
  message_vision(
    HIR "                  :                          -------          ------- \n" NOR, me);
  message_vision(
    HIY "                   ～ ～～ ～～ ～        ---                 ---------- \n" NOR, me);
  message_vision(
    HIR "         :                             --------                 -- \n" NOR, me);
  message_vision(
    RED "         :                                 ---               ---------  \n" NOR, me);
  message_vision(
    HIR "         :                                   ------------------- \n" NOR, me);
  message_vision(
    RED "        -----------   \n" NOR, me);
  message_vision(
    HIR "   --------        -------    \n" NOR, me);
  message_vision(
    RED "---                 --------        :             \n" NOR, me);
  message_vision(
    HIY "  ---              ------           : ～ ～～ ～～ ～  \n" NOR, me);
  message_vision(
    RED "    -------------------             :       \n" NOR, me);
  message_vision(
    HIR "                                    : \n" NOR, me);



  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    damage = ((skill - ((int)ob[i]->query("max_force") / 10)) * 100);
    if (damage > 0) {
      ob[i]->receive_damage("kee", damage);
      ob[i]->receive_wound("kee", damage / 2);
      tell_object(ob[i], "你眼前忽然出現了一道白光,並燒掉了所有的事物!!\n");
    }

    if (userp(ob[i])) ob[i]->fight_ob(me);
    else if (!ob[i]->is_killing(me->query("id"))) ob[i]->kill_ob(me);
  }

  return 1;
}
