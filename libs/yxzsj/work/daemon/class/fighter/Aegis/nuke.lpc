// nuke.c

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target)
{
	object *ob;
	int i, skill, damage;

	if( (int)me->query("force") < 300 )
		return notify_fail("ずぃ镑\n");

	skill = me->query_skill("force");

	me->add("force", -300);
	me->receive_damage("kee", 10);
                                    
	message_vision(
		HIR "$N祇甮猅紆耻羘: " NOR, me);
	message_vision(
		HIY "  磕  脄!!\n" NOR, me);
	message_vision(
		RED "                -----------                           :  \n" NOR, me);
	message_vision(
		RED "          --------        -------                     :  \n" NOR, me);
	message_vision(
		RED "        ---                 --------                  : \n" NOR, me);
	message_vision(
		HIY "          ---            ------             ° °° °° °   \n" NOR, me);
	message_vision(
		HIY "            ------------------- \n" NOR, me);
	message_vision(
		RED "                                      °° °                      : \n" NOR, me);
	message_vision(
		RED "                  :                                                : \n" NOR, me);
	message_vision(
		RED "                  :                               ---------------  : \n" NOR, me);
	message_vision(
		HIR "                  :                          -------          ------- \n" NOR, me);
	message_vision(
		HIY "                   ° °° °° °        ---                 ---------- \n" NOR, me);
	message_vision(
		HIR "         :                             --------                 -- \n" NOR, me);
	message_vision(
		RED "         :                                 ---               ---------  \n" NOR, me);
	message_vision(
		HIR "         :                                   ------------------- \n" NOR, me);
	message_vision(
		RED "        -----------   \n" NOR, me);
	message_vision(
		HIR "   --------        -------    \n" NOR, me);
	message_vision(
		RED "---                 --------        :             \n" NOR, me);
	message_vision(
		HIY "  ---              ------           : ° °° °° °  \n" NOR, me);
	message_vision(
		RED "    -------------------             :       \n" NOR, me);
	message_vision(
		HIR "                                    : \n" NOR, me);

		

	ob = all_inventory(environment(me));
	for(i=0; i<sizeof(ob); i++) {
		if( !living(ob[i]) || ob[i]==me ) continue;
		damage = ((skill - ((int)ob[i]->query("max_force") / 10)) * 100);
		if( damage > 0 ) {
			ob[i]->receive_damage("kee", damage);
			ob[i]->receive_wound("kee", damage/2);
			tell_object(ob[i], "泊玡┛礛瞷笵フ,縉奔┮Τㄆ!!\n");
		}
		
		if( userp(ob[i]) ) ob[i]->fight_ob(me);
		else if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
	}

	return 1;
}

