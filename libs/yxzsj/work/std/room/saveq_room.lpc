// saveeq_room.c  by 幽魂 ghoster@ms14.url.com.tw (1999.07.29)

int do_save(object me, object obj);
int do_get(int item_num);
private int check_money(object me);

inherit ROOM;

void init() {
  add_action("do_saveeq", "saveeq");
  add_action("do_geteq", "geteq");
  add_action("do_list", "list");
}

int do_saveeq(string arg) {
  string item;
  object obj, me;
  int pay_money;

  me = this_player();

  if (!arg) return notify_fail("你要將什麼東西存放在此﹖\n");

  if (sscanf(arg, "%s", item) == 1) {
    if (!objectp(obj = present(item, me)))
      return notify_fail("你身上沒有這樣東西。\n");
    if (obj->query_amount() || obj->is_character() || obj->is_corpse())
      return notify_fail("這裡不幫人保管這樣東西。\n");
    if (check_money(me))
      return notify_fail("保管物品的費用為："
        +F_VENDOR->price_string(check_money(me)) + "。\n");
    return do_save(me, obj);
  }

  if (!objectp(obj = present(item, me)))
    return notify_fail("你身上沒有這樣東西。\n");
  //	return do_save(me, obj);
}

int do_save(object me, object obj) {
  string save;
  int count, i;

  for (count = 0, i = 1; i < 11; i++) {
    save = me->query("save" + (string)i);
    if (base_name(obj) + ".lpc" == save)
      return notify_fail("你不能存放兩個相同的東西。\n");
    if (!save) {
      me->set("save" + (string)i, base_name(obj) + ".lpc");
      me->set("savename" + (string)i, obj->query("name") + "(" + obj->query("id") + ")");
      message_vision(sprintf("$N將一%s%s存放在這裡。\n",
        obj->query("unit"), obj->name()), me);
      destruct(obj);
      return 1;
    }
    count++;
  }
  return notify_fail("這裡只提供玩家存放十樣東西。\n");
}

int do_geteq(string arg) {
  int item_num, i;

  if (!arg || sscanf(arg, "%d", item_num) != 1 && arg != "all")
    return notify_fail("指令格式 : geteq  <物品存放編號>\n");

  if (item_num > 0 && item_num < 11) do_get(item_num);
  if (arg == "all") {
    for (i = 1; i < 11; i++) {
      do_get(i);
    }
    return 1;
  }
  return 1;
}

int do_get(int item_num) {
  object me, ob;
  string save;

  me = this_player();
  seteuid(getuid());

  save = me->query("save" + (string)item_num);
  if (!save) return notify_fail("沒有這個物品....!!\n");
  ob = new(save);
  ob->move(me);
  message_vision(sprintf("$N將一%s%s提出。\n",
    ob->query("unit"), ob->name()), me);
  me->delete("save" + (string)item_num);
  me->delete("savename" + (string)item_num);
}

int do_list() {
  string list, savename;
  int i;
  object me;

  me = this_player();
  list = " *******你存放在這裡的物品有:*********\n\n      <編號>  <物品名稱>\n";

  for (i = 1; i < 11; i++) {
    savename = me->query("savename" + (string)i);
    if (!savename) savename = "<空位置>";
    if (i < 10) list = list + "\t" + (string)i + "     " + savename + "\n";
    else list = list + "       " + (string)i + "     " + savename + "\n";
  }


  write(list + "\n *************************************\n\n");
  return 1;
}

int check_money(object me) {
  int check_money;

  check_money = environment(me)->query("pay_money");
  if (!check_money) check_money = 100;

  if (!me->can_afford(check_money))
    return check_money;
  me->pay_money(check_money);
  return 0;
}
