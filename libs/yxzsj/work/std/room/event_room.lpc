inherit ROOM;
#include <ansi.h>

void create() {
  ::setup();
}

void init() {
  add_action("do_go", "go");
}

int do_go(string direction) {
  string event, exit, exit1;
  int e_happen;
  object me;

  if (!direction) { return 0; }

  me = this_player();
  event = me->query("event");
  e_happen = environment(me)->query("e_happen") * 2;

  if (!e_happen) {
    write("你發現似乎有一些問題.....,請將此訊息告訴wiz!!\n");
    return 1;
  }

  exit = environment(me)->query("event_exit");
  if (direction == exit) {
    exit1 = event[e_happen..e_happen];  //exit1=第e_happen事件的事件代碼
    if (environment(me)->query("event_exit" + exit1))
      me->move(environment(me)->query("event_exit" + exit1));
    else me->move(environment(me)->query("event_exit0"));
    //當exit1!=0時到event_exit1,event_exit2....的其中一個事件房間
    //exit1=0或exit1不存在時表示到不發生任何事件的空房間
    return 1;
  }
}
