// invo_room.c  by 幽魂 ghoster@ms14.url.com.tw (1999.07.29)

#include <ansi.h>
private int pay_money(object me);
inherit ROOM;

void init() {
  add_action("do_invo", "invo");
  add_action("do_list", "list");
}

int do_invo(string name) {
  int pay_money, money;
  object soldier, me, env;

  me = this_player();
  env = environment(me);

  if (!name) return notify_fail("你想僱用誰﹖\n");
  if (!objectp(soldier = present(name, env)))
    return notify_fail("這裡沒有這個人!!\n");

  if (userp(soldier)) return notify_fail("你想僱用玩家!?\n");
  if (soldier->query_leader())
    return notify_fail("已經有別人先僱用他了!!\n");
  if (pay_money(me))
    return notify_fail("你必須付" HIR + pay_money(me) + NOR "個銅幣當夥伴介紹費。\n");

  money = soldier->query("inv_money"); /* inv_money:僱用費 */ if (!money) money = 1;
  soldier->invocation(me, money);

  message_vision(HIY "$N" NOR + "僱用了" + HIR "$n" NOR + "當夥伴!!\n",
    me, soldier);
  return 1;
}

int do_list() {
  int i, money;
  object *inv, me, env;
  string str;
  me = this_player();
  env = environment(me);

  str = "\n以下是你所能僱用的人及其薪資計算方式:(介紹費為:" + env->query("pay_money") + "個銅幣)\n\n";
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (!me->visible(inv[i])) continue;
    if (!inv[i]->is_character() || inv[i]->is_corpse()) continue;
    if (userp(inv[i])) continue;
    money = inv[i]->query("inv_money"); /* inv_money:僱用費 */ if (!money) money = 1;
    str = str + "   " + inv[i]->short() + "   每天的僱用費為: " HIY + money * 9 + NOR " 個銅幣\n";
  }
  if (!str) return notify_fail("很抱歉!!你必須等有人回來後才能僱用他們!!\n");
  write(str + "\n");
  return 1;
}

int pay_money(object me) {
  object env, amount;
  int pay_money;

  env = environment(me);
  pay_money = env->query("pay_money"); /* pay_money:介紹費 */

  amount = present("coin_money", me);
  if (!pay_money) pay_money = 30;
  if (!amount) {
    return pay_money;
  }
  if ((int)amount->query_amount() < pay_money) {
    return pay_money;
  } else { amount->add_amount(-pay_money); }
}
