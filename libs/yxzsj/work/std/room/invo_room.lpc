#include <ansi.h>
private int pay_money(object me);
inherit ROOM;

void init()
{
  	add_action("do_invo", "invo");
  	add_action("do_list", "list");
}

int do_invo(string name)
{
    int pay_money,money;
    object soldier,me,env;

        me=this_player();
        env=environment(me);

        if(!name)return notify_fail("稱沟ノ街\n");
        if( !objectp(soldier = present(name,env)))
	    return notify_fail("硂柑⊿Τ硂!!\n");

        if(userp(soldier))  return notify_fail("稱沟ノ產!?\n");
        if(soldier->query_leader())
             return notify_fail("竒Τ沟ノ!!\n");
        if(pay_money(me))
             return notify_fail("ゲ斗"HIR+pay_money(me)+NOR"簧刽讽官︸ざ残禣\n");

        money=soldier->query("inv_money");  /* inv_money:沟ノ禣 */
        if(!money) money=1;
	soldier->invocation(me,money);

	message_vision(HIY"$N"NOR+"沟ノ"+HIR"$n"NOR+"讽官︸!!\n",
		me,soldier);
        return 1;
}

int do_list()
{
      int i,money;
      object *inv,me,env;
      string str;
      me=this_player();
      env=environment(me);

      str="\n琌┮沟ノのㄤ羱戈璸衡よΑ:(ざ残禣:"+env->query("pay_money")+"簧刽)\n\n";
      inv = all_inventory(env);
      for(i=0; i<sizeof(inv); i++) {
	  if( inv[i]==me ) continue;
  	  if( !me->visible(inv[i]) ) continue;
	  if( !inv[i]->is_character()|| inv[i]->is_corpse()) continue;
          if( userp(inv[i])) continue;
          money=inv[i]->query("inv_money");  /* inv_money:沟ノ禣 */
          if (!money) money=1;
  	  str = str+"   "+inv[i]->short() + "   –ぱ沟ノ禣: "HIY+money*9+NOR" 簧刽\n";
      }
      if(!str) return notify_fail("╆簆!!ゲ斗单Τㄓ沟ノ!!\n");
      write(str+"\n");
      return 1;
}

int pay_money(object me)
{
    object env,amount;
    int pay_money;

    env=environment(me);
    pay_money=env->query("pay_money"); /* pay_money:ざ残禣 */

        amount = present("coin_money", me);
        if(!pay_money) pay_money=30;
	if( !amount ){
             return pay_money;
        }
	if ( (int)amount->query_amount() < pay_money ){
             return pay_money;
        }
        else { amount->add_amount(-pay_money); }      
}