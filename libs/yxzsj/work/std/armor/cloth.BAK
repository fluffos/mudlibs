// cloth.c

#include <armor.h>

inherit EQUIP;

void setup()
{
	if( clonep(this_object()) ) return;

	set("armor_type", TYPE_CLOTH);
	if( !query("armor_apply/dodge")
	&&	weight() > 3000 )
		set("armor_prop/dodge", - weight() / 3000 );
}

int query_autoload()
{
return 1;
}

void init()
{
	add_action("do_tear", "tear");
}

int do_tear(string str)
{
	object ob;

	if( !id(str) ) return 0;

	if( (string)query("material") != "cloth" )
		return notify_fail("脊ガ︾狝\n");

	if( (int)query("teared_count") >= 4 )
		return notify_fail( name() + "砈狞竒⊿Τ緇ガ脊\n");

	message_vision("$N眖" + name() + "脊兵ガ兵\n", this_player() );
	add("teared_count", 1);
	ob = new("/obj/bandage");
	ob->set_name("眖" + name() + "脊ガ兵", ({ "cloth piece", "piece", "cloth" }) );
	if( !ob->move(this_player()) )
		ob->move(environment(this_player()));
	return 1;
}
