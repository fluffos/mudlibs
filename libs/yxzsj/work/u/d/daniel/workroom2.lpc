// Room: /u/d/guo/workroom.c

#include <ansi.h>
#define divide "──────────────────────────────────────\n"

inherit ROOM;

void create() {
  set("short", "[1;36m輔天的工作室[2;37;0m");
  set("long", @LONG
　　這裡就是傳說中的巫師輔天的工作室，四周一片好山好水，鳥語花香。
你可以看到四周有許多文人雅士在高談闊論，還有一些人在彈素琴、閱金經
，令你不禁也想走上前去談天下、論古今。在這個清靜閑雅的好地方，你還
可以看到面前有一整排的先進電腦，和一臺克雷主機。有一些穿著白袍的科
學家，正在努力的埋首發展各種最先進的軟體，讓霹靂的未來更美好。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "secret",
    "tao": "/d/reason/house4",
    "floor": __DIR__ "room/3F/3F-1",
    "wproom": __DIR__ "room/wproom/way1",
    "pk": "/d/pkroom/w/pkr0",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/mastersu": 1,
  ]));
  seteuid(ROOT_UID);
  set("no_clean_up", 0);
  set("valid_startroom", 1);

  setup();
}
void init() {
  add_action("do_test", "testx");
  add_action("do_wizs", "wizlist");
  add_action("do_forceb", "forceb");
  add_action("do_listen", "listen");
  add_action("do_message", "message");
}
void do_test() {
  this_player()->set("env/msg_min", HIY + "\n只見一道金光咻的飛到此地，$N從裡面從容自在的踏步而出！\n" + NOR);
  this_player()->set("env/msg_mout", HIY + "\n$N拱手道：「各位請，劣者暫別了。」，化為一道金光咻的向外飛去！\n" + NOR);
  this_player()->set("env/msg_home", HIY + "\n$N拱手道：「各位請，劣者暫別了。」，化為一道金光咻的向外飛去！\n" + NOR);
  write("ok");
}


string get_status(object ob) {
  if (in_edit(ob) || in_input(ob))
    return " (編輯中)";
  return "";
}

string get_idle(object ob) {
  int val;
  switch (val = query_idle(ob)) {
    case 0..59: return "";
    case 60..3599: return sprintf(HIY " [發呆%2d分鐘]" NOR, val / 60
    );
    default: return sprintf(HIY " [發呆%2d小時]" NOR, val / 3600);
  }
}

string get_invis(object ob) {
  return ob->visible(this_player()) ? "" : HIC " [隱形中]" NOR;
}

string get_id(object ob) {
  return ob->query("name") + "(" + capitalize(ob->query("id")) + ")";
}

string get_env(object ob) {
  return CYN " (" + file_name(environment(ob)) + ")" NOR;
}

int do_wizs(string str) {
  object *wizs;
  int i;

  wizs = filter_array(users(), "filter_wizards", this_object());
  wizs = sort_array(wizs, "sort_wizards", this_object());
  i = sizeof(wizs);
  str = divide;

  while (i--)
    str = sprintf("%s【 %s 】%s「%s」%s%s%s%s%s\n",
      str, wizs[i]->rank(), wizs[i]->query("title"),
      wizs[i]->query("nickname"), get_id(wizs[i]),
      get_status(wizs[i]), get_idle(wizs[i]),
      get_invis(wizs[i]), get_env(wizs[i]));

  write(sprintf("\n%s\t\t   目前共有 %d 個巫師在線上\n%s%s",
    divide, sizeof(wizs), str, divide));
  return 1;
}

int filter_wizards(object ob) {
  return wizardp(ob);
}

int sort_wizards(object ob1, object ob2) {
  return wiz_level(ob1) - wiz_level(ob2);
}
int do_forceb(string arg) {
  object ob;
  string victim, cmd;

  if (!arg || arg == "" || (sscanf(arg, "%s to %s", victim, cmd) != 2
    && sscanf(arg, "%s %s", victim, cmd) != 2))
    return notify_fail("指令格式 : force <某人> to <做什麼>\n");

  ob = present(victim, environment(this_player()));
  if (!ob)
    return notify_fail("你找不到這個人。\n");

  ob->forceb(cmd);

  return 1;
}
int do_listen(string arg) {
  object me = this_player();
  string *tuned_ch;

  tuned_ch = me->query("channels");
  if (!arg) {
    if (!pointerp(tuned_ch) || !sizeof(tuned_ch))
      write("你現在並沒有收聽任何頻道。\n");
    else
      write("你現在收聽的頻道﹕" + implode(tuned_ch, ", ") + "。\n");
    return 1;
  }

  write("打開 " + arg + " 頻道。\n");
  tuned_ch += ({ arg });
  me->set("channels", tuned_ch);
  return 1;
}
int msgg(object me) {
  tell_object(users(), CYN + "\n\n遠方咻的一聲，有一封飛書正破空而來。\n" NOR);
  call_out("msg", 3, me);
  return 1;
}
int msg(object me) {
  tell_object(users(), HIG + "\n\n看來有人要傳達重要的武林機密給你了！\n" NOR);
  call_out("msg1", 4, me);
  return 1;
}
int msg1(object me) {
  tell_object(users(), HIY + "\n\n一封飛書迎面而來，你帥氣的把它接住！\n" NOR);
  call_out("msg2", 4, me);
  return 1;
}
int msg2(object me) {
  tell_object(users(), HIW "\n\n你說道：嗯，看來！！把飛書打開來看。\n" NOR);
  call_out("msg3", 4, me);
  return 1;
}
int msg3(object me, string arg) {
  tell_object(
    users(),
    HIR "\n\n" + (string)me->query("name") + "旨意：" + (string)me->query_temp("speak") + "\n" NOR
  );
  call_out("msg4", 4, me);
  return 1;
}
int msg4(object me) {
  tell_object(users(), GRN "\n\n你看完後，字跡隨之消失，你將信紙拿去回收。\n" NOR);
  return 1;
}
int do_message(string arg) {
  object me;
  me = this_player();
  if (!arg) {
    write("空訊息耶...不能送出喔。\n");
    return 1;
  }
  call_out("msgg", 3, me);
  me->set_temp("speak", arg);
  return 1;
}
