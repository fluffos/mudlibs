// blksuit.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
	set_name(WHT"瞏︹砊"NOR, ({ "black suit", "black", "suit" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌尿絫ン砊籇癬ㄓΤ睲媚稱ゲ琌キ︽洛┮\n");
		set("unit", "ン");
		set("value", 10000);
		set("material", "cloth");
		set("armor_type", "cloth");
		set("armor_prop/armor", 20);
		set("armor_prop/force", 15);
		set("armor_prop/spells", 15);
		set("armor_prop/magic", 15);
	}
}