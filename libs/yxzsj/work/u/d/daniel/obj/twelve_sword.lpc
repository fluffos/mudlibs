#include <weapon.h>
#include <ansi.h> 
inherit SWORD;
 
void create()
{
        set_name(HIW"礚寄"NOR, ({ "twelve sword", "sword" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "р");
                set("long",
                       "硂琌р堵蔑彩琡琌糃材礚絘\n");
                set("value", 3400);
                set("material", "blacksteel");
		set("weapon_prop/sword", 50);
		set("weapon_prop/strength", 20);
                set("wield_msg", "钮ǎ腂羘$Nもい竒р$n\n");
                set("unequip_msg", "$N盢もい$n┕┻$n抖墩础璉糃繲\n");
        }
        init_sword(140);
        setup();
}

