// lunchbox.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
	set_name(HIR"ネ"HIC"ら"HIG""HIM"矹"HIY"縷"NOR, ({ "super cake","super","cake" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌Τ糷加蔼禬矹縷琌Guo盡Cou，\n"HIR"Couネらе贾\n"NOR);
		set("unit", "畒");
		set("value", 50);
		set("food_remaining", 10);
		set("food_supply", 100);
	}
}
