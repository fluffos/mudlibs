#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create() {
  set_name("粗布衣", ({ "suit" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "張");
    set("value", 2000);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/id", ({ "big byg" }));
    set("armor_prop/name", ({ "大拜格肉包狗" }));
    set("armor_prop/short", ({ "「ψ 雲門 ψ 因為強所以 沒title」大拜格大肉包(Big Byg)
" }));
    set("armor_prop/title", ({ "三途判" }));
    set("armor_prop/long", ({
      "「ψ 雲門 ψ 因為強所以 沒title」大拜格大肉包(Big Byg)
\n"
    }));
  }
  setup();
}
