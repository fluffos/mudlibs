// whisk.c

#include <armor.h>
#include <ansi.h>

inherit HANDS;

void create() {
  set_name("拂塵", ({ "whisk" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "這是一隻普通的拂塵，武林高手常拿著它來表示優雅或作為防衛。\n");
    set("unit", "隻");
    set("value", 1000);
    set("material", "wood");
    set("armor_prop/armor", 5);
    set("armor_prop/dodge", 5);
  }

  set("wear_msg", "$N拿起一隻$n握在手中。\n");
  set("unequip_msg", "$N放下手中的$n。\n");

  setup();
}
int query_autoload() { return 1; }
