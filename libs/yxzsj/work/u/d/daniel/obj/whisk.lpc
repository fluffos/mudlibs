// whisk.c

#include <armor.h>
#include <ansi.h>

inherit HANDS;

void create()
{
	set_name("┴剐", ({ "whisk" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌唉炊硄┴剐猌狶蔼も盽帝ウㄓボ纔懂┪ň矫\n");
		set("unit", "唉");
		set("value", 1000);
		set("material", "wood");
		set("armor_prop/armor", 5);
		set("armor_prop/dodge", 5);
	}

	set("wear_msg", "$N癬唉$n搐もい\n");
	set("unequip_msg", "$Nもい$n\n");

	setup();
}
int query_autoload() { return 1; }