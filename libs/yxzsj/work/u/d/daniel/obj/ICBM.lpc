#include <ansi.h>
inherit ITEM;

void create() {
  set_name("洲際彈道飛彈", ({ "ICBM", "icbm" }));
  set_weight(1);
  set("unit", "張");
  set("no_sell", 1);
  set("no_pawn", 1);
  set("value", 100);
  set("long", "這是枚用來給您問候您的朋友用的洲際彈道飛彈。\n");
}

void init() {

  add_action("send", "send");
}

int send(string arg) {
  object ob;
  string sex;
  if (this_object()->query("sended"))
    return notify_fail("這枚飛彈已經發射過囉﹐不要那麼節儉吧﹗\n");
  if (!arg) return notify_fail("送飛彈打誰﹖\n");
  if (!(ob = find_player(arg)))
    return notify_fail("這個玩家不在喔。\n");
  if (!this_player()->visible(ob)) return notify_fail("這個玩家不在喔。\n");
  if ((string)ob->query("gender") == "男性") sex = "你";
  else sex = "妳";
  write("你站在控制臺上，設定好目標按下紅色的發射鈕，只見面前的飛彈咻地直直往天上飛！\n");
  tell_object(ob, HIR "\n天空的雲霧被震波衝的四散﹐在火球當中﹐有枚洲際彈道飛彈射了下來！！\n" HIW);
  tell_object(ob, HIY "你大叫著：中共打過來啦！一邊抓了鋼盔去啟動長白相位陣列雷達和愛國者飛彈。\n" HIW);
  tell_object(ob, HIR "愛國者飛彈順利的打中了彈道飛彈，但是大塊的碎片砸了下來，瞬間把四周變成一片火海！\n" HIW);
  tell_object(ob, HIG "你稱著身軀從飛彈陣地的廢墟裡爬了起來，看到旁邊有一張外皮燒的焦黑的卡片飄了下來\n\n" HIW);
  tell_object(ob, sex + "接著那張卡片﹐細讀著﹕\n\n");
  tell_object(ob, HIC "好友﹗最近" + sex + "好嗎﹖寄上友誼的問候與關懷﹐當" + sex + "掀開卡片的剎那﹐願喜悅歡愉。\n\n" NOR);
  tell_object(
    ob,
    HIG "                                           " + this_player()->name() + "上\n\n" NOR
  );
  this_object()->set_name(
    HIG "" + (string)this_player()->name() + "" NOR + "送給" + sex + "的洲際彈道飛彈", ({
      "ask card",
      "card"
    }));
  this_object()->set("sended", 1);
  write("國防支援衛星顯示﹕洲際彈道飛彈已經準確的射到" + ob->query("name") + "的頭上囉。\n\n");
  return 1;
}
