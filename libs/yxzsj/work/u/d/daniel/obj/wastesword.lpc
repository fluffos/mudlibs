// wastesword.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
	set_name(BRED+HIY"紀糃"NOR, ({ "waste sword", "waste", "sword" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", 
"硂琌рパ筿そр初窾紀翰て\n"
"パе逮ネは莱膌矪瞶筁┮疟Θ糃Τ┤\n"
		);
		set("value", 50000);
		set("material", "steel");
		set("weapon_prop/sword", 200);
	}
	init_sword(500);

	set("wield_msg", "$Nネてň臔︾眖璉そだ玴筣糃甅\n"
"柑р$n搐盿帝も甅もい\n");
	set("unwield_msg", "$Nノ盿帝も甅も盢もい$nみ羖羖础\n"
"璉そだ玴筣糃甅叉ň臔︾癬ㄓ肞\n");

	setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
