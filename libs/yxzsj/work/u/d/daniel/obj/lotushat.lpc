// lotushat.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create()
{
	set_name(HIR"浆玜"NOR, ({ "lotus hat", "lotus", "hat" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "硂琌郴临痷拦浆玜睲ド间タ禜紉珇紈\n");
		set("unit", "郴");
		set("value", 2000);
		set("armor_type", "head");
		set("armor_prop/head", 10);
		set("armor_prop/literate", 20);
	}
}