// TASM.c

#include <weapon.h>

inherit THROWING;

void create() {
  set_name(
    "戰斧反艦飛彈",
    ({ "Tomahawk Anti-Ship Missile", "TASM", "tomahawk", "missile", "SSM", "anti-ship" })
  );
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "戰斧反艦飛彈是美國目前射程最遠的反艦飛彈，\n"
      "它是戰斧飛彈的反艦型，射程極遠且威力強大，\n"
      "是神盾級船艦不可或缺的武器。\n");
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 1500);
    set("base_value", 300000);
    set("value", 3000000);
    set("wield_msg", "$N將$n填入垂直發射系統，做好發射的準備。\n");
    set("unwield_msg", "$N將$n自垂直發射系統中卸載取出。\n");
  }
  set_amount(10);
  init_throwing(10000);
  setup();
}
int query_autoload() { return 1; }
