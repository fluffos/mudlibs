//白虎  by cou
#include <ansi.h>
inherit NPC;
int ask_leave();
int do_chat_msg_combat();
void do_turtle();

void create() {
  set_name("水紋", ({ "water dratle", "water", "dratle", "tao" }));
  set("class", "taoist");
  set("attitude", "peaceful");
  set("title", HIY "道教" HIW "-" HIR "四聖使" NOR);
  set(
    "nickname",
    HIC "『" NOR + HIG "道" NOR + HIC "』" NOR + BLU "§" NOR + HIY "四" NOR + YEL "聖" NOR + BLU " §" NOR + GRN "玄" NOR + HIG "武" NOR
  );
  set("age", 25);
  set("gender", "男性");
  set("long", @LONG

    他就是道教三世道君窮極一生心血鎖栽培四大弟子之一
道教『四聖使』中排行最末的『玄武』-水紋，據說他對於防
禦他人攻擊有相當的自信，如果不的話可找他試試。
LONG
  );
  set("inquiry", ([
    "四聖使": "乃是三世道君得意四大名徒。",
    "離開": (: ask_leave :),
  ]));
  set("str", 35);
  set("int", 60);
  set("cor", 25);
  set("spi", 33);
  set("combat_exp", 8000000);
  set("max_kee", 7000);
  set("max_gin", 6000);
  set("max_sen", 6000);
  set("cor", 30);
  set("max_atman", 2200);
  set("atman", 7000);
  set("max_force", 3500);
  set("force", 7000);
  set("max_mana", 3500);
  set("mana", 7000);
  set("warexp", 70);
  set("mana_factor", 150);
  set("force_factor", 160);
  set_skill("unarmed", 180);
  set_skill("wo-che-unarm", 180);
  set_skill("force", 180);
  set_skill("sky-ground-force", 180);
  set_skill("spells", 180);
  set_skill("parry", 180);
  set_skill("necromancy", 180);
  set_skill("dodge", 180);
  set_skill("tao-steps", 180);
  set_skill("magic", 100);
  set_skill("taoism", 100);
  map_skill("force", "sky-ground-force");
  map_skill("spells", "necromancy");
  map_skill("dodge", "tao-steps");
  map_skill("parry", "wo-che-unaem");
  map_skill("magic", "taoism");
  map_skill("unarmed", "wo-che-unarm");
  set_temp("apply/armor", 220);
  set_temp("apply/dodge", 220);
  set_temp("apply/damage", 220);
  set("chat_chance_combat", 250);
  set("chat_msg_combat", ({
    (: do_turtle :),
    (: do_chat_msg_combat :),
    //(: command, "exert powerup" :),
    //(: command, "exert armor" :),
    (: command, "exert recover" :),
    (: command, "cast power" :),
  }));
  setup();
  add_money("silver", 50);
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/boots")->wear();
  carry_object(__DIR__ "obj/hat")->wear();
  carry_object(__DIR__ "obj/dratle-shield")->wear();
  //carry_object("obj/longsword")->wield();
}

int ask_leave() {
  object me = this_player();
  command("sigh 你");
  command("say 這地方原不是你該來的，我就送你回聖龍口吧！記得下次沒事不要再來了。");
  command("say 記得幫我跟當世道尊問好！");
  command("emote 手一揮突然發出陣陣光芒，你登時感到一陣暈眩...");
  this_player()->move("/d/reason/house2");
  return 1;
}
void do_turtle() {
  object *ob, me;
  int i, skill, damage, d1;
  me = this_object();
  skill = me->query_skill("force");
  me->add("force", -250);
  me->receive_damage("kee", 150);

  message_vision(
    HIR "\n$N突然一聲低喝，手臂上的" HIG "龍龜盾甲" NOR + HIR "剎那間發出陣陣光芒，亮得你眼睛睜都睜不開﹗﹗\n" NOR +
    HIC "你被突如其來的光芒所震，一時駭然失神。\n\n" NOR +
    HIG "$N見機不可失，連忙運動全身真元，驟然念道：『 " HIG "玄" NOR + HIR "、" NOR + HIG "武" NOR + HIR "、" NOR + HIY "震" NOR + HIR "、" NOR + HIR "地" NOR + HIR " 』\n" NOR +
    HIY "突然四周光芒亂竄，$N急忙想脫身離開，卻活生生被光芒定住，動彈不得﹗\n" NOR +
    HIY "你正遲疑間，光芒已然化成一張青色的氣罩，凌厲無比的向你撲來﹗\n\n\n" NOR, me);

  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me || !me->is_fighting(ob[i])) continue;

    damage = 1500 - random(ob[i]->query_skill("unarmed"));
    d1 = random(damage);
    if (d1 < 500) d1 = 500 + random(me->query("force_factor"));
    if (damage > 0) {
      ob[i]->receive_damage("kee", damage);
      ob[i]->receive_wound("kee", d1);

      me->receive_heal("kee", (int)damage / 2);
      tell_object(
        ob[i],
        HIR "你閃避不及，被一道道的光芒割得遍體鱗傷，眼看就要倒下了﹗" NOR "" RED "(" HIG + damage + NOR "" RED ")\n\n" NOR
      );
      COMBAT_D->report_status(ob[i]);
      tell_object(ob[i], "\n");
      me->start_busy(2);
    }

    if (userp(ob[i])) ob[i]->fight_ob(me);
    else if (!ob[i]->is_killing(me->query("id"))) ob[i]->kill_ob(me);
  }
  return;
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
}

int do_chat_msg_combat() {
  command("exert recover");
  cast_spell("drainerbolt");
  if (random(2) <= 1) cast_spell("feeblebolt");
  if (random(2) <= 1) cast_spell("netherbolt");
}
