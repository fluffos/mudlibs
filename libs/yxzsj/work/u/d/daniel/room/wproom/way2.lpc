int valid_leave(object me,string dir)
{
   object guard;
   guard=present("spider",environment(me));

   if ((dir=="north") && guard)
   {
    message_vision(HIY"籮碉咀隔いァㄓ硂妓琌礚猭硄筁\n"NOR,me);
    return notify_fail("\n");
   }else return 1;
}
