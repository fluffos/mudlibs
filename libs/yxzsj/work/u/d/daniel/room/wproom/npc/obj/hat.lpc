#include <ansi.h>
#include <armor.h>
 
inherit HEAD;
 
void create()
{
        set_name("笵玜", ({ "hat" }) );
        set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("unit", "郴");
                set("value", 200);
		set("material", "cloth");
		set("armor_prop/armor", 1);
                set("armor_prop/spells", 1);
	}
	setup();
}
