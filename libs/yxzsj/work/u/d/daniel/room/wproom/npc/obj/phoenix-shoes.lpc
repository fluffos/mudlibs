#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(HIM "鳳" HIG "翔" HIC "千" HIY "里" NOR, ({ "phoenix shoes", "phoenix", "shoes" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "以神鳥─鳳凰的羽毛所編製而成的鞋子，火紅色的外表下卻閃著不可思議的靈光，\n"
      "聽說穿上它能夠獲得一日千里的速度。\n");
    set("unit", "雙");
    set("value", 100000);
    set("armor_type", "boots");
    set("armor_prop/dodge", 30);
    set("armor_prop/move", 30);
    set("armor_prop/armor", 30);
    set("armor_prop/attack", 30);
    set("class", "taoist");
    set("no_pawn", 1);
  }
  set("wear_msg", HIC "$N穿上$n" HIC "，頓時從腳下傳來陣陣暖意，你好像突然具有一躍百丈的神速。\n" NOR);
  set("unequip_msg", CYN "$N把$n" CYN "脫了下來，腳好像無法適應突如其來的重壓而跌倒。\n" NOR);
  setup();
}
int query_autoload() {
  return 1;
}
