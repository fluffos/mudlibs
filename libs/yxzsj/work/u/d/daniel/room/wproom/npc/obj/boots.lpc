#include <ansi.h>
#include <armor.h>
 
inherit BOOTS;
 
void create()
{
        set_name("堵ガ綾", ({ "blace boots", "boots" }) );
        set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("unit", "蛮");
                set("value", 200);
                set("material", "linen");
		set("armor_prop/armor", 1);
                set("armor_prop/dodge", 1);
	}
	setup();
}
