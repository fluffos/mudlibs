#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", HIC"笵芠盞"NOR);
	set("long", @LONG

今秈硂┬丁獽谋眔Τぃゑ碝盽井猑╋癬繷ㄓ
祇瞷瞷ōト猌笵芠盞ず硂┬丁柑程琌
甅┬丁柑腳糃(weapon)硂р腳糃砆竚廊れタ
祇帝礚猭跌▇碞ō娩皗ㄢ猌
蔼瞏笵礚礚ㄨぃ臔帝硂р腳糃

LONG
	);
        set("no_transmit",1);
        set("no_drift",1);
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/dragon1" : 1,
  __DIR__"npc/tiger" : 1,
]));

	set("item_desc", ([ /* sizeof() == 1 */
  "weapon" : "硂р腳糃タ砆刚帝рウㄓ(take)\n",
]));

	setup();
}
void init()
{
	add_action("do_take", "take");
}
int do_take()
{
	object guard, me, sword;
	me = this_player();
	guard=present("tao",environment(me));

	if ( guard )
	{
		message_vision(HIY"竧ㄏ耻笵ぐ或\n"NOR,me);
	}
	else
	{
		if ( query("sword_taken") == 1 )
			return notify_fail("腳糃竒砆ǐ\n");
		sword = new(__DIR__"obj/w7");
		tell_object(users(), "\n\n"+HIY+me->query("name")+HIR+"ゴ毖ト猌笵芠竧ㄏい獵纒フ抖眔"+sword->name()+HIR+"\n\n\n"+NOR);
		message_vision(HIG"癬腳糃ǎ"+sword->name()+HIG+"祇模泊▇\n\n"NOR, me);
		sword->move(me);
		set("sword_taken", 1);
	}

	return 1;
}
