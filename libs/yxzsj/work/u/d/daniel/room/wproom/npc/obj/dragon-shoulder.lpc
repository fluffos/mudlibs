#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create()
{
        set_name(HIY"纒"HIG"锦"HIR""HIC"ぱ"NOR, ({"dragon shoulder", "dragon", "shoulder"}));
        set_weight(3500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
set("long","琌ぱぱ┮奔辅妮竒パぱ材疟禣み┮岭硑τΘ\n"
"パ芠ㄓ陪眔だ琌ㄤ痷タ\︓さご礚惧\n");
                set("unit", "ン");
                set("value", 100000);
                set("material", "cloth");
                set("armor_type", "surcoat");
                set("armor_prop/armor", 30);
                set("armor_prop/attack", 30);
                set("armor_prop/archery", 30);
                set("armor_prop/sword", 30);
		    set("class", "taoist");
		  set("no_pawn", 1);
       }
        set("wear_msg", HIY"$N盢$n"HIY"杆パ礛祇纒羘臫\n"NOR);
        set("unequip_msg", YEL"$Nр$n"YEL"ㄓ$n"YEL"跑眔舊睭礚\n"NOR);
}
