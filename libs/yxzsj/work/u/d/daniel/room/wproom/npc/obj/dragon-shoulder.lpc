#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create() {
  set_name(HIY "龍" HIG "踞" HIR "九" HIC "天" NOR, ({ "dragon shoulder", "dragon", "shoulder" }));
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "此物乃是以九重天外天所掉落的神秘金屬經由天下第一鑄匠花費心思所鍛造而成，\n"
      "由外觀看來顯得十分神秘，但是其真正功\能至今仍無人知曉。\n");
    set("unit", "件");
    set("value", 100000);
    set("material", "cloth");
    set("armor_type", "surcoat");
    set("armor_prop/armor", 30);
    set("armor_prop/attack", 30);
    set("armor_prop/archery", 30);
    set("armor_prop/sword", 30);
    set("class", "taoist");
    set("no_pawn", 1);
  }
  set("wear_msg", HIY "$N將$n" HIY "裝在肩上，由肩上突然發出似龍吼的聲響。\n" NOR);
  set("unequip_msg", YEL "$N把$n" YEL "取了下來，$n" YEL "似乎變得黯淡無光。\n" NOR);
}
int query_autoload() {
  return 1;
}
