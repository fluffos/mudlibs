                set("unit", "");
set("long","タㄤ璶拦ウ碞ㄣΤ眏ю阑灿芠ぇ埃骸\n"
"ぃ才腹ㄤちΤ闽ㄓ方礚猭眔弧琌κ螟眔ǎ竟\n");
                set("material", "???");
	          set("value", 100000);
