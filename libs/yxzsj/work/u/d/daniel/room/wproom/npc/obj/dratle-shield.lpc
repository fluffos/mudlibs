#include <ansi.h>
#include <armor.h>

inherit SHIELD;

void create() {
  set_name(HIR "龍" HIM "龜" HIG "盾" HIY "甲" NOR, ({ "dratle shield", "dratle", "shield" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "此乃是以上古仙獸─千年龍龜背上的龜甲所製成的盾牌，\n"
      "據說此神器可將受到攻擊所受的傷害減到最低。\n");
    set("material", "?");
    set("unit", "副");
    set("value", 100000);
    set("armor_type", "shield");
    set("armor_prop/armor", 100);
    set("armor_prop/parry", 20);
    set("no_pawn", 1);
    set("class", "taoist");
  }
  set("wear_msg", HIG "$N將$n" HIG "拿在手中，$n" HIG "發出微微的青色光芒將$N圍繞在其中。\n" NOR);
  set("unequip_msg", GRN "$N放下$n" GRN "，周圍的護體光芒亦隨之消散。\n" NOR);
  setup();
}
int query_autoload() {
  return 1;
}
