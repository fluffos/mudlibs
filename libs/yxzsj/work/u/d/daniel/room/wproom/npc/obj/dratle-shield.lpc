#include <ansi.h>
#include <armor.h>

inherit SHIELD;

void create()
{
        set_name(HIR"纒"HIM"纓"HIG""HIY"ヒ"NOR, ({"dratle shield", "dratle", "shield" }));
        set_weight(2000);
        if(clonep())
        set_default_object(__FILE__);
        else {
set("long", "琌脋纒纓璉纓ヒ┮籹Θ礟\n"
"沮弧竟盢ю阑┮端甡搭程\n");
        set("material", "?");
        set("unit","捌");
        set("value", 100000);
        set("armor_type", "shield");
        set("armor_prop/armor", 100);
        set("armor_prop/parry", 20);
	  set("no_pawn", 1);
	  set("class", "taoist");
        }
        set("wear_msg", HIG"$N盢$n"HIG"もい$n"HIG"祇稬稬獵︹▇盢$N瞅露ㄤい\n"NOR);
        set("unequip_msg", GRN"$N$n"GRN"㏄瞅臔砰▇ョ繦ぇ床\n"NOR);
        setup();
}
int query_autoload()
{
		return 1;
}
