#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIC "密室通道" NOR);
  set("long", @LONG

　　你現在正走在一條幽暗的通道上，四周只有些微弱的燭光。從走進這條
道觀裡的神秘通道以來，你就一直很好奇這條通道到底會通到什麼神秘的地
方。你不小心被石頭絆了一下，才發現這條通道似乎越來越窄了，甚至周圍
還出現了一些非道教之人的骸骨。你藉著燭光，發現了前面有一些小東西在
路中央，看來要通過並不是你想像中的那麼容易。

LONG
  );
  set("no_transmit", 1);
  set("no_drift", 1);
  set("exits", ([ /* sizeof() == 5 */
    "north": __DIR__ "way2",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/gmouse": 4,
  ]));

  setup();
}
int valid_leave(object me, string dir) {
  object guard;
  guard = present("mouse", environment(me));

  if ((dir == "north") && guard) {
    message_vision(HIY "黃金鼠擋在路的中央，看來這樣你是無法通過的。\n" NOR, me);
    return notify_fail("\n");
  } else return 1;
}
