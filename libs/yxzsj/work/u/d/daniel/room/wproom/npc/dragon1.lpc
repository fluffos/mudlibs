{
        set_name("筽狙", ({ "thunder dragon" , "thunder", "dragon", "tao" }) );
        set("class", "taoist");
        set("attitude", "peaceful");
        set("title", HIY"笵毙"HIW"-"HIR"竧ㄏ"NOR);
        set("nickname", HIC""NOR+HIG"笵"NOR+HIC""NOR+BLU"”"NOR+HIY""NOR+YEL"竧"NOR+BLU" ”"NOR+GRN"獵"NOR+HIG"纒"NOR);
        set("age", 35);
        set("gender", "╧┦");
        set("long", @LONG

    ぱネ烩砈借璶辨帝ぃ︑荡碞穦玻ネ德礛癬穛稰谋
琌笵ぇ-獵纒筽狙パ烩旧Τよ┮
笵毙竧ㄏ羘ョ禫ㄓ禫臫獹琌笵毙ぃ
LONG
);
        set("inquiry", ([
                "竧ㄏ" : "琌笵眔種畕",
                "瞒秨" : (: ask_leave :),
        ]));
        set("str", 35);
        set("int", 60);
        set("cor", 25);
        set("spi", 33);
        set("combat_exp", 8000000);
        set("max_kee", 20000);
        set("max_gin", 17000);
        set("max_sen", 17000);
        set("cor", 30);
        set("max_atman", 2200);
        set("atman", 7000);
        set("max_force", 3500);
        set("force", 7000);
        set("max_mana", 3500);
        set("mana", 7000);
        set("warexp", 70);
        set("mana_factor", 150);
        set("force_factor", 160);
        set_skill("unarmed", 180);
        set_skill("wo-che-unarm", 180);
        set_skill("force", 180);
        set_skill("sky-ground-force", 180);
        set_skill("spells", 180);
        set_skill("parry", 180);
        set_skill("necromancy", 180);
        set_skill("dodge", 180);
        set_skill("tao-steps", 180);
        set_skill("magic", 100);
        set_skill("taoism", 100);
        map_skill("force", "sky-ground-force");
        map_skill("spells", "necromancy");
        map_skill("dodge", "tao-steps");
        map_skill("parry", "wo-che-unaem");
        map_skill("magic", "taoism");
        map_skill("unarmed", "wo-che-unarm");
        set_temp("apply/armor", 220);
