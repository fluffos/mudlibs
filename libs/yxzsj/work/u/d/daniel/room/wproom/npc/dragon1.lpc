int ask_leave()
{
        object me=this_player();
        command("sigh ");
        command("say 硂よぃ琌赣ㄓи碞癳竧纒癘眔Ω⊿ㄆぃ璶ㄓ");
        command("say 癘眔腊и蛤讽笵碙拜");
        command("emote も揣礛祇皚皚▇祅稰皚穡痶...");
        this_player()->move("/d/reason/house2");
        return 1;
}
 
void do_dragon()
{
        object *ob,me;
        int i, skill, damage, d1;
                me=this_object();
        skill = me->query_skill("force");
            me->add("force", -250);
        me->receive_damage("kee", 150);
 
        message_vision(
  HIM"\n$N礛羘耻も羥"HIR"纒锦ぱ"NOR+HIM"玝ê丁祇皚皚▇獹眔泊氟窩常窩ぃ秨\n"NOR+
  HIC"砆ㄤㄓ▇┮綺纀礛ア\n\n"NOR+
  HIR"$Nǎ诀ぃア硈Γ笲笆ō痷じ艼礛├笵 "GRN"獵"NOR+HIR""NOR+HIG"纒"NOR+HIR""NOR+HIY"祇"NOR+HIR""NOR+HIR""NOR+HIR" \n"NOR+
  HIY"礛㏄▇睹芦$NΓ稱叉ō瞒秨玱ネネ砆▇﹚︘笆紆ぃ眔\n"NOR+
  HIG"タ筐好丁▇礛てΘ笵笵獵纒糉礚ゑ汲ㄓ\n\n\n"NOR, me);
  
        ob = all_inventory(environment(me));
        for(i=0; i<sizeof(ob); i++) {
                if( !living(ob[i]) || ob[i]==me || !me->is_fighting(ob[i]) ) continue;
 
        damage = 2200-random(ob[i]->query_skill("unarmed"));
        d1 = random(damage);
                        if( d1 < 800 ) d1 = 800 + random(me->query("force_factor"));
                        if( damage > 0 ) {
		    ob[i]->receive_damage("kee", damage);
                ob[i]->receive_wound("kee", d1);
 
        me->receive_heal("kee",(int)damage/2);
        tell_object(ob[i], HIR"皗磷ぃの砆笵笵▇澄眔筂砰澎端泊碞璶"NOR""RED"("HIG+damage+NOR""RED")\n\n"NOR);
	  COMBAT_D->report_status(ob[i]);
	  tell_object(ob[i], "\n");
        me->start_busy(2);
                }
        
                if( userp(ob[i]) ) ob[i]->fight_ob(me);
                else if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
        }
        return ;
}
 
void init()
{
        object ob;
        ::init();
        if(interactive(ob =this_player()) && !is_fighting() )
        {
        remove_call_out("greeting");
        call_out("greeting",2,ob);
        }
}
 
int do_chat_msg_combat()
{
        command("exert recover");
        cast_spell("drainerbolt");
        if (random(2) <=1) cast_spell("feeblebolt");
        if (random(2) <=1) cast_spell("netherbolt");
}
 
void heart_beat()
{
        if (this_object()->query("gin") < this_object()->query("max_gin")/3)
                command("exert regenerate");
        if (this_object()->query("kee") < this_object()->query("max_kee")/3)
                command("exert recover");
        if (this_object()->query("sen") < this_object()->query("max_sen")/3)
                command("exert refresh");
        ::heart_beat();
}
