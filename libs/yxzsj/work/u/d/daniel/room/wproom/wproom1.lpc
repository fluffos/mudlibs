#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", HIC"笵芠盞"NOR);
	set("long", @LONG

今秈硂┬丁獽谋眔Τぃゑ碝盽井猑╋癬繷ㄓ
祇瞷瞷ōト猌笵芠盞ず硂┬丁柑程琌
甅┬丁柑腳(weapon)硂р腳砆竚廊れタ
祇帝礚猭跌▇碞ō娩皗ㄢ猌
蔼瞏笵礚礚ㄨぃ臔帝硂р腳

LONG
	);
        set("no_transmit",1);
        set("no_drift",1);
	set("exits", ([ /* sizeof() == 5 */
  "north" : __DIR__"wproom2",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/phoenix" : 1,
  __DIR__"npc/dratle" : 1,
]));

	set("item_desc", ([ /* sizeof() == 1 */
  "weapon" : "硂р腳タ砆刚帝рウㄓ(take)\n",
]));


	setup();
}
void init()
{
	add_action("do_take", "take");
}
int do_take()
{
	object guard, me, blade;
	me = this_player();
	guard=present("tao",environment(me));

	if ( guard )
	{
		message_vision(HIY"竧ㄏ耻笵ぐ或\n"NOR,me);
	}
	else
	{
		if ( query("blade_taken") == 1 )
			return notify_fail("腳竒砆ǐ\n");
		blade = new(__DIR__"obj/w3");
		tell_object(users(), "\n\n"+HIY+me->query("name")+HIR+"ゴ毖ト猌笵芠竧ㄏいΧ扯ト猌抖眔"+blade->name()+HIR+"\n\n\n"+NOR);
		message_vision(HIG"癬腳ǎ"+blade->name()+HIG+"祇模泊▇\n\n"NOR, me);
		blade->move(me);
		set("blade_taken", 1);
	}

	return 1;
}
int valid_leave(object me,string dir)
{
   object guard;
   guard=present("tao",environment(me));

   if ((dir=="north") && guard)
   {
    message_vision(HIY"竧ㄏ咀玡р咀ㄓ\n"NOR,me);
    return notify_fail("\n");
   }else return 1;
}
