// snake.c
inherit NPC;

#include <ansi.h>

void create() {
  set_name(HIM "毒蜘蛛" NOR, ({ "spider" }));
  set("race", "野獸");
  set("long", "這是一隻看起來比一般蜘蛛大，身上漆黑中帶有花紋的毒蜘蛛。\n");
  set("age", 3);
  set("str", 10);
  set("con", 500);
  set("cor", 200);
  set("max_kee", 1000);
  set("max_sen", 700);
  set("max_gin", 700);
  set("attitude", "aggressive");
  set("limbs", ({ "頭部", "身體", "腳部" }));
  set("verbs", ({ "bite" }));
  set("combat_exp", 50000);
  set_temp("apply/unarmed", 250);
  set_temp("apply/dodge", 300);
  set_temp("apply/parry", 200);
  setup();
  carry_object(__DIR__ "obj/tooth")->wield();
}
