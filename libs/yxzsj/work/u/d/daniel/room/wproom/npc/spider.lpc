// snake.c
inherit NPC;

#include <ansi.h> 

void create()
{
	set_name(HIM"瑀籮碉"NOR, ({ "spider" }) );
        set("race", "偿脋" );
	set("long","硂琌唉癬ㄓゑ籮碉ō海堵い盿Τ瑀籮碉\n");
	set("age", 3);
	set("str", 10);
        set("con", 500);
        set("cor", 200);
	set("max_kee",1000);
      set("max_sen", 700);
	set("max_gin", 700);
	set("attitude", "aggressive");
	set("limbs", ({ "繷场", "ō砰", "竲场" }) );
        set("verbs", ({ "bite" }) );
	set("combat_exp", 50000);
	set_temp("apply/unarmed",250);
	set_temp("apply/dodge",300);
	set_temp("apply/parry",200);
        setup();
        carry_object(__DIR__"obj/tooth")->wield();
}
