#include <ansi.h>
inherit NPC;
int ask_pill();
void create() {
  set_name(HIG "最愛有紀學姐" NOR, ({ "taoist pease", "pease", "taoist" }));
  set("race", "人類");
  set("gender", "男性");
  set(
    "title",
    HIC "道教護衛" HIW "-[1;36m太[2;37;0m[1;33m清[2;37;0m[1;31m道[2;37;0m[1;32m德[2;37;0m[1;37m天尊[2;37;0m"
  );
  create_family("道教", 2, "弟子");
  set("nickname", HIC "道心" NOR);
  set("class", "taoist");
  set("age", 22);
  set("con", 30);
  set("str", 29);
  set("max_mana", 2500);
  set("mana_factor", 100);
  set("max_gin", 8000);
  set("max_kee", 10000);
  set("max_sen", 8000);
  set("max_atman", 2500);
  set("max_force", 2500);
  set("force_factor", 100);
  set("force", 5000);
  set("mana", 5000);
  set("warexp", 70);
  set("long",
    "在他那俊秀的外表下，隱含著一絲放浪不羈的氣息，原來他就是昔日惡名昭彰的
金小開。不過自從他被魔域聖母收為義子之後，再度重出武林已經一改過去的惡行，
取而代之的是路見不平的俠義行為。現在他自稱『新新壞男人』，雖然稍嫌輕浮，
但已有一肩挑起武林重責大任的氣魄。自從他來到道教之後，武功\突飛猛進，現在
已成為道教之中屬一屬二的人物，享盛名於武林。據說他對道教的『煉丹術』稍有
涉獵，你或許\可以請教他有關這方面的問題。\n");
  set_skill("sword", 110);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("force", 120);
  set_skill("spells", 160);
  set_skill("taoism", 100);
  set_skill("sky-ground-force", 120);
  set_skill("necromancy", 160);
  set_skill("tao-steps", 100);
  set_skill("wo-che-sword", 110);

  map_skill("parry", "wo-che-sword");
  map_skill("force", "sky-ground-force");
  map_skill("sword", "wo-che-sword");
  map_skill("dodge", "tao-steps");
  map_skill("spells", "necromancy");
  set_temp("apply/dodge", 150);
  set_temp("apply/sword", 150);
  set_temp("apply/damage", 150);
  set_temp("apply/armor", 150);

  set("combat_exp", 500000);
  set("chat_chance", 20);
  set("chat_msg", ({
    CYN "最愛有紀學姐手按劍柄，紋風不動，一副不怒而威的模樣。\n" NOR,
    CYN "最愛有紀學姐雙目如電，注視著你的一舉一動。\n" NOR,
    (: command, "hmm" :),
  }));
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: cast_spell, "thunder" :),
    (: cast_spell, "power" :),
    (: command, "exert recover" :),
    (: command, "exert regenerate" :),
    (: command, "exert refresh" :),
    (: command, "exert armor" :),
    (: command, "exert powerup" :),
    (: perform_action, "sword.sky-ground-root" :),
  }));
  set("inquiry", ([
    "玄真君": "他經常不在道教的, 聽說在離愁谷..但不知道在那? ?...",
    "道尊": "你問咱們祖師爺呀﹖聽說他老人家去閉關了, 不要打擾他喔..",
    "青陽子": "你找他做什麼??  你還是請回吧!.....",
    "黑暗道": "那是很可怕的地方...我勸你還是不要去的好!....",
    "道院": "它在道教後山吧..自己去找找我可忙的很.....",
    "煉丹術": (: ask_pill :),
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/boots")->wear();
  carry_object(__DIR__ "obj/hat")->wear();
  carry_object(__DIR__ "obj/sword32")->wield();
  add_money("gold", 2);
}
int ask_pill() {
  object me = this_player();

  if (me->query("marks/煉丹術") == 0) {
    command("hmm");
    command("say $HIC$\n"
      "嗯，我是知道一點有關煉丹術的事情。
煉丹術最早是由漢代時的煉丹術士，長年累月地將各種物質、藥物拿來加熱、冷卻，
而由其中求得長生不老藥或是使其變成黃金。而道教的煉丹術，從當世道君後已有
突破性的發展，現在已經能夠做出用來增進法力修為的藥丸。但是我對這方面並沒
有深入的研究，或許\你可以去問問看小拜格大肉包，他一天到晚都在作藥，應該更
清楚有關這方面的資料。");

    me->set("marks/煉丹術", 1);
  } else
    command("say 我不是已經和你說過有關煉丹術的事情了嗎，好好加油吧！");

  return 1;
}
