void die()
{
        object winner = query_temp("last_damage_from");
        if (winner)
        {
         CHANNEL_D->do_channel(this_object(), "chat", winner->query("family/family_name")+""+winner->query("name")+"ゴ毖┮Τト猌笵皘档芠加臔矫°°\n");
        }
        :: die();
}
int ask_pill()
{
	object me=this_player();

	if ( me->query("marks/芬う砃") < 1 )
	{
		command("think");
		command("say $CYN$硂...иぃび睲贰．...");
