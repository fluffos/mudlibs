inherit ROOM;

void create() {
  set("short", "[1;35m紫觀樓[2;37;0m");
  set("long", @LONG

　　這裡就是玄武道院中最為神秘的紫觀樓，平時是不準任何閒雜人等進入
的機密重地。你踏進這裡，環視四周看似平凡無奇，但卻隱隱覺得四周佈滿
了陣法，無法探知在樓閣的深處藏著怎麼樣的秘密。你想要走入其中，但卻
有幾個看來莫測高深的護衛擋住了你的去路。在你的身邊還有一些紫色的煙
霧，使這個地方又平添了一些神秘感。

LONG
  );
  set("no_transmit", 1);
  set("no_drift", 1);
  set("exits", ([ /* sizeof() == 3 */
    "south": __DIR__ "3F-1",
    "east": __DIR__ "3F-4",
    "west": __DIR__ "3F-4",
    "north": __DIR__ "3F-6",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/guard5": 2,
  ]));

