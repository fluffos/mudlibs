int valid_leave(object me, string dir) {
  object guard;
  guard = present("worship", environment(me));

  if ((dir == "north") && guard) {
    message_vision(HIY "道士擋在你的面前，把你擋了回來。\n" NOR, me);
    return notify_fail("\n");
  } else return 1;
}
