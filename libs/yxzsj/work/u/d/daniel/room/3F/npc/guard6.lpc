#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIC "郭逸俠" NOR, ({ "taoist danielguo", "danielguo", "taoist" }));
  set("race", "人類");
  set("gender", "男性");
  set("title", HIC "道教護衛" HIW "-[1;32m玄天[2;37;0m[1;37m帝君[2;37;0m");
  create_family("道教", 2, "弟子");
  set("nickname", "[1;33m三[1;32m教[1;35m同[1;31m心[1;36m天[1;32m下[1;33m行[2;37;0m");
  set("class", "taoist");
  set("age", 22);
  set("con", 30);
  set("str", 29);
  set("max_mana", 2500);
  set("mana_factor", 100);
  set("max_gin", 8000);
  set("max_kee", 10000);
  set("max_sen", 8000);
  set("max_atman", 2500);
  set("max_force", 2500);
  set("force_factor", 100);
  set("force", 5000);
  set("mana", 5000);
  set("warexp", 70);
  set("long",
    "他就是道教中數一數二的智慧家及武功\高手，就算是和道觀中的師兄較量，
他也拿到了當世道君盃易經錦標賽的前三名，實在是一個不可多得的人才。\n");
  set_skill("sword", 100);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("force", 120);
  set_skill("spells", 155);
  set_skill("taoism", 100);
  set_skill("sky-ground-force", 120);
  set_skill("necromancy", 155);
  set_skill("tao-steps", 100);
  set_skill("wo-che-sword", 100);

  map_skill("parry", "wo-che-sword");
  map_skill("force", "sky-ground-force");
  map_skill("sword", "wo-che-sword");
  map_skill("dodge", "tao-steps");
  map_skill("spells", "necromancy");
  set_temp("apply/dodge", 150);
  set_temp("apply/sword", 150);
  set_temp("apply/damage", 150);
  set_temp("apply/armor", 150);

  set("combat_exp", 500000);
  set("chat_chance", 20);
  set("chat_msg", ({
    CYN "郭逸俠手按劍柄，紋風不動，一副不怒而威的模樣。\n" NOR,
    CYN "郭逸俠雙目如電，注視著你的一舉一動。\n" NOR,
    (: command, "hmm" :),
  }));
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: cast_spell, "thunder" :),
    (: cast_spell, "power" :),
    (: command, "exert recover" :),
    (: command, "exert regenerate" :),
    (: command, "exert refresh" :),
    (: command, "exert armor" :),
    (: command, "exert powerup" :),
    (: perform_action, "sword.sky-ground-root" :),
  }));
  set("inquiry", ([
    "玄真君": "他經常不在道教的, 聽說在離愁谷..但不知道在那? ?...",
    "道尊": "你問咱們祖師爺呀﹖聽說他老人家去閉關了, 不要打擾他喔..",
    "青陽子": "你找他做什麼??  你還是請回吧!.....",
    "黑暗道": "那是很可怕的地方...我勸你還是不要去的好!....",
    "道院": "它在道教後山吧..自己去找找我可忙的很.....",
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/boots")->wear();
  carry_object(__DIR__ "obj/hat")->wear();
  carry_object(__DIR__ "obj/sword31")->wield();
  add_money("gold", 2);
}
