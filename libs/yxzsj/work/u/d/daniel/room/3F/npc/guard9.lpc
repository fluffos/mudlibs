#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIM "步驚雲" NOR, ({ "taoist kenth", "kenth", "taoist" }));
  set("race", "人類");
  set("gender", "男性");
  set("title", HIC "道教護衛" HIW "-" HIC "玉" NOR + HIY "清" NOR + HIM "元" NOR + HIG "始" NOR
    +HIW "天尊" NOR);
  create_family("道教", 2, "弟子");
  set("nickname", HIR "愛哭死神" NOR);
  set("class", "taoist");
  set("age", 22);
  set("con", 30);
  set("str", 29);
  set("max_mana", 2500);
  set("mana_factor", 100);
  set("max_gin", 8000);
  set("max_kee", 10000);
  set("max_sen", 8000);
  set("max_atman", 2500);
  set("max_force", 2500);
  set("force_factor", 100);
  set("force", 5000);
  set("mana", 5000);
  set("warexp", 70);
  set("long",
    "步家村出世，父母病亡也不下一滴淚\而被喻為不哭死神。繼父霍步天被雄霸滅門，
遂投身天下會等待機會報仇。為殺雄霸，左臂被廢，幸得于嶽傳他麒麟臂。
為救聶風脫離魔道，曾墮下萬丈懸崖而失憶。與帝釋天對抗時，曾服下龍元以保性命。
為殺斷浪，更服下逆乾坤，死而復生後，一頭白髮。\n");
  set_skill("sword", 110);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("force", 120);
  set_skill("spells", 165);
  set_skill("taoism", 100);
  set_skill("sky-ground-force", 120);
  set_skill("necromancy", 165);
  set_skill("tao-steps", 100);
  set_skill("wo-che-sword", 110);

  map_skill("parry", "wo-che-sword");
  map_skill("force", "sky-ground-force");
  map_skill("sword", "wo-che-sword");
  map_skill("dodge", "tao-steps");
  map_skill("spells", "necromancy");
  set_temp("apply/dodge", 200);
  set_temp("apply/sword", 200);
  set_temp("apply/damage", 200);
  set_temp("apply/armor", 200);

  set("combat_exp", 500000);
  set("chat_chance", 20);
  set("chat_msg", ({
    CYN "步驚雲手按劍柄，紋風不動，一副不怒而威的模樣。\n" NOR,
    CYN "步驚雲雙目如電，注視著你的一舉一動。\n" NOR,
    (: command, "hmm" :),
  }));
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: cast_spell, "thunder" :),
    (: cast_spell, "power" :),
    (: command, "exert recover" :),
    (: command, "exert regenerate" :),
    (: command, "exert refresh" :),
    (: command, "exert armor" :),
    (: command, "exert powerup" :),
    (: perform_action, "sword.sky-ground-root" :),
  }));
  set("inquiry", ([
    "玄真君": "他經常不在道教的, 聽說在離愁谷..但不知道在那? ?...",
    "道尊": "你問咱們祖師爺呀﹖聽說他老人家去閉關了, 不要打擾他喔..",
    "青陽子": "你找他做什麼??  你還是請回吧!.....",
    "黑暗道": "那是很可怕的地方...我勸你還是不要去的好!....",
    "道院": "它在道教後山吧..自己去找找我可忙的很.....",
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/boots")->wear();
  carry_object(__DIR__ "obj/hat")->wear();
  carry_object(__DIR__ "obj/sword34")->wield();
  add_money("gold", 2);
}
