#include <weapon.h>

#include <ansi.h>
 
inherit SWORD;
 
void create()
{
        set_name("婉"HIC""NOR+CYN"糃"NOR, ({ "ice sword", "ice", "sword" }) );
        set_weight(7000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "р");
                set("long", "硂琌рノㄓ婉糃\n");
                set("value", 400);
                set("material", "steel");
		    set("no_get", 1);
                set("wield_msg", "$N詜羘┾р$n搐もい\n");
                set("unwield_msg", "$N盢もい$n础竬丁糃繲\n");
        }
        init_sword(20);
        setup();
}
