#include <weapon.h>

#include <ansi.h>

inherit SWORD;

void create() {
  set_name("剉" HIC "冰" NOR + CYN "劍" NOR, ({ "ice sword", "ice", "sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "這是一把用來剉冰的劍。\n");
    set("value", 400);
    set("material", "steel");
    set("no_get", 1);
    set("wield_msg", "$N「唰」地一聲抽出一把$n握在手中。\n");
    set("unwield_msg", "$N將手中的$n插入腰間的劍鞘。\n");
  }
  init_sword(20);
  setup();
}
