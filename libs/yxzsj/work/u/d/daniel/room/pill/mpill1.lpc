inherit COMBINED_ITEM;
#include <ansi.h>
void create() {
  set_name(HIG "玉洞" HIY "元" HIM "神丹" NOR, ({ "mana pill", "mana", "pill" }));
  set("long", "這是一粒能恢復法力的神奇藥丸。\n");
  set("value", 20000);
  set("unit", "粒");
  set("base_unit", "粒");
  set("base_weight", 100);
  set_amount(1);
  setup();
}
void init() {
  add_action("do_eat", "eat");
}
int do_eat(string arg) {
  int kee, gin, sen;
  object ob, me = this_player();
  if (me->query_temp("block_msg/all"))
    return notify_fail("暈倒了還想吃藥?\n");
  if (me->is_busy()) return notify_fail("你現在沒有空吃這個﹗\n");
  if (!arg) return notify_fail("你要吃什麼?\n");
  arg = lower_case(arg);
  if (!ob = present(arg, me)) return notify_fail("你身上沒這東西﹗\n");
  if (ob != this_object()) return 0;
  me->start_busy(1);
  message_vision("$N拿起一粒" HIG "玉洞" HIY "元" HIM "神丹" NOR "放入口中。\n", me);
  write("你覺得一股暖意從四肢浸淫了出來，全身舒暢無比。\n");
  if ((me->query("mana") + me->query("max_mana") / 5) >= me->query("max_mana") * 2)
    me->set("mana", me->query("max_mana") * 2);
  else me->add("mana", me->query("max_mana") / 5);
  add_amount(-1);
  return 1;
}
