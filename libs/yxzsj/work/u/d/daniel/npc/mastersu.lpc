// mastersu.c

inherit NPC;

#include <ansi.h>

int bullets();

void create()
{
	set_name("素還真", ({ "Master su", "Master", "master", "master su", "su", "Su"}));
	set("nickname", HIC"清香"NOR"白蓮");
	set("title", HIC"琉璃仙境-"HIR"日"HIY"才子"NOR);
	set("gender", "男性");
	set("age", 210);
	set("attitude", "peaceful");
	set("long",
		"他便是武林上人稱清香白蓮的素還真，智慧高深而富計謀。\n"
		"他是中原武林的領導者，正道的棟樑，這數十年來一直始終如一。\n"
		"聽說他在三歲時便已出道，驚動武林，歸隱兩百年後又再復出。\n"
		"其實，他也有另外一面，如做事常為自己的利益著想。\n"
		"他做事從不與人硬碰硬，總是以高超的計謀解決事情。\n"
		"武林中有傳言說他的若干好友都是被他所犧牲，不知他個性到底如何。\n"
		"他的師父是八指麒麟。\n"
		"他的妻子是風采玲。\n"
	);

	set("combat_exp", 1000000);
	set("score", 10000000);
	set("rank_info/respect", "素賢人");
	set("class", "taoist");
	set("max_kee", 10000);

	set("str", 40);
	set("int", 70);
	set("cor", 30);
	set("cps", 70);
	set("spi", 70);
	set("con", 70);
	set("kar", 40);
	set("per", 50);

        set("chat_chance", 5);
	set("chat_msg", ({
		"素還真說：請問找劣者有甚麼事嗎？\n",
		"素還真凝立不動，似乎正在思考著事情。\n",
	}));

	set("force", 5000);
	set("max_force", 5000);
	set("force_factor", 200);

	set("atman", 5000);
	set("max_atman", 5000);

	set("mana", 5000);
	set("max_mana", 5000);
	set("mana_factor", 400);

	set("inquiry", ([
		"幫忙": "劣者恐怕無法為力。",
		"歡喜佛": (: command("emote 深深的嘆了一口氣。"), command("say 可憐的歡喜佛，可憐呀～～～") :),
		"素續緣": "續緣吾兒，為父好想和你長久相處啊！",
		"一線生": "他是我的好友，為我做了許\多事，也善機關巧計。",
		"石腦": "它便在琉璃仙境的一個洞穴裡，你可以去看看。",
		"風采鈴": "想當年風采鈴為江南第一才女，唉...素某虧欠她太多了。",
	]) );

	set("marks/九思劍法", 2);

	set("chat_chance_combat", 150);
	set("chat_msg_combat", ({
		(: call_out("fight_check", 0) :),
		(: bullets :),
		(: command("cast astral_vision") :),
		(: command("exert recover") :),
	}) );

	create_family("琉璃仙境", 1, "日才子");

	set_skill("literate", 250);
	set_skill("magic", 200);
	set_skill("force", 200);
	set_skill("spells", 200);
	set_skill("unarmed", 250);
	set_skill("parry", 150);
	set_skill("dodge", 150);
	set_skill("move", 150);
	set_skill("sword", 200);

	set_skill("buddhism", 150);
	set_skill("taoism", 150);
	set_skill("necromancy", 200);
	set_skill("sky-ground-force", 200);
	set_skill("wo-che-sword", 200);
	set_skill("nine-sword", 200);

	map_skill("spells", "necromancy");
	map_skill("force", "sky-ground-force");
	map_skill("sword", "nine-sword");
	
	setup();

	carry_object(__DIR__"obj/blkrobe")->wear();
	carry_object(__DIR__"obj/lotushat")->wear();
	carry_object(__DIR__"obj/whisk")->wear();
	carry_object(__DIR__"obj/purplesw");
	carry_object("/u/g/guo/temp/test");

	add_money("gold", 30);

    set("default_actions", (: call_other, __FILE__,"query_action" :));
    reset_action();

}

void can_speak_poetry()
{
	delete("speaking_poetry");
}

void speak_poetry()
{
	if ( !query("speaking_poetry") ) {
		message_vision("\n",this_object());
		command("say 半神半聖亦半仙，");
		command("say 全儒全道是全賢。");
		command("say 腦中真書藏萬卷，");
		command("say 掌握文武半邊天。");
		set("speaking_poetry", 1);
		call_out("can_speak_poetry", 5); }
}

void init()
{
	::init();
	call_out("speak_poetry", 0);
}

int attempt_apprentice(object ob)
{
	command("say 不敢當，劣者如何能做"+this_player()->query("name")+"的師父？。");
	return 0;
}

int accept_fight(object me)
{
	command("say 劣者如何是"+this_player()->query("name")+"的對手？");
	return 0;
}

int fight_check()
{
	int max_kee, kee;
	max_kee = this_object()->query("max_kee");
	kee = this_object()->query("kee");
	if ( ( kee < max_kee * 0.4 ) && ( this_object()->query_temp("flag") != 1 ) ) {
		message_vision("\n", this_object());
		command("wield sword");
		message_vision("\n", this_object());
		message_vision("素還真長嘯道：\n"HIR"日為陽，"HIY"月為陰，"HIR"日"HIY"月"HIC"合璧誅百邪，"HIY"陰"HIR"陽"HIM"調配滅千魔\n\n"NOR, this_object());
		this_object()->set_temp("flag", 1);
		return 1; }
	return 1;
}

int accept_object(object me, object obj)
{
	command("say 感謝"+RANK_D->query_respect(me)+"送我這"+obj->query("unit")+obj->query("name")+"。");
	command("bow "+me->query("id"));
	obj->move(this_object());
	return 1;
}
mapping *unarmed_msg = ({
	([	"action":		"$N運起全身功\力，使出『"HIY"石破天驚混元掌"NOR"』，只見$N的兩手微合，運氣於之間。\n$N忽然兩手分合，由真氣發出一道宏大無比的氣功\，排山倒海的向$n而去",
		"damage":		150,
		"damage_type":	"瘀傷"
	]),
	([	"action":		"$N運起體內千年龍氣，使出『"HIG"龍氣劍"NOR"』，化為一把閃爍的氣劍直直的向$n飛去",
		"damage":		130,
		"damage_type":	"瘀傷"
	]),
	([	"action":		"$N大喝一聲，發出極招『"HIY"風雷神擊"NOR"』，破空向$n發出一道無堅不催的強大氣勁",
		"damage":		70,
		"damage_type":	"瘀傷"
	]),
	([	"action":		"$N流轉真氣，使出『"HIR"托天真陽"NOR"』，發出一道渾厚的陽剛之氣向$n的$l飛去",
		"damage":		60,
		"damage_type":	"瘀傷"
	]),
	([	"action":		"$N倒轉行氣，用出至寒絕招『"HIC"百氣寒霜指"NOR"』﹐一股冷冽的勁風快速的撲向$n",
		"damage":		100,
		"damage_type":	"瘀傷"
	]),
	([	"action":		"$N使出太黃君成名絕技『"HIM"波幻迷掌"NOR"』，發出一道變幻莫測的氣功\向$n的$l襲去",
		"damage":		80,
		"damage_type":	"瘀傷"
	]),
	([	"action":		"$N筋脈充滿真氣，使出『"HIR"昊陽震宇"NOR"』發出一道震撼天地的氣功\向$n飛去",
		"damage":		80,
		"damage_type":	"瘀傷"
	]),
	([	"action":		"$N長嘆一聲，使出佛家絕技『"HIG"苦海無涯"NOR"』向$n的$l發出一陣強大的震盪氣流",
		"damage":		90,
		"damage_type":	"瘀傷"
	]),
});

string *dodge_msg = ({
	"$p手腕一分，使出了「"HIG"七巧如意手"NOR"」，拆招擋格，將$N的攻擊化為無形。\n",
	"$p體內真氣運轉，運足功\力，使出了絕技「"HIY"九州生氣峙風雷"NOR"」！\n"
	"只見$p面前出現了一層真氣的障壁，使$N的攻擊盡數被吸納入內。\n",
	"$p身形一變，使出「"HIY"七星踩雲步"NOR"」，身法運行北斗七星方位，輕易避過了$N的攻擊。\n",
	"$p身形一轉，使出「"HIM"八卦迷蹤步"NOR"」，腳中踩踏八卦方位，輕巧的閃過了$N的攻擊。\n",
	"$p身法一快，使出「"HIC"分行化影"NOR"」，立即化為數個身影，使$N的攻擊落為虛有。\n",
});
mapping query_action()
{
	return unarmed_msg[random(sizeof(unarmed_msg))];
}

string query_dodge_msg(object weapon)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int doit(string cmd)
{
	command(cmd);
	return 1;
}
int bullets()
{
	int targetnum, i, dp, fp, pp, choice, damage, add, lv;
	object target, *ob, tempobj, me;
	string t, temp;
	mapping skl;

	me = this_object();

	if( !me->is_fighting() )
		return notify_fail(HIR"『"HIY"玄"HIC"子神"HIY"功\"HIR"』"NOR"只能在戰鬥中使用！\n");
	if( me->query_temp("perform_delay") )
		return notify_fail(HIR"你欲使出"HIY"玄"HIC"子神"HIY"功\"HIR"，但是覺得力不從心，無法提起真氣！\n"NOR);

	skl = me->query_skills();

	message_vision(
HIM"\n$N忽然立定原地不動，以巧妙的分法運起全身內勁，在經脈中分合流轉。"NOR"
"HIY"待全身的真氣聚於手上，$N大喝一聲，縱躍於空中，使出"HIR"『"HIC"玄子神功\"HIR"』"HIY"！"NOR"
"HIG"只見$N在空中，雙手連揮出，向四面八方發出千百道氣勁！！\n\n"NOR
, me );

	ob = all_inventory(environment(me));
	for(i=0; i<sizeof(ob); i++) {
		if( me->is_fighting(ob[i]) ) targetnum++; }

	for(i=0; i<sizeof(ob); i++)
	{
	if ( !me->is_fighting(ob[i]) ) continue;
	target = ob[i];
	t = ob[i]->query("name");
	fp = target->query_skill("force") / 2 - 35;
	if (fp > 100) fp = 100;
	dp = target->query_skill("dodge") / 2 - 35;
	if (dp > 100) dp = 100;
	pp = target->query_skill("parry") / 2 - 35;
	if (pp > 100) pp = 100;
	if (random(fp) > 50) choice = 3;
	else choice = 4;
	if (random(dp) > 50) choice = 2;
	if (random(pp) > 50) choice = 1;
	add = (me->query_skill("force")*0.6-33);
	if (add > 100) add = 100;

	message_vision(
HIC"空中有"+CHINESE_D->chinese_number((int)(3000/targetnum))+
"道氣勁，朝著"+t+"，如暴雨般急速飛去！\n"NOR
	, this_player() );
	if (choice == 1) {
damage = 3000/targetnum/10+(3000/targetnum*0.15)*0.5+(pp-50)*2*3000/targetnum/10/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		tempobj = target->query_temp("weapon");
		if (tempobj) temp = tempobj->query("name");
		else temp = "雙手";
		target->receive_damage("kee", damage, me);
		if (damage > 0) message_vision(
HIG+t+"見到氣勁飛來，看準方位，揚起"+temp+HIG+"運轉如飛，接下了大部分的攻擊。"NOR"
"HIR"但仍有一些氣勁打中了"+t+"，造成些許\的傷害。"NOR" ( "+HIR+damage+NOR+" )\n"
		, me ); }

	if (choice == 2) {
damage = 3000/targetnum/20+(3000/targetnum*0.3)*0.5-(dp-50)*2*3000/targetnum*0.15/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		skl = me->query_skill_map();
		temp = to_chinese(skl["dodge"]);
		if (temp == "白蓮武功\") temp = "八卦迷蹤步";
		if (!temp) temp = to_chinese("dodge");
		target->receive_damage("kee", damage, me);
		message_vision(
HIC+t+"見到氣勁急遽飛至，身形一轉使出"+temp+"，在其中穿梭閃避。"NOR"
"HIR"但仍有一些氣勁打中了"+t+"，造成些許\的傷害。"NOR" ( "+HIR+damage+NOR+" )\n"
	, me ); }

	if (choice == 3) {
damage = 3000/targetnum/2.5+(3000/targetnum*0.4)*0.5-(fp-50)*2*3000/targetnum/5/100;
		damage *= add/100;
		if (damage < 0) damage = random(200);
		target->receive_damage("kee", damage, me);
		target->receive_wound("kee", damage/5, me);
		message_vision(
HIM+t+"見情況不妙，但已無法避開，只得運起全身內力硬擋。"NOR"
"HIR"氣勁紛紛擊中"+t+"，"+t+"悶哼數聲，「哇」的一聲吐出一口鮮血。"NOR" ( "+HIR+damage+NOR+" )\n"
		, me ); }

	if (choice == 4) {
damage = 3000/targetnum*3/4+(3000/targetnum/4)*0.5;
		damage = (damage*add)/100;
		if (damage < 0) damage = random(200);
		target->receive_damage("kee", damage, me);
		target->receive_wound("kee", damage/2, me);
		message_vision(
HIY+t+"見狀大驚失色，想避開但已遲了一步，氣勁盡數擊中"+t+NOR"
"HIR+t+"連聲慘叫，全身被氣勁打的皮開肉綻！"NOR" ( "+HIR+damage+NOR+" )\n"NOR
		, me ); }
	COMBAT_D->report_status(target);
	message_vision("\n", me);
	}
	me->set("force", me->query("force") - 300);
	me->start_busy(3);
	return 1;
}

int forceb(string cmd)
{
	command(cmd);
}