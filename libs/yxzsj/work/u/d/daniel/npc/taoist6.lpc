#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("青陽子", ({ "chin yang", "chin", "yang" }));
  set("long", @LONG
    他是前合修會的領導人﹐後因被素還真感動而為三教盡心盡力﹐甚至在
素還真被無極殿毒殺時還率領大軍欲為素還真報仇。雖然最後慘敗而回﹐卻  
深深突顯了其至情至性一面。
LONG);
  set("title", HIY "道教" NOR "-" HIW "玄天六陽" NOR);
  set("attitude", "peaceful");
  set("class", "taoist");
  set("nickname", HIG "龍腦" NOR);
  set("str", 70);
  set("int", 40);
  set("combat_exp", 1600000);
  set("max_kee", 9500);
  set("max_sen", 7500);
  set("max_gin", 7500);
  set("max_atman", 2800);
  set("atman", 4800);
  set("max_force", 6500);
  set("force", 13000);
  set("force_factor", 150);
  set("mana", 13000);
  set("max_mana", 6500);
  set("mana_factor", 160);
  set("warexp", 200);
  set("marks/素還真", 1);
  set_skill("unarmed", 150);
  set_skill("parry", 160);
  set_skill("dodge", 160);
  set_skill("force", 150);
  set_skill("spells", 150);
  set_skill("wo-che-unarm", 150);
  set_skill("sky-ground-force", 150);
  set_skill("necromancy", 150);
  set_skill("tao-steps", 160);
  set_skill("magic", 110);
  set_skill("move", 200);
  set_skill("taoism", 110);
  map_skill("magic", "taoism");
  map_skill("unarmed", "wo-che-unarm");
  map_skill("parry", "wo-che-unarm");
  map_skill("dodge", "tao-steps");
  map_skill("move", "tao-steps");
  map_skill("force", "sky-ground-force");
  map_skill("spells", "necromancy");
  set_temp("apply/armor", 220);
  set_temp("apply/dodge", 220);
  set_temp("apply/damage", 220);
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: command, "exert recover" :),  //這要加
    (: command, "exert regenerate" :),
    (: command, "exert refresh" :),
    (: command, "exert armor" :),
    (: command, "exert powerup" :),
    (: perform_action, "unarmed.super" :),
    (: cast_spell, "power" :),
    (: cast_spell, "netherbolt" :),
  }));
  set("chat_chance", 5);
  set("chat_msg", ({
    (: command, "emote 喃喃說道 : 不要亂來... " :),
  }));
  setup();
  carry_object(__DIR__ "obj/fan1")->wear();
  carry_object(__DIR__ "obj/hat1")->wear();
  carry_object(__DIR__ "obj/shoes1")->wear();
  carry_object(__DIR__ "obj/robe1")->wear();
  carry_object(__DIR__ "obj/waist1")->wear();
  add_money("silver", 80);
  set("default_actions", (: call_other, __FILE__, "query_action" :));
  reset_action();

}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
}
void heart_beat() {
  if (this_object()->query("gin") < this_object()->query("max_gin") / 2)
    command("exert regenerate");
  if (this_object()->query("kee") < this_object()->query("max_kee") / 2)
    command("exert recover");
  if (this_object()->query("sen") < this_object()->query("max_sen") / 2)
    command("exert refresh");
  ::heart_beat();
}
void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  command("smirk " + ob->query("id"));
  command("say 道臨天下化萬物﹐");
  command("say 佛慈照世渡眾生﹐");
  command("say 儒暉千古傳薪火﹐");
  command("say 三教同心天地行。");
  message_vision(CYN "青陽子很有自信地大笑了幾聲。\n" NOR, ob);
}
void die() {
  object winner = query_temp("last_damage_from");
  if (winner) {
    if (winner->query("marks/煉丹術") == 3)
      winner->set("marks/煉丹術", 4);
  }
  ::die();
}
//    青陽子回到天地門，但天地門內突然發生異變，青陽子被爪狀巨
//岩帶入地底。青陽子在地底走動，發現過去龍涎宮的遺址，並在宮中
//尋獲一本千里神彈琴譜。青陽子取來琴，照譜彈奏，沒想到不彈則已
//，一彈風雲起，龍涎宮隨之崩塌。這是青陽子初次使用【千里神彈】
//這部功夫。〈霹靂英雄榜３７〉

//●【千里神彈】乃是曾任龍涎宮之主九天龍王身旁軍師一職的千里神
//  彈龍君行的得意絕技。在龍涎宮沈入地底多年後，被無意間進入龍
//  涎宮遺址的青陽子所得。
