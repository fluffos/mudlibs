#include <ansi.h>

inherit NPC;

void do_roar();

void do_groundc();

void create() {
  int raneq;
  set_name(HIR "血龍" NOR, ({ "blood dragon", "dragon", "blood" }));
  set("long", "牠是一隻全身赤紅的野獸，正在地上虎視眈眈的蹲伏著，一雙眼睛還不時射出紅色的光芒。
");
  set("combat_exp", 1000000);
  set("class", "red-sword");
  set("roar_msg", "血龍");
  set("max_kee", 30000);
  set("max_sen", 20000);
  set("max_gin", 20000);
  set("warexp", 300);
  set("A", 1);
  set("force", 10000);
  set("max_force", 5000);
  set("force_factor", 150);
  set_temp("apply/attack", 700);
  set_temp("apply/dodge", 500);
  set_temp("apply/claw", 700);
  set_temp("apply/parry", 500);
  set_skill("force", 250);
  set_skill("mag-force", 250);
  map_skill("force", "mag-force");
  set("pursuer", 1);
  set("age", 500);
  set("str", 90);
  set("con", 70);
  set("cor", 40);
  set("rick", "野獸");
  set("gender", "雄性");
  set("chat_chance", 10);
  set("chat_msg", ({
    (: command("yawn") :),
    (: command("roll") :),
    (: command("emote 發出可怕的叫聲。") :),
  }));
  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: do_groundc :),
    (: command, "exert recover" :),
    (: do_roar :),
  }));

  raneq = random(11);
  raneq++;

  setup();

  carry_object(__DIR__ "obj/blood-claw")->wield();

  switch (raneq) {
    case 1:
      carry_object(__DIR__ "obj/blood-armor")->wear();
      break;
    case 2:
      carry_object(__DIR__ "obj/blood-cloth")->wear();
      break;
    case 3:
      carry_object(__DIR__ "obj/blood-hands")->wear();
      break;
    case 4:
      carry_object(__DIR__ "obj/blood-hat")->wear();
      break;
    case 5:
      carry_object(__DIR__ "obj/blood-locks")->wear();
      break;
    case 6:
      carry_object(__DIR__ "obj/blood-neck")->wear();
      break;
    case 7:
      carry_object(__DIR__ "obj/blood-ring")->wear();
      break;
    case 8:
      carry_object(__DIR__ "obj/blood-robe")->wear();
      break;
    case 9:
      carry_object(__DIR__ "obj/blood-shoes")->wear();
      break;
    case 10:
      carry_object(__DIR__ "obj/blood-waist")->wear();
      break;
  }
}

void die() {
  object who;

  if (!who = query_temp("last_damage_from")) who = this_player(1);
  tell_room(environment(this_object()), WHT "\n\n突然冒起一陣煙飄往" + who->name() + "的天靈～～\n\n" + NOR);
  tell_object(who, "\n\n你從殺死龍獸中領誤到了一些武術的道理。\n");
  if (who->query("combat_exp") > 100000)
    who->add("combat_exp", 300 + random(200));
  who->add("bellicosity", 200);
  who->set_temp("kill_blood3", 1);
  if (who->query_temp("kill_blood1") && who->query_temp("kill_blood2") && who->query_temp("kill_blood3"))
    who->set("marks/血龍謎", 1);
  ::die();
}
void do_roar() {
  delete("A");
}
void re_roar() {
  set("A", 1);
}
void do_groundc() {
  object ob, *enemy;
  int damage, i;

  enemy = query_enemy();
  for (i = 0; i < sizeof(enemy); i++) {
    if (!userp(enemy[i])) continue;
    damage = enemy[i]->query("max_kee") * 0.2 + random(enemy[i]->query("max_kee") / 10);
    message_vision(
      "$N突然發出一招﹐「" HIR "腥風血雨" NOR "」以極快的速度往$n發出可怕的攻擊！ (" + HIR + damage + NOR + ")\n",
      this_object(),
      enemy[i]
    );
    enemy[i]->add("kee", -damage, this_object());
    enemy[i]->add("eff_kee", -damage / 2, this_object());
    enemy[i]->add("eff_sen", -(random(200) + 100), this_object());
    COMBAT_D->report_status(enemy[i]);
  }
}
int receive_damage(string kind, int damage, object ob) {
  if (query("A")) damage = damage / 3;
  return ::receive_damage(kind, damage, ob);
}
int receive_wound(string kind, int damage, object ob) {
  if (query("A")) damage = damage / 3;
  return ::receive_wound(kind, damage, ob);
}
