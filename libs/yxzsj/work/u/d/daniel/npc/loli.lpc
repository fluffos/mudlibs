#include <ansi.h>
inherit F_PET;
void check_level() {
  object ob, owner;
  message_vision("$N變的強壯多了。\n", this_object());
  if (owner = query("mount_ob")) dismount();
  seteuid(getuid());
  ob = new(__DIR__ "horse" + random(3));
  if (owner) {
    ob->mount(owner);
    ob->set("pet_data/master_id", owner->query("id"));
    ob->set("pet_data/master_name", owner->name(1));
  } else {
    ob->move(environment(this_object()));
  }
  destruct(this_object());
}
void create() {
  set_name(HIG "可愛的" HIY "小" HIM "女生" NOR, ({ "cute girl", "cute", "girl" }));
  set("pet_data", ([
    "max_level": 15,
    "level": 1,
    "loyal": 1000,
    "wild": 0,
    "move": 2,
    "advmove": 5000,
    "train_max": 100,
    "train": 0,
    "master_id": "None",
    "can_mount": 1,
    "kind": 1,
    "riding": 1,
    "combat_exp": 2000,
  ]));
  set("value", 5000);
  set("buy_move_to_room", 1);
  set("str", 30);
  set("food", max_food_capacity());
  set("water", max_water_capacity());
  set("unit", "個");
  set("no_sell", 1);
  set("race", "人類");
  set("gender", "女性");
  set("age", 1);
  set("level_up", (: check_level :));
  setup();
}
