// mastersu.c

inherit NPC;
inherit F_MASTER;
inherit SSERVER;

#include <ansi.h>

int bullets();

void create()
{
	set_name(HIG"礮臸"NOR, ({ "chin mo", "chin", "mo"}));
	set("nickname", HIY"膎"HIR"﹀"NOR);
	set("title", HIR"臸⌒"HIM"ぱ臸魁"NOR);
	set("gender", "╧┦");
	set("age", 150);
	set("attitude", "peaceful");

	seteuid(ROOT_UID);
	set("combat_exp", 1000000);
	set("score", 10000000);
	set("class", "taoist");
	set("max_kee", 10000);
	set("max_gin", 10000);
	set("max_sen", 10000);

	set("str", 40);
	set("int", 70);
	set("cor", 30);
	set("cps", 70);
	set("spi", 70);
	set("con", 70);
	set("kar", 40);
	set("per", 50);

	set("force", 5000);
	set("max_force", 5000);
	set("force_factor", 200);

	set("atman", 5000);
	set("max_atman", 5000);

	set("mana", 5000);
	set("max_mana", 5000);
	set("mana_factor", 400);

	set("chat_chance_combat", 150);
	set("chat_msg_combat", ({
		(: command("exert recover") :),
	}) );

	set_skill("literate", 250);
	set_skill("magic", 200);
	set_skill("force", 200);
	set_skill("spells", 200);
	set_skill("unarmed", 250);
	set_skill("parry", 150);
	set_skill("dodge", 150);
	set_skill("move", 150);
	set_skill("archery", 200);
	set_skill("sword", 200);

	set_skill("buddhism", 150);
	set_skill("taoism", 150);
	set_skill("necromancy", 200);
	set_skill("sky-ground-force", 200);
	set_skill("wo-che-sword", 200);

	map_skill("spells", "necromancy");
	map_skill("force", "sky-ground-force");
	map_skill("sword", "wo-che-sword");
	
	setup();

	carry_object("/u/g/guo/obj/blkrobe")->wear();
	carry_object("/u/g/guo/obj/lotushat")->wear();
	carry_object("/u/g/guo/obj/purplesw");
	carry_object("/u/g/guo/obj/chin");

	add_money("gold", 30);

    set("default_actions", (: call_other, __FILE__,"query_action" :));
    reset_action();

}

int attempt_apprentice(object ob)
{
	command("say ぃ幢讽︙暗"+this_player()->query("name")+"畍");
	return 0;
}

int accept_fight(object me)
{
	command("say ︙琌"+this_player()->query("name")+"癸も");
	return 0;
}

int accept_object(object me, object obj)
{
	command("say 稰谅"+RANK_D->query_respect(me)+"癳и硂"+obj->query("unit")+obj->query("name")+"");
	command("bow "+me->query("id"));
	obj->move(this_object());
	return 1;
}
mapping *unarmed_msg = ({
	([	"action":		"$N耻羘祇伐┷"HIR"﹀膎"NOR"瘆$n祇笵礚绊ぃ妒眏玪",
		"damage":		70,
		"damage_type":	"凤端"
	]),
	([	"action":		"$N瑈锣痷ㄏ"HIR"膎﹀"NOR"祇笵待玴瘆礮$n$l",
		"damage":		60,
		"damage_type":	"凤端"
	]),
});

mapping query_action()
{
	return unarmed_msg[random(sizeof(unarmed_msg))];
}

int doit(string cmd)
{
	command(cmd);
	return 1;
}

int forceb(string cmd)
{
	command(cmd);
}