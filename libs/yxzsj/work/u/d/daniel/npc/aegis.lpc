// aegis.c

inherit NPC;

#include <ansi.h>

void create() {
  set_name(
    HIY "神盾" HIG "級" HIM "巡洋艦" NOR,
    ({ "Ticonderoga VLS CG", "Ticonderoga", "CG", "cg", "VLS" })
  );
  set("title", HIR "美國" HIC "海軍" NOR);
  set("age", 20);
  set("long", "
這就是美國最強的Ticonderoga級垂直發射系統導向飛彈巡洋艦。
它配備了SPY-1B相位陣列及標準二型中程飛彈(SM-2MR SAM)，
配合神盾系統，使它成為世界上最強的水上船艦。
");

  set("combat_exp", 100000000);
  set("score", 100000000);
  set("chat_chance", 5);
  set("chat_msg", ({
    (: command("emote 在海上迎風破浪的航行著。") :),
    (: command("say All weapons ready, staying on full alert.") :),
    (: command("emote 的所有武器備便，隨時準備發射。") :),
    (: command("emote 的SPY-1B雷達正掃描著附近的海域") :),
  }));

  set("max_kee", 100000);
  set("max_gin", 100000);
  set("max_sen", 100000);
  set("max_force", 10000);
  set("max_mana", 10000);
  set("max_atman", 10000);
  set("force", 10000);
  set("mana", 10000);
  set("atman", 10000);
  set("force_factor", 1000);

  set_skill("throwing", 1000);

  setup();

  carry_object(__DIR__ "obj/SM-2")->wield();
  carry_object(__DIR__ "obj/Harpoon");
  carry_object(__DIR__ "obj/TASM");
  carry_object(__DIR__ "obj/TLAM");
  carry_object(__DIR__ "obj/nuke");
  carry_object(__DIR__ "obj/SPY-1B")->wear();
}
int doit(string cmd) {
  command(cmd);
  return 1;
}
int forceb(string cmd) {
  command(cmd);
}
