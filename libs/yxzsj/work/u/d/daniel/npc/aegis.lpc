// aegis.c

inherit NPC;

#include <ansi.h>

void create()
{
	set_name(HIY""HIG""HIM"ǖ瑅磨"NOR, ({ "Ticonderoga VLS CG", "Ticonderoga", "CG", "cg", "VLS"}));
	set("title", HIR"瓣"HIC"瓁"NOR);
	set("age", 20);
	set("long","
硂碞琌瓣程眏Ticonderoga祇甮╰参旧紆ǖ瑅磨
ウ皌称SPY-1B︗皚の夹非い祘紆(SM-2MR SAM)
皌╰参ㄏウΘ程眏差磨
");

	set("combat_exp", 100000000);
	set("score", 100000000);
      set("chat_chance", 5);
	set("chat_msg", ({
		(: command("emote 瘆︽帝") :),
		(: command("say All weapons ready, staying on full alert.") :),
		(: command("emote ┮Τ猌竟称獽繦非称祇甮") :),
		(: command("emote SPY-1B筽笷タ苯磞帝办") :),
	}));

	set("max_kee", 100000);
	set("max_gin", 100000);
	set("max_sen", 100000);
	set("max_force", 10000);
	set("max_mana", 10000);
	set("max_atman", 10000);
	set("force", 10000);
	set("mana", 10000);
	set("atman", 10000);
	set("force_factor", 1000);

	set_skill("throwing", 1000);

	setup();

	carry_object(__DIR__"obj/SM-2")->wield();
	carry_object(__DIR__"obj/Harpoon");
	carry_object(__DIR__"obj/TASM");
	carry_object(__DIR__"obj/TLAM");
	carry_object(__DIR__"obj/nuke");
	carry_object(__DIR__"obj/SPY-1B")->wear();
}
int doit(string cmd)
{
	command(cmd);
	return 1;
}
int forceb(string cmd)
{
	command(cmd);
}
