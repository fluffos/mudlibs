// stonebrain.c

inherit NPC;

#include <ansi.h>

void create()
{
	set_name(HIY"ホ福"HIW, ({ "stone brain", "stone", "brain"}));
	set("age", 1000);
	set("long", "ホ福\n"
	);

	set("combat_exp", 10000);
	set("score", 10000);

      set("chat_chance", 5);
	set("chat_msg", ({
		(: command("say 福ぐ或璶倒и") :),
		(: command("say 福癬ㄓぃ岿") :),
		(: command("emote 超泊氟秨﹍痸") :),

	}));
	

	setup();
}

varargs int receive_damage(string type, int damage, object who)
{
	int val;

	if( damage < 0 ) error("F_DAMAGE: 端甡璽\n");
	if( type!="gin" && type!="kee" && type!="sen" )
		error("F_DAMAGE: 端甡贺摸岿粇( 琌 gin, kee, sen ㄤいぇ )\n");

	if( objectp(who) )
	{
		set_temp("last_damage_from", who);
		val = (int)who->query(type) - damage*2;
		if( val >= 0 ) who->set(type, val);
		else who->set( type, -1 );
		tell_room(environment(this_player()), HIR+"挡狦"+who->query("name")+HIR+"ю阑澈礛砆"+query("name")+HIR+"跑ㄢは紆タ阑い︑\n"NOR);
	}

	set_heart_beat(1);

	return damage;
}

varargs int receive_wound(string type, int damage, object who)
{
	int val;

	if( damage < 0 ) error("F_DAMAGE: 端甡璽\n");
	if( type!="gin" && type!="kee" && type!="sen" )
		error("F_DAMAGE: 端甡贺摸岿粇( 琌 gin, kee, sen ㄤいぇ )\n");

	if( objectp(who) )
	{
		set_temp("last_damage_from", who);
		val = (int)who->query("eff_"+type) - damage*2;
		if( val >= 0 ) who->set("eff_" + type, val);
		else {
			who->set( "eff_" + type, -1 );
			val = -1;
		}
		if( (int)who->query(type) > val ) who->set(type, val);
		tell_room(environment(this_player()), HIR+"挡狦"+who->query("name")+HIR+"ю阑澈礛砆"+query("name")+HIR+"跑ㄢは紆タ阑い︑\n"NOR);
	}

	set_heart_beat(1);

	return damage;
}

