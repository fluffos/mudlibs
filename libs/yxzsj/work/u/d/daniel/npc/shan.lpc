// shan.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_pill();
void create() {
  set_name("玄真君", ({ "shan jun", "shan", "jun" }));
  set("gender", "男性");
  set("age", 24);
  set("long", @LONG
他是道教十三道中的玄真君，看來相當年輕，其無弦神弩
據說威力無比。不少魔教人士，都死在他的神弦之下。
所以魔教人士見到他，都紛紛躲避遇到他，可見他是可怕
的人物。
LONG);

  set("attitude", "peaceful");
  create_family("道教", 1, "十三道");
  set("title", HIY "道教" NOR "-" HIW "十三道" NOR);
  set("class", "taoist");
  set("str", 26);
  set("int", 24);

  set("combat_exp", 900000);
  set("max_kee", 6000);
  set("max_sen", 5600);
  set("max_gin", 5600);
  set("atman", 5000);
  set("max_atman", 2500);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 150);
  set("mana", 5000);
  set("max_mana", 2500);
  set("mana_factor", 150);
  set("warexp", 150);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "thunder" :),
    (: cast_spell, "power" :),
    (: cast_spell, "centbody" :),
    (: command, "exert armor" :),
    (: command, "exert powerup" :),
    (: command, "perform six" :),
  }));
  set("inquiry", ([
    "煉丹術": (: ask_pill :),
  ]));
  set_skill("unarmed", 130);
  set_skill("parry", 160);
  set_skill("dodge", 150);
  set_skill("tao-steps", 160);
  set_skill("force", 160);
  set_skill("sky-ground-force", 160);
  set_skill("necromancy", 150);
  set_skill("spells", 150);
  set_skill("archery", 180);
  set_skill("god-arrow", 180);
  map_skill("parry", "god-arrow");
  map_skill("spells", "necromancy");
  map_skill("force", "sky-ground-force");
  map_skill("archery", "god-arrow");
  map_skill("dodge", "tao-steps");
  set_temp("apply/dodge", 220);
  set_temp("apply/sword", 220);
  set_temp("apply/damage", 220);
  set_temp("apply/armor", 220);

  setup();

  carry_object(__DIR__ "obj/robe_s")->wear();
  carry_object(__DIR__ "obj/shoe_s")->wear();
  carry_object(__DIR__ "obj/hat_s")->wear();
  carry_object(__DIR__ "obj/arrow_bow")->wield();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
}
void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  command("hmm " + ob->query("id"));
  command("say 半生閑隱今終止﹐");
  command("say 一步江湖無盡期。");
  command("sigh");
}
int recognize_apprentice(object me) {
  if (me->query("marks/玄真君"))
    return 1;
}
int prevent_learn(object me, string skill) {
  if (me->query("marks/玄真君") &&
    me->query("class") == "taoist")  //道教且有marks就可以學
  {
    if (skill == "god-arrow" ||
      skill == "archery")
      //只能學這兩個sk
      return 0;
  }
  return 1;
}

int accept_object(object me, object ob) {
  if (ob->query("name") == "介紹信" &&
    ob->query("give") == me) {
    command("say 既然是往世道君介紹你來的，我就把無絃神弩十八式(god-arrow)傳授給你吧。\n");
    command("say 但要先學基本弓術(archery)，不然沒法學我的無絃神弩武學。\n");
    me->set("marks/玄真君", 1);
    return 1;
  }
}
int ask_pill() {
  object me = this_player();

  if (me->query("marks/煉丹術") < 2) {
    command("think");
    command("say 這...再說吧");
    return 1;
  }

  if (me->query("marks/煉丹術") == 2) {
    command("hmm");
    command("say $HIC$\n\n"
      "我是精研於道教的煉丹術，但是這術法為道教的不傳之密，我無法輕易傳授與你。
嗯....這樣吧，青陽子創立合修會，誅殺十三道及正派人士，實為本派之恥，
只要你能為道教清理門戶，我就將煉丹術傳授與你。\n");

    me->set("marks/煉丹術", 3);
  } else if (me->query("marks/煉丹術") == 4) {
    command("say 作的好！");
    command("say $HIC$\n\n"
      "既然你已經完成我所交代的任務，我就傳授給你煉丹術的秘訣。
由於道教的武功\法術常著重在法力的方面，道教的煉丹術自然也朝向這方面發展。
只要將正確的藥材放入煉丹爐內，在用內力予以加熱，便可作出可以補充法力
能量的玉洞元神丹，太清九頂神丹或是金華沖碧丹等的丹藥。藥材方面可以和
昊光道院裡的人參王購買，而道教的煉丹爐在太虛仙境附近，須有緣才得一見。
這就是我能告訴你的，希望你能好好加油。\n");
    me->set("marks/煉丹術", 5);
  } else
    command("say 這...再說吧");

  return 1;
}
