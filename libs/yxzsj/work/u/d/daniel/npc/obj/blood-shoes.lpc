// Edit by lulu

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(
    HIR "血" NOR + RED "龍" HIR "靴" NOR,
    ({ "blood dragon shoes", "dragon", "shoes", "blood" })
  );
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一雙上面有斑斑深色血跡和龍形花紋，有著神秘力量的長靴。\n");
    set("unit", "雙");
    set("value", 10000);
    set("armor_prop/dodge", 20);
    set("armor_prop/move", 10);
    set("armor_prop/armor", 15);
    set("armor_prop/force", 13);
    set("class", "red-sword");
  }
  set("wear_msg", HIR "$N將$n" HIR "穿在腳下，瞬間$N的身邊圍繞著一股無名的氣息。\n" NOR);
  set("unequip_msg", HIR "$N將$n" HIR "脫了下來，無名的氣息慢慢的從$N的身邊散去。\n" NOR);
  set("no_give", 1);
  set("no_drop", 1);
  setup();
}
int query_autoload() {
  if (this_player()->query("class") == "red-sword")
    return 1;
  else
    return 0;
}
