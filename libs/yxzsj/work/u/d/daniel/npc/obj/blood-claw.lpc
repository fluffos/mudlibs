#include <weapon.h>
#include <ansi.h>
inherit CLAW;
void create()
{
        set_name(HIR"﹀"NOR+RED"纒"NOR+HIR""NOR, ({
        "blood dragon claw","claw","blood","dragon" }) );
        set_weight(7000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "");

        set("long","ンΤ闯闯瞏︹﹀格㎝纒Τ帝秖\n");
                set("value", 12000);
                set("material", "?");
                set("armor_prop/armor",30);
                set("weapon_prop/strength",5);      
                set("weapon_prop/courage", 5);  
                set("weapon_prop/claw", 5);  
		    set("no_drop", 1);
		    set("no_give", 1);
        }
        init_claw(70);

        set("wear_msg", HIR"$N盢$n"HIR"も俐丁$Nō娩瞅露帝礚\n"NOR);
        set("unequip_msg", HIR"$N盢$n"HIR"叉ㄓ礚篊篊眖$Nō娩床\n"NOR);
                           
        setup();
}