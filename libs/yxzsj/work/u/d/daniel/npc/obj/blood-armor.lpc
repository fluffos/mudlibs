#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create() {
  set_name(
    HIR "血" NOR + RED "龍戰" HIR "甲" NOR,
    ({ "blood dragon armor", "dragon", "armor", "blood" })
  );
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件上面有斑斑深色血跡和龍形花紋，有著神秘力量的護甲。\n");
    set("unit", "件");
    set("meterial", "???");
    set("armor_prop/armor", 40);
    set("armor_prop/heal", 10);
    set("armor_prop/parry", 10);
    set("armor_prop/constitution", 5);
    set("armor_prop/force", 13);
    set("class", "red-sword");
  }
  set("wear_msg", HIR "$N將$n" HIR "穿在上身，瞬間$N的身邊圍繞著一股無名的氣息。\n" NOR);
  set("unequip_msg", HIR "$N將$n" HIR "脫了下來，無名的氣息慢慢的從$N的身邊散去。\n" NOR);
  set("no_drop", 1);
  set("no_give", 1);
  setup();
}
int query_autoload() {
  if (this_player()->query("class") == "red-sword")
    return 1;
  else
    return 0;
}
