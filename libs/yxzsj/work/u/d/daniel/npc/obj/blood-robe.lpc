#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create()
{
        set_name(HIR"﹀"NOR+RED"纒"HIR"滦"NOR, ({"blood dragon robe", "dragon", "robe", "blood"}));
        set_weight(3500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
	          set("long","ンΤ闯闯瞏︹﹀格㎝纒Τ帝秖︾\n");
                set("unit", "ン");
                set("value", 10000);
                set("material", "cloth");
                set("armor_type", "robe");
                set("armor_prop/armor", 15);
                set("armor_prop/spells", 20);
	          set("armor_prop/force", 13);
		    set("class", "red-sword");
       }
        set("wear_msg", HIR"$N盢$n"HIR"┸ō俐丁$Nō娩瞅露帝礚\n"NOR);
        set("unequip_msg", HIR"$N盢$n"HIR"叉ㄓ礚篊篊眖$Nō娩床\n"NOR);
	  set("no_give", 1);
	  set("no_drop", 1);
}
int query_autoload()
{
	if ( this_player()->query("class") == "red-sword" )
		return 1;
	else
		return 0;
}
