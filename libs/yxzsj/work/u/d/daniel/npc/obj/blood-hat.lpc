#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name(HIR "血" NOR + RED "龍" HIR "冠" NOR, ({ "blood dragon hat", "dragon", "hat", "blood" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "頂");
    set("long", "一頂上面有斑斑深色血跡和龍形花紋，有著神秘力量的頭冠。\n");
    set("armor_prop/armor", 10);
    set("armor_prop/spirituality", 10);
    set("armor_prop/intelligence", 10);
    set("armor_prop/force", 13);
    set("class", "red-sword");
  }
  set("wear_msg", HIR "$N將$n" HIR "戴在頭上，瞬間$N的身邊圍繞著一股無名的氣息。\n" NOR);
  set("unequip_msg", HIR "$N將$n" HIR "脫了下來，無名的氣息慢慢的從$N的身邊散去。\n" NOR);
  set("no_drop", 1);
  set("no_give", 1);
  setup();
}
int query_autoload() {
  if (this_player()->query("class") == "red-sword")
    return 1;
  else
    return 0;
}
