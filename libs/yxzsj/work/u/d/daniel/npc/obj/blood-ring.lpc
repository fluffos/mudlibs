#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
        set_name(HIR"﹀"NOR+RED"纒"HIR"з"NOR, ({"blood dragon ring", "dragon", "ring", "blood"}));
        set_weight(800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "");
                set("long","Τ闯闯瞏︹﹀格㎝纒Τ帝秖з\n");
                set("armor_prop/heal", 10);
                set("material", "???");
                set("armor_type", "ring");
                set("armor_prop/armor", 3);
                set("armor_prop/parry", 3);
                set("light/brightness",5);
	          set("armor_prop/force", 13);
		    set("class", "red-sword");
        }
        set("wear_msg", HIR"$N盢$n"HIR"拦俐丁$Nō娩瞅露帝礚\n"NOR);
        set("unequip_msg", HIR"$N盢$n"HIR"叉ㄓ礚篊篊眖$Nō娩床\n"NOR);
	  set("no_drop", 1);
	  set("no_give", 1);
}
int query_autoload()
{
	if ( this_player()->query("class") == "red-sword" )
		return 1;
	else
		return 0;
}