// SPY-1B.c

#include <armor.h>
#include <ansi.h>

inherit EQUIP;

void create()
{
	set_name(HIY"SPY-1B"HIG" 3D︗皚"HIR"筽笷"NOR, ({ "SPY-1B phrased arrays 3D radar", "SPY-1B", "radar" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "ン");
		set("value", 10000);
		set("material", "steel");
		set("armor_type", "steel");
            set("light/brightness",5);
            set_temp("resource/light",5);
            set("armor_prop/astral_vision", 1);
		set("armor_prop/armor", 10000);
		set("armor_prop/attack", 10000);
	}
}