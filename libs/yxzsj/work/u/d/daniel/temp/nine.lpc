// by guo

#include <ansi.h>
#include <skill_busy.h>

inherit SSERVER;

int perform(object me, object target)
{
		int time;
        string msg, weapon;
        object ob, tempobj;

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIY""HIG"ぱ"NOR+GRN""HIG""HIY""NOR"驹矮いㄏノ\n");
        if( me->query("force") < 300 )
                return notify_fail("ずぃ镑\n");
        if( me->query("combat_exp") < 1000000 )
                return notify_fail("竒喷ぃì,礚猭ㄏノ糃猭\n");
        if( me->query("kee") < 200 )
                return notify_fail("ō砰猵ぃぃㄏノ硂┷\n");
        if(!(ob=me->query_temp("weapon"))||(string)ob->query("skill_type")!="sword")
                return notify_fail("惠璶р糃ㄏノ\n");
        if((string)me->query_skill_mapped("sword")!="nine-sword")
                return notify_fail("Τㄏノ糃猭ㄏノ瓳\n");
        if (me->query("marks/糃猭") < 2 )
                return notify_fail("﹟ゼ弘硓糃猭痷竡礚猭ㄏ硈吏弘竡\n");
        if (me->query_skill("sword",1) < 160)
                  return notify_fail("膀セ糃猭ぃ镑蔼礚猭ㄏノ┷\n");
        if (me->query_skill("nine-sword",1) < 160)
                  return notify_fail("糃猭ぃ镑蔼礚猭ㄏノ┷\n");
        if (me->query_skill("buddhism",1) < 60)
                  return notify_fail("︱猭ぃ镑蔼礚猭ㄏノ┷\n");

        if(me->query_temp("temp/performing") && userp(me))
        {
                tell_object(me,HIR"弘筁ō砰猵ぃ璽颤τ碭翧﹀\n"NOR);
                tell_room(environment(me),HIR"ǎ"+me->name()+"羪︹礛祇フ碭翧﹀ㄓ\n"NOR,me);
                me->receive_wound("kee",random(20)+20);
                me->receive_wound("gin",random(30)+10);
                me->receive_wound("sen",random(30)+15);
                me->start_busy(2);
                return 1;
        }

        //me->set_temp("temp/performing", 1);

		tempobj = me->query_temp("weapon");
		weapon = tempobj->query("name");

        msg = HIC"\n$N"HIC"パみ┮祇鼓羘\n\n"NOR;
		msg += "              "HIC"礚"NOR+CYN"︹     "HIG"礚"NOR+GRN"饼     "HIY"礚"NOR+YEL"み     "HIM"礚"NOR+MAG"├     "HIR"礚"NOR+RED"臸"NOR" \n\n"NOR;

		msg += "                               "HIC"ぱ"HIG""HIY""HIR"\n\n"NOR;

		msg += HIC"ǎぱ丁甮笵紌┕$N"HIC"ō酚紌筁$N"HIC"ōマパ蛮泊\n"NOR;
		msg += NOR"甮┕$Nもい"+weapon+"甮㏄舊礛癬皚稬\n"NOR;
		msg += HIY"礚種い$N"HIY"钡硈祇琵$n"HIY"惫もぃのせ笵糃\n\n"NOR;
		message_vision(msg, me, target);

		message_vision(HIR"$N"HIR"眘┷"HIC"礚"NOR+CYN"︹"HIR"笹$n"HIR"磝腂羘筁$n"HIR"磝\n"NOR, me, target);
		COMBAT_D->report_status(target);
		message_vision(HIM"$N"HIM"眘┷"HIG"礚"NOR+GRN"饼"HIM"笹$n"HIM"オ磝腂羘筁$n"HIM"オ磝\n"NOR, me, target);
		COMBAT_D->report_status(target);
		message_vision(HIB"$N"HIB"眘┷"HIY"礚"NOR+YEL"み"HIB"笹$n"HIB"竲腂羘筁$n"HIB"竲\n"NOR, me, target);
		COMBAT_D->report_status(target);
		message_vision(HIG"$N"HIG"眘┷"HIM"礚"NOR+MAG"├"HIG"笹$n"HIG"オ竲腂羘筁$n"HIG"オ竲\n"NOR, me, target);
		COMBAT_D->report_status(target);
		message_vision(HIC"$N"HIC"眘┷"HIR"礚"NOR+RED"臸"HIC"笹$n"HIC"剑腂羘筁$n"HIC"剑\n"NOR, me, target);
		COMBAT_D->report_status(target);
		message_vision(HIY"$N"HIY"眘驰"HIB"礚"NOR+BLU"︱礚"HIB""HIY"糃羘$n"HIY"マ\n"NOR, me, target);
		message_vision(HIM"$n"HIM"羘糃パマτ\n"NOR, me, target);
		COMBAT_D->report_status(target);

		msg = CYN"\n$N"CYN"┛礛アキτい瞷模泊▇$n"CYN"礚種罖泊\n"NOR;
		msg += HIC"玱ぃ睲贰祇琌裕钮ǎよ肚ㄓ"HIM""HIY"酚"NOR+YEL"炊"HIY""HIM""HIC"$N"HIC"辅ぇ\n"NOR;
		msg += NOR"痚礛臘癬もい"+weapon+"抖墩τ癬い锣ㄢ伴辟$n\n"NOR;
		message_vision(msg, me, target);
		COMBAT_D->report_status(target);

		msg = HIG"\n$N祇┷もい"+weapon+HIG"礚繷ぇ墩ㄏ"HIM""HIR"︱"NOR+RED"瞷臸"HIR"防"HIM""HIG"もい"+weapon+"\n"NOR;
		msg += GRN"莉ネ㏑┕$n"GRN"福玡苝$n"GRN"竒ぃ癬硂阑砆綺计\n"NOR;
		message_vision(msg, me, target);
		COMBAT_D->report_status(target);

		msg = "\n$n临⊿辅玡$N侥$n玡驰笵"HIM""HIC""NOR+CYN"耴"HIC""HIM""NOR"弧Ч\n"NOR;
		msg += weapon+"獽砮$n甮礚计糃眖$nō忌$N蛮磝\n"NOR;
		msg += "籈崩磝糃τǎ羘$N筁$n剑\n"NOR;
		msg += "瞷$nō搬ョ︱礚臸ョ臸礚︱辣︱\n"NOR;
		msg += "$N├Ч$n繦礚┕\n"NOR;
		message_vision(msg, me, target);
		COMBAT_D->report_status(target);

		message_vision("\n$N$nō疧"HIR"("HIY"3000"HIR")"NOR"端甡\n\n"NOR, me, target);

        time = 13;
        call_out("reaction", time, me);
        return 1;
}

void reaction(object ob)
{
		if(ob)
		{
		        ob->delete_temp("temp/performing");
				tell_object(ob,HIC"谋弘篊篊ど"NOR""HIW"ㄏノ"NOR""HIM""HIG"ぱ"NOR+GRN""HIG""HIM""NOR"瓳\n"NOR);
		}
}
