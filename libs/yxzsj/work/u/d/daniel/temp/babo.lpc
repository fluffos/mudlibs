inherit COMBINED_ITEM;
int decayed;

void create() {
  set_name("八寶丸", ({ "pill" }));
  set("long",
    "這是一顆五彩斑斕的的八寶丸﹐在百藥之中甚不起眼﹐據說服用
之後可以稍微地減輕疲勞。\n");
  set("value", 1200);
  set("unit", "堆");
  set("base_unit", "粒");
  set("base_weight", 300);
  set_amount(1);
  if (clonep(this_object())) call_out("decay", 50, 1);
}
void init() {
  add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object ob, me = this_player();

  if (me->is_busy()) return notify_fail("你現在沒有空吃這個﹗\n");
  if (!arg) return notify_fail("你要吃什麼?\n");
  if (!ob = present(lower_case(arg), me)) return notify_fail("你身上沒這東西﹗\n");
  if (ob != this_object()) return 0;
  me->start_busy(1);

  // 補氣
  if ((int)me->query("max_kee") < 200) {
    me->receive_heal("kee", 200);
    me->receive_curing("kee", 200);
  } else {
    me->receive_heal("kee", (int)me->query("max_kee") / 20);
    me->receive_curing("kee", (int)me->query("max_kee") / 20);
  }

  //補內力
  if ((me->query("force") + me->query("max_force") / 5) >= me->query("max_force") * 2)
    me->set("force", me->query("max_force") * 2);
  else me->add("force", me->query("max_force") / 5);

  message_vision("$N拿起一粒藥丸放入口中。\n", me);
  write("你覺得一股精氣在你四肢百骸不停地流動著。\n");
  add_amount(-1);
  return 1;
}
void decay(int phase) {
  decayed = phase;
  switch (phase) {
    case 1:
      message_vision(query("name") + "開始腐爛了﹐發出一股難聞的味道。\n", this_player());
      set("long", "這顆藥丸顯然已經做出有一段時間了﹐正散發著一股難聞的味道。\n");
      call_out("decay", 10, phase + 1);
      break;
    case 2:
      message_vision("一陣風吹過﹐把" + query("name") + "化成灰吹散了。\n", this_player());
      destruct(this_object());
      break;
  }
}
