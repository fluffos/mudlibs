#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIW "白" HIR "鸛" HIW "術士" NOR, ({ "white shu", "white", "shu" }));
  set("race", "人類");
  set("gender", "男性");
  set("title", HIC "道觀" HIW "-" HIY "天" HIG "仙" NOR);
  create_family("道教護教使者", 9, "白鸛術士");
  set("class", "taoist");
  set("age", 22);
  set("con", 30);
  set("str", 29);
  set("max_mana", 2500);
  set("mana_factor", 100);
  set("max_gin", 3800);
  set("max_kee", 4600);
  set("max_sen", 3800);
  set("max_atman", 2500);
  set("max_force", 2500);
  set("force_factor", 100);
  set("force", 5000);
  set("mana", 5000);
  set("warexp", 50);
  set("bellicosity", 50000);

  set("long",
    "這個人看來威風凜凜令人望而生畏，身上一的肌肉糾結成群
，長得一副熊腰虎背的模樣，一看就是知道是個練家子。
他在道教裡擔任「護教使者」，專門管理道教教內大小事物及
緝拿道教內的宵小竊盜。既是如此，但是最好別輕易的與他交
手。\n");
  set_skill("sword", 100);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("force", 100);
  set_skill("spells", 100);
  set_skill("taoism", 100);
  set_skill("sky-ground-force", 100);
  set_skill("necromancy", 100);
  set_skill("tao-steps", 100);
  set_skill("wo-che-sword", 100);

  map_skill("parry", "wo-che-sword");
  map_skill("force", "sky-ground-force");
  map_skill("sword", "wo-che-sword");
  map_skill("dodge", "tao-steps");
  map_skill("spells", "necromancy");
  set_temp("apply/dodge", 120);
  set_temp("apply/sword", 120);
  set_temp("apply/damage", 120);
  set_temp("apply/armor", 120);

  set("combat_exp", 300000);
  set("chat_chance", 20);
  set("chat_msg", ({
    (: command, "say 看什麼看ㄚ~~沒看過帥哥ㄛ~~ " :),
    CYN "白鸛術衣士手按劍柄，紋風不動，一副不怒而威的模樣。\n" NOR,
    CYN "白鸛術士雙目如電，注視著你的一舉一動。\n" NOR,
    (: command, "say 近日來道教惹事的免崽子愈來愈多了,該想個辦法!" :),
    CYN "白鸛術士緩步的來回巡視著，凝精聚神的注意著任何風吹草動。\n" NOR,
    (: command, "hmm" :),
  }));
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: cast_spell, "thunder" :),
    (: cast_spell, "power" :),
    (: command, "exert recover" :),
    (: command, "exert regenerate" :),
    (: command, "exert refresh" :),
    (: command, "exert armor" :),
    (: command, "exert powerup" :),
    (: perform_action, "sword.sky-ground-root" :),
  }));
  set("inquiry", ([
    "玄真君": "他經常不在道教的, 聽說在離愁谷..但不知道在那? ?...",
    "道尊": "你問咱們祖師爺呀﹖聽說他老人家去閉關了, 不要打擾他喔..",
    "青陽子": "你找他做什麼??  你還是請回吧!.....",
    "黑暗道": "那是很可怕的地方...我勸你還是不要去的好!....",
    "道院": "它在道教後山吧..自己去找找我可忙的很.....",
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/boots")->wear();
  carry_object(__DIR__ "obj/hat")->wear();
  carry_object("obj/longsword")->wield();
  add_money("silver", 50);
}

void die() {
  object winner = query_temp("last_damage_from");
  environment(this_object())->set_temp("winner", winner);
  tell_object(users(), RED "\n啊！！！～～～\n" NOR);
  ::die();
}
