//測試特功
#include <ansi.h>
inherit ITEM;
int do_test();
void create() {
  set_name(
    HIY "神盾" HIR "武器" HIG "系統" NOR,
    ({ "Aegis weapon system", "Aegis", "aegis", "weapon", "system" })
  );
  set("unit", "個");
  seteuid(getuid());
}
void init() {
  add_action("do_t1", "t1");
  add_action("do_t2", "t2");
  add_action("do_t3", "t3");
  add_action("do_t4", "t4");
}

int do_t1() {
  string ret;
  object me = this_player();
  ret = __DIR__ "joy.lpc"->perform(this_player(), 0);
  if (ret)
    return 1;
  else
    return 0;
}

int do_t2() {
  string ret;
  object me = this_player();
  ret = __DIR__ "bullets.lpc"->exert(this_player(), 0);
  if (ret)
    return 1;
  else
    return 0;
}

int do_t3() {
  string ret;
  object me = this_player();
  ret = __DIR__ "sky-ground-byg.lpc"->perform(this_player(), 0);
  if (ret)
    return 1;
  else
    return 0;
}
int do_t4() {
  string ret;
  object me = this_player();
  ret = __DIR__ "nine.lpc"->perform(this_player(), 0);
  if (ret)
    return 1;
  else
    return 0;
}
