// Modify by Oyes
#include <ansi.h>
inherit NPC;
string ask_me(object who);
void do_power();
void create() {
  set_name("棺材王", ({ "offin kind", "kind" }));
  set("title", "普通百姓");
  set("gender", "男性");
  set_weight(123456789);
  set("age", 26);
  set("str", 29);
  set("cor", 30);
  set("cps", 30);
  set("int", 11);
  set("long",
    "他是這附近的住戶，是個古怪的人，晝伏夜出，沒人知道他總是在做啥，只知\n"
    "到他的武藝不弱，卻又不知他師承何處，不過總覺得他很像以前武林中的一個\n"
    "大魔頭，不過仔細看他的裝扮又不太像。\n");
  set("combat_exp", 4000);
  set("attitude", "friendly");
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "棺材王說道﹕你當我是誰﹐敢來撒野﹖\n",
    "棺材王說道﹕想我堂堂....呃....連我這個普通百姓都可以收拾你﹗\n",
    "棺材王忽然使出一式﹐招數精奇﹐但是打到中途忽然像是想起什麼﹐急忙收招。\n",
    "棺材王說道﹕你快走吧﹐今天饒你一命﹐就算我輸了你啦....\n"
  }));
  set("inquiry", ([
    "鬼王棺": (: ask_me :),
    "三途判": (: ask_me :)
  ]));
  set("chat_chance", 30);
  set("chat_msg", ({
    (: command, "hmm" :),
    (: command, "say" :),
    (: command, "think" :)

  }));
  set_skill("parry", 10);
  set_skill("dodge", 10);
  set_skill("unarmed", 25);
  setup();
  carry_object("/obj/cloth")->wear();
}
void init() {
  if (query("ask_id")) if (query("ask_id") != this_player()->query("id")) return;
  ::init();
}
string ask_me(object who) {
  object *ob;
  int i;
  who = this_player();
  if (query("marks/講過")) return "你既然知道了我的身分﹐今日休想活命﹗\n";
  who->set("marks/講過", 1);
  if (who->query("marks/講過")) {
    if (is_killing(who->query("id"))) return "你既然知道了我的身分﹐今日休想活命﹗\n";
    else {
      kill_ob(who);
      who->kill_ob(this_object());
      set_temp("apply/attack", 100);
      set_temp("apply/dodge", 100);
      set_temp("apply/parry", 100);
      set_temp("apply/armor", 100);
      set_temp("apply/damage", 100);

      set_skill("move", 100);
      set_skill("dodge", 100);
      set_skill("blade", 100);
      set_skill("parry", 100);
      set_skill("unarmed", 100);
      set_skill("iceforce", 120);
      set_skill("force", 120);

      map_skill("force", "iceforce");

      set("max_kee", 10000);
      set("max_sen", 10000);
      set("max_gin", 10000);
      set("eff_kee", 10000);
      set("eff_sen", 10000);
      set("eff_gin", 10000);
      set("kee", 10000);
      set("sen", 10000);
      set("gin", 10000);
      set("max_force", 2500);
      set("force", 10000);
      set("force_factor", 10);
      set("warexp", 50);
      set_name("鬼王棺", ({ "offin kind", "kind" }));
      set("title", "三途判");
      set("nickname", HIR "萬惡魔頭" NOR);
      set("long",
        "他長的相當兇惡﹐棺材樣的頭顱看來相當詭異﹐且眼睛不時射出殺氣..。\n");

      message("system",
        HIB "\n\n鬼王棺一陣冷笑道﹕\n"
        HIY "\n哼哼哼嘿嘿嘿.....梵天這個老禿驢，竟然找人對付我，就讓你見識鬼王棺的真正實力啦﹗\n\n" NOR
        HIG "" + this_player()->name() + HIR "﹗死來吧，要怪就怪梵天那個禿驢吧﹗﹗﹗\n\n" NOR,
        users());

      message("vision",
        HIY "鬼王棺大喝叫道﹕老子為了躲梵天﹐藏龍在此﹐現在為了保守秘密﹐取你狗命﹐納命來﹗\n"
        "鬼王棺突然取出邪刀血不沾﹐招數精奇﹐沈猛狠辣﹐和剛才簡直判若兩人﹗\n" NOR,
        environment(), this_object());
      set("pursuer", 1);
      set_leader(who);

      set("attitude", "aggressive");
      set("vendetta/authority", 1);

      set("chat_chance", 30);
      set("chat_msg", ({
        (: command, "hehe" :),
        (: command, "angry" :),
        (: command, "pk" :),
        (: random_move :)
      }));

      set("chat_chance_combat", 5);
      set("chat_msg_combat",
        ({
          (: command, "say 受死吧！" :),
          (: command, "say 老子一定要把你大卸八塊！" :),
          (: command, "unwield blade" :),
          (: do_power :),
          (: command, "wield blade" :),
          (: command, "exert recover" :),
          (: do_power :),
        }));
      set("default_actions", (: call_other, __FILE__, "query_action" :));
      reset_action();
      set("bellicosity", 30000);
      set("combat_exp", 450000);
      set("pursuer", 1);
      set("marks/講過", 1);

      ob = all_inventory(environment());
      for (i = sizeof(ob) - 1; i >= 0; i--) {
        if (environment(this_object())->query("no_fight")) break;
        if (!userp(ob[i]) || ob[i] == this_object()) continue;
        kill_ob(ob[i]);
        ob[i]->fight(this_object());
      }
      if (environment(this_object())->query("no_fight")) {
        kill_ob(who);
        command("follow " + who->query("id"));
        set("ask_id", who->query("id"));
        set("bellicosity", 0);
        set("combat_exp", 100000);
      }
      carry_object("/d/snow/npc/obj/blade_book");
      if (!find_object("/d/snow/npc/obj/ghostblade"))
        carry_object("/d/snow/npc/obj/ghostblade")->wield();
      else carry_object("/d/snow/obj/blade")->wield();
      //        carry_object("/obj/cloth")->wear();
      carry_object("/d/snow/npc/obj/snow-lan")->set_amount(50 + random(10));

      return "納命來！";
    }
  }
}
mapping *action = ({
  /*([  "action" :  "$N掌中運氣﹐霎然一招『引歸殺象』﹐只見團紫色氣勁由掌中對準$n的$l擊去",
                "dodge"     :   60,
                "parry"     :   50,
                "damage"    :  280,
                "force"     :  280,
                "damage_type":   "淤傷",
   ]),*/
  //改成特功/
  ([ "action": "$N掌中運氣﹐霎然一招『" HIR "放磁束跡" NOR "』﹐只見一條紫光從$n的腳下射出",
    "dodge": 60,
    "parry": 50,
    "damage": 300,
    "force": 300,
    "damage_type": "淤傷",
  ]),
});
mapping query_action() {
  return action[random(sizeof(action))];
}
void die() {
  if (this_object()->query("marks/講過")) {
    object winner = query_temp("last_damage_from");
    if (winner) {
      message("system", HIB "\n\n遠方傳來鬼王棺痛苦的哀嚎﹗\n\n" NOR
        HIM "\啊﹗好厲害的 " HIY + winner->name() + HIM "﹐果然有來歷吶 ﹗﹗﹗\n\n" NOR
        HIR "\啊﹗吾不甘心吶，業途靈、腹中首，為吾報仇血恨啊﹗\n" NOR, users());
    }
  }
  ::die();
}
void do_power() {
  object me = this_object();
  object target = me->query_temp("last_opponent");
  int damage = random(500) + 200 + this_object()->query("str") * 3;
  if (target->query("combat_exp") > 10000) {
    message_vision(HIG "\n$N手掌橫舉，力灌於臂，全身一股不可抵擋的氣勢，衝了出來～～\n" NOR, me);
    message_vision(NOR + GRN "只見$N跨步躍出，突然單掌反劈，煞時一陣光茫由其$N竄出，四周為之一亮。\n" NOR, me);
    message_vision(
      HIW "$N突然使出，" HIY "『" HIB "引" NOR + BLU "歸殺" HIB "象" HIY "』" HIW "之悽絕殺招，向$n擊去！\n" NOR,
      me,
      target
    );
    message_vision(
      HIR "只見光芒中亮出血影，$n已身中絕招，如斷線風箏，飛了出去了．．．．" NOR + RED "(" HIR + damage + NOR + RED ")\n" NOR,
      me,
      target
    );

    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 3);
    COMBAT_D->report_status(target);
  }
}
