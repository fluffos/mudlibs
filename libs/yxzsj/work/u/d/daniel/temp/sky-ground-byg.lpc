// edit by cou
#include <combat.h>
#include <ansi.h>
#include <skill_busy.h>
inherit SSERVER;

void fly_dragon(object);
int perform(object me, object target) {
  object weapon, ob;
  int ap, dp, m_pl, m_un, m_dg, m_ff, m_ad, t_dg, t_pa, damage1, d1, time;

  string msg;

  if (!target) target = offensive_target(me);

  if (me->query("class") != "taoist")
    return notify_fail(HIC "你非肉包派弟子，無法施展『 天 地 大 肉 包 』。\n" NOR);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIM "『" HIR "天" NOR "" RED "地大肉" NOR "" HIR "包" NOR "" HIM "』" NOR "只能在戰鬥中使用﹗\n");

  if (me->query("force") < 300)
    return notify_fail(HIW "你的內力不夠，無法施展『 天 地 大 肉 包 』。\n" NOR);

  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail(HIW "你需要一把劍才能使用。\n" NOR);

  if (me->query("eff_kee") < me->query("max_kee") / 10)
    return notify_fail(HIR "你已經受傷過重﹐只怕一運真氣便有生命危險！\n" NOR);

  if ((string)me->query_skill_mapped("sword") != "wo-che-sword")
    return notify_fail(HIW "只有在使用肉包劍法才能使用哦。\n" NOR);

  if (me->query_skill("sword", 1) < 60)
    return notify_fail(HIW "你的基本劍術之技功\力不足﹐無法施展『 天 地 大 肉 包 』！\n" NOR);

  if ((string)me->query_skill_mapped("force") != "sky-ground-force")
    return notify_fail(HIW "必須運用本門心法才能施展得出哦。\n" NOR);

  if (me->query_skill("taoism", 1) < 60)
    return notify_fail(HIW "你的肉包正道修為不夠高無法使用此招。\n" NOR);

  if (me->query_skill("wo-che-sword", 1) < 60)
    return notify_fail(HIW "你的無極劍法不夠火侯，無法施展『 天 地 大 肉 包 』！\n" NOR);

  if (me->query_temp("temp/performing") && userp(me))

  {
    tell_object(me, HIR "你因為精力消耗過多﹐身體狀況不能負荷﹐而吐了幾口鮮血﹗\n" NOR);
    tell_room(environment(me), HIR "只見" + me->name() + "臉色突然發白﹐吐了幾口鮮血出來﹗\n" NOR, me);

    me->receive_wound("kee", 30);
    me->receive_wound("gin", 30);
    me->receive_wound("sen", 100);

    me->start_busy(1);

    return 1;
  }

  me->set_temp("temp/performing", 1);

  message_vision(

    HIY "\n只見$N突然立定原地立不動，以" NOR + HIR "『" NOR + HIW "肉" YEL "包" HIY "心" HIC "源" HIR "』" HIY "運起全身肉勁，隨之經脈沸騰急流，\n" NOR
    HIR "頓時，$N身體化出一股強大的肉勁，隨著圍繞住$N的四處，發出裝肉的氣勢，\n\n" NOR
    HIW "$N雙腳踏出" NOR + HIC "『" NOR + HIW "裝" HIY "肉" MAG "步法" NOR + HIC "』" NOR + HIW "，突然大喝一聲：" NOR + HIC "『" HIR "天地大肉包" HIC "』﹗\n\n" NOR
    HIC "只見$N手中的蒸籠橫貫一揮，忽然$N的四周聚起無數閃爍的煙霧。\n" NOR
    HIG "$N將天地裝肉之氣匯聚成一，在刻間發出了兩顆震憾天地的大肉包﹗﹗\n" NOR

    NOR, me, target);
  m_pl = me->query_skill("wo-che-sword", 1);
  m_un = me->query_skill("sword");
  m_dg = me->query_skill("dodge");
  m_ff = me->query("force_factor", 1);
  m_ad = me->query_temp("apply/damage");

  t_dg = target->query_skill("dodge", 1);
  t_pa = target->query_skill("parry", 1);

  ap = m_un * 3 + m_pl * 3 + random(m_dg) / 2;
  dp = t_dg + t_pa + random(t_pa) / 2;

  damage1 = ((m_ff) * 3 + (m_pl) * 5 + (m_un) * 4 + (random(m_dg) / 2) - ((t_pa) + random(t_dg) / 2));
  //if (damage1 > 2500) damage1 = 2450+random(50);

  if (ap > dp) {
    d1 = damage1;
    message_vision(

      HIM "\n$N發招脫手，數道肉氣縮聚成宏大肉包擊向" HIW "$n" HIM "，" HIW "$n" HIM "退避不及，\n" NOR
      HIC "眨眼間，肉包已打入" HIW "$n" HIC "體內，退出數丈遠處，肉餡逆竄翻騰不息，\n\n" NOR
      HIW "$n" HIM "突然大吐一堆鮮血，身體陣痛多處！ . . . . . .  " HIY "(" + HIR + d1 + NOR + HIY + ")\n" NOR
      NOR "\n" NOR
      NOR, me, target);

    target->receive_damage("kee", d1, me);
    target->receive_wound("kee", (d1 / 3), me);
    //target->receive_damage("sen", d1,me);
    //target->receive_wound("sen", (d1),me);
    COMBAT_D->report_status(target);
    target->set_temp("last_damage_from", me);

    me->add("force", -300);
    me->start_busy(2);
    target->start_busy(0);
  }

  else {
    message_vision(

      HIW "\n$n識破$N的招式，$n卻施展輕功，以毫厘之差輕鬆躲過$N強勁的攻勢！\n\n" NOR

      NOR, target);

    me->add("force", -200);
    me->start_busy(2);
    target->start_busy(0);
  }

  time = 130 - me->query_skill("wo-che-sword", 1);
  if (me->query("class") == "taoist") time /= 2;
  if (time < 5) time = 5;
  call_out("reaction", time, me);
  return 1;
}


void reaction(object ob) {
  ob->delete_temp("temp/performing");
  tell_object(
    ob,
    HIC "你覺的精氣慢慢回升了!!" NOR "" HIW "你可以使用" NOR "" HIM "『" HIR "天" NOR "" RED "地大肉" NOR "" HIR "包" NOR "" HIM "』" NOR "哦。\n" NOR
  );
}
