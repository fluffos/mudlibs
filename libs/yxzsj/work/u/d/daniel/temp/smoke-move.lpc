// smoke-move.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        string msg;
        int damage, ap, a2p, mp, dp, tsu;
        object ob;

	if ( !target ) target = me;

        if(me->query_skill("spells") < 30)
           return notify_fail("临⊿厩穦硂〨砃\n");

        if(me->is_fighting())
           return notify_fail("驹矮い,叫瞒秨,ㄏノ硂〨砃\n");

        if (me->query_temp("PkIng") )
                return notify_fail(" PK いぃ骋禲\n");

        if((int)me->query("mana") < 50 )
                return notify_fail("猭ぃ镑\n");

        if((int)me->query("sen") < 30 )
                return notify_fail("弘⊿Τ快猭Τ栋い\n");

	if ( target->query("board_id") == "taoist_b" && me->query("marks/笵") == 1 )
		tsu = 1;
	else
		tsu = 0;

        me->add("mana", -50);
        me->receive_damage("sen", 30);

        if( random(me->query("max_mana")) < 50 ) {
                write("ア毖\n");
                return 1;
        }

        msg = HIW"$N耻羘筆ヒい搬搬Τ勉┛皚緻铭癬ㄓ箉緻铭癬冻綛ぱ\n\n"NOR;
	if ( tsu == 1 )
		msg += HIY"$N泊玡"+target->query("name")+HIY+"┛礛祇皗皗泞竛帝$Nō\n";
        message_vision(msg,me);
        ap = me->query_skill("spells");
        mp =me->query("max_mana");
        if( random(mp*ap) > (ap*50) ) {
                msg =  HIC "ǎ皚緻铭筁$Nアぃǎ\n" NOR;
                message_vision(msg, me);
                if( me->query("class")=="taoist" ) {
			if ( tsu == 1 )
			   me->move("/d/reason/tsu/m1.lpc");
			else
                           me->move("/d/reason/house1.lpc");
                           tell_room(environment(me),
                                     "┛礛钠癬皚緻铭緻铭筁"+(string)me->query("name")+"礛瞷"+"泊玡\n",me);
			if ( tsu == 1 )
                           tell_object(me,HIY"パき︽ぇ砃㎝笵毙羆韭猭腊箉ㄓ笵┮﹡︘挂\n"NOR);
			else
                           tell_object(me,HIY"パき︽ぇ砃箉ㄓ笵毙矪\n"NOR);
                }
                me->improve_skill("spells", 1);
           } else
                {
                msg = HIY "緻铭筁ǎ$Nご︻ミ\n"NOR;
                message_vision(msg, me);
                }
        if(target!=me) me->start_busy(2);
        return 1;
}