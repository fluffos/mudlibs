// joy.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg, ob;
  int damage, ap, dp;

  if (!target) target = offensive_target(me);

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必須先找一把劍才能使用劍法。\n");

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「" HIY "此樂何極" NOR "」只能在戰鬥中使用！\n");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要對誰施展這個劍法﹖\n");

  if ((int)me->query("force") < 400)
    return notify_fail("你的內力不夠﹗\n");

  if ((int)me->query("kee") < 50)
    return notify_fail("你的氣息沒有辦法有效集中﹗\n");

  me->add("force", -200);
  me->receive_damage("kee", 20);

  msg = HIC "\n$N向$n使出岳陽劍法極招　－　" + HIY + "此 樂 何 極" + HIC + "  ！！\n" NOR HIG "$N面帶微笑,運起全身內力，手中長劍發出閃閃金光，\n劍光閃爍飛舞，形成多股龐大的劍氣。\n"
    HIR "忽然間，所有劍氣突然轉強，四面八方的向$n飛了過去！\n"
    HIY "只見$n眼前一片金光，無處不是來襲的劍招，並使人有一股強大的壓迫感！\n\n" NOR;

  message_vision(msg, me, target);
  ap = me->query_skill("sword") / 100 + 1 + me->query_skill("yangsword") / 100;
  ap = (ap * ap * ap / 4) * (int)me->query("kee") / 100;
  dp = target->query_skill("dodge") / 100 + target->query("combat_exp") / 10000;
  if ((random(ap) + 1) * 4 > dp) {
    damage = (int)target->query("force_factor") + (int)me->query_skill("sword") * 5;
    damage += random(damage / 10);
    if (damage < 0)
      damage = 0;
    if (damage > 0) {
      msg = HIY "$n見狀，極欲避開劍氣，但已遲了一步。\n"
        "$N手中長劍發出的鋒芒劍氣，直接刺穿了$n的身體，\n"
        HIR "鮮血從創口灑出，染紅了五六丈內的地面！ " NOR "(" + HIR + damage + NOR + ")\n" NOR;
      message_vision(msg, me, target);
      target->receive_damage("kee", damage, me);
      target->receive_wound("kee", damage / 3, me);
      damage = (int)target->query("max_force") / -10 + random((int)me->query("kee"));
      if (damage < 0)
        damage = 0;
      if (damage > 0) COMBAT_D->report_status(target);
      message_vision("\n", me, target);
      msg = HIC "$N發出的劍招餘勁未消，$N大笑數聲，\n"
        "發出一股渾厚的氣勁，直直的飛向$n！\n"
        HIR "$n不幸中招，碰的一聲，吐出一口鮮血！" NOR "(" + HIR + damage + NOR + ")\n" NOR;
      message_vision(msg, me, target);
      target->receive_damage("kee", damage, me);
      target->receive_wound("kee", damage, me);
    }
  } else {
    msg = HIY "$n見狀，急忙使出上乘輕功\，身形急轉，在千鈞一髮之際逃了開去！\n" NOR;
    message_vision(msg, me, target);
  }

  if (damage > 0) COMBAT_D->report_status(target);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }

  message_vision("\n", me, target);
  me->start_busy(2);
  return 1;
}
