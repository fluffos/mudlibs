int ask_dragon()
{
    object me=this_player();

       say(CYN"ρ弧笵:"HIY"ΤΩиゴ苯笵芠加礛癬皚╣\n"
                            "唉ō盿Τ纒眖ぱτри纞铬礛\n"
                            "杠ぃ弧碞ри盿秈┣┬丁羬ǐ玡\n"
                            "廷倒и聋皗帝钵ホ繷ぃ筁ирウ倒サ\n"
                            "加тт\n"NOR);
                            me->set("marks/dragon",1);
                            return 1;
}