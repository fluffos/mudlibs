// kill.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj;
	string *killer;

	seteuid(getuid(me)); 

	if( environment(me)->query("no_fight") )
		return notify_fail("硂柑ぃ驹矮\n");

	if( !arg )
		return notify_fail("稱炳街\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("硂柑⊿Τ硂\n");

	if( !obj->is_character() || obj->is_corpse() )
		return notify_fail("睲贰翴êぃ琌\n");

	if(obj==me)
		return notify_fail("ノ suicide 穦ゑ耕е:P\n");

	message_vision("\n$N癸帝$n耻笵" 
		+ RANK_D->query_rude(obj) + "さらぃ琌碞琌и\n\n", me, obj);

	me->kill_ob(obj);
	if( !userp(obj) )
		obj->kill_ob(me);
	else {
		obj->fight_ob(me);
	}

	return 1;
}
int help(object me)
{
  write(@HELP
Α : kill <>
 
硂琵笆秨﹍ю阑纜刚炳癸よkill ㎝ fight 程
ぃ蛮よ盢穦痷龟簀ゴ矮碞琌弧穦痷端パ kill 惠虫よ
碵薄腀碞Θミ癸ヴ︙ㄏノ kill 常穦秨﹍驹矮硄盽狦
癸よ琌 NPC 杠穦妓癸ㄏノ kill

讽Τ癸ㄏノ kill 穦瞷︹妓牡癸產τē狦
⊿Τ癸寄ㄏノ筁 kill 碞ぃ穦盢癸よ痷ゴ端┪炳( ㄏノ猭砃埃
)

ㄤ闽: fight

Τ闽 fight 蛤 kill 跋だ叫 'help combat'.
HELP
    );
    return 1;
}
 
