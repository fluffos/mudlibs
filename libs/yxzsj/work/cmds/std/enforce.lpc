// enforce.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int pts;

	if( !arg || (arg!="none" && !sscanf(arg, "%d", pts)) ) 
		return notify_fail("Αenforce <ㄏ碭Θず端寄>|none");

	if( !me->query_skill_mapped("force") )
		return notify_fail("ゲ斗 enable 贺ず\\n");

	if( arg=="none" )
		me->delete("force_factor");
	else {
		if( pts < 0 || pts > (int)me->query_skill("force") / 2 )
			return notify_fail("ノ none ボぃ笲ず┪计ボ–阑ノ碭翴ず\n");
		me->set("force_factor", pts);
	}

	write("Ok.\n");
	return 1;
}

int help (object me)
{
        write(@HELP
Α: enforce <ㄏ碭翴ず端寄>|none
 
硂琵﹚–Ω阑い寄璶祇碭翴ず端寄

enforce none 玥ボぃㄏノず 

SEE ALSO : enable, enchant
HELP
        );
        return 1;
}
