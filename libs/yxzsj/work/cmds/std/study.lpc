// study.c

#include <skill.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object ob;
	mapping skill;
	int cost;

	if( me->is_fighting() )
		return notify_fail("礚猭驹矮い盡みㄓ弄穝\n");

	if(!arg || !objectp(ob = present(arg, me)) )
		return notify_fail("璶弄ぐ或\n");

	if( !mapp(skill = ob->query("skill")) )
		return notify_fail("礚猭眖硂妓狥﹁厩ヴ︙狥﹁\n");

	if( !me->query_skill("literate", 1) )
		return notify_fail("琌ゅ厩厩弄醚(literate)\n");

	message("vision", me->name() + "タ盡み弄" + ob->name()
		+ "\n", environment(me), me);

	if( (int)me->query("combat_exp") < skill["exp_required"] ) {
		write("龟驹竒喷ぃì或弄⊿ノ\n");
		return 1;
	}

	notify_fail("ヘ玡临⊿Τ快猭厩硂м\n");
	if( !SKILL_D(skill["name"])->valid_learn(me) ) return 0;

	cost = skill["sen_cost"] + skill["sen_cost"] 
		* (skill["difficulty"] - (int)me->query("int"))/20;
	if( (int)me->query("sen") < cost ) {
		write("瞷筁痟礚猭盡みㄓ弄穝\n");
		return 1;
	}

	if( me->query_skill(skill["name"], 1) > skill["max_skill"] ) {
		write("弄穦ㄠ琌祇瞷┮弧癸τē常び睱⊿Τ厩ヴ︙狥﹁\n");
		return 1;
	}

	me->receive_damage("sen", cost);

	if( !me->query_skill(skill["name"], 1) )
		me->set_skill(skill["name"], 0);
	me->improve_skill(skill["name"], (int)me->query_skill("literate", 1)/5+1);
	write("弄Τ闽" + to_chinese(skill["name"]) + "мォΤ翴み眔\n");
	return 1;
}

int help(object me)
{
   write( @HELP
Α: study <珇嘿>

硂ㄏ眖覦┪ㄤ珇︑厩琘ㄇмォ,
玡矗琌: ぃ琌ゅ

see also : learn
HELP
   );
   return 1;
}
