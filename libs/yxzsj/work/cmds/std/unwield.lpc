// unwield.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob, *inv;
	string str;
	int i;

	if( !arg ) return notify_fail("璶叉奔ぐ或\n");

	if( !objectp(ob = present(arg, me)) )
		return notify_fail("ō⊿Τ硂妓狥﹁\n");

	if( (string)ob->query("equipped")!="wielded" )
		return notify_fail("⊿Τ杆称硂妓狥﹁猌竟\n");

	if( ob->unequip() ) {
		if( !stringp(str = ob->query("unwield_msg")) )
			str = "$Nもい$n\n";
		message_vision(str, me, ob);
		return 1;
	} else
		return 0;
}

int help(object me)
{
  write(@HELP
Α : unwield <珇>
 
硂琵もい猌竟
 
HELP
    );
    return 1;
}
 
