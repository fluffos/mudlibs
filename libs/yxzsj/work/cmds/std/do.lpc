#include <ansi.h>
 
// 眔材硆腹︗竚
int parse (string arg)
{
  int i, In, n;

  i = 0; In = 0; n = strlen (arg);
  arg += ",";   // 硂妓琵 ,, 耞タ盽

  for (i=0; i<n; i++) {
    if (arg[i] == '"')
        if (arg[i+1] == '"') {
          i++;
          continue;
        }
        else In = !In;
    else if (arg[i] != ',') continue;
    else if (In) continue;
    else if (arg[i+1] == ',')
        i++;
    else break;
  }

  return i-1;
}

// 铬筁フ场, ㄏ眔 "l,hp", "l, hp" 蛤 "l,     hp" 常ノ
int skip_space(string arg)
{
  int           i, n;

  i = 0; n = strlen (arg);

  while ( i<n && arg[i] == ' ') i++;
  return i;
}

// 斌疭じ, ㄢ蛮珹腹, のㄢ硆腹ㄤ龟琌硆腹τ
string discard (string arg)
{
  string msg;
  int   i, n;

  if (!arg || arg == "") return arg;
  n = strlen(arg);
  arg += ",";   // 硂瞶パ蛤 parse() 柑妓
  msg = "";
  for (i=0; i<n; i++)
    if ((arg[i] == ',' && arg[i+1] == ',') ||
        (arg[i] == '"' && arg[i+1] == '"'))
    {
        i++;
        msg += arg[i..i];
    }
    else if (arg[i] == '"') continue;
    else msg += arg[i..i];
  return msg;
}

int main(object me, string cmds, int depth, int in_do)
{
  string        verb, arg, cmd, other;
  int           i, j, n;

  if (!cmds || cmds == "") return 0;
  
  // 程糷
  if (depth >= 19) return 0;

  // 材硆腹︗竚
  if (cmds == "") return 1;
  i = parse(cmds);
  if (i == -1) return 0;
  j = skip_space(cmds);
  if (i<j) return 0;
  // 抖獽玂痙ㄤ场
  cmd = cmds[j..i];
  if ((i+2) < (n=strlen(cmds))) other = cmds[i+2..n-1];
  cmd = discard(cmd);
 
  //  cmd 竒琌 do 柑ず甧, иぃす砛 do 柑临Τ do
  if (cmd[0..1] == "do") return 0;

  // 祑┦砏﹚ do 柑繷﹚琌 brief mode
  if (!in_do) {
    n = me->query("env/brief");
    me->set("env/brief",1);
  }

  // –㏑セō琌 alias, ┮癳 alias.c 柑 process_input 矪瞶筁
  // 礛癳秈 /feature/commamd.c 矪瞶
  //me->do_command(me->process_input (cmd));
    me->force(me->process_input(cmd));
	if ( other && other != "" )
    // 程把计 1  do ㏑柑, 硂琌 brief mode ノ
    // call_other(this_object(),"main", me, other, depth+1, 1);
    main (me, other, depth+1, 1);

  // р brief mode 临
  me->set("env/brief",n);
  return 1;
}
 
