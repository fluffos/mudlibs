// abandon.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if( !arg || arg=="" ) return notify_fail("璶斌兜м\n");

	if( !me->delete_skill(arg) )
		return notify_fail("⊿Τ厩筁硂兜м\n");

	write("∕﹚斌膥尿厩策" + to_chinese(arg) + "\n");
	return 1;
}

int help()
{
	write(@TEXT
Αabandon <м嘿>

斌兜┮厩м猔種硂柑┮弧斌琌盢硂兜м眖戈い
埃狦临璶絤ゲ斗眖 0 秨﹍絤叫叭ゲσ納睲贰

硂ㄏノ初硄盽琌ノㄓ埃ㄇぃみ絤ㄓмパи安砞
繦常穦眖〓贺笆驹矮い厩策Τㄇм穦竒盽ㄏ
ノτ瞷мい硂碞ゲ斗禣ㄇ弘癘︘┮厩筁ち
礛τ戈借Τぃ艶┦蔼镑厩策砛мτΘ美
艶┦耕畉碞盡み疭﹚碭兜м狦厩м贺摸び禬筁艶┦
穦祇瞷厩策硉盢ゑ厩碭贺м篊禬筁禫厩策狦辅薄
猵禫腨硂贺薄碞钩琌厩戳匡び厩だ瘤礛ご礛咎帝禬
種в絤ぃ筁硂盢穦禣砛腳禥丁
TEXT
	);
	return 1;
}
