//ride.c

inherit F_CLEAN_UP;

int do_ride(object me, object obj);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object obj, *inv, obj2;
  int i, amount;
  string item, ridon;

  if (arg == "off") {
    if (!(me->query_temp("ridon")))
      return notify_fail("你並沒有乘坐任何的東西。\n");
    message_vision("$N從" + me->query_temp("ridon") + "上跳了下來。\n", me);
    obj = me->query_temp("ridon_obj");
    obj->move(environment(me));
    me->set_temp("apply/dodge", me->query_temp("apply/dodge") - obj->query("prop/dodge"));
    me->set_temp("apply/move", me->query_temp("apply/move") - obj->query("prop/move"));
    this_player()->delete_temp("ridon");
    this_player()->delete_temp("ridon_obj");
    return 1;
  }
  if (me->query_temp("ridon"))
    return notify_fail("你現在正坐在" + me->query_temp("ridon") + "上\n");
  if (!arg) return notify_fail("你要乘坐什麼東西﹖\n");

  if (!objectp(obj = present(arg, environment(me))))
    return notify_fail("你附近沒有這樣東西。\n");
  if (!obj->query("ridable"))
    return notify_fail("這東西不能乘坐\n");
  if (me->query_skill("ride") < obj->query("skill_limit")) {
    message_vision(
      "$N嘗試著要坐上" + obj->query("name") + ",但是經驗不足,從" + obj->query("name") + "上摔了下來！\n",
      me
    );
    me->receive_damage("kee", 10);
    return 1;
  }

  return do_ride(me, obj);
}

int do_ride(object me, object obj) {
  mixed no_drop;
  object ob;

  ob = obj;
  if (ob->is_character())
    message_vision("$N往$n上面騎了上去！！\n", me, ob);
  else
    message_vision("$N坐上$n。\n", me, ob);

  me->set_temp("ridon", obj->query("name"));
  me->set_temp("ridon_obj", base_name(obj));
  me->set_temp("apply/dodge", me->query_temp("apply/dodge") + obj->query("prop/dodge"));
  me->set_temp("apply/move", me->query_temp("apply/move") + obj->query("prop/move"));
  destruct(obj);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : ride(乘坐) <生物,物品>
ride <off> 不乘坐
 
HELP
  );
  return 1;
}
