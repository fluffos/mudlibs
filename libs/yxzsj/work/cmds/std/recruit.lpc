// recruit.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob, old_rec;
	mapping family;
	int i;

	if( !arg ) return notify_fail("Αrecruit [cancel]|<癸禜>\n");

	if( arg=="cancel" ) {
		old_rec = me->query_temp("pending/recruit");
		if( !objectp(old_rec) )
			return notify_fail("瞷⊿ΤΜ魁ヴ︙種\n");
		write("э跑種ぃ稱Μ" + old_rec->name() + "\n");
		tell_object(old_rec, me->name() + "э跑種ぃ稱Μ\n");
		me->delete_temp("pending/recruit");
		return 1;
	}

	if( !(ob = present(arg, environment(me))) )
		return notify_fail("稱Μ街\n");

	if( ob==me ) return notify_fail("Μ︑種....ぃ筁⊿Τノ\n");

	if( ob->is_apprentice_of(me) ) {
		message_vision("$N╃╃$n繷弧笵畕ㄠ\n", me, ob);
		return 1;
	}

	if( !me->query("family") )
		return notify_fail("ぃ妮ヴ︙ゲ斗┪︑承Μ畕\n");

	// If the target is willing to apprentice us already, we do it.
	if( (object)ob->query_temp("pending/apprentice") == me ) {

		if( !living(ob) ) {
			message_vision(
				"$N∕﹚Μ$n\n\n"
				"ぃ筁妓$n陪礛⊿Τ快猭︽畍ぇ搂\n\n",
				me, ob);
			return 1;
		}
	// follow modified by elon 09-10-95 to fix a bug in 1st time recruit
		if((ob->query("family")) && ( (string)me->query("family/family_name") != (string)ob->query("family/family_name") ) ) {
			message_vision(
				"$N∕﹚璉玵畍эщ$n\n\n"
				"$N各ㄓ$n穛穛絎臫繷笵畍\n\n",
				ob, me);
			ob->set("score", 0);
			ob->add("betrayer", 1);
		} else
			message_vision(
				"$N∕﹚Μ$n\n\n"
				"$n各ㄓ$N穛穛絎臫繷笵畍\n",
				me, ob);

		me->recruit_apprentice(ob);
		ob->delete_temp("pending/apprentice");

		write("尺穝Μ\n");
		family = ob->query("family");
		tell_object( ob, sprintf("尺眤Θ%s材%s\n", family["family_name"],
			chinese_number(family["generation"]) ));

		return 1;
	

	} else {

		old_rec = me->query_temp("pending/recruit");
		if( ob==old_rec )
			return notify_fail("稱Μ" + ob->name() + "琌癸よ临⊿Τ氮莱\n");
		else if( objectp(old_rec) ) {
			write("э跑種ぃ稱Μ" + old_rec->name() + "\n");
			tell_object(old_rec, me->name() + "э跑種ぃ稱Μ\n");
		}

		me->set_temp("pending/recruit", ob );
		message_vision("\n$N稱璶Μ$n\n", me, ob);
		tell_object(ob, YEL "狦腀種" + me->name() + "畍ノ apprentice \n" NOR);
		return 1;
	}
}


int help(object me)
{
        write(@HELP
Α : recruit [cancel]|<癸禜>
 
硂琵Μ琘, 狦癸よ氮莱璶畍杠.
 
HELP
        );
        return 1;
}
