// respirate.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int gin_cost, atman_gain;
	string magic_skill;

	seteuid(getuid());
	
	if( me->is_fighting() )
		return notify_fail("驹矮琌贺︽ぃ㎝艶︽秈︽\n");

	if( !arg
	||	!sscanf(arg, "%d", gin_cost) )
		return notify_fail("璶ぶ弘︽\n");

	if( gin_cost < 10 ) return notify_fail("程ぶ璶 10 翴弘秈︽︽\n");

	if( (int)me->query("gin") < gin_cost )
		return notify_fail("瞷弘ぃì礚猭︽艶\n");

	if( (int)me->query("kee") * 100 / (int)me->query("max_kee") < 70 )
		return notify_fail("瞷ō砰猵び畉礚猭栋い弘\n");

	if( (int)me->query("sen") * 100 / (int)me->query("max_sen") < 70 )
		return notify_fail("瞷弘猵び畉礚猭北︑み艶\n");

	write("超泊氟秨﹍ゴГ\n");

	me->receive_damage("gin", gin_cost);

	// This function ranged from 1 to 15 when gin_cost = 30
	atman_gain = gin_cost * ((int)me->query_skill("magic") 
		+ (int)me->query("spi") ) / 300;

	if( atman_gain < 1 ) {
		write("琌ぃみ玱何帝\n");
		return 1;
	}

	me->add("atman", atman_gain );

	if( (int)me->query("atman") > (int)me->query("max_atman") * 2) {
		if( (int)me->query("max_atman") >= (int)me->query_skill("magic", 1) * 10 ) {
			write("┛礛谋眔皚ぱ臂锣繷害眔钩璶吊秨妓艶︽竒笿瞺繴\n");
		} else {
			write("艶矗蔼\n");
			me->add("max_atman", 1);
		}
		me->set("atman", me->query("max_atman"));
	}	
	
	return 1;
}

int help(object me)
{
        write(@HELP
Α : respirate [<禣弘秖箇砞 30>]
 
ゴГ︽ノ芬弘て芬て芬临店よ猭盢弘
锣跑Θ艶

叫把σ help stats
HELP
        );
        return 1;
}
