// exercise.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int kee_cost, force_gain;

	seteuid(getuid());
	
	if( me->is_fighting() )
		return notify_fail("驹矮いぃ絤ず\穦ǐ臸\n");

	if( !stringp(me->query_skill_mapped("force")) )
		return notify_fail("ゲ斗ノ enable 匡拒璶ノず\み猭\n");

	if( !arg
	||	!sscanf(arg, "%d", kee_cost) )
		return notify_fail("璶ぶ絤\\n");

	if( kee_cost < 10 ) return notify_fail("程ぶ璶 10 翴絤\\n");

	if( (int)me->query("kee") < kee_cost )
		return notify_fail("瞷びぶ礚猭玻ネず笲︽ō竒\n");

	if( (int)me->query("sen") * 100 / (int)me->query("max_sen") < 70 )
		return notify_fail("瞷弘猵び畉礚猭井盡\n");

	if( (int)me->query("gin") * 100 / (int)me->query("max_gin") < 70 )
		return notify_fail("瞷弘ぃ镑礚猭北ず瑈笆\n");

	write("Гㄓ笲ノ\ず秨﹍砰ず瑈笆\n");

	me->receive_damage("kee", kee_cost);

	// This function ranged from 1 to 15 when kee_cost = 30
//	force_gain = kee_cost * ((int)me->query_skill("force", 1)
//		+ (int)me->query("con") ) / 300;

	force_gain = kee_cost;

	if( force_gain < 1 ) {
		write("琌讽︽\Ч拨谋眔ō祄陈\n");
		return 1;
	}

	me->add("force", force_gain );

	if( (int)me->query("force") > (int)me->query("max_force") * 2) {
		if( (int)me->query("max_force") >= 
			((int)me->query_skill("force", 1) + me->query_skill("force")/5) * 10 ) {
			write("讽ず筂ō竒玱⊿Τ\矗狜格禜ず竒笿瞺繴\n");
		} else {
			write("ず糤眏\n");
			me->add("max_force", 1);
		}
		me->set("force", me->query("max_force"));
	}	
	return 1;
}

int help(object me)
{
        write(@HELP
Α : exercise [<禣秖箇砞 30>]

笲絤北砰ず竒丁瑈笆虑癡絤砰︐ψ癌纅瑻
脄祇ノずΑ盢秖纗称ㄓ

叫把σ help stats
HELP
        );
        return 1;
}
