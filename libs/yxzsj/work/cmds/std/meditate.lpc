// meditate.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int sen_cost, mana_gain;

	seteuid(getuid());
	
	if( me->is_fighting() ) return notify_fail("驹矮いт盾\n");

	if( !arg
	||	!sscanf(arg, "%d", sen_cost) )
		return notify_fail("璶ぶ弘\n");

	if( sen_cost < 10 ) return notify_fail("程ぶ璶 10 翴\n");

	if( (int)me->query("sen") < sen_cost )
		return notify_fail("瞷弘び畉秈︽盢穦癵アッ环眶ぃ筁ㄓ\n");

	if( (int)me->query("kee") * 100 / (int)me->query("max_kee") < 70 )
		return notify_fail("瞷ō砰猵び畉礚猭栋い弘\n");

	if( (int)me->query("gin") * 100 / (int)me->query("max_gin") < 70 )
		return notify_fail("瞷ō砰猵び店畓礚猭秈篈\n");

	write("絃渐τГ繰Г穦ㄠ\n");

	me->receive_damage("sen", sen_cost);

	// This function ranged from 1 to 15 when sen_cost = 30
	mana_gain = sen_cost * ((int)me->query_skill("spells") 
		+ (int)me->query("spi") ) / 300;

	if( mana_gain < 1 ) {
		write("琌讽窩秨泊氟谋眔福いフ\n");
		return 1;
	}

	me->add("mana", mana_gain );

	if( (int)me->query("mana") > (int)me->query("max_mana") * 2) {
		if( (int)me->query("max_mana") >= (int)me->query_skill("spells", 1) * 10) {
			write("讽猭糤俐丁┛礛谋眔福い睼睹猭矗狜竒瞺繴\n");
		} else {
			write("猭矗蔼\n");
			me->add("max_mana", 1);
		}
		me->set("mana", me->query("max_mana"));
	}	
	
	return 1;
}
int help(object me)
{
        write(@HELP
Α : meditate [<禣秖箇砞 30>]
 
繰Г盢村瞒弘Τ栋い井籈Θ镑ノㄓ琁甶猭砃秖
虑糤︑猭

叫把σ help stat 
HELP
        );
        return 1;
}
