// expell.c

#include <skill.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object ob;
	string *skname;
	mapping skills;
	int i;

	if( !arg || !ob = present(arg, environment(me)) )
		return notify_fail("璶盢街硋畍\n");

	if( !ob->is_character() )
		return notify_fail("璶秨街\n");

	if( !userp(ob) )
		return notify_fail("秨產┮ш簍\n");

	if( me->query("family/privs")==-1
	&&	(string)me->query("family/family_name")==(string)ob->query("family/family_name") ) {
		message_vision("\n$N癸帝$n弧笵眖さぱ癬ぃ琌и"
			+ me->query("family/family_name") + "ǐ\n\n",
			me, ob);
		tell_object(ob, "\n砆" + me->query("family/title") + "秨畍\n\n");
	} else if( ob->is_apprentice_of(me) ) {
		message_vision("\n$N癸帝$n弧笵眖さぱ癬и畍畕耞薄荡ǐ\n\n",
			me, ob);
		tell_object(ob, "\n砆畍秨畍\n\n");
	} else
		return notify_fail("硂ぃ琌\n");

	ob->delete("family");
	ob->delete("title");
	ob->set("score", 0);
	skills = ob->query_skills();

	if( mapp(skills) ) {
		skname = keys(skills);
		for(i=0; i<sizeof(skname); i++)
			skills[skname[i]] /= 2;
	}

	return 1;
}

int help(object me)
{
	write(@HELP
Α : expell <琘>
 
硂琵秨埃ぃΘ砆秨埃┮Τм常穦ㄓ
τ侯蝶基兜穦跑Θ箂硂癸τē琌ゑ临
腨ゴ阑叫秨埃ぇ玡叭ゲ糵稸σ納
 
HELP
	);
	return 1;
}
