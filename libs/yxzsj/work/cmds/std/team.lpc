// team.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object *t;

	if( !arg ) {
		if( !pointerp(t = me->query_team()) )
			return notify_fail("瞷⊿Τ把ヴ︙钉ヮ\n");
		write("瞷钉ヮいΘΤ\n  " + implode(t->name(1), "\n  ") + "\n");
		return 1;
	}
	if( arg=="dismiss" ) {
		if( !pointerp(t = me->query_team()) )
			return notify_fail("瞷⊿Τ把ヴ︙钉ヮ\n");
		if( me->is_team_leader() ) {
			message("team", me->name(1) + "盢钉ヮ秆床\n", t, me);
			write("盢钉ヮ秆床\n");
		} else {
			message("team", me->name(1) + "∕﹚叉瞒钉ヮ\n", t, me);
			write("叉瞒钉ヮ\n");
		}
		me->dismiss_team();
		return 1;
	}
	if( sscanf(arg, "with %s", arg)==1 ) {
		object ob;

		if( !(ob = present(arg, environment(me)))
		||	!living(ob)
		||	!ob->is_character()
		||	ob==me )
			return notify_fail("稱㎝街Θ官︸\n");

		if( !pointerp(me->query_team()) || me->is_team_leader() ) {
			if( me==(object)ob->query_temp("pending/team") ) {
				if( !pointerp(me->query_team()) ) {
					ob->add_team_member(me);
					message_vision("$N∕﹚$n钉ヮ\n", me, ob);
				} else {
					me->add_team_member(ob);
					message_vision("$N∕﹚琵$n钉ヮ\n", me, ob);
				}
				ob->dellete_temp("pending/team");
				return 1;
			} else {
				message_vision("$N淋叫$n$P钉ヮ\n", me, ob);
				tell_object(ob, YEL "狦腀種叫ノ team with " + me->query("id") + "\n" NOR);
				me->set_temp("pending/team", ob);
				return 1;
			}
		} else
			return notify_fail("Τ钉ヮ烩砈淋叫\n");
	}
	if( sscanf(arg, "talk %s", arg)==1 ) {
		if( !pointerp(t=me->query_team()) )
			return notify_fail("瞷⊿Τ㎝舱Θ钉ヮ\n");
		message("team", HIW "钉ヮ" + me->name(1) + "" + arg + "\n" NOR, t);
		return 1;
	}
	if( sscanf(arg, "form %s", arg)==1 ) {
		if( !pointerp(t=me->query_team()) || !me->is_team_leader() )
			return notify_fail("ゲ斗琌钉ヮ烩砈舱麓皚\n");
		if( !me->query_skill(arg, 1) )
			return notify_fail("硂贺皚⊿厩筁\n");
		return SKILL_D(arg)->form_array(me);
	}
}

int help(object me)
{
	write(@HELP
钉ヮㄏノよ猭:

team with <琘> - 蛤琘舱Θ钉ヮ. ゲ斗璶蛮よ常種穦ネ
team dismiss     - 瞒秨钉ヮ. 璝琌烩钉, 玥俱钉ヮ穦秆床
team talk <癟> - 蛤钉ヮ柑ㄤ酵杠, ノ tt <癟> 蠢
team form <皚猭> - 狦钉ヮ烩钉厩筁皚猭杠盢钉ヮいΘ舱麓Θ
                   琘贺皚舱Θ皚篈璶烩砈簿笆碞穦秆埃

钡 team 玥穦陪ボヘ玡琌Τ钉ヮの钉虫

爹: team 蛤 follow 琌縒ミぃ﹚璶 follow 钉ヮ烩砈
HELP
	);
	return 1;
}
