// exert.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string force;
	int result;
	
	seteuid(getuid());

	if( me->is_busy() )
		return notify_fail("( 笆临⊿ΤЧΘぃ琁ノず\)\n");

	if( !arg ) return notify_fail("璶ノず\暗ぐ或\n");

	if( stringp(force = me->query_skill_mapped("force")) ) {
		notify_fail("┮厩ず\い⊿Τ硂贺\\n");
		if( SKILL_D(force)->exert_function(me, arg) ) {
			if( random(120) < (int)me->query_skill("force") )
				me->improve_skill(force, 1, 1);
			return 1;
		} else if( SKILL_D("force")->exert_function(me, arg) ) {
			if( random(120) < (int)me->query_skill("force", 1) )
				me->improve_skill("force", 1, 1);
			return 1;
		}
		return 0;
	}

	return notify_fail("叫ノ enable 匡拒璶ㄏノず\\n");
}

int help (object me)
{
        write(@HELP
Αexert <嘿> [<琁ノ癸禜>]

ノず秈︽ㄇ疭钵ゲ惠璶﹚<嘿><琁ノ癸禜>玥Τ礚
ㄏノ琘贺ず疭钵ぇ玡ゲ斗ノ enable ㄓ﹚璶ㄏノ
ず

叫把σ help force 眔ㄇ场だず常Τ︓┮ノず┏
Τ⊿Τ赣刚刚┪把σㄤ弧獽

爹狦э跑︑ずセ籛縩ずぃ钡锣传筁ゲ斗
    眖 0 秨﹍
 
HELP
        );
        return 1;
}
