// look.c

#include <room.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int look_room(object me, object env);
int look_item(object me, object obj);
int look_living(object me, object obj);
int look_room_item(object me, string arg);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object obj;
	int result;

	if( !arg ) result = look_room(me, environment(me));
	else if( (obj = present(arg, me)) || (obj = present(arg, environment(me)))) {
		if( obj->is_character() ) result = look_living(me, obj);
		else result = look_item(me, obj);
	} else result = look_room_item(me, arg);

	return result;
}

int look_room(object me, object env)
{
	int i, light_up;
	object *inv;
	mapping exits;
	string str, *dirs, doors;

	if( !env ) {
		write("㏄η累累ぐ或⊿Τ\n");
		return 1;
	}

	light_up = env->query("light_up");
	if ( light_up == -1 )
		light_up = 0;
	else
		light_up = 1;
	inv = all_inventory(me);
	for (i=0; i<sizeof(inv); i++)
		if ( inv[i]->query("light_up") ) light_up = 1;

	if ( light_up )
		str = sprintf( "%s%s\n\n    %s\n%s",
			"[" + GRN + env->query("short") + NOR + "]",
			wizardp(me)? " - " + file_name(env): "",
			env->query("long"),
			env->query("outdoors")? NATURE_D->outdoor_room_description() : "" );
	else
		str = sprintf( "%s%s\n\n    %s\n",
			"",
			wizardp(me)? " - " + file_name(env): "",
			"硂柑絬ぃì堵↖↖礚猭睲贰㏄瞅吏挂 ...\n",);
	if ( light_up ) {
	if( mapp(exits = env->query("exits")) ) {
		dirs = keys(exits);
		for(i=0; i<sizeof(dirs); i++) {
	if ( env->door_description(dirs[i])!="" ) str += "  "+env->door_description(dirs[i]);
			if( (int)env->query_door(dirs[i], "status") & DOOR_LOCKED ) {
				//if ( !doors ) doors = "  ";
				//doors += env->door_description(dirs[i]);
				dirs[i] = HIR+dirs[i]+NOR; }
			else if( (int)env->query_door(dirs[i], "status") & DOOR_CLOSED ) {
				//if ( !doors ) doors = "  ";
				//doors += env->door_description(dirs[i]);
				dirs[i] = HIY+dirs[i]+NOR;} }
		dirs -= ({ 0 });
		if( sizeof(dirs)==0 )
			str += "    硂柑⊿Τヴ︙陪隔\n";
		else if( sizeof(dirs)==1 )
			str += "    硂柑斑琌 " + BOLD + dirs[0] + NOR + "\n";
		else
			str += sprintf("    硂柑陪琌 " + BOLD + "%s" + NOR + " ㎝ " + BOLD + "%s" + NOR + "\n",
				implode(dirs[0..sizeof(dirs)-2], ""), dirs[sizeof(dirs)-1]);
	}
	}
	else
		str += "    矪常家家絢絢セだぃ睲êㄠ琌隔\n";

	inv = all_inventory(env);
	for(i=0; i<sizeof(inv); i++) {
		if( inv[i]==me ) continue;
		if( !me->visible(inv[i]) ) continue;
		if ( light_up ) {
			str += "  " + inv[i]->short();
			if ( inv[i]->query("note") )
				str += inv[i]->query("note");
			if( inv[i]->query_temp("ridon") )
				str += HIY+" [帝"+inv[i]->query_temp("ridon")+HIY+"]"+NOR;
			if( inv[i]->is_fighting() )
				str += HIR+" [驹矮]"+NOR;
			str += "\n"; }
		else
			str += "  笆ぃ氨家絢紇だ侩ぃ琌ぐ或狥﹁\n";
	}

	write("\n"+str);
	return 1;
}

int look_item(object me, object obj)
{
	mixed *inv;
	int light_up, i;

	light_up = environment(obj)->query("light_up");
	if ( light_up == -1 )
		light_up = 0;
	else
		light_up = 1;
	inv = all_inventory(me);
	for (i=0; i<sizeof(inv); i++)
		if ( inv[i]->query("light_up") ) light_up = 1;

	if ( light_up ) {
	write(obj->long());
	inv = all_inventory(obj);
	if( sizeof(inv) ) {
		inv = map_array(inv, "inventory_look", this_object() );
		message("vision", sprintf("柑Τ\n  %s\n",
			implode(inv, "\n  ") ), me);
	}
	}
	else
		return notify_fail("璶ぐ或\n");

	return 1;
}

int look_living(object me, object obj)
{
	string str, limb_status, pro;
	mixed *inv;
	mapping my_fam, fam;
	int light_up, i;

	light_up = environment(obj)->query("light_up");
	if ( light_up == -1 )
		light_up = 0;
	else
		light_up = 1;
	inv = all_inventory(me);
	for (i=0; i<sizeof(inv); i++)
		if ( inv[i]->query("light_up") ) light_up = 1;

	if ( light_up || me == obj ) {
	if( me!=obj ) {
		message("vision", "タ╪帝"+obj->name()+"ぃ笵ゴㄇぐ或種\n", me);
		tell_room(environment(me), me->name()+"タ╪帝"+obj->name()+"ぃ笵ゴㄇぐ或種\n", ({obj, me}));
		message("vision", me->name()+"タ╪帝ぃ笵ゴㄇぐ或種\n", obj); }

	str = obj->long();
	if ( obj->query("extra_long") ) str += obj->query("extra_long");

	pro = (obj==me) ? gender_self(obj->query("gender")) : gender_pronoun(obj->query("gender"));

	if( (string)obj->query("race")=="摸"
	&&	intp(obj->query("age")) )
		str += sprintf("%s癬ㄓ%s烦\n", pro, chinese_number(obj->query("age") / 10 * 10));

	// If we both has family, check if we have any relations.
	if( obj!=me
	&&	mapp(fam = obj->query("family"))
	&&	mapp(my_fam = me->query("family")) 
	&&	fam["family_name"] == my_fam["family_name"] ) {
	
		if( fam["generation"]==my_fam["generation"] ) {
			if( (string)obj->query("gender") == "╧┦" )
				str += sprintf( pro + "琌%s%s\n",
					my_fam["master_id"] == fam["master_id"] ? "": "",
					my_fam["enter_time"] > fam["enter_time"] ? "畍": "畍");
			else
				str += sprintf( pro + "琌%s%s\n",
					my_fam["master_id"] == fam["master_id"] ? "": "",
					my_fam["enter_time"] > fam["enter_time"] ? "畍﹋": "畍ゝ");
		} else if( fam["generation"] < my_fam["generation"] ) {
			if( my_fam["master_id"] == obj->query("id") )
				str += pro + "琌畍\n";
			else if( my_fam["generation"] - fam["generation"] > 1 )
				str += pro + "琌晋\n";
			else if( fam["enter_time"] < my_fam["enter_time"] )
				str += pro + "琌畍\n";
			else
				str += pro + "琌畍\n";
		} else {
			if( fam["generation"] - my_fam["generation"] > 1 )
				str += pro + "琌边晋\n";
			else if( fam["master_id"] == me->query("id") )
				str += pro + "琌\n";
			else
				str += pro + "琌畍\n";
		}
	}

	if( obj->query("mate") ) {
		if ( obj->query("gender") == "╧┦" )
			str += pro + "ヾ琌" + obj->query("mate") + "\n";
		if ( obj->query("gender") == "┦" )
			str += pro + "ひ琌" + obj->query("mate") + "\n"; }

	if( obj->query("max_kee") )
		str += pro + COMBAT_D->eff_status_msg((int)obj->query("eff_kee") * 100 / (int)obj->query("max_kee")) + "\n";

	inv = all_inventory(obj);
	if( sizeof(inv) ) {
		inv = map_array(inv, "inventory_look", this_object(), obj->is_corpse()? 0 : 1 );
		inv -= ({ 0 });
		if( sizeof(inv) )
			str += sprintf( obj->is_corpse() ? "%s框Τ\n%s\n" : "%sō盿帝\n%s\n",
				pro, implode(inv, "\n") );
	}

	message("vision", str, me);

	if( obj!=me 
	&&	living(obj)
	&&	random((int)obj->query("bellicosity")/10) > (int)me->query("per") ) {
		write( obj->name() + "礛锣筁繷ㄓ傈泊\n");
		COMBAT_D->auto_fight(obj, me, "berserk");
	}
	}
	else
		return notify_fail("璶ぐ或\n");

	return 1;
}

string inventory_look(object obj, int flag)
{
	string str;

	str = obj->short();
	if( obj->query("equipped") )
		str = HIC "  ＞" NOR + str;
	else if( !flag )
		str = "    " + str;
	else
		return 0;

	return str;
}

int look_room_item(object me, string arg)
{
	object env;
	mapping item, exits;

	if( !objectp(env = environment(me)) )
		return notify_fail("硂柑Τη累累ぐ或⊿Τ\n");

	if( mapp(item = env->query("item_desc")) && !undefinedp(item[arg]) ) {
		if( stringp(item[arg]) )
			write(item[arg]);
		else if( functionp(item[arg]) )
			write((string)(*item[arg])(me));
			
		return 1;
	}
	if( mapp(exits = env->query("exits")) && !undefinedp(exits[arg]) ) {
		if( objectp(env = find_object(exits[arg])) )
			look_room(me, env);
		else {
			call_other(exits[arg], "???");
			look_room(me, find_object(exits[arg]));
		}
		return 1;
	}
	return notify_fail("璶ぐ或\n");
}

int help (object me)
{
	write(@HELP
Α: look [<珇>|<ネ>|<よ>]
 
硂琵琩┮吏挂琘ン珇ネ┪琌よ
 
HELP
);
	return 1;
}
