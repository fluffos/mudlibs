// follow.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;

	if( !arg ) return notify_fail("Αfollow <琘>|none\n");

	if( arg=="none")
		if( me->query_leader() ) {
			me->set_leader(0);
			write("Ok.\n");
			return 1;
		} else {
			write("瞷⊿Τ蛤繦ヴ︙\n");
			return 1;
		}

	if( !objectp(ob = present(arg, environment(me))) )
		return notify_fail("硂柑⊿Τ " + arg + "\n");

	if( !ob->is_character() )
		return notify_fail("ぐ或蛤繦...." + ob->name() + "\n");

	if( ob==me )
		return notify_fail("蛤繦︑\n");

	me->set_leader(ob);
	message_vision("$N∕﹚秨﹍蛤繦$n癬︽笆\n", me, ob);

	return 1;
}

int help (object me)
{
        write(@HELP
Α : follow [<ネ>|none]
 
硂琵蛤繦琘┪ネ
狦块 follow none 玥氨ゎ蛤繦
 
HELP
);
        return 1;
}
