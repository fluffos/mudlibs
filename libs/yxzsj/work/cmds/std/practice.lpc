// practice.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string skillname;
	int skill, skill_basic;

	seteuid(getuid());
	if( me->is_fighting() )
		return notify_fail("竒驹矮い厩翴龟驹竒喷\n");

	if( !arg ) return (__DIR__"enable")->main(me, arg);

	if( !stringp(skillname = me->query_skill_mapped(arg)) )
		return notify_fail("絤策ノ enable ﹚疭м\n");

	skill_basic = me->query_skill(arg, 1);
	skill = me->query_skill(skillname, 1);

	if( skill < 1 )
		return notify_fail("钩临⊿厩穦硂兜м程叫毙\n");
	if( skill_basic < 1 )
		return notify_fail("癸硂よм临琌卢ぃ硄程眖眖膀セ厩癬\n");

	notify_fail("瞷ぃ絤策硂兜м\n");
	if( !SKILL_D(skillname)->valid_learn(me) ) return 0;

	notify_fail("刚帝絤策" + to_chinese(skillname) + "琌⊿Τヴ︙秈˙\n");
	if( SKILL_D(skillname)->practice_skill(me) ) {
		me->improve_skill(skillname, skill_basic/5 +1, skill_basic > skill? 0: 1);
		write( HIY "" + to_chinese(skillname) + "秈˙\n" NOR);
		return 1;
	}
	else return 0;
}

int help(object me)
{
	write(@TEXT
Αpractice <м贺摸>

硂琵絤策琘贺摸м硂мゲ斗琌竒筁 enable 盡穨м

狦癸硂よ膀セм镑蔼竒パ絤策钡どτど蛤
膀セм单Τ闽传杠弧对絤策琌ㄏ┮厩獵屡秤屡
斑硚畖讽礛硂ぇ玡ゲ斗眖龟悔笲ノい莉眔ì镑竒喷矗狜膀
セм
TEXT
	);
	return 1;
}
