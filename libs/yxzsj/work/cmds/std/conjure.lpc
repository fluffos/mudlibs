// conjure.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string spells, spl, trg;
	object target;
	
	seteuid(getuid());

	if( me->is_busy() )
		return notify_fail("( 笆临⊿ΤЧΘぃ琁甶硄)\n");

	if( environment(me)->query("no_magic") )
		return notify_fail("硂柑礚猭ㄏノ硄\n");

	if( !arg ) return notify_fail("Αconjure <硄> [on <ヘ夹>]\n");
	if( sscanf(arg, "%s on %s", spl, trg)==2 ) {
		target = present(trg, environment(me));
		if( !target ) target = present(trg, me);
		if( !target ) return notify_fail("硂柑⊿Τ " + trg + "\n");
	} else {
		spl = arg;
		target = 0;
	}

	spl = replace_string( spl, " ", "_");

	if( stringp(spells = me->query_skill_mapped("magic")) )
		return (int)SKILL_D(spells)->conjure_magic(me, spl, target);
		
	return notify_fail("叫ノ enable 匡拒璶ㄏノ硄╰\n");
}

int help (object me)
{
        write(@HELP
Αconjure <猭砃嘿> [on <癸禜>]
 
琁猭ゲ惠璶﹚<猭砃嘿><癸禜>玥Τ礚
ㄏノ琘猭砃ぇ玡ゲ斗ノ enable ㄓ﹚璶ㄏノ猭砃╰
 
HELP
        );
        return 1;
}
