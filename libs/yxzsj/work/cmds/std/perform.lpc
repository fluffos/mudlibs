// perform.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object weapon;
	string martial, skill;
	int result;
	
	seteuid(getuid());

	if( environment(me)->query("no_fight") )
		return notify_fail("硂柑ぃ驹矮\n");
	if( me->is_busy() )
		return notify_fail("( 笆临⊿ΤЧΘぃ琁ノ\)\n");

	if( !arg ) return notify_fail("璶ノ\暗ぐ或\n");

	if( sscanf(arg, "%s.%s", martial, arg)!=2 ) {
		if( weapon = me->query_temp("weapon") )
			martial = weapon->query("skill_type");
		else
			martial = "unarmed";
	}

	if( stringp(skill = me->query_skill_mapped(martial)) ) {
		notify_fail("┮ㄏノ\い⊿Τ硂贺\\n");
		if( SKILL_D(skill)->perform_action(me, arg) ) {
			if( random(120) < (int)me->query_skill(skill) )
				me->improve_skill(skill, 1, 1);
			return 1;
		} else if( SKILL_D(martial)->perform_action(me, arg) ) {
			if( random(120) < (int)me->query_skill(martial, 1) )
				me->improve_skill(martial, 1, 1);
			return 1;
		}
		return 0;
	}

	return notify_fail("叫ノ enable 匡拒璶ㄏノ\\n");
}

int help (object me)
{
        write(@HELP
Αperfrom [<猌贺摸>.]<┷Α嘿> [<琁ノ癸禜>]

狦┮厩(竲糃猭猭....)Τㄇ疭ю阑よΑ┪┷Α
ノ硂ㄓㄏノゲ斗ノ enable ﹚ㄏノ猌ぃ﹚猌贺
摸も琌竲ひㄏノ猌竟玥琌猌

璝琌いΤ贺摸ぃ琌┷Α嘿┪ぃ妮竲蛤猌竟м
猌(淮)ノ <猌>.<┷Α>  よΑ﹚

perform sword.powerfocus 
perform move.reflexion

传杠弧璶琌 enable い猌Τ疭┷Α常ノ硂ㄏノ
HELP
        );
        return 1;
}
