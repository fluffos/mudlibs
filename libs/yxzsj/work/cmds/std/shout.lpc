// shout.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if (!arg) return notify_fail("稱璶ぐ或?\n");
	shout( HIY+me->name() + "羇羘糞" + arg + "\n"+NOR);
	write(HIY"羇羘糞" + arg + "\n"NOR);
	return 1;
}
int help(object me)
{
  write(@HELP
Α : shout <癟>
 
硂琵盢 <癟> 肚癳, ┮Τタ笴栏い常
穦钮ǎ杠.
 
see also : tune
HELP
    );
    return 1;
}
 
