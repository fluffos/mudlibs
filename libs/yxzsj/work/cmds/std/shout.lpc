// shout.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!arg) return notify_fail("你想要大叫什麼?\n");
  shout(HIY + me->name() + "縱聲長嘯﹕" + arg + "\n" + NOR);
  write(HIY "你縱聲長嘯﹕" + arg + "\n" NOR);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : shout <訊息>
 
這個指令讓你將 <訊息> 傳送出去, 所有正在遊戲中的人都
會聽見你的話.
 
see also : tune
HELP
  );
  return 1;
}
