// get.c

#include <ansi.h>

inherit F_CLEAN_UP;

int do_get(object me, object ob);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string from, item;
	object obj, *inv, env, obj2;
	int i, amount;

	if( !arg ) return notify_fail("璶具癬ぐ或狥﹁\n");
	if( me->is_busy() )
		return notify_fail("笆临⊿ΤЧΘ\n");

	// Check if a container is specified.
	if( sscanf(arg, "%s from %s", arg, from)==2 ) {
		env = present(from, me);
		if(!env) env = present(from, environment(me));
		if(!env) return notify_fail("тぃ " + from + " 硂妓狥﹁\n");
		if(living(env) && (wiz_level(me) <= wiz_level(env)))
			return notify_fail("畍单ゲ斗ゑ癸よ蔼穓ō\n");
	} else env = environment(me);

	// Check if a certain amount is specified.
	if(sscanf(arg, "%d %s", amount, item)==2) {
		if( !objectp(obj = present(item, env)) )
			return notify_fail("硂柑⊿Τ硂妓狥﹁\n");
		if( !obj->query_amount() )
			return notify_fail( obj->name() + "ぃ砆だ秨ǐ\n");
		if( amount < 1 )
			return notify_fail("狥﹁计︓ぶ琌\n");
		if( amount > obj->query_amount() )
			return notify_fail("硂柑⊿Τê或" + obj->name() + "\n");
		else if( amount == (int)obj->query_amount() ) {
			return do_get(me, obj);
		} else {
			obj->set_amount( (int)obj->query_amount() - amount );
			obj2 = new(base_name(obj));
			obj2->move(env);			// For containers.
			obj2->set_amount(amount);
			// Counting precise amount costs more time.
			if( me->is_fighting() ) me->start_busy(3);
			return do_get(me, obj);
		}
	}

	// Check if we are makeing a quick get.
	if(arg=="all") {
		if( me->is_fighting() )	return notify_fail("临驹矮いΩ妓\n");
		if( !env->query_max_encumbrance() )	return notify_fail("êぃ琌甧竟\n");

		inv = all_inventory(env);
		if( !sizeof(inv) )
			return notify_fail("ê柑⊿Τヴ︙狥﹁\n");

		for(i=0; i<sizeof(inv); i++) {
			if( inv[i]->is_character() || inv[i]->query("no_get") ) continue;
			do_get(me, inv[i]);
		}
		write("Ok\n");
		return 1;
	}

	if( !objectp(obj = present(arg, env)) || living(obj) )
		return notify_fail("⊿Τ硂妓狥﹁\n");

	if( obj->query("no_get") )
		return notify_fail("硂狥﹁ぃ癬ㄓ\n");
	
	return do_get(me, obj);
}
	
int do_get(object me, object obj)
{
	object old_env, *enemy;
	int equipped;

	if( !obj ) return 0;
	old_env = environment(obj);

	if( obj->is_character() ) {
		if( living(obj) ) return 0;
		//	if( !userp(obj) && !obj->is_corpse() )
		//		return notify_fail("璉璽ㄤ產ō砰\n");
		// If we try to save someone from combat, take the risk :P
	} else {
		if( obj->query("no_get") ) return 0;
	}

	if( obj->query("equipped") ) equipped = 1;
	if( obj->move(me) ) {
		if( me->is_fighting() ) me->start_busy(1);
		if( obj->is_character() )
			message_vision( "$N盢$nн癬ㄓ串璉\n", me, obj );
		else
			message_vision( sprintf("$N%s%s$n\n", 
				old_env==environment(me)? "具癬":
					(old_env->is_character() ?
						"眖" + old_env->name() + "ō" + (equipped? "埃" : "穓"):
						"眖" + old_env->name() + "い"),
				obj->query("unit")), me, obj );
		return 1;
	}
	else return 0;
}

int help(object me)
{
	write(@HELP
Α : get <珇嘿> [from <甧竟>]
 
硂琵具癬┪甧竟ず琘妓珇.
 
HELP
    );
    return 1;
}
 
