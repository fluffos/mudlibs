// smash.c 2-22-95
 
#include "/doc/help.h"

inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	object ob;
	string name1, name2;

	if (!arg) return notify_fail("Α: smash <living>\n");
	ob = present(arg, environment(me));
	if (!ob) return notify_fail("тぃ硂ネ.\n");
	name1 = (string)me->query("name");
	name2 = (string)ob->query("name");
	tell_room(environment(me),
	name1+"蔼羭蛮も耻 р!, ǎぱ笵皗筿ぃ熬ぃ阑い"+name2+", 盢ぇて帮η聈.\n", 
	({me, ob}));
	tell_object(ob, name1+"蔼羭蛮も耻 р!, ǎぱ笵皗筿ぃ熬ぃ阑い.\n");
	
	write("蔼羭蛮も耻 ! 眖ぱ笵皗筿盢"+name2+"て帮η聈.\n");
	write("... 瞡!\n");
	ob -> die();
	return 1;
}
 
int help(object me)
{
   write(@HELP
Α: smash <ネ>
 
hehehehehe...........

HELP
   );
   return 1;
}
