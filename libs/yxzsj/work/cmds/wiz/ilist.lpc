// ilist.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;

	if( !arg ) return notify_fail("Αilist <ン┪郎>\n");

	ob = present(arg, me);
	if( !ob ) ob = present(arg, environment(me));
	if( !ob ) ob = find_object(resolve_path(me->query("cwd"), arg));
	if( !ob ) return notify_fail("⊿Τ硂妓ン┪硂妓ン⊿Τ砆更\n");

	printf("%O钡┪丁钡膥┯郎\n    %s\n", ob,
		implode(deep_inherit_list(ob), "\n    "));
	return 1;
}

int help (object me)
{
        write(@HELP
Α: ilist <ン┪郎>
 
ン┮膥┯┮Τン
 
HELP
);
        return 1;
}
 
