// summon command..

inherit F_CLEAN_UP;

int main(object me, string str)
{
	object ob;
	int i;
	if (!str) return notify_fail("<Syntax>: Summon <player id>\n");
	ob = LOGIN_D->find_body(str);
	if (!ob) return notify_fail("玿... Τ硂盾?\n");
	// moving
	tell_room(environment(ob),"ぱい唉もр"+
	(string)ob->query("name")+"ъ癬ㄓ, 礛ぃǎ.\n", ob);
	tell_object(ob,"唉もръ癬ㄓ, 泊玡皚堵....\n");
	ob->move(environment(me));
        tell_object(me, "р"+(string)ob->query("name")+"ъ玡.\n");
	tell_object(ob,".... 眶ㄓ祇瞷琌"+(string)me->query("name")+
	"р筁ㄓ.\n");
	tell_room(environment(ob),(string)ob->query("name")+"礛瞷"+
	"泊玡\n",({me,ob}));
	// ok ..
	return 1;
}

int help(object me)
{
write(@HELP
Α : summon <琘>

琵(﹑)盢琘ъ玡
HELP
    );
    return 1;
}
