// god command..

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str)
{
        object ob;
        int i;
        if (!str) ob =me; //return notify_fail("<Syntax>: god <player id>\n");
        else ob = LOGIN_D->find_body(str);
        if (!ob) return notify_fail( HIW "< ぃ硂 >\n" NOR );
        // moving
        message("system",
                HIW "\n\t\t\t< ┛ 礛 ぱ  皗 筁  笵  ▇ >\n\n\n\n"NOR,
                users() );
        tell_room(environment(ob), HIW "< 砛\ぱㄏр" HIY +
        (string)ob->query("name") + HIW "ъ癬ㄓ, 礛ぃǎ >\n" NOR , ob);
        tell_object(ob, HIW "<竤 " HIY "ぱㄏ"HIW "盢ъ癬.┕い >\n" NOR );
        if(ob==me)
	{
	if(me->query("born")=="狥よ")
	{
	me->move("/d/east/inn");
	}else{
	me->move("/d/west/recall");
	}}
        else ob->move(environment(me));
        ob->reincarnate();
        ob->set("water", me->max_water_capacity());
        ob->set("food", me->max_food_capacity());
        ob->set("kee", me->query("max_kee"));
        ob->set("gin", me->query("max_gin"));
        ob->set("sen", me->query("max_sen"));
        tell_object(me, HIG "< Θ\р" HIY +(string)ob->query("name")+ HIG "確 >.\n" NOR );
        tell_object(ob, HIW "< 眶ㄓ祇瞷琌" HIY +(string)me->query("name")+ 
        HIW  "р確 >\n" NOR );
        tell_room(environment(ob), HIG "< " + (string)ob->query("name") + HIW "砆碭︗ぱㄏ" +
        "篊篊眖ぱㄓ >\n" NOR ,({me,ob}));
        return 1;
}

