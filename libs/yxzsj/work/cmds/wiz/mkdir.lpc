// mkdir.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string dir;

	if(!arg) return help(me);

	dir = resolve_path(me->query("cwd"), arg);

	seteuid(geteuid(me));
	if( mkdir(dir) )
		write("Ok.\n");
	else
		write("⊿Τ硂柑ヘ魁舦\n");
	return 1;	
}

int help(object me)
{
	write(@HELP
Α : mkdir <ヘ魁>

ミヘ魁
HELP
	);
	return 1;
}
