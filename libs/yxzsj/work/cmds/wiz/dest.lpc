// dest.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string option, target, msg;

	object obj;

	if (!arg) return notify_fail("Α : dest <ンぇ嘿┪郎>\n" );

	if( sscanf(arg, "%s %s", option, target)!=2 ) target = arg;

	if( option == "-r" && (string)SECURITY_D->get_status(me)=="(admin)" )
		seteuid(ROOT_UID);
	else
		seteuid(geteuid(me));

	obj = find_object(target);
	if (!obj) obj = present(target, me);
	if (!obj) obj = present(target, environment(me));
	if (!obj) obj = find_object( resolve_path(me->query("cwd"), target) );
	if (!obj) return notify_fail("⊿Τ硂妓ン....\n");

	if( environment(me)==environment(obj) )
	if( !stringp(msg = me->query("env/msg_dest")) )
		msg = "$N酬堵瑌盢$n⊿\n";
	else
		message_vision(msg + "\n", me, obj);

	destruct(obj);
	if(obj) write("礚猭盢硂ン篟反\n");
	else write("Ok.\n");

	return 1;
}

int help(object me)
{
	write(@HELP
Α : dest [-r] <ンぇ嘿┪郎>

ノ盢ン(object)┪ン﹚竡(class)眖癘拘砰い睲埃璝睲埃
ン﹚竡(﹚郎薄猵)玥Ω把σ硂ン穦穝盢ウ絪亩

ㄣΤ (admin) ōだ畍ノ -r 匡兜 ROOT_UID ōだㄓ睲埃砆玂臔ン
ㄏノ

把σ戈 destruct()
HELP
    );
    return 1;
}
