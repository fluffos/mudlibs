// tail.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string file;

	seteuid(geteuid(me));
    if (!arg) return help(me);
	file = resolve_path(me->query("cwd"), arg);
	if( file_size(file)<0 ) return notify_fail("⊿Τ硂郎\n");
	tail(file);
	return 1;
}

int help(object me)
{
write(@HELP
Α : tail <郎>

琵(﹑)钡弄琘郎程ソЮ碭︽
HELP
    );
    return 1;
}
