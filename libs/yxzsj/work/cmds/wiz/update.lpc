#include "/doc/help.h"
inherit F_CLEAN_UP;
int update_player(object me);
int main(object me, string file)
{
	int i;
	object obj, *inv;
	string err;

	seteuid( geteuid(me) );

	if (!file) file = me->query("cwf");
	if (!file)
		return notify_fail("璶穝絪亩ぐ或郎\n");

	if( (obj = present(file, environment(me))) && interactive(obj) )
		return update_player(obj);

	if( file == "me" )
		return update_player(me);
        else if( file=="saveroom")
             file="/cmds/secr/saveroom.lpc";

	else {
		file = resolve_path(me->query("cwd"), file);
		if( !sscanf(file, "%*s.lpc") ) file += ".lpc"; 
	}

	if( file_size(file)==-1 )
		return notify_fail("⊿Τ硂郎\n");

	me->set("cwf", file);

	if (obj = find_object(file)) {
		if( obj==environment(me) ) {
			if( file_name(obj)==VOID_OB )
				return notify_fail("ぃ VOID_OB 柑穝絪亩 VOID_OB\n");
			inv = all_inventory(obj);
			i = sizeof(inv);
			while(i--)
				if( userp(inv[i]) ) inv[i]->move(VOID_OB, 1);
				else inv[i] = 0;
		}
		destruct(obj);
	}

	if (obj) return notify_fail("礚猭睲埃侣祘Α絏\n");

    write("穝絪亩 " + file + "");
	err = catch( call_other(file, "???") );
	if (err)
		printf( "祇ネ岿粇\n%s\n", err );
	else {
                write("Θ\n");
		if( (i=sizeof(inv)) && (obj = find_object(file))) {
			while(i--)
				if( inv[i] && userp(inv[i]) ) inv[i]->move(obj, 1);
		}
	}
		
	return 1;
}

int update_player(object me)
{
	object env, link_ob, obj;

	env = environment(me);

	// First, create the new body.
	link_ob = me->query_temp("link_ob");
	obj = LOGIN_D->make_body(link_ob);
	if (!obj) return 0;

	// Save the data and exec the player to his/her link object.
	me->save();
	exec(link_ob, me);
	destruct(me);

	// Restore new body and exec to it via enter_world in LOGIN_D
	obj->restore();
	write("ō砰穝Ч拨\n\n");
	LOGIN_D->enter_world(link_ob, obj, 1);

	obj->move(env);
	obj->write_prompt();
        "/cmds/std/wear"->main(obj,"all");    
        "/cmds/std/wield"->main(obj,"all");

	return 1;
}

int help(object me)
{
  write(@HELP
Α : update <郎|here|me|產>     (ex:update here)
 
硂穝郎, 盢穝郎ず甧更癘拘砰ず. 璝ヘ夹
'here' 玥穝┮吏挂. 璝ヘ夹 'me' 玥穝︑. 璝ヘ
夹產玥穝產ン.
 
HELP
    );
    return 1;
}
