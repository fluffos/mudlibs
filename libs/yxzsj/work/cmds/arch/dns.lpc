// dns.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me)
{
	int i;
	object obj, *inv;
	string file, err;

	file = "/adm/daemons/network/dns_master";

	seteuid( geteuid(me) );

	file = resolve_path(me->query("cwd"), file);
	if( !sscanf(file, "%*s.lpc") ) file += ".lpc"; 

	if( file_size(file)==-1 )
		return notify_fail("⊿Τ硂郎\n");

	me->set("cwf", file);

	if (obj = find_object(file)) {
		if( obj==environment(me) ) {
			if( file_name(obj)==VOID_OB )
				return notify_fail("ぃ VOID_OB 柑穝絪亩 VOID_OB\n");
			inv = all_inventory(obj);
			i = sizeof(inv);
			while(i--)
				if( userp(inv[i]) ) inv[i]->move(VOID_OB, 1);
				else inv[i] = 0;
		}
		destruct(obj);
	}

	if (obj) return notify_fail("礚猭睲埃侣祘Α絏\n");

    write("穝絪亩 " + file + "");
	err = catch( call_other(file, "???") );
	if (err)
		printf( "祇ネ岿粇\n%s\n", err );
	else {
		write("Θ\\n");
		if( (i=sizeof(inv)) && (obj = find_object(file))) {
			while(i--)
				if( inv[i] && userp(inv[i]) ) inv[i]->move(obj, 1);
		}
	}
	file = "/adm/daemons/network/name_server";

	seteuid( geteuid(me) );

	file = resolve_path(me->query("cwd"), file);
	if( !sscanf(file, "%*s.lpc") ) file += ".lpc"; 

	if( file_size(file)==-1 )
		return notify_fail("⊿Τ硂郎\n");

	me->set("cwf", file);

	if (obj = find_object(file)) {
		if( obj==environment(me) ) {
			if( file_name(obj)==VOID_OB )
				return notify_fail("ぃ VOID_OB 柑穝絪亩 VOID_OB\n");
			inv = all_inventory(obj);
			i = sizeof(inv);
			while(i--)
				if( userp(inv[i]) ) inv[i]->move(VOID_OB, 1);
				else inv[i] = 0;
		}
		destruct(obj);
	}

	if (obj) return notify_fail("礚猭睲埃侣祘Α絏\n");

    write("穝絪亩 " + file + "");
	err = catch( call_other(file, "???") );
	if (err)
		printf( "祇ネ岿粇\n%s\n", err );
	else {
		write("Θ\\n");
		if( (i=sizeof(inv)) && (obj = find_object(file))) {
			while(i--)
				if( inv[i] && userp(inv[i]) ) inv[i]->move(obj, 1);
		}
	}

		
	return 1;
}

int help(object me)
{
  write(@HELP
Α : dns
 
硂币笆DNS_Master(呼隔弘艶)
 
HELP
    );
    return 1;
}
 
