// command: qusr ( query player list & status)
#include <ansi.h>

inherit F_CLEAN_UP;
 
int main(object me, string str, string arg)
{
        int i,j=0,n,idle;
        int k;
        int z;
        object where;
        object *user_list,user_location;
        object *ob;
        string status1, status2, status3, status4; 
string status5;
        string msg;
        user_list=users();
        n=sizeof(user_list);
        write(sprintf("ヘ玡絬Τ %d 產虫\n",n));
        for(i=0;i<n;i++)
        {
                if(user_list[i])
                {
                        ob = users();
                        j++;
                        user_location = environment(user_list[i]);
/*
                        if (!user_location) return notify_fail("店礚钠缕丁\n");
*/

                        idle=query_idle(user_list[i]);
                if (in_input(user_list[i])) status1=HIC"(块ゅい)"NOR;
                        else status1="";
                if ((in_edit(user_list[i]))) status2=HIY"(絪胯郎い)"NOR;
                        else status2="";
                if (idle>180) status3=sprintf(HIR"(祇 %d だ牧)"NOR,idle/60);
                        else status3="";
                if (idle>3600) status4=sprintf(HIB"(祇 %d  %d だ牧)"NOR,idle/3600,(idle-3600)/60);
                        else status4="";
if(user_list[i]->query_temp("invis")==1) status5=HIY"(留ōい)"NOR;

else status5="";
                if (!user_location)
{
write(sprintf("%2d %12s %s(%s) ︗ %s(?????????)\n",
                        j,
                        SECURITY_D->get_status(user_list[i]),
                        user_list[i]->query("name"),
                        user_list[i]->query("id"),
//                        (string)user_location->query("short"),
                        "店礚钠缕丁" ));
if ((status1!="")||(status2!="")||(status3!="")||(status4!="")||(status5!=""))
write(sprintf("                    篈  : %s%s%s%s\n",status1,status2,status3,status4,status5));
write(sprintf("                眖 %s ㄓ矪\n",query_ip_name(ob[i])));
}
                else
{
write(sprintf("%2d %12s %s(%s) ︗ %s(%s)\n",
                        j,
                        SECURITY_D->get_status(user_list[i]),
                        user_list[i]->query("name"),
                        user_list[i]->query("id"),
                        (string)user_location->query("short"),
                        (string)file_name(user_location) ));
if((status1!="")||(status2!="")||(status3!="")||(status4!="")||(status5!=""))
write(sprintf("		       篈  : %s%s%s%s\n",status1,status2,status3,status4,status5));
write(sprintf("                眖 %s ㄓ矪\n",query_ip_name(ob[i])));
}
                }
        }
        z = j ;
        return 1;
}
 
int help(object me)
{
        write(@HELP
Α : qusr
琵(﹑)钡琩高ヘ玡絬┮Τ產(珹產)︗竚の篈
HELP);
        return 1;
}
