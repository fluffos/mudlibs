#include "/doc/help.h"
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        int i, j, w, col,key;
        string dir, v ,msg = "";
        mixed *file;
        mapping z ;

        seteuid(geteuid(this_player(1)));
        dir = resolve_path(me->query("cwd"), arg);
        if( file_size(dir)==-2 && dir[strlen(dir)-1] != '/' ) dir += "/";
        file = get_dir(dir, -1);
        if( !sizeof(file) ){
                if (file_size(dir) == -2) return notify_fail("ヘ魁琌\n");
                        else
                        return notify_fail("⊿Τ硂ヘ魁\n");
        }

        i = sizeof(file);
        z = allocate_mapping( i );
        w = 0;
        if(me->query("env/ls_time") == 1) key = 36;
        else key = 1;
        while(i--) {
                v = sprintf("%d",i);
                if (strlen(file[i][0])>w) w = strlen(file[i][0]) + key;

                if (file[i][1]==-2) {
                        file[i][0] = HIC + file[i][0];
                        file[i][0] += NOR + "/";
                        z[v]= 6;
                        continue ;
                }// if (file[i][1]==-2)

                if (file[i][1] != -2){
                        if(file[i][0][(strlen(file[i][0])-2)..(strlen(file[i][0]))] == ".lpc" ){
                                if(find_object(dir + file[i][0])){
                                        file[i][0] = HIG + file[i][0];
                                        file[i][0] += NOR+"*";
                                        z[v]= 6;
                                        continue ;
                                } else {
                                        file[i][0] = GRN + file[i][0];
                                        file[i][0] += NOR;
                                        z[v]= 6;
                                        continue ;
                                }
                                z[v]= 6;
                                continue ;
                        } else {
                                file[i][0] += NOR;
                                z[v]= 6;
                        }
                }// if (file[i][1] != -2)

        } // while
        write("瞷ヘ魁" + dir + " , Τ "+sizeof(file)+" 郎\n\n");
        if( file_size(dir+"README") > 0 && me->query("env/ls_intro") == 1)
                printf("%s\n",read_file(dir + "README"));
        col = 60 / (w+7);
        if (sizeof(file)){
                for(i=0, j = sizeof(file); i<j; i++){
                        v=sprintf("%d",i);
                        msg += sprintf("%3d %-*s%1s%s",file[i][1]/1024 + 1, w+1+z[v],
                        file[i][0],
                        (key == 36?ctime(file[i][2]):""),((i+1)%col)?"  ":"\n");
                }
           me->start_more(msg);
        }else write("⊿Τヴ︙郎\n");
        write("\n");

        return 1;
}

int help(object me)
{
        write(@HELP
Α: ls [<隔畖>]

ヘ魁┮Τヘ魁の郎, 狦⊿Τ﹚ヘ魁, 玥┮ヘ魁
ず甧┮郎い玡夹ボ * 腹琌竒更ン

絛ㄒ:
'ls /' 穦┮Τ︗ヘ魁郎のヘ魁.

HELP
        );
        return 1;
}
