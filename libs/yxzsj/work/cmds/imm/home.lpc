// home.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string msg,f;
	object ob;
        if(!arg)
	{if( file_size(user_path(geteuid(me)) + "workroom.lpc") <= 0 )
		return notify_fail("⊿Τ︑\n");

	if( stringp(msg = me->query("msg_home")) )
		message_vision(msg + "\n", me);
	me->move(user_path(geteuid(me)) + "workroom");
	}
	else {
	if( file_size("/u/"+arg[0..0]+"/"+arg + "/workroom.lpc") <= 0 )
	return notify_fail("⊿Τ硂\n");
	if( stringp(msg = me->query("msg_home")) )
	        message_vision(msg + "\n", me);
	                me->move("/u/"+arg[0..0]+"/"+arg + "/workroom");
	                        }
	return 1;
}

int help(object me)
{
  write(@HELP
Α : home ┪ home <畍>

ノ钡︑┪ㄤ畍,狦
⊿Τ︑,叫/u/ミ︑
狦Τ砞﹚ 'msg_home' property, 玥初常穦ê癟.
HELP
    );
    return 1;
}
