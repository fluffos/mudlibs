// status.c

inherit F_CLEAN_UP;

int main(object me,string arg)
{
	string msg;

	msg = (string)mud_status(arg=="detail" ? 1 : 0);
	if( stringp(msg) ) write(msg);

	return 1;
}

int help(object me)
{
  write(@HELP
Α : status [detail]
 
硂陪ボヘ玡笴栏ㄇ闽戈の猵.
 
HELP
    );
    return 1;
}
 
