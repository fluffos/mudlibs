// cd.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string dir;

	if( !arg )
		arg = user_path(me->query("id"));
	dir = resolve_path(me->query("cwd"), arg);
	if(file_size(dir)!=-2) return notify_fail("⊿Τ硂ヘ魁\n");

	if(dir[strlen(dir)-1]!='/') dir += "/";
	me->set("cwd", dir);
	write(dir + "\n");
	return 1;	
}

int help(object me)
{
	write(@HELP
Α : cd <ヘ魁>, cd .. , and cd

盢ヘ玡把σヘ魁簿︓﹚ヘ魁┪ヘ魁; ョ钡︑ヘ魁
HELP
	);
	return 1;
}
