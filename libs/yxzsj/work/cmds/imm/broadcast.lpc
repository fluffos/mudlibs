// broadcast.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if (!arg) return notify_fail("稱璶約冀ぐ或\n");
	shout(HIY+"約冀"+HIR+me->name()+HIY+"放琗弧"HIC""+NOR+arg+"\n");
	write(HIY+"約冀"+HIR+me->name()+HIY+"放琗弧"HIC""+NOR+arg+"\n");
	return 1;
}
int help(object me)
{
  write(@HELP
Α : broadcast <癟>
 
硂琵盢 <癟> 約冀, ┮Τタ笴栏い常
穦钮ǎ杠.
 
HELP
    );
    return 1;
}