// broadcast.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!arg) return notify_fail("你想要廣播什麼？\n");
  shout(HIY + "【廣播】" + HIR + me->name() + HIY + "溫柔的說" HIC "﹕" + NOR + arg + "\n");
  write(HIY + "【廣播】" + HIR + me->name() + HIY + "溫柔的說" HIC "﹕" + NOR + arg + "\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : broadcast <訊息>
 
這個指令讓你將 <訊息> 廣播出去, 所有正在遊戲中的人都
會聽見你的話.
 
HELP
  );
  return 1;
}
