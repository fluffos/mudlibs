// pwd.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if( !arg ) {
		write("Cwd: " + (string)me->query("cwd") +  "\n");
		write("Cwf: " + (string)me->query("cwf") +  "\n");
		return 1;
	}
}

int help(object me)
{
write(@HELP
Α : pwd
 
硂穦陪ボヘ玡ヘ魁 (cwd) の郎 (cwf).
'update' ぃ把计獽穦穝 cwf.
 
HELP
    );
    return 1;
}
