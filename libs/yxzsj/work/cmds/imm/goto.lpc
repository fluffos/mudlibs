// goto.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int goto_inventory = 0;
	object obj;
	string msg;

	if( !arg ) return notify_fail("璶柑\n");

	if( sscanf(arg, "-i %s", arg) ) goto_inventory = 1;

	if( !arg ) return notify_fail("璶柑\n");

	obj = find_player(arg);
	if(!obj) obj = find_living(arg);
	if(!obj || !me->visible(obj)) {
		arg = resolve_path(me->query("cwd"), arg);
		if( !sscanf(arg, "%*s.lpc") ) arg += ".lpc";
		if( !(obj = find_object(arg)) ) {
			if( file_size(arg)>=0 )
				return me->move(arg);
			return notify_fail("⊿Τ硂產ネ┪よ\n");
		}
	}

	if(!goto_inventory && environment(obj))
		obj = environment(obj);

	if( !obj ) return notify_fail("硂ン⊿Τ吏挂 goto\n");

    if( stringp(msg = me->query("env/msg_mout")) )
        message_vision(msg+"\n", me);
	else
		message_vision("ǎ皚废铭筁$Nō紇竒ぃǎ\n", me);

	me->move(obj);

	if( stringp(msg = me->query("env/msg_min")) )
        message_vision(msg+"\n", me);
	else
		message_vision("$Nō紇礛瞷皚废铭ぇい\n", me);

	return 1;
}

int help(object me)
{
write(@HELP
Α : goto [-i] <ヘ夹>
 
硂穦盢肚癳﹚ヘ夹. ヘ夹琌living ┪┬丁
郎. 狦ヘ夹琌living , 穦砆簿蛤ê妓吏挂.
狦Τ -i 把计ヘ夹琌 living, 玥穦砆簿赣 living 
 inventory い.
 
HELP
    );
    return 1;
}
