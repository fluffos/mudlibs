// wimpy.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	int wmp;

	if( !arg ) {
		write("瞷讽 " + (int)me->query("wimpy") 
			+ "% 碞穦纜刚発禲\n");
		return 1;
	}
	if( sscanf(arg, "%d", wmp)!=1 || wmp < 0 || wmp > 80)
		return help(me);

	me->set("wimpy", wmp);
	write("Ok.\n");
	return 1;
}

int help(object me)
{
	write(@HELP
Α wimpy [<発禲κだゑ>]

硂琵砞﹚讽逞κだぇぶ璶秨﹍锣秈
HELP
	);
	return 1;
}

