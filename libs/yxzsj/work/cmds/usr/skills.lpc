string *knowledge_level_desc = ({
	HIB "穝厩ノ" NOR,
	HIB "縮畖" NOR,
	HIB "菠" NOR,
	HIC "皑皑" NOR,
	HIC "ΤΘ" NOR,
	HIG "み烩穦" NOR,
	HIG "礛" NOR,
	HIG "僚礛砮硄" NOR,
	HIC "羭礚蛮" NOR,
	HIC "綺培さ" NOR,
/* 100+ */
	HIW "厩碔きó" NOR,
	HIW "翬晶" NOR,
	HIW "糯る" NOR,
	HIW "瓣礚蛮" NOR,
	HIW "ē瑄κん" NOR,
	HIW "搐胔筣" NOR,
	HIW "硄竒ノ" NOR,
	HIW "瞏ぃ代" NOR
});

string skill_level(string, int);

int main(object me, string arg)
{
	object ob;
	mapping skl, lrn, map;
	string *sname, *mapped;
	int i;

	seteuid(getuid());

	if(!arg)
		ob = me;
	else{
		ob = present(arg, environment(me));
//        if ( ob->query("SPSKILLS",1)  ) return ob->skills();		 
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if (!ob) return notify_fail("璶诡街м\n");
	}

	if( ob!=me && !wizardp(me) && !ob->is_apprentice_of(me)
	&& !me->is_apprentice_of(ob) )
		return notify_fail("Τ畍┪Τ畍畕闽玒诡м\n");

	skl = ob->query_skills();
	if(!sizeof(skl)) {
		write( (ob==me ? "" : ob->name()) + "ヘ玡⊿Τ厩穦ヴ︙м\n");
		return 1;
	}
	write( (ob==me ? "" : ob->name()) +"ヘ玡┮厩筁м\n\n");
	sname  = sort_array( keys(skl), (: strcmp :) );
	
	map = ob->query_skill_map();
	if( mapp(map) ) mapped = values(map);
	if( !mapped ) mapped = ({});

	lrn = ob->query_learned();
	if( !mapp(lrn) ) lrn = ([]);
	
	for(i=0; i<sizeof(skl); i++) {
		printf("%s%s%-40s" NOR " - "HIR"["NOR"%-10s"HIR"]"NOR" %3d/%5d\n", 
			(lrn[sname[i]] >= (skl[sname[i]]+1) * (skl[sname[i]]+1)) ? HIM : "",
			(member_array(sname[i], mapped)==-1? "  ": HIY"＞"NOR),
			to_chinese(sname[i]) + " (" + sname[i] + ")",
			skill_level(SKILL_D(sname[i])->type(), skl[sname[i]]),
			skl[sname[i]], (int)lrn[sname[i]],
		);
	}
	write("\n");
	return 1;
}

string skill_level(string type, int level)
{
	int grade;

	grade = level / 10;

	switch(type) {
		case "knowledge":
			grade = grade;
			if( grade >= sizeof(knowledge_level_desc) )
				grade = sizeof(knowledge_level_desc)-1;
			return knowledge_level_desc[grade];
		default:
			grade = grade;
			if( grade >= sizeof(skill_level_desc) )
				grade = sizeof(skill_level_desc)-1;
			return skill_level_desc[grade];
	}
}

int help(object me)
{
	write(@HELP
Α : skills [<琘>]

硂琵(﹑)琩高┮厩筁м

﹚㎝Τ畍畕闽玒癸禜ノ skills 琩癸よм猵

畍琩高ヴ︙┪ NPC м猵

HELP
    );
    return 1;
}
