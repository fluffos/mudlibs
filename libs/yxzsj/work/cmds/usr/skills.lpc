/* 100+ */
	HIC "摸┺笛" NOR,
	HIC "礚ゑ" NOR,
	HIC "Щ环礚京" NOR,
	HIY "ㄤм" NOR,
	HIY "て" NOR,
	HIC "祅畃硑伐" NOR,
