#include <ansi.h>
inherit F_CLEAN_UP;
 
void create() { seteuid(ROOT_UID); }

int main(object me, string str)
{
    printf(BOLD "%s" NOR "%s\n", RANK_D->query_rank(me), me->short(1));
    return 1;
}
 
int help(object me)
{
    write(@HELP
Α: title
 
陪ボヘ玡顶㎝繷晃
 
HELP
    );
return 1;
}
 
