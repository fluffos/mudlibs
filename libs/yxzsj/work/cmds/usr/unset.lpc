// unset.c

inherit F_CLEAN_UP;

int help();

int main(object me, string arg)
{
	if( !arg || arg=="" ) return help();

	me->delete("env/" + arg);
	write("Ok.\n");
	return 1;
}

int help()
{
	write(@TEXT
Αunset <跑计>

硂琵埃吏挂跑计砞﹚

э跑计砞﹚叫ノ unset 
TEXT
	);
	return 1;
}
