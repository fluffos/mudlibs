// finger.c

inherit F_CLEAN_UP;

void create()
{
	seteuid(getuid());
}

int main(object me, string arg)
{
	if( !arg ) {
		if( (int)me->query("sen") < 50 )
			return notify_fail("弘礚猭栋い\n");
		if( !wizardp(me) )
			me->receive_damage("sen", 50);
		write( FINGER_D->finger_all() );
	} else {
		if( (int)me->query("sen") < 15 )
			return notify_fail("弘礚猭栋い\n");
		if( !wizardp(me) )
			me->receive_damage("sen", 15);
		write( FINGER_D->finger_user(arg) );
	}
	return 1;
}

int help(object me)
{
  write(@HELP
Α : finger [ㄏノ﹎]
 
硂, 狦⊿Τ﹚ㄏノ﹎, 穦陪ボ┮Τタ絬產
硈絬戈. はぇ, 玥陪ボΤ闽琘產硈絬, 舦单戈.
 
see also : who
HELP
    );
    return 1;
}
 
