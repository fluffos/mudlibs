// semote.c
 
#include "/doc/help.h"
 
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
        string *e, chinese, buf;
        mapping e_map;
        int i;
 
        seteuid(geteuid(me));
        e = sort_array(EMOTE_D->query_all_emote(), 1);
 
        buf = "ヘ玡笆(emote)粂猭Τ\n";
        for(i=0; i<sizeof(e); i++) {
                e_map = EMOTE_D->query_emote(e[i]);
                buf += sprintf("%-8s %-10s ",
                        (stringp(e_map["chinese"])?
                                replace_string(e_map["chinese"], "\n", ""):
                                ""
                        ), e[i]
                );
                if (i%4 == 3) buf += "\n";
        }
        buf += "\n";
        this_player()->start_more(buf);
        return 1;
}
 
int help(object me)
{
  write(@HELP
Αsemote
 
硂ヘ玡┮Τㄏノ笆(emote)粂猭
 
闽emote . chat* rumor*
HELP
    );
    return 1;
}
