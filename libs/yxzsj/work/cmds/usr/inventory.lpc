//inventory.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int i;
  object *inv, ob;

  if (wizardp(me) && arg) {
    ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) ob = present(arg, environment(me));
  }

  if (!ob) ob = me;

  inv = all_inventory(ob);
  if (!sizeof(inv)) {
    write((ob == me) ? "目前你身上沒有任何東西。\n"
      : ob->name() + "身上沒有攜帶任何東西。\n");
    return 1;
  }
  printf("%s身上帶著下列這些東西 ( 負重 %d%% )：\n%s",
    (ob == me) ? "你" : ob->name(),
    (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance(),
    implode(map_array(inv, "inventory_desc", this_object()), ""));


  return 1;
}

string inventory_desc(object ob) {
  if (ob->query("equipped") && this_player()->query("env/eqs"))
    return "";
  return sprintf("%s%s\n",
    ob->query("equipped") ? HIC "ˇ" NOR : "  ",
    ob->short()
  );
}

int help(object me) {
  write(@HELP
指令格式: inventory
 
可列出你(妳)目前身上所攜帶的所有物品。
 
註 : 此指令可以 " i " 代替。
 
HELP
  );
  return 1;
}
