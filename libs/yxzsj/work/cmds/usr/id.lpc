// id.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int i, j;
	object obj, *inv;
	string *id;

	if( !arg ) {
		inv = all_inventory(me);
		if( !sizeof(inv) )
			return notify_fail("ō⊿Τヴ︙狥﹁\n");
        write( "(﹑)ō拟盿珇嘿(よ) :\n");
		for(i=0; i<sizeof(inv); i++) {
			if( !me->visible(inv[i]) ) continue;
			printf("%-20s = %s\n", inv[i]->name(),
				implode(inv[i]->parse_command_id_list(), ", ") );
		}
		return 1;
	}

	if( arg=="here" ) {
		inv = all_inventory(environment(me));
		if( !sizeof(inv) )
			return notify_fail("硂柑⊿Τヴ︙狥﹁\n");
        write( "硂┬丁い, ネの珇(璣ゅ)嘿 :\n");
		for(i=0; i<sizeof(inv); i++) {
			if( !me->visible(inv[i]) ) continue;
			printf("%-20s = %s\n", inv[i]->name(),
				implode(inv[i]->parse_command_id_list(), ", ") );
		}
		return 1;
	}
}
int help(object me)
{
write(@HELP
Α : id [here]
 
硂琵笵珇璣ゅ嘿の. ゴ id 穦陪ボ
ō┮拟盿珇嘿. 'id here' 玥陪ボ┮Τ蛤
吏挂柑ン嘿.
 
HELP
    );
    return 1;
}
 
