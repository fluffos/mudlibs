// semote.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string *e, output, temp;
	mapping emote;
	int i, j, length;

      e = sort_array(EMOTE_D->query_all_emote(), 1);
	output = "現在逸俠世界的表情指令有：\n";

	for(i=0; i<sizeof(e)-1; i++)
		{
		emote = EMOTE_D->query_emote(e[i]);
		temp = emote["name"];
		if( !temp ) temp = "0        ";
		length = strlen(temp);
		if( length < 9 )
			for( j=1; j<=9-length; j++)
				temp = temp + " ";
		output = output + temp;
		temp = e[i];
		length = strlen(temp);
		if( length < 11 )
			for( j=1; j<=11-length; j++)
				temp = temp + " ";
		output = output + temp;
		if( i % 4 == 3 )
			output = output + "\n";
		}
	output = output + "\n";
	me->start_more( output );
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : semote

這個指令可以列出目前所能使用的emote.
HELP
    );
    return 1;
}
