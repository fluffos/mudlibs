// describe.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string *txt;

	if( !arg ) return notify_fail("Αdescribe <磞瓃>\n");

	txt = explode(arg, "\n");
	if( sizeof(txt) > 8 )
		return notify_fail("叫盢眤癸︑磞瓃北︽ず\n");

	arg = implode(txt, "\n") + "\n";

	me->set("extra_long", arg);
	write("Ok.\n");
	return 1;
}

int help()
{
	write(@TEXT
Αdescribe <磞瓃>

硂琵砞﹚讽ノ look 癸磞瓃硄盽讽
磞瓃禬筁︽ノ to describe よΑㄓ块
TEXT
	);
	return 1;
}
