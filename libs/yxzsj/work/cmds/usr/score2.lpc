#include <ansi.h>
#include <combat.h>


inherit F_CLEAN_UP;

string status_color(int current, int max);
string date_string(int date);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
        object ob;
        mapping my;
        string line, str, skill_type;
        string ridon;
        object weapon;
        int attack_points, dodge_points, parry_points;

        seteuid(getuid(me));

        if(!arg)
                ob = me;
        else if (wizardp(me)) {
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
                if (!ob) return notify_fail("璶诡街篈\n");
        } else
                return notify_fail("Τ畍诡篈\n");
/*--------------------------------------------------------------------------*/
        my = ob->query_entire_dbase();  //暗戈锣传.

line = sprintf( BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(ob), ob->short(1) );
line += sprintf(
" 单: %2d    闹: %2d 烦   ┦: %-2s\n"NOR
" 戮穨: %-2s    贺壁: %-2s    秈顶戮穨: %-2s\n"NOR,
 ob->query("level"),
 ob->query("age"),
 ob->query("gender"),
(ob->query("class")?RANK_D->query_class(ob):"礚"),
ob->query("race"),
ob->query("adv_class2")?RANK_D->query_advclass(ob):"礚",
  //CHINESE_D->chinese_date(((int)ob->query("birthday") - 14*365*24*60) * 60)
                 );

/*-------------------------------------------------------------*/
        if( objectp(weapon = ob->query_temp("weapon")) )
                skill_type = weapon->query("skill_type");
        else
skill_type = "unarmed";
 attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
 parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
 dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

 line += sprintf(
" 秖(str)%-3d          ネ㏑%s%4d/%4d\n"NOR
" ︐ψ(mus)%-3d          臸猭%s%4d/%4d\n"NOR
" 砰借(con)%-3d          ず%s%4d/%4d\n"NOR
" ┦(int)%-3d          砰%s%4d/%4d\n"NOR
" 庇倍(dex)%-3d          竒喷%s%d\n"NOR
" 笲(lck)%-3d          ㏑い瞯%s%d\n"NOR
" 玪(air)%-3d          皗跟瞯%s%d\n"NOR
" 醇紌(wis)%-3d             \n"NOR
" 端甡%s+%-3d"NOR"            杆称ň縨%s+%-3d\n"NOR,
ob->query_str(),
status_color(my["hp"], my["max_hp"]), my["hp"], my["max_hp"],
ob->query("mus"),
status_color(my["mp"],my["max_mp"]),my["mp"],my["max_mp"],
ob->query_con(),
status_color(my["force"], my["max_force"]), my["force"], my["max_force"],
ob->query_int(),
status_color(my["ap"],my["max_ap"]),my["ap"],my["max_ap"],
ob->query_dex(),
HIW,ob->query("exp"),
ob->query("lck"),
HIR,attack_points/50 + 1,
ob->query("air"),
HIY,(dodge_points + (weapon? parry_points: (parry_points/10)))/50 + 1,
ob->query_wis(),
HIR,ob->query_temp("apply/damage")+ob->query_temp("apply/hit"),
HIC,ob->query_temp("apply/armor"),
);

 line += sprintf(
"\n 阑炳 NPC 计[%s%d"NOR"] 管 [%s%d"NOR"]︗產艶活\n"NOR
,HIY,my["MKS"] + my["PKS"],HIR, my["PKS"]);

// line += sprintf(" 洛 励 竒 喷 %s%d\n" NOR,HIG,ob->query("healexp") );
//line += sprintf(" 臸 猭 竒 喷 %s%d\n" NOR,HIG,ob->query("magicexp"));
if((me->query("platinum")<1)&&(me->query("gold")<1)&&(me->query("silver")<1)&&(me->query("coin")<1))
{
line +=sprintf(" ō⊿を窥\n");write(line);return 1;
write(line);
return 1;
}
else
{
if(me->query("platinum")>0)
line +=sprintf(" フ:%d\n",ob->query("platinum"));
if(me->query("gold")>0) line+=sprintf(" 刽:%d\n",ob->query("gold"));
if(me->query("silver")>0) line+=sprintf(" 蝗刽:%d\n",ob->query("silver"));
if(me->query("coin")>0) line+=sprintf(" 簧狾:%d\n",ob->query("coin"));
write(line);
return 1;
}
  line += sprintf(HIW" 篈: %s \n",HIW"タ盽"NOR);
        write(line);
return 1;
}


string status_color(int current, int max)
{
        int percent;

        if( max ) percent = current * 100 / max;
        else percent = 100;

        if( percent > 100 ) return HIC;
        if( percent >= 90 ) return HIG;
        if( percent >= 60 ) return HIY;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return HIR;
        return RED;
}

