// sc.c
//fix By Sammy@MDoor
#include <ansi.h>
#include <combat.h>


inherit F_CLEAN_UP;

string status_color(int current, int max);
string date_string(int date);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob;
  mapping my;
  string line, str, skill_type;
  string ridon;
  object weapon;
  int attack_points, dodge_points, parry_points;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看誰的狀態﹖\n");
  } else
    return notify_fail("只有巫師能察看別人的狀態。\n");
  /*--------------------------------------------------------------------------*/
  my = ob->query_entire_dbase();  //做資料轉換.

  line = sprintf(BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(ob), ob->short(1));
  line += sprintf(
    " 等級: %2d 級   年齡: %2d 歲   性別: %-2s\n" NOR
    " 職業: %-2s    種族: %-2s    進階職業: %-2s\n" NOR,
    ob->query("level"),
    ob->query("age"),
    ob->query("gender"),
    (ob->query("class") ? RANK_D->query_class(ob) : "無"),
    ob->query("race"),
    ob->query("adv_class2") ? RANK_D->query_advclass(ob) : "無",
    //CHINESE_D->chinese_date(((int)ob->query("birthday") - 14*365*24*60) * 60)
  );

  /*-------------------------------------------------------------*/
  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";
  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

  line += sprintf(
    " 力量(str)﹕%-3d          生命﹕%s%4d/%4d\n" NOR
    " 肌肉(mus)﹕%-3d          魔法﹕%s%4d/%4d\n" NOR
    " 體質(con)﹕%-3d          內力﹕%s%4d/%4d\n" NOR
    " 悟性(int)﹕%-3d          體力﹕%s%4d/%4d\n" NOR
    " 敏捷(dex)﹕%-3d          經驗值﹕%s%d\n" NOR
    " 運氣(lck)﹕%-3d          命中率﹕%s%d\n" NOR
    " 氣勁(air)﹕%-3d          閃躲率﹕%s%d\n" NOR
    " 智慧(wis)﹕%-3d             \n" NOR
    " 傷害值﹕%s+%-3d" NOR "            裝備防禦﹕%s+%-3d\n" NOR,
    ob->query_str(),
    status_color(my["hp"], my["max_hp"]), my["hp"], my["max_hp"],
    ob->query("mus"),
    status_color(my["mp"], my["max_mp"]), my["mp"], my["max_mp"],
    ob->query_con(),
    status_color(my["force"], my["max_force"]), my["force"], my["max_force"],
    ob->query_int(),
    status_color(my["ap"], my["max_ap"]), my["ap"], my["max_ap"],
    ob->query_dex(),
    HIW, ob->query("exp"),
    ob->query("lck"),
    HIR, attack_points / 50 + 1,
    ob->query("air"),
    HIY, (dodge_points + (weapon ? parry_points : (parry_points / 10))) / 50 + 1,
    ob->query_wis(),
    HIR, ob->query_temp("apply/damage") + ob->query_temp("apply/hit"),
    HIC, ob->query_temp("apply/armor"),
  );

  line += sprintf(
    "\n 擊殺 NPC 數﹕[%s%d" NOR "] ﹐奪取 [%s%d" NOR "]位玩家靈魂\n" NOR
    , HIY, my["MKS"] + my["PKS"], HIR, my["PKS"]);

  // line += sprintf(" 醫 療 經 驗﹕ %s%d\n" NOR,HIG,ob->query("healexp") );
  //line += sprintf(" 魔 法 經 驗﹕ %s%d\n" NOR,HIG,ob->query("magicexp"));
  if ((me->query("platinum") < 1) && (me->query("gold") < 1) && (me->query("silver") < 1) && (me->query("coin") < 1)) {
    line += sprintf(" 你身上沒半毛錢\n"); write(line); return 1;
    write(line);
    return 1;
  } else {
    if (me->query("platinum") > 0)
      line += sprintf(" 白金:%d\n", ob->query("platinum"));
    if (me->query("gold") > 0) line += sprintf(" 金幣:%d\n", ob->query("gold"));
    if (me->query("silver") > 0) line += sprintf(" 銀幣:%d\n", ob->query("silver"));
    if (me->query("coin") > 0) line += sprintf(" 銅板:%d\n", ob->query("coin"));
    write(line);
    return 1;
  }
  line += sprintf(HIW " 狀態: %s \n", HIW "正常" NOR);
  write(line);
  return 1;
}


string status_color(int current, int max) {
  int percent;

  if (max) percent = current * 100 / max;
  else percent = 100;

  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

int help(object me) {
  write(@HELP
指令格式 : sc
           sc <對象名稱>                   (巫師專用)

這個指令可以顯示你(妳)或指定對象(含怪物)的基本資料。
基本資料的設定請參閱 'help setup'。

為了避免玩家為了「天賦」的數值而反覆創造人物﹐因此限定只有在綜合評價達到
100 以上的玩家或巫師才看得到天賦狀況。

see also : hp
HELP
  );
  return 1;
}
