// gender.c

string gender_self(string sex)
{
	switch(sex) {
		case "┦": return "﹑";	break;
		default: return "";
	}
}

string gender_pronoun(string sex)
{
	switch(sex) {
		case "い┦":	return "廷";	break;
		case "╧┦":	return "";	break;
		case "┦":	return "";	break;
		case "动┦":
		case "慧┦":	return "╡";	break;
		default: return "ウ";
	}
}

