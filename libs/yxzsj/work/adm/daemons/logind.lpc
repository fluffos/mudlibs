// logind.c

#include <ansi.h>
#include <command.h>
#include <login.h>

inherit F_DBASE;

int wiz_lock_level = WIZ_LOCK_LEVEL;
string *banned_name = ({
	"", "﹑", "и", "", "", "╡", "ウ",
	"ェ畊疭焊",
});

private void get_id(string arg, object ob);
private void confirm_id(string yn, object ob);
object make_body(object ob);
private void init_new_player(object user);
varargs void enter_world(object ob, object user, int silent);
varargs void reconnect(object ob, object user, int silent);
object find_body(string name);
int check_legal_id(string arg);
int check_legal_name(string arg);

void create() 
{
	seteuid(getuid());
	set("channel_id", "硈絬弘艶");
}

void logon(object ob)
{
	object *usr;
	int i, wiz_cnt, ppl_cnt, login_cnt;

	cat(WELCOME);
	UPTIME_CMD->main();

	usr = users();
	wiz_cnt = 0;
	ppl_cnt = 0;
	login_cnt = 0;
	for(i=0; i<sizeof(usr); i++) {
		if( !environment(usr[i]) ) login_cnt++;
		else if( wizardp(usr[i]) ) wiz_cnt++;
		else ppl_cnt++;
	}
	printf("[1;35m秇獿[m10ヘ玡Τ %d ︗產絬の %d ︗ㄏノ沽刚硈絬い\n\n",
		ppl_cnt, login_cnt );

	write("眤璣ゅ");
	input_to( (: get_id :), ob );
}

private void get_id(string arg, object ob)
{
	object ppl;


	arg = lower_case(arg);
	if( !check_legal_id(arg)) {
		write("眤璣ゅ");
		input_to("get_id", ob);
		return;
	}

#ifdef MAX_USERS 
	if( (string)SECURITY_D->get_status(arg)=="(player)"
	&& sizeof(users()) >= MAX_USERS ) {
		ppl = find_body(arg);
		// Only allow reconnect an interactive player when MAX_USERS exceeded.
		if( !ppl || !interactive(ppl) ) {
			write("癸ぃ癬" + MUD_NAME + "ㄏノ竒び叫穦ㄓ\n");
			destruct(ob);
			return;
		}
	}
#endif

	if( wiz_level(arg) < wiz_lock_level ) {
		write("癸ぃ癬" + MUD_NAME + "ヘ玡畍单 " + WIZ_LOCK_LEVEL
			+ " 硈絬\n");
		destruct(ob);
		return;
	}
	
	if( (string)ob->set("id", arg) != arg ) {
		write("Failed setting user name.\n");
		destruct(ob);
		return;
	}

	if( arg=="guest" ) {
		// If guest, let them create the character.
		confirm_id("Yes", ob);
		return;
	} else if( file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0 ) {
		if( ob->restore() ) {
			write("叫块盞絏");
			input_to("get_passwd", 1, ob);
			return;
		}
		write("眤纗咀ㄇ拜肈叫ノ guest 硄畍矪瞶\n");
		destruct(ob);
		return;
	}

	write("ㄏノ " + (string)ob->query("id") + " 硂盢穦承硑穝眤絋﹚盾(y/n)");
	input_to("confirm_id", ob);
}

private void get_passwd(string pass, object ob)
{
	string my_pass;
	object user;

	write("\n");
	my_pass = ob->query("password");
	if( crypt(pass, my_pass) != my_pass ) {
		write("盞絏岿粇\n");
		destruct(ob);
		return;
	}

	// Check if we are already playing.
	user = find_body(ob->query("id"));
	if (user) {
		if( user->query_temp("netdead") ) {
			reconnect(ob, user);
			return;
		}
		write("眤璶盢硈絬い话τぇ盾(y/n)");
		input_to("confirm_relogin", ob, user);
		return;
	}

	if( objectp(user = make_body(ob)) ) {
		if( user->restore() ) {
			log_file( "USAGE", sprintf("%s loggined from %s (%s)\n", user->query("name"),
				query_ip_name(ob), ctime(time()) ) );
			enter_world(ob, user);
			return;
		} else {
			destruct(user);
		}
	}
	write("叫眤穝承硑硂\n");
	confirm_id("y", ob);
}

private void confirm_relogin(string yn, object ob, object user)
{
	object old_link;

	if( yn=="" ) {
		write("眤璶盢硈絬い话τぇ盾(y/n)");
		input_to("confirm_relogin", ob, user);
		return;
	}	

	if( yn[0]!='y' && yn[0]!='Y' ) {
		write("舧Ωㄓ\n");
		destruct(ob);
		return;
	} else {
		tell_object(user, "Τ眖矪( " + query_ip_number(ob)
			+ " )硈絬┮北\n");
		log_file( "USAGE", sprintf("%s replaced by %s (%s)\n", user->query("name"),
			query_ip_name(ob), ctime(time()) ) );
	}

	// Kick out tho old player.
	old_link = user->query_temp("link_ob");
	if( old_link ) {
		exec(old_link, user);
		destruct(old_link);
	}

	reconnect(ob, user);	
}

private void confirm_id(string yn, object ob)
{
	if( yn=="" ) {
		write("ㄏノ硂盢穦承硑穝眤絋﹚盾(y/n)");
		input_to("confirm_id", ob);
		return;
	}	

	if( yn[0]!='y' && yn[0]!='Y' ) {
		write("ê或叫穝块眤璣ゅ");
		input_to("get_id", ob);
		return;
	}

	write("眤いゅ");
	input_to("get_name", ob);
}

private void get_name(string arg, object ob)
{
	if( !check_legal_name(arg) ) {
		write("眤いゅ");
		input_to("get_name", ob);
		return;
	}

	printf("%O\n", ob);
	ob->set("name", arg);
	write("叫砞﹚眤盞絏");
	input_to("new_password", 1, ob);
}

private void new_password(string pass, object ob)
{
	write("\n");
	if( strlen(pass)<5 ) {
		write("盞絏︓ぶ璶きじ叫砞眤盞絏");
		input_to("new_password", 1, ob);
		return;
	}
	ob->set("password", crypt(pass,0) );
	write("叫块Ω眤盞絏絋粄眤⊿癘岿");
	input_to("confirm_password", 1, ob);
}

private void confirm_password(string pass, object ob)
{
	string old_pass;
	write("\n");
	old_pass = ob->query("password");
	if( crypt(pass, old_pass)!=old_pass ) {
		write("眤ㄢΩ块盞絏ぃ妓叫穝砞﹚Ω盞絏");
		input_to("new_password", 1, ob);
		return;
	}

	write("眤筿秎ン");
	input_to("get_email",  ob);
}

private void get_email(string email, object ob)
{
	object user;

	ob->set("email", email);

	// If you want do race stuff, ask player to choose one here, then you can
	// set the user's body after the question is answered. The following are
	// options for player's body, so we clone a body here.
	ob->set("body", USER_OB);
	if( !objectp(user = make_body(ob)) )
		return;

	write("眤璶ш簍╧┦(m)à︹┪┦(f)à︹");
	input_to("get_gender", ob, user);
}

private void get_gender(string gender, object ob, object user)
{
	if( gender=="" ) {
		write("眤璶ш簍╧┦(m)à︹┪┦(f)à︹");
		input_to("get_gender", ob, user);
		return;
	}

	if( gender[0]=='m' || gender[0]=='M' )
		user->set("gender", "╧┦");
	else if( gender[0]=='f' || gender[0]=='F' )
		user->set("gender", "┦" );
	else {
		write("癸ぃ癬眤匡拒╧┦(m)┪┦(f)à︹");
		input_to("get_gender", ob, user);
		return;
	}

	log_file( "USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
		query_ip_name(ob), ctime(time()) ) );
	init_new_player(user);
	enter_world(ob, user);
}

object make_body(object ob)
{
	string err;
	object user;
	int n;

	user = new(ob->query("body"));
	if(!user) {
		write("瞷Τタэㄏノン祘Α礚猭秈︽狡籹\n");
		write(err+"\n");
		return 0;
	}
	seteuid(ob->query("id"));
	export_uid(user);
	export_uid(ob);
	seteuid(getuid());
	user->set("id", ob->query("id"));
	user->set_name( ob->query("name"), ({ ob->query("id")}) );
	return user;
}

private void init_new_player(object user)
{
	user->set("title", "炊硄κ﹎");
	user->set("birthday", time() );
	user->set("potential", 99);

	user->set("str", 10 + random(21));
	user->set("cps", 10 + random(21));
	user->set("int", 10 + random(21));
	user->set("cor", 10 + random(21));
	user->set("con", 10 + random(21));
	user->set("spi", 10 + random(21));
	user->set("per", 10 + random(21));
	user->set("kar", 10 + random(21));

	user->set("food", user->max_food_capacity());
	user->set("water", user->max_water_capacity());

	user->set("channels", ({ "chat" }) );
}

varargs void enter_world(object ob, object user, int silent)
{
	object cloth, room;
	string startroom;

	user->set_temp("link_ob", ob);
	ob->set_temp("body_ob", user);
	exec(user, ob);

	write("ヘ玡舦" + wizhood(user) + "\n");
	user->setup();

	// In case of new player, we save them here right aftre setup 
	// compeleted.
	user->save();
	ob->save();

	cloth = new("/obj/cloth");
	cloth->move(user);
	cloth->wear();

	if( !silent ) {
		cat(MOTD);
		if( ob->query("new_mail") ) {
	write(  "\n秇獿い厩恨瞶禗Τ眤獺叫矫ㄓ诫...\n\n" );
			ob->set("new_mail", 0);
		}
		if( user->is_ghost() )
			startroom = DEATH_ROOM;
		else if( !stringp(startroom = user->query("startroom")) )
			startroom = START_ROOM;

		if( !catch(load_object(startroom)) )
			user->move(startroom);
		else {
			user->move(START_ROOM);
			startroom = START_ROOM;
			user->set("startroom", START_ROOM);
		}
		tell_room(startroom, user->query("name") + "硈絬秈硂\n",
			({user}));
	}
	CHANNEL_D->do_channel( this_object(), "sys",
		sprintf("%sパ%s硈絬秈", user->name(), query_ip_name(user)) );
	UPDATE_D->check_user(user);
}

varargs void reconnect(object ob, object user, int silent)
{
	user->set_temp("link_ob", ob);
	ob->set_temp("body_ob", user);
	exec(user, ob);

	user->reconnect();
	if( !silent ) {
		tell_room(environment(user), user->query("name") + "穝硈絬硂\n",
		({user}));
	}
	CHANNEL_D->do_channel( this_object(), "sys",
		sprintf("%sパ%s穝硈絬秈", user->query("name"), query_ip_name(user)) );
	UPDATE_D->check_user(user);
}

int check_legal_id(string id)
{
	int i;

	i = strlen(id);
	
	if( (strlen(id) < 3) || (strlen(id) > 12 ) ) {
		write("癸ぃ癬璣ゅゲ斗琌 3  12 璣ゅダ\n");
		return 0;
	}
	while(i--)
		if( id[i]<'a' || id[i]>'z' ) {
			write("癸ぃ癬璣ゅノ璣ゅダ\n");
			return 0;
		}

	return 1;
}

int check_legal_name(string name)
{
	int i;

	i = strlen(name);
	
	if( (strlen(name) < 2) || (strlen(name) > 12 ) ) {
		write("癸ぃ癬いゅゲ斗琌 1  6 いゅ\n");
		return 0;
	}
	while(i--) {
		if( name[i]<=' ' ) {
			write("癸ぃ癬いゅぃノ北じ\n");
			return 0;
		}
		if( i%2==0 && !is_chinese(name[i..<0]) ) {
			write("癸ぃ癬叫眤ノいゅ\n");
			return 0;
		}
	}
	if( member_array(name, banned_name)!=-1 ) {
		write("癸ぃ癬硂贺穦硑Θㄤ耑\n");
		return 0;
	}

	return 1;
}

object find_body(string name)
{
	object ob, *body;

	if( objectp(ob = find_player(name)) )
		return ob;
	body = children(USER_OB);
	for(int i=0; i<sizeof(body); i++)
		if( clonep(body[i])
		&&	getuid(body[i]) == name ) return body[i];

	return 0;
}

int set_wizlock(int level)
{
	if( wiz_level(this_player(1)) <= level )
		return 0;
	if( geteuid(previous_object()) != ROOT_UID )
		return 0;
	wiz_lock_level = level;
	return 1;
}
