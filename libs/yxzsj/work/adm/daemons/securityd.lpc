// /adm/daemons/securityd.c

#include <login.h>

inherit F_DBASE;

private mapping wiz_status;

// By Annihilator@Eastern.Stories (11/25/94)

// This is the "effective" access status compare to the "status" property
// in login object that this mapping determine wizards' access rights
// directly. It is important to make the "status" property matches this
// mapping for wizards higher than regular wizard such as sage, arch and
// admin. For thoese users whose name doesnot appear in this mapping, they
// are divided into three groups (wizard),(player) and (object) using
// wizardp() and interactive() efun.
// The parenthesis is nessessary to prevend players naming themself "admin"
// to hack the security system.
//
// 01/14/95 Annihilator - wiz_status are defined outside this daemon in the
//                        WIZLIST file.

// 設定權限等級
private string *wiz_levels = ({
  "(player)",
  "(immortal)",
  "(apprentice)",
  "(wizard)",
  "(arch)",
  "(admin)"
});

// A valid write attempt must pass 2 checks: your uid or status must not be
// "excluded" and must be "trusted" on that directory in order to write in
// that directory. The directories containing the file is searched backward
// from the current directory to root. And exclude is checked prior than
// trusted.

// 設定寫入權限
private mapping trusted_write = ([
  "/": ({ "Root", "(admin)", "(arch)", "(wizard)" }),
  "adm": ({ "Root", "(admin)" }),
  "binaries": ({ "Root", "(admin)" }),
  "cmds": ({ "Root", "(admin)" }),
  "d": ({ "Root", "(admin)", "(arch)", "(wizard)" }),
  "daemon": ({ "Root", "(admin)", "(arch)" }),
  "doc": ({ "Root", "(admin)", "(arch)" }),
  "feature": ({ "Root", "(admin)" }),
  "ftp": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)" }),
  "include": ({ "Root", "(admin)" }),
  "inherit": ({ "Root", "(admin)" }),
  "log": ({ "Root", "(admin)" }),
  "obj": ({ "Root", "(admin)", "Domain" }),
  "u": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)" }),
  "www": ({ "Root", "(admin)", "(arch)", "Domain" }),
]);

// 設定拒絕寫入
private mapping exclude_write = ([
  "/": ({ "(apprentice)", "(immortal)" }),
  "adm": ({ "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "binaries": ({ "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "cmds": ({ "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "d": ({ "(apprentice)", "(immortal)" }),
  "daemon": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "doc": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "feature": ({ "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "ftp": ({ "(immortal)" }),
  "include": ({ "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "inherit": ({ "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "log": ({ "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "obj": ({ "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "u": ({ "(immortal)" }),
  "www": ({ "(wizard)", "(apprentice)", "(immortal)" }),
]);

// 設定可讀權限
mapping trusted_read = ([
  "/": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "adm": ({ "Root", "(admin)", "(arch)", "Domain" }),
  "binaries": ({ "Root", "(admin)", "(arch)", "Domain" }),
  "cmds": ({ "Root", "(admin)", "(arch)", "Domain" }),
  "d": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)", "(immortal)", "Domain" }),
  "daemon": ({ "Root", "(admin)", "(arch)", "(wizard)", "Domain" }),
  "data": ({ "Root", "(admin)", "(arch)", "Domain" }),
  "doc": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)", "(immortal)" }),
  "feature": ({ "Root", "(admin)", "(arch)", "Domain" }),
  "include": ({ "Root", "(admin)", "(arch)", "Domain" }),
  "inherit": ({ "Root", "(admin)", "(arch)", "Domain" }),
  "log": ({ "Root", "(admin)", "(arch)" }),
  "obj": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)", "Domain" }),
  "u": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)" }),
  "u/m/msr": ({ "msr", "krishna" }),
  "u/k/krishna": ({ "msr", "krishna" }),
  "www": ({ "Root", "(admin)", "(arch)" }),
]);

// 設定拒絕讀取
private mapping exclude_read = ([
  "/": ({}),
  "adm": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "binaries": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "cmds": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "d": ({}),
  "daemon": ({ "(apprentice)", "(immortal)" }),
  "data": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "doc": ({}),
  "feature": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "include": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "inherit": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "log": ({ "(wizard)", "(apprentice)", "(immortal)" }),
  "obj": ({}),
  "u": ({ "(immortal)" }),
  "u/m/msr": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)", "Domain" }),
  "u/k/krishna": ({ "Root", "(admin)", "(arch)", "(wizard)", "(apprentice)", "Domain" }),
  "www": ({ "(wizard)", "(apprentice)", "(immortal)" }),
]);

void create() {
  string *wizlist, wiz_name, wiz_level;
  int i;

  seteuid(getuid());
  set("channel_id", "安全系統(Security)");

  wizlist = explode(read_file(WIZLIST), "\n");
  wiz_status = allocate_mapping(sizeof(wizlist));
  for (i = 0; i < sizeof(wizlist); i++) {
    if (wizlist[i][0] == '#'
      || sscanf(wizlist[i], "%s %s", wiz_name, wiz_level) != 2) continue;
    wiz_status[wiz_name] = wiz_level;
  }
}

string *query_wizlist() { return keys(wiz_status); }

// This function returns the status of an uid.
string get_status(mixed ob) {
  string euid;

  if (objectp(ob)) {
    euid = geteuid(ob);
    if (!euid) euid = getuid(ob);
  } else if (stringp(ob)) euid = ob;

  if (!mapp(wiz_status)) return "(player)";
  if (!undefinedp(wiz_status[euid])) return wiz_status[euid];
  else if (member_array(euid, wiz_levels) != -1) return euid;
  return "(player)";
}

int get_wiz_level(object ob) {
  return member_array(get_status(ob), wiz_levels);
}

int set_status(mixed ob, string status) {
  string uid, *wiz, wizlist, old_status;
  int i;
  object me;
  me = this_player();

  if (geteuid(previous_object()) != ROOT_UID) return 0;

  if (userp(ob)) uid = getuid(ob);
  else if (stringp(ob)) uid = ob;
  else return 0;

  old_status = wiz_status[uid];
  if (!old_status) old_status = "(player)";
  if (status == old_status)
    return write("同等級物件不用再次修改。\n");

  if (status == "(player)")
    map_delete(wiz_status, uid);
  else
    wiz_status[uid] = status;
  wiz = keys(wiz_status);
  for (wizlist = "", i = 0; i < sizeof(wiz); i++)
    wizlist += wiz[i] + " " + wiz_status[wiz[i]] + "\n";
  rm(WIZLIST);
  write_file(WIZLIST, wizlist);
  log_file("nosave/promotion", ob->query("name") + "(" + capitalize(uid) + ")"
    + " 權限等級由 " + old_status + " 更改為 " + status + " ，修改權限者 "
    +me->query("name") + "(" + capitalize(geteuid(me)) + ") 於 " + ctime(time()) + "\n");
  return 1;
}

string *get_wizlist() { return keys(wiz_status); }

// valid_write - called by the master object to determine whether if an user
//               is allowed to write on a certain file.
// NOTE:
//     The argument user should be an object according to the source code
// of driver. However, it is a mixed type in the released docs. We assume
// it is an object in normal case here and issue an error if it was not
// an object.                                                                                           - Annihilator

int valid_write(string file, mixed user, string func) {
  string euid, status, *path, dir, id;
  int i;
  /*
        CHANNEL_D->do_channel(this_object(), "sys",
                sprintf("valid_write: %s, %O, %s", file, user, func));
*/
  // Let user save their save file
  if (func == "save_object") {
    if (sscanf(base_name(user), "/obj/%*s")
      && sscanf(file, "/data/%*s")
      && file == (string)user->query_save_file() + __SAVE_EXTENSION__)
      return 1;
  }

  // 取得使用者目前的權限
  // Get the euid and status of the user.
  if (!(euid = geteuid(user))) return 0;
  status = get_status(user);

  // 允許擁有 ROOT_UID 的物件寫入任何檔案
  if (euid == ROOT_UID || euid == "root") return 1;

  path = explode(file, "/") - ({ "" });
  if (file[0] != '/') file = "/" + file;

  // 允許巫師寫入自己的目錄
  if (sizeof(path) >= 3 && euid[0] >= 'a' && euid[0] <= 'z'
    && path[0] == "u" && path[1] == euid[0..0] && path[2] == euid) return 1;

  if (sscanf(file, "/u/%*s/%s/%*s", id)) {
    if (wiz_level(user) < wiz_level(id)) return 0;
  }

  // 允許 SIMUL_EFUN_OB 寫入 /log 檔
  if (file == SIMUL_EFUN_OB && path[0] == "log") return 1;

  if (sscanf(file, LOG_DIR + "%*s") && func == "write_file") return 1;

  // 檢查是否有「阻卻寫入」的情形
  // Check if we are excluded in one of the directories containing the file.
  for (i = sizeof(path) - 1; i >= 0; i--) {
    dir = implode(path[0..i], "/");
    if (undefinedp(exclude_write[dir])) continue;
    if (member_array(euid, exclude_write[dir]) != -1
      || (member_array(status, exclude_write[dir]) != -1))
      return userp(user) ? 0 : valid_write(file, this_player(1), func);
  }

  // 檢查是否有「允許寫入」的設定
  // And then check if we are trusted in one of the directories containing
  // the file.
  if (member_array(euid, trusted_write["/"]) != -1) return 1;
  if (member_array(status, trusted_write["/"]) != -1) return 1;
  for (i = sizeof(path) - 1; i >= 0; i--) {
    dir = implode(path[0..i], "/");
    if (undefinedp(trusted_write[dir])) continue;
    if (member_array(euid, trusted_write[dir]) != -1) return 1;
    if (member_array(status, trusted_write[dir]) != -1) return 1;
  }
  return 0;
}

int valid_read(string file, mixed user, string func) {
  object ob;
  string euid, status, *path, dir, id;
  int i;
  /*
        CHANNEL_D->do_channel(this_object(), "sys",
                sprintf("valid_read: %s, %O, %s", file, user, func));
*/
  if (!objectp(user)) return 1;

  // 允許使用者讀檔
  if (func == "restore_object") {
    if (sscanf(base_name(user), "/obj/%*s")
      && sscanf(file, "/data/%*s")
      && file == (string)user->query_save_file() + __SAVE_EXTENSION__)
      return 1;
  }

  // 取得使用者目前的權限
  // Get the euid and status of the user.
  if (!(euid = geteuid(user))) return 0;
  status = get_status(user);

  // 允許擁有 ROOT_UID 的物件讀出任何檔案
  if (euid == ROOT_UID || euid == "root") return 1;

  path = explode(file, "/") - ({ "" });
  if (file[0] != '/') file = "/" + file;

  // 允許巫師讀出自己的目錄
  if (sizeof(path) >= 3 && euid[0] >= 'a' && euid[0] <= 'z'
    && path[0] == "u" && path[1] == euid[0..0] && path[2] == euid) return 1;

  if (sscanf(file, "/u/%*s/%s/%*s", id)) {
    if (wiz_level(user) < wiz_level(id)) return 0;
  }

  // 允許 SIMUL_EFUN_OB 讀出 /log 檔
  if (file == SIMUL_EFUN_OB && path[0] == "log") return 1;

  if (sscanf(file, LOG_DIR + "%*s") && func == "read_file") return 1;

  for (i = sizeof(path) - 1; i >= 0; i--) {
    dir = implode(path[0..i], "/");
    // 檢查是否有「允許讀取」的情形
    if (!undefinedp(trusted_read[dir])) {
      //                      if(dir == "d" && euid=="root") return 1;  // root 對 /d 目錄的特殊讀取權
      if (member_array(euid, trusted_read[dir]) != -1) return 1;
      if (member_array(status, trusted_read[dir]) != -1) return 1;
    }
    // 檢查是否有「阻卻讀取」的情形
    if (!undefinedp(exclude_read[dir])) {
      if (member_array(euid, exclude_read[dir]) != -1) return 0;
      if (member_array(status, exclude_read[dir]) != -1) return 0;
    }
  }
  return 1;
}

int valid_seteuid(object ob, string euid) {
#ifdef DEBUG
  if (this_player() && wizardp(this_player()))
    printf("SECURITY_D: seteuid: %O(%s) %s\n", ob, getuid(ob), euid);
#endif

  if ((euid == 0)
    || (euid == getuid(ob))
    || (getuid(ob) == ROOT_UID)
    || (wiz_level(ob) >= wiz_level(euid)))
    return 1;

  return 0;
}
