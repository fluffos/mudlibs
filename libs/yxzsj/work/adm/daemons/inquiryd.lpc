// inquiryd.c
// Created by Annihilator@ES2 (01-19-95)

// This function handles the default inquiry between ppls and npcs to
// make npc more talktive. This is the '<me> ask <ob> about <topic>'
// case.

#include <ansi.h>

int parse_inquiry(object me, object ob, string topic)
{
	switch( topic ) {
		case "name":
			message_vision( CYN "$N$n拜笵幢拜" + RANK_D->query_respect(ob)
				+ "碙﹎\n" NOR, me, ob);
			return 1;
		case "here":
			message_vision(CYN "$N$n拜笵硂︗" + RANK_D->query_respect(ob)
				+ "" + RANK_D->query_self(me) + "禥腳ぃ硂柑Τㄇぐ或薄\n" NOR,
				me, ob);
			return 1;
		case "rumors":
			message_vision(CYN "$N$n拜笵硂︗" + RANK_D->query_respect(ob)
				+ "ぃ程Τ⊿Τ钮弧ぐ或\n" NOR, me, ob);
			return 1;
		default:
			return 0;
	}
}
