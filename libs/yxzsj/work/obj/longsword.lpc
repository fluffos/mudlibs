// sword.c : an example weapon

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("糃", ({ "sword" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
		set("long", "硂琌р癬讽炊硄糃秖Τㄓょオ\n");
		set("value", 400);
		set("material", "steel");
		set("wield_msg", "$N詜羘┾р$n搐もい\n");
		set("unwield_msg", "$N盢もい$n础竬丁糃繲\n");
	}
	init_sword(25);
	setup();
}
