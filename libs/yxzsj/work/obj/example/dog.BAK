// dog.c

inherit NPC;

void create()
{
	set_name("偿", ({ "dog" }) );
	set("race", "偿脋");
	set("age", 3);
	set("long", "唉待ō偶ぜぜ偿\n");
	
	set("str", 24);
	set("cor", 26);

	set("combat_exp", 1);
	set("limbs", ({ "繷场", "ō砰", "玡竲", "竲", "Юぺ" }) );
	set("verbs", ({ "bite", "claw" }) );
	
	set_temp("apply/attack", 10);
	set_temp("armor", 3);

	setup();
}
