// drooler.c
//
// This is an example of interactive npc which applied relay_say, relay_emote
// and relay_channel to collect information.
//
// By Annihilator@Celestial.Empire (09/15/95)

#include <ansi.h>

inherit NPC;

string *first_name = ({ "化","窥","甝","","㏄","","綠","","眎","朝",
	"糂","狶" });
string *name_words = ({ "抖","","","祇","癩","玊","","▆","в","┚",
	"У","动","痲","睰","","谨","","脖","秤","秈","","褐","","骸",
	"碔","窾","纒","订","不","瓷","瓣","货","关" });

string *rnd_id = ({"ra","ma","ta","pu","gu","du","so","po","lo","phi","tri","ne","she"});
string *rnd_id_tail = ({"ng","gh","ss","h","le","d","ck","m","tte"});

string *rnd_say = ({
	"и琌穝も叫禗и︙硂笴栏",
	"ぐ或и弘常ぃ穦確",
	"Τ街倒иㄇ窥",
	"硂柑常ぃ瞶и",
	"ぃ禗и柑絤\",
	"hi",
	"hello",
	"hmm",
	"wa...",
	"waley",
	"wait...",
	"hohoho",
	"hehe",
	"ah..",
});

varargs void drool(string msg, string who);

void create()
{
	string name, id;

	name = first_name[random(sizeof(first_name))];
	name += name_words[random(sizeof(name_words))];
	if( random(10) > 2 ) name += name_words[random(sizeof(name_words))];

	id = rnd_id[random(sizeof(rnd_id))];
	if( random(10) > 4 ) id += rnd_id[random(sizeof(rnd_id))];
	id += rnd_id_tail[random(sizeof(rnd_id_tail))];

	set_name(name, ({ id, "drooler" }) );
	set("title", "炊硄κ﹎");
	set("gender", "╧┦");
	set("age", 14);
	set("attitude", "friendly");
	set("combat_exp", 100);
	set("env/wimpy", 100);
	set("chat_chance", 30);
	set("chat_msg", ({
		(: command, "get all" :),
		(: command, "wear all" :),
		(: command, "wield all" :),
		(: drool :),
		(: drool :),
		(: drool :),
		(: drool :),
		(: drool :),
	}) );
	setup();
	if( clonep() ) CHANNEL_D->register_relay_channel("chat");
}

int add_phrase(string who, string msg)
{
	msg = replace_string(msg, "?", "");
	msg = replace_string(msg, "", "");
	msg = replace_string(msg, "", "");
	msg = replace_string(msg, "!", "");
	msg = replace_string(msg, "", "");
	msg = replace_string(msg, "摆", "");
	msg = replace_string(msg, "盾", "");
	msg = replace_string(msg, "瑿", "");
	msg = replace_string(msg, "", "");

	if( msg!="" ) {
		add("memory/" + who, ({ msg }));
		return 1;
	} else return 0;
}

string make_reply()
{
}

void relay_channel(object ob, string channel, string msg)
{
	string who, phrase;

	if( !userp(ob) || (channel != "chat") ) return;
	who = ob->query("name");

	// Don't process our own speech.
	if( ob==this_object() ) return;

	if( add_phrase(who, msg) &&	random(10) > 4 )
		drool(msg, ob->query("name"));
}

void relay_say(object ob, string msg)
{
	string who, phrase;

	if( !userp(ob) ) return;
	who = ob->query("name");

	// Don't process our own speech.
	if( ob==this_object() ) return;

	if( add_phrase(who, msg) &&	random(10) > 4 )
		drool(msg, ob->query("name"));
}

void relay_emote(object ob, string verb)
{
	if( !userp(ob) ) return;

	switch(verb) {
	case "kick":
		if( random(10)<5 ) {
			command("say ぐ或金и穦礹瑿");
			break;
		}
	default:
		if( random(10)<5 )
			command(verb + " " + ob->query("id"));
		else
			drool();
	}
}

varargs void drool(string msg, string who)
{
	mapping mem;
	string *ob;

	mem = query("memory");
	if( !mapp(mem) ) return;

	if( !msg || !who) {
		ob = keys(mem);
		who = ob[random(sizeof(ob))];
		msg = mem[who][random(sizeof(mem[who]))];
	}

	if( (strsrch(msg, "ぐ或") >= 0) ) {
		if( sscanf(msg, "%*sぐ或%s", msg)==2 ) msg = "ぐ或" + msg;
		switch(random(8)) {
		case 0: command("say " + who + "琌拜и盾"); break;
		case 1: command("say 闽" + msg + " ... "); break;
		case 2: command("say  ... "); drool(); break;
		case 3: command("say 硂拜肈估 ...."); break;
		case 4: command("say " + who + "笵硂拜肈氮癸ê或璶盾"); break;
		case 5: command("say " + msg + ""); break;
		case 6: command("say " + who + "ぃ弧睲贰翴"); break;
		case 7: command("say " + who + "иぃ来拜拜肈"); break;
		}
	}
	else if( (strsrch(msg, "") >= 0)
	||	(strsrch(msg, "﹑") >= 0)
	||	(strsrch(msg, "drooler") >= 0)
	||	(strsrch(msg, "Drooler") >= 0)) {
		if( sscanf(msg, "%*s%s", msg) == 2 ) msg = "" + msg;
		msg = replace_string(msg, "", "и");
		msg = replace_string(msg, "﹑", "и");
		switch(random(10)) {
		case 0:	command("say " + who + "琌弧" + msg + "盾");	break;
		case 1:	command("say 絋﹚" + msg + "");	break;
		case 2:	command("say " + msg + "蛤Τぐ或闽玒");	break;
		case 3:	command("say 垛 ... " + who + "弧眔"); break;
		case 4:	command("say " + who + "ぐ或癸" + msg + "硂或Τ砍届"); break;
		case 5:	command("say ぐ或粄" + msg + ""); break;
		case 6:	command("say 传杠肈"); drool(); break;
		case 7:	command("say ┣"); break;
		case 8:	command("say ぃ﹚"); break;
		case 9:	command("say Τ硂 ...."); break;
		}
	}
	else if( (strsrch(msg, "и") >= 0)) {
		if( sscanf(msg, "%*sи%s", msg) == 2 ) msg = "и" + msg;
		msg = replace_string(msg, "и", "");
		msg = replace_string(msg, "?", "");
		switch(random(8)) {
		case 0:	command("say 琌弧" + msg + "盾"); break;
		case 1:	command("say 痷" + msg + "");	break;
		case 2:	command("say 狦" + msg + "и腊ぐ或Γ盾");	break;
		case 3:	command("hmm");	break;
		case 4:	command("say 粄" + msg + ""); break;
		case 5:	command("say иΤ稰"); break;
		case 6:	command("say 弧" + msg + "иぃ璭"); break;
		case 7:	command("say Τ闽" + msg + "杠肈ゎ盾"); break;
		}
	} else {
		switch(random(20)) {
			case 0: command("say ぐ或弧" + msg + "?"); break;
			case 1: command("say " + msg + "琌ぐ或種"); break;
			case 2: command("say " + msg + ""); break;
			case 3: command("grin"); break;
			case 4: command("smile"); break;
			case 5: command("?"); break;
			case 6: command("say ...."); break;
			case 7: command("hmm"); break;
			case 8: command("say " + rnd_say[random(sizeof(rnd_say))]); break;
			case 9: command("say 或笵" + msg + "?"); break;
			case 10: command("say " + who + "ぃ琌弧" + msg); break;
			case 11: command("say и讽礛笵" + msg); break;
			case 12: command("say 礛㎡"); break;
			case 13: command("say 痷盾"); break;
			case 14: command("say иぃ硂或粄"); break;
			default:
				break;
		}
	}
}

void reset()
{
	delete("memory");
}

int accept_object()
{
	return 1;
}
