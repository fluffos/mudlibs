// dart.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("灭", ({ "dart" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"灭琌贺だ盽ǎ穞竟\n");
		set("unit", "ㄇ");
		set("base_unit", "狵");
		set("base_weight", 40);
		set("base_value", 5);
	}
	set_amount(1);
	init_throwing(20);
	setup();
}
