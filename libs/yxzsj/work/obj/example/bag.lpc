// bag.c

inherit ITEM;

void create()
{
	set_name("ガ砋", ({ "bag" }) );
	set_weight(500);
	set_max_encumbrance(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "");
		set("long", "硂琌碝盽ガ砋ノㄓ杆ㄇ馒\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
