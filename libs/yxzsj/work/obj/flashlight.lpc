// flashlight.c

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIY"も筿旦"NOR, ({ "flashlight", "flash", "light" }) );
	set("weight", 500);
	set("long", "硂琌рΤノも筿旦腊堵穞い酚砰\n"
			"璶ゴ秨も筿旦叫ゴ(open_light)璶闽超叫ゴ(close_light)\n");
	set("value", 200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "р");
	}
	set("battery_usage", 2);
	setup();
}

void init()
{
	add_action("do_open_light", "open_light");
	add_action("do_close_light", "close_light");
}

int using_battery()
{
	set("power", query("power") - 10);
	if ( query("power") == query("max_power") / 5 ) message_vision(YEL"$Nもも筿旦縊秨﹍皗脅舊睭竒ノ奔砛\筿\n"NOR, this_player());
	if ( query("power") <= 0 ) {
		message_vision(YEL"$Nもも筿旦縊ǔ硉舊睭ㄓ皗碭縊碞防筿竒ノЧ\n"NOR, this_player());
		set("power", 0);
		set("light_up", 0); }
	if ( query("power") ) call_out("using_battery", 10);
}

int do_open_light()
{
	if ( query("light_up") ) return notify_fail("も筿旦竒ゴ秨\n");
	if ( !query("power") ) {
		message_vision("$N刚帝璶ゴ秨も筿旦秨闽琌も筿旦⊿Τは莱\n", this_player());
		return 1; }
	message_vision(HIY"$Nゴ秨も筿旦秨闽も筿旦獹癬ㄓ酚㏄砰\n"NOR, this_player());
	set("light_up", 1);
	using_battery();
	return 1;
}

int do_close_light()
{
	if ( !query("light_up") ) return notify_fail("も筿旦竒闽\n");
	message_vision(YEL"$N闽も筿旦秨闽も筿旦穞ㄓ\n"NOR, this_player());
	set("light_up", 0);
	return 1;
}