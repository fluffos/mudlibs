// mind_bug.c

inherit NPC;

void create()
{
	set_name("芠稱挛", ({ "mind bug", "bug" }) );
	set("race", "偿脋");
	set("age", 3);
	set("long", "硂琌唉パ笵馒├忽┮て芠稱挛穦鸟︘活緕\n");
	
	set("str", 24);
	set("cor", 26);

	set("max_kee", 140);
	set("max_gin", 250);
	set("max_sen", 600);

	set("limbs", ({ "繷场", "ō砰", "玡竲", "竲", "Юぺ" }) );
	set("verbs", ({ "bite", "claw" }) );
	
	if( this_player() ) {
		set("combat_exp", (int)this_player()->query_skill("spells", 1) * 500);
		set("bellicosity", this_player()->query("bellicosity"));
	}

	set_temp("apply/attack", 30);
	set_temp("apply/armor", 10);

	setup();
}

void die()
{
	string owner;
	object owner_ob;

	owner = query("owner");

	if( objectp(owner_ob = find_player(owner)) ) {
		if( (object)query_temp("last_damage_from") != owner_ob ) {
			tell_object(owner_ob, "芠稱挛砆炳\n谋眔皚ぱ臂锣....\n");
			owner_ob->unconcious();
		} else {
			tell_object(owner_ob, "炳芠稱挛眖いㄇ〨砃笵瞶\n");
			owner_ob->improve_skill("spells", random((int)owner_ob->query("spi")/2)+1);
		}
	}
	::die();
}
