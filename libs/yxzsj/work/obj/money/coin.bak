// coin.c

inherit MONEY;

void create()
{
	set_name("窥", ({"coin", "coins", "coin_money" }));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "coin");
		set("long", "硂琌瑈硄い虫︗程砯刽璶κゅ窥眔ㄢ蝗\n");
		set("unit", "ㄇ");
		set("base_value", 1);
		set("base_unit", "ゅ");
		set("base_weight", 1);
	}
	set_amount(1);
}

