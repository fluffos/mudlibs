// gold.c

inherit MONEY;

void create()
{
	set_name("独", ({"gold", "ingot", "gold_money"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "gold");
		set("long", "独坚坚ǎ稲摆°°\n");
		set("unit", "ㄇ");
		set("base_value", 10000 );
		set("base_unit", "旷");
		set("base_weight", 37);
	}
	set_amount(1);
}

