// glass.c

inherit EQUIP;

void create()
{
	set_name("驹矮贝代竟", ({ "detector", "glass", "device" }) );
	set_weight(300);
	set("unit", "");
	set("long",
		"硂琌ㄓ︑纒痌驹矮贝代竟ノウㄓ贝代(detect)\n"
		"驹矮\n");
	set("value", 500);
	set("type", "misc");
	set("apply", ([
		"繷场":	0,
	]) );
}

void init()
{
	add_action("do_detect", "detect");
}

int do_detect(string arg)
{
	object ob;
	int sen, sk;
	string skill;

	if( arg ) ob = present(arg, environment(this_player()));
	else ob = this_player()->query_opponent();

	if( !ob ) return notify_fail("璶贝代街驹矮\n");

	sen = (int)ob->query("sen");
	if( stringp(skill = ob->query("attack_skill")) )
		sk = ob->query_skill(skill);
	else
		sk = 0;

	printf("贝代竟陪ボ%s驹矮琌%d\n",
		ob->query("name"), 
		(sk*sk*sk) * (100 + sen) / 100 + (int)ob->query("combat_exp") );

	return 1;
}

