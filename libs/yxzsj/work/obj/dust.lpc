// dust.c

inherit COMBINED_ITEM;

void create()
{
	set_name("て", ({"dust"}));
	set("long",
		"硂琌ノㄓ反防格て璶舩翴碞\n"
		"て(dissolve)ㄣ砰\n");
	set("unit", "");
	set("base_unit", "");
	set("base_weight", 1);
	set_amount(1);
}

void init()
{
	if( this_player()==environment() )
		add_action("do_dissolve", "dissolve");
}

int do_dissolve(string arg)
{
	object ob;

	if( !arg ) return notify_fail("璶ノて坊秆ぐ或狥﹁\n");
	if( !objectp(ob = present(arg, environment(this_player()))) )
		return notify_fail("硂柑⊿Τ硂妓狥﹁\n");
	if( living(ob) || !ob->id("corpse") )
		return notify_fail("てノㄓ坊秆砰\n");
	message_vision(
		"$Nノヒ珼翴て$n钮ǎ皚夺夺羘臫盿帝\n"
		"┤碿$n逞舮独\n", this_player(), ob);
	destruct(ob);
	add_amount(-1);
	return 1;
}

