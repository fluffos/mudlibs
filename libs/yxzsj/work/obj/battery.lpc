// battery.c

#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
	set_name("筿", ({ "battery", "batt", "bat" }) );
	set("weight", 100);
	set("long", "硂琌カ程瑻ノ郴筿聋も筿旦ノ2\n"
			"璶恶杆筿叫ゴ(load)\n");
	set("value", 200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "ㄇ");
		set("base_unit", "聋");
		set("base_weight", 100);
		set("base_value", 25);
		set("value", 100);
		set("power", 150);
	}
	set_amount(4);
}

void init()
{
	add_action("do_load", "load");
}

int do_load(string arg)
{
	object ob;
	if ( !arg ) return notify_fail("Α: load 珇\n");
	ob = present(arg, this_player());
	if ( !ob ) return notify_fail("тぃ硂珇\n");
	if ( !ob->query("battery_usage") ) return notify_fail("硂狥﹁ぃ惠璶筿\n");
	if ( ob->query("battery_usage") > query_amount() ) return notify_fail("筿计秖ぃ镑\n");

	add_amount(-(ob->query("battery_usage")));
	ob->set("max_power", query("power")*(ob->query("battery_usage")));
	ob->set("power", ob->query("max_power"));
	message_vision("$N盢"+ob->query("name")+"柑筿ㄓ抖もメ斌"+chinese_number(ob->query("battery_usage"))+"聋穝"+query("name")+"\n", this_player());
	return 1;
}