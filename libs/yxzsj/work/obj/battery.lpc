// battery.c

#include <ansi.h>

inherit COMBINED_ITEM;

void create() {
  set_name("電池", ({ "battery", "batt", "bat" }));
  set("weight", 100);
  set("long", "這是市面上最耐用的金頂電池，一顆可以在手電筒上用2個小時。\n"
    "要填裝電池請打(load)。\n");
  set("value", 200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "些");
    set("base_unit", "顆");
    set("base_weight", 100);
    set("base_value", 25);
    set("value", 100);
    set("power", 150);
  }
  set_amount(4);
}

void init() {
  add_action("do_load", "load");
}

int do_load(string arg) {
  object ob;
  if (!arg) return notify_fail("指令格式: load 物品\n");
  ob = present(arg, this_player());
  if (!ob) return notify_fail("找不到這個物品。\n");
  if (!ob->query("battery_usage")) return notify_fail("這個東西不需要電池。\n");
  if (ob->query("battery_usage") > query_amount()) return notify_fail("你的電池數量不夠。\n");

  add_amount(-(ob->query("battery_usage")));
  ob->set("max_power", query("power") * (ob->query("battery_usage")));
  ob->set("power", ob->query("max_power"));
  message_vision(
    "$N將" + ob->query("name") + "裡的電池拿出來順手丟棄，再放入" + chinese_number(ob->query("battery_usage")) + "顆新的" + query("name") + "。\n",
    this_player()
  );
  return 1;
}
