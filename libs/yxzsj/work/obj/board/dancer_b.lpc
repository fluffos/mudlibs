// dancer_b.c

inherit BULLETIN_BOARD;

void create()
{
	set("board_id", "dancer_b");
	set("location", "/d/latemoon/latemoon1" );
	setup();
	set_name("∟描", ({ "mirror" }) );
	set("long",
		"硂琌Τ蔼描Τ帝妹鸟露帝れ描临后帝\n"
		"ㄇ蹦ㄓ翧帝描い︑Τ翺ぇい边る缠\n"
		"尺舧盢︑みㄆ糶Θ兵竕描\n");
	set("capacity", 30);
	replace_program(BULLETIN_BOARD);
}
