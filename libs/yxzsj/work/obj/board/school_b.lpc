// school_b.c

#include <ansi.h>

inherit BULLETIN_BOARD;

void create() {
  set_name(HIG "學生筆記簿" NOR, ({ "school board", "board", "school" }));
  set("location", "/d/school/guard");
  set("board_id", "school_b");
  set("long", "這是學生的留言板，你可以在這裡留言。\n");
  setup();
  set("capacity", 50);
}
