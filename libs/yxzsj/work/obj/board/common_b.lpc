// common_b.c

#include <ansi.h>

inherit BULLETIN_BOARD;

void create() {
  set_name(HIM "一般用途留言板" NOR, ({ "board" }));
  set("location", "/d/school/guard");
  set("board_id", "common_b");
  set("long", "這是一個供人留言記事的留言板。\n");
  setup();
  set("capacity", 30);
  replace_program(BULLETIN_BOARD);
}
