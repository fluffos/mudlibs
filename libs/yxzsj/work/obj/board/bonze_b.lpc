// bonze_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("絫猭近", ({ "wheel" }) );
	set("location", "/d/sanyen/temple" );
	set("board_id", "bonze_b");
	set("long",
		"硂琌独簧疟Θ猭近眖ウ闯婚簧厚勃格ウ竒\n"
		"讽环絫猭近娩帝セㄑい宫┪痙ē\n" );
	setup();
	set("capacity", 30);
	replace_program(BULLETIN_BOARD);
}
