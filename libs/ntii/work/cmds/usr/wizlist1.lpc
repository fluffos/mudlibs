//modify by miracle.2002.07.21
#include <ansi.h>
inherit F_CLEAN_UP;
mapping wizhood = ([
  "(root)": HIY " 发呆者 " HIR,
  "(admin)": HIY " 天  神 " HIR,
  "(arch)": HIR " 大  神 " HIR,
  "(wizard)": HIC " 天使长 " HIR,
  "(apprentice)": HIC " 天  使 " HIR,
  "(immortal)": HIB " 使  徒 " HIR,
  "(elder)": HIB " 使  者 " HIR,

]);
string *mission;
mapping wizlevel = ([
  0: "(root)",
  1: "(admin)",
  2: "(arch)",
  3: "(wizard)",
  4: "(apprentice)",
  5: "(immortal)",
  6: "(elder)",
]);
string get_mission(string);
int main(object me, string arg) {

  string *list, ch, area;
  int my_level, b, i, j, number, a, mark, lev;
  object ob;

  number = 0;
  //        job="";

  mission = explode(read_file("/adm/etc/wizmission"), "\n");
  list = sort_array(SECURITY_D->query_wizlist(), 1);
  write(HIR "  《" NOR HIY " 泥潭" NOR HIR "》" NOR HIY "管理者协会\n" NOR);

  write(HIW "╭" HIW "─" HIW "─────────────────────────────────" HIW "─" HIW "╮\n" NOR);
  write(HIW "│" NOR HIC "【" NOR CYN "管理者等级" NOR HIC "】【" NOR CYN "管理者ID" NOR HIC "】【" NOR CYN "状态" NOR HIC "】 【" NOR CYN "负责区域" NOR HIC "】" HIW "                       │\n" NOR);
  write(HIW "╰" HIW "─" HIW "─────────────────────────────────" HIW "─" HIW "╯" NOR);
  my_level = wiz_level(me);
  if (wizardp(me)) {
    lev = 7;
  } else {
    lev = 5;
  }
  for (b = 0; b < lev; b++) {
    mark = 0;
    for (i = 0, j = 0; i < sizeof(list); i++)
      if (SECURITY_D->get_status(list[i]) == wizlevel[b]) mark = 1;
    if (mark) {
      printf(NOR HIY "\n  【" + wizhood[wizlevel[b]] + NOR HIY "】  " NOR);
      for (i = 0, j = 0; i < sizeof(list); i++)
        if (SECURITY_D->get_status(list[i]) == wizlevel[b]) {

          ch = HIR "离线" NOR;
          a = 0;
          //                area = get_mission(list[i]);

          if (ob = find_player(list[i]) && !find_player(list[i])->query("env/invisibility"))

          //     if (!find_player(list[i])->query("env/invisibility")||( find_player(list[i])->query("env/invisibility") && wiz_level(find_player(list)
          {
            ch = HIG "在线" NOR;
            a = 1;
            number = number + 1;
          };
          printf(
            HIY "  %-10s" " %s    " HIC "%-10s" HIW "  %s\n                ",
            list[i],
            ch,
            get_mission(list[i]),
            " "
          );



        }
    }
  }
  write(HIW "\n╭" HIW "─" HIW "─────────────────────────────────" HIW "─" HIW "╮\n" NOR);
  printf(
    HIW "│                                        " HIY " 泥潭" NOR "目前一共有:" HIR " %s" NOR "个" NOR HIY "管理者" NOR HIW " │\n" NOR,
    chinese_number(sizeof(list))
  );
  printf(HIW "╰───────────────────────────────────╯\n" NOR, chinese_number(number));
  write("\n");
  return 1;
}

string get_mission(string wiz) {
  int i;
  string wname, wmin;
  for (i = 0; i < sizeof(mission); i++) {
    if (mission[i][0] == '#' || sscanf(mission[i], "%s %s",
      wname, wmin) != 2) continue;
    if (wname == wiz) return wmin;
  }
  return "任务未定";
}


int help(object me) {
  write(@HELP
指令格式：wizlist
指令说明：
           本指令用来查看目前总共有多少个巫师。
HELP
  );
  return 1;
}
