// shop.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string file;

  if (!arg) {
    SKILLS_D->show_skills_power_point(me, arg);
    return 1;
  }
  if (!stringp(file = SKILL_D(arg)) || file_size(file + ".lpc") <= 0) {
    if (!stringp(arg = CHINESE_D->find_skill(arg)))
      return notify_fail("没有这种技能存在。\n");

    if (!stringp(file = SKILL_D(arg)) || file_size(file + ".lpc") <= 0)
      return notify_fail("没有这种技能存在。\n");
  }

  SKILLS_D->show_skills_power_point(me, arg);
  return 1;
}

int help(object me) {
  write(@HELP
查看武工威力排名
HELP);
  return 1;
}
