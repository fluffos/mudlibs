// a skeleton for user rooms
inherit ROOM;
void create() {
  set("short", "湖畔花园");
  set("long", @LONG
  你仔细的看了看湖面 然后想也没想 一下跳进湖里 表面如此平和
的湖水 水底却有一股强大的水流将你冲走 你无法抗拒这股强大
的水流 只得屏住呼吸 任水流将你冲走 
突然你眼前一亮 原来是到了岸上 这里被山峰紧紧围住 只有上空
一片蓝天 不知何故 这里却是出奇的温暖 各种花卉竞相怒放
你不由被眼前的奇景所惊叹 你仔细看了看花从 发现有人工整理
的痕迹 顺着花从小路一直有突然一座阁楼出现在你面前 这便是
江湖中传说已久的 听雨阁了

LONG
  );
  set("exits", ([
    "north": "/p/residence/bbq1018117727",
    "up": "/p/residence/bbq1018117432",
    "southup": "/p/residence/bbq1018115717.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  //         set("class", "〖听雨阁〗");
  set("banghui", "〖听雨阁〗");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
void init() {
  add_action("do_invite", "invite");
  //add_action("do_setowner","setowner");
}
int valid_enter(object me) {
  int flag;
  // always let owner go in:
  if ((string)me->query("banghui") != (string)query("banghui")
    //         if((string)me->query("class") != (string)query("class")
    && (string)query("invite") != (string)me->query("id")
    && (string)me->query("id") != (string)query("owner"))
    return 1;

}
int do_invite(string arg) {
  object me;
  me = this_player();
  if ((string)me->query("id") != (string)query("owner"))
    return 0;
  set("invite", arg);
  write("你邀请" + arg + "来你的房间。\n");
  return 1;
}

