// a skeleton for user rooms
inherit ROOM;
void create()
{
set("short", "〖洪兴社〗大厅");
set("long", @LONG
这里就是〖洪兴社〗的大厅了。大理石的地面反出幽幽的光。四跟白玉金龙的盘龙柱分立在大厅的四个角上。
十六名戴墨镜，身穿黑西装的侍卫分成两边，笔直战立的站着，无比威严。正中央上方一块金字横匾上写了三个篆体大字
                           〖洪兴社〗

LONG
);
        set("exits", ([
"northwest" : "/p/residence/marker1018885488",
"east" : "/p/residence/marker1018885390",
"north" : "/p/residence/marker1018885185",
"west" : "/p/residence/marker1018884840",
"south" : "/p/residence/marker1018882264.lpc",
]));
set("objects", ([
       ]) );
        set("owner", "bigtie7001");
//         set("class", "洪兴社");
         set("banghui", "洪兴社");
        set("valid_startroom",1);
        set("no_fight",1);

setup();
}
void init()
{
        add_action("do_invite","invite");
        //add_action("do_setowner","setowner");
}
int valid_enter(object me)
{
        int flag;
// always let owner go in:
         if((string)me->query("banghui") != (string)query("banghui")
//         if((string)me->query("class") != (string)query("class")
        &&(string)query("invite") != (string)me->query("id")
        &&(string)me->query("id") != (string)query("owner"))
        return 1;       

}
int do_invite(string arg)
{
        object me;
        me= this_player();
        if((string)me->query("id") != (string)query("owner"))
        return 0;
        set("invite",arg);
        write("你邀请"+arg+"来你的房间。\n");
        return 1;
}

