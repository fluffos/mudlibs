// a skeleton for user rooms
inherit ROOM;
void create()
{
set("short", "「卧龙石」");
set("long", @LONG
    一块巨大的石头，看上去很古远了。上面生满了青苔，依稀可以看见几个斑驳
的大字：卧龙石。传说中这块石头具有神奇的力量，和江湖上神秘门派铁血大旗门
有着很大关系，只是至今也无人明白这卧龙石到底有何玄机。不远处是一片连绵不
尽的山林，四周静得可怕，没有一点声音。

LONG
);
        set("exits", ([
"west" : "/p/residence/marker1018881890",
"east" : "/p/residence/twfh1013318066",
"down" : "/p/guangchang1.lpc",
]));
set("objects", ([
       ]) );
        set("owner", "bigtie7001");
//         set("class", "【铁血大旗门】");
         set("banghui", "【铁血大旗门】");
        set("valid_startroom",1);
        set("no_fight",1);

setup();
}
void init()
{
        add_action("do_invite","invite");
        //add_action("do_setowner","setowner");
}
int valid_enter(object me)
{
        int flag;
// always let owner go in:
         if((string)me->query("banghui") != (string)query("banghui")
//         if((string)me->query("class") != (string)query("class")
        &&(string)query("invite") != (string)me->query("id")
        &&(string)me->query("id") != (string)query("owner"))
        return 1;       

}
int do_invite(string arg)
{
        object me;
        me= this_player();
        if((string)me->query("id") != (string)query("owner"))
        return 0;
        set("invite",arg);
        write("你邀请"+arg+"来你的房间。\n");
        return 1;
}

