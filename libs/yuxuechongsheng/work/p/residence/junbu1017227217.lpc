// a skeleton for user rooms
inherit ROOM;
void create()
{
set("short", "流云阁大门");
set("long", @LONG
一条宽阔笔直的大官道自平原上由南北向远远地伸延开来，道平整可容得下十马并驰。大官道的前边通向远方远可看见开开封城
欢迎大家参观本城但请大家不要攻打我的城池啊

LONG
);
        set("exits", ([
"down" : "/p/residence/junbu1017227509",
"up" : "/p/guangchang1.lpc",
]));
set("objects", ([
       ]) );
        set("owner", "bigtie7001");
        set("banghui", "权力帮");

setup();
}

void init()
  {
     object ob=this_player();
if((string)ob->query("banghui")!=environment(ob)->query("banghui"))  {
     message("vision",HIY"〖帮派总坛〗"NOR+":"+HIY" " + ob->query("name") + "于今日" + NATURE_D->game_time() + "企图闯入" + environment(ob)->query("banghui") + "总坛,被赶了出来!\n"NOR,users());
message_vision(HIR"门卫突然从里面冲了出来给$N一脚,$N惨叫一声,被踢了出来。"NOR,this_player());
       ob->move("/p/guangchang");
    }
      else return;
  }
