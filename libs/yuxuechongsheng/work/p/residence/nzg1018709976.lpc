// a skeleton for user rooms
inherit ROOM;
void create() {
  set("short", "精英会大门");
  set("long", @LONG
这是精英会的大门，除了精英会的帮众，谁也不能进去。在大
门的两旁，各立着一头石狮，威猛地看着过往的人。往北方的
山上就是精英会的驻地，抬头望去，一片云遮住了视线，朦胧
中能看见几个朱红的点。

LONG
  );
  set("exits", ([
    "northup": "/p/residence/nzg1018710909",
    "southdown": "/p/guangchang.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  set("banghui", "【精英会】");

  setup();
}

void init() {
  object ob = this_player();
  if ((string)ob->query("banghui") != environment(ob)->query("banghui")) {
    message(
      "vision",
      HIY "〖帮派总坛〗" NOR + ":" + HIY " " + ob->query("name") + "于今日" + NATURE_D->game_time() + "企图闯入" + environment(ob)->query("banghui") + "总坛,被赶了出来!\n" NOR,
      users()
    );
    message_vision(HIR "门卫突然从里面冲了出来给$N一脚,$N惨叫一声,被踢了出来。" NOR, this_player());
    ob->move("/p/guangchang");
  } else return;
}
