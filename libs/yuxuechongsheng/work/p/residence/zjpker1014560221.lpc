  set("short", "恨天阁");
  set("long", @LONG
这里就是恨天阁最机密的地方之一，上楼的木阶上隐隐
约约的，不知道隐藏了多少的机关。平时只有阁主，副阁主和
长老等级的人才可以进来。

LONG
  );
  set("exits", ([
    "up": "/p/residence/zjpker1014563046",
    "north": "/p/residence/zjpker1014560675",
    "west": "/p/residence/zjpker1014560508",
    "east": "/p/residence/zjpker1014560369",
    "south": "/p/residence/zjpker1014559623.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  //         set("class", "〖恨天阁〗");
  set("banghui", "〖恨天阁〗");
  set("valid_startroom", 1);
  set("no_fight", 1);

