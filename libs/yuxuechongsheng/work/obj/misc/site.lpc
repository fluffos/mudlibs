//  /clone/misc/site
//  by 

#include <ansi.h>
inherit ITEM;

mapping site=([
      "bt"    :"/d/baituo/dating",
      "cd"    :"/d/chengdu/guangchang",
      "bj"    :"/d/city2/tian_anm",
      "dl"    :"/d/dali/center",
      "em"    :"/d/emei/gate",
      "gy"    :"/d/guiyun/damen",
      "hn"    :"/d/hainan/haibian",
      "hz"    :"/d/hangzhou/dadao1",
      "hmy"   :"/d/heimuya/shenggu",
      "hengs" :"/d/hengshan/jinlongxia",
      "hh"   :"/d/huanhua/dalu",
      "hs"    :"/d/huashan/zhenyue",
      "jl"    :"/d/jinling/shizhong",
      "kf"    :"/d/kaifeng/zhuque",
      "lj"    :"/d/lingjiu/dadao1",
      "mz"    :"/d/meizhuang/xiaolu",
      "mj"    :"/d/mingjiao/shanjiao",
      "quanz" :"/d/quanzhen/ximen",
      "qz"    :"/d/quanzhou/bei-door",
      "ss"    :"/d/songshan/taishique",
      "sz"    :"/d/suzhou/canglangting",
      "ts"    :"/d/taishan/nantian",
      "thd"   :"/d/taohua/damen",
      "tl"    :"/d/tianlongsi/damen",
      "yz"    :"/d/city/guangchang",
      "wd"    :"/d/wudang/guangchang",
      "yd"    :"/d/yandang/jiedao",
      "yz"    :"/d/yangzhou/guangchang",
      "yj"    :"/d/yanjing/streel1",
      "zz"    :"/d/zhongzhou/shizhongxin"
]);
void create()
{
       set_name("魔法毯", ({ "trans site", "site" }) );
       set_weight(10);
       if( clonep() )
               set_default_object(__FILE__);
       else {
               set("unit", "张");
               set("long", @TEXT
       这是张魔法毯，有着非凡的魔力，你可以借助魔力迅速到达很多地方;
       
           白驮山(bt)    成都(cd)      北京(bj)     大理(dl)

           峨嵋(em)      归云庄(gy)    海南(hn)     杭州(hz)

           黑木崖(hmy)   恒山(hengs)   浣花剑庐(hh) 华山(hs)
                 
           竟陵(jl)      开封(kf)      灵鹫(lj)     梅庄(mz)

           明教(mj)      全真(quanz)   泉州(qz)     嵩山(ss)

           苏州(sz)      泰山(ts)      桃花岛(thd)  天龙寺(tls)
           
           武当(wd)      雁荡山(yd)    扬州(yz)     燕京(yj) 
           
           中州(zz)

TEXT);
                set("no_get", 1);
                set("no_put", 1);
                set("no_drop", "魔法毯是宝物，乱丢会污染环境的!^!^\n");
                set("no_sell",1);
              //  set("value", 50000); 
             }
       setup();
}

void init()
{
        add_action("do_trans","trans");
}

int do_trans(string arg)
{
        object ob;
        ob = this_player() ;
//        if (ob->is_busy());
//          return notify_fail("你现在正忙着呢!^!^\n");
        if (ob->is_fighting() )
                return notify_fail("在战斗中无法使用魔法毯!^!^\n");
        if(member_array(arg,keys(site))<0)
                return notify_fail("你要到哪里?\n");
        if(!environment(ob)->query("outdoors"))
                return notify_fail("魔法毯只能在屋外使用!^!^\n");
        if (ob->query("age") < 16){
                message_vision(
                "只见一阵风雪过后，$N的身影已经消失了\n", ob);
                ob->add("jing",-5);
                ob->add("qi",-10);

        ob->move (site[arg]);
                message_vision(
                    "你眼前下起了雪，$N的身影忽然出现在雪花中\n", ob);
                return 1;
          }
         else  
                return notify_fail("只有小于16岁才能使用魔法毯!!\n");
}


