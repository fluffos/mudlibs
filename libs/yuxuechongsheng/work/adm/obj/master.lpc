int valid_bind(object binder, object old_owner, object new_owner) {
  object ob;
  if (ob = find_object(SECURITY_D))
    return (int)ob->valid_bind(binder, old_owner, new_owner);
  return 1;
}
protected mixed valid_database(object ob, string action, mixed *info) {
  if (!objectp(ob) || (geteuid(ob) != ROOT_UID))
    return 0;
  else {
    if (action == "connect")
      switch (info[1]) {
        case "1.1.1.1":   // 其它站点的地址
          return "passwd_1";  // 这个站点上你的密码
        case "localhost":
          //return "passwd_local";  // 本地密码
          return "111333";  // 本地密码
        default:
          return 0;
      } else
        return 1;
  }
}
