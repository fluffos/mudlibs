// object.c
//modified by lonely@yxcs
varargs int getoid(object ob) {
  int id;
  if (!ob) ob = previous_object();
  sscanf(file_name(ob), "%*s#%d", id);
  return id;
}
// Get the owner of a file.  Used by log_error() in master.c.
string file_owner(string file) {
  string name, rest;
  if (file[0] != '/') {
    file = "/" + file;
  }
  if (sscanf(file, "/u/%s/%s", name, rest) == 2) {
    return name;
  }
  return 0;
}
// domain_file should return the domain associated with a given file.
string domain_file(string file) {
  string domain;
  if (sscanf(file, "/d/%s/%*s", domain))
    return domain;

  if (sscanf(file, "/kungfu/class/%s/%*s", domain))
    return domain;
  return ROOT_UID;
}
// creator_file should return the name of the creator of a specific file.
string creator_file(string file) {
  string *path;
  path = explode(file, "/") - ({ 0 });
  switch (path[0]) {
    case "adm":
      if (file == SIMUL_EFUN_OB) return "MudOS";
      else return ROOT_UID;
    case "cmds": return ROOT_UID;
    case "quest": return ROOT_UID;
    case "d":
    case "doc":
    case "kungfu": return "Domain";
    case "data": return "Data";
    case "clone":
      if (sizeof(path) >= 2 || path[1] != "user") return ROOT_UID;
    case "u":
      if (sizeof(path) >= 2) return path[1];
    case "open":
    case "ftp":
      if (sizeof(path) >= 3) return path[1];
    default:
      if (this_player(1))
        return getuid(this_player(1));
      else
        return "MudOS";
  }
}
// author_file should return the name of the author of a specific file.
string author_file(string file) {
  string name;
  if (sscanf(file, "/u/%s/%*s", name))
    return name;
  return ROOT_UID;
}
int living(object ob) {
  if (ob->query_temp("disable_inputs")) return 0;
  return efun::living(ob);
}

int is_root(mixed ob) {
  if (stringp(ob))
    return (SECURITY_D->get_status(ob) == "(admin)");

  if (objectp(ob)) {
    if (geteuid(ob) == ROOT_UID)
      // Root object want to execute
      return 1;

    return (SECURITY_D->get_status(geteuid(ob)) == "(admin)");
  }

  return 1;
}

void destruct(object ob) {
  if (ob) {
    if (previous_object()) ob->remove(geteuid(previous_object()));
    else ob->remove(0);
  }

  efun::destruct(ob);
}

// AGENTS.md #15b: add_light(room, level) is called from a dozen room
// files (mostly d/temple/*) but was never defined anywhere in this
// archive, not even in a .bak/backup copy -- a genuinely never-
// implemented room-lighting cosmetic effect. A no-op stub is a safe,
// documented compromise (matches the db_affected() precedent) since none
// of these rooms are on the registration/critical path and there's no
// working reference implementation anywhere to restore faithfully.
void add_light(object room, int level) {}

// AGENTS.md #15b: bare keep_heart_beat() (no args) called from 3 NPC
// generator files (girl/killed/receiver.lpc) -- never defined anywhere,
// clearly meant as an alias for the real set_heart_beat(1) efun call used
// identically everywhere else in this lib (feature/attack.lpc,
// feature/damage.lpc, feature/action.lpc all call set_heart_beat(1)
// directly).
void keep_heart_beat() { efun::set_heart_beat(1); }
