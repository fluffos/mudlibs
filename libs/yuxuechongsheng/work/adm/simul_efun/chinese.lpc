
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}
string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}
int is_chinese(string str)
{
	// AGENTS.md #15h: this driver's strings are UTF-8 native -- str[0] is
	// a full Unicode codepoint, not a raw GBK lead byte, and strlen()
	// counts characters, not bytes. The original GBK byte-range check
	// (strlen>=2 && str[0]>160 && str[0]<255) never matches real Chinese
	// text anymore. Use a CJK Unified Ideographs codepoint range instead,
	// and strlen>=1 (a single real Chinese character is valid input).
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
string cntime(int time)
{
    mixed t;

    if (time<1) time=1;
   t=localtime(time);
    return sprintf("%d年%d月%d日%d时%d分%d秒",t[5],t[4]+1,t[3],t[2],t[1],t[0]);
}

