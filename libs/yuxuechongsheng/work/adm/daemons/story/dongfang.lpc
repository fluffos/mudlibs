#include <ansi.h>
string give_gift();
private mixed *story = ({
  "东方不败：终于到手了，真 TNND 不容易呀 。",
  "东方不败小心奕奕的打开了一个" HIR "锦盒" NOR WHT "。“喀”" NOR,
  "东方不败：这就是江湖上人人想得到的武林宝典《葵花宝典》。",
  "东方不败很小心翻开了秘籍 ……",
  "秘籍第一页：上边写了八个大字：" HIG "“欲 练 神 功   挥 刀 自 宫”" NOR,
  "经过激烈的思想斗争后，东方不败终于痛下决心 ……",
  "东方不败：我决定要挥刀自宫！",
  "说完，东方不败一咬牙，褪下中衣 ……",
  "拿起自己的宝剑，插到两腿之间，飞速一剜，……",
  "只听东方不败“啊”的一声惨叫，昏了过去 ……",
  HIC "     三  天  后  ……" NOR,
  "东方不败抱着希望翻开了秘籍的第二页 ……",
  "秘籍第二页：上边还是八个大字：" HIG "“如 不 自 宫   也 能 成 功”" NOR,
  "只听得“噗通”一声，眼见东方不败四脚朝天，向后便倒。",
  HIC "    又过个一天后  ……" NOR,
  "东方不败很痛苦的翻开了秘籍的第三页 ……",
  "秘籍第三页：上边又是八个大字：" HIG "“就 算 自 宫   未 必 成 功”" NOR,
  "东方不败强忍着继续看了下去 ……",
  HIC "    又过个数天后  ……" NOR,
  "东方不败发现整本书上全是谈论 “成功与自宫，自宫与成功”的问题。",
  "东方不败抱着希望终于翻到了秘籍的倒数第二页 ……",
  "倒数第二页：上边又是八个大字：" HIG "“若 要 成 功   不 能 自 宫”" NOR,
  "只听得“噗通”一声，东方不败又一次四脚朝天，向后倒去。",
  "东方不败气愤的想：我一定要把这本书看完，这是我最后的希望 。",
  "东方不败终于翻开了秘籍的最后一页 ……",
  "秘籍最后一页：上边又是八个大字：" HIG "“如 以 自 宫   请 速 进 宫”" NOR,
  "在大字的旁边有一排小字：“本书纯熟开玩笑，如以自宫，请下辈子好好练功”",
  "只听得“噗”的一口，东方不败口吐" HIR "鲜血" NOR WHT "，一代枭雄就此消亡了。" NOR,
  (: give_gift :),
});
void create() {
  seteuid(getuid());
}
mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

string give_gift() {
  STORY_D->give_gift("/d/heimuya/obj/kuihua", 1,
    HIM "\n“啪”的一声一本秘籍掉到了你面前。\n\n" NOR);
  return HIM "听说东方不败被活活的气死了，《葵花宝典》也遗失了。\n" NOR;
}
