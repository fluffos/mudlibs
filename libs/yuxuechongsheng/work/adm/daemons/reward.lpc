#pragma save_binary
// 主要更改了队伍完成quest之后获得的奖励
#include <ansi.h>
#include <combat.h>

int reward_team(object leader,int exp,int pot);//队伍的报酬经验和潜能
void create() { seteuid(getuid()); }

int winner_quest(object me,object victim)
{
        int score,exp,pot,i;
        object owner,*member,leader;
        if(owner=me->query("possessed"))  me = owner;
        //保护人完成的quest当作是被保护人完成的quest
        //队长的quest就是队伍的quest,所以无论那哪个队员完成了quest,都算是整个队伍完成的
        //然后删除队长的quest标记,其他队员的quest标记并不删除,由此产生了下面这个问题,队
        //伍完成quest以后,队伍立刻解散重组,继续完成另外一个队员的quest(该队员重组之后为
        //队长),不过这里允许这种情况
        //
        if(pointerp(member=me->query_team()))
        {
                for(i=0;i<sizeof(member);i++)
                {
                        if(member[i]->is_team_leader())
                        {
                                leader=member[i];       
                                break;
                        }
                }
                if(leader&&leader->query("quest"))
                        me=leader;
        }
        if((string)me->query("quest/name")==victim->query("name")
            &&!userp(victim)
            &&me->query("quest")["type"]=="胜"
            &&me->query("task_time")>time())
        {  
                exp = random(me->query_skill("parry")/3)
                      + random(me->query_skill("dodge")/3)
                      + random(30)
                      + random(me->query_skill("force")/3)+2;
                pot = random(me->query_con()/3)+random(me->query_kar()/3)+random(5)+1;
                score = random(exp+pot*2);
                if (exp>120) exp= 120;
                if (exp<12) exp= 12;
                if (pot>18) pot = 18;
                if (pot<3) pot = 3;

                me->add_temp("quest/exp",exp);
                me->add_temp("quest/pot",pot);
                if(me->query("combat_exp")>=3000000)
                {
                        if( me->query_temp("quest/exp")> 720) 
                                me->set_temp("quest/exp",720);
                        if( me->query_temp("quest/pot")> 81) 
                                me->set_temp("quest/pot",81);
                }
                else
                {
                        if( me->query_temp("quest/exp")> 1150) 
                                me->set_temp("quest/exp",1150);
                        if( me->query_temp("quest/pot")> 120) 
                                me->set_temp("quest/pot",120);
                }     

                me->add("combat_exp",me->query_temp("quest/exp"));
                me->add("potential",me->query_temp("quest/pot"));
                me->add_temp("quest/score",score);
                me->add("score",me->query_temp("quest/score"));
                me->add("fealty",me->query("quest/fealty"));
                score=me->query("quest/fealty");
                me->add_temp("quest/tasknum",1);
                me->delete("quest");
                tell_object(me,"恭喜你！你又完成了一项任务！\n");
                tell_object(me,HIW"你被奖励了：\n" 
                        +chinese_number(me->query_temp("quest/exp")) + "点实战经验\n"
                        +chinese_number(me->query_temp("quest/pot")) + "点潜能\n"
                        +chinese_number(score)+"点师门忠诚度。\n"NOR);

                reward_team(me,exp,pot);
        }
}

int killer_task(object killer,object victim)
{
        object *member,me,leader;
        int score,exp,pot,i;
        mapping quest;

        
        //if(owner=killer->query("possessed"))  killer = owner;
       
        if(pointerp(member=killer->query_team()))
        {
                for(i=0;i<sizeof(member);i++)
                {
                        if(member[i]->is_team_leader())
                        {
                                leader=member[i];
                                break;  
                        }       
                }
                if(leader&&leader->query("quest"))
                        killer=leader;
        }

        if((quest =  killer->query("quest"))  &&
           (victim->name(1) == quest["name"]) &&
           !userp(victim) &&
           killer->query("quest")["type"]=="杀" &&
           ((int) killer->query("task_time") >= time()))
        {
                me=killer;
                tell_object(killer,"恭喜你！你又完成了一项任务！\n");
                exp = random(killer->query_skill("parry")/3) 
                      + random(killer->query_skill("force")/3)
                      + random(30)
                      + random(me->query_skill("dodge")/3)+2;
                pot=random(killer->query_kar()/3)+random(killer->query_con()/2)+random(8)+1;
                score = random(pot*2+exp);
                if (killer->query("score")<0) 
                {
                        score=score*(-1);
                }
                if (exp>120) exp= 120;
                if (exp<12) exp= 12;
                if (pot>18) pot = 18;
                if (pot<3) pot = 3;

                if(me->query("combat_exp")>3000000)
                {
                        me->add_temp("quest/exp",exp);
                        if(me->query_temp("quest/exp")>720) 
                                me->set_temp("quest/exp",720);
                        me->add("combat_exp",me->query_temp("quest/exp"));
                        me->add_temp("quest/pot",pot);
                        if(me->query_temp("quest/pot")>81) 
                                me->set_temp("quest/pot",81);
                }
                else
                {
                        me->add_temp("quest/exp",exp);
                        if(me->query_temp("quest/exp")>1150) 
                                me->set_temp("quest/exp",1150);
                        me->add("combat_exp",me->query_temp("quest/exp"));
                        me->add_temp("quest/pot",pot);
                        if(me->query_temp("quest/pot")>120) 
                                me->set_temp("quest/pot",120);
        
        
                }
                me->add("potential",me->query_temp("quest/pot"));
                me->add_temp("quest/score",score);
                me->add("score",me->query_temp("quest/score"));
                me->add("fealty",me->query("quest/fealty"));
                score=me->query("quest/fealty");
                me->add_temp("quest/tasknum",1);
                me->delete("quest");
                tell_object(killer,HIW"你被奖励了：\n" +
                       chinese_number(killer->query_temp("quest/exp")) + "点实战经验\n"+
                       chinese_number(killer->query_temp("quest/pot")) + "点潜能\n" +
                       chinese_number(score)+"点师门忠诚度。\n"NOR);
            
                reward_team(me,exp,pot);
        }
}

void winner_reward(object killer, object victim)
{
        killer->defeated_enemy(victim);
        if(!killer->is_killing(victim))
               winner_quest(killer,victim);
}
void pker_reward(object killer,object victim)
{
        int exp,pot,want_exp,want_pot;

        if(query_ip_number(killer)==query_ip_number(victim))
                tell_object(killer,HIR"奖励精灵："+HIW"因为你这样无耻的杀自己人.不能得到任何的奖励.\n"NOR);

        if(query_ip_number(killer)!=query_ip_number(victim))
        {
                if(stringp(victim->query("id"))&&victim->query("id")!="guest")
                {
                        log_file( "PK_RECORD", sprintf("*****(%s)被(%s)(%s)杀害于(%s)\n", 
                                victim->query("id"), killer->query("id"),killer->query_temp("netdead")?"(断线,IP不明)":query_ip_name(killer), ctime(time()) ) );
                        log_file( "PK_RECORD", 
                                sprintf("被害人(%s)生前数据 exp(%d),force(%d),force_factor(%d),武器(%s)\n"
                                "凶手(%s)杀人之前的数据 exp(%d),force(%d),force_factor(%d),武器(%s):::::\n", 
                                victim->query("id"),victim->query("combat_exp"),victim->query("force"),victim->query("force_factor"),
                                victim->query_temp("weapon")?base_name(victim->query_temp("weapon")):"空手",
                                killer->query("id"),killer->query("combat_exp"),killer->query("force"),killer->query("force_factor"),
                                killer->query_temp("weapon")?base_name(killer->query_temp("weapon")):"空手",));
                }
       
                if(victim->query("wanted")
                      &&killer->query("family/family_name")=="朝廷")
                {
                        exp=victim->query("combat_exp")/60+victim->query("wanted/exp");
                        if(exp > 500000)
                        {
                                exp=500000; pot=100000;
                                killer->add("combat_exp",exp);             
                                pot=(victim->query("potential")
                                    -victim->query("learned_points"))/6+victim->query("wanted/pot");
                                if(pot > 100000) pot=100000;
                                killer->add("potential",pot);
                                MONEY_D->pay_player(killer,victim->query("wanted/money"));
                                killer->add("fealty",victim->query("combat_exp")/5000);
                                killer->add("BCF",1);
                                tell_object(killer,HIW"因为擒获杀人凶手，你被奖励了：\n" +
                                     chinese_number(exp) + "点实战经验\n"+
                                     chinese_number(pot) + "点潜能\n" +
                                MONEY_D->money_str(victim->query("wanted/money")) + "\n" +
                                         chinese_number(victim->query("combat_exp")/5000)+"点忠诚度。\n"NOR);
                                victim->delete("wanted");
                                log_file("PK_get",sprintf("%s PK %s get %d 经验 %d 潜能\n",
                                killer->query("id"),victim->query("id"),exp,pot));
                        }
                        else
                        {             
                                exp=victim->query("combat_exp")/60+victim->query("wanted/exp");
                                killer->add("combat_exp",exp);              
                                pot=(victim->query("potential")
                                     -victim->query("learned_points"))/6+victim->query("wanted/pot");
                                if(pot>100000) pot =100000;
                                killer->add("potential",pot);
                                MONEY_D->pay_player(killer,victim->query("wanted/money"));
                                killer->add("fealty",victim->query("combat_exp")/5000);
                                killer->add("BCF",1);
                                tell_object(killer,HIW"因为擒获杀人凶手，你被奖励了：\n" +
                                      chinese_number(exp) + "点实战经验\n"+
                                      chinese_number(pot) + "点潜能\n" +
                                MONEY_D->money_str(victim->query("wanted/money")) + "\n" +
                                      chinese_number(victim->query("combat_exp")/5000)+"点忠诚度。\n"NOR);
                                victim->delete("wanted");
                                log_file("PK_get",sprintf("%s PK %s get %d 经验 %d 潜能\n",
                                killer->query("id"),victim->query("id"),exp,pot));
                        }
                }
                else if(victim->query("wanted")&&victim->query("family/family_name")=="朝廷") 
                {
                        exp=victim->query("combat_exp")/60+victim->query("wanted/exp");
                        if(exp>=500000) 
                        {
                                exp=500000; pot=100000;
                                killer->add("combat_exp",exp);
                                killer->add("potential",pot);
                                MONEY_D->pay_player(killer,victim->query("wanted/money"));
                                tell_object(killer,HIW"因为成功暗杀朝廷官员，你被奖励了：\n" +
                                     chinese_number(exp) + "点实战经验\n"+
                                     chinese_number(pot) + "点潜能\n" +
                                MONEY_D->money_str(victim->query("wanted/money")) + "\n"NOR);
                                victim->delete("wanted");
                                log_file("PK_get",sprintf("%s PK %s get %d 经验 %d 潜能\n",
                                     killer->query("id"),victim->query("id"),exp,pot));
                        }
                        else
                        {
                                exp=victim->query("combat_exp")/60+victim->query("wanted/exp");
                                pot=(victim->query("potential")
                                     -victim->query("learned_points"))/6+victim->query("wanted/pot");
           
                                if(pot>100000) pot =100000;
                                killer->add("combat_exp",exp);
                                killer->add("potential",pot);
                                MONEY_D->pay_player(killer,victim->query("wanted/money"));
                                tell_object(killer,HIW"因为成功暗杀朝廷官员，你被奖励了：\n" +
                                      chinese_number(exp) + "点实战经验\n"+
                                      chinese_number(pot) + "点潜能\n" +
                                MONEY_D->money_str(victim->query("wanted/money")) + "\n"NOR);
                                victim->delete("wanted");
                                log_file("PK_get",sprintf("%s PK %s get %d 经验 %d 潜能\n",
                                killer->query("id"),victim->query("id"),exp,pot));
                        }
                }        
                else
                {
             //         if(!killer->query_temp("unkill")||killer->query_temp("unkill")!=victim)
            //          killer->apply_condition("killer", 1200+killer->query_condition("killer"));
                        if(victim->query("combat_exp")>5000)
                        killer->add("combat_exp",victim->query("combat_exp")/60);
                        killer->add("potential",((int)victim->query("potential") 
                             - victim->query("learned_points"))/6);
                }  
                victim->add("BCF",1);   
                want_exp=victim->query("combat_exp")/60;
                want_pot=(victim->query("potential")-victim->query("learned_points"))/3;        
      //        killer->add("wanted/exp",want_exp);
                if( want_exp<500000 )
                {
                        killer->add("wanted/exp",want_exp);
                }
                else
                {
                        killer->add("wanted/exp",500000);
                }
       //        killer->add("wanted/pot",want_pot);
                if( want_pot<100000 )
                {
                        killer->add("wanted/pot",want_pot);
                }
                else
                {
                        killer->add("wanted/pot",100000);
                }
//       CHANNEL_D->do_channel(this_object(), "wiz",
        }

}


void killer_reward(object killer, object victim)
{
        int bls,tm;
        string vmark;
        object env;
        tm=time();
        env = environment(victim);
        if(query_ip_number(killer)!=query_ip_number(victim))
        {
                if(objectp(env))
                if ( env->query("no_death_penalty")) return;
               // Call the mudlib killer apply.
                killer->killed_enemy(victim);
                
                if ( !killer->is_living()  && objectp(killer->query("possessed"))) 
                {
                        killer = killer->query("possessed");
                        victim->set_temp("last_damage_from",killer);
                }

                if( userp(victim) ) 
                {
                        if(killer->query("pkquest")==victim->query("id"))
                        killer->set("pkfinishquest",1); //无情楼的杀人任务,grin
                        killer->add("PKS", 1);
                        killer->set_temp("pkt",tm);     //杀了玩家后不能立刻离开.
                        victim->add("killed",1);
                        bls = 5;
                }
                else 
                {
                        killer->add("MKS", 1);
                        bls = 1;
                }
                if(userp(killer)&&userp(victim)) pker_reward(killer,victim);
                        killer_task(killer,victim);     
                // NPC got 10 times of bellicosity than user.
                killer->add("bellicosity", bls * (userp(killer)? 1: 10));
                if( stringp(vmark = victim->query("vendetta_mark"))&&
                    (!killer->query_temp("unkill")||killer->query_temp("unkill")!=victim))
                        killer->add("vendetta/" + vmark, 1);

                if( stringp(vmark = killer->query("family/family_name")) )
                if ((int)victim->query("fambet/"+vmark) >0)
                {
                        killer->add("fealty",victim->query("combat_exp")/3000);
                        victim->add("fambet/"+killer->query("family/family_name"), -1);
                        killer->apply_condition("killer", 0);
                }
                if ((string)killer->query("family/master_id") == (string)victim->query("id") 
                    && (int)killer->query("family/generation") == (int)victim->query("family/generation") + 1) 
                {
                        killer->add("betrayer",1);
                        killer->add("fambet/"+killer->query("family/family_name"), 1);
                        killer->set("title","普通百姓");
                        killer->set("family",0);
                        killer->set("fealty",0);
                        killer->delete("class");
                       //         killer->apply_condition("killer", 4800);     
                }
                if( stringp(killer->query("family/family_name"))
                    && stringp(victim->query("family/family_name")))
                        ADVERSE_D->kill_adverse(vmark,victim->query("family/family_name"));
        }
}

void victim_penalty(object victim)
{

        object env,killer;
        int killcon;
        CHANNEL_D->do_channel(this_object(), "rumor",
             sprintf("%s被我杀死了。哈哈哈～　　～　　～", victim->name(1)));

        if( userp(victim))
        {
                env = environment(victim);
                if(!objectp(killer = victim->query_temp("last_damage_from"))) killer=victim;
                        log_file( "die_record", sprintf("%s was die coz %s in %s (%s)\n", 
                                 victim->query("id"), killer->query("id"),file_name(env), ctime(time()) ) );
                killcon=victim->query_condition("killer");
                victim->clear_condition();
                //      victim->apply_condition("killer",killcon);
                if(objectp(env)&& env->query("no_death_penalty")) return;
                victim->clear_condition();
                // Give the death penalty to the dying user.
                victim->set("bellicosity", 0);
                if(victim->query("combat_exp")>10000&&victim->query("mud_age")>=86400)
                        victim->add("combat_exp", -(int)victim->query("combat_exp") /30);
                victim->delete("vendetta");
                if( victim->query("thief") )
                        victim->set("thief", (int)victim->query("thief") / 2);
                if( (int)victim->query("potential") >(int)victim->query("learned_points"))
                {
                        victim->add("potential", ((int)victim->query("learned_points") -
                               (int)victim->query("potential"))/2 );
                }
                if(victim->query("mud_age")<=86400) return ;
                if((random(((int) victim->query("combat_exp")))+1000)>4000)
                        victim->skill_death_penalty();
        }
}


int reward_team(object leader,int exp,int pot)
{
        object *member;
        int i;
        if(pointerp(member=leader->query_team()))
        {
                for(i=0;i<sizeof(member);i++)
                {
                        if(member[i]==leader) continue;
                        if(member[i]->query("combat_exp")>=3000000)
                        {//叫leader的队员做的quest,那么其他队员可以获得的奖励=队员(leader)的本次奖励
                                member[i]->add_temp("quest/exp",exp);
                                member[i]->add_temp("quest/pot",pot);
                                if( member[i]->query_temp("quest/exp")> 720) 
                                        member[i]->set_temp("quest/exp",720);
                                if( member[i]->query_temp("quest/pot")> 81) 
                                        member[i]->set_temp("quest/pot",81);

                        }
                        else
                        {
                                member[i]->add_temp("quest/exp",exp);
                                member[i]->add_temp("quest/pot",pot);
                                if( member[i]->query_temp("quest/exp")> 1150) 
                                        member[i]->set_temp("quest/exp",1150);
                                if( member[i]->query_temp("quest/pot")> 120) 
                                        member[i]->set_temp("quest/pot",120);
                        }
                        member[i]->add("combat_exp",member[i]->query_temp("quest/exp"));
                        member[i]->add("potential",member[i]->query_temp("quest/pot"));
                        member[i]->add("fealty",member[i]->query("quest/fealty"));
                        //me->delete("quest");
                        //为了鼓励玩家的合作态度,这里不删除成员的人物标记
                        //就是说当任何一个成员完成quest之后,大家都获得相同的奖励,并且允许所有的成员
                        //同时做任务
                        tell_object(member[i],"恭喜你！你的队伍又完成了一项任务！\n");
                        tell_object(member[i],HIW"你被奖励了：\n" 
                                  +chinese_number(member[i]->query_temp("quest/exp")) + "点实战经验\n"
                                  +chinese_number(member[i]->query_temp("quest/pot")) + "点潜能\n"NOR);
                
                }       

        }
        return 1;
}
