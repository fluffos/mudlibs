//tomcat




inherit __DIR__"fei.lpc";



void set_skills()
{
        object me=this_object();
        object weapon;

        int j;
        j= 200+random(150);  
        create_family("华山派", 14, "弟子"); 
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("blade", j+random(15));
        me->set_skill("fanliangyi-dao", j+random(15));
        me->set_skill("sword", j+random(15));
        me->set_skill("huashan-jianfa", j+random(15));
        me->set_skill("zixia-shengong", j+random(15));
        me->set_skill("hunyuan-zhang", j+random(15));
        me->set_skill("huashan-shenfa", j+random(15));

        me->map_skill("force", "zixia-shengong");
        me->map_skill("dodge", "huashan-shenfa");
        me->map_skill("parry", "huashan-jianfa");
        me->map_skill("blade", "fanlingyi-dao");

	set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
          (: perform_action,"jianzhang" :),
        (: exert_function, "recover" :),
        }) );

    carry_object("/clone/misc/cloth")->wear();
     carry_object("/clone/weapon/changjian")->wield();
}
