// sanchong.c 三重劲
 
#include <ansi.h>
 
inherit F_SSERVER;

void banruo2(object me);
void banruo3(object me);

int perform(object me)
{
	string msg;
	object weapon, target;
	int ap, dp, damage;

	me->clean_up_enemy();
	target = me->select_opponent();

	if( !me->is_fighting()|| !living(me) )
	    	return notify_fail("「三重劲」只能在战斗中使用。\n");

	if( (int)me->query("max_neili") < 500 )
		return notify_fail("你的内力太低只怕连第一重都打不出来！\n");

	if( (int)me->query("neili") < 300 )
		return notify_fail("你现在的内力不足。\n");

	if (objectp(weapon = me->query_temp("weapon")))
		return notify_fail("拿着武器怎么使「三重劲」？\n");

	if(me->query_skill("unarmed") < 90)
		return notify_fail("你的拳脚这么差，连第一重劲都打不出来！\n");

	if(me->query_skill("force") < 90)
		return notify_fail("你内功的修为不够，连第一重都打不出来！\n");

	if( me->query_skill_mapped("unarmed") != "xuanhualiu-quanfa") 
		return notify_fail("你没有激发喧哗流，无法体会到三重劲\n");
 
	if( me->query_skill_mapped("force") != "shayi-xinfa") 
		return notify_fail("你用的内功并非杀意心法，无法使用三重劲\n");

	if (me->query_temp("banruo",1))
		return notify_fail("你已经在运用三重劲了。\n");

	msg = HIY "$N突然聚劲于拳，提起『一重劲』，右拳毫无变化的击向$n的胸前！\n\n"NOR;
	message_vision(msg, me, target);

	ap = ((me->query("combat_exp"))*(me->query_dex()));
	dp = ((target->query("combat_exp"))*(target->query_dex()))/2;
	if( dp < 1 )
		dp = 1;
	if( random(ap) > dp )
	{
		msg = HIR "$n正在猜想着拳有何变化之处时，已被$N单拳击中心口，$n面如金纸退后了几大步！\n\n"NOR;
		message_vision(msg, me, target);
		me->add("neili",-300);
		damage = 200 + me->query_skill("unarmed") + random(me->query_skill("force"));
		target->receive_damage("qi", damage);
		COMBAT_D->report_status(target, 0);
                me->start_busy(1);
	}
	else
	{
		msg = HIG "只见$n面带轻视，一个巧云翻身避开了$N凌厉的攻势！\n\n"NOR;
		message_vision(msg, me, target);
		me->add("neili",-100);
                me->start_busy(1);
	}

	call_out("banruo2", 3, me);

	return 1;
}

void banruo2(object me)
{
	string msg;
	object weapon, target;
	int ap, dp, damage;

	me->clean_up_enemy();
	target = me->select_opponent();

	if( !me->is_fighting()|| !living(me) )
	    	return;

	if( (int)me->query("max_neili") < 1000 )
		return;

	if( (int)me->query("neili") < 500 )
		return;

	if (objectp(weapon = me->query_temp("weapon")))
		return;

	if(me->query_skill("unarmed") < 180)
		return;

	if(me->query_skill("force") < 180)
		return;

	if( me->query_skill_mapped("unarmed") != "xuanhualiu-quanfa") 
		return;

	if( me->query_skill_mapped("force") != "shayi-xinfa") 
		return;

	msg = WHT "$N在击中$n的一瞬间右拳连续拍了下去，正是喧哗流秘技『二重劲』\n\n"NOR;
	message_vision(msg, me, target);

	ap = ((me->query("combat_exp"))*(me->query_dex()));
	dp = ((target->query("combat_exp"))*(target->query_dex()))/2;
	if( dp < 1 )
		dp = 1;
        if( random(ap * 3 / 2) > dp )
	{
		msg = HIR "$n来不及多想，$N的拳劲已经落了下来，内劲一吐，$n立刻连喷几大口鲜血！\n\n"NOR;
		message_vision(msg, me, target);
		me->add("neili",-500);
		damage = 300 + me->query_skill("unarmed") + 2 * random(me->query_skill("force"));
		target->receive_damage("qi", damage);
		COMBAT_D->report_status(target, 0);
                me->start_busy(1);
	}
	else
	{
		msg = HIG "$n躲无可躲，双手以双风惯耳之势打向$N以图同归于尽,$N逼于保命收回了劲力。\n\n"NOR;
		message_vision(msg, me, target);
		me->add("neili",-200);
		me->start_busy(3);
	}

	call_out("banruo3", 3, me);

	return;
}

void banruo3(object me)
{
	string msg;
	object weapon, target;
	int ap, dp, damage;

	me->clean_up_enemy();
	target = me->select_opponent();

	if( !me->is_fighting()|| !living(me) )
	    	return;

	if( (int)me->query("max_neili") < 1500 )
		return;

	if( (int)me->query("neili") < 700 )
		return;

	if (objectp(weapon = me->query_temp("weapon")))
		return;

	if(me->query_skill("unarmed") < 250)
		return;

	if(me->query_skill("force") < 250)
		return;

	if( me->query_skill_mapped("unarmed") != "xuanhualiu-quanfa") 
		return;
 
	if( me->query_skill_mapped("force") != "shayi-xinfa") 
		return;

	msg = HIW "$N神色凝重，在二重劲余力未消之际，突然低吼一声，伸出中指一弹加上了第『三重劲』！\n\n"NOR;
	message_vision(msg, me, target);

	ap = ((me->query("combat_exp"))*(me->query_dex()));
	dp = ((target->query("combat_exp"))*(target->query_dex()))/2;
	if( dp < 1 )
		dp = 1;
        if( random(ap * 2 / 1) > dp )
	{
		msg = HIR "$n似一片枯叶，被三重劲的拳力弹出丈外、口、眼、鼻、耳、鲜血狂流不止眼看是不行了！\n\n"NOR;
		message_vision(msg, me, target);
		me->add("neili",-700);
		damage = 400 + me->query_skill("unarmed") + 3 * random(me->query_skill("force"));
		target->receive_damage("qi", damage);
		COMBAT_D->report_status(target, 0);
                me->start_busy(2);
	}
	else
	{
		msg = HIG "$n阴狠的一小，朝$N的下阴狠狠的踢出一脚，来不及看踢中没有向后连跃几步,才检了一条命。\n\n"NOR;
		message_vision(msg, me, target);
		me->add("neili",-300);
                me->start_busy(3);
	}

	return;
}
