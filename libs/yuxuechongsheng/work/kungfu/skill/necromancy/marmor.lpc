#pragma save_binary
// m_armer.c
#include <ansi.h>
  inherit F_SSERVER;
void remove_effect(object me,object ob,int skill);
int cast(object me,object target)
{	int skill;
	object ob;
    	if(me->query_temp("apply/magic_armor"))
		return notify_fail("你身上已经穿着“奇门遁甲”了。\n");
	if(me->query_temp("execration"))
		return notify_fail("你正在念咒。\n");
	if(me->query("atman")<30)
		return notify_fail("你的灵力不够！\n");
     	skill=me->query_skill("necromancy")*2/3;
	if(me->query("gin")<5)
		return notify_fail("你的精力不足！\n");
	if(random(me->query("max_atman"))<30){
		write("你失败了。。\n");
		return 1;}
	if(skill>100) skill=100;
	me->add("atman",-30);
	me->receive_damage("gin",5);
	message_vision(
HIB"$N双掌合十，口中念道：\n"+HIY"“天地无限，乾坤自在。奇门遁甲－－出鞘！”\n"
+HIB"只见从$N眉心飞出一屡蓝光，围着$N转了几圈钻入$P体内。\n"NOR,me);
tell_room(environment(me),HIB"你只觉眼前蓝光一闪，"+
				me->query("name")+
				"已穿上一件泛着蓝光的护甲。\n"NOR,me,me);
	seteuid(getuid());
    	if (objectp(ob=new("/obj/magic_armor.lpc")))
		{
		if(!ob->move(me)) return notify_fail("你失败了！\n");
		ob->set("armor_prop/dodge",skill);
		ob->set("armor_prop/armor",20);
	   	ob->wear();
		}		
	me->start_call_out((: call_other, __FILE__,"remove_effect",me,ob,skill :),skill*4);
    	me->add_temp("apply/magic_armor",1);
	return 1;
}
void remove_effect(object me,object ob,int skill)
{      

    	me->add_temp("apply/magic_armor",-1);
	seteuid(getuid());
	if(ob)destruct(ob);
	tell_object(me,"你的奇门遁甲失效了！\n");
}
