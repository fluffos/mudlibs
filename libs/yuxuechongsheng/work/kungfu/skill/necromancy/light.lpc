// light照明术
#include <ansi.h>
  inherit F_SSERVER;
void remove_effect(object me);
int cast(object me,object target)
{
	int skill;
	string msg;
	if(me->query_temp("cast_light"))
		return notify_fail("你已经施展照明术了。\n");
	if(me->query_temp("execration"))
		return notify_fail("你正在念咒。\n");
	if(me->query("atman")<50)
		return notify_fail("你的灵力不够！\n");
	skill=me->query_skill("spells");
	if(me->query("gin")<50)
		return notify_fail("你的精力不足！\n");
	if(random(me->query("max_atman"))<5){
		write("你失败了。。\n");
		return 1;}
	me->add("atman",-10);
	me->receive_damage("gin",5);
        msg=CYN"$N默念咒语，施展照明术。忽然$N周身亮了起来。\n"NOR;
	message_vision(msg,me);
	me->set_temp("cast_light",1);
        add_light(me,1);
	if(me->is_fighting())
		me->start_busy(me->query_busy()+2);
	me->start_call_out((: call_other, __FILE__,"remove_effect",me :),skill*2);
	return 1;
}
void remove_effect(object me)
{      
    string msg;
    me->delete_temp("cast_light");
        add_light(me,-1);
    msg=CYN"$N的身体渐渐暗淡了下去，恢复了正常。\n"NOR;
    message_vision(msg,me);
    return;
    
}
