#pragma save_binary
// earth-warp.c

#include <ansi.h>
#include <command.h>
#include <login.h>

inherit F_CLEAN_UP;

int scribe(object me, object sheet, string arg) {
  object ob;
  if (me->is_fighting()) return notify_fail("你正在战斗中！\n");

  if (me->query_temp("execration"))
    return notify_fail("你正在念咒。\n");
  if ((int)me->query("mana") < 90)
    return notify_fail("你的法力不够了！\n");
  if ((int)me->query("sen") < 10)
    return notify_fail("你的精神不够集中！\n");

  message_vision("$N咬破中指,用鲜血在" + sheet->query("name") + "上画了一道阴间传送符.\n", me);
  ob = new("/obj/paper_seal");
  ob->set_name(YEL "阴界传送符" NOR, ({ "earth-warp sheet" }));
  me->add("mana", -90);
  me->receive_damage("sen", 10);
  ob->move(me);
  if (sheet->query_amount() > 1) { sheet->add_amount(-1); } else destruct(sheet);
  me->start_busy(5);

  return 1;
}
