// 天眼通

#include <ansi.h>

  inherit F_SSERVER;

int cast(object me, object target)
{

        int skill;
        object room;

        skill=me->query_skill("necromancy",1);

        if(!skill||skill<=100)
            return notify_fail("你尚未领悟天眼通魔法的精髓？\n");
        if(!me->query_skill_mapped("force")||me->query_skill_mapped("force")!="gouyee")
            return notify_fail("你尚未领悟这项法术的精髓。\n");
        if(me->query_temp("execration"))
            return notify_fail("你正在念咒。\n");
        if(!target||target->query("env/invisibility"))
            return notify_fail("cast chairvoyance on <living>\n");
        if(target==me)   return notify_fail("看自己？你疯了吗？\n");
        if(wizardp(target))   return notify_fail("找不到这个生物。。\n");
        if((int)me->query("mana") < 50 )
            return notify_fail("你的法力不够！\n");
        if((int)me->query("combat_exp")<= (int)target->query("combat_exp"))
            return notify_fail("你不能查到该人的所在！\n");        
        if((int)me->query("sen") < 10 )
            return notify_fail("你的精神没有办法有效集中！\n");

        me->add("atman", -50);
        me->receive_damage("sen", 10);

        room=environment(target);
        if (!room) return notify_fail("找不到这个生物。。\n");
        message_vision(HIB"$N念了几句咒语。一颗似眼非眼的东西出现在$N的额头上面。立刻又消失了。\n"NOR,me);
        if(room->query("no_magic"))
            return notify_fail("突然一道魔法屏障当住了你的视线。\n");
        tell_object(me,HIB"在蓝色的光芒之中，你看到：\n"NOR);
        "/cmds/std/look"->look_room(me, environment(target));
        tell_object(target,"你感到脖子发凉，黑暗处好像有双眼睛盯着你！\n"
                       "你仔细地看了一下四周，却什么也没有！\n");
       return 1;

}
