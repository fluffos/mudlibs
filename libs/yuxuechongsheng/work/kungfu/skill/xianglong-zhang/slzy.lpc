//slzy.c by diabio
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
	 int extra;
	 object weapon;
        extra = me->query_skill("xianglong-zhang",1);
	 if( !target ) target = offensive_target(me);
        if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
                return notify_fail("「"+HIY"神"NOR+HIC"龙"NOR+HIW"在"NOR+HIR"野"NOR+"」只能对战斗中的对手使用。\n");

               if( objectp(me->query_temp("weapon")) )
              return notify_fail("你必须空手使用「"+HIY"神"NOR+HIC"龙"NOR+HIW"在"NOR+HIR"野"NOR+"」！\n");

        if( (int)me->query_skill("xianglong-zhang", 1) < 200 )
                return notify_fail("你的降龙十八掌不够娴熟，无法施展出「"+HIY"神"NOR+HIC"龙"NOR+HIW"在"NOR+HIR"野"NOR+"」。\n");

        if ( (int)me->query("max_neili") < 3000)
                return notify_fail("你的内力不够，无法施展出「"+HIY"神"NOR+HIC"龙"NOR+HIW"在"NOR+HIR"野"NOR+"」。\n");;

        if ( (int)me->query("neili") < 2500)
                return notify_fail("你的真气不够，无法施展出「"+HIY"神"NOR+HIC"龙"NOR+HIW"在"NOR+HIR"野"NOR+"」。\n");
	          me->add_temp("apply/strength", extra);
                 me->add_temp("apply/attack", extra);
	me->add("neili", -1500);
		 message_vision(YEL"$N双掌平平提到胸前，神色沉重的缓缓施出降龙十八掌的最后一招「"+HIY"神"NOR+HIC"龙"NOR+HIW"在"NOR+HIR"野"NOR+YEL"」一招八式推向$n！\n" NOR,me,target);
		 message_vision(HIC"第一式！$N右掌一式「龙现于野」，勇猛无比地劈向$n！\n" NOR,me,target);
	        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		 message_vision(HIR  "第二式！$N双掌施出一式「鸿龙在陆」，隐隐约约带着掌风拍向$n！\n" NOR,me,target);
	        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		 message_vision(HIB  "第三式！$N左掌御胸，右掌一式「潜龙出海」缓缓推向$n！\n" NOR,me,target);
	        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		 message_vision(HIY  "第四式！$N使出「龙跃在天」，向$n的连拍数掌！\n" NOR,me,target);
	        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		 message_vision(HIG "第五式！$N双掌一式「双龙戏水」一前一后按向$n的胸前！\n" NOR,me,target);
	        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		 message_vision(HIM  "第六式！$N身形转动，使出「晴天六龙」向$n连打六下！\n" NOR,me,target);
	        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		 message_vision(YEL  "第七式！$N脚下一转，突然欺到$n身前，一式「龙战于野」直拍向$n面门！\n" NOR,me,target);
	        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		 message_vision(HIW "第八式！$N突然飞起，双掌居高临下最后一式「龙啸九天」全力拍向$n！\n" NOR,me,target);
	        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        me->add_temp("apply/strength", -extra);
        me->add_temp("apply/attack", -extra);
        me->start_busy(7);
        return 1;
}
