// 八方藏刀式
 
#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
        string msg;
        object weapon;
        int skill, jing_cost;
        mapping my_fam  = me->query("family");

        skill = me->query_skill("hujia-daofa",1);
        jing_cost = (int)me->query("int") - 45;


        if( me->is_fighting() )
                return notify_fail("「八方藏刀式」不能在战斗中演练。\n");
 
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你必须先去找一把刀。\n");

        if( !skill || (skill < 20))
                return notify_fail("你的胡家刀法等级不够, 不能演练「八方藏刀式」！\n");

        if( me->query("neili") < 50 )
                return notify_fail("你的内力不够，没有力气演练「八方藏刀式」！\n");
 
        if( me->query("jing") < -jing_cost )
                return notify_fail("你现在太累了，无法集中精神演练「八方藏刀式」！\n");

        msg = HIG "$N运起胡家刀法之「八方藏刀式」，手中" + weapon->name() + "随着刀意漫天飞舞。\n";
        message_vision(msg, me);

        me->add("neili", -70);
        me->add("jing", jing_cost);

        if ( skill < 60)
                me->improve_skill("hujia-daofa", 10);
        else if (skill < 90)
                me->improve_skill("hujia-daofa", 10 + random((int)me->query("int") - 9));
        else if (skill < 140)
                me->improve_skill("hujia-daofa", 10 + random((int)me->query("int") * 2 - 9));
        else if (skill < 200)
                me->improve_skill("hujia-daofa", 10 + random((int)me->query("int") * 4 - 9));
        else
                me->improve_skill("hujia-daofa", 10 + random((int)me->query("int") * 8 - 9));

        msg = HIY"$P的「胡家刀法」进步了！\n"NOR;
//    if (random(10)>5)    me->start_busy(1)

        message_vision(msg, me);

        return 1;
}


