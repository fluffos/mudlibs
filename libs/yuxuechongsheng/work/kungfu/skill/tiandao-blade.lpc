mapping *action = ({
([  "action" : "$N飞身跃起,高举$w,一招「"+HIW+"劈天式"+NOR+"」如排江倒海般指涌向$n的$l",
    "force" : 120,
    "dodge" : 40,
    "damage": 20,
    "lvl"   : 100,
    "skill_name" : HIW"劈天式"NOR ,
        "damage_type" : "砍伤"
]),
