
// hudie-xinfa.c 蝴蝶心法
// cleansword

inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("hudie-xinfa", 1);

	if ( (me->query("family/family_name") != "蝴蝶山庄"))
		return notify_fail("蝴蝶心法乃蝴蝶山庄独门神功, 非蝴蝶山庄弟子不传!\n");
					
	if ( me->query("gender") == "无性" && lvl > 49)
		return notify_fail("蝴蝶山庄不要你这种无根无性的人，你无法领会高深的蝴蝶心法。\n");

	if ((int)me->query_skill("force", 1) < 30)
		return notify_fail("你的基本内功火候还不够，无法领会蝴蝶心法。\n");
	return 1;
}

string exert_function_file(string func)
{
	return __DIR__"hudie-xinfa/" + func;
}
