// lingbo.c  洛神凌波

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("你一个人当甚么？\n");

	if( me->query("gender") == "无性")
		return notify_fail(HIY "一个公公，满场乱跳，羞也不羞？\n" NOR);

	if((int)me->query_skill("xuehai-mogong",1) < 100)
		return notify_fail(HIY "你的血海魔功修为不够。\n" NOR);

	if((int)me->query_skill("xuedun",1) < 100)
		return notify_fail(HIY "你的雪遁还不够熟练。\n" NOR);

	if((int)me->query("neili") < (int)me->query("max_neili") /50)
		return notify_fail(HIY "你现在真气不足。\n" HIY);

	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

	if( me->query("gender") == "男性")
{	
	msg = HIC 
"$N一招「起舞弄清影」，长袖翻飞，躲过$n这一招。\n"NOR;
}
	else   {
	msg = HIC 
"$N身形一晃，纤腰一扭，一招「星河鹭起」，弹地而起。\n"NOR;
}

	if( me->query("combat_exp")*random(2) > (int)target->query("combat_exp")/ 4 ) {
		msg += HIW "结果$p被$P围着转得头晕眼花！\n" NOR;
		target->start_busy( (int)me->query_skill("xuedun",1) / 30);
		me->add("neili", -(int)me->query("max_neili") /50 );
		me->start_busy(1);
	} else {
		msg += HIG "$p只是勉强的逃了开去。\n" NOR;
		me->add("neili", -(int)me->query("max_neili") /50 );
		me->start_busy(2);
	}
	message_vision(msg, me, target);

	return 1;
}
