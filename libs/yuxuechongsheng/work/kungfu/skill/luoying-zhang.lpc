一式「"+HIR+"彩云追月"+NOR+"」抢在左掌前向$n的$l拍去",
        "force" : 150,
        "dodge" : 35,
        "damage_type" : "瘀伤",
        "lvl" : 30,
        "skill_name" : "彩云追月"
]),
([      "action" : "$N使一式「"+HIG+"天如穹庐"+NOR+"」，全身突然飞速旋转，双掌忽前忽后，猛地拍向$n的胸口",
        "force" : 160,
        "dodge" : 30,
        "damage_type" : "瘀伤",
        "lvl" : 100,
        "skill_name" : "天如穹庐"
]),
([      "action" : HIW"$N身形一耸，高高跃起，居高临下，一式「弧月斩」劈向$n,"NOR,
        "need_force": 300,
        "damage_type" : "内伤",
        "lvl" : 150,
        "skill_name" : "弧月斩"
]),
([      "action" : HIG"$N双手互击，发出奇异的声响，伴着古怪的节奏，拍出一招「柳吉祥」,"NOR,
        "need_force": 300,
        "damage_type" : "内伤",
        "lvl" : 170,
        "skill_name" : "柳吉祥"
]),
([      "action" : HIC"$N双掌摇摆不定，海浪般联绵不断的发出一道道内劲，一式「碧涛颂」涌向$n,"NOR,
        "need_force": 500,
        "damage_type" : "内伤",
        "lvl" : 190,
        "skill_name" : "碧涛颂"
]),
([      "action" : "$N一式「"BLU+"落英漫天"+NOR+"」，双掌在身前疾转，掌花飞舞，
