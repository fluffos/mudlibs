]),
([      "action" : HIR"$N脸色骤然一变，双掌平推，「天地俱灭」拍出，天地间似乎突然丧失了生气,"NOR,
        "force" : 310,
        "dodge" : 10,
        "damage_type" : "内伤",
        "lvl" : 90,
        "skill_name" : "天地俱灭"
]),
([      "action" : "$N突然纵身跃入半空，一个轻巧转身，单掌劈落，
一式「"+BLK+"江城飞花"+NOR+"」，拍向$n的头顶",
        "force" : 120,
        "dodge" : 15,
