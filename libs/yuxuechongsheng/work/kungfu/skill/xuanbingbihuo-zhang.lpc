// 超级毒掌，yeah!
// by aohan

inherit SKILL;

mapping *action = ({
([      "action": "$N单掌一挥，一道"HIC" 青 "HIW" 白 "NOR"相间气流扫向$n的$l",
        "dodge": 300,
        "force": 440,
//      "binghuo": 80,
        "damage_type": "瘀伤"
]),
([      "action": "$N左掌"HIC" 青 "NOR"，右掌"HIW" 白 "NOR"，双掌飞舞着拍向$n的$l",
        "dodge": 100,
        "force": 470,
//      "binghuo": 60,
        "damage_type": "瘀伤"
]),
([      "action": "$N将口一张，喷出一道儿臂粗细，有若实质的"HIC" 青 "HIW" 白 "NOR"相间的真气朝$n的$l击去",
        "dodge": 80,
        "force": 530,
//      "binghuo": 100,
        "damage_type": "瘀伤"
]),
([      "action": "$N怒啸一声，真气一凝，猛的一展，登时"HIC" 青 "HIW" 白 "NOR"相间的真气充满丈许空间，威势端的惊人",
        "dodge": 100,
        "force": 600,
//      "binghuo": 80
        "damage_type": "瘀伤"
]),
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

mapping query_action(object me)
{
        if (random(me->query_skill("unarmed")) > 600 &&
            me->query_skill("force") > 500 &&
            me->query("neili") > 100 ) {
                me->add("neili", -100);
                return ([
                "action": "$N怒啸一声，真气一凝，猛的一展，登时"HIC" 青 "HIW" 白 "NOR"相间的真气充满丈许空间，威势端的惊人",
                "force": 600,
                "damage_type": "瘀伤"]);
        }
        return action[random(sizeof(action))];
}

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练玄冰碧火掌必须空手。\n");
        if ((int)me->query_skill("force", 1) < 100)
                return notify_fail("你的内功心法火候不够，无法练玄冰碧火掌。\n");
        if ((int)me->query("max_neili") < 600)
                return notify_fail("你的内力太弱，无法练玄冰碧火掌");
        return 1;
}


int practice_skill(object me)
{
        if ((int)me->query("qi") < 300)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 80)
                return notify_fail("你的内力不够练玄冰碧火掌。\n");
        if (me->query_skill("xuanbingbihuo-zhang", 1) < 50)
                me->receive_damage("qi", 200);
        else
                me->receive_damage("qi", 300);
        me->add("neili", -500);
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
                //if( random(me->query_skill("force")) > (damage_bonus + foo)/3 )
        if( random(me->query_skill("force")) > 10 ) {
                //victim->receive_wound("qi", (damage_bonus + foo));
            victim->apply_condition("binghuo", random(me->query_skill("force")/10) + 1 +
                        victim->query_condition("binghuo"));
        }
}

string perform_action_file(string action)
{
        return __DIR__"xuanbingbihuo-zhang/" + action;
}

