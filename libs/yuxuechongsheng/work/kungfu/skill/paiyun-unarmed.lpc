// 排云掌





inherit SKILL;

////////////////////////////////

mapping *action = ({



  // ZHAOSHI :0

  ([
    "action": "$N暗运内力，将周围的流水凝结在双掌中，一式「行云流水」以五成的功力对准$n的丹田拍去",
    "force": 50,
    "dodge": 10,
    "damage_type": "瘀伤",
    "lvl": 0,
    "skill_name": "行云流水"
  ]),
  // ZHAOSHI :1

  ([
    "action": "$N狂运内力，将空气中的水气和云气凝结在双掌中，一式「撕天排云」以五成的功力对准$n的胸前拍去",
    "force": 80,
    "dodge": -10,
    "damage_type": "瘀伤",
    "lvl": 12,
    "skill_name": "撕天排云"
  ]),
  // ZHAOSHI :2

  ([
    "action": "$N纵身一跃五丈之高，手中聚满水云之气，一式「披云戴月」居高临下的向$n的头部拍下",
    "force": 100,
    "dodge": -20,
    "damage_type": "瘀伤",
    "lvl": 20,
    "skill_name": "披云戴月"
  ]),
});
// ZHAOSHI :3
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练" + "排云掌" + "必须空手。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练" + "排云掌" + "。\n");
  return 1;
}
int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("paiyun-unarmed", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
int practice_skill(object me) {
  if ((int)me->query("qi") < 25)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("neili") < 3)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -3);
  return 1;
}  //total 34 lines!
