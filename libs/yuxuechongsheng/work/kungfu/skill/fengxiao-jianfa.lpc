// fengxiao-jianfa 风啸剑法
#include <ansi.h>
inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w点向$n的$l",
        "force" : 100,
        "dodge" : 40,
        "damage" : 60,
        "lvl"    : 50,
        "damage_type" : "刺伤"
]),
([      "action" : "$N使出「乱舞狂风」，$w闪烁不定，刺向$n的$l",
        "force" : 155,
        "dodge" : 30,
        "damage" : 120,
        "lvl"    : 100,
        "damage_type" : "刺伤"
]),
([      "action" : "$N一招「天昏地暗」，无数$w上下刺出，直向$n逼去",
        "force" : 170,
        "dodge" : 10,
        "damage" : 130,
        "lvl"    : 110,
        "damage_type" : "刺伤"
]),
([      "action" : "$N向前跨上一步，手中$w使出「剑气封喉」直刺$n的喉部",
        "force" : 190,
        "dodge" : 80,
        "damage" : 140,
        "lvl"    : 120,
        "damage_type" : "刺伤"
]),
([      "action" : HIW"只见$N抡起手中的$w，使出「光芒万丈」万点金光直射$n"NOR,
        "force" : 240,
        "dodge" : 70,
        "damage" : 140,
        "lvl"    : 160,
        "damage_type" : "内伤"
]),
});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
        if ((int)me->query_skill("fengxiao-xinfa", 1) < 100)
                return notify_fail("你的「风啸心法」火候不够，无法学「风啸剑法」。\n");
        if ((int)me->query("max_neili") < 1000)
                return notify_fail("你的内力太弱，无法练「风啸剑法」。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
    mapping a_action;
    int level=me->query_skill("fengxiao-jianfa",1);
    if (random(me->query_skill("sword")) > 300 &&
        me->query_skill("force") > 60 &&
        me->query("neili") > 100 &&
        (string)weapon->query("id") == "fengxiao jian" ) {
        me->add("neili", -100);
        return ([
        "action": HIB"$N精光爆射,手中兵器发出奇异的光芒,一招「人剑和一」，凌空击向$n"NOR,
        "attack": 100,
        "damage": 500,
        "dodge": -level*2,
        "force" : 500,
        "damage_type": "内伤"]);
    }
    a_action = action[random(sizeof(action))];
    a_action["dodge"]  = 0-level;
    a_action["damage"] = level;
    return a_action;
}
int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练「风啸剑法」。\n");
        if ((int)me->query("neili") < 30)
                return notify_fail("你的内力不够练「风啸剑法」。\n");
        me->receive_damage("qi", 30);
        me->add("neili",-15);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"fengxiao-jianfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 100 ) return 0;

        if( random(damage_bonus/2) > victim->query_str() ) {
//                victim->add("qi", 1 - damage_bonus - 100 * 3 );
                victim->receive_wound("qi", (damage_bonus - 100) / 2 );
                return HIR "你听到「唰」一声轻响好像凉一阵风吹过，忽然间$n血冒三丈，被$N剑气所伤！\n" NOR;
        }
}

