#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;

    if( !target ) target = offensive_target(me);

    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「"+HIR"火浪"NOR+"」只能对战斗中的对手使用。\n");


    if( (int)me->query_skill("chousui-zhang", 1) < 300 )
          return notify_fail("你的抽髓掌不够熟练，不会使用「火浪」。\n");

    if( (int)me->query_skill("poison", 1) < 300 )
          return notify_fail("你的抽髓掌不够熟练，不会使用「火浪」。\n");

    if((int)me->query_skill("unarmed",1) < 300)
                return notify_fail("你的基本拳法的修为不够, 不能使用这一绝技 !\n");

    if( (int)me->query("max_neili") < 16000 )
           return notify_fail("你的内力修为还不够高。\n");

    if( (int)me->query("neili") < 16000 )
           return notify_fail("你的内力不够了。\n");

    if( me->query_temp("weapon"))
                return notify_fail("你先放下手中的武器再说吧？！\n");     

      if ((int)me->query("neili")<5000)
        {
        return notify_fail(HIC"你现在内力不够，没能将「火浪」使完！\n"NOR);
        }
      msg  = HIR"只见$N双目血红，头发散乱，猛地仰天发出一声悲啸，\n"NOR;
      msg += HIR"$N把心一横，在自己舌尖狠命一咬，将毕生功力尽数喷出，\n"NOR;
      msg += HIR"顿时只见空气中血雾弥漫，腥臭无比，随即又听见\n"NOR;
      msg += HIR"$N骨骼 噼里啪啦 一阵爆响，双臂顺着喷出的血柱一推，\n"NOR;
      msg += HIR"刹那间一座丈来高的奇毒火墙拔地而起，\n"NOR;
      msg += HIR"带着排山倒海之势向$n涌去！\n"NOR;
        if (random(me->query_skill("force"))>target->query_skill("force")/2|| 
           random(me->query("combat_exp"))>(int)target->query("combat_exp")/3)
        {
                me->start_busy(3);
                target->start_busy(random(3));
                damage = (int)me->query_skill("chousui-zhang", 1);
                damage = damage + random(damage);
                target->receive_damage("qi", damage*15);
                target->receive_wound("qi", damage*15);
                target->receive_damage("jing", damage);
                target->receive_wound("jing", damage/2);
      msg += HIG"$n见状连忙提运内力，双臂猛地推出，顿时"+HIW"掌风"NOR+""+HIG"汹涌澎湃!\n"NOR;
      msg += HIG"没想到强大的气流竟然对"+HIR"火浪"NOR+""+HIG"丝毫没影响，\n"NOR;
      msg += HIG"刹那间$n就被"+HIR"火浪"NOR+""+HIG"吞没。\n"NOR;
                me->add("neili", -15000);
        } else
        {
                me->start_busy(4);
        msg += HIY"$n浑然不放在眼里，衣袖轻轻一拂，便将火浪熄灭。\n"NOR;
                me->add("neili", -2000);
        }
        message_vision(msg, me, target);
        if(!target->is_fighting(me)) target->fight_ob(me);
      if(userp(target)) target->fight_ob(me);
      else if( !target->is_killing(me) ) target->kill_ob(me);
        return 1;
}


