string *usage_skills = ({ "sword", "blade", "dagger",
                          "staff", "hammer", "club", "whip",  
                          "dodge", "parry", "force", "throwing" });

int valid_enable(string usage)
{
        return (member_array(usage, usage_skills) != -1);
}

int valid_combo(string combo)
{
        return combo == "jiuzhuan-12tian";
}

int valid_force(string force) { return 1; }

int double_attack() { return 1; }

mapping query_action(object me, object weapon)
{
    mapping a_action;
    int i, level;
    level   = (int) me->query_skill("jiuzhuan-12tian", 1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]){
                        a_action = action[NewRandom(i, 20, level/5)];
                        break;
                }
    a_action["dodge"]  = 0-level*3;
    a_action["parry"]  = 0-level*3;
    a_action["attack"]  = level*3;
    a_action["damage"] = level;
    if (me->query_temp("action_flag"))
       me->set_temp("action_msg","紧跟着");
    return a_action;

}

string query_dodge_msg(string limb,object me)
{
        me->set_temp("fight/dodge",2*me->query_skill("jiuzhuan-12tian",1));
        return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
        return notify_fail("阴阳九转十二重天博大精深，无法简单的通过学习进步。\n");
}

int practice_skill(object me)
{
        return notify_fail("阴阳九转十二重天博大精深，无法简单的通过练习进步。\n");
}

int difficult_level()
{
        return 500;
}
int is_special() 
{ 
        return 1; 
}

string perform_action_file(string action)
{
        return __DIR__"jiuzhuan-12tian/perform/" + action;
}

string exert_function_file(string action)
{
        return __DIR__"jiuzhuan-12tian/exert/" + action;
}



mixed ob_hit(object me, object victim, int damage)
{
        int ap, dp, i, level;
        object weapon = me->query_temp("weapon");
        mapping prepare;
        string attack_skill, result;

        if ( (level = victim->query_skill("jiuzhuan-12tian", 1)) < 400 || !living(victim) )
                return damage;

        dp = COMBAT_D->skill_power(victim, "dodge", SKILL_USAGE_DEFENSE);
        if( victim->query_skill_mapped("parry") == "jiuzhuan-12tian" )
                dp += COMBAT_D->skill_power(victim, "parry", SKILL_USAGE_DEFENSE);

        ap = COMBAT_D->skill_power(me, "dodge", SKILL_USAGE_DEFENSE);
        prepare = me->query_skill_prepare();
        if( !prepare ) prepare = ([]);

        if( objectp(weapon) ) attack_skill = weapon->query("skill_type");
        else switch( sizeof(prepare) )
        {
                case 0: attack_skill = "unarmed"; break;
                case 1: attack_skill = (keys(prepare))[0]; break;
                case 2: attack_skill = (keys(prepare))[me->query_temp("action_flag")]; break;
        }

        ap += COMBAT_D->skill_power(me, attack_skill, SKILL_USAGE_ATTACK);

        ap /= 100;
        dp /= 200;

        if ( random(100) > 100*ap/(ap+dp) ) {
                result = HIW "$n突然举剑一刺，剑招随便无章，却莫明奇妙地突破了$N的攻势，大出$N意料！\n";
                result += "$n一转剑势，剑招源源而出，对$N发动攻势！\n" NOR;
                victim->add("neili", -30);
                victim->add("jingli", -30);
                me->start_busy( 3 );
                damage = 0;

                return ([ "result" : result, "damage" : damage ]);
        }
        else
        if ( random(100) > 50*ap/(ap+dp) ) {
                result = HIW "$n举剑反攻，后发先至地刺向$N，不仅把$N招术封死，更进一步发出攻击！\n" NOR;
                victim->add("neili", -20);
                victim->add("jingli", -20);
               me->start_busy( 2 );
                damage = 0;

                return ([ "result" : result, "damage" : damage ]);
        }
        else
        if ( random(100) > 30*ap/(ap+dp) ) {
                result = HIW "$n提剑回刺，落点正是$N的破绽，$N不得不撤招严守，身形一晃间已退出丈许！\n" NOR;
                victim->add("jingli", -20);
               me->start_busy( 1 );
                damage = 0;

                return ([ "result" : result, "damage" : damage ]);
        }
       else if ( random(100) > 20*ap/(ap+dp) ) {
                result = HIW "$n眼见避无可避，只好提剑乱刺一通，居然出乎意料地将$N的攻击接去大半。\n" NOR;
                victim->add("jingli", -10);
                damage /= 20;

                return ([ "result" : result, "damage" : damage ]);
        }
        else
                return -damage/2;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    if( damage_bonus < 100 ) return 0;
    if( random(20*(me->query_skill("jiuzhuan-12tian",1))) > (damage_bonus )) {
                        victim->receive_wound("qi", (damage_bonus )*2);
                        victim->receive_wound("jing", (damage_bonus )*2);
                        victim->add("neili", -(int)me->query("jiali")*2);
                        return HIR "$N的阴阳九转十二重天摧毁了$n的真元和内力！！！！\n" NOR;
        }
}
void do_interlink(object me, object victim)
{
    int skill,i,j;
    object *enemy,weapon=me->query_temp("weapon");
    string all_enemy;
    
    if (!weapon) return;
    skill=me->query_skill("jiuzhuan-12tian", 1);
    if (skill>400 && random(2)>0 ){
        enemy=me->query_enemy();
        if (!sizeof(enemy)) return;
        if (sizeof(enemy)==1 && enemy[i]->query("eff_qi")<0 ) return;
        all_enemy=enemy[0]->name();
        for (i=1;i<sizeof(enemy);i++)
            all_enemy+=("、"+enemy[i]->name());
        message_vision(HIC+"$N突然阴阳九转十二重天功力大增，手中兵器光芒大盛，只见无数剑光同时射向"+all_enemy+"。\n\n" NOR,me);
        me->add("neili", -2000);
        me->set_temp("jiuzhuan-12tian",1);
        for (i=0;i<sizeof(enemy);i++){
            for (j=0;j<(skill/(60*sizeof(enemy)));j++)
                if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("eff_qi")>0 ){
                    if (environment(me) == environment(enemy[i]))
                     {
                        reset_eval_cost();
                        COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"));
                     }
                }else break;
        }
    me->delete_temp("jiuzhuan-12tian");
    }
}
