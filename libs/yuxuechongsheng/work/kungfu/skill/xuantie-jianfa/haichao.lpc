// nusha.c 怒杀
#include <ansi.h>
void remove_effect(object me, int a_amount, int d_amount);
inherit F_SSERVER;
int perform(object me, object target)
{ 
    object weapon;
    int skill, damage;
    string msg;

    if( !target ) target = offensive_target(me);

    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「"+HIY"海潮汹涌"NOR+"」只能对战斗中的对手使用。\n");
/*
    if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
*/
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
        || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    if( (int)me->query_skill("xuantie-jianfa", 1) < 200 )
          return notify_fail("你的玄铁剑法不够熟练，不会使用「"+HIY"海潮汹涌"NOR+"」。\n"); 
    if( (int)me->query_skill("yunu-xinjing", 1) < 200 )
          return notify_fail("你的玉女心经不够熟练，不会使用「"+HIY"海潮汹涌"NOR+"」。\n"); 
    if((int)me->query_skill("sword",1) < 200)
                return notify_fail("你的基本剑法的修为不够, 不能使用海潮汹涌 !\n");
    if( (int)me->query("max_neili") < 10000 )
           return notify_fail("你的内力修为还不够高。\n");
    if( (int)me->query("neili") < 1000 )
           return notify_fail("你的内力不够了。\n");


    msg = HIB "$N大吼一声，手中长剑挟巨浪潮涌之势,从轻而响，从响而轻，忽寂然\n
无声，忽轰轰之声，反复七次，向$n席卷而去。\n"NOR;  

    if( (me->query("combat_exp")) > target->query("combat_exp")) { 
//      me->start_busy(1);
   target->start_busy(random(3));

   damage = (int)me->query_skill("xuantie-jianfa", 1)*4+(int)me->query_skill("force",1);

   damage = damage + random(damage);

   target->receive_damage("qi", damage*9);
   target->receive_wound("qi", damage*9);
   me->add("neili", -damage-200);
   msg += 

HIR"$n只见$N手中兵器夹着巨浪般的声响连续不断的击过来, \n根本来不及防御,就已经被穿的透体而过！！！\n"NOR;
                message_vision(msg, me, target);
      COMBAT_D->report_status(target);    
        return 1;

 } else
    {
       me->start_busy(2);
           me->add("neili",-3000);        
       msg += HIG"$n看得分明，连忙提气纵身，避过$N致命的一剑。\n"NOR;
    }
    message_vision(msg, me, target);

    if(!target->is_fighting(me)) target->fight_ob(me);
    return 1;
}

