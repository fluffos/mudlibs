// yuxiao.c
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
        set_name(HIY "玉萧" NOR,({ "yu xiao", "yuxiao" }) );
    set_weight(500);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "支");
        set("long", "一支白玉做成的长萧，看上去晶莹温润。武林中人经常以萧代剑。\n");
        set("value", 10000);
        set("material", "bamboo");
        set("wield_msg", HIW"$N大袖一挥，手中已多了一支晶莹温润的玉萧。\n"NOR);
        set("unwield_msg", HIW"$N手中玉萧一转，眨眼间玉萧已然不见影踪。\n"NOR);
                set("no_put",1);
                set("no_drop",1);   
                set("no_pawn",1);
                set("no_give",1);
                set("no_sell",1);


    }
    init_sword(250,1);
    setup();
}   
int move(mixed dest)
{
        if(! userp(dest))       return ::move(dest);
        if( ::move(dest)==0)    return 0;
        message("channel:rumor",MAG"【谣言】"+ "某人：玉萧被"+
        dest->query("name")+"抢到手了！\n"NOR,users());
        return 1;
}


