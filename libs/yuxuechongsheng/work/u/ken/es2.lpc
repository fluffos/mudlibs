#include <ansi.h>

inherit NPC;

void create() {
  object me = this_player();
  set_name("宣传精灵", ({ "adver spirit" }));
  set("long", "本 Mud 宣传部所属的宣传工作人员。\n");

  set("age", 20);
  set("gender", "男性");

  set("max_kee", 100000);
  set_skill("unarmed", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set("combat_exp", 100);

  set("channel_id", "宣传部");

  setup();

  call_out("on_time", 10);

}

void on_time() {
  CHANNEL_D->do_channel(
    this_object(),
    "es " + HIM "\n
                 " HIR " 浴血重生 " HIY "(" HIG "IP: " HIW "202.103.69.20 " HIG "Port: " HIW "6666" HIY ")\n
                 " HIC "12月18日全新开站，欢迎大家加入游戏！
                 " HIC "12月18日全新开站，欢迎大家加入游戏！
                 新手奖励 200000 经验！
                 最完整的升官和帮派系统，还能离线练功,修建城堡,王朝战争等！！
                 " NOR
  );
  call_out("on_time", 30);
}
