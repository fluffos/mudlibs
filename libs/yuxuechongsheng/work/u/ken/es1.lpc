#include <ansi.h>

inherit NPC;

void create()
{
        object me=this_player();
        set_name("宣传精灵", ({ "adver spirit" }) );
        set("long", "本 Mud 宣传部所属的宣传工作人员。\n");

        set("age", 20);
        set("gender","男性");
        
        set("max_kee",100000);
        set_skill("unarmed",30);   
        set_skill("parry",30);
        set_skill("dodge",30);
        set("combat_exp", 100);

        set("channel_id","宣传部");

        setup();

        call_out("on_time",10);

}

void on_time()
{
        string msg;


        msg="香港风云全新开站,奖励请用help gift看.IP:cma.d2g.com PORT:5555";
             

        CHANNEL_D->do_channel(this_object(),"es",
                " [0;1;33;44m" [1m+ [1mm [1ms [1mg [1m+ [1m" [0m");
       call_out("on_time",30);
}

