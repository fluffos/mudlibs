#include <ansi.h>
inherit NPC;

void create()
{
         set_name(HIM "宣传精灵" NOR, ({ "rumor", "shizhe", "jingling" }) );
        set("gender", "女性" );
        set("age", 18);
        set("attitude", "friendly");
        set("combat_exp", 10000000000);
        set("per",30);
        set("str", 800);
        set("neili", 30);
        set("max_neili", 30);
        set("jiali", 100);
        setup();
        set("chat_chance", 1);
        set("chat_msg", ({
                "宣传精灵自言自语不知道在说些什么。\n",
        }) );
        carry_object("/clone/misc/cloth")->wear();
call_out("greeting",10);
setup();
}
