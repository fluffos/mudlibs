#include <ansi.h>

inherit NPC;

void create() {
  object me = this_player();
  set_name("信息通告", ({ "news" }));
  set("long", "本 Mud 宣传部所属的宣传工作人员。\n");

  set("age", 20);
  set("gender", "男性");

  set("max_qi", 100000);
  set_skill("unarmed", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set("combat_exp", 100);

  set("channel_id", "信息通告");

  setup();

  call_out("on_time", 10);

}

void on_time() {
  string msg;


  msg = "\n浴血重生 (IP: 202.103.69.20 Port: 6666)\n            12月18日全新开站，欢迎大家加入游戏！\n";


  CHANNEL_D->do_channel(this_object(), "es",
    "" + msg + "");
  call_out("on_time", 12);
}
