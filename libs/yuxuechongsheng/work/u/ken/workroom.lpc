// Room: /u/ken/workroom.c
// by ken
#include <room.h>
#include <ansi.h>
inherit ROOM;

int is_chat_room() { return 1; } 
void init();

void create()
{
        set("short",HIW"卧龙阁"NOR);
        set("long", 
HIR "\n格言∶从未与人相比，只求突破自己！\n"NOR
HIW "\n朋友∶近猪者赤，近墨近黑，近强者强！\n"NOR
MAG "\n学习∶终身学习  -------- 自强不息！\n"NOR
HIB "\n感觉∶平凡就是幸福！\n\n"NOR
);
        set("valid_startroom", "1");
        set("sleep_room",1);
        set("exits", ([ /* sizeof() == 4 */
        "wm" : "/d/city/wumiao",
        "gc" : "/d/city/guangchang",
        "down" : "/d/wizard/wizard_room",
]));
        set("no_fight", 1);

        setup();
       "/clone/board/ken_b"->foo();
}
void init()
{ 
        object me = this_player();
        add_action("do_wiz", "come");
        
}

int do_wiz(string arg)
{
        object me,*user;
        int    i;
        
        user = users();
        me   = this_player();
        
        if (me->query("id") != "ken" || arg !="here")
                return notify_fail("What are you doing ?");
        
        for (i=0; i<sizeof(user); i++)
        {
                if (wizardp(user[i]))
                        user[i]->move("/u/ken/workroom.lpc");
                
        }
        return 1;       
}


