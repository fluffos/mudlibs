// 感冒药
// by lonely
inherit ITEM;
#include <ansi.h>

void init()
{
        add_action("do_eat", "eat");
}
void create()
{
        set_name(HIC"感冒药"NOR, ({"ganmaoyao"}));
        set("unit", "颗");
        set("value", 10000);
        set("long", "这是一颗感冒药 用途不必说了吧。\n");
        setup();
}

int do_eat(string arg)
{
        object me=this_player();
        if (!id(arg))  return notify_fail("你要吃什么？\n");
        if (me->is_busy() )
                return notify_fail("别急，慢慢吃，小心别噎着了。\n");
        if(arg=="ganmaoyao") 
        {
message_vision(HIG"$N吃下一颗药丸，顿觉神意清爽！\n" NOR, me);
                if (me->query_condition("ill_dongshang"))
                        me->apply_condition("ill_dongshang",0);
                if (me->query_condition("ill_fashao"))
                        me->apply_condition("ill_fashao",0);
                if (me->query_condition("ill_kesou"))
                        me->apply_condition("ill_kesou",0);
                if (me->query_condition("ill_zhongshu"))
                        me->apply_condition("ill_zhongshu",0);
                destruct(this_object());
        }
        me->start_busy(2);
        return 1;
}


