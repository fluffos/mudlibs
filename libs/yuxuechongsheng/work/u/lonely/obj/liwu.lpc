inherit ITEM;
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name("礼物", ({ "liwu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗巫师发的礼物。\n");
  }
}
int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("age") < 15)
    return notify_fail("这是给老玩家的补偿,你怎么能吃？\n");
  if (me->query("buchang")) return notify_fail("你已经得到过补偿,你怎么这么贪？\n");
  me->add("potential", 150000);
  me->add("combat_exp", 150000);
  me->add("max_jingli", 500);
  me->add("jingli", 500);
  me->set_skill("force", me->query_skill("force", 1) + 100);
  me->set("buchang", 1); message_vision("$N吃下一颗礼物,感觉到自己又厉害多了。\n", this_player());
  destruct(this_object());
  return 1;
}
