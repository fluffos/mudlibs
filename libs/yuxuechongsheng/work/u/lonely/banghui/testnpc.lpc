#include <ansi.h>
#ifndef NPCDATA
#define NPCDATA "/data/npc/"
#endif
#define BANGHUI NPCDATA + "bangzhong"
inherit NPC;
inherit F_UNIQUE;
inherit F_SAVE;
string query_save_file() {
  return BANGHUI;
}
void create() {
  seteuid(getuid());
  if (!restore()) {
    set_name("魏无双", ({ "wulin mengzhu", "mengzhu", "zhu" }));
    set("title", "武林盟主");
    set("gender", "男性");
    set("age", 40);
    set("long", "他就是雄踞武林，号召天下，威风赫赫的当今武林盟主。\n");
    set("attitude", "heroism");
    set("generation", 0);
    set("winner", "NONE");
    set("str", 25);
    set("con", 25);
    set("int", 25);
    set("dex", 25);
    set("max_qi", 500);
    set("eff_qi", 500);
    set("qi", 500);
    set("max_jing", 300);
    set("jing", 300);
    set("neili", 500);
    set("max_neili", 500);
    set("jiali", 40);
    set("shen_type", 0);
    set("no_clean_up", 1);
    set("combat_exp", 800000);
    set_skill("force", 200);
    set_skill("unarmed", 200);
    set_skill("sword", 200);
    set_skill("dodge", 200);
    set_skill("parry", 200);
    set("my_weapon", "/d/shaolin/obj/changjian");
    set("my_armor", "/d/city/obj/cloth");
    setup();
    carry_object("/d/shaolin/obj/changjian")->wield();
    carry_object("/d/city/obj/cloth")->wear();
  } else {
    setup();
    if (this_object()->query("my_weapon")) carry_object(this_object()->query("my_weapon"))->wield();
    if (this_object()->query("my_armor")) carry_object(this_object()->query("my_armor"))->wear();
    UPDATE_D->check_user(this_object());
  }
  set("no_suck", 1);

}
