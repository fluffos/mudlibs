// updated.c
object creat_weapon(object me);
void create() { seteuid(getuid()); }
void check_user(object ob) {
  object weapon, marry_ring, thousand_gold;
  mapping my;
  string name, id, or, type, time;
  int value, lv, max_age;

  if (userp(ob)) {
    ob->delete("chblk_rumor");
    ob->delete("chblk_chat");
    ob->delete("chblk_shout");
    ob->delete("chblk_es");

    if (ob->query("balance")) {
      ob->add("more_money", ob->query("balance") / 100000000);
      ob->add("money", ob->query("balance") % 100000000);
      ob->delete("balance");
    }
    if (ob->query("party") && !ob->query_condition("junquest_song"))
      ob->delete("party");
    if (ob->query("more_money") > 20)
      ob->set("more_money", 20);

    thousand_gold = present("thousand-gold", ob);
    if (thousand_gold) {
      if (thousand_gold->query_amount() > 10)
        thousand_gold->set_amount(10);
    }
    if (ob->is_ghost() && !wizardp(ob)) {
      ob->set("jing", 1);
      ob->set("neili", 0);
      ob->set("jingli", 0);
      ob->set("eff_jing", 1);
      ob->set("qi", 1);
      ob->set("eff_qi", 1);
    }
    my = ob->query_entire_dbase();
    if (!pointerp(my["channels"]))
      my["channels"] = ({ "new" });
    else if (member_array("new", my["channels"]) == -1)
      my["channels"] += ({ "new" });

    if (my["more_money"] > 100) my["more_money"] = 100;
    if (!wizardp(ob))
      ob->delete("env/invisibility");
  }

  if ((ob->query("weapon/make") == 1)) {
    name = ob->query("weapon/name");
    id = ob->query("weapon/id");
    or = ob->query("weapon/or");
    type = ob->query("weapon/type");
    time = ob->query("weapon/time");
    value = ob->query("weapon/value");
    lv = ob->query("weapon/lv");
    ob->delete("weapon");
    ob->set("weapon/make", 1);
    ob->set("weapon/name", name);
    ob->set("weapon/id", id);
    ob->set("weapon/or", or);
    ob->set("weapon/type", type);
    ob->set("weapon/value", value);
    ob->set("weapon/lv", lv);
    ob->set("weapon/time", time);
  } else ob->delete("weapon");
  if (!ob->over_encumbranced()) {
    if (stringp(id = ob->query("weapon/id")))
      if (!present(id, ob)) {
        weapon = creat_weapon(ob);
        weapon->move(ob);
        weapon->wield();
      }
    if (stringp(ob->query("marry")) && !present("marry ring", ob))
      if (!present("marry ring", ob)) {
        marry_ring = new("/clone/misc/marry_ring");
        marry_ring->move(ob);
        marry_ring->wear();
      }
  }

  if (wizardp(ob)) return;
  if (!userp(ob)) return;

  if (!ob->query("age_limit")) {
    max_age = 90 + (random(ob->query("kar")) - random(ob->query("per"))) * 2;
    if (max_age < 60) max_age = 55 + random(10);
    if (max_age > 120) max_age = 115 + random(10);
    ob->set("age_limit", max_age);
  }
  if (ob->query("age") >= ob->query("age_limit"))
    call_out("greeting_me", 10, ob);

  if (undefinedp(my["eff_jing"])) my["eff_jing"] = my["max_jing"];
  if (undefinedp(my["eff_qi"])) my["eff_qi"] = my["max_qi"];
  if (my["eff_jing"] > my["max_jing"]) my["eff_jing"] = my["max_jing"];
  if (my["eff_qi"] > my["max_qi"]) my["eff_qi"] = my["max_qi"];
  if (my["jing"] > my["eff_jing"]) my["jing"] = my["eff_jing"];
  if (my["qi"] > my["eff_qi"]) my["qi"] = my["eff_qi"];

}

void check_pregnant(object ob) {
  if (ob->query("pregnant_time")) {
    if (ob->query("pregnant_time") >= 4000 && ob->query("pregnant_time") % 100 == 0) {
      tell_object(ob,
        HIM "你觉得周围的人好象都在偷偷看你，心里好不自在！\n" NOR);
      message_vision(
        HIM "$N羞涩的低着头，摆弄着自己的衣角。\n" NOR, ob);
    } else if (ob->query("pregnant_time") >= 3000 && ob->query("pregnant_time") % 100 == 0) {
      tell_object(ob,
        HIY "你觉得周围的人都好奇怪，对你指指点点，真是讨厌！\n" NOR);
      message_vision(
        HIY "$N好象有点生气地瞪起了杏眼，好凶啊。。。\n" NOR, ob);
    } else if (ob->query("pregnant_time") >= 2000 && ob->query("pregnant_time") % 100 == 0) {
      tell_object(ob, CYN "你觉得周围的人都在笑嘻嘻的看着你，可能他们已经"
        + "看出来了你……。\n" NOR);
      message_vision(
        CYN "用一种异常慈祥的目光，反复打量着自己的肚子。\n" NOR, ob);
    } else if (ob->query("pregnant_time") >= 1000 && ob->query("pregnant_time") % 100 == 0) {
      tell_object(ob, HIG "你觉得周围的人与世界都是那麽的美好，心情无比"
        + "的舒畅！" NOR, ob);
      message_vision(
        HIG "$N一身充满着安宁的气息，目光格外的温柔慈祥。\n" NOR, ob);
    } else if (ob->query("pregnant_time") >= 100 && ob->query("pregnant_time") % 100 == 0) {
      tell_object(ob, RED "你觉得周围的人都用着极其关切的目光注视着你，"
        + "难道是……快了？\n" NOR);
      message_vision(
        RED "$N已经行动十分的迟缓了，不时的停下来喘气！\n" NOR, ob);
    } else if (ob->query("pregnant_time") == 10) {
      tell_object(ob, HIM "你觉得腹中疼痛无比，看来是快要临盆了，"
        + "一个声音好象在告诉你，快到产房去啊！？\n" NOR);
    } else if (ob->query("pregnant_time") == 1) {
      tell_object(ob, HIR "周围的人都惊讶的合不上了嘴巴，一定是见到了"
        + "什么奇怪事情！\n你只觉得腹中一阵巨痛，几乎要疼晕过去！\n" NOR);
      message_vision(HIR "$N捂着大大的肚子，蹲在了地上，脸上一副极其"
        + "痛苦的神情！\n" NOR, ob);
      call_out("baby_born", 10, ob);
    }

    ob->add("pregnant_time", -1);
  }
  return;
}

object creat_weapon(object me) {
  object weapon;
  string mask;    //the verible that record the type of weapon
  mask = me->query("weapon/type");
  switch (mask) {
    case "剑":
      weapon = new("/d/npc/m_weapon/weapon/m_sword", 1);
      if (me->query("max_neili") < 1000) {
        weapon->set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
        weapon->set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
      } else if (me->query("max_neili") < 10000) {
        weapon->set("wield_msg", HIY "$N「唰」的一声抽出$n" + HIY + "挽了个剑花，但见寒芒吞吐，电闪星飞。 \n" NOR);
        weapon->set("unwield_msg", HIY "$N「唰」地把$n" + HIY + "插回剑鞘。\n" NOR);
      } else {
        weapon->set("wield_msg", HIW "$N暗运内力，只见一道白芒闪过，$N手中已无声无息地多了一把$n" + HIW + "。\n" NOR);
        weapon->set("unwield_msg", HIW "$n" + HIW + "自$N掌中飞起，在半空中一转，「唰」地跃入剑鞘。\n" NOR);
      }
      return weapon;
    case "刀":
      weapon = new("/d/npc/m_weapon/weapon/m_blade", 1);
      return weapon;
    case "棍":
      weapon = new("/d/npc/m_weapon/weapon/m_club", 1);
      return weapon;
    case "杖":
      weapon = new("/d/npc/m_weapon/weapon/m_staff", 1);
      return weapon;
    case "鞭":
      weapon = new("/d/npc/m_weapon/weapon/m_whip", 1);
      return weapon;
  }
  return 0;
}

int greeting_me(object me) {
  if (!objectp(me))
    return 1;

  if (me->query("age") > me->query("age_limit")) {
    remove_call_out("zhuanshi");
    call_out("zhuanshi", 10, me);
    return 1;
  } else {
    tell_object(me, RED "忽然你心中涌出一股不祥的预感，仿佛大限将至，"
      + "还是及早准备后事吧！\n" NOR);
    return 1;
  }
}
int zhuanshi(object me) {
  message_vision(RED "$N忽然大叫一声：“我命归已，快救我！”"
    + "话音未落，\n黑白无常一把用锁链将$N套起，拘到了地府！\n" NOR, me);
  message("channel:rumor", HIB "【阴曹地府】" + me->query("name")
    + "大限已至，被黑白无常拘至地府！\n" NOR, users());

  me->set_temp("linji/youming", 1);
  me->set_ghost(1);
  me->move("/d/death/difu");
  return 1;
}

void baby_born(object ob) {
  object obb;

  if ((int)(ob->query("age")) < 20) {
    message_vision(HIR "\n$N似乎觉得腹中一阵巨痛，大叫一声，由于$N年龄"
      + "太小，不适合生育，\n所以$N的孩子流产了，好可怜啊！\n" NOR, ob);

    ob->set("eff_qi", 1);
    ob->set("eff_jing", 1);
    ob->set("neili", 0);
    ob->unconcious();
    return;
  } else if (base_name(environment(ob)) != "/d/city/chanfang") {
    message_vision(HIR "\n$N似乎觉得腹中一阵巨痛，大叫一声，由于这里的"
      + "环境实在是太恶劣了，\n所以$N的孩子流产了，好可怜啊！\n" NOR, ob);
    ob->set("eff_qi", 1);
    ob->set("eff_jing", 1);
    ob->set("neili", 0);
    ob->unconcious();
    return;
  }

  if (ob->query("couple/couple_id"))
    obb = find_player(ob->query("couple/couple_id"));

  if (obb && present(ob->query("couple/couple_id"), environment(ob))) {
    ob->start_busy(100);
    message_vision(HIM "\n$N忽觉腹中一阵颤动，疼得大喊一声，$n赶紧拉"
      + "住$N的手，柔声说道：我在这里，别怕。 \n" NOR, ob, obb);
  } else if (obb)
    tell_object(obb, HIR "靠，老婆都要生了，还不快到产房去！\n" NOR);

  ob->set("neili", 0);
  ob->set("eff_jing", 10);
  ob->set("eff_qi", 10);
  call_out("baby_born1", 20, ob, obb);

  return;
}

void baby_born1(object ob, object obb) {
  if (obb && present(obb->query("id"), environment(ob))) {
    message_vision(HIY "\n$N已是大汗淋漓，一直都在呼天抢地，双手紧紧握"
      + "住$n的手不放。\n婴儿已经探出了头．．．\n" NOR, ob, obb);
    call_out("baby_born2", 20, ob, obb);
  } else {
    message_vision(HIR "\n$N疼得死去活来，呼天抢地，可是好象婴儿还是"
      + "没动劲，会不会难产啊？\n" NOR, ob);
    call_out("baby_born2", 40, ob, obb);
  }
  return;
}

void baby_born2(object ob, object obb) {
  object baby;
  int rp;

  if (obb && present(obb->query("id"), environment(ob))) {
    message_vision(HIY "\n「哇」．．．，婴儿出世了！\n" +
      "\n$N面色苍白，斜倚在床头，看看孩子满意地露出一丝微笑。\n" NOR, ob);

    ob->start_busy(1);
    ob->set("neili", 0);
    ob->set("jing", 0);
    ob->set("qi", 0);
    baby = new("/clone/user/baby");
    if (random(2)) {
      baby->set("gender", "男性");
      baby->set_name("小" + obb->query("name"),
        ({ "xiao " + obb->query("id"), "baby" }));

      baby->set("title", obb->query("name") + "和" + ob->query("name") + "的爱子");

      message("channel:rumor", HIR "【家有喜事】：" HIM "恭喜 " HIY
        +ob->query("name") + "(" + ob->query("id") + ")" HIM "给" HIY
        +obb->query("name") + "(" + obb->query("id") + ")" HIM "添了一个"
        +HIW "大胖小子！\n" NOR, users());
    } else {
      baby->set("gender", "女性");
      baby->set_name("小" + ob->query("name"),
        ({ "xiao " + ob->query("id"), "baby" }));

      baby->set("title", obb->query("name") + "和" + ob->query("name") + "的爱女");

      message("channel:rumor", HIR "【家有喜事】：" HIM "恭喜 " HIY
        +ob->query("name") + "(" + ob->query("id") + ")" HIM "给" HIY
        +obb->query("name") + "(" + obb->query("id") + ")" HIM "添了一位"
        +HIW "宝贝千金！\n" NOR, users());
    }

    rp = random(10);
    baby->set("per", (ob->query("per") * rp / 10 + obb->query("per") * (10 - rp) / 10));
    rp = random(10);
    baby->set("str", (ob->query("str") * rp / 10 + obb->query("str") * (10 - rp) / 10));
    rp = random(10);
    baby->set("con", (ob->query("con") * rp / 10 + obb->query("con") * (10 - rp) / 10));
    rp = random(10);
    baby->set("int", (ob->query("int") * rp / 10 + obb->query("int") * (10 - rp) / 10));
    rp = random(10);
    baby->set("dex", (ob->query("dex") * rp / 10 + obb->query("dex") * (10 - rp) / 10));
    rp = random(10);
    baby->set("kar", (ob->query("kar") * rp / 10 + obb->query("kar") * (10 - rp) / 10));

    baby->set("parents/father", obb->query("id"));
    baby->set("parents/mother", ob->query("id"));

    ob->set("couple/child", baby->query("id"));
    obb->set("couple/child", baby->query("id"));
    ob->save();
    obb->save();

    if (!baby->move(environment(ob)))
      baby->move(environment(environment(ob)));
    baby->save();
    baby->load_baby(ob);

  } else {
    message_vision(HIY "\n$N似乎觉得腹中一阵巨痛，大叫一声，由于关键时刻你"
      + "的男人没有守侯在身边，\n所以$N的孩子流产了，好可怜啊！\n" NOR, ob);
    ob->set("qi", 1);
    ob->set("jing", 1);
    ob->set("neili", 0);
    ob->unconcious();
  }

  return;
}
