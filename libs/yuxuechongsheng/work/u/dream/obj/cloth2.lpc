//b2-cloth.c
// beyond 以彼之道，还彼之身
#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(HIM "无重力轻便太空靴" NOR, ({ "taikong xue", "xuezi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "和生化动力头盔一样，都是重型生化机械动力装甲的附属产品，是逃命的必备佳品。\n");
    set("unit", "件");
    set("value", 9000);
    set("material", "boots");
    set("armor_prop/armor", 20000);
    set("armor_prop/personality", 7200);
    set("wear_msg", "只见$N套上一双" + "$n" NOR + "。\n");
    set("unequip_msg", "$N将脚上的" + "$n" NOR + "脱了下来。\n");
  }
  setup();
}
int query_autoload() {
  return 1;
}
