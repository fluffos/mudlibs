//b-cloth.c
// beyond 以彼之道，还彼之身
#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create() {
  set_name(HIY "纯真铂金戒指" NOR, ({ "jiezhi", "zhihuan" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "看着它你竟然听到了婚礼进行曲。\n");
    set("unit", "个");
    set("value", 9000);
    set("material", "gold");
    set("armor_prop/armor", 20000);
    set("armor_prop/personality", 7200);
    set("wear_msg", "只见$N戴上一个" + "$n" NOR + "。\n");
    set("unequip_msg", "$N将手指上的" + "$n" NOR + "轻轻的取了下来。\n");
  }
  setup();
}
int query_autoload() {
  return 1;
}
