//b3-cloth.c
// beyond 以彼之道，还彼之身
#include <ansi.h>
#include <armor.h>

inherit WAIST;

void create() {
  set_name(YEL "负重动力皮带" NOR, ({ "dongli pidai", "pidai" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "有了它才能担负得起重型生化机械动力装甲的重量,发出金属般的光泽。\n");
    set("unit", "件");
    set("value", 9000);
    set("material", "waist");
    set("armor_prop/armor", 20000);
    set("armor_prop/personality", 7200);
    set("wear_msg", "只见$N系上一条" + "$n" NOR + "。\n");
    set("unequip_msg", "$N将腰上的" + "$n" NOR + "取了下来。\n");
  }
  setup();
}
int query_autoload() {
  return 1;
}
