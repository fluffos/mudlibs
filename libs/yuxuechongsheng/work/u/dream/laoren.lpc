// By Dream
#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
    set_name(HIW"圣诞老人"NOR, ({ "shengdan laoren", "laoren" }) );
         set("nickname", HIG"浴血欢迎您的到来"NOR);
        set("gender", "男性" );
        set("age", 18);
        set("long", YEL"这位是就是圣诞老人，如果你向他打听“圣诞节”的消息，就能得到一份礼物。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);

        set("inquiry", ([
                       "圣诞节" : (: ask_me :),
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖浴血重生〗"+HIR+"(ask laoren about 圣诞节)\n"+NOR+HIW+"， 您可以来我这里得到圣诞礼物．"NOR);
   command("es " + HIC"欢迎光临〖浴血重生〗,IP: 202.103.69.20 Port: 6666,现在开始发圣诞礼物，明天结束此活动 \n"NOR);
}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        
         if ((int) me->query("shengdan"))
                return "对不起啊，您已经拿过圣诞礼物了，不能再拿了！";
               else
        {
                me->set("shengdan", 1);
                me->add("kar", 2);
                me->add("potential", 100000);
                me->add("food", 20000);
                me->add("water", 20000);
                me->add("combat_exp",200000);
me->set_skill("literate",(me->query_skill("literate",1)+100));
      CHANNEL_D->do_channel(me, "es", sprintf("在下%s今日光临〖浴血重生〗（ 202.103.69.20 : 6666）\n         现已得到圣诞老人给的圣诞节礼物了！", me->name(1)));
               return "欢迎光临"NOR+HIR"〖浴血重生〗"NOR"，这是给您的圣诞节礼物！"NOR;
        }
}


