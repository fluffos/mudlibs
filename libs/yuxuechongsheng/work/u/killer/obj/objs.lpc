// ported to CCTX by JackyBoy@CuteRabbits Studio 1999/4/1
#include <command.h>
inherit ITEM;
void create()
{
        set_name("档案恢复器", ({"objs"}));
        set_weight(2000);

        if( clonep() )
                set_default_object(__FILE__);
                else {  
                set("unit", "只");
                set("long", "档案恢复器，可以恢复(hf ID)档案。\n");
                set("value", 0);
        }
}
void init()
{
        add_action("do_hf", "hf");
}
int do_hf(string arg)
{       
        if (find_player(arg))
                return notify_fail("这个玩家正在连线。\n");
        if (file_size("/backup/2002-1-12/login/"+arg[0..0]+"/"+arg+".o") < 0
        || file_size("/backup/2002-1-12/user/"+arg[0..0]+"/"+arg+".o") < 0)
                return notify_fail("没有他的档案。\n");
        cp ("/backup/2002-1-12/login/"+arg[0..0]+"/"+arg+".o",
                "/data/login/"+arg[0..0]+"/"+arg+".o");
        cp ("/backup/2002-1-12/user/"+arg[0..0]+"/"+arg+".o",
                "/data/user/"+arg[0..0]+"/"+arg+".o");
        "/cmds/arch/rehash"->main(this_player(), "/data/user/"+arg[0..0]+"/");
        "/cmds/arch/rehash"->main(this_player(), "/data/login/"+arg[0..0]+"/");
        tell_object(this_player(), arg + "的档案已经恢复。\n");
        return 1;
}
