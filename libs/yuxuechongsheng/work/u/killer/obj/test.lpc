inherit ITEM;

void create()
{
    set_name("测试器", ({"ceshi"}));
    set("unit", "个");
    set("value", 0);
    set("long", "测试器\n");
}
void init()
{
    add_action("do_test1", "testes");
    add_action("do_test", "tests");
}
int do_test(string arg)
{
    object obj, *inv;
    int i, qi, eff_qi, neili, force, n, q;

    if (!arg || arg == "")
        return notify_fail("指令格式：tests ID 。\n");
    if (arg == "here")
    {
        inv = all_inventory(environment(this_player()));
                if (!sizeof(inv)) return notify_fail("这里没有别人！\n");
        for (i = 0; i < sizeof(inv); i++)
        {
                if ((!inv[i]->is_character()) || userp(inv[i])) continue;
                qi = inv[i]->query("qi");
                        eff_qi = inv[i]->query("eff_qi");
                        neili = inv[i]->query("neili");
                        force = inv[i]->query_skill("force", 1);
                        tell_object(this_player(), inv[i]->name() + "目前"+
                                sprintf("qi=%d,eff_qi=%d,neili=%d,force=%d",
                                        qi, eff_qi, neili, force)+"。\n");
                q = eff_qi - qi;
                if (q < 10) continue;
                n = 100 * q / force;
                if (n < 20) n = 20;
                    if (neili < n)
                {
                        q = q * neili / n;
                        n = neili;
                }
                tell_object(this_player(),
                        sprintf("计算结果：消耗内力 %d ，恢复气血 %d 。\n", n, q));
                if (q < 0)
                        tell_object(this_player(), "找到啦！找到啦！\n");
            }
            return 1;
        }else
        {
                obj = find_player(arg);
                if (!obj)
                obj = present(arg, environment(this_player()));
        if (!obj)
                return notify_fail("指令格式：tests ID 。\n");
                qi = obj->query("qi");
                eff_qi = obj->query("eff_qi");
                neili = obj->query("neili");
                force = obj->query_skill("force", 1);
                tell_object(this_player(), obj->name() + "目前"+
                        sprintf("qi=%d,eff_qi=%d,neili=%d,force=%d",
                                qi, eff_qi, neili, force)+"。\n");
            q = eff_qi - qi;
            if (q < 10) return notify_fail("这种情况不需要测试。\n");
            n = 100 * q / force;
            if (n < 20) n = 20;
        
            if (neili < n)
            {
                q = q * neili / n;
                n = neili;
            }
            tell_object(this_player(), sprintf("计算结果：消耗内力 %d ，恢复气血 %d 。\n", n, q));
            return 1;
        }
        return 1;
}
int do_test1(string arg)
{
    int qi, eff_qi, neili, force, n, q;

    if (!arg || arg == "")
        return notify_fail("指令格式：testes 数字一(qi) 数字二(eff_qi) 数字三(force) 数字四(neili) 。\n");
    if (sscanf(arg, "%d %d %d %d", qi, eff_qi, force, neili) != 4)
        return notify_fail("指令格式：testes 数字一(qi) 数字二(eff_qi) 数字三(force) 数字四(neili) 。\n");

    q = eff_qi - qi;
    if (q < 10) return notify_fail("这种情况不需要测试。\n");
    n = 100 * q / force;
    if (n < 20) n = 20;

    if (neili < n)
    {
        q = q * neili / n;
        n = neili;
    }
    tell_object(this_player(), sprintf("计算结果：消耗内力 %d ，恢复气血 %d 。\n", n, q));
    return 1;
}
