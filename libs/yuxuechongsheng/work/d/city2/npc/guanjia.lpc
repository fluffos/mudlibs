// luguanji.c 女管家
  inherit BHNPC;
string query_save_file() { return DATA_DIR + "npc/女管家"; } 
void create()
{
	set_name("女管家", ({ "guan jia", "guan" }));
	set("gender", "女性");
    this_object()->init_bhnpc();
        set("area_name","满虫");
    set("area_file","/d/city2/aobai4.lpc");
    set("ziyuan","银子");
    set("jizhi",35);
    set("kaifa",20);
	set("age", 45);
	set("combat_exp", 7500);
        set_skill("unarmed", 35);
        set_skill("force", 35);
        set_skill("dodge", 40);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 40);
	set("shen_type", -1);
	setup();
	carry_object("/d/city2/obj/diaopi")->wear();
	add_money("silver", 10);
}
#include <die.h>
