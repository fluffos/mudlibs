#pragma save_binary
 // judge_guard.c
#include <ansi.h>
int back_home(string arg);

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("熊廷弼", ({ "xiong ting bi","xiong","bi" }) );
    set("gender", "男性" );
    set("shen_type",1);
        create_family("朝廷", 5, "偏将军");
set("no_arrest",1);
        set("age", 44);
    set("dex", 18);
    set("con", 21);
    set("str", 50);
    set("int", 25);
    set("per", 27);
    set("long","他是朝廷镇守辽东的最高军事长官！！\n");
    set("vendetta_mark", "authority");
      set("combat_exp", 5000000);

    set("max_neili", 200);
    set("neili", 200);
    set("force_factor", 20);
    set("attitude", "heroism");
  
    set("chat_chance_combat", 15);
    set("chat_msg_combat", ({
              "熊廷弼说道：荡平野羊寨！！！\n",
              "熊廷弼说道：杀光土匪，杀啊！！!\n",
        }) );

      set_skill("parry", 500);
      set_skill("blade", 500);
      set_skill("dodge", 500);
      set_skill("chaos-steps", 500);

    map_skill("dodge", "chaos-steps");
        set("title", HIY "朝廷二品官 辽东总兵 " NOR );

    setup();
        
    carry_object("/obj/npc/obj/blade")->wield();
    carry_object(__DIR__"obj/cloth")->wear();
}
void init()
{
        object ob;
        ob = this_player();
        ::init();
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
      }
void greeting(object ob)
{
        command("say 汝可有兵符?本镇当亲自验证此符！！");
}
int accept_object(object who, object ob)
{       int i; 
        object bing,*list,obj;
        object ling;
if (ob->query("id")=="bingfu"
    && ob->query("owner")==who->query("id"))
        {
        command("say 带上军令出征去吧，祝汝成功！！!\n");
        call_out( "todest",1,ob );
        list=({});
        i=-who->query("rank")+14;
        ling=new(__DIR__"obj/junling");
        ling->set("owner",ob->query("owner"));
        ling->set("time",ob->query("time"));
        ling->set("sha_1",1);
        ling->set("sha_2",1);
        ling->set("sha_3",1);
        ling->set("sha_4",1);
        ling->set("sha_5",1);
        ling->move(who);
        while(i--)
           {
           bing=new(__DIR__"bing");
           bing->set("owner",ob->query("owner"));
           bing->set("temp_owner",ob->query("owner"));
           bing->set("time",ob->query("time"));
           bing->move("/d/chaoting/xianya/xianya_squre");
	   bing->set_temp("protecting",who);
           list+=({bing});
           }
        who->move("/d/chaoting/xianya/xianya_squre");
        for(i=1;i<sizeof(list);i++)
           {
           list[i]->set_temp("protect",list[i-1]);
           list[i-1]->set_temp("protecter",list[i]);
           }
        list[0]->set_temp("protect",list[sizeof(list)-1]);
        list[sizeof(list)-1]->set_temp("protecter",list[0]);
        return 1;
        }
        command("say 无用之物，你要来做甚？某家要了！\n");
        return 0;
}
void todest(object ob)
{
	destruct(ob);
}

void attempt_apprentice(object ob)
{
                string title;
    
if(((string)ob->query("family/family_name") != "朝廷") 
        ||((int)ob->query("rank") >3)||((int)ob->query("rank")==1))
        {
        // 他只收一、二品官(防止有玩家在没有拜他之前就升到了一品官而无法拜)        
        command("say 本帅公务繁忙无心收徒"+RANK_D->query_respect(ob) +"日后再说吧!");
        return;
                }
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + 
                                "只要你好好为朝廷出力，他日必能出人头地，去吧。\n");
                title=ob->query("title");                       
        command("recruit " + ob->query("id") );
        ob->set("title",title); 
}

void recruit_apprentice(object ob)
{
            if( ::recruit_apprentice(ob) )
           ob->set("class", "officer");
}

