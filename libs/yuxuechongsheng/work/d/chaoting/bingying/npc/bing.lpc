 // judge_guard.c
int back_home(string arg);

inherit NPC;

void create()
{
	set_name("辽东大营士兵", ({ "bing" }) );
    	set("gender", "男性" );
	set("age", 44);
        set("cor", 18);
        set("cps", 21);
        set("str", 50);
        set("int", 25);
        set("per", 27);
        set("long","他们是训练有素，的辽东大营士兵，专门负责剿匪任务！！！\n");
        set("vendetta_mark", "authority");
          set("combat_exp", 500000);
        set("max_neili", 200);
        set("neili", 200);
        set("force_factor", 20);

        set("attitude", "heroism");
        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
             "士兵说道：荡平野羊寨！！！\n",
              "士兵说道：杀光土匪，杀啊！！!\n",
        }) );

          set_skill("parry", 200);
          set_skill("blade", 200);
          set_skill("dodge",200);
        
          set_skill("chaos-steps", 200);

        map_skill("dodge", "chaos-steps");

        setup();
        
	carry_object("/obj/npc/obj/blade")->wield();
   	carry_object(__DIR__"obj/cloth")->wear();
}
void init()
{
	object ob;
	ob = this_player();
	::init();
	remove_call_out("greeting");
	call_out("greeting", 1, ob);
}

void greeting(object ob)
{
	int i;
	object *npc;
if (ob->query("id")==this_object()->query("owner")
&& ob->query("id")==this_object()->query("temp_owner"))
{
	command ("follow "+ob->query("id"));
	this_object()->delete("temp_owner");
}
	npc=all_inventory(environment(this_object()));
	for(i=0;i<sizeof(npc);i++)
	    {
	    if(npc[i]->query("name")==("喽罗")
	        &&!userp(npc[i])&&!npc[i]->is_corpse())
	        {
	        command ("kill "+npc[i]->query("id"));
	        }
	    }
	return ;
}
void killed_enemy(object who)
{
        call_out("dissolve", 1);
}
void dissolve()
{
        command("kill luo");
}
int heal_up()
{
::heal_up();
if (this_object()->query("time")<(int)time())
     {call_out("dodest",1);
      }
}
void dodest()
{
	command("say 时辰已过，我等告退！");
	destruct(this_object());
}
