#pragma save_binary
// Room: /open/tony/jjf/jjf_2.c
inherit ROOM;
int do_find();

void create()
{
    set("coor",({90,2940,-10}));
	set("short", "密室");     
        set("long", @LONG
这儿很黑,如果不是因为左边墙上的那颗夜明珠，那就真的什么都
看不见了,右边墙上有一幅画，是与这间房子又是如此的不协调。
LONG
        );
        set("objects", ([ /* sizeof() == 0 */
                       
__DIR__"npc/guan_jia":  0,
]));
        set("no_clean_up", 0);

        setup();
}

void init()
{
        add_action("do_push", "push");
       add_action("do_pull", "pull");
}
int do_push(string arg)
{
        object me, ob, weapon;
        me = this_player();

        if( !arg || arg!="墙" ) 
                return notify_fail("你要推什么？\n");
                {
         message("vision","上面出现一丝光芒! \n", environment(me));
               
                set("exits/up", __DIR__"jjf_5");
                call_out("close_passage", 5);
                return 1;       
        }
        }
int do_pull(string arg)
{
        object me, ob, weapon;
        me = this_player();

        if( !arg || arg!="画" ) 
                return notify_fail("你要拉什么？\n");
                {
         message("vision","夜明珠突得一闪! \n", environment(me));
               
     set("exits/east", __DIR__"secret_room2");
                call_out("close_passage", 5);
                return 1;       
        }
        }




void close_passage()
{
        object room;

 if( !query("exits/up") && !query("exits/east")  ) return;
 if( query("exits/up") ) {
        message("vision", 
"地板忽然发出轧轧的声音，将向上的通道盖住了。\n",
                this_object() );
delete("exits/up");}
if( query("exits/east") ) {
 message("vision", 
"夜明珠暗淡了下来。\n",this_object() );
delete("exits/east");}
}

