// dajiangjun.c
#include <ansi.h>

int alert_gaoshou();
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("袁崇焕", ({ "jiang jun", "jiang", "yuan", }) );
        set("gender", "男性" );
        set("shen_type", 1);
        set("age", 54);
        set("str", 30);
        set("con", 30);
        set("dex", 30);
        set("int", 30);
        set("rank", 1);
        set("max_neili", 2000);
        set("neili", 2000);
        set("force_factor", 40);
        set("rank_info/respect", "大将军");
        set("long",               
        "袁崇焕是本朝著名的儒将，穿上一件金丝蟒袍更透出一股威严\n"
        "此人刚正不讹，为朝廷鞠躬尽粹。死而后已，对儿子管教甚严\n");
            set("vendetta_mark", "authority");
        create_family("朝廷", 5, "大将军");
        set("class", "officer");
        set("title", HIY "朝廷一品官 辅国大将军" NOR );
          set("combat_exp", 10000000);
        set_skill("move",100);    
          set_skill("unarmed",1000);
          set_skill("parry",1000);
          set_skill("dodge", 1000);
        set_skill("spear",1000);
          set_skill("force",1000);
        set_skill("literate",1500);
        set_skill("leadership",1500);  
        set_skill("strategy",1500);
          set_skill("bahuang-qiangfa",1000);
         set_skill("luohan-quan",1000);
          set_skill("tiyunzong",1000);
          set_skill("bawang-force",1000);
        map_skill("unarmed", "luohan-quan");
        map_skill("force", "bawang-force");
        map_skill("parry", "bahuang-qiangfa");
        map_skill("dodge", "tiyunzong");
        set("inquiry", ([
                "前程" : 
                "只要你好好为朝廷出力，他日必能出人头地，去吧。",
                       ]) );

        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
        (: alert_gaoshou :),
        (: alert_gaoshou :),
        (: alert_gaoshou :),
                        }) );

        setup();
        carry_object("/obj/weapon/bawangqiang")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}


void init()
{
         object ob;
         ::init();
if( interactive(ob = this_player()) && !is_fighting() )
   		 {
          remove_call_out("greeting");
          call_out("greeting", 1, ob);
       	 }
}

void greeting(object ob)
{
if( !ob || environment(ob) != environment() ) return;
 if((string)ob->query("family/family_name") != "朝廷")
  if( (int)ob->query("PKS")-ob->query("BCF")*2 > 15 )  
        {
        command("say 好个沾满血腥的凶徒，竟敢在此撒野，来人!给我拿下!");
        kill_ob(ob);
        }
      else {
			message_vision("\n袁将军看到$N闯进来，喝道:如有冤情，可向地方"+
							  "官申诉!\n\n",ob);}
}
void attempt_apprentice(object ob)
{
		string title;
    
if(((string)ob->query("family/family_name") != "朝廷") 
        ||((int)ob->query("rank") >5))
    	{
	// 他只收一、二品官(防止有玩家在没有拜他之前就升到了一品官而无法拜)		
        command("say 本帅公务繁忙无心收徒"+RANK_D->query_respect(ob) +"日后再说吧!");
        return;
		}
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + 
				"只要你好好为朝廷出力，他日必能出人头地，去吧。\n");
		title=ob->query("title");			
        command("recruit " + ob->query("id") );
        ob->set("title",title); 
}

void recruit_apprentice(object ob)
{
	    if( ::recruit_apprentice(ob) )
           ob->set("class", "officer");
}
 


int alert_gaoshou()
{
        object gaoshou,me;
                me= this_object();
           if( (8-me->query("rank")) <= me->query_temp("havecalled")  )
                            return 0;
if( !me->is_fighting() )
                    return 0;
                     message_vision("$N纵声长啸,呼叫援兵。\n", me);
                     me->receive_damage("qi", 20);
                 me->add_temp("havecalled",1);  

        seteuid(getuid());
        gaoshou = new("/obj/npc/gaoshou");
        gaoshou->move(environment(me));
        gaoshou->invocation(me);
                return 1;
}

int accept_object(object who, object ob)
{
object card,bing;
if (ob->query("id")=="zhi"&&
    ob->query("real"))
{
        if(ob->query("owner")==who->query("name"))
        {
                if(ob->query("管辖地")
                ==this_object()->query("管辖地"))
                {
                bing=new("/open/tony/king/bing");
bing->set("leader",ob->query("owner"));
                bing->move("/d/jiangnan/sroad1");
                bing=new("/open/tony/king/bing");
bing->set("leader",ob->query("owner"));
                bing->move("/d/city/yiroad1");
                bing=new("/open/tony/king/bing");
bing->set("leader",ob->query("owner"));
                bing->move("/d/city/road5");
                bing=new("/open/tony/king/bing");
bing->set("leader",ob->query("owner"));
                bing->move("/d/city/nroad1");
                card=new("open/tony/king/token");
card->set("owner",ob->query("owner"));
                card->move(who);
                card=new("open/tony/king/token");
card->set("owner",ob->query("owner"));
                card->move(who);
                card=new("open/tony/king/token");
card->set("owner",ob->query("owner"));
                card->move(who);
                command("say 臣领旨!吾皇万岁!万万岁!");
                return 1;
                }
        else {  command("say 那不是我的管辖地!");
                return 0;}
        }
        else {
        command("say 你从哪里偷来的圣旨!!来人哪!拿下!");
        this_object()->kill(who);
        who->kill(this_object());
        return 1;
        }
return 0;
}
}
