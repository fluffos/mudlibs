#pragma save_binary
// luguanji.c 女管家

inherit NPC;

void create() {
  set_name("将军府大管家", ({ "guan jia", "guan" }));
  set("gender", "男性");
  set("age", 45);

  set("combat_exp", 7500);
  set_skill("unarmed", 35);
  set_skill("force", 35);
  set_skill("dodge", 40);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 40);
  set("shen_type", -1);
  setup();
  carry_object("/d/city2/obj/diaopi")->wear();
  add_money("silver", 10);

}
int accept_object(object who, object ob) {
  if (ob->query("id") == "map"
    && ob->query("material") == "copper") {
    who->delete("vendetta");
    call_out("todest", 1, ob);
    command("say 这是将军急需之物，我立刻禀明将军，过去的事就过去吧!\n");
    return 1;
  }
  command("say 无用之物，你要来做甚？某家要了！\n");
  return 1;
}

void todest(object ob) {
  destruct(ob);
}
