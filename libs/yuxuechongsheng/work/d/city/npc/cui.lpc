// cui.c 崔员外
inherit NPC;
inherit F_DEALER;
void create()
{
	set_name("崔员外", ({ "cui yuanwai", "cui" }));
	set("gender", "男性");
	set("age", 55);
	set("max_qi",500);
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_skill("parry", 50);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);
	set_temp("apply/damage", 10);
       set("area_name","扬州城西大街");
	set("combat_exp", 25000);
	set("shen_type", -1);
	setup();
	add_money("gold", 3);
	carry_object(__DIR__"obj/yaoshi");
	carry_object("/clone/misc/long_cloth")->wear();
}
	
void init() 
{
        object area;
        area=new("/clone/misc/area");
        area->create(query("area_name"));
        set("banghui",(string)area->query("banghui"));
        destruct(area);   
        ::init();
} 
