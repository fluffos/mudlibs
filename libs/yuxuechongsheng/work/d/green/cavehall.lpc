#pragma save_binary
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "石室大厅");
  set("long",
    "这就是传说中的绝尘子的修行之所，北面是一座佛像，佛像顶部\n"
    "有一颗夜明珠发出莹莹的光芒。室内设施古朴，但却一尘不染。\n"
  );
  set("exits", ([
    "south": __DIR__ "outdoor",
  ]));
  set("objects", ([
    //           CLASS_D("juechen")+"/master" : 1,
    __DIR__ "obj/pearl": 1,
  ]));

  set("valid_startroom", 1);
  setup();
}

void init() {
  object me, pearl, mypearl, master;
  me = this_player();
  pearl = present("pearl", this_object());
  mypearl = present("pearl", me);
  master = present("master outer", this_object());

  if (master && mypearl && !pearl && (string)me->query("family/family_name") != "茅山派") {
    tell_object(me, HIR "绝尘子对你喝道：“还我夜明珠来！！”\n" NOR);
    master->kill_ob(me);
    tell_object(me, HIR "看来绝尘子急红了眼，快逃！\n" NOR);
  }
}

int valid_leave(object me, string dir) {
  object pearl, mypearl, master;

  me = this_player();
  pearl = present("pearl", this_object());
  mypearl = present("pearl", me);
  master = present("master outer", this_object());

  if (dir == "south" && mypearl && !pearl && master && (string)me->query("family/family_name") != "茅山派") {
    tell_object(me, HIR "绝尘子对你喝道：“还我夜明珠来！！”\n" NOR);
    master->kill_ob(me);
    return notify_fail(HIR "看来绝尘子急红了眼，快逃！\n" NOR);
  } else return 1;
}
