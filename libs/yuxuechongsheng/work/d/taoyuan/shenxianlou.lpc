inherit ROOM;
inherit F_DEALER;
#include <ansi.h>

void create() {
  set("short", "百人道场大厅");
  set("long", "这里是桃源百人道场的大厅。一进大厅，大厅正中那副字画即刻印入
眼帘。只见上面龙飞凤舞的写着「" HIC "百人道场" NOR "」四个大字，字字刚劲有力，
显然是出于名家的手笔。大厅正中有位白发苍苍的长者，道貌岸然之势，
显出一股迫人的气势。据说百人道场内高手云集，只要能够挑战闯过道场
的一百名弟子，即可获得一些未曾所见的神兵利器或失传已久的武功秘籍
。各路武林高手慕名而来，成功闯过的却是寥寥无几。大厅右边的门口贴
着一张告示(sign)，上面好象写着什么。\n"
  );
  set("exits", ([
    "east": __DIR__ "nanjie6",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
