#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "桃源南街");
	set("long", "这里是桃源城的南大街，你踩着坚实的青石板地面。大街两边宽阔非
常，大街东边有一家赌场，客人络绎不绝，出入于赌场的多数是桃源城中
的一些达官贵人和一些赌鬼。大家西边有一所"HIY"富豪大院"NOR"，门庭宽阔非常，
显然住的是一户大户人家。\n"
);
        set("outdoors", "taoyuan");
	set("no_clean_up", 0);
	set("exits", ([
		"east"  : __DIR__"lichunyuan",
		"south" : __DIR__"nanjie2",
		"west"  : __DIR__"fuhao",
		"north" : __DIR__"nanjie",
	]));
	
        setup();
	replace_program(ROOM);
}

