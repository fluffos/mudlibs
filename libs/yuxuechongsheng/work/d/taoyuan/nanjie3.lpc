#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "桃源南街");
	set("long", "你走在桃源南大街上，踩着坚实的青石板地面。东边是桃源城里的济
世堂，是一个救济穷人的地方。西边是一家布庄，主要是出售一些防具和
衣服，吸引了不少武林侠客前来。\n"
);
        set("outdoors", "taoyuan");
	set("no_clean_up", 0);
	set("exits", ([
		"south" : __DIR__"nanjie4",
		"north" : __DIR__"nanjie2",
                "west" : __DIR__"huadian",
                "east" : __DIR__"guancai1",
	]));
	
        setup();
	replace_program(ROOM);
}

