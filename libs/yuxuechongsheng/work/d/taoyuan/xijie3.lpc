#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "桃源西街");
	set("long", "这里是桃源城的西大街，你走在大街之上，脚踩着坚实的青石板地面
。大街北面有一所考场，每年科举，许多参加科举考试的考生们都会来到
这里参考应试。大街南面则是一家兵器铺，出售一些名贵的兵器。在往西
走就是桃源城的不夜舫了。\n"
);
        set("outdoors", "taoyuan");
	set("no_clean_up", 0);
	set("exits", ([
		"east"  : __DIR__"xijie2",
                "north"  : __DIR__"zhongxue",
		"west"  : __DIR__"xijie4",
                "south"  : __DIR__"bingqipu",
		]));

	setup();
	replace_program(ROOM);
}

