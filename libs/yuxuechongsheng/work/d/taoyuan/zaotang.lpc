#include <ansi.h>

void create()
{
	set("short", "华清池");
	set("long", @LONG
这里是桃源城里，最多达官贵人们出入的澡堂--华清池。华清池门口
装饰豪华，大门上方还挂着一块金字招牌。说起这间澡堂，在桃源城里开
办已经有数十年之久，澡堂内装饰别致，服务周到，来到了这里，也许应
该进去看看吧！门口竖着一块牌子(sign)，上面好象写着什么。
LONG );

	set("exits", ([
