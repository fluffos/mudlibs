#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "不夜舫厨房");
        set("long", "这里是供应不夜舫一切食物的厨房。一个足有半人高的灶头铸在厨房
的右边角落里，两个伙头正忙着为客人们做菜。厨房中间有一张大木桌，
上面放着一些已经做好的食物，等小伙计给客人们送去。东边有一扇门，
通往杂货房。\n"
);
	set("exits", ([
                "west"   : __DIR__"shangchuan7",
                "east"   : __DIR__"shangchuan4",
	]));
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}

