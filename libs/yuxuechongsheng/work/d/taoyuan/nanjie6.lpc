// nanjie.c 桃源南街
// 2001/12/06 by 若雨(ruoyu) email:ruoyu_st@163.com

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "桃源南街");
  set("long", "你走在桃源城的南大街，大街宽敞非常，两旁店面林立，出售的多数
是一些日用品和当地的有名小食。站在这里，你可以看见南面有一扇红漆
大门，大门上方挂着一块大牌匾，上面写着“" CYN "竞技场" NOR "”三个大字。门口两
边各有一头石狮，显得十分庄严威武。\n"
  );
  set("outdoors", "taoyuan");
  set("no_clean_up", 0);
  set("item_desc", ([
    "door": "这是一扇用上好红木做的木门(door)。\n",
  ]));
  set("exits", ([
    "south": __DIR__ "wudao4",
    "east": __DIR__ "join",
    "west": __DIR__ "shenxianlou",
    "north": __DIR__ "nanjie5",
  ]));

  create_door("south", "红木门", "north", DOOR_CLOSED);
  setup();
}
