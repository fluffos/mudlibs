//ROOM damen.c

inherit ROOM;

void create()
{
	set("short", "陈氏山庄大门");
        set("long",@LONG
这就是通向『陈氏山庄』走廊的大门。大门左右各有一头石雕的猛鹫
，高达三丈有余，尖喙巨爪，神骏非凡，栩栩如生，似乎随时要腾空而去。
LONG );
        set("outdoors", "taoyuan");
        set("exits", ([
		"north" : __DIR__"dongjie2",
		"south" : __DIR__"shanzhuang",
        ]));
	set("objects",([
		__DIR__"npc/dizi2" : 5,
		__DIR__"npc/chenqi" : 1,
	]));
//        set("no_clean_up", 0);
	setup();
}

int valid_leave(object me, string dir)
{
	if (  (dir == "south")
           && ((string)me->query("family/family_name") != "陈氏山庄")
	   && ( objectp(present("chenshi dizi", environment(me)))
	   ||   
objectp(present("chen qi", environment(me))) ) )
        return notify_fail
		("陈氏山庄弟子伸手拦住你，说道：“非陈氏山庄弟子请回！”\n");
	return ::valid_leave(me, dir);
}
