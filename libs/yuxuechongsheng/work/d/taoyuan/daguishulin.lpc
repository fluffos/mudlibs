#include <room.h>
inherit ROOM;

void create() {
  set("short", "大愧树林");
  set("long", @LONG
这里是桃源城里最美而最宁静的大槐树园。槐树园里，种满了许多槐
树，园子中间一棵，可算是最粗壮的了。这棵大槐树已经有上千年的年龄
，树干上留下的皱纹和从树枝上垂下的须根就是以往岁月的见证。从董郎
和许仙时起，不知它见证了多少有情人结为良缘。绿油油的草地上，沾着
星点的露珠，显然是一个放牧(fangmu)的好地方。再往西面走是桃源城里
喜结良缘的好地方：红娘庄。
LONG);

  set("exits", ([
    "east": __DIR__ "beijie5",
    "west": __DIR__ "xiaoshulin",
  ]));
  set("objects", ([
    __DIR__ "npc/wuya": 2,
    __DIR__ "npc/bird": 2,
    __DIR__ "npc/maque": 2,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "taoyuan");
  setup();
  replace_program(ROOM);
}
