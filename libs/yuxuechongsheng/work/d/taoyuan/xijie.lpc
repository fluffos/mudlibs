#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "桃源西街");
	set("long", "这里是桃源城的西大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆，许多人都往东边走去，那里有一个热闹的广场。南边
是一家钱庄，可以听到叮叮当当的金银声音。北边是一间茶楼，说唱评书
的应有尽有，吸引了不少游客和武林侠士前来，是一个打听江湖消息的好
地方。\n"
);
        set("outdoors", "taoyuan");
	set("no_clean_up", 0);
	set("exits", ([
		"east"  : __DIR__"cheng",
		"south" : __DIR__"qianzhuang",
		"west"  : __DIR__"xijie1",
		"north" : __DIR__"yingxiong",
	]));
        set("objects", ([
                __DIR__"npc/xuenv": 1,
	]));

	setup();
	replace_program(ROOM);
}

