// huyuan.c
inherit NPC;

void create() {
  set_name("长工", ({ "chang gong" }));

  set("gender", "男性");
  set("attitude", "friendly");

  set("age", 30);
  set("shen_type", 1);
  set("str", 17);
  set("int", 24);
  set("con", 20);
  set("dex", 22);
  set("max_qi", 350);
  set("max_jing", 200);
  set("neili", 350);
  set("max_neili", 350);
  set("combat_exp", 10000);

  setup();

  carry_object("/d/city/npc/obj/cloth")->wear();
}
