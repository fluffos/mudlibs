// chushi.c
inherit NPC;
#include <ansi.h>

string ask_me();

void create()
{
        set_name("老汉", ({ "lao han", "lao", "han"}));
        set("long",
                "富豪大院的一名厨师，笑眯眯地看着你，看来很和善的样子。\n");
        set("gender", "男性");
        set("nickname", HIC"厨房杂工"NOR);
        set("age", 54);
        set("attitude", "peaceful");
        set("inquiry", ([
                "吃饭" : (: ask_me :),
        ]));
        set("shen_type", 1);
        set("str", 26);
        set("int", 30);
        set("con", 26);
        set("dex", 28);

        set("max_qi", 200);
        set("max_jing", 50);
        set("combat_exp", 500);
        set_skill("force", 50);
        set_skill("dodge", 50);
        set_skill("cuff", 50);
        set_skill("parry", 50);

        setup();
}

string ask_me()
{       mapping fam, skl;
        object ob;
        string *sname;
        int i;
       object me=this_player();
       me->set("food", (int)me->max_food_capacity());
       me->set("water", (int)me->max_water_capacity());

        return "慢慢吃！别噎住了。";
}
