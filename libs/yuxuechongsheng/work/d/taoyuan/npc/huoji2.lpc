// huoji. 药铺伙计

#include <ansi.h>
inherit NPC;
inherit F_DEALER;

void create() {
  set_name("伙计", ({ "huo ji", "huo" }));
  set("gender", "男性");
  set("nickname", HIY "药铺伙计" NOR);
  set("age", 18);
  set("str", 20);
  set("long", "他十分强壮，看上去会几分武功，对药铺生意似乎并不在乎。\n");
  set("combat_exp", 15000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    "/d/taoyuan/obj/renshen",
  }));
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);

  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 5);
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
