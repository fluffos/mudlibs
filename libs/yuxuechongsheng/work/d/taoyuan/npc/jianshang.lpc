#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;

void create()
{
        string *surname=({"古聚集","古胡匪","古天乐","古上非","古云南","古欧德","古烂月"});
	set_name(surname[random(sizeof(surname))], ({ "jian shang"}) );
        set("gender", "男性");
        set("age", 33);
        set("per", 20);
        set("attitude", "peaceful");
        set("shen_type", -1);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);

        set("max_qi", 100);
        set("max_jing", 100);
        set("max_neili", 100);
        set("neili", 100);
        set("combat_exp", 1000);
        setup();
        carry_object("/clone/misc/cloth")->wear();
        add_money("gold", 1);
}