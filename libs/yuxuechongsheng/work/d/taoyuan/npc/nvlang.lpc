// mother.c
#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

void create() {
  set_name("陪酒女郎", ({ "peijiu nvlang", "peijiu" }));
  set("gender", "女性");
  set("age", 23);
  set("per", 20);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("max_qi", 100);
  set("max_jing", 100);
  set("max_neili", 100);
  set("neili", 100);
  set("combat_exp", 1000);
  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 20);
}
