#include <ansi.h>
inherit NPC;
inherit F_DEALER;
#define SET_SKILL	   60

void create() {
  int n;
  set_name("小贩", ({ "xiao fan" }));
  set("attitude", "friendly");
  set("gender", "男性");
  set("nickname", HIC "桃源小贩" NOR);
  set("age", 21);
  set("str", 20);
  set("cps", 20);
  set("cor", 20);
  set("per", 20);
  set("con", 20);
  set("vendor_goods", ({
    "/d/city/obj/jitui",
    "/d/city/obj/jiudai",
    "/d/city/obj/baozi",
    "/d/city2/obj/mian",
  }));

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("env/wimpy", 30);
  n = SET_SKILL + random(10) - 5; set_skill("unarmed", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("parry", (n <= 0) ? 1 : n);
  n = SET_SKILL + random(10) - 5; set_skill("dodge", (n <= 0) ? 1 : n);

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

void init() {
  add_action("do_buy", "buy");
  add_action("do_list", "list");
}
