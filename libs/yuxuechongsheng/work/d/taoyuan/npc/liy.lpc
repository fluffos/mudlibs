// liyan.c
inherit NPC;
#include <ansi.h>;
inherit F_UNIQUE;

void create() {
  set_name("李彦", ({ "li yan", "li", "yan" }));
  set("title", HIY "美女军团" NOR);
  set("gender", "女性");
  set("age", 25);
  set("per", 40);
  set("attitude", "peaceful");
  set("shen_type", 999999);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("max_qi", 1000);
  set("max_jing", 1000);
  set("max_neili", 1000);
  set("neili", 1000);
  set("jiali", 20);
  set("combat_exp", 800000);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: command("unwield changjian") :),
    (: perform_action, "hand.duo" :),
    (: command("wield changjian") :),
    (: exert_function, "recover" :),
    (: exert_function, "recover" :),
    (: exert_function, "recover" :),
    (: exert_function, "recover" :),
    (: exert_function, "powerup" :),
    (: exert_function, "powerup" :),
    (: perform_action, "sword.feixian" :),
    (: perform_action, "sword.shenjian" :),
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.sui" :),
    (: perform_action, "sword.san" :),
    (: perform_action, "dodge.lingbo" :),
    (: perform_action, "sword.feixian" :),
    (: perform_action, "sword.shenjian" :),
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.sui" :),
    (: perform_action, "sword.san" :),
    (: perform_action, "dodge.lingbo" :),
    (: perform_action, "sword.feixian" :),
    (: perform_action, "sword.shenjian" :),
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.sui" :),
    (: perform_action, "sword.san" :),
    (: perform_action, "dodge.lingbo" :),
  }));

  set_skill("dodge", 200);
  set_skill("hand", 200);
  set_skill("zhemei-shou", 200);
  set_skill("unarmed", 200);
  set_skill("sword", 200);
  set_skill("tianyu-qijian", 200);
  set_skill("lingboweibu", 200);
  map_skill("hand", "zhemei-shou");
  map_skill("dodge", "lingboweibu");
  map_skill("parry", "tianyu-qijian");
  map_skill("sword", "tianyu-qijian");
  map_skill("unarmed", "zhemei-shou");

  set_temp("is_riding", HIW "玉花马" NOR);
  set("chat_chance", 30);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("inquiry", ([
    "陈磊": "陈公子远在桃源，不知他近来可好？秋冷春寒，可有寒衣？\n",
  ]));

  setup();
  carry_object("/d/city/obj/jiudai");
  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
  add_money("gold", 1);
}
