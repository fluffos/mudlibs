// meng.c 孟老板
#include <ansi.h> 

inherit NPC;
//inherit F_VENDOR;
inherit F_DEALER;

void create()
{
	set_name("孟龙", ({ "meng long", "mong" }));
	set("nickname", HIB"珠宝铺老板"NOR);
	set("shen_type", 1);

	set("gender", "男性");
	set("age", 35);
	set("long",
		"孟老板是土生土长的桃源人，做了几十年的小买卖。\n");
	set_skill("unarmed", 500);
	set_skill("dodge", 500);
	set_temp("apply/damage", 150);

	set("combat_exp", 40000000);
	set("attitude", "friendly");
	set("vendor_goods", ({
		        	"/d/taoyuan/obj/shouzhuo",
 	"/d/taoyuan/obj/yupei",
 	}));
	
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
