// wan.c 万老板 

inherit NPC;
#include <ansi.h>
//inherit F_VENDOR;
inherit F_DEALER;

void create() {
  set_name("唐灵", ({ "tang ling", "tang" }));
  set("title", HIY "桃源书铺老板" NOR);
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 57);
  set("long",
    "唐灵是土生土长的桃源人，做了几十年的小买卖。\n");
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_temp("apply/damage", 150);

  set("combat_exp", 40000000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    "/d/taoyuan/book/lbook1",
    "/d/taoyuan/book/lbook2",
    "/d/taoyuan/book/lbook3",
    "/d/taoyuan/book/lbook4",
    "/d/taoyuan/book/sword_book",
    "/d/taoyuan/book/sword_book2",
    "/d/taoyuan/book/sword_book3",
    "/d/taoyuan/book/strike_book",
    "/d/taoyuan/book/strike_book2",
    "/d/taoyuan/book/strike_book3",
    "/d/taoyuan/book/hand_book",
    "/d/taoyuan/book/hand_book2",
    "/d/taoyuan/book/hand_book3",
    "/d/taoyuan/book/dodge_book",
    "/d/taoyuan/book/dodge_book2",
    "/d/taoyuan/book/dodge_book3",
    "/d/taoyuan/book/force_book",
    "/d/taoyuan/book/force_book2",
    "/d/taoyuan/book/force_book3",
    "/d/taoyuan/book/blade_book",
    "/d/taoyuan/book/blade_book2",
    "/d/taoyuan/book/blade_book3",
    "/d/taoyuan/book/parry_book",
    "/d/taoyuan/book/parry_book2",
    "/d/taoyuan/book/parry_book3",
    "/d/taoyuan/book/cuff_book",
    "/d/taoyuan/book/cuff_book2",
    "/d/taoyuan/book/cuff_book3",
    "/d/taoyuan/book/unarmed_book",
    "/d/taoyuan/book/unarmed_book2",
    "/d/taoyuan/book/unarmed_book3",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
