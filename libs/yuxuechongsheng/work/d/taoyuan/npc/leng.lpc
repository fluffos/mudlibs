// leng.c 冷老板
#include <ansi.h>

inherit NPC;
//inherit F_VENDOR;
inherit F_DEALER;

void create() {
  set_name("冷心", ({ "leng xin", "leng" }));
  set("nickname", HIC "兵器铺老板" NOR);
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 35);
  set("long",
    "冷老板是土生土长的桃源人，做了几十年的小买卖。\n");
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_temp("apply/damage", 150);

  set("combat_exp", 40000000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "obj/changqiang",
    __DIR__ "obj/changjian",
    __DIR__ "obj/longquan",
    __DIR__ "obj/gangjian",
    __DIR__ "obj/gangdao",
    __DIR__ "obj/tudao",
    __DIR__ "obj/dadao",
    __DIR__ "obj/fuchen",
    __DIR__ "obj/changbian",
    __DIR__ "obj/gangzhang",
    __DIR__ "obj/chaidao",
    __DIR__ "obj/dagger",
    __DIR__ "obj/hammer",
    __DIR__ "obj/fork",
    __DIR__ "obj/fenshuici",
    __DIR__ "obj/chanzhang",
    __DIR__ "obj/jiandao",
    __DIR__ "obj/axe",
    __DIR__ "obj/shortblade",
    __DIR__ "obj/mudao",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
