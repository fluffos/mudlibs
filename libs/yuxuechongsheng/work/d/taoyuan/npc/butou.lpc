// bing.c 捕头
#include <ansi.h>

inherit NPC;

void create()
{
	set_name("捕头", ({ "xun bu" }));
	set("age", 32);
	set("gender", "男性");
	set("long", "捕头个个身手矫健，强盗、山贼无不闻风丧胆。\n");
	set("nickname", HIB"桃源捕头"NOR);
	set("attitude", "peaceful");
	set("str", 24);
	set("dex", 16);
	set("combat_exp", 1000000);
	set("shen_type", 1);

	set_skill("unarmed", 800);
	set_skill("dodge", 800);
	set_skill("parry", 800);
	set_skill("blade", 800);
	set_skill("force", 800);
	set_temp("apply/attack", 80);
	set_temp("apply/defense", 80);
	set_temp("apply/damage", 80);
	set_temp("apply/armor", 80);

	set("chat_chance_combat", 10);
	set("chat_msg_combat", ({
		"捕头喝道：大胆刁民，竟敢造反不成？\n",
		"捕头喝道：跑得了和尚跑不了庙，你还是快快束手就擒！\n",
	}));
	setup();
	carry_object("/d/city/obj/gangdao")->wield();
	carry_object("/clone/misc/cloth")->wear();
        add_money("gold", 10);
}

void init()
{
	object ob;
	::init();
	if (interactive(ob = this_player()) && 
		(int)ob->query_condition("killer")) {
		remove_call_out("kill_ob");
		call_out("kill_ob", 1, ob);
	}
}
