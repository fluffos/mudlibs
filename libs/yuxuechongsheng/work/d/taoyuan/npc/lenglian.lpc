// lenglian.c 冷老板
#include <ansi.h> 

inherit NPC;
//inherit F_VENDOR;
inherit F_DEALER;

void create()
{
	set_name("冷脸", ({ "leng lian", "leng" }));
	set("nickname", HIB"花店老板"NOR);
	set("shen_type", 1);

	set("gender", "女性");
	set("age", 25);
	set("long",
		"冷老板是土生土长的桃源人，做了十几年的小买卖。\n");
	set_skill("unarmed", 500);
	set_skill("dodge", 500);
	set_temp("apply/damage", 150);
	set("combat_exp", 40000000);
	set("attitude", "friendly");
	set("vendor_goods", ({
		        __DIR__"obj/shanchahua",
		        __DIR__"obj/chahua1",
		        __DIR__"obj/chahua2",
		        __DIR__"obj/chahua3",
		        __DIR__"obj/chahua4",
		        __DIR__"obj/chahua5",
		        __DIR__"obj/chahua6",
		        __DIR__"obj/chahua7",
		        __DIR__"obj/chahua8",
		        __DIR__"obj/chahua9",
		        __DIR__"obj/chahua10",
		        __DIR__"obj/chahua11",
		        __DIR__"obj/chahua12",
		        __DIR__"obj/chahua13",
		        __DIR__"obj/mudan",
		        __DIR__"obj/flower0",
		        __DIR__"obj/flower1",
		        __DIR__"obj/flower2",
		        __DIR__"obj/flower3",
		        __DIR__"obj/flower4",
		        __DIR__"obj/flower5",
		        __DIR__"obj/flower6",
		       }));
	
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
