// fengtiannan.c
#include <ansi.h>

inherit NPC;

void create()
{
	set_name("风天南", ({ "feng tiannan", "feng" }));
	set("gender", "男性");
	set("nickname", HIW"戏院老板"NOR);
   	set("age", 45);
	set("long", "他是一个很色得人大家小心。\n");
	set("combat_exp", 10000);
        set_skill("dodge", 50);
        set_skill("unarmed", 50);
        set_temp("apply/attack",  50);
        set_temp("apply/defense", 50);
	set("shen_type", -1);
	setup();

	add_money("silver",10);
	carry_object("/clone/misc/cloth")->wear();
}

