// xiaolongquan.c
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
        set_name(HIC"小龙泉"NOR, ({ "xiao longquan", "longquan" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "些");
                set("value", 200);
                set("base_unit", "丙");
                set("base_weight", 300);
                set("base_value", 0);
                set("material", "iron");
                set("long", HIW"小龙泉是一种以量取胜的暗器，沉颠颠的。\n"NOR);
                set("wield_msg", HIC"$N迅速地从暗器袋中掏出一些小龙泉，捏在手中就待发出！\n"NOR);
                set("unwield_msg",HIC"$N将手里剩下的小龙泉尽数放回暗器袋中。\n"NOR);
        }
        set_amount(100);
        init_throwing(100);
        setup();
}
