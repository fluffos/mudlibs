// fashi.c


#include <ansi.h>
inherit NPC;

void create()
{
	set_name("法师",({ "chaodu fashi" }) );
        set("gender", "男性" );
        set("age", 46);
        set("long", 
"这是个四六、七代的法师。\n");
        set_temp("apply/defense", 5);
	set("combat_exp", 70000);
//        set("shen", 100);
	set("shen_type", 1);
        set("str", 14);
        set("per", 28);

        set("title", HIY"超度大法师"NOR);
        set("dex", 15);
        set("con", 16);
        set("int", 15);
        set("attitude", "friendly");
        setup();
        carry_object("/clone/cloth/cloth")->wear();
}

