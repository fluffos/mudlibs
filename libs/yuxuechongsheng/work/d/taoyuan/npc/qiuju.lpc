inherit NPC;
//inherit F_CLEAN_UP;

void create()
{
        set_name("秋菊", ({
                "qiu ju",
                "qiu",
        }));

        set("gender", "女性");
        set("attitude", "friendly");

        set("age", 30);
        set("shen_type", 1);
        set("str", 17);
        set("int", 24);
        set("con", 20);
        set("dex", 22);
        set("max_qi", 3350);
        set("max_jing", 200);
        set("neili", 150);
        set("max_neili", 150);
        set("combat_exp", 300000);
        set("score", 100);

        set_skill("force", 20);
        set_skill("dodge", 20);
        set_skill("sword", 20);
        set_skill("parry", 20);

        setup();

        carry_object("/d/city/npc/obj/cloth")->wear();
}

