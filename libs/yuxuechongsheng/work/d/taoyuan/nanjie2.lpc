#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "桃源南街");
	set("long", "你走在桃源城的南大街上，踩着坚实的青石板地面。这里没有城中心
那般热闹，人群也稀疏了许多，只有偶尔几个游客或居民经过。西边是一
家花店，阵阵鲜花的清香扑鼻而来，令人陶醉。东面是一家竹器店，出售
一些竹制的用品。\n"
);
        set("outdoors", "taoyuan");
	set("no_clean_up", 0);
	set("exits", ([
		"south" : __DIR__"nanjie3",
		"north" : __DIR__"nanjie1",
                "east" : __DIR__"zhuqipu",
                "west" : __DIR__"buzhuang",
	]));
	
        setup();
	replace_program(ROOM);
}

