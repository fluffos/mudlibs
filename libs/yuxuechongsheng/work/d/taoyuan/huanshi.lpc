//ROOM: /d/yanziwu/huanshi.c

inherit ROOM;

void create()
{
        set("short", "山庄密洞");
        set("long",@LONG
阁中满是书架，架上摆着许多颇古旧的书籍，架上均贴有标签(sign)。
这就是慕容世家历经数代才收集积累而成的武学宝库。
LONG );
        set("exits", ([
            "north": __DIR__"liangshiku",
        ]));
        set("objects", ([
            "/clone/book/book-bamboo": 1,
            "/clone/book/book-iron": 1,
            "/clone/book/book-paper": 1,
            "/clone/book/book-silk": 1,
            "/clone/book/book-stone": 1,
            "/clone/book/bojuan": 1,
            "/clone/book/lingbo_book": 1,
            "/clone/book/qiankun_book": 1,
            "/clone/book/liuyang_book1": 1,
            "/clone/book/liuyang_book2": 1,
            "/clone/book/zhemei_book1": 1,
            "/clone/book/zhemei_book2": 1,
            "/clone/book/qijianpu": 1,            
        ]));
        set("item_desc",([
            "sign" :
            "由于陈氏山庄少庄主不在，大部分密籍都备封存了。\n"
        ]));
        set("no_clean_up", 0);
        setup();
}
