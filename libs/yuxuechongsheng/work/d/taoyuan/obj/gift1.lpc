#include <ansi.h>
inherit ITEM;
int do_open(string arg);

void create()
{
       set_name(HIR "礼物" NOR,({"liwu"}));
       set("long","\n这是一份礼物，你可以试着打开("+HIR+"open"+NOR+")来看看。\n");
       set("unit","份");
       set("value", 0);
       setup();
}

void init()
{
      if (!wizardp(this_player())) {
      set("no_get","这个东西拿不起来。\n");
      set("no_give","这么珍贵的东西，哪能随便给人？\n");
      set("no_drop","这么宝贵的东西，扔了多可惜呀！\n");
      set("no_sell","这东西不能卖。\n");
      set("no_pawn","这东西不能典当。\n");
      }
      if(this_player()==environment())
      add_action("do_open", "open");
}

int do_open(string arg)
{
        object me=this_player();
        if (!arg && arg!="liwu") return notify_fail("你要打开什么?\n");
        if (me->query("newbie_liwu")) return notify_fail("你已经拿过礼物了，怎么还想要？\n");
        message_vision(HIR"$N很小心的打开了礼包!\n" NOR,me);
  
        me->add("potential",1000000);
        me->add("combat_exp",1000000);
        me->add("max_neili",1000);
        me->add("max_jingli",1000);
        me->add("neili",1000);
        me->add("jingli",1000);

        this_player()->set_skill("force", 300);
        this_player()->set_skill("literate", 200);
        me->set("newbie_liwu",1);
        destruct(this_object());
        return 1;

}
