// lbook2.c
inherit ITEM;
void create()
{
        set_name("百家姓", ({ "literateb2" }));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);                                   
        else
        { 
               set("unit", "本");
                set("long","读书人必读的百家姓。\n");
                set("value", 5000);
                set("material", "paper");
                set("skill",([
                        "name": "literate",
                        "jing_cost":    20,
                        "difficulty":   15,
                        "max_skill":    100,
                        "min_skill":    50,
                ]) );
        }
}
