}
int valid_leave(object me, string dir) {
  if (dir == "up" && !wizardp(me))
    return notify_fail("裁判席只有被特邀才能进去。\n");
  me->set_temp("view_leitai", 1);
  return ::valid_leave(me, dir);
}

void fighting(object dest, object obj) {
  obj->fight_ob(dest);
  dest->fight_ob(obj);
}

void check(object obj, object dest) {
  string name1, name2;
  if (!obj->query("family/family_name") && dest->query("family/family_name")) {
    name1 = "无门派的" + obj->query("name");
    name2 = dest->query("family/family_name") + "的" + dest->query("name");
  } else if (!dest->query("family/family_name") && obj->query("family/family_name")) {
    name1 = obj->query("family/family_name") + "的" + obj->query("name");
    name2 = "无门派的" + dest->query("name");
  } else if (!dest->query("family/family_name") && !obj->query("family/family_name")) {
    name1 = "无门派的" + obj->query("name");
    name2 = "无门派的" + dest->query("name");
  } else {
    name1 = obj->query("family/family_name") + "的" + obj->query("name");
    name2 = dest->query("family/family_name") + "的" + dest->query("name");
  }
  shout(HIY "〖紫堇之颠〗" + name1 + "向" + name2 + "发起挑战！\n" NOR);
  write(HIY "〖紫堇之颠〗" + name1 + "向" + name2 + "发起挑战！\n" NOR);
  call_out("observe", 1, obj, dest);
}

int observe(object obj, object dest) {

  if (obj->is_fighting()) {
    call_out("observe", 1, obj, dest);
    return 1;
  }

  obj->delete_temp("pending/fight");
  dest->delete_temp("pending/fight");

  if (!present(obj, environment(this_player()))) {
    shout(HIY "〖紫堇之颠〗" + obj->query("name") + "落荒而逃了！\n" NOR);
    write(HIY "〖紫堇之颠〗" + obj->query("name") + "落荒而逃了！\n" NOR);
    return 1;
  }

  if (!present(dest, environment(this_player()))) {
    shout(HIY "〖紫堇之颠〗" + dest->query("name") + "落荒而逃了！\n" NOR);
    write(HIY "〖紫堇之颠〗" + dest->query("name") + "落荒而逃了！\n" NOR);
    return 1;
  }

  if (obj->query_temp("halted")) {
    obj->delete_temp("halted");
    shout(HIY "〖紫堇之颠〗" + obj->query("name") + "中途放弃比武！\n" NOR);
    write(HIY "〖紫堇之颠〗" + obj->query("name") + "中途放弃比武！\n" NOR);
    return 1;
  }
  if (dest->query_temp("halted")) {
    dest->delete_temp("halted");
    shout(HIY "〖紫堇之颠〗" + dest->query("name") + "中途放弃比武！\n");
    write(HIY "〖紫堇之颠〗" + dest->query("name") + "中途放弃比武！\n");
    return 1;
  }

  if (obj->query("qi") * 2 > obj->query("max_qi")) {
    if (dest->query("qi") * 2 > dest->query("max_qi")) {
      shout(HIY "〖紫堇之颠〗" + obj->query("name")
        + "与" + dest->query("name") + "比武不分胜负！\n" NOR);
      write(HIY "〖紫堇之颠〗" + obj->query("name")
        + "与" + dest->query("name") + "比武不分胜负！\n" NOR);
      return 1;
    }
    shout(HIY "〖紫堇之颠〗" + obj->query("name")
      + "比武战胜" + dest->query("name") + "！\n" NOR);
    write(HIY "〖紫堇之颠〗" + obj->query("name")
      + "比武战胜" + dest->query("name") + "！\n" NOR);
  } else {
    shout(HIY "〖紫堇之颠〗" + dest->query("name")
      + "比武战胜" + obj->query("name") + "！\n" NOR);
    write(HIY "〖紫堇之颠〗" + dest->query("name")
      + "比武战胜" + obj->query("name") + "！\n" NOR);
  }

  return 1;

}

int main(object me, string arg) {
  object obj, dest;
  string sb1, sb2;

  if (sscanf(arg, "%s %s", sb1, sb2) == 2)
    dest = (present(sb1, environment(me)));
  obj = (present(sb2, environment(me)));

  if (!living(obj) || !living(dest))
    return notify_fail("已经有人不能战斗了。\n");

  message_vision(NOR "$N对$n说道：" + RANK_D->query_self(obj) + obj->query("name") + "，领教"
    +RANK_D->query_respect(dest) + "的高招！\n" NOR, obj, dest);
  message_vision(NOR "$N一拱手，说道：" + RANK_D->query_self(dest) + "领教了。\n" NOR, dest);

  obj->delete_temp("halted");
  dest->delete_temp("halted");

  remove_call_out("check");
  call_out("check", 2, obj, dest);

  dest->set("qi", (int)dest->query("max_qi"));
  obj->set("qi", (int)obj->query("max_qi"));

  dest->set("eff_qi", (int)dest->query("max_qi"));
  obj->set("eff_qi", (int)obj->query("max_qi"));

  remove_call_out("fighting");
  call_out("fighting", 2, obj, dest);

  return 1;

}
