// nanjie.c 桃源南街
// 2001/12/06 by 若雨(ruoyu) email:ruoyu_st@163.com

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "桃源南街");
  set("long", "这里是桃源城的南大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆，许多人都往北边走去，那里有一个热闹的广场。东边
是一家店铺，墙上写着一个大大的“" HIY "当" NOR "”字，仔细倾听，可以听到压低的
讨价还价的声音。西边是一家钱庄，可以听到叮叮当当的金银声音。\n"
  );
  set("outdoors", "taoyuan");
  set("no_clean_up", 0);
  set("exits", ([
    "east": "/d/taoyuan/dangpu",
    "south": __DIR__ "nanjie1",
    "west": "/d/taoyuan/qianzhuang",
    "north": __DIR__ "cheng",
  ]));
  set("objects", ([
    __DIR__ "npc/qidan": 1,
    __DIR__ "npc/huoyan": 1,
    __DIR__ "npc/zhaoshuang": 1,
    __DIR__ "npc/zhangjing": 1,
  ]));

  setup();
  replace_program(ROOM);
}
