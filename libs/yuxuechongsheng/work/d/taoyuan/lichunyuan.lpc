#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "顺天赌场");
	set("long", "这里是桃院城的顺天赌场。这是方圆千里之内最大的一家赌场。赌场
大门上写着“"HIR"英雄会赌"NOR"”四个大字，大厅里的几张赌桌围着黑压压的赌徒
。各个房间里传出的阵阵吆喝声、惊叹声、欢呼声、咒骂声、哄笑声和噼
哩啪啦的声响，汇成一片，搅在一起。有匾(sign)一块。\n"
);
	set("item_desc", ([
		"sign": "        "BRED+HIY"※ 顺天赌场 ※\n"NOR,
	]));
	set("exits", ([
		"west"  : __DIR__"nanjie1",
	]));

	setup();
	replace_program(ROOM);
}

