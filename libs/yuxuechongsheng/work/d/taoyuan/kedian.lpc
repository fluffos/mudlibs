inherit ROOM;
inherit F_DEALER;

void create()
{
        set("short", "桃源客店");
        set("long", @LONG
这里是桃源之城的桃源客栈。方圆五百里内，唯它最负盛名。这里的
生意非常兴隆，来自各地的客人都喜欢在这里住宿。店小二里里外外忙得
团团转，接待着南腔北调的客人。
LONG );
        set("no_sleep_room",1);
        set("valid_startroom", 1);
        set("item_desc", ([
                "paizi" : "楼上雅房，每夜十两白银。\n",
        ]));
        set("objects", ([
                __DIR__"npc/xiaoer" : 1,
     //           __DIR__"npc/new" : 1,
        ]));
        set("exits", ([
                "west" : __DIR__"beijie2",
                "south" : __DIR__"dongjie",
                "up"   : __DIR__"kedian2",
        ]));

        setup();
        replace_program(ROOM);
        "/clone/board/kedian_b"->foo();
}
