// du.c 飞天毒镖
// By Yzuo 97.04
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
      object obj;
    string msg;
    if( !target ) target = offensive_target(me);
    if( !target || !target->is_character() )
        return notify_fail("飞天毒镖只能对对手使用。\n");
    if( (int)me->query_skill("fengxiao-xinfa", 1) < 40 )
        return notify_fail("你的风啸心法不够娴熟，不能使用惊天毒剑。\n");
    if( (int)me->query_skill("fengxiao-biao", 1) < 40 )
        return notify_fail("你的飞天毒镖不够娴熟，不能使用惊天毒剑。\n");
    msg = HIG "$N将毒质运于镖上，一招[飞天毒镖]，射向$n。\n";
    me->start_busy(1);
    if( random( (int)me->query_skill("fengxiao-jianfa",1))
          > random(target->query_skill("dodge") ) ) {
        msg += HIW " 结果$p被$P攻了个正着！\n" NOR;
            target->receive_damage("qi",(int)me->query_skill("fengxiao-biao",1),me);
            target->receive_wound("qi",15 + random(10),me);
            target->receive_wound("jing", 10,me);
            target->apply_condition("xx_poison", random(me->query_skill("fengxiao-biao",1)/10) + 1 +
            target->query_condition("xx_poison"));
            target->start_busy(1 + random(2));
    } else {
        msg += "可是$p急忙闪在一旁，不过也吓了一跳。\n" NOR;
        me->start_busy(4);
    }
    message_vision(msg, me, target);
    if( !target->is_killing(me) ) target->kill_ob(me);
      destruct(obj);
    return 1;
}
