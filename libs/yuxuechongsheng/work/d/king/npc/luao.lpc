// lu ao.c 
inherit NPC;
inherit F_MASTER;
void create()
{
    set_name("陆傲九十九", ({ "lu ao", "lu", "ao" }));
    set("gender", "男性");
    set("age", 19);
    set("nickname",HIW"无敌天下"NOR);
    set("long", "他就是闻名天下的风啸楼陆傲九十九，长的很英俊。\n");
    
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 60);
    set("int", 80);
    set("con", 80);
    set("dex", 230);
    
    set("qi", 5800);
    set("max_qi", 5800);
    set("jing", 5600);
    set("max_jing", 5600);
    set("neili", 20000);
    set("max_neili", 20000);
    set("jiali", 300);
    set("combat_exp", 1000000);
    
        set_skill("unarmed", 600);
        set_skill("dodge", 600);
        set_skill("force",600);
        set_skill("parry",600);
        set_skill("axe",600);
        set_skill("spear",600);
        set_skill("sword",600);
        set_skill("throwing",600);
        set_skill("fengxiao-biao",600);
        set_skill("fengxiao-xinfa",600);
        set_skill("fengxiao-qiangfa",600);
        set_skill("fengxiao-jianfa",600);
        set_skill("fengxiao-shenfa",600);
        set_skill("fengxiao-axe",600);
        set_skill("fengxiao-zhang",600);
        set_skill("literate",600);



        map_skill("unarmed","fengxiao-zhang");
        map_skill("force","fengxiao-xinfa");
        map_skill("dodge","fengxiao-shenfa");
        map_skill("parry","fengxiao-qiangfa");
        map_skill("throwing","fengxiao-biao");
        map_skill("axe","fengxiao-axe");
        map_skill("sword","fengxiao-jianfa");
        map_skill("spear","fengxiao-qiangfa");
 
        create_family("风啸楼", 2, "弟子");
        set("title","风啸楼总护法");
        set("accept",1);
        set("chat_chance", 10);
       
        set("inquiry", ([
        "钱" : "我没钱？\n",
        "风啸楼" : "gc,e,e,e,u。\n",
        "拜师" : "好吧！你就Bai我吧\n",
    ]));
    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
        (: perform_action, "sword.du" :),
        (: perform_action, "sword.leishen" :),
        (: perform_action, "sword.jianqi" :),
        (: exert_function, "qiqiang" :),
    }) );
setup();
     carry_object("/d/king/npc/obj/zhao.lpc")->wear();
    carry_object("/d/king/npc/obj/jian.lpc")->wield();
    add_money("coin",2);
}
void attempt_apprentice(object ob)
{
    if (mapp(ob->query("family"))  &&   (string)ob->query("family/family_name") != "风啸楼")
    {
        command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来拜大爷我呢？");
        return;
    }
    if (((int)ob->query_skill("sword",1) < 300) || ((int)ob->query_skill("fengxiao-jianfa",1) < 300))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的风啸剑法还没学到家吧。");
        return;
    }
    if (((int)ob->query_skill("force",1) < 300) || ((int)ob->query_skill("fengxiao-xinfa",1) < 300))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的风啸心法还没学到家吧。");
        return;
    }
    if (((int)ob->query_skill("dodge",1) < 300) || ((int)ob->query_skill("fengxiao-shenfa",1) < 300))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的风啸身法还没学到家吧。");
        return;
    }
    if ( (int)ob->query_skill("literate",1) < 300)
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的读书识字还没学到家吧。");
        return;
    }
    if ((int)ob->query("shen") < 10000)
    {
        command("say 我风啸楼乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    if ((int)ob->query_int() < 41) {
        command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我风啸楼绝学？");
        return;
    }
    command("chat* haha") ;
        command("chat 风啸楼又要出一个绝世高人！\n");
        command("haha");
        command("recruit "+ob->query("id"));
}

