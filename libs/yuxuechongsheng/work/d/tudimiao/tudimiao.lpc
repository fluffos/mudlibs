#include <ansi.h>
#define A_TIME 60
inherit ROOM;

string * add_msg = ({
        "/d/city/guangchang",
        "/d/baituo/yaofang",
        "/d/city/wumiao",
        "/d/huashan/zhenyue",
//        "/d/lingjiu/huayuan",
        "/d/quanzhou/bamboo",
        "/d/taishan/lianhua",
        "/d/shenlong/caoping",
        "/d/wudang/sanqingdian",
        "/d/xiaoyao/qingcaop",
        "/d/xueshan/cangjingge",
      "/d/mingjiao/dadian",
        "/d/baituo/chaifang",
        "/d/city/gbxiaowu",
//        "/d/wudang/chaotian",
        "/d/xiaoyao/pubu",
// "/d/lingjiu/dating",
//        "/d/xingsu/cangku",
      "/d/quanzhen/guanritai",
//        "/d/village/shack",
//        "/d/xueshan/dating",
//        "/d/wudu/dating",
//        "/d/wudu/zhizhutang",
//        "/d/gumu/mushi",
});

void create()
{       
set("short", "土地庙");
set("long", @LONG
这里是一间残破的土地庙，当中塑着土地公公的像，由于年久失修，像上
的颜色已经班驳脱离了。四周的土胚墙也摇摇晃晃，似乎一阵风过后就会倒塌
下来。看来已经很久没有人来过的痕迹，可是偏偏到处充斥着一种神秘的气息
好象会有什么不可预测的事情将会在这里发生一样。土地像前摆放着一张三条
腿的供桌(zhuo)，已经破旧不堪了。
LONG    );      
        set("no_fight",1);
        set("no_clean_up",1);
        set("exits", ([
             "south" : "/d/quanzhou/jiaxing",
        ]));

        set("count",1);
        set("item_desc", ([
                "zhuo" :  HIG"
这张供桌只剩下三条腿了，奇怪的是好象还立得很稳。仔细看一下，
似乎下面有什么垫着，也许可以推(tui)开来看一下。\n
"NOR
        ]));
        setup();
}

void init()
{
        add_action("do_tui","tui");
        remove_call_out("newjob");
        call_out("newjob",A_TIME);
}

int do_tui(string arg)
{
        object me = this_player();
        object ob,rz;
        string src_add,dest_add,des;
        object room,room2;

        src_add=add_msg[random(sizeof(add_msg))];
        dest_add=add_msg[random(sizeof(add_msg))];
        while (dest_add == src_add)
                dest_add=add_msg[random(sizeof(add_msg))];

        if (!arg || arg != "zhuo" )
                return 0;
        
                    if (me->query("combat_exp") < 500000){
tell_object(me,HIR"只听一阵恶狠狠的声音传来：你想死吗！不想死就先去练高功夫和经验再来！\n"NOR);
                                                      return 1;
                                                 }
        if (query("count") > 0) {
                if (!present("mi ling",me) ) {
                        if (! room = find_object(src_add) ) 
                                room = load_object(src_add);
                        rz = new("/d/tudimiao/npc/renzhi");
                        rz -> set("leader_name", me->query("id") );
                        rz -> set("title",me->query("name")+"所保护的");
                        rz -> set("dest_add",dest_add);
                        rz -> move(room);
                        if (! room2 = find_object(dest_add) )
                                room2 = load_object(dest_add);
                        des = "护送" + room->query("short") + "那里的" + rz->query("name") + "到达" + room2->query("short") ;
                        ob = new("/d/tudimiao/obj/miling");
                        ob -> set("describe",des);
                        ob -> set("src_add",room->query("short") );
                        ob -> set("dest_add",room2->query("short") );
                        ob -> set("src_des",room->query("outdoors") );
                        ob -> set("dest_des",room2->query("outdoors") );
                        ob -> move(me);
                        add("count",-1);
                        message_vision(HIY"$N小心翼翼地推开供桌，发现了一卷纸垫在下面，便顺手拣起来揣进怀中。\n"NOR,me);
                        tell_object(me,HIG"似乎有个声音在你耳边轻声说道：你这次的任务是"+des+"。\n"NOR);
                        return 1;
                }
                else {
                        tell_object(me,HIR"一个阴冷的声音在你耳边响起：你上次的任务还没完成呢。\n"NOR);
                        return 1;
                }
        }
        else {
                message_vision(YEL"$N试着推了推供桌，结果‘轰’的一下供桌倒了，$N碰了个灰头土脸。\n"NOR,me);
                return 1;
        }
}

void newjob()
{
        if (query("count") <= 0)
                add("count",1);
        remove_call_out("newjob");
        call_out("newjob",A_TIME);
}

