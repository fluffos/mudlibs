// Room: /d/gaibang/inhole.c
// Date: Haa 96/03/22
#include <ansi.h>
#define A_TIME 60
inherit ROOM;
int do_say(string arg);
string * add_msg = ({
        "/d/city/guangchang",
        "/d/baituo/yaofang",
        "/d/city/wumiao",
        "/d/huashan/zhenyue",
        "/d/quanzhou/bamboo",
        "/d/taishan/lianhua",
        "/d/shenlong/caoping",
        "/d/wudang/sanqingdian",
        "/d/xiaoyao/qingcaop",
        "/d/xueshan/cangjingge",
        "/d/mj/shanmen",
        "/d/baituo/chaifang",
        "/d/city/gbxiaowu",
        "/d/xiaoyao/pubu",
        "/d/quanzhen/guanritai",
});

void create()
{
        set("short", "树洞内部");
        set("long", @LONG
这是杨州城中央广场的老槐树内部，也是丐帮秘密的地下通道的总交
汇处。树洞里丢满了各种拉圾（laji)，里面好象有东西，弭漫着一股
臭哄哄的味道。树洞壁上钉着一块非常醒目的木牌（board）。
LONG 
        );
        set("exits", ([
                "out" : "d/city/guangchang"
        ]));

        set("item_desc",([
                "board" : "富人地狱，穷人天堂。\n"
        ]));

        set("objects",([
                "/d/city/obj/jitui" : 3,
                "/d/city/obj/jiudai" : 1,
                CLASS_D("gaibang") + "/zuo-qu" : 1,
                CLASS_D("gaibang") + "/qiu-wan" : 1,
        ]));
        set("count",5);
        set("item_desc", ([
                "laji" :  HIG"
一堆是什么都有的垃圾，还有小虫虫也，也许可以推(fan)开来看一下。\n
"NOR
        ]));
        setup();
}

void init()
{
        add_action("do_say", "say");
        add_action("do_fan","fan");
        if (query("count") <= 0 && !query("job_start") )
        {
         set("job_start",1);
         remove_call_out("newjob");
         call_out("newjob",A_TIME); 
        }
}

int do_say(string arg)
{

        if( !arg || arg=="" ) return 0;

        if( arg=="天堂有路你不走"
        ||  arg=="地狱无门你进来") 

        {
                write("只听里面有人说了声：是本帮兄弟吧？请进来吧。\n");
                message("vision", "树洞边上一堵墙缓缓移了开来，原来是道小木门。\n", this_player());
                  set("exits/down", "/d/gaibang/undertre");

                remove_call_out("close");
                call_out("close", 5, this_object());

                return 1;
        }
}

void close(object room)
{
        message("vision","只见小木门乒地关上了。\n", room);
        room->delete("exits/down");
}       

int do_fan(string arg)
{
        object me = this_player();
        object ob,rz;
        string src_add,dest_add,des;
        object room,room2;

        src_add=add_msg[random(sizeof(add_msg))];
        dest_add=add_msg[random(sizeof(add_msg))];
        while (dest_add == src_add)
                dest_add=add_msg[random(sizeof(add_msg))];

        if (!arg || arg != "laji" )
                return 0;
        
                    if (me->query("combat_exp") < 500000){
tell_object(me,HIR"只听一阵恶狠狠的声音传来：你想死吗！不想死就先去练高功夫和经验再来！\n"NOR);
                                                      return 1;
                                                 }
        if (query("count") > 0) {
                if (!present("mi ling",me) ) {
                        if (! room = find_object(src_add) ) 
                                room = load_object(src_add);
                        rz = new("/d/tudimiao/npc/renzhi");
                        rz -> set("leader_name", me->query("id") );
                        rz -> set("title",me->query("name")+"所保护的");
                        rz -> set("dest_add",dest_add);
                        rz -> move(room);
                        if (! room2 = find_object(dest_add) )
                                room2 = load_object(dest_add);
                        des = "护送" + room->query("short") + "那里的" + rz->query("name") + "到达" + room2->query("short") ;
                        ob = new("/d/tudimiao/obj/miling");
                        ob -> set("describe",des);
                        ob -> set("src_add",room->query("short") );
                        ob -> set("dest_add",room2->query("short") );
                        ob -> set("src_des",room->query("outdoors") );
                        ob -> set("dest_des",room2->query("outdoors") );
                        ob -> move(me);
                        add("count",-1);
                        message_vision(HIY"$N小心翼翼地翻开拉圾，发现了一卷纸垫在下面，便顺手拣起来揣进怀中。\n"NOR,me);
                        tell_object(me,HIG"似乎有个声音在你耳边轻声说道：你这次的任务是"+des+"。\n"NOR);
                        return 1;
                }
                else {
                        tell_object(me,HIR"一个阴冷的声音在你耳边响起：你上次的任务还没完成呢。\n"NOR);
                        return 1;
                }
        }
        else {
                message_vision(YEL"$N试着翻了翻拉圾，结果‘w..w..’爬出成千上万只虫虫，$N碰了个灰头土脸。\n"NOR,me);
                return 1;
        }
}

void newjob()
{
        set("count",5);
        delete("job_start");
        remove_call_out("newjob");

        return;
}

