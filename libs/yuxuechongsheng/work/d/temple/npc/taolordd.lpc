#pragma save_binary
// taolord.c

inherit NPC;
inherit F_MASTER;

string ask_me();
void create()
{
        set_name("林忌", ({ "lin ji","lin"}) );
        set("nickname", "六指真人");
        set("gender", "男性");
        set("age", 47);
        set("long",
				"林忌是一位道行十分高深的修道者，你发现他的眼珠一个是黑色的\n"
                "一个是金色的，这正是「谷衣心法」修炼到极高境界的徵兆。\n");

        set("combat_exp", 1000000);

        set("class", "taoist");

        set("str", 20);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

        set("force", 2000);
        set("max_force", 1000);
        set("force_factor", 30);

        set("atman", 1400);
        set("max_atman", 1400);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 5);
        set("inquiry", ([
                "谷衣心法": 
"谷衣心法是我茅山派为对抗邪魔外道所创的内功心法。\n",
           "有缘人": (: ask_me :),
           "密室": (: ask_me :),
           "张天师": (: ask_me :),
                "茅山派": 
"我茅山派自张天师开山立派至今，世世代代皆以降妖伏魔为己任。\n"
        ]) );
        set("apprentice_available", 3);
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: cast_spell, "drainerbolt" :),
                (: cast_spell, "netherbolt" :),
                (: cast_spell, "fee	blebolt" :),
                (: cast_spell, "invocation" :),
        }) );

        create_family("茅山派", 5, "天师");

        set_skill("literate", 100);
	    set_skill("magic",120);
        set_skill("force",100);
        set_skill("spells",120);
      	set_skill("scratching",120);
	    set_skill("unarmed",60);
    	set_skill("sword",80);
        set_skill("parry",80);
        set_skill("dodge",80);
        set_skill("gouyee",120);
		set_skill("move",100);
		set_skill("essencemagic",80);
        set_skill("taoism",120);
        set_skill("necromancy",120);

        map_skill("spells", "necromancy");

        set_temp("apply/dodge", 20);
        set_temp("apply/armor", 20);

        setup();

        carry_object(__DIR__"sword")->wield();
        carry_object(__DIR__"robe")->wear();
        carry_object(__DIR__"hat")->wear();
        carry_object(__DIR__"shoe")->wear();
}

void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 贫道今天已经收了三个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
        if( (string)ob->query("gender") != "男性" )
                command("say 贫道是出家人，不便收女徒，得罪了。");
        else {
                command("say 嗯... 想入我茅山派？也好....");
                command("recruit " + ob->query("id") );
        }
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "taoist");
        add("apprentice_availavble", -1);
}

 
void init()
{
		add_action("give_quest","quest");
		add_action("do_agree","yuanyi");
}
void questbonus(object ob)
{
if(random(3)<1)
   ob->set("quest/fealty",2);
else ob->set("quest/fealty",1);
}

string ask_me()
{
    command("hehe");
    command("say 何为有缘？你若是能接住我三招魔法，就是有缘人。");
    this_player()->add_temp("茅山派/to_be_hit", 1);
    return "你可愿意一试？(yuanyi)";
}


int do_agree(string arg)
{
    object me=this_player(), npc=this_object(), ob;
    string myname=me->name(), myrude=RANK_D->query_rude(me);

	
    if (me->query("family/family_name")!="茅山派"
		||!me->query_temp("茅山派/to_be_hit"))
	return 0;
    me->delete_temp("茅山派/to_be_hit");
    if (!(ob=query_temp("weapon"))
     || ob->query_temp("skill_type") != "sword")
    {
	destruct(ob);
	ob=new("/daemon/class/taoist/sword");
	ob->move(npc);
	command("wield sword");
    }
    command("say 哈哈，有胆子！");
	command("cast drainerbolt on "+me->query("id")+"");
    if(me->query("kee") < 0||me->query("sen")<0||me->query("gin")<0
    || !present(me, environment()))
    {
	command("say 嘿嘿，"+myrude+"一家伙都经不住，还是回去多练两年吧！");
	return 1;
    }
	npc->start_busy(-1000);
	me->remove_all_killer();
	npc->remove_all_killer();
    call_out("do_cast_me2",1,me,npc,myrude,myname);
}

int do_cast_me2(object me,object npc,string myrude,string myname)

{
    command("say 不错，有点意思，再看这一招！");
	command("cast netherbolt on "+me->query("id")+"");
    if(me->query("kee") < 0||me->query("sen")<0||me->query("gin")<0
    || !present(me, environment()))
    {
	command("say "+myrude+"能经住我一下子已经不容易了，我早就看出来这第二下子你受不了了！");
	return 1;
    }
	npc->start_busy(-1000);
	me->remove_all_killer();
	npc->remove_all_killer();
    call_out("do_cast_me3",1,me,npc,myrude,myname);
}

int do_cast_me3(object me,object npc,string myrude,string myname)

{
    command("say 居然挺过了老林两家伙！");
	command("cast feeblebolt on "+me->query("id")+"");
    if(me->query("kee") < 0||me->query("sen")<0||me->query("gin")<0
    || !present(me, environment()))
    {
	command("say 唉，"+myrude+"的缘份比老林也就差了那么一丁点儿。");
	return 1;
    }
    me->add_temp("茅山派/白发有缘", 1);
    command("say "+myname+"果然是有缘人。");
    command("say 你去找我师父吧！他就在密室里面。");
    me->remove_all_killer();
    npc->remove_all_killer();
	remove_action("do_agree","yuanyi");
}


