
#include <ansi.h>
inherit EQUIP;
void create()
{
   set_name(HIR "软猬甲" NOR, ({ "ruan weijia","ruan","weijia", }) );
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "件");
        set("armor_type", "cloth");
        set("no_sell", 1);
            set("armor_prop/dodge", 10);
        set("armor_prop/armor", 300);
    }
}
