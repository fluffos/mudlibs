// sroad9.c
// Modified by Java Apr.27 1998

inherit ROOM;
void create() {
  set("short", "血刀大门");
  set("long", @LONG
山谷里遍地积雪，四周都是峭壁。只北面有一个出口，东面似乎有
个山洞。
LONG);
  set("exits", ([
    "south": __DIR__ "wangyougu",
    "north": __DIR__ "sroad10",
  ]));
  set("objects", ([
    __DIR__ "npc/suixi": 1,
    __DIR__ "npc/dizi2": 5,
  ]));
  set("outdoors", "xueshan");
  setup();
  replace_program(ROOM);
}
int valid_leave(object me, string dir) {
  if ((dir == "north")
    && ((string)me->query("family/family_name") != "雪山寺")
    && (objectp(present("xuedao dizi", environment(me)))
      ||
      objectp(present("sui xi", environment(me)))))
    return notify_fail("血刀门弟子伸手拦住你，说道：“非血刀门弟子请回！”\n");
  return ::valid_leave(me, dir);
}
