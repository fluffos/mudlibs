// ruoyu.c
inherit NPC;
#include <ansi.h>;
inherit F_MASTER;
void init();

void create() {
  string *surname = ({ "邓赛特", "方蒲徒", "邱宏", "岑风璀", "杜德", "顾悠", "薛群", "郑禅", "蔡雍", "毛肃", "庞森", "钟耿" });
  set_name(surname[random(sizeof(surname))], ({ "xuedao dizi", "dizi" }));

  set("age", random(10) + 17);
  set("gender", "男性");
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("shen", random(-1000) + -1000);
  set("max_qi", random(500) + 500);
  set("max_neili", random(500) + 500);
  set("max_jingli", random(500) + 500);
  set("max_jing", random(500) + 500);
  set("jiali", random(10) + 50);
  set("combat_exp", random(1000) + 100000);

  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("strike", 100);
  set_skill("unarmed", 100);
  set_skill("blade", 100);
  set_skill("miexian-zhang", 100);
  set_skill("xuehai-mogong", 100);
  set_skill("xuedun", 100);
  set_skill("xue-dao", 100);

  map_skill("force", "xuehai-mogong");
  map_skill("dodge", "xuedun");
  map_skill("blade", "xue-dao");
  map_skill("parry", "xue-dao");
  map_skill("unarmed", "miexian-zhang");

  create_family("血刀门", 7, "弟子");
  map_skill("strike", "miexian-zhang");

  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/gangdao")->wield();
}
