//ROOM damen.c

inherit ROOM;

void create()
{
	set("short", "血刀门大门");
        set("long",@LONG
这就是通向『血刀门』走廊的大门。大门左右各有一头石雕的猛鹫
，高达三丈有余，尖喙巨爪，神骏非凡，栩栩如生，似乎随时要腾空而去。
LONG );
        set("outdoors", "xueshan");
        set("exits", ([
		"north" : __DIR__"sroad10",
		"south" : __DIR__"wangyougu",
        ]));
	set("objects",([
		__DIR__"npc/dizi2" : 5,
		__DIR__"npc/suixi" : 1,
	]));
//        set("no_clean_up", 0);
	setup();
}

int valid_leave(object me, string dir)
{
	if (  (dir == "north")
           && ((string)me->query("family/family_name") != "血刀门")
	   && ( objectp(present("xuedao dizi", environment(me)))
	   ||   
objectp(present("sui xi", environment(me))) ) )
        return notify_fail
		("血刀门弟子伸手拦住你，说道：“非血刀门弟子请回！”\n");
	return ::valid_leave(me, dir);
}
