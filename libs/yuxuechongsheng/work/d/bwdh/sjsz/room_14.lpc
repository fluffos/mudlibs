#include <ansi.h>
inherit ROOM;
#include "sjsz_room.h"

void create() {
    set("short", HIM"西厅"NOR);
    set("long",
"这里是比武场的西厅，四周静悄悄的。空气中已经弥漫者一股杀气，\n"
"使你感到不寒而栗。\n"
);
    set("exits", ([
        "north"     : __DIR__"room_22",
        "northwest" : __DIR__"room_13",
    ]));
    create_room();
    setup();
}

void init() {
    init_room();
}
