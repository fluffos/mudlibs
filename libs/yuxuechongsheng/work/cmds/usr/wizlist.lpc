// wizlist.c

#include <ansi.h>
inherit F_CLEAN_UP;
string *mission,*titlemission; 
string get_titlemission( string );
string fill_blank(string type, int num);
string remove_ansi(string str)
{
        int i;
        string *color = ({ BLK, RED, GRN, YEL, BLU, MAG, CYN, WHT,
                        HIR, HIG, HIY, HIB, HIM, HIC, HIW,
                        HBRED, HBGRN, HBYEL, HBBLU, HBMAG, HBCYN, HBWHT,
                        BBLK, BRED, BYEL, BBLU, BMAG, BCYN,
                        NOR, BOLD });
        if( !str || !stringp(str) ) return 0;
        i = sizeof(color);
        while( i-- ) {
                str = replace_string(str, color[i], "");
        }
        return str;
}
int level(mixed, mixed);
string get_mission( string );
int main(object me, string arg)
{
        int i;
        string *list, hood="", str, msg, scr, att, showtime;
    int bos_n, adm_n, arc_n, wiz_n, app_n, imm_n, j, k, time, day, hour, min, year, month;
        object login;
       mission = explode(read_file("/adm/etc/renwu"), "\n");
        list = sort_array(SECURITY_D->query_wizlist(), (: level :));
        //得到各种级别巫师的个数。
        for(i=0; i<sizeof(list); i++) {
                switch (wizhood(list[i])) { 
                        case "(boss)"          :bos_n++;break;
                        case "(admin)"          :adm_n++;break;
                        case "(arch)"           :arc_n++;break;
                        case "(wizard)"         :wiz_n++;break;
                        case "(apprentice)"     :app_n++;break;
                        case "(immortal)"       :imm_n++;break;
                }
        }
        str = HIG"◎"HIR+ MUD_NAME + HIG"◎ "NOR"目前共有 "HIY+ chinese_number(sizeof(list)) +NOR" 位巫师：\n";
       str =HIR"★"HIW"≡"HIB"──────────────────────────────"HIW"≡"HIR"★\n"NOR;
        str +=HIB"【"HIW"巫师等级"HIB"】    【"HIW"巫师ID"HIB"】 【"HIW"状态"HIB"】 【"HIW"目前任务"HIB"】  【 "HIW"间 隔 时 间"HIB" 】        \n"NOR;
       str +=HIR"★"HIW"≡"HIB"──────────────────────────────"HIW"≡"HIR"★\n"NOR;
        for(i=0; i<sizeof(list); i++) {
                if (hood != wizhood(list[i])) {
                        hood = wizhood(list[i]);
                        switch (hood) { 
                                case "(boss)"          :msg =HIB"【"NOR HIR"游戏策划"HIB"】"NOR;k=bos_n;break;
                                case "(admin)"          :msg =HIB"【"HIM"系统管理"HIB"】"NOR;k=adm_n;break;
                                case "(arch)"           :msg =HIB"【"HIY"程序开发"HIB"】"NOR;k=arc_n;break;
                                case "(wizard)"         :msg =HIB"【"NOR RED"开发辅助"HIB"】"NOR;k=wiz_n;break;
                                case "(apprentice)"     :msg =HIB"【"NOR MAG"人事管理"HIB"】"NOR;k=app_n;break;
                                case "(immortal)"       :msg =HIB"【"NOR CYN"荣誉玩家"HIB"】"NOR;k=imm_n;break;
                        }
                        j=1;
                } else {
                        msg="";
                        j++;
                }
                if ( k == 1) scr=HIB"━━━"NOR;
                else scr=HIB"━┳━"NOR;

                if ( k!=j && k!=1 && j!=1 ) scr=HIB"  ┣━"NOR;
                if ( k==j && k!=1 && j!=1 )     scr=HIB"  ┗━"NOR;
                
                if(objectp(login = find_player(list[i])) && me->visible(login)) {
                        att=HIG"连线"NOR;
                       time = time() - login->query_temp("time");
                } else {
                        att=HIR"离线"NOR;
                        time = time() - (stat(sprintf("%slogin%s%s%s", DATA_DIR,"/"+list[i][0..0]+"/",list[i],__SAVE_EXTENSION__),-1)[1]);
                }
                
                time /= 60;
                min = time%60;
                time /= 60;
                hour = time%24;
                time /= 24;
                day = time;

                if(objectp(login = find_player(list[i])) && me->visible(login)) 
               showtime=sprintf(HIG"%s%s%s"NOR,day?sprintf("%d天",day):"",
                                        hour?sprintf("%d小时",hour):"",
                                        min?sprintf("%d分钟",min):"小于一分钟");

                else
               showtime=sprintf(HIR"%s%s%s"NOR,day?sprintf("%d天",day):"",
                                        hour?sprintf("%d小时",hour):"",
                                        min?sprintf("%d分钟",min):"小于一分钟");



                if ( wizhood(list[i])!="(immortal)" ) {
//                        str += sprintf("%-12s%s "YEL"%-10s"NOR"%s %s%s",msg, scr, list[i], att, get_mission( list[i] ), get_titlemission( list[i]));
                        str += sprintf("%-12s%s "HIY"%-10s"NOR"%s   %s",msg, scr, list[i], att, get_mission( list[i] ));
                        str += fill_blank(remove_ansi(get_mission( list[i])), 15)+showtime+"\n";
                }
                if (wizardp(me) && wizhood(list[i])=="(immortal)" ) {
                        str += sprintf("%-12s%s "HIY"%-10s"NOR"%s   %s",msg, scr, list[i], att, get_mission( list[i] ));
                        str += fill_blank(remove_ansi(get_mission( list[i])), 15)+showtime+"\n";
                }
        }
        str +=HIR"★"HIW"≡"HIB"──────────────────────────"WHT"泥潭"HIB"──"HIW"≡"HIR"★\n"NOR;
        me->start_more(str);
        return 1;
}
int level(mixed ob1, mixed ob2)
{
        if (wiz_level(ob1) != wiz_level(ob2))
                return wiz_level(ob2) - wiz_level(ob1);
        return ob1 < ob2?-1:1;
}
string get_mission( string wiz)
{
        int i;
        string wname,wmin;
        for(i=0; i<sizeof(mission); i++) {
                if( mission[i][0]=='#' || sscanf(mission[i], "%s %s",
                        wname, wmin)!=2 ) continue;
                if(wname==wiz) return HIB"【"+NOR WHT+wmin+HIB"】"NOR;
        }
        return HIB"【"NOR"任务未定"HIB"】"NOR;
}
string get_titlemission( string wiz)
{
        int i;
        string wtname,wtmin;
        for(i=0; i<sizeof(titlemission); i++) {
                if( titlemission[i][0]=='#' || sscanf(titlemission[i], "%s %s",
                        wtname, wtmin)!=2 ) continue;
                if(wtname==wiz) return wtmin;
        }
        return NOR CYN"（ 暂时没有 ）"NOR;
}  
string fill_blank(string type, int num)
{
        string bak;
        int i, j;
        bak="";
        i=strlen(type);
        for (j=0; j<num-i; j++ )
                bak+=" ";
        return bak;
}
int help(object me)
{
write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单及巫师当前任务。

HELP
     );
     return 1;
}

