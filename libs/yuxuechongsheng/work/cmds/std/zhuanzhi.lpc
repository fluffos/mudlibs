#include <combat.h>
int help(object me);

int main(object me, string arg) {
  if ((int)me->query("combat_exp") < 2000000000)
    return notify_fail("你没有这么多经验来转移！\n");
  if ((int)me->query("combat_exp") >= 2000000000) {
    me->add("zhuanzhi/exp", 1);
    me->add("combat_exp", -2000000000);
    write("OK!\n");
  } else write("你没有这么多经验来转移！\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 :zhuanzhi 
      把经验转换格式计算。
see also : hp

HELP
  );
  return 1;
}
