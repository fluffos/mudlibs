// team.c
//全新的组队形式.rongg@xbtxIII 2001/1/15
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object *t;

        if( !arg ) 
        {
                if( !pointerp(t = me->query_team()) )
                        return notify_fail("你现在并没有参加任何队伍。\n");
                write("你现在队伍中的成员有：\n  " + implode(t->name(1), "\n  ") + "。\n");
                return 1;
        }
        if( arg=="dismiss" )
        {
                if( !pointerp(t = me->query_team()) )
                        return notify_fail("你现在并没有参加任何队伍。\n");
                if( me->is_team_leader() ) 
                {
                        message("team", me->name(1) + "将队伍解散了。\n", t, me);
                        me->delete("pending");
                        write("你将队伍解散了。\n");
                }
                else
                {
                        message("team", me->name(1) + "决定脱离队伍。\n", t, me);
                        write("你脱离了你的队伍。\n");
                }
                me->dismiss_team();
                return 1;
        }
        if( sscanf(arg, "with %s", arg)==1 )
        {
                object ob;

                if( !(ob = present(arg, environment(me)))
                ||      !living(ob)
                ||      !ob->is_character()
                ||      ob==me )
                        return notify_fail("你想和谁成为夥伴？\n");
                
                if(me->is_team_leader()&&ob->is_team_leader())
                        return notify_fail("你不能和另外一个队伍组队\n");
                
                if(me->is_fighting()||ob->is_fighting())
                        return notify_fail("双方有一方处于战斗状态,无法组队\n");
                
                if( member_array(ob, me->query_enemy())!=-1 )
                        return notify_fail("你必须和对方和解才能够组队\n"); 
                
                if(me->is_team_member(me,ob)!=-1) 
                        return notify_fail(ob->name()+"已经是你的队员了\n");
                
               if(sizeof(me->query_team())>=8||sizeof(ob->query_team())>=8)
                        return notify_fail("队伍已满。\n");
                
/*
               if(me->query("combat_exp")-ob->query("combat_exp")>50000000)
                        return notify_fail("你和对方的级别相差太远，不适合组队\n");
                        //酌情更改经验条件
                if(!me->query("occupation")||
                  !(me->query("occupation")=="fighter"||me->query("occupation")=="enchanter"))
                  
                         return notify_fail("无职业玩家不能组队\n");
                */ 
                me->set_leader(0);//不然玩家相互follow会产生移动问题.
                if( !pointerp(me->query_team()) || me->is_team_leader() )
                {
                        if( me==(object)ob->query_temp("pending/team") ) 
                        {
                                if( !pointerp(me->query_team()) ) 
                                {
                                        ob->add_team_member(me);
                                        message_vision("[$N]决定加入[$n]的队伍。\n", me, ob);
                                        
                                }
                                else
                                {
                                        me->add_team_member(ob);

                                        message_vision("[$N]决定让[$n]加入队伍。\n", me, ob);
                                }
                                ob->dellete_temp("pending/team");
                                return 1;
                        } 
                        else
                        {
                                message_vision("[$N]邀请[$n]加入[$P]的队伍。\n", me, ob);
                                tell_object(ob, YEL "如果你愿意加入，请用 team with [" + me->query("id") + "]。\n" NOR);
                                me->set_temp("pending/team", ob);
                                return 1;
                        }
                }
                else
                        return notify_fail("只有队伍领袖可以邀请别人加入。\n");
        }
        if( sscanf(arg, "talk %s", arg)==1 ) 
        {
                if( !pointerp(t=me->query_team()) )
                        return notify_fail("你现在并没有和别人组成队伍。\n");
                message("team", CYN "【队伍】" + me->name(1) + "：" + arg + "\n" NOR, t);
                return 1;
        }
        return 1;
        /*
        if( sscanf(arg, "form %s", arg)==1 ) {
                if( !pointerp(t=me->query_team()) || !me->is_team_leader() )
                        return notify_fail("你必须是一个队伍的领袖才能组织阵形。\n");
                if( !me->query_skill(arg, 1) )
                        return notify_fail("这种阵形你没学过。\n");
                return SKILL_D(arg)->form_array(me);
        }
        *///暂时还不能开放阵行，因为还没有构思好阵行的实现 
}

int help(object me)
{
        write( @HELP
队伍指令使用方法:

team with <某人> - 跟某人组成队伍. 必须要双方都同意加入才会生效。
team dismiss     - 离开队伍. 若下此指令的是领队, 则整个队伍会解散。
team talk <讯息> - 跟队伍里其他的人谈话, 可以用 tt <讯息> 替代。
直接下 team 指令时则会显示你目前是否有加入队伍及队员名单。

组队是YXCS的一个特点:组队可以提高整个队伍的战斗力(只对经验
级别比较低的玩家有效),玩家组队之后,所有队员视为一体,无论做quest,
task,运镖还是杀npc,队伍中的队员获得的奖励比单独完成要高出许多.另外
对于某些比较大型的秘密,单独是无法完成的.
HELP
        );
        return 1;
}
