#pragma save_binary
#include <ansi.h>;
int main(object me, string arg)
{
	object water;
	if(!arg) return notify_fail("您要给什么东西装水？？\n");
	water=present(arg,me);
	if(!water) water=present(arg,environment(me));
        if(!water) return notify_fail("您周围似乎没有您要装水的东西。\n");
        if(me->is_busy())return notify_fail("你上一个动作还没有完成。\n");
        if(!water->type()||(string)water->type()!="food"
           ||!water->query("max_liquid"))
            return notify_fail("这个东西恐怕不能装水吧!\n");
        if( !environment(me)->query("resource/water") )
                return notify_fail("这里没有地方可以装水。\n");
        if(water->query("liquid/remaining") )
            message_vision("$N将" +water->name() + "里剩下的"+water->query("liquid/name") + "倒掉。\n", me);
        message_vision("$N将" +water->name() + "装满清水。\n", me);
        water->set("liquid/type", "water");
        water->set("liquid/name", "清水");
        water->set("liquid/remaining", water->query("max_liquid"));
        water->set("liquid/drink_func", 0);
        if( me->is_fighting() ) me->start_busy(2);
        return 1;
}

