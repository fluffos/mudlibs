#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg);
int replace(string file, string oldstr, string newstr);
int help(object me);

int main(object me, string arg)
{
        string file, oldstr, newstr;
        mixed *dir;
        int i;

        if (!arg)
                return help( me );
        if (sscanf(arg, "%s %s %s", file, oldstr, newstr) != 3) 
                return help(me);
                
        seteuid(geteuid(this_player(1))); 
        if (!SECURITY_D->valid_write(file, me))
                return notify_fail("没有足够的读写权限.\n");
                

        else if (file_size(file) > 0)
        {               
                replace(file, oldstr, newstr);
                return 1;
        }
   
        else if(file_size(file) == -2) 
        {
                dir = get_dir(file);
                reset_eval_cost();
                for(i=0; i<sizeof(dir); i++)
                {
                        if ( file_size(file + dir[i]) > 0)
                        {                               
                                replace(file + dir[i], oldstr, newstr);
                                write("\n "+ file + dir[i] +"\n");
                        }
                }
                write("转换完毕.\n");
                return 1;
        }
        else return notify_fail("没有这个文件或目录.\n");
        return 1;  
}
int replace(string file,string oldstr,string newstr)
{
        string *text, *strings, line;
        int i,j;   
   
        j = 0;
        if (file_size(file) < 1)
                return 0;
   
        text = explode(read_file(file), "\n");
        rm(file);
        for(i=0; i<sizeof(text); i++)
        {
                if(strsrch(text[i], oldstr) == -1)
                {
                        write_file(file, text[i]+"\n");
                }
                else
                {
                        strings = explode(text[i], oldstr);
                        line    = implode(strings, newstr)+"\n";
                        if(strsrch(text[i], oldstr) == 0)
                                line = newstr + line;
                        write_file(file, line);
                        j++;
                } 
        }
        write(file+",  有"+j+"个"+oldstr+"被换成"+newstr+"\n");
        return 1;
}
int help(object me)
{
write(@HELP

将文件里的所有字符转换成另一个字符.
格式 : replace <目录或文件名> <原字符> <新字符>
注意：本命令比较危险，请小心使用。

HELP);
return 1;
}

