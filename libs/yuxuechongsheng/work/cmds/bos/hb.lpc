// 只是为了临时需要而写，没有实际多大作用

#include <command.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  mixed *dir;
  string file;
  int i;
  seteuid(getuid());
  if (!arg) return notify_fail("格式：hb <字符>，字符限制在a-z之间\n");
  dir = get_dir("/data1/user/" + arg + "/", 0);
  if (!dir) return notify_fail("没有这个目录，或者没有这个目录下的文件，请查阅。\n");

  for (i = 0; i < sizeof(dir); i++) {
    if (sscanf(dir[i], "%s.o", file) == 1) {
      reset_eval_cost();
      if (file_size("/data/user/" + arg + "/" + file + ".o") != -1) continue;
      cp("/data1/login/" + arg + "/" + file + ".o", "/data/login/" + arg + "/" + file + ".o");
      cp("/data1/user/" + arg + "/" + file + ".o", "/data/user/" + arg + "/" + file + ".o");
      rm("/data1/user/" + arg + "/" + file + ".o");
      rm("/data1/login/" + arg + "/" + file + ".o");
    }
  }
  "/cmds/arch/rehash"->main(this_player(), "/data/user/" + arg + "/");
  "/cmds/arch/rehash"->main(this_player(), "/data/login/" + arg + "/");
  tell_object(this_player(), arg + "的目录下档案已经复制到玩家档完毕。\n");
  return 1;
}
