// /clone/board/board_b.c


inherit BULLETIN_BOARD;


void create()
{
        set_name("留言簿", ({ "board" }) );
        set("location", "/u/lilong/workroom");
        set("board_id", "wiz_b");
        set("long", "这是李龙不在时,请朋友给自己留言的地方。\n" );
        setup();
        set("capacity", 90);
}

void init()
{
        ::init();
        add_action("do_meet", "meet");
}

int do_meet()
{
        object *ob = objects();
        int i = sizeof(ob);

        message_vision("$N按动机关召集巫师。\n", this_player());
        while (i--)
                if (userp(ob[i]) && wiz_level(ob[i])
                && !present(ob[i], environment())) {
                        ob[i]->move(environment());
                        message_vision("$N稀里糊涂地被扔了过来。\n", ob[i]);
                }

        EMOTE_D->do_emote(this_player(), "meeting");
        return 1;
}

