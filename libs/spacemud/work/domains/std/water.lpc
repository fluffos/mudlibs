inherit FLUID;
inherit M_DRINKABLE;

/* Two inherits define direct_drink_obj, direct_drink_obj_from_obj, drink_it(); the later one was already in effect: name it. */
mixed direct_drink_obj() { return m_drinkable::direct_drink_obj(); }
mixed direct_drink_obj_from_obj() { return m_drinkable::direct_drink_obj_from_obj(); }
varargs void drink_it(object drinkee) { m_drinkable::drink_it(drinkee); }

void setup()
{
   set_adj("fresh");
   set_id("water");
   set_size(1);
   set_in_room_desc("There is a puddle of water here.");
   set_gettable("#It slips through your fingers.");
   set_evaporate_action();
   set_quantity(1);
   //    set_quantity_unit( "gloop" );
}
