/* Do not remove the headers from this file! see /USAGE for more info. */

inherit FLUID;
inherit M_DRINKABLE;

/* Two inherits define direct_drink_obj, direct_drink_obj_from_obj, drink_it(); the later one was already in effect: name it. */
mixed direct_drink_obj() { return m_drinkable::direct_drink_obj(); }
mixed direct_drink_obj_from_obj() { return m_drinkable::direct_drink_obj_from_obj(); }
varargs void drink_it(object drinkee) { m_drinkable::drink_it(drinkee); }

void setup()
{
   add_adj("amber");
   set_id("ale", "beer", "lager");
#ifdef USE_SIZE
   set_size(1);
#endif
#ifdef USE_MASS
   set_mass(1);
#endif
   set_long("The ale is amber and clear, with a slight head of foam on it. ");
   set_in_room_desc("There is a puddle of spilled ale on the ground here.");
   set_gettable("#It slips through your fingers.");
   set_evaporate_action("The puddle of ale dwindles.");
   set_taste_action(({"It's a little bit weak, but it'll do the job.", ""}));
   set_quantity(1);
}
