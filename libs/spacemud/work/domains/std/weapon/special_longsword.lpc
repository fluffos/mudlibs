/* Do not remove the headers from this file! see /USAGE for more info. */

inherit "/domains/std/weapon/longsword";
inherit M_SPECIAL_WEAPON;

/* Two inherits define source_modify_event(); the later one was already in effect: name it. */
class event_info source_modify_event(class event_info evt) { return m_special_weapon::source_modify_event(evt); }

/* Two inherits define event_damage, event_to_str, short(); the later one was already in effect: name it. */
int event_damage(class event_info evt) { return m_special_weapon::event_damage(evt); }
string event_to_str(class event_info evt) { return m_special_weapon::event_to_str(evt); }
string short() { return m_special_weapon::short(); }

void setup()
{
   ::setup();
   roll_item();
}

void internal_setup()
{
   m_special_weapon::internal_setup();
   longsword::internal_setup();
}