/* Do not remove the headers from this file! see /USAGE for more info. */

inherit ADVERSARY;
inherit M_ACCOUNTANT;

/* Two inherits define colour_strlen, mudlib_setup, remove(); the later one was already in effect: name it. */
int colour_strlen(string str) { return m_accountant::colour_strlen(str); }
void mudlib_setup() { adversary::mudlib_setup(); m_accountant::mudlib_setup(); }
void remove() { m_accountant::remove(); }

void setup()
{
   set_name("Samuel");
   add_id("accountant", "sam");
   set_gender(1);
   set_proper_name("Samuel the Bank Accountant");
   set_in_room_desc("Samuel the Bank Accountant stands behind the counter.");
   set_long("Samuel is a boring looking balding man. Perfectly clothed of "
            "course.");
   set_bank_id("Bean");
   set_bank_name("The Imperial Bank of the Bean");
   set_currency_type("gold");
   set_exchange_fee(5);
}
