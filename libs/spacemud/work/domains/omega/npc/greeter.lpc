#include <triggers.h>

inherit LIVING;
inherit M_CONVERSATION;   // which brings M_ACTIONS
inherit M_TRIGGERS;

/* Two inherits define environment_can_hear, receive_inside_msg, receive_outside_msg, receive_private_msg, receive_remote_msg(); the later one was already in effect: name it. */
int environment_can_hear() { return m_triggers::environment_can_hear(); }
varargs void receive_inside_msg(string msg, object *exclude, int message_type, mixed other) { m_triggers::receive_inside_msg(msg, exclude, message_type, other); }
varargs void receive_outside_msg(string msg, object *exclude, int message_type, mixed other) { m_triggers::receive_outside_msg(msg, exclude, message_type, other); }
varargs void receive_private_msg(string msg, int message_type, mixed other) { m_triggers::receive_private_msg(msg, message_type, other); }
varargs void receive_remote_msg(string msg, object *exclude, int message_type, mixed other) { m_triggers::receive_remote_msg(msg, exclude, message_type, other); }

void setup()
{
    ::setup();
    set_name("Terminal Attendant");
    set_id("attendant");
    set_gender(2);
    set_proper_name("Kimby Watson");

    set_in_room_desc("A friendly looking attendant.");
    set_long("The attendant is wearing a police uniform from before the wars. The jacket lies draped across the back of "
             "the camping chair, his sleeves are turned up and his hands are dirty from bike grease.\n");
    set_gender(1);

    set_actions(10, ({"say Hello and Welcome to Omega Terminal.",
                     "Say Can I help you with anything?",
                     "smile"}));
    add_pattern(
        "%s help", function() {
            respond("say how can I help you?");
        });

    set_options((["hello":"Hello!"]));

    set_responses((["hello":"Hello there!@@attendant"]));
    set_start(({"hello"}));
}