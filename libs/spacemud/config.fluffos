###############################################################################
#     Customizable runtime config file for FluffOS -- Spacemud             #
###############################################################################
# Spacemud runs on the LIMA mudlib codebase with as few changes as possible
# (secure/check_config.lpc confirms it via the same driver-flag self-test as
# libs/lima -- see NOTES.md). Its check_config.lpc flag list is IDENTICAL to
# libs/lima's own (both require #undef ARRAY_RESERVED_WORD, unlike
# libs/wilderness's older snapshot which needs the opposite) -- this lib
# reuses the existing ~/src/fluffos-lima driver worktree directly, no new
# worktree needed. See NOTES.md for the confirmation.

name : Spacemud

port number : 40259

mudlib directory : /home/sunyc/src/mudlib/libs/spacemud/work

# log directory resolves against the driver's launch CWD, not the mudlib
# directory -- always launch via `cd libs/spacemud && driver config.fluffos`
log directory : /log

global include file : <global.h>

debug log file : execute
include directories : /include

master file : /secure/master
simulated efun file : /secure/simul_efun

save binaries directory : /secure/binaries

time to clean up : 7200
time to swap : 1800
time to reset : 1800

maximum bits in a bitfield : 1200
maximum local variables : 30
maximum evaluation cost : 5000000
maximum array size : 15000
maximum buffer size : 400000
maximum mapping size : 15000
# Like libs/wilderness, this lib's std/body.lpc composes many feature
# modules (std/adversary + std/spaceship + domain-specific mixins) --
# bumped well above lima's borrowed default of 30 to avoid an "Inherit
# chain too deep" error on first player-body creation.
inherit chain size : 300
maximum string length : 200000
maximum read file size : 200000
maximum byte transfer : 10000

reserved size : 0

mudlib error handler : 1
