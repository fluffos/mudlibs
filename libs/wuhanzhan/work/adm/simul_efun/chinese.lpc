/* <SecCrypt CPL V3R05> */
 

string chinese_number(int i)
{
   return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
   return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
   // AGENTS.md #15h: this driver's strings are native UTF-8 -- str[0] is a
   // full Unicode codepoint, not a raw GBK lead byte, and strlen() counts
   // characters, not bytes. The original "str[0] > 160 && str[0] < 255"
   // GBK-lead-byte range check is always false against a real codepoint
   // like 0x4e2d (中). Replaced with a CJK Unified Ideographs codepoint
   // range check; strlen bound dropped from >=2 (>= 1 full 2-byte GBK char)
   // to >=1 (>= 1 real character).
   if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
   return 0;
}
