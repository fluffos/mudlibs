// thousand.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name(HIY "七百万两金票" NOR, ({ "thousand-cash", "thousand-cash_money", "cash" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "thousand-cash");
    set("long", "一张面额值七百万两金子的金票。\n");
    set("unit", "叠");
    set("base_value", 70000000000);
    set("base_unit", "张");
    set("base_weight", 5);
  }
  set_amount(1);
}
