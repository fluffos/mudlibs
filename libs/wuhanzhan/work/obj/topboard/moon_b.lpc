// nancheng_b.c

inherit "/obj/topboard/topboard";

void create() {
  set_name("月宫巾帼英豪排行榜", ({ "paihang bang", "bang" }));
  set("location", "/d/moon/ontop2");
  set("board_id", "moon_b");
  set("long", "月宫的巾帼英豪排行榜。\n你可以使用topfam来查看本排行榜。");
  set("family_name", "月宫");
  setup();

  replace_program("/obj/topboard/topboard");
}
