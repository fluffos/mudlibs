#include <ansi.h>
#include <mudlib.h>
inherit ITEM;
inherit F_SAVE;
int is_banned(string, object);
int get_all_data(object player, string top_id);
int topten_add(object, string);
int is_valid_topten(string);
string topten_query(string, object);

mapping topten = ([]);

int topnum = 10;
string topname = "TOP TEN";

void setup() {
  string loc;

  if (stringp(loc = query("location"))) move(loc);
  set("no_get", 1);
  restore();
}

void init() {
  object who = this_player();

  if (!userp(who)) return;

  add_action("do_topfam", "topfam");

  if (wizardp(who)) {
    add_action("do_topfamadd", "topfamadd");
    add_action("do_topfamdel", "topfamdel");
    add_action("do_topfamban", "topfamban");
    add_action("do_topfamset", "topfamset");
  }

  if (SECURITY_D->get_wiz_level(who) >= 5) {
    add_action("do_topfamopen", "topfamopen");
    add_action("do_topfamclose", "topfamclose");
  }
}

string query_save_file() {
  string id;

  if (!stringp(id = query("board_id"))) return 0;
  return DATA_DIR + "topboard/" + id;
}

int is_valid_topten(string tid) {
  if (!topten || !mapp(topten)) topten = ([]);

  if (undefinedp(topten[tid])) return 0;

  if (!mapp(topten[tid])) {
    map_delete(topten, tid);
    return 0;
  }

  return 1;
}

int get_topnum() { return topnum; }
int set_topnum(int num) {
  topnum = (num < 10 ? 10 : num);
  return save();
}

string get_topname() { return topname; }
int set_topname(string name) {
  topname = name;
  return save();
}

string get_topten_name(string tid) {
  return topname + chinese_number(topnum) + "大" + HIY + topten[tid]["name"] + NOR;
}

string query_min_limit() {
  string *saTopId, sMsg = "";

  if (!sizeof(topten)) return "目前还没有建立任何排行榜。\n";

  saTopId = keys(topten);
  sMsg += "排行榜名称\t\t排行榜下限\n==================================\n";
  for (int i = 0; i < sizeof(saTopId); i++) {
    sMsg += (saTopId[i] + "\t\t\t" + topten[saTopId[i]]["min_limit"] + "\n");
  }

  return sMsg;
}

int set_min_limit(string top_id, int data) {
  if (!is_valid_topten(top_id)) return notify_fail("请先建立这种排行榜。\n");

  topten[top_id]["min_limit"] = data;
  return this_object()->save();
}

int is_banned(string top_id, object ob) {
  string *banned;

  if (!is_valid_topten(top_id)) return 0;

  banned = topten[top_id]["banned"];

  if (!banned || !sizeof(banned)) return 0;
  return member_array(ob->query("id"), banned) > -1;
}

int do_ban(string top_id, string id, int ban) {
  // allow one player be sorted in one top_id, or not

  string *banned;
  int i;

  if (!is_valid_topten(top_id)) return notify_fail("没有这种排行榜。\n");

  banned = topten[top_id]["banned"];

  if (!ban) {
    if (!banned || !arrayp(banned)) return 1;
    if ((i = member_array(id, banned)) == 0) {
      banned = banned[1..<-1];
    } else if (i > 0) {
      banned = banned[0..i - 1] + banned[i + 1..<1];
    }

    save();
    return 1;
  }

  if (!banned || !arrayp(banned)) {
    banned = ({ id });
    save();
    return 1;
  }

  if (member_array(id, banned) >= 0) {
    return 1;
  }

  banned += ({ id });

  topten[top_id]["banned"] = banned;

  return this_object()->save();
}

string query_ban(string type) {
  string *saBannedId, sMsg;

  if (!is_valid_topten(type)) return "没有这个排行榜。\n";

  saBannedId = topten[type]["banned"];
  if (!saBannedId || !sizeof(saBannedId))
    return get_topten_name(type) + "排行榜没有限制任何玩家进入。\n";

  sMsg = "目前共有如下玩家被禁止进入" + topname + topten[type]["name"] + "排行榜。\n";
  sMsg += "==============================================\n";
  sMsg += "ＩＤ\t\t\t中文名字\n";
  for (int i = 0; i < sizeof(saBannedId); i++)
#ifdef NAME_D
    sMsg += saBannedId[i] + "\t\t\t" + NAME_D->id_to_name(saBannedId[i]) + "\n";
#else
  sMsg += saBannedId[i] + "\n";
#endif
  return sMsg;
}

int add_top(string sTopId, string sTopName, string sTopProp, int iMinLimit, string sType) {
  mapping mNewTop;

  mNewTop = ([]);
  mNewTop += ([ "name": sTopName ]);
  mNewTop += ([ "prop": sTopProp ]);
  mNewTop += ([ "min_limit": iMinLimit ]);
  mNewTop += ([ "ids": ({}) ]);
  mNewTop += ([ "names": ({}) ]);
  mNewTop += ([ "values": ({}) ]);
  mNewTop += ([ "banned": ({}) ]);
  mNewTop += ([ "class": sType ]);
  topten[sTopId] = mNewTop;
  return this_object()->save();
}

int delete_top(string top_id) {
  map_delete(topten, top_id);
  return this_object()->save();
}

void topten_checkplayer(object player) {
  string *saTopId;
  int iTopNum;

  if (!topten || !(iTopNum = sizeof(topten))) return;

  saTopId = keys(topten);
  for (int i = 0; i < iTopNum; i++) {
    topten_add(player, saTopId[i]);
  }

  return;
}


string topten_query(string sTopId, object ob) {
  string msg, *ids, *names;
  int pos, num, *values;
  mapping top;

  if (!is_valid_topten(sTopId)) return "目前还没有这种排行榜。\n";

  top = topten[sTopId];
  msg = HIY + CHINESE_MUD_NAME + "：\n" NOR + HIC + query("family_name") + get_topten_name(sTopId) + HIC "排行榜\n" NOR;

  ids = top["ids"];
  names = top["names"];
  values = top["values"];
  if (!ids || !values || sizeof(ids) != sizeof(values)) {
    map_delete(topten, sTopId);
    save();
    return "本排行榜数据丢失，请联系巫师，重新创建本排行榜。\n";
  }

  if (!sizeof(ids)) {
    return msg + "目前还没有人进入" + topname + top["name"] + "排行榜。\n";
  }

  msg += sprintf(HIW "排行第一：%s(%s)\t\t%s\n" NOR,
    names[0],
    ids[0],
    wizardp(ob) ? sprintf("%d", values[0]) : ""
  );

  num = 0;
  for (pos = 1; pos < sizeof(ids) && num < topnum; pos++) {
    if (values[pos - 1] == values[pos]) {
      msg += sprintf(HIY "并列第%s：%s(%s)\t\t%s\n" NOR,
        chinese_number(num + 1),
        names[pos],
        ids[pos],
        wizardp(ob) ? sprintf("%d", values[pos]) : ""
      );
    } else {
      num++;
      msg += sprintf(HIW "排行第%s：%s(%s)\t\t%s\n" NOR,
        chinese_number(num + 1),
        names[pos],
        ids[pos],
        wizardp(ob) ? sprintf("%d", values[pos]) : ""
      );
    }
  }


  return msg;
}

int get_all_data(object player, string top_id) {
  if (topten[top_id]["class"] == "base") {
    return (int)player->query(topten[top_id]["prop"]);
  } else if (topten[top_id]["class"] == "skill") {
    return (int)player->query_skill(topten[top_id]["prop"], 1);
  } else {
    // 当获取玩家的排序值比较麻烦的时候，就需要我们自己写段程序来
    // 控制了。
  }
}

int topten_del(string pid, string type) {
  string *ids;
  int pos, size;

  if (!is_valid_topten(type)) return notify_fail("没有这种排行榜。\n");

  ids = (string *)topten[type]["ids"];
  if ((size = sizeof(ids)) == 0) return 1;

  if ((pos = member_array(pid, ids)) >= 0) {
    topten[type]["ids"] = topten[type]["ids"][0..pos - 1] + topten[type]["ids"][pos + 1..size - 1];
    topten[type]["names"] = topten[type]["names"][0..pos - 1] + topten[type]["names"][pos + 1..size - 1];
    topten[type]["values"] = topten[type]["values"][0..pos - 1] + topten[type]["values"][pos + 1..size - 1];
    return this_object()->save();
  }

  return 1;
}

int topten_add(object player, string type) {
  int pos, size, num, data, *values;
  string pid, *ids, *names;

  if (!objectp(player) || !userp(player)) return 0;

  if (player->query("family/family_name") != query("family_name")) return 0;

  if (!is_valid_topten(type)) return notify_fail("目前并没有这种排行榜。\n");

  ids = topten[type]["ids"];
  names = topten[type]["names"];
  values = topten[type]["values"];
  if (!ids || !values || sizeof(ids) != sizeof(values) || sizeof(ids) != sizeof(names)) {
    map_delete(topten, type);
    save();
    return notify_fail("本排行榜数据丢失，请联系巫师，重新创建本排行榜。\n");
  }

  if (is_banned(type, player)) return 0;

  if ((data = get_all_data(player, type)) < topten[type]["min_limit"]) return 0;

  pid = (string)player->query("id");

  topten_del(pid, type);

  if (!(size = sizeof(topten[type]["ids"]))) {
    topten[type]["ids"] = ({ pid });
    topten[type]["names"] = ({ player->query("name") });
    topten[type]["values"] = ({ data });
    return save();
  }

  for (pos = 0; pos < size; pos++) {
    if (data > topten[type]["values"][pos]) break;
  }
  topten[type]["ids"] = topten[type]["ids"][0..pos - 1] + ({ pid }) + topten[type]["ids"][pos..<1];
  topten[type]["names"] = topten[type]["names"][0..pos - 1] + ({ player->query("name") }) + topten[type]["names"][pos..<1];
  topten[type]["values"] = topten[type]["values"][0..pos - 1] + ({ data }) + topten[type]["values"][pos..<1];

  size = sizeof(topten[type]["ids"]);
  num = 0;
  for (pos = 0; pos < size - 1; pos++) {
    if (topten[type]["values"][pos] != topten[type]["values"][pos + 1]) num++;
    else continue;
    if (num == topnum) break;
  }

  if (num == topnum) {
    topten[type]["ids"] = topten[type]["ids"][0..pos];
    topten[type]["names"] = topten[type]["names"][0..pos];
    topten[type]["values"] = topten[type]["values"][0..pos];
  }

  return save();
}

int open_help() {
  write(@HELP
本指令用来创建一个新的排行榜.

指令格式：topfamopen top_id top_name top_prop min class
五个参数都是必须的.譬如要建立pker的排行榜,则
应该用如下命令:

        topfamopen pker 恶人 PKS 50 base


该命令执行成功后,创建一个排行榜,只有杀玩家数
超过５０的人才可进入pker榜。以后则可以用topten
pker来查看十大恶人榜.
HELP
  );
  return 1;
}

int do_topfamopen(string arg) {
  string top_id, top_name, top_prop, cla;
  int min;

  if (!arg || arg == "") return open_help();

  if (sscanf(arg, "%s %s %s %d %s", top_id, top_name, top_prop, min, cla) == 5) {
    if (add_top(top_id, top_name, top_prop, min, cla))
      write("你成功的建立了" + get_topten_name(top_id) + "排行榜\n");

    return 1;
  }

  return open_help();
}

int do_topfamclose(string arg) {
  if (!arg || arg == "") return notify_fail("指令格式：\ntopfamclose <排行榜ID>\n");

  if (delete_top(arg)) write("你成功的删除了" + arg + "排行榜。\n");
  return 1;
}

int topfamset_help() {
  write("\n指令格式 : topfamset <类型> <数值>\n");
  write("这个命令用来设置进入排行榜所需要的最小值。\n" +
    "例如，topfamset exp 10000，则进入exp排行榜至少要有10000点道行。\n");
  write("如果不带参数，这个命令将列出现有所有排行榜的下限。\n");

  return 1;
}

int do_topfamset(object me, string arg) {
  string top_id;
  int data;

  if (!arg || arg == "") {
    write(query_min_limit());
    return 1;
  }

  if (sscanf(arg, "%s %d", top_id, data) != 2) return topfamset_help();

  write(set_min_limit(top_id, data) ? "设置成功。\n" : "设置失败。\n");
  return 1;
}

int do_topfamdel(string arg) {
  string top_id, id;

  if (!arg || sscanf(
    arg,
    "%s %s",
    top_id,
    id
  ) != 2) return notify_fail("\n指令格式 : topfamdel <类型> <玩家ID>\n");

  write(topten_del(id, top_id) ? "删除成功。\n" : "删除失败。\n");
  return 1;
}

int topfamban_help() {
  write("\n本指令用来取消或恢复一个玩家进入某一排行榜\n的资格." +
    "指令格式：topfamban top_id [-u] player_id\n" +
    "譬如: \ntopfamban exp misu将取消misu进入exp排行榜的资格.\n" +
    "topfamban exp -u misu 则恢复misu进入exp排行榜的资格.\n"
  );

  return 1;
}

int do_topfamban(string arg) {
  string top_id, id;
  object ob;
  int ban;

  if (!arg || arg == "")
    return topfamban_help();

  if (sscanf(arg, "%s -u %s", top_id, id) == 2) ban = 0;
  else if (sscanf(arg, "%s %s", top_id, id) == 2) ban = 1;
  else {
    write(query_ban(arg));
    return 1;
  }
  ob = find_player(id);
  if (!ob) ob = LOGIN_D->find_body(id);
  if (ban) topten_del(id, top_id);
  else if (ob) topten_add(ob, top_id);
  do_ban(top_id, id, ban);
  write("ok.\n");
  return 1;
}
int do_topfamadd(string arg) {
  string top_id, id;
  object ob;
  int i;
  object *list;
  if (!arg || sscanf(
    arg,
    "%s %s",
    top_id,
    id
  ) != 2) return notify_fail("\n指令格式 : topfamadd <类型> <玩家ID>\n");
  if (id == "all") {
    list = users();
    for (i = 0; i < sizeof(list); i++) {
      if (list[i]->query("name") && list[i]->query("id"))
        topten_add(list[i], top_id);
    }
    write("全部加入完成。\n");
    return 1;
  }
  if (!(ob = find_player(id))) ob = LOGIN_D->find_body(id);
  if (!ob) return notify_fail("这个玩家不在线上.\n");
  if (!topten_add(ob, top_id)) return 0;
  write("成功加入。\n");
  return 1;
}

int do_topfam(string arg) {
  object who = this_player();
  if (who->query("family/family_name") != query("family_name") && !wizardp(who))
    return notify_fail("你无法查看" + query("family_name") + "的高手排行榜。\n");
  topten_checkplayer(who);
  if (!arg || arg == "") {
    string *list = keys(topten);
    if (!list || !sizeof(list)) return notify_fail(query("family_name") + "还没有创建任何排行榜！\n");
    write(CHINESE_MUD_NAME + "\n");
    write(query("family_name") + "目前共有如下高手排行榜：\n");
    for (int i = 0; i < sizeof(list); i++) {
      write("topfam " + list[i] + " 十大" + topten[list[i]]["name"] + "排行榜\n");
    }
    return 1;
  }
  write(topten_query(arg, this_player()));
  return 1;
}
