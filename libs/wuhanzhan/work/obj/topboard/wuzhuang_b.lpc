// nancheng_b.c

inherit "/obj/topboard/topboard";

void create() {
  set_name("五庄观高手排行榜", ({ "paihang bang", "bang" }));
  set("location", "/d/qujing/wuzhuang/guangchang");
  set("board_id", "wuzhuang_b");
  set("long", "五庄观的高手排行榜。\n你可以使用topfam来查看五庄观的高手排行。\n");
  set("family_name", "五庄观");
  setup();

  replace_program("/obj/topboard/topboard");
}
