// wudidong_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("水陆大会报名留言版", ({ "board" }) );
        set("location", "/d/city/dian.lpc");
        set("board_id", "sldh_b");
        set("long", "这是水陆大会报名版，不要乱写乱画。\n");
        setup();
        set("capacity", 1000);
        replace_program(BULLETIN_BOARD);
}
