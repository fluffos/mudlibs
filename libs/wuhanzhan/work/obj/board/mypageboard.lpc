inherit BULLETIN_BOARD;

void create() {
  set_name("=仙履奇缘= 我的主页我的家 广告板", ({ "board" }));
  set("location", "/d/city/baihu-w1");
  set("board_id", "mypageboard");
  set("long", "这是一块难得的宝板，板面上闪闪发着金光，刻着一些玩家做的 大话西游 仙履奇缘 个人网站,听说网站做好后放到广告板里会得到人参果数枚。\n");
  setup();
  set("capacity", 200);
  replace_program(BULLETIN_BOARD);
}
