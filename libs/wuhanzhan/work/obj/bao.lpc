#include <ansi.h>

inherit ITEM;


int do_open(string arg);
void init()
{
     add_action("do_open", "open");
}

void create()
{
     set_name(RED "国庆大礼包" NOR, ({"libao", "bao"}));
     set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", RED"欢庆国庆大礼包。\n      
       
      }======================{
     /########################\\        
    _[_T_T_T_T_T_T_T_T_T_T_T_T_]_       
   |                             |                           |______nT__n___R___n__Tn______|                                        

 ※※※※※※※※※※※※※※※※※※※※※
 ※ 热烈庆祝中华人民共和国诞辰五十一周年 ※
 ※※※※※※※※※※※※※※※※※※※※※      \n");
           }
     if (!wizardp(this_player()))  
     {
        set("no_sell","国庆大礼包，怎么能卖？还是自己留着吧。\n");
        set("no_drop","国庆大礼包，哪能乱扔! \n");
        set("no_give","这么贵重的礼物，哪能随便给人？\n");
        set("no_put"," 嘿嘿，别妄想了！ \n");
        set("no_steal"," 抓贼啊！ \n");
     }

        setup();
}

int do_open(string arg)
{
               int opening;
        object victim = this_player();
        int gain;

        if (!id(arg))
                return notify_fail("你要打开什么？\n");
               opening = (int)victim->query("openbao");
    if ( opening > 1 ) {
     message_vision(HIY "$N已经拿过一次。\n" NOR, victim); 
                           }
                           else
                           {

        gain=(int)victim->query("combat_exp") / 100;
          victim->set("openbao",10);
        victim->add("combat_exp", gain);
        victim->add("potential",60000);
        victim->add("max_force",100);
        victim->add("max_mana",100);
        victim->save();
        gain=(int)gain / 1000;
 
        message_vision(RED "\n$N打开国庆大礼包……\n\n" NOR, victim);
        message_vision(HIY "\n白蜻蜓突然蹦出来，笑嘻嘻地对$N说：国庆快乐！！\n\n" NOR, victim);
        tell_object(victim,HIW"白蜻蜓"NOR"悄悄说：你得到了"+gain+"年道行! \n");
        tell_object(victim,HIW"白蜻蜓"NOR"悄悄说：你得到了六万点潜能! \n");
         message_vision(RED "\n$N昏厥过去……救护车!!!BEEP……!!!\n\n" NOR, victim); 
     victim->unconcious();              
     return 1;
}
                destruct(this_object());
        return 1;
}








