#include <ansi.h>
#include <dbase.h>
#include <armor.h>
#define MAX_SAVE 1
inherit F_AUTOLOAD;  
inherit ITEM;

void create()

{
     set_name(HIC"魔镜"NOR, ({ "mirror" ,"jingzi","jing" }) );
        set_weight(3000);
        set_max_encumbrance(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "传说中可以复制东西的镜子。\n");
                set("value", 1000);
                set("material", "wood");
                set("no_get",1);
                set("no_drop",1);
                set("amount",30);
        }
        setup();
}


void init()
{
   add_action("do_put", "put");
   add_action("do_get", "get");
   add_action("do_look", "look");
}


int do_put(string arg)
{
    object me=this_player(),ob;
    string msg,obj_file;
    int save_objects,new_one=1,value;
    string from_ob,put_ob;
    if(!arg)return 0;
    sscanf(arg,"%s on %s",put_ob,from_ob);
      if(!put_ob||!from_ob||(from_ob!="mirror"&&from_ob!="jingzi"&&from_ob!="jing"))
         return 0;

      if(me->is_busy())
        {tell_object(this_player(),"放珍贵的东西当然要慢慢来啦！\n");return 1;}  

     ob=present(put_ob,me);
 if(ob) 
    {
	if (!ob->query("armor_prop") && !ob->query("weapon_prop"))
		return notify_fail("这样东西不是装备，你只能复制装备！\n");
/*
	if (ob->query_weight()>15000)
		return notify_fail("这样东西对于保险柜而言太重了。\n");
	if (ob->query("no_drop"))
		return notify_fail("这样东西不能放进保险柜。\n");

        if (ob->query("money_id"))
		return notify_fail("钱财乃身外之物，不必这么小心吧！\n");

	if (ob->query("food_supply"))
		return notify_fail("食物也想放到保险柜里去！？想吃时再去买不行吗？\n");
*/
      save_objects=me->query("mirror/objects");
      if(save_objects>=MAX_SAVE){tell_object(this_player(),"你只能复制"+MAX_SAVE+"个物品！\n");return 1;}
       msg=base_name(ob);
      obj_file="mirror/save"+save_objects;
      me->set(obj_file,msg);
      save_objects=save_objects+1;
      me->set("mirror/objects",save_objects);
      me->start_busy(1);
      message_vision("$N把一"+ob->query("unit")+ob->query("name")+"对着镜子照了照。\n",me);
//        destruct(ob);    
      return 1;
     }
 else {tell_object(this_player(),"你身上没有这样东西！\n");return 1;}
          
}

int do_look(string arg)
{
     int i,total_save; 
    object ob,me=this_player();
      if(arg!="mirror"&&arg!="jingzi"&&arg!="jing")
         return 0;
     tell_object(me,"传说中可以复制东西的镜子。\n");   
      total_save=me->query("mirror/objects"); 
      if(total_save)
     tell_object(me,"里面隐约可以看到：\n");   
     else
     tell_object(me,"里面能看到你自己的大脸。\n");   

        for(i=0;i<total_save;i++)
         {
           ob=new(me->query("mirror/save"+i));
             if(ob)
             tell_object(me,i+"   "+ob->query("name")+"  ("+ob->query("id")+")\n");   
            destruct(ob);
        }
     return 1;
}


int do_get(string arg)
{
    object ob,me=this_player();
 int i,j,total_save,get_ob,max_weight=me->query_max_encumbrance(),now_weight=me->query_encumbrance(); 
    string from_ob;
    if(!arg)return 0;
    sscanf(arg,"%d from %s",get_ob,from_ob);
      if(!from_ob||(from_ob!="mirror"&&from_ob!="jingzi"&&from_ob!="jing"))
         return 0;

      if(me->is_busy())
        {tell_object(this_player(),"拿珍贵的东西当然要慢慢来啦！\n");return 1;}  

      total_save=me->query("mirror/objects"); 
      if(total_save<=0) 
         {
          tell_object(me,"镜子里边什么都没有。\n");      
          return 1;
         }

      if(get_ob>(total_save-1)||get_ob<0)
         {
          tell_object(me,"命令格式： get (物品序号) from mirror\n");      
          return 1;
         }

           ob=new(me->query("mirror/save"+get_ob));
             if(!ob)
         {
         tell_object(me,"这个东西你无论怎样都拿不出来，真奇怪！\n");
         return 1;
         }
           if(ob->query_weight()+now_weight>=max_weight)
         {
         tell_object(me,"这个东西你无论怎样都拿不出来，可能是负重过多了！\n");
         return 1;
         }

      tell_room(environment(me),"你看到"+me->query("name")+"的手居然伸进了镜子，拿出了一"+ob->query("unit")+ob->query("name")+"。\n",me);      
      tell_object(me,"你从镜子中拿出一"+ob->query("unit")+ob->query("name")+"放进怀里。\n",me);      
           ob->move(me);
       for(i=get_ob;i<total_save-1;i++)
         {j=i+1;
         me->set("mirror/save"+i,me->query("mirror/save"+j));     
         }
         me->add("mirror/objects",-1);
      me->start_busy(1);
     return 1;
}


int query_autoload() { return 1; }
