#include <armor.h>
#include <ansi.h>
inherit SHIELD;

void create() {
  set_name(HIY "幽助无敌盾" NOR, ({ "youzhu dun", "dun", "shield" }));
  set_weight(1000);

  set("unit", "件");
  set("value", 2000);
  set("material", "wood");
  set("armor_prop/armor", 200);
  set("armor_prop/dodge", -1);
  set("can_auction", 1);

  set("no_sell", 1);
  set("no_drop", "去垃圾堆丢吧，乱扔会污染环境!\n");
  set("no_give", "管家发的装备，可不能乱送人哟！\n");
  set("no_get", "想拿管家幽助发的装备？没搞错吧!\n");
  setup();
}
