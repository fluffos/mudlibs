#include <ansi.h>
inherit ITEM;

void create()
{
  set_name(HIW"时空传送仪"NOR, ({"trans", "transport"}));
  set_weight(300000);
  set_max_encumbrance (1000000);

    set("short", HIW"时空传送仪"NOR+"(transport)");
    set("long", "一个古怪的仪器，上边有很多灯一闪一闪的。\n");
    set("unit", "个");
    set("material", "metal");
    set("value", 1000000);
    set("no_get",1);
/*
    set("objects", ([
		__DIR__"bxg" : 1,
		__DIR__"mirror" : 1,
    ]));
*/
  setup();
}

int init()
{
  add_action("do_enter", "enter");
  add_action("do_out", "out");
  add_action("do_tran", "tran");
  return 1;
}

int is_in ()
{
  object me = this_object();
  object who = this_player();
  return environment(who) == me; 
}

int do_enter (string arg)
{
  object me = this_object();
  object who = this_player();

  if ((arg != "transport") && (arg != "trans"))
    return 0;
  if (is_in())
    return 0;

  message_vision ("$N打开一道门，钻进了时空传送仪。\n",who);
  who->move(me);
  message_vision ("$N坐上了一个传送舱，绑上了安全带。\n",who);

  return 1;
}

int do_out (string arg)
{
  object me = this_object();
  object who = this_player();

  if (! is_in())
    return 0;

  who->move(environment(me));
  message_vision ("$N打开舱门钻出了时空传送仪。\n",who);
  return 1;
}

int do_tran(string arg)
{
        int goto_inventory = 0;
        object me = this_player();
        object obj, ridee;
        string msg, ridemsg;

        if( !arg ) return notify_fail("你要去哪里？\n");

        if( me->over_encumbranced() )
                   return notify_fail("你负载太重了！\n");

        if( sscanf(arg, "-i %s", arg) ) goto_inventory = 1;

        if( !arg ) return notify_fail("你要去哪里？\n");

        obj = find_player(arg);
        if(!obj) obj = find_living(arg);
       
	if(!obj) obj = LOGIN_D->find_body(arg);
	/* added by mon. 2/23/97 */
	if(!obj) obj = find_object(arg);

	if(!obj || !me->visible(obj)) {
                arg = resolve_path(me->query("cwd"), arg);
                if( !sscanf(arg, "%*s.lpc") ) arg += ".lpc";
                if( !(obj = find_object(arg)) ) {
                        if( file_size(arg)>=0 )
                                return me->move(arg);
                        return notify_fail("没有这个玩家、生物、或地方。\n");
                }
        }

        if(!goto_inventory && environment(obj))
                obj = environment(obj);

        if( !obj ) return notify_fail("这个物件没有环境可以 goto。\n");
        if(is_in()) message_vision("只见机器一阵轰隆隆的爆炸声后，$N的身影已经不见了。\n", me);
        else {
	if( (string)me->query("family/family_name") == "阎罗地府") {
		message_vision(HIB"袍云起处荡乾坤，黑雾阴霾大地昏。江海波翻鱼蟹怕，\n"+
		"山林树折虎狼奔。乌乌压压的黑雾滚滚而来,黑雾散去已不见了$N的身行.....\n\n"NOR, me);
      }
        if( (string)me->query("family/family_name") == "陷空山无底洞" ) {
		message_vision(YEL"$N狂吼一声:“打洞”,漫天的尘土散处,已不见了$N的身影......\n"NOR, me);
        }
        if( (string)me->query("family/family_name") == "月宫") {
        message_vision(HIM"法云容曳舒群岳，教网张罗满太空。检点人生归善念，纷纷天雨落花红。漫天的落花柔柔的落在$N的身上,$N的身影慢慢变淡化去.....\n\n"NOR, me);
        }
	if( (string)me->query("family/family_name") =="五庄观") {
	message_vision(HIW"一天瑞霭光摇曳，五色祥云飞不绝。白鹤声鸣振九皋，紫芝色秀分千叶。鹤声中$N跨鹤而去....\n"NOR, me);
	}
	if( (string)me->query("family/family_name") =="将军府") {
		message_vision(GRN"\n只听$N一声大喝:“八骏九逸何在”,喝声中八骏九逸的蹄声有远来到近前,\n"+
		"$N飞跨而上,绝尘而去,犹自留着那清脆铃声......\n"NOR, me);
	}
	if( (string)me->query("family/family_name") =="东海龙宫") {
		message_vision(WHT"$N身形闪处,早已腾在空中,退了毛皮，换了头角，浑身上长起金鳞，\n"+
		"腮颔下生出银须，一身瑞气，四爪祥云，瞬间消失在云中....\n"NOR, me);
	}
	if( (string)me->query("family/family_name") =="方寸山三星洞") {
		message_vision(HIC"“去时凡骨凡胎重，得道身轻体亦轻;当时过海波难进，今日来回甚易行”,吟唱声中,\n"+
		"$N抽身,捻决,连扯,驾起一朵七彩祥云翻滚而去....\n"NOR, me);
	}
	if( (string)me->query("family/family_name") =="蜀山派") {
		message_vision(HIC"$N嘴唇翕动处,万道霞光冲天而起化成一道剑影,$N飞身跃入其中,剑光化成一道彩虹，遽然消失无影.....\n"NOR, me);
	}
	if( (string)me->query("family/family_name") =="大雪山") {
		message_vision(HIW"$N随手一挥，只见一团雪雾裹住真身，旋转而去....\n"NOR, me);
	}
	if( (string)me->query("family/family_name") =="火云洞") {
		message_vision(HIR"$N捶了两拳，念个咒语，口里喷出火来，鼻子里浓烟迸出，闸闸眼火焰齐生。烟火中$N渐渐远去....\n"NOR, me);
	}
	if( (string)me->query("family/family_name") =="南海普陀山") {
		message_vision(HIY"“南无阿弥陀佛”声中,瑞霭散缤纷，祥光护法身。九霄华汉里,$N纵祥云而去.....\n"NOR, me);
	}
	if( (string)me->query("title/title_name") =="普通百姓") {
		message_vision(BLU"$N仰天大叫:“六丁六甲,诸天神邸送我一程”.一阵阴风吹过,$N消失的无影无踪....\n"NOR, me);
	}        
        }
