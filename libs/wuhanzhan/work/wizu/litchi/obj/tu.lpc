//城市工程图 By LitChi

#include <ansi.h>
inherit ITEM;

//int do_jianzao();
void create() {
  set_name(HIW "城市工程图" NOR, ({ "city tu", "tu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一张建造城市的工程图，可以用(jianzao)命令建造自己的家园！\n");
    set("unit", "张");
    set("value", 0);
    set("no_get", "送人？亏你想的出来！\n");
    set("no_steal", 1);
    set("no_drop", 1);
    //                set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");
    set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
  }
}

void init() {
  add_action("do_jianzao", "jianzao");
}

int save_room_file(string file, string str) {
  string tmp;
  int i;

  //  write ("file name is " + file + "\n");
  if (write_file(file, str, 1)) {
    message_vision(HIW + "$N拿起铁锹，喀嚓喀察一会功夫盖起了一座城堡。" + NOR "\n", this_player());
    this_player()->move(file);
    //    environment(this_player())->set("short",this_player()->query("name")+"城");
    environment(this_player())->save();
    return 1;
  } else {
    write("尝试写入(" + file + ")失败!!\n");
    return 0;
  }
}

int do_jianzao() {
  string *str, code = "\n", file;
  int i, j = 0;

  file = "/d/home/" + this_player()->query("id") + ".lpc";
  str = explode(read_file("/d/beijing.lpc"), "\n");
  for (i = 0; i < sizeof(str); i++) {
    if (i == 4) code += "reload(\"" + this_player()->query("id") + "\");\n";
    else if (i == 5) code += "set (\"short\",\"" + this_player()->query("name") + "城\");";
    else code += str[i] + "\n";
  }
  save_room_file(file, code);
  destruct(this_object());
  return 1;
}
