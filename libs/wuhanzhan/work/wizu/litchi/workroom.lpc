#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "幽助的小屋");
        set("long",@LONG
       
       早就习惯一个人
       少人关心少人问
       就算没人为我付青春
       至少我还保留一份真
       
LONG );
        set("exits", ([
            "west":__DIR__"mj_room",
//            "north":__DIR__"guigui",
            "down"    : "/d/city/kezhan",
            "wiz"  :  "/d/wiz/wizroom",
        ]));
        set("valid_startroom", 1);
        set("sleep_room", 1);
        set("no_clean_up", 1);
        set("item_desc", ([ /* sizeof() == 1 */
  "bed" : "一张看起来很可爱的小床，上面放了一个大狗熊玩具(gosleep,gobed,bed)。 
",
]));
        set("objects", ([
		__DIR__"npc/bigeye" : 1,
	]));
        setup();
//        replace_program(ROOM);
}

void init()
{
	set("no_clean_up", 1);
        add_action("do_bed", "gosleep");
        add_action("do_bed", "gobed", );
        add_action("do_bed", "bed");
}

int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
        me->move(__DIR__"bed");
            message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
                return 1;
}
