/* 手术台 by LitChi */
 
inherit ROOM;

void create()
{
        set("short", "手术台");
        set("long", @LONG

你躺在一个手术台上，四处可见手术后装不回去的内脏。
LONG
        );
        
        set("exits", ([
                "out": "/d/city/hairdressing",
            ]));
        set("no_fight", 1);
        set("no_magic", 1);
        set("sleep_room",1);
        set("if_bed",1);
        set("no_clean_up", 1);
                                              
        setup();
}
