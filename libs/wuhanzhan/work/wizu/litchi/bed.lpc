inherit ROOM;

void create() {
  set("short", "机灵鬼的小床上");
  set("long", @LONG

一张小床,上面有很多玩具，纱衾鸳枕之间散发出一丝丝幽香．
LONG
  );

  set("exits", ([
    "out": __DIR__ "workroom",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("sleep_room", 1);
  set("if_bed", 1);
  set("no_clean_up", 1);

  setup();
}

void init() {
  set("no_clean_up", 1);
}
