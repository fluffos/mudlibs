#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "灵儿的小屋");
        set("long",@LONG
灵儿睡懒觉的地方。
这儿窗户半闭，嗅着透过来的阵阵清香，你觉得有些困倦。一张可爱
的小床(bed)上淡绿色的被褥发出淡淡的香气，睡了吧，你不由的想到。
LONG );
        set("exits", ([
            "down"    : "/d/city/kezhan",
            "wiz"  :  "/d/wiz/wizroom",
        ]));
        set("valid_startroom", 1);
        set("sleep_room", 1);
        set("no_fight", 1);
        set("no_clean_up", 0);
        set("item_desc", ([ /* sizeof() == 1 */
  "bed" : "一张看起来很可爱的小床，上面放了一个大狗熊玩具(gosleep,gobed,bed)。 
",
]));
        setup();
//        replace_program(ROOM);
}

void init()
{
        add_action("do_bed", "gosleep");
        add_action("do_bed", "gobed", );
        add_action("do_bed", "bed");
}

int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
        me->move(__DIR__"bed");
            message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
                return 1;
}