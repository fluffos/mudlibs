#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create()
{
            set_name(HIY"逍遥神剑"NOR, ({"xiaoyao sword", "sword"}));
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "只是一把很普通的长剑，但锋口处闪烁着寒光．\n");
                set("value", 10000);
                set("material", "crimsonsteel");
                set("wield_msg",
    "$N「唰」地一声抽出一把$n握在手中．轻轻的笑了笑.\n");
                set("unwield_msg",
    "$N将手中的$n插入腰间，也许该休息休息了\n");
          set("weapon_prop/cor", 10);
        }
            init_sword(100);
        setup();
}
