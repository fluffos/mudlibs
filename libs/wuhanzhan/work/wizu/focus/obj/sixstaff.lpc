#include <weapon.h>
#include <ansi.h>
inherit STAFF;
void create() {
  set_name(YEL "六环锡杖" NOR, ({ "Six-ring staff", "staff" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "此乃观音力士广布天下之六环锡杖，上面镶著六个铜环，象征佛法无边。\n");
    set("value", 10000);
    set("material", "steel");
    set("wield_msg",
      "$N「唰」地一声抽出一把$n握在手中．刹那间四周一片肃穆，连天地鬼神也为之震动。\n");
    set("unwield_msg",
      "$N放下手中的$n，轻轻的嘘了口气.....\n");
    set("weapon_prop/cor", 10);
  }
  init_staff(110);
  setup();
}
