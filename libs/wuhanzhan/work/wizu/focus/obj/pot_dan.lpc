//by LitChi
#include <ansi.h>

inherit ITEM;

void create()
{
  set_name( "潜能仙丹" , ({"pot dan", "dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗丹药,可以增长你10000点潜能. \n");
    set("value", 0);
    set("no_get", 0);
//    set("no_give", 1);
    set("no_sell", 1);
    set("drug_type", "补品");
  }
  setup();
//  call_out ("becoming_old",1800);
}

void init()
{
	       set("no_get","你手一滑，潜能仙丹又掉了！\n");
     set("no_give","这么好的东西，哪能随便给人？\n");
      set("no_drop","这么好的东西，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
        add_action("do_eat", "eat");
  add_action("do_eat", "eat");
}

int do_eat(string arg)
{
  object me = this_player();
  if (arg!="pot dan" && arg!="dan") 
    return 0;
  me->add("potential",10000);
  message_vision(HIG "$N捏起一颗潜能仙丹送进嘴里吞下。\n" NOR, me);
  tell_object(me, "你感到身体里有一股暖气在流动,但随即就消失了...\n");
  destruct(this_object());
  return 1;
}

