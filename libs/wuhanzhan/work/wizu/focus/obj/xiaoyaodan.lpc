// xiaoyaodan.c 逍遥丹

#include <ansi.h>

inherit ITEM;

void create()
{
            set_name(HIR"逍遥"HIY"丹"NOR, ({ "dan","xiaoyao dan" }) );
        set("long",
HIG"逍遥丹是以如梦幻境的秘方，采集九种珍贵药材，苦心费时三年炼制而成的灵丹。有强身健体上下通气之功效\n"NOR);
        set("unit", "粒");
        set("weight", 5);
        set("value", 100);
}

void init()
{
        set("no_get","你手一松，逍遥丹掉在地上摔得粉碎！\n");
     set("no_give","这么好的东西，哪能随便给人？\n");
      set("no_drop","这么好的东西，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
        add_action("do_eat", "eat");


/*void init()*/

        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
        object ob;
        if( !id(arg) ) return notify_fail("你要吃什麽？\n");

          if( living( this_player())==0) return 0;

          if( living( this_player())==0) return 0;

        ob=this_player(); 
            ob->add("combat_exp",3000);
          ob->add("potential",1000);
           ob->add("balance",200000);
           ob->add("max_force",20);
           ob->add("force",20);
           ob->add("mana",20);
           ob->add("max_mana",20);

write(HIR+"你吃下一颗逍遥丹，只觉得一种神力融入你的体内...\n"NOR);

        message("vision", HIR + ob->name() + 
"吃下一颗逍遥丹，只觉得一种神力融入你的体内...\n"+NOR,
                environment(ob), ob);
        destruct(this_object());
        return 1;
}
