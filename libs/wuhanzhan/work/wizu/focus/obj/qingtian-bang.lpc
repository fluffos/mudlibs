#include <weapon.h>
#include <ansi.h>
inherit STICK;
void create()
{
            set_name(HIC"擎天棒"NOR, ({"qingtian stick", "bang"}));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一棒擎天撑天下\n");
                set("value", 10000);
                set("material", "steel");
                set("wield_msg",
    "$N「唰」地一声抽出一把$n握在手中．在手中掂了掂...\n");
                set("unwield_msg",
    "$N将手中的$n倒手背在身后，轻轻的嘘了口气.....\n");
          set("weapon_prop/cps", 10);
        }
            init_stick(110);
        setup();
}
