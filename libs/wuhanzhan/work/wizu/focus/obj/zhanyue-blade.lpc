#include <weapon.h>
#include <ansi.h>
inherit BLADE;
void create()
{
            set_name(HIW"斩月刀"NOR, ({"zhanyue blade", "blade", "dao"}));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "挥刀斩月，暗月无光\n");
                set("value", 10000);
                set("material", "steel");
                set("wield_msg",
    "$N「唰」地一声抽出一把$n握在手中．月光随之一暗...\n");
                set("unwield_msg",
    "$N将手中的$n迎空一斩，已然入鞘.....\n");
          set("weapon_prop/cps", 10);
        }
            init_blade(110);
        setup();
}
