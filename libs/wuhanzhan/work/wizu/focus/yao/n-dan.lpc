// z-dan.c
// 星星(lywin)炼丹任务附属道具

inherit ITEM;

int do_eat(string arg);

//void setup()
//{}

void create()
{
	set_name("内力丹", ({"force dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("long", "这是一颗内力丹。\n");
		set("value", 15000);
	}
	setup();
}

void init()
{
	if (!wizardp(this_player())) {
	set("no_drop","不能扔...\n");
	set("no_get","不能拿....\n");
	set("no_sell","不能卖....\n");
	set("no_give","不能给.....\n");
        }
        if (this_player() == environment())
          add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	int a;
	if (!id(arg))
	return notify_fail("你要吃什么？\n");
        a=((int)this_player()->query("max_force"))*2-100;
        if ((int)this_player()->query("force") <= 0) 
          return notify_fail("内力大于零的时候才能吃内力丹...\n");
	this_player()->set("force",a);
	message_vision("$N吃下一颗内力丹，只觉得内力充实了 !\n", this_player());
	destruct(this_object());
	return 1;
}

