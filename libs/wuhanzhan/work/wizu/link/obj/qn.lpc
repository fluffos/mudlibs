#include <ansi.h>

inherit ITEM;

int do_eat(string);
void create() {
  set_name(HIC "潜能丸" NOR, ({ "qianneng wan", "wan" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗碧蓝蓝的药。\n");
    set("value", 5000);
    set("no_sell", 1);
  }

  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  message_vision(HIC "$N吃下一颗潜能丸，觉得潜能增加了。\n" CYN, me);

  me->add("potential", 20000);

  destruct(this_object());
  return 1;
}
