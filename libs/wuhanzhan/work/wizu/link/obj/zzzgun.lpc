// zzzgun.c

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIM "睡眠枪" NOR, ({ "sleep gun", "gun" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 0);
    set("material", "steel");
    set("long", "这是一把小叮当用的睡眠枪，可以用来让对方睡觉。\n");
    set("wield_msg", HIM "$N拿起$n。\n" NOR);
    set("unequip_msg", HIM "$N把$n放回口袋。\n" NOR);
  }
  init_sword(100);
  setup();
}

void init() {
  add_action("do_shoot", "shoot");
}

int do_shoot(string arg) {
  object obj, me = this_player();
  object where = environment(me);

  if (!arg)
    return notify_fail("你想让谁睡觉？\n");

  if (!objectp(obj = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!obj->is_character() || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");

  if (obj == me)
    return notify_fail("用 sleep 指令会比较快:P。\n");

  if (obj->query_temp("block_msg/all"))
    return notify_fail("he/she is already asleep..\n");

  message_vision(MAG "\n$N举起睡眠枪，瞄准$n，缓缓扣动了板机。\n" NOR, me, obj);
  message_vision("$N打了两个呵欠。\n", obj);

  if (!where->query("sleep_room")) where->set("sleep_room", 2);
  obj->command("sleep");

  if (where->query("sleep_room") > 1)
    where->delete("sleep_room");

  return 1;

}
