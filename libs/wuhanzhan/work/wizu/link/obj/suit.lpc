#include <mudlib.h>
#include <ansi.h>
#include <armor.h>
#include <command.h>
#define NULL_VALUE 0
inherit CLOTH;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;

void create()
{
       seteuid(getuid());
       set_name(HIW"巫师工作服"NOR,({"wizard suit","suit" }));
       if(clonep())
           set_default_object(__FILE__);
       else{
           set("unit","件");
           set("long","一件银白色的巫师工作服。");
           seteuid(geteuid());
           set("material", "cloth");
           set("armor_prop/armor", 10000);
           set("no_get",1);
           set("no_drop",1);
           }
       setup();
}
int query_autoload()
{
   if (wizardp(this_player())) return 1;
   else return 0;
}
