// medal.c

#include <ansi.h>

inherit ITEM;

int query_autoload()
{
	return 1;
}

void create()
{
	set_name(YEL"隐身徽章" NOR, ({ "invisible medal","medal" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
	      set("long","隐身用的啦。\n");
		set("value", 0);
		set("no_drop",1);
	}
	setup();
}

void init()
{
        add_action("do_wear","wear");
        add_action("do_remove","remove");
}

int do_wear(string arg)
{
	object me;
	
	me = this_player();

	if( !arg || arg!="medal")  return 0;

	if(me->query("env/invisibility")) return notify_fail("you are invisible. \n");

	message_vision(MAG "$N在胸前别上一枚徽章... ...\n" NOR,me);
	me->set("env/invisibility",9);
	me->set("inv",1);
	return 1;
}

int do_remove(string arg)
{
	object me;
	
	me = this_player();
	if( !arg || arg!="medal")  return 0;
	if(!me->query_temp("inv")) return notify_fail("you are not wearing it. \n");
	me->delete("env/invisibility");
	message_vision(MAG "$N将徽章取了下来。\n" NOR,me);
	me->delete("inv");
	return 1;
}