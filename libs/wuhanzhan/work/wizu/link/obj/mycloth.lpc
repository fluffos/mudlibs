// cloth.c


#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name("巫师专用铁布衫", ({ "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1000);
  }
  setup();
}

int wear() {
  if (!environment() || !wizardp(environment()))
    return notify_fail("你没看见是巫师专用的吗？\n");

  return ::wear();
}

int ob_hit(object ob, object me, int damage) {
  object weapon = ob->query_temp("weapon");
  string msg;

  if (weapon) {
    message_vision(RED "$N的" + weapon->name() + "被$n的铁布衫牢牢吸住了。\n" NOR, ob, me);
    weapon->move(me);
  } else {
    message_vision(RED "$N的力量被$n的铁布衫反震了回来，受伤不轻。\n" NOR, ob, me);
    ob->receive_wound("kee", damage > 0 ? damage * 2 : -damage * 2, ob);
  }

  return -100000;
}
