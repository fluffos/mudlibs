#include <ansi.h>
inherit ITEM;
void create() {
  set_name(MAG "五毒珠" NOR, ({ "wudu-zhu" }));
  set("long", RED "这是李逍遥大侠当年用过的五毒珠,可以用来解（ｃｕｒｅ）百毒！NOR \n");
  set("value", 10000);
  set("unit", "颗");
}
void init() {
  if (this_player() == environment()) add_action("do_cure", "cure");
}
int do_cure() {
  object me; me = this_player();
  message_vision(HIR "$N一口将五毒珠吞入腹中!\n" NOR, me);
  me->clear_condition();
  message_vision(HIC "$N只觉腹内一阵清凉直透全身经脉,身中剧毒居然不再发作了!\n" NOR, me);
  destruct(this_object());
  return 1;
}
