#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIC "一份遗书" NOR, ({ "yishu" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "份");
    set("material", "paper");
    set("long", "一份遗书，上面是这样写的：\n"
      "敬爱的老师同学、爸爸妈妈、爷爷奶奶、叔叔阿姨、弟弟妹妹们：\n"
      "	什么都不用说了，永别了！\n"
      "				一位失足少年于2001年2月4日\n");
  }

  setup();
}
