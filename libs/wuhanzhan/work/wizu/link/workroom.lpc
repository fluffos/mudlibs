inherit ROOM;
#include <room.h>
#include <ansi.h>

void create() {
  set("short", HIC "爱后余生的工作室" NOR);
  set("long",

    "这是爱后余生工作学习的地方，屋角有一张电脑桌，上面放着一台Pentium3 866，\n" +
    "靠近窗台放着一张表面被爱后余生写写划划得千沟万壑的木桌和一条木椅，桌的左\n" +
    "首是一盏台灯，右边则凌乱地摆放着几本考试复习资料，可现在都已没有用了。但\n" +
    "因为懒，爱后余生一直不去收拣。中央用铜镇纸压着一幅书法，龙飞凤舞般地写着\n" +
    "六个大字：“天下第一聪明人”。显见主人聪明之极。床边是两个高大的书橱，收\n" +
    "藏了爱后余生爱看的一些书籍，你若有兴趣当巫师，不妨读一读，书橱边是一块留\n" +
    "言版，各位巫师都可以在这里留言发表自己对这间房间和房间主人的看法。这里有\n" +
    HIR "两扇大门:  \n" + NOR
    HIW "        上面通向南城客栈,则下面便是巫师会议厅的入口了。       \n" NOR
  );
  set("exits", ([ /* sizeof() == 1 */
    "up": "/d/city/kezhan",
    "down": "/d/wiz/wizroom",
    "enter": __DIR__ "comment",
  ]));
  set("link_board", "1");
  set("no_time", 1);
  set("no_fight", 1);
  set("no_sleep", 1);
  set("no_magic", 1);
  set("valid_startroom", 1);

  set("no_clean_up", 0);

  call_other("/obj/board/link_board", "???");
  setup();
  replace_program(ROOM);

  create_door("enter", "档案馆", "out", DOOR_CLOSED);

}

int valid_leave(object me, string dir) {
  if (dir == "enter" && !wizardp(me))
    return notify_fail("那里只有巫师才能进去。\n");
  return ::valid_leave(me, dir);
}
