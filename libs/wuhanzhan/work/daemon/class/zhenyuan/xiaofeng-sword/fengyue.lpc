//modify by ken@wh....2004.2.22
// 威力过高,不附加伤害..
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("风起云涌只能对战斗中的对手使用。\n");
        weapon = me->query_temp("weapon");
        if (!weapon) return notify_fail("没拿剑怎么施展绝招？\n");
        if( (string)weapon->query("skill_type") != "sword" )
        return notify_fail("没拿剑怎么施展绝招？\n");
        if((int)me->query("force") < 400 )
                return notify_fail("你的内力不足，小心摔倒了．\n");
        if( (int)me->query_skill("xiaofeng-sword", 1) < 100)
                return notify_fail("你的基本功修为尚不精纯，无法施展这么厉害的武功。\n");
        if( (int)me->query_skill("force", 1) < 100)
                return notify_fail("你的内功火候不到，小心走火入魔了。\n");
        if( (int)me->query_skill("sword", 1) < 100)
                return notify_fail("你的剑法还没学好，还是别乱用为好。\n");
        if( (string)me->query("class") != "xian" )
                return notify_fail("你又不是神仙，怎么会用呢？\n");
        extra = me->query_skill("xiaofeng-sword",1) /20;
        extra += me->query_skill("sword",1) /20;
        me->set_skill("hb-s",extra);
        me->map_skill("sword","hb-s");
        me->reset_action();
        me->add_temp("apply/attack",extra);
        me->add_temp("apply/damage",extra);
        message_vision(HIC"$N使出晓风残月剑中的精髓「风起云涌」，身法陡然加快！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        msg =  HIW "$N的身形转了几转，倏地停住了脚步。\n" NOR;
        message_vision(msg, me, target);
        me->delete_skill("hb-s");
        me->map_skill("sword","xiaofeng-sword");
        me->add_temp("apply/attack",-extra);
        me->add_temp("apply/damage",-extra);
        me->reset_action();
        me->start_busy(3);
        return 1;
}
