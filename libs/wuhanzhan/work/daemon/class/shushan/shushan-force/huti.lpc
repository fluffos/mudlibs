// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;


  skill = me->query_skill("shushan-force", 1);

  if (skill > 900) {
    skill = 900;
  }

  if (target != me)
    return notify_fail("你只能将真元护体加在自己身上。\n");

  if ((int)me->query("force") < skill * 2)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("huti"))
    return notify_fail("你已经在运功中了。\n");

  me->add("force", -skill);
  me->receive_damage("kee", 50);

  message_vision(
    HIR "$N微一凝神，运起蜀山心法，感觉盔甲厚多了。\n" NOR, me);

  me->add_temp("apply/armor", skill / 2);
  me->set_temp("huti", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 5 :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  int skill;
  skill = me->query_skill("shushan-force", 1);
  if (skill > 900) {
    skill = 900;
  }
  if (!me) return;
  me->add_temp("apply/armor", -skill / 2);
  me->delete_temp("huti");
  // mon 3/1/98. move this to after powerup is done.
  tell_object(me, "你的蜀山心法运行完毕，将内力收回丹田。\n");
}
