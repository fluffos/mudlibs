#include <ansi.h>
inherit SSERVER;
int cast(object me, object target) {
  int success_adj, damage_adj;
  success_adj = 160;
  damage_adj = 200;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展酒神？\n");
  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");
  if ((int)me->query_skill("taoism", 1) < 100)
    return notify_fail("你的天师仙法火候不够，哪可能呼唤出「酒神」！\n");
  if (!me->query("shushan/jiushen_master"))
    return notify_fail("你还不会「酒神」这种法术！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");
  me->receive_damage("sen", 50);
  if (random(me->query("max_mana")) < 50) {
    write("你一着急竟然忘了咒语。\n");
    return 1;
  }
  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    success_adj,
    //success adjustment
    damage_adj,
    //damage adjustment
    "qi",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "\n$N情急之下使出了蜀山绝技——“酒神”。\n" NOR,
    //initial message
    HIR "\n$n被酒神砸中，看来是活不成了。\n" NOR,
    //success message
    YEL "结果$n灵机一动躲了过去。\n" NOR,
    //fail message
    HIC "但是$n以法术相抵，酒神居然砸向$N！\n" NOR,
    //backfire initial message
    HIR "\n$n被酒神砸中，看来是活不成了。\n" NOR,
    //backfire hit message. note here $N and $n!!!
  );
  me->set("mana", 0);
  me->start_busy(1 + random(2));
  return 3 + random(5);
}
