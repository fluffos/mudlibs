#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        int extra = me->query_skill("mindsword",1);
        object weapon;
        string msg;
        if( !target ) target = offensive_target(me);
        if( !target
        ||   !target->is_character()
        ||   !me->is_fighting(target) )
                return notify_fail(HIC"［再续未了缘］"NOR"只能对战斗中的对手使用。\n");
        if ( extra < 300)
                return notify_fail("你的心剑还不够纯熟！\n"); 
        if ((int)me->query("force")<3000) 
                return notify_fail("你的内力不够。\n"); 
        if(me->query("family/family_name")!="蜀山剑派")
                return notify_fail("你是从哪里偷学的这个绝招?\n");  
        if( me->query_skill_mapped("force") != "shushan-force")
                return notify_fail("你必须配合蜀山心法！\n");
        weapon = me->query_temp("weapon");
        message_vision(HIM"$N想起今生的经历，不由得叹了口气，手中的"+weapon->name()+HIM"向$n连攻四剑！\n\n" NOR,me,target);  
                me->add_temp("apply/damage",extra/2);
                me->add_temp("apply/attack",extra);
                message_vision(HIG"不识情恨枉少年\n" NOR,me,target);
                COMBAT_D->do_attack(me,target, weapon);
                message_vision(HIG"\n\n檐下赐酒结仙缘。\n\n" NOR,me,target);
                COMBAT_D->do_attack(me,target, weapon);
                message_vision(HIR"\n\n今生情尽空悲切。\n\n" NOR,me,target);
                COMBAT_D->do_attack(me,target, weapon);
                message_vision(HIW"\n\n来世再续未了缘。\n\n" NOR,me,target);
                COMBAT_D->do_attack(me,target, weapon);
                me->add_temp("apply/damage",-extra/2);
                me->add_temp("apply/attack",-extra);
                me->start_busy(3+random(2));
        return 1;
}
