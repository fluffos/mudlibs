#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int addon, tmp;
  object weapon;
  extra = me->query_skill("mindsword", 1);
  if (extra < 300) return notify_fail("你的心剑还不够纯熟！\n");
  if (me->query_temp("no_huixin")) return notify_fail("绝招用的太多太滥就不灵了。\n");
  tmp = me->query_skill("shushan-force", 1);
  if (tmp < 300) return notify_fail("你的蜀山心法等级太低！\n");
  if ((int)me->query("force") < 2000)
    return notify_fail("你的真气不够！\n");
  if (me->query("family/family_name") != "蜀山剑派")
    return notify_fail("你不是蜀山弟子，不能用这招。\n");
  if (me->query_skill_mapped("force") != "shushan-force")
    return notify_fail("你必须配合蜀山心法！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIW "「会心一击」" NOR "只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  me->add_temp("apply/damage", extra);
  me->add_temp("apply/attack", tmp * 3 / 2);
  message_vision(HIW "\n$N手中$n" HIW "一晃，将全身潜力发挥的淋漓尽致！！\n" NOR, me, weapon);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->add_temp("apply/damage", -extra);
  me->add_temp("apply/attack", -tmp * 3 / 2);
  me->add("force", -300);
  me->start_busy(2);
  me->set_temp("no_huixin", 1);
  call_out("remove_effect", 3 + random(6), me);
  return 1;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("no_huixin");
}
