#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int addon, tmp;
  object weapon;
  extra = me->query_skill("yujianshu", 1);
  if (extra < 100) return notify_fail("你的剑法还不够纯熟！\n");
  if (me->query_temp("no_huixin")) return notify_fail("绝招用的太多太滥就不灵了。\n");
  tmp = me->query_skill("shushan-force", 1);
  if (tmp < 100) return notify_fail("你的蜀山心法等级太低！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的真气不够！\n");
  if (me->query("family/family_name") != "蜀山剑派")
    return notify_fail("你不是蜀山弟子，不能用这招。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIC "「御剑」" NOR "只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  me->add_temp("apply/damage", extra / 2);
  me->add_temp("apply/attack", tmp);
  message_vision(HIW "\n$N念声口诀，$n" HIW "飞出剑鞘，正是蜀山绝技「御剑术」！！\n" NOR, me, weapon);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->add_temp("apply/damage", -extra / 2);
  me->add_temp("apply/attack", -tmp);
  me->add("force", -100);
  me->set_temp("no_huixin", 1);
  call_out("remove_effect", 2 + random(4), me);
  return 1;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("no_huixin");
}
