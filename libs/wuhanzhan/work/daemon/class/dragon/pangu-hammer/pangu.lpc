#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  object weapon, ob;
  int j, skill, sk1;
  string msg;
  weapon = me->query_temp("weapon");

  if (me->query("family/family_name") != "东海龙宫")
    return notify_fail("你不是龙宫弟子，不能用这招。\n");


  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用这一招「盘古九式」。\n");

  if (!me->is_fighting())
    return notify_fail("「盘古九式」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "hammer")
    return notify_fail("「盘古九式」必须用锤才能施展。\n");

  if ((int)me->query_skill("pangu-hammer", 1) < 280)
    return notify_fail("你的「盘古九式」不够娴熟，不会使用「盘古九式」。\n");

  if ((int)me->query_skill("dragonforce", 1) < 280)
    return notify_fail("你的「龙神心法」不够娴熟，还不能体会「盘古九式」的奥妙。\n");

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不够。\n");
  if (target->query_temp("jldl")) {
    target->delete_temp("jldl");
    target->set_temp("jldl_end", time());
    message_vision(HIR "$N运起盘古九式，面对强大的气劲，$n的借力打力也失去了作用！\n\n\n" NOR, me, target);
  }
  skill = me->query_skill("pangu-hammer", 1) + me->query_skill("dragonforce", 1);
  sk1 = (int)me->query("level") * 70 + skill;
  target->start_busy(1);
  target->add_temp("apply/dodge", -skill * 2);
  target->add_temp("apply/parry", -skill * 2);
  msg = HIG "$N跳至空中，手中的$n" + HIG "好似" + HIY "盘龙出沧海" + HIG "顿时化作无数条影子。\n" NOR;
  message_vision(msg, me, weapon);
  message_vision(
    HIC "\n$N运足精神，身形一转使出龙宫绝学" HIW "「盘古九式」" NOR + HIC "霹雳间连续向$n攻出了八招！\n" NOR,
    me,
    target
  );
  me->add_temp("apply/attack", sk1);
  //           me->add_temp("apply/damage",sk1);
  me->add_temp("apply/damage", sk1 * 4 / 5);
  for (j = 1; j <= 9; j++) {
    msg = HIR "满天龙影中，$N砸出第" + HIY + chinese_number(j) + HIR + "锤。\n" NOR;
    message_vision(msg, me, weapon);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  }
  me->set_temp("pl_end", time());
  me->start_busy(1);
  me->add("force", -200);
  me->add_temp("apply/attack", -sk1);
  //     me->add_temp("apply/damage",-sk1);
  me->add_temp("apply/damage", -sk1 * 4 / 5);
  target->add_temp("apply/parry", skill * 2);
  target->add_temp("apply/dodge", skill * 2);
  return 1;
}
