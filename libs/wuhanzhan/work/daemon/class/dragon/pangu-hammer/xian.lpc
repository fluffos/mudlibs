// xian.c  云龙三现

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
        object weapon;
        int damage =0, dragon;
        int myhammer,defend;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("云龙三现只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "hammer")
                return notify_fail("你使用的武器不对。\n");
             
        if( (int)me->query_skill("pangu-hammer", 1) < 150 )
                return notify_fail("你的盘古锤法不够娴熟，不会使用「云龙三现」。\n");
                                
        if( (int)me->query_skill("dragonforce", 1) < 150 )
                return notify_fail("你的龙神心法不够高，不能用来反震伤敌。\n");
                        
        if( (int)me->query("force", 1) < 800 )
                return notify_fail("你现在内力太弱，不能使用「云龙三现」。\n");

       if( time()-(int)me->query_temp("lianji_end") < 4 
                   && me->query_temp("lianji2_end") < 4 
                   && me->query_temp("lianji3_end") < 4 
                   && me->query_temp("lianji4_end") < 4 
                   && me->query_temp("lianji5_end") < 4 )
               return notify_fail("你刚刚出手，没有那么快再次出手。\n");

                        
        msg = CYN "$N仰天狂啸，猛吸一口气,欲以气驭锤攻击$n。\n"NOR;

        if( !target->is_killing(me) ) target->kill_ob(me);

        if (random(me->query_skill("dragonforce", 1)) > target->query_skill("force", 1)/4)
        {
//                target->start_busy(1);
                
                damage += (int)me->query_skill("pangu-hammer", 1);
                damage = damage +  (int)me->query_skill("dragonforce", 1);
                damage = damage +  (int)me->query_skill("dragonfight", 1);
                
                  if (damage < 600) {
                        dragon = 1;
                   } else if (damage < 900) {
                        damage = damage/3*4;
                        dragon = 2;
                   } else {
                        damage = damage/5*8;
                        dragon = 3;
                   }                    
                
                defend = random((int)target->query_temp("apply/armor_vs_force", 1));
                damage -= defend;
                if (damage < 0) damage = 1;
                if (damage >= target->query("max_kee")) damage = target->query("max_kee")-1;
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/3);
                me->add("force", -300);
                msg += HIR"只见$N手中锤光幻作"+chinese_number(dragon)+"条金龙,腾空而起,倏的罩向$n,\n$n只觉一股大力铺天盖地般压来,登时眼前一花，两耳轰鸣,哇的喷出一口鲜血！！\n"NOR;
                me->start_busy(1);
        } else 
        {
                msg += CYN"可是$p猛地向前一跃,跳出了$P的攻击范围。\n"NOR;
                me->add("force", -150);
                me->start_busy(1+random(2));
        }

        message_vision(msg, me, target);
        if (damage > 0) COMBAT_D->report_status(target);
        seteuid(getuid());
        if( userp(me) && userp(target) ) log_file("death", sprintf("%s(%s) perform xian at %s.\n", me->name(1), geteuid(me), ctime(time()) ) );
        return 1;
}
