// 右拳
// code by icejia

#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage, ap, dp;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招" HIR "「右手拳」" NOR "？\n");

  if (!me->is_fighting())
    return notify_fail("" HIR "「右手拳」" NOR "只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 1200)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 1200)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("kee") < 150)
    return notify_fail("你的气血不足！\n");

  if (time() - (int)me->query_temp("lianji_end") < 4)
    return notify_fail("你刚刚出手，没有那么快再次出手。\n");
  if (time() - (int)me->query_temp("lianji2_end") < 4)
    return notify_fail("你刚刚出手，没有那么快再次出手。\n");
  if (time() - (int)me->query_temp("lianji3_end") < 4)
    return notify_fail("你刚刚出手，没有那么快再次出手。\n");
  if (time() - (int)me->query_temp("lianji4_end") < 4)
    return notify_fail("你刚刚出手，没有那么快再次出手。\n");
  if (time() - (int)me->query_temp("lianji5_end") < 4)
    return notify_fail("你刚刚出手，没有那么快再次出手。\n");
  if ((int)me->query("sen") < 400)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("dragonfight", 1) < 200)
    return notify_fail("你的龙型搏击级别还不够！\n");

  if (!PFM_D->valid_family(me, "天王府"))
    return notify_fail("你不是龙宫弟子，不能用这招。\n");


  me->add("force", -100 - (int)me->query("force_factor"));
  me->receive_damage("kee", 150);

  msg = HIR "\n$N找寻$n的一个破绽迈步上前甩出了一记右拳。\n" NOR;

  ap = me->query_skill("dragonfight") + me->query_skill("unarmed");
  ap = (ap * ap / (2 * 100)) + (int)me->query("kee");
  ap = ap * 50 + (int)me->query("combat_exp");
  dp = target->query_skill("parry") + target->query_skill("dodge");
  dp = (dp * dp / (2 * 100)) + (int)target->query("kee");
  dp = dp * 50 + target->query("combat_exp");
  if (ap + random(dp) > dp) {
    damage = (int)me->query("max_force") / 10 + random((int)me->query("eff_kee") / 5);
    damage -= (int)target->query("max_force") / 10 + random((int)target->query("eff_kee") / 5);
    damage += (int)me->query("force_factor") - random((int)target->query("force_factor"));

    damage += 1000;
    if (damage > 0) {
      msg += HIR "只见$N右拳结结实实的打在$n的昨脸颊上！$n吐出一口鲜血。\n" NOR;
      damage += random((damage * (int)me->query_skill("unarmed")) / 160);
      target->receive_damage("sen", damage / 3, me);
      target->receive_wound("sen", damage / 8, me);
      target->receive_damage("kee", damage / 3, me);
      target->receive_wound("kee", damage / 6, me);
      target->start_busy(2 + random(1));
      me->improve_skill("dragonfight", 1, 1);
      me->set_temp("lianji_end", time());
    } else {
      msg += HIW "$n嘲笑着说：未免太慢了吧。\n" NOR;

      me->improve_skill("dragonfight", 1, 1);
    }
  } else
    msg += HIY "$n情急之下向后猛退，避开了这致命一击。\n" NOR;

  message_vision(msg, me, target);
  if (damage > 0) COMBAT_D->report_status(target);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(random(1));
  return 1;
}
