//light.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  success_adj = 100;
  damage_adj = 100;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对使用闪电咒？\n");

  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 10)
    return notify_fail("你现在神智不清，小心触电！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->add("force", -100);
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50) {
    write("这一次好像不灵。\n");
    return 1;
  }

  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    success_adj,
    //success adjustment
    damage_adj,
    //damage adjustment
    "both",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIR "$N口中念了句咒文，半空突然出现一道闪电直击$n的头顶！\n" NOR,
    //initial message
    HIR "结果「嗤」地一声，闪电从$n身上透体而过，$n的全身被电的焦烂！\n" NOR,
    //success message
    HIC "但是$n轻轻一跳就躲了开来。\n" NOR,
    //fail message
    HIR "结果闪电被$n以法力反激，反而射向了$N！\n" NOR,
    //backfire initial message
    HIR "结果$n被电的焦头烂额！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  me->start_busy(1 + random(2));
  return 3 + random(5);
}
