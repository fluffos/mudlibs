// sorry 借用npc写的cast

// Create by npc 99.5.17

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        string msg;
        int count;
  if( !target ) target = offensive_target(me);

   if( !target
   ||   !target->is_character()
   ||   target->is_corpse()
   ||   target==me)
     return notify_fail("你要对谁施用[羽舞飞符]？\n");

   if((int)me->query_skill("bashishentong", 1) < 150 )
     return notify_fail("你的八识神通修为不精，不能施用此法！\n");

   if((int)me->query("mana") < 25+(int)me->query("mana_factor") )
     return notify_fail("你的法力不够，无法神情专注！\n");

   if((int)me->query("force") < 1500 )
     return notify_fail("你的内力不够，无法舞动身体。\n");

   if((int)me->query("sen") < 100 )
     return notify_fail("你现在神智不清，别伤着自己了！\n");

   me->add("mana", -250-(int)me->query("mana_factor"));
   me->add("force", -10);
   me->receive_damage("sen", 10);

   if( random(me->query("max_mana")) < 50 ) 
   {
     write("你口中念念有词。。。但什么也没发生！\n");
     return 1;
   }

        msg = HIY "$N突然低头不语神情如火施出「羽舞飞符」，身法陡然加快！\n" NOR;

        message_vision(msg, me);
        count = (int)me->query_skill("bashishentong") / 20 + 2;
               target->start_busy(2+random(2));
  if( count > 10 ) count = 10;
        while( count-- ) {
                object ob;
                ob = me->select_opponent();
                if( !ob || (environment(ob) != environment(me))) {
                        message_vision(CYN "$N的身形转了几转，倏地停住了脚步。\n" NOR, me);
                        break;
                } else
                        message_vision(CYN "$N迅捷无伦地在$n身旁绕了一圈 ...\n" NOR, me, ob);

                if( !COMBAT_D->fight(me, ob) )
                        message_vision(CYN "但是$N找不到机会出手！\n" NOR, me);
                me->receive_damage("kee", 10);
                me->add("force", -10);
        }


          me->start_busy(6+random(1));
        return 1;
}
