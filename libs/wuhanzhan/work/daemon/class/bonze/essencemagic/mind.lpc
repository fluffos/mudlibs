// copy bye npc'system ..ken

#include <ansi.h>

int cast(object me, object target)
{
   int mymana=me->query("mana"), cost=200, cure;
   string msg;

   if(me->is_busy())
     return notify_fail("你正忙着呢！\n");
   if(me->query("family/family_name") != "将军府"
   || me->query_skill("bashishentong", 1) < 120)
     return notify_fail("你的八识神通还不够高深。\n");

        if( mymana < cost*2 )
                return notify_fail("你的法力不够。\n");

   if (cost<mymana/2) cost=mymana/2-1;
        if( (int)me->query("eff_sen") < (int)me->query("max_sen") / 2 )
     cost=cost*2;

   cure=me->query("max_sen")-me->query("eff_sen");
   cure=cure/2;

   if(!me->is_fighting())
   {
     cost=cost/2;
     msg=HIY"$N闭目凝神，印堂发出一道金芒罩住$N的全身...\n"NOR,
     me->start_busy(random(8-me->query_kar()/5));
   }
   else
   {
     msg=HIY"$N脸色由红立刻变成了冰白色。只见汗珠倒流，$N整个人犹如冰人一般！\n"NOR;
     me->start_busy(1);
   }
        me->receive_curing("sen", cure);
        me->add("mana", -cost);
   message_vision(msg, me);
        return 1;
}
