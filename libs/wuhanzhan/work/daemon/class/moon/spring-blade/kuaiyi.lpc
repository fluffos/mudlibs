#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string dodskill, msg;
  int extra;
  int addon, tmp, atk;
  object weapon;
  extra = me->query_skill("spring-blade", 1);
  if (extra < 250) return notify_fail("你的春风快意刀法还不够纯熟！\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "moondance")
    return notify_fail("快意刀需要冷月凝香舞的配合！\n");
  addon = me->query_skill("moondance", 1);
  if (addon < 250) return notify_fail("你的冷月凝香舞还不够纯熟！\n");
  tmp = me->query_skill("moonforce", 1);
  if (tmp < 250) return notify_fail("你的圆月心法造诣不足！\n");
  if ((int)me->query("force") < 2000)
    return notify_fail("你的真气不够！\n");

  if (me->query("family/family_name") != "月宫")
    return notify_fail("你不是月宫妹妹弟子，这快意春⊙夏⊙秋⊙冬的奥义似乎难以运用！\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「快意春⊙夏⊙秋⊙冬」只能对战斗中的对手使用。\n");

  atk = (addon + tmp) / 2;
  me->add_temp("apply/attack", atk);
  me->add_temp("apply/damage", extra);
  weapon = me->query_temp("weapon");
  message_vision(HIM "\n$N手中快意刀舞了圆圈，身行飞舞,漫天的花瓣伴随,自上而下撒落！！\n" NOR, me, target);
  message_vision(HIG "春之恋---$N手中快意刀在桃花片中使出春恋！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIB "夏之吻---$N手中快意刀在荷花片中使出夏吻！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIY "秋之痕---$N手中快意刀在菊花片中使出秋痕！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIW "冬之雪---$N手中快意刀在梅花片中使出冬雪！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIM "$N自空中回落地面，地上到处撒落着花瓣,香意浓浓！\n" NOR, me, target);
  me->add_temp("apply/attack", -atk);
  me->add_temp("apply/damage", -extra);
  me->add("force", -440);
  me->start_busy(2 + random(2));
  return 1;
}
