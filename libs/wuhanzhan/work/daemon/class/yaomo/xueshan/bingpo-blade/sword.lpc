#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        int skill, skill1, skill2;
        int addon, tmp;
        object weapon1, weapon2;

        addon = me->query_skill("bingpo-blade",1);
        tmp = me->query_skill("bainiao-jian",1);
        if(!target) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「刀光剑影」？\n");

        if(!me->is_fighting())
                return notify_fail("你要对谁施展这一招「刀光剑影」？\n");

        if(!target->is_fighting(me))
                return notify_fail("你要对谁施展这一招「刀光剑影」？\n");

        if((int)me->query("max_force") < 2100)
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 2100 )
                return notify_fail("你的内力不足！\n");
        if(me->query("family/family_name") != "大雪山")
                return notify_fail("你还没学会刀光剑影！\n");
        if((int)me->query_skill("bainiao-jian",1) < 180)
                return notify_fail("你的百鸟剑法级别还不够，使用这一招会有困难!\n");
        if((int)me->query_skill("bingpo-blade",1) < 180)
                return notify_fail("你的冰魄刀法级别还不够，使用这一招会有困难!\n");
        weapon1=me->query_temp("weapon");
         weapon2=present("sword", me);
        if(!objectp(weapon2)) 
                return notify_fail("没剑怎么用刀光剑影？\n");

        me->add_temp("apply/damage",addon/2);
        me->add_temp("apply/attack",tmp);
        message_vision(HIC"\n$N抖擞精神，顺手劈出三刀!\n"NOR, me, target);
        message_vision(HIW"\n雪山春晓－－$N纵身跃起，直上青天，手中"+weapon1->name()+""+HIW"大力劈出，自上而下攻向$n！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon1);
        message_vision(HIW"\n余音袅袅－－$N心神合一，刀力自手中"+weapon1->name()+""+HIW"呼啸而出，狂奔$n！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon1);
        message_vision(HIW"\n声景交融－－$N暴喝一声，手中"+weapon1->name()+""+HIW"圈转，啸音反强，刀光啸音浑然一体，滚向$n！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon1);

        weapon1->unequip();
        weapon2->wield();

        message_vision(HIC"\n趁着$n正忙于招架，$N抽出"+weapon2->query("name")+"刺出两剑"NOR,me, target);
        message_vision(HIG"\n灭剑－－$N舒臂轻弹手中"+weapon2->name()+""+HIG"，直刺$n！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon2);
        message_vision(HIG"\n绝剑－－$N手中"+weapon2->name()+""+HIG"化做流云，飘向$n！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, weapon2);
        me->add("force", -350);
        me->add_temp("apply/damage",-addon/2);
        me->add_temp("apply/attack",-tmp);
        weapon2->unequip();
        weapon1->wield();
        me->start_busy(3);
        return 1;
}
