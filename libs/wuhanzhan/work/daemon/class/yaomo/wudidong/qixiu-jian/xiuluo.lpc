// 修罗意
// lol 05/22/2002

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon, ob;
	int damage, lvl, times;
        string msg;
        	
        
        if( !target ) target = offensive_target(me);
        if( !target 
	  || !target->is_character()
	  || target->is_corpse()
	  || !me->is_fighting(target)	
	  || target==me)
          	return notify_fail("你要攻击谁？\n");
 
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
		
        if( (int)me->query("force") < 500 )
                return notify_fail("你的真气不够！\n");

        if( (int)me->query_skill("qixiu-jian",1) < 180 )
                return notify_fail("你的七修剑法火候不够，无法运用"HIC"「修罗意」"NOR"的技巧！
\n");

        if( (int)me->query_skill("huntian-qigong",1) < 180  
	    || me->query_skill_mapped("force") != "huntian-qigong" )
                return notify_fail("你的内功修为不够，"HIC"「修罗意」"NOR"无法正常运用！\n");
                
        if(me->query("family/family_name")!="陷空山无底洞")
                return notify_fail(HIC"「修罗意」"NOR"的奥妙只有妖魔才可能领悟！\n");

        msg = HIR "$N"HIG"摈弃杂念，在绝境中领悟到了"HIW"「七修剑」"HIG"的最高秘技----"HIC"「修罗
意」！\n" NOR;
        msg += HIR "$N"HIG"的身躯被一阵黑气笼罩，面目也变得狰狞起来，"HIR"$N"HIG"狂嘶一声，手中的剑在"HIC"「修罗意」"HIG"的驱使之下，突破了自身的物理极限，爆出一蓬绚目的剑光，将$n裹入其中！！\n" NOR;
    
        times = me->query("performuse/qixiu", 1);
	lvl = me->query_temp("yuan");
	damage = me->query_skill("qixiu-jian", 1)+me->query_skill("huntian-qigong", 1)+me->query_temp("apply/damage", 1);
        damage += me->query("force_factor");
        damage += times;
        if (lvl) {
	damage += (int)me->query("mana_factor", 1)*lvl;
	msg += HIG "$N"HIY"成功地将"HIR"[圆]"HIY"所蕴藏的能量借助手中的宝剑爆发出来！\n" NOR;
        msg += HIW "白色的剑芒中隐隐有黑色的闪电跳动！！\n" NOR;}
        damage -= target->query_temp("apply/armor_vs_force", 1);

	if (damage > 0) {
	msg += HIR "$n"HIG"被四周空间中充斥的巨大邪意麻痹了躯体，眼睁睁地看着自己被对方刺穿！！\n" NOR;   
	target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage/3, me);
	if (random (10) > 8 && times < (int) me->query_skill("qixiu-jian", 1)) me->add("performuse/xiuluo", 1);
	} else {
	msg += HIR "$n"HIW"眼见无法躲避，运起护身真气硬是接下了这一击！！\n" NOR;}

        message_vision(msg, me, target);
	if( damage > 0 ) COMBAT_D->report_status(target);
        
        if( !target->is_fighting(me) ) {
              if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
            }

	me->add("force", -300);
        me->start_busy(2);
        return 1;
}
