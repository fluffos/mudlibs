// yaomo.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        int success_adj, damage_adj, enchant;

        success_adj = 100;
        damage_adj = 100;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展天魔噬魂？\n");

        if((int)me->query_skill("yaofa",1) < 50 )
                return notify_fail("你的妖法修为太差了！\n");
        
        if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 100 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -25-2*(int)me->query("mana_factor"));
        me->receive_damage("sen", 50);

        if( random(me->query("max_mana")) < 50 ) {
                write("天魔去约会了，等下次吧。\n");
                return 1;
        }
        
        enchant = me->query_temp("yuan");
        if(enchant) {success_adj += success_adj+5*enchant;
        damage_adj += 15*enchant;}
        

        SPELL_D->attacking_cast(
                me, 
                        //attacker 
                target, 
                        //target
                success_adj,    
                        //success adjustment
                damage_adj,     
                        //damage adjustment
                "qi",           
                        //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
                HIC "$N口中念了几句咒语，半空中闪出天魔尊者，只见\n他双手食指一搭，一道黑光从指间飞射向$n！\n\n" NOR,
                        //initial message
                HIR "结果魔光从$n身上对穿而出，鲜血溅的满地！\n" NOR,
                        //success message
                HIC "但是被$n躲开了。\n" NOR, 
                        //fail message
                HIC "结果黑光被$n以法力反激，反而射中了$N！\n" NOR,
                        //backfire initial message
                HIR "结果黑光从$n胸口一穿而过，$n被烧的不成人形！\n" NOR
                        //backfire hit message. note here $N and $n!!!
        );

        me->start_busy(1+random(2));
 /*       me->add_temp("yuan_use", 1);
        if (me->query_temp("yuan_use") >= enchant*5 && me->query_temp("yuan")) {me->set_temp("yuan", 0);
            me->set_temp("yuan_use", 0);
            write("你觉得心里空荡荡的，聚集在身体四周的法力逐渐消失了。\n");}*/
        return 3+random(5);
}

