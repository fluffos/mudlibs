//lol 02/04/11

#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{	
	int times = me->query_temp("yuan");
	string msg;			

	if(me->query("family/family_name")!="陷空山无底洞")
		return notify_fail(HIR"[圆]"NOR"的奥妙只有鼠类才可能领悟！\n");
	if( me->is_fight() )
		return notify_fail("你还在战斗，现在不是运用"HIR"[圆]"NOR"的时候！\n");
	if( me->busy() )	
	        return notify_fail("你正忙着呢，没有时间来运用"HIR"[圆]"NOR"！\n");
	if( me->is_ghost() )
		return notify_fail("你已经是鬼了，还要干什么？\n");
	if( me->query_skill("yaofa",1) < 100+times*100 )
		return notify_fail("你的妖法修为不足，无法运用"HIR"[绝]"NOR"的技巧！\n");
	if( (int)me->query("combat_exp") < 200000 )
		return notify_fail("你的道行不够，无法领悟"HIR"[圆]"NOR"的奥妙。\n");
	if( (int)me->query("mana") - (int)me->query("max_mana") < 400)
		return notify_fail("你的神通不够！\n");
	if( (int)me->query("sen") < 600)
		return notify_fail("你的精神状态不佳，不要勉强自己！\n");	
        if( (time()-me->query("yuan_time"))<360 )
		return notify_fail(HIR"[圆]"NOR"对身体的消耗很大，最好不要连续使用。 \n");
	if( times >= 3 )
		return notify_fail("你已经将"HIR"[圆]"NOR"的功能发挥到极致了！\n");	
		
        me->add_temp("yuan", 1);
        times = times+1;
	if( times >= 3 ) times = 3;
	me->set("yuan_time",time());
        me->receive_damage("sen", 150*times);
	me->add("mana", -200*times);
	msg = HIW"$N面部肌肉扭曲，挣扎着将双手交错，搭在自己的肩膀上，一道道黑色的流质从$N的指尖逸出。\n"NOR, me;
	        
	switch(times)   {
    		case 1:	
   		msg+=RED"淡淡的黑色气流将$N的身体笼罩住了！\n"NOR;
   		break;
    		case 2:
    		msg+=BLU"豆大的汗珠从$N的额头滴下，笼罩着$N的黑色气流越发明显，并且随着主人的呼吸起伏着。\n"NOR;
    		break;
    		case 3:
    		msg+=HIY"妖法中最玄妙的"HIR"[圆]"HIY"终于被$N施展到了最高层！\n"NOR;
    		msg+=MAG"黑色气流诡异地闪了数闪，逐渐消失了，但$N身际却散发出强大至难以置信的气息！！\n"NOR;
    		break;
	}  
	message_vision(msg, me, target);
	
  	return 2+random(2);
}
