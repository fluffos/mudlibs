//modify by ken@wh....2003.7.12
// 威力过高,不附加伤害..
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("你要打谁？\n");
        weapon = me->query_temp("weapon");
        if (!weapon) return notify_fail("拿了武器再用吧！\n");
        if( (string)weapon->query("skill_type") != "stick" )
        return notify_fail("没棒子怎么用大力四连打？！\n");
        if((int)me->query("force") < 300 )
                return notify_fail("你的内力不足了！\n");
        if( (string)me->query("class") != "yaomo" )
                return notify_fail("你又不是火云弟子，还不懂大力棒的用法.\n");
        if( (int)me->query_skill("dali-bang", 1) < 100)
                return notify_fail("你的棍法修为尚不精纯，无法施展这么厉害的武功。\n");
        if( (int)me->query_skill("force", 1) < 100)
                return notify_fail("你的内功火候不到，小心走火入魔了。\n");
        if( (int)me->query_skill("stick", 1) < 100)
                return notify_fail("你的棍法修行尚浅，还是别乱用为好。\n");
        extra = me->query_skill("stick",1) / 5;
        extra += me->query_skill("dali-bang",1) /5;
        me->set_skill("dali",extra);
        me->map_skill("stick","dali");
        me->reset_action();
        message_vision(HIC "$N运起＂大力四连杀＂手中的"+ weapon->name() +"发疯似的向$n砸去！
\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        msg =  HIC "$N狂笑道：也叫你尝尝大力棒法的厉害！\n" NOR;
        message_vision(msg, me, target);
        me->delete_skill("dali");
        me->map_skill("stick","dali-bang");
        me->reset_action();
        me->start_busy(1+random(2));
        return 1;
}
