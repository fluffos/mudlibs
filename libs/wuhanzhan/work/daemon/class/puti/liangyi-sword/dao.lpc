//created by lol 04/26/2002

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        object weapon;
        int mypot,tapot,delay;
        if(!target ) target = offensive_target(me);
        
        if(!target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIG"[道法自然]"NOR"只能对战斗中的对手使用。\n");
       
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
        	return notify_fail("你手中无剑，如何使用"HIG"[道法自然]"NOR"？！\n");
        
        if (me->query_skill("liangyi-sword", 1) < 80 )
        	return notify_fail("你对两仪剑法的领悟还不够。\n");
        	
        if (me->query("force") < 500) return notify_fail("你的内力太少了。\n");
       
        if (target->is_busy() )
                return notify_fail(target->name() + "已经无法还手，放胆攻击吧。\n");

	delay = (int)me->query_skill("liangyi-sword") / 40 + (int)me->query_skill("wuxiangforce") / 40;
        if (delay < 4 ) delay = 4;
        if (delay > 10) delay = 10; 
        if (me->query("family/family_name") != "方寸山三星洞") delay = delay/2;
        
        msg = HIY "\n$N双手将手中长剑缓缓举过头顶，内力全力运转之下，一团流光四逸的气旋在剑尖凝聚。\n"NOR;
        msg += HIY "$N将剑身轻轻向上一送，气旋[忽]地飞上半空，然后[砰]地一声炸开，化为数十道气带向$n袭来！！\n"NOR;

        mypot = (int)me->query_skill("liangyi-sword", 1)/4;
        mypot += (int)me->query("perform_success/dao", 1)/4;
        mypot = mypot/10*mypot*mypot + (int)me->query("combat_exp")/8;
        
        tapot = (int)target->query_skill("dodge", 1)/2;
	tapot = tapot/10*tapot*tapot + (int)target->query("combat_exp")/8;

        if( random(mypot+tapot) > tapot ) {
                msg += HIG"$n大惊之下，长啸声中冲天而起，奈何为时已晚，在半空中被$N所发剑气击中！！\n" NOR;
                msg += HIG"$n闷哼数声，一个筋斗从空中跌了下来，半响动弹不得！！\n"NOR;
                target->start_busy(delay);
                if(me->query("perform_success/dao", 1) < (int)me->query_skill("liangyi-sword", 1) )
                   me->add("perform_success/dao", 1);
        } else {
                me->start_busy(2);
                msg += HIR"可是$n轻轻一个旋身，从劲气弥漫的空间内逸出。\n" NOR;
                msg += HIR"$N用力过度，只觉一阵心烦意乱，不由地打了个踉跄！！\n"NOR;
        }

        message_vision(msg, me, target);
        me->add("force",-200);
        return 1;
}
