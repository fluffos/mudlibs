#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  object weapon;
  int n, j, damage;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招" HIR "「盘龙炎杀棍」" NOR "？\n");
  if (!me->is_fighting())
    return notify_fail(HIR "「盘龙炎杀棍」" NOR "只能在战斗中使用！\n");
  if (me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(HIR "「盘龙炎杀棍」" NOR "是灵台不传之密！\n");
  if ((int)me->query("max_force") < 2500)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 2500)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("qianjun-bang", 1) < 200)
    return notify_fail("你的千钧棒级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("stick", 1) < 200)
    return notify_fail("你的基本棒法级别还不够，使用这一招会有困难！\n");


  j = (int)me->query_skill("qianjun-bang", 1) / 100 + 2;
  if (j > 6) j = 6;

  message_vision(HIW "\n$N轻轻跃起，双目血红，运足精神使出了" HIR "「盘龙炎杀棍」" HIW "的绝技！\n" NOR, me, target);
  if (random(me->query("combat_exp")) > target->query("combat_exp") / 2) {
    message_vision(HIR "$N手中的武器上爆出了熊熊烈火，$n被这热力逼的喘不过气来！\n" NOR, me, target);
    target->start_busy(1 + random(2));
  }


  damage = (int)me->query_skill("wuxiangforce", 1) / 4;
  if (damage > 100) damage = 100;
  me->add_temp("apply/damage", damage);
  for (n = 1; n <= j; n++)
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->add_temp("apply/damage", -damage);
  me->receive_damage("sen", 100);
  me->add("force", -100);
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(2 + random(2));
  return 1;
}
