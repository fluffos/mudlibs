#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  int skl_me, extra_me;
  object ob, weapon;
  weapon = me->query_temp("weapon");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIW "［千均］只能对战斗中的对手使用。\n" NOR);

  if (me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("[千均]是灵台不传之密！\n");
  if ((int)me->query("max_force") < 2500)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 2500)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("qianjun-bang", 1) < 300)
    return notify_fail("你的千钧棒级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("stick", 1) < 300)
    return notify_fail("你的基本棒法级别还不够，使用这一招会有困难！\n");

  skl_me = (int)me->query_skill("stick");
  extra_me = (int)me->query_temp("apply/damage") + (int)me->query_str() * (int)me->query_str() / 300;
  me->add_temp("apply/attack", skl_me);
  me->add_temp("apply/damage", extra_me);
  message_vision(
    HIG "——————————————醉闹蟠桃会——————————————\n$N使出脚步跄踉，左一棒，右一棒，\n打得$n手忙脚乱，招架不迭\n" NOR,
    me,
    target
  );
  me->set_temp("QJB_perform", 4);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(
    HIR "——————————————脱困老君炉——————————————\n$N一声巨喝，就在$n一愣之间，$N手中" + weapon->name() + "" + HIR "已是呼啸而至，扫向$n！\n" NOR,
    me,
    target
  );
  me->set_temp("QJB_perform", 3);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(
    HIC "——————————————千均澄玉宇——————————————\n$N手中" + weapon->name() + "" + HIC "一抖，化为千万道霞光，\n就在$n目眩神摇之时，再一抖，霞光顿收，\n" + weapon->name() + "" + HIC "已到了$n的身旁！这一招有个名堂，叫作「千钧澄玉宇」。\n" NOR,
    me,
    target
  );
  me->set_temp("QJB_perform", 6);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(
    HIW "——————————————谈笑退天兵——————————————\n$N仰天长笑，看也不看，随手一棒向$n当头砸下！\n" NOR,
    me,
    target
  );
  me->set_temp("QJB_perform", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->add_temp("apply/attack", -skl_me);
  me->add_temp("apply/damage", -extra_me);
  me->start_busy(2);
  return 1;
}
