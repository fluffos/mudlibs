// air 花翻蝶梦
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(HIW "花翻蝶梦只能在战斗中使用。\n" NOR);

  if (objectp(me->query_temp("weapon")))
    return notify_fail(HIW "你必须空手才可以化蝶舞花！\n" NOR);

  if ((int)me->query_skill("dream-zhang", 1) < 70)
    return notify_fail(HIW "你的分花抚柳掌不够级别，不会使用「舞」字诀。\n" NOR);

  if ((int)me->query_skill("dream-force", 1) < 60)
    return notify_fail(HIW "你的天姬心法不够级别，不能使人如梦痴迷。\n" NOR);

  if ((int)me->query_skill("dodge", 1) < 80)
    return notify_fail("你现在轻功太低，不能轻盈飞舞。\n");

  msg = HIC "$N娇媚一笑,衣衫无风自扬有若蝶舞般的旋动起来，片片漫飞宛如蝶舞花影，看得$n痴了。\n\n\n" NOR;

  if (!target->is_killing(me)) target->kill_ob(me);

  if (random(me->query_skill("force")) > target->query_skill("force") / 2) {
    me->start_busy(2);
    target->start_busy(random(3));

    damage = (int)me->query_skill("dream-force", 1);

    damage = damage + random(damage / 2) + 50;

    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 3);
    me->add("force", -damage);

    if (damage > 300)
      msg += HIB "$N越舞越快，一只独自飞翔的蝴蝶扑花的蝴蝶，落花片片，缤纷飞舞，$n眼神开始迷离起来。\n\n\n" NOR;
    msg += HIW "$N袖舞清风招花引蝶，淡淡缭绕的幽香围绕着$n四周,若有若无，似幻似真，如柳枝轻拂上一般温柔。\n\n\n" NOR;
    msg += HIB "幽冷的杀意从$N身内涌出，幻现出霓蓝的光彩，蝴蝶异常美丽地飞舞起来，优雅的恍若梦幻。\n\n\n" NOR;
    msg += HIW "刹那间$n被$N掌法幻化成的蝴蝶拍中，眼前一黑，象一捆稻草一样飞出去,胸口浮现出一只妖艳的斑蝶!\n\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  } else {
    target->start_busy(1);
    msg += CYN "可是$p不为$P忽隐忽现的翩翩彩蝶化红妆所魅，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);

  return 1;
}
