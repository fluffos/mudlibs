//vir 天上人间

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg, start;
  int ap, dp, success;
  target = offensive_target(me);
  if (me->query("family/family_name") != "天上人间")
    return notify_fail("天上人间弟子才可以用！\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢，先应付眼前的事吧。\n");

  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < (int)me->query("max_sen") / 5)
    return notify_fail("你精神太差，难以集中精力念咒。\n");

  if ((int)me->query_skill("dream-spells", 1) < 20)
    return notify_fail("你未曾学会幽怨缥缈。\n");

  if (environment(me)->query("under_water"))
    return notify_fail("你在水中，没法施用幽怨缥缈！\n");

  if (me->query_temp("in_tiaozhan"))
    return notify_fail("你还在挑战中，还是先应付眼前的事吧!\n");

  ap = me->query_skill("spells") + me->query("max_mana") / 10;
  if (target) dp = target->query_skill("spells") + target->query("max_mana") / 10;

  if (!me->is_fighting()) {
    message_vision(BLU "$N以双手托天之姿，迸出七彩的幽寒流旋周身.\n瞬间化形如晶莹剔透水晶泪，滴入尘土中无影无踪......。\n" NOR, me);
    me->add("sen", -me->query("max_sen") / 8);
    me->add("mana", -80);
    success = 1;
  } else {
    msg = MAG "激战中，$N突然飞舞而起，迸出七彩的幽寒流旋周身。\n" NOR;
    if (random(ap + dp) > dp / 2) {
      msg += MAG "只见$N瞬间化形如晶莹剔透水晶泪,滴入尘土中无影无踪..。\n" NOR;
      me->add("sen", -me->query("max_sen") / 6);
      me->add("mana", -50);
      success = 1;
    } else msg += MAG "但$n的身影紧缠不放，将$N拦了下来。\n" NOR;
    me->add("mana", -50);
    message_vision(msg, me, target);
  }
  if (success) {
    start = me->query("env/destination");
    start = me->query("记号/" + start);
    if (!start || !find_object(start))
      start = me->query("startroom");
    if (!start) start = "/u/air/workroom";
    me->move(start);
    message("vision", BLU "一滴水晶泪划破天际滴落," + BLU + me->name() + "飘然落地。\n" NOR,
      environment(me), me);
    tell_object(me, BLU "你如流星般一闪而逝,划破天际滴落。\n" NOR);
    return 3 + random(3);
  }
  return 5 + random(5);
}
