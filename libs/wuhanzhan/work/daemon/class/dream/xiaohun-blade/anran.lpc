//参照秦淮河的歌词编写的
// by air
// 天上人间黯然销魂刀一绝   

#include <ansi.h>

inherit SSERVER;


int perform(object me, object target) {
  object weapon, ob;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail(HIW "你要对谁施展这一招「黯然销魂」?\n" NOR);

  if (!me->is_fighting())
    return notify_fail(HIW "「黯然销魂」只能在战斗中使用。\n" NOR);

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("在这里不能攻击他人。\n");

  if ((int)me->query_skill("xiaohun-blade", 1) < 200)
    return notify_fail("你对黯然销魂刀的领悟不够，你怎么能使出这销魂一招。\n");

  if ((int)me->query("combat_exp", 1) < 600000)
    return notify_fail(HIW "你的经验不足，不能使出「黯然销魂」。\n" NOR);

  if (me->query("force") < 300)
    return notify_fail(HIW "你内力不继，难以使出「黯然销魂」。\n" NOR);

  if (time() - (int)me->query_temp("anran_end") < 3)
    return notify_fail(HIW "真正的绝招可不是乱打一气！\n" NOR);



  msg = HIW "$N低妩缠绵的吟唱-深情柔媚的轻诉-----「黯然销魂」----\n\n" NOR;
  message_vision(msg, me);

  me->clean_up_enemy();
  ob = me->select_opponent();

  message_vision(BMAG + HIM "$N幽幽诉唱....月映波底灯照堤岸....$n心中幽幽浮出百般柔情...." NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  message_vision(BMAG + HIW "$N凝腮浅笑....如花美眷依栏杆.....$n眼神慢慢深沉..似乎想起...." NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  message_vision(BMAG + HIM "$N悄言相思....声声相思为谁诉....$n不由得心中一酸..几乎落泪..." NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  message_vision(BMAG + HIW "$N幽怨凄泣....步步爱怜为谁踱....好似哭诉心中刻骨铭心的百般痴恋..." NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  message_vision(BMAG + HIM "$N欲语还休....蜜意柔情为谁流露....$n深藏内心的柔情一下宣泄了出来..." NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  message_vision(BMAG + HIW "$N梨花带雨....朵朵樱唇为谁涂....$n忍不住慢慢放下手中的兵器...." NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  message_vision(BMAG + HIM "$N娇媚低吟....层层脂粉为谁敷.....$n已为之陶然情醉而飘飘欲仙..." NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  message_vision(BMAG + HIW "眉语眼波为谁倾吐..为谁流露为谁倾吐....幽柔暗哑的吟语弥漫在空间中回荡......" NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  message_vision(BMAG + HIM "$n为这淡淡缭绕的清幽之韵导入无边的回忆中...痴痴的看着$N妩媚的笑颜慢慢逼近.." NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  message_vision(BBLU + HIW "黯然销魂今夜醉...$N刹那间凝聚出强大的杀气...清啸一声劈出黯然销魂一刀---「黯然销魂」-----" NOR, me, ob);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);


  me->add("force", -150);
  me->set_temp("anran_end", time());



  return 1;

}
