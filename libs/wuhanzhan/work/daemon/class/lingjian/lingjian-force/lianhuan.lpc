#include <ansi.h>

inherit SSERVER;


int exert(object me, object target) {
  int skill;

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不够，无法提升身法施放[连环步法]。\n");
  if ((int)me->query_temp("lianhuanbu"))
    return notify_fail("你已经在运功中。\n");

  skill = me->query_skill("lingjian-step", 1);

  me->add("force", -500);

  message_vision(HIW "$N内力猛一提升，七彩光芒绕身略过，身法陡然加快！\n" NOR, me);

  me->add_temp("apply/armor", skill / 2);
  me->add_temp("apply/dodge", skill / 3);

  me->set_temp("lianhuanbu", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 5 :), skill);

  if (me->is_fighting()) me->start_busy(1);

  return 1;
}

void remove_effect(object me, int amount) {
  int skill;
  skill = me->query_skill("lingjian-step", 1);

  me->add_temp("apply/armor", -skill / 2);
  me->add_temp("apply/dodge", -skill / 3);
  me->delete_temp("lianhuanbu");
  tell_object(me, HIW "你一套连环步走完，身法逐渐慢了下来。\n" NOR);
}
