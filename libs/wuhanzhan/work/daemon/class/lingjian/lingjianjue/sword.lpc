// sword.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  success_adj = 110;
  damage_adj = 120;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这招“圣剑除魔”？？\n");

  if ((int)me->query_skill("lingjianjue", 1) < 50)
    return notify_fail("你对灵剑诀领悟得还不够。\n");

  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    message_vision(HIC "$N口中念念有词。。。突然天空中掉下一把宝剑，正插在$N头上！\n" NOR, me);
    return 1;
  }


  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    success_adj,
    //success adjustment
    damage_adj,
    //damage adjustment
    "qi",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "$N默念咒语，全身隐隐透出金光。突然金光暴涨如霹雳般射向天空，
云层开处竟飞出一把巨大的金剑砍向$n，这正是“灵剑诀”中的
杀手锏----" NOR YEL "圣剑除魔" NOR HIC "！" NOR,

    //initial message
    HIR "\n$n躲避不及，被巨大的金剑砍个正着！但听$n一声惨叫，早被砍得鲜血飞溅！\n" NOR,
    //success message
    HIC "\n但是被$n躲开了。\n" NOR,
    //fail message
    HIR "\n结果金剑被$n以法力反激，反而砍中了$N！\n" NOR,
    //backfire initial message
    HIR "\n结果$n躲避不及，差点没被劈成两半！\n" NOR,
    //backfire hit message. note here $N and $n!!!
  );

  me->start_busy(1 + random(2));
  return 3 + random(5);
}
