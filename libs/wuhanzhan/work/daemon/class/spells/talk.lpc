#include <ansi.h>
inherit SSERVER;

int cast(object me, object target) {
  int melv, oblv;

  melv = me->query_skill("literate");

  if (!target)
    return notify_fail("你要对谁使用金玉良言？\n");

  (!target->query_skill("literate", 1) ? oblv = 0 : oblv = target->query_skill("literate"));


  if (!me->query_skill("literate", 1))
    return notify_fail("你都不认识字，如何使用金玉良言？\n");
  if (me->query("id") != "shyhawk" && me->query("id") != "shukai" && me->query("id") != "ken")
    return notify_fail("你不能使用这个法术。\n");
  if (me->query("combat_exp") < 10000)
    return notify_fail("你的经验值太低！需要十年道行方可。\n");
  if (time() - me->query_temp("cast_talk") < 30)
    return notify_fail("你现在不能使用金玉良言。\n");

  message_vision(BLINK "" HIG "\n只见$N大嘴一张，便对$n婆婆妈妈、罗里巴唆、叽叽歪歪、\n" NOR, me, target);
  message_vision(BLINK "" HIB "哼哼叽叽、嘟嘟囊囊、嘻嘻哈哈、嘻里划拉、轲理马差、\n" NOR, me, target);
  message_vision(BLINK "" HIR " 凤 ！！！\n" NOR, me, target);
  message_vision(BLINK "" HIC "          翼！！！\n" NOR, me, target);
  message_vision(BLINK "" HIW "                   天！！！\n" NOR, me, target);
  message_vision(BLINK "" BLU "             	       		翔！！！\n" NOR, me, target);
  message_vision(BLINK "" HIW "说上了一段刚果语。\n" NOR, me, target);


  if (melv > random(10)) {
    message_vision(HIC "只见$N被$n说的目瞪口呆。\n" NOR, target, me);
    tell_object(target, "你暂时不能说话了。\n");
    me->set_temp("cast_talk", time());
    target->set("channel/chat_block", time() + 300);
    return 1;
  }

  message_vision(HIC "$N对$n大吼一声：你在叽歪什么，给我滚！\n" NOR, target, me);
  return 1;
}
