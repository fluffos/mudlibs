//lol 02/04/11

#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{	
	object zhenshen;
	int times = me->query_temp("jue");
	string msg;			

	if(me->query("family/family_name")!="阎罗地府")
		return notify_fail("[绝]的奥妙只有鬼族才可能领悟！\n");
	if( me->is_fight() )
		return notify_fail("你还在战斗，现在不是运用[绝]的时候！\n");
	if( me->busy() )	
	        return notify_fail("你正忙着呢，没有时间来运用[绝]！\n");
        if(( me->query("PKS")>=30 || me->query("bellicosity")>=800) && me->query_temp("jue")>1)
                return notify_fail("你的杀气太重，无法运用更高境界的[绝障]！\n"); 
	if( me->is_ghost() )
		return notify_fail("你已经是鬼了，还要干什么？\n");
        if( me->query_skill("gouhunshu",1) < 200+times*120 )
		return notify_fail("你的勾魂术修为不足，无法运用"HBGRN"[绝]"NOR"的技巧！\n");
	if( (int)me->query("combat_exp") < 200000 )
		return notify_fail("你的道行不够，无法领悟[绝]的奥妙。\n");
	if( (int)me->query("mana") - (int)me->query("max_mana") < 400)
		return notify_fail("你的神通不够！\n");
	if( (int)me->query("sen") < 600)
		return notify_fail("你的精神状态不佳，不要勉强自己！\n");	
	if( (time()-me->query("jue_time"))<360 )
		return notify_fail("[绝]对身体的消耗很大，最好不要连续使用。 \n");
	if( times >= 3 )
		return notify_fail("你已经将[绝]的功能发挥到极致了！\n");	
		
        me->add_temp("jue", 1);
        times = times+1;
	if( times >= 3 ) times = 3;
	me->set("jue_time",time());
        me->receive_damage("sen", 150*times);
	me->add("mana", -200*times);
	msg = HIG"$N集中自己全部的精神，闭上双眼单膝跪下，将右手放到自己胸口，口中喃喃地念了几句咒语。\n"NOR, me;
	        
	switch(times)   {
    		case 1:	
   		msg+=MAG"$N身体周围的真气先猛地往外散发到极限，然后再向内回收！$N的气息消失了！\n"NOR;
   		break;
    		case 2:
    		msg+=RED"随着自己的气息被完全收入体内，$N的动作简练到了极点，绝对不会消耗一丝多余的真气！\n"NOR;
    		break;
    		case 3:
    		msg+=HIY"体内的真气在自己全力运转之下，仿佛聚成了实体，$N终于达到了传说中[凝气如珠]的无上境界！\n"NOR;
    		msg+=WHT"皮肤仿佛变成透明一般，$N缓缓站直了身体，嘴角上露出的一丝微笑显示出$N强大的自信！\n"NOR;
    		break;
	}  
	message_vision(msg, me, target);
	
  	return 2+random(2);
}
