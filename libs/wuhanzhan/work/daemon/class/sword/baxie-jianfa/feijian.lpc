#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("baxie-jianfa", 1);
  if (extra < 100) return notify_fail("你的剑法还不够纯熟！\n");
  if (me->query_temp("no_feijian")) return notify_fail("绝招用的太多太滥就不灵了。\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的真气不够！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIW "「无方飞剑」" NOR "只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  me->add_temp("apply/damage", extra / 2);
  me->add_temp("apply/attack", extra);
  message_vision(HIC "\n$N口中念念有辞，手中剑忽然飞出剑鞘，一道剑光直冲$n，好一招无方飞剑！！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->add_temp("apply/damage", -extra / 2);
  me->add_temp("apply/attack", -extra);
  me->add("force", -100);
  me->set_temp("no_feijian", 1);
  call_out("remove_effect", 2 + random(4), me);
  return 1;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("no_feijian");
}
