//dragonshoot.c 邪王炎杀黑龙波
//说明：延时超必杀技。威力很大，但负效果也挺大。
//出招并不需要很高的等级，只需要时间。

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        if( !target ) target = offensive_target(me);
        if(!target||!target->is_character()||target->is_corpse()||target==me)
        return notify_fail("你要对谁使用「邪王炎杀黑龙波」？\n");
//      if(!me->query("dragon_ready"))
//      return notify_fail("你现在根本没准备好，右臂上没有黑龙龙纹啊！\n");
//      if(me->query_skill("evileye",1)<10)
//      return notify_fail("你的邪眼术实在太低了，无法控制黑龙。\n");
//      if(me->query_skill("evilfire-fight",1)<10)
//      return notify_fail("你的炎杀拳修为可真够低的，怎么用得出来？\n");
//      if(!me->query("dragon_ok"))
//      return notify_fail("你虽听说过此必杀技，却不知如何使用。\n");
        if(me->query_temp("dragon_shooting"))
        return notify_fail("你已经在使用炎杀拳的最大奥义了。\n");
//      if(me->query_skill_mapped("force")!="evileye")
//      return notify_fail("你必须使用邪眼术来召唤黑龙。\n");
        if((int)me->query("kee")<300||(int)me->query("sen")<300)
        return notify_fail("你现在的身体状况不佳，万一没打中可怎么办？\n");
        message_vision(HIC "$N头上的邪眼放出强烈的光芒，接着$N的浑身燃\n起黑色的火焰。四周顿时变得像地狱一般炎热！\n" NOR,me,target);
        me->set_temp("dragon_shooting",1);
        message_vision(GRN "$n说道：好你个"+me->query("name")+"，想干什么？！\n" NOR,me,target);
        target->kill_ob(me);
        me->kill_ob(target);
        call_out((: call_other, __FILE__, "first_fire_attack",me:),1);
        call_out((: call_other, __FILE__, "second_fire_attack",me:),7);
        call_out((: call_other, __FILE__, "final_jugement",me,target:),10+random(3));
        return 1;
}

void first_fire_attack(object me)
{
        object *ob;
        int yourto;
        int myto=me->query("combat_exp");
        int sk=me->query_skill("dragonfight",1)+me->query_skill("dragonforce",1);
        ob = all_inventory(environment(me));
        me->add("force",-100);
        message_vision(HIR"无数的火焰从$N的身上迸射而出，四处肆掠。\n"NOR,me);
        if(wizardp(me))
        tell_object(me,"The first fire damage is: "+sk+"\n");
        for(int i=0; i<sizeof(ob); i++)
        {
                yourto=ob[i]->query("combat_exp");
                if( !living(ob[i]) || ob[i]==me )
                continue;
                if(random(myto)< yourto/4)
                continue;
                if( sk+random(sk/2) < (int)ob[i]->query_skill("force"))
                continue;
                if(ob[i]->query_skill("segokee",1)>sk/20
                || ob[i]->query_skill("spiritforce",1) >sk/10)
                continue;
                else
                {
                ob[i]->receive_damage("kee", sk, me);
                ob[i]->receive_wound("kee",sk, me);
                COMBAT_D->report_status(ob[i], 0);
                        if(ob[i]->is_player() && random(10)<3)
                        {
                        tell_object(ob[i], "你被"+me->query("name")+"放出的火焰烧得鸡飞狗跳。\n");
                        tell_object(ob[i], "你不禁感到惊恐万分：难道……\n");
                        }
                }
        }
        return;
}

void second_fire_attack(object me)
{
        object *ob;
        int yourto, i;
        int myto=me->query("combat_exp");
        int sk=me->query_skill("dragonfight",1)+me->query_skill("dragonforce",1);
        ob = all_inventory(environment(me));
        me->add("force",-100);
        if(wizardp(me))
        tell_object(me,"The second fire damage is: "+sk+"\n");
        message_vision(HIR"无数的火焰从$N的身上迸射而出，四处肆掠。\n"NOR,me);
        message_vision(HIB"但是这次火焰已经逐渐变成了黑色！！！\n"NOR,me);
        for(i=0; i<sizeof(ob); i++)
        {
                yourto=ob[i]->query("combat_exp");
                if( !living(ob[i]) || ob[i]==me )
                continue;
                if(random(myto)< yourto/4)
                continue;
                if( sk+random(sk/2) < (int)ob[i]->query_skill("force"))
                continue;
                if(ob[i]->query_skill("segokee",1)>sk/20
                || ob[i]->query_skill("spiritforce",1) >sk/10)
                continue;
                else
                {
                ob[i]->receive_damage("kee", sk, me);
                ob[i]->receive_wound("kee",sk, me);
                COMBAT_D->report_status(ob[i], 0);
                }
        }
        message_vision(HIW"$N四周的空间慢慢暗了下来，黑色的炎气不断集中在$N的右手之上！\n"NOR,me);
        tell_object(environment(me),"阵阵龙吟隐隐从空中传来。\n");
        return;
}

void final_jugement(object me, object target)
{
        int myto, yourto, damage, chance;
        if(!living(target)||target->is_corpse()||target->is_ghost()||target->query("kee")<0)
        {
        message_vision(HIC "$N见再没有必要使用奥义，于是将妖气收回体内。四周也慢慢恢复了正常。\n"NOR,me,target);
        me->delete_temp("dragon_shooting");
        return 0;
        }
        if(!target->environment(me) && !me->environment(target))
        {
        me->move(environment(target));
        message_vision(CYN "$N使出邪眼追踪术，硬是追上了$n！\n$N对$n大喝道：哪里跑？死去吧！\n"NOR,me,target);
        }
        message_vision(HIC "$N身上的妖气越来越强了。突然，所有的火焰集中在$N的右手上，形成了\n一个怪异的球形空间。接着只听见$N大喝一声：“奥义·邪王炎杀黑龙波！”\n一头巨大的火焰形成的黑龙咆哮一声，从那球形空间里奔涌而出，张着大嘴朝\n着$n直飞过去，似乎要把$n整个吞掉！\n" NOR,me,target);
        me->delete("dragon_ready");
        me->kill_ob(target);
        target->kill_ob(me);
        myto=me->query("combat_exp")/100+me->query("combat_exp")/100;
        yourto=target->query("combat_exp")/100+target->query("combat_exp")/100+1;
        damage=me->query_skill("dragonforce",1)*2+me->query_skill("dragonfight",1)*2    +me->query_skill("spells",1);
        if(damage*2>target->query("kee")) damage=target->query("kee")*(70+random(10))/100;
        chance=myto/yourto*20+random(myto/yourto*100);
        if(wizardp(me))
        {
        tell_object(me, "The chance is: "+chance+"\n");
        tell_object(me, "The basic damage is: "+damage+"\n");
        }
        //以下是有圣光气的玩家将要享受到的权利
        if( random((int)me->query_skill("dragonforce", 1)) < random((int)target->query_skill("segokee", 1)*4) && target->query_skill_mapped("force")=="segokee")
        {
        message_vision(HIY "$n的全身放出金黄色的圣光气，黑龙波被完全防住，没有产生任何作用！\n" NOR,me,target);
        me->start_busy(3);
        target->add("force",-100);
        return 0;
        }

        //以下是有灵气的玩家将要享受到的权利
        if( random((int)me->query_skill("dragonforce", 1)) < random((int)target->query_skill("spiritforce", 1)))
        {
        message_vision(HIW "但是$n的全身放出了强大的灵气，黑龙波完全被防住了，没有起到任何作用！\n"NOR,me,target);
        me->start_busy(2);
        target->add("force",-200);
        return 0;
        }

        //开始命中和伤害的判断
        target->set_temp("death_msg","被传说中邪王炎杀拳的最大奥义烧成了灰烬！\n");
        if(chance>=90)
        {
        message_vision(HIR "$n面如土色，躲闪不及，被黑龙呼地吞下，四肢立刻化成了灰烬。\n" NOR,me,target);
        target->receive_damage("kee", target->query("kee")+1);
        target->receive_wound("kee", target->query("kee")+1);
        COMBAT_D->report_status(target, 0);
        message("channel:rumor", HIW + "只听见一声龙吟，一条黑龙带着黑色的火焰冲入云霄而去了。\n"NOR,users());
        }
        else if(chance > 80 )
        {
        message_vision(HIR "只见$N召唤出来的黑龙吞了下去，带到了半空，惨叫声不断传来……\n" NOR,me,target);
        target->move("/u/icejia/xiuxi");


        //在"/d/mojie/inside-dragon1"中，中招者将受到极大伤害。

        message("channel:rumor", HIW + "只听见一声龙吟，一条黑龙带着黑色的火焰冲入云霄而去了。\n"NOR,users());
        }
        else if(chance > 70 )
        {
        message_vision(HIR "$n拼出全力，想要防住黑龙的吞噬。结果仍然被黑龙缠住，受伤严重！\n"NOR,me,target);
        target->receive_damage("kee",damage*2);
        target->receive_wound("kee",damage*2);
        target->receive_damage("sen",damage);
        target->receive_wound("sen",damage);
        COMBAT_D->report_status(target, 0);
        message("channel:rumor", HIW + "只听见一声龙吟，一条黑龙带着黑色的火焰冲入云霄而去了。\n"NOR,users());
        }
        else if(chance > 60 )
        {
        message_vision(HIR "但是$n集中全身的力量，终于将黑龙引开了，却是受伤不轻！\n" NOR,me,target);
        target->receive_damage("kee",target->query("kee")*(50+random(10))/100);
        target->receive_wound("kee",target->query("kee")*(50+random(10))/100);
        COMBAT_D->report_status(target, 0);
        message("channel:rumor", HIW + "只听见一声龙吟，一条黑龙带着黑色的火焰冲入云霄而去了。\n"NOR,users());
        }
        else if(chance > 50 )
        {
        message_vision(HIR "$n施展开身法，极尽辗转腾挪之能，受伤并不严重。\n" NOR,me,target);
        target->receive_damage("kee",target->query("kee")*(30+random(10))/100);
        target->receive_wound("kee",target->query("kee")*(30+random(10))/100);
        COMBAT_D->report_status(target, 0);
        message("channel:rumor", HIW + "只听见一声龙吟，一条黑龙带着黑色的火焰冲入云霄而去了。\n"NOR,users());
        }
        else if(chance > 40 )
        {
        message_vision(HIR "但是$n运转法力，硬是接下了黑龙波，只受了些许烧伤。\n" NOR,me,target);
        target->receive_damage("kee",target->query("kee")*(10+random(10))/100);
        target->receive_wound("kee",target->query("kee")*(10+random(10))/100);
        COMBAT_D->report_status(target, 0);
        message("channel:rumor", HIW + "只听见一声龙吟，一条黑龙带着黑色的火焰冲入云霄而去了。\n"NOR,users());
        }
        else if(chance > 30 )
        {
        message_vision(HIG "不过，$n使了个藏匿身形的法门，避过了黑龙的攻击。\n" NOR,me,target);
        target->set("env/invisibility", 1);
        target->add("mana",-200);
        target->start_busy(2);
        call_out((: call_other, __FILE__, "show_target",me,target:),1+random(5));
        message("channel:rumor", HIW + "只听见一声龙吟，一条黑龙带着黑色的火焰冲入云霄而去了。\n"NOR,users());
        }

        //有下面这种情况就等着看好戏吧
        else if(chance > 0)
        {
        message_vision(HIB "但是$n施展移星换斗之法，竟将黑龙反引向$N！\n$N眼看就要被自己放出的黑龙所吞噬了！\n" NOR,me,target);
        call_out((: call_other, __FILE__, "dragon_back",me,target:),3+random(2));
        target->add("force",-200);
        target->add("mana",-200);
        if(wizardp(me))
        tell_object(me, "黑龙斗衣之攻击启动。\n");
        call_out((: call_other, __FILE__, "dragon_real_power",me,target:),20+random(2));
        }

        //限制出招者的busy时间
        if(me->is_busy() || !me->is_busy())
        me->start_busy(3+random(2));

        me->delete_temp("dragon_shooting");
        if(target->query("kee")>0 && target->query("sen")>0)
        target->delete_temp("death_msg");
        return;
}

void show_target(object me, object target)
{
        if(!target) return;
        else
        {
                if(me->environment(target))
                {
                message_vision(HIW "只见一道白光闪过，$n的身形又现了出来。\n" NOR,me,target);
                target->set("env/invisibility",0);
                message_vision(YEL "$n狂笑道：我道什么黑龙波，原来也不过如此！！\n" NOR,me,target);
                }
                if(!me->environment(target))
                {
                message_vision(HIW "只见一道白光闪过，$n的身形又现了出来。\n" NOR,me,target);                   target->set("env/invisibility",0);
                tell_object(target, "你不禁暗自庆幸：幸好我机灵，不然早被烧成灰了。\n");
                }
        }
        return;
}

void dragon_back(object me, object target)
{
        message_vision(HIW "那黑龙朝着$N呼啸而去，$N立刻就被黑龙吞了进去！\n" NOR,me,target);
        
        //下面的东西可就是为了配合剧情了
        me->move("/u/icejia/xiuxi");
        message("channel:rumor", HIM + "【谣言】某人：据说"+
       me->query("name")+"在使用黑龙波时被"+target->query("name")+"反弹，整个人反而被黑龙所吞噬！\n"NOR,users());
        message_vision(CYN "$N哈哈大笑：死妖怪，这下你可是自作自受咯！\n" NOR,target);
        message_vision(CYN "$n负手而立，凝望远山。只觉得天下英雄舍我其谁。\n" NOR,target);
        if(target->is_busy()) target->start_busy(5);    
        return;
}

void dragon_real_power(object me, object target)
{
        int mywx, urwx, dam, sk, p;
        object weapon;
        if(!living(target)||target->is_corpse()||target->is_ghost()||target->query("kee")<0)
        {
        message_vision(HIC "$N突然觉得没有必要使用奥义，于是将妖气收回体内。四周也慢慢恢复了正常。\n"NOR,me,target);
        me->delete_temp("dragon_shooting");
        return 0;
        }
        p=3+random(2);
        weapon=me->query_temp("weapon");
        sk=me->query_skill("dragonfight",1);
        me->move(environment(target));
        message_vision(HIR "只见一团燃烧着的火焰慢慢从天上降落到了$n面前！\n$N从火焰里面慢慢地走了出来，看那情形，似乎又厉害了不少！！\n" NOR,me,target);
        me->add_temp("apply/armor", sk);
        me->add_temp("apply/armor_vs_force",sk);
        me->add_temp("apply/dodge",sk);
        me->add_temp("apply/parry",sk);
        me->add_temp("apply/attack",sk);
        me->add_temp("apply/damage_bonus",-sk/2);
        me->delete("env/brief_message");
        me->set("force_factor",me->query("force_factor")+sk/2);
        me->set("mana_factor",me->query("mana_factor")+sk/2);
        me->add("bellicosity",random(2000));
        target->delete("env/brief_message");
        message_vision(HIM "$N对$n冷笑道：受死吧！说着，身形顿时消\n失，而$n则立刻感到强烈的攻势朝着自己这边袭来！\n" NOR,me,target);
        me->kill_ob(target);
        for(int i=1;i<=p;i++)
        {
        COMBAT_D->do_attack(me, target, weapon);
        }
        me->add_temp("apply/armor", -sk);
        me->add_temp("apply/armor_vs_force",-sk);
        me->add_temp("apply/dodge",-sk);
        me->add_temp("apply/parry",-sk);
        me->add_temp("apply/attack",-sk);
        me->add_temp("apply/damage_bonus",-sk/2);
        me->set("force_factor",me->query("force_factor")-sk/2);
        me->set("mana_factor",me->query("mana_factor")-sk/2);
        message_vision(HIW "$N身形一现，身上的黑龙斗衣散发着强大的力量。\n$n惊呼：原来黑龙波的最大奥秘竟然是……\n" NOR,me,target);
        message_vision(GRN "但是$N并不停歇，接着又是一轮抢攻！\n" NOR,me,target);
        call_out((: call_other, __FILE__, "tired_alarm",me :),10+random(2));
        call_out((: call_other, __FILE__, "tired_after_shoot",me :),20+random(5));
        mywx=(int)me->query("combat_exp");
        urwx=(int)me->query("combat_exp");
        dam=(int)me->query_skill("dragonfight",1);
        if(target->is_busy()) urwx=urwx/5*3;

        //以下为飞影打败武威的经典连续技哦！

        message_vision(HIY "$N一个纵身，照准$n的头部就是一拳！\n" NOR,me,target);
        {
                me->add("force",-100);
                if(random(mywx)>urwx/3)
                {
                message_vision(GRN "结果$n根本来不及躲闪，结结实实地吃了一拳！\n" NOR,me,target);
                target->receive_damage("kee",dam*(1+random(2)));
                target->receive_wound("kee",dam*(1+random(2)));
                COMBAT_D->report_status(target, 0);
                }
                else
                {
                message_vision(GRN "不过被$n躲了过去。\n" NOR,me,target);
                }
        }
        message_vision(HIY "$N接着一个矮身来到$n下方，右掌全力自下而上击向$n的腹部！\n" NOR,me,target);
        {
                me->add("force",-100);
                if(random(mywx)>urwx/3)
                {
                message_vision(GRN "结果$n惨叫一声，被打上了天！\n" NOR,me,target);
                target->receive_damage("kee",dam*(1+random(2)));
                target->receive_wound("kee",dam*(1+random(2)));
                COMBAT_D->report_status(target, 0);
                }
                else
                {
                message_vision(GRN "$n含胸收腹，硬是躲过了这一击。\n" NOR,me,target);
                }
        }
        message_vision(HIY "$N急速提气，朝着$n电射而去，后发先至来到了其背后！\n$N双拳和一，朝着$n那毫无防备的后背狠狠砸了下去！\n" NOR,me,target);
        {
                if(random(mywx)>urwx/4)
                {
                message_vision(GRN "$n被砸得内脏俱损，口吐鲜血，朝着地面落下！\n" NOR,me,target);
                target->receive_damage("kee",dam*(1+random(2)));
                target->receive_wound("kee",dam*(1+random(2)));
                COMBAT_D->report_status(target, 0);
                }
                else
                {
                message_vision(GRN "$n在这千钧一发之时，硬生生地运气抗了$N一击！\n" NOR,me,target);
                target->receive_damage("kee",dam/2);
                target->receive_wound("kee",dam/2);
                COMBAT_D->report_status(target, 0);
                }
        }
        me->set("bellicosity",0);
        return;
}

void tired_alarm(object me)
{
        message_vision(HIG "在连续的攻击后，$N显得有些倦意连连，脚步虚浮了。\n" NOR,me);
        return;
}

void tired_after_shoot(object me)
{
        message_vision(HIG "$N身体连晃了几晃，居然就这么倒在地上睡着了！\n" NOR,me);
        if(!wizardp(me))
        me->unconcious();
        else tell_object(me, "注意：玩家在使用完上述的招式后会晕倒。\n");
        return;
}

