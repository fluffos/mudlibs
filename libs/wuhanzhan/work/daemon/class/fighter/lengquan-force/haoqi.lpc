// 浩气

#include <ansi.h>

inherit F_CLEAN_UP;
void remove_effect(object me, int amount);

int exert(object me, object target, int amount) {
  int skill;
  //        if( target != me ) 
  //          return notify_fail("你只能用"HIR"哼哈二气"NOR"提升自己的战斗力。\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够。\n");
  if (me->query_skill_mapped("spear") != "bawang-qiang")
    return notify_fail("你还没有施展霸王枪法呢。\n");

  if (time() - (int)me->query_temp("haoqi_end") < 5000)
    return notify_fail("你已经将浩然正气运足了。\n");

  skill = me->query_skill("force");

  me->add("force", -100);
  me->receive_damage("kee", 30);

  message_vision(
    HIR "$N深吸一口气，咬破左手食指，吮了一口鲜血喷在长枪之上。\n" NOR, me);
  me->set_temp("haoqi_end", time());


  return 1;
}
