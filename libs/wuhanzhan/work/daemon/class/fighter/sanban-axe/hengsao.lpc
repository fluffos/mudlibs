// 将军府的pk专用perform .....
// updated by yangwl 11.15.2000
// 打击pker.....
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage, ap, dp;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招" HIR "「横扫千军」" NOR "？\n");

  if (!me->is_fighting())
    return notify_fail("" HIR "「横扫千军」" NOR "只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 1800)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 2500)
    return notify_fail("你的真气不足！\n");


  if ((int)me->query_skill("axe", 1) < 250)
    return notify_fail("你连基本斧法都不纯熟，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("lengquan-force", 1) < 250)
    return notify_fail("你的冷泉神功修为不够，用这招小心受内伤。\n");
  if ((int)me->query_skill("sanban-axe", 1) < 250)
    return notify_fail("你的宣花三斧修为不够，发动不了攻势。\n");

  if (me->query_temp("no_hengsao"))
    return notify_fail("你刚用过绝招，先休息休息吧！\n");

  me->add("force", -500);
  me->add("sen", -200);


  msg = CYN "\n$N一声巨喝，提起手中的" + (me->query_temp("weapon"))->name() + CYN + "举在半空之中，使出了「横扫千军」的绝技！\n" NOR;

  ap = me->query_skill("axe");
  ap = (ap * ap * ap / 10) + (int)me->query("combat_exp"); ;
  dp = target->query_skill("parry");
  dp = (dp * dp * dp / 10) + random((int)target->query("combat_exp"));

  if (random(ap + dp) > dp) {
    damage = (int)me->query("max_force") / 10 + random((int)me->query("eff_kee") / 5);
    damage -= (int)target->query("max_force") / 15 + random((int)target->query("eff_kee") / 5);
    damage += (int)me->query("force_factor") - random((int)target->query("force_factor"));

    if (damage > 0) {
      msg += RED "$N挥动手中" + (me->query_temp("weapon"))->name() + HIR "带着一条劲风斩向了$n，$n被这惊天动地之势吓破了胆，顿时被砍的血肉横飞。\n"
        NOR;
      damage += random((damage * (int)me->query_skill("axe")) / 120);
      target->receive_damage("sen", damage * 5 / 4, me);
      target->receive_wound("sen", damage / 4, me);
      target->receive_damage("kee", damage * 5 / 4, me);
      target->receive_wound("kee", damage / 3, me);
      me->improve_skill("sanban-axe", 1, 1);
      me->set_temp("no_hengsao", 1);
      call_out("hengsao_ok", 3 + random(2), me);
    } else {
      msg += HIR "$n举手中兵器将来招硬接下来！\n" NOR;

      me->improve_skill("sanban-axe", 1, 1);
    }
  }

  else
    msg += HIR "$n情急之下向后猛退，避开了这致命一击。\n" NOR;

  message_vision(msg, me, target);
  if (damage > 0) COMBAT_D->report_status(target);


  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(3);
  return 1;
}


void hengsao_ok(object me) {
  if (!me) return;
  me->delete_temp("no_hengsao");
}
