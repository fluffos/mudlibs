#include <ansi.h>
inherit SSERVER;
#include <combat.h>
int perform(object me, object target)
{
        string msg;
        int damage, p;
        if( !target ) target = offensive_target(me);
         if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("「三连杀」只能在战斗中使用。\n");
  if(me->query_skill("sanban-axe",1)<230)
    return notify_fail("你对宣花三斧不够熟悉，无法一气呵成地使出！\n");
  if(me->query_skill("axe",1)<230)
    return notify_fail("你对斧法不够熟悉，无法一气呵成地使出！\n");

        if(!me->query_skill("force", 1))
           if(me->query_skill("lengquan-force", 1) <230)
                return notify_fail("以你现在的内功修为还使不出「三连杀」。\n");        

            if (me->query_skill_mapped("force") != "lengquan-force")
                return notify_fail("你所使用的内功不对。\n");

if (me->query_skill_mapped("parry") != "sanban-axe" )
            if (me->query_skill_mapped("parry") != "sanban-axe")
                return notify_fail("你所使用的招架不对。\n");

        if( (int)me->query("max_force") < 2800 )
                return notify_fail("你的内力修为太弱，不能使用「三连杀」！\n");

        if( (int)me->query("force") < 1800 )
                return notify_fail("你的真气不够！\n");

        if (me->query("yd_2") && (target->query_skill_mapped("force")=="ningxie-force" || 
            target->query_skill_mapped("force") == "ningxie-force")){
            msg = CYN "\n$N暗运神功，一式「三连杀」向$n急冲，手中大斧直袭$n小腹！\n" NOR;
          me->start_busy(1);
         if (random(me->query_skill("force",1)) > target->query_skill("force",1) /2 ){                
                damage = (int)me->query_skill("axe", 1);
                damage = (int)me->query_skill("sanban-axe", 1) +damage;
                damage = (int)me->query_skill("lengquan-force", 1) +damage;
                damage = random(damage)+250;
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/3);               
                me->add("force", -300);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += RED "$n一见之下，大为失色，发现这似乎正是自己的克星！\n"NOR;   
                                msg+=COMBAT_D->damage_msg(damage, "震伤");
                } 
                     else {       
                me->start_busy(3);
                me->add("force", -200);                
                msg += BLU"$p见这三连杀是自己的克星，识得厉害，危及之中一个铁板桥，上身向后一倒，艰难的躲过这一招。\n"NOR;
                }
                     }
                        else{
         msg = CYN "\n$N暗运神功，一式「三连杀」杀出，手中大斧直袭$n小腹！\n" NOR;
          me->start_busy(1);
          if (random(me->query_skill("parry")) > target->query_skill("parry") / 2)
             {
                msg += RED "\n$n被这招吓破了胆，只得连忙运气护住丹田要害，虽运气护住丹田，但还是受了重伤！\n"NOR;
                damage = (int)me->query_skill("lengquan-force", 1);
                damage = (int)me->query_skill("axe", 1) +damage;
                damage = (int)me->query_skill("sanban-axe", 1) +damage;
                damage = damage + random(damage/2) + 250;
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/5);               
                me->add("force", -(damage/2));
                msg+=COMBAT_D->damage_msg(damage, "震伤");
                            me->start_busy(1);
                            target->start_busy(1);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                if(me->query_skill("sanban-axe", 1) > 250)
                call_out("perform2", 0, me, target);    
              } 
         else {       
                me->start_busy(3);
                me->add("force", -100);                
                msg += BLU"可是$p识破了此招，向你对冲了过来，这招顿时落了空。\n"NOR;
              }
         }         
        message_vision(msg, me, target);
        return 1;
}
int perform2(object me, object target)
{
        string msg;
       int damage, p;
        if (!me || !target) return 0;
        if(!living(target)) 
          return notify_fail("对手再加一刀就死了，何必铉耀绝技呢。\n");  
        if( (int)me->query("force", 1) < 1600 )
                return notify_fail("你待要再出第二招，却发现自己的内力不够了！\n");     
        msg = CYN "\n接着$N身形急转，第二杀急砍向$n后腰，$n顿时手足无措！\n"NOR;
          me->start_busy(1);
        if (random(me->query_skill("dodge")) > target->query_skill("dodge") / 2){                
           msg += RED "结果一斧砍中，$n只觉得全身一阵巨震，已受了重伤！\n"NOR;   
                            damage = (int)me->query_skill("lengquan-force", 1);
                damage = (int)me->query_skill("axe", 1) +damage;
                damage = (int)me->query_skill("sanban-axe", 1) +damage;
                damage = damage + random(damage/2) + 250;
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/4);               
                me->add("force", -(damage/2));
                msg+=COMBAT_D->damage_msg(damage, "震伤");
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                if(me->query_skill("sanban-axe", 1) > 280)
           call_out("perform3", 0, me, target);    
                      } 
              else {
           me->add("force", -150);
           target->add("force", -250);
           msg += BLU"\n$p眼看就要中招轻轻向上一跳，从$N头上跃过，躲了开来。\n" NOR;
           }
        message_vision(msg, me, target);
        return 1;
}
int perform3(object me, object target)
{
         int damage, p;  
          int skill;
        string msg;
        skill = (int)me->query_skill("sanban-axe", 1);                
        skill = skill/10;
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");
        if( (int)me->query("force", 1) < 1400 )
                return notify_fail("你待要再出第三杀，却发现自己的内力不够了！\n");     

        msg = CYN "\n紧跟着$N三杀第三次击出，手中大斧带着一到银弧自$n小腹直向上撩出！\n"NOR;              
          me->start_busy(1);
        if (random(me->query_skill("force")) > target->query_skill("force") / 2){                
                msg += RED "$n只觉眼前一凉，整个人差点没被劈成两半！\n" NOR;
                damage = (int)me->query_skill("lengquan-force", 1);
                damage = (int)me->query_skill("axe", 1) +damage;
                damage = (int)me->query_skill("sanban-axe", 1) +damage;
                damage = damage + random(damage/2) + 250;
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/3);               
                me->add("force", -(damage/2));
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                target->add_temp("apply/attack", -100);
                target->add_temp("apply/dodge", -100);
                target->add_temp("apply/parry", -100);  
                target->add("kee", -444);                 
                call_out("back", 3 + skill, target);
                msg+=COMBAT_D->damage_msg(damage, "震伤");                          
                               }
                                     else {
                me->start_busy(target->query_skill("force",1)/50);
                me->add("force", -300);
                target->start_busy(2);
                msg += BLU"\n$p喘息未定，见$P大斧如狂风般劈来，连忙又跃开数尺，狼狈地避开。\n" NOR;
             }
        message_vision(msg, me, target);
        return 1;
}
void back(object target)
{
    if (!target) return;
        target->add_temp("apply/attack", 100);
        target->add_temp("apply/dodge", 100);
        target->add_temp("apply/parry", 100);
}
