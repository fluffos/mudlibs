#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object *inv, obj;
  int i, mypot, tapot, temp_dodge, temp_spells;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「惊雷」？\n");
  if (!me->is_fighting())
    return notify_fail("「惊雷」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力不够！\n");
  if (me->query("family/family_name") != "将军府")
    return notify_fail("你是哪儿偷学来的武功？\n");
  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query_skill("jinglei-mace", 1) < 180)
    return notify_fail("你的惊雷鞭级别还不够，使用这一招会有困难！\n");
  message_vision(HIC "\n$N运足精神，大喝一声，天空突然变色，一道闪电向$n击去！\n" NOR, me, target);

  mypot = (int)me->query_skill("mace");
  mypot = mypot * mypot;

  tapot = (int)target->query_skill("parry");
  tapot = tapot * tapot;
  if (random(mypot + tapot) > tapot) {
    inv = all_inventory(target);
    i = sizeof(inv);
    if (i < 1) {
      message_vision(HIW "$N躲闪不及，被闪电打个正着！\n" NOR, target);
      target->set("kee", 0);
      target->set("sen", 0);
      COMBAT_D->report_status(target);
    } else {
      for (i = 1; i < sizeof(inv); i++) {
        obj = inv[i];
        message_vision(HIB "$N身上的$n" HIB "在闪电中发出妖异的蓝光！\n" NOR, target, obj);
        target->set("kee", 0);
        target->set("sen", 0);
      }
      COMBAT_D->report_status(target);
    }
  } else {
    message_vision(HIC "却被$N躲开了！\n" NOR, target);
  }
  me->add("force", -300);
  target->kill_ob(me);
  me->start_busy(3);
  return 1;
}
