//icejia

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  object weapon;
  string who1, who2;
  int damage, lvl, r_lvl, count, form, skill, skill2, i;
  string msg;

  if (!me->query_skill("jinglei-mace", 1))
    return notify_fail("你不会羽舞飞符。\n");
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「羽舞飞符」？\n");
  if (skill > 300) skill = 300;
  if (me->query("family/family_name") != "将军府")
    return notify_fail("你是哪儿偷学来的武功，也想用「羽舞飞符」?\n");
  if (!me->is_fighting())
    return notify_fail("「羽舞飞符」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("max_mana") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("mana") < 1000)
    return notify_fail("你的法力不足！\n");
  if ((int)me->query("sen") < 600)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("jinglei-mace", 1) < 200)
    return notify_fail("你的惊雷鞭法级别还不够，小心炸着自己！\n");
  if ((int)me->query_skill("baguazhou", 1) < 200)
    return notify_fail("你的八卦咒级别还不够，不能幻化出漫天符文！\n");
  if ((int)me->query_skill("bashishentong", 1) < 200)
    return notify_fail("你的八识神通级别还不够，无法自如的操纵符文！\n"); if (me->query_skill_mapped("force") != "lengquan-force")
      return notify_fail("羽舞飞符必须配合冷泉神功才能使用。\n");
  if (time() - (int)me->query_temp("feifu_end") < 20)
    return notify_fail("绝招用多就不灵了！\n");
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  skill = (int)me->query_skill("baguazhou", 1);
  skill2 = (int)me->query_skill("jinglei-mace", 1);
  lvl = skill / 20;
  r_lvl = 3 + random(lvl);
  if (r_lvl < 1) r_lvl = 1;
  count = me->query_str();
  write(HIW "你默运冷泉神功，使出羽舞飞符，漫天符文如雪而降，\n瞬间前前后后在四周围，" + target->name() + "的攻击被尽数挡回。\n" NOR);
  tell_object(target, HIW "忽然，你发现有一股奇怪的力量向你袭来，\n四周片片符文在你周围使你不敢妄动。\n" NOR);
  if (random(me->query("force", 1)) > 4 * target->query("force", 1) / 5) {
    target->start_busy(random(3));
    damage = skill2 / 2 + r_lvl * target->query("force_factor", 1);
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage);
    me->add("force", -damage);
    msg = HIC "$N默运冷泉神功，使出羽舞飞符。\n" NOR;
    msg += HIR "漫天符文将$n的内力全数反击回去！\n" NOR;
    if (damage < 70)
      msg += HIR "结果$n受到$N的符文之力的反震，闷哼一声。\n" NOR;
    else if (damage < 100)
      msg += HIR "结果$n被$N以内力反震，「嘿」地一声退了两步。\n" NOR;
    else if (damage < 150)
      msg += HIR "结果$n被$N的漫天符文，片片穿透而过。\n" NOR;
    else
      msg += HIR "结果$n被$N的符文，透胸而过！！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    tell_object(target, HIM "你周身不畅，低头发现一片闪着金光的符文正贴在你的心脉之上！\n" NOR);
    target->start_busy(random(3));
    message(
      "vision",
      HIM "\n" + target->name() + "低头发现一片闪着金光的" HIY "符文" HIM "正贴在" + target->name() + "的心脉之上！\n顿时心智大乱，身体仿佛一不受自己控制，一招一招不由自主的往自己身上招呼……\n\n" NOR,
      environment(me),
      target
    );
    for (i = 0; i < r_lvl; i++)
      COMBAT_D->do_attack(target, target, target->query_temp("weapon"));
    me->add("force", -500);
    me->add("mana", -500);
    me->add("sen", -500);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }

  }
  me->set_temp("feifu_end", time());
  me->start_busy(2);
  return 1;
}
