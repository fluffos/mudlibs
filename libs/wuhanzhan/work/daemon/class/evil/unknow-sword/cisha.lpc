// ken
//user:2002
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int force,extra;
	object weapon;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("刺杀只能对战斗中的对手使用。\n");
	extra = me->query_skill("moming-sword",1) ;
	if(extra < 100 ) return notify_fail("你的剑法不够熟练！\n");
       force = target->query("max_force");
       message_vision(HIW"$N暗运莫名剑法「刺杀」，一股寒冽的剑气呼啸而出, 直劈向$n！\n"NOR,me,target);      
       msg = HIW "$n浑身剧震，诸般大穴似乎都被刺中，内力尽失！\n" NOR;
       message_vision(msg, me, target);
       if(target->query("force")>200) {target->set("force",force/2 );}
       me->start_busy(3);
       return 1;
}
