// created by ken   2001.3.9
#include <ansi.h>
inherit SSERVER;
void free(object target);
int perform(object me, object target) {
  object weapon;
  int ap, ap1, ap2, dp, dp1, dp2, kaee, kkee, damage;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("攻杀,只能杀人!不是你拿着好玩的!\n");
  if (!me->is_fighting())
    return notify_fail("没战斗就别乱耍!\n");

  if (me->query_temp("no_gongsha"))
    return notify_fail("绝招用的太多太滥就不灵了。\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的基本内力不足。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query_skill("moming-sword", 1) < 150)
    return notify_fail("你的剑法修为尚不足，无法施展。\n");
  if ((int)me->query_skill("sword", 1) < 150)
    return notify_fail("你的剑法修行尚浅，用也用不出来。\n");
  message_vision(
    HIC "$N大喝一声，" + (me->query_temp("weapon"))->name() + "运足了剑气，呼的一声劈向了$n！\n\n" NOR,
    me,
    target,
  );
  ap = (int)me->query("combat_exp");
  ap1 = (int)me->query_skill("sword") + (int)me->query_skill("evil-force") + (int)me->query_skill("moming-sword");
  ap2 = me->query("max_force") + me->query("force");
  dp = (int)target->query("combat_exp");
  dp1 = target->query("max_force") + target->query("force");
  dp2 = (int)target->query_skill("parry") + (int)target->query_skill("dodge");
  if (random(ap + dp) > dp / 2) {
    message_vision(
      HIC "$n一声惨叫，早已被" + (me->query_temp("weapon"))->name() + "劈了个正着。\n" NOR,
      me,
      target,
    );

    me->add("force", -200);
    damage = random(100 + 100 + ap1 + ap2);
    if (damage < 1) damage = random(ap1);
    if (damage > 1800) damage = 2000;
    if (target->query("force") < 200) { target->set("force", 0); } else {
      target->add("force", -random(500));
    }
    target->receive_wound("kee", damage, me);
    COMBAT_D->report_status(target);
    me->set_temp("no_gongsha", 1);
    call_out("remove_effect", 5 + random(5), me);

  } else {
    message_vision(BLU "可惜$N网卡了一下,没能打着$n。\n" NOR, me, target,);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->set_temp("no_yixiao", 1);
    call_out("remove_effect", 5 + random(5), me);
  }
  return 1;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("no_gongsha");
}
