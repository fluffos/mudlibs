#include <ansi.h>
int update_condition(object me, int duration) {
  me->receive_wound("sen", 100);
  me->receive_damage("kee", 100);
  me->set_temp("death_msg", "火毒发作死了。\n");
  me->apply_condition("heavy_fire_poison", duration - 1);
  tell_object(me, RED "你的" HIR "火毒" RED "发作了！\n" NOR);
  if (duration < 1) return 0;
  return 1;
}
