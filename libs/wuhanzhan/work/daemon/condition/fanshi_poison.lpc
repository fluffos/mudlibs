#include <ansi.h>

int update_condition(object me, int duration)
{
   int damage_kee=10, damage_sen=10;

   if(me->query("max_kee")>500)
     damage_kee=me->query("max_kee")/10;
   if(me->query("max_sen")>500)
     damage_sen=me->query("max_sen")/10;
        if(damage_kee > 100) damage_kee = 100;
        if(damage_sen > 100) damage_sen = 100;
                                                   
   me->receive_wound("sen", damage_sen);
   me->receive_wound("kee", damage_kee);
   me->set_temp("death_msg","真气反噬而亡。\n");
   me->apply_condition("fanshi_poison", duration - 1);

   if( (int)me->query("kee") < (int)me->query("max_kee")/4 )
     message_vision("$N骨节一阵爆响，“哇”地一声，吐出一口鲜血。\n", me);
   else if( (int)me->query("kee") < (int)me->query("max_kee")/2 )
     message_vision("$N痛苦的呻吟着，似乎受了很严重的内伤。\n", me);     
   else 
     message_vision("$N闷哼一声。\n", me);
     
   if( duration < 1 ) return 0;
   return 1;
}

