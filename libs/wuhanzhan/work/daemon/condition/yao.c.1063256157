//medical_condition
//modify by ken 2001-7-2
#include <ansi.h>
int update_condition(object me, int duration)
{
        me->receive_healing("kee", 40);
        me->receive_healing("sen", 40);
        me->add("force", 50);
    me->add("max_mana",1);
 me->add("combat_exp",450);
    me->add("max_force",1);
// 中秋特赏
        me->add("mana", 50);
        me->apply_condition("yao", duration - 1);
        if( duration < 1 )
        tell_object(me, HIW "火龙内丹的药效散光了！\n" NOR );
        else
        tell_object(me, HIG "你觉得一股仙力在你身体里慢慢散开，全身说不出的舒服。\n" NOR );
        if( duration < 1 ) 
                return 0;
        return 1;
}
