#include <ansi.h>
int update_condition(object me, int duration) {
  me->add("force", 100);
  me->add("mana", 100);
  me->apply_condition("double_yao", duration - 1);
  if (duration < 1)
    tell_object(me, HIW "药效散光了！\n" NOR);
  else
    tell_object(me, HIW "㈠㈡㈢㈣㈤㈥㈦㈧㈨㈩\n" NOR);
  if (duration < 1)
    return 0;

  return 1;
}
