// cuixin_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
        int damage_kee=10, damage_sen=10;

        if(me->query("max_kee")>200)
                damage_kee=me->query("max_kee")/5;
        if(me->query("max_sen")>200)
                damage_sen=me->query("max_sen")/10;
        if(damage_kee > 120) damage_kee = 120;
        if(damage_sen > 120) damage_sen = 120;
                                                        
        me->receive_wound("sen", damage_sen);
        me->receive_wound("kee", damage_kee);
        me->set_temp("death_msg","心力交瘁而死。\n");
        me->apply_condition("cuixin_poison", duration - 1);

        if( (int)me->query("kee") < (int)me->query("max_kee")/4 )
                message_vision(HIR"$N头重脚轻，疼得在地上捂着胸口满地打滚。\n"NOR, me);
        else if( (int)me->query("kee") < (int)me->query("max_kee")/2 )
                message_vision(HIR"$N双手紧捂着胸口，一不留神，疼得跌倒在地。\n"NOR, me);            
        else 
                message_vision(HIR"$N心上一阵绞痛，手捂着心口，汗如雨下。\n"NOR, me);
                
        if( duration < 1 ) return 0;
        return 1;
}
