// duanhun_poison.c

#include <ansi.h>

int update_condition(object me, int duration) {
  int damage_kee = 10, damage_sen = 10;

  me->set_temp("death_msg", "中了七步断魂散之毒而亡，听说死时七窍流血，极为恐怖。\n");
  me->apply_condition("duanhun_poison", duration - 1);
  if (duration == 7)
    message_vision(RED "$N左手一阵麻木，接着像要断掉一样的疼。\n" NOR, me);
  if (duration == 6)
    message_vision(RED "紧跟着$N右手一阵麻木，双臂变得毫无力气，如断掉一般。\n" NOR, me);
  if (duration == 5)
    message_vision(RED "$N左脚一阵巨痛，身体像左倾了下去。\n" NOR, me);
  if (duration == 4)
    message_vision(RED "紧跟着$N右脚一阵巨痛，身体像前栽倒在地。\n" NOR, me);
  if (duration == 3)
    message_vision(RED "$N倒在地上，胸口忽觉窒闷异常，疼得满地打滚。\n" NOR, me);
  if (duration == 2)
    message_vision(RED "$N眼前一黑，五感全无，头像要裂开一样疼。\n" NOR, me);
  if (duration == 1) {
    message_vision(RED "黑血从$N的七窍流了出来，$N腿一蹬，一动也不动了。\n" NOR, me);
    me->die();
  }

  if (duration < 1) return 0;
  return 1;
}
