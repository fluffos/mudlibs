int valid_learn(object me)
{
        object ob;

                if( (string)me->query("gender") !="女性")
                return notify_fail("黯然销魂刀只有女子才能学习!!\n");
    
        if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力不够，没有办法练黯然销魂刀法。\n");

        if( (string)me->query_skill_mapped("force")!= "dream-force")
                return notify_fail("黯然销魂刀法必须配合天姬心法才能练。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "blade" )
                return notify_fail("你必须先找一把刀才能练刀法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="blade" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        int i;
                mapping* m_actions;
                m_actions=me->query("skill_xiaohun-blade");
        i=me->query_temp("WX_perform");
        if( !me->query_temp("WX_perform")) {
           if(me->query("skill_xiaohun-blade")==0) return action[random(7)];
           if(random(2))return action[random(7)];
           m_actions=me->query("skill_xiaohun-blade");
           return m_actions[random(sizeof(m_actions))];
        }
                else 
                {
         return action[i];
                }
                return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return notify_fail("你的内力或气不够，没有办法练习黯然销魂刀法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著所学练了一遍黯然销魂刀法。\n");
        return 1;
}
string perform_action_file(string func)
{
return CLASS_D("dream") + "/xiaohun-blade/" + func;
}
void skill_improved(object me)
{
   int m_skill=me->query_skill("xiaohun-blade",1);

   if(m_skill>200&&m_skill%10==0){
     tell_object(me,BLU"你一阵心酸，你的黯然销魂刀进入了一个新的境界！\n"NOR);
     if(random(me->query("kar"))<20){
        tell_object(me,BLU"你的心中产生了一种失落感！\n"NOR);
        return;
     }
     if(random(me->query("int"))<20){
       tell_object(me,BLU"你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
       return;
     }
     tell_object(me,BLU"你突然福至心灵，对黯然销魂刀领悟出了一招新的用法！\n"NOR);
     tell_object(me,"请为这招取一个名字：");
     input_to( (: call_other, __FILE__, "name_skill", me:));
   }
   return;
}

void name_skill(object me, string arg)
{
   mapping* m_actions;
   mapping m_act=([]);
   int content;
   string msg;

   m_actions=me->query("skill_xiaohun-blade");
   if(!pointerp(m_actions))m_actions=({});

   content=me->query("str")+2*me->query_skill("unarmed",1)/10;
   m_act+=(["damage":content]);
   content=-me->query("spi");
   m_act+=(["dodge" :content]);
   content=-me->query("cps");
   m_act+=(["parry" :content]);
   content=me->query("con")+me->query_skill("force",1)/10;
   m_act+=(["force" :content]);
   m_act+=(["damage_type":"刺伤"]);

   if(!arg||arg==" ")arg="黯然销魂刀必杀技"+chinese_number(sizeof(m_actions)+1);
   m_act+=(["name":arg]);
   msg= skill_head[random(sizeof(skill_head))]+BLINK+HIB"「"+arg+"」"NOR
                  +skill_tail[random(sizeof(skill_tail))];
   m_act+=(["action":msg]);
   m_actions+=({m_act});
   me->set("skill_xiaohun-blade",m_actions);
}

