inherit SKILL;
#include <ansi.h>

string *dodge_msg = ({
        HIW"白光一闪，$n闪到了一边。\n"NOR,
        HIR"红光一闪，$n闪到了一边。\n"NOR,
        HIB"蓝光一闪，$n闪到了一边。\n"NOR,
        HIY"黄光一闪，$n闪到了一边。\n"NOR,
        MAG"紫光一闪，$n闪到了一边。\n"NOR,

});

int valid_enable(string usage)
{
        return (usage=="dodge");
}

int valid_learn(object me)
{
        if( (int)me->query("max_force") < 20 )
                return
notify_fail("你的内力不够，没有办法练灵剑步法。\n");

        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return
notify_fail("你的气或内力不够，不能练灵剑步法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        message_vision("$N按所学练习灵剑步，似乎有所进步。\n", me);
        return 1;
}
string perform_action_file(string func)
{
return CLASS_D("lingjian") + "/lingjian-step/" + func;
}
