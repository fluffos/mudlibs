#include <ansi.h>
inherit SKILL;
void takeforce();
mapping *action = ({
  ([ "action":
    "$N冷冷一笑，一招" HIR "[旷野惊雷]" NOR "，手中$w的直直的向$n砸去",
    "damage": 145,
    "dodge": 20,
    "parry": -15,
    "damage_type": "砸伤",
  ]),
  ([ "action":
    "$N发疯似得乱挥手中的$w，卷起一阵阵的罡风，风中突然向$n的砸去，好一个" HIB "[晴天霹雳]" NOR "",
    "damage": 125,
    "dodge": 20,
    "parry": -15,
    "damage_type": "砸伤",
  ]),
  ([ "action":
    "$N突然一跃而起，手中的$w不停的旋转，从不同的方向砸向$n，这招就是最利害的" HIG "[电闪雷鸣]" NOR "",
    "damage": 160,
    "dodge": 20,
    "parry": -15,
    "damage_type": "砸伤",
  ]),
});

int valid_learn(object me) {
  object ob;
  int forcelev = (int)me->query_skill("iceforce", 1);
  int hammerlev = (int)me->query_skill("pili-hammer", 1);
  int basichammerlev = (int)me->query_skill("hammer", 1);
  int limit, forcelimit;

  if (me->query("family/family_name") != "玄天教")
    return notify_fail("霹雳狂雷乃玄天教不传之密！\n");
  limit = hammerlev;
  if (forcelimit < 30 || (string)me->query("gender") == "男性")
    forcelimit = 30;
  if (forcelev < limit)
    return notify_fail("你对内功领悟不足，无法用内功配合霹雳狂雷的攻势。\n");
  if (basichammerlev < limit)
    return notify_fail("你的基本锤法不够熟练，怎能就学霹雳狂雷？若是伤了自己可不是玩的。\n");
  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力不够，无法随意挥动一个大锤子。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "hammer")
    return notify_fail("手里没有锤子怎么能领悟师父所教的奥妙呢？\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "hammer") || (usage == "parry");
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("force") < 150
    || (int)me->query("kee") < 150)
    return notify_fail("你的内力不够，没有办法练习霹雳狂雷。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  write("你试着练习了一遍霹雳狂雷，发现对于有些地方还要加强。\n");
  return 1;
}
