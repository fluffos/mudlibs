int valid_learn(object me)
{
   object ob;

   if(me->query("family/family_name") != "灵剑门")
     return notify_fail(HIR"灵剑七式"乃灵剑门不传之秘。\n"NOR);
   if( (int)me->query("max_force") < 500 )
     return notify_fail("你的内力不够，没有办法练"HIR"灵剑七式。\n"NOR);
   if( (string)me->query_skill_mapped("force")!= "lingjian-force")
     return notify_fail(HIR"灵剑七式"NOR"必须配合的"HIR"灵剑心法"NOR"才能练。\n");

   if( (int)me->query_skill("sword") < 50 )
     return notify_fail("你的剑法不够纯熟，没有办法学"HIR"灵剑七式。\n"NOR);
   if( (int)me->query_skill("dodge") < 50 )
     return notify_fail("你的轻功不够，没有办法练"HIR"灵剑七式。\n"NOR);

   if( !(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword" )
     return notify_fail("你必须先找一把剑才能练剑法。\n");

   return 1;
}

int valid_enable(string usage)
{
   return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
   return action[random(sizeof(action))];
}

int practice_skill(object me)
{
   if( (int)me->query("kee") < 50
   ||   (int)me->query("force") < 30 )
     return notify_fail("你的内力或气不够，没有办法练习这套剑法。\n");
   me->receive_damage("kee", 30);
   me->add("force", -3);
   write("你抚剑冥思片刻，对剑意又有领悟。\n");
   return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 100 ) return 0;

        if( random(damage_bonus/2) > victim->query_str() ) {
                victim->receive_wound("kee", (damage_bonus - 100) / 4 );
                switch(random(3)) {
                        case 0: return "$n身上出现一道深可见骨的伤口！\n";
                        case 1: return "$N劲力一吐，一道剑气从$w中冲出击中$n的$l！\n";
                        case 2: return "只听见$n发出一声惨叫 ...\n";
                }
        }
}
string perform_action_file(string func)
{
return CLASS_D("lingjian") + "/lingjian-shi/" + func;
}

