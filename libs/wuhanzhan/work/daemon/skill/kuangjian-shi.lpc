inherit SKILL;
#include <ansi.h>

mapping *action = ({
  ([ "action":
    "$N气沉丹田，集真气于手中的$w上，一招" HIR "「狂歌痛饮」" NOR "看似笨拙地砍向$n的$l",
    "dodge": -5,
    "parry": -10,
    "damage": 10,
    "damage_type": "砍伤"
  ]),
  ([ "action":
    "$N作回首挥泪，于转身之际，手中$w顺势扫向$n的$l，这招" HIR "「霸王别姬」" NOR "其中忧郁几人能知？",
    "dodge": -35,
    "parry": -5,
    "damage": 15,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N内力在先，剑势在后，一招" HIR "「万马奔腾」" NOR "，唰唰唰连刺出数十剑，轻快却不失力道",
    "dodge": -10,
    "parry": -15,
    "damage": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N转身背向，$w带着罡风向后歪歪斜斜猛刺一剑，好一式" HIR "「平沙落雁」" NOR,
    "dodge": -30,
    "parry": -20,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N霸气十足，一式" HIR "「一鹤冲天」" NOR "，手中$w夹杂着罡风向$n的$l直插过去",
    "dodge": -10,
    "parry": 0,
    "damage": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中$w一气乱挥，使出" HIR "「横扫千军」" NOR "，道道剑气直逼$n而去",
    "dodge": -10,
    "parry": 15,
    "damage": 40,
    "damage_type": "内伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((string)me->query("family/family_name") != "灵剑门")
    return notify_fail(HIR "狂剑式" NOR "乃灵剑门不传之秘。\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够，没有办法练" HIR "狂剑式。\n" NOR);
  if ((string)me->query_skill_mapped("force") != "lingjian-force")
    return notify_fail(HIR "狂剑式" NOR "必须配合的" HIR "灵剑心法" NOR "才能练。\n");

  if ((int)me->query_skill("sword", 1) < 20)
    return notify_fail("你的剑法不够纯熟，没有办法学" HIR "狂剑式。\n" NOR);
  if ((int)me->query_skill("force", 1) < 20)
    return notify_fail("你的轻功不够，没有办法练" HIR "狂剑式。\n" NOR);

  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}


int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 30)
    return notify_fail("你的内力或气不够，没有办法练习这套剑法。\n");
  me->receive_damage("kee", 10);
  me->add("force", -10);
  write("你挥舞手中长剑，看是粗重无比，其实对狂剑式似乎有所精进。\n");
  return 1;
}

mixed hit_ob(object me, object victim) {
  string msg;
  int ap, dp;
  object weapon;

  ap = me->query_skill("kuangjian-shi", 1) + me->query_str();
  dp = victim->query_skill("force", 1) + victim->query_str();

  weapon = victim->query_temp("weapon");

  if (objectp(weapon) && me->query_skill("kuangjian-shi", 1) > 100) {
    if (random(ap + dp) > dp && random(2) > 0) {
      if (me->query("force") > victim->query("force") * 2) {
        if (me->query_skill("force", 1) < 150) {
          victim->start_busy(1);
          weapon->move(environment(victim));
          victim->receive_damage("kee", 50);
          victim->receive_wound("kee", 25);
          msg = HIR "只听“轰”的一声，$n手中的$w" HIR "已被剑气震飞，虎口也在猛烈撞击下震裂！\n" NOR;
          msg = replace_string(msg, "$w", weapon->name());
        } else {
          victim->start_busy(1);
          msg = HIW "只听“啪”的一声响，$n手中$w" HIW "已被剑气断为两截！\n" NOR;
          msg = replace_string(msg, "$w", weapon->name());

          weapon->unequip();
          weapon->move(environment(victim));
          weapon->set("name", "断掉的" + weapon->query("name"));
          weapon->set("value", 0);
          weapon->delete("long");
          weapon->set("weapon_prop", 0);
        }
      } else {
        msg = HIY "只听一声大响，$n手中的$w" HIY "在无形剑气的冲击下不住颤抖，险些脱手！\n" NOR;
        msg = replace_string(msg, "$w", weapon->name());
      }
    }

    return msg;
  }
}


string perform_action_file(string func) {
  return CLASS_D("lingjian") + "/kuangjian-shi/" + func;
}
