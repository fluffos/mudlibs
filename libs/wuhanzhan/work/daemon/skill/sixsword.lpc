// sixpulse-sword.c 六脉神剑

#include <ansi.h>
#include <weapon.h>

inherit SKILL;

mapping *action = ({
  ([ "name": "关冲剑",
    "action":
    HIB "$N使一招「 关冲剑 」 ，手指犹如狂风骤雨般地向$n的$l连攻数剑" NOR,
    "dodge": -200,
    "parry": -200,
    "damage": 220,
    "damage_type": "刺伤",
    "weapon": "右手食指",
  ]),
  ([ "name": "少泽剑",
    "action": HIR "$N身形一转，一招「少泽剑 ]指向$n的$l" NOR,
    "dodge": -200,
    "parry": -200,
    "damage": 220,
    "damage_type": "刺伤",
    "weapon": "左手食指",
  ]),
  ([ "name": "商阳剑",
    "action":
    HIY "$N舞动指风，一招「商阳剑」挟着闪闪剑光刺向$n的$l" NOR,
    "dodge": -200,
    "parry": -200,
    "damage": 220,
    "damage_type": "刺伤",
    "weapon": "左手中指",
  ]),
  ([ "name": "少冲剑",
    "action":
    MAG "$N小指一抖，使出「少冲剑」往$n的$l刺出一剑" NOR,
    "dodge": -500,
    "parry": -500,
    "damage": 420,
    "damage_type": "刺伤",
    "weapon": "右手小指",
  ]),
  ([ "name": "少商剑",
    "action":
    HIW "$N指剑暴长，一招「少商剑」往$n$l刺去" NOR,
    "dodge": -25,
    "parry": -500,
    "damage": 520,
    "damage_type": "刺伤",
    "weapon": "右手中指",
  ]),
  ([ "name": "中冲剑",
    "action":
    HIC "$N食指直指向$n$l，一招「中冲剑」发出逼人剑气刺去" NOR,
    "dodge": -250,
    "parry": -500,
    "damage": 720,
    "damage_type": "刺伤",
    "weapon": "右手食指",
  ]),
});

int valid_learn(object me) {
  object ob;
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练六脉神剑。\n");

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练六脉神剑必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  int i;
  i = me->query_temp("SPJ_perform");
  if (!me->query_temp("SPJ_perform")) {
    return action[random(6)];
  } else {
    return action[i];
  }
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 10
    || (int)me->query("force") < 10)
    return notify_fail("你的内力或气不够，没有办法练习六脉神剑。\n");
  me->receive_damage("kee", 10);
  me->add("force", -10);
  write(HIR "你按着所学练了一遍六脉神剑。\n");
  return 1;
}

int valid_effect(object me, object weapon, string name, int skill) {}

string perform_action_file(string func) {
  return CLASS_D("fighter") + "/sixsword/" + func;
}
