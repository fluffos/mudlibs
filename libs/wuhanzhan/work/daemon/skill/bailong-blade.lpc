#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N手中$w来回翻转，一招" HIC "「百式·龙翔闪」" NOR " 手中$w以升天飞龙闪电般的速度扑向$n的$l!",
    "dodge": 10,
    "damage": 50,
    "name": "百式·龙翔闪",
    "damage_type": "割伤"
  ]),
  ([ "action": "一招" HIW "「百八式·龙卷闪」" NOR "，右脚轻点地面，$N轻跃半空身型旋风般旋转，$w寒光闪闪，快速冲向$n的$l",
    "dodge": 35,
    "damage": 50,
    "name": "百八式·龙卷闪",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招" HIC "「百贰式·飞龙闪」" NOR "，翻转身型,手臂一抡，刀锋一卷，只见$w刀光不定，急速斩向$n的$l!",
    "dodge": 25,
    "damage": 50,
    "name": "百贰式·飞龙闪",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N互左互右,身型不定使出一招" HIC "「百八式·双龙闪」" NOR "，只见刀光一闪.$w从左右两面横劈向$n的$l!",
    "dodge": 15,
    "damage": 55,
    "name": "百八式·双龙闪",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中的$w一晃，一招" HIC "「百拾式·云龙闪」" NOR "，飘然至$n身前，$w猛然砍向
$n的$l",
    "dodge": 20,
    "damage": 50,
    "name": "百拾式·云龙闪",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N提刀过肩，蓄劲发力，身跃至空使出一招" HIY "「百八式·龙槌闪」" NOR "，$w犹如幻世金龙一般冲向
$n的$l",
    "dodge": 55,
    "damage": 45,
    "name": "百八式·龙槌闪",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招" HIC "「贰七式·苍龙落」" NOR "，只见$w上下挥舞翻飞，刀影重重如晴天霹雳般砍向$n的
$l!",
    "dodge": 20,
    "damage": 35,
    "name": "贰七式·苍龙落",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N使一招" HIW "「百八式·龙牙杀」" NOR "，手中$w刀分几路,阵阵刀影横劈向$n的$l!",
    "dodge": 40,
    "damage": 40,
    "name": "百八式·龙牙杀",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招" HIC "「里百八式·人刀合一」" NOR "，只见$N手中的$w挥舞翻飞，刀以达到了随意，随人，随你的境界。",
    "dodge": 10,
    "damage": 60,
    "name": "里百八式·双龙闪响雷",
    "damage_type": "割伤"
  ]),

});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

string *parry_msg = ({
  "$n一招「撩刀式」，一道刀风悄无声息的点歪了$N的$w。\n",
  "$n使出「伏刀式」，将$N的$w封于丈外。\n",
  "$n使出一招「荡刀式」，手中的$v化做漫天刀影，荡开了$N的$w。\n",
  "$n手中的$v一抖，一招「抖刀式」，向$N拿$w的手腕砍去。\n",
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n反手一招「飞龙闪」，整个人消失在一条刀光之中。\n",
  "$n使出一招「双龙闪」，$v直劈$N的双手。\n",
  "$n将手中的$v化做数条刀影，迫得$N连连后退。\n",
});
int valid_learn(object me) {
  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力不够，勉强练习会走火入魔的。\n");
  if ((int)me->query_skill("dodge") < 60)
    return notify_fail("你的轻功火候太浅，跳两下就头晕，怎么能飞来飞去呢？\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练刀法。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("kee", 50);
  me->add("force", -15);
  return 1;
}
