inherit SKILL;
#include <ansi.h>
mapping *action = ({
  ([ "action":
    HIC "$N发疯般地挥出一棍！" NOR,
    "dodge": -50,
    "parry": -50,
    "damage": 100,
    "damage_type": "砸伤"
  ]),
});
int valid_enable(string usage) {
  return usage == "stick" || usage == "parry";
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
