#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action": "$N使一招" + BLINK "" + HIW "「龙槌闪」" NOR "，身形向上飘起，手中$w虚虚实实幻出万点剑花纷纷扬扬撒向$n$l",
    "dodge": -10,
    "parry": -10,
    "damage": 15,
    "force": 50,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N舞动$w，一式" + BLINK "" + HIY "「龙尾闪」" NOR "，左手向$n面门一晃，右手$w挟着虎虎剑气刺向$n的$l",
    "dodge": -15,
    "parry": -5,
    "damage": 15,
    "force": 80,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N身形绕$n一转，手中$w望空一指，一式" + BLINK "" + HIG "「九头龙闪」" NOR "幻出满天剑影，向$n$l接连挥出数剑",
    "dodge": -25,
    "parry": -15,
    "damage": 15,
    "force": 100,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一声大喝使出" + BLINK "" + HIR "「天翔龙闪」" NOR "，手中$w幻出漫天剑影，迅若奔雷射向$n的$l",
    "dodge": -25,
    "parry": -25,
    "damage": 25,
    "force": 150,
    "damage_type": "刺伤"
  ]),
});
int valid_learn(object me) {
  object ob;

  if ((int)me->query_skill("mindsword", 1) < 9999)
    return notify_fail("心剑不能学。\n");
  return 1;
}
int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  object ob;
  if ((int)me->query("kee") < 100
    || (int)me->query("force") < 50)
    return notify_fail("你的内力或气不够，没有办法练习心剑。\n");
  if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能习练剑法。\n");
  me->receive_damage("kee", 50);
  me->add("force", -20);
  write("你按著所学练了一遍心剑。\n");
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("shushan") + "/mindsword/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int dam;
  dam = me->query_skill("mindsword", 1);
  if ((string)me->query("family/family_name") != "蜀山剑派")
    dam = 0;
  victim->receive_damage("kee", dam);
  victim->receive_wound("kee", dam / 2);
  return HIR "$N的剑顺势在$n身上割出一道更深的伤痕！\n" NOR;
}
