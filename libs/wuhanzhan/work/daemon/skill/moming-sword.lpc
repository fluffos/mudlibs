// wuming-sword
// 无名剑法
// Ken@wh-xyj 
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "name": "悲痛莫名",
    "action": "$N凌空跃起，一招「悲痛莫名」，手中$w一抖顿时化做无数道剑影罩向了$n的全身",
    "dodge": -20,
    "parry": -20,
    "damage": 50,
    "damage_type": "刺伤"
  ]),
  ([ "name": "名动一时",
    "action": "$N手里的$w向天一指，一股雄浑无比的剑气直扑向$n！好一招「名动一时」",
    "dodge": 10,
    "parry": -10,
    "damage": 40,
    "damage_type": "内伤"
  ]),
  ([ "name": "莫名其妙",
    "action": "$N舞动$w，「莫名其妙」一招出，剑果如莫名其妙，直刺向$n的$l",
    "dodge": -10,
    "parry": -10,
    "damage": 35,
    "damage_type": "刺伤"
  ]),
  ([ "name": "剑火无名",
    "action": "但见剑光一闪，$N手中的$w赫然一剑化作万剑,硬生生扫向$n!好一招「剑火无名」",
    "dodge": -10,
    "parry": -10,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "name": "隐姓埋名",
    "action": "$N使出莫名剑法守式「隐姓埋名」,$w挥出一片剑网,将$n团团围住!$n更不知道剑从那里来!从那里去!",
    "dodge": -15,
    "parry": -15,
    "damage": 20,
    "damage_type": "割伤"
  ]),
  ([ "name": "一剑成名",
    "action": "$N脚尖一点地面，飞身而起，在空中一扭腰，朝指一招「一剑成名」刺向$n的$1",
    "dodge": 10,
    "parry": -20,
    "damage": 45,
    "damage_type": "刺伤"
  ]),
  ([ "name": "名不经传",
    "action": "              $N$w疾挥,「名不经传」此招看似普通,其实暗藏玄机!$n退路已封死",
    "dodge": 5,
    "parry": -25,
    "damage": 50,
    "damage_type": "刺伤"
  ]),

});

int valid_learn(object me) {
  object ob;

  if (me->query("family/master_id") != "master hate")
    return notify_fail("你虽会莫名剑法，但不知如何练习。\n");
  if (me->query("betray/count"))
    return notify_fail("你求学之心不专，无缘学得莫名剑法。\n");
  if (me->query("family/family_name") != "魔教")
    return notify_fail("莫名剑法乃无恨不传绝学！\n");
  if ((string)me->query_skill_mapped("force") != "evil-force")
    return notify_fail("莫名剑法需配合魔功才可发挥威力。\n");
  if ((int)me->query("max_force") < 150)
    return notify_fail("你的内力不够，无法学习剑法。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你得先找把剑来才能练剑法．\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  object weapon;

  if (me->query("family/master_id") != "master hate")
    return notify_fail("你虽会莫名剑法,不知如何练习这招。\n");
  if (me->query("betray/count"))
    return notify_fail("你判师欺祖,无缘学得莫名剑法。\n");
  if ((string)me->query_skill_mapped("force") != "evil-force")
    return notify_fail("莫名剑法需配合魔功才能练习．\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你得先找把剑才能练.\n");

  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 30)
    return notify_fail("你的体力不支,最好是先歇歇。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  write("你按照所学,练了一遍莫名剑法。\n");
  return 1;
}


string perform_action_file(string action) {
  return CLASS_D("evil") + "/unknow-sword/" + action;
}
