#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N使出一招" HIG "「劈浪式」" NOR "，手中$w划出一道银弧，，向$n劈了过去",
    "dodge": 20,
    "parry": -15,
    "damage": 30,
    "damage_type": "劈伤"
  ]),
  ([ "action":
    "$N使出一招" HIG "「劈风式」" NOR "，迎风向$n劈了过去",
    "dodge": 20,
    "parry": -10,
    "damage": 25,
    "damage_type": "劈伤"
  ]),
  ([ "action":
    "$N跳在空中，使出一招" HIG "「劈山式」" NOR "，向$n劈了下来",
    "dodge": 15,
    "parry": -15,
    "damage": 35,
    "damage_type": "劈伤"
  ]),
  ([ "action":
    "$N使出一招" HIG "「劈天式」" NOR "，从下至上向$n劈了过去",
    "dodge": 15,
    "parry": -15,
    "damage": 30,
    "damage_type": "劈伤"
  ]),
  ([ "action":
    "$N使出一招" HIG "「劈云式」" NOR "，向$n横劈了过去",
    "parry": -10,
    "dodge": 20,
    "damage": 20,
    "damage_type": "劈伤"
  ]),
});

int valid_learn(object me) {
  object ob;
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练荡魔斧。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "axe")
    return notify_fail("手里没有斧头怎么能领悟斧法呢？\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "axe") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "axe")
    return notify_fail("手中无斧，如何练习斧法？\n");
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 5)
    return notify_fail("你的体力不够练这门斧法，还是先休息休息吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  write("你按着所学练了一遍荡魔斧。\n");
  return 1;
}
