inherit SKILL;
#include <ansi.h>
string level_description(int level) {
  if (level < 10)
    return BLU "贼头贼脑" NOR;
  else if (level < 20)
    return HIB "贼手贼脚" NOR;
  else if (level < 30)
    return HIB "快手快脚" NOR;
  else if (level < 40)
    return CYN "出手如风" NOR;
  else if (level < 50)
    return HIC "手到擒来" NOR;
  else
    return HIW "妙手神偷" NOR;
}
