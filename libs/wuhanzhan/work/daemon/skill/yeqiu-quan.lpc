// liuh-ken.c

inherit SKILL;

mapping *action = ({
  ([ "action": "$N使一招「左勾拳」，对准$n的$l「呼」地一拳",
    "force": 400,
    "parry": -200,
    "dodge": -200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N扬起拳头，一招「右勾拳」便往$n的$l招呼过去",
    "force": 300,
    "parry": -100,
    "dodge": -100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手虚晃，右拳「直拳」便往$n的$l击出",
    "force": 300,
    "parry": -100,
    "dodge": -100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N步履一沉，左拳拉开，右拳使出「后手直拳」击向$n$l",
    "force": 300,
    "parry": -200,
    "dodge": -200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手护住脸部，右拳「摆拳」便往$n的$l击出",
    "force": 300,
    "parry": -200,
    "dodge": -200,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N跨了个斜步，一招「左摆拳」便往$n的$l招呼过去",
    "force": 500,
    "parry": -200,
    "dodge": -200,
    "damage_type": "内伤"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练野球拳必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 0);
  return 1;
}
int effective_level() { return 25; }

string *parry_msg = ({
  "$n以守为攻，一招「后手拳」，猛击$N握$w的手腕。\n",
});

string *unarmed_parry_msg = ({
  "$n左拳击下，右拳自保，一招「摆拳」，将$N封于尺外。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 440;
}
int practice_bonus() {
  return 440;
}
int black_white_ness() {
  return 440;
}
string perform_action_file(string action) {
  return CLASS_D("fighter") + "/yeqiu-quan/" + action;
}
