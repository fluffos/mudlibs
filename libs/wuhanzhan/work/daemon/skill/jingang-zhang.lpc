// jingang-zhang.c 金刚伏魔杖

inherit SKILL;

mapping *action = ({
([      "action":"$N微一躬身，一招「天将崩烈」，$w划出一道寒光，擦地扫向$n的脚踝",
        "dodge" : -20,
        "parry" : -5,
        "damage": 25,
        "skill_name" : "天将崩烈",
        "damage_type":"挫伤"
]),
([      "action":"$N使出一招「天魔覆灭」，右手托住杖端，左掌居中一击，砸向$n的肩头",
        "dodge" : -10,
        "parry" : 10,
        "damage": 35,
        "damage_type":"挫伤"
]),
([      "action":"$N一招「群魔俯首」，举起$w乒乒乓乓地满地乱敲，让$n左闪右避，狼狈不堪",
        "dodge" : -5,
        "parry" : 5,
        "damage": 40,
        "damage_type":"挫伤"
]),
([      "action":"$N一招「面无人色」，举起$w，呆呆地盯了一会，突然猛地一杖打向$n的$1",
        "dodge" : -5,
        "parry" : 5,
        "damage": 30,
        "damage_type":"挫伤"
]),
([      "action":"$N将$w顶住自己的胸膛，一端指向$n，一招「心惊肉跳」，大声叫喊着冲向$n",
        "dodge" : -15,
        "parry" : -15,
        "damage": 40,
        "damage_type":"挫伤"
]),
([      "action":"$N一招「舍身」，全身僵直，蹦跳着持杖前行，冷不防举杖拦腰向$n劈去",
        "dodge" : 5,
        "parry" : -15,
        "damage": 30,
        "damage_type":"挫伤"
]),
