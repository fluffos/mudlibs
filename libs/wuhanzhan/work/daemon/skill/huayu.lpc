#include <ansi.h>
inherit SKILL;
void throw_weapon(object, object, object, int);
void throw_weapon2(object, object, object, int);

mapping *action = ({
  ([ "action":
    "$N双手一晃，使出一招" MAG "「落叶飞花」" NOR "，$w脱手飞出，如一条银蛇般
射向$n的$l！",
    "dodge": -35,
    "damage": 15,
    "post_action": (: throw_weapon :),
    "damage_type": "射伤"
  ]),
  ([ "action":
    "$N右手一抖，一招" MAG "「春风拂面」" NOR "射出的$w夹着劲风袭来，发出刺耳
的破空声直射$n的$l！",
    "dodge": -25,
    "damage": 25,
    "post_action": (: throw_weapon :),
    "damage_type": "射伤"
  ]),
  ([ "action":
    "$N手指微动，不经意间已使出一招" MAG "「香飘玉殒」" NOR "，$w以迅雷不及
掩耳之势向$n的$l激射而来！！",
    "dodge": -40,
    "damage": 10,
    "post_action": (: throw_weapon :),
    "damage_type": "射伤"
  ]),
  ([ "action":
    "$N双手齐挥，动作令人眼花缭乱，一双手似乎化作千百双！$n正惊愕间，
$N已使出一招" MAG "「满天花雨」" NOR "，数不清的$w如疾雨般射向$n！！",
    "dodge": -45,
    "damage": 30,
    "post_action": (: throw_weapon2 :),
    "damage_type": "射伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练满天花雨。\n");


  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "throwing")
    return notify_fail("你必须先找一些暗器才能练满天花雨。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "throwing";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 10)
    return notify_fail("你的内力或气不够，没有办法练习满天花雨。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  write("你按著所学练了一遍满天花雨。\n");
  return 1;
}

void throw_weapon(object me, object victim, object weapon, int damage) {
  if (objectp(weapon)) {
    if ((int)weapon->query_amount() == 1) {
      weapon->unequip();
      tell_object(me, "\n你的" + weapon->query("name") + "用完了！\n");
    }
    weapon->add_amount(-1);
  }
}

void throw_weapon2(object me, object victim, object weapon, int damage) {
  if (objectp(weapon)) {
    if ((int)weapon->query_amount() < 4) {
      weapon->set_amount(3);
      weapon->unequip();
      tell_object(me, "\n你的" + weapon->query("name") + "用完了！\n");
    }
    weapon->add_amount(-3);
  }
}

int effective_level() { return 18; }

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 10;
}
int black_white_ness() {
  return 15;
}
