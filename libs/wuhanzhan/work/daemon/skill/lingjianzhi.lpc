#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N右手并指成剑，一个纵身使出" GRN "「海角天涯」" NOR "劈向$n的$l",
    "dodge": -10,
    "parry": -5,
    "force": 85,
    "damage_type": "砍伤",
    "weapon": "$N的右手掌",
  ]),
  ([ "action": "$N左掌向外一分，右指闪电般点出，一招" GRN "「拨云见日」" NOR "指向$n的$l",
    "dodge": -10,
    "parry": -10,
    "force": 80,
    "damage_type": "刺伤",
    "weapon": "$N的右手食指",
  ]),
  ([ "action": "$N使出" GRN "「分花拂柳」" NOR "，侧身抬臂，右手划了个半圆，击向$n的$l",
    "dodge": -10,
    "parry": -5,
    "force": 85,
    "damage_type": "刺伤",
    "weapon": "$N的右手食指",
  ]),
  ([ "action": "只见$N身形不动，左手虚晃一招，右手食指却径直点向$n的$l，
好一个" GRN "「移星换斗」" NOR "！",
    "dodge": -5,
    "parry": -5,
    "force": 90,
    "damage_type": "刺伤",
    "weapon": "$N的右手食指",
  ]),
  ([ "action": "忽见$N一纵身欺近$n身旁，一招" GRN "「排山倒海」" NOR "左右手并掌
作剑，迅速的朝$n的$l扣来！",
    "dodge": -5,
    "parry": -5,
    "force": 120,
    "damage_type": "砍伤",
    "weapon": "$N的左右手掌",
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练灵剑指必须空手。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("sen", 30);
  me->add("force", -10);

  return 1;
}

string *parry_msg = ({
  "但$n不慌不忙，一招" GRN "「海角天涯」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
  "但$n不慌不忙，一招" GRN "「拨云见日」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
  "但$n不慌不忙，一招" GRN "「分花拂柳」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
  "但$n不慌不忙，一招" GRN "「移星换斗」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
  "但$n不慌不忙，一招" GRN "「排山倒海」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
});

string *unarmed_parry_msg = ({
  "但$n不慌不忙，一招" GRN "「海角天涯」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
  "但$n不慌不忙，一招" GRN "「拨云见日」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
  "但$n不慌不忙，一招" GRN "「分花拂柳」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
  "但$n不慌不忙，一招" GRN "「移星换斗」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
  "但$n不慌不忙，一招" GRN "「排山倒海」" NOR "化指为剑直刺$N面门，
逼的$N回招自救。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string func) {
  return CLASS_D("lingjian") + "/lingjianzhi/" + func;

}
