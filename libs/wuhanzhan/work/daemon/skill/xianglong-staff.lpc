// xianglong-staff.c  降龙杖法

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N使一招「天光乍现」，手中$w扫向$n下盘！",
    "damage": 40,
    "dodge": -10,
    "parry": -40,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N挥起$w，一招「雨後初晴」攻向$n$l！",
    "damage": 40,
    "dodge": -20,
    "parry": -60,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N横过手中$w，使出「天魔覆灭」击向$n$l！",
    "damage": 40,
    "dodge": -10,
    "parry": -40,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N使出一招「游龙穿云」，$w一挺撞向$n$l！",
    "damage": 40,
    "dodge": -10,
    "parry": -40,
    "damage_type": "挫伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if (me->query("betray/count"))
    return notify_fail("你曾欺师判祖，无缘学得降龙杖。\n");
  if (me->query("family/family_name") != "普陀山")
    return notify_fail("降龙杖乃南海不传之密！\n");
  if ((string)me->query_skill_mapped("force") != "lotusforce")
    return notify_fail("降龙杖法只能配合佛门的内功。\n");
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "staff")
    return notify_fail("你先得去找把杖来才能练习！\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "staff") || (usage == "parry");
}

int practice_skill(object me) {

  object weapon;

  if (me->query("betray/count"))
    return notify_fail("你照所学的练了一遍降龙杖，但是发现什么也加。\n");
  if ((string)me->query_skill_mapped("force") != "lotusforce")
    return notify_fail("你用的内功不对。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你得先去找把杖来才能练习\n");

  if ((int)me->query("kee") < 40
    || (int)me->query("force") < 30)
    return notify_fail("你的体力不够练功，还是先休息休息吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  write("你按着所学练了一遍降龙杖。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("bonze") + "/xianglong-staff/" + action;
}
