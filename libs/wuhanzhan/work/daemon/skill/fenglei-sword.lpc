// 【太乙剑法】, taiyi-sword.c

inherit SKILL;
mapping *action = ({
  ([ "action":
    "$N手中$w横扫，一式「狂风拂柳」并自右侧疾点$n的$1",
    "damage": 25,
    "dodge": 20,
    "parry": -15,
    "damage_type": "刺伤",
    "name": "「狂风拂柳」",
  ]),
  ([ "action":
    "$N脚踏迷踪，身形疾转，手中$w似砍似削，卷起狂风怒飚，直刺向$n的$1",
    "damage": 35,
    "dodge": 0,
    "parry": -15,
    "damage_type": "刺伤",
    "name": "「狂风怒飚」",
  ]),
  ([ "action":
    "只见$N笑声不断，全身亦似一无戒备，待$n一愣之际手中$w一招「天外流星」向$n的$1削斜而出",
    "damage": 40,
    "dodge": -20,
    "parry": -15,
    "damage_type": "割伤",
    "name": "「天外流星」",
  ]),
  ([ "action":
    "$N长啸一声，$w上举，立见剑气森森，霞光万道，齐朝$n罩去",
    "damage": 30,
    "dodge": -20,
    "parry": -15,
    "name": "「霞光」",
    "damage_type": "刺伤",
  ]),
  ([ "action":
    "$N手中$w剑影如山，隐含风雷之声，呼呼霍霍，一招「雷霆万钧」向$n的$1击出",
    "damage": 30,
    "dodge": -20,
    "parry": -15,
    "name": "「雷霆万钧」",
    "damage_type": "刺伤",
  ]),
});

int valid_learn(object me) {
  object ob;

  if (me->query("betray/count"))
    return notify_fail("你求学之心不专，无缘学得风雷剑法。\n");
  if (me->query("family/family_name") != "五庄观")
    return notify_fail("风雷剑乃五庄观不传之密！\n");
  if ((string)me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("风雷剑法需配合镇元神功才可发挥威力。\n");
  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力不够，无法学习剑法。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你得先找把剑来才能练剑法．\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}
mapping query_action(object me, object weapon) {
  int total = 2, current;
  if (!me) me = this_object();
  if (me->query_skill("fenglei-sword", 1) > 60)
    total = 3;
  return action[random(total + 1)];
}

int practice_skill(object me) {
  object weapon;
  if (me->query("betray/count"))
    return notify_fail("你判师欺祖，无缘学得风雷剑。\n");
  if ((string)me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("风雷剑法需配合镇元神功才能练习．\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("手中无剑，如何练习剑法？\n");

  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 30)
    return notify_fail("你的体力不够，还是先休息休息吧。\n");
  me->receive_damage("kee", 50);
  me->add("force", -10);
  write("你按着所学练了一遍风雷神剑。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("zhenyuan") + "/fenglei-sword/" + action;
}
void skill_improved(object me) {
  if ((int)me->query_skill("fenglei-sword", 1) % 10 == 0) {
    tell_object(me, "\n由于你勤练剑法，内功也受益不浅。");
    me->add("max_force", (int)(me->query_skill("fenglei-sword", 1) / 10));
  }
  return;
}
