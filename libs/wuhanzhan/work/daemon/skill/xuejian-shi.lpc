inherit SKILL;
#include <ansi.h>

mapping *action = ({
  ([ "action":
    "$N运真气于$w上，荡出阵阵雪花，
于空中画着圆弧舞向$n，一式" HIW "「白雪皑皑」" NOR "让人无法防备",
    "dodge": 25,
    "parry": -10,
    "damage": 10,
    "damage_type": "砍伤"
  ]),
  ([ "action":
    "$N运真气于$w上，荡出阵阵雪花，
接着身形几个回转，带一招" HIW "「漫天飞雪」" NOR "卷向$n",
    "dodge": 35,
    "parry": -5,
    "damage": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N运真气于$w上，荡出阵阵雪花，
回眸一笑间，一剑" HIW "「依依雪心」" NOR "随即递出",
    "dodge": 10,
    "parry": -15,
    "damage": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N运真气于$w上，荡出阵阵雪花，
尔后飞身跃起，一式" HIW "「山舞银蛇」" NOR "从天而降",
    "dodge": 30,
    "parry": -20,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N运真气于$w上，荡出阵阵雪花，
向后一缩身，一式" HIW "「千里冰封」" NOR "自中宫直进，划开一条雪道",
    "dodge": 10,
    "parry": 0,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N运真气于$w上，荡出阵阵雪花，
$w在手中飞快旋转，一式" HIW "「飘雪飞风」" NOR "把$n逼到了死路",
    "dodge": -10,
    "parry": 15,
    "damage": 35,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((string)me->query("family/family_name") != "灵剑门")
    return notify_fail(HIR "雪剑式" NOR "乃灵剑门不传之秘。\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够，没有办法练" HIR "雪剑式。\n" NOR);
  if ((string)me->query_skill_mapped("force") != "lingjian-force")
    return notify_fail(HIR "雪剑式" NOR "必须配合的" HIR "灵剑心法" NOR "才能练。\n");

  if ((int)me->query_skill("sword", 1) < 20)
    return notify_fail("你的剑法不够纯熟，没有办法学" HIR "雪剑式。\n" NOR);
  if ((int)me->query_skill("dodge", 1) < 20)
    return notify_fail("你的轻功不够，没有办法练" HIR "雪剑式。\n" NOR);

  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}


int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 30)
    return notify_fail("你的内力或气不够，没有办法练习这套剑法。\n");
  me->receive_damage("kee", 10);
  me->add("force", -10);
  write("你手中长剑舞出片片雪花，似乎又对雪剑式有所精进。\n");
  return 1;
}

mixed ob_hit(object me, object victim, int damage_bonus) {
  if (me->query_skill("xuejian-shi", 1) > victim->query_skill("dodge", 1)) {
    victim->receive_wound("kee", (damage_bonus - 100) / 4);
    victim->start_busy(3);
    message_vision(HIW "眼看$N这一招正要击中$n，忽然眼前雪花一闪，$n急忙收招！\n" NOR, victim, me);
  }

}



string perform_action_file(string func) {
  return CLASS_D("lingjian") + "/xuejian-shi/" + func;
}
