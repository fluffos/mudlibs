
// 自由搏击

inherit SKILL;

mapping *action = ({
        ([      "action":               "$N左脚前滑，反手一拳打下格开对方功势，运足劲捏紧右拳对准$n的$l「呼」地就是一记重拳",
                "force":                500,
                "parry":                -50,
                "dodge":                -50,
                "damage_type":  "内伤"
        ]),
        ([      "action":               "$N向前猛冲，一记「左正蹬」左腿狠狠$n的$l招呼过去",
                "force":                700,
                "parry":                -100,
                "dodge":                -30,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               "$N左手护住脸部，使出「右踹腿」右腿往$n的$l击出",
                "force":                1000,
                "parry":                10,
                "dodge":                -10,
                "damage_type":  "内伤"
        ]),
        ([      "action":               "$N步履一沉力发至肩就是一记「摆拳」劈向$n的$l",
                "force":                500,
                "parry":                -200,
                "dodge":                -200,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               "$N左手护住脸部，右手「刺拳」便往$n的$l连连击出",
                "force":                300,
                "parry":                -100,
                "dodge":                20,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":               "$N跨了个斜步，一招「左摆拳」便往$n的$l招呼过去",
                "force":                500,
                "parry":                -200,
                "dodge":                -200,
                "damage_type":  "内伤"
        ]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练自由搏击必须空手。\n");
        return 1;
}
int valid_enable(string usage)
{
        return usage=="unarmed";
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("str") < 40 )
                return notify_fail("你的身体体格太差，最好别练这东西。\n");
        if( (int)me->query("con") < 40 )
                return notify_fail("你的根骨不行，学不了这东西。\n");
        me->receive_damage("kee", 0);
        return 1;
}
mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
