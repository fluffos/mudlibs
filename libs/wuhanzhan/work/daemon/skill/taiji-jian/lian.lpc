#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i, lmt;
  object weapon;

  if (me->query_skill("taiji-jian", 1) < 100)
    return notify_fail("你的太极剑火候不足。\n");
  if (me->query("max_force") < 5000)
    return notify_fail("你的内力不足。\n");
  if (me->query("force") < 7000)
    return notify_fail("你的内力不足。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［连字诀］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  msg = HIY "$N使出太极剑的连字诀，身法陡然加快！" NOR;
  message_vision(msg, me, target);
  lmt = me->query_skill("taiji-jian", 1) / 20;
  for (i = 1; i <= lmt; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  }
  me->add("force", -1000);
  me->start_busy(3);
  return 1;
}
