//柔道 

#include <ansi.h>
inherit SKILL;
mapping *action = ({
        ([      "action":               
"$N双掌平伸，缓缓推向$n，似乎蕴藏着极大的力道。眼看逼近$n，
$N突然双掌一错，一招「千页手」幻出无数的掌影击向$n的$l！！",
                "dodge":                15,
                "parry":                 -15,
                "force":                120,
                "damage_type":  "内伤"
        ]),
        ([      "action":               
"$N一纵身欺近$n，使出一招「背摔」抓住$n的领口，就势
狠狠的向地上砸去！",
                "dodge":                5,
                "parry":                -10,
                "force":                90,
                "damage_type":  "砸伤"
        ]),
        ([      "action":               
"$N使出一招「探云手」，右手虚晃一招，左手却找准$n的破绽，
狠狠的击向$n的$l！",
                "dodge":                0,
                "parry":                 -10,
                "force":                85,
                "damage_type":  "内伤"
        ]),
        ([      "action":               
"$N出招迅捷，双掌奔行如电，飞快的拍向$n的$l。这招「奔雷手」
端的势若奔雷，威猛无比！！",
                "dodge":                -5,
                "parry":                -10,
                "force":                85,
                "damage_type":  "内伤"
        ]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练柔道必须空手。\n");
        return 1;
}

int valid_enable(string usage) { return usage=="unarmed" || usage == "parry"; }

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 10 )
                return notify_fail("你的内力不够了，休息一下再练吧。\n");
        me->receive_damage("kee", 30);
        me->add("force", -10);
        return 1;
}
 
mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 100 ) return 0;

        if( random(damage_bonus/2) > victim->query_str() ) {
                victim->receive_wound("kee", (damage_bonus - 100) / 2 );
                switch(random(2)) {
                        case 0: return HIR"只听「喀啦」一声响，好象是骨头折断的声音！\n"NOR;
                        case 1: return HIR"$N劲力一吐，$n的$l发出「喀」的一声闷响！\n"NOR;
                }
        }
}

string *parry_msg = ({
        "但$n不慌不忙，轻描淡写的挥出两掌，便逼的$N回招自救。\n",
        "但$n双掌在空中画个大圆，舞成一片掌影，$N的招数
便被一一化去。\n",
});

string *unarmed_parry_msg = ({
        "但$n不慌不忙，轻描淡写的挥出两掌，便逼的$N回招自救。\n",
        "但$n双掌在空中画个大圆，舞成一片掌影，$N的招数
便被一一化去。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string func)
{
return CLASS_D("lingjian") + "/judo/" + func;
}

