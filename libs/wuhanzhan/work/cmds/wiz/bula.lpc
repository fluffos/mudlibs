// who4.c

inherit F_CLEAN_UP;
#include <ansi.h>
int main(object me, string str) {
  object ob, *ob_list;
  int i;
  seteuid(getuid());
  ob_list = users();
  ob_list = sort_array(users(), "sort_user", this_object());
  str = HIG " 玩家      道行 潜能 法力 内力 \n" NOR;
  str += "——————————————————————————————————\n";
  for (i = 0; i < sizeof(ob_list); i++) {
    ob = ob_list[i];
    str += sprintf(NOR "%-10s  ", ob->name());
    str += sprintf(HIR "%-2d:  ", ob->query("combat_exp"));
    str += sprintf(HIG "%-2d:  ", ob->query("potential"));
    str += sprintf(HIY "%-2d:  ", ob->query("max_mana"));
    str += sprintf(HIB "%-2d:  ", ob->query("max_force"));
  }
  str += "——————————————————————————————————\n";
  //    str = sprintf("%s共有 %d 位使用者连线中。\n", str, sizeof(ob_list));
  me->start_more(str);
  return 1;
}
int sort_user(object ob1, object ob2) {
  if (wizardp(ob1) && !wizardp(ob2)) return -1;
  if (wizardp(ob2) && !wizardp(ob1)) return 1;
  if (wizardp(ob1) && wizardp(ob2))
    return (int)SECURITY_D->get_wiz_level(ob2) - (int)SECURITY_D->get_wiz_level(ob1);

  return (int)ob2->query("mud_age") - (int)ob1->query("mud_age");
}
int help(object me) {
  write(@HELP
指令格式：who4
玩家信息查询。
HELP
  );
  return 1;
}
