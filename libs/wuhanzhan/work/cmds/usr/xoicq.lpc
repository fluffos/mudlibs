//xoicq.c by forsky

inherit F_CLEAN_UP;

int main(object me, string arg)
{
   object ob;

   if( me != this_player(1) ) return 0;

   ob = me->query_temp("link_ob");
   if( !ob ) return 0;
   while( ob && ob->is_character() ) ob = ob->query_temp("link_ob");

   write("请输入新的OICQ号：");
   input_to("get_new_oicq", 1, ob);
   return 1;
}

private void get_new_oicq(string oicq, object ob)
{
   write("\n");
   
   seteuid(getuid());
   if ( !ob->set("oicq",oicq))
   {
   	write("OICQ号码改变失败！\n");
   	return;
   }

   ob->save();
   write("OICQ号码改变成功！\n");
}

int help(object me)
{
   write(@HELP
指令格式 : xoicq  号码
 
这个指令可以修改你的OICQ号码。
 
HELP
    );
    return 1;
}
 
