inherit F_CLEAN_UP;
#include <mudlib.h>
#include <ansi.h>

int telling (object me, object who,string type);

string name;

int main(object me, string arg)
{
        object ob;
        string type,id="";
        if( !arg ) 
          return notify_fail("请使用正确的任务类型。\n");
        if((sscanf(arg,"%s %s",type,id)!=2) &&
           (sscanf(arg,"%s",type)!=1))
          return notify_fail("请输入正确的参数。\n");

        if(id=="") {
                ob = me;
                name = "你";
        } else if (wizardp (me)) {
                ob = find_player(id);
                if(!ob) ob = find_living(id);
                if(!ob) ob = LOGIN_D->find_body(id);
                if(!ob || !me->visible(ob)) return notify_fail("没有这个人。\n");
                name = ob->query("name");
        } else
                return 0;

        telling(me, ob,type);
        return 1;
}

int telling (object me, object who,string type)
{
  mapping mapp;
  string msg;

  if (who->query(type) == 0)
  {
    tell_object(me,name+"没有做过这种类型的任务。\n");
    return 1;
  }


#ifdef INTERMUD_NAME
    msg = "\n"+GRN+"·" + INTERMUD_NAME +"·"+ NOR;
#else
    msg = "\n"+GRN+"·" + MUD_NAME + "·"+"\n\n\n"+NOR;
#endif

 switch(type) {
  case "mieyao" :
              msg+=HIW+name+"的灭妖任务：（最近一次灭妖）\n"+NOR;
              msg+="　　开始时间："+ctime(who->query("mieyao/time_start"))+"\n";
              if(who->query("mieyao/time_end")<=who->query("mieyao/time_start"))
                 msg+="　　完成时间：（尚未完成）\n";
              else   
                 msg+="　　完成时间："+ctime(who->query("mieyao/time_end"))+"\n";
              msg+="　　妖怪："+who->query("mieyao/name")+"("+who->query("mieyao/id")+")\n";
              msg+="　　妖怪初始地点："+who->query("mieyao/where")+"\n";
              msg+="　　目前困难等级："+chinese_number(who->query_temp("mieyao/level"))+"级\n\n";
              msg+=HIY+name+"灭妖所得的奖励：\n"+NOR;
              msg+="　　总共得到"+to_chinese(who->query("mieyao/number"))+"个灭妖任务。\n";
              msg+="　　灭妖成功"+to_chinese(who->query("mieyao/success_number"))+"个。\n";
              msg+="　　共获得：\n";
              msg+="　　　　潜能："+to_chinese(who->query("mieyao/reward/pot"))+"点。\n";
              msg+="　　　　道行："+COMBAT_D->chinese_daoxing(who->query("mieyao/reward/exp"))+"道行。\n";
              msg+="　　　　技能：\n";
              mapp = who->query("mieyao/reward/skills");
              if (mapp)
               {
                 string *my_keys = keys (mapp);
                 int i = sizeof (my_keys);

                 while (i--)
                 {
                  msg+="　　　　　"+to_chinese(my_keys[i])+to_chinese(mapp[my_keys[i]])
                       +"级。\n";
                 }
               }
  }             

  tell_object(me,msg);
  return 1;
}
