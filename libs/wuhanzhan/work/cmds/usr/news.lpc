
#include <ansi.h>;
inherit BULLETIN_BOARD;

string chinese_time(int type,string get_time)
{
        string e_time, week, month, year,time99;
        string c_week, c_year, c_month, c_time;
        int day, hour, minute, second;
        string *month_name = ({"Jan","Feb","Mar","Apr","May","Jun","Jul",
                "Aug","Sep","Oct","Nov","Dec"});
        string *week_name = ({"Mon","Tue","Wed","Thu","Fri","Sat","Sun"});

        if ( stringp(get_time) )
                e_time = get_time;
        else e_time = ctime(time());

        sscanf(e_time,"%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);

        c_week  = chinese_number(member_array(week, week_name) + 1);

        c_month = chinese_number(member_array(month, month_name) + 1);
      
        if(week=="Mon") c_week=HIC" 星期一"; 
        else if(week=="Tue") c_week=HIC" 星期二";  
        else if(week=="Wed") c_week=HIC" 星期三";      
        else if(week=="Thu") c_week=HIC" 星期四";        
        else if(week=="Fri") c_week=HIC" 星期五";      
        else if(week=="Sat") c_week=HIR" 星期六";      
        else if(week=="Sun") c_week=HIR" 星期天";


          if(hour<6 && hour>0)               time99=HIW" 凌晨 "HIC;  
             else if(hour<8 && hour >=6)     time99=HIM" 早上 "HIC;    
             else if(hour<12 && hour>=8)     time99=HIY" 上午 "HIC;   
             else if(hour==12)               time99=HIR" 中午 "HIC;     
             else if(hour<19 && hour>12)     time99=HIC" 下午 "HIC;    
             else if(hour<24 && hour>=19)    time99=HIB" 晚上 "HIC;    
             else if (hour==24 || hour==0)   time99=HIR" 子夜 "HIC;   
    
          if(hour>12) {               
            if(hour==13)            hour=1;      
            else    if(hour==14)            hour=2;     
            else    if(hour==15)            hour=3;    
            else    if(hour==16)            hour=4;    
            else    if(hour==17)            hour=5;     
            else    if(hour==18)            hour=6;      
            else    if(hour==19)            hour=7;      
            else    if(hour==20)            hour=8;    
            else    if(hour==21)            hour=9;   
            else    if(hour==22)            hour=10;     
            else    if(hour==23)            hour=11;    
            else    if(hour==24)            hour=0;    
             }

        c_year  = sprintf("%s%s%s%s",
                         chinese_number(year[0]-48),
                         chinese_number(year[1]-48),
                         chinese_number(year[2]-48),
                         chinese_number(year[3]-48));

        c_year = c_year + "年";
        c_month  = c_month + "月";

        c_time = chinese_number(day) + "日";
        c_time += time99;
        c_time += chinese_number(hour) + "点";
        c_time += chinese_number(minute) + "分";
        // maybe not need srcond to show
        c_time += chinese_number(second) + "秒";

        if (type) {
                switch( type ) {
                        case 5: return c_year+c_month+c_time+c_week;
                        case 2: return c_year+c_month+c_time;
                        case 3: return c_month+c_time+c_week;
                        case 4: return c_month+c_time;
                        case 1: return NOR WHT+year+"年"+(member_array(month, month_name) + 1)+
                                "月"+day+"日"+time99+NOR WHT+hour+"点"+minute+"分"+second+"秒"NOR;
                        case 6: return (member_array(month, month_name) + 1)+
                                "月"+day+"日"+hour+"点"+minute+"分";
                        case 7: 
                                return replace_string(sprintf("%s/%2d/%2d",
 year, (member_array(month, month_name) + 1), day), " ", "0") 
                                       + " " + e_time[11..15]; 
                        case 8: 
                                return replace_string(sprintf("%s年%2d月%2d日",
 year, (member_array(month, month_name) + 1), day), " ", "0") 
                                       + " " + e_time[11..15]; 
                        case 9: return (member_array(month, month_name) + 1)+
                                "月"+day+"日";

                        default: return c_year+c_month+c_time+c_week;
                        }
                }
        return c_year+c_month+c_time+c_week;
}

void create()
{
  set_name(HIY"大话西游"HIG"新闻发布中心"NOR, ({ "NewsBoard", "newsboard" }) );
  set("location", "/d/wiz/newsroom");  
  set("board_id", "news_b");
  set("long",     "这是一个用来发布新闻的留言板。\n" );
  setup();
  set("capacity", 1000);
}

// 这个部份是用来在login时调用的。
int check_news(object me)
{
  int num,i,last_time_read;
  mapping *notes, last_read_time;
  string myid,msg="";
        
  notes = query("notes");
  last_read_time = me->query("board_last_read");
  myid = query("board_id");
        
  if( !pointerp(notes) || !sizeof(notes) ) return 1;

  if(userp(me))
    {
      i=sizeof(notes)-me->query("LRNews");
                
      if(i < 6 && i > 0) // 小于6条新闻才显示标题，不然会FLOOD
      {
       msg = HIC"\n\n━━━━━━━━━━━━━━━━━"HIY"【社区新闻】"HIC"━━━━━━━━━━━━━━━━━\n\n"NOR;
                        
       if( !mapp(last_read_time) || undefinedp(last_read_time[myid]) )  num = 1;
                                
       else
         for(num = 1; num<=sizeof(notes); num++)
         if( notes[num-1]["time"] > last_read_time[myid] ) break;
                                        
         if (mapp(last_read_time)) last_time_read = last_read_time[myid];
         for(i=sizeof(notes)-1 ; i>num-2 ; i--)
         {
          msg += sprintf("%s[%3d]",notes[i]["time"] > last_time_read ? HIR"(未读)"NOR: WHT"(已读)"NOR, i+1);
          msg += sprintf("     %-=30s %18s (%s)\n",
          notes[i]["title"], notes[i]["author"],
          chinese_time(7, ctime(notes[i]["time"])));
         }
       msg += "\n                                                  "HIR"〖"HIY"大话西游 "HIW"巫师组"HIR"〗\n"NOR;
       msg += HIC"━━━━━━━━━━━━━━━━━"BLINK+HIW"《武汉站》"NOR+HIC"━━━━━━━━━━━━━━━━━\n\n"NOR;
       me->start_more(msg);
       }
    i=sizeof(notes)-me->query("LRNews");
                
    write("\n "BLINK+HIR"─→  "NOR+HIG"从您上次阅读到现在"+((i==0)? HIC"没有任何"NOR:HIG"共有 "+(i>5?HIR+chinese_number(i)+NOR:HIY+chinese_number(i)+NOR)+HIG" 条"NOR)+HIG"新闻。"NOR);
    write(HIC"现在消息总数 "+HIR+(sizeof(notes))+HIC" 条。\n\n"NOR);
    if(i>5) write(HIY"你可以 "HIR"help news"HIY" 来查看大话西游新闻系统的使用方法。\n\n"NOR);
    }
}

int main(object me, string arg)
{
  int num,i,last_time_read;
  mapping *notes, last_read_time;
  string myid,msg,title,number;

  last_read_time = me->query("board_last_read");
  myid = query("board_id");
  notes = query("notes");
  i=sizeof(notes)-me->query("LRNews");
  if( !pointerp(notes) || !sizeof(notes) )
          return notify_fail(HIY"大话西游"HIC" 目前没有任何新闻发布。\n"NOR);
                
  if( !arg ) 
    {
     if(i>5) write(HIC"你可以"HIR" Help news "HIC"来查看大话西游 新闻系统的使用方法。\n"NOR); //10
       return notify_fail("大话西游 目前共有"+HIW+chinese_number(sizeof(notes))+NOR"条新闻"+((i==0)? "。":"，您有"+HIY+chinese_number(i)+NOR"条新闻尚未阅读。")+"\n"); }
     if (sscanf(arg,"add %s",title)==1) {
       if (!title) return notify_fail("请指定一个新闻的标题。\n");
       if (!wizardp(me)) return notify_fail("对不起，只有大话西游的巫师才可以发布新闻。\n");
         else {
              do_post(title);
              return 1;
              }
                }
                                
     if( arg=="all") 
       {
        msg = HIY"\n\n≡━━━━━━━━━━━━━━━ "HIW"大话西游  新闻一览"HIY" ━━━━━━━━━━━━━━━≡\n"NOR;
        notes = query("notes");
                        
        if (mapp(last_read_time)) last_time_read = last_read_time[myid];
          for(i=sizeof(notes)-1 ; i>-1 ; i--)
          {
           msg += sprintf("%s[%3d]",notes[i]["time"] > last_time_read ? HIR"(未读)"NOR: WHT"(已读)"NOR, i+1);
           msg += sprintf("     %-=30s %18s (%s)\n", notes[i]["title"], notes[i]["author"], chinese_time(7, ctime(notes[i]["time"])));
           }
        msg += HIY"≡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"BLINK+HIW"《武汉站》"NOR+HIY"━━━≡\n"NOR;
        me->start_more(msg);
        return 1;
      }
     else if ( arg=="new" ) 
            {
             if( !mapp(last_read_time) || undefinedp(last_read_time[myid])) num = 1;
             else
               for(num = 1; num<=sizeof(notes); num++)
               if( notes[num-1]["time"] > last_read_time[myid] ) break;
            } else if( !sscanf(arg, "%d", num) )
                
     return notify_fail("你到底要看第几条新闻呀？\n");
        
     if( num < 1 || num > sizeof(notes) )
       return notify_fail(HIC"看清楚点，好像没有这条新闻耶。\n"NOR);
                
     num--;
     me->start_more( sprintf("\n\n%s\n"HIY"新闻主题："NOR"%s\n"HIY"发布"HIG"神仙："NOR"%s\n"HIY"发布时间："NOR"%s\n"NOR

     CYN"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"NOR,
        "「大话西游」第"+chinese_number(num + 1)+"条新闻 \n"NOR, 
        notes[num]["title"], notes[num]["author"],
        chinese_time(7, ctime(notes[num]["time"]))) 
        + notes[num]["msg"]+
     CYN"\n\t\t\t\t\t\t\t    "HIR"〖"HIG"大话西游 "HIC"巫师组"HIR"〗\n"NOR+
        CYN"━━━━━━━━━━━━━━━━━━"BLINK+HIW"《武汉站》"NOR+CYN"━━━━━━━━━━━━━━━━━━\n\n"NOR, );
     if( !mapp(last_read_time) )
       me->set("board_last_read", ([ myid: notes[num]["time"] ]) );
     else 
       if( undefinedp(last_read_time[myid]) || notes[num]["time"] > last_read_time[myid] )
         last_read_time[myid] = notes[num]["time"];

     if(me->query("LRNews") < num + 1) me->set("LRNews",num+1);
       return 1;
}

void done_post(object me, mapping note, string text)
{
  mapping *notes;

  note["time"] = time();
  note["msg"] = text;
  notes = query("notes");
  if( !pointerp(notes) || !sizeof(notes) )
    notes = ({ note });
  else
    notes += ({ note });

  if( sizeof(notes) > query("capacity"))
    notes = notes[query("capacity")/2 .. query("capacity")];

  set("notes", notes);
  save();
  restore();
  message("channel:chat", HIY"【新闻发布】：武汉站有了最新更新新闻，请用 "HIR"news"NOR HIY" 查看！！！ \n"NOR, users());
 
  tell_object(me, HIG"新闻发表完毕。\n"NOR);

  return;
}

int help(object me)
{
    write(@HELP
「大话西游」新闻系统指令 

指令格式 :
news                    查看共有的和最新发布的新闻。
news all                武汉站新闻一览。 
news new                阅读最新的新闻。 
news add <新闻标题>      写新的新闻。
news <新闻编号>          查看此编号新闻的详细内容。 
HELP
    );
    return 1;
}

