// full.c
#include "/doc/help.h"
#include "ansi.h"
inherit F_CLEAN_UP;
int main(object me, string arg) {
  int force, mana;
  object ob;
  if (arg)
    if (LOGIN_D->find_body(arg))
      ob = LOGIN_D->find_body(arg);
    else
      ob = present(arg, environment(me));
  else
    ob = me;
  if (ob)
    me = ob;
  else return notify_fail("使用错误。\n");
  force = (int)me->query("max_force");
  mana = (int)me->query("max_mana");
  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("max_kee"));
  me->set("eff_gin", me->query("max_gin"));
  me->set("gin", me->query("max_gin"));
  me->set("eff_sen", me->query("max_sen"));
  me->set("sen", me->query("max_sen"));
  me->set("force", force * 2);
  me->set("mana", mana * 2);
  me->set("food", me->max_water_capacity());
  me->set("water", me->max_food_capacity());
  ob->clear_condition();
  //       ob->reincarnate();
  message_vision(HIM + "$N恢复成功了!!" + NOR "\n", me);
  return 1;
}
int help() {
  write(@TEXT
指令格式：full
这个指令让你加满精气神。
TEXT
  );
  return 1;
}
