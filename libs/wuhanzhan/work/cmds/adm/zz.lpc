// zz.c
// desigh by forsky for zhuangzhan 9/1/2000

#define SYNTAX   "指令格式：zz <玩家id> <门派> <内力> <法力> <道行> <skills>\n"

inherit F_CLEAN_UP;

int main(object me, string arg)
{
   string menpai, id, status;
   int fali, neili, sk, dx;
   object who;
   
   status = wizhood(me);
   if( !arg) return notify_fail(SYNTAX);
   if( me!=this_player(1)
       || wiz_level(me) < wiz_level(status) )
       return notify_fail("你没有权力使用这个指令。\n");
   if( sscanf(arg, "%s %s %d %d %d %d", id, menpai, neili, fali, dx, sk)!=6)
	   return notify_fail(SYNTAX);
   
   who = find_player(id);
   if(!who )
	   return notify_fail("没事这个人.\n");
   if( neili < 0)
	   return notify_fail("内力不能小于0");
   if( fali < 0)
	   return notify_fail("法力不能小于0");
   if( sk < 0)
	   return notify_fail("武功不能小于0");
   if( dx < 0)
	   return notify_fail("道行不能小于0");
   if( menpai != "lj" && menpai != "jjf" && menpai != "hell" && menpai != "wzg"
	   && menpai != "wdd" && menpai != "hell" && menpai != "tw" && menpai != "moon"
  && menpai != "lg" && menpai != "fc" && menpai != "putuo" && menpai != "lg" && menpai != "fc" && menpai != "xs")
	   return notify_fail("有这个门派吗?笨蛋!!!\n");

   who->set("combat_exp", dx*1000);
   who->set("max_mana", fali);
   who->set("max_force", neili);
   who->set_skill("unarmed", sk);
   who->set_skill("force", sk);
   who->set_skill("spells", sk);
   who->set_skill("literate", sk);
   who->set_skill("parry", sk);
   who->set_skill("dodge", sk);
   who->set_skill("yaofa", sk);

   switch( menpai )
   {
   case "fc": {
	   who->set_skill("wuxiangforce", sk);
	   who->set_skill("dao", sk);
	   who->set_skill("puti-zhi", sk);
	   who->set_skill("qianjun-bang", sk);
	   who->set_skill("jindouyun", sk);
	   who->set_skill("lianyisword", sk);
	   who->set_skill("stick", sk);
	   who->set_skill("sword", sk);
	   break;
			  }
   case "lg": {
	   who->set_skill("dragonforce", sk);
	   who->set_skill("dragonfight", sk);
	   who->set_skill("seashentong", sk);
             who->set_skill("dragonstep", sk);
            who->set_skill("fork", sk);
	   who->set_skill("hammer", sk);
	   who->set_skill("fengbo-cha", sk);
	   who->set_skill("pangu-hammer", sk);
	   break;
			  }
   case "putuo": {
	   who->set_skill("lotusforce", sk);
	   who->set_skill("lotusmove", sk);
	   who->set_skill("buddhism", sk);
	   who->set_skill("jienan-zhi", sk);
	   who->set_skill("staff", sk);
	   who->set_skill("spear", sk);
	   who->set_skill("lunhun-zhang", sk);
	   who->set_skill("huoyun-qiang", sk);
	   break;
				 }
   case "jjf": {
	   who->set_skill("lengquan-force", sk);
	   who->set_skill("baguazhou", sk);
	   who->set_skill("yanxing-steps", sk);
	   who->set_skill("changquan", sk);
	   who->set_skill("spear", sk);
	   who->set_skill("mace", sk);
	   who->set_skill("bawang-qiang", sk);
	   who->set_skill("wusi-mace", sk);
	   who->set_skill("sanban-axe", sk);
	   who->set_skill("axe", sk);
	   break;
			   }
   case "wdd": {
	   who->set_skill("huntian-qigong", sk);
	   who->set_skill("lingfu-steps", sk);
	   who->set_skill("yinfeng-zhua", sk);
	   who->set_skill("blade", sk);
	   who->set_skill("sword", sk);
	   who->set_skill("kugu-blade", sk);
	   who->set_skill("qixiu-jian", sk);
	   who->set_skill("stealing", sk);
	   break;
			   }
   case "moon": {
	   who->set_skill("moonforce", sk);
	   who->set_skill("moonshentong", sk);
	   who->set_skill("baihua-zhang", sk);
	   who->set_skill("moondance", sk);
	   who->set_skill("sword", sk);
	   who->set_skill("whip", sk);
	   who->set_skill("blade", sk);
	   who->set_skill("snowsword", sk);
	   who->set_skill("jueqingbian", sk);
	   who->set_skill("spring-blade", sk);
	   break;
				}
   case "hell": {
	   who->set_skill("ghost-steps", sk);
	   who->set_skill("tonsillit", sk);
             who->set_skill("gouhunshu", sk);
	   who->set_skill("jinghun-zhang", sk);
	   who->set_skill("stick", sk);
	   who->set_skill("sword", sk);
	   who->set_skill("whip", sk);
	   who->set_skill("zhuihun-sword", sk);
	   who->set_skill("hellfire-whip", sk);
	   who->set_skill("kusang-bang", sk);
	   break;
				}
   case "lj": {
	   who->set_skill("lingjian-force", sk);
	   who->set_skill("lingjian-zhi", sk);
	   who->set_skill("lingjian-shi", sk);
	   who->set_skill("lingjian-step", sk);
	   who->set_skill("lingjianjue", sk);
	   who->set_skill("sword", sk);
	   break;
			  }
   case "tw": {
	   who->set_skill("boro-gong", sk);
	   who->set_skill("feixian-steps", sk);
	   who->set_skill("sanqin-dao", sk);
	   who->set_skill("fumo-shou", sk);
	   who->set_skill("spear", sk);
	   who->set_skill("whip", sk);
	   who->set_skill("axe", sk);
	   who->set_skill("xiangmo-qiang", sk);
	   who->set_skill("dangmo-axe", sk);
	   who->set_skill("duanyun-bian", sk);
	   break;
			  }
   case "xs": {
	   who->set_skill("xiaoyaoyou", sk);
           who->set_skill("ningxie-force", sk);
	   who->set_skill("dengxian-dafa", sk);
	   who->set_skill("cuixin-zhang", sk);
	   who->set_skill("sword", sk);
	   who->set_skill("blade", sk);
          who->set_skill("bingpo-blade", sk);
             who->set_skill("bainiao-jian", sk);
	   break;
			  }
   case "wzg": {
	   who->set_skill("zhenyuan-force", sk);
	   who->set_skill("taiyi", sk);
	   who->set_skill("wuxing-quan", sk);
	   who->set_skill("baguazhen", sk);
	   who->set_skill("blade", sk);
	   who->set_skill("sword", sk);
	   who->set_skill("staff", sk);
	   who->set_skill("hammer", sk);
	   who->set_skill("yange-blade", sk);
	   who->set_skill("fumo-zhang", sk);
	   break;
			  }
   default: break;
   }

   log_file("nosave/ZHUANGZHAN", sprintf("%s(%s) is zhuang by %s(%s) on %s\n",
          who->name(1), geteuid(who), me->name(1), geteuid(me), ctime(time()) ) );
          
   write("玩家"+who->name(1)+"转站成功!\n");
   return 1;
   
}

int help(object me)
{
write(@HELP
指令格式 : zz <玩家id> <门派> <内力> <法力> <道行> <skills> 
用于转站的命令
门派:
jjf     将军府 
xs      大雪山
fc      方寸山
lg      龙宫
putuo   普托
lj      灵剑门
tw      天王府
hell    地府
wdd     无底洞
moon    月宫
wzg     五庄观
道行:如果是3000年,则输入3000
HELP
    );
    return 1;
}
