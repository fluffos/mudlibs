#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        if( !wizardp(me) )
                return notify_fail("目前暂不开放玩家传话。\n");
        if (!arg) return notify_fail("你想要大叫什么？\n");
          shout(HIY +  HIY"【千里传音】"  + me->name() +  "：" + arg + "\n" NOR);
          write(HIY "【千里传音】："+ arg + "\n" NOR);
        return 1;
}
