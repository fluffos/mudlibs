#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  object target;
  if (me->is_fighting())
    return notify_fail("打架的时候逃跑有失骑士风范！\n");
  if ((int)me->query("qishisp") != 1)
    return notify_fail("你好象没有龙可以乘！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (target)
    return notify_fail("你只能对自己念咒！\n");
  write("你要乘龙到哪一个人身边？");
  input_to((: call_other, __FILE__, "select_target", me :));
  return 1;
}

void select_target(object me, string name) {
  object ob;
  if (!name || name == "") {
    write("这次不去了。\n");
    return;
  }
  ob = find_living(name);
  if (!ob || userp(ob)) {
    write("你去不了那里。\n");
    write("你要跑那儿去？");
    input_to((: call_other, __FILE__, "select_target", me :));
    return;
  }
  message_vision(HIB "$N大喝一声：龙神何在！\n天空中忽然飞来一条巨龙，$N高高兴兴的坐了上去。\n" NOR, me);
  me->move(environment(ob));
  message("vision", HIB "\n你的上空中突然飞来一条巨龙，" + me->name() + "拍了拍龙身，跳了下来。\n\n" NOR,
    environment(ob), ({ me }));
}
