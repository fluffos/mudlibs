#include <ansi.h>
#include <skill.h>

inherit F_CLEAN_UP;

int main(object me) {
  if ((int)me->query("shangrensp") != 1)
    return notify_fail("你不会隐形。\n");
  if (me->query("env/invisibility")) return notify_fail("你已经在隐形中了！\n");
  message_vision(BLU "$N喃喃地念了几句咒语。\n" NOR, me);
  me->set("env/invisibility", 1);
  message_vision(BLU "\n正是上忍的潜行术，$N一下就消失了。\n\n" NOR, me);
  return 1;
}
