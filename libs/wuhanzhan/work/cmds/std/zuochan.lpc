#include <skill.h>

inherit F_CLEAN_UP;

  int finish(object me);

int main(object me)
{
        int busy_time;

        seteuid(getuid());
        if( (string)me->query("class")!="bonze")
              return notify_fail("你非佛门中人，无法用坐禅提高自己修为。\n");
        
        if( (string)me->query("family/family_name")!="南海普陀山")
              return notify_fail("你非佛门中人，无法用坐禅提高自己修为。\n");
       
       if(environment(me)->query("short")!="禅房")
              return notify_fail("这里环境不好，不适合坐禅修行。\n");

        if (me->is_busy() || me->query_temp("pending/exercising"))
                return notify_fail("你现在正忙着呢。\n");
        if( me->is_fighting() ) return
notify_fail("战斗中坐禅──找死吗？\n");
        
        if( (int)me->query_skill("buddhism",1) < 120)
              return notify_fail("你佛法修为不够，无法入定。\n");
                    
        if( (int)me->query("sen") < 300 )
                return
notify_fail("你现在精神太差了，无法集中精神坐禅！\n");

        if( (int)me->query("kee") * 100 / (int)me->query("max_kee") < 70 )
                return
notify_fail("你现在身体状况太差了，无法集中精神坐禅！\n");

        if( (int)me->query("gin") * 100 / (int)me->query("max_gin") < 1 )
                return
notify_fail("你现在身体状况太虚弱了，无法进入冥思的状态！\n");

        write("你双手合十，盘膝坐下，达入定的状态。\n");

        me->receive_damage("sen", 30);
        me->receive_damage("kee", 30);

   busy_time=20;
   me->start_busy(busy_time);

   call_out("finish",busy_time, me);
   return 1;
}

int finish(object me)
{
   int qn_gain;

        qn_gain =  (int)me->query_skill("spells")/5; 
             
   me->add("potential", qn_gain );
   me->add("combat_exp", qn_gain );
   
   tell_object(me, "你睁开眼睛，缓缓站了起来。\n");

           tell_object(me, "你的修为提高了！\n");

        me->start_busy(1);   
     return 1;
}
int help(object me)
{
        write(@HELP
指令格式 :zuochan

佛家的坐禅修炼，需要佛法高深才有更高的收获。

请参考 help state 
HELP
        );
        return 1;
}

