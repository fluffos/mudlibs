// guang.c

inherit NPC;
inherit F_MASTER;
int borrow_me(object ob);
void create()
{
   set_name("隐士", ({"yin shi", "yin"}));
   set("title", "伏魔");
   set("gender", "男性" );
   set("age", 53);
   set("long", "一个看起来慈眉善目的老人，正拿着一本书读着．\n");
   set("class", "toaist");
   set("combat_exp", 400000);
   set("attitude", "friendly");
   set("force", 700);
   set("max_force", 700);
   set("force_factor", 40);
   set("max_mana", 700);
   set("mana", 700);
   set("mana_factor", 30);
   set("max_kee", 1000);
   set("max_sen", 1000);
   set("eff_dx", 60000);
   set("nkgain", 250);
   set_skill("dodge", 80);
   set_skill("parry", 80);
   set_skill("puti-zhi", 80);
   set_skill("jindouyun", 80);
   set_skill("unarmed", 80);
   set_skill("dao",100);
   set_skill("force", 141);
   set_skill("literate", 100);
   map_skill("dodge", "jindouyun");
   map_skill("force", "dao");
   map_skill("unarmed", "puti-zhi");
   set("per", 30);
   set("str", 25);
   create_family("枫叶山庄", 2, "弟子");

   set("inquiry", ([
                "book": "我这里有好多书,有一本极为珍贵。",
     "伏魔山心经2": (: borrow_me :), 
     "book": (: borrow_me :),
        ]) );
   set("chat_msg", ({
     "隐士说道：我最近需要一笔黄金！\n",
}));
   set("chat_chance", 5);
   setup();
   carry_object("/d/lingtai/obj/cloth")->wear();
   carry_object("/d/lingtai/obj/daoguan")->wear();
}


int borrow_me(object ob)
{   object m;
   ob = this_player();
                  
                if ( this_player()->query("gei")) {
                    
                if ( this_player()->query("pending/book")) {
                        message_vision("$N对$n说：上次借的还没还，怎么好再借给你呢？\n", this_object(), ob);
                        return 1;
                }
     if( (int)this_player()->query_skill("literate", 1) < 10 ) {
                        message_vision("$N对$n说：你读书写字太差，借给你恐怕也看不懂啊。\n", this_object(), ob);
                        return 1;
                }
     if( (int)this_player()->query_skill("force", 1) < 100 ) {
                        message_vision("$N对$n说：你基本内功太差，借给你恐怕也看不懂啊。\n", this_object(), ob);
                        return 1;
                }
     if( (int)this_player()->query_skill("force", 1) > 141 ) {
                        message_vision("$N对$n说：你基本内功已经相当好了，借给你恐怕你嫌太浅了。\n", this_object(), ob);
                        return 1;
                }                                                

                if ( (int)this_object()->query("forcebook2") ) {
                        message_vision("$N一拱手，说：刚借出去，明天再来吧！\n", this_object());
                        return 1;
                }
                m=new("/d/obj/book/forcebook2");
                m->move(ob);
                ob->set("pending/book", 1);
                this_object()->set("forcebook2", 1);
                message_vision("$N从怀中拿出一本书来递给$n，说：500两黄金只是租给你,记住书要还唷！\n", this_object(), ob);
                return 1;
        }
        message_vision("$N说：你没给钱我怎么租给你！\n", this_object());
        return 1;
        
                       
}

int accept_object(object who,object ob)
{
   int val;
   val = ob->value();
          if (ob->query("id")=="fumo book2") {
      if ( this_player()->query("pending/book") ){
     say("隐士哈哈笑了几声，好借好还，再借不难！\n");
     who->set("pending/book", 0);
     this_object()->delete("forcebook2");
            call_out("destroy", 1, ob);
           return 1;
     }
     else 
     say("隐士道：多谢，多谢！\n");
           call_out("destroy", 1, ob);
     return 1;
     }

      if (val >= 1000000) {
     say("隐士说道：多谢，多谢！太感谢你了！\n");
     who->set("pending/book", 0);
     who->set("gei",1);
           call_out("destroy", 1, ob);
                  return 1;
     }
   else return 0;
}

void destroy(object ob)
{
        destruct(ob);
        return;
}

