
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_for_peace(object me);
string ask_for_war(object me);

void create()
{
   set_name("水镜", ({ "heshang", "shuijing" }));
   set("long", @LONG
一位三十余岁的僧人，他掌握着[空]的奥秘。
LONG);
   set("gender", "男性");
   set("age", 30);
   set("per", 30);
   set("attitude", "peaceful");
   set("class", "bonze");
   set("max_kee", 600);
   set("max_gin", 600);
   set("max_sen", 600);
   set("force", 300);
   set("max_force", 300);
   set("force_factor", 20);
   set("max_mana", 300);
   set("mana", 300);
   set("mana_factor", 20);
   set("combat_exp", 100000);
   set("eff_dx", 35000);
   set("nkgain", 200);

   set_skill("literate", 50);
   set_skill("spells", 60);
   set_skill("buddhism", 50);
   set_skill("unarmed", 30);
   set_skill("jienan-zhi", 30);
   set_skill("dodge", 40);
   set_skill("lotusmove", 40);
   set_skill("parry", 50);
   set_skill("force", 50);
   set_skill("lotusforce", 50);
   set_skill("staff", 30);
   set_skill("lunhui-zhang", 30);
   set_skill("spear", 30);
   set_skill("huoyun-qiang", 30);
   map_skill("spells", "buddhism");
   map_skill("unarmed", "jienan-zhi");
   map_skill("dodge", "lotusmove");
   map_skill("force", "lotusforce");
   map_skill("parry", "lunhui-zhang");
   map_skill("staff", "lunhui-zhang");
   map_skill("spear", "huoyun-qiang");
  
   set("inquiry", ([
       "peace" : (: ask_for_peace :),
       "空" : (: ask_for_peace :),
       "和平": (: ask_for_peace :),
       "杀戮": (: ask_for_war :),
       ]) );
     
   setup();
   carry_object("/d/nanhai/obj/sengpao")->wear();
}

void init()
{
     ::init();
     add_action("do_join", "join");
     add_action("do_left","left");
}

string ask_for_peace(object me)
{
   me=this_player();
   
   if (me->query("peace/player") || me->query("peace/justonetime"))
   return ("施主不是已经问过贫僧这件事情了吗？\n");
   
   me->set_temp("want_peace", 1);
   return ("阿弥陀佛！这[空]字一决进入容易，出来可难比登天，施主真的想进入(join)吗？\n");
}

int do_join(string arg)
{
     object me=this_player();
     
     if(this_player()->query_temp("want_peace")) {
        message_vision("$N答道：弟子愿意。\n\n", me);
     me->set("peace/player", 1);
     me->set("peace/justonetime", 1);
        message_vision(CYN"$n抬手朝$N的前额猛的一拍，喝声「咄！」\n"NOR, me, this_object());
        message_vision(CYN"$N浑身剧震，心中若有所得。\n"NOR, me);
     me->save();
        command("say 善哉善哉！施主从此进入[空]的境界，再无性命之虞矣。\n");
        return 1;
                }
        return 0;
}

string ask_for_war(object me)
{
   me=this_player();
   
   if (me->query("age") <= 1600) {
   me->set_temp("want_left", 1);
   return ("阿弥陀佛！施主当真要解除[空]的保护(left)吗？\n");
   }
   return ("哎！施主性情已定，委实无法消除[空]的影响矣。\n");
}

int do_left(string arg)
{
     object me=this_player();
     
     if(this_player()->query_temp("want_left")) {
        message_vision("$N答道：弟子愿意。\n\n", me);
     me->delete("peace/player");
     this_player()->set("combat_exp", this_player()->query("combat_exp")/100*90);
     this_player()->set("balance", this_player()->query("balance")/100*1);
        message_vision(CYN"$n抬手朝$N的前额猛的一拍，喝声「咄！」\n"NOR, me, this_object());
        message_vision(CYN"$N浑身剧震，心中若有所失。\n"NOR, me);
     me->save();
        command("say 善哉善哉！施主从此不再受到保护，江湖险恶，好自为之吧。\n");
       
        return 1;
                }
        return 0;
}

