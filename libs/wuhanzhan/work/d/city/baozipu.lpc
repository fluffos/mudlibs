//changan city

inherit ROOM;

void create() {
  set("short", "包子铺");
  set("long", @LONG

贾家兄弟几年前合开了这间包子铺，盖因其用料讲究，又有不传秘方，
生意是一日好过一日，在城中也闯出了名声。店中摆了十几张八仙桌，
几个小伙计来来回回忙活着。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "east": __DIR__ "wailiu1",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/jia": 1,
    ]));


  //        set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  //   replace_program(ROOM);
}

void init() {
  add_action("do_pass", "kaimen");
}

int do_pass() {
  object me = this_player();

  if (me->query("id") != "ayani"
    && me->query("id") != "lol")
    return notify_fail("你找来找去，也没有发现任何通道。\n");

  tell_object(me, "你看见前面似乎有一道暗门，便试着轻轻一推。。。\n");
  tell_room(environment(me), me->name() + "打开了一扇偏门，走了进去。\n",
    ({ me, me }));
  me->move("/u/lol/room/hanxiu");
  tell_room(environment(me), me->name() + "走了过来。\n", ({ me, me }));
  return 1;
}
