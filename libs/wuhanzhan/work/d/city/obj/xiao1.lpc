#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create() {
  set_name(HIG "天秀箫" NOR, ({ "yu xiao", "xiao", "sword" }));
  set_weight(1200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一支五彩美玉制成的" HIG "长箫" NOR "，既可吹出动人的乐曲，\n"
      "也可作为战斗的武器，可是雅雅小姐的随身宝物。\n");
    set("unit", "支");
    set("value", 50000);
    set("no_sell", "这支玉笛是宝物，怎么能随便卖呢？\n");
    set("material", "jade");
  }
  init_sword(10);
  set("wield_msg", "$N轻轻从怀中取出" + HIG "天秀箫" NOR + "，单手一握，脸上荡漾起些微的笑意。\n");
  set("unwield_msg", "$N把" + HIG "天秀箫" NOR + "一收，在手中转了数圈，轻轻巧巧地放回怀里。\n");
  setup();
}

int query_autoload() {
  if (!this_player()
    || (this_player()->query("id") != "yaya"))
    return 0;
  return 1;
}

int IsAutoLoad() { return 1; }
