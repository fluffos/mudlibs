// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
inherit ITEM;
inherit F_FOOD;

int query_autoload() { return 1; }

void create() {
  set_name("仙豆", ({ "xian dou", "dou" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗不起眼的豆子。\n");
    set("unit", "颗");
    set("value", 20);
    set("food_remaining", 90000000000);
    set("food_supply", 100);
  }
}
