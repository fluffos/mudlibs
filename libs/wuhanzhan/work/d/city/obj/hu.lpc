// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// jiudai.c  酒袋

inherit ITEM;
inherit F_LIQUID;
inherit F_AUTOLOAD;

int query_autoload() { return 1; }
void create()
{
   set_name("次元壶", ({"ciyuan", "hu", "skin"}));
   set_weight(100);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("long", "看起来只是普通的水壶,但是里边似乎有海浪的声音。\n");
     set("unit", "个");
     set("value", 20);
     set("max_liquid", 9000000000);
   }

   // because a container can contain different liquid
   // we set it to contain wine at the beginning
   set("liquid", ([
     "type": "spring",
     "name": "泉水",
     "remaining": 9000000000,
     "drunk_supply": 100,
   ]));
}


