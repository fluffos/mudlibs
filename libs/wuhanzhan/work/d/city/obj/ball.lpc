//ball.c bye error  5.2.2000

#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("水晶球", ({"shuijing qiu", "ball"}));
        set_weight(300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", 
"一只鎏光四溢的水晶球，虽然不能未卜先知，后见之明(detect)倒也马马虎虎。\n");
                set("unit", "只");
                set("value", 50000);
                set("sell", 1);
        }
}
void init()
{
   add_action("do_detect","detect");
  add_action("do_zhanbu", "zhanbu");
}
int do_detect(string arg)
{
  object who = this_player();
  object me,target;
  int data,data1,data2;

  mapping mem;
  string *ob,temp,msg;
  if(query("search")>time())
           return notify_fail("正在搜索中......请稍后再试！\n");
  if (!arg || sscanf(arg,"%d",data)!=1)
           return notify_fail("用法： ｄｅｔｅｃｔ （１－１０）\n");
  if (data>10 || data<1) return notify_fail("用法错误！\n");
  if(!(me=find_living("qianli yan")))
       {
          me = load_object("/d/ourhome/npc/bigeye");
       }
  if (!me->query("memory/"+arg))
           return notify_fail("查不到你要的记录！\n");
  mem = me->query("memory/"+arg);
  ob = keys(mem);
  temp = ob[0];
  msg = mem[temp][0];
  message_vision(HIG"$N捧着水晶球，口中喃喃自语。\n"NOR,who);
  tell_object(who,CYN"你请教水晶球：刚才「"+msg+"」是谁说的？\n"NOR);
  if (!target=find_player(temp))
      {
         tell_object(who,HIB"水晶球回答你：天机不可泄露。\n"NOR);
         return 1;
      }
  data1=target->query("combat_exp");
  data2=target->query("combat_exp");
  if ( data2+random(data2/2) > data1+random(data1/2))
      {
         set("search",time()+5);
         call_out("wait_one",1,who,target);
      }
  else
      tell_object(who,HIB"水晶球回答你：天机不可泄露。\n"NOR);
  return 1;
}

int wait_one(object ob,object target)
{
   tell_object(ob,MAG"水晶球缓缓的转动着，你仿佛从中看到了一个身影。\n"NOR);
   call_out("wait_two",2,ob,target);
   return 1;
}
int wait_two(object ob,object target)
{
   tell_object(ob,HIR"人影越来越清晰，你仔细一看，原来是"HIW+
      target->query("name")+HIR"("+target->query("id")+")！\n"NOR);
   delete("search");
   return 1;
}

int do_zhanbu(string arg)
{
        object ob, zhanbu, *ob_list;
        object me = this_player();    
        object ball=this_object();

       		if (!arg)
			return notify_fail("指令格式：zhanbu <人物>\n");        
                if (me->query("mana")<200)
		    	return notify_fail("你的法力不够，无法与水晶球沟通。\n");	  
                if( me->query("family/family_name")!= "五庄观" )
                        return notify_fail("你非五庄观弟子，怎么也弄不懂这八卦的法门。\n");
		if( me->query("combat_exp") < 1500000)
                        return notify_fail("你道行还不够耶...");
                if (ball->query("xianzhi") > 19)// skyhawk 2002/11 增加限制
                    {
                 message_vision ("天空中伸出一只大手把$N的水晶球拿走了。\n",me);
                 destruct (ball);
                  return 1;
     }
                me->add("mana",-200);
                ball->add("xianzhi",1);
        	message_vision(HIW"$N捏着手指，按照子、丑、寅、卯、辰、巳、午、未、申、酉、戌、亥的方位，仔细的掐算着。。。\n"NOR, me);
		ob = find_player(arg); //just only for finding the player
		if (!ob || (ob->query("env/invisibility") && wizardp(ob) )) 
	  		return notify_fail(CYN"这个人好象不在线耶...\n"NOR);
		zhanbu = environment(ob);
        	if (!zhanbu) 
			return notify_fail(CYN"这个人不知道在那里耶...\n"NOR);
		if(wizardp(ob))
			return notify_fail(CYN"水晶球里始终雾气蒙蒙，你什么也看不清！\n"NOR);
		tell_object(me,HIM"水晶球缓缓的转动着，你仿佛从中看到了一个身影。\n"); 
        	printf(HIM"原来%s(%s)在%s活动耶...。\n"NOR,(string)ob->name(),(string)ob->query("id"),(string)zhanbu->query("short"));
        	return 1;
}
