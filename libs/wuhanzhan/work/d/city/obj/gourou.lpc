#include <ansi.h>

inherit ITEM;
void init();

void init()
 {
      add_action("do_eat", "eat");
 }
void create()
{
     set_name("红烧狗肉", ({"gourou"}));
     set_weight(20); 
     if (clonep())
                set_default_object(__FILE__);
        else {
        set("long","gourou。\n"NOR);                         }
        setup();
}
int do_eat(string arg)
{
        object victim = this_player();
        if (!id(arg))
                return notify_fail("你想要什么？\n");
      victim->add("potential",1);  
//      victim->set("always_young",1);
      log_file("nosave/zuobi",
      sprintf("%s(%s) eat gouruo on %s\n",
        victim->name(1), geteuid(victim), ctime(time()) ) );
        victim->save();
        destruct(this_object());
        return 1;
}
