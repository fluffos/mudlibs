inherit NPC;
void create()
{
        set_name("飞贼", ({ "fei zei", "zei" }));
        set("age", 18+random(10));
        set("gender", "男性");
        set("long","一个飞贼，武功似乎不怎么样。\n");
        set("attitude", "peaceful");
   set("str", 20);
        set("combat_exp", 100000);
   set("max_kee", 1500);
   set("max_sen", 1500);
   set("max_force", 1500);
   set("max_mana", 1500);
   set("force", 2000);
   set("force_factor", 10);
        set_skill("blade", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        setup();
        carry_object("/d/obj/weapon/blade/blade")->wield();
        carry_object("/d/city/npc/obj/gudong");
}
