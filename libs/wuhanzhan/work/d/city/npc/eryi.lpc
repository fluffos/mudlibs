// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
inherit NPC;
int ask_me (object me);

void create()
{
        set_name("二姨太", ({"er yitai", "yitai"}));
        set("age", 22);
        set("gender", "女性");
        set("long",
"金家的二姨太太，见你看她，对你抛了个媚眼．\n");
        set("attitude", "friendly");
   set("per", 22);
        set("combat_exp", 1000);
        set("shen_type", 1);
        set_skill("unarmed", 10);
        set_skill("dodge", 40);
   set("inquiry", ([
     "小孩失踪": (: ask_me :),
        ]) );
   setup();

        carry_object("/d/obj/cloth/nichang")->wear();
   carry_object("/d/obj/cloth/yuanxiang")->wear();
}
void inform_player (string msg, object who)
{
  object me = this_object();
  message_vision (msg, me, who);
}
int ask_me(object me)
{
  object who = this_player();
  string msg = "$N说道：城西山洞里面有一个叫食婴鬼的大魔头，我估计小孩失踪跟它有关。\n";
  if ((int)who->query_temp("chengwei/yin_asked") != 1)
  {
    return 1;
  }  
  if (who->query("chengwei/lv101") == "done" )
  {
    return 1;
  }  
  if ((int)who->query_temp("chengwei/er_asked") == 1)
  {
    return 1;
  }
  inform_player (msg,who);
  who->set_temp("chengwei/er_asked",1);
  who->add_temp("chengwei/changanask",1);
  return 1;
}
