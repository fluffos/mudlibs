// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name(HIR "萧振远" NOR, ({ "xiao zhenyuan", "xiao", "zhenyuan" }));
  set("title", HIW "大英雄" NOR);
  set("gender", "男性");
  set("combat_exp", 500000);
  set("age", 64);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set("vendor_goods", ([
    "whip": "/d/obj/weapon/whip/liehuowhip",
    "ring": "/d/obj/weapon/unarmed/ring",
    "blade": "/d/obj/weapon/blade/blade1",
    "fork": "/u/ken/sd/fork",
    "chu": "/d/obj/weapon/staff/chu",
    "mace": "/d/obj/weapon/mace/ygmace",
    "bang": "/d/obj/weapon/stick/bang1",
    "hammer": "/d/obj/weapon/hammer/hammer1",
    "axe": "/d/obj/weapon/axe/kuangxieaxe",
    "spear": "/d/obj/weapon/spear/bwq",
    "sword": "/d/obj/weapon/sword/sword",
  ]));

  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
  add_money("silver", 5);
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 3, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  command("xia");
}
