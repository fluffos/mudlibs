// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit NPC;
int ask_me(object me);

void create() {
  set_name("李丁", ({ "li ding", "li", "guanjia" }));
  set("title", "大管家");
  set("gender", "男性");
  set("age", 65);

  set("combat_exp", 12500);
  set_skill("unarmed", 30);
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 5);
  set_skill("dodge", 40);
  set_skill("parry", 30);
  set("inquiry", ([
    "小孩失踪": (: ask_me :),
  ]));
  setup();

  carry_object("/d/gao/obj/magua")->wear();
  add_money("silver", 10);

}
void inform_player(string msg, object who) {
  object me = this_object();
  message_vision(msg, me, who);
}

int ask_me(object me) {
  object who = this_player();
  string msg = "$N说道：城西山洞里面有一个叫食婴鬼的大魔头，我估计小孩失踪跟它有关";
  if ((int)who->query_temp("chengwei/yin_asked") != 1) {
    return 1;
  }
  if (who->query("chengwei/lv101") == "done") {
    return 1;
  }
  if ((int)who->query_temp("chengwei/liding_asked") == 1) {
    return 1;
  }
  inform_player(msg, who);
  who->set_temp("chengwei/liding_asked", 1);
  who->add_temp("chengwei/changanask", 1);
  return 1;
}
