int do_newname(string arg)
{
   object me=this_player();
  int afford;

  if (uptime()-me->query_temp("cname_time") < 360)
      return notify_fail("对不起，请稍候片刻。\n");

  if (!arg) return notify_fail(@LONG
格式： newname <新名字> 
价格： 二千两黄金存款

LONG);


     arg = CONVERT_D->input(arg,me);

        if( !check_legal_name(arg) ) {

                write("你输入的名字不合法!请重新输入!\n");
                return 1;
            } else
{
  if( me->query("balance") < 20000000 )  {
     write("你的存款不够。\n");
        return 1;
  } 

  message_vision("$N说道：费用两千两黄金已从你的存款中扣除。\n",this_object());
  message_vision("$N点了点头，拿出一份卷宗写了几笔。\n",this_object());
  me->add("balance",-20000000);
  me->set("name",arg);
  if( me->query_temp("link_ob") )
  {
    me->query_temp("link_ob")->set("name",arg);
  }
    message("shout",HIW"【闲聊】长孙无忌(Zhangsun wuji)：("+me->query("id")+")已改名为"+HIR+me->name()+HIW+"。\n"NOR,users());
    me->set_temp("cname_time",uptime());
    me->start_busy(5);
    write("你的名字更改完毕。\n");
        return 1;
}
}

int check_legal_name(string name)
{
        int i;

        i = strlen(name);
        
        if( (strlen(name) < 2) || (strlen(name) > 12 ) ) {
                write("对不起，你的中文名字必须是一到六个中文字。\n");
                return 0;
        }
        while(i--) {
                if( name[i]<=' ' ) {
                        write("对不起，你的中文名字不能用控制字符。\n");
                        return 0;
                }
                if( i%2==0 && !is_chinese(name[i..<0]) ) {
                        write("对不起，请您用「中文」取名字。\n");
                        return 0;
                }
        }
        if( member_array(name, banned_name)!=-1 ) {
                write("对不起，这种名字会造成其他人的困扰。\n");
                return 0;
        }
        return 1;

}

