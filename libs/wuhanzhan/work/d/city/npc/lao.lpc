#include <ansi.h>
inherit NPC;
void create()
{
        set_name("老头", ({ "old man", "lao tou" }) );
        set("gender", "男性" );
        set("title", "无依无靠的");
        set("age", 99);
        set("long", 
            "他是一个可怜的老头，好像十几天都没吃饭了。");
        set("str", 100);
        set_skill("unarmed", 30);
        set("combat_exp", 6666);
        set("attitude", "friendly");
        setup();
        carry_object("/d/obj/cloth/choupao")->wear();
}

int accept_object(object me, object obj)
{
  if(obj->query("money_id")) {
    if(me->query("killers")) {
        if (obj->value()>= 100000000)  {  
        command ("say 多谢了。");
        command ("bow "+me->query("id"));
        me->add("killers", -1);
        return 1;
        }
        else {
        command("say 多谢了。");
        command("thank "+ me->query("id"));
        return 1;
        }
    }
    else {
        command("say 早该这样了。");
        command("consider "+ me->query("id"));
        return 1;
    }
  }
  else return 0;
}
