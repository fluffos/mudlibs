#include <ansi.h>
inherit NPC;

#include "greeting.h"
#include "/u/skyhawk/npc/kill.h"; 

void create()
{
        set_name(HIR"红衣卫士"NOR, ({ "daidao weishi", "weishi" }));
        set("age", 28+random(10));
        set("gender", "男性");
        set("long","红衣卫士是经过wiz严格训练出来的.他们负责保护城市的安全.\n");
        set("attitude", "peaceful");
   set("str", 20);
  set("红衣卫士","weishi");
        set("combat_exp", 200000000);
  set("kee", 30000);
  set("sen", 30000);
  set("eff_kee", 30000);
  set("eff_sen", 30000);
  set("max_kee",30000);
  set("max_sen",30000);
  set("max_mana", 30000);
  set("max_force", 30000);
  set("force", 80000);
  set("mana", 80000);
   set("force_factor", 500);
        set_skill("unarmed", 400);
        set_skill("dodge", 400);
        set_skill("parry", 400);
        set_skill("blade", 400);
        set_skill("force", 400);

        setup();
        carry_object("/d/obj/weapon/blade/blade")->wield();
        carry_object("/d/obj/cloth/bingfu")->wear();
}


