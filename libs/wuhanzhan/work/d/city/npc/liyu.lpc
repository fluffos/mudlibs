// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
inherit NPC;
int ask_me (object me);
string fan_me(object me);

void create()
{
        set_name("李玉娘", ({"li yuniang", "li"}));
        set("age", 28);
        set("gender", "女性");
        set("long",
"李玉娘是袁天罡的老婆，正在洗菜做饭。\n");
        set("attitude", "friendly");
   set("per", 25);
        set("combat_exp", 4000);
        set("shen_type", 1);
        set_skill("unarmed", 20);
   set_skill("parry", 20);
        set_skill("dodge", 40);
        set("inquiry", ([
"袁天罡": "气死人了，这么晚了也不回家吃饭！也找不到个人把饭送去！\n",
"送饭": (: fan_me :),
     "小孩失踪": (: ask_me :),
]));

   setup();

        carry_object("/d/obj/cloth/pink_cloth")->wear();
   carry_object("/d/city/obj/fanhe");
}
string fan_me(object me)
{   object who;
   who=this_player();
   
   if(present("fan he", me)){
   command("give fan to " + who->query("id"));
   return "多谢了，快去吧！";
   }
}
void inform_player (string msg, object who)
{
  object me = this_object();
  message_vision (msg, me, who);
}
int ask_me(object me)
{
  object who = this_player();
  string msg = "$N说道：城西山洞里面有一个叫食婴鬼的大魔头，我估计小孩失踪跟它有关。\n";
  if ((int)who->query_temp("chengwei/yin_asked") != 1)
  {
    return 1;
  }  
  if (who->query("chengwei/lv101") == "done" )
  {
    return 1;
  }  
  if ((int)who->query_temp("chengwei/liyu_asked") == 1)
  {
    return 1;
  }  
  inform_player (msg,who);
  who->set_temp("chengwei/liyu_asked",1);
  who->add_temp("chengwei/changanask",1);
  return 1;
}
