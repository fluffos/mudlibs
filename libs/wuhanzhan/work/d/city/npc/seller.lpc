// seller.c

#include <ansi.h>;
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("柜台小姐", ({ "lady", "girl" }));
  set("gender", "女性");
  set("age", 18);
  set("title", HIM "MUD异动业务" NOR);
  set("long", "一位可爱美丽的女生。\n");
  set("combat_exp", 1000);
  set("attitude", "peaceful");
  set("per", 40);
  set("vendor_goods", ([
    "dan2": "/d/obj/drug/psd",
    "qdan": "/d/obj/drug/qdan",
  ]));
  setup();
  add_money("silver", 5);
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
