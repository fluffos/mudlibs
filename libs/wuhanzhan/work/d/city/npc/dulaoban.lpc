inherit NPC;
int quest_me(object me);
void create() {
  set_name("杜老板", ({ "du laoban", "du", "laoban" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "一团和气的一个商人，不过好象遇到什么难事了，可以问问他有什么难处。\n");
  set("attitude", "friendly");
  set("per", 25);
  set("inquiry", ([
    "难处": (: quest_me :),
  ]));
  setup();
}
void inform_player(string msg, object who) {
  object me = this_object();
  message_vision(msg, me, who);
}
int quest_me(object me) {
  object who = this_player();
  string msg = "$N说道：这位" + RANK_D->query_respect(who);
  if (who->query("combat_exp") < 100000) {
    inform_player(msg + "道行不够，还是先练练吧！\n", who);
    return 1;
  }
  if (who->query("chengwei/lv102") == "done" ||
    who->query_temp("chengwei/du_asked")) {
    inform_player(msg + "，你不是已经完成这个任务了吗？\n", who);
    return 1;
  }
  inform_player(msg + "，我的古董被飞贼抢走了，他现在在城西，你能帮我抢回来吗？\n", who);
  who->set_temp("chengwei/du_asked", 1);
  return 1;
}
int accept_object(object me, object ob) {
  object who = this_player();
  string msg = "$N说道：这位" + RANK_D->query_respect(who);
  if ((string)ob->query("id") != "gudong") {
    command("say 什么东西，我不要它！\n");
    return 0;
  }
  if (who->query("chengwei/lv102") == "done") {
    inform_player(msg + "，你不是已经完成这个任务了吗？\n", who);
    return 1;
  }
  inform_player(msg + "帮我寻回古董，真是谢谢你了。\n", who);
  who->add("combat_exp", 20000);
  who->add("potential", 20000);
  who->add("shengwang", 20);
  who->set("chengwei/lv102", "done");
  call_out("destroy", 1, ob);
  return 1;
}

void destroy(object ob) {
  destruct(ob);
  return;
}
