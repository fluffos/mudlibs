inherit NPC;

void create()
{
  set_name("食婴鬼", ({ "shiying gui", "gui"}));
  set("long", "一位身着金甲的妖怪。\n");
  set("gender", "男性");
  set("age", 26);
  set("attitude", "friendly");
  set("per", 30);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 4000);
  set("max_force", 2500);
  set("force_factor", 50);
  set("max_mana", 1600);
  set("mana", 1600);
  set("mana_factor", 20);
  set("combat_exp", 500000);
  set_skill("spells", 30);
  set_skill("dao", 30);
  set_skill("unarmed", 85);
  set_skill("hammer", 150);
  set_skill("dragonfight", 85);
  set_skill("dodge", 80);
  set_skill("pangu-hammer", 150);
  set_skill("dragonstep", 120);
  set_skill("parry", 85);
  set_skill("force", 70);
  set_skill("dragonforce", 120);
  map_skill("spells", "dao");
  map_skill("unarmed", "dragon-step");
  map_skill("hammer", "pangu-hammer");
  map_skill("dodge", "dragonstep");
  map_skill("force", "dragonforce");
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/hammer/bahammer")->wield();
}

void destruct_me (object me)
{
  destruct (me);
}

void die ()
{
  object me = this_object();
  object ob = query_temp("my_killer");

  if (ob->query("chengwei/lv104") != "done" && (int)ob->query_temp("chengwei/yuan_asked") == 1){
    ob->set("chengwei/lv104","done");
    ob->add("combat_exp",30000);
    ob->add("potential",30000);
    ob->add("shengwang",40);
  }
  message_vision ("\n$N死了。\n",me);
  me->move("/obj/empty");
  call_out ("destruct_me",3,me);
}


void unconcious ()
{
  die ();
}

int accept_fight(object ob)
{
  ob->apply_condition("killer", 100);
  kill_ob(ob);
  return 1;
}

void kill_ob (object ob)
{
  object me = this_object();

  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

