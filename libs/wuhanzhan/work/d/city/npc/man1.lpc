inherit F_VENDOR_SALE;
#include <ansi.h>

void create() {
  reload("xiao");
  set_name(HIG "小小" NOR, ({ "suozhang xiaoxiao", "xiaoxiao" }));
  set("title", HIW "厕所所长" NOR);
  set("gender", "男性");
  set("combat_exp", 200000);
  set("age", 20);
  set("per", 20);
  set("str", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("dodge", 100);


  setup();

  carry_object("/d/obj/cloth/linen")->wear();
}

void init() {
  object ob = this_player();
  object me = this_object();

  ::init();

  if (((string)ob->query("gender") == "女性") &&
    ((int)ob->query("env/invisibility") == 0) &&
    ((string)environment(me)->query("short") == HIM "【收费男厕】" NOR)) {

    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;

  switch (random(1)) {
    case 0:
      command("rumor* 只听小小高声喊道：" HIR + ob->query("name") + HIM "，你这个臭流氓！居然闯到男厕所来了！\n" NOR);
      command("kick " + ob->query("id"));
      ob->move("/d/city/menwc");
      ob->unconcious();

      break;
  }
}

int accept_object(object who, object ob) {
  if (ob->query("money_id", "gold") && ob->value() >= 100000)
    who->set("water", 0);
  if (ob->query("money_id", "gold") && ob->value() >= 100000)
    who->set("food", 0);
  {
    tell_object(who, "厕所所长一哈腰，说道：多谢您老，欢迎再次光临。\n");


    return 1;
  }
  return 0;
}
