// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit NPC;
int quest_me(object me);
int done_me(object me);

void create() {
  set_name("殷开山", ({ "yin kaishan", "yin", "kaishan" }));
  set("title", "大总管");
  set("gender", "男性");
  set("age", 70);
  set("str", 20);
  set("dex", 20);
  set("long", "他就是当朝大总管殷开山，举手投足之间，不怒自威。\n");
  set("combat_exp", 80000);
  set("attitude", "friendly");
  set("force_factor", 10);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set("max_kee", 700);
  set("max_sen", 700);
  set("force", 500);
  set("max_force", 500);

  set("inquiry", ([
    "quest": (: quest_me :),
    "done": (: done_me :),
  ]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
  add_money("silver", 20);

}

void inform_player(string msg, object who) {
  object me = this_object();
  message_vision(msg, me, who);
}
int accept_object(object who, object ob) {
  int val;
  val = ob->value();
  if (!val)
    return notify_fail("殷开山笑道：我是不会收的，你拿回去吧！\n");
  if (val < 5000) {
    write("殷开山笑道：国子监每月柴油需五十两白银！\n");
    return 0;
  }
  who->set("guozi/paid", 1);
  call_out("destroy", 1, ob);
  return 1;
}

void destroy(object ob) {
  destruct(ob);
  return;
}

int quest_me(object me) {
  object who = this_player();
  string msg = "$N说道：这位" + RANK_D->query_respect(who);
  if (who->query("combat_exp") < 100000) {
    inform_player(msg + "道行不够，还是先练练吧！\n", who);
    return 1;
  }
  if (who->query("chengwei/lv101") == "done" ||
    who->query_temp("chengwei/yin_asked")) {
    inform_player(msg + "，你不是已经完成这个任务了吗？\n", who);
    return 1;
  }
  inform_player(msg + "，最近长安城陆续发生小孩失踪的事情，你能去调查一下这件事情吗？\n", who);
  who->set_temp("chengwei/yin_asked", 1);
  return 1;
}

int done_me(object me) {
  object who = this_player();
  string msg = "$N说道：这位" + RANK_D->query_respect(who);
  if (who->query_temp("chengwei/changanask") < 5) {
    inform_player(msg + "好象还没完成吧！\n", who);
    return 1;
  }
  if (who->query("chengwei/lv101") == "done") {
    inform_player(msg + "，你不是已经完成这个任务了吗？\n", who);
    return 1;
  }
  inform_player(msg + "，帮本相打听了小孩失踪的事情，应该受到嘉奖。\n", who);
  who->add("combat_exp", 20000);
  who->add("potential", 20000);
  who->set("chengwei/lv101", "done");
  return 1;
}
