#include <ansi.h>
inherit ROOM;

void create()
{
   set ("short","看台");
   set ("long",
@LONG
    
这里是决斗场的看台。决斗场是各路神仙妖魔的决斗之地，凡有恩
仇，都可以来此一决死战，在这里决斗，生死自负。只见看台地上
还有斑斑血迹，到处是断了的兵器和破碎的盔甲。决斗者都可以用
(juedou)命令征求对方意见，当双放同意后既开始决斗。决斗者也
可以在这里查询(checkscore)自己的战绩，看一看(list)别人的决
斗结果,接受挑战(defend)。

LONG);
   set("no_flee",1);
   set("no_fight",1);
   set("no_magic",1);
   set("exits",([
     "north":"/d/city/wuguan",
   ]));
   setup();
}

void init()
{
        object me = this_object();

 if (!wizardp(this_player()) && this_player()->query_condition("no_pk_time"))
   {
    this_player()->move("/d/city/wuguan");
   }
   add_action("do_juedou","juedou");
   add_action("do_defend","defend");
   add_action("do_checkscore","checkscore");
   add_action("do_list","list");
}

int do_juedou(string arg)
{
  object me,ob,other;
  int j;
  me=this_player();
  if (!arg) return notify_fail("你要和谁决斗?\n");	
  ob=LOGIN_D->find_body(arg);
  if (!ob || !me->visible(ob)) return notify_fail("这里没有这个人。\n");
  if (ob==me) return notify_fail("你不能和自己决斗！\n");
  if (wizardp(ob) && ob->query("env/invisibility"))
    return notify_fail("这里没有这个人。\n");
  if (me->query_temp("juedou"))
  {
    if (me->query_temp("juedou")==ob->query("id"))
      return notify_fail ("你已经向他提出决斗了，可是他没有答应，可能是怕了。\n");
    else 
     {
      other=LOGIN_D->find_body(me->query_temp("juedou"));
      if (other) 
        {
         tell_object(me,"你估计打不过"+other->query("name")+"，决定不和他决斗了。\n");
         tell_object(other,me->query("name")+"等你不到，以为你不敢去，决定不和你决斗了。\n");        }
     }
   } 
  message_vision("$N对$n说：我们在此决斗一场，恩仇一笔勾销，以后井水不犯河水。\n",me,ob);
  tell_object(ob,me->query("name")+"告诉你："+RANK_D->query_rude(ob)
     +"，有没有胆子和我决斗(defend)？！我在决斗场等你！\n");
     
  me->set_temp("juedou",ob->query("id"));

  return 1;
}

int do_list()
{
    if (!wizardp(this_player()))
    return notify_fail("有关个人隐私，还是不要多问的好。\n");
    cat("/log/juedou");
    return 1;
}

int do_checkscore()
{
  write("你自己的成绩怎么样，自己还不清楚？\n");
  return 1;
}

int do_defend(string arg)
{  
   string myop,tempstr;
   int j;
   object ob,me,juedou;
    
   me=this_player();
   if (!arg) return notify_fail("你要跟谁决斗？\n");    
   ob = LOGIN_D->find_body(arg);
   if (!ob) return notify_fail("咦．．． 有这个人吗？\n");
   if (me->query("id")==arg) return notify_fail("想和你自己决斗?\n");
   tempstr=ob->query_temp("juedou");
   if (tempstr!=me->query("id")) return notify_fail("对方并没有向你提出决斗。\n");  
   if ( !present(ob,environment(me)) ) return notify_fail("向你提出决斗的人不在这里。\n");
   if ( ob->is_busy() ) return notify_fail("对方正忙着呢！\n"); 
   juedou = load_object(__DIR__"juedou");
   if ( sizeof(all_inventory(juedou)) >0 ) 
     {
       j=sizeof(all_inventory(juedou));
       while (j>0)
       {
         j=j-1;
         if (userp( all_inventory(juedou)[j]))
         return notify_fail("决斗场上已经有人了。\n");
       }
     }
   ob->delete_temp("juedou");
   if (me->query_temp("d_mana")) me->command_function("bian");
   if (ob->query_temp("d_mana")) ob->command_function("bian");
   message_vision("$N和$n双双纵身跃上决斗场,准备开始生死搏斗！\n",me,ob); 
   me->move(__DIR__"juedou");
   ob->move(__DIR__"juedou");
   juedou->do_assign(me->query("id"));
   juedou->do_assign(ob->query("id"));
   call_out("start",5,juedou);
   return 1;
}

void start(object ob)
{
ob->start();
}
