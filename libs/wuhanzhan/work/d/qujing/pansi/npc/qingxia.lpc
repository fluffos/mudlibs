// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name(HIC "青霞仙子" NOR, ({ "qingxia xianzi", "qingxia", "xianzi", }));
  set("gender", "女性");
  set("age", 24);
  set("class", "xian");
  set("attitude", "friendly");
  set("rank_info/respect", "仙子");
  set("cor", 30);
  set("per", 40);
  set("long", "她和紫霞本是如来佛神灯的灯芯，天天听道，修成正果下界辅助紫霞\n");
  set("max_kee", 3500);
  set("max_gin", 3500);
  set("max_sen", 2500);
  set("force", 8000);
  set("max_force", 4000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 150);
  set("combat_exp", 3000000);
  set_skill("literate", 150);
  set_skill("unarmed", 150);
  set_skill("dodge", 170);
  set_skill("force", 150);
  set_skill("parry", 170);
  set_skill("sword", 200);
  set_skill("spells", 200);
  set_skill("pansi-dafa", 200);
  set_skill("pansishou", 150);
  set_skill("zixia-force", 200);
  set_skill("zixia-sword", 200);
  set_skill("yuesha-wubu", 170);
  set_skill("whip", 180);
  set_skill("yinsuo-jinling", 180);
  map_skill("spells", "pansi-dafa");
  map_skill("unarmed", "pansishou");
  map_skill("force", "zixia-force");
  map_skill("whip", "yinsuo-jinling");
  map_skill("parry", "yinsuo-jinling");
  map_skill("dodge", "yuesha-wubu");
  create_family("盘丝洞", 1, "红");
  setup();

  carry_object("/u/sadboy/obj/cloth.lpc")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}

void attempt_apprentice(object ob) {
  if (!((string)ob->query("gender") == "女性")) {
    command("shake");
    command("say 我们盘丝洞只收女徒，这位" + RANK_D->query_respect(ob) + "还是另请高就吧。\n");
    return;
  }
  if ((string)ob->query("family/family_name") == "盘丝洞") {
    if (((int)ob->query("combat_exp") < 500000)) {
      command("hmm");
      command("say " + RANK_D->query_respect(ob) +
        "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
      return;
    }
    if ((int)ob->query_skill("pansi-dafa", 1) < 101) {
      command("say 你还是先去其它姊妹那里再练练吧。\n");
      command("sigh");
      return;
    }
    command("pat " + ob->query("id"));
    command("say 好，希望" + RANK_D->query_respect(ob) +
      "多加努力，把我们盘丝洞发扬光大。\n");
    command("recruit " + ob->query("id"));
    return;
  }
  command("hmm");
  command("say " + RANK_D->query_respect(ob) +
    "还是先去学些基础功夫吧。\n");
  return;
}
