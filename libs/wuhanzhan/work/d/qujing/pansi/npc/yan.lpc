inherit NPC;
inherit F_MASTER;
string expell_me(object me);
void create()
{
  set_name("燕赤侠", ({ "yan chixia", "yan", "xia" }));
  set("title", "盘丝护法");
  set("gender", "男性");
  set("age", 43);
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "燕赤侠是个行侠仗义的好汉,但很风流，
  因贪恋紫霞的美色甘心到盘丝洞做了一名护法。\n");
  set("combat_exp", 12000000);
  set_skill("literate", 120);
  set_skill("force", 200);
  set_skill("dodge", 200);
  set_skill("spells", 280);
  set_skill("parry", 200);
  set_skill("mace", 200);
  set_skill("throwing", 300);
  set_skill("wusi-mace", 200);
  set_skill("yuesha-wubu", 200);
  set_skill("zixia-force", 200);
  set_skill("unarmed", 200);
  set_skill("pansishou", 200);
  map_skill("mace", "wusi-mace");
  map_skill("force", "zixia-force");
  map_skill("unarmed", "pansishou");
  map_skill("spells", "pansi-dafa");
  map_skill("parry", "wusi-mace");
  map_skill("dodge", "yuesha-wubu");
  set("max_sen", 5000);
  set("max_kee", 5000);
  set("max_mana", 6000);
  set("mana", 12000);
  set("force", 12000);
  set("max_force", 6000);
  set("force_factor", 200);
  set("inquiry", ([
        "转业": (: expell_me :),
        "leave": (: expell_me :),
        ]) );

  create_family("盘丝洞", 2, "红");
  setup();
  carry_object("/u/gaoxiao/obj/mace")->wield();
       carry_object("/u/gaoxiao/obj/jia2")->wear();
}

int accept_fight(object me)
{
  command("say 老夫久未和江湖人动手过招了，今日也不想破例。\n");
  return 0;
}
void attempt_apprentice(object ob)
{
   if ( !((string)ob->query("gender")=="女性")){
      command("shake");
          command("say 我们盘丝洞只收女徒，这位" + RANK_D->query_respect(ob) + "还是另请高就吧。\n");
      return;
   }
if ( (string)ob->query("family/family_name")=="盘丝洞") {
   if (((int)ob->query("combat_exp") < 500000 )) {
      command("hmm");
   command("say " + RANK_D->query_respect(ob) +
"的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
    if( (int)ob->query_skill("pansi-dafa", 1) < 151 ) {
      command("say 你还是先去其它姊妹那里再练练吧。\n");
      command("sigh");
      return;
   }
        command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
"多加努力，把我们盘丝洞发扬光大。\n");
       command("recruit " + ob->query("id") );
   return;
   }
   command("hmm");
   command("say " + RANK_D->query_respect(ob) +
"还是先去学些基础功夫吧。\n");
        return;
}

string expell_me(object me)
{
  me=this_player();
  if((string)me->query("family/family_name")=="盘丝洞")
    {
      me->set_temp("betray_pansidong", 1);
      command("sigh");
      return ("你真的愿意离开这么多的妹妹(agree)？");
    }
  return ("去问问仙子吧，或许他知道！");
}
void init()
{
  add_action("do_agree", "agree");
}
int do_agree(string arg)
{
  if(this_player()->query_temp("betray_pansidong"))
    {
      message_vision("$N答道：弟子愿意。\n\n", this_player());
      command("say 那你便去吧，江湖险恶，好自为之。。。");
      this_player()->add("betray/count", 1);
      this_player()->add("betray/pansidong", 1);
      this_player()->set("combat_exp", this_player()->query("combat_exp")*80/100);
      this_player()->delete_skill("pansi-dafa");
      this_player()->delete("family");
      this_player()->delete("class");
      this_player()->set("title", "盘丝叛徒");
      this_player()->set_temp("betray_pansidong", 0);
      this_player()->save();
      return 1;
    }
  return 0;
}

