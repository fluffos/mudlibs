inherit NPC;
 
void do_drink();
 
void create()
{
        seteuid(getuid());
        set_name("至尊宝", ({"zi zunbao", "zi"}));
        set("long", "孙悟空的前身，斧头帮的帮主，遇给他三颗痔的人。即可化身孙悟空转世。\n");
        set("gender","男性");
   set("title", "孙悟空的前世");
   set("class", "scholar");
        set("age",37);
        set("con",30);
        set("per",30);
        set("str",25);
        set("int",35);
        set("combat_exp",100000);
        set("attitude","heroism");
        set("chat_chance",20);
        set("chat_msg", ({
        "至尊宝低声长吟道：曾经，有一份真诚的爱情放在我的面前。\n",
        "至尊宝低吟道：我没有珍惜。\n",
        "至尊宝鼓腹而歌：等我失去的时候我才后悔莫及。\n",

"至尊宝击节而歌：人世间最痛苦的事莫过于此。\n",
        (: do_drink :),
        "至尊宝低吟道：如果上天能够给我一个再来一次的机会。\n",

"至尊宝击节而歌：我会对那女孩子说三个字。\n",
        "至尊宝吟道：我爱你。\n",
        "至尊宝朗声吟道：如果非要在这份爱上加上一个期限。\n",
        (: do_drink :),
        "至尊宝低声长吟：我希望是。。。。\n",
        "至尊宝长吟道：一万年。\n",
   (: random_move :)
        }));

        set("chat_chance", 10);

        set_skill("dodge", 80);
        set_skill("force", 80);
        set_skill("parry", 80);
        set_skill("unarmed", 80);
        set_skill("sword", 120);
        set_skill("literate", 120);
   set("max_force", 200);
   set("force", 200);
   set("force_factor", 10);
        set("max_kee", 700);
        set("max_gin", 400);
        set("max_sen", 500);

        setup();
        carry_object("/obj/cloth")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();
        add_money("silver", 40);
}

