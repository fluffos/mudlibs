// by gaoxiao 
#include <ansi.h>
#include <armor.h>

inherit F_UNIQUE;
inherit SURCOAT;

void destroy();


void init() {
  call_out("destroy", 18000);
}

void create() {
  set_name(MAG "紫云披风" NOR, ({ "ziyun pifeng", "pifeng" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "此乃佛祖如来之物，紫霞仙子在此修行时，偷取的宝物。\n");
    set("material", "leather");
    set("unit", "件");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("value", 40000);
    set("armor_prop/armor", 50);
    set("armor_prop/courage", 8);
    set("armor_prop/dodge", 80);
    set("armor_prop/spells", 100);
    set("replace_file", "/d/obj/cloth/xianyi");
  }
  setup();
}

void destroy() {
  message_vision(
    "只听一声巨响，" + (string)this_object()->query("name") + "片片碎落，随风而去了。\n",
    environment(this_object())
  );
  destruct(this_object());
}
