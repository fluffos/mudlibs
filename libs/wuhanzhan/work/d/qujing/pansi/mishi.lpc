//mishi.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "练功室");
  set("long", @LONG

这里是盘丝门人的练功房，里面全是姐妹们一起练功的场面。
盘丝洞的姐妹们，可以在这里练功修行(wuwhip)。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "down": __DIR__ "dongge",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_whip", "wuwhip");
}

int do_whip() {
  object me = this_player();
  object ob;
  int lev, exp;

  if ((string)me->query("family/family_name") != "盘丝洞") {
    return notify_fail("你和紫霞仙子没什么关系，还是快点出去吧。\n");
    return 1;
  }

  if ((int)me->query_skill("whip", 1) >= 400)
    return notify_fail("你的基本鞭法已经很高了，再练也没什么长进了。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "whip")
    return notify_fail("手里没有兵器怎么练？\n");
  exp = (int)me->query("combat_exp");
  lev = (int)me->query_skill("whip", 1);
  if (exp * 10 < lev * lev * lev)
    return notify_fail("你的道行不够，不要勉强了。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在很累，歇歇吧！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神不济，歇歇吧！\n");

  message_vision("$N思悟着仙子所授的鞭法,随风舞了起来。\n", me);
  tell_object(me, "你的「基本鞭法」进步了。\n");
  me->improve_skill("whip", (int)me->query_int());
  me->receive_damage("kee", 10);

  return 1;
}
