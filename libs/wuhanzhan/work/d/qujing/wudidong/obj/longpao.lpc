#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
  set_name(HIY "龙虎战袍" NOR, ({"longhu zhanpao", "pao"}));
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件战袍。\n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 600);
       set("armor_prop/armor", 80);
    set("armor_prop/armor_vs_force", 200);       set("armor_prop/armor_vs_spells", 200);
  }
  setup();
}

