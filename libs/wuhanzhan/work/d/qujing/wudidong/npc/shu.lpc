//wdd master

#include <ansi.h>
inherit F_MASTER;
inherit NPC;

void create() {
  set_name(HIY "锦毛鼠王" NOR, ({ "jinmao shu", "shu", "master" }));
  set("long", "锦毛鼠王曾是西天一只老鼠，因偷吃了如来琉璃灯的灯油，
在经过千年修炼，练得一身好本领，逃出西天，从此在妖界与鼠类为伍！\n");
  set("title", HIW "无底洞老祖" NOR);
  set("gender", "男性");
  set("age", 1000);
  set("combat_exp", 4000000);
  set("attitude", "heroic");
  create_family("陷空山无底洞", 1, "妖王");
  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("parry", 270);
  set_skill("stealing", 200);
  set_skill("spells", 290);
  set_skill("sword", 260);
  set_skill("qixiu-jian", 250);
  set_skill("yinfeng-zhua", 280);
  set_skill("lingfu-steps", 280);
  set_skill("force", 280);
  set_skill("blade", 300);
  set_skill("kugu-blade", 250);
  set_skill("yaofa", 280);
  set_skill("huntian-qigong", 300);
  map_skill("force", "huntian-qigong");
  map_skill("blade", "kugu-blade");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("spells", "yaofa");
  map_skill("sword", "qixiu-jian");
  map_skill("parry", "qixiu-jian");
  map_skill("dodge", "lingfu-steps");

  set("cor", 50);
  set("str", 30);
  set("per", 30);
  set("max_kee", 3500);
  set("max_sen", 4000);
  set("force", 8000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("mana", 10000);
  set("mana", 12000);
  set("max_mana", 6000);
  set("mana_factor", 400);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "yaomo" :),
  }));

  setup();
  carry_object("/d/obj/weapon/blade/jindao")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/blade/xueyin");
}
void attempt_apprentice(object ob) {
  ob = this_player();
  if ((string)ob->query("family/family_name") == "陷空山无底洞") {
    if ((int)ob->query("combat_exp") < 2000000) {
      command("say 什么？" + RANK_D->query_respect(ob) + "道行这么低想当我徒弟！？滚
！ \n");
      return;
    }
    if ((int)ob->query_int() < 40) {
      command("say 什么？" + RANK_D->query_respect(ob) + "悟性这么差都想做我徒弟？连
门都没有！\n");
      command("sigh");
      return;
    }
    command("haha");
    command("say 很好，" + RANK_D->query_respect(ob) + "不愧是无底洞的弟子!"
    );
    command("recruit " + ob->query("id"));
    ob->set("prize/give", 1);
    return;
  }
  command("say 来人啊！把这小子给我轰出去!\n");
  ob->move("/d/qujing/wudidong/dong");
  message_vision("只见一群鼠兵奔你而来，把你台到洞口丢下。\n", ob);
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    ob->set("class", "yaomo");
  }
}

void init() {
  object me;

  ::init();
  add_action("do_exercise", ({ "bian" }));
  if (interactive(me = this_player()) && !is_fighting()) {
    call_out("greeting", 0, me);
  }
}

void greeting(object me) {
  int mykar = me->query_kar();
  if (random(mykar) > 100) return;
  else {
    me->delete_temp("spellslevel");
    me->delete_temp("d_mana");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    return;
  }
}
int do_exercise(string arg) {
  write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
  return 1;
}
