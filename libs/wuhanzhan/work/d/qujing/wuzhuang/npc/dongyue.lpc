//wzg master

#include <ansi.h>
inherit F_MASTER;
inherit NPC;

void create() {
  set_name(HIC "东岳大帝" NOR, ({ "dongyue dadi", "dadi", "master" }));
  set("title", HIW "五庄观太祖" NOR);
  set("gender", "男性");
  set("age", 1000);
  set("per", 40);
  set("str", 40);
  set("long", "地仙始祖，看上去仙风道骨！\n");
  set("class", "dadi");
  set("combat_exp", 4500000);
  set("attitude", "peaceful");
  create_family("五庄观", 1, "大帝");
  set("rank_info/respect", "大帝");
  set_skill("unarmed", 260);
  set_skill("wuxing-quan", 260);
  set_skill("dodge", 280);
  set_skill("baguazhen", 260);
  set_skill("parry", 280);
  set_skill("staff", 260);
  set_skill("fumo-zhang", 290);
  set_skill("blade", 260);
  set_skill("yange-blade", 260);
  set_skill("force", 280);
  set_skill("zhenyuan-force", 280);
  set_skill("literate", 280);
  set_skill("spells", 300);
  set_skill("taiyi-sword", 320);
  set_skill("sword", 300);
  set_skill("xiaofeng-sword", 300);
  set_skill("hammer", 300);
  set_skill("taiyi", 320);
  map_skill("spells", "taiyi");
  map_skill("force", "zhenyuan-force");
  map_skill("unarmed", "wuxing-quan");
  map_skill("sword", "xiaofeng-sword");
  map_skill("dodge", "baguazhen");
  map_skill("staff", "fumo-zhang");
  map_skill("blade", "yange-blade");

  set("cor", 40);
  set("str", 40);
  set("per", 40);
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("force", 10000);
  set("max_force", 5000);
  set("mana", 10000);
  set("max_mana", 6500);
  set("force_factor", 250);
  set("mana_factor", 300);

  set("spell_qiankun_on", 1);  //to use cast qiankun, must set this.
  set("chat_chance_combat", 60);
  set("chat_msg_combat",
    ({
      (: cast_spell, "qiankun" :),
    }));

  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/staff/budd_staff")->wield();
}

void attempt_apprentice(object ob) {
  ob = this_player();
  if ((string)ob->query("family/family_name") == "五庄观") {
    if ((int)ob->query("combat_exp") < 2000000) {
      command("say 这位" + RANK_D->query_respect(ob) + "的道行未免也太低了吧。现在即
使收了你也是勉为其难！ \n");
      return;
    }
    if ((int)ob->query_int() < 40) {
      command("say 这位" + RANK_D->query_respect(ob) + "悟性太低，恐怕收了你也难有作
为！\n");
      command("sigh");
      return;
    }
    if ((int)ob->query_skill("zhenyuan-force", 1) < 181) {
      command("say 这位" + RANK_D->query_respect(ob) + "的镇元神功修为还未到火候
 \n");
      return;
    }
    command("nod ");
    command("say 好，" + RANK_D->query_respect(ob) + "不愧是本门的人才！\n"
    );
    command("recruit " + ob->query("id"));
    ob->set("prize/give", 1);
    return;
  }
  command("shake");
  command("say 我不收门外地子，这位" + RANK_D->query_respect(ob) + "请回吧
\n");
  return;
}

void init() {
  object me;

  ::init();
  add_action("do_exercise", ({ "bian" }));
  if (interactive(me = this_player()) && !is_fighting()) {
    call_out("greeting", 0, me);
  }
}

void greeting(object me) {
  int mykar = me->query_kar();
  if (random(mykar) > 100) return;
  else {
    me->delete_temp("spellslevel");
    me->delete_temp("d_mana");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    return;
  }
}
int do_exercise(string arg) {
  write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
  return 1;
}
