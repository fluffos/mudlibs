inherit ROOM;

void create ()
{
   set ("short", "僧侣之家");
   set ("long", @LONG
这里是僧侣之家。
LONG);
   set("exits", 
   ([ 
     "southwest" : "/d/baodian/1",
   ]));
   setup();
}

void init()
{
   add_action("do_zhuanzhi", "zhuanzhi");
}

int do_zhuanzhi(string arg)
{
  string zhiye,type,wuseng,faseng,gaojiwuseng,zhuchi,wusheng,shengzhe;   
  object me=this_player();
  string msg="你决定转职成";

        if ((string)me->query("zhiye/id") != "senglv" &&(string)me->query("zhiye/id") != "wuseng" &&(string)me->query("zhiye/id") !="faseng" &&(string)me->query("zhiye/id") !="gaojiwuseng" &&(string)me->query("zhiye/id") !="zhuchi")
                return notify_fail("你不适合这些职业。\n");
   if (!arg) return notify_fail(@LONG
格式： zhuanzhi <类别>
wuseng         武僧
faseng         魔法僧人
gaojiwuseng         高级武僧
zhuchi         住持
shengzhe         圣者
wusheng         武圣
LONG);
     type = CONVERT_D->input(arg,me);
  if (type!="gaojiwuseng"&& type!="faseng"&& type!="wuseng"&& type!="zhuchi" && type!="shengzhe" && type!="wusheng")
    return notify_fail("输入错误。\n");
  if (type == "wuseng" && (string)me->query("zhiye/id") != "senglv")
                return notify_fail("你不适合这一职业。\n");
  if (type == "faseng" && (string)me->query("zhiye/id") != "senglv")
                return notify_fail("你不适合这一职业。\n");
  if (type == "zhuchi" && (string)me->query("zhiye/id") != "faseng")
                return notify_fail("你不适合这一职业。\n");
  if (type == "gaojiwuseng" && (string)me->query("zhiye/id") != "wuseng")
                return notify_fail("你不适合这一职业。\n");
  if (type == "shengzhe" && (string)me->query("zhiye/id") != "zhuchi")
                return notify_fail("你不适合这一职业。\n");
  if (type == "wusheng" && (string)me->query("zhiye/id") != "gaojiwuseng")
                return notify_fail("你不适合这一职业。\n");

  switch (type) {
    case "wuseng" : msg+="武僧这一职业。\n";
                me->set("zhiye/id", "wuseng");
                me->set("zhiye/name", "武斗僧");
                me->set("zhuanzhi1",1);
                me->add("str",3);
                me->add("spi",1);
                me->add("con",2);
            write(msg);
              break;
    case "faseng" : msg+="魔法僧人这一职业。\n";
                me->set("zhiye/id", "faseng");
                me->set("zhiye/name", "魔法僧人");
                me->set("zhuanzhi1",1);
                me->add("str",1);
                me->add("spi",3);
                me->add("con",2);
            write(msg);
              break;
    case "gaojiwuseng" : msg+="高级武僧这一职业。\n";
                me->set("zhiye/id", "gaojiwuseng");
                me->set("zhiye/name", "高级武僧");
                me->set("zhuanzhi2",1);
                me->add("str",4);
                me->add("con",2);
            write(msg);
              break;
    case "zhuchi" : msg+="住持这一职业。\n";
                me->set("zhiye/id", "zhuchi");
                me->set("zhiye/name", "住持");
                me->set("zhuanzhi2",1);
                me->add("str",2);
                me->add("spi", 3);
                me->add("con", 3);
            write(msg);
              break;
    case "wusheng" : msg+="武圣这一职业。\n";
                me->set("zhiye/id", "wusheng");
                me->set("zhiye/name", "武圣");
                me->set("zhuanzhi3",1);
                me->add("str",3);
                me->add("con", 5);
                me->set("wushengsp", 1);
            write(msg);
              break;
    case "shengzhe" : msg+="圣者这一职业。\n";
                me->set("zhiye/id", "shengzhe");
                me->set("zhiye/name", "圣者");
                me->set("zhuanzhi3",1);
                me->add("spi",4);
                me->add("con",4);
                me->set("shengzhesp", 1);
            write(msg);
              break;
  }
  return 1;
}
