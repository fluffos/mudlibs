inherit ROOM;

void create() {
  set("short", "宝殿");
  set("long", @LONG
这是一个选择职业的房间。
LONG);
  set("exits",
    ([
      "south": "/d/city/center",
      "west": "/d/baodian/201",
      "northwest": "/d/baodian/301",
      "north": "/d/baodian/401",
      "northeast": "/d/baodian/501",
      "east": "/d/baodian/601",
      "southeast": "/d/baodian/701",
      "southwest": "/d/baodian/801",
    ]));
  setup();
}
void init() {
  add_action("do_choose", "choose");
}
int do_choose(string arg) {
  string zhiye, type, zhanshi, wushi, fashi, senglv, jianshi, jingwei, maoxian;
  object me = this_player();
  string msg = "你决定选择";
  if ((int)me->query("choose") == 1)
    return notify_fail("你已经选择过职业了。\n");
  if (!arg) return notify_fail(@LONG
格式： choose <类别>
zhanshi         战士    （臂力+3，根骨+3）    
wushi           武士   （臂力+5）
fashi         施法者   （灵性+5）
senglv         僧侣    （根骨+5）
jianshi       剑士    （臂力+2，根骨+2，胆识+2）
jingwei       警卫    （臂力+3，胆识+3）
maoxian       冒险者     （dunno）
LONG);

  type = CONVERT_D->input(arg, me);
  if (type != "zhanshi" && type != "wushi" && type != "fashi" && type != "senglv" && type != "jianshi" && type != "jingwei" && type != "maoxian")
    return notify_fail("输入错误。\n");

  switch (type) {
    case "zhanshi": msg += "战士这一职业。\n";
    me->set("zhiye/id", "zhanshi");
    me->set("zhiye/class", "zhanshi");
    me->set("wsk/sword", "C");
    me->set("wsk/blade", "C");
    me->set("wsk/spear", "C");
    me->set("wsk/stick", "C");
    me->set("wsk/staff", "C");
    me->set("wsk/whip", "C");
    me->set("wsk/axe", "C");
    me->set("wsk/hammer", "C");
    me->set("wsk/unarmed", "D");
    me->set("wsk/fork", "C");
    me->set("zhiye/name", "战士");
    me->set("choose", 1);
    me->add("str", 3);
    me->add("con", 3);
    write(msg);
    break;
    case "wushi": msg += "武士这一职业。\n";
    me->set("zhiye/id", "wushi");
    me->set("zhiye/class", "wushi");
    me->set("wsk/sword", "D");
    me->set("wsk/blade", "C");
    me->set("wsk/spear", "D");
    me->set("wsk/stick", "D");
    me->set("wsk/staff", "D");
    me->set("wsk/whip", "D");
    me->set("wsk/axe", "D");
    me->set("wsk/hammer", "D");
    me->set("wsk/unarmed", "C");
    me->set("wsk/fork", "D");
    me->set("zhiye/name", "武士");
    me->set("choose", 1);
    me->add("str", 5);
    write(msg);
    break;
    case "fashi": msg += "施法者这一职业。\n";
    me->set("zhiye/id", "fashi");
    me->set("zhiye/class", "fashi");
    me->set("wsk/sword", "E");
    me->set("wsk/spear", "E");
    me->set("wsk/stick", "E");
    me->set("wsk/staff", "E");
    me->set("wsk/whip", "E");
    me->set("wsk/axe", "E");
    me->set("wsk/hammer", "E");
    me->set("wsk/unarmed", "E");
    me->set("wsk/fock", "E");
    me->set("wsk/blade", "E");
    me->set("zhiye/name", "施法者");
    me->set("choose", 1);
    me->add("spi", 5);
    write(msg);
    break;
    case "senglv": msg += "僧侣这一职业。\n";
    me->set("zhiye/id", "senglv");
    me->set("zhiye/class", "senglv");
    me->set("wsk/sword", "E");
    me->set("wsk/spear", "D");
    me->set("wsk/stick", "C");
    me->set("wsk/staff", "D");
    me->set("wsk/whip", "E");
    me->set("wsk/axe", "E");
    me->set("wsk/hammer", "E");
    me->set("wsk/unarmed", "C");
    me->set("wsk/fock", "E");
    me->set("wsk/blade", "E");
    me->set("zhiye/name", "僧侣");
    me->set("choose", 1);
    me->add("con", 5);
    write(msg);
    break;
    case "jianshi": msg += "剑士这一职业。\n";
    me->set("zhiye/id", "jianshi");
    me->set("zhiye/class", "jianshi");
    me->set("wsk/sword", "C");
    me->set("wsk/spear", "E");
    me->set("wsk/stick", "E");
    me->set("wsk/staff", "E");
    me->set("wsk/whip", "E");
    me->set("wsk/axe", "E");
    me->set("wsk/hammer", "E");
    me->set("wsk/unarmed", "E");
    me->set("wsk/fock", "E");
    me->set("wsk/blade", "D");
    me->set("zhiye/name", "剑士");
    me->set("choose", 1);
    me->add("str", 2);
    me->add("con", 2);
    me->add("cor", 2);
    write(msg);
    break;
    case "jingwei": msg += "警卫这一职业。\n";
    me->set("zhiye/id", "jingwei");
    me->set("zhiye/class", "jingwei");
    me->set("wsk/sword", "D");
    me->set("wsk/spear", "C");
    me->set("wsk/stick", "D");
    me->set("wsk/staff", "E");
    me->set("wsk/whip", "E");
    me->set("wsk/axe", "D");
    me->set("wsk/hammer", "D");
    me->set("wsk/unarmed", "E");
    me->set("wsk/fock", "E");
    me->set("wsk/blade", "D");
    me->set("zhiye/name", "警卫");
    me->set("choose", 1);
    me->add("str", 3);
    me->add("cor", 3);
    write(msg);
    break;
    case "maoxian": msg += "冒险者这一职业。\n";
    me->set("zhiye/id", "maoxian");
    me->set("zhiye/class", "maoxian");
    me->set("wsk/sword", "D");
    me->set("wsk/spear", "E");
    me->set("wsk/stick", "E");
    me->set("wsk/staff", "E");
    me->set("wsk/whip", "E");
    me->set("wsk/axe", "E");
    me->set("wsk/hammer", "E");
    me->set("wsk/unarmed", "E");
    me->set("wsk/fock", "E");
    me->set("wsk/blade", "D");
    me->set("zhiye/name", "冒险者");
    me->set("choose", 1);
    write(msg);
    break;
  }
  return 1;
}
