inherit ROOM;

void create ()
{
   set ("short", "魔法师之家");
   set ("long", @LONG
这里是魔法师之家。
LONG);
   set("exits", 
   ([ 
     "south" : "/d/baodian/1",
   ]));
   setup();
}

void init()
{
   add_action("do_zhuanzhi", "zhuanzhi");
}
int do_zhuanzhi(string arg)
{
  string zhiye,type,mofashi,gaojifashi,mofadaoshi;   
  object me=this_player();
  string msg="你决定转职成";

        if ((string)me->query("zhiye/id") != "fashi" &&(string)me->query("zhiye/id") != "mofashi" &&(string)me->query("zhiye/id") !="gaojifashi")
                return notify_fail("你不适合这些职业。\n");
   if (!arg) return notify_fail(@LONG
格式： zhuanzhi <类别>
mofashi         魔法师        
gaojifashi         高级法师
mofadaoshi         魔法导师
LONG);
     type = CONVERT_D->input(arg,me);
  if (type!="mofashi" && type!="gaojifashi" && type!="mofadaoshi")
    return notify_fail("输入错误。\n");
  if (type == "mofashi" && (string)me->query("zhiye/id") != "fashi")
                return notify_fail("你不适合这一职业。\n");
  if (type == "gaojifashi" && (string)me->query("zhiye/id") != "mofashi")
                return notify_fail("你不适合这一职业。\n");
  if (type == "mofadaoshi" && (string)me->query("zhiye/id") != "gaojifashi")
                return notify_fail("你不适合这一职业。\n");

  switch (type) {
    case "mofashi" : msg+="魔法师这一职业。\n";
                me->set("zhiye/id", "mofashi");
                me->set("zhiye/name", "魔法师");
                me->set("zhuanzhi1",1);
                me->add("spi",5);
                me->add("str",-2);
            write(msg);
              break;
    case "gaojifashi" : msg+="高级法师这一职业。\n";
                me->set("zhiye/id", "gaojifashi");
                me->set("zhiye/name", "高级法师");
                me->set("zhuanzhi2",1);
                me->add("spi",6);
                me->add("str",-3);
            write(msg);
              break;
    case "mofadaoshi" : msg+="魔法导师这一职业。\n";
                me->set("zhiye/id", "mofadaoshi");
                me->set("zhiye/name", "魔法导师");
                me->set("zhuanzhi3",1);
                me->add("spi",8);
                me->add("str",-3);
                me->set("mofasp",1);
            write(msg);
              break;
  }
  return 1;
}
