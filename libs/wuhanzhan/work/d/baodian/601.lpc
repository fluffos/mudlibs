inherit ROOM;

void create() {
  set("short", "剑士之家");
  set("long", @LONG
这里是僧侣之家。
LONG);
  set("exits",
    ([
      "west": "/d/baodian/1",
    ]));
  setup();
}

void init() {
  add_action("do_zhuanzhi", "zhuanzhi");
}

int do_zhuanzhi(string arg) {
  string zhiye, type, gaojijianshi, dajianshi, jianshen;
  object me = this_player();
  string msg = "你决定转职成";

  if ((string)me->query("zhiye/id") != "jianshi" && (string)me->query("zhiye/id") != "dajianshi" && (string)me->query("zhiye/id") != "gaojijianshi")
    return notify_fail("你不适合这些职业。\n");
  if (!arg) return notify_fail(@LONG
格式： zhuanzhi <类别>
gaojijianshi         高级剑士
dajianshi         大剑师
jianshen         剑神
LONG);
  type = CONVERT_D->input(arg, me);
  if (type != "gaojijianshi" && type != "dajianshi" && type != "jianshen")
    return notify_fail("输入错误。\n");
  if (type == "gaojijianshi" && (string)me->query("zhiye/id") != "jianshi")
    return notify_fail("你不适合这一职业。\n");
  if (type == "dajianshi" && (string)me->query("zhiye/id") != "gaojijianshi")
    return notify_fail("你不适合这一职业。\n");
  if (type == "jianshen" && (string)me->query("zhiye/id") != "dajianshi")
    return notify_fail("你不适合这一职业。\n");
  switch (type) {
    case "gaojijianshi": msg += "高级剑士这一职业。\n";
    me->set("zhiye/id", "gaojijianshi");
    me->set("zhiye/name", "高级剑士");
    me->set("zhuanzhi1", 1);
    me->add("str", 2);
    me->add("cor", 3);
    write(msg);
    break;
    case "dajianshi": msg += "大剑师这一职业。\n";
    me->set("zhiye/id", "dajianshi");
    me->set("zhiye/name", "大剑师");
    me->set("zhuanzhi2", 1);
    me->add("str", 3);
    me->add("cor", 3);
    write(msg);
    break;
    case "jianshen": msg += "剑神这一职业。\n";
    me->set("zhiye/id", "jianshen");
    me->set("zhiye/name", "剑神");
    me->set("zhuanzhi3", 1);
    me->add("str", 4);
    me->add("cor", 4);
    me->set("jianshensp", 1);
    write(msg);
    break;
  }
  return 1;
}
