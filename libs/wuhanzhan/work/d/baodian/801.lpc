inherit ROOM;

void create() {
  set("short", "冒险者公会");
  set("long", @LONG
这里是冒险者公会。
LONG);
  set("exits",
    ([
      "northeast": "/d/baodian/1",
    ]));
  setup();
}

void init() {
  add_action("do_zhuanzhi", "zhuanzhi");
}

int do_zhuanzhi(string arg) {
  string zhiye, type, yongshi, doujianshi, yingxiong;
  object me = this_player();
  string msg = "你决定转职成";

  if ((string)me->query("zhiye/id") != "maoxian" && (string)me->query("zhiye/id") != "yongshi" && (string)me->query("zhiye/id") != "doujianshi")
    return notify_fail("你不适合这些职业。\n");
  if (!arg) return notify_fail(@LONG
格式： zhuanzhi <类别>
yongshi           勇者
doujianshi        斗剑士
yingxiong        英雄
LONG);
  type = CONVERT_D->input(arg, me);
  if (type != "yongshi" && type != "doujianshi" && type != "yingxiong")
    return notify_fail("输入错误。\n");
  if (type == "yongshi" && (string)me->query("zhiye/id") != "maoxian")
    return notify_fail("你不适合这一职业。\n");
  if (type == "doujianshi" && (string)me->query("zhiye/id") != "yongshi")
    return notify_fail("你不适合这一职业。\n");
  if (type == "yingxiong" && (string)me->query("zhiye/id") != "doujianshi")
    return notify_fail("你不适合这一职业。\n");
  switch (type) {
    case "yongshi": msg += "勇者这一职业。\n";
    me->set("zhiye/id", "yongshi");
    me->set("zhiye/name", "勇者");
    me->set("zhuanzhi1", 1);
    me->add("str", 1);
    me->add("spi", 1);
    me->add("con", 1);
    me->add("int", 1);
    me->add("kar", 1);
    write(msg);
    break;
    case "doujianshi": msg += "斗剑士这一职业。\n";
    me->set("zhiye/id", "doujianshi");
    me->set("zhiye/name", "斗剑士");
    me->set("zhuanzhi2", 1);
    me->add("str", 1);
    me->add("spi", 1);
    me->add("con", 1);
    me->add("int", 1);
    me->add("kar", 1);
    write(msg);
    break;
    case "yingxiong": msg += "英雄这一职业。\n";
    me->set("zhiye/id", "yingxiong");
    me->set("zhiye/name", "英雄");
    me->set("zhuanzhi3", 1);
    me->add("str", 1);
    me->add("spi", 1);
    me->add("con", 1);
    me->add("int", 1);
    me->add("kar", 1);
    me->set("yingxiongsp", 1);
    write(msg);
    break;
  }
  return 1;
}
