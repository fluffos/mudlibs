inherit ROOM;

void create() {
  set("short", "骑士之家");
  set("long", @LONG
这里是骑士之家。
LONG);
  set("exits",
    ([
      "northwest": "/d/baodian/1",
    ]));
  setup();
}

void init() {
  add_action("do_zhuanzhi", "zhuanzhi");
}

int do_zhuanzhi(string arg) {
  string zhiye, type, qishi, xuanfengqishi, longqishi;
  object me = this_player();
  string msg = "你决定转职成";

  if ((string)me->query("zhiye/id") != "jingwei" && (string)me->query("zhiye/id") != "qishi" && (string)me->query("zhiye/id") != "xuanfengqishi")
    return notify_fail("你不适合这些职业。\n");
  if (!arg) return notify_fail(@LONG
格式： zhuanzhi <类别>
qishi           骑士
xuanfengqishi         旋风骑士
longqishi         龙骑士
LONG);
  type = CONVERT_D->input(arg, me);
  if (type != "qishi" && type != "xuanfengqishi" && type != "longqishi")
    return notify_fail("输入错误。\n");
  if (type == "qishi" && (string)me->query("zhiye/id") != "jingwei")
    return notify_fail("你不适合这一职业。\n");
  if (type == "xuanfengqishi" && (string)me->query("zhiye/id") != "qishi")
    return notify_fail("你不适合这一职业。\n");
  if (type == "longqishi" && (string)me->query("zhiye/id") != "xuanfengqishi")
    return notify_fail("你不适合这一职业。\n");
  switch (type) {
    case "qishi": msg += "骑士这一职业。\n";
    me->set("zhiye/id", "qishi");
    me->set("zhiye/name", "骑士");
    me->set("zhuanzhi1", 1);
    me->add("cor", 5);
    write(msg);
    break;
    case "xuanfengqishi": msg += "旋风骑士这一职业。\n";
    me->set("zhiye/id", "xuanfengqishi");
    me->set("zhiye/name", "旋风骑士");
    me->set("zhuanzhi2", 1);
    me->add("cor", 8);
    write(msg);
    break;
    case "longqishi": msg += "龙骑士这一职业。\n";
    me->set("zhiye/id", "longqishi");
    me->set("zhiye/name", "龙骑士");
    me->set("zhuanzhi3", 1);
    me->set("qishisp", 1);
    me->add("cor", 12);
    write(msg);
    break;
  }
  return 1;
}
