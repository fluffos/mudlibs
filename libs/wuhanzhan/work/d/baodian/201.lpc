inherit ROOM;

void create() {
  set("short", "战士之家");
  set("long", @LONG
这里是战士之家。
LONG);
  set("exits",
    ([
      "east": "/d/baodian/1",
    ]));
  setup();
}

void init() {
  add_action("do_zhuanzhi", "zhuanzhi");
}
int do_zhuanzhi(string arg) {
  string zhiye, type, kuangzhanshi, shixuezhanshi, zhanshen;
  object me = this_player();
  string msg = "你决定转职成";
  if ((string)me->query("zhiye/id") != "zhanshi" && (string)me->query("zhiye/id") != "kuangzhanshi" && (string)me->query("zhiye/id") != "shixuezhanshi")
    return notify_fail("你不适合这些职业。\n");
  if (!arg) return notify_fail(@LONG
格式： zhuanzhi <类别>
kuangzhanshi         狂战士        
shixuezhanshi         嗜血战士        
zhanshen            战神
LONG);
  type = CONVERT_D->input(arg, me);
  if (type != "kuangzhanshi" && type != "shixuezhanshi" && type != "zhanshen")
    return notify_fail("输入错误。\n");
  if (type == "kuangzhanshi" && (string)me->query("zhiye/id") != "zhanshi")
    return notify_fail("你不适合这些职业。\n");
  if (type == "shixuezhanshi" && (string)me->query("zhiye/id") != "kuangzhanshi")
    return notify_fail("你不适合这些职业。\n");
  if (type == "zhanshen" && (string)me->query("zhiye/id") != "shixuezhanshi")
    return notify_fail("你不适合这些职业。\n");

  switch (type) {
    case "kuangzhanshi": msg += "狂战士这一职业。\n";
    me->set("zhiye/id", "kuangzhanshi");
    me->set("wsk/sword", "C");
    me->set("wsk/blade", "C");
    me->set("wsk/spear", "C");
    me->set("wsk/stick", "C");
    me->set("wsk/staff", "C");
    me->set("wsk/whip", "C");
    me->set("wsk/axe", "B");
    me->set("wsk/hammer", "B");
    me->set("wsk/unarmed", "D");
    me->set("wsk/fork", "C");
    me->set("zhiye/name", "狂战士");
    me->set("zhuanzhi1", 1);
    me->add("str", 5);
    me->add("spi", -2);
    me->add("con", 3);
    write(msg);
    break;
    case "shixuezhanshi": msg += "嗜血战士这一职业。\n";
    me->set("zhiye/id", "shixuezhanshi");
    me->set("wsk/sword", "B");
    me->set("wsk/blade", "B");
    me->set("wsk/spear", "B");
    me->set("wsk/stick", "B");
    me->set("wsk/staff", "B");
    me->set("wsk/whip", "B");
    me->set("wsk/axe", "B");
    me->set("wsk/hammer", "B");
    me->set("wsk/unarmed", "D");
    me->set("wsk/fork", "B");
    me->set("zhiye/name", "嗜血战士");
    me->set("zhuanzhi2", 1);
    me->add("str", 6);
    me->add("spi", -2);
    write(msg);
    break;
    case "zhanshen": msg += "战神这一职业。\n";
    me->set("zhiye/id", "zhanshen");
    me->set("wsk/sword", "A");
    me->set("wsk/blade", "A");
    me->set("wsk/spear", "A");
    me->set("wsk/stick", "A");
    me->set("wsk/staff", "A");
    me->set("wsk/whip", "A");
    me->set("wsk/axe", "A");
    me->set("wsk/hammer", "A");
    me->set("wsk/unarmed", "C");
    me->set("wsk/fork", "A");
    me->set("zhiye/name", "战神");
    me->set("zhuanzhi3", 1);
    me->add("str", 8);
    me->add("spi", -3);
    //                me->set("zhanshensp",1);
    write(msg);
    break;
  }
  return 1;
}
