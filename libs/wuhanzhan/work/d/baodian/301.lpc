inherit ROOM;
void create ()
{
   set ("short", "武士之家");
   set ("long", @LONG
这里是武士之家。
LONG);
   set("exits", 
   ([ 
     "southeast" : "/d/baodian/1",
   ]));
   setup();
}

void init()
{
   add_action("do_zhuanzhi", "zhuanzhi");
}
int do_zhuanzhi(string arg)
{
  string zhiye,type,cijiwushi,gaojiwushi,wushen,renzhe,shangren;   
  object me=this_player();

  string msg="你决定转职成";
        if ((string)me->query("zhiye/id") != "wushi" &&(string)me->query("zhiye/id") != "cijiwushi" &&(string)me->query("zhiye/id") !="gaojiwushi" &&(string)me->query("zhiye/id") !="renzhe")
                return notify_fail("你不适合这些职业。\n");
   if (!arg) return notify_fail(@LONG
格式： zhuanzhi <类别>
cijiwushi         次级武士
gaojiwushi         高级武士
renzhe         忍者
wushen         武神
shangren         上忍
LONG);
     type = CONVERT_D->input(arg,me);
  if (type!="cijiwushi" && type!="gaojiwushi" && type!="wushen" && type!="renzhe" && type!="shangren")
    return notify_fail("输入错误。\n");
  if (type == "cijiwushi" && (string)me->query("zhiye/id") != "wushi")
                return notify_fail("你不适合这个职业。\n");
  if (type == "gaojiwushi" && (string)me->query("zhiye/id") != "cijiwushi")
                return notify_fail("你不适合这个职业。\n");
  if (type == "renzhe" && (string)me->query("zhiye/id") != "cijiwushi")
                return notify_fail("你不适合这个职业。\n");
  if (type == "wushen" && (string)me->query("zhiye/id") != "gaojiwushi")
                return notify_fail("你不适合这个职业。\n");
  if (type == "shangren" && (string)me->query("zhiye/id") != "renzhe")
                return notify_fail("你不适合这个职业。\n");
  switch (type) {
    case "cijiwushi" : msg+="次级武士这一职业。\n";
                me->set("zhiye/id", "cijiwushi");
                me->set("wsk/sword", "C");
                me->set("wsk/blade", "B");
                me->set("wsk/spear", "C");
                   me->set("wsk/stick", "C");
                me->set("wsk/staff", "C");
                me->set("wsk/whip", "C");
                me->set("wsk/axe", "C");
                me->set("wsk/hammer", "C");
                me->set("wsk/unarmed", "B");
                me->set("wsk/fork", "C");
                me->set("zhiye/name", "次级武士");
                me->set("zhuanzhi1",1);
                me->add("str",6);
                me->add("spi",-2);
            write(msg);
              break;
    case "gaojiwushi" : msg+="高级武士这一职业。\n";
                me->set("zhiye/id", "gaojiwushi");
                me->set("zhiye/name", "高级武士");
                me->set("wsk/sword", "C");
                me->set("wsk/blade", "A");
                me->set("wsk/spear", "C");
               me->set("wsk/stick", "C");
                me->set("wsk/staff", "C");
                me->set("wsk/whip", "C");
                me->set("wsk/axe", "C");
                me->set("wsk/hammer", "C");
                me->set("wsk/unarmed", "B");
                me->set("wsk/fork", "C");
                me->set("zhuanzhi2",1);
                me->add("str",3);
                me->add("con",5);
                me->add("spi", -3);
            write(msg);
              break;
    case "renzhe" : msg+="忍者这一职业。\n";
                me->set("zhiye/id", "renzhe");
                me->set("wsk/sword", "C");
                me->set("wsk/blade", "A");
                me->set("wsk/spear", "D");
               me->set("wsk/stick", "D");
                me->set("wsk/staff", "D");
                me->set("wsk/throwing", "A");
                me->set("wsk/whip", "D");
                me->set("wsk/axe", "D");
                me->set("wsk/hammer", "D");
                me->set("wsk/unarmed", "C");
                me->set("wsk/fork", "D");
                me->set("zhiye/name", "忍者");
                me->set("zhuanzhi2",1);
                me->set("huixin",40);
            write(msg);
              break;
    case "wushen" : msg+="武神这一职业。\n";
                me->set("zhiye/id", "wushen");
                me->set("zhiye/name", "武神");
                me->set("zhuanzhi3",1);
                me->set("wsk/sword", "B");
                me->set("wsk/blade", "A");
                me->set("wsk/spear", "C");
               me->set("wsk/stick", "C");
                me->set("wsk/staff", "C");
                me->set("wsk/whip", "C");
                me->set("wsk/axe", "C");
                me->set("wsk/hammer", "C");
                me->set("wsk/unarmed", "S");
                me->set("wsk/fork", "C");
                me->add("str",8);
                me->add("spi",-2);
                me->set("wushensp",1);
            write(msg);
              break;
    case "shangren" : msg+="上忍这一职业。\n";
                me->set("zhiye/id", "shangren");
                me->set("wsk/sword", "B");
                me->set("wsk/blade", "S");
                me->set("wsk/spear", "D");
               me->set("wsk/stick", "D");
                me->set("wsk/staff", "D");
                me->set("wsk/throwing", "S");
                me->set("wsk/whip", "D");
                me->set("wsk/axe", "D");
                me->set("wsk/hammer", "D");
                me->set("wsk/unarmed", "C");
                me->set("wsk/fork", "D");
                me->set("zhiye/name", "上忍");
                me->set("zhuanzhi3",1);
                me->set("huixin",70);
                me->set("shangrensp",1);
            write(msg);
              break;
  }
  return 1;
}
