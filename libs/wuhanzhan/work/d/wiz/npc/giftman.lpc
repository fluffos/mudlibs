// 神话世界·西游记２０００　WUHEE WIZ.GROUP
// modified by misu 1999/12/30
//   专门派送礼物

#include <ansi.h>
inherit NPC;
int do_give();
int answer_player();

#define __AGE_LIMIT__
//#undef        __AGE_LIMIT__
#define __DEBUG__
//#undef __DEBUG__

void create()
{
        set_name("元旦使者", ({"shizhe"}));
        set("gender", "男性");
        set("combat_exp", 1000);
        set("age", 26);
        set("per", 30);
        set("attitude", "friendly");
        set("shen_type", 1);
        set_skill("unarmed", 10);
        set("inquiry",([
                "礼物"  :  (: do_give()  :),
        ]));

        setup();

        carry_object("/d/obj/cloth/linen")->wear();
        add_money("silver", 1);
}

void die()
{
        set("eff_kee",1000);
        set("kee",1000);
        set("eff_sen",1000);
        set("sen",1000);
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() )
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {  // 1/3 chance to greet.
                case 0:
                        say( name()+"笑咪咪地说道：这位" +
RANK_D->query_respect(ob)
                                 + "，元旦快乐！哈哈。有礼物哟！\n");
                        break;
                case 1:
                        say( name()+"笑咪咪地说道：这位" +
RANK_D->query_respect(ob)
                               + "，元旦来了,期末考试也到了,没毕业的朋友可要小心,千万别挂咯!\n");
                        break;

                case 2:
                        say( name()+"笑咪咪地说道：这位" +
RANK_D->query_respect(ob)
                                + "，谢谢大家对mud的支持和厚爱,有礼物送给你啊！\n");
                        break;

        }
}

int do_give()
{
    object xiao = this_object();
    object who = this_player();
    string stime;
    int		year, days, hour, exp, pot;

#ifdef  __AGE_LIMIT__
        if( who->query("mud_age") < 24*60*60 )
        {
                tell_object(who,"年纪太小，暂不得礼。\n");
                return 1;
        }
#endif  //__AGE_LIMIT__

#ifdef  __DEBUG__
        command("say 哎，有个巫师派我到这里来等着，我也不知道发不发礼物。\n");
	return 1;
#else
        who->add_temp("giftman_asked",1);
        if( (int)who->query_temp("giftman_asked")>=5 )
        {
                command("say " + who->query("name") + "，你问来问去，烦不烦呀！");
                return 1;
        }

        stime = ctime(time());
	if( sscanf(stime,"%s Dec %d %d:%s",year,days,hour,stime)!=4 ) return 1;
	if( days != 31 || ( days == 31 && hour < 19 ) )
        {
                say(name()+"说：良辰未到，不敢派礼。\n请等到晚上七点之后来领取吧。\n");
                return 1;
        }

        if( who->query("_NEW_YEAR_GIFT_") == "given" )
        {
                xiao->command_function("say "+RANK_D->query_respect(who)+"的礼物不是已领了吗？还要？！哼！");
                return 1;
        }

        say( name()+"说：马上就是元旦节,有礼物发给大家啊!\n");

        exp = 50000 + ( who->query("age") - 14 ) * 300;
        pot = 300000 + ( who->query("age") - 14 ) * 2000;

    command("say 根据您的年龄，就给您"+COMBAT_D->chinese_daoxing(exp)+"道行和" + chinese_number(pot) + "点潜能吧。\n");
    
    who->add("combat_exp", exp);
    who->add("potential", pot);
        who->set("_NEW_YEAR_GIFT_","given");
        who->save();
        return 1;
#endif
}

