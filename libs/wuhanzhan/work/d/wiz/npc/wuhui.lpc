//wuhui.c
//by forsky
#include <ansi.h>

inherit NPC;

#include "dirtyword.h"

void punish(object);

void create() {
  set_name("狱卒", ({ "yu zu", "yuzu" }));
  set("title", HIG "「巡查使」" NOR);
  set("gender", "男性");
  set("age", 30);
  set("per", 25);
  set("long", HIR "一个神秘的狱卒，你碰上他准是你干了什么坏事。\n" NOR);
  set("combat_exp", 10000000);
  set("attitude", "peaceful");
  set("str", 50);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("max_force", 1000);
  setup();
  if (clonep()) CHANNEL_D->register_relay_channel("rumor");
  if (clonep()) CHANNEL_D->register_relay_channel("chat");
  if (clonep()) CHANNEL_D->register_relay_channel("es");
  if (clonep()) CHANNEL_D->register_relay_channel("sldh");
  if (clonep()) CHANNEL_D->register_relay_channel("menpai");
  if (clonep()) CHANNEL_D->register_relay_channel("xian");

}

void relay_channel(object ob, string channel, string msg) {
  object where;

  int i;
  if (!userp(ob) || (channel == "sys")) return;

  for (i = 0; i < sizeof(msg_d); i++) {
    replace_string(msg_d[i], " ", "");
    if (strsrch(msg, msg_d[i]) >= 0) {
      ob->set("channel/chat_block", time() + 180);
      message("system", HIG "【消息】：" + ob->query("name") + "在公众频道使用粗言烂语，交谈频道被暂时关闭了。\n" NOR, users());
      return;
    }
  }
}
