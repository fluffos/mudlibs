#include <ansi.h>
inherit NPC;
#include "reporting.h"
string *degree_desc = ({
  HIC "武林新丁" NOR,
  HIB "江湖小虾" NOR,
  HIR "后起之秀" NOR,
  HIY "武林高手" NOR,
  HIC "威慑群侠" NOR,
  HIB "无双侠隐" NOR,
  HIR "世外高人" NOR,
  HIY "独步江湖" NOR,
  HIM "叱诧风云" NOR,
  HIW "笑傲三界" NOR,
});
#include <obstacle.h>
int ask_for_officer();
string try_me();
void create() {
  set_name("魏征", ({ "wei zheng", "wei" }));
  set("title", "大臣");
  set("gender", "男性");
  set("age", 30);
  set("per", 30);
  set("inquiry", ([
    "称谓": (: ask_for_officer :),
  ]));
  setup();
  carry_object("/d/obj/cloth/jinpao")->wear();
}
int ask_for_officer() {
  int lv, size1;
  object ob = this_player();
  lv = ob->query("shengwang") / 100;
  size1 = sizeof(obstacles);
  if (lv >= sizeof(degree_desc)) lv = sizeof(degree_desc) - 1;
  if (time() - ob->query_temp("last_time/officer") < 18000) {
    command("say " + ob->query("name") + "，你烦不烦啊。\n");
    return 1;
  }
  ob->set_temp("last_time/officer", time());
  ob->set("title", degree_desc[lv]);
  ob->set("chengwei", degree_desc[lv]);
  command("smile");
  message(
    "channel:chat",
    HIC + "【圣旨】魏征(wei zheng)：今奉皇帝玉旨，加封" + ob->query("name") + "为" + degree_desc[lv] + HIY "，钦此！\n" + NOR,
    users()
  );
  return 1;
}
