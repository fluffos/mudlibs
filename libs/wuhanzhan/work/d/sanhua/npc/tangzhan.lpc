inherit NPC;

string *list=({"ss-wjm","ss-xhp","ss-hdsz",
	});

int work_me();
int delete_ask(object me);
 
void create()
{
 
	set_name("唐斩", ({ "tang zhan", "tang", "zhan" }) );
	set("gender", "男性" );
	set("long", "三花堂大堂主，正四处召集杀手，同谋大事。\n");
	set("age",40);
	set("title", "大堂主");
	set("str", 40);
	set("int", 30);
	set("con", 30);
	set("spi", 30);
	set("per", 30);
	set("class", "xian");
	set("attitude", "heroism");
        set("combat_exp", 200000000);
	set("max_kee", 2000);
	set("max_sen", 2000);
	set("force",5000);
	set("max_force",3000);
	set("force_factor", 150);
        set("mana", 500000);
        set("max_mana", 30000);
        set("mana_factor", 1500);
	set("mana_factor", 150);

	set("eff_dx", 600000);
	set("nkgain", 600);

        set_skill("unarmed",570);
        set_skill("dodge",570);
        set_skill("parry",570);
        set_skill("sword", 580);
        set_skill("force", 570);
        set_skill("spells", 570);
        set_skill("changquan", 570);
        set_skill("liangyi-sword", 580);
        set_skill("baguazhou", 570);
        set_skill("moshenbu", 570);
        set_skill("lengquan-force", 570);
	map_skill("unarmed", "changquan");
	map_skill("force", "lengquan-force");
	map_skill("spells", "baguazhou");
	map_skill("sword", "liangyi-sword");
	map_skill("parry", "liangyi-sword");
	map_skill("dodge", "moshenbu");
	
	set("chat_chance",1);
	set("chat_msg", ({
		    name()+"说道：近日有人在我堂各处分舵捣乱，谁愿去为本堂主跑一趟？\n",
		    }));

        seteuid(getuid());

set("inquiry", ([
"sanhua": (: work_me :),
"kill": (: work_me :),
"杀手": (: work_me :),
]));

	setup();
	carry_object("/d/obj/armor/jinjia")->wear();
        carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}
 
int work_me()
{
	object ghost, me;
	int t, lvl;
	me=this_player();
       
       if (me->query_temp("asked/sanhua")) return 1;
       me->set_temp("asked/sanhua",1);
//     me->start_busy(5);
       call_out("delete_ask",1,me);
	//for first time.
	if(!me->query("sanhua")) {
		call_out("start_job", 1, me);
		return 1;
	}
	if( (t=(int)me->query("sanhua/time_start")) &&
		!me->query("sanhua/done")) {

	    if(t<=time() &&
                       time()<t+500) {
		command("heng");
		command(
 		  "say 老夫不是派你去刺杀"+me->query("sanhua/name")
		  +"吗？\n");
		return 1;
	    }
	    // failed, decrease lvl.
	    lvl=me->query_temp("sanhua/level");
	    if(lvl>0) lvl--;
	    me->set_temp("sanhua/level",lvl);

	    // allow ask again.
	} else { // job done
	    if(t<=time() &&
                    time()<t+ 40) {
		message_vision("$N想了想，说"+
			"：这位"+RANK_D->query_respect(me)
			+",近日平安无事,不妨先去歇息。\n",
			this_object(), me);
		return 1;
	    }
	    // succeed, increase lvl.
	    lvl=me->query_temp("sanhua/level");
	    if(lvl<8) lvl++; // total 9 levels: 0, ..., 8
	    else
		lvl=1; // reach the top level, reduce difficulty.
	    me->set_temp("sanhua/level",lvl);

	}
	me->delete("sanhua/time_start");
	call_out("start_job", 1, me);
	return 1;
}
int start_job(object me)
{	string where;
	object ghost;
	int lvl;

//	if(environment(me)!=environment()) return 1;
	if(me->query("sanhua/time_start")) return 1;
	me->delete("sanhua/done");

	// determine levels.
	// use temp mark, if quit, then start over.
	lvl=me->query_temp("sanhua/level");
	
        ghost = new(__DIR__+list[random(sizeof(list))]);
        where=ghost->invocation(me, lvl);
	
	message_vision("$N仔细想了想！\n",this_object());
	message_vision("$N对$n说道：近日"+where+"分舵大肆捣乱，"
		+"请暗中杀之！\n"
		,this_object(),me);
	me->set("sanhua/time_start", time());
	me->set("sanhua/name",ghost->query("name"));
	return 1;
}
int delete_ask(object me)
{
        me->delete_temp("asked/sanhua");
        return 1;
}
void init ()
{
    add_action("do_exercise",({"bian","bian tang zhan","tang","bian zhan"}));
}

int do_exercise(string arg)
{
    write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
    return 1;
}
