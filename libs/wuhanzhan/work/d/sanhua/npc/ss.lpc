void setname() {
  int i, j, k;
  string name, *id;

  i = (random(sizeof(names1) / 2)) * 2;
  j = (random(sizeof(names2) / 2)) * 2;
  k = (random(sizeof(names3) / 2)) * 2;

  name = names1[i] + names2[j] + names3[k];
  id = ({ names1[i + 1] + " " + names2[j + 1] +
    names3[k + 1], names1[i + 1] });

  set_name(name, id);

  set("race", "人类");
  if (random(2) > 0) {
    set("gender", "男性");
  } else {
    set("gender", "女性");
  }
  yaoguai_type = 1;
}


int cast_chance(int level) {
  return 5 + level / 2;
}

void create() {
  setname1();
  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :)
