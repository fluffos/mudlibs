#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string kick_back();

void create() {
  set_name(
    "美髯公",
    ({ "wu sheng", "wu", "sheng", "wusheng", "fighter", "immortal", "master", "shifu" })
  );

  set("gender", "男性");
  set("age", 34);
  set("str", 100);
  set("per", 180);
  set("cor", 30);
  set("cps", 35);
  set("long", "
风尘三隐之二，姓氏不详，是红拂女的丈夫。");
  set("title", HIB "风尘三侠隐" NOR);
  set("combat_exp", 2000000);
  set_skill("literate", 100);
  set_skill("unarmed", 280);
  set_skill("force", 280);
  set_skill("lengquan-force", 300);
  set_skill("dodge", 250);
  set_skill("axe", 300);
  set_skill("parry", 280);
  set_skill("sanban-axe", 300);
  set_skill("moyun-shou", 280);
  set_skill("bashishentong", 220);
  set_skill("yanxing-steps", 260);
  map_skill("dodge", "yanxing-steps");
  map_skill("parry", "sanban-axe");
  map_skill("force", "lengquan-force");
  map_skill("axe", "sanban-axe");
  set("max_sen", 8000);
  set("max_kee", 4000);
  set("force", 5000);
  set("max_force", 10000);
  set("max_mana", 1000);
  set("mana", 6000);
  set("force_factor", 500);
  set("mana_factor", 70);
  create_family("将军府", 1, "蓝");
  setup();
  carry_object("/d/obj/weapon/axe/huafu")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/u/gaoxiao/obj/shoes")->wear();
}
int attempt_apprentice(object me) {
  string myname = RANK_D->query_respect(me);
  if ((int)me->query("combat_exp") < 2000000) {
    command("say 就凭你这点本事,还是回去多练几年吧");
    return 0;
  }
  command("great");
  command("say 今天算是收到了一个可造之材。\n");
  command("recruit " + me->query("id"));
  return 1;
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "fighter");
}

void init() {
  object me;

  ::init();
  add_action("do_exercise", ({ "bian" }));
  if (interactive(me = this_player()) && !is_fighting()) {
    call_out("greeting", 0, me);
  }
}

void greeting(object me) {
  int mykar = me->query_kar();
  if (random(mykar) > 100) return;
  else {
    me->delete_temp("spellslevel");
    me->delete_temp("d_mana");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    return;
  }
}
int do_exercise(string arg) {
  write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
  return 1;
}
