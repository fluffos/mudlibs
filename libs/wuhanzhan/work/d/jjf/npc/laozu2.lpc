#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string kick_back();

void create()
{
  set_name("红拂女", ({ "hongfu nu", "hong", "nu","", "hongfu", "immortal", "master", "shifu" }));

  set("gender", "女性");
  set("age", 27);
  set("str", 40);
  set("per", 30);
  set("cor", 30);
  set("cps", 35);
  set("kar", 40);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("long","风尘三隐之三，一手剑法使的出神入话。");
  set("title", HIG"风尘三侠隐"NOR);
  set("combat_exp", 2000000);
  set_skill("literate", 200);
  set_skill("unarmed", 200);
  set_skill("force", 250);
  set_skill("lengquan-force", 250);
  set_skill("dodge", 300);
  set_skill("parry", 230);
  set_skill("spells", 290);
  set_skill("bashishentong", 320);
  set_skill("baguazhou", 290);
  map_skill("force", "lengquan-force");
  set_skill("sword", 300);
  set_skill("yanxing-steps", 300);
  map_skill("spells", "bashishentong");
  set_skill("baguazhou", 290);
  map_skill("sword", "xiaofeng-sword");
  map_skill("dodge", "yanxing-steps");
  map_skill("parry", "xiaofeng-sword");
  set("max_sen", 4500);
  set("max_kee", 3500);
  set("force", 3500); 
  set("max_force", 7000);
  set("force_factor", 300);
  set("max_mana", 5000);
  set("mana", 6000);
  set("mana_factor", 700);
  create_family("将军府", 1, "红");
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
     (: cast_spell, "zhou" :),
	}) );
  setup();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
  carry_object("/d/obj/weapon/spear/xwq");
  carry_object("/d/obj/armor/jinjia")->wear();
}
int attempt_apprentice(object me)
{
  string myname=RANK_D->query_respect(me);
  if ((int)me->query("combat_exp")< 2000000)
    {
      command("say 这位"+myname+"你还先去练练吧！");
      return 0;
    }
  command("smile");
  command("say 很好！多加努力吧。\n");
  command("recruit " + me->query("id") );
  return 1;
}
int recruit_apprentice(object ob)
{
  if( ::recruit_apprentice(ob) )
    ob->set("class", "fighter");
}

void init()
{
     object me;
   
     ::init();
    add_action("do_exercise",({"bian"}));
     if( interactive(me = this_player()) && !is_fighting() ) {
     call_out("greeting", 0, me);
}
}

void greeting(object me)
{
      int mykar=me->query_kar();
      if( random(mykar) > 100) return;
      else
 {
      me->delete_temp("spellslevel");
      me->delete_temp("d_mana");
      me->delete_temp("apply/name");
      me->delete_temp("apply/id");
      me->delete_temp("apply/short");
      me->delete_temp("apply/long"); 
      return;
    }
}
int do_exercise(string arg)
{
    write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
    return 1;
}
