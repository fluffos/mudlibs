inherit ROOM;
#include <room.h>

void create() {
  set("short", "清风细雨楼");
  set("long", @LONG
这里是天下第一武道场。每三年一次的比武大会都在这里举行,
一般来参加大会的都是一些在江湖上排得上名号的人物。由于这
里地势险要,所以本地的居民并不多。但风景格外秀丽，吸引了
不少隐居的江湖逸士。轻功绝佳者可以试着向上飞跃(tiao)。
LONG);

  set("exits", ([
    //  "south" : __DIR__"road1",      
  ]));
  set("outdoors", 1);
  setup();
}


void init() {
  add_action("do_tiao", "tiao");
}

int do_tiao() {
  object me = this_player();
  int dodge;

  dodge = me->query_skill("dodge", 1);

  if (dodge > 300) {
    message_vision("$N吸了口气，轻轻一跃，跳到高楼上。\n", me);
    //  me->move("/x/y/z");
  } else {
    message_vision("$N从半空中掉了下来，跌的鼻青脸肿！\n", me);
    me->unconcious();
  }
  return 1;
}
