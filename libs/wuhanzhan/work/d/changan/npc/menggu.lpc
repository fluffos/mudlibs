inherit NPC;
#include <ansi.h>

void create() {
  set_name("蒙古大夫", ({ "menggu doctor", "doctor" }));
  set("title", "民间");
  set("nickname", "全靠一把刀");
  set("shen_type", 1);

  set("str", 50);
  set("gender", "男性");
  set("age", 35);
  set("long", HIC
    "这个大夫长安城里唯一的一位做变性手术的人，掌管玩家的男女性别大权。\n" NOR);
  set("combat_exp", 50000);
  set("attitude", "friendly");

  setup();

}
