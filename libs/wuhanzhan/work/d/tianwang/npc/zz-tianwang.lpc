// zz-tianwang.c
inherit NPC;
string send_me(object me);
void create()
{
   set_name("魔礼青", ({ "zengzhang tianwang", "zz", "tianwang" }) );
   set("gender", "男性" );
   set("long",
     "增长天王为四大天王之首, 身高二丈四尺, 善用一杆长枪, \n"
     "枪法登峰造极, 更有密传「青云宝剑」, 「地，水，火，风」\n"
     "四式一出, 大罗金仙也难逃。\n"
   );
   set("class", "tianwang");
   set("age",50);
   set("title", "天宫天王府第三代弟子");
   set("attitude", "peaceful");
   set("str",40);
   set("int",30);
   set("max_kee",1100);
   set("kee",1100);
   set("max_sen",1100);
   set("sen",1100);
   set("combat_exp",1000000);
   set("force",2500);
   set("max_force",1500);
   set("mana",2500);
   set("max_mana",1600);
   set("force_factor", 80);
   set("mana_factor",80);
   set("eff_dx", 450000);
   set("nkgain", 500);
   set_skill("literate",90);
   set_skill("unarmed",140);   
   set_skill("parry",150);
   set_skill("dodge",140);
   set_skill("spear",160);
   set_skill("force",140);
   set_skill("spells", 150);
   set_skill("xiangmo-qiang",160);
   set_skill("fumo-shou", 150);
   set_skill("feixian-steps", 150);
   set_skill("sanqin-dao", 150);
   set_skill("boro-gong", 130);
   map_skill("dodge", "feixian-steps");
   map_skill("parry", "xiangmo-qiang");
   map_skill("spear","xiangmo-qiang");
   map_skill("unarmed", "fumo-shou");
   map_skill("spells", "sanqin-dao");
   map_skill("force", "boro-gong");
   create_family("天王府", 3, "天");
   set("inquiry", ([
     "name" : "在下增长天王魔礼青，奉圣谕把守南天门。",
     "here" : "这里就是南天门, 入内就是天界了。",
     "回去": (: send_me :),
     "back": (: send_me:),
   ]) );
   setup();

   carry_object("/d/obj/weapon/spear/jinqiang")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
   carry_object("/ymdh/obj/pifeng")->wear();
   carry_object("/ymdh/obj/kui")->wear();
}

string send_me(object me)
{
   me=this_player();
   if( me->is_fighting() )
     return ("刚来就惹麻烦，鬼才要理你！\n");
        if( me->is_busy() || me->query_temp("pending/exercising"))
     return ("忙完再说吧。。。\n");
   message_vision("增长天王哈哈大笑，对$N说道：本王这就送你回去！\n", me);
   message_vision("增长天王飞起一脚把$N踢了下去。。。\n", me);
   me->move("/d/changan/nbridge");
   tell_room( environment(me), "「咕咚」一声，从天上掉下个人来！\n", ({me}));
   write("你从天上摔了下来，搞了个鼻青脸肿！\n");
   return ("老夫脚正痒痒。。。\n");
}

int attempt_apprentice(object me)
{
   string myname=RANK_D->query_respect(me);
   if ((int)me->query("combat_exp")< 100000)
     {
       command("say 这位"+myname+"还是先去跟本府小将打打基础吧！");
       return 0;
   }
   command("haha");
   command("say 很好，时下世间群魔乱舞，"+myname+"多加努力，他日必定有成。\n");
   command("recruit " + me->query("id") );
   command("addoil" + me->query("id") );
   return 1;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "tianwang");
}
