inherit NPC;
void create() {
  set_name("魔礼红", ({ "tian wang", "guangmu tianwang", "hong", "tianwang" }));
  set("gender", "男性");
  set("long",
    "魔家四将之一，使一杆方天画戟，秘授一把伞。名曰：「混元伞。」\n"
    "伞皆明珠穿成，有祖母绿，祖母碧，夜明珠，辟尘珠，辟火珠，辟水\n"
    "珠，消凉珠，九曲珠，定颜珠，定风珠。还有珍珠穿成「装载乾坤」\n"
    "四字，这把伞不敢撑，撑开时天昏地暗，日月无光，转一转乾坤晃动。\n");

  set("rank_info/self", "本天王");
  set("rank_info/respect", "护国天王");
  set("class", "tianwang");
  set("title", "天宫天王府第三代弟子");
  set("age", 43);
  set("str", 30);
  set("int", 37);
  set("max_kee", 1200);
  set("kee", 1100);
  set("max_sen", 1100);
  set("sen", 1100);
  set("combat_exp", 1000000);
  set("force", 2500);
  set("max_force", 1500);
  set("mana", 2500);
  set("max_mana", 1500);
  set("force_factor", 70);
  set("mana_factor", 80);
  set("eff_dx", 450000);
  set("nkgain", 450);
  set_skill("unarmed", 140);
  set_skill("literate", 100);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("dangmo-axe", 140);
  set_skill("force", 140);
  set_skill("spells", 160);
  set_skill("axe", 150);
  set_skill("fumo-shou", 140);
  set_skill("feixian-steps", 150);
  set_skill("sanqin-dao", 150);
  set_skill("boro-gong", 150);
  map_skill("dodge", "feixian-steps");
  map_skill("parry", "dangmo-axe");
  map_skill("spear", "dangmo-axe");
  map_skill("unarmed", "fumo-shou");
  map_skill("spells", "sanqin-dao");
  map_skill("force", "boro-gong");
  create_family("天王府", 3, "天");
  set("inquiry", ([
    "name": "在下广目天王魔礼红，奉圣谕把守东天门。",
    "here": "这里就是东天门, 入内就是天界了。",
  ]));

  setup();
  carry_object("/d/obj/weapon/axe/huafu")->wield();
  carry_object("/d/obj/armor/tiejia")->wear();
}


int attempt_apprentice(object me) {
  string myname = RANK_D->query_respect(me);
  if ((int)me->query("combat_exp") < 100000) {
    command("say 这位" + myname + "还是先去跟本府小将打打基础吧！");
    return 0;
  }
  command("haha");
  command("say 很好，时下世间群魔乱舞，" + myname + "多加努力，他日必定有成。\n");
  command("recruit " + me->query("id"));
  command("addoil" + me->query("id"));
  return 1;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "tianwang");
}
