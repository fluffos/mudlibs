inherit NPC;

void create() {

  set_name("鱼师将", ({ "yushi jiang", "jiang", "yushi" }));
  set("gender", "男性");
  set("long", "托塔李天王帐下大将，膀阔腰圆，力大无穷。\n");
  set("title", "天宫天王府第四代弟子");
  set("age", 40);
  set("str", 30);
  set("int", 20);
  set("con", 30);
  set("spi", 20);
  set("per", 15);
  set("class", "tianwang");
  set("attitude", "heroism");
  set("combat_exp", 100000);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 40);
  set("mana", 800);
  set("max_mana", 800);
  set("mana_factor", 40);
  create_family("天王府", 4, "天");

  set_skill("unarmed", 80);
  set_skill("literate", 90);
  set_skill("parry", 90);
  set_skill("dodge", 80);
  set_skill("spear", 80);
  set_skill("force", 80);
  set_skill("spells", 90);
  set_skill("axe", 70);
  set_skill("xiangmo-qiang", 90);
  set_skill("fumo-shou", 80);
  set_skill("feixian-steps", 80);
  set_skill("sanqin-dao", 70);
  set_skill("boro-gong", 80);
  set_skill("dangmo-axe", 70);
  map_skill("dodge", "feixian-steps");
  map_skill("parry", "xiangmo-qiang");
  map_skill("spear", "xiangmo-qiang");
  map_skill("unarmed", "fumo-shou");
  map_skill("spells", "sanqin-dao");
  map_skill("force", "boro-gong");
  map_skill("axe", "dangmo_axe");

  setup();

  carry_object("/d/obj/armor/tongjia")->wear();
  carry_object("/d/obj/weapon/spear/yinqiang")->wield();
}

void attempt_apprentice(object ob, object me) {
  command("say 很好，" + RANK_D->query_respect(ob) +
    "我们天王府需要的就是你这样的人材！\n");
  command("recruit " + ob->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "tianwang");
}
