#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("李靖", ({ "li jin", "li", "li","jin", "lijin", "immortal", "master", "shifu" }));

  set("gender", "男性");
  set("age", 35);
  set("str", 40);
  set("per", 30);
  set("cor", 30);
  set("cps", 35);
  set("kar", 40);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("long","
天王府开山祖师，御封的镇魔大元帅。");
  set("title", HIY"镇魔大元帅"NOR);
  set("combat_exp", 3000000);
  set_skill("literate", 200);
  set_skill("whip", 300);
  set_skill("duanyun-bian", 300);
  set_skill("unarmed", 280);
  set_skill("force", 280);
  set_skill("boro-gong", 280);
  set_skill("spear", 320);
  set_skill("axe", 250);
  set_skill("dangmo-axe", 250);
  set_skill("dodge", 280);
  set_skill("parry", 290);
  set_skill("xiangmo-qiang", 320);
  set_skill("fumo-shou", 280);
  set_skill("spells", 290);
  set_skill("sanqin-dao", 290);
  set_skill("feixian-steps", 280);
  map_skill("force", "boro-gong");
  map_skill("unarmed", "fumo-shou");
  map_skill("spells", "sanqin-dao");
  map_skill("spear", "xiangmo-qiang");
  map_skill("dodge", "feixian-steps");
  map_skill("axe", "dangmo-axe");
  map_skill("whip", "duanyun-bian");
  map_skill("parry", "xiangmo-qiang");

  set("max_sen", 4500);
  set("max_kee", 3500);
  set("force_factor", 300);
  set("force", 8000);
  set("max_force", 8000);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 700);

  create_family("天王府", 1, "天");
  setup();
  carry_object("/d/obj/weapon/spear/zhenmo-qiang")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}
void attempt_apprentice(object ob)
{
    ob=this_player();
    if( (string)ob->query("family/family_name")=="天王府") {
    if ( (int)ob->query("combat_exp")< 2000000) {
    command("say 这位"+ RANK_D->query_respect(ob) +"还是先去跟本府天王们打打基础吧！");
    return;
      }
    if ( (int)ob->query_skill("boro-gong",1)< 181) {
    command("say 你的大般若功修为太低，不能跟我学艺！");
    return;
      }
    command("haha");
    command("say 不错不错，"+  RANK_D->query_respect(ob) +"多加努力，他日必定早证大道。\n");
    command("recruit " + ob->query("id") );
    return;
      }
}

int recruit_apprentice(object ob)
{
    if( ::recruit_apprentice(ob) )
    ob->set("class", "tianwang");
}

void init()
{
     object me;
   
     ::init();
    add_action("do_exercise",({"bian"}));
     if( interactive(me = this_player()) && !is_fighting() ) {
     call_out("greeting", 0, me);
}
}

void greeting(object me)
{
      int mykar=me->query_kar();
      if( random(mykar) > 100) return;
      else
 {
      me->delete_temp("spellslevel");
      me->delete_temp("d_mana");
      me->delete_temp("apply/name");
      me->delete_temp("apply/id");
      me->delete_temp("apply/short");
      me->delete_temp("apply/long"); 
      return;
    }
}
int do_exercise(string arg)
{
    write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
    return 1;
}
