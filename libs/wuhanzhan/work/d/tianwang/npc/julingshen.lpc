// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <ansi.h>
inherit NPC;
string expell_me(object me);

void create()
{
   set_name("巨灵神", ({ "juling shen", "shen", "juling" }) );
   set("gender", "男性" );
   set("long","托塔李天王帐下先锋大将，膀阔腰圆，力大无穷。\n");
   set("age",40);
   set("title",HIW "先锋大将" NOR);
   set("str", 40);
   set("int", 20);
   set("con", 30);
   set("spi", 20);
   set("per", 15);
   set("class", "tianwang");
   set("attitude", "heroism");
  set("combat_exp", 2000000);
   set("max_kee", 1200);
   set("max_sen", 1000);
   set("force",2000);
   set("max_force",2000);
   set("force_factor", 80);
   set("mana", 2000);
   set("max_mana", 2000);
   set("mana_factor", 80);
   set("eff_dx", 400000);
   set("nkgain", 400);
   create_family("天王府", 2, "天");
   set_skill("unarmed",180);
   set_skill("dodge",170);
   set_skill("spear",170);
   set_skill("parry",180);
   set_skill("axe", 190);
   set_skill("force", 180);
   set_skill("spells", 170);
   set_skill("literate", 120);
   set_skill("fumo-shou", 170);
   set_skill("xiangmo-qiang", 170);
   set_skill("dangmo-axe", 190);
   set_skill("sanqin-dao", 150);
   set_skill("feixian-steps", 170);
   set_skill("boro-gong", 180);
   map_skill("unarmed", "fumo-shou");
   map_skill("force", "boro-gong");
   map_skill("spells", "sanqin-dao");
   map_skill("axe", "dangmo-axe");
   map_skill("parry", "dangmo-axe");
   map_skill("dodge", "feixian-steps");
   map_skill("spear", "xiangmo-qiang");
   set("inquiry", ([
     "name" : "在下托塔李天王帐下先锋大将是也！",
     "here" : "这里就是"HIC"天王府"NOR"！",
     "转业": (: expell_me :),
     "leave": (: expell_me :),
   ]) );

   setup();
   carry_object("/d/obj/armor/jinjia")->wear();
        carry_object("/d/obj/qlj/obj/jingshi1");
}

void attempt_apprentice(object me)
{
   string myname=RANK_D->query_respect(me);
   if ((int)me->query_skill("boro-gong",1)< 120)
     {
       command("say 你的内功修为太低，不能跟我学艺！");
       return;
   }
  if ((int)me->query("combat_exp")< 350000)
{
command("say 这位"+myname+"还是先去跟本府天王们打打基础吧！");
return 0;
}
   command("say 跟着我学艺，肯定能打败那只孙猴子。\n");
   command("recruit " + me->query("id") );
   command("heng");
   return;
}

int recruit_apprentice(object ob)
{
     if( ::recruit_apprentice(ob) )
                ob->set("class", "tianwang");
}

string expell_me(object me)
{
  me=this_player();
  if((string)me->query("family/family_name")=="天王府") 
  {
      me->set_temp("betray_tianwang", 1);
      command("sigh");
      return ("天规不可违，你须受罚，你可愿意(agree)？");
  }
  return ("你不是本派第子！");
}

void init()
{
  add_action("do_agree", "agree");
}
int do_agree(string arg)
{
  if(this_player()->query_temp("betray_tianwang"))    
  {      message_vision("$N答道：弟子愿意。\n\n", this_player());
     command("say 那你便去吧，江湖险恶，好自为之。。。");
     this_player()->add("betray/count",1);
     this_player()->add("betray/tianwang", 1);
     this_player()->set("combat_exp", (this_player()->query("combat_exp")/10)*8);     
     this_player()->delete("family");
     this_player()->delete("class");
     this_player()->set("title", "普通百姓");
     this_player()->set_temp("betray_tianwang", 0);
     this_player()->save();
     return 1;
  }
  return 0;
}
