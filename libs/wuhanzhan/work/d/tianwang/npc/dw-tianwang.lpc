
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("魔礼海", ({ "tian wang", "duowen tianwang", "hai", "tianwang" }) );
        set("gender", "男性" );
        set("long",
                "魔家四将之一，背上一面琵琶，上有四条弦；也按\n"
                "地、水、火、风，拨动弦声，风火齐至，如青云剑一般。\n");

        set("rank_info/self", "本天王");
   set("rank_info/respect", "多闻天王");
   set("class", "tianwang");
   set("title", "天宫天王府第三代弟子");
   set("age",43);
   set("str",30);
   set("int",37);
   set("max_kee",1200);
   set("kee",1100);
   set("max_sen",1100);
   set("sen",1100);
   set("combat_exp",1000000);
   set("force",2500);
   set("max_force",1500);
   set("mana",2500);
   set("max_mana",1500);
   set("force_factor", 70);
   set("mana_factor",80);
   set("eff_dx", 450000);
   set("nkgain", 450);
   set_skill("unarmed",140);
   set_skill("literate",100);   
   set_skill("parry",160);
   set_skill("dodge",150);
   set_skill("whip",140);
   set_skill("force",150);
   set_skill("spells", 150);
   set_skill("duanyun-bian",150);
   set_skill("fumo-shou", 150);
   set_skill("feixian-steps", 150);
   set_skill("sanqin-dao", 140);
   set_skill("boro-gong", 150);
   map_skill("dodge", "feixian-steps");
   map_skill("parry", "duanyun-bian");
   map_skill("spear","duanyun-bian");
   map_skill("unarmed", "fumo-shou");
   map_skill("spells", "sanqin-dao");
   map_skill("force", "boro-gong");
   create_family("天王府", 3, "天");
        set("inquiry", ([
                "name" : "在下就是多闻天王，奉圣谕把守西天门。",
                "here" : "这里就是西天门，东面就是天界了。",
        ]) );
        setup();
        carry_object("/d/obj/weapon/whip/whip")->wield();
        carry_object("/d/obj/armor/tiejia")->wear();

}

int attempt_apprentice(object me)
{
   string myname=RANK_D->query_respect(me);
   if ((int)me->query("combat_exp")< 100000)
     {
       command("say 这位"+myname+"还是先去跟本府小将打打基础吧！");
       return 0;
     }
   command("haha");
   command("say 很好，时下世间群魔乱舞，"+myname+"多加努力，他日必定有成。\n");   
   command("recruit " + me->query("id") );
   command("addoil" + me->query("id") );
   return 1;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "tianwang");
}
