// gate.c

inherit ROOM;

void create()
{
   set("short", "天王府");
   set("long", @LONG
这里就是天宫的护卫拜师学艺的地方，慕名来的人很多。大门两侧
有两个高大威猛的卫兵。院子里看起来金碧辉煌的。南边是个空场，
大概是天王府操练的地方。
LONG
   );
   set("exits", ([ /* sizeof() == 2 */
    "north" : "/d/sky/yunlougate",
    "south" :  __DIR__"fight",
]));
  set("objects", ([ /* sizeof() == 1*/ 
  "/d/sky/npc/tian-bing" : 2,
]));

   set("out_doors", 1);
   set("no_fight",1);
   set("no_magic",1);
   setup();
}

int valid_leave(object me, string dir)
{
        if( (string)me->query("family/family_name")=="天王府" ) return 1;
	if((int)me->query("combat_exp") > 3000000) return 1;
        if( wizardp(me)) return 1;

        if (dir == "south") {
        if (objectp(present("tian bing", environment(me))))
        return notify_fail("天兵怒喝一声：“大胆！”将你拦了下来。\n");
        }   
        return ::valid_leave(me, dir);
}

