#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int give_me(object ob);
int give_me2(object ob);

void create() {
  set_name(HIG "孔雀明王" NOR, ({ "kongque mingwang", "kongque", "mingwang", "wang" }));
  set("title", HIW "雪山祖师" NOR);
  set("gender", "男性");
  set("age", 47);
  set("per", 40);
  set("str", 30);
  set("int", 30);
  set("long",
    "孔雀明王乃大鹏之兄，当年吃人无数做恶多端，被如来降伏之后，心中不高兴去
过佛门的清苦生活，就下山帮其弟重振雪山的威风，雪山的弟子可以试着向他要
武功秘籍（魔剑图录，神刀秘籍）\n");
  set("class", "yaomo");
  set("attitude", "friendly");
  create_family("大雪山", 1, "祖师");
  set("rank_info/respect", "明王");
  set_skill("unarmed", 250);
  set_skill("cuixin-zhang", 280);
  set_skill("throwing", 300);
  set_skill("dodge", 300);
  set_skill("xiaoyaoyou", 300);
  set_skill("parry", 260);
  set_skill("blade", 320);
  set_skill("bingpo-blade", 270);
  set_skill("force", 300);
  set_skill("sword", 300);
  set_skill("bainiao-jian", 290);
  set_skill("ningxie-force", 290);
  set_skill("literate", 200);
  set_skill("spells", 300);
  set_skill("dengxian-dafa", 270);
  map_skill("spells", "dengxian-dafa");
  map_skill("force", "ningxie-force");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("blade", "bingpo-blade");
  map_skill("sword", "bainiao-jian");
  map_skill("dodge", "xiaoyaoyou");
  set("max_kee", 5500);
  set("max_sen", 5500);
  set("force", 7000);
  set("max_force", 3800);
  set("mana", 10000);
  set("max_mana", 5000);
  set("force_factor", 300);
  set("mana_factor", 300);
  set("combat_exp", 5000000);
  set_temp("apply/damage", 200);
  set_temp("spply/armor", 200);
  set_temp("apply/dodge", 200);

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "chaofeng" :),
    (: cast_spell, "tuntian" :),
    (: cast_spell, "juanbi" :),
  }));

  set("inquiry", ([
    "魔剑图录": (: give_me2 :),
    "神刀秘籍": (: give_me :),
  ]));
  setup();
  carry_object("/d/obj/cloth/mangpao")->wear();
  carry_object("/d/obj/weapon/sword/fenghuang")->wield();
  //  if ("/u/sadboy/ping"->in_mud())
  // carry_object("/u/sadboy/obj/pingfake");
  // else
  // carry_object("/u/sadboy/obj/ping");
}

void attempt_apprentice(object ob) {
  if ((string)ob->query("class") == "bonze" && (string)ob->query("gender") == "男性") {
    command("kick " + ob->query("id"));
    command("say 快滚！我一看到和尚就有气。\n");
    return;
  }
  if ((string)ob->query("family/family_name") == "大雪山") {
    if ((int)ob->query("family/generation") > 2) {
      command("say 没有舍弟的推荐，本王很难考虑。\n");
    }
    if (((int)ob->query_skill("dengxian-dafa", 1) < 181)) {
      command("say " + RANK_D->query_respect(ob) + "本派法术修为不够，收了你也没用。\n");
      return;
    } else {
      if ((int)ob->query("combat_exp") >= 2000000) {
        command("great ");
        command("say 好，" + RANK_D->query_respect(ob) + "有了明王的推荐，跟我好好干！\n");
        command("recruit " + ob->query("id"));
      } else {
        command("say 你还是跟着舍弟先学着吧。\n");
      }
    }
  }

  else {
    command("hmm");
    command("say 这位" + RANK_D->query_respect(ob) + "，在本门可没有一步登天的事。\n");
  }
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "yaomo");
}

void init() {
  object me;

  ::init();
  add_action("do_exercise", ({ "bian" }));
  if (interactive(me = this_player()) && !is_fighting()) {
    call_out("greeting", 0, me);
  }
}

void greeting(object me) {
  int mykar = me->query_kar();
  if (random(mykar) > 100) return;
  else {
    me->delete_temp("spellslevel");
    me->delete_temp("d_mana");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    return;
  }
}
int do_exercise(string arg) {
  write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
  return 1;
}

int give_me(object ob) {
  object who, me, book;
  who = this_player();
  me = this_object();

  if ((string)who->query("family/family_name") != "大雪山") {
    if ((int)who->query_temp("pending/ask_time") >= 3) {
      message_vision("$N突然跳起，恶狠狠的瞪着$n说：看来你是不想活了！\n", me, who);
      command("kill " + who->query("id"));
      return 1;
    }
    message_vision("$N斜斜地瞟了$n一眼，说：此不足为外人道也！\n", me, who);
    who->add_temp("pending/ask_time", 1);
    return 1;
  }
  if (who->query("give_me") > 5) {
    command("heng");
    tell_object(who, "给了你这么多次机会你还没有领悟？滚！\n");
    return 1;
  } else
    book = new("/d/obj/book/xblade");
  message_vision("$N点了点头，对着$n笑道：此乃我派刀法精华，你需好生收藏！\n", me, who);
  command("point " + who->query("id"));
  book->move(who);
  who->add("give_me", 1);
  message_vision("$N叹了口气道：我雪山派武功法术皆为上品，却苦于无练武奇才继承我之衣钵！\n", me);
  return 1;
}

int give_me2(object ob) {
  object who, me, book;
  who = this_player();
  me = this_object();
  if ((string)who->query("family/family_name") != "大雪山") {
    if ((int)who->query_temp("pending/ask_time") >= 3) {
      message_vision("$N突然跳起，恶狠狠的瞪着$n说：看来你是不想活了！\n", me, who);
      command("kill " + who->query("id"));
      return 1;
    }
    message_vision("$N斜斜地瞟了$n一眼，说：此不足为外人道也！\n", me, who);
    who->add_temp("pending/ask_time", 1);
    return 1;
  }
  if (who->query("give_me2") > 5) {
    command("puke");
    tell_object(who, "给你这么多次机会你都没有领悟？滚！\n");
    return 1;
  } else
    book = new("/d/obj/book/xsword");
  message_vision("$N点了点头，对着$n笑道：此乃我派剑法精华，你需好生收藏！\n", me, who);
  command("point " + who->query("id"));
  book->move(who);
  who->add("give_me2", 1);
  message_vision("$N叹了口气道：我雪山派武功法术皆为上品，却苦于无练武奇才继承我之衣钵！\n", me);
  return 1;
}
