//standroom.c used by weiqi...others may hate this format:D
//updated by yangwl 1.29.2001
//xihai.c

inherit ROOM;

void create() {
  set("short", "西海之畔");
  set("long", @LONG

见惯了一望无际的雪原，巍峨雄伟的冰山，突然间碧波万顷，浩
瀚壮阔的水面展现在面前，你顿时觉得一股柔情蜜意涌上心头。
山，湖，草，鸟，仿佛是到了另一个世界。
据说大雪山的孔雀明王以前带着他的女儿到这里散步时,曾经遗失过
什么贵重的东西。
LONG);

  set("exits",
    ([  //sizeof() == 4
    "east": __DIR__ "xueshan5",
    ]));

  set("outdoors", "xueshan");
  setup();
}


void init() {
  add_action("do_dig", "dig");
  add_action("do_dig", "wa");
}

int do_dig(string arg) {

  object ob, me;

  me = this_player();

  if ((!arg) || (arg != "ling" && arg != "kongqueling"))
    return notify_fail("你要挖什么？\n");
  if (!(ob = me->query_temp("weapon")) || ((string)ob->query("skill_type") != "axe" && (string)ob->query("skill_type") != "blade" && (string)ob->query("skill_type") != "sword"))
    return notify_fail("得找个好工具吧。\n");
  if (query("no_ling"))
    return notify_fail("看来你来迟了。\n");
  if (!me->query("kongqueling_dig_ok"))
    return notify_fail("你试着在湖边挖了几下,似乎有所发现。\n");
  if (me->query_skill("ningxie-force", 1) < 300)
    return notify_fail("你挖了一会儿，看见地上露出几根羽毛一样的东西，高兴地去拿时，却差点没被冻死！ \n");

  ob = new("/d/obj/weapon/throwing/kongqueling");
  ob->move(me);
  message_vision("$N挖了半天,居然翻出来几根孔雀翎! \n", me);
  set("no_ling", 1);
  call_out("regenerate", 600);
  me->add("sen", -300);
  me->add("kee", -300);
  return 1;
}

int regenerate() {
  set("no_ling", 0);
  return 1;
}
