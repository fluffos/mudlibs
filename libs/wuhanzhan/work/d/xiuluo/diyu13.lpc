int valid_leave(object me, string dir) {
  if (dir == "down") {
    if (objectp(present("gui", environment(me))))
      return notify_fail("鬼怪叫道：“你给老子找死吗？竟敢来我十八层地狱！\n");
  }

  return ::valid_leave(me, dir);
}
