inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "地狱之门");
  set("long", @LONG
  
            十
            八
            层
            地
            狱
            之
            门
      
LONG);
  set("exits", ([
    "out": __DIR__ "lu6",
  ]));
  set("item_desc", ([
    "men": "\n地狱之门\n\n"
  ]));

  setup();
}

void init() {
  add_action("do_break", "break");
}

int do_break(string arg) {
  object me = this_player();

  if (arg != "men")
    return 0;

  message_vision("$N大喝一声，使尽全身内力击向地狱之门！\n\n", me);
  if (me->query("force") < 1000 ||
    me->query("mana") < 1000) {
    me->unconcious();
    me->set("force", 0);
    me->set("mana", 0);
  } else {
    me->add("force", -1000);
    me->add("mana", -1000);
    message_vision("刹那间天崩地裂，你已经撞开了地狱之门！\n", me);
    message(
      "channel:rumor",
      HIY + "【佛界】如来佛祖 (rulai fo): 大胆" + me->query("name") + "！居然私自打开了黑暗之门！\n" + NOR,
      users()
    );
    message("channel:rumor", HIR + "【阿修罗界】魔佛无天(wu tian): 嘿嘿，我又将横行三界了！\n" + NOR, users());
    this_object()->recreate();
    message_vision("\n但见：\n", me);
    message_vision(this_object()->query("long"), me);
    remove_call_out("precreate");
    call_out("precreate", 10, this_object());
  }
  return 1;
}

void precreate(object me) {
  tell_room(me, "轰隆一声巨响，一切都还原了！\n\n");
  me->create();
}

void recreate() {
  set("short", "地狱之门");
  set("long", @LONG
            十
            八
            层
            地
            狱
            之
            门


LONG);
  set("exits", ([
    //        "out"      : __DIR__"lu6",
    "enter": __DIR__ "diyu1",
  ]));

  setup();
}
