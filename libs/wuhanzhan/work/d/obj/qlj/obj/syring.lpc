#include <ansi.h>

#include <armor.h>
inherit FINGER;

inherit F_SAVE;
inherit F_BACKUP;

void create() {
  set_name(HIW "魔法指环" NOR, ({ "ring", "mofa zhihuan" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一枚具有魔力的指环\n"
      "再仔细玩看，似乎有其它作用 (info vir)。\n");
    set("unit", "枚");
    set("no_sell", 1);
    set("no_drop", 1);
    set("value", 5000);
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 1);
    set("armor_prop/spells", 1);
    set("wear_msg", "$N把$n带在中指上。\n");
  }
  setup();
}

void init() {
  if (this_player() == environment())
    add_action("do_info", "info");
  add_action("do_pray", "pray");
}

int do_info(string arg) {
  if (!arg) return notify_fail("你想祈祷什么? \n");
  write("使用 (pray start) ，它会带你去塞压星球。\n");
  return 1;
}

int do_pray(string arg) {

  object me = this_player();

  if (me->query("kee") < 10)
    return notify_fail("你现在的状态怎么能祈祷。\n");
  if (me->query("sen") < 10)
    return notify_fail("你现在的状态怎么能祈祷。\n");
  if (me->query_temp("zuochan"))
    return notify_fail("你现在正在坐禅,禅无二心。\n");
  if (me->query_temp("no_move"))
    return notify_fail("你现在被定住了,那里还有心思祈祷。\n");
  if (me->is_busy())
    return notify_fail("你现在忙着呢！\n");
  if (environment(me)->query("short") == "赛场"
    || environment(me)->query("short") == "藏经阁二楼"
    || environment(me)->query("short") == "擂台") return notify_fail("不要动坏脑筋了。\n");
  if (me->is_fighting())
    return notify_fail("你正在战斗,不能停下来祈祷\n");
  if (!wizardp(me) && environment(me)->query("no_move"))
    return notify_fail("这里不准移动。\n");



  if (!arg || arg != "start") return notify_fail("你要祈求什么? \n");
  {
    message_vision(HIG "$N闭上双眼，对着戒指喃喃的祈祷。\n"
      WHT "手上的戒指发出一道霞光。 $N不见了.... \n" NOR, this_player());
    this_player()->receive_damage("sen", 50);
    this_player()->move("/d/obj/qlj/room/syroom");
  }
  return 1;
}
