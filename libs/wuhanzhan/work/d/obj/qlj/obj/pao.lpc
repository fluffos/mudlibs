#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIB "神龙仙袍" NOR, ({ "xian pao", "cloth", "pao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIB "天界的神龙专用仙袍。\n" NOR);
    set("material", "cloth");
    set("unit", "件");
    set("value", 100000);
    set("armor_prop/armor", 10);
    //    set("armor_prop/rake", 10);
    set("armor_prop/stick", 5);
    set("armor_prop/literate", -10);
    set("armor_prop/fork", 5);
    set("armor_prop/unarmed", -10);
    set("armor_prop/sword", 5);
    set("armor_prop/spear", 5);
    set("armor_prop/whip", 5);
    set("armor_prop/throwing", 5);
    set("armor_prop/dodge", -10);
    set("armor_prop/blade", 5);
    set("armor_prop/spells", -10);
    set("armor_prop/force", -10);
    set("armor_prop/parry", 5);
  }
  setup();
}
