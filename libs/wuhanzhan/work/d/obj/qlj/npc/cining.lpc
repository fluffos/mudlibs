        set("attitude", "friendly");
        set("class", "moon");

        set("age", 19);
        set("per", 29);
        set("max_kee", 9000);
        set("max_sen", 9000);
        set("force", 2500);
        set("max_force", 3500);
        set("force_factor", 40);
        set("max_mana", 4500);
        set("mana", 3900);
        set("mana_factor", 30);
        set("combat_exp", 5000000);

        set("shen_type", 1);

        set("eff_dx", 90000);
        set("nkgain", 300);


        set_skill("force", 290);
        set_skill("unarmed", 290);
        set_skill("dodge", 290);
        set_skill("jienan-zhi", 290);
        set_skill("parry", 90);
        set_skill("spells", 90);
        set_skill("buddhism", 90);
