void init()
{
        add_action("do_jump", "jump");
}
int do_jump(string arg)
{       
        object me;
        me=this_player();

        if ( !arg || ((arg != "cloud") ))
                return notify_fail("你要往哪跳？\n");
        else
message_vision("$N眼睛一闭,纵身往云雾里跳去．．\n",me);

                me->move("/d/obj/qlj/room/lingyue");
                message_vision("一股怪风卷了起来，原来云深处竟然有一个世外仙岛．\n", me);
                return 1;
}

