#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "毛主席雕像" NOR, ({ "diao xiang" }));
  set_weight(10000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一尊栩栩如生的雕像，你可以向它敬礼（jingli）。\n");
    set("no_get", 1);
    set("unit", "尊");
  }
  setup();
}
int init() {
  add_action("do_jingli", "jingli");
}
int do_jingli(string arg) {
  string *msgs = ({
    "$N向雕像庄严的敬了个礼。\n",
  });
  string *actions = ({
    "你的能力有一点提高。\n",
  });
  object me = this_player();
  object diaoxiang = this_object();
  if (arg != "xiang" &&
    arg != "diao xiang") {
    tell_object(me, "你想向谁敬礼？\n");
    return 1;
  }
  if ((int)me->query("jingli") != 0) {
    tell_object(me, "你敬过一次礼了，再敬礼也得不到什么了！\n");
    return 1;
  }
  if (me->query_temp("weapon") ||
    me->query_temp("secondary_weapon")) {
    tell_object(me, "你想拿着武器敬礼？\n");
    return 1;
  }
  me->set("jingli", 1);
  message_vision(msgs[random(sizeof(msgs))], me);
  me->add("potential", 200000);
  me->add("combat_exp", 100000);
  me->add("max_force", 100);
  me->add("max_mana", 100);
  tell_object(me, actions[random(sizeof(actions))]);
  return 1;
}
