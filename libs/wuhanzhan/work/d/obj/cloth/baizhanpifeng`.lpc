// by smile 
#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create()
{
  set_name(HIY "百战披风" NOR, ({"baizhan pifeng", "pifeng"}));
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "因当年托塔李天王平天下妖魔有功，玉皇大帝特意命人用万年蚕丝织了这件披风给他，以表其功。\n");
    set("material", "leather");
    set("unit", "件");
    set("value", 40000);
    set("armor_prop/armor", 90);
    set("armor_prop/courage",8);
    set("armor_prop/dodge",50);
    set("armor_prop/spells",100);
  }
  setup();
}
