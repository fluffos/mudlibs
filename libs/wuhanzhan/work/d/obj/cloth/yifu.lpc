#include <armor.h>

inherit CLOTH;

void create() {
  set_name("布衣", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 100);
    set("armor_prop/armor_vs_force", 1000);
    set("armor_prop/spells", 500);
    set("armor_prop/dodge", 500);
    set("armor_prop/armor_vs_spells", 500);

  }
  setup();
}
