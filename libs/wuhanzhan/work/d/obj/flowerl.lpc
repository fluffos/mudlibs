#include <ansi.h>
inherit ITEM;
inherit F_SAVE;

mapping *mails;

void get_mail_text(mapping mail, string str);

void create() {
  set_name(HIY + "花篮" + NOR, ({ "basket", "basket" }));
  set("long",
    "这是一个盛放鲜花的篮子，据说鲜花放到这里能够保持艳丽：\n\n"
    "from                      查看花篮中的花。\n"
    "read <编号>           　　阅读花篮中的祝福留言。\n"
    "drop <编号>        　　 　丢弃一束花。\n"
  );
  set("unit", "个");
  set("no_drop", 1);
  set("no_give", 1);
  set("no_insert", 1);

  seteuid(getuid());
}

void set_owner(string id) {
  set("owner_id", id);
  mails = ({});
  restore();

  set("long",
    "这是一个盛放鲜花的篮子，据说鲜花放到这里能够保持艳丽：\n\n"
    "from                      查看花篮中的花。\n"
    "read <编号>           　　阅读花篮中的祝福留言。\n"
    "drop <编号>        　 　　丢弃一束花。\n"
  );
  set("no_drop", 1);
  set("no_give", 1);
}

void init() {

  if (this_player() && environment() == this_player()) {
    set_owner((string)this_player()->query("id"));
    this_player()->set_temp("basket_ob", this_object());
    set_name(HIY + "花篮" + NOR, ({ "basket", "basket" }));

    add_action("do_from", "from");
    add_action("do_read", "read");
    add_action("do_read", "readmail");
    add_action("do_drop", "drop");
    add_action("do_drop", "drop");


  }
}

string query_save_file() {
  string id;

  if (!stringp(id = query("owner_id"))) return 0;

  return DATA_DIR + "flower/" + id[0..0] + "/" + id;
}

void receive_mail(mapping mail) {
  if (!pointerp(mails)) mails = ({ mail });
  else mails += ({ mail });
  save();
}



int do_from() {
  int i;
  if (!pointerp(mails) || !sizeof(mails)) {
    write("你的花篮中目前没有花。\n");
    return 1;
  }

  write("你的花篮中现在共有 " + sizeof(mails) + " 束花：\n\n");
  for (i = 0; i < sizeof(mails); i++)
    printf("%1s %-3d %-40s 来自: %-20s\n",
      (mails[i]["status"] == "N" ? "N" : " "),
      i + 1, HIG + mails[i]["title"] + NOR, mails[i]["from"]);
  write("\n");
  return 1;
}

int do_read(string arg) {
  int num;

  if (!arg || !sscanf(arg, "%d", num))
    return notify_fail("你要读哪一个祝福？\n");

  if (!pointerp(mails) || num < 1 || num > sizeof(mails))
    return notify_fail("没有这个束花。\n");

  num--;

  printf("花编号：%d\n鲜花品种：%s\n送花时间：%s\n送 花 人：%s\n收 花 人：%s\n%s\n\n%s\n",
    num + 1, mails[num]["title"], ctime(mails[num]["time"]),
    mails[num]["from"], mails[num]["to"], mails[num]["pic"], mails[num]["text"]);
  mails[num]["status"] = "O";
  save();

  return 1;
}

int do_drop(string arg) {
  int num;

  if (!arg || !sscanf(arg, "%d", num))
    return notify_fail("你要丢弃哪一束花？\n");

  if (!pointerp(mails) || num > sizeof(mails))
    return notify_fail("没有这个束花。\n");

  num--;

  if (num != 0)
    if (num == sizeof(mails) - 1)
      mails = mails[0..num - 1];
    else
      mails = mails[0..num - 1] + mails[num + 1..sizeof(mails) - 1];
  else
    mails = mails[num + 1..sizeof(mails) - 1];
  save();
  write("Ok.\n");
  return 1;
}



void owner_is_killed() { destruct(this_object()); }

int query_new_mail() {
  int num = 0, i;
  if (!pointerp(mails) || !sizeof(mails))
    return num;
  for (i = 0; i < sizeof(mails); i++)
    if (mails[i]["status"] == "N") num++;
  return num;
}
