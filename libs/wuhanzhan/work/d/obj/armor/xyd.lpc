#include <armor.h>
#include <ansi.h>

inherit SHIELD;


void create()
{
  set_name(HIW "轩辕盾" NOR, ({ "xuanyuan dun","dun","shield" }) );
  set_weight(6000);
  if ( clonep() )
     set_default_object(__FILE__);
  else {
   set("unit", "件");
   set("value", 80000);
   set("material", "brass");
   set("long", HIY "此乃上古轩辕黄帝与蚩尤作战时携带的宝物，连蚩尤的 "HIC" 暗黑邪王枪 "HIY" 也不能攻破。\n" NOR);
   set("armor_prop/armor", 80);
   set("armor_prop/armor_vs_force", 200);
   set("no_sell","怎么能卖？还是自己留着吧。\n");
  }
  setup();
}
