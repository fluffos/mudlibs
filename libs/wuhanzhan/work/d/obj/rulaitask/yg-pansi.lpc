// bula and mon@xyj

inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level) {
  object me = this_object();
  object weapon;
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 10;
  else if (level == 2) guai_value = max_value + max_value / 8;
  else if (level == 3) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set("title", "盘丝洞妖精");
  set("gender", "女性");

  me->set_skill("whip", guai_value + random(15));
  me->set_skill("yinsuo-jinling", guai_value + random(15));
  me->set_skill("sword", guai_value + random(15));
  me->set_skill("tianmo-blade", guai_value + random(15));
  me->set_skill("yuesha-wubu", guai_value + random(15));
  me->set_skill("pansi-dafa", guai_value + random(15));
  me->set_skill("pansishou", guai_value + random(15));
  me->set_skill("evil-force", guai_value + random(15));

  me->map_skill("force", "zixia-force");
  me->map_skill("sword", "zixia-sword");
  me->map_skill("whip", "yinsuo-jinling");
  me->map_skill("parry", "zixia-sword");
  me->map_skill("spells", "pansi-dafa");
  me->map_skill("dodge", "yuesha-wubu");
  me->map_skill("unarmed", "pansishou");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "tusi" :),
    (: cast_spell, "wuzhishan" :),
  }));

  if (random(2))
    weapon = new("/d/obj/weapon/sword/qingfeng");
  else
    weapon = new("/d/obj/weapon/whip/longsuo");
  weapon->move(me);
  carry_object("/d/obj/cloth/luoyi")->wear();
  command("wield all");
}
