
// bula and mon@xyj

inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level)
{
        object me=this_object();
        object weapon;
	int guai_value;
        ::set_skills(max_value, level);

        if (level==1) guai_value = max_value+max_value/10;
        else if (level==2) guai_value = max_value+max_value/8;
        else if (level==3) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;

	set("title","月宫魔女");
	set("gender", "女性");
 
        me->set_skill("whip", guai_value+random(15));
        me->set_skill("jueqingbian", guai_value+random(15));
        me->set_skill("sword",guai_value+random(15));
        me->set_skill("snowsword",guai_value+random(15));
        me->set_skill("moondance", guai_value+random(15));
        me->set_skill("moonshentong", guai_value+random(15));
        me->set_skill("baihua-zhang", guai_value+random(15));
        me->set_skill("moonforce", guai_value+random(15));

        me->map_skill("force", "moonforce");
        me->map_skill("sword", "snowsword");
        me->map_skill("whip","jueqingbian");
        me->map_skill("parry", "jueqingbian");
        me->map_skill("spells", "moonshentong");
        me->map_skill("dodge", "moondance");
        me->map_skill("unarmed", "baihua-zhang");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: cast_spell, "arrow" :),
        }) );

        if (random(2))
           weapon=new("/d/obj/weapon/whip/longsuo");
        else
           weapon=new("/d/obj/weapon/sword/qingfeng");
        weapon->move(me);
        carry_object("/d/obj/cloth/luoyi")->wear();
        command("wield all");
}
