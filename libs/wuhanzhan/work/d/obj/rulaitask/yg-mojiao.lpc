// bula and mon@xyj

inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level) {
  object me = this_object();
  object weapon;
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 10;
  else if (level == 2) guai_value = max_value + max_value / 8;
  else if (level == 3) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set("title", "魔教刀神");

  me->set_skill("blade", guai_value + random(15));
  me->set_skill("tianmo-blade", guai_value + random(15));
  me->set_skill("dimo-steps", guai_value + random(15));
  me->set_skill("tianmo", guai_value + random(15));
  me->set_skill("huolong-zhang", guai_value + random(15));
  me->set_skill("evil-force", guai_value + random(15));

  me->map_skill("force", "evil-force");
  me->map_skill("blade", "tianmo-blade");
  me->map_skill("parry", "tianmo-blade");
  me->map_skill("spells", "tianmo");
  me->map_skill("dodge", "dimo-steps");
  me->map_skill("unarmed", "huolong-zhang");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "lei" :),
  }));

  weapon = new("/d/obj/weapon/blade/jindao.lpc");
  weapon->move(me);
  carry_object("/d/obj/cloth/zhanpao")->wear();
  command("wield all");
}
