
// bula and mon@xyj

inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level)
{
        object me=this_object();
        object weapon;
        int guai_value;
        ::set_skills(max_value, level);

        if (level==1) guai_value = max_value+max_value/10;
        else if (level==2) guai_value = max_value+max_value/8;
        else if (level==3) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;

	set("title","灵台狂道");
 
        me->set_skill("stick", guai_value+random(15));
        me->set_skill("qianjun-bang", guai_value+random(15));
        me->set_skill("jindouyun", guai_value+random(15));
        me->set_skill("wuxiangforce", guai_value+random(15));
        me->set_skill("puti-zhi", guai_value+random(15));
        me->set_skill("dao", guai_value+random(15));

        me->map_skill("force", "wuxiangforce");
        me->map_skill("stick","qianjun-bang");
        me->map_skill("parry", "qianjun-bang");
        me->map_skill("spells", "dao");
        me->map_skill("dodge", "jindouyun");
        me->map_skill("unarmed", "puti-zhi");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"stick", "pili" :),
        (: perform_action,"stick","qiankun" :),
        (: cast_spell, "thunder" :),
        (: cast_spell, "light" :),
        }) );


        weapon=new("/d/obj/weapon/stick/xiangmo");
        weapon->move(me);
        carry_object("/d/obj/cloth/shoupiqun")->wear();
        command("wield all");
}
