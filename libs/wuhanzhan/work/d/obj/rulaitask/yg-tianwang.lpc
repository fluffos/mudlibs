
// bula and mon@xyj

inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level)
{
        object me=this_object();
        object weapon;
        int guai_value;
        ::set_skills(max_value, level);

        if (level==1) guai_value = max_value+max_value/10;
        else if (level==2) guai_value = max_value+max_value/8;
        else if (level==3) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;
                
        set("title","天王府妖仙");
 
        me->set_skill("spear", guai_value+random(15));
        me->set_skill("xiangmo-qiang", guai_value+random(15));
        me->set_skill("feixian-steps", guai_value+random(15));
        me->set_skill("sanqin-dao", guai_value+random(15));
        me->set_skill("fumo-shou", guai_value+random(15));
        me->set_skill("boro-gong", guai_value+random(15));

        me->map_skill("force", "boro-gong");
        me->map_skill("spear","xiangmo-qiang");
        me->map_skill("parry", "xiangmo-qiang");
        me->map_skill("spells", "sanqin-dao");
        me->map_skill("dodge", "feixian-steps");
        me->map_skill("unarmed", "fumo-shou");

        set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: cast_spell, "light" :),
        }) );

        weapon=new("/d/obj/weapon/spear/jinqiang");
        weapon->move(me);
        carry_object("/d/obj/cloth/zhanpao")->wear();
        command("wield all");
}
