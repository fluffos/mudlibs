// bula and mon@xyj

inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.
void set_skills(int max_value, int level) {
  object me = this_object();
  object weapon;
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 10;
  else if (level == 2) guai_value = max_value + max_value / 8;
  else if (level == 3) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set("title", "普陀疯罗汉");

  me->set_skill("staff", guai_value + random(18));
  me->set_skill("lunhui-zhang", guai_value + random(18));
  me->set_skill("lotusmove", guai_value + random(18));
  me->set_skill("buddhism", guai_value + random(18));
  me->set_skill("jienan-zhi", guai_value + random(18));
  me->set_skill("lotusforce", guai_value + random(18));

  me->map_skill("force", "lotusforce");
  me->map_skill("staff", "lunhui-zhang");
  me->map_skill("parry", "lunhui-zhang");
  me->map_skill("spells", "buddhism");
  me->map_skill("dodge", "lotusmove");
  me->map_skill("unarmed", "jienan-zhi");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }));

  weapon = new("/d/obj/weapon/staff/budd_staff");
  weapon->move(me);
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  command("wield all");
}
