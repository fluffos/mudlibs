// bula and mon@xyj

inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level) {
  object me = this_object();
  object weapon;
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 10;
  else if (level == 2) guai_value = max_value + max_value / 8;
  else if (level == 3) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  me->set("title", "碧海魔龙");

  me->set_skill("fork", guai_value + random(15));
  me->set_skill("fengbo-cha", guai_value + random(15));
  me->set_skill("hammer", guai_value + random(15));
  me->set_skill("huntian-hammer", guai_value + random(15));
  me->set_skill("dragonstep", guai_value + random(15));
  me->set_skill("dragonfight", guai_value + random(15));
  me->set_skill("dragonforce", guai_value + random(15));
  me->set_skill("seashentong", guai_value + random(15));

  me->map_skill("force", "dragonforce");
  me->map_skill("fork", "fengbo-cha");
  me->map_skill("hammer", "pangu-hammer");
  me->map_skill("parry", "pangu-hammer");
  me->map_skill("spells", "seashentong");
  me->map_skill("dodge", "dragonstep");
  me->map_skill("unarmed", "dragonfight");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "breathe" :),
  }));

  if (random(2))
    weapon = new("/d/obj/weapon/hammer/jingua");
  else
    weapon = new("/d/obj/weapon/fork/gangcha");
  weapon->move(me);
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  command("wield all");
}
