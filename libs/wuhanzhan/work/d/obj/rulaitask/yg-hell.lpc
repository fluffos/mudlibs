// bula and mon@xyj

inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level) {
  object me = this_object();
  object weapon;
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 10;
  else if (level == 2) guai_value = max_value + max_value / 8;
  else if (level == 3) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  me->set("title", "幽冥练气士");

  me->set_skill("whip", guai_value + random(15));
  me->set_skill("hellfire-whip", guai_value + random(15));
  me->set_skill("stick", guai_value + random(15));
  me->set_skill("kusang-bang", guai_value + random(15));
  me->set_skill("ghost-steps", guai_value + random(15));
  me->set_skill("jinghun-zhang", guai_value + random(15));
  me->set_skill("tonsillit", guai_value + random(15));
  me->set_skill("gouhunshu", guai_value + random(15));

  me->map_skill("force", "tonsillit");
  me->map_skill("whip", "hellfire-whip");
  me->map_skill("stick", "kusang-bang");
  me->map_skill("parry", "kusang-bang");
  me->map_skill("spells", "gouhunshu");
  me->map_skill("dodge", "ghost-steps");
  me->map_skill("unarmed", "jinghun-zhang");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: perform_action, "whip", "biluo" :),
    (: perform_action, "stick", "three" :),
    (: cast_spell, "gouhun" :),
  }));

  if (random(2))
    weapon = new("/d/obj/weapon/whip/longsuo.lpc");
  else
    weapon = new("/d/obj/weapon/stick/xiangmo");
  weapon->move(me);
  carry_object("/d/obj/cloth/zhanpao")->wear();
  command("wield all");
}
