
// bula and mon@xyj

inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level)
{
        object me=this_object();
        object weapon;
        int guai_value;
        ::set_skills(max_value, level);

        if (level==1) guai_value = max_value+max_value/10;
        else if (level==2) guai_value = max_value+max_value/8;
        else if (level==3) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;

        me->set("title","将军府斧霸");
  
        me->set_skill("spear", guai_value+random(15));
        me->set_skill("axe",guai_value+random(15));
        me->set_skill("sanban-axe",guai_value+random(15));
        me->set_skill("yanxing-steps", guai_value+random(15));
        me->set_skill("changquan", guai_value+random(15));
        me->set_skill("lengquan-force", guai_value+random(15));
        me->set_skill("bashishentong", guai_value+random(15));

        me->map_skill("force", "lengquan-force");
        me->map_skill("axe", "sanban-axe");
        me->map_skill("parry", "sanban-axe");
        me->map_skill("spells", "bashishentong");
        me->map_skill("dodge", "yanxing-steps");
        me->map_skill("unarmed", "changquan");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"axe", "sanban" :),
        (: cast_spell, "zhao" :),
        }) );

        weapon=new("/d/obj/weapon/axe/huafu");
        weapon->move(me);
        carry_object("/d/obj/armor/jinjia")->wear();
        command("wield all");
}
