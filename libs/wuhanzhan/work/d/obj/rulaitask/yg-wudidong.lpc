// bula and mon@xyj

inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level) {
  object me = this_object();
  object weapon;
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 10;
  else if (level == 2) guai_value = max_value + max_value / 8;
  else if (level == 3) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  me->set("title", "无底洞魔头");

  me->set_skill("blade", guai_value + random(15));
  me->set_skill("kugu-blade", guai_value + random(15));
  me->set_skill("sword", guai_value + random(15));
  me->set_skill("qixiu-jian", guai_value + random(15));
  me->set_skill("lingfu-steps", guai_value + random(15));
  me->set_skill("yaofa", guai_value + random(15));
  me->set_skill("huntian-qigong", guai_value + random(15));
  me->set_skill("yinfeng-zhua", guai_value + random(15));

  me->map_skill("force", "huntian-qigong");
  me->map_skill("blade", "kugu-blade");
  me->map_skill("sword", "qixiu-jian");
  me->map_skill("parry", "kugu-blade");
  me->map_skill("spells", "yaofa");
  me->map_skill("dodge", "lingfu-steps");
  me->map_skill("unarmed", "yinfeng-zhua");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "tianmo" :),
    (: cast_spell, "suliao" :),
  }));

  if (random(2))
    weapon = new("/d/obj/weapon/sword/qingfeng");
  else
    weapon = new("/d/obj/weapon/blade/jindao");
  weapon->move(me);
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  command("wield all");
}
