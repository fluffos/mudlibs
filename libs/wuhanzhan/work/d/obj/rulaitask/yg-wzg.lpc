// bula and mon@xyj

inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level) {
  object me = this_object();
  object weapon;
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 10;
  else if (level == 2) guai_value = max_value + max_value / 8;
  else if (level == 3) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set("title", "太乙散仙");

  me->set_skill("hammer", guai_value + random(15));
  me->set_skill("kaishan-chui", guai_value + random(15));
  me->set_skill("sword", guai_value + random(15));
  me->set_skill("taiyi-sword", guai_value + random(15));
  me->set_skill("baguazhen", guai_value + random(15));
  me->set_skill("taiyi", guai_value + random(15));
  me->set_skill("wuxing-quan", guai_value + random(15));
  me->set_skill("zhenyuan-force", guai_value + random(15));

  me->map_skill("force", "zhenyuan-force");
  me->map_skill("sword", "taiyi-sword");
  me->map_skill("parry", "taiyi-sword");
  me->map_skill("spells", "taiyi");
  me->map_skill("dodge", "baguazhen");
  me->map_skill("unarmed", "wuxing-quan");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "zhenhuo" :),
  }));

  weapon = new("/d/obj/weapon/sword/qingfeng");
  weapon->move(me);
  carry_object("/d/obj/armor/jinjia")->wear();
  command("wield all");
}
