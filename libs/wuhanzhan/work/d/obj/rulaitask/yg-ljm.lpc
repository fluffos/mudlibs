inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level) {
  object me = this_object();
  object weapon;
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 10;
  else if (level == 2) guai_value = max_value + max_value / 8;
  else if (level == 3) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set("title", "剑魔托世");

  me->set_skill("sword", guai_value + random(15));
  me->set_skill("lingjian-shi", guai_value + random(15));
  me->set_skill("lingjian-step", guai_value + random(15));
  me->set_skill("lingjian-force", guai_value + random(15));
  me->set_skill("lingjianzhi", guai_value + random(15));
  me->set_skill("lingjianjue", guai_value + random(15));

  me->map_skill("force", "lingjian-force");
  me->map_skill("sword", "lingjian-shi");
  me->map_skill("parry", "lingjian-shi");
  me->map_skill("spells", "lingjianjue");
  me->map_skill("dodge", "lingjian-steps");
  me->map_skill("unarmed", "lingjianzhi");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: perform_action, "sword", "jianzhi" :),
    (: cast_spell, "sword" :),
  }));

  weapon = new("/d/obj/weapon/sword/qingfeng");
  weapon->move(me);
  carry_object("/d/obj/cloth/xianyi")->wear();
  command("wield all");
}
