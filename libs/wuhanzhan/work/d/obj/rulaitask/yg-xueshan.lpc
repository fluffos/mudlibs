
// bula and mon@xyj

inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int max_value, int level)
{
        object me=this_object();
        object weapon;
        int guai_value;
        ::set_skills(max_value, level);

        if (level==1) guai_value = max_value+max_value/10;
        else if (level==2) guai_value = max_value+max_value/8;
        else if (level==3) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;
        
        set("title","雪山老妖 ");
        
        me->set_skill("sword", guai_value+random(15));
        me->set_skill("bainiao-jian", guai_value+random(15));
        me->set_skill("xiaoyaoyou", guai_value+random(15));
        me->set_skill("dengxian-dafa", guai_value+random(15));
        me->set_skill("ningxie-force", guai_value+random(15));
        me->set_skill("cuixin-zhang", guai_value+random(15));

        me->map_skill("force", "ningxie-force");
        me->map_skill("sword", "bainiao-jian");
        me->map_skill("parry", "bainiao-jian");
        me->map_skill("spells", "dengxian-dafa");
        me->map_skill("dodge", "xiaoyaoyou");
        me->map_skill("unarmed", "cuixin-zhang");

        set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: cast_spell, "tuntian" :),
        }) );

        weapon=new("/d/obj/weapon/sword/qingfeng");
        weapon->move(me);
        carry_object("/d/obj/cloth/shoupiqun")->wear();
        command("wield all");
}
