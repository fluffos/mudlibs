#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(BLINK""HIB"蓝宝石"NOR, ({"bao shi", "baoshi","shi"}));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("no_sell",1);
                set("unit","颗");
                set("color","b");  //HIB
                set("no_sell",1);
                set("long",HIB"一块发着闪闪蓝光的宝石，传说是女娲补天石的碎块,也不知道什么时候落入凡间的。\n"NOR);
        }
        setup();
}
void init()
{
    add_action("do_enchase", "insert");
}
int do_enchase(string arg)
{
   object in_obj;
   string item;
   string mats;
   int rd,inset_num ;
   object me = this_player();
   object bb = this_object();
   if(!arg) return notify_fail("你要干什么？\n");
   if(sscanf(arg, "%s", item)!=1) return notify_fail("你要把宝石镶嵌到什么上？\n");
   if(!objectp(in_obj = present(item, me))) return notify_fail("你身上没有这样东西。\n");
   if( in_obj->query("equipped") )
      return notify_fail("你必须放下这样东西才能镶嵌宝石。\n");
   if(((int)me->query("potential")- (int)me->query("learned_points")) < 1000) notify_fail("潜能不足!\n");
   mats = in_obj->query("material");       //装备或武器
   inset_num = in_obj->query("inset_num");  // 嵌了几个了
   if(!inset_num) inset_num = 1;
   else inset_num = inset_num + 1;
   if(inset_num > 6) return notify_fail(in_obj->query("name")+"上已经镶嵌了太多的宝石了!\n");
   if((int)in_obj->query("inset/blue") == 1)  
      return notify_fail("你已经镶嵌了一粒蓝宝石了。\n");
   if((int)in_obj->query("inset/done") == 1)  
      return notify_fail("黄金装备也想镶宝石？\n");
   if((inset_num = 6)&&((int)me->query("max_force") > 5000)&&((int)me->query("max_mana") > 5000)&&((int)me->query("combat_exp") > 5000000)) {
   if(!in_obj->query("weapon_prop/damage"))   //防具
{
       object armor;
	int		rev;
	string	armor_dir, ob_file;
	string	*id_list, *t_list;
       string armortype=in_obj->query("armor_type");
       string id=in_obj->query("id");
       string name=in_obj->query("name");
       string long=in_obj->query("long");
       message_vision(CYN"$N把$n"+CYN"镶嵌到"+in_obj->query("name")+CYN"上 \n"NOR,me,bb);
       tell_room(environment(me),HIW"只见"+in_obj->name()+HIW"镶满了宝石，变成了一件黄金装备! \n"NOR);
       me->add("max_force", -1000);
       me->add("max_mana", -1000);
       me->add("combat_exp", -2000000);
        armor = new("/obj/golden");
        if(!armor)
                return 1;
	seteuid(id);
	rev = export_uid(armor);
	seteuid(getuid());
	armor->set("value", 1);
	armor->set("no_give", 1);
	armor->set("no_get", 1);
	armor->set("no_sell", 1);
	armor->set("no_drop", 1);
	armor->set("no_put", 1);
	armor_dir = "/d/obj/";
        armor->set("armor_prop/armor", 125);
        armor->set("armor_prop/armor_vs_force", 400);
        armor->set("armor_prop/armor_vs_spells", 400);
        armor->set("armor_prop/dodge", 20);
        armor->set("armor_prop/spells", 10);
        armor->set("weight", 500);
	switch( armortype )   {
                case "TYPE_ARMOR":
                        ob_file = "/d/obj/armor/tenjia";
			break;
                case "TYPE_BOOTS":
                        ob_file = armor_dir + "cloth/buxue";
			break;
                 case "TYPE_CLOTH":
                        ob_file = armor_dir + "cloth/linen";
                        break;
                case "TYPE_FINGER":
                        ob_file = armor_dir + "cloth/ring";
                        break;
                case "TYPE_HANDS":
                        ob_file = armor_dir + "cloth/gloves";
                        break;
                case "TYPE_HEAD":
                        ob_file = armor_dir + "cloth/hat";
                        break;
                case "TYPE_NECK":
                        ob_file = armor_dir + "cloth/necklace";
                        break;
                case "TYPE_SHIELD":
                        ob_file = armor_dir + "armor/niupi";
                        break;
                case "TYPE_SURCOAT":
                        ob_file = armor_dir + "cloth/surcoat";
                        break;
                case "TYPE_WRISTS":
                        ob_file = armor_dir + "cloth/wrists";
                        break;
                case "TYPE_WAIST":
                        ob_file = armor_dir + "cloth/belt";
                        break;
	}
	armor->set_default_object( ob_file );
	armor->set("long", in_obj->query("long"));
	armor->set("id", in_obj->query("id"));
	armor->set("name", HIY+in_obj->query("name")+NOR);
        id_list = ({ id });
        t_list = explode( id, "_");
	if( sizeof(t_list) > 1 )   {
		id_list += t_list;
	}
        armor->set("owner_id", getuid(me));
	if( !me->query("fabao/armor3") )
                armor->set("series_no", "4");
        else if( !me->query("fabao/armor4") )
                armor->set("series_no", "5");
        else if( !me->query("fabao/armor5") )
                armor->set("series_no", "6");
        else if( !me->query("fabao/armor6") )
                armor->set("series_no", "7");
        else if( !me->query("fabao/armor7") )
                armor->set("series_no", "8");
        else if( !me->query("fabao/armor8") )
                armor->set("series_no", "9");
        else if( !me->query("fabao/armor9") )
                armor->set("series_no", "10");
        else if( !me->query("fabao/armor10") )
                armor->set("series_no", "11");
	armor->set("default_file", ob_file);
        armor->save();	
        if( !me->query("fabao/armor3") )
                me->set("fabao/armor3",  armor->query("series_no"));
        else if( !me->query("fabao/armor4") )
                me->set("fabao/armor4",  armor->query("series_no"));
        else if( !me->query("fabao/armor5") )
                me->set("fabao/armor5",  armor->query("series_no"));
        else if( !me->query("fabao/armor6") )
                me->set("fabao/armor6",  armor->query("series_no"));
        else if( !me->query("fabao/armor7") )
                me->set("fabao/armor7",  armor->query("series_no"));
        else if( !me->query("fabao/armor8") )
                me->set("fabao/armor8",  armor->query("series_no"));
        else if( !me->query("fabao/armor9") )
                me->set("fabao/armor9",  armor->query("series_no"));
        else if( !me->query("fabao/armor10") )
                me->set("fabao/armor10",  armor->query("series_no"));
        else if( !me->query("fabao/armor11") )
                me->set("fabao/armor11",  armor->query("series_no"));
	armor->setup();
	if( !armor->move(me) )
	   armor->move(environment(me));
	me->save();
        message("channel:rumor",HIY+"【谣言】某人："+me->query("name")+"拿到传说中的黄金"HIY+in_obj->query("name")+NOR"了！\n"+NOR,users() );;
       destruct(bb);
       destruct(in_obj);
       return 1;
} else{
       message_vision(CYN"$N把$n"+CYN"镶嵌到"+in_obj->query("name")+CYN"上 \n"NOR,me,bb);
       tell_room(environment(me),HIW"只见"+in_obj->name()+HIW"镶满了宝石，变成了一件黄金装备! \n"NOR);
       in_obj->add("weapon_prop/damage",100);
       me->add("max_force", -1000);
       me->add("combat_exp", -1000000);
       in_obj->set("name",HIY+in_obj->query("name")+NOR);
       in_obj->set("inset/done", 1);
       if(!in_obj->query("old_long")) in_obj->set("old_long",in_obj->query("long"));
       in_obj->set("long",in_obj->query("old_long"));
        message("channel:rumor",HIY+"【谣言】某人："+me->query("name")+"拿到传说中的黄金"HIY+in_obj->query("name")+NOR"了！\n"+NOR,users() );;
       in_obj->save();
       destruct(bb);
       return 1;
}
  return notify_fail("你镶嵌宝石失败了？\n");
}
else {
   if(!in_obj->query("weapon_prop/damage"))   //防具
{
       message_vision(CYN"$N把$n"+CYN"镶嵌到"+in_obj->query("name")+CYN"上 \n"NOR,me,bb);
       tell_room(environment(me),HIB"只见"+bb->name()+HIB"化做一道蓝光,钻入了"+in_obj->query("name")+HIB"里面,不见了! \n"NOR);
       in_obj->add("armor_prop/dodge",10+random(10));
       message_vision(CYN""+in_obj->query("name")+CYN"似乎变得更加轻盈了！\n"NOR,me);
       me->add("potential", -1000);
       in_obj->set_weight(in_obj->query_weight()+500);
       in_obj->set("inset_num",inset_num);
       in_obj->set("no_sell",1);
       in_obj->add("inset_b",inset_num);  //装备b
       in_obj->set("inset/blue",1);
       in_obj->set("name",HIB+in_obj->query("name")+NOR);
       if(!in_obj->query("old_long")) in_obj->set("old_long",in_obj->query("long"));
       in_obj->set("long",in_obj->query("old_long")+"上面嵌上了"HIW+chinese_number(inset_num)+"颗宝石\n"NOR);
       in_obj->save();
       destruct(bb);
       return 1;
}
else{
       message_vision(CYN"$N把$n"+CYN"镶嵌到"+in_obj->query("name")+CYN"上 \n"NOR,me,bb);
       tell_room(environment(me),HIB"只见"+bb->name()+HIB"化做一道蓝光,钻入了"+in_obj->query("name")+HIB"里面,不见了! \n"NOR);
       message_vision(CYN""+in_obj->query("name")+CYN"似乎变得更加灵气活现了！\n"NOR,me);
       in_obj->add("weapon_prop/damage",1 + random(20));
       in_obj->add("weapon_prop/intelligence",1+random(20));
       me->add("potential", -1000);
       in_obj->set_weight(in_obj->query_weight()+500);
       in_obj->set("no_sell",1);       
       in_obj->set("inset_num",inset_num);
       in_obj->add("inset_b",inset_num);  //装备g
       in_obj->set("inset/blue",1);
       in_obj->set("name",HIB+in_obj->query("name")+NOR);
       if(!in_obj->query("old_long")) in_obj->set("old_long",in_obj->query("long"));
       in_obj->set("long",in_obj->query("old_long")+"上面嵌上了"HIW+chinese_number(inset_num)+"颗宝石\n"NOR);
       in_obj->save();
       destruct(bb);
       return 1;
}

  return notify_fail("你镶嵌宝石失败了？\n");
}
}
