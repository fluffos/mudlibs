inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(HIB"〖长拳拳谱〗"NOR, ({"book"}));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
     set("value", 1000);
        set("material", "paper");
        set("skill", ([
                        "name": "changquan",
                        "sen_cost": 20,
                        "difficulty": 20,
        "max_skill": 40,
]) );
        }
}

