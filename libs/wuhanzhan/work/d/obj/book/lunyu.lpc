// poem.c

inherit ITEM;

void init();
int do_read(string arg);

void create()
{
        set_name("〖论语〗", ({"lun yu","book","shu"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
        set("long",
        "论语，记录孔子及其弟子言行的书。\n");
        set("material", "paper");
        set("value", 500);   
        }
}

void init()
{
        add_action("do_read", "read");
}

int do_read(string arg)
{
        object me;
        int sen_cost, gain;
        
        me=this_player();

        if( !this_object()->id(arg) ) return 0;

        if( me->is_busy() )
                        return notify_fail("你现在忙着呢，哪有空闲读书...\n");
        if( me->is_fighting() )
                        return notify_fail("打架时还看书？\n");
        
        if( (int)me->query_skill("literate",1)<200 )
                return notify_fail("你读了半天，却不明白是什么意思，大概你理解能力太差了。\n");
        
        if( (int)me->query_skill("literate",1)>250 )
                return notify_fail("你在文学上的成就已经非常高了，这本书不会让你长进多少。\n");

        sen_cost = 100 + (35-(int)me->query("int"));
        if( (int)me->query("sen")<sen_cost )
                return notify_fail("你现在头晕脑胀，该休息休息了。\n"); 
        me->receive_damage("sen", sen_cost);

        gain = (int)me->query_skill("literate", 1)/10+(int)me->query("int")+1;
        me->improve_skill("literate",gain/2);
                
        message_vision("$N抱着本论语，一边看，一边跟着哼，似乎在学问方面有所进步。 \n", me);
                
        return 1;
}
