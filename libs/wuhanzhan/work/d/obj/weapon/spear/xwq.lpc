#include <weapon.h>
inherit SPEAR;
#include <ansi.h>
inherit F_UNIQUE;

void create() {
  set_name(HIC "暗黑邪王枪" NOR, ({ "darkemperor spear", "spear" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "上古邪帝蚩尤的爱物，附有可怕的暗黑魔力，平日用主人的心血滋养。\n");
    set("value", 0);
    set("material", "golden");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("replace_file", "/d/obj/weapon/spear/changqiang");
    set("wield_msg", HIW "$N狂笑一声，反手从自己的胸口拔出了沾满鲜血的$n " HIW " ！\n" NOR);
    set("unwield_msg", HIW "$N面露痛苦之色，将$n" HIW "转了几转，往自己心口插下直至末柄！\n" NOR);
  }
  init_spear(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("spear", 1) < 450)
    me->improve_skill("spear", random(20));
  switch (random(2)) {
    case 0: return "$w" HIR "带出七缕黑风！\n" NOR;
    case 1: return "$w" HIR "散发出恐怖的邪气！\n" NOR;
  }
}
