#include <weapon.h>
inherit SPEAR;
#include <ansi.h>

void create() {
  set_name(HIW "霸王枪" NOR, ({ "bawang qiang", "spear", "qiang" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "杆");
    set("long", "上古时代的一把神枪，听说是黄帝和蚩尤大战时遗留下的宝物。
。\n");
    set("value", 100000);
    set("no_drop", 1);
    set("no_sell", 1);
    set("material", "wood");
    set("wield_msg", HIB "$N顺手拿起一杆$n。\n" NOR);
    set("unwield_msg", HIW "$N将$n" HIW "放了回去。\n" NOR);
  }
  init_spear(120);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("spear", 1) < 9999)
    me->improve_skill("spear", random(20));
  switch (random(2)) {
    case 0: return "$w" HIW "发出摄人心魄的光芒！\n" NOR;
    case 1: return "$w" HIW "发出摄人心魄的光芒！\n" NOR;
  }
}
