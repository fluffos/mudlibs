//zhenmo-qiang.c

#include <ansi.h>
#include <weapon.h>


inherit SPEAR;
void create()
{
   set_name( HIY "镇魔枪" NOR, ({ "zhenmo qiang", "spear", "qiang" }) );
   set_weight(50000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "根");
     set("value", 0);
     set("material", "gold");
     set("long", HIY "此枪传说是如来佛组赐给托塔天王李靖的，由乌金制成。\n" NOR);
     set("wield_msg", HIW "$N一伸手，把镇魔枪握在手中，顿时精神拌擞！\n" NOR);
     set("unwield_msg", ""HIW"$N把"NOR"$n"HIW"放了下来，不禁长吁了一口气。"NOR"\n");
     set("no_drop", 1);
     set("no_sell", 1);
     set("no_put", 1);
   }
   setup();
 init_spear(200);
}
