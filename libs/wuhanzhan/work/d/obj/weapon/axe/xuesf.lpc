#include <weapon.h>
inherit AXE;
#include <ansi.h>
inherit F_UNIQUE;

void create() {
  set_name(HIR "血杀斧" NOR, ({ "xuesha fu", "fu", "axe" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "这是一对血红色的斧头，血红的斧刃透射出寒光。\n");
    set("value", 50000);
    set("material", "steel");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("replace_file", "/d/obj/weapon/axe/bigaxe");
    set("wield_msg", HIW "$N提起一对$n" HIW "，周围的人都出了一阵冷汗。\n" NOR);
    set("unwield_msg", HIW "$N把$n" HIW "收回背后，长嘘一口气。\n" NOR);
  }
  init_axe(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("axe", 1) < 450)
    switch (random(2)) {
      case 0: return HIW "$N在$w" HIW "中的影子令人震撼！\n" NOR;
      case 1: return "$w" HIW "化出一道寒光……\n" NOR;
    }
}
