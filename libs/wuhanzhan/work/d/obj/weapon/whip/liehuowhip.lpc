// liehuowhip.c
// update by yangwl

#include <weapon.h>
#include <ansi.h>

inherit WHIP;

void create() {
  set_name(HIR "烈火鞭" NOR, ({ "liehuo whip", "whip" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "由地狱中的万年邪火形成的鞭子，据说可以大幅度提高鬼族的实力．\n"); ;
    set("unit", "条");
    set("value", 500);
    set("no_drop", 1);
    set("material", "iorn");
    set("wield_msg", HIW "$N低喝一声，掌心向上虚握，只见四周出现几团鬼火急速往$N手中聚集，竟然凝成了$n" HIW "！\n" NOR);
    set("unwield_msg", HIW "$N手一挥，$n" HIW "复又散成几点鬼火，慢慢消失了。\n" NOR);
  }
  init_whip(120);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int dam;
  dam = me->query_skill("hellfire-whip", 1);
  dam = dam * 2;
  if (dam > 400) dam = 400;
  if ((string)me->query("family/family_name") != "阎罗地府")
    dam = 0;
  me->receive_curing("kee", dam / 4);
  victim->receive_wound("kee", dam);
  me->improve_skill("whip", random(20));
}
