#include <weapon.h>
 :inherit WHIP;
#include <ansi.h>
inherit F_UNIQUE;

void create()
{
   set_name(HIM"搜魂鞭"NOR, ({"souhun whip","whip"}));
   set_weight(150);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "条");
     set("long", "一条暗紫色的软鞭，上面散发出阵阵邪气。\n");
     set("material", "brass");
     set("no_sell", 1);
     set("no_drop", 1);
     set("no_put", 1);
     set("no_steal", 1);
     set("replace_file", "/d/obj/weapon/whip/tielian");
     set("wield_msg", HIW"$N将$n"HIW"自腰间解开，周围众人耳中顿时充斥着阵阵凄号。\n"NOR);
     set("unwield_msg", HIW"$N将$n"HIW"盘回腰上，一切又恢复了正常。\n"NOR);
   }
   init_whip(200);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
       if(me->query_skill("whip",1)<450)
        me->improve_skill("whip",random(20));
                switch(random(2)) {
                        case 0: return "$w"HIC"上凄声大作！\n"NOR;
                        case 1: return "$w"HIC"散发出诡异的妖气……！\n"NOR;
                      }        
}
