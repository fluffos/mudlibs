#include <weapon.h>
 inherit STAFF;
#include <ansi.h>
inherit F_UNIQUE;

void create()
{
  set_name(CYN"轮回杖"NOR, ({"lunhui zhang","zhang"}));
   set_weight(150);
   if (clonep())
     set_default_object(__FILE__);
   else {
 set("unit", "把");
    set("long", "西天大雷音寺镇刹之宝。\n");
     set("value", 500000);
     set("material", "steel");
     set("no_sell",1);
     set("no_put",1);
      set("no_drop",1);
     set("no_steal",1);
     set("no_give",1);
     set("replace_file","/d/obj/weapon/staff/tiezhang");
  set("wield_msg", HIW"$N闭目凝神，反手将$n"HIW"拔出。\n"NOR);
    set("unwield_msg", HIW"$N吸了口气，将$n"HIW"收回背后。\n"NOR);
   }
   init_staff(200);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
       if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
        if(me->query_skill("staff",1)<450)
         me->improve_skill("staff",random(20));
                switch(random(2)) {
       case 0: return "$w"HIB"闪烁着耀眼的白光！\n"NOR;
     case 1: return "$w"HIB"发出阵阵棼唱！\n"NOR;
                      }        
}
