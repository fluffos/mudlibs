#include <weapon.h>
inherit BLADE;
#include <ansi.h>
inherit F_UNIQUE;

void create() {
  set_name(HIB "雪饮狂刀" NOR, ({ "xueyin kuangdao", "dao", "blade" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把寒意四射的宝刀，若是配合傲寒六诀威力会更加惊人。\n");
    set("value", 5000);
    set("material", "steel");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("replace_file", "/d/obj/weapon/blade/jindao");
    set("wield_msg", HIW "一道寒光闪过,$N手中多了把$n。\n" NOR);
    set("unwield_msg", HIW "$N将$n" HIW "收回刀鞘，众人才松了口气。\n" NOR);
  }
  init_blade(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("blade", 1) < 450)
    me->improve_skill("blade", random(20));
  switch (random(2)) {
    case 0: return "$w" HIW "中射出三道寒气！\n" NOR;
    case 1: return "$w" HIW "隐隐发出阵阵寒气！\n" NOR;
  }
}
