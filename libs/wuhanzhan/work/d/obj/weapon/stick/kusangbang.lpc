/* <SecCrypt CPL V3R05> */

// kusangbang.c
// update by yangwl

#include <weapon.h>
#include <ansi.h>

inherit STICK;

void create() {
  set_name(HIC "哭丧棒" NOR, ({ "kusang bang", "bang" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "由十八地狱里的尸气凝聚成的棒子，据说可以大幅度提高鬼族的实力．\n"); ;
    set("unit", "根");
    set("value", 500);
    set("material", "iorn");
    set("wield_msg", HIW "$N满脸诡异，身形滴溜溜一转，只见周围地里冒出缕缕尸气急速往$N手中聚集，竟然凝成了$n" HIW "！\n" NOR);
    set("unwield_msg", HIW "$N对准$n" HIW "一吸，$n" HIW "化为团团尸气，钻进了$N的口中！\n" NOR);
  }
  init_stick(100);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int dam;
  dam = me->query_skill("kusang-bang", 1);
  dam = dam * 3;
  if (dam > 650) dam = 650;
  if ((string)me->query("family/family_name") != "阎罗地府")
    dam = 0;
  victim->receive_wound("sen", dam);
}
