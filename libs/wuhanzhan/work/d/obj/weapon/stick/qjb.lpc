#include <weapon.h>
inherit STICK;
#include <ansi.h>
inherit F_UNIQUE;

void create()
{
   set_name(HIG"千钧棒"NOR, ({"qianjun bang", "stick","bang"}));
   set_weight(150);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "根");
     set("long", "一根集天地之灵气的棍子，为七大神兵之首。\n");
     set("value", 500000);
     set("material", "steel");
     set("no_sell",1);
     set("no_drop",1);
     set("no_put",1);
     set("no_steal",1);
     set("no_give",1);
     set("replace_file","/d/obj/weapon/stick/qimeigun");
     set("wield_msg", HIW"$N拿起一根$n"HIW"顺手舞了个棍花。\n"NOR);
     set("unwield_msg", HIW"$N将$n"HIW"收了回去。\n"NOR);
   }
   init_stick(200);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
       if(me->query_skill("stick",1)<450)
        me->improve_skill("stick",random(20));
                switch(random(2)) {
                        case 0: return "$w"HIW"忽然射出数道金光，荡出阵阵真气！\n"NOR;
                        case 1: return "$w"HIW"发出摄人心魄的光芒！\n"NOR;
                      }        
}
