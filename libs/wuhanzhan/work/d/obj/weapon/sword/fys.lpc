#include <weapon.h>
inherit SWORD;
#include <ansi.h>
inherit F_UNIQUE;

void create() {
  set_name(HIG "飞云剑" NOR, ({ "feiyunsword", "jian", "sword" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄墨绿色的长剑，剑身有一条游龙。\n");
    set("value", 50000);
    set("material", "steel");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("replace_file", "/d/obj/weapon/sword/changjian");
    set("wield_msg", HIG "$N念个“出”字诀，一道绿光闪过，手中多了把$n。\n" NOR);
    set("unwield_msg", HIG "$N念个“收”字诀，绿光过后，$n" HIG "自动回鞘。\n" NOR);
  }
  init_sword(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("sword", 1) < 450)
    me->improve_skill("sword", random(20));
  switch (random(7)) {
    case 0: return "一道" RED "红" NOR "色剑气从$w迸射出来！\n";
    case 1: return "一道" MAG "橙" NOR "色剑气从$w迸射出来！\n";
    case 2: return "一道" YEL "黄" NOR "色剑气从$w迸射出来！\n";
    case 3: return "一道" HIG "绿" NOR "色剑气从$w迸射出来！\n";
    case 4: return "一道" HIW "青" NOR "色剑气从$w迸射出来！\n";
    case 5: return "一道" BLU "蓝" NOR "色剑气从$w迸射出来！\n";
    case 6: return "一道" MAG "紫" NOR "色剑气从$w迸射出来！\n";
  }
}
