#include <weapon.h>
inherit HAMMER;
#include <ansi.h>

void create() {
  set_name(HIW "寒雪锤" NOR, ({ "hanxue hammer", "hammer" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "上古时代的一把神锤，听说是黄帝和蚩尤大战时遗留下的宝物。
。\n");
    set("value", 100000);
    set("material", "steel");
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("is_monitored", 1);
    set("wield_msg", RED "$N拿起一把$n" HIW "在手中掂了掂重量。\n" NOR);
    set("unwield_msg", RED "$N将$n" HIW "放了下来，顿时轻松了许多。\n" NOR);
  }
  init_hammer(120);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("hammer", 1) < 9999)
    me->improve_skill("hammer", random(20));
  switch (random(2)) {
    case 0: return "$w" HIW "飘出一道白雪,一条白龙伴随攻击！\n" NOR;
    case 1: return "$w" HIW "发出摄人心魄的光芒！\n" NOR;
  }
}
