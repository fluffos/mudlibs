#include <weapon.h>
inherit UNARMED;
#include <ansi.h>

void create()
{
   set_name(HIW"战神戒指"NOR, ({"ring"}));
   set_weight(150);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "枚");
               set("value", 100000);
     set("material", "不明物质");
     set("no_drop",1);
     set("no_sell",1);
     set("no_put",1);
     set("wield_msg", HIW"$N戴上一玫$n。\n"NOR);
   }
   init_unarmed(1);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
       if(me->query_skill("sword",1)<9999)
        me->improve_skill("unarmed",random(20));
                switch(random(2)) {
                        case 0: return "$w"HIW"闪闪发光！\n"NOR;
                        case 1: return "$w"HIW"闪闪发光！\n"NOR;
                      }        
}
