// mingsidan.c 冥思丹
// 不希望玩家花钱上网就是重复dazuo,mingsi这样的动作。

#include <ansi.h>
inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIB "冥思丹" NOR, ({ "mingsi dan", "dan" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "太上老君炼制的仙丹，可以激发人的潜力。\n");
    set("value", 15000);
    set("drug_type", "补品");
  }

  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  int mana;

  object me = this_player();

  if (!id(arg)) return notify_fail("你要吃什么？\n");

  message_vision(HIB "$N深深吸了口气，吃下了一枚仙丹！ 浑身被一层白雾笼罩！\n" NOR, me);
  mana = (int)me->query("max_mana");
  me->set("mana", mana * 2);
  me->add("eat/mingsidan", 1);

  destruct(this_object());

  return 1;
}
