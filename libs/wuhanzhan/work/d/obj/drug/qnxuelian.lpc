#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW "千年雪莲" NOR, ({"xue lian","xuelian"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "朵");
                set("long", "一朵雪白的雪莲花，从其上围绕的一层白雾就可看出，
这朵雪莲吸天地之灵气达千年之久，是不可多得的治伤良药。\n");
                set("value", 500000);
                set("drug_type", "补品");
        }
  
        set("is_monitored",1);
        setup();
}

int do_eat(string arg)
{

        object me = this_player();  
        if (!id(arg)) return notify_fail("你要吃什么？\n");
 
        me->set("food", (int)me->max_food_capacity());
        me->set("eff_kee", (int)me->query("max_kee"));
        me->set("kee", (int)me->query("max_kee"));
        me->set("eff_sen", (int)me->query("max_sen"));
        me->set("sen", (int)me->query("max_sen"));

        message_vision(HIW "$N慢慢服下一朵千年雪莲，全身上下无一处不畅快，精神也好多了\n" NOR, me);  

        destruct(this_object());

        return 1;
}
