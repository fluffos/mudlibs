//modify by ken 2001.7.2
#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "这东西不能拿。 \n");
    set("no_drop", "这可是一万两黄金啊，你居然舍得丢？ \n");
    set("no_sell", "掌柜对你说道：对不起，小号财单力薄收不起这么贵重的东西。\n");
    set("no_give", "一万两黄金就这么随便给人？\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIC "判师丹" NOR, ({ "medic dan", "dan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "一粒神奇的丹药。\n");
    set("value", 50000000);
  }

  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  object victim = this_player();
  int abc;

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  abc = (int)victim->query("psd_eat");
  if (abc > 1) {
    message_vision(HIM "$N捏住一枚小小的丹丸往嘴里一塞...........\n" NOR, victim);
    victim->unconcious();
    destruct(this_object());
  } else {
    victim->set("combat_exp", (int)victim->query("combat_exp") * 9 / 10);
    victim->add("psd_eat", 1);
    victim->delete("betray/count");
    victim->delete("betrayer");
    victim->save();
    message_vision(HIM "\n$N吃下了一粒判师丹。\n" NOR, victim);
    destruct(this_object());
    return 1;
  }
}
