#include <ansi.h>

inherit ITEM;
void init();

void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIG "清凉丹" NOR, ({ "qingliang dan", "dan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 10000000);
    set("long", "一颗绿油油的小丸子。\n");
  }
  setup();
}
int do_eat(string arg) {
  int killers;
  object victim = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  killers = (int)victim->query("killers");
  if (killers < 1)
    return notify_fail("还吃个P呀，想死人？\n");
  victim->add("killers", -1);
  victim->save();
  message_vision(RED "\n$N的杀神减少了一点\n\n" NOR, victim);
  destruct(this_object());
  return 1;
}
