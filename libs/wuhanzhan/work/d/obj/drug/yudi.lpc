#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create()
{
        set_name(GRN"天秀箫"NOR, ({"yu xiao", "xiao","sword"}));
        set_weight(1200);
        if ( clonep() )
                set_default_object(__FILE__);
        else 
        {
                set("long", "这是一支五彩美玉制成的"GRN"长箫"NOR"，既可吹出动人的乐曲，\n"
                    "也可作为战斗的武器，可是高秀的随身宝物。\n");
                set("unit", "支");
                set("value", 50000);
                set("no_sell","这支玉笛是宝物，怎么能随便卖呢？\n");
                set("material", "jade");
        }
            init_sword(80);
        set("wield_msg","$N轻轻从怀中取出"+GRN"天秀箫"NOR+"，单手一握，脸上荡漾起些微的笑意。\n");
        set("unwield_msg","$N把"+GRN"天秀箫"NOR+"一收，在手中转了数圈，轻轻巧巧地放回怀里。\n");
        setup();
}

void init ()
{
  add_action("do_chui", "chui");
}

int query_autoload()
{
    if( !this_player() 
      || (this_player()->query("id")!="zzzzz")
      ) return 0;
    return 1;
}

int do_chui(string arg)
{       
     if (!id(arg))
     return notify_fail("你要吹什么？\n");
     if (this_player()->query("id")!="zzzzz")
     return notify_fail("你不要用人家的东西来卖弄了!\n");
     tell_room(environment(this_player()), "\n"+
     BLINK HIC"远处传来萧乐之声,仿佛众仙正在绝情谷尽兴！\n"NOR+
                  BLINK HIW"听的玉皇大帝言道:恭贺吉祥小姐长命百岁,仙福永享！\n"NOR+
     BLINK MAG"听的众神齐言道:恭贺吉祥小姐长命百岁,仙福永享！\n"NOR+
                  BLINK HIM"只见如来佛率西天诸神手捧贺礼,架着祥云而来！\n"NOR+
     BLINK HIC"霎时间,百鸟齐鸣,百花齐放,甚是壮观！\n"NOR);
     return 1;
}     
        
int IsAutoLoad() { return 1; }


