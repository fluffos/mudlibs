// shikongdaobiao.c
// 妖法，碧海神通有土遁，水遁。灭妖很方便，其他门派吃亏很大，所以。。。

#include <ansi.h>

inherit ITEM;

void create() {
  set_name("时空道标", ({ "shikong daobiao", "daobiao", "fu" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("material", "golden");
    set("value", 500000);
    set("no_drop", 1);
    set("no_sell", 1);
    set("long", "一只圆形的道标，有扭转时空的法力。\n");
  }
}

void init() {
  object me = this_object();
  object who = this_player();

  add_action("do_use", "use");

}

int do_use(string arg) {
  object me = this_player();
  object daobiao = this_object();

  if (!id(arg)) return notify_fail("你要用什么道具？\n");
  if (me->is_busy()) return notify_fail("你现在忙着呢，还是等静下心来再用道标吧！\n");
  if (me->is_fighting()) return notify_fail("开什么玩笑，大敌当前还有闲工夫用道具？\n");
  if (environment(me)->query("short") == "赛场"
    || environment(me)->query("short") == "藏经阁二楼"
    || environment(me)->query("short") == "擂台") return notify_fail("不要动坏脑筋了。\n");

  if ((int)me->query("sen") < 500) return notify_fail("你无法集中精神使用道标！\n");
  if ((int)me->query("mana") < 500) return notify_fail("你的法力不足，使用道标会有危险！\n");
  if (daobiao->query("used") > 19) {
    message_vision("时空道标化为一缕轻烟，飘散在空中。\n", me);
    destruct(daobiao);
    return 1;
  }
  message_vision(HIG "\n$N手握时空道标，右手“啪”地一声打了个响指，消失的无影无踪！\n" NOR, me);
  me->add("sen", -300);
  me->add("mana", -300);
  me->move(me->query("startroom"));
  message_vision(HIG "\n眼前时空一阵扭曲，$N从中走了出来！\n" NOR, me);
  daobiao->add("used", 1);
  return 1;
}
