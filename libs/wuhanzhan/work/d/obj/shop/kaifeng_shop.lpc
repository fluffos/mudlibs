inherit SHOP;

void create()
{
        set("short", "七里酒楼");
        set("long", @LONG
酒楼红梁绿瓦，外面挂着一匾大招牌：“七里酒楼”。楼里面摆着大
红木桌子，从里面不时地散发出一阵阵饭菜香酒香。酒楼的西面是大
街。
LONG);
        set("open_long", @LONG
酒楼红梁绿瓦，外面挂着一匾大招牌：“七里酒楼”。楼里面摆着大
红木桌子，从里面不时地散发出一阵阵饭菜香酒香。酒楼的西面是大
街。
LONG);
        set("no_fight", 1);
        set("no_magic", 1);
        set("owner", "VOID_SHOP");
        set("exits", ([
                "west" : "/d/kaifeng/yao5",
        ]));
        set("no_steal", 1);
        set("objects", ([
                __DIR__ "waiter" : 1,
        ]));
        set("no_clean_up", 0);
        set("shop_type", 0);

        setup();
}


