inherit SHOP;

void create() {
  set("short", "二楼雅座");
  set("long", @LONG
这里摆设讲究，用的餐具都是从景德镇运来。摆的桌椅都是红木的，
在光照之下反射出淡淡的的光泽。推窗望去，长安城中心尽收眼底。
一群酒客推杯换盏，正喝的热闹。
LONG);
  set("open_long", @LONG
这里摆设讲究，用的餐具都是从景德镇运来。摆的桌椅都是红木的，
在光照之下反射出淡淡的的光泽。推窗望去，长安城中心尽收眼底。
一群酒客推杯换盏，正喝的热闹。
LONG);
  set("no_time", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("owner", "VOID_SHOP");
  set("exits", ([
    "down": "/d/city/kezhan",
    "up": "/d/city/wdroom",
    "west": "/u/vir/room/mrshi",
    "east": "/d/wiz/system",
