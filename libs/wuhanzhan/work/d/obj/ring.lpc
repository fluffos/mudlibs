#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create() {
  set_name(HIW "水" WHT "晶" HIR "之" MAG "恋" NOR, ({ "zuan jie", "jiezhi", "ring" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 10000000000);
    set("material", "不明物质");
    set("armor_prop/armor", 1);
    set("no_sell", "这么难得的东西还是留着吧。\n");
    set("no_drop", "这么难得的东西还是留着吧。\n");
    set("no_get", "嘿嘿，做梦吧。\n");
  }
  setup();
}
int query_autoload() { return 1; }
