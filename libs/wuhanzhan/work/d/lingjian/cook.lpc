inherit ROOM;

void create()
{
  set ("short", "厨房");
  set ("long", @LONG

  这里是灵剑山的厨房，厨子们正忙个不停，准备丰盛的晚餐。
  如果你饿了，可以先拿点东西吃。
LONG);
set("exits", ([ 
"east": __DIR__"xiaoyuan2",
]));
set("objects",([
 __DIR__"obj/gourou": 1,
 __DIR__"obj/hulu": 1,
]) );
  set("clean_up", 1);
  set("resource", ([ 
  "water" : 1, 
]) );        setup();
       }
int valid_leave()
{
        if((present("gourou", this_player())))
            return notify_fail("吃完狗肉再走吗！\n");
   if((present("qing hulu", this_player())))
       return notify_fail("你不能把葫芦带走！\n");
    return ::valid_leave();
}





