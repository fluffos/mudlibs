#include <ansi.h>
inherit ITEM;

void create()
{
   set_name(HIR "三杀招图谱" NOR, ({"paper", "tu pu", "tu"}));
   set_weight(1000);
   set("unit", "张");
   set("long", "一张画有灵剑门无双绝技的图谱。\n");
   set("material", "paper");

   if( clonep(this_object()) ) {
     set_default_object(__FILE__);
   }
   setup();
}

void init()
{
   add_action("do_read","read");
   add_action("do_lingwu","lingwu");
}

int do_read(string arg)
{
   object me = this_player();
   string msg = 
"三杀分剑指气三杀招，需要极高的内力和天赋方能领悟，
修习此绝招极易走火入魔，修炼者万望小心。
（ｌｉｎｇｗｕ ｓａｎｓｈａ）

三杀招一触即发，先运全身之内力于体外形成一片白烟，
而后于烟雾中跃起发出数道剑气，落地顺势出其不意刺出
一剑，然后乘机点中对方的死穴。对手此时非死即伤，如
此一来，可大获全胜。

此招狠毒异常，吾辈弟子切记不可乱用，行侠道时方可出
手克敌，切切！
\n";
   if(arg=="paper" || arg=="tupu") {
     tell_object(me,msg);
     return 1;
   }
    else return 0;
}

int do_lingwu(string arg)
{
    object me = this_player();
    object ob = this_object();
    
    if (arg != "sansha")
       return notify_fail("你要领悟什么？\n");
    
    if ((string)me->query("family/family_name") != "灵剑门")
       return notify_fail("偷学别派武功？你不怕追杀啊！\n");
       
    if ((int)me->query("combat_exp") < 3000000 ) 
       return notify_fail("以你目前的道行，还是不是冒险为好。\n");
       
    if ((int)me->query_skill("literate",1) < 300)
       return notify_fail("你读书识字太差了，很难领悟这么深奥的招数。\n");

    if ((int)me->query_skill("sword",1) < 300)
       return notify_fail("你基本剑法太差了，很难领悟这么深奥的招数。\n");       
         
    if ((int)me->query_skill("dodge",1) < 300)
       return notify_fail("你轻功太差了，很难领悟这么深奥的招数。\n");
       
    if ((int)me->query("max_force") < 4000
      && random(100) < 30)
     { 
   message_vision("$N拿出一张羊皮纸翻来覆去的看，脸色越来越红，忽然口中喷出点鲜血，一头栽倒在地！\n", me);
   me->unconcious();
   destruct(ob); 
   message_vision("忽然一道黑影闪过，一个黑衣蒙面人从$N身上搜出一张图谱，然后化作一道黑影走了。\n ", me);
     return 0;
     }
     
   message_vision("$N拿出一张羊皮纸仔细翻看，脸色忽然转为火红而后有恢复血色，从嘴角的微笑看出他似乎有所收获。\n$N一不留神，手中的羊皮纸被体内放出的炽热真气烧化了。\n", me);
   me->set("sansha_permit",1);
   me->start_busy(10);
   destruct(ob);
   
     return 1;
} 
       
       
       
       
