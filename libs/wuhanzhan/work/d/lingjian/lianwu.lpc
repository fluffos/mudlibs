inherit ROOM;

void create()
{
  set ("short", "练武场");
  set ("long", @LONG

一个小小的练功场．场内一个中年人在教一些小剑童们武功。周
围兵器架上放着一些兵器。
LONG);
set("exits", ([ 
"southeast": __DIR__"xiaoyuan1",
"north": __DIR__"houyuan",
"east": __DIR__"sleep",
]));
set("objects", ([
                __DIR__"npc/tong2": 3,  
                __DIR__"npc/zhangmen": 1,                    __DIR__"obj/rack":1,
           ]) );
        set("clean_up", 1); 
        setup();
} 
int valid_leave(object me, string dir)
{
        if (dir == "south" ) {
        if (objectp(present("zhang men", environment(me)))) {
        if((string)me->query("family/family_name")=="灵剑门") {
        return ::valid_leave(me, dir);
        }
        return notify_fail("掌门大弟子嚷到：那不是你该去的地方！\n");
        }
        }
        return ::valid_leave(me, dir);
}
void init()
{
  if (!wizardp(this_player()))
  add_action("do_get", "get");
  add_action("do_put", "put");
}
int do_get() {return 1;}
int do_put() {return 1;}



