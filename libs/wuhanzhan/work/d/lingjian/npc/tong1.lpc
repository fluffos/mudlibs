inherit NPC;

void create()
{
        set_name("小剑童 ", ({"tong"}));
        set("gender", "男性" );
        set("age", 13);
        set("long", "一个小剑童，正在轻轻的扫地");
        set("combat_exp", 1000);
   set_skill("sword", 40);
   set_skill("dodge", 40);
        set("attitude", "friendly");
        set("chat_chance_combat", 100 );
        setup();
   carry_object("/d/lingjian/obj/shaoba")->wield();
}

