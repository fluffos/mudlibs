inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
       set_name("唐秋闪", ({"tang qiushan","tang", "master"}));
       set("long", "灵剑门第三代弟子，剑术超群，对剑气更有独到的见解。\n");
       set("title", HIR"狂剑"NOR);
       set("gender", "男性");
       set("age", 30);
        set("class", "sword");
       set("attitude", "friendly");
       set("shen_type", 1);
       set("rank_info/respect", "大侠");
       set("per", 26);
        set("str", 30);
       set("max_kee", 1000);
       set("max_gin", 1000);
       set("max_sen", 1000);
       set("force", 4000);
       set("max_force", 2000);
       set("force_factor", 50);
       set("max_mana", 2000);
       set("mana", 4000);
       set("mana_factor", 50);
       set("combat_exp", 400000);
       set_skill("literate", 50);
       set_skill("unarmed", 120);
       set_skill("dodge", 80);
       set_skill("parry", 80);
        set_skill("sword", 100);
        set_skill("spells", 100);
        set_skill("lingjianjue", 100);
      set_skill("lingjianzhi", 130);
        set_skill("lingjian-force", 100);
        set_skill("force", 100);
        set_skill("lingjian-shi", 100);
        set_skill("lingjian-step", 70);
        map_skill("spells", "lingjianjue");
        map_skill("unarmed", "lingjianzhi");
        map_skill("force", "lingjian-force");
        map_skill("sword", "lingjian-shi");
        map_skill("parry", "lingjian-shi");
      map_skill("dodge", "lingjian-step");
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: cast_spell, "sword" :),
                (: cast_spell, "jianshen" :),

        }) );

create_family("灵剑门", 3, "蓝");
setup();

        carry_object("/d/lingjian/obj/cloth")->wear();
        carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

void attempt_apprentice(object ob)
{       ob=this_player();

        if (ob->query("family/class")) {
        command("say 这位" + RANK_D->query_respect(ob) + "非我派系中的弟子，恐怕收了你却也误导了你！\n");
        command("shake");
        return;
        }
        if ((int)ob->query_int() < 20) {
        command("say 这位" + RANK_D->query_respect(ob) + "悟性太低，恐怕收了你也难以领悟剑道！\n");
        command("sigh");
        return;
        }
        if ((int)ob->query_str() < 20) {
        command("say 这位" + RANK_D->query_respect(ob) + "膂力太低，不适合修炼本门功夫！\n");
        command("sigh");
        return;
        }
        command("smile");
        command("say 好吧，" + RANK_D->query_respect(ob) + "多加努力，光大我灵剑门。");
        command("recruit " + ob->query("id") );
        return;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "sword");
                ob->set("family/class", "qi");
                ob->set("title", "灵剑门狂剑派弟子");
}
