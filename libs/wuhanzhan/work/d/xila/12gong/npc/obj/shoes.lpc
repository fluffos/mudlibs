#include <ansi.h>
#include <armor.h>
inherit BOOTS;
void create()
{
   set_name(YEL "绣花小鞋" NOR, ({ "shoes" }) );
   set_weight(900);
   if( clonep() )
   set_default_object(__FILE__);
   else {
     set("unit", "双");
     set("long", "一双小巧精致的绣花鞋。  \n");
     set("no_sell",1);
     set("no_drop",1);
     set("no_give",1);
     set("no_get",1);
     set("value",10);
     set("no_steal", 1);
     set("material", "steel");
     set("armor_prop/armor",150);
  }
   setup();
}
int query_autoload() { return 1; }

