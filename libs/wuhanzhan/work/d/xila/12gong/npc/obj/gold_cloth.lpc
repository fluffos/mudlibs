#include <armor.h>
#include <ansi.h>
inherit CLOTH;
string *cloth_name = ({
  HIW "白羊宫圣衣" NOR, HIY "金牛座圣衣" NOR, HIR "双子座圣衣" NOR, HIG "巨蟹座圣衣" NOR,
  HIM "狮子座圣衣" NOR, HIC "室女座圣衣" NOR, YEL "天秤座圣衣" NOR, HIB "天蝎座圣衣" NOR,
  MAG "人马座圣衣" NOR, HIM "摩羯座圣衣" NOR, HIC "宝瓶座圣衣" NOR, HIG "双鱼座圣衣" NOR
});
//#include "chk_owner.lpc"

void create() {
  set_name(cloth_name[random(sizeof(cloth_name))], ({ "huangjin shengyi" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_give", 1);
    set("no_get", 1);
    set("value", 10);
    set("no_steal", 1);
    set("material", "steel");
    set("armor_prop/armor", 150);
  }
  setup();
}
int query_autoload() { return 1; }
