
#include <ansi.h>
#include <room.h>

inherit ROOM;

string look_words();

void create()
{
        set("short", "魔法石");
        set("long", @LONG
 这是天上人间的圣魔法石  上面刻了几个小字 (words)。
LONG
        );
        set("item_desc", ([
                "words": (: look_words :),
        ]) );

        set("no_magic",1);
        set("exits", ([ /* sizeof() == 1 */            
           "down" : __DIR__"rukou1",
]));
        setup();
}

string look_words()
{ 
 return "你只要输入(xinwu)通行证，你就可以被直接送到神秘之地。\n";
}

void init()
{
    add_action("do_xinwu","xinwu");
}

int do_xinwu(string arg)
{
        object ob,obj,me;
       
        me=this_player();
        if( arg ) ob = present(arg, environment(this_player()));        else ob=me;
        
        obj = present("passport", me);
        if (obj) {
        ob->add("gin",-10);
        ob->add("sen",-10);
        ob->add("kee",-10);
tell_room("/d/dream/shenmi-room",ob->name()+HIY"出现在一阵黄色的烟雾之中。\n"NOR);
tell_room(environment(ob),ob->name()+HIY"被一阵白色的烟雾包了起来，烟雾散开之后人已消失得无影无踪了。
\n"NOR);
        destruct(obj);
        ob->move("/d/dream/shenmi-room");
        return 1;
       }
       else 
        return notify_fail(HIY"你身上没有天上人间的信物！！\n"NOR); 
}

