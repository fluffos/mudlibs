
inherit NPC;

void create()
{
        set_name("仙鹤", ({ "xianhe","xianhe" }) );
        set("race", "野兽");
        set("age", 20);
        set("long", "
这是一只稀有的丹顶鹤，雪白的羽毛显得很可爱。\n");
set("attitude", "friendly");
        set("str", 50);
        set("cor", 50);

        set("limbs", ({ "头部","颈部", "身体", "脚", "爪子", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

        set("combat_exp", 18000);

        set("chat_chance_combat", 2);
        set("chat_msg_combat", ({
                "仙鹤悲鸣一声！！\n",
                "仙鹤突然冲了过来一啄，差点啄到你的眼睛。\n",
        }) );

        set_temp("apply/attack", 30);
        set_temp("apply/damage", 15);
        set_temp("apply/armor", 5);

        setup();
}


