
#include <ansi.h>

inherit NPC;

#define SET_SKILL       100                     
#define SPE_SKILL       100                     
#define SET_SEN         600                  

void create()
{
        set_name("精灵", ({ "jing ling" }));

        set("long", @LONG
她是天上人间的小精灵,小小年纪就学得了多个门派的绝学。
LONG
        );

        set("rank_info/respect", "小精灵");       
        set("attitude", "friendly");
        set("gender", "女性" );                 
        set("age", 4 + random( 20 ) );        

        set("str", 50);                         // 膂力         
        set("cps", 50);                         // 定力
        set("cor", 40);                         // 胆识         
        set("per", 24);                         // 容貌
        set("con", 50);                         // 根骨

        set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * ( 10 + random( 10 ) ) / 10);
        set("SEN", SET_SEN);

        set("env/wimpy", 30);                   
         set("max_force", 2000);         set("force", 2000);     set("force_factor", 20);
        set("max_mana", 2000);             set("mana", 2000);

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: cast_spell, "huayin" :),
        }) );

        set_skill("force",   SET_SKILL);  set_skill("dream-force",   SPE_SKILL);
        set_skill("sword",   SET_SKILL);  set_skill("cat-sword",      SPE_SKILL);
        set_skill("unarmed", SET_SKILL);  set_skill("dream-zhang",      SPE_SKILL);
        set_skill("parry",   SET_SKILL);
        set_skill("dodge",    SET_SKILL);  set_skill("flydance",   SPE_SKILL);
        set_skill("spells",  SET_SKILL);  set_skill("dream-spells",       SPE_SKILL);
        set_skill("literate",SET_SKILL);

        map_skill("force",      "dream-force");
        map_skill("sword",      "cat-sword");
        map_skill("unarmed",    "dream-zhang");
        map_skill("parry",      "cat-sword");
        map_skill("dodge",      "flydance");
        map_skill("spells",     "dream-spells");

        setup();
        
        carry_object("/d/moon/obj/luoyi")->wear();

        carry_object("/d/obj/weapon/sword/qinghong")->wield();
}


