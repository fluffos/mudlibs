#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "白色阶梯");
  set("long", @LONG

    一条白色的阶梯，不知通向远方的那里,这里大雾笼罩，
后面的回路已经完全消失了，空中隐约传来的阵阵淡淡花香                            
LONG
  );

  set("no_magic", 1);

  set("exits", ([
    "north": __DIR__ "jieti6",
  ]));

  setup();

  replace_program(ROOM);
}
