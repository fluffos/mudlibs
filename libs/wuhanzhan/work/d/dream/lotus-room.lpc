
#include <ansi.h>
#include <room.h>

inherit ROOM;
int ispicked=0;

void create()
{
        set("short", "莲花池");
        set("long", @LONG
你见到池中间有长着一株泛着闪闪光芒的小白花(white lotus)，
这里根本没路通到池中间，普通人根本跳不过上去。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
            "south" : __DIR__"huayuan5",
]));
        set("no_magic",1);
        set("objects", ([

]));
        setup();
}

void init()
{
    add_action("do_pick","pick");
}

int do_pick(string arg)
{
        int time1, t;
        object me,obj,room;

        me=this_player();
        me->start_busy(2);

        if (!arg) return notify_fail(HIY"你想偷摘什么啊？鬼鬼祟祟的！\n"NOR);

        if ((arg != "white lotus")&&(arg!="whitelotus"))  
         return notify_fail(HIY"你这笨蛋认不认得字啊，连摘什么都写错。\n"NOR);

        if(me->is_fighting() ) {
         return notify_fail(HIY"你正在打架，不能去摘莲花。\n"NOR);    
        }

        if ((int)me->query_skill("flydance")<80) 
         return 
notify_fail(HIY"你鼓足气想跳过去摘到那朵小白花，可是每次都掉到了池里。 
\n"NOR);
        
        if (ispicked==1) 
         return notify_fail(HIY"你来迟了，白莲花已经给人摘走了。\n"NOR);
      
        obj=new(__DIR__"obj/lotus");
        obj->move(me);
        ispicked=1;
        message_vision(HIY"$N摘到了一株能医百病的天山白莲。\n"NOR,me);
        return 1;
}        

