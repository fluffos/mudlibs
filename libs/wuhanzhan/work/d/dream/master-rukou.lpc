
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
        set("short", "花园");
        set("long", @LONG
花苑的东面被一片高大的山壁封住了，在墙上有个张着大口的龙头
清澈的泉水不停的从龙头的大口里流出来。石上有一凹陷处的一块
石牌刻着一行笔法苍劲的大字--“天水”，

LONG
        );
        set("exits", ([ /* sizeof() == 1 */
            "west" : __DIR__"huayuan5",
]));
        set("no_magic",1);
        set("restrict_fly_room", 1);
        set("objects", ([
                __DIR__"npc/xianhe" : 2,                
]) );
        setup();
}

void init()
{
        add_action("do_push", "push");
}

void close_passage()
{

        if( !query("exits/in") ) return;
        write("龙头忽然又发出轧轧的声音，泉水又从龙头里流出来，
        封住了小洞口。\n");
        delete("exits/in");
        return;
}

int do_push(string arg)
{
        string dir;

        if( !arg || arg=="" ) return 0;

        if (( arg=="天水" )&&(!query("exits/down")))  {
write("龙头的嘴发出轧轧的声音，从龙嘴里流出的泉水渐渐停了，
露出一个小洞口。\n");
           set("exits/in", __DIR__"master-room.lpc");
           call_out("close_passage", 5);

           return 1;
        }
        else {
         write("你试著推什么？？\n");
         return 0;
        }
}

