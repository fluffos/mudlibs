
#include <ansi.h>

inherit ROOM;

void create()
{
   set("short", HIW "瀑布" NOR);
   set("long", @LONG
    你看了看瀑布，那些从高而下的水(drink)是多么的清脆，是多么的优美，被阳光
一照你看见了七色彩虹，你坐下来静静看了看四面八方真是太美了。
LONG);
   set("exits", ([
      "down" : __DIR__"river",
   ]));
   setup();
}

void init()
{
   add_action("do_drink", "drink");
}

int do_drink(string arg)
{
        object obj;

        if( !arg ) return notify_fail("你要喝什麽？\n");
        if( arg == "water" || arg == "水" ) {
            if( (int)this_player()->query("water") >= (int)this_player()->max_water_capacity() )
                return notify_fail("你已经喝太多了，再也灌不下一滴水了。\n");
            message_vision("$N咕噜噜地喝了几口水。\n", this_player());
            this_player()->add("water", 60);
            if( this_player()->is_fighting() ) this_player()->start_busy(2);
            return 1;
        }
        write("你要拿什麽？\n");
        return 1;
}
