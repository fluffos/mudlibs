
#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "练功室");
        set("long", @LONG

    这里是天上人间的练功室。这里四面画满了各门各派的绝学密式，
是研讨天下武学的好地方。练功室的墙角，挂着一块牌子（sign）。
LONG
        );

        set("item_desc", ([
                "sign": @TEXT
大家一起来讨论武学的秘密吧。

join        加入讨论

chat        自由发言

TEXT
        ]) );

        set("exits", ([
                "south" : __DIR__"xxx",
        ]) );                   

        set("no_magic",1);
        set("no_fight",1);
        setup();
}

void init()
{
        add_action("do_join", "join");
}

int do_join(string arg)
{
        object me, env, *inv;
        int total, i;

        me = this_player();

        if(me->query_temp("talking") == 1) return notify_fail("你已经在讨论当中了！\n");

        env = environment(me);
        inv = all_inventory(env);
        for(i = 0, total = 1 ; i < sizeof(inv); i++) {
                if( inv[i] == me ) continue;
                if( inv[i]->is_corpse() ) continue;
                if( !inv[i]->is_character()) continue;
                total ++;
        }
        if( total <= 1 ) return notify_fail("这里没有人和你讨论！\n");

        message_vision("$N开始加入有关武学秘密的讨论....\n", me);
        me->set_temp("talking", 1);
        call_out( "compelete_join", 60, me );
        return 1;
}

private void compelete_join(object me)
{
        object ob;
        int i, m, n;


        if (!me)          return;
        me->delete_temp("talking");

        if( present(me) ) {                     
                message_vision("$N和大家讨论了很久，收益不小。\n", me);
                m = random( 5 * me->query("int") ) / 30 + 1;
                n = me->query("combat_exp") / 10000;
                if( n > 10 ) n = 10;
                n += random( 10 ) + 1;
                me->add("potential", m);
                me->add("combat_exp", n);
                tell_object(me, sprintf("你的潜能增加了%d点！\n", m));
                tell_object(me, sprintf("你的经验增加了%d点！\n", n));
        }

        return;
}

int valid_leave(object me,string dir)
{
        if ( me->query_temp("talking") ) return notify_fail( "你还没有讨论完呢！\n" );
        return ::valid_leave(me, dir);
}



