inherit ROOM;

string look_table();

void create()
{
        set("short", "密室");
        set("long", @LONG
这是潮湿的密室，里面摆着一张积满了灰尘的桌子(table)。外面山壁上的泉水
不断地透过墙壁渗了进来，连地面也坑坑洼洼。
LONG
        );
        set("no_magic",1);
        set("exits", ([ /* sizeof() == 1 */

]));
       set("item_desc", ([
                "table": (: look_table :),        ]) );

        set("objects", ([
 //               __DIR__"obj/xiaohun-blade" : 1,
]) );
