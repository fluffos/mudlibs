inherit ROOM;
void create() {
  set("short", "峡谷");
  set("long", @LONG
         这里是个陡峭的峡谷,向对面望去是无边无际的南海,突然你发觉一块巨石
      拔地而起,只见巨石上刻了"天上人间"四个大字(zi).传说这里是往仙境的必经
      之地.
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": "/d/penglai/bomingyan",
  ]));
  set("item_desc", ([
    "zi": "只见大字十分特别,好象可以按(press)下去。\n",
  ]));
  setup();
  replace_program(ROOM);
}

void init() {
  add_action("do_press", "press");
}

void do_press(string arg) {
  object ob = this_player();
  tell_object(ob, "你试试按下“海”字，突然传来了一阵阵震耳欲聋的巨响，\n"
    + "你突然看到岩石向两边裂开，形成了一条通向不知何处的通道。\n");
  ob->move(__DIR__ "aroom1");
  tell_room(this_object(),
    ob->name() + "触动了一个机关，突然蓝光闪现，"
    +ob->name() + "消失在一片巨响声之中。\n");
}
