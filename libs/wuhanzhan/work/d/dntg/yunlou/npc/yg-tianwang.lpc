// bula and mon@xyj

inherit __DIR__ "yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("title", "天王府妖仙");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("spear", j + random(15));
  me->set_skill("xiangmo-qiang", j + random(15));
  me->set_skill("axe", j + random(15));
  me->set_skill("dangmo-axe", j + random(15));
  me->set_skill("feixian-steps", j + random(15));
  me->set_skill("sanqin-dao", j + random(15));
  me->set_skill("fumo-shou", j + random(15));
  me->set_skill("boro-gong", j + random(15));

  me->map_skill("force", "boro-gong");
  me->map_skill("axe", "dangmo-axe");
  me->map_skill("spear", "xiangmo-qiang");
  me->map_skill("parry", "xiangmo-qiang");
  me->map_skill("spells", "sanqin-dao");
  me->map_skill("dodge", "feixian-steps");
  me->map_skill("unarmed", "fumo-shou");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "light" :),
  }));

  if (random(2))
    weapon = new("/d/obj/weapon/axe/huafu");
  else
    weapon = new("/d/obj/weapon/spear/changqiang");
  weapon->move(me);
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  command("wield all");
}
