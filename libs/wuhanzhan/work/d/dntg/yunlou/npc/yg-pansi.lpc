inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  me->set("title", "盘丝洞弃徒");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("whip", j);
  me->set_skill("sword", j);

  me->set_skill("yinsuo-jinling", j + random(15));
  me->set_skill("zixia-sword", j + random(15));
  me->set_skill("spells", j + random(15));
  me->set_skill("yuesha-wubu", j + random(15));
  me->set_skill("pansi-dafa", j + random(15));
  me->set_skill("unarmed", j + random(15));
  me->set_skill("pansishou", j + random(15));
  me->set_skill("zixia-force", j + random(15));

  me->map_skill("force", "zixia-force");
  me->map_skill("whip", "yinsuo-jinling");
  me->map_skill("sword", "zixia-sword");
  me->map_skill("parry", "zixia-sword");
  me->map_skill("spells", "pansi-dafa");
  me->map_skill("dodge", "yuesha-wubu");
  me->map_skill("unarmed", "pansishou");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "tusi" :),
    (: cast_spell, "wuzhishan" :),
  }));
  weapon = new("/d/sea/obj/dragonwhip");
  weapon->move(me);
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  command("wield all");
}
