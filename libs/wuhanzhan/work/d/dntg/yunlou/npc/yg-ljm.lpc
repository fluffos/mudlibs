inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title","剑魔托世");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("sword",j+random(15));
        me->set_skill("lingjian-shi",j+random(15));
        me->set_skill("lingjian-step", j+random(15));
        me->set_skill("lingjian-force", j+random(15));
        me->set_skill("lingjianzhi", j+random(15));
        me->set_skill("lingjianjue", j+random(15));

        me->map_skill("force", "lingjian-force");
        me->map_skill("sword", "lingjian-shi");
        me->map_skill("parry", "lingjian-shi");
        me->map_skill("spells", "lingjianjue");
        me->map_skill("dodge", "lingjian-steps");
        me->map_skill("unarmed", "lingjianzhi");

        set("chat_chance_combat", cast_chance(level)*3);
        set("chat_msg_combat", ({
        (: perform_action,"sword","sansha" :),
        (: perform_action,"sword","jianzhi" :),
        (: cast_spell, "sword" :),
        }) );

             weapon=new("/d/obj/weapon/sword/qingfeng");
        weapon->move(me);
        carry_object("/d/obj/cloth/shoupiqun")->wear();
        command("wield all");
}
