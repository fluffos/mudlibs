#include <ansi.h>
inherit NPC;
void create() {
  object ob;

  set_name("魔礼青", ({ "tian wang", "zengzhang tianwang", "qing", "tianwang" }));
  set("gender", "男性");
  set("long",
    "增长天王为四大天王之首, 身高二丈四尺, 善用一杆长枪, \n"
    "枪法登峰造极, 更有密传「青云宝剑」, 「地，水，火，风」\n"
    "四式一出, 大罗金仙也难逃。\n"
  );
  set("age", 50);
  set("title", "增长天王");
  set("attitude", "heroism");
  set("str", 40);
  set("int", 30);
  set("max_kee", 13100);
  set("kee", 13100);

  set("max_sen", 13100);
  set("sen", 13100);
  set("combat_exp", 20000000);
  set("daoxing", 2500000);
  set("force", 12500);
  set("max_force", 11500);
  set("mana", 12500);
  set("max_mana", 11600);
  set("force_factor", 520);
  set("mana_factor", 520);


  set("eff_dx", 3500000);
  set("nkgain", 800);


  set_skill("unarmed", 580);
  set_skill("yingzhaogong", 580);
  set_skill("parry", 580);
  set_skill("dodge", 580);
  set_skill("sword", 580);
  set_skill("ningxie-force", 580);
  set_skill("bainiao-jian", 580);
  set_skill("force", 580);
  set_skill("spells", 580);
  set_skill("moshenbu", 580);
  map_skill("dodge", "moshenbu");
  map_skill("force", "ningxie-force");
  map_skill("parry", "bainiao-jian");
  map_skill("sword", "bainiao-jian");
  map_skill("unarmed", "yingzhaogong");

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "chaofeng" :),
  }));

  setup();

  ob = carry_object("/d/obj/weapon/sword/qingfeng");
  ob->wield();
  ob->set_name("青云宝剑", ({ "sword", "bao jian" }));

  carry_object("/d/obj/armor/jinjia")->wear();
}




void die() {
  object me = this_object();
  message_vision(HIY "$N吓得撒腿就跑。\n" NOR, me);
  destruct(this_object());
  return;
}
