// shan.c
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIM"檀香扇"NOR, ({"tanxiang shan","shan","book"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
        set("long",
"一把香气扑鼻的檀香扇，扇面上密密麻麻写满了一笔娟秀的蝇头小楷。\n");
		set("value", 1000);
        set("no_sell",1);
        set("material", "paper");
        set("skill", ([
                        "name": "makeup",
                        "sen_cost": 20,
                        "difficulty": 30,
                        "max_skill": 140,
]) );
        }
}

