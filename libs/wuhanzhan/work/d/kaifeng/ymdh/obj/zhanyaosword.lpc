// 斩妖剑 zhanyaosword.c
#include <ansi.h>
#include <weapon.h>

inherit SWORD;
void create() {
  set_name(HIG "斩妖剑" NOR, ({ "zhanyao sword", "jian", "sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50000);
    set("material", "gold");
    set("long", "这把剑乃玉皇大帝赐给托塔天王，专斩天下妖魔。\n");
    set("wield_msg", "只听一声长吟，$N手中多了一把$n。$n剑芒伸涨不停，似乎随时要扑向敌人。\n");
    set("unwield_msg", "“铛”的一声，$N将$n插入剑鞘。\n");
    set("weapon_prop/courage", 8);
    set("is_monitored", 1);
  }
  init_sword(90);
  setup();
}
