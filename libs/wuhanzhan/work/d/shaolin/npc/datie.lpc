#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
void clear_room();

void create() {
  set_name("打铁僧", ({ "datie seng", "datie", "seng" }));
  set("title", HIB "少林寺武器库主管" NOR);
  set("long", "这是个身强力壮、皮肤拗黑的打铁僧人。\n");
  set("max_force", 500);
  set("force", 500);
  set("max_mana", 500);
  set("mana", 500);
  set("combat_exp", 500000);
  set_skill("unarmed", 100);
  set_skill("banruo-zhang", 100);
  set_skill("dodge", 100);
  set_skill("shaolin-shenfa", 100);
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "banruo-zhang");
  set("age", 38);
  set("per", 26);
  set("attitude", "friendly");
  set("class", "bonze");
  set("vendor_goods", ([
    "shield": "/d/obj/armor/niupi",
    "sword": "/d/obj/weapon/sword/changjian",
    "blade": "/d/obj/weapon/blade/blade",
    "spear": "/d/obj/weapon/spear/tieqiang",
    "staff": "/d/obj/weapon/staff/chanzhang",
    "hammer": "/d/obj/weapon/hammer/tongchui",
  ]));

  setup();
  // carry_object("/d/obj/cloth/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
