//gunseng.c

inherit NPC;
#include <ansi.h>
void create() {
  set_name("守寺僧兵", ({ "seng bing", "seng", "bing", }));
  set("gender", "男性");
  create_family("少林寺", 10, "弟子");
  set("title", HIG "少林寺" NOR);
  set("age", 28);
  set("long",
    "他是一位身材高大的壮年僧人，两臂粗壮，膀阔腰圆。他手持兵\n"
    "刃，身穿一袭灰布镶边袈裟，似乎有一身武艺。\n"
  );
  set("class", "bonze");
  set("attitude", "heroism");

  set("force", 1700);
  set("max_force", 900);
  set("force_factor", 70);
  set("mana", 1700);
  set("max_mana", 900);
  set("mana_factor", 20);
  set("combat_exp", 1000000);
  set_skill("spells", 60);
  set_skill("whip", 60);
  set_skill("parry", 60);
  set_skill("unarmed", 60);
  set_skill("force", 60);
  set_skill("stick", 60);
  set_skill("sword", 60);
  set_skill("blade", 60);
  set_skill("dodge", 60);

  set_skill("literate", 60);
  set_skill("banruo-zhang", 60);
  set_skill("chanzong", 60);
  set_skill("hunyuan-yiqi", 60);
  set_skill("riyue-bian", 60);
  set_skill("shaolin-shenfa", 60);
  set_skill("damo-jian", 60);
  set_skill("xiuluo-dao", 60);
  set_skill("zui-gun", 60);

  map_skill("spells", "chanzong");
  map_skill("whip", "riyue-bian");
  map_skill("parry", "zui-gun");
  map_skill("unarmed", "banruo-zhang");
  map_skill("force", "hunyuan-yiqi");
  map_skill("stick", "zui-gun");
  map_skill("sword", "damo-jian");
  map_skill("blade", "xiuluo-dao");
  map_skill("dodge", "shaolin-shenfa");

  setup();
  carry_object("/d/shaolin/obj/cloth")->wear();
  carry_object("/d/ourhome/obj/qimeigun")->wield();


}
