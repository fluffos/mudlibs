//gunseng.c

inherit NPC;
#include <ansi.h>
void create()
{

set_name("执法僧兵", ({
                "seng bing",
                "seng",
                "bing",
        }));
        set("gender", "男性" );
        create_family("少林寺", 10, "弟子");
        set("title", HIG"少林寺"NOR );
        set("age", 28);
set("long",
                "他是一位身材高大的中年僧人，两臂粗壮，膀阔腰圆。他手持兵\n"
                "刃，身穿一袭灰布镶边袈裟，似乎有一身武艺。\n"
        );
        set("class", "bonze");
        set("attitude", "aggressive");
        set("force", 1700);
        set("max_force", 900);
        set("force_factor", 70);
        set("mana", 1700);
        set("max_mana", 900);
        set("mana_factor", 20);
        set("combat_exp", 1000000);
       set_skill("spells", 100);
       set_skill("whip", 100);
       set_skill("parry", 100);
       set_skill("unarmed",100);
       set_skill("force", 100);
       set_skill("stick", 100);
       set_skill("sword", 100);
       set_skill("blade", 100);
       set_skill("dodge", 100);
 
       set_skill("literate", 100);
       set_skill("banruo-zhang", 00);
       set_skill("chanzong", 100);
       set_skill("hunyuan-yiqi", 100);
       set_skill("riyue-bian", 100);
       set_skill("shaolin-shenfa", 100);
       set_skill("damo-jian", 100);
       set_skill("xiuluo-dao", 100);
       set_skill("zui-gun", 100);

       map_skill("spells", "chanzong");
       map_skill("whip", "riyue-bian");
       map_skill("parry", "zui-gun");
       map_skill("unarmed", "banruo-zhang");
       map_skill("force", "hunyuan-yiqi");
       map_skill("stick", "zui-gun");
       map_skill("sword", "damo-jian");
       map_skill("blade", "xiuluo-dao");
       map_skill("dodge", "shaolin-shenfa");

        setup();
        carry_object("/d/shaolin/obj/jiedao")->wield();
        carry_object("/d/shaolin/obj/cloth")->wear();


}



