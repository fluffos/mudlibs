//master2.c
//modify by ken
inherit NPC;
inherit F_MASTER;
void create()
{
  set_name("盖世狂魔", ({ "kuang mo", "mo"}));
  set("title", "魔教第七代教主");
  set("gender", "男性");
  set("age", 90);
  set("str", 30);
  set("per", 20);
  set("int", 40);
  set("cor", 90);
  set("cps", 90);
  set("long", "魔教前任总教主，如果你能杀了他，就能得到一把神兵。\n");
  set("combat_exp", 42000000);
  set_skill("literate", 200);
  set_skill("blade", 520);
  set_skill("force", 520);
  set_skill("dodge", 520);
  set_skill("parry", 520);
  set_skill("spells", 500);
  set_skill("unarmed", 550);
  set_skill("huolong-zhang", 580);
  set_skill("demon-steps", 550);
  set_skill("demon-blade", 550);
  set_skill("evil-force", 520);
  set_skill("unarmed", 560);
  set_skill("tigerfight", 520);
  set_skill("tianmo",540);
  map_skill("unarmed", "tigerfight");
  map_skill("force", "evil-force");
  map_skill("spells", "tianmo");
  map_skill("blade", "demon-blade");
  map_skill("parry", "demon-blade");
  map_skill("dodge", "demon-steps");
  set("max_sen", 10000);
  set("max_kee", 10000);
  set("force", 18000);
  set("max_force", 12000);
  set("force_factor", 300);
  set("max_mana",10000);
  set("mana",18000);
  set("mana_factor",300);
  create_family("魔教", 1, "前任教主");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
                (: perform_action, "blade", "tiandirenmo" :),
  }) );

  setup();
  carry_object("/d/mojiao/huomigong/obj/huo")->wield();
  carry_object("/ymdh/obj2/pifeng")->wear();
  carry_object("/u/ken/sd/jia")->wear();
  carry_object("/u/ken/sd/helm")->wear();
  carry_object("/u/ken/sd/neck")->wear();
  carry_object("/u/ken/sd/ring")->wear();
  carry_object("/u/ken/sd/ring")->wear();

}
