//modify by ken
#include <weapon.h>
inherit BLADE;
#include <ansi.h>
inherit F_UNIQUE;

void destroy();


void init() {
  call_out("destroy", 18000);
}
void create() {
  set_name(RED "高惆波砍刀" NOR, ({ "laser blade", "blade", "dao" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这那里叫刀呀，只有个毫不起眼的把手。\n");
    set("value", 50000);
    set("material", "steel");
    set("no_sell", "1");
    set("no_put", "1");
    set("replace_file", "/d/obj/weapon/blade/blade");
    set("wield_msg", HIR "$N拿起$n一挥，顿时一道红光直冲云霄。\n" NOR);
    set("unwield_msg", HIR "红光闪过之后，$n就不见了。\n" NOR);
  }
  init_blade(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  victim->receive_damage("kee", dam / 5);
  victim->start_busy(1);
  switch (random(7)) {
    case 0: return HIR "$w一下就砸到了$n的脑袋，结果一下命中，疼痛超越了$n忍耐的极限，$n因此倒在地上痛苦的哀嚎。\n" NOR;
    case 1: return HIW "$w轻轻的碰了$n的胯下一下，在这重重的一击下$n倒在了地上，啊，那一定很痛。\n" NOR;
    case 2: return HIB "$w的刀锋扫过了$n的左臂，一下把$n的左臂打断了，只剩下一些皮肉连着断骨。\n" NOR;
    case 3: return HIC "$w敲了敲$n的右臂，这一下把$n的右肘打碎了，把$n的左手打成了残疾。\n" NOR;
    case 4: return HIR "$N顺势拿起$w戳向$n的眼睛，看来这对$n的打击太大了，因为$n的眼睛不见了。\n" NOR;
    case 5: return RED "$N举起$w砸向$n的左腿，很容易就把$n的左腿打跛了，因此$n抱着他的脚不停的惨嚎。\n" NOR;
    case 6: return RED "$N拿起$w剁向$n的右脚，一阵焦臭过后$n很惊奇的发现他拥有的一条腿跟他说了再见。\n" NOR;
  }
}
void destroy() {
  message_vision(
    "只听一道红光闪，" + (string)this_object()->query("name") + "不见了。\n",
    environment(this_object())
  );
  destruct(this_object());
}
