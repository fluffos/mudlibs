#include <weapon.h>
inherit FORK;
#include <ansi.h>
inherit F_UNIQUE;

void create() {
  set_name(HIC "碧波荡漾" NOR, ({ "bibo dangyang", "fork", "cha" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一东海水晶凝结成的一柄神叉。\n");
    set("value", 500000);
    set("material", "steel");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("replace_file", "/d/obj/weapon/fork/fork");
    set("wield_msg", HIB "$N双手虚画，两道水光流向双手,$n" HIB "已然握在$N的手中。\n" NOR);
    set("unwield_msg", HIB "$N双手一甩，$n" HIB "如同水滴般散落不见了。\n" NOR);
  }
  init_fork(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("fork", 1) < 450)
    me->improve_skill("fork", random(20));
  switch (random(2)) {
    case 0: return "$w" HIB "发出阵阵水响。\n" NOR;
    case 1: return "$w" HIB "上波光一闪，又一闪……！\n" NOR;
  }
}
