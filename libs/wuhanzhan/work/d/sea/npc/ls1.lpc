#include <skill.h>

inherit NPC;
inherit F_MASTER;
void create()
{
          set_name("敖天", ({"ao tian", "ao","tian","longshen","shen"}));

          set("long","敖天是四海的龙王，掌管东，西，南，北四海。
是四海龙王的父亲，总镇五湖四海，当年连玉帝也得让他三分。\n");
          set("gender", "男性");
          set("age", 66);
          set("title", "四海龙神");
          set("class","dragon");
          set("attitude", "peaceful");
          set("shen_type", 1);
          set("rank_info/respect", "陛下");
          set("per", 20);
          set("str", 30);
          set("max_kee", 4000);
          set("kee", 4000);
          set("max_sen", 5500);
          set("sen", 5500);
          set("max_force", 4000);
          set("force", 4000);
          set("max_mana", 5000);
          set("mana", 10000);
          set("force_factor", 220);
          set("mana_factor", 500);
          set_skill("unarmed", 500);
          set_skill("dragonforce", 500);
          set_skill("seashentong", 500);
          set_skill("spells", 500);
          set_skill("hammer", 500);
          set_skill("dodge", 500);
          set_skill("fork", 500);
          set_skill("parry", 500);
          set_skill("dragonstep", 500);
          set_skill("pangu-hammer", 500);
          set_skill("literate", 240);
          set_skill("force", 500);
          set_skill("fengbo-cha", 250);
          set_skill("dragonfight", 500);
          map_skill("spells", "seashentong");
          map_skill("unarmed", "dragonfight");
          map_skill("force", "dragonforce");
          map_skill("fork", "fengbo-cha");
          map_skill("parry", "fengbo-cha");
          map_skill("hammer", "pangu-hammer");
          map_skill("dodge", "dragonstep");

          create_family("东海龙宫", 1, "水族");
          set_temp("apply/armor",50);
          set_temp("apply/damage",25);
          set("chat_chance_combat", 60);
          set("chat_msg_combat", ({
             (: cast_spell, "freeze" :),
             (: cast_spell, "breathe" :),
              }) );
          setup();
          
          carry_object("/d/obj/weapon/fork/fork")->wield();
          carry_object("/d/obj/weapon/hammer/plkl");
}

void attempt_apprentice(object ob)
{      
      ob=this_player();
     
      if( (string)ob->query("family/family_name")=="东海龙宫") {
      if (((int)ob->query("combat_exp") < 2000000)) {
      command("say " + RANK_D->query_respect(ob) +
      "还是先到小儿或小女处把基础打好了再来我这儿吧。\n");
      return;
   }   
      if( (int)ob->query_skill("dragonforce", 1) < 181 ) {
      command("say 你还是先去小儿那里再练练吧。\n");
      command("sigh");
      return;
   }

       command("smile");
       command("say 难得" + RANK_D->query_respect(ob) +
       "有此心志，还望日后多加努力，为我东海龙宫争光。\n");
       command("recruit " + ob->query("id") );
       return;
}
}

int recruit_apprentice(object ob)
{
      if( ::recruit_apprentice(ob) )
              ob->set("class", "dragon");
              ob->set("title", "东海龙宫护法龙王");
}

void init()
{
     object me;
   
     ::init();
    add_action("do_exercise",({"bian"}));
     if( interactive(me = this_player()) && !is_fighting() ) {
     call_out("greeting", 0, me);
}
}

void greeting(object me)
{
      int mykar=me->query_kar();
      if( random(mykar) > 100) return;
      else
 {
      me->delete_temp("spellslevel");
      me->delete_temp("d_mana");
      me->delete_temp("apply/name");
      me->delete_temp("apply/id");
      me->delete_temp("apply/short");
      me->delete_temp("apply/long"); 
      return;
    }
}

int do_exercise(string arg)
{
    write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
    return 1;
}

