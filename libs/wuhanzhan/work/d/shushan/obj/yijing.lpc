inherit ITEM;
void create() {
  set_name("易经", ({ "shu", "book" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一册易经。\n");
    set("value", 500);
    set("material", "paper");
    set("skill", ([
      "name": "taoism",
      "exp_required": 10000,
      "sen_cost": 20,
      "difficulty": 35,
      "max_skill": 80
    ]));
  }
}
