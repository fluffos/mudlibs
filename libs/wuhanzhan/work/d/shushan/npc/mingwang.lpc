inherit NPC;

void create()
{
        set_name("镇狱明王", ({ "zhenyu mingwang", "wang" }));
        set("title", "");
        set("age", 10000);
        set("attitude", "aggressive");
        set("str", 40);
        set("max_kee", 9000);
        set("max_sen", 5000);
        set("force", 10000);
        set("max_force", 6000);
        set("force_factor", 300);
        set("mana", 6000);
        set("max_mana", 4000);
        set("mana_factor", 200);
        set("combat_exp", 6750000);
        set_skill("spells",350);
        set_skill("force", 350);
        set_skill("dodge", 350);
        set_skill("parry", 350);
        set_skill("unarmed", 350);
        set_skill("shushan-force", 350);
        set_skill("zuixian-steps", 150);
        set_skill("dao",350);
        set_skill("jienan-zhi",350);
        map_skill("spells", "dao");
        map_skill("unarmed", "jienan-zhi");
        map_skill("dodge", "zuixian-steps");
        map_skill("force", "shushan-force");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "light" :),
                (: cast_spell, "thunder" :),
        }) );
   add_temp("apply/damage", 120);
        setup();
        carry_object("/d/obj/cloth/linen")->wear();
}

void die()
{
        if( environment() ) {
        message("sound", "\n镇狱明王道：“我没办法了...”\n", environment());
        }
        destruct(this_object());
}
