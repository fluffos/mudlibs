#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string expell_me(object me);
void create()

{
       set_name("剑圣", ({ "jian sheng", "sheng", "swordsman" }));
        set("long", 
"蜀山剑派祖师爷，满头白发的老人，两眼炯炯有神。\n");
        set("gender", "男性");
        set("age", 69);
        set("attitude", "peaceful");
        set("str", 30);
        set("int", 40);
        set("per", 40);
        set("con", 40);

        set("class","swordsman");
        set("max_kee", 20000);
        set("max_sen", 8000);
        set("force", 10000);
        set("max_force", 10000);
        set("force_factor", 300);
        set("mana", 16000);
        set("max_mana", 8000);
        set("mana_factor", 400);
        set("combat_exp", 10000000);
        set_skill("force", 300);
        set_skill("spells", 280);
        set_skill("sword", 320);
        set_skill("dodge", 280);
        set_skill("unarmed", 270);
        set_skill("yujianshu", 300);
        set_skill("fumozhang", 250);
        set_skill("literate", 250);
        set_skill("parry", 280);
        set_skill("taoism", 280);
        set_skill("zuixian-steps", 250);
        set_skill("shushan-force", 300);
        set_skill("shushan-jianfa", 300);
        set_skill("mindsword", 520);

        map_skill("force", "shushan-force");
        map_skill("dodge", "zuixian-steps");
        map_skill("spells", "taoism");
        map_skill("unarmed", "fumozhang");
        map_skill("sword", "mindsword");
        map_skill("parry", "mindsword");
        create_family("蜀山剑派", 4, "掌门人");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "sword","huixin" :),
                (: perform_action, "sword","xu" :),
        }) );
   add_temp("apply/damage", 150);
   add_temp("apply/attack", 150);
   add_temp("apply/armor", 150);
   add_temp("apply/armor_vs_force", 250);
   add_temp("apply/armor_vs_spells", 250);
   add_temp("apply/dodge", 250);
   add_temp("apply/spells", 50);
  set("inquiry", ([
        "leave": (: expell_me :),
        ]) );
        setup();
        carry_object("/d/obj/cloth/daopao")->wear();
        carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}
void attempt_apprentice(object ob)
{
	if (ob->query_skill("taoism",1) < 181) {
        command("say 我蜀山剑派，最注重剑术的修行，依我看" + RANK_D->query_respect(ob) + "是不是该多下下苦功呢？");
                return ;
        }
        if ( ob->query("combat_exp") < 2000000) {
                command("say " + RANK_D->query_respect(ob) + "的道行是不是低的点？");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("recruit " + ob->query("id"));
        ob->set("class", "swordsman");
        ob->set("title","剑圣传人");
}
string expell_me(object me)
{
  me=this_player();
  if((string)me->query("family/family_name")=="蜀山剑派")
    {
      me->set_temp("betray", 1);
      command("sigh");
      return ("按我蜀山门规，却须受罚，你可愿意(agree)？");
    }
  return ("我不知道！");
}
void init()
{
  add_action("do_agree", "agree");
}
int do_agree(string arg)
{
  if(this_player()->query_temp("betray"))
    {
      message_vision("$N答道：弟子愿意。\n\n", this_player());
      command("say 那你便去吧。。。或者这是天意！");
      this_player()->add("betray/count", 1);
     this_player()->set("combat_exp", this_player()->query("combat_exp")*80/100);
      this_player()->add("betray/shushan", 1);
      this_player()->delete_skill("taoism");
      this_player()->delete_skill("yujianshu");
      this_player()->delete_skill("shushan-jianfa");
      this_player()->delete_skill("mindsword");
      message_vision("剑圣在$N的头上怕了一下，$N顿时觉得若有所失。\n\n", this_player());
      this_player()->delete("family");
      this_player()->set("title", "普通百姓");
      this_player()->save();
      return 1;
    }
  return 0;
}
