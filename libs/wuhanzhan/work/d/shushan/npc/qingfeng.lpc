inherit NPC;
void create()

{
        set_name("清风", ({ "qing feng", "feng" }));
        set("long", 
"清风是蜀山剑派年轻一代的大弟子。\n");
        set("gender", "男性");
        set("age", 29);
        set("attitude", "peaceful");
        set("class","swordsman");
        set("max_kee", 1500);
        set("max_sen", 1500);
        set("force", 3000);
        set("max_force", 1500);
        set("force_factor", 60);
        set("mana", 3000);
        set("max_mana", 1500);
        set("mana_factor", 60);
        set("combat_exp", 500000);
        set_skill("force", 100);
        set_skill("spells", 100);
        set_skill("sword", 100);
        set_skill("dodge", 100);
        set_skill("unarmed", 100);
        set_skill("yujianshu", 100);
        set_skill("fumozhang", 100);
        set_skill("literate", 100);
        set_skill("parry", 100);
        set_skill("taoism", 100);
        set_skill("zuixian-steps", 100);
        set_skill("shushan-force", 100);

        map_skill("force", "shushan-force");
        map_skill("dodge", "zuixian-steps");
        map_skill("spells", "taoism");
        map_skill("unarmed", "fumozhang");
        map_skill("sword", "yujianshu");
        map_skill("parry", "yujianshu");
        create_family("蜀山剑派", 6, "弟子");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "jianshen" :),
                (: exert_function, "powerup" :),
        }) );
        setup();
        carry_object("/d/obj/cloth/daopao")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();
}
void attempt_apprentice(object ob)
{
        if ((int)ob->query_cor() < 20) {
                command("say 做剑客需要相当的胆量，依我看" + RANK_D->query_respect(ob) + "的资质似乎不合？");
                return;
        }
        command("say 好吧，我就收下你了。");
        command("recruit " + ob->query("id"));
        if((string)ob->query("class") != "swordsman")
                ob->set("class", "swordsman");
}
