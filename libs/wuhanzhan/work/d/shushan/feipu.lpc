inherit ROOM;
#include <ansi.h>
void create() {
  set("short", CYN "飞瀑" NOR);
  set("long", @LONG
在你面前是飞流直下三千尺的瀑布，见到这么长的瀑布，
你不由想去试试挥剑断水！
LONG);
  set("exits", ([
    "westdown": __DIR__ "houshan",
  ]));
  setup();
}
void init() {
  add_action("do_lingwu", "lingwu");
  add_action("do_huijian", "huijian");
}
int do_huijian(string arg) {
  object room, ob;
  object me = this_player();
  if (me->query("family/family_name") != "蜀山剑派") {
    tell_object(me, "你感觉到力不从心。\n");
    return 1;
  }
  if (me->query("kee") < 50) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }
  if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能挥剑断水。\n");
  message_vision("$N挥剑去断水，结果弄得个“挥剑断水水更流，全身湿透汗也流”。\n", me);
  me->add("kee", -30);
  if (me->query_skill("shushan-jianfa", 1) < 400) {
    tell_object(me, "你似乎领悟不到什么。\n");
    return 1;
  }
  if ((int)me->query_skill("shushan-jianfa", 1) > 399) {
    tell_object(me, HIW "你似乎对挥剑断水有所领悟！\n" NOR);
    if (!me->query("shushan/mindsword")) {
      me->add("shushan/duanshui", 1);
      if (me->query("shushan/duanshui", 1) > 99999) {
        me->set("shushan/mindsword", 1);
        tell_object(me, HIY "你在不知不觉间悟到了「断水无痕」的要领。\n" NOR);
        me->set_skill("mindsword", 1);
      }
    }
  } else tell_object(me, HIY "也许你的蜀山剑法修为不够，你无法悟到什么。\n" NOR);
  return 1;
}
int do_lingwu(string arg) {
  object room, ob;
  object me = this_player();
  int sk = me->query_skill("mindsword", 1);
  if (me->query("shushan/mindsword") < 1) {
    tell_object(me, "你似乎领悟不到什么。\n");
    return 1;
  }
  if (me->query("family/family_name") != "蜀山剑派") {
    tell_object(me, "你领悟不到什么。\n");
    return 1;
  }
  if (me->query("kee") < 100) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }
  if (me->query_skill("taoism", 1) < sk / 2) {
    tell_object(me, "你的天师仙法等级不够。\n");
    return 1;
  }
  if (me->query_skill("shushan-force", 1) < sk / 2) {
    tell_object(me, "你的蜀山心法等级不够。\n"); return 1;
  }
  if (me->query_skill("dodge", 1) < sk) {
    tell_object(me, "你的基本轻功不够。\n");
    return 1;
  }
  if (me->query_skill("shushan-jianfa", 1) < sk) {
    tell_object(me, "你的蜀山剑法等级不够。\n");
    return 1;
  }
  if (me->query_skill("force", 1) < sk) {
    tell_object(me, "你的基本内功不够。\n");
    return 1;
  }
  if (me->query_skill("sword", 1) < sk) {
    tell_object(me, "你的基本剑法不够。\n");
    return 1;
  }
  if (me->query("combat_exp") < (sk * sk * sk / 10)) {
    tell_object(me, "你的道行不够。\n");
    return 1;
  }
  if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你要拿着剑才能领悟到心剑的奥秘。\n");
  message_vision("$N似乎对心剑有了新的领悟。\n", me);
  me->add("kee", -100);
  tell_object(me, HIW "你感觉到你的心剑在不断进步！\n" NOR);
  me->improve_skill("mindsword", me->query_int() * 10 + 1, 0);
  return 1;
}
