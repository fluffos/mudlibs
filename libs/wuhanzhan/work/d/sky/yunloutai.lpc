#include <room.h>
inherit ROOM;


int valid_leave();

void create ()
{
  set ("short", "云楼台");
  set ("long", @LONG

此乃宫上一小台，远望仙境，见金光万道滚红霞，瑞气千条喷紫
烟。远上长桥碧雾蒙，天宫宝殿映云光。当真是天上自来有仙境，
不堕人间点污泥。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__"yunlou",
  ]));
  set("objects", ([ /* sizeof() == 3 */
  "/d/dntg/yunlou/npc/litianwang" : 1,
]));

        set("no_fight", "1");
           set("no_remove", "1");
           set("no_wear", "1");
        set("no_magic", "1");
        set("outdoors", 1);
  setup();
}


void init ()
{
    add_action("do_exercise",({"bian"}));
    add_action("do_accept",({"accept"}));
    add_action("do_robot",({"remove","wear"}));
}

int do_exercise(string arg)
{
  write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
  return 1;
}

int do_accept(string arg)
{
  write("你还是到别的地方去接受邀请吧。\n");
  return 1;
}

int do_robot(string arg)
{
  write("你不能在这里做这个动作。\n");
  return 1;
}
