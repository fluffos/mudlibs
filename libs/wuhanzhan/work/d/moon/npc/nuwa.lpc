#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
       set_name(HIR"女娲娘娘"NOR, ({"nu wa", "nu", "wa","master"}));
       set("title", HIW"月宫太上祖师"NOR);
       set("gender", "女性");
       set("age", 24);
       set("class","xian");
       set("attitude", "friendly");
       set("rank_info/respect", "娘娘");
       set("cor", 30);
       set("per", 40);
       set("long", "补天救难，月宫之祖\n");
       set("max_kee", 5500);
       set("max_gin", 5500);
       set("max_sen", 5500);
       set("force", 8000);
       set("max_force", 4000);
       set("force_factor", 225);
       set("max_mana", 5500);
       set("mana", 11000);
       set("mana_factor", 550);
       set("combat_exp", 8000000);
       set_skill("literate", 250);
       set_skill("unarmed", 250);
       set_skill("dodge", 300);
       set_skill("force", 280);
       set_skill("parry", 270);
       set_skill("sword", 320);
       set_skill("spells", 300);
   set_skill("moonshentong", 280);
   set_skill("baihua-zhang", 280);
   set_skill("moonforce", 300);
   set_skill("snowsword", 300);
   set_skill("moondance", 340);
   set_skill("spring-blade", 250);
   set_skill("whip", 300);
   set_skill("jueqingbian", 300);
   set_skill("blade", 280);
   map_skill("spells", "moonshentong");
   map_skill("unarmed", "baihua-zhang");
   map_skill("force", "moonforce");
   map_skill("whip", "jueqingbian");
   map_skill("sword", "snowsword");
   map_skill("parry", "snowsword");
   map_skill("dodge", "moondance");
   map_skill("blade", "spring-blade");
   set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "arrow" :),
        }) );
create_family("月宫", 1, "红");
setup();

        carry_object("/d/obj/cloth/tianyi.lpc")->wear();
//       carry_object("/d/ourhome/obj/shoes")->wear();
        carry_object("/d/obj/weapon/sword/qinghong")->wield();
        carry_object("/d/obj/weapon/sword/fys");
}

void attempt_apprentice(object ob)
{
   if ( !((string)ob->query("gender")=="女性")){
      command("shake");
          command("say 我们月宫只收女徒，这位" + RANK_D->query_respect(ob) + "还是另请高就吧。\n");
      return;
   }
   if ( (string)ob->query("family/family_name")=="月宫") {
   if (((int)ob->query("combat_exp") < 1000000 )) {
      command("hmm");
   command("say " + RANK_D->query_respect(ob) +
"的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
    if( (int)ob->query_skill("moonforce", 1) < 181 ) {
      command("say 你还是先去其它姊妹那里再练练吧。\n");
      command("sigh");
      return;
   }
        command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
"多加努力，把我们月宫发扬光大。\n");
       command("recruit " + ob->query("id") );
   return;
   }
   command("hmm");
   command("say " + RANK_D->query_respect(ob) +
"还是先去学些基础功夫吧。\n");
        return;
}
int accept_fight(object me)
{
   return 0;
}

void init()
{
     object me;
   
     ::init();
    add_action("do_exercise",({"bian"}));
     if( interactive(me = this_player()) && !is_fighting() ) {
     call_out("greeting", 0, me);
}
}

void greeting(object me)
{
      int mykar=me->query_kar();
      if( random(mykar) > 100) return;
      else
 {
      me->delete_temp("spellslevel");
      me->delete_temp("d_mana");
      me->delete_temp("apply/name");
      me->delete_temp("apply/id");
      me->delete_temp("apply/short");
      me->delete_temp("apply/long"); 
      return;
    }
}
int do_exercise(string arg)
{
    write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
    return 1;
}
