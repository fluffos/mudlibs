inherit NPC;
inherit F_MASTER;

#include <ansi.h>
void create() {
  set_name("孙悟空", ({ "sun wukong", "wukong", "master" }));
  set("long", "灵台第一英雄．佛祖赐封：＂斗战胜佛＂\n");
  set("title", "齐  天  大  圣");
  set("gender", "男性");
  set("age", 34);
  set("class", "taoist");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("rank_info/respect", "大圣爷爷");
  set("per", 16);
  set("looking", "原来是一个身不足五尺，瘦瘦干干，满身黄毛的猢狲。");
  set("int", 40);
  set("str", 300);
  set("max_kee", 8000);
  set("combat_exp", 8000000);
  set("max_sen", 8000);
  set("max_force", 8000);
  set("force", 16000);
  set("force_factor", 550);
  set("max_mana", 8000);
  set("mana", 16000);
  set("mana_factor", 555);
  set_skill("literate", 100);
  set_skill("unarmed", 280);
  set_skill("dodge", 320);
  set_skill("parry", 270);
  set_skill("stick", 300);
  set_skill("spells", 300);
  set_skill("dao", 320);
  set_skill("puti-zhi", 250);
  set_skill("wuxiangforce", 300);
  set_skill("force", 300);
  set_skill("qianjun-bang", 320);
  set_skill("jindouyun", 280);
  map_skill("unarmed", "puti-zhi");
  map_skill("spells", "dao");
  map_skill("force", "wuxiangforce");
  map_skill("stick", "qianjun-bang");
  map_skill("parry", "qianjun-bang");
  map_skill("dodge", "jindouyun");
  set_temp("apply/attack", 400);
  set_temp("apply/defense", 400);
  set_temp("apply/armor", 350);
  set_temp("apply/damage", 350);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "light" :),
    (: cast_spell, "fenshen" :),
    (: cast_spell, "thunder" :)
  }));

  create_family("方寸山三星洞", 1, "蓝");
  setup();
  carry_object("/d/obj/cloth/baizhanpifeng")->wear();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/stick/mobang")->wield();
  carry_object("/d/obj/weapon/stick/qjb");
}

void attempt_apprentice(object ob) {
  ob = this_player();
  if ((string)ob->query("family/family_name") == "方寸山三星洞") {
    if ((int)ob->query("combat_exp") < 2000000) {
      command("say 不行，" + RANK_D->query_respect(ob) + "修行还不够，怎么讲你也听不懂。\n");
      return;
    }
    /*
   if( (int)ob->query("pending/kick_out")) {
   command("say 你小子" + RANK_D->query_respect(ob) + "反复无常，莫说我藏私了。\n");
   command("heng");
   return;
   }
*/
    if ((int)ob->query_int() < 35) {
      command("say 这么笨也来拜我，不收！\n");
      command("sigh");
      return;
    }
    if ((int)ob->query_skill("dao", 1) < 181) {
      command("say 你还是先去找祖师爷去练练吧。\n");
      command("sigh");
      return;
    }
    command("nod");
    command("say 很好，" + RANK_D->query_respect(ob) + "好好跟我练，可别坏了俺老孙的名头。");
    command("recruit " + ob->query("id"));
    return;
  }
  command("shake");
  command("say 不是本门的第子我不收，" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
  return;
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "taoist");
}
void init() {
  object me;

  ::init();
  add_action("do_exercise", ({ "bian" }));
  if (interactive(me = this_player()) && !is_fighting()) {
    call_out("greeting", 0, me);
  }
}
void greeting(object me) {
  int mykar = me->query_kar();
  if (random(mykar) > 100) return;
  else {
    me->delete_temp("spellslevel");
    me->delete_temp("d_mana");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    return;
  }
}
int do_exercise(string arg) {
  write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
  return 1;
}
