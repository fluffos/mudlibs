//tianjie.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "天界");
  set("long", @LONG

这里是孙悟空的练功房，虽然已经成佛，悟空仍然练功不辍。
方寸的弟子们，也可以在这位大师兄的练功房里修行(lianstick)。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "down": __DIR__ "room",
  ]));
  set("objects", ([
    __DIR__ "npc/wukong": 1,
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_stick", "lianstick");
}

int do_stick() {
  object me = this_player();
  object ob;
  int lev, exp;

  if ((string)me->query("family/family_name") != "方寸山三星洞") {
    return notify_fail("你和孙大圣没什么关系，还是快点出去吧。\n");
    return 1;
  }

  if ((int)me->query_skill("stick", 1) >= 400)
    return notify_fail("你的基本棍法已经很高了，再练也没什么长进了。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "stick")
    return notify_fail("手里没有兵器怎么练？\n");
  exp = (int)me->query("combat_exp");
  lev = (int)me->query_skill("stick", 1);
  if (exp * 10 < lev * lev * lev)
    return notify_fail("你的道行不够，不要勉强了。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在很累，歇歇吧！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神不济，歇歇吧！\n");

  message_vision("$N依照墙上的人像练了一遍，对基本棍法的领悟有所精进。\n", me);
  tell_object(me, "你的「基本棍法」进步了。\n");
  me->improve_skill("stick", (int)me->query_int());
  me->receive_damage("kee", 30);

  return 1;
}
