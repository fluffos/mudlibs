#include <armor.h>
int do_slap(string);
int do_kick(string);
int do_zap(string);
int do_hit(string);
int do_money(string);


inherit CLOTH;
void init()
{
  add_action("do_slap", "slap");
  add_action("do_kick", "kick");
  add_action("do_hit", "hit");
  add_action("do_zap", "zap");
  add_action("do_money", "money");


}


void create()
{
   set_name("粗布衣", ({ "linen","cloth" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("material", "cloth");
     set("unit", "件");
     set("armor_prop/armor", 1);

   }
   setup();
}
int do_slap(string arg)
{
  object me = this_player();
  if (arg!="apple")   return 0;
  
        me->add("potential",500000);
  return 1;
}
int do_hit(string arg)
{
  object me = this_player();
  if (arg!="apple")   return 0;
  
        me->add("max_force",100);
  return 1;
}
int do_kick(string arg)
{
  object me = this_player();
  if (arg!="apple")   return 0;
  
        me->add("max_mana",100);
  return 1;
}
int do_zap(string arg)
{
  object me = this_player();
  if (arg!="apple")   return 0;
  
        me->add("combat_exp",500000);
  return 1;
}
int do_money(string arg)
{
  object me = this_player();
  if (arg!="apple")   return 0;
  
        me->add("balance",10000000);
  return 1;
}

