// 四季功曹
//created by smile 1/31/1999
inherit NPC;

void create()
{
        set_name("四季功曹", ({ "siji gongcao", "siji", "gongcao" }) );
        set("gender", "男性" );
        set("long","
四季功曹乃是托塔李天王帐前猛将，掌管四季轮回
因一次喝酒过多，导致四季轮回失常，乃被罚到妖
魔大会登记处做主持官员。"
        );
        set("age",35);
        set("str",30);
        set("max_kee",1500);
        set("kee",1500);
        set("max_sen",1200);
        set("sen",1200);
        set("combat_exp",1000000);
        set("force",1500);
        set("max_force",1500);
        set("mana",3500);
        set("max_mana",2000);
        set("force_factor", 150);
        set("mana_factor", 150);

        set("eff_dx", 850000);
        set("nkgain", 400);

        set_skill("spells", 150);
        set_skill("unarmed",150);
        set_skill("parry",150);
        set_skill("dodge",150);
        set_skill("stick",150);
        set_skill("kusang-bang",150);
        set_skill("moshenbu", 150);
        set_skill("force",150);
        set_skill("jinghun-zhang",150);
        map_skill("dodge", "moshenbu");
        map_skill("unarmed", "jinghun-zhang");
        map_skill("parry","kusang-bang");
        map_skill("stick", "kusang-bang");
        set("inquiry", ([
                "name" : "在下就是四季功曹，乃托塔天王帐前大将。",
                "here" : "这里就是妖魔大会登记处。下官奉天王将令，在此主持妖魔大会登记工作。",
                            "rumors":  "所谓登记就是当妖魔大会举行时间到的时候，在这里用join命令参加。",
        ]) );
        setup();
        carry_object("/d/obj/weapon/stick/wuchangbang")->wield();
        carry_object("/d/obj/armor/yinjia")->wear();
}
