inherit NPC;

void create() {
  set_name("暗黑破坏神", ({ "diablo", "yaoguai", "monster" }));
  set("long", "传说中的大魔王---ＤＩＡＢＬＯ。\n");
  set("gender", "男性");
  set("age", 2000 + random(1500));
  set("attitude", "aggressive");
  set("shen_type", 1);
  set("combat_exp", 88888000);
  set_skill("unarmed", 700);
  set_skill("parry", 700);
  set_skill("force", 700);
  set_skill("ningxie-force", 700);
  set_skill("spells", 700);
  set_skill("dodge", 700);
  set_skill("blade", 700);
  set_skill("shenji-blade", 700);
  set_skill("fall-steps", 700);
  set_skill("tianmo", 700);
  map_skill("blade", "shenji-blade");
  map_skill("dodge", "fall-steps");
  map_skill("parry", "shenji-blade");
  map_skill("spells", "tianmo");
  map_skill("force", "ningxie-force");
  set("max_kee", 9999);
  set("max_sen", 9999);
  set("max_mana", 9999);
  set("max_force", 9999);
  set("mana", 19998);
  set("force", 99998);

  set("mana_factor", 800);
  set("force_factor", 800);
  set_temp("apply/attack", 500);
  set_temp("apply/defense", 500);
  set_temp("apply/armor", 550);
  set_temp("apply/damage", 550);
  setup();
  add_money("gold", 20);
  carry_object("/d/obj/weapon/blade/handudao-redblue")->wield();
  carry_object("/ymdh/obj2/cloth")->wear();
  carry_object("/ymdh/obj2/finger")->wear();
  carry_object("/ymdh/obj2/shield")->wear();
  carry_object("/ymdh/obj2/kui")->wear();
  carry_object("/ymdh/obj2/armor")->wear();
  carry_object("/ymdh/obj2/waist")->wear();
  carry_object("/ymdh/obj2/waists")->wear();
  carry_object("/ymdh/obj2/neck")->wear();
  carry_object("/ymdh/obj2/pifeng")->wear();
  carry_object("/ymdh/obj2/hands")->wear();
  carry_object("/ymdh/obj2/boots")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say("暗黑破坏神说道：人为财死，鸟为实亡，拿命来吧！\n");
      break;
  }
}
