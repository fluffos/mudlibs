#include <ansi.h>

inherit NPC;

void create()
{
  set_name("托塔李天王", ({"tuota tianwang", "tianwang"}));
  set("long", "方面大耳，头带金瓴盔,手托玲珑剔透舍利子如意黄金宝塔。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "friendly");
  set("combat_exp",2000000);
  set("per",40);
  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("spells",200);
    set_skill ("sword",260);
  set_skill("unarmed",200);
  set_skill("dao",200);
  set_skill("jienan-zhi", 200);
  set_skill("lotusmove", 200);
  set_skill("lotusforce",200);
    set_skill ("sanqing-jian",260);
  map_skill("force","lotusforce");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("spells", "dao");
   map_skill ("sword","sanqing-jian");
  set("max_sen",3300);
  set("max_kee",3000);
  set("max_gin",3500);
  set("force",8000);
  set("max_force",4000);
  set("max_mana",3500);
  set("mana",7000);
  set("force_factor",220);
  set("mana_factor",250);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
        (: cast_spell, "light" :),
        (: cast_spell, "dingshen" :),
        (: cast_spell, "thunder" :),
       (:   cast_spell,   "invocation"  :),
       (:   cast_spell,   "fenshen"  :),
        }) );
   set("inquiry",([
                "name":"我乃镇守天宫，掌管十万天兵天将的托塔李天王是也。",
                  "here": "这里就是天下妖魔聚会互分高下的地方",
                  "rumors":"妖魔大会是个迷雾遮天的阴郁地方，迷宫老魔数不胜数，五行八卦变幻莫测。",
                  ]));

  setup();
   carry_object("/d/kaifeng/ymdh/obj/baizhanpifeng")->wear();
   carry_object("/d/obj/armor/jinjia")->wear();
   carry_object("/d/kaifeng/ymdh/obj/zhanyaosword")->wield();
}

void die()
{
      int i;
      object *inv;
      object me=this_player();

    if( environment() ) {
       command("heng");
        message("sound", "\n托塔李天王大怒道：“大胆狂徒，竟敢杀害本王，待我去玉帝那告你一状。”\n", environment());
        message("sound",   "\n说罢，托塔李天王驾起一朵白云直往南天而去！\n",environment());
    inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++)
              {
             if (inv[i]->query("no_drop")) continue;
                 inv[i]->move(environment(me));
                       }
          }
      destruct(me);
 }

void unconcious()
{
        die();
}

void init()
{
  add_action("do_announce","announce");
}

int do_announce(string arg)
{
  object who=this_player();
  if(wizardp(who)) {
       command("chat "+"天地无极，日月维和，人间妖魔当道，生灵涂炭。");
       command("chat "+"圣仁玉皇大帝下体民心，为约束下界妖魔，特许召开天下妖魔大会。");
       command("chat "+"本王承天命，奉旨主持妖魔大会，下界各妖，各安本位，待时辰一到，自当奋勇前来。");
       command("chat "+"天下妖魔大会分五等，分为一百年，五百年，一千年，三千年，一万年,各妖宜自量前往。");
       command("chat "+"妖魔大会举行之地，乃在天地飘渺间。");
    }
  else command("dunno "+who->query("id"));
  return 1;
}
