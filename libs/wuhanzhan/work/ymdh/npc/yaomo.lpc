//yaomo.c
#include <ansi.h>
inherit NPC;

string *prefixs = ({
  "火麒麟",
  "水魔兽",
  "金狮妖",
  "木跋怪",
  "土掩魔",
    "分顶魔",
    "塌天怪",
    "海野兽",
    "惊天妖",
    "绿凤凰",
    "飞天神魔",
    "四角神兽",
    "绝天灭地怪",
    "千变万化无脸鬼",
});

void create()
{
   object ymdoor=load_object("/d/kaifeng/ymdh/ymdoor");
   int i=ymdoor->query("ymdh/year")+1;
  set_name(prefixs[random(sizeof(prefixs))], ({"yaomo"}));
  set("gender", "男性");
  set("age", 1000+random(i*i)*100);
  set("attitude", "aggressive");
  set("combat_exp", 200000*i+random((i+1)*i)*100000);
  set_skill("dodge", 20*i+random((i+1)*i)*10);
  set_skill("parry", 20*i+random((i+1)*i)*10);
  set_skill("force", 20*i+random((i+1)*i)*10);
  set_skill("spells", 20*i+random((i+1)*i)*10);
  set_skill("unarmed", 20*i+random((i+1)*i)*10);

  set("eff_dx",-400000-(i+1)*i*100000);
  set("nkgain",400+10*i*i+random(10)*40);
  set("max_kee", 1000+random(i*i)*50);
  set("max_sen", 1000+random(i*i)*50);
  set("force", 800+random(i*i)*50);
  set("max_force", 800+random(i*i)*50);
  set("mana", 800+random(i*i)*50);
  set("max_mana", 800+random(i*i)*50);
  setup();
  carry_object("/d/kaifeng/ymdh/obj/armor")->wear();
}
