#include <ansi.h>
#include <armor.h>
inherit HEAD;
void create()
{
  set_name(HIY "黄金头盔" NOR, ({"golden bonnet", "bonnet"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
                set("material", "gold");
                set("value", 150000);
               set("no_sell", 1);
               set("no_drop", 1);
                set("armor_prop/armor", 75);
                set("need_level", 5);
        }
        setup();
}
