// dagger.c 
#include <weapon.h>

inherit DAGGER;

void create() {
  set_name("妖魔匕首", ({ "dagger" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把看起相当普通的妖魔匕首，上面隐隐闪现着“妖魔大会”几个字。\n");
    set("material", "steel");
    set("ymdh", 1);
  }
  init_dagger(50);

  setup();
}
