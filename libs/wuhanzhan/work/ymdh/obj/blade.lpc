// blade.c
#include <weapon.h>

inherit BLADE;

void create()
{
        set_name("妖魔刀", ({"blade" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("material", "iron");
                set("long", "这是一寻常的单刀，份量大约六、七斤重，上面隐隐闪现着“妖魔大会”几个字。\n");
                        set ("ymdh",1);
        }
        init_blade(50);
        setup();
}
