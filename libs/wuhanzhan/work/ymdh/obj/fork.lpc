// gangcha.c

#include <weapon.h>
inherit FORK;

void create()
{
        set_name("妖魔叉", ({ "fork" }) );
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("material", "iron");
                set("long", "一柄锋利的钢叉，上面隐隐闪现着“妖魔大会”几个字。\n");
                set ("ymdh",1);
        }
        init_fork(50);
        setup();
}
