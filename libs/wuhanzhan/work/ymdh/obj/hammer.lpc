// hammer.c
#include <weapon.h>
inherit HAMMER;
void create() {
  set_name("妖魔锤", ({ "hammer" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把沈重的铁锤，打造的相当坚实，上面隐隐闪现着“妖魔大会”几个字。\n");
    set("material", "iron");
    set("ymdh", 1);
  }
  init_hammer(50);
  setup();
}
