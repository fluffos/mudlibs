#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
void create() {
  set_name(HIY "锦纹披风" NOR, ({ "jinwen pifeng", "pifeng" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "leather");
    set("unit", "件");
    set("value", 40000);
    set("no_drop", 1);
    set("armor_prop/armor", 60);
    set("armor_prop/courage", 8);
  }
  setup();
}
