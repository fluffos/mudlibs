// axe.c

#include <weapon.h>

inherit AXE;
void create()
{
        set_name("妖魔斧", ({ "axe" }) );
        set_weight(4000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                        set ("ymdh",1);
                set("material", "steel");
                set("long", "这是一把沉重的妖魔斧，砍起东西来非常顺手，上面隐隐闪现着“妖魔大会”几个字。\n");
        }
        init_axe(50, TWO_HANDED);
        setup();
}
