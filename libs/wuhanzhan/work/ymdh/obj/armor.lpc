// armor.c 妖魔金甲 create by smile
#include <armor.h>

inherit ARMOR;

void create()
{
        set_name("妖魔金甲", ({"yaomo armor","jia","armor"}));
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                  set("long", "一件金线织就的宝甲．上面隐隐闪现着“妖魔大会”几个字。\n");
                set("material", "steel");
                set("armor_prop/armor", 60);
                set("ymdh",1);
        }
        setup();
}
