// thousand.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name(WHT "一千万两银票" NOR, ({ "tenthousand-cash", "tenthousand-cash_money", "cash" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "tenthousand-cash");
    set("long", "一张面额值一千万两银子的银票。\n");
    set("unit", "叠");
    set("base_value", 10000000);
    set("base_unit", "张");
    set("base_weight", 5);
  }
  set_amount(1);
}
