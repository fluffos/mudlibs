inherit F_CLEAN_UP;

// This function selects a random target for offensive spells/functions.
object offensive_target(object me) {
  int sz;
  object victim, *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;
  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) {
    victim = enemy[random(sz)];
    return ((victim && environment(victim) == environment(me)) ? victim : 0);
  } else return 0;
}
