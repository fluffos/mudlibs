inherit ITEM;
inherit F_FOOD;

string *names = ({
  "花生棒棒糖",
  "核仁棒棒糖",
  "松子棒棒糖",
  "桃仁棒棒糖",
  "杏仁棒棒糖",
  "杏话梅棒棒糖",
  "桃话梅棒棒糖",
  "李话梅棒棒糖", 
  "芒果棒棒糖",
  "草莓棒棒糖",  

 });

string *parts= ({
  "闭上眼睛，小心翼翼地伸出舌尖舔了下手中的棒棒糖",
  "称赞不已，把糖塞进大嘴里面吮了起来",
  "止不住三尺的垂涎，不顾风度地开始实施歼灭手中棒棒糖的大计",
  "仰起头来，把棒棒糖放在口中，美美地咬了一口",
  "望着手中吃剩下的棒子，意尤未尽地咂了咂嘴",
  "一面吃着糖一面哼着走调的小曲，简直爽呆了",
  "满怀戒备地望着周围眼睛血红的人，加快了吮吸的节奏",
  "忍受着被人追杀的危险，一口将棒棒糖咬下了一大半",
  "吃的太快，差点成为西游记里第一个被棒棒糖噎住的倒霉蛋",
  "将手中大的惊人的棒棒糖摆了个造型，然后放到嘴边酷酷地咬下了一小块",

});

void create()
{
  string name = names[random(sizeof(names))];
  set_name(name, ({"bangbang tang"}));
  set_weight(100);
  set("long","拿在手里还挺重的，不知道以后怎么样，但是你可以保证以前从来没见过这么大的棒棒糖。\n");
  set("unit", "根");
  set("value", 20);
  set("food_remaining", 48);
  set("food_supply", 8);
}

void init ()
{
  add_action("do_eat", "eat");
  ::init();
}

int do_eat (string arg)
{
  object me = this_object();
  object who = this_player();
  string part = parts[random(sizeof(parts))];

  me->set("eat_msg","$N" + part + "。\n");
  return ::do_eat(arg);
}
