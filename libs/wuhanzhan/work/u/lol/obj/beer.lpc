inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("天目湖爽啤", ({ "beer" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一瓶用天目湖中内深度为一百七十六米的湖水酿制的甘甜的啤酒。\n");
    set("unit", "瓶");
    set("value", 200);
    set("max_liquid", 30);
  }

  set("liquid", ([
    "type": "alcohol",
    "name": "啤酒",
    "remaining": 30,
    "drunk_apply": 20,
  ]));
}
