// diamond.c
#include <ansi.h>
inherit MONEY;

void create() {
  set_name(HIW "宇宙合金" NOR, ({ "he jin", "jin", "hejin_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "diamond");
    set("long", "宇宙合金，是最贵的金属！\n");
    set("unit", "克");
    set("base_value", 50000000);
    set("base_unit", "克");
    set("base_weight", 5);
  }
  set_amount(1);
}
