#include <ansi.h>

inherit ITEM;

void init() {
  if (present(this_object(), this_player())) {
    add_action("do_eat", "eat");
    add_action("do_eat", "chi");
    add_action("do_eat", "yan");
    add_action("do_eat", "tun");
  }
}

void create() {
  set_name(HIG "伟哥" NOR, ({ "wei ge", "yao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一颗" HIG "绿色" NOR "的丹丸，吃了不知道会......\n");
    set("value", 10000);
    set("unit", "颗");
    set("no_get", 1);
    set("no_drop", 1);
  }
}

int do_eat(string arg) {
  int i;

  object me = this_player();
  if (!id(arg)) return 0;

  message_vision(HIG "$N小心地吃下一颗" + this_object()->query("name") +
    HIG "，只觉得自己浑身的疲劳被一扫而光，浑身上下都充满了活力。\n"
    NOR, me);
  "/adm/daemons/emoted"->do_emote(me, "yeah");

  me->save();

  destruct(this_object());
  return 1;
}
