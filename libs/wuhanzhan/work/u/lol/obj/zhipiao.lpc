#include <ansi.h>

inherit MONEY;

void create()
{
  set_name(HIW"空"WHT"白"HIR"支"MAG"票"NOR, ({ "zhipiao"}));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "zhi piao");
    set("long", "一张最大面额为七百万两黄金的空白支票。\n");
    set("unit", "张");
    set("base_value", 70000000000);
    set("base_unit", "张");
    set("base_weight", 5);
  }
    set_amount(1);
}

int query_autoload() {return 1;}
