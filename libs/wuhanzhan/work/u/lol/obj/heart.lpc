// diamond.c

#include <ansi.h>
inherit MONEY;

void create() {
  set_name(HIR "海洋之心" NOR, ({ "heart", "xin", "heart_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "heart");
    set("long", "TITANIC中的宝石，宝石由100块小钻石镶嵌而成。\n");
    set("unit", "克");
    set("base_value", 50000000);
    set("base_unit", "克");
    set("base_weight", 5);
  }
  set_amount(1);
}
