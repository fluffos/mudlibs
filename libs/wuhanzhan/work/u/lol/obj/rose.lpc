#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
	set_name(HIC"水晶玫瑰"NOR,({ "rose", "meigui" }) );
        set_weight(500);
        if( clonep() )
        	set_default_object(__FILE__);
        else {                            
        	set("unit","朵");
                set("material", "cloth");
        	set("armor_prop/armor", 10);
          	set("long", "这是一朵用水晶精雕细琢而成的晶莹透明的玫瑰花。\n");
          	set("wear_msg", "$N将一朵玫瑰别在胸前，"HIC"水晶玫瑰"NOR"散射着柔和而分外迷人的七彩光芒！\n");
          	set("remove_msg", "$N微笑着摘下了胸前的"HIC"水晶玫瑰。\n"NOR);
	}
        setup();
}
