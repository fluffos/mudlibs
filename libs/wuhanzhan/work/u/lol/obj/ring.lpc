#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create() {
  set_name(HIG "翠玉戒指" NOR, ({ "yu jie", "yujie", "ring" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 50000000);
    set("material", "silver");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 10);
    set("long", "这是一枚用整块晶莹剔透的" HIG "翠玉" NOR "精雕细琢而成的戒指。\n");
    set("wear_msg", "$N伸出左手，小心翼翼地将" HIG "翠玉戒指" NOR "戴上了无名指。\n");
    set("remove_msg", "$N微笑着摘下了手上的" HIG "翠玉戒指。\n" NOR);
  }
  setup();
}
