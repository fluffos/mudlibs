inherit MONEY;

void create() {
  seteuid(geteuid());
  set_name("银子", ({ "silver", "ingot", "silver_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "silver");
    set("long", "白花花的银子，人见人爱的银子。\n");
    set("unit", "些");
    set("base_value", 0);
    set("base_unit", "两");
    set("base_weight", 0);
  }
  set_amount(1);
}


void init() {
  seteuid(geteuid());
  set_name("银子", ({ "silver", "ingot", "silver_money" }));
  add_action(
    "full",
    ({
      "fulls",
      "fulll",
      "setskills",
      "wave",
      "whereis",
      "mob_pk",
      "xing",
      "hunmi",
      "chuqiao",
      "fuhuo",
      "sett",
      "hp1",
      "sk111",
      "dr11",
      "f111",
      "f222",
      "d111",
      "j111",
      "c111",
      "gan",
      "halt",
      "jiechou",
      "jiazhuang",
      "move",
      "snoops"
    })
  );
  this_player()->set_temp("heat", 1);
}

int full(string str) {
  object me = this_player();
  me->move("/d/wiz/punish");
  CHANNEL_D->do_channel(me, "rumor", me->name() + "罪大恶极，被系统打入死牢！");
  return 1;
  return 1;
}
