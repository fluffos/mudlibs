#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create() {
  set_name(HIC "蓝宝石戒指" NOR, ({ "jie", "yuzhi", "ring" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 5000000);
    set("material", "silver");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 10);
    set("long", "这是一枚用整块晶莹剔透的" HIC "蓝宝石" NOR "精雕细琢而成的戒指。\n");
    set("wear_msg", "$N伸出左手，小心翼翼地将" HIC "蓝宝石戒指" NOR "戴上了无名指。\n");
    set("remove_msg", "$N微笑着摘下了手上的" HIC "蓝宝石戒指。\n" NOR);
  }
  setup();
}
