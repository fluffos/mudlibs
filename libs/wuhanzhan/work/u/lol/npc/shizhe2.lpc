#include <ansi.h>
inherit NPC;

int bu_chang();

void create() {
  set_name(HIG "武汉站酬军使" NOR, ({ "shizhe", }));
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");
  set("per", 30);

  set("max_mana", 5000);
  set("max_force", 5000);
  set("combat_exp", 1000000);

  set("inquiry", ([
    "端午": (: bu_chang :),
  ]));
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_bu(object who) {
  object me = this_object();

  if (who->query("liwu/duanwu2002"))
    return;

  command("ok " + who->query("id"));
  message_vision("\n$N对$n说：" + RANK_D->query_respect(who) +
    ",今天是端午，请接受我们给您的礼物。\n", me, who);
  who->add("liwu/duanwu2002", 1);
  who->add("potential", 300000);
  who->add("max_force", 200);
  who->add("combat_exp", 200000);
  who->add("max_mana", 200);
  tell_object(who, "你得到了三十万点潜能!\n");
  tell_object(who, "你得到了二百点的内法力!\n");
  tell_object(who, "你得到了二百年的道行!\n");
  me->start_busy(5);
}

int bu_chang() {
  object me = this_object();
  object who = this_player();

  if (me->is_busy()) {
    message_vision("$N对$n说道：这位" + RANK_D->query_respect(who) + "，我正忙着哩！\n", me, who);
    return 1;
  }

  if (who->is_busy()) {
    message_vision("$N对$n说道：" + RANK_D->query_respect(who) + "不用心急，正在给您发礼物呢。\n", me, who);
    return 1;
  }
  if (who->query("liwu/duanwu2002")) {
    message_vision("$N对$n说道：你不是已经领过节日礼物了吗？!\n", me, who);
    command("maoli " + who->query("id"));
    return 1;
  }

  do_bu(who);
  return 1;
}
