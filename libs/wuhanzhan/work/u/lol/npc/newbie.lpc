#include <ansi.h>
inherit NPC;

int bu_chang ();

void create()
{
  set_name(HIG "武汉站新人辅导员" NOR, ({ "hui zhang",}));
  set("gender", "男性");
  set("age", 30);
   set("long", "我可是发礼物的哦，ask huizhang about 红包.\n");
  set("attitude", "peaceful");
  set("per",30);
 
  set("max_mana",5000);
  set("max_force",5000);
  set("combat_exp",1000000);
    
  set("inquiry", ([
    "红包" : (: bu_chang :),
    "all" : (: bu_chang :),
    "gift" : (: bu_chang :),
  ]) );
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_bu (object who)
{
  object me = this_object();
    
  if (who->query("liwu/new2002"))
  	return;
  if (((int)who->query("mud_age") > 72000 ))   
  	return;
    
  command("ok "+ who->query("id"));
  message_vision ("\n$N对$n说："+RANK_D->query_respect(who)+
                  "根据本站的实际情况，现给予你以下援助。\n",me,who);
  who->add("liwu/new2002",1);
  who->add("potential",100000);
  who->add("max_force",200);
  who->add("combat_exp", 100000);
  who->add("max_mana",200);
  tell_object(who,"你得到了十万点潜能!\n");
  tell_object(who,"你得到了一百年的道行!\n");
  tell_object(who,"你得到了五十年的道行!\n");
  who->set_skill("dodge",60);
  who->set_skill("parry",60);
  who->set_skill("unarmed",60);
  who->set_skill("literate",60);
  who->set_skill("spells",60);
  who->set_skill("force",60);
  me->start_busy(5);
}

int bu_chang ()
{
  object me = this_object();
  object who = this_player();
 
  if( me->is_busy() ) {
    message_vision ("$N对$n说道：这位"+RANK_D->query_respect(who)+"，我正忙着哩！\n",me,who);
    return 1;
    }
        
  if( who->is_busy() ) {
    message_vision ("$N对$n说道："+RANK_D->query_respect(who)+"不用心急，正在给您发补助呢。\n",me,who);     
    return 1;
    }
  if (who->query("liwu/new2002"))
  {
    message_vision ("$N对$n说道：你已经领过新手援助啦!\n",me,who);
    command("maoli "+ who->query("id"));
    return 1;
  }
  
  do_bu (who);
  return 1;
}
