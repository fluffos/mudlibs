#include <ansi.h>
inherit NPC;

int bu_chang ();

void create()
{
  set_name(HIR "事故补偿负责人" NOR, ({"master",}));
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");
  set("per",30);
 
  set("max_mana",5000);
  set("max_force",5000);
  set("combat_exp",1000000);
    
  set("inquiry", ([
    "补偿" : (: bu_chang :),
  ]) );
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_bu (object who)
{
  object me = this_object();
  object guo;
  int size, pot;
  string *strs;
  mapping skills = who->query_skills();
  int i;
    if (who->query("liwu/savebackup"))
    return;
    if (((int)who->query("combat_exp") < 10000 ))   
    return;

  
  size = sizeof(skills);
    
  command("ok "+ who->query("id"));
  message_vision ("\n$N对$n说：这位"+RANK_D->query_respect(who)+"对这次事故造成的损失，
  我们深感遗憾，现对您补偿如下。\n",me,who);
  pot = who->query("combat_exp")/1000;
  who->add("liwu/savebackup",1);
  who->add("potential",500000+pot*25);
  who->add("max_force",500);
  who->add("combat_exp", pot*100);
  who->add("max_mana",500);
  tell_object(who,"你得到了"+chinese_number(500000+pot*25)+"潜能!\n");
  tell_object(who,"你得到了五百点内力和法力!\n");
  tell_object(who,"你得到了百分之十的道行!\n");
  strs = keys(skills);
  for (i = 0; i < size; i++)
  {
    call_out("buing",i/50,me,who,strs[i]);
  }
  
}


void buing (object me, object who, string str)
{
  int i = who->query_skill(str,1);
  int nian;
  string name = to_chinese(str);
  
 if(i>550) nian = 3;
     else if(i>450) nian = 5;
       else if(i>350) nian = 8; 
         else if(i>250) nian = 10; 
           else if(i>150) nian = 25; 
              else if(i>100) nian = 30;
                else nian = 0; 

  who->set_skill(str,i+nian);
  tell_object(who,"你得到了"+chinese_number(nian)+"级"+name+"！\n");
}

int bu_chang ()
{
  object me = this_object();
  object who = this_player();
 
  if( me->is_busy() ) {
    message_vision ("$N对$n说道：这位"+RANK_D->query_respect(who)+"，我正忙着哩！\n",me,who);
    return 1;
    }
        
  if( who->is_busy() ) {
    message_vision ("$N对$n说道："+RANK_D->query_respect(who)+"不用心急，正在给您发补助呢。\n",me,who);     
    return 1;
    }
  if (who->query("liwu/savebackup"))
  {
    message_vision ("$N对$n说道：你已经领过事故补偿啦!\n",me,who);
    return 1;
  }
  if (((int)who->query("combat_exp") < 10000 ))    
  {
   message_vision ("$N对$n说道,你这么小，也来领补偿？\n",me,who);
   return 1;
  }
  
  do_bu (who);
  return 1;
}
