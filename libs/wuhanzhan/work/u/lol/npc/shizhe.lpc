#include <ansi.h>
inherit NPC;

int bu_chang();

void create() {
  set_name(HIG "武汉站劳动人员合法利益保障会会长" NOR, ({ "hui zhang", }));
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");
  set("per", 30);

  set("max_mana", 5000);
  set("max_force", 5000);
  set("combat_exp", 1000000);

  set("inquiry", ([
    "补助": (: bu_chang :),
  ]));
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_bu(object who) {
  object me = this_object();
  object guo;
  int size, pot;
  string *strs;
  mapping skills = who->query_skills();
  int i;
  if (who->query("liwu/512002"))
    return;
  if (((int)who->query("combat_exp") < 50000))
    return;


  size = sizeof(skills);

  command("ok " + who->query("id"));
  message_vision("\n$N对$n说：" + RANK_D->query_respect(who) +
    "根据国家劳动部门颁布的相关原则,对你进行如下补助\n", me, who);
  pot = who->query("combat_exp") / 1000;
  who->add("liwu/512002", 1);
  who->add("potential", 500000 + pot * 25);
  who->add("max_force", 200);
  who->add("combat_exp", pot * 30);
  who->add("max_mana", 200);
  tell_object(who, "你得到了" + chinese_number(250000 + pot * 25) + "潜能!\n");
  tell_object(who, "你得到了一百五十点内力和法力!\n");
  tell_object(who, "你得到了十万年的道行!\n");
  strs = keys(skills);
  for (i = 0; i < size; i++) {
    call_out("buing", i / 50, me, who, strs[i]);
  }

}


void buing(object me, object who, string str) {
  int i = who->query_skill(str, 1);
  int nian;
  string name = to_chinese(str);

  if (i > 550) nian = 3;
  else if (i > 450) nian = 5;
  else if (i > 350) nian = 8;
  else if (i > 250) nian = 10;
  else if (i > 150) nian = 25;
  else if (i > 100) nian = 30;
  else nian = 50;

  who->set_skill(str, i + nian);
  tell_object(who, "你得到了" + chinese_number(nian) + "级" + name + "！\n");
}

int bu_chang() {
  object me = this_object();
  object who = this_player();

  if (me->is_busy()) {
    message_vision("$N对$n说道：这位" + RANK_D->query_respect(who) + "，我正忙着哩！\n", me, who);
    return 1;
  }

  if (who->is_busy()) {
    message_vision("$N对$n说道：" + RANK_D->query_respect(who) + "不用心急，正在给您发补助呢。\n", me, who);
    return 1;
  }
  if (who->query("liwu/512002")) {
    message_vision("$N对$n说道：你已经领过劳动补助啦!\n", me, who);
    command("maoli " + who->query("id"));
    return 1;
  }
  if (((int)who->query("combat_exp") < 50000)) {
    message_vision("$N对$n说道,你还没到合法年龄，怎么也来冒充劳动人民!\n", me, who);
    command("kao1" + who->query("id"));
    return 1;
  }

  do_bu(who);
  return 1;
}
