inherit NPC;
#include <ansi.h>

string give_bbtang(object me);

void create()
{
   set_name("阿雅妮",({ "a yani" }) );
        set("gender", "女性" );
        set("age", 22);
        set("per", 22);
        set("long", 
   HIW"命运 在旷野中呻吟。纯真 在月光下裸奔。\n"NOR);
   set_temp("apply/defense", 5);
   set("title",HIG"棒棒糖猪猪"NOR);
   set("combat_exp", 5000000);    
   set("max_mana", 4500);    
   set("force", 4500);    
   set("max_force", 4500);    
   set("mana", 4500);    
   set("max_kee", 4500);    
   set("max_sen", 4500);    
   set("sen", 4500);    
   set("kee", 4500);    
   set_skill("literate", 300);    
   set_skill("spells", 300);    
   set_skill("force", 300);    
   set_skill("dodge", 300);    
   set_skill("unarmed", 300);    
   set_skill("parry", 300);    
   set_skill("yaofa", 300);    
   set_skill("kugu-blade", 300);    
   set_skill("lingfu-steps", 300);    
   set_skill("nine-claw", 300);    
   set_skill("blade", 300);    
   set_skill("huntian-qigong", 300);    
   map_skill("blade", "kugu-blade");    
   map_skill("spells", "yaofa");    
   map_skill("force", "huntian-qigong");    
   map_skill("dodge", "lingfu-steps");    
   map_skill("unarmed", "nine-claw");    
   map_skill("parry", "kugu-blade");  
   
   set("inquiry", ([
     
        "阿雅妮" : "什么啊，那不就是我吗？我可是武汉站的最无敌的超霹雳的神经番茄爱好者，哈哈，不服都不行啊。\n",
        "高秀" : "恩，他啊，是我最喜欢最喜欢的一个人了，每一秒钟我都在想他。\n",

        "棒棒糖" : (: give_bbtang :),
       

   ]) );  

   set("attitude", "friendly");
   setup();
   carry_object("/d/obj/cloth/pink_cloth")->wear();
}

void init()
{
  object ob;

  ::init();
  if( interactive(ob = this_player()) && !is_fighting() ) {
     remove_call_out("greeting");
     call_out("greeting", 3, ob);
  }
  add_action("do_sure", "dangran"); 

}

string give_bbtang(object me)
{
   
     me=this_player();

     if (present("bangbang tang", me)) 
        return "你身上不是已经有棒棒糖了吗，怎么还要啊？\n";
 
 {
   me->set_temp("need_bbtang", 1);
   return "糖吃多了会蛀牙的，你是不是真的想要啊？\n";
 }
}

int do_sure(string arg)
{
   object me,bbtang,who;
   me=this_player();
   
   if(me->query_temp("need_bbtang") && me->query("id") == "ayani") 
   {
     message_vision("$N挺了挺胸道：那当然啦！\n\n", me);
      message_vision("阿雅妮叹了口气，伸出纤细的右手食指在空中画了个弧。你的眼前一亮，一根大的要命的棒棒糖出现在眼前。\n", me);
      bbtang=new("/u/lol/obj/bbtang");
      bbtang->move(me);
      me->delete_temp("need_bbtang");

      return 1;
         }
     
   return 0;
}

void die()
{
  if (environment())
  message("sound", "\n\n何必呢？！\n\n", environment());

  set("eff_kee", 4500);
  set("eff_gin", 4500);
  set("eff_sen", 4500);
  set("kee", 4500);
  set("gin", 4500);
  set("sen", 4500);
  set("force", 4500);
  set("mana", 4500);
}
