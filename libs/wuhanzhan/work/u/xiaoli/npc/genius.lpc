inherit NPC;
#include <ansi.h>

int check_player(object me);
int check_hua(object me);
int check_tang(object me);
int check_ks(object me);
int ask_ks(object me);

void create() {
  set_name(HIW "依依" NOR, ({ "yi yi", "yiyi" }));
  set("long", HIM "仙女" NOR + BLU "下凡，" + HIG "精灵" NOR + BLU "转世。\n" NOR);
  set("nickname", HIG "许愿精灵" NOR);
  set("title", BLINK + HIW "精灵一族" NOR);
  set("gender", "女性");
  set("age", 20);
  set("per", 40);
  set("inquiry", ([
    "name": "我叫依依，来自精灵的世界。",
    "here": "这里是你们的世界，我怎么知道哦。你还是问问别人吧。",
    "rumors": "新年到了，祝大家在新的一年里合合美美，快快乐乐！",
    "依依": "依依就是我啦。",
    "上弦月": "她呀，宇宙无敌勇气美少女，嘻嘻。",
    "sxyue": "她呀，宇宙无敌勇气美少女，嘻嘻。",
    "芷水": "酌寒月、借问花影，心静如芷水。",
    "zhishui": "酌寒月、借问花影，心静如芷水。",
    "空酸": (: ask_ks :),
    "xiaoli": (: ask_ks :),
    "节日快乐": (: check_player :),
    "花": (: check_hua :),
    "糖": (: check_tang :),
    "工作": (: check_ks :),
  ]));
  setup();
  carry_object("/obj/loginload/shoes")->wear();
  carry_object("/obj/loginload/skirt")->wear();
  carry_object("/u/xiaoli/obj/flower")->wear();
}

int check_player(object me) {
  object who = this_player();
  message_vision(HIW "依依" NOR + CYN "瞪着一双大大的眼睛，天真地望着$N道：今天好象不是节日耶！\n" NOR, who);
  return 1;
}

int check_tang(object me) {
  object who = this_player();
  object gift = new("/u/xiaoli/obj/bbtang");
  if (who->query("id") != "xiaoli" && who->query("id") != "sxyue" && who->query("id") != "zhishui") {
    message_vision(HIW "依依" NOR + CYN "瞪着一双大大的眼睛看着$N，@_@\n" NOR, who);
    return 1;
  } else {
    gift->move(who);
    me->command_function("kiss " + who->query("id"));
    message_vision(HIW "依依" NOR + "给$N一根棒棒糖。\n" NOR, who);
    return 1;
  }
}

int check_hua(object me) {
  object who = this_player();
  object gift = new("/u/xiaoli/obj/flower");
  if (who->query("id") != "xiaoli" && who->query("id") != "sxyue" && who->query("id") != "zhishui") {
    message_vision(HIW "依依" NOR + CYN "瞪着一双大大的眼睛看着$N，@_@\n" NOR, who);
    return 1;
  } else {
    gift->move(who);
    me->command_function("kiss " + who->query("id"));
    message_vision(HIW "依依" NOR + "给$N一束亮晶晶的" + BLINK + HIW "满天星" NOR + "。\n", who);
    return 1;
  }
}

int check_ks(object me) {
  object who = this_player();
  if (who->query("id") != "xiaoli" && who->query("id") != "sxyue" && who->query("id") != "zhishui") {
    message_vision(HIW "依依" NOR + CYN "瞪着一双大大的眼睛看着$N，@_@\n" NOR, who);
    return 1;
  } else {
    me->command_function("face " + who->query("id"));
    message_vision(HIW "依依" NOR + "将身后的房门打开,$N走了进去。门又自动关上了。\n", who);
    who->move("/u/xiaoli/workroom");
    return 1;
  }
}

int ask_ks(object me) {
  object who = this_player();
  if (who->query("id") != "xiaoli") {
    message_vision(HIW "依依" NOR + CYN "叹了口气。\n" NOR
      +HIW "依依" NOR + CYN "幽幽的说道：……相思相见知何日，此时此夜难为情。\n" NOR, me);
    return 1;
  } else {
    message_vision(HIW "依依" NOR + CYN "腼腆地笑了笑。\n" NOR, who);
    return 1;
  }
}


void init() {
  add_action("do_bian", "bian");
  add_action("do_no", ({ "pot", "slap", "slap1", "woman", "gun", "ba", "kao", "kao2", "die3",
    "kick", "kick1", "kick2", "kick3", "kick4", "kick5", "kick6", "kick7" }));
}

int do_bian() {
  object who = this_player();
  message_vision("$N大喝一声“变！”却什么也没有变成。\n", who);
  return 1;
}

int do_no(string arg) {
  object who = this_player();
  object me = this_object();
  if (!arg || (arg != "yiyi" && arg != "yi yi" && arg != "sxyue" && arg != "zhishui" && arg != "xiaoli" && arg != "sxy")) {
    return 0;
  } else {
    message_vision("$N的手好象有点不老实了。\n", who);
    message_vision(HIW "依依" NOR + CYN "向$n摇摇食指：「小朋友，这样不可以喔！」\n" NOR, me, who);
    return 1;
  }
}

void relay_emote(object ob, string verb) {
  if (!userp(ob)) return;
  switch (verb) {
    case "hit":
      command("pain " + ob->query("id"));
      command("angry " + ob->query("id"));
      break;
    case "bite":
      command("face " + ob->query("id"));
      break;
    case "papaya":
      command("pout");
      break;
    case "kiss":
      command("blush");
      break;
    case "love":
      command("cat " + ob->query("id"));
      break;
    case "touch":
      command("cat " + ob->query("id"));
      break;
    case "face":
      command("pat " + ob->query("id"));
      break;
  }
}
