inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIG "爱洗澡的猪" NOR, ({ "bath pig", "pig", "zhu" }));
  set("race", "野兽");
  set("age", 10);
  set("long", "你好，我是一头猪。:)\n");
  set("combat_exp", 10000);
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("ride/dodge", 50);
  set_temp("apply/attack", 10);
  set_temp("apply/armor", 20);
  setup();
}

void init() {
  add_action("do_mount", "mount");
  add_action("do_dismount", "dismount");
}

int do_mount(string arg) {
  object me = this_object();
  object who = this_player();
  object where = environment(who);
  object rider;
  object ridee;

  if (!arg ||
    !where ||
    !(me = present(arg, where))
  )
    return notify_fail("你想骑什么？\n");

  ridee = who->query_temp("ridee");
  if (ridee &&
    environment(ridee) != environment(who))
    ridee = 0;

  if (ridee)
    return notify_fail("$N已经骑在你脖子上了！\n", me);

  rider = me->query_temp("rider");
  if (rider &&
    environment(rider) != environment(me))
    rider = 0;

  if (rider)
    return notify_fail("$N已经骑在别人身上了，不用再背了。\n", me);
  if (who->query("id") != "xiaoli" && who->query("id") != "sxyue" && who->query("id") != "zhishui" && who->query("id") != "bluea") {
    me->set("ride/msg", "驮");
    message_vision("$N潇洒地一个纵身，稳稳地骑在$n脖子上！\n", me, who);
    me->set_temp("rider", who);
    who->set_temp("ridee", me);
    me->move(where);
    who->set_temp("ride/dodge", me->query("ride/dodge"));
    who->add_temp("apply/dodge", me->query("ride/dodge"));
    me->set_temp("no_return", 1);
    return 1;
  } else {
    message_vision("$N将$n抱了起来，搂在怀里。\n", who, me);
    me->set("ride/msg", "抱");
    me->set_temp("rider", who);
    who->set_temp("ridee", me);
    me->move(where);
    who->set_temp("ride/dodge", me->query("ride/dodge"));
    who->add_temp("apply/dodge", me->query("ride/dodge"));
    me->set_temp("no_return", 1);
    return 1;
  }
}

int do_dismount(string arg) {
  object me = this_object();
  object who = this_player();
  object where = environment(who);

  if (!arg ||
    !where ||
    !(me = present(arg, where)))
    return notify_fail("你想干什么？\n");

  if (me != who->query_temp("ridee"))
    return notify_fail("你并没有" + me->query("ride/msg") + "在" + me->name() + "上。\n");

  message_vision("$N从$n身上跃了下来。\n", me, who);
  me->set_temp("no_return", 0);
  me->set_temp("rider", 0);
  who->set_temp("ridee", 0);
  who->add_temp("apply/dodge", -who->query_temp("ride/dodge"));
  who->set_temp("ride/dodge", 0);
  return 1;
}

void relay_whisper(object me, string msg) {
  object who = this_player();
  if (who->query("id") != "xiaoli" && who->query("id") != "sxyue" && who->query("id") != "zhishui" && who->query("id") != "bluea") {
    message_vision("$N疑惑地看着$n。\n", me, who);
    return;
  }


  if (strsrch(msg, "chat") != -1 ||
    strsrch(msg, "steal") != -1 ||
    strsrch(msg, "kill") != -1 ||
    strsrch(msg, "fight") != -1 ||
    strsrch(msg, "sldh") != -1 ||
    strsrch(msg, "es") != -1 ||
    strsrch(msg, "rumor") != -1 ||
    strsrch(msg, "xyj") != -1 ||
    strsrch(msg, "tell") != -1 ||
    strsrch(msg, "follow") != -1 ||
    strsrch(msg, "apprentice") != -1 ||
    strsrch(msg, "recruit") != -1)
    return;

  if (msg) {
    remove_call_out("relaying");
    call_out("relaying", 1 + random(3), msg);
  }
}

void relaying(string msg) {
  command(msg);
}
