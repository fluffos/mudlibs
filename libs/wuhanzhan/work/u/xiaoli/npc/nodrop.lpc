inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIG "爱洗澡的猪" NOR, ({ "bath pig", "pig", "zhu" }));
  set("race", "野兽");
  set("age", 10);
  set("long", "你好，我是一头猪。:)\n");
  set("combat_exp", 10000);
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite" }));
  setup();
}

void init() {
  add_action("do_drop", "drop");
}

int do_drop(string arg) {
  write("\n请\n\n\n不\n\n\n要\n\n\n乱\n\n\n丢\n\n\n垃\n\n\n圾\n\n\n，\n\n\n谢\n\n\n谢\n\n\n合\n\n\n作\n\n\n\n\n\n");
  return 1;
}
