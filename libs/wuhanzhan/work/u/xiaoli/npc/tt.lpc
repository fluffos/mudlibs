#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG

    给有罪的人提供反省犯罪技巧的时间和场所。
    给无罪的人提供犯罪的感受和渴望。

    被监禁的人要保持清醒的头脑，就不应该期待
    不应该渴望，因为失望是极其痛苦的，在监狱
    里失望无处可以可以倾诉。除非回到自己的囚
    室。

    在监狱里，一个人失去了冷静就一钱不值，因
    为监狱会幸灾乐祸地说到：“看，伙计，你在
    为犯罪受苦。”

LONG);
  setup();
}
void init() {
  add_action("do_call", "ca");
  add_action("do_full", "fl");
  add_action("do_hitt", "ht");
}

int do_call(string arg) {
  string objname, func, param, euid;
  object obj;
  object me = this_player();
  mixed *args, result;
  int i;

  if (arg) {
    if (sscanf(arg, "-%s %s", euid, arg) == 2) {
      seteuid(euid);
    } else
      seteuid(geteuid(this_player(1)));

    if (sscanf(arg, "%s->%s(%s)", objname, func, param) != 3)
      return notify_fail("指令格式：call <物件>-><函数>( <参数>, ... )\n");
  } else
    return notify_fail("指令格式：call <物件>-><函数>( <参数>, ... )\n");

  obj = present(objname, environment(me));
  if (!obj) obj = present(objname, me);
  if (!obj) obj = find_player(objname);
  if (!obj || !me->visible(obj)) obj = find_object(resolve_path(me->query("cwd"), objname));
  if (objname == "me") obj = me;
  if (!obj) return notify_fail("找不到指定的物件。\n");

  args = explode(param, ",");
  for (i = 0; i < sizeof(args); i++) {
    parse_command(args[i], environment(me), "%s", args[i]);
    if (sscanf(args[i], "%d", args[i])) continue;
    if (sscanf(args[i], "\"%s\"", args[i])) continue;
  }

  args = ({ func }) + args;

  result = call_other(obj, args);
  for (i = 1; i < sizeof(args); i++)
    args[i] = sprintf("%O", args[i]);
  tell_object(me, sprintf("%O->%s(%s) = %O\n", obj, func,
    implode(args[1..sizeof(args) - 1], ", "), result));
  return 1;
}

int do_full(string arg) {
  object ob;
  object me = this_player();

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else ob = present(arg, environment(me));
  if (!ob) ob = find_player(arg);
  if (!ob) ob = find_living(arg);
  if (!ob) return notify_fail("你恢复谁的状态？\n");

  ob->set("mana", ob->query("max_mana") * 2);
  ob->set("force", ob->query("max_force") * 2);
  ob->set("sen", ob->query("max_sen"));
  ob->set("eff_sen", ob->query("max_sen"));
  ob->set("kee", ob->query("max_kee"));
  ob->set("eff_kee", ob->query("max_kee"));
  ob->set("food", (int)me->max_food_capacity() * 15 + random(120));
  ob->set("water", (int)me->max_water_capacity() * 15 + random(120));
  ob->clean_condition();

  if (ob->is_ghost())
    ob->reincarnate();
  return 1;
}

int do_hitt(string arg) {
  object ob, me;

  me = this_player();
  ob = new("/d/mojiao/huomigong/obj/ymr");
  ob->move(me);
  message_vision("OK。\n", me);
  return 1;
}
