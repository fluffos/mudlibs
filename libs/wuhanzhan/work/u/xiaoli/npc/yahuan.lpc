#include <ansi.h>

inherit NPC;

int ask_yx();

void create() {
  set_name("小丫鬟", ({ "ya huan", "yahuan" }));

  set("gender", "女性");
  set("age", 9);
  set("title", BLINK + HIW "精灵一族" NOR);
  set("attitude", "peaceful");
  set("class", "xian");
  set("long", "小丫鬟。\n");
  set("nickname", HIG "领礼物前请务必先news 112,否则后果自负！！！" NOR);
  set("str", 30);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("per", 30);
  set("force", 15000);
  set("max_force", 15000);
  set("force_factor", 1500);
  set("mana", 20000);
  set("max_mana", 20000);
  set("combat_exp", 500000000);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("spells", 300);
  set_skill("moonshentong", 300);
  set_skill("baihua-zhang", 300);
  set_skill("moonforce", 300);
  set_skill("snowsword", 300);
  set_skill("moondance", 300);
  map_skill("spells", "moonshentong");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  set("inquiry", ([
    "元宵节": (: ask_yx :),
    "元宵": (: ask_yx :),
  ]));
  setup();

  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/moon/obj/feijian")->wield();
}

int ask_yx() {
  object me = this_object();
  object who = this_player();

  if (who->query("xiaoli/04YX")) {
    write("别那么贪心，要过了就不要再来了。\n");
    return 1;
  }

  who->set_temp("check_answer", 1);
  message_vision("$N对$n作了个揖道：“这位" + RANK_D->query_respect(who) + "节日快乐！”\n", me, who);
  message_vision("$N对$n说道：“这位" + RANK_D->query_respect(who) + ",可敢跟我赌上一赌？赢了有双份礼物哦！”\n", me, who);
  message_vision("$N又说道：“不过输了的话，你就什么也得不到了！” \n", me, who);
  write("请用" + HIR "(answer yes/no)" NOR + "回答。\n");
  return 1;
}

void init() {
  add_action("do_answer", "answer");
  add_action("do_go", ({ "move", "go", "pray", "accept" }));
}


int do_answer(string arg) {
  object me = this_object();
  object who = this_player();
  int dh, dh1, xw1, qn1, year, day, hour;
  dh = who->query("combat_exp");

  if (!(who->query_temp("check_answer")))
    return notify_fail("什么？\n");

  if (!arg || (arg != "yes" && arg != "no")) return notify_fail("请用answer yes/no来回答。\n");

  if (strsrch(arg, "yes") >= 0) {
    this_player()->start_busy(3);
    message_vision("$N答道：赌就赌，谁怕谁呀。"
      +RANK_D->query_self_rude(this_player()) + "豁出去了！\n", this_player());
    message_vision("$N说道：“好，那我们就来赌上一赌，看你的运气怎么样。待我算上一算。\n", this_object());

    if (random(2) == 1) {
      if (dh > 150000000) {
        dh1 = dh / 80 + 10000 + random(10001);
        year = dh1 / 1000;
        day = (dh1 - year * 1000) / 4;
        hour = (dh1 - year * 1000 - day * 4) * 3;
        xw1 = 60 + random(40);
        qn1 = 600000 + random(100000);
        who->add("combat_exp", dh1);
        who->add("max_mana", xw1);
        who->add("max_force", xw1);
        who->add("potential", qn1);
        who->add("xiaoli/04YX", 1);
        who->delete_temp("check_answer");
        message_vision(HIR "$N微笑着对$n道：“恭喜恭喜！”\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(year) + "年" + chinese_number(day) + "天"
          +chinese_number(hour) + "时辰的道行！\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(xw1) + "点最大法力内力！\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(qn1) + "点潜能！\n\n" NOR, me, who);
        return 1;
      }

      else if (dh > 50000000 && dh < 150000001) {
        dh1 = (dh * 3) / 160 + 10000 + random(10001);
        year = dh1 / 1000;
        day = (dh1 - year * 1000) / 4;
        hour = (dh1 - year * 1000 - day * 4) * 3;
        xw1 = 60 + random(40);
        qn1 = 500000 + random(100000);
        who->add("combat_exp", dh1);
        who->add("max_mana", xw1);
        who->add("max_force", xw1);
        who->add("potential", qn1);
        who->add("xiaoli/04YX", 1);
        who->delete_temp("check_answer");
        message_vision(HIR "$N微笑着对$n道：“恭喜恭喜！”\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(year) + "年" + chinese_number(day) + "天"
          +chinese_number(hour) + "时辰的道行！\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(xw1) + "点最大法力内力！\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(qn1) + "点潜能！\n\n" NOR, me, who);
        return 1;
      }

      else if (dh > 3456000 && dh < 50000001) {
        dh1 = (dh * 3) / 160 + 30000 + random(10001);
        year = dh1 / 1000;
        day = (dh1 - year * 1000) / 4;
        hour = (dh1 - year * 1000 - day * 4) * 3;
        xw1 = 40 + random(40);
        qn1 = 400000 + random(100000);
        who->add("combat_exp", dh1);
        who->add("max_mana", xw1);
        who->add("max_force", xw1);
        who->add("potential", qn1);
        who->add("xiaoli/04YX", 1);
        who->delete_temp("check_answer");
        message_vision(HIR "$N微笑着对$n道：“恭喜恭喜！”\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(year) + "年" + chinese_number(day) + "天"
          +chinese_number(hour) + "时辰的道行！\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(xw1) + "点最大法力内力！\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(qn1) + "点潜能！\n\n" NOR, me, who);
        return 1;
      }

      else if (dh < 3456001) {
        dh1 = dh / 50 + 50000 + random(10001);
        year = dh1 / 1000;
        day = (dh1 - year * 1000) / 4;
        hour = (dh1 - year * 1000 - day * 4) * 3;
        xw1 = 40 + random(40);
        qn1 = 300000 + random(100000);
        who->add("combat_exp", dh1);
        who->add("max_mana", xw1);
        who->add("max_force", xw1);
        who->add("potential", qn1);
        who->add("xiaoli/04YX", 1);
        who->delete_temp("check_answer");
        message_vision(HIR "$N微笑着对$n道：“恭喜恭喜！”\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(year) + "年" + chinese_number(day) + "天"
          +chinese_number(hour) + "时辰的道行！\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(xw1) + "点最大法力内力！\n", me, who);
        message_vision(HIR "$n得到了" + chinese_number(qn1) + "点潜能！\n\n" NOR, me, who);
        return 1;
      }
    } else {
      who->add("xiaoli/04YX", 1);
      who->delete_temp("check_answer");
      message_vision("$N很遗憾地说：“不好意思，你什么也没有得到。:(”\n", me);
      message_vision("$N无奈地对着$n耸了耸肩。\n", me, who);
      return 1;
    }
  }

  if (strsrch(arg, "no") >= 0) {
    message_vision("$N轻轻地拍了拍$n的头道：“乖宝宝。”\n", me, who);
    if (dh > 150000000) {
      dh1 = dh / 150 + 10000 + random(10001);
      year = dh1 / 1000;
      day = (dh1 - year * 1000) / 4;
      hour = (dh1 - year * 1000 - day * 4) * 3;
      xw1 = 40 + random(40);
      qn1 = 400000 + random(100000);
      who->add("combat_exp", dh1);
      who->add("max_mana", xw1);
      who->add("max_force", xw1);
      who->add("potential", qn1);
      who->add("xiaoli/04YX", 1);
      who->delete_temp("check_answer");
      message_vision(HIR "$N微笑着对$n道：“节日好！你的礼物为：\n"
        +chinese_number(year) + "年" + chinese_number(day) + "天"
        +chinese_number(hour) + "时辰的道行和\n"
        +chinese_number(xw1) + "点最大法力内力以及\n"
        +chinese_number(qn1) + "点潜能。\n\n" NOR, me, who);
      return 1;
    }

    else if (dh > 50000000 && dh < 150000001) {
      dh1 = (dh * 3) / 300 + 10000 + random(10001);
      year = dh1 / 1000;
      day = (dh1 - year * 1000) / 4;
      hour = (dh1 - year * 1000 - day * 4) * 3;
      xw1 = 40 + random(20);
      qn1 = 300000 + random(100000);
      who->add("combat_exp", dh1);
      who->add("max_mana", xw1);
      who->add("max_force", xw1);
      who->add("potential", qn1);
      who->add("xiaoli/04YX", 1);
      who->delete_temp("check_answer");
      message_vision(HIR "$N微笑着对$n道：“节日好！你的礼物为：\n"
        +chinese_number(year) + "年" + chinese_number(day) + "天"
        +chinese_number(hour) + "时辰的道行和\n"
        +chinese_number(xw1) + "点最大法力内力以及\n"
        +chinese_number(qn1) + "点潜能。\n\n" NOR, me, who);
      return 1;
    }

    else if (dh > 3456000 && dh < 50000001) {
      dh1 = (dh * 3) / 300 + 30000 + random(10001);
      year = dh1 / 1000;
      day = (dh1 - year * 1000) / 4;
      hour = (dh1 - year * 1000 - day * 4) * 3;
      xw1 = 30 + random(20);
      qn1 = 200000 + random(100000);
      who->add("combat_exp", dh1);
      who->add("max_mana", xw1);
      who->add("max_force", xw1);
      who->add("potential", qn1);
      who->add("xiaoli/04YX", 1);
      who->delete_temp("check_answer");
      message_vision(HIR "$N微笑着对$n道：“节日好！你的礼物为：\n"
        +chinese_number(year) + "年" + chinese_number(day) + "天"
        +chinese_number(hour) + "时辰的道行和\n"
        +chinese_number(xw1) + "点最大法力内力以及\n"
        +chinese_number(qn1) + "点潜能。\n\n" NOR, me, who);
      return 1;
    }

    else if (dh < 3456001) {
      dh1 = dh / 80 + 20000 + random(10001);
      year = dh1 / 1000;
      day = (dh1 - year * 1000) / 4;
      hour = (dh1 - year * 1000 - day * 4) * 3;
      xw1 = 30 + random(20);
      qn1 = 100000 + random(100000);
      who->add("combat_exp", dh1);
      who->add("max_mana", xw1);
      who->add("max_force", xw1);
      who->add("potential", qn1);
      who->add("xiaoli/04YX", 1);
      who->delete_temp("check_answer");
      message_vision(HIR "$N微笑着对$n道：“节日好！你的礼物为：\n"
        +chinese_number(year) + "年" + chinese_number(day) + "天"
        +chinese_number(hour) + "时辰的道行和\n"
        +chinese_number(xw1) + "点最大法力内力以及\n"
        +chinese_number(qn1) + "点潜能。\n\n" NOR, me, who);
      return 1;
    }
  }
}

int do_go() {
  this_player()->delete_temp("check_answer");
  return 0;
}
