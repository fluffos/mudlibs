#include <ansi.h>
inherit ROOM;
#include <ban.h>


void create()
{
        set("short","死牢");
        set("long",@LONG

    给有罪的人提供反省犯罪技巧的时间和场所。
    给无罪的人提供犯罪的感受和渴望。

    被监禁的人要保持清醒的头脑，就不应该期待
    不应该渴望，因为失望是极其痛苦的，在监狱
    里失望无处可以可以倾诉。除非回到自己的囚
    室。

    在监狱里，一个人失去了冷静就一钱不值，因
    为监狱会幸灾乐祸地说到：“看，伙计，你在
    为犯罪受苦。”

LONG );

/*
        set("exits",([ 
                "north":"/d/wiz/wizroom" ,
                "east":"/d/wiz/outjail" ,
                "south":"/d/city/kezhan" 
                     ]));
*/
        set("valid_startroom", 1);
        set("no_clean_up", 0);
        setup();
}
void init()
 {
        add_action("do_eat","eat");
        add_action("do_out","out");

        add_action("do_cast","cast");
        add_action("do_quit","quit");
        add_action("do_no",({"exercise","meditate","practice","learn"}));
 }

int do_quit(string arg) {
  write("你不能在这里用这条命令。\n");
  return 1;
}

int do_no(string arg) {
  write("这里杀气太重，不适合练功。\n");
  return 1;
}

int do_cast(string arg) {

    if(!arg) return 0;
    while(sscanf(arg,"%s %*s",arg)==2);
    if(member_array(arg,banned_cast)==-1) return 0;
    write("这里没有办法逃跑。\n");
    return 1;
}

int do_eat(string arg)
{       
        object me = this_player();

        if ( !arg || ((arg != "pear"  && arg != "lizi" && arg != "yali")))
                return notify_fail("你要吃什么？\n");
 
   message_vision(HIG"$N狼吞虎咽地啃掉一个大鸭梨，还意犹未尽地咂了咂嘴巴。\n" NOR,me);
   me->set("food", (int)me->max_food_capacity()*30+random(120));
   me->set("water", (int)me->max_water_capacity()*30+random(120));
   return 1;      

}

int do_out()
{
  object me = this_object();
  object who = this_player();

  if (who->query_temp("no_move") ||
      who->is_busy())
  {
    tell_object (who, "你正忙着呢。\n");
    return 1;
  }
  if (random (5))
  {
     message_vision ("$N用尽全身的力气想从墙角的老鼠洞里钻出去，但是没有成功。\n",who);
    
     return 1;
  }
else
  { 
  message_vision ("$N想了想，不知从哪儿翻出一根细绳子，从头到脚把自己捆得象个粽子。\n",who);
  message_vision ("$N吃力地从墙角的老鼠洞里钻了出去。\n",who);
  who->move("/d/city/kezhan");
  who->start_busy(3);
  message_vision (YEL"$N狼狈不堪地从墙角的老鼠洞里钻了出来，闹了个灰头土脸。\n" NOR,who);
  return 1;
  }
}

