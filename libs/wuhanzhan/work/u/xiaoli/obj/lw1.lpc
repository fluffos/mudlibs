#include <ansi.h>
inherit ITEM;
int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
     set("no_give","你太慷慨了吧！\n");
     set("no_get"," 嘿嘿，做梦吧! \n");
     set("no_drop","这东西你也想丢？\n");
     set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }
    if(this_player()==environment())
  add_action("do_eat", "eat");
}
void create()
{
                  set_name( HIY "贝母" NOR , ({"bei mu","dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
  set("unit", "颗");
       set("long", "贝母属百合科草本植物（产地不同也称川贝.浙贝）多用于伤风感冒肺热咳嗽.对非典有特殊的疗效。\n");
      set("value", 10000);
    set("drug_type", "补品");
  }
  set("is_monitored",1);
  setup();
}
 int do_eat(string arg)
{
  object me = this_player();
       if (arg!="dan") return 0;
  if(me->query("lw1")==1)
   {
    tell_object(me,"没病别乱吃药。\n");
  destruct(this_object());
    return 1;}
seteuid(getuid());
  switch (random(0))
{
case 0:
{       me->set("lw1",1);
        me->add("potential",80000);
        me->add("combat_exp",80000);
        me->set("food", (int)me->max_food_capacity()*3+random(120));
        me->set("water", (int)me->max_water_capacity()*3+random(120));
        message_vision(HIY "$N拿起贝母含在口中，小心翼翼地吃了进去。
$N面色变成赤红，心神恍惚，如醉如痴。\n" NOR, me);
break;
}
}
  destruct(this_object());
  return 1;
}

