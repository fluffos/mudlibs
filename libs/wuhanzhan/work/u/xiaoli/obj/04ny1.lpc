#include <ansi.h>
inherit ITEM;

void create() {
  set_name(YEL "大许愿树" NOR, ({ "Xmas tree", "tree" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG

新年来临之际，祝大话西游各位朋友心想事成，大吉大利，财源广进……

我们为您准备了一点小小的礼物，不成敬意，请您用(wish)来领取。^-^

LONG);
    set("unit", "棵");
    set("weight", 5);
    set("value", 1);
  }
}

void init() {
  add_action("do_wish", "wish");
}

int do_wish(string arg) {
  object me = this_player();
  object ob = this_object();
  string *ans = ({ "修为", "道行", "潜能" });
  int ans1, xw, dh, qn, year, day, hour;
  if (me->query("xiaoli/04NY1")) {
    message_vision(YEL "$N鬼鬼祟祟地拿出一棵许愿树躲在角落里许愿：神啊！我想要……\n" NOR, me);
    message_vision(HIR "许愿精灵神情古怪地笑了一下，突然举起手中的魔杖在$N的头上用力一敲！\n\n" NOR, me);
    me->set("kee", 0);
    me->set("sen", 0);
    me->set("force", 0);
    me->set("mana", 0);
    me->unconcious();
    message_vision(HIR "许愿精灵飞起一脚，将$N踢到了九霄云外！\n" NOR, me);
    me->move("/d/qujing/lingshan/daxiong");
    destruct(this_object());
    return 1;
  }

  if (arg == "0" || arg == "1" || arg == "2") {
    sscanf(arg, "%d", ans1); arg = ans[ans1];
  }
  if (!arg ||
    (arg != "修为"
      && arg != "道行"
      && arg != "潜能"))
    return notify_fail(HIG "许愿精灵在你耳旁悄声说道：许个愿吧！在新的一年里，你最想得到什么东西呢？我可以帮你满足你以下愿望：" + HIW "道行" NOR + HIG "、" NOR + HIW "潜能" NOR + HIG "或者" + HIW "修为" NOR + HIG "，你选一个吧！注意你只有一次机会哦！\n" NOR);
  {
    if (arg == "修为" && !(me->query("xiaoli/04NY1"))) {
      xw = random(15) + 60;
      me->add("max_mana", xw);
      me->add("max_force", xw);
      me->set("xiaoli/04NY1", 1);
      message_vision(HIG "$N闭上眼睛默默地许了一个愿。\n" NOR, me);
      message_vision(HIC "许愿精灵对着$N说道：好吧！我马上帮你实现愿望。\n"
        + "许愿精灵举起手中的魔杖对着$N轻轻一挥…… \n" NOR, me);
      message_vision(HIC "$N感觉到一股神奇的力量在身体里涌动，慢慢的扩散到全身。立刻，身体发生了奇妙的变化！\n\n" NOR, me);
      message_vision(HIR "$N得到了" + xw + "点最大法力内力的节日礼物。\n" NOR, me);
      message_vision(HIC "许愿精灵对$N神秘地微笑了一下，突然消失不见了。\n\n" NOR, me);
      if (random(5) == 1) {
        if (random(8) == 0) {
          me->add("str", 1);  //膂力
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "膂力" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 1) {
          me->add("cps", 1);  //定力
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "定力" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 2) {
          me->add("cor", 1);  //胆识
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "胆识" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 3) {
          me->add("per", 1);  //容貌
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "容貌" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 4) {
          me->add("int", 1);  //悟性
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "悟性" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 5) {
          me->add("con", 1);  //根骨
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "根骨" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 6) {
          me->add("spi", 1);  //灵性
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "灵性" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 7) {
          me->add("kar", 1);  //福缘
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "福缘" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        }
      }
      destruct(this_object());
      return 1;
    } else if (arg == "道行" && !(me->query("xiaoli/04NY1"))) {
      dh = (int)me->query("combat_exp") / 60 + 80000;
      year = dh / 1000;
      day = (dh - year * 1000) / 4;
      hour = (dh - year * 1000 - day * 4) * 3;
      me->add("combat_exp", dh);
      me->set("xiaoli/04NY1", 1);
      message_vision(HIG "$N闭上眼睛默默地许了一个愿。\n" NOR, me);
      message_vision(HIC "许愿精灵对着$N说道：好吧！我马上帮你实现愿望。\n"
        + "许愿精灵举起手中的魔杖对着$N轻轻一挥…… \n" NOR, me);
      message_vision(HIC "$N感觉到一股神奇的力量在身体里涌动，慢慢的扩散到全身。立刻，身体发生了奇妙的变化！\n\n" NOR, me);
      message_vision(
        HIR "$N得到了" + chinese_number(year) + "年" + chinese_number(day) + "天" + chinese_number(hour) + "时辰道行的节日礼物。\n" NOR,
        me
      );
      message_vision(HIC "许愿精灵对$N神秘地微笑了一下，突然消失不见了。\n\n" NOR, me);
      if (random(5) == 1) {
        if (random(8) == 0) {
          me->add("str", 1);  //膂力
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "膂力" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 1) {
          me->add("cps", 1);  //定力
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "定力" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 2) {
          me->add("cor", 1);  //胆识
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "胆识" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 3) {
          me->add("per", 1);  //容貌
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "容貌" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 4) {
          me->add("int", 1);  //悟性
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "悟性" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 5) {
          me->add("con", 1);  //根骨
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "根骨" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 6) {
          me->add("spi", 1);  //灵性
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "灵性" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 7) {
          me->add("kar", 1);  //福缘
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "福缘" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        }
      }
      destruct(this_object());
      return 1;
    } else if (arg == "潜能" && !(me->query("xiaoli/04NY1"))) {
      qn = random(100000) + 150000;
      me->add("potential", qn);
      me->set("xiaoli/04NY1", 1);
      message_vision(HIG "$N闭上眼睛默默地许了一个愿。\n" NOR, me);
      message_vision(HIC "许愿精灵对着$N说道：好吧！我马上帮你实现愿望。\n"
        + "许愿精灵举起手中的魔杖对着$N轻轻一挥…… \n" NOR, me);
      message_vision(HIC "$N感觉到一股神奇的力量在身体里涌动，慢慢的扩散到全身。立刻，身体发生了奇妙的变化！\n\n" NOR, me);
      message_vision(HIG "$N得到了" + qn + "点潜能的节日礼物。\n" NOR, me);
      message_vision(HIC "许愿精灵对$N神秘地微笑了一下，突然消失不见了。\n\n" NOR, me);
      if (random(5) == 1) {
        if (random(8) == 0) {
          me->add("str", 1);  //膂力
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "膂力" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 1) {
          me->add("cps", 1);  //定力
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "定力" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 2) {
          me->add("cor", 1);  //胆识
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "胆识" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 3) {
          me->add("per", 1);  //容貌
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "容貌" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 4) {
          me->add("int", 1);  //悟性
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "悟性" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 5) {
          me->add("con", 1);  //根骨
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "根骨" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 6) {
          me->add("spi", 1);  //灵性
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "灵性" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        } else if (random(8) == 7) {
          me->add("kar", 1);  //福缘
          message_vision(HIR "恭喜恭喜！$N得到了一点先天" BLINK + HIW "福缘" NOR + HIR "作为特殊奖励！\n\n" NOR, me);
        }
      }
      destruct(this_object());
      return 1;
    }
  }
}
