#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(YEL "巧克力"NOR,({"love's qkl","qkl"}));
   if( clonep() )
     set_default_object(__FILE__);
   else {
    set("long", "巧克力，又甜又脆的巧克力。不过，听说吃多了会牙疼！\n");
    set("unit", "块");
    set("weight", 5);
    set("no_put",1);
    set("value", 50000);
    set("no_sell",1);
    set("no_drop",1);
    set("no_get",1);
    set("is_monitored",1);
   }
}

void init()
{
  add_action("do_eat","eat");
  add_action("do_give","give");
}
int do_give(string arg)
{
  object who=this_player();
  object ob;
  object tuanzi=this_object();
  string item,target;
  if(!arg) {
         tell_object(who,"你要干什么？\n");
         return 1;}
 if( sscanf(arg, "%s to %s", item, target)==2
   || sscanf(arg, "%s %s", target, item)==2 );
 else return notify_fail("你要给谁什么东西啊？\n");
  if(item!="qkl")
    return 0;
  if(!wizardp(who)) {
     tell_object(who,"你无权把这个东西给人。\n");
      return 1;
       }
  ob=find_player(target);
  if(!ob) {
       tell_object(who,"没有这个玩家，无法把这个东西给他。\n");
       return 1;
          }
   if(ob->query("qkleaten")==1) {
    tell_object(who,"这个人已经拿过巧克力了，可不能给第二次！\n");
    return 1;
       }
  tuanzi->move(ob);
  tell_object(who,"你给"+ob->name()+"一块"+this_object()->name()+"\n");
  tell_object(ob,who->name()+"给你一块"+this_object()->name()+"。\n");
  return 1;
}

int do_eat(string arg)
{
{
 object who=this_player();
 object ob=this_object();
 if(who->query("combat_exp") >= 1000000 || who->query("mud_age") >= 345600 || who->query("qkleaten"))
   {
    tell_object(who,"你好意思？\n");
    destruct(ob);
    return 1;
   }
  else {
    message_vision(HIY"$N慢慢的品尝着巧克力，仿佛又回想起那已渐渐淡忘的童年。\n"NOR,who); 
    tell_object(who,HIY"你的潜能增加了五万点！\n"NOR);
    tell_object(who,HIY"你的道行增加了五十年！\n"NOR);
    who->set("qkleaten",1);
    who->add("potential",50000);
    who->add("combat_exp",50000);
     destruct(ob);
          return 1;
       }
}

}

