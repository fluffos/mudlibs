#include <ansi.h>
inherit ITEM;

string *names = ({
 "三鲜猪肉馅儿饺子",
 "鸡蛋韭菜馅儿饺子",
 "南瓜虾仁儿馅儿饺子",
 "茴香馅儿饺子",
 "山野菜馅儿饺子",
 "羊肉白菜馅儿饺子",
 "牛肉酸菜馅儿饺子",
 "素馅儿饺子",
 "三文鱼馅儿饺子",
 "葱花豆腐馅儿饺子",
 "甜馅儿饺子",
 "胡萝卜馅儿饺子",
 });

void create()
{
  string name = names[random(sizeof(names))];
  set_name(name, ({"jiao zi","jiaozi"}));
  set_weight(100);
  set("long","啊～饺子，香喷喷热腾腾的饺子～～～小心！你的口水要流出来了！\n");
  set("unit", "碗");
  set("no_put", 1);
}

void init ()
{
  add_action("do_eat", "eat");
}

int do_eat (string arg)
{
  object me = this_object();
  object who = this_player();
  int fl, dh, dh1, xw1, qn1, ck1, year, day, hour, hj, yz, tq;
  dh = who->query("combat_exp");
 
   if( !arg || (arg != "jiaozi"   && arg != "jiao zi" ))
         {return 0;}
   if (uptime() - who->query_temp("jz_eat") < 10)
         { message_vision("$N端起一碗" + me->query("name") + "正准备吃，没想到太激动，一不小心咬了舌头。\n",who);
           return 1;}
   else 
    {    who->set("food",  (int)who->max_food_capacity()*5 + random(120));
         who->set("water",(int)who->max_water_capacity()*5 + random(120));
         who->set_temp("jz_eat",uptime());
         message_vision(HIG"$N端起一碗热气腾腾的" + me->query("name") + "，三下五去二的吃完了。\n\n"NOR,who);
 
      if (who->query("xiaoli/04JZ"))
        { destruct(this_object());
          return 1; }
      if (who->query("mud_age") < 7200 )
        { write("你似乎感觉到吃下去的饺子并没有被完全消化。\n",who);
          write("对不起，为了减轻系统负担，礼物只奖励给"+BLINK+HIW"mudage大于两小时"NOR+"的玩家，谢谢合作。\n",who);
          return 1;}

      if (random(3) == 1) 
        { ck1 = 2000000 + random(2000001);
             hj =  ck1 / 10000;
             yz = (ck1 - hj * 10000) / 100;
             tq =  ck1 - hj * 10000 - yz * 100;
          who->add("balance",ck1);
          message_vision(HIW"$N意外地得到了" + chinese_number(hj) + "两黄金" + chinese_number(yz) + "两银子"
                                             + chinese_number(tq) + "个铜板的福利！\n"NOR,who);}

          who->set("xiaoli/04JZ", 1);
          who->start_busy(3);
          write(HIR"\n大话西游巫师组祝您：\n"+HIC"
┬┴┬┌─　"BLINK+HIM"★"NOR+HIC"─┬─　　│─┼─┐　"BLINK+HIB"●"NOR+HIC"├─┤"BLINK+HIW"○"NOR+HIC"
┴┬┴├┬　┌─┼─　│"BLINK+HIM"★"NOR+HIC"　│　│　"BLINK+HIW"○"NOR+HIC"└┬┘"BLINK+HIB"●"NOR+HIC"
─┼─││　│　│　　││─┴─┴　──┼──
"BLINK+HIB"●"NOR+HIC"│"BLINK+HIW"○"NOR+HIC"││　┴─┼─　　│"BLINK+HIW"○　　"+HIM"★"NOR+HIC"　／　│　＼\n\n"NOR);

      if (dh > 150000000 )
        { dh1 = dh / 100 + 10000 + random(2001);
             year = dh1 / 1000;
             day  = (dh1 - year * 1000) / 4;
             hour = (dh1 - year * 1000 - day * 4) * 3; 
          xw1 = 40 + random(40);
          qn1 = 400000 + random(100000);
          who->add("combat_exp",dh1);
          who->add("max_mana",  xw1);
          who->add("max_force", xw1);
          who->add("potential", qn1);
          message_vision(HIR"$N得到了"+ chinese_number(year) + "年" + chinese_number(day) + "天" 
                                      + chinese_number(hour) + "时辰的道行奖励！\n"
                                      + "$N得到了"+ chinese_number(xw1)  + "点最大法力内力奖励！\n"
                                      + "$N得到了"+ chinese_number(qn1)  + "点潜能奖励！\n\n"NOR,who);
          destruct(this_object());
          return 1;
         }

      else if (dh > 50000000 && dh < 150000001 )
        { dh1 = (dh *3) / 200 + 10000 + random(2000);
             year = dh1 / 1000;
             day  = (dh1 - year * 1000) / 4;
             hour = (dh1 - year * 1000 - day * 4) * 3; 
          xw1 = 40 + random(40);
          qn1 = 300000 + random(100000);
          who->add("combat_exp",dh1);
          who->add("max_mana",  xw1);
          who->add("max_force", xw1);
          who->add("potential", qn1);
          message_vision(HIR"$N得到了"+ chinese_number(year) + "年" + chinese_number(day) + "天" 
                                      + chinese_number(hour) + "时辰的道行奖励！\n"
                                      + "$N得到了"+ chinese_number(xw1)  + "点最大法力内力奖励！\n"
                                      + "$N得到了"+ chinese_number(qn1)  + "点潜能奖励！\n\n"NOR,who);
          destruct(this_object());
          return 1;
         }

      else if (dh > 3456000 && dh < 50000001 )
        { dh1 = (dh *3) / 200 + 30000 + random(2000);
             year = dh1 / 1000;
             day  = (dh1 - year * 1000) / 4;
             hour = (dh1 - year * 1000 - day * 4) * 3; 
          xw1 = 30 + random(40);
          qn1 = 200000 + random(100000);
          who->add("combat_exp",dh1);
          who->add("max_mana",  xw1);
          who->add("max_force", xw1);
          who->add("potential", qn1);
          message_vision(HIR"$N得到了"+ chinese_number(year) + "年" + chinese_number(day) + "天" 
                                      + chinese_number(hour) + "时辰的道行奖励！\n"
                                      + "$N得到了"+ chinese_number(xw1)  + "点最大法力内力奖励！\n"
                                      + "$N得到了"+ chinese_number(qn1)  + "点潜能奖励！\n\n"NOR,who);
          destruct(this_object());
          return 1;
         }

      else if (dh < 3456001 )
        { dh1 = dh / 50 + 30000 + random(2000);
             year = dh1 / 1000;
             day  = (dh1 - year * 1000) / 4;
             hour = (dh1 - year * 1000 - day * 4) * 3; 
          xw1 = 40 + random(40);
          qn1 = 150000 + random(100000);
          who->add("combat_exp",dh1);
          who->add("max_mana",  xw1);
          who->add("max_force", xw1);
          who->add("potential", qn1);
          message_vision(HIR"$N得到了"+ chinese_number(year) + "年" + chinese_number(day) + "天" 
                                      + chinese_number(hour) + "时辰的道行奖励！\n"
                                      + "$N得到了"+ chinese_number(xw1)  + "点最大法力内力奖励！\n"
                                      + "$N得到了"+ chinese_number(qn1)  + "点潜能奖励！\n\n"NOR,who);
          destruct(this_object());
          return 1;
         }
    }
}

