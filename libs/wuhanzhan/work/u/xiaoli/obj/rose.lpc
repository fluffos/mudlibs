#include <ansi.h>
#include <armor.h>
inherit CLOTH;


void create ()
{
  set_name(HIR "九百九十九"+HIC+"朵"+HIM+"玫瑰" NOR, ({ "rose"}));
  set_weight(100);
  set("long","色彩艳丽的"+query("name")+"。\n");
  set("unit", "把");
   set("material", "steel");
  set("armor_prop/armor", 1);
  set("armor_prop/personality", 10);
  set("unequip_msg","$N将"+query("name")+"轻轻地摘下来……。\n");
  set("wear_msg", "$N戴上"+query("name")+"，不禁想起年少时曾经的梦中人。\n");
  setup();
}



