#include <ansi.h>
inherit ROOM;

void create()
{
        set("short","聊天室");
        set("long",@LONG

    一个聊天的地方。
    这里没有任何设施。

LONG );
      set("no_time",1);
        set("exits",([ 
                "south":"/d/city/kezhan" ,
                     ]));

        setup();
}

void init()
 {      object me = this_player();
        message_vision("$N进入本聊天室。\n", me);

        add_action("do_no",({"exercise","meditate","practice","learn","cast",
                             "ji","exert","perform","kill","fight","mark","xiudao",
                             "pot","slap","slap1","woman","gun","ba","kao","kao2","die3",
                             "kick","kick1","kick2","kick3","kick4","kick5","kick6","kick7",        
                            }));
 }

int do_no(string arg) {
  write("请不要在这里做儿童不宜的动作，谢谢。:)\n");
  return 1;
}
