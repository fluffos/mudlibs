// jindan.c 补偿金丹
// 玩家可以bian coin以后，被人get再eat tao。

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
                                 
  add_action("do_eat", "eat");
}

void create()
{
  set_name(HIM "补偿金丹" NOR, ({"buchang jindan","jindan","dan"}));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "对于上次档案被丢失的原因,我挟全体wiz向你道歉。\n");
    set("value", 5000);
    set("drug_type", "补品");
                set("no_sell",1);
                set("no_drop",1);
                set("no_put",1);
        }
  
        setup();
}

int do_eat(string arg)
{

        object me = this_player();  
        if (!id(arg)) return notify_fail("你要吃什么？\n");
        if(userp(me)&& (me->query_temp("d_mana"))>0)
            return notify_fail("你现在的状态不适合吃这么贵重的东西！\n");
 
        me->set("food", (int)me->max_food_capacity());
        if((int)me->query("max_force")<10*(int)me->query_skill("force")){
        me->add("max_force",10);
        }
        if((int)me->query("max_mana")<10*(int)me->query_skill("spells")){
        me->add("max_mana",10);
        }

        message_vision(HIY "$N吃下一颗补偿金丹，失去的数据似乎有所恢复！ \n" NOR, me);

        destruct(this_object());

        return 1;
}       

