// dunjia.c 
#include <armor.h>
#include <ansi.h>

inherit ARMOR;
inherit F_UNIQUE;

void create() {
  set_name(HIY "奇门遁甲" NOR, ({ "qimen jia", "dunjia", "jia", "armor" }));
  set_weight(40000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "道家的法器，一件神奇的宝甲。\n");
    set("wear_msg", "$N穿上了了$n，大声叫道：奇门飞甲出窍！\n");
    set("remove_msg", "$N脱下了$n，飞甲的光芒散去！\n");
    set("material", "gold");
    set("value", 3000);
    set("armor_prop/armor", 20);
    set("armor_prop/dodge", 200);
    set("armor_prop/armor_vs_force", 200);
    set("armor_prop/armor_vs_spells", 500);
    set("replace_file", "/d/obj/armor/tiejia");
  }
  setup();
}

void init() {
  if (this_player()->query("family/family_name") != "盘丝洞") {
    remove_call_out("free_dunjia");
    call_out("free_dunjia", 12, this_object(), this_player());
  }

  ::init();
}

void free_dunjia(object ob, object who) {
  if (who->query("family/family_name") != "盘丝洞") {
    tell_object(who, HIR "你仿佛听到有人说：非盘丝洞门人，此甲何以用的。\n"
      + "随着一声轻响，奇门遁甲已腾空而去，不留下一丝痕迹。\n\n" NOR);
    destruct(ob);
  } else {
    call_out("free_dunjia", 12, ob, who);
  }
  return;
}
