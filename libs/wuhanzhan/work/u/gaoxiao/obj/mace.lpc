#include <weapon.h>
#include <ansi.h>

inherit MACE;

void create()
{
  set_name(HIW "大力锏" NOR, ({"dali mace", "mace", "jian"}));
  set_weight(10000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 20000);
    set("material", "gold");
    set("long", "燕赤侠的随身武器，此锏又大又长，看起来似乎很重。\n");
    set("wield_msg", "$N抽出了$n，大声叫道：嘛呢嘛呢轰；风火雷电劈！\n");
    set("unwield_msg", "$N收起了$n，长吁了一口气道：这锏还真是重啊！\n");
  }
  
  init_mace(150);
  setup();
}

