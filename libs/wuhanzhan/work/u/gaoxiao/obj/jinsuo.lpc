#include <weapon.h>
 :inherit WHIP;
#include <ansi.h>
inherit F_UNIQUE; 

void create()
{
   set_name(HIW"银索"NOR+HIY"金玲"NOR, ({"yinsuo jinling","whip"}));
   set_weight(150);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "条");
     set("long", "紫霞仙子送给孙悟空的信物，在阳光下金光闪闪。\n");
     set("material", "brass");
     set("no_sell", 1);
     set("no_drop", 1);
     set("no_put", 1);
     set("no_steal", 1);
     set("replace_file", "/d/obj/weapon/whip/tielian");
     set("wield_msg", HIW"$N将$n"HIW"自手腕上取出，叮叮当当的胜是好听。\n"NOR);
     set("unwield_msg", HIW"$N将$n"HIW"收回腕上，叮叮当当的声音顿时散去。\n"NOR);
   }
   init_whip(200);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
       if(me->query_skill("whip",1)<450)
        me->improve_skill("whip",random(20));
                switch(random(2)) {
                        case 0: return "$w"HIC"的金索发出叮叮当当的声音！\n"NOR;
                        case 1: return "$w"HIC"在阳光的照射下，金光闪闪……！\n"NOR;
                      }        
}

