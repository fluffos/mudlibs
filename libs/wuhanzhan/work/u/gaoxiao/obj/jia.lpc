// dunjia.c
#include <armor.h>
#include <ansi.h>

inherit ARMOR;

void create() {
  set_name(HIY "奇门遁甲" NOR, ({ "qimen jia", "dunjia", "jia", "armor" }));
  set_weight(40000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "道家的法器，一件神奇的宝甲。\n");
    set("wear_msg", "$N穿上了了$n，大声叫道：奇门飞甲出窍！\n");
    set("remove_msg", "$N脱下了$n，飞甲的光芒散去！\n");
    set("value", 3000);
    set("material", "gold");
    set("armor_prop/armor", 20);
    set("armor_prop/dodge", 200);
    set("armor_prop/armor_vs_force", 200);
    set("armor_prop/armor_vs_spells", 500);
  }
  setup();
}
