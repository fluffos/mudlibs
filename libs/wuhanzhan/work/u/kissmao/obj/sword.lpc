#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
    set_name(HIY"石头剑"NOR, ({ "jian", "stone","sword" }) );
    set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", HIY"这是天下第一利器，有“小石不出，谁与争锋”之说。\n"NOR);
                set("value", 500000); 
                set("no_sell", 1);
                set("no_give", 1);
                set("no_get", 1);
                set("no_put", 1);              
                set("no_drop", "1");
                set("material", "steel");
                }
                set("wield_msg",HIY"直如矫龙吞水，长虹冠日一般，$n"HIR"已在$N手中，
天地间为之变色。\n"NOR);
                set("unwield_msg", HIY"$N将$n"HIR"插回腰间，华光顿敛，天地间只闻龙鸣。\n"NOR);
                init_sword(200);
        setup();  
  }
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
       if(me->query_skill("sword",1)<450)
        me->improve_skill("sword",random(20));
                switch(random(2)) {
                        case 0: return "$w"HIB"突然石气阵阵,道出条条剑气！\n"NOR;
                        case 1: return "$w"HIW"发出摄人心魄的光芒！\n"NOR;
 }        
}  


