#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE; void init();
int do_read(string arg);

void create() {
  set_name(HIY "〖鞭法之最〗" NOR, ({ "whip book", "book", "shu" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      HIY "这本书记载了镇魔大元帅李靖一生的鞭法心得体会。\n" NOR);
    set("material", "paper");
    set("value", 500);
    set("no_get", 1);
    set("no_put", 1);
    set("no_give", 0);
    set("no_sell", 1);
    set("no_drop", 1);
  }
}

void init() {
  add_action("do_read", "du");
  add_action("do_read", "study");
  add_action("do_read", "read");
}

int do_read(string arg) {
  object me;
  int sen_cost, gain;

  me = this_player();

  if (!this_object()->id(arg)) return 0;
  if ((string)me->query("family/family_name") != "天王府")
    return notify_fail("偷看天王府秘籍，你想死啊……\n");
  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有空闲读书...\n");
  if (me->is_fighting())
    return notify_fail("打架时还看书？\n");

  if ((int)me->query_skill("literate", 1) < 100)
    return notify_fail("你读了半天，却不明白是什么意思，大概你理解能力太差了。\n");

  if ((int)me->query_skill("whip", 1) > 400 || (int)me->query_skill("duanyun-bian", 1) > 400)
    return notify_fail("你在鞭法方面已经举世无双了，这本书不会让你长进多少。\n");

  sen_cost = 100 + (35 - (int)me->query("int"));
  if ((int)me->query("sen") < sen_cost)
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");
  me->receive_damage("sen", sen_cost);

  gain = (int)me->query_skill("literate", 1) / 10 + (int)me->query("int") + 1;
  me->improve_skill("whip", gain);
  me->improve_skill("duanyun-bian", gain / 2);

  message_vision("$N仔细研究鞭法之最,似乎有所体会。 \n", me);

  return 1;
}
