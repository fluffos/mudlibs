#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "新人礼物" NOR, ({ "liwu", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", HIY "这是一棵新人礼物\n" NOR);
    set("value", 0);
    set("no_get", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("no_sell", 1);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  this_player()->add("combat_exp", 100000);
  this_player()->add("potential", 20000);
  this_player()->add("max_force", 100);
  this_player()->add("max_mana", 100);
  message_vision("$N吃下一棵新人礼物，只觉得自己又变利害了一些 !\n", this_player());
  destruct(this_object());
  return 1;
}
