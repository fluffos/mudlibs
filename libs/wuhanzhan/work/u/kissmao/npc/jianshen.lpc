#include <ansi.h>
inherit NPC;

void create() {
  set_name("剑神", ({ "jian shen", "long", "dragon", "jianshen" }));
  set("long", "这是一位来自蜀山的剑神，专门担任护法之责。\n");
  set("attitude", "friendly");
  set("max_gin", 1000);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("max_force", 800);
  set("force", 1000);
  set("force_factor", 30);
  set("max_mana", 800);
  set("mana", 1000);
  set("mana_factor", 30);
  set("str", 30);
  set("cor", 30);
  set("cps", 25);
  set("combat_exp", 300000);
  set_skill("sword", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("lingjian-shi", 150);
  set_skill("lingjian-step", 150);
  map_skill("dodge", "lingjian-step");
  map_skill("sword", "lingjian-shi");
  map_skill("parry", "lingjian-shi");
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/sword/feijian")->wield();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIY + name() + "说道：小仙奉法主召唤，现在已经完成护法任务，就此告辞！\n\n"
    +name() + "化成一道金光，飞上天际消失不见了。\n" NOR, environment(),
    this_object());
  destruct(this_object());
}

void invocation(object who) {
  int i;
  object *enemy;
  message("vision",
    HIY "一道金光由天而降，金光中走出一威风凛凛的剑神。\n\n"
    +name() + "说道：小仙奉法主召唤，特来护法！\n" NOR,
    environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
}
