// 审讯室

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
     set("short",HIR"审讯室"NOR);
     set("long",
   "                                   \n"
"                                 "+HIC+""+HIY+"坦              抗\n"+NOR+""
"                                 "+HIC+""+HIY+"白              拒\n"+NOR+""
"                                 "+HIC+""+HIY+"从              丛\n"+NOR+""
"                                 "+HIC+""+HIY+"宽              严\n"+NOR+""
);

   set("valid_startroom", 1);

   setup();
}

void init()
{   
   if (!wizardp(this_player())) {
          this_player()->set("startroom","/u/ken/lock");
     this_player()->save();
     add_action("block_cmd","",1);      
   }
   call_out("hehe", 2, this_player());
}

int block_cmd()
{
        string verb = query_verb();

        if (verb=="say") return 0; //allow say
           if (verb=="help") return 0;
   if (verb=="look") return 0;
   if (verb=="out") return 0;
   return 1;
}

void hehe()
{
        tell_room(environment(this_player()), "\n"+
     "脚落里发出一阵阵鬼哭声！\n"+
     "你感觉周围有双眼睛盯着你！\n"+
     "夜影对你狂笑道：再不招就砍你的档了！\n");
        return;
}
