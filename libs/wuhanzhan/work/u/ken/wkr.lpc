  set("short", HIW "天涯海阁" NOR);
  set("long",
    "                                   \n"
    "                                             " + BBLU + "" + HIY + "\n\n\n\n\n" + NOR + ""
    "" + BLINK + " " + HIC + "                                                 ..\n" + NOR + ""
    "" + HIC + "                 .\n" + NOR + ""
    "" + HIC + "..\n" + NOR + ""
    "" + HIC + "                                         .. ..\n" + NOR + ""
    "" + BLINK + "" + HIC + "                     .  ...       .\n\n\n\n\n\n" + NOR + ""
    "" HIY + "                                        你总算艰难地上来了……\n" + NOR + ""
    "" + HIW + "                                       一阵清风吹得你衣带飘飘，心智也登时大为空灵起来。\n\n\n\n" + NOR + ""
    "                        " + BLINK + "" + HIY + "天涯海阁" + NOR + "                 ^^\n"
    "" + HIW + "这座<<天涯海阁>>高九层，高耸入空，祥云漠漠，乃天下第一奇观。\n" + NOR + ""
