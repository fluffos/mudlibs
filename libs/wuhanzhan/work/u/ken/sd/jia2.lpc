#include <armor.h>
#include <ansi.h>
inherit ARMOR;
inherit F_UNIQUE;
void create() {
  set_name(HIY "古代盔甲" NOR, ({ "super armor", "armor" }));
  set("long", "这是一件古代盔甲，据说是黄帝用过的甲胄。\n");
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "gold");
    set("armor_prop/armor", 999);
    set("armor_prop/armor_vs_force", 2000);
    set("armor_prop/armor_vs_spells", 2000);
    set("armor_prop/dodge", 200);
    set("armor_prop/parry", 200);
    set("need_level", 30);
    set("replace_file", "/d/obj/armor/jinjia");
    set("value", 50000);
  }
  setup();
}
