//modify by ken 2001.7.2
#include <ansi.h>
inherit ITEM;
int do_eat(string);
void init();

void init()
{
        if (!wizardp(this_player())) {
                set("no_get", "嘿嘿，做梦吧! \n");
                set("no_drop","此物千年难求，丢弃不免太可惜了吧。 \n");
                set("no_sell","掌柜说道：小店本小力薄，还是请回吧。\n");
                set("no_give","此物怎能随便给人？\n");
        }
                                              
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR "火龙内丹" NOR, ({"huolong neidan", "dan"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long", "一颗冒着红光的丹药，内含有万年火龙的内丹精华。\n");
                set("value", 100000);
        }

        set("is_monitored", 1);
        setup();
}

int do_eat(string arg)
{
        object victim = this_player();
        int abc;


        if (!id(arg))
                return notify_fail("你要吃什么？\n");
//        if(victim->query("family/family_name") != "魔教")
//                return notify_fail("你最好是别吃，小心中了毒．\n");

        abc = (int)victim->query("AMA_eat");
            if ( abc > 99 ) 
     {
     message_vision(HIR "$N吃下一颗火龙丹，只觉得腹内传来一阵撕心裂肺般的剧痛.......\n" NOR, victim); 
       victim->unconcious();
       victim->die();
       destruct(this_object());
      }
    else
    {
        victim->add("combat_exp", (int)victim->query("combat_exp") / 90);
        victim->add("max_mana",30);
        victim->add("max_force",30);
        victim->add("force",9999);
        victim->add("mana",9999);
        victim->add("AMA_eat",1);
        victim->skill_death_recover();
        victim->save();
        message_vision(HIG "$N吃下一粒火龙丹，只觉全身上下说不出的舒服。\n" NOR, victim);
        destruct(this_object());
        return 1;
  }
}
