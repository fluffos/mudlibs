//Ken@_@
#include <ansi.h>
#include <weapon.h>
inherit	BLADE;
void create()
{
	set_name( BLK "井中月" NOR,	({ "dragonblade"}) );
	set_weight(70000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long","一把闪着丝丝黑光的宝刀，非常的值钱。\n");
		set("value", 80000);
                set("material", "steel");
                set("need_level", 12);
		set("wield_msg", "$N装备$n做武器。\n");
		set("unwield_msg", "$N收起$n放回了包袱。\n");
	}

	init_blade(220);
	setup();

}

mixed hit_ob(object me,	object victim, int damage_bonus)
{
	int pro;
	int dam;
	dam = (int) me->query("force");
        victim->receive_damage("Kee",dam/70);
	return HIR "井中月对$n造成一定的附加伤害。\n" NOR;
}
