//ken@wh
#include <ansi.h>
#include <weapon.h>
inherit AXE;
inherit F_UNIQUE;
void destroy();

void init() {
  call_out("destroy", 24000);
}
void create() {
  set_name(HIC "八卦宣花斧" NOR, ({ "bagua xuanhua fu", "fu", "axe" }));
  set_weight(70000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",

      "一把闪着寒光的巨斧，长约九尺一分，斧头上刻着两个八卦印．\n"
    );
    set("value", 18000);
    set("material", "steel");
    set("replace_file", "/d/obj/weapon/axe/huafu");
    set("need_level", 15);
    set("wield_msg", "$N拿出一把$n握在手中，眼角闪过一道寒光．\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_axe(200);
  setup();

}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  victim->receive_damage("kee", dam / 50);
  victim->start_busy(1);
  return HIC "八卦斧上冒出一股浓郁的杀气，逼的$n睁不开眼！\n" NOR;
}

void destroy() {
  message_vision(
    "只听＂嗡＂的一声巨响" + (string)this_object()->query("name") + "化成一片飞灰．\n",
    environment(this_object())
  );
  destruct(this_object());
}
