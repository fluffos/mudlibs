#include <ansi.h>
#include <armor.h>
inherit FINGER;
void create()
{
  set_name(BLK "力量戒指" NOR, ({"power ring", "ring"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "gold");
    set("unit", "个");
    set("value", 1000);
    set("armor_prop/armor", 80);
    set("armor_prop/armor_vs_force", 400);
    set("need_level", 20);
  }
  setup();
}

