//modify by ken 2001.7.2
#include <ansi.h>
inherit ITEM;
int do_eat(string);
void init();

void init()
{
        if (!wizardp(this_player())) {
                set("no_give","此物怎能随便给人？\n");
        }
                                              
        add_action("do_eat", "eat");
}

void create()
{
        set_name(RED "老鼠药" NOR, ({"rat yao", "yao"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "瓶");
                set("long", "上面写着‖剧毒‖，小心使用。\n");
                set("value", 100000);
        }

        set("is_monitored", 1);
        setup();
}

int do_eat(string arg)
{
        object victim = this_player();
        int abc;


        if (!id(arg))
                return notify_fail("你要吃什么？\n");
//        if(victim->query("family/family_name") != "魔教")
//                return notify_fail("你最好是别吃，小心中了毒．\n");

        abc = (int)victim->query("AMA_eat");
            if ( abc > 99 ) 
     {
     message_vision(HIR "$N吃下一颗火龙丹，只觉得腹内传来一阵撕心裂肺般的剧痛.......\n" NOR, victim); 
       victim->unconcious();
       victim->die();
       destruct(this_object());
      }
    else
    {
        victim->apply_condition("evil_fire_poison", 100)
        message_vision(HIY "$N一咬牙，猛的把老鼠药往口里一塞；只觉得腹内传来一阵撕心裂肺般的剧痛.......。\n" NOR, victim);
        victim->unconcious();
        destruct(this_object());
        return 1;
  }
}
