#include <ansi.h>
#include <armor.h>
inherit HEAD;

void create()
{
  set_name(BLK "黑铁战盔" NOR, ({"blackiron helm", "helm"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
                set("material", "steel");
                set("value", 10000);
                set("armor_prop/armor", 155);
                set("need_level", 15);
        }
        setup();
}

