//lmd@wenxin
#include <ansi.h>
#include <weapon.h>
inherit BLADE;
inherit F_UNIQUE;
void destroy();
void init()
{
     call_out("destroy", 36000);
}
void create()
{
        set_name( HIG "小楼一夜听春雨" NOR, ({ "springrain blade","blade","dao" }) );
        set_weight(70000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",
"一把闪着寒光的宝刀，是传说中三大神兵之一．\n"
);
                set("value", 18000);
                set("material", "steel");
     set("replace_file","/d/obj/weapon/blade/blade");
                set("wield_msg", "$N抽出一把寒气逼人的$n握在手中。\n");
        }
        init_blade(120);
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("kee",dam/50);
         me->add("bellicosity",50);
        victim->start_busy(1);
        return HIR "$N眼中印着＂小楼一夜听春雨＂闪出的诡异红光！！！\n" NOR;
}
void destroy()
{
        message_vision("天空传来一声怒吼：＂还我刀来＂！" + (string)this_object()->query("name") + "飞向天空，转眼就不见了。\n", environment(this_object()));
        destruct(this_object());
}
