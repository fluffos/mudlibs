#include <armor.h>
#include <ansi.h>
inherit ARMOR;
inherit F_UNIQUE;
void create()
{
   set_name(HIG"战神盔甲"NOR, ({ "War armor", "armor" }) );
   set("long", "战神盔甲，防御性能超群。\n");
   set_weight(45000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "steel");
     set("armor_prop/armor", 200);
     set("armor_prop/armor_vs_force", 1000);
     set("armor_prop/armor_vs_spells", 1000);
     set("armor_prop/dodge",100);
     set("armor_prop/parry",100);
     set("need_level", 25);
     set("replace_file", "/d/obj/armor/jinjia");
     set("value", 50000);
        }
    setup();
}
