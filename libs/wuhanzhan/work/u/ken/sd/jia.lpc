#include <armor.h>
#include <ansi.h>
inherit ARMOR;
inherit F_UNIQUE;
void destroy();
void init() {
  call_out("destroy", 9000);
}
void create() {
  set_name(HIY "古代盔甲" NOR, ({ "super armor", "armor" }));
  set("long", "这是一件古代盔甲，据说是黄帝用过的甲胄。\n");
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "gold");
    set("armor_prop/armor", 300);
    set("armor_prop/armor_vs_force", 600);
    set("armor_prop/armor_vs_spells", 600);
    set("need_level", 20);
    set("armor_prop/dodge", 80);
    set("armor_prop/parry", 80);
    set("replace_file", "/d/obj/armor/jinjia");
    set("value", 50000);
  }
  setup();
}


void destroy() {
  message_vision(
    "只听一声巨响，" + (string)this_object()->query("name") + "片片碎落，随风而去了。\n",
    environment(this_object())
  );
  destruct(this_object());
}
