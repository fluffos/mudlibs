//Ken@_@
#include <ansi.h>
#include <weapon.h>
inherit	STAFF;
inherit F_UNIQUE;
void create()
{
        set_name( BLK "裁决之杖" NOR,   ({ "judgement mace"}) );
	set_weight(70000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long","一把闪着丝丝黑光的权杖，非常的值钱。\n");
		set("value", 280000);
                set("material", "steel");
                set("need_level", 15);
     set("replace_file", "/d/obj/weapon/stick/xiangmo-bang.lpc");
		set("wield_msg", "$N装备$n做武器。\n");
		set("unwield_msg", "$N收起$n放回了包袱。\n");
	}

	init_staff(300);
	setup();

}

mixed hit_ob(object me,	object victim, int damage_bonus)
{
	int pro;
	int dam;
	dam = (int) me->query("force");
        victim->receive_damage("kee",dam/50);
	return HIR "裁决之杖对$n造成很大的附加伤害。\n" NOR;
}
