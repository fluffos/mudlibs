#include <ansi.h>
#include <armor.h>
inherit NECK;
void create()
{
  set_name(HIG "绿色项链" NOR, ({"Greed necklace", "lian"}));
  set_weight(200);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "golden");
    set("unit", "件");
    set("value", 200000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("armor_prop/armor", 60);
    set("need_level", 10);
  }
  setup();
}
