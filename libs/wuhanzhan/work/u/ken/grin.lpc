inherit ROOM;
#include <room.h>
void create() {
  set("short", "澡堂");
  set("long", @LONG
这里就是澡堂了，在这里舒舒服服的洗上一个澡的话，的确是件高兴事
LONG
  );
  set("exits", ([
    "north": __DIR__ "gameroom",
  ]));
  set("no_magic", 1);
  setup();
}

void init() {
  add_action("do_pa", "pa");
}

int do_pa() {
  object me;
  int wait;
  me = this_player();
  if (me->query_temp("washing")) {
    tell_object(me, "你已经在洗了！\n");
    return 1;
  }
  wait = random(40 - (int)(me->query("con")));
  if (wait <= 10) wait = 11;
  message_vision("$N噗嗵一声跳进澡池里。\n", me);
  tell_object(me, "你感到全身无比的舒泰．．\n");
  me->set_temp("washing", 1);
  call_out("curehimup", wait, me);
  return 1;
}

void curehimup(object me) {
  int kee, sen;
  if (!me) return;
  kee = (int)me->query("max_kee");
  sen = (int)me->query("max_sen");
  if (me && environment(me) == this_object()) {
    message_vision("$N痛痛快快的洗了个大澡，浑身上下充满了活力！\n", me);
    me->set("eff_kee", kee);
    me->set("eff_sen", sen);
    me->set("sen", sen);
    me->set("kee", kee);
  }

  me->delete_temp("washing");
  return;
}
