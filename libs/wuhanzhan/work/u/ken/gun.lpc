// gun.c

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void init() {
  add_action("do_aim", "aim");
  add_action("do_shoot", "shoot");
}

void create() {
  set_name("M72-高司电磁枪", ({ "ruife gun", "qiang", "gun" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("bullet", 20);
    set("value", 50000);
    set("material", "steel");
    set("long", "这种枪械是由德国斯特杨公司设计制造，发射.2MMc超高速钛合金子弹，
利用电磁加速，能够击穿170MM的钢板，加上最先进的射电红外线夜视镜，
威力无比，也是职业杀手们最爱用的狙击枪。");
    set("wield_msg", "$N把一柄$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n背到肩上，脸上露出一丝笑容。\n");
  }
  init_sword(1);
  setup();
}

int do_aim(string arg) {
  object me, obj;

  if (arg == "ken") return 1;

  me = this_player();

  if (!arg)
    return notify_fail("你想杀谁？\n");

  if (this_object()->query("bullet") <= 0)
    return notify_fail("子弹已经打光了。\n");

  if (obj == me)
    return notify_fail("用 suicide 指令会比较快:P。\n");

  message_vision(RED "\n$N端起手中的M72，准确无误的瞄准了$n的头部，\n\n" NOR,
    me, obj);

  set_temp("target", arg);

  return 1;
}

int do_shoot() {
  object me, obj;
  string arg;

  me = this_player();

  if (!(arg = this_object()->query_temp("target")))
    return notify_fail("你还没有瞄准你的射击目标！\n");

  message_vision(RED "\n$N瞄准$n的头部，冷静的抠动了扳机。\n只见$n的头部暴出一团血雾，$n还来不及发出惨叫，就倒在了血泊中。\n\n" NOR, me, obj);

  this_object()->add("bullet", -1);
  obj->set_temp("last_damage_from", "被" + me->name() + "枪杀");
  obj->set_temp("death_msg", "被" + me->name() + "暗杀了。\n");
  obj->delete("env/immortal");
  obj->die();
  delete_temp("target");

  return 1;
}
