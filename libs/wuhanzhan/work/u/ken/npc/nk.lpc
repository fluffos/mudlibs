// modify by ken 2001.5.1
//专门杀PKER!!
#include <ansi.h>
inherit NPC;
void create()
{
   set_name("大刀卫士", ({ "Guard", "madman", "man","nk", }));
   set("gender", "男性");
   set("age", 37);
   set("long", @LONG
专门杀PKER，碰上他绝对是死路一条。
LONG);
   set("attitude", "friendly");
   set("rank_info/self", "子");
   set("class", "fight");
   set("str",1000);
   set("cps",1000);
   set("cor",1000);
   set("max_kee", 50000);
   set("max_sen", 50000);
   set("max_mana", 50000);
   set("max_force", 50000);
   set("force", 90000);
   set("mana", 90000);
   set("force_factor", 2000);
   set("mana_factor", 2000);
   set("combat_exp", 80000000);
   set_skill("spells", 800);
   set_skill("tianmo", 800);
   set_skill("unarmed", 800);
   set_skill("nine-moon-claw", 800);
   set_skill("dodge", 800);
   set_skill("blade", 800);
   set_skill("shenji-steps", 800);
   set_skill("tianmo-blade", 800);
   set_skill("parry", 800);
   set_skill("lengquan-force", 800);
   map_skill("spells", "tianmo");
   map_skill("unarmed", "nine-moon-claw");
   map_skill("dodge", "shenji-steps");
   map_skill("force", "lengquan-force");
   map_skill("parry", "tianmo-blade");
   map_skill("blade", "tianmo-blade");
   set("chat_chance_combat", 80);
   set("chat_msg_combat", ({
     (: cast_spell, "lei" :),
     (: perform_action, "blade", "tianmoduzun" :),

   }) );
   setup();
   carry_object("/u/ken/obj/long-blade")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}



void init()
{
	object me, ob;
	ob = this_player();
	me = this_object();
	
	::init();

	if ( interactive(ob) && !environment(ob)->query("no_fight") )
	{
		if ( ob->query("killers") == 1 )
		{
			if ( random(2) ==1 )
			command("say 你这败类，竟敢草菅人命，纳命来！\n");
			me->set_leader(ob);
			remove_call_out("kill_ob");
			call_out("kill_ob", 1, ob); 
		}       
		if ( ob->query("killers") >= 2 )
		{
			if ( random(2) ==1 )
			command("say 你这败类，竟敢草菅人命，纳命来！\n");
			me->set_leader(ob);
		}       
	}
}
