#include <ansi.h>
inherit NPC;
void create() {
  set_name("李公公", ({ "li gg", "li" }));
  set("gender", "无性");
  set("title", "大太监");
  set("age", 65);
  set("long",
    "他就是净事房的大总管，专门为人净身。");
  set("str", 100);
  set_skill("unarmed", 30);
  set_skill("blade", 200);
  set("combat_exp", 1050000);
  set("attitude", "friendly");
  set("inquiry", ([
    "name": "在下李公公。",
  ]));
  setup();
  set("chat_chance", 60);
  set("chat_msg", ({
    "李公公阴阳怪气的对你说道：想发达入宫就行了，就看你舍不舍得你那宝贝。\n",
    "李公公说道：其实一点也不疼，手起刀落，快的很。\n",
    "李公公对你说道：想不想入宫哪，一边又盯着你瞧个不停。\n",
  }));
  carry_object("/d/obj/cloth/choupao")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_sell", "sell");
}

void greeting(object me) {
  object *ob;
  int found, i;

  found = 0;

  if (me->query("taijian")) {
    command("say " + me->name() + "，你不到宫里跑这干什么！");
    return;
  }
  if (me->query("gender") != "无性") {
    ob = all_inventory(environment());
    for (i = sizeof(ob) - 1; (i >= 0) && !found; i--) {
      if (!userp(ob[i])) continue;
      if (ob[i]->query("taijian")) {
        found = 1;
        command("say " + ob[i]->name() + "，你还不走，给人看笑话哪！ ");
        command("slap " + ob[i]->query("id"));
      }
    }
  }
  return;
}
int do_sell(string arg) {
  object ob;
  int value, str, extra = 1;

  string *name1s = ({
    "小" });
  string *name2s = ({
    "春", "桂", "冬", "二", "玄", "黑", "三", "虾", "六" });
  string *name3s = ({
    "子" });

  string nick;
  if (!arg || !(ob = present(arg, this_player())))
    return notify_fail("你要卖谁？\n");

  if (!ob->is_character())
    return notify_fail("这你得卖到当铺去。\n");

  if (ob->query("gender") != "男性")
    return notify_fail("你脑子没问题吧，女人怎么做太监。\n");

  if (!userp(ob))
    return notify_fail("对不起，不收。\n");

  if (ob->query("taijian"))
    return notify_fail("你疯了，他本来就是太监，别再折磨人了。\n");

  if ((value = ob->query("age")) < 14)
    return notify_fail("严禁残害幼童。\n");

  str = ob->query("str") * 10000;
  if (ob->query("str") > 27) {
    extra = 10;
    str = ob->query("str") * 50000;
    command("good " + this_player()->query("id"));
    command("say 这家伙真不赖，长的这么壮！\n");
  }
  message(
    "shout",
    HIM "【谣言】某人：" + this_player()->name() + "把" + ob->name() + "卖进了宫里！\n" NOR,
    this_player()
  );
  this_player()->add("balance", str);
  ob->move(this_object());
  nick = name1s[random(sizeof(name1s))] + name2s[random(sizeof(name2s))] + name3s[random(sizeof(name3s))];
  if (ob->query("age") < 18)
    ob->set("title", "小太监");
  else if (ob->query("age") < 25)
    ob->set("title", "太监小头目");
  else if (ob->query("age") < 45)
    ob->set("title", "后宫大总管");
  else ob->set("title", "大太监");
  if (ob->query("str") > 27) {
    ob->set("title", HIR "强壮的太监" NOR);
  }
  ob->set("name", nick);
  ob->set("taijian", 1);
  command("chat 皇宫新到太监" + ob->name() + "，一名，速进宫听命！");
  ob->set("gender", "无性");
  return 1;
}
int accept_object(object me, object obj) {
  if (obj->query("money_id")) {
    if (me->query("taijian")) {
      if (obj->value() >= me->query("combat_exp") * 2) {
        command("say 这个嘛，虽说切了下来了.......还是没坏，装上去还能用吧。");
        command("heihei " + me->query("id"));
        me->delete("taijian");
        me->set("title", me->query("family/family_name") + "第" +
          chinese_number(me->query("family/generation")) +
          "代弟子");
        return 1;
      } else {
        command("say 怎么，想贿赂我呀。");
        command("good " + me->query("id"));
        return 1;
      }
    } else {
      command("say 早该这样了。");
      command("consider " + me->query("id"));
      return 1;
    }
  } else return 0;
}
