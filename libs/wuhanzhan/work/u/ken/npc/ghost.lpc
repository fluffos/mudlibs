  set_temp("apply/attack", 9999);
  set_temp("apply/armor", 9999);
  set("combat_exp", 135743985);
  set("max_mana", 3569);
  set("mana", 3569);
  set("max_force", 3569);
  set("force", 3569);
  set_skill("unarmed", 80);
  set_skill("dodge", 100);
