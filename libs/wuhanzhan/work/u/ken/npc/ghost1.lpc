inherit NPC;

void create()
{
        set_name("恶鬼乙", ({ "ghost", "wandering ghost" }) );
        set("age", 45);
        set("str", 30);
        set("cor", 26);
        set_temp("apply/attack", 1000);
        set_temp("apply/armor", 300);
        set("combat_exp", 135743985);
        set("max_mana", 3569);
        set("mana", 3569);
        set("max_force", 3569);
        set("force", 3569);
        set_skill("unarmed", 80);
        set_skill("dodge", 100);
        set("chat_chance", 10);
        set("chat_msg", ({
                (: random_move :),
        }) );
        setup();
}
int is_ghost() { return 1; }
