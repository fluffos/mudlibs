// hehe 牢房

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
     set("short",HIR"地牢"NOR);
     set("long",
   "                                   \n"
""HIR+"                       地牢.....\n\n\n\n"+NOR+""
""+HIW+"这里就是传说中的地牢了,一年四季不见阳光,四周鬼气森森\n"+NOR+""
""+HIW+"隐隐约约看见无数骷骨散布在牢房的脚落......你心中不禁感到一阵阵的\n"+NOR+""
""+HIW+"发毛.看样子这辈子还能不能活着出去了...\n"+NOR+""
"                                 "+HIC+""+HIY+"坦              抗\n"+NOR+""
"                                 "+HIC+""+HIY+"白              拒\n"+NOR+""
"                                 "+HIC+""+HIY+"从              丛\n"+NOR+""
"                                 "+HIC+""+HIY+"宽              严\n"+NOR+""
"                                 "+HIC+""+HIR+"抵              死\n"+NOR+""
"                                 "+HIC+""+HIR+"抗              路\n"+NOR+""
"                                 "+HIC+""+HIR+"到              一\n"+NOR+""
"                                 "+HIC+""+HIR+"底              条\n"+NOR+""
);

   set("valid_startroom", 1);

   setup();
}
void init()
{   
   if (!wizardp(this_player())) {
          this_player()->set("startroom","/u/ken/lock2");
     this_player()->save();
     add_action("block_cmd","",1);      
   }
   call_out("hehe", 2, this_player());
}

int block_cmd()
{
        string verb = query_verb();

        if (verb=="say") return 0; //allow say
        if (verb=="help") return 0;
        if (verb=="look") return 0;
        if (verb=="out") return 0;
   return 1;
}
void hehe()
{
        tell_room(environment(this_player()), "\n"+
     "你听见地牢脚落里发出一阵阵鬼哭声！\n"+
     "你感觉周围有无数双眼睛盯着你！回头一看什么也没有.\n"+
     "夜影挥舞手中的皮鞭,一面恶狠狠的盯着你！\n");
        return;
}
