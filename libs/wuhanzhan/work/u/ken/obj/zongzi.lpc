/* written by Ken */
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIG "端午节粽子" NOR, ({ "zongxi", "zi" }));
  set_weight(2);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个神奇的粽子，里面不知装的什么玩意。\n");
    set("value", 0);
  }
  setup();
}
void init() {
  if (!wizardp(this_player())) {
    set("no_get", " 嘿嘿，做梦吧! \n");
    set("no_drop", "无聊很生气的看着你，教讯你：乱丢是最大的浪费！ \n");
    set("no_give", " 嘿嘿，做梦吧! \n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_steal", " 抓贼啊！ \n");
  }
  add_action("do_eat", "eat");

}
int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->add("food", 3000);
  me->add("water", 3000);
  me->add("potential", 50000);
  me->add("max_mana", 100);
  me->add("max_force", 100);
  message_vision(HIG
    "$N吃下一个粽子，只觉得一股清凉之气冲满全身，精神不觉一振！ \n" NOR, me);
  destruct(this_object());
  return 1;
}
