// Desgin by ken 08.05.2000
// 青龙郾月刀  又名，<< 冷艳锯 >> 重八十六斤，武圣关羽的爱刀


#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create() {
  set_name(HIG "青龙郾月刀" NOR, ({ "greendragon blade", "blade" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "＂青龙郾月刀＂又名＂<< 冷艳锯 >>＂。重八十六斤，武圣关羽的爱刀。\n");
    set("value", 500000);
    set("material", "sapphire");
    set("rigidity", 500000);
    set("wield_msg", "一道寒光闪过$N手里已多了把$n。\n");
    set("unequip_msg", "$N将手中的$n放回背上的刀鞘。\n");
  }
  init_blade(180);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  me->add("combat_exp", 1000 + random(3000));
  return HIY "$N大吼道：“天地无级，乾坤借法．．．”\n" NOR;
}
