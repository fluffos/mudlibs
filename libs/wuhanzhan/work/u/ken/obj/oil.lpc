// hhd.c

#include <ansi.h>

inherit ITEM;

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name(HIY "印度神油" NOR, ({"sex oil","oil"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long",
		"这是一瓶" HIY"吃了号称“金枪不倒”的"NOR "的印度神油，吃了不知道会......\n");
		set("value", 5000000);
		set("unit", "堆");
		set("no_get", 1);
              set("no_drop", 1);
	}
}

int do_eat(string arg)
{
              int force,mana;
	  object me = this_player();
	 if (!id(arg)) return 0;
              force = (int)me->query("max_force");
              mana  = (int)me->query("max_mana");
        message_vision(HIY "$N小心地服了一瓶"
        +this_object()->query("name")+
        HIY "，“武功”猛然提高。\n"
        NOR,me);
        "/adm/daemons/emoted"->do_emote(me,"puke");
        me->set("force", force*5);
        me->set("mana", mana*5);
        me->set("food", 9999);
        me->set("water", 9999);
          destruct(this_object());
	return 1;
}
