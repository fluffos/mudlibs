#include <armor.h>

inherit ARMOR;

void create() {
  set_name("高科技超级装甲二代", ({ "super armor", "baojia", "jia", "armor" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "采用了钛合金跟陶瓷的新材料的MARK II 型装甲。\n");
    set("material", "steel");
    set("value", 4000000);
    set("armor_prop/armor", 255);
    set("armor_prop/dodge", 120);
    set("armor_prop/unarmed", 120);
  }
  setup();
}
