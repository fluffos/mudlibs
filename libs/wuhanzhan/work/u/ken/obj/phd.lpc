// deagin by ken 9.18.2000
// 判师丹.... 一生仅能吃三次....

inherit F_FOOD;
inherit ITEM;
#include <ansi.h>

void create() {

  set_name(HIC "叛师丹" NOR, ({ "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "神奇丹药，有起死回生之神效．\n");
    set("unit", "颗");
    set("food_remaining", 1);
    set("food_supply", 0);
    set("value", 100000000);
    set("material", "food");
  }
  setup();
}

int finish_eat() {

  object me;
  me = this_player();
  int eatting;

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  eatting = (int)me->query("eatbing");
  if (eatting > 3) {
    message_vision(HIR "$N已吃过三次了，再吃也没有用。\n" NOR, victim);
  } else {
    me->delete("family");
    me->set("title", 普 通 百 姓 名);
    me->delete("class");
    me->set("betrayer", 0);
    me->add("eatbing", 1);
    destruct(this_object());
    return 1;
  }
