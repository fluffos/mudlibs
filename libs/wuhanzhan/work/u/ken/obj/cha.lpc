#include <ansi.h>
#include <weapon.h>
inherit FORK;
void create()
{
        set_name( HIC "九股托天叉" NOR, ({ "tuotian fork", "fork"}) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("material", "iron");
                set("value", 2000000);
                set("long", "用太上老君的九股仙藤拧成，上面还有些奇怪的纂符。\n");
                set("wield_msg", "$N从背后拿出哗啦作响的$n来\n");
                set("unwield_msg", "$N把哗啦作响的$n放回背后。\n");
        }
        init_fork(120);
        setup();
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("kee",dam/2);
        return HIC "$N手中的"+ HIB"“九股托天叉”" + HIC "搅出一道道无边的风波！绕的$n心神不定。\n" NOR;
}
