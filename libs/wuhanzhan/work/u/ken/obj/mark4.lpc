#include <armor.h>

inherit ARMOR;

void create() {
  set_name("高科技超级装甲Nt改进型", ({ "super armor", "baojia", "jia", "armor" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "在MARK II 型装甲的基楚上加了人工智能，能更大的发挥原有的威力。\n");
    set("material", "steel");
    set("value", 8000000);
    set("armor_prop/armor", 400);
    set("armor_prop/dodge", 120);
    set("armor_prop/unarmed", 120);
    set("armor_prop/sword", 120);
    set("armor_prop/whip", 120);
    set("armor_prop/stick", 120);
    set("armor_prop/parry", 120);
    set("armor_prop/blade", 120);
    set("armor_prop/spear", 120);
    set("armor_prop/axe", 120);
    set("armor_prop/mace", 120);
    set("armor_prop/fork", 120);
    set("armor_prop/hammer", 120);
    set("armor_prop/spells", 120);
    set("armor_prop/throwing", 120);
  }
  setup();
}
