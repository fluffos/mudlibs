// literate.c
inherit ITEM;
void create()
{
        set_name("〖碧海神通〗", ({"book"}));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
     set("value", 1000000);
        set("material", "paper");
        set("skill", ([
                        "name": "seashentong",
                        "sen_cost": 25,
                        "difficulty": 25,
                        "max_skill": 300,
]) );
        }
}
