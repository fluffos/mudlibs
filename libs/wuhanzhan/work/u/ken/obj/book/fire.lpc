// literate.c
inherit ITEM;
void create()
{
        set_name("破破烂烂的小册子", ({"book"}));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
     set("value", 100000000);
        set("material", "paper");
        set("skill", ([
                        "name": "bloodsword",
                        "sen_cost": 1,
                        "difficulty": 1,
                        "max_skill": 300,
]) );
        }
}
