// created by ken 2001.2.12
#include <weapon.h>
inherit AXE;
#include <ansi.h>

void create() {
  set_name(HIW "魔·神·斧" NOR, ({ "demon axe", "fu", "axe" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "是天杀星李逵的爱斧，有遇神杀神遇鬼屠鬼的可怕力量，凶暴无比。\n");
    set("value", 100000);
    set("material", "steel");
    set("wield_msg", "天地之间传来阵阵的鬼号，$N手上已多了对$n。\n" NOR);
    set("unwield_msg", "$N放下了$n，收在了身后。\n" NOR);
  }
  init_axe(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {

  int pro;
  int dam;
  dam = (int)me->query("force");
  victim->receive_damage("kee", dam / 1000);
  switch (random(2)) {
    case 0: return "$w冒出一阵阵的魔气，罩住了$n的全身！\n" NOR;
    case 1: return "$w魔光大盛，$n觉得心神不宁。\n" NOR;
  }
}
