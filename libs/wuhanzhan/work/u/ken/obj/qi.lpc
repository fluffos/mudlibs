// created by Xiao@mudsite.yeah.net 1999-02-21 5:58
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(CYN "战斗力探测器" NOR, ({ "tance qi", "qi" }));
  set_weight(500);
  set("unit", "个");

  set("long",
    "这是来自「七龙珠」的赛亚人的最新型战斗力探测器，比上个版本的探测器还要强，\n"
    "它能准确的探测到你的战斗力或可以用它来探测(detect)别人的战斗力。\n");
  set("value", 500);
  set("apply", ([
    "头部": 0,
  ]));
}
void init() {
  add_action("do_detect", "detect");
}

int do_detect(string arg) {
  object ob;
  int sen, sk, intv, strv, agiv, tolv, durv, cpsv, forcev, manav, atmanv;
  string skill;

  if (arg) ob = present(arg, environment(this_player()));
  else ob = this_player()->query_opponent();

  if (!ob) return notify_fail("你要探测谁的战斗力？\n");

  sen = (int)ob->query("sen");
  if (sen <= 0) sen = 1;
  cpsv = (int)ob->query("cps");
  if (cpsv <= 0) cpsv = 1;
  intv = (int)ob->query("int");
  if (intv <= 0) intv = 1;
  strv = (int)ob->query("str");
  if (strv <= 0) strv = 1;
  agiv = (int)ob->query("agi");
  if (agiv <= 0) agiv = 1;
  tolv = (int)ob->query("cps");
  if (tolv <= 0) tolv = 1;
  durv = (int)ob->query("kar");
  if (durv <= 0) durv = 1;
  forcev = (int)ob->query("max_force");
  manav = (int)ob->query("max_mana");
  atmanv = (int)ob->query("max_atman");

  printf("探测器显示%s的战斗力是：%d\n",
    ob->query("name"),
    (intv / 8) * (strv / 8) * (agiv / 8) * (tolv / 8) * (durv / 8) * (cpsv / 8) + sen / 5 +
    (int)ob->query("combat_exp") / 1777 + random(69) + (int)ob->query("potential") / 99 + forcev / 7 + manav / 9 + atmanv / 8);

  return 1;
}
