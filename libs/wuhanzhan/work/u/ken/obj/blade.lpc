#include <ansi.h>
inherit F_UNIQUE;
#include <weapon.h>

inherit BLADE;

void create() {
  set_name(HIR "高惆波砍刀" NOR, ({ "evil blade", "blade", "dao" }));
  set_weight(5000);
  set("unit", "把");
  set("long", "一把深红色的刀，看起来是非常的邪恶．以致于你每次拿起这把刀时
都有要杀人的欲望．\n");
  set("value", 89000);
  set("material", "gold");
  set("replace_file", "/d/mojiao/obj/fireblade");

  init_blade(888);

  if (clonep(this_object())) {
    set_default_object(__FILE__);
  }
  setup();
}
