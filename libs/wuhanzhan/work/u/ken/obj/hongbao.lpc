#include <ansi.h>
inherit ITEM;
void create()
{
    set_name( HIR "新人奖励红包" NOR, ({ "good-hongbao" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
	set("unit", "个");
            set("material", "cloth");
            set("long", "一个神秘的红包,里面的东西是.......\n");
                set("no_get", "送人？亏你想的出来！\n");
//                set("no_put", "珍惜它吧。\n");
                set("no_drop", "如此宝贵的东西再世难求啊。\n");



}
    setup();
}
void init()
{

if(environment()==this_player())
add_action("do_open","open");
}
int do_open(string arg)
{
object gold;
object me;
me=this_player();
if(arg != "good-hongbao" && arg != "新人奖励红包") return 0;
me->add("max_mana",200);
me->add("max_force",200);
me->add("potential",2000);
write(HIC "哇!你被奖励了2000点潜能!还有.........\n\n");
write(HIR "你激动过度...晕了过去!!!\n\n");
	me->unconcious();
destruct(this_object());
return 1;
}
