#include <armor.h>

inherit ARMOR;

void create()
{
        set_name("高科技超级装甲", ({"master spuer armor","baojia", "jia", "armor"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
     set("long", "在超级装甲的基楚上做了较大的改动关节处加了最新的驱动.能较好的保护身体．\n");
                set("material", "steel");
                set("value", 3000000);
                set("armor_prop/armor", 140);
                set("armor_prop/dodge", 100);
                set("armor_prop/unarmed", 100);
        }
        setup();
