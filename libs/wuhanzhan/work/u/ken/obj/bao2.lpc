#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIY "辛苦红包" NOR, ({ "hongbao" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("material", "cloth");
    set("long", "一个神秘的红包,里面的东西是.......\n");
    set("no_drop", "如此宝贵的东西再世难求啊。\n");

    //                set("no_put", "珍惜它吧。\n");
    set("no_get", "送人？亏你想的出来！\n");

  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_open", "open");
}
int do_open(string arg) {
  object gold;
  object me;
  me = this_player();
  if (arg != "hongbao" && arg != "辛苦红包") return 0;
  me->add("potential", 3000);
  write(HIC "由于你的所做所为使巫师对你令眼相看,特奖励你3000点潜能!\n\n");
  destruct(this_object());
  return 1;
}
