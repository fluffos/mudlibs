
// 中秋的的礼品..


#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();
void init()
{
   add_action("do_eat", "eat");
}

void create()
{
   set_name("中秋月饼", ({"moon bing", "bing", "moon"}));
   set_weight(100);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "个");
     set("long", "这东西看起来。。。。。嗯，并不可靠！\n");
     set("drug_type", "补品");
   }
   set("is_monitored",1);
   setup(); 
}

int do_eat(string arg)
{
   int howmany,force,spells,empx,pot;

   object me = this_player();
   if (!id(arg)) return notify_fail("你要吃什么？\n");

   howmany = (int)me->query("gaon");
    if ( howmany > 1 ) 
{
     message_vision(HIW "找死啊！吃多了会要见老崔的。\n" NOR, me); 
}
else
{   message_vision(HIM "【谣言】某人：$N莫名其妙的死了。\n" NOR, me);  
    me->set("gaon",3);
    me->add("max_mana",100);   
    me->add("max_force",100);   
    me->add("potential",66666);
    me->add("combat_exp",8888);
    me->add("food",8813);
    me->add("water",8813);

return 1;
}
   destruct(this_object());
   return 1;
}
