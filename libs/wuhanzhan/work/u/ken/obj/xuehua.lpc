/* xuehua.c 小雪花*/
/* written by Dewey */
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIG "小雪花" NOR, ({ "xiao xuehua", "xue" }));
  set_weight(2);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "一片晶莹剔透的雪花，发出莹莹的光泽。据说只有经过巫师会议表决才能颁发给受奖者！\n");
    set("value", 0);
  }
  setup();
}
void init() {
  if (!wizardp(this_player())) {
    set("no_get", " 嘿嘿，做梦吧! \n");
    set("no_drop", "这么宝贵的雪花，哪能乱扔! \n");
    set("no_give", " 嘿嘿，做梦吧! \n");
  }
  add_action("do_eat", "eat");

}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  //        me->set("qi",(int)this_player()->query("max_qi"));
  //      me->set("jing",(int)this_player()->query("max_jing"));
  //      me->set("eff_qi", (int)this_player()->query("max_qi"));
  //    me->set("eff_jing", (int)this_player()->query("max_jing"));
  //    me->set("jingli",(int)this_player()->query("max_jingli"));
  //      me->set("neili", (int)this_player()->query("max_neili"));
  me->add("food", 3000);
  me->add("water", 3000);
  me->add("potential", 2000);
  me->add("combat_exp", 2000);
  message_vision(HIG
    "$N服下一枚小雪花，只觉得一股清凉之气冲满全身，精神不觉一振！ \n" NOR, me);

  destruct(this_object());
  return 1;
}
