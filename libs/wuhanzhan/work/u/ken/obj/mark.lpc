
#include <armor.h>

inherit ARMOR;

void create()
{
        set_name("超级装甲", ({"super armor","baojia", "jia", "armor"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
     set("long", "此甲是以原子能驱动,能连续不断的运行一百年．\n");
                set("material", "steel");
                set("value", 2000000);
                set("armor_prop/armor", 135);
                set("armor_prop/dodge", 80);
                set("armor_prop/unarmed", 80);
        }
        setup();
}
