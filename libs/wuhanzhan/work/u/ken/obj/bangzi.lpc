#include <weapon.h>
inherit STICK;

void init()
{
       add_action("do_club", "da");
}

void create()
{
        set_name("木棍", ({ "mu gun", "gun" }));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "这是一根普通木棍，看起来十分结实。\n");
                set("value", 0);
                set("material", "wood");
                set("wield_msg", "$N晃动着手中的$n，到处寻找目标。\n");
                set("unwield_msg", "$N收起手中的$n插回腰间。\n");
               set("shaolin",1);
        }
        init_stick(150);
        setup();
}

int do_club(string arg)
{
       object me, ob;
       string name1, name2;

       if (!arg) return notify_fail("你要打谁？\n");
       me = this_player();
       ob = present(arg, environment(me));
       if (!ob) return notify_fail("找不到这个生物.\n");
       name1 = (string)me->query("name");
       name2 = (string)ob->query("name");
       tell_room(environment(me),
       name1+"手舞木棒，对准"+name2+"的后脑一记闷棍，"+name2+"哼也没哼一声，软软的摔倒在地。\n", 
       ({me, ob}));

       tell_object(ob, name1+"手舞木棒，对准你的后脑一记闷棍，你哼也没哼一声，软软的摔倒在地。\n");
       tell_object(me, "你手舞木棒，对准"+name2+"的后脑一记闷棍，"+name2+"哼也没哼一声，软软的摔倒在地。\n");
    
       ob->delete("env/immortal");
       ob->die();
         ob->set_temp("death_msg","被" + name1 +"活活打死了。\n");
             return 1;
}

