#define NULL_VALUE 0
inherit CLOTH;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;
// inherit F_CLEAN_UP;
// inherit NECK;
// inherit CLOTH;
void create()
{
       seteuid(getuid());
       set("long",@LONG
               飞花落叶甲
