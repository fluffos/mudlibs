inherit ITEM;
inherit F_LIQUID;
inherit F_AUTOLOAD;

int query_autoload() { return 1; }
void create()
{
   set_name("金牙", ({"jinya"}));
   set_weight(20);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("long", "这本来属于KEN的金牙，现在它是你的了\n");
     set("unit", "根");
     set("value", 200000);
   }
}
