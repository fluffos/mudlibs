#include <weapon.h>
#include <ansi.h>

inherit DAGGER;

void create()
{
  set_name(RED "炼狱爪" NOR, ({ "hell claw", "zhua", "dagger" }) );
  init_dagger(60);
  set("unit", "根");
  set_weight(300);
  if( clonep() )
     set_default_object(__FILE__);
  else {
    set("value", 123456);
    set("material", "golden");
  }
  set("wield_msg","$N拿起$n握在手里。\n");
  setup();
}
