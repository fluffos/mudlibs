inherit ITEM;
void create() {
  set_name("手铐", ({ "qiankun dai", "bag", "dai" }));
  set_weight(1000);
  set_max_encumbrance(5000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("long", "这是一口奇怪的口袋，好像能装不少的东西。\n");
    set("value", 100000);
    set("no_sell", 1);
  }
}
