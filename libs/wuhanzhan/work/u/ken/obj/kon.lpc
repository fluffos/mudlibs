// blade.c
#include <weapon.h>

inherit SWORD;

void create() {
  set_name("筷子", ({ "kuai zi", "sword", "jian",
    "zi" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双神奇的筷子。\n");
    set("unit", "双");
    set("wield_msg",
      "你拿出一双筷子当做武器放在手中。\n");
    set("unwield_msg",
      "$N放下手中的筷子！\n");
    set("value", 50000);
    set("weapon_prop/courage", 20);
  }
  init_sword(100);
  setup();
}
