// atombomb

#include <ansi.h>

inherit ITEM;

void init() {
  add_action("do_launch", "launch");
  add_action("do_execute", "execute");
}


void create() {
  set_name("原子弹", ({ "atom bomb", "bomb" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一颗土制的原子弹，萨达姆.侯塞因的新宠儿\n");
    set("value", 1000);
    set("unit", "颗");
    set("no_get", 0);
    set("no_drop", 0);
  }
}

int do_execute(object target) {
  object me, dest;
  me = this_object();
  dest = target;

  if (wizardp(dest)) {
    message_vision(HIG "忽然天上掉下一颗原子弹，落在$n脚跟前。\n" NOR, me, dest);
    me->move(environment(dest));
    message_vision(HIW "$N炸了开来，一道白光划亮天空\n" NOR, me);
    dest->set_temp("last_damage_from", "被" + me->name() + "炸");
    command("rumor " + dest->query("name") + "被炸死了。");
    dest->delete("env/immortal");
    dest->die();
  }
}

int do_launch() {
  object *dest;
  int i;

  dest = users();
  i = sizeof(dest);

  while (i--) {
    do_execute(dest[i]);
  }

  destruct(this_object());
  return 1;
}
