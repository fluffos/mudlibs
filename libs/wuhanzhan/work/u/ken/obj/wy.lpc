#include <ansi.h>
inherit ITEM;
void create()
{
    set_name( RED "小礼包" NOR, ({ "bao" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
        set("unit", "个");
            set("material", "cloth");
            set("long", "一个神秘的小礼包,你可(open)看看，至于里面的东西是.......\n");
                set("no_drop", "如此宝贵的东西再世难求啊。\n");
//                set("no_put", "珍惜它吧。\n");
                set("no_give", "送人？亏你想的出来！\n");

}
    setup();
}
void init()
{
if(environment()==this_player())
add_action("do_open","open");
}
int do_open(string arg)
{
object gold;
object me;
me=this_player();
if(arg != "bao" && arg != "小礼包") return 0;
me->add("potential",8000);
me->add("combat_exp",3000);
me->add("max_mana",80);
me->add("max_force",80);
write(HIC "无声狂啸突然出现在一阵烟雾之中！笑嘻嘻的对你一拱手，“Hi节日快乐！”\n\n");
destruct(this_object());
return 1;
}
