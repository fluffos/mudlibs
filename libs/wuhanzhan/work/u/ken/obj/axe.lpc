
#include <weapon.h>
inherit AXE;
#include <ansi.h>

void create()
{
   set_name(HIR"大板斧"NOR, ({"daban fu", "fu","axe"}));
   set_weight(5000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "对");
     set("long", "是天杀星李逵的爱斧，有遇神杀神遇鬼屠鬼的可怕力量，凶暴无比。\n");
     set("value", 5000000);
     set("material", "steel");
     set("wield_msg", "$N全身冒出浓浓的杀气，原来是拿出了$n。\n"NOR);
     set("unwield_msg", "$N眼中寒光一闪，把$n收在了身后。\n"NOR);
   }
   init_axe(200);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("kee",dam/4);
                switch(random(2)) {
                        case 0: return "$w冒出一团血雾，罩住了$n！\n"NOR;
                        case 1: return "$w化出一道寒光……\n"NOR;
                             }        
}
