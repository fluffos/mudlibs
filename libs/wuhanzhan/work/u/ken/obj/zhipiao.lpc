 // zhipiao.c

inherit MONEY;

void create()
{
        set_name("支票", ({"zhipiao", "zhipiao_money", "piao"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("money_id", "zhipiao");
                set("long", "一张支票。\n");
                set("unit", "张");
                set("base_value", 5000000);
                set("base_unit", "张");
                set("base_weight", 3);
        }
        set_amount(1);
}
