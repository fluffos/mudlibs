// cake 粽子

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();
void init()
{
   add_action("do_eat", "eat");
}

void create()
{
   set_name("真火", ({"zhenhuo", "zong zi", "zong"}));
   set_weight(100);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "个");
     set("long", "you come here to die。\n");
     set("drug_type", "补品");

   }

   set("is_monitored",1);
   setup(); 
}

int do_eat(string arg)
{
   int howmany,force,spells,empx,pot;

   object me = this_player();
   if (!id(arg)) return notify_fail("你要吃什么？\n");

   howmany = (int)me->query("gaon");
    if ( howmany > 1 ) 
{
     message_vision(HIG "$N吃过一次了，再吃也没有用。\n" NOR, me); 
 } 
else
{   message_vision(HIW "$N感到一股奇异的力量充满身体。\n" NOR, me);  
    me->set("gaon",3);
    me->add("max_mana",100);   
    me->add("max_force",100);   
    me->add("combat_exp",10000);
    me->add("potential",30000);

return 1;
}
   destruct(this_object());
   return 1;
}
