// deagin by ken 9.18.2000
// 判师丹.... 一生仅能吃三次....

inherit F_FOOD;
int do_eat(string);
inherit ITEM;
void init();
#include <ansi.h>

void create() {
  set_name(HIC "叛师丹" NOR, ({ "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "神奇丹药，有起死回生之神效．\n");
    set("unit", "颗");
    set("food_remaining", 1);
    set("food_supply", 0);
    set("value", 100000000);
    set("material", "food");
  }
  setup();
}


void init() {
  set("no_drop", "别浪费了．\n");
  add_action("do_eat", "eat");
}


int do_eat(string arg) {
  int PANSHI;
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  PANSHI = (int)me->query("pan");
  if (PANSHI > 2) {
    message_vision(HIR "$N已吃过三次了，再吃也没有用。\n" NOR, me);
  } else {
    me->delete("family");
    me->set("title", "普通百姓");
    me->delete("class");
    me->delete("betray/count");
    me->delete("betray/longgong");
    me->delete("betray/jjf");
    me->delete("betray/hell");
    me->delete("betray/wuzhuang");
    me->delete("betray/wudidong");
    me->delete("betray/xueshan");
    me->delete("betray/moon");
    me->delete("betray/putuo");
    me->delete("betray/ljm");
    me->delete("betray/fangcun");
    me->set("combat_exp", me->query("combat_exp") * 90 / 100);
    me->delete_temp("betray");
    me->add("pan", 1);
    me->save();
    message_vision(HIY "\n$N吃下一颗判师丹，背判师门的事渐渐如过往云烟....\n\n" NOR, me);
    return 1;
  }

  destruct(this_object());
  return 1;
}
