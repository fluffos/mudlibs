// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// blackthorn.c

#include <weapon.h>

inherit SWORD;
#include <ansi.h>

void create() {
  set_name(HBRED "断情" NOR, ({ "hate", "sword", "jian" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long",
      "一对古剑,剑柄上分别刻有" + MAG "「断」" NOR + "，" + HIG "「情」" NOR + "两字.\n"
      "剑身隐有霞光流动,看起来是一对神兵利器.\n");
    set("no_sell", 1);
    set("value", 9000);
    set("material", "blacksteel");
    set("wield_msg", HIB "\n两道眩目的" HIM " 断 " HIC "情 " HIB "剑光闪过,双剑和体,你一握在手,心中不禁郁郁不乐.\n\n" NOR);

    set("unwield_msg", HIC "\n$N一声长啸,双剑瞬然不见.\n\n" NOR);
  }
  init_sword(1000);
  setup();
}
