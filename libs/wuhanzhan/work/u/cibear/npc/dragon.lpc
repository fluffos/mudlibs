// By cibear
inherit NPC;
string ask_armor(object who);
string ask_pifeng(object who);
string ask_bonnet(object who);

void create() {
  set_name("神龙帕夫", ({ "dragon pafu", "dragon" }));
  set("title", "魔教护法");
  set("gender", "男性");
  set("age", 25);
  set("attitude", "peaceful");
  set("immortal", "1");
  set("class", "evil");
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 300);
  set("max_mana", 10000);
  set("mana", 10000);
  set("mana_factor", 400);
  set("combat_exp", 15000000);
  set_skill("evil-force", 500);
  set_skill("unarmed", 400);
  set_skill("dodge", 500);
  set_skill("parry", 400);
  set_skill("force", 300);
  set_skill("huolong-zhang", 400);
  map_skill("force", "evil-force");
  map_skill("unarmed", "huolong-zhang");

  set("inquiry", ([
    "甲": (: ask_armor :),
    "披风": (: ask_pifeng :),
    "盔": (: ask_bonnet :),
  ]));
  set("apply/armorno", 5);
  set("apply/pifengno", 5);
  set("apply/bonnetno", 5);
  create_family("魔教", 1, "神龙");


  setup();
  add_money("gold", 20);
  carry_object("/u/cibear/obj/armor")->wear();
}

string ask_armor(object me) {
  object ob, who = this_player();
  int number;

  if (who->query("family/family_name") != "魔教")
    return RANK_D->query_respect(who) + "与本门毫无渊源，想要宝贝来魔教吧！\n";

  if (present("evil armor", who)) return "你身上不是已经有了吗，怎么又来要？\n";

  if (!(number = me->query("apply/armorno"))) return "对不起，神甲已经全部发放给诸位弟子了。\n";
  set("apply/armorno", --number);

  ob = new("/u/cibear/obj/armor");
  ob->move(who);

  return "好好努力，复兴魔教吧。\n";
}

string ask_pifeng(object me) {
  object ob, who = this_player();
  int number;

  if (who->query("family/family_name") != "魔教")
    return RANK_D->query_respect(who) + "与本门毫无渊源，想要宝贝来魔教吧！\n";

  if (present("evil pifeng", who)) return "你身上不是已经有了吗，怎么又来要？\n";

  if (!(number = me->query("apply/pifengno"))) return "对不起，披风已经全部发放给诸位弟子了。\n";
  set("apply/pifengno", --number);

  ob = new("/u/cibear/obj/pifeng");
  ob->move(who);

  return "好好努力，复兴魔教吧。\n";
}

string ask_bonnet(object me) {
  object ob, who = this_player();
  int number;
  if (who->query("family/family_name") != "魔教")
    return RANK_D->query_respect(who) + "与本门毫无渊源，想要宝贝来魔教吧！\n";

  if (present("evil bonnet", who)) return "你身上不是已经有了吗，怎么又来要？\n";

  if (!(number = me->query("apply/bonnetno"))) return "对不起，神甲已经全部发放给诸位弟子了。\n";
  set("apply/bonnetno", --number);

  ob = new("/u/cibear/obj/bonnet");
  ob->move(who);

  return "好好努力，复兴魔教吧。\n";
}
void die() {
  set("eff_kee", 1000);
  set("eff_gin", 1000);
  set("eff_sen", 1000);
  set("sen", 1000);
  set("kee", 1000);
  set("force", 1000);
  set("mana", 1000);
}

void unconcious() {
  die();
}
