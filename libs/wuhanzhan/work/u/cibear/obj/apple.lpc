inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("大大的苹果", ({"apple", "guo"}));
        set_weight(300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个香香的苹果，看了让你垂涎三尺\n");
                set("unit", "个");
                set("value", 1);
                set("food_remaining", 2);
                set("food_supply", 1000);
        }
}
