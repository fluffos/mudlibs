//by cibear armor
#include <ansi.h>
#include <armor.h>
inherit SURCOAT;
void create()
{
  set_name(HIR "魔龙披风" NOR, ({"evil pifeng", "pifeng"}));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "leather");
                set("long", HIR "此乃神龙帕夫为复兴魔教自残肢体而成，据说可以防御特殊攻击。\n" NOR);
               set("value", 200000);
               set("no_sell", 1);
               set("no_get", 1);
               set("no_give", 1);
               set("no_drop", 1);
               set("armor_prop/armor", 80);
               set("armor_prop/armor_vs_spells", 400);

 }
        setup();
}
