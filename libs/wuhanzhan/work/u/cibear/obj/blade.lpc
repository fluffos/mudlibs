//by cibear

#include <weapon.h>
inherit BLADE;
#include <ansi.h>
inherit F_UNIQUE;

void create() {
  set_name(HIM "屠龙宝刀" NOR, ({ "tulong baodao", "dao", "blade" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把散发着骸人杀气的宝刀，要想充分发挥它的威力需要文武双全才可以。\n");
    set("value", 5000);
    set("material", "fire");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("replace_file", "/d/mojiao/obj/fireblade");
    set("wield_msg", MAG "一阵热浪袭来,$N手中多了把$n。\n" NOR);
    set("unwield_msg", MAG "$N将$n" HIR "收回刀鞘，众人酷热之后乍寒，不禁有些哆嗦。\n" NOR);
  }
  init_blade(180);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  int gain;
  dam = (int)me->query_skill("literate", 1);
  gain = dam / 5;
  if (dam >= 400) dam = 600;
  victim->receive_damage("sen", gain);
  if (me->query_skill("literate", 1) > 250)
    me->improve_skill("blade", gain);
  set("weapon_prop/dodge", gain);
  set("weapon_prop/parry", gain);


  switch (random(4)) {
    case 0: return "$w" HIR "中射出逼人杀气，惊恐之下无人能够动弹！\n" NOR;
    case 1: return "$w" HIR "隐隐发出诗书之音，$n心神一乱！\n" NOR;
    case 2: return "$w" HIR "$N大喝一声：文王助我。天边突现紫气，$n觉得虚弱了许多！\n" NOR;
    case 3: return "$w" HIR "$N手中的神兵居然化作戒尺，$n不由想起了年少时被老师打手心的感觉！\n" NOR;
  }
}
