// tan.c 灵剑指- 弹
// Written by sadboy

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  object weapon;
  object ob;              // 对手的武器
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「弹」字决指法只能对战斗中的对手使用。\n");

  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("你不能使用武器！\n");

  if (!objectp(ob = target->query_temp("weapon")))
    return notify_fail("对方并没有武器，你不用担心！\n");

  if ((int)me->query_skill("lingjianzhi", 1) < 100)
    return notify_fail("你的灵剑指太生疏，不会使用「弹」字决。\n");

  if (me->query("force") < 500)
    return notify_fail("你的内力不够，现在无法使用「弹」字决。\n");
  me->add("force", -50);

  msg = HIY "$N长出一口气，使出灵剑指「弹」式，一道犀利无比的剑气直奔$n而去。\n";

  me->start_busy(2);
  if (random(me->query_skill("force") + me->query_skill("lingjianzhi")) > random((int)target->query_skill("force") + (int)target->query_skill("parry"))
    {
      if (ob->query("item_make")) {
        msg += HIR " " + target->query("name") + "忙用" + ob->query("name") + "招架，只觉得虎口剧震，所幸兵器完好无损。\n" NOR;
      } else {
        msg += HIW " " + target->query("name") + "连忙招架，只听见「啪」地一声，" + target->query("name") + "手中的" + ob->name() + "已经断为数截，激飞上天！\n" NOR;
        ob->unequip();
        ob->move(environment(target));
        ob->set("name", "断掉的" + ob->query("name"));
        ob->set("value", 0);
        ob->set("weapon_prop", 0);
      }
      target->start_busy(2);
    } else
    {
      msg += "" + target->query("name") + "真气贯注" + ob->query("name") + "，和" + me->query("name") + "剑气相交，冒出点点火光。\n" NOR;
    }
    message_vision(msg, me, target);

    return 1;
  }
