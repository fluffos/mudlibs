#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
        object weapon;
        int extra;
        int addon, tmp, atk;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「盘龙六棍」？\n");
        if(!me->is_fighting())
                return notify_fail("「盘龙六棍」只能在战斗中使用！\n");
        if(me->query("family/family_name") != "方寸山三星洞")
                return notify_fail("[盘龙六棍]是灵台不传之密！\n");
        if((int)me->query("max_force") < 2500 )
                return notify_fail("你的内力不够！\n");
        if((int)me->query("force") < 2500 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("qianjun-bang", 1) < 380)
                return notify_fail("你的千钧棒级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("stick", 1) < 320)
                return notify_fail("你的基本棒法级别还不够，使用这一招会有困难！\n");

                
        atk = (addon+tmp)/2;
        me->add_temp("apply/attack",-extra);
        me->add_temp("apply/damage",extra);
        weapon = me->query_temp("weapon");
        message_vision(HIC"\n$N运足精神，身形一转，使出了「盘龙六棍」的绝技！\n"NOR,me,target);
        me->set_temp("QJB_perform", 5);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->set_temp("QJB_perform", 6);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        me->set_temp("QJB_perform", 6);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        me->set_temp("QJB_perform", 7);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        me->set_temp("QJB_perform", 7);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        me->set_temp("QJB_perform",7);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        me->delete_temp("QJB_perform");
        me->receive_damage("sen", 100);
           me->add("force", -500);
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        me->start_busy(3);
        return 1;
}

