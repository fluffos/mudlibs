#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {

  string msg;

  int i, lmt, damage;
  object weapon;

  if ((int)me->query_skill("axe") < 290 ||
    me->query_skill_mapped("axe") != "sanban-axe")
    return notify_fail(HIW "你的「三板斧」还不到家，无法使用「三山五岳」！\n" NOR);
  if ((int)me->query("force", 1) < 3000)
    return notify_fail("你的内力不够，无法使用「三山五岳」！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIW "「三山五岳」只能对战斗中的对手使用。\n" NOR);

  weapon = me->query_temp("weapon");
  msg = HIR "$N脸上怒气冲冠，爆喝一声道" 五 岳 齐 聚 "，轮起
斧头狂舞，只见斧头转得象风车一样，四周飞砂走石，片刻间形成一道强
劲无比的旋风。叫对方分不清那是人影还是斧光。" 砰 "," 砰 "的五声巨响，
仿佛五岳从天而降，追着一道长长的斧，随着狂风压向对方。转眼间只听
见五声巨响，" 三 山 五 岳 "连环击中对方，$n口吐鲜血。随风而逝.！\n" NOR;
  message_vision(msg, target, me);
  if (!target->is_killing(me->query("id"))) target->kill_ob(me);
  damage = me->query_skill("sanban-axe", 1) + (int)me->query_skill("lengquan-force", 1);
  damage = damage - random(target->query_skill("dodge") / 3);
  lmt = random(5) + 3;
  for (i = 1; i <= lmt; i++) {
    msg = HIW "$N大喝一声：接第" + chinese_number(i) + "斧！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }

  target->receive_wound("kee", random(damage / 20));
  target->receive_damage("sen", 20 + random(damage));
  target->receive_wound("sen", 20 + damage);
  me->add("force", -280);
  me->start_busy(4);
  return 1;
}
