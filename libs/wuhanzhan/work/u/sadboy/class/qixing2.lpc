// qixing. 七星夺命斧
// update by sadboy
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        object weapon = me->query_temp("weapon");
        int damage;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("[七星夺命斧]只能对战斗中的对手使用。\n");

    if( (int)me->query_skill("sanban-axe", 1) < 300 )
                return notify_fail("你的三板斧不够熟练，使不出[七星夺命斧]。\n");

    if(me->query("family/family_name") != "将军府" )
               return notify_fail("你是哪儿偷学来的武功，也想用[七星夺命斧]！\n");
  
    if (!weapon || weapon->query("skill_type") != "axe"
        || me->query_skill_mapped("axe") != "sanban-axe")
                return notify_fail("你现在无法使用[七星夺命斧]。\n");

    if ( (int)me->query("force") < 3000)
                return notify_fail("你的内力不够，无法使用[七星夺命斧]。\n");

        msg = HIY"\n$N一声长啸，一抖手中斧，只见一道斧光，狂风暴雨般压向$n。就在$n慌乱之间，斧光中飞出七朵寒星，如流星般射向$n。\n\n"NOR;

        if( random(me->query("combat_exp"))*2 > (int)target->query("combat_exp")/3 ) {
                msg +=HIR"$n躲闪不及，已然中斧！\n"NOR;
                damage = 5*(int)me->query_skill("sanban-axe", 1);
                damage = damage + random(damage / 2);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/3);
                target->receive_damage("sen", damage);
                target->receive_wound("sen", damage/3);
                if( damage < 2000 ) msg += HIR"$n已身中数斧，身上到处是血。\n"NOR;
                else if( damage < 2500 ) msg += HIR"$n身中七斧，鲜血狂喷而出！\n"NOR;
                else msg += HIR"$n“哇”的狂叫一声，身上喷出七道血剑！\n"NOR;
                message_vision(msg, me, target);
        } 
        else {
                msg += HIC"$n情急之中向后激飞，随机趴下，堪堪躲过了这致命一击。\n"NOR;
                message_vision(msg, me, target);
        }
        me->add("force", -800);
        me->start_busy(2);

        return 1;
}
