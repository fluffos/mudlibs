// duo.c 
// sadboy 2001.4.4

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  object weapon, weapon2;
  string msg;
  int iDuo;

  weapon2 = me->query_temp("weapon");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("" + RED "「吸焰」" + NOR "只有在战斗中施用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");

  if (!objectp(weapon = target->query_temp("weapon")))
    return notify_fail("对方手中没有武器，你还使出这招" + RED "「吸焰」" + NOR "，真是个大笨蛋。\n");

  if (me->query("family/family_name") != "盘丝洞")
    return notify_fail("“吸焰”只有盘丝洞门人才可以用！\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧\n");

  if ((int)me->query_skill("whip", 1) > 300)
    return notify_fail("你的基本鞭法过高，" + RED "「吸焰」" + NOR "已经无法使用。\n");

  if ((int)me->query_skill("yinsuo-jinling", 1) > 300)
    return notify_fail("你的银索金玲过高，" + RED "「吸焰」" + NOR "已经无法使用。\n");

  if ((int)me->query_skill("whip", 1) < 250)
    return notify_fail("你的基本鞭法不够娴熟，使不出" + RED "「吸焰」" + NOR "。\n");

  if ((int)me->query("max_force") < 3600)
    return notify_fail("你的内力修为不够！使不出" + RED "「吸焰」" + NOR "。\n");

  if ((int)me->query("force") < 4000)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query_skill("zixia-force", 1) < 250)
    return notify_fail("你的紫霞神功火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("pansi-dafa", 1) < 250)
    return notify_fail("你的盘丝大法火候不到，无法驾御这么厉害的武功。\n");

  if ((int)me->query_skill("yinsuo-jinling", 1) < 250)
    return notify_fail("你的银索金玲不够娴熟，使不出" + RED "「吸焰」" + NOR "。\n");

  msg = HIY "$N使出银索金玲" + RED "「吸焰」" + NOR "，连递数个鬼魅般的招式向$n的手腕缠绕。\n" NOR;

  me->start_busy(2);

  if ((string)weapon2->query("id") == "yinsuo jinling")
    iDuo = 3;
  else
    iDuo = 2;

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / iDuo) {

    msg += HIR "$n顿时觉得双手运作不灵，忽然手腕一麻，手中";
    msg += weapon->name();
    msg += "竟然不易而飞！\n";
    msg += "细看时，已被$N收纳入了怀中！\n" NOR;

    target->start_busy(1);
    weapon->move(me);
  } else {
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
  }

  me->start_busy(1);
  message_vision(msg, me, target);
  me->add("force", -350 + random(50));

  return 1;
}
