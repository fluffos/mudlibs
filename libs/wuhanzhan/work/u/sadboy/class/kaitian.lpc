// kaitian.c 开天
// update by sadboy
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon = me->query_temp("weapon");
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[开天]只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("sanban-axe", 1) < 350)
    return notify_fail("你的三板斧不够熟练，使不出[开天]。\n");
  if ((int)me->query_skill("axe", 1) < 300)
    return notify_fail("你基本斧法不够熟练，使不出[开天]。\n");
  if ((int)me->query_skill("lengquan-force", 1) < 350)
    return notify_fail("你的冷泉神功修为过低，还是不要用[开天]。\n");
  if ((int)me->query_skill("yanxing-steps", 1) < 300)
    return notify_fail("你雁行步法不够熟练，使不出[开天]。\n");
  if ((int)me->query_skill("unarmed", 1) < 300)
    return notify_fail("你扑击格斗之技不够熟练，使不出[开天]。\n");
  if ((int)me->query_skill("dodge", 1) < 300)
    return notify_fail("你基本轻功不够熟练，使不出[开天]。\n");
  if (me->query("family/family_name") != "将军府")
    return notify_fail("你是哪儿偷学来的武功，也想用[开天]！\n");

  if (!weapon || weapon->query("skill_type") != "axe"
    || me->query_skill_mapped("axe") != "sanban-axe")
    return notify_fail("你现在无法使用[开天]。\n");

  if ((int)me->query("force") < 3000)
    return notify_fail("你的内力不够，无法使用[开天]。\n");

  msg = HIW "\n$N仰天狂笑,突然神情不语,暗用冷泉神功,刹那天地间电闪雷鸣,飞砂走石,猛的大喝一声" 去 死 吧 !, 只 见 一 道 斧 光 贯 穿 于 天 地, $n 顿 时 口 吐 鲜 血 。 \ n "NOR;

        if( random(me->query(" combat_exp "))*2 > (int)target->query(" combat_exp ")/3 ) {
                msg +=HIR" $n 躲 闪 不 及 ， 已 然 中 斧 ！ \ n "NOR;
                damage = 5*(int)me->query_skill(" sanban - axe ", 1);
                damage = damage + random(damage / 2);
                target->receive_damage(" kee ", damage/3*2);
                target->receive_wound(" kee ", damage/3);
                target->receive_damage(" sen ", damage/3*2);
                target->receive_wound(" sen ", damage/3);
                if( damage < 2000 ) msg += HIR" $n 已 身 中 数 斧 ， 身 上 到 处 是 血 。 \ n "NOR;
                else if( damage < 2500 ) msg += HIR" $n 身 中 七 斧 ， 鲜 血 狂 喷 而 出 ！ \ n "NOR;
                else msg += HIR" $n “ 哇 ” 的 狂 叫 一 声 ， 身 上 喷 出 七 道 血 剑 ！ \ n "NOR;
                message_vision(msg, me, target);
        } 
        else {
                msg += HIC" $n 情 急 之 中 向 后 激 飞 ， 随 机 趴 下 ， 堪 堪 躲 过 了 这 致 命 一 击 。 \ n "NOR;
                message_vision(msg, me, target);
        }
        me->add(" force ", -1000);
        me->start_busy(2);

        return 1;
}
