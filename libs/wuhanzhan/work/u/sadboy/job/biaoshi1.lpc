#include <ansi.h>
inherit NPC;

int do_copy(object me,int maxpot,int type);

void create()
{
      string weapon;
        set_name("镖师", ({ "biaoshi"}));
        set("gender", "男性");
        set("age", random(20) + 25);
        set("str", 23);
        set("con", 26);
        set("int", 20);
        set("cor", 23);
        set("combat_exp", 80000 + random(40000)); 
        set("attitude", "friendly");
        set_skill("force", 50);
        set_skill("sword", 50);
        set_skill("dodge", 50);
        set_skill("parry", 50);
        set_skill("spear", 50);
        set_skill("changquan", 50);
        set_skill("bawang-qiang", 50); 
        set_skill("lengquan-force",50);
        set_skill("yanxing-steps",50);
        map_skill("dodge", "yanxing-steps");
        map_skill("parry", "bawang-qiang");
        map_skill("spear", "bawang-qiang");
        map_skill("force", "lengquan-force");
/*
        set("max_kee", 450); 
        set("max_mana", 400); 
        set("force", 700); 
        set("max_force", 700);
        set("force_factor", 30);
*/
        setup();
        carry_object("/d/obj/weapon/spear/changqiang")->wield();
        carry_object("/d/qujing/tianzhu/obj/tiekui")->wear();
        carry_object("/d/obj/cloth/zhanpao")->wear();
}

int do_copy(object me,int maxpot,int type)
{
        int i,j;
        object ob;
        ob = this_object();
        i=maxpot;
        if(type==1)
                i = i - random(20);
                else  
            i = i +10+ random(10);
        if( i < 100) i = 100;
        
        ob->set("combat_exp", (me->query("combat_exp")+random(me->query("combat_exp")))*3/4);
        ob->set_skill("force", i);
        ob->set_skill("sword", i);
        ob->set_skill("spear", i);
        ob->set_skill("dodge", i);
        ob->set_skill("parry", i);
        ob->set_skill("bawang-qiang", i);       
        ob->set_skill("lengquan-force", i); 
        ob->set_skill("yanxing-steps",i);
        ob->set("max_kee",     i*10); 
        ob->set("max_mana", me->query("max_mana")*2/3); 
        ob->set("max_force",  i*10); 
        ob->set("force_factor", 30);
        ob->set("kee",ob->query("max_kee"));
        ob->set("mana",ob->query("max_mana"));
            return 1;
}
