#include <ansi.h>
inherit ITEM;

void to_rob();
void create()
{
        set_name("镖单", ({ "biao dan"}) );
        set_weight(3000);
        set("no_get", 1);
       set("unit", "份");
        set("long", "一个血河镖局运镖的凭证。\n");
        set("value", 0);
        set("no_put","放起来还怎么完成任务了？");
        set("no_get","这个东西拣不得");
        set("no_drop","这个东西扔不得");
        set("no_steal","大胆，什么都敢偷！");
  set("ride/msg", "驾御");
  set("ride/dodge", 10+random(6));

    
}
void init()
{
        add_action("do_jietou","jietou");
        remove_call_out("go");
        call_out("go",10);      
}
int do_jietou()
{
        object me,ob,where;
        int exp,pot;
        me=this_player();
        ob=this_object();
       where = environment(me);
        if(file_name(where) != me->query_temp("end_place"))
         {
        message_vision(HIR"搞错了吧！没人接应啊！\n"NOR,me);    
         return 0;
         }
        if(file_name(where) == me->query_temp("end_place"))
         {  
                  me->set_temp("jietoudone",1);
        message_vision(HIC"突然从暗处走出一人朝$N走来，$N问道：万重千险.\n那人答 道：长风破浪。\n"NOR,me);       
        }
                  destruct(ob);
        return 1;
}

void go()
{       
                if (random(100)<40&& !environment(this_object())->query("no_fight") )
        {       if (this_object()->query_temp("tufei")<3)
                {to_rob();
                this_object()->add_temp("tufei",1);
                call_out("go",30);}
                return;
        }call_out("go",5);
}
void to_rob()
{
        int i,maxpot;
        object robber;
        
        message_vision(HIR"忽然间跳出一群劫匪！\n"NOR,this_object());
        for (i=0;i<=random(5)+1;i++)
        {
                robber=new(__DIR__"jiefei");
                robber->move(environment(this_player()));
                robber->set_leader(this_player());
                 robber->do_copy(this_player(),maxpot,3);   
                 if(objectp(present("biaoshi", environment(this_player()))))
                {       robber->kill_ob(present("biaoshi",environment(this_player())));
                        present("biaoshi",environment(this_player()))->kill_ob(robber);}
                robber->kill_ob(this_player());
                this_player()->kill_ob(robber);
        }
        
}
