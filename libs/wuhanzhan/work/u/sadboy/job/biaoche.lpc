#include <ansi.h>
inherit ITEM;

void to_rob();
void create()
{
        set_name("镖车", ({ "biao che"}) );
        set_weight(3000000);
        set("no_get", 1);
       set("unit", "份");
        set("long", "一个巨型镖车，上面插着血河镖局的镖旗。\n");
        set("value", 0);
        set("no_put",1);
        set("no_get","这么重的镖车你能拿得动？");
        set("no_drop",1);
        set("biao che",1);
        set("no_steal",1);
  set("jiayu/msg", "驾御");
  set("ride/dodge", 10+random(6));

    
}
void init()
{
        add_action("do_finish","finish");
}
int do_finish()
{
        int i,exp,pot,count,base_exp,add_exp;
        object ob,me,where,*team;
              
                me=this_player();
        ob=this_object();
          add_exp = (int)me->query("combat_exp")/2000;
    if (add_exp >4000 ) add_exp =4000;
      if (!me->query_temp("jietoudone"))
                return notify_fail("接头的人来了吗?\n");

        //check ok
        count=me->query_temp("team_count");
                if (count<2) count=2;   
        base_exp=6000;
                team=me->query_team();
                count=sizeof(team);
                //write("\n"+sprintf("%d",count));
                for(i=0;i<count;i++)
                { if(team[i]!=0)
                {
                     exp=(base_exp+add_exp)/count+random(400);
                     pot=exp/3+random(100);
             team[i]->add("potential",pot);
             team[i]->add("combat_exp",exp);
             team[i]->delete_temp("on_biao");
             team[i]->delete_temp("end_place");
             team[i]->delete_temp("biao_place");
             team[i]->delete_temp("jietoudone");
        message_vision(HIY"$N见对方对上了暗号，便把手中的镖货交给了对方。\n"NOR,me);    
                         tell_object(team[i],HIW"你被奖励了：\n" + 
                       chinese_number(exp) + "点实战经验\n" +
                       chinese_number(pot) + "点潜能\n"+
                       NOR);
                        }
                        } 
                  me->delete_temp("team_count");
                  
                destruct(present("biaoshi",environment(me)));
                destruct(present("biaoshi",environment(me)));
                  destruct(this_object());


        return 1;
}
