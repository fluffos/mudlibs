// by sadboy
#include <ansi.h>
 
inherit NPC;
inherit F_VENDOR;

string give_wawa(object me);
int do_yes(string arg);


void create()
{
  set_name(HIC"雪绒花"NOR, ({"xrhmm"}));
  set("title", HIW"雪☆落☆无☆声"NOR);
  set("gender", "女性");
   set("long","婷婷玉立的一个女孩，长的十分标志，一笑有两个小酒窝，但却很少说话。\n");
   set("combat_exp", 500000);
  set("age", 20);
    set("per", 27);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
    set("inquiry", ([
     "name" : "我就是雪绒花 mm拉。\n",
     "布娃娃" : (: give_wawa :),
        "buwawa" : (: give_wawa :),
   ]) );
    set("no_wawa", 0);
     
  set("vendor_goods", ([
      "tea": "/u/sadboy/obj/nuerxiang",
   //   "buwawa": "/u/sadboy/obj/buwawa",
         "gao":"/u/sadboy/obj/gao",
//       "feiji":"/u/sadboy/obj/feiji",
            
    ]) );

  setup();
  carry_object("/d/obj/cloth/shoes")->wear();
carry_object("/d/obj/cloth/skirt")->wear();
  add_money("silver", 5);
}

void init()
{
  object ob;

  ::init();
  if( interactive(ob = this_player()) && !is_fighting() ) {
     remove_call_out("greeting");
     call_out("greeting", 3, ob);
  }
  add_action("do_vendor_list", "list"); 
  add_action("do_nod","nod");
}

string give_wawa(object me)
{
   
     me=this_player();
   me->set_temp("need_wawa", 1);
   return "布娃娃，可是个好玩的东东，你想要吗？想要你就说嘛，你不说我怎么知道了，难道你真的想要吗？你真的想要？\n";
}


int do_nod(string arg)
{
   object me,buwawa,who;
   me=this_player();
   if(me->query_temp("need_wawa")) 
   {
     message_vision("$N答道：我真的想要！\n\n", me);
//           command("chan");
     if( query("no_wawa") == 0 )
     {
        message_vision("雪绒花低头念了几句咒语，手中忽然多了根雪花棒;雪花棒在空中划过一道美丽的弧线，转瞬间，漫天雪花飞舞;只见一个布娃娃随着飘落的雪花，轻轻落到雪绒花手中,雪绒花说道：布娃娃就给你把！\n", me);
        me->set_temp("need_wawa", 0);

buwawa=new("/d/obj/misc/buwawa");
                  buwawa->move(me);
       command("baobao " + me->query("id"));
        command("face");
        set("no_wawa", 1);
        call_out("regenerate", 480);
     }
     else
     {
        message_vision("雪绒花说道：我那里有那么多的布娃娃啊，你过会在来把。\n", me);
              command("sorry " + me->query("id"));
     }

     return 1;
   }
   return 0;
}
int regenerate()
{
   set("no_wawa", 0);
   return 1;
}
void die()
{
  if (environment())
    message("sound", "\n\n你们不能对雪绒花妹妹这样哦！\n\n", environment());

  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}
