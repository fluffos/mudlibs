// adai.c
inherit NPC;

string suanming(object me);
string suan_fuyuan(object me);

void create()
{
        set_name("阿呆", ({"jianke"}));
        set("title","剑客");
        set("gender", "男性" );
        set("age", 25);
        set("class","xian");
        set("rank_info/respect", "剑客");
        set("long", "他的名字叫阿呆，他的剑很快\n");
        set("combat_exp", 80000000);
        set("daoxing", 80000000);
        set("attitude", "peaceful");
        set_skill("unarmed", 500);
        set("max_force", 20000);
        set("force", 40000);
        set_skill("dodge", 500);
        set_skill("parry", 500);
        set_skill("literate", 500);
//        set_skill("zixia-sword", 500);
        set_skill("force", 500);
        set_skill("ningxie-force", 500);
        set_skill("sword", 500);
        set_skill("xiaoyaoyou", 500);
        set_skill("dengxian-dafa", 500);
        set_skill("spells", 500);
//        map_skill("sword", "zixia-sword");
//        map_skill("parry", "zixia-sword");
        map_skill("spells", "dengxian-dafa");
        map_skill("force", "ningxie-force");
        set("per", 100);
        set("str", 100);
        set("max_kee", 10000);
        set("max_gin", 10000);
        set("max_sen", 10000);
        set("max_mana", 10000);
        set("mana", 20000);
        set("mana_factor", 400);
        setup();
       set("chat_msg_combat", ({
   (: cast_spell, "jieti" :),
   (: cast_spell, "hufa" :),
  }) );

}
void init()
{
        object ob;

        ::init();
        set("chat_chance", 10);

         set("chat_msg", ({
 "十五岁那年，他第一次出剑，“夺命双刹”之一衡力海死。\n",    

  "十八岁那年，他第二次出剑，“武当快剑”落破死。\n", 
  "二十岁那年，他第三次出剑，“浪得虚名”飘逸死。\n"     

  "二十二岁那年，他没有出剑，“虎头蛇尾”懦弱败。\n",
  "二十四岁那年，他说他的名字叫阿呆，“无敌剑客”荆要命猖獗而逃。\n",

     "他笑了，那把剑在他腰间不停的摇晃，发出美妙的声音…… \n",
      "那天，他依然独自坐在家门口。远处，隐隐约约可见一人影飘之而来。近了，是个女子。 

　　你又来找我？ 

　　是，今天我一定要打败你。女子握紧她手中的剑，看着阿呆，她的脸色有些苍白。 
\n",
       "阿呆想笑，他还想告诉那个女子他的名字叫阿呆，也许，那个女子就会象荆要命那样猖獗而逃，于是，他转过身，偷偷地的笑了起来，他说，你知道我是谁吗？我…… 

　　话还未完，他就感觉到身后一阵冰凉，他看见自己胸前刺出一把利剑，带着粘稠的血液，他的笑容突然间僵硬。 
\n",
       "女子在他身后发出铜铃般的笑声，她说，你的名字叫阿呆，我知道…… 

　　他倒了下去，他未出剑，就败了。
\n",
        "女子迷起眼睛，蹲下，拍着阿呆的肩膀，道，你知道吗？其实每个人都他的弱点，你的弱点就是太骄傲，太轻视你的敌人了。我花了三年时间让你来轻视我，所以，今天你败了。 

　　她的名字叫丁零，她的剑也很快。 



 \n",     
            }) );
}


void die()
{
  if (environment())
    message("sound", "\n\n阿呆哼了一声，想要我死，没门！\n\n", environment());

  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}

