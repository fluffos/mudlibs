// wuqing.c
inherit NPC;

string suanming(object me);
string suan_fuyuan(object me);

void create()
{
        set_name("无情", ({"killer"}));
        set("title","杀手");
        set("gender", "男性" );
        set("age", 25);
        set("class","xian");
        set("rank_info/respect", "杀手");
        set("long", "普通的样子，看着他，你总是感到一股寒意\n");
        set("combat_exp", 80000000);
        set("daoxing", 80000000);
        set("attitude", "peaceful");
        set_skill("unarmed", 500);
        set("max_force", 20000);
        set("force", 40000);
        set_skill("dodge", 500);
set_skill("parry",1000);
        set_skill("literate", 500);
 set_skill("force", 1000);
 set_skill("ningxie-force", 1000);
        set_skill("sword", 500);
        set_skill("xiaoyaoyou", 500);
        set_skill("dengxian-dafa", 1000);
        set_skill("spells", 1000);
        map_skill("spells", "dengxian-dafa");
        map_skill("force", "ningxie-force");
        set("per", 100);
        set("str", 100);
        set("max_kee", 10000);
        set("max_gin", 10000);
        set("max_sen", 10000);
        set("max_mana", 10000);
        set("mana", 20000);
        set("mana_factor", 400);
        setup();
       set("chat_msg_combat", ({
   (: cast_spell, "jieti" :),
   (: cast_spell, "hufa" :),
  }) );

}
void init()
{
        object ob;

        ::init();
        set("chat_chance", 10);

         set("chat_msg", ({
 "很多年之后，我有个绰号叫做无情，任何人都可以变得无情，只要你尝试过什么叫绝望，我不会介意他人怎样看我，我只不过不想别人比我更无情 。\n",    

  "我还以为上世界上有一种人永远都不会绝望，因为他太无情了，在我出道的时候，我认识一个人，因为她喜欢听铃声，所以很多年以后，她有个绰号叫丁零 。\n", 
     "今年江湖动荡，人心惶惶，到处都有死人，有死人的地方也一定有活着的的人，那我就有生意，我叫无情，我的职业是杀手，就是杀死那些还活着的人。\n"     

    "看来你的年纪也有四十出头了，这四十多年来，总有些事你是不愿再提，或是有些人你不想再见，有的人曾经对不起你，也许你想过要杀了他们，但是你不敢。哈，又或者你觉得不值，其实杀人，很容易。我有个朋友，他的武功非常好，不过最近生活有点困难，只要你随便给他一点银两，他一定可以帮你杀了那个人，你尽管考虑一下。其实杀一个不是很容易，不过为了生活，很多人都会冒这个险。\n",
     "初六日，惊蛰。每年这个时候，都会有一个人来找我喝酒，她的名字叫丁零。这个人很奇怪，每次来的时候总是拿着个铃当，这习惯已经维持了好多年。今年，她也不例外。\n",

     "对于太古怪的东西，我向来很难接受，所以这叫“失忆”的飞刀我看上去很普通。可能这把刀真的有效，从那天晚上开始，丁零开始忘记了很多事情。\n",
      "那天晚上她喝得大醉，第二天大清早就走了。我不知道他为什么要拿那把“失忆”给我，但我看得出她有心事，每次见了我之后，她都去见一个人。\n",
       "我曾经发过誓，如果再让我碰到这个人，我一定会杀了她。但是我没有这样做，因为我看见她的时候，被剑刺痛的伤口在颤抖。\n",
       "一个人的记性不好，就不要去太多是非之地，因为你可能忘记你的仇人。每年总有几个月，人们好像不愿死似的。翌年立春后，我一直没有买卖，整个月，只有一个人来找我。\n",
       "我以前听人说过如果刀快的话，血从伤口喷出来的时候像风声一样，很好听，想不到第一次听到的是我自己流出来的血。\n",
       "水泡走了之后，天一直都很晴朗，蓝色的天空，透明的白云，坐在窗前，我就会想起一个人，我曾经很爱她，她的名字叫思思，每次想起思思时，我就会落泪，因为我今生今世都不可能再见到她。\n",
        "立春之后，很快就到了惊蛰，每年这个时候会有位朋友来看我，但是她今天没有来，也许是我把她的那把“失忆”刀弄丢了，所以那天晚上我只好一个人喝酒，我的朋友不是很多，第一次我感觉到孤独，所以我喝光了所有的酒，醉生梦死般走了出去，倒在屋外的草堆里，忽然发现了那把叫“失忆”的刀，我努力睁开眼睛，模糊地看到了一个女人。\n",
       "没有事的时候，我会坐在窗前，望着天空，我清楚的记得曾经有一个女人在那边等着我。其实“失忆”刀只不过是她跟我开的一个玩笑，她是想让我忘记那个远在天边的女人，她的名字叫思思。如果我能够再见到她，我一定会告诉她，其实我不可能忘记思思，但是，我还是会陪你一起喝酒的。只是很可惜，我再也没有见到她。\n",
       "很多年之后，江湖上出现了一家飘仙茶楼，听说它的主人不喜欢客人喝太多酒，他们只供应上好的红茶，不过知道茶楼主人的人不多，有人看见她有一把飞刀，只是他记不清那把飞刀的样子了。\n",
        "不知道为什么，我常常做同一个梦。没多久，我就离开了这个地方。那天，我记不清是什么日子了…………… \n",     
            }) );
}


void die()
{
  if (environment())
    message("sound", "\n\n无情哼了一声，想要我死，没门！\n\n", environment());

  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}

int recognize_apprentice(object ob)
{
   return 1;
}
