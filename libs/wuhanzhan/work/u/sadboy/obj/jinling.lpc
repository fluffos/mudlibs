#include <weapon.h>
: inherit WHIP;
#include <ansi.h>
inherit F_UNIQUE;

void create() {
  set_name(HIW "银索" HIY "金玲" NOR, ({ "yinsuo jinling", "suo", "whip" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条白色的绸带,前端系有两个金铃,据说金铃声音可以夺人魂魄。\n");
    set("material", "brass");
    set("no_sell", 1);
    //     set("no_drop", 1);
    //     set("no_put", 1);
    //     set("no_steal", 1);
    //     set("replace_file", "/d/obj/weapon/whip/tielian");
    set("wield_msg", HIW "$N将$n" HIW "轻扬，叮当声中,一条白色绸带忽地甩了出来。\n" NOR);
    set("unwield_msg", HIW "$N将$n" HIW "收到手中。\n" NOR);
  }
  init_whip(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("whip", 1) < 450)
    me->improve_skill("whip", random(20));
  switch (random(2)) {
    case 0: return "$w" HIW "叮当作响,仿佛天籁之音！\n" NOR;
    case 1: return "$w" HIW "铃声大作,$n顿时觉得头要炸开来！\n" NOR;
  }
}
