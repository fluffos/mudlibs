#include <ansi.h>
#include <dbase.h>
#include <armor.h>

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name(HIR "人头马" NOR, ({ "xo", "ren tou ma", "jiu" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一瓶价值不扉的洋酒,据说价值一千两黄金。\n");
    set("unit", "瓶");
    set("value", 100000);
    set("max_liquid", 1500);


    set("no_get", "拿巫师给的东西要被关的哦！\n");
    set("no_drop", "你怎么不理解酒井法子的一点心意呢？赶快收起来，要不酒井法子可就生气了！\n");
    set("no_sell", "小店是小本生意，不敢收这么贵重的东西。\n");

  }

  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": "洋酒",
    "remaining": 15,
    "drunk_apply": 5,
  ]));
}
