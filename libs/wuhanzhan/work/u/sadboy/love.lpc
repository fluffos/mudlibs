inherit NPC;
#include <ansi.h>

void create()
{
        set_name("心心", ({"xinxin"}));
        set("long", HIC "\n她长得极美，尤其是那双眼睛，媚得直可以勾人魂魄。\n"+
        "其容色晶莹如玉，映照于红红烛光之下，娇美不可方物。\n"+
        "回眸嫣然一笑，雅如仙子下凡。眼波流转之间，\n"+
        "便把一个少年的心灵，推向梦中极美的境界。\n" NOR);
        set("gender", "女性");
        set("age", 21);
        set("rank_info/respect", "小姑娘");
        set("max_kee", 10000);
        set("max_sen", 10000);
        set("force", 10000);
        set("mana",10000);
 set("max_mana",10000);
        set("inmortal",1);
        set("age", 20);
        set("attitude", "friendly");
       set("title",HIM"伤心的"HIC"女朋友"NOR);
        set("str", 50);
        set("per", 22);
        set("int", 50);
        set("con", 50);
        set("dex", 50);
        set("no_get_from", 1);        
        set_skill("force", 200);
        set_skill("dodge", 500);
        set_skill("unarmed", 500);
        set_skill("parry", 200);
        set_skill("sword", 200);
        set_skill("whip", 200);
        set_skill("blade", 200);
        set_skill("literate", 200);

        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/damage", 100);
        set("env/wimpy", 90);
        carry_object("/u/sadboy/obj/cloth.lpc")->wear();
        set("chat_chance", 10);
        set("chat_msg", ({
                "心心忽然做了个鬼脸，笑道: 真想溜出去玩会儿。\n",
                (: command("sing2") :),
                (: command("angry") :),
                (: command("slogan2") :),
                (: command("yawn") :),
                (: command("lazy") :),
                (: command("laughproud") :),                
                "心心忽然大声说：打倒臭泥潭，打倒伤心！\n",
                "心心无聊地绕着手绢，叹道: 唉，一个人，真没意思。\n",
                "心心伸出白玉雕成一般的小手，托着下巴说: 谁想和我说说话?\n",
                "心心斩钉截铁地说: 嗯，谁要敢欺负我，我就宰了他！\n",
                "心心打了个呵欠，左手轻轻掩住樱桃小口，柔声道：我困了。\n",
                (: drool :),
                (: command("reclaim") :),
                (: command("reclaim") :),
                (: command("reclaim") :),
                (: command("reclaim") :),
        }) );
        set("combat_exp", 3000000);
        set("shen_type", 1);
        set("score", 5000000);
        set("chat_chance_combat", 20);  
        
          setup();
        if( clonep() ) CHANNEL_D->register_relay_channel("chat");
}


void reset()
{
        delete("memory");
}
        

void greeting(object ob)
{
if( !ob || environment(ob) != environment() ) return;
if(!userp(ob)) return;
message_vision( "$N对$n嫣然一笑.\n\n",this_object(),ob );
if(ob->query("id")=="sadboy")
{
          ob->set("qi",10000);
          ob->set("jing",10000);
          command("say 噢，"+ob->query("name")+"公子回来了。");
}
else
{
command("say 这位" + RANK_D->query_respect(ob)
+ "，缘何无故来到小女子房中？\n");
if (ob->query("gender") == "男性"||ob->query("gender") == "无性")
{
       message_vision(
        HIM "$N一见这少女，不由得心中砰的一跳，胸口宛如被一个\n"+
        "无形的铁锤重重击了一下，霎那间唇干舌燥，目瞪口呆，\n"+        "心道：我死了，我死了！世间那来这样的美女?\n"+
        "倘若她再对我笑一笑，我就算死了也心甘啊!...\n" NOR,ob,this_object());
        command("say "+"这位" + RANK_D->query_respect(ob)+"，欢迎你有空来坐坐。");
        command("xixi");
}
else
{
       message_vision(
        HIM "$N一见这少女，不由得心中砰的一跳，胸口宛如被一个\n"+
        "无形的铁锤重重击了一下，霎那间唇干舌燥，目瞪口呆，\n"+
        "心道：我死了，我死了！世间那来这样的美女?\n"+
        "倘若我也是男子，她要我为她去死，我也决不皱一皱眉...\n" NOR,ob,this_object());
        command("say 总是有男子来惹我恼我，不想今日却来了一位" + RANK_D->query_respect(ob)+"\n");
        command("jump");
}
}
}

void die()
{
        object ob;
        command("cry");
        message_vision("\n$N娇喘一口气，说道：伤心会为我报仇的。\n", this_object());
        message_vision("$N说完，化作一缕清风而去。\n", this_object());
        }


