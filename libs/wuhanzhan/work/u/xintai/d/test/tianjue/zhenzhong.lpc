若人入此阵内，有雷鸣之处，化作灰尘；仙道若逢此处，肢体震为粉碎。
LONG);
     set("exits/east", __DIR__"tianjue"+(string)random(16));
     set("exits/west", __DIR__"tianjue"+(string)random(16));
     set("exits/south", __DIR__"tianjue"+(string)random(16));
     set("exits/north", __DIR__"tianjue"+(string)random(16));
     set("exits/down", __DIR__"zhenxin");
     set("objects", ([ /* sizeof() == 4 */
       __DIR__"npc/yao1" : 3,
]));
