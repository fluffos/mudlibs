#include <ansi.h>
inherit NPC;
void create()
{
        set_name("截教教众", ({"jiao zhong"}));
        set("age", 33);
        set("long", "截教普通教众。\n");
        set("class", "xian");
        set("combat_exp", 3000000);
        set("attitude", "aggressive");
        set_skill("unarmed", 250);
        set_skill("dodge", 250);
        set_skill("spells", 250);
        set_skill("dao", 250);
        set_skill("sword", 250);
        set_skill("sanqing-sword", 250);
        set_skill("jindouyun", 250);
        set_skill("sword", 250);
        set_skill("parry", 250);
        set_skill("wuxing-quan", 250);
        set_skill("wuxiangforce", 250);
        map_skill("force", "wuxiangforce");
        map_skill("dodge", "jindouyun");
        map_skill("parry", "sanqing-sword");
        map_skill("sword", "sanqing-sword");
        map_skill("unarmed", "wuxing-quan");
        map_skill("spells", "dao");
        set("max_kee", 4000);
        set("kee", 4000);
        set("max_sen", 4000);
        set("sen", 4000);
        set("max_force", 4000);
        set("force", 8000);
        set("max_mana", 4000);
        set("mana", 8000);
        set("mana_factor", 200);
        set("force_factor", 200);
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
        (: perform_action,"sword", "jianzhang" :),
        }) );
        setup();
        carry_object("/d/obj/cloth/zhanpao")->wear();
        carry_object("/u/gaoxiao/obj/sword")->wield();
}
void die ()
{
  object me = this_object();
  object ob = query_temp("last_damage_from");
        ob->add("kill/aaa",200);
        tell_object(ob,"你的功劳增加了。\n");
  message_vision (HIY"$N惨叫一声，死了。\n"NOR,me);
  me->move("/obj/empty");
  destruct (this_object());
  return ;
}
void unconcious() { die();}
