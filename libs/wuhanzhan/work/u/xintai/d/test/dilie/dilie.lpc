#include <ansi.h>
#include <room.h>

inherit ROOM;
void create() {
  set("short", HIG "地烈阵" NOR);
  set("long", @LONG   
地烈成分浊厚，上雷下火太无情；就是五行乾健体，难逃骨化与形倾。
中藏凝厚之体，外现隐跃之妙，变化多端，内隐一首红，招动有火起；
凡人仙进此阵，再无复生之理，纵有五行妙术，怎逃此厄？
LONG);
  set("exits/east", __DIR__ "dilie" + (string)random(16));
  set("exits/west", __DIR__ "dilie" + (string)random(16));
  set("exits/south", __DIR__ "dilie" + (string)random(16));
  set("exits/north", __DIR__ "dilie" + (string)random(16));
  set("exits/down", __DIR__ "zhenxin");
  set("objects", ([ /* sizeof() == 4 */
    __DIR__ "npc/yao1": 3,
  ]));
  set("alternative_die", 1);
  setup();
}
int valid_leave(object me, string dir) {
  object a;
  if (wizardp(me)) return 1;
  if (dir == "down") {
    if (objectp(a = present("men ren", environment(me))) &&
      living(a))
      return notify_fail("截教门人一挺手中长剑，大喝道：“想下去？先过我这关”！\n");
  }
  return 1;
}

void alternative_die(object me) {
  object who = this_object();
  string here = (string)environment(me);
  string there = who->query_temp("wzg/from");
  message_vision("元始天尊对着$N叹了一口气,摇了摇头！\n", me);
  there = "/d/33tian/33tian";
  me->move(there);
  if ((int)me->query("kee") < 1) me->set("kee", 0);
  if ((int)me->query("sen") < 1) me->set("sen", 0);
  me->set("eff_kee", me->query("max_kee"));
  me->set("eff_sen", me->query("max_sen"));
  me->unconcious();
  return;
}
