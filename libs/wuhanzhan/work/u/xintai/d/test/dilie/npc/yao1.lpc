#include <ansi.h>
inherit NPC;
void create() {
  set_name("截教门人", ({ "men ren", "ren" }));
  set("gender", "男性");
  set("age", 33);
  set("long", "截教高手。\n");
  set("class", "xian");
  set("combat_exp", 10000000);
  set("attitude", "aggressive");
  set_skill("unarmed", 380);
  set_skill("dodge", 380);
  set_skill("spells", 380);
  set_skill("dao", 380);
  set_skill("sword", 380);
  set_skill("sanqing-sword", 380);
  set_skill("jindouyun", 380);
  set_skill("sword", 380);
  set_skill("parry", 380);
  set_skill("wuxing-quan", 380);
  set_skill("wuxiangforce", 380);
  map_skill("force", "wuxiangforce");
  map_skill("dodge", "jindouyun");
  map_skill("parry", "sanqing-sword");
  map_skill("sword", "sanqing-sword");
  map_skill("unarmed", "wuxing-quan");
  map_skill("spells", "dao");
  set("max_kee", 8000);
  set("kee", 8000);
  set("max_sen", 5000);
  set("sen", 5000);
  set("max_force", 8000);
  set("force", 16000);
  set("max_mana", 8000);
  set("mana", 16000);
  set("mana_factor", 500);
  set("force_factor", 500);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "jianzhang" :),
  }));
  setup();
  carry_object("/d/obj/cloth/zhanpao")->wear();
  carry_object("/u/gaoxiao/obj/sword")->wield();
}
void kill_ob(object ob) {
  object me = this_object();
  call_out("penhuo", 0, me, ob);
  ::kill_ob(ob);
}
void penhuo(object me, object ob) {
  object xiaoyao;
  if (!me)
    return;
  if (!living(me))
    return;
  if (!ob)
    return;
  if (environment(ob) != environment(me))
    return;
  xiaoyao = new(__DIR__ "xiaoyao");
  xiaoyao->move(environment(me));
  me->command("exert recover");
  message_vision(HIY "只见$N大喊一声：“快来护阵”，居然跑出几个教众出来！\n" NOR, me, ob);
  remove_call_out("penhuo");
  call_out("penhuo", random(15) + 50, me, ob);
}
void die() {
  object me = this_object();
  object ob = query_temp("last_damage_from");
  ob->add("kill/aaa", 500);
  tell_object(ob, "你的功劳增加了。\n");
  message_vision(HIY "$N惨叫一声，死了。\n" NOR, me);
  destruct(this_object());
  return;
}
