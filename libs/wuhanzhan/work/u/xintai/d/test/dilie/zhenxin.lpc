#include <ansi.h>
#include <room.h>

inherit ROOM;
void create() {
  set("short", HIW "天绝阵主阵" NOR);
  set("long", @LONG   
天地叁寸颠倒推，玄中玄妙更难猜；神仙若遇天绝阵，顷刻肢体化成灰。
若人入此阵内，有雷鸣之处，化作灰尘；仙道若逢此处，肢体震为粉碎。
LONG);
  set("exits/up", __DIR__ "tianjue" + (string)random(16));
  set("exits/down", __DIR__ "done");
  set("objects", ([ /* sizeof() == 4 */
    __DIR__ "npc/yaowang": 1,
    __DIR__ "npc/yao1": 5,
  ]));
  set("alternative_die", 1);
  setup();
}
int valid_leave(object me, string dir) {
  object a;
  if (dir == "down") {
    if (objectp(a = present("zhao tianjun", environment(me))) &&
      living(a))
      return notify_fail("赵天君一挺手中长剑，大喝道：“想下去？先过我这关”！\n");
  }
  return 1;
}
void alternative_die(object me) {
  object who = this_object();
  string here = (string)environment(me);
  string there = who->query_temp("wzg/from");
  message_vision("元始天尊对着$N叹了一口气,摇了摇头！\n", me);
  there = "/d/33tian/33tian";
  me->move(there);
  if ((int)me->query("kee") < 1) me->set("kee", 0);
  if ((int)me->query("sen") < 1) me->set("sen", 0);
  me->set("eff_kee", me->query("max_kee"));
  me->set("eff_sen", me->query("max_sen"));
  me->unconcious();
  me->add("combat_exp", -10000);
  return;
}
