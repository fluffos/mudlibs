#include <ansi.h>
inherit F_DBASE;
void create()
{
        seteuid(getuid());
        set("name","");
        remove_call_out("choose_npc");
        call_out("choose_npc",1);
}
void choose_npc()
{
        int i, j ,k,ppl;
        object *list, newob;
        string str,m_name;
        list = users();
        i = sizeof(list);
        if (i < 20){
        remove_call_out("choose_npc");
        call_out("choose_npc",120);
        return;
        }
        while( i-- ) {
                if (!wizardp(list[i])
                && (list[i]->query("combat_exp") > 10000 ))
                {
                newob = new(__DIR__"npc1");
                newob->set("target",list[i]);
                if(newob->invocation(list[i]))
                ppl++;
                else
                destruct(newob);
                }
        }
        reset_eval_cost();
        if (ppl) {
        remove_call_out("choose_npc");
        }
        else
        {
        remove_call_out("choose_npc");
        }
}
