#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
       set_name(HIR"勇气勋章"NOR, ({"yongqi xunzhang", "xunzhang"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
     set("long",
"据说能增加勇气的装备。\n");
                set("unit", "枚");
                set("value", 2);
                set("material", "gold");
                set("armor_prop/armor", 40);
                set("armor_prop/armor_vs_force", 400);
                set("armor_prop/courage", 100);
             }
}
