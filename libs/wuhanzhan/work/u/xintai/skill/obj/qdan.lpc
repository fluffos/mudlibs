#include <ansi.h>

inherit ITEM;
void init();

void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIG "ZZZ丹" NOR, ({ "zzz dan", "dan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 10);
    set("long", "一颗绿油油的小丸子。\n");
  }
  setup();
}
int do_eat(string arg) {
  int killers;
  object victim = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  killers = (int)victim->query("killers");
  victim->clear_condition();
  victim->save();
  message_vision(HIW "\n$N不再被NPC追杀了。\n\n" NOR, victim);
  destruct(this_object());
  return 1;
}
