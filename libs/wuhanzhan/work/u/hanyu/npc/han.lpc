#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int test_player (object me);
int  do_sm();
int  do_newname(string arg);
int check_legal_name(string name, int max_len);
void init()
{
    add_action("do_newname", "name");
    seteuid(getuid());
}
void create()
{
        set_name("寒羽", ({"hanyu", "han yu"}));
        set("age", 22);
        set("gender", "男性");
   set("int", 40);
        set("long",
"寒羽是个超级混混，也不知道是怎么混的，居然混得不错，不要小瞧了哦！\n");
   set("title", "无名混混");
        set("attitude", "friendly");
   set("class", "scholar");
        set("combat_exp", 4000000);
        set("shen_type", 1);
   set("max_force", 40000);
   set("force", 40000);
  set("inquiry", ([
        "名字":   (: test_player :),
        "name": (: test_player :),
      ]));
   setup();
}
int  do_sm()
{
    object me = this_player();
   int  name_num;
   if( me->query("balance") < 500000 )
      return notify_fail("想改名字费用太高，你还是先去发财吧。\n");
   if( me->query("combat_exp") < 2000000)
     return notify_fail("你的道行不够，不能随意更改姓名哦。\n");
   if( me->query("max_force") < 3000 )
     return notify_fail("你的内力不够，不能随意更改名字哦。\n");
   if( me->query("max_mana") < 3000)
     return notify_fail("你的法力不够，不能更改名字哦。\n");
   return 1;   
}
int check_legal_name(string name, int max_len)
{
   int i;
   string   *legalname;     //not implemented..may add later
   i = strlen(name);
    if( (strlen(name) < 2) || (strlen(name) > max_len ) ) {
       write( sprintf("对不起，你的名字必须是 1 到 %d 个中文字。\n",
        max_len/2) );
     return 0;
    }
    while(i--)   {
       if( name[i]<=' ' )   {
         write("对不起,中文字不能用控制字元。\n");
         return 0;
       }
       if( i%2==0 && !is_chinese(name[i..<0]) )  {
         write("对不起，请您用「中文」给自己取名字。\n");
         return 0;
       }
    }
    return 1; 
}
int  do_newname(string arg)
{
   string name, newname;
   object ob, me=this_player();
   if( !arg || arg == "") 
      return notify_fail("请用 name 新中文名来改你的名字。\n");
   if( sscanf(arg, "%s", newname) != 1)
      return notify_fail("请用 name 新中文名来改你的名字。\n");
   newname += "$NOR$";      
   arg = newname;
        arg = replace_string(arg, "$BLK$", "");
        arg = replace_string(arg, "$RED$", "");
        arg = replace_string(arg, "$GRN$", "");
        arg = replace_string(arg, "$YEL$", "");
        arg = replace_string(arg, "$BLU$", "");
        arg = replace_string(arg, "$MAG$", "");
        arg = replace_string(arg, "$CYN$", "");
        arg = replace_string(arg, "$WHT$", "");
        arg = replace_string(arg, "$HIR$", "");
        arg = replace_string(arg, "$HIG$", "");
        arg = replace_string(arg, "$HIY$", "");
        arg = replace_string(arg, "$HIB$", "");
        arg = replace_string(arg, "$HIM$", "");
        arg = replace_string(arg, "$HIC$", "");
        arg = replace_string(arg, "$HIW$", "");
        arg = replace_string(arg, "$NOR$", "");
   if( !check_legal_name(arg, 12) )   {
      return 1; 
   }
   arg = newname;
        arg = replace_string(arg, "$BLK$", BLK);
        arg = replace_string(arg, "$RED$", RED);
        arg = replace_string(arg, "$GRN$", GRN);
        arg = replace_string(arg, "$YEL$", YEL);
        arg = replace_string(arg, "$BLU$", BLU);
        arg = replace_string(arg, "$MAG$", MAG);
        arg = replace_string(arg, "$CYN$", CYN);
        arg = replace_string(arg, "$WHT$", WHT);
        arg = replace_string(arg, "$HIR$", HIR);
        arg = replace_string(arg, "$HIG$", HIG);
        arg = replace_string(arg, "$HIY$", HIY);
        arg = replace_string(arg, "$HIB$", HIB);
        arg = replace_string(arg, "$HIC$", HIC);
        arg = replace_string(arg, "$HIM$", HIM);
        arg = replace_string(arg, "$HIW$", HIW);
        arg = replace_string(arg, "$NOR$", NOR);
   ob->set("name", arg);
   ob->save();     
   write("你的名字改动成功。\n");
   return 1;
}
