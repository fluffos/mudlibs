// gougou.c

inherit NPC;

void create() {
  set_name("小狗狗", ({ "gou" }));
  set("race", "野兽");
  set("age", 3);
  set("long", "一只长得很可爱的小狗狗。\n");

  set("str", 30);
  set("dex", 30);

  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("chat_chance", 6);
  set("chat_msg", ({
    (: call_other, this_object(), "random_move" :),
    "小狗狗对着你摇了摇尾巴。\n" }));

  set_temp("apply/attack", 10);
  set_temp("apply/armor", 3);

  setup();
}

int accept_object(object who, object ob) {
  if (ob->id("gutou")) {
    set_leader(who);
    message("vision", name() + "高兴地汪汪叫了起来,愉快的跟着看不清楚出去散步去了。\n", environment()); ;
    command("follow " + who->query("id"));
    command("愉快的跟着看不清楚出去散步了。");
    return 1;
  }
}
