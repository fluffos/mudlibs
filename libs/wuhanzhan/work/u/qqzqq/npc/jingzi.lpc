#include <ansi.h>
inherit NPC;
void create()
{
        set_name( MAG "魔镜" NOR, ({ "mo jing", "jing", "mo" }) );
        set("long", "拥有探知世界上最美丽的人的魔力，不要对它的话有任何的怀疑，因为它的魔力来自阿赖耶识。\n");
        set("title", "魔力无穷");
  set("gender", "男性");
  set("age", 999);
  set("attitude", "peaceful");
  set("combat_exp", 1000000);
  set_skill("unarmed", 220);
  set_skill("parry", 220);
  set_skill("dodge", 220);
  set("chat_chance", 1);
        set("chat_msg", ({
                    name()+"说道：你可以向我询问有关谁是世界上最美丽的人。\n",
                    }));

  set("inquiry", ([ // 开始
   "镜子啊镜子，谁是世界上最美丽的人？":     "在你翻过九百座山，淌过九百条河的时候，在有九个月亮辉映的地方住着一位名叫看不清楚(Qqzqq)的女孩，看不清楚就是世界上最美丽的人",
   "谁是世界上最美丽的人":     "在你翻过九百座山，淌过九百条河的时候，在有九个月亮辉映的地方住着一位名叫看不清楚(Qqzqq)的女孩，看不清楚就是世界上最美丽的人",
   "谁是世界上最美丽的人？":     "在你翻过九百座山，淌过九百条河的时候，在有九个月亮辉映的地方住着一位名叫看不清楚(Qqzqq)的女孩，看不清楚就是世界上最美丽的人",
   "漂漂":     "看不清楚是最最好看的了！！！",
 "镜子啊镜子，谁是世界上最难看的人啊？":     "在你穿过九百个树林，越过九百条阴沟，有九百只蝙蝠出没的山洞，那里住着一位名叫阿印(Whip)的男孩，阿印就是世界上最难看的人",
   "镜子啊镜子，谁是世界上最讨厌的人呢？":     "这还要问啊？白蜻蜓就是最最讨厌的了！！！",
       ]));
  setup();
}

