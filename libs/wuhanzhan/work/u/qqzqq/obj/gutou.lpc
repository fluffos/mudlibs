// gutou.c 肉骨头
//By qqzqq 1/3/2001
#include <weapon.h>

inherit HAMMER;
inherit F_FOOD;

void create() {
  set_name("肉骨头", ({ "gutou", "gutou" }));
  set_weight(350);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根肉骨头。\n");
    set("unit", "根");
    set("value", 300);
    set("food_remaining", 4);
    set("food_supply", 40);
    set("wield_msg", "$N抓起一根$n，握在手中当武器。\n");
    set("material", "gutou");
  }
  init_hammer(1);
  setup();
}

int finish_eat() {
  if (!query("weapon_prop")) return 0;
  set_name("骨头", ({ "gutou" }));
  set_weight(150);
  set("long", "一根没有肉了的骨头。\n");
  return 1;
}
