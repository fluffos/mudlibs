#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIW "凝雪剑" NOR, ({ "xuesword", "jian", "sword" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 700);
    set("material", "steel");
    set("long", HIW "一把晶莹剔透的冰剑。\n" NOR);
    set("wield_msg", HIW "\n$N拿出一把凝雪剑握在手中，刹那间满天飞雪，天地间一片银白。\n\n" NOR);
    set("unwield_msg", HIW "\n$N放下手中的凝雪剑,满天飞雪立即停住了。\n\n" NOR);
    set("weapon_prop/courage", 4);
  }
  init_sword(100000000);
  setup();
}
