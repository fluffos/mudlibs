#include <ansi.h>
#include <command.h>
inherit ROOM;

void create ()
{
     set("short", HIM"古墓"NOR);
  set ("long", @LONG
    
    这里是龙儿的房间，昏暗的光线让你什么也看不清,
只有桌上一张小小的白色便条纸（sigh）和墙上的几幅
书法（words)却看得异常清晰。   

LONG);

        set("sleep_room",1);
        set("if_bed",1);
  set("exits", ([ /* sizeof() == 2 */
   "kz"       : "/d/city/kezhan",
   "npc"       : "/u/forsky/workroom",
]));

  set("valid_startroom",1);

set("item_desc", ([
                "words" : HIC "\n红颜若是只为一段情，就让一生只为这段情，一生只爱一个人，一世只怀一种愁。\n" NOR,
                "sigh" : MAG "\n我的心，我的情，不要求你明了，只要我对你好，这样的温柔你要不要？\n" NOR,
                   ]));
  setup();
}

 

void init()
{
  add_action("block_cmd","",1);
  add_action("do_yundao","yundao");
  add_action("do_qing","qing");
  add_action("do_out","out");
  add_action("do_enter","enter");
  add_action("do_xi","xi");
  add_action("do_chong","chong");  
  add_action("do_zheng","zheng");
  add_action("do_xun","xun");

}


int block_cmd(string arg)
{
 string verb;
 verb=query_verb();
  if(verb=="smash") return 1;
 return 0;
}

int do_yundao(string arg)
{
  object who=this_player();
   if(!arg) return notify_fail("你要干什么？\n");
   if(wizardp(who)&&who->query("id")=="rongay")
//   if(wizardp(who)&&who->("id")=="rongay")

     {
       object ob;
       ob=find_player(arg);
       if(ob&&environment(ob)==this_object())
        {
           message_vision(HIW"只见$N冲着$n眨了眨$P的大眼睛，$n把持不住，当场晕倒在地！\n"NOR,who,ob);
//          ob->set("env/immortal",0);
//          ob->die();
            ob->unconcious();   
          return 1;
        }
 }
    else return notify_fail("在龙儿的房间里捣乱好象不太好吧？\n");
}

int do_qing(string str)
{
        object ob;
        object me=this_player();
        if (!str) return notify_fail("<用法>: qing <player id>\n");
        ob = LOGIN_D->find_body(str);
        if (!ob) ob = find_living(str);
        if (!ob) return notify_fail("咦．．． 有这个人吗？\n");

        ob->move(environment(me));
        tell_object(ob,"好消息！龙儿美眉邀请你去她家作客！\n");

        tell_object(me, "你邀请"+(string)ob->query("name")+"到你家作客。\n");

        return 1;
}

int do_enter(string arg)
{
        object me=this_player();
        int i;
        object *inv;   
   
  if(wizardp(me)&&me->query("id")=="rongay"||me->query("id")=="npc")
        {
                if(me->query_temp("ended")) 
                return notify_fail("你已经在浴室里面了。\n");

        message_vision("$N哼着“美人鱼要洗澡”的小曲，高高兴兴的走进了浴室。（嘿嘿嘿！）\n\n", me);
        inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                                REMOVE_CMD->do_remove(me, inv[i]);
        me->set_temp("ended",1);
        
        return 1;
}

    else return notify_fail("小甜甜美眉是不会让你进她的浴室的！\n");
}
       
int do_xi(string arg)
{
        object me=this_player();

        if(!me->query_temp("ended"))    
                return notify_fail("你不在浴室里，洗什么洗呀？\n");

        message_vision(HIW"$N坐在浴缸里美美的洗了起来。\n"NOR, me);
        message_vision(HIW"整个浴室被$N弄的全都是泡泡。\n\n"NOR,me);

        tell_room(environment(me), HIC"洗了洗了！"+me->name()+"mm洗澡了！！\n"NOR, ({me}));
        return 1;
}       

int do_chong(string arg)
{
        object me=this_player();

        if(!me->query_temp("ended"))    
                return notify_fail("你不在浴室里，洗什么洗呀？\n");

        message_vision(HIW"$N打开喷头冲了冲身子。\n"NOR, me);
        message_vision(HIW"缓缓的水流撒在$N的身上，真的是很舒服哦。 \n\n"NOR,me);

        tell_room(environment(me), HIC"冲了冲了！"+me->name()+"mm冲澡了！！\n"NOR, ({me}));
        return 1;
}       

int do_zheng(string arg)
{
        object me=this_player();

        if(!me->query_temp("ended"))    
                return notify_fail("你不在浴室里，洗什么洗呀？\n");

        message_vision(HIW"$N捧起一把清水撒在烧的通红的石头上。\n"NOR, me);
        message_vision(HIW"滚烫的石头遇水，发出滋滋的响声。一粒粒的汗珠开始从$N的肌肤渗了出来。\n\n"NOR,me);
        
        tell_room(environment(me), HIC"快看快看！"+me->name()+"mm洗桑拿了！！\n"NOR, ({me}));
        return 1;
}       

int do_xun(string arg)
{
        object me=this_player();

        if(!me->query_temp("ended"))    
                return notify_fail("你不在浴室里，洗什么洗呀？\n");

        message_vision(HIW"$N打开蒸汽调节阀，美美的享受着。\n"NOR, me);
        message_vision(HIW"浴室里一片雾气腾腾。。。\n\n"NOR,me);
        
        tell_room(environment(me), HIC"什么呀！里面什么也看不清！没劲没劲！！\n"NOR, ({me}));
        return 1;
}       


int do_out(string arg)
{
        object me=this_player();

        if(!me->query_temp("ended"))    
                return notify_fail("你还没有进浴室呢。。。\n");

        message_vision(HIW"$N舒舒服服的洗了一个澡，精神饱满的走了出来。\n\n"NOR, me);
        
        tell_room(environment(me), HIC"行了，"+me->name()+"洗完了，别看了。也都洗洗睡了吧。\n"NOR, ({me}));
        
        me->delete_temp("ended");
        
        return 1;
}       

