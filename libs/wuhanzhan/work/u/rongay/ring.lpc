#include <ansi.h>
#include <dbase.h>
#include <armor.h>
inherit F_AUTOLOAD;

inherit FINGER;

void create() {
  set_name(MAG "天长地久" NOR, ({ "jiezhi", "ring" }));
  set("weight", 100);
  set("long", MAG "戒指,慕容公子送给龙儿的定情戒指，它代表爱情天长地久！
\n" NOR);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("no_drop", "老公送的啊，别丢好吗？。\n");
    set("no_steal", "老公送的啊，别丢好吗？。\n");
    set("no_put", "老公送的啊，别丢好吗？。\n");
    set("no_get", "老公送的啊，别get好吗？。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 1);
  }
  setup();
}

int query_autoload() { return 1; }
