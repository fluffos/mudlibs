#include <room.h>
inherit ROOM;
void reset();

void create()
{
  set ("short","黑暗神殿"); 
  set ("long", @LONG
阴深的大殿到处是残垸断壁，几缕光线透过大殿的天穹
射下来。大殿的正中央有个祭坛，祭坛上密密麻麻不知刻的
什么文字(jitan)这里就是传说中黑暗神殿。
LONG); 
  set("item_desc",([ 
         "jitan":"
　传说中在这里自杀的人如果能得到天神(admin)血的祭奠便
　能具有神奇的魔法，自由来往与阴阳之间…… \n",
         ]));
  set("no_clean_up", 1);
  setup();
}       
void init()
{
  add_action("do_jidian", "jidian");
  add_action("do_dixue","dixue");
  add_action("do_zhou","zhou");
}
   int do_jidian(string arg)
{
        
    object me=this_player(); 
    message_vision("\n$N拿出一把匕首，轻轻的在手腕上划开一条口子。\n\n", me);
    message_vision("\n顿时$N的鲜血如注……\n\n",me);
      return 1;

}

int do_dixue(string arg)
{
    object me=this_player();
    message_vision("\n$N把自己的血慢慢滴在祭坛上……\n\n",me);
   message_vision("\n只听见大殿外面 飓风骤起，风沙走石，轰隆隆的闷雷由远及近。\n\n",me);
       return 1;
}    

int do_zhou(string arg)
{  
   object me=this_player();
   message_vision("\n只见$N口里默默念着什么…… 双手往上一举。\n\n",me);
   message_vision("突然一声巨响，一道白色的光柱从神殿的天穹直射祭坛，你几乎被这道光照挣不开眼睛。\n\n",me);
   message_vision("\n$N双手一指，只见那道白光从祭坛上折射到你的身上……\n\n",me);
   message_vision("\n神殿之门打开了。\n\n",me);
   return 1;
}

