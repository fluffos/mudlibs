inherit ROOM;
#include <ansi.h>

int block_cmd(string);
void create() {
  set("short", "流氓兔の麻将馆");
  set("long", @LONG

流氓兔麻将馆紧靠长安城中心，是政府唯一合法的麻将馆，所以生意
非常兴隆。
LONG);

  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "room",
  ]));
  set("objects", ([ /* sizeof() == 3 */
    "/u/bqt/room/mjroom/tu": 1,
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("resource", ([ /* sizeof() == 1 */
    "water": 1,
  ]));
  setup();
}

void init() {
  add_action("block_cmd", "", 1);
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();

  // if (verb == "bian") return 1; // by mon 7/15
  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  return 0;
}

int valid_leave(object me, string dir) {

  if (!me->query_temp("rent_paid") && dir == "east")
    return notify_fail("流氓兔满脸堆笑地挡住了你：对不起,MONEY MONEY MONEY。\n");
  tell_object(me, "你将信箱交回给邮差。\n");
  return ::valid_leave(me, dir);
}
