// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
inherit NPC;

int give_book ();

void do_xyj();

void create()
{
   set_name("丫丫",({ "yaya" }) );
        set("gender", "女性" );
        set("age", 14);
   set("long", 
     "她是武汉西游记站的导游小姐。            \n");
        set_temp("apply/defense", 5);
   set("title","导游小姐");
   set("combat_exp", 8000); 
   set("inquiry", ([
    "name":" 我是武汉西游记站地导游小姐，丫丫。\n",
    "here":"这里是武汉西游记站。\n", 
    "导游" : (: give_book :),
   ]) );
   set("per", 40);   ;
   set("attitude", "friendly");
   set("chat_chance",3);  
   set("chat_msg", ({  
    (: do_xyj :)
      })); 
   setup();
   carry_object("/d/obj/cloth/pink_cloth")->wear();
   carry_object("/d/obj/books-nonskill/book-qujing");
   set("books",5);
   add_money("silver", 20); 
  }

 void do_xyj()
   {
    command("xyj 欢迎来武汉西游记站：202.103.45.19 8888");
    }
  
int give_book()
{
  object who = this_player();
  object book;

  if (query("books") <= 0)
  {
    command ("shake");
    return 1;
  }
  
  book = new ("/d/obj/books-nonskill/book-qujing");
  add("books",-1);
  message_vision ("丫丫给$N一本$n。\n",who,book);
  book->move(who);
  return 1; 
}



