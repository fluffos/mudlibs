#include <localtime.h>
#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIR "打麻将三差一" NOR, ({ "xsina" }));
  set("title", HIY "今夜陪你玩" NOR);
  set("gender", "女性");
  set("long",
    "她的任务就是陪你熬夜。\n"
  );
  set("age", 60);
  set("max_force", 6000);
  set("max_mana", 6000);
  set("class", "xian");
  set("attitude", "peaceful");
  set("per", 30);
  set("combat_exp", 10000000);
  set("daoxing", 10000000);

  set_skill("dodge", 500);

  set_skill("sword", 500);
  set_skill("force", 500);
  set_skill("dragonstep", 500);
  set_skill("lengquan-force", 500);
  set_skill("sanqing-jian", 500);
  set_skill("parry", 500);
  set_skill("dragonfight", 500);
  map_skill("force", "lengquan-force");
  map_skill("sword", "sanqing-jian");
  map_skill("parry", "sanqing-jian");
  map_skill("unarmed", "dragonfight");
  map_skill("dodge", "dragonstep");

  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force_factor", 500);
  set("mana_factor", 500);

  setup();
}
void init() {
  add_action("do_tongxiao", "tongxiao");
}
int do_tongxiao() {
  string e_time, week, month, year;
  string c_week, c_year, c_month, c_time;
  object me = this_object();
  object who = this_player();
  object obj;
  int last, now, gain, getwx, getdx;
  int day, hour, minute, second;
  e_time = ctime(time());
  sscanf(e_time, "%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);
  getwx = who->query("combat_exp") / 500;
  getdx = who->query("combat_exp") / 500;
  last = who->query("gettime");
  gain = who->query("mud_age") - last;
  if (getwx < 1000) getwx = 1000 + random(500);
  if (getdx < 2000) getdx = 2000 + random(500);
  if (hour > 8) return notify_fail("哦!请问.现在是通宵么???? \n");
  if (who->query("age") < 16) return notify_fail("你可能还没有资格要随机(gift)! \n");
  if (gain < 86400) return notify_fail("还没有到时间呢! \n");
  if (gain = 86400 && hour < 8) tell_object(who, HIW "该你领取通宵礼物的时候了 ! \n");
  if (who->query("combat_exp") < 100000) return notify_fail("你是那里来的大米!!?? \n");
  switch (random(5)) {
    case 0:
      obj = new("/u/bqt/obj/hesw.lpc");
      obj->move(who);
      who->set("gettime", who->query("mud_age"));
      tell_object(who, "你得到一枚何首乌!\n");
      break;
    case 1:
      obj = new("/clone/money/thousand-gold.lpc");
      obj->move(who);
      who->set("gettime", who->query("mud_age"));
      tell_object(who, "你得到一张一千两的金票!\n");
      break;
    case 2:
      who->add("potential", 50000);
      who->set("gettime", who->query("mud_age"));
      tell_object(who, "你得到了50000点潜能!\n");
      break;
      break;
    case 3:
      who->add("combat_exp", getdx);
      who->set("gettime", who->query("mud_age"));
      tell_object(who, "你得到了" + getdx + "点道行\n");
      break;

  }
  who->start_busy(5);
  message(
    "channel:chat",
    HIY + "【通宵快讯】：听说" + who->query("name") + "拿到了通宵礼物! 恭喜恭喜! \n" NOR,
    users()
  );
  return 1;
}
