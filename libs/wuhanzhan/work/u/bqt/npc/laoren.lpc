inherit NPC;

int give_libao ();
void create()
{
  set_name("圣诞老人", ({ "shengdan laoren", "laoren" }));
  set("title","圣诞礼物使者");
  set("gender", "男性");
  set("age", 100);
  set("attitude", "peaceful");
  set("str",40);
  set("per",40);
  set("max_force", 3000);
  set("force_factor", 100);
  set("force", 6000);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 100);
  set("combat_exp", 5500000);
  set_skill("literate", 800);
  set("inquiry", ([
    "圣诞快乐" : (: give_libao :),  ]) );

  setup();
}

int give_libao()
{
  int giving;
  object me = this_object();
  object who = this_player();
  object bao; 
  
  if ( (who->query("give_libao")) > 1 ) 
    {
     command("shake");
     tell_object(who,"你已经要过了，不要太贪心了！\n");          }
                           else
                           {
  bao = new ("/u/bqt/obj/libao"); 
  bao->move(who); 
  who->set("give_libao",12);
  command ("grin");
  message_vision("$N给$n一个"+bao->query("name")+"。\n",me,who);
  who->save();
  return 1; }
  destruct(bao);
   return 1;
 }
 

