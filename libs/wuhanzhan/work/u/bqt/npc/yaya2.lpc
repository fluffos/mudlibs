inherit NPC;
#include <ansi.h>

int yuan_xiao();

void create() {
  set_name(HIC "丫丫" NOR, ({ "yuanxiao jiaren", "sister", "yaya", }));
  set("title", HIW "元宵佳人" NOR);
  set("long", "。\n");
  set("gender", "女性");
  set("age", 18);
  set("attitude", "peaceful");
  set("class", "xian");
  set("per", 30);

  set("max_mana", 5000);
  set("max_force", 5000);
  set("combat_exp", 10000000);

  set("inquiry", ([
    "元宵佳节": (: yuan_xiao :),
  ]));

  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_eat(object who) {
  object me = this_object();
  object guo; int size;
  string *strs;
  mapping skills = who->query_skills();
  int i;

  if (who->query("nian/200115"))
    return;


  size = sizeof(skills);

  command("xixi " + who->query("id"));
  message_vision("\n$N对$n说：" + RANK_D->query_respect(who) +
    HIM "过元宵了，来来来，吃个汤圆，看看花灯！\n", me, who);
  tell_object(who, HIY "你一口吞下个烫烫的汤圆，差点把舌头汤掉!\n");
  who->add("nian/200115", 1);
  who->add("potential", 100000);
  who->add("max_force", 100);
  who->add("max_mana", 100);
  tell_object(who, "你得到了十万潜能！\n");
  tell_object(who, "你得到了一百点内力和法力！\n");
  strs = keys(skills);
  for (i = 0; i < size; i++) {
    call_out("eating", i / 50, me, who, strs[i]);
  }

}


void eating(object me, object who, string str) {
  int i = who->query_skill(str, 1);
  int nian;
  string name = to_chinese(str);

  if (i > 400) nian = 3;
  else if (i > 300) nian = 5;
  else if (i > 200) nian = 7;
  else if (i > 100) nian = 10;
  else nian = 12;

  who->set_skill(str, i + nian);
  tell_object(who, "你得到了" + chinese_number(nian) + "级" + name + "！\n");
}

int yuan_xiao() {
  object me = this_object();
  object who = this_player();

  if (me->is_busy()) {
    message_vision("$N对$n说道：这位" + RANK_D->query_respect(who) + "，我正忙着哩！\n", me, who);
    return 1;
  }

  if (who->is_busy()) {
    message_vision("$N对$n说道：" + RANK_D->query_respect(who) + "不用心急，正在煮呢。\n", me, who);
    return 1;
  }

  if (who->query("nian/200115")) {
    message_vision(HIR "$N对$n说道：你已经吃了哦！\n", me, who);
    command("maoli " + who->query("id"));
    return 1;
  }

  do_eat(who);
  return 1;
}
