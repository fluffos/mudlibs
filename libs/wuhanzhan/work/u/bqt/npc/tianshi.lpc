inherit NPC;
#include <ansi.h>

string try_me(object me);

void create()
{
        set_name(HIW"天使长", ({"tianshi zhang", "angel"}));
        set("title", "");
        set("gender", "男性");
        set("age", 30);

        set("combat_exp", 350000);
        set_skill("unarmed", 300);
        set("force", 300);
        set("force_factor", 300);
        set_skill("dodge", 300);
        set_skill("parry", 300);
        setup();
        carry_object("/ymdh/obj2/cloth")->wear();
        carry_object("/ymdh/obj2/finger")->wear();
        carry_object("/ymdh/obj2/shield")->wear();
        carry_object("/ymdh/obj2/kui")->wear();
        carry_object("/ymdh/obj2/armor")->wear();
        carry_object("/ymdh/obj2/waist")->wear();
        carry_object("/ymdh/obj2/waists")->wear();
        carry_object("/ymdh/obj2/neck")->wear();
        carry_object("/ymdh/obj2/pifeng")->wear();
        carry_object("/ymdh/obj2/hands")->wear();
        carry_object("/ymdh/obj2/boots")->wear();  
          
      }
void throw (object who, string where)
{
  string dir;
  dir = "/d/city/";
  who->move(dir+where+".lpc");
}


void init()
{
        add_action("do_answer", "answer");
}
void throws (object who)
{
  message_vision("话音未落，从城堡内冲出几个天使，将$N拖起就走！\n",who);
  throw(who,"kezhan");
  message_vision("扑通一声，$N整整凌乱的衣冠，从地上勉强地爬上来。\n",who);
  who->interrupt_me();
}
void throw_player (object who)
{
  say(NAME+"大喝一声：来人！把这个混帐给轰城堡！\n");
  call_out ("throws",1,who);
}
void reject_player (string msg, object who)
{
  say(msg, who);
  who->start_busy(3,3);
  call_out ("throw_player",1,who);
}
void invite_player (object who)
{
  string dir;
  dir = "/d/city/";
  message_vision("门外的几个天使走进来，十分老练地簇拥起$N就走！\n",who);
  who->move(dir+"tianshicheng.lpc");
  message_vision("天使将$N留在这里，什么都没说就匆匆地走了。\n",who);
}

void ask_player (object who)
{
  string msg;
  msg = NAME+"严肃的说道："+RANK_D->query_respect(who);
  say(msg+"城堡重地不的到处乱跑\n\n");
  call_out ("ask_condition",1,who);
void ask_condition (object who)
{
  string msg;
  msg = NAME+"继续说道：你想入城？";
  say(msg+"\n");
  who->set_temp("tianshi_answer",1);
  tell_object(who,"\n请用answer回答暗号。\n");
}

void send_to_tianshicheng (object who)
{
  string msg;
  msg = NAME+"说道：这位"+RANK_D->query_respect(who);

  message_vision (msg+"既然对了，！\n",who);
  
  call_out ("invite_player",1,who);
} 
int do_answer(string arg)
{
  object who;

  who = this_player();

  if (! who->query_temp("tianshi_answer"))
    return notify_fail("什么？\n");

  if (!arg)
    return notify_fail("你要回答什么？\n");

  who->set_temp("princess_answer",0);
  message_vision("$N答道："+arg+"\n", who);
  if (arg == "TMD")
    send_to_tianshicheng (who);
    else
    message_vision (NAME+"对$N皱起眉头。\n",who);
    who->move(/d/city/kezhan.c);
  return 1;
}




