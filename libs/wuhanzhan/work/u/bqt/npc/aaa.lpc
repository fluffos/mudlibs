#include <ansi.h>
inherit NPC;

int bu_chang ();

void create()
{
  set_name(HIY "钦差大臣" NOR, ({ "qinchai dachen", "dachen",}));
  set("long", "武汉站的钦差大臣。\n");
  set("gender", "男性");
  set("age", 80);
  set("attitude", "peaceful");
  set("class", "xian");
  set("per",30);
 
  set("max_mana",5000);
  set("max_force",5000);
  set("combat_exp",1000000);
    
  set("inquiry", ([
    "西行" : (: bu_chang :),
  ]) );
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_bu (object who)
{
  object me = this_object();
  object guo;  int size;
  string *strs;
  mapping skills = who->query_skills();
  int i;
    if (who->query("nian/123"))
    return;

  
  size = sizeof(skills);
    
  command("pat "+ who->query("id"));
  message_vision ("\n$N对$n说："+RANK_D->query_respect(who)+
                  "祝你西行愉快！\n",me,who);
  who->add("nian/123",1);
  who->add("potential",100000);
  who->add("max_force",250);
  who->add("combat_exp", 100000);
  who->add("max_mana",250);
  who->set_skill("dodge",70);
  who->set_skill("spells",70);
  who->set_skill("force",70);
  who->set_skill("unarmed",70);
  who->set_skill("literate",70);
  who->set_skill("parry",70);
  tell_object(who,"你得到了十万点潜能!\n");
  tell_object(who,"你得到了二百五十点内力和法力!\n");
  tell_object(who,"你得到了100年的道行!\n");
  
}


  
int bu_chang ()
{
  object me = this_object();
  object who = this_player();
 
  if( me->is_busy() ) {
    message_vision ("$N对$n说道：这位"+RANK_D->query_respect(who)+"，我正忙着哩！\n",me,who);
    return 1;
    }
        
  if( who->is_busy() ) {
    message_vision ("$N对$n说道："+RANK_D->query_respect(who)+"不用心急，正在给你呢。\n",me,who);     
    return 1;
    }
  if (who->query("nian/123"))
  {
    message_vision ("$N对$n说道：你已经问了哦!\n",me,who);
    command("maoli "+ who->query("id"));
    return 1;
  }
   do_bu (who);
  return 1;
}

