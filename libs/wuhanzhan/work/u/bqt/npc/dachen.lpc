#include <ansi.h>
inherit NPC;

int bu_chang();

void create() {
  set_name(HIY "钦差大臣" NOR, ({ "qinchai dachen", "dachen", }));
  set("title", HIW "武汉站事故补偿委员会" NOR);
  set("long", "武汉站事故补偿委员会钦差大臣，白蜻蜓让他来人间进行事故调查,体恤玩家。\n");
  set("gender", "男性");
  set("age", 80);
  set("attitude", "peaceful");
  set("class", "xian");
  set("per", 30);

  set("max_mana", 5000);
  set("max_force", 5000);
  set("combat_exp", 1000000);

  set("inquiry", ([
    "补偿": (: bu_chang :),
  ]));
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_bu(object who) {
  object me = this_object();
  object guo; int size;
  string *strs;
  mapping skills = who->query_skills();
  int i;
  if (who->query("nian/123"))
    return;
  if (((int)who->query("combat_exp") < 50000))
    return;


  size = sizeof(skills);

  command("pat " + who->query("id"));
  message_vision("\n$N对$n说：" + RANK_D->query_respect(who) +
    "根据白蜻蜓宣布的补偿原则,对你进行如下补偿\n", me, who);
  who->add("nian/123", 1);
  who->add("potential", 1000000);
  who->add("max_force", 150);
  who->add("combat_exp", (int)who->query("combat_exp") / 10);
  who->add("max_mana", 150);
  tell_object(who, "你得到了一百万点潜能!\n");
  tell_object(who, "你得到了一百五十点内力和法力!\n");
  tell_object(who, "你得到了10%的道行!\n");
  strs = keys(skills);
  for (i = 0; i < size; i++) {
    call_out("buing", i / 50, me, who, strs[i]);
  }

}


void buing(object me, object who, string str) {
  int i = who->query_skill(str, 1);
  int nian;
  string name = to_chinese(str);

  if (i > 550) nian = 5;
  else if (i > 450) nian = 10;
  else if (i > 350) nian = 15;
  else if (i > 250) nian = 20;
  else if (i > 150) nian = 25;
  else if (i > 100) nian = 30;
  else nian = 50;

  who->set_skill(str, i + nian);
  tell_object(who, "你得到了" + chinese_number(nian) + "级" + name + "！\n");
}

int bu_chang() {
  object me = this_object();
  object who = this_player();

  if (me->is_busy()) {
    message_vision("$N对$n说道：这位" + RANK_D->query_respect(who) + "，我正忙着哩！\n", me, who);
    return 1;
  }

  if (who->is_busy()) {
    message_vision("$N对$n说道：" + RANK_D->query_respect(who) + "不用心急，正在给您补偿呢。\n", me, who);
    return 1;
  }
  if (who->query("nian/123")) {
    message_vision("$N对$n说道：你已经领过补偿了哦!\n", me, who);
    command("maoli " + who->query("id"));
    return 1;
  }
  if (((int)who->query("combat_exp") < 50000)) {
    message_vision("$N对$n说道,你是大米,不要滥竽充数!\n", me, who);
    command("slap" + who->query("id"));
    return 1;
  }

  do_bu(who);
  return 1;
}
