inherit NPC;
#include <ansi.h>

int give_dan ();
void create()
{
  set_name(HIY"雅雅", ({ "yaya", "ya ya" }));
  set("title",HIW"端午小MM");
  set("gender", "女性");
  set("age", 10);
  set("attitude", "peaceful");
  set("str",40);
  set("per",40);
  set("max_force", 3000);
  set("force_factor", 100);
  set("force", 6000);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 100);
  set("combat_exp", 5500000);
  set_skill("literate", 800);
  set("inquiry", ([
    "端午节快乐" : (: give_dan :),  ]) );
  setup();
}

int give_dan()
{
  int giving;
  object me = this_object();
  object who = this_player();
  object dan; 
  
  if ( (who->query("give_dan")) > 1 ) 
    {
     command("shake");
     tell_object(who,"你已经要过了，不要太贪心了！\n");          }
                           else
                           {
  dan = new ("/u/bqt/obj/dan"); 
  dan->move(who); 
  who->set("give_dan",520);
  command ("grin");
  message_vision("$N给$n一个"+dan->query("name")+"。\n",me,who);
  who->save();
  return 1; }
  destruct(dan);
   return 1;
 }

