inherit NPC;
#include <ansi.h>

int bai_nian ();

void create()
{
  set_name(HIW "小龙马" NOR, ({ "xiao longma", "longma","ma", }));

  set("title", HIY "新年使者" NOR);
  set("long", "一匹会飞的龙马。\n");
  set("gender", "女性");
  set("age", 18);
  set("attitude", "peaceful");
  set("class", "xian");
  set("per",30);
 
  set("max_mana",5000);
  set("max_force",5000);
  set("combat_exp",10000000);
    
  set("inquiry", ([
    "新年快乐" : (: bai_nian :),
  ]) );

  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_bai (object who)
{
  object me = this_object();
  object guo;  int size;
  string *strs;
  mapping skills = who->query_skills();
  int i;

  if (who->query("nian/2002"))
    return;

  
  size = sizeof(skills);
    
  command("xixi "+ who->query("id"));
  message_vision ("\n$N对$n说："+RANK_D->query_respect(who)+
                  "一年来潜心修行，辛苦了！白蜻蜓让我送点年货给你，过个好年！\n",me,who);
  
  who->add("nian/2002",1);
  who->add("potential",266666);
  who->add("max_force",100);
  who->add("max_mana",100);
  tell_object(who,"你得到了二十六万六千六百六十六点潜能！\n");
  tell_object(who,"你得到了一百点内力和法力！\n");
  strs = keys(skills);
  for (i = 0; i < size; i++)
  {
    call_out("baiing",i/50,me,who,strs[i]);
  }
  
}


void baiing (object me, object who, string str)
{
  int i = who->query_skill(str,1);
  int nian;
  string name = to_chinese(str);
  
 if(i>400) nian = 3;
   else if(i>300) nian = 5;      
     else if(i>200) nian = 7;
       else if(i>100) nian = 10; 
         else nian = 12; 
         
  who->set_skill(str,i+nian);
  tell_object(who,"你得到了"+chinese_number(nian)+"级"+name+"！\n");
}

int bai_nian ()
{
  object me = this_object();
  object who = this_player();
 
  if( me->is_busy() ) {
    message_vision ("$N对$n说道：这位"+RANK_D->query_respect(who)+"，我正忙着哩！\n",me,who);
    return 1;
    }
        
  if( who->is_busy() ) {
    message_vision ("$N对$n说道："+RANK_D->query_respect(who)+"不用心急，正在给您发礼物呢。\n",me,who);     
    return 1;
    }
    
  if (who->query("nian/2002"))
  {
    message_vision ("$N对$n说道：你已经领过年货了哦！\n",me,who);
    command("maoli "+ who->query("id"));
    return 1;
  }
  do_bai (who);
  return 1;
}
