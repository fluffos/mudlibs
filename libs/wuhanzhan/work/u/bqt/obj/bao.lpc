#include <ansi.h>

inherit ITEM;


int do_open(string arg);
void init() {
  add_action("do_open", "open");
}

void create() {
  set_name(RED "大礼包" NOR, ({ "libao", "bao" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", RED "大礼包。\n");
  }
  if (!wizardp(this_player())) {
    set("no_sell", "大礼包，怎么能卖？还是自己留着吧。\n");
    set("no_drop", "大礼包，哪能乱扔! \n");
    set("no_give", "这么贵重的礼物，哪能随便给人？\n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_steal", " 抓贼啊！ \n");
  }

  setup();
}

int do_open(string arg) {
  int opening;
  object victim = this_player();
  int gain;

  if (!id(arg))
    return notify_fail("你要打开什么？\n");
  opening = (int)victim->query("openbao");
  if (opening > 1) {

    victim->set("openbao", 10);
    victim->add("potential", 1000);
    victim->save();

    message_vision(RED "\n$N打开大礼包……\n\n" NOR, victim);
    message_vision(HIY "\nYifan突然蹦出来，笑嘻嘻地对$N说：同志辛苦了！！\n\n" NOR, victim);
    tell_object(victim, HIW "Yifan" NOR "悄悄说：你得到了1000点潜能! \n");
    return 1;
  }
  destruct(this_object());
  return 1;
}
