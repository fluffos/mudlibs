#include <ansi.h>

inherit ITEM;

int do_eat(string);

void init()
{
     add_action("do_eat", "eat");
}

void create()
{
     set_name(HIW "月饼" NOR, ({"yue bing", "bing"}));
     set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "这是"HIW"白蜻蜓"NOR"花了九九八十一天，采日月精华做出来的月饼。\n
"HIC"风尘"NOR"吃了一口，只觉味美无比，大叫“此乃神物也！“，于是在月饼上题句，以增天下人。\n
       ----------
┏━┓┃中秋快乐┃┏━┓ 
┃逢┃┗━━━━┛┃迎┃ 
┃千┃　━　 ━━ ┃仲┃ 
┃禧┃━┳━┏━┓┃秋┃ 
┃举┃┃┃┃┗━┛┃普┃ 
┃世┃┃┃┃┏┳┓┃天┃ 
┃共┃　┃　┃╋┃┃同┃ 
┃欢┃　┛　┗┻┛┃庆┃ 
┗━┛　　　　　　┗━┛\n");
            }
     if (!wizardp(this_player()))  
     {
        set("no_sell","白蜻蜓送的"+this_object()->query("name")+"的礼物？还是自己留着吧。\n");
        set("no_drop","白蜻蜓送的，哪能乱扔! \n");
        set("no_give","这么贵重的礼物，哪能随便给人？\n");
        set("no_put"," 嘿嘿，别妄想了！ \n");
        set("no_steal"," 抓贼啊！ \n");
     }

        set("is_monitored", 1);
        setup();
}

int do_eat(string arg)
{
        object victim = this_player();
        int gain;

        if (!id(arg))
                return notify_fail("你要吃什么？\n");

        gain=(int)victim->query("combat_exp") / 200;
        victim->add("combat_exp", gain);
        victim->add("potential",30000);
        victim->add("max_force",50);
        victim->add("max_mana",50);
        victim->save();
        gain=(int)gain / 1000;

          if (victim->query("gender")=="男性")         {      
         message_vision(HIW "\n$N吃了一块白蜻蜓送的月饼，不禁想起嫦娥MM……\n\n" NOR, victim);
          }          
          else
        message_vision(HIW
      "\n$N吃了一块白蜻蜓送的月饼,不禁想起八戒GG……\n\n" NOR, victim);      
        message_vision(HIW "\n白蜻蜓嘴里还含着半个的月饼，笑嘻嘻地对$N说：中秋快乐！！\n\n" NOR, victim);
        message_vision(HIW "\n白蜻蜓嘴里还含着半个的月饼，笑嘻嘻地对$N说：中秋快乐！！\n\n" NOR, victim);
        tell_object(victim,HIW"白蜻蜓"NOR"悄悄说：你得到了"+gain+"年道行! \n");
        tell_object(victim,HIW"白蜻蜓"NOR"悄悄说：你得到了三万点潜能! \n");

        destruct(this_object());
        return 1;

