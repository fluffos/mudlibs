inherit ITEM;

void init();
int do_read(string arg);

void create() {
  set_name("〖神刀秘籍〗", ({ "blade book", "book", "shu" }));

  set("no_put", 1);
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这本书，相传是刀神当年送给大鹏明王的。\n");
    set("material", "paper");
    set("value", 0);
  }
}
void init() {
  if (!wizardp(this_player())) {
    set("no_get", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_give", 1);
  }
  add_action("do_read", "du");
  add_action("do_read", "read");
}

int do_read(string arg) {
  object me = this_player(), book = this_object();
  int sen_cost, gain, bladelev, exp;
  if (!book->id(arg)) return notify_fail("你要读什么？\n");
  if ((string)me->query("family/family_name") != "大雪山") return notify_fail("偷看别派秘籍，终不是君子所为吧……\n");
  if (me->is_busy()) return notify_fail("你现在忙着呢，还是等静下心来再读书吧！\n");
  if ((int)me->query_skill("blade", 1) > 300) return notify_fail("你在刀法方面已经举世无双了，这本书不会让你长进多少。\n");
  exp = (int)me->query("combat_exp");
  bladelev = (int)me->query_skill("blade", 1);
  if (exp * 10 < bladelev * bladelev * bladelev)
    return notify_fail("你的道行不够，再怎么读也没用。\n");
  sen_cost = 20 + (40 - (int)me->query_int()) + (35 - (int)me->query_kar());
  if ((int)me->query("sen") < sen_cost)
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");
  me->receive_damage("sen", sen_cost);

  gain = (int)me->query_skill("literate", 1) / 5;
  gain -= random((int)me->query_int());
  gain += random(me->query_kar());
  if (gain <= 0) gain = 1;
  me->improve_skill("blade", gain);

  message_vision("$N正专心地研读" + book->query("name") + "。\n", me);
  tell_object(me, "你研读有关基本刀法的技巧，似乎有点心得。\n");
  return 1;
}
