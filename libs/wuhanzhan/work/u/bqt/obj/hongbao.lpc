#include <ansi.h>

inherit ITEM;
void init();

void init() {
  add_action("do_open", "open");
}
void create() {
  set_name(HIR "红包" NOR, ({ "bao" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是wiz组为奖励玩家而发的红包。\n");
  }
  set("no_drop", 1);
  set("no_sell", 1);
  set("no_get", 1);
  set("no_put", 1);
  set("no_give", 1);
  setup();
}
int do_open(string arg) {
  object victim = this_player();
  if (!id(arg))
    return notify_fail("你要打开什么？\n");
  victim->add("potential", 500000);
  victim->save();
  destruct(this_object());
  return 1;
}
