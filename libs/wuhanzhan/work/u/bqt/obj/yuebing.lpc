#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_sell", "  白蜻蜓送的" + this_object()->query("name") + "的礼物？还是自己留着吧。\n");
    set("no_drop", "白蜻蜓送的，哪能乱扔! \n");
    set("no_give", "这么贵重的礼物，哪能随便给人？\n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_steal", " 抓贼啊！ \n");

  }

  add_action("do_eat", "eat");
}
void create() {
  set_name(HIW "月饼" NOR, ({ "yue bing", "bing" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块白蜻蜓送的月饼。\n");
  }

  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  object victim = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  victim->add("combat_exp", (int)victim->query("combat_exp") / 30);
  victim->add("potential", 666666); victim->add("max_force", 50);
  victim->add("max_mana", 50);
  victim->save();

  message_vision(HIW "\n$N吃了一块白蜻蜓送的月饼，不禁想起嫦娥MM……\n\n" NOR, victim);

  destruct(this_object());
  return 1;
}
