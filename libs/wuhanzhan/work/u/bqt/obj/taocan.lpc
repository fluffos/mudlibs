#include <ansi.h>

inherit ITEM;


int do_eat(string arg);
void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIG "圣诞大套餐" NOR, ({ "shengdan taocan", "taocan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIW "一个白蜻蜓让圣诞老人送给大家的圣诞礼物。\n");
  }
  if (!wizardp(this_player())) {
    set("no_sell", "圣诞礼物，怎么能卖？还是自己留着吧。\n");
    set("no_drop", "圣诞礼物，哪能乱扔! \n");
    set("no_give", "这么贵重的礼物，哪能随便给人？\n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_steal", " 抓贼啊！ \n");
  }

  setup();
}

int do_eat(string arg) {
  int eating;
  object victim = this_player();
  int gain;

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  eating = (int)victim->query("eatcan");
  if (eating > 1) {
    message_vision(HIY "$N已经吃过一次。\n" NOR, victim);
  } else {

    gain = (int)victim->query("combat_exp") / 100;
    victim->set("eatcan", 10);
    victim->add("combat_exp", gain);
    victim->add("potential", 66666);
    victim->add("max_force", 100);
    victim->add("max_mana", 100);
    victim->save();
    gain = (int)gain / 1000;

    message_vision(RED "\n$N吃下一口圣诞套餐……\n\n" NOR, victim);
    message_vision(HIY "\n白蜻蜓突然蹦出来，笑嘻嘻地对$N说道，圣诞快乐！\n\n" NOR, victim);
    tell_object(victim, HIW "白蜻蜓" NOR "悄悄说：你得到了" + gain + "年道行! \n");
    tell_object(victim, HIW "白蜻蜓" NOR "悄悄说：你得到66666点潜能! \n");
    message_vision(RED "\n$N让没嚼完的食物卡住了，一口气没上来……救护车!!!BEEP……!!!\n\n" NOR, victim);
    destruct(this_object());
    victim->unconcious();
    return 1;
  }
}
