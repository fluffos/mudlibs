#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(HIY "圣诞披风" NOR, ({ "shengdan pifeng", "pifeng" })); set_weight(800);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 100);
    set("armor_prop/armor", 10);
    set("armor_prop/spells", 50); set("armor_prop/armor", 90);
    set("armor_prop/dodge", 30);
  }
  setup();
}
