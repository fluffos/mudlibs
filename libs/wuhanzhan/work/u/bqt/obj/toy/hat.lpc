#include <ansi.h>
#include <armor.h>
inherit HEAD;
void create()
  {        
set_name(HIR"圣诞小红帽"NOR,({ "hat" }) );                    set_weight(800);
           if( clonep() )                           set_default_object(__FILE__);
                else {                 
                      set("unit", "顶");
                      set("material","cloth");
                      set("value",100);
                      set("armor_prop/armor", 10);
                    set("armor_prop/spells",20);                                         set("armor_prop/armor", 90); 
                      set("armor_prop/dodge", 30);
        }        setup();}

