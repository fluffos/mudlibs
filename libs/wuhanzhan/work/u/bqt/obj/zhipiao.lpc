#include <ansi.h>
inherit ITEM;


int do_zhuan(string arg);
void init() {
  add_action("do_zhuan", "zhuan");
}

void create() {
  set_name(HIY "一张五千两黄金现金支票" NOR, ({ "zhipiao", "piao" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "大话西游现金支票。\n");
    set("no_sell", "现金支票啊，怎么能卖?\n");
    set("no_drop", "现金支票哪能乱扔! \n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_steal", " 抓贼啊！ \n");
  }
  setup();
}
int do_zhuan(string arg) {
  object victim = this_player();
  if (!id(arg))
    return notify_fail("你要打开什么？\n");
  victim->add("balance", 50000000);
  victim->save();
  message_vision(HIY "\n大话西游银行系统开始为$N转帐……\n\n" NOR, victim);
  tell_object(victim, HIW "白蜻蜓" NOR "悄悄说：五千两黄金已经自动转到你帐户下。\n");
  destruct(this_object());
  return 1;
}
