#include <weapon.h>

inherit SWORD;
#include <ansi.h>
void create()
{
   set_name(HIW"淑女剑"NOR, ({ "shunu sword", "jian", "sword" }) );
   set_weight(2000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "把");
     set("value", 7000);
     set("material", "steel");
     set("long", "这是一把又细又长的剑，剑身锐利，剑身上三篆刻小字“淑女剑”。
      传说是天神白蜻蜓专为天下淑女打造。\n");
     set("wield_msg", "一道"+HIW+"白"+NOR+"光闪过，$N手中已多了把$n。\n");
     set("unequip_msg", "$N放下手中的$n。\n");
   }
   init_sword(150);
   setup();
}

