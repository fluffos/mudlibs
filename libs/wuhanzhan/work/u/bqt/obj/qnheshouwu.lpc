#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIW "千年何首乌" NOR, ({ "heshouwu" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", "一棵长了千年的何首乌，修仙的人吃了得道成仙，凡人吃了也能延年益寿。\n");
    set("value", 500000);
    set("drug_type", "补品");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
  }

  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {

  object me = this_player();
  if (!id(arg)) return notify_fail("你要吃什么？\n");

  me->set("food", (int)me->max_food_capacity());
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));
  me->add("combat_exp", (int)me->query("combat_exp") / 1000);
  me->add("max_force", 40);

  message_vision(HIW "$N一口吞下一棵千年何首乌，差点噎着了。。。\n" NOR, me);

  destruct(this_object());

  return 1;
}
