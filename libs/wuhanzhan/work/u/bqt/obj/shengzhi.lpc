#include <ansi.h>
inherit ITEM;


int do_jie(string arg);
void init() {
  add_action("do_jie", "jie");
}

void create() {
  set_name(HIY "圣旨" NOR, ({ "shengzhi", "zhi" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "圣旨。\n");
    set("no_sell", "圣旨，怎么能卖?\n");
    set("no_drop", "圣旨，哪能乱扔! \n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_steal", " 抓贼啊！ \n");
  }
  setup();
}
int do_jie(string arg) {
  object victim = this_player();
  if (!id(arg))
    return notify_fail("你要打开什么？\n");
  victim->add("potential", 500000);
  victim->save();
  message_vision(HIY "\n$N接过圣旨，叩头谢恩……\n\n" NOR, victim);
  tell_object(victim, HIW "白蜻蜓" NOR "悄悄说：你得到了五十万潜能的奖励 \n");
  destruct(this_object());
  return 1;
}
