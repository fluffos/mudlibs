void create() {
  set_name("白晶晶", ({ "jing" }));
  set_weight(1);
  set("unit", "张");
  set("inquiry", ([
    "mj": (: to_say_play :),
    "麻将": (: to_say_play :),
    "玩法": (: to_say_play :),
    "play": (: to_say_play :),
    "规则": (: to_say_rule :),
    "rule": (: to_say_rule :),
  ]));
  setup();
  seteuid(getuid());
}
void init() {
  add_action("do_addin", "addin");
  add_action("do_dump", "dump");
  add_action("do_eat", "eat");
  add_action("do_gon", "gon");
