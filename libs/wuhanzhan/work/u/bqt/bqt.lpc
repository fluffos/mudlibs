inherit NPC;

int give_bao ();
void create()
{
  set_name("白蜻蜓", ({ "bqt", "bai", "shi" }));
  set("title","国庆礼品使者");
  set("gender", "男性");
  set("age", 18);
  set("attitude", "peaceful");
  set("str",40);
  set("per",40);
  set("max_force", 3000);
  set("force_factor", 100);
  set("force", 6000);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 100);
  set("combat_exp", 5500000);
  set_skill("literate", 800);
  set("inquiry", ([
    "礼包" : (: give_bao :),
  ]) );

  setup();
}

int give_bao()
{
  int giving;
  object me = this_object();
  object who = this_player();
  object bao; 
  
  if ( (who->query("give_bao")) > 1 ) 
    {
     command("shake");
     tell_object(who,"你已经要过了，不要太贪心了！\n");          }
                           else
                           {
  bao = new ("/u/bqt/obj/bao"); 
  bao->move(who); 
  who->set("give_bao",12);
  command ("grin");
  message_vision("$N给$n一个"+bao->query("name")+"。\n",me,who);
  who->save();
  return 1; }
  destruct(bao);
   return 1;
 }
 









