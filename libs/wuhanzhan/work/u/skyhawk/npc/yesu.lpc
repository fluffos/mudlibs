#include <ansi.h>
#include <room.h>
inherit NPC;
void create()
{
set_name("耶穌",({"ye su","shen"}));
set("title", HIW "造物之神" NOR);
set("gender", "男性");
        set("age", 40);
        set("per", 40);
        set("int", 30);
        set("kar", 30);
        set("str", 30);
        set("cor", 30);
        set("cps", 200);
        set("long", "  \n宇宙的主宰他能鼓勵人努力、上進、勤奮。\n");
        set("max_kee", 10000);
        set("max_gin", 10000);
        set("max_sen", 10000);
        set("force", 10000);
        set("max_force", 10000);
        set("force_factor", 500);
        set("max_mana", 10000);
        set("mana", 10000);
        set("mana_factor", 500);
        set("combat_exp", 4000000);
        set("inquiry", ([
  "名字"   : "也不知道你爸妈怎么想的，给你取这样的名字快点用（newname）改掉。",
  "name"   : "願主耶穌的恩惠,上帝的慈愛，聖靈的團契常與你們同在，從今直到永遠。阿們！",
  "here"   : "这里就是神聖殿。",
  "chen"   : "respect别人对自己的尊称,rude别人对自己的粗鲁的称呼,self自己对自己的称呼,self_rude     自己对自己粗鲁的称呼",
      ]));
        setup();

carry_object("/d/obj/cloth/xianpao")->wear();
carry_object("/u/skyhawk/obj/sword1")->wield();

}
void init()
{
        object ob;

        ::init();
        add_action("do_chen", "chen");
        add_action("do_newname", "newname");
        add_action("do_bianxing","bianxing");
}

int do_chen(string args)
{
   string respect_type,respect_str;
   object me=this_player();
   object mymoney;
   int dx,amount;

   if (!args || sscanf(args,"%s to %s",respect_type,respect_str) !=2)
   {
      tell_object(me,"格式为: chen <respect> to <称呼> \n");

      return 1;
   }
   else 
   {
        mymoney=present("gold_money",me);
        if (!mymoney)
         {
            command("heng");
            return notify_fail("耶穌说道:你没钱跑来凑什么热闹?\n");
         }
        switch (respect_type)
        {
                  case "respect":
//        case "rude":
            {
                dx=0;
                amount=0;
                break;
            }
          case "self" :
          case "self_rude":
            {
                dx=0;
                amount=0;
                break;
            }
          default:
             return notify_fail("你要申请那种称呼?\n");
        }
        if (me->query("daoxing") < dx)
           return notify_fail("你的道行不够. \n");
        if (mymoney->query_amount() < amount)
           return notify_fail("你的金子不够. \n");
           me->set("rank_info/"+respect_type,respect_str);
             if (mymoney->query_amount() == amount)
               destruct(mymoney);
             else
               mymoney->add_amount(-amount);
          }
        message_vision(HIR"耶穌拿起天地神剑对你一点你......\n",me);
        command_function("chat "+me->name()+"在神聖殿修改了自己的称呼......");
        me->save();
        me->move("/d/city/kezhan");       
 return 1;
}
  int do_newname(string args)
  {
     string urname;
     object me=this_player();
     object mymoney;
     int dx,amount,age;
     if (!args)
     {
        tell_object(me,"格式为: newname <你的新名字> \n");
        return 1;
     }
     else 
     {
          mymoney=present("gold_money",me);
          if (!mymoney)
           {
              command("heng");
              return notify_fail(HIR"耶穌说道:你没钱我可不能给你改名字哦.\n");
           }
                  amount=0;
          if (mymoney->query_amount() < amount)
             return notify_fail("你的金子不够. \n");
             me->set("name",args);
               if (mymoney->query_amount() == amount)
                 destruct(mymoney);
               else
                 mymoney->add_amount(-amount);
            }
          message_vision(HIR"耶穌拿起圣经翻了翻，跟你说了几句经文，结果你什么都没听懂\n",me);
          command_function("chat "+me->name()+"在神聖殿修改了自己的名字......");
      me->save();
      me->move("/d/city/kezhan");          
   return 1;
  }
  int do_bianxing(string arg)
{
  object me,ob;

   me=this_player();
   ob = present(arg, environment(me));

  if (arg) {
    if(ob->query("gender")=="女性") ob->set( "gender", "男性" );
    else ob->set( "gender", "女性" );
    message_vision(HIR"$N没来得及反应人已经晕了过去......\n\n"NOR,this_player());
   command_function("chat "+me->name()+"在神聖殿变性成功......");
    me->save();
    me->move("/d/city/kezhan");

    return 1;
  }
}
