#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "树林");
  set("long", @LONG
这是一片茂密的树林，好象被人设计了一种阵，一走进来，你仿佛迷失了方向。
LONG);
  set("exits", ([
    "east": __FILE__,
    "west": __FILE__,
    "south": __DIR__ "lin2",
    "north": "u/skyhawk/zhuxian/gate2",
  ]));
  set("no_clean_up", 0);
  setup();

}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(20) + 1, ob);
}
int blowing(object ob) {
  int i;
  int damage;
  if (ob && environment(ob) == this_object()) {
    tell_object(this_object(), HIR "\n\n几根树藤向你身上窜了过来。\n\n" NOR);
    ob->receive_damage("kee", random(100) + 50);
    ob->receive_damage("sen", random(100) + 50);
    COMBAT_D->report_status(ob);
    COMBAT_D->report_sen_status(ob);
    if (environment(ob) == this_object())
      call_out("blowing", random(20) + 1, ob);
  } else
    return 1;
}
void reset() {
  ::reset();
  remove_call_out("blowing");
}
