#include <ansi.h>

inherit F_DBASE;
int random_place(string dirss,object bs);

string *dirs = ({
"/d/dntg/yunlou",
"/d/sanhua/",
});
void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "内存精灵");
        CHANNEL_D->do_channel( this_object(), "sys", "装备自动发放系统已经启动。\n"); 
        set("name","");
        remove_call_out("choose_baoshi");
        call_out("choose_baosi",10);
}

void choose_baosi()
{
        int i, j ,k,ppl,rd;
        object *list,newob;
        string str,m_name;
        string smp;
        
        j = random(sizeof(dirs));
        //newob = new("/ymdh/obj2/");
        rd = random(13);
        if(rd==0) 
        {
                 newob = new("/ymdh/obj2/armor");
        }
        if(rd==1) 
        {
                 newob = new("/ymdh/obj2/boots");
        }
        if(rd==2)
        { 
                 newob = new("/ymdh/obj2/cloth");
        }
        if(rd==3)
        { 
                 newob = new("/ymdh/obj2/cloth1");
        }
        if(rd==4)
        { 
                 newob = new("/ymdh/obj2/finger");
        }
        if(rd==5)
        { 
                 newob = new("/ymdh/obj2/hands");
        }
        if(rd==6)
        { 
                 newob = new("/ymdh/obj2/kui");
        }
        if(rd==7)
        { 
                 newob = new("/ymdh/obj2/neck");
        }
        if(rd==8)
        { 
                 newob = new("/ymdh/obj2/neck1");
        }
        if(rd==9)
        { 
                 newob = new("/ymdh/obj2/pifeng");
        }
        if(rd==10)
        { 
                 newob = new("/ymdh/obj2/shield");
        }
        if(rd==11)
        { 
                 newob = new("/ymdh/obj2/waist");
        }
        if(rd==12)
        { 
                 newob = new("/ymdh/obj2/waists");
        }
        
        if(random_place(dirs[j],newob)== 1 )
        remove_call_out("choose_baosi");
  call_out("choose_baosi",180);
}

int random_place(string dirss,object bs)
{
        int  j, k;
        object  newob,ob;
        mixed*  file;
        string id_name;
        file = get_dir( dirss+"/npc/*.lpc", -1 );
        
        if( !sizeof(file) ) return 0;

        for(k=0;k<50;k++) { // try 50 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newob=load_object(dirss+"/npc/"+file[j][0]);
             if(!newob) continue;
             id_name = newob->query("id");
             if(!id_name) continue;
             if(!objectp(ob=find_living(id_name))) continue; //这个npc不是活的 
             ob=find_living(id_name);
                     if(bs->move(newob)) {
                    CHANNEL_D->do_channel( this_object(), "sys", "装备落到了"+ob->query("id")+"的身上。\n"); 
                    return 1;
                   }
             }
           }
         CHANNEL_D->do_channel( this_object(), "sys", "本次发放失败\n");        
        return 0;
}

   

