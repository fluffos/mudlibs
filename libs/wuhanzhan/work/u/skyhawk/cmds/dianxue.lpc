// dianxue.c 点穴
// by fqyy 2002.6.3

#include <ansi.h>
#include <weapon.h>
#include <combat.h>

inherit SSERVER;
//#include <combat_msg.h>
#include "xuedao.h"
#include "xuedao_skill.h"

string *color_msg = ({
        HIR,
        HIB,
        HIC,
        HIG,
        HIW,
        HIY,
        HIM,
});

int main(object me, string arg)
{
        string xue,msg,temp;
        int skill,damage,xue_lv,p;
        object target,weapon;
        int i,w;
        mapping me_w,prepare;

        skill=me->query_skill("jingmai-xue",1);
        if (skill<10)
                return notify_fail("你的少林点穴指不够熟练，还不能点穴。\n");

        if (!arg || sscanf(arg,"%s %s",xue,temp)!=2)
                return notify_fail("格式：dianxue <穴道> <目标>\n");

        if(environment(me)->query("no_fight"))
                return notify_fail("这里不能攻击别人。\n");

        if(  me->query_temp("cmd/dianxue") ) 
                return notify_fail("你刚刚运气点穴，暂时无法再次使用！\n");

        if(me->is_perform()) 
                return notify_fail("你正在使用外功无法运气点穴！\n");

        if (me->is_busy())
                return notify_fail("你现在正忙着呢。\n");

        if (!target=present(temp,environment(me)))
                return notify_fail("这里没有"+temp+"这个人。\n");

        if (wiz_level(target)>wiz_level(me))
                return notify_fail("你不能企图暗害巫师级别比你高的玩家。\n");

        if (target->is_corpse() || !target->is_character())
              return notify_fail("那不是活物耶！\n");

        if( (int)me->query("max_force") < 5000 )
                return notify_fail("你这么点内力就想学人家「点穴」？\n");
      
        if( (int)me->query("force") < 5000 )
                return notify_fail("你的内力太少了，无法点别人穴道！\n");   

        if( (int)me->query("max_mana") < 5000 )
                return notify_fail("你的法力太少了，无法点别人穴道！\n");   

        if(!living(target))
                return notify_fail("对方都这样了，还用的着这么费劲么？\n");

        for (i=0;i<sizeof(xuedao);i++) {
                if (xuedao[i]["id"]==xue) break;
        }

        if (i==sizeof(xuedao))
                return notify_fail("你根本找不到这个穴道！\n");

        switch (xuedao[i]["flow"]) {
                case "手太阴肺经": xue_lv=10;break;
                case "手阳明大肠经": xue_lv=20;break;
                case "足阳明胃经": xue_lv=30;break;
                case "足太阴脾经": xue_lv=40;break;
                case "手少阴心经": xue_lv=50;break;
                case "手太阳小肠经": xue_lv=60;break;
                case "足太阳膀胱经": xue_lv=70;break;
                case "足少阴肾经": xue_lv=80;break;
                case "手厥阴心包经": xue_lv=90;break;
                case "手少阳三焦经": xue_lv=100;break;
                case "足少阳胆经": xue_lv=110;break;
                case "足厥阳肝经": xue_lv=120;break;
                case "阳跷脉": xue_lv=130;break;
                case "阴跷脉": xue_lv=140;break;
                case "阳维脉": xue_lv=150;break;
                case "阴维脉": xue_lv=160;break;
                case "冲脉": xue_lv=170;break;
                case "督脉": xue_lv=180;break;
                case "带脉": xue_lv=190;break;
                case "任脉": xue_lv=200;break;
                default: xue_lv=0;break;
        }

        if (xue_lv>skill)
                return notify_fail(HIR"以你现在的经脉学水平根本不知道"HIC+xuedao[i]["name"]+HIR"到底在什么地方！\n"NOR);

        if (weapon=me->query_temp("weapon")) {
                for (w=0;w<sizeof(weapon_type);w++) {
                        if (weapon->query("skill_type")==weapon_type[w]["weapon"]) break;
                }
                if (w==sizeof(weapon_type))
                        return notify_fail("你这种兵器根本点不了穴！\n");
                me_w=weapon_type[w];
        } else {
                prepare = me->query_skill_prepare();
                if (!sizeof(prepare)) {
                        temp= "unarmed";
                } else {
                        temp= keys(prepare)[0];
                }
                for (w=0;w<sizeof(unarmed_type);w++) {
                        if (temp==unarmed_type[w]["weapon"]) break;
                }
                if (w==sizeof(unarmed_type))
                        return notify_fail("你这种武功根本不是用来点穴的！\n");
                me_w=unarmed_type[w];
        }
        me->start_perform(2, "点穴");
        me->set_temp("cmd/dianxue",1);
        me->start_busy(1);
        msg = me_w["msg"];
        temp = color_msg[random(sizeof(color_msg))];
        msg = replace_string(msg, "$x", color_msg[random(sizeof(color_msg))]+"「"+xuedao[i]["name"]+"」"+temp);
        if (weapon)
        msg = replace_string(msg, "$w", weapon->name()+temp);
        msg = temp+msg+NOR;
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me:), 7 );

        if( me->query("combat_exp")/2/xue_lv*skill> random(target->query("combat_exp"))) {
                damage = skill/5+xuedao[i]["eff"]*3+me_w["eff"]*2;
                damage +=me->query_skill("force")/10;
                switch(xuedao[i]["place"]) {
                        case "head":
                        target->receive_damage("sen", damage*10);
                        target->receive_wound("sen", damage*3);
                                temp =HIY"$n感到精神一阵恍惚，脑中一片空白！\n"NOR;
                                break;   
                        case "chest":
                        target->receive_damage("force", damage*20);
                                temp =HIC"$n胸中一痛感觉到真气正在狂泻而出！\n"NOR;
                                break;
                        case "body":
                        target->receive_damage("kee", damage*15);
                        target->receive_wound("kee", damage*5);
                                temp =HIR"$n身体剧烈一震看来是受到严重的内伤！\n"NOR;
                                break;
                        case "arm":
                        target->apply_condition("no_exert",damage/40+1);
                        target->apply_condition("no_perform",damage/40+1);
                        if(target->is_fighting()&&random(2)) 
                        target->start_lost(damage/10+1);
                                temp =HIG"$n手臂酸麻出招已经乱了章法全无力道！\n"NOR;
                                break;
                        case "leg":
                        target->start_busy((damage/50+1)>5?5:(damage/50+1));
                        if(target->is_fighting()&&random(2)) 
                        target->set_temp("must_be_hit",damage/20+1);
                                temp =HIW"$n双腿软弱无力想要移动半步也是十分困难！\n"NOR;
                                break;
                        default:
                                msg +=HIY"$N思维有些混乱没找准穴位，只是轻轻碰了一下$n并没有造成多大的伤害！\n"NOR;
                }
        target->receive_damage("kee", damage);
        target->receive_wound("kee", damage/3);   
        p = (int)target->query("kee")*100/(int)target->query("max_kee");
        msg +=  damage_msg(damage*(random(3)+1), "刺伤");
        msg = replace_string(msg,"$w",weapon?weapon->name():"无形内劲");
        msg = replace_string(msg,"$l",color_msg[random(sizeof(color_msg))]+xuedao[i]["flow"]+NOR"的"+
        color_msg[random(sizeof(color_msg))]+"「"+xuedao[i]["name"]+"」"+NOR);
        msg += temp;
        msg += "( $n"+eff_status_msg(p)+" )\n";
        me->add("force", -xue_lv*5);    
        me->add("mana", -xue_lv*5);    
        target->kill_ob(me);
        } else {
        msg += WHT"$n微微感到穴道一麻护体真气立即自然而生，$N虽然点中了穴道却没有什么作用。\n"NOR;
        me->add("force", -500);
        me->fight_ob(target);
        target->fight_ob(me);
      }
        message_vision(msg, me, target);  
        return 1;
}

void remove_effect(object me)
{
        me->delete_temp("cmd/dianxue");
}
int help(object me)
{
        write("\n指令格式 : dianxue <穴道> <目标>\n");
        write(@HEL
这个指令可以让你使用点穴攻击对方若需要察看穴道名称请使用help xueda
HELP)
    return 1
