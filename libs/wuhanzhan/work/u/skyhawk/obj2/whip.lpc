#include <ansi.h>
#include <weapon.h>
inherit F_UNIQUE; 
inherit WHIP;

void create()
{
        set_name( HIY"黄金战鞭"NOR, ({ "whip", "bian" }) );
        set_weight(50000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                  set("unit", "把");
                  set("long", query("name")+HIW"是传说中的上古神兵之一，传闻此物拥有神秘的力量！\n"NOR);
                  set("value", 1000000);
                  set("no_drop",1);
                  set("no_give",1);
                  set("no_sell",1);
                  set("no_put",1);
                  set("no_steal",1);
                  set("material", "gold");
                  set("weapon_prop/dodge", 5);
                  set("weapon_prop/parry", 5);
                   set("replace_file", "/d/obj/weapon/whip/jueqingwhip");
                        }
init_whip(200);
                  set("wield_msg",HIB"\n一道眩目的电光闪过,$n"NOR HIB"以握在$N手中,不由豪气顿生.\n"NOR);
                  set("unwield_msg",HIW"白光咋敛,$N手中的$n"NOR HIW"已经不见了。\n"NOR);
        setup();
}
int query_autoload() { return 1; }
