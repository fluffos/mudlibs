#include <ansi.h>
inherit ROOM;

int valid_leave();
void create ()
{
      set ("short", HIW "〖希腊广场〗" NOR);
        set ("long", @LONG

这里就是古城希腊神话中黄金圣殿的入口处,往上看去,一条弯弯曲曲的山路,
你清楚的看到十二座宫殿,站在这里你晃如梦中,真有一种古老的气息,旁边有
一个黄金时钟(goldzhong)
LONG);
        set("item_desc", ([
                "goldzhong": @TEXT
这口钟有点特别,他只有一根指针,而且是一把燃烧的火焰,没有数字,只有十二
个形象,白羊.金牛.称.....

TEXT
        ]) );
        set("exits", ([
            "down" : "/d/city/wushuangcheng",
            "up"  :  "/d/xila/12gong/baiyang",
        ]));
        set("objects", 
          ([ //sizeof() == 1
                      __DIR__"npc/tianshi" : 1,
          ]));
        set("outdoors", "12gong");
//        set("no_magic", 1);
//        set("no_fight", 1); 
    set("no_exert",1);
        setup();
}
int valid_leave(object me, string dir)
{       
int parry_skill,force_skill,player_combat;
        object a;
//          if( wizardp(me)) return 1;
me=this_player();
parry_skill=me->query_skill("parry");
force_skill=me->query_skill("force");
player_combat=me->query("combat_exp");
            if (dir == "up" &&
parry_skill < 100 &&
force_skill < 100 &&
player_combat < 1000000 )
{
                if(objectp(a=present("tian shi", environment(me))) && living(a) )
                return notify_fail("小天使一把拉住你，凭您的武功，也想上去闯关。\n");
        return ::valid_leave(me, dir);
}
return 1;
}
