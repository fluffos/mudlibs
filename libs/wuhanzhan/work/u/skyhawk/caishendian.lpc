#include <ansi.h>
#include <command.h>

inherit ROOM;

int do_look(string arg); 

void create()
{
    set("short", "财神殿");
    set("long", @LONG
这里是财神爷处理公事的地方西墙挂着的牌子 (paizi)上面
写着此次拍卖大会的规则，一定要好好看看。
LONG);
        set("no_fight", 1);
        set("no_sleep", 1);
        set("item_desc", ([ /* sizeof() == 1 */
         "paizi" : "
玩家指令：
   list  (查看目前所要拍卖的黑店)
   jupai (玩家可以用这个指令参加拍卖)

巫师指令：
   paimai start qiao ban finish auto
初始所有店铺：shop reset
指定店铺主人：shop owner
开放指定店铺：shop open
关闭指定店铺：shop close
开始店铺拍卖：start
进行自动拍卖：auto
禁止某人参加：ban
选择拍卖店铺：qiao
结束店铺拍卖：finish

"]));

        set("exits", ([
                "kz" : "/d/city/kezhan",
        ]));

        setup();
        "/u/skyhawk/xiaocaishen"->come_here();
}

