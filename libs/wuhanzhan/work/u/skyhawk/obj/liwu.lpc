#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();
void init() {
  if (!wizardp(this_player())) {
    set("no_get", 1);
    set("no_sell", 1);
    set("no_drop", 1);
  }

  add_action("do_eat", "eat");
}

void create() {
  set_name(BLINK HIR "万年火龟" NOR, ({ "wannianhuo guei", "guei" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", HIW "一只尺许大小的神龟。它通体火红，因万年长寿而具灵性。\n" NOR);
    set("value", 1000);
  }
  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  int gain;

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("skyhawk/liwu4") == "got") {
    command("say 你已经有一份了。");
    return 1;
  }
  gain = (int)me->query("combat_exp") / 100;
  me->add("max_force", 150);
  me->add("max_mana", 150);
  me->add("combat_exp", gain);
  me->add("potential", gain * 10);
  me->set("skyhawk/liwu4", "got");
  me->skill_death_recover();
  me->save();
  message_vision(HIY "\n$N从万年火龟体内吸出一枚火丹吞了下去。发现自己比以前厉害多了。\n\n" NOR, me);
  CHANNEL_D->do_channel(this_object(), "rumor",
    me->query("name") + "偷偷吃掉了一只" + name() + "！\n");
  destruct(this_object());
  return 1;
}
