#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;
void create()
{
        set_name(HIR"天地神剑"NOR, ({"shen-jian","sword"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
              set("unit", "把");
              set("long", HIG"这是一把天地之神专用的神剑，宿有无尽精气。\n");
              set("value", 10000);
              set("npc_only", 1);
              set("replace_file","/d/obj/weapon/sword/changjian");
              set("wield_msg",
HIW"$N轻轻一指，$n"NOR HIW"以划破大地的震撼从地面升起来，停在$N身前发出淡黄的光芒。\n");
              set("unwield_msg",
HIW"$N提劲把$n"NOR HIW"插在地上，$n"NOR HIW"迅即和大地溶合失去踪影。\n");
              set("weapon_prop/int", 2);
                     }
        init_sword(200);
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
       if(me->query_skill("sword",1)<450)
        me->improve_skill("sword",random(20));
                switch(random(7)) {
                        case 0: return "一道"RED"红"NOR"色剑气从$w迸射出来！\n";
                        case 1: return "一道"MAG"橙"NOR"色剑气从$w迸射出来！\n";
                        case 2: return "一道"YEL"黄"NOR"色剑气从$w迸射出来！\n";
                        case 3: return "一道"HIG"绿"NOR"色剑气从$w迸射出来！\n";
                        case 4: return "一道"HIW"青"NOR"色剑气从$w迸射出来！\n";
                        case 5: return "一道"BLU"蓝"NOR"色剑气从$w迸射出来！\n";
                        case 6: return "一道"MAG"紫"NOR"色剑气从$w迸射出来！\n";
                     }        
}
