#include <armor.h>
#include <ansi.h>
inherit ARMOR;

void create() {
  set_name(HIR "紫金鳞甲" NOR, ({ "zijinlin jia", "jinlin", "jia" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "紫金鳞甲通体上下包着若现隐的层层旋转光华，此光华能护体防身，变幻莫测，万物莫进。\n" NOR);
    set("material", "cloth");
    set("no_drop", 1);
    set("no_sell", 1);
    set("value", 500000);
    set("unit", "件");
    set("armor_prop/armor", 1000);
    set("armor_prop/spells", 50);
  }
  set("wear_msg", HIW "一道耀眼的白光滑过，万千细小的金鳞在空中组合成$n" NOR HIW "套在$N身上。\n" NOR);
  setup();
}
int query_autoload() { return 1; }
