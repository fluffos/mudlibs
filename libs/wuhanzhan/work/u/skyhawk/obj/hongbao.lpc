// hongbao.c
// skyhawk 2003.6.3
#include <ansi.h>
inherit ITEM;

void create()
{
        string *names = ({
               MAG "超级大红包"NOR, HIM "超级大红包"NOR, HIG "超级大红包"NOR, HIY "超级大红包"NOR, HIC "超级大红包"NOR
        });
        set_name( names[random(sizeof(names))], ({ "ackbao" }));
        set_weight(600);
        set("no_dropall",1);
        set("unit", "个");
        set("long", "此物极其珍贵，唯有最终强者才能获得，你可以打开(open)看看。\n");
       setup();
}
void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{
        object me = this_player();
        int exp,pot;

        if (!id(arg))
        return notify_fail("你要打开什么？\n");
        if (me->query("skyhawk/liwu7")=="got")
        {
                command("say 你已经有一份了。");
   message_vision(HIM "【谣言】某人：$N莫名其妙的死了。\n" NOR, me);  
        me->move("/d/death/gate");
        me->start_busy(3); 
message_vision(HIW "崔判官向你招招手，说道：新来的，你莫乱跑，画了生死簿，我好送你还阳。
\n" NOR, me); 
message_vision(HIW "崔判官看着你笑了笑，说道：生死有命，你也不要太难过了。
\n" NOR, me); 
message_vision(HIW "崔判官从怀中拿出一个黑底白字的册子翻看着。。。
\n" NOR, me); 
message_vision(HIW "崔判官合上册子，说道：命不该死，多留无益，我这便送你还阳去吧！
\n" NOR, me); 
message_vision(HIW "崔判官伸手向你一指，你的魂魄又回到了自己身上。。。
\n" NOR, me); 
message_vision(HIW "一股阴冷的浓雾突然出现，很快地包围了你。
\n" NOR, me); 
        me->move("/d/ourhome/kedian");
        destruct(this_object());
                return 1;
        }
        exp=50000+random(2000);
        pot=exp*2+random(2000);
        me->add("max_force",30);
        me->add("max_mana",30);
        me->add("combat_exp", exp);
        me->add("potential", pot);
//        me->set("skyhawk/liwu6","got");
        me->save();
tell_object(me,HIY"你被奖励了：\n" +
        chinese_number(exp) + "道行\n"+chinese_number(pot) + "点潜能\n30点内力及30点法力"
         NOR);
       tell_object(me,HIR"\n\n       真诚地恭喜你!        本站全体巫师\n\n"NOR);
        destruct(this_object());
        return 1;
}

