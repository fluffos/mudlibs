#include <ansi.h>
inherit ITEM;
int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
     set("no_give","你太慷慨了吧！\n");
     set("no_get"," 嘿嘿，做梦吧! \n");
     set("no_drop","这东西你也想丢？\n");
     set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }
    if(this_player()==environment())
  add_action("do_eat", "eat");
}
void create()
{
                  set_name( HIY "ID保护卡" NOR , ({"pkka","dan"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
  set("unit", "颗");
       set("long", "这是一张用来保护ID的点卡。\n");
      set("value", 10000);
    set("drug_type", "补品");
  }
  set("is_monitored",1);
  setup();
}
 int do_eat(string arg)
{
  object me = this_player();
       if (arg!="dan") return 0;
  if(me->query("lw")==1)
   {
    tell_object(me,"没病别乱吃药。\n");
  destruct(this_object());
    return 1;}
seteuid(getuid());
  switch (random(0))
{
case 0:
{       me->set("lw",1);
  me->apply_condition("peace_player", 60);
        me->set("food", (int)me->max_food_capacity()*30+random(120));
        me->set("water", (int)me->max_water_capacity()*30+random(120));
        message_vision(HIY "$N拿起ID保护卡看了看。
$N发现自己多出了60点保护时间。\n" NOR, me);
break;
}
}
  destruct(this_object());
  return 1;
}

