#include <ansi.h>

inherit ITEM;

int do_insert(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
    set("no_get","你手里一松，九转还魂丹从指间滑落！\n");
    set("no_give","这么珍贵的药，哪能随便给人？\n");
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }
        add_action("do_insert", "insert");
}

void create()
{
                  set_name( HIY "测试卡" NOR , ({"dian card","ka"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
  set("unit", "颗");
     set("long", "这是一张DHXY测试用的点数卡，用（insert ka）进行充卡。\n");
     set("value", 10000);
     set("drug_type", "补品");
  }
  set("is_monitored",1);
  setup();
}
 int do_insert(string arg)
{
  object me = this_player();
  if (arg!="ka" && arg!="dian card")   return 0;
  if(me->query("insert")==9)
   {
    tell_object(me,"你已经刷过一次卡了。\n");
  destruct(this_object());
    return 1;}
seteuid(getuid());
  switch (random(0))
{
case 0:
{       
  me->add("insert",1);
  me->apply_condition("peace_player", 25920);
        message_vision(HIY "$N拿起测试卡在机器上刷了一下。
$N发现自己多出了3天的保护时间。\n" NOR, me);
break;
}
}
  destruct(this_object());
  return 1;
}

