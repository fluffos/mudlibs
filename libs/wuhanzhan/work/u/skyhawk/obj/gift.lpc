#include <ansi.h>
inherit ITEM;
int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", " 嘿嘿，做梦吧! \n");
    set("no_drop", "这东西你也想丢？\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  if (this_player() == environment())
    add_action("do_eat", "eat");
}
void create() {
  set_name(HIY "灵芝仙草" NOR, ({ "lingzhi cao", "dan" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "外表看上去十分鲜艳，它散发出一种奇香，生长于极阴湿之地，服后补神健体，延年益寿。\n");
    set("value", 10000);
    set("drug_type", "补品");
  }
  set("is_monitored", 1);
  setup();
}
int do_eat(string arg) {
  object me = this_player();
  if (arg != "dan") return 0;
  seteuid(getuid());
  switch (random(0)) {
    case 0:
      {
        me->add("potential", 10000);
        me->add("combat_exp", 150000);
        me->add("max_mana", 50);
        me->add("max_force", 50);
        me->set("food", (int)me->max_food_capacity() * 3 + random(120));
        me->set("water", (int)me->max_water_capacity() * 3 + random(120));
        message_vision(HIW "$N拿起一颗灵芝仙草，小心翼翼地吃了进去。
$N面色变成赤红，心神恍惚，如醉如痴。\n" NOR, me);
        break;
      }
  }
  destruct(this_object());
  return 1;
}
