#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create() {
  set_name(HIY "伽蓝剑" NOR, ({ "jialan sword", "sword" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", HIY "这是一把万载菩提木所制的伽蓝剑，坚逾金钢，可避百邪，任何神刃亦无法损伤分毫。\n" NOR);
    set("value", 500000);
    set("material", "steel");
  }
  init_sword(200);
  set("wield_msg", HIR "只听“铮”的一声，一道耀眼的红光滑过，$N的手中多出一把$n。\n" NOR);
  set("unwield_msg", HIW "白光咋敛,$N手中的$n" NOR HIW "已经收入腰间的剑鞘内。\n" NOR);
  setup();
}
int query_autoload() { return 1; }
mixed weapon_action(object me, object victim) {
  object ob, target_weapon;
  string msg;
  target_weapon = victim->query_temp("weapon");
  if (!target_weapon) return 0;
  if (target_weapon->query("oldsix/qjdy")) {
    msg = HIW "“铛”的一声，" + this_object()->query("name") + MAG "与" + target_weapon->query("name") + HIW "相交，冒出点点火星！\n" NOR;
    return msg;
  }

  msg = MAG "只见金光一闪，" + victim->query("name") + HIW "手中的" + target_weapon->query("name") + HIW "被" + this_object()->query("name") + HIW "打成无数颗菩提，激飞开去。！\n" NOR;

  destruct(this_object());
  return msg;

}
