//套装系列。绿色装备之佛租的封印 6级装备
#include <ansi.h>
#include <armor.h>

inherit ARMOR;
int finish_identify();  //鉴定函数

void create() {
  set_name(HIG "佛祖袈裟" NOR, ({ "fozu armor", "fozu jiasha", "jiasha", "armor" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "传说中如来佛祖穿戴的袈裟。\n");
    set("material", "gold");
    set("value", 1);
    set("armor_prop/armor", 100);  //装备时拥有的防御度为100点。
    set("armor/max_armor", 800);  //装备时拥有的耐用度为800点。
    set("armor_prop/dodge", -30);  //装备时减低有效轻功30点。
    set("diablo/need_spi", 30);  //要求装备时具备灵性为30点以上。
    set("diablo/need_mana", 3000);  //要求装备时具备法力为3000点以上。
    set("diablo/need_dx", 2000);  //要求装备时具备道行为2000年。
    set("not_identifed", 1);  //设置未鉴定的标志,并不是每一件装备都需要鉴定的
    set("Is_Diablo_Obj", 1);
    set("diablo/not_identified", 1);
  }
  setup();
}
int finish_identify() {
  //通过鉴定,扩展装备的性能
  set("armor_prop/armor", 60);  //鉴定后附加盔甲防御度60点。
  set("armor_prop/dodge", 50);  //装备时增加有效轻功50点。
  set("diablo/add_buddhism", 50);  //鉴定后附加技能大乘佛法50级。
  set("diablo/armor_attack", 10);  //攻击者受到10点内力反伤害值。
  set("not_identifed", 0);  //取消未鉴定标志,表示已经鉴定完毕。
  return 1;
}
