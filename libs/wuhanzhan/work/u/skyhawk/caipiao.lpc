int rdm() {
  return random2(10) + 1;
}
void gamble_prepare() {
  object room = this_object();
  tell_room(room, "大话西游福利彩票现在开奖，请工作人员做好准备.\n");
  tell_room(room, "本期头奖金50000圆游戏币，cat bag 一个.\n");
  tell_room(room, "及潜能-道行-内力-法力四选一奖励.\n");
  tell_room(room, "幸运号码奖取百位号码，奖金100000潜能.\n");
  tell_room(room, "请工作人员开动机器.\n");
  tell_room(
    room,
    "o0O⊙～⊙◎○⑨●O·°°·οO○o．oOο·．·°○o0O⊙～⊙◎○⑨●O·°°·οO○o．oOο·．·°○o0O⊙～⊙◎○⑨●O·°°·οO○o．oOο·．·°\n"
  );
  big[0] = rdm();
  big[1] = rdm();
  big[2] = rdm();
  while (big[0] == big[1]) {
    reset_eval_cost();
    big[1] = rdm();
  }
  display_gutou(room, big[0]);
  display_gutou(room, big[1]);
  display_gutou(room, big[2]);
  tell_room(
    room,
    "本期号码是" + HIW + HBMAG + chinese_number(big[0]) + chinese_number(big[1]) + chinese_number(big[2]) + "。\n"
  );
  tell_room(room, "本期头奖号码是" + chinese_number(big[1]) +
    chinese_number(big[2]) + "。\n");
  tell_room(room, "本期头奖号码是" + chinese_number(big[1]) +
    chinese_number(big[2]) + "。\n");
  tell_room(room, "本期头奖号码是" + chinese_number(big[1]) +
    chinese_number(big[2]) + "。\n");
  tell_room(room, "本期幸运号码是" + chinese_number(big[0]) + "。\n");
  room_status = 1;
}
