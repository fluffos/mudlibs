inherit ROOM;
#include <ansi.h>
int room_status = 0;
int *big = allocate(3);
int *res = allocate(3);
int random2(int i) {
  return (random(i) + uptime()) % i;
}
void create() {
  set("short", "大话西游彩票投注站");
  set("long", @LONG
大话西游彩票投注站，这里挤满了等着开奖的彩民。大家都在议论今天可能开出来的
号码。
LONG);
  set("exits",
    ([  //sizeof() == 2
    "kz": "/d/city/kezhan",
    ]));
  set("light_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_gutou", "gutou");
  if (room_status > 0)
    return;
  remove_call_out("gamble_prepare");
  remove_call_out("gamble_start");
  remove_call_out("gamble_perform");
  remove_call_out("gamble_finish");
  call_out("gamble_prepare", 2);
  room_status = 1;
}
