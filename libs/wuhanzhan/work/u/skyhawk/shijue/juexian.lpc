// Room: /u/skyhawk/shijue
#include <room.h>
inherit ROOM;

void create() {
  set("short", "绝仙门");
  set("exits", ([
    "southeast": __DIR__ "jinguang",
  ]));
  set("outdoors", 1);
  set("objects", ([
    __DIR__ "npc/shuishen": 1,
  ]));
  setup();
}
void init() {
  add_action("do_jump", "jump");
}
int do_jump(string arg) {
  object ob = this_player();
  if (!arg || arg != "down")
    return notify_fail("你要向哪跳？\n");
  if (present("shui shen"))
    return notify_fail("水神摇摇头：何苦要寻短见呢。\n");
  message_vision("只见$N纵身一跃，跳下了万丈悬崖。", ob);
  ob->move(__DIR__ "fengdi");
  ob->unconcious();
  return 1;
}
