#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIW "剑坟" NOR);
  set("long", @LONG
 此地乃是剑墓所在，想要离开这里必须留下一把宝剑。  
LONG);

  set("objects", ([ /* sizeof() == 1 */
  ]));
  set("no_clean_up", 1);
  setup();
}
void init() {
  add_action("do_put", "put");
  set("no_clean_up", 1);
}
int do_put(string arg) {
  object sword, ob, me;
  me = this_player();
  if (!arg)
    return notify_fail("你要放什么东西？\n");
  if (!arg || arg != "sword" || !(ob = present(arg, me)))
    return notify_fail("不要乱放。\n");
  message_vision("\n一道金光闪过天空中出现一只大手把$N抓了起来。\n\n", me, ob);
  me->set_temp("shijue/migong", "begin");
  me->move("/u/skyhawk/shijue/migong0");
  destruct(ob);
  return 1;
}
