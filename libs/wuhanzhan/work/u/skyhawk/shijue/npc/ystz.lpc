#include <ansi.h>
inherit NPC;
int reward_player ();

void create()
{
    set_name(HIW "元始天尊" NOR, ({"yuanshi tianzun", "tianzun", "yuanshi"}));
    set("title", HIR "三清之首" NOR);
    set("long", "三清之首，法力无边。\n");
    set("gender", "男性");
    set("age", 13500);
    set("str", 40);
    set("per", 40);
    set("attitude", "peaceful");
    set("combat_exp", 200000000);
    set("eff_kee", 10000);
    set("eff_sen", 10000);
    set("max_kee", 10000);
    set("max_sen", 10000);
    set("sen", 10000);
    set("kee", 10000);
    set("max_force", 200000);
    set("max_mana", 200000);
    set("mana", 400000);
    set("force", 400000);
    set("force_factor",  500);
    set("mana_factor", 500);
    set_skill("dao", 700);
    set_skill("hunyuan-yiqi", 700);
    set_skill("chanzong", 700);
    set_skill("zhenyuan-force", 700);
    set_skill("spells", 700);
    set_skill("force", 700);
    set_skill("moonshentong", 700);
     set_skill("whip", 700);
    set_skill("staff", 700);
    set_skill("blade", 700);
    set_skill("spear", 700);
    set_skill("hammer", 700);
    set_skill("buddhism", 700);
    set_skill("taiyi", 700);
    set_skill("lotusforce", 700);
    set_skill("wuxiangforce", 700);
    set_skill("moonforce", 700);
    set_skill("stick", 700);
    set_skill("dodge", 700);
    set_skill("unarmed", 700);
    set_skill("parry", 700);
    set_skill("sword", 700);
    set_skill("lingjian-force", 700);
    set_skill("lingjianjue", 700);
    set_skill("sanqin-dao", 700);
    set_skill("boro-gong", 700);
      map_skill("force", "wuxiangforce");
      map_skill("spells", "dao");
    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
        (: cast_spell, "light" :),
        (: cast_spell, "thunder" :),
        (: cast_spell, "dingshen" :),
        (: cast_spell, "fenshen" :),
(: exert_function, "jldl" :)
}));
    set("inquiry", ([
    "转世重生" : (: reward_player :),
    ]) );
      setup();

}
int accept_fight(object me)
{
        write("仙人你也想打？\n");
        return 0;
}
int recognize_apprentice(object me)
{
      object ob = this_player();
        if (!(int)ob->query_temp("mark/仙"))
             return notify_fail( HIR "看起来" HIW "元始天尊" HIR "想杀死你！\n"NOR);
         if( ( ob->query("family/family_name") != "方寸山三星洞"
            && ob->query("family/family_name") != "南海普陀山"
            && ob->query("family/family_name") != "月宫"
            && ob->query("family/family_name") != "五庄观"
            && ob->query("family/family_name") != "天王府"
            && ob->query("family/family_name") != "少林寺"
            && ob->query("family/family_name") != "灵剑门")
            || ob->query("combat_exp")  < 5000000 ) 
             return notify_fail( HIR "看起来" HIW "元始天尊" HIR "想杀死你！\n"NOR);

             ob->add_temp("mark/仙", -1);
               return 1;
}
int reward_player ()
{
  object me = this_object();
  object who = this_player();
  if (who->query("obstacle/reward"))
  {
    message_vision ("$N对$n摇头说道：你尚未历尽难关。\n",me,who);
    return 1;
  }
  if (who->query("dntg/number"))
  {
    message_vision ("$N对$n摇头说道：你尚未历尽难关。\n",me,who);
    return 1;
  }
  if (who->query("12gong/all"))
  {
    message_vision ("$N对$n摇头说道：你尚未历尽难关。\n",me,who);
    return 1;
  }
  if (who->query_temp("mark/仙")<10000)
  {
    message_vision ("$N对$n摇头说道：降妖除魔对你来说非常重要。\n",me,who);
    return 1;
  }  
  if (who->query_temp("mark/魔")<10000)
  {
    message_vision ("$N对$n摇头说道：降妖除魔对你来说非常重要。\n",me,who);
    return 1;
  } 
  if (who->query_temp("mark/人")<10000)
  {
    message_vision ("$N对$n摇头说道：降妖除魔对你来说非常重要。\n",me,who);
    return 1;
  } 
  if (who->query("combat_exp")<200000000)
  {
    message_vision ("$N对$n摇头说道：你的道行不够。\n",me,who);
    return 1;
  }  
  if (who->query_skill("force", 1)<1000)
  {
    message_vision ("$N对$n摇头说道：你的武功还需要多多修炼才行。\n",me,who);
    return 1;
  }  
  if (who->query_skill("spells", 1)<1000)
  {
    message_vision ("$N对$n摇头说道：你的武功还需要多多修炼才行。\n",me,who);
    return 1;
  }  
  if (who->query_skill("dodge", 1)<1000)
  {
    message_vision ("$N对$n摇头说道：你的武功还需要多多修炼才行。\n",me,who);
    return 1;
  }  
    who->set("转世重生",1);
    who->save();
    return 1;
    message_vision ("$N对$n说道：我以久候您多时，请去大雄宝殿面见我佛。\n",me,who);
}
