inherit NPC;
void create() {
  set_name("雷神", ({ "lei shen", "leishen", "shen" }));
  set("gender", "男性");
  set("attitude", "friendly");
  set("combat_exp", 10000000);
  set("age", 100);
  set("per", 100);
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("force", 20000);
  set("max_force", 10000);
  set("max_mana", 10000);
  set("mana", 20000);
  set("mana_factor", 200);
  set("force_factor", 200);
  set_skill("spells", 250);
  set_skill("force", 450);
  set_skill("unarmed", 450);
  set_skill("puti-zhi", 450);
  set_skill("parry", 450);
  set_skill("wuxiangforce", 450);
  set_skill("dao", 450);
  set_skill("dodge", 450);
  set_skill("jindouyun", 450);
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("spells", "dao");
  map_skill("force", "wuxiangforce");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "thunder" :),
  }));
  set_temp("apply/armor", 1000);
  setup();
}
void die() {
  object rope;
  string rp = "/u/skyhawk/shijue/obj/zhuxian.lpc";

  rope = new(rp);
  if (environment()) {
    message("vision", "一阵红光闪过，雷神消失的无影无踪，地上留下一道红光。\n", environment());
  }
  rope->move(environment(this_object()));
  destruct(this_object());
}
