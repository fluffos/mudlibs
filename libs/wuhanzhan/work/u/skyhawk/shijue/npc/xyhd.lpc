#include <ansi.h>
inherit NPC;

void create()
{
    set_name(HIY "黄帝" NOR, ({"huang di", "huang", "di"}));
    set("title", HIR "轩辕" NOR);
    set("long", "连我都不认识？\n");
    set("gender", "男性");
    set("age", 13500);
    set("str", 40);
    set("per", 40);
    set("attitude", "peaceful");
    set("combat_exp", 200000000);
    set("eff_kee", 10000);
    set("eff_sen", 10000);
    set("max_kee", 10000);
    set("max_sen", 10000);
    set("sen", 10000);
    set("kee", 10000);
    set("max_force", 200000);
    set("max_mana", 200000);
    set("mana", 400000);
    set("force", 400000);
    set("force_factor",  500);
    set("mana_factor", 500);
    set_skill("seashentong", 700);
    set_skill("dragonforce", 700);
    set_skill("zixia-shengong", 700);
    set_skill("taoism", 700);
    set_skill("lengquan-force", 700);
    set_skill("baguazhou", 700);
    set_skill("gouhunshu", 700);
    set_skill("tonsillit", 700);
    set_skill("spear", 700);
    set_skill("bawang-qiang", 700);
    set_skill("mace", 700);
    set_skill("axe", 700);
    set_skill("sword", 700);
    set_skill("shushan-force", 700);
    set_skill("hammer", 700);
    set_skill("fork", 700);
    set_skill("stick", 700);
    set_skill("whip", 700);
    set_skill("unarmed", 700);
    set_skill("spells", 700);
    set_skill("force", 700);
    set_skill("dodge", 700);
    set_skill("parry", 700);
      map_skill("force", "dragonforce");
      map_skill("spells", "taoism");
      map_skill("spear", "bawang-qiang");
     map_skill("axe", "sanban-axe");
    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
        (: cast_spell, "fu" :),
        (: cast_spell, "jianshen" :),
 (: exert_function, "roar" :),
(: exert_function, "shield" :),
        (: perform_action,"axe", "sanban" :),
}));
      setup();
        carry_object("/d/obj/weapon/axe/huafu")->wield();

}
void init()
{
        ::init();
  add_action("do_ji","ji");
        add_action("do_perform", "perform");
  add_action("do_throw","throw");
}

int accept_fight(object me)
{
        write(CYN "黄帝歪着头想了想，说道：好吧。\n" NOR);
        return 1;
}
void accept_kill(object me)
{       object ob;
        if(is_fighting()) return;
        if( query("called") ) return;
        command("help!");
        ob=present("huang di");
        if( !ob) {
                seteuid(getuid());
                ob->move(environment());
        }
        ob->kill_ob(me);
        ob->set_leader(me);
        me->fight_ob(ob);
        set("called", 1);
        call_out("regenerate", 300);
}
int regenerate()
{
        set("called", 0);
        return 1;
}
int do_throw(string arg)
{
  object who = this_player();
  object me = this_object();
  message_vision("$N掏出暗器，向$n射去。\n",who,me);
  return 1;
}
int do_ji(string arg)
{
  object who = this_player();
  object me = this_object();
  message_vision("$N偷偷把手伸进怀里，想用什么法宝！\n",who,me);
  return 1;
}
int recognize_apprentice(object me)
{
      object ob = this_player();
      if (!(int)ob->query_temp("mark/人"))
             return notify_fail( HIR "看起来黄帝想杀死你！\n"NOR);
         if( ( ob->query("family/family_name") != "将军府"
            && ob->query("family/family_name") != "蜀山剑派"
            && ob->query("family/family_name") != "阎罗地府"
            && ob->query("family/family_name") != "东海龙宫")
            || ob->query("combat_exp")  < 5000000 ) 
             return notify_fail( HIR "看起来黄帝想杀死你！\n"NOR);
        ob->add_temp("mark/人", -1);
             return 1;
}
void die()
{
    object rope;
    string rp="/u/skyhawk/obj/shuizhu.lpc";
        rope = new(rp);
    if( environment() ) {
    message("vision", "一阵红光闪过，黄帝消失的无影无踪，地上留下一道红光。\n", environment());
    }
    rope->move(environment(this_object()));
    destruct(this_object());
}
