
inherit ROOM;
void create ()
{
  set ("short", "时空隧道");
  set ("long", @LONG

这里是时空隧道的控制中心，目前正在测试阶段，你可以通过这里连
接(xxx)到其他站点，返回请用(return)。

注：目前提供以下站点的连接。
    zz    西游记总站
    cs    西游记长沙 - I站
LONG);
  set("exits", ([ /* sizeof() == 4 */
  "out": "/d/city/kezhan",
]));
  set("no_fight", 1);
  set("no_magic", 1);
//  set("valid_startroom", 1);
  setup();
}

void init()
{
        add_action("do_connect","xxx");
}

int do_connect(string arg)
{
        object ob;
        string ip="";
        if (!arg) return 0;
        if( arg=="zz" )
        ip="209.83.132.67 6666";
        if( arg=="cs" )
        ip="61.137.127.208 6666";
        if( arg=="cs2" )

        ip="61.137.127.208 8888";

        ob=new(__DIR__"telnet");
        ob->move(this_player());

        if ( ob->do_telnet(ip) )
        {
                if ( !ob->query("connected") )
                destruct(ob);
        }
        return 1;
}
