inherit NPC;
#include <ansi.h>

   string do_clear(object me);

void create()
{
    set_name(HIW"慕容公子"NOR, ({"murong gongzi","murong","gongzi"}));
        set("title", "");
        set("gender", "男性");
        set("age", 30);

        set("combat_exp", 350000);
        set_skill("unarmed", 300);
        set("force", 300);
        set("force_factor", 300);
        set_skill("dodge", 300);
        set_skill("parry", 300);
   set("inquiry",([
      "clear":(:do_clear:),
    "重新做人" :  (: do_clear :),
    "杀神"     :  (: do_clear :),
   ]));
        setup();
          
      }
  string do_clear(object me)
 {
    me=this_player();
    if((int)me->query("killers_clear_flag") > 0)
      return("已经给了你一次重新做人的机会了，你还来？是不是有点...");
   if((int)me->query("killers") > 5 && (int)me->query("PKS") > 20 ){
    return("你身上的杀气太重，看样子天神也帮不了你了...");
   }
    else{
        me->delete("killers");
        me->set("killers_clear_flag", 1);
    }
  message_vision("慕容公子对着$N念了念咒语，$N身上的杀气大减。\n",me);
   return("你身上的杀气已净，日后当多多行善。");
 }
