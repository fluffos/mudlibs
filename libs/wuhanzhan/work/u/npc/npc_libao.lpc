#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "圣" HIR "诞" HIY "大" HIB "礼" HIC "包" NOR, ({ "shengdan dalibao", "bao" }));
  set_max_encumbrance(50);
  if (clonep()) {
    object a;
    seteuid(getuid());
    if (a = new("/u/bqt/obj/taocan"))
      a->move(this_object());
    set_default_object(__FILE__);
  } else {
    set("unit", "个");
    set("value", 0); set("long", "一个圣诞老人送的大礼包，提在手里沉甸甸的。\n");
    if (!wizardp(this_player())) {
      set("no_steal", "偷？你也想的出来！\n"); set("no_sell", "卖？！你大概是穷疯了吧！\n");
      set("no_give", "这么贵重的礼物，哪能随便给人？\n");
      set("no_get", "拿别人的东西不好吧！\n");
      set("no_put", "嘿嘿，别妄想了！ \n");
    }
  }
}
int is_container() {
  return 1;
}
