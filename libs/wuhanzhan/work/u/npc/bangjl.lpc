//bangjl.c buy forsky for 帮会系统

#include "bang.h";
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string c_name;
	string player;
	string *dir;
	object member,obj;
	int i;
	seteuid(getuid());
	
    if(!arg || sscanf(arg,"%s",c_name) != 1)
    	return notify_fail("指令格式：bangjl 帮名[中文]\n");
    
	if(!check_legal_name(c_name))	return 1;

    if((int)me->query("combat_exp") < LEADER_EXP_MIN)
        return notify_fail("你的道行不够"+chinese_number(LEADER_EXP_MIN/1000)+"年。\n");
   	
    if((int)me->query("balance") < GOLD_COST)
    	return notify_fail("你的银行存款不够"+chinese_number(GOLD_COST)+"两金子。\n");
    
	dir = get_dir(DATA_DIR+"guild/");
	for(i=0; i<sizeof(dir); i++)
		if(strcmp(dir[i],c_name) == 0)
			return notify_fail("你想创立的帮派中文或英文名字已经被别人占用了！\n");
			
	if(create_guild(me,c_name) == 0){
		me->add("blance",-GOLD_COST);
		message("system",HIG"【消息】：恭喜"+me->query("name")+"成立了帮派----"+c_name+"。\n"NOR,users());
		log_file("GUILD", 
		sprintf("%s（%s）于%s（%s）\n\t创"+HIG+"%s"+NOR+"。\n\n",
		me->query("name"), me->query("id"),NATURE_D->game_time(), ctime(time()), c_name));
	}
	
    return 1;
}
 
int help(object me)
{
    write(@HELP
让你在风云中成立自己的帮派！

指令格式: 
bang xuelianjiao 雪莲教 教主

此指令让你创立一个新的帮，派，或教。 
并封你为雪莲教教主。

又例：

bang bluedress 青衣楼 总管
创立青衣楼并封你为青衣楼总管。
HELP
    );
	return 1;
}