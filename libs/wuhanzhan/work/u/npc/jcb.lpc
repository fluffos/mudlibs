//forsky

#include <ansi.h>
inherit ITEM;  //继承物品
inherit F_SAVE;  //继承可save的属性

mapping *all_biao;  //全局变量，即储存玩家押注的所有数据
string bifeng = " \n";
//全局变量，此处为中国队目前比分和排名
string jieguo = "new";  //全局变量，此处为单场比赛的最终结杲
string target = "new";  //对手
string chuxian;  //是否可以出线
int winlost;

//以下四行为函数声明
int do_read(string);
int do_post(string);
int do_ya(string);
void enough_rest();

void create() {
  set_name(HIY "2002年" HIR "FIFA" HIC "世界杯" HIG "竞猜表" NOR, ({ "biao" }));
  set("long",
    "这是一个记录玩家对本次世界杯中国队将获得\n"
    "的战绩的竞猜押注情况。如何押注请read rules，查看目前的\n"
    "投注情况请read biao。看比赛日程请read scheme。\n");
  set("unit", "张");
  set("no_put", 1);
  set("no_get", 1);
  set_weight(900000000);  //设大点不让玩家Get
  seteuid(getuid());
  restore();
}

void init() {
  add_action("do_read", "read");
  add_action("do_post", "post");
  add_action("do_ya", "bet");
  add_action("do_duijiang", "duijiang");
}

string query_save_file() {
  return DATA_DIR + "board/jingcai-biao";  //你可以定义一个储存文件的路径
}

int do_ya(string arg)  //玩家下注
{
  int j;
  string str;
  object me, ob;
  mapping biao;

  me = this_player();
  if (query("end_ya"))             //表示停止下注，由巫师在do_post()函数里加入
    return notify_fail("截止时间已过，等下一场再来押吧......\n");
  if (query_temp("busy"))        //防止多人同意押注产生意外
    return notify_fail("稍候........\n");
  if (me->query("du"))            //调玩家身上的参数
    return notify_fail("每人只能押一次！\n");
  if (target == "new")
    return notify_fail("管理员还没有指定中国队的对手呢。\n");
  if (!arg || sscanf(arg, "%s %d", str, j) != 2)  //分析玩家指令
    return notify_fail("命令格式：ya <比分> <多少两黄金>\n");
  if (j < 50)
    return notify_fail("押得太少了，至少需要50两。\n");
  if (j > 10000)                    //上限，可以自由调整
    return notify_fail("押得太多，请少于2000。\n");
  if ((int)j > me->query("balance") / 10000)  //钱庄的存款不够押的钱
    return notify_fail("这里不收现金！到钱庄存够了钱再来！”\n");

  message_vision("$N想了半天大声喊道：“我认为中国队和" + target + "的比分是 " + str + " ！押 " + j + " 两黄金！”\n", me);
  me->add("balance", -j * 10000);
  tell_object(me, "钱庄已经扣除了你押下的" + j + "两黄金。请等候闭幕结果吧！\n");

  me->set("du/win", str);  //在玩家身上设下参数这个是赌的结果
  me->set("du/gold", j);  //这个是押的钱数
  me->set("du/target", target);

  biao = ([
    "id": me->query("id"),
    "name": me->query("name"),
    "win": str,
    "gold": j,
  ]);  //这是一个记录该玩家押注数据的映射
  if (!pointerp(all_biao)) all_biao = ({ biao });
  else all_biao += ({ biao });
  save();  //储存进这个文件对应的.o文件里

  remove_call_out("enough_rest");
  call_out("enough_rest", 1);  //1秒后取消busy
  return 1;
}

int do_post(string arg)  //巫师专用，更新对手，现比分
{
  string str;
  int i, j, k;
  object me = this_player();

  if (!wizardp(me)) return 0;
  if (!arg)
    return notify_fail("\n指令格式：\n"
      "post new   开始一轮竟猜\n"
      "post 1 对手  指定中国队的队手\n"
      "post 2 比分  指定比赛比分\n"
      "post end 结束一轮竟猜\n");
  if (sscanf(arg, "%d %s", i, str) == 2)  //更新对手
  {
    if (i == 1) {
      message("system", HIG "〖消息〗：某位巫师将竞猜表上的中国队的对手更新为" + str + " ！\n" NOR, users());
      target = str;  //更新
      save();
      return 1;
    }
    if (i == 2) {
      if (target == "new")
        return notify_fail("对手都没有指定，怎么指定比分？\n");

      jieguo = str;  //更新
      message(
        "system",
        HIG "〖消息〗：竞猜表上的中国队对" + target + "的比分公布，是" + jieguo + "，押对的快去兑奖啊！\n" NOR,
        users()
      );
      bifeng += "中国队    对    " + target + "    比分为： " + jieguo + "\n";
      sscanf(jieguo, "%d:%d", j, k);
      if (j > k) winlost = 1;
      if (j == k) winlost = 2;
      if (j < k) winlost = 3;
      save();
      return 1;
    }
  }
  if (arg == "end") {
    if (query("end_ya"))
      return notify_fail("截止时间已过......\n");

    set("end_ya", 1);  //停止押注
    message("system", HIG "〖消息〗：FIFA世界杯竞猜开始停止下注，请关注比赛结果！\n" NOR, users());
    save();
    return 1;
  }
  if (arg == "new") {
    if (!query("end_ya") && target != "new")
      return notify_fail("现在正在下注......\n");

    set("end_ya", 0);
    message("system", HIG "〖消息〗：世界杯竞猜开始下注了，快来下注啊！\n" NOR, users());
    target = "new";
    all_biao = ({});

    jieguo = "new";
    winlost = 0;
    save();
    return 1;
  }
  return notify_fail("\n指令格式：\n"
    "post new   开始一轮竟猜\n"
    "post 1 对手  指定中国队的队手\n"
    "post 2 比分  指定比赛比分\n"
    "post end 结束一轮竟猜\n");
}

int do_read(string arg)  //玩家查看
{
  int i, j, k;
  object me;
  string name, str, str1, str2;
  mapping biao;

  me = this_player();

  if (arg == "scheme") {
    write("中国队小组赛赛程：\n"
      "6月4日14:30   韩国光州       中国-哥斯达黎加\n"
      "6月7日19:30   韩国西归埔     巴西-中国\n"
      "6月13日14:30  韩国汉城       土耳其—中国\n");

    return 1;
  }

  if (arg == "rules") {
    write("第十七界世界杯，中国代表队到底能不能出线?单场比分又是多少？欢迎在此押注：\n"
      "押注者以黄金为单位，最高押10000 gold，最少 50 gold。现金不\n"
      "收，必须先存进钱庄。押赌后钱庄直接扣钱。比赛结束，押中比分者\n"
      "按8倍数返还黄金并奖励潜能十万，押中胜负者按2倍数返还黄金并奖\n"
      "励潜能两万五千。不中者则罢。\n"
      "想好了后就 " HIY "bet <比分> <多少两黄金>" NOR "\n"
      "当然每个ID只能押一次，押过不能反悔！\n");
    return 1;
  }
  if (arg == "biao") {
    if (bifeng) {
      write("★★★★★★★★★★★★★★★★★★★★★★★★\n"
        HIG "本届世界杯，中国队目前战绩如下\n");
      write(bifeng);
      write(NOR);
    }
    if (target == "new") {
      write("\n下场" HIY "中国队" NOR "的对手管理员还没有指定，");
    }
    if (target != "new" && jieguo == "new") {
      write("\n下场" HIY "中国队" NOR "对阵" + HIW + target + NOR + "，");
    }
    if (target != "new" && jieguo != "new") {
      write("\n本场" HIY "中国队" NOR "对阵" + HIW + target + NOR + "结果：" + jieguo + "，");
    }
    if (!pointerp(all_biao) || !sizeof(all_biao))  //表示还没有数据
    {
      write("还没有人开始投注。\n");
      return 1;
    }
    write("已有 " + sizeof(all_biao) + " 个玩家投注：\n"
      HIC "玩家名　　　预测比分　押黄金数｜玩家名　　　　预测比分　押黄金数\n");
    str1 = HIM "已经兑过奖的玩家：\n" NOR;
    str2 = HIM "还未兑过奖的玩家：\n" NOR;
    j = 0;
    k = 0;
    for (i = 0; i < sizeof(all_biao); i++)  //all_biao也是全局变量，看文件头
    {
      name = all_biao[i]["name"] + "(" + all_biao[i]["id"] + ")";  //取出每个押注玩家的名字
      if (!(int)all_biao[i]["dui"])  //dui这个参数是在兑奖后加入的,这表示没兑奖的，加入str2
      {
        str2 += sprintf("%-10s    %-5s  %-5d%s", name, (int)all_biao[i]["win"],
          (int)all_biao[i]["gold"], j % 2 ? "\n" : "｜",);
        j++;  //j和下面的k都是为了两个一行，分行用的j%2就是除2剩下的余数，为0就换行
      } else  //有dui参数的，记入str1
      {
        str1 += sprintf("%-10s    %-5s  %-5d%s", name, (int)all_biao[i]["win"],
          (int)all_biao[i]["gold"], k % 2 ? "\n" : "｜",);
        k++;
      }
    }
    /*这里的str1与str2可以根据不同的情况表现不同的信息,比如在比赛中，可以
根据all_biao[i]["win"]是否大于num，即目前的金牌数，判断哪些玩家还有希
望，哪些玩家已经被淘汰：str1="无获奖希望的玩家"：......
*/
    write(str1 + "\n" + str2 + "\n");  //显示信息
    return 1;
  } else
    write("你要看什么？押注规则请read rules，押注情况请read biao。\n"
      "看比赛日程请read scheme。\n");
  return 1;
}

void enough_rest() {
  delete_temp("busy");
}

int do_duijiang()  //兑奖指令
{
  int i, j, arg1, arg2, flag;
  object me, ob;
  mapping biao, du;

  me = this_player();

  if (jieguo == "new")  //没有jieguo就表示没有开始兑奖
    return notify_fail("还未到兑奖时间！\n");
  if (!du = me->query("du"))  //查找身上参数
    return notify_fail("你没有奖的，或者已经兑过奖了！\n");
  if (query_temp("busy"))
    return notify_fail("稍候........\n");
  set_temp("busy", 1);
  if (me->query("du/target") != target)
    return notify_fail("本场比赛你没有下注。\n");

  sscanf(du["win"], "%d:%d", arg1, arg2);
  if (arg1 > arg2) flag = 1;
  if (arg1 == arg2) flag = 2;
  if (arg1 < arg2) flag = 3;

  if (strcmp(du["win"], jieguo) == 0)  //与结果相符，即中奖
  {
    i = du["gold"] * 8;
    write("你押比分 " + du["win"] + " " + du["gold"] + " 两黄金，按规定得奖金 " + i + " 两黄金，已划入你的钱庄帐户！\n");
    message("system", HIG "〖消息〗：" + me->name() + "押中比分，兑奖得到 " + i + " 两黄金和六万潜能！\n" NOR, users());
    me->add("balance", i * 10000);
    me->add("potential", 100000);
  } else if (flag == winlost) {
    i = du["gold"] * 2;
    write("你押比分 " + du["win"] + " " + du["gold"] + " 两黄金，按规定得奖金 " + i + " 两黄金，已划入你的钱庄帐户！\n");
    message("system", HIG "〖消息〗：" + me->name() + "押中胜负，兑奖得到 " + i + " 两黄金和一万五千潜能！\n" NOR, users());
    me->add("balance", i * 10000);
    me->add("potential", 25000);
  } else  //没有对的也来个空门奖吧
  {
    ob = new("/clone/food/jitui");
    ob->move(me);
    write("你没押对，但发一个安慰奖，送你一根鸡腿吧！\n");
    message_vision(HIY "竞猜表上头突然金光一闪，“扑”地掉下一根油光光的鸡腿，正好掉进$N的手中。\n" NOR, me);
  }
  for (j = 0; j < sizeof(all_biao); j++) {
    if (all_biao[j]["id"] == me->query("id"))
      all_biao[j]["dui"] = 1;  //表示此人兑过奖了
  }
  save();  //存盘
  me->delete("du");  //身上参数取消，以防重复兑奖
  remove_call_out("enough_rest");
  call_out("enough_rest", 1);
  return 1;
}
