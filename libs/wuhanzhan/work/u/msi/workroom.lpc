inherit ROOM;
void create() {
  set("short", "神殿");
  set("long", @LONG
一间充满了神密气息的房间。
LONG
  );
  set("exits", ([
    "down": "/d/city/kezhan",
    "room": "/d/wiz/wizroom",
  ]));
  set("objects", ([
    //      __DIR__"npc/magic": 1,
  ]));
  set("no_magic", 1);
  set("no_burn", 1);
  set("no_spells", 1);
  set("no_fight", 1);
  set("no_spells", 1);
  set("no_dazuo", 1);
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 5);
  setup();
  // replace_program(ROOM);
}
void init() {
  add_action("do_qq", "qq");
}
int gethim(object target, object me) {
  if (!target || !me) return 1;
  if (environment(me) == this_object()) {
    message_vision("$N一听说天使有请，匆匆忙忙地离开了。\n", target);
    target->move(this_object());
    message_vision("$N匆匆忙忙地跑了进来，\n", target);

    return 1;
  }
  return 1;
}
int do_loan(string arg) {
  return 1;
}
int do_qq(string arg) {
  object me, target;
  //int exp, stra,leader,factor;
  if (!arg)
    return notify_fail("你要邀请谁？\n");
  me = this_player();
  if ((string)me->query("id") != "wsw")
    return notify_fail("你不是天使，不可以邀请别人！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的心神不够！\n");
  me->add("sen", -0);
  if (!objectp(target = find_living(arg)))
    return notify_fail("找不到你想要的人！\n");
  message_vision("天空中传来声音，$N请$n。\n", me, target);
  call_out("gethim", 5, target, me);
  return 1;
}
int valid_leave(object me, string dir) {
  if (me->is_fighting())
    return notify_fail("你刚刚请了朋友不能离开！\n");
  return 1;
}
