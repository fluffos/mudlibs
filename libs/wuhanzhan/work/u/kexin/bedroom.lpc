inherit ROOM;
#include <ansi.h>
#include <room.h>

void create ()
{
  set ("short", "浪漫世界");
  set ("long", @LONG

一间占地不大的小房间，石榻石桌石椅，布置得高雅脱俗。
石桌上放着一副松枝松子所制的棋具，屋角焚着一炉百花
香，散发着淡淡花香。香炉边摆着一具松木瑶琴。可馨闲
来无事时，便在此与好友抚琴弈棋，消遥自在。
LONG);
  set("exits", ([ /* sizeof() == 3 */
  //   "down" : "/u/kexin/workroom",
  
  "out": "/d/city/center",
]));
 set("sleep_room", 1);
 set("no_time", 1);
  set("objects", ([ 
     __DIR__"npc/mishu" : 1,
]));
  
  setup();
}
int valid_leave(object me,string dir)
{
  object mishu;
  if ((dir=="out"|| dir=="up") && mishu=present("jin zi",environment(me)) )
  {
 if (!living(mishu)) return ::valid_leave(me,dir);
  if (me->query("gender")!="女性")
   return notify_fail("浪漫金子一把揪住你：“你又不是女人不许进！”\n");
 
   if (me->query_skill("dodge",1) <500)
   if (random(6))
   return notify_fail("浪漫金子拉住你的手，叮咛道：“上面没有楼梯，千万小心！”\n");
  }
  return ::valid_leave(me,dir);
}

void init()
{
object me=this_player();
   if (((this_player()->query("id") != "kexin") || (this_player()->query("id") != "newkilly")))
 message_vision(HIW"\n\t浪漫金子说到，出去！\n"NOR, me);
     }
