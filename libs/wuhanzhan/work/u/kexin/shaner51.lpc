#include <ansi.h>
inherit NPC;

int de_jiang ();

void create()
{
  set_name(MAG "姗儿" NOR, ({ "shan er", "shaner",}));
  set("title", HIW"武汉站“五一”劳动奖章评选委员会主席" NOR);
  set("long", "  武汉站“五一”劳动奖章评选委员会主席，白蜻蜓让她来人间进
　行五一最佳劳动者评选，颁发奖励。\n");
  set("gender", "女性");
  set("age", 20);
  set("attitude", "peaceful");
  set("class", "xian");
  set("per",30);
 
  set("max_mana",5000);
  set("max_force",5000);
  set("combat_exp",1000000);
    
  set("inquiry", ([
    "得奖" : (: de_jiang :),
  ]) );
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/lingtai/obj/yunxie")->wear();
}

void do_de (object who)
{
  object me = this_object();
  object guo;  int size;
  string *strs;
  mapping skills = who->query_skills();
  int i;
    if (who->query("nian/51"))
    return;
    if (((int)who->query("mud_age") < 40000 ))   
    return;

  
  size = sizeof(skills);
    
  command("pat "+ who->query("id"));
  message_vision ("\n$N对$n说："+RANK_D->query_respect(who)+
                  "根据白蜻蜓颁布的五一劳动者评选规则,对你进行如下奖励\n",me,who);
  who->add("nian/51",1);
  who->add("potential",510000);
  who->add("max_force",100);
  who->add("combat_exp", (int)who->query("combat_exp")/20);
  who->add("max_mana",150);
  tell_object(who,"你得到了五十一万点潜能!\n");
  tell_object(who,"你得到了一百点内力和法力!\n");
  tell_object(who,"你得到了5%的道行!\n");
  strs = keys(skills);
  for (i = 0; i < size; i++)
  {
    call_out("deing",i/50,me,who,strs[i]);
  }
  
}


void deing (object me, object who, string str)
{
  int i = who->query_skill(str,1);
  int nian;
  string name = to_chinese(str);
  
 if(i>550) nian = 3;
     else if(i>450) nian = 4 ;
       else if(i>350) nian = 5 ; 
         else if(i>250) nian = 6; 
           else if(i>150) nian = 7; 
              else if(i>100) nian = 8;
                else if(i>50) nian = 9;
                  else if(i>10) nian = 10;              
                  else nian = 0; 

  who->set_skill(str,i+nian);
  tell_object(who,"你得到了"+chinese_number(nian)+"级"+name+"！\n");
}

int de_jiang ()
{
  object me = this_object();
  object who = this_player();
 
  if( me->is_busy() ) {
    message_vision ("$N对$n说道：这位"+RANK_D->query_respect(who)+"，我正忙着哩！\n",me,who);
    return 1;
    }
        
  if( who->is_busy() ) {
    message_vision ("$N对$n说道："+RANK_D->query_respect(who)+"不用心急，正在给您颁奖呢。\n",me,who);     
    return 1;
    }
  if (who->query("nian/51"))
  {
    message_vision ("$N对$n说道：你已经领过奖励了哦!\n",me,who);
    command("kok"+ who->query("id"));
    return 1;
  }
  if (((int)who->query("mud_age") < 40000 ))    
  {
   message_vision ("$N对$n说道,你不爱劳动,不是好孩子,没的奖励!\n",me,who);
   command("maoli"+ who->query("id"));
   return 1;
  }
  
  do_de (who);
  return 1;
}



