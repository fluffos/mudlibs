inherit NPC;
#include <ansi.h>
void create() {
  set_name(HIR "浪漫金子" NOR, ({ "jin zi", "zi", "mishu" }));
  set("title", HIY "张可馨的秘书" NOR);
  set("gender", "女性");
  set("age", 15);
  set("per", 30);
  setup();

  carry_object("/d/obj/cloth/skirt")->wear();
  add_money("gold", 10);



  set("chat_msg", ({
    "浪漫金子说道: 你们认识我的主子吗?\n",
    "浪漫金子说道: 我正准备给可馨倒水呢!\n",
    "浪漫金子说道: 可馨在这里很认真工作哟,咳!累坏了她了!\n",
  }));
  set("chat_chance", 2);
}
