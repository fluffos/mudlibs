    "    " + HIW + "    壮丽的城堡，金碧辉煌，四周氤气缭绕，令人见之忘俗。\n" + NOR ""

    " " + HIY + "                             !                          \n " + NOR + ""
    " " + HIY + "                           /^\\                         \n " + NOR + ""
    " " + HIY + "                         /     \\                       \n " + NOR + ""
    " " + HIY + "          |           | /       \\ |           |        \n " + NOR + ""
    " " + HIY + "         (^) |       (^) )     ( (^)       | (^)       \n " + NOR + ""
    " " + HIY + "         |O|(^)     (   )|-----|(   )     (^)|O|       \n " + NOR + ""
    " " + HIY + "         |_||-| |^-^|---||-----||---|^-^| |-||_|       \n " + NOR + ""
    " " + HIY + "         |O||O| |(^)|(^)||  |  ||(^)|(^)| |O||O|       \n " + NOR + ""
    " " + HIY + "         |-||-| ||_|||_||| (^) |||_|||_|| |-||-|       \n " + NOR + ""
    " " + HIY + "         |O||O| |(^)|(^)||(   )||(^)|(^)| |O||O|       \n " + NOR + ""
    " " + HIY + "         |-||-| ||_|||_||||   ||||_|||_|| |-||-|       \n " + NOR + ""
    "                                   \n"
    "                       " + BLINK + "" HIM "这就是☆六翼天使城☆。\n " + NOR + ""

  );

