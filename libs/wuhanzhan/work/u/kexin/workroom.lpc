}
int valid_leave(object me,string dir)
{
  object mishu;
if ((dir=="wc"|| dir=="up") && mishu=present("jin zi",environment(me)) )
  {
  if (!living(mishu)) return ::valid_leave(me,dir);
  if (me->query("gender")!="女性")
   return notify_fail("浪漫金子一把揪住你：“你又不是女人不许进！”\n");
 
  if (me->query_skill("dodge",1) <100)
  if (random(3))
   return notify_fail("浪漫金子拉住你的手，叮咛道：“上面没有楼梯，千万小心！”\n");
  }
  return ::valid_leave(me,dir);
}

void greeting_me(object me)
{

        if(!me) return;
                      if(me->query("id")=="kexin") return;
                                tell_object(me,HIR"\n你的眼前一黑，接着什么也不知道了．．．\n"NOR);
                                                                                                                        tell_object(me,"\n\n你死了。\n");
                                                tell_object(me,HIM"\n【谣言】某人："+me->query("name")+"莫名其妙的死了。\n"NOR);
                                                }
                                                
                                                void init()
                                                {
                                                remove_call_out("greeting_me");
                                                         call_out("greeting_me",1,this_player());
                                                            if(!wizardp(this_player()))
                                                         {
                                                         object me;
                                                         me=this_player();
                                                         call_out("yun",2,me);
                                                         
                                                         }
                                                         }
                                                         int yun()
                                                         {
                                                         object me=this_player();
                                                         me->unconcious();
                                                         }
                                                         
