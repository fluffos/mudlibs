inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "卫生间");
  set("long", @LONG

这里是一个有花有草的地方,没想到可馨的卫生间都这么别致,你看
卫生间里花草甚多，什么凤仙、鸡冠、秋葵、百合、蔷薇、牡丹等
等，不可枚举，满目皆是．遇花开之时，后花园中红红紫紫，漫如
锦屏．真想多呆一会，好好看看,这里还可以洗澡呢,但是如果你不
女生那么会是怎么样的情况呢?  还是赶紧钻进墙上的洞吧！（dong）
LONG);


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_xizao", "xizao");
  add_action("do_zuan", "zuan");
}
int do_xizao(string arg) {
  object me;
  me = this_player();


  message_vision("$N刚刚脱掉衣服,突然间有个大手把你抓了起来。\n", me);
  me->move("/d/wiz/qiushi");
  tell_room(environment(me), "「咕咚」一声，" + me->name() + "被人从墙头上扔了下来！\n",
    me);
  return 1;
}
int do_zuan(string arg) {
  object me = this_player();
  if (!arg || arg != "dong")
    return notify_fail("你要钻什么？\n", me);
  if (me->query("kee") < 300)
    return notify_fail("你再撞墙就要死了，还不赶紧吸口气，继续来！\n");
  if (random(5) != 1) {
    message_vision(HIR "突然" + me->name() + "一头撞到了墙上，撞的头破血流!\n" NOR, me);
    me->add("kee", -random(290));
    return 1;
  } else
    me->move("/d/city/center");

  message_vision(HIW "$N费了半天劲总算钻了出来！\n" NOR, me);
  return 1;
}
