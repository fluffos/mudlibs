#include <ansi.h>

inherit F_DBASE;

string *families = ({
  "大雪山",
  "方寸山三星洞",
  "月宫",
  "南海普陀山",
  "阎罗地府",
  "将军府",
  "东海龙宫",
  "陷空山无底洞",
  "五庄观",
  "灵剑门",
  "天王府",
});

void create() {
  seteuid(getuid());
  set("name", "");
  remove_call_out("choose_npc");
  call_out("choose_npc", 10);

}

void choose_npc() {
  int i, j, k, ppl;
  object *list, newob;
  string str;
  list = users();
  i = sizeof(list);

  if (i < 20) {
    remove_call_out("choose_npc");
    call_out("choose_npc", 60);
    return;
  }

  j = random(sizeof(families));
  k = random(sizeof(families));
  while (i--) {
    if (!wizardp(list[i]) && list[i]->query("family/family_name") == families[j]
      && (list[i]->query("combat_exp")) > 10000) {
      newob = new(__DIR__ "npc");
      newob->set("target", families[k]);
      if (newob->invocation(list[i], k))
        ppl++;
      else
        destruct(newob);
    }
  }
  reset_eval_cost();
  if (ppl) {
    if (j != k)
      message("system", HIG "【仙履奇缘】太白金星：听说有" + chinese_number(ppl) + "名"
        +families[j] + "弟子跑到" + families[k] + "去挑衅滋事，也不知" + families[k] + "弟子会不会奋起抵御。\n" NOR, users());
    else
      message("system", HIG "【仙履奇缘】太白金星：听说有" + chinese_number(ppl) + "名"
        +families[j] + "不孝弟子在本门闹事。唉，如今这年头．．．\n" NOR, users());
    remove_call_out("choose_npc");
    call_out("choose_npc", 300);
  } else {
    message("system", HIG "【仙履奇缘】太白金星慢慢地卷着竹帘，似乎在想着无限心事。\n" NOR, users());
    remove_call_out("choose_npc");
    call_out("choose_npc", 60);
  }
}
