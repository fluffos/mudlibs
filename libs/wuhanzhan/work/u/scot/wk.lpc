// This is scot room

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "雨林");
  set("long", @LONG


LONG);
  set("exits", ([ /* sizeof() == 4 */
    "wizz": "/d/wiz/wizroom",
    "kz": "/d/city/kezhan",
  ]));
  set("valid_startroom", 1);
  set("outdoors", "雨林");
  setup();
}

void init() {
  if (this_player()->query("id") != "scot")
    message_vision("$N来盗猎来了。\n", this_player());
  if (this_player()->query("id") != "scot")
    message_vision(
      HIG "忽然雨林中雀儿飞起，呼声一片，" BLINK + HIY "盗猎者" + HIR "$N" NOR + HIG "潜进雨林了，$N好像还不知道被发现了。\n" NOR,
      this_player()
    );
}

int clean_up() {
  return 0;
}

void reset() {
  tell_room(this_object(), BLINK + HIM "Reset．．．．．．．．．．\n" NOR);
  message_vision(HIM "\n\n ●╭○╮ " NOR);
  message_vision(HIM " (█∨█)  " NOR);
  message_vision(HIM " ∏  ∏  \n\n" NOR);

  ::reset();
}
