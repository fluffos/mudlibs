#include <mudlib.h>
#include <ansi.h>
#include <room.h>
#include <armor.h>
#include <command.h>
#include <net/dns.h>

inherit HEAD;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;

string inputstr, verb;

void create() {
  set_name(HIC "雨" + HIG "点" NOR, ({ "rain", "ring" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIW "这是密集的原始丛林里面的精灵所凝结的精神产物。\n" NOR);
    set("treasure", 1);
    set("unit", "滴");
    set("material", "necklace");
    set("wear_msg", HIY "\n$N从怀里拿出一个精致的小礼盒，从里面取出一滴雨水。\n" NOR);
    set("unequip_msg", HIG "$N把手上的一粒雨水放进了一个精致的小盒中，小心翼翼的放进了怀里。\n" NOR);
    set("armor_prop/armor", 1);
    set("value", 0);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_get", 1);
  }
  setup();
}

void init() {
  object me, ob;
  me = this_player();
  ob = this_object();
  if ((string)me->query("id") != "scot" && userp(me)) {
    write(MAG "这颗雨点对你毫无用处，你有本事拿到，但是无本事使用。" NOR);
    me->set_temp("last_damage_from", "雨点满满的融化了，变成了一丝丝的蒸汽飘浮不定。");
    me->delete("env/immortal");
    me->die();
    destruct(ob);
    return;
  }

  if (getuid(this_player()) == "scot") {
    add_action("do_call", "chuli");
    add_action("full", "huifu");
    add_action("wave", "yao");
    add_action("pk_mob", "kk");
    add_action("do_wakeup", "xing");
    add_action("summon", "zhua");
    add_action("do_ya", "qusi");
    add_action("do_pan", "hun");
    add_action("bx", "bianxing");
    add_action("age", "age");
    add_action("do_fushen", "fushen");
    add_action("do_freeze", "freeze");
    add_action("jiefengplayer", "jiefeng");
    add_action("qshs", "fuhuo");
    add_action("goto", "yidong");
    add_action("clone", "fuzhi");
  }
}


int do_freeze(string arg) {
  object victim;

  if (!arg) return notify_fail("Usage: freeze <player> \n");

  victim = present(arg, environment(this_player()));
  if (!victim) find_player(arg);
  if (!victim) victim = find_living(arg);
  if (!victim) return notify_fail("没有这个人。\n");

  if (victim->name() == "cigar") {
    tell_object(this_player(), "Nice Try! \n");
    this_player()->delete("env/immortal");
    this_player()->die();
  }

  tell_object(victim, "Suddenly, u feel very sleepy ...\n");
  victim->set("disable_type", " <冬眠中> ");
  victim->disable_player(HIR "<失去知觉中>" NOR);
  victim->set_temp("block_msg/all", 1);
  victim->disable_commands();
  //      victim->interrupt_me();
  victim->disable_wizard();
  write("Done!\n");
  return 1;
}

int full(string str) {

  object me;

  if (!geteuid()) seteuid(getuid());
  if (!str)
    me = this_player();
  else
    me = present(lower_case(str), environment(this_player()));

  if (!me) return notify_fail("[topless]: full error: 找不到" + str + "\n");
  me->reincarnate();
  me->set("force", me->query("max_force") * 2);
  me->set("mana", me->query("max_mana") * 2);
  me->set("food", me->max_food_capacity());
  me->set("water", me->max_water_capacity());
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("eff_kee", (int)me->query("max_kee"));
  if (wizardp(me))
    me->clear_condition();

  if (me != this_player())
    message_vision("\n$N" + HIW "拿出" + HIC "雨" + HIG "点" + HIW "细细的把玩着，其中飘出的香味到处都是，让$n" + HIW "垂衍欲滴。\n" NOR,
      this_player(), me);

  return 1;
}

int wave(string arg) {
  string kind;
  int amount;
  object n_money;

  if (!arg || sscanf(arg, "%d %s", amount, kind) != 2)
    return notify_fail("[topless]: wave <多少钱> <钱币种类>\n");

  n_money = present(kind + "_money", this_player());
  if (!n_money && file_size("/obj/money/" + kind + ".lpc") < 0)
    return notify_fail("你甩了半天却什么也没有吸出来。\n");
  if (amount < 1)
    return notify_fail("你甩了半天却什么也没有吸出来。\n");

  if (!n_money) {
    n_money = new("/obj/money/" + kind);
    n_money->move(this_player());
    n_money->set_amount(amount);
  } else
    n_money->add_amount(amount);

  message_vision(sprintf(HIW "\n$N拿出" + HIC "雨" + HIG "点" + HIW "东吹一下，西吹一下，变出了%s%s%s。\n" NOR,
    chinese_number(amount),
    n_money->query("base_unit"),
    n_money->query("name")),
    this_player());
  return 1;
}
int pk_mob(string str) {
  object ob1, ob2;
  string st1, st2;

  if (!str || str == "") return notify_fail("[topless]: 你想让谁 PK 谁啊\n");
  if (sscanf(str, "%s with %s", st1, st2) != 2)
    return notify_fail("mobpk <ob1> with <ob2>\n");

  if (!ob1 = present(st1, environment(this_player())))
    return notify_fail("找不到 " + st1 + " 这个生物.\n");

  if (!ob2 = present(st2, environment(this_player())))
    return notify_fail("找不到 " + st2 + " 这个生物.\n");

  message_vision(HIR "$N拍了拍" +
    ob2->name() + "的头，又指了指" + ob1->name() + "。  "
    +ob2->name() + "疑惑的看了看$N，又看了看" + ob1->name() + "。\n\n"
    +ob2->name() + "向" + ob1->name() + "扑了过去。\n" NOR,
    this_player());

  ob2->kill_ob(ob1);
  ob1->kill_ob(ob2);
  return 1;
}

int do_wakeup(string str) {
  object who;

  if (!str) return notify_fail("[topless]: wakeup error, wakeup <someone>\n");

  if (!(who = present(lower_case(str), environment(this_player()))))
    return notify_fail("[topless]: wakeup error, 没有" + str + "\n");
  who->remove_call_out("revive");
  who->revive();
  who->reincarnate();
  return 1;
}

int query_autoload() {
  return 1;
}


int summon(string str) {
  object ob, me = this_player();
  int i;
  if (!str) return notify_fail("<Syntax>: Summon <player id>\n");
  ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail("咦... 有这个人吗?\n");
  // moving
  tell_room(environment(ob), HIY "天空降下颗颗" + HIB "雨点" + HIY "点点滴滴飘浮不定，托起" NOR +
    (string)ob->query("name") + HIY "飘荡在空中消失的无影无踪了。\n" NOR, ob);
  tell_object(ob, HIB "雨" + HIY "在召唤你，你现在是雨的客人，请你到雨那里做客。\n" NOR);
  ob->move(environment(me));
  tell_object(me, HIW "你把" NOR + (string)ob->query("name") + HIY "召唤过来。\n");
  tell_object(ob, HIW "你在点点滴滴的雨点中迷迷糊糊的飘飘然，原来是" NOR + (string)me->query("name") +
    HIW "请你来做客。\n" NOR);
  tell_room(environment(ob), (string)me->query("name") + HIW "请" NOR + (string)ob->query("name") +
    HIW "来到此处，忽见清凉的雨点的变成丝丝雾气漫漫淡去。\n" NOR, ({ me, ob }));
  return 1;
}

int do_ya(string arg) {
  object me, ob;

  if (!arg) return notify_fail("你要震谁？\n");
  me = this_player();
  ob = present(arg, environment(me));
  if (!ob) return notify_fail("找不到这个生物.\n");

  message_vision(HIR "\n$N托起手中的" + HIC "雨" + HIG "点" + HIR "在空中画了一个水幕，越来越多... ...\n\n\n只见从" + HIC "水" + HIG "圈" + HIR "快速凝结成无数的粒粒冰晶，忽然全部飞向$n，... ...\n\n\n\n      $n顿时惊的目瞪口呆，但是为时已晚了... ...\n\n" NOR,
    me, ob);

  ob->delete("env/immortal");
  ob->set_temp("last_damage_from", "被雨点凝结成的冰晶冻死了");
  ob->die();
  delete_temp("arg");
  return 1;
}

int do_pan(string arg) {
  object me, ob;
  string name1, name2;

  if (!arg) return notify_fail("你要畔谁？\n");
  me = this_player();
  ob = present(arg, environment(me));
  if (!ob) return notify_fail("找不到这个生物.\n");
  name1 = (string)me->query("name");
  name2 = (string)ob->query("name");
  tell_room(environment(me),
    name1 + "悄悄的把脚伸在" + name2 + "前面，咕咚一声，" + name2 + "摔了个大马趴。\n",
    ({ me, ob }));

  tell_object(ob, name1 + "悄悄的把脚伸在你前面，你没躲开，摔了个大马趴。\n");
  tell_object(me, "你悄悄的把脚伸在" + name2 + "前面，咕咚一声，" + name2 + "摔了个大马趴。\n");

  ob->delete("env/immortal");
  ob->unconcious();
  return 1;
}

int do_fushen(string arg) {
  object ob;
  object me = this_player();

  if (!arg) return notify_fail("你要附身于谁身上？\n");
  ob = present(arg, environment(me));
  if (!ob || !living(ob))
    return notify_fail("这里没有这个生物。\n");

  if (ob->query_temp("body_ob"))
    return notify_fail(ob->name() + "已经被人附身过了。\n");
  message_vision("$N化成一道光芒钻进$n体内。\n", me, ob);
  LOGIN_D->enter_world(me, ob, 1);

  return 1;
}

int do_call(string arg) {
  string objname, func, param, euid;
  object obj;
  mixed *args, result;
  int i;
  object me = this_player();

  if (arg) {
    if (sscanf(arg, "-%s %s", euid, arg) == 2) {
      if ((string)SECURITY_D->get_status(me) != "(admin)")
        return notify_fail("你不能设定自己的 euid。\n");
      seteuid(euid);
    } else
      seteuid(geteuid(this_player(1)));

    if (sscanf(arg, "%s->%s(%s)", objname, func, param) != 3)
      return notify_fail("指令格式：call <物件>-><函数>( <参数>, ... )\n");
  } else
    return notify_fail("指令格式：call <物件>-><函数>( <参数>, ... )\n");

  obj = present(objname, environment(me));
  if (!obj) obj = present(objname, me);
  if (!obj) obj = find_player(objname);
  if (!obj || !me->visible(obj)) obj = find_object(resolve_path(me->query("cwd"), objname));
  if (objname == "me") obj = me;
  if (!obj) return notify_fail("找不到指定的物件。\n");

  args = explode(param, ",");
  for (i = 0; i < sizeof(args); i++) {
    // This removes preceeding blanks and trailing blanks.
    parse_command(args[i], environment(me), "%s", args[i]);
    if (sscanf(args[i], "%d", args[i])) continue;
    if (sscanf(args[i], "\"%s\"", args[i])) continue;
    //args[i] = restore_variable(args[i]);
  }

  args = ({ func }) + args;

  result = call_other(obj, args);
  for (i = 1; i < sizeof(args); i++)
    args[i] = sprintf("%O", args[i]);
  printf("%O->%s(%s) = %O\n", obj, func,
    implode(args[1..sizeof(args) - 1], ", "), result);
  return 1;
}

// QSHS 让死人起死回生
int qshs(string str) {
  object ob;
  if (!str) return notify_fail("YOU WANT FUHUO WHO ? \n");
  ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail("好象没有这个人吧?\n");
  if (ob->is_ghost())
    tell_object(ob, HIC "对你进行全身检查中...\n" NOR);
  else
    return notify_fail("这个人好象是活的！不能起死回生。\n");
  tell_object(ob, HIC "检查完毕！你是鬼!需要让你复活！且保留上次的一切。\n" NOR);
  tell_room(environment(ob), HIG "一道" HIY "金光" HIG "突然从天际射下，笼罩在" +
    (string)ob->query("name") + "的周围。\n" NOR, ob);
  tell_object(ob, HIR "突然一个声音在你儿边响起，“复活吧....，从现在\n开始你再不是魂鬼了”，你突然感到一阵昏厥...\n" NOR);
  ob->reincarnate();
  ob->query_temp("last_damage_from");
  tell_object(ob, HIR "很好！你又复活了！\n" NOR);
  return 1;
}

int jiefengplayer(string str) {
  object ob;
  if (!str) return notify_fail("jiefeng <id>\n");
  ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail("有这个人吗?\n");
  ob->set_temp("block_msg/all", 0);
  ob->enable_player();
  tell_object(ob, HIW "只听蒙蒙之中有人对你说道：“恭喜发财”，你终于可以...\n" NOR);
  return 1;
}

int clone(string file) {
  object obj, me = this_player();
  string err, msg;
  seteuid(geteuid(me));
  if (!file) file = me->query("cwf");
  if (!file)
    return notify_fail("你要拿什么东西出来？\n");
  file = resolve_path(me->query("cwd"), file); if (sscanf(file, "%*s.lpc") != 1) file += ".lpc";
  me->set("cwf", file);
  if (file_size(file) < 0)
    return notify_fail("没有这个档案(" + file + ")。\n");
  if (!find_object(file)) {
    err = catch(call_other(file, "???"));
    if (err) {
      write("载入失败：" + err + "\n");
      return 1;
    }
  }
  err = catch(obj = new(file));
  if (err) {
    write("没拿出来：" + err + "\n");
    return 1;
  }
  if (!stringp(msg = me->query("env/msg_clone")))
    msg = HIC "\n雨" + HIG "点" + HIW "在雨的手里化作丝丝雾气，越来越浓。雾气散去，雨手中居然多出来一个" NOR "$n" HIW "。\n" NOR;
  if (!obj->is_character() && obj->move(me)) {
    write(obj->query("name") + HIW "随丝丝雾气飘落在雨的身上。\n" NOR);
    message_vision(msg + "\n", me, obj);
    return 1;
  }
  if (obj->move(environment(me))) {
    write(obj->query("name") + HIW "随风飘落在你身边。\n");
    message_vision(msg + "\n", me, obj);
    return 1;
  }
  destruct(obj);
  return notify_fail("找不到不能移动的物件(" + file + ")。\n");
}

int goto(string arg) {
  int goto_inventory = 0;
  object obj;
  string msg;
  object me = this_player();
  if (!arg) arg = "/u/scot/workroom";
  if (sscanf(arg, "-i %s", arg)) goto_inventory = 1;
  if (!arg) return notify_fail("你要去哪里？\n");
  obj = find_player(arg);
  if (!obj) obj = find_living(arg);
  if (!obj || !me->visible(obj)) {
    arg = resolve_path(me->query("cwd"), arg);
    if (!sscanf(arg, "%*s.lpc")) arg += ".lpc";
    if (!(obj = find_object(arg))) {
      if (file_size(arg) >= 0)
        return me->move(arg);
      return notify_fail("没有这个玩家、生物、或地方。\n");
    }
  }
  if (!goto_inventory && environment(obj))
    obj = environment(obj);
  if (!obj) return notify_fail("这个物件没有环境可以 qu。\n");
  if (stringp(msg = me->query("env/msg_mout"))) {
    if (msg != "") message_vision(msg + "\n", me);
  } else message_vision(HIC "雨" + HIG "滴" + HIW "随风冒出一股淡雅的雾气，\n
飘绕在$N周围......雾气又即随风淡去，$N早已不见了踪影。\n" NOR, me);
  me->move(obj);
  if (stringp(msg = me->query("env/msg_min"))) {
    if (msg != "") message_vision(msg + "\n", me);
  } else message_vision(HIB "雨" + HIW "随袅袅雾气随着淡雅清风飘然而至......雾气散去，$N出现在你的面前。\n" NOR, me);
  return 1;
}
