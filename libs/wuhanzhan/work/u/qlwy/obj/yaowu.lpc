#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "怪了,拿不起来耶！\n");
    set("no_give", "留着自己用吧！\n");
    set("no_drop", "这么宝贵的东西，扔了多可惜呀！\n");
    set("no_sell", ":D。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "药物" NOR, ({ "yaowu" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "药物!\n");
    set("value", 100);
  }

  setup();
}

int do_eat(string arg) {
  object who = this_player();
  object ob = this_object();
  if (arg != "yaowu") return notify_fail("你要吃什么？\n");
  message_vision("只听的咕隆的一声响，$N把药物吃了下去。\n" NOR, who);
  who->set("title", HIW + HBBLU "给你一把手枪" + HIR + HBWHT "给你一发子弹" NOR);
  destruct(ob);
  return 1;
}
