
#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
     set("no_get",1);
     set("no_give",1);
     set("no_drop",1);
     set("no_sell",1);
  }                                    
  add_action("do_eat", "eat");
}

void create()
{
  set_name(MAG"中秋月饼"NOR, ({"yuebing"}));
  set_weight(20);
  if (clonep())
  set_default_object(__FILE__);
  else {
  set("unit", "个");
  set("long", "一个引人嘴馋的月饼.\n");
  set("value", 1000);
  }
  
  setup();
}

int do_eat(string arg)
{
  object who=this_player();
  object ob=this_object();
  if (!arg||arg!="yuebing") return notify_fail("你要吃什么?");
 if(who->query("liwu101/eat")>0)
  {
  tell_object(who,"吃多了,反而对身体不好哦。\n");
  destruct(ob);
  return 1;
  }
  who->set("food", (int)who->max_food_capacity());
  who->add("combat_exp",10000);
  who->add("potential",50000);
  who->add("max_force",30);
  who->add("max_mana",30);
  message_vision("$N把月饼吃完,还舔了舔嘴，似乎意犹未尽！\n" NOR, who); 
  tell_object(who,HIW"你得到了五万点潜能和十年道行的奖励，内力法力各加了30点!\n"NOR); 
who->add("liwu101/eat",1);
  destruct(ob); 
  return 1;
}

