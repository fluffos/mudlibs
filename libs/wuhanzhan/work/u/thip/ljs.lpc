int valid_learn(object me) {
  object ob;

  if ((string)me->query("family/family_name") != "灵剑门")
    return notify_fail(HIR "灵剑七式" NOR "乃灵剑门不传之秘。\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够，没有办法练" HIR "灵剑七式。\n" NOR);
  if ((string)me->query_skill_mapped("force") != "lingjian-force")
    return notify_fail(HIR "灵剑七式" NOR "必须配合的" HIR "灵剑心法" NOR "才能练。\n");
  if ((int)me->query_skill("force", 1) < 100 && me->query("family/class") != "qi")
    return notify_fail("你的真力不够纯熟，没有办法学" HIR "灵剑七式。\n" NOR);
  if ((int)me->query_skill("sword", 1) < 100 && me->query("family/class") != "jian")
    return notify_fail("你的剑法不够纯熟，没有办法学" HIR "灵剑七式。\n" NOR);
  if ((int)me->query_skill("dodge", 1) < 100 && me->query("family/class") != "ling")
    return notify_fail("你的轻功不够，没有办法练" HIR "灵剑七式。\n" NOR);

  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  int level;

  level = (int)me->query_skill("lingjian-shi", 1);

  if (random(level) > 200 && (int)me->query("force", 1) > 500) {
    if (me->query("family/class") == "jian") {
      me->add("force", -50);
      return actionj[random(sizeof(actionj))];
    }
    if (me->query("family/class") == "qi") {
      me->add("force", -100);
      return actionq[random(sizeof(actionq))];
    }
    if (me->query("family/class") == "ling") {
      me->add("force", -30);
      return actionl[random(sizeof(actionl))];
    }
  }
  return action[random(sizeof(action))];
}
/*
mapping query_action(object me, object weapon)
{
   return action[random(sizeof(action))];
}
*/

int practice_skill(object me) {
  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 30)
    return notify_fail("你的内力或气不够，没有办法练习这套剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -30);
  switch (me->query("family/class")) {
    case "jian": write("你挥剑练了一遍灵剑七式，对剑意又有领悟。\n"); return 1;
    case "qi": write("你潜运内力练了一遍灵剑七式，对剑气又有领悟。\n"); return 1;
    case "ling": write("你脚踏灵剑步，来来回回舞了一遍灵剑七式，对剑灵又有领悟。\n"); return 1;
  }

}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;

  if (random(damage_bonus / 2) > victim->query_str()) {
    victim->receive_wound("kee", (damage_bonus - 100) / 4);
    switch (random(3)) {
      case 0: return "$n身上出现一道深可见骨的伤口！\n";
      case 1: return "$N劲力一吐，一道剑气从$w中冲出击中$n的$l！\n";
      case 2: return "只听见$n发出一声惨叫 ...\n";
    }
  }
}

string perform_action_file(string func) {
  return CLASS_D("lingjian") + "/lingjian-shi/" + func;
}
