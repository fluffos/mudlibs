inherit NPC;

string *names = ({
  "金龙",
  "黄龙",
  "黑龙",
  "白龙",
  "玉龙",
  "红龙",
  "赤龙",
  "水龙",
  "火龙",
  "霸王龙",
  "绿龙",
  "雷龙",
});

void create()
{
  set_name(names[random(sizeof(names))], ({"dragon", "long"}));
  set("race", "野兽");
  set("age", 10);

  set_skill("dodge", 60);
  set("combat_exp", 10000);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
  set("verbs", ({ "bite"}));

  set("chat_chance", 1);

  set("ride/msg", "骑");
  set("ride/dodge", 30+random(6));
  set_temp("apply/attack", 40);
  set_temp("apply/armor", 20);

  setup();
}


