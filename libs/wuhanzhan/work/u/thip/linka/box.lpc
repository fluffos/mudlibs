#include <ansi.h>
inherit ITEM;
void create()
{
    set_name( HIY "补偿匣子" NOR, ({ "box" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
        set("unit", "个");
            set("material", "cloth");
            set("long", "莫名其妙当机的补偿，请OPEN it。\n");
                set("no_drop", "如此宝贵的东西再世难求啊。\n");
                set("no_put", "珍惜它吧。\n");
                set("no_get", "送人？亏你想的出来！\n");

}
    setup();
}
void init()
{
if(environment()==this_player())
add_action("do_open","open");
}
int do_open(string arg)
{
object gold;
object me;
me=this_player();
if(arg != "box" && arg != "补偿匣子") return 0;
me->add("potential",5000);
write(HIC "由于系统当机，补偿给你5000点潜能!\n\n");
destruct(this_object());
return 1;
}

