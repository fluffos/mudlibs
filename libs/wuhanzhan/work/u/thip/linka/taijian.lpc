#include <ansi.h>

inherit NPC;

string ask_for_join();

void create() {
  set_name("白公公", ({ "bai gonggong", "gonggong" }));

  set("gender", "中性");
  set("title", "净事房总管");
  set("age", 50);
  set("attitude", "peaceful");
  set("class", "taijian");

  set("str", 17);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 20);

  set("atman", 200);
  set("max_atman", 200);

  set("force", 150);
  set("max_force", 150);
  set("force_factor", 5);

  set("mana", 200);
  set("max_mana", 200);

  set("combat_exp", 10000);
  //   set("score", 9000);

  set("inquiry", ([
    "name": "本宫专管入宫当太监的人净身。\n",
    "入宫": (: ask_for_join :),
  ]));

  create_family("东厂", 4, "弟子");

  setup();
}

void init() {
  add_action("do_yuanyi", "yuanyi");
}

string ask_for_join() {
  object me;

  me = this_player();

  if (me->query("married"))
    return "哼！都有老婆孩子了，现在才想入宫？没门！\n";
  if ((string)me->query("gender") == "中性")
    return "你不是已经入宫了吗，怎么还来烦我？滚！\n";
  if ((string)me->query("gender") != "男性")
    return "本宫这里是收太监入宫的，你来凑什么热闹，滚开！\n";
  me->set_temp("join_chaoting", 1);
  return "这是你自己说的，我可没有逼你哦！想清楚了就说愿意（yuanyi）。\n";
}

int do_yuanyi() {
  string name, new_name;

  if (!this_player()->query_temp("join_chaoting")) return 0;
  message_vision(HIC "$N答道：奴才愿意。\n\n" +
    "$n邪恶的阴笑了一声，挥了一下手，$N忽然昏倒了，\n$N醒来的时候发现自己已经成了太监。\n\n" NOR,
    this_player(), this_object());
  name = this_player()->query("name");
  new_name = name[0..1] + "公公";
  command("say 恭喜你了，" + new_name + "。");
  command("hehe");
  this_player()->delete_temp("pending/join_bonze");
  this_player()->set("name", new_name);
  this_player()->set("class", "taijian");
  this_player()->set("gender", "中性");
  this_player()->set("title", "候职太监");
  this_player()->save();
  return 1;
}
