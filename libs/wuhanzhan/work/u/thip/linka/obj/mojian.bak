#include <weapon.h>
inherit SWORD;
#include <ansi.h>

void create()
{
   set_name(HIR"魔剑"NOR, ({"sword", "jian"}));
   set_weight(50);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("long", "这是一柄血红色的长剑，剑身时时散射红光。\n");
     set("value", 500);
     set("material", "steel");
     set("wield_msg", HIR"一阵红光，$N手中出现了把血红色的剑。\n"NOR);
     set("unwield_msg", HIR"$N一阵红光，$N手中的剑消失的无影无踪。\n"NOR);
   }
   init_sword(10);
   setup();
}

void init()
{
   remove_call_out("do_lvup");
   call_out("do_lvup", 1);
}

void do_lvup()
{
   if(this_object()) call_out("lvup", 15);
}

void lvup()
{
   object env,me;
 
   if(!this_object()) return;
   
   me= this_player();
   env=environment(this_object());

   if( env->is_character() )
   {
     if( (int)env->query_skill("force", 1) > 50 )
     {
        if(environment(env))
          message_vision("一道红光闪过，附在$N身上消失了。\n", env);
          me->improve_skill("sword",random(100));
   if(this_object()) call_out("lvup", 15);

        return;
     }
   }

   else if( (int)env->query_max_encumbrance() > 0 && !environment(env) )
   {//a room.
     if( (string)env->query("outdoors") != "xueshan" )
     {
        tell_object(env,"忽然闪过一道红光，不知发生了什么。\n");
        destruct(this_object());
        return;
     }
   }
}

