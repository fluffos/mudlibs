// poem.c

inherit ITEM;

void init();
int do_read(string arg);

void create()
{
        set_name("〖剑术神篇〗", ({"sword book","book","shu"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
        set("long",
        "这本书记载了灵剑老祖毕生的剑法心得体会。\n");
        set("material", "paper");
        set("value", 500);   
        }
}

void init()
{
        add_action("do_read", "read");
}

int do_read(string arg)
{
        object me;
        int sen_cost, gain;
        
        me=this_player();

        if( !this_object()->id(arg) ) return 0;
        if (me->query("family/famliy_name") = "灵剑门")
                        return notify_fail("偷看别派秘籍，终不是君子所为吧……\n");
        if( me->is_busy() )
                        return notify_fail("你现在忙着呢，哪有空闲读书...\n");
        if( me->is_fighting() )
                        return notify_fail("打架时还看书？\n");
        
        if( (int)me->query_skill("literate",1)<300 )
                return notify_fail("你读了半天，却不明白是什么意思，大概你理解能力太差了。\n");
        
        if( (int)me->query_skill("sword",1)>500 || (int)me->query_skill("lingjian-shi",1)>500 )
                return notify_fail("你在剑法方面已经举世无双了，这本书不会让你长进多少。\n");

        sen_cost = 100 + (35-(int)me->query("int"));
        if( (int)me->query("sen")<sen_cost )
                return notify_fail("你现在头晕脑胀，该休息休息了。\n"); 
        me->receive_damage("sen", sen_cost);

        gain = (int)me->query_skill("literate", 1)/10+(int)me->query("int")+1;
        me->improve_skill("sword", gain);
        me->improve_skill("lingjian-shi",gain/2);
                
        message_vision("$N仔细研究灵剑老祖的著作，似乎有所体会。 \n", me);
                
        return 1;
}
