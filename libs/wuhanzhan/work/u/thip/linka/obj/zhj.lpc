#include <weapon.h>
inherit SWORD;
#include <ansi.h>

void create() {
  set_name(HIR "追魂剑" NOR, ({ "zhuihun sword", "jian", "sword" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄" HIR "血红色" NOR "的薄刃剑，剑锋中透射着阵阵杀气。\n");
    set("value", 50000);
    set("material", "steel");
    set("wield_msg", HIW "$N右手迎风一挥，一道" HIR "红光" HIW "晃过，$n" HIW "出现在$N手中。\n" NOR);
    set("unwield_msg", HIW "$N手中$n" HIW "迎风一晃，消失了。\n" NOR);
  }
  init_sword(200);
  setup();
}

void init() {
  remove_call_out("do_melt");
  call_out("do_melt", 1);
}

void do_melt() {
  if (this_object()) call_out("melt", 10 + random(10));
}

void melt() {
  object env;

  if (!this_object()) return;

  env = environment(this_object());

  if (env->is_character()) {
    if ((int)env->query_skill("zhuihun-sword", 1) < 150) {
      if (environment(env))
        message_vision("$N剑法不够纯熟，" HIR "追魂剑" NOR "化做一到红光消失了。\n", env);
      destruct(this_object());
      return;
    }
    if ((int)env->query("bellicosity", 1) < 1000) {
      if (environment(env))
        message_vision("$N杀气不够强大，" HIR "追魂剑" NOR "化做一到红光消失了。\n", env);
      destruct(this_object());
      return;
    }
  }

  else if ((int)env->query_max_encumbrance() > 0 && !environment(env)) {
    tell_object(env, "红光一闪，" HIR "追魂剑" NOR "消失的无影无踪。\n");
    destruct(this_object());
    return;
  }
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int dam;
  int mk;
  int mek;
  mk = (int)me->query("kee", 1);
  mek = (int)me->query("eff_kee", 1);
  dam = (int)me->query("zhuihun-jian", 1);
  victim->receive_damage("kee", dam / 5);
  if (mk < mek) {
    return HIR "从伤口流出的血竟完全被$w" HIR "吸收，$w" HIR "放出一阵暗红的光！\n" NOR;
    me->add("kee", dam / 5);
    me->add("bellicosity", dam / 10);
  }
}
