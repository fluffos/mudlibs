#include <armor.h>
#include <ansi.h>

inherit BOOTS;


void create() {
  set_name(WHT "水晶舞鞋" NOR, ({ "shoes" }));
  set_weight(900);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "高贵典雅的婚礼专用鞋。  \n");
    set("material", "cloth");
    set("unit", "双");
    set("value", 300);
    set("armor_prop/armor", 1);
    set("female_only", 1);
  }
  setup();
}
