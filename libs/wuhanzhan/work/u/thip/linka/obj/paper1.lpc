#include <ansi.h>
inherit ITEM;

void create()
{
   set_name(HIW "剑诀" NOR, ({"paper", "jian jue", "jue"}));
   set_weight(1000);
   set("unit", "张");
   set("long", "一张画有许多小人的纸,由于破旧,有些泛黄了。\n");
   set("value", 100000);
   set("material", "paper");

   if( clonep(this_object()) ) {
     set_default_object(__FILE__);
   }
   setup();
}

void init()
{
add_action("do_perform", "liuxing");
   add_action("do_read","read");
}

int do_read(string arg)
{
   object me = this_player();
   string msg = 
"余本灵剑传人莫云山，因无法领悟家师传授的剑术口诀，
遂将其分别抄录于纸上，留与后人，希望有缘之人能勤
加修炼，发扬灵剑门之英名。

灵剑式「第一式」----「天外流星」：
剑者，百兵之君也。万物皆有道，剑亦有道。
学剑之初，以活用为求；活用之后，又以神遇为求；
神遇之后，又以出神为所求。
然而活用，神遇，出神，皆难脱有形之技，
而家师穷一生之力，悟得灵剑十式，皆以剑意伤敌，
神乎其技，无人可敌。

而这招「天外流星」，虽为第一式，但余熟记之后，挑
战各大剑术高手，无往而不胜。后生莫要轻视。\n";
   if(arg=="paper" || arg=="jianjue") {
     tell_object(me,msg);
     return 1;
   }
    else return 0;
}

int do_perform(string arg)
{
   string msg;
   int success, ap, dp;
   object me, target;

   me = this_player();

    if( !( me->query_temp("weapon")))
     return notify_fail("你手中无剑，无法出这一招。\n");

    if( ! arg )
     return notify_fail("你要攻击谁？\n");

   if( this_player()->is_busy() )
     return notify_fail("你正忙着呢，哪有空御剑。\n");

if( me->query("force") < 500 ) 
     return notify_fail("这招需要很高的内力来御剑。\n");


   if( !objectp( target = present(arg, environment(me)) ) )
     return notify_fail("你想对谁使用这一招？\n");

   if( !target->is_character() )
     return notify_fail("看清楚一点，那并不是活物。\n");

   if( (int)me->query_skill("sword",1)<100 )
     return notify_fail("你对剑术的造诣太低，看不明白上面写的什么。\n");
   if( (int)me->query_skill("literate",1)<100 )
     return notify_fail("剑诀上多为梵文，你读书识字不够，难以理解。\n");

   if( !living(target) )
     return notify_fail(target->name() + "已无还手之力，一剑砍下去即可，何必炫耀功夫。\n"); 

   if(target==me)     return notify_fail("想自杀？\n");

   if( !wizardp(me) && environment(me)->query("no_fight") )
     return notify_fail("你不能在这里偷袭别人。\n");
   msg = HIW
"$N潜运内力，御剑飞行！刹那间，数道剑光指向$n！\n" NOR;

   target->kill_ob(me);

   success = 1;
   ap = me->query_skill("sword");
   ap = ap * ap ; 
   ap += (int)me->query("combat_exp");
   ap = 2*ap; 
   
   dp = target->query_skill("dodge");
   dp = dp * dp ; 
   dp += target->query("combat_exp");
   if( random(ap + dp) < dp ) success = 0;
 
   if(success = 0)
   {
     if( target->is_busy() || target->query_temp("no_move") ) 
     {
        if( target->query("force")/40 > (10+me->query("force_factor")) )
        {     
          msg +=  HIW "结果$n虽然动弹不得，在运功反击之下倒也无碍。\n" NOR;
          message_vision(msg, me, target);   
          me->start_busy(3);

          me->add("force", -200);
          return 1;   
        }
        else success = 1; 
     }
   }

   if(success = 1 )
   {
     msg +=  HIW "$n顿时发出一声惨叫，身上连受数道剑伤！\n" NOR;
     message_vision(msg, me, target);
     target->receive_wound("kee", random(3*me->query("force_factor"))+50, me);
     COMBAT_D->report_status(target);
   }    
   else
    {
     msg +=  HIW "$n左躲右闪，好不容易才避开了这招。\n" NOR;
     message_vision(msg, me, target);     
   }
   
   me->start_busy(3);

   me->add("force", -200);
   return 1;   
}

