#include <armor.h>
#include <ansi.h>

inherit CLOTH;


void create() {
  set_name(WHT "雪白典雅婚纱" NOR, ({ "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "高贵典雅的婚纱，新娘之最爱。  \n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 3000);
    set("armor_prop/armor", 10);
    set("female_only", 1);
  }
  setup();
}
