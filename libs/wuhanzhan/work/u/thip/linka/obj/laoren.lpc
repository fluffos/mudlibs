inherit NPC;
#include <ansi.h>

int give_liwu();
void create() {
  set_name(RED "圣诞老人" HIW "[飞云版]" NOR, ({ "shengdan laoren", "laoren" }));
  set("long", "连他都不知道，那还混个p呀！");
  set("gender", "男性");
  set("age", 100);
  set("attitude", "peaceful");
  set("str", 40);
  set("per", 40);
  set("max_force", 1);
  set("force_factor", 1);
  set("force", 1);
  set("max_mana", 1);
  set("mana", 1);
  set("mana_factor", 1);
  set("combat_exp", 1);
  set_skill("literate", 10000);
  set("inquiry", ([
    "礼物": (: give_liwu :), ]));

  setup();
}

int give_liwu() {
  object me = this_object();
  object who = this_player();

  if ((who->query("thip_liwu_sd")) > 1) {
    command("shake");
    tell_object(who, "不可以太贪心哦！给别人留点儿吧！\n");
  } else {
    who->set("thip_liwu_sd", 2);
    command("grin");
    message_vision(HIB "$N对$n说道：“快拿袜子来啊，不然我怎么给你礼物？”\n" NOR, me, who);
    message_vision(HIB "$N对$n继续说：“唉，算了，我知道你没袜子，再说给我了，我还没带垃圾袋子呢！”\n" NOR, me, who);
    message_vision(HIB "$N对$n说道：“来，拿好了！！！”\n" NOR, me, who);
    message_vision(BLINK + HIY "$N给$n一个又大又闪亮的礼盒。\n" NOR, me, who);
    message_vision(HIW "$n把礼盒一打开，一道白光闪过，全凝聚到$n体内了！\n" NOR, me, who);

    who->add("max_force", 100);
    who->add("max_mana", 100);
    who->save();
    return 1;
  }
  return 1;
}
