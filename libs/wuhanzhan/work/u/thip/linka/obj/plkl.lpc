#include <weapon.h>
inherit HAMMER;
#include <ansi.h>

void create()
{
   set_name(RED"霹雳狂雷"NOR, ({"pili kuanglei","hammer"}));
   set_weight(150);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "对");
     set("long", "一对充满灵性的神锤，号称“锤中之王”。\n");
     set("value", 500000);
     set("material", "steel");
     set("wield_msg", HIW"$N拿起一对$n"HIW"，碰出点点火星。\n"NOR);
     set("unwield_msg", HIW"$N将$n"HIW"收回背后。\n"NOR);
   }
   init_hammer(200);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("sen",dam/5);
        me->improve_skill("hammer",random(20));
                switch(random(2)) {
                        case 0: return "$w"HIB"发出阵阵雷鸣！\n"NOR;
                        case 1: return "$w"HIB"一闪，又一闪……！\n"NOR;
                      }        
}
