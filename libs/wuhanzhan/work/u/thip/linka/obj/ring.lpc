#include <armor.h>
#include <ansi.h>

inherit FINGER;


void create() {
  set_name(WHT "钻石戒指" NOR, ({ "ring" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "举行婚礼时新郎要给新娘亲手戴上的戒指，
象征着永恒与纯真的爱。  \n");
    set("material", "stone");
    set("unit", "枚");
    set("value", 100);
    set("armor_prop/armor", 1);
    set("female_only", 1);
  }
  setup();
}
