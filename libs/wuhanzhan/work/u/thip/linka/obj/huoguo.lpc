inherit ITEM;
inherit F_FOOD;
#include <ansi.h> 



void create()
{
      seteuid(getuid());

  switch (random(14))
  {
    case 0:
      { set_name(HIR "三鲜火锅" NOR, ({ "huo guo"})); break; }
    case 1:
      { set_name(HIR "红烧牛肉火锅" NOR, ({ "huo guo"})); break; }
    case 2:
      { set_name(HIR "四川麻辣烫" NOR, ({ "huo guo"})); break; }
    case 3:
      { set_name(HIR "清汤丸子火锅" NOR, ({ "huo guo"})); break; }
    case 4:
      { set_name(HIR "铁板鸭火锅" NOR, ({ "huo guo"})); break; }
    case 5:
      { set_name(HIR "红烧肥肠火锅" NOR, ({ "huo guo"})); break; }
    case 6:
      { set_name(HIR "红烧鸡火锅" NOR, ({ "huo guo"})); break; }
    case 7:
      { set_name(HIR "红烧排骨火锅" NOR, ({ "huo guo"})); break; }
    case 8:
      { set_name(HIR "麻辣牛肉火锅" NOR, ({ "huo guo"})); break; }
    case 9:
      { set_name(HIR "牛肉丸子火锅" NOR, ({ "huo guo"})); break; }
    case 10:
      { set_name(HIR "红烧蹄筋火锅" NOR, ({ "huo guo"})); break; }
    case 11:
      { set_name(HIR "花江狗肉火锅" NOR, ({ "huo guo"})); break; }
    case 12:
      { set_name(HIR "驴肉火锅" NOR, ({ "huo guo"})); break; }
    case 13:
      { set_name(HIR "鸳鸯火锅" NOR, ({ "huo guo"})); break; }
  }
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一锅令人垂涎的"+query("name")+"。\n");

    set("unit", "锅");
    set("value", 250);
    set("food_remaining", 5);
    set("food_supply", 25);
  }
}


