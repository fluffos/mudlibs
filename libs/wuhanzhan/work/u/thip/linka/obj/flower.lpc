#include <armor.h>
#include <ansi.h>

inherit HEAD;


void create() {
  set_name(WHT "白绸花" NOR, ({ "flower" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "婚礼时新娘戴在头上装饰用花。  \n");
    set("material", "cloth");
    set("unit", "朵");
    set("value", 100);
    set("armor_prop/armor", 1);
    set("female_only", 1);
  }
  setup();
}
