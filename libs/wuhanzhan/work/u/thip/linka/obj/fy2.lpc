#include <weapon.h>
inherit SWORD;
#include <ansi.h>

void create() {
  set_name(HIG "飞云剑" HIR "·" HIW "改" NOR, ({ "feiyunsword", "jian", "sword" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄墨绿色的长剑，剑身有一条游龙。\n");
    set("value", 50000);
    set("material", "steel");
    set("wield_msg", HIG "$N念个“出”字诀，一道绿光闪过，手中多了把$n" HIG "。\n" NOR);
    set("unwield_msg", HIG "$N念个“收”字诀，绿光过后，$n" HIG "自动回鞘。\n" NOR);
  }
  init_sword(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  string msg;
  object weapon = victim->query_temp("weapon");
  if (weapon) {
    if (random(10) > 2) {
      victim->start_busy(1);
      msg = HIW "只听“啪”的一声响，$n手中$w" HIW "已被" HIG "飞云剑" HIW "断为两截！\n" NOR;
      msg = replace_string(msg, "$w", weapon->name());

      weapon->unequip();
      weapon->move(environment(victim));
      weapon->set("name", "断掉的" + weapon->query("name"));
      weapon->set("value", 0);
      weapon->delete("long");
      weapon->set("weapon_prop", 0);
    } else {
      msg = HIY "$n手中的$w" HIY "在与" HIG "飞云剑" HIR "·" HIW "改" HIY "猛烈碰撞的冲击下不住颤抖，险些脱手！\n" NOR;
      msg = replace_string(msg, "$w", weapon->name());
    }
  }
  dam = (int)me->query("force");
  victim->receive_damage("sen", dam / 5);
  switch (random(7)) {
    case 0: msg += "紧跟着一道" RED "红" NOR "色剑气从$w迸射出来！\n"; break;
    case 1: msg += "紧跟着一道" MAG "橙" NOR "色剑气从$w迸射出来！\n"; break;
    case 2: msg += "紧跟着一道" YEL "黄" NOR "色剑气从$w迸射出来！\n"; break;
    case 3: msg += "紧跟着一道" HIG "绿" NOR "色剑气从$w迸射出来！\n"; break;
    case 4: msg += "紧跟着一道" HIW "青" NOR "色剑气从$w迸射出来！\n"; break;
    case 5: msg += "紧跟着一道" BLU "蓝" NOR "色剑气从$w迸射出来！\n"; break;
    case 6: msg += "紧跟着一道" MAG "紫" NOR "色剑气从$w迸射出来！\n"; break;
    default: break;
  }

  return msg;
}
