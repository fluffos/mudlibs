inherit NPC;

void create() {
  set_name("卖花人", ({ "seller" }));
  set("long", "一个卖花的人。
被一阵罡风卷到了梅山，怎着急找路回去呢。\n");
  set("gender", "男性");
  set("combat_exp", 1500);
  set("age", 28);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("vendor_goods", ([
    "rose999": "/d/obj/flower/rose999",
    "rose": "/d/obj/flower/rose",
    "guihua": "/d/obj/flower/guihua",
    "juhua": "/d/obj/flower/juhua",
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
  add_money("coin", 40 + random(30));
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say(name() + "焦急的说：好心人，带我出去吧！\n");
      break;
  }
}
