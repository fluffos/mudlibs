inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(HIW"〖舞剑图〗"NOR, ({"tu"}));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
     set("value", 1000000);
        set("material", "paper");
        set("skill", ([
                        "name": "snowsword",
                        "sen_cost": 20,
                        "difficulty": 20,
                        "max_skill": 60,
]) );
        }
}

