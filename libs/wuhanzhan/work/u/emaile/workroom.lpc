inherit ROOM;
#include <ansi.h>
int block_cmd();

void create() {
  set("short", HIC "碧云天" NOR);
  set("long",
    BLINK HIY "\n           花间一壶酒,独酌无相亲。\n" NOR
    BLINK HIY "\n           举杯邀明月,对饮成三人。\n" NOR

    @LONG

这是EMAILE的工作室,只见陈设十分古朴.
失恋的人,都是哲学家,恋爱的人都是思想家.
爱即有忧,爱即有怖,离爱去者,无忧无怖.
LONG);

  set("item_desc", ([ /* sizeof() == 1 */
    "jail": "房子里云雾缭绕，什么也看不清楚。\n",
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "jail": "/d/wiz/punish",
    "kz": "/d/city/kezhan",
  ]));


  set("no_fight", 1);
  set("valid_startroom", 1);
  set("no_time", 1);
  set("no_clean_up", 0);
  set("no_magic", 1);
  set("outdoors", 1);
  set("post_limit", 1);
  setup();
  replace_program(ROOM);

}
void init() {
  if (!wizardp(this_player())) {
    add_action("block_cmd", "", 1);
  }
  call_out("hehe", 2, this_player());
}
int block_cmd() {
  string verb = query_verb();
  if (verb == "say") return 0;  //allow say
  if (verb == "look") return 0;
  if (verb == "chat") return 0;
  if (verb == "get") return 0;
  return 1;
}
