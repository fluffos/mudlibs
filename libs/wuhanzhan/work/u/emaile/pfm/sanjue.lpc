#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, msg1, msg2, msg3, msg4, string1;
  int count;

  if (!me->is_fighting())
    return notify_fail("「降魔三绝枪」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对。\n");


  if ((int)me->query_skill("boro-gong", 1) < 350)
    return notify_fail("你的般若功的修为不够, 不能使用这一绝技 !\n");

  if ((int)me->query_skill("spear") < 350)
    return notify_fail("你的基本枪法法修为不够， 目前不能使用降魔三绝枪! \n");

  if ((int)me->query("max_force") < 3000)
    return notify_fail("你的内功修为不够！\n");

  msg = "$N使出〖降魔枪〗的绝技「降魔三绝枪」，身法陡然加快！\n\n" NOR;
  msg1 = "你暗暗一笑,手中$w连出三招,顿时枪光四射,照的四周一片亮堂!\n\n";
  message_vision(msg, me);
  message_vision(msg1, me);

  me->clean_up_enemy();
  ob = me->select_opponent();

  msg2 = "    第  一  枪    \n";
  msg3 = "    第  二  枪    \n";
  msg4 = "    第  三  枪    \n";


  message_vision(msg2, me);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);


  message_vision(msg3, me);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);


  message_vision(msg4, me);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  me->add("foce", -300);
  me->start_busy(2 + random(3));

  if (!ob->is_fighting(me)) ob->fight_ob(me);
  if (userp(ob)) ob->fight_ob(me);
  else if (!ob->is_killing(me)) ob->kill_ob(me);
  return 1;
}
