// void_sense.c

#include <ansi.h>
inherit SSERVER;
int cast(object me, object target) {
  int lvl, i;
  object env, *inv;
  lvl = (int)me->query_skill("spells");
  lvl += (int)me->query("max_mana");
  if (lvl <= 200)
    return notify_fail("你法术不够高！\n");
  if (me->query("mana") < 3000)
    return notify_fail("你的法力不够！\n");
  if (me->query("sen") <= 1500)
    return notify_fail("你的精神太差了！\n");
  me->add("mana", -300);
  me->receive_damage("sen", 150);
  message_vision(HIW "$N凝神提气，一团白芒乍出体内，整个人渐渐虚化．．．\n" NOR, me);
  me->set("env/invisibility", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), lvl / 10);
  if (me->is_fighting()) me->start_busy(3);
  return 1;

}
void remove_effect(object me) {
  me->set("env/invisibility", 0);
  tell_object(me, "你的隐识失效了。\n");
}
