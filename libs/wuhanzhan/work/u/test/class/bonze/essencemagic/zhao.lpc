// zhao.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  success_adj = 100;
  damage_adj = 100;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("金刚罩可不是你随便叫着玩的？\n");

  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够，无法驱动那么重的金刚罩。\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你现在神智不清，别把自己砸着了！\n");

  if ((int)me->query_skill("bashishentong", 1) < 51)
    return notify_fail("你的八识神通修为尚不够精深！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    write("看来金刚罩被偷走了！\n");
    return 1;
  }


  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    success_adj,
    //success adjustment
    damage_adj,
    //damage adjustment
    "qi",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIY "$N念动真言，突然半空中飞下一个巨大无比的金钢罩，嗖地一声向$n盖去！\n" NOR,
    //initial message
    HIR "结果$n躲闪不及，被金刚罩砸了个正着！\n顿时$n被砸的血肉横飞，惨不忍睹！\n" NOR,
    //success message
    HIY "结果轰地一声！金刚罩砸在了$n的旁边，$n被吓了一大跳。\n" NOR,
    //fail message
    HIY "结果金钢罩被$n以法力一逼，反向$N回砸而去！\n" NOR,
    //backfire initial message
    HIR "结果金刚罩把$n砸了个半死！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  me->start_busy(2 + random(2));
  return 3 + random(5);
}
