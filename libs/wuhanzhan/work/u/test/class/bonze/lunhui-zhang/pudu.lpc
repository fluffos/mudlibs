#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
    object weapon;
    int i;
    int ap, dp, kee_wound, skill_wound; 
    if( !target ) target = offensive_target(me);


    if( !target
    ||  !target->is_character()
    ||   target->is_corpse()
    ||   target==me)
         return notify_fail("你想对谁施展这一招「菩度众生」？\n");

    if(!me->is_fighting())
         return notify_fail("「菩度众生」只能在战斗中使用！\n");

    if((int)me->query("max_force") < 1000 )
         return notify_fail("你的内力不够！\n");

    if((int)me->query("force") < 1500 )
         return notify_fail("你的内力不足！\n");

    if( (int)me->query_skill("buddhism", 1) < 100)
         return notify_fail("你的佛法修行还不够精深，用不了这招。\n");

    i=(int)me->query_skill("staff",1) + me->query_skill("lunhui-zhang",1) / 2;

    if( i < 100)
         return notify_fail("你的轮回杖的有效等级不够，无法领会这招！\n");
    message_vision(HIC "\n$N见$n一意孤行，运足力气喝道：「菩度众生」！\n\n" NOR,me,target,);

    ap = me->query_skill("staff");
    ap += me->query_skill("buddhism");
    ap += me->query("combat_exp") * 2;
    dp = target->query_skill("parry");
    dp += target->query("combat_exp") * 2;
    if( dp < 1 )
        dp = 1;
    if( ap+random(ap) > dp )
        {
         me->add("force",-500);

         me->delete("env/brief_message");
         target->delete("env/brief_message");
      
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
       
         skill_wound = me->query_skill("staff");            
         kee_wound = random(skill_wound) + me->query("kee");
         if(kee_wound > target->query("kee")/12)
         kee_wound = target->query("kee")/ 12;
         kee_wound += kee_wound * 2;
         target->add("kee", -kee_wound);
         target->kill_ob(me);
    message_vision(RED "$n只觉得胸前一阵剧痛，“哇”的一声喷出一口鲜血！\n" NOR,me,target,);
         me->start_busy(random(4));
        }
    else
        {
    message_vision(HIC "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n" NOR,me,target,);
         me->add("force",-500);
         me->start_busy(4);
     }
         return 1;
}
