#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        int damage,ap,dp,damage1,damage2;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这招「天罡伏魔」？\n");

        if(!me->is_fighting())
                return notify_fail("「天罡伏魔」只能在战斗中使用！\n");

        if((int)me->query("force") < 800 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("kee") < 200 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

        if((int)me->query_skill("lunhui-zhang", 1) < 200)
                return notify_fail("你的轮回杖修为尚浅！\n");

        if((int)me->query_skill("buddhism", 1) < 220)
                return notify_fail("你的佛法修行还不够精深，没有伏魔的力量！\n");

       weapon=me->query_temp("weapon");
            me->add("force", -25-(int)me->query("force_factor"));
        me->receive_damage("kee", 10);
        msg = HIY"\n$N口诵佛号，念动伏魔真言，手中的"+weapon->query("name")+HIY+"往临空一举，顿时半空之中荡起一道紫微微的光华。\n"
"紫金之光竟然交相缠绕宛，若两条神龙盘旋飞舞而出，雷霆万钧的击向了$n．\n"+NOR;

        ap = me->query_skill("lunhui-zhang", 1);
        ap = ( ap * ap * ap / (8 * 800) );
        ap = ap*500 + (int)me->query("combat_exp");
        dp = target->query_skill("parry");
        dp = ( dp * dp * dp / (4 * 400) );
        dp = dp*250 + target->query("combat_exp"); 
        if( random((ap + dp)/1000+1) <  dp/1000 ) {
                msg += HIR "$n脸色一变，全身聚起一团黑气逼开了$N的紫龙！\n\n"NOR;
                message_vision(msg, me, target);
        } else {
                damage = (int)me->query_skill("lunhui-zhang",1) / 10 +
                        (int)me->query("sen") / 200 + random((int)me->query("sen") / 100 ) +
                        (int)me->query("kee") / 200 + random((int)me->query("kee") / 100 );
                msg += HIY "双龙猛然合为一体，顿时祥云漠漠金光闪闪，$n躲闪不及被金光缠住，发出一声惨叫！\n" NOR;
                damage +=random(10);
                          damage1=me->query("eff_sen")*damage/40;
                          damage2=me->query("eff_kee")*damage/30;
                            if(damage1<=0) damage=150;
                            if(damage2<=0) damage=150;
                                         if(target->query("sen")<damage1) target->set("sen",0);
                                         else target->set("sen",target->query("sen")-damage1);
                                         if(target->query("kee")<damage2) target->set("kee",0);
                                         else target->set("kee",target->query("kee")-damage2);
                   me->improve_skill("lunhui-zhang", 1+random(3), 1);
                message_vision(msg, me, target);
                COMBAT_D->report_status(target);
         }
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }


        me->start_busy(1+random(2));
        return 1;
}
