// shizi.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string dodskill, msg;
  int extra;
  int tmp;
  object weapon;
  extra = me->query_skill("shenji-blade", 1);
  if (extra < 300) return notify_fail("你的神机刀法还不够纯熟！\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "xiaoyaoyou")
    return notify_fail("计出连环需要逍遥游的配和！\n");
  tmp = me->query_skill("xiaoyaoyou", 1);
  if (tmp < 300) return notify_fail("你的逍遥游还不够纯熟！\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「计出连环」只能对战斗中的对手使用。\n");
  me->add_temp("apply/attack", tmp);
  me->add_temp("apply/damage", extra * 2);
  weapon = me->query_temp("weapon");
  msg = YEL "$N使出神机刀法中的灭天绝地式   --计出连环--   ！！
                    第一式---$N手中$w犹如泰山般直压向$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "第二式---$N手中$w犹如长龙贯日刺向$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "第三式---$N手中$w犹如清风啸月平削$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = MAG "第四式---$N手中$w犹如火中飞蛾横砍$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIB "第五式---$N手中$w旋风四起疯狂砍向$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIC "第六式---$N手中$w犹如扑风追影反撩$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIM "第七式---$N手中$w夹着翩翩刀光狠剁$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = MAG "第八式---$N手中$w人刀和一斩砍$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add_temp("apply/attack", -tmp);
  me->add_temp("apply/damage", -extra * 2);
  return 1;
}
