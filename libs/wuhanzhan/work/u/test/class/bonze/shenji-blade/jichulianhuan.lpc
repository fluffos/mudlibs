
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string dodskill,msg;
        int extra;
        int tmp;
        object weapon;
        extra = me->query_skill("shenji-blade",1);
        if ( extra < 380) return notify_fail("你的神机刀法还不够纯熟！\n");
        dodskill = (string) me->query_skill_mapped("dodge");
        if ( dodskill != "lotusmove")
                        return notify_fail("计出连环需要莲花步法的配和！\n");
        tmp = me->query_skill("lotusmove",1);
        if ( tmp < 300 )return notify_fail("你的莲花步还不够纯熟！\n");

        if( !target ) target = offensive_target(me);
        if( !target


        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「计出连环」只能对战斗中的对手使用。\n");
        me->add_temp("apply/attack",tmp);
        me->add_temp("apply/damage",extra*2);
        weapon = me->query_temp("weapon");
        message_vision(HIR"\n$N挥出神机刀法中的绝天灭地的一式－－－计－出－连－环－！！\n\n\n\n"NOR,me,target);
        message_vision(HIR"论战篇！\n$N$N手中$w犹如泰山般压向$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIY"胜战篇！\n$N$N手中$w犹如泰山般直压向$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIG"敌战篇！\n$N$N手中$w犹如清风啸月平削$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(MAG"攻战篇！\n$N手中$w犹如火中飞蛾横砍$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIB"混战篇！\n$N手中$w犹如旋风四起疯狂砍向$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIC"并战篇！\n$N手中$w犹如扑风追影反撩$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIM"败战篇！\n$N手中$w夹着翩翩刀光狠剁$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(MAG"决战篇！\n$N抓紧手中$w人刀和一斩砍$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add_temp("apply/attack",-tmp);
        me->add_temp("apply/damage",-extra*2);
        me->start_busy(3);
        return 1;
}
