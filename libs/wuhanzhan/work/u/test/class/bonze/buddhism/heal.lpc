//恢复自身的精神...


#include <ansi.h>
int cast(object me, object target)
{
   if( me->is_fighting() )
     return notify_fail("战斗中运功疗神？找死吗？\n");

   if( (int)me->query("mana") < 50 )
     return notify_fail("你的法力不够。\n");

   if( (int)me->query("eff_sen") < (int)me->query("max_sen") / 2 )
     return notify_fail("你精神已处在极度混乱，神游虚外恐怕是不可能了！\n");

        if((int)me->query_skill("buddhism", 1) < 70)
     return notify_fail("你的佛法修行不够，无法神游虚外！\n");

   write( HIC "你全身放松，坐下开始神游虚外。\n" NOR);
   message("vision",
     HIC + me->name() + "全身放松，坐下开始神游虚外，精神看起来好多了。\n" NOR,
     environment(me), me);

   me->receive_curing("sen", 10 + (int)me->query_skill("spells")/5 );
   me->add("mana", -50);
   me->set("mana_factor", 0);

   return 1;
}
