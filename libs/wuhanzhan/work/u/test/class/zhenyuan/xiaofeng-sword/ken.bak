// fengyue.c
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string dodskill,msg;
        int extra;
        int tmp;
        object weapon;
        extra = me->query_skill("xiaofeng-sword",1);
        if ( extra < 50) return notify_fail("你的晓风残月剑还不够纯熟！\n");

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「风月」只能对战斗中的对手使用。\n");
        me->add_temp("apply/attack",tmp);
        me->add_temp("apply/damage",extra*2);
        weapon = me->query_temp("weapon");
        msg = HIG  "\n\n$N腾空越起，变换身行，手中的$w划出条条剑气，一招美妙绝伦的 **四*季*飞*花** 一气呵成 
  ！！\n\n\n掉转思绪听春雨！\n$N手中$w宛如丝丝细雨直刺$n！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIR  "携友同行赏夏花！\n$N手中$w带着丝丝剑气斜刺$n！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "一筹莫展看秋叶！\n$N手中$w落花般横刺$n！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIW  "瑞雪普降好个冬！\n$N手中$w猛刺$n！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIG  "风月无边！\n$N手中$w猛刺$n！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->start_busy(3);
        me->add_temp("apply/attack",-tmp);
        me->add_temp("apply/damage",-extra*2);
        return 1;
}
