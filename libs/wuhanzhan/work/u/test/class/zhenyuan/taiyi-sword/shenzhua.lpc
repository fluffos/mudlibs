#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage, ap, dp;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「太乙神抓」？\n");

  if ((string)me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("太乙神抓必需配合镇元神功才能使用。\n");

  if (me->query("max_force") < 1000 || me->query("force") < 1000)
    return notify_fail("内力不足，根本无法发挥太阳神抓的威力。\n");

  if ((int)me->query("kee") < 100)
    return notify_fail("你身体太虚弱了，无法施展「太阳神抓」！\n");

  if ((string)me->query_skill_mapped("sword") != "taiyi-sword")
    return notify_fail("太阳神抓没有太乙剑法的配合是用不出来的。\n");

  if ((int)me->query_skill("taiyi-sword", 1) < 200)
    return notify_fail("你的太乙剑法练得不够纯熟，无法使出这招「太阳神抓」！\n");

  if ((int)me->query_skill("zhenyuan-force", 1) < 200)
    return notify_fail("你的镇元神功领悟尚浅，不能使出「太乙神抓」！\n");

  if ((int)me->query_skill("taiyi", 1) < 200)
    return notify_fail("你的太乙仙法还不够高深！\n");


  me->add("force", -50 - (int)me->query("force_factor"));

  msg = HIC
    "\n$N暗运神功，忽然转过身来，剑交左手，右手缓缓举起！！！\n"
    "只见$N掌心" + HIR "通红" + HIC "，隐射耀目之" + HIW "光华" + HIC "，令人目眩，掌势虽慢，\n"
    "但已然带起一股轰轰之声，燿热的掌风，向$n当胸印下！\n" NOR;

  ap = me->query_skill("sword");
  ap = ap / 10 * ap * ap;
  ap = ap + (int)me->query("combat_exp");
  dp = target->query_skill("parry");
  dp = dp / 10 * dp * dp;
  dp = dp + target->query("combat_exp");
  if (random(ap + dp) > dp) {
    msg += HIC "$n一见是太乙神抓，连忙真气一提，足尖一点，躲开了这一招！\n\n" NOR;
    message_vision(msg, me, target);
  } else {
    damage = ((int)me->query_skill("taiyi-sword", 1) + (int)me->query_skill("taiyi", 1));
    damage += 3 * ((int)me->query("force_factor") - random((int)target->query("force_factor")));
    msg += HIR "$n早已心惊胆寒，只觉得全身一阵巨震，胸骨已被$N击了个全碎！\n" NOR;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->improve_skill("taiyi-sword", 1, 1);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->start_busy(2);
  return 1;
}
