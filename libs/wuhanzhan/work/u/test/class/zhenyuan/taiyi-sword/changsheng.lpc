// 长生剑
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
   object weapon;
   int i, extra;
 if( !target ) target = offensive_target(me);

  if( !target
   ||      !target->is_character()
   ||      target->is_corpse()
   ||      target==me)
           return notify_fail("你要对谁施展这一招「长生不死剑」？\n");
  if(!me->is_fighting())
           return notify_fail("「长生不死剑」只能在战斗中使用！\n");

 if((int)me->query("max_force") < 2000 )
   return notify_fail("你的内力不够！\n");

 if((int)me->query("force") < 2000 )
      return notify_fail("你的真气不足！\n");

  if((int)me->query("sen") < 2000 )
         return notify_fail("你的精神不足，没法子施用外功！\n");

  extra = (int)me->query_skill("sword",1);
  if( extra < 200)
     return notify_fail("你对太乙剑法领悟的不够，无法使出[长生不死剑]。\n");
   
   me->add("force", -200);
   me->add_temp("apply/attack",extra/2);
   me->add_temp("apply/damage",extra/2);
   message_vision(HIC"激战中$N眼见相持不下，长笑一声，使出了太乙剑法的最终杀招--长--生--不--死---剑！\n"NOR,me);;
   me->delete("env/brief_message");
   target->delete("env/brief_message");

   me->set_temp("TYJ_perform", 6);
   COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
   me->add_temp("apply/attack",-extra/2);
   me->add_temp("apply/damage",-extra/2);
   me->delete_temp("TYJ_perform");
   me->start_busy(1);
   return 1;

    if( !target->is_fighting(me) ) {
     if( living(target) ) {
                if( userp(target) ) target->fight_ob(me);
          else target->kill_ob(me);
	    }
      }  
    return 1;
}
