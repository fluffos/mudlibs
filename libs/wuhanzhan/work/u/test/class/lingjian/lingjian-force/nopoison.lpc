#include <ansi.h>

int exert(object me, object target)
{
     if (target==me)
        {
        if( me->is_fighting())
                return notify_fail("战斗中无法运功解毒！\n");
        
        if( (int)me->query("force") < 500 )
                return notify_fail("你的内力不够。\n");

        if((int)me->query_skill("lingjian-force", 1) <100)
                return notify_fail("你的灵剑心法级别还不够！\n");

        if( (int)me->query("eff_kee") < (int)me->query("max_kee") / 2 )
                return
        notify_fail("你已经受伤过重，只怕一运内力便有生命危险！\n");
        write( CYN "你盘腿坐下，运起灵剑心法开始运功解毒。\n" NOR);
        message("vision",
                CYN + me->name() +
     "盘腿坐下，运起灵剑心法逼出体内的毒素。不久，吐出几口黑血，脸色好多了。\n"
        NOR,
                environment(me), me);
        
        me->add("force", -300);
        me->add("max_force", -10); 
        me->clear_condition();
        return 1;
        }
      
      else{
       if( !target )
                return notify_fail("你要为谁解毒？\n");

        if( me->is_fighting() || target->is_fighting())
                return notify_fail("战斗中无法运功解毒！\n");

        if( (int)me->query("force") < 500 )
                return notify_fail("你的内力不够。\n");

       if((int)me->query_skill("lingjian-force", 1) <100)
                return notify_fail("你的灵剑心法级别还不够！\n");

       if( (int)me->query("eff_kee") < (int)me->query("max_kee") / 2 )
       return notify_fail("你已经受伤过重，只怕一运内力便有生命危险！\n");

        if( (int)target->query("eff_kee") < (int)target->query("max_kee") / 5 )
        return notify_fail( target->name() + "已经受伤过重，经受不起你的内力冲击！\n");

        message_vision(
                CYN "$N盘腿坐下，运起灵剑心法，将手掌贴在$n背心，缓缓地将内力输入$n体内....\n\n"
                "过了不久，$N额头上冒出豆大的汗珠。$n吐出一口黑血，脸色看起来红润多了。\n" NOR,
                me, target );

        target->clear_condition();
       me->add("force", -300);
       me->add("max_force", -20); 
       return 1;
       }

     return 1;
}
