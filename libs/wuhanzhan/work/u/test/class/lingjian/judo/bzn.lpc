#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「禁千二百十一式·八稚女」？\n");

  me->add("force", -50 - (int)me->query("force_factor"));
  me->receive_damage("kee", 100);

  msg = HIR
    "\n$N仰天一阵狂啸，飞速向前方的$n奔去，\n"
    "$N在$n胸前一阵乱抓，只见血光飞溅，漫天血红，\n"
    "紧跟着，$N卡住$n的脖子，用自己的头使劲地撞$n的头，蓝色火焰纷纷射出，\n"
    "随即，$N又将$n一把按在地上，双手带着阵阵蓝火猛烈地插向$n的腹部。\n"
    "结果…………\n" NOR;

  damage = (int)me->query("max_force") / 10 + random((int)me->query("eff_kee") / 50);
  damage -= (int)target->query("max_force") / 10 + random((int)target->query("eff_kee") / 5);
  damage += (int)me->query("force_factor") - random((int)target->query("force_factor"));

  msg += HIC "结果$n狂喷出数声鲜血！
$N得意的说：“这就是「禁千二百十一式·八稚女」！
使用方法：↓→↓←　＋　ＡｏｒＣ！！！\n" NOR;
  damage += random((damage * (int)me->query_skill("unarmed")) / 80);
  target->receive_damage("sen", damage, me);
  target->receive_wound("sen", damage / 4, me);
  target->receive_damage("kee", damage, me);
  target->receive_wound("kee", damage / 3, me);
  me->improve_skill("judo", 1, 1);

  message_vision(msg, me, target);
  COMBAT_D->report_status(target);


  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  return 1;
}
