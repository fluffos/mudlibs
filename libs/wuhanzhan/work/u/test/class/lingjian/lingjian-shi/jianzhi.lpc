// lol 06/10/2001 部分参考了yesi@dtxy的剑掌。
// 我觉得同样的一招特技，不同的人来用，威力应该也有所不同才是。
// 所以仓促加上了skills等级对威力的影响以及特技使用次数的设定。

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
      object weapon=me->query_temp("weapon");
      int enhance,damage,number1,number2;
      string str;

      if (!weapon) return 0;
      if( !target ) target = offensive_target(me);
      if( !target || !target->is_character()||target->is_corpse()||target==me)
          return notify_fail("你要攻击谁？\n");
      if (!me->is_fighting())
             return notify_fail("剑指只能在战斗中使用！\n");
      
      if( time()-(int)me->query_temp("jianzhi_end") < 3 )
                return notify_fail("绝招用多就不灵了！\n");
     
      if (me->query_temp("jianmang"))
           return notify_fail("你正在施用剑芒，没有余力出剑指！\n");
           
      if( time()-(int)me->query_temp("jianmang_end") < 5 )
                   return notify_fail("你现在真气不纯。\n");      
      if(me->query("family/family_name") != "灵剑门")
                   return notify_fail("[剑指]是灵剑门不传之密！\n");
                
      if (me->query_skill("lingjian-shi",1)<68)
          return notify_fail("你的灵剑七式太差，还不会出剑指。\n");
      if (me->query_skill("lingjianzhi",1)<58
         || me->query_skill_mapped("unarmed")!="lingjianzhi") 
            return notify_fail("你的灵剑指太差，还不会出剑指。\n");
      if (me->query_skill("lingjian-force",1)<58 
         || me->query_skill_mapped("force")!="lingjian-force" )
            return notify_fail("你的灵剑心法修为不够，还不会出剑指。\n");
      if (me->query("force")<188)
           return notify_fail("你内力不继，难以出招。\n");
     
    me->add("force", -100);
    seteuid(getuid());

    enhance=me->query_skill("lingjianzhi",1);
    if (enhance < 100) {
        number1 = 2;
        enhance = enhance;
    } else if (enhance < 150) {
        number1 = 3;        
        enhance = enhance/9*10;
    } else if (enhance < 220) {
        number1 = 4;        
        enhance = enhance/8*9;
    } else if (enhance < 300) {
        number1 = 5;        
        enhance = enhance/7*9;
    } else if (enhance < 400) {
        number1 = 6;        
        enhance = enhance/5*8;
    } else {
        number1 = 7;
        enhance = enhance/3*5;
    }
    if (enhance > 700) enhance = 700;   //太高就会计算溢出了。
 
    damage=me->query_skill("lingjian-force",1);
    if (damage < 100) {
        number2 = 2;
        damage = damage;
    } else if (damage < 150) {
        number2 = 3;        
        enhance = damage/9*10;
    } else if (damage < 220) {
        number2 = 4;        
        damage = damage/8*9;
    } else if (damage < 300) {
        number2 = 5;        
        damage = damage/7*9;
    } else if (damage < 400) {
        number2 = 6;        
        damage = damage/5*8;
    } else {
        number2 = 7;
        damage = damage/3*5;
    }
    damage=damage/2;

    if (number1!=7|| number2 != 7) {
 message_vision(HIW"\n$N深深吸了一口气，运气如珠，转瞬间刺出"+chinese_number(number2)+"剑，同时身形闪动，左手连弹，[嗤嗤]声中"+chinese_number(number1)+"缕指力袭往$n胸口！！\n"NOR,me,target);
    } else if (random(11)>9&&me->query("jianzhi_shiyong")>999) {
    message_vision(HIY"\n$N脸上青气大盛，右手将长剑斜举向天，左手捏印，四周空间以$N为中心塌陷，分明是第七重[剑指]出手的征兆！！\n $n心头剧震，待想招架却已四肢无力！！只听[劈啪]连响，一股无可匹敌的劲气向$n当胸袭致！！！"NOR,me,target);
    target->start_busy(1);
    } else {
    message_vision(HIG"\n$N浑身真气流动，左手挥出七道螺旋指力将$n所有退路封死，手中长剑青芒暴涨，$n只觉这天地间已没有一丝生机！！"NOR,me,target);
    }
    me->add_temp("apply/attack", enhance); 
    me->add_temp("apply/damage",damage);        
    COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
    me->add_temp("apply/attack",-enhance);
    me->add_temp("apply/damage",-damage);
    if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))  
  {str=target->name()+"被"+me->name()+"用灵剑门绝招「剑指」杀死了，在满身剑痕中还浮现几个泛青的指痕！";
                         message("channel:rumor",HIM"【谣言】某人："+str+"\n"NOR,users());
                       }
    me->add("jianzhi_shiyong",1);       
    me->set_temp("jianzhi_end",time());
    return 1;
}
