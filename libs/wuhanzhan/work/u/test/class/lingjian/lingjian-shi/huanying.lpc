#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        int i,j,n;
                 
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「幻影七十二式」？\n");

        if(!me->is_fighting())
                return notify_fail("「幻影七十二式」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 5000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 5000 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 2500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("lingjian-shi", 1) < 150)
                return notify_fail("你的灵剑七式级别还不够，使用这一招会有困难！\n");

        if((int)me->query_skill("lingjian-shi", 1) < 300 && !me->query_temp("powerup"))
                return notify_fail("你的灵剑七式级别还不够，若无剑神向助使用这一招会有困难！\n");

        if((int)me->query_skill("lingjian-shi", 1) < 500 && !me->query_temp("lianhuanbu"))
                return notify_fail("你的灵剑七式级别还不够，若不提升步法使用这一招会有困难！\n");

        me->delete("env/brief_message");
        target->delete("env/brief_message");
        j=(int)me->query_skill("lingjian-shi",1)/50;
        i=random(j)+1;
        
message_vision(HIW"\n$N身形一晃，分出些须幻影，"+chinese_number(i)+HIW"道剑影扫向$n！\n"NOR,me,target);

        
        for(n=1;n<=i;n++)
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->receive_damage("sen", 100);
        me->add("force", -100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        me->start_busy(i);
        return 1;
}
