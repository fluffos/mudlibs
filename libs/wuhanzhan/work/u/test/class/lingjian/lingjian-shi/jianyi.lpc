#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int damage, ap, dp;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一式 "HIC"「剑意」"NOR"？\n");

        if((int)me->query("force") < 250+(int)me->query("force_factor") )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("kee") < 500 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

        if((int)me->query_skill("lingjian-shi", 1) <150)
                return notify_fail("你的剑法级别还不够！\n");


        me->add("force", -50-(int)me->query("force_factor"));
        me->receive_damage("kee", 100);


   msg = HIC
"\n$N双手抚剑，潜运内力，将真气注入剑身，\n"
"忽然间，一道"HIR"红光"HIC"闪过，数道剑气从$N的剑中迸发出来，\n"
"$n只觉得心中一阵压抑，根本不知如何招架，更不用说躲闪了！\n" NOR;
        ap = me->query_skill("lingjian-shi") + me->query_skill("sword");
        ap = ( ap * ap * ap / (4 * 400) ) + (int)me->query("kee");
        ap = ap*250 + (int)me->query("combat_exp");
        dp = target->query_skill("parry");
        dp = ( dp * dp * dp / (4 * 400) ) + (int)target->query("kee");
        dp = dp*250 + (int)target->query("combat_exp"); 
        if( random(ap + dp) > dp ) {
                damage = (int)me->query("max_force") / 15 +
        random((int)me->query("eff_kee") / 10);
                damage -= (int)target->query("max_force") / 15 +
        random((int)target->query("eff_kee") / 10);
        
        damage+=(int)me->query("force_factor")-random((int)target->query("force_factor"));
                
     if( damage > 0 ) {
     msg += HIC "结果剑气穿过$n身体而出，$n一个踉跄，差点儿跌倒！\n" NOR;
     damage +=random((damage*(int)me->query_skill("sword"))/200);
                        target->receive_damage("kee", damage, me);
                        target->receive_wound("kee", damage/3, me);
                        me->improve_skill("lingjian-shi", 1, 1);
                     }
        else {
               msg += HIR "$n哈哈一笑，身周真气弥漫，将剑气化于无形！\n" NOR;
    	       
               me->improve_skill("lingjian-shi", 1, 1);
        }
             } 
     else 
                msg += "$n左躲右闪，好不容易才避开了剑气。\n";
                message_vision(msg, me, target);
                if( damage > 0 ) COMBAT_D->report_status(target);
       
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        me->start_busy(3);
        return 1;
}

