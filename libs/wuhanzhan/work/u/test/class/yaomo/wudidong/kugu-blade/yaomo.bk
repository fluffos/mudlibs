//modify by ken
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("【妖魔啮魂】只能对战斗中的对手使用。\n");
        if( target == me ) return notify_fail("你疯了？\n");
        extra = me->query_skill("kugu-blade",1) ;
        if(extra < 70 ) return notify_fail("你的刀法修行太浅，用这招太危险了！\n");
        if( (string)me->query("family/family_name") != "陷空山无底洞" )
              return notify_fail("你叛离了本洞，还好意思用无底洞绝学？\n");
        if( (int)me->query("force") < 400 )
              return notify_fail("你现在内力虚弱的连刀都拿不起来，就别提运招攻敌了。");

        msg = HIR "\n$N的眼中红光一闪，手上的兵刃夹着一条细如发丝的血线悄声无息的刺向$n！" NOR;
        if(random((int)me->query("force")) >= (int)target->query("force")/3)
        {
        message_vision(msg+"\n",me,target);
        message_vision( HIR "$N只觉得身上一阵剧痛，全身气血倒泻而出！\n" NOR,target);
        target->receive_wound("kee",extra*2+random(200));
        me->receive_curing("kee",extra);
        me->add("force",-200);
        COMBAT_D->report_status(target);

        }       
        else{
        message_vision(msg+"\n",me,target);
        message_vision( HIB "但是被$N从容化解了，$N大吼一声：尔敢暗算于我？，纳命来！\n" NOR,target);
        weapon = me->query_temp("weapon");
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add("force",-300);
        }
             if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else
     target->kill_ob(me);
                 }
                me->fight_ob(target);
        }

         me->start_busy(2);
         return 1;
}
