#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
  string dodskill,msg;
  int extra;
  int addon,tmp;
  object weapon;
  extra = me->query_skill("bingpo-blade",1);
      if ( extra < 250) return notify_fail("你的冰魄寒刀还不够纯熟！\n");
      dodskill = (string) me->query_skill_mapped("dodge");
        if ( dodskill != "xiaoyaoyou")
                        return notify_fail("寒光斩需要逍遥游的配合！\n");
        addon = me->query_skill("xiaoyaoyou",1);
        if ( addon < 250 )return notify_fail("你的逍遥游还不够纯熟！\n");
        tmp = me->query_skill("ningxie-force",1);
        if ( tmp < 250 ) return notify_fail("你的冰谷凝血功造诣不足！\n");
        if ((int)me->query("force")<2000)
                return notify_fail("你的真气不够！\n");  
      if ( !target ) target = offensive_target(me);
      if ( !target
   ||      !target->is_character()
   ||      !me->is_fighting(target) )
       return notify_fail("［冰魄六式］只能对战斗中的对手使用。\n");
      if ((int)me->query("force")<300)
       return notify_fail("你的内力不够。\n"); 
           
      if(me->query("family/family_name")!="大雪山")
       return notify_fail("你是从哪里偷学的这个绝招?\n");      
      me->add("force",-200);
      weapon = me->query_temp("weapon");
        me->add_temp("apply/damage",extra/2);
        me->add_temp("apply/attack",tmp/2);
      message_vision(HIM"$N使出冰魄寒刀中的绝招［冰原狂飙］，一招连环六刀，手中的"
         +weapon->name()+"闪电般向$n攻出第一刀 ！"+HIW"长空舞雪\n\n" NOR,me,target);        
        COMBAT_D->do_attack(me,target, weapon); 
        message_vision(HIY"第二刀！"+HIW"冰雪纷飞\n" NOR,me,target);
        COMBAT_D->do_attack(me,target, weapon);
        message_vision(HIY"第三刀！"+HIW"千里冰封\n" NOR,me,target);
        COMBAT_D->do_attack(me,target, weapon);
        message_vision(HIY"第四刀！"+HIW"万里雪飘\n" NOR,me,target);
        COMBAT_D->do_attack(me,target, weapon);
        message_vision(HIY"第五刀！"+HIW"冰雪无痕\n" NOR,me,target);
        COMBAT_D->do_attack(me,target, weapon);
        message_vision(HIY"最后一刀！"+HIW"冰雪连天\n" NOR,me,target);
        COMBAT_D->do_attack(me,target, weapon);
        message_vision(WHT"$N连出六刀，结果$n被攻了个手忙脚乱！\n" NOR,me,target);
        me->add_temp("apply/damage",-extra/2);
        me->add_temp("apply/attack",-tmp/2);
        me->start_busy(3);
        me->add("force",-300);     
        return 1;
                 } 


