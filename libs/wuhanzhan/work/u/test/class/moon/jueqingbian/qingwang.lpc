#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
    int ap,dp,time;

    if( !target ) target = offensive_target(me);
    if( !target
 ||      !target->is_character()
 ||      !me->is_fighting(target) )
        return notify_fail("「情网」只有在战斗中才能使用。\n");

   if(me->query("family/family_name") != "月宫")
          return notify_fail("你虽会绝情鞭，却不知如何使出[情网]！\n");
   if( (int)me->query_skill("jueqingbian", 1) < 50 ) 
          return notify_fail("你的修为不够深，还使不出这一招！\n");

   if( target->is_busy() )
         return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");

     message_vision(HIC"$N催动内力，将手中长鞭舞成一团，化做一张大网，向$n当头罩去。。\n"NOR,me, target);

   me->add("sen", -100);

   ap=(int)me->query_skill("whip");
   ap=ap*ap*ap/10 + (int)me->query("combat_exp");

   dp=(int)target->query_skill("parry");
   dp=dp*dp*dp/10 + (int)target->query("combat_exp");
   time=(int)me->query_skill("jueqingbian", 1) /10;
   if ( time > 10 ) time = 4;
   if ( time < 5  ) time = 2;

   if ( random( ap + dp ) > ap ) {
     message_vision(HIR"\n$n脑子里一片混乱，鬼使神差般突然发呆，甚至忘记了躲闪，被情网当头罩住。 \n"NOR,me,target);
       target->start_busy(time);
   }else {
    message_vision(HIR"$n神情专注，不为所动！\n"NOR,me,target);
           me->start_busy(3);
   }

    if( !target ) target = offensive_target(me);
         if( living(target) ) {
                if( userp(target) ) target->fight_ob(me);
                else target->kill_ob(me);
        }
  return 1;
 }
