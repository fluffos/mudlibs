#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string dodskill,msg;
        int extra;
        int addon, tmp, atk;
        object weapon;
        extra = me->query_skill("sanban-axe",1);
        if ( extra < 250) return notify_fail("你的宣花三斧还不够纯熟！\n");
        dodskill = (string) me->query_skill_mapped("dodge");
        if ( dodskill != "yanxing-steps")
                        return notify_fail("傲狂邪需要雁行步法的配合！\n");
        addon = me->query_skill("yanxing-steps",1);
        if ( addon < 250 )return notify_fail("你的雁行步法还不够纯熟！\n");
        tmp = me->query_skill("lengquan-force",1);
        if ( tmp < 250 ) return notify_fail("你的冷泉神功造诣不足！\n");
        if ((int)me->query("force")<2500)
                return notify_fail("你的真气不够！\n");
        
        if(me->query("family/family_name") != "将军府")
                return notify_fail("你不是将军府弟子，这傲狂邪的奥义似乎难以运用！\n");

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「傲⊙狂⊙邪」只能对战斗中的对手使用。\n");
        
        atk = (addon+tmp)/2;
        me->add_temp("apply/attack",atk/2);
        me->add_temp("apply/damage",extra/2);
        weapon = me->query_temp("weapon");
        message_vision(HIR"\n$N手中巨大狂邪斧乱砍，却丝毫看不出费力！！\n"NOR,me,target);
        message_vision(HIR"傲斧式---$N手中巨大的狂邪斧横扫过去！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIR"狂斧式---$N手中巨大的狂邪斧向下砍去！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIR"邪斧式---$N握紧斧柄与狂邪斧化旋砍出去！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIR"$N放下巨大的狂邪斧，气喘吁吁的站了好久！\n"NOR,me,target);
        me->add_temp("apply/attack",-atk/2);
        me->add_temp("apply/damage",-extra/2);
        me->add("force",-600);
        me->start_busy(4+random(2));
        return 1;
}
