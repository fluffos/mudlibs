// ken

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("doomsword", 1);
  if (extra < 200) return notify_fail("你的寒天吹血神剑还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("吹血神通只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("bloodsword", 1) / 5;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra * 3);
  msg = HIR "$N错步上前，手中的" + weapon->name() + "一招" + WHT "【横扫千军】" + HIY "剑芒带出一道圆月般的弧光向$n挥去\n
" + HIC "剑      气       纵      横      九      万      里！\n" NOR;
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  msg = HIW "一      剑      光      寒      十      四      州！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
