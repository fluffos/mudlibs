// 它是用来引诱对手，让其上当。xixi 上当后死定了. haha
#include <ansi.h>

inherit SSERVER;

void free(object target);
int perform(object me, object target)
{
       object weapon;
       int ap, ap1, ap2, dp, dp1, dp2, kaee, kkee, damage;
       if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你想对谁施展这一招「回风」？\n");

        if(!me->is_fighting())
                return notify_fail("「回风」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 1500 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("mana") < 1000 )
                return notify_fail("你的法力不足！\n");

        if( (int)me->query_skill("snowsword", 1) < 120)
                return notify_fail("你的风回雪舞剑法火候不到，无法驾御这么厉害的武功。\n");
        if( (int)me->query_skill("moonforce", 1) < 120)
                return notify_fail("你的圆月心法火候不到，无法驾御这么厉害的武功。\n");
        if( (int)me->query_skill("moonshentong", 1) < 120)
                return notify_fail("你觉得月宫仙法实在太差，还是能用这招。\n");

  message_vision(MAG+"$N抓住手中的"+(me->query_temp("weapon"))->name()+MAG+
"向空中举起，"+(me->query_temp("weapon"))->name()+MAG+"开始发出耀眼的强光，"+
(me->query_temp("weapon"))->name()+MAG+
"越来越重$N的手开始发颤。\n$N口中念叨：“ 回...........风！！！”\n\n" NOR,me,target,);



//  if( me->query("per") + me->query("cor") > random(target->query_cps() + target->query_cor()) ) ook = 0;
       ap = (int)me->query("combat_exp");
     ap1 = 
(int)me->query_skill("sword")+(int)me->query_skill("moonshentong")+(int)me->query_skill("moondance");  
       ap2 = me->query("mana")+me->query("force") ;
       dp = (int)target->query("combat_exp");
       dp1 = target->query("mana")+target->query("force") ;
       dp2 = (int)target->query_skill("parry")+(int)target->query_skill("dodge");

       if (random(ap+dp) > dp)
   {
                message_vision( HIM 
"$N将手中"+(me->query_temp("weapon"))->name()+HIM"指向$n，$n被一道剑光射出数丈以外，顿时鲜血飞溅。\n" 
NOR,me,target,);
//              kaee = me->query("force")+me->query("mana");
                me->add("force",-800);
              me->add("mana",-500);
             damage=random(800+500+ap1+ap2);
             if(damage<1) damage=random(ap1);
             if(target->query("force")<500) {target->set("force",0);}
             else {target->add("force",-random(500));}
             target->receive_damage("kee", damage, me);
             target->receive_damage("sen", damage, me);
            COMBAT_D->report_status(target);
              me->start_busy(random(3));

}
         else {
                message_vision(HIM 
"忽然"+(me->query_temp("weapon"))->name()+HIM"上的力量全部化解了。\n" NOR,me,target,);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
            me->start_busy(3);
        }
        return 1;
}
