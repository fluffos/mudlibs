// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// 天地无用
// code by forsky

#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage, ap, dp;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招" HIR "「天地无用」" NOR "？\n");

  if (!me->is_fighting())
    return notify_fail("" HIR "「天地无用」" NOR "只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 2500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 2500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 1000)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("spear", 1) < 300)
    return notify_fail("你的基本枪法还不够熟练！\n");

  if ((int)me->query_skill("xiangmo-qiang", 1) < 300)
    return notify_fail("你的降魔枪级别还不够！\n");

  if ((int)me->query_skill("boro-gong", 1) < 250)
    return notify_fail("你的大般若功级别还不够！\n");

  if ((string)me->query("family/family_name") != "天王府")
    return notify_fail("些招是天王府不传之秘，你不能用！\n");

  me->add("force", -100 - (int)me->query("force_factor"));
  me->receive_damage("kee", 150);

  msg = HIR "\n$N突然把枪一收，$n不禁愣了一愣。\n" NOR;
  msg += HIR "$N突然把手中的枪抡了起来，向$n的头上砸了下来。\n" NOR;

  ap = me->query_skill("xiangmo-qiang", 1) + me->query_skill("spear");
  ap = (ap * ap * ap / (4 * 400)) + (int)me->query("kee");
  ap = ap * 250 + (int)me->query("combat_exp");
  dp = target->query_skill("parry");
  dp = (dp * dp * dp / (4 * 400)) + (int)target->query("kee");
  dp = dp * 250 + target->query("combat_exp");
  if (random(ap + dp) > dp) {
    damage = (int)me->query("max_force") / 10 + random((int)me->query("eff_kee") / 5);
    damage -= (int)target->query("max_force") / 10 + random((int)target->query("eff_kee") / 5);
    damage += (int)me->query("force_factor") - random((int)target->query("force_factor"));

    if (damage > 0) {
      msg += HIR "$n被砸了个正着，双脚陷进地里，动弹不得，哇的一声吐出一口鲜血！\n" NOR;
      msg += HIR "$N趁机一枪刺出，正好刺进$n的胸口。\n" NOR;
      msg += HIR "$N大吼一声，把枪一挑，$n竟被挑到了半空中。\n" NOR;
      msg += HIR "$N一个虎跳，跳在空中，一枪打在$n的腰上。\n" NOR;
      msg += HIR "只见$n飞出丈许，重重地摔在地上，看起来已经半死不活了。\n" NOR;
      msg += HIR "$N哈哈大笑几声，轻轻落在地上。\n" NOR;
      target->set("sen", 0);
      target->set("kee", 0);
      me->improve_skill("xiangmo-qiang", 1, 1);
    } else {
      msg += HIR "$n情急这下，双足猛然用力，一下从地里挣了出来。\n" NOR;
      msg += HIR "$n在空中一起断喝，气沉丹田。右手抽出兵器，向$N砍了下来。\n" NOR;
      msg += HIR "$N急忙躲过，却不知$n左手一挥，一掌印在$N的胸口。\n" NOR;
      msg += HIR "$N一声惨叫，仰天喷出一口鲜血，坐倒在地。\n" NOR;
      damage = (int)me->query("kee") / 2;
      me->set("kee", damage);
      damage = (int)me->query("sen") / 2;
      me->set("sen", damage);
    }
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);

    if (!target->is_fighting(me)) {
      if (living(target)) {
        if (userp(target)) target->fight_ob(me);
        else target->kill_ob(me);
      }
    }

    me->start_busy(3);
    return 1;
  }
}
