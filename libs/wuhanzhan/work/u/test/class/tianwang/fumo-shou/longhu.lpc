// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// 降龙伏虎
// code by forsky

#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage, ap, dp;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" HIY "「降龙伏虎」" NOR "？\n");

  if (!me->is_fighting())
    return notify_fail("只有在战斗中才能施展" HIY "「降龙伏虎」" NOR "？\n");

  if ((int)me->query("max_force") < 800)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 800)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("fumo-shou", 1) < 80)
    return notify_fail("你的伏魔手级别还不够！\n");

  me->add("force", -50 - (int)me->query("force_factor"));
  me->receive_damage("kee", 100);
  msg = HIC
    "\n$N大吼一声，右手化为金龙，左手化为赤虎。\n"
    "\n$N双手一错，向$n攻了过来。\n"
    "$n一阵茫然，一时竟然不知如何躲闪！\n" NOR;
  ap = me->query_skill("fumo-shou", 1) + me->query_skill("unarmed");
  ap = (ap * ap * ap / (4 * 400)) + me->query("kee");
  ap = ap * 250 + (int)me->query("combat_exp");
  dp = target->query_skill("unarmed");
  dp = (dp * dp * dp / (4 * 400));
  dp = dp * 250 + target->query("combat_exp");
  if (random((ap + dp) / 1000 + 1) < dp / 1000) {
    msg += HIC
      "\n谁知$n竟险中求胜，双手一封，已将所有攻势封住！\n\n" NOR;
    message_vision(msg, me, target);
  } else {
    damage = (int)me->query_skill("fumo-shou", 1) / 10;
    damage += (int)me->query("max_force") / 10 + random((int)me->query("eff_kee") / 5);
    damage -= (int)target->query("max_force") / 15 + random((int)target->query("eff_kee") / 10);
    damage += (int)me->query("force_factor") - random((int)target->query("force_factor"));
    msg += HIC
      "\n$N的双手结结实实地打在了$n的身上，$n一声惨呼，倒在了地上。\n\n" NOR;
    damage = damage + random((int)me->query_skill("unarmed") / 80);
    target->receive_damage("sen", damage, me);
    target->receive_damage("kee", damage, me);
    me->improve_skill("fumo-shou", 1, 1);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(3);
  return 1;
}
