// modify by ken   2001.6.27
#include <ansi.h>

inherit SSERVER;

void free(object target);
int perform(object me, object target)
{
       object weapon;
       int ap, ap1, ap2, dp, dp1, dp2, kaee, kkee, damage;
       if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你想对谁施展这一招「天下有血」？\n");

        if(!me->is_fighting())
                return notify_fail("「天下有血」岂能是你随便乱用的！\n");

        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力还不足以发动攻势。\n");
        if(me->query("family/family_name") != "阎罗地府")
                return notify_fail("[天下有血]是阎罗地府不传之密！\n");
        
        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("kee") < 300 )
                return notify_fail("你的气血不足，没法子施用外功！\n");
        
        if (me->query_skill_mapped("force")!="tonsillit")
            return notify_fail("「六道轮回」必须配合摄气诀才能使用。\n");
              
        if (me->query_skill_mapped("spells")!="gouhunshu")
            return notify_fail("「六道轮回」必须配合勾魂术才能使用。\n");


        if( (int)me->query_skill("hellfire-whip", 1) < 120)
                return notify_fail("你的烈火鞭修为不精，无法驾御这么厉害的武功。\n");
 
  message_vision(HIR+"只见$N手中的"+(me->query_temp("weapon"))->name()+HIR+
"发出一道道诡异的红光，四周荒野间顿时传来阵阵鬼哭狼嚎，"+HIR+"\n\n$N大喝一声：＂天---下----有---血＂！\n " NOR,me,target,);
       ap = (int)me->query("combat_exp");
       ap1 = 
   (int)me->query_skill("blade")+(int)me->query_skill("evil-force")+(int)me->query_skill("tianmo-blade");  
       ap2 = me->query("mana")+me->query("force") ;
       dp = (int)target->query("combat_exp");
       dp1 = target->query("mana")+target->query("force") ;
       dp2 = (int)target->query_skill("parry")+(int)target->query_skill("dodge");

       if (random(ap+dp) > dp)
   {
                message_vision( RED "结果$n被打了个正着．\n" NOR,me,target,);

             me->add("force",-300);
             damage=random(100+100+ap1+ap2);
             if(damage<1) damage=random(ap1);
             if(damage>1000) damage=random(1200);
             if(target->query("force")<300) {target->set("force",0);}
             else {target->add("force",-random(300));}
             target->receive_wound("kee", damage, me);
//           target->receive_wound("sen", damage, me);
//           不伤精神
             COMBAT_D->report_status(target);
             me->start_busy(2+random(2));

}
         else {
             message_vision(HIM "但是被$n躲开了。\n" NOR,me,target,);  
             me->start_busy(3);
        }
        return 1;
}
