// modify by ken   2001.6.27
#include <ansi.h>

inherit SSERVER;

void free(object target);
int perform(object me, object target)
{
       object weapon;
       int ap, ap1, ap2, dp, dp1, dp2, kaee, kkee, damage;
       if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要攻击谁？\n");

        if(!me->is_fighting())
                return notify_fail("战斗中才能用苍生劫！\n");

        if((int)me->query("max_force") < 1500 )
                return notify_fail("你的内力还不足以发动攻势。\n");
        if(me->query("family/family_name") != "阎罗地府")
                return notify_fail("你又不是鬼，小心乱了阴阳！\n");
        
        if((int)me->query("force") < 2000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("kee") < 700 )
                return notify_fail("你的气血不足，没法子施用外功！\n");
        
        if (me->query_skill_mapped("force")!="tonsillit")
            return notify_fail("「苍生」必须配合摄气诀才能使用。\n");
              
        if (me->query_skill_mapped("spells")!="gouhunshu")
            return notify_fail("「劫」必须配合勾魂术才能使用。\n");


        if( (int)me->query_skill("hellfire-whip", 1) < 270)
                return notify_fail("你的烈火鞭修为不精，无法驾御这么厉害的武功。\n");
 
  message_vision(HIR+"$N手一挥，只见一道血光掠过长空，顿时天地日月被这血光染成了一片血色。"+HIR+"\n这正是地府绝学||苍生劫||发动之势，一阵阵阴森森的鬼笑闪过$n耳际，$N手上长鞭夹杂着无数血雨扫向了$n！\n " NOR,me,target,);
       ap = (int)me->query("combat_exp")*3;
ap1=(int)me->query_skill("whip")+(int)me->query_skill("force")+(int)me->query_skill("hellfire-whip");  
       ap2 = me->query("mana")+me->query("force") ;
       dp = (int)target->query("combat_exp")*2;
       dp1 = target->query("mana")+target->query("force") ;
       dp2 = (int)target->query_skill("parry")+(int)target->query_skill("dodge");

       if (random(ap+dp) > dp)
   {
             message_vision( HIR "$n惨嚎一声，全身被血雨打的血肉横飞，神行俱灭，看样子活下来的希望很渺茫了。\n" NOR,me,target,);
             me->add("force",-300);
             damage=random(100+100+ap1+ap2);
             if(damage<1) damage=random(ap1);
             if(damage>1200) damage=1300;
             if(target->query("force")<300) {target->set("force",0);}
             else {target->add("force",-random(300));}
             target->receive_wound("kee", damage, me);
             target->receive_wound("sen", damage, me);
             COMBAT_D->report_status(target);
             me->start_busy(2+random(2));

}
         else {
             message_vision(HIW "$n大喝一声，运起内功硬是接下了这一招，但也是狼狈不堪。\n" NOR,me,target,);  
             me->start_busy(3);
             target->start_busy(2);
        }
        return 1;
}
