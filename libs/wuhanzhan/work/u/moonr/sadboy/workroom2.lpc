// Room: /u/sadboy/workroom.c
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIR "伤心の家" NOR);
  set("long", @LONG

   你现在正站在伤心的客厅，到处都可以看到用过
的一次性杯子堆满在桌面上，音箱里正传出赵传的歌
--《男孩看见野玫瑰》。客厅的墙壁上还挂着好多照
片(Photo),仔细看上去都是一个漂亮的女孩子。经常
看见伤心对着Photo发呆好久，东边墙上挂着一幅浓
墨未干的狂草字幅（zifu)
LONG);
  set("exits", ([
    "kezhan": "/d/city/kezhan",
    "gaoxiao": "/u/gaoxiao/workroom.lpc",
    "bqt": "/u/bqt/workroom.lpc",
    "wizroom": "/d/wiz/wizroom",
    "guest": "/d/wiz/guest",
    "center": "/u/city/center",
  ]));


  set("no_fight", 1);
  set("valid_startroom", 1);
  set("item_desc", ([
    "photo": HIW "\n她长得极美，尤其是那双眼睛，媚得直可以勾人魂魄。
其容色晶莹如玉，映照于红红烛光之下，娇美不可方物。
回眸嫣然一笑，雅如仙子下凡。眼波流转之间，
便把一个少年的心灵，推向梦中极美的境界。\n" NOR,
    "zifu": HIR "\n既不回头.何必不忘.既是无缘.何必誓言.
             今日种种.似水无痕.明夕何夕.卿已陌路.
。\n" NOR,

  ]));

  set("no_clean_up", 0);
  setup();

}
