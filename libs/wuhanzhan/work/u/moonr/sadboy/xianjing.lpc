#include <room.h>
inherit ROOM;

void create() {
  set("short", "琅璜仙境");
  set("long", @LONG
天后琅璜仙境，鸣莺啼柳，草碧花浓，春意盎然。东西山坳环
抱，山间古木寒茵，浓墨如画。后山崖云雾笼罩，不知尽处。中有
开口流泉悬瀑，弹珠溅玉，飞漱而下，入鼻回香，掬手可饮。
    溪水潺潺，在庭中汇成小湖，水鸟飞蜓，倒影湖面。
    北边篁竹林深处，似乎有扇垂花小门。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "north": "/u/sadboy/workroom",
  ]));

  set("no_clean_up", 0);
  setup();
  create_door("north", "垂花小门", "south", DOOR_CLOSED);
}

void init() {
  add_action("do_drink", "drink");
}

int do_drink(string arg) {
  int current_water;
  int max_water;
  object me;

  me = this_player();
  current_water = me->query("water");
  max_water = me->query("str") * 10 + 100;
  if (current_water < max_water) {
    me->set("water", current_water + 200);
    message("vision", me->name() + "掬起一口水，掌中清晰是你的双眼。你一
口喝了下去，好爽！\n", environment(me), ({ me }));
    write("你掬了一弯水喝，味道不错耶。\n");
  } else {
    write("你其实不想喝的。看了一眼，忧从衷来，撒手，水一点一点滴落。\n");
    //            me->set_skill("dugu-jiujian-sword",72);
  }
  return 1;
}
