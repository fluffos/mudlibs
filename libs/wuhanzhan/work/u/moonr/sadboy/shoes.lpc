// shoe.c
#include <ansi.h>
#include <armor.h>
inherit BOOTS;

void create()
{
        set_name(HIC"凌尘靴"NOR, ({ "lingcheng shoes", "shoes" }) );
        set_weight(1700);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("value", 10000);
                set("material", "cloth");
                set("armor_prop/armor", 5);
                set("armor_prop/dodge", 10);
                set("armor_prop/armor_vs_force", 200);   
                set("armor_prop/armor_vs_spells", 500);   
        }
        setup();
}

