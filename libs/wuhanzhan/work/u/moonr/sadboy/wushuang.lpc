#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIC "无双城" NOR);
  set("long", "           
          " HIW "这里就是传说中的无双城\n 
              无双城弟子聚集的场所\n  
  " MAG " *.    ★          ☆    .   * " NOR "                 
  " BLINK "" MAG "  * .  ..  ☆ " NOR "   
  " BLINK "" MAG "* ★。☆  ." NOR " 
  " BLINK "" MAG "               *  * ☆★  " NOR "
   ");

  set("valid_startroom", 1);
  set("no_magic", 1);
  set("no_exert", 1);
  set("no_fight", 1);
  set("no_clean_up", 0);

  set("exits", ([
    "down": "/d/city/center",
    "up": "/d/city/xuehe",
  ]));
  setup();
}
