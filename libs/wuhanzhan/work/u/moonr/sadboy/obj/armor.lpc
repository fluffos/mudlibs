#include <armor.h>
string query_autoload() { return 1 + "OK"; }
inherit ARMOR;
#include <ansi.h>
void create() {
  set_name(HIR "伤心" NOR, ({ "armor" }));
  set("long", HIY "这是一件非同平常的衣服，嘿嘿.....!\n" NOR);
  set("material", "armor");
  set("no_steal", 1);
  set("no_drop", 1);
  set("unit", "件");
  if (clonep()) set_default_object(__FILE__);
  set("armor_prop/armor", 1000);
  setup();
}

void init() {
  add_action("do_song", "song");
  add_action("do_qing", "qing");
  add_action("do_fuhuo", "fuhuo");
  add_action("do_hun", "hun");
}
int do_song(string arg) {
  object ob;
  ob = LOGIN_D->find_body(arg);
  if (this_player()->query("id") != "sadboy")
    return notify_fail(HIW "你还不配!\n" NOR);
  ob->delete("env/invisibility");
  ob->delete("env/immortal");
  ob->move("/d/city/kezhan");
  write(HIY "你的客人已经顺利返回了!\n" NOR);
  tell_object(ob, HIG "你已经被送回了南城客栈!\n" NOR);
  return 1;
}
int do_qing(string arg) {
  object ob;
  ob = LOGIN_D->find_body(arg);
  if (this_player()->query("id") != "sadboy")
    return notify_fail(HIW "你还不配!\n" NOR);
  ob->delete("env/invisibility");
  ob->delete("env/immortal");
  ob->move("/u/sadboy/workroom");
  write(HIW "已经帮你邀请了!\n" NOR);
  tell_object(ob, HIY "好消息!伤心邀请你去他家里做客!\n" NOR);
  return 1;
}
int do_fuhuo(string arg) {
  object ob;
  ob = LOGIN_D->find_body(arg);
  if (this_player()->query("id") != "sadboy")
    return notify_fail(HIW "你权限不够!\n" NOR);
  if (ob->is_ghost()) {
    tell_object(ob, HIY "某人把你给救活了!\n" NOR);
    write(HIG "你指定的人已经复活了\n" NOR);
    ob->move("/d/city/kezhan");
    ob->reincarnate();
  } else
    return notify_fail(HIW "这个人好象是活的!\n" NOR);
  return 1;
}
