#include <weapon.h>
inherit SWORD;
#include <ansi.h>
inherit F_UNIQUE;

void create() {
  set_name(MAG "紫青宝剑" NOR, ({ "ziqing baojian", "jian", "sword" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "华丽无比的宝剑，传说谁能拔出此剑便是紫霞的心上人。\n");
    set("value", 5000);
    set("material", "steel");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("replace_file", "/d/obj/weapon/sword/qingfeng");
    set("wield_msg", MAG "一道紫光闪过,$N手中多了把$n。\n" NOR);
    set("unwield_msg", MAG "$N将$n" HIW "收回剑鞘，众人才松了口气。\n" NOR);
  }
  init_sword(200);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  if (me->query_skill("sword", 1) < 450)
    me->improve_skill("sword", random(20));
  switch (random(2)) {
    case 0: return "$w" MAG "中射出几道紫色的剑气！\n" NOR;
    case 1: return "$w" MAG "隐隐发出阵阵剑气！\n" NOR;
  }
}
