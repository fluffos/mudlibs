#include <ansi.h>
inherit ITEM;
void create()
{
    set_name( HIY "金卡" NOR, ({ "kar" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
        set("unit", "张");
            set("material", "cloth");
            set("long", "一张金色的信用卡,有着神奇的魔力\n");
                set("no_drop", "别浪费了,那可是可遇不可求的啊。\n");
//                set("no_put", "珍惜它吧。\n");

}
    setup();
}
void init()
{
if(environment()==this_player())
add_action("do_xi","xi");
}
int do_xi(string arg)
{
object gold;
object me;
me=this_player();
   if(arg != "kar" && arg != "^]^P^_^H") return 0;
         me->add("kar",9);
write(HIY "你的好运来了,由于你的所做所为使巫师对你令眼相看,你的属性增加了!\n\n");
destruct(this_object());
return 1;
}

