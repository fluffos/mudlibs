#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIY "云霞天衣" NOR, ({ "tian yi", "color cloth", "tianyi" }));
  set("long", "此乃王母寿辰,织女用七彩云霞特别织就的天衣，触手轻似无物。\n");
  set("unit", "件");
  set("material", "cloth");
  set("armor_prop/armor", 10);
  set("armor_prop/dodge", 10);
  set("armor_prop/personality", 10);
  set("value", 50000);
  set("female_only", 1);
  setup();
}
