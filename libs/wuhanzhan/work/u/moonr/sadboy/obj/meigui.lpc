#include <ansi.h>
#include <dbase.h>
#include <armor.h>
inherit F_AUTOLOAD;  
inherit NECK;
void create()

  {
     set_name(RED"永远的玫瑰"NOR, ({ "mei gui" ,"flower","hua" }) );
     set_weight(100);
      set("long","999朵红玫瑰。表达了伤心对吉祥永远的爱意.\n");
     set("value", 0);
      set("material", "flower");
     set("no_drop", "这么漂亮的花，还是留着吧。\n");
     set("unit", "朵");
  set("armor_prop/armor", 1);
  set("armor_prop/personality", 5);
     setup();
  }

int query_autoload() { return 1; }

