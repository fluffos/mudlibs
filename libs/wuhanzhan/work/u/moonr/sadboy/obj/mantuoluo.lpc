#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIM "千年曼佗罗" NOR, ({ "mantuoluo" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "株");
    set("long", "一株长了千年的曼佗罗，曼佗罗此为一种毒药.过了千年毒性早以散去。\n");
    set("value", 500000);
    set("drug_type", "补品");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
  }

  setup();
}

int do_eat(string arg) {

  object me = this_player();
  if (!id(arg)) return notify_fail("你要吃什么？\n");
  if (userp(me) && (me->query_temp("d_mana")) > 0)
    return notify_fail("你现在的状态不适合吃这么贵重的东西！\n");

  me->set("food", (int)me->max_food_capacity());
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));
  me->add("combat_exp", (int)me->query("combat_exp") / 20);
  me->add("max_force", 50);
  me->add("max_mana", 50);

  message_vision(HIW "$N吃下一株千年曼佗罗,也不知道有毒没有。。。\n" NOR, me);

  destruct(this_object());

  return 1;
}
