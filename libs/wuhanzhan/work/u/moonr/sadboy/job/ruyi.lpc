#include <ansi.h>
inherit NPC;

mapping *quest = ({
  ([ "name": "dxbd",
    "start": "/d/qujing/xiaoxitian/daxiong",
    "place": "小西天大雄宝殿", ]),
  ([ "name": "zt",
    "start": "/d/qujing/pansi/zheng",
    "place": "盘丝岭正厅", ]),
  ([ "name": "bd",
    "start": "/d/qujing/biqiu/bao",
    "place": "比丘国宝殿", ]),
  ([ "name": "yrd",
    "start": "/d/qujing/jisaiguo/restaurant",
    "place": "祭赛国羊肉店", ]),
  ([ "name": "ws",
    "start": "/d/qujing/jilei/woshi",
    "place": "积雷山卧室", ]),
  ([ "name": "xck",
    "start": "/d/qujing/wudidong/entrance",
    "place": "无底洞小村口", ]),
  ([ "name": "lg",
    "start": "/d/qujing/qinfa/longgong",
    "place": "钦法国龙宫", ]),
  ([ "name": "jk",
    "start": "/d/qujing/yinwu/jiankou2",
    "place": "隐雾山涧口", ]),
  ([ "name": "hyt",
    "start": "/d/qujing/firemount/hongyan",
    "place": "火焰山红岩潭", ]),
});
string ask_job();

void create() {
  set_name("如意", ({ "ru yi", "biaotou" }));
  set("gender", "男性");
  set("nickname", "血河镖局");
  set("age", 31);
  set("long", "他是血河派如意，退出江湖后开始押镖，因江湖上他的朋友甚多，所以出镖都很安全。\n");
  set("str", 29);
  set("dex", 26);
  set("con", 24);
  set("int", 22);
  set("per", 38);
  set("max_kee", 2000);
  set("max_sen", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("max_mana", 5800);
  set_skill("blade", 200);
  set_skill("kugu-blade", 280);
  set_skill("lengquan-force", 100);
  map_skill("blade", "kugu-blade");

  set("combat_exp", 5000000);
  set("chat_chance_combat", 55);
  set("chat_msg_combat", ({
    (: perform_action, "pozhan" :),
  }));
  set("inquiry", ([
    "出镖": (: ask_job :),
    "保镖": (: ask_job :),
    "job": (: ask_job :),
  ]));
  setup();
  carry_object("/d/obj/weapon/blade/jindao")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
  add_money("silver", 20);
}
string ask_job() {
  object me, ob, *team;
  mapping aquest;
  int exp, j;
  int i = 0, count = 0, minexp, maxexp;
  aquest = quest[random(sizeof(quest))];
  me = this_player();
  ob = this_object();
  exp = me->query("combat_exp");

  if (me->query_condition("job_busy"))
    return "你现在还有任务在身，等会儿再来吧。";
  if (me->query_temp("on_biao"))
    return "嘿嘿，你身上不是有一趟镖了吗？";
  //        if(ob->query_temp("gived"))
  //                return "现在没有镖可以让你保。";
  if (me->query("balance") < 1000000) return "万一出意外，我看你没能力补偿。";
  if (ob->query("combat_exp") < 500000)
    return "你的功夫太差了。";  //too low exp
    team = me->query_team();
  count = sizeof(team);
  //      if(count <=1)
  //      return "就你一个人?"; //too few people
  if (count > 5)
    return "此事不宜张扬。";  //too many people
    minexp = team[0]->query("combat_exp");
  maxexp = minexp;

  for (i = 1; i < count; i++) {
    if (team[i] != 0) {
      if (team[i]->query("combat_exp") < minexp)
        minexp = team[i]->query("combat_exp");
      if (team[i]->query("combat_exp") > maxexp)
        maxexp = team[i]->query("combat_exp");
    }
  }
  if ((maxexp - minexp) > 800000)
    return "你们的武功相差太悬殊。";  //exp too far
    //check ok

    message_vision(CYN "\n$N高兴地道：看你武艺也不错，就让你试试吧\n", ob);
  me->set_temp("on_biao", 1);
  for (i = 0; i < count; i++) {
    if (team[i]) {
      team[i]->set_temp("on_biao", 1);
      team[i]->set_temp("end_place", aquest["start"]);
      team[i]->set_temp("biao_place", aquest["place"]);
      team[i]->set_temp("gived", 1);
      team[i]->start_busy(1);
      remove_call_out("clear");
      call_out("clear", 1800, ob);
    }
  }
  for (i = 100; i * i * i / 10 <= maxexp; i++);




  remove_call_out("ready");
  call_out("ready", 0, me);
  return "现在有一趟镖运往" + me->query_temp("biao_place") + "，你要负责路上的安全，不可有差错。\n";
}
void ready(object me) {
  object biaoshi, cart, biaoshi1, biaoche;
  int maxpot;
  cart = new(__DIR__ "biaodan");
  message_vision("郭旭把一个镖单塞在$N怀里。\n", me);
  cart->move(me);
  biaoche = new(__DIR__ "biaoche");
  biaoche->move(environment(me));
  me->command("jiayu biao che");
  biaoshi = new(__DIR__ "biaoshi1");
  biaoshi->move(environment(me));
  biaoshi->do_copy(me, maxpot, 3);
  biaoshi1 = new(__DIR__ "biaoshi1");
  biaoshi1->move(environment(me));
  biaoshi1->do_copy(me, maxpot, 3);
  biaoshi->set_leader(me);
  biaoshi1->set_leader(me);
  message_vision("郭旭道：你可以启程了,千万要保护好镖银。\n", me);

}
void clear(object ob) {
  ob->delete_temp("gived");
}
