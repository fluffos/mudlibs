// by sadboy
// 送给可爱的xrh mm
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

string give_wawa(object me);
string give_feiji(object me);
int do_yes(string arg);


void create() {
  set_name(HIC "雪绒花" NOR, ({ "xrhmm" }));
  set("title", HIW "雪☆落☆无☆声" NOR);
  set("gender", "女性");
  set("long", "婷婷玉立的一个女孩，长的十分标志，一笑有两个小酒窝，但却很少说话。\n");
  set("combat_exp", 500000);
  set("age", 20);
  set("per", 27);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set("inquiry", ([

    "name": "我就是这里的店主雪绒花拉。\n",

    "here": "这里便是玩具坊拉。\n",

    "xrh": "雪绒花是个专门派送玩具的好妹妹。\n",

    "ago": "ago啊,她老说自己是xyj第一大好人,但是,群众的眼光是雪亮的哦。\n",

    "ccww": "ccww是个老菜薹落，还没有mm嫁给他\n",

    "qssa": "包子一是个大家都想吃的香喷喷的大肉包。\n",

    "duke": "duke也是个大流氓,mm们对他总是爱理不理的。\n",

    "seashell": "seashell是雪绒花的好老公。\n",

    "xxhaohao": "这个家伙只知道埋头赚钱。\n",

    "sadboy": "伤心是个好gg,大家都喜欢他。\n",

    "布娃娃": (: give_wawa :),

    "buwawa": (: give_wawa :),

    "bu wawa": (: give_wawa :),

    "feiji": (: give_feiji :),


  ]));
  set("no_wawa", 0);
  set("no_feiji", 0);

  set("vendor_goods", ([
    "tea": "/u/sadboy/obj/nuerxiang",
    "gao": "/u/sadboy/obj/gao",
    //       "feiji":"/u/sadboy/obj/feiji",

  ]));

  setup();
  carry_object("/d/obj/cloth/shoes")->wear();
  carry_object("/d/obj/cloth/skirt")->wear();
  add_money("silver", 5);
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 3, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("do_nod", "nod");
  //  add_action("do_chan","chan");

}

string give_wawa(object me) {

  me = this_player();

  if (present("bu wawa", me))
    return "你身上不是已经有布娃娃了吗，怎么又来要？\n";

  {
    me->set_temp("need_wawa", 1);
    return "布娃娃，可是个好玩的东东，你想要吗？\n";
  }
}

int do_nod(string arg) {
  object me, buwawa, who;
  me = this_player();

  if (me->query_temp("need_wawa")) {
    message_vision("$N答道：我真的想要！\n\n", me);
    if (query("no_wawa") == 0) {
      message_vision(
        "雪绒花低头念了几句咒语，手中忽然多了根雪花棒;雪花棒在空中划过一道美丽的弧线，转瞬间，漫天雪花飞舞;只见一个布娃娃随着飘落的雪花，轻轻落到雪绒花手中,雪绒花说道：布娃娃就给你把！\n",
        me
      );
      me->set_temp("need_wawa", 0);

      buwawa = new("/d/obj/misc/buwawa");
      buwawa->move(me);
      command("baobao " + me->query("id"));
      command("face");
      set("no_wawa", 1);
      call_out("regenerate", 240);
    } else {
      message_vision("雪绒花说道：我那里有那么多的布娃娃啊，你过会在来把。\n", me);
      command("sorry " + me->query("id"));
    }

    return 1;
  }
  return 0;
}
int regenerate() {
  set("no_wawa", 0);
  return 1;
}

string give_feiji(object me) {

  me = this_player();

  if (present("feiji", me)) return "你身上不是已经有纸飞机了吗，怎么又来要？\n";
  command("kick " + me->query("id"));


  {
    me->set_temp("need_feiji", 1);
    return "纸飞机，可是个好玩的东东，你想要吗？想要你就说嘛，你不说我怎么知道了，难道你真的想要吗？你真的想要？\n";
  }
}

int do_chan(string arg) {
  object me, feiji, who;
  me = this_player();
  if (me->query_temp("need_feiji")) {
    message_vision("$N答道：我真的想要！\n\n", me);
    message_vision(
      "雪绒花低头念了几句咒语，手中忽然多了根雪花棒;雪花棒在空中划过一道美丽的弧线，转瞬间，漫天雪花飞舞;只见一个纸飞机随着飘落的雪花，轻轻落到雪绒花手中,雪绒花说道：纸飞机就给你把！\n",
      me
    );

    feiji = new("/u/sadboy/obj/feiji");
    feiji->move(me);
    command("baobao " + me->query("id"));
    command("face");

    return 1;
  }
  return 0;
}


void die() {
  if (environment())
    message("sound", "\n\n你们不能对雪绒花妹妹这样哦！\n\n", environment());

  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}
