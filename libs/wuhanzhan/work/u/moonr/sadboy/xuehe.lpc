  " HIR "      ┏━┓                     ┏━┓       " NOR "
  " HIR "      ┃血┃        ==O==        ┃河┃*      " NOR "
  " HIR "      ┗━┛  ┏━┓     ┏━┓  ┗━┛" NOR "
  " HIR "              ┃总┃     ┃舵┃      " NOR "
   " HIR "       +     ┗━┛  *  ┗━┛    +" NOR "
   " MAG "*.    .   .    *      .   * " NOR "                 
   " MAG "* .  ./~~~~~~~~~~~~'. | ◆ " NOR "   
   " MAG "*   ,/,.,...........,.| ◆ ." NOR " 
   " MAG "||  ..▎#  ▎田  田 ▎ | ▎◆   " NOR "
   " MAG "||  &&▎   ▎       ▎'|'▎ o  .. " NOR "  
   " MAG "|| ##■■■■■■■■■■〓▄▃▂▁ " NOR "
  
   ");

