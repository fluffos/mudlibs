#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string *style_siqi = ({
    HIG "大闹阎罗府－－$N身形稍退，手中$w迎风一抖，朝着$n劈头盖脸地砸将下来！\n" NOR,
    HIG "谈笑退天兵－－$N仰天长笑，看也不看，随手一棒向$n当头砸下！\n" NOR,
    HIG "勇斗二郎神－－$N一个虎跳，越过$n头顶，手中$w抡个大圆，呼！地一声砸向$n！\n" NOR,
    HIG "脱困老君炉－－$N一声巨喝，就在$n一愣之间，$N手中$w已是呼啸而至，扫向$n的$l！\n" NOR
  });
  /*
        string *style_qiusheng= ({
HIR "醉闹蟠桃会－－$N脚步跄踉，左一棒，右一棒，\n打得$n手忙脚乱，招架不迭！\n" NOR,
HIR "三打白骨精－－$N连翻几个筋斗云，手中$w转得如风车一般，一连三棒从半空中击向$n顶门！\n" NOR,
HIR "千钧澄玉宇－－$N手中$w一抖，化为千万道霞光，\n就在$n目眩神摇之时，再一抖，霞光顿收，\n$w已到了$n的$l！\n" NOR
});
*/
  string *style_mix = ({
    HIG "大闹阎罗府－－$N身形稍退，手中$w迎风一抖，朝着$n劈头盖脸地砸将下来！\n" NOR,
    HIR "醉闹蟠桃会－－$N脚步跄踉，左一棒，右一棒，\n打得$n手忙脚乱，招架不迭！\n" NOR,
    HIG "谈笑退天兵－－$N仰天长笑，看也不看，随手一棒向$n当头砸下！\n" NOR,
    HIR "三打白骨精－－$N连翻几个筋斗云，手中$w转得如风车一般，一连三棒从半空中击向$n顶门！\n" NOR,
    HIR "勇斗二郎神－－$N一个虎跳，越过$n头顶，手中$w抡个大圆，呼！地一声砸向$n！\n" NOR,
    HIR "千钧澄玉宇－－$N手中$w一抖，化为千万道霞光，\n就在$n目眩神摇之时，再一抖，霞光顿收，\n$w已到了$n的$l！\n" NOR,
    HIG "脱困老君炉－－$N一声巨喝，就在$n一愣之间，$N手中$w已是呼啸而至，扫向$n的$l！\n" NOR
  });

  int skl_me, skl_you, extra_me, extra_you, i;
  int FLAG = 0;
  object you, ob, *obs;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIW "［千均］只能对战斗中的对手使用。\n" NOR);


  if (me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("[千均]是灵台不传之密！\n");
  if ((int)me->query("max_force") < 2500)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 2500)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("qianjun-bang", 1) < 380)
    return notify_fail("你的千钧棒级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("stick", 1) < 320)
    return notify_fail("你的基本棒法级别还不够，使用这一招会有困难！\n");

  if (pointerp(obs = me->query_team())) {
    FLAG = 1;
    for (i = 0; i < sizeof(obs); i++) {
      if (obs[i] == me) continue;
      if (!obs[i]) { FLAG = 0; continue; }
      if (environment(obs[i]) != environment(me)) { FLAG = 0; continue; }
      if (!obs[i]->query_skill("qianjun-bang")) { FLAG = 0; continue; }
      if (!objectp(ob = obs[i]->query_temp("weapon"))) { FLAG = 0; continue; }
    }
    if (sizeof(obs) != 2) FLAG = 0;
  }
  skl_me = (int)me->query_skill("stick");
  extra_me = (int)me->query_temp("apply/damage") + (int)me->query_str() * (int)me->query_str() / 30;
  if (FLAG) {
    if (obs[0] == me) you = obs[1]; else you = obs[0];
    skl_you = (int)you->query_skill("stick");
    extra_you = (int)you->query_temp("apply/damage") + (int)you->query_str() * (int)you->query_str() / 30;
    me->add_temp("apply/attack", (skl_you + skl_me) / 3);
    me->add_temp("apply/damage", (extra_you + extra_me));
    you->add_temp("apply/attack", (skl_you + skl_me) / 3);
    you->add_temp("apply/damage", (extra_you + extra_me));
    you->kill_ob(target);
    for (i = 0; i < sizeof(style_mix); i++)
      if (i % 2) COMBAT_D->do_attack(
        you,
        target,
        you->query_temp("weapon"),
        TYPE_REGULAR,
        style_mix[i]
      );
    else COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, style_mix[i]);
    me->add_temp("apply/attack", -(skl_you + skl_me) / 5);
    me->add_temp("apply/damage", -(extra_you + extra_me) / 2);
    you->add_temp("apply/attack", -(skl_you + skl_me) / 5);
    you->add_temp("apply/damage", -(extra_you + extra_me) / 2);
  } else {
    me->add_temp("apply/attack", skl_me / 10);
    me->add_temp("apply/damage", extra_me / 3);
    for (i = 0; i < sizeof(style_siqi); i++)
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, style_siqi[i]);
    me->add_temp("apply/attack", -skl_me / 10);
    me->add_temp("apply/damage", -extra_me / 3);
  }
  me->start_busy(3);
  return 1;
}
