//asd 六道轮回 ， 我辛辛苦苦编的呀！cry cry 

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
         int dqi,ap,dp,dd1,dd2,dd3,dd4,dd5,dd6;
        int dforce,dmana,dsen,damage,aa,a,dam;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「六道轮回」？\n");

        if(!me->is_fighting())
                return notify_fail("「六道轮回」只能在战斗中使用！\n");

        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不够！\n");
 if((int)me->query("mana") < 1000 )
  return notify_fail("你的法力不够！\n");
        if((int)me->query("kee") < 600 )
                return notify_fail("你的气血不足，没法子施用外功！\n");
        if((int)me->query("sen") < 600 )
                return notify_fail("你的精神不佳，没法子施用外功！\n");

        if((int)me->query_skill("jinghun-zhang", 1) < 140)
                return notify_fail("你的惊魂掌级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("zhuihun-sword", 1) < 100)
                return notify_fail("你的追魂剑级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("kusang-bang", 1) < 140)
                return notify_fail("你的苦丧棒级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("gouhunshu", 1) < 150)
                return notify_fail("你的勾魂术级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("hellfire-whip", 1) < 150)
                return notify_fail("你的烈火鞭级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("tonsillit", 1) < 130)
                return notify_fail("你的摄气诀级别还不够，使用这一招会有困难！\n");
        if(me->query("family/family_name") != "阴曹地府" )
                return notify_fail("你是哪儿偷学来的武功，也想用「六道轮回」?\n");                

     a=random(5)+1;
       weapon=me->query_temp("weapon");
        me->delete("env/brief_message");
        message_vision(HIR"\n$N一掌打在胸口上，一口鲜血喷向空中，猛然举起双手。\n"NOR+
HIC"$N嘴里念叨着：“地狱里熊熊烈火燃烧起来！阎罗王请开启地狱之门。”\n "NOR, me);
       
       dd1=me->query_skill("hellfire-whip", 1); 
       dd2=me->query_skill("zhuihun-sword", 1); 
       dd3=me->query_skill("jinghun-zhang", 1); 
       dd4=me->query_skill("gouhunshu", 1); 
       dd5=me->query_skill("kusang-bang", 1); 
       dd6=me->query_skill("tonsillit", 1); 
       ap = me->query("combat_exp");
       dp = target->query("combat_exp");
       dqi= me->query("kee");
      dsen= me->query("sen");
    dforce= me->query("force");
     dmana= me->query("mana");
           a=7;
      a=random(a)+1;
       aa=0;
        if(random(ap+dp) > dp )
     {
       if( a >= 1 ){
message_vision(HIW"\n阎罗王说道：『第一道轮回』\n"+
HIC"地下冒出了许多的幽灵，在围着$N和$n徘徊，正准备吸人阳气。\n"NOR,target,me);
