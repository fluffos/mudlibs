// feng. 裂风斩
// update by sadboy
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon = me->query_temp("weapon");
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR "[裂风斩]只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("sanban-axe", 1) < 300)
    return notify_fail("你的三板斧不够熟练，使不出[裂风斩]。\n");
  if ((int)me->query_skill("axe", 1) < 300)
    return notify_fail("你基本斧法不够熟练，使不出[裂风斩]。\n");
  if ((int)me->query_skill("lengquan-force", 1) < 300)
    return notify_fail("你的冷泉神功修为过低，还是不要用[裂风斩]。\n");
  if ((int)me->query_skill("yanxing-steps", 1) < 300)
    return notify_fail("你雁行步法不够熟练，使不出[裂风斩]。\n");
  if ((int)me->query_skill("unarmed", 1) < 300)
    return notify_fail("你扑击格斗之技不够熟练，使不出[裂风斩]。\n");
  if ((int)me->query_skill("dodge", 1) < 300)
    return notify_fail("你基本轻功不够熟练，使不出[裂风斩]。\n");
  if (me->query("family/family_name") != "将军府")
    return notify_fail("你是哪儿偷学来的武功，也想用[裂风斩]！\n");

  if ((int)me->query("force") < 3000)
    return notify_fail("你的内力不够，无法使用[裂风斩]。\n");

  msg = HIR "\n$N眉头紧锁，目射红光，沉力腕上，
暗自运起冷泉神功，许久...，有如天降神雷的一声狂吼爆
发出来，$N运斧乱舞，斧光如虹，似光，象电,犹如阳光四
射，把周围的空气都切碎了。又如飘雪飞花般散去，时间仿
佛静止了一般.\n" NOR;

  if (random(me->query("combat_exp")) * 3 > (int)target->query("combat_exp")) {
    msg += RED "$n躲闪不及，已然中斧！\n" NOR;
    damage = 3 * ((int)me->query_skill("sanban-axe", 1) + (int)me->query_skill("axe", 1) / 2);
    damage = damage + random(damage / 2);
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    target->receive_damage("sen", damage);
    target->receive_wound("sen", damage / 2);
    if (damage < 2000) msg += RED "$N冷冷一笑，刹时间，四下里鲜血乱喷，使$N无比兴奋。$n已身中数斧，身上到处是血。\n" NOR;
    else if (damage < 3000) msg += RED "$N冷冷一笑，刹时间，四下里鲜血乱喷，使$N无比兴奋。$n身中数斧，鲜血狂喷而出！\n" NOR;
    else msg += RED "$N冷冷一笑，刹时间，四下里鲜血乱喷，使$N无比兴奋。$n“哇”的狂叫一声，身上喷出七道血剑！\n" NOR;
    message_vision(msg, me, target);
  } else {
    msg += HIC "$n情急之中向后急飞，随即趴下，堪堪躲过了这致命一击。\n" NOR;
    message_vision(msg, me, target);
  }
  me->add("force", -800);
  me->start_busy(3);

  return 1;
}
