//asd 六道轮回 ， 我辛辛苦苦编的呀！cry cry 

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  int dqi, ap, dp, dd1, dd2, dd3, dd4, dd5, dd6;
  int dforce, dmana, dsen, damage, aa, a, dam;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「六道轮回」？\n");

  if (!me->is_fighting())
    return notify_fail("「六道轮回」只能在战斗中使用！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("mana") < 1000)
    return notify_fail("你的法力不够！\n");
  if ((int)me->query("kee") < 600)
    return notify_fail("你的气血不足，没法子施用外功！\n");
  if ((int)me->query("sen") < 600)
    return notify_fail("你的精神不佳，没法子施用外功！\n");

  if ((int)me->query_skill("jinghun-zhang", 1) < 140)
    return notify_fail("你的惊魂掌级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("zhuihun-sword", 1) < 100)
    return notify_fail("你的追魂剑级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("kusang-bang", 1) < 140)
    return notify_fail("你的苦丧棒级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("gouhunshu", 1) < 150)
    return notify_fail("你的勾魂术级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("hellfire-whip", 1) < 150)
    return notify_fail("你的烈火鞭级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("tonsillit", 1) < 130)
    return notify_fail("你的摄气诀级别还不够，使用这一招会有困难！\n");
  if (me->query("family/family_name") != "阴曹地府")
    return notify_fail("你是哪儿偷学来的武功，也想用「六道轮回」?\n");

  a = random(5) + 1;
  weapon = me->query_temp("weapon");
  me->delete("env/brief_message");
  message_vision(HIR "\n$N一掌打在胸口上，一口鲜血喷向空中，猛然举起双手。\n" NOR +
    HIC "$N嘴里念叨着：“地狱里熊熊烈火燃烧起来！阎罗王请开启地狱之门。”\n " NOR, me);

  dd1 = me->query_skill("hellfire-whip", 1);
  dd2 = me->query_skill("zhuihun-sword", 1);
  dd3 = me->query_skill("jinghun-zhang", 1);
  dd4 = me->query_skill("gouhunshu", 1);
  dd5 = me->query_skill("kusang-bang", 1);
  dd6 = me->query_skill("tonsillit", 1);
  ap = me->query("combat_exp");
  dp = target->query("combat_exp");
  dqi = me->query("kee");
  dsen = me->query("sen");
  dforce = me->query("force");
  dmana = me->query("mana");
  a = 7;
  a = random(a) + 1;
  aa = 0;
  if (random(ap + dp) > dp) {
    if (a >= 1) {
      message_vision(HIW "\n阎罗王说道：『第一道轮回』\n" +
        HIC "地下冒出了许多的幽灵，在围着$N和$n徘徊，正准备吸人阳气。\n" NOR, target, me);
      if (dforce > random(target->query("force"))) {
        message_vision(HIC "幽灵突然向$N飞去,$N用内力护住自己，但未时以晚。\n" NOR, target, me);
        (int)damage = random(me->query("max_force") / dd6 * 2);
        if (damage < 1) damage = random(dd6);
        target->receive_wound("kee", damage, me);  //         target->add("kee",-damage);
        COMBAT_D->report_status(target);
      } else {
        message_vision(HIC "幽灵突然向$N飞去,$N用内力把幽灵被镇到$n旁边。呀！！\n" NOR, target, me);
        (int)damage = random(target->query("max_force") / dd6 * 2);
        if (damage < 1) damage = random(dd6);
        me->receive_wound("kee", damage, target);
        COMBAT_D->report_status(me);
      }
      a = a + 1;
    } else { aa = 1; }
    if (a > 2) {
      message_vision(HIW "\n阎罗王说道：『第二道轮回』\n" +
        HIC "远方飞来许多鬼火，象流星般在$n和$N的身旁经过,鬼火越来越多。\n" NOR, target, me);
      if (dsen > random(target->query("sen"))) {
        message_vision(HIC "$N的脸上露胆却的神情，嘴唇开始发颤，腿有些微微颤动。\n" NOR, target, me);
        (int)damage = random(target->query("sen") / dd4 * 2);
        if (damage < 1) damage = random(dd4);
        target->receive_wound("sen", damage, me);
        COMBAT_D->report_sen_status(target);
      } else {
        message_vision(HIC "$n的脸上露胆却的神情，嘴唇开始发颤，腿有些微微颤动。\n" NOR, target, me);
        (int)damage = random(target->query("sen") / dd4 * 2);
        if (damage < 1) damage = random(dd4);
        me->receive_wound("sen", damage, target);
        COMBAT_D->report_sen_status(me);
      }
      a = a + 1;
    } else { aa = 2; }
    if (a > 3) {
      message_vision(HIW "\n阎罗王说道：『第三道轮回』\n" +
        HIC "许多勾魂夜鬼破土而出，团团围住$N和$n，立刻打了起来。\n" NOR, target, me);
      if (dd3 > random(target->query("parry"))) {
        message_vision(HIC "勾魂夜鬼左掌微分，右手一长使出一招「小鬼讨债」，一只惨白的利爪探向$N。\n" NOR, target, me);
        (int)damage = random((target->query("max_kee") / dd3 / 2) * 2);
        if (damage < 1) damage = random(dd3);
        target->receive_damage("kee", damage, me);
        COMBAT_D->report_status(target);
      } else {
        message_vision(HIC "勾魂夜鬼勾魂夜鬼左掌微分，右手一长使出一招「小鬼讨债」，一只惨白的利爪探向$n。\n" NOR, target, me);
        (int)damage = random((target->query("max_kee") / dd3 / 2) * 2);
        if (damage < 1) damage = random(dd3);
        me->receive_damage("kee", damage, target);
        COMBAT_D->report_status(me);
      }
      a = a + 1;
    } else { aa = 3; }
    if (a > 4) {
      message_vision(HIW "\n阎罗王说道：『第四道轮回』\n" +
        HIC "白黑二无常突然出现在$N和$n的面前，立刻战斗起来。\n" NOR, target, me);
      if (dd5 > random(target->query("dodge"))) {
        message_vision(HIC "白无常舞动手中的无常棒，咯咯一笑，一招「寒夜祭灵」夹着点点磷光砸向$N的头上。\n" NOR, target, me);
        (int)damage = random((target->query("max_mana") / dd5) * 2);
        if (damage < 1) damage = dd5;
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target);
      } else {
        message_vision(HIC "黑无常舞动无常棒，咯咯一笑，一招「寒夜祭灵」夹着点点磷光砸向$n的头上。\n" NOR, target, me);
        (int)damage = random((target->query("max_mana") / dd5) * 2);
        if (damage < 1) damage = dd5;
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(me);
      }
      a = a + 1;
    } else { aa = 4; }
    if (a > 5) {
      message_vision(HIW "\n阎罗王说道：『第五道轮回』\n" +
        HIC "阎罗王在地底下怒喝到：$N竟敢惊动本王，那命来！\n" NOR, target, me);
      if (dd2 + 3 > random(target->query("dodge"))) {
        message_vision(HIC "阎罗王手中宝剑一晃出几个虚影，狂风骤雨般地向$N连攻数剑。\n" NOR, target, me);
        (int)damage = random(dd2 * 5) + random((me->query("max_force") / me->query("kee")) * 3);
        if (damage < 1) damage = dd2 + random(dd2);
        target->receive_damage("sen", damage, me);
        COMBAT_D->report_sen_status(target);
      } else {
        message_vision(HIC "阎罗王对$n说道：$N已经不在我的生死簿上了。\n" NOR, target, me);
        /*        damage=random(target->query("max_kee")/dd2*5);       
  target->receive_damage("sen", damage, me);
          COMBAT_D->report_sen_status(target);
*/
      }
      a = a + 1;
    } else { aa = 5; }
    if (a > 6) {
      message_vision(HIW "\n阎罗王说道：『第六道轮回』\n" +
        HIC "地藏王菩萨在空中大怒到：何妨神怪，在此撒野那命来！\n" NOR, target, me);
      if (dd1 + 5 > random(target->query("dodge"))) {
        message_vision(HIC "地藏王菩萨手腕一翻，长鞭抖得笔直，带出一股锐啸猛刺向$N。\n" NOR, target, me);
        (int)damage = random(dd1 * 5) + random(dd6 * 5) + random(me->query("kee") / 10);
        if (damage < 1) damage = dd1 + random(dd6);
        me->add("mana", -800);
        me->add("force", -800);
        me->add("max_force", -(5 + random(10)));
        me->add("max_mana", -(5 + random(10)));
        me->add("max_kee", -random(6));
        me->add("max_sen", -random(6));
        target->receive_damage("kee", damage, me);
        me->start_busy(4 + random(4));
        COMBAT_D->report_status(target);
      } else {
        message_vision(HIC "地藏王菩萨对$n喝道：你竟然擅自开启地狱之门。\n" NOR, target, me);
        /*        damage=random(target->query("max_kee")/dd1*5);       
         me->add("max_kee",-damage);
         COMBAT_D->report_status(me);  */
      }
      a = a + 1;
    } else { aa = 6; }

    if (aa != 0) message_vision(HIM "\n阎罗王对$n说道：地藏王菩萨马上就要视察了，关闭地狱轮回门。\n" NOR, target, me);
  } else
    message_vision(
      HIC "\n阎罗王对$n说道：地藏王菩萨下令地府戒严三天。\n" NOR,
      target,
      me
    ) me->add(
      "force",
      -400
    ) me->add(
      "mana",
      -400
    ) me->add(
      "max_force",
      -random(8)
    ) me->add(
      "max_mana",
      -random(9)
    ) me->add(
      "max_kee",
      -random(4)
    ) me->add("max_sen", -random(4)) me->start_busy(3 + random(3)) if (!target->is_fighting(me))
      if (living(target))
        if (userp(target)) target->fight_ob(me) else target->kill_ob(me)


        return 1
