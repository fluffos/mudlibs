#include <ansi.h>
#include <combat.h>
inherit SSERVER;

// #include "/kungfu/skill/eff_msg.h";


int perform(object me, object target)
{
        int damage, p;
        string msg;
        object weapon;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("「月华无垠」只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
                
        if ( me->query("family/family_name") != "灵鹫宫")
                return notify_fail("你不是本宫弟子，怎么学来的绝招？。\n");

        if( (int)me->query_skill("tianyu-qijian", 1) < 50 )
                return notify_fail("你的天羽奇剑不够娴熟，不会使用。\n");
                                
        if( (int)me->query_skill("bahuang-gong", 1) < 50 )
                return notify_fail("你的八荒六合唯我独尊功不够高。\n");
                        
        if( (int)me->query("neili", 1) < 300 )
                 return notify_fail("你现在内力太弱，不能使用【月华无垠】。\n");
         if( !target ) target = offensive_target(me);


        if( (int)me->query_skill("sword", 1) < 100 )
               return notify_fail("你的剑法不够娴熟，使不出绝招！\n");

//这段perform 有三个阶层，分别有三段判断，一层应比一层厉害，故消耗应一层比一层高
//描述
        msg = GRN "\n$N手中长剑一抖使出"HIM"【月华无垠】"NOR"第一势"HIW"『霜月漫天』"NOR"\n "HIC"只见一轮银月从$N手中缓缓升起,剑气如月光一般挥洒而出。\n"NOR;        
        if (random(me->query_skill("force")) > target->query_skill("force") /3 )
        {                     
                me->start_busy(1);
                target->start_busy(1); 
                me->add("neili", -200);
                me->add("qi", -20);
                damage = (int)me->query_skill("tianyu-qijian", 1);                
                damage = damage + random(damage);
                target->receive_damage("qi", damage/4);
                target->receive_wound("qi", damage/4);
                
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
                msg += damage_msg(damage, "刺伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                call_out("perform2", 1, me, target, p);    
        } else 
        {
                me->start_busy(2);
                target->start_busy(1);
                me->add("neili", -100);
    msg += HIY"\n$n连忙跃开数尺。\n" NOR;
        }
        message_vision(msg, me, target);
        return 1;
}

int perform2(object me, object target, int p)
{
        int damage;
        string msg, msg1;

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("neili", 1) < 400 )
                return notify_fail("你待要再发一剑，却发现自己的内力不够了！\n");     

        msg = GRN "\n$N身形一转使出"NOR"第二势"HIY"『飞仙射月』\n "HIC"$N手中长剑急转一口气连攻五剑。\n"NOR;
        
        if (random(me->query_skill("force")) > target->query_skill("force") / 3 &&
            me->query_skill("tianyu-qijian", 1) > 124 )
        {   
        msg1 = GRN"$N一招「闪电惊虹」，手中$w划出一道剑光劈向$n的$l。" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg1);
        msg1 = GRN"$N一招「咫尺天涯」，一道剑光飞向$n的$l。" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg1);
        msg1 = GRN"$N一招「怒剑狂花」，手中$w舞出无数剑花，使$n难断虚实，无可躲避。" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg1);
        msg1 = GRN"$N一招「漫天风雪」，手腕急抖，挥洒出万点金光，刺向$n的$l。" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg1);
        msg1 = GRN"$N一招「天河倒泻」，$w飞斩盘旋，如疾电般射向$n的胸口。" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg1);


                me->start_busy(1);
                target->start_busy(1);
                me->add("neili", -300);
                me->add("qi", -30);                
                damage = (int)me->query_skill("tianyu-qijian", 1);                
                damage = damage + random(damage);
                target->receive_damage("qi", damage/3);
                target->receive_wound("qi", damage/3);
                
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
                msg += damage_msg(damage, "割伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";                
                call_out("perform3", 1, me, target, p);    
        } else 
        {
                me->start_busy(2);
                me->add("neili", -200);
    msg += HIY"\n$n喘息未定，又觉一股无形剑气扑面而来，连忙跃开数尺，狼狈地避开。\n" NOR;
        }
        message_vision(msg, me, target);

        return 1;
}

int perform3(object me, object target, int p)
{
        int damage;
        string msg;
  
        if(!living(target))
              return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("neili", 1) < 500 )
                return notify_fail("你待要再发一剑，却发现自己的内力不够了！\n");     

        msg = HIR "\n$N深吸一口气全力使出 第三势"HIW"『月华普照』"NOR"\n "HIC"$N一脸平静，手中剑缓缓挥出，$n只觉眼前银光耀眼，\n剑气从四面八方狂涌过来，是在避无可避。\n"NOR;        
        if (random(me->query_skill("force")) > target->query_skill("force") / 2 &&
            me->query_skill("tianyu-qijian", 1) > 149 )
        {
                me->start_busy(3);
                target->start_busy(random(2));
                me->add("neili", -300);
                me->add("qi", -30);                
                damage = (int)me->query_skill("tianyu-qijian", 1);                
                damage = damage*2 + random(damage);
                target->receive_damage("qi", damage/3);
                target->receive_wound("qi", damage/3);

                p = (int)target->query("qi")*100/(int)target->query("max_qi");
                msg += damage_msg(damage, "震伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";     
                
        } else 
        {
                me->start_busy(3);
                target->start_busy(1);
                me->add("neili", -300);
                target->add("qi", -100);
    msg += HIY"\n$n但总算躲开了这致命的一剑！\n" NOR;
        }
        message_vision(msg, me, target);

        return 1;
}

