// 降魔三绝枪 sadboy 

#include <ansi.h>
inherit SSERVER;
#include <combat.h>
void free(object target);
int perform(object me, object target) {
  object weapon;
  int ap, ap1, ap2, dp, dp1, dp2, ook, ap3, dp3;
  string fer;
  if (!target) target = offensive_target(me);
  fer = me->query("id");
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想对谁施展这一招「降魔三绝枪」？\n");
  if (!me->is_fighting())
    return notify_fail("「降魔三绝枪」只能在战斗中使用！\n");

  if (me->query("family/family_name") != "天王府")
    return notify_fail("「降魔三绝枪]只有天王府人才可以用！\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力修为不够！无法催动「降魔三绝枪」。\n");
  if ((int)me->query("force") < 800)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query_skill("xiangmo-qiang", 1) < 250)
    return notify_fail("你的降魔枪火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("spear", 1) < 250)
    return notify_fail("你的基本枪法火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("force", 1) < 250)
    return notify_fail("你的基本内功火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("boro-gong", 1) < 250)
    return notify_fail("你的大般若功火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("parry", 1) < 250)
    return notify_fail("你的拆招卸力火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("dodge", 1) < 250)
    return notify_fail("你的基本轻功火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("feixian-steps", 1) < 250)
    return notify_fail("你的飞仙步法火候不到，无法驾御这么厉害的武功。\n");

  message_vision(
    MAG "$N身影轻轻一晃，脸上紫气突地一现，内力呼的一声从枪尖爆烈而出，$w随着你的内力不停地跳动，$w身上隐隐有一条黄金神龙在飞舞,不断地绕着$w发出金色光芒。$N看也不看对方，纵声长啸道：“上天入地，降魔伏妖”，刷地一声闪电般地攻出三枪。正是天王府的不传之秘[降魔三绝枪]。 \n" NOR,
    me,
    target,
  );
  ook = 1;
  ap = (int)me->query("combat_exp");
  ap1 = (int)me->query_skill("spear");
  ap2 = (int)me->query_skill("xiangmo-qiang");
  ap3 = (int)me->query("str");
  dp = (int)target->query("combat_exp");
  dp1 = (int)target->query_skill("dodge");
  dp2 = (int)target->query_skill("parry");
  dp3 = (int)target->query("str");
  (int)ap = (ap3 + ap1 * ap2) * ap;
  (int)dp = (dp3 + dp1 * dp2) * dp / 2;
  if (random(ap) < random(dp))
    ook = 0;
  if (ook == 1) {
    me->delete("env/brief_message");
    target->delete("env/brief_message");

    message_vision(
      HIC "$n正看得入迷呆在那里不知所错时，$N脚踩飞仙步法，“腾”地一下蹿到半空中，只见双手一抖，降魔枪脱手而出，降魔枪上的黄金神龙“啪”地一下重重地打下。 \n" NOR,
      me,
      target,
    );
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    message_vision(HIY "$n依然呆呆的不动，$N默运[大般若功]，全身被紫气所围，降魔枪随着黄金神龙自上而下，只见四周血雾纷飞。 \n" NOR, me, target,);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    message_vision(
      HIG "$n已恢复了正常,可是身体却依然麻木无法移动，只见降魔枪上的黄金神龙越来越现，$N脸上紫气第三次现出，半空中紫气与黄金神龙合而为一形成一道巨大的紫气金龙，$n只觉枪影如山，躲避不及，被紫气金龙穿胸而过。 \n" NOR,
      me,
      target,
    );
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("force", -150 + random(50));
    me->start_busy(2 + random(1));
  } else {
    message_vision(HIR "$n看破了$N这招,并不为所动，步伐轻盈的向后跳了一步躲开了这一击。\n" NOR, me, target,);
    me->add("force", -50 + random(50));
    me->delete("env/brief_message");
    target->delete("env/brief_message");
    me->start_busy(2 + random(2));
  }
  return 1;
}
