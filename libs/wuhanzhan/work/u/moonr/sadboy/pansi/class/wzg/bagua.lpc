// sadboy 2001.4
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        object weapon;
        
     if ( me->query_skill("baguazhen",1) < 201) 
         return notify_fail("你的［八卦阵法］还不够纯熟！\n");

       if((string)me->query("family/family_name")!="五庄观")
                return notify_fail("这招是五庄观不传之秘，你不能用！");  
  
    if( (int)me->query_skill("dodge", 1) < 201)
              return notify_fail("你的基本轻功火候不到，无法驾御这么厉害的武功。\n");

              if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
           return notify_fail("［错乱八卦］只能对战斗中的对手使用。\n");

      if(target->is_busy())
                return notify_fail(target->name()+"已经手忙脚乱了！\n");

      message_vision( HIY "$N身形突然加快,突然自坎而离，过兑门入震，只见到处都是你的影子，仿佛化身无数！\n" NOR ,me,target);
      if(random((int)target->query("combat_exp")) < (int)me->query("combat_exp"))
   {
     message_vision(HIB "结果$N被晃的头昏眼花，一筹莫展,不知道攻击那个！！\n"NOR,target);
        target->start_busy(6);
               }
        else{
        message_vision("结果$N并不慌张！\n",target);
        me->start_busy(2);
        }
        return 1;
}
