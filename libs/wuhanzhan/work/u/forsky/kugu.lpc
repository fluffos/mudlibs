//枯骨三式 design by forsky 9/12/2000
//kugu.c
 
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{       
        string msg;
        int damage, ap, dp;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me
        ||      !me->is_fighting(target)
        ||      !living(target))
                return notify_fail("你要对谁施展这一招"HIR"「枯骨三式」"NOR"？\n");        

        if( (int)me->query_skill("blade", 1) < 200 
        ||  (int)me->query_skill("huntian-qigong", 1) < 180 
        ||  (int)me->query_skill("kugu-blade", 1) < 200)
                return notify_fail("你有的功夫还不够娴熟，不会使用"HIR"「枯骨三式」"NOR"。\n");
                
        if( (int)me->query("max_force") < 2000 )
                return notify_fail("以你现在的内功修为还使不出「枯骨三式」。\n");
                
        if( (int)me->query("force") < 2000 )
                return notify_fail("你的真气不够！\n");
		
		if((string)me->query("family/family_name")!="陷空山无底洞")
                return notify_fail("这招是陷空山无底洞不传之秘，你不能用！");


        me->add("force", -100-(int)me->query("force_factor"));
        me->receive_damage("kee", 30);
	msg = HIY "\n$N突然脸上黑气一现，仰天怪笑几声，使出无底洞绝技「枯骨三式」！\n" NOR;
        ap = me->query_skill("kugu-blade", 1) + me->query_skill("blade") + me->query_skill("dodge");;
        ap = ( ap * ap * ap / (4 * 400) ) + (int)me->query("kee");
        ap = ap*250 + (int)me->query("combat_exp");
        dp = target->query_skill("parry") + target->query_skill("dodge");;
        dp = ( dp * dp * dp / (4 * 400) ) + (int)target->query("kee");
        dp = dp*250 + target->query("combat_exp");
        if( random(ap + dp) > dp )
        {
                damage = (int)me->query("max_force") / 5 + random((int)me->query("eff_kee") /50);
                damage -= (int)target->query("max_force") / 10 + random((int)target->query("eff_kee") / 5);
                damage+=(int)me->query("force_factor")-random((int)target->query("force_factor"));
                if( damage > 0 )
                {
					me->start_busy(2);
					target->start_busy(2);
					msg += HIY "$N大叫一声，「枯骨三式」第一式！\n"NOR;
					msg += HIR "$N手腕一沉，一刀向$n的下三路撩了过来！\n" NOR;
					msg += HIR "$n没想到招式如此之怪，突然愣住了。\n" NOR;
					msg += HIR "只听见「哧」的一声，$n的右腿被划了一条深可见骨的伤口。\n" NOR;
					target->receive_damage("sen", damage, me);
					target->receive_wound("sen", damage/4, me);
					target->receive_damage("kee", damage, me);
					target->receive_wound("kee", damage/3, me);
                    me->improve_skill("kugu-blade", 1, 1);
				}
				else
				{
					if( random(me->query_skill("force", 1)) < target->query_skill("force", 1)/2)
					{
						msg += HIR "$n冷哼一声，用内劲反击，攻势全反弹了回来！\n" NOR;
						damage += (int)target->query("force_factor");
						me->receive_damage("sen", -damage, target);
                        me->receive_wound("sen", -damage/4, target);
                        me->receive_damage("kee", -damage, target);
                        me->receive_wound("kee", -damage/3, target);
 					}
					else
					{
						msg += HIR "$n大笑几声，就你这点微末技俩，也能伤我？\n" NOR;
						msg += HIR "$n运起轻功，躲开了。\n" NOR;
						me->improve_skill("blade", 1, 1);
					}
				}
		}
		else
			msg += HIR "\n$N突然觉得对方的劲如气墙般压来，招式竟使不出来！\n" NOR;

        message_vision(msg, me, target);
		if( damage > 0 ) COMBAT_D->report_status(target);
		else if( damage < 0 ) COMBAT_D->report_status(me);

		if( !target->is_fighting(me) ) 
		{
			if( living(target) ) 
			{
				if( userp(target) ) target->fight_ob(me);
				else target->kill_ob(me);
			}
		}

        if( (int)me->query_skill("blade", 1) > 250 
        ||  (int)me->query_skill("huntian-qigong", 1) > 200 
        ||  (int)me->query_skill("kugu-blade", 1) > 250)
		{
			remove_call_out("perform2");
			call_out("perform2", 1, me, target);
		}
		else
		{
			me->start_busy(3);		
        }
		return 1;
}

// 第二式

int perform2(object me, object target)
{
	int damage;
	string msg;

    if(!living(target))
		return notify_fail("对手已经不能再战斗了。\n");
	
    if( !target
    ||      !target->is_character()
    ||      target->is_corpse()
    ||      target==me
    ||      !me->is_fighting(target))
	    return notify_fail("「枯骨三式」现在没对手了呀。\n");

	
	if( (int)me->query("force") < 1500 )
		return notify_fail("$N待要再出第二式，却发现内力不够了！\n");
	
	msg = HIY "$N大叫一声，「枯骨三式」第二式！\n"NOR;
	if (random(5)>2)
		msg += HIC"\n但见$N刀交左手，募的砍向$n的中路，$n惊惶失措！\n"NOR;
	else
        msg += HIC"\n但见$N刀交左手，突然冲进$n的怀中，刀势凌厉，$n早已吓慌了手脚！\n"NOR;

	if (random(me->query("combat_exp")) > target->query("combat_exp")/2)
	{
		msg += HIC "$n惊骇之下，顿时出招散乱，无从招架！\n" NOR;
		msg += HIC "谁知$N出得竟是虚招，竟急转刀锋，砍向$n的左腿！\n" NOR;
		msg += HIC "$n躲闪不及，哇地一声惨呼，左腿几乎被砍断！\n" NOR;
		msg += HIC "$n支撑不住，通摔从在地上！\n" NOR;

		me->add("force", -300);
		me->start_busy(2);
		target->start_busy(2);
		damage = (int)me->query_skill("kugu-blade", 1);
		damage = damage+(int)me->query_skill("blade", 1);
		damage = damage*2;
		damage = damage - (int)target->query_skill("parry", 1) - (int)target->query_skill("dodge", 1);
		target->receive_damage("kee", damage);
		target->receive_wound("kee", damage/2);
		me->improve_skill("kugu-blade", 1, 1);
	}
	else 
	{
		msg += HIC "$n强忍伤痛，向旁边跳了过去，躲过了这一招。\n"NOR;
		me->improve_skill("blade", 1, 1);
	}
	
	message_vision(msg, me, target);
	COMBAT_D->report_status(target);

	if( !target->is_fighting(me) ) 
	{
		if( living(target) ) 
		{
			if( userp(target) ) target->fight_ob(me);
			else target->kill_ob(me);
		}
	}
	
    if( (int)me->query_skill("blade", 1) > 300 
    ||  (int)me->query_skill("huntian-qigong", 1) > 250 
    ||  (int)me->query_skill("kugu-blade", 1) > 300)
	{
		remove_call_out("perform3");
		call_out("perform3", 1, me, target);
	}
	else
	{
		me->start_busy(3);		
	}

	return 1;
}

//第三式
int perform3(object me, object target)
{
	int damage;
	string msg;

    if(!living(target))
		return notify_fail("对手已经不能再战斗了。\n");
	
    if( !target
    ||      !target->is_character()
    ||      target->is_corpse()
    ||      target==me
    ||      !me->is_fighting(target))
	    return notify_fail("「枯骨三式」现在没对手了呀。\n");

	
	if( (int)me->query("force") < 1000 )
		return notify_fail("$N待要再出第三式，却发现内力不够了！\n");
	
	msg = HIY "$N大叫一声，「枯骨三式」第三式！\n"NOR;
	if (random(5)>2)
	{
		msg += HIW "\n$N仰天狞笑，兵器竟然脱手飞出，破空射向$n的心窝！\n"NOR;
		msg += HIW "$n大吃一惊，但见$N空手猱身而上，双手擒拿点拍，攻势凌厉之极！\n"NOR;
	}
	else
        msg += HIW "\n$N仰天狞笑，一刀挟风雷之威砍向$n的心窝，$n眼前一黑！\n"NOR;

	if (random(me->query("combat_exp")) > target->query("combat_exp")/3)
	{
		msg += HIW "$n慌乱中已经躲闪不及,$N手中的刀已经砍在$n的胸口。\n" NOR;

		me->add("force", -500);
		me->start_busy(1);
		target->start_busy(1);
		damage = (int)me->query_skill("kugu-blade", 1);
		damage = damage+(int)me->query_skill("blade", 1);
		damage = damage*2;
		target->receive_damage("kee", damage);
		target->receive_wound("kee", damage/2);
		me->improve_skill("kugu-blade", 1, 1);
	}
	else 
	{
		msg += HIW "$n使尽全身的力气向旁边滚了过去，虽然躲过了这一招，已狼狈不堪。\n"NOR;
		me->add("force", -400);
		me->start_busy(3);	
	}
	
	message_vision(msg, me, target);
	COMBAT_D->report_status(target);

	if( !target->is_fighting(me) ) 
	{
		if( living(target) ) 
		{
			if( userp(target) ) target->fight_ob(me);
			else target->kill_ob(me);
		}
	}

	return 1;
}