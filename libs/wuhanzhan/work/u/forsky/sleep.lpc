inherit ROOM;

void create() {
  set("short", "天王府休息室");
  set("long", @LONG

天王府的休息室，李靖和四大天王没事的时候也喜欢来这儿休息。
LONG
  );

  set("sleep_room", 1);
  set("if_bed", 1);

  set("exits", ([
    "west": "/d/sky/zhanyaotai",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  me->delete_temp("rent_paid");
  return ::valid_leave(me, dir);
}
