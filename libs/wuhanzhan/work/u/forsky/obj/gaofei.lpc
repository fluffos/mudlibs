#include <ansi.h>
inherit ITEM;
void create()
{
    set_name( HIY "稿酬红包" NOR, ({ "hongbao" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
        set("unit", "个");
            set("material", "cloth");
            set("long", "一个神秘的红包,里面的东西是.......\n");
            set("no_drop", "如此宝贵的东西再世难求啊。\n");
            set("no_get", "送人？亏你想的出来！\n");

}
    setup();
}
void init()
{
if(environment()==this_player())
add_action("do_open","open");
}
int do_open(string arg)
{
object gold;
object me;
me=this_player();
if(arg != "hongbao" && arg != "稿酬红包") return 0;
me->add("potential",2000);
me->add("combat_exp",5000);
write(HIC "风尘突然出现在一阵烟雾之中！笑嘻嘻的对你一拱手，请多多写稿!\n\n");
destruct(this_object());
return 1;
}
