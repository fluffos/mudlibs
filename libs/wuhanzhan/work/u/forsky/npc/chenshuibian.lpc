// chenshuibian.c

#include <ansi.h>
inherit NPC;

void create() {
  set("gender", "男性");
  set_name("陈水扁", ({ "chen shuibian", "chen" }));
  set("age", 60 + random(50));
  set("long",
    "这是一个喜欢搞台独的千古罪人，。\n");
  set("combat_exp", 600 + random(400));
  set("attitude", "friendly");
  set_skill("dodge", 10);
  set("title", HIW "千古罪人" NOR);
  set_skill("unarmed", 10);
  setup();
  carry_object("/obj/cloth")->wear();
  add_money("gold", 5 + random(5));
}
