// tianshen.c

#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create() {
  set_name(HIC "天神战甲" NOR, ({ "tianshen", "jia", "armor" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIC "据说是天神专用的盔甲，一般兵器无法伤他。\n" NOR);
    set("value", 0);
    set("material", "gold");
    set("armor_prop/armor", 2000);
    set("armor_prop/dodge", 200);
  }
  setup();
}
