#include <ansi.h>
inherit SKILL;

mapping *action = ({
        (["action":     "$N使出一招"HIY"「降魔驱邪」"NOR"，右掌穿出击向$n的$l",
        "dodge":     10,
        "parry":     -10,     
        "force":     160,
        "damage_type":   "刺伤",
                        "weapon" :     "右手食指",
        ]),
        (["action":     "$N使出一招"HIY"「妖魔束手」"NOR"，左掌化虚为实击向$n的$l",
        "dodge":     0,
        "parry":     -20,
        "force":     180,
        "damage_type":   "内伤",
                        "weapon" :     "右手",
        ]),
        (["action":     "$N使出伏魔掌法"HIY"「伏魔无踪」"NOR"，如鬼魅般欺至$n身前，一掌拍向$n的$l",
        "dodge":     -10,
        "parry":     -10,
        "force":     150,
        "damage_type":   "瘀伤",
                        "weapon":     "拳头",
        ]),
        (["action":     "$N双掌一错，使出"HIY"「伏魔三叠」"NOR"，对准$n的$l连续拍出三掌，一掌强过一掌，劲气逼人,",
        "dodge":     -20,
        "parry":     -10,
        "force":     220,
        "damage_type":   "砍伤",
                          "weapon":     "右手",
        ]),
        (["action":     "$N左掌画了个圈圈，右掌推出，一招"HIY"「妖魔让道」"NOR"击向$n$l",
        "dodge":     -10,
        "parry":     -20,
        "force":     180,
        "damage_type":   "撞伤",
                          "weapon":     "全身",
        ]),
        (["action":     "$N使出伏魔掌法最后一招"HIY"「天下无魔」"NOR"，身形散作七处同时向$n的$l出掌攻击",
        "dodge":     10,
        "parry":     10,
        "force":     240,
        "damage_type":   "内伤",
