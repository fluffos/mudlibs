// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// heaven_soldier.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("天龙", ({ "heaven dragon", "long", "dragon", "tianlong" }));
  set("long", "这是一位来自天界的神龙，专门担任护法之责。\n");
  set("attitude", "friendly");
  set("max_gin", 1000);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("max_force", 500);
  set("force", 500);
  set("force_factor", 20);
  set("max_mana", 500);
  set("mana", 500);
  set("mana_factor", 20);
  set("str", 30);
  set("cor", 30);
  set("cps", 25);
  set("combat_exp", 100000);
  set_skill("spear", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("xiangmo-qiang", 100);
  set_skill("feixian-steps", 100);
  map_skill("dodge", "feixian-steps");
  map_skill("spear", "xiangmo-qiang");
  map_skill("parry", "xiangmo-qiang");
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/spear/jinqiang")->wield();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIY + name() + "说道：末将奉法主召唤，现在已经完成护法任务，就此告辞！\n\n"
    +name() + "化成一道金光，飞上天际消失不见了。\n" NOR, environment(),
    this_object());
  destruct(this_object());
}

void invocation(object who) {
  int i;
  object *enemy;
  message("vision",
    HIY "一道金光由天而降，金光中走出一威风凛凛的神龙。\n\n"
    +name() + "说道：末将奉法主召唤，特来护法！\n" NOR,
    environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
}
