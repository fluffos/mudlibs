// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// zz-tianwang.c

inherit NPC;
string send_me(object me);
void create() {
  set_name("天宫使者", ({ "shizhe", "zhe" }));
  set("gender", "男性");
  set("long",
    "天宫使者原是李天王手下一个小校，后被派到凡间来广收门徒。\n"
  );
  set("class", "tianwang");
  set("age", 30);
  set("title", "天宫天王府第五代弟子");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("max_kee", 400);
  set("kee", 400);
  set("max_sen", 300);
  set("sen", 300);
  set("combat_exp", 40000);
  set("force", 300);
  set("max_force", 300);
  set("mana", 200);
  set("max_mana", 200);
  set("force_factor", 2);
  set("mana_factor", 2);

  set_skill("literate", 20);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set_skill("spear", 20);
  set_skill("force", 20);
  set_skill("spells", 20);
  set_skill("axe", 20);
  set_skill("dangmo-axe", 20);
  set_skill("xiangmo-qiang", 20);
  set_skill("fumo-shou", 20);
  set_skill("feixian-steps", 20);
  set_skill("sanqin-dao", 20);
  set_skill("boro-gong", 20);
  map_skill("dodge", "feixian-steps");
  map_skill("parry", "xiangmo-qiang");
  map_skill("spear", "xiangmo-qiang");
  map_skill("unarmed", "fumo-shou");
  map_skill("spells", "sanqin-dao");
  map_skill("force", "boro-gong");
  map_skill("axe", "dangmo-axe");
  create_family("天王府", 5, "天");
  set("inquiry", ([
    "name": "在下是天宫使者，奉命来广收门徒。",
    "天宫": (: send_me :),
    "天王府": (: send_me :),
    "sky": (: send_me :),
    "tianwang": (: send_me :),
  ]));

  setup();
  carry_object("/d/obj/weapon/spear/tiespear")->wield();
  carry_object("/d/obj/armor/tiejia")->wear();
}

string send_me(object me) {
  me = this_player();
  if (me->is_fighting())
    return ("打完架再说吧！\n");
  if (me->is_busy() || me->query_temp("pending/exercising"))
    return ("忙完再说吧。。。\n");

  if ((string)me->query("family/family_name") == "天宫天王府") {
    message_vision("天宫使者，对$N说道：我这就送你上天王府！\n", me);
    message_vision("只见$N踏着彩云向上飘去。。。\n", me);
    me->move("/d/sky/yunlou");
    tell_room(environment(me), "只见#N从彩云中走了出来。\n", ({ me }));
    write("你从彩云中走了出来。\n");
    return ("日后多多努力，必有大成！");
  }
  return ("你不是本派弟子！\n");
}

int attempt_apprentice(object ob) {
  command("say 很好，" + RANK_D->query_respect(ob) +
    "我们天王府需要的就是你这样的人材！\n");
  command("recruit " + ob->query("id"));
  return 1;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "tianwang");
}
