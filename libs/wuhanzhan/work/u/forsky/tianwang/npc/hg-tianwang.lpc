// huguo-tianwang.c
//created 4-8-97 pickle
inherit NPC;

void create()
{
        set_name("魔礼山", ({ "huguo tianwang", "huguo", "tianwang", "wang" }) );
        set("gender", "男性" );
        set("long","

护国天王身担着保护后宫安全的重担，非同小可。他的武功
似乎属佛门一派，但除轮回杖法之外，护国天王还有另外的
杀手绝招，但没有人知道是什么。也许正因为如此，玉皇才
放心让他独担重任。\n"
        );
   set("rank_info/self", "本天王");
   set("rank_info/respect", "护国天王");
   set("class", "tianwang");
   set("title", "天宫天王府第三代弟子");
   set("age",43);
   set("str",30);
   set("int",37);
   set("max_kee",1200);
   set("kee",1100);
   set("max_sen",1100);
   set("sen",1100);
   set("combat_exp",1000000);
   set("force",2500);
   set("max_force",1500);
   set("mana",2500);
   set("max_mana",1500);
   set("force_factor", 70);
   set("mana_factor",80);
   set("eff_dx", 450000);
   set("nkgain", 450);
   set_skill("unarmed",170);
   set_skill("literate",100);   
   set_skill("parry",160);
   set_skill("dodge",150);
   set_skill("spear",140);
   set_skill("force",150);
   set_skill("spells", 150);
   set_skill("xiangmo-qiang",160);
   set_skill("fumo-shou", 170);
   set_skill("feixian-steps", 150);
   set_skill("sanqin-dao", 140);
   set_skill("boro-gong", 150);
   map_skill("dodge", "feixian-steps");
   map_skill("parry", "xiangmo-qiang");
   map_skill("spear","xiangmo-qiang");
   map_skill("unarmed", "fumo-shou");
   map_skill("spells", "sanqin-dao");
   map_skill("force", "boro-gong");
   create_family("天王府", 3, "天");
        set("inquiry", ([
                "name" : "在下就是护国天王，奉圣谕把守北天门。",
                "here" : "这里就是北天门，里面是后宫禁地。",
        ]) );
        setup();
   carry_object("/d/obj/weapon/staff/budd_staff")->wield();
        carry_object("/d/obj/armor/jinjia")->wear();
}

int attempt_apprentice(object me)
{
   string myname=RANK_D->query_respect(me);
   if ((int)me->query("combat_exp")< 100000)
     {
       command("say 这位"+myname+"还是先去跟本府小将打打基础吧！");
       return 0;
     }
   command("haha");
   command("say 很好，时下世间群魔乱舞，"+myname+"多加努力，他日必定有成。\n");   
   command("recruit " + me->query("id") );
   command("addoil" + me->query("id") );
   return 1;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "tianwang");
}
