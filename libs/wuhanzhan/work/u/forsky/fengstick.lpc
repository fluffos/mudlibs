//fengstick.c

#include <ansi.h>
#include <weapon.h>

inherit F_UNIQUE;
inherit STICK;

void create() {
  set_name(HIC "笑看风云" NOR, ({ "fengstick", "stick", "feng", "bang" }));
  set_weight(100000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 0);
    set("material", "gold");
    set("long", HIC "此棒传说是风云化成，是风尘的专用武器。\n" NOR);
    set("wield_msg", HIC "$N一伸手，只见远处有风云滚动, 凝在$N手中成了一根$n。\n" NOR);
    set("unwield_msg", HIC "$N一挥手，$n化做一阵狂风，消失在天空中。\n" NOR);
    set("no_get", HIY "此物乃是宝物, 只有风尘能捡起来。\n" NOR);
    set("no_drop", HIY "此物乃是宝物, 不能随便丢弃。\n" NOR);
    set("no_sell", HIY "此物乃是宝物, 岂可卖掉。\n" NOR);
    set("no_put", HIY "此物乃是宝物, 不能随便给别人。\n" NOR);
  }
  init_stick(250);
  setup();
}
