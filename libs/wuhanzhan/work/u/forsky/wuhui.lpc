//wuhui.c
//by forsky
#include <ansi.h>

inherit NPC;

#include "dirtyword.h"

void punish(object);

void create()
{
        set_name("无秽", ({"wu hui", "wu", "wuhui"}));
        set("title", HIW"净语罗汉"NOR);
        set("gender", "男性" );
        set("age", 300);
        set("per", 5);

        set("long", "净化人类语言的罗汉，你碰上他准是你又口出秽言了。\n");
        set("combat_exp", 300000000);
        set("attitude", "peaceful");
        set_skill("unarmed", 999);
        set_skill("dodge", 999);
        set_skill("parry", 999);
        set_skill("blade", 999);
        set_skill("force", 999);   
        set_skill("literate", 999);
        set_skill("spells", 999);
        set("max_kee", 15000);
        set("max_sen", 14000);
        set("force", 40000);
        set("max_force", 24000);
        set("mana", 60000);
        set("max_mana", 30000);   
        set("force_factor", 1200);
        set("mana_factor", 1500);
        setup();
        if( clonep() ) CHANNEL_D->register_relay_channel("rumor");
        if( clonep() ) CHANNEL_D->register_relay_channel("chat");
        if( clonep() ) CHANNEL_D->register_relay_channel("es");
        if( clonep() ) CHANNEL_D->register_relay_channel("sldh");
        if( clonep() ) CHANNEL_D->register_relay_channel("menpai");
        if( clonep() ) CHANNEL_D->register_relay_channel("xian");

}

void relay_channel(object ob, string channel, string msg)
{

        int i;
        if( !userp(ob) || (channel == "sys") ) return;

        for(i=0; i<sizeof(msg_d); i++)
        {
            if( strsrch(msg, msg_d[i]) >= 0)
                   {
                    call_out("punish",1,ob);
                    return;
                    }
        }
}

void punish(object ob)
{
        command_function("chat* 忽听钟馗一声怒喝："+ob->query("name")+" ，这次你可跑不了了。");
        message_vision(HIW"空中飞下一根绳子，一下就套住$N的脖子。\n"NOR+HIR"$N伸长舌头、翻着白眼地被拖走了。\n"NOR, ob);
        ob->move("/d/wiz/punish");
        command_function("say 敢口出污言秽语?在此地老老实实给我蹲着.");
        message_vision(HIR"说着，绳子一松，$N被扔在地上。\n"NOR, ob);
        log_file("PUNISH_DIRTY", sprintf("dirty punish %s on %s.\n", ob->name(1),ctime(time()) ) );
        return;
}