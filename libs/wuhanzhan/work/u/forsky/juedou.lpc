#include <ansi.h>
#include <login.h>

inherit "/feature/condition.lpc";
inherit "/feature/damage.lpc";
inherit ROOM;

void finish(int);
void jd_die(object who, object killer);
void update_score(object winner, object loser);
void jd_reward(object killer, object victim);

void create() {
  //  restore();
  set("short", HIR "决斗场" NOR);
  set("long", "\n\t       " HIY "英  雄  岂  重  生  死         纵  剑  快  意  恩  仇" NOR "\n\n");
  set("exits", ([]));
  set("broadcast", 1);
  set("alternative_die", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("busy", 0);
  setup();
}

void init() {
  add_action("do_quit", "quit");
  add_action("do_quit", "suicide");
  add_action("do_cast", "cast");
  add_action("do_cast", "exert");
}


int do_quit(string arg) {
  write("你不能在这里用这条命令。\n");
  return 1;
}

int do_cast(string arg) {

  if (!arg) return 0;
  write("决斗场上请勿使用法术。\n");
  return 1;
}

void alternative_die(object who) {
  object p1 = query("player1");
  object p2 = query("player2");
  int winner = 0;

  if (!p1 || !p2) {
    message_vision(HIW "BEEP!BUG!\n" NOR, who);
    who->move(__DIR__ "jdkantai");
    return;
  }
  if (p1 == who) winner = 2;
  else winner = 1;
  finish(winner);
}

void finish(int r) {
  object winner, loser, fan;
  string temp;
  int p;
  remove_call_out("finish");

  set("no_fight", 1);
  set("no_magic", 1);
  if (r == 1) {
    winner = query("player1");
    loser = query("player2");
  } else {
    winner = query("player2");
    loser = query("player1");
  }

  winner->remove_killer(loser);
  loser->remove_killer(winner);
  winner->remove_enemy(loser);
  loser->remove_enemy(winner);

  p = (int)winner->query("kee") * 100 / (int)winner->query("max_kee");
  if (p == 100)
    temp = HIG "趾高气扬地跳下场来" NOR;
  else if (p > 90)
    temp = HIG "高高兴兴地走下场来" NOR;
  else if (p > 80)
    temp = HIG "略带轻伤地走下场来" NOR;
  else if (p > 70)
    temp = HIG "一瘸一拐地走下场来" NOR;
  else if (p > 60)
    temp = HIG "头重脚轻地走下场来" NOR;
  else if (p > 50)
    temp = HIG "跌跌撞撞地走下场来" NOR;
  else if (p > 40)
    temp = HIG "摇头晃脑地走下场来" NOR;
  else if (p > 30)
    temp = HIG "浑身是血地爬下场来" NOR;
  else if (p > 20)
    temp = HIG "头破血流地爬下场来" NOR;
  else if (p > 10)
    temp = HIG "体无完肤地爬下场来" NOR;
  else
    temp = HIG "奄奄一息地被人抬了出来" NOR;

  if (!r) {
    message_vision(HIG "$N与$n大战三百回合，不分胜败，各自离场，改日再战！\n" NOR, winner, loser);
    fan = load_object(__DIR__ "npc/fan");
    fan->command_function("chat " + winner->query("name") + "与" + loser->query("name") +
      "大战三百回合，不分胜负，现各下场休息，来日约了日期，再来一次生死斗。\n");
    loser->move(__DIR__ "jdkantai");
  } else {
    message_vision(HIG "$N在决斗中战胜了$n，飞起一脚，把$n踢到了鬼门关。\n" NOR, winner, loser);
    jd_die(loser, winner);
    message_vision(HIG "$N在观众的欢呼声中，" NOR + p + HIG "。\n" NOR, winner);
    CHANNEL_D->do_channel(
      this_object(),
      "rumor",
      sprintf("听说%s在决斗场中战胜了%s！", winner->query("name"), loser->query("name"))
    );

  }
  winner->move(__DIR__ "jdkantai");
  delete("player1");
  delete("player2");
  delete("busy");
}

void die(object who) {
  alternative_die(who);
}

int do_assign(string arg) {
  object player;

  if (!arg) return notify_fail("select a player.\n");
  if (!player = present(arg, this_object()))
    return notify_fail("player not found.\n");

  if (!query("player1")) {
    set("player1", player);
    return 1;
  }
  if (!query("player2")) {
    set("player2", player);
    return 1;
  }
  return notify_fail("2 players already selected.\n");
}

void start() {
  object p1 = query("player1");
  object p2 = query("player2");
  object fan;
  if ((!p1) || (!p2)) return;
  fan = load_object(__DIR__ "npc/fan");
  message_vision(HIW "$N和$n决斗开始！限时五分钟！\n" NOR, p1, p2);
  fan->command_function("chat " + p1->query("name") + "与" + p2->query("name") + "决斗开始！限时五分钟。\n");
  delete("no_fight");
  delete("no_magic");
  p1->kill_ob(p2);
  p2->kill_ob(p1);
  call_out("finish", 300, 0);
}

void broadcast_room(object room, string str) {
  string prefix = HIY "【决斗场】" NOR;
  string s1 = str, s2 = "", s3;
  int i;

  reset_eval_cost();

  // remove extra trailing NOR. mon 7/13/99
  s1 = replace_string(s1, "\n" NOR, "\n");

  while (strsrch(s1, "\n\n") != -1)
    s1 = replace_string(s1, "\n\n", "\n");

  while (sizeof(s1) > 1 && s1[sizeof(s1) - 1] == '\n') {
    s1 = s1[0..(sizeof(s1) - 2)];
    s2 = "\n";
  }
  if (sizeof(s1) <= 1)
    return;

  s1 = replace_string(s1, "\n", "\n" + prefix);
  if (room) {
    tell_room(room, prefix + s1 + NOR + "\n");
  }
}

void broadcast(string msg) {
  object room = load_object(__DIR__ "jdkantai");
  if (room) broadcast_room(room, msg);
}

void update_score(object winner, object loser) {
  string p1, p2;
  p1 = winner->name(1) + "(" + winner->query("id") + ")";
  p2 = loser->name(1) + "(" + loser->query("id") + ")";
  log_file("juedou", "[" + ctime(time()) + "]：" + p1 + "在决斗中打败了" + p2 + "\n");
}

void jd_die(object who, object killer) {
  object corpse;
  object *inv;
  int i;

  if (!living(who)) revive(1);
  if (wizardp(who) && who->query("env/immortal")) return;

  // Clear all the conditions by death.
  who->clear_condition();

  // destroy all self-made fabao here
  inv = all_inventory(who);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("owner_id") == getuid(who)) {
      tell_object(who, HIB + "你看到" + inv[i]->query("name") +
        HIB + "破空而去，慢慢消失在天际．．．\n" + NOR);
      destruct(inv[i]);
    }
  }

  COMBAT_D->announce(who, "dead");

  jd_reward(killer, who);
  update_score(who, killer);

  remove_ride();
  if (objectp(corpse = CHAR_D->make_corpse(who, killer)))
    corpse->move(environment());

  who->remove_all_killer();
  all_inventory(environment())->remove_killer(who);

  who->dismiss_team();
  if (who->self_purge()) return;


  if (userp(who)) {
    who->set("gin", 1); who->set("eff_gin", 1);
    who->set("kee", 1); who->set("eff_kee", 1);
    who->set("sen", 1); who->set("eff_sen", 1);
    ghost = 1;
    who->move(DEATH_ROOM);
    DEATH_ROOM->start_death(who);
  } else
    destruct(who);
}

void jd_reward(object killer, object victim) {
  int bls;
  string vmark;
  int gain, gain1, lose;
  string str, killerid;

  // Call the mudlib killer apply.
  killer->killed_enemy(victim);

  if (userp(victim)) {
    victim->clear_condition();
    // Give the death penalty to the dying user.
    victim->set("bellicosity", 0);

    if (userp(killer)) {
      killerid = killer->query("id");
      lose = COMBAT_D->victim_lose(killer, victim, killerid) / 2;
      gain = lose * 8 / 20;
      if (gain < 0) gain = 0;
      victim->delete_temp("last_fainted_from");
      if (killerid == victim->query("kill/last_killer")) {
        //discourage repeated killing same player.
        gain1 = victim->query("kill/last_lose") / 2;
        if (gain > gain1) {
          gain = gain1;
        }
      }
      if (lose > 100)
        killer->delete("kill/last_killer");
      killer->add("kill/pkgain", gain);
      killer->add("combat_exp", gain);

      victim->set("kill/last_lose", gain);
      victim->add("kill/pklose", lose);
      victim->add("combat_exp", -lose);

      victim->set("death/mud_age", victim->query("mud_age"));
      victim->set("death/combat_exp_loss", lose);
      victim->set("death/skill_loss", 0);

      str = COMBAT_D->chinese_daoxing(gain);
      if (strlen(str) > 1) {
        str = killer->name(1) + "得到" + str + "道行！";
      }
      str = victim->name(1) + "在决斗中被" + killer->name(1) + "杀死了。" + str;
      CHANNEL_D->do_channel(this_object(), "rumor", str);
      bls = 10;
    }

    if (!userp(killer) && (killer->query("combat_exp") / 10 > victim->query("combat_exp"))) bls = 0;

    if (stringp(vmark = victim->query("vendetta_mark")))
      killer->add("vendetta/" + vmark, 1);

    if (userp(killer)) killer->save();
    if (userp(victim)) victim->save();
  }
}
