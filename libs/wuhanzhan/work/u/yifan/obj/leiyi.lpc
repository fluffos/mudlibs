#include <ansi.h>
#include <armor.h>
inherit BOOTS;
void create()
{
   set_name(YEL "胸罩" NOR, ({ "leiyi" }) );
   set_weight(900);
   if( clonep() )
   set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("long", "这是一件价值连城的内衣，据说是武则天娘娘用了七七四十九个女婴的头发绣成。  \n");
     //set("no_sell",1);
     //set("no_get",1);
     //set("no_drop",1);
     //set("no_give",1);
     set("value",0);
     set("no_steal", 1);
     set("material", "steel");
     set("armor_prop/armor",10);
  }
   setup();
}
int query_autoload() { return 1; }
