#include <ansi.h>
#include <weapon.h>
inherit F_UNIQUE;
inherit BLADE;
void create()
{
        set_name( HIG "追魂斩" NOR, ({ "dragen blade", "blade" }) );
        set_weight(14000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",
                        "＂追魂斩乃大唐云华寺内镇寺之宝，后因云华寺被妖怪所烧。沉沦于尘土里，之后唐三藏年幼时拾得并放入寺内。\n"
                        "每到夜间此斩便发出夺目的红光。上有佛印，映射入目，可助人冥思。御敌时，杀气万里之外仍可感知。\n;"
                                                
                set("value", 350000);
                set("material", "sapphire");
		set("rigidity", 500000);
                set("wield_msg", "$N「刷」地一声抽出一柄闪著红光的$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰间，腰间立刻感到舒畅无比。\n");
     set("replace_file", "/d/obj/weapon/blade/blade");
                set("weapon_prop/agility", 5);
        }
        init_blade(95);
        setup();
}

void owner_is_killed(object killer)
{
	message_vision(HIR"\n \n 追魂斩感知无魂魄所在 " NOR +"立刻飞回到$N的怀中！\n\n",killer);
	this_object()->move(killer);
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
	me->add("bellicosity",10+random(30));
        return HIR "$N的全身映着艳丽的红光...佛印逼人，佛号阵阵回声缓缓荡开.\n" NOR;
                
}

