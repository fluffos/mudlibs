#include <ansi.h>

inherit ITEM;


int do_eat(string arg);
void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(RED "潜力丸" NOR, ({ "wan", "wanzi" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", RED "一颗小小的潜力丸，四周散发着耀眼的光芒。\n");
  }
  if (!wizardp(this_player())) {
    set("no_sell", "潜力丸，怎么能卖？还是自己留着吧。\n");
    set("no_drop", "潜力丸，哪能乱扔! \n");
    set("no_give", "这么贵重的礼物，哪能随便给人？\n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_steal", " 抓贼啊！ \n");
  }

  setup();
}

int do_eat(string arg) {
  int opening;
  object victim = this_player();
  int gain;

  if (!id(arg))
    return notify_fail("你要吃掉什么？\n");
  opening = (int)victim->query("openbao");
  if (opening > 1) {

    victim->set("openbao", 10);
    victim->add("potential", 1000);
    victim->save();

    message_vision(RED "\n$N小心翼翼的把潜力丸放入了嘴里…顿时全身感到无比的舒畅…\n\n" NOR, victim);
    message_vision(HIY "\n四周开始暗了下来…你看不到任何人…天空中突然传来了一个细小的声音……\n\n" NOR, victim);
    tell_object(victim, HIW "如来佛" NOR "对你悄悄说道：因为你努力有功。因此得到了1000点潜能! …………………………………你的视力恢复了…… \n");
    destruct(this_object());
    return 1;
  }
  destruct(this_object());
  return 1;
}
