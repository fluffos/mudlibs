#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string expell_me(object me);
int ask_sansha();
void create() {
  set_name("灵剑老祖", ({ "master lingjian", "lingjian", "master" }));
  set("long", "秋月清风灵剑去，万世剑术空自留。\n");
  set("title", HIY "灵剑门开山老祖" NOR);
  set("gender", "男性");
  set("age", 100);
  set("class", "sword");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("rank_info/respect", "老祖师");
  set("per", 30);
  set("int", 30);
  set("max_kee", 8000);
  set("max_gin", 1000);
  set("max_sen", 8000);
  set("force", 12000);
  set("max_force", 6000);
  set("force_factor", 150);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 150);
  set("combat_exp", 10000000);
  set_skill("literate", 350);
  set_skill("unarmed", 380);
  set_skill("dodge", 380);
  set_skill("parry", 380);
  set_skill("sword", 400);
  set_skill("spells", 400);
  set_skill("lingjianjue", 420);
  set_skill("lingjianzhi", 420);
  set_skill("lingjian-force", 420);
  set_skill("force", 400);
  set_skill("lingjian-shi", 420);
  set_skill("lingjian-step", 420);
  map_skill("spells", "lingjianjue");
  map_skill("unarmed", "lingjianzhi");

  map_skill("force", "lingjian-force");
  map_skill("sword", "lingjian-shi");
  map_skill("parry", "lingjian-shi");
  map_skill("dodge", "lingjian-step");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "jianshen" :),
    (: cast_spell, "sword" :)
  }));


  set("inquiry", ([
    "leave": (: expell_me :),
    "剑神": "老夫不才，不敢以此自居。若论剑术冠绝天下，当数我的仙师了。\n",
    "先师": "老夫原本乃天封圣剑子用过的一把斩妖剑，只是染了些灵气，修成人形而已！\n",
    "圣剑子": "圣剑子乃老夫先师，他老人家剑术到达登峰造极的境界，凭三尺剑、五大绝技无敌于天下！\n",
    "五大绝技": "索性老夫就给你讲讲，这五大绝技就是灵剑心法、灵剑诀、灵剑步、灵剑指和灵剑七式。\n",
    "灵剑心法": "修刚强的内功有助于将真气化为剑气！\n",
    "灵剑诀": "此乃用法力御剑的最高境界！\n",
    "灵剑步": "步法刚柔并济，强大的内力会形成高速的身法！\n",
    "灵剑指": "就是人人传言的无形剑，又称心剑，呵呵，老夫不是自夸，这项绝技老夫已融会贯通了！\n",
    "灵剑七式": "人人梦寐以求的剑法，威力冠绝天下，唉……只可惜，老夫至今也不能达到先师三杀无敌的境界。\n",
    "三杀": (: ask_sansha :),
  ]));
  set("given", 0);

  create_family("灵剑门", 1, "蓝");
  setup();

  carry_object("/d/obj/cloth/xianyi")->wear();
}

void attempt_apprentice(object ob) {
  ob = this_player();
  if ((string)ob->query("family/family_name") == "灵剑门") {
    if ((int)ob->query("combat_exp") < 2000000) {
      command("say 道行不够，" + RANK_D->query_respect(ob) + "还需多加努力才能学更深的剑法。\n");
      return;
    }
    if ((int)ob->query_int() < 35) {
      command("say 这位" + RANK_D->query_respect(ob) + "悟性太低，恐怕无法领悟剑意！\n");
      command("sigh");
      return;
    }
    if ((int)ob->query_skill("lingjian-shi", 1) < 200) {
      command("say 这位" + RANK_D->query_respect(ob) + "还是先把基本剑法练好再说吧！\n");
      command("sigh");
      return;
    }
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，领悟剑意之时就是即位剑神之时。");
    command("recruit " + ob->query("id"));
    return;
  }
  command("shake");
  command("say 老夫不收外门弟子，" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
  return;
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "sword");
  ob->set("title", HIY "灵剑传人" NOR);
}

int accept_fight(object me, object ob) {
  ob = this_player();
  command("say 老夫久不与人交手，今日也不想破例！\n");
  return 0;
}
