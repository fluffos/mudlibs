int ask_sansha() {
  object me, i;
  me = this_player();
  //        laozu=this_object();
  i = new("/d/lingjian/obj/tupu.lpc");
  if ((string)me->query("family/family_name") == "灵剑门") {
    /*
          if ((int)laozu->query("given") = 1)
            {
                 command ("shake");
                 command ("say 老夫已经把图谱借出去了。"); 
                  return 0;
            }           
*/
    command("say 三杀招乃先师的得意绝招，三杀一出，天下无人可敌。");
    command("sigh");
    command("say 只可惜老夫资质太低，尚难以领悟其中真髓！");
    command("say 老夫给你吧，希望你能领悟出这一天下无敌的招式来行侠仗义。");
    //               laozu->set("given",1);
    i->move(me);
    message_vision("灵剑老祖给$N一张$n。\n", me, i);
    return 1;
  }

  command("say 莫非阁下是来探听我灵剑门的秘密？");
  return 1;

}

string expell_me(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") == "灵剑门") {
    command("say 你既是执意离去，为师却有几句话说。");
    me->set_temp("betray_lingjian", 1);
    command("say 我灵剑一派虽不算什么名门，却也有自己的规矩！");
    return ("既是要离去，却需受门规惩罚，你可愿意(agree)?");
  }
  return ("老夫不知。");
}

void init() {
  object me;
  ::init();
  add_action("do_agree", "agree");
  add_action("do_exercise", ({ "bian" }));
  if (interactive(me = this_player()) && !is_fighting()) {
    call_out("greeting", 0, me);

  }
}

int do_agree(string arg) {
  if (this_player()->query_temp("betray_lingjian")) {
    message_vision("$N答道：弟子愿意。\n\n", this_player());
    this_player()->add("betray/count", 1);
    this_player()->add("betray/lingjian", 1);
    command("say 既是我灵剑门容不得你，你且去吧！");
    this_player()->set("combat_exp", (this_player()->query("combat_exp") / 10) * 8);
    this_player()->delete("family");
    this_player()->delete("class");
    this_player()->set("title", "普通百姓");
    this_player()->set_temp("betray_lingjian", 0);
    this_player()->save();
    command("say 江湖风波，善恶无形，好自为之。。。\n");
    return 1;
  }
  return 0;
}

void greeting(object me) {
  int mykar = me->query_kar();
  if (random(mykar) > 100) return;
  else {
    me->delete_temp("spellslevel");
    me->delete_temp("d_mana");
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    return;
  }
}

int do_exercise(string arg) {
  write("你喃喃念了几句咒语,好象想变什么，但什么也没发生。\n");
  return 1;
}



void die() {
  object ob;
  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);
  if (ob)
    ob->set("ffb/kill", "done");
  ::die();
}
