inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("雪无心", ({ "xue wuxin", "xue", "master" }));
  set("long", "灵剑门第三代弟子，功夫虽不及两个师兄，但其轻功却远超师兄。\n");
  set("title", HIW "雪剑" NOR);
  set("gender", "女性");
  set("age", 20);
  set("class", "sword");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("rank_info/respect", "女侠");
  set("per", 26);
  set("str", 20);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("force", 2000);
  set("max_force", 1000);
  set("force_factor", 40);
  set("max_mana", 1000);
  set("mana", 2000);
  set("mana_factor", 40);
  set("combat_exp", 300000);
  set_skill("literate", 150);
  set_skill("unarmed", 180);
  set_skill("dodge", 180);
  set_skill("parry", 180);
  set_skill("sword", 180);
  set_skill("spells", 180);
  set_skill("lingjianjue", 200);
  set_skill("lingjianzhi", 200);
  set_skill("lingjian-force", 200);
  set_skill("force", 180);
  set_skill("lingjian-shi", 200);
  set_skill("lingjian-step", 200);
  map_skill("spells", "lingjianjue");
  map_skill("unarmed", "lingjianzhi");
  map_skill("force", "lingjian-force");
  map_skill("sword", "lingjian-shi");
  map_skill("parry", "lingjian-shi");
  map_skill("dodge", "lingjian-step");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "sword" :),
    (: cast_spell, "jianshen" :),
  }));
  set("chat_chance", 60);

  set("chat_msg", ({
    "雪无心来来回回走着，对灵剑步法似有新的领悟！\n",
    (: random_move :)
  }));


  create_family("灵剑门", 3, "蓝");
  setup();

  carry_object("/d/lingjian/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

void attempt_apprentice(object ob) {
  ob = this_player();

  if (!((string)ob->query("gender") == "女性")) {
    command("shake");
    command("say 我只收女弟子，你还是去找我两个师兄吧。\n");
    return;
  }

  if (ob->query("family/class")) {
    command("say 这位" + RANK_D->query_respect(ob) + "非我派系中的弟子，恐怕收了你却也误导了你！\n");
    command("shake");
    return;
  }
  if ((int)ob->query_int() < 20) {
    command("say 这位" + RANK_D->query_respect(ob) + "悟性太低，恐怕收了你也难以领悟剑道！\n");
    command("xixi");
    return;
  }
  if ((int)ob->query_per() < 20) {
    command("say 你好丑哦，不收，不收……\n");
    command("xixi");
    return;
  }
  if ((int)ob->query_str() < 20) {
    command("say 这位" + RANK_D->query_respect(ob) + "膂力太低，不适合修炼本门功夫！\n");
    command("xixi");
    return;
  }
  command("xixi");
  command("say 好吧，我就收下你了！");
  command("recruit " + ob->query("id"));
  return;
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "sword");
  ob->set("family/class", "ling");
  ob->set("title", "灵剑门雪剑派弟子");
}
