#include <ansi.h>

inherit ITEM;
void create() {
  set_name(HIG "忘情水" NOR, ({ "wangqing shui", "shui" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__); else {
      set("unit", "滴");
      set("long", "这是一滴月下老人所炼制的神水！\n");
      set("value", 0);
      set("drug_type", "补品");
    }
  setup();
}

void init() {
  add_action("do_drink", "drink");
}

int do_drink(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要喝什么？\n");

  message_vision(HIW "$N喝了一口忘情水顿时心中仇恨全无！\n" NOR, me);

  me->remove_all_killer();

  destruct(this_object());
  return 1;
}
