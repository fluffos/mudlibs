void init()
{
        add_action("do_zhai", "zhai");
        add_action("do_hang", "hang");
        add_action("do_hang", "gua");
}


int do_zhai(string arg)
{
    object me,heart,env;

    me = this_player();
    env = this_object();
    
    if( !query("have_heart"))
        return 0;

    if(!arg || ((arg != "stars") && (arg != "heart"))) 
        return notify_fail("你要摘什么？\n");

    heart = new ("/u/icejia/obj/heart");
    heart->move(me);
    set("have_heart",0);
    set("long", @LONG
此阁无顶。每当深夜，微风袭袭，繁星点点；一轮明月，悬于正央。放眼眺望，
妖神两界尽收眼底。苍穹暗淡，唯阁烛一盏；万物尽淡，唯英雄美人。。。
LONG);
    message_vision(MAG"$N轻轻的从天上摘下一颗星心！\n"NOR,me);
    return 1;
}

int do_hang(string arg)
{
    object heart,me;

    me = this_player();

    if(!arg || ((arg != "heart") && (arg != "stars")))
        return notify_fail("你要挂什么？\n");

    if(!objectp(heart = present("heart",me)))
        return notify_fail("你身上没有好看的东西可以挂！\n");
    if(!heart->query("can_hang"))
        return notify_fail("这好像不是那颗能挂的星心吧！\n");
    if(query("have_heart"))
    {
        message_vision(HIM"$N想把星心挂到星空中，却发现已经有一个了！\n"NOR,me);
        return 1;
    }
    add("long",heart_str());
    set("have_heart",1);
    destruct(heart);
    message_vision(HIM"$N从身上拿出一颗美丽的星心挂在天上，顿时整个世界充满了温馨！好美呀！\n"NOR,me);
    return 1;
}

