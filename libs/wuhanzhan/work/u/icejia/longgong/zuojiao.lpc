// 左穿心脚
// code by icejia
 
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int damage, ap, dp,shanghai;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招"HIC"「左穿心脚」"NOR"？\n");

        if(!me->is_fighting())
                return notify_fail(""HIC"「左穿心脚」"NOR"只能在战斗中使用！\n");

        if((int)me->query("max_force") < 1200 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 1200 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("kee") < 150 )
                return notify_fail("你的气血不足！\n");

        if((int)me->query("sen") < 400 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("dragonfight", 1) <600)
                return notify_fail("你的龙型搏击级别还不够！\n");

        me->add("force", -100-(int)me->query("force_factor"));
        me->receive_damage("kee", 150);
        
        msg = HIC"\n$N一抬脚尖，左脚带起一声风嚣叫射向$n的心口。\n"NOR;
        
        if( time()-(int)me->query_temp("lianji4_end") < 6  ) {
            damage = (int)me->query("max_force") / 10 + random((int)me->query("eff_kee") /5);
            damage -= (int)target->query("max_force") / 10 + random((int)target->query("eff_kee") / 5);
            damage+=(int)me->query("force_factor")-random((int)target->query("force_factor"));
        
            if( damage > 0 ) {
               msg += HIC "须臾之后，$N的左脚脚尖已经点在$n的心口之上。$n七窍都喷出血来。\n" NOR;
               damage +=random((damage*(int)me->query_skill("unarmed"))/160);
               target->receive_damage("sen", damage/4, me);
               target->receive_wound("sen", damage/18, me);
               target->receive_damage("kee", damage/4, me);
               target->receive_wound("kee", damage/12, me);
               target->start_busy(3);
               me->improve_skill("dragonfight", 1, 1);
               me->set_temp("lianji5_end",time());
               
            }
            else {
               msg += HIW "$n一声冷笑这样慢的招数也想打着人？\n" NOR;
               
            }
                    } 
            else 
               msg += HIW "$n一声冷笑这样的招数也想打着人？\n" NOR;
               
            message_vision(msg, me, target);
            if( damage > 0 ) COMBAT_D->report_status(target);
      
            if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
            }

           me->start_busy(1+random(1));
           return 1;
        }


