#include <ansi.h>
#include <armor.h>
inherit HANDS;
void create()
{
  set_name(HIY "黄金手套" NOR, ({"golden hands", "hands"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "golden");
    set("unit", "只");
    set("value", 150000);
               set("no_sell", 1);
               set("no_drop", 1);
    set("armor_prop/armor", 50);
  }
  setup();
}

