#include <ansi.h>

inherit ITEM;


int do_eat(string arg);
void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIG "元宵" NOR, ({ "yuanxiao", "tangyuan" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIG "一个血·舞烹制的元宵。\n");
  }
  if (!wizardp(this_player())) {
    set("no_sell", "怎么能卖？还是自己留着吧。\n");
    set("no_drop", "哪能乱扔! \n");
    set("no_give", "这么贵重的礼物，哪能随便给人？\n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_steal", " 抓贼啊！ \n");
  }

  setup();
}

int do_eat(string arg) {
  int eating;
  object victim = this_player();
  int gain;

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  eating = (int)victim->query("eatdan");
  if (eating > 1) {
    message_vision(HIY "$N已经吃过一次。\n" NOR, victim);
  } else {

    gain = (int)victim->query("combat_exp") / 100;
    victim->set("eatdan", 10);
    victim->add("combat_exp", gain);
    victim->add("potential", 66666);
    victim->add("max_force", 100);
    victim->add("max_mana", 100);
    victim->save();
    gain = (int)gain / 1000;

    message_vision(HIW "\n$N吃下一颗元宵……\n\n" NOR, victim);
    destruct(this_object());
    victim->unconcious();
    return 1;
  }
}
