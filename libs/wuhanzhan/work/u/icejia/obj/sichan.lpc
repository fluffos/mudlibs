#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name(WHT "枯萎的蟾蜍" NOR, ({ "si chan", "chan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只枯萎了的冰蟾。\n");
    set("unit", "只");
    set("base_unit", "只");
    set("base_weight", 1);
    set("base_value", 1000);
    set("value", 1000);
    set("weapon_prop/personality", 1);
    set("wield_msg", "$N轻轻将冰蟾附着于掌背。\n");
  }
  set_amount(1);
  init_throwing(80);
  setup();
}
