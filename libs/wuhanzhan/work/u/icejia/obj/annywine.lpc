
// annywine
#include <ansi.h>
inherit NPC;
//inherit F_MASTER;
string expell_me(object me);



void create()
{
       set_name(HIW"冰柠柠"NOR, ({"cc_cecilia","icejiawife"}));

   set("long","血·舞的温柔体贴贤淑善解人意的娘子。\n");
       set("gender", "女性");
       set("age", 20);
   set("int", 25+random(5));
        set("title", HIM"血·舞的娘子"NOR);
       set("attitude", "peaceful");
        set("combat_exp", 900000000);
       set("rank_info/respect", "公主殿下");
       set("class","dragon");
       set("per", 30);
       set("max_kee", 50000);
       set("max_sen", 50000);
       set("force", 180000);
       set("max_force", 90000);
       set("force_factor", 1000);
       set("max_mana", 90000);
       set("mana", 180000);
       set("mana_factor", 2000);
       set_skill("literate", 800);
       set_skill("unarmed", 800);
       set_skill("dodge", 800);
       set_skill("force", 800);
       set_skill("parry", 800);
       set_skill("fork", 800);
       set_skill("spells", 800);
        set_skill("seashentong", 800);
        set_skill("dragonfight", 800);
        set_skill("dragonforce", 800);
        set_skill("fengbo-cha", 800);
        set_skill("dragonstep", 800);
        map_skill("spells", "seashentong");
        map_skill("unarmed", "dragonfight");
        map_skill("force", "dragonforce");
        map_skill("fork", "fengbo-cha");
        map_skill("parry", "fengbo-cha");
        map_skill("dodge", "dragonstep");

        
         

    create_family("东海龙宫", 2, "水族");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
                (: perform_action, "unarmed", "leidong" :),
                (: perform_action, "unarmed", "sheshen" :),
  }) );
        set("chat_chance", 6);
        set("chat_msg", ({
                (: call_other, this_object(), "random_move" :),
         RED"王贇轻轻唱道：想要问问你敢不敢，象你说过那样的爱我。\n"NOR,
       HIG"王贇轻声的哼着：想要问问你敢不敢，象我这样为爱痴狂。\n"NOR,
        HIM"王贇痴情的唱道：心痛的无法呼吸，找不到你留下的痕迹。\n"NOR,
        YEL"王贇幽声的唱道：就在这一刻全世界伤心角色又多了我一个。\n"NOR,
        BLU"王贇脸上闪过一丝哀愁，唱道：有生之年，狭路相逢，终不能幸免。\n"NOR,
        CYN"王贇叹了口气说道：古代有陶渊明清高，不为五斗米折腰，但是我向青春借贷款，可是利息太高。\n"NOR,
        GRN"王贇低声呐喊：２３岁的九局下半，转哪转。我把帽子反戴还在期待大逆转。\n"NOR,
        MAG"王贇低声呐喊：２３岁的九局下半，我应该反省觉悟，还是当它只是一个美丽的错误。\n"NOR,
       HIW"王贇淡淡的唱道：我要我控制我自己，不会让谁看见我哭泣。\n"NOR  }) );
   setup();
//  carry_object("/d/mojiao/obj/fireblade")->wield();
  carry_object("/ymdh/obj2/pifeng")->wear();
  carry_object("/u/icejia/obj/wangqing")->wear();
  carry_object("/u/icejia/qupu")->wear();
  carry_object("/u/icejia/pipa")->wear();
  carry_object("/u/icejia/yaoqin")->wear();

}

void attempt_apprentice(object ob)
{
        command("jump");
   command("say 我又多了一个弟子耶！\n");
        command("recruit " + ob->query("id") );
        return;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "dragon");
}
string expell_me(object me)
{
  me=this_player();
  if((string)me->query("family/family_name")=="东海龙宫")
    {
      message_vision("紫云公主难过地望着$N，欲言又止。\n", me);
      return ("你去问我父王吧。\n");
    }
  return ("去问问别人吧！我怎么会知道！n");
}

