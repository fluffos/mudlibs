# include <skill.h>
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIW"冰 蟾"NOR, ({"bing chan", "chan chu"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("no_sell",1);
                set("value",0);
                set("unit","只");
                set("long",
"一只晶莹通透的冰蝉，似乎是上古便被人用内力冰封起来的。\n");
        }
        setup();
}
void init()
{

  object me = this_object();
  object where = environment();

  if (userp(where))
  {
    if (me->query("owned"))
    {
      if (me->query("owned")!=where->query("id"))
      {
        call_out("destruct_me",1,where,me);
      }
    }
    else
    {
      me->set("owned",where->query("id"));
    }
  }
        add_action("do_combine","combine");
}
void destruct_me(object where, object me)
{
        object sichan;
        if( sichan=new("/u/icejia/obj/sichan"))
                sichan->move(where);
        message_vision(HIW"$N手中的$n突发一道耀眼的银光。\n"NOR,where,me);
        destruct(me);
}
int do_combine()
{
        object me,a,b,jiuzhuan;
        me=this_player();
        a=this_object();

        if( (int)me->query("force") < 1500)
                return notify_fail("你的内力不足，用内力将冰蟾与琼草熔合。\n");
        if( (int)me->query("mana") < 1000)
                return notify_fail("你的法力不足，用法力将冰蟾与琼草熔合。\n");

        if ( !(b=present("qiong cao",me))) 
                return notify_fail("你用法力引导，将内力灌注与蟾蜍之中，似乎没有任何反映。\n");
        if( jiuzhuan=new("/d/obj/drug/dan")){
                destruct(b);
               jiuzhuan->move(me);
        message_vision(HIR"$N左手托起冰蟾，右手托起琼草，缓缓将两物推进，用法力引导，将内力灌注与蟾蜍琼草之中。
耀眼的金光过后，手中竟然合成了一颗九转金丹。\n"NOR,me);
        destruct(a);
        }
        return 1;
}

