#include <weapon.h>
inherit SWORD;
#include <ansi.h>
inherit F_UNIQUE;

void create()
{
   set_name(HIB"冷 血"NOR, ({"leng xie", "jian","sword"}));
   set_weight(50);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("long", "这是一柄异色的长剑，剑身上云走霞绕。\n");
     set("value", 50000);
     set("material", "steel");
     set("no_sell",1);
     set("no_drop",1);
     set("no_put",1);
     set("no_steal",1);
     set("no_give",1);
     set("replace_file","/d/obj/weapon/sword/changjian");
     set("wield_msg", HIB"$N缓缓的拔出腰间的$n，\n"HIB"蓝色的刀刃映的$N的脸显得更加冷酷了。\n"NOR);
     set("unwield_msg", HIB"$N将$n"HIB"慢慢插回剑鞘，脸上的冷酷消散了，\n但是似乎多了一丝惆怅。\n"NOR);
   }
   init_sword(200);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
       if(me->query_skill("sword",1)<450)
        me->improve_skill("sword",random(20));
                switch(random(7)) {
                        case 0: return "一道"RED"红"NOR"色"RED"血光"NOR"从$w迸射出来！\n";
                        case 1: return "一道"MAG"橙"NOR"色"MAG"阳光"NOR"从$w宣洒出来！\n";
                        case 2: return "一道"YEL"黄"NOR"色"YEL"暮色"NOR"从$w倾泻出来！\n";
                        case 3: return "一道"HIG"绿"NOR"色"HIG"柔风"NOR"从$w飘荡出来！\n";
                        case 4: return "一道"HIW"青"NOR"色"HIW"煞气"NOR"从$w散发出来！\n";
                        case 5: return "一道"BLU"蓝"NOR"色"BLU"冷酷"NOR"从$w沁透出来！\n";
                        case 6: return "一道"MAG"紫"NOR"色"MAG"惆怅"NOR"从$w洋溢出来！\n";
                             

}
}

