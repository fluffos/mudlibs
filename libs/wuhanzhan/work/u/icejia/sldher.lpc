//   水陆大会发奖器
#include <ansi.h>
inherit ITEM;
#define DEBUG 0
mapping sldher;
void create() {
  set_name("水陆大会发奖器", ({ "fajiang qi", "qi" }));
  set("long", @LONG
        sure 玩家的ID 冠军否的标志。
        举例:first ken (表示给冠军ken发奖)
             sure ken       (表示给普通玩家发鼓励奖)
LONG);
  set("unit", "个");
  set("type", "misc");
  setup();
}
void init() {
  add_action("do_sure", "sure");
  add_action("do_first", "first");
  add_action("do_second", "second");
  add_action("do_third", "third");
  add_action("do_mvp", "mvp");
  add_action("do_good", "good");
}
void announcing(string str) {
  if (DEBUG) {
    object smile = find_player("smile");
    if (wizardp(smile))
      tell_object(smile, " @** " + str);
  } else {
    object wei = load_object("/d/kaifeng/npc/wei");
    wei->command_function("chat " + str);
  }
}

void announce(string str) {
  string s = str;
  int i, j;
  while ((i = strlen(s)) > 0) {
    j = strsrch(s, "\n");
    if (j < 0) {
      announcing(s);
      return;
    }
    announcing(s[0..j]);
    s = s[j + 1..i];
  }
}

int do_sure(string id) {
  object who = this_player();
  object ob = this_object();
  object sldher = find_player(id);
  int i = 0, dx = 0;
  if (!wizardp(who)) {
    tell_object(who, "你没有权限获得这个物体，没有权限使用这个命令。\n");
    tell_room(environment(who), ob->name() + "毁灭了。\n");
    destruct(ob);
    return 1;
  }

  if (!sldher)
    return notify_fail("你要设置谁得奖？\n");
  if (!environment(sldher))
    return notify_fail("这位玩家还没进入这个世界呢。\n");

  if (ob->query(id)) {
    tell_object(who, sldher->name() + "已经拿过奖励了，可不能发第二次。\n");
    return 1;
  } else {
    dx = sldher->query("combat_exp");
    if (dx < 1000) {
      tell_object(who, sldher->name() + "的道行不满一年，没有资格获得奖励。\n");
      return 1;
    }
    if (dx > 1000 && dx <= 1000000) i = 1;
    if (dx > 1000000 && dx <= 5000000) i = 2;
    if (dx > 5000000 && dx <= 10000000) i = 3;
    if (dx > 10000000) i = 4;

    ob->set(sldher->query("id"), 1);
    tell_object(sldher, HIG "你现在获得本届水陆大会奖励如下：\n" NOR);
    tell_object(sldher, "      " + chinese_number(5000 * i) + "点潜能！\n");
    sldher->add("potential", 5000 * i);
    tell_object(who, "参赛者" + sldher->query("name") + "  获得奖励。\n");
    announce("本届水陆大会参赛者" + sldher->name() + "(" + sldher->query("id") + ")" + "  获得奖励。");
  }

  return 1;
}

int do_first(string id) {
  object who = this_player();
  object ob = this_object();
  object gold, guo;
  object sldher = find_player(id);
  int i = 0, dx = 0;
  if (!wizardp(who)) {
    tell_object(who, "你没有权限获得这个物体，没有权限使用这个命令。\n");
    tell_room(environment(who), ob->name() + "毁灭了。\n");
    destruct(ob);
    return 1;
  }

  if (!sldher)
    return notify_fail("你要设置谁得奖？\n");
  if (!environment(sldher))
    return notify_fail("这位玩家还没进入这个世界呢。\n");

  if (ob->query(id)) {
    tell_object(who, sldher->name() + "已经拿过奖励了，可不能发第二次。\n");
    return 1;
  } else {
    dx = sldher->query("combat_exp");
    if (dx < 1000) {
      tell_object(who, sldher->name() + "的道行不满一年，没有资格获得奖励。\n");
      return 1;
    }

    if (dx > 1000 && dx <= 1000000) i = 1;
    if (dx > 1000000 && dx <= 5000000) i = 2;
    if (dx > 5000000 && dx <= 10000000) i = 3;
    if (dx > 10000000) i = 4;
    ob->set(sldher->query("id"), 1);
    tell_object(sldher, HIG "你现在获得本届水陆大会奖励如下：\n" NOR);
    tell_object(sldher, "      " + chinese_number(100000 * i) + "点潜能！\n");
    sldher->add("potential", 100000 * i);

    /*
*/
    tell_object(sldher, "      三个千年何首乌。\n");
    guo = new("/u/bqt/obj/qnheshouwu");
    guo->move(sldher);
    guo = new("/u/bqt/obj/qnheshouwu");
    guo->move(sldher);
    guo = new("/u/bqt/obj/qnheshouwu");
    guo->move(sldher);
    tell_object(who, "冠军" + sldher->query("name") + "  获得奖励。\n");
    announce("本届水陆大会小组冠军" + sldher->name() + "(" + sldher->query("id") + ")" + "  获得奖励。");
  }

  return 1;
}
