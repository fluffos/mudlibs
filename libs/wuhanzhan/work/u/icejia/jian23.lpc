#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target) {
  object *ob;
  int i, skill, b, force;

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不够，如果冒失运功，小心被反噬。\n");
  if ((int)me->query("kee") < 500)
    return notify_fail("你的力气不够了，没有办法控制剑二十三的剑气走向。\n");

  if ((int)me->query_skill("yiqiforce", 1) < 100)
    return notify_fail("你的浑圆一气功级别还不够！\n");
  //        if((int)me->query_skill("特殊剑术", 1) <100)
  //                return notify_fail("你的特殊剑术经级别还不够！不能够运气自如。\n");

  skill = me->query_skill("force");
  force = me->query("max_force");
  me->add("max_force", -100);
  me->receive_damage("kee", 100);

  me->start_busy(2 + random(3));
  message_vision(HIR "
$N缓缓盘腿而坐，将体内剑气散发出来，

" HIY "一阵眩晕过后你的剑意冲壳而出弥漫向四周。

" HIW "一时间，天地间扬起一片窒息的气氛！仿佛$N能毁灭一切！刺目的光芒使众生都被定在当场！

" HIR "这正是剑圣领悟的剑系绝学————剑二十三！！！
\n"
    NOR, me);
  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    if (skill / 2 + random(skill / 2) < (int)ob[i]->query("cps") * 2) continue;

    b = (skill + force / 10 - ((int)ob[i]->query("max_force") / 10)) / 100;
    if (b > 0) {
      ob[i]->start_busy(b);
      if ((int)ob[i]->query("force") < skill * 2)
        ob[i]->start_busy(b / 2);
      tell_object(ob[i], HIW "你感到一阵窒息，眼前一片雪白什么都看不见!\n万物都静止，连血液心跳似乎都凝固了。\n" NOR);
    }
    COMBAT_D->report_status(ob[i]);
    if (userp(ob[i])) ob[i]->fight_ob(me);
    else if (!ob[i]->is_killing(me->query("id"))) ob[i]->kill_ob(me);

  }

  return 1;
}
