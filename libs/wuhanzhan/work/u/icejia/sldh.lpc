inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIC "水陆大会二号赛场" NOR);
  set("long", @LONG

水陆大会的二号战场！
LONG);

  set("exits",
    ([  //sizeof() == 4
    ]));

  set("objects",
    ([  //sizeof() == 1
    ]));

  set("alternative_die", 1);
  set("no_death", 1);
  setup();
}


int do_mark(string arg) {
  write("你想破坏这里的秩序？\n");
  return 1;
}
void alternative_die(object me) {
  object who = this_object();
  string here = (string)environment(me);
  string there = who->query_temp("wzg/from");

  message_vision("魏征对着$N叹了一口气,摇了摇头！\n", me);
  there = "/u/icejia/xiuxi";
  me->set_temp("accept", 0);
  message_vision("魏征扶着$N到了一处幽所休息。\n", me);
  me->move(there);

  if ((int)me->query("kee") < 1) me->set("kee", 0);
  if ((int)me->query("sen") < 1) me->set("sen", 0);
  if ((int)me->query("eff_sen") < 1) me->set("eff_sen", 200);
  if ((int)me->query("eff_kee") < 1) me->set("eff_kee", 200);
  message_vision("…魏征扶着$N走了过来。\n", me);
  return;
}
