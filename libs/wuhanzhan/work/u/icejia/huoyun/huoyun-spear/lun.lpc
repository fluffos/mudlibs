#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

void remove_effect(object me, object target, int amount);

int perform(object me, object target) {
  int skill_sword, skill_dodge, dodge_amount, attack_amount;

  if (me->query_skill_mapped("dodge") != "moshenbu")
    return notify_fail("你还没有施展魔神步法呢。\n");
  skill_dodge = me->query_skill("dodge");
  if (skill_dodge < 100) return notify_fail("你的轻功还不足以驾御风火轮。\n");
  if (me->query_skill_mapped("force") != "huomoforce")
    return notify_fail("风火轮必须配合火魔心法才能使用。\n");
  if (me->query("family/family_name") != "火云洞")
    return notify_fail("只有火云洞门人才能够召唤风火轮。\n");
  skill_sword = me->query_skill("force");
  if (skill_sword < 100) return notify_fail("你的火魔心法不够纯熟。\n");
  skill_sword = me->query_skill("spear");
  if (skill_sword < 100)
    return notify_fail("你的枪法太差劲了。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");

  me->add("force", -50);
  message_vision(
    HIR "$N双脚一跺，一双" NOR " " RED "风火轮 " HIR "已然踩在脚下。\n" NOR, me);

  dodge_amount = skill_dodge;
  me->add_temp("apply/dodge", dodge_amount);  //trade offense for defense.  
  me->set_temp("powerup", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect",
    me, dodge_amount, attack_amount :), skill_sword / 5);

  return 1;
}

void remove_effect(object me, int dodge_amount, int attack_amount) {
  me->add_temp("apply/dodge", -dodge_amount);
  me->delete_temp("powerup");
  message_vision(HIR "$N慢慢感到体内内力不足，" NOR " " RED "风火轮 " HIR "已经消失不见。\n" NOR, me);
}
