//sanjue.c 达摩三绝剑
//created by icejia
//特点说明：连续性攻击pfm，杀伤力随等级的提升，越来越厉害。
//但刚开始时并不是很厉害。

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage, time, myto, yourto, ft;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || target->is_corpse() || target == me)
    return notify_fail("你要对谁使用「达摩三绝剑」？\n");
  if (!me->is_fighting(target))
    return notify_fail("只能在战斗中使用「达摩三绝剑」。\n");
  if (me->query_temp("firehit_busy"))
    return notify_fail("你刚想出招，丹田却是一阵剧痛，力量根本使不出来。\n");
  if ((int)me->query_skill("xiuluo-dao", 1) < 300)
    return notify_fail("以你现在修罗刀的修为，要用是不太可能的。\n");
  if ((int)me->query_skill("riyue-bian", 1) < 300)
    return notify_fail("你的日月鞭法没学好，身体的柔韧性仍不够。\n");
  if ((int)me->query("max_force") < 5000)
    return notify_fail("开玩笑，以你现在的功力要用这招，只能在晚上做梦的时候。\n");
  if (me->query("family/family_name") != "少林寺")
    return notify_fail("“达摩三绝”只有少林寺弟子才可以用！\n");
  if ((int)me->query("force") < 5000)
    return notify_fail("你现在似乎心有余而力不足。\n");
  if ((int)me->query_skill("damo-jian", 1) < 300)
    return notify_fail("你的达摩剑修为不够，不能很好地控制力量的使用。\n");
  if ((int)me->query_skill("damo-jian", 1) > 350) ft = 1;
  if ((int)me->query_skill("damo-jian", 1) > 400) ft = 2;
  if ((int)me->query_skill("damo-jian", 1) > 450) ft = 3;
  if ((int)me->query_skill("damo-jian", 1) > 500) ft = 4;
  time = 0;
  //悲天
  damage = (int)me->query_skill(
    "damo-jian",
    1
  ) + (int)me->query_skill("xiuluo-dao", 1) + random((int)me->query("kar")) * 3;
  myto = (int)me->query("combat_exp") / 1000 + (int)me->query("combat_exp") / 1000 + random(me->query("kar") + me->query("cps"));
  yourto = (int)target->query("combat_exp") / 1000 + (int)target->query("combat_exp") / 1000;
  if (target->is_busy()) yourto = yourto / 2;
  message_vision(HIC "$N你身型幻动数个身影，迅速舞动手中长剑，脸上露出一丝伤怀。\n" NOR, me, target);
  message_vision(HIC "突然，每个身影的剑尖都指向$n,顿时漫天佛光普照。\n" NOR, me, target);
  message_vision(HIC "$N大喝一声：“看来佛都不能饶恕你！达摩三绝！！！”\n\n\n" HIR "···悲天···\n\n\n" NOR, me, target);
  message_vision(HIC "只见$N手中长剑射出万道剑气！直向$n的胸口。\n" NOR, me, target);
  if (random(myto) >= random(yourto / 5 * 3)) {
    message_vision(RED "结果$n惨叫一声，前胸已被剑气穿透，黄烟直冒！\n" NOR, me, target);
    target->receive_damage("kee", damage * ft / 2);
    target->receive_damage("sen", damage * ft / 2);
    target->receive_wound("kee", damage * ft / 2);
    target->receive_wound("sen", damage * ft / 2);
    COMBAT_D->report_status(target, 0);
    me->add("force", -200);
    time += 1;
  } else {
    message_vision(CYN "但是$n气灌双手，将$N这几拳全部挡了下来。\n" NOR, me, target);
    tell_object(target, "不过你的却感到对手内力直透心脾！\n");
    target->receive_damage("kee", 100);
    me->add("force", -300);
  }
  message_vision(HIC "$N跃至空中，一个旋身，手中剑柄带起一声嚣叫向$n扫过来。\n" NOR, me, target);
  if (random(myto) >= random(yourto / 5 * 3)) {
    message_vision(RED "$n躲避不及，被$N的剑柄扫到了脖子，只听见“嚓”的一声响。\n$n顿时觉得天旋地转。\n" NOR, me, target);
    target->receive_damage("kee", damage * ft / 4);
    target->receive_damage("sen", damage * ft / 4);
    target->receive_wound("kee", damage * ft / 4);
    COMBAT_D->report_status(target, 0);
    me->add("force", -200);
    time += 1;
  } else {
    message_vision(CYN "$n不慌不忙，运力用右臂挡住了这一击。\n" NOR, me, target);
    me->add("force", -300);
  }
  //怜地
  message_vision(
    HIR "\n\n···怜地···\n\n\n" HIY "$N脚尖点地，一声清啸，长剑上笼罩了一道旋目的佛光。\n$N将剑上光芒笼向$n！\n" NOR,
    me,
    target
  );
  if (random(myto) >= random(yourto / 5 * 3)) {
    message_vision(RED "$n躲闪不及，全身上下一共中了几十剑，惨叫不断。\n" NOR, me, target);
    target->receive_damage("kee", damage * ft / 4);
    target->receive_damage("kee", damage * ft / 4);
    target->receive_wound("kee", damage * ft / 4);
    target->receive_wound("sen", damage * ft / 4);
    COMBAT_D->report_status(target, 0);
    me->add("force", -200);
    time += 1;
  } else {
    message_vision(YEL "$n眼见$N的攻势汹汹，不敢硬拼，一连串的老驴打滚避了开去，狼狈之极。\n" NOR, me, target);
    me->add("force", -300);
  }
  if ((int)me->query_skill("damo-jian", 1) >= 500 && (int)target->query("kee") > 0) {
    message_vision(
      HIY "$N连击完毕，向后一翻长剑支地扫出一道剑气沿地面射向$n,\n" HIY "这招实在太过突然，$n躲闪不及，被剑气扫中！\n" NOR,
      me,
      target
    );
    me->add("force", -200);
    target->receive_damage("kee", damage * ft / 8);
    target->receive_damage("sen", damage * ft / 8);
    target->receive_wound("kee", damage * ft / 16);
    target->receive_wound("sen", damage * ft / 16);
    COMBAT_D->report_status(target, 0);
    time += 1;
  }
  //悯人
  if ((int)me->query_skill(
    "damo-jian",
    1
  ) >= 500 && (int)target->query("kee") > 0 && me->query_skill("xiuluo-dao", 1) >= 500) {
    message_vision(
      HIR "\n\n···悯人···\n\n\n" HIG "$N刚一站稳，缓缓将长剑横端于胸前！\n$N剑做刀使横扫向$n的咽喉！\n" NOR,
      me,
      target
    );
    if (random(myto) >= random(yourto / 5 * 3)) {
      message_vision(RED "$n躲闪不及，剑光扫中咽喉，口吐鲜血！\n" NOR, me, target);
      target->receive_damage("kee", damage * ft / 4);
      target->receive_damage("sen", damage * ft / 4);
      target->receive_wound("kee", damage * ft / 4);
      target->receive_wound("sen", damage * ft / 4);
      COMBAT_D->report_status(target, 0);
      me->add("force", -200);
      time += 1;
    }

    else {
      message_vision(GRN "$n连退数步，竭尽全力挡住了$N的攻击，不过内脏却受到震荡。\n" NOR, me, target);
      me->reveive_wound("kee", 10);
      me->receive_wound("sen", 10);
      me->add("force", -300);
      target->receive_damage("kee", 100);
      target->receive_damage("sen", 100);
      target->receive_wound("kee", 100);
      target->receive_wound("sen", 100);
      COMBAT_D->report_status(target, 0);
    }
  }
  if (present(
    "sword",
    this_player()
  ) && (int)me->query_skill("xiuluo-dao", 1) > 500 && target->query("kee") > 0) {
    message_vision(HIG "$N抓住机会，快步奔向$n，长剑抖动绕向$n的后腰大穴命门！\n" NOR, me, target);
    if (random(myto) > random(yourto / 5 * 3)) {
      message_vision(RED "结果正好点中命门大穴！！\n" NOR, me, target);
      target->receive_damage("kee", (int)me->query_skill("riyue-bian", 1));
      target->receive_damage("sen", (int)me->query_skill("riyue-bian", 1));
      target->receive_wound("kee", (int)me->query_skill("riyue-bian", 1) / 2);
      target->receive_wound("sen", (int)me->query_skill("riyue-bian", 1) / 2);
      COMBAT_D->report_status(target, 0);
      me->add("force", -200);
      time += 1;
      message_vision(HIG "$N改刺为劈，剑上笼罩着刀风！\n" NOR, me, target);
      if (random(myto) > random(yourto / 5 * 3)) {
        message_vision(RED "$n哪里想到$N变招如此快速狠毒，顿时就中了招！\n" NOR, me, target);
        target->receive_damage("kee", me->query_skill("riyue-bian", 1) / 2);
        COMBAT_D->report_status(target, 0);
      } else {
        message_vision(GRN "$n见状不秒，急忙使了个侧身，险些就躲不过去。\n" NOR, me, target);
      }
    } else {
      message_vision(GRN "但是$n使了个铁板桥，刚好躲过了这致命的攻击。\n" NOR, me, target);
      me->add("force", -300);
      message_vision(HIG "$N见状，快速抖动长剑，幻剑成鞭，卷向$n的双腿！\n" NOR, me, target);
      if (random(myto) > random(yourto / 5 * 3)) {
        message_vision(RED "$n哪里想到$N变招如此快速狠毒，顿时就中了招！\n" NOR, me, target);
        target->receive_damage("kee", me->query("str") + me->query("force_factor"));
        COMBAT_D->report_status(target, 0);
      } else {
        message_vision(GRN "$n见状不秒，抬腿就势一个后翻，生的是躲了过去。\n" NOR, me, target);
      }
    }
  }
  if ((int)me->query_skill(
    "riyue-bian",
    1
  ) > 500 && (int)target->query("kee") > 0 && me->query("force") > 400) {
    message_vision(HIG "$N将浑圆一气全部运至手中兵刃上！连人带剑向$n撞来！\n" NOR, me, target);
    time += 1;
    if (random(myto) > random(yourto / 5 * 3)) {
      message_vision(RED "结果$n没有料到$N作为僧人会使出如此决绝的招数，\n躲闪不及被撞个正着！\n" NOR, me, target);
      COMBAT_D->report_status(target, 0);
      me->receive_damage("kee", damage * ft / 2);
      me->receive_wound("kee", damage * ft / 4);
      me->set("force", 100);
    } else {
      message_vision(GRN "不过$n巧妙地躲过了这一击，没有受到任何伤害。\n" NOR, me, target);
    }
    message_vision(HIR "由于运气过度，你只觉得吼间一甜，一口鲜血喷出。\n" NOR, me, target);
    if (me->query("kee") > 400) {
      me->receive_damage("kee", 400);
      me->reveive_wound("kee", 400);
    }
    COMBAT_D->report_status(me, 0);
  }
  message_vision(GRN "$N气力不支，停下了攻击。\n" NOR, me, target);
  if (time > 7) time = 7;
  if (time < 1) time = 1;
  me->start_busy(time);
  if ((int)target->query("kee") > 0)
    tell_object(target, "好机会，趁现在赶快发动攻击！\n");
  me->set_temp("firehit_busy", 5);
  call_out("remove_effect", 10 + random(5), me);

  return 1;
}

void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("firehit_busy");
  message_vision(HIW "$N在浑圆一气的调整下，$N感觉到力量恢复了。\n" NOR, me);
}
