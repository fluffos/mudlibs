void init()
{
        object me = this_player();
        string id;;

        id=(me->parse_command_id_list())[0];

if (getuid(this_player()) != "vir"
&& getuid(this_player()) != "skyhawk"
&& getuid(this_player()) != "llpp") {
                tell_object(me, "你探头探脑的望了几眼，妄想偷溜进去！\n");
                tell_object(me, "嘟，嘟。警报响了，静悄悄叹了一口气，哎！马子多了真烦！\n");
                tell_object(me, "风雨深情的凝视着静悄悄，说道：达令，我们今天什么也不做了，让我们好好的体会一下二人世界。\n");
                me->move("/u/vir/room/droom");
                message_vision("$N被静悄悄的苍蝇拍拍了出来，狼狈不堪。\n", me);
        }
}

