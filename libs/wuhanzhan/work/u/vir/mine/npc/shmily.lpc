
//永远？永远有多远？若一切不能如我之意，永远也不过是瞬间。
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
           set_name(HIW"星砂"NOR, ({"shmily"}));
set("long",WHT"不能和心爱的人在一起，就算让我做玉皇大帝，我也不会开心．\n"NOR);
       set("gender", "女性");
set("title",BLU"痴情の的妖精"NOR);

       set("age", 16);
        set("per", 40);
set("attitude", "peaceful");
       set("shen_type", 1);


        set_skill("cat-sword", 500);
   set("chat_chance", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "hufa" :),
                (: cast_spell, "flower" :),
        }) );
        set_skill("flydance", 350);
        set_skill("dream-spells", 350);
        set_skill("dream-force", 350);
        set_skill("force", 350);
        set_skill("literate", 300);
        set_skill("spells", 350);
        set_skill("parry", 350);
        set_skill("sword", 350);
       set_skill("blade", 350);
        set_skill("xiaohun-blade", 350);
        set_skill("unarmed", 350);
        set_skill("dodge", 350);
        set_skill("dream-zhang", 350);

        map_skill("spells", "dream-spells");
       map_skill("dodge", "flydance");
        map_skill("sword", "cat-sword");
        map_skill("force", "dream-force");
       map_skill("blade", "xiaohun-blade"); 
       map_skill("parry", "cat-sword");
        set("force", 30000);
        set("max_force", 30000);
        set("force_factor", 500);
        set("max_mana", 50000);
        set("mana", 50000);
        set("mana_factor", 150);
        set("combat_exp", 400000000);
        set("chat_chance", 5);
       create_family("天上人间", 1, "蓝"); 
       set("chat_msg", ({
        WHT"星砂幽幽的叹道：我欲与君相知，长命无绝衰。山无陵，江水为竭.....\n"NOR,
  BLU"星砂轻轻的告诉你，我希望在蓝蓝的海边有个温暖的小木屋，我和我心爱的人永远生活在一起。\n"NOR,
        MAG"星砂痴痴的说，我在佛前祈求了五百年...只为了能够有天和心爱的人相守...\n"NOR,
        }) );
        setup();
        carry_object("/u/vir/obj/cloth1")->wear();
        carry_object("/u/vir/obj/sword")->wield();
     set("inquiry", ([
        "name"     : "我是星砂啊，月圆时滴落的一滴眼泪。\n",
        "here"     : "给我咨询费我就告诉你.:)\n",
             ]));
}
void die()
{
  if (environment())
    message("sound", BLU"\n\n星砂幽幽的说道:有忽然的瞬间我会想去找他，想念他纯净温暖的笑容。
想让那种流水般的感觉包围我，冲洗走一切的烦躁和不安。\n\n"NOR, environment());
   message("vision", HIB"\n星砂挥挥手，消失在星夜。。。\n"NOR,environment());


        destruct(this_object());
}


void attempt_apprentice(object ob)
{        ob=this_player();
        if( (string)ob->query("family/family_name")=="天上人间") {
        if ((int)ob->query("combat_exp") < 1500000 ) {
        command("say 你的道行还不够，" + RANK_D->query_respect(ob) + "还需多加努力。\n");
        return;
        }
            if ( !((string)ob->query("gender")=="女性")){
           command("shake");
           command("say 我们天上人间只收女徒，这位" +
RANK_D->query_respect(ob) + "还是另请高就吧。\n");
           return;
}
        if ((int)ob->query("combat_exp") < 2000000 ) {
        command("say 你的武学还不够，" + RANK_D->query_respect(ob) + "还需多加努力。\n");
        return;
        }

        if( (int)ob->query("pending/kick_out")) {
        command("say 这位" + RANK_D->query_respect(ob) + "你曾背我派，我不原再收你为徒了！\n");
        command("sigh");
        return;
        }

        if ((int)ob->query_int() < 35) {
        command("say 这位" + RANK_D->query_respect(ob) + "悟性太低，恐怕收了你也难有作为！\n");
        command("sigh");
        return;
        }
        if( (int)ob->query_skill("dream-force", 1) < 120 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "对天姬心法领会还不够深，现在收你也是勉为其难，不如作罢！\n");
        command("sigh");
        return;
        }
        if( (int)ob->query_skill("dream-spells", 1) < 120 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "对梵音圣法领会还不够深，现在收你也是勉为其难，不如作罢！\n");
        command("hmm");
        return;
        }
        if( (int)ob->query_skill("flydance", 1) < 200 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "的天水之舞还不够轻舞，现在收你也是勉为其难，不如作罢！\n");
        command("pat");
        return;
        }
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。");
        command("recruit " + ob->query("id") );
        return;
        }
        command("shake");
        command("say 妾身不收外门弟子，" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
        return;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
        ob->set("class", "dream");
}

