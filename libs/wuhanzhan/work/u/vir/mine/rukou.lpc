
// by vir

#include <room.h>
inherit ROOM;

void create()
{
        set("short", "圣女殿");
        set("long", @LONG

    空荡荡的大殿有几点火焰跳动，闪着诡异的蓝光，一幅圣女图(picture）

    悬挂在殿中，壁间挂着一根银链子，将空间分割成幽冥二界,静悄悄的。。

LONG
        );

        set("exits", ([
                "north" : "xxx",
        ]));
        set("item_desc", ([
                "picture" : "我于朔夜始逢君 如今望日天地晕\n"
                            "君问何为语神昏 请君为我耳暂倾\n",
        ]));
        setup();
}

void init()
{
        add_action("do_enter", "enter");
}

int do_enter(string arg)
{
        object me=this_player();

        if( !arg || arg=="" ) return 0;

        if ( me->query_skill("literate", 1) < 100) return 0;

        if ( arg == "picture" ) {
        tell_object(me, "你朝壁画走去。\n");
        message("vision",
                        me->name() + "轻飘飘地朝壁画走去，身影便隐没在壁画中了。\n",
                        environment(me), ({me}) );
                me->move("/u/vir/migong/migong1");
                message("vision",
                        me->name() + "从外面走了进来。\n",
                        environment(me), ({me}) );
                return 1;
        }
}

