
inherit ROOM;
void create ()
{
  set ("short", "绯樱苑");
  set ("long", @LONG

     这里是长安乐坊里面的绯樱苑  樱花开得分外艳丽.....

     樱花一片又一片      辗转飘零

     散飞的花瓣    分外的妖娆   分外的轰华绚烂

     那名仙子    渐渐被飞花拉扯的薄纱所掩    风轻撩起了她的发

     一片绯焰的花瓣飘飘荡荡的落入纤手

     卷帘............嫣然................笑语............


LONG);

  set("exits", ([ 
    "down" : "/d/city/buzhuang",
]));
  set("objects", ([ 
    "/d/obj/hudie1" : 1,
  "/d/obj/qlj/npc/vir" : 1,
]));
  set("no_fight", 1);
  set("no_magic", 1);
  setup();

}

int valid_leave(object me, string dir)
{object card;
        if( card = me->query_temp("card_ob") ) {
                tell_object(me, "你将鲜花预定卡交回给蝴蝶仙子。\n");
                destruct(card);
        }

        return ::valid_leave(me, dir);
}


void init()
{
        object me = this_object();

 if (!wizardp(this_player()) && this_player()->query_condition("no_pk_time"))
   {
    this_player()->move("/d/city/buzhuang");
   }
  }


