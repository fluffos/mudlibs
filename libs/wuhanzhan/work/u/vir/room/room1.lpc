//我不是你的天使

#include <ansi.h>
inherit ROOM;
string miaoshu = "\n    我不是你的天使     我不懂你的天堂
\n    这时天空要下雨  我们笑得很勉强  无言以对的路上 
\n  没有太多惆怅     像是最后的游荡     把淋湿的风欣赏遗忘最初的信仰 
\n     天使         看清你的模样     爱就爱        不要逞强
\n 不过是 美梦一场    我不是天使    只是美梦一场     因为不是你的天使
\n  太多的星光都和你分享   给自己留一个晚上没有爱   又会怎样 ?
\n  谁都要      孤独收场        我最后一次站在你的身旁   \n\n";
string love = "\n                             藏起天使的翅膀 我不是你的天使 \n\n";

string *crs = ({
  HIW + miaoshu + NOR,
  HIB + miaoshu + NOR,
  MAG + miaoshu + NOR,
  BLU + miaoshu + NOR,
});

string *finger = ({
  BLINK + HIW + love + NOR,
  BLINK + HIB + love + NOR,
  BLINK + BLU + love + NOR,
  BLINK + MAG + love + NOR,
});


void create() {
  set("short", WHT "情有千千结" NOR);
  set("long", crs[random(sizeof(crs))] + finger[random(sizeof(finger))]);

  set("item_desc", ([ /* sizeof() == 1 */
    "LETTER": "
　　　　我最爱的air：

    认识你之后的心情如阳光般明媚，滋润着一颗从没有被滋润的心。
　　你回眸一笑，我的心便仿佛寻到了知音，我认定你就是我一辈子
要找的那个人。伴随着你的背影，我的心就远离我而去。
　　每一天，我都静静期待着你的到来，如等待甘霖的土地。可是不管
是日出还是日落，等待的总是如柳絮、如浮萍。
　　可是，你还是你，我还是我，却总也不是我们。
    迷蒙中你飘然来到我的身边，清秀脱俗的气质如九天仙子下凡尘。
我轻轻的揽着你，骑上青牛，一同游览飘渺仙境。你的双手楼住我，伴着
扑面吹来的清芬。
　　我久久回味....
    “我爱你！我等你”，我鼓足勇气向你说起，也等待你的回音。

                       爱你的lorn


",
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "out": "/u/vir/workroom",
    "o": "/u/lol/room/hanxiu",
  ]));

  set("sleep_room", 1);
  set("if_bed", 1);

  set("objects",
    ([  //sizeof() == 1
    "/u/vir/npc/lorn": 1,
    ]));

  setup();
}
