
#include <ansi.h>
inherit NPC;

void create()
{
           set_name(WHT"小秀秀"NOR, ({"l ol"}));
set("long",HIM"别看我 还看？! 再看..我就吃掉你的!!\n"NOR);
set("title",HIG"很爱很爱洗澡"NOR);
       set("gender", "男性");
       set("age", 24);
        set("per", 30);
set("attitude", "peaceful");
       set("shen_type", 1);


  create_family("陷空山无底洞", 2, "弟子");
       set("combat_exp", 20000000);
       set("daoxing", 10000000);
    set("env/wimpy", random(60));
        set("chat_chance", 6);
        set("chat_msg", ({
                "小秀秀用刀架在自己脖子上道：“你们别过来……，过来我就自杀……”\n",   
//                "果冻长叹一声：酒醒寒夜时，独徘黄昏处。年少伤心事，只恐无人知。\n",   
                "小秀秀晃了晃手中的棒冰。”\n",   
        }) );


        set_skill("kugu-blade", 500);
        set_skill("yaofa", 500);
        set_skill("huntian-qigong", 500);
        set_skill("force", 500);
        set_skill("spells", 500);
        set_skill("parry", 500);
        set_skill("blade", 500);

        map_skill("spells", "yaofa");
        map_skill("blade", "kugu-blade");
       map_skill("dodge", "kugu-blade");
        map_skill("force", "huntian-qigong");
       map_skill("parry", "kugu-blade");
        set("force", 30000);
        set("max_force", 30000);
        set("force_factor", 0);
        set("max_mana", 20000);
        set("mana", 20000);
        set("mana_factor", 10000);
   set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
    (: perform_action, "blade.diyu" :),
    (: perform_action, "blade.pozhan" :),
        }) );

        setup();
        carry_object("/d/obj/flower/flower")->wear();
        add_money("gold", 500);
}

void init()
{
  ::init();
  remove_call_out ("messaging");
  call_out ("messaging",1+random(5),this_object());
}

void messaging (object who)
{
  if (random(2))
    command("lure a yani");
  else
    command("momo v ir");


}

