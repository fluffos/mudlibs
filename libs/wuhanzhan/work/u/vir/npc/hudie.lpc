//人间的花精灵

#define DEBUG 0
inherit NPC;
string send_mail();
string receive_mail();
void create() {
  set_name("蝴蝶", ({ "hu die" }));
  set("title", "花仙子");
  set("gender", "女性");
  set("age", 13);
  set("long", "一个胖嘟嘟的小仙子，每天在花店里面摆弄这些美丽的花儿。\n");
  set("combat_exp", 2000);
  set("attitude", "friendly");
  set_skill("dodge", 10);
  set("per", 30);
  set("max_kee", 150);
  set("max_gin", 150);
  set("max_sen", 150);
  set("inquiry", ([
    "name": "我就是花仙子呀，你想送花儿给谁？",
    "天宫": "那里是个是个美丽的地方.....",
    "here": "这里？这里是你给你心爱的人祝福的地方呀！",
    "将来": "嘻嘻，我....我要....，才不要告诉你呢！！！",
    "节日": "节日要给心爱的人送花的，你不知道吗？",
    "送花": (: send_mail :),
    "花篮": (: receive_mail :),
    "花": (: receive_mail :),
  ]));
  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/u/vir/obj/sflower.lpc");
}

string send_mail() {
  object mbox;

  if (this_player()->query_temp("card_ob"))
    return "我已经把花卡给过你了，你再仔细看看你身上吗好吗？\n";
  seteuid(getuid());
  mbox = new("/d/obj/card");
  mbox->move(this_player());
  return "好吧，给你一张花卡，好好填吧，填完了我就给你送。\n";
}

string receive_mail() {
  object mbox;

  if (this_player()->query_temp("basket_ob"))
    return "你的花篮还耶，不用再问我要了。\n";
  seteuid(getuid());
  mbox = new("/d/obj/flowerl");
  mbox->move(this_player());
  return "嘻嘻，你的花篮在这里，好好看看都有哪些祝福吧！\n";
}


int accept_object(object me, object ob) {
  if (((string)ob->query("id") != "xue lian")) {
    command("wa");
    tell_object(me, "蝴蝶在你耳边悄悄的说： “嘻嘻，谢谢你。这个小东西我用不着，你还是给别人吧。”\n");
    return 0;
  } else {
    command("wink " + me->query("id"));
    command("xixi");
    command("say “这位" + RANK_D->query_respect(me) + "真的谢谢你！”");
    command("think");
    command("say “好吧，我就把这个送给你，记住了，一定要送给需要的人呀！”");
    command("give star to " + me->query("id"));
    return 1;
  }
}


