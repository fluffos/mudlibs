inherit NPC;
#include <ansi.h>

string *msg = ({
  "为了更好的为大家服务请您使用(pass)对密码进行加密。\n",
  "对玩家最近上不了mud，深感歉意。 官方大话西游不会关闭，请大家相互不要猜疑\n",
  "如果有什么最新消息，请看Yifan的QQ 资料.最新信息将会在里面找到 QQ:13442212\n",
  "如果玩家长期上不了线，请连接 dhxy.gotoyinko.com 8888 or dhxy.freeQQ.com:8888 此域名永久有效\n",
  "祝你在新的一年里：事业正当午，身体壮如虎，金钱不胜数，干活不辛苦，悠闲像老鼠，浪漫似乐谱，快乐非你莫属。\n",
  "由于PK现象严重的影响了武汉站的发展 所以决定禁止pk一段时间 具体请news 80!\n",
  "武汉站大话西游论坛恢复运行。地址：http://www.gotoyinko.com/dhxy \n",
});
void create() {
  set_name("小小新闻员", ({ "NEW" }));
  set("gender", "女性");
  set("age", 21);
  set("title", HIM "大话西游" NOR);
  set("long", "一个机灵活泼的女孩，负责大话西游武汉站的新闻发布。\n");
  set("combat_exp", 20000);
  set("attitude", "friendly");
  set_skill("dodge", 30);
  set("per", 25);
  set("max_kee", 100000);
  set("kee", 100000);
  set("sen", 100000);
  set("max_sen", 100000);
  setup();
  remove_call_out("msg");
  call_out("msg", 300);
}
void msg() {
  command_function("chat  " + HIW + HBMAG + msg[random(sizeof(msg))] + NOR);

  remove_call_out("msg");
  call_out("msg", 600);

}
