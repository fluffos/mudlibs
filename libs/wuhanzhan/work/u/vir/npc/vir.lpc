#include <ansi.h>
inherit NPC;

void create() {
  set_name(WHT "静悄悄" NOR, ({ "v ir" }));
  set("long", HIM "我~要~我~们~在一~起~~~~~\n" NOR);
  set("gender", "女性");
  set("title", HIG "月上柳梢 静悄悄" NOR);

  set("age", 20);
  set("per", 20);
  set("attitude", "peaceful");
  set("shen_type", 1);


  set_skill("snowsword", 500);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "shiyue" :),
    (: cast_spell, "arrow" :),
  }));
  set_skill("moondance", 500);
  set_skill("moonshentong", 500);
  set_skill("moonforce", 500);
  set_skill("force", 500);
  set_skill("spells", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);

  map_skill("force", "moonforce");
  map_skill("parry", "snowsword");
  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  set("force", 30000);
  set("max_force", 30000);
  set("force_factor", 0);
  set("max_mana", 30000);
  set("mana", 30000);
  set("mana_factor", 150);
  create_family("月宫", 2, "弟子");
  set("combat_exp", 20000000);
  set("daoxing", 10000000);
  set("env/wimpy", random(60));
  set("chat_chance", 5);
  set("chat_msg", ({
    //                "纤衣幽幽的说着：从未想过你我会这样结束，心中如此难过...．．．\n",   
    //                "纤衣轻轻说道：曾经有一份真挚的感情放在我的面前，但那时我不懂得去珍惜，现在说后悔已经太晚了……\n",   
  }));
  setup();
  carry_object("/d/obj/flower/flower")->wear();
}

void init() {
  ::init();
  remove_call_out("messaging");
  call_out("messaging", 1 + random(5), this_object());
}

void messaging(object who) {
  if (random(2))
    command("cat a yani");
  else
    command("kiss a yani");


}
