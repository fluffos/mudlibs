#include <ansi.h>
inherit ITEM;
void create() {
  set_name("菜单", ({ "menu" }));
  set("long",
    "\t\t" + HIB "斑 蝶  酒  吧 \n" NOR +
    "\t糖醋排骨(tcpg)\t红烧里脊(hslj)\n" +
    HIW "\t每份5gold，物美价廉，任君选择(order)\n" + HIC "\t       祝您吃得满意，玩得高兴。\n" NOR
    + "酒类：\t五粮液(wly)\n"
    +HIM "请您注意：过量饮酒有害健康！ 买单( order bill )\n" NOR
  );
  set("unit", "张");
  set("value", 1);
}
