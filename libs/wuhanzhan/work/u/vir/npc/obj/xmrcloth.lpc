
#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name(HIG"蝶衣"NOR, ({ "cloth", "hudie cloth" }) );
        set("long", "一件白色的短纱裙，群角绣着几只蓝蝴蝶。\n");
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "skirt");
                set("armor_prop/armor", 1);
//:                set("armor_prop/spells", 50);
//                set("armor_prop/dodge", 20);
                set("value", 1);
        }
        setup();
}

