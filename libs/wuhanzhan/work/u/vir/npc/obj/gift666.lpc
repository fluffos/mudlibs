#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "你手里一松，礼物从指间滑落！\n");
    set("no_give", "这么珍贵的礼物，哪能随便给人？\n");
    set("no_drop", "这么宝贵的礼物，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  if (this_player() == environment())
    add_action("do_eat", "eat");
}

void create() {
  set_name(HIB "跳跳" + HIM "糖" NOR, ({ "gift", "tang" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是静悄悄给大家准备的周末礼物，它看起来五彩缤纷。\n");
    set("value", 0);
    set("drug_type", "补品");
  }
  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  if (arg != "tang" && arg != "gift")
    return notify_fail("你要吃什么？\n");
  //    if(me->query("2002_1"))
  //    return notify_fail("吃多了当心消化不良！\n");
  me->set("water", me->max_water_capacity());
  me->set("food", me->max_food_capacity());
  me->add("max_mana", 18);
  me->add("max_force", 18);
  me->add("potential", 8888);
  me->add("combat_exp", 8888);
  //    me->set("2002_1","get");
  message_vision(HIG "$N小心翼翼的将跳跳糖含在嘴中弹跳，兴奋得满脸通红！\n" NOR, me);
  destruct(this_object());
  return 1;
}



void owner_is_killed()

{
  destruct(this_object());
}
