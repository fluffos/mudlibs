
#include <ansi.h>
inherit NPC;

string ask_for_present();

void create()
{
    set_name(HIW"静悄悄"NOR, ({ "jing qiaoqiao", "lady" }) );
        set("title", HIM"周末大派送"NOR);
        set("gender", "女性" );

        set("age", 20);
        set("per", 23);
        set("str", 100);
        set("con", 100);
        set("int", 100);
         
        set("long",
                "一个笑容可掬的女孩，手里拿着五彩缤纷的盒子，正笑嘻嘻的看着你呢！\n"
                "她正在那里发红包，看来你可以向她要。(ask man about 喜多多)\n" );

        set("combat_exp", 8000000);
        set("attitude", "friendly");
        
        set("inquiry", ([
                
                "喜多多"   : (: ask_for_present :),
        ]) );

        set("qi", 5000);
        set("max_qi", 5000);
        set("jing", 5000);
        set("max_jing", 5000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali",300);

        set_skill("dodge", 500);
        set_skill("unarmed", 500);
        set_skill("parry", 500);
        set_skill("force",500);
        set_skill("literate",500);
        set_skill("stick", 500);

       setup();

       carry_object("/u/vir/obj/cloth1")->wear();
       carry_object("/u/vir/obj/neck1")->wear();
       carry_object("/u/vir/obj/hat1")->wear();
}

void init()
{
        object ob;

        ::init();

        if( interactive(ob=this_player()) && !is_fighting())
        {
                remove_call_out("greeting");
                call_out("greeting",1,ob);
        }
}


void greeting(object ob)
{
        if(!ob || environment(ob)!=environment()) return;

      command("say 欢乐大派送，疯狂周末，喜多多哦！！\n");
}

string ask_for_present()
{ 
mapping *holiday= ({
                     
                  ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Jan",
                      "week":              "Sat",                    
                  ]),

                  ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Feb",
                      "week":              "Sat",                    
                  ]),
                  
                  ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Mar",
                      "week":              "Sat",                    
                  ]),

                   ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Apr",
                      "week":              "Sat",                    
                  ]),

                   ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "May",
                      "week":              "Sat",                    
                  ]),

                   ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Jun",
                      "week":              "Sat",                    
                  ]),

                    ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Jul",
                      "week":              "Sat",                    
                  ]),

                    ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Aug",
                      "week":              "Sat",                    
                  ]),
                     
                    ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Sep",
                      "week":              "Sat",                    
                  ]),
           
                    ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Oct",
                      "week":              "Sat",                    
                  ]),            

                    ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Nov",
                      "week":              "Sat",                    
                  ]),
       
                     ([
                      "name":             HIG"疯狂周末"NOR,
                      "year":             "2002",
                      "month":            "Dec",
                      "week":              "Sat",                    
                  ]),
        
                  });
    object me,ob;
    mapping skl, today;
    string *sname;
    int i,how=0,what_day=100;
    string week, month, year, day, time;
    string check;
    
    sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
   if(day=="")
    sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time,year);

    for(i=0;i<sizeof(holiday);i++)
      {  today = holiday[i];
         if(today["year"]!="either")
 if(year==today["year"]&&month==today["month"]&&day==today["week"])
               what_day=i;
            else if(month==today["month"]&&week==today["week"])
               what_day=i;
      }
    if(what_day==100)
      return "今天好象不是周末耶！\n";
    
    me = this_player();

    if ((int)me->query("combat_exp") <100000 || (int)me->query("mud_age")<7200)
        return "嘿嘿，想用新玩家来骗我，没门！。\n";
      
    if ((int)me->query("combat_exp") >=100000 ) 
         {
                
            skl = me->query_skills();
      if(skl) sname  = keys(skl);
            for(i=0; i<sizeof(skl); i++)
                   if (skl[sname[i]] >= 10)how=how+1; 
                          if(how<3)
                            return "心急什么啊？再去待一会儿！。\n";
        
          } 
     today = holiday[what_day];   

     check=year+today["name"];
     
     me->set("lady_gift4.29",check);
       return "每个人一份，不要这么贪心好不好！\n";

     ob = new("/u/vir/npc/obj/gift666");
     ob->move(me);
     ob->set("owner",me->query("id"));

     me->set("lady_gift4.29",check);
     me->delete("lady_gift4.5",check);
     return today["name"]+"HAPPY！\n"+"静悄悄给"+me->query("name")+"一把"+HIM"跳跳糖"NOR+"。\n";
}

