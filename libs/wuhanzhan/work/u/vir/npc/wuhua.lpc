
inherit NPC;

void create()
{
  set_name("无花", ({"wu hua", "wuhua", "heshang"}));
  set ("long", "传说中的高雅和尚。\n");
  set("title", "杀人不见血");
  set("gender", "男性");
  set("age", 23);
  set("per", 30);
  set("combat_exp", 100000);

  set_skill("blade", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);
  set_skill("unarmed", 20);
  set_skill("force", 20);
  set("max_sen", 500);
  set("max_kee", 500);
  set("max_force", 500);
  set("force", 100);
  set("force_factor", 4);
  setup();
 
  carry_object("/d/nanhai/obj/sengpao")->wear();
}

int accept_object (object who, object ob)
{
  object me = this_object();

  if (ob->query("id") != "jin bi")
    return 0;

  remove_call_out ("telling");
  call_out ("telling",1,me,who,ob);
  message_vision ("$N拿着$n慈悲的叹了口气，钱财乃身外之物，你也不用太难过了。\n",me,ob);
  command ("snicker");
  who->set_temp("want_left",1);
  return 1;
}

