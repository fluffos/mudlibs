//最后写了个闲逸 这个名字比较淡雅 
#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIW "闲逸" NOR, ({ "xian yi" }));
  set("long", HIW "爱谁你是对还是错....\n" NOR);
  set("title", BLU "眉尖心上 无计可消" NOR);
  set("gender", "男性");
  set("age", 26);
  set("per", 30);
  set("attitude", "peaceful");
  set("shen_type", 1);


  create_family("陷空山无底洞", 2, "弟子");
  set("combat_exp", 20000000);
  set("env/wimpy", random(60));
  set("chat_chance", 6);
  set("chat_msg", ({
    //                "闲逸一脸严肃的说道：“人是人他妈生的，妖是妖他妈生的，妖只要有仁慈的心，就不再是妖，而是人妖。”\n",   
  }));


  set_skill("kugu-blade", 500);
  set_skill("yaofa", 500);
  set_skill("huntian-qigong", 500);
  set_skill("force", 500);
  set_skill("spells", 500);
  set_skill("parry", 500);
  set_skill("blade", 500);

  map_skill("spells", "yaofa");
  map_skill("blade", "kugu-blade");
  map_skill("dodge", "kugu-blade");
  map_skill("force", "huntian-qigong");
  map_skill("parry", "kugu-blade");
  set("force", 30000);
  set("max_force", 30000);
  set("force_factor", 0);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 10000);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "blade.diyu" :),
    (: perform_action, "blade.pozhan" :),
  }));

  setup();
  carry_object("/u/vir/obj/cloth2")->wear();
  carry_object("/u/vir/obj/neck2")->wear();
  carry_object("/u/vir/obj/iceblade")->wield();
  add_money("gold", 5000);
}

void init() {
  ::init();
  remove_call_out("messaging");
  call_out("messaging", 1 + random(5), this_object());
}

void messaging(object who) {
  if (random(2))
    command("hug vir");
  else
    command("kiss2 vir");


}
