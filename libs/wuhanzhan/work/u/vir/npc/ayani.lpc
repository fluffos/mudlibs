
#include <ansi.h>
inherit NPC;

void create()
{
           set_name(WHT"阿雅妮"NOR, ({"a yani"}));
set("long",HIM"我要我们在一起\n"NOR);
       set("gender", "女性");
set("title",HIG"双眼皮の鬼"NOR);

       set("age", 21);
        set("per", 20);
set("attitude", "peaceful");
       set("shen_type", 1);


        set_skill("kugu-blade", 500);
   set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "huanying" :),
                (: cast_spell, "yaomo" :),
        }) );
        set_skill("huntian-qigong", 500);
        set_skill("yaofa", 500);
        set_skill("dodge", 500);
        set_skill("force", 500);
        set_skill("spells", 500);
        set_skill("parry", 500);
        set_skill("blade", 500);

        map_skill("force", "huntian-qigong");
        map_skill("parry", "kugu-blade");
        map_skill("spells", "yaofa");
       map_skill("dodge", "yaofa");
        set("force", 30000);
        set("max_force", 30000);
        set("force_factor", 0);
        set("max_mana", 30000);
        set("mana", 30000);
        set("mana_factor", 150);
        create_family("月宫", 2, "弟子");
       set("combat_exp", 20000000);
      set("daoxing", 10000000);
    set("env/wimpy", random(60));
        set("chat_chance", 5);
        set("chat_msg", ({
                "阿雅妮痴痴的望着门外飘落的雪花，自言自语道：他怎么还不给我回信呢．．．\n",   
        }) );
        setup();
        carry_object("/d/obj/flower/flower")->wear();
}

void init()
{
  ::init();
  remove_call_out ("messaging");
  call_out ("messaging",1+random(5),this_object());
}

void messaging (object who)
{
  if (random(2))
    command("bao v ir");
  else
    command("kiss lol");


}

