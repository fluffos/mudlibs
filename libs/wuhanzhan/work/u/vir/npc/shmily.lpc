#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIW "星砂" NOR, ({ "shmily" }));
  set("long", WHT "不能和心爱的人在一起，就算让我做玉皇大帝，我也不会开心．\n" NOR);
  set("gender", "女性");
  set("title", BLU "痴情の的妖精" NOR);

  set("age", 16);
  set("per", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);


  set_skill("snowsword", 500);
  set("chat_chance", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "mihun" :),
    (: cast_spell, "shiyue" :),
  }));
  set_skill("moondance", 500);
  set_skill("moonshentong", 500);
  set_skill("moonforce", 500);
  set_skill("force", 500);
  set_skill("spells", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);

  map_skill("spells", "moonshentong");
  map_skill("dodge", "moondance");
  map_skill("sword", "snowsword");
  map_skill("force", "moonforce");
  map_skill("parry", "snowsword");
  set("force", 30000);
  set("max_force", 30000);
  set("force_factor", 500);
  set("max_mana", 50000);
  set("mana", 50000);
  set("mana_factor", 150);
  create_family("月宫", 3, "弟子");
  set("combat_exp", 400000000);
  set("daoxing", 10000000);
  //    set("env/wimpy", random(100));
  set("chat_chance", 5);
  set("chat_msg", ({
    WHT "星砂幽幽的叹道：我欲与君相知，长命无绝衰。山无陵，江水为竭.....\n" NOR,
    BLU "星砂轻轻的告诉你，我希望在蓝蓝的海边有个温暖的小木屋，我和我心爱的人永远生活在一起。\n" NOR,
    MAG "星砂痴痴的说，我在佛前祈求了五百年...只为了能够有天和心爱的人相守...\n" NOR,
  }));
  setup();
  carry_object("/u/vir/obj/cloth1")->wear();
  carry_object("/u/vir/obj/ring")->wear();
  //        carry_object("/u/vir/obj/sword")->wield();
  //        add_money("gold", 5000);
}

void die() {
  if (environment())
    message("sound", BLU "\n\n星砂幽幽的说道:有忽然的瞬间我会想去找他，想念他纯净温暖的笑容。
想让那种流水般的感觉包围我，冲洗走一切的烦躁和不安。\n\n" NOR, environment());
  message("vision", HIB "\n星砂挥挥手，消失在星夜。。。\n" NOR, environment());

  set("eff_kee", 8000);
  set("eff_gin", 8000);
  set("eff_sen", 8000);
  set("kee", 8000);
  set("gin", 8000);
  set("sen", 8000);
  set("force", 8000);
  set("mana", 8000);

  destruct(this_object());
}
