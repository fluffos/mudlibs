#include <ansi.h>
#include <armor.h>
inherit BOOTS;
void create() {
  set_name(HIY "战神靴" NOR, ({ "zhanshen boots", "boots" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "gold");
    set("unit", "双");
    set("value", 200000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("armor_prop/armor", 100);
  }
  setup();
}
int query_autoload() { return 1; }
void owner_is_killed() {
  destruct(this_object());
}
