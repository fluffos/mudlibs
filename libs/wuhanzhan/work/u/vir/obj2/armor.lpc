#include <ansi.h>
#include <armor.h>
inherit ARMOR;
void create()
{
  set_name(HIC "战神盔甲" NOR, ({"zhanshen armor", "jia"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "steel");
                set("value", 200000);
               set("no_sell", 1);
               set("no_drop", 1);
                set("armor_prop/armor", 115);
        }
        setup();
}
int query_autoload() { return 1; }
void owner_is_killed() 

{
destruct(this_object());
}

