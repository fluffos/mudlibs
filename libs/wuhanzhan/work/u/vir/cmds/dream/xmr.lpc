//黯然销魂刀 air 专给lorn 的。。

#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail(HIW "你要对谁施展这一招" HIW "「" MAG "紫焰蝴蝶" HIW "」" HIW "？\n" NOR);

  if (!me->is_fighting())
    return notify_fail("" HIW "「" MAG "紫焰蝴蝶" HIW + HIW "」只能在战
斗中使用！\n" NOR);

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_temp("xmr"))
    return notify_fail(HIW "你这一刀意还没有完全消失,不能再使用。\n" NOR);

  if ((int)me->query("max_force") < 1000)
    return notify_fail(YEL "你的内力火候还不行！\n" NOR);

  if ((int)me->query("force") < 500)
    return notify_fail(YEL "你的内力不足！\n" NOR);

  if ((int)me->query("kee") < 500)
    return notify_fail(YEL "你的气血不足，没法子施用外功！\n" NOR);

  if ((int)me->query("sen") < 500)
    return notify_fail(YEL "你的精神不足，没法子施用外功！\n" NOR);

  if ((int)me->query_skill("xiaohun-blade", 1) < 200)
    return notify_fail("你的销魂刀级别还不够，使用不出来紫焰蝴蝶的
销魂毒辣！\n");
  if (me->query_temp("last_xmr") + 8 > time())
    return notify_fail(WHT "紫焰蝴蝶" NOR + CYN "很消耗心力,air劝你歇歇再出。
\n" NOR);

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  if (!present(target, environment(me))) return 1;
  message_vision(BMAG + HIW "\n$N一声清啸，气凝刀尖直指$n，催出一股紫蓝火焰，无祷的气劲向$n胸前袭来，
一股催魂动魄音爆，如琏漪般扩张迸射向$n胸前！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(BBLU + HIW "\n璀珣光芒经$N刀掌催劲遥控，骤间爆发丝丝紫蓝光焰，就像烟火般瑰丽，隐约闪烁着只只蝴蝶翻飞，
$n双眼闪烁一股迷茫，但却在忘情忘我中，厢厢凝望著$N随蝶而舞！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->set_temp("xmr", 1);
  call_out("remove_xmr", 3, me);
  me->start_busy(1);
  target->start_busy(1);
  me->set_temp("no_move", 1);
  call_out("remove_no_move", 3, me);
  remove_call_out("perform");
  call_out("perform2", 3, me, target);
  return 1;
}

int perform2(object me, object target) {
  object weapon;
  if (!living(target) || !target || environment(me)->query("no_fight")
  ) {
    message_vision(CYN "$N的对手已经为之陶然情醉,你不需要再来使用紫焰蝴蝶了!\n
" NOR, me);
    return 1;
  }
  if (environment(target) != environment(me)) {
    tell_object(me, BLINK + HIR "你的对手已经不在这里了。\n" NOR);
    return 1;
  }
  if ((int)me->query("force", 1) < 200)
    return notify_fail("你发现自己心力已经不能凝聚,无法再出招！\
n");
  message_vision(BMAG + HIW "\n$N面含一丝远尘优雅的微笑，纤细的五指随刀频频轻拍而出，化成紫蓝光芒，蝶印上$n左胸\n" NOR, me, target);
  message_vision(BLINK + HIW "\n\t\t\t\t紫\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(BBLU + HIW "\n$N妩媚一笑，身法蜿蜒如龙行云，翩翩蝶舞回绕室内，姿态优美飘至$n身前
长袖一分，忽尔爆开无数光芒激射而出，万只娇艳的蝴蝶灿烂缤纷的密密围绕$n上下翻飞！\n" NOR, me, target);
  message_vision(BLINK + HIW "\n\t\t\t\t焰\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(BMAG + HIW "\n$N真气凝注,人刀合一，火焰般的紫蓝光华大炽，气势夺人神魄，翻浪般直袭$N,
刀光中一只清晰的蝴蝶妖艳凄异，$n浑身一震，也惊醒回神！\n" NOR, me, target);
  message_vision(BLINK + HIW "\n\t\t\t\t蝴\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(BBLU + HIW "\n$N於朦胧紫蓝光焰中虚劈而出，彷佛魔法变幻般，在身前盈尺处凝化成一柱紫焰光束直袭$n，
$n骇芒的望着似真似幻的刀芒，感觉漫天飞舞的赤艳色蝴蝶中一股如丝幽寒细透来，缠住了整个心脏，喘不过气来……！\n" NOR, me, target);
  message_vision(BLINK + HIW "\n\t\t\t\t蝶\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->start_busy(1 + random(2));
  me->receive_damage("kee", 50);
  me->receive_damage("sen", 50);
  target->start_busy(1 + random(2));
  me->delete_temp("xmr");
  me->set_temp("last_xmr", time());
  return 1;
}
void remove_no_move(object me) {
  if (me) me->delete_temp("no_move");
}
void remove_xmr(object me) {
  if (me) me->delete_temp("xmr");
}
