int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me) {
  if ((string)me->query_skill_mapped("force") != "dream-force")
    return notify_fail("你的天姬心法为尚浅，没法学寞寞情长剑！\n");
  if ((int)me->query_skill("flydance", 1) < 80)
    return notify_fail("你的天水之舞修为尚浅，没法学寞寞情长剑！\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)(weapon->query("skill_type")) != "sword")
    return notify_fail("你想起手中无剑，怎么练寞寞情长剑呢？\n");
  if ((string)me->query_skill_mapped("force") != "dream-force")
    return notify_fail("寞寞情长剑法必须配合天上人间的天姬心法才能练。\n");
  if ((int)(me->query("kee")) < 50)
    return notify_fail("你已经精疲力竭，没法儿练下去啦！\n");
  me->receive_damage("kee", 30);
  write(MAG "你的寞寞情长剑提高了!:)\n" NOR);
  return 1;
}
void skill_improved(object me) {
  if ((int)me->query_skill("cat-sword", 1) % 10 == 0) {
    tell_object(me,
      RED "\n你突然觉得一股怨恨冲上心头，只觉得想杀人泻愤....\n\n" NOR);
    me->add("bellicosity", 50);
  }
}

string perform_action_file(string action) {
  return CLASS_D("dream") + "/cat-sword/" + action;
}
