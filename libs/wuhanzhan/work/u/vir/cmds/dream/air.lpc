
//cat-jian by air   星砂。。。
//带着你给我的曾经...让我在天堂里拥抱永远....

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        if(me->query("family/family_name")!="天上人间")
                return notify_fail("你不是天上人间的，不会此绝技！\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                        return notify_fail("你使用的武器不对。\n");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIW"［寂寞似雪］只能情怨最深时使用。\n"NOR);
        extra = (int)me->query_skill("cat-sword",1)+target->query("max_kee")/5;
        if(extra < 150 ) return notify_fail("你的［寞寞情长剑］不够熟练！\n");
        if((int)me->query_skill("sword",1)<150 ) return notify_fail("你的［基本剑法］不够熟练！\n");
        msg = HIW "\n$N在雪花的最深处挥开长长的水袖，浴着那最最最纤细的雪花融飞舞，点点银光划向$n！" NOR;
        if(random((int)me->query("combat_exp")) >= (int)target->query("combat_exp")/3)
        {
        message_vision(msg+"\n",me,target);
        message_vision( HIC "白金的光在暗夜流动,漫天华舞的雪瓣点点凝聚，丝丝缕缕的阴冷幽幽噬住了$N痴痴盼雪的心.\n" NOR,target);
        target->receive_wound("kee",extra);
        target->receive_damage("kee",extra*2);
                    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->receive_heal("kee",extra);
    target->start_busy(2);
        }       
        else{
        msg += CYN "可是$p不为$P的幻舞所惑，大袖一挥，挥散了漫天雪影！\n" NOR;
        }
        message_vision(msg, me, target);
        msg = HIW "\n$N在翩飞的雪瓣中妖妖幻幻地轻舞飞旋着，忽地已至$n身，冰冰碧碧细细透透的剑直指向$n." NOR;
        if(random((int)me->query("combat_exp")) >= (int)target->query("combat_exp")/2)
        {
        message_vision(msg+"\n",me,target);
        message_vision( HIC "$N心里忽然觉得一片冰冷的寒意, 一抹新血溅起，似绯樱点点漫天而飘！\n" NOR,target);
        target->receive_wound("sen",extra);
                    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->receive_heal("sen",extra);
        }       
        else{
        msg += CYN "可是$p不为$P的幻舞所惑，连退几步，避开了这清冷的一剑！\n" NOR;
        }
        message_vision(msg, me, target);
        msg = HIW "\n$N如流水似惺惺倦倦艳艳曼曼的回眸轻旋，盛放出辉煌的一瞬-------寂寞似雪-------" NOR;
        if(random((int)me->query("combat_exp")) >= (int)target->query("combat_exp")*2)
        {
        message_vision(msg+"\n",me,target);
        message_vision( HIB "$N眼前忽然幻闪出几瓣残樱，然后才是极至的炽烈痛感，心，碎了..\n" NOR,target);
        target->receive_wound("kee",extra*2);
                    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->receive_heal("kee",extra*2);
    target->start_busy(2);
        }       
        else{
        msg += CYN "可是$p不为$P的清艳所惑，双眼一闭，出人意料的险险滑开了..!\n" NOR;
        }
        message_vision(msg, me, target);
        me->start_busy(1+random(3));
        return 1;
}

