// air ....轻舞入梦

inherit SKILL;

string *dodge_msg = ({
  "$n长袖飞舞，暗香淡淡，步法回旋之际似乎娇柔无力，却将$N攻势一一化于无形。\n",
  "只见$n裙袖飞扬，忽然回眸一笑。$N一楞之下，哪里还有人在。\n",
  "可是$n妩媚一笑，不退反进，身形径向$N飘来。\n$N只觉一股异香扑鼻，这一招竟无着力之处。\n",
  "$n随风旋舞，化成一团清影与其足下银亮月影幻出斑驳月影。$N眼一花，哪里分得出是人，是影。\n",
  "$n裙裾飘飘，异香大炽，枭枭身影刺穿漫天飞舞，已然欺进$N身前，这天地融浑为一的艳丽，为宇宙星海中心之感，$N不由得看呆了！\n",
  "$n嫣然一笑，舞姿凌风，身子便如在水面上飘浮一般掠过，不等$N劲风袭到，已悄然隐去。\n",
  "$n纤腰微颤，凌空虚踩，轻轻将$N的劲力拨在一旁，尽数溶解。\n",

});

int valid_enable(string usage) { return (usage == "dodge"); }

int valid_learn(object me) {
  if ((string)me->query("gender") != "女性")
    return notify_fail("天水之舞只有女性才能练。\n");
  if ((int)me->query("spi") < 10)
    return notify_fail("你的灵性不够，没有办法练天水之舞。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神太差了，不能练天水之舞。\n");
  me->receive_damage("sen", 30);
  return 1;
}
