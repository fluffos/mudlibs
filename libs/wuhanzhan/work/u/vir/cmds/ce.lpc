#include <ansi.h>
#include <net/dns.h>
inherit F_CLEAN_UP;

int help(object me);

void create() 
{
    seteuid(getuid());
}

int main(object me, string arg)
{
      object obj;

      if(!me->query("couple/id")) return help(me);

        obj = find_player(me->query("couple/id"));

        if(!obj || (!wizardp(me) && !me->visible(obj)))
                return notify_fail("你的伴侣现在不在....\n");

        if (!wizardp(me) && obj->query_temp("pigging_seat"))
                return notify_fail("你的伴侣正在拱猪，听不到悄悄话....\n");

        if( !arg ){
        if((string)me->query("gender") == "女性") {
        message_vision(HIM"\n$N多么思念丈夫"+me->query("couple/name")+"啊...\n"NOR,me);
        tell_object(obj,sprintf(HIM"你的妻子在思念你... ...\n" NOR));
        }
        else {
        message_vision(HIM"\n$N多么思念妻子"+me->query("couple/name")+"啊...\n"NOR,me);
        tell_object(obj,sprintf(HIM"你的丈夫在思念你... ...\n" NOR));
        }
                }
      else {
       if( arg == "kiss" ) {
        if(objectp(present(me->query("couple/id"), environment(me))) ) {
        message_vision(HIM"\n$N拥抱着$n深深地一吻...\n"NOR, me,obj);
        }
        else {
        if((string)me->query("gender") == "女性") {
        write(HIM"你多想拥抱你的丈夫深深地一吻...\n"NOR);
        tell_object(obj,sprintf(HIM"你的妻子多想拥抱你，给你深深的一吻... ...\n"NOR));
                                                   }
        else {
        write(HIM"你多想拥抱你的妻子深深地一吻...\n"NOR);
        tell_object(obj,sprintf(HIM"你的丈夫多想拥抱你，给你深深的一吻... ...\n"NOR));
              }
           }
         }
       else {
        if((string)me->query("gender") == "女性") {
          write(HIM"你悄悄告诉你的丈夫：" + arg + "\n"NOR);
          tell_object(obj,sprintf(HIM"你的妻子悄悄告诉你：%s\n"NOR,arg));
                                                   }
        else {
          write(HIM"你悄悄告诉你的妻子：" + arg + "\n"NOR);
          tell_object(obj,sprintf(HIM"你的丈夫悄悄告诉你：%s\n"NOR,arg));
             }
           }
         }

        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：ce [kiss||<讯息>]

你可以用这个指令对你的伴侣说悄悄话。

HELP
        );
        return 1;
}

