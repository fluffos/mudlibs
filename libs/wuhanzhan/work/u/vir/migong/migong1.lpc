
//buy vir
inherit ROOM;
#include <localtime.h>

string* dirs = ({
        "east", "southeast", "southeast", "southwest", "northeast", "northeast",
        "west", "south", "south", "northwest", "north", "north",
        });
string* dirs2 = ({
        "e", "se", "se", "sw", "ne", "ne",
        "w", "s", "s", "nw", "n", "n",
        });

void create()
{

        set("short", "花苑");
        set("long", @LONG
你一走进花苑，看见东一簇鲜花，西一丛鲜花，顿时目眩神迷，迷失了方向。
你慌乱中刚想退出，回头一瞧，来路已在花丛中消失得无影无踪，看来只有硬着头
皮往前走了。
LONG
        );

                set("exits", ([
                "east" : __DIR__"migong1",
                "south" : __DIR__"migong1",
                "west" : __DIR__"migong1",
                "north" : __DIR__"migong1",
                "northeast" : __DIR__"migong3",
                "southeast" : __DIR__"migong3",
                "southwest" : __DIR__"migong3",
                "northwest" : __DIR__"migong3",
                ]));

        setup();

}

int valid_leave(object me, string dir)
{
  mixed local;
  int count, gain;
  
  local = localtime(time()*60);

  count = ((local[LT_HOUR]+1)%24)/2;
    if (dirs[count] == dir || dirs2[count] == dir) {
        me->move("/u/vir/migong/migong2");
        }
        me->start_busy(random(1));
        return notify_fail("\n");
  }
