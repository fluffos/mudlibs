
inherit ROOM;
#include <localtime.h>

string* dirs = ({
        "east", "southeast", "southeast", "southwest", "northeast", "northeast",
        "west", "south", "south", "northwest", "north", "north",
        });
string* dirs2 = ({
        "e", "se", "se", "sw", "ne", "ne",
        "w", "s", "s", "nw", "n", "n",
        });

void create()
{

        set("short", "花苑");
        set("long", @LONG
你走了几步，忽然想到如果这里是个迷宫，不如在原地静坐待变，如此乱闯终究不
是个了局。说也奇怪，开始你无论如何也离不开原地，现在想觅路回去，却发现自
己离原地好象越来越远了。
LONG
        );

                set("exits", ([
                "east" : __DIR__"migong3",
                "south" : __DIR__"migong3",
                "west" : __DIR__"migong3",
                "north" : __DIR__"migong3",
                "northeast" : __DIR__"migong3",
                "southeast" : __DIR__"migong3",
                "southwest" : __DIR__"migong3",
                "northwest" : __DIR__"migong3",
                ])); 
     
   setup();     
}

int valid_leave(object me, string dir)
{
  mixed local;
  int count, gain;
  
  local = localtime(time()*60);

  count = ((local[LT_HOUR]+1)%24)/2;
    if (dirs[count] == dir || dirs2[count] == dir) {
        me->move("/u/vir/migong/xiaojing");
        }
        me->start_busy(random(1));
        return notify_fail("\n");
  }

