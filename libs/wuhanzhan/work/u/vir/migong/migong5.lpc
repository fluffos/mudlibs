inherit ROOM;
#include <localtime.h>

string *dirs = ({
  "east", "southeast", "southeast", "southwest", "northeast", "northeast",
  "west", "south", "south", "northwest", "north", "north",
});


void create() {

  set("short", "花苑");
  set("long", @LONG
这片鲜花似乎无穷无尽一般，其中小径更是纵横交错，匪夷所思。你拼命想离
开原地，但几个转折又回到了原地。一连几次，似乎只是在同一个地方兜圈子。
LONG
  );

  set("exits", ([
    "east": __DIR__ "migong5",
    "south": __DIR__ "migong5",
    "west": __DIR__ "migong5",
    "north": __DIR__ "migong5",
    "northeast": __DIR__ "migong5",
    "southeast": __DIR__ "migong5",
    "southwest": __DIR__ "migong5",
    "northwest": __DIR__ "migong5",
  ]));

  setup();

}
int valid_leave(object me, string dir) {
  mixed local;
  int count;

  local = localtime(time() * 60);

  count = ((local[LT_HOUR] + 1) % 24) / 2;

  if (dirs[count] == dir)
    me->move("/u/vir/migong/migong6");
  me->start_busy(random(1));
  return notify_fail("\n");
}
