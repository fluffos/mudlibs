#include <armor.h>
#include <ansi.h>

inherit BOOTS;
void create() {
  set_name(HIW "水晶鞋" NOR, ({ "shoes", "yunxie" }));
  set("long", "一双水晶雕刻成的高跟鞋。\n");
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("material", "cloth");
    set("armor_prop/armor", 20);
    set("armor_prop/spells", 50);
    set("armor_prop/dodge", 20);
    set("replace_file", "/ivy/obj/xiangxie");
    set("value", 50000);
  }
  setup();
}
