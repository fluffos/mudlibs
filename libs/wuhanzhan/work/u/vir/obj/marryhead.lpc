#include <armor.h>
#include <ansi.h>
inherit HEAD;
void create() {
  set_name(HIW "水晶冠" NOR, ({ "shuijing guan", "zhanjia" }));
  set("long", "一顶美丽的水晶冠，散发着纯洁的光泽。\n");
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("material", "cloth");
    set("armor_prop/armor", 20);
    set("armor_prop/spells", 50);
    set("armor_prop/dodge", 20);
    set("replace_file", "/d/obj/cloth/birdtail");
    set("value", 50000);
  }
  setup();
}
