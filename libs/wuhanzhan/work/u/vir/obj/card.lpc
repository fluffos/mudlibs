#include <ansi.h>
inherit ITEM;
inherit F_SAVE;

mapping *mails;



void get_mail_text(mapping mail, string str);

void create() {
  set_name(HIW + "鲜花预定卡" + NOR, ({ "card", "card" }));
  set("long",
    "这是一张情人们用来预定鲜花的卡片：\n\n"
    "song <某人>               送鲜花给别人。\n"
  );
  set("unit", "张");
  set("no_drop", 1);
  set("no_give", 1);
  set("no_insert", 1);

  seteuid(getuid());
}

void set_owner(string id) {
  set("owner_id", id);
  mails = ({});
  restore();
  set("long",
    "这是一张情人们用来预定鲜花的卡片：\n\n"
    "song <某人>               送鲜花给别人。\n"
  );
  set("no_drop", 1);
  set("no_give", 1);
}

void init() {

  if (this_player() && environment() == this_player()) {
    set_owner((string)this_player()->query("id"));
    this_player()->set_temp("card_ob", this_object());
    set_name(HIW + "鲜花预定卡" + NOR, ({ "card", "card" }));

    add_action("do_song", "song");

  }
}

string query_save_file() {
  string id;

  if (!stringp(id = query("owner_id"))) return 0;

  return DATA_DIR + "flower/" + id[0..0] + "/" + id;
}

void receive_mail(mapping mail) {
  if (!pointerp(mails)) mails = ({ mail });
  else mails += ({ mail });
  save();
}

void send_mail(string rcvr, mapping mail, int silent) {
  object ppl, ob, mbx, me;
  me = this_player();
  ob = FINGER_D->acquire_login_ob(rcvr);
  if (!ob) {
    write("好象没有这个人存在。\n");
    return;
  }
  mail["to"] = ob->query("name");
  ob->add("new_mail", 1);
  ob->save();
  ppl = find_player(rcvr);
  if (ppl && this_player()->visible(ppl)) {
    mbx = ppl->query_temp("basket_ob");

    if (!silent)
      write("\n您请蝴蝶仙子给您向" + ob->query("name") + "送花!\n");
    tell_object(ppl, "你忽然觉得眼前一闪，蝴蝶不知从哪里跑了出来。\n\n");
    tell_object(ppl, "蝴蝶跟您说：您好幸福呦，" + me->query("name") + "给您送花了！\n\n");
  }
  if (!mbx) {

    mbx = new("/u/vir/obj/card");
    mbx->set_owner(rcvr);

  }
  mbx->receive_mail(mail);

  if (!ppl) {
    destruct(mbx);
    destruct(ob);
  }
}

int do_song(string arg) {
  mapping mail;


  if (this_player() != environment()) return 0;

  if (!arg || arg == "")
    return notify_fail("你要给谁送花？\n");

  mail = ([
    "from": this_player()->name(1) + "(" + this_player()->query("id") + ")",
    "title": "无题",
    "to": arg,
    "time": time(),
    "pic": "无题",
    "status": "N",
    "text": ""
  ]);
  write("您要送什么花：\n");
  write("１        " + HIR + "玫瑰花" + HIY + "       　　 10两黄金" + NOR + "\n");
  write("２        " + CYN + "蔷薇花" + HIY + "　　　　　　 5两黄金" + NOR + "\n");
  write("３        " + HIG + "狗尾巴花" + HIY + "　　　　 　2两黄金" + NOR + "\n");
  write("请选择(1,2,3,其它键退出）：\n");
  input_to("get_mail_title", mail);
  return 1;
}

void get_mail_title(string str, mapping mail) {
  object gold, me = this_player();
  int amount;
  string pic1 = (@TEXT
            ...  :``..':
             : ````.'   :''::'
           ..:..  :     .'' :
        ``.    `:    .'     :
            :    :   :        :
             :   :   :         :
             :    :   :        :
              :    :   :..''''``::.
               : ...:..'     .''
               .'   .'  .::::'
              :..'''``:::::::
              '         `::::
                          `::.
                           `::
                            :::.
                 ..:```.:'`. ::'`.
               ..'      `:.: ::
              .:        .:``:::
              .:    ..''     :::
               : .''          ::
                :             ::
                               :
                               :
                               :
                               :
                               :
                               .
TEXT);
  string pic2 = (@TEXT
                           ''''   
                       ...''''''...
                   ...:..' ˇˇˇ '.:...
                 .'   .'  .:::::. '.   '.
                 :..'''``:::::::::``'''..:
                            :::::
                             :::
                             :::
                             :::
                             :::  .:....
                         .:``:::.`   .^
                      .''    :::、.:^
                      ^:...^ :::
                             :::
                             :::
                             :::
                             :::
                             :::
TEXT);

  string pic3 = (@TEXT
                            ..＾、
                           : ◎＾          
                       ...: ＾.＾       
                     .: ◎ .＾:      
                    ,'''''``:::::  
                              `::::
                                `::.
                                 `::
                                  :::              
                                   ::              
                                   ::              
                                   ::                 
                                   :::                
                                    ::       
                                    ::  
                                    ::  
                                    ::
                                    ::    
TEXT);
  string *color1 = ({
    RED, GRN, YEL, MAG, BLU, CYN,
  });
  pic1 = color1[random(sizeof(color1))] + pic1 + NOR;
  pic2 = color1[random(sizeof(color1))] + pic2 + NOR;
  pic3 = color1[random(sizeof(color1))] + pic3 + NOR;

  if (!(gold = present("gold", me))) {
    write("你没有黄金。\n");
    return;
  }

  switch (str) {
    case "1":
      mail["title"] = "玫瑰花";
      mail["pic"] = pic1;
      amount = 10;
      if (gold = present("gold", me)) {
        if (amount > gold->query_amount()) {
          write("你没有那么多的" + gold->name() + "。\n");
          return;
        }
      }
      break;
    case "2":
      mail["title"] = "蔷薇花";
      mail["pic"] = pic2;
      amount = 5;
      if (gold = present("gold", me)) {
        if (amount > gold->query_amount()) {
          write("你没有那么多的" + gold->name() + "。\n");
          return;
        }
      }
      break;
    case "3":
      mail["title"] = "狗尾巴花";
      mail["pic"] = pic3;
      amount = 2;
      if (gold = present("gold", me)) {
        if (amount > gold->query_amount()) {
          write("你没有那么多的" + gold->name() + "。\n");
          return;
        }
      }

      break;
    default:
      return;
  }
  gold->set_amount((int)gold->query_amount() - amount);

  write("您的祝福：\n");
  this_player()->edit((: get_mail_text, mail :));
  return;
}

void get_mail_text(mapping mail, string str) {
  object ppl;
  string rcvr;


  mail["text"] = str;
  rcvr = mail["to"];
  send_mail(mail["to"], mail, 0);
  ppl = find_player(rcvr);
  if (ppl && this_player()->visible(ppl)) {
    write("蝴蝶闪身离开，片刻就跑了回来，红扑扑的小脸上挂着汗珠，说：花已送到！\n");
  } else {
    write("蝴蝶闪身离开，转瞬间又回来了，非常抱歉的说：没见到这人。花我给你保存着，一来我就给送去！\n");
  }
}


void owner_is_killed() { destruct(this_object()); }
int query_new_mail() {
  int num = 0, i;
  if (!pointerp(mails) || !sizeof(mails))
    return num;
  for (i = 0; i < sizeof(mails); i++)
    if (mails[i]["status"] == "N") num++;
  return num;
}
