#include <ansi.h>
#include <dbase.h>
#include <armor.h>

inherit NECK;

void create() {
  set_name(HIW "满天星" NOR, ({ "star" }));
  set_weight(100);
  set("material", "flower");
  set("long", HIW "一束亮亮的满天星。碎碎的星光仿佛祝福的小气泡，轻轻柔柔的将你环绕。\n" NOR);
  set("unit", "把");
  set("armor_prop/armor", 1);
  set("armor_prop/personality", 10);
  setup();
}

int init() {
  add_action("do_wear", "wear");
  add_action("do_remove", "remove");
  return 1;
}

int do_wear(string arg) {
  object me = this_player();
  object flower = this_object();
  string msg;

  if (arg == "all") return 0;
  if (arg != "star") return 0;
  if ((int)me->query("per") > 23) {
    tell_object(me, "蝴蝶在你耳边悄悄的说：“你其实并不丑呀，这朵花还是给别人吧。”\n");
    return 1;
  } else {
    msg = HIW "一片银色的星星飞扬开来，轻轻柔柔的将$N环绕起来。\n一瞬间，$N全身散发出晶莹的光芒。\n" NOR;
    flower->set("wear_msg", msg);
    return 0;
  }
}

int do_remove(string arg) {
  object flower = this_object();
  string name = flower->query("name");
  string msg;

  if (arg != "star") return 0;

  msg = "$N将" + name + "轻轻地摘下来……\n";
  flower->set("unequip_msg", msg);
  return 0;
}
