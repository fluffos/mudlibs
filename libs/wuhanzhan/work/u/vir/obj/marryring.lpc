#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create() {
  set_name(HIW "结婚钻戒" NOR, ({ "ring", "jie zhi" }));
  set("long", "象征着永恒爱情的信物\n");
  set_weight(3);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/spells", 1);
    set("armor_prop/dodge", 1);
    set("replace_file", "/ivy/obj/ring");
    set("value", 5);
  }
  setup();
}
