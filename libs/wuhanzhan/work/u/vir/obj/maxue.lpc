
#include <armor.h>
#include <ansi.h>

inherit BOOTS;

void create()
{
  set_name( HIB"长马靴"NOR, ({ "maxue", "xue" }) );
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "一双蓝色长筒皮靴。\n");
    set("value", 50);
    set("material", "boots");
    set("armor_prop/dodge", 1);
  }
  setup();
}


