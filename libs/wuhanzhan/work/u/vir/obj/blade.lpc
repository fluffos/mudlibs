#include <weapon.h>

#include <ansi.h>
inherit WHIP;
void create() {
  set_name(BLU "兰焰" NOR, ({ "flame", "blade", }));
  set_weight(2);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("unit", "滴");
    set("long", HIW "天不老，情难绝，心似双丝网，中有千千结．\n" NOR);
    set("value", 10);
    set("material", "crimsonsteel");
    set("wield_msg", BLU "$N低低的轻叹一声，充满伤感的火焰燃烧起来。\n" NOR);
    set("unwield_msg", BLU "$N手一挥，焰光黯淡了下去，点点滴滴溶入星空中\n" NOR);
    set("weapon_prop/int", 2);
    set("no_sell", 1);
  }

  init_whip(120);
  setup();
}

int query_autoload() { return 1; }

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (!((string)me->query("id") == "ayani")) return 0;
  if (random(8) < 2) return 0;
  if (!((string)victim->query("gender") == "女性")) {
    victim->busy(random(1));
    return BLINK BLU "$N面色一暗，一股幽蓝色的火焰夹带着奇寒直直劈向$n,$n惊恐的嘶吼着\n" NOR;
  }
  return 0;
}

void owner_is_killed()

{
  destruct(this_object());
}
