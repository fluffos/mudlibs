
#include <weapon.h>

#include <ansi.h>
inherit SWORD;
void create()
{
        set_name(HIW"痴心情长剑"NOR, ({"sword", "jian",}));
        set_weight(2);
        if( clonep() )
                set_default_object(__FILE__);
        else {

                set("unit", "柄");
                set("long",HIW "一柄剑，上面星砂点点，泪痕斑斑，是静悄悄的心爱之物．\n"NOR);
                set("value", 10);
                set("material", "crimsonsteel");
set("wield_msg",HIW"$N轻舞飞扬，聚漫天飞雪于手心，凝出一柄冷冷的痴心情长剑。\n"NOR );               
set("unwield_msg",HIW"$N手一挥，风雪片片飞舞，痴心情长剑慢慢溶入手心中\n"NOR );        
        set("weapon_prop/int", 2);
       set("no_sell",1);
        }

        init_sword(20);
        setup();
}

int query_autoload() { return 1; }

mixed hit_ob(object me, object victim, int damage_bonus)
{   
        if ( !((string)me->query("id")=="vir")) return 0;
        if (random(8)<2) return 0;
        if ( !((string)victim->query("gender")=="女性")){
    victim->busy(random(1));
    return BLINK HIW "$N长吟道，问世间情为何物，直叫人生死相许，痴心情长剑上风雪凝聚，一股奇寒袭来，$n手足一僵。\n" NOR;
      }
    return 0;
}

void owner_is_killed() 

{
destruct(this_object());
}

