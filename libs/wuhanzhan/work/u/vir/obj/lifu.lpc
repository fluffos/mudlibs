#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIW "礼服" NOR, ({ "cloth", "cloth" }));
  set("long", "一件黑色的男士礼服，结婚必备。\n");
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 900);
    set("armor_prop/spells", 50);
    set("armor_prop/dodge", 20);
    set("replace_file", "/d/obj/cloth/linen");
    set("value", 50000);
  }
  setup();
}
