#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name(HIW "暗香盈袖" NOR, ({ "yifu", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 50);
    set("long", "一件银白色的长袍。\n");
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 2);
  }
}
