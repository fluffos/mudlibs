
#include <ansi.h>
inherit ITEM;
void setup()
{}
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
string *names = ({
  "鸡蛋",
  "鸭蛋",
  "鹅蛋",
  "煎蛋",
  "炸蛋",
  "糖水蛋",
  "蒸蛋",
  "煮蛋",
  "炒蛋",
  "虎皮鸡蛋",
  "蛋王之王",
  "超级无敌爱心蛋",
  "坏蛋",
  "好蛋",
});

string *ids = ({
    "ji dan",
    "ya dan",
    "e dan",
    "jian dan",
    "zha dan",
    "tangshui dan",
    "zheng dan",
    "zhu dan", 
    "chao dan",
    "hupi dan",
    "wang dan",
    "aixin dan",
    "good dan",
    "bad dan",
});

  int i = random(sizeof(names));
  set_name(names[i], ({ids[i]}));
  set("unit","个");
  set("value",50);
  setup();
}

int do_eat(string arg)
{
      object me = this_player(), ob = this_object();
        if (!id(arg))
        return notify_fail("你要吃什么？\n");
    me->set("food",me->max_food_capacity());
    me->add("combat_exp",1000000);
    me->add("potential",3000000);
    me->set("water",me->max_water_capacity());
        message_vision(HIC"$N吃下一个"+ob->query("name")+"，心满意足的打了个饱嗝。\n"NOR,me);
        destruct(this_object());
        return 1;
}

