
#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name(HIW"婚纱"NOR, ({ "marry cloth", "cloth" }) );
        set("long", "一件白色的婚纱，象征的纯洁与爱情。\n");
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "skirt");
                set("armor_prop/armor", 1);
//:                set("armor_prop/spells", 50);
//                set("armor_prop/dodge", 20);
                set("value", 1);
        }
        setup();
}

