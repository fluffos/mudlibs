#include <armor.h>
#include <ansi.h>

inherit NECK;

void create() {
  set_name(HIB "星坠子" NOR, ({ "zhuizi", "star zhuizi" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "一滴冰蓝色的泪珠。\n");
    set("value", 50);
    set("material", "gold");
    set("armor_prop/dodge", 1);
  }
  setup();
}
