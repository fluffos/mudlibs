#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create() {
  set_name(HIM "猫猫耳" NOR, ({ "red hat", "hat" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("long", "一顶粉红色的帽子，上面有两只尖尖的猫耳朵。\n");
    set("material", "steel");
    set("value", 100);
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 1);
  }
  setup();
}
