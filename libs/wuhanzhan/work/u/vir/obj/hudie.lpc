inherit NPC;

void create() {
  string *order = ({ "鸳鸯" });
  string *orderr = ({ "凤蝶" });
  set_name(order[random(1)] + orderr[random(1)], ({ "xique" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "一只七彩斑斓的凤蝶，轻颤着翅膀上上下下的绕着你飞舞。\n");
  set("per", 30);
  set("str", 20);
  set("cor", 22);

  set("limbs", ({ "头部", "身体", "前脚", "后脚", "翅膀" }));
  set("verbs", ({ "smell", "wink", "shake" }));

  set("chat_chance", 6);
  set_temp("apply/attack", 10);
  set_temp("apply/armor", 3);

  setup();
}
