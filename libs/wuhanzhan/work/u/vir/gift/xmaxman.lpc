
#include <ansi.h>
inherit NPC;

int test_player (object me);

void create()
{
       set_name(HIW"圣诞老人"NOR, ({"shengdan laoren","shengdan","laoren"}));
       set("long",
"一位白胡子的老人，满面笑容，和蔼可亲\n");
       set("title", HIM"圣诞快乐"NOR);
       set("gender", "男性");
       set("age", 60);
       set("class", "xian");
       set("attitude", "friendly");
 //      set("rank_info/respect", "小MM");
       set("per", 23);
       set("int", 30);
       set("max_kee", 10000);
       set("max_gin", 10000);
       set("max_sen", 10000);
       set("force", 6000);
       set("max_force", 6000);
       set("force_factor", 1000);
       set("max_mana", 6000);
       set("mana", 6000);
       set("mana_factor", 1000);
       set("daoxing", 100000000);

        set("eff_dx", 200000);
        set("nkgain", 350);

       set_skill("literate", 800);
       set_skill("unarmed", 800);
       set_skill("dodge", 800);
       set_skill("force", 800);
       set_skill("parry", 800);
       set_skill("sword", 800);
       set_skill("spells", 800);
       set_skill("moonshentong", 800);
       set_skill("baihua-zhang", 800);
       set_skill("moonforce", 800);
       set_skill("snowsword", 800);
       set_skill("moondance", 800);
        map_skill("spells", "moonshentong");
        map_skill("unarmed", "baihua-zhang");
        map_skill("force", "moonforce");
        map_skill("sword", "snowsword");
        map_skill("parry", "snowsword");
        map_skill("dodge", "moondance");

  set("inquiry", ([
        "圣诞礼物":   (: test_player :),
        "礼物":   (: test_player :),
        "gift":   (: test_player :),
        "liwu":   (: test_player :),
      ]));

  set("chat_msg", ({ (: random_move :) }));

setup();

    //    carry_object("/u/vir/obj/marryshoes")->wear();
   //     carry_object("/u/vir/obj/marryhead")->wear();

}

int test_player (object me)
{
  object who = this_player();

  if (who->query("combat_exp")<10000)
  {
    me->command_function("shake");
    me->command_function("say 想用新人骗我，没门！");
    return 1;
  }  

  me->command_function("ok");
  me->command_function("say 圣诞快乐~。");
  call_out ("give_liwu",1,me,who);
  return 1;
}

void give_liwu (object me, object who)
{
  object liwu = new ("/u/vir/gift/xmas.lpc");

  liwu->move(me);
  me->command_function ("give "+who->query("id")+" liwu");
}

