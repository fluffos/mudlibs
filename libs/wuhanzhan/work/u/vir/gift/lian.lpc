inherit ITEM;

void create() {
  set_name("天山雪莲", ({ "whitelotus" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一株白色的雪莲，能治疗百病，可以用来治疗(cure) 
。\n"); set("unit", "株");
    set("value", 40);
    set("no_drop", 1);
    set("no_give", 1);
    set("no_get", 1);
  }
}

void init() {
  add_action("do_cure", "cure");
}

int do_cure(string arg) {
  object me;
  object whitelotus = this_object();
  int value = 200;
  int diff;

  if (arg != "whitelotus") {
    return notify_fail("你要cure什么?\n");
  }
  me = this_player();

  if (me->is_fighting())
    return notify_fail("战斗中不能使用雪莲治伤!\n");
  if ((int)me->query("sen") < 100) return notify_fail("你受伤过重，用了也是浪费！\n");
  if (whitelotus->query("used") > 50) {
    message_vision("天山雪莲慢慢枯萎了，化为一缕轻烟，飘散在空中。\n", me);
    destruct(whitelotus);
    return 1;
  }
  diff = me->query("max_kee") - me->query("eff_kee");
  if (!(diff)) return notify_fail("你没有受伤啊?\n");
  if (value > diff) value = diff;

  message_vision("$N搽了一下雪莲，顿时被一阵神光罩了起来。\n", me);
  me->add("eff_kee", value);
  whitelotus->add("used", 1);
  return 1;
}
void owner_is_killed()

{
  destruct(this_object());
}
