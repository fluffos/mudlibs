inherit SKILL;

mapping *action = ({
	([	"action":		"只见$N裙裾轻摆，双臂微扬，$n觉得清香扑鼻，正要沉醉之时，却是一张 \n绵掌扑面而来",
		"dodge":		-15,
		"parry":		-15,
		"force":		50,
		"damage_type":	"瘀伤",
	]),
	([	"action":		"$N忽然紧闭双目，却是真的在倾听海声。\n似有若无的一掌，竟带有隐隐的海潮声，好一招「听海」",
		"dodge":		-20,
		"parry":		-20,
		"force":		120,
		"damage_type":	"刺伤",
                        "weapon":		"右手掌",
	]),
	([	"action":		"$N双臂轻垂，莲步轻快，已在$n身边围走数周，让$n眼花缭乱，\n忽觉四周同时有几人向$n拍出一掌。",
		"dodge":		-25,
		"parry":		-25,
		"force":		70,
		"damage_type":	"瘀伤",
	]),
	([	"action":		"只见$N秀发轻扬，有如海风轻拂，右手顺势一招「海风轻拂」往$n的$l拍去",
		"dodge":		-25,
		"parry":		-25,
		"force":		60,
		"damage_type":	"瘀伤",
	]),
            ([	"action":	"$N不断的一掌接一掌的拍向$n，明明是极慢的掌，$n却还是躲避不即",
		"dodge":		5,
		"parry":		5,
		"force":		80,
		"damage_type":	"瘀伤",
	]),
});

int valid_learn(object me)
{
	if( (string)me->query("gender") != "女性" )
		return notify_fail("百花掌是只有女子才能练的武功。\n");
	if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
		return notify_fail("练百花掌必须空手。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("sen") < 30)
		return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
	if( (int)me->query("kee") < 30 )
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");
	if( (int)me->query("force") < 10 )
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("sen", 30);
	me->add("force", -10);

	return 1;
}

string perform_action_file(string func)
{
return CLASS_D("tinghai") + "/tinghai/" + func;
}
