#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int damage, ap, dp;
 	  int number, size, i, four;
	  object *tar;
                
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「听海」？\n");

        if(!me->is_fighting())
                return notify_fail("「听海」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 300 )
                return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 300 )
		return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 300 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("tinghai", 1) < 100)
                return notify_fail("你的听海级别还不够，使用这一招会有困难！\n");

        me->delete("env/brief_message");
	target->delete("env/brief_message");

message_vision(HIM"\n $N面泛桃花,娇小的身躯微微颤抖，不觉让人心生楚楚可怜之意。\n\n"
HIC" 只听一声娇哧：“海！”$N已不知何时从$n背后一掌拍至。\n\n"NOR,me,target);

        if( random((ap + dp)/1000+1) <  dp/1000 ) {
		msg = HIC "谁知$n狼狈至极，向后滚去，躲开了这招！\n\n"NOR;
	        message_vision(msg, me, target);
	} else {
                damage = (int)me->query_skill("tinghai",1) / 10 +
			(int)me->query("sen") / 400 + random((int)me->query("sen") / 200 ) +
			(int)me->query("kee") / 400 + random((int)me->query("kee") / 200 );
		msg = HIB " 这一掌突然之至，令$n防不胜防！\n" NOR;
		if (number < 10) damage +=random(number+1);
		else damage +=random(10);
                        target->receive_damage("sen", me->query("eff_sen")*damage/100, me);
                        target->receive_damage("kee", me->query("eff_kee")*damage/70, me);
                        me->improve_skill("tinghai", 1, 1);
	        message_vision(msg, me, target);
                COMBAT_D->report_status(target);
	 }
message_vision(HIC"\n 又见$N银牙一咬：“听海！”，又是一掌拍向$n面门！\n\n "NOR,me,target);

        if( random((ap + dp)/1000+1) <  dp/1000 ) {
		msg = HIC "谁知$n狼狈至极，向后滚去，躲开了这招！\n\n"NOR;
	        message_vision(msg, me, target);
	} else {
                damage = (int)me->query_skill("tinghai",1) / 10 +
			(int)me->query("sen") / 400 + random((int)me->query("sen") / 200 ) +
			(int)me->query("kee") / 400 + random((int)me->query("kee") / 200 );
		msg = HIB " $n正欲躲开，却被接踵而至的第二掌打了个正着！\n" NOR;
		if (number < 10) damage +=random(number+1);
		else damage +=random(10);
                        target->receive_damage("sen", me->query("eff_sen")*damage/100, me);
                        target->receive_damage("kee", me->query("eff_kee")*damage/70, me);
                        me->improve_skill("tinghai", 1, 1);
	        message_vision(msg, me, target);
                COMBAT_D->report_status(target);
	 }
message_vision(HIC"\n 再听银铃般的一声：“海之潮！”，$N的双掌已经拂到! \n\n"NOR,me,target);

        if( random((ap + dp)/1000+1) <  dp/1000 ) {
		msg = HIC "谁知$n狼狈至极，向后滚去，躲开了这招！\n\n"NOR;
	        message_vision(msg, me, target);
	} else {
                damage = (int)me->query_skill("tinghai",1) / 10 +
			(int)me->query("sen") / 400 + random((int)me->query("sen") / 200 ) +
			(int)me->query("kee") / 400 + random((int)me->query("kee") / 200 );
		msg = HIB " 第三掌又至！$n突然觉得嘴里一甜，“哇”的一声吐出一口鲜血！\n" NOR;
		if (number < 10) damage +=random(number+1);
		else damage +=random(10);
                        target->receive_damage("sen", me->query("eff_sen")*damage/100, me);
                        target->receive_damage("kee", me->query("eff_kee")*damage/70, me);
                        me->improve_skill("tinghai", 1, 1);
	        message_vision(msg, me, target);
                COMBAT_D->report_status(target);
	 }
message_vision(HIC"\n $n还没缓过神来，又听：“海风轻拂！”，$n又中了一招! \n\n"NOR,me,target);

        if( random((ap + dp)/1000+1) <  dp/1000 ) {
		msg = HIC "谁知$n狼狈至极，向后滚去，躲开了这招！\n\n"NOR;
	        message_vision(msg, me, target);
	} else {
                damage = (int)me->query_skill("tinghai",1) / 10 +
			(int)me->query("sen") / 400 + random((int)me->query("sen") / 200 ) +
			(int)me->query("kee") / 400 + random((int)me->query("kee") / 200 );
		msg = HIB " 潮水一样的掌风扑向$n,$n已经陷入了深深的潮水中，甚感呼吸都困难，更不用说躲避，结实的中了这掌！\n" NOR;
		if (number < 10) damage +=random(number+1);
		else damage +=random(10);
                        target->receive_damage("sen", me->query("eff_sen")*damage/100, me);
                        target->receive_damage("kee", me->query("eff_kee")*damage/70, me);
                        me->improve_skill("tinghai", 1, 1);
	        message_vision(msg, me, target);
                COMBAT_D->report_status(target);
	 }
message_vision(HIC"\n $n已经昏头昏脑却听：“哭泣的海潮！”，$n又再次挂彩! \n\n"NOR,me,target);

        if( random((ap + dp)/1000+1) <  dp/1000 ) {
		msg = HIC "谁知$n狼狈至极，向后滚去，躲开了这招！\n\n"NOR;
	        message_vision(msg, me, target);
	} else {
                damage = (int)me->query_skill("tinghai",1) / 10 +
			(int)me->query("sen") / 400 + random((int)me->query("sen") / 200 ) +
			(int)me->query("kee") / 400 + random((int)me->query("kee") / 200 );
		msg = HIB " $n早已经晕头转向了，顾不得体面了，正想团身滚开，却还是晚了！\n" NOR;
		if (number < 10) damage +=random(number+1);
		else damage +=random(10);
                        target->receive_damage("sen", me->query("eff_sen")*damage/100, me);
                        target->receive_damage("kee", me->query("eff_kee")*damage/70, me);
                        me->improve_skill("tinghai", 1, 1);
	        message_vision(msg, me, target);
                COMBAT_D->report_status(target);
	 }
message_vision(HIC"\n $n几乎什么都看不见了，只听：“回头再听海声！”，粉掌已再次拍到! \n\n"NOR,me,target);

        if( random((ap + dp)/1000+1) <  dp/1000 ) {
		msg = HIC "谁知$n狼狈至极，向后滚去，躲开了这招！\n\n"NOR;
	        message_vision(msg, me, target);
	} else {
                damage = (int)me->query_skill("tinghai",1) / 10 +
			(int)me->query("sen") / 400 + random((int)me->query("sen") / 200 ) +
			(int)me->query("kee") / 400 + random((int)me->query("kee") / 200 );
		msg = HIB " 连绵不断的掌就想海风一样密不透风，想躲，已是心有余而力不足了！\n" NOR;
		if (number < 10) damage +=random(number+1);
		else damage +=random(10);
                        target->receive_damage("sen", me->query("eff_sen")*damage/100, me);
                        target->receive_damage("kee", me->query("eff_kee")*damage/70, me);
                        me->improve_skill("tinghai", 1, 1);
	        message_vision(msg, me, target);
                COMBAT_D->report_status(target);
	 }
message_vision(HIC"\n $n已经陷入昏迷了却还听见一声：“所爱的不再是海！”，$n觉得身上已经空空荡荡，已经没有任何感觉了! \n\n"NOR,me,target);

        if( random((ap + dp)/1000+1) <  dp/1000 ) {
		msg = HIC "谁知$n狼狈至极，向后滚去，躲开了这招！\n\n"NOR;
	        message_vision(msg, me, target);
	} else {
                damage = (int)me->query_skill("tinghai",1) / 10 +
			(int)me->query("sen") / 400 + random((int)me->query("sen") / 200 ) +
			(int)me->query("kee") / 400 + random((int)me->query("kee") / 200 );
		msg = HIB " 这几招一气呵成，$n转眼之间便已中了七掌！便是再也没有气力了！\n" NOR;
		if (number < 10) damage +=random(number+1);
		else damage +=random(10);
                        target->receive_damage("sen", me->query("eff_sen")*damage/100, me);
                        target->receive_damage("kee", me->query("eff_kee")*damage/70, me);
                        me->improve_skill("tinghai", 1, 1);
	        message_vision(msg, me, target);
                COMBAT_D->report_status(target);
	 }





        me->receive_damage("sen", 100);
        me->add("force", -100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        me->start_busy(3);
        return 1;
}

