inherit ROOM;
#include <ansi.h>

void create ()
{
    set ("short", "曲径通幽");
    set ("long", @LONG

这里似乎是小径的尽头了。小径的一面是海，一面却又长满郁郁盛盛的大树。
LONG);

 setup();

}

void init()
{
    add_action("do_jump", "jump");
}

int do_jump()
{
    object me = this_player();
    message_vision("$N一块很高的石头，你居然不费吹灰之力就跳了上去。 \n", me);
    me->move("/u/rao/stone");
    message_vision("$N从小径尽头一下跳了上来。 \n", me);
    return 1;
}
