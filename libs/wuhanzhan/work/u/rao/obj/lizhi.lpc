#include <ansi.h>
inherit ITEM;
int do_eat(string);
inherit F_FOOD;

void create() {
  set_name("荔枝", ({ "lizhi", "zhi" }));
  set("long", "一颗好看的荔枝");
  set("unit", "棵");
  set("value", 0);
  set("food_remaining", 1);
  set("food_supply", 40);
}

int do_eat(string arg) {
  object me = this_player();
  me->set("food", (int)me->max_food_capacity());
  me->add("max_force", 1);
  me->add("max_mana", 1);
  message_vision("$N小心的拨开荔枝，把晶莹剔透的荔枝送进嘴里. \n", me);
  destruct(this_object());
  return 1;
}
