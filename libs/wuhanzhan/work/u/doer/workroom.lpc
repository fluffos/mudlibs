inherit ROOM;
void create() {
  set("short", "风之彩");
  set("long", @LONG

这里朵儿休闲养神的地方。空气中弥漫着淡淡的花香，微风拂过
脸宠，仿若置身于梦中，但分明于梦中依稀看见了风的颜色，绚
烂夺目。你可以感觉到海风的气息，沐浴在暖风中，与秋风共舞
......当你渐渐放松了身心，沉沉欲睡之时，一道美丽的彩虹在
和风中将你轻轻托起，你在流淌着五颜六色的风中睡去，主人为
你盖上了温暖的和风毯......
LONG);

  set("exits",
    ([  //sizeof() == 1
    "north": "/d/city/wanju",
    ]));

  set("no_fight", 1);
  set("no_cast", 1);
  set("no_magic", 1);
  set("no_exert", 1);
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
