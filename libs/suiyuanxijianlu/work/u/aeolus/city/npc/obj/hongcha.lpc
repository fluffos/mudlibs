// wineskin.c  酒袋

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("冰晶红茶", ({"hongcha", "tea"}));
	set_weight(800);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一杯香喷喷的冰晶红茶。\n");
		set("unit", "杯");
		set("value", 1000);
		set("max_liquid", 30);
	}

	// because a container can contain different liquid
	// we set it to contain wine at the beginning
	set("liquid", ([
//		"type": "alcohol",
		"name": "冰晶红茶",
		"remaining": 30,
		"drunk_apply": 30,
	]));
}
