// beer.c

inherit ITEM;

inherit F_LIQUID;


void create()

{

	set_name("青岛啤酒", ({"tsingtao beer", "beer"}));

	set_weight(700);

	if( clonep() )

		set_default_object(__FILE__);

	else {

		set("long", "一瓶用崂山矿泉酿制的甘甜的啤酒。\n");

		set("unit", "瓶");

		set("value", 200);

		set("max_liquid", 30);

	}


	set("liquid", ([

		"type": "alcohol",

		"name": "啤酒",

		"remaining": 30,

		"drunk_apply": 20,

	]) );

}
