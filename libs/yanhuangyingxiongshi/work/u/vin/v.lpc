#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name("一百零八颗" RED "血色苍穹" NOR, ({ "q" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 200000);
    set("unit", "块");
    set("can_be_enchased", 1);
    set("magic/type", "magic");
    set("magic/power", 50000);
    set("armor_prop/per", 8);
  }
  setup();
}
