#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m雷走[2;37;0m", ({ "boots" }));
  set_weight(720);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一双靴子。
[1;37m由[2;37;0m「[1;33m雷走[2;37;0m」[1;37m幻化而成的一双战靴，周身隐约散发着淡淡的光芒。[2;37;0m
靴子缘上刻着一行小字：乌老二(wulaoer)
");
  set("value", 2000000);
  set("point", 100);
  set("material", "stone");
  set(
    "wear_msg",
    "[1;37m$N从背后抽出第六把剑，暗喝一声[2;37;0m「[1;33m地[2;37;0m」[1;37m，剑身立刻光化成一双战靴。[2;37;0m\n"
  );
  set("remove_msg", "[1;33m地是柔韧的生命。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dodge", apply_armor() / 10 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
