#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m铠鳞[2;37;0m", ({ "mail" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一张护甲。
[1;37m由[2;37;0m「[1;36m铠鳞[2;37;0m」[1;37m幻化而成的一套护甲，周身隐约散发着淡淡的光芒。[2;37;0m
护甲缘上刻着一行小字：乌老二(wulaoer)
");
  set("value", 2000000);
  set("point", 200);
  set("material", "stone");
  set(
    "wear_msg",
    "[1;37m$N从背后抽出第四把剑，暗喝一声[2;37;0m「[1;36m空[2;37;0m」[1;37m，剑身立刻光化成一套护甲。[2;37;0m\n"
  );
  set("remove_msg", "[1;36m空是辽阔的胸襟。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/parry", apply_armor() / 15 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
