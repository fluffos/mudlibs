#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m月魔[2;37;0m", ({ "coat" }));
  set_weight(2400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一件战衣。
[1;37m由[2;37;0m「[1;37m月魔[2;37;0m」[1;37m幻化而成的一件战衣，周身隐约散发着淡淡的光芒。[2;37;0m
战衣缘上刻着一行小字：乌老二(wulaoer)
");
  set("value", 2000000);
  set("point", 250);
  set("material", "stone");
  set(
    "wear_msg",
    "[1;37m$N从背后抽出第二把剑，暗喝一声[2;37;0m「[1;37m月[2;37;0m」[1;37m，剑身立刻光化成一件战衣。[2;37;0m\n"
  );
  set("remove_msg", "[1;37m月是无尽的智慧。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
