#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("长剑[2;37;0m", ({ "sworda" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
这是一柄普通的精钢剑，一般的剑客都配带此剑。[2;37;0m
剑柄上刻着一行小字：鱼任翱(ainian)
");
	set("value", 2200000);
	set("point", 195);
	set("material", "magic stone");
	set("wield_msg", "$N「唰」的一声抽出一柄长剑握在手中。[2;37;0m\n");
	set("unwield_msg", "$N将手中的长剑插回剑鞘。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
