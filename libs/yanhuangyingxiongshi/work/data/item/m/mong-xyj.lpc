#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m逍遥巾[2;37;0m", ({ "xyj" }));
	set_weight(2550);
	set("item_make", 1);
	set("unit", "顶");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一顶头盔。
这是一件天青色头巾，柔软的表面射出耀眼的光泽。这是传说中的至宝：[1;36m逍遥巾[2;37;0m。[2;37;0m
头盔缘上刻着一行小字：纳兰(mong)
");
	set("value", 2000000);
	set("point", 84);
	set("material", "stone");
	set("wear_msg", "$N微微一笑，用[1;36m逍遥巾[2;37;0m束住了自己的头发。[2;37;0m\n");
	set("remove_msg", "$N轻轻一叹，解开了头发上的[1;36m逍遥巾[2;37;0m。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
