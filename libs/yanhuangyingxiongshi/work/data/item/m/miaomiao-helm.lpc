#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m彩莲盔[2;37;0m", ({ "helm" }));
  set_weight(2550);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一顶头盔。
[1;33m朵朵七彩莲花聚成的头盔。[2;37;0m
头盔缘上刻着一行小字：苗灵(miaomiao)
");
  set("value", 2000000);
  set("point", 105);
  set("material", "stone");
  set("wear_msg", "[1;33m只听得半空之中仙乐盈空，佩环之声不绝，霞光万道，朵朵七彩莲花聚在$N头顶。[2;37;0m\n");
  set("remove_msg", "[1;33m$N手指轻挥将聚顶莲花缓缓收去。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
