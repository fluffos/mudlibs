#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m问天剑[2;37;0m", ({ "tjian" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一柄剑。
[1;36m一块纯白色剑形水晶，晶莹剔透，无暇的表面射出耀眼的光泽。其中仿佛蕴藏着千千万万的生命，
生命流动不息，散发出宇宙的力量。这便是传说中的至宝[1;37m问天剑[2;37;0m，[1;36m相传只有在天宫中才会出现。[2;37;0m
剑柄上刻着一行小字：纳兰(mong)
");
  set("value", 4200000);
  set("point", 481);
  set("material", "tian jing");
  set(
    "wield_msg",
    "[1;36m天地色变中，大地轰然巨响，仿佛有物咆哮如雷。\n$N仰首望天，脸色煞白如雪，大喝声中，[1;37m问天剑[2;37;0m[1;36m迎风出鞘，光华大盛中，白虹贯日而入。[2;37;0m\n"
  );
  set("unwield_msg", "[1;36m$N仰首望天。剑已归鞘，而心仍问天。\n[1;37m“皇天之不纯命兮，何百姓之震愆！”[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
