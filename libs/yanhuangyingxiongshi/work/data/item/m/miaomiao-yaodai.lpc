#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m祥龙带[2;37;0m", ({ "yaodai" }));
	set_weight(960);
	set("item_make", 1);
	set("unit", "条");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一条腰带。
[1;33m一条祥龙在苗灵腰间盘绕。[2;37;0m
腰带缘上刻着一行小字：苗灵(miaomiao)
");
	set("value", 2000000);
	set("point", 84);
	set("material", "stone");
	set("wear_msg", "[1;33m天空忽现缨络庆云，瑞光缭绕，云光缥缈，云中一条祥龙从天而降盘绕在$N腰间。[2;37;0m\n");
	set("remove_msg", "[1;33m腰间的祥龙在$N身旁盘绕数周冲天而去。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
