#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m真丝[1;33m宝甲[2;37;0m", ({ "baojia" }));
  set_weight(2400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一件战衣。
一见黑黝黝的甲，毫不起眼。[2;37;0m
战衣缘上刻着一行小字：苗灵(miaomiao)
");
  set("value", 2000000);
  set("point", 186);
  set("material", "stone");
  set("wear_msg", "[1;33m$N穿上一件[1;36m真丝[1;33m宝甲。[2;37;0m\n");
  set("remove_msg", "[1;33m$N将[1;36m真丝[1;33m宝甲脱了下来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
