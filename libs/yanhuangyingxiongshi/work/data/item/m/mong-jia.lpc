#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m软甲[2;37;0m", ({ "jia" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一张护甲。
这是一件天青色护甲，柔软的表面射出耀眼的光泽。这是传说中的至宝：[1;36m软甲[2;37;0m。[2;37;0m
护甲缘上刻着一行小字：纳兰(mong)
");
  set("value", 2000000);
  set("point", 131);
  set("material", "stone");
  set("wear_msg", "$N嘻嘻一笑，穿上[1;36m软甲[2;37;0m。[2;37;0m\n");
  set("remove_msg", "$N嘻嘻一笑，脱下[1;36m软甲[2;37;0m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/parry", apply_armor() / 15 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
