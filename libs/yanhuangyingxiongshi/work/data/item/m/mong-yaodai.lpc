#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m腰带[2;37;0m", ({ "yaodai" }));
  set_weight(960);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一条腰带。
这是一件天青色[1;36m腰带[2;37;0m，柔软的表面射出耀眼的光泽。这是传说中的至宝：[1;36m腰带[2;37;0m。[2;37;0m
腰带缘上刻着一行小字：纳兰(mong)
");
  set("value", 2000000);
  set("point", 66);
  set("material", "stone");
  set("wear_msg", "$N嘻嘻一笑，系上[1;36m腰带[2;37;0m。[2;37;0m\n");
  set("remove_msg", "$N嘻嘻一笑，脱下[1;36m腰带[2;37;0m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
