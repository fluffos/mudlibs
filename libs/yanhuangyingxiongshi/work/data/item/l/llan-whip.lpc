#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[31m九州狂舞[2;37;0m", ({ "whip" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一根鞭。
这是由阎罗绸炼制而成的长鞭。天下武林中最冷酷的武器。[2;37;0m
鞭柄上刻着一行小字：罗兰(llan)
");
  set("value", 2000000);
  set("point", 132);
  set("material", "stone");
  set("wield_msg", "[31m杀了你，好吗？[2;37;0m\n");
  set("unwield_msg", "[31m请借项上人头一用，好吗？[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
