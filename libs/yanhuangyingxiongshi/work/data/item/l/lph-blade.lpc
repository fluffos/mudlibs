#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m血狼刃[2;37;0m", ({ "blade" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一把刀。
[1;31m这是一把充满血腥味的宝刀，刀身上一头血狼的影子若隐若现，好像就是传说中的血狼刃。[2;37;0m
刀柄上刻着一行小字：罗狼(lph)
");
  set("value", 2000000);
  set("point", 135);
  set("material", "stone");
  set("wield_msg", "[1;31m狼的十大处世哲学：\n卧薪尝胆众狼一心自知之明顺水行舟同进同退\n表里如一知己知彼狼亦钟情授狼以渔自由可贵\n[2;37;0m\n");
  set("unwield_msg", "[1;31m$N对月长嗥：\n我是一匹来自北方的狼！\n血色的狼！\n[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
