#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[37m暮色[2;37;0m", ({ "zhanyi" }));
	set_weight(2400);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一件战衣。
[1;32m而在二十年后的一个黄昏里
[1;32m有什么是与那夜相似
[1;32m竟尔使那旋律翩然来临
[1;32m山鸣谷应　直逼我心

[1;32m回顾所来径啊
[1;32m苍苍横着的翠微
[1;32m这半生的坎坷啊
[1;32m在暮色中竟化为甜蜜的热泪[2;37;0m
战衣缘上刻着一行小字：子陵(lilac)
");
	set("value", 2000000);
	set("point", 141);
	set("material", "stone");
	set("wear_msg", "[1;37m在一个年轻的夜里\n[1;37m听过一首歌\n[1;37m清洌缠绵\n[1;37m如山风拂过百合[2;37;0m\n");
	set("remove_msg", "[1;31m再渴望时却声息寂灭\n[1;31m不见踪迹　亦无来处\n[1;31m空留那月光沁人肌肤[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
