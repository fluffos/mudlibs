#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m离别钩[2;37;0m", ({ "whip" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一根鞭。
[1;33m江湖上著名的长鞭，据说它的前端有一个小钩，只要被钩中的东西都会离别，包括人的身体。[2;37;0m
鞭柄上刻着一行小字：紫翎(vip)
");
	set("value", 2000000);
	set("point", 149);
	set("material", "stone");
	set("wield_msg", "[1;31m$N默念九阳神功的口诀：他强由他强，清风拂山冈。他横任他横，明月照大江……\n刹那间只见$N全身顿时浮现出一层刚猛的劲气，将$N全全笼罩。\n$N眼中精光闪过，冷冷的扫过四周，一股寒意凛然而起。[2;37;0m\n");
	set("unwield_msg", "[1;31m$N微一凝神，运起九阳神功，将真气凝聚在丹田之中，沿奇经八脉遍布全身！[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_whip(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
