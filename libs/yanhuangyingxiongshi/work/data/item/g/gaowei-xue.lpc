#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m天灵靴[2;37;0m", ({ "xue" }));
  set_weight(720);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一双靴子。
[1;35m这是天地四宝之一，集天地灵气之精华孕育而成。[2;37;0m
靴子缘上刻着一行小字：月影岚(gaowei)
");
  set("value", 2000000);
  set("point", 50);
  set("material", "stone");
  set("wear_msg", "[1;32m$N忽然被一阵狂风卷起，当狂风散去的时候，他脚上多了一个古拙的长靴[2;37;0m\n");
  set("remove_msg", "[1;36m一时光芒大盛，亮光散去$N脚下长靴已经消失不见了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dodge", apply_armor() / 10 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
