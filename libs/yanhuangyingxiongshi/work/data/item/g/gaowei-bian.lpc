#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("因子[2;37;0m", ({ "bian" }));
	set_weight(750);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[37m缠魂丝[2;37;0m炼制而成的一根鞭。
鞭柄上刻着一行小字：月影岚(gaowei)
");
	set("value", 900000);
	set("point", 35);
	set("material", "silk");
	set("wield_msg", "[1;32m$N施展神农本草经点向大禹，大禹浑身透出一丝白色蒸气。\n[1;33m大禹吐出一口绿血，看来有些效果。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if (! check_clone()) return;
	restore();
	init_whip(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
