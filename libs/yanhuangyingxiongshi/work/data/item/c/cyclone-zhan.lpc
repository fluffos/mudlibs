#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m旋风斩[2;37;0m", ({ "zhan" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把刀。
[1;34m一把传说中来自魔界的旋风斩，上面附满了来自地狱冤魂的三魂六魄。[2;37;0m
刀柄上刻着一行小字：旋风(cyclone)
");
  set("value", 4200000);
  set("point", 505);
  set("material", "tian jing");
  set("wield_msg", "[1;34m见眼前青光一闪，匹练般的一道青光，直由$n背后闪电般地破空飞起落入$N掌中！[2;37;0m\n");
  set("unwield_msg", "[1;34m$n将手中的$N插回背后，脸色更加阴沉了！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
