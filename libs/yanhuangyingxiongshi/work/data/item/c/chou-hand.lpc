#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m粉拳[2;37;0m", ({ "hand" }));
	set_weight(1530);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一双铁掌。
[1;32m这是丑妹妹的[1;37m粉拳[1;32m。[2;37;0m
铁掌缘上刻着一行小字：丑妹妹(chou)
");
	set("value", 2000000);
	set("point", 151);
	set("material", "stone");
	set("wear_msg", "[1;32m$N带上[1;37m粉拳[1;32m看来是准备揍人了。[2;37;0m\n");
	set("remove_msg", "[1;32m$N揍完人了把[1;37m粉拳[1;32m收了起来。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/strike", 10);
	set("armor_prop/armor", 10);
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/hand", 10);

	setup();
}

string long() { return query("long") + item_long(); }
