#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m痴心情长箫[2;37;0m", ({ "xiao" }));
	set_weight(1020);
	set("item_make", 1);
	set("unit", "支");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一支箫。
[1;36m这是一品古色古香的玉箫，据传若是“天下第一情痴”谢晓峰吹起痴心情长箫来，男人心猿意马，女人意乱情迷。
[2;37;0m
箫柄上刻着一行小字：谢晓峰(china)
");
	set("value", 2000000);
	set("point", 133);
	set("material", "stone");
	set("wield_msg", "[1;36m$N手执痴心情长箫长吟：\n一切恩爱会，无常难得久\n生世多畏惧，命危於晨露\n由爱故生忧，由爱故生怖\n若离於爱者，无忧亦无怖\n[2;37;0m\n");
	set("unwield_msg", "[1;36m一曲听罢，你长叹：\n问世间情为何物，直教生死相许？\n[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_xsword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
