#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m妹妹剑[2;37;0m", ({ "jian" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[36m这是丑妹妹的随身宝物！[2;37;0m
剑柄上刻着一行小字：丑妹妹(chou)
");
  set("value", 2000000);
  set("point", 133);
  set("material", "stone");
  set("wield_msg", "[36m$N伸手一抖，将$n[36m装备在手上。[2;37;0m\n");
  set("unwield_msg", "[36m$N随手一挥，$n[36m已入鞘内。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
