#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m筱怡[2;37;0m", ({ "snow" }));
	set_weight(1190);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一套指套。
[1;36m溪边白鹭。来吾告汝。溪里鱼儿堪数。主人怜汝汝怜鱼，要物我、欣然一处。
[1;36m白沙远浦。青泥别渚。剩有虾跳鳅舞。任君飞去饱时来，看头上、风吹一缕。[2;37;0m
指套缘上刻着一行小字：甜饼(cooky)
");
	set("value", 2000000);
	set("point", 144);
	set("material", "stone");
	set("wear_msg", "[1;36m晚风吹雨，战新荷、声乱明珠苍璧。谁把香奁收宝镜，云锦红涵湖碧。\n[1;36m飞鸟翻空，游鱼吹浪，惯趁笙歌席。坐中豪气，看公一饮千石。[2;37;0m\n");
	set("remove_msg", "[1;36m遥想处士风流，鹤随人去，老作飞仙伯。茅舍疏篱今在否，松竹已非畴昔。\n[1;36m欲说当年，望湖楼下，水与云宽窄。醉中休问，断肠桃叶消息。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/claw", 10);
	set("armor_prop/armor", 10);
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/finger", 10);

	setup();
}

string long() { return query("long") + item_long(); }
