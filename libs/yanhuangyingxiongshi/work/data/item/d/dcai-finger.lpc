#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m指套[2;37;0m", ({ "finger" }));
	set_weight(1190);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一套指套。
[2;37;0m这是五个环环相链的铁指套，前端锋利如刃，既可暗藏掌中伤人，又可保护指关节。[2;37;0m
指套缘上刻着一行小字：段尘埃(dcai)
");
	set("value", 2000000);
	set("point", 137);
	set("material", "stone");
	set("wear_msg", "[33m$N戴上一副指套[2;37;0m\n");
	set("remove_msg", "[33m$N卸除指套的装备。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/finger", 10);
	set("armor_prop/claw", 10);
	set("armor_prop/armor", 10);

	setup();
}

string long() { return query("long") + item_long(); }
