#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m疯[1;33m魔[1;37m杖[2;37;0m", ({ "staff" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一根杖。
杖柄上刻着一行小字：大地飞鹰(ddfy)
");
  set("value", 2000000);
  set("point", 117);
  set("material", "stone");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_staff(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
