#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m头盔[2;37;0m", ({ "kui" }));
	set_weight(2550);
	set("item_make", 1);
	set("unit", "顶");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一顶头盔。
头盔缘上刻着一行小字：商甲(rara)
");
	set("value", 2000000);
	set("point", 89);
	set("material", "stone");
	set("wear_msg", "[33m$N[33m装备[1;33m头盔[2;37;0m[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[1;33m头盔[2;37;0m[33m。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
