#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m冰魄寒光剑[2;37;0m", ({ "bpjian" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;33m万载玄冰火焱熔，泣血凝碧铸寒锋。谁擎玉刃当空舞，凤诣九天觅无踪。[2;37;0m
剑柄上刻着一行小字：纳兰容情(rongqing)
");
	set("value", 2000000);
	set("point", 135);
	set("material", "stone");
	set("wield_msg", "[1;36m“锵”的一声龙吟，$N手中惊现一束三尺寒冰，细观之下，赫然便是名动江湖的“冰魄寒光剑”。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
