#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[35m夺命[1;36m疯魔杖[2;37;0m", ({ "staff" }));
	set_weight(12000);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[2;37;0m[36m镇龙石[2;37;0m炼制而成的一根杖。
匡扶正义，专杀不义，不忠，不孝之逆徒[2;37;0m
杖柄上刻着一行小字：山下美子(xinxin)
");
	set("value", 1400000);
	set("point", 83);
	set("material", "stone");
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if (! check_clone()) return;
	restore();
	init_staff(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
