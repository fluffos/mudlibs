#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m寒玉剑[2;37;0m", ({ "jian" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;36m一柄普普通通的剑。剑长三尺一寸，较一般的长剑为长。剑身黝黑，黯然无光，剑刃布满了缺口。[2;37;0m
剑柄上刻着一行小字：无名(xxwy)
");
  set("value", 2000000);
  set("point", 132);
  set("material", "stone");
  set(
    "wield_msg",
    "$N长啸一声，催动的内力，灌入[1;36m寒玉剑[2;37;0m中。\n刹那间，黑黝黝的[1;36m寒玉剑[2;37;0m，爆成一团雪亮光华，恍若千百白玉磨制，光可鉴人，内中更有一股浩然仙气。[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "$N伸指一弹[1;36m寒玉剑[2;37;0m，一声清吟。[1;36m寒玉剑[2;37;0m上晶莹白光逐渐消褪，剑刃又布满了缺口。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
