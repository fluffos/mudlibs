#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m明肌雪[2;37;0m", ({ "snow" }));
  set_weight(1350);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;32m乾[1;37m坤[1;33m石[2;37;0m炼制而成的一双铁掌。
[1;36m较一般的铁掌为短，璀璨有若白玉，光华辉映，彷佛是最美丽的新雪。[2;37;0m
铁掌缘上刻着一行小字：无名(xxwy)
");
  set("value", 2200000);
  set("point", 133);
  set("material", "stone");
  set("wear_msg", "$N一声长啸，[1;36m明肌雪[2;37;0m与$N融为一体。[2;37;0m\n");
  set("remove_msg", "$N长叹一声，[1;36m明肌雪[2;37;0m从$N手上脱了开来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/hand", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);
  set("armor_prop/armor", 10);

  setup();
}

string long() { return query("long") + item_long(); }
