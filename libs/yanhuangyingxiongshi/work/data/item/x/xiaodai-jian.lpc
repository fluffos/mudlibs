#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m王道[1;37m九剑[2;37;0m", ({ "jian" }));
	set_weight(10000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：小呆(xiaodai)
");
	set("value", 3200000);
	set("point", 500);
	set("material", "stone");
	set("wield_msg", "[1;33m$N噌的一声从背后抽出王道[1;37m九剑，[1;33m但见剑身青芒隐现，一股肃杀之意油然而生。[2;37;0m\n");
	set("unwield_msg", "[1;37m$N将[1;33m王道[1;37m九剑缓缓收入鞘内，双手环胸而立，心中顿感豪气万千。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
