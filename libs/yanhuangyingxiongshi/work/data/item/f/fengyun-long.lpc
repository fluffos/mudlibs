#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m骷髅剑[2;37;0m", ({ "long" }));
	set_weight(12000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[2;37;0m[36m镇龙石[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：风云(fengyun)
");
	set("value", 1400000);
	set("point", 79);
	set("material", "stone");
	set("wield_msg", "[1;31m“拿钱了……”[1;37m空中传来一阵怒吼。你吓的魂飞魄散，连忙拿出身上的钱恭敬的递给$N。[2;37;0m\n");
	set("unwield_msg", "[1;37m“滚……才这么一点，算利息好了”。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
