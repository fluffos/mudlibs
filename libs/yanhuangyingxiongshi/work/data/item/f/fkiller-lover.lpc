#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m六月飞霜[2;37;0m", ({ "lover" }));
  set_weight(6750);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[1;31m雷火寒晶[2;37;0m炼制而成的一柄剑。
[1;37m这是一柄形态古朴通体雪白，剑身修长薄如蝉翼，剑锋微微笼罩着青芒的利剑。[2;37;0m
剑柄上刻着一行小字：剑手尸(fkiller)
");
  set("value", 2100000);
  set("point", 133);
  set("material", "stone");
  set(
    "wield_msg",
    "[1;37m$N轻轻一声长叹，缓缓地从剑鞘中将宝剑拔出，顿时天地间弥漫着一股令人窒息的杀气，\n在场众人只觉寒气逼人毛骨悚然，不由感叹世间竟有如此利器。[2;37;0m\n"
  );
  set("unwield_msg", "[1;37m$N手腕微微一震宝剑已然入鞘，四周神秘杀气瞬间荡然无存，\n在场众人心头一松，不由长嘘一声。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
