#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m牙签[2;37;0m", ({ "yaqian" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[2;37;0m[33m钛金竹[2;37;0m炼制而成的一根杖。
杖柄上刻着一行小字：广播电台(bbc)
");
  set("value", 1200000);
  set("point", 50);
  set("material", "stone");
  set("wield_msg", "嗽，不知道从哪里飞出来一根牙签。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_staff(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
