#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[36m屠刀[2;37;0m", ({ "knife" }));
  set_weight(30000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一把刀。
这是一把血淋淋的[36m屠刀[2;37;0m。[2;37;0m
刀柄上刻着一行小字：破天(potian)
");
  set("value", 2200000);
  set("point", 134);
  set("material", "stone");
  set("wield_msg", "$N「唰」的一声抽出一柄[36m屠刀[2;37;0m握在手中。[2;37;0m\n");
  set("unwield_msg", "$N将手中的[36m屠刀[2;37;0m插回刀鞘。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
