#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m如来[1;31m神[1;35m掌[2;37;0m", ({ "rlsz" }));
  set_weight(1530);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一双铁掌。
[1;36m这就是当年如来佛祖使用的[1;35m如来[1;31m神[1;35m掌[1;36m，当年孙悟空
就是被这双手掌压在了五指山下，有着不可思议的
力量。[2;37;0m
铁掌缘上刻着一行小字：魔渡众生(iliilil)
");
  set("value", 2000000);
  set("point", 152);
  set("material", "stone");
  set("wear_msg", "[1;31m任你再神通广大也别想逃出我的掌心。[2;37;0m\n");
  set("remove_msg", "[1;32m只见你扑在地上挣扎了几下，腿一伸，口中喷出几口[1;31m鲜血，[1;32m死了！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/strike", 10);
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/hand", 10);
  set("armor_prop/armor", 10);

  setup();
}

string long() { return query("long") + item_long(); }
