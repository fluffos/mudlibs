#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m诅咒[2;37;0m", ({ "zhuozhou" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;31m这把剑长三尺，剑身隐现一种暗红色的光芒，传说只要有人把其破解，就能成为号令九天十地，十万魔神之主。[2;37;0m
剑柄上刻着一行小字：红缨(hongying)
");
  set("value", 2000000);
  set("point", 142);
  set("material", "stone");
  set("wield_msg", "[1;33m一拳击向大地，刹时间狂风大作，天地间一片灰暗。一把血色长剑，慢慢从大地裂口斜升上来。[2;37;0m\n");
  set("unwield_msg", HIY "手中长剑在空气中慢慢地消失得无影无踪。\n" NOR);
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
