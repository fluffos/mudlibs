#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[37m三千烦恼丝[2;37;0m", ({ "shi" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一根鞭。
鞭柄上刻着一行小字：毒哑你(hatch)
");
	set("value", 2000000);
	set("point", 135);
	set("material", "stone");
	set("wield_msg", "[1;37m只见众人眼前一花，一根纯白色的长鞭以出现在你手中[2;37;0m\n");
	set("unwield_msg", "[1;37m白光闪过长鞭以不见了[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_whip(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
