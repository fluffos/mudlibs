#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m玫瑰[2;37;0m", ({ "rose" }));
	set_weight(1530);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一双铁掌。
[1;37m这一百零八朵[1;31m玫瑰，[1;37m代表了花满地一颗[1;31m火辣辣[1;37m的心。[2;37;0m
铁掌缘上刻着一行小字：花满地(hhmd)
");
	set("value", 2000000);
	set("point", 140);
	set("material", "stone");
	set("wear_msg", "[33m$N[33m装备[1;31m玫瑰[2;37;0m[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[1;31m玫瑰[2;37;0m[33m。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/strike", 10);
	set("armor_prop/armor", 10);
	set("armor_prop/hand", 10);
	set("armor_prop/unarmed_damage", apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
