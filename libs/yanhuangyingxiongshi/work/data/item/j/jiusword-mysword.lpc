#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m无形剑气[2;37;0m", ({ "mysword" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
剑上笼罩着一层薄雾，是剑非剑[2;37;0m
剑柄上刻着一行小字：苗聪明(jiusword)
");
	set("value", 2000000);
	set("point", 119);
	set("material", "stone");
	set("wield_msg", "[1;31m$N微一凝神，运起无形神功，将真气凝聚在丹田之中，沿奇经八脉遍布全身！[2;37;0m\n");
	set("unwield_msg", "[1;31m$N默念九阳神功的口诀：他强由他强，清风拂山冈。他横任他横，明月照大江……[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
