#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[35m天蚕兰[2;37;0m", ({ "blue" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一张护甲。
[1;32m这[35m天蚕兰[1;32m乃是不畏水火兵刃的奇物，是一位武林前辈三十年前深入格鲁莎，采得三十六枚[35m“天蚕丝”[1;32m织成的一件宝衣。[2;37;0m
护甲缘上刻着一行小字：孙君(sunjun)
");
	set("value", 2000000);
	set("point", 103);
	set("material", "stone");
	set("wear_msg", "[1;36m只见[1;32m$N[1;36m身穿的蓝衣，突然像吹气似的鼓涨开来。日光照射之下，蓝色中似乎还带着[35m紫[1;36m、[1;33m黄[1;36m、[36m青[1;36m、[1;37m白[1;36m、[31m橙[1;36m、[33m柑[1;36m的各种颜色，闪耀不定。[2;37;0m\n");
	set("remove_msg", "[1;31m只见[1;37m$N[1;31m玉箫扬处，舞起一片银光，脱下[35m天蚕兰[1;31m，身形突然凌空而起，轻飘飘的上升三丈之高，彩衣翩翩，袖袂飘动，正好象一只彩凤。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/parry", apply_armor() / 15 + 1);

	setup();
}

string long() { return query("long") + item_long(); }
