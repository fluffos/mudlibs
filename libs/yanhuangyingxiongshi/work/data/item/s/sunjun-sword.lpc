#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m心[1;32m魔[1;34m剑[2;37;0m", ({ "sword" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;36m这是一把寒光闪闪，通体晶莹，非金非铁，酷似一段寒冰的宝剑，当真是人间独一、世上无双的异宝奇珍。[2;37;0m
剑柄上刻着一行小字：孙君(sunjun)
");
	set("value", 2000000);
	set("point", 125);
	set("material", "stone");
	set("wield_msg", "[1;32m只见[1;35m$N[1;32m甜甜一笑，从怀中取出一把宝剑。[1;31m心[1;37m魔[1;34m剑[1;32m略一挥动，冷气寒光，立刻向四面发射。[2;37;0m\n");
	set("unwield_msg", "[1;31m心[1;32m魔[1;34m剑[1;37m在[1;35m$N[1;37m心中一转，眨眼间已不见踪影。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
