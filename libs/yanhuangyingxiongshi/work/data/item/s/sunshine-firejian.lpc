#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m火[1;37m之[1;36m刃[2;37;0m", ({ "firejian" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;37m剑长三尺二寸，重六十四斤，整个剑身不断地向四周散发着灼热的[1;31m火气[1;37m。[2;37;0m
剑柄上刻着一行小字：烈阳之炙(sunshine)
");
	set("value", 2200000);
	set("point", 387);
	set("material", "stone");
	set("wield_msg", "[1;37m$N单手按在[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[1;37m上，内劲一放，只见一团雾气过后，$N手中突然现出一把[1;31m火红[1;37m的利刃。[2;37;0m\n");
	set("unwield_msg", "[1;37m$N单手持剑随手比画着，剑身渐渐被团团湿气所覆盖，一阵风吹过，$n[1;37m竟然凭空消失地无影无踪了。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
