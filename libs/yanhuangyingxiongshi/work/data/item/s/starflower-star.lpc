#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m避月羞花[2;37;0m", ({ "star" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一根鞭。
[1;31m巧笑解迎人，晴雪香堪惜。随风蝶影翻，误点朝衣赤。[2;37;0m
鞭柄上刻着一行小字：香兰(starflower)
");
  set("value", 2000000);
  set("point", 135);
  set("material", "stone");
  set("wield_msg", "[1;31m步摇金翠玉搔头，倾国倾城胜莫愁。若逞仙姿游洛浦，定知神女谢风流。[2;37;0m\n");
  set("unwield_msg", "[1;31m千株桃杏参差发，想见花时人却愁。曾忝陆机琴酒会，春亭惟愿一淹留。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
