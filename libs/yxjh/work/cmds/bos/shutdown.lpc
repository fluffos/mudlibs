// shutdown.c
#include <net/daemons.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  string wiz_status;
  object *user, link_ob;
  int i;
  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);
  if (me->query("id") != "rock" && me->query("id") != "jerry" && me->query("id") != "kjh")
    return notify_fail("你没有权限重新启动" + MUD_NAME + "\n");

  write_file("/log/nosave/LASTCRASH", geteuid(me) + " shutdown江湖风云于 " + ctime(time()) + "\n");
  message("system", "游戏重新启动，请稍候一分钟再 login 。\n", users());
  user = ty_users();
  for (i = 0; i < sizeof(user); i++) {
    if (!environment(user[i])) continue;
    user[i]->save();
    link_ob = user[i]->query_temp("link_ob");
    if (objectp(link_ob)) link_ob->save();
  }
  if (find_object(DNS_MASTER)) DNS_MASTER->send_shutdown();
  NATURE_D->auto_shutdown(1);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式: shutdown
 
马上重新起动游戏。
 
HELP
  );
  return 1;
}
