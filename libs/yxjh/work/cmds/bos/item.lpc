#include <ansi.h>

#define SELLD "/adm/daemons/selllist"

int main(object me, string arg) {
  string str;

  if (!arg || !stringp(arg)) return 0;

  //添加收费道具类型
  if (sscanf(arg, "add type %s", str)) {
    return SELLD->add_sell_type(me, str);
  }
  //删除收费道具
  else if (sscanf(arg, "delete %s", str)) {
    return SELLD->delete_sell_object(me, str);
  }
  //添加收费道具
  else if (sscanf(arg, "add %s", str)) {
    return SELLD->add_sell_object(me, str);
  }
  return 1;
}
//催化剂 : ({"材料","/u/rock/return_obj/cuihuaji",5})
int help(object me) {
  write(@HELP
指令格式 : item add type <类型名称>
这个指令可以添加收费道具类型。

指令格式 : item delete <道具名称>
这个指令可以删除收费道具。

指令格式 : item add <道具类型 道具名称 道具描述 道具文件路径 道具价值 >
这个指令可以添加收费道具，道具描述尽量简短。
HELP
  );
  return 1;
}
