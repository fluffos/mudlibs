//edit by rock

int main(object me, string arg) {
  object item;
  if (!arg) return 0;

  if (!item = present(arg, me)) {
    return 0;
  }
  item->set("_name", item->query("name"));
  "/adm/item/equip"->init_equip_prop_3(item);  //变更装备品质
  item->delete("long");
  item->init();
  tell_object(me, "OK\n");
  return 1;
}
