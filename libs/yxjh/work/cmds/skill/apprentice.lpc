// apprentice.c
#include <ansi.h>
inherit F_CLEAN_UP;

mapping FamilyType = ([
  0: ({
    "恒山派",
    "衡山派",
    "泰山派",
    "痴心妄想门",
    "空桐派",
    "少林派",
    "武当派",
    "华山派",
    "丐帮",
    "昆仑派",
    "峨嵋派",
    "云龙门",
    "大理段家",
    "全真教"
  }),
  1: ({ "青城派", "姑苏慕容", "明教", "桃花岛", "梅庄", "逍遥派", "古墓派", "玄天派", "通吃帮", "凌霄城", "崆峒派", "飞天御剑流" }),
  2: ({ "血刀门", "星宿派", "神龙教", "五毒教", "灵鹫宫", "移花宫", "嵩山派", "雪山寺", "白驼山派", "舞蝶仙" }),
]);

string get_zy(string famName) {
  string family_type;
  int i, j, size;

  if (!famName || !stringp(famName)) return "";

  for (i = 0; i < 3; i++) {
    if (FamilyType[i]) {
      size = sizeof(FamilyType[i]);
      for (j = 0; j < size; j++) {
        if (FamilyType[i][j] == famName) {
          if (i == 0) family_type = "名门正派";
          else if (i == 1) family_type = "亦正亦邪";
          else if (i == 2) family_type = "邪魔外道";
        }
      }
    }
  }

  if (family_type) return family_type;
  else return "";
}

int main(object me, string arg) {
  object ob, old_app;
  mapping family;
  string temp, zhenying, fam_name, npc_zy, str;
  int rand;

  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (!arg)
    return notify_fail("指令格式：apprentice | bai [cancel]|<对象>\n");
  if (arg == "cancel") {
    old_app = me->query_temp("pending/apprentice");
    if (!objectp(old_app))
      return notify_fail("你现在并没有拜任何人为师的意思。\n");
    write("你改变主意不想拜" + old_app->name() + "为师了。\n");
    tell_object(old_app, me->name() + "改变主意不想拜你为师了。\n");
    me->delete_temp("pending/apprentice");
    me->delete_temp("pended");
    return 1;
  }
  if (!(ob = present(arg, environment(me)))
    || !ob->is_character())
    return notify_fail("你想拜谁为师？\n");
  if (!living(ob))
    return notify_fail("你必须先把" + ob->name() + "弄醒。\n");
  if (ob == me)
    return notify_fail("拜自己为师？好主意....不过没有用。\n");

  if (me->is_apprentice_of(ob)) {
    message_vision("$N恭恭敬敬地向$n磕头请安，叫道：「师父！」\n", me, ob);
    return 1;
  }
  if (me->is_fighting() || ob->is_fighting())
    return notify_fail("现在正打的起劲，不是行拜师之礼的时候。\n");

  if (me->name() != me->name(1))
    return notify_fail(ob->name() + "瞪了你一眼，拜师？你是谁呀？\n");

  if (!mapp(ob->query("family")))
    return notify_fail(ob->name() + "既不属於任何门派，也没有开山立派，不能拜师。\n");

  fam_name = (string)ob->query("family/family_name");
  if (!me->query_temp("pended") && mapp(me->query("family")) && (string)me->query("family/family_name") != fam_name) {
    me->set_temp("pended", 1);
    return notify_fail("你如果决定要判师，首先要能战胜自己的师傅，否则会为武林所不耻。\n如果你一定要这么做，请再下一次这个命令！唉！\n");
  }

  npc_zy = get_zy(fam_name);
  zhenying = me->query("zhenying");
  if (zhenying && ob->query("id") != "news shi") {
    rand = random(100);

    if (zhenying != npc_zy) {
      if (me->query_temp("baishi_time") < time()) switch (npc_zy) {
        case "名门正派":
          if (zhenying == "亦正亦邪") {
            if (rand > 80) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s你我素无往来，拜师之事岂非儿戏，不可轻易提起。\n", me->name())
            );
            else if (rand > 60) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("哦，%s 大驾光临，有失远迎还请见谅。\n", me->name())
            );
            else if (rand > 40) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s，我乃名门正派，切勿再提拜师二字。\n", me->name())
            );
            else if (rand > 20) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("哦！今天天气不错，难怪%s你今天登门拜访。\n", me->name())
            );
          } else if (zhenying == "邪魔外道") {
            if (rand > 80) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("快滚！正邪不两立，%s你等邪魔外道若要继续纠缠，休怪我替天行道。\n", me->name())
            );
            else if (rand > 60) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s你好大的胆子，竟敢跑到我这撒野。快滚！\n", me->name())
            );
            else if (rand > 40) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("好啊！%s你敢戏弄我！\n", me->name())
            );
            else if (rand > 20) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s，你我正邪势不两立，还是快走吧！\n", me->name())
            );
          }
          break;
        case "亦正亦邪":
          if (zhenying == "名门正派") {
            if (rand > 80) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s，你等名门正派之人，也来拜我？不敢当啊。我看你还是回去吧！\n", me->name())
            );
            else if (rand > 60) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s，我有要事在身，恕不奉陪。\n", me->name())
            );
            else if (rand > 40) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s，你是名门，今天是来教训我吗？\n", me->name())
            );
            else if (rand > 20) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("江湖上的事情与我无关，%s，你走吧。\n", me->name())
            );
          } else if (zhenying == "邪魔外道") {
            if (rand < 80) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s，你不去江湖上扬名立万，跑到我这儿拜师，就不怕我杀了你吗？\n", me->name())
            );
            else if (rand > 60) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s，不如我拜你为师吧。\n", me->name())
            );
            else if (rand > 40) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s你来我这儿干嘛？还是去别处寻自在吧。\n", me->name())
            );
            else if (rand > 20) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("拜师？%s，江湖上的事，我从来都不过问。送客！\n", me->name())
            );
          }
          break;
        case "邪魔外道":
          if (zhenying == "名门正派") {
            if (rand > 80) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s你拜我为师？我最瞧不起的就是你们这种自称名门正派的人。赶快消失！\n", me->name())
            );
            else if (rand > 60) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("啊？没听清！%s，你是要我杀了你呢，还是留着你？\n", me->name())
            );
            else if (rand > 40) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("哦！久仰%s是武林正派人士，我今天偏不为难你，快走吧。\n", me->name())
            );
            else if (rand > 20) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s看你脸色不好，还是让我送你归天吧，你看如何？\n", me->name())
            );
          } else if (zhenying == "亦正亦邪") {
            if (rand > 80) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("嘿嘿！%s老邪，你也有今天，你现在来拜我了，求我啊！大声点求我！！\n", me->name())
            );
            else if (rand > 60) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("哈哈哈，%s，让你学了我的功夫，来杀我啊？\n", me->name())
            );
            else if (rand > 40) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s我收你为徒，但是不教你武工，你看行不行？\n", me->name())
            );
            else if (rand > 20) CHANNEL_D->do_channel(
              ob,
              "chat",
              sprintf("%s,我威望甚高，岂能收你？\n", me->name())
            );
          }
          break;
      }
      me->set_temp("baishi_time", time() + 2);
      return notify_fail("你想拜" + ob->name() + "为师，但是对方没有答应。\n");
    }
  }

  me->delete_temp("pended");
  // If the target is willing to recruit us already, we do it.
  if (me->query("age") < ob->query("age"))
    temp = me->query("ganger") == "女性" ? "师妹" : "师弟";
  else
    temp = me->query("ganger") == "女性" ? "师姐" : "师兄";
  if (me->query("family/family_name") == ob->query("family/family_name"))
    if (me->query("family/generation") <= ob->query("family/generation"))
      return notify_fail(CYN + ob->name() + "对你笑了笑，" + temp + "不要和我开这个玩笑。\n" NOR);
  if ((object)ob->query_temp("pending/recruit") == me) {
    if (mapp(me->query("family")) && ((string)me->query("family/family_name") != (string)ob->query("family/family_name"))) {
      message_vision(
        "$N决定背叛师门，改投入$n门下！！\n\n"
        "$N跪了下来向$n恭恭敬敬地磕了四个响头，叫道：「师父！」\n\n",
        me, ob);
      me->add("betrayer", 1);
    } else
      message_vision(
        "$N决定拜$n为师。\n\n"
        "$N跪了下来向$n恭恭敬敬地磕了四个响头，叫道：「师父！」\n\n",
        me, ob);
    ob->recruit_apprentice(me);
    ob->delete_temp("pending/recruit");
    tell_object(ob, "恭喜你新收了一名弟子！\n");
    family = me->query("family");
    printf("恭喜您成为%s的第%s代弟子。\n",
      me->query("family/family_name"),
      chinese_number(me->query("family/generation")));
    return 1;

  } else {
    switch (npc_zy) {
      case "名门正派": str = "邪魔外道之人"; break;
      case "亦正亦邪": str = "自居名门和心肠歹毒之人"; break;
      case "邪魔外道": str = "名门正派之人"; break;
    }
    if (!zhenying && ob->query("id") != "news shi") {
      tell_object(me, sprintf(HIR "「%s」属于%s，岂能来者不拒，你得先宣誓投身%s，才能拜入%s。\n"
        "其身投入%s后，不得和江湖上%s交往，更不可拜入%s门下！\n"
        HIY "请三思而行，确定后键入 [join %s] 指令。\n" NOR,
        fam_name, npc_zy, npc_zy, fam_name, npc_zy, str, str, npc_zy));
      return 1;
    }

    old_app = me->query_temp("pending/apprentice");
    if (ob == old_app)
      return notify_fail("你想拜" + ob->name() + "为师，但是对方还没有答应。\n");
    else if (objectp(old_app)) {
      write("你改变主意不想拜" + old_app->name() + "为师了。\n");
      tell_object(old_app, me->name() + "改变主意不想拜你为师了。\n");
    }
    message_vision("$N想要拜$n为师。\n", me, ob);
    me->set_temp("pending/apprentice", ob);

    if (userp(ob)) {
      tell_object(ob, YEL "如果你愿意收" + me->name() + "为弟子，用 recruit 指令。\n" NOR);
    } else ob->attempt_apprentice(me);
    return 1;
  }
}
int help(object me) {
  write(@HELP
指令格式 : apprentice|bai [cancel]|<对象>
 
这个指令能让你拜某人为师，如果对方也答应要收你为徒的话，就会立即行
拜师之礼，否则要等到对方用 recruit 指令收你为弟子才能正式拜师。
请注意你已经有了师父，又背叛师门投入别人门下，新师傅将不会教你他的
绝活。
如果对你的师父使用这个指令，会变成向师父请安。
 
请参考相关指令 expell、recruit
HELP
  );
  return 1;
}
