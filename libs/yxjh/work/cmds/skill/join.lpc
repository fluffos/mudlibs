#include <ansi.h>

int main(object me,string arg)
{
	string str,zhenying;

	if(zhenying = me->query("zhenying")) return notify_fail(sprintf("你已经投身%s，难道后悔了不成？\n",zhenying));

	if(!arg || !sprintf(arg)) return notify_fail("你要投身什么派别?\n");

	switch(arg)
	{
		case "名门正派" : str = "邪魔外道之人"; break;
		case "亦正亦邪" : str = "自居名门和心肠歹毒之人"; break;
		case "邪魔外道" : str = "名门正派之人"; break;
		default : return notify_fail("你要投身什么派别?\n");
	}
	CHANNEL_D->do_channel(me,"chat", sprintf("我决意投身%s，此生以%s为敌，誓不言悔。",arg,str));
	tell_object(me, sprintf(YEL "你决定投身%s。\n" NOR,arg));
	me->set("zhenying",arg);
	return 1;
}