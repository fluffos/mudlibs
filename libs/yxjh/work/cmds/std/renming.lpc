// By rock&jym 
inherit F_CLEAN_UP;
int check_name(string name);

int main(object me, string arg) {
  object ob, lp;
  string name, id, myid;
  string banghui;
  int rock;

  myid = me->query("id");

  if (!arg)
    return notify_fail("指令格式：renming <某人> <级别> <职务>\n");

  if (!stringp(banghui = me->query("banghui")))
    return notify_fail("只有帮主才能使用该指令!\n");

  if (sscanf(arg, "%s %d %s", id, rock, name) == 3) {
    ob = present(id, environment(me));

    if (!objectp(ob = present(id, environment(me))))
      return notify_fail("这儿没有这么个人。\n");

    lp = new("/clone/misc/lingpai");
    lp->create(banghui);

    if (lp->query("no_use")) {
      destruct(lp);
      return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
    }

    if (lp->query("bangzhu_id") != myid && !lp->query("renming/" + myid)) {
      destruct(lp);
      return notify_fail("您没有使用这个指令的权利。\n");
    }

    if (rock >= me->query("tybang/rock") && lp->query("bangzhu_id") != myid) {
      destruct(lp);
      return notify_fail("你不能把他的等级提的比你还要高。\n");
    }

    if (lp->query("bangzhu_id") == ob->query("id") && lp->query("bangzhu_id") != myid) {
      destruct(lp);
      return notify_fail("不能任命帮主。\n");
    }

    if (me->query("tybang/rock") <= ob->query("tybang/rock") && lp->query("bangzhu_id") != myid) {
      destruct(lp);
      return notify_fail("您的等级没对方高,无法任命。\n");
    }
    destruct(lp);

    if (!ob) return notify_fail("这儿没有这么个人。\n");

    if (!ob->is_character())
      return notify_fail("看清楚，那并不是人！\n");

    if (!userp(ob))
      return notify_fail("你只能任命玩家！\n");

    if (me->query("banghui") != (string)ob->query("banghui"))
      return notify_fail("你只对本帮会的玩家使用这条命令！\n");

    if (me->is_busy() || me->is_fighting())
      return notify_fail("你正忙着呢！\n");

    if (ob->is_busy() || ob->is_fighting())
      return notify_fail("对方正忙着呢！\n");

    if (rock > 9)
      return notify_fail("帮主也才十级,九级已经是最高了。\n");

    if (rock < 1) return notify_fail("最底只能任命他为一级。\n");

    if (!check_name(name))
      return notify_fail("您任命的职务的字数必须是四到三十个单位之间！\n");

    name = trans_color(name, 2);
    banghui = trans_color(banghui, 2);
    ob->set("tybang/banghui", me->query("tybang/banghui"));
    ob->set("tybang/rock", rock);
    ob->set("tybang/bh_rank", name);
    message_vision("$N把$n升到" + rock + "级,任命$n为「" + banghui + "」" + name + "！\n", me, ob);
    return 1;
  } else
    return notify_fail("指令格式：renming <某人> <级数> <职务>\n");
}

int check_name(string name) {
  int i;

  i = strlen(name);

  if ((strlen(name) < 4) || (strlen(name) > 45)) {
    return 0;
  }
  return 1;
}

int help(object me) {
  write(@HELP

指令格式：renming <player's id> <级数> <职务名称>

这条指令是玩家帮会的特殊人物专用命令，可以为本
帮会的玩家帮众分配帮会职务。如坛主、堂主、护法
、使者等称谓。

by rock&jym
HELP
  );
  return 1;
}
