#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int medj;
  medj = (int)me->query("jym_level/level", 1);
  me->delete("tydamage"); write("删除原有攻击力设置！成功！\n");

  if (me->query_skill_mapped("sword") == "xuantie-jianfa") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("xuantie-jianfa", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("sword") == "wuxing-jianfa") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("wuxing-jianfa", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("sword") == "pixie-jian") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("pixie-jian", 1) / 5 + medj * 20 + 350));
  }

  if (me->query_skill_mapped("sword") == "tianyu-qijian") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("tianyu-qijian", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("sword") == "dugu-jiujian") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("dugu-jiujian", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("sword") == "huifeng-jian") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("huifeng-jian", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("sword") == "zuixin-sword") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("zuixin-sword", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("sword") == "yifeng-jian") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("yifeng-jian", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("sword") == "shedao-qigong") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("shedao-qigong", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("blade") == "taiji-dao") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/blade", (me->query_skill("taiji-dao", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("blade") == "tianxin-blade") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/blade", (me->query_skill("tianxin-blade", 1) / 5 + medj * 20 + 200));
  }

  if (me->query_skill_mapped("sword") == "langzi-sword") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("langzi-sword", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("sword") == "wudu-goufa") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/sword", (me->query_skill("wudu-goufa", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("club") == "dagou-bang") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/club", (me->query_skill("dagou-bang", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("bian") == "wudu-bian") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/bian", (me->query_skill("wudu-bian", 1) / 5 + medj * 20 + 150));
  }

  if (me->query_skill_mapped("bian") == "riyue-bian") {
    write("更新攻击力Ok.\n");
    me->set("tydamage/bian", (me->query_skill("riyue-bian", 1) / 5 + medj * 20 + 150));
  }
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : uskill


这个指令让你指定技能的攻击力设置，如果提升了ID等级，或者学习了技能，
必须通过这个指令设置攻击力！

 
HELP
  );
  return 1;
}
