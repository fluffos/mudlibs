int main(object me, string arg) {
  object item;

  if (!arg) return 0;

  if (!me->query_temp("timeQ/start") || me->query_temp("timeQ/name") != "gouwu") return notify_fail("你没有领取寻物活动任务。请quest gouwu\n");

  if (arg != me->query_temp("timeQ/itemID")) return notify_fail(sprintf(
    "你要找的不是这件物品。是%s(%s)\n",
    me->query_temp("timeQ/itemName"),
    me->query_temp("timeQ/itemID")
  ));
  if (!item = present(arg, me)) return notify_fail("你身上没有这件物品,无法完成任务。\n");
  if (userp(item)) return notify_fail("拿一个快死的人交任务？\n");

  if (item->query("name") != me->query_temp("timeQ/itemName")) tell_object(
    me,
    "物品名称或名字颜色略有不同，不过也是可以蒙混过关的。\n"
  );

  destruct(item);
  ADD_EXP(me, 20000000);
  me->add("potential", 100000);
  me->delete_temp("timeQ");
  tell_object(me, HIG "你获得了20000000点实战经验，100000点潜能。\n" NOR);

  notify_fail("任务完成，可以重复接取任务 quest gouwu\n");
  return 1;
}

void do_quest(object me) {
  int i, size;
  string *key;

  key = keys(quest_item);
  size = sizeof(key);
  i = random(size);

  me->set_temp("timeQ/start", 1);
  me->set_temp("timeQ/name", "gouwu");
  me->set_temp("timeQ/itemID", quest_item[key[i]]);
  me->set_temp("timeQ/itemName", key[i]);

  tell_object(me, "你领取了寻物活动任务。任务完成指令：gouwu <ID>\n");
  tell_object(me, sprintf("这次是寻找 %s(%s)\n", key[i], quest_item[key[i]]));
}

void test() {
  do_quest(find_player("rock"));
}
