//擦鞋任务
//edit by rock

#include <ansi.h>

int main(object me, string arg)
{
	object room,who,boots;

	if(!arg) return 0;

	if(!me->query_temp("timeQ/start") || me->query_temp("timeQ/name") != "caxie") return notify_fail("你没有领取擦鞋活动任务。请quest caxie\n");
	if(me->query_temp("timeQ") && me->query_temp("timeQ/con") < 1)
	{
		me->delete_temp("timeQ");
		return notify_fail("任务完成，可以重复接取任务 quest caxie\n");
	}
	
	if(me->query_busy()) return notify_fail("你正忙着呢。\n");
	room = environment(me);
	if(!who = present(arg,room)) return notify_fail(sprintf("这里没有 %s 。\n",arg));
	if(!me->query_temp("Cmud_login"))
	{
		if(!boots = who->query_temp("armor/boots")) return notify_fail("你惊奇的发现，这个人没穿鞋，可以尝试帮他足底按摩。\n");
		if(who == me) return notify_fail("为自己擦鞋，没有意思，要服务大众嘛！\n");
		if(!boots->query("max_lasting")) boots->set("max_lasting",100);
		if(boots->query("max_lasting") < 10) return notify_fail("他的鞋子太破，没法擦！\n");
	}
	
	tell_room(room,sprintf(YEL"%s拿起鞋油和毛巾，为%s认真的擦起鞋子来。\n"NOR,me->query("name"),who->query("name")));
	me->add_temp("timeQ/con",-1);
	me->start_busy(1200);

	call_out("do_caxie",10,me,who);

	return 1;
}

void do_caxie(object me,object who)
{
	object boots,room;

	me->start_busy(1);
	
	room = environment(me);
	if(!who || room != environment(who))
	{
		tell_object(me,"白忙活一场，对方早就走了。\n");
		return;
	}

	if(!me->query_temp("Cmud_login"))
	{
		boots = who->query_temp("armor/boots");
		if(!boots)
		{
			tell_object(me,"白忙活一场，对方的鞋子早就收起来了，怕你弄坏。\n");
			return;
		}

		if(random(100) < 50)
		{
			tell_room(room,sprintf(YEL"%s把%s的鞋子擦得干干净净。\n"NOR,me->query("name"),who->query("name")));
			ADD_EXP(me,4000000);
			me->add("potential",20000);
			tell_object(me,HIG"你获得了4000000点实战经验，20000点潜能。\n"NOR);
		}
		else
		{
			tell_room(room,sprintf(YEL"%s因为太急功近利，把%s的鞋子擦坏了一些。\n"NOR,me->query("name"),who->query("name")));
			boots->set("max_lasting",-(1+random(20)));
			if(boots->query_xy())
			{
				boots->delete("long");
				boots->init();
			}
		}
	}
	else
	{
		tell_room(room,sprintf(YEL"%s把%s的鞋子擦得干干净净。\n"NOR,me->query("name"),who->query("name")));
		ADD_EXP(me,4000000);
		me->add("potential",20000);
		tell_object(me,HIG"你获得了4000000点实战经验，20000点潜能。\n"NOR);
	}
}