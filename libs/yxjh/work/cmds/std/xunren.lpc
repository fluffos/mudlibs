int main(object me, string arg)
{
	object npc,room;

	if(!arg) return 0;

	if(!me->query_temp("timeQ/start") || me->query_temp("timeQ/name") != "xunren") return notify_fail("你没有领取寻物活动任务。请quest xunren\n");
	
	if(arg != me->query_temp("timeQ/npcID")) return notify_fail(sprintf("你要找的不是这个NPC。是%s(%s)\n",me->query_temp("timeQ/npcName"),me->query_temp("timeQ/npcID")));
	room = environment(me);
	if(!npc = present(arg,room)) return notify_fail("这里没有这个NPC,无法完成任务。\n");

	if(npc->query("name") != me->query_temp("timeQ/npcName")) tell_object(me,"NPC名称或名字颜色略有不同，不过也是可以蒙混过关的。\n");

	ADD_EXP(me,10000000);
	me->add("potential",80000);
	me->delete_temp("timeQ");
	tell_object(me,HIG"你获得了10000000点实战经验，80000点潜能。\n"NOR);

	return notify_fail("任务完成，可以重复接取任务 quest xunren\n");
}

void do_quest(object me)
{
	int i,size;
	string *key;
	
	key = keys(quest_npc);
	size = sizeof(key);
	i = random(size);
	
	me->set_temp("timeQ/start",1);
	me->set_temp("timeQ/name","xunren");
	me->set_temp("timeQ/npcID",quest_npc[key[i]]);
	me->set_temp("timeQ/npcName",key[i]);

	tell_object(me,"你领取了寻物活动任务。任务完成指令：xunren <ID>\n");
	tell_object(me,sprintf("这次是寻找"HIC"(NPC)"NOR" %s(%s)\n",key[i],quest_npc[key[i]]));
}

void test()
{
	do_quest(find_player("rock"));
}