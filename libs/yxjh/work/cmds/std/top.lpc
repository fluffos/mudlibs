#include <ansi.h>
#include <mudlib.h>

inherit F_CLEAN_UP;
int top_list(object ob1,object ob2);
int get_score(object ob);

string *eff = ({"伤害吸收 50%","伤害反射 50%",
				"伤害吸收 40%","伤害反射 40%",
				"伤害吸收 30%","伤害反射 30%",
				"伤害吸收 20%","伤害反射 20%",
				"伤害吸收 10%","伤害反射 10%",
});

int main(object me, string arg)
{
        
	object *list,*ob;
	int i,size;
	string msg;

	if((int)me->query_temp("last_top") > time()) return notify_fail("对不起，不能连续使用该指令!\n");
	me->set_temp("last_top",time() + 10);

//      ob = filter_array(ty_users(), (: userp($1) && !wizardp($1)&&!$1->query("env/no_top") :));
	ob = filter_array(ty_users(), (: userp($1) && !wizardp($1) :));
	size = sizeof(ob);
	for(i=0;i<size;i++)
	{
		ob[i]->delete_temp("top_xishou");
		ob[i]->delete_temp("top_fanshe");
	}
	list = sort_array(ob, (: top_list :));
//	msg =  "\n                      ┏ "HIW"《浴血江湖》实力榜"NOR" ┓\n";
	msg = "";
//	msg += "┏━━━┯━━━━━━┻━━━┯━━━━━━┻━━┯━━━━━━━━━┓\n";
	msg += "┏━━━┯━━━━━━━━━━┯━━━━━━━━━┯━━━━━━━━━┓\n";
	msg += "┃ 名次 │    高        手    │    门      派    │    特 效 加 成   ┃\n";
	msg += "┠───┴──────────┴─────────┴─────────┨\n";

	for (i = 0 ;i < 10 ; i++)
	{
		if( i >= sizeof(list)) msg += "┃暂时空缺。                     ┃\n";
		else
		{
			if(list[i] == me) msg += BBLU HIY;
			msg += sprintf(NOR"┃  %-5s %-22s %-21s %-15s┃\n"NOR,
				chinese_number(i+1),list[i]->query("name")+"("+capitalize(list[i]->query("id"))+")", (string)list[i]->query("family/family_name")?list[i]->query("family/family_name"):"闲云野鹤",eff[i]);
			switch(i)
			{
				case 0 : list[i]->set_temp("top_xishou",5); break;
				case 1 : list[i]->set_temp("top_fanshe",5); break;
				case 2 : list[i]->set_temp("top_xishou",4); break;
				case 3 : list[i]->set_temp("top_fanshe",4); break;
				case 4 : list[i]->set_temp("top_xishou",3); break;
				case 5 : list[i]->set_temp("top_fanshe",3); break;
				case 6 : list[i]->set_temp("top_xishou",2); break;
				case 7 : list[i]->set_temp("top_fanshe",2); break;
				case 8 : list[i]->set_temp("top_xishou",1); break;
				case 9 : list[i]->set_temp("top_fanshe",1); break;
			}
		}
	}
	msg += "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n";
//	msg += HIW"  您现在的评价是："+sprintf("%5d",get_score(me)); 
//	msg += NOR"    " + NATURE_D->game_time() + "记。\n";
//	if ( me->query("env/no_top") )
//      msg += HIR"  您现在"HIC"处于隐世"HIR"中，无法进入排行榜\n"NOR;
        write(msg);
        return 1;

}

int top_list(object ob1, object ob2)

{
      int score1,score2;

        score1 = get_score(ob1);
        score2 = get_score(ob2);

      return score2 - score1;
}

int get_score(object me)
{
        int tlvl,i,score;
        string *ski;
        mapping skills;
        int exp;


   reset_eval_cost();
   score = me->query_skill("literate",1)/5;
   score += me->query_skill("dodge",1)/5;
   score += me->query_skill("force",1)/5;
   score += me->query_max_neili()/2000;
   score += me->query_max_jingli()/2000;
   score += me->query("str") + me->query("int") + me->query("dex") + me->query("con");
   score += me->query("spi")/20 + me->query("cps")/20 + me->query("kar")/20;
   exp = me->query_level();
   score += exp;
   return score;
}

int help()
{
write(@HELP
指令格式 : top 
 
这个指令可以让你知道在线十大高手是哪些，别去惹他们。 
 
HELP
    );
    return 1;
}