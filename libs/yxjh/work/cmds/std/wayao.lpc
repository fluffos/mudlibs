string *room = ({
	"墙角里","草地里","泥土地上","土路边","大树下","土堆中","草丛里",
	"墙缝里","自己脚下","地上","土丘上","土包上","一滩积水中","一滩积水边",
	"稀泥里","泥浆里"
});

string *att = ({
	"扣出","拔出","拉出","找出","挖出","刨出","采下",
	"扣下","拔下","拉下","挖下","刨下","凿下","凿出"
});

void do_wayao(object me);

int main(object me, string arg)
{
	object room;
	
	if(arg) return 0;
	
	if(me->query_busy())
		return notify_fail("你正忙着呢。\n");

	room = environment(me);
	if(!room || !room->query("outdoors"))
		return notify_fail("这里怎么可能有药？\n");
	
	if(me->query("jing") < 100 || me->query("qi") < 100)
		return notify_fail("你太累了，没法挖药。\n");
		
	if(me->query_temp("wayao_room") == room)
		return notify_fail("这里刚被你挖过，还是赶快走，遇上巡捕可是要以破坏公物逮捕的。\n");
	
	message_vision(HIW"$N开始认真的寻找草药。\n"NOR,me);
	me->set_temp("wayao_room",room);
	me->start_busy(1200);
	call_out("do_wayao",10,me);
	return 1;
}

void do_wayao(object me)
{
	int rand = random(100);
	int i,size,j,randSize,exp=1+random(2000);
	int pot = 1+exp/10;
	int eff_qi;
	object item;
	
	me->add("jing",-(1+rand));
	me->add("qi",-(1+rand)/2);

	if(rand < 20)
	{
		eff_qi = me->query("max_qi")/2;
		me->set("eff_qi",eff_qi);
		me->set("qi",eff_qi);
		message_vision(HIR"$N突然喊到，我的妈妈呀，竟然挖出毒虫 。\n"NOR,me);
		message_vision(HIW"$N被毒虫咬伤减少"+eff_qi+"点气血。\n"NOR,me);
		me->start_busy(1);
	}
	else if(rand < 50)
	{
		me->start_busy(1);
		size = sizeof(yao);
		j = size;
		randSize = random(size);
		for(i=0;i<size;i++)
		{
			if(j < randSize ) break;
			else j--;
		}
		if(item=new("/u/rock/return_obj/yao"))
		{
			if(i<0) i=0;
			else if(i>size-1) i = size-1;
			//if(find_player("rock")) tell_object(find_player("rock"),sprintf("Wayao : i=%d size=%d\n",i,size));
			if(!yao[i])
			{
				destruct(item);
				return;
			}
			item->set_name(yao[i],({ "yao" }));
			item->set("level",i/100);
			item->set("long","一颗稀有的药材，拿到华佗那里应该有大用处。\n");
			item->move(me);
		}
		ADD_EXP(me,exp);
		me->add("potential",pot);
		message_vision(HIW"$N在"+room[random(sizeof(room))]+"惊喜地"+att[random(sizeof(att))]+HIY+yao[i]+HIW+" 。\n"NOR,me);
		message_vision(HIG"$N获得了"+exp+"点经验，"+pot+"点潜能。\n"NOR,me);
	}
	else
	{
		me->start_busy(1);
		message_vision(HIW"$N忙了半天什么都没挖到。\n"NOR,me);
	}
}