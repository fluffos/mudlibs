//擦鞋任务
//edit by rock

#include <ansi.h>

int main(object me, string arg) {
  object room, who;

  if (!arg) return 0;

  if (!me->query_temp("timeQ/start") || me->query_temp("timeQ/name") != "zhiliao") return notify_fail("你没有领取治疗活动任务。请quest zhiliao\n");
  if (me->query_temp("timeQ") && me->query_temp("timeQ/con") < 1) {
    me->delete_temp("timeQ");
    return notify_fail("任务完成，可以重复接取任务 quest zhiliao\n");
  }

  if (me->query("neili") < 200) return notify_fail("你的内力不足。\n");
  if (me->query_busy()) return notify_fail("你正忙着呢。\n");
  room = environment(me);
  if (!who = present(arg, room)) return notify_fail(sprintf("这里没有 %s 。\n", arg));
  if (who == me) return notify_fail("为自己诊疗，没有意思，要服务大众嘛！\n");

  tell_room(room, sprintf(YEL "%s运功仔细的为%s诊疗起来。\n" NOR, me->query("name"), who->query("name")));
  me->add_temp("timeQ/con", -1);
  me->start_busy(1200);

  call_out("do_zhiliao", 10, me, who);

  return 1;
}

void do_zhiliao(object me, object who) {
  object room;

  me->start_busy(1);

  room = environment(me);
  if (!who || room != environment(who)) {
    tell_object(me, "白忙活一场，对方早就走了。\n");
    return;
  }

  if (random(100) < 70) {
    tell_room(room, sprintf(YEL "%s用内力%s已把对方的伤病除去。\n" NOR, me->query("name"), who->query("name")));
    me->add("neili", -100);
    ADD_EXP(me, 80000000);
    me->add("potential", 500000);
    tell_object(me, HIG "你获得了80000000点实战经验，500000点潜能。\n" NOR);
  } else {
    tell_room(
      room,
      sprintf(YEL "%s望闻问切了半天，没有发现%s有什么疾病。\n" NOR, me->query("name"), who->query("name"))
    );
  }
}
