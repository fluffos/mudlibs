#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object player, lp;
  string bh, myid;
  mapping data;
  string name;

  myid = me->query("id");

  if (!arg) return notify_fail("指令格式：kaichu <玩家id>\n");

  bh = (string)me->query("banghui");
  if (!bh) return notify_fail("只有帮会的帮主才的开除他人。\n");

  lp = new("/clone/misc/lingpai");
  lp->create(bh);
  if (lp->query("no_use")) {
    destruct(lp);
    return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
  }
  destruct(lp);
  player = find_player(arg);

  if (!player)
    return notify_fail("对方没在线吧?\n");

  if (arg == myid)
    return notify_fail("你要开除自己?\n");

  lp = new("/clone/misc/lingpai");
  lp->create(bh);

  if (lp->query("bangzhu_id") != myid && !lp->query("kaichu/" + myid)) {
    destruct(lp);
    return notify_fail("您没有使用这个指令的权利。\n");
  }

  if (lp->query("bangzhu_id") != me->query("id") &&
    me->query("tybang/rock") <= player->query("tybang/rock")) {
    destruct(lp);
    return notify_fail("你无权开除这个帮众。\n");
  }

  if (arg == lp->query("bangzhu_id")) {
    destruct(lp);
    return notify_fail("想开除帮主？\n");
  }

  data = lp->query("player");
  if (!mapp(data)) data = ([]);
  if (!stringp(name = data[arg])) {
    destruct(lp);
    return notify_fail("你的帮会中没有这个玩家。\n");
  }

  lp->delete("player/" + player->query("id"));
  lp->save();
  destruct(lp);
  if (!objectp(player)) {
    player = new("/cmds/adm/stdnpc");
    player->create(arg);
    if (player->query("no_use")) {
      destruct(player);
    } else {
      player->delete("banghui");
      player->delete("tybang");
      if (!undefinedp(player->query("rank_lv")))
        player->delete("rank_lv");
      player->delete("title");
      player->save();
      destruct(player);
    }
  } else {
    player->delete("banghui");
    player->delete("tybang");
    if (!undefinedp(player->query("rank_lv")))
      player->delete("rank_lv");
    player->delete("title");
    player->save();
    destruct(player);
  }
  message("channel:rumor", YEL "【谣言】某人：" + name + "(" + arg + ")被" +
    "帮会「" + trans_color(bh, 2) + "」开除！\n" NOR, users());

  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : kaichu <玩家id>

本指令是帮主专用指令，用于开除本帮会中的玩家。

HELP
  );
  return 1;
}
