// white by jerry@ty&bxjh
#include <ansi.h>
inherit F_CLEAN_UP;
object find_player(string target)
{
        int i;
        object *str;
        str=users();
        for (i=0;i<sizeof(str);i++)
                if (str[i]->query("id")==target)
                        return str[i];
        return 0;
}
int main(object me, string arg)
{
         string dest, topic, msg,target;
        object ob;
        seteuid(getuid());
        if( !arg || arg=="" )
                return notify_fail("你要回答谁什么事？\n");
        if( !stringp(target = me->query_temp("ask")) )
                return notify_fail("刚才没有人问你问题。\n");
       ob = find_player(target);
        if( !ob ||!interactive(ob) || !environment(ob) )
                return notify_fail("刚才和你说话的人现在无法听见你，或者已经离开游戏了。\n");

        if( !ob->is_character() ) {
                message_vision("$N对着$n自言自语....\n", me, ob);
                return 1;
        }
                  message_vision(YEL "$N" YEL "积极回答$n" YEL 
                               "『" HIG + arg + NOR YEL "』"
                               "的问题.\n", me, ob);
       if( userp(ob) ) return 1;
}
int help(object me)
{
   write( @HELP
指令格式: answer <讯息>
你可以用这个指令回答刚才用 ask 问你问题的使用者.
HELP
   );
   return 1;
}

