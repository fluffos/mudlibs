#include <combat.h>
int help(object me);

int main(object me, string arg)
{
   int money, rock;
if (!arg) return notify_fail("你要换多少元宝!\n");
        else    if(!sscanf(arg, "%d", money))                     return help(me);
        if (money<1)      return notify_fail("你没有这么多元宝来换!\n");
if (money>4) return notify_fail("最多只能换4枚元宝!\n");
if (me->query("jym_money",1) < 1)
return notify_fail("你没有这么多元宝来换!\n");
if (money>me->query("jym_money",1))
return notify_fail("你没有这么多元宝来换!\n");
 
 if( (100000*money)+me->query("money",1)/1000>2100000 )
return notify_fail("你不能换那么多，再换就暴了！\n");
                me->add("jym_money",-money);
                me->add("money",money*100000000);
                write("你把"+money+"枚元宝换成了黄金，存到钱庄中!\n");

   return 1;
}

int help(object me)
{
        write(@HELP
指令格式 :huanrock <几枚元宝>

      把元宝转换成存款。

HELP
    );
    return 1;
}

