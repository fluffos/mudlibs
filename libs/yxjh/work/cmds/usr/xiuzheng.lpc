// edit by Zjb@HLXY /2003/08/06/

#include <ansi.h>

int help(object me);

int main(object me, string arg) {
  int exp, pot;
  string str;
  if (!arg) return help(me);
  if (!sscanf(arg, "%s", str)) return help(me);

  exp = me->query_exp();
  pot = me->query("potential") - me->query("learned_points");

  if (str != "exp" && str != "pot")
    return notify_fail("目前只支持修正经验值<exp>和潜能值<pot>!\n");

  if (str == "exp") {
    if (exp < 0 && exp < -1500000000)
      me->set("combat_exp", 2100000000);
    else
      return notify_fail("你的经验值并没有问题啊?\n");
  }

  if (str == "pot") {
    if (pot < 0 && pot < -1500000000) {
      me->set("potential", 2100000000);
      me->set("learned_points", 0);
    } else
      return notify_fail("你的潜能数值并没有问题啊?\n");
  }
  log_file("nosave/xiuzheng", me->query("id") + "修正了"
    +str + "时间是" + "/cmds/usr/rtime.lpc"->chinese_time(5,
      ctime(time())) + "\n");
  write("整理完毕，您可以继续安心的练功了!\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 :xiuzheng <类型>

修正已经暴了的数值，目前只开放修正 武学<exp>
                                   潜能<pot> 

附：必须要在刚暴不久就去修正，因为如果当你的这样数值的负数超过了
负十五亿的话，就无法修正了！

例子:比如我的武学暴了，我要修正我的武学那么就使用
xiuzheng exp 这个指令来执行!

                                                       edit by Zjb@HLXY 
                                                           2003--08--06
HELP
  );
  return 1;
}
