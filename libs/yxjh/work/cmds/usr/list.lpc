//浴血江湖 list.c
//edit by rock
//2010.8.15

#include <ansi.h>
inherit F_CLEAN_UP;

#define SELLD "/adm/daemons/selllist"

int look_sell(object me, string type);
int look_all(object me);

int main(object me, string arg) {
  mapping goods;
  string *gks;
  object *obs, obj, env, *inv;
  string msg, *obj_type;
  int i, have_vendor = 0, size;

  mapping price;
  mapping unit;
  string short_name;
  string prefix;
  string *dk;

  env = environment(me);

  if (!arg) {
    inv = all_inventory(env);
    inv -= ({ me });
    if (!inv)
      return notify_fail("这里并没有任何在摆摊的商人。\n");

    msg = HIC "现在这里的小摊子有："
      HIY "\n──────────────\n" NOR;
    size = sizeof(inv);
    for (i = 0; i < size; i++) {
      if (userp(inv[i]) && inv[i]->query_temp("on_baitan")) {
        have_vendor = 1;
        msg += WHT + inv[i]->name(1) + "的杂货摊(" + inv[i]->query("id") + ")\n";
      }
    }
    if (have_vendor) {
      msg += HIY "──────────────\n" NOR;
      write(msg);
    }
    //显列收费道具类型
    else {
      obj_type = SELLD->query_obj_type();
      size = sizeof(obj_type);

      if (!obj_type) return notify_fail("目前这里并没有任何摆摊的商人。\n");
      else msg = "浴血珍宝铺中的道具类别有:\n";

      for (i = 0; i < size; i++) { msg += HIC + obj_type[i] + "  "; }
      return notify_fail(sprintf("%s" NOR "\n\n输入 list all 查看全部物品，输入 list <类别> 查看详细内容。\n", msg));
    }

    return 1;
  }

  if (!(obj = present(arg, env)) || !userp(obj)) {
    //显列收费道具
    if (arg == "all") {
      return look_all(me);
    } else if (!look_sell(me, arg))
      return notify_fail("这里并没有这个商人。\n");
    else return 1;
  }

  if (!obj->query("is_vendor"))
    return notify_fail(obj->name(1) + "并不是商人。\n");

  if (!obj->query_temp("on_baitan"))
    return notify_fail(obj->name(1) + "目前并没有在摆摊。\n");

  goods = obj->query("vendor_goods");

  if (!goods)
    return notify_fail(obj->name(1) + "目前并没有兜售任何货物。\n");

  gks = keys(goods);

  for (i = 0; i < sizeof(gks); i++) {
    if (!present(gks[i]->query("id"), obj))
      map_delete(goods, gks[i]);
  }

  obj->set("vendor_goods", goods);
  goods = obj->query("vendor_goods");

  unit = ([]);
  price = ([]);

  gks = keys(goods);

  for (i = 0; i < sizeof(gks); i++) {
    object gob;
    call_other(gks[i], "???");

    if (!objectp(find_object(gks[i]))) {
      log_file("user_vendor", sprintf("No found vend"
        "or good:%s\n", gks[i]));
      continue;
    }

    gob = find_object(gks[i]);
    short_name = gob->name(1) + "(" + gob->query("id") + ")";

    if (gob->query("base_unit"))
      prefix = "base_";
    else
      prefix = "";

    unit += ([ short_name: gob->query(prefix + "unit") ]);
    price += ([ short_name: goods[gks[i]] ]);
  }

  msg = HIC + obj->name(1) + "目前出售以下物品："
    HIY "\n─────────────────────────\n" NOR;
  dk = sort_array(keys(unit), 1);

  for (i = 0; i < sizeof(dk); i++) {
    int p;
    p = price[dk[i]];

    msg += sprintf("%" + sprintf("%d", (30 + color_len(dk[i]))) +
      "-s：每%s%s" CYN "\n" NOR,
      dk[i], unit[dk[i]], MONEY_D->price_str(p));
  }
  msg += HIY "─────────────────────────\n" NOR;
  write(msg);
  return 1;
}

int look_all(object me) {
  int i, size, bb = 0;
  string *key, msg = "", str;
  mapping db = SELLD->query_type_items();

  key = keys(db);
  size = sizeof(key);
  for (i = 0; i < size; i++) {
    if (!bb) {
      msg += sprintf(BBLU HIW "%-12s   %-43s %5d\n" NOR, key[i], db[key[i]][1], db[key[i]][3]);
      bb = 1;
    } else {
      msg += sprintf(BCYN BLK "%-12s   %-43s %5d\n" NOR, key[i], db[key[i]][1], db[key[i]][3]);
      bb = 0;
    }
  }
  if (msg != "") {
    str = HIY + "浴血珍宝铺道具列表：\n" NOR;
    str += "   物品名                   物品描述                价格(浴血币)\n";
    str += "-----------------------------------------------------------------\n";
    str += msg;
    str += "-----------------------------------------------------------------\n";
    str += "购买使用buy <道具名称>\n";
    me->start_more(str);
  } else {
    tell_object(me, "浴血珍宝铺里没有任何道具出售。\n");
  }
  return 1;
}

int look_sell(object me, string type) {
  int i, size, type_ok = 0, bb;
  string *key;
  string str, msg = "";
  mapping db = SELLD->query_type_items();
  string *obj_type = SELLD->query_obj_type();

  if (!mapp(db) || db == ([]) || !obj_type) return 0;

  //检查类型
  size = sizeof(obj_type);
  for (i = 0; i < size; i++) {
    if (type == obj_type[i]) {
      type_ok = 1;
      break;
    }
  }
  if (!type_ok) return 0;

  key = keys(db);
  size = sizeof(key);
  for (i = 0; i < size; i++) {
    if (db[key[i]][0] == type) {
      if (!bb) {
        msg += sprintf(BBLU HIW "%-12s   %-43s %5d\n" NOR, key[i], db[key[i]][1], db[key[i]][3]);
        bb = 1;
      } else {
        msg += sprintf(BCYN BLK "%-12s   %-43s %5d\n" NOR, key[i], db[key[i]][1], db[key[i]][3]);
        bb = 0;
      }
    }
  }

  if (msg != "") {
    str = sprintf(HIY "浴血珍宝铺 %s道具列表：\n" NOR, type);
    str += "   物品名                   物品描述                价格(浴血币)\n";
    str += "-----------------------------------------------------------------\n";
    str += msg;
    str += "-----------------------------------------------------------------\n";
    str += "购买使用buy <道具名称>\n";
    me->start_more(str);
  } else {
    tell_object(me, sprintf("浴血珍宝铺里的%s没有任何道具出售。\n", type));
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: list <ID>
 
列出一个玩家商人正在出售的商品。
 
HELP);
  return 1;
}
