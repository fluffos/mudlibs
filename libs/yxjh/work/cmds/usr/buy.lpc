//浴血江湖 buy.c
//edit by rock
//2010.8.15
#include <ansi.h>
#include <localtime.h>

#define SELLD "/adm/daemons/selllist"
#define dazhe 8

int main(object me, string arg)
{
	mapping db=SELLD->query_type_items();
	string path;
	object item;
	int money;
	mixed locaTime;
	object wiz;

	if(!mapp(db) || db == ([])) return 0;
	
	if(!db[arg]) return 0;

	if(!money = to_int(db[arg][3] || money < 1))
	{
		log_file("sell_err.txt",sprintf("\n%O\n没有价格\n",db[arg]));
		return notify_fail("道具出错，请联系巫师。\n");
	}

	if(dazhe) money = money*dazhe/10;

	if(!me->query("points") || me->query("points") < money)
		return notify_fail("你的余额不足，请充值。\n");

	if(path=db[arg][2] || path != "")
	{
		if(item = new(path))
		{
			item->set("no_give",1);
			item->set("owner",me->query("id"));
			item->move(me);
			locaTime = localtime(time());
			me->add("points",-money);
			if(wiz = find_player("boos")) tell_object(wiz,sprintf(HIR"【收费道具】%s(%s) 购买 %s %s 花费 %d浴血币\n"NOR,me->query("name"), me->query("id"), arg,path,money));
			if(wiz = find_player("rock")) tell_object(wiz,sprintf(HIR"【收费道具】%s(%s) 购买 %s %s 花费 %d浴血币\n"NOR,me->query("name"), me->query("id"), arg,path,money));
			log_file("sell.txt",sprintf("%d年%d月%d日%d时%d分 %s(%s) 购买 %s %s 花费 %d\n", locaTime[LT_YEAR],locaTime[LT_MON]+1,locaTime[LT_MDAY],locaTime[LT_HOUR],locaTime[LT_MIN], me->query("name"), me->query("id"), arg,path,money));
			me->add("jym_level/buy_add",money);
			if(dazhe) return notify_fail(sprintf(HIW"你购买了 [%s] 打%d折 合计花费 %d 浴血币。\n"NOR,arg,dazhe,money));
			else return notify_fail(sprintf(HIW"你购买了 [%s] 花费 %d 浴血币。\n"NOR,arg,money));
		}
		else
		{
			log_file("sell_err.txt",sprintf("\n%O\n没法new()\n",db[arg]));
			return notify_fail("文件损坏或被删除，请联系巫师。\n");
		}
	}
	else
	{
		log_file("sell_err.txt",sprintf("\n%O\n数据不对，找不到文件路径\n",db[arg]));
		return notify_fail("找不到物品路径，请联系巫师。\n");
	}

}