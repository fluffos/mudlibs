string status_color(int current, int max);

int skill_level(object me)
{
	int skill = 10;
	int exp = me->query_exp();
	int index;

	while(1)
	{
		index = (skill/10)*(skill/10)*(skill/10);
		if(index < 0) index = 1700000001;
		if(index >= exp)
		{
			return skill;
		}
		else skill ++;
	}
}

