#include <ansi.h>
#include <localtime.h>

void do_nian_time(string arg, object me);
void do_yue_time(string arg, object me);
int is_ok = 0;

int main(object me, string arg) {
  if (!arg && arg != "包月" && arg != "包年") return notify_fail("你要提升为哪类VIP，包年、包月？\n");

  if (me->query("vip_yue")) {
    tell_object(me, HIW "你的包月VIP权限没到期，是否确定续时(y/n)？\n" NOR);

    if (arg == "包年") input_to("do_nian_time", me);
    else if (arg == "包月") input_to("do_yue_time", me);
  } else if (me->query("vip_nian")) {
    tell_object(me, HIW "你的VIP权限没到期，是否确定续时(y/n)？\n" NOR);

    if (arg == "包年") input_to("do_nian_time", me);
    else if (arg == "包月") input_to("do_yue_time", me);
  } else {
    if (arg == "包年") {
      is_ok = 1;
      do_nian_time("y", me);
    } else if (arg == "包月") do_yue_time("y", me);
  }
  return 1;
}

void give_item(object me) {
  if (me->query_level() < 150) {
    me->delete("jym_level/level");
    me->set("jym_level/zhuan", 1);
    tell_object(me, HIG "你升到了150级。\n" NOR);
  } else me->add("jym_level/level", 50);
  tell_object(me, HIG "你提升了等级50级。\n" NOR);

  me->delete("learned_points");
  me->add("potential", 100000000);
  me->add("jym_money", 1000000);
  tell_object(me, HIY "你获得了1亿潜能。\n" NOR);
  tell_object(me, HIM "你获得了1百万元宝。\n" NOR);
}

void do_nian_time(string arg, object me) {
  int time, money;
  mixed localtime;

  if (arg != "y" && arg != "Y") {
    tell_object(me, HIW "充值VIP已取消\n" NOR);
    return;
  }
  money = me->query("points");
  if (money < 2200) {
    tell_object(me, "你的浴血币不足，请充值。\n");
    return;
  }

  if (!me->query("jym_level/vip_time")) time = time() + 24 * 3600 * 365;
  else time = me->query("jym_level/vip_time") + 24 * 3600 * 365;
  localtime = localtime(time);

  me->delete("vip_nian");
  me->delete("vip_yue");

  me->add("jym_level/vip", 1);
  me->set("vip_nian", 1);
  me->add("points", -2200);
  me->set("jym_level/vip_time", time);

  message_vision(BLINK + HIR "$N成为了浴血江湖包年VIP会员!恭喜恭喜\n" NOR, me);
  tell_object(
    me,
    sprintf(
      HIG "贵宾权限到期时间%d年%d月%d日%d时%d分%d秒。\n" NOR,
      localtime[LT_YEAR],
      1 + localtime[LT_MON],
      localtime[LT_MDAY],
      localtime[LT_HOUR],
      localtime[LT_MIN],
      localtime[LT_SEC]
    )
  );
  log_file(
    "sell.txt",
    sprintf(
      "%d年%d月%d日%d时%d分 %s(%s) 购买包年VIP 花费 %d\n",
      localtime[LT_YEAR],
      localtime[LT_MON] + 1,
      localtime[LT_MDAY],
      localtime[LT_HOUR],
      localtime[LT_MIN],
      me->query("name"),
      me->query("id"),
      2200
    )
  );
  if (is_ok) give_item(me);
}

void do_yue_time(string arg, object me) {
  int time, money;
  mixed localtime;

  if (arg != "y" && arg != "Y") {
    tell_object(me, HIW "充值VIP已取消\n" NOR);
    return;
  }

  money = me->query("points");
  if (money < 200) {
    tell_object(me, "你的浴血币不足，请充值。\n");
    return;
  }

  if (!me->query("jym_level/vip_time")) time = time() + 24 * 3600 * 30;
  else time = me->query("jym_level/vip_time") + 24 * 3600 * 30;
  localtime = localtime(time);

  me->delete("vip_nian");
  me->delete("vip_yue");

  me->add("jym_level/vip", 1);
  me->set("vip_yue", 1);
  me->add("points", -200);
  me->set("jym_level/vip_time", time);

  message_vision(BLINK + HIR "$N成为了浴血江湖包月VIP会员!恭喜恭喜\n" NOR, me);
  tell_object(
    me,
    sprintf(
      HIG "贵宾权限到期时间%d年%d月%d日%d时%d分%d秒。\n" NOR,
      localtime[LT_YEAR],
      1 + localtime[LT_MON],
      localtime[LT_MDAY],
      localtime[LT_HOUR],
      localtime[LT_MIN],
      localtime[LT_SEC]
    )
  );
  log_file(
    "sell.txt",
    sprintf(
      "%d年%d月%d日%d时%d分 %s(%s) 购买包月VIP 花费 %d\n",
      localtime[LT_YEAR],
      localtime[LT_MON] + 1,
      localtime[LT_MDAY],
      localtime[LT_HOUR],
      localtime[LT_MIN],
      me->query("name"),
      me->query("id"),
      200
    )
  );
}
