// recover.c
inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg)
{
	seteuid(geteuid(me));
	if (arg && (arg=="?" || arg=="/?")) return help(me);
	me->set("eff_jing",me->query_max_jing());
	me->set("jing",me->query_max_jing());
	me->set("eff_qi",me->query_max_hp());
	me->set("qi",me->query_max_hp());
	if (me->query("neili")<me->query_max_neili())
		me->set("neili",me->query_max_neili());
	if (me->query("jingli")<me->query_max_jingli())
		me->set("jingli",me->query_max_jingli());
    me->set("food",me->max_food_capacity()*10);
    me->set("water",me->max_water_capacity()*10);
    me->start_busy(0);
	write("OK!\n");
	return 1;
}
int help(object me)
{
write(@HELP
指令格式 : recover
 
恢复自己的精气和内力的正常状态。 
HELP
    );
    return 1;
}
