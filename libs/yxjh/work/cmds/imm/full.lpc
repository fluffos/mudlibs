#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int jin, qi, jinli, neili, shiwu, yinshui;
  object ob;

  if (!arg)
    ob = me;
  else
    ob = find_player(arg);

  if (!ob)
    return notify_fail("找不到这个玩家。\n");


  if (ob != me && wiz_level(me) <= wiz_level("(wizard)"))
    return notify_fail("你只能使用找个指令恢复自己的状态。\n");

  //精力
  ob->set("jingli", ob->query_max_jingli());
  //精神
  ob->set("eff_jing", ob->query_max_jing());
  ob->set("jing", ob->query_max_jing());
  //内力
  ob->set("neili", ob->query_max_neili());
  //气血
  ob->set("eff_qi", ob->query_max_hp());
  ob->set("qi", ob->query_max_hp());

  //食物、饮水
  ob->set("food", ob->max_food_capacity());
  ob->set("water", ob->max_water_capacity());

  if (ob != me) {
    write("你将" + ob->name(1) + "的状态恢复完毕！\n");
    tell_object(ob, me->name(1) + "将你的状态恢复完毕！\n");
    /*
                CHANNEL_D->do_channel(find_object(COMBAT_D),"sys",
                sprintf(HIM+"%s(%s)将%s(%s)的状态恢复。\n"NOR,
                        me->name(1),me->query("id"),
                        ob->name(1),ob->query("id")));
*/
    log_file("full", sprintf("%s(%s) full %s(%s)\n",
      me->name(1), me->query("id"),
      ob->name(1), ob->query("id")));
  } else
    write("你的状态恢复完毕！\n");

  return 1;
}

int help() {
  write(@TEXT
指令格式：full
这个指令让你加满精气神。
TEXT
  );
  return 1;
}
