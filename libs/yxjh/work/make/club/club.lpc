// 自动生成：/make/weapon/blade

#include <weapon.h>
#include <ansi.h>
inherit CLUB;

// 函数：所属类别
int query_xy() { return 1; }

// 函数：构造处理
void create() {
  set_name("%s", ({ "%s" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");           //量词
    set("flag", % d);              //单手双手
    set("material", "iron");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
    set("level", % d);            //装备等级
    set("value", % d);             //价值
    set("dp", % d);                //防御
    set("pp", % d);                //追加防御
    set("ap", % d);                //追加攻击
  }
  set("max_lasting", % d);   //耐久度
  init_club(% d);
  setup();

  set("gender", "%s");    //限制性别
}

#include "/clone/shoufei/long/weapon.h"
