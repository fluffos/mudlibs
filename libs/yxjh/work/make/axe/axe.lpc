// 自动生成：/make/weapon/blade

#include <weapon.h>
#include <ansi.h>
inherit AXE;

// 函数：所属类别
int query_xy() { return 1; }

// 函数：构造处理
void create() {
  set_name("%s", ({ "%s" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");           //量词
    set("flag", % d);              //单手双手
    set("material", "steel");
    set("wield_msg", "$N双手提起$n。\n");
    set("unwield_msg", "$N放下$n。\n");
  );
  set("level", % d);            //装备等级
  set("value", % d);             //价值
  set("dp", % d);                //防御
  set("pp", % d);                //追加防御
  set("ap", % d);                //追加攻击
}
set("max_lasting", % d);   //耐久度
init_axe(% d);
setup();

set("gender", "%s");    //限制性别
}

#include "/clone/shoufei/long/weapon.h"
