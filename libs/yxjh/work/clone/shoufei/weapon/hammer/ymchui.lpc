// 自动生成：/make/weapon/blade

#include <weapon.h>
#include <ansi.h>
inherit HAMMER;

// 函数：所属类别
int query_xy() { return 1; }

// 函数：构造处理
void create() {
  set_name("幽冥锤", ({ "ymchui" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");           //量词
    set("flag", 1);              //单手双手
    set("material", "iron");
    set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
    set("level", 30);            //装备等级
    set("value", 6000);             //价值
    set("dp", 0);                //防御
    set("pp", -35);                //追加防御
    set("ap", 0);                //追加攻击
  }
  set("max_lasting", 18000);   //耐久度
  init_hammer(210);
  setup();

  set("gender", "男、女");    //限制性别
}

#include "/clone/shoufei/long/weapon.h"
