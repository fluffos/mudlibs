#include <weapon.h>
#include <ansi.h>
inherit SWORD;

// 函数：所属类别
int query_xy() { return 1 ; }

// 函数：构造处理
void create()
{
        set_name("长萧",({"cxiao"}));
        set_weight(5000);
        if( clonep() )
        set_default_object(__FILE__);
        else {
		set("unit", "柄");           //量词
		set("flag",2);              //单手双手
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回腰间。\n");
		set("level", 0);            //装备等级
		set("value",450);             //价值
		set("dp",0);                //防御
		set("pp",28);                //追加防御
		set("ap",0);                //追加攻击
             }
	set("max_lasting",6000);   //耐久度
	init_sword(35);
        setup();

        set("gender","男、女");    //限制性别
}

#include "/clone/shoufei/long/weapon.h"