// 自动生成：/make/equip/makesuit

#include <armor.h>
#include <ansi.h>

inherit WAIST;
int query_xy() { return 1; }
//套装组件标志
int is_suit() { return 1; }
//第几套
int get_equip_serial() { return 1; }  //第几套
// 函数：适用门派
string get_family() { return "邪魔外道"; }
//套装名字
string get_suit_name() { return "邪神"; }  //属于某某套装
// 函数：构造处理
void create() {
  set_name("邪神腰带", ({ "xs waist" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("level", 600);            //装备等级
    set("unit", "个");           //量词
    set("material", "waist");
    set("value", 99999999);             //价值
    set("armor_prop/armor", 218);  //物理防御
  }
  set("max_lasting", 20000);   //耐久度

  setup();

  set("gender", "男、女");    //限制性别
}

#include "/clone/shoufei/long/armor.h"
