#include <ansi.h>

#include <armor.h>
#include <mudlib.h>
inherit NECK;

void create()
{
        set_name(HIM "法藤项圈" NOR, ({ "fateng necklace", "necklace" }));
        set("weight", 400);
        if (clonep())
                set_default_object(__FILE__);
        else {
             set("long", "这是传说中的法藤项圈,可增加防御力600,悟性15,下线不掉。\n");
                set("unit", "串");
              set("points",3);
		set("no_put",1);
              set("no_sell",1);
              set("no_get", 1);
              set("no_give", 1);

              set("no_drop",1); 
                set("material", "gold");
                set("armor_prop/armor", 600);
        set("armor_prop/intelligence", 15);

        }
        setup();
}   
