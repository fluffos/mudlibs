inherit ITEM;

void create() {
  set_name(HIR "魔睛烛舞铁" NOR, ({ "zhuwu tie" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("value", 200000);
  set("points", 2);
  //   set("no_put",1);
  //   set("no_give",1);
  set("zhongji_hc", 1);
  set("int", 145);
  set("str", 115);
  set("dex", 115);
  set("con", 145);
  set("bh", 4);
  set("damage", 450);
  set("long", "这是一个差不多绝种的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
