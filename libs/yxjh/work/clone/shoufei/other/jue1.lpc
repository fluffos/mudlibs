inherit ITEM;

void create() {
  set_name(HIB "方舟流星石" NOR, ({ "rock shi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("points", 2);
  set("no_get", 1);
  set("value", 200000);
  //   set("no_put",1);
  //   set("no_give",1);
  set("zhongji_hc", 1);
  set("int", 135);
  set("str", 125);
  set("dex", 130);
  set("con", 120);
  set("bh", 1);
  set("damage", 450);
  set("long", "这是一个差不多绝种的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
