#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "干将令" NOR, ({ "ganjiang ling", "ling", "ganjiang" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "干将令，可将你的合成武器由blade转换为sword，或由sword转换为blade的令牌{use ling}\n");
    //              set("no_put",1);
    set("no_sell", 1);
    set("no_get", 1);
    //              set("no_give", 1);
    set("no_drop", 1);
    set("points", 4);
    set("unit", "块");
  }
}

void init() {
  add_action("do_eat", "use");
}

int do_eat(string arg) {
  object me;


  me = this_player();

  if (!me->query("hecheng"))
    return notify_fail("你还没有合成武器！\n");
  if (present("" + me->query("hecheng/id") + "", this_player()))
    return notify_fail("你的合成兵器不是正在你身上吗？请到gc,d那扔掉合成武器再使用！\n");

  if (arg == "sword") {
    me->set("hecheng/id", "hecheng sword");
    me->set("hecheng/lb", "sword");
    tell_object(me, HIG "恭喜你！你的合成武器已重铸为sword。\n");
    destruct(this_object());
    return 1;

  }
  if (arg == "blade") {

    me->set("hecheng/id", "hecheng blade");
    me->set("hecheng/lb", "blade");
    tell_object(me, HIG "恭喜你！你的合成武器已重铸为blade。\n");
    destruct(this_object());
    return 1;

  }
}
