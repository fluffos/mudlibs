inherit ITEM;
inherit F_SAVE;

string id;
void create(string name)
{
id=name;
if(!restore_object("/data/city/"+name+".o"))
{
set("owner",0);
set_name("无效城市", ({ "city" }));
}else {
seteuid(ROOT_UID);
                }
        setup();
}
string query_save_file()
{
return sprintf(DATA_DIR "city/%s",id);
}

