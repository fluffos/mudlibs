dbase (["gender":"男性","max_qi":202,"neili":0,"id":"gu yanwu","name":"顾炎武","long":"顾先生被称为当世第一大文学家，肚子里的墨水比海还要深。","default_actions":,"eff_qi":202,"race":"人类","qi":202,"max_jingli":40000,"per":28,"combat_exp":400000,"shen_type":1,"kar":10,"last_save":1286496416,"actions":,"jingli":40000,"shen":40000,"zhengzhao":1,"dex":18,"jing":40000,"con":17,"chat_msg":({"顾炎武说道：普天之下，莫非王土；率土之滨，莫非王臣。","顾炎武说道：出家人，小过损益焉；无妄大过，未济咸困之。","顾炎武说道：大学之道，在明明德。在亲民，在止于至善。 ","顾炎武说道：格物致知，诚意正心，修身齐家，治国平天下。",}),"water":329,"pighead":0,"int":13,"str":24,"chat_chance":3,"food":329,"age":65,"startroom":"/d/city2/shuyuan","no_suck":1,"max_jing":40000,"eff_jing":40000,])
