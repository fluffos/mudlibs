dbase (["chat_msg":({"钱老本说道：我叫钱老本，就是因为做生意连老本也赔了。","钱老本笑着说道：在本店存钱利息至少百分之一，客官您只管存吧。","钱老本说：只有对本派弟子我才这么客气，对别的人啊，哼哼......","钱老本突然说道: 江湖威望很重要，威望值高大有好处啊。","钱老本突然说：五人分开一首诗，身上洪英无人知。",}),"shen":0,"jizhi":55,"title":"钱庄老板","zhongcheng":15,"age":34,"food":17,"attitude":"friendly","name":"钱老本","zhengzhao":2,"water":17,"gender":"男性","ziyuan":"黄金","startroom":"/yxjh/d/city2/qianzhua","str":22,"int":24,"bellicosity":0,"eff_qi":500,"pighead":0,"con":18,"id":"qian laoben","eff_jing":100,"neili":0,"dex":18,"kar":22,"per":16,"qi":500,"channel":(["last_say":1283091674,"say_count":1,]),"max_jing":100,"race":"人类","shen_type":1,"inquiry":(["入会":"只要入了我天地会，可以向会中各位好手学武艺。","利息":"想要利息先入会！","加入":"只要入了我天地会，可以向会中各位好手学武艺。","威望":,"天地会":"只要是英雄好汉，都可以入我天地会(join tiandihui)。","江湖威望":,"陈近南":"想见总舵主可没那么容易。",]),"shiyong":(["cloth":"cloth",]),"actions":,"max_zhongcheng":95,"env":(["wimpy":50,]),"armor":(["cloth":(["equip_id":"cloth",]),]),"jing":100,"eff_jingli":0,"jingli":0,"default_actions":,"last_save":1283000348,"combat_exp":50000,"area_name":"京城钱庄","kaifa":40,"chat_chance":5,"area_file":"/yxjh/d/city2/qianzhua.c","max_qi":500,])
