dbase (["chat_msg":({"钱开眼骄傲的说道：本银号已经有上百年的历史，在大理可以说是第一家。","钱开眼说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。钱开眼笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。钱开眼笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。","钱开眼笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。","钱开眼微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。",}),"max_qi":220,"title":"钱庄老板","nickname":"[34m一毛不拨[2;37;0m","age":34,"food":33,"kaifa":40,"jizhi":55,"name":"钱开眼","zhengzhao":1,"area_name":"大理钱庄","gender":"男性","water":33,"max_jing":200,"startroom":"/yxjh/d/dali/qianzhuang","area_file":"/yxjh/d/dali/npc/qian.c","max_neili":100,"ziyuan":"黄金","str":100,"actions":,"no_put":1,"int":24,"id":"qian kaiyan","con":18,"dex":18,"default_actions":,"kar":14,"pighead":0,"zhongcheng":21,"max_zhongcheng":90,"per":28,"qi":220,"jiali":10,"neili":200,"shiyong":(["cloth":"cloth",]),"race":"人类","shen_type":1,"shen":0,"env":(["wimpy":50,]),"jing":200,"armor":(["cloth":(["equip_id":"cloth",]),]),"eff_jingli":0,"jingli":0,"last_save":1283012759,"attitude":"friendly","combat_exp":12500,"eff_qi":220,"eff_jing":200,"chat_chance":2,"bellicosity":0,])
