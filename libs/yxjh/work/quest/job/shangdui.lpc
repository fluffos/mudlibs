//snowman 28/02/98
#include <ansi.h>
inherit ITEM;
int do_back(object me);
int j=3+random(4);
void create()
{
        set_name("长风镖队", ({ "changfeng"}));
        set("unit", "只");
        set_weight(90000000);
        set("long", "
一只远道而来的镖队，上面堆满了货物。中间插
着一面镖旗，似乎写着“长风镖局”四个大字。。。\n");
        set("no_get", 1);
        set("no_drop", 1);
	 set("no_put",1);  
        set("no_clean_up", 1);
      
}

void init()
{  
  remove_call_out("checking");
  call_out("checking", 300, this_object());  
  add_action("do_rob", "qiang");
}

int checking(object ob, object me)
{
	if(!me || !present(me, environment())) do_back(ob);
	else call_out("checking", 2, ob, me);
        return 1;
}

int do_rob()
{
   object me, ob; 
   object obj, obj1,*killer;  
   string arg;
   int i, name,flag,score;
   me = this_player();
   ob = this_object();
  
   name=me->query("id");   
   arg = query("arg");
   if(!living(me)) return 0;
   if(!me->query_temp("rob_start")) 
       return notify_fail("你胆子不小，竟敢在长风镖局头上打注意？\n");
   if (ob->query("owner")!=name)
       return notify_fail("这只镖队不是你的目标！\n");  
    flag=0;
    killer=all_inventory(environment(me));
    for(i=0;i<sizeof(killer);i++)
        {
        if(objectp(killer[i]) 
          && killer[i]->query_temp("username")==me->query("id"))
         flag=1;
        }
  if (flag)       
        return notify_fail("护镖镖师看来武功不弱，你还是先打发了面前这个再说吧！\n"); 

   if (j>0){
         message_vision(HIY"$N对着$n大吼一声："+me->name()+"在此！留下你们的钱财来！\n"NOR, me, ob);
         me->set_temp("xx_rob", 1);
         obj = new(__DIR__"biaoshi");
         obj->set_temp("username",name);
         obj->move(environment(me));
	  obj->do_copy(me);
         obj1 = new(__DIR__"biaoshi");
         obj1->set_temp("username",name);
         obj1->move(environment(me));
 	  obj1->do_copy(me);
         j=j-1;  
     } else {  
       message_vision(HIW"$N见镖队的货物已经无人保护，将所带的财物全都拿在怀里！\n"NOR, me);    
       obj=new(__DIR__"red");
       obj->move(me);
       obj->set("owner", me->query("id"));
       score=random(5000);       
       me->add("score", score);
       me->add("shen", -100);
	tell_object(me,HIC"你被奖励了"+chinese_number(score)+"点综合评价。\n"NOR);
       me->delete_temp("rob_start");
       me->delete_temp("xx_rob");
       me->delete_temp("rob_job");
       me->delete_temp("j");  
       remove_call_out("checking");
       message_vision("$N转过几个小山丘就不见了。\n",ob);
       destruct(ob);  
}
        return 1;     
}
int do_back(object me)
{            
       message_vision("$N转过几个小山丘就不见了。\n",me);       
       destruct(me);     
}
