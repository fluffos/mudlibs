#include <armor.h>

inherit CLOTH;

void create() {
  set_name("大还丹", ({ "dan" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "风云第一的奖品 用法：boost\n");
    set("unit", "颗");
    set("value", 5000000);
    set("no_drop", 1);
  }
  setup();
}
