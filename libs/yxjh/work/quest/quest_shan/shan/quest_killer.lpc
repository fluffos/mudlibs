void create() {
  string id1, id2, id3, idf1, idf2;
  string name1, name2;
  int i, skill, skill_lvl, basic_radio, basic_skill, index, index1, index2, nl, dengji;
  object me = this_player();
  mapping mp, skills;
  string *basic = ({ "dodge", "unarmed", "force", "parry", "finger", "hand",
    "strike", "taoism", "club", "staff", "fork", "hammer",
    "blade", "cuff", "axe", "sword", "whip", "dagger",
    "throwing", "claw", "poison" });
  int ratio = 100;
  string *chat_chance_combat_here = ({});

  index1 = random(sizeof(first_name));
  index2 = random(sizeof(first_name));
  name1 = first_name[index1]["name"];
  name2 = first_name[index2]["name"];
  id1 = first_name[index1]["id"];
  id2 = first_name[index2]["id"];
  idf1 = id1;
  idf2 = id2;
  index1 = random(sizeof(second_name1));
  index2 = random(sizeof(second_name2));
  name1 += second_name1[index1]["name"];
  name2 += second_name2[index2]["name"];
  id1 += " " + second_name1[index1]["id"];
  id2 += " " + second_name2[index2]["id"];


  index1 = random(sizeof(third_name1));
  index2 = random(sizeof(third_name2));
  name1 += third_name1[index1]["name"];
  name2 += third_name2[index2]["name"];
  id1 += third_name1[index1]["id"];
  id2 += third_name2[index2]["id"];

  set_name(name1, ({ id1, idf1 }));
  index = random(sizeof(menpai));
  mp = menpai[index];
  if (mp["gender"]) set("gender", mp["gender"]);
  if (query("gender") == "女性") set_name(name2, ({ id2, idf2 }));
  if (mp["class"]) set("class", mp["class"]);
  if (mp["family"]) set("family/family_name2", mp["family"]);
  set("title", HIB "杀人狂魔" NOR);

  ratio = 80 + random(me->query_temp("shan_quest/count") * 3 + 1);

  //here begin to set_skill of this_object()
  skill = 0;
  /*
        skills=me->query_skills();        
        if (sizeof(skills))
        {
        for (i=0;i<sizeof(keys(skills));i++)
                if (skills[keys(skills)[i]]>=skill) 
                        skill=skills[keys(skills)[i]];
        }
        if(skill>get_level(me->query_exp()))
        skill=get_level(me->query_exp());
        skill_lvl = get_level((int)me->query_exp()) - skill;
        if(skill_lvl < 0)
                skill_lvl = 0;
        basic_skill=skill*ratio/100;
        if(basic_skill-skill > 60)  
                basic_skill=skill + 60;
        skill=basic_skill + skill_lvl/4;
*/
  skill = me->query_skill("dodge", 1) / 100 + me->query("jym_level/level") * 10;
  if (skill > 5000) skill = 5000;
  if (skill < 50) skill = 50;
  if (skill < 10) skill = (50 + skill) / 3;

  for (i = 0; i < sizeof(keys(mp)); i++) {
    if (member_array(keys(mp)[i], basic) != -1) {
      set_skill(keys(mp)[i], skill);
      set_skill(mp[keys(mp)[i]], skill);
      map_skill(keys(mp)[i], mp[keys(mp)[i]]);
    }
  }

  if (mp["family"] == "全真教")
    set_skill("xiantian-gong", skill);
  if (mp["family"] == "古墓派") {
    set_skill("quanzhen-jianfa", skill);
    set_skill("hubo", skill);
    set_skill("tianluo-diwang", skill);
  }
  if (mp["family"] == "星宿派")
    set_skill("beiming-zhenqi", skill);
  if (mp["class"] == "taoist")
    set_skill("taoism", skill);
  if (mp["family"] == "峨嵋派")
    set_skill("mahayana", skill);
  if (mp["family"] == "少林派")
    set_skill("buddhism", skill);
  if (mp["family"] == "五毒教")
    set_skill("duji", skill);

  if (mp["prepare1"])
    prepare_skill(mp["prepare1"], query_skill_mapped(mp["prepare1"]));
  if (mp["prepare2"])
    prepare_skill(mp["prepare2"], query_skill_mapped(mp["prepare2"]));
  set("chat_chance_combat", 50);
  if (mp["perform1"])
    chat_chance_combat_here += ({ (: perform_action, mp["perform1"] :) });
  if (mp["perform2"])
    chat_chance_combat_here += ({ (: perform_action, mp["perform2"] :) });
  if (mp["perform3"])
    chat_chance_combat_here += ({ (: perform_action, mp["perform3"] :) });
  if (mp["perform4"])
    chat_chance_combat_here += ({ (: perform_action, mp["perform4"] :) });

  if (mp["exert1"])
    chat_chance_combat_here += ({ (: exert_function, mp["exert1"] :) });
  if (mp["exert2"])
    chat_chance_combat_here += ({ (: exert_function, mp["exert2"] :) });
  if (mp["exert3"])
    chat_chance_combat_here += ({ (: exert_function, mp["exert3"] :) });
  if (mp["exert4"])
    chat_chance_combat_here += ({ (: exert_function, mp["exert4"] :) });
  chat_chance_combat_here += ({ (: exert_function, "powerup" :) });
  chat_chance_combat_here += ({ (: exert_function, "recover" :) });

  set("chat_msg_combat", chat_chance_combat_here);
  set("str", (me->query("jym_level/level") * 2));
  set("con", (me->query("jym_level/level") * 2));
  set("dex", (me->query("jym_level/level") * 2));

  set("chat_chance", 5);


  dengji = me->query("jym_level/level") / 2 + 1;
  if (dengji < 0) dengji = 1;
  set("jym_level/level", dengji);
  basic_radio = me->query_max_hp() / 500 + 1;

  if (me->query_max_neili() < 80)
    nl = 100;
  else nl = me->query_max_neili();
  set("max_neili", me->query("jym_level/level") * 100000);
  set("neili", me->query("jym_level/level") * 100000);
  set("max_jingli", me->query_max_jingli() * ratio / 100);
  basic_radio = me->query_max_neili() / 500;
  set("jiali", me->query_max_neili() / (20 + 5 * basic_radio));
  set("killer", me->query("id"));
  if (me->query("jym_level/level") > 30) { set("max_qi", query_max_neili() / 2); }
  if (me->query("jym_level/level") > 80) { set("max_qi", query_max_neili()); }
  if (me->query("jym_level/level") < 31) { set("max_qi", query_max_neili() / 4); }
  //        set("max_qi",me->query("jym_level/level")*80000);
  set("qi", query_max_hp());
  set("eff_qi", query_max_hp());
  set("max_jing", me->query("jym_level/level") * 50000);
  set("jing", query_max_jing());
  set("fight_till_die", 1);
  set("eff_jing", query_max_jing());
  set("no_dun", 1);
  set("food", 500);
  set("water", 500);
  set("combat_exp", me->query_exp());

  set("is_quest", 1);
  setup();

  if (mp["weapon"])
    carry_object(mp["weapon"])->wield();
  //        if(random(10)>8) carry_object(__DIR__"obj/tiejia")->wear();
  //        else carry_object(__DIR__"obj/armor")->wear(); 
}

void init() {
  object ob, baixing, env;
  object killer = this_object();
  command("yun powerup");
  ob = this_player();
  if (!this_object()->query("killer"))
    return;

  if (ob->query("id") == query("killer"))
    if (ob->query_temp("shan_quest/being_inquiry")) {
      killer->fight_ob(ob);
      ob->fight_ob(killer);
      COMBAT_D->do_attack(killer, ob, killer->query_temp("weapon"), 0);
      killer->command("halt");

      message_vision(
        HIB "$n一看到$N, 不由分说，抄出家伙给你一记后，立马溜之大吉！\n"
        NOR, ob, killer);
      //      place_room(ob,killer);
      ob->set_temp("shan_quest/inquiry", 1);
    } else if (ob->query_temp("shan_quest/being_chased")
      && !killer->query("baixing")) {
      message_vision(
        HIB "$n一看到$N，冷笑了一声: “又一个活得不耐烦的家伙，自寻死路！”"
        + " \n" NOR, ob, killer);
      this_object()->kill_ob(ob);
      ob->kill_ob(this_object());

      remove_call_out("kill_baixing");
      call_out("kill_baixing", 0, ob);
    } else {
      message_vision(
        HIB "$n不屑地朝$N说道: “原来就是你一直在妨碍老子杀人！人我早杀完了，\n"
        + "你就来收尸吧，不过就不知道谁能帮你收尸了！” \n" NOR, ob, killer);
      command("heihei " + ob->query("id"));

      this_object()->set_leader(ob);
      this_object()->kill_ob(ob);
      ob->kill_ob(this_object());
    }

  if (this_object()->query("jiali") == 0)
    set("jiali", (int)this_object()->query_skill("force") / 6);

  if (this_object()->query("killer") != ob->query("id")) {
    add_action("do_kill", "team kill");
    add_action("do_kill", "kill");
    add_action("do_kill", "hit");
    add_action("do_kill", "fight");
    add_action("do_kill", "touxi");
    add_action("do_kill", "steal");
    add_action("do_kill", "beg");
    add_action("do_kill", "persuade");
  }

}


void start_escape(object ob, object me) {
  call_out("escape_me", 300, ob, me);
}

int do_kill(string arg) {
  string what, who;
  object ob;
  ob = this_player();

  if (!arg) return 0;

  if (this_object()->id(arg)) {
    write("江湖人士，还是少惹为妙。\n");
    return 1;
  } else if (sscanf(arg, "%s from %s", what, who) == 2 && this_object()->id(who)) {
    write("还是到别处去施展你的本事吧。\n");
    return 1;
  }
  return 0;
}

void escape_me(object ob, object me) {
  if (objectp(me)) {
    me->delete_temp("shan_quest/being_chased");
    me->delete_temp("shan_quest/being_inquiry");
    me->delete_temp("shan_quest/inquiry");
    me->set_temp("shan_quest/have_task", 0);
    me->add("score", -random(3));
    me->set_temp("shan_quest/killed", ob->query("id"));

    // message_vision("$N狞笑了几声：“今天心情好，本大爷就放过你，不陪你玩了。”说罢，一个筋斗跳出战圈，不知去向。\n",ob);

  }
  remove_call_out("kill_baixing");
  remove_call_out("bandit_send");
  remove_call_out("escape_me");
  destruct(ob);
}

void die() {
  int reward_exp, reward_pot, count;
  int rock;
  object killer, me, baixing;
  me = this_object();
  killer = me->query_temp("last_damage_from");
  message_vision(HIC "$N惨嚎一声，口喷鲜血，到在地上死了。\n" NOR, me);

  if (killer && killer->query("id") == me->query("killer")) {
    if ((int)killer->query_temp("shan_quest/count") <
      (int)killer->query_temp("shan_quest/quest_cancel") * 2)
      count = (int)killer->query_temp("shan_quest/count") / 2;
    else
      count = (int)killer->query_temp("shan_quest/count") - (int)killer->query_temp("shan_quest/quest_cancel");

    reward_exp = killer->query_int() * 10 + count * 600;

    if (me->query("baixing")) {
      if (objectp(baixing = present(me->query("baixing", environment(me))))) {
        message_vision(CYN "$N对$n表示衷心的感谢！\n" NOR, baixing, killer);
        baixing->command("bye " + killer->query("id"));
        baixing->remove_call_out("escape_me");
        destruct(baixing);
      }
    }

    if (!me->query_temp("baixing_killed")) {
      killer->set_temp("shan_quest/succeed", 1);
      tell_object(killer,
        HIY "由于你的卓越表现，成功的解救了当地的百姓！\n" NOR);
    }
    /*
         if(killer->query("money") > 520000000){
                   killer->add("money",-500000000);
                   killer->add("jym_money",5);
tell_object(this_player(),HIR"系统自动把你的存款换成元宝了！\n"NOR);
}
*/
    if (killer->query("jym_level/level") < 11)
      reward_exp -= reward_exp / 5;
    if (reward_exp > 8000) reward_exp = 7809 + random(200);
    //           reward_exp=reward_exp/2+random(reward_exp/2);
    if (killer->query_temp("shan_quest/succeed") != 1) {
      tell_object(killer,
        HIW "由于你的失误，未能成功解救受害百姓，所得奖励大减！\n" NOR);
      reward_exp = reward_exp / 5;
    }
    reward_pot = reward_exp / 10;

    if (reward_pot > 1200) reward_pot = 988 + random(200);
    if (reward_pot < 0) reward_pot = 0;
    reward_exp = reward_exp - random(600);
    if (!killer->query_temp("shan_quest/being_chased")) {
      reward_exp = reward_exp / 10;
      reward_pot = reward_pot / 10;
      tell_object(killer,
        HIM "由于你没回答门派，奖励大大减少了！\n" NOR);

    }


    rock = 2500;
    tell_object(killer, HIW "在实战中，你获得了" +
      //833  CHINESE_D->chinese_number(rock) +"两『黄金』"+
      CHINESE_D->chinese_number(reward_exp) + "点的『实战经验』" +
      CHINESE_D->chinese_number(reward_pot) + "点的『潜能』！\n" NOR);
    killer->add("shan_quest/reward_exp", reward_exp);
    killer->add("shan_quest/reward_potential", reward_pot);
    ADD_EXP(killer, reward_exp);
    //839                     killer->add("money",25000000);
    killer->add("potential", reward_pot);
    killer->add("score", random(5));
    killer->add_temp("shan_quest/count", 1);
    killer->set_temp("shan_quest/killed", me->query("id"));
    killer->set_temp("shan_quest/killed_place_name",
      me->query("place_name"));
    killer->set_temp("shan_quest/wait_start", time());
    killer->set_temp("shan_quest/have_task", 0);
    killer->delete_temp("shan_quest/being_chased");
    killer->delete_temp("shan_quest/being_inquiry");
    killer->set_temp("shan_quest/succeed", 0);
    killer->delete_temp("shan_quest/bandit_time");
    killer->delete_temp("shan_quest/bandit");
  } else if (objectp(killer = find_living(me->query("killer")))) {
    killer->delete_temp("shan_quest/being_chased");
    killer->delete_temp("shan_quest/being_inquiry");
    killer->delete_temp("shan_quest/inquiry");
    killer->set_temp("shan_quest/have_task", 0);
    killer->add("score", -random(3));
    killer->set_temp("shan_quest/killed", me->query("id"));

  }
  remove_call_out("kill_baixing");
  remove_call_out("bandit_send");
  remove_call_out("escape_me");
  destruct(me);
  return;
}


int get_level(int exp) {
  int level = this_player()->query("jym_level/level") * 150;

  return level;
}

void start_chase(object ob) {
  call_out("bandit_send", 5, ob);
}

int bandit_send(object ob) {
  object killer;
  int t;

  if (!objectp(ob)) {
    remove_call_out("escape_me");
    remove_call_out("bandit_send");
    destruct(this_object());
    return 1;
  }

  t = ob->query("combat_exp") / 10000000;
  if (t < 1) t = 1;
  if (t > 5) t = 5;

  if (ob->is_ghost() && !ob->query_temp("linji/youming")) {
    remove_call_out("escape_me");
    remove_call_out("bandit_send");
    call_out("escape_me", 1, this_object(), ob);
    return 1;
  }

  if ((time() - ob->query_temp("shan_quest/bandit_time")) > 30 * t
    && ob->query_temp("shan_quest/bandit")) {
    killer = new(__DIR__ "quest_bandit");
    killer->set("killer", ob->query("id"));
    killer->move(environment(ob));
    ob->set_temp("shan_quest/bandit_time", time());
    ob->add_temp("shan_quest/bandit", -1);
    ob->start_busy(2);
    killer->do_fkill(ob);
  }

  remove_call_out("bandit_send");
  call_out("bandit_send", 10, ob);

  return 1;
}

void start_kill(object ob) {
  int t;
  if (!objectp(ob)) {
    remove_call_out("escape_me");
    remove_call_out("bandit_send");
    destruct(this_object());
    return;
  }
  t = ob->query("combat_exp") / 10000000;
  if (t < 1) t = 1;
  if (t > 5) t = 5;

  call_out("kill_baixing", 300, ob);
}

int kill_baixing(object ob) {
  object baixing;

  if (!this_object()->query("baixing")) {
    baixing = new(__DIR__ "baixing");
    baixing->set("waiting", ob->query("id"));
    baixing->move(environment(this_object()));

    this_object()->set_leader(baixing);
    baixing->set_leader(this_object());
    kill_ob(baixing);
    set("baixing", baixing->query("id"));
  }
  return 1;
}
