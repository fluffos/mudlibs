{
    int time;
      int dj,my_combat_exp;
    object me,biaoche;
    mapping biao;

    me=this_player();

//dj = me->query("jym_level/level")+(me->query("jym_level/zhuan")*150);
	dj = me->query_level();
    if ( me->query_temp("quest_yunbiao/have_task"))
{
 write(HIW"你上次的镖还没送到呢，怎么又来了？\n"NOR);
