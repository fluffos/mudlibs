     if(dj<2)
{
 write(HIW"运镖可是件危险的差使，还是练好了功夫再来吧！\n"NOR);
return 1;
}
//if( me->query_exp()>280000000 || my_combat_exp<0)
if( dj > 150  || me->query("max_neili") > 250000)
{
 write(HIW"这位老大已经这么厉害了,我这里小小镖局恐怕留不住您！\n"NOR);
