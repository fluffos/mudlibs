       ({HIB"长风镖局镖头"NOR+me->name()+"("+me->query("id")+")"})); 

    write(HIW"请在"+chinese_time(time)+"内，将镖车运送到"+biao["name"]+"。\n"NOR);
return 1;
}


string ask_biaodui()
{
    int time,i,my_dj,my_combat_exp,parter_dj,parter_combat_exp;
    object me,parter,biaoche,*team;
    mapping biao;

    me=this_player();

    if( !pointerp(team = me->query_team()))
       return "镖队需要人多一点才有保障，多叫些人手来吧！\n";

    i=sizeof(team);
    if(i>2) return "人多手杂，容易坏事！\n";

    if( objectp(team[0]) && objectp(team[1]))
    {
     if(team[0]==me) parter=team[1];
     else parter=team[0];
    }

    if( !objectp(parter) 
        || !present(parter->query("id"),environment(me)))
       return "还是约上你的同伴一起来吧！\n";

    if ( me->query_temp("quest_yunbiao/have_task"))
       return "你们上次的镖还没送到呢，怎么又来了？\n";


    my_dj = me->query("jym_level/level");
    parter_dj = parter->query("jym_level/level");
if (my_dj > 1)
{
if (my_dj == 2) my_combat_exp=(int)me->query_exp()+10000000;
if (my_dj == 3) my_combat_exp=(int)me->query_exp()+30000000;
if (my_dj == 4) my_combat_exp=(int)me->query_exp()+60000000;
if (my_dj == 5) my_combat_exp=(int)me->query_exp()+100000000;
if (my_dj == 6) my_combat_exp=(int)me->query_exp()+150000000;
if (my_dj == 7) my_combat_exp=(int)me->query_exp()+210000000;
if (my_dj == 8) my_combat_exp=(int)me->query_exp()+280000000;
if (my_dj == 9) my_combat_exp=(int)me->query_exp()+360000000;
if (my_dj == 10) my_combat_exp=(int)me->query_exp()+450000000;
if ( my_dj > 10 ) 
my_combat_exp=(int)me->query_exp()+(450000000+((my_dj-10)*100000000));
}
else {
my_combat_exp = (int)me->query_exp();
}

if (parter_dj >1)
{
if ( parter_dj == 2 ) parter_combat_exp=(int)parter->query("combat_exp")+10000000; 
if ( parter_dj == 3 ) parter_combat_exp=(int)parter->query("combat_exp")+30000000; 
if ( parter_dj == 4 ) parter_combat_exp=(int)parter->query("combat_exp")+60000000; 
if ( parter_dj == 5 ) parter_combat_exp=(int)parter->query("combat_exp")+100000000; 
if ( parter_dj == 6 ) parter_combat_exp=(int)parter->query("combat_exp")+150000000; 
if ( parter_dj == 7 ) parter_combat_exp=(int)parter->query("combat_exp")+210000000; 
if ( parter_dj == 8 ) parter_combat_exp=(int)parter->query("combat_exp")+280000000; 
if ( parter_dj == 9 ) parter_combat_exp=(int)parter->query("combat_exp")+360000000; 
if ( parter_dj == 10 ) parter_combat_exp=(int)parter->query("combat_exp")+450000000; 
if ( parter_dj > 10 ) 
parter_combat_exp=(int)parter->query("combat_exp")+(450000000+((parter_dj-10)*100000000));
}
else {
parter_combat_exp = (int)parter->query("combat_exp");
}


    if( parter->query("quest_yunbiao")
        && !parter->query_temp("quest_yunbiao/finished_time")
       && (time()-me->query("quest_yunbiao/start_time"))<600)
       return "你找这样无能的同伴当帮手，我可不放心把镖队交给你！\n";

    if( me->query_exp()<500000)
      return "运镖可是件危险的差使，还是练好了功夫再来吧！\n";

    if( parter->query("combat_exp")<500000)
      return "运镖可是件危险的差使，不要让你的同伴去送死了！\n";
if( my_combat_exp>200000000 || my_combat_exp <0)
 return "您的经验太高了,去选择别的任务来加经验吧！\n";    
if( parter_combat_exp>200000000 || parter_combat_exp<0)
 return "您的经验太高了,去选择别的任务来加经验吧！\n";    

    biao=yun_biao[random(sizeof(yun_biao))];
    time=biao["time"];
    me->set("quest_yunbiao/name",biao["name"]);
    me->set("quest_yunbiao/file",biao["file"]);
    me->set("quest_yunbiao/bonus",biao["bonus"]);
    me->set("quest_yunbiao/time",biao["time"]);
    me->set("quest_yunbiao/start_time",time());
    me->set_temp("quest_yunbiao/have_task",1);

    parter->set("quest_yunbiao/name",biao["name"]);
    parter->set("quest_yunbiao/file",biao["file"]);
    parter->set("quest_yunbiao/bonus",biao["bonus"]);
    parter->set("quest_yunbiao/time",biao["time"]);
    parter->set("quest_yunbiao/start_time",time());
    parter->set_temp("quest_yunbiao/have_task",1);

    biaoche=new(__DIR__"da_biaoche");
    biaoche->set("time",time);
    biaoche->set("file",biao["file"]);
    biaoche->start_escape_me();
    biaoche->set("owner",me->query("id"));
    biaoche->set("parter",parter->query("id"));
    biaoche->set("owner_name",me->query("name"));
    biaoche->move(environment(me));


    me->delete_temp("apply/short");
    me->set_temp("apply/short",
    ({HIY"长风镖局镖头"NOR+me->name()+"("+me->query("id")+")"}));

    parter->delete_temp("apply/short");
    parter->set_temp("apply/short",
    ({HIY"长风镖局镖师"NOR+parter->name()+"("+parter->query("id")+")"}));

    return HIW"请在"+chinese_time(time)+"内，将镖队护送到"
          +biao["name"]+"。\n一路多加小心，你们还是趁早上路吧！\n"NOR;
}


string ask_fangqi( )
{       object me;
        int i;
        me = this_player();
        i = me->query("potential");
          if(!me->query_temp("quest_yunbiao/have_task"))
         return "你没有领任务,跑这里瞎嚷嚷什麽?\n";
if (((int)me->query("potential") - (int)me->query("learned_points"))<300)
      return "你身上的pot不够取消任务了!\n";
        
                if ( i>500){
                command("say 我看错你了，我只能找别人了,扣你500点POT.");
                me->add("potential",-500);
                }
           if (i<=300){command("say 扣掉你所有的qn");
                me->set("potential",0);} 
me->set_temp("quest_yunbiao/have_task",0);
              
                return "没关系,下次继续努力 。";
             
}

void unconcious()
{
        reincarnate();
        set("eff_qi",this_object()->query_max_hp());
        set("qi",this_object()->query_max_hp());
        set("eff_jing",this_object()->query_max_jing());
        set("jing",this_object()->query_max_jing());
        set("jingli", query("eff_jingli"));
        say( "方舟突然出现在你的面前，说道你怎么可以杀死我的手下呢 ？！\n");
      }

void die()
{
        unconcious();
}

