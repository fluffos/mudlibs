#include <ansi.h>
inherit ITEM;

mapping default_dirs = ([
  "north": "北面",
  "south": "南面",
  "east": "东面",
  "west": "西面",
  "northup": "北边",
  "southup": "南边",
  "eastup": "东边",
  "westup": "西边",
  "northdown": "北边",
  "southdown": "南边",
  "eastdown": "东边",
  "westdown": "西边",
  "northeast": "东北",
  "northwest": "西北",
  "southeast": "东南",
  "southwest": "西南",
  "up": "上面",
  "down": "下面",
  "enter": "里面",
  "out": "外面",
]);

void create() {
  seteuid(getuid());
  set_name(HIR "镖车" NOR, ({ "biao che", "cart", "che" }));
  set_weight(300000);
  set("no_get", 1);
  set("unit", "辆");
  set("value", 0);
  set("long",
    HIW "一辆福威镖局的镖车，一干镖头正准备赶车(gan)起程呢。" NOR);
  set("owner", "jerry");
  set("owner_name", "方舟");
  set("no_clean_up", 1);
  set("no_update", 1);
  setup();
  call_out("destroy1", 2, this_object());
}

void init() {
  if (this_player()->query("id") == this_object()->query("owner")) {
    add_action("do_gan", "gan");
    add_action("do_gan", "drive");
  }
}

void start_escape_me() {
  call_out("destroy2", (int)query("time"), this_object());
}

int destroy2(object ob) {
  object me;
  if (objectp(ob)) {
    message("channel:ty", MAG "【传闻】" + HIB + "由于" + query("owner_name") +
      "护送的镖车未能如期抵达，福威镖局已派人前去接管镖车！\n" NOR, users());

    tell_object(all_inventory(environment(ob)),
      HIW "忽然，远远走来一群人，原来是总镖头派人前来了，为首的镖师\n"
      + "边走嘴里还边骂道：“他奶奶的！等了这么久也还没到，总镖头\n"
      + "还以为让人给劫了，害老子白跑一趟！”说完，一干人等拉起镖\n"
      + "车，扬长而去！\n" NOR);

    remove_call_out("destroy1");
    remove_call_out("destroy2");

    me = present(ob->query("owner"), environment(ob));
    if (objectp(me)) {
      me->set_temp("quest_yunbiao/have_task", 0);
      me->set_temp("quest_yunbiao/finished_time", time());
    }
    destruct(ob);
  }
  return 1;
}


int do_gan(string arg) {
  object me, ob, env, obj, robber, *killer;
  string item, dir, dest, target;
  int reward_exp, reward_pot, reward_score, flag, i, dj, my_combat_exp;

  mapping exit;
  me = this_player();
  ob = this_object();
  dj = me->query("jym_level/level");


  if (dj > 1) {
    if (dj == 2) my_combat_exp = ((int)me->query_exp() / 10) + 1000000;
    if (dj == 3) my_combat_exp = ((int)me->query_exp() / 10) + 3000000;
    if (dj == 4) my_combat_exp = ((int)me->query_exp() / 10) + 6000000;
    if (dj == 5) my_combat_exp = ((int)me->query_exp() / 10) + 10000000;
    if (dj == 6) my_combat_exp = ((int)me->query_exp() / 10) + 15000000;
    if (dj == 7) my_combat_exp = ((int)me->query_exp() / 10) + 21000000;
    if (dj == 8) my_combat_exp = ((int)me->query_exp() / 10) + 28000000;
    if (dj == 9) my_combat_exp = ((int)me->query_exp() / 10) + 36000000;
    if (dj == 10) my_combat_exp = ((int)me->query_exp() / 10) + 45000000;
    if (dj > 10)
      my_combat_exp = ((int)me->query_exp() / 10) + (45000000 + ((dj - 10) * 10000000));
  } else {
    my_combat_exp = ((int)me->query_exp() / 10);
  }

  if (!arg) return notify_fail("你要赶什么？\n");

  if (me->query("id") != ob->query("owner"))
    return notify_fail("你赶的不是自己的镖车吧？\n");

  if (sscanf(arg, "%s to %s", item, dir) != 2
    || item != "biao che" && item != "che")
    return notify_fail("指令：gan 镖车 to 方向 \n");

  if (me->is_busy())
    return notify_fail("你现在正忙着哩。\n");

  if (present("mian ju", this_player())) {
    if (present("mian ju", this_player())->query("equipped") == "mask")
      return notify_fail(HIR "本任务不能带面具做，请脱掉面具再赶车吧！\n" NOR);
  }

  flag = 0;
  killer = all_inventory(environment(me));
  for (i = 0; i < sizeof(killer); i++) {
    if (objectp(killer[i])
      && killer[i]->query("killer") == me->query("id"))
      flag = 1;
  }

  if (flag)
    return notify_fail(CYN "你还是先把眼前的敌人解决了再说吧！\n" NOR);

  env = environment(me);
  if (!env) return notify_fail("你要去那里？\n");

  if (!mapp(exit = env->query("exits")) || undefinedp(exit[dir]))
    return notify_fail("这个方向过不去。\n");

  dest = exit[dir];

  if (!(obj = find_object(dest)))
    call_other(dest, "???");
  if (!(obj = find_object(dest)))
    return notify_fail("那里好象过不去。\n");

  if (!undefinedp(default_dirs[dir]))
    target = default_dirs[dir];
  else
    target = obj->query("short");

  write(HIG "你赶着镖车往" + target + "驶去。\n" NOR);

  if (file_name(obj) != ob->query("file")) {
    if (ob->move(obj) && me->move(obj)) {
      all_inventory(env)->follow_me(me, dir);
      write(HIG "你赶着镖车驶了过来。\n" NOR);
    }
    if (me->query_exp() > 50000) {

      if (random(this_player()->query("kar") / 2) < 5 && !environment(ob)->query("no_fight")) {
        robber = new(__DIR__ "robber");
        robber->set("killer", me->query("id"));
        robber->set("quest_npc", 1);
        robber->move(environment(ob));
        robber->check_me();
      }
    } else {
      if (random(this_player()->query("kar") / 2) < 3 && !environment(ob)->query("no_fight")) {
        robber = new(__DIR__ "robber");
        robber->set("killer", me->query("id"));
        robber->set("quest_npc", 1);
        robber->move(environment(ob));
        robber->kill_ob(me);
        robber->check_me();
      }
    }
  } else {
    /*
       reward_exp=my_combat_exp/1500;
       reward_exp=reward_exp+(int)me->query("quest_yunbiao/bonus")*10;
       reward_exp=reward_exp*2/3+random(reward_exp);
*/
    reward_exp = 6000 + random(8000) + (int)me->query("quest_yunbiao/bonus") * 10;

    if (reward_exp > 12000) reward_exp = 12000;
    reward_pot = reward_exp / 6;
    reward_score = reward_exp / 40;
    /*
if (this_player()->query("more_money")!=0)
{
this_player()->add("money",this_player()->query("more_money")*100000000);
this_player()->set("more_money",0);
}
*/
    if (this_player()->query("money", 1) > 100000000) {
      this_player()->add("jym_money", this_player()->query("money", 1) / 100000000);
      this_player()->set("money", 100);
      tell_object(this_player(), HIR "你在钱庄的钱已达到一万两黄金！\n" NOR);
      tell_object(this_player(), HIR "系统已经帮你把钱庄里的黄金转换成了" HIB "元宝" HIR "存在了钱庄!\n" NOR);
    }


    tell_object(this_player(), MAG "【传闻】" HIB + me->query("name") +
      "运送的镖车历经千辛万苦，终于顺利抵达！\n"
      +me->query("name") + "获得了" + CHINESE_D->chinese_number(reward_exp)
      + "点实战经验、" + CHINESE_D->chinese_number(reward_pot) + "点潜能\n"
      + "及" + CHINESE_D->chinese_number(reward_score) + "点综合评价奖励和五十两黄金！\n" NOR,);

    me->add("quest_yunbiao/reward_exp", reward_exp);
    me->add("quest_yunbiao/reward_potential", reward_pot);
    ADD_EXP(me, reward_exp);
    me->add("potential", reward_pot);
    me->add("score", reward_score);
    me->add("money", 500000);

    me->set_temp("quest_yunbiao/have_task", 0);
    me->set_temp("quest_yunbiao/finished_time", time());
    remove_call_out("destroy1");
    remove_call_out("destroy2");
    destruct(ob);
  }

  return 1;
}

int destroy1(object ob) {
  object me;

  if (!objectp(ob) || !environment(ob))
    return 1;

  if (objectp(ob) && !present(ob->query("owner"), environment(ob))) {
    me = find_player(ob->query("owner"));
    if (!me) me = find_living(ob->query("owner"));
    if (objectp(me))

      remove_call_out("destroy1");
    remove_call_out("destroy2");
    destruct(ob);
  } else {
    remove_call_out("destroy1");
    call_out("destroy1", 2, ob);
    return 1;
  }
}
