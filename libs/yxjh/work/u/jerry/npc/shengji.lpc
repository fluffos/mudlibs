#include <ansi.h>
#include <login.h>

inherit NPC;
void create() {

  set_name("升级师", ({ "shengji shi", "shi", "shengji" }));
  set("age", 20);
  set("long", @STORY
这个是方舟写的升级师,你可以使用shengji指令来提升你的等级
具体请help shengji
STORY
  );
  set("chat_chance", 8);
  set("title", HIG "升级" NOR);
  exert_function(10);
  set("chat_msg", ({
    "您可以使用shengji指令来提升您的等级\n",
  }));

  set("gender", "男性");
  set("combat_exp", 10000);
  set("max_neili", 1500);
  set("force", 9999999);

  set_skill("hunyuan-yiqi", 999);
  set_skill("force", 999);
  map_skill("force", "hunyuan-yiqi");


  setup();
}

void init() {
  add_action("do_shengji", "shengji");
}

int do_shengji(object me) {
  int exp, dj;
  me = this_player();
  exp = me->query_exp();
  if (!me->query("jym_level/level")) {
    me->set("jym_level/level", 1);
  }
  dj = me->query("jym_level/level");

  if (dj < 11 && exp < (dj * 10000000))
    return notify_fail("您想升下一级还需要" + ((dj * 10000000) - exp) + "点经验值!\n");

  if (dj > 10 && exp < 100000000)
    return notify_fail("您想升下一级还需要" + (100000000 - exp) + "点经验值!\n");

  if (dj < 11) {
    ADD_EXP(me, -(me->query("jym_level/level") * 10000000));
  } else {
    ADD_EXP(me, -100000000);
  }
  me->add("jym_level/level", 1);
  //          tell_object(me,HIC"您成功的升到了"+me->query("jym_level/level")+"级了!\n"NOR);
  //     command("chat 恭喜玩家"+me->name()+"升到第"+me->query("jym_level/level")+"级了!");
  return 1;
}
