#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
     set_name(HIR"春节礼物使者"NOR, ({ "jym shizhe", "shizhe" }) );
         set("nickname", HIY"《浴血江湖》欢迎您的到来"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long",YEL"这位是〖《浴血江湖》〗的使者，向他打听“春节快乐”，你会有意想不到的惊喜……。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 30);
        set("per", 30);
        set("max_qi", 100000);
        set("neili", 100000);
        set("jingli",21000000);
        set("score", 100000);

        set("inquiry", ([
                         "春节快乐" : (: ask_me :),
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖《浴血江湖》〗"+HIR+"(ask shizhe about 春节快乐)\n"+NOR+HIW+"，．"NOR);
                       call_out("greeting", 2);

}

string ask_me()
 {
        object me = this_player();
        object obj1;
        mapping fam; 
        
         if ((int) me->query("jymjerry/20090125")|| me->query("age") < 18)
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
                me->set("jymjerry/20090125", 1);
                me->add("potential", 8888888);
                me->add("food", 10000);
                me->add("water", 10000);
                ADD_EXP(me,88888888);
                me->add("str", 1);
                me->add("con", 1);
                me->add("int", 1);
                me->add("kar", 1);
                me->add("jym_money",8888);
                obj1 = new ("/u/rock/weapon/jue");
                obj1->move(me);
                me->save();
                tell_object(me, HIR "《浴血江湖》恭祝：春节快乐！。\n" NOR);
                tell_object(me, HIY "你觉得似乎自己臂力更强了一些。\n" NOR);
                tell_object(me, HIB "你觉得似乎自己根骨更强了一些。\n" NOR);
                tell_object(me, HIM "你觉得似乎自己悟性更强了一些。\n" NOR);
                tell_object(me, HIC "你觉得似乎自己福缘更强了一些。\n" NOR);
                tell_object(me, HIG "你觉得似乎自己经验增加了88888888。\n" NOR);
                tell_object(me, HIM "你觉得似乎自己潜能增加了8888888。\n" NOR);
                tell_object(me, HIM "你觉得似乎自己元宝增加了8888。\n" NOR);
                tell_object(me, HIW "恭喜你，你得到《浴血江湖》罕见的终极金属一块。\n" NOR);


                return "《浴血江湖》巫师组"NOR+HIR"〖恭祝您〗"NOR":新年快乐！\n"NOR;;
        }
}


