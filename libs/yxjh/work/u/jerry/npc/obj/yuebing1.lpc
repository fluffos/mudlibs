#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY "五星红旗" NOR, ({ "wuxing hongqi", "hongqi"}) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long", @LONG
                ┌──────────────────────┐ 
                │                                            │ 
                │  国庆佳节. 《浴血江湖》巫师组                      │ 
                │                                            │ 
                │         恭祝所有玩家:                      │ 
                │                                            │ 
                │                  国庆节快乐!               │ 
                │                                            │ 
                │                          幸福美满!         │ 
                │                                            │ 
                │                                            │ 
                └──────────────────────┘ 
红旗，请yaohuang hongqi！
LONG
);
                set("no_get", 1);
                set("ty_gift", 1);
                set("no_give", 1);
                set("no_drop", 1);
                set("unit", "块");
        }
}

void init()
{
        add_action("do_eat", "yaohuang");
}

int do_eat(string arg)
{
        object me;

       me = this_player();
        if (! id(arg))
                return notify_fail("你要摇什么？\n");

         if ( !me->query("hecheng"))
              return notify_fail("可以得到合成兵器攻击力的奖励哦，你最好先去合成把兵器，要不然没的奖励哦！\n");
        if( me->query("mud_age") < 86400)
             return notify_fail("对不起,未成年人需经过家长允许！\n");

        me = this_player();
            if (me->query("tygift/20051001eat"))
                tell_object(me, "摇多了会虚脱的！\n");
               else
        {
        message_vision("$N努力摇了摇手中的" + this_object()->name() +
                       "。\n", me);



        tell_object(me, BLINK+HIR "《浴血江湖》巫师组恭祝您：国庆节快乐!!\n" NOR);
                me->add("hecheng/int",100);
                me->add("hecheng/con",50);
                me->add("hecheng/str",50);
                me->add("hecheng/dex",50);
                me->add("hecheng/damage",500);
                ADD_EXP(me,3000000);
                me->add("potential",500000);
                me->set("tygift/20051001eat", 1);
        write(HIC"你突然感觉你的合成兵器在抖动，你拔出一看，发现合成兵器锋利了不少!\n"NOR);


        destruct(this_object());
        return 1;
}
 }

