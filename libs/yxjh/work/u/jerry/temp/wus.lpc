inherit NPC;
void create()
{
         set_name(HIR"邪恶巫师"NOR, ({ "jkiller", "shashou" }) );
        set("gender", "男性");
        set("age", 30);
        set("long", "他是心魔手下,从一出生就没做过什么好事。\n");
        set("attitude", "aggressive");
        set("str", 200);
        set("con", 200);
        set("int", 200);
        set("dex", 200);
        set("max_qi", 500000);
        set("max_jing", 500000);
        set("neili", 800000);
        set("max_neili", 800000);
        set("jingli", 600000);
        set("max_jingli", 600000);
        set("jiaji", 600);
        set("combat_exp", 50000000);
        set("chat_chance",50);
        set_skill("dodge",200);
        set_skill("unarmed",300);
        set_skill("force",300);
        set_skill("parry",200);
        set_temp("apply/attack", 25);
        set_temp("apply/damage", 20);
        set_temp("apply/armor", 18);
        set_temp("apply/defence",20);
        setup();
        carry_object("/clone/cloth/cloth")->wear();
}


