inherit ITEM;
void create() {
  set_name(HIY "版主工资" NOR, ({ "gongzi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "版主工资，看来不是普通之物，必是仙家精品，吃了肯定不错！\n");
    set("unit", "罐");
    set("ty_gift", 1);
    set("no_get", 1);
    set("no_paimai", 1);
    set("no_pawn", 1);
    set("no_give", 1);
    set("no_cun", 1);
    set("no_drop", 1);
    set("value", 0);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_tilian", "eat");
}
int do_tilian(string arg) {
  object me = this_player();
  if (!id(arg)) return 0;
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");


  message_vision(HIW "$N一口吃下版主工资，感觉自己的辛苦的成果。\n" NOR, me);
  message_vision(HIG "$N的工资增加了888元宝!\n" NOR, me);
  message_vision(HIG "$N的福缘增加了1点!\n" NOR, me);
  message_vision(HIG "$N的容貌增加了1点!\n" NOR, me);
  message_vision(BLINK + HIR "$N希望以后多多努力会有更多的收入的!\n" NOR, me);
  me->add("kar", 1);
  me->add("per", 1);
  me->add("jym_money", 888);

  destruct(this_object());
  return 1;
}
