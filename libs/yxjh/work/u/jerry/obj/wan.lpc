inherit ITEM;
void owner_is_killed() { destruct(this_object()); }  

void create()
{
        set_name(HIW"起步丹"NOR, ({ "dan",}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("long", HIW"耗子发的礼物，你可以eat dan！\n");
                 set("unit", "颗");
                 set("value",0);
                 set("no_give",1);  
                 set("no_get",1);       
                 set("no_drop",1);
                 set("no_put",1); 
                 set("no_sell",1); 
                 set("no_vipcun",1); 
                 set("nopaimai",1);
                 set("ty_gift",1);  
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_tilian", "eat");
}
int do_tilian(string arg)
{
  object me = this_player(); 
  if(!id(arg)) return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n"); 
//         if (me->query("tygift/2099")>1)  
// return notify_fail ("得了吧,拿过了还来！\n");

        {
        message_vision("$N一口吃掉" + this_object()->name() +
                       ",爽!\n", me);

                tell_object(me, HIY "你觉得似乎自己经验增加了。\n" NOR);
//                      tell_object(me, HIM "你觉得似乎自己潜能增加了。\n" NOR);

//         ADD_EXP(me, 200000000);
         me->add("potential", 200000000);

//                  me->set("tygift/2099", 2);

        destruct(this_object());
        return 1;
}
 }

