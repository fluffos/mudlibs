//jerry

#include ansi.h

inherit ITEM;

void create() {
  set_name(HIB "镶锲符" NOR, ({ "xiangqie fu", "fu", "fu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一张使用后可让你的合成武器永久增加一个镶锲孔的符咒，你重新合成另外一把武器时，\n该镶锲孔仍然存在。只能使用4次{use fu}\n");
    set("no_put", 1);
    set("no_sell", 1);
    set("ty_gift", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("unit", "张");
  }
}

void init() {
  add_action("do_eat", "use");
}

int do_eat(string arg) {
  object me;

  if (!id(arg))
    return notify_fail("你要使用什么？\n");


  if (!me->query("hecheng"))
    return notify_fail("你还没有合成武器！\n");
  if (me->query("hechengqie") > 3)
    return notify_fail("你的合成武器只能增加四个镶锲孔！\n");

  message_vision("$N口中念念有词，拿起" + this_object()->name() +
    "贴在$N的合成武器上面。\n", me);


  tell_object(me, HIG "恭喜你！你的合成武器增加了一次镶锲金属的机会。\n");
  me->add("hechengqie", 1);

  destruct(this_object());
  return 1;
}
int query_autoload() {
  return 1;
}
