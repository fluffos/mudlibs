#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon, weapon2, target;
  int skill, ap, dp, damage;
  me->clean_up_enemy();
  target = me->select_opponent();
  skill = me->query_skill("yifeng-jian", 1);
  if (!(me->is_fighting()))
    return notify_fail("「花起剑落」只能对战斗中的对手使用。\n");
  if (!wizardp(this_player()) && (me->query("family/family_name") != "移花宫"))
    return notify_fail("你不是移花宫弟子不能使用冥雨神功.\n
                                    移风剑法博大精深, 非移花宫弟子不传, 真不知道你是怎么学会的!\n
                                    要是让两位宫主知道了你可惨了.\n");
  if (me->query_skill_mapped("dodge") != "yifeng-dodge")
    return notify_fail("你的移风换影没激发在轻功上吧? \n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (!objectp(weapon2 = target->query_temp("weapon")))
    return notify_fail("对方没有兵刃，你不用担心。\n");

  if (skill < 200)
    return notify_fail("你的移风剑法等级不够, 不能使用「花起剑落」！\n");
  if (me->query("neili") < 1200)
    return notify_fail("你的内力不够，无法运用「花起剑落」！\n");
  msg = HIC "$N凝神运起冥雨心法，一招「" HIG ",花起剑落" HIC "」随心而出，强大的剑气冲向对手兵刃！\n";
  message_vision(msg, me, target);

  damage = 10 + random(skill / 2);
  ap = skill + me->query_skill("sword", 1);
  dp = target->query_skill("unarmed", 1);
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("neili", -50);
    msg = "$n顿时觉得眼前一花，虎口一阵，手中";
    msg += weapon2->name();
    msg += "脱手而出！\n" NOR;
    target->receive_damage("qi", damage);
    target->start_busy(2);
    weapon2->move(environment(me));
  } else {
    if (userp(me))
      me->add("neili", -1000);
    msg = "可是$n看破了$N的剑法，立刻将手中" + weapon2->name() + "舞得风雨不透，使$N的「花起剑落」没有起到作用。\n" NOR;
    me->start_busy(3);
  }
  message_vision(msg, me, target);
  return 1;
}
