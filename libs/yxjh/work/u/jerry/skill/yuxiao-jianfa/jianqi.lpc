#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int damage, damage2;
  string msg;
  object weapon;

  if ((string)me->query("family/family_name") != "桃花岛")
    return notify_fail("只有桃花弟子才能使用该PFM。\n");
  if (me->query_skill_mapped("dodge") != "anying-fuxiang")
    return notify_fail("你的暗影浮香没激发在轻功上吧? \n");
  if (!target) target = offensive_target(me);
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail(RED "开什么玩笑，没装备剑就想使「玉剑气」？\n" NOR);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「玉剑气」只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("yuxiao-jianfa", 1) < 800)
    return notify_fail(WHT "你的玉萧剑法不够娴熟，还使不出「玉剑气」。\n" NOR);
  if ((int)me->query_skill("sword", 1) < 850)
    return notify_fail(WHT "你连剑都拿不来，还妄想使出「玉剑气」？\n" NOR);
  if ((int)me->query_skill("force", 1) < 1500)
    return notify_fail(RED "你的内功基础不够，耍不出「玉剑气」。\n" NOR);
  if ((int)me->query_skill("dodge", 1) < 1500)
    return notify_fail(RED "你的身法不够灵活不够，领悟不到「玉剑气」。\n" NOR);
  if ((int)me->query_max_neili() < 50000)
    return notify_fail(RED "你的内力修为不足，无法运足「玉剑气」的内力。\n" NOR);
  if ((int)me->query("neili") < 2200) {
    return notify_fail(HIC "你现在内力不够，没能将「玉剑气」使完！\n" NOR);
  }
  msg = HIR "$N面上闪过一阵青气，眼中神光电射，手抬剑走，施展出玉萧\n" NOR;
  msg += HIR "剑法之终级绝技「玉剑气」！刹那间剑气卷起阵阵萧声袭向$n\n" NOR;
  msg += HIR "全身上下三百六十五处穴道！！\n" NOR;
  if (random(me->query_skill("force")) > target->query_skill("force") / 2) {
    me->start_busy(2);
    target->start_busy(random(3));
    damage = (int)me->query_skill("yuxiao-jianfa", 1) * 5 + (int)me->query_skill("force", 1) * 2;
    damage = damage + random(damage);
    if (damage < target->query(
      "max_qi",
      1
    ) / 8 && me->query(
      "max_neili",
      1
    ) > target->query("max_neili", 1) / 2) damage = random(target->query("max_qi", 1) / 6);
    if (damage > target->query("max_qi", 1) / 3) damage = random(target->query("max_qi", 1) / 4);


    damage2 = (int)me->query_skill("yuxiao-jianfa", 1) * 5 + (int)me->query_skill("force", 1) * 2;
    damage2 = damage2 + random(damage2);
    target->receive_damage("qi", damage / 2);
    target->receive_wound("qi", damage);
    msg += HIC "$n躲避不及，被$N的剑气连续刺中百数处穴道，全身血液倒流\n" NOR;
    msg += HIC "而行，真气乱窜，紧接着喷出一大口鲜血，已被$N重创！！\n" NOR;
    me->add("neili", -2000);
  } else {
    me->start_busy(random(3));
    msg += HIY "$p眼见剑气漫天，情急下一个「驴打滚」就地滚了开去，\n" NOR;
    msg += HIY "剑气在$p身侧闪过，$p吓出一身冷汗。\n" NOR;
    me->add("neili", -1200);
  }
  message_vision(msg, me, target);
  if (!target->is_fighting(me)) target->fight_ob(me);
  //      if(userp(target)) target->fight_ob(me);
  //      else if( !target->is_killing(me) ) target->kill_ob(me);
  return 1;
}
