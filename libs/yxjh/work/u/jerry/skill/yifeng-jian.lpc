inherit SKILL;
string type() { return "zhongji"; }
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});

mapping *action = ({
  ([ "action": "$N使一式「" + (order[random(13)]) + "花随风移" NOR "」，手中$w嗡嗡微振，幻成一无数花瓣刺向$n的$l",
    "force": 120,
    "lvl": 0,
    "skill_name": "花随风移",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N移步上前，使出「" + (order[random(13)]) + "雨花纷飞" NOR "」，剑气围绕，$w淡淡地向$n的$l挥去",
    "force": 160,
    "lvl": 10,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一式「" + (order[random(13)]) + "花起剑落" NOR "」，纵身飘开数尺，运发剑气，手中$w遥遥飞向$n的$l",
    "force": 520,
    "lvl": 120,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N纵身轻轻跃起，一式「" + (order[random(13)]) + "紫花飞舞" NOR "」，剑光化为紫色，飘向$n的$l",
    "force": 580,
    "lvl": 130,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w中宫直进，一式「" + (order[random(13)]) + "花开花谢" NOR "」，无声无息地对准$n的$l刺出一剑",
    "force": 520,
    "lvl": 140,
    "damage_type": "刺伤"
  ]),
  ([ "action": RED "$N手中$w斜指苍天，剑芒吞吐，一式「" + (order[random(13)]) + "飞花落叶" NOR RED "」，对准$n的$l斜斜击出" NOR,
    "force": 1200,
    "lvl": 1000,
    "damage_type": "刺伤"
  ]),
  ([ "action": YEL "$N左指凌空虚点，右手$w逼出丈许雪亮剑芒，一式「" + (order[random(13)]) + "春回大地" NOR YEL "」刺向$n的$l" NOR,
    "force": 1200,
    "lvl": 1000,
    "damage_type": "刺伤"
  ]),
  ([ "action": BLINK HIB "狂风大起,只见花瓣到处飞舞,突然无数花瓣割向$n,$n顿时鲜血直喷" NOR,
    "force": 1200,
    "lvl": 1000,
    "damage_type": "刺伤"
  ]),
});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me) {
  if ((int)me->query("jym_level/level") < 10)
    return notify_fail("你的等级太低，请高于10级再学习，强行练习小心走火入魔！");
  if ((int)me->query_skill("yifeng-jian", 1) > 200)
    return notify_fail("移风剑法我就教到这儿，以后就要靠你自己练了。\n");
  if ((int)me->query_max_neili() < 50000)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query_skill("mingyu-shengong", 1) < 200)
    return notify_fail("你的冥雨神功火候太浅。\n");

  if ((int)me->query_skill("force", 1) < 20)
    return notify_fail("你的基本内功火候太浅。\n");

  return 1;
}
mapping query_action(object me, object weapon) {

  mapping a_action;
  int i, level, medj;
  me = this_player();
  medj = (int)me->query("jym_level/level", 1);
  level = (int)me->query_skill("yifeng-jian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      a_action = action[NewRandom(i, 5, level / 5)];
      break;
    }
  a_action["dodge"] = 0 - level / 3;
  a_action["parry"] = 0 - level / 3;
  a_action["attack"] = level / 4;
  a_action["damage"] = level / 5 + medj * 20 + me->query("mingyu-shengong", 1) / 100;
  return a_action;

}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;

  //  第六等级的伤气
  if (me->query_skill("yifeng-jian", 1) > 4000
    && (me->query("neili") * 6) > victim->query_max_neili()) {
    victim->receive_damage("qi", damage_bonus / 2, me);
    return HIR "$N催动冥雨神功，剑气如满天星般而去$n全身血液顿时沸腾！！！\n" NOR;
  }

  //  第五等级的伤气
  if (me->query_skill("yifeng-jian", 1) > 3000
    && (me->query("neili") * 5) > victim->query_max_neili()) {
    victim->receive_damage("qi", damage_bonus / 4, me);
    return HIR "$N的移风剑法已经达到人剑合一的境界，随手数道剑气分刺$n数处大穴！！！\n" NOR;
  }
  //  第四等级的伤气
  if (me->query_skill("yifeng-jian", 1) > 2000
    && (me->query("neili") * 4) > victim->query_max_neili()) {
    victim->receive_damage("qi", damage_bonus / 6, me);
    return HIR "$N灵台光闪，瞬间领悟到移风剑法精髓，随手一剑妙到毫颠！！！\n" NOR;
  }


  // 第二等级的伤气
  if (me->query_skill("yifeng-jian", 1) > 400
    && me->query_skill("yifeng-jian", 1) < 1001
    && (me->query("neili") * 3) > victim->query_max_neili()) {
    victim->receive_damage("qi", (damage_bonus - 100) / 10, me);
    return HIW "$N的移风剑法已初有小成,每出一剑都带着强烈" HIR "剑气" HIW "扑向$n！！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("yifeng-jian", 1) > 1000
    && me->query("jym_level/level") >= 10
    && (me->query("neili") * 3) > victim->query_max_neili()) {
    victim->receive_damage("qi", (damage_bonus - 100) / 8, me);
    return HIR "$N的移风剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
  }


  return 1;
}

int practice_skill(object me) {
  object weapon;

  if (!me->query_skill("mingyu-shengong", 1))
    return notify_fail("练「移风剑法」必须要有「冥雨神功」作底子。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练「移风剑法」。\n");

  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yifeng-jian/" + action;
}
