#include <combat.h>
inherit SKILL;
string type() { return "zhongji"; }
string *order = ({""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});

mapping *action = ({
([  "action":"刺！"+(order[random(13)])+"$N错步上前，一招[浪子回头]猛然攻出，气势恢弘，气流澎湃，直刺$n的$l"NOR,
    "force" : 580,
    "lvl" : 0,  
    "damage_type" : "刺伤"
     ]),
([  "action":"罩！"+(order[random(13)])+"$N一声巨喝，贯出[随波逐浪]，手中$w上下交错，缤纷贯出，铺天剑影顿时笼罩"HIR"$n"NOR,
        "force" : 520,
        "lvl" : 140,
    "damage_type" : "刺伤"
    ]),
([  "action":HIB"破！$n使出"BLINK HIY"最后杀着"NOR HIB"，怎知$N也使出了最后绝技手中$w掀起翻天巨浪，一股凛冽寒流从九天而降，"HIB"向$n对刺过去"NOR,
     "force" : 1000,
      "lvl" : 1000,
      "damage_type":"刺伤",
  ]),
});
int valid_enable(string usage) { return usage == "sword"; }
int practice_level(){   return 200;  }
int valid_learn(object me)
{
        if ((int)me->query_max_neili() < 50000)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query("jym_level/level") < 10)
                return notify_fail("你的等级太低，请高于10级再学习，强行练习小心走火入魔！");
    if ((int)me->query_skill("zuixin-sword",1) > 200)
        return notify_fail("浪子三招我就教到这儿，以后就要靠你自己练了。\n");
      if (me->query_skill("sword",1) <= me->query_skill("langzi-sword",1))
      return notify_fail("你的基础不够，无法领会更高深的技巧！\n");
    return 1;
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me,object weapon)
{

    mapping a_action;
    int i, level, medj;
    me = this_player();
    medj    = (int) me->query("jym_level/level",1);
    level   = (int) me->query_skill("langzi-sword", 1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]){
                        a_action = action[NewRandom(i, 5, level/5)];
                        break;
                }
    a_action["dodge"]  = 0-level/3;
    a_action["parry"]  = 0-level/3;
    a_action["attack"]  = level/4;
    a_action["damage"] = level/5+medj*20+me->query("damo-force",1)/100;
    return a_action;

}

int practice_skill(object me)
{
    object ob;
    if( (int)me->query("qi") < 30
    ||  (int)me->query("neili") < 35 )
        return notify_fail("你的内力或气不够，没有办法练习浪子三招。\n");
    if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    if (!objectp(ob = me->query_temp("secondary_weapon"))
    || (string)ob->query("skill_type") != "sword")
        return notify_fail("你装备的武器不对。\n");
    me->receive_damage("qi", 30);
    me->add("force", -20);
    me->add_temp("pratice_sword",1);
   if (me->query_temp("pratice_sword") > me->query_skill("langzi-sword",1)/20 ){
           if( (int)ob->query_amount()==1 ) {
                   ob->unequip();
                   tell_object(me, BOLD "\n你的" + ob->query("name") + "用完了！\n\n"+NOR);
           }
           ob->add_amount(-1);
           me->delete_temp("pratice_sword");
    }
   write("你按著所学练了一遍浪子三招。\n");
    return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 110 ) return 0;

 //  第六等级的伤气
      if( me->query_skill("langzi-sword",1)>4000
         && me->query_skill("damo-force",1)>1200
  && (me->query("neili")*6) > victim->query_max_neili() ) {
              victim->receive_damage("qi", damage_bonus/2, me);
return HIR "$N的浪子三招已到"BLINK HIC" 最高等级 "NOR HIR"发出一阵阵"BLINK HIW" 剑芒 "NOR HIR"摧毁了$n的"BLINK HIR" 真元 "NOR HIR"！！！\n" NOR;
  }      

 //  第五等级的伤气
      if( me->query_skill("langzi-sword",1)>3000
         && me->query_skill("damo-force",1)>1000
  && (me->query("neili")*5) > victim->query_max_neili() ) {
              victim->receive_damage("qi", damage_bonus/4 , me);
return HIM "$N的浪子三招已入"BLINK HIC" 化境 "NOR HIR"发出一阵阵"BLINK HIW" 剑芒 "NOR HIR"摧毁了$n的"BLINK HIR" 真元 "NOR HIR"！！！\n" NOR;
  }      
 //  第四等级的伤气
      if( me->query_skill("langzi-sword",1)>2000
         && me->query_skill("damo-force",1)>900
  && (me->query("neili")*4) > victim->query_max_neili() ) {
                victim->receive_damage("qi", damage_bonus/6, me);
return HIY "$N的浪子三招已入"BLINK HIC" 返璞归真"NOR HIR"，随手一剑，剑气"NOR HIR"摧毁了$n的"BLINK HIR" 真元 "NOR HIR"！！！\n" NOR;
  }      


 // 第二等级的伤气
        if ( me->query_skill("langzi-sword",1)>400
         && me->query_skill("langzi-sword",1)<1001
         && me->query_skill("damo-force",1)>300
&& (me->query("neili")*3) > victim->query_max_neili() ) {
             victim->receive_damage("qi", (damage_bonus - 100) / 10 , me);
return HIB "$N手中"BLINK HIW" 剑器 "NOR HIR"发出一阵阵"BLINK HIW" 剑气 "NOR HIR"摧毁了$n的"BLINK HIR" 真元 "NOR HIR"！！！\n" NOR;
}

 //  第三等级的伤气
      if( me->query_skill("langzi-sword",1)>1000
         && me->query_skill("damo-force",1)>600
  && me->query("jym_level/level")>=10
  && (me->query("neili")*3) > victim->query_max_neili() ) {
                victim->receive_damage("qi", (damage_bonus - 100) / 8 , me);
return HIR "$N手中"BLINK HIC" 利刃 "NOR HIR"发出一阵阵"BLINK HIW" 剑芒 "NOR HIR"摧毁了$n的"BLINK HIR" 真元 "NOR HIR"！！！\n" NOR;
  }      


      return 1;
}

string perform_action_file(string action){      return __DIR__"langzi-sword/" + action;}


