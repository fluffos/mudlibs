// Updated By Jerry

#include <ansi.h>

inherit F_CLEAN_UP;

#define PERIOD          864
#define PERIOD_POT      10000
mapping valid_types = ([
  "unarmed": "拳脚",
  "sword": "剑法",
  "blade": "刀法",
  "stick": "棒法",
  "staff": "杖法",
  "spear": "枪法",
  "fork": "叉法",
  "club": "棍法",
  "axe": "斧法",
  "throwing": "暗器",
  "force": "内功",
  "parry": "招架",
  "hammer": "锤法",
  "dodge": "轻功",
  "magic": "法术",
  "taoism": "道学心法",
  "whip": "鞭法",
  "poison": "毒功",
  "finger": "指法",
  "hand": "手法",
  "cuff": "拳法",
  "claw": "爪法",
  "strike": "掌法",
]);

int clossing(object me);
int halt_closing(object me);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  int exercise_cost;
  object where;

  seteuid(getuid());
  where = environment(me);

  if (where->query("pigging"))
    return notify_fail("你还是专心拱猪吧！\n");

  if (!where->query("no_fight"))
    return notify_fail("在这里闭关？不太安全吧？\n");

  if (!where->query("sleep_room"))
    return notify_fail("你得找一个能够休息的地方闭关\n");

  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");

  if (me->query("doing"))
    return notify_fail("你已经在闭关了。\n");

  if (me->query("potential") - me->query("learned_points") < 100000)
    return notify_fail("你的潜能不够，没法闭关修行。\n");

  if (!me->query("animaout"))
    return notify_fail("你必须要修炼元婴出世。\n");

  if ((int)me->query("qi") < me->query("max_qi"))
    return notify_fail("你现在的气太少了，无法静心闭关。\n");

  if ((int)me->query("jing") * 100 / me->query("max_jing") < 90)
    return notify_fail("你现在的精太少了，无法静心闭关。\n");

  if ((int)me->query("max_neili") < 40000)
    return notify_fail("你觉得内力颇有不足，看来目前还难以"
      "进行长时间的闭关修炼。\n");

  if ((int)me->query("neili") / (me->query("max_neili") / 100) < 90)
    return notify_fail("你现在的内力太少了，无法静心闭关。\n");

  message_vision("$N盘膝坐下，开始冥神运功，闭关修行。\n", me);
  me->set("startroom", base_name(where));
  me->set("doing", "closed");
  CLOSE_D->user_closed(me, "closed");
  me->start_busy(bind((: call_other, __FILE__, "closing" :), me),
    bind((: call_other, __FILE__, "halt_closing" :), me));
  CHANNEL_D->do_channel(this_object(), "rumor",
    sprintf("武林高手%s(%s)开始闭关修行。",
      me->name(1), me->query("id")));

  return 1;
}

int continue_closing(object me) {
  me->start_busy(bind((: call_other, __FILE__, "closing" :), me),
    bind((: call_other, __FILE__, "halt_closing" :), me));
  CLOSE_D->user_closed(me);
  tell_object(me, HIR "\n你继续闭关...\n" NOR);
  return 1;
}

int closing(object me) {
  int t;
  int tn;
  int pot;
  int r;
  int i;
  int vip;
  int exp_inc;
  string *ks;
  string *skills;
  mapping all_skills;
  mapping map;
  string *skill, ski, map_to;
  int y, modify;
  object ob;

  pot = me->query("potential");
  vip = 42;
  if (me->query("jym_level/vip")) { vip = 83; }

  if (pot <= me->query("learned_points")) {
    tell_object(me, "你的潜能耗尽了。\n");
    message_vision("$N睁开双目，缓缓吐了一口气，站了起来。\n", me);
    CLOSE_D->user_opened(me);
    CHANNEL_D->do_channel(this_object(), "rumor",
      sprintf("听说%s(%s)闭关功德圆满。",
        me->name(1), me->query("id")));
    if (!interactive(me)) {
      me->force_me("chat* haha");
      call_out("user_quit", 0, me);
    }

    if ((ob = present("tianshi chibang", me)))
      destruct(ob);

    return 0;
  }
  if (present("tianshi chibang", me))
    me->add("learned_points", 120);  //add by jerry
    else me->add("learned_points", 42);

  t = me->query_temp("last_closing");
  tn = time();
  if (tn - t < 0) {
    me->set_temp("last_closing", tn);
    return 1;
  }

  if (present("tianshi chibang", me)) {
    if (tn - t < PERIOD / 3) {
      return 1;
    }
  } else if (tn - t < PERIOD) {
    return 1;
  }




  me->set_temp("last_closing", tn);
  if (me->add("learned_points", PERIOD_POT / 2 + random(PERIOD_POT)) > pot)
    me->set("learned_points", pot);
  me->save();


  if (random(10) == 4)
    tell_object(me, "闭关修炼中...\n");

  if (random(100) < vip && me->query("jym_level/level") * 250000 > me->query_max_neili()) {
    tell_object(me, HIR "你对内功有所领悟，内力增加了一千点！\n" NOR);
    me->add("max_neili", 1000);
    me->save();

  }

  if (random(100) < vip && me->query("jym_level/level") * 250000 > me->query_max_jingli()) {
    tell_object(me, HIM "你对神通有所领悟，感到精力增加了八百点！\n" NOR);
    me->add("max_jingli", 800);
    me->save();

  }

  if (random(100) < vip) {
    me->set_skill("force", (int)me->query_skill("force", 1) + 2);
    me->save();

    tell_object(me, HIM "你对神通有所领悟，感到基本内功增加了两级！\n" NOR);
    if (me->query("jym_level/level") > 7) {
      if (me->query_skill("force", 1)
        > me->query("jym_level/level") * 600) {
        me->set_skill("force", (int)me->query_skill("force", 1) - 2);
        me->save();

        tell_object(me, HIM "你的内功已经到达最高上限了，不能再加了，方舟又帮你降了回来！\n" NOR);
      }
    } else {
      if (me->query_skill("force", 1) > 5000) {
        me->set_skill("force", (int)me->query_skill("force", 1) - 2);
        me->save();

        tell_object(me, HIM "你的内功已经到达最高上限了，不能再加了，方舟又帮你降了回来！\n" NOR);
      }
    }
  }

  if (random(100) < vip) {
    all_skills = this_player()->query_skills();
    skills = keys(all_skills);
    for (i = 0; i < sizeof(skills); i++) {
      if (this_player()->query_skill(skills[i], 1)
        < (me->query("jym_level/level") * 200) || skills[i] == "dodge" || skills[i] == "literate")
        this_player()->set_skill(skills[i], all_skills[skills[i]] + 1);
      me->save();

    }
    tell_object(me, HIY "你对自己的各项技能有所感悟。\n" NOR);

    if (me->query_skill("pixie-jian", 1) > 600) {
      tell_object(me, HIM "你的辟邪剑法已经到达600级了，不能再加了，方舟又帮你降了回来！\n" NOR);
      me->set_skill("pixie-jian", (int)me->query_skill("pixie-jian", 1) - 1);
      me->save();

    }
    if (me->query_skill("fadai-qigong", 1) > 10) {
      tell_object(me, HIM "发呆奇功不能用闭关提升！\n" NOR);
      me->set_skill("fadai-qigong", (int)me->query_skill("fadai-qigong", 1) - 1);
      me->save();

    }
    if (me->query_skill("kuihua-xinfa", 1) > 199) {
      tell_object(me, HIM "你的葵花心法已经到达200级了，不能再加了，方舟又帮你降了回来！\n" NOR);
      me->set_skill("kuihua-xinfa", (int)me->query_skill("kuihua-xinfa", 1) - 1);
      me->save();
    }
    if (me->query_skill("wakuang-shu", 1) > 999) {
      tell_object(me, HIM "你的挖矿术已经到达1000级了，不能再加了，耗子又帮你降了回来！\n" NOR);
      me->set_skill("wakuang-shu", (int)me->query_skill("wakuang-shu", 1) - 1);
      me->save();

    }
  }
  exp_inc = 5000 + random(1000);
  exp_inc = exp_inc * (100 + me->query_skill("force", 1)) / 500;
  exp_inc = exp_inc * (100 + me->query("int")) / 10000;
  ADD_EXP(me, exp_inc);
  me->save();

  tell_object(me, HIB "你对神通有所领悟，感到经验增加了不少经验\n" NOR);

  return 1;
}

int halt_closing(object me) {
  object ob;
  CLOSE_D->user_opened(me);
  tell_object(me, "你中止了闭关。\n");
  message_vision(HIY "$N" HIY "大喝一声，睁开眼来，一股气流登时"
    "将众人迫退四步。\n\n" NOR, me);
  me->add("potential", (me->query("learned_points") - me->query("potential")) / 2);
  CHANNEL_D->do_channel(this_object(), "rumor", "听说" + me->name(1) +
    "闭关中途突然复出。");
  if (ob = present("tianshi chibang", me))
    destruct(ob);

  me->force_me("quit");
  return 1;
}

void user_quit(object me) {
  if (!objectp(me) || interactive(me))
    return;

  me->force_me("quit");
}

int help(object me) {
  write(@HELP
指令格式 : closed

闭关修行，只要你已经元婴出世成功后,都可以使用该指令闭关,在闭关
中你可以增加内力最大值,或者精力最大值,或者全部武功加一级或者基
本内功加两极,在闭关前需要十万点潜能,四万点内力值,闭关开始后,玩
家要下了,可以选择离线系统帮你继续挂机闭关,也就是说离线闭关,一直
到你的潜能耗尽,或者使用(halt)指令停止闭关,使用halt指令会降你现
有潜能值的1/2所以要想好才可以使用!
HELP);
  return 1;
}
