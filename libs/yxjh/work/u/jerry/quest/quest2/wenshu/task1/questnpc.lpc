	(["cdizhi":	"峨嵋山",
	"weizhi2" :	"/d/emei/basipan2",]),  
	(["cdizhi":	"白驼山",
	"weizhi2" :	"/d/baituo/changlang",]),  
	(["cdizhi":	"华山",
	"weizhi2" :	"/d/huashan/canglong",]),  
	(["cdizhi":	"灵鹫峰",
	"weizhi2" :	"/d/lingjiu/dadao2",]),  
	(["cdizhi":	"嵩山",
	"weizhi2" :	"/d/songshan/chaotian",]),  
	(["cdizhi":	"天龙寺",
	"weizhi2" :	"/d/tianlongsi/damen",]),  
