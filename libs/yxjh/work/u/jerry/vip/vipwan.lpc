//by jerry
//u/jerry/vip/vipwan.c

inherit ITEM;
void owner_is_killed() { destruct(this_object()); }  

void create()
{
        set_name(HIW"VIP起步丹"NOR, ({ "vip dan",}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("long", HIW"浴血江湖 VIP起步丹，你可以eat vip dan！\n");
                 set("unit", "颗");
                 set("value",0);
                 set("no_give",1);  
                 set("no_get",1);       
                 set("no_drop",1);
                 set("no_put",1); 
                 set("no_sell",1); 
                 set("no_vipcun",1); 
                 set("no_paimai",1);
                 set("jym_gift",1);  
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_tilian", "eat");
}
int do_tilian(string arg)
{
        object me = this_player(); 
        mapping fam; 
        
        if(!id(arg)) return 0;
        if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");
        if( !me->query("jym_level/vip") ) 
        return notify_fail ("得了吧,请加入VIP先！\n"); 
        if ((int) me->query("jerryvip"))
        return notify_fail ("哈哈每个ID只能吃一次，吃多也没什么用!\n"); 
        else
        {
         message_vision("$N一口吃掉" + this_object()->name() +
                       ",爽!\n", me);

        tell_object(me, HIY "你觉得似乎自己经验增加了5Y。\n" NOR);
        tell_object(me, HIM "你觉得似乎自己潜能增加了5000w。\n" NOR);
        tell_object(me, HIC "你觉得似乎自己福缘增加了10点。\n" NOR);
        tell_object(me, HIG "你觉得似乎自己容貌增加了10点。\n" NOR);
        tell_object(me, HIG "你觉得似乎自己元宝增加了20W。\n" NOR);
                  
        me->set("jerryvip", 1);
        ADD_EXP(me, 500000000);
        me->add("potential", 50000000);
	me->add("kar", 10);
        me->add("per", 10);
        me->add("jym_money", 200000);
 
        destruct(this_object());
        return 1;
}
 }
