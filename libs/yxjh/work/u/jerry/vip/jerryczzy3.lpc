#include <ansi.h>
#include <localtime.h>
inherit ITEM;

#define NEED_TIME 3
#define CALL_TIME 30

//函数声明
void check_time(object me);

// 函数：所属类别
int query_xy() { return 1; }

void create() {
  set_name(HIC "成长之羽3小时" NOR, ({ "cz yu3" }));
  set("long", "有了它，你的成长将会更加顺利。有效期3小时");
  set("unit", "个");
  set("no_put", 1);
  set("no_give", 1);
  set("no_paimai", 1);
}

void init() {
  object ob, me;
  int time, lotime;
  mixed localtime;

  ob = this_object();
  me = this_player();
  time = time() + NEED_TIME * 3600;
  lotime = ob->query("locktime");
  if (!lotime) lotime = time;
  if (lotime <= time()) {
    ob->set("long", "道具已经到期，请做丢弃处理。\n");
    return;
  }
  me->set_temp("temp_exp", me->query_exp());

  localtime = localtime(lotime);
  ob->set(
    "long",
    sprintf(
      "有了它，您的成长将会更加顺利。\n" HIY "道具到期时间:%d月%d日 %d:%d\n" NOR,
      1 + localtime[LT_MON],
      localtime[LT_MDAY],
      localtime[LT_HOUR],
      localtime[LT_MIN]
    )
  );

  if (!ob->query("locktime")) ob->set("locktime", time);
  call_out("check_time", CALL_TIME, me);
}

//函数：心跳
void check_time(object me) {
  int old_exp, add_exp, MyLevel, index;
  object ob;

  if (!me || !userp(me)) {
    return;
  }

  ob = this_object();
  if (ob->query("locktime") <= time()) {
    ob->set("long", "道具已经到期，请做丢弃处理。\n");
    return;
  }

  old_exp = me->query_temp("temp_exp");
  MyLevel = 1 + me->query("jym_level/vip_level");
  if (me->query("jym_level/vip")) {
    index = (MyLevel * MyLevel) / 2;
    if (!index) index = 1;
    add_exp = ((me->query(
      "combat_exp",
      1
    ) - old_exp) / 40) * ((MyLevel * MyLevel * MyLevel) / index) * 4;
  } else add_exp = ((me->query("combat_exp", 1) - old_exp) / 40) * 4;

  if (add_exp >= 5000000) {
    me->set_temp("temp_exp", me->query_exp());
  } else if (add_exp > 0) {
    ADD_EXP(me, add_exp);
    me->set_temp("temp_exp", me->query_exp());
    tell_object(me, sprintf(HIY "您额外获得了%d点经验。\n" NOR, add_exp));
  }
  call_out("check_time", CALL_TIME, me);
}
