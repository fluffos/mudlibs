// zhang.c 张天师

#include <ansi.h>
#include <mudlib.h>
#include <command.h>

inherit BHNPC;

int ask_me();
int ask_pot();
int ask_take();
int ask_check();
int ask_card();

void create()
{
	set_name(HIC"银行出纳"NOR, ({ "chu na", "chuna" }));
	set("age", 20);
	set("gender", "女性");
	set("long", "这是一位浴血江湖的出纳员你可以在他这里存取潜能（ask chuna about 取/存/查潜能/银行卡）。\n");
	set("attitude", "peaceful");
	set("str", 38);
        set("int", 35);
        set("con", 38);
	set("dex", 39);
        set("max_qi", 8000000);
        set("max_jing", 8000000);
        set("max_neili", 8000);
        set_skill("taoism", 350);
        set("chat_chance_combat", 3);
	set("chat_msg_combat", ({
                "银行出纳说道：我这里可以存潜能，取潜能，方便玩家啊！\n",
	}));

        set("inquiry", ([
                "存潜能" : (: ask_pot :),
                "取潜能" : (: ask_take :),
                "查潜能" : (: ask_check :),
                "银行卡" : (: ask_card :)
                   ]));

	setup();
	carry_object("/clone/cloth/cloth")->wear();
}






int ask_pot()
{      
        this_player()->is_busy(2);
        if ( this_player()->query("potential" ) < 100100){
        command("say 你只有这么点潜能，存什么存？？" );
        return 1;
        }     

        if ( this_player()->query("zhang_potential" ) > 121400){
             command("say 你存了太多的潜能了，用掉点吧。" );
             return 1;
        }     

        this_player()->add("potential",-100000);
        this_player()->add("zhang_potential",10);

        
        command("say 好吧，你在我这里存放了"+chinese_number(this_player()->query("zhang_potential")*10000)+"点潜能。" );

        return 1;
}


int ask_take()
{      
        object me;
        me = this_player();
        if ( this_player()->query("potential" ) > 2100000000){
        command("say 你身上潜能太多了，先去用掉点吧" );
        return 1;
        }     

        if ( this_player()->query("zhang_potential" ) < 1){
             command("chat 巫师快来啊，"+me->query("name")+"要骗潜能。巫师不在，本姑娘先给你点教训。" );
             me->unconcious();

             return 1;
        }     

        this_player()->add("potential",100000);
        this_player()->add("zhang_potential",-10);

        command("say 好吧，这十万点潜能先给你。" );
        command("say 你在我这里还存了"+chinese_number(this_player()->query("zhang_potential")*10000)+"点潜能。" );
        return 1;
}

int ask_check()
{      
        
   this_player()->is_busy(2);

        if ( this_player()->query("zhang_potential" ) < 1){
             command("say 你在我这里没有存潜能。" );
             return 1;
        }     

        command("say 你在我这里还存了"+chinese_number(this_player()->query("zhang_potential")*10000)+"点潜能。" );

        return 1;
}

int ask_card()
 {
        object me,ob;
        me = this_player();
        ob = this_object(); 
       
        if ( present("bank card", this_player()) ){
         command("say 你身上已经有一张银行卡了，真是贪得无餍！" );

return 1;
}               
         
message_vision("\n银行出纳瞧了$N一眼，转过身，从柜台里取出一张递给$N。\n",  this_player());
command("say 你要好好保管这张银行卡，如果卡丢了你还可以回来问我要的。" );

              ob = new("/yxjh/clone/misc/potcard");
              ob->move(this_player());
 

   return 1;
      
}