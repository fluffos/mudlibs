#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void init() {
  add_action("do_shoot", "shoot");
}

void create() {
  set_name(HIY "专炸小夜的臭鸡蛋" NOR, ({ "chou dan", "boom" }));
  set_weight(70000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("value", 50000);
    set("material", "steel");
    set("long", "这是一颗汇聚了江湖里所有科技精英的心血，而制造出来的旷世奇弹－－专炸小夜的臭鸡蛋。\n");
    set("wield_msg", "$N从裤袋里偷偷地摸出一颗$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n放回裤袋里。\n");
  }
  init_blade(1000000000);
  setup();
}

int do_shoot() {
  object me, *enemy;
  me = this_player();
  enemy = all_inventory(environment(me));
  for (int i = 0; i < sizeof(enemy); i++) {
    if (!enemy[i]) continue;
    if (enemy[i] == me) continue;
    if (enemy[i] == this_object()) continue;
    if (!enemy[i]->is_character() || enemy[i]->is_corpse() || enemy[i]->is_zombie()) continue;
    if (!living(enemy[i])) continue;
    message_vision(HIR "\n$N对准$n扔下一个专炸小夜的臭鸡蛋！！！\n只听「乒」地一声巨响，$n惨叫一声，缓缓地仆倒在血泊里！\n\n" NOR,
      me, enemy[i]);
    enemy[i]->unconcious();
  }
  destruct(this_object());
  return 1;
}
