// cloth.c
//
// This is the basic equip for players just login.
#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create() {
  set_name(YEL "老猫的皮" NOR, ({ "luoyun pi", "mao pi" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("no_drop", 1);
    set("no_give", 1);
    set("value", 500000);
    set("long", "这是江湖的最高领导人luoyun的专用的猫皮。\n");
    set("material", "iron");
    set("armor_prop/intelligence", 50);
    set("armor_prop/dodge", 200);
    set("armor_prop/armor", 2000);
    set("armor_prop/attack1", 210000);
    set("armor_prop/defense1", 210000);
  }
  setup();
}

int move(mixed dest) {
  if (!userp(dest)) return ::move(dest);
  if (::move(dest) == 0) return 0;
  message("channel:rumor", YEL "【谣言】" + "某人：老猫的皮被" +
    dest->query("name") + "抢到手了！\n" NOR, users());
  return 1;
}
