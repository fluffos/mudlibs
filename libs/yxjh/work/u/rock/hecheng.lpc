//装备质量提升系统 NPC
//edit by rock
//2008年10月29日

#include <ansi.h>
inherit NPC;

#define EQUIP_UP "/adm/item/equip"
#define RETURN_OBJ "/u/rock/return_obj/shuijing"

int do_UpEquip();
void do_UpEquip_2(string arg, object me);
int do_FenJie();
void do_FenJie_2(string arg, object me);
int do_QianKun();
int do_JianDing();
void do_JianDing_2(string arg, object me);
int do_KaiGuang();
void do_KaiGuang_2(string arg, object me);

void create() {
  set_name("装备管理员", ({ "quality man", "man" }));
  set("title", HIM "装备升级|装备鉴定" NOR);
  set("age", 55);
  set("long", "有了我，您的装备品质将得到完美的提升。\n");

  set("inquiry", ([
    "装备升级": (: do_UpEquip :),
    "鉴定装备": (: do_JianDing :),
    "装备开光": (: do_KaiGuang :),
    //		"邦定装备"      : (: do_BiangDing :),
    //		"取消邦定"      : (: do_NoBangDing :),
    //		"合成乾坤锁"    : (: do_QianKun :),
    //		"分解装备"      : (: do_FenJie :),
  ]));

  set("no_kill", 1);

  setup();
}

int query_all_object(object me, int index) {
  object *inv;
  int i, size, shuliang = 0;

  inv = all_inventory(me);
  size = sizeof(inv);

  for (i = 0; i < size; i++) {
    if (inv[i]->query("id") == "rock crystal") {
      if (index && shuliang < index) {
        destruct(inv[i]);
      }
      shuliang++;
    }
  }
  return shuliang;
}

//合成乾坤锁
int do_QianKun() {
  object me, item;
  me = this_player();

  if (query_all_object(me, 0) < 2) {
    tell_object(me, "你身上的魔光水晶不足。\n");
    return 1;
  }

  if (item = new("/u/rock/get_pet.lpc")) {
    query_all_object(me, 2);
    tell_object(me, "乾坤锁合成成功。\n");
    item->move(me);
    return 1;
  }
}

//函数：转入提升装备
int do_UpEquip() {
  object me;
  int money;

  me = this_player();
  money = me->query("jym_money", 1);

  if (!money || money < 10) {
    tell_object(me, " 你的元宝不足。\n");
    return 1;
  }

  tell_object(me, "请输入你要提升质量的物品ID:\n");
  input_to("do_UpEquip_2", me);
  return 1;
}

//函数：提升装备
void do_UpEquip_2(string arg, object me) {
  object item, user_item;
  int zhiliang, money, index, rand, max_mosaic, mosaic;

  if (!me) return;

  if (!arg || !stringp(arg) || !item = present(arg, me)) {
    tell_object(me, "你身上没有这件物品。\n");
    return;
  }

  if (!item->query_xy()) {
    tell_object(me, "你无法提升这件物品的品质。\n");
    return;
  }
  zhiliang = item->query("zhiliang");
  if (zhiliang > 55) {
    tell_object(me, "这件完美装备无法提升。\n");
    return;
  }

  if (user_item = me->query_temp("armor/cloth")) {
    if (user_item->query("id") == item->query("id")) {
      tell_object(me, sprintf("请把%s脱下，方可对其提升。\n", item->query("name")));
      return;
    }
  }
  if (user_item = me->query_temp("weapon")) {
    if (user_item->query("id") == item->query("id")) {
      tell_object(me, sprintf("请把%s放下，方可对其提升。\n", item->query("name")));
      return;
    }
  }
  item->unequip();

  max_mosaic = item->query("mosaic_index");
  mosaic = item->query("mosaic");
  if (mosaic >= max_mosaic) {
    tell_object(me, "这件装备的镶嵌孔没有空位了。");
    return;
  }
  if (!zhiliang) { index = 30; }  //  rand = 100; }
  else if (zhiliang == 1) { index = 60; }  //  rand = 50; }
  else if (zhiliang == 2) { index = 100; }  // rand = 30; }
  else { index = zhiliang * 100; }  // rand = 25; }

  //	if(item->query("level") < 50) rand = 100;

  money = me->query("jym_money", 1);
  if (money < index) {
    tell_object(me, "你的元宝余额不足。\n");
    return;
  }

  me->set("jym_money", money - index);

  //	if(random(100) < rand)
  {
    switch (zhiliang) {
      case 1: EQUIP_UP->init_equip_prop_2(item); break;
      case 2: EQUIP_UP->init_equip_prop_3(item); break;
      default:
        EQUIP_UP->init_equip_prop_1(item);
        if (zhiliang > 2) {
          item->set("zhiliang", zhiliang + 1);
          item->set("name", item->query("_name"));
        }
        break;
    }
    item->add("mosaic", 1);
    item->delete("long");
    item->init();
    //		me->add("jym_level/buy_add",index);
    tell_object(me, sprintf("『%s』品质提升完成。\n", item->query("name")));
  }
  //	else tell_object(me,sprintf("『%s』品质提升失败。\n",item->query("name")));
}

int do_FenJie() {
  object me;
  int money;

  me = this_player();

  tell_object(me, "请输入你要提升质量的物品ID:\n");
  input_to("do_FenJie_2", me);
  return 1;
}

void do_FenJie_2(string arg, object me) {
  object item, user_item, rock;
  int zhiliang, i, size, index = 0;
  mapping prop;

  if (!me) return;

  if (!arg || !stringp(arg) || !item = present(arg, me)) {
    tell_object(me, "你身上没有这件物品。\n");
    return;
  }

  if (!item->query_xy()) {
    tell_object(me, "无法分解这件物品。\n");
    return;
  }

  if (user_item = me->query_temp("armor/cloth")) {
    if (user_item->query("id") == item->query("id")) {
      tell_object(me, sprintf("请把%s脱下，方可对其分解。\n", item->query("name")));
      return;
    }
  }
  if (user_item = me->query_temp("weapon")) {
    if (user_item->query("id") == item->query("id")) {
      tell_object(me, sprintf("请把%s放下，方可对其分解。\n", item->query("name")));
      return;
    }
  }
  if (prop = (mapping)item->query("weapon_prop"));
  else prop = (mapping)item->query("armor_prop");

  if (prop) {
    size = sizeof(prop);
    for (i = 0; i < size; i++) {
      if (stringp(prop))
        index += item->query(sprintf("weapon_prop/%s", prop[i])) / 1000;
    }
  }

  index += item->query("weapon_prop/baoji") / 10000;
  index += item->query("jingli") / 10000;
  index += item->query("jing") / 10000;
  index += item->query("dp") / 1000;
  index += item->query("cp") / 1000;
  index += item->query("ap") / 1000;
  index += item->query("mp") / 10000;
  index += item->query("hp") / 10000;
  index += item->query("pp") / 1000;

  zhiliang = item->query("zhiliang");

  index += zhiliang;

  for (i = 0; i < index; i++) {
    if (rock = new(RETURN_OBJ)) {
      rock->move(me);
    }
  }
  if (index) tell_object(me, sprintf(HIM "分解成功，分解出了%d个魔光水晶。\n" NOR, index));
  else tell_object(me, HIR "分解失败。\n" NOR);
  destruct(item);
}

//函数：转入鉴定装备
int do_JianDing() {
  object me;
  int money;

  me = this_player();
  money = me->query("jym_money", 1);

  if (!money || money < 10000) {
    tell_object(me, " 你的元宝币不足1万。\n");
    return 1;
  }
  tell_object(me, "请输入你要提升质量的物品ID:\n");
  input_to("do_JianDing_2", me);
  return 1;
}

//函数：鉴定装备
void do_JianDing_2(string arg, object me) {
  object item, user_item;
  int zhiliang;

  if (!me) return;

  if (!arg || !stringp(arg) || !item = present(arg, me)) {
    tell_object(me, "你身上没有这件物品。\n");
    return;
  }

  if (!item->query_xy() || !item->query("jianding")) {
    tell_object(me, "这件装备无须鉴定。\n");
    return;
  }

  item->delete("jianding");
  item->delete("long");
  item->init();

  zhiliang = item->query("zhiliang");
  if (zhiliang < 3) tell_object(me, sprintf("『%s』鉴定完成，这件装备很普通。\n", item->query("name")));
  else if (zhiliang < 10) tell_object(me, sprintf("『%s』鉴定完成，这件装备还可以。\n", item->query("name")));
  else if (zhiliang < 20) tell_object(me, sprintf("『%s』鉴定完成，这件装备很不错。\n", item->query("name")));
  else if (zhiliang < 30) tell_object(me, sprintf("『%s』鉴定完成，这件装备非常好。\n", item->query("name")));
  else if (zhiliang < 40) tell_object(me, sprintf("『%s』鉴定完成，这件装备是极品。\n", item->query("name")));
  else tell_object(me, sprintf("『%s』鉴定完成，这件装备是极品中的极品。\n", item->query("name")));

  me->add("jym_money", -10000);
}

int do_KaiGuang() {
  object me;
  int money;

  me = this_player();
  money = me->query("points", 1);

  if (!money || money < 100) {
    tell_object(me, "你的浴血币余额不足，请充值。\n");
    return 1;
  }
  tell_object(me, "请输入你要提升质量的物品ID:\n");
  input_to("do_KaiGuang_2", me);
  return 1;
}

void do_KaiGuang_2(string arg, object me) {
  object item, obj;

  if (!me) return;

  if (!arg || !stringp(arg) || !item = present(arg, me)) {
    tell_object(me, "你身上没有这件物品。\n");
    return;
  }

  if (!item->is_kaiguang() || !item->query("_name")) {
    tell_object(me, "这件装备无须开光。\n");
    return;
  }

  if (obj = new(item->query("_name"))) {
    if (obj->query("weapon_prop/damage")) {
      obj->add("jingli", 20000);                               //增加精力
      obj->add("jing", 50000);                                 //增加精神
      obj->add("mp", 100000);                                   //增加体质
      obj->add("ap", 3000);                                    //增加攻击
      obj->add("weapon_prop/intelligence", 3000);          //增加悟性
      obj->add("weapon_prop/strength", 3000);              //增加力量
      obj->add("weapon_prop/dexerity", 3000);              //增加身法
      obj->add("weapon_prop/constitution", 3000);          //增加根骨
    } else {
      obj->add("pp", 3000);                        //追加防御
      obj->add("dp", 3000);                        //增加防御
      obj->add("jing", 50000);                     //增加体质
      obj->add("jingli", 20000);                   //增加攻击
      obj->add("armor_prop/intelligence", 3000);   //增加悟性
      obj->add("armor_prop/strength", 3000);       //增加力量
      obj->add("armor_prop/dexerity", 3000);       //增加身法
      obj->add("armor_prop/constitution", 3000);   //增加根骨
      obj->add("hp", 50000);                       //增加根骨
    }
    obj->set("locktime", time() + 259200);  //72小时
    obj->move(me);
    me->add("points", -100);
    destruct(item);
    tell_object(me, "开光完成。\n");
  } else tell_object(me, "这件装备无须开光。\n");
}
