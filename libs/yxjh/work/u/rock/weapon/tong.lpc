// By jh@ty

inherit ITEM;
int jh = random(5);
mapping *weapon = ({
  ([ "name": "青铜",
    "id": "qing tong",
    "yanse": HIC,
    "int": 5 + random(15),
  ]),
  ([ "name": "黄铜",
    "id": "huang tong",
    "yanse": HIY,
    "str": 5 + random(15),
  ]),
  ([ "name": "白铜",
    "id": "bai tong",
    "yanse": HIW,
    "dex": 5 + random(15),
  ]),
  ([ "name": "绿铜",
    "id": "lv tong",
    "yanse": HIG,
    "con": 5 + random(15),
  ]),
  ([ "name": "紫铜",
    "id": "zi tong",
    "yanse": MAG,
    "damage": 50 + random(80),
  ]),
});
void create() {
  string name, id;

  name = weapon[jh]["name"];

  set_name(weapon[jh]["yanse"] + name + NOR, ({ weapon[jh]["id"] }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("zhongji_hc", 1);
  set("no_put", 1);
  set("value", 5000000);
  if (weapon[jh]["str"])
    set("str", weapon[jh]["str"]);
  if (weapon[jh]["con"])
    set("con", weapon[jh]["con"]);
  if (weapon[jh]["dex"])
    set("dex", weapon[jh]["dex"]);
  if (weapon[jh]["int"])
    set("int", weapon[jh]["int"]);
  if (weapon[jh]["damage"])
    set("damage", weapon[jh]["damage"]);
  set("long", "这是一个铜级的金属，可以用来镶嵌兵器(xiangqian)和合成装备！\n");

  setup();
}
