// By jh@ty

inherit ITEM; 
int jh = random(5);
mapping *weapon= ({
([     "name":     "烧铁",
       "id":   "shao tie",
       "yanse":       HIR,
       "int":           5+random (10),
]),
([     "name":     "红铁",
       "id":   "hong tie",
       "yanse":       HIR,
       "str":           5+random (10),
]),
([     "name":     "绿铁",
       "id":     "lv tie",
       "yanse":       HIG,
       "dex":           5+random (10),
]),
([     "name":     "蓝铁",
       "id":    "lan tie",
       "yanse":       HIB,
       "con":           5+random (10),
]),
([     "name":     "紫铁",
       "id":     "zi tie",
       "yanse":       MAG,
       "damage":       100+random (50),
]),
});
void create()
{
    string name,id;

    name = weapon[jh]["name"];

    set_name(weapon[jh]["yanse"]+name+NOR,({weapon[jh]["id"]}) );  
    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("ty_weapon",1);
   set("no_get",1);
   set("no_put",1);
   set("zhongji_hc",1);
   set("value",10000000);
   if (weapon[jh]["str"])
   set("str",weapon[jh]["str"]);
   if (weapon[jh]["con"])
   set("con",weapon[jh]["con"]);
   if (weapon[jh]["dex"])
   set("dex",weapon[jh]["dex"]);
   if (weapon[jh]["int"])
   set("int",weapon[jh]["int"]);
   if (weapon[jh]["damage"])
   set("damage",weapon[jh]["damage"]);
   set("long", "这是一个铁级的金属，可以用来镶嵌兵器(xiangqian)和合成装备！\n");
   
   setup();
  }

