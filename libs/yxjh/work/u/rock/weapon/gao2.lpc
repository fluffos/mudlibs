// By jh@ty

inherit ITEM;
int jh = random(4);
mapping *weapon = ({
  ([ "name": "日月岩",
    "id": "riyue yan",
    "yanse": HIY,
    "int": 35 + random(50),
    "damage": 100 + random(500),
    "lei": 1,
  ]),
  ([ "name": "阴阳石",
    "id": "yinyang shi",
    "yanse": HIW,
    "str": 35 + random(120),
    "damage": 100 + random(500),
    "lei": 2,
  ]),
  ([ "name": "太级钢",
    "id": "taiji gang",
    "yanse": WHT,
    "dex": 35 + random(120),
    "damage": 100 + random(500),
    "lei": 3,
  ]),
  ([ "name": "赤血铁",
    "id": "chixue tie",
    "yanse": HIR,
    "con": 35 + random(120),
    "damage": 100 + random(500),
    "lei": 4,
  ]),
});
int panduan(int arg) { if (arg) jh = arg - 1; }
void create() {
  string name, id;

  name = weapon[jh]["name"];

  set_name(weapon[jh]["yanse"] + name + NOR, ({ weapon[jh]["id"] }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("no_put", 1);
  //set("no_give",1);
  set("zhongji_hc", 1);
  set("bh", weapon[jh]["lei"]);
  if (weapon[jh]["str"])
    set("str", weapon[jh]["str"]);
  if (weapon[jh]["con"])
    set("con", weapon[jh]["con"]);
  if (weapon[jh]["dex"])
    set("dex", weapon[jh]["dex"]);
  if (weapon[jh]["int"])
    set("int", weapon[jh]["int"]);
  if (weapon[jh]["damage"])
    set("damage", weapon[jh]["damage"]);
  set("long", "这是一个高级的金属，可以用来镶嵌兵器(xiangqian)和合成装备！\n");

  setup();
}
