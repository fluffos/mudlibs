inherit ITEM;

void create() {
  set_name(HIW "点钢" NOR, ({ "dian gang" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("zhongji_hc", 1);
  set("no_put", 1);
  //set("no_give",1);
  set("bh", "2");
  set("str", 8 + random(22));
  set("long", "这是一个钢级的金属，可以用来镶嵌兵器(xiangqian)和合成装备！\n");

  setup();
}
