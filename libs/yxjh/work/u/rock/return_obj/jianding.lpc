//装备回收系统
//edit by rock
//2009.1.3

#include <ansi.h>
inherit ITEM;

int can_eat(object me, string type);

void create() {
  set_name(HIC "鉴定灵符" NOR, ({ "jianding fu" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一张可以在任何地方，鉴定任何装备的灵符。jianding <物品ID>\n");
    set("value", 10000);
  }
  setup();
}

void init() {
  object me = this_player();
  object ob = this_object();
  object room = environment(ob);

  if (!userp(me)) return;
  if (!room || !userp(room)) return;

  add_action("do_jianding", "jianding");
}

int do_jianding(string arg) {
  object me, ob, item;
  int index, zhiliang;

  if (!arg || !stringp(arg)) return 0;

  me = this_player();
  ob = this_object();

  if (!item = present(arg, me)) {
    tell_object(me, "你没有没有这件物品。\n");
    return 1;
  }

  if (item == ob) return 0;

  if (!item->query_xy() || !item->query("jianding")) {
    tell_object(me, "这件装备无须坚定。\n");
    return 1;
  }

  item->delete("jianding");
  item->delete("long");
  item->init();

  zhiliang = item->query("zhiliang");
  if (zhiliang < 3) tell_object(me, sprintf("『%s』鉴定完成，这件装备很普通。\n", item->query("name")));
  else if (zhiliang < 10) tell_object(me, sprintf("『%s』鉴定完成，这件装备还可以。\n", item->query("name")));
  else if (zhiliang < 20) tell_object(me, sprintf("『%s』鉴定完成，这件装备很不错。\n", item->query("name")));
  else if (zhiliang < 30) tell_object(me, sprintf("『%s』鉴定完成，这件装备非常好。\n", item->query("name")));
  else if (zhiliang < 40) tell_object(me, sprintf("『%s』鉴定完成，这件装备是极品。\n", item->query("name")));
  else tell_object(me, sprintf("『%s』鉴定完成，这件装备是极品中的极品。\n", item->query("name")));

  destruct(ob);
  return 1;
}
