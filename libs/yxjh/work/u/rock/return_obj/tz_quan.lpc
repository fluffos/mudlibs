#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIR"套装副本入场券"NOR, ({ "tz quan" }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
            set("unit", "张");
            set("long","一张套装副本入场券，进入套装副本的必须物品。\n");
            set("value", 9999999999);
    }
    setup();
}
