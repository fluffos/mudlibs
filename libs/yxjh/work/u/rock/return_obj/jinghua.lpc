#include <ansi.h>
inherit ITEM;

#define EQUIP_D "/adm/obj/equip"
#define MAKE_INDEX 50    //成功率 百分之
#define ADD_INDEX 200     //合成成功后增加点数

// 函数：所属类别
int query_xy() { return 1 ; }

// 函数：天罡等级
int query_longhen() { return 2 ; }

void create()
{
	set_name("净化石(0级)", ({ "jinghua shi" }) );
	set("unit", "个");
}

void init()
{
	object ob = this_object();
	object room = environment();

	if(!ob->query("long"))
	{
		set("long",
			"装备打孔的必要材料。使用(dakong <物品ID>)给装备打孔。\n"
			"使用(he <净化石ID>)升级净化石。\n"
		);
	}
	if(!room && !userp(room)) return;
	add_action("do_dakong", "dakong");
	add_action("do_he", "he");
}

int do_he(string arg)
{
	object me,ob,item;
	int index,rand;

	if(!arg || !stringp(arg)) return 0;

	me = this_player();
	ob = this_object();
	
	if(!item = present(arg,me))
	{
		tell_object(me,"你没有没有这件物品。\n");
		return 1;
	}

	if(item == ob) return 0;

	if(item->query("level") >= 6)
	{
		tell_object(me,"净化石已经升级到最高等级。\n");
		return 1;
	}

	if(item->query("level") != ob->query("level"))
	{
		tell_object(me,"两个净化石等级不符，相互不能升级。\n");
		return 1;
	}

	if(item->query("id") != "jinghua shi" || !item->query_xy())
	{
		tell_object(me,"只能升级净化石。\n");
		return 1;
	}

	index=item->query("level");
	if(!index) rand = 100;
	else if(index <= 1) rand = 50;
	else if(index <= 2) rand = 20;
	else if(index <= 3) rand = 10;
	else rand = 2;

	if(rand > random(100))
	{
		item->add("level",1);
		item->set_name(sprintf("净化石(%d级)",item->query("level")),({ "jinghua shi" }));
		tell_object(me,HIY"净化石升级成功。\n"NOR);
		destruct(ob);
	}
	else
	{
		tell_object(me,HIY"净化石升级失败。\n"NOR);
		destruct(ob);
	}

	return 1;
}

int do_dakong(string arg)
{
	object me,item,ob,user_item;
	int rand,mosaic,max_index=0;
	string equip_id;
	
	me = this_player();
	ob = this_object();

	if(!arg || !stringp(arg))
	{
		tell_object(me,"你要为哪件装备打孔？\n");
		return 1;
	}
	if(!item = present(arg,me))
	{
		tell_object(me,"你没有没有这件物品。\n");
		return 1;
	}
	if(!item->query_xy())
	{
		tell_object(me,"这件物品无须打孔。\n");
		return 1;
	}
	if(!item->query("weapon_prop") && !item->query("armor_prop"))
	{
		tell_object(me,"这件道具不是武器或装备。\n");
		return 1;
	}

	//检查是否穿戴装备
	if(user_item = me->query_temp("armor/cloth"))
	{
		if(user_item->query("id") == item->query("id"))
		{
			tell_object(me,sprintf("请把%s脱下，方可对其打孔。\n",item->query("name")));
			return 1;
		}
	}
	if(user_item = me->query_temp("weapon"))
	{
		if(user_item->query("id") == item->query("id"))
		{
			tell_object(me,sprintf("请把%s放下，方可对其打孔。\n",item->query("name")));
			return 1;
		}
	}

	//打孔数量
	mosaic = item->query("mosaic_index");
	if(mosaic >= 6)
	{
		tell_object(me,"装备打孔数达到上限");
		return 1;
	}
	if(mosaic != ob->query("level"))
	{
		tell_object(me,sprintf("已经有%d个孔，需要%d级净化石打孔。\n",mosaic,mosaic));
		return 1;
	}

	if(!mosaic) max_index = 100;
	else if(mosaic <= 1) max_index = 50;
	else if(mosaic <= 2) max_index = 20;
	else if(mosaic <= 3) max_index = 5;
	else max_index = 1;

	rand = random(100);
	
	if(rand < max_index)
	{
			item->add("mosaic_index",1);
			item->delete("long");
			item->init();
			tell_object(me,"恭喜你，打孔成功。\n");
			destruct(ob);
			return 1;
	}
	//强化失败
	else
	{
		tell_object(me,"对不起，打孔失败。\n");
		destruct(ob);
		return 1;
	}
	return 0;
}