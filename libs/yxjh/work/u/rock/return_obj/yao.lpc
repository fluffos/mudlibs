inherit ITEM;

int is_yao() { return 1; }

void create()
{
    set_name("草药", ({ "yao" }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
            set("unit", "棵");
            set("value", 10000);
    }
    setup();
}
