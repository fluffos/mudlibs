#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIB"添加剂"NOR, ({ "tianjiaji" }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
    		set("long","用它可以提高幸运丹药的合成几率。\n");
            set("unit", "颗");
            set("value", 10000);
    }
    setup();
}
