#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIB"催化剂"NOR, ({ "cuihuaji" }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
    		set("long","用它才能以合成出幸运丹药。\n");
            set("unit", "颗");
            set("value", 10000);
    }
    setup();
}