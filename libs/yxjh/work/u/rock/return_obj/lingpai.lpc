#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIB"令牌"NOR, ({ "ling-pai" }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
            set("unit", "面");
            set("long","一面看不清楚字迹的令牌，好像前朝留下的，应该和套装副本有很大关系。\n可以拿到黑市王盗陵那里，看看有什么用。");
            set("value", 9999999999);
    }
    setup();
}