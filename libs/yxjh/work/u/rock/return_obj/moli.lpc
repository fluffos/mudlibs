#include <ansi.h>
inherit ITEM;

#define EQUIP_D "/adm/obj/equip"
#define MAKE_INDEX 50    //成功率 百分之
#define ADD_INDEX 200     //合成成功后增加点数

// 函数：所属类别
int query_xy() { return 1 ; }

// 函数：天罡等级
int query_longhen() { return 2 ; }

void create()
{
	set_name("魔力锤", ({ "moli chui" }) );
	set("unit", "个");
	set("long","一个修复装备耐久度上限的锤子。\n");
}

void init()
{
	object ob = this_object();
	object room = environment();

	if(!room && !userp(room)) return;
	add_action("do_xiu", "xiu");
}

int do_xiu(string arg)
{
	object me,item,ob,user_item;
	int rand,max_mosaic,max_index=0,mosaic,level,index;
	string equip_id;
	
	me = this_player();
	ob = this_object();

	if(!arg || !stringp(arg))
	{
		tell_object(me,"你要修理哪件装备的攻击？\n");
		return 1;
	}
	if(!item = present(arg,me))
	{
		tell_object(me,"你没有没有这件物品。\n");
		return 1;
	}
	if(!item->query_xy() || !item->query("max_lasting"))
	{
		tell_object(me,"这件物品无法修理。\n");
		return 1;
	}

	item->set("max_lasting",20000);
	item->delete("long");
	item->init();
	tell_object(me,HIC"修理完成耐久度恢复至两万点。\n"NOR);
	destruct(ob);
	return 1;
}