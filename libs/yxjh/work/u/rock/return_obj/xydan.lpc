//装备回收系统
//edit by rock
//2009.1.3

#include <ansi.h>
inherit ITEM;

int can_eat(object me, string type);

void create() {
  set_name(HIB "幸运丹" NOR, ({ "xingyun dan" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("value", 10000);
  }
  setup();
}

void init() {
  object me = this_player();
  object ob = this_object();
  object room = environment(ob);
  int level = ob->query("level");
  string type = ob->query("_name");

  if (!userp(me)) return;
  if (!room || !userp(room)) return;
  if (!level) level = 1;
  if (!ob->query("long"))
    ob->set("long", sprintf("一颗在华佗那里炼制的幸运丹，可在%d小时内增加 %s %d 点\n", level, type, level * 500));

  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object ob = this_object();
  object me = this_player();
  int level = ob->query("level");
  int time, index;
  string type = ob->query("_name");

  if (arg != ob->query("id")) return 0;

  if (!can_eat(me, type)) {
    tell_object(me, "药效未过，过量服用必定身中其毒。\n");
    return 1;
  }

  if (!level) level = 1;
  time = 3600 * level;
  index = level * 500;

  switch (type) {
    case "悟性":
      me->add("int", index);
      me->set("rock_add/int", index);
      me->apply_condition("rock_int", time);
      break;
    case "身法":
      me->add("dex", index);
      me->set("rock_add/dex", index);
      me->apply_condition("rock_dex", time);
      break;
    case "根骨":
      me->add("con", index);
      me->set("rock_add/con", index);
      me->apply_condition("rock_con", time);
      break;
    case "臂力":
      me->add("str", index);
      me->set("rock_add/str", index);
      me->apply_condition("rock_str", time);
      break;
    case "福缘":
      me->add("kar", index);
      me->set("rock_add/kar", index);
      me->apply_condition("rock_kar", time);
      break;
    case "容貌":
      me->add("per", index);
      me->set("rock_add/per", index);
      me->apply_condition("rock_per", time);
      break;
  }
  message_vision(HIC "$N一大口吞下" + ob->query("name") + "似乎变厉害了一些。\n" NOR, me);
  destruct(ob);
  return 1;
}

int can_eat(object me, string type) {
  string str;

  switch (type) {
    case "悟性": str = "rock_add/int"; break;
    case "身法": str = "rock_add/dex"; break;
    case "根骨": str = "rock_add/con"; break;
    case "臂力": str = "rock_add/str"; break;
    case "福缘": str = "rock_add/kar"; break;
    case "容貌": str = "rock_add/per"; break;
  }

  if (!str || me->query(str)) return 0;
  return 1;
}
