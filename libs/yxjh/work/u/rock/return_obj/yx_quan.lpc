#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIM"英雄副本入场券"NOR, ({ "yx quan" }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
            set("unit", "张");
            set("long","一张英雄副本入场券，进入英雄副本的必须物品。\n");
            set("value", 10000);
    }
    setup();
}
