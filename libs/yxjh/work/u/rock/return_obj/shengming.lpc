#include <ansi.h>
inherit ITEM;

#define EQUIP_D "/adm/obj/equip"
#define MAKE_INDEX 50    //成功率 百分之
#define ADD_INDEX 200     //合成成功后增加点数

// 函数：所属类别
int query_xy() { return 1 ; }

// 函数：天罡等级
int query_longhen() { return 2 ; }

void create()
{
	set_name(YEL"生命宝石"NOR, ({ "sheng ming" }) );
	set("unit", "颗");
	set("long","一个颗能让装备继续存在的宝石。使用命令：useto <装备ID>\n");
}

void init()
{
	object ob = this_object();
	object room = environment();

	if(!room && !userp(room)) return;
	add_action("do_use", "useto");
}

int do_use(string arg)
{
	object me,item,ob,user_item;
	int rand,max_mosaic,max_index=0,mosaic,level,index;
	string equip_id;
	
	me = this_player();
	ob = this_object();

	if(!arg || !stringp(arg))
	{
		tell_object(me,"你要给哪件装备使用生命宝石？\n");
		return 1;
	}
	if(!item = present(arg,me))
	{
		tell_object(me,"你没有没有这件物品。\n");
		return 1;
	}
	if(!item->query_xy() || !item->query("locktime"))
	{
		tell_object(me,"这件物品无法使用生命宝石。\n");
		return 1;
	}

	//time()+24*3600*X    X是天数
	item->set("locktime",time()+24*3600*30);
	item->delete("long");
	item->init();
	tell_object(me,sprintf(HIC"成功为 %s 增加了30天使用时间，到期时间请look <装备ID>。\n"NOR,item->query("name")));
	destruct(ob);
	return 1;
}