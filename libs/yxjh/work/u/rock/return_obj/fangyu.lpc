#include <ansi.h>
inherit ITEM;

#define EQUIP_D "/adm/obj/equip"
#define MAKE_INDEX 50    //成功率 百分之
#define ADD_INDEX 200     //合成成功后增加点数

// 函数：所属类别
int query_xy() { return 1 ; }

void create()
{
	set_name("灵魂防御宝石(0级)", ({ "fangyu shi" }) );
	set("unit", "个");
}

void init()
{
	object ob = this_object();
	object room = environment();

	if(!ob->query("long"))
	{
		set("long",
			sprintf("装备镶嵌的必要材料，提升装备防御力%d点",(ob->query("level")+1)*100)+
			"使用(xiang <物品ID>)给装备镶嵌。\n"
			"使用(up <灵魂防御宝石ID>)升级灵魂防御宝石。\n"
		);
	}
	if(!room && !userp(room)) return;
	add_action("do_dakong", "xiang");
	add_action("do_he", "up");
}

int do_he(string arg)
{
	object me,ob,item;
	int index,rand;

	if(!arg || !stringp(arg)) return 0;

	me = this_player();
	ob = this_object();
	
	if(!item = present(arg,me))
	{
		tell_object(me,"你没有没有这件物品。\n");
		return 1;
	}

	if(item == ob) return 0;

	if(item->query("level") >= 10)
	{
		tell_object(me,"灵魂防御宝石已经升级到最高等级。\n");
		return 1;
	}

	if(item->query("level") != ob->query("level"))
	{
		tell_object(me,"两个灵魂防御宝石等级不符，相互不能升级。\n");
		return 1;
	}

	if(item->query("id") != "fangyu shi" || !item->query_xy())
	{
		tell_object(me,"只能升级灵魂防御宝石。\n");
		return 1;
	}

	index=item->query("level");
	if(!index) rand = 100;
	else if(index <= 1) rand = 50;
	else if(index <= 2) rand = 20;
	else if(index <= 3) rand = 10;
	else rand = 2;

	if(rand > random(100))
	{
		item->add("level",1);
		item->set_name(sprintf("灵魂防御宝石(%d级)",item->query("level")),({ "fangyu shi" }));
		item->delete("long");
		item->init();
		tell_object(me,HIY"灵魂防御宝石升级成功。\n"NOR);
		destruct(ob);
	}
	else
	{
		tell_object(me,HIY"灵魂防御宝石升级失败。\n"NOR);
		destruct(ob);
	}

	return 1;
}

int do_dakong(string arg)
{
	object me,item,ob,user_item;
	int rand,max_mosaic,max_index=0,mosaic,level,index;
	string equip_id;
	
	me = this_player();
	ob = this_object();

	if(!arg || !stringp(arg))
	{
		tell_object(me,"你要提升哪件装备的防御？\n");
		return 1;
	}
	if(!item = present(arg,me))
	{
		tell_object(me,"你没有没有这件物品。\n");
		return 1;
	}
	if(!item->query_xy())
	{
		tell_object(me,"这件物品无法升级。\n");
		return 1;
	}
	if(/*!item->query("weapon_prop") &&*/ !item->query("armor_prop/armor"))
	{
		tell_object(me,"这件道具不是防具。\n");
		return 1;
	}

	//检查是否穿戴装备
	if(user_item = me->query_temp("armor/cloth"))
	{
		if(user_item->query("id") == item->query("id"))
		{
			tell_object(me,sprintf("请把%s脱下，方可对其镶嵌。\n",item->query("name")));
			return 1;
		}
	}
/*	if(user_item = me->query_temp("weapon"))
	{
		if(user_item->query("id") == item->query("id"))
		{
			tell_object(me,sprintf("请把%s放下，方可对其镶嵌。\n",item->query("name")));
			return 1;
		}
	}*/
	//打孔数量
	max_mosaic = item->query("mosaic_index");
	mosaic = item->query("mosaic");
	if(mosaic >= max_mosaic)
	{
		tell_object(me,"这件装备已经没有地方镶嵌宝石了。");
		return 1;
	}

	level = ob->query("level");

	if(!level) max_index = 100;
	else if(level <= 1) max_index = 50;
	else if(level <= 2) max_index = 20;
	else if(level <= 3) max_index = 5;
	else level = 1;

	rand = random(100);
	index = (level+1) * 100;

	if(rand < max_index)
	{
			item->add("mosaic",1);
			item->add("armor_prop/armor",index);
			item->delete("long");
			item->init();
			tell_object(me,"恭喜你，镶嵌成功。\n");
			destruct(ob);
			return 1;
	}
	//强化失败
	else
	{
		tell_object(me,"镶嵌失败。\n");
		destruct(ob);
		return 1;
	}
	return 0;
}