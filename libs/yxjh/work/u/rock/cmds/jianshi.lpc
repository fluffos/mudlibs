#define BG_LIST "/u/rock/log/dalog"

int list_badguys();
int check_id(string id);

int main(object me, string arg)
{
        string *ids, id_list;
        int i, t;

        if( !arg ) return list_badguys();

        else if (sscanf(arg, "+ %s", arg) == 1) {
        if( (strlen(arg) < 3) || (strlen(arg) > 14 ) )
                return notify_fail(HIG"ＩＤ一般是由 3 到 10 个英文字母组成的！\n"NOR);

        i = strlen(arg);
        while(i--)
        if( arg[i]<'a' || arg[i]>'z' )
                return notify_fail(HIG"列入系统监视名单的ＩＤ只能由小写字母组成！\n"NOR);

        if( check_id(arg) )
                {write(HIG"系统监视的名单中已经有这个ＩＤ了！\n"NOR);
//              return list_badguys();
                return 1;
                }
                
        write_file(BG_LIST,arg+"\n");
        write(HIG"在系统监视名单中加入了 "+arg+" 。\n"NOR);
        return list_badguys();
        }

        else if (sscanf(arg, "- %s", arg) == 1) {
        if( !check_id(arg) )
                return notify_fail(HIG"系统监视的名单中并没经有这个ＩＤ了！\n"NOR);

        id_list = read_file(BG_LIST);
        ids = explode(id_list,"\n");
        t = sizeof(ids);
        for(i=0; i<t; i++)
                if( ids[i]==arg )
                {ids -= ({ ids[i] }); break;}
        write_file(BG_LIST, implode(ids, "\n")+"\n", 1);
        write (HIG"\n从系统监视名单中删除 "+arg+" \n"NOR);
        return list_badguys();
        
        }
        else write(HIG"指令格式：addbgs [+|- (玩家的)id]\n"NOR);

        return 1;
}

int list_badguys()
{
        string *ids, id_list;
        int i, t;

        if( file_size(BG_LIST)<0 )
                return notify_fail(HIG"目前还没有系统监视的名单！\n"NOR);
        id_list = read_file(BG_LIST);
        ids = explode(id_list,"\n");
        t=sizeof(ids);
        if( t<1 ) {
                rm(BG_LIST);
                return notify_fail(HIG"目前系统监视的名单中还没有人！\n"NOR);
                }
        write(HIG"目前已被列入系统监视名单的ＩＤ有 "+t+" 个：\n"NOR);
        for(i=0; i<t; i++) {
                write(HIR+ids[i]+"\t\t"+NOR);
                if( (i+1)%4==0 ) write("\n");
                }
        write("\n\n");
        return 1;
}

int check_id(string id)
{
        string *ids, id_list;
        int i, t, p=0;

        if( file_size(BG_LIST)>0 ) 
        {
                id_list = read_file(BG_LIST);
                ids = explode(id_list,"\n");
                t=sizeof(ids);

                if( t>0 ) {
                for(i=0; i<t; i++)
                        if( ids[i]==id )
                                {p=1; break;}
                        }
        }
        
        if( !p ) return 0;
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：addbgs(add bad guys) [+|- (玩家的)id]

这条命令是用来使系统监视某个玩家，并在/log/log_player下生成一个id.log文件。
如果列表中有过多的名单，此命令可能会相对浪费一些系统资源以及硬盘空间。
此命令将记录被监视玩家的所有接收到的信息。
HELP
        );
        return 1;
}

