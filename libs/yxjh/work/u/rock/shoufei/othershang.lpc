// 宝石商人

#define SYSTEM_BUY "/u/rock/shoufei/include/buy.lpc"
inherit NPC;

void create()
{
	set_name("道具商人", ({ "baoshi shang", "shang"}));

	set("gender", "无性");
	set("age", 16);
	set("per", 25);
	set("con", 25);
	set("int", 25);
	set("dex", 25);
	set("str", 25);
	set("title",HIM"心想事成"NOR);
	set("long","有了我，你就能买到最好的道具，让你心想事成。\n");
	set("no_kill",1);

	set("vendor_goods", ([
//		"/clone/shoufei/other/dexwan"          : 1,     //轻身丸     1毛
//                "/clone/shoufei/other/xisuidan"        : 1,     //洗髓丹     1元
//                "/clone/shoufei/other/xiandan"         : 1,     //仙丹       1毛
//                "/clone/shoufei/other/shenliwan"       : 1,     //神力丸     1毛
                "/clone/shoufei/other/perwan"          : 1,     //美容丸     1毛
                "/clone/shoufei/other/karwan"          : 1,     //福缘丹     1毛
                "/clone/shoufei/other/ganjiangling"    : 4,     //干将令     4毛
                "/clone/shoufei/other/moxieling"       : 4,     //莫邪令     4毛
                "/clone/shoufei/other/xiangqiefu"      : 5,     //镶锲符     5毛
                "/clone/shoufei/other/xiangqiezhou"    : 5,     //镶锲符咒   5毛
                "/clone/shoufei/other/jue1"            : 2,     //方舟流星石 2毛
                "/clone/shoufei/other/jue2"            : 2,     //耗子的化石 2毛
                "/clone/shoufei/other/jue3"            : 2,     //方舟的化石 2毛
                "/clone/shoufei/other/jue4"            : 2,     //魔睛烛舞铁 2毛
                "/clone/shoufei/other/huwan"           : 2,     //真龙护腕   2毛
                "/clone/shoufei/other/jiasha"          : 2,     //圣僧袈裟   2毛
                "/clone/shoufei/other/ring"            : 3,     //逍遥指     3毛
                "/clone/shoufei/other/shoe"            : 3,     //千里靴     3毛
                "/clone/shoufei/other/toukui"          : 4,     //狮王头盔   4毛
                "/clone/shoufei/other/xianglian"       : 3,     //法藤项圈   3毛
                "/clone/shoufei/other/yaodai"          : 2,     //黄金腰带   2毛
                "/clone/shoufei/other/yuyi"            : 4,     //风彩羽衣   4毛
                "/clone/shoufei/other/zhulou"          : 2,     //竹篓       2毛
                "/clone/shoufei/item/roombox"          : 10,     //玩家房间  10毛
//                "/u/jerry/vip/vipobj"                  : 97,     //贵宾卡    97毛 
                "/u/jerry/vip/jerryck"                 : 10,     //仓库备用包10毛  
//                "/u/jerry/vip/czzy1.lpc"                 : 1,     //成长1      1毛  
//                "/u/jerry/vip/czzy2.lpc"                 : 3,     //成长2     3毛  
//                "/u/jerry/vip/czzy3.lpc"                 : 10,     //成长3     1元
//                "/u/jerry/vip/czzy3.lpc"                 : 10,     //成长3     1元    
//                "/u/jerry/jerryobj/neilidan"           : 3,     //内力丹     3毛 
//                "/u/jerry/jerryobj/jinglidan"          : 3,     //精力丹     3毛 
//                "/u/jerry/vip/vipobj1"                 : 17,     //精力丹    1.7元 
                "/u/rock/return_obj/cuihuaji.lpc"                 : 10,     //催化剂     1元
				"/u/rock/return_obj/tianjiaji.lpc"                : 5,      //添加剂     5毛
	]));

	setup();
	carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

int do_list()
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(SYSTEM_BUY->do_list(me,npc)) return 1;
	else
	{
		tell_object(me,"对不起,现在没有东西出售。\n");
		return 1;
	}
}

int do_buy(string arg)
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(!arg)
	{
		tell_object(me,"你想买什么？\n");
		return 1;
	}

	return SYSTEM_BUY->do_buy(me,npc,arg);
}
