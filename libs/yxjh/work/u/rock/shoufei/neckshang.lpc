// 宝石商人

#define SYSTEM_BUY "/u/rock/shoufei/include/buy.lpc"
inherit NPC;

//出售装备级别 (0初级 1中级 2高级 3卓越)
int query_level() { return 1; }

void create() {
  set_name("项链商人", ({ "baoshi shang", "shang" }));

  set("gender", "男性");
  set("age", 16);
  set("per", 25);
  set("con", 25);
  set("int", 25);
  set("dex", 25);
  set("str", 25);
  set("title", HIM "天下项链" NOR);
  set("long", "有了我，你就能买到天下最厉害的装备。\n");
  set("no_kill", 1);

  set("vendor_goods", ([
    "/clone/shoufei/equip/neck/txl": 2,
    "/clone/shoufei/equip/neck/qtxl": 2,
    "/clone/shoufei/equip/neck/tiexl": 3,
    "/clone/shoufei/equip/neck/htxl13": 3,
    "/clone/shoufei/equip/neck/tongxl": 2,
    "/clone/shoufei/equip/neck/qingtxl": 2,
    "/clone/shoufei/equip/neck/tiexl3": 3,
    "/clone/shoufei/equip/neck/heitxl": 3,
    "/clone/shoufei/equip/neck/txl9": 2,
    "/clone/shoufei/equip/neck/qtxl2": 2,
    "/clone/shoufei/equip/neck/txl2": 3,
    "/clone/shoufei/equip/neck/htxl2": 3,
    "/clone/shoufei/equip/neck/txl10": 2,
    "/clone/shoufei/equip/neck/qtxl3": 2,
    "/clone/shoufei/equip/neck/txl3": 3,
    "/clone/shoufei/equip/neck/htxl3": 3,
    "/clone/shoufei/equip/neck/txl11": 2,
    "/clone/shoufei/equip/neck/qtxl4": 2,
    "/clone/shoufei/equip/neck/txl4": 3,
    "/clone/shoufei/equip/neck/htxl4": 3,
    "/clone/shoufei/equip/neck/txl12": 2,
    "/clone/shoufei/equip/neck/qtxl5": 2,
    "/clone/shoufei/equip/neck/txl5": 3,
    "/clone/shoufei/equip/neck/htxl5": 3,
    "/clone/shoufei/equip/neck/txl7": 2,
    "/clone/shoufei/equip/neck/qtxl6": 2,
    "/clone/shoufei/equip/neck/txl6": 3,
    "/clone/shoufei/equip/neck/htxl6": 3,
  ]));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

int do_list() {
  object me, npc;
  me = this_player();
  npc = this_object();

  if (SYSTEM_BUY->do_list(me, npc)) return 1;
  else {
    tell_object(me, "对不起,现在没有东西出售。\n");
    return 1;
  }
}

int do_buy(string arg) {
  object me, npc;
  me = this_player();
  npc = this_object();

  if (!arg) {
    tell_object(me, "你想买什么？\n");
    return 1;
  }

  return SYSTEM_BUY->do_buy(me, npc, arg);
}
