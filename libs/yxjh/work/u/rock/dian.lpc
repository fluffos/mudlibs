//可以不用NPC的形式表达
//用任何一种方式表达既可,也可以用main函数

#include <localtime.h>
inherit ITEM;

//点卡序列号存放文件定义
#define FILE "/data/points.txt"

//函数声名
int do_check(string arg);

//函数: 构造函数
void create()
{
	//添加相关信息,和初始化信息
	set_name("点卡生成器", ({ "dianka" }) );
	set("long","命令<check>\n");
	set("unit", "个");
	set("no_save",1);
}

void init()
{
    //添加相关命令
    add_action("do_check", "check");
}

//函数:命令响应函数
int do_check(string arg)
{
	//声明时间(整型)
	int time = time();
	//声名 localtime (混合型)
	mixed localtime = localtime(time);
	//声名年
	int years = localtime[LT_YEAR];
	//声名月
	int on = 1+localtime[LT_MON];
	//声明日
	int day = localtime[LT_MDAY];
	//声明时
	int hour = localtime[LT_HOUR];
	//声明分
	int min = localtime[LT_MIN];
	//声明秒
	int sec = localtime[LT_SEC];
	//声明转16进制基础数值 //1、16、256、4096
	int index_1 = 1,index_2 = 16,index_3 = 256,index_4 = 4096;
	//声明要用到的变量
	int index,i,j,yushu,chushu,flag;
	string str="",temp,xulie;
	object me = this_player();

	flag = to_int(arg);

	if(flag < 10) flag = 10;

	//生成序列号str
	for(i=0;i<6;i++)
	{
		switch(i)
		{
			case 0 : index = years; break;
			case 1 : index = on;    break;
			case 2 : index = day;   break;
			case 3 : index = hour;  break;
			case 4 : index = min;   break;
			case 5 : index = sec;   break;
		}
		j=2;
		while(j--)
		{
			if(index >= index_4)
			{
				chushu = index/index_4;
				yushu = index-index_4;
			}
			else if(index >= index_3)
			{
				chushu = index/index_3;
				yushu = index-index_3;
			}
			else if(index >= index_2)
			{
				chushu = index/index_2;
				yushu = index-index_2;
			}
			else
			{
				chushu = index/index_1;
				yushu = index/index_1;
			}
			//记录下除数
			str += sprintf("%d",chushu);
			if(yushu <= 1) break; 
			else index = yushu;;
		}
		str += " ";
	}

	//序列号头加壳
	temp = sprintf("CARD:JYM%d %d  SN:%s",random(time()),flag,str);
	//序列号尾加壳
	xulie = sprintf("%s%d",temp,random(time()));
	//字串写入文本文件
	write_file(FILE,sprintf("%s\n",xulie));

	tell_object(me,xulie+"\n");
	return 1;
}