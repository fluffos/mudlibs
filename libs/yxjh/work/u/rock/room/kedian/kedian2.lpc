//quest 2010 8 12
inherit ROOM;
void create() {
  set("short", "客店走廊");
  set("long", @LONG
你正走在客店二楼的走廊上，木质的地板走在上面咚咚作响
所有的房间都紧闭房门，从二楼的天井向下看是客店的门厅，客
人很多，熙熙攘攘的人流，聊天的、叫卖的声音起起伏伏，不绝
于耳。
LONG
  );
  set("exits", ([
    "down": __DIR__ "kedian",
    "enter": __DIR__ "kedian3",
    "north": __DIR__ "kedian4",
    "east": __DIR__ "kedian5",
    "south": __DIR__ "kedian6",
  ]));
  setup();
}
