inherit ROOM;
void create()
{
        set("short", CYN"绿林客栈"NOR);
        set("long", @LONG
这是本地一家价钱昂贵知名的客栈，生意非常兴隆。外地游客多
选择这里落脚，不过这里似乎武林人士比较多。各种装束其翻上阵绝
对花枝招展，五光十色。生意兴隆看来老板还是很有头脑也是真的让
人嫉妒也佩服。
LONG
        );
        set("no_fight", 1);
        set("valid_startroom", 1);
        set("no_sleep_room",1);
        set("objects", ([
//           "/d/city/npc/xiaoer" : 1,
        ]));
        set("no_clean_up",1);
        set("exits", ([
                "west" : "/d/city/kedian",
                "up" : __DIR__"kedian2",
        ]));
        setup();
}