#include <ansi.h>

inherit NPC;

void create() {
  set_name("任务NPC", ({ "di ren" }));
  set("gender", "男性");
  set("age", 56);
  set("long", "这家伙是杀人活动任务刷出来的NPC。\n");
  setup();
}

void init() {
  add_action("do_kill", "kill");
  add_action("do_kill", "team kill");
  add_action("do_kill", "touxi");
  add_action("do_kill", "hit");
  add_action("do_kill", "steal");
  add_action("do_kill", "beg");
  add_action("do_kill", "persuade");
  add_action("do_kill", "fight");
}

void die() {
  object me, ob;
  ob = this_object();
  me = ob->query_temp("last_damage_from");

  if (!me) {
    destruct(ob);
    return;
  }

  ADD_EXP(me, 50000000);
  me->add("potential", 200000);
  me->delete_temp("timeQ");
  tell_object(me, HIG "你获得了50000000点实战经验，200000点潜能。\n" NOR);
  tell_object(me, "成功完成任务，重复接取任务请 quest sharen\n");
  ::die();
}

int do_kill(string arg) {
  string what, who;
  object ob = this_object();
  object me = this_player();

  if (!arg || !stringp(arg)) return 0;
  if (!ob->id(arg)) return 0;

  if (ob->query("zhuren") != me->query("id")) {
    tell_object(me, "江湖人士，还是少惹为妙。\n");
    return 1;
  } else if (sscanf(arg, "%s from %s", what, who) == 2 && this_object()->id(who)) {
    tell_object(me, "还是到别处去施展你的本事吧。\n");
    return 1;
  }
  return 0;
}
