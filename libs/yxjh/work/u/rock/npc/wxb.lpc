//打卡员
//edit by rock
#include <ansi.h>
#include <localtime.h>
inherit NPC;
#pragma save_binary
int do_jieri();
int do_zhenju();
int do_tz();
int do_cj();

void create() {
  set_name("喂小饱", ({ "wxb npc" }));

  set("gender", "男性");
  set("age", 16);
  set("per", 25);
  set("con", 25);
  set("int", 25);
  set("dex", 25);
  set("str", 25);
  set("title", HIG "双节活动管理员" NOR);
  set("long", "中秋国庆，双节活动管理员。\n");
  set("no_kill", 1);
  set("inquiry", ([
    "节日奖励": (: do_jieri :),
    "冲穴针具": (: do_zhenju :),
    "节日套装": (: do_tz :),
    "抽奖": (: do_cj :),
  ]));
  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

int do_jieri() {
  object me = this_player();
  int oldTime = me->query_temp("time");

  if (!me->query("vip_nian") && !me->query("vip_yue")) {
    tell_object(me, "你不是VIP无法参加VIP专署活动。\n");
    return 1;
  }

  if ((time() - oldTime) >= 43200) {
    tell_object(me, HIG "你获得了50浴血币。\n" NOR);
    tell_object(me, HIY "你获得了10000元宝。\n" NOR);
    tell_object(me, HIM "你获得了24小时双倍经验。\n" NOR);
    me->add("points", 50);
    me->add("jym_money", 10000);
    me->set("dacard/towExp", time() + 12 * 3600);
    me->set("dacard/IsOk", 1);
    me->set_temp("time", time());
    return 1;
  } else tell_object(me, "你的在线时间不足12小时。\n");
  return 1;
}

int do_zhenju() {
  object me = this_player();
  object item;
  int i;

  if (me->query("zq_zjok")) {
    tell_object(me, "你已经领过针具了。\n");
    return 1;
  }

  for (i = 0; i < 20; i++) {
    if (item = new("/u/rock/item/zhen-ju")) {
      item->set("no_give", 1);
      item->set("no_paimai", 1);
      item->set("no_get", 1);
      item->set("no_sell", 1);
      item->move(me);
    }
  }
  tell_object(me, HIG "你获得了20套针具。\n" NOR);
  for (i = 0; i < 5; i++) {
    if (item = new("/u/rock/item/zhenju")) {
      item->set("no_give", 1);
      item->set("no_paimai", 1);
      item->set("no_get", 1);
      item->move(me);
    }
  }
  tell_object(me, HIG "你获得了5套精致针具。\n" NOR);
  me->set("zq_zjok", 1);
  return 1;
}

void init_item(object me, object obj) {
  if (obj->query("weapon_prop/damage")) {
    obj->add("jingli", 20000);                               //增加精力
    obj->add("jing", 20000);                                 //增加精神
    obj->add("mp", 20000);                                   //增加体质
    obj->add("ap", 3000);                                    //增加攻击
    obj->add("weapon_prop/intelligence", 3000);          //增加悟性
    obj->add("weapon_prop/strength", 3000);              //增加力量
    obj->add("weapon_prop/dexerity", 3000);              //增加身法
    obj->add("weapon_prop/constitution", 3000);          //增加根骨
  } else {
    obj->add("pp", 3000);                        //追加防御
    obj->add("mp", 20000);                                   //增加体质
    obj->add("dp", 3000);                        //增加防御
    obj->add("jing", 20000);                     //增加体质
    obj->add("jingli", 20000);                   //增加攻击
    obj->add("armor_prop/intelligence", 3000);   //增加悟性
    obj->add("armor_prop/strength", 3000);       //增加力量
    obj->add("armor_prop/dexerity", 3000);       //增加身法
    obj->add("armor_prop/constitution", 3000);   //增加根骨
    obj->add("hp", 20000);                       //增加根骨
  }
  obj->set("locktime", time() + 259200);  //72小时
  obj->set("no_give", 1);
  obj->set("no_paimai", 1);
  obj->set("no_get", 1);
  obj->set("no_sell", 1);
  obj->move(me);
  tell_object(me, sprintf(HIG "你获得了%s\n" NOR, obj->query("name")));
}

int do_tz() {
  object me = this_player();
  object item;

  if (me->query("zq_tz")) {
    tell_object(me, "你已经领过套装了。\n");
    return 1;
  }

  if (item = new("/clone/shoufei/tz/cloth/zt")) init_item(me, item);
  if (item = new("/clone/shoufei/tz/ring/zt")) init_item(me, item);
  if (item = new("/clone/shoufei/tz/waist/zt")) init_item(me, item);

  me->set("zq_tz", 1);
  return 1;
}

int do_cj() {
  object me = this_player();
  object *item = ({}), obj, giveItem;
  int i, index, size;
  string file;

  for (i = 0; i < 8; i++) {
    if (obj = present(sprintf("yuebing%d", i + 1), me)) item += ({ obj });
  }
  if (sizeof(item) < 8) {
    tell_object(me, "你的月饼没有凑齐一套。没法抽奖。\n");
    return 1;
  }

  index = random(10);
  file = sprintf("/u/rock/item/yuebing/lingcao/%d", index + 1);
  if (giveItem = new(file)) {
    size = sizeof(item);
    for (i = 0; i < size; i++) destruct(item[i]);
    giveItem->move(me);
    tell_object(me, sprintf("你抽奖获得了 %s 。\n", giveItem->query("name")));
  } else tell_object(me, "系统故障，请联系巫师。\n");
  return 1;
}
