//打卡员
//edit by rock
#include <ansi.h>
#include <localtime.h>
inherit NPC;

void check_time(object me);
int do_daka();
int do_shuang();
int do_query_time();

void create() {
  set_name("赵灵儿", ({ "zhao linger" }));

  set("gender", "女性");
  set("age", 16);
  set("per", 25);
  set("con", 25);
  set("int", 25);
  set("dex", 25);
  set("str", 25);
  set("title", HIG "浴血江湖打卡员" NOR);
  set("long", "有了我，可以让你的修炼，更加顺利。\n");
  set("no_kill", 1);
  set("inquiry", ([
    "打卡": (: do_daka :),
    "领双": (: do_shuang :),
    "上次打卡时间": (: do_query_time :),
  ]));
  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

int do_daka() {
  object me = this_player();
  int daka_time, day, i;
  mixed *localtime, *localtime2;

  if (daka_time = me->query("dacard/time")) {
    localtime = localtime(daka_time);
    localtime2 = localtime(time());
    day = localtime[LT_MDAY];

    check_time(me);
    /*
		if(localtime[LT_MON] != localtime2[LT_MON])
		{
			me->delete("dacard");
			tell_object(me,HIG"赵灵儿说道：新月新气象，浴血江湖陪你一同走过上个月，迎来这崭新的这个月，祝您这个月中，心想事成，万事如意。\n"NOR);
		}
*/
    if (day == localtime2[LT_MDAY]) {
      tell_object(me, "你今天已经打过卡了，明天再来吧。\n");
      return 1;
    }
    if (localtime[LT_HOUR] == localtime2[LT_HOUR]) {
      tell_object(me, HIG "赵灵儿说道：嘿！又是你，今天真准时，昨天你也是这个时候来的！要保持哦。\n" NOR);
      i = 1 + random(10000000);
      ADD_EXP(me, i);
      tell_object(me, sprintf(WHT "你获得了%d点经验奖励。\n" NOR, i));
    } else if (localtime[LT_HOUR] < localtime2[LT_HOUR]) {
      tell_object(me, HIG "赵灵儿说道：你好吗？修炼顺利吧，你比昨天早到了。加油！\n" NOR);
      i = 1000000 + random(10000000);
      ADD_EXP(me, i);
      tell_object(me, sprintf(WHT "你获得了%d点经验奖励。\n" NOR, i));
    } else if (localtime[LT_HOUR] > localtime2[LT_HOUR]) {
      tell_object(me, HIG "赵灵儿说道：你迟到了哦！明天要来早一点，呵呵。记住啦！我们的约定。\n" NOR);
    }
  }
  me->add("dacard/cishu", 1);
  me->set("dacard/time", time());
  tell_object(me, "赵灵儿大笔一挥，在签到簿上写下你的大名。\n");
  return 1;
}

int do_shuang() {
  int towtime, expTime;
  mixed *localtime, *localtime2;
  object me = this_player();

  if (!me->query("dacard/time") || !towtime = me->query("dacard/cishu")) {
    tell_object(me, HIG "赵灵儿说道：你还没打卡，不能领双。\n" NOR);
    return 1;
  }

  check_time(me);

  expTime = me->query("dacard/towExp");
  if (expTime) {
    localtime = localtime(expTime);
    if (expTime > time()) {
      tell_object(me, HIG "赵灵儿说道：你上次领的双还没用完，不要那么贪心吧！\n" NOR);
      if (random(100) < 50) tell_object(
        me,
        sprintf(
          HIG "赵灵儿说道：要到%d日%d时%d分%d秒以后才能领取，下次别这样了！\n" NOR,
          localtime[LT_MDAY],
          localtime[LT_HOUR],
          localtime[LT_MIN],
          localtime[LT_SEC]
        )
      );
      else tell_object(me, HIG "赵灵儿说道：哼，双倍到期时间，不告诉你！\n" NOR);
      return 1;
    }
  }
  localtime = localtime(me->query("dacard/time"));
  localtime2 = localtime(time());
  if (localtime[LT_MDAY] != localtime2[LT_MDAY]) {
    tell_object(me, HIG "赵灵儿说道：你今天没有打卡！\n" NOR);
    return 1;
  }
  if (me->query("dacard/IsOk")) {
    tell_object(me, HIG "赵灵儿说道：你今已经领过双了！请明天再领。\n" NOR);
    return 1;
  }

  if (towtime > 24) towtime = 24;

  me->set("dacard/towExp", time() + towtime * 3600);
  me->set("dacard/IsOk", 1);
  tell_object(me, sprintf("你本月打卡%d次，获得了%d小时，双倍经验。\n", towtime, towtime));
  tell_object(me, HIC "赵灵儿从储物袋里拿出一个晶莹剔透的光团，送到了你的胸口。光团马上化进你的身体内。\n" NOR);
  return 1;
}

void check_time(object me) {
  mixed *localtime, *localtime2;

  localtime = localtime(me->query("dacard/time"));
  localtime2 = localtime(time());

  if (localtime[LT_MDAY] != localtime2[LT_MDAY]) me->delete("dacard/IsOk");


  if (localtime[LT_MON] != localtime2[LT_MON]) {
    me->delete("dacard");
    tell_object(me, HIG "赵灵儿说道：新月新气象，浴血江湖陪你一同走过上个月，迎来这崭新的这个月，祝您这个月中，心想事成，万事如意。\n" NOR);
  }
}

int do_query_time() {
  int time;
  mixed *localtime;
  object me = this_player();

  time = me->query("dacard/time");
  localtime = localtime(time);
  tell_object(
    me,
    sprintf(
      "%s的打卡时间是： %d日 %d时 %d分 %d秒\n",
      me->query("name"),
      localtime[LT_MDAY],
      localtime[LT_HOUR],
      localtime[LT_HOUR],
      localtime[LT_MIN],
      localtime[LT_SEC]
    )
  );

  return 1;
}
