#include <ansi.h>
inherit NPC;

#define PRODUCT "/clone/shoufei/product"
#define EQUIP_UP "/adm/item/equip"

int is_boss() { return 1; }

void do_perform()
{
	object me = this_object();

	if(me->query("qi") < me->query("max_qi") ) me->add("qi",10+random(20));
	if(me->query("neili") < me->query("max_neili") ) me->add("neili",10+random(20));
	if(me->is_busy()) me->interrupt_me();

	if(me->is_fighting())
	{
		command("perform sword.lian");
		command("perform sword.chan");
		command("perform sword.sui");
		command("yun recover");
		command("perform cang");
		command("perform xian");
		command("perform zhui");
		command("perform cang");
		command("perform xian");
		command("perform zhui");
		command("perform wuji");
		command("perform kan");
		command("perform tiandi");
		command("perform zhua");
		command("perform tian");
		command("perform feng");
		command("perform qixing");
		command("perform sanqing");
		command("perform tonggui");
		command("perform duan");
		command("perform ding");
		command("perform tan");
		command("perform xixueqingfu");
		command("perform lingshe");
	}
	call_out("do_perform",1+random(2));
}

void create()
{
	set_name("boss", ({ "boss"}));
	set("chat_chance", 5); 
	set("chat_msg", ({ 
		(: random_move :) 
	}) ); 
	setup();
	carry_object("/clone/misc/hic_cloth")->wear();
	do_perform();
}

void die()
{
	object me,ob;
	object *team;
	int i,size,level,exp,pot;
	string file;

	ob = this_object();
	me = ob->query_temp("last_damage_from");

	if(!me && !objectp(me)) return;

	team = me->query_team();

	if(!team) team = ({ me });

	size = sizeof(team);
	for(i=0;i<size;i++)
	{
		if(!team[i]) continue;
		level =  team[i]->query_level() - ob->query_level();
		exp = 50000*((1+random(ob->query_level()))*2)/size;

		if(exp)
		{
			pot = exp/2;
			tell_object(team[i],sprintf(HIY"你获得了%d点经验，%d点潜能。\n"NOR,exp,pot));
			ADD_EXP(team[i],exp);
			team[i]->add("potential",pot);
		}
	}
	
	//掉宝
/*	ran = random(ob->query_level()/10);
	for(j=0;j<ran;j++)
	{
		rand = random(100);
		level = ob->query_level();
		if(level > 120) level = 120;
	
		if(rand < 70) file = PRODUCT->get_random_level_product(1+random(15),level-5,level);
		else if(rand < 20) file = PRODUCT->get_random_level_product(1+random(15),level,level);
	
		if(file)
		{
			item = new(file);
			if(item)
			{
				item->set("_name",item->query("name"));
				EQUIP_UP->init_equip_prop_1(item);
				EQUIP_UP->init_equip_prop_2(item);
				EQUIP_UP->init_equip_prop_3(item); //卓越物品
				item->move(environment(ob));
			}
		}
	}
	rand = random(100);
	if(rand < 90) { item = new("/clone/shoufei/item/liuxing"); if(item) item->move(environment(ob)); }
	if(rand < 80) { item = new("/clone/shoufei/item/longzhu"); if(item) item->move(environment(ob)); }
	if(rand < 70) { item = new("/clone/shoufei/item/hongyu"); if(item) item->move(environment(ob)); }
	if(rand < 60) { item = new("/clone/shoufei/item/tianyuan"); if(item) item->move(environment(ob)); }
	if(rand < 50) { item = new("/clone/shoufei/item/tiangang1"); if(item) item->move(environment(ob)); }
	if(rand < 45) { item = new("/clone/shoufei/item/tiangang2"); if(item) item->move(environment(ob)); }
	if(rand < 40) { item = new("/clone/shoufei/item/tiangang3"); if(item) item->move(environment(ob)); }
	if(rand < 35) { item = new("/clone/shoufei/item/tiangang4"); if(item) item->move(environment(ob)); }
	if(rand < 30) { item = new("/clone/shoufei/item/longhen1"); if(item) item->move(environment(ob)); }
	if(rand < 25) { item = new("/clone/shoufei/item/longhen2"); if(item) item->move(environment(ob)); }
	if(rand < 20) { item = new("/clone/shoufei/item/longhen3"); if(item) item->move(environment(ob)); }
	if(rand < 10) { item = new("/clone/shoufei/item/longhen4"); if(item) item->move(environment(ob)); }
	if(rand < 5+ ob->query_level()/10)
	{
		level = me->query_level();
		if(level < 100) level = 100;

		PRODUCT->get_random_level_product(1+random(15),level,level);
		item = new("/clone/shoufei/item/longhen4");
		if(item) item->move(environment(ob));
	}*/

	message("channel:rumor",YEL"【武林至尊】"HIY+"BOSS "+ob->name()+" 被 "+team[0]->name()+" 歼灭了。\n"NOR,users());
	::die();
}