#include <ansi.h>
inherit BHNPC;
#define SYSTEM_BUY "/u/rock/shoufei/include/buy_yxb.lpc"
string do_sell();
string do_lingpai();
int do_tzcopy();
void do_tzcopy_2(string arg, object me);
void do_tzcopy_3(string arg, object me);
void do_tzcopy_4(object me);

void create() {
  set_name("王盗陵", ({ "wang daolin", "wang" }));
  set("gender", "男性");
  set("nickname", "黑市主席");
  set("age", 31);
  set("no_suck", 1);
  set("no_get", 1);
  set("long", "它是这里的掌柜，但估计不会是这里的幕后首脑。\n");
  set("str", 29);
  set("dex", 26);
  set("con", 24);
  set("int", 22);
  set("per", 18);
  set("shen", -7500);
  set("max_qi", 800000);
  set("max_jing", 800000);
  set("neili", 2000);
  set("max_neili", 200000);
  set("eff_jingli", 180000);
  set_skill("blade", 800);
  set_skill("zixia-shengong", 800);
  set_skill("fanliangyi-dao", 600);
  map_skill("blade", "fanliangyi-dao");

  set("combat_exp", 750000);
  //        set("chat_chance_combat", 55);
  //        set("chat_msg_combat", ({
  //                (: perform_action, "blade.sanshen" :),
  //        }));
  set("vendor_goods", ([
    "/u/rock/return_obj/tz_quan1": 100,     //套装400级门票
    "/u/rock/return_obj/tz_quan2": 150,     //套装500级门票
    "/u/rock/return_obj/tz_quan3": 200,     //套装600级门票
  ]));
  set("inquiry", ([
    "出货": (: do_sell :),
    "令牌": (: do_lingpai :),
    "高级套装副门票": (: do_tzcopy :),
  ]));
  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

int do_list() {
  object me, npc;
  me = this_player();
  npc = this_object();

  if (SYSTEM_BUY->do_list(me, npc)) return 1;
  else {
    tell_object(me, "对不起,现在没有东西出售。\n");
    return 1;
  }
}

int do_buy(string arg) {
  object me, npc;
  me = this_player();
  npc = this_object();

  if (!arg) {
    tell_object(me, "你想买什么？\n");
    return 1;
  }

  return SYSTEM_BUY->do_buy(me, npc, arg);
}

string do_sell() {
  return "想要出货？直接把货给(give)我既可。\n";
}

string do_lingpai() {
  object me = this_player();
  string msg = "";

  if (present("ling-pai", me)) msg = "你身这面令牌应该就是我说的那种令牌。";
  return sprintf(
    "相传这令牌是上古时凡人象征权贵的象征，拿他可以号令群雄，可惜现在大家已经不吃这套了。\n不过有许多人喜欢收藏，如果你能给我一件套装和一面这种令牌，我就给你一张高级套装副本入场券。%s\n",
    msg
  );
}

int accept_object(object me, object obj) {
  object ob = this_object();
  int money, index;

  if (!me || environment(me) != environment()) return 0;

  if (!objectp(obj) || userp(obj)) return 0;

  if (!present(obj, me)) return notify_fail("你没有这件东西。\n");

  if (obj->query("no_sell")) return 0;

  if (!index = obj->query("level")) {
    tell_object(me, "这件东西没人会收，我可不做赔本买卖。\n");
    return 0;
  }

  money = index * (10 + random(50)) / 100;
  if (obj->is_yao()) {
    if (index >= 200) { tell_object(me, "这... 这是灵药啊，价值连城，好东西。\n"); money = index * 5; } else if (index >= 150) {
      tell_object(me, "不错，极品药材，这个我买了。\n"); money = index * 2;
    } else if (index >= 100) { tell_object(me, "这药材挺不错，一定有一些富贵人家愿意收藏吧。\n"); money = index; } else if (index >= 50) {
      tell_object(me, "这药材勉强，我这里先收下吧。\n"); money = index / 2;
    } else { tell_object(me, "这药材是普通草药，遍地都是，你留着自己用吧。\n"); return 0; }
  }

  me->add("jym_money", money);
  tell_object(me, sprintf(HIW "王盗陵递给你%d元宝。\n" NOR, money));
  destruct(obj);
  return 1;
}

int do_tzcopy() {
  object me = this_player();
  tell_object(me, "你要跟我换多少级的门票：400、500、600级。\n");
  input_to("do_tzcopy_2", me);
  return 1;
}

void do_tzcopy_2(string arg, object me) {
  int flag = to_int(arg);
  int index = 0;
  switch (flag) {
    case 400: index = 1; break;
    case 500: index = 1; break;
    case 600: index = 1; break;
  }
  if (!index) {
    tell_object(me, "我这里只有 400级 500级 600级 这几种门票。\n");
    input_to("do_tzcopy_2", me);
    return;
  }
  me->set_temp("tzmp/level", flag);
  tell_object(me, "请输入要给的300级套装ID(注意区分自己使用的装备):\n");
  input_to("do_tzcopy_3", me);
  return;
}

void do_tzcopy_3(string arg, object me) {
  object item;
  if (!arg || !stringp(arg) || !item = present(arg, me)) {
    tell_object(me, "输入有误请重新输入:\n");
    input_to("do_tzcopy_3", me);
    return;
  }

  me->set_temp("tzmp/item", item);
  do_tzcopy_4(me);
}

void do_tzcopy_4(object me) {
  object item1, item2, obj;
  string file;
  int level = me->query_temp("tzmp/level");
  int index = level - 100;

  if (!level || index < 0) return 0;
  if (!item1 = present("ling-pai", me)) {
    tell_object(me, "你身上根本没有令牌，想骗我，小心脑袋。\n");
    me->delete_temp("tzmp");
    return;
  }
  if (!item2 = (object)me->query_temp("tzmp/item")) {
    tell_object(me, "你就存心想骗我，小心脑袋。\n");
    me->delete_temp("tzmp");
    return;
  }
  if (!item2->is_suit() || item2->query("level") < index) {
    tell_object(me, "你这件破烂装备打发药贩的？一边去。\n");
    me->delete_temp("tzmp");
    return;
  }
  switch (level) {
    case 400: file = "/u/rock/return_obj/tz_quan1"; break;
    case 500: file = "/u/rock/return_obj/tz_quan2"; break;
    case 600: file = "/u/rock/return_obj/tz_quan3"; break;
  }
  if (obj = new(file)) {
    tell_object(me, "好的，成交，拿好你的门票。\n");
    obj->move(me);
    destruct(item1);
    destruct(item2);
    me->delete_temp("tzmp");
    return;
  }

  tell_object(me, "系统出错请联系巫师。\n");
  me->delete_temp("tzmp");
}
