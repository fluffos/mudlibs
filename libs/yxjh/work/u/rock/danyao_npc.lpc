//幸运丹药合成NPC
//edit by rock
#include <ansi.h>
inherit NPC;

int do_liandan();
void do_HeCheng_set(string arg,object me);
void do_HeCheng_2(string arg,object me);
void is_ok(object me,int index,int level,int type);
string do_zhenju();

void create()
{
	set_name("华佗", ({ "drug man", "man" }) );
        set("title","幸运丹药提炼师");
	set("age", 55);
	set("long", "有了我，您就能炼出需要的幸运丹药。\n");

	set("inquiry", ([
		"炼幸运丹"  : (: do_liandan :),
		"兑换针具"  : (: do_zhenju :)
	]));

	set("no_kill",1);

	setup();
}

int do_liandan()
{
	object me;
//	int money;

	me = this_player();
/*	money = me->query("points",1);

	if(!money || money < 5)
	{
		tell_object(me," 你的浴血币不足5个。\n");
		return 1;
	}*/
	tell_object(me,"你要合成哪种幸运丹:\n悟性 身法 根骨 臂力 福缘 容貌\n");
	input_to("do_HeCheng_set",me);
	return 1;
}

void do_HeCheng_set(string arg,object me)
{
	int index=0;
	switch(arg)
	{
		case "悟性" : index=1; break;
		case "身法" : index=1; break;
		case "根骨" : index=1; break;
		case "臂力" : index=1; break;
		case "福缘" : index=1; break;
		case "容貌" : index=1; break;
	}
	if(!index)
	{
		tell_object(me,"你要炼制哪种幸运丹:\n悟性 身法 根骨 臂力 福缘 容貌\n");
		input_to("do_HeCheng_set",me);
		return;
	}
	me->set_temp("liandan/type",arg);
	tell_object(me,"请添加要使用的药材 add <ID>:\n");
	input_to("do_yaocai",me);
//	tell_object(me,"请添加你要炼制的物品 add <ID>:\n");
//	input_to("do_HeCheng_2",me);
}

void do_yaocai(string arg,object me)
{
	int i,size;
	object item;
	
	if(arg == "ok")
	{
		if(!me->query_temp("liandan/zhuyao_size"))
		{
			tell_object(me,"没有添加主药,已退出炼丹。\n");
			me->delete_temp("liandan");
			return;
		}
		tell_object(me,"不添加药剂请输入 ok 。添加药剂请输入 add <ID>:\n");
		input_to("do_HeCheng_2",me);
		return;
	}
	else if(arg == "q" || arg == "Q")
	{
		tell_object(me,"已退出炼丹。\n");
		me->delete_temp("liandan");
		return;
	}
	else if(!sscanf(arg,"add %s",arg))
	{
		tell_object(me,"如果要取消请请输入: q 。添加要使用的药材请输入: add <ID>:\n");
		input_to("do_yaocai",me);
	}

	if(!item = present(arg,me))
	{
		tell_object(me,"你身上没有这件物品。\n");
		me->delete_temp("liandan");
		return;
	}
	if(!item->is_yao())
	{
		tell_object(me,"这东西不能做主药。\n");
		me->delete_temp("liandan");
		return;
	}
	size = me->query_temp("liandan/zhuyao_size");
	if(size >= 6)
	{
		tell_object(me,"主药数量已经足够了，请输入 ok\n");
		input_to("do_yaocai",me);
		return;
	}

	for(i=1;i<=size;i++)
	{
		if(item == me->query_temp(sprintf("liandan/zhuyao_%d",i)))
		{
			tell_object(me,"这件物品你已经提交过了。\n");
			input_to("do_yaocai",me);
			return;
		}
	}
	me->add_temp("liandan/zhuyao_size",1);
	me->add_temp("liandan/chenggong",item->query("level"));
	size = me->query_temp("liandan/zhuyao_size");
	me->set_temp(sprintf("liandan/zhuyao_%d",size),item);
	tell_object(me,"继续添加药材请输入 add <ID>。主药材添加完毕请输入 ok。退出炼丹输入 q\n");
	input_to("do_yaocai",me);
}

void do_HeCheng_2(string arg,object me)
{
	object item;
	int size,i,index,level,cuihua_size,zhuyao_size;
	string type;
	
	if(!arg || !stringp(arg))
	{
		tell_object(me,"如果要取消请请输入: q 。\n如果确认合成请输入: ok\n添加提炼物品请输入: add <ID>:\n");
		input_to("do_HeCheng_2",me);
		return;
	}
	if(arg == "q" || arg == "Q")
	{
		tell_object(me,"已退出炼丹。\n");
		me->delete_temp("liandan");
		return;
	}
	else if(arg == "ok")
	{
		if(!type = me->query_temp("liandan/type"))
		{
			tell_object(me,"没有选择要提炼的类别。\n");
			me->delete_temp("liandan");
			return;
		}
		size = me->query_temp("liandan/size");
		level= me->query_temp("liandan/cuihuaji_size");
		for(i=1;i<=size;i++)
		{
			if(!item = me->query_temp(sprintf("liandan/%d",i)))
			{
				tell_object(me,"你提交的提炼物品缺失了一件，退出炼丹。\n");
				me->delete_temp("liandan");
				return;
			}
		}
		for(i=1;i<=level;i++)
		{
			if(!item = me->query_temp(sprintf("liandan/cuihua_%d",i)))
			{
				tell_object(me,"你提交的提炼物品缺失了一件，退出炼丹。\n");
				me->delete_temp("liandan");
				return;
			}
		}
		zhuyao_size = me->query_temp("liandan/zhuyao_size");
		for(i=1;i<=zhuyao_size;i++)
		{
			if(!item = me->query_temp(sprintf("liandan/zhuyao_%d",i)))
			{
				tell_object(me,"你提交的提炼物品缺失了一件，退出炼丹。\n");
				me->delete_temp("liandan");
				return;
			}
		}
		for(i=1;i<=size;i++)
		{
			item = me->query_temp(sprintf("liandan/%d",i));
			destruct(item);
		}
		for(i=1;i<=level;i++)
		{
			item = me->query_temp(sprintf("liandan/cuihua_%d",i));
			destruct(item);
		}
		for(i=1;i<=zhuyao_size;i++)
		{
			item = me->query_temp(sprintf("liandan/zhuyao_%d",i));
			destruct(item);
		}
		//me->add("points",-5);
		if(!size) index = me->query("liandan/chenggong");
		else index = size*20; //成功率
		if(!level) level = 1+random(5);
		else level += 5;
		if(me->query("jym_level/vip")) is_ok(me,index,level,0);
		else is_ok(me,index,level,1);
		return;
	}
	else if(sscanf(arg,"add %s",arg))
	{
		if(!item = present(arg,me))
		{
			tell_object(me,"你身上没有这件物品。\n");
			input_to("do_HeCheng_2",me);
			return;
		}
		if((item->query("name") != HIB"催化剂"NOR || item->query("id") != "cuihuaji")
			&& (item->query("name") != HIB"添加剂"NOR || item->query("id") != "tianjiaji"))
		{
			tell_object(me,"这东西不能提炼。\n");
			input_to("do_HeCheng_2",me);
			return;
		}
		size = me->query_temp("liandan/size");
		if(size >= 6)
		{
			tell_object(me,"成功率%100％，不需要更多的物品了，请输入 ok。\n");
			input_to("do_HeCheng_2",me);
			return;
		}
		for(i=1;i<=size;i++)
		{
			if(item == me->query_temp(sprintf("liandan/%d",i)))
			{
				tell_object(me,"这件物品你已经提交过了。\n");
				input_to("do_HeCheng_2",me);
				return;
			}
		}
		level = me->query_temp("liandan/cuihuaji_size");
		for(i=1;i<=level;i++)
		{
			if(item == me->query_temp(sprintf("liandan/cuihua_%d",i)))
			{
				tell_object(me,"这件物品你已经提交过了。\n");
				input_to("do_HeCheng_2",me);
				return;
			}
		}
		if(item->query("name") == HIB"添加剂"NOR && item->query("id") == "tianjiaji")
		{
			me->add_temp("liandan/size",1);
			size = me->query_temp("liandan/size");
			me->set_temp(sprintf("liandan/%d",size),item);
		}
		else
		{
			me->add_temp("liandan/cuihuaji_size",1);
			cuihua_size = me->query_temp("liandan/cuihuaji_size");
			me->set_temp(sprintf("liandan/cuihua_%d",cuihua_size),item);
		}
		index = size*20;
		if(index > 100) index = 100;
		tell_object(me,sprintf("成功率%d％，要添加更多的提炼物品请输入add <物品ID>，否则输入 ok。\n",index));
		input_to("do_HeCheng_2",me);
		return;
	}
	tell_object(me,"如果要取消请请输入: q 。\n如果确认合成请输入: ok\n添加提炼物品请输入: add <ID>:\n");
	input_to("do_HeCheng_2",me);
}

void is_ok(object me,int index,int level,int type)
{
	object item;
	string name = me->query_temp("liandan/type");
	if(type && !me->query_busy()) me->start_busy(1200);

	switch(type)
	{
			case 1  : tell_object(me,HIY"你坐到炼丹炉前，开始静下心来准备炼丹器具。\n"NOR);                                                 call_out("is_ok",10,me,index,level,2); return;
			case 2  : tell_object(me,HIG"你开始一边听华佗的教导，一边将添加剂按比例配入催化剂内。\n"NOR);                                   call_out("is_ok",10,me,index,level,3); return;
			case 3  : tell_object(me,YEL"你将对好的药膏拌匀，这个步骤很容易，但也得很仔细。不均匀的药膏，可能会药物过量，无法食用。\n"NOR); call_out("is_ok",10,me,index,level,4); return;
			case 4  : tell_object(me,sprintf(HIG"药膏均匀了，你应该考虑提高[%s]该入哪位药了。\n"NOR,name));       call_out("is_ok",10,me,index,level,5); return;
			case 5  : tell_object(me,HIY"你向华佗求得西药两克，加入了药膏，拌匀。\n"NOR);                                                   call_out("is_ok",10,me,index,level,6); return;
			case 6  : tell_object(me,YEL"药膏太浓，搅拌不动了。你按步骤把剩余的添加剂兑入，使之成为药剂。\n"NOR);                           call_out("is_ok",10,me,index,level,7); return;
			case 7  : tell_object(me,HIY"药剂制作完成了，现在该考虑中药中的药引。\n"NOR);                                                   call_out("is_ok",10,me,index,level,8); return;
			case 8  : tell_object(me,HIG"你将一钱鹿茸、三钱精菊花、一钱茯苓，冲成粉末。\n"NOR);                                             call_out("is_ok",10,me,index,level,9); return;
			case 9  : tell_object(me,HIW"兑入少许白水，使之成为膏状，方便于揉捏成球状。\n"NOR);                                             call_out("is_ok",10,me,index,level,10); return;
			case 10 : tell_object(me,HIB"你把刚才做好的药剂兑入涅好的球状药膏，药剂做馅，药膏做皮。\n"NOR);                                 call_out("is_ok",10,me,index,level,11); return;
			case 11 : tell_object(me,YEL"你把做好的药丸放入炼丹炉中烘烤。\n"NOR);                                                           call_out("is_ok",10,me,index,level,12); return;
			case 12 : tell_object(me,HIR"按照步骤，该是时候取出了，成败就看这一下。你憋足勇气念道：别看。。。。。。\n"NOR); me->start_busy(1); break;
	}
	if(level < 2) index = 50; 
	if(random(100) < index && name && stringp(name))
	{
		if(item = new("/u/rock/return_obj/xydan"))
		{
			if(level > 10 || level < 0) level = 10;
			item->set("name",sprintf("%s幸运丹(%d级)",name,level));
			item->set("_name",name);
			item->set("level",level);
			item->move(me);
		}
		tell_object(me,HIY"炼制成功。\n"NOR);
		me->delete_temp("liandan");
		return;
	}
	else
	{
		tell_object(me,HIR"炼制失败。\n"NOR);
		me->delete_temp("liandan");
		return;
	}
}

string do_zhenju()
{
	object item,obj;
	object me = this_player();

	if(!item=present("jiuhu",me)) return "东方不败那酒壶里有上品好酒，我要用它来来泡制药草。\n麻烦你帮我找50个"+HIM"精致的酒壶"NOR+"(jiuhu)回来。\n";

	me->add("dh_zj",1);

	if(me->query("dh_zj") >= 50)
	{
		if(obj= new("/u/rock/item/zhen-ju"))
		{
			me->delete("dh_zj");
			obj->move(me);
		}
		return "非常好，这是冲关针具，请拿好！\n";
	}

	destruct(item);

	return "很好，很好！还差"+(50-(me->query("dh_zj")))+"个"+HIM"精致的酒壶"NOR+"(jiuhu)\n";
}