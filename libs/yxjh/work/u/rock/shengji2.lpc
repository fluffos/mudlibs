#include <ansi.h>
#include <login.h>

inherit NPC;
void create()
{

           set_name("洗点师", ({ "xidian shi", "shi"}) );
           set("age", 20);
           set("long",@STORY
这个是方舟写的升级师,你可以使用shengji指令来提升你的等级
具体请help shengji
STORY
              );
        set("title",HIG"洗点"NOR);

        set("gender","男性");
        set("combat_exp",10000);
        set("max_neili", 1500);
        set("force",9999999);

        set_skill("hunyuan-yiqi", 999);
        set_skill("force",999);
        map_skill("force", "hunyuan-yiqi");


        setup();
}

void init()
{
        add_action("do_shengji", "uplevel");
}

int do_shengji(object me)
{ 
	int exp,index,dj;
	me = this_player();
	exp = me->query_exp();

	if(me->query("rock_uplevel"))
	{
		tell_object(me,"对不起，你已洗过点或者系统已经帮你洗点。\n");
		return 1;
	}

	if (me->query("age") < 18 || me->query("jym_level/level") < 5) 
	{ 
		tell_object(me,"小号无需洗点。\n"); 
		return 1; 
	}

  	me->delete("jym_level/level");

	while(1)
	{
		dj = me->query("jym_level/level");
		index = (50+(dj+1))*(50+(dj+1))*(50+(dj+1))*(50+(dj+1))/100;
		if(index > 1700000000 || index < 1) index = 2000000000;

		if( exp >= index)
		{
			exp -= index;
			me->add("jym_level/level",1);
		}
		else break;
	}

	ADD_EXP(me,exp);
	me->set("rock_uplevel",1);
	me->save();
	tell_object(me,HIC"您升到了"+me->query("jym_level/level")+"级了!\n"NOR);

	return 1;
}
