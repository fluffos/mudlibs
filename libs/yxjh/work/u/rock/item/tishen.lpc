#include <ansi.h>;
inherit ITEM;

int is_tishen() { return 1; }

void create() {
  set_name(HIB "死亡替身" NOR, ({ "ti_shen" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "身上携带一个替身，角色可避免一次死亡。\n");
    set("value", 9999999);
    set_weight(2);
  }
  setup();
}
