//装备回收系统
//edit by rock
//2009.1.3

#include <ansi.h>
inherit ITEM;

#define yue_name "家"

int query_num() { return 1; }

void create()
{
    set_name(sprintf(HIY"月饼[%s]"NOR,yue_name), ({ sprintf("yuebing%d",query_num()) }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
            set("unit", "个");
            set("long",sprintf("一个月饼，上面有[%s]的字样。\n",yue_name));
            set("value", 10000);
    }
    setup();
}

void init()
{
	object me=this_player();
	object ob=this_object();
	object room=environment(ob);
	
	if(!userp(me)) return;
	if(!room || !userp(room)) return;
	
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object ob=this_object();
	object me=this_player();

	if(arg != ob->query("id")) return 0;

	ADD_EXP(me,10000000);
	me->add("potential",10000);

	message_vision("$N一大口吞下"+ob->query("name")+"获得了1千万经验，1万潜能。\n",me);
	destruct(ob);
	return 1;
}