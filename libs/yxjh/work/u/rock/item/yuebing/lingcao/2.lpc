//装备回收系统
//edit by rock
//2009.1.3

#include <ansi.h>
inherit ITEM;

#define yue_name "舌蛇"
#define SKILLS "dodge"

int query_numb() { return 2; }

void create() {
  set_name(sprintf(HIY "十年[%s]灵草" NOR, yue_name), ({ sprintf("lingcao%d", query_numb()) }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一颗珍惜的灵草，对凡人来说可以增加不少功力。\n");
    set("value", 10000);
    set("no_give", 1);
    set("no_get", 1);
    set("no_paimai", 1);
  }
  setup();
}

void init() {
  object me = this_player();
  object ob = this_object();
  object room = environment(ob);

  if (!userp(me)) return;
  if (!room || !userp(room)) return;

  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object ob = this_object();
  object me = this_player();
  int index;

  if (arg != ob->query("id")) return 0;

  index = me->query_skill(SKILLS, 1) + 1000;
  me->set_skill(SKILLS, index);

  message_vision("$N一大口吞下" + ob->query("name") + "获得了" + sprintf("(%s)1000级。", SKILLS) + "\n", me);
  destruct(ob);
  return 1;
}
