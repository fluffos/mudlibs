#include <ansi.h>;
inherit ITEM;

void create()
{
        set_name(HIW"精致冲穴针具"NOR, ({"jingzhi zhenju"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "盒");
                set("long","
这是一盒冲穴用的针具，其中包含九种银针。\n
精致蝉针、精致圆针、精致堤针、精致锋针、精致铍针、精致圆利针、\n
精致毫针、精致长针、精致大针。\n");
                set("value", 100);
                set_weight(2);
        }
        setup();
}