inherit ITEM;

int is_yao() { return 1; }

void create() {
  set_name("金钱吊芙蓉", ({ "yao" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("value", 10000);
    set("level", 10);
    set("long", "一颗稀有的药材，拿到华佗那里应该有大用处。\n");
  }
  setup();
}
