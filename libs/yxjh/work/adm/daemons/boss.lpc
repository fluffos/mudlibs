void dest_boss()
{
	object *boss;
	int size,i;
	
	boss = children("/u/rock/npc/boss");
	size = sizeof(boss);
	if(size) for(i=0;i<size;i++) destruct(boss[i]);
}

// 函数：构造处理
void create() 
{
	seteuid(ROOT_UID);
	set("channel_id", "BOOS精灵");
	dest_boss();
	check_time();
}

void clone_boss()
{
	string file,room;
	int i,size,index;
	object boss,me = this_object(),map,obj,base;

	base = me;

	size = sizeof(path);
	for(i=0;i<size;i++)
	{
		if(boss = base->query(sprintf("YWboss.%s",path[i][1])))
		{
			boss->move(path[i][8]);
			continue;
		}
		
		file = "/u/rock/npc/boss";

		if(sizeof(path[i]) != 9) continue;

		if(!boss = new(file)) return;

		room = path[i][8];
		load_object(room);

		if(!map = find_object(room)) return;

		if(!objectp(map))
		{
			destruct(boss);
			continue ;
		}
//初始化BOSS
//------------------------------------------------------------------
		boss->set_name(path[i][0], ({ path[i][1] }));
		boss->set("title",HIM+path[i][2]+NOR); 
		boss->set("gender", path[i][3]);
		boss->set("long", sprintf("传说中的%s。\n",boss->name()));
		boss->set("age", path[i][4]);
		index = path[i][6]*10;
		boss->set("per", index);
		boss->set("con", index);
		boss->set("int", index);
		boss->set("dex", index);
		boss->set("str", index);

		index = path[i][6];
		boss->set("jym_level/level",index);
		
		boss->set("max_qi",            index*30000);
		boss->set("max_jing",          index*600); 
		boss->set("max_jingli",        index*600);
		boss->set("max_neili",         index*100000);

		boss->set("jiali",             index*20);
		boss->set_skill("dodge",       index*159);
		boss->set_skill("unarmed",     index*159);
		boss->set_skill("parry",       index*159);
		boss->set_skill("sword",       index*159);
		boss->set_skill("blade",       index*159); 
		boss->set_skill("staff",       index*159);
		boss->set_skill("force",       index*159);
		boss->set_skill("taixuan-gong",index*159);
		boss->set_skill(path[i][5],    index*159);

		boss->set("jingli",            index*600);
		boss->set("neili",             index*100000);
		boss->set("qi",                index*30000);
		boss->set("eff_qi",            index*30000);
		boss->set("jing",              index*600); 
		boss->set("eff_jing",          index*600);

		boss->map_skill("force", "taixuan-gong"); 
		boss->map_skill("dodge", "taixuan-gong"); 

		boss->map_skill("unarmed",path[i][5]); 
		boss->map_skill("parry",  path[i][5]); 
		boss->map_skill("sword",  path[i][5]); 
		boss->map_skill("blade",  path[i][5]);
		boss->map_skill("staff",  path[i][5]);

		if( path[i][7] && obj = new(path[i][7]))
		{
			obj->move(boss);
			obj->wield();
		}

//------------------------------------------------------------------
		boss->move(map);
		base->set(sprintf("YWboss.%s",path[i][1]),boss);
		message("channel:rumor",YEL"【武林至尊】"HIY+"BOSS "+boss->name()+" 已经现身。\n"NOR,users());
//		CHANNEL_D->do_channel( this_object(), "sys", sprintf("%s 刷新至 %s 。\n",path[i][0],room));
	}
}

void check_time()
{
	if(!time || time <= time())
	{
		clone_boss();
		time = time()+1800;
		message("channel:rumor",YEL"【武林至尊】"HIY"为了满足大家杀BOSS的欲望，[浴血江湖]已推出各个等级段的小BOSS。让你蹂躏个够，发泄个够！\n"NOR,users());
	}
	call_out("check_time",60);
}