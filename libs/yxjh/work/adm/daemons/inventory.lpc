//根据存档格式生成物品
//edit by rock
//2008.10.11

#define ITEM_EQUIP_D "/adm/obj/equip"
#pragma save_binary

object restore_item(object me, string cProp, int iFlag) {

  object item;
  string *str, key_type, file;
  int i, size;

  str = explode(cProp, ",");
  if (str) {
    size = sizeof(str);
    for (i = 0; i < size; i++)
      sscanf(str[size - 1], "file:%s", file);
  }

  item = new(file);
  if (item) {
    ITEM_EQUIP_D->set_prop_baseon_string(item, cProp);
    return item;
  }
  return 0;
}

//恢复玩家的所有物品
void restore_inventory(object me) {
  object item;
  string *Inventory;
  int i, size;

  Inventory = me->query_inventory();
  if (arrayp(Inventory) && (size = sizeof(Inventory))) {
    for (i = 0; i < size; i++) {
      if (item = restore_item(me, Inventory[i], 1)) {
        item->move(me);
      }
    }
  }
}
