//活动控制中心
//edit by rock
//2010.09.11

#include <localtime.h>
#include <ansi.h>
inherit F_DBASE;
#pragma save_binary

//任务状态0 关闭 1 开启
mapping quest = ([
  "caxie": 0,  //开放时间：8:00–11:00
  "xunwu": 0,  //开放时间：11:00—13:00
  "xunren": 0,  //开放时间：13:00—15:00
  "gouwu": 0,  //开放时间：15:00—18:00
  "sharen": 0,  //开放时间：18:00—20:00
  "zhiliao": 0,  //开放时间：20:00 —23:00
]);

mapping quest_level = ([
  "caxie": 1,  //开放时间：8:00–11:00
  "xunwu": 100,  //开放时间：11:00—13:00
  "xunren": 200,  //开放时间：13:00—15:00
  "gouwu": 250,  //开放时间：15:00—18:00
  "sharen": 300,  //开放时间：18:00—20:00
  "zhiliao": 400,  //开放时间：20:00 —23:00
]);

string china_txt(string arg) {
  switch (arg) {
    case "xunren": return "寻人活动";
    case "xunwu": return "寻物活动";
    case "caxie": return "擦鞋活动";
    case "gouwu": return "购物活动";
    case "sharen": return "杀人活动";
    case "zhiliao": return "治疗活动";
    default: return "未知活动";
  }
}

string quest_desc(string arg) {
  switch (arg) {
    case "xunren": return "寻人(caxie)   200级以上   奖励：经验10000000 潜能80000  活动时间：13:00—15:00";
    case "xunwu": return "寻物(xunwu)   100级以上   奖励：经验8000000  潜能60000  活动时间：11:00—13:00";
    case "caxie": return "擦鞋(caxie)     1级以上   奖励：经验4000000  潜能20000  活动时间： 8:00–11:00";
    case "gouwu": return "购物(gouwu)   250级以上   奖励：经验20000000 潜能100000 活动时间：15:00—18:00";
    case "sharen": return "杀人(sharen)  300级以上   奖励：经验50000000 潜能200000 活动时间：18:00—20:00";
    case "zhiliao": return "治疗(zhiliao) 400级以上   奖励：经验80000000 潜能500000 活动时间：20:00—23:00";
    default: return "未知活动内容";
  }
}

//查询任务
mapping query_quest() { return copy(quest); }

//查询任务等级
mapping query_quest_level() { return copy(quest_level); }

//返回任务状态
int query_quest_info(string arg) { return quest[arg]; }

//时间检查模块
void check_time() {
  mixed *time = localtime(time());

  if (time[LT_HOUR] >= 8 && time[LT_HOUR] < 11) {
    if (!quest["caxie"]) {
      quest["caxie"] = 1;
      CHANNEL_D->do_channel(this_object(), "chat", "擦鞋活动已经开启!敏而好学，不耻下问，是以谓之也。欢迎大家来参加。");
    }
  } else {
    if (quest["caxie"]) {
      quest["caxie"] = 0;
      CHANNEL_D->do_channel(this_object(), "chat", "擦鞋活动已经关闭，欢迎明天同一时间参与。");
    }
  }

  if (time[LT_HOUR] >= 11 && time[LT_HOUR] < 13) {
    if (!quest["xunwu"]) {
      quest["xunwu"] = 1;
      CHANNEL_D->do_channel(this_object(), "chat", "寻物活动已经开启，欢迎大家来参加。");
    }
  } else {
    if (quest["xunwu"]) {
      quest["xunwu"] = 0;
      CHANNEL_D->do_channel(this_object(), "chat", "寻物活动已经关闭，欢迎明天同一时间参与。");
    }
  }

  if (time[LT_HOUR] >= 13 && time[LT_HOUR] < 15) {
    if (!quest["xunren"]) {
      quest["xunren"] = 1;
      CHANNEL_D->do_channel(this_object(), "chat", "寻人活动已经开启，欢迎大家来参加。");
    }
  } else {
    if (quest["xunren"]) {
      quest["xunren"] = 0;
      CHANNEL_D->do_channel(this_object(), "chat", "寻人活动已经关闭，欢迎明天同一时间参与。");
    }
  }

  if (time[LT_HOUR] >= 15 && time[LT_HOUR] < 18) {
    if (!quest["gouwu"]) {
      quest["gouwu"] = 1;
      CHANNEL_D->do_channel(this_object(), "chat", "购物活动已经开启，欢迎大家来参加。");
    }
  } else {
    if (quest["gouwu"]) {
      quest["gouwu"] = 0;
      CHANNEL_D->do_channel(this_object(), "chat", "购物活动已经关闭，欢迎明天同一时间参与。");
    }
  }

  if (time[LT_HOUR] >= 18 && time[LT_HOUR] < 20) {
    if (!quest["sharen"]) {
      quest["sharen"] = 1;
      CHANNEL_D->do_channel(this_object(), "chat", "杀人活动已经开启，欢迎大家来参加。");
    }
  } else {
    if (quest["sharen"]) {
      quest["sharen"] = 0;
      CHANNEL_D->do_channel(this_object(), "chat", "杀人活动已经关闭，欢迎明天同一时间参与。");
    }
  }

  if (time[LT_HOUR] >= 20 && time[LT_HOUR] < 23) {
    if (!quest["zhiliao"]) {
      quest["zhiliao"] = 1;
      CHANNEL_D->do_channel(this_object(), "chat", "治疗活动已经开启，欢迎大家来参加。");
    }
  } else {
    if (quest["zhiliao"]) {
      quest["zhiliao"] = 0;
      CHANNEL_D->do_channel(this_object(), "chat", "治疗活动已经关闭，欢迎明天同一时间参与。");
    }
  }

  if (time[LT_HOUR] >= 23 && time[LT_HOUR] < 8) call_out("check_time", 3000);
  else call_out("check_time", 1);
}

//结构函数
void create() {
  seteuid(ROOT_UID);
  set("channel_id", "浴血活动");
  //检查时间
  check_time();
}
