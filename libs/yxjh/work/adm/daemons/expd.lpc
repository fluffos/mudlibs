//edit by rock
#pragma optimize
#pragma save_binary

int add_exp(object me, int index) {
  int exp, add, suit_exp, tmp;

  if (!me) return 0;

  if (index > 1) {
    //双倍经验计算
    if (me->query("dacard/towExp") > time()) {
      if (me->query("vip_nian")) tmp = index * 2;
      else if (me->query("vip_yue")) tmp = index * 6 / 10;
      else tmp = index * 3 / 10;

      if (tmp > 2100000000 || tmp < 1) {
        tmp = 2100000000;
        index = 2100000000;
      } else {
        index += tmp;
        if (index > 2100000000 || index < 1) index = 2100000000;
      }
      tell_object(me, sprintf(HIG "双倍经验加成%d点，合计%d点经验。\n" NOR, tmp, index));
    }
    //套装经验计算
    if (suit_exp = me->query_temp("suit_effect/exp")) {
      tmp = index * (suit_exp / 10) / 10;
      index += tmp;
      if (index > 2100000000 || index < 1) index = 2100000000;
      tell_object(me, sprintf(HIG "套装经验加成%d％，合计 %d 点经验。\n" NOR, suit_exp, index));
    }
  }

  if (me->query_level() <= 149) return me->add("combat_exp", index);

  if (index > 100000000 || index < -100000000) {
    me->add("com_exp", index / 100000000);
    index = index % 100000000;
  }

  exp = me->query("combat_exp");
  if (exp >= 100000000) {
    me->add("com_exp", 1);
    return me->add("combat_exp", -100000000 + index);
  } else if (exp < 0) {
    me->add("com_exp", -1);
    return me->add("combat_exp", 100000000 + index);
  } else {
    return me->add("combat_exp", index);
  }
}

int query_exp(object me) {
  int index;
  int exp = me->query("com_exp");
  if (exp >= 20) exp = 20;
  else if (exp < 1) exp = 0;

  exp *= 100000000;
  index = exp + me->query("combat_exp");
  if (index < 0 || index > 2100000000) index = 2100000000;

  return index;
}

int test(int index) {
  return add_exp(find_player("rock"), index);
}
