//2010.8.15

#pragma optimize
#pragma save_binary

inherit F_SAVE;

private mapping items = ([]);  //收费道具数组
private string *obj_type = ({}); //收费道具类型

string query_save_file() { return DATA_DIR "selllist"; }

void remove() { save(); }

void mud_shutdown() { save(); }

//查询收费道具类别
string *query_obj_type() { return copy(obj_type); }

//询收费道具
mapping query_type_items() { return copy(items); }

void create()
{
	seteuid(ROOT_UID);
	restore();
}

//添加收费道具类型
int add_sell_type(object me,string arg)
{
	if(!arg || !stringp(arg))
	{
		tell_object(me,"要添加什么收费道具类别？\n");
		return 1;
	}
	obj_type += ({arg});
	tell_object(me,"收费道具类别添加完毕。\n");
	save();
	return 1;
}

//添加收费道具
int add_sell_object(object me,string arg)
{
	int money,i,size,type_ok=0;
	string *key,path,objName,type,msg="",Info;

	if(!arg || sscanf(arg,"%s %s %s %s %d",type,objName,Info,path,money) != 5)
	{
		tell_object(me,"要添加什么收费道具？\n");
		return 1;
	}
	//检查类型
	size=sizeof(obj_type);
	for(i=0;i<size;i++)
	{
		if(type == obj_type[i])
		{
			type_ok = 1;
			break;
		}
	}
	if(!type_ok)
	{
		for(i=0;i<size;i++) msg += obj_type[i]+",";
		tell_object(me,sprintf("没有%类型，可以选择类型:%s\n",type,msg));
	}
	//检查是否重复添加
	key = keys(items);
	size = sizeof(key);
	for(i=0;i<size;i++)
	{
		if(key[i] == path)
		{
			tell_object(me,"已经添加了这个道具，不能重复添加。\n");
			return 1;
		}
	}
	//判断价格
	if(money < 1)
	{
		tell_object(me,"价格太小了。\n");
		return 1;
	}
	//添加道具 催化剂 : ({"材料","炼制幸运丹的物品，提升幸运丹等级。","/u/rock/return_obj/cuihuaji",5})
	items += ([ objName : ({type,Info,path,money}) ]);
	save();
	tell_object(me,"收费道具添加完毕。\n");
	return 1;
}

//删除收费道具
int delete_sell_object(object me,string arg)
{
	int i,size;
	mapping temp=([]);
	if(!arg || !stringp(arg))
	{
		tell_object(me,"要删除什么收费道具？ \n");
		return 1;
	}
	if(!mapp(items))
	{
		tell_object(me,"没有这个收费道具。 \n");
		return 1;
	}
	map_delete(items,arg);
	save();
	tell_object(me,"收费道具删除完毕。\n");
	return 1;
}