#pragma save_binary
void create()
{
        seteuid(getuid());

}
void buildroom(object me,string s_title,string l_title, string dir,int rec)
{
mapping pairs = ([
        "north":                "south",
        "south":                "north",
        "east":                 "west",
        "west":                 "east",
        "northup":              "southdown",
        "southup":              "northdown",
        "eastup":               "westdown",
        "westup":               "eastdown",
        "northdown":            "southup",
        "southdown":            "northup",
        "eastdown":             "westup",
        "westdown":             "eastup",
        "northeast":            "southwest",
        "northwest":            "southeast",
        "southeast":            "northwest",
        "southwest":            "northeast",
        "up":                   "down",
        "down":                 "up"
]);

        object env;
        object lp;
        string this_file;
        string my_file,board;
        string name,board_name;
        string banghui;
        object myroom;
        string c_name,o_name;

        name = (string)me->query("id")+sprintf("%d",time());
        c_name = base_name(environment(me))+".lpc";
        this_file = read_file(c_name);
        this_file = replace_string(this_file,"set(\"exits\", ([",
"set(\"exits\", ([\n"+"\""+dir+"\""+" : \"/p/residence/"+name+"\",");   
	if(!s_title || !l_title || !dir || !rec) return;
        if(!write_file(c_name,this_file,1))
        return;

        environment(me)->set("exits/"+dir,"/p/residence/"+name);        
        // now the room we are in is done!
        switch(rec) {
        case 1:
        my_file = read_file("/data/room/user_room.o");
        break;
        case 2:
        my_file = read_file("/data/room/restroom.o");
        break;
        case 3:
        my_file = read_file("/data/room/weaponroom.o");
        break;
        case 4:
        my_file = read_file("/data/room/city.o");
        break;
        case 5:
        my_file = read_file("/data/room/lianroom.o");
        break;
        case 6:
        my_file = read_file("/data/room/menroom.o");
        break;
        case 7:
        my_file = read_file("/clone/room/jobroom.o");
        break;
        case 8:
        my_file = read_file("/data/room/shizhe.o");
        break;
        case 9:
        my_file = read_file("/data/room/yishiroom.o");       
        break;
        }
        if ( rec > 8 )
        {
            board = read_file("/data/room/board.o");
            board_name = me->query("tybang/banghui")+"的留言板";
            board = replace_string(board,"BOARD_NAME",board_name);
            board = replace_string(board,"ROOM","/p/residence/"+name);
            board_name = name+"_banghui";
            board = replace_string(board,"rock_b",board_name);
            write_file("/p/residence/board/"+name+".lpc",board,1);
            my_file = replace_string(my_file,"BOARD","/p/residence/board/"+name);
        }
        my_file = replace_string(my_file,"set(\"exits\", ([","set(\"exits\", ([\n"+"\""+pairs[dir]+"\""+" : "+"\""+c_name+"\",");
        my_file= replace_string(my_file,"SHORT_TITLE",s_title);
        my_file= replace_string(my_file,"LONG_TITLE",l_title);
        if(me->query("banghui"))
        my_file= replace_string(my_file,"bigwiz7001", me->query("banghui"));
       my_file= replace_string(my_file,"SAVE_NAME",name);
       write_file("/p/residence/"+name+".lpc",my_file,1);
       write("成功！！\n");
        lp=new("/clone/misc/lingpai");
        lp->create(me->query("banghui"));

        me->add("created_room",1);
        switch(rec) {
        case 1:
        me->add("created_room",1);
        break;
        case 2:
        me->add("rest_room",1);
        break;
        case 3:
        me->add("weapon_room",1);
        break;
        case 4:
        me->add("xiucheng_room",1);
        break;
        case 5:
        me->add("lian_room",1);
        break;
        case 6:
        me->add("created_men",1);
        break;
        case 7:
        me->add("job_room",1);
        break;
        case 9:
        {
            lp->add("board",1);
            lp->save();            
            break;
        }        
        }
//        if ( rec > 8 ) load_object("/p/residence/board/"+name);
                    
myroom=load_object("/p/residence/"+name);
myroom->set("owner",me->query("id"));
myroom->save();
me->save();
destruct(lp);
}

int touch_file(string name)
{
if(write_file(name," ",1))
return 1;
else return 0;
}
