int add_damage(object me, object victim, string martial) {
  mapping map_skill;
  string skill, *mname;
  int i, size, index;
  object room;

  if (!me || !objectp(me) || !victim || !objectp(victim) || !martial || !stringp(martial)) return 0;

  if (!room = environment(me)) return 0;

  if (mapp(map_skill = victim->query_skill_map())) {
    skill = me->query_skill_mapped(martial);
    mname = keys(map_skill);
    size = sizeof(mname);
    for (i = 0; i < size; i++) {
      if (skill_xk[skill] == map_skill[mname[i]]) {
        tell_room(
          room,
          sprintf(
            HIW "\n\n\n%s的%s，克制住了%s的%s招式！\n\n\n\n" NOR,
            me->query("name"),
            to_chinese(skill),
            victim->query("name"),
            to_chinese(map_skill[mname[i]])
          )
        );
        index = me->query_skill(skill) / 100;
        //tell_room(room,sprintf("%s\n",to_chinese(map_skill[mname[i]])));
        return index;
      }
    }
  }

  return 0;
}

int damage(object me, string martial) {
  string skill, file;
  int index, nian_vip, yue_vip;

  if (!me || !objectp(me) || !martial || !stringp(martial)) return 0;

  if (!file = me->query_skill_mapped(martial)) return 0;

  skill = sprintf("/kungfu/skill/%s", file);
  if (!skill) return 0;

  nian_vip = me->query("vip_nian");
  yue_vip = me->query("vip_yue");
  if (skill->type() == "zhongji") {
    //		tell_object(find_player("rock"),sprintf("Debug  %s\n",file));
    if (nian_vip) index = me->query_skill(file, 1) * 10;
    else if (yue_vip) index = me->query_skill(file, 1) * 5;
    else index = me->query_skill(file, 1);
  } else if (skill->type() == "fuji") {
    if (nian_vip) index = me->query_skill(file, 1) * 2;
    else if (yue_vip) index = me->query_skill(file, 1);
    else index = me->query_skill(file, 1) / 2;
  } else {
    if (nian_vip) index = me->query_skill(file, 1) / 10;
    else if (yue_vip) index = me->query_skill(file, 1) / 30;
    else index = me->query_skill(file, 1) / 50;
  }
  //tell_object(me,sprintf("Debug  %d\n",index));
  return index;
}
