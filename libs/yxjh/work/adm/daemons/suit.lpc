        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "腰带")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之戒" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之戒")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s4件:精气提高%d点" NOR, "", count >= 4 ? HIM : WHT, tmp1);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s5件:内力提高%d点" NOR, "", count >= 5 ? HIM : WHT, tmp2);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s6件:获得额外经验%d％" NOR, "", count >= 6 ? HIM : WHT, tmp3);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s7件:攻击力提升%d点" NOR, "", count >= 7 ? HIM : WHT, tmp4);
      ret += tmp;
      ret += check_len(tmp);
      break;
    case "剑行":
    case "鬼魄":
    case "夺魂":
    case "魔刀":
    case "乾坤":
    case "鬼神":
      tmp = sprintf("│%7s%s" + name + "(%d/7)" NOR, "", count >= 2 ? HIM : WHT, count);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之铠" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之铠")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之靴" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之靴")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "衬衣" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "衬衣")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之盔" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之盔")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之链" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之链")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "腰带" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "腰带")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之戒" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之戒")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s4件:获得额外经验%d％" NOR, "", count >= 4 ? HIM : WHT, tmp1);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s5件:精力提高%d点" NOR, "", count >= 5 ? HIM : WHT, tmp2);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s6件:防御提升%d点" NOR, "", count >= 6 ? HIM : WHT, tmp3);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s7件:攻击力提升%d点" NOR, "", count >= 7 ? HIM : WHT, tmp4);
      ret += tmp;
      ret += check_len(tmp);
      break;
    case "龙英":
    case "剑冢":
    case "震天":
    case "火雨":
    case "炎陵":
    case "火神":
      tmp = sprintf("│%7s%s" + name + "(%d/7)" NOR, "", count >= 2 ? HIM : WHT, count);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之铠" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之铠")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之靴" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之靴")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "衬衣" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "衬衣")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之盔" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之盔")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之链" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之链")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "腰带" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "腰带")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之戒" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之戒")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s4件:气血提高%d点" NOR, "", count >= 4 ? HIM : WHT, tmp1);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s5件:精力提高%d点" NOR, "", count >= 5 ? HIM : WHT, tmp2);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s6件:精气提高%d点" NOR, "", count >= 6 ? HIM : WHT, tmp3);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s7件:内力提高%d点" NOR, "", count >= 7 ? HIM : WHT, tmp4);
      ret += tmp;
      ret += check_len(tmp);
      break;
  }
  return ret;
}
