string check_len(string str) {
  int max_len = 33, len;

  len = (max_len + color_len(str)) - strlen(str);
  return sprintf("%" + len + "s", "│\n");
}

//获取套装描述
string get_suit_desc(object who, object oEquip) {
  string ret = "", name, tmp;
  int count, tmp1, tmp2, tmp3, tmp4;
  object owner;

  owner = oEquip->get_owner();
  if (owner && owner->is_user())
    who = owner;
  if (!who)
    return oEquip->get_suit_desc();
  name = oEquip->get_suit_name();
  count = who->query_temp(sprintf("suit_equip/%s/count", name));

  switch (name) {
    //-------------------------------------------------------------------------
    case "天泉": tmp1 = 1000; tmp2 = 2000; tmp3 = 1000; tmp4 = 10; break;
    case "天示": tmp1 = 2000; tmp2 = 3000; tmp3 = 2000; tmp4 = 20; break;
    case "劈风": tmp1 = 3000; tmp2 = 4000; tmp3 = 3000; tmp4 = 30; break;

    case "云天": tmp1 = 4000; tmp2 = 5000; tmp3 = 4000; tmp4 = 30; break;
    case "天罡": tmp1 = 4500; tmp2 = 5500; tmp3 = 4500; tmp4 = 30; break;
    case "战神": tmp1 = 5000; tmp2 = 6000; tmp3 = 5000; tmp4 = 40; break;
    //-------------------------------------------------------------------------
    case "邪舞": tmp1 = 2000; tmp2 = 1000; tmp3 = 10; tmp4 = 800; break;
    case "魔魂": tmp1 = 3000; tmp2 = 2000; tmp3 = 20; tmp4 = 1000; break;
    case "妖斩": tmp1 = 4000; tmp2 = 3000; tmp3 = 30; tmp4 = 2000; break;

    case "黑风": tmp1 = 5000; tmp2 = 6000; tmp3 = 30; tmp4 = 3000; break;
    case "梦魇": tmp1 = 5500; tmp2 = 6500; tmp3 = 30; tmp4 = 3500; break;
    case "邪神": tmp1 = 6000; tmp2 = 7000; tmp3 = 40; tmp4 = 4000; break;
    //-------------------------------------------------------------------------
    case "剑行": tmp1 = 10; tmp2 = 1000; tmp3 = 1000; tmp4 = 800; break;
    case "鬼魄": tmp1 = 20; tmp2 = 2000; tmp3 = 2000; tmp4 = 1000; break;
    case "夺魂": tmp1 = 30; tmp2 = 3000; tmp3 = 3000; tmp4 = 2000; break;

    case "魔刀": tmp1 = 30; tmp2 = 4000; tmp3 = 4000; tmp4 = 3000; break;
    case "乾坤": tmp1 = 30; tmp2 = 4500; tmp3 = 4500; tmp4 = 3500; break;
    case "鬼神": tmp1 = 40; tmp2 = 5000; tmp3 = 5000; tmp4 = 4000; break;
    //-------------------------------------------------------------------------
    case "龙英": tmp1 = 2000; tmp2 = 1000; tmp3 = 2000; tmp4 = 1000; break;
    case "剑冢": tmp1 = 2500; tmp2 = 1500; tmp3 = 2500; tmp4 = 1500; break;
    case "震天": tmp1 = 3000; tmp2 = 2000; tmp3 = 3000; tmp4 = 2000; break;

    case "火雨": tmp1 = 3500; tmp2 = 2500; tmp3 = 3500; tmp4 = 2500; break;
    case "炎陵": tmp1 = 4000; tmp2 = 3000; tmp3 = 4000; tmp4 = 3000; break;
    case "火神": tmp1 = 4500; tmp2 = 3500; tmp3 = 4500; tmp4 = 3500; break;
    //-------------------------------------------------------------------------
    default: tmp1 = 10; tmp2 = 10; tmp3 = 10; tmp4 = 10; break;
  }

  switch (name) {
    default:
      break;
    case "天泉":
    case "天示":
    case "劈风":
    case "云天":
    case "天罡":
    case "战神":
      tmp = sprintf("│%7s%s" + name + "(%d/7)" NOR, "", count >= 2 ? HIM : WHT, count);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之铠" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之铠")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之靴" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之靴")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "衬衣" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "衬衣")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之盔" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之盔")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之链" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之链")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "腰带" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "腰带")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之戒" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之戒")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s4件:防御提升%d点" NOR, "", count >= 4 ? HIM : WHT, tmp1);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s5件:气血提高%d点" NOR, "", count >= 5 ? HIM : WHT, tmp2);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s6件:内力提高%d点" NOR, "", count >= 6 ? HIM : WHT, tmp3);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf("│%7s%s7件:获得额外经验%d％" NOR, "", count >= 7 ? HIM : WHT, tmp4);
      ret += tmp;
      ret += check_len(tmp);
      break;
    case "邪舞":
    case "魔魂":
    case "妖斩":
    case "黑风":
    case "梦魇":
    case "邪神":
      tmp = sprintf("│%7s%s" + name + "(%d/7)" NOR, "", count >= 2 ? HIM : WHT, count);
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之铠" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之铠")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之靴" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之靴")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "衬衣" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "衬衣")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之盔" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之盔")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "之链" NOR,
        "",
        who->query_temp(sprintf("suit_equip/%s/equip/%s", name, name + "之链")) ? HIM : WHT
      );
      ret += tmp;
      ret += check_len(tmp);

      tmp = sprintf(
        "│%7s%s" + name + "腰带" NOR,
