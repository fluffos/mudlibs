//消除套装影响
void remove_suit_equip(object who) {
  int i, size, j, count;
  string *nTmp;
  mapping mpTmp;

  mpTmp = who->query_temp("suit_equip");
  if (!mapp(mpTmp))
    return;
  nTmp = keys(mpTmp);
  for (i = 0, size = sizeof(mpTmp); i < size; i++) {
    count = mpTmp[nTmp[i]]["count"];
    for (j = 2; j <= count; j++)
      remove_suit_effect(who, nTmp[i], j);
  }
}
//换装备时调用
void check_suit_equip(object who) {
  int i, size, j, count, max;
  object *nEquip, oEquip, *inv;
  mapping mpTmp;
  string *nTmp;

  remove_suit_equip(who);
  nEquip = USER_ENERGY_D->get_all_equip(who);
  nEquip -= ({ 0 });
  who->delete_temp("suit_equip");

  for (i = 0, size = sizeof(nEquip); i < size; i++) {
    oEquip = nEquip[i];
    if (oEquip->is_suit()) {
      who->add_temp(sprintf("suit_equip/%s/count", oEquip->get_suit_name()), 1);
      who->set_temp(
        sprintf("suit_equip/%s/equip/%s", oEquip->get_suit_name(), oEquip->query("name")),
        1
      );
    }
  }
  mpTmp = who->query_temp("suit_equip");
  //	if ( !mapp(mpTmp) )
  //		return ;
  if (mapp(mpTmp)) {
    nTmp = keys(mpTmp);
    for (i = 0, size = sizeof(mpTmp); i < size; i++) {
      count = mpTmp[nTmp[i]]["count"];
      for (j = 2; j <= count; j++)
        suit_effect(who, nTmp[i], j);
      if (count > max)
        max = count;
    }
  }
  //	if ( max >= 2 )
  //		set_effect_2(who, EFFECT_USER_SUIT, 1, 5 );

  //	for(i=1;i<=HAND_TYPE-HEAD_TYPE+1;i++)	//已经装备的物品
  //	{
  //		"cmd/base/desc"->main(who,sprintf("%d",i));
  //	}
  //inv = all_inventory(who,0,0);
  inv = all_inventory(who);
  for (i = 0, size = sizeof(inv); i < size; i++) {
    if (!objectp(inv[i]) || inv[i]->is_suit() != 1)
      continue;
    inv[i]->delete("long");
    inv[i]->init();
    //		send_user( who, "%c%d%c", 0x31, getoid(inv[i]), 0 );
  }
}

//套装的影响
void suit_effect(object who, string name, int amount) {
  int tmp1, tmp2, tmp3, tmp4;

  switch (name) {
    //-------------------------------------------------------------------------
    case "天泉": tmp1 = 1000; tmp2 = 2000; tmp3 = 1000; tmp4 = 10; break;
    case "天示": tmp1 = 2000; tmp2 = 3000; tmp3 = 2000; tmp4 = 20; break;
    case "劈风": tmp1 = 3000; tmp2 = 4000; tmp3 = 3000; tmp4 = 30; break;

    case "云天": tmp1 = 4000; tmp2 = 5000; tmp3 = 4000; tmp4 = 30; break;
    case "天罡": tmp1 = 4500; tmp2 = 5500; tmp3 = 4500; tmp4 = 30; break;
    case "战神": tmp1 = 5000; tmp2 = 6000; tmp3 = 5000; tmp4 = 40; break;
    //-------------------------------------------------------------------------
    case "邪舞": tmp1 = 2000; tmp2 = 1000; tmp3 = 10; tmp4 = 800; break;
    case "魔魂": tmp1 = 3000; tmp2 = 2000; tmp3 = 20; tmp4 = 1000; break;
    case "妖斩": tmp1 = 4000; tmp2 = 3000; tmp3 = 30; tmp4 = 2000; break;

    case "黑风": tmp1 = 5000; tmp2 = 6000; tmp3 = 30; tmp4 = 3000; break;
    case "梦魇": tmp1 = 5500; tmp2 = 6500; tmp3 = 30; tmp4 = 3500; break;
    case "邪神": tmp1 = 6000; tmp2 = 7000; tmp3 = 40; tmp4 = 4000; break;
    //-------------------------------------------------------------------------
    case "剑行": tmp1 = 10; tmp2 = 1000; tmp3 = 1000; tmp4 = 800; break;
    case "鬼魄": tmp1 = 20; tmp2 = 2000; tmp3 = 2000; tmp4 = 1000; break;
    case "夺魂": tmp1 = 30; tmp2 = 3000; tmp3 = 3000; tmp4 = 2000; break;

    case "魔刀": tmp1 = 30; tmp2 = 4000; tmp3 = 4000; tmp4 = 3000; break;
    case "乾坤": tmp1 = 30; tmp2 = 4500; tmp3 = 4500; tmp4 = 3500; break;
    case "鬼神": tmp1 = 40; tmp2 = 5000; tmp3 = 5000; tmp4 = 4000; break;
    //-------------------------------------------------------------------------
    case "龙英": tmp1 = 2000; tmp2 = 1000; tmp3 = 2000; tmp4 = 1000; break;
    case "剑冢": tmp1 = 2500; tmp2 = 1500; tmp3 = 2500; tmp4 = 1500; break;
    case "震天": tmp1 = 3000; tmp2 = 2000; tmp3 = 3000; tmp4 = 2000; break;

    case "火雨": tmp1 = 3500; tmp2 = 2500; tmp3 = 3500; tmp4 = 2500; break;
    case "炎陵": tmp1 = 4000; tmp2 = 3000; tmp3 = 4000; tmp4 = 3000; break;
    case "火神": tmp1 = 4500; tmp2 = 3500; tmp3 = 4500; tmp4 = 3500; break;
    //-------------------------------------------------------------------------
    default: tmp1 = 10; tmp2 = 10; tmp3 = 10; tmp4 = 10; break;
  }

  switch (name) {
    case "天泉":
    case "天示":
    case "劈风":
    case "云天":
    case "天罡":
    case "战神":
      switch (amount) {
        default:
          break;
        case 4:
          who->set_temp(sprintf("suit_effect/pp/%s", name), tmp1);
          USER_ENERGY_D->count_pp(who);
          break;
        case 5:
          who->set_temp(sprintf("suit_effect/hp/%s", name), tmp2);
          USER_ENERGY_D->count_hp(who);
          break;
        case 6:
          who->set_temp(sprintf("suit_effect/neili/%s", name), tmp3);
          USER_ENERGY_D->count_neili(who);
          break;
        case 7:
          who->set_temp("suit_effect/exp", tmp4);
          break;
      }
      break;
    case "邪舞":
    case "魔魂":
    case "妖斩":
    case "黑风":
    case "梦魇":
    case "邪神":
      switch (amount) {
        default:
          break;
        case 4:
          who->set_temp(sprintf("suit_effect/jing/%s", name), tmp1);
          USER_ENERGY_D->count_jing(who);
          break;
        case 5:
          who->set_temp(sprintf("suit_effect/neili/%s", name), tmp2);
          USER_ENERGY_D->count_neili(who);
          break;
        case 6:
          who->set_temp("suit_effect/exp", tmp3);
          break;
        case 7:
          who->set_temp(sprintf("suit_effect/ap/%s", name), tmp4);
          USER_ENERGY_D->count_ap(who);
          break;
      }
      break;
    case "剑行":
    case "鬼魄":
    case "夺魂":
    case "魔刀":
    case "乾坤":
    case "鬼神":
      switch (amount) {
        default:
          break;
        case 4:
          who->set_temp("suit_effect/exp", tmp1);
          break;
        case 5:
          who->set_temp(sprintf("suit_effect/jingli/%s", name), tmp2);
          USER_ENERGY_D->count_jingli(who);
          break;
        case 6:
          who->set_temp(sprintf("suit_effect/pp/%s", name), tmp3);
          USER_ENERGY_D->count_pp(who);
          break;
        case 7:
          who->set_temp(sprintf("suit_effect/ap/%s", name), tmp4);
          USER_ENERGY_D->count_ap(who);
          break;
      }
      break;
    case "龙英":
    case "剑冢":
    case "震天":
    case "火雨":
    case "炎陵":
    case "火神":
      switch (amount) {
        default:
          break;
        case 4:
          who->set_temp(sprintf("suit_effect/hp/%s", name), tmp1);
          USER_ENERGY_D->count_hp(who);
          break;
        case 5:
          who->set_temp(sprintf("suit_effect/jingli/%s", name), tmp2);
          USER_ENERGY_D->count_jingli(who);
          break;
        case 6:
          who->set_temp(sprintf("suit_effect/jing/%s", name), tmp3);
          USER_ENERGY_D->count_jing(who);
          break;
        case 7:
          who->set_temp(sprintf("suit_effect/neili/%s", name), tmp4);
          USER_ENERGY_D->count_neili(who);
          break;
      }
      break;
  }
}

//消除特定套装的影响
void remove_suit_effect(object who, string name, int amount) {
  switch (name) {
    case "天泉":
    case "天示":
    case "劈风":
    case "云天":
    case "天罡":
    case "战神":
      {
        switch (amount) {
          default:
            break;
          case 4:
            who->delete_temp(sprintf("suit_effect/pp/%s", name));
            USER_ENERGY_D->count_pp(who);
            break;
          case 5:
            who->delete_temp(sprintf("suit_effect/hp/%s", name));
            USER_ENERGY_D->count_hp(who);
            break;
          case 6:
            who->delete_temp(sprintf("suit_effect/neili/%s", name));
            USER_ENERGY_D->count_neili(who);
            break;
          case 7:
            who->delete_temp("suit_effect/exp");
            break;
        }
        break;
      }
    case "邪舞":
    case "魔魂":
    case "妖斩":
    case "黑风":
    case "梦魇":
    case "邪神":
      {
        switch (amount) {
          default:
            break;
          case 4:
            who->delete_temp(sprintf("suit_effect/jing/%s", name));
            USER_ENERGY_D->count_jing(who);
            break;
          case 5:
            who->delete_temp(sprintf("suit_effect/neili/%s", name));
            USER_ENERGY_D->count_neili(who);
            break;
          case 6:
            who->delete_temp("suit_effect/exp");
            break;
          case 7:
            who->delete_temp(sprintf("suit_effect/ap/%s", name));
            USER_ENERGY_D->count_ap(who);
            break;
        }
        break;
      }
    case "剑行":
    case "鬼魄":
    case "夺魂":
    case "魔刀":
    case "乾坤":
    case "鬼神":
      {
        switch (amount) {
          default:
            break;
          case 4:
            who->delete_temp("suit_effect/exp");
            break;
          case 5:
            who->delete_temp(sprintf("suit_effect/jingli/%s", name));
            USER_ENERGY_D->count_jingli(who);
            break;
          case 6:
            who->delete_temp(sprintf("suit_effect/pp/%s", name));
            USER_ENERGY_D->count_pp(who);
            break;
          case 7:
            who->delete_temp(sprintf("suit_effect/ap/%s", name));
            USER_ENERGY_D->count_ap(who);
            break;
        }
        break;
      }
    case "龙英":
    case "剑冢":
    case "震天":
    case "火雨":
    case "炎陵":
    case "火神":
      {
        switch (amount) {
          default:
            break;
          case 4:
            who->delete_temp(sprintf("suit_effect/hp/%s", name));
            USER_ENERGY_D->count_hp(who);
            break;
          case 5:
            who->delete_temp(sprintf("suit_effect/jingli/%s", name));
            USER_ENERGY_D->count_jingli(who);
            break;
          case 6:
            who->delete_temp(sprintf("suit_effect/jing/%s", name));
            USER_ENERGY_D->count_jing(who);
            break;
          case 7:
            who->delete_temp(sprintf("suit_effect/neili/%s", name));
            USER_ENERGY_D->count_neili(who);
            break;
        }
        break;
      }
  }
}

