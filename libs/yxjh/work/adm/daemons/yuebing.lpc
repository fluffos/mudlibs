#include <ansi.h>
#include <skill.h>
inherit F_DBASE;

int time;
int wwtime;
int saytime;
int jobTime;

void call_time();
void add_exp(object me, object env);
void add_skill(object me, object env);
void add_weiwang(object me, int index);
void dest_weapon();
void check_job();

//函数：初始
void create() {
  seteuid(ROOT_UID);
  set("channel_id", "嫦娥");
  CHANNEL_D->do_channel(this_object(), "sys", "嫦娥已经启动。\n");
  //检查时间
  time = time();
  call_time();
}

void call_time() {
  object item;
  string file;
  int index = random(8);
  int rand = random(100);

  if (time <= time()) {
    CHANNEL_D->do_channel(this_object(), "sys", "嫦娥系统开始自检。\n");
    //生成物品
    if (rand < 50 && index == 5) index = 3;
    else if (rand < 90 && index == 6) index = 0;
    if (index == 4) index = 0;
    file = sprintf("/u/rock/item/yuebing/%d", index + 1);
    if (item = new(file)) {
      __FILE__->give_gift(item, HIM "\n嫦娥轻轻的飘了过来，放了一个月饼在这里。\n\n" NOR);
    }

    //同步时间
    time = time() + 600;
    call_out("call_time", 280);
  }
  //循环
  else call_out("call_time", 10);
}

void give_gift(object ob, string msg) {
  int i;
  object env;
  object *players, player;
  string objName = ob->name();

  CHANNEL_D->do_channel(this_object(), "sys", sprintf("嫦娥事件系统开始发放%s。\n", objName));

  players = users();
  if (sizeof(players)) {
    for (i = 0; i < 5; i++) {
      player = players[random(sizeof(players))];
      if (wizardp(player)) continue;

      if (player->query_level() > 151 && sizeof(all_inventory(player)) < 69) {
        env = player;
      }

      //                        env = environment(player);
      //                        if(!env || !objectp(env) || env->is_mirror() || env->query("short") == "武庙") continue;
      //                        while (env && env->is_character())
      //                                env = environment(env);
      if (env) break;
    }
    if (i >= 5) {
      destruct(ob);
      return;
    }

    if (objectp(env)) {
      tell_room(env, msg);
      ob->move(env);
      CHANNEL_D->do_channel(this_object(), "chat", HIY "嫦娥仙子开始发放月饼喽！\n" NOR);

      CHANNEL_D->do_channel(
        this_object(),
        "chat",
        sprintf(
          NOR WHT "这次 %s " NOR WHT "发给了" HIC "%s(%s)" NOR WHT "。\n" NOR,
          objName,
          env->query("name"),
          env->query("id")
        )
      );
    } else destruct(ob);
  } else destruct(ob);
}
