// edit by rock

#include <ansi.h>

int update_condition(object me, int duration) {
  int index;
  //tell_object(find_player("rock"),sprintf("%s11111111\n",me->query("name")));
  if (duration < 2) {
    //10秒一次
    index = me->query("rock_add/int");
    me->add("int", -index);
    me->delete("rock_add/int");
    tell_object(me, HIM "悟性幸运丹的药性已过，你的悟性恢复到正常。\n" NOR);
  }
  me->apply_condition("rock_int", duration - 1);
  return 1;
}
