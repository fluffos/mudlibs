// junquest_fail
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
	if( duration == 2 )
	{
		tell_object(me, 
			HIB "忽然你觉得全身懒洋洋的，脑袋发蒙，原来你的临时悟性没有了！\n" NOR );
		me->add("int", 0 - me->query("xiandan/int"));
		me->delete("xiandan/int");
		return 0;
	}
	me->apply_condition("tempint", duration - 1);

	tell_object(me, HIG "你的临时悟性的时间还有"+(int)(duration/6)+"分钟！\n" NOR );
	if( duration < 1 ) 	return 0;
	return CND_CONTINUE;      
}

