// edit by rock

#include <ansi.h>

int update_condition(object me, int duration)
{
	int index;
    if (duration < 2)
    {
    	//10秒一次
    	index = me->query("rock_add/con");
		me->add("con",-index);
		me->delete("rock_add/con");
		tell_object(me,HIM"根骨幸运丹的药性已过，你的根骨恢复到正常。\n"NOR);
    }
	me->apply_condition("rock_con", duration - 1);
    return 1;
}