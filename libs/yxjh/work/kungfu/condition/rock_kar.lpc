// edit by rock

#include <ansi.h>

int update_condition(object me, int duration)
{
	int index;
    if (duration < 2)
    {
    	//10秒一次
    	index = me->query("rock_add/kar");
		me->add("kar",-index);
		me->delete("rock_add/kar");
		tell_object(me,HIM"福缘幸运丹的药性已过，你的福缘恢复到正常。\n"NOR);
    }
	me->apply_condition("rock_kar", duration - 1);
    return 1;
}