// edit by rock

#include <ansi.h>

int update_condition(object me, int duration)
{
	int index;
    if (duration < 2)
    {
    	//10秒一次
    	index = me->query("rock_add/dex");
		me->add("dex",-index);
		me->delete("rock_add/dex");
		tell_object(me,HIM"身法幸运丹的药性已过，你的身法恢复到正常。\n"NOR);
    }
	me->apply_condition("rock_dex", duration - 1);
    return 1;
}