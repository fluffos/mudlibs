// edit by rock

#include <ansi.h>

int update_condition(object me, int duration) {
  int index;
  if (duration < 2) {
    //10秒一次
    index = me->query("rock_add/per");
    me->add("per", -index);
    me->delete("rock_add/per");
    tell_object(me, HIM "容貌幸运丹的药性已过，你的容貌恢复到正常。\n" NOR);
  }
  me->apply_condition("rock_per", duration - 1);
  return 1;
}
