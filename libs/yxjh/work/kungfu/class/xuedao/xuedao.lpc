// /clone/weapon/xuedao.c
// by dubei
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
//inherit F_UNIQUE1;
void create()
{
        set_name(RED"血刀"NOR, ({ "xue dao","blade","dao" }));
        set_weight(12000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "一柄软软的缅刀，刀身不住颤动，宛如活蛇一般。引光望去，刀锋全是暗红之色。，
血光隐隐,极是可怖.\n");
                set("value", 600000);
                set("weapon_prop/dodge", 2);
                set("weapon_prop/parry", 2);
                set("id_id","xue dao");
                set("material", "steel"); 
                set("no_put", "1");
                set("no_steal",1);
                set("unique",1);
                set("replica_ob","/d/city/npc/obj/gangdao");
                set("rigidity",300); 
                set("wield_neili", 400);
                set("wield_maxneili", 1000);
                set("wield_str", 26);
                set("wield_msg", RED"只听「唰」的一声，血刀脱鞘飞出，$N手中似是握住一条赤蛇泛着红光，弥漫着一片血气。！\n"NOR);            
                set("unwield_msg", RED"只见$N随手一挥,血刀象一条赤蛇飞舞入鞘。\n"NOR);
        }
        init_blade(300,2);
        setup();
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
       object weapon;

       if(objectp(weapon=me->query_temp("weapon"))
           && weapon->query("id_id") == "xue dao"
           && me->query_skill_mapped("force") == "longxiang"
           && me->query_skill_mapped("blade") == "xue-dao" 
           && me->query_skill("xue-dao",1) >= 200
           && me->query_skill("longxiang",1) >= 200
           && me->query("shen") <= -100000
           && random(-me->query("shen")) > victim->query("shen")/2)

       message_vision(HIR"$N一声暴喝，手中血刀卷起一片片血光劈向$n，"
       +"登时便劈得$n遍体鳞伤！！\n"NOR, me,victim);

       return damage_bonus*(1+random(3)/2);
}

