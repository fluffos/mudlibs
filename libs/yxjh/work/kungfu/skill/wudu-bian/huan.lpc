#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
 
int perform(object me, object target)
{
    object weapon, ob;
    string msg;
    int i;
 
        me->clean_up_enemy();
    ob = me->select_opponent();
if (me->is_fighting())
{
if  (environment(me)!=environment(ob) ) 
     return notify_fail("对方已经不在了。\n");
}


    if( !me->is_fighting() )
        return notify_fail("「千幻神诀」只能在战斗时使用。\n");
//    if ( (string)me->query("family/family_name") != "五毒教") 
//        return notify_fail("只有五毒教徒才能使用该PFM。\n");
     if (me->query_temp("perform")>time()) return notify_fail("你上一招未使完！\n");
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "whip")
        return notify_fail("你使用的武器不对。\n");
    else me->set_temp("secondly_weapon",1);
    if( (int)me->query("neili") < 5000 )
        return notify_fail("你的真气不够！\n");
    if( (int)me->query_skill("whip") < 100 ||
        me->query_skill_mapped("whip") != "wudu-bian")
        return notify_fail("你的「五毒鞭法」还不够精纯，无法使用「千幻神诀」！\n");
msg = HIC "$N身法陡然变快，使出绝招「" HIG "千幻神诀" HIC "」，手中" + weapon->name() + HIC "如影如幻，虚实难测，急攻向"+ob->name()+"！！\n
                       "      +ob->name()+"只见$N飘忽不定，毫无破绽，竟被困在" + weapon->name() + HIC "之中。\n" NOR;
    message_vision(msg, me);
    me->clean_up_enemy();
    me->add("neili", -150);
    me->set_temp("perform",time()+3);
    me->set_temp("perform_qunxie",1);
    for(i = 0; i < 3; i++)
        if (me->is_fighting(ob) && ob->is_fighting(me) && ob->query("eff_qi")>0){
              me->set_temp("action_msg",HIY"千幻神诀\n"NOR);
                if (!weapon->query("equipped")) break;
              COMBAT_D->do_attack(me, ob,weapon, 0);
            }else break;
    me->delete_temp("perform_qunxie");
    me->delete_temp("secondly_weapon");
    return 1;
}

