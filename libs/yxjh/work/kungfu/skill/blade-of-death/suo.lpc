#include <ansi.h>

inherit F_SSERVER;
 
int perform(object me)
{
    string msg;
    object weapon, weapon2, target;
    int skill, ap, dp, damage;
    me->clean_up_enemy();
    target = me->select_opponent();
    skill = me->query_skill("blade-of-death",1); 
    if( !(me->is_fighting() ))
        return notify_fail("「死神锁」只能对战斗中的对手使用。\n");

msg = HIR "$N身上发出的刀气如同化作死神之手一般，沉重的死气紧紧包围住了$n。\n";
    message_vision(msg, me, target);
 
    damage = 10 + random(skill);
    ap = skill+me->query_skill("blade",1);
    dp = target->query_skill("unarmed",1);
    if( dp < 1 )
        dp = 1;
    if( random(ap) > dp )
    {
        if(userp(me))
            me->add("neili",-50);
        msg = "$n手中";
        msg += weapon2->name();
        msg += "经受不起死气的强大压力，顿时被震了飞开，人也彻底崩溃了。\n" NOR;
        target->receive_damage("qi", damage);
        target->start_busy(15);
        weapon2->move(environment(me));
        }
    else
    {
        if(userp(me))
            me->add("neili",-30);
        msg = "$n虽然被死气缠绕，但眼中精光不散，死死守住心神。\n"NOR;
   me->start_busy(3);
    }
      message_vision(msg, me, target);
    return 1;
}

