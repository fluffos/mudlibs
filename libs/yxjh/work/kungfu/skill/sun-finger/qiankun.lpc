// qiankun.c 一阳指 「一指乾坤」
// Last Modified by winder on Mar. 10 2000

#include <ansi.h>

inherit F_SSERVER;
#define PNAME "「一指乾坤」"
int perform(object me, object target)
{
	string msg;
	int skill;
	string fskill,sskill,bskill,pfname,pskill;

	if( !objectp(target) ) {target = offensive_target(me);}

	if( !target || !target->is_character() || target == me ||	
	  	!me->is_fighting(target) || !living(target) )
		return notify_fail(PNAME"只能对战斗中的对手使用。\n");

	if( me->query("gender") == "无性")
		return notify_fail(HIY "无根之人怎能使得出一阳指？\n" NOR);

	if ((int)me->query_skill("kuihua-xinfa", 1) > 100)
		return notify_fail(HIY "你感觉气息不顺，使不出一阳指！\n" NOR);
		
	if((int)me->query_str() < 28)
		return notify_fail("你膂力不够，不能使用这一绝技！\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("你只能空手使用「一指乾坤」。\n");

	if ( (string)me->query_skill_mapped("force") != "kumu-shengong" ||
		(int)me->query_skill("kumu-shengong", 1) < 500 ||
		me->query("family/family_name") != "大理段家" )
		return notify_fail("你的枯木神功修为不够，无法使用"+PNAME+"。\n");

	skill = (int)me->query_skill("sun-finger", 1);
	if( skill < 500 )
		return notify_fail("你的一阳指修为不够，不能出手"+PNAME+"。\n");

	if((int)me->query("max_neili") < 2000 || (int)me->query("neili") < 1000)
		return notify_fail("你内力修为不够，不能使用"+PNAME+"！\n");

	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

	msg = HIY "$N"HIY"使出一阳指绝技「一指乾坤」，罩住了$n"HIY"的全身要穴, 使$n"HIY"动弹不得。\n";

	target->delete_temp("apply/shade_vision");

        if(random(me->query_exp()) > (int)target->query("combat_exp")/5)
	{
		msg += HIG"结果$p被$P攻了个措手不及! 一时不能动弹! \n"NOR;
		target->start_busy( random(20) );
	}
	else
	{
		msg += HIM "可是$p看破了$P的企图，并没有上当。\n" NOR;
		me->start_busy(4);
	}
	me->add("neili", -1000);

	message_combatd(msg, me, target);

	return 1;
}
string name() {return replace_string(replace_string(PNAME,"「",""),"」","");}

int help(object me)
{
	write(WHT"\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+WHT"："NOR"\n");
	write(@HELP

	使用功效：
		迟滞对方出手

	出手要求：
		枯荣禅功500级
		一阳指500级
		内力2000
		后天膂力28
HELP
	);
	return 1;
}

