// yiming-force.c 一鸣内功
// Jay 4/5/96
// modified by Venus Oct.1997
inherit FORCE;

mapping *action = ({
([  "action":"$N双手一震，一股劲气澎湃汹涌而出，$n只觉眼前一黑口吐鲜血。",
    "force" : 200,
    "dodge" : 20,
    "damage_type":  "瘀伤"
]),
([  "action":"$N右手全力击出，在$n臂膀上迅速无比的一按，$n口吐鲜血一跤跌了出去",    
    "force" : 220,
    "dodge" : 20,
    "damage_type":  "瘀伤"
]),
([  "action":"$N身形变化，手随人转一拳击出一股内气打向$n",
    "force" : 400,
    "dodge" : 30,
    "damage_type":  "瘀伤"
]),
([  "action":"$N挺身而上，双掌掌风如水银泻地猛地拍向$n",
    "force" : 225,
    "dodge" : 30,
    "damage_type":  "瘀伤"
]),
([  "action":"$N突然飞起一脚，踢向$n的小腹，猛地一抬集全身力气于脚尖踢向$n面门",
    "force" : 230,
    "dodge" : 40,
    "damage_type":  "瘀伤"
]),
([  "action":"$N突然间左手一捺，封住$n退路，右手掌风混着一鸣功内劲而出",
    "force" : 230,
    "dodge" : 40,
    "damage_type":  "瘀伤"
]),

});

int valid_enable(string usage)
{
       return usage == "unarmed" || usage == "force";
}

mapping query_action(object me, object weapon)
{
    mapping a_action;
    int i, level;
     level   = (int) me->query_skill("yiming-force", 1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]){
                         a_action = action[NewRandom(i, 20, level/2)];
                        break;
                }
    a_action["dodge"]  = 0-level/33;
    a_action["parry"]  = 0-level*42;
    a_action["attack"]  = level/13;
    a_action["damage"] = level*14;
    return a_action;

}

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 5000) 
        return notify_fail("你的内力不够。\n");
      if (me->query_skill("force",1) <= me->query_skill("yiming-force",1))
      return notify_fail("你的基础不够，无法领会更高深的技巧！\n");
        if (me->query_skill("yiming-force",1)> 1000)
        return notify_fail("一鸣内功是泰山门徒段一鸣的绝技，他也是自悟的怎么继续教你？\n");
    return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 105 ) return 0;
         if (me->query_skill("yiming-force",1)>100)
        if( random(me->query("neili")) > random(victim->query("neili"))) {
               victim->receive_wound("qi", (damage_bonus - 100)*2 , me);
                return HIR "一鸣内功内劲急急传入$n的全身大穴感到心头一甜，吐出一口"HIR"鲜血"HIW"！\n" NOR;
        }
}
string exert_function_file(string func)
{
    return __DIR__"yiming-force/" + func;
}



