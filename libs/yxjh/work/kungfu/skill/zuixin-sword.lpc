//zuixin-sword  by:pipip
inherit SKILL;
string type() { return "zhongji"; }
int tydamage = (this_player()->query("tydamage/sword")?this_player()->query("tydamage/sword"):this_player()->query_skill("zuixin-sword"))*5;

mapping *action = ({
([  "action":"$N发出一招「七巧玲珑」，手中$w一连划出七道剑光刺向$n的$l",
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
    "lvl" : 0,
    "damage_type":  "割伤"
]),
([  "action":"$N手中$w一抖，一招「醉灌天」，斜斜一剑从下往上撩向$n的$l",
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
    "lvl" : 18,
    "damage_type":  "割伤"
]),

([  "action":"$N身形左右摇摆，手一抖间剑芒大盛，一招「"+HIB+"柳叶剑"+NOR+"」攻向$n的$l",
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
        "lvl" : 120,
    "damage_type":  "刺伤"
]),
([  "action":"$N看出$n招式中的破绽，心下一静，「"+HIC+"凌风双飘剑"+NOR+"」已攻入$n破绽之中",
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
        "lvl" : 140,
    "damage_type":  "刺伤"
]),

([  "action":HIB"$N使出一式「"+WHT+"大雁回翔"+HIB+"」，手到剑到，$n被攻的手忙脚乱"NOR,
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
      "lvl" : 1050,
    "damage_type": "挫伤"
]),
([  "action":HIW"$N微微一笑，「"+HIB+"天河倒泻"+HIW+"」剑招狂射而出，手中$w"HIW"直逼向$n眼前"NOR, 
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
     "lvl" : 1100,
    "damage_type": "挫伤"
]),
([  "action":HIC"$N剑法凌乱，化自狂风剑法的剑招「"+HIR+"青翎舞"+HIC+"」，已将$n困在道道剑光之中"NOR, 
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
     "lvl" : 1200,
    "damage_type": "挫伤"
])
});
int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int practice_level(){   return 60;  }
mapping query_action(object me, object weapon)
{
        int i, level;
    level   = (int) me->query_skill("zuixin-sword",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 100 ) return 0;

      if( me->query("neili") < 50000   ) return 0;
      if( random(10) < 2   ) return 0;
 //  第六等级的伤气
      if( me->query_skill("zuixin-sword",1)>4000
    && me->query_skill("beiming-shengong",1)>1499
  && me->query("jym_level/level")>=25  ) {
              victim->receive_damage("qi", (damage_bonus ) * 2 , me);
return HIW  "$N将体内一股强大的"HIG"北冥真气"NOR+WHT"凝于剑尖之上，$n一分神已重伤吐血！！！\n" NOR;

  }      

 //  第五等级的伤气
      if( me->query_skill("zuixin-sword",1)>3000
    && me->query_skill("beiming-shengong",1)>1499
  && me->query("jym_level/level")>=15 ) {
              victim->receive_damage("qi", damage_bonus  , me);
return WHT  "$N将体内一股强大的北冥真气凝于剑尖之上，$n一分神已重伤吐血！！！\n" NOR;
  }      
      if( damage_bonus < 110 ) return 0;

 //  第四等级的伤气
      if( me->query_skill("zuixin-sword",1)>2000
    && me->query_skill("beiming-shengong",1)>1499
  && me->query("jym_level/level")>=10 ) {
           victim->receive_damage("qi", (damage_bonus - 100)  , me);
return MAG "$N的逍遥醉心剑已入化境，随意几剑，剑气如巨浪般直袭$n！！！！！\n" NOR;
  }    


 //  第三等级的伤气
        if( me->query_skill("zuixin-sword",1)>1000
    && me->query_skill("beiming-shengong",1)>499
       && me->query("jym_level/level")>=4 ){
                victim->receive_wound("qi", (damage_bonus - 100) / 3 , me);
return CYN "$N的逍遥醉心剑已入化境，随意几剑，剑气如巨浪般直袭$n！！！！！\n" NOR;
  }      
 // 第二等级的伤气
        if ( me->query_skill("zuixin-sword",1)>400
 && me->query("jym_level/level")>=2
         && me->query_skill("beiming-shengong",1)>300 ){
             victim->receive_wound("qi", (damage_bonus - 100) / 8 , me);
  return RED "$N的北冥真气凝于剑上，$n一分神就被剑上的真力所伤！！！\n" NOR;
}
}


int practice_skill(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练逍遥醉心剑法。\n");
    me->receive_damage("qi", 25);
    return 1;
}
int valid_learn(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你还是先找把剑来吧。\n");
        if (me->query_skill("zuixin-sword")< 250 && me->query("family/master_id")!="xiaoyao zi")
        return notify_fail("逍遥醉心剑是逍遥子绝技，其他师傅参悟还来不及，怎能教你？\n");
    if ((int)me->query("max_neili") < 20000)
        return notify_fail("你的内力不够。\n");
    if (me->query_skill("sword", 1)<=me->query_skill("zuixin-sword",1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
       if ((int)me->query_skill("beiming-shengong", 1) < 40)
        return notify_fail("你的八荒神功火候太浅。\n");

     return 1;
}


string perform_action_file(string action)
{
    return __DIR__"zuixin-sword/" + action;
}

