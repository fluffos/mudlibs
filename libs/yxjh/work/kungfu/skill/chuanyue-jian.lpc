// chuanyue-jianfa.c 
// quest 2010 07 11 
#include <ansi.h> 
inherit SKILL; 
int tydamage = (this_player()->query("tydamage/sword")?this_player()->query("tydamage/sword"):this_player()->query_skill("poyang-jian"))*5; 
mapping *action = ({ 
([  "action" : "$N身法急速运转，一招「"+HIM+"星光真月"+NOR+"」，手中$w径直点向$n的$l", 
    "force" : 400, 
    "lvl" : 0, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "身法极快的$N向前一步，左手平展右手$w侧转一式「"+YEL+"月华泄地"+NOR+"」直刺$n的$l", 
    "force" : 370, 
    "lvl" : 10, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "急速移动中的$N身形往左一闪，右手$w使出「"+WHT+"皓月当空"+NOR+"」直直刺向$n的$l", 
    "force" : 380, 
    "lvl" : 15, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "$N毫不停歇一招「"+HIW+"血月耀空"+NOR+"」，$w自上而下直直一道剑光扫向$n的$l", 
    "force" : 330, 
    "lvl" : 37, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "$N越来越快上身往左侧一拧，身形诡异，一招「"+BLK+"无影无形"+NOR+"」，左手平展，右手$w反手向$n的$l挥去", 
    "force" : 410, 
    "lvl" : 48, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "刹那间$N平起，集中全身力量手中$w直指，一招「"+HIC+"明月当空"+NOR+"」剑光急急刺向$n的$l", 
    "force" : 430, 
    "lvl" : 60, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "急速运动的$N突然转身，一招「"+CYN+"山岳遮月"+NOR+"」，$w自左而右划出一个大弧，平平地扫向$n的$l", 
    "force" : 140, 
    "lvl" : 70, 
    "damage_type" : "刺伤" 
]), 
}); 
 
int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); } 
int practice_level(){   return 145;  } 
int valid_learn(object me) 
{ 
    object weapon; 
    if (!objectp(weapon = me->query_temp("weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
    if (!objectp(weapon = me->query_temp("secondary_weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
        return notify_fail("你必须先找把剑才能学穿月剑法。\n"); 
 
    if ((int)me->query("max_neili") < 100) 
        return notify_fail("你的内力不够。\n"); 
    if (me->query_skill("sword", 1) <=me->query_skill("chuanyue-jian", 1)) 
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n"); 
    return 1; 
} 
mapping query_action(object me, object weapon) 
{ 
    mapping a_action; 
    int i, level; 
    level   = (int) me->query_skill("chuanyue-jian", 1); 
        for(i = sizeof(action); i > 0; i--) 
                if(level > action[i-1]["lvl"]){ 
                        a_action = action[NewRandom(i, 20, level/5)]; 
                        break; 
                } 
    a_action["dodge"]  = 0-level*15; 
    a_action["parry"]  = 0-level*3; 
    a_action["attack"]  = level*3; 
    a_action["damage"] = tydamage+level*20; 
    return a_action; 
 
} 
int practice_skill(object me) 
{ 
    object weapon; 
    if (!objectp(weapon = me->query_temp("weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
    if (!objectp(weapon = me->query_temp("secondary_weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
        return notify_fail("你使用的武器不对。\n"); 
    if ((int)me->query("qi") < 50) 
        return notify_fail("你的体力不够练穿月剑法。\n"); 
    me->receive_damage("qi", 30); 
    return 1; 
} 
string perform_action_file(string action) 
{ 
    return __DIR__"chuanyue-jian/" + action; 
} 
