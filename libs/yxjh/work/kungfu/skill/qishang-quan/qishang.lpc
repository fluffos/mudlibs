// qishang 七伤
// modify by amis 2004-1-18

#include <ansi.h>

inherit F_SSERVER;
#include "/kungfu/skill/eff_msg.h";
int perform(object me, object target)
{
      
        int a,i,lel;
        mapping pmap;
		lel=(int)me->query_skill("qishang-quan",1);
    
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("此招只能对战斗中的对手使用。\n");
        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能使用此招！\n");
                       
        if( (int)me->query_skill("qishang-quan", 1) < 500 )
                return notify_fail("你的七伤拳还不够娴熟，还没有办法拳出七伤。\n");

        pmap = me->query_skill_prepare();


        if( (int)me->query("max_neili", 1) < 15000 )
                return notify_fail("以你的目前的内力没有办法发出这一招。\n");

        if( (int)me->query("neili",1) < 1000)
                return notify_fail("你的内力不够。\n");

		if( (string)me->query("gender")=="无性" )
				return notify_fail("你阴阳不调，元气不足，如何使得出七伤拳绝技。\n");

        i=(int)lel/30;
        if(me->query_skill("qishang-quan",1)>500)
        i=7;
        message_vision(HIR "\n$N凝神运功，大喊一声"HIR+"「七伤拳」"HIR+"，"+chinese_number(i)+"股无比强劲的热气呼啸的扑向$n身上各大要穴。\n"NOR,me,target);
        if (!(me->query("neili")<0)) me->add("neili",-i*30);
          if ((random(me->query_skill("force")) > target->query_skill("force")/2)||(random(me->query_exp()) > target->query("combat_exp")/2))
        {
		me->set_temp("qishang",1);
		me->add_temp("apply/strength", lel/4);
		for(a=0;a<i ;a++ ) {
                        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		me->delete_temp("qishang");
		//me->add_temp("apply/strength", -lel/4);
		me->delete_temp("apply/strength");
        	me->start_busy(random(5)+1);
        }
        } else 
        {
                        message_vision(YEL"可是$n忙运内力与$N的"+chinese_number(i)+"种劲气相扩，把之在体内化之无形。\n"NOR,me,target); 
		        me->start_busy(1);
        }
//      message_vision(msg, me, target);
        return 1;
}
