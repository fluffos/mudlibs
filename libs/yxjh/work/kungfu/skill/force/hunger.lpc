// hunger.c
// by:西门无剑(Pipip)
//inherit SSERVER;
int exert(object me, object target)
{
    int n, q;
    if (me != target)
        return notify_fail("辟毂绝技只能对自己使用。\n");
    if ((int)me->query("neili") < 2000)
        return notify_fail("你的内力不够。\n"); 
        if( (int)me->query("eff_qi") < (int)me->query_max_hp() / 2 )
                return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");  
    if( (int)me->query_skill("force",1) < 3000 )
        return notify_fail("你的内功不够深厚，还没达到辟毂的境界！n");
    me->add("neili", -2000); 
    me->set("food", (int)me->max_food_capacity() );
    me->set("water", (int)me->max_water_capacity() );    
         message_vision(WHT"$N脸上隐隐陕过一道红光，顿时感觉食与不食也无所谓了。\n"NOR, me);
        if( me->is_fighting() ) me->start_busy(2);
   me->improve_skill("force", random(me->query_skill("force", 1)));
    return 1;
}

