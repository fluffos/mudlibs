#include <ansi.h> 
inherit SKILL; 

string type() { return "zhongji"; } 
int tydamage = (this_player()->query("tydamage/sword")?this_player()->query("tydamage/sword"):this_player()->query_skill("songshan-jiafa"))*5;  

mapping *action = ({ 
([      "name":    "开门见山", 
        "action":  "$N左手向外一分，右手$w向右掠出，使的是嵩山派剑法"+HIC+"【开门见山】"+NOR+"",
        "lvl" : 120, 
        "damage_type":  "刺伤" 
]), 
([      "name":    "独劈华山", 
        "action":  "$N手中$w自上而下的向$n直劈下去，一招"+HIC+"【独劈华山】"+NOR+"，真有石 
破天惊的气势，将嵩山剑法之所长发挥得淋漓尽致", 
        "lvl" : 125,
        "damage_type":  "刺伤" 
]), 
([      "name":    "天外玉龙", 
        "action":  "$N手中$w刷的一剑自左而右急削过去，正是一招嵩山派正 
宗剑法"+HIC+"【天外玉龙】"+NOR+"。但见$w自半空中横过，剑身似曲似直，长 
剑便如一件活物一般",
                                "lvl" : 130, 
        "damage_type":  "刺伤" 
]), 
([      "name":    "万岳朝宗", 
        "action":  "$N右手$w一立，举剑过顶，弯腰躬身，使一招"+HIC+"【万岳朝宗】"+NOR+"正是 
嫡系正宗的嵩山剑法",
                                "lvl" : 135, 
        "damage_type":  "刺伤" 
]), 
([      "name":    "千古人龙", 
        "action":  "$N手中$w突然间剑光一吐，化作一道白虹，端严雄伟，端丽飘逸， 
正是嵩山剑法的精要所在，一招"+HIC+"【千古人龙】"+NOR+"向$n$l直刺过来", 
        "lvl" : 140,
        "damage_type":  "刺伤" 
]), 
([      "name":    "叠翠浮青", 
        "action":  "$N手中$w突然间剑光一吐，一招"+HIC+"【叠翠浮青】"+NOR+"化成一道青光，气 
壮雄浑，向$n$l直刺过来", 
        "lvl" : 145,
        "damage_type":  "刺伤" 
]), 
([      "name":    "玉进天池", 
        "action":  "$N手中$w剑光一吐，一招"+HIG+"【玉进天池】"+NOR+"威仪整肃，端严雄伟，向 
$n$l直刺过来", 
        "lvl" : 150,
        "damage_type":  "刺伤" 
]), 
}); 
 
int valid_learn(object me) 
{ 
    object ob; 
    if( (int)me->query("max_neili") < 50 ) 
        return notify_fail("你的内力不够，没有办法练嵩山剑法。\n"); 
    if( !(ob = me->query_temp("weapon")) 
    ||      (string)ob->query("skill_type") != "sword" ) 
        return notify_fail("你必须先找一把剑才能练剑法。\n"); 
 
    return 1; 
} 
 
int valid_enable(string usage) 
{ 
    return usage=="sword" || usage=="parry"; 
} 
 
mapping query_action(object me, object weapon) 
{ 
    mapping a_action; 
    int i, level; 
    //这里严重错误，没有这些值。请在本机测试后再上传服务器
    //level   = (int) me->query_skill("guxing-sword", 1); 
    level = me->query_skill("songshan-sword");  //update by rock
        for(i = sizeof(action); i > 0; i--) 
                if(level > action[i-1]["lvl"]){ 
                        a_action = action[NewRandom(i, 20, level/5)]; 
                        break; 
                }

	a_action["force"] = 0-level*5;
	a_action["dodge"] = 0-level*3; 
	a_action["parry"] = 0-level*3; 
	a_action["attack"] = level*3; 
	a_action["damage"] = (tydamage+level)*15; 
	return a_action; 
 
}
 
int practice_skill(object me) 
{ 
    if( (int)me->query("qi") < 30 
    ||      (int)me->query("neili") < 5 ) 
        return notify_fail("你的内力或气不够，没有办法练习嵩山剑法。\n"); 
    me->receive_damage("qi", 30); 
    me->add("neili", -5); 
    write("你按著所学练了一遍嵩山剑法。\n"); 
    return 1; 
} 
 
int valid_effect(object me, object weapon, string name, int skill) 
{ 
} 
 
string perform_action_file(string action) 
{ 
        return __DIR__"songshan-sword/" + action; 
} 

