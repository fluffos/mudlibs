//17jian
#include <ansi.h>  
#include <skill.h>  
#include <weapon.h>  
#include <combat.h>  
inherit NPC;  
      //      inherit F_SSERVER;  
      int perform(object me, object target)  
      {  
          int i;  
          object weapon, ob, where, where2;  
          string msg;  
              me = this_player();  
              me->clean_up_enemy();  
          ob = me->select_opponent();  
      if (me->is_fighting())  
      {  
      if  (environment(me)!=environment(ob) )   
           return notify_fail("对方已经不在了。\n");  
      }  
      //if ( (string)me->query("family/family_name") != "嵩山派")   
      //   return notify_fail("不是嵩山弟子也想用这武功？\n");  
 
        if( !me->is_fighting() ) 
            return notify_fail("「嵩山十七剑」只能在战斗中使用。\n"); 
        if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") 
            return notify_fail("你使用的武器不对。\n"); 
        if((int)me->query_skill("sword",1) < 200) 
            return notify_fail("你的基本剑法的火候还不到家, 不能使用这一绝技 !\n"); 
        if((int)me->query_skill("songshan-jianfa",1) < 500) 
            return notify_fail("你的嵩山剑法的火候还不到家, 不能使用这一绝技 !\n"); 
        if( (int)me->query("neili") < 5000 ) 
            return notify_fail("你的真气不够！\n"); 
        if( (int)me->query("max_neili") < 5000 ) 
            return notify_fail("你的内力修为不够！\n"); 
                        msg = YEL "\n$N眼神中泛起蔚蓝之色，急急使出【嵩山十七剑】剑招连绵不断！\n" NOR; 

            message_vision(msg, me);  
        for(i=0;i<17;i++) COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);  
            me->add("neili",-1550);  
        me->start_busy(1);  
          return 1;  
      }
