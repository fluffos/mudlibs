// wuxing-jianfa.c
//by jerry update 2008.12.06

inherit SKILL;
string type() { return "zhongji"; }
int tydamage = (this_player()->query("tydamage/sword") ? this_player()->query("tydamage/sword") : this_player()->query_skill("wuxing-jianfa")) * 5;
mapping *action = ({
  ([ "action": "$N左小指轻弹，一招「宫韵」悄然划向$n的后心",
    "force": 760,
    "dodge": 680,
    "parry": 640,
    "damage": tydamage,
    "lvl": 0,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N右手无名指若有若无的一划，将琴弦并做一处，[" HIM "商韵" NOR "]已将$n笼罩",
    "force": 760,
    "dodge": 680,
    "parry": 640,
    "damage": tydamage,
    "lvl": 0,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N五指疾挥，一式[" HIY "角韵" NOR "]无形的刺向$n的左肋",
    "force": 760,
    "dodge": 680,
    "parry": 640,
    "damage": tydamage,
    "lvl": 9,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N将手中剑横扫，同时左右手如琵琶似的疾弹，正是一招[" HIR "支韵" NOR "]" NOR,
    "force": 760,
    "dodge": 680,
    "parry": 640,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出「" NOR WHT "羽韵" NOR "」，将剑提至唇边，如同清音出箫，剑掌齐出，划向$n的$l" NOR,
    "force": 760,
    "dodge": 680,
    "parry": 640,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
});


int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 20000)
    return notify_fail("你的内力不够。\n");
  if (me->query_skill("wuxing-jianfa") < 250 && me->query("family/master_id") != "huangzhong gong")
    return notify_fail("wuxing-jianfa是huangzhong gong绝技，其他师傅参悟还来不及，怎能教你？\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("wuxing-jianfa", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;

  if (me->query("neili") < 50000) return 0;
  if (random(10) < 2) return 0;
  //  第六等级的伤气
  if (me->query_skill("wuxing-jianfa", 1) > 4000
    && me->query("jym_level/level") >= 25) {
    victim->receive_damage("qi", (damage_bonus) * 6, me);
    return HIW "$N手腕一震，将体内的无形剑气发动，配合一阵淡淡的琴音侵入$n的全身穴脉！！！\n" NOR;

  }

  //  第五等级的伤气
  if (me->query_skill("wuxing-jianfa", 1) > 3000
    && me->query("jym_level/level") >= 15) {
    victim->receive_damage("qi", (damage_bonus) * 4, me);
    return WHT "$N手腕一震，将体内的无形剑气发动，配合一阵淡淡的琴音侵入$n的全身穴脉！！！\n" NOR;
  }
  if (damage_bonus < 110) return 0;

  //  第四等级的伤气
  if (me->query_skill("wuxing-jianfa", 1) > 2000
    && me->query("jym_level/level") >= 10) {
    victim->receive_damage("qi", (damage_bonus - 100), me);
    return MAG "$N手腕一震，将体内的无形剑气发动，配合一阵淡淡的琴音刺入$n的气海之中！！！\n" NOR;
  }


  //  第三等级的伤气
  if (me->query_skill("wuxing-jianfa", 1) > 1000
    && me->query("jym_level/level") >= 4) {
    victim->receive_wound("qi", (damage_bonus - 100) / 2, me);
    return CYN "$N手腕一震，将体内的无形剑气发动，配合一阵淡淡的琴音刺入$n的气海之中！！！\n" NOR;
  }
  // 第二等级的伤气
  if (me->query_skill("wuxing-jianfa", 1) > 400
    && me->query("jym_level/level") >= 2) {
    victim->receive_wound("qi", (damage_bonus - 100) / 4, me);
    return RED "$N手腕一震，将体内的无形剑气发动，配合一阵淡淡的琴音刺入$n的气海之中！！！\n" NOR;
  }
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jing") < 50)
    return notify_fail("你的体力不够练七弦无形剑。\n");
  if ((int)me->query_skill("wuzheng-xinfa", 1) < 300)
    return notify_fail("你的无争心法火候不到。\n");
  me->receive_damage("jing", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "wuxing-jianfa/" + action;
}
