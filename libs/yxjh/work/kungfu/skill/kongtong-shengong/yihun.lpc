#include <ansi.h>
inherit F_SSERVER;
int exert(object me, object target) {
  int sp, dp;
  if (target == me)
    target = offensive_target(me);
  if (!objectp(target) || target->query("id") == "mu ren")
    return notify_fail("你要对谁施展移魂诀绝技？\n");
  if (!living(target))
    return notify_fail("已经不需要为" + target->name() + "浪费精力了！\n");
  if ((int)me->query_skill("kongtong-shengong", 1) < 2800)
    return notify_fail("你的崆峒神功功力不够，不能移魂攻击对方！\n");
  if ((int)me->query("neili", 1) < 50)
    return notify_fail("你的内力不够，不能使用崆峒神功。\n");
  message_vision(HIW "$N盯着$n的双眼，施展开崆峒神功移魂诀，$n只觉得$N的盯着自己的眼神惊艳异常！\n\n" NOR, me, target);
  if (living(target))
    if (!target->is_killing(me))
      target->kill_ob(me);
  sp = me->query_skill("force") + me->query_skill("parry") + me->query_skill(
    "kongtong-shengong",
    1
  ) / 2;
  dp = target->query_skill("force");

  if ((random(sp) > random(dp))) {
    tell_object(target, HIW " 你忽然觉得脑海中闪过以前销魂的回忆，紧接着似乎沉浸在回忆当中！\n" NOR);
    tell_object(me, HIB "你看到" + target->name() + "脸色忽然由白慢慢转变成粉红色，紧接着就全身瘫软了！\n" NOR);
    target->receive_wound(
      "jing",
      10 + random((int)me->query_skill("kongtong-shengong", 1) * 5),
      me
    );
    me->start_busy(1);
    target->start_busy(random(4));
    me->add("neili", -50);
  } else {
    message_vision(HIY "$p内力深厚，盯睛回望着$P，反而使得$P心神不宁。\n" NOR, me, target);
    me->start_busy(4);
  }
  return 1;
}
