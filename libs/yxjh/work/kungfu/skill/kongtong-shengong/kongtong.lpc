#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
    string msg;
    int i, lvl;
                object ob;
          me = this_player();
    me->clean_up_enemy();
    ob = me->select_opponent();
    
                if( me->is_busy() )
                                                return notify_fail("你的动作还没有完成，不能使用「崆峒八门无极」。\n");
        if((int)me->query_dex() < 30)
                return notify_fail("你先天身法不够,不能使用这一绝技!\n");
        if((int)me->query_skill("kongtong-shengong",1) < 200)
                return notify_fail("你崆峒神功的功力不够不能使用崆峒八门无极!\n");
        if((int)me->query_skill("unarmed") < 200)
                return notify_fail("你的拳脚修为不够,目前还不能使用崆峒八门无极绝技!\n");
        if((int)me->query("neili") < 500)
                return notify_fail("你内力现在不够, 不能使用崆峒八门无极! \n");
        if( me->query_temp("weapon"))
                return notify_fail("你先放下手中的武器再说吧？！\n"); 
                                if( (int)me->query_skill("sword") < 1300 || me->query_skill_mapped("sword") != "kongtong-jueji")
                                        return notify_fail("崆峒八门无极需要崆峒绝技来配合施展！！\n");
        if( (int)me->query("neili") < 5000 )
                return notify_fail("你的真气不够！\n");
        if( (int)me->query("max_neili") < 5000 )
                return notify_fail("你的内力修为不够！\n");
                if( !me->is_fighting() )
                                        return notify_fail("「崆峒八门无极」只能在战斗中使用。\n");
                if( (int)me->query("jingli") < 5000 )
                                        return notify_fail("你的精力不足！\n");
                if( (int)me->query("jym_level/level") < 60 )
                                        return notify_fail("你的等级不够不能施展「崆峒八门无极」！\n");                             
                
    msg = HIY "$N默默运气内劲混元气，使出崆峒派秘传绝学「崆峒八门无极」，身法陡然加快！\n" NOR;
    message_vision(msg, me);
                lvl = me->query("jym_level/level");
     for(i=0;i<(lvl/20);i++) COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
     me->add("jingli", -2350);
                 me->start_busy(1);
    return 1;    
} 


