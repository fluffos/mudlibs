int valid_enable(string usage) 
{ 
    return usage == "sword" || usage == "dodge" || usage == "parry" || usage == "club" || usage == "blade"; 
}

string query_parry_msg(object me,object weapon)
{
    string msg;
    object my_weapon;

    if (!(my_weapon=me->query_temp("weapon"))){
        if (!(my_weapon=me->query_temp("secondary_weapon")))
          return "";
     }else{
        if (!valid_enable(my_weapon->query("skill_type"))){
            if (!(my_weapon=me->query_temp("secondary_weapon")))
                  return "";
            else            
                if (!valid_enable(my_weapon->query("skill_type")))
                  return "";
        }
    }
    if (weapon)
        msg=weapon_vs_weapon_msg[random(sizeof(weapon_vs_weapon_msg))];
    else
        msg=unarmed_vs_weapon_msg[random(sizeof(unarmed_vs_weapon_msg))];
    msg=replace_string( msg, "$i", my_weapon->name() );
    return msg;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
    mapping a_action;
    int i, level, shen;
    level   = (int) me->query_skill("yiming-sword", 1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]){
                        a_action = action[NewRandom(i, 20, level/5)];
                        break;
                }
    a_action["dodge"]  = 0-level*3;
    a_action["parry"]  = 0-level*3;
    a_action["attack"]  = level*3;
    a_action["damage"] = level*5;
    if (me->query_temp("action_flag"))
        me->set_temp("action_msg","紧跟着");
    return a_action;

}
string query_dodge_msg(string limb,object me)
{
        me->set_temp("fight/dodge",5*me->query_skill("yiming-sword",1));
        return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 20000) 
        return notify_fail("你的内力不够。\n");
      if (me->query_skill("sword",1) <3000)
      return notify_fail("你的基础不够，无法领会更高深的技巧！\n");
        if (me->query_skill("yiming-sword",1)> 500)
        return notify_fail("一鸣剑法是泰山门徒段一鸣的绝技，他也是自悟的怎么继续教你？\n");
    return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 110 ) return 0;
      if( me->query("neili") < 5000   ) return 0;
      if( random(10) < 2   ) return 0;

 //  第六等级的伤气
      if( me->query_skill("yiming-sword",1)>3000) 
        {
        victim->receive_damage("qi", (damage_bonus ) * 5 , me);
                                return WHT  "$N的一鸣剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
                        }      
 //  第五等级的伤气
      if( me->query_skill("yiming-sword",1)>2000)
                        {
        victim->receive_damage("qi", (damage_bonus ) * 3 , me);
                                return YEL "$N的一鸣剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
                        }      
      if( damage_bonus < 100 ) return 0;

 //  第四等级的伤气
        if( me->query_skill("yiming-sword",1)>1000)
                                {
        victim->receive_damage("qi", (damage_bonus ) * 2  , me);
                                return MAG "$N的一鸣剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
                        } 

 //  第三等级的伤气
        if( me->query_skill("yiming-sword",1)>500)
        {
        victim->receive_wound("qi", (damage_bonus - 100) , me);
                                return CYN "$N的一鸣剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
                        }      
 // 第二等级的伤气
        if ( me->query_skill("yiming-sword",1)>300)
                        {
         victim->receive_wound("qi", (damage_bonus - 100) /2 , me);
                                return RED "$N的一鸣剑法已初有小成,带出一小阵"HIR"剑气"HIW"扑向$n！！！！！\n" NOR;
                                }
}

// 一鸣剑法的特殊攻击
void do_interlink(object me, object victim)
{
    int skill,i,j;
    object *enemy;
    
    skill=me->query_skill("yiming-sword", 1);
    if (skill>500)
                {
        enemy=me->query_enemy();
        if (!sizeof(enemy)) return;
// 对所有敌人均自动进行攻击
        for (i=0;i<sizeof(enemy);i++){
            for (j=0;j<(skill/(20*sizeof(enemy)));j++)
                if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("qi")>0 ){
                    if (environment(me) == environment(enemy[i]))
                     {
                   me->add_temp("str",skill/10);
                   me->add_temp("dex",skill/10);
                        COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_REGULAR);
                     }
                }else break;
        }
         me->delete_temp("str");
         me->delete_temp("dex");
    }
}
