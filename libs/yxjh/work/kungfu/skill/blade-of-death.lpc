//blade-of-death  
//by jerry update 2008.12.06

#include <ansi.h>
inherit SKILL;

string type() { return "zhongji"; }
mapping *action = ({
  ([ "action": HIW "$N猛一弯腰，手中刀尖向前一送，毫无半点花俏的一刀直取$n的咽喉" NOR,
    "force": this_player()->query_skill("blade-of-death", 1) * 4,
    "dodge": this_player()->query_skill("dodge", 1) * 4,
    "damage": this_player()->query("jym_level/level") * 500,
    "parry": this_player()->query_skill("parry", 1) * 4,
    "damage_type": "内伤",
  ]),
  ([ "action": HIW "$N刀势突变，竟然施展出东瀛刀法中的「" HIB "迎风一刀斩" HIW "」，一刀直劈向$n的头顶" NOR,
    "force": this_player()->query_skill("blade-of-death", 1) * 4,
    "dodge": this_player()->query_skill("dodge", 1) * 4,
    "damage": this_player()->query("jym_level/level") * 500,
    "parry": this_player()->query_skill("parry", 1) * 4,
    "damage_type": "内伤",
  ]),
  ([ "action": HIW "$N忽然以刀代剑，使出的剑意竟然有如「" HIG "独" HIB "孤" HIR "九" HIY "剑" HIW "」般如梦似幻" NOR,
    "force": this_player()->query_skill("blade-of-death", 1) * 4,
    "dodge": this_player()->query_skill("dodge", 1) * 4,
    "damage": this_player()->query("jym_level/level") * 500,
    "parry": this_player()->query_skill("parry", 1) * 4,
    "damage_type": "内伤",
  ]),
});

int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }
int valid_learn(object me) {
  if (me->query_skill("blade", 1) <= me->query_skill("blade-of-death", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  mapping a_action;
  a_action = action[random(sizeof(action))];
  a_action["dodge"] = me->query_skill("blade");
  return a_action;
}
int practice_skill(object me) {
  object weapon;
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练华山剑法。\n");
  me->receive_damage("qi", 30);
  return 1;
}

void do_interlink(object me, object victim) {
  int skill1, skill2, j;
  string second_skill;
  if (me->query_temp("secondary_weapon")) return;
  second_skill = me->query_skill_mapped("unarmed");
  if (!second_skill || second_skill != "huashan-zhangfa") return;
  skill1 = me->query_skill("blade-of-death", 1);
  skill2 = me->query_skill("jiuyin-xinjing", 1);
  if (random(skill1) > 100 && random(skill2) > 100) {
    message_vision(HIG "\n$N心念一闪，将九阴心经融汇刀上，无心中施展出「九阴夺魂」连出数刀！\n\n" NOR, me);
    for (j = 0; j < 5; j++)
      if ((me->is_fighting(victim) || victim->is_fighting(me)) && victim->query("qi") > 0) {
        me->set_temp("action_msg", WHT "刀光如雪，刀势如雷、、、\n" NOR);
        if (environment(me) == environment(victim)) {
          COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));
        }
      } else break;
  }
  me->delete_temp("secondly_weapon");
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;

  if (random(damage_bonus / 2) > victim->query_str()) {
    victim->receive_wound("jing", (damage_bonus));
    victim->receive_wound("qi", (damage_bonus));
    return BLINK HIR "$N一招得手，体内第二道刀劲立刻吐出，$n刹那间如遭雷击，心脉尽伤！\n" NOR;
  }
}

string perform_action_file(string action) {
  return __DIR__ "blade-of-death/" + action;
}
