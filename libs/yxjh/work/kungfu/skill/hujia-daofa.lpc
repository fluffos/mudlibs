#include <combat.h>
inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w横推，一招「"+BLU+"推波助澜"+NOR+"」，由上至下向$nl砍去  ",
        "skill_name" : BLU "推波助澜" NOR,
        "lvl" : 35,
        "damage_type" : "割伤",
]),
([      "action" : "$N一招「"+RED+"沙鸥掠波"+NOR+"」，刀锋自下而上划了个半弧，$w一提一收，平刃挥向$n的颈部  ",
        "skill_name" : RED "沙鸥掠波" NOR,
        "lvl" : 70,
        "damage_type" : "割伤",
]),
([      "action" : "$N使出一招「"+BLU+"天设牢笼"+NOR+"」，将$w舞得如白雾一般压向$n ",
        "skill_name" : BLU "天设牢笼" NOR,
        "lvl" : 100,
        "damage_type" : "割伤",
]),
([      "action" : "$N一招「"+YEL+"闭门铁扇"+NOR+"」，$w缓缓的斜着向$n推去 ",
        "skill_name" : "闭门铁扇",
        "lvl" : 125,
        "damage_type" : "割伤",
]),
([      "action" : "$N手拖$w，转身跃起，一招「"+MAG+"翼德闯帐"+NOR+"」，一道白光射向$n的胸口 ",
        "skill_name" : MAG "翼德闯帐" NOR,
        "lvl" : 150,
        "damage_type" : "割伤",
]),
([      "action" : "$N挥舞$w，使出一招「"+HIW+"白鹤舒翅"+NOR+"」，上劈下撩，左挡右开，齐齐罩向$n  ",
        "skill_name" : HIW "白鹤舒翅" NOR,
        "lvl" : 180,
        "damage_type" : "割伤",
]),
([      "action" : "$N一招「"+RED+"春风送暖"+NOR+"」，左脚跃步落地，$w顺势往前，挟风声劈向$n的$l  ",
        "skill_name" : RED "春风送暖" NOR,
        "lvl" : 200,
        "damage_type" : "割伤",
]),
([      "action" : "$N 忽的使一招「"+MAG+"八方藏刀"+NOR+"」，顿时剑光中无数朵刀花从四面八方涌向$n全身  ",
        "skill_name" : MAG "八方藏刀" NOR,
        "lvl" : 220,
        "damage_type" : "割伤",
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int practice_level(){   return 56;  }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 1200)
        return notify_fail("你的内力不够。\n");
    else if ((int)me->query_skill("force", 1) < 20)
        return notify_fail("你的基本内功火候太浅。\n");
    if (me->query_skill("blade", 1) <=me->query_skill("hujian-daofa", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
        return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--) if(level >= action[i]["lvl"])
        return action[i]["skill_name"];
}

//2010-6-29
mapping query_action(object me, object weapon)
{
    mapping a_action;
    int i, level,size;

//群攻伤害
//------------------------------------------------------------------------------------------
    if ((int)me->query_temp("hujia-daofa")>0)
        return (["action": BOLD "一"+weapon->query("unit")+"$w"+BOLD+"罩向$n"+BOLD+"的$l" NOR,
                 "dodge": -3*random(level),
                 "damage": level,
                 "damage_type":"砍伤",
                 "post_action":  (: call_other, WEAPON_D, "hack_weapon" :),
                ]);
//------------------------------------------------------------------------------------------
//普攻伤害
//------------------------------------------------------------------------------------------
    level   = (int) me->query_skill("hujia-daofa",1);
    size = sizeof(action)-1;
    for(i = size; i >= 0; i--) if(level > action[i]["lvl"])
    {
        a_action = action[NewRandom(i, 20, level/5)];
        break;
    }
    a_action["damage"] += level+random(level)*3;
    a_action["dodge"]  = 0-level*3;
    a_action["parry"]  = 0-level*3;
    a_action["attack"]  = level*3;
    return a_action;
//------------------------------------------------------------------------------------------
}

int practice_skill(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够，练不了胡家刀法。\n");
    me->receive_damage("qi", 30);
    return 1;
}

//2010-6-29 群攻处理
void do_interlink(object me, object victim) 
{ 
    int skill,i,j; 
    object *enemy,weapon=me->query_temp("weapon"); 
    string all_enemy; 
          
    if (!weapon) return; 

    skill=me->query_skill("huajia-daofa", 1); 
    if (random(skill)>250)
    { 
        enemy=me->query_enemy(); 
        if (!sizeof(enemy)) return; 
        if (sizeof(enemy)==1 && enemy[i]->query("eff_qi")<0 ) return; 

        for (i=1;i<sizeof(enemy);i++) all_enemy+=("、"+enemy[i]->name());

        message_vision(BOLD+"$N纵身跃起，手中"+weapon->query("unit")+weapon->name()+"直奔"+all_enemy+"。\n\n" NOR,me); 
        me->set_temp("hujia-daofa",1); 
        for (i=0;i<sizeof(enemy);i++)
        { 
            for (j=0;j<(skill/(60*sizeof(enemy)));j++) 
                if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("eff_qi")>0 )
                { 
                    if (environment(me) == environment(enemy[i])) 
                    { 
                        COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_QUICK); 
                    } 
                }
                else break; 
        } 
        me->delete_temp("hujia-daofa"); 
    }
}

//2010630
mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 110 ) return 0;
      if( me->query("neili") < 50000   ) return 0;
      if( random(10) < 2   ) return 0;

 //  第六等级的伤气
      if( me->query_skill("hujia-daofa",1)>3000
  && me->query("zjb_dj/dj")>=25  ) {
              victim->receive_damage("qi", (damage_bonus ) * 3 , me);
return WHT  "$N的胡家刀法已入返璞归真境界，刀光所到无不成锋，扑向$n！！！！！\n" NOR;
  }      

 //  第五等级的伤气
      if( me->query_skill("hujia-daofa",1)>1500
  && me->query("zjb_dj/dj")>=15 ) {
              victim->receive_damage("qi", (damage_bonus) *2  , me);
return YEL "$N的胡家刀法已璞归真，惊异绝伦的刀锋罩向$n！！！！！\n" NOR;
  }      
      if( damage_bonus < 100 ) return 0;

 //  第四等级的伤气
      if( me->query_skill("hujia-daofa",1)>1000
  && me->query("zjb_dj/dj")>=10 ) {
           victim->receive_damage("qi", (damage_bonus - 100) * 5 , me);
return MAG "$N的胡家刀法精进，随心所欲撩向$n！！！！！\n" NOR;
  } 

 //  第三等级的伤气
        if( me->query_skill("hujia-daofa",1)>500
       && me->query("zjb_dj/dj")>=3 ) {
                victim->receive_wound("qi", ((damage_bonus - 100) / 2) *5 , me);
return CYN "$N的胡家刀法已大有所成，刀光扑朔迷离罩向$n！！！！！\n" NOR;
  }      
 // 第二等级的伤气
        if ( me->query_skill("hujia-daofa",1)>200
  && me->query("zjb_dj/dj")>=2 ) {
             victim->receive_wound("qi", ((damage_bonus - 100) / 8) *3 , me);
return RED "$N的胡家刀法已初有小成,带出一小阵"HIR"刀光"HIW"扑向$n！！！！！\n" NOR;
}
}


//pfm路径
string perform_action_file(string action)
{
    return __DIR__"hujia-daofa/" + action;
}
