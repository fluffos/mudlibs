// kongtong-shengong.c 崆峒神功  
// quest 2010 7 15  
  
#include <ansi.h>  
inherit FORCE;  
string *order = ({""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});  
 
string *msg = ({ 
  "$N运行崆峒神功内劲只以一掌向$n的$l拍出！！！！！", 
  "$N默运崆峒神功运行内劲，使得内力崩涌，丹田中一股热气激升而上，身子猛跃而起。\n" 
  "双掌推出，一股凌厉之极的掌风随之朝$n压去！！！！", 
  "$N眼中精光暴涨双掌平推而出，看来平平无奇，内中却是暗藏极大潜力！",  
  "$N运用崆峒神功内劲发劲，双掌一上一下，一放一收，斗然击出，朝著$n排山倒海般推将过来",       
  "$N劲由心生，崆峒神功内劲迸发，一股热气从丹田中直冲上来，双腿一弯\n" 
  "口中”哈！“的一声叫喝，手掌便朝$n推出！！！！！！",  
  "$N猛喝一声，运起崆峒神功内劲双掌倏向$n$l推出，掌力疾冲而去\n" 
  "劲力十分猛恶，祗隐听得呼呼风响，声音劲急，非同寻常！！！",  
  "$N虚步藏掌，运用崆峒神功内劲猛地双掌推出，掌风沉雄凌厉。$n突觉一股排山倒海般的力道撞来，猛迅无伦",  
  "$N身子凌空跃起发掌向$n击去，左掌右掌连环邀击，双掌连绵而上，掌法愈厉乘势不住追击，後著凌厉之极",  
  "$N运行崆峒神功内劲于双手，身子忽地拔起，一跃三尺，落在$n的面前，双掌向$p直劈而下", 
  "$N丝毫不动声色，右掌平伸，左掌缓缓运起崆峒神功的劲力，呼的一声推向$n", 
  "突然之间$N运行崆峒神功内劲，上盘全然不守，微微抬头双掌向$n$l拍去", 
  "$N运行崆峒神功内劲一掌击出，中途方向必变，实不知将打何处", 
  "$N默运行崆峒神功，内劲在经脉游走，觉的愈转愈是顺遂，双掌对着$n拍出", 
  "$N运行崆峒神功内劲，双掌没有任何华丽的武技向$n的方向推了出去", 
  "但见$N双腿微曲，双掌会收，然后向$n一上一下，携着崆峒神功内劲斗然击出", 
}); 
 
int valid_enable(string usage)   
{ return usage == "force" || usage=="unarmed" || usage =="parry"; }  
 
mapping query_action(object me, object weapon) 
{ 
        int level5 = me->query_level();
                                return ([ 
        "action" : msg[random(sizeof(msg))], 
        "damage": 5*random(level5),  
        "dodge" : 0+random(level5),  
        "parry" : 0+random(level5),  
        "force" : 2*random(level5), 
                "damage_type" : "割伤", 
        ]); 
}  
int valid_learn(object me)  
{  
    if ((int)me->query_skill("force", 1) < 2000)  
   return notify_fail("你的内功心法火候不够，无法学崆峒神功。\n");  
    if ((int)me->query("neili") < 15000)  
   return notify_fail("你的内力太弱，无法练崆峒神功。\n");  
    if ((int)me->query_skill("kongtong-shengong", 1) > 1000)  
   return notify_fail("你的崆峒神功已经达到师不可授的地步了，不能继续学习只能闭关提高。\n");  
    return 1;  
}  
int practice_skill(object me)  
{  
      return notify_fail("崆峒神功是不能随便什么地方都能练的。\n");  
}  
  
string exert_function_file(string func)  
{  
       return __DIR__"kongtong-shengong/" + func;  
}  
  
string perform_action_file(string action)  
{  
        return __DIR__"kongtong-shengong/" + action;  
}  
mixed hit_ob(object me, object victim, int damage_bonus)  
{  
      if( damage_bonus < 110 ) return 0;  
      if( me->query("neili") < 5000   ) return 0;  
      if( random(10) < 2   ) return 0;  
  
 //  第六等级的伤气  
      if( me->query_skill("kongtong-shengong",1)>9000)   
        {  
        victim->receive_damage("qi", (damage_bonus ) * 5 , me);  
                                return WHT "$N的崆峒神功已入返璞归真境界，招法中连绵不断的无形内劲传向$n！！！！！\n" NOR;  
                        }        
 //  第五等级的伤气  
      if( me->query_skill("kongtong-shengong",1)>3000)  
                        {  
        victim->receive_damage("qi", (damage_bonus ) * 3 , me);  
                                return YEL "$N的崆峒神功已入第二境界，内劲源源不断袭向$n！！！！！\n" NOR;  
                        }        
      if( damage_bonus < 100 ) return 0;  
  
 //  第四等级的伤气  
        if( me->query_skill("kongtong-shengong",1)>1500)  
                                {  
        victim->receive_damage("qi", (damage_bonus ) * 2  , me);  
                                return MAG "$N的崆峒神功已第一境界，招法简洁无形内劲在招数中击向$n！！！！！\n" NOR;  
                        }   
  
 //  第三等级的伤气  
        if( me->query_skill("kongtong-shengong",1)>1000)  
        {  
        victim->receive_wound("qi", (damage_bonus - 100) , me);  
                                return CYN "$N的崆峒神功惊世骇俗，招法中内劲无常震向$n！！！！！\n" NOR;  
                        }        
 // 第二等级的伤气  
        if ( me->query_skill("kongtong-shengong",1)>300)  
                        {  
         victim->receive_wound("qi", (damage_bonus - 100) /2 , me);  
                                return RED "$N的崆峒神功精湛绝伦，招法中无形内劲直奔$n！！！！！\n" NOR;  
                                }  
}  

