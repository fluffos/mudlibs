#include <ansi.h>  
#include <skill.h>  
#include <weapon.h>  
#include <combat.h>  
inherit NPC;  
int perform(object me, object target)  
                {  
     int i;  
    object weapon, ob, where, where2;  
    string msg;  
        me = this_player();  
        me->clean_up_enemy();  
    ob = me->select_opponent();  
                if (me->is_fighting())  
                {  
                                if  (environment(me)!=environment(ob) )   
                                return notify_fail("对方已经不在了。\n");  
                                }  
        if( !me->is_fighting() )  
            return notify_fail("「凌云剑法」只能在战斗中使用。\n");  
        if (!objectp(weapon = me->query_temp("weapon"))  
                || (string)weapon->query("skill_type") != "sword")  
                        return notify_fail("你使用的武器不对。\n");  
             if((int)me->query_skill("sword",1) < 2000)  
                return notify_fail("你的基本剑法的火候还不到家, 不能使用这一绝技 !\n");  
        if((int)me->query_skill("lingyun-jianfa",1) < 2000)  
                return notify_fail("你的嵩山剑法的火候还不到家, 不能使用这一绝技 !\n");  
        if( (int)me->query("neili") < 15000 )  
                return notify_fail("你的真气不够！\n");  
        if( (int)me->query("max_neili") < 15000 )  
                return notify_fail("你的内力修为不够！\n");  
                msg = HIC "\n$N凭借浑厚的内力使出凌云剑法的绝招「剑气冲霄」！\n" NOR;  
        message_vision(msg, me);  
        for(i=0;i<6;i++) COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);  
        me->add("neili",-1550);  
        me->start_busy(1);  
        return 1;  
}
