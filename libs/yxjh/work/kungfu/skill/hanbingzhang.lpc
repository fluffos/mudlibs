// hanbingzhang.c 嵩山寒冰掌
// quest 2010 07 13

inherit SKILL;

mapping *action = ({
  ([ "action": "$N脸上露出诡异的笑容，一招【寒冰银域】隐隐泛出绿色的双掌扫向$n的$l",
    "force": 250,
    "dodge": 200,
    "parry": 210,
    "damage": 220,
    "lvl": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N突然身形旋转起来一招【晴空飘雪】身法诡异的扑向$n，双掌飞舞着罩向$n的$l",
    "force": 100,
    "dodge": 130,
    "parry": 110,
    "damage": 320,
    "lvl": 10,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N将寒气运至双手，一招【寒气尸毒】双掌阴毒无比全力地抓向$n的$l",
    "force": 150,
    "dodge": 530,
    "parry": 210,
    "damage": 220,
    "lvl": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "刹那间$N双掌突然变招，【冰封千里】带着强大的寒气拍向$n的$l",
    "force": 250,
    "dodge": 50,
    "parry": 210,
    "damage": 220,
    "lvl": 10,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N突然腾空而起，身形急速双掌一前一后，一招【冰鉴慧芒】蓝光直奔向$n的$l",
    "force": 150,
    "dodge": 250,
    "parry": 110,
    "damage": 320,
    "lvl": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "瞬息间$N单掌变拳，似拳招猛烈发出，【群艳孤芳】一拳一掌，急急打向$n的$l",
    "force": 150,
    "dodge": 150,
    "parry": 210,
    "damage": 220,
    "lvl": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N脚下急速踏地，双掌借身体运力无邪，独到的【冰封傲雪】挟着一股寒气直直拍向$n的$l",
    "force": 150,
    "dodge": 250,
    "parry": 110,
    "damage": 220,
    "lvl": 20,
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练嵩山寒冰掌必须空手。\n");
  /*        if ((int)me->query_skill("jiuyang-shengong", 1) < 20)
           return notify_fail("你的「九阳神功」火候不够，无法学寒冰掌。\n");*/
  if ((int)me->query_skill("hanbing-zhenqi", 1) < 20)
    return notify_fail("你的「寒冰真气」火候太浅。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练寒冰掌。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("hanbingzhang", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");

  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练寒冰掌。\n");

  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "hanbingzhang/" + action;
}
