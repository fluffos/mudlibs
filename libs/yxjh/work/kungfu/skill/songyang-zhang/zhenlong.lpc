#include <ansi.h> 
 
inherit F_SSERVER; 
int perform(object me, object target) 
{ 
    int damage; 
    string msg; 
 
    if( !target ) target = offensive_target(me); 
 
    if( !target || !target->is_character() || !me->is_fighting(target) ) 
        return notify_fail("「"+HIC"寒冰镇龙"NOR+"」只能对战斗中的对手使用。\n"); 
 
 
    if( (int)me->query_skill("songyang-zhang", 1) < 100 ) 
          return notify_fail("你的嵩阳掌不够熟练，不会使用「"+HIC"寒冰镇龙"NOR+"」。\n"); 
 
    if( (int)me->query("max_neili") < 1200 ) 
           return notify_fail("你的内力修为还不够高。\n"); 
 
    if( (int)me->query("neili") < 800 ) 
           return notify_fail("你的内力不够了。\n"); 
 
    if( me->query_temp("weapon")) 
                return notify_fail("你先放下手中的武器再说吧？！\n");      
 
    msg = HIC " $N施展出嵩阳掌的绝学【"+HIC"寒冰镇龙"NOR+"】，寒气在全身急速转动起来，越来越快，\n骤然间，$N双掌已卷向正看得发呆的$n。\n"NOR;   
                if( random(me->query_skill("songyang-zhang",1)+me->query_skill("unarmed",1))*3 > target->query_skill("unarmed",1)) 
                                {
                                msg = HIC "$N的寒气太重，$n被震慑的四肢麻木无法移动。\n"NOR;  
                                target->start_busy(random(5)); 
                                damage = ((int)me->query_skill("songyang-zhang", 1)*5+(int)me->query_skill("force",1)*2)*2; 
                    damage = damage*200 + random(damage); 
                if (damage<target->query("max_qi",1)/8 && me->query("max_neili",1) > target->query("max_neili",1)/2) damage = random (target->query("max_qi",1)/6); 
                if (damage>target->query("max_qi",1)/3) damage = random (target->query("max_qi",1)/4); 
                         target->receive_damage("qi", damage); 
                         target->receive_wound("qi", damage/2); 
                         me->add("neili", -damage/3); 
   msg += HIC"$n只见全身寒气的人影中陡然现出$N的双掌，根本来不及躲避，被重重击中，寒气立刻渗入五脏六腑，口中鲜血如箭般喷出！！！\n"NOR; 
          message_vision(msg, me, target); 
                COMBAT_D->report_status(target);     
                return 1; 
                                 } else 
    { 
          me->add("neili",-200);         
          msg += HIG"$n看得分明，连忙提气纵身，以跳离了$N的嵩阳掌范围，$n四肢被寒气所伤无法移动。\n"NOR;
          target->start_busy(random(3));  
    } 
    message_vision(msg, me, target); 
 
    if(!target->is_fighting(me)) target->fight_ob(me); 
    return 1; 
} 

