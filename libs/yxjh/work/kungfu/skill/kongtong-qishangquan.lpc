// kongtong-qishangquan quest    

inherit SKILL;

//攻击描述    
string *msg = ({
  "$N好像心口受伤，双目紧闭，深运内力，猛的大喝了一声，以七种无比之劲力击向$n的全身\n"
  "$N胸口起伏不定，突然呼吸不畅，但单拳一握，默运六种不同劲力又低又快的击向$n的小腹\n",
  "$N突然腹中疼痛难忍，借疼痛默运神功，双拳无形无定，带着五种劲力骤然击向$n的前胸\n",
  "$N暗屏住藏离之感，吸一口真气，双拳平伸，带着四种不同之力击向$n的$l\n",
  "$N一招【损精毁元】，一拳击向$n的全身三十六道要穴，拳中竟带有三种不同劲力\n",
  "$N一拳前伸，一拳在后，带着刚猛和阴柔之劲，攻向$n的身前身后\n",
  "$N呼的一拳击向$n的$l，此拳去势之快，简直令人无法招架\n",
  "$N呼的一拳，直向$n的$l送了过去，只觉一股劲力扑面而来\n",
  "$N对准$n的$l，夹着劲风猛的横扫过去\n",
  "$N双拳一握，动起柔刚之劲，缓缓的向$n击出\n",
  "$N以一股刚中带柔之气，一拳击向$n的$l\n",
  "$N以阴柔以气，对准$n的$l轻飘飘的挥了过去\n",
  "$N的一拳含刚猛之气，猛的击向$n的$l\n",
  "$N凝神定气，使出七伤拳总诀中的【损心诀】，双拳一股刚猛之力向$n击去！\n"
  "$N深吸一口气，左拳再使出七伤拳总诀中的$【伤肺诀】，双拳飘忽不定，$n顿时感觉一股阴之力迎面而柔来。\n"
  "$N右拳接着使出七伤拳总诀中的「摧肝肠诀」，双拳刚中有柔，向$n击去。\n"
  "$N凝神定气，使出七伤拳总诀中的「藏离诀」，双拳柔中有刚，打出一股内缩之力！向$n击去。\n"
  "$N你大喝一声，须发俱张，使出「七伤总诀」，左右双拳连续击出，威猛无俦，打向$n！\n",
});

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  int level5 = me->query_level();
  return ([
    "action": msg[random(sizeof(msg))],
    "damage": 5 * random(level5),
    "dodge": 0 + random(level5),
    "parry": 0 + random(level5),
    "force": 0 + random(level5),
    "damage_type": "瘀伤",
  ]);
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 10) return 0;
  if (me->query("neili") < 50000) return 0;
  if (random(10) < 2) return 0;

  //  第六等级的伤气    
  if (me->query_skill("kongtong-qishangquan", 1) > 5000) {
    victim->receive_damage("qi", (damage_bonus) * 8, me);
    return WHT "$N的崆峒七伤拳已入返璞归真境界，随意一招带着一阵" HIR "崆峒内劲" HIW "扫向$n！！！！！\n" NOR;
  }
  //  第五等级的伤气    
  if (me->query_skill("kongtong-qishangquan", 1) > 3000) {
    victim->receive_damage("qi", (damage_bonus) * 5, me);
    return YEL "$N的崆峒七伤拳已达到炉火纯青的地步，随意一招带着一阵" HIR "崆峒内劲" HIW "扫向$n！！！！！\n" NOR;
  }

  if (damage_bonus < 100) return 0;
  //  第四等级的伤气    
  if (me->query_skill("kongtong-qishangquan", 1) > 2000) {
    return MAG "$N的崆峒七伤拳已达到精益求精的地步，随意一招带着一阵" HIR "崆峒内劲" HIW "扫向$n！！！！！！！！！！\n" NOR;
  }
  //  第三等级的伤气    
  if (me->query_skill("kongtong-qishangquan", 1) > 1500) {
    victim->receive_wound("qi", (damage_bonus - 100), me);
    return CYN "$N的崆峒七伤拳已达到大有所成，随意一招带着一阵" HIR "崆峒内劲" HIW "扫向$n！！！！！\n" NOR;
  }
  // 第二等级的伤气    
  if (me->query_skill("kongtong-qishangquan", 1) > 300) {
    victim->receive_wound("qi", (damage_bonus - 100) / 2, me);
    return RED "$N的崆峒七伤拳已初有小成,带出一阵" HIR "崆峒内劲" HIW "扫向$n！！！！！\n" NOR;
  }
}

int valid_learn(object me) {
  if ((int)me->query_skill("force", 1) < 200)
    return notify_fail("你的崆峒神功火候不够，无法学崆峒七伤拳。\n");
  if ((int)me->query_skill("kongtong-qishangquan", 1) > 500)
    return notify_fail("你的崆峒七伤拳已经达到师不可授的地步了，不能继续学习只能闭关提高。\n");
  if ((int)me->query("neili") < 5500)
    return notify_fail("你的内力太弱，无法练崆峒七伤拳。\n");
  return 1;
}
int practice_skill(object me) {
  return notify_fail("崆峒神功是不能随便什么地方都能练的。\n");
}

string perform_action_file(string action) {
  return __DIR__ "kongtong-qishangquan/" + action;
}
