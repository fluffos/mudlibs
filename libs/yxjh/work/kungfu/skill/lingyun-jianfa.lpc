// quest 2010 7 11
inherit SKILL; 
int tydamage = (this_player()->query("tydamage/sword")?this_player()->query("tydamage/sword"):this_player()->query_skill("lingyun-jianfa"))*5; 

string *parry_msg = ({ 
        "只听见「锵」一声，被$p用手中$i轻轻荡开了。\n", 
        "$n随身形递出$w，$N险些击被刺中。\n", 
        "凝神换式的$n手中$i迅速无比地刺向$N胸口，随即躲开$w。\n", 
        "只见$n身子一侧，紧跟着用手中$i把$w拨开。\n", 
        "突然之间$n使出凌云剑步向后越出丈余，躲过了$N这一招。\n", 
        "$n身形转了几转，横向移步到$N的身边，躲过了$N这一招。\n", 
        "$N眼前人影晃动，似乎看不清$n身形，但随即又好似看到$n。\n",
        "只见$n双手在$N手肘下一推，顺势闪到一旁。\n", 
        "但见$n手中$i突然指向$N，$N慌忙闪避。\n", 
}); 

mapping *action = ({ 
([      "action":"$N挺身而上，直奔到$n的身前，$w毫不留情的捅向$n的$l", 
        "skill_name" : "挺身而上", 
        "damage_type":  "刺伤" 
]), 
([      "action":"$N突然出招，凌云一剑$w，招式强势忽伸直奔$n的$l。", 
        "skill_name" : "凌云一剑", 
        "damage_type":  "刺伤" 
]), 
([      "action":"$N身形滴溜溜转开，转了几转，移步到$n的身侧，$w直直向$l狠狠递去。", 
        "skill_name" : "转了几转", 
        "damage_type":  "刺伤" 
]), 
([      "action":"$N一声长啸笑，双手持$w疾冲上前，凌云壮志之气大胜，与$n面面相观，$w随即狠狠递出", 
        "skill_name" : "凌云壮志", 
        "damage_type":  "刺伤" 
]), 
([      "action":"$N喝道：“来的好！”，身形不变，面对来招不躲不闪$w正手刺向$n的$l", 
        "skill_name" : "不躲不闪", 
        "damage_type":  "刺伤" 
]), 
([      "action":"$N向后疾退，手中$w随身而动，$n紧追两步，$N手中$w直指$n的$l", 
        "skill_name" : "随身而动", 
        "damage_type":  "刺伤" 
]), 
([      "action":"$N手中$w直刺$n面门！$n慌忙招架，$N大喊一声：“中！”$w突然转向$n的$l", 
        "skill_name" : "直刺面门", 
        "damage_type":  "刺伤" 
]), 
([      "action":"$N飞身跃起，$n抬眼一望，但见得$N双手捧剑从天直落而下，手中$w刺向$n的$l", 
        "skill_name" : "从天直落", 
        "damage_type":  "刺伤" 
]), 
([      "action":"$N脚步急动，$w随身形直直刺向$n", 
        "skill_name" : "脚步急动", 
        "damage_type":  "刺伤" 
]), 
}); 
int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); } 
int practice_skill(object me) 
{ 
    object weapon; 
    if (!objectp(weapon = me->query_temp("weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
    if (!objectp(weapon = me->query_temp("secondary_weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
        return notify_fail("你使用的武器不对。\n"); 
    if ((int)me->query("qi") < 50) 
        return notify_fail("你的体力不够练凌云剑法。\n"); 
    me->receive_damage("qi", 30); 
    return 1; 
} 
mapping query_action(object me, object weapon) 
{ 
    mapping a_action; 
    int i, level; 
    level   = (int) me->query_skill("lingyun-jianfa",1); 
        for(i = sizeof(action); i > 0; i--) 
                if(level > action[i-1]["lvl"])
                        { 
                        return action[NewRandom(i, 20, level/5)]; 
                        break; 
                           }
                a_action["force"]  = 0-level*5;                             
    a_action["dodge"]  = 0-level*10; 
    a_action["parry"]  = 0-level*3; 
    a_action["attack"]  = level*3; 
    a_action["damage"] = (tydamage+level)*50; 
    return a_action;
                        
} 
int valid_learn(object me) 
{ 
    object weapon; 
    if (!objectp(weapon = me->query_temp("weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
    if (!objectp(weapon = me->query_temp("secondary_weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
        return notify_fail("你必须先找把剑才能学凌云剑法。\n"); 
    if ((int)me->query("max_neili") < 100) 
        return notify_fail("你的内力不够。\n"); 
    if (me->query_skill("sword", 1) <=me->query_skill("lingyun-jianfa", 1)) 
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n"); 
                return 1; 
} 
mixed hit_ob(object me, object victim, int damage_bonus, int factor) 
{ 
                        int weap, weap1;
      weap = victim->query_temp("weapon"); 
      weap1 = me->query_temp("weapon");
           if( (me->query_skill("lingyun-jianfa") > 450) && (me->query("neili") > 10000) 
       && (victim->query_temp("weapon"))  
       && random(10) > 7) 
       { 
               message_vision(HIY "只见$N手中" + weap1->name() + ""HIC"凌云剑招不断而出，一剑连着一剑将对方的" + weap->name() +""HIR"刺的火星直冒！\n" NOR, me );  
                if (!victim->is_busy()) 
               victim->start_busy(1); 
               if (me->query_skill("sword") > victim->query_skill("sword")) 
               { 
                       message_vision(HIR "\n潜运全身真劲全力一剑刺下，只听 乒! 的一声巨响，" + weap->name() 
                  + "被"+weap1->name()+""HIR"从$N"HIR"手中直刺成两段，$N"HIR"情急之下只好空手应战。\n" NOR, victim ); 
                        if(weap->query_xy()) 
                        { 
                                weap->add("max_lasting",-100); 
                                weap->move(victim); 
                        } 
                        else 
                        { 
                               weap->move(environment(me)); 
                               weap->set("name", "断掉的"+ weap->query("name") ); 
                               victim->reset_action(); 
                               weap->set("value", 0); 
                               weap->set("weapon_prop", 0); 
                               weap->set("long", "一把断掉的武器，从中断开，破口整齐，看来是被绝顶高手生生震断的。\n"); 
                        } 
               } 
               else 
               { 
                      message_vision(HIY "\n$N无奈之下只好，" + weap->name() 
                   + ""HIY"应着方向硬将"+weap1->name()+""HIY"上的真劲顶住。\n" NOR, victim ); 
                      victim->add("neili", -1000); 
              } 
              me->add("neili", - (20+random(30))); 
      } 
      if( me->query("neili") < 50000   ) return 0; 
      if( random(10) < 2   ) return 0; 
 
 //  第六等级的伤气 
      if( me->query_skill("lingyun-jianfa",1)>4000 
  && me->query("jym_level/level")>=25  ) { 
              victim->receive_damage("qi", (damage_bonus ) * 2 , me); 
return WHT  "$N的凌云剑法以到最高等级，凌云剑法精髓道道寒光扑向$n！！！！！\n" NOR; 
  }       
 
 //  第五等级的伤气 
      if( me->query_skill("lingyun-jianfa",1)>3000 
  && me->query("jym_level/level")>=15 ) { 
              victim->receive_damage("qi", damage_bonus  , me); 
        return YEL "$N的凌云剑法诡异披靡道道剑光扑向$n！！！！！\n" NOR; 
  }       
      if( damage_bonus < 100 ) return 0; 
 
 //  第四等级的伤气 
      if( me->query_skill("lingyun-jianfa",1)>2000 
  && me->query("jym_level/level")>=10 ) { 
           victim->receive_damage("qi", (damage_bonus - 100)  , me); 
      return MAG "$N的凌云剑法轻盈洒脱剑光扫向$n！！！！！\n" NOR; 
  }       
 
 
 //  第三等级的伤气 
      if( me->query_skill("lingyun-jianfa",1)>1000 
  && me->query("jym_level/level")>=4 ) { 
                victim->receive_damage("qi", (damage_bonus - 100) / 3 , me); 
return CYN "$N的凌云剑法已有小成，出剑之时已有剑气扫向$n！！！！！\n" NOR; 
  }       
 // 第二等级的伤气 
        if ( me->query_skill("lingyun-jianfa",1)>400  
  && me->query("jym_level/level")>=2        ) { 
             victim->receive_damage("qi", (damage_bonus - 100) / 8 , me); 
return RED "$N的凌云剑法剑光所到无比披靡，剑光如雪扫向$n！！！！！\n" NOR; 
} 
 
      return 1; 
} 
 
string perform_action_file(string action) 
{ 
    return __DIR__"lingyun-jianfa/" + action; 
} 
 

