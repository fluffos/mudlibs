// 太极刀「挤」字决 by pipip

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
      int damage, damage2;
        string msg;
        object weapon;

if ( (string)me->query("family/family_name") != "武当派" && me->query("family/family_name" != "明教" ))  
 return notify_fail("只有武当弟子和明教才能使用该PFM。\n");


        if (!target ) target = offensive_target(me);
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
        return notify_fail(RED"「挤」字决只能用刀施展！\n"NOR);
      if (!target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「挤」字决只能对战斗中的对手使用。\n");
      if ((int)me->query_skill("taiji-dao", 1) < 150 )
        return notify_fail(WHT"你的太极刀不够娴熟，还使不出「挤」字决。\n"NOR);
      if ((int)me->query_skill("taiji-shengong", 1) < 150 )
        return notify_fail(RED"你的太极神功修为不够，「挤」字决不成招式。\n"NOR);
      if ((int)me->query("max_neili")<20000)
        return notify_fail(RED"你的内力修为不足，无法运足「挤」字决的内力。\n"NOR);
      if ((int)me->query("neili")<200)
        {
        return notify_fail(HIC"你现在内力不够，没能使用「挤」字决。\n"NOR);
        }
      msg = HIW "$N使出太极刀法精意所在「挤」字决，刀光漫天飞舞！\n"NOR;
      msg += HIW"$n一楞，急满抽身后退，忽然漫天刀光竟快速收紧缩小\n"NOR;
      msg += HIW"已然将$n退路全部封死！！\n"NOR;
   if (random(me->query_skill("force"))>target->query_skill("force")/2)
        {
                me->start_busy(2);
                target->start_busy(random(3));
damage = (int)me->query_skill("taiji-dao", 1)*5+(int)me->query_skill("force",1)*2;
   damage = damage + random(damage);
if (damage<target->query("max_qi",1)/8 && me->query("max_neili",1) > target->query("max_neili",1)/2) damage = random (target->query("max_qi",1)/6);
if (damage>target->query("max_qi",1)/3) damage = random (target->query("max_qi",1)/4);


damage2 = (int)me->query_skill("taiji-dao", 1)*5+(int)me->query_skill("force",1)*2;
damage2 = damage2 + random(damage2);
                target->receive_damage("qi", damage/2);
                target->receive_wound("qi", damage);
      msg += HIG"$n眼见刀光逼来，竟然无法躲避，鲜血见处，$n已然中刀！！\n"NOR;
  me->add("neili", -damage/3);
        } else
        {
            me->start_busy(random(3));
        msg += HIC"$p情急之下左突右挡，竟然在「挤」字决刀招中闯了出来！！\n"NOR;
                me->add("neili", -200);
        }
        message_vision(msg, me, target);
        if(!target->is_fighting(me)) target->fight_ob(me);
//      if(userp(target)) target->fight_ob(me);
//      else if( !target->is_killing(me) ) target->kill_ob(me);
        return 1;
}

