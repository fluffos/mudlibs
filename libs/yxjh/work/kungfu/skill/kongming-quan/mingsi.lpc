// ming.c 「冥思决」
// By Dream 19:32 01-12-19
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
    string msg;
    int skill, jing_cost;
    skill = me->query_skill("kongming-quan",1);
    if (me->query_int()<50)
        jing_cost = (int)me->query_int() - 50;
    else    jing_cost=1;
    if( me->is_fighting() )
        return notify_fail("「冥思决」不能在战斗中演练。\n");

    if( !skill || (skill < 200))
        return notify_fail("你的空明拳等级不够, 不能演练「冥思决」！\n");
    if( me->query("neili") < 50 )
        return notify_fail("你的内力不够，没有内力演练「冥思决」！\n");
    if (me->query_skill("unarmed",1)<= skill)
        return notify_fail("你的基本拳脚不够，无法通过演练「冥思决」提高空明拳的技巧！\n");
    if( me->query("jing") < -jing_cost )
        return notify_fail("你现在太累了，无法集中精神演练「冥思决」！\n");
    write (WHT "你盘腿坐下，将自己所学的空明拳冥想了一遍。\n" + NOR);
    me->add("neili", -50);
    me->add("jing", jing_cost);
    if ( skill < 60)
        me->improve_skill("kongming-quan", 10);
    else if (skill < 90)
        me->improve_skill("kongming-quan", 10 + random((int)me->query_int() - 9));
    else if (skill < 140)
        me->improve_skill("kongming-quan", 10 + random((int)me->query_int() * 2 - 9));
    else if (skill < 200)
        me->improve_skill("kongming-quan", 10 + random((int)me->query_int() * 3 - 9));
    else
        me->improve_skill("kongming-quan", 10 + random((int)me->query_int() * 4 - 9));
write (MAG"你的「空明拳」进步了！\n"NOR);
        if (random(10)>8)    me->start_busy(0);
   // message_vision(msg, me);
    return 1;
}

