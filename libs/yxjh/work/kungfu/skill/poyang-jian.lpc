// poyang-jianfa.c 
// quest 2010 07 11 
#include <ansi.h> 
inherit SKILL; 
int tydamage = (this_player()->query("tydamage/sword")?this_player()->query("tydamage/sword"):this_player()->query_skill("poyang-jian"))*5; 
mapping *action = ({ 
([  "action" : "$N迈步凝神，一招「"+HIM+"四剑诛神"+NOR+"」，手中$w轻轻颤动，剑光一闪点向$n的$l", 
    "force" : 400, 
    "lvl" : 0, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "$N向前跨上一步，左手剑诀，右手$w侧转一式「"+YEL+"金华落日"+NOR+"」直刺$n的$l", 
    "force" : 370, 
    "lvl" : 10, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "$N身形往右一闪，左手掌护住空门，右手$w使出「"+WHT+"阳关三叠式"+NOR+"」刺向$n的$l", 
    "force" : 380, 
    "lvl" : 15, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "$N一招「"+HIW+"落日残阳"+NOR+"」，$w自上而下划出一个大弧，又急速反回平平地扫向$n的$l挥去", 
    "force" : 330, 
    "lvl" : 37, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "$N上身往左侧一拧，身形一变，一招「"+BLK+"朱雀烈焰"+NOR+"」，左手平展，右手$w反手向$n的$l挥去", 
    "force" : 410, 
    "lvl" : 48, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "刹那间$N左腿提膝，右手中$w斜指，一招「"+HIC+"寒光四射"+NOR+"」剑光急急刺向$n的$l", 
    "force" : 430, 
    "lvl" : 60, 
    "damage_type" : "刺伤" 
]), 
([  "action" : "$N突然转身，一招「"+CYN+"青龙归海"+NOR+"」，$w自上而下划出一个大弧，又平平地挥向$n的$l", 
    "force" : 140, 
    "lvl" : 70, 
    "damage_type" : "刺伤" 
]), 
}); 
 
int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); } 
int practice_level(){   return 145;  } 
int valid_learn(object me) 
{ 
    object weapon; 
    if (!objectp(weapon = me->query_temp("weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
    if (!objectp(weapon = me->query_temp("secondary_weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
        return notify_fail("你必须先找把剑才能学破阳冷光剑。\n"); 
 
    if ((int)me->query("max_neili") < 100) 
        return notify_fail("你的内力不够。\n"); 
    if (me->query_skill("sword", 1) <=me->query_skill("poyang-jian", 1)) 
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n"); 
    return 1; 
} 
mapping query_action(object me, object weapon) 
{ 
    mapping a_action; 
    int i, level; 
    level   = (int) me->query_skill("poyang-jian", 1); 
        for(i = sizeof(action); i > 0; i--) 
                if(level > action[i-1]["lvl"]){ 
                        a_action = action[NewRandom(i, 20, level/5)]; 
                        break; 
                } 
    a_action["dodge"]  = 0-level*3; 
    a_action["parry"]  = 0-level*3; 
    a_action["attack"]  = level*3; 
    a_action["damage"] = tydamage+level*15; 
    return a_action; 
 
} 
int practice_skill(object me) 
{ 
    object weapon; 
    if (!objectp(weapon = me->query_temp("weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
    if (!objectp(weapon = me->query_temp("secondary_weapon")) 
    || (string)weapon->query("skill_type") != "sword") 
        return notify_fail("你使用的武器不对。\n"); 
    if ((int)me->query("qi") < 50) 
        return notify_fail("你的体力不够练破阳冷光剑。\n"); 
    me->receive_damage("qi", 30); 
    return 1; 
} 
string perform_action_file(string action) 
{ 
    return __DIR__"poyang-jian/" + action; 
} 
