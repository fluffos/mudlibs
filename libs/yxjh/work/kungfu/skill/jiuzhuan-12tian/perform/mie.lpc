// mie.c 五阴焚灭
    // modify by jzw 2006/1/27  修改伤害

#include <ansi.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
	string msg;
        int ap, dp;
          int damage;   
 
	if (! target) target = offensive_target(me);

	if (! target || ! me->is_fighting(target))
	        return notify_fail("五阴焚灭只能在战斗中对对手使用。\n");

        if (!me->query("zhuanshi/times") > 9)
              return notify_fail("你还没有到达十转，不能使用九转十二天！\n");

        if ( me->query_temp("do_mie"))
              return notify_fail("你正在施展五阴焚灭。\n");

	if (me->query_skill("jiuzhuan-12tian", 1) < 1000)
		return notify_fail("你的阴阳九转十二重天还不够娴熟，不能使用五阴焚灭！\n");

	if (me->query("neili") < 300)
		return notify_fail("你的真气不够！\n");

        msg = HIC "$N" HIC "暴喝一声，变掌为爪，迅捷无比的袭向$n！\n";

        ap = me->query_skill("jiuzhuan-12tian",1)+me->query_skill("dodge",1);
        ap=ap*3/2;
        dp = target->query_skill("jiuzhuan-12tian",1)+target->query_skill("dodge",1);

	me->add("neili", -6000);
	me->start_busy(1 + random(2));

	me->want_kill(target);
        if (random(ap)/2 <= dp)
        {
                msg += HIC "$n" HIC "知道来招不善，小心应对，没出一点差错。\n" NOR;
        damage = me->query_skill("jiuzhuan-12tian", 1) * 3 / 2;
        damage += random(damage / 2);
        me->receive_damage("qi", damage/2);
        me->receive_wound("qi", damage/2);
        me->receive_damage("jing", damage/2);
        me->receive_wound("jing", damage/2);
        me->receive_damage("qi", damage/4);
        me->receive_wound("qi", damage/4);  
        } else
        if (random(ap) > dp)
        {
                msg += HIR "这一招完全超出了$n" HIR "的想象，被$N"
                       HIR "结结实实的抓中了气海穴，浑身真气登时涣散！\n" NOR;
                message_combatd(msg, me, target);
                //  target->die(me);
                // by jzw 一招die，命中判断不合理，而且施招对自身无伤害
        damage = me->query_skill("jiuzhuan-12tian", 1) * 3 / 2;
        damage += random(damage / 2);
        target->receive_damage("qi", damage*2);
        target->receive_wound("qi", damage*2);
        target->receive_damage("jing", damage*2);
        target->receive_wound("jing", damage*2);
        me->receive_damage("qi", damage*4);
        target->receive_wound("qi", damage*4);
                return 1;
        } else
        {
                msg += HIM "$n" HIM "大吃一惊，连忙胡乱抵挡，居"
                      "然没有一点伤害，侥幸得脱！\n" NOR;
        }
        message_combatd(msg, me, target);
        me->set_temp("do_mie",1);
        call_out("do_mie", 3, me);        
	return 1;
}

void do_mie(object me)
{
    if (!me)    return;
    if ( me->query_temp("do_mie"))
        me->delete_temp("do_mie");
}
