#include <ansi.h> 
 
inherit F_SSERVER; 
int perform(object me, object target) 
{ 
      int damage, damage2; 
        string msg; 
        object weapon;  
        if (!target ) target = offensive_target(me); 
        if (!objectp(weapon = me->query_temp("weapon")) 
        || (string)weapon->query("skill_type") != "sword") 
        return notify_fail("干啥呀？你手里的剑在哪？？\n"NOR); 
      if (!target || !target->is_character() || !me->is_fighting(target) ) 
        return notify_fail("「神光再现」只能对战斗中的对手使用。\n"); 
      if ((int)me->query_skill("poyang-jian", 1) < 60 ) 
        return notify_fail("你的破阳冷光剑不够娴熟，还使不出「神光再现」。\n"NOR); 
      if ((int)me->query_skill("hanbing-zhenqi", 1) < 60 ) 
        return notify_fail("你的寒冰真气火候不够，「神光再现」不成招式。\n"NOR); 
      if ((int)me->query("max_neili")<400) 
        return notify_fail("你的内力修为不足，无法运足「神光再现」的内力。\n"NOR); 
      if ((int)me->query("neili")<200) 
        { 
        return notify_fail("你现在内力不够，没能将「神光再现」使完！\n"NOR); 
        } 
   msg = HIY"只见$N手中剑光幻作一道金光,寒气逼人倏的罩向$n,\n$n只觉一道金光挟着寒气扑面而来,登时眼前一花，哇的喷出一口鲜血！！\n"NOR; 
   if (random(me->query_skill("poyang-jian"))>target->query_skill("force")/2) 
        { 
                me->start_busy(1); 
                target->start_busy(random(3)); 
                damage = (int)me->query_skill("poyang-jian", 1)*5+(int)me->query_skill("force",1)*2; 
        damage = damage*25 + random(damage); 
                if (damage<target->query("max_qi",1)/8 && me->query("max_neili",1) > target->query("max_neili",1)/2) damage = random (target->query("max_qi",1)/6); 
                if (damage>target->query("max_qi",1)/3) damage = random (target->query("max_qi",1)/4); 
 
                damage2 = (int)me->query_skill("poyang-jian", 1)*5+(int)me->query_skill("force",1)*2; 
                damage2 = damage2*35 + random(damage2); 
                target->receive_damage("qi", damage/2); 
                target->receive_wound("qi", damage); 
 
      msg += HIC"$n还没来得及看清楚$N的剑路就被剑气卷住，狠狠的捱了一招「神光再现」！！\n"NOR; 
                         me->add("neili", -damage/3); 
        } else 
        { 
            me->start_busy(random(3)); 
      msg += HIC"$n心下大急，竟然纵起身形向后翻，狼狈的躲过$N一手杀着！\n"NOR; 
                 me->add("neili", -200); 
        } 
        message_vision(msg, me, target); 
        if(!target->is_fighting(me)) target->fight_ob(me); 
        if(userp(target)) target->fight_ob(me); 
        else if( !target->is_killing(me) ) target->kill_ob(me); 
        return 1; 
}
