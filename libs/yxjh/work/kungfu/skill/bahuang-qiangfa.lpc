// bahuang-qiangfa.c

inherit SKILL;
string perform_action_file(string action) {
  return __DIR__ "bahuang-qiangfa/" + action;
}
mapping *parry_act = ({
  ([ "action": "$n大喝一声，一式 [闪电惊虹] 一振腕间抖出一十七枪，反将对手逼得手忙脚乱。",
  ]),
  ([ "action": "$n不慌不忙，使出 [气吞山河] $v闪动如神迹般往上跳起，幻起漫空枪影.\n"
    "闪动跳跃间，以将对手的招式尽数逼了回去。",
  ]),
  ([ "action": "$n手中$v一抖，隐含风雷之声，如毒龙般直逼$N，登时抢回上风",
  ]),
  ([ "action": "$n双手一回，本已攻出的长枪迅速回防，正好挡住$N的$w.",
  ]),
  ([ "action": "$n长身而起，立即使出 [十面埋伏]　手中$v化做一片光芒护住了自己。",
  ]),
  ([ "action": "$n陡然收枪，枪势由拙化巧，轻巧地将$N的$w架住，挡开。收势，拆招.\n"
    "格击三个动作一气呵成，行如流水，毫无停滞。",
  ]),
  ([ "action": "$n不紧不慢。一招「冲锋陷阵」，左脚跃步落地，$v顺势往前，挟风声挑开了$N的$w",
  ]),
  ([ "action": "$n连忙使出 [金戈铁马]。 手中$v带着千军万马的气势如游龙般磕开了$N的$w",
  ]),
  ([ "action": "$n大喝一声，不退反进，使出 [玉石俱焚]　不顾一切刺向$N。$N只好回身自保。",
  ]),

});


mapping *unarmed_parry_act = ({
  ([ "action": "$n大喝一声，一式 [闪电惊虹] 一振腕间抖出一十七枪，反将对手逼得手忙脚乱。",
  ]),
  ([ "action": "$n不慌不忙，使出 [气吞山河] $v闪动如神迹般往上跳起，幻起漫空枪影.\n"
    "闪动跳跃间，以将对手的招式尽数逼了回去。",
  ]),
  ([ "action": "$n手中$v一抖，隐含风雷之声，如毒龙般直逼$N，登时抢回上风",
  ]),
  ([ "action": "$n双手一回，本已攻出的长枪迅速回防，正好挡住了$N",
  ]),
  ([ "action": "$n长身而起，立即使出 [十面埋伏]　手中$v化做一片光芒护住了自己。",
  ]),
  ([ "action": "$n陡然收枪，枪势由拙化巧，轻巧地将$N的$w架住，挡开。收势，拆招.\n"
    "格击三个动作一气呵成，行如流水，毫无停滞。",
  ]),
  ([ "action": "$n不紧不慢。一招「冲锋陷阵」，左脚跃步落地，$v顺势往前，挟风声逼开了$N",
  ]),
  ([ "action": "$n连忙使出 [金戈铁马]。 手中$v带着千军万马的气势如游龙般逼开$N",
  ]),
  ([ "action": "$n大喝一声，不退反进，使出 [玉石俱焚]　不顾一切刺向$N。$N只好回身自保。",
  ]),

});


mapping *action = ({
  ([ "action": "$N狂喝一声，展开霸皇枪法中的一式「闪电惊虹」手中$w化做七道闪电向$n连续刺去。",
    "damage": 30,
    "force": 30,
    "parry": -20,
    "dodge": -20,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一式［气吞山河］行如流水地逼前两步，长枪紧贴腰身，身子急旋，借转动之力由。\n"
    "急刺变为横扫，直取$n的$l。",
    "damage": 35,
    "force": 35,
    "parry": -15,
    "dodge": -15,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N杀得性起，手中$w使出 [九天雷霆] 滔滔不绝地从各个意想不到的角度狂攻向$n的$l",
    "damage": 40,
    "force": 40,
    "parry": 0,
    "dodge": 0,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N双手一振，$w惊艳般的亮起，如流星般划过长空，以不可思议的速度，带起一股无可\n"
    "匹敌的气势，直刺$n的$l，正是霸皇枪法中的一式杀手 [一夫当关]",

    "force": 45,
    "damage": 45,
    "dodge": 5,
    "parry": 5,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N身随枪转，全身隐没在一片枪影之中，突然侧身一滚，左手紧握枪尾，以枪头撞地，随\n"
    "即弹起，长枪只取对方咽喉。此招先守后攻，招中藏招，正是 [十面埋伏]",
    "damage": 50,
    "force": 50,
    "parry": 10,
    "dodge": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N突然使出 [四面楚歌] 枪枪如羚羊挂角，无迹可寻，直取$n的$l。",
    "damage": 60,
    "force": 60,
    "parry": 15,
    "dodge": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N嘿然冷笑，手中$w化巧为拙，大刀阔斧地攻出几枪，产生出一种有\n"
    "如冲杀于千军万马之中的惨烈气势，却是霸皇枪中的一招  [冲锋陷阵]",
    "damage": 65,
    "force": 50,
    "parry": 20,
    "dodge": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N神情凝肃，气象森严，脚下中宫直进，手中$w以一式 [金戈铁马] \n"
    "仿似带着千军万马浴血沙场的无匹气势，如毒龙般地向$n刺了过去。",
    "damage": 70,
    "force": 50,
    "parry": 15,
    "dodge": 25,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N舌锭春雷，大喝一声，掌中$w挟雷霆万钧之威，仿似破开十重青天，\n"
    "以迅雷不及掩耳，急电不及闭目之势，自云外直击而下! 此招正是霸皇\n"
    "枪中威力最大的一式 [玉石俱焚]。",
    "damage": 80,
    "force": 80,
    "parry": 30,
    "dodge": 30,
    "damage_type": "刺伤"
  ]),
});
int query_rate(object me) { return 0; }
mapping query_parry_action(object weapon) {
  if (weapon)
    return parry_act[random(sizeof(parry_act))];
  else
    return unarmed_parry_act[random(sizeof(unarmed_parry_act))];


}

int valid_learn(object me) {
  object weapon;
  if ((int)me->query("max_neili") < 3000)
    return notify_fail("你的内力太低了，练不了霸皇枪法。\n");
  if (me->query_str() <= 15)
    return notify_fail("枪你都拿不稳，还谈什么练霸皇枪法？去练练臂力吧！\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你必须先找一杆长枪或者长矛，才能学枪法。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "spear") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你必须先找一杆长枪或者长矛，才能练枪法。\n");

  if ((int)me->query("kee") < 20)
    return notify_fail("你的体力不够练这门枪法法，还是先休息休息吧。\n");
  me->receive_damage("kee", 20);
  return 1;
}
