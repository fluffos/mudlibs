//hanbing-zhenqi
//quest 2010 7 11
#include <ansi.h> 
inherit FORCE;
mixed hit_ob(object me, object victim, int damage_bonus, object target) 
{ 
    int skill = me->query_skill("hanbing-zhenqi",1)*5; 
    if( skill < 1 ) skill = 1; 
      { 
      victim->receive_wound("qi", (damage_bonus*skill )/2); 
      victim->receive_wound("jing", (damage_bonus*skill /2)); 
      victim->add("neili", -(int)me->query("jiali")); 
      victim->apply_condition("ice_poison", random(me->query_skill("songshan-sword")/10) + 1 + victim->query_condition("ice_poison"));
      return HIW "$N眼中闪烁着蔚蓝之色，招式中带出一股似有似无的 "BLINK HIB"寒气"NOR HIW" 封住了$n的"HIR"血脉"HIW"！！\n" NOR; 
      } 
} 
 
int valid_enable(string usage)  
{  
        return      usage=="force"; 
 
} 
int effective_level() { return 21; } 

