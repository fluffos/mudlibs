        "force" : 180,
        "lvl" : 155,
        "skill_name" : "招法一变",
        "damage_type":  "刺伤"
]),
([      "action":"$N身形转了几转，移步到$n的身边手中$w狠狠向$l刺去。",
        "force" : 190,
        "lvl" : 180,
        "skill_name" : "转了几转",
        "damage_type":  "刺伤"
]),
([      "action":"$N一声冷笑，蓦地里疾冲上前，一瞬之间，与$n面对面而立，$w随即递出向$l刺去。",
        "force" : 140,
        "lvl" : 200,
        "skill_name" : "疾冲上前",
        "damage_type":  "刺伤"
]),
([      "action":"$N大声喝道：“来的好！”，直直递出$w刺向$n的$l",
