        "lvl" : 250,
        "skill_name" : "向后疾退",
        "damage_type":  "刺伤"
]),
([      "action":"$N蓦地冲到$n面前，手中$w直刺$n右眼！$n慌忙招架，不想$N的$w突然转向$n的$l",
        "force" : 200,
        "lvl" : 300,
        "skill_name" : "直刺右眼",
        "damage_type":  "刺伤"
]),
([      "action":"$N飞身跃起，$n抬眼一望，但见得$N从直落而下，手中$w刺向$n的$l",
        "force" : 340,
        "lvl" : 350,
        "skill_name" : "飞身跃起",
        "damage_type":  "刺伤"
]),
([      "action":"$N剑招一变，$n眼前剑光一片，$N手中$w顺势刺向$n",
        "force" : 380,
        "lvl" : 400,
        "skill_name" : "剑招一变",
        "damage_type":  "刺伤"
]),
});

int valid_enable(string usage) 
{ 
    return usage == "sword" || usage == "dodge" || usage == "parry"; 
}
string query_parry_msg(object me,object weapon)
{
    string msg;
    object my_weapon;

    if (!(my_weapon=me->query_temp("weapon"))){
        if (!(my_weapon=me->query_temp("secondary_weapon")))
          return "";
     }else{
        if (!valid_enable(my_weapon->query("skill_type"))){
            if (!(my_weapon=me->query_temp("secondary_weapon")))
                  return "";
            else            
                if (!valid_enable(my_weapon->query("skill_type")))
                  return "";
        }
    }
    if (weapon)
        msg=weapon_vs_weapon_msg[random(sizeof(weapon_vs_weapon_msg))];
    else
        msg=unarmed_vs_weapon_msg[random(sizeof(unarmed_vs_weapon_msg))];
    msg=replace_string( msg, "$i", my_weapon->name() );
    return msg;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
    mapping a_action;
    int i, level;
    level   = (int) me->query_skill("kuihuasword", 1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]){
                        a_action = action[NewRandom(i, 20, level/5)];
                        break;
                }
    a_action["dodge"]  = 0-level*35;
    a_action["parry"]  = 0-level*35;
    a_action["attack"]  = level*25;
    a_action["damage"] = level*gongji;
    if (me->query_temp("action_flag"))
        me->set_temp("action_msg","紧跟着");
    return a_action;

}
string query_dodge_msg(string limb,object me)
{
        me->set_temp("fight/dodge",5*me->query_skill("kuihuasword",1));
        return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me)
{
        return notify_fail("葵花剑法只能通过研习《葵花宝典》来学习。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 110 ) return 0;
      if( me->query("neili") < 50000   ) return 0;
      if( random(10) < 2   ) return 0;

 //  第六等级的伤气
      if( me->query_skill("kuihuasword",1)>3000) 
        {
        victim->receive_damage("qi", (damage_bonus ) * 5 , me);
                                return WHT  "$N的葵花剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
                        }      
 //  第五等级的伤气
      if( me->query_skill("kuihuasword",1)>2000)
                        {
        victim->receive_damage("qi", (damage_bonus ) * 3 , me);
                                return YEL "$N的葵花剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
                        }      
      if( damage_bonus < 100 ) return 0;

 //  第四等级的伤气
        if( me->query_skill("kuihuasword",1)>1000)
                                {
        victim->receive_damage("qi", (damage_bonus ) * 2  , me);
                                return MAG "$N的葵花剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
                        } 

 //  第三等级的伤气
        if( me->query_skill("kuihuasword",1)>500)
        {
        victim->receive_wound("qi", (damage_bonus - 100) , me);
                                return CYN "$N的葵花剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
                        }      
 // 第二等级的伤气
        if ( me->query_skill("kuihuasword",1)>300)
                        {
         victim->receive_wound("qi", (damage_bonus - 100) /2 , me);
                                return RED "$N的葵花剑法已初有小成,带出一小阵"HIR"剑气"HIW"扑向$n！！！！！\n" NOR;
                                }
}

// 葵花剑法的特殊攻击
void do_interlink(object me, object victim)
{
    int skill,i,j;
    object *enemy;
    
    skill=me->query_skill("kuihuasword", 1);
    if (skill>1000)
                {
        enemy=me->query_enemy();
        if (!sizeof(enemy)) return;
// 对所有敌人均自动进行攻击
        for (i=0;i<sizeof(enemy);i++){
            for (j=0;j<(skill/(20*sizeof(enemy)));j++)
                if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("qi")>0 ){
                    if (environment(me) == environment(enemy[i]))
                     {
                   me->add_temp("str",skill/10);
                   me->add_temp("dex",skill/10);
                        COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_REGULAR);
                     }
                }else break;
        }
         me->delete_temp("str");
         me->delete_temp("dex");
    }
}


