// kuihuasword.c 葵花剑法
inherit SKILL;

#include <combat.h>
int gongji = this_player()->query_skill("kuihuasword",1)*15;
string *dodge_msg = ({
        "突然间$n向后一跃丈余，躲过了$N这一招。\n",
        "$n身形转了几转，移步到$N的身边，躲过了$N这一招。\n",
        "$N只见到$n身形一幌，$n已经近在咫尺。\n",
        "$N眼前$n身形快速移动，无奈$n随意躲开了$N的招数。\n",
        "$n突然上步，躲过了$N这一招。\n",
});
// 双方均有武器
string *weapon_vs_weapon_msg = ({
        "只听见「锵」一声，被$p用手中$i轻轻荡开。\n",
        "$n手中$i搭在$N手中的$w，$N顿时感觉$w已经不受控制了。\n",
        "只见$n不退反进迎刃而上，手中$i迅速无比地刺向$N胸口，巧妙避开$w。\n",
        "但是$n身子一侧，紧跟着用手中$i把$w拨开。\n",
        "但是$n手中兵刃一侧，$w顺$i划开。\n",
});
// 攻击方无武器,招架方有武器
string *unarmed_vs_weapon_msg = ({
        "$n手臂回转，在$N手肘下一推，顺势闪到一旁。\n",
        "$n手中$i突然刺向$N的胸口，逼迫$N慌忙闪避。\n",
});


mapping *action = ({
([      "action":"突然间$N挺身而上，冲到$n的身边手中$w捅向$n的$l",
