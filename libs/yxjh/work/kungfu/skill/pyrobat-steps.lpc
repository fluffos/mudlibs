#pragma save_binary
// pyrobat-steps.c

inherit SKILL;

mapping *dodge_act = ({
  ([ "action": "但是$n身形飘忽，一招 『青蝠在天』,一纵八尺高，早已避开。\n",
  ]),
  ([ "action": "$n身随意转，一招 『曳蝠转身』 倏地往一旁挪开了三尺，避过了这一招。\n",
  ]),
  ([ "action": "可是$n一招 『火蝠旋翼』 侧身一让，$N这一招扑了个空。\n",
  ]),
  ([ "action": "却见$n一招 『轻蝠点梢』 足不点地，往旁窜开数尺，躲了开去。\n",
  ]),
  ([ "action": "$n一招 『灵蝠覆地』 身形微晃，有惊无险地避开了$N这一招。\n"
  ]),
});
int query_rate(object me) { return 0; }
int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  return 1;
}

mapping query_dodge_action() {
  return dodge_act[random(sizeof(dodge_act))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力太差了，不能练火蝠身法。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力力太差了，不能练火蝠身法。\n");
  me->receive_damage("kee", 25);
  me->add("force", -10);
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("fighter") + "/pyrobat-steps/" + action;
}
