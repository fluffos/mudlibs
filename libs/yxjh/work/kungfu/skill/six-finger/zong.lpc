#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

#define ZONG "「" HIM "纵横天下" NOR "」"

int perform(object me, object target)
{
        string msg;
        int ap, dp;
        int damage, skill;

        if (! target) target = offensive_target(me);
        
/*
        if (userp(me) && ! me->query("can_perform/six-finger/zong"))
                return notify_fail("你所使用的外功中没有这种功能。\n");
*/
	if( !target || !target->is_character() || target == me ||	
	  	!me->is_fighting(target) )
		return notify_fail(ZONG"只能对战斗中的对手使用。\n");

	if ((int)me->query_skill("kuihua-xinfa", 1) > 100)
		return notify_fail(HIY "你感觉气息不顺，使不出"ZONG"！\n" NOR);

	if ( (string)me->query_skill_mapped("force") != "kumu-shengong" ||
		(int)me->query_skill("kumu-shengong", 1) < 500 ||
		me->query("family/family_name") != "大理段家" )
		return notify_fail("你的枯木神功修为不够，无法使用"+ZONG+"。\n");

	if (me->query_skill_prepared("finger") != "six-finger" && me->query_skill_prepared("unarmed") != "six-finger")
		return notify_fail("你没有准备使用六脉神剑，无法施展" ZONG "。\n");

	skill = me->query_skill("six-finger", 1);

    if (skill < 1500)
            return notify_fail("你的六脉神剑修为有限，无法使用" ZONG "！\n");

    if (me->query_skill("force") < 10000)
            return notify_fail("你的内功火候不够，难以施展" ZONG "！\n");

    if (me->query("max_neili") < 15500)
            return notify_fail("你的内力修为不够,无法施展" ZONG "！\n");

    if (me->query("neili") < 2000)
            return notify_fail("你的真气不够，现在无法施展" ZONG "！\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
            return notify_fail("你必须是空手才能施展" ZONG "！\n");

    if (! living(target))
            return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIM "$N" HIM "一声清啸，六脉剑气挥洒而出，此起"
            "彼伏、连绵不绝。霎时剑气如奔，万道剑气豁然贯向$n" HIM 
            "！\n" NOR;

	if((int)target->query_skill("kuihua-xinfa") > 100)
		ap = me->query_skill("finger")+me->query_skill("force");
	else
		ap = me->query_skill("finger",1)+me->query_skill("force",1);

	if((string)me->query_skill_mapped("dodge") == "duanshi-shenfa")
		ap += me->query_skill("duanshi-shenfa",1) / 2;

	dp = target->query_skill("parry",1) + target->query_skill("force",1);

	if ( random (10) == 1 )
	{
        me->add("neili", -600);
        me->start_busy(3);
        msg += HIY "但见$n" HIY "会心一笑，轻拂衣袖，轻易的躲过这一招！\n"NOR;
    }
	else if (ap * 11 / 20 + random(ap) > dp)
    { 
        damage = me->query_skill("six-finger",1)*2 + me->query("jiali")/50;
        me->add("neili", -2000);
        msg += HIR "只听$n" HIR "一声惨叫，万道剑气已"
				"透体而过，伤口处鲜血顿时狂涌，痛苦难当！\n" NOR;

		target->receive_wound("qi",damage/2);
		target->receive_damage("qi",damage/2);

        me->start_busy(2);
    } else
    {
        me->add("neili", -400);
        me->start_busy(3);
        msg += CYN "$n" CYN "见$N" CYN "来势汹涌，不敢轻易"
                "招架，急忙提气跃开。\n" NOR;
	}

	message_combatd(msg, me, target);

	return 1;
}


