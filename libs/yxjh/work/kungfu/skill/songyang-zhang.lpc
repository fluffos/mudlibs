//      songyang-zhang.c
//      2010-7-7
//      quest
//      嵩阳掌
inherit SKILL;
mapping *action = ({
([      
                "name":    "诡异",
                "action": "$N脸上露出诡异的笑容，隐隐泛出蔚蓝色的双掌扫向$n的$l。",
                "force": 30,
        "damage_type": "瘀伤"
]),
([      
                                "name":    "寒气缠身",
                                "action": "$N突然寒气缠身，身形旋转起来扑向$n，双掌携着寒风飞舞着拍向$n的$l。",
                                "force": 40,
        "damage_type": "瘀伤"
]),
([  
                                "name":    "嵩阳再现",
                                "action": "$N将寒气运至右手，一招「嵩阳再现」寒气无比，重重的拍向$n的$l。",
                                "force": 70,
                "damage_type": "瘀伤"
]),
([
                          "name":    "寒冰气",
                          "action": "$N双掌挟着一股寒冰之气拍向$n的$l。",
                          "force": 100,
                "damage_type": "瘀伤"
]),
([              
                                "name":    "寒气四射",
                                "action": "$N旋风般的转身，寒气四射，单掌射出一股寒冰之气拍向$n的$l。",
                "force": 130,
                "damage_type": "瘀伤"
]),
([      "name":    "五岳华盖",
                                "action": "$N双掌以上一下，一招「五岳华盖」运起全身寒冰之气拍向$n的$l。",
                "force": 160,
                "damage_type": "瘀伤"
]),
([  
                                "name":    "寒冰风霜",                  
                                "action": "$N趁$n立足未稳，合丹田气混元气，蔚蓝色的寒气的双掌直直拍向$n的$l。",
                "force": 200,
                "damage_type": "瘀伤"
]),
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }
int practice_level()
                {
                           return 180;
                         } 
mapping query_action(object me, object weapon)
{
    mapping ran_action;
    int level = me->query_skill("songyang-zhang",1);
        if (random(10)>5)
        return ([  "action": "$N调动内息，双眼蓝光四射急速施展「"+RED+"嵩阳寒冰掌"+NOR+"」推向$n的$l。",
                    "damage": level*10,
                    "attack": level*3,
                    "force": level*5,
                    "dodge": 0 - 5 * level,
                    "damage_type": "瘀伤",
                ]);
    else{
        ran_action=action[random(sizeof(action))];
        ran_action["dodge"]= 0 - level;
        ran_action["force"]= level*4;
        ran_action["damage"]= level*3;
        ran_action["attack"]= level*2;
        }
    return ran_action;
}
int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练大嵩阳掌必须空手。\n");
    if ((int)me->query_skill("hanbing-zhenqi", 1) < 10)
        return notify_fail("你的寒冰真气火候不够，无法练大嵩阳掌。\n");
    if ((int)me->query("max_neili") < 60)
        return notify_fail("你的内力太弱，无法练大嵩阳掌");
    if (me->query_skill("unarmed", 1) <=me->query_skill("songyang-zhang", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    return 1;
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 30)
        return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 8)
        return notify_fail("你的内力不够练大嵩阳掌。\n");
    if (me->query_skill("songyang-zhang", 1) < 50)
        me->receive_damage("qi", 20);
    else
        me->receive_damage("qi", 30);
    me->add("neili", -5);
    return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        if( random(me->query_skill("hanbing-zhenqi")) > 10 ) 
    {
    victim->apply_condition("ice_poison", random(me->query_skill("hanbing-zhenqi")*10) + 1 +
    victim->query_condition("ice_poison"));
    }
}
string perform_action_file(string action)
{
    return __DIR__"songyang-zhang/" + action;
}

