// wangxiang-fufa 妄想斧法 
// marry 99.8
#include <ansi.h>
inherit SKILL;

mapping *action = ({
        ([ "name":   "盘古开天",
           "action": "$N一式「盘古开天」无华地劈往$n的$l。",
           "force": 50,
           "dodge":  -10,
           "damage": 100*35,
           "lvl"   : 0,
           "damage_type":  "劈伤"
        ]),
        ([ "name":   ""HIM"披荆斩棘"NOR"",
           "action": "只见$N一招「披荆斩棘」手中$w画着十字向$n劈去。",
           "force":  250,
           "dodge":  -1,
           "damage": 250*35,
           "lvl"   : 150,
           "damage_type":  "劈伤"
        ]),
});

mapping *action2 = ({
        ([ "name":   ""HIG"班门弄斧"NOR"",
           "action": "$N脸上神色一变，使出一招「"HIM"班门弄斧"NOR"」，手中$w如
雨点般舞向$n的$l",
     "force" : this_player()->query_skill("wangxiang-fufa",1)/2,
     "dodge" : this_player()->query_skill("dodge",1)/4,
     "parry" : this_player()->query_skill("parry",1)/2,
           "lvl"   : 250,
           "damage_type":  "劈伤"
        ]),
        ([ "name":   ""HIB"鬼斧神工"NOR"",
           "action": "$N手中$w飞速旋转，一招「"HIY"鬼斧神工"NOR"」狠狠地劈向$n。",
     "force" : this_player()->query_skill("wangxiang-fufa",1)/2,
     "dodge" : this_player()->query_skill("dodge",1)/4,
     "damage" : this_player()->query_skill("wangxiang-fufa",1)*35,
     "parry" : this_player()->query_skill("parry",1)/2,
           "lvl"   : 350,
           "damage_type":  "劈伤"
        ]),
        ([ "name":   ""WHT"乘风破浪"NOR"",
           "action": "$N忽然曲臂蓄力，$N一式「"WHT"乘风破浪"NOR"」，手中$w陡然劈向$n的$l。",
     "force" : this_player()->query_skill("wangxiang-fufa",1)/2,
     "dodge" : this_player()->query_skill("dodge",1)/4,
     "damage" : this_player()->query_skill("wangxiang-fufa",1)*35,
     "parry" : this_player()->query_skill("parry",1)/2,
           "lvl"   : 400,
           "damage_type":  "劈伤"
        ]),
 });


int valid_enable(string usage) { return usage=="axe" ||  usage=="parry"; }
int valid_learn(object me)
{
        object weapon;
        int lvl = (int)me->query_skill("wangxiang-fufa", 1);
        int t = 1, j;
        if (lvl<=100)
                for (j = 1; j < lvl / 10; j++)
                        t*=2;
        if ( me->query("gender") != "男性" )
                return notify_fail("你又不是男人练什么妄想斧法？\n");
        if ((me->query("family/master_id")!="xiao jin")&&
            (me->query("family/master_id")!="chu huan")&&  
            (me->query("family/master_id")!="xuanyuan liang"))
                return notify_fail("非本门亲授弟子无法学习。\n");

        if(lvl<=100)
        {
                if (lvl > 10 && (int)me->query("shen") < t * 100) 
                        return notify_fail("你的侠义正气太低了。\n");
        }
        else
        {
                if ((int)me->query("shen") < (51200 + (lvl - 100) * 1000)) 
                        return notify_fail("你的侠义正气太低了。\n");
        }

        if( (int)me->query("max_neili") < 500 )
                return notify_fail("你的内力不足，没有办法练妄想斧法, 多练些内力再来吧。\n");

        if ((int)me->query_skill("axe", 1) < 50)
                return notify_fail("你的基本斧法火候太浅。\n");

        if ( !objectp(weapon = me->query_temp("weapon"))
        || ( string)weapon->query("skill_type") != "axe" )
                return notify_fail("你必须先找一柄斧头才能练斧法。\n");

        return 1;
}


mapping query_action(object me, object weapon)
{
        int i, level;
          mapping a_action;
        level   = (int) me->query_skill("wangxiang-fufa",1);
          //me = this_player();

	

        if (me->query_skill("wangxiang-fufa",1)<501)  
		a_action = action[random(sizeof(action))];
 
        if (me->query_skill("wangxiang-fufa",1)>500
        && me->query("jym_level/level")>=2)
		a_action = action2[random(sizeof(action2))];

        if (me->query_skill("wangxiang-fufa",1)>500
          && me->query("jym_level/level")<2)
		a_action = action[random(sizeof(action))];

	a_action["damage"] = level*35;
	return a_action;
}

int practice_skill(object me)
{
        object* ob, obj;
        int i,skill,damage;
        if ((me->query("family/master_id")!="xiao jin")&&
            (me->query("family/master_id")!="chu huan")&&  
            (me->query("family/master_id")!="xuanyuan liang"))
                return notify_fail("非本门亲授弟子无法练习。\n");

        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 50)
                return notify_fail("你的内力不够练妄想斧法！\n");
        if( skill > 100 && me->query("shen") < 1)
                return notify_fail("这种武功当得行侠义事。\n");
        me->receive_damage("qi", 40);
        me->add("neili", -30);
        return 1;
}
                                          
mixed hit_ob(object me, object victim, int damage_bonus)
{
    if( damage_bonus < 150 ) return 0;

        if( me->query_skill("wangxiang-fufa",1)>500
       && me->query("jym_level/level")>=2
&& (me->query("neili")*3) > victim->query("max_neili") ) {
                victim->receive_wound("qi", (damage_bonus - 100) / 6 , me);
return HIR "只听到「"HIY""BLINK"砰"NOR""HIR"」的一声巨响，$w"HIR"竟然深深陷入皮肉！\n" NOR;
  }
}
string perform_action_file(string action)
{
        return __DIR__"wangxiang-fufa/" + action;
}
