//inherit SSERVER;
int exert(object me, object target) {
  int n, q;
  if (me != target)
    return notify_fail("「神元归一」只能对自己使用。\n");
  if ((int)me->query("neili") < (int)me->query("max_neili") / 2)
    return notify_fail("你的内力不够。\n");
  //         if ((int) !me->query("guiyi")) 
  //        return notify_fail("你没有领悟到神元功精华所在，无法施展「神元归一」。\n");
  if ((int)me->query("eff_qi") >= (int)me->query("max_qi") / 5)
    return notify_fail("你体力未衰，何苦耗尽内力施展「神元归一」？\n");
  if ((int)me->query_skill("shenyuan-gong", 1) < 2000)
    return notify_fail("你的神元功尚未达到化境，强行施展「神元归一」只怕会走火入魔！\n");
  if ((string)me->query("family/family_name") != "姑苏慕容")
    return notify_fail("只有幕容世家弟子才可以领悟元神功妙处。\n");
  me->set("eff_jing", me->query("max_jing"));
  me->set("max_jing", me->query("max_jing"));
  me->set("jing", me->query("max_jing"));
  me->set("eff_qi", me->query("max_qi"));
  me->set("max_qi", me->query("max_qi"));
  me->set("qi", me->query("max_qi"));
  me->set("qi", me->query("max_qi"));
  me->add("neili", -(int)me->query("max_neili") / 2);
  me->add("max_neili", -500);
  me->set("no_poison", 1);
  message_vision(HIR "$N为求保得一命，冒险施展「神元归一」绝顶内功....\n\n只见$N怀抱阴阳，全身内力疾吐而出，刹那间全身被一阵金色光芒环环绕住。\n\n", me);
  if (me->is_fighting()) me->start_busy(5);
  me->improve_skill("shenyuan-gong", random(me->query_skill("force", 1)));
  return 1;
}
