#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
void remove_effect(object me, int a_amount, int d_amount);
inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon,ob;
        int skill;
        string msg;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「必杀剑」绝技只能在战斗中使用。\n");
        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                return notify_fail("「必杀剑」绝技必须用剑才能施展。\n");
          if( (int)me->query_skill("bisha-jian", 1) < 300 )
                  return notify_fail("你的「必杀剑」不够娴熟。\n");
        if( (int)me->query("neili") < 500  ) 
                return notify_fail("你的内力不够。\n");
  skill = me->query_skill("bisha-jian");
 msg = HIM "$N一飞冲天，以意御剑，人剑和一，默念必杀剑诀：\n"NOR;
        message_vision(msg, me, target);
        me->clean_up_enemy();
        ob = me->select_opponent();
    msg = HIC"                ☆☆☆ 心 ☆☆☆\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIR"                ☆☆☆ 若 ☆☆☆\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIB"                ☆☆☆ 冰 ☆☆☆\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIG"                ☆☆☆ 清 ☆☆☆\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIC"                ☆☆☆ 天 ☆☆☆\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIR"                ☆☆☆ 塌 ☆☆☆\n"NOR;
/*
        message_vision(msg, me, target);
        message_vision(msg, me, target);
        message_vision(msg, me, target);
        message_vision(msg, me, target);
        message_vision(msg, me, target);
        message_vision(msg, me, target);
        message_vision(msg, me, target);
*/
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIB"                ☆☆☆ 不 ☆☆☆\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    msg = HIG"                ☆☆☆ 惊 ☆☆☆\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        me->add("neili", -300);
  me->start_busy(2);
        return 1;
}
