// kongtong-jueji quest  
inherit SKILL; 
int tydamage=(this_player()->query("tydamage/force")?this_player()->query("tydamage/sword"):this_player()->query_skill("kongtong-jueji"))*10;  
//轻功描述  
string *dodge_msg = ({  
        "似乎$N每一招都能制$n的死命，可是$n总是或反打、或闪避，一一拆解开去。\n",  
        "却见$n一低头，从$N底下扑了上去，左臂随势格向$n的右臂。\n",  
        "那知$n身形一幌，轻轻巧巧地避过了$N的攻击。\n",  
        "$n飞起右足，踢向$N手腕，一招「叶底飞燕」反攻为守。\n"  
        "只见$n施展崆峒武技，婀娜多姿好似舞蹈。\n",  
        "只见$n身影滴溜溜地一转，体迅飞鸟，飘忽若神，施展的正是崆峒武技。\n",  
        "$N只觉得眼前一花，头脑发昏，只觉得四面都是$n的身影飘飘兮若流风之回雪！\n",  
        "$n使出「蝶随风飞」，一个空心筋斗向后翻出，避开了$N的凌厉攻势。\n",  
        "$n一招「双香凤蝶」，身随意转，$N只觉眼前一花，$n已绕至$N的身后。\n",  
});  
//都有武器  
string *weapon_vs_weapon_msg = ({  
        "只听见「锵」一声，被$p用手中$i轻轻荡开了。\n",  
        "$n右手伸出，在$N手腕上迅速无比的一按，$N的$w险些击中自己小腹。\n",  
        "不退反进，$n手中$i迅速无比地刺向$N胸口，随即回手拨开$w。\n",  
        "但是$n身子一侧，紧跟着用手中$i把$w拨开。\n",  
        "但是$n手中兵刃一侧，$w顺$i划开。\n",  
        "$n当下一股内力冲向$w，$N击向$n的$w的招数莫名奇妙的溜滑向一旁",     
        "$n意随心动$i轻挥而过，$N手中$w莫名其妙的在中途转了方向，直奔$N而来",  
        "$n手中$i谈笑间竟将$N手中的$w，挡开使得$N不知如何是好",  
});  
// 攻击方无武器,招架方有武器  
string *unarmed_vs_weapon_msg = ({  
        "$n手臂回转，在$N手肘下一推，顺势闪到一旁。\n",  
        "$n手中$i突然指向$N的左眼，$N慌忙闪避。\n",  
        "$n手臂回转，在$N手肘下一推，顺势闪到一旁。\n",  
        "$n手中$i突然刺向$N的胸口，逼迫$N慌忙闪避。\n",  
        "$n将$N一引一带，$n身子轻轻越起，身行落在一旁",  
        "$n左臂搭上$N右臂，右臂使出$N的招数将$N此招化去",  
        "$n身行飘忽不定，在瞬间反用$N的招数击向$N，却令人$N百思不得其解",  
});  
//攻击描述  
string  *msg = ({  
        "$N刷刷刷连出三招，但见$w闪动，犹如蟒蛇吐信一般，三道寒光刺向$n上中下三路",  
        "只见$N强势霸道，得理不让人，又是一招，一道寒光$w闪向$n面门，逼得$n急忙侧头避让",  
        "$N左脚又在$n小腿上一扫，想将$n拌倒，跟着$w一抖，一道寒光扫向$n咽喉",  
        "垫步凝神$N一声冷笑，眼中精光暴涨，手中$w寒光一闪罩向$n$l小腹",  
        "$N一下冲到$n身前，$w突然之间寒光闪烁向罩向$n的面门",  
        "但见$N平心静气，暗运内劲手中$w寒光闪烁，突如其来，又快又急，罩向$n全身大穴",  
        "突然间$N合气发劲一招「长虹千里」，手中$w一道寒光闪烁罩向$n，势道甚是劲急，全无闪避的馀裕。",  
        "只见$N好像要败，转身间露出破绽，突然一招「回风抚柳」手中$w随着身形转动寒光一闪罩向$n$l",  
        "忽然$N一招「祥光再现」，手中$w尖快绝无比带着一道寒光罩向$n的$l",  
        "$N一招「灵舌吐信」，手中$w寒光一闪快绝无比罩向$n的$l",  
        "$N一招「白云出岫」，手中$w一道寒光急急罩向$n的$l",  
        "之间$N脚步突然加速，$n眼前仿佛突然出现了七八个$N，七八道$w寒光一起刺向$n",  
});  
  
int valid_enable(string usage)  
{  
        return usage == "sword" || usage == "parry" || usage == "dodge" || usage == "blade" || usage == "throwing";  
}  
  
mapping query_action(object me, object weapon)  
{ 
        int level5 = me->query_level();  
        return ([  
                "action" : msg[random(sizeof(msg))],  
                "damage": 0+tydamage,  
                "dodge" : 0+random(level5),  
                "parry" : 0+random(level5),  
                "force" : 0+random(level5),  
                "damage_type" : random(2)?"刺伤":"割伤",  
        ]);  
}  
  
string query_dodge_msg(string limb,object me)  
{  
     me->set_temp("fight/dodge",random(me->query_skill("kongtong-jueji",1)*5));  
        return dodge_msg[random(sizeof(dodge_msg))];  
}  
string query_parry_msg(object me,object weapon)  
{  
    string msg;  
    object my_weapon;  
  
    if (!(my_weapon=me->query_temp("weapon"))){  
        if (!(my_weapon=me->query_temp("secondary_weapon")))  
          return "";  
     }else{  
        if (!valid_enable(my_weapon->query("skill_type"))){  
            if (!(my_weapon=me->query_temp("secondary_weapon")))  
                  return "";  
            else              
                if (!valid_enable(my_weapon->query("skill_type")))  
                  return "";  
        }  
    }  
    if (weapon)  
        msg=weapon_vs_weapon_msg[random(sizeof(weapon_vs_weapon_msg))];  
    else  
        msg=unarmed_vs_weapon_msg[random(sizeof(unarmed_vs_weapon_msg))];  
    msg=replace_string( msg, "$i", my_weapon->name() );  
    return msg;  
}  
  
mixed hit_ob(object me, object victim, int damage_bonus)  
{  
      if( damage_bonus < 110 ) return 0;  
      if( me->query("neili") < 50000   ) return 0;  
      if( random(10) < 2   ) return 0;  
  
 //  第六等级的伤气  
      if( me->query_skill("kongtong-jueji",1)>9000)  
        {  
              victim->receive_damage("qi", (damage_bonus ) * 8 , me);  
              return WHT  "$N的崆峒绝技已入返璞归真境界，随意一招带着一阵"HIR"崆峒内劲"HIW"扫向$n！！！！！\n" NOR;  
                        }        
 //  第五等级的伤气  
      if( me->query_skill("kongtong-jueji",1)>3000)  
        {  
              victim->receive_damage("qi", (damage_bonus ) *5 , me);  
              return YEL "$N的崆峒绝技已达到炉火纯青的地步，随意一招带着一阵"HIR"崆峒内劲"HIW"扫向$n！！！！！\n" NOR;  
        }        
      if( damage_bonus < 100 ) return 0;  
 //  第四等级的伤气  
      if( me->query_skill("kongtong-jueji",1)>2000)  
        {  
              victim->receive_damage("qi", (damage_bonus - 100) * 2 , me);  
               return MAG "$N的崆峒绝技已达到精益求精的地步，随意一招带着一阵"HIR"崆峒内劲"HIW"扫向$n！！！！！！！！！！\n" NOR;  
        }   
 //  第三等级的伤气  
      if( me->query_skill("kongtong-jueji",1)>1500)  
              {  
              victim->receive_wound("qi", (damage_bonus - 100) , me);  
              return CYN "$N的崆峒绝技已达到大有所成，随意一招带着一阵"HIR"崆峒内劲"HIW"扫向$n！！！！！\n" NOR;  
                        }        
 // 第二等级的伤气  
      if ( me->query_skill("kongtong-jueji",1)>300)  
        {  
             victim->receive_wound("qi", (damage_bonus - 100) / 2 , me);  
             return RED "$N的崆峒绝技已初有小成,带出一阵"HIR"崆峒内劲"HIW"扫向$n！！！！！\n" NOR;  
                                }  
}  
  
void do_interlink(object me, object victim)  
{  
          int skill,i,j;  
    object *enemy;  
      
    skill=me->query_skill("kongtong-jueji", 1);  
    if (skill>500){  
        enemy=me->query_enemy();  
        if (!sizeof(enemy)) return;  
// 对所有敌人均自动进行攻击  
        for (i=0;i<sizeof(enemy);i++){  
            for (j=0;j<(skill/200/(5*sizeof(enemy)));j++)  
                if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("qi")>0 ){  
                    if (environment(me) == environment(enemy[i]))  
                     {  
                   me->add_temp("str",skill/10);  
                   me->add_temp("dex",skill/10);  
                        COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"),);  
                     }  
                }else break;  
        }  
         me->delete_temp("str");  
         me->delete_temp("dex");  
}  
}  
int valid_learn(object me)  
{  
                if ((int)me->query_skill("force", 1) < 200)  
                 return notify_fail("你的内功心法火候不够，无法学蛤蟆神功。\n");  
                if ((int)me->query_skill("kongtong-shengong", 1) < 500)  
                  return notify_fail("你的崆峒神功火候不够，无法学崆峒绝技。\n");  
                if ((int)me->query_skill("kongtong-jueji", 1) > 500)  
                   return notify_fail("你的崆峒绝技已经达到师不可授的地步了，不能继续学习只能闭关提高。\n");  
                if ((int)me->query("neili") < 5500)  
                     return notify_fail("你的内力太弱，无法练崆峒绝技。\n"); 
                                return 1; 
} 
int practice_skill(object me)  
{ 
      return notify_fail("崆峒神功是不能随便什么地方都能练的。\n"); 
}
