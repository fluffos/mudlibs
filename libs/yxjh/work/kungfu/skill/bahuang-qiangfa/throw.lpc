
#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon;
	string msg;
    string * dir;
    object env;
    mixed room;
	mapping exits;	
	int force,weapon_damage,str,damage,my_skill,his_skill;


	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("[龙飞天外] 能对战斗中的对手使用。\n");

	weapon=me->query_temp("weapon");
	if(weapon->query("skill_type")!="spear")
		{
		tell_object("你手中拿的不是枪。你也想用这招？？？\n");
    	tell_object(me,"省省吧！！！");

		if(me->query("gender")=="女性")
			tell_object(me,"娘们儿！！！\n");
		else
			tell_object(me,"爷们儿！！！\n");
		return 1;
		}
    str=me->query_str()*3/2;
        force=me->query("neili");
    weapon_damage=weapon->query("weapon_prop/damage");
    damage=str+force/3+(weapon_damage*3/2);

	message_vision(CYN"$N杀的性起！不顾一切的使出霸皇枪法中惊天动地的 [龙飞天外] \n"
					  "使出全身力气将手中武器奋力朝$n掷去。\n"NOR,me,target);
    weapon->unequip();
    me->reset_action();
        me->set("neili",0);
    me->start_busy(2);   
    my_skill=me->query_skill("bahuang-qiangfa",1);
	his_skill=target->query_skill("dodge");
	if(random(my_skill*4)>=random(his_skill))
		{
		message_vision(HIR"结果$n闪躲不及，"+weapon->name()+"在身上扎了一个鲜血淋淋的口子\n"NOR,me,target);
        weapon->move(target);
        target->receive_damage("qi",damage,me);
		}
	else
		{
		message_vision(CYN"结果$n轻轻松松的躲了开去，"+weapon->name()+"飞的无影无综\n"NOR,me,target);
   env=environment(me);
        exits=env->query("exits");
    if(mapp(exits)){
        dir=keys(exits);
        room=exits[dir[random(sizeof(dir))]];
        if(stringp(room)) load_object(room);
        if(room) weapon->move(room);
        else destruct(weapon);
    }
		}

	return 1;
}
