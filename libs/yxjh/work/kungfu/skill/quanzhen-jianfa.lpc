// quanzhen-jianfa 全真剑法
#include <ansi.h>
inherit SKILL;
int tydamage = this_player()->query("tydamage/sword") ? this_player()->query("tydamage/sword") : this_player()->query_skill("quanzhen-jianfa") * 5;

string type() { return "zhongji"; }
mapping *action = ({
  ([ "action": "$N长剑晃动，踏奇门，走偏锋，一式「" HIM "分花拂柳" NOR "」，刺向$n的腰胁",
    "force": 660,
    "dodge": 480,
    "parry": 340,
    "damage": tydamage,
    "lvl": 0,
    "skill_name": "分花拂柳",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N向前跃上一步，左手剑诀，右手$w使出一式「" HIG "横行漠北" NOR "」直刺$n的$l",
    "force": 660,
    "dodge": 480,
    "parry": 340,
    "damage": tydamage,
    "lvl": 10,
    "skill_name": "横行漠北",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N拔步挺腰，一式「" HIB "排山倒海" NOR "」，手中$w沉滞无比，缓缓挥剑撞向$n的$l",
    "force": 660,
    "dodge": 480,
    "parry": 340,
    "damage": tydamage,
    "lvl": 25,
    "skill_name": "排山倒海",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N身子微侧，$w自左而右划出一个大弧，一式「" HIC "顺水推舟" NOR "」，平平地向$n的$l挥去",
    "force": 660,
    "dodge": 480,
    "parry": 340,
    "damage": tydamage,
    "lvl": 30,
    "skill_name": "顺水推舟",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N回身拧腰，右手虚抱成圆，一式「" HIW "马蹴落花" NOR "」，$w中宫直进，刺向$n的胸口",
    "force": 660,
    "dodge": 480,
    "parry": 340,
    "damage": tydamage,
    "lvl": 50,
    "skill_name": "马蹴落花",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一式「" HIR "开天辟地" NOR "」，$w从上至下猛劈，剑锋直出，挟爆裂之声骤然斩向$n的$l",
    "force": 660,
    "dodge": 480,
    "parry": 340,
    "damage": tydamage,
    "lvl": 70,
    "skill_name": "开天辟地",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N运气施出「" HIB "雷电交加" NOR "」，$w剑尖逼出一道青芒，闪电般破空射向$n的$l",
    "force": 660,
    "dodge": 480,
    "parry": 340,
    "damage": tydamage,
    "lvl": 90,
    "skill_name": "雷电交加",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N双腿半屈半蹲，一式「" HIY "人神共愤" NOR "」，剑尖划出无数圆圈，狂风骤起，笼罩天地",
    "force": 660,
    "dodge": 480,
    "parry": 340,
    "damage": tydamage,
    "lvl": 110,
    "skill_name": "人神共愤",
    "damage_type": "刺伤"
  ]),
});

int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 50000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("force", 1) < 40)
    return notify_fail("你的基本内功火侯太浅。\n");
  if (me->query_skill("sword", 1) <= me->query_skill("quanzhen-jianfa", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if (me->query("family/master_id") != "wang chongyang")
    return notify_fail("全真剑法乃是王重阳的得意武功，你只能找他学习。\n");
  //    if ((int)me->query_skill("quanzhen-jianfa",1) > 300)
  //        return notify_fail("武功还是要靠自己琢磨啊,这套剑法我就教此处，你今后在这套剑法上的成就就要看你自己了。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("quanzhen-jianfa", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];

}

mixed hit_ob(object me, object victim, int damage_bonus) {
  object weap, weap1;
  weap = victim->query_temp("weapon");
  weap1 = me->query_temp("weapon");
  if (damage_bonus < 100) return 0;

  if ((me->query_skill("quanzhen-jianfa") > 450) && (me->query("neili") > 50000)
    && (victim->query_temp("weapon"))
    && random(10) > 7) {
    message_vision(
      HIC "只见$N手中" + weap1->name() + "" HIC "快速飞舞，剑势竟暗合北斗七星阵，将对方的" + weap->name() + "" HIY "笼罩在剑阵之中！\n" NOR,
      me
    );
    victim->start_busy(1);
    if ((me->query_skill("force")) > victim->query_skill("force")) {
      message_vision(HIW "\n剑阵势如破竹逼向$N，只听 乒! 的一声巨响，" + weap->name()
        + "被" + weap1->name() + "" HIW "从$N" HIW "手中直劈成两段，$N" HIW "情急之下只好空手应战。\n" NOR, victim);
      if (weap->query_xy()) {
        weap->add("max_lasting", -100);
        weap->move(victim);
      } else {
        weap->move(environment(me));
        weap->set("name", "断掉的" + weap->query("name"));
        victim->reset_action();
        weap->set("value", 0);
        weap->set("weapon_prop", 0);
        weap->set("long", "一把断掉的武器，从中断开，破口整齐，看来是被绝顶高手一刀劈开的。\n");
      }
    } else {
      message_vision(HIY "\n$N暗运卸字决，" + weap->name()
        + "" HIY "顺着方向快速旋转数下，将" + weap1->name() + "" HIY "上的真劲全数卸去。\n" NOR, victim);
      victim->add("neili", -1000);
    }
    me->add("neili", -(20 + random(30)));
  }
  if (me->query("neili") < 50000) return 0;
  if (random(10) < 2) return 0;

  //  第六等级的伤气
  if (me->query_skill("quanzhen-jianfa", 1) > 4000
    && me->query("jym_level/level") >= 25) {
    victim->receive_damage("qi", (damage_bonus) * 2, me);
    return WHT "$N体内的天罡正气与剑招中发出的一剑化三清融合为一，化做一股混元真力震碎了$n的心脉！！！\n" NOR;
  }

  //  第五等级的伤气
  if (me->query_skill("quanzhen-jianfa", 1) > 3000
    && me->query("jym_level/level") >= 15) {
    victim->receive_damage("qi", damage_bonus, me);
    return YEL "$N的全真剑法已到第五等级，一剑随意挥出,如生了眼睛一般扑向$n！！！！！\n" NOR;
  }
  if (damage_bonus < 100) return 0;

  //  第四等级的伤气
  if (me->query_skill("quanzhen-jianfa", 1) > 2000
    && me->query("jym_level/level") >= 10) {
    victim->receive_damage("qi", (damage_bonus - 100), me);
    return MAG "$N的全真剑法已到第四等级，配合天罡正气舞出七星阵罩住$n！！！！！\n" NOR;
  }

  //  第3等级的伤气
  if (me->query_skill("quanzhen-jianfa", 1) > 1000
    && me->query("jym_level/level") >= 4
    && (me->query("neili") * 3) > victim->query("max_neili")) {
    victim->receive_damage("qi", (damage_bonus - 100) / 3, me);
    return CYN "$N的全真剑法已入返璞归真境界，随意一招带出无数劲气扑向$n！！！！！\n" NOR;
  }
  // 第二等级的伤气
  if (me->query_skill("quanzhen-jianfa", 1) > 200
    && me->query("jym_level/level") >= 2) {
    victim->receive_damage("qi", (damage_bonus - 100) / 8, me);
    return RED "$N暗暗运功将天罡正气混入全真剑法发出阵阵剑气攻向$n！！！\n" NOR;
  }
}

int practice_skill(object me) {
  return notify_fail("全真剑法只能通过「" + HIC + "七星决" + NOR + "」来提升。\n");
}

string perform_action_file(string action) {
  return __DIR__ "quanzhen-jianfa/" + action;
}
