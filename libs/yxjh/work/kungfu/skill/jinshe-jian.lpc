// jinshe-jian.c

#include <ansi.h>
inherit SKILL;
string type() { return "zhongji"; }

int tydamage = (this_player()->query("tydamage/unarmed") ? this_player()->query("tydamage/unarmed") : this_player()->query_skill("jinshe-jian")) * 5;

mapping *action = ({
  ([ "name": "金光蛇影",
    "action": "$N使一招「金光蛇影」，手中的$w在一弹指间已向$n的$l连刺数剑",
    "dodge": 50,
    "parry": 100,
    "force": 170,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "name": "蛇影万道",
    "action": "$N使一招「蛇影万道」，手中$w狂风骤雨般地向$n的$l连攻数剑",
    "dodge": 100,
    "parry": 200,
    "force": 200,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
});

mapping *action2 = ({
  ([ "name": "雪地飞蛇",
    "action": "$N身形一转，陡地贴地跃起，手中$w灵动夭跃，一招「" HIY "雪地飞蛇" NOR "」疾刺$n的$l",
    "force": 580,
    "dodge": 240,
    "parry": 200,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "name": "金蛇吞信",
    "action": "$N身形一转，一招「" HIY "金蛇吞信" NOR "」，手中的$w从左肋下向$n的$l戳了过去",
    "force": 580,
    "dodge": 240,
    "parry": 200,
    "damage": 255 * 35,
    "damage_type": "刺伤"
  ]),
  ([ "name": "金蛇狂舞",
    "action": "$N手腕一抖，一招「" HIY "金蛇狂舞" NOR "」，$w挟著闪闪剑光，变幻无方逼向$n的$l",
    "force": 580,
    "dodge": 240,
    "parry": 200,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
});

mapping *action3 = ({
  ([ "name": "灵蛇电闪",
    "action": WHT "$N心念电闪手腕疾振处，一招「" HIY "灵蛇电闪" NOR WHT "」，$w" NOR WHT "以无法形容的速度直射$n的$l",
    "force": this_player()->query_skill("jinshe-jian", 1),
    "dodge": this_player()->query_skill("dodge", 1) / 2,
    "damage": this_player()->query("jym_level/level") * 180 * 35,
    "parry": this_player()->query_skill("parry", 1),
    "lvl": 1050,
    "damage_type": "刺伤"
  ]),
  ([ "name": "蛇困愁城",
    "action": RED "$N身形一矮，一招「" HIY "蛇困愁城" NOR RED "」，手中的$w" NOR RED "由下往上刺向$n的$l",
    "force": this_player()->query_skill("jinshe-jian", 1),
    "dodge": this_player()->query_skill("dodge", 1) / 2,
    "damage": this_player()->query("jym_level/level") * 180 * 35,
    "parry": this_player()->query_skill("parry", 1),
    "lvl": 1150,
    "damage_type": "刺伤"
  ]),
  ([ "name": "金蛇化龙",
    "action": HIB "$N手中$w" HIB "剑光暴长，一招「" HIY "金蛇化龙" HIB "」，如千年蛇蝎往$n$l咬去",
    "force": this_player()->query_skill("jinshe-jian", 1),
    "dodge": this_player()->query_skill("dodge", 1) / 2,
    "damage": this_player()->query("jym_level/level") * 180 * 35,
    "parry": this_player()->query_skill("parry", 1),
    "lvl": 1250,
    "damage_type": "刺伤"
  ]),
});


int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  int i, level;
  mapping a_action;
  level = (int)me->query_skill("jinshe-jian", 1);
  me = this_player();
  if (me->query_skill("jinshe-jian", 1) < 401)
    return action[random(sizeof(action))];

  if (me->query_skill("jinshe-jian", 1) > 400
    && me->query_skill("jinshe-jian", 1) < 1001)
    return action2[random(sizeof(action2))];

  if (me->query_skill("jinshe-jian", 1) > 1000
    && me->query("jym_level/level") >= 5)
    return action3[random(sizeof(action3))];

  if (me->query_skill("jinshe-jian", 1) > 1000
    && me->query("jym_level/level") < 5)
    return action2[random(sizeof(action2))];
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;

  // 第二等级的伤气
  if (me->query_skill("jinshe-jian", 1) > 400
    && me->query_skill("jinshe-jian", 1) < 1001
    && (me->query("neili") * 3) > victim->query("max_neili")) {
    victim->receive_wound("qi", (damage_bonus - 100) / 8, me);
    return HIR "$N的金蛇剑法已入随心所欲之境界，一阵剑气随剑跟出，震的$n心头一跳！！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("jinshe-jian", 1) > 1000
    && me->query("jym_level/level") >= 5
    && (me->query("neili") * 3) > victim->query("max_neili")) {
    victim->receive_wound("qi", (damage_bonus - 100) / 5, me);
    return HIR "$N手中剑刃猛的发出数道" HIY "剑芒" HIR "攻向$n，$N防御不及，一股" HIY "金蛇剑气" HIR "以然入体，顿时口中一甜，吐出血来！！\n" NOR;
  }
}


int practice_skill(object me) {
  if ((int)me->query("qi") < 3000
    || (int)me->query("neili") < 5000)
    return notify_fail("你的内力或气不够，没有办法练习金蛇剑法。\n");
  if ((int)me->query("max_neili") < 600000)
    return notify_fail("你的内力不够深厚，到底如何练成金蛇剑法的？？\n");
  me->receive_damage("qi", 300);
  me->add("neili", -300);
  write("你按著所学练了一遍金蛇剑法。\n");
  return 1;
}
int valid_learn(object me) {
  if ((int)me->query_skill("jinshe-jian", 1) >= 0)
    return notify_fail("这金蛇剑法岂是可以口传的武技？？\n");
  return 1;
}


int valid_effect(object me, object weapon, string name, int skill) {}

int effective_level() { return 25; }

string *parry_msg = ({
  "$n不退反进，气走周天，手中的$v狠狠磕开了$N的$w。\n",
  "$n回剑自守，架住了$N的$w。\n",
  "$n手中的$v化作千百把，护住了全身。\n",
  "$n手中的$v自上削下，几乎将$N的$w削成两段。\n",
});

string *unarmed_parry_msg = ({
  "$n使动$v，在身前布起了一道铜墙铁壁，封住了$N的攻势。\n",
  "$n一抖手中的$v，护住了全身。\n",
  "$n将$v往地上一刺，$v反弹起来，刚好直刺$N的双臂。\n",
  "$n举剑静立，一股内力从剑梢透出，逼开了$N。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action) {
  return __DIR__ "jinshe-jian/" + action;
}
