inherit ROOM;
void create() {
  set("short", "灰暗之道");
  set("long", @LONG
这是一条模糊灰暗的走廊，惨淡的月光从眉的上方直刺下来，很安静,安静的好像聋子的耳朵。没有一个人走过来，却感觉有一双目光在暗处注视着你的一举一动。

LONG
  );
  set("exits", ([
    "north": "/p/residence/black1285252513",
    "south": "/p/residence/black1285251304.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  //         set("class", "$HIB$【黑帮】");
  set("banghui", "$HIB$【黑帮】");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
void init() {
  add_action("do_invite", "yaoqing2");
  //add_action("do_setowner","setowner");
}
int valid_enter(object me) {
  int flag;
  // always let owner go in:
  if ((string)me->query("banghui") != (string)query("banghui")
    //         if((string)me->query("class") != (string)query("class")
    && (string)query("invite") != (string)me->query("id")
    && (string)me->query("id") != (string)query("owner"))
    return 1;

}
int do_invite(string arg) {
  object me;
  me = this_player();
  if ((string)me->query("id") != (string)query("owner"))
    return 0;
  set("invite", arg);
  write("你邀请" + arg + "来你的房间。\n");
  return 1;
}
