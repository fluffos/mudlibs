inherit ROOM;
void create() {
  set("short", "金色的阳光海岸");
  set("long", @LONG
桥的尽头，可以嗅到芳草的气息，阵阵海风袭来令你的心情一下开阔了。明媚的阳光下，七位粉黛正在嬉闹着，正是双儿、阿珂、曾柔、建宁公主、苏荃、沐剑屏、方怡。

LONG
  );
  set("exits", ([
    "east": "/p/residence/black1285648313",
    "west": "/p/residence/black1285647733",
    "north": "/p/residence/black1285646356",
    "south": "/p/residence/black1285644643.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  //         set("class", "$HIB$【黑帮】");
  set("banghui", "$HIB$【黑帮】");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
void init() {
  add_action("do_invite", "yaoqing2");
  //add_action("do_setowner","setowner");
}
int valid_enter(object me) {
  int flag;
  // always let owner go in:
  if ((string)me->query("banghui") != (string)query("banghui")
    //         if((string)me->query("class") != (string)query("class")
    && (string)query("invite") != (string)me->query("id")
    && (string)me->query("id") != (string)query("owner"))
    return 1;

}
int do_invite(string arg) {
  object me;
  me = this_player();
  if ((string)me->query("id") != (string)query("owner"))
    return 0;
  set("invite", arg);
  write("你邀请" + arg + "来你的房间。\n");
  return 1;
}
