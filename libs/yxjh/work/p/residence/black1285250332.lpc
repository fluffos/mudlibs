inherit ROOM;
void create() {
  set("short", "暗黑之道");
  set("long", @LONG
黑，黑涌了过来，从四面八方向你涌了过来，让你窒息让你喘不过气来，令你心跳停止令你晕厥令你停滞在了路上。南面是漆黑漫长的路，你已不能往回走了。

LONG
  );
  set("exits", ([
    "east": "/p/residence/black1285255898",
    "west": "/p/residence/black1285254960",
    "north": "/p/residence/black1285251304",
    "south": "/u/rock/room/yingxiong1.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  //         set("class", "$HIB$【黑帮】");
  set("banghui", "$HIB$【黑帮】");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
void init() {
  add_action("do_invite", "yaoqing2");
  //add_action("do_setowner","setowner");
}
int valid_enter(object me) {
  int flag;
  // always let owner go in:
  if ((string)me->query("banghui") != (string)query("banghui")
    //         if((string)me->query("class") != (string)query("class")
    && (string)query("invite") != (string)me->query("id")
    && (string)me->query("id") != (string)query("owner"))
    return 1;

}
int do_invite(string arg) {
  object me;
  me = this_player();
  if ((string)me->query("id") != (string)query("owner"))
    return 0;
  set("invite", arg);
  write("你邀请" + arg + "来你的房间。\n");
  return 1;
}
