#include <ansi.h>
inherit NPC;

#define MIRROR_SYS "/d/proom/sys/mirror_sys"

int ask_job();

void create() {
  set_name("个人空间管理员", ({ "copy man", "man" }));
  set("title", "净化石副本");

  set("gender", "男性");
  set("age", 26);
  set("long", "他是一位副本管理员。\n");

  set("inquiry", ([
    "进入副本": (: ask_job :),
  ]));

  setup();
  carry_object("/clone/misc/changpao")->wear();
}

int ask_job() {
  object me;
  object memory, npc;

  me = this_player();

  //删除旧的副本
  memory = me->query_temp(sprintf("%s_memory", me->query("id")));
  if (objectp(memory)) {
    memory->delete("user_id");
  }
  //创建新的副本
  else MIRROR_SYS->mirror(this_object(), me);
  return 1;
}
