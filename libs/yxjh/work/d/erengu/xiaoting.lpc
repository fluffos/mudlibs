#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HBK"小亭"NOR);
        set("long", @LONG
一座干干净净的亭子。一路走来都是萧瑟的气息，偏偏这里让人感觉到丝丝
温暖。你就一颗心就此平静了下来。隐隐约约间似乎有幽香传来。环目四顾于是
你就见到了亭角的那位姑娘。

LONG );
        set("no_fight", 1);
        set("no_magic",1);
        set("no_kill",1);
        set("no_sleep",1);

        set("objects", ([
			__DIR__"npc/su" : 1,
        ]) );

		set("exits", ([
			"west" : __DIR__"xroad1",
		]) );

        setup();

}