#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HBK "恶人谷" NOR);
  set("long", @LONG
恶人谷，这里就是恶人谷。四周一片森冷，鬼影也见不到一个。寒风吹来，
你觉得有点阴森，似乎很多双眼睛正窥视着你，让你不想在此逗留。北方似乎有
个破庙，还是赶紧过去吧。

LONG);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_kill", 1);
  set("no_sleep", 1);
  set("special", "恶人谷");

  set("objects", ([
  ]));

  set("exits", ([
    "north": __DIR__ "pomiao",
    "east": __DIR__ "wytai",
  ]));

  setup();

}
