inherit ITEM;
void create()
{
        set_name(HIC"地界牌"NOR, ({ "dijie pai","pai"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "往西北是开封城,往东南走就是嘉兴,泉洲一带,往东北走就是泰山!!\n");
                set("unit", "个"); 
                set("no_get",1);
                set("no_drop",1);             
                set("no_put",1);
                set("no_give",1);   
                set("value",10000000);
        }
    setup();
}

