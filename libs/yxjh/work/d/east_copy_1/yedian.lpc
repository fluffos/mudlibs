// edit by rock
//2010.8.5

inherit ROOM;

object *npcs = ({});

void create() {
  set("short", "野店");
  set("long", @LONG
    这里是一间破旧的茅草屋，从外观上来看，好像经历过一些人为破坏，墙
壁上有许多破洞，应该是人格斗留下的痕迹。
LONG
  );
  set("outdoors", "city");

  set("exits", ([
    "east": __DIR__ "shulin",
    "south": __DIR__ "shanjiao",
    "west": __DIR__ "langrenying",
    "north": __DIR__ "haitan",
    "northwest": __DIR__ "junying",
  ]));

  setup();
}

void make_shiwei() {
  string file = "/d/east_copy_1/npc/killer";
  object room = this_object(), boss, weapon;
  int index, i;

  for (i = 0; i < 2; i++) {
    if (!boss = new(file)) return;

    boss->set_name("侍卫", ({ "shi wei" }));
    boss->set("title", HIM "东厂带刀侍卫" NOR);
    boss->set("gender", "无性");
    boss->set("long", sprintf("传说中的%s。\n", boss->name()));
    boss->set("age", 25);

    index = 450 * 10;
    boss->set("per", index);
    boss->set("con", index);
    boss->set("int", index);
    boss->set("dex", index);
    boss->set("str", index);

    index = 450;
    boss->set("jym_level/level", index);

    boss->set("max_qi", index * 30000);
    boss->set("max_jing", index * 600);
    boss->set("max_jingli", index * 600);
    boss->set("max_neili", index * 100000);

    boss->set("jiali", index * 20);
    boss->set_skill("dodge", index * 159);
    boss->set_skill("unarmed", index * 159);
    boss->set_skill("parry", index * 159);
    boss->set_skill("sword", index * 159);
    boss->set_skill("blade", index * 159);
    boss->set_skill("staff", index * 159);
    boss->set_skill("force", index * 159);
    boss->set_skill("taixuan-gong", index * 159);
    boss->set_skill("langzi-sword", index * 159);

    boss->set("jingli", index * 600);
    boss->set("neili", index * 100000);
    boss->set("qi", index * 30000);
    boss->set("eff_qi", index * 30000);
    boss->set("jing", index * 600);
    boss->set("eff_jing", index * 600);

    boss->map_skill("force", "taixuan-gong");
    boss->map_skill("dodge", "taixuan-gong");
    boss->map_skill("parry", "langzi-sword");
    boss->map_skill("sword", "langzi-sword");

    if (weapon = new("/d/city/obj/changjian")) {
      weapon->move(boss);
      weapon->wield();
    }
    boss->set("room", this_object());
    boss->move(room);
  }
}

void chat_msg(object me, int index) {
  object room = this_object();
  int i, size;

  if (!me) return;

  switch (index) {
    case 1: tell_room(
      room,
      HIG "陆大有" NOR + YEL "说道：" WHT "奇怪，怎么那么多尸体。\n" NOR
    ); call_out("chat_msg", 1, me, 2); break;
    case 2: tell_room(
      room,
      HIG "施戴子" NOR + YEL "说道：" WHT "是啊！我们来的时候就这样，还以为这位是凶手呢。\n" NOR
    ); call_out("chat_msg", 1, me, 3); break;
    case 3: tell_room(
      room,
      HIG "劳德诺" NOR + YEL "说道：" WHT "幸好我们武功练不好，要不可就误伤人了。\n" NOR
    ); call_out("chat_msg", 1, me, 4); break;
    case 4: tell_room(room, HIG "陆猴儿" NOR + YEL "说道：" WHT "这野店还有炊烟，但是不见有人，里面一定有能吃的东西。\n" NOR);
    tell_room(room, "陆猴儿开始忙活起来做饭。\n");
    call_out("chat_msg", 60, me, 5);
    break;
    case 5:
      tell_room(room, "你突然听见一阵马蹄声，远远看到一面大旗，上面写这两个威武的大字“东厂”\n");
      tell_room(room, HIG "陆大有" NOR + YEL "说道：" WHT "官兵来了，赶快往northwest方向离开。\n" NOR);
      tell_room(room, HIG "劳德诺" NOR + YEL "说道：" WHT "是啊，那么多尸体，我们说不清的，还是快走。\n" NOR);
      tell_room(room, "陆大有往西北离开。\n施戴子往西北离开。\n劳德诺往西北离开。\n陆猴儿往西北离开。\n");
      room->set("northwest", 1);  //打开出口
      room->set("north", 1);
      size = sizeof(npcs);
      for (i = 0; i < size; i++) if (npcs[i]) destruct(npcs[i]);
      call_out("make_shiwei", 30);
      break;
  }
}

void make_npc(object me) {
  int i;
  object npc, room = this_object();
  string *name = ({ "陆大有", "施戴子", "劳德诺", "陆猴儿" });
  string *id = ({ "lu dayou", "shi naizi", "lao denuo", "lu houer" });

  //放NPC
  if (!room->query("make_npc")) {

    tell_object(me, HIW "踏进这里，周围满地的尸体，到处都是扶桑武士的尸体，不知道发生了什么。\n" NOR);
    tell_object(me, "突然冒出几个人影，开始向你展开进攻。\n");
    tell_object(me, "人影使一招「有凤来仪」，手中长剑剑光暴长，向你的胸部刺去。\n");
    tell_object(me, "( " HIG "你看起来气血充盈，并没有受伤。" NOR " )\n");
    tell_object(me, "人影剑随身转，一招「无边落木」罩向你的头部。\n");
    tell_object(me, "( " HIG "你看起来气血充盈，并没有受伤。" NOR " )\n");
    tell_object(me, "人影舞动长剑，一招「鸿飞冥冥」挟著无数剑光刺向你的左肩。\n");
    tell_object(me, "( " HIG "你看起来气血充盈，并没有受伤。" NOR " )\n");
    tell_object(me, "人影手中长剑化成一道光弧，直指你的右肩，一招「白虹贯日」发出虎哮龙吟刺去。\n");
    tell_object(me, CYN "你注视著人影的行动，企图寻找机会出手。\n" NOR);
    tell_object(me, "人影：等等，大家住手，他用的不是扶桑兵器。\n");
    tell_object(me, HIW "你心中一惊，说道：“华山派的武功！”\n" NOR);
    tell_object(me, "人影：不错，我们的确是华山派，各位师兄现身吧。\n");

    for (i = 0; i < 4; i++) {
      npc = new("/d/city/npc/liumang");
      npc->set("long", "华山派" + name[i] + "\n");
      npc->set_name(name[i], ({ id[i] }));
      npc->set("age", 26);
      npc->move(room);
      npcs += ({ npc });
    }
    room->set("make_npc", 1);
    call_out("chat_msg", 1, me, 1);
  }
}

void init() {
  object me = this_player();
  object room = this_object();
  object corpse;
  int i;

  if (!userp(me)) return;

  //放尸体
  if (!room->query("make_corpse")) {
    for (i = 0; i < 7; i++) {
      corpse = new(CORPSE_OB);
      if (random(100) < 50) {
        corpse->set_name("日月神教教众的尸体", ({ "corpse" }));
        corpse->set("long", "日月神教的教众然而她已经死了，只剩下一具尸体静静地躺在这里。\n");
        corpse->set("gender", "女性");
        corpse->set("victim_name", "日月神教教众");
      } else {
        corpse->set_name("扶桑武士的尸体", ({ "corpse" }));
        corpse->set("long", "扶桑国的武士然而他已经死了，只剩下一具尸体静静地躺在这里。\n");
        corpse->set("gender", "男性");
        corpse->set("victim_name", "扶桑武士");
      }
      corpse->set("age", 27);
      corpse->set_weight(50000000);
      corpse->set_max_encumbrance(14000000);
      corpse->set("no_get");
      corpse->move(room);
    }
    room->set("make_corpse", 1);
  }
  call_out("make_npc", 1, me);
}

int valid_leave(object me, string dir) {
  object room = this_object();

  if (!room->query(dir)) return notify_fail("这里不适合到处乱跑。\n");
  else return ::valid_leave(me, dir);
}

//是镜像
int is_mirror() { return 1; }
