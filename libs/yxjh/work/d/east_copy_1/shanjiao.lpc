// edit by rock
//2010.8.5
#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "山脚");
  set("long", @LONG
    这里是一座大山的山脚，这里的山连绵不绝，不知道哪里是尽头，也许翻
过前面这座，就是尽头吧。
LONG
  );
  set("outdoors", "city");

  set("exits", ([
    "west": __DIR__ "heimuya",
    "north": __DIR__ "yedian",
  ]));

  setup();
}

void init() {
  object room = this_object();
  if (room->query("no_north")) {
    room->delete("north");
    return;
  }
  add_action("do_look", "go");
}

int do_look() {
  object me = this_player();
  object room = this_object();
  object item;

  if (!room->query("xiaoaojianghu")) {
    if (item = present("jiudai", me)) {
      destruct(item);
    }
    tell_object(me, HIM "突然一股红色媚影，往你身边飞过，你被碰飞几米远，手上的酒壶掉入山谷，险些自己也掉下山谷。\n" NOR);
    tell_object(me, HIW "扭头一看，是一位亭亭玉立的姑娘飞过，可见轻功了得。\n" NOR);
    tell_object(me, "你大声喝道：“我嗜酒如命，没有酒怎么办。你赔我的二锅头！”\n");
    tell_object(me, HIW "姑娘扭头看你，轻轻的摇了摇头，便加速飞过。\n" NOR);
    room->set("xiaoaojianghu", 1);
    return 1;
  } else {
    room->set("north", 1);  //打开出口
    return 0;
  }
}

int valid_leave(object me, string dir) {
  object room = this_object();

  if (!room->query(dir)) return notify_fail("这里不适合到处乱跑。\n");
  else return ::valid_leave(me, dir);
}

//是镜像
int is_mirror() { return 1; }
