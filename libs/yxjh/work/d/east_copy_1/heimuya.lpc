//2010.8.5

inherit ROOM;
void create()
{
	set("short", "黑木崖");
	set("long", @LONG
    这里是黑木崖，传说中这里是东方不败这个大魔头的老巢，这里戒备森严
而且上崖并不是一件易事，除了旁边的绳索竹篮，应该没有任何办法离开黑木崖。
LONG
	);
        set("outdoors", "city");

	setup();
}

void make_killer()
{
	object room=this_object();
	object npc,boss,weapon;
	int i,index;

	//刷boss
	if(room->query("make_boss") >= 150)
	{
		if(boss=new("/d/east_copy_1/npc/nvzi4"))
		{
			boss->set("gender", "无性");
			boss->set("age", 25);

			index = 450*10;
			boss->set("per", index);
			boss->set("con", index);
			boss->set("int", index);
			boss->set("dex", index);
			boss->set("str", index);

			index = 450;
			boss->set("jym_level/level",index);
		
			boss->set("max_qi",            index*30000);
			boss->set("max_jing",          index*600); 
			boss->set("max_jingli",        index*600);
			boss->set("max_neili",         index*100000);

			boss->set("jiali",             index*20);
			boss->set_skill("dodge",       index*159);
			boss->set_skill("unarmed",     index*159);
			boss->set_skill("parry",       index*159);
			boss->set_skill("sword",       index*159);
			boss->set_skill("blade",       index*159); 
			boss->set_skill("staff",       index*159);
			boss->set_skill("force",       index*159);
			boss->set_skill("taixuan-gong",index*159);
			boss->set_skill("pixie-jian",    index*159);

			boss->set("jingli",            index*600);
			boss->set("neili",             index*100000);
			boss->set("qi",                index*30000);
			boss->set("eff_qi",            index*30000);
			boss->set("jing",              index*600); 
			boss->set("eff_jing",          index*600);

			boss->map_skill("force", "taixuan-gong"); 
			boss->map_skill("dodge", "taixuan-gong"); 
			boss->map_skill("parry",  "pixie-jian"); 
			boss->map_skill("sword",  "pixie-jian"); 

			if(weapon=new("/d/city/obj/changjian"))
			{
				weapon->move(boss);
				weapon->wield();
			}
			boss->move(room);
		}
		return;
	}
	//刷killer
	else
	{
		if(index=room->query("killer"))
		{
			for(i=0;i<index;i++)
			{
				if(npc=new("/d/east_copy_1/npc/fightman"))
				{
					if(random(100) < 50)
					{
						npc->set_name(HIW"扶桑武士"NOR, ({ "wushi"}));
						npc->set("long", "流落汉土的扶桑武士，是被东方不败召集来对抗朝廷的。\n");
					}
					else
					{
						npc->set_name(HIW"日月神教教众"NOR, ({ "wushi"}));
						npc->set("long", "东方不败的狗腿子，是为了造反集结在这里的。\n");
					}
					npc->move(room);
				}
			}
			room->delete("killer");
		}
	}
	call_out("make_killer",1);
}

void call_tell()
{
	object room=this_object();
	
	tell_room(room,HIW"\n附近叫杀声一片，这里早已一片狼藉，看来任我行一干人等，早已经攻上去了。\n"NOR);
	call_out("make_killer",1);
}

void init()
{
	object me=this_player();
	object room=this_object();

	if(!userp(me)) return;

	if(!room->query("call_tell"))
	{
		call_out("call_tell",1);
		room->set("killer",8);
		room->set("call_tell",1);
	}
}

//是镜像
int is_mirror() { return 1; }