// edit by rock
//2010.8.5
#include <ansi.h>
inherit ROOM;

object npc;

void create()
{
	set("short", "浪人营");
	set("long", @LONG
    这里是一个难民营，看起来都是一些老弱或幼小的扶桑国人，围着一小堆
一小堆的火堆，高兴的哼唱着，不知道在庆祝什么，离开火堆的扶桑人个个东
倒西歪的躺在地上，很远就能闻到烂醉的味道，偶尔听到两声嘀咕，却又不知
道是什么意思。
LONG
	);
        set("outdoors", "city");

	set("exits", ([
		"east" : __DIR__"yedian",
		"west" : __DIR__"dilao",
	]));

	setup();
}

void call_tell()
{
	object room=this_object();

	tell_room(room,HIW"又是这位姑娘，你从心底自不由想起一首诗：“天下英雄出我辈... ...”，想把它念出来。\n"NOR);
}

void call_makekiller(int index,object me)
{
	object room = this_object();
	object next_room,*inv;
	int i,size;

	switch(index)
	{
		case 1:
			tell_room(room,HIR"突然跑来两个扶桑武士，准备拔刀。\n"NOR);
			tell_room(room,HIR"扶桑武士看起来想杀死你！\n"NOR);
			call_out("call_makekiller",1,2,me);
		break;
		case 2:
			if(!me) return;
			tell_room(room,HIW"女子因为害怕，突然转身跳崖了。\n"NOR);
			tell_room(room,sprintf("%s转身跳入山谷，去救女子。\n",me->query("name")));
			destruct(npc);
			next_room = (object)room->query("exits/west");
			inv=all_inventory(room);
			size=sizeof(inv);
			for(i=0;i<size;i++)
			{
				if(userp(inv[i]))
				{
					inv[i]->unconcious();
					inv[i]->move(next_room);
				}
			}
		break;
	}
}

int do_say(string arg)
{
	object room = this_object();
	object me=this_player();

	if(!arg) return 0;
	if(arg != "天下英雄出我辈，一入江湖岁月催。皇图霸业谈笑中，不胜人生一场醉。") return 0;

	tell_room(room,sprintf("%s念道：“天下英雄出我辈，一入江湖岁月催。皇图霸业谈笑中，不胜人生一场醉。”\n",me->query("name")));
	tell_room(room,sprintf("%s叹道：“也许你永远也不知道我在说什么，那么我们永远都不会有恩怨。”\n",me->query("name")));

	if(!room->query("call_makekiller"))
	{
		call_out("call_makekiller",3,1,me);
		room->set("call_makerkiller",1);
	}
	return 1;
}

void init()
{
	object room=this_object();
	if(!userp(this_player())) return;

	add_action("do_say", "say");

	if(!room->query("call_tell"))
	{
		if(npc=new("/d/east_copy_1/npc/nvzi2"))
		{
			npc->move(room);
		}
		call_out("call_tell",1);
		room->set("call_tell",1);
	}
}

int valid_leave(object me,string dir)
{
	object room=this_object();

	if(!room->query(dir)) return notify_fail("这里不适合到处乱跑。\n");
	else return::valid_leave(me, dir);
}

//是镜像
int is_mirror() { return 1; }