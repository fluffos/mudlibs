// jitui.c 鸡腿
#include <weapon.h>
inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("野味", ({ "yewei" }) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一只飞禽看起来很好吃的样子。估计要烤(kao)了吃。\n");
		set("unit", "只");
		set("value", 500);
		set("food_remaining", 4);
		set("food_supply", 40);
		set("material", "bone");
	}
	setup();
}
int finish_eat()
{
	if( !query("weapon_prop") ) return 0;
	set_name("啃得精光的野味骨头", ({ "bone" }) );
	set_weight(150);
	set("long", "啃得精光的野味骨头。\n");
	return 1;
}

void init()
{
	object me=this_player();
	object room=environment(me);
	if(!userp(me)) return;
	if(!room || !room->is_mirror()) return;

	add_action("do_eat", "eat"); 
	add_action("do_kao", "kao"); 
}

int do_eat(string arg)
{
	object ob=this_object();
	object me=this_player();

	if(arg != ob->query("id")) return 0;
	if(!ob->query("kao",1)) 
	{
		tell_object(me,"是生的，不能吃。\n");
		return 1;
	}
	return 0;
}

void call_kao(object room,object me)
{
	object ob=this_object();
	if(!me || !environment(me)->is_mirror() || environment(me)->query("short") != "树林" || room->query("west")) return;
	tell_room(room,"野味烤熟了！香喷喷的。\n");
	room->set("west",1);
	ob->set_name("烤熟的野味", ({ "yewei" }) );
	ob->move(me);
	tell_room(room,HIW"野店那么多日月神教教众的尸体，看来日月神教就在附近，说不定任盈盈也在那里。\n"NOR);
}

int do_kao(string arg)
{
	object ob = this_object();
	object me = this_player();
	object room = environment(ob);
	if(userp(room) || !room->is_mirror())
	{
		tell_object(me,"野味怎么能在这个地方烤，不怕着火？\n");
		return 1;
	}

	if(arg !=ob->query("id")) return 0;
	tell_room(room,sprintf("%s升了一堆火，开始烤野味。\n",me->query("name")));
	call_out("call_kao",60,room,me);
	return 1;
}