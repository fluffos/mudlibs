// wineskin.c  酒袋
inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name(HIM "精致的酒壶" NOR, ({ "jiuhu" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个非常精致的酒壶，大概装得八、九升的酒，\n从琉金外观来看，应该价值十几万锭元宝。\n");
    set("unit", "个");
    set("value", 999999);
    set("max_liquid", 15);
    set("no_save", 1);
  }
  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": "女儿红",
    "remaining": 15,
    "drunk_supply": 6,
  ]));
}

void init() {
  object me = this_player();
  if (!userp(me)) return;

  add_action("do_get", "get");
}

int do_get(string arg) {
  object me = this_player();
  object *inv, item = this_object();
  int i, size;

  if (!userp(me)) return 0;
  if (item->query("no_cmd")) return 0;
  if (arg == "all") {
    tell_object(me, "Ok。\n");
    return 1;
  }
  if (arg != "jiuhu" && arg != "hu") return 0;

  inv = all_inventory(me);

  size = sizeof(inv);

  for (i = 0; i < size; i++) {
    if (inv[i]->query("name") == "牛皮酒袋" && inv[i]->query("id") == "jiudai") {
      item->move(me);
      tell_room(environment(me), sprintf("%s捡起一个精致的酒壶，打开盖子饮了两口，赞道：“好酒。”\n", me->query("name")));
      item->set("no_cmd", 1);
      return 1;
    }
  }
  tell_object(me, "那东西拿不起来。\n");
  return 1;
}
