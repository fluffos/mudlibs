// edit by rock
//2010.8.5

inherit ROOM;
void create() {
  set("short", "日月神教");
  set("long", @LONG
    这里是日月神教，大门的牌坊上一排魏碑的琉金大字“日月神教”，字体
钢筋有力，十分威武，透着些许狂气，敬畏之心悠然而生。
LONG
  );
  set("outdoors", "city");

  set("exits", ([
    "southwest": __DIR__ "kuihuashe",
  ]));

  setup();
}

void call_wa(int index) {
  object room = this_object();
  object next_room = (object)room->query("exits/southwest");
  object *inv;
  int i, size;

  switch (index) {
    case 1: tell_room(room, "任我行使劲在地上刨。口中念道：“挖你的心！”\n"); call_out("call_wa", 1, 2); break;
    case 2: tell_room(room, "任我行使劲在地上刨。口中念道：“挖你的肺！”\n"); call_out("call_wa", 1, 3); break;
    case 3: tell_room(room, "任我行使劲在地上刨。口中念道：“挖你的眼睛！”\n"); call_out("call_wa", 1, 4); break;
    case 4: tell_room(room, HIG "突然任我行刨出了一个破布包裹着的卷轴。\n" NOR); call_out("call_wa", 1, 5); break;
    case 5:
      tell_room(room, "任我行发觉你在身后，有点惊慌失措。\n");
      tell_room(room, HIR "任我行看起来想杀死你！\n" NOR);
      tell_room(room, HIW "任我行一招「海纳百川」，击向你的头部。\n" NOR);
      tell_room(room, "( " HIG "你看起来气血充盈，并没有受伤。" NOR " )\n");
      call_out("call_wa", 1, 6);
      break;
    case 6:
      tell_room(room, "你险些没有反应过来，脚下一空，掉下了山谷。\n");
      inv = all_inventory(room);
      size = sizeof(inv);
      for (i = 0; i < size; i++) {
        if (userp(inv[i])) {
          inv[i]->unconcious();
          inv[i]->move(next_room);
        }
      }
      break;
  }
}

void init() {
  object room = this_object();
  object me = this_player();
  if (!userp(me)) return;

  if (!room->query("wa_ok")) {
    call_out("call_wa", 1, 1);
    room->set("wa_ok", 1);
  }
}

int valid_leave(object me, string dir) {
  object room = this_object();

  if (!room->query(dir)) return notify_fail("这里不适合到处乱跑。\n");
  else return ::valid_leave(me, dir);
}

//是镜像
int is_mirror() { return 1; }
