#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "军营");
  set("long", @LONG
    这里是倭寇的军营，重兵把守四周防卫森严。中间有一堆火，很多倭寇围
着火堆饮酒，又唱又跳。
LONG
  );
  set("outdoors", "city");

  set("exits", ([
    "east": __DIR__ "shulin",
    "south": __DIR__ "langrenying",
    //		"west" : __DIR__"qianzhuang",
    //		"north" : __DIR__"beidajie2",
  ]));

  setup();
}

void call_tell(int index) {
  object room = this_object();
  switch (index) {
    case 1:
      tell_room(room, HIY "你远远听见将军帐内，有人谈话。\n" NOR);
      call_out("call_tell", 1, 2);
      break;
    case 2:
      tell_room(room, HIW "东方不败：你们的统帅戚继光是个军事人才，可惜得不到你们昏君的欢心，被贬为文职，病死异乡。\n" NOR);
      tell_room(room, HIW "东方不败：真是朝中无大将，派你们这几只小螳螂来，想挡我的大军车。看来汉人的江山果然是保不住了。\n" NOR);
      call_out("call_tell", 1, 3);
      break;
    case 3:
      tell_room(room, HIG "东厂千户：大胆苗狗！你竟敢在御前千户面前抨击朝纲！\n" NOR);
      tell_room(room, HIW "东方不败：哼！你竟敢在我们苗人面前骂我们是狗？\n" NOR);
      tell_room(room, HIW "东方不败：汉犬，你抬头看看你头上的战旗，很快就插在你们昏君的狗头上。\n" NOR);
      call_out("call_tell", 1, 4);
      break;
    case 4:
      tell_room(room, HIG "东厂千户：你们要造反？\n" NOR);
      tell_room(room, HIW "东方不败：对，我们是要造反，金、辽、苗、藏、蒙、回六族，你们汉人专挑人最少的苗族欺诈压迫。\n" NOR);
      tell_room(room, HIW "东方不败：自古以来，哪一朝不是造反立国？\n" NOR);
      call_out("call_tell", 1, 5);
      break;
    case 5:
      tell_room(room, HIG "东厂千户：你不要以为勾结了这些流落汉土的扶桑军队，就可以对抗朝廷。\n" NOR);
      tell_room(room, HIG "东厂千户：我们朝廷已经跟扶桑国的神武将军丰臣秀吉，定了盟约铲平你们。\n" NOR);
      call_out("call_tell", 1, 6);
      break;
    case 6:
      tell_room(room, HIW "东方不败：丰臣秀吉？哈...哈... ...哈...\n" NOR);
      tell_room(room, HIW "东方不败：他正忙着对付邻国高丽，来不及救你们了。等他到的时候，我已经一统天下，我东方不败随时恭候他来救人。\n" NOR);
      tell_room(room, HIW "东方不败：给我杀。\n" NOR);
      call_out("call_tell", 1, 7);
      break;
    case 7:
      tell_room(room, "随后一阵枪响，哭声一片。\n");
      tell_room(room, YEL "官兵：救命啊，我不做汉人啦，救命啊... ...\n" NOR);
      tell_room(room, HIG "东厂千户：连苗狗都不如。\n" NOR);
      call_out("call_tell", 1, 8);
      break;
    case 8:
      tell_room(room, HIW "东方不败：还这么嘴硬！我偏要你说苗人造反有理。\n" NOR);
      tell_room(room, HIG "东厂千户：荒谬。\n" NOR);
      tell_room(room, "随后几声枪响，听见东厂千户求饶的声音。\n");
      call_out("call_tell", 1, 9);
      break;
    case 9:
      tell_room(room, HIG "东厂千户：造反有理！造反有理！\n" NOR);
      tell_room(room, HIG "东厂千户：日月神教万岁万岁万万岁！\n" NOR);
      call_out("call_tell", 1, 10);
      break;
    case 10:
      tell_room(room, HIW "东方不败：所谓天予大任，赐我神功。日出东方，唯我不败。\n" NOR);
      tell_room(room, HIW "东方不败：你去想办法跟朝廷解释，摆平这次劫军火事件。\n" NOR);
      tell_room(room, HIW "东方不败：然后等我命令，如果你不听话，我们高手如云，你小心有头睡觉，没头起床。\n" NOR);
      tell_room(room, HIW "东方不败：你走吧！" NOR);
      tell_room(room, "从营帐内，爬出一个老太监，溜了。\n");
      call_out("call_tell", 30, 11);
      break;
    case 11:
      tell_room(room, HIR "好像有人发现了你，还是去树林躲躲吧。\n" NOR);
      room->set("east", 1);
      break;
  }
}

int do_say(string arg) {
  object me = this_player();
  object memory = (object)me->query_temp("mirror/mirror_memory");

  if (!arg || !memory) return 0;
  if (arg != memory->query("anhao")) return 0;

  this_object()->set("south", 1);
  return 0;
}

void init() {
  object me = this_player();
  object room = this_object();

  add_action("do_say", "say");

  if (room->query("room_tell")) return;
  call_out("call_tell", 1, 1);
  room->set("room_tell", 1);
}

int valid_leave(object me, string dir) {
  object room = this_object();

  if (!room->query(dir)) return notify_fail("这里不适合到处乱跑。\n");
  else return ::valid_leave(me, dir);
}

//是镜像
int is_mirror() { return 1; }
