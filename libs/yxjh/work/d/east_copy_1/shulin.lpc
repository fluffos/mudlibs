// edit by rock
//2010.8.5

inherit ROOM;
void create() {
  set("short", "树林");
  set("long", @LONG
    这里是茂密的森林，四周都很潮湿，透着夜晚的雾气，感觉阴森森的，那
些树枝不时看起来像是人影，仿佛此地埋伏重重。
LONG
  );
  set("outdoors", "city");
  set("objects", ([
    "/d/east_copy_1/item/yewei": 5,
  ]));
  set("exits", ([
    "east": __DIR__ "riyue",
    "west": __DIR__ "junying",
    "northwest": __DIR__ "haitan",
  ]));

  setup();
}

void make_heiyiren() {
  string file = "/d/east_copy_1/npc/heiyiren";
  object room = this_object(), boss, weapon;
  int index;

  if (!boss = new(file)) return;

  index = 450 * 10;
  boss->set("per", index);
  boss->set("con", index);
  boss->set("int", index);
  boss->set("dex", index);
  boss->set("str", index);

  index = 450;
  boss->set("jym_level/level", index);

  boss->set("max_qi", index * 30000);
  boss->set("max_jing", index * 600);
  boss->set("max_jingli", index * 600);
  boss->set("max_neili", index * 100000);

  boss->set("jiali", index * 20);
  boss->set_skill("dodge", index * 159);
  boss->set_skill("unarmed", index * 159);
  boss->set_skill("parry", index * 159);
  boss->set_skill("sword", index * 159);
  boss->set_skill("blade", index * 159);
  boss->set_skill("staff", index * 159);
  boss->set_skill("force", index * 159);
  boss->set_skill("taixuan-gong", index * 159);
  boss->set_skill("wuhu-duanmendao", index * 159);

  boss->set("jingli", index * 600);
  boss->set("neili", index * 100000);
  boss->set("qi", index * 30000);
  boss->set("eff_qi", index * 30000);
  boss->set("jing", index * 600);
  boss->set("eff_jing", index * 600);

  boss->map_skill("force", "taixuan-gong");
  boss->map_skill("dodge", "taixuan-gong");
  boss->map_skill("parry", "wuhu-duanmendao");
  boss->map_skill("blade", "wuhu-duanmendao");

  if (weapon = new("/d/city2/obj/tudao")) {
    weapon->move(boss);
    weapon->wield();
  }
  boss->set("room", this_object());
  boss->move(room);
}

void init() {
  object me = this_player();
  object room = this_object();

  if (!userp(me)) return;

  if (room->query("west")) {
    if (!room->query("make_heiyiren")) {
      make_heiyiren();
      room->set("make_heiyiren", 1);
    }
    return;
  }

  tell_room(room, sprintf(YEL "刚刚的一场奇怪的暴雨打下了许多野味，%s肚子饿了，看着满地的野味。\n" NOR, me->query("name")));
  me->set_temp("gotoRoom", room->query("exits/east"));
}

int valid_leave(object me, string dir) {
  object room = this_object();

  if (!room->query(dir)) return notify_fail("这里不适合到处乱跑。\n");
  else return ::valid_leave(me, dir);
}

//是镜像
int is_mirror() { return 1; }
