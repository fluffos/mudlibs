#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "海滩");
  set("long", @LONG
    这里是一片宁静的沙滩，沙滩上的沙子，白哗哗的，映衬着蓝色的大海甚
是好看，不远处的海里不时有大鱼跃出。
LONG
  );
  set("outdoors", "city");

  set("exits", ([
    //		"east" : __DIR__"kedian",
    "south": __DIR__ "guangchang",
    "southwest": __DIR__ "shulin",
    //		"west" : __DIR__"qianzhuang",
    //		"north" : __DIR__"beidajie2",
  ]));

  setup();
}

void call_tell(int index) {
  object room = this_object();
  object npc;

  switch (index) {
    case 1: tell_room(room, HIW "接着突然一阵暴雨。\n" NOR); call_out("call_tell", 1, 2); break;
    case 2: tell_room(
      room,
      YEL "紧接着一阵沙尘暴，你仿佛看见了这些超自然现象的祸根。\n" NOR
    ); call_out("call_tell", 1, 3); break;
    case 3: tell_room(room, "你顺势用轻功跟了过去，迷雾中看见一位亭亭玉立的女子，定立迷雾当中。好像在哪见过！\n");
    if (npc = new("/d/east_copy_1/npc/nvzi")) {
      npc->set("room", room);
      npc->move(room);
    }
    tell_room(room, HIG "女子举止优雅，并不惊慌。你不经想上去打听她的芳名。\n" NOR);
    break;
  }
}

void init() {
  object me = this_player();
  object room = this_object();

  if (!userp(me)) return;

  if (!room->query("make_wind")) {
    tell_room(room, HIR "突然狂风大作。\n" NOR);
    call_out("call_tell", 1, 1);
    room->set("make_wind", 1);
  }
}

int valid_leave(object me, string dir) {
  object room = this_object();

  if (!room->query(dir)) return notify_fail("这里不适合到处乱跑。\n");
  else return ::valid_leave(me, dir);
}

//是镜像
int is_mirror() { return 1; }
