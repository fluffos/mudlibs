inherit ROOM;

void create()
{
	set("short", "地牢");
	set("long", @LONG
    这里是地牢，光线很暗，基本看不清东西，不过有泥土潮湿的气味，没猜
错的话，应该是在地下。
LONG
	);
        set("outdoors", "city");
        set("no_fight",1);

	setup();
}

void init()
{
	object me=this_player();
	object npc;

	if(!userp(me)) return;
	if(npc=new("/d/east_copy_1/npc/renwoxing"))
	{
		npc->move(this_object());
	}
}

//是镜像
int is_mirror() { return 1; }