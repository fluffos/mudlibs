#include <ansi.h>
inherit NPC;

string ask_npc();

int is_jinying() { return 1; }

void create()
{
	set_name("黑衣人", ({ "man" }));
	set("gender", "男性");
	set("long", "一个穿黑衣服的武士，蒙面看不出来是什么人。");
	set("age", 45);

	set("inquiry", ([ 
		"任盈盈的下落" : (:ask_npc:), 
		]));

	setup();
}

void init()
{
	call_out("findPlayer",5); //寻敌
}

void die()
{
	object ob = this_object();
	object me = ob->query_temp("last_damage_from");
	object room= (object)ob->query("room");

	ob->remove_all_killer();
	all_inventory(room)->remove_killer(ob);

	ob->set_name("向问天", ({ "xiang wentian"}));
	tell_room(room,"中原的武功！哈哈哈，在下日月神教向问天。\n");
	ob->set("no_kill",1);
	ob->revive();
	return;
}

//函数：寻敌
void findPlayer()
{
	object map,*players,ob;
	int i,size,rand;
	
	ob = this_object();
	map = environment(ob);

	if(ob->query("no_kill")) return;

	if(!map->is_mirror()) return;

	players = all_inventory(map);
	
	size = sizeof(players);
	rand = random(size);
	if(userp(players[rand])) ob->kill_ob(players[rand]);
	call_out("findPlayer",1+random(5));
}

void dest_npc(object me)
{
	object npc=this_object();
	int rand=random(50);
	object memory = (object)me->query_temp("mirror/mirror_memory");
	string *say = ({"哦乃嘎一喜马斯","多作，由鲁西古","洋芋哪里去挖","洋芋郊区去挖","瓦塔西瓦..."});
	string str;

	if(!memory) return;
	str = say[random(5)];
	if(rand < 10) tell_room(environment(npc),sprintf("你们过去就说%s。他们一定认为你是浪人。\n",str));
	else if(rand < 20) tell_room(environment(npc),sprintf("到时候你说%s。他们一定认为你不是中原人。\n",str));
	else if(rand < 30) tell_room(environment(npc),sprintf("到那边你说%s。他们一定认不出来。\n",str));
	else if(rand < 40) tell_room(environment(npc),sprintf("到军营你说%s。一定可以蒙混过关。\n",str));
	else if(rand < 50) tell_room(environment(npc),sprintf("去到你就讲%s。他们肯定认不出你们。\n",str));
	memory->set("anhao",str);
	destruct(npc);
}

string ask_npc()
{
	object ob=this_object();
	object room=environment(ob);
	object next_room = (object)room->query("exits/west");
	object npc;

	if(!ob->query("no_kill")) return 0;
	
	call_out("dest_npc",2,this_player());
	if(npc=new("/d/east_copy_1/npc/renyingying")) npc->move(next_room);
	return "哦，盈盈姑娘在军营的南部，浪人营里面，进入那边要先乔装浪人，以免被人发现。\n我先过去通报，你们随后来吧。\n";
}