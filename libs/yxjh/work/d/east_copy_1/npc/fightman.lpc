#include <ansi.h>

inherit NPC;

int is_jinying() { return 1; }

//#include <cailiao.h>

void create()
{
	set_name(HIW"亡灵"NOR, ({ "wanlin"}));
	set("gender", "男性");
	set("age",26);
	set("long", "他是一位亡灵，心魔的手下。\n");
        set("attitude", "aggressive");
        set("no_update", 1);
        set("str", 200 + random(60));
        set("int", 200 + random(60));
        set("con", 200 + random(60));
        set("dex", 200 + random(60));
        set("kar", 200 + random(60));
	set("shen_type", -1);
        set("qi", 1700000 + random(300000));
        set("max_qi", 1700000 + random(300000));
        set("jing", 1000000 + random(300000));
        set("max_jing", 1000000 + random(300000));
        set("neili", 500000 + random(300000));
        set("max_neili", 500000 + random(300000));
        set("max_jingli", 500000 + random(300000));
        set("jingli", 200000 + random(300000));
        set("jym_level/level",20);
        set("jiali", 400 + random(200));
        set("combat_exp", 500000000 + random(300000000));     
        set_skill("force", 1000 + random(300));
        set_skill("dodge", 1000 + random(300));
        set_skill("parry", 1000 + random(300));
        set_skill("sword", 1000 + random(300));
        set_skill("unarmed", 1000 + random(300));
        set_skill("dabei-zhang", 1000 + random(300));
        set_skill("damo-force", 1000 + random(300));
        set_skill("langzi-sword", 1000 + random(300));
        set_skill("piaomiao-shenfa", 1000 + random(300));
        map_skill("unarmed", "dabei-zhang");
        map_skill("force", "damo-force");
        map_skill("dodge", "piaomiao-shenfa");
        map_skill("parry", "dabei-zhang");
        map_skill("sword", "langzi-sword");
        prepare_skill("sword","langzi-sword");

    	set("chat_msg_combat", ({
        (: perform_action, "sword.huitou" :),
        (: perform_action, "sword.xia" :),
       
         }) );        
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();

}

void init()
{
	object npc=this_object();
	object me=this_player();

	if(!userp(me)) return;
	
	npc->kill_ob(me);
}

void die()
{
	object me,ob,jjmem,item,room;
	mapping jj;
	int i,size,level,exp,rand,pot;
	string file;

	ob = this_object();                                //获得本物件
	me = ob->query_temp("last_damage_from");           //获得杀死本物件的ID
	room = environment(ob);
        if(!me) { destruct(ob);  return; }

	if(!room->is_mirror() || !userp(me))
	{
		destruct(ob);
		return;
	}
	room->add("make_boss",1);
	room->add("killer",1);
	//奖励
	rand = random(100);
	if(rand < 50);
	else if(rand < 70)
	{
		item = new("/clone/money/thousand-gold");
		if(item)
		{
                        item->set_amount(1+random(10));
			item->move(environment(ob));
		}
	}
/*	else if(rand < 99)
	{
		item = new("/clone/misc/cailiao");
		if(item)
		{
                       item->set_name(cailiao_name[0], ({ cailiao_id[0] }));
			item->move(environment(ob));
		}
	}*/

	::die();
}