#include <ansi.h>
inherit NPC;

int is_jinying() { return 1; }

void create() {
  set_name("杀手", ({ "shashou" }));
  set("gender", "男性");
  set("age", 26);
  set("long", "杀手。\n");

  setup();
}

void init() {
  call_out("findPlayer", 5);  //寻敌
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_damage_from");
  object room = (object)ob->query("room");

  room->set("north", 1);
  room->delete("northwest");

  ::die();
}

//函数：寻敌
void findPlayer() {
  object map, *players, ob;
  int i, size, rand;

  ob = this_object();
  map = environment(ob);

  if (!map->is_mirror()) return;

  players = all_inventory(map);

  size = sizeof(players);
  rand = random(size);
  if (userp(players[rand])) ob->kill_ob(players[rand]);
  call_out("findPlayer", 1 + random(5));
}
