#include <ansi.h>
inherit NPC;

string ask_huashan();
string ask_baochou();
string ask_ling();

int is_jingying() { return 1; }

void create() {
  set_name("小师妹", ({ "shimei" }));
  set("title", HIM "华山派女弟子" NOR);
  set("gender", "女性");
  set("age", 26);
  set("long", "华山派的小师妹，总想着自己能变成美丽漂亮的大姑娘。\n");

  set("no_kill", 1);

  set("inquiry", ([
    "华山派": (: ask_huashan :),
    "令胡冲": (: ask_ling :),
    "报仇": (: ask_baochou :),
  ]));

  setup();
}

string ask_huashan() { return "掌门练了避邪剑法，堕入邪魔外道，死于非命，还连累了师母。华山派没有了。\n"; }

string ask_baochou() {
  object room = environment(this_object());
  room->delete("north");
  room->set("west", 1);
  return "华山派解散了以后，我和师哥们打算去马背山退出江湖，没想到会在这里遭此横祸。\n我亲眼看见是东方不败杀他们的，哥哥你一定要替我们报仇\n";
}

string ask_ling() { return "你不就是令胡冲吗？\n"; }
