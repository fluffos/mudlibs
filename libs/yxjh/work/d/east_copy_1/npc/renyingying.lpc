#include <ansi.h>
inherit NPC;

int is_jinying() { return 1; }
string ask_me();

void create() {
  set_name("任盈盈", ({ "ren yingying", "ren" }));
  set("gender", "女性");
  set("age", 26);
  set("long", "一位亭亭玉立，的大姑娘。\n");

  set("no_kill", 1);

  set("inquiry", ([
    "精致的酒壶": (: ask_me :),
  ]));

  setup();
}

void call_tell(object room) { tell_room(room, HIW "其实我知道，你一直都在找我。\n" NOR); }

void init() {
  object me = this_player();
  object room = environment(this_object());
  if (!userp(me)) return;

  call_out("call_tell", 1, room);
}

string ask_me() {
  object me = this_player();
  object item;

  if (!item = present("jiuhu", me)) return "我觉得蓝凤凰的酒壶不错。\n";

  if (me->query("potential") < 2000000000) me->add("potential", 100000000);
  tell_object(me, HIG "你获得了100000000点潜能。\n" NOR);

  destruct(item);
  destruct(this_object());
  return "你身上带的这个酒壶，好精致哦，我拿去玩了!";
}
