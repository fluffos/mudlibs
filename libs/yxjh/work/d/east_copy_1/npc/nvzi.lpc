#include <ansi.h>
inherit NPC;

int is_jinying() { return 1; }
int ask_name();

void create() {
  set_name("女子", ({ "nv zi" }));
  set("gender", "女性");
  set("age", 26);
  set("long", "一位亭亭玉立，美若天仙的女子，举止优雅。\n");

  set("no_kill", 1);

  set("inquiry", ([
    "名字": (: ask_name :),
  ]));

  setup();
}

int ask_name() {
  object me = this_object();
  object room = (object)me->query("room");
  object item;

  if (!room) return 1;
  tell_room(room, HIW "女子避而不答的离开了。\n" NOR);
  room->set("southwest", 1);

  if (random(100) < 10) {
    if (item = new("/d/east_copy_1/item/jiuhu")) {
      tell_room(room, HIW "地上留下了一个精致的酒壶。\n" NOR);
      item->move(room);
    }
  }
  tell_room(room, HIG "空中回荡着女子充满豪气的笑声。\n" NOR);
  destruct(me);
  return 1;
}
