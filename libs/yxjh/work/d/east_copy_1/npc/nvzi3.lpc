#include <ansi.h>
inherit NPC;

int is_jinying() { return 1; }
int ask_name();

void create() {
  set_name("女子", ({ "nv zi" }));
  set("gender", "女性");
  set("age", 26);
  set("long", "一位亭亭玉立，美若天仙的女子，举止优雅。\n");

  set("no_kill", 1);

  set("inquiry", ([
    "名字": (: ask_name :),
  ]));

  setup();
}

void call_love(object me) {
  tell_object(me, HIG "你让诗诗躺下，用手轻轻抚摸她。\n俩人共度良辰。\n" NOR);
  me->unconcious();
  environment(me)->set("northwest", 1);
}

int ask_name() {
  object me = this_player();

  if (!userp(me)) return 0;

  tell_object(me, "女子：我叫诗诗。世事难测，人生苦短。大家都是同道中人，只求一宵，何必多问。\n");
  this_object()->set_name("诗诗", ({ "shishi" }));
  call_out("call_love", 2, me);

  return 1;
}
