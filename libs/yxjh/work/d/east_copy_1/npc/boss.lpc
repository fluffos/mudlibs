#include <ansi.h>
inherit NPC;

#define PRODUCT "/clone/shoufei/product"
#define EQUIP_UP "/adm/item/equip"

int is_boss() { return 1; }

void create()
{
	set_name("扶桑统帅", ({ "tongshuai"}));
	set("title",HIR"烧光 杀光 抢光"NOR);
	set("gender", "男性");
	set("age",26);
	set("long", "他是一位扶桑统帅，统领扶桑大军前来侵犯中原。\n");

	setup();
//	carry_object("/clone/misc/hic_cloth")->wear();
}

void init()
{
	object ob,me,*inv,obj;
	int i,j;
	mapping skill_status,map_status,ob_data,my_data;
	string *sname,*mname;

	ob = this_player();
	me = this_object();
	if(!me->query("skill") && objectp(ob) && userp(ob))
	{
	    if ( mapp(skill_status = ob->query_skills()) )
	    {
	        sname  = keys(skill_status);
	        for(i=0; i<sizeof(skill_status); i++)
	        {
	            me->set_skill(sname[i], skill_status[sname[i]]/2);
	        }
	    }
	    if ( mapp(map_status = ob->query_skill_map()) ) {
	        mname  = keys(map_status);
	        for(i=0; i<sizeof(map_status); i++) {
	            me->map_skill(mname[i], map_status[mname[i]]);
	        }
	    }
	    if ( mapp(map_status = ob->query_learned()) ) {
	        mname  = keys(map_status);
	        for(i=0; i<sizeof(map_status); i++) {
	            skill_status=([ mname[i]: map_status[mname[i]] ]);
	        }
	    }

	    ob_data=ob->query_entire_dbase();

	    me->set("max_neili",ob_data["max_neili"]);
	    me->set("max_jingli",ob_data["max_jingli"]);
	    me->set("neili",ob_data["neili"]);
	    me->set("jingli",ob_data["jingli"]);
	    me->set("max_qi",ob_data["max_qi"]);
	    me->set("max_jing",ob_data["max_jing"]);
	    me->set("eff_qi",ob_data["eff_qi"]);
	    me->set("eff_jing",ob_data["eff_jing"]);
	    me->set("qi",ob_data["qi"]);
	    me->set("jing",ob_data["jing"]);
	    me->set("jiali",ob_data["jiali"]);
	    me->set("int",ob_data["int"]);
	    me->set("con",ob_data["con"]);
	    me->set("str",ob_data["str"]);
	    me->set("dex",ob_data["dex"]);

	    inv=all_inventory(ob);
	    for (i=0;i<sizeof(inv);i++)
	    {
	    	obj=new(base_name(inv[i]));
	    	obj->move(me);
	    	if( inv[i]->query("weapon_prop") &&  inv[i]->query("equipped") ) obj->wield();
	    	else if( inv[i]->query("armor_prop") &&  inv[i]->query("equipped") ) obj->wear();
	    }

	    me->set("skill",1);
	    me->set("jym_level/level",ob->query_level());
	}
	call_out("findPlayer",5); //寻敌
}

void dest_world(object memory)
{
	if(!memory) return;
	memory->delete_map();
	destruct(this_object());
}

void die()
{
	object me,ob,memory,item;
	object *team;
	int i,size,level,exp,rand,pot;
	string file;

	ob = this_object();
	me = ob->query_temp("last_damage_from");
//	team = me->query_team();
//	memory = (object)me->query_temp("mirror/mirror_memory");

	if(me && userp(me))
	{
		team = me->query_team();
		if(!pointerp(team) || !sizeof(team)) team = ({ me });
		memory = (object)me->query_temp("mirror/mirror_memory");
	}

	if(!clonep(memory) || !team)
	{
		memory = environment(ob)->query("memory");
		if(clonep(memory)) memory->delete_map();
		destruct(ob);
		return;
	}
	if(random(100)<70) command("say 中原武林果真是无法征服的吗？可能天皇真的低估了中原。");
	else if(random(100)<40) command("say 等等！不用你们动手，我自己来，就留点自尊给扶桑国天皇吧。");
	else command("say 我错了!我本不该来，因为我不是你的对手。");
	tell_room(environment(ob),"扶桑统帅，啊... 一声大叫。叫完便"HIR"剖腹自尽"NOR"了。\n");

	size = sizeof(team);
	for(i=0;i<size;i++)
	{
		if(!team[i]) continue;
		level = team[i]->query("jym_level/level");
		exp = 5000*(1+random(level))/size;
		
		if(exp)
		{
			pot = exp/2;
			tell_object(team[i],sprintf("你获得了%d点经验，%d点潜能。\n",exp,pot));
			tell_object(team[i],HIY"【号令天下】恭喜你挑战镜像成功！请拾取物品，镜像将在1分钟后关闭。\n"NOR);
			ADD_EXP(team[i],exp);
			team[i]->add("potential",pot);
		}
	}
	
	//掉宝
        rand = random(5000);
	level = ob->query_level();
	if(level > 150) level = 150;
	if(rand < 10) file = PRODUCT->get_random_level_product(1+random(15),level-5,level);
	else if(rand < 5) file = PRODUCT->get_random_level_product(1+random(15),level,level+5);

	if(file)
	{
		item = new(file);
		if(item)
		{
			item->set("_name",item->name());
			EQUIP_UP->init_equip_prop_1(item);
//			EQUIP_UP->init_equip_prop_2(item);
//			EQUIP_UP->init_equip_prop_3(item);
			item->move(environment(ob));
		}
	}
	if(rand < 90) { item = new("/clone/shoufei/item/liuxing"); if(item) item->move(environment(ob)); }
	if(rand < 80) { item = new("/clone/shoufei/item/longzhu"); if(item) item->move(environment(ob)); }
	if(rand < 70) { item = new("/clone/shoufei/item/hongyu"); if(item) item->move(environment(ob)); }
	if(rand < 60) { item = new("/clone/shoufei/item/tianyuan"); if(item) item->move(environment(ob)); }
	if(rand < 50) { item = new("/clone/shoufei/item/tiangang1"); if(item) item->move(environment(ob)); }
	if(rand < 45) { item = new("/clone/shoufei/item/tiangang2"); if(item) item->move(environment(ob)); }
	if(rand < 40) { item = new("/clone/shoufei/item/tiangang3"); if(item) item->move(environment(ob)); }
	if(rand < 35) { item = new("/clone/shoufei/item/tiangang4"); if(item) item->move(environment(ob)); }
	if(rand < 30) { item = new("/clone/shoufei/item/longhen1"); if(item) item->move(environment(ob)); }
	if(rand < 25) { item = new("/clone/shoufei/item/longhen2"); if(item) item->move(environment(ob)); }
	if(rand < 20) { item = new("/clone/shoufei/item/longhen3"); if(item) item->move(environment(ob)); }
	if(rand < 10) { item = new("/clone/shoufei/item/longhen4"); if(item) item->move(environment(ob)); }
	memory->quest_over();
	destruct(ob);
}

//函数：寻敌
void findPlayer()
{
	object map,*players,ob;
	int i,size,rand;
	
	ob = this_object();
	map = environment(ob);

	if(!map->is_mirror()) return;

	players = all_inventory(map);
	
	size = sizeof(players);
	rand = random(size);
	if(userp(players[rand])) ob->kill_ob(players[rand]);
	call_out("findPlayer",1+random(30));
}
