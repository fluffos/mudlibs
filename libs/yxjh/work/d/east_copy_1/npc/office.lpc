#include <ansi.h>
inherit NPC;

#define MIRROR_SYS "/d/east_copy_1/sys/mirror_sys"

int ask_job();

void create() {

  set_name("副本管理员", ({ "copy man", "man" }));
  set("title", YEL "笑傲江湖之东方不败" NOR);

  set("gender", "男性");
  set("age", 26);
  set("long", "他是一位副本管理员。\n");

  set("inquiry", ([
    "进入副本": (: ask_job :),
  ]));

  setup();
  carry_object("/clone/misc/changpao")->wear();
}

int ask_job() {
  object me;
  object *team, memory;

  me = this_player();

  if (MIRROR_SYS->query_room_amount() >= 20) {
    tell_object(me, "镜像已经开启太多，欢迎下次参与。\n");
    return 1;
  }
  if (me->query_level() < 60) {
    tell_object(me, "等级不足60级无法创建副本。\n");
    return 1;
  }

  if (!me->is_team_leader()) {
    team = me->query_team();
    if (!pointerp(team) || !sizeof(team)) team = ({ me });

    //	tell_object(me,"你不是领队。\n");
    //	return 1;
  } else team = me->query_team();

  //	tell_object(me,sprintf("%d   %d \n",pointerp(team),sizeof(team)));
  if (!pointerp(team) || sizeof(team) < 1) {
    tell_object(me, "你的人手不够。\n");
    return 1;
  }

  //删除旧的副本
  memory = me->query_temp("mirror/mirror_memory");
  if (objectp(memory)) {
    memory->delete("user_id");
  }
  //创建新的副本
  MIRROR_SYS->mirror(team, me);
  return 1;
}
