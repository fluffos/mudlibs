//edit by rock
//2008.10.20

#include <ansi.h>
inherit NPC;

object NextRoom;
int is_boss() { return 1; }
string ask_name();
string ask_go();
string ask_yang();
string ask_dong();
int do_kan(string arg);

void create()
{
	set_name("任我行", ({ "ren woxing"}));
	set("gender", "男性");
	set("age",56);
	set("long", "传说中的日月神教教主，后来不明原因失踪。\n");

	set("inquiry", ([ 
		"任我行" : (:ask_name:), 
		"逃出去" : (:ask_go:), 
		"杨连廷" : (:ask_yang:), 
		"东方不败" : (:ask_dong:), 
		]));

	set("no_kill",1);

	setup();
}

string ask_name() { return "不错我就是任我行，你不怕我吗？\n"; }

string ask_yang() { return "他还好吗？一定被东方老贼迫害了吧！\n"; }

string ask_dong() { return "东方不败，我要让你有口无舌！有眼无珠！求生不能！求死不得！\n"; }

string ask_go() { return "逃出去？哈哈，谈何容易，我被这副追魂琵琶钩钉的牢牢的，\n根本动弹不得。\n"; }

void init()
{
	object me=this_player();

	if(!userp(me)) return;

	if(!NextRoom) NextRoom = (object)me->query_temp("gotoRoom");
	add_action("do_kan", "kan"); 
}

void make_npc()
{
	object npc=this_object();
	object room=environment(npc);
	object *inv;
	int i,size;

	tell_room(room,HIR"日月神教教众看起来想杀死你！\n"NOR);
	tell_room(room,HIR"日月神教教众看起来想杀死你！\n"NOR);
	tell_room(room,HIW"任我行运起吸「星大法」，一股气浪卷向日月神教教众的头部。\n"NOR);
	tell_room(room,HIG"任我行看起来年轻了不少。\n"NOR);
	tell_room(room,"日月神教教众扑在地上挣扎了几下，腿一伸，口中喷出几口"HIR"鲜血"NOR"，死了！\n");
	tell_room(room,HIW"任我行一招「海纳百川」，击向日月神教教众的右肩。\n"NOR);
	tell_room(room,"( 日月神教教众"HIR"受伤过重，已经有如风中残烛，随时都可能断气。"NOR" )\n");
	tell_room(room,HIG"任我行看起来年轻了不少。\n"NOR);
	tell_room(room,"日月神教教众惨叫一声，死了。\n");
	tell_room(room,HIM"\n任我行运起轻功拉起你，往外奔去。\n"NOR);
	inv = all_inventory(room);
	size = sizeof(inv);
	
	if(!NextRoom) return;
	npc->move(NextRoom);
	for(i=0;i<size;i++)
	{
		if(userp(inv[i])) inv[i]->move(NextRoom);
	}
}

int do_kan(string arg)
{
	object me=this_player();
	object npc=this_object();
	object weapon = (object)me->query_temp("weapon");
	object room=environment(npc);

	if(npc->query("Is_OK")) return 0;
	if(!arg || arg != "suolian" || !weapon || !weapon->query_xy() || weapon->query("zhiliang") <= 55)
	{
		tell_room(room,sprintf(HIR"%s用全力向铁链劈去。\n"NOR,me->query("name")));
		tell_room(room,"铁链丝毫未动。\n");
		return 1;
	}
	tell_room(room,HIR"铁链“砰”一声被震碎。\n"NOR);
	npc->set("Is_OK",1);
	call_out("make_npc",3);
	tell_room(room,HIW"地牢外一阵骚动，想是有人来了。\n"NOR);
	return 1;
}