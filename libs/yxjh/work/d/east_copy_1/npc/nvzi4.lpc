#include <ansi.h>
inherit NPC;

int is_boss() { return 1; }

//#include <cailiao.h>
object *npcs = ({});

void create() {
  set_name("女子", ({ "nv zi" }));
  set("gender", "女性");
  set("age", 26);
  set("long", "一位亭亭玉立，美若天仙的女子，举止优雅。\n");

  set("no_kill", 1);

  setup();
}

void init() {
  object me = this_player();
  if (!userp(me)) return;

  add_action("do_look", "look");
}

void call_tell(int index) {
  object npc = this_object();
  object room = environment(npc);
  object *inv;
  int i, size;

  switch (index) {
    case 1:
      tell_room(room, "任我行走了过来。\n向问天走了过来。\n小师妹走了过来。\n任盈盈走了过来。\n");
      call_out("call_tell", 1, 2);
      break;
    case 2:
      tell_room(room, HIG "任我行" NOR + YEL "说道：" WHT "东方不败？你竟然变成这副模样。哈哈哈。\n" NOR);
      call_out("call_tell", 1, 3);
      break;
    case 3:
      tell_room(room, HIG "任盈盈" NOR + YEL "说道：" WHT "他真的就是东方不败？\n" NOR);
      tell_room(room, HIG "任我行" NOR + YEL "说道：" WHT "哈哈哈,盈盈还不快叫“东方叔叔”，不应该是“东方阿姨”。\n" NOR);
      npc->set_name("东方不败", ({ "dongfang bubai" }));
      npc->set("telete", YEL "日月神教教主" NOR);
      call_out("call_tell", 1, 4);
      break;
    case 4:
      tell_room(room, HIW "你禁不住心头一惊问道：那天和我共度春宵的人，是不是你？\n" NOR);
      tell_room(room, HIG "任我行" NOR + YEL "说道：" WHT "哈哈哈,你们两个大男人洞房？哈哈哈，笑话！\n" NOR);
      call_out("call_tell", 1, 5);
      break;
    case 5:
      tell_room(room, HIG "任我行" NOR + YEL "说道：" WHT "别跟他那么多废话，这对琵琶钩，今天还给你。\n" NOR);
      for (i = 0; i < 4; i++) {
        if (npcs[i]) npcs[i]->kill_ob(npc);
      }
      call_out("call_tell", 2, 6);
      break;
    case 5:
      tell_room(room, HIG "任我行" NOR + YEL "说道：" WHT "别跟他那么多废话，这对琵琶钩，今天还给你。\n" NOR);
      for (i = 0; i < 4; i++) {
        if (npcs[i]) npcs[i]->kill_ob(npc);
      }
      call_out("call_tell", 2, 6);
      break;
    case 6:
      tell_room(room, HIG "东方不败" NOR + YEL "说道：" WHT "我对你处处留手，就是不希望伤害到你，你为何以怨报德。\n" NOR);
      inv = all_inventory(room);
      size = sizeof(inv);
      for (i = 0; i < size; i++) {
        if (userp(inv[i])) npc->kill_ob(inv[i]);
      }
      break;
  }
}

int do_look(string arg) {
  object me = this_player();
  object npc = this_object();
  object room = environment(npc);
  object obj;

  if (!arg || arg != npc->query("id") || npc->query("do_look")) return 0;

  npc->set("do_look", 1);

  if (obj = new("/d/east_copy_1/npc/renwoxing2")) {
    obj->move(room);
    npcs += ({ obj });
  }
  if (obj = new("/d/east_copy_1/npc/renyingying2")) {
    obj->move(room);
    npcs += ({ obj });
  }
  if (obj = new("/d/east_copy_1/npc/shimei2")) {
    obj->move(room);
    npcs += ({ obj });
  }
  if (obj = new("/d/east_copy_1/npc/xiangwentian2")) {
    obj->move(room);
    npcs += ({ obj });
  }
  call_out("call_tell", 1, 1);
  return 0;
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_damage_from");
  object room = environment(ob);
  object memory = (object)room->query("memory");
  object item;
  int rand;

  if (!memory) destruct(ob);

  command("cry");
  command(sprintf("chat %s我要你记得我，让你后悔一辈子。", me->query("name")));

  tell_room(room, "东方不败猛然跳下悬崖。\n");
  //奖励
  if (item = new("/u/rock/item/zhen-ju")) item->move(room);

  rand = random(100);
  if (rand < 50);
  else if (rand < 70) {
    item = new("/clone/money/thousand-gold");
    if (item) {
      item->set_amount(1 + random(10));
      item->move(room);
    }
  } else if (rand < 99) {
    item = new("/u/rock/item/zhen-ju");
    if (item) {
      //			item->set_name(cailiao_name[0], ({ cailiao_id[0] }));
      item->move(room);
    }
  }
  memory->quest_over();
  destruct(ob);
}
