inherit ROOM;
void create()
{
	set("short", "葵花舍");
	set("long", @LONG
    这里是一个大花园，都是葵花，奇怪的是这些葵花的花瓣都是桃红色，非
常漂亮，娇艳欲滴，阵阵花香令人神清气爽。
LONG
	);
        set("outdoors", "city");

	set("exits", ([
		"northwest" : __DIR__"shanjiao",
	]));

	setup();
}

void init()
{
	object room=this_object();
	object me=this_player();
	object next_room = (object)room->query("exits/northwest");
	object *inv,corpse,npc;
	int i,size;
	string *name = ({"陆大有","施戴子","劳德诺","陆猴儿"});

	if(!userp(me)) return;

	if(!room->query("make_corpse"))
	{
		next_room->set("no_north",1);
//		inv=all_inventory(next_room);
//		size=sizeof(inv);
//		for(i=0;i<size;i++) destruct(inv[i]);

		if(npc=new("/d/east_copy_1/npc/nvzi3")) npc->move(room);
		for(i=0;i<4;i++)
		{
			corpse = new(CORPSE_OB);
			corpse->set_name(name[i]+"的尸体",({"corpse"}));
			corpse->set("long", name[i]+"然而他已经死了，只剩下一具尸体静静地躺在这里。\n");
			corpse->set("gender", "男性");
			corpse->set("victim_name", name[i]);

			corpse->set("age", 27);
			corpse->set_weight(50000000);
			corpse->set_max_encumbrance(14000000);
			corpse->set("no_get");
			corpse->move(next_room);
		}

		if(npc=new("/d/east_copy_1/npc/shimei")) npc->move(next_room);
		room->set("make_corpse",1);
	}
}

int valid_leave(object me,string dir)
{
	object room=this_object();

	if(!room->query(dir)) return notify_fail("这里不适合到处乱跑。\n");
	else return::valid_leave(me, dir);
}

//是镜像
int is_mirror() { return 1; }