inherit ROOM;
string look_out();
void create()
{
    set("short", "世界之巅");
    set("long", @LONG
这里就是之巅。尽管山风吹人欲倒，可是在云海里漫步，还是让人有飘飘欲仙的感觉。
不知道跳到云头上，会是怎样的感觉？
LONG
    );
    set("exits", ([
    	"down" : __DIR__"guangchang",
    ]));
    set("item_desc", ([
        "down"       :   (: look_out :),
    ]));
    setup();
}
void init()
{
    add_action("do_out", "jump");
}
int do_out(string arg)
{
    object me = this_player();

	if( !arg || arg != "down") return notify_fail("你要往哪个方向跳？\n");

	message("vision",me->name() + "大喊一声，一个纵身跳了下去。\n",environment(me), ({me}) );
    me->move(__DIR__"guangchang");
	message("vision","只听『砰』地一声巨响，一团物体从天上掉了下来，你定眼一看原来是，"+me->name() + "。\n",environment(me), ({me}) );   
    if (wizardp(me))
    {
        me->command("unset immortal");
        me->command("unset invisibility");
        me->command("chat 啊～～～");
        me->delete_temp("last_damage_from");
        me->die();
        return 1;
    }
    return 1;
}

int valid_leave(object me, string dir)
{
       if( dir=="down" && !wizardp(me))
        return notify_fail("这里没法直接下去，看来只能跳(jump)下去了。\n");

        else return 1;
}

string look_out()
{
	return "下面片片白云，远处群山连绵，扬州就在脚下，透过云层看起来灰灰的小一块。\n";
}