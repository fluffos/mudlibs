#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIC"炼丹炉"NOR, ({ "liandan lu" }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
    		set("long","一个巨大的炼丹炉，书上说这个炉子以前在天宫，炼过孙悟空。\n");
            set("unit", "个");
            set("no_get",1);
            set("no_sell",1);
            set("no_give",1);
            set("no_save",1);
    }
    setup();
}