// edit by rock&jym
// 2005.02.21

inherit NPC;
string ask_me();
int ask_pk(object me);
void create() {
  set_name("谭友纪", ({ "tan youji", "tan" }));
  set("title", "知府师爷");
  set("gender", "男性");
  set("age", 57);
  set("combat_exp", 30000);
  set_skill("unarmed", 50);
  set_skill("dodge", 60);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set_temp("apply/damage", 20);
  set("shen_type", 0);
  set("inquiry", ([
    "叫化鸡": (: ask_me :),
    "杀人": (: ask_pk :)
  ]));
  setup();
  carry_object("/clone/misc/hic_cloth2")->wear();
}
void init() {
  add_action("do_pkid", "pkid");
  add_action("do_chakan", "chakan");
}
string ask_me() {
  if ((int)this_player()->query_temp("marks/鸡")) {
    say("好小子，你怎么知道我喜欢吃叫化鸡？\n");
    command("lick");
    say("既然你我成了食友，我就告诉你吧。付耳过来！\n");
    command("whisper " + this_player()->query("id") + " 你去北京找全聚德的老板，只要告诉他是我叫你去的，他就会...");
    this_player()->delete_temp("marks/鸡");
    this_player()->set_temp("marks/鸡2", 1);
    return "今天嗯....啊....那个天气很好....\n";
  } else if ((int)this_player()->query_temp("marks/鸡2"))
    return "我是个浙江人，也没有你那么罗嗦！\n";
  else
    return "泥缩丝米偶钉布懂\n";
}

int ask_pk(object me) {
  me = this_player();

  write(HIR "你想杀人？这可是犯法的事，不过如果有钱的话，我可以\n"
    +HIR "帮你去疏通疏通，现在市场价是一百枚元宝一天，如\n"
    +HIR "果你真的想要杀他的话，请输入pkid <对方的ID名> <几天>\n"
    +HIR "（必须是数字）\n");

  me->set_temp("pkid", 1);

  return 1;
}

int do_pkid(string arg) {
  object me, ob;
  int str, rock;
  string obid;

  me = this_player();
  rock = me->query("jym_money");
  if (sscanf(arg, "%s %d", obid, str) == 2);
  else return notify_fail("pkid <对方的ID名> <几天>？\n");

  ob = find_player(obid);

  if (!ob) return notify_fail("你要杀的人并不在线!!!\n");

  if (str < 1) return notify_fail("至少要杀一天!!!\n");

  if (rock < 5000 * str) return notify_fail("你身上的钱不够!!!\n");

  me->set("pk/id", obid);
  me->set("pk/time", time() + 86400 * str);
  ob->set("pk/id", me->query("id"));
  ob->set("pk/time", time() + 86400 * str);
  me->add("jym_money", -str * 5000);
  me->delete_temp("pkid");
  write("申请成功，从现在开始你将开始追杀" + obid + str + "天!\n");
  message("vision", HIR "【PK之窗】" NOR + ":" + HIG " 听说" HIW + me->name()
    +HIG "买通官府准备追杀" + ob->name() + str + HIG "天了!\n" NOR, users());
  return 1;
}
int do_chakan() {
  object me;

  me = this_player();

  if (!me->query("pk"))
    return notify_fail("你又没有在追杀人怎么查看啊？？？\n");

  write(HIR "你现在正在追杀" + me->query("pk/id") + "!\n");
  write(HIG "还有" + (me->query("pk/time") - time()) + "秒的时间可以杀\n" NOR);

  return 1;
}
