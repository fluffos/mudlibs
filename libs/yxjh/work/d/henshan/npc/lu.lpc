// lu.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("鲁连荣", ({ "lu lianrong", "lu", "lianrong" }) );
        set("nickname", HIY"金眼雕"NOR);
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 45);
        set("attitude", "peaceful");
        set("per", 130);
        set("str", 260);
        set("con", 300);
        set("dex", 300);
        set("int", 280);

        set("neili", 14000);
        set("max_neili", 14000);
        set("jiali", 300);
        set("max_qi",15000);
        set("max_jing",8000);
        set("combat_exp", 6000000);
        set("shen_type", 1);

        set_skill("unarmed", 800);
        set_skill("sword", 800);
        set_skill("force", 800);
        set_skill("parry", 800);
        set_skill("dodge", 800);
        set_skill("hengshan-sword", 800);
        set_skill("lingxu-bu", 800);
        set_skill("literate", 100);
	set_skill("henshan-force",800);

        map_skill("force", "henshan-force");
        map_skill("sword", "hengshan-sword");
        map_skill("parry", "hengshan-sword");
        map_skill("dodge", "lingxu-bu");

        create_family("衡山派", 13, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob) 
{
	command("recruit " + ob->query("id")); 
} 

