#include <ansi.h>
inherit NPC;

#define SYSTEM_BUY "/u/rock/shoufei/include/buy.lpc"
#define JJ_SYS "/d/jjfb/jsys/jj_sys"

int ask_job();

void create() {

  set_name(HIW "副本管理员" NOR, ({ "copy man", "man" }));
  set("title", HIR "英雄副本" NOR);

  set("gender", "男性");
  set("age", 26);
  set("long", "他是一位副本管理员。\n");

  set("inquiry", ([
    "挑战英雄副本": (: ask_job :),
  ]));

  set("vendor_goods", ([
    "/u/rock/return_obj/yx_quan": 2000,     //英雄副本门票
    "/u/rock/return_obj/tz_quan": 8000,     //套装副本门票
  ]));

  setup();
  carry_object("/clone/misc/changpao")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

int do_list() {
  object me, npc;
  me = this_player();
  npc = this_object();

  if (SYSTEM_BUY->do_list(me, npc)) return 1;
  else {
    tell_object(me, "对不起,现在没有东西出售。\n");
    return 1;
  }
}

int do_buy(string arg) {
  object me, npc;
  me = this_player();
  npc = this_object();

  if (!arg) {
    tell_object(me, "你想买什么？\n");
    return 1;
  }

  return SYSTEM_BUY->do_buy(me, npc, arg);
}

int ask_job() {
  object me, item, jjmem;

  me = this_player();

  if (!item = present("yx quan", me)) {
    tell_object(me, "没有门票不得入内！门票可在扬州送信任务中获得，或在我这里购买，list 查看。\n");
    return 1;
  }

  destruct(item);

  /*	if(!me->query("jym_level/vip"))
	{
       tell_object(me, HIG"呵呵～,你不是vip不能进入，加入vip以后再说来吧！\n"NOR);
                 	return 1;
    }
        if(me->query_level() <= 19)
	{
      tell_object(me, HIG"你没到20级，以后再来吧！\n"NOR);
                 	return 1;
    }
    
        if(me->query_level() >= 120)
	{
      tell_object(me, HIY"120级还来这里做什么。\n"NOR);
                 	return 1;
    }  */
  /*
	if(JJ_SYS->query_room_amount() >= 20)
	{
	tell_object(me,"镜像已经开启太多，欢迎下次参与。\n");
		return 1;
	}
*/
  //删除旧的副本
  jjmem = me->query_temp("jroom/jjfb_jjmem");
  if (objectp(jjmem)) {
    jjmem->delete("user_id");
  }
  //创建新的副本
  JJ_SYS->jjfb(me);
  return 1;
}
