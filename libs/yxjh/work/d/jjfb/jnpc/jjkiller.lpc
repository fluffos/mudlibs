#include <ansi.h>
inherit NPC;

#define PRODUCT "/clone/shoufei/product"

//int is_jinying() { return 1; }

void create()
{
	set_name(HIW"亡灵"NOR, ({ "wanlin"}));
	set("gender", "无性");
	set("age",26);
	set("long", "他是一位亡灵，心魔的手下。\n");
        set("attitude", "aggressive");
        set("no_update", 1);
        set("str", 200 + random(60));
        set("int", 200 + random(60));
        set("con", 200 + random(60));
        set("dex", 200 + random(60));
        set("kar", 200 + random(60));
	set("shen_type", -1);
        set("qi", 1700000 + random(300000));
        set("max_qi", 1700000 + random(300000));
        set("jing", 1000000 + random(300000));
        set("max_jing", 1000000 + random(300000));
        set("neili", 500000 + random(300000));
        set("max_neili", 500000 + random(300000));
        set("max_jingli", 500000 + random(300000));
        set("jingli", 200000 + random(300000));
        set("jym_level/level",20);
        set("jiali", 400 + random(200));
        set("combat_exp", 500000000 + random(300000000));     
        set_skill("force", 1000 + random(300));
        set_skill("dodge", 1000 + random(300));
        set_skill("parry", 1000 + random(300));
        set_skill("sword", 1000 + random(300));
        set_skill("unarmed", 1000 + random(300));
        set_skill("dabei-zhang", 1000 + random(300));
        set_skill("damo-force", 1000 + random(300));
        set_skill("langzi-sword", 1000 + random(300));
        set_skill("piaomiao-shenfa", 1000 + random(300));
        map_skill("unarmed", "dabei-zhang");
        map_skill("force", "damo-force");
        map_skill("dodge", "piaomiao-shenfa");
        map_skill("parry", "dabei-zhang");
        map_skill("sword", "langzi-sword");
        prepare_skill("sword","langzi-sword");

    	set("chat_msg_combat", ({
        (: perform_action, "sword.huitou" :),
        (: perform_action, "sword.xia" :),
       
         }) );        
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();

}

void init()
{
	
	call_out("findPlayer",5); //寻敌
}

void die()
{
	object me,ob,jjmem,item;
	mapping jj;
	int i,size,level,exp,rand,pot,pinzhi=1;
	string file;

	ob = this_object();                                //获得本物件
	me = ob->query_temp("last_damage_from");           //获得杀死本物件的ID
	jjmem = (object)me->query_temp("jjfb/jjfb_jjmem"); //获得玩家身上的内存

	if(!clonep(jjmem) || !me || !userp(me))
	{
		tell_room(environment(ob),HIM"亡灵逃跑了。\n"NOR);
		destruct(ob);
		return;
	}

        jjmem->add("make_jjboss",1);
	tell_room(environment(ob),HIM"轰~~~~！\n亡灵消失了。\n"NOR);

	level = me->query("jym_level/level");
        exp = 50 * (1+random(level));

	if(exp)
	{
		pot = exp/3;
		tell_object(me,sprintf("你获得了%d点经验，%d点潜能。\n",exp,pot));
		ADD_EXP(me,exp);
		me->add("potential",pot);
	}

	//掉宝
	rand = random(2000);

//	if(rand < 10) file = PRODUCT->get_random_level_product(1+random(15),me->query("jym_level/level")-5,me->query("jym_level/level"));
//	else if(rand < 5) file = PRODUCT->get_random_level_product(1+random(15),me->query("jym_level/level"),me->query("jym_level/level"));

	if(rand < 10) file = PRODUCT->get_random_level_product(1+random(15),0,1+random(120));

	if(file)
	{
		item = new(file);
		if(item)
		{
			ob = this_object();  //NPC
			item->set("_name",item->query("name"));
			item->set("level",10+random(200));
			rand = 10+random(25);
			for(i=0;i<rand;i++)
			{
				if(pinzhi == 1)
				{
					"/adm/item/equip"->init_equip_prop_1(item);  //变更装备品质
					pinzhi++;
				}
				else if(pinzhi == 2)
				{
					"/adm/item/equip"->init_equip_prop_2(item);  //变更装备品质
					pinzhi++;
				}
				else if(pinzhi == 3)
				{
					"/adm/item/equip"->init_equip_prop_3(item);  //变更装备品质
					pinzhi = 1;
				}
			}
			item->set("zhiliang",i);
			//item->set("locktime",time()+259200); //72小时
			item->set("need_time",3);
			item->set("jianding",1); //设置未鉴定
			item->move(environment(ob));
		}
	}
/*        rand = random(1000);
		if(rand > 15)
	{
		item = new("/clone/money/thousand-gold");
		if(item)
		{
			item->set_amount(1+random(1));
			item->move(environment(ob));
		}
	}*/
/*        else if(rand > 4)
	{
		item = new("/d/jjfb/jobj/perwan");
		if(item)
		{
			item->move(environment(ob));
		}
         }
         else if(rand > 3)
	{
		item = new("/d/jjfb/jobj/karwan");
		if(item)
		{
			item->move(environment(ob));
		}
         }
        else if(rand > 2)
	{
		item = new("/d/jjfb/jobj/npcjinglidan");
		if(item)
		{
			item->move(environment(ob));
		}
         }
        else if(rand > 1)
	{
		item = new("/d/jjfb/jobj/npcneilidan");
		if(item)
		{
			item->move(environment(ob));
		}
         }*/
	destruct(ob);
}

//函数：寻敌
void findPlayer()
{
	object map,*players,ob;
	int i,size,rand;
	
	ob = this_object();
	map = environment(ob);
	players = all_inventory(map);
	
	size = sizeof(players);
	rand = random(size);
	if(userp(players[rand])) ob->kill_ob(players[rand]);
	call_out("findPlayer",1+random(5));
}
