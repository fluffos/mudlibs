// qing.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create() {
  set_name("仪清", ({ "yi qing", "qing" }));
  set("gender", "女性");
  set("class", "bonze");
  set("age", 35);
  set("attitude", "peaceful");
  set("per", 24);
  set("str", 26);
  set("con", 30);
  set("dex", 30);
  set("int", 28);

  set("neili", 14000);
  set("max_neili", 14000);
  set("jiali", 300);
  set("max_qi", 10000);
  set("max_jing", 8000);
  set("combat_exp", 500000);
  set("shen_type", 1);

  set_skill("unarmed", 190);
  set_skill("sword", 190);
  set_skill("force", 190);
  set_skill("parry", 190);
  set_skill("dodge", 190);
  set_skill("hengshan-jian", 190);
  set_skill("lingxu-bu", 190);
  set_skill("literate", 170);
  set_skill("hengshan-xinfa", 170);

  map_skill("force", "hengshan-xinfa");
  map_skill("sword", "hengshan-jian");
  map_skill("parry", "hengshan-jian");
  map_skill("dodge", "lingxu-bu");

  create_family("恒山派", 14, "弟子");
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/shaolin/obj/cheng-cloth")->wear();
}
