// yi.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("定逸师太", ({ "dingyi shitai", "shitai", "dingyi" }) );
        set("gender", "女性");
        set("class", "bonze");
        set("age", 45);
        set("attitude", "peaceful");
        set("per", 24);
        set("str", 26);
        set("con", 30);
        set("dex", 30);
        set("int", 28);

        set("neili", 24000);
        set("max_neili", 24000);
        set("jiali", 3000);
        set("max_qi",20000);
        set("max_jing",12000);
        set("combat_exp", 1000000);
        set("shen_type", 1);

        set_skill("unarmed", 1300);
        set_skill("sword", 1300);
        set_skill("force", 1300);
        set_skill("parry", 1300);
        set_skill("dodge", 1300);
        set_skill("hengshan-jian", 1300);
        set_skill("lingxu-bu", 1300);
	set_skill("literate", 200);
	set_skill("hengshan-xinfa", 1700);

        map_skill("force", "hengshan-xinfa");
        map_skill("sword", "hengshan-jian");
        map_skill("parry", "hengshan-jian");
        map_skill("dodge", "lingxu-bu");

        create_family("恒山派", 13, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}

void attempt_apprentice(object ob) 
{
	if(ob->query("gender") != "女性")
	{
		tell_object(ob,"男女授受不清，本派只收女徒，施主请回吧！\n");
		return;
	}
	command("recruit " + ob->query("id")); 
} 

