// xian.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("定闲师太", ({ "dingxian shitai", "shitai", "dingxian" }) );
        set("gender", "女性");
        set("title", HIB"恒山派第十三代掌门"NOR);
        set("class", "bonze");
        set("age", 45);
        set("attitude", "peaceful");
        set("per", 124);
        set("str", 126);
        set("con", 130);
        set("dex", 130);
        set("int", 128);

        set("neili", 240000);
        set("max_neili", 240000);
        set("jiali", 30000);
        set("max_qi",200000);
        set("max_jing",120000);
        set("combat_exp", 1200000);
        set("shen_type", 1);

        set_skill("unarmed", 7300);
        set_skill("sword", 7300);
        set_skill("force", 7300);
        set_skill("parry", 7300);
        set_skill("dodge", 7300);
        set_skill("hengshan-jian", 7300);
        set_skill("lingxu-bu", 7300);
	set_skill("literate", 300);
	set_skill("hengshan-xinfa", 7300);

        map_skill("force", "hengshan-xinfa");
        map_skill("sword", "hengshan-jian");
        map_skill("parry", "hengshan-jian");
        map_skill("dodge", "lingxu-bu");

        create_family("恒山派", 13, "掌门");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}

void attempt_apprentice(object ob) 
{
	if(ob->query("gender") != "女性")
	{
		tell_object(ob,"男女授受不清，本派只收女徒，施主请回吧！\n");
		return;
	}
	if(ob->query_skill("hengshan-jian",1) < 100)
	{
		tell_object(ob,"你是不是应该在剑法修为方面下点功夫?\n");
		return;
	}
	command("recruit " + ob->query("id")); 
} 

