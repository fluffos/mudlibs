#include <weapon.h>
inherit STAFF;
void create()
{
        set_name(BLU"天雷杖"NOR, ({ "thunder staff","staff" }));
        set_weight(50000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", HIY"你手上的手杖非金非铁，乃是欧阳锋晚年炼制的随身武器，上面有一行小字--雷动九天。\n"NOR);
                set("material", "steel");
                set("wield_msg", HIR"$N"HIR"双手一并，魔术般亮出了白陀山宝器，"NOR + BLU"天雷手杖"HIR"。\n"NOR);
                set("unwield_msg", HIY"$N一声清啸，"NOR + BLU"天雷杖"HIY"抖出团杖影，眨眼消失在$N手中。\n"NOR);
        }
      init_staff(600,1);
        setup();
}

