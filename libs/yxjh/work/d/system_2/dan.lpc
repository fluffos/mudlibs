inherit ITEM;
void create()
{
        set_name(HIG"方舟丹"NOR, ({ "rock dan","dan"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {       
           set("unit", "颗"); 
                set("no_get",1);
                set("no_s",1);             
                set("no_put",1);
                set("no_give",1);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
  object me = this_player();
  int maxneili,neili;
    neili = me->query("neili");
    maxneili = me->query_max_neili();
    
    
 me->add("jym_level/level",10);
 me->set("lingwu",100);
 me->set("name","小狼狼");
       destruct(this_object());
       return 1;
}

