inherit ITEM;
void create()
{
        set_name(HIG"我是老头丹"NOR, ({ "rock dan","dan"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {       
           set("unit", "颗"); 
                set("no_get",1);
                set("no_s",1);             
                set("no_put",1);
                set("no_give",1);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
  object me = this_player();
  int maxneili,neili;
 me->add("mud_age",1800);
 message_vision(HIB"$N突然长大了一些\n"NOR,me);
       destruct(this_object());
       return 1;
}

