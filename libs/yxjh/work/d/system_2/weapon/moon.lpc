// 孤月刀   by:system_2
#include <weapon.h> 
#include <ansi.h>
inherit BLADE;
void create()
{
    set_name(HIR"孤月刀"NOR, ({ "moon blade", "moon","blade" }));
    set_weight(50000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "柄");
        set("long", HIR"刀身狭窄，长度比一般的刀长出一倍，渗渗的血槽里散发着死亡的气息。\n"NOR);
        set("no_give", 1);
        set("flag",1);
        set("material", "steel");
        set("weapon_prop/strength", 30);
        set("wield_msg", HIR "$N将孤月邪刀从刀鞘中抽出，顿时一股寒气从刀身中狂散出来！\n" NOR);
        set("unwield_msg", HIR "$N缓缓将孤月收回，寒气顿减，你觉得呼吸比以前更通畅了。\n" NOR);
    }
    init_blade(800,1);
    setup();
}
int move(mixed dest)
{
        if(! userp(dest))       return ::move(dest);
        if( ::move(dest)==0)    return 0;
         message("channel:rumor",HIY"【魔刀出世】"+ "江湖谣言四起："+
         dest->query("name")+"巧遇奇迹，得到了失传已久的邪刀，孤月刀再现血光！\n"NOR,users());
        return 1;
}


