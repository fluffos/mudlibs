#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIY "财神爷" NOR, ({ "caisheng ye", "caisheng", "ye" }));
  set("nickname", HIR "运财福星" NOR);
  set("gender", "男性");
  set("age", 800);
  set("long", YEL "据说财神爷收了西门无剑的大红包才来替他站岗的，还不快去给他老人家“拜年”？！\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  carry_object("/d/system_2/xx");
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);
  set("no_suck", 1);

  set("inquiry", ([
    "拜年": (: ask_me :),
  ]));
  setup();
}



string ask_me() {
  object ob;
  mapping fam;

  if ((int)this_player()->query("new cloth"))
    return "还想要新衣裳？找西门无剑那小子去吧！";
  else {
    this_player()->set("new cloth", 1);
    ob = new("/d/system_2/cloth");
    ob->move(this_player()); ;

    return "拿去拿去，这就是西门无剑那家伙叫我转交给你们的东东。" NOR;
  }
}
