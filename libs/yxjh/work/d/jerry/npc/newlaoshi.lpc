// u/jerry/npc1/newslaoshi.c
// jerry 2008.10.31
inherit NPC;
#include <ansi.h>

int do_out();

void create()
{
    set_name("新人导师", ({ "news shi", "news", "shi" }));
    set("long", 
        "只见他高额凸颡，容貌奇古，笑眯眯的脸色\n"
        "极为和谟。\n");
    set("gender", "男性");
    set("age", 50);
    set("attitude", "friendly");
    set("shen_type", 1);
    set("str", 28);
    set("int", 28);
    set("con", 28);
    set("dex", 38);
    
    set("max_qi", 1000);
    set("max_jing", 1000);
    set("neili", 1000);
    set("max_neili", 1000);
    set("jiali", 60);
    set("combat_exp", 200000);
    set_skill("literate",1000);
    set_skill("force",1600);
    set_skill("blade",1600);
     set_skill("sword",1600);   
    set_skill("art",1001);
    set_skill("dodge",1600);     
    set_skill("huagong-dafa",7000);
    set_skill("taoism", 1600);
    set_skill("wuhu-duanmendao", 1600);
    set_skill("taixuan-gong", 6500);
    set_skill("unarmed", 1600);
    set_skill("parry", 1600);
    set_skill("beiming-shengong", 7000);
    set_skill("taiji-shengong", 7000);
    set_skill("qimen-flee", 1600);
    set("inquiry", ([
        "出师"  : (: do_out :), 
    ]));

    set("book_count", 1);
    create_family("逍遥派", 99, "弟子");
    set("nickname","武功传递员");
    setup();
    carry_object("/d/xiaoyao/npc/obj/cloth")->wear();

}
void attempt_apprentice(object ob)
{
    if (ob->query_int() < 10) {
        command("shake"+ ob->query("id")); 
        command("say " + RANK_D->query_respect(ob) + 
            "是否还应该在学问上多下点功夫？");
        return;
    }
    command("say 好吧，我就收下你了，今后要多加努力啊！");
    command("recruit " + ob->query("id"));
    ob->set("class","shaman");
 }

int do_out()
{
    object me = this_player();
    if(me->query("family/master_name") == "新人导师" && me->query("family/master_id") == "news shi")
    {
         CHANNEL_D->do_channel(this_object(), "chat",
                sprintf("真不愧是青出于蓝而胜于蓝！%s，你可以出师了，从此另立门户吧！", me->name()));
        me->delete("family");
	me->set("title","普通百姓");
	return 1;
    }
    else
    {
        tell_object(me,"你不是我的弟子啊，认错人了吧。\n");
        return 1;
    }
}
int recruit_apprentice(object ob) 
{
	if( ::recruit_apprentice(ob) )  
		ob->set("title", "新人导师第一代弟子");
}
