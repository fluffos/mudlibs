inherit ROOM;
void create()
{
        set("short", "正堂");
        set("long", @LONG这里是一个非常安静的房间。虽然这里是整个远东镖局的中心，但是人
们走路时也只是脚步轻轻地过往，并不喧哗。里面有几个中年镖师在悄悄
商议着什么事情。
LONG
        );
        set("exits", ([
                "east" : "/d/wudang/wdroad1",
        ]));
set("no_fight",1);
        set("objects", ([
                "/quest/biao/changfeng" : 1,
        ]));
        setup();
}
void reset()
{
    foreach (object ob in all_inventory(this_object()) ){
       if (userp(ob)) return ;
    }
    ::reset();
}

