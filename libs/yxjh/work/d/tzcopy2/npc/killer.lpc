//函数：寻敌
void findPlayer() {
  object map, *players, ob;
  int i, size, rand;

  remove_call_out("findPlayer");

  ob = this_object();
  map = environment(ob);
  players = all_inventory(map);

  size = sizeof(players);
  rand = random(size);
  if (userp(players[rand])) ob->kill_ob(players[rand]);
  call_out("findPlayer", 1 + random(5));
}
