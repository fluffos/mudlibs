void make_killer() {
  object ob = this_object();
  object killer, room;
  int i = 40;

  if (!clonep(ob)) return;
  room = environment(ob);
  if (!room) return;

  while (i--) {
    if (killer = new("/d/tzcopy2/npc/killer")) {
      killer->move(room);
      killer->findPlayer();
    }
  }
}
