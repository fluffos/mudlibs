#include <ansi.h>
inherit NPC;

#define PRODUCT "/clone/shoufei/product"

int is_boss() { return 1; }

void create() {
  int rand = random(100);
  if (rand < 50) set_name("小夜", ({ "boos" }));
  else set_name("方舟", ({ "rock" }));
  set("title", HIR "发狂中" NOR);
  set("gender", "男性");
  set("age", 26);
  set("long", "听说是浴血江湖的巫师，千万不要手下留情。\n");

  setup();
  carry_object("/clone/misc/hic_cloth")->wear();
  carry_object("/d/city2/obj/tudao")->wield();
}

void init() {
  object ob, me, *inv, obj;
  int i, j, index;
  mapping skill_status, map_status, ob_data, my_data;
  string *sname, *mname;

  ob = this_player();
  me = this_object();
  if (!me->query("skill") && objectp(ob) && userp(ob)) {
    index = 250 * 10;
    me->set("per", index);
    me->set("con", index);
    me->set("int", index);
    me->set("dex", index);
    me->set("str", index);

    index = 250;
    me->set("jym_level/level", index);

    me->set("max_qi", index * 30000);
    me->set("max_jing", index * 600);
    me->set("max_jingli", index * 600);
    me->set("max_neili", index * 100000);

    me->set("jiali", index * 20);
    me->set_skill("dodge", index * 159);
    me->set_skill("unarmed", index * 159);
    me->set_skill("parry", index * 159);
    me->set_skill("sword", index * 159);
    me->set_skill("blade", index * 159);
    me->set_skill("staff", index * 159);
    me->set_skill("force", index * 159);
    me->set_skill("taixuan-gong", index * 159);
    me->set_skill("wuhu-duanmendao", index * 159);

    me->set("jingli", index * 600);
    me->set("neili", index * 100000);
    me->set("qi", index * 30000);
    me->set("eff_qi", index * 30000);
    me->set("jing", index * 600);
    me->set("eff_jing", index * 600);

    me->map_skill("force", "taixuan-gong");
    me->map_skill("dodge", "taixuan-gong");
    me->map_skill("parry", "wuhu-duanmendao");
    me->map_skill("blade", "wuhu-duanmendao");

    me->set("skill", 1);
    me->set("jym_level/level", ob->query_level());
    call_out("make_killer", 1800);
  }
  if (userp(ob)) me->kill_ob(ob);
  add_action("do_halt", "halt");
  add_action("do_halt", "yun");
  add_action("do_halt", "exert");
  //	call_out("findPlayer",5); //寻敌
}

int do_halt(string arg) {
  tell_object(this_player(), "现在忙于其他事情，无法完成这个动作。\n");
  return 1;
}

void dest_world(object memory) {
  if (!memory) return;
  memory->delete_map();
  destruct(this_object());
}

