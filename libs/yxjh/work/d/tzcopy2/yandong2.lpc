//edit by rock
// d/tzcopy2/yandong

inherit ROOM;
void create()
{
	set("short", "岩洞尽头");
	set("long", @LONG
	到了这里，忽然豁然开朗，这里应该是这个洞府的尽头了。
LONG
	);
	set("no_fly", 1);

	set("exits", ([
		"southwest" : __DIR__"a10",
		"south"     : __DIR__"b10",
		"southeast" : __DIR__"c10",
	]));

	setup();
}

void init()
{
	object me = this_player();
	object ob = this_object();
	object boss;
	
	if(userp(me) && !ob->query("make_boss"))
	{
		if(boss = new("/d/tzcopy2/npc/boss"))
		{
			boss->move(ob);
			ob->set("make_boss",1);
		}
	}
}

//是镜像
int is_mirror() { return 1; }