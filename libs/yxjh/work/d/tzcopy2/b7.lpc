inherit ROOM;
void create() {
  set("short", "甬道7");
  set("long", @LONG
	一条宽敞的岩洞通道，不知道通向哪里。四周光线昏暗，估计在往里走
一点，就会伸手不见五指。通道的另一头不时传来一些动静，仿佛有活物在里面
徘徊，不时透出一股阴森之气。
LONG
  );
  set("no_fly", 1);

  set("exits", ([
    "north": __DIR__ "b8",
    "south": __DIR__ "b6",
  ]));

  setup();
}

//是镜像
