inherit ITEM;
#include <ansi.h>
void init() {
  add_action("do_zha", "zha");
}
void create() {
  set_name(HIR "火雷弹" NOR, ({ "huolei dan", "dan", "huolei" }));
  set("unit", "个");
  set("value", 0);
  set("long", "这个是方舟发明的火雷弹，据说可以用炸(zha)哦。\n");
  setup();
}
int do_zha() {
  object me, *ob;
  int i;

  me = this_player();
  ob = all_inventory(environment(me));

  if (me->is_busy())
    return notify_fail("( 你上一个动作还没有完成，不能施用内功。)\n");

  if (environment(me)->query("no_fight") || environment(me)->query("freeze"))
    return notify_fail("这个房间可是方舟的地盘，不能乱炸！\n");

  message_vision(
    HIR "$N把手中的" HIY "火雷弹" HIR "扔到地上，只听到一阵「哄」的巨响!!!\n" NOR, me);

  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me ||
      (ob[i]->query("age") < 28 && userp(ob[i]))) continue;
    if (userp(ob[i]))
      ob[i]->set_temp("rock_roar", "" + me->query("id") + "");

    ob[i]->receive_damage("jing", 1000 * 2);
    ob[i]->receive_wound("jing", 1000);
    tell_object(ob[i], HIR "你只感觉那火雷弹向你发出一阵庞大的冲击力!!\n" NOR);
    if (!ob[i]->is_killing(me)) ob[i]->kill_ob(me);
    if (!me->is_killing(ob[i])) me->fight_ob(ob[i]);
  }
  me->start_busy(1);
  destruct(this_object());
  return 1;
}
