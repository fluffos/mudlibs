//wang.c

inherit NPC;

void create() {
  set_name("机关人", ({ "jiguan ren", "ren" }));
  set("long", "他是一个机关人.\n");
  set("gender", "男性");
  set("age", 20);
  set("attitude", "friendly");
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("no_get", 1);
  set("max_qi", 999999999);
  set("max_jing", 999999999);
  set("jingli", 999999999);
  set("max_neili", 999999999);
  set("max_jingli", 999999999);

  setup();
  call_out("add_neili", 10);

}

void add_neili() {
  this_object()->set("neili", 999999999);
  this_object()->set("jing", 999999999);
  this_object()->set("jingli", 999999999);
  call_out("add_neili", 10);
}

void kill_ob(object ob) {
  ob->remove_killer(this_object());
  remove_killer(ob);
  command("peace " + ob->query("id"));
}
void die() {
  set("eff_qi", this_object()->query_max_hp());
  set("qi", this_object()->query_max_hp());
  set("eff_jing", this_object()->query_max_jing());
  set("jing", this_object()->query_max_jing());
  set("jingli", 999999999);
  set("max_neili", 999999999);
  set("max_jingli", 7000);
}
void unconcious() {
  set("eff_qi", this_object()->query_max_hp());
  set("qi", this_object()->query_max_hp());
  set("eff_jing", this_object()->query_max_jing());
  set("jing", this_object()->query_max_jing());
  set("jingli", 999999999);
  set("max_neili", 999999999);
  set("max_jingli", 7000);
}
