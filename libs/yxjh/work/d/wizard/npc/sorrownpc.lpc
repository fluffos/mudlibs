inherit NPC;


void create() {
  set_name(HIC "白河愁" NOR, ({ "sorrow_npc", "sorrow" }));
  set("title", HIG "[天 涯" HIR " ☆" NOR + WHT " 最 杰 出" HIR " ☆" HIG " 玩 家]" NOR);
  set("long", HIW "《浴血江湖》的最杰出的老玩家之一,虽然现在已经离开了,\n但时不时还会
                         回来聊天,可是他为《浴血江湖》新一代玩家留下来的精美任务机器人,确一\n
                         直在造福着大家。\n" NOR);
  set("gender", "男性");
  set("combat_exp", 10000);
  set("age", 28);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 17);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("per", 30);
  set("no_die", 1);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);


  setup();
  carry_object("/d/wizard/npc/obj/colorcloth")->wear();
  add_money("coin", 40 + random(30));
}
