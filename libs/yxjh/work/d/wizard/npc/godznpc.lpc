inherit NPC;


void create() {
  set_name(HIC "鸽子" NOR, ({ "godz_npc", "godz" }));
  set("title", HIG "[天 涯" HIR " ☆" NOR + WHT " 最 杰 出" HIR " ☆" HIG " 玩 家]" NOR);
  set(
    "long",
    HIW "《浴血江湖》的最杰出的老玩家之一,目前仍然在本站练级,\n他所制作上传的机器人,确是精品,帮助了不少《浴血江湖》的New Player。另外，他的聊天ID\n是Apanie，大家尽管去烦着他问问题！\n" NOR
  );
  set("gender", "男性");
  set("combat_exp", 10000);
  set("age", 28);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 17);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("per", 30);
  set("no_die", 1);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);


  setup();
  carry_object("/d/wizard/npc/obj/colorcloth")->wear();
  add_money("coin", 40 + random(30));
}
