#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
	set("short", HIY "江湖新闻" NOR);
	set("long", @LONG
这里是江湖风云的新闻发布中心，有什么新闻都可以在这里发布(post)，
然后系统自动随机通知所有在线玩家。
LONG );
	set("exits", ([
           "north" : __DIR__"snow_room",
	]));
	set("objects",([
		__DIR__"newer":1,
	]));
	set("no_clean_up", 1);
	setup();
	call_other("/d/board/news_b", "???");
	replace_program(ROOM);
}
