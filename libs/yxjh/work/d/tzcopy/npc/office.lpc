#include <ansi.h>
inherit NPC;

#define MIRROR_SYS "/d/tzcopy/sys/mirror_sys"

int ask_job();
int ask_job_2();
int ask_job_3();
int ask_job_4();
int ask_job_5();
int ask_job_6();

void create() {

  set_name("副本管理员", ({ "copy man3", "man3" }));
  set("title", "套装副本");

  set("gender", "男性");
  set("age", 26);
  set("long", "他是一位副本管理员。\n");

  set("inquiry", ([
    "进入100级副本": (: ask_job :),
    "进入200级副本": (: ask_job_2 :),
    "进入300级副本": (: ask_job_3 :),
    "进入400级副本": (: ask_job_4 :),
    "进入500级副本": (: ask_job_5 :),
    "进入600级副本": (: ask_job_6 :),
  ]));

  setup();
  carry_object("/clone/misc/changpao")->wear();
}

int ask_job() {
  object me;
  object *team, memory, item;

  me = this_player();

  if (!item = present("tz quan", me)) {
    tell_object(me, "没有门票不得入内！门票可在珍宝铺内购买。\n");
    return 1;
  }

  if (MIRROR_SYS->query_room_amount() >= 20) {
    tell_object(me, "镜像已经开启太多，欢迎下次参与。\n");
    return 1;
  }
  if (me->query_level() < 100) {
    tell_object(me, "等级不足100级无法创建副本。\n");
    return 1;
  }

  team = me->query_team();
  if (!pointerp(team) || !sizeof(team)) team = ({ me });
  else if (!me->is_team_leader()) {
    tell_object(me, "你不是领队。\n");
    return 1;
  }

  //	tell_object(me,sprintf("%d   %d \n",pointerp(team),sizeof(team)));
  if (!pointerp(team) || sizeof(team) < 1) {
    tell_object(me, "你的人手不够。\n");
    return 1;
  }

  //删除旧的副本
  memory = me->query_temp("mirror/mirror_memory");
  if (objectp(memory)) {
    memory->delete("user_id");
  }
  me->set_temp("drop_equip", 100);
  //创建新的副本
  MIRROR_SYS->mirror(team, me);
  destruct(item);
  return 1;
}

