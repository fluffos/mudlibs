#include <ansi.h>
inherit NPC;

#define PRODUCT "/clone/shoufei/product"
#define EQUIP_UP "/adm/item/equip"

int is_jinying() { return 1; }

void create()
{
	int rand = random(100);
	if(rand < 20) set_name("蒙古高手", ({ "gaoshou"}));
	else if(rand < 50) set_name("蒙古士兵", ({ "shibing"}));
	else if(rand < 80) set_name("蒙古猛将", ({ "jiang"}));
	else set_name("蒙古小兵", ({ "bing"}));
	set("gender", "男性");
	set("age",26);
	set("long", "一位从遥远蒙古,过来攻打襄阳城的蒙古官兵。\n");

	setup();
//	carry_object("/clone/misc/hic_cloth")->wear();
}

void init()
{
	object ob,me,*inv,obj;
	int i,j;
	mapping skill_status,map_status,ob_data,my_data;
	string *sname,*mname;

	ob = this_player();
	me = this_object();
	if(!me->query("skill") && objectp(ob) && userp(ob))
	{
	    if ( mapp(skill_status = ob->query_skills()) )
	    {
	        sname  = keys(skill_status);
	        for(i=0; i<sizeof(skill_status); i++)
	        {
	            me->set_skill(sname[i], skill_status[sname[i]]/2);
	        }
	    }
	    if ( mapp(map_status = ob->query_skill_map()) ) {
	        mname  = keys(map_status);
	        for(i=0; i<sizeof(map_status); i++) {
	            me->map_skill(mname[i], map_status[mname[i]]);
	        }
	    }
	    if ( mapp(map_status = ob->query_learned()) ) {
	        mname  = keys(map_status);
	        for(i=0; i<sizeof(map_status); i++) {
	            skill_status=([ mname[i]: map_status[mname[i]] ]);
	        }
	    }
	    
	    ob_data=ob->query_entire_dbase();
	    my_data=me->query_entire_dbase();
	
	    me->set("max_neili",ob_data["max_neili"]);
	    me->set("max_jingli",ob_data["max_jingli"]);
	    me->set("neili",ob_data["neili"]);
	    me->set("jingli",ob_data["jingli"]);
	    me->set("max_qi",ob_data["max_qi"]);
	    me->set("max_jing",ob_data["max_jing"]);
	    me->set("eff_qi",ob_data["eff_qi"]);
	    me->set("eff_jing",ob_data["eff_jing"]);
	    me->set("qi",ob_data["qi"]);
	    me->set("jing",ob_data["jing"]);
	    me->set("jiali",ob_data["jiali"]);
	    me->set("int",ob_data["int"]);
	    me->set("con",ob_data["con"]);
	    me->set("str",ob_data["str"]);
	    me->set("dex",ob_data["dex"]);

/*	    inv=all_inventory(ob);
	    for (i=0;i<sizeof(inv);i++)
	    {
	    	obj=new(base_name(inv[i]));
	    	obj->move(me);
	    	if( inv[i]->query("weapon_prop") &&  inv[i]->query("equipped") ) obj->wield();
	    	else if( inv[i]->query("armor_prop") &&  inv[i]->query("equipped") ) obj->wear();
	    }*/

	    me->set("skill",1);
	    me->set("jym_level/level",ob->query_level());
	    me->kill_ob(ob);
	}
//	call_out("findPlayer",5); //寻敌
}

void die()
{
	object me,ob,memory,item;
	object *team;
	int i,size,level,exp,rand,pot,pinzhi=1;
	string file;

	ob = this_object();
	me = ob->query_temp("last_damage_from");
//	team = me->query_team();
//	memory = (object)me->query_temp("mirror/mirror_memory");

	if(me && userp(me))
	{
		team = me->query_team();
		if(!pointerp(team) || !sizeof(team)) team = ({ me });
		memory = (object)me->query_temp("mirror/mirror_memory");
	}

//tell_object(find_player("rock"),sprintf("%O %O %O\n",team,memory,me));
	if(!clonep(memory) || !team)
	{
//		tell_room(environment(ob),HIM"轰~~~~！\n扶桑武士仓惶之下，扔下烟雾弹，逃跑了。\n"NOR);
		destruct(ob);
		return;
	}
	
	memory->add("make_boss",1);
//	tell_room(environment(ob),HIM"轰~~~~！\n扶桑武士仓惶之下，扔下烟雾弹，逃跑了。\n"NOR);

	size = sizeof(team);
	for(i=0;i<size;i++)
	{
		if(!team[i]) continue;
		level = team[i]->query("jym_level/level");
		exp = 1000*(1+random(level))/size;

		if(exp)
		{
			pot = exp/2;
			tell_object(team[i],sprintf("你获得了%d点经验，%d点潜能。\n",exp,pot));
			ADD_EXP(team[i],exp);
			team[i]->add("potential",pot);
		}
	}
	//掉宝
//	rand = random(100);
/*	level = ob->query_level();
	if(level > 150) level = 150;
//tell_object(find_player("rock"),sprintf("killer: rand = %d",rand));
	if(rand < 15) file = "/u/rock/return_obj/shuijing";
	else if(rand < 10) file = PRODUCT->get_random_level_product(1+random(15),level-5,level);
	else if(rand < 5) file = PRODUCT->get_random_level_product(1+random(15),level,level);
	if(file)
	{
		item = new(file);
		if(item)
		{
			item->set("_name",item->name());
//			EQUIP_UP->init_equip_prop_1(item);
//			EQUIP_UP->init_equip_prop_2(item);
			item->move(environment(ob));
		}
	}*/
//	destruct(ob);
	rand = random(2000);
	level = me->query_temp("drop_equip");
	if(!level) level = 100;
	if(rand < 10) file = PRODUCT->get_tz_level_product(1+random(7),level);
	if(file)
	{
		item = new(file);
		if(item)
		{
			item->set("_name",item->query("name"));
			//item->set("level",me->query_level());
			rand = random(50);
			for(i=0;i<rand;i++)
			{
				if(pinzhi == 1)
				{
					"/adm/item/equip"->init_equip_prop_1(item);  //变更装备品质
					pinzhi++;
				}
				else if(pinzhi == 2)
				{
					"/adm/item/equip"->init_equip_prop_2(item);  //变更装备品质
					pinzhi++;
				}
				else if(pinzhi == 3)
				{
					"/adm/item/equip"->init_equip_prop_3(item);  //变更装备品质
					pinzhi = 1;
				}
			}
			item->set("zhiliang",i);
			//item->set("locktime",time()+259200); //72小时
			item->set("need_time",3);
			item->set("jianding",1); //设置未鉴定
			item->move(environment(ob));
		}
	}
	if(rand < 20 && level > 200)
	{
		if(item=new("/u/rock/return_obj/lingpai")) item->move(environment(ob));
	}
	::die();
}
