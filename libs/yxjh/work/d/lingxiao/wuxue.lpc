#include <ansi.h>
#include <room.h> 

inherit ROOM;  

void copy_npc();

void create()  
{
        set("short", "崆峒幻境" );  
        set("long","这里是崆峒幻境..............");

        set("no_fight", 1); 
        set("no_steal", 1); 
        set("no_sleep_room", 1); 
        set("valid_startroom",1);  

        setup(); 
        copy_npc();
}

void init()
{
        object me = this_player();

        if (userp(me) && me->query("family/family_name") =="崆峒派")
                add_action("do_mianbi", "mianbi");
}

int do_mianbi()
{
        object ob;
        int c_exp,c_skill;
        ob = this_player();
        c_skill = ob->query_skill("literate", 1);

        if(ob->query("family/family_name")!="崆峒派")
        {
                ob->move("/d/kongtong/shanjiao");
                tell_object(ob,"你不是崆峒派弟子，想面壁还是回家面吧。\n");
                return 1;
        }

        if (c_skill <5000)
        {
                tell_object(ob,"你的领悟力不够强，完全不能领悟到墙上的武功。\n");
                return 1; 
        }

        if (ob->query("jing")<2000)
        {
                tell_object(ob,"你太累了，在面壁下去只怕要晕倒。\n");
                return 1; 
        }
        if (ob->query_skill("kongtong-shengong", 1)>10000)
        {
                tell_object(ob,"你觉得面壁已经不能对自己的武功进行提升了。\n");
                return 1; 
        }

        message_vision(RED"$N盘膝坐下,面对着墙领悟武功，$N提升了自己的崆峒武学！。\n"NOR,ob);
        ob->improve_skill("kongtong-shengong", ob->query_skill("kongtong-shengong", 1));
        ob->add("jing",-500);
        ob->start_busy(1);
        ob->move("d/xuantian/xiaolu");
        return 1;
}

void copy_npc()
{
        object npc;
        string path="";

        if(random(100) < 50) return;

        switch(random(11))
        {
                case 0  : path = "/d/kongtong/npc/yunlizi";    break;
                case 1  : path = "/d/kongtong/npc/feisuizi";   break;
                case 2  : path = "/d/kongtong/npc/feiyunzi";   break;
                case 3  : path = "/d/kongtong/npc/huawuying";  break;
                case 4  : path = "/d/kongtong/npc/huhuimin";   break;
                case 5  : path = "/d/kongtong/npc/luchenzi";   break;
                case 6  : path = "/d/kongtong/npc/meigu";      break;
                case 7  : path = "/d/kongtong/npc/mulingzi";   break;
                case 8  : path = "/d/kongtong/npc/yanfeixia";  break;
                case 9  : path = "/d/kongtong/npc/yuanyiffei"; break;
                case 10 : path = "/d/kongtong/npc/feichenzi";  break;
        }
        if(path != "" && load_object(path))
        {
                if(npc = new(path))
                {
                        npc->move(this_object());
                }
        }
}
