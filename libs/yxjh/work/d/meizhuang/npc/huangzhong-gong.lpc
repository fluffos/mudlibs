// huangzhong-gong.c
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("黄钟公", ({ "huangzhong gong", "gong" }));
        set("title", HIC"梅庄大庄主"NOR);
        set("long",
                "他就是梅庄四位庄主排行第一的黄钟公。\n"
                "身穿一件干干净净的黄色长袍。\n"
                "他已年愈六旬，身材中等，面容和蔼可亲。\n");
        set("gender", "男性");
        set("age", 62);
        set("class", "scholar");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 28);
        set("int", 28);
        set("con", 28);
        set("dex", 28);

        set("max_qi", 1000000);
        set("max_jing", 1000000);
        set("neili", 5000000);
        set("max_neili", 5000000);
        set("jiali", 600);
        set("combat_exp", 90000000);
        set("shen", 15000);
        set("score", 60000);

        set_skill("force", 7750);
        set_skill("wuzheng-xinfa", 7750);
        set_skill("dodge", 7750);
        set_skill("piaoyibu", 7750);
        set_skill("parry", 7650);
        set_skill("sword", 7750);
         set_skill("wuxing-jianfa", 7550);
        set_skill("literate", 2500);


        map_skill("force", "wuzheng-xinfa");
        map_skill("dodge", "piaoyibu");
        map_skill("parry", "wuxing-jianfa");
        map_skill("sword", "wuxing-jianfa");
        create_family("梅庄", 1, "庄主");
        setup();
        carry_object("clone/weapon/changjian")->wield();
        carry_object(__DIR__"obj/heiyi")->wear();
}


int accept_object(object me, object obj)
{       
       int count,i;
       object ob;
       me=this_player();
       ob=this_object();
       if (obj->query("id")!="guangling san")
       {command("say 难道这就是我要的东西！？。");return 0;}

       command("thumb "+me->query("id")+"");
       command("say 你帮我办成了这件事，我很高兴，你愿意拜入我门下吗？");
       destruct(obj);
       me->set("meizhuangguangling",1);

       call_out("destroying", 1, ob, obj);
       return 1;}

void destroying(object ob, object obj)
{
       destruct(obj);return;}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("wuzheng-xinfa") < 120) {
                command("say 在我梅庄的内功上，" + RANK_D->query_respect(ob) +
                        "是否还应该多下点功夫？");
                return;
        }
        if ((int)ob->query("meizhuangguangling") < 1) {
                command("say 想入我门下，" + RANK_D->query_respect(ob) +
                        "就去帮我把广陵散找来给我？");
                return;
        }
        command("say 好吧，在下就收下你了。");
        command("recruit " + ob->query("id"));
}



