// baihongjian.c 白虹剑
#include <weapon.h>
inherit SWORD;

void create() {
  set_name(HIW "白虹剑" NOR, ({ "baihongjian", "sword", "jian" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一口削铁如泥的宝剑。\n");
    set("value", 10000);
    set("material", "steel");
    set("weapon_prop/personality", 8);
    set("wield_msg", HIW "$N「唰」的一声抽出一柄寒光闪闪的$n" HIW "握在手中。\n" NOR);
    set("unwield_msg", HIW "$N将手中的$n" HIW "插回剑鞘。\n" NOR);
  }
  init_sword(400);
  setup();
}
