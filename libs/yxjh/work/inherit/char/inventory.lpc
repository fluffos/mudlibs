//edit by rock
//2008.10.11

#define ITEM_ITEM_D "/adm/obj/equip"
#define USER_INVENTORY_D "/adm/daemons/inventory"

private string *Inventory;              // 道具栏道具数组

// 函数：获取道具数组
string *query_inventory() { return copy(Inventory); }

// 函数：清除道具数组
void init_inventory() { Inventory = ({ }); }

// 函数：保存道具物体
void save_inventory()
{
        object me, *inv, item;
        string id, file;
        int amount, index, point, locktime, lockutil;
        int i, size;

        Inventory = ({ });

        me = this_object();  inv = all_inventory(me);

        for( i = 0, size = sizeof(inv); i < size; i ++ ) if( item = inv[i] )
        {
        	if ( !item->query("no_save") || !userp(item))
        		Inventory += ({ ITEM_ITEM_D->query_save_prop_string(item) });
        }
}

// 函数：恢复玩家的所有物品
void restore_inventory()
{
	USER_INVENTORY_D->restore_inventory(this_object());
}
