//临时数据继承文件

private nosave mapping mpHP = ([]);         // 临时数据集 气血
private nosave mapping mpJL = ([]);         // 临时数据集 精力
private nosave mapping mpJ = ([]);         // 临时数据集 精气
private nosave mapping mpAP = ([]);         // 临时数据集 魔法攻
private nosave mapping mpDP = ([]);         // 临时数据集 物理防
private nosave mapping mpPP = ([]);         // 临时数据集 魔法防
private nosave mapping mpCP = ([]);         // 临时数据集 物理攻
private nosave mapping mpNL = ([]);         // 临时数据集 内力

// =============================================================

// 函数：获取临时数据集
mapping query_temp_hp_dbase() { return copy(mpHP); }
mapping query_temp_jl_dbase() { return copy(mpJL); }
mapping query_temp_j_dbase() { return copy(mpJ); }
mapping query_temp_ap_dbase() { return copy(mpAP); }
mapping query_temp_dp_dbase() { return copy(mpDP); }
mapping query_temp_pp_dbase() { return copy(mpPP); }
mapping query_temp_cp_dbase() { return copy(mpCP); }
mapping query_temp_nl_dbase() { return copy(mpNL); }

// 函数：初始临时数据集
void init_temp_hp_dbase() { mpHP = ([]); }
void init_temp_jl_dbase() { mpJL = ([]); }
void init_temp_j_dbase() { mpJ = ([]); }
void init_temp_ap_dbase() { mpAP = ([]); }
void init_temp_dp_dbase() { mpDP = ([]); }
void init_temp_pp_dbase() { mpPP = ([]); }
void init_temp_cp_dbase() { mpCP = ([]); }
void init_temp_nl_dbase() { mpNL = ([]); }

// -------------------------------------------------------------

// 函数：获取临时数据集
mixed query_temp_hp(string key) { return mpHP[key]; }
mixed query_temp_jl(string key) { return mpJL[key]; }
mixed query_temp_j(string key) { return mpJ[key]; }
mixed query_temp_ap(string key) { return mpAP[key]; }
mixed query_temp_dp(string key) { return mpDP[key]; }
mixed query_temp_pp(string key) { return mpPP[key]; }
mixed query_temp_cp(string key) { return mpCP[key]; }
mixed query_temp_nl(string key) { return mpNL[key]; }

// 函数：设置临时数据集
mixed set_temp_hp(string key, mixed value) { return mpHP[key] = value; }
mixed set_temp_jl(string key, mixed value) { return mpJL[key] = value; }
mixed set_temp_j(string key, mixed value) { return mpJ[key] = value; }
mixed set_temp_ap(string key, mixed value) { return mpAP[key] = value; }
mixed set_temp_dp(string key, mixed value) { return mpDP[key] = value; }
mixed set_temp_pp(string key, mixed value) { return mpPP[key] = value; }
mixed set_temp_cp(string key, mixed value) { return mpCP[key] = value; }
mixed set_temp_nl(string key, mixed value) { return mpNL[key] = value; }

// 函数：添加临时数据集
mixed add_temp_hp(string key, mixed value) {
  mixed old;

  if (!(old = query_temp_hp(key)))
    return set_temp_hp(key, value);
  else return set_temp_hp(key, old + value);
}

mixed add_temp_jl(string key, mixed value) {
  mixed old;

  if (!(old = query_temp_jl(key)))
    return set_temp_jl(key, value);
  else return set_temp_jl(key, old + value);
}

mixed add_temp_j(string key, mixed value) {
  mixed old;

  if (!(old = query_temp_j(key)))
    return set_temp_j(key, value);
  else return set_temp_j(key, old + value);
}

mixed add_temp_ap(string key, mixed value) {
  mixed old;

  if (!(old = query_temp_ap(key)))
    return set_temp_ap(key, value);
  else return set_temp_ap(key, old + value);
}

mixed add_temp_dp(string key, mixed value) {
  mixed old;

  if (!(old = query_temp_dp(key)))
    return set_temp_dp(key, value);
  else return set_temp_dp(key, old + value);
}

mixed add_temp_pp(string key, mixed value) {
  mixed old;

  if (!(old = query_temp_pp(key)))
    return set_temp_pp(key, value);
  else return set_temp_pp(key, old + value);
}

mixed add_temp_cp(string key, mixed value) {
  mixed old;

  if (!(old = query_temp_cp(key)))
    return set_temp_cp(key, value);
  else return set_temp_cp(key, old + value);
}

mixed add_temp_nl(string key, mixed value) {
  mixed old;

  if (!(old = query_temp_nl(key)))
    return set_temp_nl(key, value);
  else return set_temp_nl(key, old + value);
}

// 函数：删除临时数据集
void delete_temp_hp(string key) { map_delete(mpHP, key); }
void delete_temp_jl(string key) { map_delete(mpJL, key); }
void delete_temp_j(string key) { map_delete(mpJ, key); }
void delete_temp_ap(string key) { map_delete(mpAP, key); }
void delete_temp_dp(string key) { map_delete(mpDP, key); }
void delete_temp_pp(string key) { map_delete(mpPP, key); }
void delete_temp_cp(string key) { map_delete(mpCP, key); }
void delete_temp_nl(string key) { map_delete(mpNL, key); }
