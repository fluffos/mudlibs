#include <properties.h>
#include <daemon.h>
#include <wizlevels.h>

#define ARCHSEER_LEVEL 50

private nosave mixed _name_;

void create() {
  if (is_clone(this_object())) return destruct(this_object());
}

int remove() { return 0; }

query_prevent_shadow() { return 1; }

varargs int check(string ch, mixed pl, string cmd, string txt, int level, int qp)
{
  string fn;
  if (ch != "Erzseher") return 0;
  if (objectp(pl) && !interactive(pl)) return 0;
  if (!level && objectp(pl))
    level = pl->QueryProp(P_LEVEL);
  if (!qp && objectp(pl))
    qp = pl->QueryProp(P_QP);
  if (IS_LEARNER(pl) ||
      (IS_SEER(pl) && level >= ARCHSEER_LEVEL && 
       qp >= "/secure/questmaster"->QueryMaxQP() * 
       (1000 + ARCHSEER_LEVEL - level) / 1000) ) 
    return 1;
}

string name() { return _name_ ? _name_ : "<Erzseher>"; }

