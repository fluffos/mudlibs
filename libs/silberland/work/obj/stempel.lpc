int Stempel(string str)
{
  string s;
  mixed z,m;

  if (TP!=MENV)
    return notify_fail("Du solltest den Stempel erstmal nehmen!\n"), 0;

  notify_fail ("Als wessen Zweitspieler willst Du Dich markieren?\n"+
    "Syntax: stempel von <name>\n");

  if (!stringp(str) || strlen(str) < 5 || str[0..3]!="von ")
    return 0;

  str = str[4..];

  if (zettel)
    return notify_fail(BS("Du hast bereits einen Zettel verschickt. "
          "Warte, bis "+who+" Deinen Zettel entweder zerreisst oder "
          "unterzeichnet!")), 0;

  who = capitalize(str);
  if (!(who_ob=find_player(str)) ||
      (!IS_LEARNING(TP) && IS_LEARNER(who_ob) && who_ob->QueryProp(P_INVIS)))
    return notify_fail("Spieler "+who+" kann ich leider nicht finden!\n"), 0;

  if (TP==who_ob)
    return notify_fail ("Du willst Dein eigener Zweiti sein?? "+
        "Och, lass das mal lieber...\n"), 0;

  if (present(STEMPEL_BEST_ID, who_ob))
    return notify_fail (who+" hat bereits einen Zettel!\n"), 0;

  if (present(STEMPEL_BEST_ID, TP))
    return notify_fail ("Unterschreib erst mal Deinen eigenen Zettel, "+
        "oder zerreisse ihn!\n"), 0;

  if (z = (mixed) TP->QueryProp(P_SECOND))
  {
    write("Aber Du bist doch schon Zweitspieler"+
      (stringp(z) ? " von "+z : "") + "!\n");
    if (stringp(z) && (z != who)) write("Kleine Identitaetskrise? ;-)\n");
    return 1;
  }

  z = (mixed) who_ob->QueryProp(P_SECOND);
  m = (mixed) who_ob->QueryProp(P_SECOND_MARK);

  if (z && (m >= 0))
  {
    write(
        "Aber "+who+" ist doch selbst Zweitspieler" +
        (m && stringp(z) ? " von "+z : "") + "!\n");
    return 1;
  }

  if (!z) {
    zettel = CLONEOB(STEMPEL_BEST);
    zettel->move(who_ob, M_NOCHECK);
    zettel->SetStempel(ME, capitalize(getuid(TP)), TP->QueryProp(P_GENDER));
    tell_object(who_ob,
        TPN +
        " will sich als Dein Zweiti markieren und schickt Dir einen Zettel.\n"
        "Bitte bestaetige die Markierung (lies dazu die Bestaetigung).\n");
  } else {
    tell_object(who_ob,
        TPN +
        " will sich als Dein Zweiti markieren und schickt Dir einen Zettel.\n"
        "Da Du bereits Zweiti bist, zerreisst Du den Zettel sofort.\n");
  }
  write("Ok, Antrag abgeschickt. Bitte warte auf die Bestaetigung.\n");
  return 1;
}


int StempelOk(string str)
{
  if (!str) return 0;
  if (!owner) return 0;
  if (who_ob->QueryProp(P_SECOND)) return 0;
  if (owner->QueryProp(P_SECOND)) return 0;
  tell_object (owner, str+" bestaetigt die Markierung.\n"+
    "Du bist fortan als Zweitspieler von "+str+" markiert.\n");
  owner->SetProp(P_SECOND, str);
  return 1;
}


int StempelCancel(string str)
{
  if (!str) return 0;
  tell_object (owner, str+" verweigert die Markierung.\n");
  zettel = 0;
  return 1;
}


int Zerstoere(string str)
{
  if (TP!=MENV)
    return notify_fail("Du solltest den Stempel erstmal nehmen!\n"), 0;

  if (!str || !id(str))
    return notify_fail("Was willst Du zerstoeren?\n"), 0;

  write("Du verfaellst dem Zerstoerungswahn. "
        "Der arme Stempel muss dran glauben...\n");
  remove();
  return 1;
}

int remove()
{
  if (zettel)
  {
    if (objectp(owner))
      tell_object(owner, BS("Der Zettel, den Du "+who+" geschickt hast, "+
        "wandert auf magische Weise in die "+MUDNAME+"-Archive."));
    if (environment(zettel))
      tell_object(environment(zettel),
        "Der Zettel wandert auf magische Weise in die "+MUDNAME+
        "-Archive.\n");
    zettel->remove();
    zettel=0;
  }
  if (owner)
    tell_object (owner, "Der Stempel zerfaellt in seine Bestandteile.\n");
  return ::remove();
}

varargs int move(mixed dest, int method)
{
  int res;
  if ((res=::move(dest, method))==1)
  {
    if (zettel)
    {
      if (objectp(owner))
        tell_object(owner, BS("Der Zettel, den Du "+who+" geschickt hast, "+
          "wandert auf magische Weise in die "+MUDNAME+"-Archive."));
      if (environment(zettel))
        tell_object(environment(zettel),
          "Der Zettel wandert auf magische Weise in die "+MUDNAME+
          "-Archive.\n");
      zettel->remove();
      zettel=0;
    }
    if (stringp(dest)) dest=find_object(dest);
    if (objectp(dest) && query_once_interactive(dest))
      owner=dest;
    else
      owner=0;
  }
  return res;
}

object query_owner()
{
  return owner;
}
