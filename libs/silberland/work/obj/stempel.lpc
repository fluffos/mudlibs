#pragma strict_types

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>


#define STEMPEL_BEST    "/obj/stempel_bestaetigung"
#define STEMPEL_BEST_ID "\nzweitibestaetigung"
#define STEMPEL_ID      "\nzweitistempel"

object zettel, owner, who_ob;
string who;


void create()
{
  ::create();
  SetProp(P_SHORT, "Ein kleiner Stempel");
  SetProp(P_LONG,
    "Mit diesem Stempel kannst Du Dich als Zweitspieler markieren. "
    "Alles was Du dazu tun musst, ist, Dir den Stempel aufzudruecken. "
    "(Syntax: \"stempel von <name>\", um als Zweitspieler von <name> "
    "markiert zu werden). Beachte aber, dass es keinen Weg gibt, "
    "diese Markierung rueckgaengig zu machen; Du bist dann fuer "
    "immer als Zweitspieler (\"Zweiti\") markiert!");
  SetProp(P_NAME, "Stempel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "stempel", STEMPEL_ID, "SKILL_NOLEARN" }) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_NEVERDROP, 1);    // Wird beim Tod nicht in die Leiche gelegt
  SetProp(P_MATERIAL, MAT_PLASTIC);
  SetProp(P_INFO, "Die Syntax ist:\n"+
    //"druecke stempel auf    um als Zweitspieler markiert zu werden\n"+
    "stempel von <name>     um als Zweitspieler des angegebenen Spielers\n"+
    "                       markiert zu werden. Dieser muss die Markierung\n"+
    "                       dann allerdings bestaetigen.\n"+
    "zerstoere stempel      um den Stempel zu zerstoeren.\n");

  // AddCmd (({"druecke","drueck"}), "Druecke");
  AddCmd("stempel", "Stempel");
  AddCmd("zerstoere", "Zerstoere");

  zettel = 0;
  if ((owner = MENV) && !query_once_interactive(owner)) owner=0;
}

