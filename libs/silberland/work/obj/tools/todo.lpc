inherit "std/tool";

#ifndef BS
#define BS(string) break_string(string)
#endif

#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <wizlevels.h>
#include <language.h>
#include <ansi.h>

#define VERSION "v0.6.5"
#define DATE "26/08/2006"
#define C_YEARS "1999-2006"
#define V_HIST \
        "ToDo "VERSION" ("DATE")   (c) "C_YEARS" by Cirion@Silberland\n\n"\
        "Version History:\n"\
        "\n"\
        "v0.6.4 : Auto-Expire kann jetzt auch auf 'sofort' gesetzt werden\n"\
        "         und verhält sich dann entsprechend.\n"\
        "v0.6.3 : Einstellungen wurden teilweise nicht initialisiert.\n"\
        "         Auto-Expire wurde unter Umständen falsch angezeigt.\n"\
        "v0.6.2 : Beim Erledigen wurde noch das alte Format verwendet\n"\
        "v0.6.1 : Ein Bug im Update des Savefiles :(\n"\
        "v0.6.0 : Es sind jetzt wieder ToDos mit mehr als 32 Zeichen erlaubt,\n"\
        "         diese werden bei der Ausabe umgebrochen bzw. im reset()\n"\
        "         abgeschnitten\n"\
        "         Die Ausgabe der ToDo-Liste kann auf eine andere Formatierung\n"\
        "         mit Rahmen umgestellt werden\n"\
        "         Es ist jetzt moeglich, einzustellen, dass erledigte ToDos nach\n"\
        "         einer Anzahl von Monaten automatisch geloescht werden.\n"\
        "         (Auto-Expire)\n"\
        "v0.5.0 : Kleiner Bugfix bei Todos mit >32 Zeichen\n"\
        "         Versionsnummerierung veraendert\n"\
        "         Beim Clonen eines neuen Tools werden evtl. vorhandene alte \n"\
        "         entfernt, statt das neue gleich wieder zu destructen\n"\
        "         Kleine Typofixes\n"\
        "v0.4.5 : Bug beim Einstellen der Default-Prioritaet behoben\n"\
        "         Hilfetexte korrigiert\n"\
        "v0.4.4 : Einen weiteren Bug behoben\n"\
        "v0.4.3 : Debug des restore, altes Savefileformat wird nicht mehr\n"\
        "         unterstuetzt.\n"\
        "v0.4.2 : Kleinere Debugs und Optimierungen\n"\
        "v0.4.1 : Ueberarbeitung der Ausgaben\n"\
        "         Ueberarbeitung des Resetlevels und der Hilfe\n"\
        "v0.4.0 : Diese Version beinhaltet einige groessere Bugfixes\n"\
        "         sowie eine generelle Optimierung des gesamten Codes.\n"\
        "         Die Speicherung der Liste wurde auf ein Mapping \n"\
        "         umgestellt. Zusaetzlich ist es jetzt endlich moeglich,\n"\
        "         auch Grossbuchstaben innerhalb des ToDos zu benutzen.\n"\
        "         Weiterhin wurde das nicht funktionierende Ausgeben der\n"\
        "         Liste im Reset debuggt, sowie die farbliche Markierung\n"\
        "         bereits erledigter ToDos abgeschafft.\n"\
        "v0.3.6 : Einige groessere Neuerungen, wie Ausgabe der ToDo-Liste\n"\
        "         in jedem Reset, farbliche Abhebung wichtiger ToDos, etc.\n\n"\
        "Fruehere Versionen sind nicht dokumentiert.\n"

#define AUFGABE "Aufgabe"
#define PRIORITAET "Pri"
#define DATUM "Datum"
#define ERLEDIGTAM "Erledigt am"
#define STATUS "Status"

#define DEFAULT_REPORTLEVEL   2
#define DEFAULT_WARNLEVEL     5
#define DEFAULT_FARBLEVEL     0
#define DEFAULT_RESETLEVEL    0
#define DEFAULT_FRAMES        0
#define DEFAULT_EXPIRE       -1

#define DONE "Erledigt"
#define UNDONE "Offen"

#pragma strong_types

string tdversion;

nosave string *argumentliste;

int reportlevel;
int warnlevel;
int farblevel;
int resetlevel;
int frames;
int expire;

mapping tasks;

int list_pref();
int info_todo();
int help();
int new_todo();
int list_todo(int opt);
int set_task(string titel);
int set_priority(string prio);
int set_done(string number);
int done_todo();
int del_todo();
int set_del(string number);
int report_todo();
int set_prefs();
int set_prio();
int set_pri(string number);
int set_pr(string prio,int number);
int v_hist();
int dtime2time(string dtime);

void create()
{
  int i;
  object o;

  if( !is_clone(TO) )
    return;
  while (o=present("\ntodo",TP))
  {
    write("Entferne altes ToDo-Tool.\n");
    o->remove();
  }

  reportlevel = DEFAULT_REPORTLEVEL;
  warnlevel = DEFAULT_WARNLEVEL;
  farblevel = DEFAULT_FARBLEVEL;
  resetlevel = DEFAULT_RESETLEVEL;
  frames = DEFAULT_FRAMES;
  expire = DEFAULT_EXPIRE;
  tdversion="";
  tasks=([AUFGABE:({}),
          PRIORITAET:({}),
          DATUM:({}),
          ERLEDIGTAM:({}),
          STATUS:({})]);
  seteuid(getuid());

  ::create();

  AddId(({"todo", "todoliste","\ntodo","todotool"}));
  SetProp(P_NAME, "ToDo "+VERSION);
  SetProp(P_SHORT, TP->QueryProp(P_NAME)+"s ToDo "+VERSION);
  SetProp(P_LONG,BS(
	  "In das ToDo-Tool kann man Dinge eintragen, die man irgendwann "
	  "einmal machen moechte. Wenn man sie erledigt hat, kann man sie "
	  "abhaken.                            (Hilfe mit <todo hilfe|help>)"));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NODROP, "Dann wuerdest Du sie sicher sofort vermissen.\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ,1);

  AddCmd (({"todo"}),"todo");
  restore_object("/players/"+geteuid()+"/.todolist");

  // ensure correct data types
  if (!stringp(tdversion)) tdversion = "";
  if (!mappingp(tasks)) tasks = ([ ]);

  if (tdversion!=VERSION)
  {
    // Version Update fuer die .o-Files
    write("Du hast soeben eine neue Version der ToDo-Liste erhalten.\n"
          "Die Aenderungen kannst Du mit <todo news|neues> ansehen.\n");
    if (tdversion<"v0.6.1" && sizeof(tasks[DATUM]) && !intp(tasks[DATUM][0]))
    {
      write(break_string(
        "Aufgrund einer internen Umstellung der Darstellung des Datums "
        "muss dieses jetzt fuer alle ToDos konvertiert werden. Dabei "
        "kommt es zu einer Verschiebung der Datierung um bis zu 3 Tage."));
      tasks[DATUM]=map_array(tasks[DATUM],#'dtime2time);
      tasks[ERLEDIGTAM]=map_array(tasks[ERLEDIGTAM],#'dtime2time);
    }
    if (tdversion<"v0.6.2" && sizeof(tasks[DATUM]))
    {
      tasks[ERLEDIGTAM]=map_array(tasks[ERLEDIGTAM],#'dtime2time);
    }
    tdversion=VERSION;
  }

  if (warnlevel>0)
  {
    if (resetlevel==1)
      list_todo(0);
    else if (resetlevel==2)
      list_todo(1);
  }
  save_object("/players/"+geteuid()+"/.todolist");
}

void reset()
{
  int i, zahl;

  if( !is_clone(TO) )
    return;
  ::reset();

  if ((!MENV)||(!query_once_interactive(MENV)))
  {
    remove();
    return;
  }
  if (expire!=-1)
  {
    for (i=0;i<sizeof(tasks[AUFGABE]);i++)
      if (tasks[STATUS][i]==DONE && tasks[ERLEDIGTAM][i]+2592000*expire<time())
      {
        tasks[AUFGABE]=tasks[AUFGABE][0..i-1]+tasks[AUFGABE][i+1..<1];
        tasks[PRIORITAET]=tasks[PRIORITAET][0..i-1]+tasks[PRIORITAET][i+1..<1];
        tasks[DATUM]=tasks[DATUM][0..i-1]+tasks[DATUM][i+1..<1];
        tasks[ERLEDIGTAM]=tasks[ERLEDIGTAM][0..i-1]+tasks[ERLEDIGTAM][i+1..<1];
        tasks[STATUS]=tasks[STATUS][0..i-1]+tasks[STATUS][i+1..<1];
        i--;
        zahl++;
      }
    if (zahl)
    {
      save_object("/players/"+geteuid()+"/.todolist");
      if (zahl==1)
        write("Es wurde ein altes, erledigtes ToDo geloescht.\n");
      else
        write("Es wurden "+zahl+" alte, erledigte ToDos geloescht.\n");
    }
  }
  if (resetlevel==1)
    list_todo(0);
  else if (resetlevel==2)
    list_todo(1);
}

int set_prefs()
{
  int arg;

  if (1<sizeof(argumentliste))
  {
    switch (argumentliste[1])
    {
      case "rep":
      case "report":
      case "replevel":
      case "reportlevel":
        if (2<sizeof(argumentliste))
        {
          arg=to_int(argumentliste[2]);
          if (-1!=member(({0,1,2,3,4,5}),arg))
          {
            reportlevel=arg;
            write("Reportlevel ist jetzt: "+reportlevel+" .\n");
            save_object("/players/"+geteuid()+"/.todolist");
            return 1;
          }
          else
          {
            write("Das Reportlevel muss zwischen 0 und 5 liegen.\n");
            return 1;
          }
          break;
        }
      case "warn":
      case "warnlevel":
        if (2<sizeof(argumentliste))
        {
          arg=to_int(argumentliste[2]);
          if (-1!=member(({0,2,3,4,5}),arg))
          {
            warnlevel=arg;
            write("Warnlevel ist jetzt: "+warnlevel+" .\n");
            save_object("/players/"+geteuid()+"/.todolist");
            return 1;
          }
          else
          {
            write("Das Warnlevel muss zwischen 2 und 5 liegen oder auf 0 gesetzt werden.\n");
            return 1;
          }
          break;
        }
      case "default":
      case "standard":
          warnlevel = DEFAULT_WARNLEVEL;
          reportlevel = DEFAULT_REPORTLEVEL;
          farblevel = DEFAULT_FARBLEVEL;
          resetlevel = DEFAULT_RESETLEVEL;
          frames = DEFAULT_FRAMES;
          expire = DEFAULT_EXPIRE;
          write("Die Voreinstellungen wurden wieder auf die Standardwerte\n"
                "gesetzt.\n"
                );
          save_object("/players/"+geteuid()+"/.todolist");
          return 1;
          break;
      case "farb":
      case "farblevel":
      case "col":
      case "color":
      case "colorlevel":
        if (2<sizeof(argumentliste))
        {
          arg=to_int(argumentliste[2]);
          if (-1!=member(({0,1,2}),arg))
          {
            farblevel=arg;
            write("Farblevel ist jetzt: "+farblevel+" .\n");
            save_object("/players/"+geteuid()+"/.todolist");
            return 1;
          }
          else
          {
            write("Das Farblevel muss zwischen 0 und 2 liegen.\n");
            return 1;
          }
          break;
        }
      case "res":
      case "resetlevel":
      case "reset":
        if (2<sizeof(argumentliste))
        {
          arg=to_int(argumentliste[2]);
          if (-1!=member(({0,1,2}),arg))
          {
            resetlevel=arg;
            write("Resetlevel ist jetzt: "+resetlevel+" .\n");
            save_object("/players/"+geteuid()+"/.todolist");
            return 1;
          }
          else
          {
            write("Das Resetlevel muss zwischen 0 und 2 liegen.\n");
            return 1;
          }
          break;
        }
      case "frame":
      case "frames":
      case "rahmen":
        if (2<sizeof(argumentliste))
        {
          if (-1!=member(({"ein","an","on"}),argumentliste[2]))
          {
            if (frames)
            {
              write("Rahmen sind bereits an.\n");
              return 1;
            }
            else
            {
              frames = 1;
              write("Die Todo-Liste wird jetzt mit Rahmen dargestellt.\n");
              save_object("/players/"+geteuid()+"/.todolist");
              return 1;
            }
          }
          else if (-1!=member(({"aus","off"}),argumentliste[2]))
          {
            if (!frames)
            {
              write("Rahmen sind gar nicht eingeschaltet.\n");
              return 1;
            }
            else
            {
              frames = 0;
              write("Die Todo-Liste wird jetzt nicht mehr mit Rahmen dargestellt.\n");
              save_object("/players/"+geteuid()+"/.todolist");
              return 1;
            }
          }
          write("Die Rahmen koennen entweder an (on) oder aus (off) sein.\n");
          return 1;
        }
        break;
      case "expire":
      case "autoexpire":
      case "auto-expire":
        if (2<sizeof(argumentliste))
        {
          if (-1!=member(({"aus","off","nie","never"}),argumentliste[2]))
          {
            if (expire==-1)
            {
              write("Auto-Expire ist bereits aus.\n");
              return 1;
            }
            else
            {
              expire = -1;
              write("Auto-Expire ist jetzt deaktiviert.\n");
              save_object("/players/"+geteuid()+"/.todolist");
              return 1;
            }
          }
          else if (-1 != member(({"sofort", "instant"}), argumentliste[2]))
          {
            if (expire == 0)
            {
              write("Auto-Expire ist bereits auf 'sofort' eingestellt.\n");
              return 1;
            }
            else
            {
              expire = 0;
              write("Auto-Expire steht jetzt auf 'sofort'.\n");
              save_object("/players/"+geteuid()+"/.todolist");
              return 1;
            }
          }
          else if (sscanf(argumentliste[2],"%d",arg)==1)
          {
            if (arg>0)
            {
              expire = arg;
              write("Auto-Expire steht jetzt auf "+arg+" Monate.\n");
              save_object("/players/"+geteuid()+"/.todolist");
              return 1;
            }
            else
            {
              write("Auto-Expire muss eine Anzahl Monate > 0 sein.\n");
              return 0;
            }
          }
          else
          {
            write(break_string(
              "Auto-Expire kann entweder aus (off,nie,never), sofort "
              "(instant) oder eine Anzahl Monate > 0 sein.\n"));
            return 1;
          }
        }
        break;
      default:
        break;
    }
  }
  write("Syntax: todo set <voreinst.> <wert>\n");
  return 1;
}

int todo(string argument)
{
  int i;

  notify_fail("Falscher Befehl. <todo hilfe|help> fuer Hilfe.\n");
  if (!(argument==this_interactive()->_unparsed_args()))
  {
    list_todo(2);
    return 1;
  }

  argumentliste=explode(argument," ");
  if (!sizeof(argumentliste))
  {
    list_todo(2);
    return 1;
  }

  switch (argumentliste[0])
  {
    case "hilfe":
    case "help":
      help();
      break;
    case "neu":
    case "new":
      new_todo();
      break;
    case "erledigt":
    case "done":
      done_todo();
      break;
    case "liste":
    case "list":
      list_todo(3);
      break;
    case "del":
    case "loeschen":
      del_todo();
      break;
    case "info":
      info_todo();
      break;
    case "rep":
    case "report":
      list_todo(2);
      break;
    case "set":
      set_prefs();
      break;
    case "pri":
    case "prioritaet":
      set_prio();
      break;
    case "pref":
    case "voreinstellung":
      list_pref();
      break;
    case "news":
    case "neues":
      v_hist();
      break;
    case "":
    default:
      return 0;
      break;
  }
  return 1;
}

int list_pref()
{
  write("Die momentanen Voreinstellungen sind:\n"
        "Reportlevel: "+reportlevel+"\n"
        "Warnlevel:   "+warnlevel+"\n"
        "Farblevel:   "+farblevel+"\n"
        "Resetlevel:  "+resetlevel+"\n"
        "Rahmen:      "+(frames?"Ein":"Aus")+"\n"
        "Auto-Expire: "+(expire!=-1?(expire?"Nach "+expire+" Monaten":"Sofort"):"Nie")+"\n"
       );

  return 1;
}

int set_prio()
{
  if (0==sizeof(tasks[AUFGABE]))
  {
    write("ToDo-Liste ist leer.\n");
    return 1;
  }
  if (sizeof(argumentliste)==1)
  {
    write("Nummer des ToDo eingeben (q fuer Abbruch): \n");
    input_to("set_pri");
  }
  else
  {
    set_pri(argumentliste[1]);
  }
  return 1;
}

int set_pri(string number)
{
  int no;

  if ((number=="")||(number=="q"))
  {
    write ("Prioritaet Setzen abgebrochen\n");
    return 0;
  }
  no=to_int(number);
  if ((0>no)||(sizeof(tasks[AUFGABE])<no))
  {
    write ("Dieses ToDo hast Du gar nicht.\n");
    write("Nummer ToDo eingeben (q fuer Abbruch): \n");
    input_to("set_pri");
    return 0;
  }
  if (sizeof(argumentliste)!=3)
  {
    write("Prioritaet des ToDo eingeben (1..5, Standard 0): ");
    input_to("set_pr",0,no);
    return 1;
  }
  else
  {
    set_pr(argumentliste[2],no);
  }
  return 1;
}

int set_pr(string prio,int number)
{
  int zahl;

  if (strlen(prio)==0)
  {
    tasks[PRIORITAET][number-1]="0";
  }
  else if ( (strlen(prio) > 1) || (intp(prio) == 0) )
  {
    zahl=to_int(prio);
    if (-1!=member(({0,1,2,3,4,5}),zahl))
    {
      tasks[PRIORITAET][number-1]=prio;
      write(BS("Die Prioritaet des ToDo "+number+" ('"+tasks[AUFGABE][number-1]+"') ist jetzt "+prio+".\n"));
      save_object("/players/"+geteuid()+"/.todolist");
    }
    else
    {
      write("Die Prioritaet muss im Bereich von 1 bis 5 liegen\n"
           +"Prioritaet des ToDo eingeben (Standard 0): ");
      input_to("set_pr",0,number);
      return 1;
    }
  }
  return 1;
}

int info_todo()
{
 write("ToDo "VERSION"("DATE")   (c) "C_YEARS" by Cirion@Silberland\n\n"
       "Diese ToDo-Liste speichert ToDos in einer Datei ab, so\n"
       "dass man sie immer von ueberall abrufen kann. Die Datei \n"
       "heisst .todolist.o und liegt im jeweiligen Homeverzeichnis.\n"
       "Features sind: Prioritaet des ToDos angeben, Meldung \n"
       "beim Einloggen, wenn es ToDos mit hoher Prioritaet gibt\n"
       "etc.\n"
       "Anregungen und Ideen dazu sind herzlich willkommen,\n"
       "Bugreports ebenso.\n\n"
       "Die Nutzung in andren Muds ist auch erlaubt, solange der\n"
       "Code unveraendert bleibt (sollte das Tool jemals seinen \n"
       "Weg dorthin finden). Ich waere dann auch gerne bereit, \n"
       "es auch dort zu supporten (d.h. bei Updates Bescheid \n"
       "zu geben).\n\n");
  return 1;
}

int v_hist()
{
  TP->More(V_HIST);
  return 1;
}

int list_todo(int opt)
{
  int i,j,warn;
  int zahl,tempprio;
  string moretext;
  string * lines;

  zahl=0;
  moretext="";
  switch (opt)
  {
    case 0:
      moretext+=(farblevel>0?ANSI_RED:"")+"\nAchtung!\n"+ANSI_NORMAL;
      for (i=sizeof(tasks[AUFGABE]);i-->0;)
        if ((to_int(tasks[PRIORITAET][i])>=warnlevel)
            &&(tasks[STATUS][i]==UNDONE)) zahl++;
        if (zahl>0)
          moretext+=zahl+" ToDos sind auf Deiner ToDo-Liste als besonders dringlich markiert.\n";
      break;
    case 1:
      if (!frames)
      {
        moretext+=(farblevel>0?ANSI_RED:"")+"\nAchtung!"+ANSI_NORMAL+" Folgende Dinge sind auf Deiner ToDo-"
                   +"Liste als besonders dringlich\nmarkiert:\n\n";
      }
      else
      {
        moretext+=
          "+----------------------------------------------------------------------------+\n"
          "| "+(farblevel?ANSI_RED:"")+
            "Achtung!"+(farblevel?ANSI_NORMAL:"")+
                    "                                                                   |\n"
          "| Folgende Dinge sind auf Deiner ToDo-Liste als besonders dringlich markiert |\n"
          "+----------------------------------------------------------------------------+\n";
      }
      warn=warnlevel;
      break;
    case 2:
      if (!frames)
      {
        moretext+="Report aller ToDos mit Prioritaet > "+reportlevel+" :\n\n";
      }
      else
      {
        moretext+=
          "+----------------------------------------------------------------------------+\n"
          "| Report aller ToDos mit Prioritaet > "+reportlevel+
                                                 "                                      |\n"
          "+----------------------------------------------------------------------------+\n";
      }
      warn=reportlevel;
      break;
    case 3:
      if (!frames)
      {
        moretext+="Deine ToDo-Liste sieht aus wie folgt:\n\n";
      }
      else
      {
        moretext+=
          "+----------------------------------------------------------------------------+\n"
          "| Deine Todo-Liste                                                           |\n"
          "+----------------------------------------------------------------------------+\n";
      }
      warn=0;
      break;
  }
  if (opt>0)
  {
    moretext+="     "+AUFGABE
            +"                          "+STATUS
            +"   "+PRIORITAET
            +"  "+DATUM
            +"          "+ERLEDIGTAM+"\n";
    for (i=0;i<sizeof(tasks[AUFGABE]);i++)
    {
      tempprio=to_int(tasks[PRIORITAET][i]);
      if ((tempprio>=warn)&&(!((tasks[STATUS][i]==DONE)&&(opt<3))))
      {
        zahl++;
        if (opt<2 || sizeof(lines=explode(break_string(tasks[AUFGABE][i],31),"\n"))==1)
        {
          moretext+=sprintf("%:3d  "+
            ((tempprio>=reportlevel && tasks[STATUS][i]==UNDONE && farblevel>0)?
              ((farblevel>1)?ANSI_YELLOW:ANSI_RED)
              :"")+"%:31-s  %:8-s  %:1s"+(farblevel?ANSI_NORMAL:"")+"   %:12s  %:12s\n",
              i+1,
              tasks[AUFGABE][i],
              tasks[STATUS][i],
              tasks[PRIORITAET][i],
              explode(dtime(tasks[DATUM][i]),", ")[1],
              (tasks[ERLEDIGTAM][i]!=-1)?
                explode(dtime(tasks[ERLEDIGTAM][i]),", ")[1]:"-");
        }
        else
        {
          moretext+=sprintf("%:3d  "+
            ((tempprio>=reportlevel && tasks[STATUS][i]==UNDONE && farblevel>0)?
              ((farblevel>1)?ANSI_YELLOW:ANSI_RED)
              :"")+"%:31-s  %:8-s  %:1s"+(farblevel?ANSI_NORMAL:"")+"   %:12s  %:12s\n",
              i+1,
              lines[0],
              tasks[STATUS][i],
              tasks[PRIORITAET][i],
              explode(dtime(tasks[DATUM][i]),", ")[1],
              (tasks[ERLEDIGTAM][i]!=-1)?
                explode(dtime(tasks[ERLEDIGTAM][i]),", ")[1]:"-");
          for (j=1;j<sizeof(lines);j++)
          {
            moretext+=sprintf("     "+
              ((tempprio>=reportlevel && tasks[STATUS][i]==UNDONE && farblevel>0)?
                ((farblevel>1)?ANSI_YELLOW:ANSI_RED)
                :"")+"%:31-s"+(farblevel?ANSI_NORMAL:"")+"\n",
                lines[j]);
          }
        }
      }
    }
    if (zahl<1)
    {
      switch (opt)
      {
        case 3:moretext="Deine ToDo-Liste ist leer! Du Gluecklicher!\n"
                       +"Aber das liegt sicher nur daran, dass Du hier nix "
                       +"eingetragen hast. Magier\nhaben immer Arbeit! :)";
               break;
        case 2:moretext="Du hast keine ToDos mit Prioritaet > "+opt+".";
               break;
      }
      moretext+="\n";
    }
    else
    {
      if (!frames)
        moretext+="\n";
      else
        moretext+="+----------------------------------------------------------------------------+\n";
    }
  }
  if (!((zahl==0)&&(opt<2)))
  {
    if (TP)
      if (opt>1)
        TP->More(moretext);
      else
        tell_object(TP,moretext);
    else if ((MENV) && (query_once_interactive(MENV)))
      if (opt>1)
        MENV->More(moretext);
      else
        tell_object(MENV,moretext);
  }
  return 1;
}

int del_todo()
{
  if (sizeof(tasks[AUFGABE])==0)
  {
    write("ToDo-Liste ist bereits leer.\n");
    return 1;
  }
  if (sizeof(argumentliste)==1)
  {
    write("Nummer des zu loeschenden ToDo eingeben (q fuer Abbruch): \n");
    input_to("set_del");
  }
  else
  {
    set_del(argumentliste[1]);
  }
  return 1;
}

int set_del(string number)
{
  int i,no;

  if ((number=="")||(number=="q"))
  {
    write ("Loeschen abgebrochen\n");
    return 0;
  }
  no=to_int(number);
  if ((1>no)||(sizeof(tasks[AUFGABE])<no))
  {
    write ("Dieses ToDo hast Du gar nicht.\n");
    write("Nummer des zu loeschenden ToDo eingeben (q fuer Abbruch): \n");
    input_to("set_del");
    return 0;
  }
  write("Das ToDo "+no+" ('"+tasks[AUFGABE][no-1]+"') wurde geloescht.\n");
  tasks[AUFGABE]=tasks[AUFGABE][0..no-2]+tasks[AUFGABE][no..<1];
  tasks[PRIORITAET]=tasks[PRIORITAET][0..no-2]+tasks[PRIORITAET][no..<1];
  tasks[DATUM]=tasks[DATUM][0..no-2]+tasks[DATUM][no..<1];
  tasks[ERLEDIGTAM]=tasks[ERLEDIGTAM][0..no-2]+tasks[ERLEDIGTAM][no..<1];
  tasks[STATUS]=tasks[STATUS][0..no-2]+tasks[STATUS][no..<1];
  save_object("/players/"+geteuid()+"/.todolist");
  return 1;
}

int done_todo()
{
  if (sizeof(tasks[AUFGABE])==0)
  {
    write("ToDo-Liste ist leer.\n");
    return 1;
  }
  if (sizeof(argumentliste)==1)
  {
    write("Nummer des abzuhakenden ToDo eingeben (q fuer Abbruch):\n");
    input_to("set_done");
  }
  else
  {
    set_done(argumentliste[1]);
  }
  return 1;
}

int set_done(string number)
{
  int no;

  string date;

  if ((number=="")||(number=="q"))
  {
    write ("Abhaken abgebrochen\n");
    return 0;
  }
  no=to_int(number);
  if ((1>no)||(sizeof(tasks[AUFGABE])<no))
  {
    write ("Dieses ToDo hast Du gar nicht.\n");
    write("Nummer des abzuhakenden ToDo eingeben (q fuer Abbruch): \n");
    input_to("set_done");
    return 0;
  }
  if (expire != 0)
  {
    tasks[STATUS][no-1]=DONE;
    tasks[ERLEDIGTAM][no-1]=time();
    write(BS("Das ToDo "+no+" ('"+tasks[AUFGABE][no-1]+"') wurde abgehakt.\n"));
  }
  else
  {
    write(break_string(
      "Das ToDo "+no+" ('"+tasks[AUFGABE][no-1]+"') wurde abgehakt und "
      "geloescht."));
    tasks[AUFGABE]=tasks[AUFGABE][0..no-2]+tasks[AUFGABE][no..<1];
    tasks[PRIORITAET]=tasks[PRIORITAET][0..no-2]+tasks[PRIORITAET][no..<1];
    tasks[DATUM]=tasks[DATUM][0..no-2]+tasks[DATUM][no..<1];
    tasks[ERLEDIGTAM]=tasks[ERLEDIGTAM][0..no-2]+tasks[ERLEDIGTAM][no..<1];
    tasks[STATUS]=tasks[STATUS][0..no-2]+tasks[STATUS][no..<1];
  }
  save_object("/players/"+geteuid()+"/.todolist");
  return 1;
}

int new_todo()
{
  if (sizeof(argumentliste)==1)
  {
    write("Wie soll das ToDo heissen? (q fuer Abbruch):\n");
    input_to("set_task");
  }
  else
  {
    set_task(implode(argumentliste[1..sizeof(argumentliste)-1]," "));
  }
  return 1;
}

int set_task(string titel)
{
  if ((titel=="")||(titel=="q"))
  {
    write ("Neues ToDo abgebrochen\n");
    return 0;
  }
  tasks[AUFGABE]+=({titel});
  write("Prioritaet des ToDo eingeben (1..5, Standard 0): \n");
  input_to("set_priority");
  return 1;
}

int set_priority(string prio)
{
  int zahl;

  if (strlen(prio)==0)
  {
    tasks[PRIORITAET]+=({"0"});
  }
  else
  {
    zahl=to_int(prio);
    if (-1!=member(({0,1,2,3,4,5}),zahl))
    {
      tasks[PRIORITAET]+=({prio});
    }
    else
    {
      write("Die Prioritaet muss im Bereich von 1 bis 5 liegen\n"
           +"Prioritaet des ToDo eingeben (Standard 0): \n");
      input_to("set_priority");
      return 1;
    }
  }
  tasks[DATUM]+=({time()});
  tasks[ERLEDIGTAM]+=({-1});
  tasks[STATUS]+=({UNDONE});
  write("Neues ToDo ('"+tasks[AUFGABE][sizeof(tasks[AUFGABE])-1]+"').\n");
  save_object("/players/"+geteuid()+"/.todolist");
  return 1;
}

int help()
{
  if  (2>sizeof(argumentliste))
  {
    write("ToDo "VERSION" ("DATE")   (c) "C_YEARS" by Cirion@Silberland\n\n"
          "Folgende Befehle sind moeglich:\n\n"
          "todo hilfe|help [<cmd>] ............... Dies hier\n"
          "todo neu|new [<titel>] ................ neues ToDo\n"
          "todo erledigt|done [<nr>] ............. ToDo abhaken.\n"
          "todo prioritaet|pri [<nr>][<lvl>] ..... Prioritaet setzen\n"
          "todo liste|list ....................... Liste aller ToDos\n"
          "todo loeschen|del ..................... ToDo aus Liste entfernen\n"
          "todo [report|rep] ..................... ToDo-Report ausgeben\n"
          "todo set <voreinst.> <wert> ........... ToDo-Voreinstellungen\n"
          "todo pref|voreinstellung .............. Voreinstellungen zeigen\n"
          "todo news|neues ....................... Veraenderungen/Version history\n"
          "todo info ............................. Genauere Infos :)\n\n"
          "Zusaetzliche Hilfe gibt es zu allen Befehlen mit <todo hilfe|help cmd>.\n"
          "Beispiel: 'todo help help' gibt Hilfe zum Befehl help aus.\n"
         );
  }
  else
  {
    switch (argumentliste[1])
    {
    case "help":
    case "hilfe":
      write("<todo hilfe|help> gibt die verfuegbaren Kommandos aus.\n"
            "Mit todo <hilfe|help cmd> laesst sich ausserdem zu jedem\n"
            "Kommando noch eine umfangreichere Hilfe anzeigen.\n"
            );
      break;
    case "neu":
    case "new":
      write("Mit <todo neu|new> lassen sich neue Listeneintraege erzeugen.\n"
            "Dabei kann man den Titel des ToDo direkt als Argument oder\n"
            "nach der Eingabeaufforderung eingeben. Fuer jedes neue ToDo\n"
            "muss eine Prioritaet gesetzt werden, mit <Return> wird dabei\n"
            "der Default-Wert von 0 uebernommen.\n"
            );
      break;
    case "done":
    case "erledigt":
      write("Mit <todo erledigt|done> kann man ein ToDo als erledigt setzen.\n"
            "Die Nummer des ToDo kann dabei als Argument oder nach der\n"
            "Eingabeaufforderung angegeben werden.\n"
            );
      break;
    case "prioritaet":
    case "pri":
      write("Mit <todo prioritaet|pri> kann man die Prioritaet eines ToDo\n"
            "nachtraeglich veraendern. Dazu kann man sowohl die Nummer\n"
            "als auch die neue Prioritaet als Argument oder nach der\n"
            "Eingabeaufforderung angeben.\n"
            );
      break;
    case "liste":
    case "list":
      write("<todo liste|list> gibt die koplette Liste von ToDos aus, die\n"
            "man bereits hat.\n"
            );
      break;
    case "loeschen":
    case "del":
      write("Mit <todo loeschen|del> kann man komlette Eintraege aus der Liste\n"
            "entfernen. Die Nummer des Eintrags kann dabei als Argument oder\n"
            "nach der Eingabeaufforderung angegeben werden.\n"
            );
      break;
    case "rep":
    case "report":
      write("<todo [report|rep]> gibt die Liste derjenigen ToDos aus, deren \n"
            "Prioritaet hoeher liegt, als das momentane Reportlevel.\n"
            );
      break;
    case "set":
      write("Mit <todo set> kann man die Voreinstellungen des Tools aendern.\n"
            "Dazu gibt man bei <todo set> als Argumente zunaechst die entsprechende\n"
            "Einstellungan (rep(ortlevel), warn(level), farb(level), reset(level), \n"
            "frames, (auto)expire)) und danach den gewuenschten Wert an. Zu jeder \n"
            "der Einstellungen gibt es eine separate Hilfe (todo help reportlevel \n"
            "etc.)\n");
      break;
    case "resetlevel":
      write("Das Resetlevel gibt an, was fuer eine Ausgabe die Todoliste im Reset\n"
            "erzeugt. 0 bedeutet keine Ausgabe, 1 zaehlt nur die Anzahl der Eintraege,\n"
            "welche mindestens das Warnlevel haben und 2 gibt diese Eintraege komplett\n"
            "aus.\n"
            "Standard fuer das Resetlevel ist " + DEFAULT_RESETLEVEL + ".\n");
      break;
    case "warnlevel":
    case "warn":
      write("Das Warnlevel gibt an, ab welcher Prioritaet ToDos im Reset angezeigt\n"
            "werden. Standard ist hier " + DEFAULT_WARNLEVEL + ", und es sollte nicht zu niedrig sein.\n");
      break;
    case "farblevel":
    case "farb":
      write("Das Farblevel gibt an, ob eine farbige Ausgabe der ToDos erfolgt. Bei 0\n"
            "wird nichts eingefaerbt, 1 und 2 sind unterschiedliche Farbeinstellungen.\n"
            "Standard ist " + DEFAULT_FARBLEVEL + ".\n");
      break;
    case "reportlevel":
      write("Das Reportlevel gibt an, welche Todos beim Report ausgegeben werden.\n"
            "Standard ist hier " + DEFAULT_REPORTLEVEL + ".\n");
      break;
    case "frames":
    case "frame":
    case "rahmen":
      write("Wenn rahmen (frames) eingeschaltet ist, wird die ToDo-Liste mit Rahmen\n"
            "ausgegeben. Moegliche Werte sind also an (on) oder aus (off)\n");
      break;
    case "expire":
    case "autoexpire":
    case "auto-expire":
      write("Auto-Expire gibt an, ob und wenn ja nach wie vielen Monaten ein\n"
            "erledigtes ToDo automatisch von der Liste entfernt wird. Moegliche\n"
            "Werte sind also aus/nie (off/never) oder eine Monatszahl groesser 0.\n");
      break;
    case "pref":
    case "voreinstellung":
      write("<todo pref|voreinstellung> gibt die momentanen Voreinstellungen.\n"
            "aus. Standard ist Warnlevel " + DEFAULT_WARNLEVEL + ", Reportlevel " + DEFAULT_REPORTLEVEL + ", Farblevel " + DEFAULT_FARBLEVEL + " und \n"
            "Resetlevel " + DEFAULT_RESETLEVEL + ".\n"
            );
      break;
    case "info":
      write("<todo info> gibt zusaetzliche Informationen ueber ToDo aus.\n"
            );
      break;
    case "news":
    case "neues":
      write("<todo news|neues> gibt die Liste der Veraenderungen des ToDo-Tools aus.\n"
            );
      break;
    default:
      write("Falscher Befehl. <todo hilfe hilfe> fuer Hilfe.\n");
      break;
    }
  }
  return 1;
}

int dtime2time(string dtime)
{
  int time, day, year, hour, minute, second;
  string dummy, month;

  if (intp(dtime))
    return (int)dtime;

  if (sscanf(dtime,"%3s, %d. %3s %4d, %2d:%2d:%2d",dummy,day,month,year,hour,minute,second)!=7)
    return -1;

  time = (day-1)*86400 + (year-1970)*31536000 + hour*3600 + minute*60 + second + 31536000;
  switch(month)
  {
    case "Jan":
      time -= 31*86400;
    case "Feb":
      time -= 29*86400;
    case "Mar":
      time -= 31*86400;
    case "Apr":
      time -= 30*86400;
    case "Mai":
      time -= 31*86400;
    case "Jun":
      time -= 30*86400;
    case "Jul":
      time -= 31*86400;
    case "Aug":
      time -= 31*86400;
    case "Sep":
      time -= 30*86400;
    case "Okt":
      time -= 31*86400;
    case "Nov":
      time -= 30*86400;
    case "Dez":
      time -= 31*86400;
  }
  time += 86400*8;
  return time;
}
