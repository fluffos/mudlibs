/* programm zur uebersetzung von Properties in der #define P_ form */
/* in die reale Form. VORSICHT, dieses File muss mit properties.h  */
/* manuell abgeglichen werden.     7.7.92 Rumata                   */

mixed propList;

remove() { destruct( this_object() ); }   /* updatebar */

move() { return 0; }                      /* nicht beweglich */

TheProp( prop ) { return assoc( prop, propList ); }

create() 
{
  /* kann nicht gecloned werden */
  if( sizeof( explode( file_name(this_object()), "#" )) > 1 ) return 0;
