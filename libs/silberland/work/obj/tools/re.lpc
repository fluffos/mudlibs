#include "/players/thingol/tools/re/main.lpc"

void create()
{
	if(!is_clone(this_object())) return;
	::create();
	SetProp(P_WEIGHT,0);
	SetProp(P_VALUE,0);
	SetProp(P_SHORT,this_player()->name(1)+" Roomeditor Version 1.12");
	SetProp(P_NAME,"Roomeditor");
	SetProp(P_LONG,
	 "Das ist ein Roomeditor um Raeume zu bauen.\n"
	+"Fuer Hilfe mach mal 'rman'.\n"
	);
	AddId(({"editor","roomeditor","re"}));

	AddCmd(({"add"}),"RE_Add");
	AddCmd(({"remove"}),"RE_Remove");
	AddCmd(({"cpy"}),"RE_Copy");
	AddCmd(({"rman"}),"RE_Man");
	AddCmd(({"room"}),"RE_Room");
	AddCmd(({"set"}),"RE_Set");
	AddCmd(({"show"}),"RE_Show");

	seteuid(getuid(this_object()));
	Cloner=this_player()->query_real_name();
}

