inherit "std/thing";

#include <language.h>
#include <properties.h>

string *weit = ({
      "so gut wie gar nicht",
      "nicht weit",
      "ein Stueckchen",
      "etwas weiter",
      "ziemlich weit",
      "einige Meter weit",
    });

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Wuerfel");
  SetProp(P_LONG, "Ein Wuerfel mit 6 Seiten.\n");
  SetProp(P_NAME, "Wuerfel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);
  AddId("wuerfel");
	AddCmd("wuerfel","wuerfel");
}

int wuerfel()
{
  int zahl;
  string wieweit;

  zahl = random(6) + 1;
  wieweit = weit[random(sizeof(weit))];

  write("Du wirfst Deinen Wuerfel.\nEr rollt " + wieweit +
      " und zeigt schliesslich eine " + zahl + ".\n");
  say(this_player()->name() + " wirft einen Wuerfel.\n"
      "Der Wuerfel rollt " + wieweit +
      " und zeigt schliesslich eine " + zahl + ".\n");
  return 1;
}
