inherit "std/thing";

#include <language.h>
#include <properties.h>

string farbe;
string *farben = ({ "rubinrot", "smaragdgruen", "gelbgold", "saphirblau",
    "schwarz", "dunkelviolett" });


void create()
{
  ::create();
  if (!is_clone(this_object())) return;

  farbe = farben[random(sizeof(farben))];

  AddId("wuerfel");
  AddId("wuerfel20");
  AddId("20seiter");
  AddId("20-seiter");
  AddAdjective( ({ farbe+"en" }) );

  SetProp(P_SHORT, "Ein 20-seitiger Wuerfel");
  SetProp(P_LONG, "Ein Wuerfel mit 20 Seiten. Er schimmert in noblem " +
      capitalize(farbe) + ". Sehr haeufig wird er fuer Rollenspiele "
      "und aehnlichen zeitraubenden Kram verwendet. Er wurde sehr "
      "sorgfaeltig verarbeitet und wird Dir sicher lange Freude "
      "bereiten.");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Wuerfel");
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 25);

  AddDetail( ({ "seite", "seiten" }),
      "Der Wuerfel besitzt 20 Seiten, ueberraschenderweise "
      "sind diese von 1 bis 20 durchnumeriert. Nein, halt: auf "
      "magische Weise formen sich aus den Zahlen ploetzlich Augen." );
  AddDetail( ({ "zahl", "zahlen" }),
      "Fliessend scheinen sie in Augen ueberzugehen.\n"
      "Gluecklicherweise nicht in Deine." );
  AddDetail( ({ "auge", "augen" }),
      ([ 0 : "Du faengst an, die Augen des Wuerfels zu zaehlen.\n"
             "Schliesslich stellst Du fest, dass es ganze 210 sind.\n",
         "zwerg" : "Du faengst an, die Augen des Wuerfels zu zaehlen.\n"
             "Bei 3 gibst Du entnervt auf.\n",
         "troll" : "Du faengst an, die Augen des Wuerfels zu zaehlen.\n"
             "Bei 10 gehen Dir die Finger aus.\n",
         "hobbit": "Du faengst an, die Augen des Wuerfels zu zaehlen.\n"
             "Bei 80 bekommst Du zum ersten Mal Hunger.\n"
             "Bei 150 knurrt Dein Magen schon sehr stark.\n"
             "Schliesslich langst Du bei 210 an, allerdings halb verhungert.\n",
         "elf"   : "Du betrachtest den Wuerfel kurz von zwei Seiten und "
             "stellst blitzschnell\nfest, dass er 210 Augen besitzt.\n" ]) );

  switch (random(25))
  {
    case  0..10: SetProp( P_MATERIAL, MAT_MISC_JEWEL ); break;
    case 11..20: SetProp( P_MATERIAL, MAT_IVORY ); break;
    default:     SetProp( P_MATERIAL, MAT_PEAR_WOOD );
  }

  AddCmd( ({ "wuerfel", "wuerfle" }), "cmd_wuerfel" );
}


int cmd_wuerfel(string str)
{
  int zahl;

  // WENN ein Argument angegeben wurde, DANN muss der Wuerfel auch
  // angesprochen worden sein (damit kann man mit verschiedenen
  // Wuerfeln aus dem Inventory wuerfeln)
  if (stringp(str))
  {
    if (str[0..3] == "mit ") str = str[4..];
    if (!id(str))
      return notify_fail("Womit moechtest Du wuerfeln?\n"), 0;
  }

  zahl = random(20) + 1;

  if (this_player()->QueryProp(P_BLIND))
    write("Du wuerfelst.\n");
  else
    write("Du wuerfelst eine " + zahl + ".\n");

  environment(this_player())->Message(
      this_player()->Name() + " wuerfelt eine " + zahl + ".\n",
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);

  return 1;
}
