/* 
 *  15.08.2012 07:59:35 
 *     Add special id
 *     check on environment() in hb.
 */

#include <properties.h>
#include <language.h>
inherit "std/thing";

int    alter;
string furzer1,furzer2;

create()
{
  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Etwas");
  SetProp(P_GENDER, 1);
  SetProp(P_ARTICLE,0);
  SetProp(P_NOGET,"Haeh?\n");
  AddId(({"_furz_","\nobj_misc_furz"}));
  alter = 0;
  set_heart_beat(1);
}

heart_beat()
{
  int i;

  if (!objectp(environment()))
    return;

  if (!alter)
    tell_room(environment(), "Fuerchterlicher Gestank erfuellt den Raum.\n");
  alter++;
  if (!random(10))
  {
    i = random (10);
    if (i==0)
      tell_room(environment(), furzer1+" Furz stinkt wirklich grauenerregend.\n");
    if (i==1)
      tell_room(environment(), "Du haeltst Dir die Nase zu.\n");
    if (i==2)
      tell_room(environment(), "Widerliche Duenste erfuellen den Raum.\n");
    if (i==3)
      tell_room(environment(), "Der Furz riecht, als wuerde " + furzer2 +" innerlich verfaulen.\n");
    if (i==4)
      tell_room(environment(), "Du musst Dich beinah uebergeben, als " + furzer1 + " Furz in Deine Nase kriecht.\n"); 
    if (i==5)
      tell_room(environment(), "Dir kriecht ein Furz von "+furzer2+" tief in Deine Nase ein!\n");
    if (i==6)
      tell_room(environment(), "Der Furz von "+furzer2+" hat einen gewissen eigenen Charakter entwickelt.\n");
    if (i==7)
      tell_room(environment(), "Hier riecht es nach 1000 faulen Eiern!\n");
    if (i==8)
      tell_room(environment(), furzer1+" Furz brennt Dir sogar schon in den Augen.\n");
    if (i==9)
      tell_room(environment(), furzer2+" hat anscheinend vorhin rote Bohnen gegessen!\n");
  }
  if (alter>=45) {
      tell_room(environment(), furzer1 + " widerlicher Furz hat sich endlich verzogen.\n");
      destruct(this_object());
    }
}

set_furzer (object wer)
{
  furzer1 = wer->name(WESSEN);
  furzer2 = wer->name();
}

reset() {
  ::reset();
  call_out("remove",0);
}

