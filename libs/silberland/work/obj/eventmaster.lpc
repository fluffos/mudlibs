#include <properties.h>
#include <daemon.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

private nosave mixed _name_;

void create() {
  if (is_clone(this_object())) return destruct(this_object());
}

int remove() { return 0; }

query_prevent_shadow() { return 1; }

int check(string ch, object pl, string cmd, string txt)
{
  string fn;
  if(ch != "Event") return 0;
  if(interactive(pl) && IS_LORD(pl)) return 1;
  switch(cmd)
  {
    case C_SEND:
      fn=file_name(pl);
      if (fn[0..8]!="/d/event/"&&fn!="/gilden/nekromanten/master/nekromaster") 
        return 0;
      // else fall-thru
    default:
      return 1;
  }
}

string name() { return _name_ ? _name_ : "<Event>"; }

