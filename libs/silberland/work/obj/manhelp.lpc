/*
 * uebernommen aus der Wunderland Mudlib
 * Zettel, der die Ergebnisse des intermud-man sammelt
 * Autor: Fiona@Wunderland
 */

inherit "/std/thing";

#include <properties.h>
#include <udp.h>
#pragma strong_types

nosave string txt;
string liestxt();
object owner;

void create()
{
  if (!is_clone(this_object())) return;
  seteuid(0);   // Security
  ::create();
  SetProp(P_LONG, "Dies ist ein leerer Zettel.\n");
  SetProp(P_SHORT, "Ein Zettel");
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  AddId("zettel");
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_READ_MSG, #'liestxt);
  txt="";
}

public void SetKey(string key) {
    SetProp(P_LONG,
        sprintf( "Auf diesem Zettel sammelt der Internet-Daemon die "
          "Ergebnisse Deiner Manual-Anfrage nach \'%s\'. Sobald etwas "
          "angekommen ist, kannst Du es hierauf lesen.", key) );
}

public void udp_reply(mapping data) {
    if (data[SYSTEM]) {
        if (data[SYSTEM]==TIME_OUT) {
            txt+="Manualanfrage nach "+data[NAME]+" 'timed out'.\n";
        }
    } else {
        txt+=sprintf("%'-'|78s\n%s", " "+data[NAME]+" ", data[DATA]);
        if (interactive(owner))
          tell_object(owner,
              sprintf("Dein Zettel fuellt sich magisch mit Informationen "
                "aus %s.\n", data[NAME]));
    }
}

string liestxt() {
    if (!strlen(txt)) return "Auf dem Zettel steht noch nichts...\n";
    // dummer trick, weil eingebautes lesen kein more hat...
    this_player()->More(txt);
    return "";
}

int move(mixed dest, int meth)
{
  if (environment() && (!objectp(dest) || !interactive(dest)))
    call_out("zerfall",2);
  owner=dest;
  return ::move(dest, meth);
}

void zerfall() {
    object env;
    env=environment();
    if (env) {
        if (living(env))
          tell_object(env, "Der Zettel zerfaellt.\n");
        else
          tell_room(env, "Der Zettel zerfaellt.\n");
    }
    remove();
}

