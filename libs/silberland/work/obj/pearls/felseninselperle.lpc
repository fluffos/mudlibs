
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Felseninselperle");
  SetProp(P_LONG, BS( 
    "Das ist eine winzige, gruene Perle. Man findet sie in der "
    "Naehe der Felseninsel."));
  SetProp(P_INFO, 
    "Felseninselperlen haben ganz bestimmt magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Felseninselperle", "Felseninselperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"winzig","gruen"}));
  AddSingularId( ({"perle","felseninselperle","felsenperle","inselperle"}) );
  AddPluralId( ({"perlen", "felseninselperlen", "felsenperlen","inselperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(50,1);
  SetGramsPerUnits(1,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gruen");
}
