
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Midasperle");
  SetProp(P_LONG, BS( 
    "Das ist eine mittelgrosse, rote Perle. Man findet sie in der "
    "Naehe des Piers von Midas."));
  SetProp(P_INFO, 
    "Midasperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Midasperle", "Midasperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"mittelgross","rot"}));
  AddSingularId( ({"perle","midasperle"}) );
  AddPluralId( ({"perlen", "midasperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(90,1);
  SetGramsPerUnits(3,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "rot");
}
