
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Smoerskyperle");
  SetProp(P_LONG, BS( 
    "Das ist eine kleine, gelbe Perle. Man findet sie in der "
    "Naehe von Smoersky."));
  SetProp(P_INFO, 
    "Smoerskyperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Smoerskyperle", "Smoerskyperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"klein","gelb"}));
  AddSingularId( ({"perle","smoerskyperle"}) );
  AddPluralId( ({"perlen", "smoerskyperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(95,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gelb");
}
