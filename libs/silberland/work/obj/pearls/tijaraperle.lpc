
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Tijaraperle");
  SetProp(P_LONG, BS( 
    "Das ist eine mittelgrosse, orangene Perle. Man findet sie in der "
    "Naehe von Tijara, aber nicht auf einer Insel!"));
  SetProp(P_INFO, 
    "Tijaraperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Tijaraperle", "Tijaraperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gross","orangen"}));
  AddSingularId( ({"perle","tijaraperle"}) );
  AddPluralId( ({"perlen", "tijaraperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(175,1);
  SetGramsPerUnits(6,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "orange");
}
