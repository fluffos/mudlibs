
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Schwertfischperle");
  SetProp(P_LONG, BS( 
    "Das ist eine riesige, gelbe Perle. Man findet sie in der "
    "Naehe von Schwertfischen."));
  SetProp(P_INFO, 
    "Schwertfischperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Schwertfischperle", "Schwertfischperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"riesig","gelb"}));
  AddSingularId( ({"perle","schwertfischperle"}) );
  AddPluralId( ({"perlen", "schwertfischperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(230,1);
  SetGramsPerUnits(14,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gelb");
}
