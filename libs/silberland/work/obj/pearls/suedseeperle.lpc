
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Suedseeperle");
  SetProp(P_LONG, BS( 
    "Das ist eine sehr grosse, violette Perle. Man findet sie "
    "nur in den suedlichsten Gewaessern."));
  SetProp(P_INFO, 
    "Suedseeperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Suedseeperle", "Suedseeperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gross","violett"}));
  AddSingularId( ({"perle","suedseeperle"}) );
  AddPluralId( ({"perlen", "suedseeperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(177,1);
  SetGramsPerUnits(10,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "violett");
}
