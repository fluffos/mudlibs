
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Krakenperle");
  SetProp(P_LONG, BS( 
    "Das ist eine grosse, schwarze Perle. Man findet sie nur in der "
    "Naehe von Kraken."));
  SetProp(P_INFO, 
    "Krakenperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Krakenperle", "Krakenperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gross","schwarz"}));
  AddSingularId( ({"perle","krakenperle"}) );
  AddPluralId( ({"perlen", "krakenperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(140,1);
  SetGramsPerUnits(8,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "schwarz");
}
