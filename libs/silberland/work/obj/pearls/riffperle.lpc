
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Riffperle");
  SetProp(P_LONG, BS( 
    "Das ist eine kleine, weisse Perle. Man findet sie am ehesten "
    "bei Riffen. Im SilberLand gibt es jede Menge dieser Perlen."));
  SetProp(P_INFO,
    "Riffperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Riffperle", "Riffperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"klein","weiss"}));
  AddSingularId( ({"perle","riffperle"}) );
  AddPluralId( ({"perlen", "riffperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(100,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");
}
