
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Walperle");
  SetProp(P_LONG, BS( 
    "Das ist eine gigantische, blaue Perle. Man findet sie in der "
    "Naehe von Walen."));
  SetProp(P_INFO, 
    "Walperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Walperle", "Walperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gigantisch","blau"}));
  AddSingularId( ({"perle","walperle"}) );
  AddPluralId( ({"perlen", "walperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(250,1);
  SetGramsPerUnits(15,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "blau");
}
