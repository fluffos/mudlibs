
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Piratenperle");
  SetProp(P_LONG, BS( 
    "Das ist eine sehr grosse, blutrote Perle. Man findet sie sehr "
    "selten. Angeblich war sie das bevorzugte Tauschmittel der Piraten."));
  SetProp(P_INFO, 
    "Piratenperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Piratenperle", "Piratenperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gross","blutrot"}));
  AddSingularId( ({"perle","piratenperle"}) );
  AddPluralId( ({"perlen", "piratenperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(200,1);
  SetGramsPerUnits(10,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "rot");
}
