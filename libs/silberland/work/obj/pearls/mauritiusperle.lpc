
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Mauritiusperle");
  SetProp(P_LONG, BS( 
    "Das ist eine kleine, gruene Perle. Man findet sie in der "
    "Naehe der Insel Mauritius."));
  SetProp(P_INFO, 
    "Mauritiusperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Mauritiusperle", "Mauritiusperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"klein","gruen"}));
  AddSingularId( ({"perle","mauritiusperle"}) );
  AddPluralId( ({"perlen", "mauritiusperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(110,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gruen");
}
