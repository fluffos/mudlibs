
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Derlimperle");
  SetProp(P_LONG, BS( 
    "Das ist eine klein, braune Perle. Man findet sie in der Naehe von Derlim."));
  SetProp(P_INFO, 
    "Derlimperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Derlimperle", "Derlimperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"klein","braun"}));
  AddSingularId( ({"perle","derlimperle"}) );
  AddPluralId( ({"perlen", "derlimperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(70,1);
  SetGramsPerUnits(3,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "braun");
}
