inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Quaulperle");
  SetProp(P_LONG, BS( 
    "Das ist eine kleine, tuerkise Perle. Man findet sie in der "
    "Naehe von Quaul. Heute findet man keine neuen Quaulperlen mehr, da "
    "Quaul inzwischen mitten in der Wueste liegt."));
  SetProp(P_INFO, 
    "Quaulperlen haben magische Faehigkeiten und sind sehr selten.\n");
  SetProp(P_NAME, ({"Quaulperle", "Quaulperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"klein","tuerkis"}));
  AddSingularId( ({"perle","quaulperle"}) );
  AddPluralId( ({"perlen", "quaulperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(80,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "tuerkis");
}
