
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Korallenperle");
  SetProp(P_LONG, BS( 
    "Das ist eine kleine, hellblaue Perle. Man findet sie in der "
    "Naehe von Korallen."));
  SetProp(P_INFO, 
    "Korallenperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Korallenperle", "Korallenperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"klein","hellblau"}));
  AddSingularId( ({"perle","korallenperle"}) );
  AddPluralId( ({"perlen", "korallenperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(80,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "blau");
}
