
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Knarkhperle");
  SetProp(P_LONG, BS( 
    "Das ist eine grosse, tuerkisfarbene Perle. Man findet sie in "
    "der Naehe von Knarkh."));
  SetProp(P_INFO, 
    "Knarkhperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Knarkhperle", "Knarkhperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gross","tuerkis"}));
  AddSingularId( ({"perle","knarkhperle"}) );
  AddPluralId( ({"perlen", "knarkhperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(160,1);
  SetGramsPerUnits(8,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "tuerkis");
}
