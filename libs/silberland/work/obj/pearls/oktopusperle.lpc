
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Oktopusperle");
  SetProp(P_LONG, BS( 
    "Das ist eine sehr kleine, gelbe Perle. Man findet sie in der "
    "Naehe von Oktopussen."));
  SetProp(P_INFO, 
    "Oktopusperlen haben keine magischen Faehigkeiten.\n");
  SetProp(P_NAME, ({"Oktopusperle", "Oktopusperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"klein","gelb"}));
  AddSingularId( ({"perle","oktopusperle"}) );
  AddPluralId( ({"perlen", "oktopusperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(60,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gelb");
}
