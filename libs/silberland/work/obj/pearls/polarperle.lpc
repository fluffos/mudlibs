
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Polarperle");
  SetProp(P_LONG, BS( 
    "Das ist eine kleine, orange Perle. Man findet sie nur in "
    "den Gewaessern am Polar."));
  SetProp(P_INFO, 
    "Polarperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Polarperle", "Polarperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"klein","orangen"}));
  AddSingularId( ({"perle","polarperle"}) );
  AddPluralId( ({"perlen", "polarperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(50,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "orange");
}
