
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Zombieinselperle");
  SetProp(P_LONG, BS( 
    "Das ist eine grosse, weisse Perle. Man findet sie in der "
    "Naehe der Zombieinsel."));
  SetProp(P_INFO, 
    "Zombieinselperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Zombieinselperle", "Zombieinselperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gross","weiss"}));
  AddSingularId( ({"perle","zombieinselperle", "inselperle","zombieperle"}) );
  AddPluralId( ({"perlen", "zombieinselperlen","zombieperlen","inselperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(132,1);
  SetGramsPerUnits(3,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");
}
