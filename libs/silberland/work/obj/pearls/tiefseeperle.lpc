
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Tiefseeperle");
  SetProp(P_LONG, BS( 
    "Das ist eine riesige, gruene Perle. Man findet sie in nur in "
    "den tiefsten Gewaessern."));
  SetProp(P_INFO, 
    "Tiefseeperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Tiefseeperle", "Tiefseeperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"riesig","gruen"}));
  AddSingularId( ({"perle","tiefseeperle"}) );
  AddPluralId( ({"perlen", "tiefseeperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(200,1);
  SetGramsPerUnits(8,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gruen");
}
