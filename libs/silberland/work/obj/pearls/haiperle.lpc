
inherit "std/unit";

#include <properties.h>
#include <language.h>

#define BS break_string

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Haiperle");
  SetProp(P_LONG, BS( 
    "Das ist eine grosse, violette Perle. Man findet sie in der Naehe von Haien."));
  SetProp(P_INFO, 
    "Haiperlen haben magische Faehigkeiten.\n");
  SetProp(P_NAME, ({"Haiperle", "Haiperlen"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gross","violett"}));
  AddSingularId( ({"perle","haiperle"}) );
  AddPluralId( ({"perlen", "haiperlen"}) );
  AddId( "PERLE" );
  SetCoinsPerUnits(180,1);
  SetGramsPerUnits(7,1);

  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "violett");
}
