#include <properties.h>
#include <defines.h>
#include <moredef.h>

inherit "/std/container";


void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"beutel", "seidenbeutel", "beutel aus seide"}));
  SetProp(P_SHORT, "Ein Beutel aus reinster Seide");
  SetProp(P_LONG,
        "Dieser Beutel besteht aus feinster Seide. Sie ist enorm leicht "
        "und unglaublich reissfest und bietet Dir schier endlos Platz "
        "fuer alle Deine Gueter, die Du so mit Dir rumtraegst. Er wurde "
        "Dir anlaesslich der Feierlichkeiten zum 200-taegigen Bestehen "
        "der Welt seit dem letzten Weltuntergang von den Goettern "
        "geschenkt.");
  AddDetail("seide", "So feine Seide hast Du noch nirgendwo gesehen.\n");
  AddDetail("platz", "Er scheint fast unbegrenzt zu sein.\n");
  AddDetail("bestehen", "An diese Feier wird man noch lange zurueckdenken.\n");
  AddDetail("feier", "Sie war grandios!\n");

  SetProp(P_NAME,
      ({ "Beutel aus Seide", "Beutels aus Seide",
         "Beutel aus Seide", "Beutel aus Seide" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 200);
  SetProp(P_WEIGHT_PERCENT, 10);
  SetProp(P_MAX_WEIGHT, 20000);
  SetProp(P_VALUE, 2000);
  SetProp(P_INFO,
      "Dieser Beutel ermoeglicht es Dir, extrem viele Sachen mit Dir\n"
      "herum zu tragen.\n");
  SetProp(P_MATERIAL, MAT_SILK);
}
