#include <properties.h>

private string ulog = "";

create(){
  if (sizeof(explode(file_name(this_object()),"#"))>1)
  {
    destruct(this_object());
    return;
  }
  WaitForQuarterHour();
}

QuarterReached()
{
  int std;
  int min;
  string ct, str, format;
  object *u;
  int i;

  sscanf((ct=ctime(time()))[11..15],"%d:%d", std, min);

  if (min <= 2)
  {
  	u=users();
	for (i=sizeof(u)-1;i>=0;i--)
	{
	  format=u[i]->QueryProp(P_CLOCKMSG) ||
                 "Du hoerst die Uhr schlagen: Es ist jetzt %d Uhr.\n";
	  if (strstr(format,"%d",0)==-1)
	  	str=format;
	  else
	  	str=sprintf(format,std);
	  if (str!="") tell_object(u[i],str);
	}
  }
  str = "";
  if (min < 10)
  {
    log_file("game/USER_STATISTIK", ulog);
    ulog = sprintf("\n%s%02d: ",(!std?("# "+ct+":\n"):""),std);
  }
  ulog += sprintf("%4d",sizeof(users()));
  WaitForQuarterHour();
}

WaitForQuarterHour()
{
  while(remove_call_out("QuarterReached")!=-1);
  call_out("QuarterReached",900-(time() % 900));
}
