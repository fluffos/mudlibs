//
// pony_hook 14.05.93 Rumata
//
// Da der Pony-Shadow sich nicht im Player befinden darf,
// muss ein Zusatzobjekt gewisse Dinge zusaetlich regeln.
//
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moving.h>

#define PONY "d/wald/kassandra/bennie/mon/pony"

inherit "std/thing";

nosave object pl;

create()
{
	::create();
	SetProp( P_SHORT, 0 );
	SetProp( P_NAME, "Ponyhook" );
	SetProp( P_NODROP, "??" );
	if( IS_BLUE(ME) ) return;
	move_object(ME,PL);
	pl = PL;
}

id() { return 0; }

init()
{
	::init();
	add_action( "steigen", "steig", 1 );
	add_action( "reite", "reite" );
}

extra_look()
{
	return capitalize(pl->QueryPronoun(WER))+" sitzt auf einem Pony.\n";
}

steigen( str )
{
	string arg;

	if( pl!=PL ) return;
	if( !pl->QueryReiter() )
	{
		destruct(ME);
		return 0;
	}
  if( !str || ( 
    sscanf( str, "von %s", arg ) != 1 && sscanf( str, "vom %s", arg ) != 1 )
  )
  {
  	if( str != "ab" )
	    return 0;
	}
	else
	{
		str = arg;
		if( sscanf( str, "%s ab", arg ) == 1
			|| sscanf( str, "%s herunter", arg ) == 1
			|| sscanf( str, "%s runter", arg ) == 1 )
			str = arg;
		if( str != "pony" && str != "pferd" ) return 0;
  }
  clone_object(PONY)->move(environment(PL),M_SILENT|M_GO);
  say( capitalize(PL->name(WER))+" steigt vom Pony herunter.\n" );
  write( "Du steigst vom Pony herunter.\n" );
	pl->absteigen();
	destruct(ME);
	return 1;
}

reite(str)
{
	write( "Du reitest schon.\n" );
	return 1;
}
