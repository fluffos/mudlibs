#pragma strict_types

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


#define STEMPEL_BEST    "/obj/stempel_bestaetigung"
#define STEMPEL_BEST_ID "\nzweitibestaetigung"

object stempel;
string player;
int gender;

void create()
{
  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  SetProp (P_SHORT, "Ein Zettel");
  SetProp (P_NAME, "Zettel");
  SetProp (P_GENDER, MALE);
  AddId (({"zettel", "bestaetigung", STEMPEL_BEST_ID}));
  SetProp (P_WEIGHT, 10);
  SetProp (P_VALUE, 0);
  SetProp (P_NEVERDROP, 1);    // Wird beim Tod nicht in die Leiche gelegt
  SetProp (P_NOSELL, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_READ_MSG, "Ein leeres Zweiti-Antragsformular.\n");
  SetProp (P_MATERIAL, MAT_PAPER);

  AddCmd (({"unterzeichne","unterschreibe"}), "Sign");
  AddCmd (({"zerreiss","zerreisse"}), "Zerreiss");
}

int Sign(string str)
{
  int ret;
  notify_fail ("Was willst Du unterzeichnen?\n");
  if (!str || !id(str)) return 0;
  notify_fail ("Hoppla, irgendetwas lief da schief.\n");
  if (catch(ret=(int) stempel->StempelOk(capitalize(getuid(TP))))) return 0;
  if (!ret) return 0;
  write (BS("Du unterschreibst einen Zettel und schickst ihn an " + player +
    " zurueck, woraufhin " + (gender==FEMALE ? "sie" : "er") +
    " als Dein Zweiti markiert wird."));
  if (catch(stempel->remove())) return 0;
  remove();
  return 1;
}


int Zerreiss(string str)
{
  notify_fail ("Was willst Du zerreissen?\n");
  if (!str || !id(str)) return 0;
  notify_fail ("Hoppla, irgendetwas lief da schief.\n");
  if (catch(stempel->StempelCancel(TPN))) return 0;
  write ("Du zerreisst den Zettel, den Dir "+player+" geschickt hat.\n");
  remove();
  return 1;
}


void SetStempel(object ob, string p, int g)
{
  stempel = ob;
  player = p;
  gender = g;
  SetProp (P_LONG, "Ein kleiner Zettel. Er wurde Dir von "+player+
    " geschickt, um sich als Dein Zweiti markieren zu lassen. Du musst "
    "die Markierung aber erst mit Deiner Unterschrift bestaetigen. "
    "Du kannst ihn ausserdem lesen.");
  SetProp (P_READ_MSG, "Auf dem Zettel steht geschrieben:\n\n     "
    "Z w e i t s p i e l e r - M a r k i e r u n g s - A n t r a g\n\n"+
    BS("Ich, "+player+", moechte fortan als Dein Zweiti (offiziell: "
      "\"Zweitspieler"+(g==FEMALE ? "in" : "")+
      " von "+capitalize(getuid(MENV))+"\") markiert "
      "sein. Ich ersuche um Bestaetigung durch Unterschrift.")+
      "\n\nUnterschrift: ________ (syntax: unterzeichne bestaetigung)\n");
}
