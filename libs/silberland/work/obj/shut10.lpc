/*
 * Armageddon, der Weltenvernichter
 * Shutdown-Daemon -- die Messages muessen wohl nochmal ueberarbeitet werden
 *
 */

inherit "std/npc";

#include <properties.h>
#include <defines.h>
#include <language.h>
#include <moving.h>
#include "/secure/wizlevels.h"

string *messages= ({
   "Blitz und Donner hallen durch die Welt.",
   "Überall steigen Leuchtraketen hoch und erhellen den Himmel.",
   "Die Einwohner dieser Welt singen und tanzen Freudentaenze.",
   "Violette Wolken tuermen sich am Himmel auf ... und verschwinden wieder.",
   "Merlin laechelt und scheint seit Anbeginn der Zeiten nicht gealtert zu sein.",
   "Die Fluesse und Meere dieser Welt sprudeln froehlich vor sich hin.",
   "Du hoerst Musik und Singen aus allen Richtungen.",
   });

int restzeit;

int _query_restzeit()
{
  return restzeit+find_call_out("NextStep");
}

void create()
{
  ::create();
  AddId("Reichageddon");
  set_living_name("reichageddon");
  SetProp(P_SHORT, "Reichageddon, der Partydaemon");
  SetProp(P_NAME, "Reichageddon");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_XP, 0);
  SetProp(P_FORCE_MURDER_MSG, 1);
  SetProp(P_NOATTACK, "will nichts und niemanden vernichten.");
  if (!IS_ARCH(this_player()) && !IS_ARCH(this_interactive()))
    destruct(this_object());
}

varargs string text_time(int sec, int flag)
{
  string s;
  int tage, stunden, minuten, sekunden;
  
  sekunden=sec;
  tage=sekunden/86400;
  stunden=(sekunden%86400)/3600;
  minuten=(sekunden%3600)/60;
  sekunden=sec%60;
  s="";
  if (sec>=86400)
  {
    s+=tage+" Tag"+(tage==1 ? ", " : (flag ? "en, " : "e, "));
  }
  if (sec>=3600)
  {
    s+=stunden+" Stunde"+(stunden==1 ? ", " : "n, ");
  }
  if (sec>=60)
  {
    s+=minuten+" Minute"+(minuten==1 ? "" : "n");
  }
  s+=(sec/60?" und ":" ")+sekunden+" Sekunde"+(sekunden==1 ? "" : "n");
  return s;
}

string _query_long()
{
  return break_string("Dies ist Reichageddon, der Partydaemon. Als Du ihn ansiehst, blickt er auf und fluestert Dir zu: Noch "+text_time(_query_restzeit())+" muessen vergehen, dann ist diese Welt 10 Jahre alt.\n",80,0);
}

void shut(int minutes)
{
  int a,b,c;

  if (!IS_ARCH(this_interactive()))
    return;

  a=b=c=0;
  move("/gilden/abenteurer",M_GO);
  if (intp(minutes))
    c = minutes;
  
  else if (stringp(minutes))
  {
    if(sscanf(minutes,"%d:%d:%d",a,b,c)==3)
      c += b*60+a*24*60;
    else if(sscanf(minutes,"%d:%d",b,c)==2)
      c += b*60;
    else if(sscanf(minutes,"%d",c)==1)
      ;
  }

  while (remove_call_out("NextStep")>=0);
  restzeit=c*60;
  call_out("NextStep",0,restzeit);
}

void SHOUT(mixed str)
{
  int i;
  
  str = explode(break_string(str,60),"\n");
  for (i=0;i<sizeof(str);i++)
  {
    write("Reichageddon ruft: "+str[i]+"\n");
    shout("Reichageddon ruft: "+str[i]+"\n");
  }
}

nosave void NextStep(int seconds)
{
  int neu;

  if (seconds<=0)
  {
    SHOUT("ES IST SOWEIT!! JUBELT, TANZET, FREUET EUCH!!!");
    return;
  }
  if (seconds>2*86400) 
    neu=seconds-5*3600;
  else if (seconds>4800)
    neu=seconds-1800;
  else
    neu=seconds*3/4-10;
  restzeit=neu;
  call_out("NextStep",seconds-neu,neu);
  SHOUT("In "+text_time(seconds,1)+
      " wird diese Welt 10 Jahre alt!");
  if (neu<900 && find_call_out("ArmasShout")==-1)
    call_out("ArmasShout",random(99)+5);
}

void ArmasShout()
{
  string s;
  call_out("ArmasShout",36+random(36));
  write(s=messages[random(sizeof(messages))]+"\n");
  shout(s);
}

void catch_tell(string str)
{
  string who,what;
  object ob;
  
  if (sscanf(str, "%s teilt Dir mit: %s", who, what) != 2)
    return;
  if (!this_player()) return;
  if (strstr(what, "laden") != -1) {
    call_out("tell", 0, 
      "Das kann ich leider nicht machen!");
  }
  else if (sizeof(regexp(({what}), "wie *lange|zeit"))) {
    call_out("tell", 0, "In "+ text_time(_query_restzeit(),1)+
        " wird diese Welt 10 Jahre alt!");
  }
  return;
}

void tell(string text)
{
  tell_object(this_player(), 
      break_string( text, 78,"Reichageddon teilt Dir mit: "));
}

int remove()
{
  write("Reichageddon doesn't want to be removed!\n");
  return 0;
}

int do_damage(int dam, mixed enemy)
{
  return 0;
}
