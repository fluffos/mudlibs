/*
** Der Allzweck-Teddy
** ---
** 1996-04-11  1.0  Woody  Initial Release
** 1996-04-25  1.1  Woody  @@wer@@, @@wie@@ usw. statt %s
** 1997-04-01  1.2  Woody  Adverbparsing bei Quotes jetzt wie soul,
**                         match_living() zum Auffinden von Spielern,
**                         Magier koennen andere invis Mags 'aergern' :),
**                         Message() statt tell_object() (ignoriere geht),
**                         'ignoriere spieler.teddy'
** 1997-04-04  1.3  Woody  Adverbparsing Bugfix
** 1997-08-30  1.4  Woody  Bugfix: unbekanntes Adverb -> "" statt " "
**                         zudem nun knuddel/wuschel/kuschel/waschbar
** 1997-09-09  1.5  Woody  P_AUTOLOADOBJ wird in move() gesetzt,
**                         dann verdoppelt er sich auch nimmer bei renew
** 1997-09-14  1.6  Woody  jammert, wenn man ihn fallenlaesst, bzw. freut
**                         sich, wenn man ihn an sich nimmt. Und ab sofort
**                         ist er sogar renew-sicher :).
** 1997-12-07  1.8  Woody  'lehne' :)
** 1998-01-02  1.9  Woody  capitalize() beim rbefehl()
** 1998-11-11  1.10 Woody  Fuer Seher und Magier sind Verben nun gratis,
**                         Magier sehen untereinander nun (Name)
** 2000-06-13  1.11 Woody  "zuschwer" implementiert (fuer Testzwecke)
** 2000-11-14  1.12 Woody  nach /obj/ verschoben
** 2001-11-18  1.13 Woody  Beim rkitzeln "beherrschen aber doch lachen"...
** 2002-06-10  1.20 Woody  Funktionen typisiert, neue Verben:
**                         rbeneide, rhuepfe, rstupse, rgrummel, rknulle
** 2002-06-20  1.21 Woody  neu: rnicke, rstrahle, rstiere, rhirte, rlache
** 2003-03-17  1.22 Woody  rwuschel nun mit Haarfarbe
** 2003-07-18  1.23 Woody  rhopse
** 2003-07-21  1.24 Woody  rwuschel
** 2004-09-27  1.25 Woody  rkitzel typofixed
** 2005-03-08  1.26 Feyaria rlache typofixed
** 2005-03-18  1.27 Feyaria match_living zuerst auf spieler
** 2005-04-09  1.28 Woody  rkuesse, rfeuer
** 2005-04-19  1.29 Woody  rdruecke
**
** basierend auf:
**   Vrai's Freundschaftsband (Adverbparsing),
**   Mupfel's sprechender Stein (LP/MP Anzeige),
**   Diddl-Maus (Ideen fuer diverse r-Verben)
**
** Was r-Verben angeht: funktioniert im Grunde gleich wie die
** Diddl-Maus, erlaubt hierbei aber relativ komplexes Parsing bzw.
** Wortstellungen durch Makros.
**
** Ausserdem wird "in der Ferne" nicht ausgegeben, wenn sich Spieler
** und Zielperson im selben Raum befinden (in diesem Fall wird
** ausserdem zusaetzlich eine Raummeldung an alle anderen anwesenden
** Spieler ausgegeben).
**
** Zur Erweiterung der r* Befehle am besten vorher den Header zur
** Funktion rbefehl() durchlesen!! (ist die letzte Funktion, ganz
** unten)
**
** Ach ja, fast haett ichs vergessen: Anders als bei der Maus kann
** man mit diesem Teddy Adverben verwenden, genau wie bei allen
** Standardverben (rwuschel woody froe = Du verwuschelst Woodys
** Haare froehlich aus der Ferne.). Quoted Adverbs wieder per /
** hintendran, wie gewohnt.
**
** Weiters kann das Aufspueren von unsichtbaren Magiern mit diesem
** Teddy gegebenenfalls per #define INVIS_SPERRE verhindert werden.
**
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#define VERSION "1.29"

/*
** Wird folgende Zeile aktiviert, so koennen unsichtbare Magier
** mit dem Teddy nicht mehr aufgespuert werden, andernfalls
** heissts halt wieder "Jemand" etc.
*/
#define INVIS_SPERRE

#define INV_TEST(x,y,z) (IS_LEARNER(x) && IS_LEARNER(y) && \
                         z->QueryProp(P_INVIS))
#define WIZ_NAME(pl,genitiv) ("("+capitalize(getuid(pl))+ \
    (genitiv ? (strstr("xsz",getuid(pl)[<1..])!=-1?"'":"s"):"")+")")


varargs int rbefehl(string str, string *form, int sp, int nearonly);

nosave int lastHP, lastSP, aktiv=0;
nosave object owner;
nosave string owner_name;


create()
{
  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  SetProp(P_SHORT, "Ein kleiner suesser Teddy");
  SetProp(P_LONG,
    "Der kleine suesse Teddy ist knuddel- und wuschelecht. Er bietet Dir "
    "zeit seines Lebens seine mannigfaltigen Dienste an und zwinkert "
    "Dir dabei stets froehlich mit seinen kleinen Knopfaugen zu.\n"
    "An seinem linken Ohr bemerkst Du irgendetwas.");
  SetProp(P_NAME, "Teddy");
  SetProp(P_GENDER, MALE);
  AddId(({"teddy", "universal-teddy", "\nuniversalteddy"}));
  SetProp(P_WEIGHT, 100);
  SetProp (P_MATERIAL, ([MAT_CLOTH:30,MAT_FEATHER:70]));
  SetProp(P_NEVERDROP, 1);  // Teddy wird beim Tod nicht in die Leiche gelegt
  lastHP = lastSP = -1;
  SetProp(P_NOSELL,
      "Du wirst doch Deinen Teddy nicht verkaufen wollen, oder?\n");
  AddDetail ( ({"augen", "knopfaugen"}),
      "Die beiden kleinen schwarzen Knopfaugen blinzeln Dich froehlich an.\n");
  AddDetail ("ohr", "Ein kleiner Zettel haengt am linken Ohr des Teddys.\n");
  AddDetail ("zettel", "Du koenntest versuchen, ihn zu lesen.\n");
  AddReadDetail ("zettel",
    "Auf dem Zettel steht:\n"
    ",--------------------------------------------------------------------,\n"
    "| Dieser Teddy fluestert Dir jederzeit zu, wieviele Lebenspunkte und |\n"
    "| Magiepunkte du noch hast, wenn Du das willst.                      |\n"
    "|                                                                    |\n"
    "| Die Kommandos dazu lauten wie folgt:                               |\n"
    "| <report ein>   bringt den Teddy zum Reden,                         |\n"
    "| <report aus>   laesst ihn wieder verstummen :)                     |\n"
    "|                                                                    |\n"
    "| Ausserdem ermoeglicht Dir der Teddy einige zusaetzliche Kommandos, |\n"
    "| um mit Mitspieler aus der Ferne interagieren zu koennen.           |\n"
    "|                                                                    |\n"
    "| Die Befehle hierzu sind: rwuschel (1), rumarme (1), rkuschel (1),  |\n"
    "| rdanke (1), rbeneide (1), rhuepfe (1), rstupse (1), rtroeste (1),  |\n"
    "| rnicke (1), rstrahle (1), rstiere (1), rhirte (1), rlache (1),     |\n"
    "| rlaechel (1), rkraule (1), rschnurre (1), rkuesse (1), rfeuer (1), |\n"
    "| rdruecke (1), rgrummel (3), rtrete (5).                            |\n"
    "|                                                                    |\n"
    "| Die Zahlenwerte in Klammern geben die fuer Nichtseher jeweils      |\n"
    "| notwendigen Magiepunkte an.                                        |\n"
    "|                                                                    |\n"
    "| 100% LPC, haendisch waschen!                              Ver "+
    VERSION+" |\n"
    "`--------------------------------------------------------------------'\n"
    );

  AddCmd("report", "Report");

  // r* commands:
  // ------------
  AddCmd(({"rwuschel","rwuschle"}), "rwuschel");
  AddCmd(({"rumarm","rumarme"}), "rumarme");
  AddCmd(({"rdank","rdanke"}), "rdanke");
  AddCmd(({"rtroest","rtroeste"}), "rtroeste");
  AddCmd(({"rkitzel","rkitzle"}), "rkitzel");
  AddCmd(({"rtritt","rtret","rtrete"}), "rtrete");
  AddCmd(({"rkuschel","rkuschle"}), "rkuschel");
  AddCmd(({"rkraul","rkraule"}), "rkraule");
  AddCmd(({"rschnurr","rschnurre"}), "rschnurre");
  AddCmd(({"rkuess","rkuesse"}), "rkuesse");
  AddCmd(({"rbussi"}), "rbussi");
  AddCmd(({"rfeuer","rfeuere"}), "rfeuere");
  AddCmd(({"rdrueck","rdruecke"}), "rdruecke");
  AddCmd(({"lehn","lehne"}), "lehne");

  AddCmd(({"rbeneid","rbeneide"}), "rbeneide");
  AddCmd(({"rhuepf","rhuepfe"}), "rhuepfe");
  AddCmd(({"rhops","rhopse"}), "rhopse");
  AddCmd(({"rstups","rstupse"}), "rstupse");
  AddCmd(({"rgrummel","rgrummle"}), "rgrummel");
  AddCmd(({"rknull","rknulle"}), "rknulle");

  AddCmd(({"rnick","rnicke"}), "rnicke");
  AddCmd(({"rstrahl","rstrahle"}), "rstrahle");
  AddCmd(({"rstier","rstiere"}), "rstiere");
  AddCmd(({"rhirt","rhirte"}), "rhirte");
  AddCmd(({"rlach","rlache"}), "rlache");
  AddCmd(({"rlaechel","rlaechle"}), "rlaechle");
  AddCmd(({"rsuder","rsudere"}), "rsuder");

  AddCmd(({"knuddel", "knuddle"}), "knuddel");
  AddCmd(({"wuschel", "wuschle"}), "wuschel");
  AddCmd(({"kuschel", "kuschle"}), "kuschel");
  AddCmd(({"wasch", "wasche", "reinige"}), "wasche");
  AddCmd(({"zuschwer"}), "zuschwer");
}

int knuddel(string str)
{
  if (!str || !id(str)) return 0;
  write(BS("Du knuddelst Deinen Teddy von oben bis unten durch und fuehlst "
      "Dich warm und geborgen. Fuer einen Moment vergisst Du die Welt "
      "rund um Dich herum..."));
  say(BS(TP->Name()+" knuddelt "+TP->QueryPossPronoun(MALE,WEN)+" Teddy "
      "von oben bis unten durch und seufzt wohlig. Es scheint so als ob "+
      TP->QueryPronoun()+" fuer einen Moment die Welt um sich vergessen "
      "wuerde..."));
  return 1;
}

int wuschel(string str)
{
  if (!str || !id(str)) return 0;
  write(BS("Du wuschelst Deinem Teddy durchs flauschige Fell."));
  say(BS(TP->Name()+" wuschelt "+TP->QueryPossPronoun(MALE,WEM)+" Teddy "
      "durchs flauschige Fell."));
  return 1;
}

int kuschel(string str)
{
  if (!str || !id(str)) return 0;
  write(BS("Du kuschelst Dich in Deinen Teddy und verspuerst eine wohlige, "
      "innere, Dich sanft umfangen haltende Waerme. Du schliesst Deine "
      "Augen und gibst Dich ganz diesem Gefuehl der Geborgenheit hin."));
  say(BS(TP->Name()+" kuschelt sich ganz fest in "+
      TP->QueryPossPronoun(MALE,WEN)+
      " Teddy und schliesst die Augen. Es scheint Dir als wuerde "+
      TP->QueryPronoun()+" sich ganz diesem Gefuehl hingeben."));
  return 1;
}

int wasche(string str)
{
  object e;
  if (str && id(str) && TP && (e=environment(TP))) {
    if ( /* member(e->QueryProp(P_COMMANDS), "wasche") && */
        member(e->QueryProp(P_DETAILS), "wasser")) {
      write("Du waeschst Deinen Teddy in dem Wasser gruendlich rein.\n");
      say(TP->Name()+" waescht " + TP->QueryPossPronoun(MALE,WEN) +
          " Teddy gruendlich.\n");
      return 1;
    }
    else return notify_fail ("Das geht hier nicht!\n"), 0;
  }
  else
    return 0;
}

string extra_look()
{
  return capitalize(environment()->QueryPronoun())+
    " hat einen Teddy unter "+
    environment()->QueryPossPronoun(MALE,WEN) + " Arm geklemmt.\n";
}

NotifyHpChange()
{
  int    hp, mhp, sp, msp;

  // Sicherheits-Check
  if (!previous_object() || !owner || (owner != previous_object()))
    return;

  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv)
  {
    SetProp(P_NODROP, 0);
    if (owner!=find_netdead(getuid(owner)))
      owner->RemoveHpHook(ME);   // geht nur bei nicht-netztoten Spielern
    return;
  }

  // Test auf Geist
  if (owner->QueryProp(P_GHOST))
    return;

  // aktuelle Werte ermitteln
  hp = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);

  // Test auf Tod
  if ((hp<=0) || (!living(owner)))
  {
    tell_object(owner, "Dein Teddy blinzelt Dich noch einmal traurig an.\n");
    return;
  }

  // Vergleich und Ausgabe
  if ((hp < lastHP) || (hp != lastHP && sp == msp) || (sp != lastSP))
    tell_object(owner,
      // "Du hast jetzt "+hp+" Lebenspunkte und "+sp+" Magiepunkte.\n");
      "Du hast jetzt "+hp+" ("+mhp+") Lebenspunkte und "+
      sp+" ("+msp+") Magiepunkte.\n");

  // neue Werte merken
  lastHP = hp; lastSP = sp;
}

void activate(object ob)
{
  if (objectp(ob)) {
    aktiv = 1;
    owner = ob;
    owner_name = getuid(owner);
    SetProp(P_NODROP,
      "Wenn Dein Teddy mit Dir redet, kannst Du ihn nicht wegwerfen!\n");
    ob->AddHpHook(ME);
    lastHP = ob->QueryProp(P_HP);
    lastSP = ob->QueryProp(P_SP);
  } else {
    if (ob=(owner||TP)) ob->RemoveHpHook(ME);
    owner = owner_name = aktiv = 0;
    SetProp(P_NODROP, 0);
  }
}

Report(str)
{
  if (MENV != TP)
    return notify_fail("Dazu musst Du den Teddy erst einmal "+
      "an Dich nehmen!\n"), 0;
  notify_fail("Syntax: report ein|aus.\n");
  switch (str)
  {
    case "ein":
      if (aktiv && objectp(owner))
        write("Der Report-Modus ist schon eingeschaltet!\n");
      else {
        write("Report-Modus ist jetzt eingeschaltet.\n");
        activate(TP);
      }
      break;
    case "aus":
      if (!aktiv)
        write("Der Report-Modus ist doch schon ausgeschaltet!\n");
      else { 
        write("Report-Modus ist nun ausgeschaltet.\n");
        activate(0);
      }
      break;
    default:
      return 0;
  }
  return 1;
}

varargs int move(mixed dest, int method)
{
  int res;
  object e_prev,e;

  e_prev=MENV;
  res = ::move(dest,method);
  e=MENV;
  if (IS_LEARNER(e))
    SetProp(P_AUTOLOADOBJ, 1);        // fuer Magier autoload
  else
    SetProp(P_AUTOLOADOBJ, 0);
  if (e_prev && e)
    if (interactive(e_prev) && (ENV(e_prev) == e))
      tell_object(e_prev,
          "Der Teddy weint: Lass mich nicht allein, biiiiitteeeeee...\n");
    else if (interactive(e) && (ENV(e) == e_prev))
      tell_object(e,
          "Der Teddy schaut Dich gluecklich an, als Du ihn aufhebst.\n");
  call_out("checkowner", 1);
  return res;
}

void checkowner()
{
  if (aktiv && !objectp(owner) && stringp(owner_name)) {
    owner = find_player(owner_name);
    if (!objectp(owner)) activate(0);
    else activate(owner);
  }
}

int remove(int x)
{
  if (aktiv && TP) TP->RemoveHpHook(ME);
  return ::remove(x);
}

// ---------------------------------------------------------------------------

int rwuschel(string str)
{
  string haare, haare2, fullname;
  object wer;

  if ( stringp(fullname = match_living(str, 1)) &&
       (wer = find_player(fullname)) &&
       (haare = wer->QueryProp(P_HAIR_COLOR)) )
  {
    haare2 = haare + "en Haare";
    haare = haare + "e Haare";
  }
  else
    haare = haare2 = "Haare";

  return rbefehl (str,
    ({ "Wessen Haare willst Du aus der Ferne verwuscheln?\n",
       "Deine eigenen Haare? Aus der Ferne???\n",
       "Wie willst Du @@wessen@@ "+haare+" verwuscheln?\n",
       "%s verwuschelt@@wie@@ Deine "+haare2+"@@fern@@.\n",
       "Du verwuschelst@@wie@@ @@wessen@@ "+haare+"@@fern@@.\n",
       "%s verwuschelt@@wie@@ @@wessen@@ "+haare+".\n" }), 1);
}

