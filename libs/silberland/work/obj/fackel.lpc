/*
 * Standardfackel.
 * ---
 * 2000-10-18  Woody  P_FUEL von 2000 auf 1500 reduziert
 *
 */

inherit "/std/lightsource";

#include <properties.h>
#include <lightsource.h>
#include <language.h>

create()
{
  if(!is_clone(this_object()))
    return;

  ::create();
  AddId("fackel");
  SetProp(P_NAME,"Fackel");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Fackel");
  SetProp(P_LONG,
      "Eine ganz normale Fackel aus Holz.\n"
      "Man kann sie anzuenden und wieder loeschen.\n");
  SetProp(P_VALUE,5);
  SetProp(P_WEIGHT,1000);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,1500);
  SetProp(P_LIGHTDESC,
      ({ "glimmend","flackernd","leicht flackernd","brennend",
         "hell lodernd","frisch angezuendet" }) );
}

