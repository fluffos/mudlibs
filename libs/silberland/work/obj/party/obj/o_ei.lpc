inherit "std/thing";
#include <language.h>
#include <properties.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein angemaltes Osterei" );
  SetProp(P_GENDER, NEUTER );
  SetProp(P_NAME, "Osterei" );
  SetProp(P_LONG, 
    "Ein Osterei, das ganz bunt in allen Farben des Regenbogens bemalt ist.\n"
   +"Auf ihm steht: Alles Gute von Freund fuer Osterhasi.\n"
  );
  SetProp(P_WEIGHT, 3 );
  SetProp(P_VALUE, 0 );
  AddId( "ei" );
  AddId( "osterei" );
	AddCmd(({"esse","iss","schaele","schael"}),"essen");
}

essen( str )
{
  if( !id(str) ) return 0;
  write( "Du schaelst das Ei und isst es auf. Ein echter Genuss.\n" );
  say( this_player()->name(WER)+" isst ein Osterei auf.\n" );
  destruct( this_object() );
  return 1;
}


