inherit "std/thing";
#include <properties.h>
#include <language.h>

create ( )
{
  ::create ( );
  AddId   ( "nase");
  AddId   ( "pappnase");
  SetProp ( P_SHORT, "Eine Pappnase");
  SetProp ( P_LONG, "Eine Pappnase fuer Partymuffel.\n");
  SetProp ( P_NAME, "Pappnase" );
  SetProp ( P_GENDER, FEMALE);
  SetProp ( P_WEIGHT, 10);  
  SetProp ( P_VALUE, 0);
  }

