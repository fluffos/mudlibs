#include <properties.h>
#include <language.h>
inherit "/std/thing";

int offen;

create()
{
	::create();
	SetProp(P_SHORT,"Eine Flasche Flensburger Pilsener");
	offen=0;
	SetProp(P_LONG,
	"Eine @@aufzu@@ 0.33l Pfandflasche Pils direkt importiert aus Flensburg.\n");
	AddId("bier");
	AddId("flepi");
	AddId("flensburger");
	AddId("bierflasche");
	AddId("flasche");
	SetProp(P_NAME,"Flepi");
	SetProp(P_GENDER, NEUTER);
	SetProp(P_WEIGHT, 100);
	SetProp(P_VALUE, 1);
}

init()
{
	::init();
	add_action("oeffne","oeffne");
	add_action("schliesse","schliess",1);
	add_action("trinke","trink",1);
}

aufzu()
{
	if (offen)
		return "aufgeploppte";
	else
		return "geschlossen";
}

oeffne(str)
{
	if (!str || ( str!="flepi" && str!="bier" && str!="flasche" && str!="bierflasche")) 
		return 0;
        if (offen) {
                write("Die Flasche ist bereits offen!\n");
                return 1;
        }
        offen=1;
        write ("Du setzt Deinen Daumen an und ploppst die Buddel auf.\n");
        say(this_player()->name() + " ploppt ein Flepi auf.\n");
        return 1;
}
 
schliesse(str)
{
	if (!str || ( str!="bier" && str!="flepi" && str!="flasche" && str!="bierflasche")) 
		return 0;
        if (!offen) {
                write("Die Flasche ist doch zu!\n");
                return 1;
        }
        offen=0;
        write("Du klemmst den Buegelverschluss wieder auf die Flasche.\n");
        say(this_player()->name() + " macht das Flepi wieder zu.\n");
        return 1;
}
 
trinke(str)
{
	if (!str || ( str!="flepi" && str!="bier" && str!="flasche" && str!="bierflasche")) 
		return 0;
        if (!offen) {
                write("Die Flasche ist aber zu!\n");
                return 1;
        }
	write("Du setzt die Flasche an den Mund und trinkst das kuehle Nass in einem\n"+
	"Zug aus. Die Flasche verwandelt sich in einen GRUENEN PUNKT und verschwindet.\n");
        say(this_player()->name() + " trinkt ein Flepi.\n");
	this_object()->remove();
	return 1;
}
