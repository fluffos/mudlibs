// Ein Stueck Schokolade :)

inherit "std/thing";

#include <properties.h>
#include <language.h>

int ausgepackt;

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME,"Yoghurette");
  SetProp(P_SHORT,"Ein Riegel Yogurette (eingewickelt)");
  SetProp(P_LONG,"Hey, ein Stueck Yogurette(TM), sowas sollte man\n"
	  +"immer im Kuehlschrank haben...\n");

  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE,0);
  SetProp(P_GENDER, FEMALE);

  AddId(({"Schokolade","Stueck","schokolade",
	    "stueck","Yogurette","yogurette",
	    "riegel","Riegel"}));

  AddCmd("iss","essen");
  AddCmd(({"wickel","wickle","packe"}),"wickeln");
  ausgepackt = 0;
}

essen(string str)
{
  notify_fail("Was willst Du denn Essen? Schokolade?\n");
  if(!str || str=="" || !id(str)) return 0;
  
  if(!ausgepackt)
    {
      write("Vielleicht solltest Du das Stueck vorher auswickeln?\n");
      return 1;
    }
  write("Mjammm!! Schmeckt wirklich lecker... So leicht, nach\n"
	+"Yoghurt... und Erdbeer... scheint auch kaum Kalorien zu\n"
	+"haben. Das nennt man wirklich eine gesunde Schokolade ;)\n");
  say(this_player()->name()+" isst ein Stueck Schokolade. Es scheint\n"
      +this_player()->QueryPronoun(WEM)+" zu schmecken.\n");
  return remove();
}

wickeln(string str)
{
  notify_fail("Was willst Du auswickeln?\n");
  if(!str || str=="") return 0;
  str = lower_case(str);
  if((str!="schokolade aus")
     &&(str!="yogurette aus")
     &&(str!="riegel aus")) return 0;

  if(ausgepackt)
    {
      write("Aber die Schokolade ist doch schon ausgepackt!\n");
      return 1;
    }
  ausgepackt = 1;
  write("Du wickelst ein Stueck Schokolade aus.\n"
	+"Das Papierchen verwandelt sich in einen gruenen Punkt und\n"
	+"huepft froehlich von dannen.\n");
  say(this_player()->name()+" wickelt ein Stueck Schokolade aus.\n");
  SetProp(P_SHORT,"Ein Riegel Yogurette (ausgepackt)");
  return 1;
}
