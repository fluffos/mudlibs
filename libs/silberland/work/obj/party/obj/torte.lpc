inherit "std/thing" ;

#include <properties.h>
#include "../party.h"

#define FALSE 0
#define TRUE 1
#define NAME           (TP->QueryProp(P_NAME))
#define QNAME(ob)      (ob->name())

create()
{
  ::create() ;

  SetProp( P_SHORT, "Eine Sahnetorte" ) ;
  SetProp( P_LONG, "Diese Sahnetorte laedt gerade dazu ein, sie jemandem ins " +
	   "Gesicht zu werfen.\n" ) ;

  SetProp( P_WEIGHT, 10 ) ;
  SetProp( P_VALUE, 10 ) ;

  SetProp( P_NAME, "Sahnetorte" ) ;
  SetProp( P_GENDER, FEMALE ) ;
  AddId( ({ "torte", "sahnetorte" }) ) ;
}

init()
{
  ::init() ;
  add_action( "throw", "wirf" ) ;
  add_action( "throw", "werfe" ) ;
}

throw( string str )
{
  string what, who ;
  object obj ;

  if( !str )
    return FALSE ;

  if( sscanf( str, "%s %s", what, who ) != 2 )
    return FALSE ;

  if( !id( what ) )
    return FALSE ;

  if( !(obj = present( who, ENV( TP ) )))
    return FALSE ;

  write( "Du wirfst " + QNAME( obj ) + " die Torte ins Gesicht.\n" ) ;
  tell_object( obj, NAME + " wirft Dir eine grosse Sahnetorte ins Gesicht.\n" ) ;
  say( NAME + " wirft " + QNAME( obj ) + " eine grosse Sahnetorte ins Gesicht.\n", obj ) ;
  remove() ;
  return TRUE ;
}
