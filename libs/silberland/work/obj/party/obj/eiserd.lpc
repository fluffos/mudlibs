inherit "std/thing";
#include <language.h>
#include <properties.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Softeis mit Erdbeergeschmack" );
  SetProp(P_GENDER, 0);
  SetProp(P_NAME, "Softeis" );
  SetProp(P_LONG, 
    "Ein Softeis, das sehr lecker aussieht. Auf der Waffel liest Du:\n"
   +"Alles Gute von einem guten Freund.\n"
  );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE,0);
  AddId( "eis" );
  AddId( "softeis" );
  AddId( "erdbeersofteis");
  AddId( "erdbeereis");
}

init( str )
{
  add_action( "essen", "iss" );
  add_action( "essen", "esse");
  add_action( "essen", "ess");
}

essen( str )
{
  if( !id(str) ) return 0;
  write( "Diese Koestlichkeit schmeckt wie Mutters selbstgemachte Erdbeertorte.\n" );
  say( this_player()->name(WER)+" schleckt genuesslich an einem Softeis.\n" );
  destruct( this_object() );
  return 1;
}
