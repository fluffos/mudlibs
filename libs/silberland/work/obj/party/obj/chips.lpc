inherit "std/thing";
#include <language.h>
#include <properties.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Eine Tuete Chips");
SetProp(P_GENDER, FEMALE);
SetProp(P_NAME, "Tuete Chips" );
SetProp(P_LONG, "Eine Tuete Chips, aber von denen die hoellisch scharf sind.\n");
SetProp(P_WEIGHT, 25);
SetProp(P_VALUE,0);
AddId( "chips" );
}
init ( str)
{
 add_action( "essen", "iss" );
 add_action( "essen", "esse");
 add_action( "essen", "ess");
}

essen( str )
{
 if( !id(str) ) return 0;
 write( "Wow, sind die Dinger scharf. Ausserdem kruemeln sie stark.\n");
 say( this_player()->name(WER)+" knuspert an einer Tuete Chips rum.\n");
 destruct( this_object() );
 return 1;
}
