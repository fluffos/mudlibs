inherit "std/thing" ;

#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <language.h>

#define TP this_player()

create()
{
  if (!is_clone(this_object())) return;
	::create();
	SetProp(P_SHORT,"Ein Mon Cherie");
        SetProp(P_LONG,"Ein Mon Cherie. Wenn es so schmeckt, wie es aussieht, kannst Du\n"
	              +"Dich auf ein Geschmackserlebnis erster Guete einstellen.\n");
	SetProp(P_NAME,"Mon Cherie");
	SetProp(P_WEIGHT, 10);
	SetProp(P_VALUE, 5);
	SetProp(P_GENDER, NEUTER );
	AddId(({"mon cherie","mon","cherie","mon_cherie"}));
}

init()
{
	::init();
	add_action("essen","esse");
	add_action("essen","iss");
}

essen(str)
{
	notify_fail("Was moechtest Du essen?\n");
	if ( !str || !id(str) )
	    return 0;
	if (!eat_alcohol(2)) return 1;
	if (!TP->eat_food(2)) return 1;
	write("Du isst genuesslich " + name(WEN,0) + ". Es knackt herrlich, als Du\nhineinbeisst, und die Kirsche zergeht Dir auf der Zunge. Zusammen\nmit dem Alkohol gibt sie Dir das Gefuehl von Frische und Feuer.\n");
	say( PL->name(WER,2) + " isst genuesslich " + name(WEN,0) + ".\n");
//        TP->heal_self(1);
	remove();
	return 1;
}

int eat_alcohol(int strength)
{
  int alc;
   
  alc = TP->QueryProp(P_ALCOHOL)+strength;
  if (alc >= TP->QueryProp(P_MAX_ALCOHOL)) {
    tell_object(TP, "Du bist ja schon so blau, dass Du Deinen Mund nicht mehr findest.\n");
    return 0;
  }
  if(alc < 0) alc = 0;
  if(!alc) tell_object(TP, "Du bist stocknuechtern.\n");
  TP->SetProp(P_ALCOHOL, alc);
  return 1;
}
		
