#include <properties.h>
#include <language.h>
inherit "/std/thing";

int offen;

create()
{
	::create();
	offen=0;
	SetProp(P_SHORT,"Eine Flasche Cola");
	SetProp(P_LONG,"Eine @@aufzu@@ 0.33l Pfandflasche Cola.\n");
	AddId("cola");
	AddId("colaflasche");
	AddId("flasche");
	SetProp(P_NAME,"Cola");
	SetProp(P_GENDER, 2);
	SetProp(P_WEIGHT, 100);
	SetProp(P_VALUE, 1);
}

init()
{
	::init();
	add_action("oeffne","oeffne");
	add_action("schliesse","schliess",1);
	add_action("trinke","trink",1);
}

aufzu()
{
	if (offen) 
		return "offene";
	else 
		return "verschlossene";
}

oeffne(str)
{
	if (!str || ( str!="cola" && str!="flasche" && str!="colaflasche")) 
		return 0;
        if (offen) {
                write("Die Flasche ist bereits offen!\n");
                return 1;
        }
        offen=1;
        write ("Du nagst mit den Zaehnen solange an der Flasche, bis der Deckel abspringt.\n");
        say(this_player()->name() + " macht eine Cola auf.\n");
        return 1;
}
 
schliesse(str)
{
	if (!str || ( str!="cola" && str!="flasche" && str!="colaflasche")) 
		return 0;
        if (!offen) {
                write("Die Flasche ist doch zu!\n");
                return 1;
        }
        offen=0;
        write("Du klemmst den Deckel wieder auf die Flasche.\n");
        say(this_player()->name() + " macht die Cola wieder zu.\n");
        return 1;
}
 
trinke(str)
{
	if (!str || ( str!="cola" && str!="flasche" && str!="colaflasche")) 
		return 0;
        if (!offen) {
                write("Die Flasche ist aber zu!\n");
                return 1;
        }
	write("Du setzt die Flasche an den Mund und trinkst das kuehle Nass in einem\n"+
	"Zug aus. Die Flasche verwandelt sich in einen GRUENEN PUNKT und verschwindet.\n");
        say(this_player()->name() + " trinkt eine Cola.\n");
	this_object()->remove();
	return 1;
}
