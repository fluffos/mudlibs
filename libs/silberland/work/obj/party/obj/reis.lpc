inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
	::create();
	SetProp( P_NAME, "handvoll Reis" );
  	SetProp( P_SHORT, "Bunter Reis" );
  	SetProp( P_LONG,
		"Der Reis ist sehr bunt und nicht essbar,\n"
               +"denn er ist zum werfen da !\n");
	SetProp( P_WEIGHT, 50 );
	AddId( "reis" );
        SetProp( P_GENDER, FEMALE );
}

init()
{
  	::init();
        add_action("werfen","wirf");
        add_action("werfen","werfe");
        add_action("essen","iss");

}

essen( str )

{ 
 if ( id( str ) )
 {
    write( "Du sollst ihn werfen nicht essen !\n" );
    say( this_player()->name(WER,2)+" weiss nicht was er mit dem Reis machen soll...\n");
    
   return 1;
  }
  return 0; 
}


werfen( str )

{ 
 if ( id( str ) )
 {
    write( "Du wirfst den Reis hoch in die Luft.\n" );
    say( this_player()->name(WER,2)+" wirft eine handvoll bunten Reis durch die Luft.\n");
   
    move(environment(this_player()),M_PUT | M_SILENT);
    say("Bunter Reis prasselt auf Dich hernieder.\n");  
    write("Der Reis prasselt auf die Koepfen der Anwesenden nieder.\n");
return 1;
  }
  return 0; 
}
