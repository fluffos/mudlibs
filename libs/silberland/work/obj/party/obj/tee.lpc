
#include <properties.h>

#include "../party.h"
#include "../essenprop.h"

inherit PARTY("essen");

create() {
	::create();
	AddId("tee");
	AddId("tasse tee");
	AddId("tasse");
	SetProp(P_SHORT,"Eine Tasse Tee");
	SetProp(P_LONG,"Eine Tasse mit heissem, dampfendem Tee.\n");
	SetProp(P_NAME,"Tasse Tee");
	SetProp(P_GENDER,2);
	SetProp(P_VALUE,80);
	SetProp(P_WEIGHT,1);
	SetProp(P_IS_DRINK,1);
	SetProp(P_STRENGTH,1);
	SetProp(P_ALCO,0);
	SetProp(P_WATER,2);
	SetProp(P_EATER,"Du trinkst eine Tasse heissen Tee. Der schmeckt einfach wundervoll");
	SetProp(P_MESSAGE,"trinkt eine Tasse heissen Tee");
        SetProp(P_NO_CONTAINER,0);
	SetProp(P_EMPTY_CONTAINER,"Tasse");
	SetProp(P_EMPTY_LONG,"In der Tasse haengt noch der Duft des Tees. Du haettest gerne noch mehr gehabt.\n");
	SetProp(P_EMPTY_GENDER,2);
	SetProp(P_EMPTY_ID,"tasse");
}
