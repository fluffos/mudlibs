inherit "std/thing";

#include <properties.h>

#include "../party.h"


create()   {
	::create();
  SetProp(P_NAME,"Rote Pause");
  AddId("pause");
  AddId("rote pause");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,0);
  SetProp(P_VALUE,0);
  SetProp(P_SHORT,"Eine Rote Pause");
  SetProp(P_LONG,
"Dies ist eine original Rote Pause. Auf der Vorderseite ist eine sehr\n"+
"beruehmte rote Kuh zu sehen.\n");
  AddCmd(({"ess","esse","iss"}),"esse");
	}

esse(str)   {
  if (!str)
    return 0;
  if (!id(str))
    return 0;
  write(
"Du isst Deine Rote Pause. Hmmm ... die Alpenmilch schmeckt wirklich gut.\n");
  say(
TPN+" isst seine Rote Pause.\n");
  remove();
  return 1;

}
