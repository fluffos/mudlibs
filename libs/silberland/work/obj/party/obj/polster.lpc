// Kissen aus dem MG - überarbeitet von Dusty und Stahldorn - August 2002

inherit "std/thing";
#include <properties.h>
#include <language.h>

string str;
string cstr;  
string cstr_kurz;  

init()
{
  ::init();
  call_out("farben",0);
}

void farben()
{
  int colour;
  colour = random(30);
  if (colour==0) cstr = "schneeweisser";
  if (colour==1) cstr = "gastgruener";
  if (colour==2) cstr = "schwarz-rosa-goldener";
  if (colour==3) cstr = "grasgruener";
  if (colour==4) cstr = "schwarz-weiss-karierter";
  if (colour==5) cstr = "orange-pink-gestreifter";
  if (colour==6) cstr = "lila-gruen-getuepfelter";
  if (colour==7) cstr = "olivengruener";
  if (colour==8) cstr = "regenbogenschillernder";
  if (colour==9) cstr = "grauer";
  if (colour==10) cstr = "silbergrauer";  
  if (colour==11) cstr = "weinroter";
  if (colour==12) cstr = "rosenroter";
  if (colour==13) cstr = "lagunenblauer";
  if (colour==14) cstr = "schimmelgruener";
  if (colour==15) cstr = "perlfarbener";
  if (colour==16) cstr = "erdbeerschleckerroter";
  if (colour==17) cstr = "dustyblauer";  
  if (colour==18) cstr = "angroxgelber";
  if (colour==19) cstr = "woodygruener";
  if (colour==20) cstr = "nutellabrauner";
  if (colour==21) cstr = "grasgruener";
  if (colour==22) cstr = "hirtengruener";
  if (colour==23) cstr = "elefantengrauer";
  if (colour==24) cstr = "kamelgelber";
  if (colour==25) cstr = "froschgruener";
  if (colour==26) cstr = "dustyveilchenvioletter";
  if (colour==27) cstr = "hanfbluetenroter";  
  if (colour==28) cstr = "bierschaumweisser";
  if (colour==29) cstr = "gerstenbiergelber";
  cstr_kurz=cstr[0..(strlen(cstr)-3)];
}

short()
{
  return "Ein " + cstr + " Polster.\n";
}


long()
{
  return "Dies ist ein weicher, " + cstr + " Polster.\n"+
          "Du kannst versuchen, ihn zu werfen.\n";
}


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  farben();
  AddId("polster");
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);
  SetProp(P_NAME, "Polster");
	SetProp(P_SHORT,"Ein Polster");
	SetProp(P_GENDER, MALE);
	AddAdjective( ({ cstr_kurz+"er",cstr_kurz+"en",cstr_kurz+"en",cstr_kurz+"en"}) );
  AddCmd("wirf","throw_it"); 
  AddCmd("ww", "ww");
  
}

ww(str)
{
  if (str)
    return throw_it("polster nach "+str);
  else
  {
    object *all, *liv;
    int i;

    all=all_inventory(environment(this_player()));
    for (i=0; i<sizeof(all); i++)
      if (query_once_interactive(all[i]))
        if (!liv)
	  liv = ({all[i]});
        else
          liv = liv+({all[i]});
    i = random(sizeof(liv));
    return throw_it("kissen nach "+lower_case(liv[i]->query_real_name()));
  }
}

throw_it(str)
{
  int treffer;
  string victim_name,werfer_name;
  string victim_string,werfer_string;
  string was,at,wen;
  int fehler;
  object victim;

  if (!str) return 0;
  fehler = 0;
  if (sscanf(str,"%s %s %s",was,at,wen) != 3)
    fehler = 1;
  if (!id(was) || at != "nach")
    fehler = 1;
  if (fehler)
  { notify_fail("Zum Werfen: Wirf Polster nach <spielername>\n");
    return 0;
  }
  victim = find_living(wen);
  if (!victim || !present(victim,environment(this_player())))
    { write("Dieser Spieler ist nicht hier!\n");                                
      return 1;                                                                 
    }                                                                           
  victim_name = capitalize(victim->query_real_name());
  werfer_name = capitalize(this_player()->query_real_name());
  treffer = random(5);
  write(break_string("Du schmeisst einen "+cstr_kurz+"en Polster nach " + 
                     victim_name +".",78));
  say(break_string(werfer_name + " wirft einen "+cstr_kurz+"en Polster nach " 
                   + victim_name + ".",78),
       ({victim,this_player()}));
  tell_object(victim,break_string(werfer_name + " wirft einen "+cstr_kurz +
                                  "en Polster nach Dir!",78));
  if (treffer==0)
  {
    werfer_string = "Du verfehlst " + victim_name + " meilenweit.\n";
    victim_string = werfer_name + " verfehlt Dich meilenweit.\n";
    this_object()->move(environment(this_player()));
  }
  if (treffer==1)
  {
    werfer_string = "Der Polster streift " + victim_name + " am Ohrlaeppchen.\n";
    victim_string = "Der Polster streift Dich am Ohrlaeppchen.\n";
  }
  if (treffer==2)
  {
    werfer_string = "PAFF! Du triffst " + victim_name + " mitten ins Gesicht.\n";
    victim_string = "PAFF! Der Polster trifft Dich mitten im Gesicht!\n";
  }
  if (treffer==3)
  {
    werfer_string = "WUSCH! Der Polster trifft " + victim_name + "'s Bauch mit voller Wucht.\n";
    victim_string = "WUSCH! Der Polster fliegt mit voller Wucht gegen Deinen Bauch.\n";
  }
  if (treffer==4)
  {
    werfer_string = victim_name + " versucht wegzurennen, doch der Polster trifft den Hinterkopf.\n";
    victim_string = "Du versuchst wegzurennen, aber der Polster trifft Dich am Hinterkopf.\n";
  }
  write(werfer_string);
  tell_object(victim,victim_string);
  if (treffer) this_object()->move(victim);
  return 1;
}

