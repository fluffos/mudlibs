
// 11.1.97  woody  bugfix (bewerfe ohne argumente)

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>

#include "../party.h"

create()
{
  ::create();
  SetProp( P_SHORT, "Ein Super-Dickmann" );
  SetProp( P_LONG, "Das ist ein ganz besonders dicker Dickmann.\n" );
  AddId( ({ "dickmann", "super dickmann", "negerkuss" }) );
  SetProp( P_NAME, "Dickmann" );
  SetProp( P_GENDER, MALE );
  //SetProp( P_NODROP, "Ihh, eine eklige Idee.\n" );
  seteuid(getuid(this_object()));
	AddCmd(({"wirf","werfe"}),"wurf");
	AddCmd("bewerfe","bewurf");
	AddCmd(({"iss","esse"}),"essen");
}

essen( str )
{
  if( !str || !id(str) ) return 0;
  say( PL->name(WER) +
         " ruft mit verstopftem Mund: BOAH, SIND DIE DICK, MANN!\n"
  );
  write( "Du rufst voller Begeisterung: BOAH, SIND DIE DICK, MANN!\n" );
  destruct( this_object() );
  return 1;
}

wurf( str )
{
  string was, wohin;
  if (!str) return 0;
  if( sscanf( str, "%s an %s", was, wohin )==2 ) return matsch( was, wohin );
  if( sscanf( str, "%s zu %s", was, wohin )==2 ) return matsch( was, wohin );
  return 0;
}

bewurf( str )
{
  string was, wohin;
  if (!str) return 0;
  if( sscanf( str, "%s mit %s", wohin, was )==2 ) return matsch( was, wohin );
  return 0;
}

matsch( was, wohin )
{
  object target, look;

  if( !id(was) ) return 0;
  if( !(target = present(wohin,environment(PL))) || !living(target) )
  {
    write( "Es gibt hier niemanden, der "+capitalize(wohin)+" heisst.\n" );
    return 1;
  }
  write( "Peng, Du wirfst "+target->name(WEM,1)
		+" den Dickmann ins Gesicht.\n" );
  say( PL->name()+" wirft "+target->name(WEM,1)
    +" einen Dickmann ins Gesicht.\n", target );
  tell_object( target, PL->name()+
               " wirft Dir einen Dickmann ins Gesicht.\n" );
  look = clone_object( OBJ("dick_look") );
  look->SetProp(P_AMOUNT, 1 );
  look->move( target, M_MOVE_ALL );
  destruct( this_object() );
  return 1;
}
