/*
 * Ein Joint fuer Parties :)
 *
 * MG contributed,
 * SL adapted and bugfixed by Woody
 *
 */


#include <properties.h>

inherit "std/thing";

int rauchen, dauer;
object player;

void create()
{
  ::create();
  AddId("joint");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Joint");
  SetProp(P_SHORT, "Joint");
  SetProp(P_LONG,
      "Dies ist ein echt guter Joint. Vielleicht solltest du ihn rauchen.\n");
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE,  0);
  rauchen = 0;
  dauer = 5;
}

void init()
{
  ::init();
  if (environment() == this_player())
  {
    add_action("rauche","rauch");
    add_action("rauche","rauche");
  }
}

int rauche(string arg)
{
  int gift;
  int gift1;

  if (!arg || !id(arg))
    return 0;

  if (rauchen) {
    write("Aber Du rauchst doch schon einen.\n");
    return 1;
  }

  rauchen = 1;
  player = this_player();
  SetProp( P_NODROP,
    "Du kannst den Joint nicht wegwerfen, solange Du ihn noch rauchst!\n" );
  SetProp( P_NEVERDROP, 1 );

  write(
    "Du setzt Dich hin und rauchst den Joint. Das ist wirklich guter Stoff.\n"
    "Du fuehlst Dich etwas benommen.\n");
  say(player->Name()+" setzt sich hin und raucht einen Joint.\n");
  this_player()->drink_alcohol(10);
  gift = random(30);
  if(gift==17)
  {
    player->AddPoison(1);
    write(
      "WAAAAH, WAS WAR DAS !?\n"
      "Dieser Joint scheint ja pures Gift zu sein!\n");
  } 
  call_out("rauch", 6);
  return 1;
}

void rauch()
{
  if(dauer > 0)
  {
    write(
      "Der Rauch des Joints huellt Dich in dicke Rauchwolken ein.\n"
      "Du fuehlst Dich wie im siebten Himmel.\n");
    say(player->Name() + " wird von dicken Rauchwolken aus " +
        player->QueryPossPronoun(MALE,WEM) + " Joint eingehuellt.\n");
    dauer = dauer - 1;
    call_out("rauch",10);
    return;
  }
  write(
    "Nun hast Du den Joint aufgeraucht. Die Qualmwolken um Dich loesen sich\n"
    "langsam auf. Allmaehlich kommst Du auf den Boden der Tatsachen wieder "
    "zurueck.\n");
  say(player->Name() +
      " hat den Joint aufgeraucht und wird langsam wieder normal.\n");
  rauchen = 0;
  remove();
  return;
}
