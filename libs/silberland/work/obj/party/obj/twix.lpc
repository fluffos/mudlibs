#include <properties.h>
#include <language.h>
#include <defines.h>
inherit "std/thing";

create()
{
	::create();
	SetProp( P_GENDER, MALE );
	SetProp( P_NAME, "Twix" );
	SetProp( P_SHORT, "Ein Twix" );
	AddId( "twix" );
	SetProp( P_LONG, "Vor langer Zeit nannte man ihn noch Raider.\n" );
	SetProp( P_WEIGHT, 500 );
	SetProp( P_VALUE, 0 );
	AddCmd( ({"iss","esse"}), "essen" );
}

essen( str )
{
	if( !str || !id(str) ) return;
	write( "Hmmm, lecker.\n" );
	say( CAP(PL->name(WER)) + " schiebt sich einen Raider ins Gesicht.\n" );
	return remove();
}
