
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>

#include "../party.h"

inherit "/std/thing";

create() {
  ::create();
  SetProp(P_SHORT,"Ein Ueberraschungsei");
  if (sizeof(explode(file_name(this_object()),"#"))==1) return;
  SetProp(P_LONG,
		  "Ein Ueberraschungsei mit der Extraportion Milch.\n"+
		  "Was steckt wohl da drin?\n");
  AddId("ei");
  AddId("ueberraschungsei");
  SetProp(P_NAME, "Ueberraschungsei");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 800);
  SetProp(P_WEIGHT,200);

  AddCmd(({"iss","ess","esse"}),"essen");
  seteuid(getuid(this_object()));
}

essen (str) {
  string *obs;
  object ob;
  int num,sz;

  if (!str) return 0;
  if (!id(str)) return 0;
  if (!TP) return 0;

  if (!TP->eat_food(10)) return 1;
  TP->heal_self(15);

  obs=({
	"/obj/fackel",
	"/obj/schaufel",
	OBJ("cola"),
	OBJ("flepi"),
	OBJ("dickmann"),
	OBJ("joint"),
	OBJ("pappnase"),
	"/d/ebene/obj/waffe/taschenmesser",
	"/d/ebene/obj/waffe/azange",
	"/d/ebene/obj/waffe/eckzaehne",
	"/d/ebene/obj/ruestung/lederstiefel",
	"/d/ebene/obj/ruestung/lederruestung",
	"/d/ebene/obj/ruestung/loech_umhang",
	"/d/ebene/obj/div/beere",
	"/d/ebene/obj/div/karotte",
	"/d/ebene/obj/div/teerfackel",
	"/d/ebene/obj/div/kleeblatt",
        "/d/ebene/lamuerte/wwald/obj/windelhose",
        "/d/ebene/lamuerte/wwald/obj/fellhose",
	"/d/gebirge/dusty/zwerge/obj/brot",
	"/d/gebirge/dusty/zwerge/obj/kakao",
	"/d/gebirge/dusty/zwerge/obj/kipferl",
	"/d/gebirge/dusty/zwerge/obj/semmel",
	"/d/gebirge/angrox/obj/lederschuerze",
	"/d/gebirge/angrox/obj/lederstiefel",
        "/d/ebene/Midas/npc/fraggle",
        "/d/ebene/Silberwald/npc/otter"
  });
  if (IS_SEER(TP))
	obs+=({
	  "/obj/misc/lichtkugel",
	  "/obj/misc/wuerfel"
	  "/players/woody/obj/t-shirt"
	  });
  if (IS_WIZARD(TP))
	obs+=({
	  "/obj/tools/sonnenbrille"
	});

  sz=sizeof(obs);
  num=random(sz+5);
  ob=(num<sz)?clone_object(obs[num]):0;
  if (ob) {
	// LOG("ei",capitalize(TPN)+" findet "+ob->name(WEN,0)+".");
	if (living(ob)) {
	  if (environment(TP)) {
		write("Du isst ein Ueberraschungsei und findest "+
			  ob->name(WEN)+".\n");
		ob->move(environment(TP),M_GO);
		ob->Kill(TP);
	  } else {
		write("Du isst ein Ueberraschungsei, aber findest nichts.\n");
		ob->remove();
	  }
	} else {
	  ob->move(ME);
	  write("Du isst ein Ueberraschungsei und findest "+
			ob->name(WEN)+".\n");
	  if (environment(TP)) ob->move(environment(TP));
	  ob->move(TP);
	}
  } else {
	// LOG("ei",capitalize(TPN)+" findet nichts.");
	write("Du isst ein Ueberraschungsei, aber findest nichts.\n");
  }
  say(TPN+" isst ein Ueberraschungsei.\n");

  remove();
  return 1;
}
