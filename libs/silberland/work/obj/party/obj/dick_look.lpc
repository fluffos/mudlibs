
// 11.1.97  woody  typo,P_NAME,P_GENDER,P_NODROP

inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetCoinsPerUnits( 0,1 );
  SetGramsPerUnits( 0,1 );
  AddId( "schmier" );
  AddSingularId( "rest" );
  AddPluralId( "reste" );
  AddSingularId( "negerkuss" );
  AddPluralId( "negerkuesse" );
  AddSingularId( "dickmann" );
  AddPluralId( "dickmaenner" );
  SetProp (P_NAME, "Negerkuss-Geschmiere");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_NODROP,
    "So geht das nicht, aber versuch mal, die Reste aufzuessen...\n");
}

short(){}
long(){}

init()
{
  ::init();
  add_action( "essen", "iss" );
}

essen( str )
{
  if( !id(str) ) return 0;
  if( QueryProp(P_AMOUNT)>1 )
  {
    write( "Du isst etwas von dem Negerkuss-Geschmiere auf Deinem Kopf.\n" );
    say( this_player()->name(WER)+" isst etwas von dem Dreck in "+
         this_player()->QueryPossPronoun( NEUTER, WEM )+" Gesicht.\n" );
    AddAmount( -1 );
    return 1;
  }
  else
  {
    write( "Du isst den letzten Rest von dem Schmier auf Deinem Kopf.\n" );
    say( this_player()->name(WER)+" befreit "+
         this_player()->QueryPossPronoun( NEUTER, WEN )+
         " Gesicht von den Negerkussresten.\n" 
    );
    destruct( this_object() );
    return 1;
  }
}

extra_look()
{
	return capitalize(environment()->QueryPronoun()) + " hat "
	+	(( QueryProp(P_AMOUNT)==1 )
			? "einen Dickmann"
			: QueryProp(P_AMOUNT) + " Dickmaenner"
		)
	+	" im Gesicht kleben.\n";
}
