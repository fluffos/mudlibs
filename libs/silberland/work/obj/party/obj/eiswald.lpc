inherit "std/thing";
#include <language.h>
#include <properties.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Softeis mit Waldmeistergeschmack" );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Softeis" );
  SetProp(P_LONG, 
    "Ein Softeis, das sehr lecker aussieht. Auf der Waffel liest Du:\n"
   +"Alles Gute von einem guten Freund.\n"
  );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE,0);
  AddId( "eis" );
  AddId( "softeis" );
  AddId( "waldmeistersofteis");
  AddId( "waldmeistereis");
}

init( str )
{
  add_action( "essen", "iss" );
  add_action( "essen", "esse");
  add_action( "essen", "ess");
}

essen( str )
{
  if( !id(str) ) return 0;
  write( "Wundervoll gruen, wie eine saftige gesunde Waldwiese, so gut schmeckt\n"+
	       "dieses fantastische Waldmeistereis. Du fuehlst Dich schon, wie ein\n"+
				 "echter Waldmagier.\n");
  say( this_player()->name(WER)+" goennt sich ein Waldmeistersofteis.\n" );
  destruct( this_object() );
  return 1;
}
