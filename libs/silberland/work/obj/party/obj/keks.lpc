
#include <properties.h>

#include "../party.h"
#include "../essenprop.h"

inherit PARTY("essen");

create() {
  if (!is_clone(this_object())) return;
  ::create();
  AddId("keks");
  SetProp(P_NAME,"Keks");
  SetProp(P_SHORT,"Ein koestlicher Keks");
  SetProp(P_LONG,
      "Ein absolut leckerer, knuspriger Keks, goldbraun gebacken. Er "
      "enthaelt kleine Schokofloeckchen und ist ungefaehr "
      "handtellergross.");
  SetProp(P_GENDER,1);
  SetProp(P_VALUE,2);
  SetProp(P_IS_FOOD,1);
  SetProp(P_WEIGHT,1);
  SetProp(P_STRENGTH,1);
  SetProp(P_FOOD_SIZE,1);
  SetProp(P_EATER,
      "Du isst den Keks. Er schmeckt nach feinster Gebirgsschokolade");
  SetProp(P_MESSAGE,
      "isst einen koestlichen Schokokeks");
  SetProp(P_NO_CONTAINER,0);
  SetProp(P_EMPTY_CONTAINER,"Kekskruemel");
  SetProp(P_EMPTY_ID,"kruemel");
  SetProp(P_EMPTY_LONG,
    "Der Kruemel erinnert dich an den koestlichen Geschmack von Keksen.\n"
  );
  SetProp(P_EMPTY_GENDER,1);
  AddCmd( ({"iss","knabber","knabbere"}), "iss");
  }

iss(arg)
{
 if (arg == "keks")
   {
   SetProp(P_NODROP,"Die Kruemel haengen an Dir!\n");
   SetProp(P_NEVERDROP,1);
   return 0;
   }
}

reset()
{
  if( !id("kruemel") ) return;
  write("Ein Paar Kekskruemel verkruemmeln sich.\n");
  if(!remove()) destruct(this_object());
}

