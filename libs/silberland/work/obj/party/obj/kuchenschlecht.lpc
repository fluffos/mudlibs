
#include <properties.h>

#include "../party.h"
#include "../essenprop.h"

inherit PARTY("essen");

create() {
	::create();
	AddId("kuchen");
	AddId("stueck kuchen");
	AddId("stueck");
	SetProp(P_NAME,"Stueck Kuchen");
	SetProp(P_SHORT,"Ein Stueck Kuchen");
	SetProp(P_LONG,"Ein Stueck von Antheas wunderbarem Kuchen.\n");
	SetProp(P_GENDER,0);
	SetProp(P_VALUE,80);
	SetProp(P_IS_FOOD,1);
	SetProp(P_WEIGHT,1);
	SetProp(P_STRENGTH,1);
	SetProp(P_FOOD_SIZE,1);
	SetProp(P_EATER,"Du isst das Stueck Kuchen. Es schmeckt wirklich wunderbar");
	SetProp(P_MESSAGE,"isst ein Stueck von Antheas Kuchen");
	SetProp(P_NO_CONTAINER,1);
	SetProp(P_BAD,1);
	SetProp(P_BAD_MESSAGE,"Das Kuchenstueck war wohl schon schlecht. Dir dreht sich der Magen um");
}
