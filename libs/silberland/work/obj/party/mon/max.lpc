inherit "/std/npc";

#include <properties.h>
#include <language.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  create_default_npc(12);
  SetProp(P_SHORT, "Rettungsschwimmer in Badehose");
  SetProp(P_LONG, 
  "Ein gut gebauter, freundlicher Lebensretter in schwarzer Badehose.\n");
  SetProp(P_NAME, "Max");
  SetProp(P_ARTICLE,0);
  SetProp(P_SIZE, 184);
  SetProp(P_GENDER, MALE);
  AddId(({"max","junge","boy","retter","lebensretter","rettungsschwimmer",
          "schwimmer","mann"}));
  SetProp(P_ALIGN, 500);
  SetProp(P_RACE, "human");
  set_living_name("max");
}

