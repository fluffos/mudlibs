inherit "/std/npc";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Maedchen im Bikini");
  SetProp(P_LONG, "Ein toll aussehendes, sehr freundliches, Maedchen im Bikini.\n");
  SetProp(P_NAME, "Susanne");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, FEMALE);
  AddId("susanne");
  AddId("maedchen");
  set_living_name ("susanne");
}

Attack(object enemy)
{
  tell_room(environment(this_object()), 
            name()+" sagt: Keine Chance "+enemy->name()+"!\n");
  enemy->StopHuntFor(this_object(), 1);
  this_object()->StopHuntFor(enemy, 1);
  return 0;
}
