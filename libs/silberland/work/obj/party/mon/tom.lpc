/* Tom.c - Stripper, by Rufus, 22.6.95 */                            

#include <properties.h>
#include <language.h>
inherit "std/npc";
inherit "std/player/moneyhandler";

int show,tomgeld,stripzaehler;
mixed raum;

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();               
  SetProp(P_SHORT, "Tom, der Stripper");
  SetProp(P_LONG, 
  "Vor Dir steht Tom, ein Stripper mit einem nahezu gemeisselten Koerper.\n"
 +"Der suedlaendisch aussehende Adonis hat einen tollen, V-foermigen\n"
 +"Oberkoerper mit breiten Schultern und muskuloesen Armen. Sein Po\n"
 +"ist knackig, sein strahlendes Laecheln und seine braunen Augen haben\n"
 +"sicherlich schon viele Maenner und Frauen verrueckt gemacht.\n");
  SetProp(P_NAME, "Tom");
  AddId("tom");
  AddId("stripper");
  set_living_name ("Tom");
  create_default_npc(10);
  seteuid(getuid(this_object()));
  SetProp(P_BODY, 55);
  SetProp(P_MSGIN, "schlendert laessig herein");
  SetProp(P_MSGOUT, "schlendert laessig davon");
  SetProp(P_GENDER, MALE );
  SetProp(P_RACE, "Mensch");
  SetProp(P_XP, 10000);
  SetProp(P_ARTICLE,0);
  SetProp(P_HANDS, ({ " mit seinen kraftvollen Haenden", 55 }) );
  SetProp(P_DIE_MSG, " baeumt sich heldenhaft auf und stirbt. Sein letzter Akt.\n");
  SetProp(P_DEFAULT_INFO,"fluestert: 'Rede nicht, tu was...' Er laechelt Dich an.\n");

  AddInfo(( {"reizwaesche","kleidung","kleidern","waesche","unterwaesche"}),
  "zeigt das obere Stueck von seinem Slip.\n");

  AddInfo(( {"sex"} ) , "deutet mit seinen Blicken Interesse an.\n");

  AddInfo(( {"vibrator"}),"sagt: Den brauchst Du mit mir nicht...\n");
 
  AddInfo(( {"kondom","kondome","condom","condome"}),
  "zieht eines aus der Tasche. Er ist einsatzbereit!\n");

  AddInfo(( {"rufus","Rufus"}), "schreit: 'Rufus! Was fuer ein Mann!'\n");

  AddInfo(( {"strippen","strip","stripp","striptease","ausziehen"}),
  "grinst breit und sagt:\n"
  +"  'Ich zeige gern meinen Koerper, einer Person oder vielen.'\n"
  +"Tom schaut mit einem Laecheln in die Runde. Dann meint er:\n"
  +"'Wenn ihr wollt, dass ich mir diese Klamotten vom Leib reisse, dann\n"
  +"gebt mir was dafuer...' Er zwinkert Dir zu, Du wirst schwach.\n");

  AddCmd( ({"beruehre","beruehr","streichle","streichel","knuddel","knuddel","kuesse"
  ,"kuess","knutsch","umarm","umarme","liebe","lieb","wuschel","wuschle"}),
  "beruehr");

  AddCmd( ({"zwinker","zwinkere","laechle","laechel","grinse","grins","starre","starr"}),"augen");

  AddCmd( ({"tritt","tret","trete","stosse","stoss"}), "treten");

  SetChats(3,({
    "Tom laesst seine weissen Zaehne strahlen.\n",
    "Tom streichelt sich ueber die Brust.\n",
    "Tom trinkt ein Bier.\n",
    "Tom schaut Dir tief in die Augen...\n",
    "Tom knuddelt Dich.\n",
    "Tom schaut wem nach.\n",
    "Tom raucht eine Zigarette.\n",
    "Tom faehrt sich ueber das unrasierte Kinn.\n",
    "Tom lacht laut auf.\n"
    }));

  SetAttackChats(50,({
    "  Tom schreit: 'Ich mach dich fertig!'\n",
    "  Tom teilt eine schallende Ohrfeige aus.\n",
    "  Tom schnaubt wie ein wilder Stier.\n",
    "  Tom wird zum Berserker.\n"}));

  show=0; stripzaehler=0;
}

give_notify(obj)
{
  int x;

  raum=environment(this_object());
  x=sizeof(filter_array(all_inventory(raum),#'interactive));

  if (show!=1)
    {
    tomgeld=this_object()->QueryMoney();
    if (tomgeld<(x*100))
      {
      write("Tom sagt: 'Hmmm, "+obj->name(WEN, 1)+", nicht schlecht.'\n");
      write("Er fluestert: 'Aber ich krieg von jedem 100 Muenzen... Fehlen uns\n"
      +"also noch "+(string)(x*100-tomgeld)+" Muenzen fuer die Show...'\n");
      say("Tom nimmt etwas von "+capitalize(this_player()->name(WEM))+" und fluestert"
      +" vertraulich...\n",this_player());
      return (1);
      }
    else
      {
      say("Tom ruft: 'Okay, ihr Schnuckels, die Show beginnt!!!'\n");
      show=1;
      SetChats(40,({"@@strip@@"}));
      return(1);
      }
    }
    else
    {
    write("Tom fluestert dir zu: 'Die Show ist doch schon bezahlt, Herzchen.'\n"
    +"Tom kuesst dich leidenschaftlich, nimmt deine Gabe aber gern...\n");
    return(1);
    }
}

beruehr(str)
{
    notify_fail("Wem willst Du deine Zaertlichkeit zukommen lassen?\n");
    if (!id(str)) return 0;
 
    /* Es ist fuer Tom, also... */

    write("Tom kommt auf Dich zu und fluestert: 'Hallo, mein Traum...'\n"
    +"Er kuesst dich, Du vergisst alles um dich herum.\n");
    say(capitalize(this_player()->name(WER))+" naehert sich Tom"
    +" zaertlich, der sofort darauf eingeht und "+capitalize(this_player()->name(WEN))+" kuesst.\n"
    +"Die beiden fluestern miteinander.\n",this_player());
    return(1);
}

treten(str)
{
    notify_fail("Wen willst Du niedermachen?\n");
    if (!id(str)) return 0;
 
    /* Es ist fuer Tom, also... */

    write("Tom tritt dich uncharmant zurueck. 'Spinner!'\n");
    say(capitalize(this_player()->name(WER))+" wird von Tom getreten.\n",this_player());
    return(1);
}

augen(str)
{
    notify_fail("Mit wem willst Du flirten?\n");
    if (!id(str)) return 0;

    write("Tom wird auf Dich aufmerksam und schenkt Dir ein besonders\n"
    +"aufregendes Laecheln... Dir wird heiss und kalt!\n");
    say("Tom flirtet offensichtlich mit "+capitalize(this_player()->name(WEM))+".\n",this_player()); 
}

strip()
{
  int x;
  string st1;

  stripzaehler++;

  switch(stripzaehler)
    {
    case 1:
      say("Das Licht wird daemmrig... Du hoerst Musik... ");
      x=random(100)+1;
      st1="";
      if (x>=0 && x<=20) st1="'Welcome to the pleasure dome'";
      if (x>21 && x<=40) st1="'Nights in white satin'";
      if (x>41 && x<=60) st1="'Muscles'";
      if (x>61 && x<=80) st1="'It's raining men'";
      if (x>81 && x<=100) st1="'Shower gel rhapsody'";
      say(st1+"\n");
      return ""; break;
    case 2:
      say("Ein Spot faellt auf Tom.\n");
      return ""; break;
    case 3:
      say("Tom entfernt seine Manschettenknoepfe...\n");
      return ""; break;
    case 4:
      say("... dann reisst er sein Hemd in Fetzen... !\n");
      return ""; break;
    case 5:
      say("Tom oeffnet seinen Guertel... zieht ihn aus den Schlaufen...\n");
      return ""; break;
    case 6:
      say("... zieht ihn durch seine Beine...\n");
      return ""; break;
    case 7:
//      clone_object("/players/rufus/obj/guertel")->move(environment(this_object()));
      say("Tom wirft seinen Guertel in die Menge!\n");
      return ""; break;
    case 8:
      say("... jetzt oeffnet er die Knoepfe seiner weissen Hose...\n");
      return ""; break;
    case 9:
      say("... und schiebt die Hose hinab... er traegt einen knappen,\n"
      +"weissen Slip, der deine Phantasie ankurbelt...\n");
      return ""; break;
    case 10:
      tomgeld=this_object()->QueryMoney();
      say("Als er elegant aus der Hose steigen will, faellt er vornueber.\n"
      +"Mit einem Krachen landet er auf dem Boden. Zwei Sanitaeter bringen\n"
      +"eine Trage herein und schleppen den Prachtkerl mit dem verstauchten\n"
      +"Knoechel hinaus. Weg ist er!\n");
      this_object()->AddMoney(-tomgeld);
      this_object()->remove();
      return ""; break;
    default:
      return ""; break;
      }
}
