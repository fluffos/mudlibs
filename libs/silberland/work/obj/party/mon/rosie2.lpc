/* Rosie.c - Stripperin, by Rufus, 22.6.95 */                            

#include <properties.h>
#include <language.h>
inherit "std/npc";
inherit "std/player/moneyhandler";

int show,rosiegeld,stripzaehler;
mixed raum;

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();               
  SetProp(P_SHORT, "Rosie, die Stripperin");
  SetProp(P_LONG, 
  "Du siehst vor Dir die verfuehrerische Rosie, eine Stripperin allererster\n"
 +"Guete. Sie hat einen atemberaubenden Koerper, unglaublich schoene \n"
 +"schwarze Augen und ein Laecheln, dass Dir einfach die Luft wegbleibt.\n"
 +"Ihre Alabasterhaut reizt dich, sie einfach zu beruehren...\n");
  SetProp(P_NAME, "Rosie");
  AddId("rosie");
  AddId("stripperin");
  set_living_name ("rosie");
  create_default_npc(10);
  seteuid(getuid(this_object()));
  SetProp(P_BODY, 55);
  SetProp(P_MSGIN, "springt aus einer Torte und praesentiert sich");
  SetProp(P_MSGOUT, "bewegt sich aufreizend von dannen");
  SetProp(P_GENDER, FEMALE );
  SetProp(P_RACE, "Mensch");
  SetProp(P_XP, 10000);
  SetProp(P_ARTICLE,0);
  SetProp(P_HANDS, ({ " mit ihrer Reizwaesche", 55 }) );
  SetProp(P_DIE_MSG, " zuckt noch einmal und stirbt. Ihr letzter Vorhang.\n");
  SetProp(P_KILL_MSG, 1);
  SetProp(P_DEFAULT_INFO,"haucht: 'Warum redest Du nur...?' Sie zwinkert Dir zu.\n");

  AddInfo(( {"reizwaesche","kleidung","kleidern","waesche","unterwaesche"}),
  "fluestert: 'Was meinst Du, was ich anhabe... einen Kartoffelsack?'\n");

  AddInfo(( {"sex"} ) , "gurrt: 'Willst Du welchen?'\n");

  AddInfo(( {"vibrator"}),"gurrt: 'Summm... summm... summm...'\n");
 
  AddInfo(( {"kondom","kondome","condom","condome","gummi","gummis"}),
  "fluestert: 'Die kleinen Dinger zum Aufblasen?'\n");

  AddInfo(( {"rufus","Rufus"}), "schreit: 'Rufus! Was fuer ein Mann!'\n");

  AddInfo(( {"oberweite","busen","brust","bruesten"}),  /* Spieler versuchten das! */
  "sagt: 'Ja, ich hab welche... Reichen die?'\n");

  AddInfo(( {"strippen","strip","stripp","striptease","ausziehen"}),
  "hebt ihre Arme und ruft:\n"
  +"  'Ich bin dazu geboren, mich auf Parties auszuziehen!'\n"
  +"Rosie laechelt verfuehrerisch in die Runde. Dann sagt sie:\n"
  +"'Wenn ihr kleinen Maniacs wollt, dass ich das tue, gebt mir ein bisschen\n"
  +"was dafuer...' Sie scheint Dir, und nur Dir, zuzuzwinkern.\n");

  AddCmd( ({"beruehre","beruehr","streichle","streichel","knuddel","knuddel","kuesse"
  ,"kuess","knutsch","umarm","umarme","liebe","lieb","wuschel","wuschle","kuschel"}),
  "beruehr");

  AddCmd( ({"tritt","tret","trete","stosse","stoss"}), "treten");

  AddCmd( ({"zwinker","zwinkere","laechle","laechel","grinse","grins","starre","starr"}),"augen");

  SetChats(3,({
    "Rosie nippt lasziv an einem Drink.\n",
    "Rosie rueckt einen Traeger zurecht.\n",
    "Rosie pudert sich die Nase.\n",
    "Rosie schaut Dir tief in die Augen...\n",
    "Rosie legt die Beine aufregend uebereinander.\n",
    "Rosie prueft den Sitz ihrer Struempfe.\n",
    "Rosie raucht eine Zigarette - natuerlich verfuehrerisch.\n",
    "Rosie zieht sich die Lippen nach.\n",
    "Rosie schiebt ihren Buestier in die richtige Position.\n"
    }));

  SetAttackChats(50,({
    "  Rosie schreit: 'Du Miststueck!'\n",
    "  Rosie greift mit den spitzen Fingernaegeln an.\n",
    "  Rosie tritt mit den Poemps kraeftig zu.\n",
    "  Rosie wirbelt wuetend ihre Handtasche.\n"}));

  show=0; stripzaehler=0;
}

give_notify(obj)
{
  int x;

  raum=environment(this_object());
  x=sizeof(filter_array(all_inventory(raum),#'interactive));

  if (show!=1)
    {
    rosiegeld=this_object()->QueryMoney();
    if (rosiegeld<(x*100))
      {
      write("Rosie sagt: 'Hmmm, "+obj->name(WEN, 1)+", nicht schlecht.'\n");
      write("Sie haucht: 'Aber ich krieg von jedem 100 Muenzen... Fehlen uns\n"
      +"also noch "+(string)(x*100-rosiegeld)+" Muenzen fuer die Show...'\n");
      say("Rosie nimmt etwas von "+capitalize(this_player()->name(WEM))+" und fluestert"
      +" vertraulich...\n",this_player());
      return (1);
      }
    else
      {
      say("Rosie ruft: 'Okay, ihr Schnuckels, die Show beginnt!!!'\n");
      show=1;
      SetChats(40,({"@@strip@@"}));
      return(1);
      }
    }
    else
    {
    write("Rosie fluestert dir zu: 'Die Show ist doch schon bezahlt, Herzchen.'\n"
    +"Rosie knuddelt dich durch, nimmt deine Gabe aber gern...\n");
    return(1);
    }
}

beruehr(str)
{
    notify_fail("Wem willst Du deine Zaertlichkeit zukommen lassen?\n");
    if (!id(str)) return 0;
 
    /* Es ist fuer Rosie, also... */

    write("Rosie entwindet sich Dir charmant und fluestert: 'Hey, nur anschauen...'\n"
    +"Sie zwinkert Dir zu.\n");
    say(capitalize(this_player()->name(WER))+" naehert sich Rosie"
    +" zaertlich, doch sie entwindet sich elegant\n"+"und fluestert "
    +capitalize(this_player()->name(WEM))+" etwas zu.\n",this_player());
    return(1);
}

treten(str)
{
    notify_fail("Wen willst Du niedermachen?\n");
    if (!id(str)) return 0;
 
    /* Es ist fuer Rosie, also... */

    write("Rosie tritt dich undamenhaft zurueck. 'Spinner!'\n");
    say(capitalize(this_player()->name(WER))+" wird von Rosie getreten.\n",this_player());
    return(1);
}

augen(str)
{
    notify_fail("Mit wem willst Du flirten?\n");
    if (!id(str)) return 0;

    write("Rosie wird auf Dich aufmerksam und schenkt Dir ein besonders\n"
    +"aufregendes Laecheln...\n");
    say("Rosie flirtet offensichtlich mit "+capitalize(this_player()->name(WEM))+".\n",this_player()); 
}

strip()
{
  int x;
  string st1;

  stripzaehler++;

  switch(stripzaehler)
    {
    case 1:
      say("Das Licht wird daemmrig... Du hoerst Musik... ");
      x=random(100)+1;
      st1="";
      if (x>=0 && x<=20) st1="'You can leave your hat on'";
      if (x>21 && x<=40) st1="'Unchain my heart'";
      if (x>41 && x<=60) st1="'Turn me loose'";
      if (x>61 && x<=80) st1="'I'm holding out for a hero'";
      if (x>81 && x<=100) st1="'Don't want no short **** man'";
      say(st1+"\n");
      return ""; break;
    case 2:
      say("Ein Spot faellt auf Rosie.\n");
      return ""; break;
    case 3:
      say("Rosie laechelt charmant...\n");
      return ""; break;
    case 4:
      say("... dann beginnt sie, sich auszuziehen... !\n");
      return ""; break;
    case 5:
      say("Rosie zieht ein Strumpfband aus...\n");
      return ""; break;
    case 6:
      //clone_object("/players/rufus/obj/strumpfb")->move(environment(this_object()));
      say("... und wirft es in die Menge...\n");
      return ""; break;
    case 7:
      say("Rosie schwingt sanft die Hueften...\n");
      return ""; break;
    case 8:
      say("... sie wird ploetzlich unsicher...\n");
      return ""; break;
    case 9:
      say("Rosie hat scheinbar ihren Vater im Publikum entdeckt!\n");
      return ""; break;
    case 10:
      rosiegeld=this_object()->QueryMoney();
      say("Rosie zieht sich wieder an, laechelt und verschwindet in ihrer Torte.\n"
      +"Weg ist sie!\n");
      this_object()->AddMoney(-rosiegeld);
      this_object()->remove();
      return ""; break;
    default:
      return ""; break;
      }
}
