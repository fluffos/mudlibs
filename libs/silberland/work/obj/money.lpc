inherit "std/unit";

#pragma strong_types

#include <properties.h>
#include <language.h>
#include <defines.h>

#ifdef LOG_MONEY_TRANSFERS
nosave void _set_amount(int am)
{
  object rcpt;

  if ((am > 5000) && this_interactive())
  {
    rcpt = environment();
    while (rcpt && !living(rcpt))
      rcpt = environment(rcpt);

    if (rcpt != this_interactive())
    {
      log_file("irregular/MONEY",
          sprintf("[%s] %O(%O) %O %d -> %O (%O)\n",
            ctime()[4..], this_interactive(), environment(this_interactive()),
            query_verb() +
              (this_player() ? " " + this_player()->_unparsed_args() : ""),
            am, environment(),
            environment() ? environment(environment()) : 0));
    }
  }
  ::_set_amount(am);
}
#endif

void _set_autoloadobj( mixed args )
{
  if (pointerp(args))
    args=args[0];
  if (stringp(args))
    sscanf(args,"%d",args);
  if (!intp(args))
    args=0;
  SetProp(P_AMOUNT,args);
}

int _query_autoloadobj()
{
  return (int) Query(P_AMOUNT);
}

void create()
{
  mixed plist, i;

  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_NAME,({"Muenze","Muenzen"}));
  SetProp(P_SHORT,"Geld");
  SetProp(P_MATERIAL, ([ MAT_GOLD:100 ]) );
  AddSingularId("muenze");
  AddPluralId("muenzen");
  AddSingularId("goldstueck");
  AddPluralId("goldstuecke");
  AddId( ({ "geld","\ngeld" }) );
  SetProp(P_GENDER,FEMALE);
  SetCoinsPerUnits(1,1);
  SetGramsPerUnits(1,4);
  AddCmd( ({ "wirf", "werf", "werfe" }), "wurf");
}

int IsEqual(object ob)
{
  if (BLUE_NAME(ob)=="/obj/boerse") return 1;
  return ::IsEqual(ob);
}

nosave int wurf(string str)
{
  int num, part;
  string res;

  if (!id(str))
    return 0;

  num = Query(P_REQUESTED_AMOUNT);
  if (num == 1) {
    if (random(1000000) == 123456)
      res="Die Muenze bleibt auf dem Rand stehen.\n";
    else if (random(100) < 50)
      res="Kopf.\n";
    else
      res="Zahl.\n";
  }
  else {
    part = 5*num + random(num+1) - random(num+1) // etwas Gauss-verteilen
		 + random(num+1) - random(num+1)
		 + random(num+1) - random(num+1)
		 + random(num+1) - random(num+1)
		 + random(num+1) - random(num+1);
    part = (part+5)/10;

    if (part)
      res=part+"x Kopf"+(part!=num ? " und "+(num-part)+"x Zahl.\n" : ".\n");
    else
      res=num+"x Zahl.\n";
  }
  write(res);
  return 1;
}

