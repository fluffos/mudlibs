
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Cuprit");
  SetProp(P_LONG,  
    "Der Curpit erinnert Dich stark an Kupfererz, weil er die gleiche "
    "rote Farbe hat. Allerdings glaenzt dieser Edelstein viel mehr, er "
    "hat eine richtigehend umwerfende Ausstrahlung. "
    "Da seine leuchtende, rubinrote Farbe mit einem "
    "metallischen Glanz kombiniert ist, liegt seine Lichtbrechung sogar "
    "weit ueber dem Diamanten. Durch seine geringe Haerte ist er aber nur "
    "selten geschliffen.");
  SetProp(P_INFO, break_string( 
    "Dieser Cuprit ist nicht geschliffen!",78) );
 
  SetProp(P_NAME, ({"Cuprit", "Cuprite"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"cuprit", "edelstein"}) );
  AddPluralId( ({"cuprite", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetGramsPerUnits(4,1);
  SetCoinsPerUnits(150,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "rot");
}
