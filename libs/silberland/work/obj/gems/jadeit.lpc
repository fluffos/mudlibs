
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Jadeit");
  SetProp(P_LONG,  
    "Jade, korrekt benannt eigentlich \"Jadeit\". Er wird als "
    "Cabochon, Kugeln und fuer Figuren und Gravuren verwendet. Jadeit "
    "hat eine wunderschoene gruene Farbe, was ihn zu einem geschaetzten "
    "und wertvollen Schmuckstein macht. Angeblich soll es auch eine "
    "rosafarbene Jade geben, die sogenannte \"Lavendel-Jade\".");
  SetProp(P_INFO, break_string( 
    "Jadeit soll angeblich Ausgleich schaffen: Aktivitaet bei Traegheit, "
    "Ruhe bei Gereiztheit. Auch Anregung zur Ideenfuelle, Tatendrang und "
    "Entschlussfreudigkeit werden ihm nachgesagt.",78) );
  SetProp(P_NAME, ({"Jadeit", "Jadeite"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"jadeit", "edelstein"}) );
  AddPluralId( ({"jadeite", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(270,1);
  SetGramsPerUnits(6,1);

  SetProp(P_MATERIAL, MAT_JADE );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gruen");
}
