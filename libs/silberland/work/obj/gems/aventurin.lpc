
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Aventurin");
  SetProp(P_LONG,  
    "Der Aventurin ist ein Chalcedon aus der Gruppe der Quarze. "
    "Er hat eine roetlichbraune Farbe.");
  SetProp(P_INFO, break_string( 
    "Seine beruhigende Ausstrahlung bewirkt angeblich Geduld und "
    "Ausdauer.",78) );
  SetProp(P_NAME, ({"Aventurin", "Aventurine"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"aventurin", "edelstein"}) );
  AddPluralId( ({"aventurine", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(90,1);
  SetGramsPerUnits(4,1);

  SetProp(P_MATERIAL, MAT_QUARTZ );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "braun");
}
