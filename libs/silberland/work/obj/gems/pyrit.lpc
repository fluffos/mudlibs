
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

 SetProp(P_SHORT, "Ein Pyrit");
  SetProp(P_LONG,  
    "Pyrit ist ein messinggelbes oder goldgelbes Eisen- bzw. Schwefelkies, "
    "im silberlaendischen Volksmund auch \"Katzengold\" genannt.");
  SetProp(P_INFO, break_string( 
    "Der Pyrit soll Aengste loesen, den Astralkoerper kraeftigen, bei "
    "Frustrationen und sogar bei Depressionen helfen.",78) );
  SetProp(P_NAME, ({"Pyrit", "Pyrite"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"pyrit", "edelstein"}) );
  AddPluralId( ({"pyrite", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(50,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, ([ MAT_IRON:50, MAT_SULFUR:50 ])  );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gelb");
}

