
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Tuerkis");
  SetProp(P_LONG,  
    "Tuerkis tritt in dunkel- "
    "bis himmelblauen und blaugruenen Faerbungen auf. Am wertvollsten "
    "ist eben die typische tuerkisblaue Faerbung. Auch sog. Matrix, d.h. "
    "dunklere bis schwarze Aederung wird sehr geschaetzt. Tuerkis mangelt "
    "es eigentlich an der noetigen Haerte, aber aufgrund der besonderen "
    "Farbe ist er trotzdem ein beliebter Edelstein.");
  SetProp(P_INFO, break_string( 
    "Tuerkis ist ein Schutzstein gegen Schadenszauber und wird oft als "
    "Amulett fuer Kraft, Gesundheit und Lebensfreude getragen. "
    "Tuerkis soll angeblich seinen Traeger durch Farbveraenderungen vor "
    "drohender Gefahr warnen.",78) );
  SetProp(P_NAME, ({"Tuerkis", "Tuerkise"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"tuerkis", "edelstein"}) );
  AddPluralId( ({"tuerkise", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(50,1);
  SetGramsPerUnits(4,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "blau");
}
