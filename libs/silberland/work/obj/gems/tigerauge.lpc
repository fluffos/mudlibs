
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Tigerauge");
  SetProp(P_LONG,  
    "Das Tigerauge ist ein goldbrauner Edelstein mit einer seltsamen "
    "Maserung, die an ein Auge erinnert.");
  SetProp(P_INFO, break_string( 
    "Das Tigerauge beseitigt angeblich alle emotionellen Blockaden.",78) );
  SetProp(P_NAME, ({"Tigerauge", "Tigeraugen"}) );
  SetProp(P_GENDER, NEUTER);

  AddSingularId( ({"tigerauge", "edelstein"}) );
  AddPluralId( ({"tigeraugen", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(130,1);
  SetGramsPerUnits(3,1);

  SetProp(P_MATERIAL, MAT_QUARTZ );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "braun");  
}
