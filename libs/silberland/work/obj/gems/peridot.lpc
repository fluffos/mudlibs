// Diamant  

inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Peridot");
  SetProp(P_LONG,  
    "Der Peridot ist ein wunderschoener, olivgruener Edelstein. Auch wenn "
    "nur eine mittlere Haerte besitzt wird er gerne wegen seiner schoenen "
    "Farbe fuer Schmuckstuecke verwendet.");
  SetProp(P_INFO, break_string( 
    "Peridote sind bekannt fuer die geheimnisvollen Kraefte, die sich mit "
    "ihnen beherrschen lassen. Auch als Abwehr gegen Flueche kann man sie "
    "verwenden.",78) );
  SetProp(P_NAME, ({"Peridot", "Peridote"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"peridot", "edelstein"}) );
  AddPluralId( ({"peridote", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(200,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gruen");
}
