// Onyx 

inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Onyx");
  SetProp(P_LONG,  
    "Der Onyx ist ein Edelstein von schwarzer Farbe.");
  SetProp(P_INFO, 
    "Manche Leute haben furchbare Angst vor diesem schrecklichen, schwarzen "
    "Edelstein.\n");
  SetProp(P_NAME, ({"Onyx", "Onyxe"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"onyx", "edelstein"}) );
  AddPluralId( ({"onyxe", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(150,1);
  SetGramsPerUnits(5,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "schwarz");
}
