
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Benitoit");
  SetProp(P_LONG,  
   "Zuerst glaubst Du ja, dass das ein Saphir ist, aber nach einiger Zeit "
   "merkst Du aufgrund der geringeren Haerte, dass es eben keiner ist, schade. "
   "Neben der geringeren Haerte ist der Benitoit aufgrund fedriger "
   "Einschluesse stets etwas trueb, und daher nicht so ganz fuers Schleifen "
   "geeignet. Scheinbar werden nur sehr wenige Exemplare dieser Edelsteine "
   "gefunden.");
  SetProp(P_INFO, break_string( 
    "Benitoite werden nur in den tiefsten Stollen der Zwerge gewonnen.",78) );
  SetProp(P_NAME, ({"Benitoit", "Benitoite"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"benitoit", "edelstein"}) );
  AddPluralId( ({"benitoite", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(150,1);
  SetGramsPerUnits(1,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "blau");
}
