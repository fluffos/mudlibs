
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Rosenquarz");
  SetProp(P_LONG,  
    "Der Rosenquarz ist ein rosaroter Stein aus der Klasse der "
    "Oxide. Seine rosa Farbe erhaelt er durch feinste Einschluesse "
    "von Rutilnaedelchen oder durch Mangan.");
  SetProp(P_INFO, break_string( 
    "Der Rosenquarz drueckt Sensibilitaet, Zaertlichkeit und "
    "Aesthetik aus, deshalb ist er vorzueglich geeignet fuer alle "
    "Herzensangelegenheiten wie Liebeskummer, mangelnde Liebe usw...",78) );
  SetProp(P_NAME, ({"Rosenquarz", "Rosenquarze"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"rosenquarz", "edelstein"}) );
  AddPluralId( ({"rosenquarze", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(220,1);
  SetGramsPerUnits(6,1);

  SetProp(P_MATERIAL, MAT_QUARTZ );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "rosa");
}
