
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Sugilith");
  SetProp(P_LONG,  
    "Aus Sugilith ist ein violetter Edelstein.");
  SetProp(P_INFO, break_string( 
    "Die Esoteriker haben ihn zum Heilstein unserer Zeitperiode erklaert "
    "und sagen ihm positive Eigenschaften bei der Reinigung des Blutes "
    "und ueberhaupt zum Wohlbefinden nach.",78) );
  SetProp(P_NAME, ({"Sugilith", "Sugilithe"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"sugilith", "edelstein"}) );
  AddPluralId( ({"sugilithe", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(200,1);
  SetGramsPerUnits(5,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "violett");
}
