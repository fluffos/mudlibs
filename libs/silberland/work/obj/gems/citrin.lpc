
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Citrin");
  SetProp(P_LONG,  
    "Der Name des Citrins - ein Mitglied der Quarzgruppe - leitet sich "
    "von der Farbe der Zitrone ab. Citrine gibt es natuerlich in einem "
    "eher hellen Gelb.");
  SetProp(P_INFO, break_string( 
    "Dieser Citrin wurde gebrannt.",78) );
  SetProp(P_NAME, ({"Citrin", "Citrine"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"citrin", "edelstein"}) );
  AddPluralId( ({"citrine", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(230,1);
  SetGramsPerUnits(4,1);

  SetProp(P_MATERIAL, MAT_QUARTZ );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gelb");
}
