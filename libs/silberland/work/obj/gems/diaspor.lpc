
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Diaspor");
  SetProp(P_LONG,  
    "Grosse und schoene Kristalle des Diaspor sind sehr selten, landen "
    "ungeschliffen in Sammlungen und daher gibt es kaum geschliffene "
    "Exemplare. Eigentlich tritt das Mineral in winzigen Kristallen "
    "sehr haeufig in Bauxitminen auf.");
  SetProp(P_INFO, break_string( 
    "Die einzigen Bauxitminen des SilberLandes sind schon lange komplett "
    "abgebaut, so dass der Diaspor ein sehr seltener Edelstein ist.",78) );
  SetProp(P_NAME, ({"Diaspor", "Diaspore"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"diaspor", "edelstein"}) );
  AddPluralId( ({"diaspore", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(120,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");
}
