
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Achat");
  SetProp(P_LONG,  
    "Die Achate sind die gebaenderten Vertreter der Quarzgruppe. Seine "
    "sehr reizvollen Farben und Strukturen verdankt der Achat seinen "
    "verschiedenen Lagen von Chalcedon, wobei sich faerbbare (poroese) "
    "und nicht faerbbare (dichte) Schichten konzentrisch abwechseln. "
    "Dieser Achat hat eine beruhigende braune Farbe.");
  SetProp(P_INFO, break_string( 
    "Achate werden neben Ketten und Siegelsteinen haeufig zu "
    "Aschenbechern, Petschaft, Zierkorken, Schalen u.a.m. verarbeitet..",78) );
  SetProp(P_NAME, ({"Achat", "Achate"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"achat", "edelstein"}) );
  AddPluralId( ({"achate", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(100,1);
  SetGramsPerUnits(3,1);

  SetProp(P_MATERIAL, MAT_QUARTZ );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "braun");
}
