
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Almandin");
  SetProp(P_LONG,  
    "Der Almandin gehoert zu den schoensten Vertretern der roten Granate. "
    "Typisch ist bei seinem Rot ein immer vorhandener, mehr oder minder "
    "ausgepraegter Violettstich. Bei diesem Almandin ist der Violettstich "
    "so ausgepraegt, dass es eigentlich ein violetter und kein roter "
    "Edelstein ist.");
  SetProp(P_INFO, break_string( 
    "Ein Granat minderer Qualitaet, aber dafuer umso schoener!",78) );
  SetProp(P_NAME, ({"Almandin", "Almandine"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"almandin", "edelstein"}) );
  AddPluralId( ({"almandine", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(140,1);
  SetGramsPerUnits(4,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "violett");
}
