
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Jaspis");
  SetProp(P_LONG,  
    "Jaspis ist ein undurchsichtiger Chalcedon aus der Klasse der "
    "Oxide. Seine Farben ist rot.");
  SetProp(P_INFO, break_string( 
    "Der Jaspis verstaerkt angeblich die Willenskraft und Sensitivitaet.",78) );
  SetProp(P_NAME, ({"Jaspis", "Jaspisse"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"jaspis", "edelstein"}) );
  AddPluralId( ({"jaspisse", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(170,1);
  SetGramsPerUnits(4,1);

  SetProp(P_MATERIAL, MAT_QUARTZ );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "rot");
}
