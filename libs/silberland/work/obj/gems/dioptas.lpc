
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Dioptas");
  SetProp(P_LONG,  
    "Der Dioptas nennt ein praechtiges, dunkles Smaragdgruen sein eigen. "
    "Leider sind die Kristalle fast immer so klein, dass sie "
    "selten schleifwuerdig sind. Kann man ein schoenes Stueck schleifen, "
    "so ist seine Brillanz, kombiniert mit der Farbe bestechend.");
  SetProp(P_INFO, break_string( 
    "Nur geschliffen ist der Dioptas wertvoll.",78) );
  SetProp(P_NAME, ({"Dioptas", "Dioptasse"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"dioptas", "edelstein"}) );
  AddPluralId( ({"dioptasse", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(110,1);
  SetGramsPerUnits(3,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gruen");
}
