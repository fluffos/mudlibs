
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Apatit");
  SetProp(P_LONG,  
    "Der Apatit ist ein Liebhaberstein mit einer geringen Haerte und gelber "
   "Farbe.");
  SetProp(P_INFO, break_string( 
    "Ein echtes Sammlerstueck. Der Apatit wird oft fuer seltene "
    "Rituale eingesetzt.",78) );
  SetProp(P_NAME, ({"Apatit", "Apatite"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"apatit", "edelstein"}) );
  AddPluralId( ({"apatite", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(150,1);
  SetGramsPerUnits(3,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gelb");
}
