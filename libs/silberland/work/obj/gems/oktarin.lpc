// Oktarin

inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Oktarin");
  SetProp(P_LONG,  
    "Der Oktarin hat seinen Namen daher, dass er immer die Form eines "
    "Oktaeders hat. Alle Versuche, diesen geheimnisvolle, dunkelroten "
    "Edelstein in eine andere Form zu schleifen, gehen immer daneben. "
    "Ob da wohl maechtige Magie am Werke ist?");
  SetProp(P_INFO, break_string( 
    "Der Oktarin ist definitiv magisch.",78) );
  SetProp(P_NAME, ({"Oktarin", "Oktarine"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"oktarin", "edelstein"}) );
  AddPluralId( ({"oktarine", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(300,1);
  SetGramsPerUnits(1,1);

  SetProp(P_MATERIAL, MAT_OCTARINE );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "rot");
  SetProp(P_MAGIC, 1);

  AddDetail( ({"oktaeder"}),
    "Ein Oktaeder besteht aus 8 Flaechen und 8 Kanten. Man koennte auch sagen, "
    "dass er aus zwei zusammengestellten, quadratischen Pyramiden besteht.");
}
