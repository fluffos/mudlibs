
inherit "std/unit";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Apophyllit");
  SetProp(P_LONG,  
    "Apophyllit ist ein reiner Liebhaberstein fuer Kenner und Sammler, da "
    "er wegen seiner ausgepraegten Spaltbarkeit und der geringen Haerte "
    "von 4.5 bis 5 nur selten geschliffen wird. Dieser Apophyllit ist "
    "gelblich, er tritt aber auch farblos, gruenlich und selten roetlich auf.");
  SetProp(P_NAME, ({"Apophyllit", "Apophyllite"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"apophyllit", "edelstein"}) );
  AddPluralId( ({"apophyllite", "edelsteine"}) );
  AddId( "EDELSTEIN" );
  SetCoinsPerUnits(130,1);
  SetGramsPerUnits(2,1);

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gelb");
}
