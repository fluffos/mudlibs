inherit "/std/thing";

#include <daemon.h>
#include <wizlevels.h>

private nosave mixed _name_;


void create()
{
  if (is_clone(this_object())) return destruct(this_object());
}

int remove() { return 0; }

int query_prevent_shadow() { return 1; }

// Um etwas sinnvolles bei -Info? anzuzeigen:
string name() { return _name_ ? _name_ : "<Info>"; }

// Channel-Master-Check-Funktion
int check(string ch, object pl, string cmd, string txt)
{
  string fn;
  if(ch != "Info") return 0;
  if(interactive(pl) && IS_LORD(pl)) return 1;
  switch(cmd)
  {
    case C_SEND:
      fn=file_name(pl);
      if ((fn[0..7]!="/gilden/") && (fn[0..7]!="/secure/")) return 0;
      // else fall-thru
    default:
      return 1;
  }
}

void InfoMsg(string msg)
{
  string po;

  po = file_name(previous_object());
  if (interactive(previous_object()) ||
      (po[0..7]=="/gilden/") || (po[0..7]=="/secure/") ||
      (po == "/d/astral/feyaria/astral/master/astralmaster") ||
      (po == "/d/nacht/anatol/rassen/m/change") )
  {
    _name_ = "";
    catch(CHMASTER->send("Info",this_object(),msg,MSG_SAY));
    _name_ = 0;
  }
}

