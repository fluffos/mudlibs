#pragma strict_types

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


nosave string _query_long()
{
  mixed e;
  int t,i;
  if (!TP) return "Ein handliches Taschenthermometer.\n";
  if (MENV!=TP)
    return "Ein handliches Taschenthermometer.\n"+
      "Wenn Du es nimmst, kannst Du vielleicht die Temperatur erkennen.\n";
  else
  {
    // eine kleine Abweichung ins Spiel bringen :) (+- 0.5 Grad)
    i=random(10);
    e=ENV(MENV);
    if (e) e = (mixed) e->QueryProp(P_ENVIRONMENT);
    if (mappingp(e)) t = (int) e[ENV_TEMPERATURE];
    else return BS("Ein handliches Taschenthermometer. Aus unbestimmten "+
      "Gruenden zeigt es im Moment gar nichts an.");
    t = (int) ((mapping) ENV(MENV)->QueryProp(P_ENVIRONMENT))[ENV_TEMPERATURE];
    if (i>5) if (t>0) t--; else t++;
    return BS(sprintf("Ein handliches Taschenthermometer. "+
      "Es zeigt im Moment %d.%d Grad an, aber bei der Kommastelle bist "+
      "Du Dir nicht so ganz sicher.", t, i));
  }
}


void create()
{
  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();

  SetProp (P_SHORT, "Ein Taschenthermometer");
  SetProp (P_NAME, "Thermometer");
  SetProp (P_GENDER, NEUTER);
  AddId ( ({"thermometer", "taschenthermometer"}) );
  SetProp (P_VALUE, 500);
  SetProp (P_WEIGHT, 200);
  SetProp (P_MATERIAL,
      ([ MAT_METAL:10,MAT_WOOD:70,MAT_GLASS:15,MAT_MERCURY:5 ]) );
}
