/*
 * /obj/deputymaster.c
 * ---
 * Zustaendig fuer die Verwaltung des Sheriffkanals
 * ---
 */

#include <properties.h>
#include <daemon.h>
#include <wizlevels.h>

#define ARCHSEER_LEVEL 50

private nosave mixed _name_;
private mapping deputies =
    ([ "angrox", "yara", "macalla", "teqlablu", "woody" ]);

void create() {
  if (is_clone(this_object())) return destruct(this_object());
}

int remove() { return 0; }

query_prevent_shadow() { return 1; }

varargs int check(string ch, mixed pl, string cmd, string txt, int level, int qp)
{
  string fn;
  if (ch != "Deputies") return 0;
  if (objectp(pl) && !interactive(pl)) return 0;
  return member( deputies, getuid(pl) );
}

string name() { return _name_ ? _name_ : "<Deputies>"; }
