/*
 * /obj/food/ingredients/egg.c - Ein Ei
 *
 * Heal: 1, Drink: 1, Decay: 12+2 Std
 * implementiert: cook() und fry() -> Heal: 15, Soak: 8, Decay: 12+2 Std
 *
 * (w) 2003-12-30 by Woody
 *
 */


inherit "std/food";

#include <language.h>
#include <properties.h>
#include <food.h>
#include <defines.h>
#include <moredef.h>


void create()
{
  if (!is_clone(this_object()))
    return;

  ::create();

  AddId("ei");
  SetProp(P_SHORT, "Ein Ei");
  SetProp(P_NAME, "Ei");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_COLOUR, random(2) ? "weiss" : "hellbraun");

  SetProp(P_LONG,
    "Ein ganz gewoehnliches Huehnerei, Gueteklasse A. Es hat eine " +
    QueryProp(P_COLOUR) + "e Schale und "
    "perfekte Rundungen. Du kannst es kochen, braten, aufschlagen, oder "
    "vielleicht auch als Zutat verwenden oder einem Wirten als "
    "solche anbieten.");

  AddDetail( "schale",
      "Die " + QueryProp(P_COLOUR) + "e Schale ist glatt und zerbrechlich." );
  AddDetail( "rundungen",
      "Die Rundungen des Eis sind einfach nur perfekt, Du bist begeistert." );

  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 10);

  SetProp(P_FOOD_STATE, F_RAW);
  SetProp(P_FOOD_INFO, ([
    F_HEAL     : ({ 1,1 }),
    F_DRINK    : 1,
    F_SHOW_RAW : 1,
    F_MSG      : "Du schlaegst das rohe Ei auf und isst es. Igitt!",
    F_MSG_ROOM : "schlaegt ein rohes Ei auf und isst es. Igitt!",
    F_VERB     : "essen" ]) );

  // Haelt 12 Stunden, Zerfall nach weiteren 2 Stunden
  start_decay(43200, 7200);

  AddCmd( ({ "schlag", "schlage" }), "cmd_schlage" );
}


// Ei wird gekocht:
int cook(int silent)
{
  if (QueryProp(P_FOOD_STATE) & F_SPOILT)
  {
    if (!silent)
      write("Aber " + name(WEN,1) + " ist doch bereits verfault!\n");
    return 0;
  }

  if (QueryProp(P_FOOD_STATE) != F_RAW)
  {
    if (!silent)
      write("Du kannst " + name(WEN,1) + " nur kochen, wenn es roh ist.\n");
    return 0;
  }

  if (!silent && this_player())
  {
    write("Du kochst das Ei, bis es ein perfektes 3-Minuten-Ei ist.\n");
    environment(this_player())->Message(
        TP->Name() + " kocht ein Ei.\n");
  }

  SetProp(P_SHORT, "Ein gekochtes Ei");
  SetProp(P_LONG,
    "Ein hartgekochtes Huehnerei, Gueteklasse A. Es hat eine " +
    QueryProp(P_COLOUR) + "e Schale und perfekte Rundungen. Solange "
    "es noch nicht verdorben ist, ist es sicher eine leckere Mahlzeit.");

  SetProp(P_FOOD_STATE, F_COOKED);
  SetProp(P_FOOD_INFO, ([
    F_HEAL     : 15,
    F_SOAK     : 8,
    F_MSG      : "Du isst das hartgekochte Ei. Mjamm, lecker!",
    F_MSG_ROOM : "isst ein hartgekochtes Ei.",
    F_VERB     : "essen" ]) );

  // Haelt 12 Stunden, Zerfall nach weiteren 2 Stunden
  start_decay(43200, 7200);

  return 1;
}


// Ei wird gebraten:
int fry(int silent)
{
  if (QueryProp(P_FOOD_STATE) & F_SPOILT)
  {
    if (!silent)
      write("Aber " + name(WEN,1) + " ist doch bereits verfault!\n");
    return 0;
  }

  if (QueryProp(P_FOOD_STATE) != F_RAW)
  {
    if (!silent)
      write("Du kannst " + name(WEN,1) + " nur braten, wenn es roh ist.\n");
    return 0;
  }

  if (!silent && this_player())
  {
    write("Du braetst Dir ein schoenes Spiegelei.\n");
    environment(this_player())->Message(
        TP->Name() + " braet ein leckeres Spiegelei.\n");
  }

  SetProp(P_SHORT, "Ein Spiegelei");
  SetProp(P_NAME, "Spiegelei");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_COLOUR, "weiss-gelb");

  SetProp(P_LONG,
    "Ein leckeres Spiegelei mit kreisrunder, gelber Mitte. "
    "Einfach perfekt gebraten. Solange es noch nicht verdorben ist, ist "
    "es sicher eine leckere Mahlzeit.");

  AddDetail( "schale",
      "Die Schale des Eis hast Du doch schon vor dem Braten abgemacht!" );
  RemoveDetail( "rundungen" );

  SetProp(P_FOOD_STATE, F_FRIED);
  SetProp(P_FOOD_INFO, ([
    F_HEAL     : 15,
    F_SOAK     : 8,
    F_MSG      : "Du isst ein nahrhaftes Spiegelei. Mjamm, lecker!",
    F_MSG_ROOM : "isst ein leckeres Spiegelei.",
    F_VERB     : "essen" ]) );

  // Haelt 12 Stunden, Zerfall nach weiteren 2 Stunden
  start_decay(43200, 7200);

  return 1;
}


// Ei verwest (hier noch bessere Ess-Meldung setzen...)
int decay(int silent)
{
  return ::decay(silent);
}


int cmd_schlage(string str)
{
  notify_fail("Was willst Du (auf-) schlagen?\n");
  if (!str) return 0;
  if (str[<4..] != " auf") return 0;
  if (!id(str[0..<5])) return 0;

  write("Gekonnt schlaegst Du das Ei auf - woraufhin es Dir durch die\n"
      "Finger zu Boden rinnt, was fuer eine Verschwendung!\n");

  environment(this_player())->Message(
      TP->Name() + " schlaegt gekonnt ein Ei auf - und laesst es zu Boden "
      "rinnen.\nUuuuaaaeeeeeeeeehhhhh!\n", MSGFLAG_NO_TP | MSGFLAG_VISUAL );

  remove(1);
  return 1;
}
