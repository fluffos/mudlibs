/*
 * /obj/food/ingredients/milk.c - Milch
 *
 * Heal: 10, Drink: 4, Decay: 12 Std
 * nicht implementiert: cook() und fry()
 *
 * (w) 2004-01-12 by Woody
 *
 */


inherit "std/food";

#include <language.h>
#include <properties.h>
#include <food.h>
#include <defines.h>
#include <moredef.h>


void create()
{
  if (!is_clone(this_object()))
    return;

  ::create( ({ "trink", "trinke" }) );

  AddId("milch");
  SetProp(P_SHORT, "Eine Flasche Milch");
  SetProp(P_NAME, "Flasche Milch");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_COLOUR, "weiss");

  SetProp(P_LONG,
    "Eine Flasche Milch. Sie ist sicherlich sehr erfrischend, Du kannst "
    "sie aber wohl genauso zum Kochen von Gerichten verwenden. Allerdings "
    "ist Milch bekanntlich nicht ewig haltbar.");

  AddDetail( "flasche",
      "Die " + QueryProp(P_COLOUR) + "e Schale ist glatt und zerbrechlich." );
  AddDetail( "rundungen",
      "Die Rundungen des Eis sind einfach nur perfekt, Du bist begeistert." );

  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 10);

  SetProp(P_FOOD_STATE, F_RAW);
  SetProp(P_FOOD_STATE_DESC, ([ F_RAW : "frisch", F_SPOILT : "sauer" ]) );

  SetProp(P_FOOD_INFO, ([
    F_HEAL     : ({ 10,10 }),
    F_DRINK    : 4,
    F_SHOW_RAW : 1,
    F_MSG      : "Du trinkst die Milch aus, aaaaaaah, erfrischend!",
    F_MSG_ROOM : "trinkt eine Flasche Milch auf einen Sitz aus.",
    F_MSG_DECAY: "Die Milch wird sauer.\n",
    F_VERB     : "trinken" ]) );

  // Haelt 12 Stunden, Zerfall nach weiteren 2 Stunden
  start_decay(43200, -1);
}


// Ei verwest (hier noch bessere Ess-Meldung setzen...)
int decay(int silent)
{
  return ::decay(silent);
}
