#include <moving.h>

inherit "std/thing";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
}

int move(object pl,int method)
{
  object ob;

  ob=clone_object("/p/service/woody/obj/fband2");
  ob->move(pl,M_NOCHECK);
  pl->Message(
      "===============================================\n"
      "  Dein Freundschaftsband wurde erneuert ! :-)\n"
      "Bitte lies Dir \"hilfe freundschaftsband\" durch.\n"
      "===============================================\n");
  this_object()->remove();
  return 1;
}

