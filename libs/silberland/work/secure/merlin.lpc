void create()
{
  string s, tmp;

  seteuid(ROOTID);

  if (file_size("/etc/maxusers")<=0)
    max=sizeof(users());
  else {
    s=read_file("/etc/maxusers",0,1);
    sscanf(s,"%d",max);
  }
  if (file_size("/etc/maxusers.today")<=0) {    // no info yet...
    maxtoday   = 0;
    currentday = 0;
    userstoday = ([ ]);
  } else {                                      // read /etc/maxusers.today
    s=explode(read_file("/etc/maxusers.today",0,1),"\n")[0];
    sscanf(s,"%d|%s|%s|",maxtoday,currentday,tmp);
    userstoday = mkmapping( explode( tmp, "," ) );
  }
  if (file_size("/etc/onlinestats")<=0)
    maxuptime = time() - last_reboot_time();
  else {
    mixed a;
    a = regexp(explode(read_file("/etc/onlinestats"),"\n"),"^maxuptimetime\\|");
    if (sizeof(a))
      sscanf(a[0],"%s|%d",s,maxuptime);
    else
      maxuptime = time() - last_reboot_time();
  }
  UpdateStats();                                // write out known data

  set_living_name("merlin");
  enable_commands();
  call_out("wandern",25);
  move("/gilden/abenteurer",0);
  MBanishListe = allocate_mapping(0,2);
  SBanishListe = allocate_mapping(0,2);
  restore_object(SAVEFILE);
  set_next_reset(300);  // alle 5 Minuten
}


string _query_kill_name()
{
  return "Ein genervter Merlin";
}


int move(mixed ob,int methods)
{
  object tmp;

  if (methods&M_GET)
    return ME_CANT_BE_TAKEN;

  if (stringp(ob))
  {
    if (!(tmp=find_object(ob)))
    {
      call_other(ob,"?");
      tmp=find_object(ob);
    }
    ob=tmp;
  }
  if (!objectp(ob))
    return 0;
  if (environment())
    tell_room(environment(),"Merlin zieht weiter.\n");
  tell_room(ob,"Merlin kommt an.\n");
  move_object(ob);
  return 1;
}


mixed QueryProp(string str)
{
  if (!stringp(str)||str=="") return 0;
  return call_other(this_object(),"_query_"+str);
}


