mixed _query_noattack()
{
  if (this_player() == this_object())
    return 1;

#if 0
  {
    int i;
    string s;
    s = sprintf(" -- MERLIN DEBUG -- verb: %s, CSD: %d\n",
        query_verb() || "(keines?)", caller_stack_depth());
    for (i=0; i<=caller_stack_depth(); i++)
      s += sprintf( " -- %d: %O\n", i, previous_object(i) );
    s+=" -- MERLIN DEBUG END --\n";
    if (find_player("woody"))
      tell_object(find_player("woody"), s);
  }
#endif

  if ( query_verb() &&
       (previous_object(caller_stack_depth() - 1) ==
        previous_object(caller_stack_depth() - 2) ) &&
       living(previous_object(caller_stack_depth() - 1)) )
  {
    write("Merlin gibt Dir eine schallende Ohrfeige.\n");
    say(sprintf("Merlin gibt %s eine schallende Ohrfeige.\n",
               this_player()->name(WEM)), this_player());
    return "schimpft: Lass das!!!";
  }
  return "laechelt muede.";
}
 

string Name(int casus, int demon) {
  return name(casus, demon);
}


string QueryPronoun(int casus)
{
  switch (casus)
  {
    case WER: return "er";
    case WEM: return "ihm";
    default:  return "ihn";
  }
}


string QueryPossPronoun( mixed what, int casus, int number )
{
  int gen2;
  gen2 = ( intp( what ) ) ? what : what->QueryProp(P_GENDER);
  return "sein" + query_g_suffix( gen2, casus, number );
}


string query_g_suffix( int gen, int casus, int anzahl )
{
  return ({ ({ ({"","e"}), ({"es","er"}), ({"em","en"}), ({"","e"}) }),
	      ({ ({"","e"}), ({"es","er"}), ({"em","en"}), ({"en","e"}) }),
	      ({ ({"e","e"}), ({"er","er"}), ({"er","en"}), ({"e","e"}) }) })
    [gen][casus][anzahl];
}


nosave void InformPlayers(string group,string text)
{
  object *players;
  int i;
  mixed data;
  string ig;

  players=users();
  ig="merlin.news";
  for (i=sizeof(players)-1;i>=0;i--) {
    data=players[i]->QueryProp(P_WAITFOR);
    if (pointerp(data)&&(member(data,"Zeitung")>-1)) {
      data=players[i]->QueryProp(P_READ_NEWS);
      if (mappingp(data)&&(data[group]>0)) {
        data=players[i]->QueryProp(P_IGNORE);
        if ((!pointerp(data))||(member(data,ig)==-1))
          tell_object(players[i],text);
      }
    }
  }
}


nosave void PostSeher(string who, int g)
{
  string wann, uhrzeit;
  mixed *art;

  wann = dtime(time());
  wann = sprintf(
      "%s, den %s %s %s um %s Uhr",
      wdays[wann[0..2]], dtime(time())[5..7], mnames[wann[9..11]],
      wann[13..16], wann[19..] );

  art = ({
      "stufen",
      "Merlin", 0, 0,
      sprintf( "%s ist jetzt ein%s Seher%s!",
        capitalize(who), (g == 2 ? "e" : ""), (g == 2 ? "in" : "") ),
      sprintf( "Am %s hat %s die\n" +
        (g == 2 ? "ihr" : "ihm") +
        " gestellten Anforderungen erfuellt und ist von Merlin "
        "aus dem\nSpielerstand in den Seherstand erhoben worden.\n"
        "\n   Herzlichen Glueckwunsch, %s!\n\n",
        wann, capitalize(who), capitalize(who) ) });

  NEWSSERVER->WriteNote(art,1);
  InformPlayers("stufen",
    "* Extrablatt! Neuer Artikel von Merlin in Rubrik \"stufen\".\n");
    
}


nosave void PostMagier(string who, string prom, int gender)
{
  mixed *art;

  art = ({"stufen","Merlin",0,0,
    sprintf("%s ist jetzt ein%s Magier%s!",
      capitalize(who),(gender==2?"e":""),(gender==2?"in":"")),
    sprintf("\nAm %s hat %s %s zu%s Magier%s\nberufen. "
      "Herzlichen Glueckwunsch, %s. Glueckwuensche auch an Dich,\n"
      " %s, zu Deine%s neuen %s!\n",dtime(time()),prom,who,
      (gender==2?"r":"m"),(gender==2?"in":""),who,prom,
      (gender==2?"r":"m"),(gender==2?"Tochter":"Sohn"))});

  NEWSSERVER->WriteNote(art,1);
  InformPlayers("stufen",
    "* Extrablatt! Neuer Artikel von Merlin in Rubrik \"stufen\".\n");
  
}


varargs void notify_player_change(string who, int rein, int invis)
{
  int i;
  object *u,ob;
  string wer,race,thisip;
  mixed cloneip;
  string *ign;

  if (!stringp(who))
    return;
  wer=capitalize(who);

  if (file_size("/etc/maxusers")<=0)
    max=0;

  // Alle Spieler ausgenommen Logins
  u = filter_array( users(),
        lambda( ({ 'x }),
          ({ #'!=, ({ #'getuid, 'x }), ROOTID }) ) );

  if (rein)
  {
    if (sizeof(u) >= max)
    {
      max = sizeof(u);
      catch(rm("/etc/maxusers"));
      write_file("/etc/maxusers",sprintf("%d user: %s (%s)\n",
          max,dtime(time()),query_load_average()));
    }
    UpdateStats();
  }
  else
    call_out("UpdateStats", 0);   // beim Ausloggen leider notwendig

  if(!(ob=find_player(who)) && !(ob=find_netdead(who)))
    return;

  if (rein == 1) // einloggende spieler auf verwarnungen checken
    call_other(WARNING_MASTER, "notify_player_change", ob);

  if(IS_LEARNER(ob))
  {
    i=(ob->QueryProp(P_GENDER) >> 1) & 1;
    switch(query_wiz_level(ob))
    {
      case LEARNER_LVL .. INACTIVEWIZ_LVL-1:
        race = "Magierlehrling"; break;
      case INACTIVEWIZ_LVL .. WIZARD_LVL-1:
        race = "Altmagier" + (i ? "in" : ""); break;
      case WIZARD_LVL .. DOMAINMEMBER_LVL-1:
        race = "Jungmagier" + (i ? "in" : ""); break;
      case DOMAINMEMBER_LVL .. FULLWIZ_LVL-1:
        race = "Magier" + (i ? "in" : ""); break;
      case FULLWIZ_LVL .. SPECIAL_LVL-1:
        race = "Vollmagier" + (i ? "in" : ""); break;
      case SPECIAL_LVL .. LORD_LVL-1:
        race = "Sondermagier" + (i ? "in" : ""); break;
      case LORD_LVL .. ELDER_LVL-1:
        race = "Regionsmagier" + (i ? "in" : ""); break;
      case ELDER_LVL .. ARCH_LVL-1:
        race = i ? "Weise" : "Weiser"; break;
      case ARCH_LVL .. GOD_LVL-1:
        race = "Erzmagier" + (i ? "in" : ""); break;
      default:
        race = i ? "Goettin" : "Gott";
    }
  }
  else if(ob->QueryProp(P_TESTPLAYER))
    race = "Testspieler" + (ob->QueryProp(P_GENDER) == FEMALE ? "in" : "");
  else
    race = ob->QueryProp(P_RACESTRING)[0];

  u -= ({ ob });
  thisip = query_ip_number(ob);
  cloneip = ({ });
  for (i = sizeof(u)-1; i >= 0; i--)
    if (query_ip_number(u[i]) == thisip)
      cloneip += ({ capitalize(getuid(u[i])) });
  cloneip=implode(cloneip,",");

  for (i=sizeof(u)-1;i>=0;i--)
    if (!pointerp(ign = u[i]->QueryProp(P_IGNORE)) ||
       member(ign, who + ".inform") == -1)
      if (!IS_LEARNER(u[i])) {
        if (rein==-1)
          u[i]->notify_player_change(wer, 0, invis, 0, race, 0);
        else if (!invis)
          u[i]->notify_player_change(wer, rein, invis, 0, race, 0);
      } else
        u[i]->notify_player_change(wer, rein, invis,
            query_ip_name(ob),race,cloneip);
}

varargs void notify_player_enter(string who, int invis)
{
  notify_player_change(who,1,invis);
}

varargs void notify_player_invis(string who, int invis)
{
  notify_player_change(who,-1,invis);
}

varargs void notify_player_leave(string who, int invis)
{
  notify_player_change(who,0,invis);
}


nosave string GetCurrentDay()
{
  return ctime()[0..9] + ctime()[<5..];
}


// time2string() is a simul_efun, but too expensive, so we make our own:
nosave string time2str(int t)
{
  int tmp;
  string s;

  s="";
  if (t>=86400) s+=sprintf("%d Tag%s, ",tmp=t/86400,(tmp==1?"":"e"));
  if (t>=3600) s+=sprintf("%d Stunde%s, ",tmp=(t=t%86400)/3600,(tmp==1?"":"n"));
  if (t>60) s+=sprintf("%d Minute%s und ",tmp=(t=t%3600)/60,(tmp==1?"":"n"));
  return s+sprintf("%d Sekunde%s",t=t%60,(t==1?"":"n"));
}

nosave varargs void UpdateStats(int checkonly)
{
  mixed u, vis;

  // remove all call_out's
  while (find_call_out("UpdateStats") != -1) remove_call_out("UpdateStats");

  u = filter_array(users(), lambda( ({ 'x }),
        ({ #'!=, ({ #'getuid, 'x }), ROOTID }) ));            // no logins
  vis = u - filter_objects(users(),"QueryProp",P_INVIS);      // visibles

  // Update per-day statistics
  if ( (sizeof(u) > maxtoday) ||
       (currentday != GetCurrentDay()) ||
       sizeof(mkmapping(map_array(u,#'getuid)) - userstoday) )
  {
    if (currentday == GetCurrentDay())
    {
      userstoday += mkmapping(map_array(u,#'getuid));
      if (sizeof(u) > maxtoday) maxtoday = sizeof(u);
    }
    else
    {
      currentday = GetCurrentDay();
      userstoday = mkmapping(map_array(u,#'getuid));
      maxtoday = sizeof(u);
    }

    catch(rm("/etc/maxusers.today"));
    write_file("/etc/maxusers.today",
        sprintf("%d|%s|%s|\n",
          maxtoday, currentday, implode(m_indices(userstoday),",") ) );
    checkonly=0;
  }

  // Update max uptime statistic
  if (maxuptime < time()-last_reboot_time()) {
    maxuptime = time()-last_reboot_time();
    checkonly=0;
  }

  // avoid write_file() if possible
  if (checkonly) return;

  // Update global statistics and write data to disk
  catch(rm("/etc/onlinestats"));
  write_file("/etc/onlinestats",
    sprintf("lastreboot|%s\nlastreboottime|%d\nuptime|%s\nuptimetime|%d\n"
      "users|%d\nvisibleusers|%d\n"
      "guests|%d\nplayers|%d\nseers|%d\nwizards|%d\nvisiblewizards|%d\n"
      "maxusers|%d\nmaxuserstoday|%d\nmaxuptime|%s\nmaxuptimetime|%d\n",
      dtime(last_reboot_time()), last_reboot_time(),
      uptime(), time()-last_reboot_time(),
      // user stats:
      sizeof(u), sizeof(vis),
      // guests:
      sizeof( filter_objects(u, "QueryGuest") ),
      // players:
      sizeof( filter_array(u, lambda( ({'x}),
                ({ #'&&,
                  ({ #'==, ({ #'query_wiz_level, 'x }), 0 }),
                  ({ #'!, ({ #'call_other, 'x, "QueryGuest" }), })
                }) ) ) ),
      // seers:
      sizeof( filter_array(u, lambda( ({'x}),
                ({ #'&&,
                  ({ #'>=, ({ #'query_wiz_level, 'x }), 1 }),
                  ({ #'<,  ({ #'query_wiz_level, 'x }), LEARNER_LVL }),
                }) ) ) ),
      // wizards:
      sizeof( filter_array(u, lambda( ({'x}),
                ({ #'>=, ({ #'query_wiz_level, 'x }), LEARNER_LVL }) ) ) ),
      // visible wizards:
      sizeof( filter_array(vis, lambda( ({'x}),
                ({ #'>=, ({ #'query_wiz_level, 'x }), LEARNER_LVL }) ) ) ),
      // max stats:
      max, maxtoday, time2str(maxuptime), maxuptime));
}

public int QueryMaxUsers()
{
  return max;
}

public int QueryMaxUsersToday()
{
  UpdateStats(1);       // vielleicht ist ja ein neuer Tag :)
  return maxtoday;
}

public int QueryMaxDistinctUsersToday()
{
  UpdateStats(1);       // vielleicht ist ja ein neuer Tag :)
  return sizeof(userstoday);
}

public mapping QueryDistinctUsersToday()
{
  UpdateStats(1);       // vielleicht ist ja ein neuer Tag :)
  return copy_mapping(userstoday);
}

public int QueryMaxUptime()
{
  UpdateStats(1);       // vielleicht ist ja ein neuer Rekord :)
  return maxuptime;
}


void Defend(int dam, string dam_type, int spell, object enemy)
{
  object en;
  if (!en=previous_object() || !living(en))
    en = this_player();
  tell_room(environment(), "Merlin schimpft: Lass das!!!\n");
  write("Merlin gibt Dir eine schallende Ohrfeige.\n");
  say(sprintf("Merlin gibt %s eine schallende Ohrfeige.\n",
	      this_player()->name(WEM)), this_player());
  en->StopHuntFor(this_object(), 1);
}


void shoutansw()
{
  object env,ti;
  string *path;
  string ans;

  if (!(env=environment()) ||
      !(ti=this_interactive()) ||
      !query_wiz_level(ti) ||
      ti->QueryProp(P_GHOST))
    return;

  tell_object(ti,"Du spuerst einen sengenden Schmerz.\n");
  ti->do_damage(ti->QueryProp(P_HP)/2+5);
  ans="Ich hab nicht die leiseste Idee, wo ich hier bin...\n";
  path=explode(file_name(env),"/");

  if (path[0]=="d")
  {
    switch(path[1])
    {
      case "dschungel":
      case "gebirge":
      case "kristallwald":
      case "huegelland":
        ans="im "+capitalize(path[1]);
        break;

      case "polar":
        ans="im Polargebiet";
        break;

      case "wasser":
        if (sizeof(regexp(path,"insel")))
          ans="auf einer Insel";
        else
          ans="am Wasser";
        break;

      case "ebene":
        switch(path[2])
        {
          case "Gaffos":
            ans="bei den Gaffos";
            break;
          case "Silberwald":
          case "Park":
            ans="im "+path[2];
            break;
          case "Midas":
            ans="in Midas";
            break;
          default:
            ans="in der Ebene";
        }
        break;

      case "wueste":
      case "unterwelt":  
        ans="in der "+capitalize(path[1]);
        break;

      case "wahnsinn":
        ans="in einer verrueckten Umgebung";
        break;

      case "nacht":
        ans="in einem dunklen Reich";
        break;

      case "pk":
        ans="in einem Gebiet des Todes";
        break;

      case "seher":
        if (path[1]=="haus")
          ans="in einem Seherhaus";
        else
          ans="im Land der Seher";
        break;

      default:
        ans="werweisswo..";
    }
    ans="Ich bin "+ans+".\n";
  }
  else if (path[0]=="players")
    ans="Ich hab mich verlaufen - ich schaetze, "+
        capitalize(path[1])+" hat was damit zu tun...\n";
  else if (path[0]=="gilden")
    ans="Ich bin in einer Gilde.\n";
  else if (path[0]=="room")
  {
    switch(path[1])
    {
      case "death":
      case "netztot":
        ans="im Reich der Toten";
        break;
      case "jail":
        ans="im Gefaengnis";
        break;
      case "void":
        ans="im absoluten Nichts";
        break;
      default:
        ans="werweisswo..";
    }
    ans="Ich bin "+ans+".\n";
  }
  ans="Merlin ruft: "+ans;
  call_out("myshout",0,ans);
}


void myshout(string s)
{
  write(s);
  shout(s);
}


void catch_tell(mixed str)
{
  string d1,d2,d3;
  mixed name, message, dummy;
  int i,s;

  if (!this_player())
    return;

  // Geschehnisse von aussen nach innen weiterleiten
  if (environment() == environment(this_player()) && previous_object() != ME)
    tell_room(this_object(), "*" + str);

  // Erzwungenes intressiert uns nicht
  if (this_player() != this_interactive())
    return;

  // Gross/Kleinschreibung ist uns egal
  str = lower_case(str);

  // Ortanfragen beantworten
  if ( sscanf( str,"%s teilt dir mit:%swo%sbist%s",name,d1,d2,d3 ) == 4 )
    return (void) shoutansw();

  // Alles ausser "sag" ignorieren
  if ( sscanf(str,"%s sagt: %s", name, message) != 2 )
    return;

  // Name ermitteln (Presay ausfiltern!) und verifizieren
  name=explode(name," ")[<1];
  if ( !stringp(name) || !strlen(name) ||
       catch(s = file_size( sprintf( "/save/%c/%s.o", name[0], name ) )) ||
       s <= 0 )
    return;

  // Fakeversuche abfangen
  if (name != getuid(this_interactive()) && !IS_ARCH(this_interactive()))
  {
    if (flag == getuid(this_interactive()) + "##" + name)
      return;
    call_out("do_say", 0,
        break_string(
        sprintf( "%s hat gerade so getan als wuerde %s etwas sagen!",
                 capitalize(getuid(this_interactive())), capitalize(name) ),
        78, "Merlin sagt: " ) );
    flag = getuid(this_interactive()) + "##" + name;
    call_out("clear_flag", 0);
    return;
  }

  // Whitespaces in Spaces umsetzen
  for (i = 0; i < sizeof(whitespaces); i++)
  {
    message = efun::explode( message, whitespaces[i] ) - ({ "" });
    message = implode(message," ");
  }
  message = efun::explode( message, " " ) - ({ "" });

  // Soll ich mich angesprochen fuehlen?
  if ( member( message, "merlin" ) == -1 )
    return;

  // Bleibt noch was inhaltsvolles ueber?
  message -= ({ "merlin" });
  if ( !sizeof(message) )
    return;

  // Anfrage bearbeiten
  message = implode( message, " " );
  (void) determine_action(message, name);
}


nosave int determine_action(string mess, string name)
{
  string str;

  if (strstr( mess, "mach mich zum seher") != -1 ||
      strstr( mess, "mach mich zur seherin") != -1)
    return (int) call_out("create_seer", 0, this_player());

  if (mess == "mach mich zum magier" ||
      mess == "mach mich zur magierin")
    return (int) create_wizard( name, name );

  if (sscanf(mess, "mach %s zum magier", str) == 1 ||
      sscanf(mess, "mach %s zur magierin", str) == 1)
    return (int) create_wizard( str, name );
}


int QueryConditions(object pl, int wiz)
{
  int ret,i,gen;
  string was;

  if (IS_LEARNER(pl))
    return 1;
  gen = pl->QueryProp(P_GENDER);
  was = wiz ? "Magier" : "Seher";

  // Erfahrungspunkte?
  if (pl->QueryProp(P_XP) < XP_NEEDED_FOR_WIZ)
  {
    tell_object(pl,"Dir fehlt noch die noetige Erfahrung.\n");
    say(pl->name(WER)+" hat noch nicht genug Erfahrung fuer den "+
        was+"status.\n",pl);
    return 0;
  }

  // Questpunkte?
  ret = wiz ? QM->QueryReadyForWiz(pl) : QM->QueryReadyForSeer(pl);
  if (ret == -1)
  {
    tell_object(pl,"Dir fehlen noch Abenteuerpunkte. "
        "Loes doch erstmal noch ne Quest, ok?\n");
    say(pl->name(WER)+" hat noch nicht genug Abenteuerpunkte fuer den "+
        was+"status.\n", pl);
    return 0;
  }
  if (ret != 1)
  {
    tell_object(pl,
      "Du hast zwar genug Abenteuerpunkte, aber es gibt Abenteuer, die man\n"+
      "einfach loesen MUSS, um " + was + (gen != FEMALE ? "" : "in") +
      " zu werden.\n");
    tell_object(pl,Magier_und_Seher_Text(pl));
    tell_object(pl,"\nLoese die fehlenden Abenteuer und komm dann wieder.\n");
    return 0;
  }

  // Forscherpunkte?
  if (10*EPMASTER->QueryExplorationPoints(pl) <= (11*EPMASTER->QueryAverage()))
  {
    tell_object(pl, break_string(sprintf(
        "Kampferfahrung und Abenteuer sind nicht alles! Man sollte sich im "+
        MUDNAME+" auch einigermassen auskennen, um %s werden zu koennen.\n"+
        "Schau Dir doch noch einige unerforschte Gebiete an, und komm "+
        "wieder zu mir, wenn Du Dich besser als der Durchschnitt der "+
        "Spieler auskennst.\n",
        (gen==FEMALE ? ("eine wuerdige "+was+"in")
                     : ("ein wuerdiger "+was))), 78, "Merlin sagt: ", 1));
    say(pl->Name(WER)+" hat fuer den "+was+"status noch nicht genug "
        "vom "+MUDNAME+" erkundet.\n",pl);
    return 0;
  }
  return 1;
}


private nosave string _astext(int i, string ex)
{
  if ( (i>12) || (i<0) ) return to_string(i);
  return ({ "kein"+ex, "ein"+ex, "zwei", "drei", "vier", "fuenf",
            "sechs", "sieben", "acht", "neun", "zehn", "elf", "zwoelf"}) [i];
}


string Magier_und_Seher_Text(object pl)
{
  int *dn,i;
  string str;

  // QGROUPS is defined in /secure/questmaster.h
  dn = QM->QueryDontneed(pl);

  str="";
  for (i=sizeof(QGROUPS)-1; i>=1; i--)
    str+="von den Abenteuern ab "+QGROUPS[i]+" Punkten darfst Du "+
      _astext(dn[i],"es")+" auslassen,\n";
  str="\n"+capitalize(str)+"und von den ganz leichten Abenteuern darfst Du "+
    _astext(dn[0],"es")+" auslassen.\n\n"+
"Falls Du in einer Gruppe mit schwereren Abenteuern mehr geloest haben\n"+
"solltest, als erforderlich war, so kannst Du Dir dafuer eine leichtere\n"+
"Aufgabe ersparen.\n";

  return str;
}


nosave int create_wizard(mixed who, mixed promoter)
{
  mixed *domains;
  object vertrag;
  string tmp;
  int ret;
  int ptr;                      // for
  string bytes, from, to;       // file-copy

  who = find_player(who);
  promoter = find_player(promoter);
  if (!who || !promoter)
    return 0;

  // player not interactive?
  if (!interactive(who))
  {
    write(capitalize(getuid(who))+" ist nicht aktiv.\n");
    return 0;
  }

  // wants to advance himself?
  if (who == promoter)
  {
    write( break_string(
          "Du kannst Dich nicht selber befoerdern. Such Dir dazu bitte einen "
          "Vollmagier, der Dir einen Vertrag gibt.", 78, "Merlin sagt: " ) );
    return 1;
  }

  // mbanished?
  if (MBanishListe[getuid(who)] && !IS_ARCH(promoter))
  {
    tell_object(promoter, capitalize(getuid(who))+
        " darf nur von einem Erzmagier zum Magier gemacht werden.\n");
    say(promoter->Name(WER)+" ist kein Erzmagier und darf "+
        capitalize(getuid(who))+" nicht zum Magier machen.\n", promoter);
    return 1;
  }

  // Sponsor sbanished?
  if (SBanishListe[getuid(promoter)])
  {
    tell_object( promoter, break_string( "Du bist \"sbanished\" und darfst "
          "daher bis auf weiteres niemanden zum Magier machen. Bei Rueck"
          "fragen wende Dich bitte an "+
          capitalize( SBanishListe[getuid(promoter)] ) + "!", 78 ) );
    say( promoter->Name(WER)+" darf leider niemanden zum Magier machen.\n",
         promoter );
    return 1;
  }

  // new wizard and promoter in different rooms?
  if ( (environment(who) != environment(promoter)) &&
       (query_wiz_level(promoter) < ARCH_LVL) )
  {
    tell_room( environment(promoter), break_string(
          "Ihr solltet euch schon an einem Ort versammeln, findest Du nicht?",
          78, "Merlin sagt: " ) );
    return 1;
  }

  // player has PK?
  if (who->QueryProp("playerkills")) {
     tell_room(environment(who), who->Name()+
         " hat noch einen Playerkill und kann somit kein Magier werden.\n"
         "Am besten den Sheriff oder einen Erzmagier verstaendigen.\n");
     return 1;
  }

  // already dom_member?
  if (IS_DOMAINMEMBER(who))
  {
    tell_object( who,
        break_string(
          "Fuer Dich kann ich nichts mehr tun. Du bist doch schon Magier, "
          "sogar Regionsmitarbeiter!", 78, "Merlin sagt: " ) );
    tell_room( environment(promoter), break_string( "Fuer " + who->name(WEN) +
        " kann ich nichts mehr tun, " + who->QueryPronoun() +
        " ist schon Magier!", 78, "Merlin sagt: " ), ({ who }) );
    return 1;
  }

  // already wizard?
  if (IS_WIZARD(who))
  {
    domains=MASTER->get_domain_homes(getuid(who));
    if (!domains || !pointerp(domains) || !sizeof(domains))
    {
      Say(who->Name(WER)+" gehoert noch keiner Region an und kann daher noch "+
	      "kein Voll-\nmagier werden.\n");
      Write("Du gehoerst noch keiner Region an. Schliess Dich zunaechst einer "+
	        "an und komm\ndann wieder !\n");
      return 0;
    }
    ret=MASTER->advance_wizlevel(geteuid(who),25);
    if(ret>0)
    {
      write_file("/log/game/SPONSOR",
          sprintf("[%s]: %s macht %s zum Regionsmitarbeiter (25).\n",
            ctime(), capitalize(getuid(promoter)), capitalize(getuid(who))));
      "/obj/infomaster"->InfoMsg(who->Name(WER)+" ist jetzt Regionsmitarbeiter!");
      MASTER->renew_player_object(who);
      return 1;
    }
    write("RETURNVALUE "+ret+"\n");
    say("RETURNVALUE "+ret+"\n");
    return 0;
  }

  // promoter's level is not >= FULLWIZ_LVL
  if (query_wiz_level(promoter)<FULLWIZ_LVL)
  {
    tell_object(promoter,"Du musst derzeit mindestens Level "+
        (FULLWIZ_LVL)+" haben, um jemanden befoerden zu koennen.\n");
    say(promoter->name(WER)+" ist kein Vollmagier und darf daher niemanden "+
        "zum Magier machen.\n");
    return 1;
  }

  // is already learner.
  if (IS_LEARNER(who))
  {
    // Nur Erzmagier machen Learner zu Magiern!
    if (query_wiz_level(promoter) < ARCH_LVL)
    {
      tell_object(promoter, "Nur Erzmagier koennen einen Learner zum Magier "
          "machen!\n");
      say(promoter->name(WER)+" ist kein Erzmagier und darf Learner daher "+
          "nicht befoerdern.\n");
      return 1;
    }

    ret = MASTER->advance_wizlevel(geteuid(who), 21);
    if (ret <= 0)
    {
      say("Merlin flucht: Mist, Fehler "+ret+" !\n");
      write("Merlin flucht: Mist, Fehler "+ret+" !\n");
      return 1;
    }

    write_file("/log/game/SPONSOR",
        sprintf("[%s]: %s macht %s vom Learner (10) zum Wizard (21).\n",
          ctime(), capitalize(getuid(promoter)), capitalize(getuid(who))));

    who->SetProp( P_START_HOME, "players/" + getuid(who) + "/workroom" );

    tmp = sprintf(
        "%s ist in den Kreis der Magier aufgenommen worden!\n",
        capitalize(getuid(who)) );
    "/obj/infomaster"->InfoMsg(tmp);

    MASTER->renew_player_object(who);
    return 1;
  }

  // Signed contract?
  if (!(vertrag=present("unterschriebenvertrag",who)))
  {
    Write("Du hast ja gar keinen unterschriebenen Vertrag bei Dir. Besorg Dir "+
	      "einen Ver-\ntrag, unterschreibe ihn und komm dann wieder !\n");
    Say(who->name(WER)+" hat keinen unterschriebenen Vertrag.\n");
    return 1;
  }
  if (geteuid(vertrag)!=geteuid(promoter))
  {
    tell_object(promoter,"Das geht nicht, er hat einen Vertrag von "+
	            capitalize(geteuid(vertrag))+" bei sich.\n");
    say(promoter->name(WER)+" versucht, "+who->name(WER)+" zum Magier zu "+
	    "machen, doch "+who->name(WER)+" hat einen Vertrag\nvon "+
		capitalize(geteuid(vertrag))+" bei sich.\n",promoter);
    return 0;
  }

  // Gods may promote ANYBODY.
  if (!IS_GOD(promoter))
    if (!QueryConditions(who,1))
      return 0;

  // Backup secure savefile.
  ptr = 0;
  from = sprintf("/secure/save/%c/%s.o", getuid(who)[0], getuid(who));
  to = sprintf("/secure/save/%c/%s.o.seer", getuid(who)[0], getuid(who));
  do {
    bytes = read_bytes(from, ptr, MAXLEN); ptr += MAXLEN;
    write_file(to, bytes);
  }
  while(strlen(bytes) == MAXLEN);

  // Backup savefile.
  ptr = 0;
  from = sprintf("/save/%c/%s.o", getuid(who)[0], getuid(who));
  to = sprintf("/save/%c/%s.o.seer", getuid(who)[0], getuid(who));
  do {
    bytes = read_bytes(from, ptr, MAXLEN); ptr += MAXLEN;
    write_file(to, bytes);
  }
  while(strlen(bytes) == MAXLEN);

  // Do promotion.
  ret=MASTER->advance_wizlevel(geteuid(who),10);

  // Everything's ok?
  if (ret > 0)
  {
    write_file("/log/game/SPONSOR",
        sprintf("[%s]: %s macht %s zum Learner (10).\n",
          ctime(), capitalize(getuid(promoter)), capitalize(getuid(who))));

    PARENTMASTER->SetParent(getuid(who), getuid(promoter));
    PARENTMASTER->SetChild(getuid(promoter), getuid(who));

    who->SetProp (P_START_HOME, "secure/merlin");
    PostMagier(who->name(WER),promoter->name(WER),who->QueryProp(P_GENDER));

    tmp = sprintf("%s ist nun Lehrling der Magie von %s!\n",
          capitalize(getuid(who)), capitalize(getuid(promoter)));
    "/obj/infomaster"->InfoMsg(tmp);

    if (MASTER->set_player_object(geteuid(who),"/std/shells/magier") <= 0)
    {
      say("Merlin sagt: Ich konnte Magiershell nicht einstellen.\n");
      write("Merlin sagt: Ich konnte Magiershell nicht einstellen.\n");
    }
    else
      MASTER->renew_player_object(who);
    return 1;
  }
  write("Merlin sagt: Irgendwie hat das nur "+ret+" ergeben.\n"
        "Merlin sagt: Frag mal einen Erzmagier, was das bedeutet!\n");
  say("Merlin sagt: Irgendwie hat das nur "+ret+" ergeben.\n"
      "Merlin sagt: Frag mal einen Erzmagier, was das bedeutet!\n");
}


void clear_flag()
{
  flag=0;
}


void do_say(string str)
{
  say(str);
}


int create_seer(mixed player)
{
  string playername, was;
  int ret, gender;

  if (!objectp(player)) return 0;
  if (IS_SEER(player)) 
  {
    tell_room (environment(), "Merlin sagt: Du bist doch schon kein "+
      "normaler Spieler mehr, was soll das also?\n");
    return 1;
  }

  // Gilde einverstanden?
  if (!("std/gilde"->seer_cond(1)))
  {
    tell_room (environment(), "Merlin sagt: Du erfuellst noch nicht alle "+
      "Bedingungen, um Seher zu werden!\n");
    if (!player->QueryProp(P_TESTPLAYER))
      return -1;
    tell_room (environment(), "Merlin sagt: Allerdings bist Du Testspieler, "+
      "da drueck ich mal ein Auge zu!\n");
  }

  // Sonstige Bedingungen erfuellt?
  if (!player->QueryProp(P_TESTPLAYER) && !(ret=QueryConditions(player,0)))
    return -1;

  // Dann: OK.
  tell_room (environment(), "Merlin sagt: Also gut, dann wollen wir mal...\n");
  if (MASTER->advance_wizlevel(geteuid(player),1)<=0)
  {
    tell_room (environment(), "Merlin flucht: Da geht was schief ... sag mal "+
      "Woody Bescheid, sag nur: "+ret+" ...\n");
    return -1;
  }

  playername = geteuid(player);
  MASTER->renew_player_object(player);
  player = find_player(playername);
  gender=player->QueryProp(P_GENDER);
  was = gender==FEMALE ? "eine Seherin" : "ein Seher";

  "std/gilde"->UpdateTitle(player->QueryProp(P_LEVEL), player);
  write("Merlin ruft: "+player->name(WER)+" ist jetzt "+was+" !\n");
  shout("Merlin ruft: "+player->name(WER)+" ist jetzt "+was+" !\n");

  if (!player->QueryProp(P_TESTPLAYER))
    PostSeher(player->name(WER), gender);

  return 1;
}


void reset()
{
  set_next_reset(300);  // alle 5 Minuten
  UpdateStats();
}


void wandern()
{
  mapping ex,rooms;
  mixed ziel;
  object *raeume,*laeden,env,ob;
  string *ind,fn;
  int i;
  
  while (remove_call_out("wandern")>=0);
  call_out("wandern",45+random(100));
  if (delay)
  {
    delay=0;
    return;
  }
  if (!(env=environment()))
  {
    move("/gilden/abenteurer",0);
	env=environment();
  }
  for(raeume=all_inventory(env);sizeof(raeume);raeume=raeume[1..])
    if (interactive(raeume[0]) && query_idle(raeume[0])<180 &&
	raeume[0]->QueryProp(P_XP)>999999)
      return;
  ex=env->QueryProp(P_EXITS);
  if (!mappingp(ex))
    return;
  ind=m_indices(ex);rooms=([]);laeden=({});
  for (i=sizeof(ind)-1;i>=0;i--)
  {
    if (!stringp(ziel=ex[ind[i]]))
      continue;
    if (!ob=find_object(ziel))
      continue;
    rooms+=([ob]);
  }
  rooms-=([env]);
  if (prev_room && sizeof(m_indices(rooms))>1)
    rooms-=([prev_room]);
  prev_room=env;
  raeume=m_indices(rooms);
  if (!i=sizeof(raeume)) {
    // Verloren? Nicht ganz!
    ex=env->QueryProp(P_SPECIAL_EXITS);
    ind=m_indices(ex);
    while ((environment()==env) && (i=sizeof(ind))) {
      command(fn=ind[random(i)]);
      ind-=({fn});
    }
    if (environment()==env)
      move("/gilden/abenteurer", 0);  // Sackgasse? -> Gilde.
  }
  else {
    ob=raeume[random(i)];
    move(ob,0);
  }
}


string int_short()
{
  return "Du bist im allseits beliebten Wizclub \"Zum lustigen Merlin\".\n";
}


string int_long(object who,mixed where)
{
  string descr;

  if( IS_LEARNER(who) && who->QueryProp( P_WANTS_TO_LEARN ) )
    descr = "[" + file_name(ME) + "]\n";
  else
    descr = "";
  descr+="Du bist im Wizclub 'Zum lustigen Merlin'. Dieser Wizclub ist etwas "
    "besonderes -\ner hat keinen festen Standort, sondern wandert im Mud "
    "herum. Ausserdem kann er\nSpieler zu Magiern machen - aber nur, wenn "
    "man ihn von aussen aus darauf\nanspricht.\n";
  if ( who->QueryProp(P_SHOW_EXITS) )
    descr += "Es gibt 2 sichtbare Ausgaenge: raus und gilde.\n";
  descr += (string)make_invlist(who, all_inventory(ME) - ({ who }));
  if( environment())
    descr += "Ausserhalb siehst Du:\n"
      + environment()->int_short(who,ME);
  return descr;
}


string make_invlist(object viewer,object *inv)
{
  int i, iswiz;
  string descr;

  descr = "";
  iswiz = IS_LEARNER( viewer ) && viewer->QueryProp(P_WANTS_TO_LEARN);
  
  for (i = 0; i < sizeof(inv); i++)
  {
    string sh;
    sh = inv[i]->short();
    if (iswiz)
    {
      if (sh) sh = sh[0..<2] + " ["+file_name(inv[i])+"]\n";
      else sh = "["+file_name(inv[i])+"]\n";
    }
    if (sh) descr += sh;
  }
  return descr;
}


void init()
{
  if (interactive(this_player()) && environment(this_player())==ME)
    add_action("gehen","",1);

  if (!IS_LORD(this_player())) return;
  add_action("befoerdere","befoerder");
  add_action("befoerdere","befoerdere");

  if (!IS_ARCH(this_player())) return;
  add_action("degradiere", "degradier");
  add_action("degradiere", "degradiere");
  add_action("spielerloeschung", "spielerloeschung");
}


int befoerdere(string str)
{
  string wen;
  int ret,stufe,l;

  if (!LORD_SECURITY) return 0;
  if (this_player() != this_interactive()) return 0;

  if (!str||sscanf(str,"%s auf stufe %d",wen,stufe)<2)
  {
    notify_fail("Syntax: befoerdere <name> auf stufe <stufe>\n");
    return 0;
  }
  if (stufe>45)
  {
    write("Maximum ist Stufe 45!\n");
    return 1;
  }
  if ((stufe>29) && !IS_ARCH(this_player()))
  {
    write("Maximum ist Stufe 29!\n");
    return 1;
  }
  l=query_wiz_level(wen);
  if (l<25)
  {
    printf("%s muss zwecks Weiterbefoerderung mindestens Stufe 25 haben.\n",
        capitalize(wen));
    return 1;    
  }
  if (l>=stufe)
  {
    printf("%s ist schon Stufe %d.\n",capitalize(wen),l);
    return 1;
  }
  // ret="secure/master"->advance_wizlevel(wen,stufe);
  ret=MASTER->advance_wizlevel(wen,stufe);
  if (ret<=0)
    printf("Errorcode %d.\n", ret);
  else {
    printf("Ok, %s auf Stufe %d befoerdert.\n", capitalize(wen), stufe);
    if (find_player(wen)) {
      tell_object (find_player(wen), sprintf(
        "Du wurdest von Merlin auf Stufe %d befoerdert.\n", stufe));
      "/obj/infomaster"->InfoMsg(sprintf(
        "%s wurde von Merlin auf Magierlevel %d befoerdert.\n",
        capitalize(wen), stufe));
      write_file("/log/game/SPONSOR",
          sprintf("[%s]: %s befoerdert %s auf Magierstufe %d.\n",
            ctime(), capitalize(getuid(this_player())), capitalize(wen), stufe));
    }
  }
  return 1;
}


int degradiere(string str)
{
  string wen;
  int ret,stufe,l;

  if (!ARCH_SECURITY) return 0;
  if (this_player() != this_interactive()) return 0;

  if (!str||sscanf(str,"%s auf stufe %d",wen,stufe)<2)
  {
    notify_fail("Syntax: degradiere <name> auf stufe <stufe>\n");
    return 0;
  }
  if (stufe<10)
  {
    write("Minimum ist Stufe 10!\n");
    return 1;
  }
  l=query_wiz_level(wen);
  if (l<=stufe)
  {
    printf("%s ist schon Stufe %d.\n",capitalize(wen),l);
    return 1;
  }
  if(l>=ELDER_LVL )
  {
    printf("%s kann so nicht degradiert werden!\n",capitalize(wen));
    return 1;
  }
  ret=MASTER->update_wiz_level(wen,stufe);
  if (ret<=0)
    printf("Errorcode %d.\n", ret);
  else {
    printf("Ok, %s auf Stufe %d degradiert.\n", capitalize(wen), stufe);
    if (find_player(wen)) {
      tell_object (find_player(wen), sprintf(
        "Du wurdest von Merlin auf Stufe %d degradiert.\n", stufe));
      "/obj/infomaster"->InfoMsg(sprintf(
        "%s wurde von Merlin auf Magierlevel %d degradiert.\n",
        capitalize(wen), stufe));
      write_file("/log/game/SPONSOR",
          sprintf("[%s]: %s degradiert %s auf Magierstufe %d.\n",
            ctime(), capitalize(getuid(this_player())), capitalize(wen), stufe));
    }
  }
  return 1;
}


int spielerloeschung(string str)
{
  object ob;
  string s1,s2;
  int silent;

  if (!IS_LEARNER(this_player())) return 0;
  if (!ARCH_SECURITY)
    return write("Security violation!\n"), 1;

  if (!stringp(str) || !strlen(str))
    return write("Syntax: spielerloeschung <spieler> [leise]\n"), 1;

  if (sscanf(str,"%s %s",s1,s2))
  {
    if (s1=="leise") str=s2;
    else if (s2=="leise") str=s1;
    else str="";
    if (!strlen(str))
      return write("Syntax: spielerloeschung <spieler> [leise]\n"), 1;
    silent=1;
  }
  else
    silent=0;

  if( ob=find_player(str) )
  {
    ob->remove();
    if(ob) destruct( ob );
  }
  if( ob=find_netdead(str) )
  {
    ob->remove();
    if(ob) destruct( ob );
  }

  if (MASTER->playerdel(str,silent))
    write("Ok, Spieler "+capitalize(str)+" wurde geloescht.\n");
  else
    write("Spieler "+capitalize(str)+" konnte nicht geloescht werden!\n");

  return 1;
}


nosave int sag(mixed str)
{
  int i;
  
  if (str==0)
    str="";
  str = explode(break_string(str, 60 ), "\n");
  for (i = 0; i < sizeof(str); i++)
  {
    if (!str[i])
      str[i]="";
    tell_room(environment(),"Merlin sagt: "+str[i]+"\n");
    tell_room(ME,"*Merlin sagt: "+str[i]+"\n");
  }
  return 1;
}


void show_exits()
{
  printf("%s",environment()->GetExits());
}


nosave int goto(mixed dest)
{
  object ob;
  string path;
  mixed ret;

  if (!dest) {
    write("Wohin moechtest Du Merlin bringen ?\n");
    return 1;
  }
  ob = find_living(dest);
  if (ob) {
    ob = environment(ob);
    move(file_name(ob),0);
    return 1;
  }
  path=(mixed) MASTER->_get_path(dest,getuid(this_player()));
  ret=catch(call_other(path,"?"));
  if (ret && file_size(path)<0)
  {
    dest=match_living(dest,1);
    if (stringp(dest))
    {
      ob = environment(find_living(dest));
      move(file_name(ob),M_TPORT|M_NOCHECK);
      return 1;
    }
    printf("Fehler beim Teleport nach %O: No such file.\n",path);
    return 1;
  }
  if (ret)
    printf("Fehler beim Teleport nach %O: %O\n",dest,ret);
  ret=catch(move(path,M_TPORT|M_NOCHECK));
  if (stringp(ret))
    ret=implode(explode(ret,"\n"),"");
  if (ret)
    printf("Fehler beim Teleport nach %O: %O\n",dest,ret);
  return 1;
}


nosave int gehen(string str)
{
  string verb;
  int i;
  mapping exits;
  string *ex;
  
  verb=query_verb();str=this_interactive()->_unparsed_args();
  switch (verb)
  {
    case "gilde":
      this_player()->move("/gilden/abenteurer",M_GO,"in die Gilde");
      return 1;
    case "raus":
      this_player()->move(environment(),M_GO,"raus");
      return 1;
  }
  if (!IS_WIZARD(this_interactive()))
    return 0;
  if (verb!="merlin")
    return 0;
  delay=1;
  exits=environment()->QueryProp(P_EXITS);
  if (!str||str=="")
  {
    ex=m_indices(exits);
    printf(environment()->int_short(ME,ME));
    show_exits();
    return 1;
  }
  if (explode(str," ")[0]=="sag")
    return sag(implode(explode(str," ")[1..]," "));
  if (str[0]==';')
  {
    tell_room(environment(ME),"Merlins "+str[1..]+"\n");
    tell_room(ME,"*Merlins "+str[1..]+"\n");
    return 1;
  }
  if (str[0]==':')
  {
    tell_room(environment(ME),"Merlin "+str[1..]+"\n");
    tell_room(ME,"*Merlin "+str[1..]+"\n");
    return 1;
  }
  if (str[0]=='*')
  {
    goto(str[1..]);
    printf(environment()->int_short(ME,ME));
    show_exits();
    return 1;
  }
  if (!exits[str])
    return 0;
  move(exits[str],0);
  write("Merlin sagt: Jawoll, Chef.\n");
  printf(environment()->int_short(ME,ME));
  show_exits();
  return 1;
}


object *locate_objects(string complex_desc, int info)
{
  object ob;
  
  if (complex_desc=="alles" || complex_desc=="alle")
    return filter_objects(all_inventory(this_object()),"short");
  if (ob = present(complex_desc,this_object()) )
    return ({ ob });
  return ({}) ;
}


void MBanishInsert(string name, string grund, object wer)
{
  if (!name || name=="" || !grund || grund=="")
    return;
  if (wer!=this_interactive())
    return;
  if (!wer||!objectp(wer)||!IS_ARCH(wer))
    return;
  MBanishListe += ([name:grund;getuid(wer)]);
  save_object(SAVEFILE);
}


void MBanishDelete(string name)
{
  if (!name || name=="")
    return 0;
  if (!IS_ARCH(this_interactive()))
    return 0;
  MBanishListe = m_delete(MBanishListe,name);
  save_object(SAVEFILE);
}

void SBanishInsert(string name, string grund, object wer)
{
  if (!name || name=="" || !grund || grund=="")
    return;
  if (wer!=this_interactive())
    return;
  if (!wer||!objectp(wer)||!IS_ARCH(wer))
    return;
  SBanishListe += ([name:grund;getuid(wer)]);
  save_object(SAVEFILE);
}


void SBanishDelete(string name)
{
  if (!name || name=="")
    return 0;
  if (!IS_ARCH(this_interactive()))
    return 0;
  SBanishListe = m_delete(SBanishListe,name);
  save_object(SAVEFILE);
}

string *QueryMBanish(string name)
{
  if (!member( MBanishListe, name ))
    return 0;
  return ({ MBanishListe[name,0], MBanishListe[name,1] });
}

string *QueryMBanished()
{
  return m_indices( MBanishListe );
}

string *QuerySBanish(string name)
{
  if (!member( SBanishListe, name ))
    return 0;
  return ({ SBanishListe[name,0], SBanishListe[name,1] });
}

string *QuerySBanished()
{
  return m_indices( SBanishListe );
}

varargs int Message(string msg, int flag)
{
  if (!ME->QueryProp(P_DEAF))
    tell_object( ME, msg );
}
