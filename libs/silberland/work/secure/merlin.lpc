	 ({({"deines","deiner"}),({"deines","deiner"}),({"deiner","deiner"})}),
	 ({({"dir","euch"}),({"dir","euch"}),({"dir","euch"})}),
	 ({({"dich","euch"}),({"dich","euch"}),({"dich","euch"})})
       })[casus][gender][zahl];
}


