
// string strmul( string str, int mul )
// returns string in mul occurences

string strmul( string str, int mul ) {
  int i;
  string tmp;

  tmp = "";
  if ( !str || !stringp( str ) )
    return tmp;
  for ( i = 0; i < mul; i++ )
    tmp += str;
  return tmp;
}

mixed min( mixed a, mixed b ) {
  return ( a < b ? a : b );
}

mixed max( mixed a, mixed b ) {
  return ( a > b ? a : b );
}

int abs( int a ) {
  return ( a < 0 ? -a : a );
}

