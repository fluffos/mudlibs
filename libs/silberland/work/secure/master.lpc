nosave mapping ip_map;

// Statistical data from _reset_fun().
nosave int nrresets;
nosave int timereset;
nosave int rmincost, rmaxcost, rsumcost;

// last READ_FILE entry
nosave string last_rf_log = "";

string *define_include_dirs() {
  return ({ "secure/%s" , "sys/%s", "room/%s" });
}


// -[funcs]-------------------------------------------------------------------

void flag(string str) {}

nosave void _reset_fun (object prev, object this)

// Handle the reset of an object.
//
// Argument:
//   prev:  object causing the reset
//   this:  reset object.
//
// Result:
//   The new reset interval to use for the object, 0 for the default interval.
//   This will be the value of P_RESET_INTERVAL of the object.
//
// The function mainly calls reset() in the given object, and does some
// statistical bookkeeping (results are written to /log/PROFILE).
// If the object does not selfdestruct, it's property P_LASTRESET is set
// to the current time and the function returns the value of P_RESET_INTERVAL.

{
  closure cl;
  int resetstart;
  int maxcost;

  // TODO: Extend the profiling onto create() and call_out() and whatever
  // TODO: Introduce a hb in master, taking care of the flushing.
  if (time() != timereset)
  {
    if (timereset)
    {
      log_file("PROFILE",
        sprintf("%s: RESET-STAT: %3d objs %6d ticks: %3d..%5'.'d..%6'.'d\n",
          ctime(timereset)[4..18], nrresets, rsumcost, rmincost,
          rsumcost / (nrresets || 1), rmaxcost));
        // Info: - Anzahl resettender Objekte
        //       - Summe der Kosten
        //       - min...average...max Kosten
    }
    timereset = time();
    rmincost = 1<<30;
    rmaxcost = 0;
    rsumcost = 0;
    nrresets = 0;
  }
  resetstart = time();
  maxcost = get_eval_cost();
  if (prev)
  {
    cl = bind_lambda(unbound_lambda(0, ({#'call_other, this, "reset", 0 })),
                     prev);
    funcall(cl);
  }
  else
    this->reset(0);

  if (!this)  // don't stumble over self-destructing objects
    return 0;

  maxcost = maxcost - get_eval_cost();
  if ( (maxcost > 5000) || (time() - resetstart) )
    log_file("PROFILE",
        sprintf("%s: RESET %6d (%1ds) %O\n",
          ctime(resetstart)[4..18], maxcost, time() - resetstart, this));

  if (maxcost > rmaxcost)
    rmaxcost = maxcost;
  if (maxcost < rmincost)
    rmincost = maxcost;
  rsumcost += maxcost;
  nrresets++;

  // this->Set(SP_LAST_RESET, time());
  // return (int)this->Query(SP_RESET_INTERVAL);
}


object connect() { // Einloggende Spieler landen hier
  string err;
  object ob,bp;

  printf(
    "HTTP/1.0 302 Found\nLocation: http://www.silberland.at/\n\n"
    "Connected by next layer GmbH since 28 Mar 2022.\n"
    "Local time: %s MET\n\n"
    "SilberLand LPmud, SilberLand Mudlib, NATIVE mode, driver version %s\n\n",
    ctime(time()),__VERSION__);

  /*
  write (
    "EMERGENCY CLOSING.\n---\n"
    "Due to severe problems, the mud will be down for some time.\n"
    "We try to do our best to get it up and running as soon as possible.\n"
    "Sorry for any inconvenience this causes to you. Please retry later!\n");
    return (object) 0;
  */

  if ((bp=find_object("/secure/login"))&&environment(bp)) catch(destruct(bp));
  err = catch(ob = clone_object("secure/login"));
  if (err) write("Fehler beim Laden von /secure/login.c\n"+err+"\n");
  return ob;
}

string get_master_uid()  {return ROOTID;}

string get_wiz_name(string file) {return creator_file(file);}

string *epilog(int eflag) {
  string *files, *domains;
  int i;
  
  seteuid(ROOTID);
  ReloadBanishFile();
  
  if (eflag) {
    write("-e angegeben -> Preloading unterdrueckt ...\n");
    return 0;
  }
  
  printf("Preloading gestartet: %s\n\n",ctime(time()));
  files=explode_files("/std/preload_file")+explode_files("/d/preload_file");
  domains=get_domains();
  for (i=sizeof(domains);i--;)
    files+=explode_files("/d/"+domains[i]+"/preload_file");
  write("\n");
  return files;
}

void preload(string file) {
  string err;
  string name;
  int *res, t1;
  
  if(!file || !file[0] || file[0] == ';' || file_size(file+".lpc") < 0) return;
  
  printf("%-50s",file);
  if (!(name=creator_file(file))) {
    write("\nno creator found for "+file+"\n");
    return;
  }
  printf("%-15s",name);
  if (!seteuid(name)) {
    write("\ncannot set euid to "+name+"\n"+"EUID is now "+geteuid(TO)+"\n");
    return;
  }
  res = rusage();
  t1 = res[0] + res[1];
  err = catch(call_other(file, "??"));
  if (err != 0) {
    write("\nGot error " + err + " when loading " + file + "\n");
  } else {
    res=rusage();
    t1=res[0]+res[1]-t1;
    printf("(%2d.%:02d s)\n",t1/1000,t1%1000);
  }
  seteuid(ROOTID);
}

#ifdef NEWUIDS
string creator_file(mixed str) {
  string *strs,tmp;
  int s;

  if(objectp(str))
    strs=full_path_array(file_name(str), 0);
  else if(stringp(str))
    strs=full_path_array(str, 0);
  else return NOBODY;
  
  s=sizeof(strs);
  if(s<2) return NOBODY;
  
  switch(strs[0])
  {
    case DOMAINDIR:
      if(s==2||!IS_LEARNER(strs[2]))
        if (file_size(strs[0]+"/"+strs[1])==-2)
          return "d."+strs[1];
        else
          return NOBODY;
      return sprintf("d.%s.%s", strs[1], strs[2]);

    case PROJECTDIR:
      if(s>2 && strs[1]=="service" && IS_LEARNER(strs[2]))
        return sprintf("p.%s.%s",strs[1],strs[2]);
      return "p."+strs[1];

    case WIZARDDIR:
      if (s>2)
        return strs[1];
      if (s==2 && file_size(strs[0]+"/"+strs[1])==-2)
        return strs[1];
      return NOBODY;

    case "secure":
      return ROOTID;
    case "gilden":
    case "spellbooks":
      tmp=strs[1];
      if (tmp[<2..<2]==".") tmp=tmp[0..<3];
      if ((s=member(tmp,'.'))>0) tmp=tmp[s+1..];
      return "GUILD."+tmp;
    case "room":
      return "room";
    case "std":
    case "obj":
      return BACKBONEID;
    case "doc":
      return "DOC";
    case "mail":
      return MAILID;
    case "news":
      return NEWSID;
  }
  return NOBODY;
}
#else
string creator_file(mixed str) {
  string *strs,tmp;
  int s;

  if(objectp(str))
    strs=full_path_array(file_name(str), 0);
  else if(stringp(str))
    strs=full_path_array(str, 0);
  else return NOBODY;
  
  s=sizeof(strs);
  if(s<2) return NOBODY;
  
  switch(strs[0])
  {
    case DOMAINDIR:
      if(s==2||!IS_LEARNER(strs[2])) 
        return strs[1];
      return strs[2];
    case PROJECTDIR:
      if(s==2||!IS_LEARNER(strs[2])) 
        return "p:"+strs[1];
      return strs[2];
    case WIZARDDIR:
      {
      if (s>2)
        return strs[1];
      if (s==2 && file_size(strs[0]+"/"+strs[1])==-2)
        return strs[1];
      return NOBODY;
      }
    case "secure":
      return ROOTID;
    case "gilden":
    case "spellbooks":
      tmp=strs[1];
      if (tmp[<2..<2]==".") tmp=tmp[0..<3];
      if ((s=member(tmp,'.'))>0) tmp=tmp[s+1..];
      return "GUILD."+tmp;
    case "std":
    case "room":
    case "obj":
      return BACKBONEID;
    case "doc":
      return "DOC";
    case "mail":
      return MAILID;
    case "news":
      return NEWSID;
    case "event":
      return "EVENT";
  }
  return NOBODY;
}
#endif


// Reset-Intervall, Logfile-Rotation
#define RESETINT   3600                      // jede Stunde
#define LOGROTATE  (24*2)                    // alle 48h
#define LOGFILEAGE (RESETINT*LOGROTATE)      // alle 2 tage wechseln
#define LOGNUM     3                         // Anzahl der Logfiles

nosave int logrotate_counter; //READ_FILE alle LOGROTATE Resets rotieren

void reset()
{
  int ti;
  string *date;
  object simul_efun;

  if (TI||TP) return;           // don't call manually
  set_next_reset(RESETINT);     // next reset (hourly interval)

  _cleanup_uinfo();             // clean up userinfo cache
  _cleanup_projects();          // clean up project cache

  if (!objectp(simul_efun=find_object(SIMUL_EFUN_FILE))) return;

  // Wenn Zeit abgelaufen, dann READ_FILE-Log rotieren
  if (!logrotate_counter--)
  {
    ti = time() / LOGFILEAGE;
    date = get_dir(sprintf("%s.%d", READ_FILE, ti % LOGNUM), 4);
    if (pointerp(date) && sizeof(date) &&
        (to_int(date[0]) / LOGFILEAGE) == ti) return;
    if (file_size(READ_FILE) > 0)
      rename(READ_FILE, sprintf("%s.%d", READ_FILE, ti % LOGNUM));
    logrotate_counter = LOGROTATE;
  }

  mailread();                   // process inbound (external) mails

  return;
}


mixed read_deny(string *p_arr, string euid)
{
  int i;

  i=sizeof(p_arr)-2;
  while (i>=0 && file_size(implode(p_arr[0..i],"/")+"/read_deny.lpc")<0) i--;
  if (i<0) return 0;
  if (!catch(i=call_other(implode(p_arr[0..i],"/")+"/read_deny",
			  "read_deny",euid,implode(p_arr[i+1..],"/"), p_arr)));
    return i;
  return 0;
}


// access_rights - klappert den Pfad Richtung root nach access_rights.c ab
// readflag sagt, dass nach Leserechten gefragt wird.
// def legt den Defaultwert fest.
varargs int access_rights(string *p_arr, string euid,
                          int readflag, int def, string fun)
{
  int i;

  i=sizeof(p_arr)-2;
  while (i>=0 && file_size(implode(p_arr[0..i],"/")+"/access_rights.lpc") < 0)
    i--;
  if (i<0) return def;
  if (catch(i=call_other(
          implode(p_arr[0..i],"/")+"/access_rights", "access_rights",
          euid, implode(p_arr[i+1..],"/"), readflag, def, fun)))
    return def;
  return i;
}


#ifdef NEWUIDS
mixed valid_read(string path, string euid, string fun, object obj)
{
  int s, lev;
  string *strs, suf;

  if (member(path,' ')!=-1) return 0;

  if (!euid) euid="-";

  strs=full_path_array(path, euid);
  path=implode(strs, "/");

  if (!sizeof(strs) || !strlen(path) || euid == ROOTID || obj==TO)
    return path;

  if ((s=sizeof(strs)) <= 1)
    if (strs[0]=="core" || strs[0]=="wahl" || strs[0]=="news")
      return 0;
    else
      return path;

  lev=query_wiz_level(euid);

#ifdef DEBUG_NEWUIDS
  if (this_interactive() && this_interactive()->QueryProp("debug"))
    DEB(sprintf(ANSI_RED+"valid_read()"+ANSI_NORMAL+
          ": path: %O\n  euid: %O [%d]  obj: %O::%s\n",
          path,euid,query_wiz_level(euid),obj,to_string(fun)));
#endif

  switch(strs[0]) {
    case "core":
    case "wahl":
    case "news":
      return 0;

    case "":
    case "etc":
    case "std":
    case "sys":
    case "doc":
    case "obj":
    case "room":
    case "open":
    case "www":
      return path;

    case "mail":
      if (euid==MAILID) return path;                    // Mailer OK
      if (s==2 && file_size(path)!=-2) return path;     // 1. Verz.-Ebene OK
      return IS_ARCH(euid) && path[<2..]!=".o" && path; // Erzis nur .o nicht

    case "secure":
      if (strs[1]=="save" || strs[1]=="save_inactive") return 0;
      if (path[<2..]==".o" || path[<5..]==".dump") return 0;
      if (strs[1]=="ARCH" && lev < ARCH_LVL) return 0;
      if (strs[1]=="LORD" && lev < LORD_LVL) return 0;
      return path;

    case "log":
      if ( strs[1]=="ARCH" )
          return lev>=ARCH_LVL && path;

      // Keine Forscherpunkt-Reporte an Nicht-Erzis
      if ( s==3 && strs[1]=="report" && strs[2][<3..]==".ep" )
          return lev>=ARCH_LVL && path;

      // Als Nicht-Lehrling sonst alles erlaubt
      if ( lev>=INACTIVEWIZ_LVL )
          return path;

      // Ab hier fuer Magier < INACTIVEWIZ_LVL
      if ( strs[1]=="report" )
          return path;

      // Duerfen nichts ausser dem /log/report/ Verzeichnis einsehen
      return 0;

    case "save":
      // Lords sind trusted
      if (lev>=LORD_LVL) return path;

      // Ausnahmen
      if (euid[0..1]=="p.") return path;        // v.a. fingerd und fwserv
      if (euid[0..5]=="GUILD.") return path;    // die Gilden duerfen
      if (fun=="file_size") return path;        // Existenzpruefung
      if (s==3 && strs[2][<2..]==".o" &&
          fun=="get_dir") return path;          // Letztloginabfrage

      if (s==3 && (strs[2]==euid+".o" || strs[2]==euid))
        return path;

      // Prinzipiell jedenfalls NICHT erlaubt
      return 0;

    case PROJECTDIR:
      // Lords sind trusted, ausserdem impliziert Schreibrecht Leserecht
      if (lev>=LORD_LVL || project_access(euid,strs[1]))
        return path;

      // Objekte eines Projektes haben Lesezugriff auf ihr Projekt
      if (s>2 && implode(strs[0..1], ".")==euid) return path;

      // in den Serviceverzeichnissen muss lediglich der Name stimmen
      if (s>3 && strs[1]=="service" &&
          (euid==strs[2] || euid=="p.service."+strs[2])) return path;

      // Sonst entscheidet access_rights
      return access_rights(strs,euid,1,(lev>WIZARD_LVL),fun) ? path : 0;

    case "gilden":
    case "spellbooks":
      // Gilden(objekte) selbst duerfen lesen
      if (euid[0..4]=="GUILD")
        return path;
      // Ausnahme fuer den infolibd
      if (euid=="p.daemon" && path[<4..]==".lib")
        return path;
      // Lords sind trusted
      if (lev>=LORD_LVL)
        return path;
      // Kleine Magier sind untrusted
      if (lev<WIZARD_LVL)
        return 0;
      // doc/ Verzeichnis ist OK
      if (strs[1]=="doc")
        return path;
      // Vollmagier je nach access_read(), default: OK, sonst default: 0
      return access_rights(strs,euid,1,(lev>=FULLWIZ_LVL),fun) ? path : 0;

    case WIZARDDIR:
      if (s==2) return path;
      // das eigene Verzeichniss darf man natuerlich immer lesen...
      if (strs[1]==euid) return lev>=LEARNER_LVL ? path : 0;

      // Pruefen ob ein File existiert darf jeder...
      if (fun=="file_size") return path;

      // Mailer darf .mailrc lesen...
      if (s==3 && euid==MAILID && strs[2]==".mailrc") return path;

      // fremde Verzeichnisse mit < Level 15 noch nicht
      if (lev<INACTIVEWIZ_LVL) return 0;

      // Lords sind trusted
      if (lev>=LORD_LVL) return path;

      // Legt access_rights() Veto ein?
      if (!access_rights(strs,euid,1,1,fun)) return 0;

      // folgende Funktionen sind natuerlich voellig uninteressant
      if (member(({"get_dir","restore_object","read_file_test"}),fun)!=-1)
        return path;

      // Nur Nicht-Daemons und Dateien mit Inhalt sind relevant
      if (euid=="p.daemon" || file_size(path) <= 0) return path;

      // wenn Zugriff erlaubt, mitloggen
      if (last_rf_log != sprintf("%O %s %s", fun, euid, path)) {
        last_rf_log = sprintf("%O %s %s", fun, euid, path);
        write_file(READ_FILE,
            sprintf("%O %s %s: %s\n", fun, ctime()[4..], euid, path));
      }
      return path;

    case DOMAINDIR:
      // den Verzeichnisbaum von /d/ darf man natuerlich lesen
      if (s<=2) return path;

      // offenes Domain-Verzeichnis fuer Beispielcode, etc.
      if (strs[1]=="open") return path;

      // eigenen Code darf man natuerlich lesen
      if (euid==strs[2] ||
          euid==sprintf("d.%s", strs[1]) ||
          euid==sprintf("d.%s.%s", strs[1], strs[2]))
         return path;

      // Daemons+death_room duerfen auch lesen (insbesondere der libmaster)
      if (euid=="p.daemon" || euid=="room") return path;

      // Existenztests und .readme sind immer erlaubt...
      if (strs[<1]==".readme" || fun=="file_size" || fun=="get_dir")
        return path;

      // Mit Level <25 darf man noch keinen fremden Code lesen!
      if (lev<DOMAINMEMBER_LVL) return 0;

      // Lords sind trusted
      if (lev>=LORD_LVL) return path;

      // Legt access_rights() Veto ein?
      if (!access_rights(strs,euid,1,
            (file_size(sprintf("/d/%s/%s",strs[1],euid))==-2),fun))
        return 0;

      // folgende Funktionen sind natuerlich voellig uninteressant
      if (member(({"get_dir","restore_object","read_file_test"}),fun)!=-1)
        return path;

      // Nur Dateien mit Inhalt sind relevant
      if (file_size(path) <= 0) return path;

      // wenn Zugriff erlaubt, mitloggen
      if (last_rf_log != sprintf("%O %s %s", fun, euid, path)) {
        last_rf_log = sprintf("%O %s %s", fun, euid, path);
        write_file(READ_FILE,
            sprintf("%O %s %s: %s\n", fun, ctime()[4..], euid, path));
      }
      return path;
  }
  if (lev<ARCH_LVL) return 0;
  return path;
}
#else
mixed valid_read(string path, string euid, string fun, object obj) {
  string *strs;
  int s;
  string nuid, suf;
 
  if (member(path,' ')!=-1)
    return 0;
 
  if (TI)
    nuid=getuid(TI);
  else
    nuid="-";
 
  if(!euid) euid="-";
 
  strs=full_path_array(path, euid);
  path=implode(strs, "/");

  if(!sizeof(strs) || !strlen(path) || euid == ROOTID || obj==TO) return path;

  if (strs[0] == "mail" && euid == MAILID) return path;

  if(sizeof(strs)>1)
  {
    switch (strs[0])
    {
      // "/wahl/..." fuer NIEMANDEN lesbar
      case "wahl": return 0;
      // "/news/"
      case "news": if (strstr(strs[<1],"erzmagier")!=-1 && !IS_ARCH(euid))
                     return 0;
                   if (strstr(strs[<1],"regionsmagier")!=-1 && !IS_LORD(euid))
                     return 0;
                   break;
      // "/secure/save/" und "/secure/save_incative/" fuer NIEMANDEN lesbar
      // "/secure/LORD/" bzw. "ARCH/" nur fuer Regions-/Erzmagier lesbar
      case "secure": if (member((["save","save_inactive"]),strs[1])) return 0;
                     if (strs[1]=="ARCH" && !IS_ARCH(euid)) return 0;
                     if (strs[1]=="LORD" && !IS_LORD(euid)) return 0;
                     break;
      // "/log/ARCH/" und "/log/report/*.ep" nur fuer Erzmagier lesbar
      case "log": if ((strs[1]=="ARCH" || (sizeof(strs)==3 &&
                      strs[1]=="report" && strs[2][<3..]==".ep"))
                      && !IS_ARCH(euid)) return 0;
                  else return path;
      case "mail": if (strs[1]=="spool") return path;
                   if (sizeof(strs)>2 &&
                       strs[2]!=euid+".o" && strs[2] != euid &&
                       strs[2]!=nuid+".o" && strs[2] != nuid && !IS_ARCH(euid))
                     return 0;
                   else return path;
                   break;
      case "open": if(strstr(strs[1],".mail") != -1 && strs[1] != euid+".mail")
                     return 0;
                   if(sizeof(strs)>2 && strs[1] == "News" &&
                      (strstr(strs[2],".news") != -1 && strs[2] != euid+".news"))
                     return 0;
                   break;
    }
  }
  if (sizeof(strs)==1 && strs[0]=="core") return 0;

  if (strs[0]=="gilden" || strs[0]=="spellbooks")
    if (!IS_ARCH(euid) && read_deny(strs,euid))
      return 0;
    else
      return path;

  // LEARNER Beschraenkungen
  if (((s=query_wiz_level(euid)) >= LEARNER_LVL) && (s < WIZARD_LVL))
  {
    switch (strs[0]) {
      case "*": case "":
      case "std": case "sys": case "secure": case "doc":
        return path;
      case "save":
        if (sizeof(strs) == 3 && (strs[2] == euid+".o" || strs[2] == euid))
          return path;
        else
          return 0;
      case WIZARDDIR:
        if (sizeof(strs) >= 2 && strs[1] == euid)
          return path;  // else fall-thru
      case DOMAINDIR:
      case PROJECTDIR:
      case "room":
      case "event":
        if ((suf=strs[<1][<2..]) == ".lpc" || suf == ".h")
          return 0;
        break;
      default: return 0;
    }
  }
  return path;
}
#endif


#ifdef NEWUIDS
mixed valid_write(string path, string euid, string fun, object obj) {
  int s;
  string *strs, *euids;
  mixed date;

#ifdef DEBUG_NEWUIDS
  if (this_interactive() && this_interactive()->QueryProp("debug"))
    DEB(sprintf(ANSI_RED+"valid_read()"+ANSI_NORMAL+
          ": path: %O\n  euid: %O [%d]  obj: %O::%s\n",
          path,euid,query_wiz_level(euid),obj,to_string(fun)));
#endif

  // Namen mit Leerzeichen sind mal prinzipiell tabu.
  if (member(path,' ')!=-1) return 0;

  switch(fun) {
    case "log_file":
      strs=full_path_array("/"+path, 0);
      if (sizeof(strs)>1 && strs[0]=="log") return implode(strs,"/");
      return 0;
    case "save_object":
      if (!path) return 0;
      strs=full_path_array("/"+path, 0);
      break;
    case "ed_start":
      if (path && path[0])
        strs=full_path_array(path, euid);
      else strs=({"players",euid,".err"});
      break;
    default:
      strs=full_path_array(path, euid);
  }

  if (!euid || euid=="NOBODY" || euid=="ftp" || euid=="anonymous")
    return 0;

  path=implode(strs, "/");

  if (euid == ROOTID || obj==TO) return path;

  if ((s=sizeof(strs))<=1) return IS_ARCH(euid);

  switch(strs[0])
  {
    /*
    case "sys":
    case "wahl":
    case "secure":
    case "news":
      return 0;         // ist ohnehin default -> Rechenzeit sparen
    */

    case "std":
    case "obj":
    case "etc":
    case "room":
      // Erzmagier only
      return IS_ARCH(euid) && path;

    case "spellbooks":
    case "gilden":
      // Gildenobjekte duerfen ihre eigenen Files schreiben
      if (euid==sprintf("GUILD.%s",strs[1])) break;
      // Erzmagier only, fuer Magier kann aber Zugriff gewaehrt werden
      if (IS_ARCH(euid)) break;
      if (IS_WIZARD(euid)) return access_rights(strs,euid,0,0,fun) && path;
      return 0;

    case "doc":
      // eine Aufgabe fuer Magier mit besonderen Aufgaben
      return (IS_SPECIAL(euid) || access_rights(strs,euid,0,0,fun));

    case "open":
      // fuer Allgemeinheit nur Upload- und tmp-Verzeichnis und news dumpfile
      if ( s > 1 && (strs[1]=="incoming" || strs[1]=="tmp" ||
                     (s == 3 && strs[1]=="News" && strs[2]==euid+".news") ) )
        return 1;
      // Sonst erst ab Weiser beschreibbar
      return IS_ELDER(euid) && path;

    case "mail":
      // Ausschliesslich Mailer, Erzmagier nur auf nicht-Savefiles
      if (euid==MAILID || strs[1]=="spool") break;
      if (IS_ARCH(euid) && path[<2..]!=".o") break;
      return 0;

    case "save":
      // Ausschliesslich save_object auf eigenes Savefile (Ausnahme: Erzies)
      if (IS_ARCH(euid)) return 1;
      if (s==3 && strs[1] == euid[0..0] && 
          (strs[2]==euid+".o" || strs[2]==euid) &&
          fun=="save_object") break;
      return 0;

    case "log":
      // auf /log/ARCH/ haben wirklich nur EMs Zugriff
      if (strs[1]=="ARCH" && !IS_ARCH(euid))
        return (fun == "write_file");

      // alles andere duerfen auch Weise...
      if (IS_ELDER(euid)) break;

      // Allgemeine Logs in /log/ duerfen wirklich nur geschrieben werden
      if (s<=3 && strs[<1][0]>='A' && strs[<1][0]<='Z' && fun!="write_file")
        return 0;

      euids = efun::explode(euid, ".");
      // loggen ins eigene repfile immer erlauben
      if (s==3 && strs[1]=="report" && strs[2]==euids[<1]+".rep")
        break;

      // ebenso in die domain log dirs
      if (s==4 && strs[1]=="report" && sizeof(euids)>=2 &&
          strs[2]==euids[1] && (explode(strs[3],".")[0]==euids[<1]) )
        break;

      // in fremden Verzeichnissen hat niemand was zu loggen
      if (s>=3 && strs[1]=="wiz" &&
          get_wiz_level(strs[2]) >= WIZARD_LVL && strs[2] != euids[<1])
         return access_rights(strs,euid,0,0,fun);

      break;

    case WIZARDDIR:

/* ACHTUNG! Nur fuer eine kurze Uebergangszeit drin!!! ***********************/
      euids = efun::explode(euid, ".");
      if (objectp(obj) && euids[<1]==strs[1] &&
          euids[0]=="d" && sizeof(date=get_dir(file_name(obj)+".lpc", 4)) &&
          date[0] <= 981932400 && strs[<1][<2]!='.')    // 12.2.2001
      {
         write_file(sprintf("/log/error/%s.uid", efun::explode(euid, ".")[<2]),
                  sprintf("[%s] %O\n%O %s\n", ctime(), obj, fun, path));
         break;
      }
/* ab hier wieder normal... **************************************************/

      // Aus Prinzip nie Zugriff auf Objekte mit hoeheren Rechten!
      if (query_wiz_level(strs[1]) > query_wiz_level(euid)) return 0;

      // Magier selbst oder Weise duerfen hier schreiben
      if (IS_ELDER(euid) || (IS_INACTIVEWIZ(euid) && euid==strs[1])) break;

      // Der Sponsor darf im Verzeichnis seiner 21er Sproesslinge SCHREIBEN!
      if (query_wiz_level(strs[1])==21 &&
          query_wiz_level(euid)>=FULLWIZ_LVL &&
          PARENTMASTER->GetParent(strs[1])==euid)
        break;

      // Es steht jedoch frei, auch anderen Schreibrechte zu geben...
      return access_rights(strs,euid,0,0,fun) && path;
    
    case "www":  
    case DOMAINDIR:
      // neue Regionen duerfen nur Erzmagier anlegen
      if (s<2 && !IS_ARCH(euid)) return 0;

      // Aus Prinzip nie Zugriff auf Objekte mit hoeheren Rechten!
      if (s>2 && query_wiz_level(creator_file(path)) > query_wiz_level(euid))
         return 0;

      // innerhalb der Region haben RMs und Weise volle Schreibrechte
      if (IS_ELDER(euid) || domain_master(euid,strs[1])) break;

      // neue Verzeichnisse in der Region kann nur RM+ anlegen
      if (s<=3 && (fun=="mkdir" || fun=="rmdir")) return 0;

      // Magier auf ihre eigenen Files...
      if (s>2 && strs[2]==euid) break;

      // Files der Magier in der Region in ihre eigenen Verzeichnisse...
      if (s>2 && euid==sprintf("d.%s.%s", strs[1], strs[2])) break;

      // Files mit Regions-UID
      if (euid=="d."+strs[1]) break;

      // Es ist moeglich, anderen Magiern Rechte bei sich einzuraeumen.
      if (access_rights(strs,euid,0,0,fun)) break;

      return 0;

    case PROJECTDIR:
      // Nur Erzmagier duerfen neue Projektverzeichnisse anlegen...
      if (s<3 && !IS_ARCH(euid)) return 0;

      // alles weitere duerfen auch Weise tun
      if (IS_ELDER(euid)) break;

      // Objekte eines Projektes haben Schreibzugriffe auf ihr Projekt
      if (s>3 && (implode(strs[0..1], ".")==euid ||
            implode(strs[0..2], ".")==euid))
        break;

      // in den serviceverzeichnissen muss lediglich der Name stimmen
      if (s>3 && strs[1]=="service" && euid==strs[2]) break;

      // An den Schreibrechten duerfen nur Berechtigte was aendern.
      if (s==3 && strs[2]=="ACCESS_RIGHTS")
        if (project_access(euid,strs[1])>1)
          break;
        else
          return 0;

      // Schreibrechte auf alles andere je nach Zugriff.
      if (project_access(euid,strs[1])) break;
      if (access_rights(strs,euid,0,0,fun)) break;
      return 0;

    default: return 0;
  }
  return path;
}
#else
mixed valid_write(string path, string euid, string fun, object obj) {
  string *strs;
  int s;
  int x;
  string *pn;

  if (member(path,' ')!=-1)
    return 0;

  if (fun=="log_file")
  {
    strs=full_path_array("/"+path, 0);
    if (sizeof(strs)>1 && strs[0]=="log") return implode(strs,"/");
  } 
  if(!euid || euid=="NOBODY" || euid=="ftp" || euid=="anonymous") return 0;
  
  switch(fun) {
    case "save_object":
    if(!path) return 0;
    strs=full_path_array("/"+path, 0);
    break;
    case "ed_start":
    if(path && path[0])
      strs=full_path_array(path, euid);
    else
      strs=({"players",euid,".err"});
    break;
    default:
    strs=full_path_array(path, euid);
  }

  path=implode(strs, "/");
  if(euid == ROOTID || obj==TO) return path;

  s=sizeof(strs);
  if(s>1)
  {
    switch(strs[0])
    {
      case "wahl":
      case "secure":
      case "news":
      case "quests":
        return 0;

      case "ftp":
      case "open":
      case "tmp":
        return 1;

      case "sys":
      case "std":
      case "spellbooks":
      case "gilden":
      case "event":
        return (IS_ARCH(euid) || access_rights(strs,euid)) && path;

      case "doc":
        return (IS_SPECIAL(euid) || access_rights(strs,euid)) && path;

      case "mail":
        if (euid==MAILID || strs[1]=="spool")
          break;

      case "save":
        if(IS_ARCH(euid)) return 1;
        if(s != 3) return 0;
        if(extern_call() && 
           ((!TP || PO != TP) && 
            (geteuid(PO)!=getuid(PO) || geteuid(PO)!=euid)))
          return 0;
        if(strs[1] == euid[0..0] && (strs[2] == euid || strs[2]==euid+".o"))
          break;
        return 0;

      case PROJECTDIR:
        if(s<3&&!IS_ARCH(euid)) return 0;
        if(IS_ELDER(euid)) break;
        if (objectp(obj))
          pn=explode(file_name(obj),"/");
        else
          pn=({});
        if (sizeof(pn)>2 && s>3 && strs[0]+":"+strs[1]==euid)
          return 1;
        if(s==3&&strs[2]=="ACCESS_RIGHTS")
          if(project_access(euid,strs[1])>1)
            break;
          else
            return 0;
        if(s>3&&euid==strs[2]) break;
        if(project_access(euid,strs[1])) break;
        return access_rights(strs,euid) && path;

      case DOMAINDIR:
        if (IS_ARCH(euid) || (s>2 && IS_ELDER(euid))) break;
        if (s<2) return 0;
        if (s>2&&IS_ARCH(strs[2])) return 0;
        if (domain_master(euid,strs[1])) break;
        if (s==2) return 0;  // In /d/ selbst darf sonst keiner schreiben
        if (euid==strs[1]) break;
        if (s<=3 && (fun=="mkdir"||fun=="rmdir")) return 0;
        // if (s==2) return domain_master(euid,strs[1]);  // Eher unnoetig...
        if (strs[2]==euid || 
            ((strs[2]=="common" || strs[2]=="alle") &&
             domain_member(euid, strs[1])))
          break;
        if (euid==strs[2]) break;
        return access_rights(strs,euid) && path;

      case "log":
        if (sizeof(strs)==2 && (strs[1][0]<='Z' && strs[1][0]>='A'))
        {
          if (!IS_ARCH(euid) && fun != "write_file" && fun != "log_file") 
            return 0;
        }
        else
          break;

      case WIZARDDIR:
        if (IS_ARCH(euid)) break;
        if (s>2 && IS_ELDER(euid)) break;
        if (IS_WIZARD(euid) && euid==strs[1]) break;
        return access_rights(strs,euid) && path;

      default:
        return IS_ARCH(euid);
    }
    return path;
  }
  return IS_ARCH(euid);
}
#endif


int valid_seteuid(object ob, string neweuid) {
  if (ob==this_object() ||
      getuid(ob) == ROOTID || getuid(ob) == neweuid ||
      creator_file(file_name(ob)) == neweuid)
    return 1;
  return 0;
}

string get_simul_efun() {
  if(!catch(call_other(SIMUL_EFUN_FILE, "start_simul_efun")))
    return SIMUL_EFUN_FILE;
  write("Failed to load " + SIMUL_EFUN_FILE + "\n");
  if(!catch(call_other(SPARE_SIMUL_EFUN_FILE, "start_simul_efun")))
    return SPARE_SIMUL_EFUN_FILE;
  write("Failed to load " + SPARE_SIMUL_EFUN_FILE + "\n");
  efun::shutdown();
  return 0;
}

int valid_trace(object player, int trace_lvl) {
  return IS_WIZARD(player);
}

string make_path_absolute(string str) {
  return _get_path(str, TP ? getuid(TP) : getuid(PO));
}

int query_allow_shadow(object ob) {
	string f;

  if (ob==TO)
    return 0;
  if(getuid(ob) == ROOTID)
    return 0;
	f=explode(file_name(ob),"#")[0];
	if (f[-14..]=="/access_rights") return 0;
  return !(int)ob->query_prevent_shadow(PO);
}

string get_ed_buffer_save_file_name(string file) {
  string *file_ar;
  
  file_ar=efun::explode(file, "/");
  file=file_ar[sizeof(file_ar)-1];
  return "/players/"+getuid(TP)+"/.dead_ed_files/"+file;
}

int query_player_level(string what) {
  if(!TP) return 0;
  switch(what) {
    case "wizard":
    case "trace":
    return IS_ELDER(TP);
    case "error messages":
    return IS_INACTIVEWIZ(TP);
  }
  return 0;
}

int log_error(string file,string message) {
  string lfile;
  string cr;
  
  cr=creator_file(file);
  if (!cr)
    cr="NOBODY";
  if (cr==ROOTID)
    lfile="/log/error/ROOT.err";
  else if (member(cr,' ')!=-1)
    lfile="/log/error/STD.err";
  if (!lfile)
  {
    if (!cr)
      lfile="/log/error/SYSERROR";
    else if (file_size("/players/"+cr) == -2)
      lfile = "/players/"+cr+"/.err";
    else if (file_size("/d/"+cr) == -2)
      lfile = "/d/"+cr+"/.err";
    else
      lfile="/log/error/"+cr+".err";
  }
  write_file(lfile,message);
  if (IS_LEARNER(TI))
    write(message);
  return 1;
}

void runtime_error(string err ,string prg, string curobj, int line) {
  string code;
  int flag;
  string mkzmsg;
  object ob;

  // Nur "echte" Fehler behandeln.
  if (previous_object(0)) return;

  if (!stringp(err)) err="<NULL>";
  if (!stringp(prg)) prg="<NULL>";
  if (!stringp(curobj)) curobj="<NULL>";
  if (TI) mkzmsg=getuid(TI);
  mkzmsg=sprintf("Fehler: %O, Objekt: %s, Programm: %O, Zeile %O (%s)",
                 err[0..<2], curobj, (prg[0]!='<'?"/":"")+prg, line,
                 capitalize(mkzmsg||"<Unbekannt>"));

  if ( TI && (IS_LEARNER(TI) || TI->QueryProp(P_TESTPLAYER)) )
    DEBUG2_MSG(mkzmsg);
  else
    DEBUG_MSG(mkzmsg);

  if(!TI)
    return;

  if(flag=query_player_level("error messages")) {
    write("------------------------------------------------------------------------------\n"+
          "file: "+prg+" line: "+line+" object: "+curobj+"\n");
    if(prg && code=read_file("/"+prg, line, 1))
      write("\n"+code+"\n");
    write("error: "+err+
          "-----------------------------------------------------------------------------\n");
  }
  else
    write("Du siehst einen Fehler im Raum-Zeit-Gefuege.\n");
  if (err=="Object the closure was bound to has been destructed\n")
  {
    ob=find_object(curobj);
    if (ob && IS_LEARNER(ob) && query_once_interactive(ob))
    {
      ob->quit();
      if (ob)
	ob->remove();
      if (ob)
	destruct(ob);
    }
  }
}

int valid_exec(string name) {return 1;}

int save_ed_setup(object who, int code) {
  string file;
  
  if (!intp(code))
    return 0;
  file = "/players/" + geteuid(who) + "/.edrc";
  rm(file);
  return write_file(file, code + "");
}

int retrieve_ed_setup(object who) {
  string file;
  int code;
  
  file = "/players/" + getuid(who) + "/.edrc";
  if (file_size(file) <= 0)
    return 0;
  sscanf(read_file(file), "%d", code);
  return code;
}

void destruct_environment_of(object ob) {
  if (!query_once_interactive(ob) && file_name(ob)[0..10]!="/std/shells")
    return;
  tell_object(ob,
      "Ploetzlich loest sich Deine Welt in ihre Bestandteile auf.\n"
      "Zum Glueck wirst Du irgendwo hin geschleudert...\n");
  if(catch(ob->move("/room/void",M_TPORT|M_NOCHECK,0,"faellt")) && ob)
    destruct(ob);
}

void move_or_destruct(object what, object to) {
  object old_env;
  
  old_env=environment(what);
  if(catch(what->move(to, M_NOCHECK)))
    destruct(what);
  else if (what && environment(what)==old_env)
    destruct(what);
}

mixed prepare_destruct(object ob) {
  object super;
  mixed *errors;
  int i;
  
  if (!ob)
    return 1;
  super = environment(ob);
  if (!super) {
    object item;
    
    while ( item = first_inventory(ob) ) {
      destruct_environment_of(item);
      if (item && environment(item) == ob) destruct(item);
    }
  } else 
    while ( first_inventory(ob) )
      move_or_destruct(first_inventory(ob), super);
  return 0; /* success */
}

