// WIZLIST
nosave void wiz_decay() {
  mixed *wl;
  int i;

  wl = wizlist_info();
  for (i=sizeof(wl); i--; ) {
    set_extra_wizinfo(wl[i][WL_NAME], wl[i][WL_EXTRA] * 99 / 100);
  }
  call_out("wiz_decay", 3600);
}

void save_wiz_file() {
  rm("/WIZLIST");
  write_file(
	     "/WIZLIST",
	     implode(
		     map_array(wizlist_info(),
			       lambda(({'a}),
				      ({#'sprintf, "%s %d %d\n",
					({#'[, 'a, WL_NAME}),
					 ({#'[/*]*/, 'a, WL_COMMANDS}),
					  ({#'[/*]*/, 'a, WL_EXTRA})
#ifdef __EMACS__NERV__
					   ]]]
#endif
					   })
				      )
			       ), ""
		     )
	     );
}

void notify_shutdown() {
  if (PO && PO != TO)
    return;
  filter_array(users(), #'tell_object, //#'
	       "Game driver shouts: LPmud shutting down immediately.\n");
  save_wiz_file();
}

