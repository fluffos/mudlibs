#pragma strong_types

#include "/secure/master.h"

int domain_master(string user, string domain) {
  string *domains;
  int i;
  
  if (!find_userinfo(user) ||
      !pointerp(domains=get_userinfo(user)[USER_DOMAIN+1]))
    return 0;
  return (member(domains,domain) != -1);
}

int domain_member(string user, string domain)
{
  return (IS_DOMAINMEMBER(user) && file_size("/d/"+domain+"/"+user)==-2);
}

int add_domain_master(string user,string dom)
{
  mixed *domains;

  if (((call_other(SIMUL_EFUN_FILE, "process_call") ||
        call_other(SIMUL_EFUN_FILE, "secure_level") < ARCH_LVL) &&
        geteuid(PO) != ROOTID) || !find_userinfo(user) )
    return 0;

  domains = get_userinfo(user)[USER_DOMAIN+1];
  if (domains == 0) 
    set_domains(user, ({ dom }));
  else
    if (member(domains,dom) == -1)
    {
      domains += ({dom});
      set_domains(user, domains);
    }
  if (get_wiz_level(user) < LORD_LVL+5)
    ME->update_wiz_level(user,LORD_LVL+5);
  return 1;
}

int remove_domain_master(string user,string dom)
{
  mixed *domains;
  
  if (((call_other(SIMUL_EFUN_FILE, "process_call") ||
        call_other(SIMUL_EFUN_FILE, "secure_level") < ARCH_LVL) &&
       geteuid(PO) != ROOTID) || !find_userinfo(user) )
    return 0;

  if (member(domains = get_userinfo(user)[USER_DOMAIN+1], dom) == -1)
    return 0;

  domains -= ({ dom });
  set_domains(user, domains);
  return 1;
}

string *get_domains()
{
  string *regions;
  int i;
  
  if(!(regions=get_dir("/d/*",1))) return ({});
  for (i=sizeof(regions)-1;i>=0;i--)
    if (file_size("/d/"+regions[i])!=-2) regions[i]=0;
  regions -= ({ 0,"..","." });
  return regions;
}

string *get_domain_homes(string wiz)
{
  string *homes;
  int i;
  
  if (!wiz || wiz=="" || (query_wiz_level(wiz)<=WIZARD_LVL))
    return ({});
  homes = get_domains();
  for (i = sizeof(homes); i--; )
    if (file_size("/d/"+homes[i]+"/"+wiz) != -2) homes[i] = 0;
  homes -= ({0});
  return homes;
}
