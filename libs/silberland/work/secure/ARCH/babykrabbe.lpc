inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
// #include "../def.h"

create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();     
  
  SetProp (P_SHORT, "Eine Babykrabbe");
  SetProp(P_LONG,
    "Die Babykrabbe lebt hier im Schutze der grossen Riesenkrabben. "
    "Sie ist nicht sondelrich stark und kann dir fast keinen Schaden zufuegen. "
    "Mit der Hilfe der grossen Krabben stellt sie dennoch eine nicht zu "
    "unterschaetzende Gefahr dar. "
  );
  SetProp (P_NAME, "Babykrabbe");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Krabbe");
  AddId(({"riesenkrabbe", "krabbe", "babykrabbe"}));
  create_default_npc (2);
  
  SetProp(P_BODY, 10);
  SetProp(P_SIZE, 50);
  SetProp(P_HANDS, ({" mit ihrem Kiefer", 20}));
  SetProp(P_ALIGN, -100);
  SetProp(P_XP, 621000000);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_DIE_MSG, " faellt mit einem fuerchterlichen Schrei zu Boden.\n");

  SetChats(10, ({
  "Die Babykrabbe macht lustige Geraeusche.\n",
  }) );

 
 
 
}
