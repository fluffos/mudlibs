/*
** Ein Fahrscheinautomat 
*/

inherit "std/thing";

#include <wizlevels.h>
#include <properties.h>
#include "def.h"

nosave int k_g, g_e, geld; // Knopf_gewaehlt, Geld_eingeworfen

create()
{

  ::create();
  SetProp (P_SHORT, "Ein Fahrscheinautomat");
  SetProp (P_LONG, 
    "Vor Dir steht ein ziemlich grosser Fahrscheinautomat.\n"+
    "An der Vorderseite kannst Du einen Muenzschlitz, 3 Knoepfe, ein Schild "+
    "eine Anzeige und eine Anleitung erkennen. Weiters siehst du einen Hebel"+
    " an der Seite und ein Laempchen auf der Deckplatte.\n");
  SetProp (P_NAME, "Fahrscheinautomat");
  SetProp (P_GENDER, MALE);
  SetProp (P_MATERIAL, MAT_METAL);
  SetProp (P_NOGET,
    "Du brauchst doch nur einen Fahrschein und nicht gleich den ganzen "+
    "Automaten!\n");
  AddId (({"automat","fahrscheinautomat"}));
  AddDetail("deckplatte",
     "Die ist oben auf dem Automaten befestigt.\n");
  AddDetail("laempchen",
     "Es laeuchtet nicht.\n");
  AddDetail("hebel",
     "Du kannst ihn ziehen.\n");
  AddDetail(({"schlitz", "muenzschlitz"}), 
     "Mit 'werfe x muenzen ein' kannst du Geld einwerfen.\n");
  AddDetail(({"knopf", "knoepfe"}),
     "Da sind 3 Knoepfe:\nEin Spielerknopf, ein Seherknopf, und ein Magier"+
     "knopf.\n");
  AddDetail("spielerknopf",
     "Wenn Du ein Spieler bist, solltest du diesen Knopf druecken.\n");
  AddDetail("seherknopf",
     "Wenn Du ein Seher bist, solltest du diesen Knopf druecken.\n");
  AddDetail("magierknopf",
     "Wenn Du ein Magier bist, solltest du diesen Knopf druecken.\n");
  AddDetail("schild",
     "Schilder sind zum Lesen da, nicht zum angucken!\n");
  AddReadDetail("schild",
     "Preisuebersicht:\n"+
     "================\n"+
     "Spieler:    2 Muenzen\n"+
     "Seher:      5 Muenzen\n"+
     "Magier:   100 Muenzen\n"+
     "\nSei fair, denn Schwarzfahren zahlt sich nicht aus!\n");
  AddDetail("anleitung",
     "Anleitungen sind zum Lesen da, nicht zum betrachten!\n");
  AddReadDetail("anleitung",
     "Wie kriege ich einen Fahrschein?\n"+
     "================================\n"+
     "1. Checken was ich ueberhaupt bin.\n"+
     "   Moeglichkeiten: Spieler, Seher oder Magier\n"+
     "2. Ich druecke also den mir passenden Knopf.\n"+
     "3. Ich lese das Schild, damit ich weiss, wieviel Geld\n"+
     "   ich einwerfen muss.\n"+
     "4. Ich werfe das Geld ein.\n"+
     "5. Ich ziehe den Hebel und erhalte meinen Fahrschein.\n"+
     "\nPS: Falls ich keinen kriege, ueberpruefe ich alles von vorne.\n");
  AddDetail("anzeige",
     "Auf der Anzeige steht die Zahl: 0\n");
  AddCmd (({"zieh","ziehe"}), "zieh_hebel");
  AddCmd (({"drueck","druecke"}), "drueck_knopf");
  AddCmd (({"wirf","werfe"}), "geld_einwerfen");
  k_g=g_e=geld=0;
}

zieh_hebel(string str)
{
  notify_fail ("Was willst Du ziehen?\n");
  if (!str) return 0;
  if (str!="hebel") return 0;
  if ((k_g==0) && (g_e!=1))
  {
    write("Du musst zuerst Geld einwerfen und Dich dann einen der"+
          " Knoepfe druecken!\n");
    return 1;
  }
  if ((k_g==0) && (g_e==1))
  {
    write("Du hast vergessen, einen Knopf zu druecken!\n");
    return 1;
  }
  if ((k_g!=0) && (g_e!=1))
  {
    write("Du musst noch Geld einwerfen!\n");
    return 1;
  }
  if ((k_g!=0) && (g_e==1))
  {
    call_out ("get_fschein", 3);
    write ("Du ziehst an dem Hebel und der Automat beginnt zu rattern.\n");
    say (TP->Name()+" zieht an einem Hebel und der Automat beginnt zu"+
         " rattern.\n");
    return 1;
  }
}

get_fschein()
{
  write(
    "Der Automat spuckt Dir einen Fahrschein aus, den Du sofort "+
    "einsteckst.\n");
  say(TP->Name()+" steckt sich einen Fahrschein ein.\n");
  CLONETP(ITEM("fschein"));
  AddDetail("laempchen",
    "Es leuchtet nicht.\n");
  switch (k_g)
  {
    case 1: if(geld>5)
            {
              TP->AddMoney(geld-5);
              write("Du hoerst das Wechselgeld aus dem Automaten klimpern und"+
		   " steckst es ein.\n");
            }
    break;
    case 2: if(geld>2)
            {
              TP->AddMoney(geld-2);
              write("Du hoerst das Wechselgeld aus dem Automaten klimpern und"+
		   " steckst es ein.\n");
            }
    break;
    case 3: if(geld>100)
            {
              TP->AddMoney(geld-100);
              write("Du hoerst das Wechselgeld aus dem Automaten klimpern und"+
		   " steckst es ein.\n");
            }
  }

  k_g=g_e=geld=0;
  return 1;
}

drueck_knopf(string str)
{
  notify_fail ("Was willst Du druecken?\n");
  if (!str) return 0;
  if ((str!="magierknopf") && (str!="spielerknopf") && (str!="seherknopf") && (str=="knopf"))
 {
    write("Welchen Knopf willst Du denn druecken?\nDen Magierknopf, "+
        "den Seherknopf, oder den Spielerknopf?\n");
    return 1;
  }
  if ((str=="magierknopf") && (str!="spielerknopf") && (str!="seherknopf"))
  {
    if(IS_WIZARD(this_player()))
    {
      write("Du drueckst den Magierknopf.\n"+
        "Ein Laempchen leuchtet rot auf.\n");
      say(TP->Name()+" drueckt einen Knopf.\n");
      k_g=3;
      AddDetail("laempchen",
         "Es leuchtet rot.\n");
      return 1;
    }
    else
      return write("Du bist doch gar kein Magier!\n"),1;
  }
  if (str=="spielerknopf" && str!="magierknopf" && str!="seherknopf")
  {
    if((IS_SEER(this_player())) || (IS_WIZARD(this_player())))
    {
      write("Du bist doch kein Anfaenger mehr!\n");
      return 1;
    }
    write("Du drueckst den Spielerknopf.\n"+
      "Ein Laempchen leuchtet gruen auf.\n");
    say(TP->Name()+" drueckt einen Knopf.\n");
    k_g=2;
    AddDetail("laempchen",
       "Es leuchtet gruen.\n");
    return 1;
  }
  if (str=="seherknopf" && str!="spielerknopf" && str!="magierknopf")
  {
    if(IS_WIZARD(this_player()))
    {
      write("Du bist doch kein Seher mehr!\n");
      return 1;
    }
    if(IS_SEER(this_player()))
    {
      write("Du drueckst den Seherknopf.\n"+
        "Ein Laempchen leuchtet gelb auf.\n");
      say(TP->Name()+" drueckt einen Knopf.\n");
      k_g=1;
      AddDetail("laempchen",
         "Es leuchtet gelb.\n");
      return 1;
    }
    else
      return write("Du bist doch gar kein Seher!\n"),1;
  }
  return 0;
}

geld_einwerfen(string str)
{
  int einwurf;

  notify_fail ("Was willst Du einwerfen?\n");
  if (!str) return 0;
  if (sscanf(str, "%d muenzen ein", einwurf)==1)
  {
    if (PL->QueryMoney() >= einwurf )
    {
      if (einwurf == 0 )
      {
        write ("Das ist ja sowas von sinnvoll!\n");
        return 1;
      }
      if (einwurf == 1 )
      {
        write("Du wirfst 1 Muenze ein.\n");
      }
      else
      {
        write("Du wirfst "+einwurf+" Muenzen ein.\n");
      }
        PL->AddMoney(-einwurf);
        geld=geld+einwurf;
        if ((k_g==3 && geld>=100) || (k_g==1 && geld>=5) || (k_g==2 && geld>=2))
	{
          g_e=1;
        }
        AddDetail("anzeige", 
           "Auf der Anzeige steht die Zahl: "+geld+"\n");
        return 1;
    }
    else
    {
      write("Soviel Geld hast Du ja gar nicht!\n");
      return 1;
    }
  }
  else
  return 0;
}
