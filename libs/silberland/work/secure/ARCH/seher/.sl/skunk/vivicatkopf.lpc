// das ist der kopf, der alles moeglich macht
#include <properties.h>
#include <moving.h>
#include <language.h>

#define TO     this_object()
#define TL     this_player()
#define ENV(x) environment(x)
#define NF(x)  notify_fail(x)
#define CAP(x) capitalize(x)

#define CMPATH "/players/gott/tmp/"
#define OWNER "vivienne"
#define VIVICAT CMPATH+"vivicat"

inherit "std/thing";

//object katze;

create() {
  ::create();

  AddId(({"kopf"}));
  SetProp(P_GENDER, MALE);

  SetProp(P_NAME, "Katzenkopf");
  SetProp(P_SHORT, "Der Kopf von Vivienne´s Katze");
  SetProp(P_LONG,
	  "Das ist der abgerissene Kopf von Vivienne´s Katze. Wenn Du "+
	  "ihm tief in die Augen schaust, wird die Katze vielleicht "+
	  "wieder lebendig.");
  SetProp(P_INFO, "Du solltest ihm tief in die Augen schauen.\n");
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_NODROP,
	  "Damit koenntest Du ja die Katze wieder lebendig machen.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_SHOW_INV,1);

  AddDetail(({"auge","augen"}),
	    "Dir faellt ein leichtes Flackern in den Augen auf.");

  AddCmd(({"schau","schaue"}), "xschau");
}

int
xschau(string str) {
  object master, player;
  // syntaxcheck
  str=lower_case(str? str: "");
  if((strstr(str, "augen")==-1) && (strstr(str, "tief")==-1))
    return NF("Du sollst dem Kopf tief in die Augen schauen.\n"), 0;

  // meldung
  write("Du hattest sehr viel Glueck. Der Kopf verschwindet, und Deine "+
	"Katze erfreut sich wieder bester Gesundheit.\n");

  // die katze bauen
  call_other(VIVICAT, "???");

  // mich selbst verwurschtn
  destruct(TO);
  return 1;
}

void
catch_tell(string str) {
tell_object(find_player("aargon"), "catch-tell liefert: #"+str+"#\n");
  if(str=="Eine Katze schleicht herein.")
    write("Hallo, ich hab eine Katze gesehen.\n");
}
