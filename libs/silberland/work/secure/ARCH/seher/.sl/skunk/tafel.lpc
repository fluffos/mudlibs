#include <properties.h>
#include <language.h>
#include <moredef.h>
#include "../defines.h"

inherit "/std/thing";
inherit ROOM("dung-inh");

int z;

xtafel();

create() {
  if( !is_clone( this_object() ) ) 
    return;
  ::create();

  SetProp( P_SHORT,"Eine Tafel" );
  SetProp( P_LONG, "Auf dieser Tafel steht was. Lies doch mal!\n" );
  AddId( "tafel" );
  SetProp( P_NAME, "Tafel" );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_NOGET, "Die Tafel ist unverrueckbar.\n" );
  SetProp( P_WEIGHT, 1200 );
  SetProp( P_MATERIAL, MAT_WOOD );

  AddReadDetail( "tafel", #'xtafel );

  z=0;
}

xtafel() {
  int x,y;
  string xx,yy,zz;  

  write("Zur Zeit befindet sich im Labyrinth: \n" );
  for(x=1; x<11; x++) {
    for(y=1; y<11; y++) {
      if( x<10 )
        xx="0"+x;
      else
        xx=x;
      if( y<10 )
        yy="0"+y;
      else
        yy=y;
      zz="dung_"+xx+"_"+yy;
//      call_other( ROOM(zz), "" );
      listeauf( ROOM(zz) );
//      write(zz+" ");
    }
  }
  if( z==0 )
    write("  Niemand.\n");

  return "";
}

