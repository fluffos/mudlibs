varargs
listeauf( string raum ) {
  int i;
  object *inv;

  if( !find_object( raum ) )
    return 1;
  inv=all_inventory( find_object(raum) );
  inv=filter_array(inv, #'interactive);
  for( i=0; i<sizeof( inv ); i++) {
    write( "  "+inv[i]->QueryProp(P_PRESAY)+
           inv[i]->name(WER,0)+" "+inv[i]->QueryProp(P_TITLE)+"\n" );
    z++;
  } 
  return 1;
}


