#include <properties.h>
#include <moving.h>
#include <language.h>

#define TO     this_object()
#define TL     this_player()
#define ENV(x) environment(x)
#define NF(x)  notify_fail(x)
#define CAP(x) capitalize(x)

#define PATH  "/players/gott/"
#define OWNER "vivienne"

inherit "std/thing";

object katze;

create() {
  ::create();

  AddId(({"dose", "whiskas", "whiskasdose", "katzenfutter"}));
  SetProp(P_GENDER, FEMALE);

  SetProp(P_NAME, "Whiskasdose");
  SetProp(P_SHORT, "Eine Whiskasdose");
  SetProp(P_LONG,
	  "Eine Dose Whiskas. Wenn Du eine Katze haettest, wuerde sie "+
	  "sich darueber sicher freuen, wenn Du sie damit fuettern "+
	  "wuerdest.");
  SetProp(P_INFO, "Die Dose Whiskas von A&S. Deine Katze wuerde sich alle "+
	  "Pfoten abschlecken.\n");
  SetProp(P_MATERIAL, MAT_IRON);
//  SetProp(P_NODROP, 1);
//  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);

  AddCmd(({"fuetter","fuettere"}), "xfutta");
}

void
katzentu() {
  object leich;
  int i;

  // runtertu
  if(ENV(katze)!=ENV(TL))
    katze->move(ENV(TL), M_GO);
  // meldung, bloed
  tell_room(ENV(katze), "Die Katze kruemmt sich am Boden und laeuft gruen "+
	    "an und miaut\ngaaaaanz schrecklich.\nSie stirbt einen "+
	    "qualvollen Tod.\n");

  // leiche clonen
  leich=clone_object("std/corpse");
  leich->Identify(katze);
  leich->move(ENV(TL), M_GO|M_NOCHECK);
  leich->SetProp(P_LONG, "Das ist die Leiche von Vivienne´s unkaputtbarer "+
		 "Katze. Ihr sind alle vier Pfoten und der Kopf "+
		 "abgerissen.");

  // channels
  VOICEMASTER->SendToChannel("Moerder", leich, SAY, "Es waere doch "+
			     "gelacht, wenn Vivienne´s Katze nicht doch "+
			     "sterben wuerde.\n");
 
  // katze tot
  destruct(katze);

  // sheila schneidet pfoten ab, und kopf
  for(i=0; i<4; i++)
    clone_object(PATH+"vivicatpfote")->move(TL, M_GO|M_NOCHECK);
  say(TL->name()+" reisst der toten Katze den Kopf und die vier "+
      "Pfoten aus.\n");
  write("Du reisst der toten Katze den Kopf und die vier Pfoten aus.\n");

  // den kopf bekommt vivi
  clone_object(PATH+"vivicatkopf")->move(find_player(OWNER), M_GO|M_NOCHECK);
  say(TL->name()+" ueberreicht "+CAP(OWNER)+" den Kopf der Katze.\n",
      find_player(OWNER));
  tell_object(find_player(OWNER), TL->name()+" ueberreicht Dir stolz den "+
	      "Kopf Deiner (unkaputtbaren) toten Katze.\n");
  write("Du ueberreichtst den Kopf der toten Katze an "+CAP(OWNER)+"\n");

  // mich gibt´s nicht mehr
  destruct(TO);
}

int
xfutta(string str) {
  object *inv;
  int i, siz;

  // syntax checken
  if(lower_case(str? str: "") != "katze")
    return NF("Wen willst Du fuettern?\n"), 0;

  if(!(katze=present("\nvivicat", ENV(TL)))) {
    inv=all_inventory(ENV(TL));
    siz=sizeof(inv);
    i=siz;

    while(i && !katze) // ueber alle obs, solang keine katze gefunden
      katze=present("\nvivicat", inv[--i]);
  }

  if(!katze)
    return NF("Die Katze is nicht da.\n"), 0;

  // katze fuettern
  write("Du fuetterst die Katze mit einem boesen Grinsen.\n");
  say(TL->name()+" fuettert die Katze mit einem satanischen Grinsen "+
      "im Gesicht.\n");
  tell_room(ENV(TL), "Die Katze schnurrt ganz zufrieden.\n");

  // katze stirbt
  call_out("katzentu", 5);

  return 1; // consumed
}

