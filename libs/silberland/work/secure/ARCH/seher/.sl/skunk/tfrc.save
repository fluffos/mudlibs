;;;; This file is not required, but contains examples of commands you
;;;; might want to use in your personal configuration file (~/.tfrc).
;;;; Feel free to customize these commands to your own tastes.

;;; In some versions of xterm, scrollbars won't work unless you do this.
;;; (see /help xterm)
/if /test TERM	=~ "xterm"%; /then /set TERM=vt100%; /endif

;;; Enable windowing mode.
/visual on

;;; Enable paging
/more off
/require alias.tf
/izeilen 2

;;; Enable suppression of introductory MUD text.
/quiet off

;;; Disable old-style slash interpretation
;;; I recommend this unless you have old macros containing multiple slashes.
/set oldslash=off

;;; Enter the directory where you keep your tf files.
;/cd ~/tf-dir

;;; Define default filenames for /load*, /save*, and /log commands.
;/def MACROFILE	= ~/tf-dir/macros.tf
;/def HILITEFILE	= ~/tf-dir/hilite.tf
;/def GAGFILE	= ~/tf-dir/gag.tf
;/def TRIGFILE	= ~/tf-dir/trig.tf
;/def BINDFILE	= ~/tf-dir/bind.tf
;/def HOOKFILE	= ~/tf-dir/hook.tf
;/def WORLDFILE	= ~/tf-dir/world.tf
;/def LOGFILE	= tiny.log


/addworld -T"lp" Skunk skunk equinox7 sl.mud.de 4711
/addworld -T"lp" op skunk moesen opossum.ml.org 5678
/addworld -T"lp" Critter critter equinox7 sl.mud.de 4711
/addworld -T"lp" Skunk2 skunkzweiti equinox7 sl.mud.de 4711
/addworld -T"lp" Seher skunk equinox7 134.130.48.228 4711
/addworld TestTalk iguwnext.tuwien.ac.at 3000

;;; Load files.
;;; Only useful if you have these files, of course.
; /loadworld
; /loadhilite
; /loadgag
; /loaddef
; /loadbind
; /loadtrig
/load alle.mak
/xtitle Silberland
/load pro.mak
/load pro2.mak
/load farben.mak
/load pfeiltasten.mak
/load wege.mak
;/connect atpforest 4711
/pre lpmp
/def op = /world op
/def skunk = /world skunk%;
/def critter = /world critter%;
/def skunk2 = /world skunk2%;
/def mess = /load ../mess.mak%;
