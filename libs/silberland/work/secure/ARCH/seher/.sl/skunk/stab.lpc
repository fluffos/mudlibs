#include <sprache.h>
#include <moving.h>
#define HOME(x) "/wiz/ed/x"
inherit "std/obj";

zauber(s) {
  object o;

  if (! (o = present(s, ENV(TL))))
    return notify_fail (CAP(s) + " ist nicht hier.\n"), 0;

  if (! (TL->sub_mp(5)))
    return notify_fail ("Du hast zuwenig Magie!.\n"), 0;

  write("Du zauberst "+o->name(WEN)+" staerker.\n");
  say (TLN + " zaubert "+o->name(WEN)+" staerker.\n");
  clone_object (HOME(zauber))->moveto (o, M_SILENT);
  return 1;
}

setz(s) {
  object o;
  int i;
  string *m, n;
  mixed fix;

  if(!s)
    o = TL;
  else {
    if(!(o=present(s,TR)))
      return notify_fail (CAP(s) + " ist nicht hier.\n"), 0;
  }

  write("Du setzt "+o->name(WEM)+" die stats.");

  m = o->query_attribute_names();
  for(i=sizeof(m)-1; i>=0; i--) {
    n = m[i];
    if(n[0..7] == "sk_waffe") {
      fix = o->query_fix_attribute(n);
      o->del_fix_attribute(n);
      o->set_fix_attribute("sk_weapon"+n[8..], fix);
    }
  }

  o->set_fix_stat("ausdauer", 10);
  o->set_fix_stat("intelligenz", 10);
  o->set_fix_stat("charisma", 10);
  o->set_fix_stat("konzentration", 10);
  o->set_fix_stat("geschick", 10);
  o->set_fix_stat("staerke", 10);
  o->set_fix_stat("heilkraft", 10);
  o->set_fix_stat("weisheit", 10);

  o->set_fix_attribute("sys_max_food", 500);
  o->set_fix_attribute("sys_max_liquid", 500);
  o->set_fix_attribute("sys_max_alcohol", 500);

  o->set_food(500);
  o->set_liquid(500);
  o->set_alcohol(500);

  o->set_max_weight(10000);

  return 1;
}

int
krieg(string s) {
  object *o;
  object opfer;
  int i, j;

  o = livings_in_room();

  if(!s) {
    write("Du stiftest hier Krieg!");
    say(CAP(TL->name())+" stiftet hier Krieg!");
    for(i=sizeof(o)-1; i>=0; i--) {
      for(j=sizeof(o)-1; j>=i; j--) {
	if(o[i] != o[j])
	  o[i]->attack(o[j]);
      }
    }
  }
  else {
    if(!(opfer = find_user(s)))
      return NF(CAP(s) + " ist nicht hier.\n"), 0;
    write("Du stiftest "+s+" zum Krieg an!");

  }
  return 1;
}

create() {
  ::create();
  set_name (DER, "zauberstab,-es,-,-", "zauberstaebe,-,-n,-");
  add_id ("stab,staebe");
  set_long ("Kannst damit Leute staerker zaubern.\n");
  add_cmd ("(zauber,zaubere) %s [staerker]", CLSR(zauber),
    "Wen willst du staerker zaubern?\n");
  add_cmd("ss", CLSR(setz));
  add_cmd("krieg", CLSR(krieg));
}
