// die pfoten fuer die moerder
#include <properties.h>
#include <moving.h>
#include <language.h>

#define TO     this_object()
#define TL     this_player()
#define ENV(x) environment(x)
#define NF(x)  notify_fail(x)
#define CAP(x) capitalize(x)

inherit "std/thing";

create() {
  ::create();

  AddId(({"pfote"}));
  SetProp(P_GENDER, FEMALE);

  SetProp(P_NAME, "Katzenpfote von Vivienne´s Katze");
  SetProp(P_SHORT, "Eine Pfote von Vivienne´s Katze");
  SetProp(P_LONG, "Das ist eine abgerissene Pfote von Vivienne´s Katze.");
  SetProp(P_INFO, "Eine Jagdtrophaee von Aargon, Sheila und Vader.\n");
  SetProp(P_MATERIAL, MAT_FUR);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_SHOW_INV,1);

  AddDetail(({"kralle","krallen"}),
	    "Diese Krallen haben Aargon und Sheila oft genug gekratzt.\n");

  AddCmd(({"streichel","streichle"}), "xstreichel");
}

int
xstreichel(string str) {
  object ob;

  if(!str)
    return NF("Wen willst Du mit der Pfote streicheln?\n"), 1;

  if(!(ob=present(str, ENV(TL))))
    return NF(CAP(str)+" ist nicht hier.\n"), 0;

  write("Du streichelst "+CAP(str)+" mit Deiner Vivi-Katzenpfote.\n");
  say(TL->name()+" streichelt "+CAP(str)+" mit seiner Vivi-Katzenpfote.\n",
      ob);
  tell_object(ob, TL->name()+" streichelt Dich mit seiner "+
	      "Vivi-Katzenpfote.\n");
  return 1;
}
