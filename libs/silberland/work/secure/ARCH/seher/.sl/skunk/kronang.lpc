      case 2: CLONEME( "/d/huegelland/feyaria/blut/armour/kettenhandschuhe");
              break;
      case 3: CLONEME( "/d/huegelland/feyaria/blut/armour/stachelhandschuhe");
              break;
      case 4: CLONEME( "/d/ebene/lamuerte/burg/obj/titanhandschuhe"); break;
    }
  if( random(100)<50 ) // Schuhe
    switch(random(7) )
    {
      case 0: CLONEME( "/d/ebene/obj/ruestung/lederstiefel"); break;
      case 1: CLONEME( "/d/gebirge/dusty/zwerge/obj/sanda"); break;
      case 2: CLONEME( "/d/gebirge/eros/ruestung/baerenpranken"); break;
      case 3: CLONEME( "/d/huegelland/feyaria/blut/armour/orkstiefel" ); break;
      case 4: CLONEME( "/d/ebene/lamuerte/burg/obj/kampfstiefel"); break;
      case 5: CLONEME( "/d/ebene/lamuerte/burg/obj/osternstiefel"); break;
      case 6: CLONEME( "/d/wasser/stahldorn/knarkh/obj/knarkhstiefel"); break;
    }
  if( random(100)<20 ) // Ring 
    switch(random(3) )
    {
      case 0: CLONEME( "/d/gebirge/eros/ruestung/platinring"); break;
      case 1: CLONEME( "/d/gebirge/speedy/trollager/ruestung/trollring"); break;
      case 2: CLONEME( "/d/ebene/lamuerte/burg/obj/titanring"); break;
    }
  if( random(100)<20 ) // Amulett 
    switch(random(3) )
    {
      case 0: CLONEME( "/d/gebirge/eros/ruestung/federnamulett"); break;
      case 1: CLONEME( "/d/dschungel/feyaria/tijara/armour/amulett"); break;
      case 2: CLONEME( "/d/ebene/lamuerte/burg/obj/smaragtamulett"); break;
    }
  CLONEME( ARMOUR "stirnband" );
  command("trage alles");
  CLONEME( "/d/huegelland/feyaria/blut/weapon/baxt" );
  command("zuecke axt");
}


// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  WLOG( LOG "kronang", " killt Kronang");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer== ME )
  WLOG( LOG "kronang" , " von Kronang umgebracht. ( -"+ lostexp+" XP )");
  command("nimm alles aus leiche");
  command("trage alles");
}


string stirnband()
{
  if( TP->QueryProp(P_GUILD) == "berserker" )
  {
    if(! present("\nberserker_stirnband", TP) )
    {
      CLONE( ARMOUR "stirnband", TP );
      return "sagt: Oh! Du hast Dein Stirnband vergessen? Hier hast "
        "Du ein neues,\nKronang sagt: aber pass diesmal besser darauf auf!\n";
    }
    return "ermahnt Dich: Pass immer gut auf Dein Stirnband auf!\n";
  }
  return "sagt: Nur als Berserker versteht man den Wert dieses Stirnbandes!\n";
}

string faehigkeiten()
{
  call_other(MENV, "faehigkeiten");
  return "";
}

string beitreten()
{
  call_other(MENV, "beitreten");
  return "";
}
 
string austreten()
{
  call_other(MENV, "austreten");
  return "";
}
 
string lernen()
{
  call_other(MENV, "lernen");
  return "";
}
 

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if ((gruppe=="nett" || gruppe=="intim") && find_call_out("gut")==-1) 
    call_out("gut",0);
  else if ((gruppe=="fies" || gruppe=="frech") && find_call_out("boese")==-1)
    call_out("boese",0);
  else if ((gruppe=="traurig" || gruppe=="aengstlich" || gruppe=="aergerlich")
      && find_call_out("troesten")==-1 )
    call_out("troesten",0);
  else if ((gruppe=="froh" || gruppe=="albern") && find_call_out("lustig")==-1)
    call_out("lustig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void gut()
{
  string *guttext;
  guttext= ({ "Hoer auf, mich zu belaestigen, ",
              "Was soll das, ",
              "Ich mag das nicht, ",
              "Geh lieber kaempfen, " });
  command_me("sag " + guttext[random(sizeof(guttext))] + TPN+ "!");
}

void boese()
{
  string *boestext;
  boestext=({ "Das merk ich mir, ", 
              "Ich lass mich nicht von Dir provozieren, ",
              "Willst Du, dass ich Dich zerschmettere, "});
command_me("sag " + boestext[random(sizeof(boestext))] + TPN + "!" );
}

void lustig()
{
  command_me("sag Aus Dir wird nie ein richtiger Berserker, "+TPN+"!");
}

void troesten()
{
  command_me("sag "+CAP_TPN+" ist ein Schwaechling!");
}


