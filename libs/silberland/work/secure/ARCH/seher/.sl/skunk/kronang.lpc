      case 0: CLONEME( "/d/ebene/obj/ruestung/platinhelm"); break;
      case 1: CLONEME( "/players/woody/obj/mithrilhelm"); break;
      case 2: CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerhelm"); break;
      case 3: CLONEME( "/d/dschungel/feyaria/tijara/armour/bronzehelm"); break;
      case 4: CLONEME( "/d/gebirge/monimor/morkas/obj/dhelm"); break;
      case 5: CLONEME( "/d/huegelland/feyaria/blut/armour/orkhelm"); break;
      case 6: CLONEME( "/d/huegelland/feyaria/blut/armour/kettenhaube"); break;
      case 7: CLONEME( "/d/ebene/lamuerte/burg/obj/kampfhelm"); break;
      case 8: CLONEME( "/d/ebene/lamuerte/burg/obj/titanhelm"); break;
      case 9: CLONEME( "/d/gebirge/angrox/4elem/obj/armour/steinhelm"); break;
      case 10:CLONEME( "/d/wasser/stahldorn/knarkh/obj/knarkhhelm"); break;
      case 11:CLONEME( "/d/wasser/stahldorn/knarkh/obj/p_knarkhhelm"); break;
    }
  if( random(100)<90 ) // Umhang
    switch(random(11) )
    {
      case 0: CLONEME( "/d/ebene/obj/ruestung/umhang"); break;
      case 1: CLONEME( "/d/ebene/obj/ruestung/otterfell"); break;
      case 2: CLONEME( "/d/ebene/obj/ruestung/gaffoumhang"); break;
      case 3: CLONEME( "/d/gebirge/eros/ruestung/wolfsfell"); break;
      case 4: CLONEME( "/d/dschungel/feyaria/kueste/armour/jaguarfell"); break;
      case 5: CLONEME( "/d/gebirge/eros/ruestung/grizzlyfell"); break;
      case 6: CLONEME( "/d/huegelland/feyaria/weg/armour/baerfell"); break;
      case 7: CLONEME( "/d/gebirge/dusty/zwerge/obj/umhang"); break;
      case 8: CLONEME( "/d/gebirge/thor/plateau/obj/armour/pumafell"); break;
      case 9: CLONEME( "/d/huegelland/feyaria/blut/armour/orkmantel" ); break;
      case 10:CLONEME( "/d/dschungel/dante/weg/armour/dtigerfell"); break;
    }
  if( random(100)<65 ) // Hose
    switch(random(6) )
    {
      case 0: CLONEME( "/d/ebene/lamuerte/wwald/obj/fellhose"); break;
      case 1: CLONEME( "/d/dschungel/feyaria/tijara/armour/beinschienen");break;
      case 2: CLONEME( "/d/huegelland/feyaria/blut/armour/kettenbeinlinge");
              break;
      case 3: CLONEME( "/d/ebene/obj/ruestung/beinschienen"); break;
      case 4: CLONEME( "/d/ebene/lamuerte/burg/obj/kettenhose"); break;
      case 5: CLONEME( "/d/wasser/stahldorn/knarkh/obj/knarkhhose"); break;
    }
  if( random(100)<40 ) // Armschienen 
    switch(random(3) )
    {
      case 0: CLONEME( "/d/dschungel/feyaria/tijara/armour/armschienen"); break;
