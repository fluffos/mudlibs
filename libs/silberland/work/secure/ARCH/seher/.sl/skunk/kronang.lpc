// /gilden/berserker/kronang.c   
// Der Gildemeister der Berserker
// 1997-10-11  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

void ausruesten();
string stirnband();
string faehigkeiten();
string beitreten();
string austreten();
string lernen();

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kronang, der Meister der Berserker");
  SetProp(P_LONG, BS(
    "Kronang ist der Meister der Berserkergilde. Frueher war er einmal "
    "ein gefuerchteter Kaempfer, aber nun hat er sich hier zurueckgezogen, "
    "um seinen Schuelern die Kampfkunst der Berserker beizubringen. "
    "Es ist ueber 2 Meter gross und hat gewaltige Muskeln. Obwohl sein Haar "
    "schon grau ist, ist er sicher noch ein gefaehrlicher Gegner."));
  SetProp(P_NAME, "Kronang");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"kronang", "meister", "\ngildenmeister", "BERSERKER",
           "berserker", "berserkermeister"}) );
  set_living_name("kronang");
  SetProp(P_SMELL, "Kronang riecht stark nach Schweiss.\n");
  AddDetail( ({"muskel", "musklen"}), 
    "Einen so muskoloesen Menschen wie Kronang hast Du noch nie "
    "gesehen. Sicher kann er Dich mit seiner Axt in Stuecke hauen.");

  create_default_npc(50);
  SetProp(P_HANDS, ({" mit seinen riesigen Faeusten", 300, DT_BLUDGEON}));
  SetAttribute(A_STR, 99);
  SetProp(P_BODY, 500);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 200+random(10) );
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 80);

  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 10);
  ModifySkill(SK_TWOHANDED, 10000);
  ModifySkill(FIGHT(WT_AXE), 10000);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "stampft herein");
  SetProp(P_MMSGOUT, "stampft weit weg");

  SetProp(P_DIE_MSG,  " stirbt einen Berserkertod.\n");

  AddInfo(DEFAULT_INFO, ({
    "grummelt: So ein Bloedsinn!\n",
    "sagt neugierig: Gibts das wirklich?\n",
    "sagt: Aha.\n",
    "fragt: Meinst Du das wirklich so?\n",
    "sagt: Na so was!\n",
    "sagt: Pah!\n",
    "sagt: Frag doch einen Druiden!\n",
    "schaut Dich erstaunt an.\n",
    "sagt: Sowas ist nichts fuer einen echten Berserker!\n",
    "ignoriert Deine Frage.\n",
    "scheint Dich nicht verstanden zu haben.\n",
    "fragt: Warum fragst Du mich das?\n",
    "bruellt: Was willst Du, Du Feigling!\n",
    "schreit: Lass mich doch damit in Ruhe!\n",
    "knirscht mit seinen Zaehnen.\n",
    "fragt: Willst Du nicht lieber etwas ueber die Berserker erfahren?\n"}) );
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"stirnband", "blutrotes stirnband"}), #'stirnband);
  AddInfo( ({"skills","faehigkeiten", "fertigkeiten"}), #'faehigkeiten, 1);
  AddInfo(({"lerne", "lernen", "lern"}), #'lernen, 1);
 
  AddLibrary(NPC "kronang.lib", 1); 

  SetProp(P_LOG_INFO, 1);  

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Kronang zerstoert @WEN voller Berserkerwut!\n" }) );

  SetProp(P_SPELLRATE,80);
  AddSpell(3,700,
    "Der Berseker erschreckt Dich mit seinem Kampfschrei.\n",
    "Der Berseker erschreckt @WEN mit seinem Kampfschrei.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,950,
    "Der Berseker bruellt Dich an.\n",
    "Der Berseker bruellt @WEN an.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1500,
    "Der Berseker schlaegt Dir beinahe den Kopf ab.\n",
    "Der Berseker schlaegt @WEM beinahe den Kopf ab.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
    "Kronang sagt: Die Berserkergilde ist die beste aller Gilden!\n",
    "Kronang schaerft seine Axt.\n",
    "Kronang massiert seinen gewaltigen Oberarm.\n",
    "Kronang fragt Dich: Willst Du nicht ein Berserker werden?\n",
    "Kronang schaut grimmig durch die Gegend.\n",
    "Kronang wuetet herum und schuechtert Dich gewaltig ein.\n", 
    "Kronang spannt seine Muskeln an.\n",
    "Kronang prueft seine Ausruestung.\n",
    "Kronang knirscht mit den Zaehnen.\n",
    "Kronang spannt seinen gewaltigen Bizeps an.\n",
    "Kronang laesst seine Axt pfeifend durch die Luft sausen.\n",
    "Kronang schaut Dich veraechtlich an.\n"}) );
  SetAttackChats(8, ({
    "Kronang ruft: Ich pruegel Dich windelweich!\n",
    "Kronang knirscht laut mit den Zaehnen.\n",
    "Kronang aktiviert seine gewaltigen Kraefte.\n",
    "Kronang bruellt laut.\n"}) );

  SUID;
  ausruesten();
}

void reset()
{
  object ob, next;
  ::reset();
  if( !is_clone(TO) ) return; 
  if( MENV )
    tell_room(MENV,"Kronang besorgt sich eine neue Ausruestung.\n");
  for(ob=first_inventory();ob;)
  {
    next=next_inventory(ob);
    ob->remove(1);
    ob=next;
  }
  ausruesten();
}

void ausruesten()
{
  if( random(100)<80 )  // Ruestung
    switch(random(19) )
    {
      case 0: CLONEME( "/d/ebene/obj/ruestung/titanpanzer"); break;
      case 1: CLONEME( "/d/ebene/obj/ruestung/eisenpanzer"); break;
      case 2: CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerpanzer"); break;
      case 3: CLONEME( "/d/dschungel/feyaria/tijara/armour/bronzepanzer");
              break;
      case 4: CLONEME( "/d/gebirge/angrox/obj/Kettenhemd"); break;
      case 5: CLONEME( "/d/ebene/obj/ruestung/lederruestung"); break;
      case 6: CLONEME( "/d/gebirge/monimor/morkas/obj/druestung"); break;
      case 7: CLONEME( "/players/woody/obj/mithrilpanzer"); break;
      case 8: CLONEME( "/d/gebirge/eros/ruestung/schuppenpanzer"); break;
      case 9: CLONEME( "/d/huegelland/feyaria/blut/armour/orkpanzer"); break;
      case 10:CLONEME( "/d/huegelland/feyaria/blut/armour/kettenpanzer"); break;
      case 11:CLONEME( "/d/ebene/lamuerte/burg/obj/kettenhemd"); break;
      case 12:CLONEME( "/d/gebirge/angrox/4elem/obj/armour/diamantpanzer");
              break;
      case 13:CLONEME( "/d/gebirge/angrox/4elem/obj/armour/steinpanzer"); break;
      case 14:CLONEME( "/d/gebirge/thor/hoehlenquest/armour/kpanzer"); break;
      case 15:CLONEME("/d/gebirge/speedy/trollager/ruestung/schwtrollruestung");
              break;
      case 16: CLONEME( "/d/dschungel/dante/stein/armour/dstpanzer"); break;
      case 17:CLONEME( "/d/wasser/stahldorn/knarkh/obj/knarkhpanzer"); break;
      case 18:CLONEME( "/d/wasser/stahldorn/knarkh/obj/p_knarkhpanzer"); break;
    }
  if( random(100)<90 ) // Helm
    switch(random(12) )
