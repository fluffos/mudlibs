/* FILE: start
**
** Start vor Dungeon
*/

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>
#include "../defines.h"

inherit "std/room";

create() {
  ::create();

  SetProp( P_INT_SHORT, "In der Huette von Saruman" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20]) );

  SetProp( P_INT_LONG, BS(
    "Du stehst in der kleinen Huette von Saruman. Die Einrichtung ist "+
    "schlicht aber nett. Es befinden sich ein Tisch, mehrere Sessel und "+
    "eine Sitzbank in diesem Zimmer. Erleuchtet wird der Raum durch eine "+
    "Oellampe, die an der Decke aufgehaengt ist. An der Ost- und Nordseite "+
    "befindet sich ein Fenster, das den Raum auch noch ein wenig erhellt. Am "+
    "Boden liegt ein grosser Teppich. ") );
  /*
    "TESTPHASE: MIT flags KANN MAN DIE "+
    "BISHER GESETZTEN FLAGS ANSEHEN. ") );
    */

  AddDetail( ({"huette","zimmer","raum"}), BS(
    "Das Zimmer, wo Du gerade stehst ist klein, doch fuer den alten Mann "+
    "scheint es zu reichen. ") );
  AddDetail( "einrichtung", BS(
    "Die Einrichtung ist etwas spaerlich, aber doch ganz nett. Hier befindet "+
    "sich ein Tisch, einige Sessel und eine Sitzbank. ") );
  AddDetail( "tisch", BS(
    "Der Tisch steht in der Mitte des Zimmers und dient dazu einige Sachen "+
    "darauf abzustellen. ") );
  AddDetail( "mitte", BS(
    "In der Mitte des Zimmers steht nur ein grosser Tisch. ") );
  AddDetail( "sessel", BS(
    "Einige Sessel stehen neben dem Tisch, man muss ja auch wo sitzen "+
    "koennen. ") );
  AddDetail( ({"bank","sitzbank"}), BS(
    "Die Sitzbank scheint sehr gemuetlich zu sein. Darauf sitzt Saruman "+
    "immer wenn er gerade nichts zu tun hat. ") );
  AddDetail( ({"oellampe","lampe"}), BS(
    "Die kleine Oellampe, die an der Decke haengt, erhellt das Zimmer auch "+
    "nachts. Schliesslich will Saruman ja was sehen. ") );
  AddDetail( "decke", BS(
    "An der Decke haengt eine Oellampe herunter, sonst ist sie einfach nur "+
    "aus Holz, wie auch alles andere hier. ") );
  AddDetail( "fenster", BS(
    "Durch die Fenster dringt am Tage das Sonnenlicht, damit das kleine "+
    "Zimmer auch einwenig erleuchtet ist. ") );
  AddDetail( ({"seite","ostseite","nordseite","wand","waende"}), BS(
    "Die Waende des Zimmers sind aus Holz, es haengen einige Bilder an "+
    "diesen. ") );
  AddDetail( "boden", BS(
    "Am Boden liegt ein grosser Teppich. ") );
  AddDetail( "unter teppich", BS(
    "Vielleicht kann man den Teppich beiseite rollen. ") );
  AddDetail( "teppich", BS(
    "Der Teppich ist sehr schoen genaeht, man sieht es gleich, dass es echte "+
    "Handarbeit ist. Was da wohl drunter sein mag. ") );
  AddDetail( ({"handarbeit","arbeit"}), BS(
    "Das ist wirklich hervorragend gearbeitet, hat bestimmt viel Zeit in "+
    "Anspruch genommen. ") );
  AddDetail( "holz", BS(
    "Alles hier ist aus Holz, die Waende, die Decke und sogar der Boden. ") );
  AddDetail( ({"bild","bilder"}), BS(
    "Die Bilder zeigen vorallem Saruman mit seinen Bekannten und "+
    "Verwandten.") );
  AddDetail( ({"freunde","verwandte","bekannte"}), BS(
    "Die kennst Du sicher alle nicht. ") );

  AddItem( NPC("saruman"), REFRESH_DESTRUCT );
  AddItem( OBJ("tafel"), REFRESH_REMOVE );

  AddCmd( ({"roll","rolle","schiebe","schieb"}), "xschiebe" );
  AddCmd( "flags", "xflags" );

  AddExit( "sueden", "/d/gebirge/dusty/weg/j22" );
}

S_TestFlag(int what) {
  object ob;

  ob=present( QUEST_ITEM, TP );
  if( !ob )
    return 0;
  return ob->TestFlag(what);
}

xflags() {
  int z,i;
 
/*
  write(
    "F_START               : "+S_TestFlag( F_START               )+"\n"+
    "F_TUER_B_OFFEN        : "+S_TestFlag( F_TUER_B_OFFEN        )+"\n"+
    "F_ERDE_WEG            : "+S_TestFlag( F_ERDE_WEG            )+"\n"+
    "F_STEIN_GELOCKERT     : "+S_TestFlag( F_STEIN_GELOCKERT     )+"\n"+
    "F_KETTE_REPARIERT     : "+S_TestFlag( F_KETTE_REPARIERT     )+"\n"+
    "F_TUER_F_OFFEN        : "+S_TestFlag( F_TUER_F_OFFEN        )+"\n"+
    "F_TUER_G_OFFEN        : "+S_TestFlag( F_TUER_G_OFFEN        )+"\n"+
    "F_TUER_H_OFFEN        : "+S_TestFlag( F_TUER_H_OFFEN        )+"\n"+
    "F_KETTE_ANHAENGEN     : "+S_TestFlag( F_KETTE_ANHAENGEN     )+"\n"+
    "F_TUER_K_OFFEN        : "+S_TestFlag( F_TUER_K_OFFEN        )+"\n"+
    "F_MUENZE_WERFEN       : "+S_TestFlag( F_MUENZE_WERFEN       )+"\n"+
    "F_KERZE_ZUENDEN       : "+S_TestFlag( F_KERZE_ZUENDEN       )+"\n"+
    "F_BETEN               : "+S_TestFlag( F_BETEN               )+"\n"+
    "F_GET_LOEFFEL         : "+S_TestFlag( F_GET_LOEFFEL         )+"\n"+
    "F_GET_SCHAUFEL        : "+S_TestFlag( F_GET_SCHAUFEL        )+"\n"+
    "F_GET_KETTE           : "+S_TestFlag( F_GET_KETTE           )+"\n"+
    "F_GET_ZETTEL          : "+S_TestFlag( F_GET_ZETTEL          )+"\n"+
    "F_GET_HOLZ            : "+S_TestFlag( F_GET_HOLZ            )+"\n"+
    "F_GET_GUMMI           : "+S_TestFlag( F_GET_GUMMI           )+"\n"+
    "F_GET_MUENZE_R        : "+S_TestFlag( F_GET_MUENZE_R        )+"\n"+
    "F_GET_MUENZE_B        : "+S_TestFlag( F_GET_MUENZE_B        )+"\n"+
    "F_GET_MUENZE_G        : "+S_TestFlag( F_GET_MUENZE_G        )+"\n"+
    "F_GET_AMULETT         : "+S_TestFlag( F_GET_AMULETT         )+"\n"+
    "F_GET_SEIL            : "+S_TestFlag( F_GET_SEIL            )+"\n"+
    "F_GET_STEIN           : "+S_TestFlag( F_GET_STEIN           )+"\n"+
    "F_HEBEL_OK            : "+S_TestFlag( F_HEBEL_OK            )+"\n"+
    "F_KRAFTFELD           : "+S_TestFlag( F_KRAFTFELD           )+"\n"+
    "F_READ_TAFEL          : "+S_TestFlag( F_READ_TAFEL          )+"\n"+
    "F_GET_ROLLE           : "+S_TestFlag( F_GET_ROLLE           )+"\n"+
    "F_BRICH_SCHAEDEL      : "+S_TestFlag( F_BRICH_SCHAEDEL      )+"\n"+
    "F_BIEGE_DRAHT         : "+S_TestFlag( F_BIEGE_DRAHT         )+"\n"+
    "F_BEFESTIGE_HAKEN     : "+S_TestFlag( F_BEFESTIGE_HAKEN     )+"\n"+
    "F_BEFESTIGE_GUMMI     : "+S_TestFlag( F_BEFESTIGE_GUMMI     )+"\n"+
    "F_ROT_DRINNEN         : "+S_TestFlag( F_ROT_DRINNEN         )+"\n"+
    "F_BLAU_DRINNEN        : "+S_TestFlag( F_BLAU_DRINNEN        )+"\n"+
    "F_GRUEN_DRINNEN       : "+S_TestFlag( F_GRUEN_DRINNEN       )+"\n"+
    "---------------------------------------------------------------\n");
*/
  for(i=1; i<(FLAGS+1); i++)
    z += S_TestFlag( i );
  z=(100*z)/FLAGS;

/*  write(
    "PROZENT GELOEST       : "+z+"\n" );
*/
  
  switch( z ) {
    case  0..10: 
      write(BS(
	"Also viel hast Du noch nicht geloest. ") );
      break;
    case 11..20: 
      write(BS(
	"Ein bisschen kennst Du Dich ja schon aus. ") );
      break;
    case 21..30: 
      write(BS(
	"Viel kennst Du noch nicht, aber Du erfaehrst immer mehr. ") );
      break;
    case 31..40: 
      write(BS(
	"Der Durchschnitt kommt schon in Reichweite. ") );
      break;
    case 41..50: 
      write(BS(
	"Du steht kurz vor dem Durchschnitt. ") );
      break;
    case 51..60: 
      write(BS(
	"Du bist jetzt ungefaehr bei der Haelfte. ") );
      break;
    case 61..70: 
      write(BS(
	"Mehr als die Haelfte hast Du schon geloest. ") );
      break;
    case 71..80: 
      write(BS(
	"Jetzt wird es bald spannend, Du naeherst Dich dem Ende. ") );
      break;
    case 81..90: 
      write(BS(
	"Ein kleines Stueck noch, und Du hast es geschafft. ") );
      break;
    case 91..99: 
      write(BS(
	"Du stehtst kurz vor der Vollendung. ") );
      break;
    default: // 100 Prozent 
      write(BS(
	"Du spuerst, dass Du alles fertig hast. ") );
      break;
  }
  return 1;
}

xschiebe(str) {
  notify_fail( "Was willst Du rollen?\n" );
  if( (str=="teppich") || (str=="teppich weg") || (str=="teppich auf") ||
      (str=="teppich beiseite") ) {
    if( present( QUEST_ITEM, TP ) ) {
      say(BS(
        TP->name()+" rollt einen Teppich zur Seite und oeffnet eine "+
        "Falltuere.") );
      write(BS(
        "Du rollst den Teppich zur Seite und entdeckst eine Falltuer. "+
        "Schnell oeffnest Du die Falltuer und steigst die Leiter hinab. "+
        "Saruman schliesst die Falltuer wieder. ") );
      TP->move( ROOM("dung_02_02"), M_TPORT, "", "klettert eine "+
      "Leiter hinunter", "klettert an einer Leiter herunter");
      tell_room( ROOM("start"),
        "Saruman schliesst die Falltuere wieder und legt den Teppich "+
        "darauf.\n");
      return 1;
    }
    write(BS(
      "Saruman sagt: Lass meinen Teppich liegen. ") );
    return 1;
  }
  return 0;
}



