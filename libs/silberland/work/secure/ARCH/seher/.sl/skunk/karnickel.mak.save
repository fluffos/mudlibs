/def tkar = /if (kar==0) t karnickel%;/set kar=1%; /endif
/def -t'*Ein Karnickel.*' kar1 = /tkar;
/def -t'*Das Karnickel blickt Dich noch einmal traurig an und stirbt.*' kar2 = /set kar=0%;schau%;
/def -t'*Ein Karnickel hoppelt herein und schaut sich nach*' kar3 = /tkar%;
/def -p999 -F -t'*Karnickel sucht ein {*} und hoppelt nach {*}' kar4 = /set karflucht=$[substr(tolower(%9),0,strlen(%9)-1)]%;
/def -p999 -F -t'*Du verfolgst jetzt ein Karnickel.*' kar5 = /eval %karflucht%;
/def res = /set kar=0%;



