inherit "std/thing";
 
#include <properties.h>
#include <defines.h>
#include <wizlevels.h>
#include <ansi.h>
#include <defines.h>
#include <moredef.h>
#include <udp.h>
#include <moving.h>

#define DEFAULT(x) (x=="\ndefault" ? "Default" : x)
#define ENV_TERRAIN "env_terrain"
#define NPCMASTER "/secure/npcmaster"

#define version "0.2.9"
#define datum   "15.01.1998"

private mapping map;
private object here,owner;
private string *color;
private int config,unters,notify;

string given_scores;
 
void create() {
  object ob;
  string str;
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_LONG,
    "Du haeltst einen wundervollen Kristallspiegel in Deinen Haenden. Wenn "
    "Du mit ihm Dir die Raeume ansiehst, kannst Du unter Umstaenden ziemlich "
    "wichtige Dinge sehen. mit <zhilfe> bekommst Du eine Hilfeseite." );
  config=1;
  notify=1;
  unters=0;
  owner=TP;
  if (ob=MENV||TP) {
    str=CAP(((str=geteuid(ob))[<1]=='s'||str[<1]=='x'||str[<1] =='z')?str+="'":str+="s");
  } else {
    str="Ein";
  }
  SetProp( P_SHORT,str+" Spiegel" );
  SetProp( P_NAME, str+" Spiegel" );
  SetProp( P_WEIGHT,    100 );
  SetProp( P_VALUE,     100 );
  SetProp( P_NOBUY,       1 );
  SetProp( P_NOSELL,      1 );
  SetProp( P_AUTOLOADOBJ, 1 );
  SetProp( P_GENDER,   MALE );
  SetProp( P_NODROP, "Nene, Du findest den Spiegel viel zu huebsch.\n" );
  SetProp( P_NEVERDROP,   1 );
  AddId( "spiegel" );
  call_out("addhook",1,ME);
  write("ZordanTool v"+version+" vom "+datum+" ... zhilfe fuer Hilfe.\n");
}
 
void init() {
  string termial;
  ::init();
  if (!IS_LEARNER(TP)) return;
  add_action("showall",        "za" );
  add_action("showdetails",    "zd" );
  add_action("showcmds",       "zc" );
  add_action("showexits",      "ze" );
  add_action("showsmells",     "zsm" );
  add_action("showsounds",     "zso" );
  add_action("showdoors",      "zdo" );
  add_action("cfg",            "zstr" );
  add_action("untersuche",     "zunt" );
  add_action("notifyen",       "znot" );
  add_action("hilfe",          "zhilfe" );
  add_action("showcloner",     "zcl" );
  add_action("showumg",        "zumg" );
  add_action("shownpc",        "znpc" );
  add_action("ztoete",         "zkill" );
  add_action("erstkiller",     "zek" );
  add_action("ekkill",         "zekk" );
  add_action("eknotkill",      "zeknk" );
  add_action("zausrueste",     "zausr" );
  add_action("heilen",         "zheil" );
  add_action("setalignstring", "zal" );
  add_action("setracestring",  "zra" );
  add_action("zkwer",          "zkwer" );
  add_action("zprops",         "zprop" );
  add_action("echoall",        "zea" );
  add_action("transen",        "ztrans" );
  color = ({ 0,0,0,0,0 });
  if ((termial=TP->QueryProp(P_TTY)) == "ansi") {
    color[0] = ANSI_NORMAL;
    color[1] = ANSI_BOLD;
    color[2] = ANSI_UNDERL;
    color[3] = ANSI_BLUE;
    color[4] = ANSI_RED;
  } else if (termial == "vt100") {
    color[0]=ANSI_NORMAL;
    color[1]=ANSI_BOLD;
    color[2]=ANSI_BOLD;
    color[3]=ANSI_NORMAL;
    color[4]=ANSI_NORMAL;
  } else {
    color[0]=color[1]=color[2]=color[3]=color[4]=ANSI_NORMAL;
  }
}
 
int hilfe() {
  write("+================================================================+\n");
  write("| "+color[1]+color[2]+"Folgende Befehle sind mit Deinem Spiegel moeglich:"+color[0]+"       |\n");
  write("+----------------------------------------------------------------+\n" );
  write("|                                                                |\n");
  write("| "+color[4]+"za"+color[0]+"   : Alle wichtigen Informationen im Raum                    |\n");
  write("|                                                                |\n");
  write("| "+color[4]+"zd"+color[0]+"   : Details            "+color[4]+"zsm"+color[0]+"  : Smells                        |\n");
  write("| "+color[4]+"zc"+color[0]+"   : Commands           "+color[4]+"zso"+color[0]+"  : Sounds                        |\n");
  write("| "+color[4]+"ze"+color[0]+"   : Exits              "+color[4]+"zdo"+color[0]+"  : Doors                         |\n");
  write("|                                                                |\n");
  write("| "+color[4]+"zstr  <");
  if (config==1) write(color[2]);
  write("Ein"+color[0]+color[4]+"/");
  if (config==0) write(color[2]);
  write("Aus"+color[0]+color[4]+">"+color[0]+"      : Ausgabe der Strings EIN/AUS             |\n");
  write("| "+color[4]+"zunt  <");
  if (unters==1) write(color[2]);
  write("Ein"+color[0]+color[4]+"/");
  if (unters==0) write(color[2]);
  write("Aus"+color[0]+color[4]+">"+color[0]+"      : Automatisch Details untersuchen EIN/AUS |\n");
  write("| "+color[4]+"znot  <");
  if (notify==1) write(color[2]);
  write("Ein"+color[0]+color[4]+"/");
  if (notify==0) write(color[2]);
  write("Aus"+color[0]+color[4]+">"+color[0]+"      : Anzeige bei neuen Sachen im Inv EIN/AUS |\n");
  write("| "+color[4]+"znpc   <Stufe>"+color[0]+"       : Standard NPC Werte                      |\n");
  write("| "+color[4]+"zkill  <Npc1> <Npc2>"+color[0]+" : NPC's gegeneinander kaempfen lassen     |\n");
  write("| "+color[4]+"zek    <von> <bis>"+color[0]+"   : Liste der Erstkillermonster             |\n");
  write("| "+color[4]+"zprop  [string]"+color[0]+"      : Liste aller Properties des Objektes     |\n");
  write("| "+color[4]+"zal    [string]"+color[0]+"      : Align String setzen                     |\n");
  write("| "+color[4]+"zra    [string]"+color[0]+"      : Race String setzen                      |\n");
  write("| "+color[4]+"zea    [string]"+color[0]+"      : Echoall an alle Spieler OHNE Kanal      |\n");
  write("|                                                                |\n");
  write("| "+color[4]+"zumg   [Spieler]"+color[0]+"     : Environment                             |\n");
  write("| "+color[4]+"zcl    <Spieler>"+color[0]+"     : Clonerliste                             |\n");
  write("| "+color[4]+"zekk   <Spieler>"+color[0]+"     : Gekillte Erstkiller-monster             |\n");
  write("| "+color[4]+"zeknk  <Spieler>"+color[0]+"     : NICHT gekillte Erstkiller-monster       |\n");
  write("| "+color[4]+"zausr  <Spieler>"+color[0]+"     : Rueste Testspieler/Magier aus           |\n");
  write("| "+color[4]+"zheil  <Spieler>"+color[0]+"     : Testspieler/Magier komplett heilen      |\n");
  write("| "+color[4]+"ztrans <Spieler>"+color[0]+"     : Transt ohne Log-File-Eintrag            |\n");
  write("|                                                                |\n");
  write("| "+color[4]+"zkwer [mud] <opt>"+color[0]+"    : kwer an Mud senden                      |\n");
  write("|                                                                |\n");
  write("|                                  "+color[3]+"Version: "+version+" vom "+datum+" |\n"+color[0]);
  write("+================================================================+\n");
  return 1;
}

int sort_fkt(string a, string b) {
  if (stringp(map[a]) && stringp(map[b])) {
    return (map[a] > map[b]);
  } else {
    return (sprintf("%O", map[a]) > sprintf("%O", map[b]));
  }
}

// xeval printf("%O\n",sort_array(m_indices(environment(find_player("zordan"))->QueryProp("details")),#'>))

void showdet(int header,string str) {
  string filename,*indices,indice;
  int i,groesse,anzahl;
  filename=file_name(here)+".lpc";
  if (header==1) {
    write("=============================================================================\n");
    write(color[1]+"Aktuelle Datei:   "+filename+"\n");
    write(         "Dateigroesse:     "+file_size(filename)+"\n");
    write(         "Userid der Datei: "+getuid(here)+"\n"+color[0]);
    write("=============================================================================\n");
  }
  write(color[2]+color[1]+"\nSuchbegriff: "+str+"\n\n"+color[0]);
  if (!map) {  
    write("Nicht definiert worden!\n");
    write("=============================================================================\n");
  } else {
    anzahl=groesse=sizeof(map);
    indices=sort_array(m_indices(map),"sort_fkt");
    for (i=0;i<groesse;i++) {
      indice=indices[i];
      if (mappingp(map[indice])) { map[indice]="RASSE:\n"+map[indice][0]; }
      if ((config==1) && (unters==0)) { write(color[0]+color[2]); }
      if ((i<(groesse-1)) && (map[indice]==map[indices[i+1]])) {
        anzahl--;
        if (unters==0) { write(DEFAULT(indice)+", "); }
      } else {
        if (unters==0) { write(DEFAULT(indice));
        } else {
          write(color[2]+"\nUntersuche: "+indice+color[0]+"\n");
          if (str=="Details") { TP->command_me("unt "+indice); }
        }
        if (unters==0) {
          if (config==1) {
            write(":\n"+color[0]);
            if (stringp(map[indice])) { write(color[3]+map[indice]+"\n"); } 
            else { write(sprintf(color[3]+"%O\n", map[indice])); }
          } else {
            write(".\n");
          }
        }
      }
    }
    write(color[0]+"-----------------------------------------------------------------------------\n");
    write(color[1]+"Anzahl gefunden: "+anzahl+"("+groesse+").\n"+color[0]);
    write("=============================================================================\n");
  }
}

int showdetails() {
  here=ENV(TP);
  map=here->QueryProp(P_DETAILS)+here->QueryProp(P_SPECIAL_DETAILS)+here->QueryProp(P_READ_DETAILS);
  showdet(1,"Details");
  return 1;
}

