// willenskraft.c 
// Das Object zum Willenskraft-Spell 
// 1997-10-14  Feyaria@SilberLand

#include <moredef.h>
#include <defines.h> 

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0); 
  SetProp(P_NAME, 0);
  AddId( ({"\nberserker_willenskraft"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0 );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if( intp(dam_type) )
    dam_type= ({dam_type});
  if( member(dam_type, DT_TERROR)!=-1 )
    return random(300);  
  if( member(dam_type, DT_SOUND)!=-1 )
    return random(250);  
  if( member(dam_type, DT_MAGIC)!=-1 )
    return random(220);  
  if( member_array(dam_type, ({DT_COLD, DT_FIRE}))!=-1 )
    return random(200);  
  if( member_array(dam_type, ({DT_HOLY, DT_UNHOLY}))!=-1 )
    return random(150);  
  if( member_array(dam_type, ({DT_POISON, DT_ACID}))!=-1 )
    return random(100);  
  if( member_array(dam_type, ({ DT_WATER, DT_AIR, DT_LIGHTNING, 
      DT_EXPLOSION, DT_LIGHT, DT_ELECTRIC}) )!=-1 )
    return random(70);  
}

void init()
{
  ::init();
  if( MENV->QueryProp(P_GUILD)!= "berserker")
    call_out("remove",0);
}

void willenskraft(int suc, int abil)
{
  int c, h, time; 
  string* prot;
  if( file_name(PO)!="/spellbooks/berserker_spells" )
  {
    call_out("remove",0);
    return;
  }
  c=random(suc+abil)/1200+MENV->QueryProp(P_GUILD_LEVEL);
  h=random(suc+abil)/1200+MENV->QueryProp(P_GUILD_LEVEL);
  time=random(suc+abil)/50+MENV->QueryProp(P_GUILD_LEVEL)*8;

  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:c, T_HEAT_PROT:h ]) );
  DoWear(1);
  
  call_out("ende", time);
}

void ende()
{
  tell_object(MENV, "Dein Wille wird wieder schwaecher.\n");
  DoUnwear(1);
  call_out("remove",0);
}

