
/*
 * blaeulich schimmernder ring
 * hoehle wassergsit
 * ---
 * 
 */

#include "files.h"
#include <properties.h>
#include <combat.h>
#include <attributes.h>

inherit "std/armour";
int dex;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"ring", "geschicklichkeitsring", "ring der geschicklichkeit",
      "wasserring", "dexring"}));
  SetProp(P_SHORT, "Ein blaeulich schimmernder Wassering");
  SetProp(P_LONG,
    "Der Ring besteht aus einem Dir unbekanntem blaeulich schimmerndenn "
    "Kristall. In seinem Inneren scheint eine durchsichtige Fluessigkeit "
    "zu fliessen. Der Ring scheint eine verborgene Kraft zu haben...");
  SetProp(P_NAME, "Wasserring");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 1+random(5));

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 3900+random(500));
  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL:50, MAT_MISC_FLUID:50]));
  SetProp(P_MAGIC,1);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:15]) );
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_INFO, BS(
    "Dieser Ring verleiht seinem Traeger moeglicherweise zusaetzliche "
    "Geschicklichkeit."));
  dex=-1+random(3); 

  SetProp(P_CURSED,1);
  SetProp(P_NEVERDROP,1);
  if( dex<0 )
    SetProp(P_VALUE,0);
}

varargs int DoWear(int silent, int all)
{
  int ret;
  ret = ::DoWear (silent, all);
  if (QueryProp(P_WORN)) {
    SetProp (P_X_ATTR_MOD, ([ A_DEX:dex]) );
    this_player()->UpdateAttributes();
  }
  return ret;
}

varargs int DoUnwear(int silent)
{
  int ret;
  ret = ::DoUnwear (silent);
  if (!QueryProp(P_WORN)) {
    SetProp (P_X_ATTR_MOD, 0 );
    this_player()->UpdateAttributes();
  }
  return ret;
}

