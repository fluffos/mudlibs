inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;

void create()
{
  ::create();
  h = 1;
  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befemdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und abstossender "
    "Art!");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel wohl "
    "errichtet haben mag.");
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
    "Die Decke ist gut zwanzig Fuss hoch und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"wand", "waende"}), 
   "In den Waenden sind Nischen eingebaut. Beim genaueren Hinsehen bemerkst "
   "Du eine Ausbuchtung.");
  AddDetail( ({"ausbuchtung", "ausbuchtungen"}), 
    "Nanu, das ist ja eine Nase.");
  AddDetail( ({"kerze", "kerzen"}),
    "Noch immer fragst Du Dich, wer die hier aufgestellt haben mag aber wenn "
    "Du Dir es genau ueberlegst, willst Du es eigentlich gar nicht so genau "
    "wissen.");
  AddDetail( ({"nische", "nischen"}), 
    "Kerzen stehen in den Nischen.");
  AddDetail ("boden",
    "Ziemlich staubig.\n");
  AddSpecialDetail(({"nase", "nase"}), "nase");

  AddCmd("ziehe", "ziehe");

  AddExit("oben", ROOM "bya");
  AddExit("unten", ROOM "shub");
  AddItem( NPC "az", REFRESH_DESTRUCT);
}

nase()
{
   if (h)
        return "Zieh mal dran :-).\n";
    else
        return "Voellig uninteressant die Nase.\n";
}

ziehe(str)
{
    notify_fail("Woran moechtest Du denn ziehen?\n");
    if (!str || str!="nase")
        return 0;
    if (set_light(0)<1)
    {
     write("Es ist zu dunkel.\n");
       return 1;
    }
    if (this_player()->QueryProp(P_BLIND))
    {
        write("Du bist blind!\n");
        return 1;
    }
    if (!h)
        write("Du ziehst an der Nase aber nichts passiert.\n");
    else
    {
        h = 0;
        write(BS(
          "Du ziehst an der Nase und fuehlst, wie Dich eine herrliche "
          "Waerme durchstroemt. Die Nase ruempft sich kurz." ));
        this_player()->heal_self(150);
        call_out("my_reset", 600);
    }
    return 1;
}

my_reset() { h = 1; }



