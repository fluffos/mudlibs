
/* nymphen1.c */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

int liliegepflueckt;

create ()
{
  ::create();
  
//  liliegepfueckt=0;
  
  SetProp(P_INT_SHORT, "Ein glitzernder Teich");
  SetProp(P_INT_LONG,
	  "Du fuehlst weissen Schaum deine Lippen benetzen und an deinen "+  
	  "Wimpern haengenbleiben. Einen Schmetterlingsfluegelschlag lang "+  
	  "bleibst du einfach nur stehen und fuehlst dich seltsam "+
	  "berauscht. Deine Augen gewoehnen sich langsam an das saphirene "+  
	  "Glitzern und Gleissen um dich herum. Ein schmaler Wasserfall "+  
	  "ergiesst sich in das dunkelgruene Becken an dessen Rand du "+  
	  "stehst und dessen Wunder dir - je laenger du es betrachtest "+
	  "immer unheimlicher wird. Er verliert sich in nebelumhangen "+  
	  "Hoehen, doch du willst nicht mehr wissen was da oben auf dich "+  
	  "wartet. Das Wasser scheint mit dir zu sprechen.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  //(P_ENVIROMENT, ([TERRAIN TYPE:TT_????, ENV_TEMPRATURE:30]);

  AddDetail( "schaum",
	    "Kleine weisse Blaeschen, die durch den Aufprall der "+  
	     "Wassermassen herumwirbeln legen sich wie ein Schleier "+  
	     "von Eiskristallen auf dein Gesicht und deine Haende "+  
	     "Fast ist es, als wuerden sie sich in deine Lippen schneiden.");  
  AddDetail( "blaeschen",
	     "du streckst deine Zunge heraus und fuer einen Augenblick "+
	     "ist es dir, als wuerden sie schwer und suesslich schmecken.");
  AddDetail( "zunge",
	     "Ein mit Geschmackspapillen uebersaehtes oft nuetzliches "+  
	     "Koerperteil. ;)");
  AddDetail( "augenblick",
	     "manche augenblicke sind wie in bernstein gegossene "+
	     "Insekten. Dieser ist einer davon.");
  AddDetail( "Insekten",
	     "Jetzt - denn du gehoerst wahrscheinlich auch zu den Leuten "+  
	     "die es vorziehen zu forschen, als Poesie zu betreiben  - "+  
	     "entdeckst du tatsaechlich einen Schwarm blutroter Libellen "+  
	     "die ihre Kreise ueber dem Teich ziehen.");
  AddDetail( ({ "kreise", "libellen" }),
	     "Die zierlichen, durchschimmernden Geschoepfe, die aus "+  
	     "Sternenstaub gemacht sein koennten, schweben ohne den "+  
	     "Anschein einer Ordung zu erwecken in der suesslichen Luft");
  AddDetail( ({ "sternenstaub", "sterne" }),
	     "Du denkst kurz an Meteore und Galaxien, an dein altes "+  
	     "Fernrohr, das vermutlich am Dachboden verstaubt, doch "+  
	     "dein Schicksal schien es nicht gewollt zu haben, dass "+  
	     "du in einer Dachstube verrottest. All das hier liegt "+  
	     "unerkundet vor dir.");
  AddDetail( "ordnung",
	     "Einige Minuten andaechtige Beobachtung eroeffnen dir jedoch "+  
	     "verborgene Libellenriten und Libellenworte.");
  AddDetail( ({ "libellenriten", "libellenordung", "ordnung", "riten" }),
	     "Du legst deinen Kopf schief. Ganz unanzweifelbar, sie "+  
	     "scheinen dich zu warnen!");
  AddDetail( "luft",
	     "Die Luft wiegt bleischwer in deinen Lungen, sie laesst "+
	     "dich taumeln, dein Geist ist benommen und dein Herz "+
	     "laechelt muede.");
  AddDetail( "beobachtung",
	     "Traege folgen deine Pupillen den Libellen, du bewunderst "+  
	     "ihre Anmut, das Blitzen in ihren orangen Facettenaugen "+  
	     "und ihre seidenpapierenen Fluegel.");
  AddDetail( ({ "blitzen", "facettenaugen",  }),
	     "Nein, diese Geschoepfe sind dir sicher nicht feindlich "+  
	     "gesinnt. Du glaubst Freundschaft in ihren Augen zu lesen.");
  AddDetail( "freundschaft",
	     "...Wunderbare Sache :)");
  AddDetail( "geschoepfe",
	     "Wie wir alle hier");
  AddDetail( "fluegel",
	     "Selbst purpurne, wie verzaubert wirkende Libellen brauchen "+
	     "nun mal Fluegel, auch wenn diese Exemplare hier besonders "+
	     "unwirklich erscheinen.");
  AddDetail( "schwarm",
	     "Es muessten so um die 20 Libellen sein, die in der Luft hin "+
	     "und her schaukeln.");
  AddDetail( ({ "aufprall", "wassermassen" }),
	     "Unbaendige Macht und Kraft zerfliesst in Schaum und entlaedt "+
	     "sich in ohrenbetaeubendes Brausen.");
  AddDetail( "brausen",
	     "Erst allmaehlich gewoehnen sich dienen Ohren daran, doch "+
	     "aufeinmal ist nur mehr Fluestern, Wispern und ferner Gesang "+
	     "um dich herum.");
  AddDetail( "fluestern",
	     "''Tritt naeher Fremdling, versenke deinen Geist in "+
	     "undenkbare Tiefen - Verwandlung naht, unabwendbar, denn der "+
	     "Weg zurueck ist blutig und nochniegegangen''");
  AddDetail( "fremdling",
	     "Auch wenn du es nicht wahrhaben willst, es meint dich und "+
	     "haelt dich schon gefangen.");
  AddDetail( "tiefen",
	     "du blickst ein wenig verwundert auf die Wasseroberflaeche "+
	     "doch je laenger du deinen Blick darin versenkst, desto  "+
	     "traeger wird dein Denken. Gedankengespinste legen ihre "+
	     "feinen, tueckischen Fangarme in deinem Geist aus. Du "+
	     "erschauderst und wendest dich ab. Gaensehaut rieselt ueber "+
	     "deinen Ruecken. Ob du dich ein zweites Mal wirst entziehen "+
	     "koennen?");
  AddDetail( ({ "wasseroberflaeche", "oberflaeche", "teich" }),
	     "Sosehr du dich bemuehst, den Grund zu erspaehen, nach einigen "+
	     "Metern scheint das saphirene klare Wasser zu rauchiger Jade "+
	     "zu werden.");
  AddDetail( "grund",
	     "Aufeinmal weisst du, dass tief unten all das verborgen liegt "+
	     "was du dir jemals gewuenscht hast und du dir jemals wuenschen "+
	     "wirst.");
  AddDetail( ({ "fangarme", "gedankengespinste", "gespinste" }),
	     "Wirre Bilder versunkener Wuensche ziehen an deinen Augen "+
	     "vorueber. Angstschweiss glaenzt auf deiner Nasenspitze. "+
	     "Und die mit Orchideenduft geschwaengerte  Atmosphaere legt "+
	     "ihren Bann auf dich.");
  AddDetail( ({ "bilder", "wuensche" }),
	     "Mythische Gestalten einer Erinnerung an ein frueheres Leben "+
	     "entsprungen.");
  AddDetail( "gestalten",
	     "Schlanke Wesen, ihr Haar algenverwoben, ihre Blick ueberall "+
	     "zugleich, ihre Haut perlmuttschimmernd.");
  AddDetail( "wesen",
	     "Du weisst nicht, ob sie sanft oder grausam sind - vielleicht "+
	     "wirst du es nie wissen.");
  AddDetail( ({ "haar", "haut" }),
	     "Ihr Aussehen ist von schmerzhafter Schoenheit.");
  AddDetail( "schoenheit",
	     "Dir scheint es absurd, das Menschen ueber Schoenheit streiten "+
	     "konnten, wo doch s i e exestieren.");
  AddDetail( ({ "verwandlung", "bann" }),
	     "Noch fuehlst du dich selbst, doch die Traegheit wiegt schwer "+
	     "und dein Blick ist kaum noch von der Wasseroberflaeche "+
	     "abzuhalten.");
  AddDetail( "wispern",
	     "''Komm zu uns, was haelt dich - sprich!''");
  AddDetail( "gesang",
	     "verzaubernde Toene ");
  AddDetail( "toene",
	     "Du kannst sie nicht wirklich hoeren, aber du fuehlst sie. ");
  AddDetail( ({ "orchideenduft", "duft", "orchideen", "ufer" }),
	     "Suchend spaehst du das schmale Ufer entlang und entdeckst "+
	     "dunkelviolette Wasserlilien, deren Staubgefaesse, das "+
	     "Sonnenlicht in all seine Farben brechen und irritierende "+
	     "Gerueche aussenden ");
  AddDetail( "staubgefaesse",
	     "Wie die Zungen kleiner Farne ringeln sich die ueberladenen "+
	     "Staubgefaesse gen Himmel und entlassen eine Wolke glitzender "+
	     "Pollen bei der geringsten Erschuetterung ");
  AddDetail( "erschuetterung",
	     "Jetzt hast du dich bewegt und ein paar Pollen verirren sich "+
	     "in deine Nase ");
  AddDetail( ({ "pollen", "staubgefaesse", "wasserlilie" }),
	     "Die schwarzblauen Orchideensamen haben die Form kleiner "+
	     "Sterne. Sie setzen sich in deiner Nasenschleimhaut fest. "+
	     "Aufeinmal weisst du, dass du diese Blume in Haenden halten "+
	     "musst.");
  AddDetail( "eiskristalle",
	     "Ja diese Troepfchen sind fast ebenso ebenmaessig schoen.");
  AddDetail( ({ "gesicht", "haende", "lippen" }),
	     "Du fuehlst einen stechenden Schmerz ");
  AddDetail( "schleier",
	     "Ein bisschen Leben ist auch in diesen Blaeschen, dessen bist "+
	     "du dir sicher. ");
  AddDetail( "wimpern",
	     "Ein Vorhang aus Troepfchen haengt an deinen Wimpern ");
  AddDetail( "troepfchen",
	     "Du blinzelst 2,3 mal und sie sind zu boden gefallen.");
  AddDetail( ({ "schmetterlingsfluegelschlag", "fluegelschlag" }),
	     "Und schon ist ist er wieder vorbei ;) ");
  AddDetail( ({ "glitzern", "gleissen" }),
	     "Es ist so hell, das es dich kurz blendet und alles um dich "+
	     "zu tanzen beginnt ");
  AddDetail( ({ "wasserfall", "ursprung" }),
	     "Sosehr du dich anstrengst, seinen Ursprung kannst du nicht "+
	     "ausmachen. Die Hoehen bringen ein wenig Kuehle zu dir. "+
	     "Doch sie bedeuten dir nichts ");
  AddDetail( ({ "hoehen", "hoehe" }),
	     "Vielleicht bringt dich ein anderes Abenteuer dort hinauf. "+
	     "Aber dazu musst du erst dieses bestehen. ");
  AddDetail( "becken",
	     "Die Wasserflaeche ist unnatuerlich rund, kein Schilf waechst "+
	     "an ihrem Rand, kein gelbes Kroetenauge lugt unter  "+
	     "Seerosenblaettern hervor, kein Vogel zeigt sich am Ufer, "+
	     "die klare Perfektion dieses Ortes ist nicht in Worte zu "+
	     "fassen. ");
  AddDetail( ({ "schilf", "vogel", "kroeten", "kroetenauge", "blaetter", "voegel", "seerosenblaetter", "blaetter" }),
	     "Die Abwesenheit dieser Dinge erscheint dir aufeinmal ganz "+
	     "selbstverstaendlich. ");
  AddDetail( "rand",
	     "Dieser Teich muss schon immer da gewesen sein, von "+
	     "Zauberhand geschaffen, denn seine Symmetrie erscheint dir "+
	     "weder gewachsen noch kuenstlich erzwungen. ");
  AddDetail( "wasser",
	     "Noch nie hat dich etwas so bezaubert und gefangengehalten. ");

	     
		  
		



  AddCmd( ({ "sprich", "sprech" }), "wasserantwort");
  AddCmd( ({ "fuehle", "fuehl" }), "tongefuehl");
  AddCmd( ({ "pflueck", "pfluecke" }), "pfluecken" );
  AddExit("sueden","kobold1");
}

reset() 
{
  ::reset();
//  liliegepflueckt=0;
}

tongefuehl(string str)
  {
    notify_fail("Was willst du fuehlen?\n");
    if(!str) return 0;
    if(str=="toene" || str=="ton" || str=="gesang" || str=="gesaenge")
      { write("Es sind wortlose Gesaenge, die deine Sehnsucht nach der "+
	      "Tiefe wecken.\n");
      return 1;
      }
    return 0;
  }  
	       

wasserantwort(string str)
{
  if(!str) write("''Was willst du sprechen? Was kann schoener sein, als unsere Verheissungen?''\n");      
  if(str) write("''Sterblicher Tor! Nichtigkeiten kommen aus deinem Mund! All das "+
	       "verblasst vor dem, das wir dir bieten!''\n"+
	       "Tief in deinem Innersten glaubst du ihnen bereits.\n");
  return 1;
}

pfluecken(string str)
{
  if(!liliegepflueckt)
    {
      CLONETP("lilie");
  //    liliegepflueckt=1;
      return 1;
    }
}


  
	     
    
    
	     

	     
			
	     
	     






















	     
