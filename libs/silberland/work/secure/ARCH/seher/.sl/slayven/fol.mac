; /fol <spielername> = folgemodus an, /st = folgemodus aus
;(c) by Ed

/def fol = /folgo %1%;/folbet %1%;/folver %1%;/folrun
/def -mregexp -ah -p99 -t'nach ende.' antifies1
/def -mregexp -ah -p99 -t'nach quit.' antifies2
/def -mregexp -ah -p99 -t'nach ta.' antifies3

/def folgo = /def -mregexp -t'["> "]*$[strcat(toupper(substr(%1,0,1)),substr(%1,1))] .* nach ([A-Za-z0-9 ]*).' going = /nachrenn %%P1
/def nachrenn = $[tolower(%1)]

/def folrun = /def -mregexp -t'["> "]*$[strcat(toupper(substr(%1,0,1)),substr(%1,1))] .* runter\\.' goingrun = /nachrenn runter

/def folbet = /def -mregexp -t'["> "]*$[strcat(toupper(substr(%1,0,1)),substr(%1,1))] betritt.* ([A-Za-z0-9]*)\\.' goingbet = /betritt %%P1
/def betritt = betrete $[tolower(%1)]

/def folver = /def -mregexp -t'["> "]*$[strcat(toupper(substr(%1,0,1)),substr(%1,1))] verlaesst.* ([A-Za-z0-9]*)\\.' goingver = /verlaesst %%P1
/def verlaesst = verlasse $[tolower(%1)]
/def st = /undef going

/def -b'\\^' fb = /send 1%;/send 2%;/send 3%;
