             ]));
  AddSpell("kopfstoss",15,
            ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:6]),
             SI_SKILLRESTR_USE: ([SR_FUN:"FroschTest", A_DEX:17]),
