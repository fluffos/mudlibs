/*  Die Spells und Skills

Skill axe_figthing
  Besser Kaempfen mit Aexten
  Ab Gildenstufe 1

zerstoerung
  Damit kann man Dinge zerstoeren, es kann aber passieren, dass man
  sich dabei selber verletzt.
  SP:4, Ab Gildenstufe 1

waffenkunde
  Schaetzt eine Waffe ein und gibt P_INFO aus (wenn vorhanden)
  SP:11, Ab Gildenlevel 1

schaetz
  Schaetzt die Kampfkraft des Gegners ein
  SP:4, Ab Gildenstufe 2

zertreten
  Angriff nur gegen kleine Gegner, Schaden abhengig vom Gewicht
  der Schuhe, Schaden zwischen 60 und 444
  SP:8, Ab Gildenstufe 2

wueten
  Die Anwesenden erschrecken
  SP:7, Ab Gildenstufe 3

augeinauge
  Hierbei konzentriet man sich auf einen Gegner und trifft ihn oefters
  Man bekommt auch hin und wieder eine Meldung, wie es dem Gegner so geht
  SP:12, Ab Gildenstufe 3
 
regeneration
  Schnellere Regeneration und ueberwindung von gift, taub, blind und frosch
  SP:30, Ab Gildenstufe 4

rammen
  Einen Gegner zu Boden stossen
  SP:6, Ab Gildenstufe 4

kampfschrei
  Angriffsspell, bei schwachen Gegnern wird P_WIMPY gesetzt
  SP:10, Ab Gildenstufe 5
 
willenskraft
  Durch blosse Willenskraft schafft man es, den Koeper gegen Umwelteinfluesse
  zu schuetzen, zB gegen Hitze, Kaelte und bestimme magische Schadenstypen
  SP:20, Ab Gildenstufe 5

kopfstoss
  Angriff gegen gleichgrosse Gegner, Schaden abhaengig vom
  Gewicht des Helms, Schaden zwischen 10 und 555
  SP: 12, Ab Gildenstufe 6

eisenhaut
  Staerkt die Ruestung
  SP:25, Ab Gildenstufe 6

spalten
  Harter Hieb mit der Axt, versucht den Gegner zu toeten
  SP:50, Ab Gildenstufe 7

blutrausch
  Mehrere schnelle und harte Attacken, Ruestung wird gestaerkt,
  aber man kann nicht fliehen
  SP:130, Ab Gildenstufe 8

schlachtruf
  Kampfanfang, Schaden gegen alle Gegner
  SP:20, Ab Gildenstufe 9
  
*/

#include <properties.h>
#include <language.h>
#include <attributes.h>
#include <combat.h>
#include <doors.h>
#include <living/combat.h>
#include <wizlevels.h>
#include <new_skills.h>
#include <moving.h>
#include <class.h>
#include "/gilden/berserker/def.h"

#define DB(x) tell_object(find_player("feyaria"),x)

inherit "/std/spellbook";

