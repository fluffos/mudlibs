inherit "/obj/container";

#include <language.h>
#include <properties.h>
#include <container.h>
#include <defines.h>

#define TP this_player()


create()
{
  ::create();
  SetProp(P_NAME, "Eisentruhe");
  SetProp(P_SHORT, "Eine Eisentruhe");
  SetProp(P_LONG, "Die Eisenruhe ist mit einem Symbol und einer Inschrift verziert.\n"
	  + "Ausserdem besitzt sie ein riesiges Goldschloss.\n"); 
  AddId("eisentruhe");
  AddId("truhe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 10000);
  SetProp(P_MAX_WEIGHT, 20000);
  SetProp (P_NOGET, "Du kannst die Eisentruhe nicht mitnehmen.\n");
  SetProp (P_MATERIAL, MAT_MISC_METAL);
  AddCmd("oeffne", "oeffneet");
}

oeffneet(string str)
{
  notify_fail("Was willst Du oeffnen?");
  if (!str) return 0; 
  if(!id(str)) return 0;
  { 
    if( TP->query_real_name() == "slayven" ) 
	{
	  write( "Du oeffnest die Eisentruhe.\n"
		 + "Edelsteine, Rubine, Smaragde, Gold und Silber glaenzen Dir entgegen. "
		 + "Stolz stellst du fest, dass alle diese Reichtuemer in deinem Besitz sind. "
		 + "Du seufzt einmal gluecklich und schliesst zufrieden wieder die Truhe.\n");
	  say ("Slayven oeffnet eine Eisentruhe.\n"
	       + "Du kannst Edelsteine, Rubine, Smaragde, Gold und Silber in der Truhe erkennen. "
	       + "Du kannst kaum glauben das ein Hobbit so reich sein kann. "
	       + "Dir bleibt der Mund offen.\n"
	       + "Slayven begutachtet seine Reichtuemer, seufzt dann gluecklich und schliesst "
	       + "mit einem zufriedenen Blick wieder die Truhe.\n"
	       + "Du schuettelst deinen Kopf, kommst wieder zu Dir und schliesst den Mund.\n");
	  return 1;
	}
      else
	{
	  write("Du versuchst mit aller Gewalt die Eisentruhe zu oeffnen, aber es gelingt dir nicht.\n");
	  say (this_player()->name(WER,2)+" versucht mit aller Gewalt vergeblich die Eisentruhe zu oeffnen.\n"); 
	  return 1;
	}
    }
}















