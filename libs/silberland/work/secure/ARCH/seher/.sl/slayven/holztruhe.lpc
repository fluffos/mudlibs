inherit "/obj/container";

#include <language.h>
#include <properties.h>
#include <container.h>
#include <defines.h>

#define TP this_player()
#define TPN this_player()->name()
#define CAP_TPN capitalize(this_player()->name())

create()
{
  ::create();
  SetProp(P_NAME, "Holztruhe");
  SetProp(P_SHORT, "Eine Holztruhe");
  SetProp(P_LONG, "Eine einfache Holztruhe.\n"
	  + "Slayven hat sie fuer all seine Freunde hier aufgestellt.\n");
  AddId("holztruhe");
  AddId("truhe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 10000);
  SetProp(P_MAX_WEIGHT, 20000);
  SetProp (P_NOGET, "Du kannst die Holztruhe nicht mitnehmen.\n");
  SetProp (P_MATERIAL, MAT_MISC_WOOD);
  AddCmd("oeffne", "oeffneht");
  AddCmd(({"schliess", "schliesse", "verschliesse"}), "schliesseht");
}

oeffneht(string str)
{
  notify_fail("Was willst Du oeffnen?");
  if (!str) return 0;  
  if(!id(str)) return 0; 
  {
    if (QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN)
      return write ("Aber die Holztruhe ist doch schon offen!\n"), 1;
    write ("Du oeffnest die Holztruhe.\n");
    say (CAP_TPN+" oeffnet die Holztruhe.\n");
    SetProp (P_CNT_STATUS, CNT_STATUS_OPEN);
    return 1;
  }
}

schliesseht(string str)
{
  notify_fail("Was willst Du schliessen?");
  if (!str) return 0;  
  if(!id(str)) return 0;
  {
    if (QueryProp(P_CNT_STATUS) != CNT_STATUS_OPEN)
      return write ("Aber die Holztruhe ist doch gar nicht offen!\n"), 1;
    write ("Du schliesst die Holztruhe.\n");
    say (CAP_TPN+" schliesst die Holztruhe.\n");
    SetProp (P_CNT_STATUS, CNT_STATUS_CLOSED);
    return 1;
  }
}















