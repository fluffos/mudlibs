// Seherhaus von Kara
//
// Progged by Kara
//
// 1998-02-11
//
// last updated: 1998-03-22 
//

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

create()
{
  ::create();


SetProp( P_INT_SHORT, "Karas Haus" );
SetProp( P_INT_LONG, BS
         ("Das ist das Seherhaus von Kara.\n"
          "Es ist schlicht eingerichtet. Die Waende und die Tuer sind sehr " 
          "dunkel gehalten, nur die Decke ist hell.\n" 
          "In der Mitte des Zimmers steht ein riesiges Bett. Ausserdem "
          "erkennst du in einer Ecke einen Tisch mit einem Kaefig darauf.\n" 
          "Vor dem Fenster weht ein schwarzer Vorhang.\n"));

SetProp( P_LIGHT, 1 );
SetProp( P_INDOORS, 1 );
SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 24 ]) );

  
   

AddSmell( DEFAULT_SMELL, 
   "Merkwuerdig, aber hier im Haus riecht es stark nach Heu.\n");
AddSound( DEFAULT_SOUND,
  "Von einer Ecke her hoerst Du Stroh rascheln und ein "
  "anderes, seltsames Geraeusch.\n");
AddSound( ("geraeusch"),
  "*R        A        T        S        C        H *\n"  
  "Papier wird zerrissen. Du hast dir ja gleich gedacht, "
  "dass dir dieses Geraeusch bekannt vorkommt.\n");
AddDetail( ("gerauesch"),"Versuch es mal mit lauschen !\n"); 

AddDetail( ({"stroh","heu"}),
   "Meerschweinchen essen gerne frisches Stroh.\n");
AddDetail( ({"papier","zeitungspapier","zeitung"}),
  "Am Boden des Kaefigs liegt glattgestrichenes "
  "Zeitungspapier, jedoch ab und zu kannst du einige "
  "Papierhaufen erkennen.\n");
AddDetail( ({"papierhaufen","haufen","hobby","bauten"}),
   "Das liebste Hobby von Karas Meerschweinchen ist es Papier zu "
   "zerreissen und kleine Bauten daraus zu machen.\n");
AddDetail( ("meerschweinchen"),
   "Meerschweinchen sind kleine Nagetiere.\n"
   "Sie haben einen plumpen Koerper, ein struppeliges Fell und "
   "ein suesses Gesicht. Und Kara ist ganz verrueckt nach den "
   "kleinen Viehchern !\n");
AddDetail( ({"nagetiere","maeuse","ratten","hamster","hoernchen","biber"}),
   "Meerschweinchen,Maeuse,Ratten,Hamster,Hoernchen und Biber "
   "gehoeren zur Familie der Nagetiere.\n");
AddDetail( ({"fell","haare"}),
   "Die Haare der Meerschweinchen gibt es in den "
   "unterschiedlichsten Laengen und Farben.\n");
AddDetail( ({"laenge","haarlaengen"}),
   "Aufgrund ihrer Haarlaenge werden die Meerschweinchen in zwei "
   "Rassen eingeteilt: Kurzhaar- oder Langhaarmeerschweinchen.\n");
AddDetail( ({"kurzhaar","kurzhaarmeerschweinchen"}),
   "Zu der Familie der Kurzhaarmeerschweinchen gehoert das "
   "Aguti-, Albino-, Himalaya-, Hollaendische, Schnecken-"
   " und das Schildpattmeerschweinchen.\n");
AddDetail( ("langhaarmeerschweinchen"),
   "Zu der Familie der Langhaarmeerschweinchen gehoert das "
   "Rosetten-, Angorameerschweinchen und das Peruanische Seidentier.\n");     
AddDetail( ({"farben","farbe"}),
   "Das Fell des Meerschweinchen kann schwarz, braun, rot, orange,"                  
   " weiss, silber, grau, beige und lila sein.\n");
AddDetail( ("tisch"),
   "Der Tisch steht in einer Ecke des Raums.\n" 
   "Er besteht aus einer schoenen Glasplatte und einen silbernen " 
   "Metallgestell.\n"
   "Auf den Tisch stehen ein Kaefig, vier kleine Schafe, eine schoene "
   "Vase und eine Packung Schokobananen.\n");
AddDetail( ("vase"),
 "Die Vase ist ca. ein Meter hoch und besteht aus blauem, durchschimmernden "
 "Material.\n"
 "In der Vase siehst du getrocknete Rosen.\n");
AddDetail( ({"rosen","rose"}),
 "Drei gelbe und eine rote langstilige Rose.\n"
 "Kara hat die Rosen von Sengir immer zum Valentinstag bekommen und sie "
 "sorgfaeltig getrocknet, damit sie fuer ewig halten.\n");
AddDetail( ("valentistag"),
 "Valentinstag ist am 14. Februar.\n");
AddDetail( ({"material","aquamarien"}), 
 "Bei dem Material handelt sich um Aquamarin.\n");
AddDetail( ({"glas","glasplatte","platte"}),
   "Die Platte besteht aus getoentem Glas.\n");
AddDetail( ({"metallgestell","gestell","metall"}),
   "Das Metall, es handelt sich natuerlich um reines Silber, "
   "wurde extra von ein paar Zwergen aus dem Silberberg fuer " 
   "diesen Tisch abgebaut.\n");
AddDetail( ({"ecke","ecken"}),"Der Raum hat acht Ecken!   :) \n");
AddDetail( ("kaefig"),
   "Der Kaefig besteht aus einer Wanne und Gitterstaeben.\n" 
   "Im Kaefig erkennst du Papier, Fressen und eine Schachtel.\n");
AddDetail( ("fressen"),
   "Das Fressen des Meerschweinchen besteht hauptsaechlich aus "
    "Karotten, Gruenfutter, Stroh und Koerner.\n");
AddDetail( ("Schachtel"),
   "Die Schachtel besteht aus Karton und du kannst erkennen, "
   "dass drei Oeffnungen hineingeschnitten worden sind.\n");
AddDetail( ({"oeffnungen","oeffnung"}),
   "Bei den drei Oeffnungen scheint es sich um eine Tuer und "
   "zwei Fenster zu handeln.\n"
   "AH ! Ja, genau - Kara hat dir erzaehlt, "
   "dass ihr Meerschweinchen am Abend immer in sein " 
   "Haeuschen schlafen geht.\n");
AddDetail( ("haeuschen"),
   "Bei der Schachtel handelt es sich also um das Haeuschen des " 
   "Meerschweinchen.\n");
AddDetail( ({"gitterstaebe","gitter","staebe"}),
  "An den Gitterstaeben schaerft das Meerschweinchen gerne "
   "seine Zaehne. Die Staebe sind natuerlich auch aus reinem "
   "Silber. Kara scheint gute Beziehungen zu den Zwergen zu "
   "haben.\n");
AddDetail( ({"plastikwanne","wanne"}),
   "In der Plastikwanne ist uebereinander eine Schicht Papier, "
   "dann eine Schicht Streu und wiederum eine Schicht Papier gelegt. "
   "So fuehlt sich das Meerschweinchen am wohlsten.\n");
AddDetail( ({"schicht","papierschicht"}),
   "Einfach uebereinander geschlichtet, so wie ein Burger.    :)   \n");
AddDetail( ("streu"),
   "Manchmal kommt es vor, dass sich das Meerschweinchen durch "
   "die Papierschicht durchfrisst und sich dann im Streu waelzt.\n"
   "So wie die Wildschweine!\n"); 
AddDetail( ("gruenfutter"),
 "Meerschweinchen  L I E B E N jede Art von Gruenfutter.\n");
AddDetail( ({"karotte","karotten"}),
 "Die Karotten erhaelt Karas Meerschweinchen immer von seinem "
 "Freund dem Kaninchen.\n");
AddDetail( ("koerner"),
"    *K   N   A   C   K   S*\n");
AddDetail( ("kaninchen"),
 "Das Kaninchen kennst du sicher, es lebt nicht weit von Midas "
 "entfernt.\n");
AddDetail( ("kara"),
 "Kara, die Feenseherin, fuehlt sich eigentlich mehr als ein "
 "Meerschweinchen. Bei ihren Kampfzuegen und Erforschungen "
 "durch das Silberland wird sie immer von ihrem "
 "Meerschweinchen begleitet.\n"
 "Wenn du sie mal triffst,frag sie doch einfach mal nach ihrem "
 "treuen Gefaehrten.\n");
AddDetail( ("gefaehrte"),
 "Das Meerschweinchen ist ihr Gefaehrte.\n");
AddDetail( ("silberland"),
 "Das Silberland ist dieses tolle Mud, in dem du dich gerade "
 "befindest.\n");
AddDetail( ("kampfzuege"),
 "Kara kaempft gegen die schrecklichsten Monster und Bestien.\n");
AddDetail( ({"monster","bestien"}),
 "Vor den Monstern und den Bestien muss Kara nie Angst haben, "
 "weil sie ja von ihrem Meerschweinchen begleitet wird.\n");
AddDetail( ({"schaf","schafe"}),
 "Auf dem Tisch stehen vier verschiedene Schafe: ein schwarzes "
 "Schaf mit roter Muetze und Schal, ein braunes Schaf mit "
 "gruener Muetze und Schale, noch ein schwarzes mit einem Herz "
 "und ein weisses Schaf mit einem Gloeckchen.\n");
AddDetail( ("Muetze"),

      "\n"  
     "                       \\ //                           \n"
     "                         O                            \n"
     "                       (   )                          \n"
     "                      (     )                         \n"
     "                     (       )                        \n"
     "                    (         )                       \n"
     "                   (           )                      \n"
     "                  (_____________)                     \n"
     "                 (               )                    \n"
     "                (_________________)                   \n");

AddDetail( ("gloeckchen"),
   "\n"
   "*KLINGELINGELING*\n");
AddDetail( ("schal"),
 "Ein waermender Schal, damit die Schafe im Winter nicht krank werden.\n");
AddDetail( ("winter"),
 "Brrrr....Kalt!\n"
 "Den Winter mag Kara nicht besonders.\n");
AddDetail( ({"schokobananen","packung","bananen"}),
 "Ui! Leider ist die Packung leer! Da war Sengir wieder "
 "schneller.\n");
AddDetail( ({"Bild 1","1"}),
      " ___________________ \n"
    "  |                   |\n"        
    "  |      OO           |\n"
    "  |     %~ ~~~~~~~)   |\n"
    "  |    /  0        )  |\n"
    "  |  0(=           )  |\n"
    "  |    #__________/   |\n"
    "  |      W      W     |\n"
    "  |___________________|\n"
    "                       \n"
    "Darunter kannst du eine Inschrift lesen.\n");

AddDetail( ("inschrift"), "Du kannst sie lesen.\n");
AddReadDetail( ("inschrift"),
 "\n"
 "Das ist KARA, beziehungsweise das soll sie sein. Da hat wohl "
 "der Maler ein wenig gepatzt. :)\n");
AddDetail( ("maler"), "Kara selbst ist der Maler!");
AddDetail( ({"bild 2","2"}),
   "\n"
   "  __________________ \n"
   " !                  !\n"
   " !   |^         /|  !\n"
   " !   |  ^_|T|_/  |  !\n"
   " !   |    |T|    |  !\n"
   " !   |    [T]    |  !\n"
   " !   |   _|T|_   |  !\n"
   " !   |  / |T| ^  |  !\n"
   " !   |/   |T|   ^|  !\n"
   " !        |T|       !\n"
   " !        |T|       !\n"
   " !        |T|       !\n"
   " !__________________!\n"
   "                        \n"
   "Das ist Sengirs Todesaxt.\n");
AddDetail( ("todesaxt"), 
 "Sengir kaempft am liebsten damit.\n");
AddDetail( ({"bild","bilder"}),
 "Welches Bild meinst du denn? Bild 1 oder Bild 2?\n");
AddDetail( ("boden"),
 "Du stehst auf einem braunen, frisch polierten Parkettboden. Du siehst "
 "auch noch einen Teppich vor einem Bett liegen.\n" 
 "Ausserdem liegt in einer Ecke ein Knochen herum.\n");
AddDetail( ("teppich"),
 "Du gehst zum Teppich hinueber, legst dich auf den Teppich und faengst "
 "wie wild dich in den Teppich zu kuscheln.\n"
 "Hm! Ist der Teppich weich!\n"
 "Hoffentlich hat dich niemand gesehen! Da sind wohl "
 "wieder deine Gefuehle mit dir durchgegangen !\n");
AddDetail( ({"gefuehle","gefuehlsausbruch","ausbruch"}),
 "Das war aber ein haeftiger Gefuehlsausbruch !\n");
AddDetail( ("bett"),
 "In der Mitte des Zimmers steht ein riesiges Bett. "
 "Es ist so gross, dass es leicht den halben Raum erfuellt.\n"
 "Im Bett erkennst du Poelster, Decken und Stofftiere.\n");
AddDetail( ({"raum","zimmer"}),
 "Das Zimmer hat eine Decke, einen Boden und vier Waende.\n"); 
AddDetail( ("knochen"),
 "Der Knochen gehoert Idefix. Sie hat ihn wohl bei ihrem letzten Besuch "
 "vergessen.\n");
AddDetail( ("idefix"),
 "Obwohl Idefix ein Hund ist, ist sie die Schwester von Kara.\n");
AddDetail( ({"polster","poelster","kissen"}),
 "Im Bett liegen zwei grosse Poelster mit Ueberzuegen.\n");
AddDetail( ("ueberzuege"),
 "Die Ueberzuege bestehen aus Seide und sind rabenschwarz.\n");
AddDetail( ({"decken","lammwolldecken"}),
 "Du siehst mehrere Lammwolldecken, die schwarz gefaerbt sind.\n");
AddDetail( ({"stofftier","stofftiere"}),
 "Mitten zwischen den Kissen und Decken kannst du drei Stofftiere "
 "erkennen: ein Affe, ein Baer und ein Baerli.\n");
AddDetail( ({"affe","maxi"}),
 "Das ist Maxi der Affe.\n" 
 "Er hat einen gruen-weissen Strampelanzug an.\n "
 "Maxi gehoert Kara schon seit sie ein kleines Baby war.\n");
AddDetail( ("strampelanzug"),
 "So etwas hast du als Baby sicher auch angehabt.\n");
AddDetail( ("baby"), "*W   A  E  H   H    H     H      H*\n");
AddDetail( ("baer"),
 "Ein alter suesses Teddybaer. Sengir ist mit ihm aufgewachsen, und Kara "
 "kuemmert sich liebevoll um ihn, wenn Sengir mal nicht da ist.\n"); 
AddDetail( ("baerli"),
 "Das ist Baerli, auch ein lieber Teddybaer.\n" 
 "Er war ein Geschenk von Sengir an Kara. Seitdem schlaeft er immer " 
 "in Karas Bett.\n");
AddDetail( ("geschenk"),
 "Der Baerli war das erste Weihnachtsgeschenk von Sengir an Kara.\n");
AddDetail( ("teddybaer"),
 "Der Baerli und der Baer sind Teddybaeren.\n");
AddDetail( ("waende"),
 "Die Waende sind alle weiss gestrichen. An einer Wand erkennst du zwei "
 "Bilder, an einer anderen ist eine Tuer und ein Fenster.\n");
AddDetail( ("tuer"),
 "Die Tuer besteht aus schwarzem Zedernholz.\n"
 "Durch die Tuer kommst du wieder ins Freie.\n");
AddDetail( ("fenster"),
 "Ein einfaches Fenster mit einem Vorhang davor.\n");
AddDetail( ("vorhang"),
 "Der Vorhang besteht aus schwarzer Seide.\n");
AddDetail( ("seide"),
 "Die Seide fuehlt sich sehr weich an. Hm ist die weich, ist die neu?\n");
AddDetail( ("decke"),
 "Die Decke besteht aus hellen Holzlatten und du erkennst eine Lampe von "
 "der Decke haengen.\n");
AddDetail( ({"holzlatten","holz"}),
 "Das Holz stammte von Baeumen aus dem Holzfaellerlager.\n");
AddDetail( ("holzfaellerlager"),
 "Dazu kann dir Zordan sicher mehr erzaehlen.\n");
AddDetail( ("lampe"),
 "Bei der Lampe handelt es sich eher um einen Luster.\n"
 "Er besteht aus Kristall und spendet gedaemmtes Licht.\n");
AddDetail( ("luster"),
 "Ein riesiger Luster haengt von der Decke.\n");
AddDetail( ("kristall"),
 "Es stammte aus der Kristallhoehle.\n");
AddDetail( ({"kristallhoehle","hoehle"}),
 "Sie ist ein Bestandteil der grossartigen Artox-Quest.\n");
AddDetail( ("licht"),
 "Das Licht erzeugt eine romantische Stimmung im Raum.\n");
AddDetail( ("sengir"),
 "Sengir ist der Ehemann von Kara.\n"
 "Er ist einer der tapferesten und besten Seher im Silberland.\n"
 "Durch seine Siege gegen die gefaehrlichsten Gegner hat er sich viel Ruhm "
 "und Ehre im ganzen Land erworben.\n");
AddDetail( ({"ehemann","standesamt"}),
 "Kara und Sengir haben vor dem Standesamt im Silberlandam am ??? " 
 "geheiratet.\n");
}



