inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;

void create()
{
  ::create();
  h = 1;

  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]) );
  SetProp(P_INDOORS, 1);

  AddDetail ("boden",
    "Der ist ziemlich staubig.\n");
  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befemdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und abstossender "
    "Art! Auf einem der Altaere steht ein Kelch.");
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel wohl "
    "errichtet haben mag.");
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
    "Die Decke ist gut zwanzig Fuss ueber Dir und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.");
  AddDetail( ({"kerze", "kerzen"}), 
    "Noch immer fragst Du Dich, wer die hier aufgestellt haben mag aber wenn "
    "Du Dir es genau ueberlegst, willst Du es eigentlich gar nicht so genau "
    "wissen.");
  AddDetail( ({"nische", "nischen"}), "Kerzen stehen in den Nischen." );
  AddDetail ("kelch",
    "Der Kelch ist gefuellt mit einer roten, zaehen Fluessigkeit.\n");
  AddDetail ("fluessigkeit",    
    "Es ist, wie Du vermutet hast, Blut. Von wem moechtest Du erst gar nicht "
    "wissen.");
  AddDetail ("blut",
    "Kannst ja mal versuchen es zu trinken.\n");

  AddCmd("trink", "trink");

  AddExit("unten", ROOM "wasserhoehle");
  AddGuardedExit("oben", ROOM "yib", "yog",
    "An Yogsothoth kommt keiner vorbei!\n");
  AddItem( NPC "yog", REFRESH_DESTRUCT);
}

int trink(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if (!str || str!="blut")
    return 0;
  if (!h)
    write("Igitt!\n");
  else
  {
    h = 0;
    write(BS(
      "Du trinkst das Blut aus dem Kelch. Ein bisschen ekelst Du Dich ja "
      "schon aber das Blut scheint eine heilende Wirkung zu haben. Du spuerst "
      "wie eine magische Kraft Dich durchstroemt. Ploetzlich wird der Kelch "
      "brennend heiss und vor Schreck laesst Du ihn fallen. Der Priester "
      "hebt ihn auf und stellt ihn wieder an seinen Platz. "));
    this_player()->heal_self(200);
  }
  return 1;
}

reset()
{
  ::reset();
  h = 1;
}

