           "auseinanderhacke!\n";
  if(pl->QueryProp(P_GHOST))
       return "Kronang schreit wuetend: Hinfort mit Dir Du boeser Geist!\n";
  if(pl->QuerySkillAbility(FIGHT(WT_AXE))<(8*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst Dich im Axtkampf noch ueben.\n";
  if(pl->QuerySkillAbility(SK_TWOHANDED)<(6*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst Dich im Kampf mit zweihaendigen Waffen noch ueben.\n";
  if(pl->QuerySkillAbility("waffenkunde")<(45*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Waffenkunde' noch ueben.\n";
  if(pl->QuerySkillAbility("zerstoerung")<(45*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Zerstoerung' noch ueben.\n";
  if(!call_other(BMASTER, "CheckXp", pl, pl->QueryProp(P_XP)) && !IS_WIZARD(pl))
    str+=NeedMoreXP(pl, XP_LEVEL2);
  if( str!="") return str;
  call_other(BMASTER, "SetXp", pl, pl->QueryProp(P_XP)+ XP_LEVEL3);
  return 0;
}

