reset()
{
  ::reset();
  zaehler++;
  if (zaehler==5)
  {
    call_other(BMASTER, "DoBackup");
    zaehler=0;
  }
}

int nomagic()
{
  if( present("kronang") && ! TP->InFight() )
  {
    write( "Kronang sagt: Ueb das lieber an einem Gegner, "
           +this_player()->name()+"!\n");
    return 1;
  }
  return 0;
}
  
int antimagic()
{
  if( ! TP->InFight() )
  {
    write("Darauf kannst Du Dich hier in der Berserkergilde nicht "
        "konzentrieren.\n") ;
    return 1;
  }
  return 0;
}

int treten( string str)
{
  if( !present("kronang") )
  {
    write("Kronang ist nicht da.... so ein Pech!\n");
    return 0;
  }
  if( str=="in gilde ein" )
    return beitreten();
  if( str=="aus gilde aus")
    return austreten();
  return 0;
}

int austreten()
{
  object ob;
  if( !present("kronang") )
  {
    write("Kronang ist nicht da.... so ein Pech!\n");
    return 0;
  }
  if(!IsGuildMember(this_player()))
  {
     write("Kronang schnaubt: Aber Du bist doch gar kein Mitglied!\n");
     return 1;
  }
  this_player()->SetProp( P_GUILD_LEVEL, 0);
  WLOG("/log/gilden/berserker", "tritt aus der Gilde aus");
  tell_room(this_object(), "Kronang sagt: Schade, wieder ein Berserker "
                           "weniger.. :(\n");
  if(ob=present("\nberserker_stirnband", this_player()))
  {
    ob->remove();
  }
  call_other(BMASTER, "DeleteMember", this_player());
  WLOG(LOG + getuid(this_player())+".log", "tritt aus der Berserkergilde aus");
  Channel(capitalize(getuid(this_player()))+" ist gerade aus der "
          "Berserkergilde ausgetreten.");
  return ::austreten();
}

int beitreten()
{
  int b;
  if( !present("kronang") )
  {
    write("Kronang ist nicht da.... so ein Pech!\n");
    return 0;
  }
  //write("Bis auf weiteres ist die Gilde geschlossen.\n");
  //return 1;
/*
  if( !this_player()->QueryProp(P_TESTPLAYER) )
  {
    write("Kronang sagt bedauernd: Zur Zeit duerfen nur Testspieler "
          "beitreten!\n");
    return 1;
  }
*/
  if(IsGuildMember(this_player()))
  {
     write("Kronang schnaubt: Aber Du bist doch schon Mitglied!\n");
     return 1;
  }
  if( (b = ::beitreten()) < 0) return 1;
  tell_room(this_object(), "Kronang sagt: Willkommen in der Gilde der "
                           "Berserker, "+this_player()->name()+"!\n");
  WLOG("/log/gilden/berserker", "tritt in die Gilde ein");
  if(!(this_player()->QuerySkillAbility(FIGHT(WT_AXE))))
    this_player()->ModifySkill(FIGHT(WT_AXE),
      QuerySkill(FIGHT(WT_AXE))+([ SI_SKILLABILITY: InitialAbil(this_player(),
       "axe")]), 150,"berserker");
  if(!this_player()->QuerySkillAbility(SK_TWOHANDED))
    this_player()->ModifySkill( SK_TWOHANDED,
      QuerySkill( SK_TWOHANDED)+([ SI_SKILLABILITY: InitialAbil(this_player(),
       "bihand")]), 200, "berserker" );
  SchildWeg(this_player());
  if(!present("\nberserker_stirnband", this_player()))
    clone_object(ARMOUR "stirnband")->move(this_player(),M_NOCHECK);
  call_other(BMASTER, "AddMember", this_player());
  WLOG(LOG+getuid(this_player())+".log", "ist in die Berserkergilde eingetreten");
  this_player()->command_me("vorsicht 0");
  this_player()->command_me("-+k");
  this_player()->command_me("alias bwer kwer gilde berserker");
  this_player()->SetProp(P_TITLE, 0);
  Channel(capitalize(getuid(this_player()))+
    " ist gerade in die Berserkergilde eingetreten.");
  return b;
}

int SchildWeg(object pl)
{
 object *armours;
 int i, *mat;

 if(!armours=pl->QueryProp(P_ARMOURS))
    return 0;
 for (i=sizeof(armours)-1;i>=0;i--)
 {
   if(armours[i]->QueryProp(P_ARMOUR_TYPE)==AT_SHIELD)
   {
     tell_room(this_object(), "Kronang sagt: Einen Schild brauchst Du als "
       "mutiger Berserker nicht, "+pl->name()+"!\n");
     tell_room(this_object(), "Kronang zerstoert "+pl->name(WESSEN)+" "+
       armours[i]->name(RAW)+".\n", ({pl}) );
     tell_object(pl, "Kronang zerstoert D"+armours[i]->name(WEN,0)+".\n");
     armours[i]->remove();
   }
 }
 return 1;
}

void Channel(string msg)
{
  catch(VOICEMASTER->SendToChannel("Berserker",this_object(),SAY,msg));
}

advance(string str)
{
  mixed b;
  notify_fail ("Was willst Du erhoehen?\n"+ "Stufe, Gildenstufe, Kraft, "
               "Int(elligenz), Aus(dauer), Gesch(icklichkeit)?\n");
  if (!str) return 0;
  if( !present("kronang") )
  {
    write("Hier ist leider niemand, der Dich erhoehen koennte!\n");
    return 1;
  }
  if (str=="stufe" || str2attr(str) )
    return ::advance(str);
  if( str=="gildenstufe" || str=="gilde" )
  {
    if(!IsGuildMember(this_player()))
    {
       tell_room(this_object(),"Kronang schnaubt: Aber Du bist doch gar "
         "kein Mitglied, "+this_player()->name()+"!\n");
       return 1;
    }
    if( this_player()->QueryProp(P_GUILD_LEVEL) >= 10 )
    {
      tell_room(this_object(), "Kronang sagt: Du bist doch schon ein "
          "Berserkermeister, "+this_player()->name()+"!\n");
      return 1;
    }
    b= ::advance();
    if(b)
    {
      write("Gratulation zu Deiner neuen Stufe!\n");
      switch(this_player()->QueryProp(P_GUILD_LEVEL) )
      {
        case 2: 
          write("Kronang sagt: Jetzt kannst Du 'Schaetz' und 'Rammen' "
                "lernen.\n");
          break;
        case 3: 
          write("Kronang sagt: Jetzt kannst Du 'Wueten' und 'Regeneration' "
                "lernen.\n"+
                break_string("Ausserdem kannst Du nun jetzt allen Berskern "
                "etwas zubruellen. (bbruelle)",78,"Kronang sagt: "));
          break;
        case 4: 
          write("Kronang sagt: Jetzt kannst Du 'Kampfschrei' und 'Augeinauge' "
                "lernen.\n");
          break;
        case 5: 
          write("Kronang sagt: Jetzt kannst Du 'Zertreten' und 'Willenskraft' "
                "lernen.\n");
          break;
        case 6: 
          write("Kronang sagt: Jetzt kannst Du 'Kopfstoss' und 'Eisenhaut' "
                "lernen.\n");
          break;
        case 7: 
          write("Kronang sagt: Jetzt kannst Du 'Spalten' lernen.\n");
          break;
        case 8: 
          write("Kronang sagt: Jetzt kannst Du 'Blutrausch' lernen.\n");
          break;       
        case 9:
          write("Kronang sagt: Jetzt kannst Du 'Schlachtruf' lernen.\n");
          break;
        case 10: 
          write("Kronang sagt laechelnd: Endlich hast Du den Gipfel des "
                "Berserkertums erreicht!\n");
 	  break;
      }
      WLOG(LOG + getuid(this_player())+".log", "hat Stufe "
        +this_player()->QueryProp(P_GUILD_LEVEL)+" erreicht");
      Channel(capitalize(getuid(this_player()))+" hat in der Berserkergilde "
        "Stufe " +this_player()->QueryProp(P_GUILD_LEVEL)+" erreicht.");
    }
    return b;
  }
  return 0;
}

int InitialAbil(object player, string what)
{
  int bonus, abil;
  if( what=="axe" && player->QueryProp(P_RACE)=="Zwerg" )
    bonus = random(150);
  else if( what=="bihand" && player->QueryProp(P_RACE)=="Mensch" )
    bonus = random(100);
  else if( what=="bihand" && player->QueryProp(P_RACE)=="Hobbit" )
    bonus = -random(100);
  else if( what=="axe" && player->QueryProp(P_RACE)=="Elf" )
    bonus = -random(80);
  else
    bonus = 0;
  abil = 3*player->QueryAttribute(A_STR)+player->QueryAttribute(A_DEX)+bonus;
  return (abil > 0 ? abil : 1);
}

nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if( value > 5000 ) value = 5000;
  if( value < 2500 ) value = 2500;
  return value;
}

OwnLearnSpell(string str)
{
  if( !present("kronang") )
  {
    write("Hier ist leider niemand, der Dir etwas beibringen koennte!\n");
    return 1;
  }
  if(!IsGuildMember(this_player()))
  {
    write( "Kronang sagt: Du bist kein Mitglied dieser Gilde!\n");
    return 1;
  }
  notify_fail("Kronang sagt: Was moechtest Du hier lernen?\n");
  if(!str)
  {
    write(
      "Kronang sagt: Du kannst hier folgende Faehigkeiten lernen:\n"
      "Kronang sagt: Waffenkunde    : Ab Gildenstufe 1.\n"
      "Kronang sagt: Zerstoerung    : Ab Gildenstufe 1.\n"
      "Kronang sagt: Schaetz        : Ab Gildenstufe 2.\n"
      "Kronang sagt: Rammen         : Ab Gildenstufe 2.\n"
      "Kronang sagt: Wueten         : Ab Gildenstufe 3.\n"
      "Kronang sagt: Regeneration   : Ab Gildenstufe 3.\n"
      "Kronang sagt: Kampfschrei    : Ab Gildenstufe 4.\n"
      "Kronang sagt: Augeinauge     : Ab Gildenstufe 4.\n"
      "Kronang sagt: Zertreten      : Ab Gildenstufe 5.\n"
      "Kronang sagt: Willenskraft   : Ab Gildenstufe 5.\n"
      "Kronang sagt: Kopfstoss      : Ab Gildenstufe 6.\n"
      "Kronang sagt: Eisenhaut      : Ab Gildenstufe 6.\n"
      "Kronang sagt: Spalten        : Ab Gildenstufe 7.\n"
      "Kronang sagt: Blutrausch     : Ab Gildenstufe 8.\n"
      "Kronang sagt: Schlachtruf    : Ab Gildenstufe 9.\n\n"
      );
    return 1;
  }
  return LearnSpell(str);
}

string int2string(int wert)
{
  string str;
  switch(wert)
  {
    case    0..500 : str="so gut wie gar nicht";    break;
    case  501..1000: str="fast gar nicht";          break;
    case 1001..1500: str="kaum";                    break;
    case 1501..2000: str="sehr miserabel";          break;
    case 2001..2500: str="miserabel";               break;
    case 2501..3000: str="ziemlich schlecht";       break;
    case 3001..3500: str="schlecht";                break;
    case 3501..4000: str="maessig";                 break;
    case 4001..4500: str="unterdurchschnittlich";   break;
    case 4501..5000: str="durchschnittlich";        break;
    case 5001..5500: str="ueberdurchschnittlich";   break;
    case 5501..6000: str="befriedigend";            break;
    case 6001..6500: str="sehr befriedigend";       break;
    case 6501..7000: str="recht gut";               break;
    case 7001..7500: str="ganz gut";                break;
    case 7501..7750: str="gut";                     break;
    case 7751..8000: str="wirklich gut";            break;
    case 8001..8250: str="sehr gut";                break;
    case 8251..8500: str="unglaublich gut";         break;
    case 8501..8750: str="phantastisch gut";        break;
    case 8751..9000: str="ausgezeichnet";           break;
    case 9001..9250: str="hervorragend";            break;
    case 9251..9500: str="beinahe meisterhaft";     break;
    case 9501..9750: str="meisterhaft";             break;
    case 9751..9999: str="nahezu perfekt";          break;
    case 10000:      str="absolut perfekt";         break;
  }
  return str;
}

int faehigkeiten()
{
  int i, wert;
  string *arm, s;
  mapping res;

  if( IS_WIZARD(this_player())  )
  {
    s = "Kronang sagt: Weil Du Magier bist - Deine Skills:\n";
    res = this_player()->QueryProp(P_NEWSKILLS);
    arm = m_indices(res);
    for (i = sizeof(arm)-1;i>=0;i--)
    {
      s += sprintf("Kronang sagt: %-15s: ", arm[i]);
      if (mappingp(res[arm[i]])) s += res[arm[i]][SI_SKILLABILITY];
      else s += res[arm[i]];
      s += "\n";
    }
    printf( s );
    return 1;
  }
  if( !present("kronang") )
  {
    write("Kronang ist nicht da.... so ein Pech!\n");
    return 1;
  }
  if(!IsGuildMember(this_player()))
  {
    write("Kronang sagt: Du bist ja gar kein Berserker!\n");
    return 1;
  }
  write("Kronang sagt: Folgende Faehigkeiten hast Du schon erlernt:\n");
  s="";
  res=this_player()->QueryProp(P_NEWSKILLS);
  arm = m_indices(res);
  for (i = sizeof(arm)-1;i>=0;i--)
   {
    if(arm[i]!="Bihand" && arm[i]!="Fight_axe")
     {
      write("Kronang sagt: "+capitalize(arm[i])+" beherrscht Du "+
            int2string(this_player()->QuerySkillAbility(arm[i]))+".\n");
     }
   }   
  s=int2string(this_player()->QuerySkillAbility("Fight_axe"));
  write("Kronang sagt: Den Axtkampf beherrscht Du "+s+".\n");
  s=int2string(this_player()->QuerySkillAbility("Bihand"));
  write("Kronang sagt: Den Kampf mit Zweihaendern beherrscht Du "+s+".\n");
  if((wert=this_player()->QueryProp(P_GUILD_RATING))<1501) wert=1501;
  s=int2string(wert);
  write("Kronang sagt: Insgesamt betrachtet bist Du "+s+".\n"); 
  say(sprintf("Kronang klaert %s ueber %s Fertigkeiten auf.\n", 
      capitalize(getuid(this_player())), 
      this_player()->QueryPossPronoun(FEMALE, WEN, PLURAL)));
  return 1;
}

mapping Axtkampf(object player, string skill, mapping sinfo)
{ 
  string s;
  int hp, maxhp;

  int abil, ud, val;
  ud=sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  val = (3* player->QueryAttribute(A_STR) + player->QueryAttribute(A_DEX)/2+ 
        player->QueryProp(P_GUILD_LEVEL) ) * abil / MAX_ABILITY;
  if(player->QueryProp(P_HP)<player->QueryProp(P_MAX_HP)/2 )
    val+=player->QueryProp(P_MAX_HP)/2-player->QueryProp(P_HP);
  val-=random(player->QueryProp(P_WIMPY))/2;
  sinfo[SI_SKILLDAMAGE] += random(val);
  if (++ud > abil/50) 
  {
    ud = 0;
    abil += player->QueryAttribute(A_STR)/3 
            - random(player->QueryProp(P_WIMPY)/20);
  }
  if( player->QueryProp(P_PREFERED_ENEMY) )
  {
    if( player->QueryProp(P_PREFERED_ENEMY)[1]==sinfo[SI_ENEMY] )
    {
      sinfo[SI_SKILLDAMAGE] += 2 * player->QueryProp(P_GUILD_LEVEL);
      if( random(50)<14+player->QueryProp(P_GUILD_LEVEL) ) 
      {
        hp = sinfo[SI_ENEMY]->QueryProp( P_HP );
        maxhp = sinfo[SI_ENEMY]->QueryProp( P_MAX_HP );
        s = capitalize(sinfo[SI_ENEMY]->name());
        if( hp < maxhp/10)
          s += " steht auf der Schwelle des Todes";
        else if( hp < maxhp/5)
          s += " braucht dringend einen Arzt";
        else if( hp < maxhp*3/10 )
          s += " ist in keiner guten Verfassung";
        else if( hp < maxhp*4/10)
          s += " wankt bereits bedenklich";
        else if( hp < maxhp/2)
          s += " macht einen mitgenommenen Eindruck";
        else if( hp < maxhp*6/10)
          s += " sieht nicht mehr taufrisch aus";
        else if( hp < maxhp*7/10)
          s += " ist leicht angeschlagen";
        else if( hp < maxhp*8/10)
          s += " fuehlte sich heute schon besser";
        else if( hp < maxhp*9/10)
          s += " ist schon etwas geschwaecht";
        else s += " ist absolut fit";
          s += ".\n";
        tell_object(player,s);
      }
    }
    else
      sinfo[SI_SKILLDAMAGE] -= 5 * player->QueryProp(P_GUILD_LEVEL);
  }
  player->ModifySkill( FIGHT(WT_AXE), ([ SI_USR: ud, SI_SKILLABILITY: abil ]),
                       150, "berserker");
  return sinfo;
}

mapping Bihandkampf(object player, string skill, mapping sinfo)
{
  int abil, ud, val;
  ud=sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  val = (2* player->QueryAttribute(A_STR) + player->QueryAttribute(A_DEX)+ 
        player->QueryProp(P_GUILD_LEVEL) ) * abil / MAX_ABILITY;
  if(player->QueryProp(P_HP)<player->QueryProp(P_MAX_HP)/2 )
    val+=player->QueryProp(P_MAX_HP)/2-player->QueryProp(P_HP);
  val-=random(player->QueryProp(P_WIMPY))/2;
  sinfo[SI_SKILLDAMAGE] += random(val);
  if (++ud > abil/50) 
  {
    ud = 0;
    abil += (player->QueryAttribute(A_DEX)+player->QueryAttribute(A_STR))/6
            - random(player->QueryProp(P_WIMPY)/20);
  }
  player->ModifySkill( SK_TWOHANDED, ([ SI_USR: ud, SI_SKILLABILITY: abil ]),
                       200, "berserker");
  return sinfo;
}

string NeedMoreXP(object pl, int xp)
{
  string str, ret_string;
  int percent, x;
  ret_string="Kronang sagt: Du musst noch mehr Erfahrung sammeln!\n";
  x=call_other(BMASTER, "GetXpDifference", pl,
              pl->QueryProp(P_XP));
  percent=100*x/xp;
  switch (percent)
  {
    case  0..10:  str="nur mehr ganz wenige";         break;
    case 11..20:  str="weniger als ein Viertel der";  break;
    case 21..30:  str="etwa ein Viertel der";         break;
    case 31..40:  str="weniger als die Haelfte der";  break;
    case 41..50:  str="etwa die Haelfte der";         break;
    case 51..60:  str="mehr als die Haelfte der";     break;
    case 61..70:  str="weniger als drei Viertel der"; break;
    case 71..80:  str="etwa drei Viertel der";        break;
    case 81..90:  str="mehr als drei Viertel der";    break;
    case 91..99:  str="beinahe alle";                 break;
    default:      str="SEHR viele";                   
      call_other(BMASTER, "SetXp", pl, pl->QueryProp(P_XP)+ xp);
  }
 ret_string +="Kronang sagt: Dir fehlen noch "+str+" Erfahrungspunkte.\n";
 return ret_string;
}

string Test1( object pl)
{
  if( pl->QueryProp(P_FROG) ) 
    return "Kronang sagt: Igitt! Ein Frosch! Hau bloss ab bevor ich Dich "
           "auseinanderhacke!\n";
  if(pl->QueryProp(P_GHOST))
       return "Kronang schreit wuetend: Hinfort mit Dir Du boeser Geist!\n";
  call_other(BMASTER, "SetXp", pl, pl->QueryProp(P_XP)+ XP_LEVEL2);
  return 0;
}

string Test2( object pl)
{
  string str;
