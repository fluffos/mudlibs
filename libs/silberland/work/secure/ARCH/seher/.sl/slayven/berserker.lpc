    str+="Kronang sagt: Du musst Dich im Kampf mit zweihaendigen Waffen noch ueben.\n";
  if(pl->QuerySkillAbility("waffenkunde")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Waffenkunde' noch ueben.\n";
  if(pl->QuerySkillAbility("zerstoerung")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Zerstoerung' noch ueben.\n";
  if(pl->QuerySkillAbility("schaetz")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Schaetz' noch ueben.\n";
  if(pl->QuerySkillAbility("rammen")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Rammen' noch ueben.\n";
  if(pl->QuerySkillAbility("wueten")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Wueten' noch ueben.\n";
  if(pl->QuerySkillAbility("regeneration")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Regeneration' noch ueben.\n";
  if(pl->QuerySkillAbility("kampfschrei")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Kampfschrei' noch ueben.\n";
  if(pl->QuerySkillAbility("augeinauge")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Augeinauge' noch ueben.\n";
  if(pl->QuerySkillAbility("zertreten")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Zertreten' noch ueben.\n";
  if(pl->QuerySkillAbility("willenskraft")<(90*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Willenskraft' noch ueben.\n";
  if(pl->QuerySkillAbility("kopfstoss")<(85*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Kopfstoss' noch ueben.\n";
  if(pl->QuerySkillAbility("eisenhaut")<(85*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Eisenhaut' noch ueben.\n";
  if(pl->QuerySkillAbility("spalten")<(80*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Spalten' noch ueben.\n";
  if(pl->QuerySkillAbility("blutrausch")<(75*MAX_ABILITY/100))
    str+="Kronang sagt: Du musst 'Blutrausch' noch ueben.\n";
  if(pl->QueryProp(P_QP)<(("/secure/questmaster"->QueryMaxQP())))
    str+="Kronang sagt: Du hast noch nicht genuegend Abenteuerpunkte.\n";
  if(!call_other(BMASTER, "CheckXp", pl, pl->QueryProp(P_XP)) && !IS_WIZARD(pl))
    str+=NeedMoreXP(pl, XP_LEVEL9);
  if( str!="") return str;
  call_other(BMASTER, "SetXp", pl, pl->QueryProp(P_XP)+XP_LEVEL10);
  pl->ModifySkill("waffenkunde",([ SI_SPELLCOST: 9 ]),0,"berserker");
  pl->ModifySkill("wueten",([ SI_SPELLCOST: 5 ]),0,"berserker");
  pl->ModifySkill("regeneration",([ SI_SPELLCOST: 17 ]),0,"berserker");
  pl->ModifySkill("augeinauge",([ SI_SPELLCOST: 8 ]),0,"berserker");
  pl->ModifySkill("willenskraft",([ SI_SPELLCOST: 17 ]),0,"berserker");
  pl->ModifySkill("kopfstoss",([ SI_SPELLCOST: 11 ]),0,"berserker");
  pl->ModifySkill("eisenhaut",([ SI_SPELLCOST: 23 ]),0,"berserker");
  pl->ModifySkill("spalten",([ SI_SPELLCOST: 45 ]),0,"berserker");
  pl->ModifySkill("blutrausch",([ SI_SPELLCOST: 120 ]),0,"berserker");
  return 0;
}

