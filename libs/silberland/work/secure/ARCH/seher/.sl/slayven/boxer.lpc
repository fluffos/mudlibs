
#include "files.h"
#include <properties.h>
#include <combat.h>
#include <attributes.h>

inherit "std/armour";
int dex;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"unterhose","hose"}));
  SetProp(P_SHORT, "Eine weisse Boxershort mit roten Herzchen drauf.");
  SetProp(P_LONG,
    "Die Unterhose schaut eigentlich ganz normal aus.");
  SetProp(P_NAME, "Unterhose");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 1+random(5));

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 3900+random(500));
//  SetProp(P_MATERIAL, P_MAT_CLOTH));
  SetProp(P_MAGIC,1);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:15]) );
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_INFO, BS(
    "Diese Boxershort verleiht seinem Traeger moeglicherweise zusaetzliche "
    "Faehigkeiten."));
  dex=10; 

  SetProp(P_CURSED,1);
  SetProp(P_NEVERDROP,1);
  if( dex<0 )
    SetProp(P_VALUE,0);
}

varargs int DoWear(int silent, int all)
{
  int ret;
  ret = ::DoWear (silent, all);
  if (QueryProp(P_WORN)) {
    SetProp (P_X_ATTR_MOD, ([ A_DEX:dex]) );
    this_player()->UpdateAttributes();
  }
  return ret;
}

varargs int DoUnwear(int silent)
{
  int ret;
  ret = ::DoUnwear (silent);
  if (!QueryProp(P_WORN)) {
    SetProp (P_X_ATTR_MOD, 0 );
    this_player()->UpdateAttributes();
  }
  return ret;
}

