inherit "/obj/container";

#include <language.h>
#include <properties.h>
#include <container.h>
#include <defines.h>

#define TP this_player()
#define TPN this_player()->name()
#define CAP_TPN capitalize(this_player()->name())

create()
{
  ::create();
  SetProp(P_NAME, "Steintruhe");
  SetProp(P_SHORT, "Eine Steintruhe");
  SetProp(P_LONG, "Die Truhe ist komplett aus Stein. "
	  + "In dieser Truhe bewahrt Slayven seine Privatsachen auf."
	  + " Sie ist von einer magischen Aura umgeben.\n"); 
  AddId("steintruhe");
  AddId("truhe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 10000);
  SetProp(P_MAX_WEIGHT, 20000);
  SetProp (P_NOGET, "Du kannst die Steintruhe nicht mitnehmen.\n");
  SetProp (P_MATERIAL, MAT_MISC_STONE);
  AddCmd("oeffne", "oeffnest");
  AddCmd(({"schliess", "schliesse", "verschliesse"}), "schliessest");
}

oeffnest(string str)
{
  notify_fail("Was willst Du oeffnen?");
  if (!str) return 0; 
  if(!id(str)) return 0;
  { 
    if( TP->query_real_name() == "slayven" ) 
      {
	if (QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN)
	  return write ("Aber die Steintruhe ist doch schon offen!\n"), 1;
	write ("Du oeffnest die Steintruhe.\n");
	say (CAP_TPN+" oeffnet die Steintruhe.\n");
	SetProp (P_CNT_STATUS, CNT_STATUS_OPEN);
	return 1;
      }
    else
      {
	write ("Du kannst die Steintruhe nicht oeffnen.\n");
	return 1;
      }
  }
}

schliessest(string str)
{
  notify_fail("Was willst Du schliessen?");
  if (!str) return 0; 
  if(!id(str)) return 0;
  {
    if( TP->query_real_name() == "slayven" ) 
      {
	if (QueryProp(P_CNT_STATUS) != CNT_STATUS_OPEN)
	  return write ("Aber die Steintruhe ist doch gar nicht offen!\n"), 1;
	write ("Du schliesst die Steintruhe.\n");
	say (CAP_TPN+" schliesst die Steintruhe.\n");
	SetProp (P_CNT_STATUS, CNT_STATUS_CLOSED);
	return 1;
      }
    else
      {
	write ("Du kannst diese Truhe nicht schliessen.\n");
	return 1;
      }
  }
}





































