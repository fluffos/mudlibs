/def -t"{*} kommt an." kn1 = knuddel $[tolower(%1)] /zur Begruessung
/def -t"{*} knuddelt Dich." kn2 = knuddel $[tolower(%1)] /ganz lieb
/def -t"{*} knuddelt Dich aus der Ferne." kn3 = rknuddel $[tolower(%1)] /ganz lieb
/def -t"{*} grinst Dich aus der Ferne an." kn4 = rgrinse $[tolower(%1)]
/def -t"Dein Druidenkollege {*} knuddelt Dich aus der Ferne." kn5 = rknuddel $[tolower(%1)]
/def -t"{*} ist gerade ins SilberLand gekommen" kn6 = rknuddel $[tolower(%1)] /zur Begruessung

