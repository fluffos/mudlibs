#include "wizlevels.h"

private mapping bbs;

void create()
{
  seteuid(getuid(this_object()));
  if (!restore_object("/secure/ARCH/bbmaster") || !mappingp(bbs))
    bbs=([]);
  map_array(m_indices(bbs),"updateplayers");
  // walk_mapping() lieber nicht, da das mapping evtl. aktualisiert wird
  save_object("/secure/ARCH/bbmaster");
}

int query_bb()
{
  if (file_name(previous_object())[0..11]!="/std/shells/" &&
      !interactive(previous_object()))
    return 0;
  return bbs[geteuid(previous_object())];
}

void writebb( string msg )
{
  // if( previous_object()!=this_interactive() ) return;
  if (!bbs[getuid(previous_object())]) {
    bbs=m_delete(bbs,getuid(previous_object()));
    previous_object()->__set_bb(0);
    return;
  }
  log_file( "ARCH/bb."+getuid(previous_object()), msg, 100000, 1 );
}

int set_bb(string who, int x)
{
  object ob;
  if (!ARCH_SECURITY) return 0;
  bbs[who]=x;
  if (ob=find_player(who)||find_netdead(who)) {
    ob->__set_bb(x);
    if (!x) bbs=m_delete(bbs,geteuid(ob));
  }
  save_object("/secure/ARCH/bbmaster");
  return 1;
}

int delete_bb(string who) {
  object ob;
  if (!ARCH_SECURITY) return 0;
  if (ob=find_player(who)||find_netdead(who)) {
    ob->__set_bb(0);
  }
  efun::m_delete(bbs,who);
  save_object("/secure/ARCH/bbmaster");
  return 1;
}

mapping show_bb()
{
  object ob;
  if (!ARCH_SECURITY) return 0;
  return copy_mapping(bbs);
}

void updateplayers(string name)
{
  object ob;
  if (ob=find_player(name)||find_netdead(name)) {
    ob->__set_bb(bbs[name]);
    if (!bbs[geteuid(ob)]) bbs=m_delete(bbs,name);
  }
}
