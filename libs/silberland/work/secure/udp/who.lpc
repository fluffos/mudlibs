#include <udp.h>
#include <properties.h>

#define MERLIN  "/secure/merlin"
#define BASE    "/std/player/base"
#define WHOLIST "/obj/werliste"

#define TD(x) if (find_player("debugger")) \\
                tell_object(find_player("debugger"),x)


void udp_who(mapping data)
{
  int i,num;
  string *lines;
  string wholiste, header, args;
  mixed ans;
 
  if (member(data,DATA)) args=data[DATA]; else args="";

  num = sizeof( users() - filter_objects(users(), "QueryProp", P_INVIS) );
  if (num > 10) i=1; else i=0;
  ans = BASE->filter_who_options(args,i);
  lines = WHOLIST->QueryWhoListe(0, ans[0], 0, ans[1]);

  if (ans[0] & 1) {
    wholiste = implode(lines[1..],"\n");
    header=
"+------------------------------------------------------------------------+\n"+
sprintf("| %|70s |\n| %|70s |\n",
    "SilberLand - sl.mud.at (77.237.49.230) 4711",
    "Uptime: "+uptime())+
"+------------------------------------------------------------------------+\n";
  }
  else
  {
    wholiste = implode(lines,"\n");
    header=
"+----------------------------------------------------------------------------+\n"+
sprintf("|  ___ _ _ _             _                 _   LPMud %:-11s (Amylaar)   |\n", __VERSION__)+
"| / __(_) | |__  ___ _ _| |   __ _ _ _  __| |  Adresse: sl.mud.at 4711       |\n"
"| \\__ \\ | | '_ \\/ -_) '_| |__/ _` | ' \\/ _` |  SL-Mudlib, beruhend auf       |\n"
"| |___/_|_|_.__/\\___|_| |____\\__,_|_||_\\__,_|  Morgengrauen/Anderland Mudlib |\n"
"|                                                                            |\n"
"| "+sprintf("%74s", "Uptime: "+uptime())+" |\n"
"+----------------------------------------------------------------------------+\n";
  }

  wholiste=header+wholiste+"\n"+
    (ans[0] & 1 ?
     sprintf("\n%'-'73s-\n",
       sprintf(" Anwesende: %d, max. heute: %d, Rekord: %d ",
         num, MERLIN->QueryMaxUsersToday(), MERLIN->QueryMaxUsers() ) )+
     "\n"
     :
     sprintf("%'-'78s\n%78s\n\n", "",
       sprintf("Anwesende im Silberland: "
         "Aktuell %d, Max. heute %d, Rekord %d",
         num, MERLIN->QueryMaxUsersToday(), MERLIN->QueryMaxUsers() )) );

  INETD->send_udp(data[NAME], ([
				REQUEST: REPLY,
				RECIPIENT: data[SENDER],
				ID: data[ID],
				DATA: wholiste
				]) );
}

