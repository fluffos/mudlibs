// MorgenGrauen MUDlib Contribution

#pragma strong_types
#pragma combine_strings

#include <properties.h>
#include <www.h>


mapping status_expl = ([
    "s" : ({ "Spieler", "Spielerin" }),
    "S" : ({ "Seher", "Seherin" }),
    "z" : ({ "Zweitspieler", "Zweitspielerin" }),
    "Z" : ({ "Zweitspieler, Seher", "Zweitspielerin, Seherin" }),
    "t" : ({ "Testspieler", "Testspielerin" }),
    "T" : ({ "Testspieler, Seher", "Testspielerin, Seherin" }),
    "l" : ({ "Lehrling", "Lehrling" }),
    "a" : ({ "Altmagier", "Altmagierin" }),
    "m" : ({ "Jungmagier", "Jungmagierin" }),
    "M" : ({ "Regionsmitarbeiter", "Regionsmagierin" }),
    "V" : ({ "Vollmagier", "Vollmagierin" }),
    "X" : ({ "Magier fuer besondere Aufgaben",
             "Magierin fuer besondere Aufgaben" }),
    "R" : ({ "Regionsmagier", "Regionsmagierin" }),
    "W" : ({ "Weiser", "Weise" }),
    "E" : ({ "Erzmagier", "Erzmagierin" }),
    "G" : ({ "Gott", "Goettin" }),
    ]);


string MakeLink(mixed entry)
{
  string nm;
  string class;

  nm = (string)getuid(entry[0]);
  switch(query_wiz_level(entry[0])) {
    case 0: class = "player"; break;            // Spieler
    case 1: class = "seer"; break;              // Seher
    case 2..39: class = "wizard"; break;        // Magier
    case 40..59: class = "lord"; break;         // Regionsmagier
    default: class = "arch";                    // Erzmagier++
  }
  return "<TR class=" + class + ">"
    "<TD align=center>" +
    "<ACRONYM title='" +
    (status_expl[entry[1]] || ({ "???", "???" }))
    [entry[0]->QueryProp(P_GENDER) == MALE ? 0 : 1] +
    "'>&nbsp;" +
    entry[1] +
    "&nbsp;</ACRONYM>"
    "</TD>"
    "<TD>" + regreplace(entry[2], "<", "\\&lt;", 1) +
       "<A href=\""+MUDWWW+"?"+REQ+"="+R_FINGER+"&"+USER+"="+nm+"\"><B>" +
       capitalize(nm) +
       "</B></A>" +
       regreplace(entry[3], "<", "\\&lt;", 1) +
       ( query_idle(entry[0]) >= 120 ?
           "&nbsp;&nbsp;<span class='" +
           (query_idle(entry[0]) >= 900 ? "longidle" : "idle") + "'>(" +
           time2string("%x%0X", query_idle(entry[0])) +
           "&nbsp;idle)</span>"
           :
           "") +
    "</TD><TD align=center>" +
    entry[4] +
    "</TD><TD align=center>" +
    entry[5]+", " + entry[6] +
    "</TD><TD align=right>" +
    entry[7] +
    "</TD></TR>";
}

string Request(mapping cmds)
{
  string *who;
  if (!sizeof(cmds)) return ERROR("Anfrage ung&uuml;ltig!");
  who = map_array(WHO, #'MakeLink);
  return "<H3>Wer befindet sich gerade im Silberland?</H3><P>\n"
       + "<TABLE width='100\%'>"
       + "<TR class='header'>"
       + "<TH>Status</TH>"
       + "<TH align=left>Voller Name</TH>"
       + "<TH>Rasse</TH>"
       + "<TH>Gilde, Gesinnung</TH>"
       + "<TH align=right>eingeloggt von</TH>"
       + "</TR>\n"
       + implode(who, "\n")+"</TABLE>";
}
