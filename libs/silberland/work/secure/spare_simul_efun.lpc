// * break_string

// stretch() -- stretch a line to fill a given width
private string stretch(string s, int w)
{
  int l, i, st;
  string *t, buffer;

  if ( !(l = w - strlen(s)) )
    return s;

  t = efun::explode(s, " ");

  if (!st = sizeof(t) - 1)
    return s;

  buffer = sprintf("%*s", i = (st+l)/st, "");

  for ( i = (st+l)-(i*st); i; --i )
      t[i] += " ";

  return implode( t, buffer );
}

// aus Geschwindigkeitsgruenden hat der Blocksatz fuer break_string eine
// eigene Funktion bekommen:
private varargs string block_string(string s, int w, string indent, int
flags)
{
    string *tmp;
    int l;

    if ( !s || s == "" )
        return "";

    if ( !(flags & BS_NO_PARINDENT) )
        s = " " + s;

    s = sprintf( "%-*=s", l = w - strlen(indent), s);

    s = implode( map_array( (tmp = efun::explode(s, "\n"))[0..<2],
                            /**/#'stretch/*'*/, l )
                 + ({ tmp[<1] }), "\n" );

    if ( s[<1] != '\n' )
        return s + "\n";
    else
        return s;
}

public varargs string break_string(string s, int w, mixed indent, int flags)
{
  mixed tmp;

  if(!s || s == "") return "";
  if (!w) w=78;
  if (flags & BS_SINGLE_SPACE)
    s = regreplace(s, "(^|\n| )  *", "\\1", 1);
  if(intp(indent))
    indent = indent ? sprintf("%*s", indent, "") : "";
  if (flags & BS_BLOCK)
  {
    if ( flags & BS_LEAVE_MY_LFS )
      s = implode( map_array(
                             efun::explode( s, "\n" ),
                             /**/#'block_string/*'*/, w, indent, flags),
                   "" );
    else
      s = block_string( regreplace( s, "\n", " ", 1 ), w, indent, flags );
  }
  else
  {
    if (!(flags & BS_LEAVE_MY_LFS))
      s = regreplace(s, "\n", " ", 1);
    s = sprintf("%-*=s", w-strlen(indent), s);
    if (s[<1]!='\n') s+="\n";
  }

  if (!strlen(indent)) return s;

  if (flags & BS_INDENT_ONCE)
    return indent + regreplace( s[0..<2], "\n",
        "\n"+sprintf("%*s", strlen(indent), ""), 1 ) + "\n";
  else
    return indent + regreplace(s, "\n([^\n])", "\n"+indent+"\\1", 1);
    // schneller, aber 'broken behaviour':
    // return indent + regreplace( s[0..<2], "\n", "\n"+indent, 1 ) + "\n";
}

