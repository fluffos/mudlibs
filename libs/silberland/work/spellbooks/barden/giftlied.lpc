int giftlied(object caster, mapping sinfo)
{
  int suc;
  object ob;
  float factor;

  if(caster->InFight()) {
    write("Dazu fehlt dir gerade die Konzentration\n");
    return 0;
  }

  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) return 0;
  if(!paySpellCost(caster, sinfo)) return 0;

  // Gelungen?
  if((suc=SpellSuccess(caster,sinfo))<=0)
  {
    if(suc < -1500)
    {
      tell_object(caster, BS("Das Lied vergiftet Dich!"));
      tell_room(ENV(caster), BS(caster->Name(WER)+" wird blass."), ({caster}));
      caster->AddPoison(1+random(2));
    }
    return MISSERFOLG;
  }

  tell_object(caster, BS("Geschickt stimmst du eine erquickende Melodie an."));
  tell_room(ENV(caster), BS(caster->Name(WER)+" stimmt eine fliessend-erquickende Melodie an."), ({caster}));

  factor = 1.0 + ((float) CheckEquip(caster, lower_case(sinfo[SI_CAP_NAME]))/100.0);

  ob = clone_object(OBJ("entgiften"));
  ob->Setup(sinfo[SI_CAP_NAME], caster, sinfo[SI_SKILLABILITY], suc, factor);
  if(ob->move(caster) != 1)
  {
    tell_object(caster, BS("Das Lied kann sich nicht manifestieren. Vielleicht "
                "stoeren Deine vielen Gegenstaende?"));
  }  
  return ERFOLG;
}
