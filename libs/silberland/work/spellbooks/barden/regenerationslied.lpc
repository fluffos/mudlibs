int regenerationslied(object caster, mapping sinfo)
{
  string bardGroup, instrumentPossPostfix;
  object instrument, song;
  float factor;
  int success;

  if(caster->InFight()) {
    tell_object(caster, BS("Besiege zuerst deinen Gegner!"));
    return 0;
  }

  bardGroup = "/gilden/bardengilde/master/bardenmaster"->GetBardGroup(caster);

  instrument = getInstrument(caster);
  if(!objectp(instrument) || instrument->QueryProp(P_INSTRUMENT_TYPE) != BARD_GROUP_INSTRUMENT[bardGroup]) {
    tell_object(caster, BS("Dazu benoetigst du ein passendes Instrument."));
    return 0;
  }

  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) return 0;
  if(!paySpellCost(caster, sinfo)) return 0;

  instrumentPossPostfix = (instrument->QueryProp(P_GENDER)==MALE?"en":(instrument->QueryProp(P_GENDER)==FEMALE?"e":""));
  tell_object(caster, BS(sprintf("Du beginnst dein%s %s zu spielen.", 
    instrumentPossPostfix, instrument->Name(RAW))));
  tell_room(environment(caster), BS(sprintf("%s beginnt %s%s %s zu spielen.", 
    caster->Name(WER, 1), caster->QueryPossPronoun(WESSEN), instrumentPossPostfix, instrument->Name(RAW))), ({caster}));
  

  if((success=SpellSuccess(caster,sinfo))<=0) {
    tell_room(ENV(caster), BS(sprintf("%s verspielt sich schrecklich.", caster->Name(WER, 1))), ({caster}));
    tell_object(caster, BS(sprintf("BOIOIOIOING! Dein%s %s gibt einen schrecklichen Ton von sich! Das war wohl nichts.",
      instrumentPossPostfix, instrument->Name(RAW))));

    if(success < -2500) {
      tell_object(caster, BS("Du merkst, wie dir dieser Fehler Lebenskraft raubt!"));
      caster->AddHp(success/500);
    }
    return MISSERFOLG;
  }

  song = clone_object("/gilden/bardengilde/obj/regeneration");
  factor = 1.0 + ((float) CheckEquip(caster, lower_case(sinfo[SI_CAP_NAME]))/100.0);
  song->Setup(sinfo[SI_CAP_NAME], caster, sinfo[SI_SKILLABILITY], success, (float) factor);
  if(song->move(caster, M_NOCHECK|M_GET) != 1) {
    tell_object(caster, BS("Irgendwie kannst du gerade kein Lied beginnen..."));
    return 0;
  }

  return ERFOLG;
}
