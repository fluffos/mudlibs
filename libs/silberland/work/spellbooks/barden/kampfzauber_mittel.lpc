mixed prep_kampfzauber_mittel(object caster, mapping sinfo)
{
    object instrument;
    string bardGroup;
    
    bardGroup = "/gilden/bardengilde/master/bardenmaster"->GetBardGroup(caster);

    instrument = getInstrument(caster);
    if(!objectp(instrument) || instrument->QueryProp(P_INSTRUMENT_TYPE) != BARD_GROUP_INSTRUMENT[bardGroup]) {
        tell_object(caster, BS("Dazu benoetigst du ein passendes Instrument."));
        return 0;
    }

    sinfo = prepare_song(caster, sinfo);
    if(sinfo == 0) {
            return 0;
    }

    if(present(SONG_PASSIVE_DMG, caster)) {
        if(TALENTMASTER->HasTalent(caster, TALENT_KANON)) {
         if(!present(SONG_PASSIVE_DMG, caster)->CanRecharge()) {
            write(BS("Dieser Zauber kann noch nicht erneuert werden."));
            return 0;
         }
        }else {
            write(BS("Du strahlst bereits starke Emotion aus!"));
            return 0;
        }
    }
    
    if(!paySpellCost(caster, sinfo, 1)) return 0;
 
    if(sinfo[SI_CAP_NAME] == "Der Goettin erster Krieger") play_song_text(SPELLSEQ("arcon_aura.seq"), caster);
    else play_song_text(SPELLSEQ(sprintf("kampfspell_mittel_%s.seq", bardGroup)), caster);
    return sinfo;
}

int kampfzauber_mittel(object caster, mapping sinfo)
{
    object aura;
    int suc, abil;
    float factor;
    string song, bg;

    // Spellkosten
    if(!paySpellCost(caster, sinfo)) return 0;

    // GELUNGEN?
    if((suc=SpellSuccess(caster,sinfo))<=0)
    {
         if(suc < -3000) {
             // extra arg
         } else {
             tell_object(caster, "Deine Gefuehle bleiben unveraendert.\n");
         }
         return MISSERFOLG;
    }

    abil = sinfo[SI_SKILLABILITY];

    if(objectp(aura = present(SONG_PASSIVE_DMG, caster))) {
        aura->remove(1);
    }

    aura = clone_object(OBJ("passive_combat"));
    if(aura->move(caster, M_NOCHECK) != 1)
    {
        write(BS("Etwas behindert die Zauberwirkung!"));
        aura->remove(1);
        return 0;
    }

    bg = call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", caster);

    switch(bg)
    {
        case "alestra": song = "haette ich ein herz";
                                        break;
        case "tirena":    song = "vana-o isil ar elena";
                                        break;
        case "korriax": song = "toetet das biest";
                                        break;
        case "sarrian": song = "wiegenlied des leids";
                                        break;
        default: raise_error("Undefinierte Bardengruppe!");
                         break;
    }

    factor = ((float) CheckEquip(caster, song))/100.0;
    if(TALENTMASTER->HasTalent(caster, TALENT_TAMBOURMAJOR)) {
        factor += 0.05 + ((float) caster->QueryProp(P_BARD_INSPIRATION_LEVEL)) / 100.0;
    }

    aura->Setup(caster, bg, sinfo[SI_SKILLABILITY], suc, factor);
    return ERFOLG;
}
