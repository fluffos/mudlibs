int lied_der_lieder(object caster, mapping sinfo)
{
  int suc;
  object ob;
  float factor;

  if(caster->InFight()) {
    write("Dazu fehlt dir gerade die Konzentration\n");
    return 0;
  }

  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) return 0;
  if(!paySpellCost(caster, sinfo)) return 0;

  // Gelungen?
  if((suc=SpellSuccess(caster,sinfo))<=0)
  {
    if(suc < -1500)
    {
      tell_object(caster, BS("Du kannst dich nicht richtig einstimmen. Alle deine Inspiration verschwindet."));
      caster->SetProp(P_BARD_INSPIRATION, 0);
      caster->SetProp(P_BARD_INSPIRATION_LEVEL, 0),
      caster->SetProp(P_BARD_LAST_INSPIRED, time());
    }
    return MISSERFOLG;
  }

  tell_object(caster, BS("Du beginnst eine virtuose Klangwelt zu spielen."));
  tell_room(ENV(caster), BS(caster->Name(WER)+" beginnt eine virtuouse Klangwelt zu spielen."), ({caster}));

  factor = 1.0 + ((float) CheckEquip(caster, lower_case(sinfo[SI_CAP_NAME]))/100.0);

  ob = clone_object(OBJ("ldl"));
  ob->Setup(sinfo[SI_CAP_NAME], caster, sinfo[SI_SKILLABILITY], suc, factor);
  if(ob->move(caster) != 1)
  {
    tell_object(caster, BS("Das Lied kann sich nicht manifestieren."));
  }  
  return ERFOLG;
}
