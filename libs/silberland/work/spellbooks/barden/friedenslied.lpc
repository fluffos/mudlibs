public mapping prep_friedenslied(object caster, mapping sinfo) {
  if(caster->InFight()) {
    write(BS("Du kannst dich nicht auf den Frieden konzentrieren, wenn du im Kampf bist!"));
    return 0;
  }

  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) {
      return 0;
  }

  if(present(SONG_PIECE, environment(caster)))
  {
    if(TALENTMASTER->HasTalent(caster, TALENT_KANON)) {
     if(!present(SONG_PIECE, environment(caster))->CanRecharge()) {
      write(BS("Dieser Zauber kann noch nicht erneuert werden."));
      return 0;
     } 
    }else {
      write(BS("Dieses Lied wirkt hier bereits!"));
      return 0;
    }
  }

  if(!paySpellCost(caster, sinfo, 1)) return 0;
 
  else play_song_text(SPELLSEQ(sprintf("der_alte_pakt.seq")), caster);
  return sinfo;
}


int friedenslied(object caster, mapping sinfo)
{
  int success;
  object song;
  float factor;

  if(caster->InFight()) {
    write(BS("Du kannst dich nicht auf den Frieden konzentrieren, wenn du im Kampf bist!"));
    return 0;
  }

  if(!paySpellCost(caster, sinfo)) return 0;

  if((success=SpellSuccess(caster,sinfo))<=0) {
    write(BS("Nichts geschieht."));
    say(BS("Nichts geschieht."));
    // TODO aggressive machen bei starkem misserfolg, raum blockieren bei normalem misserfolg
    return MISSERFOLG;
  }

  tell_room(environment(caster), BS("Mit einem gruen-goldenen Gleissen und einem lauten Zischen manifestiert sich am Boden "
           "das Siegel des alten Paktes, welches zu Friedfertigkeit gemahnt."));

           
  song = clone_object(OBJ("piece_seal"));
  
  factor = ((float) CheckEquip(caster, "der alte pakt"))/100.0;
  song->Setup(sinfo[SI_CAP_NAME], caster, sinfo[SI_SKILLABILITY], success, 1.0 + factor);
      
  if(song->move(environment(caster), M_NOCHECK|M_SILENT) != 1) {
    tell_object(caster, BS("Die Macht des Zauberlieds kann sich nicht manifestieren."));
    song->remove(1);
    return ERFOLG;
  }
  return ERFOLG;
}