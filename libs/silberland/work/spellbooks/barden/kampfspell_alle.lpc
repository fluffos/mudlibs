// !!Spellfun generiert von fun_to_spell.pl!!
int kampfspell_alle(object caster, mapping sinfo) {
  int suc;
  object ob;
  float factor;

  if(objectp(ob=caster->QueryProp(P_BARD_ROOM_DAMAGE))) {
    if(environment(ob) != environment(caster)) {
        tell_object(caster, BS("Du hast den Effekt dieses Leides bereits an einem anderen Ort beschworen!"));
        return 0;
    }
  }  

  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) return 0;
  if(!paySpellCost(caster, sinfo)) return 0;

  if((suc=SpellSuccess(caster,sinfo))<=0) {
    // TODO kritischer fehlschlag
    return MISSERFOLG;
  }

  tell_object(caster, BS("Du konzentrierst dich einen Moment auf das Musikstueck und beginnst dann zu spielen."));
  tell_room(ENV(caster), BS(caster->Name(WER)+" konzentriert sich kurz und beginnt dann Musik zu spielen."), ({caster}));

  factor = 1.0 + ((float) CheckEquip(caster, lower_case(sinfo[SI_CAP_NAME]))/100.0);

  ob = clone_object(OBJ("room_damage_control"));
  if(ob->move(caster) != 1){
    tell_object(caster, BS("Das Lied kann sich nicht manifestieren!"));
    return 0;
  }  

  ob->Setup(sinfo[SI_CAP_NAME], caster, sinfo[SI_SKILLABILITY], suc, factor);
  return ERFOLG;
}
