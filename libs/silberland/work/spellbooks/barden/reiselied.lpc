public int reiselied(object caster, mapping sinfo)
{
  object victim, song;
  int success;
  float factor;

  if(caster->InFight()) {
    tell_object(caster, BS("Du brauchst dein Luft gerade um deinen Feind zu besiegen!"));
    return 0;
  }

  if(!sinfo[SI_SKILLARG]) {
    victim = caster;
  } else if(call_other(TALENTMASTER, "HasTalent", caster, TALENT_LANDSTREICHER)) {
    victim = FindVictim(sinfo[SI_SKILLARG], caster, 0);
    if(!objectp(victim)) {
      tell_object(caster, BS("Wer soll dieses Lied anstimmen?"));
      return 0;
    }
  } else {
    tell_object(caster, BS("Dieses Lied koennen nur spezialisierte Landstreicher auf andere spielen."));
    return 0;
  }

  if(!interactive(victim)) {
    tell_object(caster, BS("Auf dieses Ziel kannst du das Lied nicht spielen."));
    return 0;
  }

  if(present(SONG_TRAVELLER, victim)) {
    tell_object(caster, BS("Dieses Zauberlied wirkt bereits!"));
    return 0;
  }
  
  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) return 0;
  if(!paySpellCost(caster, sinfo)) return 0;

  tell_object(caster, BS("Du wedelst mit deinen Haenden einen Rhythmus und stimmst ein froehliches Wanderlied an."));
  tell_room(environment(caster), BS(sprintf("%s wedelt mit den Haenden einen Rhythmus und stimmt ein froehliches Wanderlied an.", caster->Name(WER,1))), ({caster}));

  if((success=SpellSuccess(caster,sinfo))<=0)
  {
    tell_room(ENV(caster), BS("Irgendwie kommt keine rechte Wanderstimmung auf..."));
    return MISSERFOLG;
  }

  tell_object(victim, BS("Beschwingt traellerst du ein Lied und fuehlst dich bereit zum Aufbruch!"));
  tell_room(environment(victim), BS(sprintf("%s sieht erfrischt aus und beginnt froehlich ein Wanderlied zu traellern.", victim->Name(WER, 1))), ({victim}));
  victim->do_exhaust(-(success/10));

  song = clone_object("/gilden/bardengilde/obj/reiselied");
  if(!song->move(victim, M_SILENT|M_NOCHECK)) {
    tell_object(caster, BS("Das Lied wirkt nicht!"));
    return 0;
  }

  factor = 1.0 + ((float) CheckEquip(caster, "aller welten freund")/100.0); 
  song->Setup(caster, victim, sinfo[SI_SKILLABILITY], success, factor);
  return ERFOLG;
}