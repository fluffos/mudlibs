int furchtlied(object caster, mapping sinfo) {
  object victim, effect;
  int suc;
  float factor;

  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) {
    return 0;
  }

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster, "Wen soll dieses Lied treffen?\n");
  if(!objectp(victim)) return 0;

  if(!paySpellCost(caster, sinfo)) return 0;

  tell_object(caster, break_string(
    "Riss das Fenster auf jetzunder,\n"
    "und herein stolziert' - o Wunder!\n"
    "Ein gewalt'ger, hochbejahrter Rabe\n"
    "schwirrend zu mir her;\n"
    "Flog mit maecht'gen Fluegelstreichen,\n"
    "ohne Gruss und Dankeszeichen,\n"
    "Stolz und stattlich sonder Gleichen,\n"
    "nach der Tuere hoch und hehr -\n"
    "Flog nach einer Pallasbueste,\n"
    "Setzte sich und sonst Nichts mehr.", 75, "Du sprichst: ", BS_LEAVE_MY_LFS));
  tell_room(environment(caster), break_string(
    "Riss das Fenster auf jetzunder,\n"
    "und herein stolziert' - o Wunder!\n"
    "Ein gewalt'ger, hochbejahrter Rabe\n"
    "schwirrend zu mir her;\n"
    "Flog mit maecht'gen Fluegelstreichen,\n"
    "ohne Gruss und Dankeszeichen,\n"
    "Stolz und stattlich sonder Gleichen,\n"
    "nach der Tuere hoch und hehr -\n"
    "Flog nach einer Pallasbueste,\n"
    "Setzte sich und sonst Nichts mehr.", 75, sprintf("%s spricht: ", caster->Name(WER, 1)), BS_LEAVE_MY_LFS), ({caster}));
 
  // GELUNGEN?
  if((suc=SpellSuccess(caster,sinfo))<=0)
  {
    if(suc < -3000) {
      tell_object(caster, BS("Furcht packt dich in deinem Herzen!"));
      effect = clone_object("/gilden/bardengilde/obj/fear_buildup");
      effect->Setup(caster);
      effect->increase_fear(caster, (1+random(5))*0.1, 0.5);
    } 
    
    if(suc < -1500) {
      tell_object(caster, BS("Grauen und Furcht vor deinem eigenen Gedicht packen dich!"));
      tell_room(environment(caster), BS(sprintf("%s fuerchtet sich!", caster->Name(WER, 1))));
      caster->SetProp(P_WIMPY, caster->QueryProp(P_HP)*0.8);
    }
    return MISSERFOLG;
  }

  effect = clone_object("/gilden/bardengilde/obj/furchtlied");
  if(effect->move(caster, M_NOCHECK|M_SILENT) != 1) {
    tell_object(caster, BS("Die Macht des Zauberlieds kann sich nicht manifestieren."));
    effect->remove(1);
    return ERFOLG;
  }

  factor = ((float) CheckEquip(caster, "der besuch des raben"))/100.0;
  effect->Setup(caster, victim, sinfo[SI_SKILLABILITY], suc, factor, sinfo);

  return ERFOLG;
}