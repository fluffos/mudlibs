mapping prep_spaehlied(object caster, mapping sinfo) {
  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) {
    return 0;
  }

  if(!paySpellCost(caster, sinfo, 1)) return 0;

  tell_room(environment(caster), BS(sprintf("%s beginnt Musik zu spielen und zu singen.", caster->Name(WER, 1))), ({caster}));
  play_song_text(SPELLSEQ("spaehlied.seq"), caster);

  return sinfo;
}

int spaehlied(object caster, mapping sinfo)
{
  object effect;
  int suc;
  float factor;

  /* Spellkosten :) */
  if(!paySpellCost(caster, sinfo)) return 0;

  // GELUNGEN?
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    if(suc < -1500) {
      tell_object(caster, BS("Deine Sinne verschwimmen und verwirren dich!"));
      tell_room(environment(caster), BS(sprintf("%s rollt mit den Augen und sieht verwirrt aus!", caster->Name(WER, 1))), ({caster}));
      caster->SetProp(P_BLIND, ([
        BLIND_TIME: -1*suc/100,
        BLIND_MSG: "Deine Sinne sind vollkommen verwirrt!\n",
        BLIND_END_MSG: "Deine Sinne normalisieren sich wieder.\n"
      ]));
      caster->SetProp(P_DEAF, ([DEAF_TIME: -1*suc/1000]));
    }
    return MISSERFOLG;
  }

  write("Mit einem Ruck loesen sich deine Sinne von deinem Koerper...\n");
  say(sprintf("%s Augen werden weiss und scheinen einen andern Ort wahrzunehmen.\n", caster->Name(WESSEN)));

  effect = clone_object("/gilden/bardengilde/obj/magic_eye_control");
  if(effect->move(caster, M_NOCHECK|M_SILENT) != 1) {
    tell_object(caster, BS("Die Macht des Zauberlieds kann sich nicht manifestieren."));
    effect->remove(1);
    return ERFOLG;
  }

  factor = ((float) CheckEquip(caster, "die strasse gleitet fort"))/100.0;
  effect->Setup(caster, sinfo[SI_SKILLABILITY], suc, 1.0 + factor);

  return ERFOLG;
}