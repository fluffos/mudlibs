private void repairFailed(object caster) {
  object *armours, item;
  int limit;

  armours = caster->QueryArmours();
  if(objectp(caster->QueryProp(P_WEAPON))) {
    armours += ({ caster->QueryProp(P_WEAPON) });
  }

  item = 0;
  for(limit=10; limit > 0 && item == 0; limit--) { 
      item = armours[random(sizeof(armours))];
      if(item->QueryProp(P_ARMOUR_TYPE) == AT_MISC) {
          item = 0;
      }
  }

  tell_object(caster, BS(sprintf("%s zeigt eindeutige Anzeichen von Verschleiss!", item->Name(WER, 1))));
  tell_room(ENV(caster), BS(sprintf("%s macht sich offenbar Sorgen um %s!", caster->Name(WER, 1), item->name(WEN, 1))), ({caster}));
  item->Damage(random(3));
}

int reparaturlied(object caster, mapping sinfo)
{
  object song;
  int success;
  float factor;

  if(caster->InFight()) {
    tell_object(caster, BS("Du brauchst dein Luft gerade um deinen Feind zu besiegen!"));
    return 0;
  }

  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) return 0;
  if(!paySpellCost(caster, sinfo)) return 0;

  tell_object(caster, BS("Du spielst die ersten Akkorde von 'Das geborstene Schwert' und hebst zu epischem Gesang an."));
  tell_room(environment(caster), BS(sprintf("%s spielt die ersten Akkorde von 'Das geborstene Schwert' und hebt zu epischem Gesang an.",
            caster->Name(WER,1))), ({caster}));

  if((success=SpellSuccess(caster,sinfo))<=0) {
    if(success < -2500) {
      repairFailed(caster);
    } else {
      tell_room(ENV(caster), BS(sprintf("%s scheint den Text vergessen zu haben! Wie peinlich!", caster->Name(WER, 1))), ({caster}));
      tell_object(caster, BS("Ohje! Jetzt hast du doch glatt den Text vergessen. Ist das vielleicht peinlich..."));
    }
    return MISSERFOLG;
  }

  song = clone_object("/gilden/bardengilde/obj/repair");
  factor = 1.0 + ((float) CheckEquip(caster, "das geborstene schwert")/100.0);
  song->Setup(caster, sinfo[SI_SKILLABILITY], success, factor);
  if(!song->move(caster, M_NOCHECK)) {
    tell_object(caster, BS("Irgendwie kannst du gerade kein Lied beginnen..."));
    return 0;
  }

  return ERFOLG;
}
