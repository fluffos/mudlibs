public void thundering_finale(object caster, mapping sinfo, int success) {
    write(BS("Donnerndes Finale"));
    return;
}

public mapping prep_finale(object caster, mapping sinfo) {
    string name;

    if(caster->QueryProp(P_BARD_INSPIRATION_LEVEL) < 1) {
        write(BS("Dir fehlt die Inspiration fuer ein Finale!"));
        return 0;
    }

    name = lower_case(sinfo[SI_CAP_NAME][0..0])+sinfo[SI_CAP_NAME][1..];

    write(BS(sprintf("Du sammelst deine Inspiration und hebst die Haende fuer ein %s!", name)));
    say(BS(sprintf("%s sammelt %s Inspiration und hebt die Haende fuer ein %s!", caster->Name(WER, 1), name)));
    return sinfo;
}

public int finale(object caster, mapping sinfo) {
    int success;

    caster->SetProp(P_BARD_INSPIRATION, 0);
    caster->SetProp(P_BARD_INSPIRATION_LEVEL, 0);

    if((success=SpellSuccess(caster,sinfo))<=0) {
        write(BS("Deine Inspiration entgleitet dir und das Finale scheitert!"));
        return MISSERFOLG;
    }

    switch(sinfo[SI_CAP_NAME]) {
        case "Donnerndes Finale": thundering_finale(caster, sinfo, success); break;
        default:
            raise_error("Unbekanntes finale gezaubert\n");
            break;
    }

    return ERFOLG;
}
