/*
 * Das Zauberlied der Bardengilde
 * Verbessert SA_DAMAGE eine zeit lang, erhoeht dafuer die kosten aller zauber (DoCostModification im spellbook)
 * Kosten: 40 MP
 * 
 */
mapping prep_zauberlied(object caster, mapping sinfo)
{
  object ob;
  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) {
    return 0;
  }

  if(objectp(ob=present(SONG_SPELLBUFF, caster))) {
    if(TALENTMASTER->HasTalent(caster, TALENT_KANON)) {
      if(!ob->CanRecharge()) {
         write(BS("Dieser Zauber kann noch nicht erneuert werden."));
         return 0;
      }
     } else {
      tell_object(caster, BS("Diese Zaubermelodie wirkt noch auf Dich!"));
         return 0;
     }
  }

  if(!paySpellCost(caster, sinfo, 1)) return 0;

  return sinfo;
}

int zauberlied(object caster, mapping sinfo)
{
  int suc;
  int percent, duration;
  string *what;
  object marker;

   /* Spellkosten :) */
  if(!paySpellCost(caster, sinfo)) return 0;

  // Gelungen?
  if((suc=SpellSuccess(caster,sinfo))<=0)
  {
    write(BS("Das Lied daempft die Schwingungen Deiner Lieder!"));
    if(suc > -1500) caster->ModifySkillAttribute(caster, SA_QUALITY, 50, 60);
    marker = clone_object(OBJ("spellbuff"));
    marker->SetupFail(caster, 60);
    marker->move(caster, M_NOCHECK|M_SILENT);
    return MISSERFOLG;
  }

  if(objectp(marker=present(SONG_SPELLBUFF, caster))) {
    marker->remove(1);
  }

  marker = clone_object(OBJ("spellbuff"));
  marker->Setup(caster, sinfo[SI_SKILLABILITY], suc, ((float) CheckEquip(caster, "lied der zauber"))/100.0);
  marker->move(caster, M_NOCHECK|M_SILENT);
  return ERFOLG;
}
