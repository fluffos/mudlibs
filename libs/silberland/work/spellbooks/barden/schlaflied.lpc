// !!Spellfun generiert von fun_to_spell.pl!!
mapping prep_schlaflied(object caster, mapping sinfo) {

  if(caster->InFight()) {
    tell_object(caster, BS("Im Kampf bist du zu aufgewuehlt dafuer!"));
    return 0;
  }

  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) {
    return 0;
  }

  sinfo=DoCostModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster, tooLowSpMessage(sinfo));
    return 0;
  }

  tell_room(environment(caster), BS(sprintf("%s beginnt sanft zu singen.", caster->Name(WER, 1))), ({caster}));

  play_song_text(SPELLSEQ("schlaflied.seq"), caster);
  return sinfo;
}

public int isNotSleepyPotentialEnemy(object ob) {
  return isPotentialEnemy(ob) && !present(SONG_SLEEP, ob);
}


int schlaflied(object caster, mapping sinfo)
{
  object *targets, song;
  int success, i, n;
  float factor;

  if(!paySpellCost(caster, sinfo)) return 0;

  n = sinfo[SI_SKILLABILITY] / 3333;
  if(caster->QueryProp(P_TESTPLAYER)) write(sprintf("n=%d\n"));
  targets = findTargets(caster, "isNotSleepyPotentialEnemy", TO, n);
  if(sizeof(targets) < 1) {
    tell_object(caster, BS("Nanu? Da ist ja gar niemand, den du muede machen kannst!"));
    return 0;
  }

  // GELUNGEN?
  if((success=SpellSuccess(caster,sinfo))<=0) {
    if(success < -2000) {
      tell_object(caster, BS("Du wirst ganz schlaefrig und gaehnst..."));
      tell_room(environment(caster), BS(sprintf("%s gaehnt muede...", caster->Name(WER, 1))), ({caster}));
      caster->ModifySkillAttribute(caster, SA_SPEED, 60, 6 - random(success/500));
    } else {
      tell_object(caster, BS("Niemand scheint muede zu werden."));
    }

    return MISSERFOLG;
  }

  factor = 1.0 + ((float) CheckEquip(caster, lower_case(sinfo[SI_CAP_NAME]))/100.0);

  for(i=0; i<sizeof(targets); ++i) {
    if(!objectp(targets[i])) continue;
    if(targets[i] == caster) continue;
    if(targets[i]->id("NOCONTROL") ||
       targets[i]->is_class_member(CL_UNDEAD) || targets[i]->is_class_member(CL_ZOMBIE) ||
       targets[i]->is_class_member(CL_SKELETON) || 
       random(2 * caster->QueryProp(P_GUILD_LEVEL) + 3 * caster->QueryAttribute(A_INT)) < targets[i]->QueryProp(P_NOMAGIC)) {
      write(targets[i]->Name(WER)+" widersteht der Wirkung deines Lieds.\n");
      continue;
    }

    song = clone_object(OBJ("sleep"));
    song->Setup(sinfo[SI_CAP_NAME], caster, sinfo[SI_SKILLABILITY], success, factor, targets[i]);
    if(song->move(targets[i], M_NOCHECK|M_SILENT) != 1) {
      tell_object(caster, BS(sprintf("Das Lied wirkt nicht auf %s!", targets[i]->name(WEN, 1))));
      song->remove(1);
    }
    caster->Kill(targets[i]);
  }

  return ERFOLG;
}