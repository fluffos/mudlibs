int isHymnOfHopeTarget(object ob) {
    return (interactive(ob) || ob->QueryProp(P_FRIEND)) && !present(SONG_FRIEND_BOOST, ob) && !IS_LEARNER(ob);
}

mapping prep_band_der_freundschaft(object caster, mapping sinfo) {
    object target;

   sinfo = prepare_song(caster, sinfo);
    if(sinfo == 0) {
        return 0;
    }

    if(!paySpellCost(caster, sinfo, 1)) return 0;

    if(present(SONG_FRIEND_BOOST, caster) || objectp(caster->QueryProp("bard_friend_boost"))) {
        write(BS("Du hast bereits ein Freundschaftsband."));
        return 0;
    }
  
    if(sinfo[SI_CAP_NAME] != "Hymne der Hoffnung") {
        target = FindVictim(sinfo[SI_SKILLARG], caster, 0);
        if(!objectp(target)) {
            write(BS("Fuer wen moechtest du dieses Lied singen?"));
            return 0;
        }

        if(!interactive(target) || IS_LEARNER(target)) {
            write(BS("Fuer dieses Ziel kannst Du dieses Lied nicht singen!"));
            return 0;
            }

        tell_room(environment(caster), BS(sprintf("%s beginnt Musik zu spielen und konzentriert sich auf %s.", 
                    caster->Name(WER, 1), target->name(WEN, 1))), ({caster, target}));
        tell_object(target, BS(sprintf("%s beginnt Musik zu spielen und konzentriert sich auf dich.", caster->Name(WEN, 1))));
        play_song_text(SPELLSEQ("band_der_freundschaft.seq"), caster);
    } else {
        if(sizeof(filter_array(all_inventory(environment(caster)), "isHymnOfHopeTarget")) < 2) {
            // mindest eines weiter Person muss da sein
            write(BS("Hier ist niemand, den du mit deiner Hymne der Hoffnung inspirieren kannst!"));
            return 0;
        }
        
        tell_room(environment(caster), BS(sprintf("%s beginnt Musik zu spielen und inspirierend zu singen.", 
                    caster->Name(WER, 1))), ({caster}));
        //tell_object(target, BS(sprintf("%s beginnt Musik zu spielen und inspirierend zu singen.", caster->Name(WEN, 1))));
        play_song_text(SPELLSEQ("hymn_of_hope.seq"), caster);
    }

    return sinfo;
}

int band_der_freundschaft(object caster, mapping sinfo) {
    object target, song, *allTargets;
    int success, i;
    float factor;

    allTargets = ({ });

    if(sinfo[SI_CAP_NAME] != "Hymne der Hoffnung") {
        target = FindVictim(sinfo[SI_SKILLARG], caster, 0);
        if(!objectp(target)) {
            write(BS("Huch? Dein Ziel ist gar nicht mehr da."));
            return 0;
        }

        allTargets = ({ target });
    } else {
        allTargets = filter_array(all_inventory(environment(caster)), "isHymnOfHopeTarget");
        allTargets -= ({ caster });
        if(sizeof(allTargets) < 1) {
            write(BS("Hier ist niemand mehr, den du mit deiner Hymne der Hoffnung inspirieren kannst!"));
            return 0;
        }
    }

    if(!paySpellCost(caster, sinfo)) return 0;

    if((success = SpellSuccess(caster,sinfo)) <=0 ) {
        tell_room(environment(caster), BS("Nichts passiert..."));
        return MISSERFOLG;
    }

    factor = 1.0 + ((float) CheckEquip(caster, "band der freundschaft"))/100.0;


    if(sinfo[SI_CAP_NAME] != "Hymne der Hoffnung") {
        song = clone_object(OBJ("friend_boost"));
        if(song->move(caster, M_GET|M_NOCHECK) != 1) {
            write(BS("Das Lied kann sich fuer " + target->name(WEN, 1) + " nicht manifestieren..."));
            song->remove(1);
            return 0;
        }
        song->Setup(lowerstring(sinfo[SI_CAP_NAME]), caster, sinfo[SI_SKILLABILITY], success, factor,target);
    } else {
        song = clone_object(OBJ("hymn_of_hope"));
        if((i = song->move(environment(caster), M_GET|M_NOCHECK)) != 1) {
            write(BS("Das Lied kann sich nicht manifestieren... "+i));
            song->remove(1);
            return 0;
        }

        for(i=0; i<sizeof(allTargets); ++i) {
            song->addTarget(allTargets[i]);
        }
        song->Setup(lowerstring(sinfo[SI_CAP_NAME]), caster, sinfo[SI_SKILLABILITY], success, factor,target);
    }

    return ERFOLG;
}
