/*
 * Ode an die Sterne
 *
 * Ein klassischer Lichtspell, fuer Dunkelelfen wirds dunkel.
 *
 * MP: 20
 * Gildenstufe 2
 *
 * Gwenshara@SL
 * 09.07.2007
 */

#define WRITE_DARKELF(x) if(caster->QueryProp(P_RACE) == "Dunkelelf") write(BS(x))
#define ROOM_DARKELF(x)  if(caster->QueryProp(P_RACE) == "Dunkelelf")\
                            tell_room(ENV(caster), BS(x), ({caster}))

mixed prep_lichtlied(object caster, mapping sinfo)
{
  sinfo = prepare_song(caster, sinfo);
  if(sinfo == 0) {
    return 0;
  }

  if(present(SONG_STERNE, caster))
  {
    WRITE_DARKELF("Die Dunkelheit der Nacht umgibt Dich bereits.");
    else write(BS("Das Licht der Sterne umgibt Dich bereits."));
    return 0;
  }
  
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST])
  {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
				 
  if(caster->QueryProp(P_RACE) == "Dunkelelf")
     play_song_text(SPELLSEQ("lichtlied_delf.seq"), caster);
  else
     play_song_text(SPELLSEQ("lichtlied.seq"), caster);
  return sinfo;
  
}


int lichtlied(object caster, mapping sinfo)
{
  object lightob;
  int abil, suc;

  if(!paySpellCost(caster, sinfo)) return 0;
  
  // GELUNGEN?
  if((suc=SpellSuccess(caster,sinfo))<=0)
  {
    write(BS("Das Zauberlied entfaltet seine Wirkung nicht!"));
    tell_room(ENV(caster), BS("Nichts geschieht."), ({caster}));
    return MISSERFOLG;
  }

  if(TALENTMASTER->HasTalent(caster, TALENT_LANDSTREICHER)) {
    WRITE_DARKELF("Eine finstere Neumondnacht senkt sich ueber Dich.");
    else write(BS("Einige Sterne erscheinen, drehen ihre Bahnen und leuchtet fuer Dich."));
    ROOM_DARKELF("Finstere Neumondnacht senkt sich ueber "+caster->Name(WEN)+".");
    else tell_room(ENV(caster), BS("Einige Sterne erscheinen und leuchten den Weg fuer "+caster->Name(WEN)+"."), ({caster}));
  } else {
    WRITE_DARKELF("Die Nacht senkt sich ueber Dich.");
    else 
      write(BS("Ein Stern erscheint, dreht seine Bahnen um Dich und leuchtet fuer Dich."));
    ROOM_DARKELF("Die Nacht senkt sich ueber "+caster->Name(WEN)+".");
    else tell_room(ENV(caster), BS("Ein Stern erscheint und leuchtet den Weg fuer "+caster->Name(WEN)+"."), ({caster}));
  }

  lightob = clone_object(OBJ("lightob"));
  lightob->SetVars(caster, suc);
  lightob->move(caster);
  return ERFOLG;
}
