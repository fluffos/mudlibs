          SI_PREPARE_TIME: 4,
          SI_PREPARE_MSG: BS("Du nimmst Deine Iama in die Hand und "
                          "spielst die komplex verwobene Meistermelodie der Zeit."),
          SI_PREPAREFUNC: "prep_melodie_der_zeit",
          SI_SPELLFUNC: "melodie_der_zeit",
          ]));
      
  
  //--Pfad der Messer------------------------------------------------
  AddSpell(KLINGENWIRBEL,40,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:11]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:11]),
             SI_SPELLFATIGUE: 4,
             SI_PREPARE_TIME: 0,
             SI_PREPARE_MSG: BS("Du packst deine Klinge fester und wirbelst einmal um deine eigene Achse."),
