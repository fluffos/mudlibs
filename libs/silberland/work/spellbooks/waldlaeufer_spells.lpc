//**************************************************************************//



//** Parsing der Spells/Uebersetzungen *************************************//
//-- Skillargs ---------------------------------------------------------------
mixed parse_target(string str) 
{
  string wen;
  
  if(!str) {return str;}
  if(sscanf(str, "auf %s", wen)!=1) {return 0;}
  return wen;
}

//-- Spells zwischen '' ------------------------------------------------------
mixed ranger_parsing(string str) 
{
  string *parts;
  string arg;
  if(!sizeof(regexp( ({ str }), "'.*'"))) 
  {
    write(BS("Du musst den Namen des Zauberspruches zwischen ' ' setzen."));
    return 0;
  }
  parts=explode(str, "'");
  if(sizeof(parts) < 1)
  {
    write(BS("Du musst den Namen des Zauberspruches zwischen ' ' setzen."));
    return 0;
  }
  arg=implode(parts[1..], " ");
  if(arg[0..0] == " ")  {arg=arg[1..];}
  arg=parse_target(arg);
  return ({ arg, parts[0] });
}

//-- Schnelle Zugriffsfunktion fuer gender-abhaengige Formulierungen ---------
string checkgender(object pl, string female, string male) 
{
  if(pl->QueryProp(P_GENDER) == FEMALE)
  { return female; }
  return male;
}

//-- Uebersetzungen ins deutsche ---------------------------------------------
string to_german(string str)
{
  switch(str) {
    //physische Schadensarten
    case DT_SLASH:     str="Schlagschaden";        break;
    case DT_BLUDGEON:  str="Hiebschaden";          break;
    case DT_PIERCE:    str="stechenden Schaden";   break;
    case DT_WHIP:      str="peitschenden Schaden"; break;
    case DT_RIP:       str="reissenden Schaden";   break;
    case DT_SQUEEZE:   str="quetschenden Schaden"; break;
    //magsiche Schadensarten
    case DT_FIRE:      str="Feuerschaden";         break;
    case DT_COLD:      str="Kaelteschaden";        break;
    case DT_WATER:     str="Wasserschaden";        break;
    case DT_AIR:       str="Luftschaden";          break;
    case DT_LIGHTNING: str="Blitzschaden";         break;
    case DT_EXPLOSION: str="explosiven Schaden";   break;
    case DT_SOUND:     str="Laermschaden";         break;
    case DT_LIGHT:     str="Lichtschaden";         break;
    case DT_ELECTRIC:  str="elektrischen Schaden"; break;
    case DT_ACID:      str="Saeureschaden";        break;
    case DT_POISON:    str="Giftschaden";          break;
    case DT_TERROR:    str="Terrorschaden";        break;
    case DT_HOLY:      str="heiligen Schaden";     break;
    case DT_UNHOLY:    str="unheiligen Schaden";   break;
    case DT_MIND:      str="psychischen Schaden";  break;
    case DT_MAGIC:     str="Magieschaden";         break;
  }
  return str;
}

//-- Uebersetzungen der Waffenarten (ausgelagert wegen Ueberschneidungen) ----
string weapon_to_german(string str)
{
  switch(str) {
    //Waffenarten
    case WT_SWORD:     str="ein Schwert";          break;
    case WT_AXE:       str="eine Axt";             break;
    case WT_CLUB:      str="eine Keule";           break;
    case WT_SPEAR:     str="einen Speer";          break;
    case WT_KNIFE:     str="ein Messer";           break;
    case WT_WHIP:      str="eine Peitsche";        break;
    case WT_CHAIN:     str="eine Kettenwaffe";     break;
    case WT_BOW:       str="ein Bogen";            break;
    case WT_AMMU :     str="Munition";             break;
    case WT_HANDS:     str="eine Faustwaffe";      break;
    case WT_MAGIC:     str="eine magische Waffe";  break;
    case WT_MISC:      str="eine normale Waffe";   break;
  }
  return str;
}
//**************************************************************************//



//** Einige Abfragen nach Aussen (u.a. default_npc) ************************//
//-- Welches Gildenlevel benoetigt Zaehmung? ---------------------------------
int get_spell_use_guild_level(string spell)
{
  mixed m, m2;
  
  m=QuerySpell(spell);
  if( mappingp(m) && mappingp(m2=m[SI_SKILLRESTR_USE]) )
  { return m2[P_GUILD_LEVEL]; }
  return 0;
}
//**************************************************************************//



//** ERFOLG/MISSERFOLG *****************************************************//
//--Misserfolg----------------------------------------------------------------
void Misserfolg(object caster, string spell, mapping sinfo)
{
  int old_abil;
  
  if (!total_fail)
  { tell_object(caster, BS("Deine Beschwoerung ist fehlgeschlagen.\n")); }
  total_fail = 0;  // gleich zuruecksetzen
  old_abil = sinfo[SI_SKILLABILITY];
  Learn(caster, spell, sinfo);
  sinfo=caster->QuerySkill(spell);
  if (old_abil < (mappingp(sinfo) ? sinfo[SI_SKILLABILITY] : sinfo))
  { write("Du lernst aus Deinem Fehler.\n"); }
  else
  { write( "Leider lernst Du nicht aus Deinem Fehler.\n" ); }
}

//--Erfolg--------------------------------------------------------------------
void Erfolg(object caster, string spell, mapping sinfo) 
{ caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "waldlaeufer");
  return; }
//**************************************************************************//



//** SpellAnpassung ********************************************************//
//-- Beim create den Pfad und den Spellnamen extra speichern -----------------
int AddSpell(string verb, int kosten, mixed sinfo)
{
  if(mappingp(sinfo))
  { sinfo[SI_SPELLNAME]=verb;
    sinfo+=([SI_PATH:GUILD_MASTER->get_path(verb)]);}
  return ::AddSpell(verb, kosten, sinfo);
}

//-- Nutzung eines Spells ----------------------------------------------------
/*
int UseSpell(object caster, string spell, mapping sinfo)
{
  return ::UseSpell(caster, spell, sinfo);  
}
*/

//-- Darf der Ranger den Zauber beschwoeren? ---------------------------------
int CanTrySpell(object caster, mapping sinfo)
{
  int i, n, gl;
  mixed res;
  
  /*Metall - bloede Restriktion (gwenshara - 2024)
  if(QueryMetal(caster))
  {
    tell_object(caster, BS("Du kannst mit soviel Metall an Deinem Koerper "
                        "nicht die Kraefte des Waldes nutzen!"));
    return 0; 
  }*/
  
  //Pfadueberpruefung + GL
  res=RANGERMASTER->GetPaths(getuid(caster));
  if(!pointerp(res)) { res=({"",""}); }
  n=member(res, sinfo[SI_PATH]);
  if(stringp(sinfo[SI_PATH]))
  {
    if(n == -1)
    {
      tell_object(caster, BS("Du befindest Dich nicht auf dem Pfad der "
                          +sinfo[SI_PATH]+"."));
      return 0; 
    }

    i=get_spell_use_guild_level(sinfo[SI_SPELLNAME]);
    if(i>16 && stringp(sinfo[SI_PATH]) && !RANGERMASTER->HasMasterPath(getuid(caster), sinfo[SI_PATH])) {
      tell_object(caster, BS("Dazu musst du ein Meister des "+sinfo[SI_PATH]+"pfades sein!"));
      return 0;
    }

    //DBD(sinfo[SI_SPELLNAME]);
    /* Unnoetig - das Spellbook prueft das gildenlevel. das buggt nur in hoeheren kreisen mit niedrigerem rang
    i=get_spell_use_guild_level(sinfo[SI_SPELLNAME]);
    gl=caster->QueryProp(P_GUILD_LEVEL);
    gl-=(5*n);
    if(gl<i)
    {
      tell_object(caster, BS("Dein Rang ist nicht hoch genug."));
      return 0; 
    }*/
  }
  
  //Kostenmodifizierung
  sinfo=CostModification(caster, sinfo);
  //uebergeordnete Funktion
  return ::CanTrySpell(caster, sinfo);
}

//-- Ist die Vorfunktion gelungen, werden hier noch einige Dinge geregelt ----
void FirstPrepareFuncSuccessfull(object caster, mapping sinfo)
{
  //Waerend der Vorbereitungszeit darf man nicht ausweichen!
  caster->SetProp(P_RANGER_NO_MAGIC_DEFENSE, time()+sinfo[SI_PREPARE_TIME]);
}

public string highestWeaknessOf(object target) {
  mapping weaknesses;
  string bestMatch, *values, value;
  float bmValue, cv;
  int i;

  if(!objectp(target)) return "magic";

  weaknesses = target->QueryProp(P_RESISTANCE_STRENGTHS);
  if(!mappingp(weaknesses)) return DT_MAGIC;

  bestMatch = DT_MAGIC;
  bmValue = -10.0;
  values = m_indices(weaknesses);
  for(i=0; i<sizeof(values); ++i) {
    value = values[i];
    cv = weaknesses[value];
    if(!floatp(cv)) cv = 1.0 * cv;
    if( cv > bmValue) {
      bmValue = cv;
      bestMatch = value;
    }
  }

  return bestMatch;
}

//-- Alle Angriffsspells kommen hier zusammen --------------------------------
// ob = Ziel des Angriffs
// caster = Waldlaeufer
// sinfo = spell info mapping
// is_spell = passdown for TryAttackSpell
// weaponMode = 0=ohne waffe|1=messer|2=bogen
// weapon = uebersteuerte waffe, die zu verwenen ist (zB wurfmesser)
// nocombo = wenn 1 dann wird keine combo getriggert
// return: verursachter schaden
varargs int ExecuteAttackSpell(object ob, object caster, mapping sinfo,mixed is_spell, int weaponMode, object weapon, int nocombo) {
  int dam, can_see, i, magicDts, r;
  mixed dtypes, combo, *flame;
  string wt;
  object booster;
  
  dam=sinfo[SI_SKILLDAMAGE];
  can_see=( (IS_WIZARD(getuid(caster)) || caster->QueryProp(P_TESTPLAYER)) && (caster->QueryProp(P_RANGER_SHOW_COMBOS)==1) );

  if(weaponMode == ATTACK_SPELL_BOW ||weaponMode == ATTACK_SPELL_KNIFE) {
    
    if(!objectp(weapon)) weapon=caster->QueryProp(P_WEAPON);
    if(!objectp(weapon)) {
      tell_object(caster, BS("Ohne Waffe geht das nicht!")); // ohne waffe keine waffenbasierten angriffe
      return 0;
    }

    wt = weapon->QueryProp(P_WEAPON_TYPE);

    // bei Waffenangriffen kommt der WC der waffe dazu
    if(weaponMode == ATTACK_SPELL_BOW && wt == WT_BOW || weaponMode == ATTACK_SPELL_KNIFE && wt = WT_KNIFE) {
      dam = weapon->QueryProp(P_WC) + sinfo[SI_SKILLDAMAGE];
      pDebug(caster, sprintf("ExecuteAttackSpell :: weapon damage base = %d\n", dam));
      r = caster->UseSkill(FIGHT(wt), ([SI_ENEMY: ob]))["si_damage"]/2; // kampfskillanwendung kommt halb dazu
      dam += r;
      pDebug(caster, sprintf("ExecuteAttackSpell :: +skill=%d dam=%d\n", r, dam));
    }
    // schdenstypen der waffe kommen dazu
    dtypes = weapon->QueryProp(P_DAM_TYPE); 
    if(!pointerp(dtypes)) dtypes = ({dtypes});

    // kalte flamme einrechnen fuer den bogen
    if(wt == WT_BOW && pointerp(flame=caster->QueryProp(P_RANGER_COLD_FLAME)) && flame[1] >= time()) {
      r = flame[3];
      dtypes += flame[2];
      dam += r;
      pDebug(caster, sprintf("ExecuteAttackSpell :: +flame=%d dam=%d\n", r, dam));
    }

    if(objectp(booster=present(EDGE_SOUL_ID, caster))) {
      if(stringp(booster->QueryProp(P_DAM_TYPE))) {
        dtypes += ({ booster->QueryProp(P_DAM_TYPE) });
      }
    }


    if(!pointerp(sinfo[SI_SKILLDAMAGE_TYPE])) sinfo[SI_SKILLDAMAGE_TYPE] = ({ sinfo[SI_SKILLDAMAGE_TYPE] });
    for(i=0; i<sizeof(dtypes); ++i) {
      if(member(sinfo[SI_SKILLDAMAGE_TYPE], dtypes[i]) < 0) 
        sinfo[SI_SKILLDAMAGE_TYPE] += ({ dtypes[i] });
    }
    pDebug(caster, sprintf("ExecuteAttackSpell :: damage_type=%O\n", sinfo[SI_SKILLDAMAGE_TYPE]))

    // magische schadensarten koennen abgeblockt werden
    if(sinfo[SI_NOMAGIC] != 0) {
      magicDts = 0;
      for(i=0;i<sizeof(sinfo[SI_SKILLDAMAGE_TYPE]); ++i) {
        if(member(MAGICAL_DAMAGE_TYPES, sinfo[SI_SKILLDAMAGE_TYPE][i])) {
          magicDts++;
        }
      }
    //  pDebug(caster, sprintf("ExecuteAttackSpell :: nonmagic_dts=%d dts=%d nomagicReduction=%.2f\n", magicDts, ))
      sinfo[SI_NOMAGIC] = (int) (sinfo[SI_NOMAGIC] * (1.0-((float) magicDts/sizeof(dtypes))));
    }
   }
  
  //Skillpoint
  if(weaponMode == ATTACK_SPELL_KNIFE && wt == WT_KNIFE &&  R_SKILLMASTER->HasSkill(getuid(caster), KLINGENMEISTER) ||
     weaponMode == ATTACK_SPELL_BOW && wt == WT_BOW && R_SKILLMASTER->HasSkill(getuid(caster), BOGENMEISTER)) {
      r = dam/5; // nochmal bis zu +20% schaden
      dam += r;
      pDebug(caster, sprintf("ExecuteAttackSpell :: +mastery_skill=%d dam=%d\n", r, dam));
  }
                                 
  //Erzfeind
  if(IsArchEnemy(getuid(caster), ob)) {
    r = random(dam*caster->QueryProp(P_GUILD_LEVEL)/100);
    dam+=r;
    pDebug(caster, sprintf("ExecuteAttackSpell :: +enemy=%d dam=%d\n", r, dam));
  }
  
  //Im Wald?
  if(IsInForest(caster)) { 
    r = random((int) (dam*caster->QueryProp(P_GUILD_LEVEL)/200)); 
    dam += r;
    pDebug(caster, sprintf("ExecuteAttackSpell :: +forest=%d dam=%d\n", r, dam));
  }
  
  //Ausruestung
  dam=get_equip_damage(caster, sinfo[SI_SPELLNAME], dam);

  pDebug(caster, sprintf("ExecuteAttackSpell :: modified by equipment dam=%d ffset(dam)=%d\n", dam, sinfo[OFFSET(SI_SKILLDAMAGE)]));
  sinfo[SI_SKILLDAMAGE] = dam;

  //Combos und liegende Feinde
  sinfo=FalldownModification(ob, caster, sinfo);
  pDebug(caster, sprintf("ExecuteAttackSpell :: falldown mod dam=%d offset(dam)=%d\n", sinfo[SI_SKILLDAMAGE], sinfo[OFFSET(SI_SKILLDAMAGE)]));
  if(!nocombo) {
    sinfo=ComboModification(ob, caster, sinfo);
    pDebug(caster, sprintf("ExecuteAttackSpell :: combo mod dam=%d\n offset(dam)=%d\n", sinfo[SI_SKILLDAMAGE], sinfo[OFFSET(SI_SKILLDAMAGE)]));
  }

  if(wt == WT_BOW && caster->QueryProp(P_GUILD_LEVEL) > 18 && objectp(booster = present(GUILD_OBJ_ID, caster)) && pointerp(flame = booster->QueryProp(P_RANGER_FREISCHUETZ))) {
    if(flame[RANGER_FREISCHUETZ_ACTIVE]) {
      tell_object(caster, BS("Der Freipfeil erkennt im Flug die groesste Schwachstelle deines Gegners!"));
      sinfo[SI_SKILLDAMAGE_TYPE] = ({ highestWeaknessOf(sinfo[SI_ENEMY]) });
      pDebug(caster, sprintf("freipgeil :: dmt_type = %s\n", sinfo[SI_SKILLDAMAGE_TYPE][0]));
      booster->UseFreipfeil();
    }
  }
  
  
  //Der Angriff
  if(can_see) {
    tell_object(caster, BSC(ANSI_RED+"Uebergebener Schaden: "+ANSI_NORMAL+to_string(sinfo[SI_SKILLDAMAGE])+
                            ANSI_RED+" Nomagic: "+ANSI_NORMAL+to_string(sinfo[SI_NOMAGIC])));
  }
  dam=TryDefaultAttackSpell(ob, caster, sinfo, is_spell);
  
  //Auswertung
  if(can_see) {
    tell_object(caster, BSC(ANSI_BOLD+ANSI_RED+"Erlittener Schaden: "+ANSI_NORMAL+to_string(dam)));
  } 

  if(!nocombo) {
    if(!dam || !objectp(ob) ) { 
      ComboFail(caster, sinfo); 
    }
    else {
      ComboDone(caster, ob, sinfo);
    } 
  }
  return dam;
}
//**************************************************************************//

// nach pfeilschuessen ist ein kurzer aussetzer, das hier informiert, dass es weiter geht.
public void inform_nachladen(object caster) {
  string *msg;

  msg = ({
    "Du atmest kurz durch, senkst den Bogen und legst einen Pfeil nach.",
    "Du ziehst einen neuen Pfeil auf die Sehne.",
    "Erneut ziehst du den Bogen auf.",
    "Schnell holst du einen neuen Pfeil aus dem Koecher.",
    "Du entspannst die Schultern und bist bereit fuer den naechsten Schuss.",
    "Mit geuebter Bewegung legst du einen neuen Pfeil auf die Sehne."
  });

  tell_object(caster, BS(msg[random(sizeof(msg))]));
  return;
}

// hier wird nach bogenschuessen "nachgeladen"
public void reload(object caster, mapping sinfo) {
  caster->SetProp(P_DISABLE_ATTACK, sinfo[SI_SPELLFATIGUE]/4);
  call_out("inform_nachladen", sinfo[SI_SPELLFATIGUE], caster);
  return;
}

// zielen bei bogenschuessen
public void aim(object caster, mapping sinfo) {
  if(!mappingp(sinfo)) return;
  caster->SetProp(P_DISABLE_ATTACK, sinfo[SI_PREPARE_TIME]);
  return;
}

public void iama_voice_of_nature(object caster) {
  object ob, env;
  string terrain;
  mapping envdata;

  if(RANGERMASTER->GetMasterAbility(getuid(caster)) != MASTER_ABIILITY_VOICE_OF_NATURE) return;

  env=environment(caster);
  if(!objectp(env)) return;
  if(!mappingp(envdata=env->QueryProp(P_ENVIRONMENT))) return;
  if(!member(envdata, ENV_TERRAIN)) return;
  terrain = envdata[ENV_TERRAIN];

  if(objectp(ob=present("\nvoice_of_nature", caster))) {
    if(ob->QueryProp("terrain") == terrain) return; // haben wir schon
  }

  if(objectp(ob=clone_object(OBJ "voice_of_nature"))) {
    if(ob->move(caster, M_SILENT) != 1) {
      destruct(ob);
      return;
    }
    
    ob->activate_terrain(terrain);
  }

  return;
}

public void rage_of_avatara(object caster, object enemy) {
  string msg;
  object p;

  if(RANGERMASTER->GetMasterAbility(getuid(caster)) != MASTER_ABIILITY_RAGE_OF_NATURE) return;
  if(!objectp(enemy)) return;

  /*
  Eoin (Licht, Schwanenkönigin) → Blendung → Gegner treffen seltener.
Arawn (Unheilig, Fluchrabe) → Fluch → Gegner erleiden verringerten Schadenoutput.
Morcan (Furcht, Schattenwolf) → Schrecken → Gegner verlieren Initiative.
Ciaran (Kälte, Elchkönig) → Frost → Gegner bewegen sich langsamer.
Fiachra (Gift, Schlange) → Vergiftung → Leichter Schaden über Zeit.
Belenus (Magie, Drache) → Magiefluch → Gegnerische Zauber kosten +1 MP.
Thorondor (Blitz, Donnervogel) → Schock → Chance auf kurze Lähmung.
Bran (Luft, Sturmfalke) → Windstoß → Gegnerische Angriffe können fehlschlagen.
Lir (Heilig, Weißer Hirsch) → Reinheit → Gegnerische Heilung ist schwächer.
Aedan (Feuer, Sonnenluchs) → Verbrennung → Feuerschaden über Zeit.
Brenin (Säure, Krötenherrin) → Zersetzung → Gegnerische Rüstung sinkt.
*/
  
  switch(random(11)) {
    case 0: // Eoin
      msg = BS("Ein heller Schwan jagt durch den Raum. "+enemy->Name(WER)+" wird geblendet!");
      enemy->SetProp(P_BLIND, 5 + random(15));
      break;
    case 1: // Arawn
      msg = BS("Ein schwarzer Rabe kreist ueber "+enemy->Name(WEM)+" und ein schwaechender Fluch trifft "+enemy->name(WEN)+".");
      enemy->ModifySkillAttribute(caster, SA_DAMAGE, 50, 5+random(10));
      break;
    case 2: // Morcan
      msg = BS("Das Heulen eines Wolfs ist zu hoeren. "+enemy->Name(WER)+" wirkt verunsichert.");
      enemy->SetProp(P_DISABLE_ATTACK, 2+random(4));
      if(!random(3) && !enemy->id("NOWIMPY") && !enemy->QueryProp(P_WIMPY)) enemy->SetProp(P_WIMPY, enemy->QueryProp(P_WIMPY)+10);
      break;
    case 3: // Ciaran
      msg = BS("Mit lautem Hufgetrappel donnert ein eisiger Elch an dir vorbei. "+enemy->Name(WER)+" friert ein.");
      enemy->ModifySkillAttribute(caster, SA_SPEED, 50, 5+random(10));
      break;
    case 4: // Fiachra
      msg = BS("Eine giftige Schlange windet sich um "+enemy->Name(WEN)+" und beisst zu!");
      p=clone_object(OBJ "npc_poison"); p->move(enemy, M_TPORT|M_SILENT);
      p->poison(enemy, caster, 0, random(200));
      break;
    case 5: // Belenus
      msg = BS("Schemenhafte Drachenfluegel ziehen ueber euch. Magische Energie und hinterhaeltige Tricks weichen aus "+enemy->Name(WEM)+".");
      enemy->SetProp(P_DISABLE_SPELLS, 2+random(4));
      break;
    case 6: // Thorondor
      msg = BS("Der ohrenbetaeubende Schrei eines Donnervogels erklingt. "+enemy->Name(WER)+" zucket zitternd zusammen.");
      if(!random(3)) enemy->SetProp(P_PARALYZED, 1+random(5));
      break;
    case 7: // Bran
      msg = BS("Ein Sturmfalke kreist ueber euch und ein heftiger Windstoss wirft "+enemy->Name(WEN)+" zu Boden.");
      enemy->SetProp(P_DISABLE_ATTACK, 2);
      enemy->SetProp(P_LAST_RAMMEN_TIME, time());
      break;
    case 8: // Lir
      msg = BS("Ein weisser Hirsch springt durch den Raum. Wo seine Hufe den Boden beruehren wachsen Blumen.");
      caster->AddHp(25 + random(40));
      break;
    case 9: // Aedan
      msg = BS("Ein feuriger Luchs saust an dir vorbei. Feine Rauchkringel steigen von "+enemy->Name(WEM)+" auf.");
      enemy->Defend(150+random(150), DT_FIRE, ([SP_SHOW_DAMAGE: 1, SP_NAME: "Wildheit der Avatara"]), caster);
      break;
    case 10: // Brenin
      msg = BS("Eine schleimige Kröte springt "+enemy->Name(WEN)+" an und quakt laut. "+enemy->Name(WESSEN)+" Ruestung scheint geschwaecht.");
      if(!interactive(enemy)) enemy->SetProp(P_BODY, enemy->QueryProp(P_BODY)/4*3);
      break;
  }

  tell_room(environment(caster), msg);
  return;
}