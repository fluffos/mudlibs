//--Variablen-----------------------------------------------------------------
nosave int total_fail;
//--Vorfunktionen-------------------------------------------------------------
mixed ranger_parsing(string str);
mixed parse_target(string str);
string checkgender(object pl, string female, string male);
string to_german(string str);
string weapon_to_german(string str);
varargs int ExecuteAttackSpell(object ob, object caster, mapping sinfo,mixed is_spell, int weaponMode, object weapon);
string CheckSpell(object caster, mapping sinfo);
void FirstPrepareFuncSuccessfull(object caster, mapping sinfo);
public void reload(object caster, mapping sinfo);
public void aim(object caster, mapping sinfo);

