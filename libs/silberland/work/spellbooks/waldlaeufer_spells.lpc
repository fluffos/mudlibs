//** StandardFUnktionen ****************************************************//
//-- Create ------------------------------------------------------------------
create() 
{
  ::create();
  SetProp(P_SB_CASTVERB, "beschwoere");
  SetProp(P_SB_PARSE_FUNC, "ranger_parsing");
  SetProp(P_SB_NO_CASTVERB_NEEDED_MSG,
            "Du brauchst nicht das Wort '"+QueryProp(P_SB_CASTVERB)+"'.");
  SetProp(P_GLOBAL_SKILLPROPS,
          ([SI_SKILLLEARN:5,
            OFFSET(SI_SKILLLEARN):10,
            SI_SKILLLEARN_ATTRIBUTE: A_DEX,
            SI_SPELLFATIGUE:2,
            SI_SP_LOW_MSG:BS("Du hast nicht genug Konzentration fuer eine "
                             "erfolgreiche Beschwoerung."),
            SI_ENABLE_CASTVERB: 1,
            SI_SPELLNAME: "",
            SI_PATH: 0,
            ]));
  
  //--Grundspells----------------------------------------------------
  AddSpell(RINDENHAUT,25,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:1]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:1]),
             SI_SPELLFATIGUE: 2,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS("Du bleibts stehen und stellst Dir einen "
                                "Baum vor."),
             SI_PREPAREFUNC: "prep_rindenhaut",
             SI_SKILLDAMAGE_TYPE: ({ DT_PIERCE }),
             SI_SKILLDAMAGE: 400,
             SI_MAX_DAMAGE: 1500,
             SI_NOMAGIC:100,
             SI_SPELLFUNC: "rindenhaut",
             ]));  
  
  AddSpell(DURCHDRINGE,10,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:1]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:1, A_INT:7]),
             SI_SPELLFUNC: "durchdringe",
             ]) );
  AddSpell(SCHAETZ,10,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:2]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:2, A_INT:7]),
             SI_SPELLFUNC: "schaetz",
             ]) );
  AddSpell(DEUTSCHUSS,15,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:3]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:3]),
             SI_SPELLFATIGUE: 4,
             SI_PREPARE_TIME: 0,
             SI_PREPARE_MSG: BS("Du legst zu einem Schnellschuss an."),
             SI_PREPAREFUNC: "prep_deutschuss",
             SI_SKILLDAMAGE_TYPE: ({ DT_PIERCE }),
             SI_SKILLDAMAGE:130, 
             OFFSET(SI_SKILLDAMAGE):70,
             SI_MAX_DAMAGE: 1000,
             SI_NOMAGIC:100,
             SI_SPELLFUNC: "deutschuss",
             ]));
  AddSpell(MESSERSTICH,10,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:3]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:3]),
             SI_SPELLFATIGUE: 1,
             SI_PREPARE_TIME: 0,
             SI_PREPARE_MSG: BS("Du machst Dich zum Sprung bereit..."),
             SI_PREPAREFUNC: "prep_messerstich",
             SI_SKILLDAMAGE_TYPE: ({ DT_PIERCE }),
             SI_SKILLDAMAGE:50, 
             OFFSET(SI_SKILLDAMAGE):50,
             SI_MAX_DAMAGE: 500,
             SI_NOMAGIC:100,
             SI_SPELLFUNC: "messerstich",
             ]));
  AddSpell(AUGEN_DES_JAEGERS,10,           
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:4]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:4]),
             SI_PREPARE_TIME: 3,
             SI_PREPARE_MSG: BS("Du schliesst die Augen."),
             SI_SPELLFUNC: "augen_des_jaegers",
             ]) );
  AddSpell(GESCHWINDIGKEIT,15,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:5]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:5]),
             SI_SPELLFUNC: "geschwindigkeit",
             ]) );
  AddSpell(PAKT_DER_SCHATTEN,0,           
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:6]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:6]),
             SI_SPELLFUNC: "pakt_der_schatten",
             ]) );
  AddSpell(ZAEHMUNG,80,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:7]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:7]),
             SI_SPELLFATIGUE: 4,
             SI_PREPARE_TIME: 20,
             SI_PREPARE_MSG: BS("Du beginnst Dich zu entspannen."),
             SI_PREPAREFUNC: "prep_zaehmung",             
             SI_SPELLFUNC: "zaehmung",
             ])); 
  AddSpell(MARKIERUNGSSCHUSS,25,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:8]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:8]),
             SI_SPELLFATIGUE: 4,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS("Du ziehst einen Farbbeutel hervor und zielst"
                                " auf dein Opfer."),
             SI_PREPAREFUNC: "prep_markierungsschuss",
             SI_SPELLFUNC: "markierungsschuss",
             ]));
  AddSpell(FUSSTRITT,15,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:9]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:9]),
             SI_SPELLFATIGUE: 2,
             SI_PREPARE_TIME: 0,
             SI_PREPARE_MSG: BS("Du setzt zu einem Fusstritt an."),
             SI_PREPAREFUNC: "prep_fusstritt",
             SI_SKILLDAMAGE:100,
             SI_SKILLDAMAGE_TYPE: ({ DT_BLUDGEON }),
             OFFSET(SI_SKILLDAMAGE):50,
             SI_MAX_DAMAGE: 1000,
             SI_SPELLFUNC: "fusstritt",
             SI_NOMAGIC:100,
             ]));
  AddSpell(TIERHEILUNG,30,
          ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:9]),
            SI_SKILLRESTR_USE:([P_GUILD_LEVEL:9]),
            SI_SPELLFATIGUE: 4,
            SI_PREPARE_TIME: 0,
            SI_PREPARE_MSG: BS("Du legst dem Tier die Hand auf den Kopf und murmelst leise Worte."),
            SI_PREPAREFUNC: "prep_tierheilung",
            SI_SPELLFUNC: "tierheilung",
            ]));
  AddSpell(KRAEUTERMIXTUR,45,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:10]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:10]),
             SI_SPELLFATIGUE: 4,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS("Du kramst das richtige Kraut hervor und "
                                "bereitest eine Mixtur vor."),
             SI_PREPAREFUNC: "prep_kraeutermixtur",
             SI_SPELLFUNC: "kraeutermixtur",
             ]));
  AddSpell(ASPEKT_DES_PANTHERS, 30,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL: 16]),
            SI_SKILLRESTR_USE: ([P_GUILD_LEVEL: 16]),
            SI_SPELLFATIGUE: 6,
            SI_PREPARE_TIME: 6,
            SI_PREPARE_MSG: BS("Du konzentrierst dich auf das Wesen des Panthers."),
            SI_PREPAREFUNC: "prep_aspekt_des_panthers",
            SI_SPELLFUNC: "aspekt_des_panthers"
  ]));
             
  //--Fallen---------------------------------------------------------
  AddSpell(FESSELFALLE,30,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:5]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:5]),
             SI_SPELLFATIGUE: 2,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS("Du schaust, wo Du eine Falle bauen kannst."),
             SI_PREPAREFUNC: "prep_fesselfalle",
             SI_SPELLFUNC: "fesselfalle",
             ])); 
  AddSpell(FANGFALLE,35,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:10]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:10]),
             SI_SPELLFATIGUE: 2,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS("Du schaust, wo Du eine Falle bauen kannst."),
             SI_PREPAREFUNC: "prep_fangfalle",
             SI_SPELLFUNC: "fangfalle",
             ])); 
  AddSpell(STOLPERDRAHT,45,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:15]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:15]),
             SI_SPELLFATIGUE: 2,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS("Du schaust, wo Du eine Falle bauen kannst."),
             SI_PREPAREFUNC: "prep_stolperdraht",
             SI_SPELLFUNC: "stolperdraht",
             ])); 
  AddSpell(PFEILFALLE,70,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:18]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:18]),
             SI_SPELLFATIGUE: 2,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS("Du schaust, wo Du eine Falle bauen kannst."),
             SI_PREPAREFUNC: "prep_pfeilfalle",
             SI_SPELLFUNC: "pfeilfalle",
             ]));  

  //--Pfad der Tiere-------------------------------------------------
  AddSpell(TIERE_DES_WALDES,35,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:11]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:11]),
             SI_SPELLFATIGUE: 6,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: BS("Du konzentrierst Dich und schliesst die "
                                "Augen."),
             SI_PREPAREFUNC: "prep_tiere",
             SI_SPELLFUNC: "tiere",
             ]));
  AddSpell(WALDWOLF,80,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:12]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:12]),
             SI_SPELLFATIGUE: 6,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: BS("Du konzentrierst Dich und schliesst die "
                                "Augen."),
             SI_PREPAREFUNC: "prep_waldwolf",
             SI_SPELLFUNC: "waldwolf",
             ]));
  AddSpell(ADLER,80,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:13]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:13]),
             SI_SPELLFATIGUE: 6,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: BS("Du konzentrierst Dich und schliesst die "
                                "Augen."),
             SI_PREPAREFUNC: "prep_adler",
             SI_SPELLFUNC: "adler",
             ]));
  AddSpell(SCHWARZBAER,80,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:14]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:14]),
             SI_SPELLFATIGUE: 6,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: BS("Du konzentrierst Dich und schliesst die "
                                "Augen."),
             SI_PREPAREFUNC: "prep_schwarzbaer",
             SI_SPELLFUNC: "schwarzbaer",
             ]));
  AddSpell(SPINNE,80,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:15]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:15]),
             SI_SPELLFATIGUE: 6,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: BS("Du konzentrierst Dich und schliesst die "
                                "Augen."),
             SI_PREPAREFUNC: "prep_spinne",
             SI_SPELLFUNC: "spinne",
             ]));
  AddSpell(WILDER_SCHWARM,80,
          ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:17]),
          SI_SKILLRESTR_USE:([P_GUILD_LEVEL:17]),
          SI_SPELLFATIGUE: 6,
          SI_PREPARE_TIME: 2,
          SI_PREPARE_MSG: BS("Du konzentrierst Dich und schliesst die "
                            "Augen."),
          SI_PREPAREFUNC: "prep_wilder_schwarm",
          SI_SPELLFUNC: "wilder_schwarm",
          ]));
  AddSpell(WALDGEIST,80,
    ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:19]),
    SI_SKILLRESTR_USE:([P_GUILD_LEVEL:19]),
    SI_SPELLFATIGUE: 6,
    SI_PREPARE_TIME: 2,
    SI_PREPARE_MSG: BS("Du beruehrst einen Baum und beginnst die Worte der Beschwoerung zu fluestern."),
    SI_PREPAREFUNC: "prep_waldgeist",
    SI_SPELLFUNC: "waldgeist",
    ]));
            
  //--Pfad der Iama--------------------------------------------------
  AddSpell(MELODIE_DER_RUHE,75,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:11]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:11]),
             SI_SPELLFATIGUE: 10,
             SI_PREPARE_TIME: 6,
             SI_PREPARE_MSG: BS("Du nimmst Deine Iama in die Hand und "
                             "spielst die 'Melodie der Ruhe'."),
             SI_PREPAREFUNC: "prep_melodie_der_ruhe",
             SI_SPELLFUNC: "melodie_der_ruhe",
             ]));
  AddSpell(ODE_DES_STURMES,65,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:12]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:12]),
             SI_SPELLFATIGUE: 5,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS("Du nimmst Deine Iama in die Hand und "
                             "beginnst mit 'Ode des Sturmes'."),
             SI_PREPAREFUNC: "prep_ode_des_sturmes",
             SI_SPELLFUNC: "ode_des_sturmes",
             ]));
  AddSpell(MELODIE_DER_AVATARA,55,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:13]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:13]),
             SI_SPELLFATIGUE: 4,
             SI_PREPARE_TIME: 8,
             SI_PREPARE_MSG: BS("Du nimmst Deine Iama in die Hand und "
                             "spielst eine komplexe, auf- und abschwellende Melodie zu ehren der Avatara, "
                             "der Tierkoenige."),
             SI_PREPAREFUNC: "prep_melodie_der_avatara",
             SI_SPELLFUNC: "melodie_der_avatara",
