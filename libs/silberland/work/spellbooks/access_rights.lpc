#define TA(x) if (find_player("angrox")) tell_object(find_player("angrox"),x)

int access_rights(string name, string file, int readflag, int def)
{
  string s1;
  string *str;

#if 0
  if (find_player("angrox"))
    tell_object(find_player("angrox"),
        sprintf(" * spellbooks::access_rights: %O - %O - %O - %O\n",
          name,file,readflag,def));
#endif

  name = lower_case( name );
  str = efun::explode( file, "/" );

  // Leserechte-Handling
  // -----------------------------------------------------------------------
  if (readflag)
  {
    // Directory Listings fuer...
    if ( file == "*" )
      return member( (["protheg","andyl", "hotaru", "archon","gwenshara","angrox", "wraz", "yondala"]), 
          name );

    // Rage hat als Balancemitglied Vollzugriff
    if ( name == "rage" || name == "wraz" )
      return 1;

    if ( name == "angrox" )
      return 1;
    // Gwenshara lt. Erzmagierkonferenz am 29.August 2006 
    if ( name == "gwenshara")
      return 1;

    if ( str[0][0..10] == "waldlaeufer")
      return member( ([ "delgo", "lilyth", "torian", "gobblin" ]), name );

    if ( str[0][0..5] == "barden" || str[0][0..7] == "druiden")
      return (name == "wraz");

    if ( str[0][0..6] == "piraten")
      return (name == "yondala");

    if ( str[0][0..8] == "amazonen")
      return member( ([ "aaliyah" ]), name );

    // Gwenshara Todesritter
    if ( name == "gwenshara" && ( str[0][0..8] == "dk_spells"))
      return 1;

    if ( name == "wraz" && (str[0][0..12] == "barden_spells" || str[0][0..13] == "druiden_spells")) {
      return 1;
    }
                                                 
    if ( name == "yondala" && (str[0][0..13] == "piraten_spells")) {
      return 1;
    }

    return 0;
  }

  // Schreibrechte-Handling
  // -----------------------------------------------------------------------
  if (!file || (file=="access_rights.lpc"))
    return 0;

  // Voller Schreibzugriff:
  if ( (name == "iwo") || (name == "gwenshara") || (name=="angrox")  || name == "wraz")
    return 1;

  if ( str[0][0..10] == "waldlaeufer")
    return member( ([ "delgo", "lilyth", "torian" ]), name );

  if ( str[0][0..5] == "barden" && name == "wraz") return 1;
  if( str[0][0..7] == "druiden" && name == "wraz") return 1;
  if ( str[0][0..6] == "piraten" && name == "yondala") return 1;

  switch(explode(str[0],".")[0])
  {
    case "alch_spells":
      return name=="stahldorn";
    case "barden_spells":
      return name == "wraz";
    case "piraten_spells":
      return name == "yondala";
      return name=="protheg";
    case "druiden_spells":
      return name=="wraz";
  }
  return 0;
}
