string zerstoerung_kosten()
{
  int kosten;
  if( !kosten=TP->QueryProp(P_NEWSKILLS)["zerstoerung"][SI_SPELLCOST] )
    kosten = 4;
   return "Du benoetigst "+kosten+" Magiepunkte fuer das Zerstoeren "
          "von Gegenstaenden.\n";
}

