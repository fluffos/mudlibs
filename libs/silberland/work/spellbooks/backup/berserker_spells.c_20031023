#define ANZAHL_RIESENKRAFT 10

#ifndef SI_MAX_DAMAGE
#define SI_MAX_DAMAGE "si_max_damage"
#endif


#define MAX_EQUIP_BONUS 30
#define TOTAL_EQUIP_BONUS 100

inherit "/std/spellbook";

int macht_der_stimme(object caster)
{
  if( BMASTER->GetMight(caster) & M_VOICE )
    return 1;
  else
    return 0;
}

int macht_des_herzens(object caster)
{
  if( BMASTER->GetMight(caster) & M_HEART)
    return 1;
  else
    return 0;
}

int macht_der_faust(object caster)
{
  if( BMASTER->GetMight(caster) & M_FIST )
    return 1;
  else
    return 0;
}

string zerstoerung_time()
{
  return BS("Du musst "+(TP->QueryProp(P_NEXT_SPELL_TIME)-time())+
    " Sekunden warten, bis Du etwas zerstoeren kannst!\n");
}

string waffenkunde_time()
{
  return BS("Du musst "+(TP->QueryProp(P_NEXT_SPELL_TIME)-time())+
    " Sekunden warten, bis Du eine Waffe erkunden kannst!\n");
}

