void create()
{
  ::create();
  SetProp(P_KILL_NAME, "Die Macht der Berserker" );
  SetProp(P_GLOBAL_SKILLPROPS,
          ([SI_SPELLFATIGUE: 2,              // 2 Sekunden kein neuer Spell
            SI_SKILLLEARN: 2,                // 0.04% pro 2 A_STR 
            OFFSET(SI_SKILLLEARN): 4,        // plus 0.04% in jedem Fall
            SI_SKILLRESTR_USE: ([SR_FUN:"StirnbandTest"]),
            SI_SKILLLEARN_ATTRIBUTE: A_STR,
            SI_SP_LOW_MSG:"Deine Konzentration ist fuer diese Faehigkeit zu "
                          "gering.\n",
            SI_TIME_MSG: "Du bist noch zu erschoepft von Deiner letzten "
                         "Aktion.\n",
            SI_NOMAGIC_MSG:"Eine seltsame Kraft verhindert, dass Du hier "
                           "Deine Faehigkeiten anwendest.\n",
            ]));
  AddSpell("zerstoerung",4,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:1]),
             SI_SPELLFATIGUE: 2,
             SI_SKILLLEARN: 4,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_PREPARE_TIME: 4,     
             SI_PREPARE_MSG: "",
             SI_PREPAREFUNC: "prep_zerstoerung",
             SI_TIME_MSG: "@@zerstoerung_time@@",
             SI_SP_LOW_MSG: "@@zerstoerung_kosten@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"StirnbandTest", P_GUILD_LEVEL:1]),
			 ]));
  AddSpell("waffenkunde",11,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:1]),
             SI_SPELLFATIGUE: 2,
             SI_SKILLLEARN: 4,
             OFFSET(SI_SKILLLEARN): 6, 
             SI_SKILLLEARN_ATTRIBUTE: A_DEX, 
             SI_PREPARE_TIME: 1,
             SI_PREPARE_MSG: "Du rufst Dir alles in Erinnerung, was Kronang "
                             "Dir ueber Waffen beigebracht hat.\n",
             SI_PREPAREFUNC: "prep_waffenkunde",
             SI_TIME_MSG: "@@waffenkunde_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"BlindTest", P_GUILD_LEVEL:1]),
             SI_SP_LOW_MSG: "@@waffenkunde_kosten@@",
             ]));
  AddSpell("schaetz",5,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:2]),
             SI_SPELLFATIGUE: 2,
             SI_SKILLLEARN: 5,
             OFFSET(SI_SKILLLEARN): 8, 
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_PREPARE_TIME: 1,     
             SI_PREPARE_MSG: "Du schaetzt Kampfstaerke, Groesse, Aussehen "
                             "und Ausruestung.\n",
             SI_PREPAREFUNC: "prep_schaetz",
             SI_TIME_MSG: "@@schaetz_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"BlindTest", P_GUILD_LEVEL:2]),
             SI_SP_LOW_MSG: "@@schaetz_kosten@@"
             ]));
  AddSpell("zertreten",8,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:2]),
             SI_TIME_MSG: "@@zertreten_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"BlindTest", P_GUILD_LEVEL:2]),
             SI_SKILLDAMAGE_TYPE: DT_SQUEEZE,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_NOMAGIC:100,
             SI_MAX_DAMAGE:400,
             SI_SP_LOW_MSG: "@@zertreten_kosten@@",
             SI_DIE_MSG: " wird zu Tode zerquetscht.\n",
             SI_SPELL:([
               SP_NAME: "zertreten",
               SP_PHYSICAL_ATTACK:1,
               SP_SHOW_DAMAGE:({
               ({ -1, "@WER2 tritt neben Dir auf den Boden.",
                      "Du trittst neben @WEM1 auf den Boden.",
                      "@WER2 tritt neben @WEM1 auf den Boden."}),
               ({  0, "@WER2 stiefelt Dich leicht.",
                      "Du stiefelst @WEN1 leicht.",
                      "@WER2 stiefelt @WEN1 leicht." }),
               ({  5, "@WER2 stiefelt Dich hart.",
                      "Du stiefelst @WEN1 hart.",
                      "@WER2 stiefelt @WEN1 hart." }),
               ({ 10, "@WER2 stiefelt Dich sehr hart.",
                      "Du stiefelst @WEN1 sehr hart.",
                      "@WER2 stiefelt @WEN1 sehr hart." }),
               ({ 15, "@WER2 stiefelt Dich extrem hart.",
                      "Du stiefelst @WEN1 extrem hart.",
                      "@WER2 stiefelt @WEN1 extrem hart." }),
               ({ 20, "@WER2 zerdrueckt Dich.",
                      "Du zerdrueckst @WEN1.",
                      "@WER2 zerdrueckt @WEN1." }),
               ({ 30, "@WER2 drueckt Dich tief in den Boden hinein.",
                      "Du drueckst @WEN1 tief in den Boden hinein.",
                      "@WER2 drueckt @WEN1 tief in den Boden hinein." }),
               ({ 40, "@WER2 zermantscht Dich zu Brei.",
                      "Du zermantscht @WEN1 zu Brei.",
                      "@WER2 zermantscht @WEN1 zu Brei." }),
               ({ 60, "@WER2 zermantscht Dich zu Klump.",
                      "Du zermanscht @WEN1 zu Klump.",
                      "@WER2 zermanscht @WEN1 zu Klump." }),
               ({100, "@WER2 zerquetscht Dich zu feinem Staub.",
                      "Du zerquetscht @WEN1 zu feinem Staub.",
                      "@WER2 zerquetscht @WEN1 zu feinem Staub." }),
               ({150, "@WER2 rammt Dich ungespitzt in den Boden.",
                      "Du rammst @WEN1 ungespitzt in den Boden.",
                      "@WER2 rammt @WEN1 ungespitzt in den Boden." }),
               }), ]),
             ]));
  AddSpell("wueten", 7,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:3]),
             SI_SPELLFATIGUE: 6,
             SI_SKILLLEARN: 3,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_PREPARE_TIME: 2,     
             SI_PREPARE_MSG: "Du sammelst genug Wut in Deinem Inneren "
                             "zusammen.\n",
             SI_PREPAREFUNC: "prep_wueten",
             SI_TIME_MSG: "@@wueten_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"FroschTest", P_GUILD_LEVEL:3]),
             SI_SP_LOW_MSG: "@@wueten_kosten@@",
             ]));
  AddSpell("augeinauge",11,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:3]),
             SI_SPELLFATIGUE: 2,
             SI_SKILLLEARN: 3,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_PREPARE_TIME: 1,     
             SI_PREPARE_MSG: "Du bekommst einen starren Blick.\n",
             SI_PREPAREFUNC: "prep_augeinauge",
             SI_TIME_MSG: "@@augeinauge_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"BlindTest", P_GUILD_LEVEL:3]),
             SI_SP_LOW_MSG: "@@augeinauge_kosten@@",
             ]));
  AddSpell("rammen",6,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:4]),
             SI_SPELLFATIGUE: 2,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_PREPARE_TIME: 1,
             SI_PREPARE_MSG: "Du bereitest Dich auf das Rammen vor.\n",
             SI_PREPAREFUNC: "prep_rammen",
             SI_TIME_MSG: "@@rammen_time@@",
             SI_SKILLDAMAGE: 50,
             OFFSET(SI_SKILLDAMAGE): 50,
             SI_MAX_DAMAGE:220,
             SI_NOMAGIC:100,
             SI_SKILLRESTR_USE: ([SR_FUN:"FroschTest", A_DEX:15, 
                                  P_GUILD_LEVEL:4 ]),
             SI_SKILLDAMAGE_TYPE: DT_BLUDGEON,
             SI_SP_LOW_MSG: "@@rammen_kosten@@",
             ]));

  AddSpell("regeneration",30,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:4]),
             SI_SPELLFATIGUE: 20,   
             SI_SKILLLEARN: 4,
             SI_SKILLLEARN_ATTRIBUTE: A_CON,
             SI_PREPARE_TIME: 10,
             SI_PREPARE_MSG: "Du entspannst Deinen Koerper.\n",
             SI_PREPAREFUNC: "prep_regeneration",
             SI_TIME_MSG: "@@regeneration_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"StirnbandTest", P_GUILD_LEVEL:4]),
             SI_DIFFICULTY: 15,
             SI_SP_LOW_MSG: "@@regeneration_kosten@@",
             ]));
  AddSpell("kampfschrei",10,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:5]),
             SI_TIME_MSG: "@@kampfschrei_time@@",
             SI_SKILLDAMAGE: 50,
             OFFSET(SI_SKILLDAMAGE): 50,
             SI_MAX_DAMAGE:150,
             SI_SKILLRESTR_USE: ([SR_FUN:"FroschTest", A_CON:15, P_GUILD_LEVEL:5]),
             SI_SKILLDAMAGE_TYPE: ({DT_TERROR, DT_SOUND}),
             SI_SKILLLEARN_ATTRIBUTE: A_CON,
             SI_SP_LOW_MSG: "@@kampfschrei_kosten@@",
             ]));
  AddSpell("willenskraft",20,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:5]),
             SI_SPELLFATIGUE: 4,
             SI_SKILLLEARN: 5,
             SI_SKILLLEARN_ATTRIBUTE: A_CON,
             SI_PREPARE_TIME: 1,     
             SI_PREPARE_MSG: "Du versuchst, Deinen Willen zu staerken.\n",
             SI_PREPAREFUNC: "prep_willenskraft",
             SI_TIME_MSG: "@@willenskraft_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"FroschTest", P_GUILD_LEVEL:5]),
             SI_SP_LOW_MSG: "@@willenskraft_kosten@@",
             ]));
  AddSpell("kopfstoss",15,
            ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:6]),
             SI_TIME_MSG: "@@kopfstoss_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"FroschTest", A_DEX:17,
                                 P_GUILD_LEVEL:6]),
             SI_SKILLDAMAGE_TYPE: DT_BLUDGEON,
             SI_SKILLLEARN_ATTRIBUTE: A_DEX,
             SI_NOMAGIC:100,
             SI_MAX_DAMAGE:400,
             SI_SP_LOW_MSG: "@@kopfstoss_kosten@@",
             SI_SPELL:([
               SP_NAME: "kopfstoss",
               SP_PHYSICAL_ATTACK:1,
               SP_SHOW_DAMAGE:({
               ({ -1, "@WESSEN2 Kopf trifft nur Luft.",
                      "Dein Kopf trifft nur Luft.",
                      "@WESSEN2 Kopf trifft nur Luft."}),
               ({  0, "@WER2 streift Dich.",
                      "Du streifst @WEN1.",
                      "@WER2 streift @WEN1." }),
               ({  5, "@WER2 verletzt Dich.",
                      "Du verletzt @WEN1.",
                      "@WER2 verletzt @WEN1." }),
               ({ 10, "@WER2 verletzt Dich schwer.",
                      "Du verletzt @WEN1 schwer.",
                      "@WER2 verletzt @WEN1 schwer." }),
               ({ 15, "@WER2 verletzt Dich sehr schwer.",
                      "Du verletzt @WEN1 sehr schwer.",
                      "@WER2 verletzt @WEN1 sehr schwer." }),
               ({ 20, "@WER2 bricht Dir die Nase.",
                      "Du brichst @WEM1 die Nase.",
                      "@WER2 bricht @WEM1 die Nase." }),
               ({ 30, "@WER2 zerschmettert Dein Gesicht.",
                      "Du zerschmetterst @WESSEN1 Gesicht.",
                      "@WER2 zerschmettert @WESSEN1 Gesicht." }),
               ({ 40, "@WER2 schlaegt Dein Gesicht zu Brei.",
                      "Du schlaegst @WESSEN1 Gesicht zu Brei.",
                      "@WER2 schlaegt @WESSEN1 Gesicht zu Brei." }),
               ({ 50, "@WER2 schlaegt Dein Gesicht zu Klump.",
                      "Du schlaegst @WESSEN1 Gesicht zu Klump.",
                      "@WER2 schlaegt @WESSEN1 Gesicht zu Klump." }),
               ({ 75, "@WER2 zertruemmert Dein Gesicht zu feinem Staub.",
                      "Du zertruemmerst @WESSEN1 Gesicht zu feinem Staub.",
                      "@WER2 zertruemmert @WESSEN1 Gesicht zu feinem Staub." }),
               ({ 100,"@WER2 zerstoert Dein Gesicht.",
                      "Du zerstoerst @WESSEN1 Gesicht.",
                      "@WER2 zerstoert @WESSEN1 Gesicht." }),
               ({ 150,"@WER2 vernichtet Dein Gesicht.",
                      "Du vernichtest @WESSEN1 Gesicht.",
                      "@WER2 vernichtet @WESSEN1 Gesicht." }),
               }), ]),
             ]));
  AddSpell("eisenhaut",25,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:6]),
             SI_SPELLFATIGUE: 4,
             SI_SKILLLEARN: 3,
             SI_SKILLLEARN_ATTRIBUTE: A_CON,
             SI_PREPARE_TIME: 3,     
             SI_PREPARE_MSG: "Deine Haut beginnt sich zu veraendern.\n",
             SI_PREPAREFUNC: "prep_eisenhaut",
             SI_TIME_MSG: "@@eisenhaut_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"StirnbandTest", A_CON: 19,
                           P_GUILD_LEVEL:6]), 
             SI_DIFFICULTY: 80,
             SI_SP_LOW_MSG: "@@eisenhaut_kosten@@",
             ]));
  AddSpell("spalten",55,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:7]),
             SI_SPELLFATIGUE: 8,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_PREPARE_TIME: 2,     
             SI_PREPARE_MSG: "Du nimmst Deine Axt fest in die Hand und "
                             "spannst Deine Muskeln an.\n",
             SI_PREPAREFUNC: "prep_spalten",
             SI_TIME_MSG: "@@spalten_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"BlindTest", A_DEX:22, A_STR:23,
                                 P_GUILD_LEVEL:7]),
             SI_DIFFICULTY: 250,
             SI_SKILLDAMAGE_TYPE: DT_SLASH,
             SI_NOMAGIC:100,
             SI_MAX_DAMAGE:1800,
             SI_SP_LOW_MSG: "@@spalten_kosten@@",
             SI_DIE_MSG: " wird in zwei Teile gespalten und stirbt.\n",
             ]));
  AddSpell("blutrausch",130,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:8]),
             SI_SPELLFATIGUE: 22,
             SI_SKILLLEARN: 5,
             OFFSET(SI_SKILLLEARN): 10,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_PREPARE_TIME: 4,    
             SI_PREPARE_MSG: "Du schnaubst aergerlich und scharrst wuetend "
                             "mit Deinen Fuessen.\n",
             SI_PREPAREFUNC: "prep_blutrausch",
             SI_TIME_MSG: "@@blutrausch_time@@",
             SI_DIFFICULTY: 400,
             SI_SKILLRESTR_USE: ([SR_FUN:"FroschTest", A_CON:23, A_STR:25, 
                                  P_GUILD_LEVEL:8]),
             SI_SP_LOW_MSG: "@@blutrausch_kosten@@",
             ]));
  AddSpell("schlachtruf",20,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:9]),
             SI_SPELLFATIGUE: 2,
             SI_SKILLLEARN: 5,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_MAX_DAMAGE:600,
             SI_PREPARE_TIME: 4,     
             SI_PREPARE_MSG: "Du fuellst Deine Lungen mit Luft.\n",
             SI_PREPAREFUNC: "prep_schlachtruf",
             SI_TIME_MSG: "@@schlachtruf_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"StirnbandTest", A_CON:24, 
                                 P_GUILD_LEVEL:9]),
             SI_DIFFICULTY: 500,
             SI_SP_LOW_MSG: "@@schlachtruf_kosten@@",
             SI_DIE_MSG: " faellt vor Schreck tot um.\n",
             ]));
  AddSpell("riesenkraft",40,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:10]),
             SI_SPELLFATIGUE: 10,
             SI_SKILLLEARN: 6,
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_PREPARE_TIME: 4,     
             SI_PREPARE_MSG: "Du spannst Deine Muskeln an.\n",
             SI_PREPAREFUNC: "prep_riesenkraft",
             SI_TIME_MSG: "@@riesenkraft_time@@",
             SI_SKILLRESTR_USE: ([SR_FUN:"StirnbandTest", A_CON:26, A_STR:26,
                                  P_GUILD_LEVEL:10]),
             SI_DIFFICULTY: 500,
             SI_SP_LOW_MSG: "Du benoetigst 40 Magiepunkte fuer Riesenkraft.\n",
             ]));

}

int SpellSuccess(object caster, mapping sinfo) 
{
  int suc;
  suc=::SpellSuccess(caster, sinfo);
  if(!random(4321) && caster->QueryProp(P_GUILD_LEVEL) != 12) 
    return -10000+suc;
  return suc;
}

string StirnbandTest(object caster, mapping sinfo)
{
  object stirnband;
  int guildlevel;
  if( present("\nberserker_panik", caster) )
    return "In Deiner Panik kannst Du nichts machen!\n";
  if( (guildlevel=caster->QueryProp(P_GUILD_LEVEL)) > 10) 
    guildlevel=10;
  if( caster->QueryProp(P_WIMPY) > 100-guildlevel*10 && !random(3) )
    return "Kronang teilt Dir mit: Warum so vorsichtig, Du Feigling!\n"
           "Kronang teilt Dir mit: Komm mit der Vorsicht zu mir, und ich "
           "werde Dich spalten!\n";
  if( (stirnband = present("\nberserker_stirnband", caster)) &&
         stirnband->QueryProp(P_WORN) == caster )
  {
    if(interactive(caster) && stirnband->QueryVersion()!=LATEST_STIRNBAND_VERSION) 
    {
//      return BS("Dein Stirnband entspricht nicht mehr der neuesten Mode! "
//          "Teile Kronang mit, dass Du ein neues Stirnband haben moechtest."); 
      stirnband->remove(1);
      clone_object("/gilden/berserker/obj/stirnband")->move(caster, M_NOCHECK);
    }
    return 0;
  }
  else
   return "Wo ist denn Dein blutrotes Stirnband?\n";
}

string FroschTest(object caster, mapping sinfo)
{
  if (caster->QueryProp(P_FROG))
    return "Als Frosch kannst Du das nicht!\n";
  return StirnbandTest(caster, sinfo);
}

string BlindTest(object caster, mapping sinfo)
{
  if (caster->QueryProp(P_BLIND))
    return "Da Du blind bist, kannst Du das nicht machen!\n";
  return StirnbandTest(caster, sinfo);
}

static int total_fail;

void Misserfolg(object caster, string spell, mapping sinfo)
{
  int old_abil;
  object victim;

  if (!total_fail)
  {
    switch(spell)
    {
      case "waffenkunde":
        write("Du kannst nichts besonderes erkennen.\n");
        break;
      case "schaetz":
        write("Du verschaetzt Dich total.\n");
        break;
      case "rammen":
        write("Aus dem Rammen wird nur ein kleiner Schubser.\n");
        break;
      case "wueten":
        write("Dein Wueten laesst alle unbeeindruckt.\n");
        break;
      case "kampfschrei":
      case "schlachtruf":
        write("Nur ein heiseres Kraechzen kommt aus Deiner Kehle.\n");
        break;
      case "augeinauge":
        write("Du kannst Deinem Gegner nicht in die Augen blicken.\n");
        break;
      case "zertreten":
        write("Du stampfst wild herum, triffst aber niemanden.\n");
        break;
      case "willenskraft":
        write("Deine Willenskraft ist zu schwach.\n");
        break;
      case "kopfstoss":
        write("Dein Kopfstoss ging meilenweit daneben.\n");
        break;
      case "eisenhaut":
        write("Deine Haut veraendert sich ueberhaupt nicht.\n");
        break;
      case "spalten":
        write("Deine Axt saust vorzeitig durch die Luft und trifft "
              "niemanden.\n");
        break;
      case "blutrausch":
        write("Du kannst einfach Dein Blut nicht zum Rauschen bringen.\n");
        break; 
      case "regeneration":
        write("Du kannst Deine Heilkraefte nicht zur Geltung bringen.\n");
        break;
      case "riesenkraft":
        write("Statt Riesenkraft schaffst Du nur "+caster->QueryProp(P_RACE)+
            "kraft.\n");
        break;
      default:
        write("Der Zauberspruch ist missglueckt.\n");
    }
  }
  total_fail = 0;  // gleich zuruecksetzen
  old_abil = sinfo[SI_SKILLABILITY];
  // Abfrage auf SID_NOLEARN (Angrox, 20.1.2003)
  if(sinfo[SI_SKILLARG] && (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
        victim=present(sinfo[SI_SKILLARG], caster)))
  {
    if(victim->id(SID_NOLEARN)) {
      write( "Leider lernst Du nicht aus Deinem Fehler.\n" );
      return;
    }
  }
  // Abfrage - Ende
  Learn(caster, spell, sinfo);
  sinfo=caster->QuerySkill(spell);
  if (old_abil < (mappingp(sinfo) ? sinfo[SI_SKILLABILITY] : sinfo))
  {
    write( "Du lernst aus Deinem Fehler.\n" ); 
    if( (int)(mappingp(sinfo) ? sinfo[SI_SKILLABILITY] : sinfo) ==10000 )
    {
      write("Kronang teilt Dir mit: Du kannst "+capitalize(spell)+
            " nun absolut perfekt!!!\n");
      if( "/gilden/berserker"->GuildRating(caster)==MAX_ABILITY ) 
        call_out("grats",4,caster);
    }
  }
  else
    write( "Leider lernst Du nicht aus Deinem Fehler.\n" );
}

void grats(object caster)
{
  tell_object(caster, "Kronang gratuliert Dir zur absoluten "
                      "Berserkermeisterschaft aus der Ferne.\n");
  call_out("geschenk",6, caster);
}
        
void geschenk(object caster)
{
  object ob;
  tell_object(caster,"\n\nKronang schenkt Dir die Berserkeraxt.\n\n");
  ob=clone_object("/gilden/berserker/weapon/berserkeraxt");
  ob->SetProp(P_SHORT, caster->Name(WESSEN)+" Berserkeraxt");
  ob->SetProp(P_NODROP, 1);
  ob->move(caster,M_NOCHECK);
  ob->wield_me();
}

void Erfolg(object caster, string spell, mapping sinfo) 
{
  int abil;
  abil=sinfo[SI_SKILLABILITY];
  if (abil!=MAX_ABILITY && random(MAX_ABILITY)<abil-MAX_ABILITY+100 )
  {
    caster->ModifySkill( spell, ([ SI_SKILLABILITY: ++abil ]), 0, "berserker");
    tell_object(caster,"Du lernst aus Deinem Erfolg.\n");
    if (abil==MAX_ABILITY)
    {
      tell_object(caster, "Kronang teilt Dir mit: Du kannst "+capitalize(spell)+
            " nun absolut perfekt!!!\n");
      if( "/gilden/berserker"->GuildRating(caster)==MAX_ABILITY ) 
        call_out("grats",4,caster);
    }
  }
}

int CheckEquip(object caster, string prop)
{
  int r,i,x;
  object *a;
  object w;
  mapping map;
  r=0;
  if (!pointerp(a=caster->QueryProp(P_ARMOURS)) ) a=({});
  if( w=caster->QueryProp(P_WEAPON)) a+=({w});
  for(i=sizeof(a)-1;i>=0;i--)
  {
    if( objectp(a[i]) && mappingp(map=a[i]->QueryProp(P_BERSERKER_BONUS)) )
    if( (x=map[prop]) || (x=map["all"]) ) 
      if(intp(x) && x>0)
        r+=x>MAX_EQUIP_BONUS?MAX_EQUIP_BONUS:x;
  }
  return (r>TOTAL_EQUIP_BONUS?TOTAL_EQUIP_BONUS:r);
}
    
int check_zerstoerung(object caster, mapping sinfo)
{
  string str;
  object ob;
  if(!str=sinfo[SI_SKILLARG] )
  {
    write("Was willst Du zerstoeren?\n");
    return 0;
  }
  if(!ob=present(str,caster))
  {
    write("Du hast doch gar kein "+capitalize(str)+"?\n");
    return 0;
  }
  if( caster->InFight() )
  {
    write("Willst Du nicht lieber Deine Gegner vorher vernichten?\n");
    return 0;
  }
  if(living(ob)) 
  {
    write("Bekaempfe "+ob->name(WEN)+" lieber wie ein richtiger Berserker!\n");
    return 0;
  }
  if(ob->QueryProp(P_KEEP_ON_SELL) == getuid(caster) ) 
  {
    write("Aber Du wolltest "+ob->name(WEN)+" doch behalten!\n");
    return 0;
  }
  return 1;
}

int prep_zerstoerung(object caster, mapping sinfo)
{
  object ob;
  if (!check_zerstoerung(caster, sinfo))
    return 0;
  ob=present(sinfo[SI_SKILLARG], caster);
  write(BS("Du sammelst Deine Kraft, um "+ob->name(WEN)+" zu zerstoeren.\n"));
  return 1;
}

int zerstoerung(object caster, mapping sinfo)
{
  int suc, value;
  string str;
  object ob;

  if( !check_zerstoerung(caster, sinfo) ) return 0; 
  str=sinfo[SI_SKILLARG];
  ob=present(str,caster);
  if( ( ob->QueryProp(P_CURSED) && caster->QueryProp(P_GUILD_LEVEL)<6 ) || 
      ob->id("QUESTOBJ") || ob->id("NODESTRUCT") || ob->id("UNZERSTOERBAR") )
  {
    write( break_string("Eine unbekannte Macht hindert Dich daran, "+ 
      ob->name(WEN)+ " zu zerstoeren.",78));
    return 0;
  }
  if( ob->IsUnit() )
  {
    write("Das geht nicht!\n");
    return 0;
  }
  if(ob->QueryProp(P_CURSED) && caster->QueryProp(P_GUILD_LEVEL)>=6 &&
      caster->QueryProp(P_SP)>35 )
  {
    caster->AddSp(-10-random(25));
    write(break_string("Du strengst Dich gewaltig an, um den Fluch auf "+
          ob->name(WEM,1)+ " zu brechen.",78));
    ob->SetProp(P_CURSED, 0);
  }
  if( ob->QueryProp(P_WIELDED) )
    ob->DoUnwield();
  if( ob->QueryProp(P_WIELDED) )
  {
    write("Du solltest "+ob->name(WEN,1)+" zuerst wegstecken.\n");
    return 0;
  }
  if( ob->QueryProp(P_WORN) )
    ob->DoUnwear();
  if( ob->QueryProp(P_WORN) )
  {
    write("Du solltest "+ob->name(WEN,1)+" zuerst ausziehen.\n");
    return 0;
  }
  if( (value=ob->QueryProp(P_VALUE))<10+random(50) )
  {
    write(ob->Name(WER)+" zerbroeselt sofort zu Staub.\n");
    say(caster->Name(WER)+" zerstoert "+ob->name(WEN)+".\n");
    caster->SetProp(P_NEXT_SPELL_TIME, time()+4);
    caster->AddSp(-1);
    ob->remove();
    return 0;
  }
  if (suc=SpellSuccess(caster,sinfo)<=0)
  {
    total_fail=1;
    write("Du schaffst es nicht, "+ob->name(WEN)+ " zu zerstoeren.\n");
    if( ( ob->QueryProp(P_WC)>70 || ob->QueryProp(P_WEIGHT)>500 ) 
        && !random(3) )
    {
      write("Leider verletzt Du Dich dabei selber.\n");
      caster->AddHP(-random( 1+(10000-suc)/500 ));
    }
    return MISSERFOLG;
  }
  switch(random(8))
  {
    case 0:
      tell_object(caster, 
        "Du zerstoerst voller Berserkerwut "+ ob->name(WEN)+".\n");
      tell_room(environment(caster), caster->Name(WER) + 
        " zerstoert voller Berserkerwut " + ob->name(WEN)+".\n", ({caster}) );
      break;
    case 1:
      tell_object(caster,break_string( 
        "Du wirfst "+ ob->name(WEN)+" zu Boden und huepfst solange wild darauf "
        "herum, bis nur mehr kleine Staubteilchen davon uebrigbleiben.",78));
      tell_room(environment(caster), break_string(
        caster->Name(WER) + " wirft "+ob->name(WEN)+" zu Boden und huepft "
        "solange wild darauf herum bis nur mehr kleine Staubteilchen "
        "uebrigbleiben.",78), ({caster}) );
      break;
    case 2:
      tell_object(caster, break_string( 
        "Du nimmst "+ ob->name(WEN)+" in Deinen Mund und kaust solange darauf "
        "herum, bis nichts mehr davon uebrig bleibt.",78));
      tell_room(environment(caster), break_string(
        caster->Name(WER) + " nimmt " + ob->name(WEN)+ " in " +
        caster->QueryPossPronoun(MALE,WEN,SINGULAR)+" Mund und kaut solange "
        "darauf herum, bis nichts mehr davon uebrig bleibt.",78), ({caster}) );
      break;
    case 3:
      tell_object(caster, break_string( 
        "Du nimmst "+ ob->name(WEN)+" in Deine Faeuste und biegst und drueckst "
        "solange herum, bis nur mehr ein Haeufchen Schrott uebrig bleibt.",78));
      tell_room(environment(caster), break_string(
        caster->Name(WER) + " nimmt " + ob->name(WEN)+ " in " +
        caster->QueryPossPronoun(FEMALE,WEN,PLURAL)+" Faeuste und biegt und "
        "drueckt solange herum, bis nur mehr ein Haeufchen Schrott "
        "uebrig bleibt.",78), ({caster}) );
      break;
    case 4:
      tell_object(caster, break_string( 
        "Du spannst Deine Muskeln an und zerreisst "+ ob->name(WEN)+" in "
        "kleine Teile.",78));
      tell_room(environment(caster), break_string(
        caster->Name(WER) + " spannt "+
        caster->QueryPossPronoun(MALE,WEN,PLURAL)+ " Muskeln an und zerreisst "
        + ob->name(WEN)+" in kleine Teile.",78 ), ({caster}) );
      break;
    case 5:
      tell_object(caster, break_string( 
        "Du nimmst all Deine Kraft zusammen und zerstueckelst " 
        + ob->name(WEN)+" in winzige Teilchen.",78));
      tell_room(environment(caster), break_string(
        caster->Name(WER) + " nimmt all "+
        caster->QueryPossPronoun(FEMALE,WEN)+ " Kraft zusammen und "
        "zerstueckelt " + ob->name(WEN)+" in winzige Teilchen.",78 ), 
        ({caster}) );
      break;
    case 6:
      tell_object(caster, break_string( 
        "Du zerstaeubst " + ob->name(WEN)+" mit einem einzigen, gewaltigen "
        "Hieb.",78));
      tell_room(environment(caster), break_string(
        caster->Name(WER) + " zerstaeubt " + ob->name(WEN)+" mit einem "
        "einzigen, gewaltigen Hieb.",78 ), ({caster}) );
      break;
    case 7:
      tell_object(caster, break_string( 
        "Mit all Deiner Kraft zerreisst Du " + ob->name(WEN)+".", 78));
      tell_room(environment(caster), break_string(
        "Mit all " + caster->QueryPossPronoun(FEMALE,WEM,SINGULAR)+" Kraft "
        "zerreisst " + caster->name(WER) + " " + ob->name(WEN)+ ".", 78 ),
        ({caster}) );
      break;
  }
  if( ( ob->QueryProp(P_WC)>100 || ob->QueryProp(P_WEIGHT)>1000 ) 
      && !random(3) )
  {
    write("Leider verletzt Du Dich dabei selber.\n");
    caster->AddHp(-random( 1+(10000-suc)/1000 ));
  }
  ob->remove();
  caster->ModifySkill("zerstoerung",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  caster->ModifySkillAttribute(caster, SA_DAMAGE, 125+(suc>7500?25:0), 
      (suc+sinfo[SI_SKILLABILITY])/250+value/100 ); // maximal 80 sec
  return ERFOLG;  
}

string gewicht_txt(int wert, object caster)
{
  string vname;
  if( caster->QueryProp(P_RACE) == "Mensch" )
  {
     if ( (wert >= 6000) )
       vname = "in etwa "+((wert+500)/1000)+" Kilogramm";
     else
     {
       if (wert < 100)
         vname = "so gut wie nichts";
       else if (wert < 950)
         vname = "schaetzungsweise "+((wert+50)-(wert+50)%100)+" Gramm";
       else
       {
         if (wert >= 1500)
           wert = wert+random(100)-random(100);   // ein wenig random :)
         if (wert >= 2000)
           wert=(wert+250)-(wert+250)%500;
         else
           wert=(wert+125)-(wert+125)%250;
         vname = "ungefaehr "+
           ({"","ein","zwei","drei","vier","fuenf","sechs"})[wert/1000]+
           ({"","einviertel","einhalb","dreiviertel"})[(wert%1000)/250]+
           " Kilogramm";
       }
     }
     return vname+" schwer";
  }
  if( wert>=10000 )     return "unhandlich schwer";
  else if( wert>=8000 ) return "aussergewoehnlich schwer";
  else if( wert>=6000 ) return "extrem schwer";
  else if( wert>=4000 ) return "sehr schwer";
  else if( wert>=2500 ) return "schwer";
  else if( wert>=1700 ) return "mittelschwer";
  else if( wert>=900 )  return "leicht";
  else if( wert>500 )   return "sehr leicht";
  else if( wert>250 )   return "extrem leicht";
  else if( wert>100 )   return "aussergewoehnlich leicht";
  else                  return "federleicht";
}

string preis_txt(int wert, object caster)
{
  if( caster->QueryProp(P_RACE) == "Mensch" )
    return wert+" Muenzen wert";
  if( wert>=5000 )      return "unbezahlbar";
  else if( wert>=3500 ) return "extrem teuer";
  else if( wert>=2500 ) return "sehr teuer";
  else if( wert>=1500 ) return "teuer";
  else if( wert>=1000 ) return "mittelteuer";
  else if( wert>500 )   return "billig";
  else if( wert>200 )   return "sehr billig";
  else if( wert>10 )    return "fast wertlos";
  else                  return "wertlos";
}

int prep_waffenkunde(object caster, mapping sinfo)
{
  if( !sinfo[SI_SKILLARG] || !(present(sinfo[SI_SKILLARG], caster)) )
  {
    write("Welche Waffe moechtest Du erkunden?\n");
    return 0;
  }
  if( caster->InFight() )
  {
    write("In einem Kampf hast Du zu wenig Zeit, um eine Waffe genau zu "
          "untersuchen!\n");
    return 0;
  }
  return 1;
}

string magic_text(object ob)
{
  string wie;
  switch (ob->QueryProp(P_MAGIC))
  {
    case 1: wie = "magische"; break;
    case 2..3: wie = "schwach magische"; break;
    case 4..5: wie = "unterdurchschnittlich magische"; break;
    case 6..7: wie = "hoch magische"; break;
    case 8..9: wie = "sehr hoch magische"; break;
    case 10..11: wie = "goettliche"; break;
    case 12..15: wie = "einzigartige"; break;
    default: wie = "magische";
  }
  return wie;
}

int waffenkunde(object caster, mapping sinfo)
{
  object ob;
  string* fi;
  string cn;
  string result, gewicht, preis, fix_str, abn_str, wie;
  int wert, i, suc, abn, fix, wc_bonus;
  mapping mat;
  mixed spc_id;
  if (!prep_waffenkunde(caster, sinfo) ) return 0;  
  ob=present(sinfo[SI_SKILLARG], caster);
  cn = caster->name();
  if( result=ob->QueryProp(P_WEAPON_TYPE) )
  {
    if( (suc=SpellSuccess(caster,sinfo))<=0 )
    {
      total_fail=1;
      write("Du kannst nichts besonderes an "+ob->name(WEM,1)+ " erkennen.\n");
      return MISSERFOLG;
    }
    if (mappingp(ob->QueryProp(P_WC_BONUS)))
    {
      spc_id = filter_array(caster->QueryProp(P_IDS), ob->QueryProp(P_WC_BONUS));
      wc_bonus = sizeof(spc_id) && ob->QueryProp(P_WC_BONUS)[spc_id[0]];
    }
    switch(ob->QueryProp(P_WC)+wc_bonus)
    {
      case  0..70:  wie="mit einem veraechtlichen Gesichtsausdruck"; break;
      case 71..140: wie="unzufrieden"; break;
      case 141..210: wie="zufrieden"; break;
      case 211..300: wie="begeistert"; break;
    }
    tell_room(environment(caster), break_string(
      caster->Name()+ " nimmt "+ob->name(WEN,2)+" in die Haende und laesst "+
      ob->QueryPronoun(WEN)+" pruefend mehrfach durch die Luft pfeifen, "
      "anschliessend steckt "+caster->QueryPronoun(WER)+" "+
      ob->QueryPronoun(WEN)+" "+wie+" wieder weg.",78),({caster}) );
    switch( result )
    {
      case WT_AXE:
        if( (ob->QueryProp(P_WC)+wc_bonus)*50<caster->QuerySkillAbility(FIGHT(WT_AXE)))
          write("Eine nette Axt, aber doch eher fuer einen Anfaenger geeignet.\n");
        else   
          write("Eine Axt, wie sie genau zu Dir passt!\n");
        break;
      case WT_SWORD: 
        write(ob->Name(WEN,1)+" benutzt man wie ein Schwert.\n");
        break;
      case WT_KNIFE: 
        write("Was willst Du mit so einem kleinen Messer?\n");
        break;
      case WT_CLUB:  
        write(ob->Name(WEN,1)+" benutzt man wie eine Keule!\n");
        break;
      case WT_SPEAR: 
        write(ob->Name(WEN,1)+ " benutzt man wie einen Speer!\n");
        break;
      case WT_WHIP:  
        write(ob->Name(WEN,1)+" benutzt man wie eine Peitsche.\n");
        break;
      case WT_CHAIN:
        write(ob->Name(WER,1)+ " ist eine Kettenwaffe.\n");
        break;
      case WT_BOW:
        write(ob->Name(WER,1)+ " ist ein Bogen.\n");
        break;
      default:       
        write("Das ist aber eine merkwuerdige Waffe!\n");
    }
    if( ob->id(BERSERKER_SPALTEN_WAFFE))
      write(ob->Name(WER,1)+ " eignet sich fuers Spalten.\n");
    if( ob->id(BERSERKER_BLUTRAUSCH_WAFFE))
      write(ob->Name(WER,1)+ " eignet sich fuer einen Blutrausch.\n");

    wert=ob->QueryProp(P_WC)+ob->QueryProp(P_DAMAGED)+random(10)-5+wc_bonus;
// ein bischen ungenauigkeit muss sein :)
    if(      wert>=290 ) result="toedlichen";
    else if( wert>=270 ) result="gewaltigen";
    else if( wert>=250 ) result="extrem viel";
    else if( wert>=230 ) result="sehr viel";
    else if( wert>=210 ) result="viel";
    else if( wert>=190 ) result="einigen";
    else if( wert>=170 ) result="ueberduchschnittlich viel";
    else if( wert>=150 ) result="durchschnittlich viel";
    else if( wert>=130 ) result="mittelmaessigen";
    else if( wert>=110 ) result="etwas";
    else if( wert>=90 )  result="wenig";
    else if( wert>=70 )  result="sehr wenig";
    else if( wert>=50 )  result="extrem wenig";
    else if( wert>=30 )  result="fast keinen";
    else                 result="ueberhaupt keinen";

    gewicht = gewicht_txt(ob->QueryProp(P_WEIGHT)+random(100)-50, caster);
    preis = preis_txt( ob->QueryProp(P_VALUE)+random(100)-50, caster);

    fix=ob->QueryProp(P_WC_FIX);
    if(      fix>=80 ) fix_str="pefekt";
    if(      fix>=70 ) fix_str="exzellent";
    else if( fix>=60 ) fix_str="extrem gut";
    else if( fix>=50 ) fix_str="sehr gut";
    else if( fix>=40 ) fix_str="gut";
    else if( fix>=30 ) fix_str="normal";
    else if( fix>=20 ) fix_str="schlecht";
    else if( fix>=10 ) fix_str="sehr schlecht";
    else               fix_str="extrem schlecht";

    if( !intp(abn=ob->QueryProp(P_QUALITY_DECAY)) )
    {
      write("BUG!!! Abnuetzung falsch gesetzt, Erzmagier benachrichtigen!!!\n");
      write_file( "/spellbooks/quality.log", 
      dtime(time())+" "+getuid(caster)+" "+file_name(ob)+"\n");
      
      abn=100;
    }
    if(      abn>900 ) abn_str="praktisch gar nicht";
    else if( abn>500 ) abn_str="extrem langsam";
    else if( abn>300 ) abn_str="sehr langsam";
    else if( abn>200 ) abn_str="langsam";
    else if( abn>120 ) abn_str="etwas langsamer";
    else if( abn>90  ) abn_str="normal";
    else if( abn>70  ) abn_str="etwas schneller";
    else if( abn>50  ) abn_str="schnell";
    else if( abn>30  ) abn_str="sehr schnell";
    else if( abn>10  ) abn_str="extrem schnell";
    else if( abn>0   ) abn_str="fuerchterlich schnell";
    else               abn_str="gar nicht";
    
    write( break_string (capitalize(ob->name(WER,1))+ " ist " + gewicht +
       " und "+ preis + ", macht "+result+" Schaden, liegt "+fix_str+
       " in der Hand und nuetzt sich "+abn_str+" ab.",78) );
   
    write("Der Zustand "+ob->name(WESSEN,1)+" ist "+ob->dam_desc()+".\n");
    switch( ob->QueryProp(P_NR_HANDS) )
    {
      case 0: wie = "keine Hand"; break;
      case 1: wie = "eine Hand"; break;
      case 2: wie = "zwei Haende"; break;
      case 3: wie = "drei Haende"; break;
      case 4: wie = "vier Haende"; break;
      default: wie = "sehr viele Haende";
    } 
    write("Du benoetigst "+wie+", um "+ob->QueryPronoun(WEN)+" zu fuehren.\n");

    if( result=ob->info(caster) )
      write(sprintf("Du identifizierst %s:\n%s", ob->name(WEN, 1), result));
    if( (mat=ob->QueryProp(P_MATERIAL)) && (pointerp(mat)) )
    {
      if (sizeof(mat))
        write(break_string(sprintf("%s besteh%s aus %s.", ob->Name(WER,1),
              (ob->IsUnit() && ob->QueryProp("u_req") != 1 ? "en" : "t"),
              ob->MatList(WEM) || "unbekanntem Material"), 78));
    }
    else if (mappingp(mat) /* && sizeof(mat-([MAT_MISC_LIVING]) ) */ )
    {
      write(break_string(sprintf("%s besteh%s aus %s.", ob->Name(WER,1),
            (ob->IsUnit() && ob->QueryProp("u_req") != 1 ? "en" : "t"),
            ob->MaterialList(WEM,caster) || "unbekanntem Material"), 78));
    }
    if( ob->QueryProp(P_MAGIC) )
    {
      write(ob->Name(WER,1)+ " ist eine "+magic_text(ob)+" Waffe!\n"); 
    }
    for(i=0;i<sizeof(ob->QueryProp(P_DAM_TYPE));i++)
    {
      if(stringp(ob->QueryProp(P_DAM_TYPE)[i]))
      switch(ob->QueryProp(P_DAM_TYPE)[i])
      {
        case DT_SLASH:    
          write("Mit "+ob->name(WEM,1)+" fuehrt man wuchtige Schlaege aus.\n");
          break;
        case DT_PIERCE:   
          write("Mit "+ob->name(WEM,1)+" sticht man auf den Gegner ein.\n");
          break;
        case DT_BLUDGEON: 
          write("Mit "+ob->name(WEM,1)+" schlaegt man den Gegner ungespitzt "
                 "in den Boden.\n");
          break;
        case DT_RIP:      
          write("Mit "+ob->name(WEM,1)+" reisst man dem Gegner die Haut "
                 "auf.\n");
          break;
        case DT_WHIP:     
          write("Mit "+ob->name(WEM,1)+" peitscht man den Gegner aus.\n");
          break;
        case DT_SQUEEZE:  
          write("Mit "+ob->name(WEM,1)+" zerquetscht man den Gegner.\n");
          break;
        case DT_MAGIC:
          if( suc >4000 && caster->QueryProp(P_GUILD_LEVEL)>4 )
            write(ob->Name(WER,1)+" scheint irgendwie magisch zu sein.\n");
          break;
        case DT_FIRE:
          if( suc >4000 && caster->QueryProp(P_GUILD_LEVEL)>4 )
            write(ob->Name(WER,1)+" ist extrem heiss.\n");
          break;
        case DT_COLD: 
          if( suc >4000 && caster->QueryProp(P_GUILD_LEVEL)>4 )
            write(ob->Name(WER,1)+" ist extrem kalt.\n");
          break;
        case DT_AIR:
          if( suc >4000 && caster->QueryProp(P_GUILD_LEVEL)>4 )
            write(ob->Name(WER,1)+" ist von kleinen Luftwirbeln umgeben.\n");
          break;
        case DT_WATER:
          if( suc >5000 && caster->QueryProp(P_GUILD_LEVEL)>5 )
            write(ob->Name(WER,1)+" enthaelt die Kraefte des Meeres.\n");
          break;
        case DT_SOUND:
          if( suc >5000 && caster->QueryProp(P_GUILD_LEVEL)>5 )
            write(ob->Name(WER,1)+" macht unangenehmen Laerm.\n");
          break;
        case DT_POISON:
          if( suc >5000 && caster->QueryProp(P_GUILD_LEVEL)>5 )
            write(ob->Name(WER,1)+" scheint vergiftet zu sein.\n");
          break;
        case DT_ACID:
          if( suc >5000 && caster->QueryProp(P_GUILD_LEVEL)>5 )
            write("Von "+ob->name(WEM,1)+" tropft Saeure auf den Boden.\n");
          break;
        case DT_LIGHT:
          if( suc >6000 && caster->QueryProp(P_GUILD_LEVEL)>6 )
            write(ob->Name(WER,1)+" strahlt helles Licht aus.\n");
          break;
        case DT_LIGHTNING:
          if( suc >6000 && caster->QueryProp(P_GUILD_LEVEL)>6 )
            write(ob->Name(WER,1)+" ist von kleinen Blitzen umgeben.\n");
          break;
        case DT_HOLY:
          if( suc >6000 && caster->QueryProp(P_GUILD_LEVEL)>6 )
            write(ob->Name(WER,1)+" hat eine heilige Austrahlung.\n");
          break;
        case DT_UNHOLY:
          if( suc >6000 && caster->QueryProp(P_GUILD_LEVEL)>6 )
            write(ob->Name(WER,1)+" hat eine daemonische Austrahlung.\n");
          break;
        case DT_TERROR:
          if( suc >7000 && caster->QueryProp(P_GUILD_LEVEL)>7 )
            write(ob->Name(WER,1)+" erschreckt die Gegner.\n");
          break;
        case DT_ELECTRIC:
          if( suc >7000 && caster->QueryProp(P_GUILD_LEVEL)>7 )
            write(ob->Name(WER,1)+" ist elektrisch aufgeladen.\n");
          break;
        case DT_EXPLOSION:
          if( suc >7000 && caster->QueryProp(P_GUILD_LEVEL)>7 )
            write(ob->Name(WER,1)+" enthaelt explosive Kraefte.\n");
          break;
        case DT_MIND:
          if( suc >7000 && caster->QueryProp(P_GUILD_LEVEL)>7 )
            write(ob->Name(WER,1)+" verwirrt den Geist der Gegner.\n");
          break;
      }
    }
    ob->SetProp("waffenkunde", getuid(caster) );
  }
  else if (!living(ob) )
  {
    if( ob->QueryProp(P_ARMOUR_TYPE) )
    {
      write(ob->Name(WER)+(ob->IsPlural()?" sind":" ist")+" eine "+
          (ob->QueryProp(P_MAGIC)?magic_text(ob):"")
          +"Ruestung"+ (ob->QueryProp(P_ARMOUR_TYPE)!=AT_MISC?" vom Typ "+
           ob->QueryProp(P_ARMOUR_TYPE):"") +".\n");
      write(capitalize(ob->QueryPronoun(WER))+(ob->IsPlural()?" sind ":" ist ")+
          gewicht_txt(ob->QueryProp(P_WEIGHT),caster)+ " und "+
          preis_txt(ob->QueryProp(P_VALUE),caster)+".\n");
    }
    else
      write(ob->Name(WER)+(ob->IsPlural()?" sind ":" ist ")+
          gewicht_txt(ob->QueryProp(P_WEIGHT),caster)+ " und "+
          preis_txt(ob->QueryProp(P_VALUE),caster)+".\n");
    if( result= ob->info() )
      write("An "+ob->name(WEM)+" erkennst Du folgendes:\n"+
        result);
    else
      write(ob->Name(WER)+" besitz"+(ob->IsPlural()?"en":"t")+
          " keine Besonderheiten.\n");
  }
  else
    write( capitalize(ob->name(WER,1))+(IsPlural(ob)?" sind":" ist")+ 
        " doch gar keine Waffe.\n");
  caster->ModifySkill("waffenkunde",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int prep_schaetz(object caster, mapping sinfo)
{
  if( !FindLivingVictim(sinfo[SI_SKILLARG],caster,
                           "Wen moechtest Du einschaetzen?\n") )
    return 0;
  return 1;
}

int schaetz(object caster, mapping sinfo)
{
  object victim;
  int vhp, vwc, vac, vsr, vsz, msz, diff, danger, l, vl, axt;
  string result;
  string vname;
  mixed slash;
  mapping resist;
  
  victim=FindLivingVictim(sinfo[SI_SKILLARG],caster,
                           "Wen moechtest Du einschaetzen?\n");
  if (!victim)
    return 0;
  if( victim == caster )
  {
    write(break_string(
      "Du bist gleich gross, gleich stark und gleich gut im Kaempfen "
      "wie Du selbst. Aber das ist wohl auch keine Ueberraschung:)",78));
    return 0;
  }
  if( (SpellSuccess(caster,sinfo))<=0)
  {
    tell_object(victim, caster->Name(WER) +" versucht, Dich einzuschaetzen.\n");
    return MISSERFOLG;
  }

  msz = caster->QueryProp(P_SIZE);
  vhp = victim->QueryProp(P_HP)+random(51)-25;
  vwc = victim->QueryProp(P_TOTAL_WC)+random(21)-10;
  vac = victim->QueryProp(P_TOTAL_AC)+random(21)-10;
  vsr = victim->QueryProp(P_SPELLRATE)+random(5)-2;
  vsz = victim->QueryProp(P_SIZE);
// ein bischen ungenauigkeit muss sein :)
  vname = victim->name(WER, 1);

  write(break_string(capitalize(vname)+ " gehoert der Rasse "+
    capitalize(stringp(victim->QueryProp(P_RACE))?
      victim->QueryProp(P_RACE):"Unbekannt")+" an und kaempft mit "+
    victim->QueryProp(P_MAX_HANDS)+" Gliedmassen.",78) );
  if( victim->QueryProp(P_GUILD)=="berserker" )
  {
    l=caster->QueryProp(P_GUILD_LEVEL);
    vl=victim->QueryProp(P_GUILD_LEVEL);
    write(capitalize(vname)+" ist ein Berserker "+
        (l==vl? "gleicher":(l<vl? "hoeherer" : "niedrigerer")) + 
        " Stufe "+(l==vl?"wie":"als")+" Du.\n");
  }
  if (vhp > 1500)
  {
    result = capitalize(vname)+" haelt wahnsinnig viel Schaden aus.\n";
    danger+=4;
  }
  else if (vhp > 1000)
  {
    result = capitalize(vname)+" haelt ausserordentlich viel Schaden aus.\n";
    danger+=2;
  }
  else if (vhp > 800)
  {
    result = capitalize(vname) + " haelt extrem viel Schaden aus.\n";
    danger++;
  }
  else if (vhp > 600)
    result = capitalize(vname) + " haelt sehr viel Schaden aus.\n";
  else if (vhp > 400)
    result = capitalize(vname) + " haelt viel Schaden aus.\n";
  else if (vhp > 200)
    result = capitalize(vname) + " haelt einigen Schaden aus.\n";
  else if ( vhp > 120)
    result = capitalize(vname) + " haelt nur wenig Schaden aus.\n";
  else if ( vhp > 80)
    result = capitalize(vname) + " haelt nur sehr wenig Schaden aus.\n";
  else if ( vhp > 35)
    result = capitalize(vname) + " haelt nur extrem wenig Schaden aus.\n";
  else 
    result = "Du kannst " + victim->name(WEN,1) + " mit einem Schlag "
             "zerschmettern.\n";
  write(result);

  if (vac > 270 )
  {
    result = capitalize(vname) + " hat eine Haut wie Stahl.\n";
    danger+=3;
  }
  else if ( vac > 200)
  {
    result = capitalize(vname) + " hat eine extrem gute Ruestung.\n"; 
    danger++;
  }
  else if ( vac > 160)
    result = capitalize(vname) + " hat eine sehr gute Ruestung.\n"; 
  else if ( vac > 120)
    result = capitalize(vname) + " hat eine gute Ruestung.\n";
  else if ( vac > 80)
    result = capitalize(vname) + " hat eine schlechte Ruestung.\n";
  else if ( vac > 40)
    result = capitalize(vname) + " kann Dir keinen nennenswerten "
      "Widerstand entgegensetzen.\n";
  else
    result = "Deine Axt wird " + victim->name(WEN,1) +" in Stuecke hauen.\n";
  write(result);

  if ( vwc > 450)
  {
    result = capitalize(vname) + " kann Dich mit einem Schlag vernichten.\n";
    danger+=4;
  }
  else if ( vwc > 300)
  {
    result = capitalize(vname) + " kann Dich in kleine Stuecke hauen.\n";
    danger+=2;
  }
  else if ( vwc > 240)
  {
    result = capitalize(vname) + " kann Dich stark verletzen.\n";
    danger++;
  }
  else if ( vwc > 200)
    result = capitalize(vname) + " kann Dir hart zusetzen.\n";
  else if ( vwc > 160)
    result = capitalize(vname) + " kann Dir sehr viel Schaden zufuegen.\n";
  else if ( vwc > 130)
    result = capitalize(vname) + " kann Dir viel Schaden zufuegen.\n";
  else if ( vwc > 100)
    result = capitalize(vname) + " kann Dir Schaden zufuegen.\n";
  else if ( vwc > 80)
    result = capitalize(vname) + " kann Dir etwas Schaden zufuegen.\n";
  else if ( vwc > 60)
    result = capitalize(vname) + " kann Dir nur wenig Schaden zufuegen.\n";
  else if ( vwc > 40)
    result = capitalize(vname) + " wird Dich kaum verletzen koennen.\n";
  else
    result = capitalize(vname) + " kann Dich hoechstens kitzeln.\n";
  write(result);

  if ( vsr > 80)
  {
    result = capitalize(vname) + " ist extrem hinterhaeltig.\n";
    danger+=3;
  }
  else if ( vsr > 60)
  {
    result = capitalize(vname) + " ist ein hinterhaeltiger und trickreicher "
             "Gegner.\n";
    danger+=2;
  }
  else if ( vsr > 40)
  {
    result = capitalize(vname) + " kaempft sehr trickreich.\n";
    danger++;
  }
  else if ( vsr > 20)
    result = capitalize(vname) + " hat einige Tricks auf Lager.\n";
  else if ( vsr > 3)
    result = capitalize(vname) + " hat nur wenige Tricks auf Lager.\n";
  else
    result = capitalize(vname) + " ist sehr fair im Kampf.\n";
  write(result);

  if (vsz > (5*msz))
    result = capitalize(vname) + " ist riesig gross.\n";
  else if ( vsz > (3* msz)  )
    result = capitalize(vname) + " ist sehr viel groesser als Du. (rammen)\n"; 
  else if ( vsz > (2* msz)  )
    result = capitalize(vname) + " ist viel groesser als Du. (rammen, kopfstoss)\n"; 
  else if ( vsz > (3* msz)/2  )
    result = capitalize(vname) + " ist groesser als Du. (rammen, kopfstoss)\n"; 
  else if ( vsz > (6* msz) /5 )
    result = capitalize(vname) + " ist etwas groesser als Du. (rammen, "
      "kopfstoss)\n"; 
  else if ( vsz < msz/10 )
    result =  capitalize(vname) +  " ist winzig klein. (zertreten)\n";
  else if ( vsz < msz/3 )
    result =  capitalize(vname) + " ist viel kleiner als Du. (zertreten)\n";
  else if ( vsz < (3*msz)/5 )
    result =  capitalize(vname) + " ist kleiner als Du. (rammen)\n";
  else if ( vsz < (4*msz)/5 )
    result =  capitalize(vname) + " ist etwas kleiner als Du. (rammen)\n";
  else
    result = "Ihr seid etwa gleich gross. (rammen, kopfstoss)\n";
  write(result);

  if( mappingp(resist = victim->QueryProp(P_NEWSKILLS)) )
  {
    if( mappingp(resist=resist["Fight_axe"]) )
      axt= resist[SI_SKILLABILITY];
  }
  else
    axt=0;
  if( victim->id("Axtmeister") || axt > 8000 )
    write( capitalize(vname)+" ist "+ (victim->QueryProp(P_GENDER)==FEMALE ?
        "eine Meisterin im Axtkampf.\n" : "ein Meister im Axtkampf.\n") );
  else if( victim->id("Axtexperte") || axt > 5000 )
    write( capitalize(vname)+" ist "+ (victim->QueryProp(P_GENDER)==FEMALE ?
        "eine Expertin im Axtkampf.\n" : "ein Experte im Axtkampf.\n") );
  else if( victim->id("Axtkaempfer") || axt > 2000 )
    write( capitalize(vname)+" ist "+ (victim->QueryProp(P_GENDER)==FEMALE ? 
        "eine gute Axtkaempferin.\n" : "ein guter Axtkaempfer.\n") );
  if( victim->QueryProp(P_DEAF) )
    write(break_string( capitalize(vname)+" scheint taub zu sein und ist "
      "daher mit einem Kampfschrei nicht zu beeindrucken.", 78 ));
  if( victim->QueryProp(P_BLIND) )
  {
    write(break_string( capitalize(vname)+" ist blind und daher sicher ein "
      "leicht zu besiegender Gegner.", 78) );
    danger-=5;
  }

  diff = caster->QueryProp(P_ALIGN)-victim->QueryProp(P_ALIGN);
  if (diff > 1000)
    result = "Du bist heilig im Vergleich zu "+ victim->name(WEM, 1) +".\n";
  else if (diff > 600)
    result = "Du bist viel braver als " + vname + ".\n";
  else if (diff > 300)
    result = "Du bist braver als " + vname + ".\n";
  else if (diff > 150)
    result = "Du bist etwas braver als " + vname + ".\n";
  else if (-diff > 1000)
    result = "Du bist satanisch im Vergleich zu "+ victim->name(WEM, 1) + ".\n";
  else if (-diff > 600)
    result = "Du bist viel boeser als " + vname + ".\n";
  else if (-diff > 300)
    result = "Du bist boeser als " + vname + ".\n";
  else if (-diff > 150)
    result = "Du bist etwas boeser als " + vname + ".\n";
  else
    result = "Eure Gesinnung ist etwa gleich gut (oder boese).\n";
  write(result);

  diff=victim->QueryProp(P_WIMPY);
  if(diff)
  {
    if( diff > victim->QueryProp(P_MAX_HP)/2 || diff > 100 )
      result = capitalize(vname) + " ist ein voelliger Feigling.\n";
    else if ( diff > victim->QueryProp(P_MAX_HP)/3 || diff >50 )
      result = capitalize(vname) + " ist sehr feige.\n";
    else if ( diff > victim->QueryProp(P_MAX_HP)/4 || diff >20 )
      result = capitalize(vname) + " ist feige.\n";
    else if ( diff > victim->QueryProp(P_MAX_HP)/5 || diff >10 )
      result = capitalize(vname) + " ist etwas feige.\n";
    else 
      result = capitalize(vname) + " ist ein ganz klein wenig feige.\n";
    write(result);
  }
  if( resist=victim->QueryProp(P_RESISTANCE_STRENGTHS) )
  {
    if( slash= resist[DT_SLASH] )
    {
      if( to_float(slash) < -0.2 )
        write(victim->Name(WER,1)+" laesst sich durch Axthiebe nicht "
            "beeindrucken :-(.\n");
      if( to_float(slash) > 0.3 )
        write("Deine Axt wird "+victim->name(WEN,1)+" in kleine Stueckchen "
            "hauen!\n");
      danger-=to_int(slash*10.0);
    }
  }
  if( caster->QuerySkill( FIGHT(WT_AXE))[SI_SKILLABILITY] < 
      victim->QueryProp(P_LEVEL)*400 ||
      caster->QuerySkill( SK_TWOHANDED )[SI_SKILLABILITY] < 
      victim->QueryProp(P_LEVEL)*400 )
    write(victim->Name(WER,1)+" ist "+(victim->QueryProp(P_GENDER)==FEMALE ? 
      "eine wuerdige Trainingspartnerin":"ein wuerdiger Trainingspartner")+
        ".\n" );
  
  vl=victim->QueryProp(P_LEVEL);
  if( caster->QueryProp(P_RACE) == "Oger" &&
      victim->QueryProp(P_FRIEND) == 0 && 
      victim->QueryProp(P_NOCORPSE) == 0 && 
      victim->QueryProp(P_CORPSE) == "/std/corpse" )
  {
     if((victim->QueryProp(P_HEAL) == 0) && (vl > 10)) 
           l = (vl-10)/5+1;
     else l = victim->QueryProp(P_HEAL);

     result = BS("Am besten frisst Du "+victim->QueryPronoun(WEN)+ " "+
         ({"gleich roh", "geduenstet mit Gemuese", "garniert mit Feenfluegeln",
          "eingelegt in Zwergenhirngelee", "mit Elfenohrensalat",
          "gefuellt mit Menschenleber", "am Spiess gebraten",
          "mit Haut und Haaren", "mariniert mit Hobbitblut",
          "gegrillt mit Bratkartoffeln", "gekocht mit Trollspuckesauce",
          "geschnetzelt mit Knoedeln", "paniert mit Pommes",
          "als Eintopf", "verarbeitet als Blutwurst",
          "als leckeres "+CAP(victim->QueryProp(P_RACE))+"semmerl",
          })[random(16)] +".");
     if( l>50 )
       write(BS(victim->Name(WER)+" ist ein wahrer Leckerbissen und gehoert "
             "sofort in den Kochtopf!")+result);
     else if( l>20 )
       write(victim->Name(WER)+" wird Dir sicher gut schmecken!\n"+result);
     else if( l > 5 )
       write(victim->Name(WER)+" schaut lecker aus.\n"+result);
     else if( l > 0 )
       write(victim->Name(WER)+" ist nur eine magere Mahlzeit.\n"+result);
     else if( l < 0 )
       write(victim->Name(WESSEN)+" Leiche ist sicher ungeniessbar!\n");
  }
  l=caster->QueryProp(P_LEVEL);
  if(l>50) l=50;
  if(vl>45 ) 
  {
    if( interactive(victim)) vl=45;
    else danger+=(vl-45);
  }
  diff=(l+caster->QueryProp(P_GUILD_LEVEL)*4)/2 -vl+random(5)-2-danger;
  if(diff <-30)
    result = victim->name(WER,1)+" wird Dich in sekundenschnelle zerfetzen.\n";
  else if(diff <-20)
    result = "Insgesamt hast Du keine Chance gegen "+victim->name(WEN,1)+".\n";
  else if(diff <-15)
    result = "Du wirst "+victim->name(WEN,1)+" kaum besiegen koennen.\n";
  else if(diff <-10)
    result = BS("Du wirst "+victim->name(WEN,1)+" nur mit sehr viel Glueck und "
      "guter Ausruestung besiegen koennen.");
  else if(diff <-5)
    result = "Du wirst "+victim->name(WEN,1)+" nur mit viel Muehe besiegen "
    "koennen.\n";
  else if(diff >40)
    result = "Schaem Dich, "+victim->name(WER,1)+" ist doch voellig wehrlos!\n";
  else if(diff >25)
    result = "Du kannst ueber "+victim->name(WEN,1)+" nur lachen.\n";
  else if(diff >15)
    result = "Es wird ein Kinderspiel, "+victim->name(WEN,1)+" zu besiegen.\n";
  else if(diff >10)
    result = "Du wirst "+victim->name(WEN,1)+" leicht besiegen koennen.\n";
  else if(diff >5)
    result = "Wahrscheinlich wirst Du "+victim->name(WEN,1)+" besiegen koennen.\n";
  else
    result = "Das wird ein spannender und ausgeglichener Kampf.\n";
  write(result);

  if( victim->QueryProp(P_NOATTACK) || victim->QueryProp(P_XP)==0 )
     write("Eigentlich lohnt sich ein Kampf gegen "+victim->name(WEN,1)+
           " gar nicht.\n");

  if( stringp(victim->QueryProp(P_INFO)) )
    write("Zusaetzlich erkennst Du noch folgendes an "+victim->name(WEM,1)+
	   ":\n"+victim->QueryProp(P_INFO)  );

  tell_object(victim, caster->Name(WER) +" schaetzt Dich erfolgreich ein.\n");

  caster->ModifySkill("schaetz",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int zertreten(object caster, mapping sinfo)
{
  object victim;
  object *schuhe;
  string vnw, cn, schuhname;
  int dam, suc, body, weight, ac;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wen willst Du zertreten?\n");
  if (!victim)
    return 0;
  if( caster->QueryProp(P_DISABLE_ATTACK) )
  {
    write("Du bist kampfunfaehig und kannst jetzt niemanden zertreten!\n");
    return 0;
  }
  if( victim->is_class_member(CL_FLYING) )
  {
    write(BS(victim->Name(WER,2)+" fliegt doch und kann nicht zertreten "
          "werden!"));
    return 0;
  }
  if( victim->QueryProp(P_SIZE) > caster->QueryProp(P_SIZE)/3 &&
      victim->QueryProp("last_rammen_time") < time()-2 && 
      lower_case(victim->QueryProp(P_RACE))!="schlange")
  {
    write(sprintf("Aber %s ist doch viel zu gross zum Zertreten.\n",
      victim->name(WER, 2) ));
    return 0;
  }
  
  if( (suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;

  schuhe=caster->QueryArmours(AT_BOOT);
  if (sizeof(schuhe) && objectp(schuhe[0]))
  {
    schuhe[0]->TakeFlaw( ({DT_SQUEEZE}) );
    if( (weight=schuhe[0]->QueryProp(P_WEIGHT)) > 1500 ) 
      weight=1500; 
    ac=schuhe[0]->QueryProp(P_AC);
    schuhname= schuhe[0]->name(WEM,1);
  }
  else
  {
    if( member(({"Troll", "Hobbit"}), capitalize(caster->QueryProp(P_RACE)))
        == -1 && !random(3) && interactive(caster) )
    {
      write("Schmerzhaft trittst Du mit blossen Fuessen zu. Ob das eine gute "
            "Idee war?\n");
      caster->AddHp( -5-random(10) );
      return ERFOLG;
    }
    else
    {
      weight=100;
      ac=1;
      schuhname="blossen Fuessen";
      if( capitalize(caster->QueryProp(P_RACE))=="Troll" )
        weight=600;
      if( capitalize(caster->QueryProp(P_RACE))=="Hobbit" )
        ac=6;
      if( !interactive(caster) )
      {
        weight = 100 * caster->QueryProp(P_GUILD_LEVEL);
        ac = caster->QueryProp(P_GUILD_LEVEL);
      }
    }
  }

  dam = (sinfo[SI_SKILLABILITY] + 3*suc + 500*caster->QueryProp(P_GUILD_LEVEL)
        + random( weight * caster->QueryAttribute(A_STR) )) 
        * ac / VALID_ARMOUR_CLASS[AT_BOOT] - caster->QueryProp(P_WIMPY)*100;
  if( sizeof(schuhe) && schuhe[0]->QueryProp(P_EFFECTIVE_WC) )
    dam+=random(schuhe[0]->QueryProp(P_EFFECTIVE_WC)*
        caster->QueryProp(P_GUILD_LEVEL) *7);
  dam /= 100;
  if( capitalize(caster->QueryProp(P_RACE))=="Hobbit" ) dam += dam/5;
  dam += CheckEquip(caster, "zertreten");
  if( macht_der_faust(caster) )
  {
    dam += dam / 3;
    sinfo[SI_MAX_DAMAGE] =  5 * sinfo[SI_MAX_DAMAGE] / 4;
  }
  cn = caster->name();
  vnw = victim->name(WEN, 2);
  say(capitalize(cn) + " zertritt "+ vnw +" unter "+ schuhname + ".\n",
      victim);
  write("Du zertrittst "+ vnw +" unter "+ schuhname +".\n");
  tell_object(victim, capitalize(cn)+ " zertritt Dich unter " +
    schuhname+".\n");
  if( suc > 3333 ) 
    body=100-random(suc)/100;
  else 
    body = 100;
  if (victim->QueryProp("last_rammen_time") >= time()-2 && 
      caster->QueryProp("last_wuet_time") > time()-60) 
    victim->SetProp("last_zertreten_time", time() );
  dam = TryAttackSpell(victim, dam, DT_SQUEEZE, sinfo[SI_SPELL]+
    ([SP_REDUCE_ARMOUR: ([P_BODY:body, AT_BOOT:1, AT_TROUSERS:1])]), 
    caster,sinfo );
  if( suc > 7000 && dam > 15 && victim && 
      random(100) > victim->QueryProp(P_NOMAGIC) &&
      !victim->QueryProp(P_DISABLE_SPELLS))
    victim->SetProp(P_DISABLE_SPELLS, 1+random(3));
  caster->ModifySkill("zertreten",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int prep_wueten(object caster, mapping sinfo)
{
  object *wer;
  wer=filter_array(all_inventory(environment(caster)),#'living);
  if( sizeof(wer)<=1 )
  {
    write("Warum willst Du hier wueten, wo doch gar niemand da ist?\n");
    return 0;
  }
  if( caster->InFight() )
  {
    write("Du wuetest ja schon gegen Deine Gegner!\n");
    return 0;
  }
  return 1;
}

int wueten(object caster, mapping sinfo)
{
  object *wer;
  int i, suc, clv, vlv,lvl;
  object ob;

  if( !prep_wueten(caster, sinfo) ) return 0;
  suc=SpellSuccess(caster,sinfo);
  if( suc<-random(5000) )
  {
    write("Du wuetest herum und bist von Dir selber erschreckt.\n");
    say(caster->Name()+ " wuetet wie ein kleines Kind.\n"+
        "Du lachst "+caster->name(WEN)+" aus.\n");
    total_fail=1;
    caster->SetProp(P_WIMPY, caster->QueryProp(P_WIMPY)+random(30));
    if( suc<-3000 && random(2) )
    {
      (ob=clone_object(OBJ "panik"))->move(caster, M_NOCHECK);
      ob->fluechten("sich selbst");
    }
    else
      caster->CheckWimpyAndFlee();
    return MISSERFOLG;
  }
  if( suc<=0 )
    return MISSERFOLG;

  write("Du wuetest wie ein Wilder und schuechterst alle Anwesenden ein.\n");
  say(caster->Name()+ " wuetet wie ein Wilder und schuechtert Dich ein.\n");
  lvl=caster->QueryProp(P_LEVEL)>50?50:caster->QueryProp(P_LEVEL);
  clv=(lvl+3*caster->QueryProp(P_GUILD_LEVEL))/2;  
  wer=filter_array(all_inventory(environment(caster)),#'living);
  for(i=0;i<sizeof(wer);i++)
  {
    if ( wer[i]->QueryProp(P_NOATTACK) || wer[i]->QueryProp(P_FRIEND) || 
        (query_once_interactive(wer[i]) && 
         !call_other("/obj/pkmaster", "PK_allowed", environment(wer[i]), caster, wer[i])))
      continue;
    vlv = wer[i]->QueryProp(P_LEVEL);
    if( wer[i]!=caster && vlv<clv && 
        ! wer[i]->id("NOWIMPY") && 
        ! wer[i]->is_class_member(CL_UNDEAD) && 
        ! wer[i]->is_class_member(CL_DEMON)  && 
        wer[i]->QueryProp(P_NOMAGIC)<random(100) )
    {
      wer[i]->SetProp(P_WIMPY, wer[i]->QueryProp(P_WIMPY)+
        random((clv-vlv)+(suc+sinfo[SI_SKILLABILITY])/1000));
      tell_object(wer[i], "Du bekommst Angst vor "+ caster->name()+".\n");
      if( !query_once_interactive(wer[i]) && 
          !random(10+caster->QueryProp(P_GUILD_LEVEL)) )
      {
        tell_object(caster, wer[i]->Name()+" fuehlt sich von Dir "
            "provoziert und greift an!\n");
        wer[i]->Kill(caster);
      }
      else if( random(2) )
        tell_object(caster, wer[i]->Name()+" bekommt Angst vor Dir.\n");
      if( wer[i]->QueryProp(P_WIMPY)+random(20) >  
          wer[i]->QueryProp(P_HP) )
      {
        (ob=clone_object(OBJ "panik"))->move(wer[i], M_NOCHECK);
        ob->fluechten(caster->Name());
      }
    }
    else
    {
      if( !query_once_interactive(wer[i]) && 
          !random(10+caster->QueryProp(P_GUILD_LEVEL)) )
      {
         wer[i]->Kill(caster);
         tell_object(caster, wer[i]->Name()+" fuehlt sich von Dir "
              "provoziert und greift an!\n");
      }
    }
  }
  caster->ModifySkill("wueten",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  caster->SetProp("last_wuet_time", time());
  return ERFOLG;
}

int prep_augeinauge(object caster, mapping sinfo)
{
  object victim,enemy;
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
           "Mit wem willst Du einen Kampf Auge in Auge fuehren?\n");
  if( !victim) return 0;
  if( caster->QueryProp(P_PREFERED_ENEMY) &&
      objectp(enemy=caster->QueryProp(P_PREFERED_ENEMY)[1]) &&
      (enemy->IsEnemy(caster) ||
       caster->IsEnemy(enemy)) && time()-enemy->QueryProp(P_LAST_COMBAT_TIME)<1000)
  {
    write(BS("Du befindest Dich bereits im Kampf Auge in Auge mit "+
        enemy->name(WEM,1)+"!\n"));
    return 0;
  }
  return 1;
}

int augeinauge(object caster, mapping sinfo)
{
  object victim,enemy;
  int suc, pref, beat_off_num;

  if (!prep_augeinauge(caster, sinfo))
    return 0;
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
           "Mit wem willst Du einen Kampf Auge in Auge fuehren?\n");
  suc=SpellSuccess(caster,sinfo);
  if( suc<-random(7000) )
  {
    write("Du schaust so angestrengt, dass Du erblindest!\n");
    total_fail=1;
    caster->SetProp(P_BLIND, 3*caster->QueryProp(P_GUILD_LEVEL)-suc/50);
    return MISSERFOLG;
  }
  if( suc<=0 )
    return MISSERFOLG;
  
  pref=50+caster->QueryProp(P_GUILD_LEVEL)*2+(suc+sinfo[SI_SKILLABILITY])/800
       +caster->QueryAttribute(A_INT)/3;
  if( pref> 95 ) pref = 95;
  caster->SetProp(P_PREFERED_ENEMY, ({pref, victim}) );
  write(sprintf("Du befindest Dich jetzt im Kampf Auge in Auge mit %s.\n", 
    victim->name(WEM, 2)));
  if( !random(10) )
  {
    switch( random(5) ){
      case 0:
        write(break_string("Nach diesem Blick hat "+victim->name(WER,1)+ 
          " gemerkt, dass "+victim->QueryPossPronoun(victim, WER, SINGULAR)+
          " letztes Stuendlein geschlagen hat.",78));
        break;
      case 1:
        write(break_string(victim->Name(WER,1)+" ist durch Deinen "
          "Blick wie gebannt.",78));
        break;
      case 2:
        write(break_string("Bei diesem Blick erbleicht "+
              victim->Name(WER,1)+".",78));
        break;
      case 3:
        write(break_string( victim->Name(WER,1)+" wird nach diesem Blick "
              "leichenblass.",78));
        break;
      case 4:
        write(break_string("Dein starrer Blick laesst "+ 
              victim->Name(WER,1)+" erzittern.",78));
        break;
    }
  }   
  tell_object(victim, capitalize(caster->Name())+" kaempft jetzt Auge "
    "in Auge mit Dir.\n" );
  caster->ModifySkill("augeinauge",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int prep_regeneration(object caster, mapping sinfo)
{
  if( caster->InFight() )
  {
    write("Such Dir lieber einen ruhigen Ort fuer die Regeneration!\n");
    return 0;
  }
  if( caster->QueryProp("last_wuet_time") > time()-60 )
  {
    write("Du bist noch zu wuetend um Dich zu regenerieren.\n");
    return 0;
  }
  return 1;
}

int regeneration(object caster, mapping sinfo)
{
  int i, suc, heal, maxheal, kosten;
  mapping blind;

  if( !prep_regeneration(caster, sinfo) ) return 0;
  suc=SpellSuccess(caster,sinfo);
  suc+=suc*macht_des_herzens(caster)/4 + 50*CheckEquip(caster, "regeneration");
  caster->SetProp(P_DISABLE_ATTACK,9);
  kosten = 0;

  if( suc < -random(4000) )
  {
    total_fail = 1;
    tell_object(caster,"Oh! Die Regeneration verkehrt sich ins Gegenteil!\n");
    switch( random(10) )
    {
      case 0:
        tell_object(caster,"Du verwandelst Dich in einen Frosch!\n");
        caster->SetProp(P_FROG,1);
        break;
      case 1:
        tell_object(caster,"Du verlierst Dein Augenlicht!\n");
        caster->SetProp(P_BLIND,-suc/(1+random(100)) );
        break;
      case 2:
        tell_object(caster,"Du kannst ploetzlich nichts mehr hoeren!\n");
        caster->SetProp(P_DEAF,-suc/(1+random(100)));
        break;
      case 3:
        tell_object(caster,"Du bist voellig erschoepft!\n");
        caster->SetProp(P_MV,0);
        break;
      case 4:
        tell_object(caster,"Dein Bauch schmerzt!\n");
        caster->SetProp(P_FOOD,caster->QueryProp(P_MAX_FOOD));
        break;
      case 5:
        tell_object(caster,"Du fuehlst Dich voellig betrunken!\n");
        caster->SetProp(P_ALCOHOL,caster->QueryProp(P_MAX_ALCOHOL));
        break;
      case 6:
        tell_object(caster,"Deine Nieren scheinen zu platzen!\n");
        caster->SetProp(P_DRINK,caster->QueryProp(P_MAX_DRINK));
        break;
     default:
        tell_object(caster,"Du fuehlst Dich um vieles schwaecher!\n");
        caster->AddHp(-1-random(-suc/100));
        break;
    }
  }

  if( suc<=0 )
  {
    tell_room(environment(caster), caster->Name(WER)+" versucht vergeblich, "
        "sich zu regenerieren.\n", ({caster}) );
    return MISSERFOLG;
  }
  if (caster->QueryProp(P_RACE)=="Troll")
    suc+=random(2000);
  tell_room(environment(caster), caster->Name(WER)+" regeneriert sich "
        "ploetzlich und schaut nun viel besser aus.\n", ({caster}) );
  if( caster->QueryProp(P_FROG) && suc > random(8000) && 
      caster->QueryProp(P_GUILD_LEVEL)>=5 )
  {
    caster->SetProp(P_FROG,0);
    tell_object(caster,"Du bist kein Frosch mehr!\n");
    i++;
    kosten+=2;
  }
  if( caster->QueryProp(P_BLIND) && 
      suc > random(10000) / (caster->QueryProp(P_RACE)=="Elf"?2:1) && 
      caster->QueryProp(P_GUILD_LEVEL)>=6 )
  {
    caster->SetProp(P_BLIND,0);
    tell_object(caster,"Du bist nicht mehr blind!\n");
    i++;
    kosten++;
  }
  if( (blind=caster->QueryProp(P_BLIND)) && 
      suc > random(5000) / (caster->QueryProp(P_RACE)=="Elf"?2:1) && 
      caster->QueryProp(P_GUILD_LEVEL)>=4 )
  {
    caster->SetProp(P_BLIND, blind +([BLIND_TIME: blind[BLIND_TIME]/2]) );
    tell_object(caster,"Der Schmerz in Deinen Augen wird leichter!\n");
    i++;
  }
  if( caster->QueryProp(P_DEAF) && suc > random(10000) &&
      caster->QueryProp(P_GUILD_LEVEL)>=6 )
  {
    caster->SetProp(P_DEAF,0); 
    tell_object(caster,"Du bist nicht mehr taub!\n");
    i++;
    kosten++;
  }
  if( (blind=caster->QueryProp(P_DEAF)) && suc > random(5000) && 
      caster->QueryProp(P_GUILD_LEVEL)>=4 )
  {
    caster->SetProp(P_DEAF, blind + ([DEAF_TIME: blind[DEAF_TIME]/2]) );
    tell_object(caster,"Der Schmerz in Deinen Ohren wird leichter!\n");
    i++;
  }
  if( caster->QueryProp(P_POISON) && suc > random(5000) && 
      caster->QueryProp(P_GUILD_LEVEL)>=7 )
  {
    heal = suc * (caster->QueryProp(P_RACE)=="Zwerg"?3:2) / 2222;
    // Maximal -8
    if (heal > caster->QueryProp(P_POISON)) heal = caster->QueryProp(P_POISON);
    else if (heal<1) heal=1;
    caster->AddPoison( -heal );
    kosten+=heal;
    if( caster->QueryProp(P_POISON) )
      tell_object(caster, "Deine Vergiftung schwaecht sich deutlich ab.\n");
    else
      tell_object(caster,"Du ueberwindest Deine Vergiftung!\n");
    i++;
  }
  if( caster->QueryProp(P_DRINK) > 2*caster->QueryProp(P_MAX_DRINK)/3 
      && suc > random(8000) && caster->QueryProp(P_GUILD_LEVEL)>=6 )
  {
    caster->SetProp(P_DRINK, caster->QueryProp(P_DRINK)-suc/333); // Maximal -30
    i++;
  }
  if( caster->QueryProp(P_FOOD) > 2*caster->QueryProp(P_MAX_FOOD)/3
      && suc > random(8000) && caster->QueryProp(P_GUILD_LEVEL)>=6 )
  {
    caster->SetProp(P_FOOD, caster->QueryProp(P_FOOD)- (suc/333) * 
        (caster->QueryProp(P_RACE)=="Hobbit"?2:1) ); // Maximal -30
    i++;
  }
  if( caster->QueryProp(P_ALCOHOL) > 2*caster->QueryProp(P_MAX_ALCOHOL)/3
      && suc > random(8000) && caster->QueryProp(P_GUILD_LEVEL)>=6 )
  {
    caster->SetProp(P_ALCOHOL, caster->QueryProp(P_ALCOHOL)-suc/333);
    i++;
  }
  if( caster->QueryProp(P_MV)<caster->QueryProp(P_MAX_MV)/2
      && suc>random(6000) && caster->QueryProp(P_GUILD_LEVEL)>=5 )
  {
    caster->SetProp(P_MV, caster->QueryProp(P_MV)+suc/20); // Maximal +500 Moves
    i++;
  }
  if( suc>random(9500) && caster->QueryProp(P_GUILD_LEVEL)>=8 )  // schneller hochidlen
  {
    if(!caster->Query(P_HP_DELAY,F_QUERY_METHOD) &&
       !caster->Query(P_SP_DELAY,F_QUERY_METHOD) )
    {
      caster->Set(P_HP_DELAY, symbol_function("delay", TO), F_QUERY_METHOD);
      caster->Set(P_SP_DELAY, symbol_function("delay", TO), F_QUERY_METHOD);
      call_out("remove_delay", suc/200, caster);
      i++;
      kosten++;
    }
  }
  if( suc>9250  && random(2) && caster->QueryProp(P_GUILD_LEVEL)>=9 )
  {
    present("stirnband",caster)->PowerRegain(suc>11000?11000:suc);
    i++;
    kosten+=2;
  }
  else if (macht_des_herzens(caster) && suc>12345 )
  {
    present("stirnband",caster)->PowerRegain(9250);
    i++;
  }
  if( present("MALA", caster) && suc>3000+random(7000) )  // Malaria
  {
    present("MALA", caster)->story30();
    i++;
    kosten+=3;
  }
  else if( present("TURN", caster) && caster->QueryProp(P_GUILD_LEVEL)>=8 && 
      suc>3000+random(7000) ) // Drehwurmkrankheit
  {
    present("TURN", caster)->ende();
    i++;
    kosten+=3;
  }
  else if( present("ZV", caster) && caster->QueryProp(P_GUILD_LEVEL)>=10 && 
      suc>5000+random(20000) ) // Zombievirus
  {
    present("ZV", caster)->setze_alte_werte();
    i++;
    kosten+=5;
  }
  if( caster->QueryProp(P_HP)<caster->QueryProp(P_MAX_HP) && suc>random(4000) )
  {
    heal = i*random(3)+suc/333;
    maxheal = caster->QueryProp(P_MAX_HP)/8; // Maximal +50 LP mit 400 lp, +37 mit 300 lp
    caster->AddHp(heal>maxheal?maxheal:heal);  
    i++;
  }
  switch(i)
  {
    case 0: 
      tell_object(caster,"Die Regeneration hat keinen Effekt.\n");
      break;
    case 1: 
      tell_object(caster,"Du fuehlst Dich ein wenig besser.\n");
      break;
    case 2: 
      tell_object(caster,"Du fuehlst Dich besser.\n");
      break;
    case 3: 
      tell_object(caster,"Du fuehlst Dich um vieles besser.\n");
      break;
    case 4: 
      tell_object(caster,"Du fuehlst Dich regeneriert.\n");
      break;
    case 5: 
      tell_object(caster,"Du fuehlst Dich voellig regeneriert.\n");
      break;
    default:
      tell_object(caster,
        sprintf("Du fuehlst Dich wie ein%s komplett neue%s %s.\n",
                caster->QueryProp(P_GENDER)==FEMALE?"e":"",
                caster->QueryProp(P_GENDER)==FEMALE?"":"r",
                caster->_query_racestring()[0]) );
      break;
  }
  caster->AddSp(-(!random(caster->QueryProp(P_GUILD_LEVEL)/2)*i)-kosten);
  caster->ModifySkill("regeneration",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int delay()
{
  return 0;
}

void remove_delay(object caster)
{
  caster->Set(P_HP_DELAY, 0, F_QUERY_METHOD);
  caster->Set(P_SP_DELAY, 0, F_QUERY_METHOD);
}

int prep_rammen(object caster, mapping sinfo)
{
  if( !FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wen willst Du rammen?\n") )
    return 0;
  return 1;
}

int rammen(object caster, mapping sinfo)
{
  object victim;
  object *bracer;
  string vnw, cn;
  int dam, suc, eff_wc, bonus;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wen willst Du rammen?\n");
  if (!victim)
    return 0;
  if( caster->QueryProp(P_DISABLE_ATTACK) )
  {
    write("Du bist kampfunfaehig und kannst jetzt niemanden rammen!\n");
    return 0;
  }
  if( victim->QueryProp(P_SIZE) < caster->QueryProp(P_SIZE)/3 )
  {
    write(sprintf("Aber %s ist doch viel zu klein zum Rammen.\n",
      victim->name(WER, 2) ));
    return 0;
  }
  if( victim->QueryProp(P_SIZE) > caster->QueryProp(P_SIZE)*5 )
  {
    write(sprintf("Aber %s ist doch viel zu gross zum Rammen.\n",
      victim->name(WER, 2) ));
    return 0;
  }
  suc=SpellSuccess(caster,sinfo);
  if( suc < -random(4000) )
  {
    write("Dein Rammen ging voellig daneben.\n"
          "Du faellst auf den Boden.\n");
    say(caster->name(WER)+" faellt auf den Boden.\n");
    caster->SetProp(P_DISABLE_ATTACK, random(suc/-2500) );
    caster->SetProp("last_rammen_time", time() );
    total_fail=1;
    return MISSERFOLG;
  }
  if( suc <= 0 )
    return MISSERFOLG;

  eff_wc=0;
  bracer=caster->QueryArmours(AT_BRACERS);
  if (sizeof(bracer) && objectp(bracer[0]))
  {
    eff_wc=bracer[0]->QueryProp(P_EFFECTIVE_WC);
    bracer[0]->TakeFlaw( ({DT_BLUDGEON}) );
  }
  else if (!interactive(caster))
    eff_wc = 20 * caster->QueryProp(P_GUILD_LEVEL);

  dam = (sinfo[SI_SKILLABILITY] + suc)/333 + 
        2 * caster->QueryProp(P_GUILD_LEVEL) +
        random(eff_wc) + 
        random(4*caster->QueryAttribute(A_STR)) - 
        caster->QueryProp(P_WIMPY);
  dam+=CheckEquip(caster, "rammen");
  if( macht_der_faust(caster) )
  {
    dam += dam / 3;
    sinfo[SI_MAX_DAMAGE] =  5 * sinfo[SI_MAX_DAMAGE] / 4;
  }
  cn = caster->name(WER);
  vnw = victim->name(WEN, 2);
  if( victim->QueryProp(P_BLIND) && victim->QueryProp(P_DEAF) )
  {
    DB(sprintf("BERSERKER: Blind/Deaf-Combo von %s gegen %s (%d Schaden)\n",
          caster->Name(WER), victim->name(WEN,1), caster->QueryProp(P_GUILD_LEVEL)*dam/2));
    say(capitalize(cn) + " rammt "+ vnw +" ungespitzt in den Boden.\n", 
        victim);
    write(BS("Du nutzt die Blindheit und Taubheit von "+victim->name(WEM,2)+
        " schamlos aus und rammst "+ victim->QueryPronoun(WEN) +" ungespitzt "
        "in den Boden."));
    tell_object(victim, capitalize(cn)+ " rammt Dich ungespitzt in den "
        "Boden.\n");
    victim->SetProp(P_BLIND, 0);
    victim->SetProp(P_DEAF, 0);
    victim->SetProp(P_DISABLE_ATTACK,1+random(2));
    TryAttackSpell(victim, caster->QueryProp(P_GUILD_LEVEL)*dam/2, DT_BLUDGEON, 
        ([SP_NAME:"rammen",SP_SHOW_DAMAGE:1]), caster,
        sinfo+([SI_MAX_DAMAGE:900, SI_SPELLFATIGUE:4]) );
    caster->SetProp(P_DISABLE_ATTACK,random(2));
  }
  else
  {
    say(capitalize(cn) + " rammt "+ vnw +" mit "+
        caster->QueryPossPronoun(FEMALE,WEM)+" Schulter.\n", victim);
    write("Du rammst "+ vnw +" mit Deiner Schulter.\n");
    tell_object(victim, capitalize(cn)+ " rammt Dich mit "+
        caster->QueryPossPronoun(FEMALE,WEM)+" Schulter.\n");
    TryAttackSpell(victim, dam, DT_BLUDGEON, 
        ([SP_NAME:"rammen",SP_SHOW_DAMAGE:1]), caster,sinfo );
    bonus=macht_der_faust(caster)*50;
    if( caster->QueryProp("last_wuet_time") > time()-60 )
      bonus+=10*caster->QueryProp(P_GUILD_LEVEL)+CheckEquip(caster, "rammen");
    if( victim && random(sinfo[SI_SKILLABILITY]+suc+bonus*10)>random(6000) &&
        random(100)>victim->QueryProp(P_NOMAGIC) )
    {
      if( random(3*caster->QueryAttribute(A_STR)+bonus/5) > 
          random(2*victim->QueryAttribute(A_STR)) &&
          random(caster->QueryProp(P_SIZE)+bonus/2) > 
          random(victim->QueryProp(P_SIZE)/3) )
      {
        victim->SetProp(P_DISABLE_ATTACK,1+random(4)/3);
        victim->SetProp("last_rammen_time", time() );
        tell_object(victim, caster->Name(WER,1)+" wirft Dich zu Boden.\n");
        tell_object(caster, "Du wirfst "+victim->name(WEN,1)+" zu Boden.\n");
        tell_room(environment(caster), caster->Name(WER,1)+" wirft "+
            victim->name(WEN,1)+" zu Boden.\n", ({caster,victim}) );
      }
    }
  }
  caster->ModifySkill("rammen",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int kampfschrei(object caster, mapping sinfo)
{
  object victim;
  string vnw, cn;
  int dam, suc, dauer,lvl;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wen willst Du mit Deinem Kampfschrei erschrecken?\n");
  if (!victim)
    return 0;
  suc=SpellSuccess(caster,sinfo)+50*CheckEquip(caster, "kampfschrei"); 
  if( suc<-random(3000) && !caster->QueryProp(P_DEAF) )
  {
    write("Du bruellst so laut, dass Du selber taub wirst.\n");
    total_fail=1;
    caster->SetProp(P_DEAF, 3*caster->QueryProp(P_GUILD_LEVEL)-suc/50);
    return MISSERFOLG;
  }
  if( suc<=0 )
    return MISSERFOLG;
  
  lvl=caster->QueryProp(P_LEVEL)>50?50:caster->QueryProp(P_LEVEL); 
  dam=50+random(50)+caster->QueryProp(P_GUILD_LEVEL)*2+ lvl/4 +
    (sinfo[SI_SKILLABILITY] + suc)/1000 - caster->QueryProp(P_WIMPY);
  dam+=CheckEquip(caster, "kampfschrei");
  if( macht_der_stimme(caster) )
  {
    dam += dam / 3;
    sinfo[SI_MAX_DAMAGE] =  5 * sinfo[SI_MAX_DAMAGE] / 4;
  }
  cn = caster->name();
  vnw = victim->name(WEN, 2);
  say(sprintf("%s bruellt %s an.\n",capitalize(cn), vnw), victim);
  write(sprintf("Du bruellst %s an.\n", vnw));
  tell_object(victim,sprintf("%s bruellt Dich an.\n", capitalize(cn)));
  if( victim->QueryProp(P_DEAF) )
  {
    write(sprintf("%s scheint taub zu sein und ist von Deinem Schrei gar nicht "
       "beeindruckt.\n", victim->Name(WER,2) ));
    tell_object(victim, "Zu Deinem Glueck kannst Du gar nichts hoeren.\n");
    if( !macht_der_stimme(caster) ) dam/=2;
  } 
  dam=TryAttackSpell(victim, dam, ({DT_TERROR, DT_SOUND}), 
            ([SP_NAME:"kampfschrei",SP_SHOW_DAMAGE:1]),caster,sinfo );
  if( victim && dam>7 && random(100)>victim->QueryProp(P_NOMAGIC) )
  {
    dauer = 1 + (suc/1000 + random(lvl/2))/2 + 5*macht_der_stimme(caster);
    victim->ModifySkillAttribute(caster, SA_SPEED, 50, dauer);
  }
  if( victim && dam>10 && suc>8000 && !victim->QueryProp(P_DEAF) &&
      random(100)>victim->QueryProp(P_NOMAGIC) )
  {
    tell_object(victim, "Das laute Schreien laesst Dich ertauben.\n");
    tell_object(caster, victim->Name(WER) + " haelt sich vor Schmerz die Ohren zu.\n");
    victim->SetProp(P_DEAF, caster->QueryProp(P_GUILD_LEVEL)+suc/500 ); 
  }
  caster->ModifySkill("kampfschrei",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int prep_willenskraft(object caster, mapping sinfo)
{
  if( present("\nberserker_willenskraft", caster) )
  {
    write("Aber Dein Wille ist schon gekraeftigt!\n");
    return 0;
  }
  return 1;
}

int willenskraft(object caster, mapping sinfo)
{
  int suc;
  object ob;
  
  if( !prep_willenskraft(caster, sinfo) ) return 0;
  suc=SpellSuccess(caster,sinfo)+50*CheckEquip(caster, "willenskraft");
  if( suc<-random(6000) )
  {
    write("Dein Wille wird total schwach.\n");
    total_fail=1;
    (ob=clone_object(OBJ "panik"))->move(caster, M_NOCHECK);
    ob->fluechten("sich selbst");
    return MISSERFOLG;
  }
  if (suc<=0)
    return MISSERFOLG;
  
  switch( random(3) )
  {
    case 0: say(caster->Name(WESSEN)+ " Wille ist gestaerkt.\n");
            write("Dein Wille ist nun gestaerkt.\n");
            break;
    case 1: say(caster->Name(WER)+ " holt tief Luft und sieht nun viel "
                "konzentrierter aus.\n"); 
            write("Du holst tief Luft und fuehlst Dich gleich konzentrierter.\n");
            break;
    case 2: say(caster->Name(WER)+" schliesst kurz die Augen und kraeftigt "
                +caster->QueryPossPronoun(MALE, WEN, SINGULAR)+" Willen.\n");
            write("Du schliesst kurz die Augen und kraeftigst Deinen Willen.\n");
            break;
  }
  if (caster->QueryProp(P_RACE)=="Elf" || caster->QueryProp(P_RACE)=="Dunkelelf" )
    suc+=500+random(2000);
  suc+=suc*macht_der_stimme(caster)/2;
  (ob=clone_object(OBJ "willenskraft"))->move(caster, M_NOCHECK);
  ob->willenskraft(suc, sinfo[SI_SKILLABILITY] );
  caster->ModifySkill("willenskraft",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int kopfstoss(object caster, mapping sinfo)
{
  object victim;
  object *helm;
  string vnw, cn, t;
  int dam, suc, weight, ac;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wem willst Du einen Kopfstoss verpassen?\n");
  if (!victim)
    return 0;
  if( caster->QueryProp(P_DISABLE_ATTACK) )
  {
    write("Du bist kampfunfaehig und kannst jetzt keinen Kopfstoss "
          "machen!\n");
    return 0;
  }
  if( victim->QueryProp(P_SIZE) < ( 8*caster->QueryProp(P_SIZE) )/10 )
  {
    write(sprintf("Aber %s ist doch viel zu klein fuer einen Kopfstoss.\n",
      victim->name(WER, 2) ));
    return 0;
  }
  if( victim->QueryProp(P_SIZE) > ( 3*caster->QueryProp(P_SIZE) ) )
  {
    write(sprintf("Aber %s ist doch viel zu gross fuer einen Kopfstoss.\n",
      victim->name(WER, 2) ));
    return 0;
  }
  if ( (suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  helm=caster->QueryArmours(AT_HELMET);
  if (sizeof(helm) && objectp(helm[0]))
  {
    helm[0]->TakeFlaw( ({DT_BLUDGEON}) );
    if( (weight=helm[0]->QueryProp(P_WEIGHT)*2/3) > 1500 ) 
      weight=1500; 
    ac=helm[0]->QueryProp(P_AC);
  }
  else
  {
    if( !interactive(caster) )
    {
      weight = 100 * caster->QueryProp(P_GUILD_LEVEL);
      ac = caster->QueryProp(P_GUILD_LEVEL);
    }
    else if( !random(3) )
    {
      write("Schmerzhaft stoesst Du mit blossem Kopf zu. Ob das eine gute "
            "Idee war?\n");
      caster->AddHp( -5-random(10) );
      return ERFOLG;
    }
    else
    {
      weight = 100;
      ac = 2;
    }
  }
    
  dam = ( sinfo[SI_SKILLABILITY] + 2 * suc + 
      random( weight* caster->QueryAttribute(A_STR) ))
      * ac / VALID_ARMOUR_CLASS[AT_HELMET] - caster->QueryProp(P_WIMPY)*100;
  if( sizeof(helm) && helm[0]->QueryProp(P_EFFECTIVE_WC) )
    dam+=random(helm[0]->QueryProp(P_EFFECTIVE_WC) *
      caster->QueryProp(P_GUILD_LEVEL) * 7);
  dam/=100;
  dam+=CheckEquip(caster, "kopfstoss");
  if( macht_der_faust(caster) )
  {
    dam += dam / 3;
    suc += suc / 2;
    sinfo[SI_MAX_DAMAGE] =  5 * sinfo[SI_MAX_DAMAGE] / 4;
  }
  cn = caster->name();
  vnw = victim->name(WEM, 2);
  t= "";
  if (victim->QueryProp("last_zertreten_time") >= time()-2 &&
      caster->QueryProp("last_wuet_time") > time()-60) 
  {
    write(break_string(sprintf("Noch bevor sich %s vom Zertreten erholen "
            "kann, gibst Du %s einen hammerharten Kopfstoss.", 
            victim->name(WER,2),victim->QueryPronoun(WEM)),78));
    dam*=2;
    suc=10000;
    victim->SetProp("last_kopfstoss_time", time() );
    caster->ModifySkillAttribute(caster, SA_DAMAGE, 150, 2);
    t="hammer";
  }
  else
    write(sprintf("Du gibst %s einen harten Kopfstoss.\n", vnw));
  say(sprintf("%s gibt %s einen "+t+"harten Kopfstoss.\n",capitalize(cn), vnw),
     victim);
  tell_object(victim,sprintf("%s gibt Dir einen "+t+"harten Kopfstoss.\n",
     capitalize(cn)));
  dam=TryAttackSpell(victim, dam, DT_BLUDGEON, sinfo[SI_SPELL], caster,sinfo);
  if( victim && victim->QueryProp(P_SIZE) < ( 15*caster->QueryProp(P_SIZE) )/10 &&
      dam >= 20 && 
      (suc > 8000  || !interactive(caster) ) && 
      !victim->QueryProp(P_BLIND) && 
      random(100) > victim->QueryProp(P_NOMAGIC)) 
  {
    victim->SetProp(P_BLIND, ([BLIND_TIME:1+random(4),BLIND_MSG:"* * * * *\n"]) );
    tell_object(victim, "Nach diesem Kopfstoss siehst Du nur noch Sterne!\n"
        " * * * * *\n");
    tell_room(environment(caster), break_string(victim->Name(WER,1)+" taumelt nach "
          "diesem schweren Treffer blindlings umher.\n", 78) , ({victim}));
  }
  caster->ModifySkill("kopfstoss",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

int prep_eisenhaut(object caster, mapping sinfo)
{
  mixed h;
  if( ! caster->InFight() && caster->QueryProp(P_GUILD_LEVEL)<11 )
  {
    write("Ausserhalb eines Kampfes ist eine Eisenhaut etwas sinnlos!\n");
    return 0;
  }
  if ((h=caster->QueryProp(P_TMP_DEFEND_HOOK)) && h[0]>time() )
  {
    if ((h[1]==this_object()) && (h[2]=="eisenhaut2")) 
    {
      if (h[0] >= time())
        return write("Deine Haut ist bereits aus Eisen.\n"), 0;
    } 
    else
      return write("Irgendwie klappt das gerade nicht.\n"), 0;
  }
  return 1;
}

int eisenhaut(object caster, mapping sinfo)
{
  int suc, dauer;

  if( !prep_eisenhaut(caster, sinfo) ) return 0;
  suc=SpellSuccess(caster,sinfo)+50*CheckEquip(caster, "eisenhaut");
  if( suc<-random(6000) )
  {
    switch( random(2) )
    {
      case 0:
        write("Das ging total daneben! Deine Haut wird ploetzlich ganz "
              "gruen.\n");
        total_fail=1;
        caster->SetProp(P_FROG,"berserker_eisenhaut_frosch");
        break;
      case 1:
        write("Deine Haut wird ganz weiss und durchscheinend.\n");
        total_fail=1;
        caster->SetProp(P_TMP_DEFEND_HOOK, 
          ({ time()+5*caster->QueryProp(P_GUILD_LEVEL)+
           (suc+sinfo[SI_SKILLABILITY]) / 400, this_object(), "eisenhaut3"}));
        break;
    }
    return MISSERFOLG;
  }
  if (suc<=0)
    return MISSERFOLG;
  
  write("Deine Haut bekommt einen metallischen Schimmer.\n");
  say(caster->Name(WESSEN)+ " Haut bekommt einen metallischen Schimmer.\n");
  dauer = 5*caster->QueryProp(P_GUILD_LEVEL)+(suc+sinfo[SI_SKILLABILITY])/400; 
  dauer += dauer*macht_des_herzens(caster)/2;
  caster->SetProp(P_TMP_DEFEND_HOOK, 
   ({ time()+dauer, this_object(), "eisenhaut2"}));
  call_out("eisenhaut_ende", dauer, caster );
  caster->ModifySkill("eisenhaut",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

void eisenhaut_ende(object caster)
{
  if(objectp(caster) && !present("\nberserker_blutrausch",caster) && 
      pointerp(caster->QueryProp(P_TMP_DEFEND_HOOK)) && 
      (caster->QueryProp(P_TMP_DEFEND_HOOK)[0])-time() < 10)
  {
    tell_object(caster, "Deine Haut wird wieder normal.\n");
    caster->SetProp(P_TMP_DEFEND_HOOK, 0);
  }
}
      
mixed eisenhaut2(int dam, mixed dam_type, mixed spell, object enemy)
{
  int damnum;
  damnum=0;
  if (!pointerp(dam_type))
    dam_type = ({ dam_type });
  if( member( dam_type, DT_SLASH )!=-1 ) damnum++;
  if( member( dam_type, DT_RIP) !=-1 ) damnum++; 
  if( member( dam_type, DT_BLUDGEON) !=-1) damnum++; 
  if( member( dam_type, DT_PIERCE) !=-1 ) damnum++;
  if( member( dam_type, DT_WHIP) !=-1 ) damnum++; 
  if( member( dam_type, DT_SQUEEZE) !=-1 ) damnum++; 
  if( damnum )
  {
    dam-=(20+random(25))*dam*damnum/(100*sizeof(dam_type) );
  }
  return ({ dam, dam_type, spell, enemy });
}

mixed eisenhaut3(int dam, mixed dam_type, mixed spell, object enemy)
{
  if (!pointerp(dam_type))
    dam_type = ({ dam_type });
  if( member( dam_type, DT_SLASH )!=-1 ||
      member( dam_type, DT_RIP) !=-1 ||
      member( dam_type, DT_BLUDGEON) !=-1 ||
      member( dam_type, DT_PIERCE) !=-1 ||
      member( dam_type, DT_WHIP) !=-1 ||
      member( dam_type, DT_SQUEEZE) !=-1) 
    dam=(125+random(125))*dam/100;
  return ({ dam, dam_type, spell, enemy });
}

int prep_spalten(object caster, mapping sinfo)
{
  if( ! caster->InFight() )
  {
    write("Wieso willst Du spalten wenn Du gar nicht kaempfst?\n");
    return 0;
  }
  if( !FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wen willst Du spalten?\n"))
    return 0;
  return 1;
}

int spalten(object caster, mapping sinfo)
{
  object victim;
  object waffe;
  string vnw, cn, str1;
  int dam, suc;
  mixed damtype;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wen willst Du spalten?\n");
  if (!victim)
    return 0;
  if( caster->QueryProp(P_DISABLE_ATTACK) )
  {
    write("Du bist kampfunfaehig und kannst jetzt niemanden spalten!\n");
    return 0;
  }
  if( !(waffe=caster->QueryProp(P_WEAPON)) || 
        (waffe->QueryProp(P_WEAPON_TYPE)!=WT_AXE && !waffe->id(BERSERKER_SPALTEN_WAFFE)) )
  {
    write("Dazu musst Du schon eine Axt gezueckt haben!\n");
    return 0;
  }
  if( caster->QueryProp(P_WIMPY) )
  {
    write("Als Feigling kannst Du niemanden spalten.\n");
    return 0;
  }
  if( (suc=SpellSuccess(caster,sinfo))<=0)
      return MISSERFOLG;
  suc += 25 * CheckEquip(caster, "spalten");
  if( waffe->QueryProp(P_ARTICLE) ) str1="D"; else str1="";
  write(sprintf("Du hebst %s%s ueber den Kopf %s.\n",
    str1,waffe->name(WEN,0), victim->name(WESSEN,2) ) );
  say(sprintf("%s holt mit %s %s weit aus.\n", capitalize(caster->name()),
     caster->QueryPossPronoun(waffe->QueryProp(P_GENDER), WEM, SINGULAR), 
     waffe->name(RAW)) );
  caster->SetProp(P_DISABLE_ATTACK,2);
  call_out("spalten2", 2, caster, victim, sinfo, suc);
  caster->ModifySkill("spalten",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

spalten2(object caster, object victim, mapping sinfo, int suc)
{
  object waffe;
  object schild;
  string vnw, cn, vns, str1;
  int dam, factor, combatmove;
  mixed damtype;
  string wie;
  mixed die_msg;

  if( !caster ) return;
  if( !(waffe=caster->QueryProp(P_WEAPON)) || 
        (waffe->QueryProp(P_WEAPON_TYPE)!=WT_AXE && !waffe->id(BERSERKER_SPALTEN_WAFFE)) )
  {
    write("Mitten im Spalten solltest Du Deine Axt nicht wegstecken!\n");
    return;
  }
  if( waffe->QueryProp(P_ARTICLE) ) str1="d"; else str1="";
  if( !victim || !present(victim, environment(caster)) )
  {
    write(sprintf("Du wirbelst %s%s herum, aber Dein Gegner ist leider nicht "
           "mehr da.\n",str1,waffe->name(WEN,0)));
    return;
  }
  if (suc > random(5000) && 
      victim->QueryProp("last_zertreten_time") >= time()-6 &&
      caster->QueryProp("last_wuet_time") > time()-60)
    combatmove=1;
  else if (suc > random(3000) && 
      victim->QueryProp("last_kopfstoss_time") >= time()-6 &&
      caster->QueryProp("last_wuet_time") > time()-60)
    combatmove=2;
  schild=victim->QueryArmours(AT_SHIELD);
  if (!combatmove && sizeof(schild) && objectp(schild[0]) && 
      random(schild[0]->QueryProp(P_AC) ) > caster->QueryProp(P_GUILD_LEVEL)-6 )
  {
    write( break_string(victim->Name(WER,1)+" wehrt Deinen Spaltversuch mit "+
        victim->QueryPossPronoun(schild[0]->QueryProp(P_GENDER),WEM,SINGULAR)+
        " "+schild[0]->name(RAW)+" ab.",78) );
    say( break_string(victim->Name(WER,1)+" wehrt den Spaltversuch von "+
          caster->name(WEM,1)+" mit "+
        victim->QueryPossPronoun(schild[0]->QueryProp(P_GENDER),WEM,SINGULAR)+
        " "+schild[0]->name(RAW)+" ab.",78) , victim);
    if( schild[0]->QueryProp(P_ARTICLE) ) str1="d"; else str1="";
    tell_object(victim, break_string("Du wehrst den Spaltversuch von "+
          caster->name(WEM,1)+" mit "+str1+schild[0]->name(WEM,0)+" ab.",78) );
    str1=schild[0]->Name(WER,1);
    if( schild[0]->QueryProp(P_QUALITY_DECAY) )
      schild[0]->TakeFlaw(random(800)+suc/10);
    if( !schild[0] || 
        (schild[0]->QueryProp(P_AC) == 0 && !schild[0]->id("NODESTRUCT")) ) {
      tell_room(environment(caster), capitalize(str1)+" haelt dem "
          "gewaltigen Hieb nicht stand und zersplittert.\n");
      if( objectp(schild[0]) && !schild[0]->id("NODESTRUCT") ) 
        schild[0]->remove(1);
    }
    waffe->TakeFlaw(5+random(10));
    return;
  }
  factor=100*(victim->QueryProp(P_HP)+1)/(victim->QueryProp(P_MAX_HP)+1);
  if( !combatmove && (factor > 66+random(33) || 
      ( factor > 25 && random(factor*victim->QueryAttribute(A_DEX))> 
      random(50*caster->QueryProp(P_GUILD_LEVEL)*caster->QueryAttribute(A_DEX)))))
  {
    wie=({"gekonnt", "gerade noch", "mit Leichtigkeit", "knapp", 
          "im letzten Moment", "mit aller Zeit der Welt", "haarscharf", 
          "mit grazioeser Leichtigkeit", "mit viel Muehe", "zungezeigend",
          "lachend", "schnell", "langsam"})[random(13)];
    write( break_string(victim->Name(WER,1)+" weicht Deinem Spaltversuch "+
        wie+" aus.",78) );
    say( break_string(victim->Name(WER,1)+" weicht dem Spaltversuch von "+
          caster->name(WEM,1)+" "+wie+" aus.") , victim);
    tell_object(victim, break_string("Du weichst dem Spaltversuch von "+
          caster->name(WEM,1)+" "+wie+" aus.",78) );
    return;      
  }
  cn = caster->name();
  vnw = victim->name(WEN, 2);
  vns = victim->name(WESSEN, 1);
  damtype=waffe->QueryProp(P_DAM_TYPE);
  dam = (sinfo[SI_SKILLABILITY]+ suc)/1000 * caster->QueryAttribute(A_STR) *
    ((victim->QueryProp(P_MAX_HP)+1)/(victim->QueryProp(P_HP)+1)) *
    caster->QueryProp(P_GUILD_LEVEL)/8 * waffe->QueryProp(P_WC)/ 300 ;
  dam+=(1+random(5))*CheckEquip(caster, "spalten");
  if (combatmove)
  {
    write(break_string(sprintf("Du nutzt die Verwundbarkeit %s aus und "
            "spaltest %s mit %s%s.", victim->name(WESSEN,2), 
            victim->QueryPronoun(WEN), str1, waffe->name(WEM,0) ),78));
    caster->ModifySkillAttribute(caster, SA_DAMAGE, 140+combatmove*25, 2);
    dam+=combatmove*200;
    DB(sprintf("BERSERKER: %s macht Combo %d gegen %s (%d Schaden)\n", 
          caster->Name(WER), combatmove, victim->name(WEN,1), dam));
  }
  else
    write(sprintf("Du spaltest %s mit %s%s.\n", vnw, str1,waffe->name(WEM,0)));
  say(sprintf("%s spaltet %s mit %s %s.\n",capitalize(cn), vnw,
    caster->QueryPossPronoun(waffe->QueryProp(P_GENDER), WEM, SINGULAR),
    waffe->name(RAW)), victim);
  tell_object(victim,sprintf("%s spaltet Dich mit %s %s.\n", capitalize(cn),
    caster->QueryPossPronoun(waffe->QueryProp(P_GENDER), WEM, SINGULAR),
    waffe->name(RAW) ));
  dam=TryAttackSpell(victim, dam, damtype,
    ([SP_NAME:"spalten", SP_SHOW_DAMAGE:1, SP_PHYSICAL_ATTACK:1]), 
    caster,sinfo );
  if( dam>100 && objectp(victim) )
  {
    victim->SetProp(P_DISABLE_ATTACK,1+random(2+combatmove));
    victim->SetProp(P_DISABLE_SPELLS,1+random(2+combatmove));
  }
  if( objectp(waffe) && !victim && (!random(2) || combatmove) ) 
  {
    switch(random(21)) 
    {
      case 0..4:
        write(break_string("Mit einem kraftvollen Ruck reisst Du "+
          waffe->name(WEN,1)+ " aus der Leiche heraus, reckst Deine "
          "Arme in den Himmel und bruellst: SIEG!!!",78));
        say(break_string("Mit einem kraftvollen Ruck reisst "+
          caster->name(WER,1) +" "+waffe->name(WEN,1)+ 
          " aus der Leiche heraus, reckt "+
          caster->QueryPossPronoun(MALE,WEN,PLURAL)+ " Arme in den Himmel "
         "und bruellt: SIEG!!!",78));
        break;
      case 5..9:
        write(break_string("Nach diesem gelungenen Hieb saeuberst Du mit "
          "Todesverachtung Dein"+ 
          (waffe->QueryProp(P_GENDER)==FEMALE?"e ":" ")+    
          waffe->name(RAW)+" von dem Blut "+vns+".",78));
        say(break_string("Nach diesem gelungenen Hieb saeubert "+
           caster->name(WER,1)+" mit Todesverachtung "+
           caster->QueryPossPronoun(waffe->QueryProp(P_GENDER),WEN)+
          " "+waffe->name(RAW)+" von dem Blut "+vns+".",78));
        break;
      case 10..14:
        write("Beim Anblick der gespaltenen Leiche musst Du "
            "unwillkuerlich grinsen.\n");
        say(caster->Name(WER,1)+" muss beim Anblick der gespaltenen "
            "Leiche unwillkuerlich grinsen.\n");
        break;
      case 15..19:
        write(break_string("Zufrieden fuegst Du eine Kerbe in den Stiel "+ 
          waffe->name(WESSEN,1)+" ein.",78));
        say(break_string("Zufrieden fuegt "+caster->name(WER,1)+" eine "
          "Kerbe in den Stiel "+ waffe->name(WESSEN,1)+" ein.",78));
      case 20:
        if( waffe->QueryProp(P_NODROP) || waffe->QueryProp(P_CURSED) ) 
          break;
        write(break_string(waffe->Name(WER,1)+" bleibt nach diesem vernichtenden "
              "Schlag im Boden stecken.",78));
        say(break_string(caster->Name(WESSEN)+" "+waffe->name(RAW)+" bleibt "
              "nach diesem vernichtenden Schlag im Boden stecken.",78));
        waffe->DoUnwield(1);
        waffe->move(environment(caster), M_PUT);
        if( !random(2) && present("\nberserker_riesenkraft", caster) )
        {
          write(break_string("Mit Deinen riesigen Kraeften reisst Du "+
                waffe->name(WEN,1)+ " wieder aus dem Boden herraus und haeltst "+
                waffe->QueryPronoun(WEN)+ " triumphierend in die Hoehe.",78));
          say(break_string("Mit "+caster->QueryPossPronoun(FEMALE,WEM,PLURAL)+
                " riesigen Kraeften reisst "+caster->name(WER,1)+" "+ 
                waffe->name(WEN,1)+ " wieder aus dem Boden herraus und haelt "+
                waffe->QueryPronoun(WEN)+ " triumphierend in die Hoehe.",78));
          waffe->move(caster, M_NOCHECK|M_SILENT);
          waffe->wield_me(1);
        }
        break;
    }
  }
  if( objectp(waffe) && victim )
  {
    if( !random(5) && dam>=176 ) 
    {
      if( random(50) )
      {
        write(break_string("Deine Axt steckt nach diesem "
              "vernichtenden Schlag fast im Boden fest.",78));
        say(break_string(caster->Name(WESSEN)+" Axt steckt nach diesem "
              "vernichtenden Schlag fast im Boden fest.",78));
      }
      else if( !waffe->QueryProp(P_NODROP) && !waffe->QueryProp(P_CURSED) 
          && !macht_der_faust(caster)) 
      {
        write(break_string("Deine Axt bleibt nach diesem vernichtenden Schlag "
              "im Boden stecken.",78));
        say(break_string(caster->Name(WESSEN)+" Axt bleibt nach diesem "
              "vernichtenden Schlag im Boden stecken.",78));
        waffe->DoUnwield(1);
        waffe->move(environment(caster), M_NOCHECK);
        if( !random(2) && present("\nberserker_riesenkraft", caster) )
        {
          write(break_string("Mit Deinen riesigen Kraeften reisst Du "+
                waffe->name(WEN,1)+ " wieder aus dem Boden herraus und kaempfst "+
                 " weiter.",78));
          say(break_string("Mit "+caster->QueryPossPronoun(FEMALE,WEM,PLURAL)+
                " riesigen Kraeften reisst "+caster->name(WER,1)+" "+ 
                waffe->name(WEN,1)+ " wieder aus dem Boden herraus und kaempft "+
                "weiter.",78));
          waffe->move(caster, M_NOCHECK|M_SILENT);
          waffe->wield_me(1);
        }
      }
    }
    else if( !random(5) && dam >= 151 && dam <= 175 ) 
    {
      write(break_string("Du bewunderst den Flug "+victim->name(WESSEN)+
            " durch das ganze SilberLand.",78));
      say(break_string(caster->Name(WER)+" bewundert den Flug "+
            victim->name(WESSEN)+ " durch das ganze SilberLand.",78));
    }
    else if( !random(5) && dam > 100 ) 
    {
      write(break_string("Blut spritzt durch die Gegend, als Dein"+
            (waffe->QueryProp(P_GENDER)==FEMALE?"e ":" ")+
            waffe->name(RAW)+ " "+victim->name(WEN,0)+ " beinahe in zwei "+
            "Teile spaltet.",78));
      say(break_string("Blut spritzt durch die Gegend, als "+
            caster->name(WESSEN)+" "+ waffe->name(RAW)+ " "+
            victim->name(WEN,0)+ " beinahe in zwei Teile spaltet.",78));
    }
  }
  if(objectp(waffe)) waffe->TakeFlaw(1+random(3));
  caster->SetProp(P_DISABLE_ATTACK,random(2));
}

int prep_blutrausch(object caster, mapping sinfo)
{
  object waffe;
  if( ! caster->InFight() )
  {
    write("Ausserhalb eines Kampfes ist der Blutrausch etwas sinnlos!\n");
    return 0;
  }
  if( !(waffe=caster->QueryProp(P_WEAPON)) || 
        (waffe->QueryProp(P_WEAPON_TYPE)!=WT_AXE && 
        !waffe->id(BERSERKER_BLUTRAUSCH_WAFFE ) ))
  {
    write("Dazu musst Du schon eine Axt gezueckt haben!\n");
    return 0;
  }
  return 1;
}

int blutrausch(object caster, mapping sinfo)
{
  int dauer, suc, equipmod;
  object ob;

  if( !prep_blutrausch(caster, sinfo) ) return 0;
  caster->SetProp(P_WIMPY, 0);
  suc=SpellSuccess(caster,sinfo);
  dauer = caster->QueryAttribute(A_STR) + caster->QueryAttribute(A_CON)+
          random(sinfo[SI_SKILLABILITY]+suc)/1000+ (suc>10000?10000:0);
  if (suc < -random(5000))
  {
    total_fail = 1;
    write("Der Blutrausch ging total daneben! Du wirst so friedlich...\n");
    caster->ModifySkillAttribute(caster,SA_SPEED,50,dauer);
    return MISSERFOLG;
  }
  if( suc <= 0 )
    return MISSERFOLG;
  
  say(sprintf("%s versetzt sich in Blutrausch.\n",capitalize(caster->name())));
  write("Du versetzt Dich in einen moerderischen Blutrausch!!!\n");
// Bonus wenn mans auf absoult pefekt kann  
  if( sinfo[SI_SKILLABILITY]==MAX_ABILITY && suc<2*MAX_ABILITY/3 )
    suc+=random(caster->QueryProp(P_LEVEL)*50);
//  Stufenabhaengiger Bonus von wueten
  if( caster->QueryProp("last_wuet_time") > time()-60 )
    suc+=1500*(caster->QueryProp(P_GUILD_LEVEL)-7)+random(5000);
// Bonus durch Ausruestung  
  if(equipmod=CheckEquip(caster,"blutrausch"))
    suc+=random(equipmod*100);
  (ob=clone_object(OBJ "blutrausch"))->move(caster,M_NOCHECK);
  ob->blutrausch( suc+sinfo[SI_SKILLABILITY]/2, dauer/2);
  caster->ModifySkill("blutrausch",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}


int prep_schlachtruf(object caster, mapping sinfo)
{
  object *enemies;
  if( file_name(environment(caster)) == "/gilden/berserker/room/weg_der_ahnen9")
  {
    sinfo[SI_PREPARE_TIME]=0;
  }
  else if (macht_der_stimme(caster))
  {
    sinfo[SI_PREPARE_TIME]=2;
  }
  else if( caster->InFight() )
  {
    write("Du befindest Dich schon mitten in einer Schlacht!\n");
    return 0;
  }
  if( caster->QueryProp(P_WIMPY) )
  {
    write("Du wuerdest Dich selbst zu sehr vor Deinem Schlachtruf "
          "fuerchten.\n");
    return 0;
  }
  return 1;
}

int schlachtruf(object caster, mapping sinfo)
{
  object *enemies;
  object ob;
  int i, suc, dam, d;
  string domain, mage, zone;
  string *dirs;
 
  if( !prep_schlachtruf(caster, sinfo) ) return 0;
  enemies=FindGroup(caster, -1);
  if(!enemies || !sizeof(enemies))
  {
    write("Im letzten Moment machst Du Deinen Mund doch wieder zu.\n"
          "Ohne Gegner macht so ein Schlachtruf ja gar keinen Spass.\n");
    return 0;
  }
  if (caster->InFight())
    sinfo[SI_SPELLFATIGUE]=2;
  else if (sinfo[SI_SKILLABILITY] == MAX_ABILITY && 
           ((caster->QueryProp(P_GUILD_LEVEL) >= 10 && random(2)) || 
            macht_der_stimme(caster) ))
    sinfo[SI_SPELLFATIGUE]=0;
  suc=SpellSuccess(caster,sinfo);
  if( suc<-random(4000) )
  {
    write("Du bruellst so laut, dass Du selber taub wirst.\n");
    total_fail=1;
    caster->SetProp(P_DEAF,-suc/10);
    return MISSERFOLG;
  }
  if (suc<=0) return MISSERFOLG;
  dirs = explode(file_name(environment(caster)),"/");
  if ( suc>5000 && sizeof(dirs)>3 && !caster->InFight() ) 
  {
    domain=dirs[1];
    mage=dirs[2];
    zone=dirs[3];
    domainshout("Du hoerst den gewaltigen Schlachtruf von "+
      caster->name(WEM)+"!\n"
      "Deine Ohren droehnen und Du bist etwas veraengstigt.\n", 
      domain+"/"+mage+"/"+zone,1); 
  }
  else 
    say("Ein ohrenbetaeubender Schlachtruf kommt aus "+caster->name(WESSEN)+
      " Kehle.\n");
  write("Ein ohrenbetaeubender Schlachtruf kommt aus Deiner Kehle.\n");
  dam = sinfo[SI_SKILLABILITY] / 50 + random( suc * 
      (caster->QueryAttribute(A_CON)+caster->QueryAttribute(A_STR))) / 750; 
  dam += CheckEquip(caster, "schlachtruf");
  dam += (macht_der_stimme(caster) && !caster->InFight()) * dam / 3;
  for(i=sizeof(enemies)-1;i>=0;i--)
  {
    d=TryAttackSpell(enemies[i], dam/2 + random(dam/2), ({DT_SOUND, DT_TERROR}), 
          ([SP_NAME:"schlachtruf",SP_SHOW_DAMAGE:1]),caster,sinfo );
    if( !enemies[i] ) continue; // Gegner durch schlachtruf gestorben, weiter zu naechstem
    if( !caster->InFight() ) caster->Kill(enemies[i]);
    if( d > 40 && suc > random(10000) && 
        random(100) > enemies[i]->QueryProp(P_NOMAGIC))
    {
      tell_object(enemies[i], "Das laute Schreien laesst Dich ertauben.\n");
      tell_object(caster, enemies[i]->Name(WER) + " haelt sich vor Schmerz die Ohren zu.\n");
      enemies[i]->SetProp(P_DEAF,suc/100);
    }
    if( enemies[i] && random(suc+sinfo[SI_SKILLABILITY]) > random(12000) 
      && random(100) > enemies[i]->QueryProp(P_NOMAGIC) && d > 30 &&
      enemies[i]->QueryAttribute(A_STR)<caster->QueryAttribute(A_STR) )
    {
      enemies[i]->SetProp(P_DISABLE_ATTACK,1+random(4));
      enemies[i]->SetProp("last_rammen_time", time() );
      tell_object(enemies[i], "Du faellst vor Schreck zu Boden.\n");
      tell_room(environment(caster), enemies[i]->Name(WER,1)+" faellt vor "
        "Schreck zu Boden.\n", ({enemies[i]}) );
    }
    else if( enemies[i] && random(enemies[i]->QueryProp(P_LEVEL)) < 15 &&
        random(suc+sinfo[SI_SKILLABILITY]) > 10000 + random(10000) && 
        random(100) > enemies[i]->QueryProp(P_NOMAGIC)  && d > 35 )
    {
      if( ! enemies[i]->id("NOWIMPY") && 
          ! enemies[i]->is_class_member(CL_UNDEAD) && 
          ! enemies[i]->is_class_member(CL_DEMON)  && 
          ! enemies[i]->QueryProp(P_NOATTACK) &&
          enemies[i]->QueryProp(P_LEVEL) < 25)
        enemies[i]->SetProp(P_WIMPY, enemies[i]->QueryProp(P_WIMPY)+
                    random((suc+sinfo[SI_SKILLABILITY])/300));
      tell_object(enemies[i], "Du bekommst Angst vor "+ caster->name()+".\n");
      if( enemies[i]->QueryProp(P_WIMPY) >  enemies[i]->QueryProp(P_HP) )
      {
        (ob=clone_object(OBJ "panik"))->move(enemies[i], M_NOCHECK);
        ob->fluechten(caster->Name());
      }
    }
  }
  caster->ModifySkill("schlachtruf",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

mixed prep_riesenkraft(object caster, mapping sinfo)
{
  object stirnband, victim;
  int check;
  check=0;
  if( caster->InFight() )
  {
    write("Du bist zu abgelenkt, um Dich auf Deine innere Kraft zu "
        "konzentrieren!\n");
    return 0;
  }
  if( caster->QueryProp(P_GUILD_LEVEL)>10)
  {
    if( sinfo[SI_SKILLARG] )
    {
      victim=FindLivingVictim(sinfo[SI_SKILLARG],caster,
                           "Wem moechstest Du Riesenkraft geben?\n");
      if( !victim) return 0;
      if( !interactive(victim) || (!IS_SEER(victim) && !IS_ARCH(caster) ) )
        return write("Du kannst nur Sehern Riesenkraft geben!\n"),0;
      if (present("\nberserker_riesenkraft",victim) || 
          victim->QueryAttribute(A_STR)>=35 ) 
        return write(victim->Name(WER,1)+" hat schon Riesenkraefte!\n"),0;
      if(victim!=caster)
        check=1;
    }
  }
  if(!victim) victim=caster;
  if( !check) 
    if (present("\nberserker_riesenkraft",caster)) 
      return write("Deine Muskeln platzen schon fast aus allen Naehten.\n"),0;
  if( (stirnband = present("\nberserker_stirnband", caster)) &&
      stirnband->QueryRiesenkraft() >= 
      ANZAHL_RIESENKRAFT  * caster->QueryProp(P_GUILD_LEVEL) / 10 ) 
    return write("Deine Muskeln sind zu erschoepft.\n"),0;
  return victim;
}

int riesenkraft(object caster, mapping sinfo)
{
  object ob, stirnband, victim;
  int suc, abil, dauer, staerke, hp, bonus;

  if( !victim=prep_riesenkraft(caster, sinfo) ) return 0;
  suc=SpellSuccess(caster,sinfo)+50*CheckEquip(caster, "riesenkraft");
  suc+=suc*macht_des_herzens(caster)/2;
  if (suc < -random(5555) )
  {
    write("Die Riesenkraft verkehrt sich ins Gegenteil und Du wirst ein "
        "Frosch.\n");
    caster->SetProp(P_FROG, 1);
    total_fail=1;
    return MISSERFOLG;
  }
  if (suc<=0) return MISSERFOLG;
  stirnband = present("\nberserker_stirnband", caster);
  stirnband->SetRiesenkraft();
  (ob=clone_object(OBJ "riesenkraft"))->move(victim,M_NOCHECK);
//  dauer = (suc+2*sinfo[SI_SKILLABILITY]/3)/150;
//  staerke = 10+suc/1000 ;
  abil = sinfo[SI_SKILLABILITY];
  dauer = (suc+abil)/150*(abil==MAX_ABILITY?2+macht_des_herzens(caster)+random(5):1 ); // 30-130 sec
  staerke = 5+abil/3333+suc/2000 ;  // 5-13 A_STR
  if( suc > 6667 ) hp = (suc-6667)/150; else hp = 0;   // 0-22 MAX_HP 
  if((bonus= (victim->QueryAttribute(A_STR))+staerke-A_MAX_MODIFIED)>0 )
  {
    staerke-=bonus; 
    hp+=bonus*(1+random(4)); // Mehr hp-bonus wenn man bei Kraft oben ansteht
  }
  ob->kraft( dauer , staerke, hp, (caster==victim && caster->QueryProp(P_GUILD_LEVEL)>10?2:0) );
  DB("BERSERKER: Riesenkraft von "+caster->Name()+(victim!=caster?" fuer "+victim->name():"")+ 
      " SUC="+suc+"  ABIL="+abil+ " DAUER="+dauer+" STAERKE="+staerke+" HP="+hp+"\n");
  switch( random(5) )
  {
    case 0: tell_object(victim,"Deine Muskeln schwellen an und Du fuehlst "
                "Dich stark wie ein Riese.\n");
            break;
    case 1: tell_object(victim,"Deine Muskeln werden ploetzlich riesengross.\n");
            break;
    case 2: tell_object(victim,"Deine Muskeln schwellen an und Du bist so "
              "stark wie ein Riese.\nDu koenntest sofort ein paar Baeume "
              "ausreissen.\n");
            break;
    case 3: tell_object(victim,"Du wirst stark wie ein Riese.\n");
            break;
    case 4:tell_object(victim,"Riesige Kraefte staerken Deine Muskeln.\n");
           break;
  }
  tell_room(ENV(caster),
      victim->Name(WESSEN,1)+" Muskeln schwellen gewaltig an.\n", ({victim}));
  caster->ModifySkill("riesenkraft",([SI_USR:sinfo[SI_USR]+1]),0,"berserker");
  return ERFOLG;
}

