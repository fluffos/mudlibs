// Bersekergilde im Silberland
// 11-10-1996    Feyaria@SilberLand

/*  Die Spells und Skills

Skill axe_figthing
  Besser Kaempfen mit Aexten
  Ab Gildenstufe 1

Skill Bihand
  Besser Kaempfen mit zweihaendigen Waffen
  Ab Gildenstufe 1
  
zerstoerung
  Damit kann man Dinge zerstoeren, es kann aber passieren, dass man
  sich dabei selber verletzt.
  SP:4, 3(10), Ab Gildenstufe 1

waffenkunde
  Schaetzt eine Waffe ein und gibt P_INFO aus (wenn vorhanden)
  SP:11, 10(7), 9(8), 8(9), 7(10), Ab Gildenlevel 1

schaetz
  Schaetzt die Kampfkraft des Gegners ein
  SP:5, 4(7), 3(10), Ab Gildenstufe 2

zertreten
  Angriff nur gegen kleine Gegner( < size/3) , Schaden abhengig von Gewicht,
  AC und EFFECTIVE_WC der Schuhe, Schaden zwischen 60 und 400
  SP:8, 7(8), 6(10), Ab Gildenstufe 2

wueten
  Die Anwesenden erschrecken, P_WIMPY wird erhoeht
  SP:7, 6(8), 5(9), 4(10), Ab Gildenstufe 3

augeinauge
  Hierbei konzentriet man sich auf einen Gegner und trifft ihn oefters
  Man bekommt auch hin und wieder eine Meldung, wie es dem Gegner so geht
  SP:11, 9(8), 8(9), 7(10), Ab Gildenstufe 3
 
regeneration
  Schnellere Regeneration und ueberwindung von gift, taub, blind und frosch
  SP:30, 25(7), 20(8) 17(9), 15(10), Ab Gildenstufe 4

rammen
  Einen Gegner zu Boden stossen, wenig schaden, eventuell DISABLE_ATTACK
  SP:6, 5(7), 4(10), Ab Gildenstufe 4

kampfschrei
  Angriffsspell, bei schwachen Gegnern wird P_WIMPY gesetzt
  SP:10, 9(8), 8(10), Ab Gildenstufe 5
 
willenskraft
  Durch blosse Willenskraft schafft man es, den Koeper gegen Umwelteinfluesse
  zu schuetzen, zB gegen Hitze, Kaelte und bestimme magische Schadenstypen
  SP:20, 18(8), 17(9), 15(10), Ab Gildenstufe 5

kopfstoss
  Angriff gegen gleichgrosse Gegner( > 80% size), Schaden abhaengig von
  Gewicht, AC und EFFECTIVE_WC des Helms, Schaden zwischen 10 und 555 
  SP: 15, 14(8), 13(9), 11(10), Ab Gildenstufe 6

eisenhaut
  Staerkt die Ruestung ( TEMP_DEFEND_HOOK )
  SP:25, 24(8), 22(9), 20(10), Ab Gildenstufe 6

spalten
  Harter Hieb mit der Axt, versucht den Gegner zu toeten
  SP:55, 50(9), 45(10), Ab Gildenstufe 7

blutrausch
  Mehrere schnelle und harte Attacken, Ruestung wird gestaerkt,
  aber man kann nicht fliehen
  SP:130, 122(9), 111(10), Ab Gildenstufe 8

schlachtruf
  Kampfanfang, Schaden gegen alle Gegner, zwischen 20 und 666
  SP:20, 15(10), Ab Gildenstufe 9

riesenkraft
  erhoeht kurzfristig die Kraft
  SP:40, Ab Gildenstufe 10
 
*/

#include <properties.h>
#include <attributes.h>
#include <combat.h>
#include <doors.h>
