  AddSpell("beherrschung", 0,
          ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:2]),
            SI_SPELLFATIGUE: 8,
            SI_PREPARE_TIME: 4,
            SI_PREPAREFUNC: "prep_beherrschung",
