            SI_PREPARE_TIME: 0,     
            SI_SKILLLEARN:2,         // 0.05% pro 2 A_INT 
            OFFSET(SI_SKILLLEARN):4, // plus 0.05% in jedem Fall
            SI_SKILLLEARN_ATTRIBUTE: A_INT, 
            SI_SKILLRESTR_USE: ([SR_FUN:"CheckIfSpellAllowed"]),
            SI_SP_LOW_MSG: BS("NARR! Deine unheilige Macht reicht fuer diese "
                             "Anrufung nicht aus."),
            SI_TIME_MSG: BS("NARR! Du bist noch zu erschoepft von Deiner "
                           "letzten unheiligen Anrufung!"),
            SI_NOMAGIC_MSG: BS("BEI ALLEN DAEMONISCHEN GESCHOEPFEN! Eine "
                             "heilige Macht verhindert Deine Anrufung!"),
          ]));

  AddSpell("identifiziere", 0,
          ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:1]),
            SI_SPELLFATIGUE: 2,
            SI_RAW_SPELLCOST: 10,
            SI_DIFFICULTY: 10,
            SI_SKILLLEARN: 3,
            SI_SKILLRESTR_USE:([SR_FUN: "BlindTest"]),
          ]));
