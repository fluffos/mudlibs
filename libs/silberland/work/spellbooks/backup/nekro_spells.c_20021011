            SI_SPELLFATIGUE: 8,
            SI_PREPARE_TIME: 6,
            SI_PREPAREFUNC: "prep_mumifizierung",
            SI_PREPARE_MSG: "Du beginnst, die Leiche mit Bandagen zu " 
