                                A_INT: 15]),
            SI_PREPARE_TIME:3,
            SI_PREPARE_MSG: "",
            SI_SPELLFATIGUE:4,
            SI_RAW_SPELLCOST: 45,
            SI_SPELLNAME: "elementarhand",
            SI_PREPAREFUNC: "elementarhand_check",
          ]));

 
