/*
//
// ALLGEMEINE SPELLS
//
*/

int 
schaetz(object caster, mapping sinfo) {
  object victim;
  int *res_res, *res_vul, *values, suc, i;
  string result, name_vic;
  mixed *indices;

  values=({});
  indices=({});
  if(caster->InFight()) {
    printf(BS("Du kannst Dich nicht auf die Muster des Zaubers "
              +"konzentrieren."));
    return 0;  
  }
  victim=FindVictim(sinfo[SI_SKILLARG],caster, "Wen oder was "
              +"willst Du denn einschaetzen?\n");
  if (!victim)
    return 0;
  if(!living(victim)) {
    printf(BS("Du kannst nur Lebewesen einschaetzen."));
    return 0;
  }
  sinfo=DoSpellModification(HUMUS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  printf(BS(sprintf("Du musterst %s und laesst elementare Kraefte "
                   +"durch Dich fliessen...", victim->name())));
  tell_room(ENV(caster), sprintf("%s mustert %s.\n", caster->name(), 
            victim->name(WEN)), ({victim, caster}));
  tell_object(victim, sprintf("%s mustert Dich.\n", caster->name(WER)));
  if ((suc=SpellSuccess(caster,sinfo))<=0) {
      printf(BS("...aber Du kannst nichts erkennen.\n"));
      return MISSERFOLG;
  }
  if(victim==caster) {
    printf(BS("Du schaetzt Dich und kommst zu folgendem Schluss:"));
    printf(BS("Du bist so gut wie Du. Waer ja schlimm wenns "
           +"anders waere."));
    return ERFOLG;
  }
  printf(BS("Schliesslich kommst Du zu folgendem Schluss:\n"));
  printf("------------------------------------------------"
         +"------------------------------\n");
  /* General Information */
  general_info(victim, caster);
  /* End */

  name_vic=victim->name();
  if(victim->QueryProp(P_RESISTANCE_STRENGTHS)) {
    values=m_values(victim->QueryProp(P_RESISTANCE_STRENGTHS));
    indices=m_indices(victim->QueryProp(P_RESISTANCE_STRENGTHS));
  }
  res_vul=({});
  res_res=({});
  for(i=sizeof(values)-1;i>=0;i--) {
    if((float)values[i]<0.0) res_res+=({i});
    if((float)values[i]>0.0) res_vul+=({i});
  }
  if(suc>6000){
    if(sizeof(res_vul)>0)
      printf(BS(CAP(name_vic)+" hat Verwundbarkeiten.\n"));
    else 
      printf(BS(CAP(name_vic)+" hat keine Verwundbarkeiten.\n"));
    if(sizeof(res_res)>0)
      printf(BS(CAP(name_vic)+" ist gegen ein paar Schaeden "
            +"resistent oder immun.\n"));
    else 
      printf(BS(CAP(name_vic)+" ist gegen nichts resistent "
            +"oder immun.\n"));
  }
  printf("------------------------------------------------"
        +"------------------------------\n");
  return ERFOLG;
}

/* Fuer 'schaetz' spell */
int general_info(object victim, object caster)
{
  int hp, sp, ac, size, i, nomagic_vic;
  int hp_vic, sp_vic, ac_vic, size_vic, spellrate_vic, align;
  string result, name_vic;

  sp_vic=victim->QueryProp(P_MAX_SP);
  ac_vic=victim->QueryProp(P_TOTAL_AC);
  size_vic=victim->QueryProp(P_SIZE);
  name_vic=victim->name(WER);
  hp_vic=victim->QueryProp(P_MAX_HP);
  nomagic_vic=victim->QueryProp(P_NOMAGIC);
  spellrate_vic=victim->QueryProp(P_SPELLRATE);
  align=victim->QueryProp(P_ALIGN);
  if(!size_vic) size_vic=1;

  sp=caster->QueryProp(P_MAX_SP);
  ac=caster->QueryProp(P_TOTAL_AC);
  hp=caster->QueryProp(P_MAX_HP);    
  size=caster->QueryProp(P_SIZE);
  if(!size) size=1;

  result=CAP(name_vic);
  switch(100*size_vic/size) {
    case 0..20   : result+=" ist sehr viel kleiner als Du.\n";
                   break;
    case 21..50  : result+=" ist viel kleiner als Du.\n";
                   break;
    case 51..80  : result+=" ist kleiner als Du.\n";
                   break;
    case 81..130 : result+=" ist etwa gleich gross wie Du.\n";
                   break;
    case 141..180: result+=" ist groesser als Du.\n";
                   break;
    case 181..350: result+=" ist viel groesser als Du.\n";
                   break;
    case 351..500: result+=" ist SEHR viel groesser als Du.\n";
                   break;
    case 501..800: result+=" ueberragt Dich um Haeuser.\n";
                   break;
    default      : result+=" ist gross wie ein Berg.\n";
  }
  printf(BS(result));
  result="Absolut gesehen haelt "+name_vic;
  if(!hp) hp=1;
  switch(100*hp_vic/hp) {
    case 0..20   : result+=" im Gegensatz zu Dir gar "
                          +"nichts aus.\n";
                   break;
    case 21..50  : result+=" im Gegensatz zu Dir "
                          +"sehr wenig aus.\n";
                   break;
    case 51..80  : result+=" etwas weniger als Du aus.\n";
                   break;
    case 81..140 : result+=" etwa gleich viel wie Du aus.\n";
                   break;
    case 151..200: result+=" im Gegensatz zu Dir viel aus.\n";
                   break;
    case 201..400: result+=" im Gegensatz zu Dir sehr viel "
                          +"aus.\n";
                   break;
    case 401..600: result+=" im Gegensatz zu Dir enorm viel "
                          +"aus .\n";
                   break;
    case 601..800: result+=" extrem viel aus. Du fuehlst Dich wie "
                         +"ein kleines Wuerstchen.\n";
                   break;     
    case 801..1000:result+=" im Gegensatz zu Dir unglaublich viel " 
                          +"aus. Sieh Dich bloss vor, sonst "
                          +"stehst Du bald vor Lars!\n";
                   break;
    default      : result+=" soviel Schaden aus, dass er fuer "
                   +"Dich so gut wie unbesiegbar ist! Du zitterst "
                   +"vor Ehrfurcht.\n";
  }
  printf(BS(result));
  result=CAP(name_vic);
  if(!sp) sp=1;
  switch(100*sp_vic/sp) {
    case 0..20   : result+=" hat so gut wie keine "
                          +"magischen Kraefte.\n";
                   break;
    case 21..50  : result+=" hat weit weniger magische "
                          +"Energie als Du.\n";
                   break;
    case 51..80  : result+=" hat etwas weniger magische "
                         +"Energie als Du.\n";
                   break;
    case 81..120 : result+=" ist etwa gleich magisch aktiv "
                         +"wie Du.\n";
                   break;
    case 121..180: result+=" hat mehr magische Energie "
                         +"als Du.\n";
                   break;
    case 181..250: result+=" hat viel mehr magische "
                         +"Energie als Du.\n";
                   break; 
    case 251..400: result+=" ist mit sehr viel mehr "
                         +"magischer Energie gesegnet als Du.\n";
                   break;
    case 401..600: result+=" ist in Sachen Magie extrem "
                         +"maechtiger als Du.\n";
                   break;
    case 601..800: result+=" hat im Gegensatz zu "
                          +"Dir unglaublich hohe und extrem "
                          +"maechtige magische Kraefte.";
                   break;     
    case 801..1000:result+=" hat im Gegensatz zu "
                         +"Dir so unglaublich "
                         +"grosse magische Kraefte, dass Du vor "
                         +"Ehrfurcht erzitterst.\n";
                   break;
    default      : result+=" hat im Gegensatz zu Dir gottgleiche "
                         +"magische Kraefte! Du erzitterst vor "
                         +"Ehrfurcht!\n";
  }
  printf(BS(result));
  result=CAP(name_vic);
  switch(nomagic_vic) {
    case 0      : result+=" kann keine Zauber abwehren.\n";
                   break;
    case 1..15  : result+=" kann nur wenige Zauber abwehren.\n";
                   break;
    case 16..30 : result+=" kann ein paar Zauber abwehren.\n";
                   break;
    case 31..45 : result+=" kann relativ viele Zauber abwehren.\n";
                   break;
    case 46..60 : result+=" wehrt etwa die Haelfte aller Zauber ab.\n";
                   break;
    case 61..75 : result+=" wehrt sehr viele Zauber ab.\n";
                   break;
    case 76..99 : result+=" wehrt beinahe alle Zauber ab.\n";
                   break;
    case 100    : result+=" wehrt alle Zauber ab.\n";
                   break;
    default      : result+=" wehrt alle Zauber ab.\n";
  }
  printf(BS(result));
  result=CAP(name_vic);
  if(interactive(victim)) result+=" kann zaubern.\n";
  else
  switch(spellrate_vic) {
    case 0      : result+=" kann keine Zauber sprechen.\n";
                   break;
    case 1..15  : result+=" kann nur wenige Zauber sprechen.\n";
                   break;
    case 16..30 : result+=" kann ein paar Zauber sprechen.\n";
                   break;
    case 31..45 : result+=" kann relativ viele Zauber sprechen.\n";
                   break;
    case 46..60 : result+=" spricht viele Zauber.\n";
                   break;
    case 61..75 : result+=" spricht sehr viele Zauber.\n";
                   break;
    case 76..99 : result+=" spricht beinahe immer einen Zauber.\n";
                   break;
    case 100    : result+=" spricht immer einen Zauber.\n";
                   break;
    default      : result+=" spricht immer einen Zauber.\n";
  }
  printf(BS(result));
  result=CAP(name_vic);
  switch(ac_vic) {
    case 0..40   : result+=" hat so gut wie keinen Schutz.\n";
                   break; 
    case 41..80  : result+=" kann Dir nicht viel entgegensetzen.\n";
                   break;
    case 81..120 : result+=" hat eine gute Ruestung oder natuerlichen "
                         +"Schutz.\n";
                   break; 
    case 121..160: result+=" hat eine maechtige Ruestung oder "
                         +"natuerlichen Schutz.\n";
                   break;
    case 161..200: result+=" hat eine extrem maechtige Ruestung oder "
                         +"einen uebernatuerlichen Schutz.\n"; 
                   break;
    case 201..250: result+=" scheint vom Element Erz selbst vollkommen "
                         +"geschuetzt zu sein.\n";
                   break;
    case 251..350: result+=" ist beinahe wie unverwundbar.\n";  
                   break;
    default      : result+=" ist durch normale Waffen nicht mehr zu "
                         +"verletzen und scheint einen extrem "
                         +"machtvollen uebernatuerlichen Schutz zu "
                         +"haben.\n"; 
  }
  printf(BS(result));
  result=CAP(name_vic);
  if(align<-1000) result+=" scheint das Boese selbst zu sein!\n";
  else if (align<-600) result+=" ist von diabolischer Gesinnung.\n";
  else if (align<-400) result+=" ist extrem boese.\n";
  else if (align<-200) result+=" ist von boeser Gesinnung.\n";
  else if (align<-50) result+=" ist zu frech um neutral zu sein.\n";
  else if (align<50) result+=" steht allem neutral gegenueber.\n";
  else if (align<200) result+=" scheint ziemlich nett zu sein.\n";
  else if (align<400) result+=" ist von guter Gesinnung.\n";
  else if (align<600) result+=" ist von aussergewoehnlich guter "
                            +"Gesinnung.\n";
  else if (align<1000) result+=" scheint schon fast heilig zu sein.\n";
  else result+=" ist ein Heiliger!\n";
  printf(BS(result));
  return 1;
}


int erkenne(object caster, mapping sinfo)  {  
  object ob; 
  string* fi, cn, result; 
  int suc;

  if(caster->InFight()) {
    printf(BS("Du kannst Dich nicht auf die Muster des Zaubers "
              +"konzentrieren."));
    return 0;  
  }
  ob=FindVictim(sinfo[SI_SKILLARG], caster, 
                BS("Welchem Gegenstand moechtest Du seine "
                  +"Geheimnisse entreissen?\n")); 
  if (!ob) 
    return 0; 
  sinfo=DoSpellModification(HUMUS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  cn = caster->name();
   if ((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  printf(BS("Die Elemente gewaehren Dir einen Blick "
             +"in die Struktur des Objektes:\n"));
  printf("------------------------------------------------"
        +"------------------------------\n");       
  if (result=ob->info(caster) || ob->QueryProp(P_INFO))
    printf(BS(result));
  else
    printf("%s birgt keine Geheimnisse.\n",
           ob->Name(WER));     
  if(ob->QueryProp(P_MAGIC))
     printf(BS(CAP(ob->QueryPronoun(WER))+" ist eindeutig magisch.\n"));
  /*
  if(ob->QueryProp(P_NEVERDROP))
     printf(BS(CAP(ob->QueryPronoun(WER))+" bleibt Dir auch nach Deinem Tod "
         +"erhalten.\n"));
         */
  if(ob->QueryProp(P_CURSED) && suc>4000) {
    if(!ob->id("\druidenamulett") && !ob->id("elementarpanzer"))
       printf(BS("Auf "+ob->QueryPronoun(WEM)+" scheint ein Fluch "
           +"zu liegen!\n"));
  }
  else 
     printf("Auf "+ob->QueryPronoun(WEM)+" scheint kein Fluch zu liegen.\n");
  /* if(ob->QueryProp(P_AUTOLOADOBJ))
     printf(BS(CAP(ob->QueryPronoun(WER))+" scheint Dir auch nach einem "
             +"Weltuntergang erhalten zu bleiben.\n"));
             */
  result=GetMaterialString(ob, caster);
  printf(BS(result+"\n"));
  if(ob->QueryProp(P_ARMOUR_TYPE) || ob->QueryProp(P_WEAPON_TYPE)) {
    if(QueryMetal(ob)>0)
      printf(BS(sprintf("Du kannst %s aufgrund des hohen Metallgehaltes "
           +"nur erschwert oder gar nicht benutzen.\n", ob->name(WEN))));
  }
  printf("------------------------------------------------"
        +"------------------------------\n");
  return ERFOLG;
}

   

int feuerwusel(object caster, mapping sinfo) {
  object l;

  if(caster->InFight()) {
    printf(BS("Du kannst Dich nicht auf die Muster des Zaubers "
              +"konzentrieren."));
    return 0;  
  }
  sinfo=DoSpellModification(FEUER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  
  printf("Du konzentrierst Dich...\n");
  if(QueryOwnCreature(caster, 1, 0)) {
    printf("Du hast schon einen Feuerwusel.\n");
    return 0; 
  }
  say(sprintf("%s scheint sich zu konzentrieren.\n", 
      capitalize(caster->name())));
  if(SpellSuccess(caster,sinfo)<=0)
    return MISSERFOLG;

  printf(BS("Wie aus dem Nichts erscheint ein kleiner Feuerwusel, "
         +"der Dir von nun an folgt und Licht spendet.\n"));
  say(sprintf(BS("Ploetzlich erscheint ein kleiner Feuerwusel, der "
         +"%s folgt und Licht spendet.\n"),  capitalize(caster->name())));
  l=clone_object(NPC("feuerwusel"));
  l->move(environment(caster), M_NOCHECK|M_SILENT); 
  l->SetProp(P_MSGOUT, "wuselt hinter "+caster->QueryProp(P_NAME)+" her");
  l->SetProp(ELEMENTAL_CASTER, caster);
  caster->AddPursuer(l);
  l->start_remove(caster->QueryProp(P_GUILD_LEVEL)*50);
  return ERFOLG;
}


int elementarpanzer_check(object caster, mapping sinfo) {
  if(caster->InFight()) {
    printf(BS("Du kannst Dich nicht auf die Muster des Zaubers "
       +"konzentrieren."));
    return 0;
  }
  if(CheckArmour(caster)) {
    printf("Du hast Doch schon eine Ruestung an!\n");
    return 0;
  }
  if(present("elementarpanzer", caster)) {
    printf("Du hast schon einen Elementarpanzer.\n");
    return 0;
  }
  return 1;
}

int elementarpanzer(object caster, mapping sinfo) {
  object l;
  int aclass, suc;

  if(CheckArmour(caster)) {
    printf("Du hast Doch schon eine Ruestung an!\n");
    return 0;
  }
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  printf("Du rufst die Elemente an und konzentrierst Dich auf "
         +"die Form einer Ruestung...\n");
  say(sprintf("%s scheint sich zu konzentrieren und fuehrt seltsame "
          +"Bewegungen aus.\n", capitalize(caster->name())));
  if(suc=SpellSuccess(caster,sinfo)<=0) {
    if(suc<-2000) {
      printf(BS("Um Dich herum formt sich ein Panzer, doch vermag er "
              "Dich nicht zu schuetzen.\n"));
      say(sprintf(BS("Um %s materialisiert sich ein Panzer aus "
          +"den Elementen selbst!\n"),  capitalize(caster->name())));
      l=clone_object("/gilden/druidenzirkel/armour/e_panzer");
      l->SetProp(P_WC, 1);
      l->move(TP, M_NOCHECK); 
      l->DoWear(1);   
      l->NegativeProtection(suc, 1);
      l->panzer_weg(500);
    }        
    return MISSERFOLG;
  } 
  printf(BS("Durch Deine Konzentration formen Deine Gedanken einen Panzer "
       +"aus Eis, Luft, Feuer, Erz und Wasser und Humus."));
  say(sprintf(BS("Um %s materialisiert sich ein Panzer aus "
          +"den Elementen selbst.\n"),  capitalize(caster->name())));
  l=clone_object("/gilden/druidenzirkel/armour/e_panzer");
  if((aclass=(TP->QueryAttribute(A_INT))/2+ (TP->QueryProp(P_GUILD_LEVEL)))>40)
     aclass=40;
  l->SetProp(P_AC, aclass);
  l->SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:(int)aclass/10,
       T_HEAT_PROT:(int)aclass/10]));
  l->move(TP, M_NOCHECK); 
  l->DoWear(1);   
  l->SetProp(P_CURSED, 1);
  l->NegativeProtection(0,0);
  l->panzer_weg(caster->QueryProp(P_GUILD_LEVEL)*aclass);
  return ERFOLG;
}


int laehme(object caster, mapping sinfo) {
  object victim;
  int dauer, suc, speed, size;
  string cn, vn;

  if(!caster->InFight()) {
    printf(BS("Ausserhalb eines Kampfes kannst Du "
                 +"niemanden laehmen!"));
    return 0;  
  }
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wen willst Du laehmen?\n");
  if(!victim) return 0;
  if((size=victim->QueryProp(P_SIZE))<1) 
    size=1;
  sinfo[SI_RAW_SPELLCOST]+=((size-200)/10)+random(10);
  if(sinfo[SI_RAW_SPELLCOST]>130) sinfo[SI_RAW_SPELLCOST]=130;
  if(sinfo[SI_RAW_SPELLCOST]<10) sinfo[SI_RAW_SPELLCOST]=10;

  sinfo=DoSpellModification(HUMUS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  cn=caster->name();
  vn=victim->name(WEN, 2);
  dauer = (int)(1.5 * (caster->QueryAttribute(A_INT) + 
               random(sinfo[SI_SKILLABILITY]/1000)));
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    if(suc<-500) {
      printf("Irgendwie wird alles soooooo zaeh...\n");
      say(sprintf("%s bewegt sich so schnell wie in Honig.\n",cn), caster);
      caster->ModifySkillAttribute(caster,SA_SPEED,60,dauer);
    }        
    return MISSERFOLG;
  } 
  switch (suc) {
    case 0..5000:      speed=75; break;
    case 5001..14000:   speed=50; break;
    case 14001..18000:  speed=30; break;
    case 19001..20000: speed=20; break;
    default: speed=100;
  } 
  //tell_object(find_player("angrox"), sprintf("\nLaehme von %s: %d\n",
  //         CAP(getuid(caster)),suc));
  printf("Magische Ranken springen empor und behindern %s.\n", vn);
  tell_object(victim,sprintf("%s laehmt Dich.\n", cn));
  say(BS(sprintf("%s beschwoert magische Ranken aus dem Bodem, die %s "
      +"behindern.\n",cn, vn)), victim);
  victim->ModifySkillAttribute(caster,SA_SPEED,speed,dauer);
  return ERFOLG;
}

int dzuecke(object caster, mapping sinfo) {
  object weapon, damulett;
  string cn;

  if(!sinfo[SI_SKILLARG]) {
    printf("Welche Metallwaffe moechtest Du zuecken?\n"); 
    return 0;
  }
  if(!(weapon=present(sinfo[SI_SKILLARG], caster))) {
    printf("Welche Metallwaffe moechtest Du zuecken?\n"); 
    return 0;
  }
  sinfo=DoSpellModification(HUMUS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  cn=caster->name();
  damulett=present("\ndruidenamulett", caster);
  printf("Du konzentrierst Dich ...\n");
  say(sprintf("%s scheint sich zu konzentrieren...\n",cn), caster);
  if(SpellSuccess(caster,sinfo)<=0) {
    printf("...aber nichts passiert.\n");
    say(sprintf("...aber nichts passiert.\n",cn), caster);
    return MISSERFOLG;
  }  
  printf(BS("...und eine schimmernde Aura bildet sich um Deine Hand. "
      "Nun kannst Du die Metallwaffe zuecken.\n"));
  say(sprintf("...und eine schimmernde Aura bildet sich um %se Hand.\n",
        caster->QueryPossPronoun(WESSEN)), caster);
  call_other(damulett, "AllowMetalWeapon",weapon, 10);
  return ERFOLG;
}



//
// ELEMENTARHAND
//
int elementarhand_check(object caster, mapping sinfo) {
  if(!caster->InFight() && caster->QueryProp(P_GUILD_LEVEL)<10) {
    printf("Nur im Kampf kannst Du Deine Haende verwandeln.\n");
    return 0;
  }
  if(caster->Query(P_HANDS, F_QUERY_METHOD)) {
    printf("Deine Haende sind bereits verwandelt.\n");
    return 0;
  }
  return 1;
}

int elementarhand(object caster, mapping sinfo) {
  object ob, amulett;
  string cn, element;
  mapping msgs;
  int suc, dam, dur;
  mixed old_dam;
 
  msgs=([
      FEUER  : " mit flammenden Haenden",
      EIS    : " mit scharfen Eiskrallen",
      HUMUS  : " mit giftigen Dornenhaenden",
      WASSER : " mit gigantischen Wasserfaeusten",
      LUFT   : " mit der Kraft eines Wirbelsturms",
      ERZ    : " mit toetlichen Stahldornen",
      GEIST  : " mit Haenden aus reinster Magie"
      ]);
 
  ob=present("\ndruidenamulett", caster);
  
  element=call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster));
  sinfo=DoSpellModification(element, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  cn = caster->name();
  say(sprintf("%s reibt die Haende aneinander...\n", cn));
  printf("Du reibst Deine Haende aneinander...\n");
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    say(sprintf("...doch nur kleine schwarze Kruemel fallen zu Boden.\n"));
    printf("...doch nur kleine schwarze Kruemel fallen zu Boden.\n");
    return MISSERFOLG;
  }        
  ob->DoSetHands();
  old_dam=caster->QueryProp(P_HANDS)[2];
  if(pointerp(old_dam)) old_dam=old_dam[0];
  dam=25+caster->QueryProp(P_HANDS)[1]+suc*(2*caster->QueryAttribute(A_INT)+
        caster->QueryAttribute(A_DEX)+
        caster->QueryAttribute(A_STR))/MAX_ABILITY;
  if(dam<30) dam=30;
  if(dam>150) dam=150;
  dur=caster->QueryProp(P_GUILD_LEVEL)*5+25*suc/MAX_ABILITY;
  //TELL("angrox", sprintf("%s+++%sFH: %s, dam: %d, dur: %d, cst: %d, suc: %d, "
  //    "hnds: %d\n",
  //    ANSI_RED, ANSI_NORMAL, getuid(caster),dam, dur,sinfo[SI_RAW_SPELLCOST],
  //    suc, caster->QueryProp(P_HANDS)[1]));
  
  // Bis das debuggt ist gibts nur magischen Schaden (bug in mudlib, wenn 
  // ein phsy. dabei ist -> nur phys.
  //caster->SetProp(E_HANDS, ({msgs[element], dam, ({ELEMENT_DAMAGE[element], 
  //         old_dam, })}));
  caster->SetProp(E_HANDS, ({msgs[element], dam, 
        ({ELEMENT_DAMAGE[element] })}));
  call_out("stop_hands", 
        (caster->QueryProp(P_GUILD_LEVEL)*5+25*suc/MAX_ABILITY), caster);
  say(sprintf("...und %s Haende sind vollkommen von dem Element %s umgeben!\n", 
                caster->name(WESSEN), CAP(element)));
  caster->Set(P_HANDS, symbol_function("myhands", TO), F_QUERY_METHOD); 
  printf(sprintf("...und Deine Haende sind komplett von dem Element %s "
        "umgeben!\n", CAP(element)));
  //if(amulett=present(DRUIDENAMULETT, caster))
  //  amulett->SetProp(P_LIGHT, 1);
  return ERFOLG;
  
}

static mixed myhands() {
  int hand_dam;
  object ob;
  ob=previous_object();
  return ob->QueryProp(E_HANDS);
}

void stop_hands(object pl) {
 object ob;
 if(pl) {
   if(ob=present("\ndruidenamulett", pl)) {
     ob->RemoveSetHands();
   //  ob->SetProp(P_LIGHT, 0);
   }
   printf("Deine Haende werden wieder normal.\n");
   say(sprintf("%s Haende werden wieder normal.\n", pl->name(WESSEN)));
   pl->Set(P_HANDS, 0, F_QUERY_METHOD);
   pl->SetProp(E_HANDS, 0);
 }
 return ;
}
/*
//||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
//||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
// HEILER SPELLS
//||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
//||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
*/
int behandle(object caster, mapping sinfo) {
  object victim;
  int hands;
  string vn, vnw, cn;
  int suc, heal;
  victim=FindVictim(sinfo[SI_SKILLARG],caster,
              BS("Wen willst Du behandeln?"));
  if (!victim)
    return 0;
  // 1999-12-13: NPCs koennen geheilt werden, vorausgesetzt
  // P_FRIEND ist nicht gesetzt.
  if(victim->QueryProp(P_FRIEND) && !interactive(victim)) {
    printf(BS("Du kannst dieses Ding nicht heilen."));
    return 0;
  }
  // 1999-12-13: Gegner, gegen die man kaempft kann man nicht heilen
  if (victim->IsEnemy(TP))
    {
    printf(BS("Du kannst Deine Feinde nicht behandeln !"));
    return 0;
    }
  if(IS_WIZARD(victim)) {
    printf(BS("Es ist vielleicht keine gute Idee, einen Magier "
         +"zu behandeln."));
    return 0;
  }
  if(victim->QueryProp(P_TESTPLAYER)) {
    printf(BS("Du kannst keine Testspieler heilen."));
    return 0;
  } 
  if(victim->QueryGuest()) {
    printf(BS("Der Zauber ist misslungen. Seltsam."));
    return 1;
  }
  if(victim->QueryProp(P_HP)==victim->QueryProp(P_MAX_HP)) {
    printf(BS("Du kannst keine Gesunden heilen!"));
    return 1;
  }
  sinfo=DoSpellModification(HUMUS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  cn = caster->name();
  vnw = victim->name(WEN, 2);
  if ((suc=SpellSuccess(caster,sinfo))<=0) {
    if(suc<(-2500)) {
      if(victim==caster) {
        say(sprintf("%s versucht sich zu heilen, jedoch entstehen nur "
                   +"mehr eitrige Wunden!\n",cn), victim);
        printf("Du versuchst Dich zu heilen, jedoch entstehen nur noch "
              +"mehr eitrige Wunden.\n");
        if(!random(20)) {
          printf(BS("Irgendwie fuehlst Du Dich krank."));
          caster->AddPoison(4);
              }
            }
      else {
        say(sprintf("%s versucht %s zu heilen, jedoch entstehen nur "
                       +"mehr eitrige Wunden!\n",cn, vnw), victim);
        printf("Du versuchst %s zu heilen, jedoch entstehen nur noch "
               +"mehr eitrige Wunden.\n", vnw);
        tell_object(victim,sprintf("%s versucht Dich zu heilen, "
                +"jedoche entstehen eitrige Wunden.\n",cn));
        if(!random(30)) {
          tell_object(victim, sprintf("Irgendwie fuehlst Du Dich "
                                 +"krank."));
          victim->AddPoison(4);
        } 
      } 
      victim->reduce_hit_point(-suc/500);
      if(victim != caster) {
        printf(BS("Durch den misslungenen Spruch verlierst auch Du "
               +"Lebenspunkte."));
        caster->reduce_hit_point(-suc/200);
        if(!random(30)) {
          printf(BS("Irgendwie fuehlst Du Dich krank."));
          caster->AddPoison(2);
        }
      }
    }
    return MISSERFOLG;
  }
  //printf(suc+"/"+MAX_ABILITY+"\n");
  heal=(int)(caster->QueryProp(P_GUILD_LEVEL)+caster->QueryAttribute(A_INT)*
      suc/(2*MAX_ABILITY));
  if(heal<15) heal=15;
  if(heal>40) heal=40;
  if(victim->id("anvar")) heal*=2;
  victim->AddHp(heal);  
  if(victim==caster) {
    say(sprintf("%s heilt sich.\n",cn), victim);
    printf("Du heilst Dich.\n");
  } 
  else {
    say(sprintf("%s heilt einen Teil der Wunden von %s.\n",
          capitalize(cn), victim->name(WEM)), victim);
       
    printf("Du heilst %s.\n", vnw);
    tell_object(victim,sprintf("%s heilt einen Teil Deiner Wunden.\n",
          capitalize(cn))); 
  }
  return ERFOLG;
}



