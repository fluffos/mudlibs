/*
//
// DIV. FUNCTIONS
//
*/

/* Fuer den Elementarruestung-Spell */
static int CheckArmour(object caster) {
 object *worn_armours;
 int i;
 worn_armours=caster->QueryProp(P_ARMOURS);
 if(sizeof(worn_armours)==0) return 0;
 for(i=sizeof(worn_armours)-1;i>=0;i--)
   if(worn_armours[i] && (worn_armours[i]->QueryProp(P_ARMOUR_TYPE))==AT_ARMOUR)
     return 1;
return 0;
}


static mapping
DoSpellModification(string element,object caster,mapping sinfo) {
  mapping t_env;
  string *filename, caster_element, comp_element;
  string *d_domain, *d_komp_domain, *race_elements;
  int *t_type, *t_comp_type, difficult_modifier, align, kosten, var;
  float cost_modifier, damage_modifier, fatigue_modifier;
  object amulett;
  
  cost_modifier=1.0;
  difficult_modifier=0;
  damage_modifier=1.0;
  fatigue_modifier=1.0;
  kosten=sinfo[SI_RAW_SPELLCOST];
  amulett=present(DRUIDENAMULETT, caster);
  race_elements=({});
  t_env=environment(caster)->QueryProp(P_ENVIRONMENT);
  filename=explode(file_name(environment(caster)), "/");
  caster_element=call_other(DRUIDENMASTER, "GetDruidElement", caster);
  align=caster->QueryProp(P_ALIGN);

  switch(caster->QueryProp(P_RACE)) {
    case "Zwerg": race_elements=E_DWARF; break;
    case "Elf"  : race_elements=E_ELF; break;
    case "Mensch": race_elements=E_HUMAN; break;
    case "Hobbit": race_elements=E_HOBBIT; break;
    case "Dunkelelf": race_elements=E_DARKELF; break;
    case "Oger": race_elements=E_OGRE; break;
    case "Fee": race_elements=E_FAIRY; break;
    default: race_elements=E_DEFAULT;            
  }
  switch (element) {
    case FEUER:  d_domain=D_FEUER;
                 d_komp_domain=D_WASSER;
                 t_type=TT_FEUER;
                 t_comp_type=TT_WASSER;
                 comp_element=WASSER;
                 break;
    case WASSER: d_domain=D_WASSER;
                 d_komp_domain=D_FEUER;
                 t_type=TT_WASSER;
                 t_comp_type=TT_FEUER;
                 comp_element=FEUER;
                 break;
    case ERZ:    d_domain=D_ERZ;
                 d_komp_domain=D_LUFT;
                 t_type=TT_ERZ;
                 t_comp_type=TT_LUFT;
                 comp_element=LUFT;
                 break;
    case LUFT:   d_domain=D_LUFT;
                 d_komp_domain=D_ERZ;
                 t_type=TT_LUFT;
                 t_comp_type=TT_ERZ;
                 comp_element=ERZ;
                 break;
    case EIS:    d_domain=D_EIS;
                 d_komp_domain=D_HUMUS;
                 t_type=TT_EIS;
                 t_comp_type=TT_HUMUS;
                 comp_element=HUMUS;
                 break;
    case HUMUS:  d_domain=D_HUMUS;
                 d_komp_domain=D_EIS;
                 t_type=TT_HUMUS;
                 t_comp_type=TT_HUMUS;
                 comp_element=EIS;
                 break;
    default:     d_domain=({});
                 d_komp_domain=({});
                 t_type=({});
                 t_comp_type=({});
                 comp_element="";
  } 
  //TERRAIN
  if(member_array(t_env[ENV_TERRAIN], t_type)!=-1 || 
      ENV(caster)->QueryProp(P_ELEMENTAL_ROOM)==t_type || 
      (caster_element=="geist" && !random(2) && amulett->QueryGhost())) 
  {
    cost_modifier+=-0.1;
    difficult_modifier+=-50;
    damage_modifier+=0.1;
    fatigue_modifier+=-0.1;
  } 
  else if((member_array(t_env[ENV_TERRAIN], t_comp_type)!=-1 || 
      ENV(caster)->QueryProp(P_ELEMENTAL_ROOM)==t_comp_type) &&
      caster_element!="geist") 
  {
    cost_modifier+=0.15;
    difficult_modifier+=50;
    damage_modifier+=-0.15;
    fatigue_modifier+=0.1;
  }
  //REGION
  if(getuid(caster)==DebugName)
    TELL("angrox", sprintf("TP:%s, SP: %s, Ter:%.4f, ", DebugName, 
          sinfo[SI_SPELLNAME],cost_modifier));
  if(filename[1]) {
    if(member_array(filename[1], d_domain)!=-1 || 
        (caster_element=="geist" && !random(2) && amulett->QueryGhost())) 
    {
      cost_modifier+=-0.15;
      difficult_modifier+=-50;
      damage_modifier+=0.1;
      fatigue_modifier+=-0.2;
    }
    else if(member_array(filename[1], d_komp_domain)!=-1 &&
        caster_element!="geist") 
    {
      cost_modifier+=0.15;
      difficult_modifier+=50;
      damage_modifier+=-0.1;
      fatigue_modifier+=0.2;
    } 
  }
  //RASSEN
  if(getuid(caster)==DebugName)
    TELL("angrox", sprintf("Reg:%.4f, ", cost_modifier));
  if(race_elements && caster_element!="geist") {
    if(member_array(element, race_elements[0])!=-1) {
      cost_modifier+=-0.15;
      fatigue_modifier+=-0.1;
    }
    else if(member_array(element, race_elements[1])!=-1){
      cost_modifier+=0.25;
      fatigue_modifier+=0.1;
    }
  }
  //ELEMENT
  if(getuid(caster)==DebugName)
    TELL("angrox", sprintf("Ras: %.4f, ", cost_modifier));
  if(element==caster_element || (caster_element=="geist" && 
      amulett->QueryGhost() && !random(2))) 
  {
    cost_modifier+=-0.25;
    difficult_modifier+=-50;
    damage_modifier+=0.2;
    fatigue_modifier+=-0.2;
  }
  else if(comp_element==caster_element && caster_element!="geist") {
    cost_modifier+=0.25;
    difficult_modifier+=50;
    damage_modifier+=-0.3;
    fatigue_modifier+=0.2;
  }
  // MAGIC ITEM
  cost_modifier-=CheckElementalItem(caster,element);
  if(getuid(caster)==DebugName)
    TELL("angrox", sprintf("Ele. Item: %.4f, ", cost_modifier));
  //ALIGN
  if(getuid(caster)==DebugName)
    TELL("angrox", sprintf("Ele: %.4f, ", cost_modifier));
  if((align<-500) || (align>500)) {
    align=(align<0?-align:align);
    cost_modifier+=((float)align-500)/1000; 
  }
  if(getuid(caster)==DebugName)
    TELL("angrox", sprintf("Ali: %.4f, ", cost_modifier));
  if(cost_modifier<0.3) cost_modifier=0.3;
  if(cost_modifier>1.5) cost_modifier=1.5;
  
  if(caster->QueryProp(P_BLIND)) 
    cost_modifier+=0.5;
  
  if(getuid(caster)==DebugName)
    TELL("angrox", sprintf("Bli: %.4f, ", cost_modifier));
  
  if(var=amulett->QueryWornMetal()) {
    cost_modifier+=(float)var/1000;
    fatigue_modifier+=(float)var/1500;  
  }
  kosten=(int)(kosten*cost_modifier);
  if(getuid(caster)==DebugName)
  TELL("angrox", sprintf("Met: %.4f, SP/SP_old: %d/%d\n", cost_modifier, kosten, 
        sinfo[SI_RAW_SPELLCOST]));
  if(caster->QueryProp(P_GUILD_LEVEL)>14)
    if(sinfo[SI_SKILLRESTR_LEARN][P_GUILD_LEVEL] > 9)
      kosten-=caster->QueryProp(P_GUILD_LEVEL)-14;
  
  sinfo[SI_RAW_SPELLCOST]=kosten; 
  if(caster->QueryProp(P_GUILD_LEVEL)==15) 
    sinfo+=([SI_NOMAGIC: 5]);
  if(caster->QueryProp(P_GUILD_LEVEL)==16)
    sinfo+=([SI_NOMAGIC: 10]);

  
  //sinfo[SI_DIFFICULTY]=(int)(sinfo[SI_DIFFICULTY]+difficult_modifier);
   
  if(sinfo[SI_SKILLDAMAGE]) {
    if(damage_modifier<0.5) damage_modifier=0.5;
    if(damage_modifier>1.4) damage_modifier=1.4;
    sinfo[SI_SKILLDAMAGE]=(int)(sinfo[SI_SKILLDAMAGE]*damage_modifier);
  } 
  if(!sinfo[SI_SPELLFATIGUE]) sinfo[SI_SPELLFATIGUE]=2;
  if((sinfo[SI_SPELLFATIGUE]=(int)(sinfo[SI_SPELLFATIGUE]*fatigue_modifier))<2)
        sinfo[SI_SPELLFATIGUE]=2;
  return sinfo;
}

float CheckElementalItem(object pl, string element) {
  object *obj;
  int i, value;
  mixed h;
  value=0;
  if(!objectp(pl)) return 0.0;
  obj=pl->QueryProp(P_ARMOURS);
  if(!sizeof(obj)) return 0.0;
  for(i=sizeof(obj)-1;i>=0;i--) {
    if(h=obj[i]->QueryProp(P_ITEMD_ELEMENTAL_VALUE)) {
      if(intp(h) ) value+=h;
      else if( mappingp(h) ) value+=h[element];
    }
  }
  return value/100.0;
}

/* Hier wird geprueft, ob der Spell gesprochen werden darf */
static CheckIfSpellAllowed(object caster) {
  object ob, weapon, *armours;
  int var;
  if(caster->QueryProp(P_FROG)) {
    printf(BS("Wahhhhhh. Ein Frosch! Als Frosch kannst Du "
        +"nicht zaubern!\n"));
    return "";
  }
  if(caster->QueryProp(P_GHOST)) {
    printf(BS("Buaaahhhhh. Ein Geist! Als Geist kannst Du "
        +"nicht zaubern!\n"));
    return "";
  }
  /*
  if(caster->QueryProp(P_BLIND) && caster->QueryProp(P_GUILD_LEVEL)<16) { 
    printf(BS("Blind kannst Du nicht zaubern!\n"));
    return "";
  }
  */
  if(!ob=present("\ndruidenamulett", TP)) {
    printf(BS("Ohne das Druidenamulett kannst Du nicht zaubern!\n"));
    write_secure_log(sprintf("%s versucht ohne Amulett zu zaubern!\n", 
          CAP(getuid(caster))));
    return "";
  }
  if(ob->QueryVersion()!=LATEST_AMULET_VERSION) {
    printf(BS("Dein Amulett scheint abgenutzt zu sein! Du solltest "
         "Dir ein Neues von Anvar holen! (frag anvar nach neuem amulett)"));
    return ""; 
  }
  if((var=QueryMetal(caster)) > (caster->QueryProp(P_GUILD_LEVEL)*20)) {
    printf("Mit soviel Metall am Koerper kannst Du nicht zaubern!\nDer "
        "Versuch zu Zaubern erschoepft Dich!\n");
    caster->AddHp(-random(20));
    caster->SetProp(P_NEXT_SPELL_TIME, time()+(int)var/10);
    ob->SetWornMetal(var); // uebergeben des Metalls an das Amulett
    return "";
  }
  ob->SetWornMetal(var); // uebergeben des Metalls an das Amulett
  if(ob->QueryProp(P_WORN)!=caster) {
    printf(BS("Du musst das Amulett schon tragen, wenn Du zaubern "
        "willst"));
    return "";
  }
  if(!call_other(DRUIDENMASTER, "CheckPreviousTasks", caster,
     caster->QueryProp(P_GUILD_LEVEL)-1) && !IS_WIZARD(caster) &&
     !caster->QueryProp(P_TESTPLAYER))
  {
   //printf(BS("Du kannst nicht zaubern! Komisch, oder?\n"));
    if(find_player("angrox"))
      tell_angrox(sprintf("%s hat nicht alle Aufgaben fuer Level %d!\n", 
          CAP(getuid(caster)), caster->QueryProp(P_GUILD_LEVEL)));
     write_secure_log(sprintf("%s hat nicht alle Aufgaben fuer Level %d!\n", 
          CAP(getuid(caster)), caster->QueryProp(P_GUILD_LEVEL)));
  } 
  return 0;
}

// 
// Ueberpruefen auf verbotenes metall
// Es kann sowohl ein Living wie auch ein Objekt angegeben werden.
// Rueckgabewert: Metall in Gramm;
//
int QueryMetal(object ob) {
  object *items;
  int total_metal, i,j,x,rtn;
  mapping mat_map;
  string *mat, *fm;
  fm=FORBIDDEN_METAL;
  items=({});
  if(living(ob)) {
    items=({ ob->QueryProp(P_WEAPON) });
    if(sizeof(ob->QueryProp(P_ARMOURS)))
      items+=ob->QueryProp(P_ARMOURS);
    items-=({0});
  }
  else items+=({ob});
  if(!sizeof(items)) return 0;
  for(i=sizeof(items)-1;i>=0;i--) {
    if(items[i]->QueryMaterialGroup(MATGROUP_METAL) &&
        !items[i]->id(DRUID_ALLOWED_METAL_ITEM)) 
    {
      mat_map=items[i]->QueryProp(P_MATERIAL);
      mat=m_indices(mat_map);
      for(j=sizeof(mat)-1;j>=0;j--) {
        if((x=member(fm, mat[j]))!=-1)
          total_metal+=(int)((float)(items[i]->QueryProp(P_WEIGHT)/100)*
            mat_map[fm[x]]);
      }
    }          
  }
  return total_metal; // getragenes Metall in Gramm
}

/*Was besteht woraus?*/
string GetMaterialString(object ob, object caster) {
  string *mat_indices, *mat_values, result;
  mapping material;
  int i;

  result=CAP(ob->QueryPronoun(WER))+" besteht ";
  material=ob->QueryProp(P_MATERIAL);
  mat_values=m_values(material);
  mat_indices=m_indices(material);
  for(i=sizeof(mat_values)-1; i>=0; i--) {
    switch(mat_values[i]) {
      case -100..-1: result+="aus Anti-";
                         break;
      case 0: continue;
            case 1..20:  result+="zu einem geringen Anteil aus ";
                        break;
      case 21..40: result+="zu einem maessigen Anteil aus ";
                        break; 
      case 41..60: result+="etwa zur Haelfte aus "; 
                        break;
      case 61..80: result+="zum Grossteil aus ";
                        break;
      case 81..99: result+="fast ausschliesslich aus ";
                        break;
      case 100:    result+="vollstaendig aus ";
                        break;
      default:     result+="zu einem undefinierbaren Anteil aus ";
    }        
    result+=MATERIALDB->MaterialName(mat_indices[i],WEM,caster);
    if(i>1) result+=", ";
    else if(i==1) result+=" und ";
    else if(i==0) result+=".";
  } 
  return result;
}



/*
//
// Hier wird das Elementar geclont und die Werte berechnet
//
*/
object CreateElemental(object caster, int suc, string element) {
  object e;
  int level, time, e_defends, hands;
  string long;
  e=clone_object(NPC("elementar"));
  if(element=="feuer") {
    e->create_default_npc((level=caster->QueryProp(P_GUILD_LEVEL)+random(10)));
    e->SetProp(P_HANDS, ({" mit Feuerhaenden", level*17, DT_FIRE}));
    e->SetProp(ELEMENTAL_CASTER, caster);
    e->SetProp(P_MSGIN, "schwebt herein");
    e->SetProp(P_DIE_MSG, " erlischt.\n");
    e->SetProp(P_SHORT, "Ein Feuerelementar");
    e->SetProp(P_NAME, "Feuerelementar");
    e->SetProp(P_XP, 0);
    e->SetProp(P_LIGHT, 1);
    e->SetProp(P_BODY, level*7);
    e->SetProp(P_FRIEND, 1);
    e->SetProp(P_NO_GLOBAL_ATTACK, 1);
    e->AddId("feuerelementar");
    e->SetProp(E_REMOVE_MSG, "Das Feuerelementar loest sich auf.\n");
    e->SetProp(P_KILL_NAME, "Ein Feuerelementar");
    e->set_time((int)(2*caster->QueryAttribute(A_INT)*(1+3*suc/MAX_ABILITY)+
               2*caster->QueryProp(P_GUILD_LEVEL)));
    e->set_element(CAP(element));
    //caster->AddDefender(e);
  }
  else if(element=="wasser") {
    e->create_default_npc((level=caster->QueryProp(P_GUILD_LEVEL)+
        random(11)+1));
    e->SetProp(P_HANDS, ({" mit einer Flutwelle", level*10, DT_WATER}));
    e->SetProp(ELEMENTAL_CASTER, caster);
    e->SetProp(P_MSGIN, "fliesst herein");
    e->SetProp(P_DIE_MSG, " zerrinnt.\n");
    e->SetProp(P_SHORT, "Ein Wasserelementar");
    e->SetProp(P_NAME, "Wasserelementar");
    e->SetProp(P_XP, 0);
    e->SetProp(P_BODY, level*10);
    e->SetProp(P_FRIEND, 1);
    e->SetProp(P_NO_GLOBAL_ATTACK, 1);
    e->AddId("wasserelementar");
    e->SetProp(E_REMOVE_MSG, "Das Wasserelementar zerfliesst.\n");
    e->SetProp(P_KILL_NAME, "Ein Wasserelementar");
    e->set_time(1);
    e->SetProp(ELEMENTAL_DEFENDS,
              (int)(caster->QueryProp(P_GUILD_LEVEL)*(1+4*suc/MAX_ABILITY)));
    e->set_element(CAP(element));
  }
  else if(element=="luft") {
    e->create_default_npc((level=caster->QueryProp(P_GUILD_LEVEL)+
        random(12)+1));
    e->SetProp(P_HANDS, ({" mit einem Windstoss", level*10, DT_AIR}));
    e->SetProp(ELEMENTAL_CASTER, caster);
    e->SetProp(P_MSGIN, "weht herein");
    e->SetProp(P_DIE_MSG, " loest sich auf.\n");
    e->SetProp(P_XP, 0);
    e->SetProp(P_SHORT, "Ein Luftelementar");
    e->SetProp(P_NAME, "Luftelementar");
    e->SetProp(P_FRIEND, 1);
    e->SetProp(P_NO_GLOBAL_ATTACK, 1);
    e->AddId("luftelementar");
    e->SetProp(E_REMOVE_MSG, "Das Luftelementar loest sich auf.\n");
    e->SetProp(P_KILL_NAME, "Ein Luftelementar");
    e->SetProp(ELEMENTAL_DEFENDS,
          (int)(caster->QueryProp(P_GUILD_LEVEL)*(1+(5*(suc/MAX_ABILITY)/2))));
    e->set_element(CAP(element));
  }
  else if(element=="eis") {
    e->create_default_npc((level=caster->QueryProp(P_GUILD_LEVEL)+random(5)));
    e->SetProp(P_HANDS, ({" mit eisiger Kaelte", level*15, DT_COLD}));
    e->SetProp(ELEMENTAL_CASTER, caster);
    e->SetProp(P_MSGIN, "stapft herein");
    e->SetProp(P_DIE_MSG, " schmilzt.\n");
    e->SetProp(P_SHORT, "Ein Eiselementar");
    e->SetProp(P_NAME, "Eiselementar");
    e->SetProp(P_XP, 0);
    e->SetProp(P_BODY, level*8);
    e->SetProp(P_FRIEND, 1);
    e->SetProp(P_NO_GLOBAL_ATTACK, 1);
    e->AddId("eiselementar");
    e->SetProp(E_REMOVE_MSG, "Das Eiselementar schmilzt.\n");
    e->SetProp(P_KILL_NAME, "Ein Eiselementar");
    e->SetProp(ELEMENTAL_DEFENDS, 1);
    e->set_time((int)(2*caster->QueryAttribute(A_INT)*(1+3*(suc/MAX_ABILITY)/2)+
                2*caster->QueryProp(P_GUILD_LEVEL)));
    e->set_element(CAP(element));
  }
  else if(element=="erz") {
    e->create_default_npc((level=caster->QueryProp(P_GUILD_LEVEL)+random(6)+1));
    e->SetProp(P_HANDS, ({" mit staehlener Faust", level*14, 
               ({DT_MAGIC,DT_BLUDGEON})}));;
    e->SetProp(ELEMENTAL_CASTER, caster);
    e->SetProp(P_MSGIN, "stapft herein");
    e->SetProp(P_DIE_MSG, " verschwindet in der Erde.\n");
    e->SetProp(P_XP, 0);
    e->SetProp(P_SHORT, "Ein Erzelementar");
    e->SetProp(P_NAME, "Erzelementar");
    e->SetProp(P_BODY, level*15);
    e->SetProp(P_FRIEND, 1);
    e->SetProp(P_NO_GLOBAL_ATTACK, 1);
    e->AddId("erzelementar");
    e->SetProp(E_REMOVE_MSG, "Das Erzelementar verschwindet im Boden.\n");
    e->SetProp(P_KILL_NAME, "Ein Erzelementar");
    e->SetProp(ELEMENTAL_DEFENDS, 
           (int)(caster->QueryProp(P_GUILD_LEVEL)*(1+4*suc/MAX_ABILITY)));
    e->set_element(CAP(element));
  }
  else if(element==HUMUS) {
    e->create_default_npc((level=caster->QueryProp(P_GUILD_LEVEL)+random(6)+1));
    e->SetProp(P_HANDS, ({" mit Giftstacheln", level*14, 
               ({DT_POISON})}));;
    e->SetProp(ELEMENTAL_CASTER, caster);
    e->SetProp(P_MSGIN, "stapft herein");
    e->SetProp(P_DIE_MSG, " verschwindet in der Erde.\n");
    e->SetProp(P_XP, 0);
    e->SetProp(P_SHORT, "Ein Humuselementar");
    e->SetProp(P_NAME, "Humuselementar");
    e->SetProp(P_BODY, level*15);
    e->SetProp(P_FRIEND, 1);
    e->SetProp(P_NO_GLOBAL_ATTACK, 1);
    e->AddId("humuselementar");
    e->SetProp(E_REMOVE_MSG, "Das Humuselementar verschwindet im Boden.\n");
    e->SetProp(P_KILL_NAME, "Ein Humuselementar");
    e->SetProp(ELEMENTAL_DEFENDS, 
           (int)(caster->QueryProp(P_GUILD_LEVEL)*(1+4*suc/MAX_ABILITY)));
    e->set_element(CAP(element));
  }
  e->SetProp(P_LONG, Set_P_LONG(element));
  return e;
}

string Set_P_LONG(string element) {
  string long;
  if(!element) return "";
  long="Das ist halt so ein Elementar.";
  switch(lower_case(element)) {
    case "luft": long="Das Luftelementar sieht wie eine kleine "
               +"Windhose aus. Durch ihre rapiden Drehungen verursacht "
               +"sie einen starken Wind.";
                 break;
    case "wasser": long="Das Wasserelementar sieht wie eine riesige, "
                    +"aus durchscheinenden Wasser gebildete Gestalt aus. "
                    +"In seiner Naehe ist das Rauschen des Meeres zu "
                    +"hoeren. Es ist etwa zwei Schritt hoch.";
                 break;
    case "erz": long="Das Erzelementar ist eine Gestalt aus reinstem "
                 +"Erz, mit rubinernen Augen und Gold als Haaren. Durch seine "
                 +"Adern fliesst reinstes Quecksilber.";
                 break;
    case "feuer": long="Das Feuerelementar sieht wie eine riesige, "
                     +"flammenumwaberte Gestalt aus. Es ist etwa " 
                     +"zwei Schritt hoch und es strahlt eine enorme " 
                     +"Hitze ab.";
                 break;
    case "eis":  long="Das Eiselementar ist eine riesige, zwei "
                 +"Schritt hohe Gestalt aus purem Eis, von der eine "
                 +"toedliche Kaelte ausgeht.";
                 break;
    case "humus":long="Das Humuselementar besteht vollkommen aus Erde, "
                  "Laub und Dornenranken. Es ueberragt Dich um Laengen. "
                  "Eine eigentuemliche Kraft des Lebens geht von ihm aus, "
                  "ja Du spuerst diese Kraft sogar.";
                 break;
  } 
  return long;
}



/*
//
// Ueberpruefung ob schon eine eigene Kreatur da ist 
//
*/
int QueryOwnCreature(object caster, int flag, int what) {
  object *inv;
  int i, value;
  string ident;
  value=0;
  if(!flag)
    ident="elementar";
  else ident="feuerwusel";
  inv=filter_array(all_inventory(ENV(caster)), "filter_func", TO, ident);
  inv+=filter_array(caster->QueryPursuers(), "filter_func",TO,ident);
  //TELL("angrox", sprintf("%O\n", inv));
  for(i=sizeof(inv)-1;i>=0;i--) {
    if(objectp(inv[i]) && living(inv[i]) && inv[i]->QueryProp(P_IDS) &&
       member(inv[i]->QueryProp(P_IDS), ident)!=-1)
      switch(what) {
        // Es steht schon ein Teil von dem caster rum
        case 0:if(inv[i]->QueryProp(ELEMENTAL_CASTER)==caster)
                       value++;
               break;
        // Das ist sein eigenes Teil
        case 1:if(inv[i]->QueryProp(ELEMENTAL_OWNER)==caster)
                       value++;
               break;
        // Er hat hat schon ein Teil
        // 1999-12-13: Ein verschenktes elementar hindert nichtmehr
        //             am beschwoeren eines neuen <iwo>
        case 2:if((!inv[i]->QueryProp(ELEMENTAL_OWNER) 
                    && inv[i]->QueryProp(ELEMENTAL_CASTER)==caster) ||
                  inv[i]->QueryProp(ELEMENTAL_OWNER)==caster)
                       value++;
               break;
      } 
  } 
  if(value>1) 
     write_secure_log(sprintf("%d %s , CST: %O, ENV:%O\n", value, 
         CAP(ident), caster, environment(caster)));
  return value;
}


int filter_func(object ob, string ident) {
  if(ob->id(ident)) return 1;
  return 0;
}

/*
// Man soll auch lernen, wenn der Zauber gelungen ist.
// Der Wert ist vom Skill im Zaubern abhaengig. Eine Ausgabe
// "Du lernst..." erfolgt nicht, die Spieler sollen gefaelligst
// selbst draufkommen
// Weiters besteht die Chance etwas zu verlernen, wenn man mehr
// als 33% MAX_ALC hat
*/

void Erfolg(object caster, string spell, mapping sinfo) {
  int new_abil, abil, alc, maxalc, modifier, cast;
  modifier=0;
  
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "druidenzirkel");
  abil=sinfo[SI_SKILLABILITY];
  
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "CheckAbility", caster, spell, 
              sinfo[SI_SKILLABILITY]);
  
  if(alc=caster->QueryProp(P_ALCOHOL)) 
    modifier-=alc/8;
  
  if(!random(20) && abil<10000) {
    if((cast=caster->QuerySkillAbility("Cast"))>6000)
      modifier+=(cast-6000)/200; 
    new_abil=abil+modifier+random(5)+1;
    if(new_abil>10000) {
      new_abil=10000;
      tell_object(caster, sprintf("Du kannst %s nun perfekt!\n", CAP(spell)));
    }
    caster->ModifySkill(spell, ([SI_SKILLABILITY: new_abil ]), 0, 
        "druidenzirkel");
  }
  else if(modifier) {
    new_abil=abil+modifier;
    if(new_abil<1) 
      new_abil=1;
    caster->ModifySkill(spell, ([SI_SKILLABILITY: new_abil ]), 0, 
        "druidenzirkel");
  }
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "UpdateAbility", caster, spell, 
        (caster->QuerySkillAbility(spell)));
  if(getuid(caster)=="pardona") {
      TELL("angrox", sprintf("Gelernt: %d -> %d\n", abil, new_abil));
  }
} 

/*
// Beim Misserfolg verlernt man, wenn man mehr als 25% ALC
// hat.
//
*/
void
Misserfolg(object caster, string spell, mapping sinfo) {
  int old_abil,alc, maxalc, modifier, abil, new_abil;
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "druidenzirkel");
  alc=caster->QueryProp(P_ALCOHOL);
  maxalc=caster->QueryProp(P_MAX_ALCOHOL);
  modifier=(maxalc/2)-alc;
  old_abil = sinfo[SI_SKILLABILITY];
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "CheckAbility", caster, spell, old_abil);
  if(modifier<0) {
    printf("Du lernscht nix aus <Hicks!> Deinem Fehler.\n");
    abil=old_abil+(modifier/3);
    if(abil<1) abil=1;
    caster->ModifySkill(spell, ([SI_SKILLABILITY: abil ]), 0, "druidenzirkel");
    new_abil=caster->QuerySkillAbility(spell);
    if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
      call_other(ABILMASTER, "UpdateAbility", caster, spell, new_abil);
    return;
  }
  Learn(caster, spell, sinfo);
  new_abil=caster->QuerySkillAbility(spell);
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "UpdateAbility", caster, spell, new_abil);
  if (old_abil < new_abil) {
    printf("Du lernst aus Deinem Fehler.\n" ); 
    if(new_abil==10000)
      tell_object(caster, "Du kannst "+capitalize(spell)+" nun perfekt!\n");
  }
  else 
    printf( "Leider lernst Du nicht aus Deinem Fehler.\n" );
  return;
}

int SetDebugName(string str) {
  if(getuid(TP)!="angrox") return 1;
  DebugName=str;
  return 1;
}
int DelDebugName() {
  DebugName="";
}
