        "Auf wen willst Du einen elementaren Feuerball schleudern?\n");
  if (!victim)
    return 0;
  sinfo=DoSpellModification(FEUER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  if ((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  //dam=sinfo[SI_SKILLDAMAGE]+10*suc*
  //  (caster->QueryProp(P_GUILD_LEVEL))/MAX_ABILITY;
  //if(dam>525) dam=525;
  dam=sinfo[SI_SKILLDAMAGE]+(exp(caster->QueryProp(P_GUILD_LEVEL)/3.35)*
    ((float)suc/MAX_ABILITY));
  //TELL("angrox", sprintf("FEUERBALL: TP: %O, lvl: %d, suc: %d, g_dam: %d, "
  //      "dam: %O, exp: %O\n", caster,caster->QueryProp(P_GUILD_LEVEL),suc,
  //      sinfo[SI_SKILLDAMAGE],dam, (exp(caster->QueryProp(P_GUILD_LEVEL)/3.2)*((float)suc/MAX_ABILITY))));
  dam=(int)dam;
  dam=(3*dam/5)+random(2*dam/5);
  vnw = victim->name(WEM, 2);
  say(sprintf("%s wirft einen elementaren Feuerball nach %s.\n", 
              capitalize(caster->name()), vnw), victim);
  printf("Du wirfst einen elementaren Feuerball nach %s.\n", vnw);
  tell_object(victim, sprintf("%s wirft einen elmentaren Feuerball nach Dir.\n",
                              capitalize(caster->name())));
  TryAttackSpell(victim,dam, DT_FIRE, 
      ([SP_NAME:"feuerball",SP_SHOW_DAMAGE:1]),caster,sinfo );
  return ERFOLG;
}




/*
//////////////////////////////////////////////////////////////////////////////
// ELEMENTARER SCHADEN FUER MEHRERE GEGNER
//////////////////////////////////////////////////////////////////////////////
*/

int erdbeben(object caster, mapping sinfo) {
  object *friends, *enemies;
  int i, suc, chance, dam;

  sinfo=DoSpellModification(ERZ, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  printf(BS("Du konzentrierst Dich auf das Element Erz und beruehrst "
           +"die Erde.\n"));
  say(sprintf("%s konzentriert sich und beruehrt die Erde.\n", 
              capitalize(caster->name())), caster);
  suc=SpellSuccess(caster,sinfo);
  if (suc<=0) return MISSERFOLG;
  dam=sinfo[SI_SKILLDAMAGE]+10*suc*
    (caster->QueryProp(P_GUILD_LEVEL))/MAX_ABILITY;
  if(dam>600) dam=600;
  say("Die Erde beginnt zu beben!\n");
  printf("Die Erde beginnt zu beben!\n");
  
  friends=FindGroup(caster,1);
  if((chance=100*suc/MAX_ABILITY)<50)
      chance=50;
  else if(chance>90) chance=90;
  enemies=FindGroupP(caster, -1, chance);
  if(friends && sizeof(friends)) {
    for(i=sizeof(friends)-1;i>=0;i--) {
      tell_object(friends[i], BS("Das Erdbeben verschont Dich nicht "
        +"und verletzt Dich leicht."));
      friends[i]->reduce_hit_point(random(sinfo[SI_SKILLDAMAGE]/125));
    }
  }
  if(sizeof(enemies)>6) {
    dam=dam-(int)((sizeof(enemies)-6)*dam*10/100);
    if(dam<100) dam=100;
  }
  if(enemies && sizeof(enemies)) {
    for(i=sizeof(enemies)-1;i>=0;i--) {
      if((enemies[i]->id("elementar"))==0 && (enemies[i]->id("feuerwusel"))==0)
      {
        tell_object(enemies[i], sprintf("Das Erdbeben von %s verletzt Dich und "
           +"wirft Dich zu Boden.", caster->name(WEM)  ) );
        say(sprintf("Das Erdbeben von %s wirft %s zu Boden.\n", 
           caster->name(WEM), enemies[i]->name(WEN, 2)), enemies[i]);
        printf("Dein Erdbeben wirft %s zu Boden.\n", enemies[i]->name(WEN, 2));
        enemies[i]->SetProp("last_rammen_time", time() );
        TryAttackSpell(enemies[i], random(2*dam/3)+(dam/3), 
            sinfo[SI_SKILLDAMAGE_TYPE], ([SP_NAME:"erdbeben",SP_SHOW_DAMAGE:1]),
            caster,sinfo );
      }
    }
  }
  return ERFOLG;
}


int windhose(object caster, mapping sinfo) {
  object *friends, *enemies;
  int i, suc, chance, dam;
  
  sinfo=DoSpellModification(LUFT, caster, sinfo);
