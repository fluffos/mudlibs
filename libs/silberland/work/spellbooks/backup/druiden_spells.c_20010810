int prep_windstoss(object caster, mapping sinfo) {
  if( !FindEnemyVictim(sinfo[SI_SKILLARG],caster,
        "Auf wen willst Du einen elementaren Windstoss schleudern?\n") )
    return 0;
  return 1;
}

int windstoss(object caster, mapping sinfo) {
  object victim;
  int hands, suc, dam;
  string vnw;  
 
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
        "Auf wen willst Du einen elementaren Windstoss schleudern?\n");
  if (!victim)
    return 0;
  
  sinfo=DoSpellModification(LUFT, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  if ((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  
  //dam=sinfo[SI_SKILLDAMAGE]+10*
  //  suc*(caster->QueryProp(P_GUILD_LEVEL))/MAX_ABILITY;
  //if(dam>500) dam=500;
  dam=sinfo[SI_SKILLDAMAGE]+(exp(caster->QueryProp(P_GUILD_LEVEL)/3.35)*
    suc/MAX_ABILITY);
  //TELL("angrox", sprintf("WINDSTOSS: TP: %O, lvl: %d, suc: %d, dam: %O\n",
  //      caster,caster->QueryProp(P_GUILD_LEVEL),suc,dam));
  dam=(int)dam;
  dam=(3*dam/5)+random(2*dam/5);
  
  vnw = victim->name(WEM, 2);
  say(BS(sprintf("%s konzentriert sich und feuert einen elementaren Windstoss "
       "auf %s.\n", capitalize(caster->name()), vnw)), victim);
  printf(BS(sprintf("Du konzentrierst Deine Gedanken auf Deine Haende, in denen "
     "sich augenblicklich die Kraefte des Elementes manifestieren "
     "und auf %s zuschiessen!\n", vnw)));
  tell_object(victim, BS(sprintf("%s konzentriert sich und feuert einen "
        "elementaren Windstoss auf Dich.\n", capitalize(caster->name()))));
  //tell_angrox(sprintf("dam: %d, suc: %d, caster: %O\n", dam, suc, caster)); 
  TryAttackSpell(victim,dam, DT_AIR, 
      ([SP_NAME:"windstoss",SP_SHOW_DAMAGE:1]),caster,sinfo );
  return ERFOLG;
}

