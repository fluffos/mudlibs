// ELEMENTARE PFEILE
////////////////////////////////////////////////////////////////////////
*/

int luftpfeil(object caster, mapping sinfo) {
  object victim; 
  string vn, vnw, cn; 
  int dam, suc;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Nach wem willst Du einen Luftpfeil werfen?\n");
  if (!victim)
    return 0;
  
  sinfo=DoSpellModification(LUFT, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  if((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  
  dam=sinfo[SI_SKILLDAMAGE]+
    5*suc*(caster->QueryProp(P_GUILD_LEVEL))/MAX_ABILITY; 
  if(dam > 250) dam=250;
  dam=(dam/2)+random(dam/2); 
  cn = capitalize(caster->name());
  vnw = victim->name(WEN, 2);
  say(sprintf("%s feuert einen elementaren Luftpfeil auf %s ab.\n",cn, vnw),
      victim);
  printf("Du feuerst einen elementaren Luftpfeil auf %s ab.\n", vnw);
  tell_object(victim,sprintf("%s feuert einen elementaren Luftpfeil "
      +"auf Dich ab.\n",cn));
  //tell_angrox(sprintf("dam: %d, suc: %d, caster: %O\n", dam, suc, caster)); 
  TryAttackSpell(victim,dam, DT_AIR, 
      ([SP_NAME:"luftpfeil",SP_SHOW_DAMAGE:1]),caster,sinfo );
  return ERFOLG;
}

