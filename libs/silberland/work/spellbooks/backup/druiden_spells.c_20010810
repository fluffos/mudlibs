/*
//
// Elementare beschwoeren
//
*/

int beherrschung_func(object caster, mapping sinfo) {
  object victim;
  if(caster->InFight()) {
    printf(BS("Im Kampf kannst Du Dich auf so etwas nicht "
              +"konzentrieren."));
    return 0;  
  }
  if(!present(DRUIDENELEMENTAR, ENV(caster))) {
    printf(BS("Aber hier ist kein Elementar!\n"));
    return 0;
  }
  victim=FindVictim(sinfo[SI_SKILLARG],caster,
                    "Welches Elementar willst Du beherrschen?\n");
  if( !victim) return 0;
  printf(BS("Du konzentrierst Dich darauf, "+victim->name(WEN,1)+
        " zu beherrschen."));
  return 1;
}

int beherrschung(object caster, mapping sinfo) {
  object victim;
  int suc;
  string cn, vn, element;

  if(caster->InFight()) {
    printf(BS("Im Kampf kannst Du Dich auf so etwas nicht "
              +"konzentrieren."));
    return 0;  
  }
  if(!present(DRUIDENELEMENTAR, ENV(caster))) {
    printf(BS("Aber hier ist kein Elementar!\n"));
    return 0;
  }
  victim=FindVictim(sinfo[SI_SKILLARG],caster,
                    "Welches Elementar willst Du beherrschen?\n");
  if(!victim) return 0;
  if(!victim->id(DRUIDENELEMENTAR)) {
    printf(BS("Das ist kein Elementar, oder Du kannst es nicht beherrschen."));
    return 0; 
  }
  if(victim->QueryProp(ELEMENTAL_CASTER) != caster)
    sinfo[SI_RAW_SPELLCOST]*=2;
  if((victim->QueryProp(ELEMENTAL_OWNER)) == caster) {
    printf("Du beherrscht das Elementar bereits.\n");
    return 0;
    }
  if(QueryOwnCreature(caster, 0, 1)) {
    printf("Du beherrscht schon ein Elementar.\n");
    return 0; 
  }
  if((victim->QueryProp(ELEMENTAL_OWNER)) &&
      (victim->QueryProp(ELEMENTAL_OWNER)) != caster)
    sinfo[SI_RAW_SPELLCOST]*=4;
  
  sinfo=DoSpellModification(victim->QueryElement(), caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  
  cn=caster->name();
  vn=victim->name(WEN, 2);
  tell_room(ENV(caster), BS(sprintf("%s fuehrt magische Bewegungen "
     +"aus und deutet auf %s.", cn, vn)), ({caster}));
  tell_object(caster, BS(sprintf("Du fuehrst uralte Beherrschungszeichen "
        +"aus und deutest auf %s.", vn)));
  
  suc=SpellSuccess(caster, sinfo);
  if (suc<=0){
    if(suc<-500) {  
      tell_room(ENV(caster), BS(sprintf("%s scheint das %s erzuernt "
           +"zu haben ...", cn, victim->QueryProp(P_NAME))), ({caster}));
      tell_object(caster, sprintf("Das Elementar greift Dich an!\n"));
      // 1999-12-14: Das iss einfach zu heavy <iwo>
      //             Statt folgen wird das Ele mit
      //             5%iger Wahrscheinlichkeit aggressive
      //if(!victim->QueryProp(ELEMENTAL_OWNER))
      //      caster->AddPursuer(victim);
      victim->SetProp(P_AGGRESSIVE, 0.05);
      victim->Kill(caster);
    }
    return MISSERFOLG;
  }
  
  tell_room(ENV(caster), BS(sprintf("Das %s folgt und gehorcht nun %s.",
            victim->QueryProp(P_NAME), cn)), ({caster}));
  tell_object(caster, sprintf("Das Elementar gehorcht Dir nun!\n")); 
  caster->AddDefender(victim);
  caster->AddPursuer(victim);
  victim->SetProp(ELEMENTAL_OWNER, caster);
  if(victim->CheckPursuers()) {
    victim->SetProp(P_MSGOUT, "folgt "+caster->name(WEM));
    victim->SetProp(P_MMSGOUT, "folgt "+caster->name(WEM));
  }
  victim->SetProp(P_LONG, Set_P_LONG(victim->QueryElement()));
  victim->SetProp(P_LONG, victim->QueryProp(P_LONG)+"Es bleibt staendig in "
       +"der Naehe von "+CAP(getuid(caster))+".");
  victim->SetProp(E_REMOVE_MSG, BS(sprintf("Das %selementar von %s loest sich "
      "nach erfuelltem Dienst auf.", CAP(victim->QueryElement()), 
      caster->Name(WER))));
  return ERFOLG;
}

int prep_luftelementar(object caster, mapping sinfo) {
  if(QueryOwnCreature(caster, 0, 2))
  {
    printf("Da ist schon ein Elementar.\n");
    return 0;
  }
  printf(BS("Du konzentrierst Dich auf das Element Luft und "
       +"laesst das Bild eines Luftelementars in Deinem "
       +"Geist entstehen.\n"));
  say(sprintf("%s scheint sich zu konzentrieren. "
               +"Die Luft beginnt zu flimmern...\n",
               capitalize(caster->name())));
  return 1;
}

int luftelementar(object caster, mapping sinfo) {
  object l;
  int suc;
  int level, hands, e_defends;

  if(QueryOwnCreature(caster, 0, 2)) {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(LUFT, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  
  if(suc=SpellSuccess(caster,sinfo)<=0) {
    if(suc<-2000) {
      printf(BS("Urploetzlich beginnt sich die Luft zu verwirbeln, "
             +"und ein Luftelementar erscheint, dass ziemlich aergerlich "
             +"und wuetend zu sein scheint!!! Es attackiert Dich!\n"));
      say(sprintf(BS("Urploetzlich beginnt sich die Luft zu verwirbeln, "
            +"und ein Luftelementar erscheint, dass auf %s ziemlich wuetend "
            +"zu sein scheint...\n"),  capitalize(caster->name())));
      l=CreateElemental(caster, suc, "luft");
      l->set_fehler();
      caster->AddPursuer(l);
      l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
      l->Kill(caster);
    }
    return MISSERFOLG;
  } 
  printf(BS("Urploetzlich beginnt sich die Luft zu verwirbeln, "
            +"und ein Luftelementar erscheint."));
  say(BS("Urploetzlich beginnt sich die Luft zu verwirbeln, "
            +"und ein Luftelementar erscheint.\n"));
  l=CreateElemental(caster, suc, "luft");
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  return ERFOLG;
}

int prep_erzelementar(object caster, mapping sinfo) {
  if(QueryOwnCreature(caster, 0, 2)) {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  printf(BS("Du konzentrierst Dich auf das Element Erz, kniest Dich "
       +"nieder und beschwoerst die Macht der Elemente...\n"));
  say(sprintf("%s scheint sich zu konzentrieren und beruehrt die Erde. "
            +"Sie beginnt ganz leicht zu vibrieren...\n",
               capitalize(caster->name())));
  return 1;
}

int erzelementar(object caster, mapping sinfo) {
   object l;
   int suc;
   int level, hands, e_defends;
 
  if(QueryOwnCreature(caster, 0, 2)) {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(ERZ, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);

  if(suc=SpellSuccess(caster,sinfo)<=0) {
    if(suc<-2000) {
      printf(BS("Ploetzlich bricht die Erde bricht auf, und ein Elementar "
            +"aus purem Erz entsteht aus dem Krater. Es wirkt SEHR "
            +"wuetend..."));
      say(sprintf(BS("Ploetzlich bricht die Erde auf und ein "
              +"Elementar aus purem Erz waechst aus der Erde.")));
      l=CreateElemental(caster, suc, "erz");
      caster->AddPursuer(l);
      l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
      l->Kill(caster);
    }        
    return MISSERFOLG;
  } 
  printf(BS("Ploetzlich bricht die Erde bricht auf, und ein Elementar "
            +"aus purem Erz entsteht aus dem Krater.\n"));
  say(BS("Ploetzlich bricht die Erde auf und ein "
              +"Elementar aus purem Erz waechst aus der Erde.\n"));
  l=CreateElemental(caster, suc, "erz");
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  return ERFOLG;
}

int prep_wasserelementar(object caster, mapping sinfo) {
  if(QueryOwnCreature(caster, 0, 2)) {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  printf(BS("Du konzentrierst Dich auf das Element Wasser, "
        +"formst mit Deinen Haenden eine Welle "
       +"und beschwoerst die Macht der Elemente...\n"));
  say(sprintf("%s scheint sich zu konzentrieren und bewegt seltsam "
            +"die Haende.\n",capitalize(caster->name())));
  return 1;
}

int wasserelementar(object caster, mapping sinfo) {
  object l;
  int suc;
  int level, hands, e_defends;
  
  if(QueryOwnCreature(caster, 0, 2)) {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(WASSER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  
  if(suc=SpellSuccess(caster,sinfo)<=0) {
    if(suc<-2000) {
      printf(BS("Wie aus dem Nichts entsteht eine Gestalt aus "
            +"Wasser, die Dich mit "
            +"zornerfuellten Blick anstarrt und dann ...\n"));
      say(sprintf(BS("Wie aus dem Nichts entsteht eine Gestalt aus Wasser, "
             +"die %s zornerfuellt anblickt und ihn dann attackiert.\n"),
              capitalize(caster->name())));
      l=CreateElemental(caster, suc, "wasser");
      l->set_fehler();
      l->move(environment(this_player()), M_NOCHECK|M_SILENT);
      l->Kill(caster);
    }
    return MISSERFOLG;
  }
  printf(BS("Wie aus dem Nichts entsteht eine Gestalt aus Wasser.\n"));
  say(BS("Wie aus dem Nichts entsteht eine Gestalt aus Wasser."));
  l=CreateElemental(caster, suc, "wasser");
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  return ERFOLG;
}

int prep_eiselementar(object caster, mapping sinfo) {
  if(QueryOwnCreature(caster, 0, 2)) {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  printf(BS("Du presst Deine Haende zusammen, konzentrierst "
        +"Dich auf die Macht des Eises und murmelst leise "
       +"die Beschwoerungsformeln.\n"));
  say(sprintf(BS("%s murmelt etwas und presst die Haende "
       +"zusammen.\n"),capitalize(caster->name())));
  return 1;
}

int eiselementar(object caster, mapping sinfo) {
  object l;
  int suc;
  int level, hands, e_defends;
   
  if(QueryOwnCreature(caster, 0, 2)) {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(EIS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->restore_spell_points(-sinfo[SI_RAW_SPELLCOST]);
  
  if(suc=SpellSuccess(caster,sinfo)<=0) {
    if(suc<-2000) {
      printf(BS("Ploetzlich faellt die Temperatur rapide ab "
            +"und ein Eiselementar formt sich aus der Kaelte. Es "
            +"blickt Dich hasserfuellt an... und attackiert Dich!\n")); 
      say(sprintf(BS("Urploetzlich faellt die Temperatur ab, und aus "
                +"der Kaelte formt sich ein Eiselementar, welches %s"
                +"sofort attackiert!\n"),capitalize(caster->name())));
      l=CreateElemental(caster, suc, "eis");
      caster->AddPursuer(l);
      l->move(environment(this_player()), M_NOCHECK|M_SILENT);  
      l->Kill(caster);
    }        
    return MISSERFOLG;  
  } 
  printf(BS("Ploetzlich faellt die Temperatur rapide ab "  
             +"und ein Eiselementar formt sich aus der Kaelte.\n"));   
  say(BS("Urploetzlich faellt die Temperatur ab, und aus "
                +"der Kaelte formt sich ein Eiselementar."));
  l=CreateElemental(caster, suc, "eis");
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  return ERFOLG;
}

