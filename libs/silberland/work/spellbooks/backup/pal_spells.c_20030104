//
// SpellSuccess ueberschreiben
//

int
SpellSuccess(object caster, mapping sinfo) {
  int suc;
  suc=::SpellSuccess(caster, sinfo);
  if(!random(3000) && caster->QueryProp(P_ALIGN)<1111) 
    return -suc;
  return suc;
}
/*
//
// SPELLS --- SPELLS --- SPELLS --- SPELLS --- SPELLS --- SPELLS
//
*/
int erblicke(object caster, mapping sinfo) {
  object ob;
  string result;
  int suc;
  mixed wert;
  mapping mat;

  if(caster->InFight()) {
    Message(caster,0,
      BS("Du solltest erst Deinen Gegner fuer Dusty besiegen!"),0);
    return 0;
  }
  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so nichts erblicken!\n"),0);
    return 0;
  }
  if (ENV(caster) && ENV(caster)->_query_total_light() < 1) {
    Message(caster,0,
      BS("Bei Dusty, hier ist es VIEL zu dunkel dafuer!\n"),0);
    return 0;
  }
  ob=FindVictim(sinfo[SI_SKILLARG], caster,
                BS("Was moechtest Du denn erblicken?\n"));
  if (!ob || ob->QueryProp(P_INVIS)) return 0;
  if (IS_WIZARD(ob)) {
    Message(caster, 0, BS(
      sprintf("%s ist von Natur aus nicht zu erblicken!\n",
      ob->Name(WER))), 0);
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    Message(caster,0,sinfo[SI_SP_LOW_MSG],0);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du bittest Dusty um einen genaueren Einblick!\n", 0);
  Message(caster, 0, sprintf("%s stoesst eine laute Bitte zu Dusty aus.\n",
                              caster->Name(WER)),3);
  if ((suc=SpellSuccess(caster,sinfo))<=0) {
    return MISSERFOLG;
  }
  if (!living(ob))
    Message(caster, 0, BS(sprintf("%s reisst %s in die Luefte und begutachtet %s "
            "ganz genau.\n",caster->Name(WER),ob->name(WEN),
            ob->QueryPronoun(WEN))),3);
  else {
    Message(caster, ob, BS(sprintf("%s mustert %s.\n",
            caster->Name(WER),ob->name(WEN))),2);
    Message(caster, ob, BS(sprintf("%s mustert Dich.\n",
            caster->Name(WER))),1);
  }
  Message(caster,0, BS("Dusty erhoert Dich und schenkt Dir einen "
                       "genauen Einblick:"), 0);
  Message(caster,0, BS("------------------------------------------------"
                       "------------------------------"), 0);
  if( (mat=ob->QueryProp(P_MATERIAL)) && (pointerp(mat))) {
    if (sizeof(mat))
      Message(caster,0,
            break_string(sprintf("%s %s aus %s.", ob->Name(WER,1),
            check_plural(ob, "besteht", "bestehen"),
            ob->MatList(WEM) || "unbekanntem Material"), 78), 0);
  } else if (mappingp(mat)) {
      Message(caster,0,
            break_string(sprintf("%s %s aus %s.", ob->Name(WER,1),
            check_plural(ob, "besteht", "bestehen"),
            ob->MaterialList(WEM,caster) || "unbekanntem Material"), 78), 0);
  }
  if (result=ob->QueryProp(P_WEAPON_TYPE)) {
    if (result==WT_SWORD) {
      wert=ob->QueryProp(P_WC)+ob->QueryProp(P_DAMAGED)+random(10)-5;
      if (!intp(wert)) wert=125;
      if     ( wert>=275 ) result="fast goettliches";
      else if( wert>=250 ) result="meisterhaftes";
      else if( wert>=225 ) result="hervorragendes";
      else if( wert>=200 ) result="extrem gutes";
      else if( wert>=175 ) result="sehr gutes";
      else if( wert>=150 ) result="gutes";
      else if( wert>=125 ) result="durchschnittliches";
      else if( wert>=100 ) result="mittelmaessiges";
      else if( wert>=75 )  result="schlechtes";
      else if( wert>=50 )  result="sehr schlechtes";
      else                 result="fast frevelhaftes";
      Message(caster,0,
        BS(CAP(ob->QueryPronoun(WER))+" ist ein "+result+" Schwert.\n"),0);
      wert=ob->QueryProp(P_WC_FIXFACTOR);
      if(!floatp(wert)) wert=0.3;
      if     ( wert>=0.8 ) result="exzellent";
      else if( wert>=0.7 ) result="extrem gut";
      else if( wert>=0.6 ) result="sehr gut";
      else if( wert>=0.4 ) result="gut";
      else if( wert>=0.3 ) result="normal";
      else if( wert>=0.2 ) result="schlecht";
      else if( wert>=0.1 ) result="sehr schlecht";
      else                 result="extrem schlecht";
      Message(caster,0, "Es liegt "+result+" in der Hand und nuetzt sich ",0);
      wert=ob->QueryProp(P_QUALITY_DECAY);
      if(!intp(wert)) wert=100;
      if     ( wert>900 ) result="praktisch gar nicht";
      else if( wert>500 ) result="extrem langsam";
      else if( wert>300 ) result="sehr langsam";
      else if( wert>200 ) result="langsam";
      else if( wert>120 ) result="etwas langsamer";
      else if( wert>90  ) result="normal";
      else if( wert>70  ) result="etwas schneller";
      else if( wert>50  ) result="schnell";
      else if( wert>30  ) result="sehr schnell";
      else if( wert>10  ) result="extrem schnell";
      else if( wert>0   ) result="fuerchterlich schnell";
      else                result="gar nicht";
      Message(caster,0,result+" ab.\n",0);
      wert=ob->QueryProp(P_WC);
      if(!intp(wert)) wert=0;
      if(wert>=(caster->QueryAttribute(A_DEX))*10/2) {
        Message(caster,0,"Mit ihm wirst Du Deinen Schwertkampf weiter "
                         "erfolgreich ueben koennen!\n",0);
      }
    }
  }
  if (result=ob->info(caster) || ob->QueryProp(P_INFO))
    Message(caster,0,result,0);
  else
    Message(caster,0,sprintf("%s %s keine besonderen Geheimnisse.\n",
           CAP(ob->QueryPronoun(WER)), check_plural(ob,"birgt","bergen")),0);
  if(ob->QueryProp(P_MAGIC))
    Message(caster,0,BS(sprintf("%s %s wohl magisch gesegnet.",
            CAP(ob->QueryPronoun(WER)),check_plural(ob,"wurde", "wurden"))),0);
  if(ob->QueryProp(P_CURSED))
    Message(caster,0,BS(sprintf("Bei Dusty, auf %s liegt ein boeser Fluch!",
            ob->QueryPronoun(WEM))),0);
  if(ob->QueryProp(P_NOBUY))
    Message(caster,0,BS(sprintf("%s %s etwas besonders Begehrenswertes zu "
            "sein.",CAP(ob->QueryPronoun(WER)),check_plural(ob,"scheint", 
              "scheinen"))),0);
  if(ob->QueryProp(P_NODROP) && suc>5000)
    Message(caster,0,sprintf(BS("Dusty wird es Dir nicht gestatten "+
            ob->QueryPronoun(WEN)+" abzulegen.")),0);
  if(ob->QueryProp(P_NEVERDROP) && suc>(5000+random(2000)))
    Message(caster,0,BS(sprintf("Dusty wird "+ob->QueryPronoun(WEN)+
            " Dir nach einem Tod wiedergeben.")),0);
  if(ob->QueryProp(P_AUTOLOADOBJ) && suc>(5000+random(3000)))
    Message(caster,0,BS(sprintf("Dusty wird "+ob->QueryPronoun(WEN)+
            " Dir nach einem Weltuntergang wiedergeben.\n")),0);
  if(ob->QueryProp(P_EFFECTIVE_AC))
    Message(caster, 0, BS(sprintf("%s ist fuer Schildparade gut geeignet.\n",
            CAP(ob->QueryPronoun(WER)))),0);
  if(ob->QueryProp(P_PALADIN_SCHILDPARADE_AC))
    Message(caster, 0, BS(sprintf("%s scheint Schildparade zusaetzlich zu "
            "verstaerken.", CAP(ob->QueryPronoun(WER)))),0);

  Message(caster,0,BS("------------------------------------------------"
        +"------------------------------"),0);
  return ERFOLG;
}



int verbannung(object caster, mapping sinfo) {
  object victim;
  int suc, dam, ghost;
  ghost = 0;
  if (sinfo[SI_SKILLARG] == "geist" && 
      (victim=present("Nekromantengeist", ENV(caster)))) 
    ghost = 1;
  else
    victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
             "Welchen Daemon oder Untoten moechtest Du verbannen?\n");
  if(!victim) return 0;
  if(!victim->is_class_member(CL_UNDEAD) &&
     !victim->is_class_member(CL_DEMON))
  {
   Message(caster, 0, BS("Paladin! Dieser Spruch funktioniert nur "
       +"auf Untote und Daemonen!"), 0);
   return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if (ghost)
    sinfo[SI_RAW_SPELLCOST] *= (10+random(5));
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, BSA(sprintf("DUSTY! Erhoere "
      +"mich und verbanne %s in Deinem Namen!",
      victim->name(WEN)), "Du rufst: "), 0);
  Message(caster, 0, BSA(sprintf("DUSTY! Erhoere "
      +"mich und verbanne %s in Deinem Namen!",
      victim->name(WEN)), caster->Name(WER)+" ruft: "), 3);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS("Dusty erhoert Dein Flehen nicht!\n"), 0);
    Message(caster, 0, BS("Nichts passiert.\n"), 3);
    return MISSERFOLG;
  }
  if(suc>7000) {
    if(!random(5))
      victim->ModifySkillAttribute(caster, SA_SPEED, 200, 2);
  }
  dam=sinfo[SI_SKILLDAMAGE]+caster->QueryProp(P_GUILD_LEVEL)*5;
  sinfo[SI_SKILLDAMAGE]=DoModificationByAlign(dam, caster, victim);
  if (sinfo[SI_SKILLDAMAGE] > 375) sinfo[SI_SKILLDAMAGE]=375;
  // ZUM LOGGEN DER SPELLSTAERKE!
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/verbannung",
        sprintf("CST: %O, CA: %d, VA: %d, suc: %d, dam: %d\n",
            caster, caster->QueryProp(P_ALIGN), victim->QueryProp(P_ALIGN),
            suc, sinfo[SI_SKILLDAMAGE]));
  // ----------------------------
  Message(caster, 0, BS(sprintf("Die Macht Dustys senkt sich auf %s "
    +"herab und loest %s auf!", victim->name(WEN),
    victim->QueryPronoun(WEN))), 0);
  Message(caster, victim, BS(sprintf("Die Macht Dustys senkt sich auf "
    +"Dich herab und loest Dich auf!")), 1);
  Message(caster, victim, BS(sprintf("Die Macht Dustys senkt sich auf %s "
    +"herab und loest %s auf!", victim->name(WEN),
    victim->QueryPronoun(WEN))), 2);
  if (ghost)
    victim->remove();
  else
    TryDefaultAttackSpell(victim,caster,sinfo,
            ([SP_NAME:"verbannung", SP_SHOW_DAMAGE:1]));
  return ERFOLG;
}



int schaetz(object caster, mapping sinfo) {
  int suc,al;
  object victim;
  int hp, sp, ac, size, level;
  int hp_vic, sp_vic, size_vic, spellrate_vic, nomagic_vic, align;
  string result,who;
  mixed *indices;
  float *values,wert;

  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so niemanden einschaetzen!\n"),0);
    return 0;
  }
  if (ENV(caster) && ENV(caster)->_query_total_light() < 1) {
    Message(caster,0,
      BS("Bei Dusty, hier ist es VIEL zu dunkel dafuer!\n"),0);
    return 0;
  }
  victim=FindVictim(sinfo[SI_SKILLARG], caster,
                BS("Wen moechtest Du einschaetzen?\n"));
  if (!victim || (victim && victim->QueryProp(P_INVIS))) return 0;
  if(!living(victim)) {
    printf(BS("Bei Dusty, Du kannst nur Lebewesen einschaetzen!\n"));
    return 0;
  }
  if (IS_WIZARD(victim)) {
    Message(caster, 0, BS(
      sprintf("%s ist von Natur aus nicht einzuschaetzen!\n",
      victim->Name(WER))), 0);
    return 0;
  }
  if (victim->InFight() && (victim->QueryProp(P_AGGRESSIVE) == 0)) {
    Message(caster,0,
      BS(sprintf("%s ist gerade in einen Kampf verwickelt!",
      victim->Name(WER))),0);
    return 0;
  }
  if(victim==caster) {
    Message(caster, 0, BS(
      "Du bist zum Glueck so wie Dusty Dich geschaffen hat!\n"), 0);
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  Message(caster, 0, BS(
    sprintf("Du versuchst %s mit Deinen Augen zu durchdringen.\n",
            victim->name(WEN))), 0);
  if ((suc=SpellSuccess(caster,sinfo))<=0) {
    Message(caster, 0, "Deine Augen schweifen auf einmal ab!\n", 0);
    return MISSERFOLG;
  }
  Message(caster, victim, BS(sprintf("%s durchdringt %s mit %sn Augen.\n",
          caster->Name(WER),victim->name(WEN),caster->QueryPossPronoun(2))),2);
  Message(caster, victim, BS(sprintf("%s durchdringt Dich mit %sn Augen.\n",
          caster->Name(WER),caster->QueryPossPronoun(2))),1);
  Message(caster,0,
    BS("Du kannst mit goettlicher Hilfe folgendes erkennen:"),0);
  Message(caster,0, BS("------------------------------------------------"
                       "------------------------------"), 0);

  sp_vic=victim->QueryProp(P_MAX_SP);
  size_vic=victim->QueryProp(P_SIZE);
  hp_vic=victim->QueryProp(P_MAX_HP);
  nomagic_vic=victim->QueryProp(P_NOMAGIC);
  spellrate_vic=victim->QueryProp(P_SPELLRATE);
  align=victim->QueryProp(P_ALIGN);
  if(!intp(align)) align=0;
  who=CAP(victim->QueryPronoun(WER));
  if(!size_vic) size_vic=1;

  sp=caster->QueryProp(P_MAX_SP);
  ac=caster->QueryProp(P_TOTAL_AC);
  hp=caster->QueryProp(P_MAX_HP);
  size=caster->QueryProp(P_SIZE);
  level=caster->QueryProp(P_GUILD_LEVEL);
  if(!size) size=1;

  result=victim->Name(WER)+" ";
  if      (align<-1000) result+="scheint das Boese in sich zu haben! "
                               +"TOETE IN DUSTYS NAMEN!!!\n";
  else if (align<-800)  result+="ist von extrem diabolischer Gesinnung! "
                               +"SOFORT TOETEN!\n";
  else if (align<-600)  result+="ist von diabolischer Gesinnung! "
                               +"TOETEN!\n";
  else if (align<-400)  result+="ist extrem boese.\n";
  else if (align<-300)  result+="ist sehr boese.\n";
  else if (align<-200)  result+="ist boese.\n";
  else if (align<-100)  result+="ist sehr frech.\n";
  else if (align<-50)   result+="ist zu frech um neutral zu sein.\n";
  else if (align<50)    result+="steht allem ziemlich neutral gegenueber.\n";
  else if (align<100)   result+="ist nett.\n";
  else if (align<200)   result+="ist sehr nett.\n";
  else if (align<300)   result+="ist extrem nett.\n";
  else if (align<400)   result+="hat eine gute Gesinnung.\n";
  else if (align<600)   result+="hat eine sehr gute Gesinnung.\n";
  else if (align<800)   result+="hat eine aussergewoehnlich gute "
                               +"Gesinnung.\n";
  else if (align<1000)  result+="ist schon fast heilig.\n";
  else                  result+="ist heilig! EHRE SEI DUSTY!!!\n";
  Message(caster, 0, BS(result), 0);
  
  if(call_other(NPCMASTER, "IsEnemy", victim)) {
    Message(caster, 0, BS(sprintf("%s ist durch seine Taten ein FEIND "
            "der Paladine! Dusty wird %s jegliche Gnade verweigern!", 
            victim->Name(WER), victim->QueryPronoun(WEM))));
  }


  al = caster->QueryProp(P_ALIGN)/32 + align / 12;
  result="Nach einem siegreichen Kampf wuerde Deine Gesinnung ";
  if(al < 0) 
    result += "steigen.";
  else if (al > 0) 
    result += "sinken.";
  else 
    result += "gleich bleiben.";
  Message(caster, 0, BS(result), 0);
    

  result=who;
  switch(100*size_vic/size) {
    case 0..20   : result+=" ist sehr viel kleiner als Du.\n";
                   break;
    case 21..50  : result+=" ist viel kleiner als Du.\n";
                   break;
    case 51..80  : result+=" ist kleiner als Du.\n";
                   break;
    case 81..130 : result+=" ist etwa gleich gross wie Du.\n";
                   break;
    case 141..180: result+=" ist groesser als Du.\n";
                   break;
    case 181..350: result+=" ist viel groesser als Du.\n";
                   break;
    case 351..500: result+=" ist sehr viel groesser als Du.\n";
                   break;
    case 501..800: result+=" ueberragt Dich um Haeuser.\n";
                   break;
    default      : result+=" ist gross wie ein Berg.\n";
  }
  Message(caster, 0, BS(result), 0);

  result=who+" haelt";
  if(!hp) hp=1;
  switch(100*hp_vic/hp) {
    case 0..20   : result+=" im Gegensatz zu Dir gar nichts aus.\n";
                   break;
    case 21..50  : result+=" im Gegensatz zu Dir sehr wenig aus.\n";
                   break;
    case 51..80  : result+=" etwas weniger als Du aus.\n";
                   break;
    case 81..140 : result+=" etwa gleich viel wie Du aus.\n";
                   break;
    case 151..200: result+=" im Gegensatz zu Dir viel aus.\n";
                   break;
    case 201..400: result+=" im Gegensatz zu Dir sehr viel aus.\n";
                   break;
    case 401..600: result+=" im Gegensatz zu Dir enorm viel aus .\n";
                   break;
    case 601..800: result+=" extrem viel aus. Du fuehlst Dich wie "
                         +"ein kleines Wuerstchen.\n";
                   break;
    case 801..1000:result+=" im Gegensatz zu Dir unglaublich viel aus.\n";
                   break;
    default      : result+=" zuviel Schaden aus. Du zitterst "
                          +"vor Ehrfurcht.\n";
  }
  if (suc > 4000) Message(caster, 0, BS(result), 0);

  result=who;
  if(!sp) sp=1;
  switch(100*sp_vic/sp) {
    case 0..20   : result+=" hat so gut wie gar keine magischen Kraefte.\n";
                   break;
    case 21..50  : result+=" hat weit weniger magische Energie als Du.\n";
                   break;
    case 51..80  : result+=" hat etwas weniger magische Energie als Du.\n";
                   break;
    case 81..120 : result+=" ist etwa gleich magisch aktiv wie Du.\n";
                   break;
    case 121..180: result+=" hat mehr magische Energie als Du.\n";
                   break;
    case 181..250: result+=" hat viel mehr magische Energie als Du.\n";
                   break;
    case 251..400: result+=" ist mit sehr viel mehr "
                         +"magischer Energie gesegnet als Du.\n";
                   break;
    case 401..600: result+=" ist in Sachen Magie extrem "
                         +"maechtiger als Du.\n";
                   break;
    case 601..800: result+=" hat im Gegensatz zu "
                          +"Dir unglaublich hohe und extrem "
                          +"maechtige magische Kraefte.";
                   break;
    case 801..1000:result+=" hat im Gegensatz zu "
                         +"Dir so unglaublich "
                         +"grosse magische Kraefte, dass Du vor "
                         +"Ehrfurcht erzitterst.\n";
                   break;
    default      : result+=" hat im Gegensatz zu Dir gottgleiche "
                         +"magische Kraefte! Du erzitterst vor "
                         +"Ehrfurcht!\n";
  }
  if (suc > 4000) Message(caster, 0, BS(result), 0);

  result=who;
  if(interactive(victim)) result+=" kann zaubern.\n";
  else
  switch(spellrate_vic) {
    case 0      : result+=" kann keine Zauber sprechen.\n";
                   break;
    case 1..15  : result+=" kann nur wenige Zauber sprechen.\n";
                   break;
    case 16..30 : result+=" kann ein paar Zauber sprechen.\n";
                   break;
    case 31..45 : result+=" kann relativ viele Zauber sprechen.\n";
                   break;
    case 46..60 : result+=" spricht viele Zauber.\n";
                   break;
    case 61..75 : result+=" spricht sehr viele Zauber.\n";
                   break;
    case 76..99 : result+=" spricht beinahe immer einen Zauber.\n";
                   break;
    case 100    : result+=" spricht immer einen Zauber.\n";
                   break;
    default      : result+=" spricht immer einen Zauber.\n";
  }
  if (level>8) Message(caster, 0, BS(result), 0);
  /*
  result=who;
  switch(nomagic_vic) {
    case 0      : result+=" kann keine Zauber abwehren.\n";
                   break;
    case 1..15  : result+=" kann nur wenige Zauber abwehren.\n";
                   break;
    case 16..30 : result+=" kann ein paar Zauber abwehren.\n";
                   break;
    case 31..45 : result+=" kann relativ viele Zauber abwehren.\n";
                   break;
    case 46..60 : result+=" wehrt etwa die Haelfte aller Zauber ab.\n";
                   break;
    case 61..75 : result+=" wehrt sehr viele Zauber ab.\n";
                   break;
    case 76..99 : result+=" wehrt beinahe alle Zauber ab.\n";
                   break;
    case 100    : result+=" wehrt alle Zauber ab.\n";
                   break;
    default      : result+=" wehrt alle Zauber ab.\n";
  }
  if (level>8) Message(caster, 0, BS(result), 0);
  */
  hp=victim->QueryProp(P_TOTAL_AC);
  result=who;
  switch(hp) {
    case 0..40   : result+=" hat so gut wie keinen Schutz.\n";
                   break;
    case 41..80  : result+=" kann Dir nicht viel entgegensetzen.\n";
                   break;
    case 81..120 : result+=" hat eine gute Ruestung oder natuerlichen "
                         +"Schutz.\n";
                   break;
    case 121..160: result+=" hat eine maechtige Ruestung oder "
                         +"natuerlichen Schutz.\n";
                   break;
    case 161..200: result+=" hat eine extrem maechtige Ruestung oder "
                         +"einen uebernatuerlichen Schutz.\n";
                   break;
    case 201..250: result+=" scheint vom Element Erz selbst vollkommen "
                         +"geschuetzt zu sein.\n";
                   break;
    case 251..350: result+=" ist beinahe wie unverwundbar.\n";
                   break;
    default      : result+=" ist durch normale Waffen nicht mehr zu "
                         +"verletzen und scheint einen extrem "
                         +"machtvollen uebernatuerlichen Schutz zu "
                         +"haben.\n";
  }
  Message(caster, 0, BS(result), 0);

  // Achtung, wegen too many local vars werden alte wiederbenutzt !!!

  if (level>10) {
    if (suc>random(6000) && victim->QueryProp(P_RESISTANCE_STRENGTHS)) {
      values=m_values(victim->QueryProp(P_RESISTANCE_STRENGTHS));
      indices=m_indices(victim->QueryProp(P_RESISTANCE_STRENGTHS));
      hp=member(indices,DT_HOLY);
      if(hp>-1) {
        wert=(float)values[hp];
        if (wert > 0.0)
          Message(caster, 0, BS(
            who+" ist mit heiligen Attacken verwundbar!"), 0);
        if (wert < 0.0)
          Message(caster, 0, BS(
            who+" ist gegen heilige Attacken geschuetzt."), 0);
      }
      hp=member(indices,DT_UNHOLY);
      if(hp>-1) {
        wert=(float)values[hp];
        if (wert > 0.0)
          Message(caster, 0, BS(
            who+" ist mit daemonischen Attacken verwundbar!"), 0);
         if (wert < 0.0)
          Message(caster, 0, BS(
            who+" ist gegen daemonische Attacken geschuetzt."), 0);
      }
    }
    if(suc>random(6000)) {
      indices=victim->QueryProp(P_HANDS);
      if(indices) {
        if (!pointerp(indices))
          indices[0]=({indices});
        if(member(indices, DT_HOLY)!=-1) {
          Message(caster, 0, BS(
            who+" attackiert mit heiligen Angriffen!"), 0);
        }
        if(member(indices, DT_UNHOLY)!=-1) {
          Message(caster, 0, BS(
            who+" attackiert mit daemonischen Angriffen!"), 0);
        }
      }
    }
    if (suc>random(6000)) {
      indices=victim->QueryProp(P_SPELLS);
      if (sizeof(indices)>0) {
        ac=sp=0; // ac=holy , sp=unholy
        for (hp=0;hp<sizeof(indices);hp++) {
          if (!pointerp(indices[hp][3]))
            indices[hp][3]=({ indices[hp][3] });
          if(member(indices[hp][3], DT_HOLY)!=-1)
            ac++;
          if(member(indices[hp][3], DT_UNHOLY)!=-1)
            sp++;
        }
        if (ac)
          Message(caster, 0, BS(
            who+" hat heilige Zauber auf Lager!"), 0);
        if (sp)
          Message(caster, 0, BS(
            who+" hat daemonische Zauber auf Lager!"), 0);
      }
    }
  }
  if(!query_once_interactive(victim) && victim->QueryProp(P_LEVEL) >
      caster->QuerySkillAbility("Fight_sword")/400) {
    Message(caster, 0, BS(sprintf("Bei Dusty! %s ist ein wuerdiger Gegner! "
            "Bei %s wirst Du sicher Deinen Schwertkampf lernen.",
            CAP(victim->QueryPronoun(WER)), victim->QueryPronoun(WEM))),0);
  }

  Message(caster,0,BS("------------------------------------------------"
        +"------------------------------"),0);
  // machen wir doch die boesen ein wenig attack
  if ((!query_once_interactive(victim)) &&
      (align < -200) &&
      (caster->QueryProp(P_ALIGN) >200) &&
      (caster->QueryProp(P_LEVEL) > victim->QueryProp(P_LEVEL)) &&
      !victim->QueryProp(P_FRIEND) &&
      !victim->QueryProp(P_NOATTACK) &&
      (random(100) <5)) {
    Message(caster, 0, BS(
      victim->Name(WEN)+" verflucht Dich und greift Dich an!"));
    victim->Kill(caster);
  }
  return ERFOLG;
}


int schildparade(object caster, mapping sinfo) {
  mixed h;
  int suc,dauer;
  string txt;
  if (!caster->InFight()) {
    write(BS("Paladin! Du musst Dich schon im Kampf befinden, um "
        +"die Schildparade anwenden zu koennen!"));
    return 0;
  }
  if (h=caster->QueryProp(P_TMP_DEFEND_HOOK)) {
    if ((h[1]==TO) && (h[2]=="schildparade_func")) {
      if (h[0] >= time())
        return write("Paladin! Du hast bereits eine Schildparade "
            +"aufrecht!\n"), 0;
    } else
      return write("Paladin! Du hast schon einen Schutz!\n"), 0;
  }
  if(interactive(caster) && present("\nspiegelschild", caster)) {
    write("Du hast schon einen Spiegelschild bekommen, Paladin!\n");
    return 0;
  }
  if(shield_check(caster)<0) {
    write(BS("Paladin! Du musst schon ein Schild tragen!"));
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  Message(caster, 0, BS("Du nimmst Dein Schild fester in die Hand und "
      +"betest zu Dusty!"), 0);
  Message(caster, 0, BS(sprintf("%s nimmt %s Schild fester in die Hand!",
      caster->Name(WER), caster->QueryPossPronoun(WER))), 3);
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  if ((suc=SpellSuccess(caster,sinfo)) <= 0) {
    Message(caster, 0, "Dusty scheint Deine Gebete nicht zu erhoeren!\n", 0);
    Message(caster, 0, "Nichts passiert.\n", 3);
    return MISSERFOLG;
  }
  dauer=2+2*caster->QueryAttribute(A_DEX)/3+(suc/2000);
  dauer=DoModificationByAlign(dauer, caster);
  call_out("schildparade_end", dauer-2, caster);
  caster->SetProp(P_TMP_DEFEND_HOOK,
      ({time()+dauer, TO, "schildparade_func" }));
  txt="Dusty! Steh mir bei, die Attacken meines Gegners zu parieren!";
  Message(caster, 0, BSA(txt, "Du rufst: "), 0);
  Message(caster, 0, BS("Du reckst Dein Schild gen Himmel!"), 0);
  Message(caster, 0, BSA(txt, caster->Name(WER)+" ruft: "), 3);
  Message(caster, 0, BS(sprintf("%s reckt %s Schild gen Himmel!",
      caster->Name(WER), caster->QueryPossPronoun(WER))), 3);
  return ERFOLG;
}

static void schildparade_end(object caster) {
  mixed h;
  if (!objectp(caster)) return;         // Woody (981122)
  if (h=caster->QueryProp(P_TMP_DEFEND_HOOK)) {
    if ((h[1]==TO) && (h[2]=="schildparade_func")) {
      caster->SetProp(P_TMP_DEFEND_HOOK, 0);
    }
  }
  Message(caster, 0, BS("Deine Schildparade laesst langsam nach, "
                        "Paladin!"), 0);
  return;
}

int shield_check(object caster)
{
  object *arr;
  int i,x;
  // 99-05-01 (woody)
  if (!caster) return 0;        // sicher ist sicher :)
/*
  return sizeof(filter_array(caster->QueryProp(P_ARMOURS),
        lambda( ({'x}), ({ #'==,
            ({ #'call_other, 'x, "QueryProp", P_ARMOUR_TYPE }),
            AT_SHIELD }) )));
*/
  x=-1;
  arr=caster->QueryProp(P_ARMOURS);
  for(i=sizeof(arr)-1;i>=0;i--)
    if(arr[i]->QueryProp(P_ARMOUR_TYPE)==AT_SHIELD)
      x=i;
  return x;
}

mixed schildparade_func(int dam, mixed dam_type, mixed spell, object enemy)
{
  object caster;
  mixed shield;
  int rnd, anz, ac, weight, special_ac;

  if (!living(caster = previous_object()))
    return ({ dam, dam_type, spell, enemy });

  // Nur bei physischem Schaden(santeil) wirksam:
  if (sizeof(filter_array(dam_type,PHYSICAL_DAMAGE_TYPES)))
  {
    shield = caster->QueryArmours(AT_SHIELD);   // returns array of shields
    if (!sizeof(shield))
    {
      Message(caster,0, BS("Ohne Schild keine Schildparade, Paladin!"), 0);
      caster->SetProp(P_TMP_DEFEND_HOOK, 0);
      return ({ dam, dam_type, spell, enemy });
    }
    else
      shield = shield[0];       // ersten (== einzigen) Schild nehmen

    // der Versuch, Schild eh weglassen, wenn man sowieso verfehlt wird
    // anz ... Anzahl wirksamer Ruestungen
    anz = sizeof( filter_objects( caster->QueryProp(P_ARMOURS),
                                  "QueryProp", P_AC ) );

    // tell_zordan(sprintf(" -> %d %d %d %d\n",dam,sizeof(armours),anz,anz*5));
    if (dam < anz * 5) return ({ dam, dam_type, spell, enemy });

    // Schild nimmt zusaetzlichen Schaden durch die Parade:
    catch(shield->TakeFlaw( dam_type ));

    // Kosten (random 1-3 MP)
    rnd = 1 + random(3);

    // Ist er dadurch kaputtgegangen? Oder hat der Caster zuwenig MP?
    if ( !shield || (caster->QueryProp(P_SP) < rnd) ) {
      Message(caster, 0, BS("Deine Schildparade laesst nach!"), 0);
      caster->SetProp(P_TMP_DEFEND_HOOK, 0);
      return ({ dam, dam_type, spell, enemy });
    }

    // MP abziehen, Schildqualitaet feststellen
    caster->AddSp(-rnd);
    ac = shield->QueryProp(P_AC);
    weight = shield->QueryProp(P_WEIGHT);
    special_ac = shield->QueryProp(P_PALADIN_SCHILDPARADE_AC);
    special_ac += shield->QueryProp(P_EFFECTIVE_AC);

    // Abhaengigkeit von der Schildqualitaet:
    if (random(VALID_ARMOUR_CLASS[AT_SHIELD] + (weight / 300)) <= ac)
    { 
      // Schadensreduzierung:
      dam -= ((ac + special_ac + random(ac)) * dam) / 100;

      // Meldungen an Spieler und Raum:
      Message(caster, 0,
          BS("Du parierst die Attacke " + (dam < 40 ? "" : "ein wenig ") +
             "mit Deinem Schild!"), 0);
      if (ENV(caster))
        Message(caster, 0,
            BS(sprintf("%s pariert die Attacke %smit %s Schild!",
                caster->Name(WER),
                (dam < 40 ? "" : "ein wenig "),
                caster->QueryPossPronoun(MALE,WEM))), 3);
    }
  }
  return ({ dam, dam_type, spell, enemy });
}



int heiligenschein(object caster, mapping sinfo) {
  object schein;
  int suc, dauer;
  if(present("\nheiligenschein", caster)) {
    write("Bei Dusty! Du hast doch schon einen Heiligenschein!\n");
    return 0;
  }
  if(caster->InFight()) {
    Message(caster,0,
      BS("Du solltest erst Deinen Gegner fuer Dusty besiegen!"),0);
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du kniest nieder und betest zu Dusty!\n", 0);
  Message(caster, 0, sprintf("%s kniet nieder und betet.\n",caster->Name(WER)),
      3);
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    Message(caster, 0, "Dusty scheint Deine Gebete nicht zu erhoeren!\n", 0);
    Message(caster, 0, "Nichts passiert.\n", 3);
    return MISSERFOLG;
  }
  Message(caster, 0, BS("Ueber Deinem Haupt materialisiert sich ein goldener "
      +"Heiligenschein! Gepriesen sei Dusty!!"), 0);
  Message(caster, 0, BS(sprintf("Du spuerst eine goettliche Praesenz, als "
      +"urploetzlich ueber dem Kopf von %s ein goldener Heiligenschein "
      +"erscheint. %s scheint wirklich von Dusty gesegnet zu sein.",
      caster->name(WER), caster->Name(WER))), 3);
  schein=clone_object(OBJ("heiligenschein"));
  schein->move(caster, M_NOCHECK|M_SILENT);
  dauer=DoModificationByAlign(caster->QueryProp(P_GUILD_LEVEL)*30, caster);
  schein->start_remove(dauer);
  caster->AddDetail(({"schein", "heiligenschein"}),
      "Der Heiligenschein schwebt ueber Deinem Kopf.");
  return ERFOLG;
}





string perc2str(int percent) {
  string str;

  str="";
  switch (percent) {
    case  0:        str+=" wird den naechsten Treffer nicht ueberleben.";
                    break;
    case  1..5 :    str+=" ist so gut wie am Ende.";
                    break;
    case  6..10:    str+=" spuert bald das Ende nahen.";
                    break;
    case 11..15:    str+=" spuert die Lebensenergie schwinden.";
                    break;
    case 16..20:    str+=" ist in einem aeusserst bedenklichen Zustand.";
                    break;
    case 21..25:    str+=" ist in einem sehr ueblen Zustand.";
                    break;
    case 26..30:    str+=" ist in einem ueblen Zustand.";
                    break;
    case 31..35:    str+=" ist in einem sehr schlechten Zustand.";
                    break;
    case 36..40:    str+=" ist in einem ziemlich schlechten Zustand.";
                    break;
    case 41..45:    str+=" macht einen sehr angeschlagenen Eindruck.";
                    break;
    case 46..50:    str+=" macht einen ziemlich angeschlagenen Eindruck.";
                    break;
    case 51..55:    str+=" machte schon einen wesentlich besseren Eindruck.";
                    break;
    case 56..60:    str+=" machte schon einen deutlich besseren Eindruck.";
                    break;
    case 61..65:    str+=" machte schon einen besseren Eindruck.";
                    break;
    case 66..70:    str+=" fuehlt sich nicht mehr so gut.";
                    break;
    case 71..75:    str+=" ist noch recht gut drauf.";
                    break;
    case 76..79:    str+=" ist bei ordentlicher Gesundheit.";
                    break;
    case 81..85:    str+=" ist bei guter Gesundheit.";
                    break;
    case 86..90:    str+=" ist bei sehr guter Gesundheit.";
                    break;
    case 91..95:    str+=" ist bei hervorragender Gesundheit.";
                    break;
    case 96..99:    str+=" ist bei ausgezeichneter Gesundheit.";
                    break;
    case 100..10000:str+=" ist bei bester Gesundheit.";
                    break;
    default:  str+=" ist nicht von dieser Seite.";
  }
  return str;
}



int behandle(object caster, mapping sinfo) {
  object victim;
  int hands, suc, heal, hp, max_hp, percent;
  int f_hands;
  victim=FindVictim(sinfo[SI_SKILLARG],caster,
              BS("Wen willst Du mit der Macht Dustys behandeln?\n"));
  if (!victim || (victim && victim->QueryProp(P_INVIS)))
    return 0;
  f_hands=caster->QueryProp(P_MAX_HANDS)-caster->QueryProp(P_USED_HANDS);
  if(present("\nspiegelschild", caster)) {
    f_hands+=1;
  }
  if(interactive(caster) && f_hands < 2)
  {
    Message(caster,0,
      BS("Du hast nicht genug Haende frei.\n"),0);
    return 0;
  }
  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so nicht behandeln!\n"),0);
    return 0;
  }
  if (ENV(caster) && ENV(caster)->_query_total_light() < 1) {
    Message(caster,0,
      BS("Bei Dusty, hier ist es VIEL zu dunkel dafuer!\n"),0);
    return 0;
  }

  if(victim->is_class_member(CL_UNDEAD) ||
     victim->is_class_member(CL_DEMON))
  {
    Message(caster, 0, "PALADIN! Du kannst keine Untoten oder "
        "Daemonen heilen!\n", 0);
    return 0;
  }

  if(victim->QueryProp(P_HP) == victim->QueryProp(P_MAX_HP)) {
    if(victim==caster)
      Message(caster, 0, "Aber Du hast doch keine Wunden! Danke Dusty "
          +"dafuer!\n", 0);
    else
      Message(caster, 0, sprintf("Aber %s hat keine Wunden! %s sollte Dusty "
          +"dafuer danken.\n", victim->name(WER),
          CAP(victim->QueryPronoun(WER))), 0);
    return 0;
  }
  if(call_other(NPCMASTER, "IsFeind", victim) && victim!=caster) {
    Message(caster,0,
          BS("BEI DUSTY! Du wuerdeset einen FEIND der Paladine und somit "
          "auch einen FEIND Deiner Goettin heilen? Dafuer gibt es nur "
          "EINE Strafe!!!"),0);
    call_out("DoFakeDeath",0,caster);
    return 0;
  }
  //if(interactive(caster) && !interactive(victim)) {
  //  Message(caster, 0, BS(sprintf("Bei Dusty! Du kannst %s nicht behandeln!",
  //      victim->name(WEN))), 0);
  //  return 0;
  //}
/*  if(victim->QueryProp(P_GHOST)) {
    Message(caster, 0, BS(                                                                                        
     sprintf("Bei Dusty! Du kannst %s nicht behandeln, weil %s gerade ein "
         +"Geist ist!\n",                                                         
     victim->name(WER),victim->QueryPronoun(WER))), 0);
     return 0; 
  }*/
  if(victim->QueryProp(P_FRIEND)) {
    Message(caster, 0, BS(                                                                                        
     sprintf("Bei Dusty! Du kannst %s nicht behandeln!\n",                                                         
     victim->name(WER))), 0);
     return 0; 
  }
  if (IS_WIZARD(victim)) {
    Message(caster, 0, BS(
      sprintf("%s ist von Natur aus nicht verwundbar!\n",
      victim->Name(WER))), 0);
    return 0;
  }
  if (victim->QueryGuest()) {
    Message(caster, 0, BS(
      sprintf("%s ist ein Gast und bedarf keiner Heilung!\n",
      victim->Name(WER))), 0);
    return 0;
  }

  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du beginnst leise zu Dusty zu beten!\n", 0);
  Message(caster, 0, sprintf("%s scheint leise zu beten.\n",caster->Name(WER)),
      3);
  if((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  heal=caster->QueryProp(P_GUILD_LEVEL)+((caster->QueryAttribute(A_INT)
      *12*suc/(10*MAX_ABILITY)));
  //tell_angrox(heal+"/");
  if(f_hands<2)
    heal/=2;
  heal=DoModificationByAlign(heal, caster)/2+
       DoModificationByAlign(heal, victim)/2;
  if(heal < (15-(caster->QueryProp(P_GUILD_LEVEL)+2))*2)
    heal=(15-(caster->QueryProp(P_GUILD_LEVEL)+2))*2;
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/behandle",
        sprintf("CST: %O, VIC: %O, CA: %d, VA: %d, suc: %d, "
        +"heal: %d, MP: %d\n", caster, victim, caster->QueryProp(P_ALIGN),
        victim->QueryProp(P_ALIGN), suc, heal, sinfo[SI_RAW_SPELLCOST]));
  //tell_angrox(heal+"\n");
  if(heal>50) heal=50;
  if(victim->id(ISPALADIN)) heal*=2; // NPCs heilen is cool :) angrox
  victim->AddHp(heal);
  if(victim==caster) {
    Message(caster, 0, sprintf("%s legt sich %s Hand auf %s Wunden.\n",
        caster->Name(WER), caster->QueryPossPronoun(FEMALE),
        caster->QueryPossPronoun(FEMALE)), 3);
    Message(caster, 0, BSA(sprintf("Goettliche Herrin Dusty, leihe %s Deine "
        +"Macht und heile meine Wunden!",
        diener[0][caster->QueryProp(P_GENDER)]), caster->Name(WER)+
        " ruft: "), 3);
    Message(caster, 0, BS(sprintf("Die Wunden von %s schliessen sich!\n",
        caster->Name(WER))), 3);
    Message(caster, 0, BS("Du legst Deine Hand auf Deine Wunden.\n"), 0);
    Message(caster, 0, BSA(sprintf("Goettliche Herrin Dusty, leihe %s "
        +"Deine Kraft und heile meine Wunden!",
        diener[0][caster->QueryProp(P_GENDER)]), "Du rufst: "), 0);
    Message(caster, 0, BS("Ein Teil Deiner Wunden schliesst sich! Dusty sei "
        +"Dank!"), 0);
  }
  else {
    Message(caster, victim, sprintf("%s legt %s Hand auf Deine Wunden.\n",
        caster->Name(WER), caster->QueryPossPronoun(FEMALE)), 1);
    Message(caster, victim, BS(sprintf("Du legst Deine Hand auf die Wunden "
        +"von %s.", victim->name(WEM))), 0);
    Message(caster, victim, BS(sprintf("%s legt %s Hand auf die Wunden "
          +"von %s.", caster->Name(WER), caster->QueryPossPronoun(FEMALE),
          victim->name(WEM))), 2);
    Message(caster, victim, BSA(sprintf("Goettliche Herrin Dusty, leihe %s "
        +"Deine Macht und heile die Wunden von %s!",
        diener[0][caster->QueryProp(P_GENDER)], victim->name(WEM)),
        "Du rufst: "), 0);
    Message(caster, victim, BSA(sprintf("Goettliche Herrin Dusty, leihe "
          +"%s Deine Macht und heile die Wunden von %s!",
          diener[0][caster->QueryProp(P_GENDER)], victim->name(WEM)),
          caster->Name(WER)+" ruft: "), 3);
    hp=victim->QueryProp(P_HP);
    if (hp < 0) hp=0;
    max_hp=victim->QueryProp(P_MAX_HP);
    if (max_hp < 1) max_hp=1;
    percent=100*hp/max_hp;
    Message(caster, victim, BS(sprintf("Die Wunden von %s schliessen sich "
          "und "+victim->QueryPronoun()+perc2str(percent)+"\n",
        victim->name(WEM))), 4);
    Message(caster, victim, "Deine Wunden schliessen sich!\n", 1);

  }
  if(victim!=caster && caster->QueryProp(P_ALIGN) <1100)
    caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)+random(10));
  return ERFOLG;
}




int gottheilung(object caster, mapping sinfo) {
  int poison_diff, suc;
  string vn, illness;
  mapping illnesses;
  object victim;
  illnesses=(["blindheit":8, "taubheit":6, "verfroschung":4, "vergiftung":10,
      "sprachfluch":12]);
  //tell_angrox(sinfo[SI_SKILLARG]+"\n");
  if(!sinfo[SI_SKILLARG] || sscanf(sinfo[SI_SKILLARG], "%s von %s",
      vn, illness)!=2)
  {
    write(BS("Paladin, WEN willst Du von WAS mit der Macht Dustys "
        +"heilen?\n"));
    return 0;
  }
  if(!ENV(caster)) {
    write("In dieser Umgebung kann Dich Dusty nicht erhoeren\n");
    return 0;
  }
  if (ENV(caster) && ENV(caster)->_query_total_light() < 1) {
    Message(caster,0,
      BS("Bei Dusty, hier ist es VIEL zu dunkel dafuer!\n"),0);
    return 0;
  }
  if(vn=="mich")
    victim=caster;
  else if(!victim=present(vn, ENV(caster)) ||
         (victim && victim->QueryProp(P_INVIS))) {
    write(BS(sprintf("Paladin, hier ist niemand, der '%s' heisst!\n",
        vn)));
    return 0;
  }
  if(call_other(NPCMASTER, "IsFeind", victim)) {
    Message(caster,0,
          BS("BEI DUSTY! Du wuerdeset einen FEIND der Paladine und somit "
          "auch einen FEIND Deiner Goettin heilen? Dafuer gibt es nur "
          "EINE Strafe!!!"),0);
    call_out("DoFakeDeath",0,caster);
    return 0;
  }
  illness=lower_case(illness);
  poison_diff=gottheilung_test(caster, victim, sinfo, illness, illnesses);
  if(!poison_diff) return 0;
  if(victim==caster) {
    Message(caster, 0, BS(sprintf("Du bereitest Dich darauf vor, mit der Macht "
      +"Dustys Deine%s %s zu heilen.\n", illness=="sprachfluch"?"n":"",
      CAP(illness))), 0);
    Message(caster, 0, BS(sprintf("%s konzentriert sich und scheint in "
        +"Meditation zu versinken.\n", caster->Name(WER))), 3);
  }
  else {
    Message(caster, 0, BS(sprintf("Du bereitest Dich darauf vor, mit der "
        +"Macht Dustys %s %s von %s zu heilen.\n", 
        illness=="sprachfluch"?"den":"die",CAP(illness),
        victim->name(WEM))), 0);
    Message(caster, victim, BS(sprintf("%s bereitet sich darauf vor, mit der "
        +"Macht Dustys Deine%s %s zu heilen.\n", caster->Name(WER),
        illness=="sprachfluch"?"n":"", CAP(illness))), 1);
    Message(caster, victim, BS(sprintf("%s konzentriert sich auf %s. "
        +"Vermutlich versucht %s %s zu heilen.", caster->Name(WER),
        victim->name(WEN), caster->QueryPronoun(WER),
        victim->QueryPronoun(WEN))), 2);
  }
 if((suc=SpellSuccess(caster, sinfo))<=0) {
   Message(caster, victim, BS("Dusty scheint Dich nicht erhoert zu haben. "
       +"Nichts passiert."),0);
   Message(caster, victim, BS("Nichts passiert."), 3);
   return MISSERFOLG;
 }
 gottheilung_mes1(caster, victim, sinfo, illness, poison_diff);
 if(victim!=caster && caster->QueryProp(P_ALIGN) <1100)
   caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)+random(30)+10);
 return ERFOLG;
}


static int gottheilung_test(object caster, object victim, mapping sinfo,
    string illness, mapping illnesses)
{
  int mp, poisonlevel, poison_diff;
  if(member(m_indices(illnesses), illness)==-1) {
    write("In Dustys Namen, das kannst Du nicht heilen!\n");
    return 0;
  }
  if(illness=="verfroschung") {
    if(!victim->QueryProp(P_FROG)) {
      if(victim==caster)
        write(BS(sprintf("Bei Dusty! Du bist kein Frosch!")));
      else
        write(BS(sprintf("Bei Dusty! %s ist kein Frosch!", victim->Name(WER))));
      return 0;
    }
    sinfo[SI_RAW_SPELLCOST]=40;
    sinfo=DoSpellModification(caster, sinfo);
  }
  else if(illness=="taubheit") {
    if(!victim->QueryProp(P_DEAF)) {
      if(victim==caster)
        write(BS(sprintf("Bei Dusty! Du bist nicht taub!")));
      else
        write(BS(sprintf("Bei Dusty! %s ist gar nicht taub!",
            victim->Name(WER))));
      return 0;
    }
    if(caster->QueryProp(P_GUILD_LEVEL)<illnesses[illness]) {
      write(BS("Paladin, Du musst Gildenstufe 6 sein, um Taubheit heilen "
          +"zu koennen."));
      return 0;
    }
    sinfo[SI_RAW_SPELLCOST]=50;
    sinfo=DoSpellModification(caster, sinfo);
  }
  else if(illness=="blindheit") {
    if(!victim->QueryProp(P_BLIND)) {
      if(victim==caster)
        write(BS(sprintf("Bei Dusty! Du bist gar nicht blind!")));
      else
        write(BS(sprintf("Bei Dusty! %s ist gar nicht blind!",
            victim->Name(WER))));
      return 0;
    }
    if(caster->QueryProp(P_GUILD_LEVEL)<illnesses[illness]) {
      write(BS("Paladin, Du musst Gildenstufe 8 sein, um Blindheit heilen "
          +"zu koennen."));
      return 0;
    }
    sinfo[SI_RAW_SPELLCOST]=60;
    sinfo=DoSpellModification(caster, sinfo);
  }
  else if(illness=="vergiftung") {
    if(!poisonlevel=victim->QueryProp(P_POISON)) {
      if(victim==caster)
        write(BS(sprintf("Bei Dusty! Du bist doch gar nicht vergiftet!")));
      else
        write(BS(sprintf("Bei Dusty! %s ist ueberhaupt nicht vergiftet!",
            victim->Name(WER))));
      return 0;
    }
    if(caster->QueryProp(P_GUILD_LEVEL)<illnesses[illness]) {
      write(BS("Paladin, Du musst Gildenstufe 10 sein, um Vergiftungen heilen "
          +"zu koennen."));
      return 0;
    }
    sinfo[SI_RAW_SPELLCOST]=25;
    mp=caster->QueryProp(P_SP);
    sinfo=DoSpellModification(caster, sinfo);
    poison_diff=mp/sinfo[SI_RAW_SPELLCOST];
    if(poison_diff == 0) {
      Message(caster,0,sinfo[SI_SP_LOW_MSG],0);
      return 0;
    }
    if(poison_diff>poisonlevel)
      poison_diff=poisonlevel;
    sinfo[SI_RAW_SPELLCOST]=sinfo[SI_RAW_SPELLCOST]*poison_diff;
  }
  else if(illness=="sprachfluch") {
    if(!objectp(present("\nsprachfluch", victim))) {
      if(victim==caster)
        write(BS(sprintf("Bei Dusty! Du bist gar nicht verflucht!")));
      else
        write(BS(sprintf("Bei Dusty! %s ist gar nicht verflucht!",
            victim->Name(WER))));
      return 0;
    }
    if(caster->QueryProp(P_GUILD_LEVEL)<illnesses[illness]) {
      write(BS("Paladin, Du musst Gildenstufe 12 sein, um Sprachflueche heilen "
          +"zu koennen."));
      return 0;
    }
    sinfo[SI_RAW_SPELLCOST]=200;
    sinfo=DoSpellModification(caster, sinfo);
  }
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    Message(caster,0,sinfo[SI_SP_LOW_MSG],0);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  return poison_diff||1;
}


static int gottheilung_mes1(object caster, object victim, mapping sinfo,
    string illness, int poison_diff)
{
  string tocaster, tovictim, toother;
  object ob;
  switch(illness) {
    case "taubheit":
      if(victim!=caster) {
         tocaster=sprintf("Dusty sei Dank! Durch goettliches Wirken "
             +"kann %s wieder hoeren!\n", victim->name(WER));
         tovictim=sprintf("Ploetzlich kannst Du wieder hoeren!!! Dusty "
             +"sei Dank!\n");
         toother=sprintf("%s scheint wieder hoeren zu koennen! Dustys "
             +"Macht muss wahrlich gross sein!\n", victim->Name(WER));
      }
      else {
         tocaster=sprintf("Bei der allmaechtigen Dusty! Du kannst wieder "
             +"hoeren!\n");
         toother=sprintf("%s scheint wieder hoeren zu koennen!\n",
             victim->Name(WER));
      }
      victim->SetProp(P_DEAF, 0);
      break;
    case "verfroschung":
      if(victim!=caster) {
        tocaster=sprintf("Dusty sei Dank! Durch goettliches Eingreifen "
            +"weicht die gruene Schuppenhaut von %s, und %s verwandelt sich "
            +"wieder zurueck.\n", victim->name(WEM), victim->QueryPronoun(WER));
        tovictim=sprintf("Du verwandelst Dich durch die Macht der "
            +"goettlichen Dusty zurueck in Deine urspruengliche Rasse. Dusty "
            +"sei Dank!\n");
        toother=sprintf("Durch die goettliche Macht Dustys wird %s "
            +"entfroscht.\n", victim->name(WER));
      }
      else {
       tocaster=sprintf("Gepriesen sei Dusty! Durch ihre goettliche Macht "
           +"verwandelst Du Dich zurueck! Heilig! Heilig! Heilig!\n");
       toother=sprintf("Ploetzlich verwandelt sich %s durch die goettliche "
           +"Macht Dustys zurueck.\n", caster->name(WER));
      }
      victim->SetProp(P_FROG, 0);
      break;
    case "blindheit":
      if(victim!=caster) {
        tocaster=sprintf("%s reisst %se Augen auf und kann wieder sehen! "
            +"Lob sei Dusty! Lob! Lob! Lob!\n", victim->Name(WER),
            victim->QueryPossPronoun(WER));
        tovictim=sprintf("Du spuerst ein Prickeln in Deinen Augen und reisst "
            +"sie weit auf! Du kannst wieder sehen! Dusty und %s sei Dank!\n",
            caster->name(WER));
        toother=sprintf("%s reisst %se Augen auf und kann wieder sehen! Das "
            +"muss ein goettliches Wunder sein!\n", victim->Name(WER),
            victim->QueryPossPronoun(WER));
      }

      else {
        tocaster=sprintf("Du betest kurz zu Dusty und reisst Deine Augen auf. "
            +"Du kannst wieder sehen! Gepriesen sei Dusty!\n");
        toother=sprintf("%s reisst %se Augen auf und kann wieder sehen! Das "
            +"muss ein goettliches Wunder sein!\n", caster->Name(WER),
            victim->QueryPossPronoun(WER));
      }
      victim->SetProp(P_BLIND, 0);
      break;
    case "sprachfluch":
      if(victim!=caster) {
        tocaster=sprintf("%s Zunge scheint nun wieder geloester zu sein! "
            +"Lob sei Dusty! Lob! Lob! Lob!\n", victim->Name(WESSEN));
        tovictim=sprintf("Du spuerst wie sich Deine Zunge wieder nach Deinem "
             "Willen bewegen kann! Dusty und %s sei Dank!\n",
            caster->name(WER));
        toother=sprintf("%s Zunge scheint nun wieder geloester zu sein! Das "
            +"muss ein goettliches Wunder sein!\n", victim->Name(WESSEN));
      }
      else {
        tocaster=sprintf("Du betest kurz zu Dusty und fuehlst, wie Deine "
            "Zunge wieder Deinem Willen gehorcht! Gepriesen sei Dusty!\n");
        toother=sprintf("%s scheint wieder normal reden zu koennen! Das "
            +"muss ein goettliches Wunder sein!\n", caster->Name(WER));
      }
      ob=present("\nsprachfluch", victim);
      catch(ob->remove());
      break;
    case "vergiftung":
      if(victim!=caster) {
        tocaster=sprintf("Du beruehrst die Wunden von %s, und ein silberner "
            +"Schimmer huscht ueber %se Haut. %s ist nun entgiftet! "
            +"Dusty sei Dank!\n", victim->name(WEM),
            victim->QueryPossPronoun(WER), CAP(victim->QueryPronoun(WER)));
        tovictim=sprintf("%s legt Dir die Hand auf die Wunden. Ein silberner "
            +"Schauer huscht ueber Deine Haut, und Du fuehlst Dich viel "
            +"besser.\n", caster->Name(WER));
        toother=sprintf("%s legt %s die Hand auf die Wunden, und ein silberner "
            +"Schauer huscht ueber %se Haut.\n", caster->Name(WER),
            victim->name(WEM), victim->QueryPossPronoun(WER));
      }
      else {
        tocaster=sprintf("Du legst Dir die Hand auf Deine Wunden. Ein silberner "
            +"Schauer huscht ueber Deine Haut, und Du bist entgiftet! "
            +"Gepriesen sei Dusty! Heilig! Heilig! Heilig!\n");
        toother=sprintf("%s legt sich die Hand auf die Wunden, und ein "
            +"silberner Schauer huscht ueber %se Haut.\n", caster->Name(WER),
            caster->QueryPossPronoun(WER));
      }
      victim->SetProp(P_POISON, victim->QueryProp(P_POISON)-poison_diff);
      break;
  }
  Message(caster, victim, BS(tocaster), 0);
  if(victim==caster)
    Message(caster, victim, BS(toother), 3);
  else {
    Message(caster, victim, BS(tovictim), 1);
    Message(caster, victim, BS(toother), 2);
  }
  return 1;
}





int wundenblick(object caster, mapping sinfo) {
  int suc, percent, hp, max_hp,i;
  object *liv;
  string str;

  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so keine Lebewesen "
         "erkennen!\n"),0);
    return 0;
  }

  if (ENV(caster) && ENV(caster)->_query_total_light() < 1) {
    Message(caster,0,
      BS("Bei Dusty, hier ist es VIEL zu dunkel dafuer!\n"),0);
    return 0;
  }

  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du flehst Dusty leise an, Dir die Wunden aller "
      +"im Raum zu zeigen...\n", 0);
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    Message(caster, 0, "Dusty scheint Deine Gebete nicht zu erhoeren!\n", 0);
    return MISSERFOLG;
  }
  if(!ENV(caster)) {
    Message(caster, 0, "Bei Dusty, das funktioniert hier nicht!\n", 0);
    return ERFOLG;
  }
  liv=filter_array(all_inventory(ENV(caster)), #'living);
  Message(caster,0,
    BS("Du kannst mit goettlicher Hilfe folgendes erkennen:"),0);
  Message(caster,0, BS("------------------------------------------------"
                       "------------------------------"), 0);
  for(i=sizeof(liv)-1;i>=0;i--) {
    if (liv[i]->QueryProp(P_INVIS)) continue;
    if (caster->InFight())
      if (!interactive(liv[i]) && !liv[i]->IsEnemy(caster)) continue;
    str=sprintf(" %-10s",liv[i]->Name(WER));
    hp=liv[i]->QueryProp(P_HP);
    if (hp < 0) hp=0;
    max_hp=liv[i]->QueryProp(P_MAX_HP);
    if (max_hp < 1) max_hp=1;
    percent=100*hp/max_hp;
    str+=perc2str(percent);
    Message(caster, 0, BS(str), 0);
  }
  Message(caster,0, BS("------------------------------------------------"
                       "------------------------------"), 0);
  return ERFOLG;
}


int prep_lokation(object caster, mapping sinfo) {
  if(caster->InFight()) {
    Message(caster,0,
      BS("Du solltest erst Deinen Gegner fuer Dusty besiegen!"),0);
    return 0;
  }
  if(!sinfo[SI_SKILLARG]) {
    Message(caster, 0, "Wen moechtest Du lokalisieren?\n", 0);
    return 0;
  }
  return 1;
}

int lokation(object caster, mapping sinfo) {
  object schein, victim, env_vic;
  int suc, dauer, value;
  string env_short, env_long, *exp_fn, vn, str, temp1, temp2;
  str="";
  if( !prep_lokation(caster, sinfo) ) return 0;
  if((!(victim=find_player(sinfo[SI_SKILLARG])) &&
      !(victim=find_living(sinfo[SI_SKILLARG]))) ||
       (victim && victim->QueryProp(P_INVIS)))
  {
     Message(caster, 0, "Bei Dusty, Du findest das Lebewesen nicht!\n", 0);
                  return 0;
  }
  if(victim==caster) {
    Message(caster, 0, BS("Dich selber zu lokalisieren hat wenig Sinn, "
       +"Paladin!"), 0);
    return 0;
  }
  if(!find_player("dusty") && !interactive(victim)) {
    Message(caster, 0, BS("Nur wenn Dusty anwesend ist, kannst Du dieses "
         "Lebewesen lokalisieren."),0);
    return 0;
  }
  if(!interactive(victim) && caster->QueryProp(P_ALIGN)<(900+random(400))) {
    Message(caster, 0, BS("Dusty laesst Dich dieses Lebewesen nicht "
        +"lokalisieren, Paladin!"), 0);
    return 0;
  }
  if(present(victim,ENV(caster))) {
    Message(caster, 0, BS(sprintf("Bei Dusty, %s steht doch direkt neben Dir!",
                       victim->name(WER))), 0);
    return 0;
  }
  if(IS_WIZARD(victim)) {
    Message(caster, 0, BS(
      "Magier stehen unter Dustys besonderem Schutz und Du siehst gar "
      "nichts!"), 0);
    return 0;
  }
  if(victim->QueryProp(P_TESTPLAYER)) {
    Message(caster, 0, BS(
      "Testspieler stehen unter Dustys besonderem Schutz und Du siehst gar "
      "nichts!"), 0);
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, BS(sprintf("Mit der Macht Dustys versuchst Du %s "
      +"zu lokalisieren.", victim->name(WEN))), 0);
  Message(caster, 0, sprintf("%s konzentriert sich...\n",caster->Name(WER)),
      3);
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    Message(caster, 0, BS(sprintf("Bei Dusty! Du kannst %s nicht "
        +"lokalisieren!\n", victim->name(WEN))), 0);
    Message(caster, 0, "Nichts passiert.\n", 3);
    if(suc<-2000 && ENV(victim))
      tell_room(ENV(victim), BS(sprintf("%s versuchte, diesen Ort zu "
          +"betrachten.", caster->Name(WER))));
    return MISSERFOLG;
  }
  vn=victim->Name(WER);
  Message(caster,0,BS("Dusty offenbart Dir folgendes:\n"), 0);
  printf(BS("--------------------------------------------------------"
      +"----------------------"));
  if(!(env_vic=ENV(victim))) {
    Message(caster, 0, BS(sprintf("%s befindet sich an einem geheimnissvollen "
        +"und unbekanntem Ort. Mehr kannst Du nicht erkennen.\n",
        vn)), 0);
    return ERFOLG;
  }
  env_long=env_vic->int_long(caster,caster,0);
  env_short=env_vic->QueryProp(P_INT_SHORT);
  exp_fn=explode(file_name(env_vic), "/");
  if(exp_fn[0]=="d") {
    printf(sprintf("%s befindet sich in der Region %s.\n", vn,
        CAP(exp_fn[1])));
  }
  else if(exp_fn[0]=="gilden") {
    printf(sprintf("%s befindet sich in der Gilde der/des %s.\n", vn,
        CAP(exp_fn[1])));
  }
  printf(BS(sprintf("Der Ort, wo %s sich befindet, nennt sich '%s'.\n",
      victim->QueryPronoun(WER), env_short)));
  str="Normalerweise ist es dort ";
  switch (env_vic->QueryProp(P_LIGHT)||1) {
    case -10000..-3: temp1="unglaublich dunkel.";
                     break;
    case -2..-1:     temp1="sehr dunkel.";
                     break;
    case 0:          temp1="dunkel.";
                     break;
    default:
    case 1:          temp1="hell.";
                     break;
    case 2..3:       temp1="sehr hell.";
                     break;
    case 4..10000:   temp1="unglaublich hell.";
                     break;
  }
  str+=temp1;
  switch (env_vic->_query_total_light()||1) {
    case -10000..-3: temp2="unglaublich dunkel.";
                     break;
    case -2..-1:     temp2="sehr dunkel.";
                     break;
    case 0:          temp2="dunkel.";
                     break;
    default:
    case 1:          temp2="hell.";
                     break;
    case 2..3:       temp2="sehr hell.";
                     break;
    case 4..10000:   temp2="unglaublich hell.";
                     break;
  }
  if (temp1 != temp2) {
    str+=" Derzeit ist es dort aber "+temp2;
  }
  printf(BS(str));
  if(value=(env_vic->QueryProp(P_ENVIRONMENT))[ENV_TEMPERATURE]) {
    str="Die Temperatur an diesem Ort ist ";
    switch(value||20) {
      case -10000..-50: str+="toetlich kalt."; break;
      case -49..-30   : str+="extrem kalt."; break;
      case -29..-10   : str+="eiseskalt."; break;
      case -09..04    : str+="kalt."; break;
      case  05..15    : str+="mittelmaessig warm."; break;
      case  16..25    : str+="angenehm warm."; break;
      case  26..30    : str+="warm."; break;
      case  31..40    : str+="heiss."; break;
      case  41..50    : str+="extrem heiss."; break;
      case  51..10000 : str+="toetlich heiss."; break;
      default         : str+="undefinierbar kalt oder warm."; break;
    }
    printf(BS(str));
  }
  if(value=env_vic->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]) {
    str="Der Ort befindet sich ";
    switch(value||TT_OTHER) {
      default:
      case TT_OTHER: str+="in einem unbekannten Terrain.";
                     break;
      case TT_CAVE:  str+="in einer hoehlenaehnlichen Umgebung.";
                     break;
      case TT_HOUSE: str+="in einer geschlossenen Umgebung.";
                     break;
      case TT_HILL:  str+="in einer huegelligen Gegend.";
                     break;
      case TT_FOREST:str+="in einer waldaehnlichen Gegend.";
                     break;
      case TT_TOWN:  str+="in einer stadtaehnlichen Gegend.";
                     break;
      case TT_MOUNTAIN: str+="in einer sehr bergigen Gegend.";
                     break;
      case TT_DESERT:str+="in einer wuestenaehnlichen Gegend.";
                     break;
      case TT_JUNGLE:str+="in einer dschungelaehnlichen Gegend.";
                     break;
      case TT_SWAMP: str+="in einer mooraehnlichen Gegend.";
                     break;
      case TT_PLAIN: str+="in einer flachen Gegend.";
                     break;
      case TT_ARCTIC:str+="in einer arktischen Gegend.";
                     break;
      case TT_UNDERWATER:str+="unter Wasser.";
                     break;
      case TT_ROAD:  str+="in einer strassenaehnlichen Gegend.";
                     break;
    }
    printf(BS(str));
  }
  printf(BS(sprintf("Wenn Du Dich dort befinden wuerdest, wuerdest "
      +"Du folgendes sehen:")));
  printf("\n"+env_long);
  printf(BS("--------------------------------------------------------"
      +"----------------------"));
  tell_room(env_vic, BS("Du spuerst, wie der Ort hier betrachtet wird..."),
      ({caster}));
  Message(caster, victim, BS(sprintf("%s scheint nun wissender zu sein.\n",
      caster->Name(WER))), 3);
  return ERFOLG;
}


int prep_reparatur(object caster, mapping sinfo) {
  string str;
  object ob;
  if(caster->InFight()) {
    Message(caster,0,
      BS("Du solltest erst Deinen Gegner fuer Dusty besiegen!"),0);
    return 0;
  }
  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so nichts reparieren!\n"),0);
    return 0;
  }
  if (ENV(caster) && ENV(caster)->_query_total_light() < 1) {
    Message(caster,0,
      BS("Bei Dusty, hier ist es VIEL zu dunkel dafuer!\n"),0);
    return 0;
  }
  str=sinfo[SI_SKILLARG];
  if(!str) {
    write(BS("Was in Dustys Namen moechtest Du reparieren?"));
    return 0;
  }
  if(!ob=present(str, caster)) {
    write("Diesen Gegenstand besitzt Du gar nicht, Paladin!\n");
    return 0;
  }
  if(environment(ob) != caster) {
    write(BS("Du musst den Gegenstand schon bei Dir tragen, Paladin!\n"));
    return 0;
  }
  return 1;
}

int reparatur(object caster, mapping sinfo) {
  object ob;
  string result, str;
  int suc,was;
  int dam, wert, rep, damrest, plus, fail_dam;
  mapping temp;

  if( !prep_reparatur( caster, sinfo) ) return 0;
  ob=present(sinfo[SI_SKILLARG], caster);
  if(ob->QueryProp(P_WEAPON_TYPE)) {
    if(ob->QueryProp(P_WEAPON_TYPE) == WT_MISC) {
      write(BS("Diesen seltsamen Waffentyp kannst Du nicht reparieren, Paladin!"));
      return 0;
    }
    wert = ob->QueryProp(P_WC);
    plus = 1;
  } else if(ob->QueryProp(P_ARMOUR_TYPE)) {
    if(ob->QueryProp(P_ARMOUR_TYPE) == AT_MISC) {
      write(BS("Diesen seltsamen Ruestungstyp kannst Du nicht reparieren, Paladin!"));
      return 0;
    }
    wert = ob->QueryProp(P_AC);
    plus = 2;
  } else {
    write("Du kannst nur Waffen und Ruestungen reparieren, Paladin!\n");
    return 0;
  }
  if(ob->Query(P_WC,F_QUERY_METHOD) || ob->Query(P_AC,F_QUERY_METHOD)) {
    write(BS(
      "Auf diesem Gegenstand liegt ein Segen von Dusty. Du kannst ihn solange "
      "nicht reparieren!!"));
    return 0;
  }
  if(!dam=ob->QueryProp(P_DAMAGED)) {
    write("Dieser Gegenstand bedarf gar keiner Reparatur, Paladin!\n");
    return 0;
  }
  damrest=(wert+dam)*(78+caster->QueryProp(P_GUILD_LEVEL))/100;
  if (wert>=damrest) {
    Message(caster, 0, BS(sprintf(
      "Deine Faehigkeiten reichen nicht dafuer aus, um "+ob->name(WEN)+
      " weiter zu reparieren, Paladin!")), 0);
    return 0;
  }
  rep=caster->QueryProp(P_GUILD_LEVEL)/plus;
  if (wert+rep > damrest) {
    rep=damrest-wert;
  }

  if (rep < 1) {
    Message(caster, 0, BS(
      "Oh bei Dusty, mit diesem Gegenstand stimmt etwas nicht."), 0);
    tell_za(sprintf(
      "Achtung, Fehler im Paladin-Spell 'Reparatur': PL: %s, OBJ: %O, REP: "
      "%d, WERT: %d, DAM: %d, DAMREST: %d\n",
      getuid(caster),ob,rep,wert,dam,damrest));
    return 0;
  }

  temp=copy_mapping(sinfo);
  temp[SI_RAW_SPELLCOST]=temp[SI_RAW_SPELLCOST] * rep * plus;
  temp=DoSpellModification(caster, temp);

  while ((caster->QueryProp(P_SP) < temp[SI_RAW_SPELLCOST]) && (rep > 0)) {
    rep--;
    temp=copy_mapping(sinfo);
    temp[SI_RAW_SPELLCOST]=temp[SI_RAW_SPELLCOST] * rep * plus;
    temp=DoSpellModification(caster, temp);
// tell_zordan(sprintf("%d %d %d %d %O\n",wert,dam,damrest,rep,sinfo));
  }

  sinfo[SI_RAW_SPELLCOST]=sinfo[SI_RAW_SPELLCOST] * rep * plus;
  sinfo=DoSpellModification(caster, sinfo);

  if ((caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) || (rep < 1)) {
    Message(caster,0,sinfo[SI_SP_LOW_MSG],0);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  Message(caster, 0, BS(
    sprintf("Du faengst mit Dustys Unterstuetzung an, %s zu reparieren.\n",
            ob->name(WEN,1))),0);
  Message(caster, 0, BS(
    sprintf("%s faengt mit Dustys Unterstuetzung an, %s zu reparieren.\n",
             caster->Name(WER),ob->name(WEN))),3);
  if ((suc=SpellSuccess(caster,sinfo))<=0)
  {
    Message(caster, 0, "Bei Dusty! Deine Reparatur schlaegt fehl!\n", 0);
    Message(caster, 0, BS(
      sprintf("%s kann die Reparatur nicht vollenden und bricht sie ab.",
      caster->Name(WER))),3);
    // in 10% der Fehlschlaege etwas Damage (woody, 30.8.2000)
    if (random(100) > 90)
      fail_dam=ob->Damage(random(3));
      if(!objectp(ob)) 
        return MISSERFOLG;
      switch (fail_dam) {
        case 2:
          Message(caster, 0, BS(
            sprintf("Unvorsichtig wie Du bist, beschaedigst Du %s sogar "
              "etwas!", ob->name(WEN,1))), 0);
        case 1:
          Message(caster, 0, BS(
            sprintf("Unvorsichtig wie Du bist, beschaedigst Du %s sogar "
              "ein bisschen!", ob->name(WEN,1))), 0);
      }
    return MISSERFOLG;
  }
  if (rep/2 > 7) rep=15;
  switch(rep/2) {
    case 7:  str="sehr gut"; break;
    case 6:  str="ziemlich gut"; break;
    case 5:  str="recht gut"; break;
    case 4:  str="mittelmaessig"; break;
    case 3:  str="teilweise"; break;
    case 2:  str="ein wenig"; break;
    default: str="sehr wenig"; break;
  }
  Message(caster,0, BS(
    sprintf("Um Deine Haende bildet sich ein silberner Schimmer. Die "
            "Reparatur geht gut voran und Du steckst %s %s "
            "repariert wieder ein.",ob->name(WEN,1),str)), 0);
  Message(caster,0, BS(
    sprintf("Um die Haende von %s bildet sich ein silberner Schimmer. Die "
            "Reparatur geht gut voran und %s steckt %s %s repariert "
            "wieder ein.",
            caster->name(WEM),caster->QueryPronoun(WER),
            ob->name(WEN,1),str)), 3);
  Message(caster, 0, BS(
    "Der Schimmer um Deine Haende verblasst wieder.\n"),0);
  Message(caster, 0, BS(
    sprintf("Der Schimmer um %s Haende verblasst wieder.\n",
             caster->name(WESSEN))),3);

  // woody (30.8.2000): niemals nicht P_AC oder P_WC vor dem
  //   Korrigieren der P_DAMAGED setzen, sonst folgt u.U. fuer
  //   kurze Zeit ein ungueltiger Gesamtwert!! Stattdessen die
  //   vorgesehene Funktion Damage() verwenden!
  /*
  if( ob->QueryProp(P_WEAPON_TYPE)) {
    ob->SetProp(P_WC,ob->QueryProp(P_WC)+rep);
  } else if( ob->QueryProp(P_ARMOUR_TYPE)) {
    ob->SetProp(P_AC,ob->QueryProp(P_AC)+rep);
  }
  ob->SetProp(P_DAMAGED,ob->QueryProp(P_DAMAGED)-rep);
  */

  ob->Damage(-rep);     // um 'rep' Schadenspunkte reparieren

  return ERFOLG;
}




int is_wiz_level_ge(object ob, mixed x) { return (query_wiz_level(ob)>=x); }

int prep_meditation(object caster, mapping sinfo) {
  object *inv;
  if(caster->InFight()) {
    Message(caster,0,
      BS("Du solltest erst Deinen Gegner fuer Dusty besiegen!"),0);
    return 0;
  }
  if(ENV(caster)) {
    inv=filter_array(all_inventory(ENV(caster)), #'living)-
        filter_array(users(),"is_wiz_level_ge",ME,LEARNER_LVL);
    if(sizeof(inv)>1) {
      Message(caster, 0, BS("Du musst alleine sein, um meditieren zu "
          +"koennen, Paladin!"), 0);
      return 0;
    }
  }
  if(sinfo[SI_SKILLARG]!=0) {
    Message(caster,0,
      BS("Du kannst nur ganz alleine fuer Dich meditieren."),0);
    return 0;
  }
  return 1;
}
int meditation(object caster, mapping sinfo) {
  object ob, *inv;
  int suc,dauer,step, i;

  if( !prep_meditation( caster, sinfo) ) return 0;
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    Message(caster,0,sinfo[SI_SP_LOW_MSG],0);
    return 0;
  }

  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, BS(
    "Du kniest nieder und legst einen Unterschenkel auf den Boden. Du "
    "schliesst Deine Augen, verschraenkst Deine Arme und versuchst jetzt fuer "
    "Dusty in eine sehr tiefe Meditation zu versinken."), 0);
  Message(caster, 0, BS(sprintf(
    "%s kniet nieder und legt einen Unterschenkel auf den Boden. %s Augen "
    "schliessen sich.\n",
    caster->Name(WER), CAP(caster->QueryPossPronoun(2)))), 3);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS(
      "Du spuerst einen stechenden Schmerz in Deinem Herzen und reisst Deine "
      "Augen wieder auf. Im Moment gelingt es Dir einfach nicht, in eine "
      "tiefe Meditation zu versinken."), 0);
    Message(caster, 0, BS(sprintf(
      "%s verzieht das Gesicht und %s reisst %s Augen wieder auf.",
      caster->Name(WER), caster->QueryPronoun(WER),
      caster->QueryPossPronoun(2))), 3);
    return MISSERFOLG;
  }
  dauer=15+2*caster->QueryProp(P_GUILD_LEVEL)+(caster->QueryAttribute(A_INT)
        *suc/MAX_ABILITY);
    // min=15+2*6=27 Sekunden , max=15+30+30=75 sekunden
  dauer=DoModificationByAlign(dauer, caster);
  if (dauer>80) dauer=80;
  step=7-(caster->QueryProp(P_GUILD_LEVEL)/4+suc/4500);
    // min=7-3-2=2 , max=7-1-0=6
  if (step<2) step=2;
  //tell_zordan("Dauer: "+dauer+", Step:"+step+"\n");
  ob=clone_object(OBJ("meditation"));
  ob->move(caster, M_NOCHECK|M_SILENT);
  ob->start_remove(dauer,step,suc);
  caster->SetProp(P_PARALYZED, ([
            PARALYZE_TIME:100000,
            PARALYZE_MSG:
              "Bei Dusty, Du bist in eine tiefe Meditation versunken.\n",
            PARALYZE_MSG_OTHER:
              "%s ist in eine tiefe Meditation versunken.\n",
            PARALYZE_END:"",
            PARALYZE_END_OTHER:"" ]));
  Message(caster, 0, BS(
    "Du wirst total ruhig und versinkst in eine tiefe Meditation."), 0);
  Message(caster, 0, BS(sprintf(
    "%s wird total ruhig und versinkt in eine tiefe Meditation.",
    caster->Name(WER))), 3);
  return ERFOLG;
}


int prep_entfluche(object caster, mapping sinfo) {
  object ob;
  string str;
  if(caster->InFight()) {
    Message(caster,0,
      BS("Du solltest erst Deinen Gegner fuer Dusty besiegen!"),0);
    return 0;
  }
  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so nichts entfluchen!\n"),0);
    return 0;
  }
  str=sinfo[SI_SKILLARG];
  if(!str) {
    write(BS("Was in Dustys Namen moechtest Du entfluchen?"));
    return 0;
  }
  if(!ob=deep_present(str, caster)) {
    write("Diesen Gegenstand besitzt Du gar nicht, Paladin!\n");
    return 0;
  }
  if(!ob->QueryProp(P_CURSED)) {
    write("Dusty sei Dank! "+ob->Name(WER)+" ist gar nicht verflucht!\n");
    return 0;
  }
  return 1;
}


int entfluche(object caster, mapping sinfo) {
  object ob;
  string result,str;
  int suc;

  if( !prep_entfluche( caster, sinfo) ) return 0;
  ob=deep_present(sinfo[SI_SKILLARG], caster);
  if(ob->QueryProp(P_NEKRO_PESTERED)) {
    write(BS(sprintf("Ploetzlich loest sich %s mit einem haesslichen Zischen "
         "auf!", ob->name(WER))));
    Message(caster, 0, BS(sprintf(
            "Ploetzlich loest sich %s von %s mit einem haesslichen "
            "Zischen auf.", ob->name(WER), caster->name(WER))));
    ob->SetProp(P_CURSED, 0);
    ob->remove();
    caster->AddHp(-random(100));
    caster->AddSp(-random(100));
    return 0;
  }
  if(ob->QueryProp(P_AUTOLOADOBJ) || ob->id("NOUNCURSE") ||
     ob->id("QUESTITEM") || living(ob)) {
    write("Dusty verbietet es Dir, "+ob->name(WEN)+" zu entfluchen!\n");
    return 0;
  }

  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    Message(caster,0,sinfo[SI_SP_LOW_MSG],0);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  Message(caster, 0, BS(
    sprintf("Du legst %s vor Dich auf den Boden und kniest Dich davor.\n",
            ob->name(WEN))),0);
  Message(caster, 0, BS(
    sprintf("%s legt %s vor sich auf den Boden und kniet sich davor.\n",
             caster->Name(WER),ob->name(WEN))),3);
  Message(caster, 0, BSA(
    "OH Dusty, bei allen guten Geistern und Goettern. Erhoere mich und "
    "entfluche diesen frevelhaften Gegenstand!","Du rufst: "),0);
  Message(caster, 0, BSA(
    "OH Dusty, bei allen guten Geistern und Goettern. Erhoere mich und "
    "entfluche diesen frevelhaften Gegenstand!",
    caster->Name(WER)+" ruft: "),3);
  if ((suc=SpellSuccess(caster,sinfo))<=0) {
    Message(caster, 0, BS(
      sprintf("Bei Dusty! Deine Konzentration war nicht hoch genug!\n")), 0);
    Message(caster, 0, BS(
      "Nichts passiert."),3);
    Message(caster, 0, BS(
      sprintf("Du nimmst %s wieder an Dich.\n",
              ob->name(WEN))),0);
    Message(caster, 0, BS(
      sprintf("%s nimmt %s wieder an sich.\n",
               caster->Name(WER),ob->name(WEN))),3);
    return MISSERFOLG;
  }
  Message(caster,0, BS(
    sprintf("Auf einmal bildet sich um %s ein silberner Schleier. Der "
            "Schleier verweilt eine Weile und loest sich dann im Nichts "
            "wieder auf. Du dankst Dusty fuer ihre Hilfe.",ob->name(WEM))), 0);
  Message(caster,0, BS(
    sprintf("Auf einmal bildet sich um %s ein silberner Schleier. Der "
            "Schleier verweilt eine Weile und loest sich dann im Nichts "
            "wieder auf.",ob->name(WEM))), 3);
  Message(caster, 0, BS(
    sprintf("Du nimmst %s wieder an Dich.\n",
            ob->name(WEN))),0);
  Message(caster, 0, BS(
    sprintf("%s nimmt %s wieder an sich.\n",
             caster->Name(WER),ob->name(WEN))),3);
  ob->SetProp(P_CURSED,0);
  return ERFOLG;
}


int prep_zielattacke(object caster, mapping sinfo) {
  object weapon, victim;
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
             "Welchen Frevler moechtest Du vernichten?\n");
  if(!victim) return 0;
  if(!weapon=caster->QueryProp(P_WEAPON)) {
    write(BS("Paladin! Du musst schon eine Waffe gezueckt haben!\n"));
    return 0;
  }
  if(weapon->QueryProp(P_WEAPON_TYPE)!=WT_SWORD) {
    write(BS("Paladin! Eine Zielattacke kannst Du nur mit einem Schwert "
        +"durchfuehren!\n"));
    return 0;
  }
  /* if(weapon->QueryProp(P_NR_HANDS)>1) {
    write(BS("Paladin! Eine Zielattacke kannst Du nur mit einem "
        +"einhaendigem Schwert durchfuehren!\n"));
    return 0;
  }*/
  if(interactive(caster) && caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so keine gezielte Attacke "
         "ausfuehren!\n"),0);
    return 0;
  }
  return 1;
}

int zielattacke(object caster, mapping sinfo) {
  object weapon, victim;
  int wc,suc;
  float fix;
  mixed damtype;
  int weap_cl, gl;

  if( !prep_zielattacke( caster, sinfo) ) return 0;
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
             "Welchen Frevler moechtest Du vernichten?\n");
  weapon=caster->QueryProp(P_WEAPON);
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du rufst: DUSTY STEH MIR BEI!!\nDu attackierst "
      +"Deinen Feind!\n", 0);
  Message(caster, victim, sprintf("%s ruft: DUSTY STEH MIR BEI!!\n%s "
      +"attackiert %s!\n", caster->Name(WER), caster->Name(WER),
      victim->name(WEN)), 2);
  Message(caster, victim, sprintf("%s ruft: DUSTY STEH MIR BEI!!\n%s "
      +"attackiert Dich!!\n", caster->Name(WER), caster->Name(WER)), 1);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS(sprintf("%s weicht geschickt aus. Du verfehlst!\n",
        victim->Name(WER))), 0);
    Message(caster, victim, BS(sprintf("%s weicht geschickt aus. %s verfehlt "
        +"%s.\n", victim->Name(WER), caster->Name(WER),
        victim->QueryPronoun(WEN))), 2);
    Message(caster, victim, BS(sprintf("Du weichst geschickt aus. %s "
        +"verfehlt Dich.", caster->Name(WER))), 1);
    return MISSERFOLG;
  }
  if(suc>8000) {
    if(!random(5))
      victim->ModifySkillAttribute(caster, SA_SPEED, 200, 2+random(6));
  }
  wc=weapon->QueryProp(P_WC);
  if(!fix=weapon->QueryProp(P_WC_FIXFACTOR))
    fix=0.3;
  if(!damtype=weapon->QueryProp(P_DAM_TYPE))
    damtype=({DT_HOLY});
  else
    damtype+=({DT_HOLY});

  weap_cl=wc;
  gl=caster->QueryProp(P_GUILD_LEVEL);

  wc+=random(20)+wc*caster->QueryProp(P_GUILD_LEVEL)/15+wc*suc/
    (2*MAX_ABILITY);
  wc=DoModificationByAlign(wc, caster, victim);
  if(wc>900) wc=900;
  sinfo[SI_SKILLDAMAGE]=(int)wc*(1-fix);
  sinfo[OFFSET(SI_SKILLDAMAGE)]=(int)wc*fix;
  sinfo[SI_SKILLDAMAGE_TYPE]=damtype;
  // ZUM LOGGEN DER SPELLSTAERKE!
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/zielattacke",
        sprintf("CST: %O, VIC: %O, CA: %d, VA: %d\n   suc: %d, dam: %d (WC: "
            +"%d, GL: %d), "
            +"fix: %.2f\n", caster, victim->Name(RAW),
            caster->QueryProp(P_ALIGN), victim->QueryProp(P_ALIGN), suc, wc,
            weap_cl, gl, fix));
  // ----------------------------
  Message(caster, 0, BS("Mit goettlicher Wucht dringt Deine Waffe in Deinen "
      +"Gegner ein! Gepriesen sei Dusty! Heilig! Heilig! Heilig!"), 0);
  Message(caster, victim, BS(sprintf("Die Waffe von %s dringt mit goettlicher "
      +"Wucht in Dich ein!!!!!", caster->name(WEM))), 1);
  Message(caster, victim, BS(sprintf("Die Waffe von %s dringt mit "
      +"goettlicher Wucht in %s ein!!", caster->name(WEM),
      victim->name(WEN))), 2);
  TryAttackSpell(victim, wc, damtype, ([SP_NAME:"zielattacke",
        SP_SHOW_DAMAGE:1, SP_PHYSICAL_ATTACK:1]), caster, sinfo);
  weapon->TakeFlaw();
  return ERFOLG;
}




int heiligengebet(object caster, mapping sinfo) {
  object victim;
  int suc, dam;
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
             "Welchen Frevler moechtest Du strafen?\n");
  if(!victim) return 0;
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, BSA(sprintf("DUSTY! Erhoere "
      +"mich und strafe %s mit Deiner Macht!", victim->name(WEN)),
      "Du rufst: "), 0);
  Message(caster, 0, BSA(sprintf("DUSTY! Erhoere "
      +"mich und strafe %s mit Deiner Macht!", victim->name(WEN)),
       caster->Name(WER)+" ruft: "), 3);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS("Dusty erhoert Dein Flehen nicht!\n"), 0);
    Message(caster, 0, BS("Nichts passiert.\n"), 3);
    return MISSERFOLG;
  }
  if(suc>7000) {
    if(!random(5))
      victim->ModifySkillAttribute(caster, SA_SPEED, 200, 2);
  }
  dam=sinfo[SI_SKILLDAMAGE]+caster->QueryProp(P_GUILD_LEVEL)*3;
  sinfo[SI_SKILLDAMAGE]=DoModificationByAlign(dam, caster, victim);

  if (sinfo[SI_SKILLDAMAGE] > 350) sinfo[SI_SKILLDAMAGE]=350;
  // ZUM LOGGEN DER SPELLSTAERKE!
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/heiligengebet",
        sprintf("CST: %O, CA: %d, VA: %d, suc: %d, dam: %d\n",
            caster, caster->QueryProp(P_ALIGN), victim->QueryProp(P_ALIGN),
            suc, sinfo[SI_SKILLDAMAGE]));
  // ----------------------------
  Message(caster, 0, BS(sprintf("Es zuckt ein Blitz aus "
      +"Deiner Hand und trifft %s! Gepriesen sei Dusty!",
      victim->name(WEN))), 0);
  Message(caster, victim, BS(sprintf("Es zuckt ein Blitz "
      +"aus der Hand von %s und trifft Dich!", caster->name(WER))),1);
  Message(caster, victim, BS(sprintf("Es zuckt ein Blitz "
      +"aus der Hand von %s und trifft %s!", caster->name(WER),
      victim->name(WEN))),2);
  TryDefaultAttackSpell(victim,caster,sinfo,
            ([SP_NAME:"heiligengebet", SP_SHOW_DAMAGE:1]));
  return ERFOLG;
}


int prep_ruestungssegen(object caster, mapping sinfo) {
  string what;
  object armour;
  what=sinfo[SI_SKILLARG];
  if(!what) {
    write(BS("Was in Dustys Namen moechtest Du segnen?"));
    return 0;
  }
  if(!armour=deep_present(what, caster)) {
    write("Diese Ruestung besitzt Du nicht, Paladin!\n");
    return 0;
  }
  if(present("\nruestungssegen", caster)) {
    write("Du hast schon eine Ruestung geweiht, Paladin!\n");
    return 0;
  }
  if(!armour->QueryProp(P_ARMOUR_TYPE)) {
    write(BS("Das ist keine Ruestung, Paladin!\n"));
    return 0;
  }
  return 1;
}


int ruestungssegen(object caster, mapping sinfo) {
  object armour, segen;
  int suc, ac_value, time;
  string text, what;
  mapping v_ac;
  v_ac=VALID_ARMOUR_CLASS;
  what=sinfo[SI_SKILLARG];

/*
  if (!caster->QueryProp(P_TESTPLAYER)) {
  write(BS(
    "!!! ACHTUNG, dieser Spell musste wegen diverser Bugs abgehaengt werden! "
    "Wir arbeiten dran, aber wann und wo und wie ... Sorry, Zordan !!!"));
  return 0;
  }
*/
  if( !prep_ruestungssegen( caster, sinfo) ) return 0;
  armour=deep_present(what, caster);
  if(armour->QueryProp(P_ITEMD)) {
    write(BS("Paladin! Diese magische Ruestung kannst Du nicht segnen!"));
    return 0;
  }
  if(armour->QueryProp(P_DEFEND_FUNC)) {
    write(BS("PALADIN! Diese Ruestung kannst Du nicht segnen."));
    return 0;
  }
  if(armour->Query(P_DEFEND_FUNC,F_QUERY_METHOD)) {
    write(BS(
      "ARGL. Hier stimmt was mit der Ruestung nicht. Bitte benachrichtige "
      "Angrox oder Zordan sofort!!!"));
    write_file("/gilden/paladine/spells/ruestungssegen.bad",
      sprintf("%s: %s mit %O\n",ctime(),CAP(getuid(caster)),armour));
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  text="Herrin Dusty, in Deinem Namen weihe "
      +"ich diese Ruestung, um damit gegen die Ausgeburten der Unterwelt "
      +"gewappnet zu sein! Ehre sei Dusty! Ehre! "
      +"Ehre! Ehre!";
  Message(caster, 0,sprintf("Du beruehrst %s.\n",
      armour->name(WEN)), 0);
  Message(caster, 0,sprintf("%s beruehrt %s.\n",
     caster->Name(WER), armour->name(WEN)), 3);
  Message(caster, 0, BSA(text,"Du rufst: "), 0);
  Message(caster, 0, BSA(text, caster->Name(WER)+" ruft: "), 3);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS("Dusty scheint Dich nicht zu erhoeren. "
        +"Nichts passiert."), 0);
    Message(caster, 0, BS(sprintf("Nichts passiert. Offenbar scheint Dusty "
        +"%s nicht erhoert zu haben.", caster->name(WER))), 3);
    armour->TakeFlaw( ({ DT_BLUDGEON }) );
    return MISSERFOLG;
  }
  Message(caster, 0, BS(sprintf("%s leuchtet kurz in silbrigem Licht "
      +"auf! Dusty hat Dich erhoert! Ehre sei Dusty!\n",
      armour->Name(WER))), 0);
  Message(caster, 0, BS(sprintf("%s von %s leuchtet kurz silbrig auf.\n",
      armour->Name(WER), caster->name(WER))), 3);
  segen=CLONEOB(OBJ("ruestungssegen"));
  segen->move(caster, M_NOCHECK|M_SILENT);
  caster->SetProp(PAL_RUESTUNGSSEGEN, 1);
  ac_value=((armour->QueryProp(P_AC)/2)+GetAlign(caster)/50)/3;
  ac_value=DoModificationByAlign(ac_value, caster);
  if(ac_value<1) ac_value=1;
  if(ac_value>25) ac_value=25;
  time=caster->QueryProp(P_GUILD_LEVEL)*10;
  time=DoModificationByAlign(time, caster);
  segen->SetVariables(caster, armour, time, ac_value);
  return ERFOLG;
}


int prep_waffensegen(object caster, mapping sinfo) {
  object weapon, wielded;
  string what;
  what=sinfo[SI_SKILLARG];
  if(!what) {
    write(BS("Was in Dustys Namen moechtest Du segnen?"));
    return 0;
  }
  if(!wielded=caster->QueryProp(P_WEAPON)) {
    write("Paladin! Du hast keine Waffe gezueckt!\n");
    return 0;
  }
  if(!weapon=deep_present(what, caster)) {
    write("Diese Waffe besitzt Du nicht, Paladin!\n");
    return 0;
  }
  if(weapon->id(what) && !wielded->id(what)) {
    write(BS("Paladin! Du musst schon die Waffe gezueckt haben, die "
        +"Du segnen willst!\n"));
    return 0;
  }
  weapon=wielded;
  if(present("\nwaffensegen", caster)) {
    write("Du hast schon eine Waffe geweiht, Paladin!\n");
    return 0;
  }
  return 1;
}

int waffensegen(object caster, mapping sinfo) {
  object weapon, segen;
  int suc, wc_value, time, wc_boni;
  string text, what;
  what=sinfo[SI_SKILLARG];

  /*
  write(BS(
    "!!! ACHTUNG, dieser Spell musste wegen diverser Bugs abgehaengt werden! "
    "Wir arbeiten dran, aber wann und wo und wie ... Sorry, Zordan !!!"));
  return 0;
  */
  if ( !prep_waffensegen( caster,  sinfo) ) return 0;
  weapon=caster->QueryProp(P_WEAPON);
  if(weapon->id(AMARYLLION)) {
    write(BS("Paladin! Du kannst Amaryllion nicht weihen, denn es ist "
            +"schon geweiht!"));
    return 0;
  }
  if(weapon->QueryProp(P_CURSED)) {
    write(BS("Bei Dusty, diese Waffe ist verflucht und laesst sich nicht "
           +"weihen!"));
    return 0;
  }
  if(weapon->QueryProp(P_ITEMD)) {
    write(BS("Paladin! Diese magische Waffe kannst Du nicht weihen!"));
    return 0;
  }
  if(weapon->Query(P_WC,F_QUERY_METHOD) ||
     weapon->Query(P_WC_BONUS,F_QUERY_METHOD)) {
    write(BS(
      "ARGL. Hier stimmt was mit der Waffe nicht. Bitte benachrichtige "
      "Angrox oder Zordan sofort!!!"));
    write_file("/gilden/paladine/spells/waffensegen.bad",
      sprintf("%s: %s mit %O\n",ctime(),CAP(getuid(caster)),weapon));
    return 0;
  }
  if(caster->QueryProp(P_GUILD_LEVEL) < 13 && 
      (weapon->QueryProp(P_WIELD_FUNC) || weapon->QueryProp(P_UNWIELD_FUNC))) 
  {
    write(BS(
      "Auch mit groesster Muehe wuerde es Dir nicht gelingen, diese "
      "Waffe zu weihen. Sie scheint naemlich schon etwas besonderes "
      "zu koennen!"));
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  text="Herrin Dusty, in Deinem Namen weihe "
      +"ich Dir diese Waffe, um damit die Ausgeburten der Unterwelt "
      +"und die verderbten Seelen zu vernichten! Ehre sei Dusty! Ehre! "
      +"Ehre! Ehre!";
  Message(caster, 0,sprintf("Du reckst %s gen Himmel.\n",
      weapon->name(WEN)), 0);
  Message(caster, 0,sprintf("%s reckt %s gen Himmel.\n",
     caster->Name(WER), weapon->name(WEN)), 3);
  Message(caster, 0, BSA(text,"Du rufst: "), 0);
  Message(caster, 0, BSA(text, caster->Name(WER)+" ruft: "), 3);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS("Dusty scheint Dich nicht zu erhoeren. "
        +"Nichts passiert."), 0);
    Message(caster, 0, BS(sprintf("Nichts passiert. Offenbar scheint Dusty "
        +"%s nicht erhoert zu haben.", caster->name(WER))), 3);
    weapon->TakeFlaw();
    return MISSERFOLG;
  }
  weapon->DoUnwield(1);
  if(weapon->QueryProp(P_WIELDED)) {
    write(BS(
      "Ein dunkler Blitz trifft Dich mitten ins Herz! Diese Waffe "
      "solltest Du besser mit Vorsicht geniessen!"));
    return 0;
  }
  Message(caster, 0, BS(sprintf("%s leuchtet kurz in silbrigem Licht "
      +"auf! Dusty hat Dich erhoert! Ehre sei Dusty!\n",
      weapon->Name(WEN))), 0);
  Message(caster, 0, BS(sprintf("%s von %s leuchtet kurz silbrig auf.\n",
      weapon->Name(WEN), caster->name(WER))), 3);
  segen=CLONEOB(OBJ("waffensegen"));
  wc_boni=caster->QueryProp(P_GUILD_LEVEL)+
          (weapon->QueryProp(P_WC)*1*suc)/(3*MAX_ABILITY);
  wc_boni=DoModificationByAlign(wc_boni/3, caster)+(2*wc_boni/3);
  if (wc_boni < 10) wc_boni=10;
  // durch die Aenderung von woody vom 12.3. in combat.c notwendig
  // geworden, da  WC+WC_BONUS NICHT mehr > MAX_WEAPON_CLASS sein kann!!!:
  if ((weapon->QueryProp(P_WC)+weapon->QueryProp(P_DAMAGED)
        +wc_boni) > MAX_WEAPON_CLASS)
    wc_boni=MAX_WEAPON_CLASS-
      (weapon->QueryProp(P_WC)+weapon->QueryProp(P_DAMAGED));
  if (wc_boni > 125) wc_boni=125;
  //  tell_angrox(wc_value+"/"+wc_boni+"\n");
  
  // ZUM LOGGEN DER SPELLSTAERKEN
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/waffensegen",
      sprintf("CST: %O, CA: %d, suc: %d, wc: %d, wc_boni: %d/%d\n",
          caster, caster->QueryProp(P_ALIGN), suc, weapon->QueryProp(P_WC),
          wc_boni, DoModificationByAlign(wc_boni/3, caster)+(2*wc_boni/3)));
  // ----------------------------
 
  time=caster->QueryProp(P_GUILD_LEVEL)*(15+random(6));
  segen->SetVariables(caster, weapon, time, wc_boni);
  segen->move(caster, M_NOCHECK|M_SILENT);
  caster->SetProp(PAL_WAFFENSEGEN, 1);
  weapon->wield_me(1);
  return ERFOLG;
}


int prep_gottsegen(object caster, mapping sinfo) {
  object victim;
  if (sinfo[SI_SKILLARG] == "mich") {
    sinfo[SI_SKILLARG]=getuid(caster);
  }
  victim=FindVictim(sinfo[SI_SKILLARG],caster,
              BS("Wen willst Du segnen?\n"));
  if (!victim || (victim && victim->QueryProp(P_INVIS)))
    return 0;
  if(present("\nsegen", victim)) {
    if(victim==caster)
      write(BS("Aber Du bist schon gesegnet!\n"));
    else
      write(BS(sprintf("Paladin! %s ist schon gesegnet!\n",
          victim->Name(WER))));
    return 0;
  }
  if (IS_WIZARD(victim)) {
    Message(caster, 0, BS(
      sprintf("%s ist von Natur aus von Dusty gesegnet!\n",
      victim->Name(WER))), 0);
    return 0;
  }
  if (victim->QueryGuest()) {
    Message(caster, 0, BS(
      sprintf("%s ist ein Gast und bedarf keines Segens!\n",
      victim->Name(WER))), 0);
    return 0;
  }
  if(!interactive(victim)) {
    write(BS(sprintf("Dusty laesst Dich %s nicht segnen!\n",
        victim->name(WER))));
    return 0;
  }
  return 1;
}

int gottsegen(object caster, mapping sinfo) {
  object victim;
  int suc, heal, time;
  object segen;

  if( !prep_gottsegen( caster, sinfo) ) return 0;
  if (sinfo[SI_SKILLARG] == "mich") {
    sinfo[SI_SKILLARG]=getuid(caster);
  }
  victim=FindVictim(sinfo[SI_SKILLARG],caster,
              BS("Wen willst Du segnen?\n"));
  if(victim->QueryProp(P_ALIGN)<0) {
    if(victim==caster)
      write(BS("Du bist zu boese. Dusty wuerde Dich niemals segnen!\n"));
    else
      write(BS(sprintf("%s ist zu boese. Dusty wuerde %s niemals segnen!\n",
          victim->Name(WER), victim->QueryPronoun(WEN))));
    return 0;
  }
  if(call_other(NPCMASTER, "IsFeind", victim)) {
    Message(caster,0,
          BS("BEI DUSTY! Du wuerdeset einen FEIND der Paladine und somit "
          "auch einen FEIND Deiner Goettin segnen? Dafuer gibt es nur "
          "EINE Strafe!!!"),0);
    call_out("DoFakeDeath",0,caster);
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du beginnst leise zu Dusty zu beten!\n", 0);
  Message(caster, 0, sprintf("%s scheint leise zu zu Dusty zu beten.\n",
      caster->Name(WER)), 3);
  if((suc=SpellSuccess(caster,sinfo)+caster->QueryProp(P_ALIGN))<=0) {
    Message(caster, 0, "Dusty erhoert Dich nicht!\n", 0);
    Message(caster, 0, sprintf("Dusty scheint %s nicht zu erhoeren!\n",
        caster->Name(WEN)), 3);
    return MISSERFOLG;
  }
  if(victim==caster) {
    Message(caster, 0, BS(sprintf("Du spuerst wie die goettlich Macht Dustys "
        +"Dich staerkt! Gepriesen sei Dusty! Lob! Lob! Lob!\n")), 0);
    Message(caster, 0, BS(sprintf("%s sieht gestaerkt aus und scheint von "
        +"Dustys Macht durchdrungen zu sein.\n", caster->Name(WER))), 3);
  }
  else {
    Message(caster, victim, BS(sprintf("Durch das Gebet von %s fuehlst Du Dich "
        +"von Dustys Macht durchdrungen! Lob sei DUSTY!!!!\n",
        caster->name(WEM))), 1);
    Message(caster, victim, BS(sprintf("Durch Dein Gebet zu Dusty scheint %s "
        +"von ihrer Macht durchdrungen zu sein. Lob sei Dusty!\n",
        victim->name(WER))), 0);
    Message(caster, victim, BS(sprintf("Durch das Gebet von %s scheint %s "
        +"foermlich von Dustys Macht durchdrungen zu sein.\n",
        caster->name(WER), victim->name(WER))), 2);
  }
  segen=CLONEOB(OBJ("segen"));
  segen->move(victim, M_NOCHECK|M_SILENT);
  time=DoModificationByAlign((caster->QueryProp(P_GUILD_LEVEL)*15), caster);
  if(time>420) time=420;
  segen->SetVariables(caster, victim, time, suc);
  // LOGFILE
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/gottsegen",
        sprintf("CST: %O, VIC: %O, CA: %d, suc: %d, time: %d\n",
        caster, victim, caster->QueryProp(P_ALIGN), suc, time));
  //
  if(victim!=caster && caster->QueryProp(P_ALIGN) <1100)
    caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)+random(10));
  return ERFOLG;
}


int prep_goetterschutz(object caster, mapping sinfo) {
  mixed h;
  if(h=caster->QueryProp(P_TMP_DEFEND_HOOK)) {
    if(h[1]==TO && h[2]=="schutz2") {
      if(h[0]>=time()) {
        write(BS("Dustys Macht beschuetzt Dich schon, Paladin!\n"));
        return 0;
      }
    }
    else {
      return write("Paladin! Du hast schon einen Schutz!\n"), 0;
    }
  }
  if(interactive(caster) && present("\nspiegelschild", caster)) {
    write("Du hast schon einen Spiegelschild bekommen, Paladin!\n");
    return 0;
  }
  return 1;
}

int goetterschutz(object caster, mapping sinfo) {
  int suc, s_time;
  mixed h;
  if( !prep_goetterschutz( caster, sinfo) ) return 0;
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, BSA(sprintf("Maechtige Dusty! Gewaehre %s Schutz vor dem "
      +"Boesen!", diener[0][caster->QueryProp(P_GENDER)]), "Du rufst: "), 0);
  Message(caster, 0, BSA(sprintf("Maechtige Dusty! Gewaehre %s Schutz vor dem "
      +"Boesen!", diener[0][caster->QueryProp(P_GENDER)]),
      caster->Name(WER)+" ruft: "), 3);
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    Message(caster, 0, BS("Dusty scheint Dich nicht erhoert zu haben."), 0);
    Message(caster, 0, BS(sprintf("Dusty scheint %s nicht erhoert zu haben.",
        caster->name(WEN))), 3);
    return MISSERFOLG;
  }
  Message(caster, 0, BS("Durch die goettliche Macht Dustys bildet sich "
      +"ein silberner Schimmer vor Dir. Von nun an bist Du gegen das Boese "
      +"gewappnet!"), 0);
  Message(caster, 0, BS(sprintf("Vor %s bildet sich ein silberner Schimmer.",
      caster->name(WEM))), 3);
  s_time=3*caster->QueryProp(P_GUILD_LEVEL)+
         GetAlign(caster)/30+50*suc/MAX_ABILITY+random(100);
  s_time=DoModificationByAlign(s_time, caster);
  caster->SetProp(P_TMP_DEFEND_HOOK, ({s_time+time(), TO, "schutz2"}));
  call_out("schutz_msg", s_time+1, caster);
  return ERFOLG;
}

void schutz_msg(object caster) {
  mixed h;
  if (!objectp(caster)) return;         // Woody (981122)
  if (h=caster->QueryProp(P_TMP_DEFEND_HOOK)) {
    if(h[1]==TO && h[2]=="schutz2") {
      caster->SetProp(P_TMP_DEFEND_HOOK, 0);
    }
  }
  Message(caster, 0, BS("Dein heiliger Schutz loest sich auf!\n"), 0);
  return;
}

mixed schutz2(int dam, mixed dam_type, mixed spell, object enemy)
{
  int nr_damtypes, dam_nr, dam2;
  dam_nr=0;
  if (!pointerp(dam_type))
    dam_type=({dam_type});
  nr_damtypes=2*sizeof(dam_type);
  dam=(int)(dam*0.95);
  if(member(dam_type, DT_HOLY)!=-1) dam_nr+=2;
  if(member(dam_type, DT_UNHOLY)!=-1) dam_nr+=3;
  if(member(dam_type, DT_TERROR)!=-1) dam_nr+=2;
  if(member(dam_type, DT_POISON)!=-1) dam_nr+=2;
  if(member(dam_type, DT_MAGIC)!=-1) dam_nr++;
  if(dam_nr)
    dam-=(dam/2)*dam_nr/nr_damtypes;
  return ({ dam, dam_type, spell, enemy });
}


int prep_massenheilung(object caster, mapping sinfo) {
  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so niemanden heilen!\n"),0);
    return 0;
  }
  if (ENV(caster) && ENV(caster)->_query_total_light() < 1) {
    Message(caster,0,
      BS("Bei Dusty, hier ist es VIEL zu dunkel dafuer!\n"),0);
    return 0;
  }
  return 1;
}


int massenheilung(object caster, mapping sinfo) {
  object *friends, ob;
  int hands, suc, heal, i, new_heal, speed, j;
  string heal_speed, *ignores, *c_ignore;
  
  if( !prep_massenheilung( caster,  sinfo) ) return 0;
  friends=({});
  if(!sinfo[SI_SKILLARG])
    heal_speed="schnell";
  else
    heal_speed=sinfo[SI_SKILLARG];
  switch(heal_speed) {
    case "schnell": speed=1; break;
    case "langsam": speed=10; break;
    case "mittel": speed=5; break;
    default: speed=1;
  }
  friends=filter_array(all_inventory(ENV(caster)), "FindPaladinFriends");
  c_ignore=caster->QueryProp(P_IGNORE);
  ignores=({});
  for (j=sizeof(c_ignore)-1; j>=0; j--) {
    if(c_ignore[j][0..12] == "massenheilung") {
      ignores += ({ c_ignore[13..] });
    }
  }

  if(!sizeof(friends)) {
    Message(caster, 0, BS("Bei Dusty! Hier ist niemand, dem die Massenheilung "
        +"nuetzen wuerde!"), 0);
    return 0;
  }
  
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, BS("Du reckst Deine Arme gen Himmel und beginnst Dusty "
      +"anzurufen...\n"), 0);
  Message(caster, 0, BS(sprintf("%s reckt %se Arme gen Himmel und beginnt "
      +"Dusty anzurufen...\n", caster->Name(WER),
      caster->QueryPossPronoun(WER))), 3);
  Message(caster, 0, BSA(sprintf("Herrin Dusty! Erhoere %s in Zeiten "
      +"hoechster Not und erfuelle mich und meine Gefaehrten mit Deinem Geist, "
      +"auf dass sich unsere Wunden schliessen!\n",
      diener[1][caster->QueryProp(P_GENDER)]), "Du rufst: "), 0);
  Message(caster, 0, BSA(sprintf("Herrin Dusty! Erhoere %s in Zeiten "
      +"hoechster Not und erfuelle mich und meine Gefaehrten mit Deinem Geist, "
      +"auf dass sich unsere Wunden schliessen!\n",
      diener[1][caster->QueryProp(P_GENDER)]), caster->Name(WER)+
      " ruft: "), 3);
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    Message(caster, 0, "Dusty erhoert Dein Flehen nicht!\n", 0);
    Message(caster, 0, sprintf("Dusty erhoert %s Flehen nicht!\n",
        caster->Name(WESSEN)), 3);
    return MISSERFOLG;
  }
  heal=caster->QueryProp(P_GUILD_LEVEL)+GetAlign(caster)/80+
    random(40)*suc/MAX_ABILITY;
  if(!random(500)) heal*=2;
  Message(caster, 0, BS("Dustys Macht entfaltet sich unter euch, und ihr "
      +"werdet geheilt. Gepriesen sei Dusty! Heilig! Heilig! Heilig!\n"), 0);
  Message(caster, 0, BS("Dustys Macht entfaltet sich unter euch, und ihr "
      +"werdet geheilt. Gepriesen sei Dusty! Heilig! Heilig! Heilig!\n"), 3);
  // LOG
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/massenheilung",
        sprintf("CST: %O, VIC: %O, CA: %d, suc: %d, "
        +"heal: %d, MP: %d\n", caster, friends, caster->QueryProp(P_ALIGN),
        suc, heal, sinfo[SI_RAW_SPELLCOST]));
  // ------
  for(i=sizeof(friends)-1;i>=0;i--) {
    
    if(friends[i]->QueryProp(P_ALIGN)>0 && 
        member(ignores, getuid(friends[i]))==-1 &&
        (!friends[i]->QueryProp(P_IGNORE) ||
         member(friends[i]->QueryProp(P_IGNORE), "massenheilung")==-1)) 
    {
      new_heal=DoModificationByAlign(heal, friends[i]);
      if(new_heal>50) new_heal=50;
        if( speed == 1 ) {
          friends[i]->AddHp(new_heal);
          Message(caster, friends[i], "Die goettliche Macht Dustys "
             "heilt Dich!\n", 1);
        }
        else { 
          if(!present(PALADIN_MASSENHEILUNG, friends[i])) {
            ob=clone_object(OBJ("massenheilung"));
            ob->move(friends[i], M_NOCHECK);
            ob->start_heal(new_heal, speed, friends[i]);
            Message(caster, friends[i], "Die goettliche Macht Dustys "
              "beginnt Dich zu heilen!\n", 1);
          }
          else {
            Message(caster, friends[i], "Die goettliche Macht Dustys "
              "heilt Dich bereits!\n", 1);
          }
        }
      }
    new_heal=0;
    }
  if(caster->QueryProp(P_ALIGN) <1100 && sizeof(friends) > 1)
    caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)+random(10));
  return ERFOLG;
}


int prep_talisman(object caster, mapping sinfo) {
  if (sinfo[SI_SKILLARG]) {
    write(BS("Der Talisman ist nur fuer Dich, Paladin!!"));
    return 0;
  }
  if(present("\namaryllion", caster)) {
    write(BS("Paladin! Du hast bereits das Talismanschwert Amaryllion! Wie "
        +"kannst Du es wagen, es ein zweites Mal zu erflehen?"));
    DoFailure(caster, 1);
    return 0;
  }
  if(caster->QueryProp(P_WEAPON)) {
    write("Paladin! Du hast schon eine Waffe gezueckt!\n");
    return 0;
  }
  if(GetAlign(caster)<0) {
    write("Frevler! Mit Deiner Gesinnung wird Dusty Dich NIE erhoeren!\n");
    DoFailure(caster, 1);
    return 0;
  }
  return 1;
}

int talisman(object caster, mapping sinfo) {
  object ob, owner;
  int suc,time;
  string text;

  if( !prep_talisman( caster, sinfo) ) return 0;
  if(!(present(WAPPENROCK, caster)->QueryAmaryllion(caster))) {
    write(BS("Paladin! So oft kannst Du Dusty um ihr Schwert nicht "
        "belaestigen!\n"));
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  text=sprintf("Herrin Dusty, erhoere %s und gewaehre %s %s Bitte, "
      +"das Talismanschwert Amaryllion im Kampf gegen das Boese "
      +"einsetzen zu duerfen!\n", diener[1][caster->QueryProp(P_GENDER)],
      caster->QueryPronoun(WEM), caster->QueryPossPronoun(WEM));

  Message(caster, 0, BSA(text,"Du rufst: "), 0);
  Message(caster, 0, BSA(text, caster->Name(WER)+" ruft: "), 3);

  call_other(WEAPON("amaryllion"), "???");
  ob=find_object(WEAPON("amaryllion"));
  owner=ENV(ob);
  if(owner && !interactive(owner) && living(owner)
      && lower_case(owner->QueryProp(P_GUILD))=="paladine")
  {
    Message(caster, 0, BS("Jemand anderes benutzt gerade Amaryllion "
        "im Kampf gegen das Boese!"), 0);
    Message(caster, 0, sprintf("Dusty scheint %s Bitte nicht erhoert "
            "zu haben!\n",caster->Name(WESSEN)), 3);
    return 0;
  }
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS("Dusty scheint Dich nicht zu erhoeren!"), 0);
    Message(caster, 0, sprintf("Dusty scheint %s Bitte nicht erhoert "
            "zu haben!\n",caster->Name(WESSEN)), 3);
    return MISSERFOLG;
  }
  Message(caster, 0, BS(sprintf("Ploetzlich materialisiert sich aus einem "
      +"hellen Leuchten heraus ein silbern schimmerndes Schwert! Das Talisman"
      +"schwert Amaryllion! Gepriesen sei Dusty! Nun moegen sich Deine "
      +"Feinde vor Dir vorsehen!\n")), 0);
  Message(caster, 0, BS(sprintf("Auf einmal materialisiert sich in %s Hand "
      +"ein silbern schimmerndes Schwert!\n", caster->Name(WESSEN))), 3);
  time=10*caster->QueryProp(P_GUILD_LEVEL)+
         GetAlign(caster)/7+150*suc/MAX_ABILITY+random(150);
  if(owner && interactive(owner)) {
    tell_object(owner, BS(sprintf("Paladin! %s benoetigt Amaryllion! "
        "Das Talismanschwert loest sich vor Deinen Augen auf.",
        caster->Name(WER))));
  }
  // ZUM LOGGEN DER SPELLSTAERKE!
  write_file("/gilden/paladine/spells/talisman",
      sprintf("CST: %O, CA: %d, suc: %d, time: %d\n",
          caster, caster->QueryProp(P_ALIGN), suc, time ));
  // ----------------------------
  ob->SetProp(P_CURSED,0);
  ob->DoUnwield(0);
  ob->move(caster, M_NOCHECK|M_SILENT);
  ob->start_remove(time, suc);
  ob->wield_me(0);
  present(WAPPENROCK, caster)->SetAmaryllion();
  return ERFOLG;
}


int prep_spiegelschild(object caster, mapping sinfo) {
  mixed h;
  object *armour;
  int i;
  if (sinfo[SI_SKILLARG]) {
    write(BS("Du kannst um den Spiegelschild nur fuer Dich selber bitten!"));
    return 0;
  }
  if(interactive(caster) && present("\nspiegelschild", caster)) {
    write("Du hast schon einen Spiegelschild bekommen, Paladin!\n");
    return 0;
  }
  armour=caster->QueryProp(P_ARMOURS);
  for(i=sizeof(armour)-1;i>=0;i--) {
    if(armour[i]->QueryProp(P_ARMOUR_TYPE)==AT_SHIELD) {
      Message(caster, 0, BS("Du hast bereits einen normalen Schild!"), 0);
      return 0;
    }
  }
  if (interactive(caster) && h=caster->QueryProp(P_TMP_DEFEND_HOOK)) {
    write("Paladin! Du hast schon einen Schutz!\n");
    return 0;
  }
  if(interactive(caster) && GetAlign(caster)<0) {
    write("Frevler! Mit Deiner Gesinnung wird Dusty Dich NIE erhoeren!\n");
    DoFailure(caster, 1);
    return 0;
  }
  return 1;
}

int spiegelschild(object caster, mapping sinfo) {
  object ob;
  int suc,time, i;
  string text;

  if( !prep_spiegelschild( caster, sinfo) ) return 0;
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  text="Oh gesegnete Dusty! Hilf mir in meinem Kampf gegen das Boese und "
       "schuetze mich vor den frevelhaften Angriffen meiner Feinde! Hilf "
       "Hilf Hilf!!!";
  Message(caster, 0, BSA(text,"Du rufst: "), 0);
  Message(caster, 0, BSA(text, caster->Name(WER)+" ruft: "), 3);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS("Dusty scheint Dich nicht zu erhoeren. "
        +"Der entstandene Spiegel zerfaellt sofort wieder."), 0);
    Message(caster, 0, sprintf("Dusty scheint %s Bitte nicht erhoert "
            "zu haben!\n",caster->Name(WESSEN)), 3);
    return MISSERFOLG;
  }
  Message(caster, 0, BS(sprintf("Auf einmal entsteht um Dich herum eine "
      "schimmernde Wand die von Deiner Seite aus fast ganz durchsichtig ist. "
      "Ehre sei Dusty! Ehre!\n")), 0);
  Message(caster, 0, BS(sprintf("Auf einmal entsteht um %s herum eine "
      "schimmernde Wand, in der Du ein Spiegelbild Deiner selbst erkennen "
      "kannst.\n",caster->name(WER))), 3);
  ob=CLONEOB(OBJ("spiegelschild"));
  time=2*caster->QueryProp(P_GUILD_LEVEL)+
         GetAlign(caster)/25+60*suc/MAX_ABILITY+random(60);
  time=DoModificationByAlign(time, caster);
// tell_zordan(sprintf("time: %d\n",time));

  // ZUM LOGGEN DER SPELLSTAERKE!
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/spiegelschild",
        sprintf("CST: %O, CA: %d, suc: %d, time: %d\n",
          caster, caster->QueryProp(P_ALIGN), suc, time ));
  // ----------------------------
  ob->move(caster, M_NOCHECK|M_SILENT);
  ob->start_remove(time, suc);
  ob->DoWear(1);
  return ERFOLG;
}



int stossgebet(object caster, mapping sinfo) {
  int suc, offset;
  object obj;

  if (caster->QueryProp(P_HP) > caster->QueryProp(P_MAX_HP)/3) {
    Message(caster, 0, BS(
      "Du bist in keiner Situation groesster Not, wo Dusty Dir ihre grosse "
      "Macht und Hilfe geben kann! Erflehe Dustys Macht nicht "
      "so leichtfertig, Paladin!"),0);
// angrox, da muessen wir mal schauen. die ausgaben sind verwirrend,
// weil es eigentlich gar kein misserfolg war ...
    DoFailure(caster, 1);
    return 0;
  }
  if(interactive(caster) && GetAlign(caster)<0) {
    write("Frevler! Mit Deiner Gesinnung wird Dusty Dich NIE erhoeren!\n");
    DoFailure(caster, 1);
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du breitest Deine Arme aus und betest zu Dusty!\n", 0);
  Message(caster, 0, BSA(sprintf("Herrin Dusty, erhoehre %s und wappne "
      +"mich gegen den Tod, auf dass ich Deine Macht und Herrlichkeit "
      +"verkuenden kann! Ehre sei Dir, oh Dusty! Ehre! Ehre! Ehre!\n",
      diener[1][caster->QueryProp(P_GENDER)]),"Du rufst: "), 0);
  Message(caster, 0, BSA(sprintf("Herrin Dusty, erhoehre %s und wappne "
      +"mich gegen den Tod, auf dass ich Deine Macht und Herrlichkeit "
      +"verkuenden kann! Ehre sei Dir, oh Dusty! Ehre! Ehre! Ehre!\n",
      diener[1][caster->QueryProp(P_GENDER)]),caster->Name(WER)+
      " ruft: "), 3);
  //caster->reduce_hit_point(random(30)+1);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    if(suc<-3000) {
//      DoFailure(caster, 1);
      call_out("DoFakeDeath",0,caster);
    } else {
      Message(caster, 0, BS("Dusty erhoert Dich nicht!\n"), 0);
      Message(caster, 0, BS("Nichts passiert!\n"), 3);
    }
    return MISSERFOLG;
  }
  offset=6+DoModificationByAlign((int)25*suc/MAX_ABILITY, caster);
  if(offset<10) offset=10;
  if(offset>40) offset=40;
  caster->SetProp(P_TMP_DIE_HOOK, ({time()+offset, TO, "stossgebet_func"}));
  call_out("stossgebet_endmsg", offset-2, caster);

  // ZUM LOGGEN DER SPELLSTAERKE
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/stossgebet",
        sprintf("CST: %O, CA: %d, suc: %d, offset: %d\n",
        caster, caster->QueryProp(P_ALIGN), suc, offset ));
  // ----------------------------
  Message(caster, 0, BS("Ploetzlich bist Du von einer hellsilbernen Aura "
      +"umgeben! Dank Dustys Macht bist Du nun fuer kurze Zeit im Kampf "
      "unsterblich!"
      +" Lob sei Dusty! Lob! Lob! Lob!\n"), 0);
  Message(caster, 0, BS(sprintf("%s ist ploetzlich von einer hellsilbernen "
      +"Aura umgeben.", caster->Name(WER))), 3);
  return ERFOLG;
}

int stossgebet_endmsg(object caster) {
  if (!objectp(caster)) return 0;         // Woody (981122)
  if(interactive(caster) && find_player(getuid(caster)))
    tell_object(caster, "Du bist wieder sterblich, Paladin!\n");
  return 1;
}

int stossgebet_func(int poisondeath) {
  if(living(PO)) {
    Message(PO, 0, BS(
      "Du spuerst einen stechenden Schmerz in Deinem Herzen. Doch sofort "
      "erscheint Dusty in Deinem Geist und Dir wird ganz warm ums Herz. "
      "Dusty beschuetzt Dich und stellt den Kampf sofort ein!\n"), 0);
    PO->AddHP(random((int)(PO->QueryProp(P_ALIGN)/25)));
  }
  return 1;
}





int prep_eifer(object caster, mapping sinfo) {
  mixed h;
  object *armour;
  int i;
  if (sinfo[SI_SKILLARG]) {
    write(BS("Der goettliche Eifer kann nur auf Dich wirken, Paladin!"));
    return 0;
  }
  if(caster->QueryProp(P_TMP_ATTACK_HOOK)) {
    Message(caster, 0, BS("Paladin! Du kannst Dich im Moment nicht in goettlichen "
          "Eifer versetzen!"),0);
    return 0;
  }
  if(interactive(caster) && present("\neifer", caster)) {
    Message(caster, 0, BS("Paladin! Du befindest Dich bereits im goettlichen Eifer!"),0);
    return 0;
  }
  if(interactive(caster) && GetAlign(caster)<0) {
    write("Frevler! Mit Deiner Gesinnung wird Dusty Dich NIE erhoeren!\n");
