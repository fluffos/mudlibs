int ShoutPrayer(object caster) {
  int i;
  mapping prayers;
  prayers=
    ([0:
    "Herrin Dusty, durchdringe uns und fuelle uns mit Deinem Geist,\n"
   +"dring ein in unsere Glieder und gebe ihnen Kraft,\n"
   +"dring ein in unsere Herzen und gebe ihnen Mut,\n"
   +"dring ein in unsere Seelen und gebe ihnen Zorn!\n"
   +"Mein Leben sei Dein, und den Leib des Feindes will ich Dir opfern.\n"
   +"Rotes Blut, heiliges Blut - Blut wasche rein - so sei es!\n",
     1:
    "Dir zu Ehren kaempfe und streite ich!\n"
   +"Dir zu Ehren nur in Deinem Namen!\n"
   +"Dir zu Ehren ich leb',\n"
   +"Dir zu Ehren ich sterb',\n"
   +"Dir zu Ehren bis in Ewigkeit!\n",
     2:
    "Es segne uns Dusty, die Herrin des Krieges!\n"
   +"Es bewahre uns Dusty, die Beherrscherin des Sturmes!\n"
   +"Es erleuchte uns Dusty, die herrliche Loewin des Kampfes!\n"
   +"Es staerke uns die Kraft des gleissendes Stahls,\n"
   +"und unser Wille, der als ehernes Schild vor uns steht!\n"
   +"Dein Wille, o Herrin, sei unser Befehl!\n",
     3:
    "Wir werden sein Ihre Zunge, zu kuenden von Ihrer Herrlichkeit!\n"
   +"Wir werden sein Ihr Herz, zu wahren Ihre Gebote!\n"
   +"Wir werden sein Ihr Geist, zu leben Ihre Gnade!\n"
   +"Wir werden sein Ihr Schild, zu schuetzen die geheiligten Lande!\n"
   +"Wir werden sein Ihr Schwert, zu fechten wider die dunklen Maechte!\n"
    ]);
  if(!ENV(caster)) return 0;
  i=random(sizeof(m_indices(prayers))-1);
  tell_object(caster, BS("Du reckst Deinen Schwertarm gen Himmel und betest "
      +"voller Inbrunst zu Dusty:\n"));
  tell_room(ENV(caster), BS(sprintf("%s reckt %sn Schwertarm gen Himmel "
      +"und betet zu Dusty:\n", caster->Name(WER),
      caster->QueryPossPronoun(FEMALE))), ({caster}));
  tell_object(caster, BSA(prayers[i],"Du rufst: "));
  tell_room(ENV(caster), BSA(prayers[i], TP->Name(WER)+" ruft: "),
      ({caster}));
  return 1;
  }

varargs int
DoModificationByAlign(int value, object caster, object victim) {
  int flag, caster_align, victim_align, diff;
  flag=1;
  if(!intp(value)) return 0;
  if(!objectp(caster)) caster=TP;
  if(!objectp(victim)) flag=0;
  caster_align=GetAlign(caster);
  if(!intp(caster_align)) caster_align=0;
  if(flag) {
    victim_align=GetAlign(victim);
    if(!intp(victim_align)) victim_align=0;
  }
  if(victim_align>400) victim_align*=2;
  value=(int)(value*(1+CalcBiorythm("phy")));
  if((diff=victim_align-caster_align)==0) return value;
  return (int)(value*(1-(diff/(float)2000)));
}

static mapping
DoSpellModification(object caster,mapping sinfo) {
  int align, mod, kosten, sac_money;
  float cost_modifier, fatigue_modifier;
  object ayla, env_flag, flag;
  cost_modifier=1.0;
  fatigue_modifier=1.0;
  align=GetAlign(caster);
  if(find_player("dusty")) {
    cost_modifier-=0.1;
    fatigue_modifier-=0.1;
  }
  if(dtime(time())[5..11]=="20. Nov")  // Dustys Geburtstag :)
    cost_modifier-=0.4;
  if(dtime(time())[5..11]=="26. May")  // Hochzeittags Dusty :)
    cost_modifier-=0.4;
  /*
  if(caster->QueryProp("friends"))
    if(member(caster->QueryProp("friends"), "dusty")!=-1) {
      fatigue_modifier-=0.2;
      cost_modifier-=0.1;
    }

  if(caster->QueryProp(P_WAITFOR))
    if(member(caster->QueryProp(P_WAITFOR), "dusty")!=-1)
      cost_modifier-=0.05;
  */
  if(align<0) {
    cost_modifier+=sqrt(-(float)(align)/(float)800);
    fatigue_modifier+=sqrt(-(float)(align)/(float)800);
  }
  if(align>700) {
    cost_modifier-=((float)align-700)/((float)10000+random(5000));
  }
  if((sac_money=call_other(PALADINMASTER, "GetSacrificedMoney", caster))>
      500000) {
    //
    // cost_modifier-=(float)sac_money/(2000000*100); // pro  Million 0.5%
    //
    // ab jetzt ist das eine konvergente Funktion... Zordan
    cost_modifier-=(float)(1.0-((float)sac_money)/
                  ((float)sac_money+100000000.0))*((float)sac_money/199000000.0);
  }
  // Items Check
  cost_modifier-=CheckItems(caster);

  // Caster hat Dantes Zombievirus
  if(present("DANTE_ZOMBIE_VIRUS", caster))
    cost_modifier+=0.2;

  if(caster->QueryProp(P_GUILD_LEVEL)>13 && sinfo[SI_RAW_SPELLCOST]>=13) {
    sinfo[SI_RAW_SPELLCOST]-=caster->QueryProp(P_GUILD_LEVEL)-13;
  }
  if(cost_modifier<0.3) cost_modifier=0.3;
  if(fatigue_modifier<0.4) fatigue_modifier=0.4;
  
  // Dustys Biorythmus :-)
  cost_modifier-=CalcBiorythm("int");

  // Standarte nicht in der Schatzkammer!
  call_other(ROOM("burg_schatzkammer"), "???");
  if ( !present(PALADIN_STANDARTE, 
        find_object(ROOM("burg_schatzkammer")))) 
  {
    cost_modifier+=0.3;
    fatigue_modifier+=0.3;
    if(ayla_flag_shout) {
      flag=find_object(ROOM("burg_schatzkammer"))->QueryProp("standarte");
      if(ayla=find_living("ayla")) {
         ayla_flag_shout=0;
         if(!objectp(flag))
           ayla->command_me("prufe Paladine! Die heilige Standarte wurde "
               "vernichtet! Lasst uns in Demut zu Dusty beten damit sie "
               "uns bald eine Neue schenke!");
         else if(env_flag=ENV(flag)) {
           if(query_once_interactive(env_flag)) {
             ayla->command_me(sprintf("prufe Paladine! %s hat unsere "
                   "Standarte! Ueberzeugt %s das %s sie uns zurueckgibt!",
                   env_flag->Name(WER), env_flag->QueryPronoun(WEN), 
                   env_flag->QueryPronoun(WER)));
           }
           else if(living(env_flag)) {
             ayla->command_me(sprintf("prufe Paladine! Die Standarte "
                   "befindet sich in Besitz von %s! Bringt %s zur "
                   "Strecke und bringt die Standarte zurueck!", 
                   env_flag->name(WEM), env_flag->QueryPronoun(WEN)));
           }
           if(!living(env_flag)) {
             ayla->command_me(sprintf("prufe Paladine! Die heilige "
                   "Standarte befindet sich in einem Gebiet das '"
                   "%s' genannt wird! Holt die Standarte zurueck!", 
                   env_flag->QueryProp(P_INT_SHORT)));
           }
         }
      }
    }
  }
  else {
    ayla_flag_shout=1;
  }

  if(!sinfo[SI_SPELLFATIGUE]) sinfo[SI_SPELLFATIGUE]=2;
  if((sinfo[SI_SPELLFATIGUE]=(int)(sinfo[SI_SPELLFATIGUE]*fatigue_modifier))<2)
                 sinfo[SI_SPELLFATIGUE]=2;
  sinfo[SI_RAW_SPELLCOST]=(int)(sinfo[SI_RAW_SPELLCOST]*cost_modifier);
  return sinfo;
}

/* Hier wird geprueft, ob der Spell gesprochen werden darf */
CheckIfSpellAllowed(object caster) {
  object ob;
  // ok, sicherheitshalber mal die Gildenstufe abfragen :(
  if( caster->QueryProp(P_GUILD_LEVEL) > 15) {
    write_secure_log(sprintf("%s: %s hatte Level %d!\n",
      dtime(time()), CAP(getuid(caster)),caster->QueryProp(P_GUILD_LEVEL)));
    caster->SetProp(P_GUILD_LEVEL, 15);
  }
  if(caster->QueryProp(P_GHOST)) {
    printf(BS("PALADIN! Nur in der Stofflichkeit kannst Du Dusty "
        +"um ein Wunder anflehen!\n"));
    return "";
  }
  if(caster->QueryProp(P_ALIGN)<-500) {
    printf(BS("FREVLER! WIE KANNST DU ES WAGEN, BEI EINER SOLCHEN "
        +"GESINNUNG DUSTY ANZURUFEN! FREVLER!\n"));
    return "";
  }
  if(!ob=present(WAPPENROCK, caster)) {
    printf(BS("Ohne den goettlichen Wappenrock kannst Du nicht zaubern!\n"));
    write_secure_log(sprintf("%s: %s versucht ohne Wappenrock zu zaubern!\n",
        ctime(), CAP(getuid(caster))));
    return "";
  }
  if(ob->QueryVersion()!=LAST_GUILDITEM_UPDATE) {
    printf(BS("Bei Dusty! Dein Wappenrock ist total zerrissen! Du solltest "
         "Dir einen Neuen von Ayla holen! (frag ayla nach neuem "
         "wappenrock)"));
    return "";
  }
  return 0;
}



// Alignbeschraenkung auf -1000 ... +1000
static int GetAlign(object spieler) {
  int align;
  string msg;
  if(!intp(align=spieler->QueryProp(P_ALIGN))) {
  tell_za(sprintf("pal_spells: GetAlign, %s hat falschen Datentyp fuer "
      +"Align!", spieler->Name(WER)));
  return 0;
  }
  if(align>3000 && !spieler->QueryProp(P_TESTPLAYER) &&
      !IS_WIZARD(spieler) && interactive(spieler))
  {
    msg=sprintf("PL: %s, ALIGN: %d, PO: %O",getuid(spieler), align,
        previous_object());
    write_paladin_log("align.log", msg+"\n");
    tell_za(msg);
    spieler->SetProp(P_ALIGN, -align);
  }
  if(align<-1100) return -1100;
  else if(align>1100) return 1100;
  return align;
}


// Das _sollte_ die Ausgabe erleichtern ...
static varargs int
Message(object caster, object victim, string msg, int flag) {
  if(!objectp(caster)) caster=TP;
  if(!msg) return 0;
  if(!objectp(victim) && (flag==1 || flag==2)) return 0;
  switch(flag) {
    case 0: catch(tell_object(caster, msg));
            break;
    case 1: tell_object(victim, msg);
            break;
    case 2: if(ENV(caster))
              tell_room(ENV(caster), msg, ({caster, victim}));
            break;
    case 3: if(ENV(caster))
              tell_room(ENV(caster), msg, ({caster}));
            break;
    case 4: if(ENV(caster))
              tell_room(ENV(caster), msg, ({victim}));
            break;
    default: tell_za("Fehler in Message(), /gilden/pal_spells.c");
  }
  return 1;
}

static int tell_za(string msg) {
  tell_angrox(BSA(msg, ANSI_RED+ANSI_BLINK+"*** "+ANSI_NORMAL));
  tell_zordan(BSA(msg, ANSI_RED+ANSI_BLINK+"*** "+ANSI_NORMAL));
  return 1;
}


void Erfolg(object caster, string spell, mapping sinfo) {
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "CheckAbility", caster, spell,
              sinfo[SI_SKILLABILITY]);
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0,
      "paladine");
  if(!random(20))
    if (spell != "verbannung" && spell != "zielattacke" &&
        spell != "heiligengebet")
      ShoutPrayer(caster);
  return;
}

static string int2string(int wert) {
 string str;
 switch(wert) {
   case 0..500    : str=" wie ein Druide - naemlich ueberhaupt nicht!"; break;
   case 501..1000 : str=" fast ueberhaupt nicht!"; break;
   case 1001..1500: str=" miserabel wie ein Vagabund!"; break;
   case 1501..2000: str=" wie ein blutiger Anfaenger!"; break;
   case 2001..2500: str=" wie ein junger Knappe!"; break;
   case 2501..3000: str=" schlecht!"; break;
   case 3001..3500: str=" maessig!"; break;
   case 3501..4000: str=" mittelmaessig!"; break;
   case 4001..4500: str=" unterdurchschnittlich wie ein Soeldner!"; break;
   case 4501..5000: str=" durchschnittlich!";  break;
   case 5001..5500: str=" ueberdurchschnittlich!"; break;
   case 5501..6000: str=" gut!"; break;
   case 6001..6500: str=" sehr gut!"; break;
   case 6501..7000: str=" wie ein Burgwaechter!"; break;
   case 7001..7500: str=" wie ein hochdekorierter Veteran!"; break;
   case 7501..8000: str=" wie ein hochbegabter Meister!"; break;
   case 8001..8500: str=" beinahe engelgleich!"; break;
   case 8501..9000: str=" engelgleich!"; break;
   case 9001..9500: str=" legendaer!"; break;
   case 9501..9999: str=" beinahe goettlich!"; break;
   case 10000     : str=" goettlich!"; break;
  }
  return str;
}

void Misserfolg(object caster, string spell, mapping sinfo) {
  int old_abil,new_abil;
  object victim;
  string txt;
  if(sinfo[SI_SKILLARG] && (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
        victim=present(sinfo[SI_SKILLARG], caster)))
  {
    if(victim->id(SID_NOLEARN)) {
      TELL("angrox", sprintf("PAL_SPELLS(3936), ID: SID_NOLEARN, object: %O\n", 
          victim));
      return ;
    }
  }
  old_abil = sinfo[SI_SKILLABILITY];
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0,
      "paladine");
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "CheckAbility", caster, spell, old_abil);
  Learn(caster, spell, sinfo);
  new_abil=caster->QuerySkillAbility(spell);
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "UpdateAbility", caster, spell, new_abil);
  if (old_abil < new_abil) {
    switch(random(5)) {
      case 0:
        write(BS("Auch wenn Du versagt hast, lernst Du aus Deinem Fehler, "
                +"Paladin!"));
        break;
      case 1:
        write(BS("Dein Fehler verhilft Dir '"+CAP(spell)+"' weiter zu lernen, "
                +"Paladin!"));
        break;
      case 2:
        write(BS("Du dankst Dusty fuer den Fehlschlag und lernst fuer die "
                +"Zukunft dazu, Paladin!"));
        break;
      case 3:
        write(BS("Trotz Deines Fehlschlages lernst Du aus Deinem Fehler dazu, "
                +"Paladin!"));
        break;
      default:
      case 4:
        write(BS("Paladin! Du lernst aus Deinem Fehler dazu!"));
        break;
    }
    if((old_abil/500) != ((new_abil-1)/500)) {
      if(find_living("ayla")) {
        txt=int2string(new_abil);
        Message(caster,0,break_string("Bravo Paladin, Du beherrschst '"+
          CAP(spell)+"' jetzt"+txt,80,"Ayla teilt Dir mit: "),0);
      }
    }
  } else
    write(BS("Du lernst nichts mehr, Paladin! Du musst erst besser werden!"));
  DoFailure(caster, 5);
  return;
}

static int DoFailure(object caster, int rnd) {
  int max_val, val;
  max_val=68-(int)(3*68*CalcBiorythm("emo"));
  if(max_val < 65) max_val=65;
  if(rnd<1) rnd=1;
  if(present(PALA_NOFAILURE, caster))
    return 1;
  if(!random(rnd)) {
    val=random(max_val+1);
    if(val >= 0 && val <= 5) {
      printf(BS("Du opferst Dusty ein paar Lebenspunkte!\n"));
      caster->reduce_hit_point(random(20)+1);
    }
    else if (val >= 6 && val <= 10) {
      printf("Deine Gesinnung sinkt!\n");
      caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)- random(50)); 
    }
    else if (val >= 11 && val <= 15) {
      printf(BS("Du musst mehr Magie opfern, um Dustys Zorn zu "
                    +"besaenftigen."));
      caster->AddSp(-random(40)+1);
    }
    else if (val >= 16 && val <= 20) {
      printf(BS("Du bist ploetzlich ziemlich eingeschuechtert!\n"));
      caster->SetProp(P_WIMPY, caster->QueryProp(P_WIMPY)+
                   (caster->QueryProp(P_MAX_HP)-caster->QueryProp(P_HP))/2);
    }
    else if (val >= 21 && val <= 25) {
      printf(BS("Du kannst fuer einige Zeit lang Dusty nicht "
                     +"mehr anrufen!!!"));
      caster->SetProp(P_NEXT_SPELL_TIME, time()+random(25)+50);
    }
    else if (val >= 26 && val <= 30) {
      printf(BS("Dusty laesst Dich ob Deines Misserfolges erblinden!!!"));
      caster->SetProp(P_BLIND, random(20)+20);
    }
    else if (val >= 31 && val <= 35) {
      printf(BS("Dusty laesst Dich ob Deines Misserfolges ertauben!!!"));
      caster->SetProp(P_DEAF, random(40)+20);
    }
    else if (val >= 36 && val <= 40) {
      printf(BS("Du fuehlst Dich ploetzlich so erschoepft!"));
      caster->SetProp(P_MV, random(20)+25);
    }
    else if (val >= 41 && val <= 45) {
      printf(BS("Du fuehlst Dich *hicks* beschipscht!\n"));
      caster->SetProp(P_ALCOHOL, caster->QueryProp(P_MAX_ALCOHOL));
    }
    else if (val >= 46 && val <= 50) {
      printf(BS("Du fuehlst Dich ploetzlich sehr gesaettigt!\n"));
      caster->SetProp(P_FOOD, caster->QueryProp(P_MAX_FOOD));
    }
    else if (val >= 51 && val <= 55) {
      printf(BS("Irgendwie fuehlst Du keinen Durst mehr!\n"));
      caster->SetProp(P_DRINK, caster->QueryProp(P_MAX_DRINK));
    }
    else if (val >= 56 && val <= 60) {
      printf(BS("Dusty verfroscht Dich ob Deines Misserfolges!\n"));
      caster->SetProp(P_FROG, random(40)+20);
    }
    else if (val >= 61 && val <= 63) {
      printf(BS("Durch Deinen Misserfolg bist Du wie paralysiert!"));
      caster->SetProp(P_PARALYZED,
                    ([PARALYZE_TIME:random(10)+1,
                      PARALYZE_MSG: BS("Durch Deinen Misserfolg bist "
                           +"Du wie paralysiert!\n"),
                      PARALYZE_END: BS("Gepriesen sei Dusty! Du kannst "
                           +"Dich wieder bewegen!\n"),
                      PARALYZE_MSG_OTHER: BS(sprintf("%s ist durch seinen "
                           +"Misserfolg wie gelaehmt!\n",
                           caster->Name(WER))),
                      PARALYZE_END_OTHER: BS(sprintf("%s kann sich wieder "
                           +"bewegen!\n", caster->Name(WER)))
                    ]));
    }
    else if (val >= 64 && val <= max_val) {
      call_out("DoFakeDeath",0,caster);
    }
    else {
      printf(BS("Nichts passiert.\n"));
    }
  }
}

int DustyKillsPaladins(object paladin) {
  if(getuid(TP)!="dusty") return 0;
  return DoFakeDeath(paladin);
}

static int DoFakeDeath(object caster) {
  object ob;
  if(ENV(caster))
    caster->SetProp(P_TMP_PRAY_ROOM, file_name(ENV(caster)));
  Message(caster, 0, BS("Dusty bestraft Deine Unverfrorenheit "
          +"mit Deinem sofortigen TOD!\n"), 0);
  Message(caster, 0, BS(sprintf("%s bricht tot nieder. Offenbar ist %s "
          +"bei Dusty in Ungnade gefallen.\n", caster->Name(WER),
          caster->QueryPronoun(WER))), 3);
  caster->SetProp(P_GHOST,1);
  caster->SetProp(P_KILLER, TO);
  SetProp(P_KILL_NAME,"Dustys Macht");
//  SetProp(P_KILL_MSG,"Test");
//  ob=clone_object("/room/death/death_mark");
//  ob->move(caster, M_NOCHECK|M_SILENT);
  caster->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW|M_SILENT);
  caster->SetProp(P_KILLER,0);
//  CHMASTER->join("Tod",TO);
//  catch(CHMASTER->send("Tod",TO,
//      sprintf("Dustys Macht hat gerade %s vernichtet!", CAP(getuid(caster))),
//      MSG_SAY));
  return 1;
}

float CheckItems(object pl) {
  object *obj, wea;
  int i, value, h;
  value=0;
  if(!objectp(pl)) return 0.0;
  obj=pl->QueryProp(P_ARMOURS);
  if( wea=pl->QueryProp(P_WEAPON) )
    obj+=({wea});
  if(!sizeof(obj)) return 0.0;
  for(i=sizeof(obj)-1;i>=0;i--) {
    if(h=obj[i]->QueryProp("paladin_spellcost")) {
      value+=h;
    }
  }
  return value/100.0;
}

int FindPaladinFriends(object ob) {
  if(call_other(NPCMASTER, "IsPaladinEnemy", ob)) return 0;
  if(
      living(ob) && 
      ob->QueryProp(P_ALIGN) > 0 && 
      !IS_WIZARD(ob) &&
      !ob->QueryGuest() &&
      !ob->QueryClass(CL_UNDEAD) &&
      !ob->QueryClass(CL_DEMON)
    )
    return 1;
  return 0;
}


//
// Plural checken
// 
static string check_plural(object ob, string singular, string plural) {
  if(ob->QueryProp(P_PLURAL)) return plural;
  if(ob->QueryProp(P_AMOUNT)>1) return plural;
  return singular;
}

//
// File Log einschalten
//
int enable_spell_logging() {
  if(!IS_ARCH(TP)) return 0;
  enable_spell_log=1;
  return 1;
}

int disable_spell_logging() {
  if(!IS_ARCH(TP)) return 0;
  enable_spell_log=0;
  return 1;
}

//
// Biorhytmus berechnen
/*
Formel für die 3 Kurven:
Zustand (Alter in Tagen) = 100% * sin ( 2*PI *(Alter / 23))
  Zustand (Alter in Tagen) = 100% * sin ( 2*PI *(Alter / 28))
  Zustand (Alter in Tagen) = 100% * sin ( 2*PI *(Alter / 33))
  (2*PI = 360 Grad)
  
  - Physische Kurve: 23 Tage
  - Emotionale Kurve: 28 Tage
  - Intellektuelle Kurve: 33 Tage
  //
  //
*/
float CalcBiorythm(string what) {
  float pi;
  int days,ddays;
  pi=3.1415926535897932;
  switch(what) {
    case "phy": days=23; break;
    case "emo": days=28; break;
    case "int": days=33; break;
  }
  ddays=call_other(PALADINMASTER, "QueryDustyAge");
  return 5*sin(2*pi*((float)ddays/days))/100.0;
}
