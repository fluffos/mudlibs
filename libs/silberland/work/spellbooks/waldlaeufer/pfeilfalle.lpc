mapping prep_pfeilfalle(object caster, mapping sinfo, int silent) 
{  
  object ob, trap;
  
  if(!FroschTest(caster, sinfo)  || 
     !BlindTest(caster, sinfo)   ||
     !IsNotInFight(caster, sinfo) )
    return 0;
    
  if(!objectp(ob=present(TRAP_BELT_ID, caster)))
  { tell_object(caster,BS("Du kannst ohne Deinen Fallenguertel keine Fallen "
                       "bauen."));
    return 0; }
  if(!ob->can_build(3))
  { tell_object(caster,BS("Du hast nicht genug Draehte fuer Diese Falle."));
    return 0; }
    
  if(!ENV(caster)) return 0;
  if(objectp(trap=present(PFEILFALLE_ID, ENV(caster))))
  {ob=trap->QueryOwner();}
  if(ob==caster) 
  { tell_object(caster,BS("Du kannst hier nur eine solche Falle errichten."));
    return 0;}
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int pfeilfalle(object caster, mapping sinfo)
{
  object trap, ob;
  int success, ability;
  
  if(!mappingp(sinfo=prep_pfeilfalle(caster, sinfo, 1))) return 0;
  ability=sinfo[SI_SKILLABILITY];

  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Du schneidest Dich beim Aufbau. Wie "
                        "ungeschickt."));
    caster->AddHp(-(10+random(10)));
    if( objectp(ob=present(TRAP_BELT_ID, caster)) )
    { ob->dec_ladungen(3); }
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC("Die Falle faellt zusammen."));
    if( objectp(ob=present(TRAP_BELT_ID, caster)) )
    { ob->dec_ladungen(3); }
    return MISSERFOLG;
  }

  trap=clone_object(OBJ"trap");  
  trap->move(ENV(caster), M_SILENT|M_NOCHECK);
  trap->Pfeilfalle(caster, ability);
  tell_object(caster, BS("Du legst einige Pfeile auf Astgabeln und spannst "
                      "diese mit einigen Schnueren."));
  tell_room(ENV(caster),BS(caster->Name(WER, 1)+" baut eine komplizierte "
                        "Pfeilfalle."), ({caster}) );
                        
  if( objectp(ob=present(TRAP_BELT_ID, caster)) ) { ob->dec_ladungen(3); }
  return ERFOLG;
}