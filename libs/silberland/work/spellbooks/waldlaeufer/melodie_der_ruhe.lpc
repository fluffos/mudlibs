mapping prep_melodie_der_ruhe(object caster, mapping sinfo, int silent)
{
  //Aenderungen der Werte im sinfo Mapping vermeiden!  
  if(!FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo)  )
  { return 0; }
     
  if(!present(IAMA_ID, caster))
  { tell_object(caster, BS("Ohne Deine Iama geht das nicht!")); 
    return 0; }
      
  if(present(HEAL_OBJ_ID, caster)) 
  { tell_object(caster, BS("Du kannst die Melodie noch nicht wieder "
                        "spielen."));
    return 0; }
  if(!silent)
  {
    if((10+caster->QueryProp(P_HP))>=(caster->QueryProp(P_MAX_HP)))
    { tell_object(caster, BS("Du benoetigst jetzt keine Heilung!"));  
      return 0; }
    if(R_SKILLMASTER->HasSkill(getuid(caster), RUHEHORT)) { 
      call_out("melodie_ruhe_heal",1,caster, caster->QueryProp(P_GUILD_LEVEL) / 5); 
    }
  }
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int melodie_der_ruhe(object caster, mapping sinfo)
{
  object ob;
  int success, ability, wdh, hp;
  
  if(!mappingp(sinfo=prep_melodie_der_ruhe(caster, sinfo, 1))) return 0;
  
  success=SpellSuccess(caster,sinfo);
  if(success<0)
  {
    tell_object(caster,BSC("Du hast die Melodie nicht richtig wiedergegeben. "
                       "Die erhoffte Wirkung bleibt aus."));
    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
  
  if(ob=clone_object(OBJ"heal"))
  {
    ob->move(caster, M_SILENT|M_NOCHECK);
    wdh=ability/2000+1;//1-6 - Wiederholungen
    hp=((success+10000)/2000)+10+(ability/1000);//10-25 Heilkraft
    ob->heal(wdh, hp);
    call_out("iama_voice_of_nature", 0, caster);
    present(IAMA_ID, caster)->SongPlayed();
    return ERFOLG;
  }
  return 0;
}

void melodie_ruhe_heal(object caster, int counter)
{
  int hp;

  if(!objectp(caster)) return;

  tell_object(caster, BS("Die Melodie hat bereits jetzt eine beruhigende Wirkung auf Dich."));
  hp = get_equip_damage(caster, "melodie der ruhe", 10+random(10));
  caster->AddHp(hp);
  if(counter<1) return;
  
  counter--;
  call_out("melodie_ruhe_heal",1,caster, counter); 
}