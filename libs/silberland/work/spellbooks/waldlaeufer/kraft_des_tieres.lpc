mapping prep_kraft_des_tieres(object caster, mapping sinfo, int silent) 
{ 
  object pet;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo) ) return 0;
  if(present(KRAFT_DES_TIERES_ID, caster))
  { tell_object(caster, BS("Du kannst Diesen Zauber nur einmal anwenden.")); 
    return 0;}
  if(!(pet=FindPet(caster)))
  { tell_object(caster, BS("Dein Tier ist nicht bei Dir."));
    return 0;}
  sinfo[SI_ENEMY]=pet;
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(sprintf("%s blickt %s tief konzentriert in die Augen.",
            caster->Name(WER), pet->name(WEM))), ({caster}));

  }

  return sinfo;
}

int kraft_des_tieres(object caster, mapping sinfo)
{
  int success, ability, t;
  object pet, ob;
  
  if(!mappingp(sinfo=prep_kraft_des_tieres(caster, sinfo, 1))) return 0;
  pet=sinfo[SI_ENEMY];
  
  success=SpellSuccess(caster,sinfo);
  if(success < (-5000))
  {
    tell_object(caster, BSC("Du gibst "+pet->name(WEM, 1)+" das falsche "
                        "Zeichen."));
    tell_room(ENV(caster), BS( pet->Name(WER, 1)+" verschwindet."));
    pet->remove(0);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC(pet->Name(WER, 1)+" versteht nicht."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY];
  if(t=pet->SwitchBonus(ability/50+success/50))
  { 
    //DBD(to_string(t));
    ob=clone_object(OBJ"bonus");
    ob->move(caster, M_NOCHECK);
    ob->AddId(KRAFT_DES_TIERES_ID);
    ob->new_remove(t+5);
    return ERFOLG;
  }
  tell_object(caster, BS("Etwas ist schief gelaufen."));
  return 0;
}