mapping prep_hymne_des_waldes(object caster, mapping sinfo, int silent) 
{ 
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!FroschTest(caster, sinfo) || 
     !IsNotInFight(caster,sinfo)||
     !BlindTest(caster,sinfo)     )
    return 0;
         
  if(!present(IAMA_ID, caster)) { 
    tell_object(caster, BS("Ohne Deine Iama geht das nicht!")); 
    return 0; 
  }

  if( (caster->QueryProp(P_RANGER_LAST_HYMNE_DES_WALDES)) > time() ) { 
    tell_object(caster, BS("Du kannst noch keinen neuen Wald erschaffen."));
    return 0; 
  }

  if(objectp(present(HYMNEN_SPAWNER, caster))) {
    write(BS("Die Hymne des Waldes wirkt bereits um dich herum!"));
    return 0;
  }

  if( !objectp(ENV(caster)) ) {return 0;}
  if( ENV(caster)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == TT_FOREST) { 
    tell_object(caster, BS("Du befindest Dich doch schon in einem Wald!"));
    return 0; 
  }

  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
  }
  return sinfo;
}

int hymne_des_waldes(object caster, mapping sinfo)
{
  int success;
  object ob;
  
  if(!mappingp(sinfo=prep_hymne_des_waldes(caster, sinfo, 1))) return 0;
  
  success=SpellSuccess(caster,sinfo);
  if(success<0)
  {
    tell_object(caster, BSC("Du hast die Hymne nicht richtig wiedergegeben. "
                        "Die erhoffte Wirkung bleibt aus."));
    return MISSERFOLG;
  }

  if( ENV(caster)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == TT_JUNGLE)
  { sinfo[SI_RAW_SPELLCOST]-=sinfo[SI_RAW_SPELLCOST]/4; }
  tell_object(caster, BS("Du hast es geschafft, die Hymne wird gestaerkt "
                      "durch die ewige Flamme Tethyrs diese Umgebung in "
                      "einen Wald verwandeln."));
  tell_room(ENV(caster), BS(caster->Name(WER, 1)+" spielt eine kraftvolle "
                         "Hymne und Du lauschst gebannt."), ({caster})); 
                         
  if(sinfo[SI_SKILLABILITY] > 9000) {
    ob = clone_object(OBJ "hymnen_spawner");
    ob->move(caster, M_NOCHECK );
    ob->Setup(caster, sinfo[SI_SKILLABILITY], success);
    return ERFOLG;
  } else {
      R_SKILLMASTER->hymne_des_waldes_exe(caster);
  }

  call_out("iama_voice_of_nature", 0, caster);
  present(IAMA_ID, caster)->SongPlayed();
  return ERFOLG;
}