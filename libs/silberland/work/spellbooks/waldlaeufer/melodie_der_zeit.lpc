mapping prep_melodie_der_zeit(object caster, mapping sinfo, int silent)
{  
  object ob;

  if(!GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo) )
    return 0;

    if(!present(IAMA_ID, caster))
    { tell_object(caster, BS("Ohne Deine Iama geht das nicht!")); 
      return 0; }
    
  if(present(MELODY_TIME_ID, caster)) {
    tell_object(caster, BS("Die Zeit um dich herum ist bereits veraendert."));
    return 0;
  }

  
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" spielt eine komplexe und verwobene Melodie mit veraenderlichem Rhythmus."), ({caster}));
  }
  return sinfo;
}

int melodie_der_zeit(object caster, mapping sinfo)
{
  object ob;
  int ability, success, i;
  string message;
 
  if(!mappingp(sinfo=prep_melodie_der_zeit(caster, sinfo, 1))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < 0)
  {
    message = "Du Zeit um dich herum flimmert und flackert einen Moment. ";
    if(success < -3000) {
      message += "Dann frierst du in der Zeit fest.";
      caster->SetProp(P_PARALYZED, 2+random(10));
    } else if(success < -1500) {
      message += "Deine Koerperzeit vergeht ploetzlich langsamer!";
      // delay hp and sp
    } else if (success < -500) {
      message += "Um dich herum vergeht die Zeit ploetzlich viel schneller!";
      caster->ModifySkillAttribute(caster, SA_SPEED, 50, 60);
    }

    tell_object(caster, BS(message));

    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
 
  if(!objectp(ob=clone_object(OBJ "melody_time"))) {
    tell_object(caster,BS("Ein Fehler ist aufgetreten(melody_time/cl)."));
    return 0;
  }
  ob->move(caster, M_NOCHECK);

  ob->Setup(caster, ability, success);
  
  tell_object(caster, BS("Du spielst die Melodie und die Zeit beginnt sich um dich in wilden Wirbeln auszudehnen und zusammenzuziehen."));
  tell_room(ENV(caster), BS(caster->Name(WER)+" spielt eine Melodie und es wirkt als ob die Zeit in "+caster->QueryPronoun(WEN, WESSEN)+" Umgebung merkwuerdig verzerrt wird."), ({caster}));
  call_out("iama_voice_of_nature", 0, caster);
  present(IAMA_ID, caster)->SongPlayed();
  return ERFOLG;
}