//-- Der eigentliche Messerstich ---------------------------------------------
mapping prep_markierungsschuss(object caster, mapping sinfo, int silent)
{ 
  object ob;
  
  if(!TestNoTrance(caster, sinfo)) return 0;
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo) || 
     !IsInFight(caster,sinfo)   ||
     !BlindTest(caster,sinfo)     )
    return 0;
 
  ob=FindEnemyVictim(sinfo[SI_SKILLARG],caster,"Wen willst Du markieren?\n");
  if(!ob) return 0;
  sinfo[SI_ENEMY]=ob;
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" nimmt ein kleines Beutelchen zur Hand und zielt auf "+ob->name(WEN)+"."), ({caster}));
  }
  return sinfo;
}

int markierungsschuss(object caster, mapping sinfo) 
{
  object ob, pet, last_victim;
  mixed pref;
  int i, success;

  if(!mappingp(sinfo=prep_markierungsschuss(caster, sinfo, 1))) return 0;
  ob=sinfo[SI_ENEMY];  

  success=SpellSuccess(caster,sinfo);
  if(success<0)
  {
    tell_object(caster, BSC("Du wirfst den Markierbeutel weit daneben."));
    return MISSERFOLG;
  }
  
  tell_room(ENV(caster), BS(caster->Name(WER)+" wirft einen Farbbeutel auf "+ob->name(WEN)+"."), ({caster}));
  tell_object(caster, BS("Dein Beutel explodiert in einer Farbexplosion und huellt dein Ziel ein. "
                         "Jetzt hast du "+ob->name(WEN, 1)+" besser im Blick!."));
  caster->SetProp(P_PREFERED_ENEMY, ({sinfo[SI_SKILLABILITY]/100, ob}) );
  
  if( (pet=FindPet(caster)) && (objectp(pet)) )
  { pet->SetProp(P_PREFERED_ENEMY, ({sinfo[SI_SKILLABILITY]/100, ob}) ); 
    tell_object(caster, BS(pet->Name()+" konzentriert die Angriffe auf "+ob->name(WEN, 1)+"."));}   
  return ERFOLG;
}

