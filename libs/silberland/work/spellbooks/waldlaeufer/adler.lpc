mapping prep_adler(object caster, mapping sinfo, int silent) 
{
  if(!TestNoTrance(caster, sinfo) ||
     !GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo) || 
     !AnimalTest(caster,sinfo)  ||
     !BlindTest(caster,sinfo)     )
    return 0;

  if(objectp(present(HAWK_ID+"_"+getuid(caster), ENV(caster)))) {
    tell_object(caster, BS("Dieses Tier begleitet dich bereits."));
    return 0;
  }
      
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int adler(object caster, mapping sinfo)
{
  object ob;
  int success, ability;
  
  if(!mappingp(sinfo=prep_adler(caster, sinfo, 1))) return 0;
  
  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Du hast nicht das Lebewesen erreicht, was Du "
                        "gesucht hast."));
    ob=clone_object(WALDSCHRAT_NPC);
    ob->move(ENV(caster), M_GO);
    ob->Kill(caster);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC("Du hast kein Lebewesen erreichen koennen."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY];
    
  if(caster->QueryProp(P_TESTPLAYER)) ob = clone_object(NPC "summons2");
  else ob=clone_object(NPC"summons");
  ob->customize(caster, "adler", success, ability);
  
  if(success >= 8500){ 
    ob->pimp(); 
    caster->Message(BSC("Ein kurzer schmerzhafter Ruck faehrt Durch deinen "
                       "Kopf. Du hast zwei riesige Schwingen gesehen ..."));
  }
  else {
     caster->Message(BSC("Du legst Deinen kopf in den Nacken und neben dem "
                       "fernen Rauschen des Windes hoerst Du "
                       "Fluegelschlagen."));
  }
  ob->move(ENV(caster), M_GO);
  return ERFOLG;
}