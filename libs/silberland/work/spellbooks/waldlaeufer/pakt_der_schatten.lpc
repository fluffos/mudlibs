mapping prep_pakt_der_schatten(object caster, mapping sinfo, int silent)
{  
  if(!TestNoTrance(caster, sinfo)) return 0;
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo))
    return 0;
    
  if(objectp(present(SHADOW_CONTROL_ID, caster)) || objectp(present(PLAYER_DAMAGE_ID, caster)))
  { tell_object(caster, BS("Du kannst den Zauber noch nicht wirken."));
    return 0;}
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int pakt_der_schatten(object caster, mapping sinfo)
{
  object ob, sh;
  int success;
  
  if(!mappingp(prep_pakt_der_schatten(caster, sinfo, 1))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < (-8000))
  {
    tell_object(caster, BSC("Du hast die falschen Schatten angerufen ..."));
    caster->AddHp(-10-(random(10)));
    return MISSERFOLG;
  }
  if(success<-3000)
  {
    tell_object(caster, BSC("Die Schatten erhoeren Dein Flehen nicht."));
    return MISSERFOLG;
  }
  
  ob=clone_object(OBJ "schatten");
  sh=clone_object(NPC "schatten");
    
  if(!ob) {caster->Message(BSC("Ein Fehler ist aufgetreten. Wende Dich "
                               "an einen Gildenmagier.")); return 0;}
  
  ob->move(caster, M_GET);
  sh->move(ENV(caster), M_TPORT | M_SILENT);
  caster->move(ROOM"air", M_TPORT | M_SILENT | M_NO_SHOW);
  ob->get_control(sh);
  ENV(sh)->Message(BS(caster->Name(WER)+" wird zum eigenen Schatten."));
  caster->Message(BSC("Mit einem Schritt verschwindest du in der Halbwelt und nur "
                  "dein Schatten bleibt zurueck."));
  return ERFOLG;
}