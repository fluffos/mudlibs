mapping prep_ode_des_sturmes(object caster, mapping sinfo, int silent)
{
  //Aenderungen der Werte im sinfo Mapping vermeiden! 
  if(!FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo)||
     !BlindTest(caster,sinfo)     )
    return 0;
         
  if(!present(IAMA_ID, caster))
  { tell_object(caster, BS("Ohne Deine Iama geht das nicht!")); 
    return 0; }

  if( caster->QueryProp(P_TMP_ATTACK_HOOK) != 0 && caster->QueryProp(P_TMP_ATTACK_HOOK)[0] >= time() ) { 
    tell_object(caster, BS("Deine Angriffe werden bereits verstaerkt."));
    return 0; 
  }
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}


int ode_des_sturmes(object caster, mapping sinfo)
{
  int success, abil;
  object ob;
  
  if(!mappingp(sinfo=prep_ode_des_sturmes(caster, sinfo, 1))) return 0;
  
  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Du hast die Ode gaenzlich falsch gespielt! "
                        "Aus heiterem Himmel trifft dich ein Blitz!"));
    SetProp(P_KILL_NAME, "Ein Blitz aus heiterem Himmel");
    caster->do_damage(-1*success/100);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC("Du hast die Ode nicht richtig wiedergegeben. "
                        "Die erhoffte Wirkung bleibt aus."));
    return MISSERFOLG;
  }

  tell_object(caster, BS("Wind heult auf und Blitze schlagen um dich ein. Die Kraft des Sturms begleitet dich nun."));
  tell_room(ENV(caster), BS("Wind heult auf und Blitze schlagen um "+caster->name(WEN)+" ein. "), ({caster}));

  abil = sinfo[SI_SKILLABILITY];
  ob = clone_object(OBJ "ods");
  if(ob->move(caster, M_NOCHECK|M_SILENT) != 1) {
    ob->remove(1);
    write("Fehler!");
  }
  ob->Setup(caster, abil, success);

  return ERFOLG;
}