mapping prep_violette_flamme(object caster, mapping sinfo, int silent)
{  
  object ob;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo)   ||
     !KnifeTest(caster, sinfo)   ||
     !BlindTest(caster,sinfo)     )
    return 0;
    
  if(present(BLUTDORN_ID, caster)) {
    tell_object(caster, BS("Deine Waffe ist bereits mit Blutdorn ueberzogen."));
    return 0;
  }

  ob = caster->QueryProp(P_WEAPON);

  if(ob->QueryProp(P_UNWIELD_FUNC) != 0 || ob->QueryProp(P_HIT_FUNC) != 0 || ob->QueryProp(P_WEAPON_TYPE) != WT_KNIFE) {
    tell_object(caster, BS("Auf dieser Waffe kannst du keinen Blutdorn wuchern lassen."));
  }

  if(!silent) {
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(sprintf("%s streut ein paar Samen auf %s Waffe und traeufelt dann %s eigenes Blut darueber...",
                            caster->Name(WER), caster->QueryPossPronoun(FEMALE, WEN, SINGULAR), caster->QueryPossPronoun(NEUTER, WEN, SINGULAR))), 
                            ({caster}));
  }

  return sinfo;
}

int violette_flamme(object caster, mapping sinfo)
{
  object ob, weapon;
  int ability, success, i;
 
  if(!mappingp(sinfo=prep_violette_flamme(caster, sinfo, 1))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < (-7500))
  {
    tell_object(caster, BSC("Die Blutdornsamen spriessen auf deiner Haut!"));
    caster->AddHp(-10 + success/100);
    tell_room(ENV(caster), BS(caster->Name(WER)+" verzieht das Gesicht vor Schmerzen!")), ({caster});
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster,BSC("Die Blutdornsamen bluehen kurz auf und verwelken sofort wieder."));
    tell_room(ENV(caster), BS("... und kurz bluehen die Samen auf, verwelken aber sofort wieder."), ({caster}));
    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
  weapon=caster->QueryProp(P_WEAPON); // durch prep tests sichergestellt, dass es ein messer ist
  tell_room(ENV(caster), BS("Ueber "+caster->name(WESSEN)+" Waffe wuchern dicke rote Ranken mit dicken "
                              "Dornen."), ({caster}));
  caster->AddHp(- 30 + ability/666 + success/666);
  
  ob = clone_object(OBJ "blutdorn_klinge");
  ob->move(caster, M_SILENT|M_NOCHECK);
  ob->Setup(weapon, caster, ability, success);

  return ERFOLG;
}