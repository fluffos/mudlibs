mapping prep_augen_des_jaegers(object caster, mapping sinfo, int silent) 
{  
  object ob;
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) ||
     !BlindTest(caster, sinfo) ||
     !IsNotInFight(caster, sinfo) )
    return 0;
  if(present(VISION_ID, caster))
  {
    tell_object(caster,BS("Du kannst Deine Sehkraft noch nicht veraendern."));
    return 0;
  }
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER, 1)+" schliesst die Augen und haelt sich zwei Finger an die Schlaefen."), ({caster}));
  }
  return sinfo;
}

int augen_des_jaegers(object caster, mapping sinfo)
{
  object ob;
  int success;
  
  if(!mappingp(prep_augen_des_jaegers(caster, sinfo, 0))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Ploetzlich legt sich ein dunkler Schleier "
                        "ueber deine Augen."));
    caster->SetProp(P_BLIND, 5);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC("Deine Augen bleiben unveraendert."));
    return MISSERFOLG;
  }
  
  pDebug(caster, sprintf("augen_des_jaegers :: success=%d\n", success));
  ob=clone_object(OBJ"bonus");
  if(ob)
  {
    ob->move(caster, M_SILENT);
    ob->SetVision(sinfo[SI_SKILLABILITY]/50+success/20);
    if(sinfo[SI_SKILLABILITY] > 6000) {
      ob->SetLifeSense();
    }
    if(sinfo[SI_SKILLABILITY] > 8000) {
      ob->SetDetectLife();
    }

    tell_room(ENV(caster), BS(caster->Name(WESSEN,1)+" Augen gluehen auf wie die eines Raubtiers in der Nacht."), ({caster}));
    return ERFOLG;
  }
    
  return MISSERFOLG;
}
