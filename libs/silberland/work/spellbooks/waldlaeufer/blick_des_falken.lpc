mapping prep_blick_des_falken(object caster, mapping sinfo, int silent) 
{
   object ob; 
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) || 
     !FroschTest(caster, sinfo) || 
     !BowTest(caster,sinfo)     ||
     !IsInFight(caster,sinfo)||
     !BlindTest(caster,sinfo)     )
    return 0;


  if(pointerp(caster->QueryProp(P_RANGER_FALCONEYES))) {
    tell_object(caster, BS("Du hast bereits den Blick eines Falken auf ein Ziel gerichtet."));
    return 0;
  }
      
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" schliesst die Augen und legt zwei Finger auf die Schlaefen."), ({caster}));
    aim(caster, sinfo);
  }

  if(!objectp(ob=sinfo[SI_ENEMY])) {
    ob = FindEnemyVictim(sinfo[SI_SKILLARG], caster, 
                    "Auf wen soll sich dein Blick fokussieren?\n");
    if(!ob) return 0;
 }
 sinfo[SI_ENEMY]=ob;
 if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}

  return sinfo;
}

int blick_des_falken(object caster, mapping sinfo) {
    int success, ability, duration;
    float multiplier;
    object ob;
    string gradeInfo;
  
    if(!mappingp(sinfo=prep_blick_des_falken(caster, sinfo, 1))) return 0;
    ob = sinfo[SI_ENEMY];
    
    success=SpellSuccess(caster,sinfo);
    if(success<0) {
      if(success < -5000) {
        tell_object(caster, BS("Den Blick verschwimmt und du wirst blind."));
        caster->SetProp(P_BLIND, random(10));        
      } else if(success < -2500) {
        tell_object(caster, BS("Dein Blick verschwimmt und deine Schuesse werden ungenau."));
        caster->SetProp(P_RANGER_FALCONEYES, ({time()+2+random(10), ob, 0.5}));
      } else {
        tell_object(caster, BS("Du reisst die Augen auf, doch dein Blick bleibt unfokussiert."));
      }
      return MISSERFOLG;
    }
    
    ability=sinfo[SI_SKILLABILITY];
    
    duration = caster->QueryAttribute(A_INT)/2 + ability/1000 + success/1000;
    multiplier = ability/40000.0 + success/40000.0;
    multiplier += get_equip_bonus(caster, "blick des falken") / 100.0;

    if(multiplier >= 0.0 && multiplier < 0.1) gradeInfo = "ein wenig";
    else if(multiplier >= 0.1 && multiplier < 0.2) gradeInfo = "merklich";
    else if(multiplier >= 0.2 && multiplier < 0.3) gradeInfo = "deutlich";
    else if(multiplier >= 0.3 && multiplier < 0.4) gradeInfo = "stark"; 
    else if(multiplier >= 0.4 && multiplier < 0.5) gradeInfo = "sehr stark";
    else if(multiplier >= 051 && multiplier < 0.6) gradeInfo = "absolut";
    else if(multiplier >= 0.6 && multiplier < 1.0) "obsessiv";
    else gradeInfo = "gar nicht";

    tell_object(caster, BS("Du reisst die Augen auf und dein blick fokussiert sich "+gradeInfo+" auf "+ob->name(WEN)+". Alles andere verblasst."));
    caster->SetProp(P_RANGER_FALCONEYES, ({time()+duration, ob, multiplier}));

    call_out("check_end_falconeyes", 0, caster);
    
    return ERFOLG;
}

public void check_end_falconeyes(object caster) {
  mixed *x;

  if(!objectp(caster)) return;
  if(!pointerp(x=caster->QueryProp(P_RANGER_FALCONEYES))) return;

  if(x[0] <= time() || !objectp(x[1])) {
    tell_object(caster, BS("Dein Blick klaert sich wieder und du verlierst deinen Fokus."));
    caster->SetProp(P_RANGER_FALCONEYES, 0);
  }

  call_out("check_end_falconeyes", 0, caster);
}
