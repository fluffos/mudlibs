mapping prep_inkarnation_der_koenige(object caster, mapping sinfo, int silent) 
{ 
  object pet;

  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo) )
    return 0;
  if(!(pet=FindPet(caster))) { 
    tell_object(caster, BS("Dein Tier ist nicht bei Dir."));
    return 0;
  }

  if(pet->QueryIncarnation()){ 
    tell_object(caster, BS("Die Macht der Tierkoenige pulsiert noch in "+pet->name(WEM, 1)+".")); 
    return 0;
  }
  
  sinfo[SI_ENEMY]=pet;
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(sprintf("%s beruehrt %s und spricht eine alte Beschwoerungsformel.",
            caster->Name(WER), pet->name(WEN))), ({caster}));
  }
  return sinfo;
}

int inkarnation_der_koenige(object caster, mapping sinfo)
{
  int success, ability, i;
  object pet;
  string *size;
  
  if(!mappingp(sinfo=prep_inkarnation_der_koenige(caster, sinfo, 1))) return 0;
  pet=sinfo[SI_ENEMY];  
  
  success=SpellSuccess(caster,sinfo);
  if(success < (-5000))
  {
    tell_object(caster, BSC("Die Tierkoenige sind erzuernt!."));
    tell_room(ENV(caster), BS( pet->Name(WER, 1)+" winselt auf und wirkt ploetzlich viel schwaecher."));
    pet->AddHp(-500);
    pet->SetProp(P_DISABLE_SPELLS, 10);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, "Die Tierkoenige erhoehren den Flehen nicht.\n");
    tell_room(ENV(pet), pet->Name(WER, 1)+" sieht unveraendert aus.\n");
    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
  
  pet->SetIncarnation(ability, success);
  return ERFOLG;
}