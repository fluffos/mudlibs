mapping prep_melodie_des_ostens(object caster, mapping sinfo, int silent)
{ 
  //Aenderungen der Werte im sinfo Mapping vermeiden! 
  if(!FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo) ) return 0;
     
  if(!present(IAMA_ID, caster))
  { tell_object(caster, BS("Ohne Deine Iama geht das nicht!")); 
    return 0; }
     
  if(present(MELODIE_DES_OSTENS_ID, caster)) 
  { 
    tell_object(caster, BS("Du kannst Deine koerperlichen Faehigkeiten nicht "
                        "weiter steigern.")); 
    return 0; }
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int melodie_des_ostens(object caster, mapping sinfo)
{
  object bonus;
  int i, success, ability;
  string *d;
  
  if(!mappingp(sinfo=prep_melodie_des_ostens(caster, sinfo, 1))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Du hast die Melodie so falsch gespielt, dass "
                        "sich die Wirkung ins Gegenteil verkehrt!"));
    bonus=clone_object(OBJ"bonus");
    bonus->move(caster, M_SILENT);
    bonus->SetBonus("dex",(-3),60+random(60));
    bonus->AddId(MELODIE_DES_OSTENS_ID);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster,BSC("Du hast die Melodie nicht richtig wiedergegeben. "
                       "Die erhoffte Wirkung bleibt aus."));
    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
  
  i=(ability/1000)+((success+10000)/10000); //0-12
  i += i * get_equip_bonus(caster, "melodie des ostens") / 100;

  d=({"Zwerge","Menschen","Elfen","Dunkelelfen",
      "Feen","Hueter","Meisterdiebe"});
  bonus=clone_object(OBJ"bonus");
  bonus->move(caster, M_SILENT);
  bonus->SetBonus("dex", i, (60*ability/1000));
  bonus->AddId(MELODIE_DES_OSTENS_ID);
  
  tell_object(caster, BS("Du bekommst die Geschicklichkeit der "+d[(i/2<sizeof(d)?i/2:sizeof(d)-1)]+"."));
  tell_room(ENV(caster), BS(caster->Name(WESSEN, 1)+" Bewegungen werden geschmeidiger und fliessender."), ({caster}));  

  call_out("melodie_osten_end", (60*ability/1000), caster);
  call_out("iama_voice_of_nature", 0, caster);
  present(IAMA_ID, caster)->SongPlayed();
  return ERFOLG;
}

public void melodie_osten_end(object caster) {
  tell_object(caster, BS("Die Geschmeidigkeit der Melodie gleitet von dir ab."));
  return;
}