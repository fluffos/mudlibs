mapping prep_gemeinsame_attacke(object caster, mapping sinfo, int silent)
{  
  object ob,pet;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!TestNoTrance(caster, sinfo) || !GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo)  || 
     !IsInFight(caster, sinfo) )
    return 0;
    
  if(!(pet=FindPet(caster))) {
     tell_object(caster, BS("Dein Tier ist nicht bei Dir."));
    return 0;
  }

  if(pet->QueryProp(P_RANGER_NEXT_ANIMAL_ATACK) > time()) {
    tell_object(caster, BS("Dein Kampfgefaehrte ist noch nicht bereit!"));
    return 0;
  }

  if(!(pet->QueryFight())) { 
    tell_object(caster, BS(pet->Name(WER, 1)+" kaempft aber nicht mit Dir zusammen."));
    return 0;
  }

  if(pointerp(caster->QueryProp(P_RANGER_PET_SUPPORT))) {
    tell_object(caster, BS(pet->Name(WER, 1)+" kaempft bereits mit dir zusammen!"));
    return 0;
  }

  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(sprintf("%s gibt %s den Befehl zu Unterstuetzen.",
            caster->Name(WER), pet->Name(WER)))), ({caster});
  }
  
  return sinfo;
}

int gemeinsame_attacke(object caster, mapping sinfo)
{
  int success, ability, pet_damage;
  object pet, ob;
  mixed *oldHands;
  
  if(!mappingp(sinfo=prep_gemeinsame_attacke(caster, sinfo, 1))) return 0;
  ob=sinfo[SI_ENEMY]; pet=FindPet(caster);

  success=SpellSuccess(caster,sinfo);
  if(success < (-5000))
  {
    tell_room(ENV(caster), BS( pet->Name(WER, 1)+" ist verwirrt."));
    pet->SetProp(P_DISABLE_ATTACK, random(6));
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC(pet->Name(WER, 1)+" versteht nicht."));
    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
  
  pet->ActivateSupportBenefit(ability, success);
  return ERFOLG;
}