mapping prep_freipfeile(object caster, mapping sinfo, int silent)
{  
  object ob;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!TestNoTrance(caster, sinfo) || !GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo) ||
     !BlindTest(caster,sinfo) || !IsNotInFight(caster, sinfo)     )
    return 0;

  ob = present(GUILD_OBJ_ID, caster);
  if(ob->QueryProp(P_RANGER_FREISCHUETZ)) {
    write(BS("Du hast bereits Freipfeile beschworen."));
    return 0;
  }

  if(caster->QueryProp(P_RANGER_NEXT_FREIPFEILE) > time()) {
    write(BS("Du kannst die Schatten nicht schon wieder um Freipfeile bitten."));
    return 0;
  }
  
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" zeichnet einen Kreis mit Runen aus Blut auf den Boden und setzt sich meditierend davor."), ({caster}));
    caster->AddHp(-25);
  }

  return sinfo;
}

int freipfeile(object caster, mapping sinfo) 
{
  object koecher;
  int ability, success;

  if(!mappingp(sinfo=prep_freipfeile(caster, sinfo, 1))) return 0;
  koecher = present(GUILD_OBJ_ID, caster);

  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(1000)))
  {
    tell_object(caster, BSC("Die Schatten sind erzuernt von deiner Bitte und rauben dir Lebenskraft als Tribut!!!"));
    caster->AddHp(-10 - random(50));
    return MISSERFOLG;
  }

  if(success<0)
  {
    tell_object(caster, BSC("Deine Bitte an die Schatten wird nicht erhoehrt."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY]; success=SpellSuccess(caster, sinfo);
  koecher->SetProp(P_RANGER_FREISCHUETZ, ({0, ability/1000}));
  caster->SetProp(P_RANGER_NEXT_FREIPFEILE, time() + 3600 - success/5);

  write(BS(sprintf("Die Schatten erhoeren deine Bitte. Mit einem magischen Schimmern bilden sich in dem Blutkreis %d schwarze Freipfeile mit blutroten Federn, die deine "
                   "Feinde an ihren empfindlichsten Stellen treffen werden.", ability/1000)));
  write(BS("Mit <freipfeil> legst du einen Freipfeil auf die Sehne, der fuer deinen naechsten Bogenangriff genutzt wird."));

  say(BS("In dem Blutkreis vor "+caster->name(WEM)+" erscheinen in einem magischen Schimmern einige schwarze Pfeile mit rotem Gefieder. "
         "Ein Schauer laeuft dir den Ruecken herab."));

  return ERFOLG;
}
