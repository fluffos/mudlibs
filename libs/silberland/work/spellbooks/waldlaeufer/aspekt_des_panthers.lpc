mapping prep_aspekt_des_panthers(object caster, mapping sinfo, int silent) 
{
  if(!TestNoTrance(caster, sinfo) ||
     !GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo)  ||
     !BlindTest(caster,sinfo)     )
    return 0;

  if(objectp(present(PANTHER_ASPECT_ID, caster))) {
    tell_object(caster, BS("Du hast das Tier in dir bereits geweckt."));
    return 0;
  }
      
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" nimmt eine raubtierhafte Haltung ein."), ({caster}));
  }

  return sinfo;
}

int aspekt_des_panthers(object caster, mapping sinfo) {
    int success, ability;
    object ob;
  
    if(!mappingp(sinfo=prep_aspekt_des_panthers(caster, sinfo, 1))) return 0;

    ob = clone_object(OBJ "panther_aspect");
    ob->move(caster, M_NOCHECK|M_SILENT);
    
    success=SpellSuccess(caster,sinfo);
    if(success<0) {
        tell_object(caster, BSC("Es gelingt dir nicht den Geist des Panthers in dich aufzunehmen."));
        ob->fail(caster, success);
        return MISSERFOLG;
    }
    
    ability=sinfo[SI_SKILLABILITY];
        
    ob->Setup(caster, ability, success);
    return ERFOLG;
}