mapping prep_spinne(object caster, mapping sinfo, int silent) 
{
  string s, *str;

  if(!TestNoTrance(caster, sinfo)) return 0;
  
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo) || 
     !AnimalTest(caster,sinfo)  ||
     !BlindTest(caster,sinfo)     )
    return 0;

  if(objectp(present(SPIDER_ID+"_"+getuid(caster), ENV(caster)))) {
    tell_object(caster, BS("Dieses Tier begleitet dich bereits."));
    return 0;
  }
    
  s=caster->_unparsed_args();
  str=explode(s, " "); str-=({str[0]});
  s=lower_case(implode(str, " "));

  if(s != "" && !R_SKILLMASTER->HasSkill(getuid(caster), GEWALT_DER_URAHNEN)) {
    write(BS("Du kannst die Gewalt der Urahnen nicht anrufen!"));
    return 0;
  }


  if((s=="mit der kraft der urahnen") && ((sinfo[SI_SKILLABILITY])>=MAX_ABILITY) ) 
  { if(!PETMASTER->QueryLegend(caster, "ank'su'namun")) {return 0;}
    sinfo[SI_ENEMY]=1;}
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int spinne(object caster, mapping sinfo)
{
  object ob;
  int success, ability;
  
  if(!mappingp(sinfo=prep_spinne(caster, sinfo, 1))) return 0;
  
  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Du hast nicht das Lebewesen erreicht, was Du "
                        "gesucht hast."));
    ob=clone_object(WALDSCHRAT_NPC);
    ob->move(ENV(caster), M_GO);
    ob->Kill(caster);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC("Du hast kein Lebewesen erreichen koennen."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY];
    
  if(caster->QueryProp(P_TESTPLAYER)) ob = clone_object(NPC "summons2");
  else ob=clone_object(NPC"summons");
  ob->customize(caster, "spinne", success, ability);
  
  if(success>=9000)
  { ob->pimp(); 
    caster->Message(BSC("Deine Gedanken schweifen ab in die Unterwelt und Du "
                       "entdeckst ein Wesen, welches seit Jahren nicht "
                       "gesehehn wurde."));}
  else 
  { caster->Message(BSC("Im Geiste suchst Du den Boden des Waldes ab und "
                       "tatsaechlich. Du findest eine Riesenspinne ..."));}
  if(sinfo[SI_ENEMY])
  { if(ob->to_anksunamun())
    { PETMASTER->SetLegend(ob);
      caster->SetProp(P_RANGER_NEXT_ANKSUNAMUN, time()+(60*60));
      caster->Message(BSC("Ploetzlich zuckst Du zusammen. Du spuerst ein "
                     "stark beklemmendes Gefuehl in Deiner Magengegend. Du "
                     "glaubst koenntest etwas Urgewaltiges gerufen haben."));}
  }
  ob->move(ENV(caster), M_GO);
  PETMASTER->SetPet(caster, ob); 
  return ERFOLG;
}