mapping prep_kraft_der_ahnen(object caster, mapping sinfo, int silent) 
{ 
  object pet;

  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo) )
    return 0;
  if(!(pet=FindPet(caster))) { 
    tell_object(caster, BS("Dein Tier ist nicht bei Dir."));
    return 0;
  }

  if(pet->QueryBiest()){ 
    tell_object(caster, BS("Der Waldgeist beherrscht noch "+pet->name(WEN, 1)+".")); 
    return 0;
  }

  if(!pet->QueryBiestReady()) {
    tell_object(caster, BS(sprintf("%s ist noch nicht bereit erneut von einem Naturgeist beseelt zu werden.", pet->Name(WER, 1))));
    return 0;
  }
  
  sinfo[SI_ENEMY]=pet;
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(sprintf("%s legt %s Haende auf den Kopf %s.",
            caster->Name(WER), caster->QueryPossPronoun(FEMALE, WEN, PLURAL),
            pet->name(WESSEN))), ({caster}));
  }
  return sinfo;
}

int kraft_der_ahnen(object caster, mapping sinfo)
{
  int success, ability, i;
  object pet;
  string *size;
  
  if(!mappingp(sinfo=prep_kraft_der_ahnen(caster, sinfo, 1))) return 0;
  pet=sinfo[SI_ENEMY];  
  
  success=SpellSuccess(caster,sinfo);
  if(success < (-5000))
  {
    tell_object(caster, BSC("Du gibst "+pet->name(WEM, 1)+" das falsche "
                        "Zeichen."));
    tell_room(ENV(caster), BS( pet->Name(WER, 1)+" verschwindet."));
    pet->remove(0);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC(pet->Name(WER, 1)+" versteht nicht."));
    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
  
  //  6 von abil + 4 von success + 1 bei hoher int = max. 11
  i=ability/1666 + success/2500 + (caster->QueryAttribute(A_INT)>25?1:0);

  // bei Skill nochmal bis zu +4
  if(R_SKILLMASTER->HasSkill(getuid(caster), GEWALT_DER_URAHNEN)) {
    i += limit(caster->QueryProp(P_GUILD_LEVEL)/5, 1, 4);
  }
  size=({"sehr schwach","schwach","winzig","klein","unauffaellig",
          "mittelmaessig","stark","sehr stark","maechtig","sehr maechtig", 
          "extrem maechtir","alt","uralt","gewaltig", "urgewaltig"});
  if(pet->SetBiest(ability/1666 + success/2500))
  {
    tell_room(ENV(pet), BS("Ein "+size[i]+"er Tiergeist faehrt in "+
                        pet->name(WEN, 1)+" ein."));
    return ERFOLG;
  }
  return 0;
}