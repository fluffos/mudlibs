mapping prep_seele_der_klinge(object caster, mapping sinfo, int silent)
{  
  object ob;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo)   ||
     !KnifeTest(caster, sinfo)   ||
     !BlindTest(caster,sinfo)     )
    return 0;
    
  if(present(EDGE_SOUL_ID, caster)) {
    tell_object(caster, BS("Du bist bereits mit der Seele deiner Klinge verbunden."));
    return 0;
  }

  
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" beruehrt "+caster->QueryPossPronoun(FEMALE, WEN)+" Waffe und konzentriert sich."), ({caster}));
  }
  return sinfo;
}

int seele_der_klinge(object caster, mapping sinfo)
{
  object ob;
  int ability, success, i;
 
  if(!mappingp(sinfo=prep_seele_der_klinge(caster, sinfo, 1))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < (-7500))
  {
    tell_object(caster, BS("Die Klinge wird ganz bleich und stumpf. Sie verliert einen Teil ihrer Schaerfe!"));
    caster->QueryProp(P_WEAPON)->TakeFlaw(random(5));
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster,BSC("Es gelingt dir nicht eine Verbindung zur Klinge herzustellen."));
    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
 
  if(!objectp(ob=clone_object(OBJ "soul_edge"))) {
    tell_object(caster,BS("Ein Fehler ist aufgetreten(soul_edge/cl)."));
    return 0;
  }
  ob->move(caster, M_NOCHECK);

  ob->Setup(caster->QueryProp(P_WEAPON), caster, ability, success);
  
  tell_object(caster, BS("Du nimmst im Geiste Verbindung zum Geist der in der Klinge wohnt auf. Sie beginnt schwach zu gluehen."));
  tell_room(ENV(caster), BS("Die Klinge von "+caster->name(WEM, 1)+" beginnt matt zu gluehen!"), ({caster}) );
  return ERFOLG;
}