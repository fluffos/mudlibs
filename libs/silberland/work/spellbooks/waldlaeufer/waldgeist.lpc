mapping prep_waldgeist(object caster, mapping sinfo, int silent) 
{
  string s, *str;
  mapping env;

  if(!TestNoTrance(caster, sinfo)) return 0;
  
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo) || 
     !AnimalTest(caster,sinfo)  ||
     !BlindTest(caster,sinfo)     )
    return 0;

  if(!mappingp(env = ENV(caster)->QueryProp(P_ENVIRONMENT))) {
    if(!member(env, ENV_TERRAIN)) {
      write(BS("Du kannst hier keinen Waldgeist herbeeirufen."));
      return 0;
    } else if(env[ENV_TERRAIN] != TT_FOREST) {
      write(BS("Nur im Wald kannst du einen Waldgeist herebeirufen."));
      return 0;
    }
  }

  if(objectp(present(WOODSPIRIT_ID+"_"+getuid(caster), ENV(caster)))) {
    tell_object(caster, BS("Du hast bereits einen Waldgeist bei dir."));
    return 0;
  }
      
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" murmelt urtuemliche Worte und beruehrt einen Baum."), ({caster}));
  }

  return sinfo;
}


int waldgeist(object caster, mapping sinfo)
{
  object ob;
  int success, ability;

  if(!mappingp(sinfo=prep_waldgeist(caster, sinfo, 1))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Der Waldgeist erscheint zorning und verwandelt den Baum in einen uebellaunigen Waldschrat!"));
    ob=clone_object(WALDSCHRAT_NPC);
    ob->move(ENV(caster), M_GO);
    ob->Kill(caster);
    return MISSERFOLG;
  }

  if(success<0)
  {
    tell_object(caster, BSC("Es gelingt dir nicht einen Waldgeist in den Baum zu rufen."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY];
    
  ob=clone_object(NPC "waldgeist");
  
  ob->customize(caster, "waldgeist", success, ability);
  tell_room(ENV(caster), BS("Ein sanftes gluehen geht von dem Baum aus, der ploetzlich beginnt sich zu bewen. Ein Waldgeist hat ihn beseelt!"));
  ob->move(ENV(caster), M_GO);

  return ERFOLG;
}