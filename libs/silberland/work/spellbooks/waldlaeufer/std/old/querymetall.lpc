//VERALTET!
//-- Der Test ob der Waldlaeufer metallische Ruestungen traegt ---------------
//   ausgelagert, da noch im gildenraum benoetigt
int QueryMetal(object pl)
{
  object *armours;
  int i, metallgehalt, m;
  
  if(!pl) return 0;
  if(!(armours=pl->QueryArmours())) return 0;
  if(sizeof(armours)<1) return 0;
  metallgehalt=0; // etwas metall ist erlaubt, 1-2 nieten schaden nicht
  for(i=0;i<=sizeof(armours)-1;i++)
  { 
    //DBD(BS(to_string(armours[i]->name())+": "+
    //       to_string(armours[i]->QueryMaterialGroup(MATGROUP_METAL))));
    if((m=armours[i]->QueryMaterialGroup(MATGROUP_METAL))<10)
    {metallgehalt+=m; continue;}
    if(m>=10) return 1;
  }
  if(metallgehalt>=10) return 1;
  return 0;
}