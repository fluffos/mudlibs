//** MetallTest fuer den Caster ********************************************//
//-- Einzeltest fuer Metall --------------------------------------------------
int QuerySingleMetal(object ob)
{ 
  if( ob->QueryMaterialGroup(MATGROUP_METAL) > 10 ) {return 1;}
  return 0; 
}

//-- Der Test ob der Waldlaeufer metallische Ruestungen traegt ---------------
int QueryMetal(object pl)
{
  object *armours;
  int i;
  
  if(!pl) return 0;
  if(!(armours=pl->QueryArmours())) return 0;
  if(sizeof(armours)<1) return 0;
  for(i=0;i<=sizeof(armours)-1;i++)
  { 
    //DBD(BS(to_string(armours[i]->name())+": "+
    //       to_string(armours[i]->QueryMaterialGroup(MATGROUP_METAL))));
    if(QuerySingleMetal(armours[i])) {return 1;}
  }
  return 0;
}
//**************************************************************************//



//** Umgebungstests ********************************************************//
//-- liefert das Terrain -----------------------------------------------------
mixed QueryEnv(object pl)
{
  mixed t;
  
  if(!pl || !ENV(pl)) return TT_OTHER;
  if(t=(ENV(pl)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN])) return t;  
  return TT_OTHER;
}
//-- Testet ob sich der Waldlaeufer in einem Wald befindet (kein JUNGLE!)-----
int IsInForest(object pl)
{
  
  if(!pl || !ENV(pl)) return 0;
  if(QueryEnv(pl)==TT_FOREST) return 1;
  return 0;
}
//**************************************************************************//



//** TierTest (Tierversuche *hust*) ****************************************//
//-- Schon einen Begleiter? Unterscheidet selbst nach Art des Tieres ---------
int AnimalTest(object caster, mapping sinfo)
{
  int animal;
  
  animal=0;
  if(sinfo[SI_SPELLFUNC]=="tiere") {animal=1;}
  if(PETMASTER->GetPet(caster, animal))
  {
    tell_object(caster, BS("Du hast schon einen Begleiter."));
    return 0;
  }
  return 1;
}

//-- Steht das Pet beim caster im Raum? --------------------------------------
mixed FindPet(object player)
{
  mixed ob, env;
  
  if(!player || !objectp(env=ENV(player))) return 0;
  if(objectp(ob=present("\n"+getuid(player)+"_ranger_pet",env))) return ob;
  return 0;
}
//**************************************************************************//



//** Ist es auch der richtige Gegner? **************************************//
//-- Untot(e(r)) (Violette Flamme) -------------------------------------------
int IsUndead(object ob)
{
  if( (ob->id("untoter")) || (ob->id("untote")) || (ob->id("untotes")) ||
      (ob->id("zombie")) || (ob->id("skelett")) || (ob->id("vampir")))
  { return 1;}
  
  if( ob->is_class_member( ({CL_UNDEAD, CL_ZOMBIE, CL_SKELETON}) ) )
  { return 1;}
  
  if( (lower_case(ob->QueryProp(P_RACE)) == "untoter") || 
      (lower_case(ob->QueryProp(P_RACE)) == "zombie")  || 
      (lower_case(ob->QueryProp(P_RACE)) == "skelett") ||
      (lower_case(ob->QueryProp(P_RACE)) == "vampir")  )
  { return 1; }
  
  return 0;
}

//-- Daemon, Drache oder Golem? (Blaue Flamme) -------------------------------
int IsDemonDragonGolem(object ob)
{
  if( (ob->id("daemon")) || (ob->id("drache")) || (ob->id("golem")) )
  { return 1;}
  
  if( ob->is_class_member( ({CL_DEMON, CL_DRAGON}) ) )
  { return 1;}
  
  if( (lower_case(ob->QueryProp(P_RACE)) == "drache") || 
      (lower_case(ob->QueryProp(P_RACE)) == "daemon")  || 
      (lower_case(ob->QueryProp(P_RACE)) == "golem") )
  { return 1; }
  
  return 0;
}
//**************************************************************************//



//** Allg. Tests mit Fehlerausgabe fuer Caster *****************************//
//-- Nur im Kampf! -----------------------------------------------------------
int IsInFight(object caster, mapping sinfo)
{
  if (caster->InFight())
  {
    return 1;
  }
  tell_object(caster, BS("Das geht nur im Kampf!"));
  return 0;
}

//-- Nicht im Kampf! ---------------------------------------------------------
int IsNotInFight(object caster, mapping sinfo)
{
  if (caster->InFight())
  {
    tell_object(caster, BS("Du brauchst dafuer Ruhe. Das geht nicht im "
                        "Kampf!"));
    return 0;
  }
  return 1;
}

//-- Nicht als Frosch --------------------------------------------------------
int FroschTest(object caster, mapping sinfo)
{
  if (caster->QueryProp(P_FROG))
  {
    tell_object(caster, BS("Als Frosch kannst Du das nicht!"));
    return 0;
  }
  return 1;
}

public int TestNoTrance(object caster, mapping sinfo) {
  if(objectp(present(FLAME_CONTROL_ID, caster))) {
    tell_object(caster, BS("In deiner Kampftrance kannst du keine komplexen Faehigkeiten anwenden!"));
    return 0;
  }
  return 1;
}

public int GuildItemTest(object caster, mapping sinfo) {
  if(!objectp(present(GUILD_OBJ_ID, caster))) {
    tell_object(caster, BS("Ohne deinen Koecher kannst du nicht zaubern!"));
    return 0;
  }
  return 1;
}

//-- Nur mit gezueckten Bogen ------------------------------------------------
int BowTest(object caster, mapping sinfo)
{
  object weapon;
  weapon=caster->QueryProp(P_WEAPON);
  if(!weapon || weapon->QueryProp(P_WEAPON_TYPE) != WT_BOW) 
  {
    tell_object(caster, BS("Du musst schon einen Bogen in der Hand halten!"));
    return 0;
  }
  return 1;
}

//-- Nur mit gezuecktem Dolch/Messer -----------------------------------------
int KnifeTest(object caster, mapping sinfo)
{
  object weapon;
  weapon=caster->QueryProp(P_WEAPON);
  if(!weapon || weapon->QueryProp(P_WEAPON_TYPE) != WT_KNIFE) 
  {
    tell_object(caster, BS("Du musst schon ein Messer oder ein Dolch in der "
    "Hand halten!"));
    return 0;
  }
  return 1;
}

//-- Geht nicht als Blinder --------------------------------------------------
int BlindTest(object caster, mapping sinfo)
{
  if (caster->QueryProp(P_BLIND))
  {
    tell_object(caster, BS("Da Du blind bist, kannst Du das nicht machen!"));
    return 0;
  }
  return 1;
}
//**************************************************************************//



//**Spelleigene SPELL_FATIGUES *********************************************//
//-- Setzten der Zeit --------------------------------------------------------
int SetSpellTime(string spellname, string castername)
{
  string backupfile, *lines, *pos, new_file;
  int i;  
  
  if(backupfile=read_file(LOG+spellname+".log"))
  {
    new_file="";
    lines=explode(backupfile, "\n");
    for(i=0; i<=sizeof(lines)-1; i++)
    {
      pos=explode(lines[i], "**");
      if(to_string(pos[0])==lower_case(to_string(castername)))
      { continue; }
      new_file+=to_string(lines[i])+"\n"; 
    }
    new_file+=castername+"**"+to_string(time())+"\n";
    write_bytes(LOG+spellname+".log", 0, new_file);
    return 1;
  }
  return 0;  
}

//-- Zeit schon abgelaufen? (File sollte vorher angelegt sein) ---------------
int QuerySpellTime(string spellname, string castername)
{
  string backupfile, *lines, *pos;
  int i, t;  
  
  t=0;
  if(backupfile=read_file(LOG+spellname+".log"))
  {
    lines=explode(backupfile, "\n");
    for(i=0; i<=sizeof(lines)-1; i++)
    {
      pos=explode(lines[i], "**");
      if(to_string(pos[0])==lower_case(to_string(castername)))
      { t=to_int(pos[1]); }
    }
  }
  return t;  
}
//**************************************************************************//