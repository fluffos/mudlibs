mapping prep_tiere(object caster, mapping sinfo, int silent) 
{
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo) || 
     !AnimalTest(caster,sinfo)  ||
     !BlindTest(caster,sinfo)     )
    return 0;
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}


int tiere(object caster, mapping sinfo)
{
  object ob;
  int success,ability;
  string rasse;
  
  if(!mappingp(sinfo=prep_tiere(caster, sinfo, 1))) return 0;
  
  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Du hast nicht das Waldtier erreicht, was Du "
                        "gesucht hast."));
    ob=clone_object(WALDSCHRAT_NPC);
    ob->move(ENV(caster), M_GO);
    ob->Kill(caster);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC("Du hast kein Waldtier erreichen koennen."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY];

  if(!ob=clone_object(NPC"animal")) {return 0;}
  switch(random(6)+1)
  {
    case 1:  rasse="falke";         break;
    case 2:  rasse="eichhoernchen"; break;
    case 3:  rasse="fuchs";         break;
    case 4:  rasse="wiesel";        break;
    case 5:  rasse="fledermaus";    break;
    default: rasse="hase";          break;
  }
  ob->customize(caster, rasse);
  ob->move(ENV(caster), M_GO);
  PETMASTER->SetPet(caster, ob);
  return ERFOLG;
}