mapping prep_tierheilung(object caster, mapping sinfo, int silent)
{
  object ob;

  //Aenderungen der Werte im sinfo Mapping vermeiden! 
  if(!GuildItemTest(caster, sinfo)) return 0;
  if(!IsNotInFight(caster, sinfo) ) return 0;
  if(!TestNoTrance(caster, sinfo)) return 0;

  ob = FindVictim(sinfo[SI_SKILLARG], caster, "Welches Tier moechtest Du heilen?\n");
  if(!ob) return 0; 

  if(!PETMASTER->PetCategory(ob)) {
    write(BS("Das ist kein dir bekanntes Tier."));
    return 0;
  }

  if(ob->QueryProp(P_HP) >= ob->QueryProp(P_MAX_HP)) {
    write(BS(ob->Name(WER)+" braucht keine Heilung."));
    return 0;
  }

  sinfo[SI_ENEMY]=ob;
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_object(caster, BS("Du legst "+ob->name(WEM)+" die Hand auf den Kopf und murmelst leise Worte."));
    tell_room(ENV(caster), BS(caster->Name(WER)+" legt eine Hand auf den Kopf von "+ob->name(WEM)+" und murmelt leise Worte."), ({caster}));
  }
  return sinfo;
}

int tierheilung(object caster, mapping sinfo)
{
  object ob;
  int success, hp;
  string successRate;
  
  if(!mappingp(sinfo=prep_tierheilung(caster, sinfo, 1))) return 0;
  ob=sinfo[SI_ENEMY];  

  success=SpellSuccess(caster,sinfo);
  if(success<0) {
    if(success < -3000) {
      tell_room(ENV(ob), BS("Ohje! "+ob->Name(WER)+" sieht jetzt sogar noch schlechter aus als vorher!"));
      ob->AddHp(success/100);
    } else {
      tell_object(caster, BSC("Nichts passiert."));
    }
    return MISSERFOLG;
  }
  
  if(!PETMASTER->PetCategory(ob)) {
    write(BS("Das ist kein dir bekanntes Tier."));
    return 0;
  }
  
  hp = sinfo[SI_SKILLABILITY] / 1000 + success / 500 + caster->QueryProp(P_GUILD_LEVEL) / 2;
  hp += hp * get_equip_bonus(caster, "tiere besprechen") / 100;

  if(!random(3)) {
    tell_object(caster, BS("Du uebernimmst einen Teil der Verletzungen des Tieres."));
    caster->AddHp(-random(hp/2));
  }


  caster->AddExp(hp * 10);

  if(ob->QueryProp(P_RANGER_PET_OWNER) == getuid(caster)) hp *= 2;
  ob->AddHp(hp);
  ob->AddSp(hp);

  switch(hp) {
    case 0: successRate = "gar nicht"; break;
    case 1 .. 5: successRate = "kaum"; break;
    case 6 .. 10: successRate = "ein wenig"; break;
    case 11 .. 20: successRate = "etwas"; break;
    case 21 .. 30: successRate = "schon"; break;
    case 31 .. 40: successRate = "um einiges"; break;
    case 41 .. 50: successRate = "viel"; break;
    case 51 .. 60: successRate = "sehr viel"; break;
    case 61 .. 70: successRate = "unglaublich viel"; break;
    case 71 .. 80: successRate =  "um ein gewaltiges Stueck"; break;
    default: successRate = "um ein gigantisches Stueck"; break;
  }

  tell_room(ENV(ob), BS(sprintf("%s sieht %s besser aus.", ob->Name(WER, 1), successRate)));

  if(ob->QueryProp(P_POISON)) {
    write(BS(sprintf("Du hast die Vergiftung von %s gelindert.", ob->name(WEM))));
    ob->AddPoison(-(success/1000));
  }

  if(ob->QueryProp(P_FROG) && success > 5000) {
    write(BS(sprintf("%s ist jetzt kein Frosch mehr.", ob->Name(WER))));
    ob->SetProp(P_FROG, 0);
  }
  
  return ERFOLG;
}
