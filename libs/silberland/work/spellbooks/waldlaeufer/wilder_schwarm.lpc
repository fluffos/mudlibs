mapping prep_wilder_schwarm(object caster, mapping sinfo, int silent) 
{
  string s, *str;

  if(!TestNoTrance(caster, sinfo)) return 0;
  
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo) || 
     !AnimalTest(caster,sinfo)  ||
     !BlindTest(caster,sinfo)     )
    return 0;

  if(!ENV(caster)->QueryProp(P_ENVIRONMENT)) {
    write(BS("Du kannst hier keinen Schwarm herbeeirufen."));
    return 0;
  }

  if(!member(ENV(caster)->QueryProp(P_ENVIRONMENT), ENV_TERRAIN) || !ENV(caster)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]) {
    write(BS("Du kannst hier keinen Schwarm herbeirufen."));
    return 0;
  }

  if(objectp(present(SUMMON_SWARM_ID+"_"+getuid(caster), ENV(caster)))) {
    tell_object(caster, BS("Dieses Tier begleitet dich bereits."));
    return 0;
  }
      
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" schliesst die Augen und konzentriert sich."), ({caster}));
  }

  return sinfo;
}


int wilder_schwarm(object caster, mapping sinfo)
{
  object ob;
  int success, ability;

  if(!mappingp(sinfo=prep_wilder_schwarm(caster, sinfo, 1))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Du hast nicht das Lebewesen erreicht, was Du "
                        "gesucht hast."));
    ob=clone_object(WALDSCHRAT_NPC);
    ob->move(ENV(caster), M_GO);
    ob->Kill(caster);
    return MISSERFOLG;
  }

  if(success<0)
  {
    tell_object(caster, BSC("Du hast keinen Schwarm erreichen koennen."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY];
    
  ob=clone_object(NPC"summon_swarm");
  
  ob-> Setup(caster, ability, success, ENV(caster)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]);
  caster->Message(BSC("Du reisst deine Augen auf und spuehrst das Nahen eines wilden Schwarms."));
  tell_room(ENV(caster), BS(caster->Name(WER)+" reisst ploetzlich die Augen auf."));
  ob->move(ENV(caster), M_GO);

  return ERFOLG;
}