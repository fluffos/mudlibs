mapping prep_salve(object caster, mapping sinfo, int silent)
{  
  object *obs, ob;
  int i;
  string *str;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!TestNoTrance(caster, sinfo)) return 0;
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo) || 
     !BowTest(caster,sinfo)     ||
     !BlindTest(caster,sinfo)     )
    return 0;
  
  if(!pointerp(obs=sinfo[SI_ENEMY]))
  { i=-1;
    if(ENV(caster))
    { str=explode(file_name(ENV(caster)), "/");
      if( (str[0]=="d") && (str[1]=="pk") ) {i=0;} }
    obs=FindGroupN(caster,i,5);
    if(!pointerp(obs) || (sizeof(obs) < 1)) 
    { tell_object(caster, BS("Hier ist kein Feind.") );
      return 0;} }
  sinfo[SI_ENEMY]=obs;

  if(!silent)
  { if(caster->InFight())
    {tell_object(caster, BS("Du laeufst schnell einige Meter vom "
                 "Kampfgetuemmel weg und legst mehrere Pfeile ein."));}
    else
    {tell_object(caster, BS("Du legst einige Pfeile ein und zielst."));}
  }
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int salve(object caster, mapping sinfo) 
{
  object *obs, weapon, *people, ob;
  int dam, success, ability, i, shots;
  mixed dts;

  if(!mappingp(sinfo=prep_salve(caster, sinfo, 1))) return 0;
  obs=sinfo[SI_ENEMY];
  
  success=SpellSuccess(caster,sinfo);
  if(success<500)
  {
    tell_object(caster, BSC("Du bist zu ungeschickt und laesst die Pfeile "
                        "fallen."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY];
  dam=sinfo[SI_SKILLDAMAGE]; dts=sinfo[SI_SKILLDAMAGE_TYPE];
  dam+=ability/100; dam+=success/200;
  tell_object(caster, BS("Du hast genuegend Abstand gewonnen, drehst Dich "
                      "geschwind um und laesst die Pfeile von der Sehne "
                      "schnellen. Ein Pfeilhagel schlaegt in die Reihen "
                      "Deiner Gegner ein.")),
  tell_room(ENV(caster),BS(caster->Name(WER, 1)+" entfernt sich auf einmal "
                        "vom Kampfgeschehen um Abstand zu gewinnen, "
                        "ploetzlich macht "+caster->QueryPronoun(0)+" kehrt "
                        "und laesst einen Pfeilhagel auf die Gegner los. "
                        "AUSWEICHEN!"), ({caster}));
                        
  //Spieler versuchen auszuweichen, da es unwahrscheinlich ist, dass die 
  //Pfeile nur die richtigen treffen
  people=all_inventory(ENV(caster));
  for(i=0;i<=sizeof(people)-1; i++)
  {
    if( member(obs, people[i]) != -1) continue;
    if( people[i] == caster) continue;
    people[i]->SetProp(P_TMP_ATTACK_HOOK, ({ time()+2,TO,"aim"}) );
    if(people[i]->QueryProp(P_BLIND))
    { tell_object(people[i], BS("Du kannst nichts sehen und so gelingt es "
                             "Dir leider nicht allen Pfeilen auszuweichen."));
      people[i]->AddHp(-20-random(20)); }
    else
    { tell_object(people[i],BS("Du versuchst so gut es geht den Pfeilen "
                               "auszuweichen. Du rollst Dich ab und stehst "
                               "wieder. Einige Pfeile haben Dich verfehlt."));
    }
  }                    
                         
  weapon=caster->QueryProp(P_WEAPON); dts=weapon->QueryProp(P_DAM_TYPE);
  if(dts) {sinfo[SI_SKILLDAMAGE_TYPE]=dts;}
  dam=(dam*3)/4; sinfo[SI_SKILLDAMAGE]=dam;
  shots = 2 + random(ability/2500); // 1-6 Schuesse je nach Fähigkeit)

  for(i=0; i<=shots; i++) { 
    // pay SP for each shot
    if(caster->QueryProp(P_SP) < 5) {
      tell_object(caster, BS("Dir fehlt die Kraft, um noch mehr Pfeile "
                          "abzuschiessen."));
      break;
    }
    if(objectp(ob = obs[random(sizeof(obs))])) ExecuteAttackSpell(ob, caster, sinfo, ([SP_SHOW_DAMAGE:1]), ATTACK_SPELL_BOW); 
    else tell_room(ENV(caster), BS("Ein Pfeil verfehlt sein Ziel."));
    caster->AddSp(-5);
  }
                                
  return ERFOLG;
}