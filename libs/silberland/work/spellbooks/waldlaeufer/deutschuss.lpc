mapping prep_deutschuss(object caster, mapping sinfo, int silent)
{  
  object ob;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo) || 
     !BowTest(caster,sinfo)     ||
     !BlindTest(caster,sinfo)     )
    return 0;
    
  if(!objectp(ob=sinfo[SI_ENEMY])) {
     ob = FindEnemyVictim(sinfo[SI_SKILLARG], caster, 
                     "Wen moechtest Du mit dem Deutschuss treffen?\n");
     if(!ob) return 0;
  }
  sinfo[SI_ENEMY]=ob;
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}

  aim(caster, sinfo);
  return sinfo;
}

int deutschuss(object caster, mapping sinfo) 
{
  object ob;
  int dam, abil, i, success;
  string *dtypes;

  if(!mappingp(sinfo=prep_deutschuss(caster, sinfo, 1))) return 0;
  ob=sinfo[SI_ENEMY];
  
  success=SpellSuccess(caster,sinfo);
  if(success<0)
  {
    tell_object(caster,BSC("Du zwinkerst kurz und verziehst so den Schuss."));
    return MISSERFOLG;
  }
  
  
  dam=sinfo[SI_SKILLDAMAGE];
  if(abil=caster->QuerySkillAbility(FIGHT(WT_BOW)))
  { dam+=abil/100; }
  sinfo[OFFSET(SI_SKILLDAMAGE)] = sinfo[OFFSET(SI_SKILLDAMAGE)] + sinfo[SI_SKILLABILITY]/100;
  
  //Skillpoint
  if(R_SKILLMASTER->HasSkill(getuid(caster), ERSTE_STICHE)) { 
    dam+=random(caster->QueryProp(P_GUILD_LEVEL)*10); 
  }
  
  sinfo[SI_SKILLDAMAGE]=dam;
  dtypes=(caster->QueryProp(P_WEAPON))->QueryProp(P_DAM_TYPE);
  if(dtypes) {sinfo[SI_SKILLDAMAGE_TYPE]=dtypes;}
  tell_object(caster, BS("Du visierst kurz "+ob->name(WEN, 1)+" an und "
                         "schiesst."));  
  tell_room(ENV(caster), BS(caster->Name()+" zielt kurz "
                         "auf "+ob->name(WEN, 1)+"."), ({caster}));
  ExecuteAttackSpell(ob, caster, sinfo, ([SP_SHOW_DAMAGE:1]), ATTACK_SPELL_BOW);
  reload(caster, sinfo);
  return ERFOLG;
}

