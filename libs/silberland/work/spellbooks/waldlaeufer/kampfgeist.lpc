mapping prep_kampfgeist(object caster, mapping sinfo, int silent)
{  
  object pet;

  if(!GuildItemTest(caster, sinfo)) return 0;
  if(!TestNoTrance(caster, sinfo)) return 0;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!IsInFight(caster, sinfo) )
    return 0;
  if(!(pet=FindPet(caster)))
  { tell_object(caster, BS("Dein Tier ist nicht bei Dir."));
    return 0;}
  if(pet->QueryTeam())
  { tell_object(caster, BS("Der Kampfgeist wirkt noch.")); 
    return 0;}
  if(!(pet->QueryFight()))
  { tell_object(caster, BS(pet->Name(WER, 1)+" kaempft aber nicht mit Dir "
                        "zusammen.")); return 0;}

  if(pet->QueryProp(P_RANGER_NEXT_ANIMAL_ATACK) > time()) {
    tell_object(caster, BS("Dein Kampfgefaehrte ist noch nicht bereit!"));
    return 0;
  }

  sinfo[SI_ENEMY]=pet;
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int kampfgeist(object caster, mapping sinfo)
{
  int success, ability;
  object pet;
  
  if(!mappingp(sinfo=prep_kampfgeist(caster, sinfo, 1))) return 0;
  pet=sinfo[SI_ENEMY];
  
  success=SpellSuccess(caster,sinfo);
  if(success < (-5000))
  {
    tell_object(caster, BSC("Du gibst "+pet->name(WEM, 1)+" das falsche "
                        "Zeichen."));
    tell_room(ENV(caster), BS( pet->Name(WER, 1)+" verschwindet."));
    pet->remove(0);
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC(pet->Name(WER, 1)+" versteht nicht."));
    return MISSERFOLG;
  }
  
  ability=sinfo[SI_SKILLABILITY];
  pet->SetTeam(ability/1000, ability, success);
  pet->SetProp(P_RANGER_NEXT_ANIMAL_ATACK, time() + 4);

  tell_object(caster, BS(pet->Name(WER)+" stellt sich schuetzend vor dich."));
  tell_room(ENV(caster), BS(pet->Name(WER)+" stellt sich schuetzend vor "+caster->name(WEN)+"."), ({caster}));
  return ERFOLG;
}