mapping prep_messerstich(object caster, mapping sinfo, int silent)
{  
  object ob;
  
  //Aenderungen der Werte im sinfo Mapping vermeiden!
  if(!GuildItemTest(caster, sinfo) || !FroschTest(caster, sinfo) || 
     !KnifeTest(caster,sinfo)   ||
     !BlindTest(caster,sinfo)     )
    return 0;
    
  if(!objectp(ob=sinfo[SI_ENEMY]))
  {
    ob = FindEnemyVictim(sinfo[SI_SKILLARG], caster,
                         "Wen willst Du erstechen?\n");
     if(!ob) return 0;
  }
  sinfo[SI_ENEMY]=ob;
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int messerstich(object caster, mapping sinfo) 
{
  object ob;
  int dam, abil, i, success;
  string *dtypes;

  if(!mappingp(sinfo=prep_messerstich(caster, sinfo, 1))) return 0;
  ob=sinfo[SI_ENEMY];
  
  success=SpellSuccess(caster,sinfo);
  if(success<0)
  {
    tell_object(caster, BSC("Du hiebst daneben."));
    return MISSERFOLG;
  }
  
  
  dam=0;
  if(abil=caster->QuerySkillAbility(FIGHT(WT_KNIFE)))
  { dam+=abil/100; }
  dam+=sinfo[SI_SKILLABILITY]/200;
  
  //Skillpoint
  if(R_SKILLMASTER->HasSkill(getuid(caster), ERSTE_STICHE)) { 
    dam+=random(caster->QueryProp(P_GUILD_LEVEL) * 7); 
  }
  
  sinfo[SI_SKILLDAMAGE]=dam;
  dtypes=(caster->QueryProp(P_WEAPON))->QueryProp(P_DAM_TYPE);
  if(dtypes) {sinfo[SI_SKILLDAMAGE_TYPE]=dtypes;}
  tell_object(caster, BS("Du springst "+ob->name(WEN, 1)+" an und "
                         "stichst zu."));  
  tell_room(ENV(caster), BS(caster->Name()+" laeuft auf "+ob->name(WEN, 1)+
                         " zu, springt ab und stoesst zu."), ({caster}));
  ExecuteAttackSpell(ob, caster, sinfo, ([SP_NAME:"Messerstich",SP_SHOW_DAMAGE:1]), ATTACK_SPELL_KNIFE);
  return ERFOLG;
}

