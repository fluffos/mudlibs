mapping prep_stolperdraht(object caster, mapping sinfo, int silent) 
{  
  object ob, trap;
  
  if(!FroschTest(caster, sinfo)  || 
     !BlindTest(caster, sinfo)   ||
     !IsNotInFight(caster, sinfo) )
    return 0;
    
  if(!objectp(ob=present(TRAP_BELT_ID, caster)))
  { tell_object(caster,BS("Du kannst ohne Deinen Fallenguertel keine Fallen "
                       "bauen."));
    return 0; }
  if(!ob->can_build(2))
  { tell_object(caster,BS("Du hast nicht genug Draehte fuer Diese Falle."));
    return 0; }

  if(!ENV(caster)) return 0;
  if(objectp(trap=present(STOLPERDRAHT_ID, ENV(caster))))
  {ob=trap->QueryOwner();}
  if(ob==caster) 
  { tell_object(caster,BS("Du kannst hier nur eine solche Falle errichten."));
    return 0;}
  if(!silent){FirstPrepareFuncSuccessfull(caster, sinfo);}
  return sinfo;
}

int stolperdraht(object caster, mapping sinfo)
{
  object trap, ob;
  int success, ability;
  
  if(!mappingp(sinfo=prep_stolperdraht(caster, sinfo, 1))) return 0;
  ability=sinfo[SI_SKILLABILITY];

  success=SpellSuccess(caster,sinfo);
  if(success < (-5000+random(2000)))
  {
    tell_object(caster, BSC("Deine Fuesse verfangen sich im Draht, Du "
                        "verlierst das Gleichgewicht."));
    tell_room( ENV(caster), 
               BS(caster->Name(WER, 1)+" geht zu Boden.") ,
               ({caster}) );
    caster->SetProp(P_LAST_RAMMEN_TIME, time());
    caster->SetProp(P_DISABLE_ATTACK, 1);
    caster->AddHp(-(10+random(10)));
    if( objectp(ob=present(TRAP_BELT_ID, caster)) )
    { ob->dec_ladungen(2); }
    return MISSERFOLG;
  }
  if(success<0)
  {
    tell_object(caster, BSC("Dir gelingt es nicht den Draht zu spannen."));
    if( objectp(ob=present(TRAP_BELT_ID, caster)) )
    { ob->dec_ladungen(2); }
    return MISSERFOLG;
  }

  trap=clone_object(OBJ"trap");  
  trap->move(ENV(caster), M_SILENT|M_NOCHECK);
  trap->Stolperdraht(caster, ability);
  tell_object(caster, BS("Du ziehst einige Stolperdraehte und tarnst sie, so "
                      "gut es geht."));
  tell_room(ENV(caster),BS(caster->Name(WER, 1)+" zieht Stolperdraehte im "
                        "ganzen Areal."),({caster}) );
                        
  if( objectp(ob=present(TRAP_BELT_ID, caster)) ) { ob->dec_ladungen(2); }
  return ERFOLG;
}