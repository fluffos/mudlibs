mapping prep_melodie_der_veraenderung(object caster, mapping sinfo, int silent)
{  
  object ob;

  if(!GuildItemTest(caster, sinfo) ||
     !FroschTest(caster, sinfo)  || 
     !IsNotInFight(caster, sinfo) )
    return 0;

    if(!present(IAMA_ID, caster))
    { tell_object(caster, BS("Ohne Deine Iama geht das nicht!")); 
      return 0; }
    
  if(present(MELODY_OF_CHANGE_ID, caster)) {
    tell_object(caster, BS("Die Kraefte der Veraenderung wirken bereits in dir."));
    return 0;
  }

  
  if(!silent){
    FirstPrepareFuncSuccessfull(caster, sinfo);
    tell_room(ENV(caster), BS(caster->Name(WER)+" spielt eine verwirrende rasche Melodie, die improvisiert wirkt."), ({caster}));
  }
  return sinfo;
}

int melodie_der_veraenderung(object caster, mapping sinfo)
{
  object ob;
  int ability, success, i;
 
  if(!mappingp(sinfo=prep_melodie_der_veraenderung(caster, sinfo, 1))) return 0;

  success=SpellSuccess(caster,sinfo);
  if(success < 0)
  {
    tell_object(caster, BS("Die Melodie wird unklarer und unklarer. Du verlierst den Faden und die Melodie klingt schief."));
    return MISSERFOLG;
  }

  ability=sinfo[SI_SKILLABILITY];
 
  if(!objectp(ob=clone_object(OBJ "melody_change"))) {
    tell_object(caster,BS("Ein Fehler ist aufgetreten(melody_change/cl)."));
    return 0;
  }
  ob->move(caster, M_NOCHECK);

  ob->Setup(caster, ability, success);
  
  tell_object(caster, BS("Du spielst die Melodie und spuerst wie sich die Kraefte der Veraenderung in dir sammeln."));
  tell_room(ENV(caster), BS(caster->Name(WER)+" spielt eine Melodie und es wirkt als ob sich die Luft um "+caster->QueryPronoun(WEN, WEM)+" herum zu verformen beginnt!"), ({caster}));
  call_out("iama_voice_of_nature", 0, caster);
  present(IAMA_ID, caster)->SongPlayed();
  return ERFOLG;
}