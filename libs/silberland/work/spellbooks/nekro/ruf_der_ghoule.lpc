/*
 * Ruf der Ghoule
 * 
 * Ruft Ghoule herbei, die die Leiche im Raum auffressen. Zum Dank fuer das
 * Mahl lassen die Ghoule dem caster ein paar schmackhafte Teil ueber, die
 * diverse Heilwirkungen haben, aber nach gewisser Zeit verfaulen.
 * Bei gutem Erfolg belibt ein Ghoul im Raum, der dann beherrscht werden kann.
 * 
 * Kosten: 40 MP
 * Level : 4
 * Objekt: /gilden/nekromanten/npc/ghoul
 *
 * Spruch kann nicht durch Skillpunkte verbessert werden!
 * spruch kann durch Ausruestung verbessert werden.
 *
 * Status: Anschlussfertig
 *
 * 30.12.2003 Feyaria: Abfrage ob schon ein Ghoul da ist.
 *                     P_NEKRO_GHOUL_TIME eingefuerht   
 *
 */

mixed prep_ruf_der_ghoule(object caster, mapping sinfo)
{
  if(!present("leiche", ENV(caster)))
  {
    write("Hier ist keine Leiche, um einen Ghoul anzulocken!\n");
    return 0;
  }
  if(present("ghoul", ENV(caster)))
  {
    write("Hier ist ja schon ein Ghoul!\n");
    return 0;
  }
  if( caster->QueryProp(P_NEKRO_GHOUL_TIME) + 30 > time()  )
  {
    write("Du hast ja gerade eben erst einen Ghoul gerufen!\n");
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  tell_room(ENV(caster), sprintf("%s hebt %s Arme in einer unheilvollen "
        "Geste gen Himmel!\n", caster->Name(WER), caster->QueryPossPronoun(WEM)
        ), ({caster}));
  return sinfo;
}

int ruf_der_ghoule(object caster, mapping sinfo) 
{
  object corpse, undead;
  int succ;
 
  if (!present("leiche",ENV(caster)))
  {
    write(BS("BEI ALLEN NIEDERHOELLEN! Wohin ist denn die Leiche "
          "verschwunden??"));
    return 0;
  }

  if( caster->InFight() ) 
  {
    write(BS("VERNICHTE ERST DEINE GEGNER! DANN HAST DU NOCH MEHR LEICHEN "
          "FUER DIE GHOULE!"));
    return 0;
  }
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    write(sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  write(BSC(
    "Mit Deinem Geist lenkst Du die Leichenduefte in die finstersten "
    "Gruefte und Krypten, wo die Ghouls hausen.")); 
  tell_room(ENV(caster), BS(sprintf("%s macht komische Bewegungen und "
    "ploetzlich breitet sich ein Gestank nach Leichen aus.",
    caster->Name(WER))), ({caster}));

  succ=SpellSuccess(caster,sinfo)+random(50*CheckEquip(caster, "ruf_der_ghoule"));

  if (succ <= 0) 
  {
     tell_room(ENV(caster),"Nichts passiert.\n");
     return MISSERFOLG;
  }
  write(BSC("Bald werden die Leichenfresser kommen und hier ein wahres "
        "Festmahl feiern!"));
  call_out("CloneGhoul", 6+random(7), caster, succ);
  caster->SetProp(P_NEKRO_GHOUL_TIME, time() );
  return ERFOLG;
}
