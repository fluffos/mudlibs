/*
 * Auge des Khaza Dunnar
 *
 * Ermoeglicht dem Nekromant einen Gegenstand einzuschaetzen, einen 
 * Gengner zu identifizieren oder den Raum zu beobachten. Das Beobachten 
 * eines Raumes zeigt dem Caster ua. an, wenn ein Living den Raum betritt.
 * Der Caster kann nicht mehr als ein Auge zur gleichen Zeit haben.
 *
 * Kosten: 20 MP
 * Level : 1 
 * Objekte: /gilden/nekromanten/npc/auge
 *
 * Spruch kann durch Skillpunkte verbessert werden!
 *
 * Verbesserungen: 1 SP: beobachte und umgebung anzeigen lassen
 *
 * Status: anschlussreif
 *
 */
// 23.06.2003 Archon: umstellung sinfo uebergabe
// 08.08.2003 Archon: skillpunkte

mixed prep_schaetzident(object caster, mapping sinfo)
{
  object ob;
  if(ob=present(NEKRO_EYE_NPC)) 
  {
    ob->command_me(sprintf("sag Ich bin schon hier, dunkle%s Meister%s!",
          caster->QueryProp(P_GENDER)==FEMALE?"":"r",
          caster->QueryProp(P_GENDER)==FEMALE?"in":""));
    return 0;
  }
  if(find_living(getuid(caster)+"auge")) 
  {
     write("NARR! DU HAST SCHON EIN AUGE BESCHWOREN! NUTZE ES!\n");
     return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  tell_room(ENV(caster), BS(sprintf("%s hebt die Arme und intoniert "
          "fremdartige Worte!", caster->Name())), ({caster}));
  write(BS("Du hebst Deine Arme und rufst: Tur Yag'oth Zztta Khaza-Doom!"));
  return sinfo;
}

int schaetzident(object caster, mapping sinfo) 
{
  object npc;
  int suc,gender,skp;
  string vn;

  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  tell_room(ENV(caster), "Ploetzlich oeffnet sich ein Spalt im Gefuege "
      "der Welt!\n", ({caster}));
  write(BS("Ein Spalt zu den Niederhoellen oeffnet sich!"));

  suc=SpellSuccess(caster,sinfo);
  if (suc <= -1000) 
  {
    npc=clone_object( NEKRO_ISLAND_NPC "demon");
    npc->move(ENV(caster), M_GO);
    npc->command_me("sag FREI! FREI! Haha! Ihr Narren!");
    npc->Kill(caster);
    return MISSERFOLG;
  }
  if(suc < 0) 
  {
    tell_room(ENV(caster), "Der Spalt schliesst sich wieder.\n");
    return MISSERFOLG;
  }
  UseBlood();
  skp=get_skillpoints(caster,"auge des khaza-dhunaar");
  npc=clone_object(NPC "auge");
  npc->Setup(caster, suc, skp);
  npc->move(ENV(caster),M_GO|M_NO_ATTACK);
  gender=caster->QueryProp(P_GENDER); 
  if(npc)
    npc->command_me(sprintf("sag Dunkle%s Meister%s, Gebieter%s, welchen Dienst "
        "kann ich erfuellen?", gender==FEMALE?"":"r",
        gender==FEMALE?"in":"", gender==FEMALE?"in":""));
  return ERFOLG;  
}
