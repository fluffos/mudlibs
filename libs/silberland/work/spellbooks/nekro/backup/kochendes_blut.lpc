int prep_kochendes_blut(object caster, mapping sinfo) 
{
  int dam,suc,nr,i;
  object victim,ob, corpse;

  victim=FindLivingVictim(sinfo[SI_SKILLARG],caster,
                         "Wessen Blut willst Du zum Kochen bringen?\n");
  if (!victim)
    return 0;
  if(!is_living(victim)) {
    write(BS(sprintf("%s Nur einem Wesen auf Fleisch und Blut kannst Du "
            "mit dieser unheiligen Anrufung schaden!", random_fluch())));
    return 0;
  }
  if(present(NEKRO_BLOODBOIL, victim)) {
    write(BS(sprintf("Das Blut von %s kocht schon! Bring %s endlich um!",
            victim->name(WEM), victim->QueryPronoun(WEN))));
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  return 1;
}

int kochendes_blut(object caster, mapping sinfo) 
{
  int suc;
  object victim,ob;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wessen Blut willst Du zum Kochen bringen?\n");
  if (!victim)
    return 0;
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  if ((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;

  tell_room(ENV(caster), BS(sprintf("Mit einem Ruck deutet %s auf %s! "
          "%s schreit ploetzlich in Agonie!", caster->name(WER),
          victim->name(WEN), victim->Name(WER))), ({caster,victim}));
  write(BS(sprintf("Mit einem Ruck deutest Du auf %s! %s Bald wird %s "
          "gar sein! Harhar!", victim->name(WEN), random_fluch(), 
          victim->QueryPronoun(WER))));
  tell_object(victim,BS(sprintf("%s deutet mit einem Ruck auf Dich! "
        "Ploetzlich spuerst Du wie Dein Blut zu kochen beginnt! "
        "Du schreist vor Schmerz!!!", caster->Name(WER))));
  ob=clone_object(OBJ "bloodboil");
  ob->move(victim, M_NOCHECK);
  ob->Setup(victim,caster,suc);
  return ERFOLG;
}

