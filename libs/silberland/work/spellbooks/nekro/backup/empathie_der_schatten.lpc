int prep_schattenempathie(object caster, mapping sinfo)
{
  string vn;
  if(!sinfo[SI_SKILLARG] || sscanf(sinfo[SI_SKILLARG], "auf %s", vn)!=1)
  {
    write("Wem willst Du Deine Lebensenergie zur Verfuegung stellen?\n");
    return 0;
  } 
  if (!present(vn, ENV(caster) ))
  {
    write("So etwas siehst Du da nicht!\n");
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  tell_room(ENV(caster), BS(sprintf("%s scheint in Gedanken versunken zu "
          "sein und grinst dabei haemisch.", caster->Name())),({caster}));
  return 1;
}

int schattenempathie(object caster, mapping sinfo) 
{
  object victim;
  int suc;
  string vn;
 
  if(!sinfo[SI_SKILLARG] || sscanf(sinfo[SI_SKILLARG], "auf %s", vn)!=1)
  {
    write("Wem moechtest Du Deine Lebensenergie uebertragen?\n");
    return 0;
  }
  if(!victim=present(vn, ENV(caster))) {
    write("So etwas siehst Du da nicht!\n");
    return 0;
  }

  sinfo=DoSpellModification(caster, sinfo);

  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  write(BS(sprintf(
    "Du konzentrierst Dich auf Deine Essenz und laesst Deine unheilige "
    "Lebensenergie zu %s stroemen!", victim->name(WEM))));

  say(BS(sprintf("%s verzieht %s Gesicht zu einer Grimasse.", 
          caster->Name(WER), caster->QueryPossPronoun(WEM))));

  suc=SpellSuccess(caster,sinfo);
  if (suc <= 0)
     return MISSERFOLG;
  write(BS(sprintf("Ein Schatten loest sich von Deinem Koerper, und mit ihm "
        "verschwindet ein Teil deiner Lebensessenz. Der Schatten schwebt "
        "auf %s zu und vereinigt sich mit %s. %s sieht gestaerkt aus.",
        victim->name(WEN), victim->QueryPronoun(WEM), 
        CAP(victim->QueryPronoun(WER)))));

  tell_object(victim, BS(sprintf("Aus dem Koerper von %s loest sich ein "
          "Schatten und schwebt auf Dich zu. Du kannst noch erkennen "
          "das %s geschwaecht wirkt, da dringt der Schatten schon in Dich "
          "ein!", caster->name(WER), caster->name(WER))));
  tell_room(ENV(caster), BS(sprintf("Aus dem Koerper von %s loest sich ein "
          "Schatten und schwebt auf %s zu. Der Schatten verschmilzt mit "
          "%s und %s sieht ploetzlich gesuender aus!",caster->name(WER),
          victim->name(WER), victim->QueryPronoun(WEM), 
          victim->QueryPronoun(WER))), ({caster, victim}));
  caster->do_damage(30+random(30));
  victim->AddHp(DoModificationByAlign(30+random(10), caster, victim));
  victim->SetProp(P_ALIGN, victim->QueryProp(P_ALIGN)-50);
  if(victim->QueryProp(P_GUILD)=="paladin") {
    tell_object(victim, BS("PALADIN! DEINE GOETTIN WIRD DIR ZUERNEN! DU HAST "
          "DEN MAKEL DES BOESEN AUF DIR!"));
    if(!random(3))
      victim->AddPoison(1);
  }
  return ERFOLG;
}
