
int prep_geisterruf(object caster, mapping sinfo)
{
  object corpse;

  if(!sinfo[SI_SKILLARG] ||
     !corpse=present(sinfo[SI_SKILLARG], environment(caster)) ||
     !corpse->id("Leiche") )
  {
    write("Ohne eine Leiche kannst Du keine Pforte ins Totenreich oeffnen!\n");
    return 0;
  }
  if( caster->InFight() ) {
    write(BS("Im Kampf bist Du zu beschaeftigt, um einen Pforte ins "
          "Totenreich zu oeffnen."));
    return 0;
  }
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }                                  

  return 1;
}
  
int geisterruf(object caster, mapping sinfo)
{
  int succ;
  object corpse;

  if (!prep_geisterruf(caster, sinfo))
    return 0;
  sinfo=DoSpellModification(caster, sinfo);

  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  if ((succ=SpellSuccess(caster,sinfo)) <= -random(2500))
  {
     write(BS(
       random_fluch()+" Das Oeffnen der Pforte ist Dir total misslungen! "
       "Der Geist faehrt in seinen alten Koerper und wendet sich gegen Dich!"));
     say(BS(sprintf(
       "Ploetzlich wird die Leiche lebendig und greift %s an!",
       caster->name(WEN) )), ({caster}) );
     CloneZombie(corpse, caster, -succ+random(5000))->Kill(caster);
     total_fail=1;
  }
  if (succ <= 0) return MISSERFOLG;

  write(BS("Du oeffnest eine Pforte ins Totenreich. Aus den unendlichen Tiefen "
      "des Geisterreiches holst Du die Seele dieser Leiche zurueck in die Welt. "
      "Voller Hass auf alles Leben wird sich der Geist jetzt an seinem Moerder "
      "raechen!"));
  say(BS(CAP_TPN+" oeffnet eine Pfote ins Totenreich und ein Geist kommt an, "
        "der sich jetzt an seinem Moerder raechen wird."));
  CloneGhost( corpse, caster, succ);
  
  return ERFOLG;
}
