
int prep_gekreische_der_todesfee(object caster, mapping sinfo)
{
  object *victims;

  victims=FindGroup(caster,-1);
  if( !victims || !sizeof(victims) ) {
    tell_object(caster, BS(
      "Hier ist ja niemand, den Du mit Deinem Todesgesang erschrecken "
      "koenntest!") );
    return 0;
  }

  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }                           

  return 1;
}

int gekreische_der_todesfee(object caster, mapping sinfo)
{
  object *victims;
  int succ, i, dam;

  victims=FindGroup(caster,-1);
  if( !victims || !sizeof(victims) ) {
    tell_object(caster, BS(
      "Hier ist ja gar niemand, den Du mit dem Gekreische der Todesfee "
      "angreifen koenntest!") );
    return 0;
  }
    
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster,sinfo[SI_SP_LOW_MSG]);
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  if ( (succ=SpellSuccess(caster,sinfo)) <=-random(3000)) {
    if( !caster->QueryProp(P_DEAF) ) {
       write("Du kreischt so schlecht, dass Du selber taub wirst.\n"+
           random_fluch()+"\n"); 
       total_fail=1;
       caster->SetProp(P_DEAF, 5*caster->QueryProp(P_GUILD_LEVEL)-succ/30);
    }
  }
  if( succ<=0)  
    return MISSERFOLG;

  say(BS(sprintf(
    "%s kreischt unirdische hohe Toene, eine Kakophonie die Dir ins Gebein "
    "faehrt und Dir das Blut in den Adern gefrieren laesst!",
     caster->Name(WER))), ({caster}) );
  write(BS("Du kreischt unirdisch hohe Toene, eine Kakophonie des Grauens!"));

  if( (dam=sinfo[SI_SKILLDAMAGE]-25*sizeof(victims)) < 150 )
    dam=150;

  for(i=sizeof(victims)-1; i>=0; i--)
  {
    if(victims[i]->QueryProp(P_DEAF))
    {
      tell_object(victims[i], 
        caster->Name(WESSEN)+" Gekreische kann Dir aufgrund Deiner Taubheit "
        "nichts anhaben.");
      say(BS(sprintf(
        "%s widersteht aufgrund %s Taubheit voellig %s Angriff.", 
        victims[i]->Name(WER), 
        victims[i]->QueryPossPronoun(FEMALE,WESSEN,SINGULAR), 
        caster->name(WESSEN))), ({victims[i], caster}));
      write(BS(sprintf(
        "%s widersteht aufgrund %s Taubheit voellig Deinem Angriff.", 
        victims[i]->Name(WER), 
        victims[i]->QueryPossPronoun(FEMALE,WESSEN,SINGULAR) )));
    }
    else
    {
      tell_object(victims[i], BS(
        caster->Name(WESSEN)+" Gekreische dringt tief in Dein Gehirn ein "
        "und laesst es fast zerspringen."));
      dam=sinfo[OFFSET(SI_SKILLDAMAGE)]+ 
        random(DoModificationByAlign(dam, caster, victims[i]));
      if (dam > sinfo[SI_MAX_DAMAGE] ) dam=sinfo[SI_MAX_DAMAGE];
      TryAttackSpell(victims[i], dam, sinfo[SI_SKILLDAMAGE_TYPE],
          ([SP_NAME:"Todesgesang",SP_SHOW_DAMAGE:1]), caster, sinfo);
    }
  }
  return ERFOLG;
}

