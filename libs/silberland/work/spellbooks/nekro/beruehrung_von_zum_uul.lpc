/*
 * Beruehrung von Zum-uul
 *
 * Ermoeglicht dem Nekromant seine Haende mit der Macht von Zum-Uuls
 * zu Umgeben - durch ein spaeteres Beruehren kann man einmalig
 * einen Schaden anrichten, dieser Schaden wird dem Caster direkt als
 * HP dazuaddiert. Der NPC kann dem Angriff durch seine Geschicklichkeit
 * ausweichen.
 * Schaden wird direkt durch AddHp verursacht!!!
 *
 * Kosten: 30 MP
 * Level : 1 
 * Schaden: 20+caster->QueryProp(P_GUILD_CIRCLE)+5*suc*
 *          (caster->QueryProp(P_GUILD_LEVEL)/MAX_ABILITY)
 * Schaden wird nur durch Skillpoints modifiziert!
 *
 * Objekte: /gilden/nekromanten/obj/zumuul
 *
 * Skillpunktefaehig (dam)
 *
 * Status: anschlussreif
 *
 */
// 23.06.2003 Archon: umstellung sinfo uebergabe, benutzung von skillpunkte

int zumuul(object caster, mapping sinfo) 
{
  object ob;
  string vn, vnw, cn;
  int suc, dam, skp;

  if (present(ZUM_UUL_OBJ, caster)) 
  {
    write("Deine Haende sind bereits von Zum-Uuls Blutgier umgeben!\n");
    return 0;
  }
  
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  write(BS("Mit aller Macht beschwoerst Du die Macht Zum-Uuls herbei!"));

  if ((suc=SpellSuccess(caster,sinfo))<=0) 
  {
    write(BSC(sprintf("VERSAGER%s! Du hast es nicht geschafft! Nun wird Dein "
          "Ende kommen, Du Schwaechling!", caster->QueryProp(P_GENDER)==FEMALE?
          "IN":"")));
    return MISSERFOLG;
  }
  UseBlood(2);
  ob=clone_object(OBJ "zumuul");
  skp=get_skillpoints(caster,"beruehrung von zum-uul");
  dam=15+skp+(caster->QueryProp(P_GUILD_LEVEL)*3+caster->QueryProp(P_GUILD_CIRCLE)/2)+5*suc*
    (caster->QueryProp(P_GUILD_LEVEL)/MAX_ABILITY);
  dam=get_dam_with_skillpoints(dam,skp);
  ob->Setup(caster,dam,suc,skp);
  ob->move(caster, M_NOCHECK);
  write(BSC("Du spuerst die blutgiere Macht Zum-Uuls in Dir, als Deine Haende "
      "anfangen sich begierig nach Blut zu sehnen! Nun musst Du nur mehr ein "
      "lebendiges Opfer beruehren (syntax: beruehre <name>)!"));
  tell_room(ENV(caster), BS(sprintf("Von %s Haenden scheint eine toedliche "
      "Macht auszugehen, Du siehst wie sie von einem kalten Schimmer umgeben "
      "sind, als koennten sie Deine Lebensessenz schon durch eine blosse "
      "Beruehrung aussaugen ...", caster->name(WESSEN))), ({caster}));

  return ERFOLG;
}
