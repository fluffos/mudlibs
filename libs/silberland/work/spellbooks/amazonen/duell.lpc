// Duell: Fokussiert den Speerkampf auf ein Ziel und erschwert Angriffe
// auf andere Gegner. Ziel kann nicht gewechselt werden, solange es existiert.

#include <objectinfo.h>

nosave void check_end_duell(object caster)
{
  mixed *x;

  if (!objectp(caster)) return;
  if (!pointerp(x = caster->QueryProp(P_AMAZONEN_DUELL)))
    return;

  if (sizeof(x) < 2 || x[0] <= time() || !objectp(x[1]))
  {
    tell_object(caster, BS("Dein Duellfokus loest sich wieder.\n"));
    caster->SetProp(P_AMAZONEN_DUELL, 0);
    return;
  }

  call_out("check_end_duell", 5, caster);
}

varargs int prep_duell(object caster, mapping sinfo, int flag)
{
  object victim, spear;
  mixed *x;

  if (!objectp(spear = caster->QueryProp(P_WEAPON)) ||
      spear->QueryProp(P_WEAPON_TYPE) != WT_SPEAR)
  {
    tell_object(caster, "Du brauchst einen Speer in der Hand, um ein Duell zu erzwingen.\n");
    return 0;
  }

  if (pointerp(x = caster->QueryProp(P_AMAZONEN_DUELL)) && sizeof(x) >= 2)
  {
    if (x[0] <= time() || !objectp(x[1]))
    {
      caster->SetProp(P_AMAZONEN_DUELL, 0);
      x = 0;
    }
  }

  if (pointerp(x) && sizeof(x) >= 2)
  {
    if (objectp(x[1]) && x[1] != victim)
    {
      tell_object(caster, BS(sprintf("Du bist bereits auf %s fokussiert und kannst das Ziel nicht wechseln.\n",
            x[1]->name(WEN,1) )));
      return 0;
    }
    tell_object(caster, "Du befindest Dich bereits in einem Duell.\n");
    return 0;
  }

  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;

  victim = FindEnemyVictim(sinfo[SI_SKILLARG], caster,
      "Wen willst Du zum Duell fordern?\n");
  if (!victim)
    return 0;

  sinfo[SI_ENEMY] = victim;
  return 1;
}


int duell(object caster, mapping sinfo)
{
  object victim;
  int suc, ability, dur;
  float mult;
  string grade;

  if (!prep_duell(caster, sinfo, 1))
    return 0;

  victim = sinfo[SI_ENEMY];
  if (!objectp(victim))
    return 0;

  if(!caster->IsEnemy(victim)) caster->Kill(victim);

  if ((suc = SpellSuccess(caster, sinfo)) <= 0)
    return MISSERFOLG;

  ability = sinfo[SI_SKILLABILITY];
  if (ability < 0) ability = 0;

  // Zielbindung: maximal 30 minuten
  dur = 60*30;

  mult = ability / 50000.0 + suc / 50000.0;
  if (mult < 0.05) mult = 0.05;
  if (mult > 0.35) mult = 0.35;

  if (mult < 0.12) grade = "leicht";
  else if (mult < 0.20) grade = "merklich";
  else if (mult < 0.28) grade = "deutlich";
  else grade = "massiv";

  environment(caster)->Message(BS(sprintf("%s fixiert %s in einem erbitterten Duell.",
        caster->Name(WER,1), victim->name(WEN,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster, victim }) ]) );
  tell_object(caster, BS(sprintf("Du fokussierst Dich %s auf %s. Alle anderen Gegner werden zur Nebensache.\n",
        grade, victim->name(WEN,1) )));
  tell_object(victim, BS(sprintf("%s fordert Dich zum Duell!\n", caster->Name(WER,1))));

  caster->SetProp(P_AMAZONEN_DUELL, ({time() + dur, victim, mult}));
  call_out("check_end_duell", 5, caster);
  return ERFOLG;
}
