varargs int prep_schildwall(object caster, mapping sinfo, int flag) 
{
  if (caster->QueryProp(P_AMAZONEN_SCHILDWALL))
  {
    tell_object(caster, "Dein Schild steht ja schon in Schutzposition!\n");
    return 0;
  }

  if(!caster->InFight()) {
    tell_object(caster, "Du kannst den Schild nur im Kampf hochheben!\n");
    return 0;
  }

  if (!sizeof(caster->QueryArmours(AT_SHIELD)) )
  {
    tell_object(caster, "Du musst einen Schild tragen haben, um einen " 
        "Schildwall machen zu koennen!\n");
    return 0;
  }
  
  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;

  return 1;
}

int schildwall(object caster, mapping sinfo) 
{
  int suc;
  int prot;
  int dur;
  object ob;

  if (!prep_schildwall(caster, sinfo, 1))
    return 0;

  if ((suc = SpellSuccess(caster,sinfo)) <= 0)
    return MISSERFOLG;

  environment(caster)->Message(BS(sprintf("%s hebt den Schild um sich zu schuetzen.", caster->Name(WER,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  tell_object(caster, "Du packst deinen Schild fest und schuetzt dich damit.\n");

  dur = 2+2*caster->QueryAttribute(A_DEX)/3+(suc/2000);
  if (sinfo[SI_SKILLABILITY] == MAX_ABILITY)
    dur *= 2 + random(2);
  if(sinfo[SI_SKILLPOINTS] > 1) dur = (int) (dur * 1.5);

  prot = (100 * suc + 5 * sinfo[SI_SKILLABILITY]) / MAX_ABILITY;
  if(sinfo[SI_SKILLPOINTS] > 2) {
    prot += sinfo[SI_SKILLPOINTS] * 2;
  }

  caster->SetProp(P_AMAZONEN_SCHILDWALL, prot);
  if(objectp(present(GUILD_ITEM, caster))) present(GUILD_ITEM, caster)->RegisterEffect();
  call_out("RemoveSchildwall", dur, caster);
  return ERFOLG;
}

void RemoveSchildwall(object caster)
{
  if (objectp(caster) && caster->QueryProp(P_AMAZONEN_SCHILDWALL))
  {
    tell_object(caster, "Du senkst deinen Schild und bist nicht mehr so gut geschuetzt.\n");
    caster->SetProp(P_AMAZONEN_SCHILDWALL, 0);
    if(objectp(present(GUILD_ITEM, caster))) present(GUILD_ITEM, caster)->UnregisterEffect("schildwall");
  }
}
