// Sturzflug: Beschleunigter Sinkflug, gibt mehr Schaden im Speerkampf pro Hoehe.

varargs int prep_sturzflug(object caster, mapping sinfo, int flag)
{
  if (!present("\namz_himmelsritt", caster))
  {
    tell_object(caster, "Du musst bereits in der Luft sein (Himmelsritt), um einen Sturzflug zu beginnen.\n");
    return 0;
  }

  if (caster->QueryProp(P_AMAZONEN_STURZFLUG) &&
      caster->QueryProp(P_AMAZONEN_STURZFLUG) > time())
  {
    tell_object(caster, "Du befindest Dich schon im Sturzflug.\n");
    return 0;
  }

  if (!caster->InFight())
  {
    tell_object(caster, "Ein Sturzflug macht nur im Kampf Sinn.\n");
    return 0;
  }

  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;

  return 1;
}


int sturzflug(object caster, mapping sinfo)
{
  object hr;
  int suc, dur, drop;

  if (!prep_sturzflug(caster, sinfo, 1))
    return 0;

  if ((suc = SpellSuccess(caster, sinfo)) <= 0)
    return MISSERFOLG;

  dur = caster->QueryProp(P_GUILD_LEVEL) + sinfo[SI_SKILLABILITY] / 2000 + suc / 2000;
  if (sinfo[SI_SKILLABILITY] == MAX_ABILITY)
    dur += random(10);

  drop = 1 + sinfo[SI_SKILLABILITY] / 2000 + random(2); // zusaetzliches Absinken pro Tick
  if (drop < 1) drop = 1;

  environment(caster)->Message(BS(sprintf("%s legt die Fluegel an und stuerzt sich in den Kampf!",
        caster->Name(WER,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  tell_object(caster, "Du stuerzt Dich kampflustig aus der Hoehe auf Deine Gegner.\n");

  caster->SetProp(P_AMAZONEN_STURZFLUG, time() + dur);
  if(present(GUILD_ITEM, caster)) present(GUILD_ITEM, caster)->RegisterEffect();
  call_out("RemoveSturzflug", dur, caster);
  return ERFOLG;
}

public void RemoveSturzflug(object caster)
{
  if (!objectp(caster)) return;
  if (!caster->QueryProp(P_AMAZONEN_STURZFLUG)) return;
  caster->SetProp(P_AMAZONEN_STURZFLUG, 0);
  tell_object(caster, BS("Du beendest deinen Sturzflug."));
  if(present(GUILD_ITEM, caster)) present(GUILD_ITEM, caster)->UnregisterEffect("sturzflug");
}