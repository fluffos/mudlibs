// Heldenaura: Orakel-Aura. Staerkt die Amazone und heilt im Raum Verbündete.

varargs int prep_heldenaura(object caster, mapping sinfo, int flag)
{
  if (present("\namz_heldenaura", caster))
  {
    tell_object(caster, "Eine Heldenaura umgibt Dich bereits.\n");
    return 0;
  }

  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;

  return 1;
}


int heldenaura(object caster, mapping sinfo)
{
  object ob;
  int suc, ability, dur, bonus;

  if (!prep_heldenaura(caster, sinfo, 1))
    return 0;

  if ((suc = SpellSuccess(caster, sinfo)) <= 0)
    return MISSERFOLG;

  ability = sinfo[SI_SKILLABILITY];
  if (ability < 0) ability = 0;

  bonus = 1 + ability / 4000 + suc / 5000;
  if (bonus < 1) bonus = 1;
  if (bonus > 3) bonus = 3;
  if(sinfo[SI_SKILLPOINTS] > 2) bonus += 2;

  dur = 20 + caster->QueryProp(P_GUILD_LEVEL) * 5 + ability / 200 + suc / 400;
  if (dur < 30) dur = 30;
  if (dur > 180) dur = 180;
  if(sinfo[SI_SKILLPOINTS] > 1) dur *= 2;

  environment(caster)->Message(BS(sprintf("%s wird von einer warmen Heldenaura umhuellt.",
        caster->Name(WER,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  tell_object(caster, "Du rufst eine Heldenaura, die Dich staerkt und Verbündete in deiner Umgebung heilt.\n");

  ob = clone_object("/gilden/amazonen/obj/heldenaura");
  if (ob->move(caster, M_NOCHECK | M_SILENT) != 1)
  {
    destruct(ob);
    tell_object(caster, "Deine Heldenaura kann sich nicht manifestieren.\n");
    return 0;
  }

  ob->setup_heldenaura(caster, bonus, dur);
  return ERFOLG;
}

