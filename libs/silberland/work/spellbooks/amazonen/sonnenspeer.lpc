// Sonnenspeer: Markiert die Amazone, um sich im Speerkampf selbst zu heilen.

nosave void clear_sonnenspeer(object caster)
{
  if (!objectp(caster)) return;
  caster->SetProp(P_AMAZONEN_SONNENSPEER, 0);
  tell_object(caster, BS("Das Sonnenlicht in deinem Speer erlischt."));
  if(objectp(present(GUILD_ITEM, caster))) present(GUILD_ITEM, caster)->UnregisterEffect("sonnenspeer");
}


varargs int prep_sonnenspeer(object caster, mapping sinfo, int flag)
{
  object spear;

  if (caster->QueryProp(P_AMAZONEN_SONNENSPEER))
  {
    tell_object(caster, "Die Macht der Sonne wirkt bereits auf Deinem Speer.\n");
    return 0;
  }

  if (!objectp(spear = caster->QueryProp(P_WEAPON)))
  {
    tell_object(caster, "Ohne Speer kannst Du die Sonnenkraft nicht kanalisieren.\n");
    return 0;
  }

  if (spear->QueryProp(P_WEAPON_TYPE) != WT_SPEAR)
  {
    tell_object(caster, "Du brauchst einen Speer, um die Sonnenkraft zu fuehren.\n");
    return 0;
  }

  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;

  return 1;
}


int sonnenspeer(object caster, mapping sinfo)
{
  int suc, dur;

  if (!prep_sonnenspeer(caster, sinfo, 1))
    return 0;

  if ((suc = SpellSuccess(caster, sinfo)) <= 0)
    return MISSERFOLG;

  dur = caster->QueryProp(P_GUILD_LEVEL) + sinfo[SI_SKILLABILITY] / 1000;
  if (sinfo[SI_SKILLABILITY] == MAX_ABILITY)
    dur += random(60);
  if(sinfo[SI_SKILLPOINTS] > 0) dur += sinfo[SI_SKILLPOINTS] * 10;

  environment(caster)->Message(BS(sprintf("%s hebt den Speer, der in goldenem Licht aufflammt.",
        caster->Name(WER,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  tell_object(caster, "Dein Speer fuellt sich mit der heilenden Kraft der Sonne.\n");

  caster->SetProp(P_AMAZONEN_SONNENSPEER, time() + dur);
  call_out("clear_sonnenspeer", dur, caster);
  return ERFOLG;
}
