int niederwerfen(object caster, mapping sinfo) 
{
  object victim;
  int suc;
  object spear;
  int dam;

  victim = FindEnemyVictim(sinfo[SI_SKILLARG], caster,
      "Wen willst Du mit deinem Speer niederwerfen?\n");
  if (!victim)
    return 0;
  if (caster->QueryProp(P_DISABLE_ATTACK))
  {
    tell_object(caster, "Du bist kampfunfaehig und kannst jetzt keinen "
        "Schildschlag machen!\n");
    return 0;
  }
  if (!objectp(caster->QueryProp(P_WEAPON)) )
  {
    tell_object(caster, "Du musst eine Waffe haben, um jemanden niederwerfen zu koennen!\n");
    return 0;
  }

  spear = caster->QueryProp(P_WEAPON);
  if(spear->QueryProp(P_WEAPON_TYPE) != WT_SPEAR) {
    tell_object(caster, "Das geht nur mit einem Speer!\n");
    return 0;
  }

  if (!(sinfo = pay_for_spell(caster, sinfo)))
    return 0;

  if ((suc = SpellSuccess(caster,sinfo)) <= 0)
    return MISSERFOLG;

  environment(caster)->Message(BS(sprintf("%s schlaegt mit %s nach den Beinen von %s.", caster->Name(WER,1), spear->name(WESSEN), victim->name(WEM))), MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster, victim }) ]) );

  tell_object(caster, BSC(sprintf("Du schlaegst mit %s nach dem Beinen von %s.\n", spear->name(WESSEN), victim->name(WEM))));

  sinfo[SI_SKILLDAMAGE] += random(spear->QueryProp(P_WC) / 2);
  sinfo[OFFSET(SI_SKILLDAMAGE)] += spear->QueryProp(P_WC) / 3;
  sinfo[SI_MAX_DAMAGE] += caster->QueryProp(P_GUILD_LEVEL) * 10;

  pDebug(caster, 
    sprintf("dam = %d, off = %d, max = %d\n",
        sinfo[SI_SKILLDAMAGE], 
        sinfo[OFFSET(SI_SKILLDAMAGE)], 
        sinfo[SI_MAX_DAMAGE])
  );

  dam = TryDefaultAttackSpell(victim, caster, sinfo, sinfo[SI_SPELL] + 
      ([SP_REDUCE_ARMOUR: ([P_BODY: 101 - sinfo[SI_SKILLABILITY] / 100])]) );

  if(!objectp(victim)) return ERFOLG;

  if (victim->QueryProp(P_DISABLE_ATTACK) || !random(10 - (suc/1000) - sinfo[SI_SKILLPOINTS])) {
    tell_room(environment(victim), BS(sprintf("%s faellt zu Boden.", victim->Name(WER,1))), ({ victim }) );
    victim->SetProp(P_DISABLE_ATTACK, 1);
    victim->SetProp(P_LAST_RAMMEN_TIME, time());
  }

  pDebug(caster, sprintf("Schaden = %d\n", dam));
  return ERFOLG;
}
