varargs int prep_spiegelbild(object caster, mapping sinfo, int flag) 
{
  if (!caster->InFight())
  {
    tell_object(caster,
        "Wieso willst Du ein Spiegelbild erzeugen wenn Du gar nicht kaempfst?\n");
    return 0;
  }
  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;
  return 1;
}


int spiegelbild(object caster, mapping sinfo) 
{
  object ob, ob2;
  int suc;

  if (!prep_spiegelbild(caster, sinfo, 1))
    return 0;
  if ((suc = SpellSuccess(caster,sinfo)) <= 0)
    return MISSERFOLG;

  if (sinfo[SI_SKILLPOINTS] > 2)
  {
    tell_object(caster,
        "Neben Dir erscheinen ploetzlich zwei lebende Spiegelbilder von Dir selbst.\n");
    environment(caster)->Message(BS(sprintf("Neben %s tauchen ploetzlich zwei "
            "Spiegelbilder ihrer selbst auf.", caster->Name(WER,1))), 
        MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  }
  else
  {
    tell_object(caster,
        "Neben Dir erscheint ploetzlich ein lebendes Spiegelbild von Dir selbst.\n");
    environment(caster)->Message(BS(sprintf("Neben %s taucht ploetzlich ein "
            "Spiegelbild ihrer selbst auf.", caster->Name(WER,1))), 
        MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  }
  ob = clone_object(NPC "spiegelbild");
  if (objectp(ob))
  {
    ob->set_variables(caster, suc);
    ob->move(environment(caster), M_NOCHECK| M_SILENT);
  }

  if (sinfo[SI_SKILLPOINTS] > 2)
  {
    ob2 = clone_object(NPC "spiegelbild");
    if (objectp(ob2))
    {
      ob2->set_variables(caster, suc);
      ob2->move(environment(caster), M_NOCHECK| M_SILENT);
    }
  }
  return ERFOLG;
}
