
varargs int prep_selbstbeherrschung(object caster, mapping sinfo, int flag)
{
  if (caster->InFight())
  {
    tell_object(caster, "Das geht im Kampf nicht.\n");
    return 0;
  }
  if (present(AMAZON_SELF, caster))
  {
    tell_object(caster, "Deine Selbstbeherrschung ist doch schon gestaerkt!\n");
    return 0;
  }
  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;
  return 1;
}

string prop2string(string prop)
{
  return ([
    T_COLD_PROT: "Kaelte",  
    T_HEAT_PROT: "Hitze",  
    P_DEAF:      "Taubheit", 
    P_BLIND:     "Blindheit",
    P_POISON:    "Vergiftung",
    P_FROG:      "Verfroschung", 
    P_PARALYZED: "Paralyse",
    ]) [prop];
}

int selbstbeherrschung(object caster, mapping sinfo) 
{
  int suc;
  int dur;
  string* props;
  object ob;
  int abil, glevel;
  int i, j;
  string schutz;
  int cold, heat;

  if (!prep_selbstbeherrschung(caster, sinfo, 1))
    return 0;

  if ((suc = SpellSuccess(caster,sinfo)) <= 0)
    return MISSERFOLG;

  environment(caster)->Message(BS(sprintf("%s atmet tief durch und "
          "beherrscht sich.", caster->Name(WER,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  tell_object(caster, "Du atmest tief durch und beherrscht Dich.\n");

  glevel = caster->QueryProp(P_GUILD_LEVEL);
  abil = sinfo[SI_SKILLABILITY];
  dur = 30 * (1 + 2 * suc + abil) / MAX_ABILITY +
        glevel * 10;
  if (abil == MAX_ABILITY)
    dur *= 1 + random(2);
  if(sinfo[SI_SKILLPOINTS] > 1) dur = (int) (dur * 1.5);

  props = ({T_COLD_PROT});
  cold = random(2 * suc + abil) / 2500 + glevel / 2;
  if (suc > random(5000))
  {
    props += ({T_HEAT_PROT});
    heat = random(2 * suc + abil) / 3500 + glevel / 3;
  }
  if (suc > random(6000 - (sinfo[SI_SKILLPOINTS] > 2 ? 2000 : 0)))
    props += ({P_DEAF});
  if (suc > random(8000 - (sinfo[SI_SKILLPOINTS] > 2 ? 3000 : 0)))
    props += ({P_BLIND});
  if (glevel >= 8 && suc > random(11000 - (sinfo[SI_SKILLPOINTS] > 2 ? 4000 : 0)))
    props += ({P_POISON});
  if (glevel >= 9 && suc > random(13000 - (sinfo[SI_SKILLPOINTS] > 2 ? 5000 : 0)))
    props += ({P_FROG});
  if (glevel >= 10 && suc > random(16000) - (sinfo[SI_SKILLPOINTS] > 2 ? 6000 : 0))
    props += ({P_PARALYZED});

  schutz = "Du bist jetzt gegen ";

  for (i = 0, j = sizeof(props) -1; i <= j; i++)
  {
    schutz += prop2string(props[i]);
    if (i == j)
      schutz += " geschuetzt.";
    else if (i == j - 1)
      schutz += " und ";
    else 
      schutz += ", ";
    if (caster->QueryProp(props[i]))
      tell_object(caster, 
          "Deine Selbstbeherrschung unterdrueckt den Effekt der " + 
          prop2string(props[i]) + ".\n");
  }
  tell_object(caster, BSC(schutz));

  ob = clone_object(OBJ "self");
  ob->move(caster, M_NOCHECK);
  ob->setup(caster, cold, heat, props - ({T_COLD_PROT, T_HEAT_PROT}), dur);

  if (IS_WIZARD(caster))
    printf("Suc=%d, COLD=%d HEAT=%d, DUR=%d min %d sec\n", 
        suc,cold,heat,dur/60,dur%60);
  return ERFOLG;
}
