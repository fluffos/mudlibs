// Verwunden: Schaden-ueber-Zeit Spell fuer die Amazonen (Speerseele)
// Fuegt alle zwei Sekunden Schaden zu, solange das Ziel blutet.

nosave void clear_verwunden_mark(object victim, object caster);
nosave void verwunden_tick(object victim, object caster, mapping sinfo, int ticks);

varargs int prep_verwunden(object caster, mapping sinfo, int flag)
{
  object victim, spear;

  if (!caster->InFight())
  {
    tell_object(caster, "Du kannst nur im Kampf eine klaffende Wunde schlagen.\n");
    return 0;
  }

  victim = FindEnemyVictim(sinfo[SI_SKILLARG], caster,
      "Wen willst Du verwunden?\n");
  if (!victim)
    return 0;

  if (caster->QueryProp(P_DISABLE_ATTACK))
  {
    tell_object(caster, "Du bist kampfunfaehig und kannst niemanden verwunden!\n");
    return 0;
  }

  if (!objectp(spear = caster->QueryProp(P_WEAPON)))
  {
    tell_object(caster, "Ohne Waffe kannst Du niemanden verwunden.\n");
    return 0;
  }

  if (spear->QueryProp(P_WEAPON_TYPE) != WT_SPEAR)
  {
    tell_object(caster, "Du verwundest so nur Deine Ehre - nimm einen Speer in die Hand!\n");
    return 0;
  }

  if (victim->QueryProp(P_NPC))
  {
    mapping wounds;
    wounds = victim->QueryProp(P_AMAZONEN_WOUNDED);
    if (mappingp(wounds) && wounds[caster])
    {
      tell_object(caster, sprintf("%s blutet bereits von Deinem letzten Stich.\n",
            victim->Name(WER,1)));
      return 0;
    }
  }

  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;

  sinfo[SI_ENEMY] = victim;
  return 1;
}


int verwunden(object caster, mapping sinfo)
{
  object victim, spear;
  int suc, ticks, bonus;
  mapping wounds;

  if (!prep_verwunden(caster, sinfo, 1))
    return 0;

  victim = FindEnemyVictim(sinfo[SI_SKILLARG], caster, "");
  if (!victim)
    return 0;

  if ((suc = SpellSuccess(caster, sinfo)) <= 0)
    return MISSERFOLG;

  spear = caster->QueryProp(P_WEAPON);
  bonus = CheckEquip(caster, sinfo[SI_SPELLFUNC]);

  // Passe Schaden an die Waffe und Ausruestung an.
  sinfo[SI_SKILLDAMAGE_TYPE] = spear ? spear->QueryProp(P_DAM_TYPE) : DT_PIERCE;
  sinfo[SI_SKILLDAMAGE] += (spear ? spear->QueryProp(P_WC) : 0) + bonus;
  sinfo[OFFSET(SI_SKILLDAMAGE)] += (spear ? spear->QueryProp(P_WC_FIX) * 3 / 2 : 0) + bonus;
  sinfo[SI_MAX_DAMAGE] += (caster->QueryProp(P_GUILD_LEVEL) - 6) * 15 + bonus * 2;
  if(sinfo[SI_SKILLPOINTS] > 0) {
    sinfo[SI_SKILLDAMAGE] += caster->Queryprop(P_GUILD_LEVEL) * 10;
    sinfo[OFFSET(SI_SKILLDAMAGE)] += caster->Queryprop(P_GUILD_LEVEL) * 5;
    sinfo[SI_MAX_DAMAGE] += caster->Queryprop(P_GUILD_LEVEL) * 20;
  }

  environment(caster)->Message(BS(sprintf("%s reisst %s mit einem Speerstich eine klaffende Wunde.",
        caster->Name(WER,1), victim->name(WEM,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster, victim }) ]) );

  tell_object(caster, BSC(sprintf("Du stichst tief nach %s und laesst die Wunde bluten.\n",
        victim->name(WEM,1))));
  tell_object(victim, BS(sprintf("%s sticht Dich tief und die Wunde beginnt zu bluten!",
        caster->Name(WER,1))));

  ticks = 3 + sinfo[SI_SKILLABILITY] / 200 + suc / 2000;
  if (ticks > 6) ticks = 6;
  if (ticks < 3) ticks = 3;
  if(sinfo[SI_SKILLPOINTS] > 1) ticks += ticks/2;

  if (victim->QueryProp(P_NPC))
  {
    wounds = victim->QueryProp(P_AMAZONEN_WOUNDED);
    if (!mappingp(wounds)) wounds = ([]);
    wounds[caster] = time() + ticks * 2;
    victim->SetProp(P_AMAZONEN_WOUNDED, wounds);
  }

  call_out("verwunden_tick", 2, victim, caster, copy_mapping(sinfo), ticks);
  return ERFOLG;
}


nosave void verwunden_tick(object victim, object caster, mapping sinfo, int ticks)
{
  mapping tickinfo;
  int dam, faktor;

  if (!objectp(victim))
    return;

  if (!objectp(caster))
  {
    clear_verwunden_mark(victim, caster);
    return;
  }

  if (victim->QueryProp(P_GHOST))
  {
    clear_verwunden_mark(victim, caster);
    return;
  }

  if(tickinfo[SI_SKILLPOINTS] > 2) faktor = 2;
  else faktor = 3;

  tickinfo = copy_mapping(sinfo);
  tickinfo[SI_ENEMY] = victim;
  tickinfo[SI_SKILLDAMAGE] = sinfo[SI_SKILLDAMAGE] / faktor +
    random(sinfo[SI_SKILLDAMAGE] / 4 + 1);
  tickinfo[OFFSET(SI_SKILLDAMAGE)] = sinfo[OFFSET(SI_SKILLDAMAGE)] / faktor;
  tickinfo[SI_MAX_DAMAGE] = sinfo[SI_MAX_DAMAGE] / faktor;

  tell_object(victim, "Die Wunde brennt und reisst weiter auf!\n");
  if (environment(victim))
    environment(victim)->Message(BS(sprintf("%s blutet weiter aus einer tiefen Wunde.",
          victim->Name(WER,1))),
        MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ victim }) ]) );

  dam = TryDefaultAttackSpell(victim, caster, tickinfo, tickinfo[SI_SPELL]);
  pDebug(caster, sprintf("Verwunden Tick: %d Schaden\n", dam));

  if (--ticks > 0 && objectp(victim) && !victim->QueryProp(P_GHOST))
    call_out("verwunden_tick", 2, victim, caster, sinfo, ticks);
  else
    clear_verwunden_mark(victim, caster);
}


nosave void clear_verwunden_mark(object victim, object caster)
{
  mapping wounds;

  if (!objectp(victim))
    return;

  wounds = victim->QueryProp(P_AMAZONEN_WOUNDED);
  if (!mappingp(wounds))
    return;

  wounds = m_delete(wounds, caster);

  if (sizeof(wounds))
    victim->SetProp(P_AMAZONEN_WOUNDED, wounds);
  else
    victim->SetProp(P_AMAZONEN_WOUNDED, 0);

  tell_object(victim, BS("Deine Wunde von " + caster->name(WEM) + " schliesst sich."));
  tell_object(caster, BS("Die Wunde, die du bei " + victim->name(WEM) + " verursacht hast schliesst sich."));
}
