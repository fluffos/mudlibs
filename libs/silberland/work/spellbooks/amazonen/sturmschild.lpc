// Sturmschild: Beschwoert ein magisches Schild aus Sturmwind, das Angreifer verletzt.

varargs int prep_sturmschild(object caster, mapping sinfo, int flag)
{
  if (present("\namz_sturmschild", caster))
  {
    tell_object(caster, "Du traegst bereits einen Sturmschild.\n");
    return 0;
  }

  if(sizeof(caster->QueryArmours(AT_SHIELD)) != 0) {
    tell_object(caster, BS("Du traegst bereits einen anderen Schild!\n"));
    return 0;
  }

  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;

  return 1;
}


int sturmschild(object caster, mapping sinfo)
{
  object ob;
  int suc, dur;

  if (!prep_sturmschild(caster, sinfo, 1))
    return 0;

  if ((suc = SpellSuccess(caster, sinfo)) <= 0)
    return MISSERFOLG;

  dur = 40 + caster->QueryProp(P_GUILD_LEVEL) * 8 + sinfo[SI_SKILLABILITY] / 200;

  pDebug(caster, sprintf("Sturmschild duration: %d", dur));

  environment(caster)->Message(BS(sprintf("%s beschwoert einen schuetzenden Sturmschild.",
        caster->Name(WER,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  tell_object(caster, "Wind und Blitze verdichten sich zu einem Schild an Deinem Arm.\n");

  ob = clone_object("/gilden/amazonen/armour/sturmschild");
  if (ob->move(caster, M_NOCHECK | M_SILENT) != 1)
  {
    destruct(ob);
    tell_object(caster, "Der Sturmschild findet keinen Platz bei Dir.\n");
    return 0;
  }

  ob->setup_shield(caster, suc, sinfo[SI_SKILLABILITY], dur,
                   sinfo[SI_SKILLPOINTS]);
  if (!ob->DoWear(1))
  {
    ob->remove(1);
    tell_object(caster, "Du kannst den Sturmschild nicht fuehren.\n");
    return 0;
  }

  return ERFOLG;
}
