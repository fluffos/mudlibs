// Himmelsritt: Valkyre-Sprung, haelt die Amazone ueber ihren Gegnern und laesst sie langsam sinken.

varargs int prep_himmelsritt(object caster, mapping sinfo, int flag)
{
  if (caster->QueryProp(P_AMAZONEN_ASCENT))
  {
    tell_object(caster, "Du schwebst bereits in der Luft.\n");
    return 0;
  }
  
  if (caster->QueryProp(P_DISABLE_ATTACK))
  {
    tell_object(caster, "Du kannst Dich gerade nicht koordinieren, um zu springen.\n");
    return 0;
  }

  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;

  return 1;
}


int himmelsritt(object caster, mapping sinfo)
{
  object ob;
  int suc, dur, ascent;

  if (!prep_himmelsritt(caster, sinfo, 1))
    return 0;

  if ((suc = SpellSuccess(caster, sinfo)) <= 0)
    return MISSERFOLG;

  ascent = 1 + caster->QueryAttribute(A_DEX) / 10 + sinfo[SI_SKILLABILITY] / 2500 + suc / 3333;
  if (ascent > 10) ascent = 10;

  environment(caster)->Message(BS(sprintf("%s springt mit einem gewaltigen Satz in die Hoehe! Durchscheinende Fluegel bilden sich an ihrem Ruecken und sie schwebt leicht.",
        caster->Name(WER,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  tell_object(caster, "Du springst hoch und feine durchscheinende Fluegel bilden sich an deinem Ruecken. Du gewinnst an Hoehe.\n");

  ob = clone_object("/gilden/amazonen/obj/himmelsritt");
  if (ob->move(caster, M_NOCHECK | M_SILENT) != 1)
  {
    destruct(ob);
    tell_object(caster, "Du findest keinen Halt fuer den Himmelsritt.\n");
    return 0;
  }

  ob->setup_himmelsritt(caster, ascent, sinfo[SI_SKILLPOINTS]);
  caster->SetProp(P_AMAZONEN_ASCENT, ascent);
  return ERFOLG;
}
