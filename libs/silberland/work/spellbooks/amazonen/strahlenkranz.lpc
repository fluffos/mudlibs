
int strahlenkranz(object caster, mapping sinfo) 
{
  int suc, time;
  object ob;

  if (caster->InFight())
  {
    tell_object(caster,
        "Im Kampf kannst Du keinen Strahlenkranz erzeugen.\n");
    return 0;
  }
  if (present(STRAHLENKRANZ, caster))
  {
    tell_object(caster,
        "Aber Du bist Doch schon von einem Strahlenkranz umgeben.\n");
    return 0;
  }

  if (!(sinfo = pay_for_spell(caster, sinfo)))
    return 0;

  if ((suc = SpellSuccess(caster,sinfo)) <= 0)
    return MISSERFOLG;

  environment(caster)->Message(BS(sprintf("%s konzentriert sich und ein "
          "Kranz aus strahlendem Licht materialisiert sich auf ihrem Kopf.",
        caster->Name(WER,1))),  MSGFLAG_VISUAL | MSGFLAG_NO_TP);

  tell_object(caster, BSC(sprintf("Du konzentrierst Dich und ein Kranz aus "
          "strahlendem Licht materialisiert sich auf Deinem Kopf.")));

  ob = clone_object(OBJ "strahlenkranz");
  ob->move(caster, M_NOCHECK);
  ob->setup(caster, -1.0 * (2 * suc + sinfo[SI_SKILLABILITY]) / 300000 *
      (sinfo[SI_SKILLPOINTS] > 1 ? 2 : 1) );

  time = ((suc + sinfo[SI_SKILLABILITY]) / 100 + caster->QueryProp(P_GUILD_LEVEL) * 20) + (sinfo[SI_SKILLPOINTS] > 0 ? 30 : 0);
  ob->start_remove( time * (sinfo[SI_SKILLABILITY] == MAX_ABILITY ? 2 : 1) );

  if(sinfo[SI_SKILLPOINTS] > 2) {
    // markieren, dass gegner im kampf geblendet werden
    ob->SetProp(P_BLIND, 1);
    write("Dein Strahlenkranz ist so hell, dass er Deine Gegner im Kampf blenden kann!\n");
  }

  return ERFOLG;
}
