varargs int prep_schnelligkeit(object caster, mapping sinfo, int flag) 
{
  if (present(AMAZON_SPEED, caster) || present("DEX_BUFF", caster) ||
      100 * caster->QuerySkillAttribute(SA_SPEED) / 
      caster->QuerySkillAttribute(SA_QUALITY) > 100)
  {
    tell_object(caster, "Du bewegst Dich ja schon schneller!\n");
    return 0;
  }
  if (!pay_for_spell(caster, sinfo, !flag))
    return 0;
  return 1;
}

int schnelligkeit(object caster, mapping sinfo) 
{
  int suc;
  int dex;
  int speed;
  int dur;
  object ob;

  if (!prep_schnelligkeit(caster, sinfo, 1))
    return 0;

  if ((suc = SpellSuccess(caster,sinfo)) <= 0)
    return MISSERFOLG;

  environment(caster)->Message(BS(sprintf("%s bewegt sich ploetzlich viel "
          "schneller.", caster->Name(WER,1))),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ caster }) ]) );
  tell_object(caster, "Du bewegst Dich ploetzlich viel schneller.\n");

  dex = (4 * suc + 2 * sinfo[SI_SKILLABILITY]) / MAX_ABILITY + 
        random(caster->QueryProp(P_GUILD_LEVEL) / 2);
  speed = 100 + (20 * suc + 10 * sinfo[SI_SKILLABILITY]) / MAX_ABILITY +
         caster->QueryProp(P_GUILD_LEVEL) + (sinfo[SI_SKILLPOINTS] > 1 ? 50 : 0);
  dur = 60 * (1 + 2 * suc + sinfo[SI_SKILLABILITY]) / MAX_ABILITY +
        caster->QueryProp(P_GUILD_LEVEL) * 20;
  if(sinfo[SI_SKILLPOINTS] > 2) dur = (int) (dur *1.5);
  if (sinfo[SI_SKILLABILITY] == MAX_ABILITY)
    dur *= 2 + random(2);

  ob = clone_object(OBJ "speed");
  ob->move(caster, M_NOCHECK);
  if (IS_WIZARD(caster))
    printf("Suc=%d, DEX=%d, SPEED=%d, DUR=%d min %d sec\n", suc,dex,speed,dur/60,dur%60);
  ob->setup(caster, dex, speed, dur);
  return ERFOLG;
}
