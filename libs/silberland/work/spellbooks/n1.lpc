string eng2germ(string eng)
{
    switch(eng)
    {
      case DT_FIRE: return "Feuerschaden";
      case DT_MAGIC: return "Magieschaden";
      case DT_COLD: return "Eisschaden";
      case DT_ACID: return "Saeureschaden";
      case DT_TERROR: return "Terrorschaden";
      case DT_POISON: return "Giftschaden";
      case DT_HOLY: return "heiligen Schaden";
      case DT_UNHOLY: return "unheiligen Schaden";
      case DT_LIGHT: return "Lichtschaden";
      case DT_SOUND: return "Laermschaden";
      case DT_WATER: return "Wasserschaden";
      case DT_LIGHTNING: return "Blitzschlag";
      case DT_ELECTRIC: return "Stromschaden";
      case DT_EXPLOSION: return "Explosionsschaden";
      case DT_AIR: return "Luftschaden";
      case DT_MIND: return "geistigen Schaden";
      default: return eng;
    }
}

void Misserfolg(object caster, string spell, mapping sinfo) 
{
  int old_abil, modifier, abil, new_abil;
  object victim;

  if( stringp(sinfo[SI_SKILLARG]) && 
      (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
       (victim=present(sinfo[SI_SKILLARG], caster))))
  {
    if(victim->id(SID_NOLEARN)) 
    {
      printf("Leider lernst Du nicht aus Deinem Fehler.\n");
      return;
    }
  }
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "nekromanten");
  if(caster->QueryProp(P_ALIGN )> 0) {
    printf("Werde erstmal boeser! So lernst Du nie was!\n");
    return;
  }
  old_abil=caster->QuerySkillAbility(spell);
  Learn(caster, spell, sinfo);
  new_abil=caster->QuerySkillAbility(spell);
  if (old_abil < new_abil) 
  {
    printf("Du lernst aus Deinem Fehler.\n" ); 
    if(new_abil==MAX_ABILITY)
      tell_object(caster, BS(sprintf("%s teilt Dir mit: Du kannst %s "
          "nun daemonisch gut! WEITER SO!", GUILDNPC_NAME, CAP(spell))));
  }
  else 
    printf( "Leider lernst Du nicht aus Deinem Fehler.\n" );
  return;
}

void Erfolg(object caster, string spell, mapping sinfo) 
{
  int abil;
  object victim;
  if(!interactive(caster)) 
    return;
  abil=sinfo[SI_SKILLABILITY];
  if (abil!=MAX_ABILITY && random(MAX_ABILITY)<abil-MAX_ABILITY+100 )
  {
    if( stringp(sinfo[SI_SKILLARG]) && 
        (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
         (victim=present(sinfo[SI_SKILLARG], caster))))
    {
      if(victim->id(SID_NOLEARN)) 
      {
        printf("Leider lernst Du nicht aus Deinem Fehler.\n");
        return;
      }
    }
    if(caster->QueryProp(P_ALIGN) > 0) {
      printf("Werde erstmal boeser! So lernst Du nie was!\n");
      return;
    }
    caster->ModifySkill( spell, ([ SI_SKILLABILITY: ++abil ]), 0, "nekromanten");
    tell_object(caster,"Du lernst aus Deinem Erfolg.\n");
    if (abil==MAX_ABILITY)
    {
      tell_object(caster, BS(sprintf("%s teilt Dir mit: Du kannst %s "
          "nun absolut perfekt! WEITER SO!", GUILDNPC_NAME, CAP(spell))));
    }
  }
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "nekromanten");
  if( !random(3) && caster->QueryProp(P_ALIGN)>-1500) 
    caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)-1);
  return;
}

// Ab und zu gehen Spells einfach so schief, nur auf 7/7 nicht
int SpellSuccess(object caster, mapping sinfo) 
{
  int suc;
  suc=::SpellSuccess(caster, sinfo);
  if(random(4000) || (caster->QueryProp(P_GUILD_LEVEL) != 7 &&
      caster->QueryProp(P_GUILD_CIRCLE) != 7)  )
    return suc;
  return -10000+suc;
}

/* Hier wird geprueft, ob der Spell gesprochen werden darf */
varargs string CheckIfSpellAllowed(object caster, mapping sinfo) 
{
  object ob;
//  if( sinfo[SI_SKILLRESTR_LEARN][P_GUILD_LEVEL] > caster->QueryProp(P_GUILD_LEVEL) )
//    return BS("Dazu reicht Deine Gildenstufe nicht aus!");
  if (caster->QueryProp(P_FROG))
    return "Als Frosch? IDIOT!\n";
  if (caster->QueryProp(P_BLIND) && caster->QueryProp(P_GUILD_LEVEL)<7)
    return BS("Bei allen Niederhoellen! DU BIST BLIND!");
  if(!ob=present(NEKRO_GUILDITEM_ID, caster))
    return("DU VERSAGER! OHNE DEINE MASKE KANNST DU NICHT ZAUBERN!!\n");
  if(ob->QueryProp(P_WORN) != caster) 
    return("DU VERSAGER! OHNE DEINE MASKE KANNST DU NICHT ZAUBERN!!\n");

  if(ob->QueryVersion()!=LAST_GUILDITEM_UPDATE) 
    return(BS("DEINE MASKE BRAUCHT FRISCHE ENERGIE! HOL SIE DIR VON "
          "XARFAI!\n"));

  if(GetAlign(caster) > 500)
    return BS(
      "HARHAR! Mit Deiner Gesinnung sollte man Dich wie die Paladine "
      "aufschlitzen!");   
  if(caster->QueryProp(P_SP)<=0 )
    return "IDIOT! Ohne MAGIEPUNKTE geht gar nichts!\n";
  return 0;
}

object CloneZombie(object corpse, object caster, int succ)
{
  object *ob, zombie;
  int i;
  mapping env;
  string npc;

  env=environment(caster)->QueryProp(P_ENVIRONMENT);
  if( mappingp(env) && (
        (stringp(env[ENV_TERRAIN]) && env[ENV_TERRAIN]== TT_ARCTIC) ||
        (intp(env[ENV_TEMPERATURE]) && env[ENV_TEMPERATURE]<-10)) )
    npc = "eisleiche";
  else if (mappingp(env) && (
        stringp(env[ENV_TERRAIN]) && (env[ENV_TERRAIN]== TT_WATER ||
          env[ENV_TERRAIN]== TT_UNDERWATER)))
    npc = "wasserleiche";
  else
    npc = "zombie";
  zombie=clone_object(NPC + npc);
  zombie->SetZombie(corpse, caster, succ); 
  
  for( i=sizeof(ob=all_inventory(corpse))-1; i>=0; i--) 
    ob[i]->move(zombie,M_GET);
  zombie->command_me("ziehe alles an");
  zombie->move(environment(corpse), M_NOCHECK | M_SILENT);
  corpse->remove(1);

  return zombie;
}

