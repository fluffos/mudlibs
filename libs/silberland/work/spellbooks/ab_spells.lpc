// /spellbooks/ab_spells.c  Die Abenteurergilde
// Im Original von Boing@MorgenGrauen
// Spells
/*
     Lichtblitz: blitz
       zeigt die Raumbeschreibung des Raumes an
       Magiepunkte 3, Stufe 2

       Lichtkugel herbeizaubern: licht  (im Silberland disabled)
         Magiepunkte 5, Stufe 4
         Dauer: Level * 20 Sekunden

     Gegenstaende untersuchen: identifiziere <objekt>
       Wenn P_INFO exisitiert, wird dies ausgegeben
       Ausserdem Ausgabe von P_MATERIAL und, wenn der Spruch
       besonders gut war, P_WEIGHT und P_VALUE
       Magiepunkte 12, stufe 6

     Monster/Gegenstaende einschaetzen: schaetz <name>
       Bei Monstern wird die relative Staerke (LP,WC,AC) sowie deren
       Gesinnung angezeigt, bei Dingen deren ungefaehren Wert sowie
       das ungefaehre Gewicht.
       Magiepunkte 5, Stufe 8

     Pfeilangriff: pfeil <name>
       Schaden maximal 20, Magiepunkte 10, Stufe 11

     Ausweichen: ausweichen
       Geht nur im Kampf, 2-10 Sekunden wird ausgewichen (von Geschick
       und Spell Success abhaengig), in dieser Zeit werden physikalische
       Schaeden gedrittelt
       Magiepunkte 25, Stufe 12

     Feuerball: feuerball <name>
       Schaden maximal 40, Magiepunkte 20, Stufe 15

     Schnelligkeit: schnell
       Gibt fuer eine bestimmte Zeit zusaetzliche Angriffe
       Magiepunkte 50, Stufe 17

*/


// Versionen
// 22-08-1995	Mupfel
// 	Spruchlevel und -kosten fuer AL angepasst, Mupfel 22-08-95
// 	'Licht' aus Copyrightgruenden disablen (im Gildenobjekt)
// 	'Identifiziere' jetzt ab Level 6 statt 8, und 12 statt 15 MP Kosten
// 	'Schaetz'       jetzt ab Level 8 statt 10
// 20-02-1996 	Mupfel
//	Schaden (bei Feuerball, Pfeil) wird angezeigt
// 11-04-1996   Woody
//      Blitz Spruch
// 1996/10/03   Woody
//      schaetz erweitert: Kann auch Dinge einschaetzen, und zeigt
//                         Alignment des Monsters an
// 1996/10/13   Woody
//      schaetz nochmal erweitert: Zeigt bei Dingen auch Gewicht an.
//      Dafuer kostet's jetzt aber auch 5 MP statt 3...
// 1996/11/22   Woody
//      Bei 'blitz' nen Alternativstring fuer Environments ohne int_long()
// 1997/01/18   Woody
//      'licht' auskommentieren (ist nur unnoetiger Code, da eh disabled)
//      Text bei 'blitz' geaendert (Wortwiederholung... :) )
// 1997/04/17   Woody
//      'Units bestehEN aus ....' (identifiziere)
// 1997/07/26   Woody
//      Bugfix beim schaetzen fuer Units (typofix und Bugfix bei Gewicht),
//      neuer Spell 'ausweichen'
// 1997/07/26   Woody
//      Dritteln des Schadens bei 'ausweichen' reicht auch...
//      Ausserdem P_TMP_DEFEND_HOOK setzen, wenn es ein eigener,
//      abgelaufener Eintrag war
// 1997/09/25   Woody
//      Identifizieren ans neue Materialsystem angepasst
// 1997/09/26   Woody
//      'Units bestehEN aus ....' (identifiziere) - "u_req" statt P_AMOUNT
// 1997/09/29   Feyaria
//      Feuerball ist jetzt je nach erfolg unterschiedlich gross
// 1997/10/18   Woody
//      Bei 'identifiziere' auch Kaelte/Hitzeschutz anzeigen
// 1997/10/24   Woody
//      'schaetz' ist beim Gewicht etwas groeber
// 1998/01/28   Woody
//      caster bei Materialliste beruecksichtigen
// 1998/03/02   Feyaria
//      neue Spells: Wuergen, Faustschlag
// 1998/06/21   Woody
//      'ausweichen' kostenmaessig angepasst: 15 MP fix + 1 MP je ausweichen
// 1998/10/20   Woody
