inherit "/std/spellbook";


#include <moving.h>
#include <properties.h>
#include <language.h>
#include <attributes.h>
#include <combat.h>
#include <wizlevels.h>
#include <new_skills.h>
#include <material.h>
#include <ansi.h>
#include "/gilden/druidenzirkel/druiden.h"
#include "/p/daemon/skillmaster/skillmaster.h"
#include "/gilden/druidenzirkel/mysteries.h"
#include "/gilden/berserker/berserker_extern.h"

#define SI_ELEMENT "element"


/* Die Regionen und Domains werden in druiden.h definiert */
/* Prototypen definieren */
nosave int CheckArmour(object caster);
nosave mapping DoSpellModification(string element,object caster,mapping sinfo);
string GetMaterialString(object ob, object caster);
int QueryOwnCreature(object caster, int flag, int what);
object CreateElemental(object caster, int suc, string element);
nosave mixed myhands();
int QueryMetal(object ob);
float CheckElementalItem(object pl, string element);
nosave mixed get_enemies(object caster, int chance);
varargs void write_color(string text,string element,object caster,int bold);
int HasElementalRing(string ele, object pl);
int SpellEnhanceModifier(object caster, string element, int value); 
int present_victim(object victim,object caster);
public int elementalBoost(int n, object caster, mapping sinfo);

nosave string DebugName="";
nosave string DebugWizard="";
nosave string DebugWizardLearn="";
nosave mapping color;


nomask query_prevent_shadow() { return 1; }

void create() 
{
  ::create();
  color=ELEMENT_COLORS;
  SetProp(P_SB_NEW_PREPAREFUNC,1);
  SetProp(P_GLOBAL_SKILLPROPS,
            ([SI_SPELLFATIGUE:2,
              SI_SKILLRESTR_USE: ([SR_FUN:"CheckIfSpellAllowed"]),      
              SI_SKILLLEARN:2,  
              OFFSET(SI_SKILLLEARN): 3, 
              SI_SP_LOW_MSG:BS("Du hast nicht genuegend Magiepunkte, um "
                         +"die Elemente zu beherrschen."),
              SI_TIME_MSG: "Du musst Dich erst wieder konzentrieren.\n",
              SI_SKILLLEARN_ATTRIBUTE: A_INT
            ]));

/*
// Veraenderung der Hand
*/ 
 AddSpell("elementarhand", 0,
          ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 6]), 
            SI_SKILLRESTR_USE:([SR_FREE_HANDS:2,
                                P_GUILD_LEVEL: 6,
                                A_INT: 15]),
            SI_RAW_SPELLCOST: 45,
            SI_SPELLFATIGUE:4,
            SI_PREPARE_TIME:3,
            SI_PREPARE_MSG: "",
            SI_PREPAREFUNC: "elementarhand_check",
            SI_SPELLNAME: "elementarhand",
          ]));

 
/*
// ELMENTARE PFEILE
*/ 
