            SI_SKILLLEARN:5,
            SI_DIFFICULTY: 50,  
            SI_RAW_SPELLCOST: 15,
            SI_SPELLFATIGUE:14,
            SI_PREPARE_TIME:4,
            SI_PREPARE_MSG: "", 
            SI_PREPAREFUNC: "prep_behandle", 
            SI_SPELLNAME: "behandle",
            SI_ELEMENT: HUMUS,
           ]));

 
/*
//  DIV. SPELLS
*/
 
 AddSpell("schaetz", 0, 
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 3]),
            SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 3,
                                A_INT: 12]),
             SI_SKILLLEARN:4,  
             SI_RAW_SPELLCOST: 10,
             SI_SPELLNAME: "schaetz",
             ]));

 AddSpell("feuerwusel",0,
            ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 2]), 
            SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 2,
                                A_INT: 11]),
            SI_SKILLLEARN:4,  
            SI_RAW_SPELLCOST: 20,
            SI_PREPARE_TIME: 2,
            SI_PREPARE_MSG: "", 
            SI_PREPAREFUNC: "prep_feuerwusel",
            SI_SPELLNAME: "feuerwusel",
            SI_ELEMENT: FEUER,
            ]));
 

 AddSpell("erkenne", 0,
          ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 1]),
            SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 1,
                                A_INT: 10]),
            SI_SKILLLEARN:4,  
            SI_RAW_SPELLCOST: 10,
            SI_SPELLNAME: "erkenne",
         ]));
            

 AddSpell("laehme", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 9]),
            SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 9,
                                A_INT: 20]),
            SI_SKILLLEARN:4,  
            SI_DIFFICULTY: 200, 
            SI_RAW_SPELLCOST: 30,
            SI_SPELLFATIGUE: 5,
            SI_PREPARE_TIME:4,
            SI_PREPARE_MSG: "", 
            SI_PREPAREFUNC: "prep_laehme", 
            SI_SPELLNAME: "laehme",
            SI_ELEMENT: HUMUS,
            ]));
             
 AddSpell("elementarpanzer", 0, 
            ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 5]),
            SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 5,
                                A_INT: 14]),
            SI_SKILLLEARN:4,
            SI_DIFFICULTY: 100, 
            SI_RAW_SPELLCOST: 45,
            SI_SPELLFATIGUE: 8,
            SI_PREPARE_TIME:1,
            SI_PREPARE_MSG: "Die elementaren Maechte verdichten sich rund um "
              "Deinen Koerper.\n", 
            SI_PREPAREFUNC: "elementarpanzer_check",
            SI_SPELLNAME: "elementarpanzer",
            ]));

}

public void smashSpellResistance(object caster, object victim, int success) {
  int r, chance;

  if(!objectp(caster) || !objectp(victim)) return;

  if(!HAS_MYSTERY(caster, MYSTERY_SPELL_PENENTRATION)) return; // hat das myterium nicht
  if(victim->QueryProp("druid_spellpenetrated") || victim->QueryProp(P_NOMAGIC) <= 0) return; // wurde bereits gesenkt

  r = random(100);
  chance = success/200;
  if(IS_LEARNER(caster)) {
    tell_object(caster, sprintf("smashSpellResistance :: %d < %d\n", r, chance));
  }

  if(r > chance) return; // nichts passiert

  write_color(BS(sprintf("Dein Zauber zerschmettert die magische Aura von %s.", victim->name(WEM, 2))), ERZ, caster, 1);
  tell_room(ENV(caster), BS(sprintf("Der Zauber von %s zerschmettert die magische Aura von %s.", 
            caster->name(WEM, 1), victim->name(WEM, 2))), ({caster}));

  victim->SetProp(P_NOMAGIC, victim->QueryProp(P_NOMAGIC) - (caster->QueryProp(P_GUILD_LEVEL) + success/1000));
  victim->SetProp("druide_spellpenetrated", 1);
  return;
}

public void petrify(object caster, object victim, int success) {
  if(!objectp(caster) || !objectp(victim) || success < 0) return;

  if(HAS_MYSTERY(caster, MYSTERY_PETRIFICATION) && random(20000) < success && victim->QueryProp("last_petrification") + 10 < time()) {
    environment(caster)->Message(sprintf("%s erstarrt fuer einen Moment zu Stein.\n", victim->Name(WER, 1)), MSGFLAG_VISUAL);
    victim->SetProp(P_DISABLE_ATTACK, 1);
    victim->SetProp(P_DISABLE_SPELLS, 1);
    victim->SetProp("last_petrification", time()); 
  }

  return;
}

public void drown(object caster, object victim, int success) {
  if(!objectp(caster) || !objectp(victim) || success < 0) return;

  if(HAS_MYSTERY(caster, MYSTERY_DROWN) && random(20000) < success && victim->QueryProp("last_drown") + 10 < time()) {
    environment(caster)->Message(sprintf("%s hustet und spuckt Wasser.\n", victim->Name(WER, 1)), MSGFLAG_VISUAL);
    victim->SetProp(P_DISABLE_SPELLS, 1 + random(caster->QueryProp(P_GUILD_LEVEL)/2));
    victim->SetProp("last_drown", time()); 
  }

  return;
}
 
