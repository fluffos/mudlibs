  str = success/1000;

  if(objectp(cloud=present("\ndruid_spore_cloud", environment(caster)))) {
    write_color(BS("Die Sporenwolke wird dichter."), HUMUS, caster, 0);
    tell_room(environment(caster), BS("Die Sporenwolke wird dichter."), ({caster}));
    cloud->AddStrength(str);
  } else {
    cloud = clone_object(OBJ("sporenwolke"));
    if(cloud->move(ENV(caster), M_PUT|M_NOCHECK) != 1) {
      cloud->remove(1);
    }
    cloud->Start(str, caster);
    write_color(BS("Eine gruenlich glitzernde Sporenwolke aus Humuskraft breitet sich um dich aus."), HUMUS, caster, 0);
    tell_room(environment(caster), BS("Eine gruenlich glitzernde Sporenwolke aus Humuskraft breitet sich um "+caster->name(WEM, 1)+" aus."), ({caster}));
  }

  return;
}

