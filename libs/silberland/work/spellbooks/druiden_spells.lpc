varargs void write_color(string text, string element, object caster, int bold)
{
  string farb, tty;
  tty=caster->QueryProp(P_TTY);
  if(!caster->QueryProp(P_DRUID_SPELL_COLORS))
    tty="dumb";
  if( tty=="ansi")
    farb=color[element];
  if( tty=="ansi" || tty=="vt100" )
    write( (farb?farb:"")+(bold?ANSI_BOLD:"")+text[0..<2]+ ANSI_NORMAL+"\n");
  else
    write(text);
}

// Gwenshara: Uberschrieben, damit wir das Mysterium "Zorn der Elemente" triggern koennen
public int TryAttackSpell(object victim, int damage, mixed dtypes, mixed is_spell, object caster, mapping sinfo) {
  int r, chance;
  float upwindBonus;
  string caster_element;
  mapping hit_elements;

  damage = elementalBoost(damage, caster, sinfo);

  if(HAS_MYSTERY(caster, MYSTERY_UPWIND) && sinfo[SI_ELEMENT] == LUFT && 
     mappingp(hit_elements=victim->QueryProp(P_TMP_DRUID_LAST_HIT_ELEMENT)) && member(hit_elements, LUFT)) {
      if(hit_elements[LUFT] > 50) hit_elements[LUFT] = 50;
      upwindBonus = (1.0 + (hit_elements[LUFT]/100.0));
      r = damage;
      damage = (int) (damage * upwindBonus);
      if(IS_LEARNER(caster)) {
        tell_object(caster, sprintf("druiden_spells :: TryAttackSpell :: Upwind :: damage_before=%d bonus=%.2f damage_after=%d\n", r, upwindBonus, damage));
      }
  }
  hit_elements = 0;

  r = ::TryAttackSpell(victim, damage, dtypes, is_spell, caster, sinfo);

  if(HAS_MYSTERY(caster, MYSTERY_LIFELINK) && sinfo[SI_ELEMENT] != EIS && random(18) < caster->QueryProp(P_GUILD_LEVEL) ) {
    write_color(BS("Lebenskraft stroemt in dich zurueck."), HUMUS, caster, 0);
    caster->AddHp(random(r/3));
  }

  if(!objectp(victim)) return r; // opfer tot

  if(HAS_MYSTERY(caster, MYSTERY_ELEMENTAL_WRATH)) {
    chance = 10;
    
    caster_element = call_other(DRUIDENMASTER, "GetDruidElement", caster);
    if(caster_element == sinfo[SI_ELEMENT]) chance += 20;
    else if(COMPLEMENT_ELEMENTS[caster_element] == sinfo[SI_ELEMENT]) chance -= 20;

    chance += caster->QueryAttribute(A_INT) / 2;
    chance += 20-r;

    if(chance > 75) chance = 75;
    if(chance < 5) chance = 5;

    if(IS_LEARNER(caster)) tell_object(caster, sprintf("Wrath :: chance=%d\n", chance));
    if(random(100) < chance && objectp(victim)) {
      write_color( BS(sprintf("Der Zorn der Elemente richtet sich gegen %s!", victim->name(WEN, 1))), sinfo[SI_ELEMENT], caster, 1);
      tell_room(environment(victim), BS(sprintf("Der Zorn der Elemente richtet sich gegen %s!", victim->name(WEN, 1))), ({caster}));
      r += ::TryAttackSpell(victim, (int) (damage*0.66), dtypes, is_spell, caster, sinfo);
    } 
  }

  if(objectp(victim) && r>0 && !query_once_interactive(victim) && sinfo[SI_ELEMENT] == EIS && HAS_MYSTERY(caster, MYSTERY_FROZEN_HEART) && random(100) > victim->QueryProp(P_NOMAGIC)) {
    if(random(150) + victim->QueryAttribute(A_CON) < caster->QueryProp(P_GUILD_LEVEL) + caster->QueryAttribute(A_INT) + r) {
        write_color(BS(sprintf("Dein Zauber trifft %s Mitten ins Herz. %s regeniert nun langsamer.", victim->name(WEN, 1), CAP(victim->QueryPronoun()))), EIS, caster, 1);
        tell_room(environment(caster), BS(sprintf("%s Zauber trifft %s Mitten ins Herz. %s regeneriert nun langsamer.", caster->Name(WESSEN, 1), victim->name(WEN, 1), victim->QueryPronoun())),
                  ({caster}));
        victim->SetProp(P_HP_DELAY, victim->QueryProp(P_HP_DELAY) + 2 + random(caster->QueryProp(P_GUILD_LEVEL)));
    }
  }

  if(objectp(victim) && r > 0 && HAS_MYSTERY(caster, MYSTERY_SHIFTING_CURRENTS) && random(100) > victim->QueryProp(P_NOMAGIC) && 
     !random(20-caster->QueryProp(P_GUILD_LEVEL)) && sinfo[SI_ELEMENT] == WASSER) {
      write_color(BS(sprintf("Dein Zauber trifft %s und spuelt seine magische Aura hinfort. %s ist nun anfaelliger auf Resistenzaenderungen.",
                  victim->name(WEN, 1), CAP(victim->QueryPronoun()))), WASSER, caster, 0);
      victim->SetProp(P_TMP_DRUID_RESISTANCE_PROCC, 1);
  }

  if(objectp(victim) && victim->QueryProp(P_TMP_DRUID_LAST_HIT) + 8 < time()) {
    victim->SetProp(P_TMP_DRUID_LAST_HIT_ELEMENT, 0);
  }
  
  if(objectp(victim) && !mappingp(hit_elements=victim->QueryProp(P_TMP_DRUID_LAST_HIT_ELEMENT))) {
    victim->SetProp(P_TMP_DRUID_LAST_HIT_ELEMENT, ([sinfo[SI_ELEMENT]: 1]));
  } else if(objectp(victim)) {
    hit_elements[sinfo[SI_ELEMENT]]++;
    victim->SetProp(P_TMP_DRUID_LAST_HIT_ELEMENT, hit_elements);
  }

  if(objectp(victim)) victim->SetProp(P_TMP_DRUID_LAST_HIT, time());

  return r;
}

public int elementalBoost(int n, object caster, mapping sinfo) {
  float f;
  object ob;

  if(!member(sinfo, SI_ELEMENT)) return n;

  f = 1.0;
  if(ob=present(DRUID_ID_ELEMENTAL_BOOST(sinfo[SI_ELEMENT]), environment(caster))) f += ob->QueryProp(P_DRUID_ELEMENTAL_BOOST) / 100.0;

  if(IS_LEARNER(caster)) {
    tell_object(caster, sprintf("elementalBoost :: n=%d f=%.2f NxF=%.2f\n", n, f, n*f));
  }

  return (int) (n*f);
}

int HasElementalRing(string ele, object pl) 
{
  object *obs;

  if(IS_WIZARD(pl)) return 1;
  if(member(call_other(DRUIDENMASTER, "QueryLegendary"), getuid(pl))!=-1) 
    return 1;
  obs = filter_array(pl->QueryProp(P_ARMOURS), lambda( ({ 'x }), 
                          ({ #'call_other, 'x, "id", "\nelement_ring_"+ele })));
  if (!sizeof(obs)) return 0;
  if(!obs[0]->check_equip_time()) return 0;
  if(!random(400)) 
  {
    if(SKILLMASTER->UseSkill(pl, SK_LUCK) < 0)
      obs[0]->do_remove();
    else
      tell_object(pl, BS("Wow! Hast Du ein Glueck! Fast haette sich Dein "
            "Elementarring aufgeloest!"));
  }
  return 1; 
}

//Archon 12.08.2003
int present_victim(object victim,object caster)
{
  if (!objectp(victim) || !objectp(caster)) return 0;
  // Selber Raum -> OK
  if (environment(caster) && (environment(victim)==environment(caster)))
    return 1;
  // Opfer im Caster -> OK
  if (environment(victim)==caster) return 1;
  return 0;
}
