private void saveLastSpellElementAndTriggerRegeneration(object caster, string spell, mapping sinfo) {
  string *lastElements, element;
  int differentElements, i;

  element = sinfo[SI_ELEMENT];
  if(!stringp(element)) { // manche zauber (elementarhand, schaetz, panzer, ...) haben kein eigenes element, die bekommen das des casters
    element = call_other(DRUIDENMASTER, "GetDruidElement", caster);
  }

  if(!pointerp(caster->QueryProp(P_TMP_DRUID_LAST_ELEMENT_SPELLS))) {
    caster->SetProp(P_TMP_DRUID_LAST_ELEMENT_SPELLS, ({}));
  }

  lastElements = caster->QueryProp(P_TMP_DRUID_LAST_ELEMENT_SPELLS);

  if(sizeof(lastElements) < 6) {
    lastElements += ({ element });
  } else {
    lastElements = lastElements[2..6] + ({ element });
  }

  caster->SetProp(P_TMP_DRUID_LAST_ELEMENT_SPELLS, lastElements);
  
  if(member(lastElements, LUFT) > -1) differentElements++;
  if(member(lastElements, ERZ) > -1) differentElements++;
  if(member(lastElements, FEUER) > -1) differentElements++;
  if(member(lastElements, WASSER) > -1) differentElements++;
  if(member(lastElements, EIS) > -1) differentElements++;
  if(member(lastElements, HUMUS) > -1) differentElements++;
  if(member(lastElements, GEIST) > -1) differentElements++;
  differentElements--; // das erste zaehlt nicht

  if(differentElements < 1) return;

  if(IS_LEARNER(caster)) {
    tell_object(caster, sprintf("Force Transformator :: p=%O e=%sd =%d\n", lastElements, element, differentElements));
  }

  if(caster->QueryProp(P_TMP_DRUID_FT_UNTIL) == 0) { // so lange das nicht 0 ist, ist bereits eine regeneration aktiv
    call_out("mastery_transform_elemental_forces", 0, caster);
    tell_object(caster, BS("Du beginnst Kraft aus der Wandlung der elementaren Kraefte zu ziehen."));
  }

  caster->SetProp(P_TMP_DRUID_FT_UNTIL, time() + caster->QueryProp(P_GUILD_LEVEL));
  caster->SetProp(P_TMP_DRUID_FT_POTENCY, (int) (differentElements/2));

  return;
}

public void mastery_transform_elemental_forces(object caster) {
  if(time() > caster->QueryProp(P_TMP_DRUID_FT_UNTIL)) {
    tell_object(caster, BS("Die Kraft der elementaren Wandlung ist aufgezehrt."));
    caster->SetProp(P_TMP_DRUID_FT_UNTIL, 0);
    caster->SetProp(P_TMP_DRUID_FT_POTENCY, 0);
    caster->SetProp(P_TMP_DRUID_LAST_ELEMENT_SPELLS, ({})); // wir resetten alles
    return;
  }

  caster->AddSp(caster->QueryProp(P_TMP_DRUID_FT_POTENCY));
  call_out("mastery_transform_elemental_forces", 2, caster);
  return;
}
   

/*
// Man soll auch lernen, wenn der Zauber gelungen ist.
// Der Wert ist vom Skill im Zaubern abhaengig. Eine Ausgabe
// "Du lernst..." erfolgt nicht, die Spieler sollen gefaelligst
// selbst draufkommen
// Weiters besteht die Chance etwas zu verlernen, wenn man mehr
// als 33% MAX_ALC hat
*/

void Erfolg(object caster, string spell, mapping sinfo) 
{
  int new_abil, abil, alc, maxalc, modifier, cast;
  object victim;
  modifier=0;

  if(HAS_MYSTERY(caster, MYSTERY_FORCE_TRANSFORMATOR)) {
    saveLastSpellElementAndTriggerRegeneration(caster, spell, sinfo);
  }
 
  if(sinfo[SI_SKILLARG] && stringp(sinfo[SI_SKILLARG]) && 
      (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
        victim=present(sinfo[SI_SKILLARG], caster)))
  {
    if(victim->id(SID_NOLEARN)) 
      return;
  }
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "druidenzirkel");
  abil=sinfo[SI_SKILLABILITY];
  
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "CheckAbility", caster, spell, 
              sinfo[SI_SKILLABILITY]);
  
  if(alc=caster->QueryProp(P_ALCOHOL)) 
    modifier-=alc/8;
  
  if(!random(20) && abil<MAX_ABILITY) 
  {
    if((cast=caster->QuerySkillAbility("Cast"))>6000)
      modifier+=(cast-6000)/200; 
    new_abil=abil+modifier+random(caster->QueryAttribute(A_INT))/5+1;
    if(new_abil>=MAX_ABILITY) 
    {
      new_abil=MAX_ABILITY;
      caster->Message(sprintf("Anvar teilt Dir mit: Du kannst %s nun absolut perfekt!\n", 
            CAP(spell)), MSGFLAG_TELL);
    }
    caster->ModifySkill(spell, ([SI_SKILLABILITY: new_abil ]), 0, 
        "druidenzirkel");
    if(getuid(caster)==DebugName) 
    {
      TELL(DebugWizardLearn, sprintf("%s lernt %s von %d -> %d\n", 
            capitalize(DebugName), capitalize(spell), abil, new_abil));
    }
  }
  else if(-modifier > random(3)) 
  {
    new_abil=abil+modifier;
    if(new_abil<1) 
      new_abil=1;
    caster->ModifySkill(spell, ([SI_SKILLABILITY: new_abil ]), 0, 
        "druidenzirkel");
  }
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "UpdateAbility", caster, spell, 
        (caster->QuerySkillAbility(spell)));
} 

/*
// Beim Misserfolg verlernt man, wenn man mehr als 25% ALC
// hat.
//
*/
void
Misserfolg(object caster, string spell, mapping sinfo) 
{
  int old_abil,alc, maxalc, modifier, abil, new_abil;
  object victim;

  if(HAS_MYSTERY(caster, MYSTERY_FORCE_TRANSFORMATOR)) {
    caster->SetProp(P_TMP_DRUID_LAST_ELEMENT_SPELLS, ({})); // Fehler setzt MP-Rueckgewinnung zurueck
  }

  if( stringp(sinfo[SI_SKILLARG]) && 
      (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
       (victim=present(sinfo[SI_SKILLARG], caster))))
  {
    if(victim->id(SID_NOLEARN)) 
    {
      printf("Leider lernst Du nicht aus Deinem Fehler.\n");
      return;
    }
  }
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "druidenzirkel");
  alc=caster->QueryProp(P_ALCOHOL);
  maxalc=caster->QueryProp(P_MAX_ALCOHOL);
  modifier=(maxalc/2)-alc;
  old_abil = sinfo[SI_SKILLABILITY];
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "CheckAbility", caster, spell, old_abil);
  if(modifier<0) 
  {
    printf("Du lernscht nix aus <Hicks!> Deinem Fehler.\n");
    abil=old_abil+(modifier/3);
    if(abil<1) abil=1;
    caster->ModifySkill(spell, ([SI_SKILLABILITY: abil ]), 0, "druidenzirkel");
    new_abil=caster->QuerySkillAbility(spell);
    if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
      call_other(ABILMASTER, "UpdateAbility", caster, spell, new_abil);
    return;
  }
  Learn(caster, spell, sinfo);
  new_abil=caster->QuerySkillAbility(spell);
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "UpdateAbility", caster, spell, new_abil);
  if (old_abil < new_abil) 
  {
    printf("Du lernst aus Deinem Fehler.\n" ); 
    if(new_abil==MAX_ABILITY)
      caster->Message( "Anvar teilt Dir mit: Du kannst "+capitalize(spell)+
          " nun absolut perfekt!\n", MSGFLAG_TELL);
  }
  else 
    printf( "Leider lernst Du nicht aus Deinem Fehler.\n" );
  return;
}

