/* Fuer den Elementarruestung-Spell */
nosave int CheckArmour(object caster) 
{
 object *worn_armours;
 int i;
 worn_armours=caster->QueryProp(P_ARMOURS);
 if(sizeof(worn_armours)==0) return 0;
 for(i=sizeof(worn_armours)-1;i>=0;i--)
   if(worn_armours[i] && (worn_armours[i]->QueryProp(P_ARMOUR_TYPE))==AT_ARMOUR)
     return 1;
 return 0;
}


nosave mapping
DoSpellModification(string element,object caster,mapping sinfo) {
  mapping t_env, element2domain, element2terrain, element2compele;
  string *filename, caster_element, comp_element, elemental_room;
  string *d_domain, *d_komp_domain, *race_elements;
  int *t_type, *t_comp_type, align, kosten, var;
  int factor;
  float cost_modifier, damage_modifier, fatigue_modifier, hmod;
  object amulett;
 
  element2domain=ELEMENT2DOMAINS;
  element2terrain=ELEMENT2TERRAIN;
  element2compele=COMPLEMENT_ELEMENTS;
  cost_modifier=1.0;
  damage_modifier=1.0;
  fatigue_modifier=1.0;
  kosten=sinfo[SI_RAW_SPELLCOST];
  amulett=present(DRUIDENAMULETT, caster);
  race_elements=({});
  t_env=environment(caster)->QueryProp(P_ENVIRONMENT);
  filename=explode(file_name(environment(caster)), "/");
  
  align=caster->QueryProp(P_ALIGN);
  elemental_room=ENV(caster)->QueryProp(P_ELEMENTAL_ROOM);
  if(!elemental_room) elemental_room="default";

  switch(caster->QueryProp(P_RACE)) {
    case "Zwerg": race_elements=E_DWARF; break;
    case "Elf"  : race_elements=E_ELF; break;
    case "Mensch": race_elements=E_HUMAN; break;
    case "Hobbit": race_elements=E_HOBBIT; break;
    case "Dunkelelf": race_elements=E_DARKELF; break;
    case "Oger": race_elements=E_OGRE; break;
    case "Fee": race_elements=E_FAIRY; break;
    case "Gaffo": race_elements=E_GAFFO; break;
    default: race_elements=E_DEFAULT;            
  }

  d_domain=element2domain[element];
  t_type=element2terrain[element];
  comp_element=element2compele[element];
  d_komp_domain=element2domain[comp_element];
  t_comp_type=element2terrain[comp_element];

  if(getuid(caster)==DebugName) {
    TELL(DebugWizard, sprintf("t_env: %O\nt_type: %O\nelemental_room:%O\n"
       "comp ele room: %O\ncaster_element:%O\nelement2terrain func: %O\n"
       "element2domain func: %O\n", 
       t_env[ENV_TERRAIN], t_type, elemental_room, 
       element2compele[elemental_room], caster_element, 
       element2terrain[elemental_room], element2domain[elemental_room]));
  }

  // TERRAIN
  if (caster_element=="geist" && !random(2) && amulett->QueryGhost())
    factor=-1;
  else if (elemental_room == caster_element && elemental_room == element)
    factor=-3;
  else if (elemental_room == element) 
    factor=-2;
  else if (elemental_room == caster_element) 
    factor=-1;
  else if (elemental_room == comp_element)
    factor=2;
  else if (elemental_room == element2compele[caster_element])
    factor=1;
  else if (member_array(t_env[ENV_TERRAIN], t_type)!=-1)
    factor=-2;
  else if (member_array(t_env[ENV_TERRAIN], t_comp_type)!=-1)
    factor=2;
  else
    factor=0;
  cost_modifier+=0.05*factor;
  damage_modifier-=0.05*factor;
  fatigue_modifier+=0.05*factor;
  
  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("TP:%s, SP: %s, Ter:%.4f, ", DebugName, 
          sinfo[SI_SPELLNAME],cost_modifier));

  // REGION
  if(!filename[1])
    factor=0;
  else if (caster_element=="geist" && !random(2) && amulett->QueryGhost())
    factor=-1;
  else if (elemental_room == element)
    factor=-1;
  else if (elemental_room == comp_element)
    factor=1;
  else if (member_array(filename[1], d_domain)!=-1)
    factor=-1;
  else if (member_array(filename[1], d_komp_domain)!=-1)
    factor=1;
  else
    factor=0;
  cost_modifier+=0.1*factor;
  damage_modifier-=0.1*factor;
  fatigue_modifier+=0.1*factor;

  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Reg:%.4f, ", cost_modifier));


  //RASSEN
  if(race_elements && caster_element!="geist") {
    if(member_array(element, race_elements[0])!=-1) {
      cost_modifier+=-0.15;
      fatigue_modifier+=-0.1;
    }
    else if(member_array(element, race_elements[1])!=-1){
      cost_modifier+=0.15;
      fatigue_modifier+=0.1;
    }
  }
  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Ras: %.4f, ", cost_modifier));

  //ELEMENT
  if(element==caster_element || (caster_element=="geist" && amulett->QueryGhost() && !random(2))) 
  {
    if(HAS_MYSTERY(caster, MYSTERY_SPECIALISATION)) {
      cost_modifier    += -0.4;
      damage_modifier  +=  0.25;
      fatigue_modifier += -0.25;
    } else {
      cost_modifier    += -0.25;
      damage_modifier  +=  0.2;
      fatigue_modifier += -0.2;
    }
  }
  else if(comp_element==caster_element && caster_element!="geist") {
    if(HAS_MYSTERY(caster, MYSTERY_SPECIALISATION)) {
      cost_modifier    +=  0.4;
      damage_modifier  += -0.25;
      fatigue_modifier +=  0.25;
    } else {
      cost_modifier    +=  0.25;
      damage_modifier  += -0.2;
      fatigue_modifier +=  0.2;
    }
  }

  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Ele: %.4f, ", cost_modifier));
  // MAGIC ITEM
  cost_modifier-=CheckElementalItem(caster,element);
  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Item: %.4f, ", cost_modifier));
  //ALIGN
  if((align<-500) || (align>500)) {
    align=(align<0?-align:align);
    cost_modifier+=((float)align-500)/1000; 
  }
  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Ali: %.4f, ", cost_modifier));
  // HOHE INT
  if((factor=caster->QueryAttribute(A_INT))>30) {
    // Int 31: 0.0155, 35:0.0875, 40: 0.2, die haelfte mehr beim Schaden
    cost_modifier-=((float)factor*(factor-30))/2000.0;
    damage_modifier+=((float)factor*(factor-30))/1333.0;
  }
  else
    factor = 0;
  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Int: %.4f, ", cost_modifier));

  // TEMPERATUR
  if( element == FEUER && t_env[ENV_TEMPERATURE] >= 35 ) {
    cost_modifier-=0.05;
    damage_modifier+=0.05;
  } 
  else if( element == EIS && t_env[ENV_TEMPERATURE] < 0 ) {
    cost_modifier-=0.05;
    damage_modifier+=0.05;
  }

  // Heisse und kalte fusion
  if(HAS_MYSTERY(caster, MYSTERY_HOT_FUSION) && t_env[ENV_TEMPERATURE] > 20) {
    cost_modifier -= (t_env[ENV_TEMPERATURE]-20)/90.0;
  }

  if(HAS_MYSTERY(caster, MYSTERY_COLD_FUSION) && t_env[ENV_TEMPERATURE] < 20) {
    cost_modifier += (t_env[ENV_TEMPERATURE]-20)/210.0;
  }

  // maximal und minimalschranken
  if(cost_modifier<0.35) cost_modifier=0.35;
  if(cost_modifier>1.5) cost_modifier=1.5;
  
  if(caster->QueryProp(P_BLIND)) 
    cost_modifier+=0.5;
  
  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Bli&Temp: %.4f, ", cost_modifier));
  
  if(var=amulett->QueryWornMetal()) {
    cost_modifier+=(float)var/1000;
    fatigue_modifier+=(float)var/1500;  
  }
  kosten=(int)(kosten*cost_modifier);
  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Met: %.4f, SP/SP_old: %d/%d\n", cost_modifier, kosten, 
          sinfo[SI_RAW_SPELLCOST]));
  if(caster->QueryProp(P_GUILD_LEVEL)>14)
    if(sinfo[SI_RAW_SPELLCOST] > 40)
      kosten-=caster->QueryProp(P_GUILD_LEVEL)-14;
  
  sinfo[SI_RAW_SPELLCOST]=kosten; 

  // zauberabwehr durchrechen 
  if(caster->QueryProp(P_GUILD_LEVEL)==15) 
    sinfo+=([SI_NOMAGIC: 5 + random(factor - 25)]); // 30 int: 10, 40 int: 20
  if(caster->QueryProp(P_GUILD_LEVEL)==16)
    sinfo+=([SI_NOMAGIC: 10 + random((factor - 25) * factor / 15)]);  //30 int: 20, 40 int: 50

  if(HAS_MYSTERY(caster, MYSTERY_PHYSICAL_SPELLS) && sinfo[SI_ELEMENT] == ERZ) {
    sinfo[SI_NOMAGIC] = 100;
  }

  if(IS_LEARNER(caster)) {
    tell_object(caster, sprintf("nomagic: %d\n", sinfo[SI_NOMAGIC]));
  }

  if(sinfo[SI_SKILLDAMAGE]) {
    sinfo[SI_SKILLDAMAGE]=SpellEnhanceModifier(caster, element, 
        sinfo[SI_SKILLDAMAGE]);
    if(damage_modifier<0.5) damage_modifier=0.5;
    if(damage_modifier>1.5) damage_modifier=1.5;
    sinfo[SI_SKILLDAMAGE]=(int)(sinfo[SI_SKILLDAMAGE]*damage_modifier);
    if( amulett = present( DRUIDEN_FOCUS+element, caster) )
      sinfo = amulett->Focus(caster, sinfo);
  } 
  if(getuid(caster)==DebugName)
    TELL(DebugWizard, sprintf("Fatigue: %d, mod: %.4f -> %d\n", 
        sinfo[SI_SPELLFATIGUE], fatigue_modifier,
        to_int(sinfo[SI_SPELLFATIGUE] * fatigue_modifier)));
  if(!sinfo[SI_SPELLFATIGUE]) sinfo[SI_SPELLFATIGUE]=2;
  if((sinfo[SI_SPELLFATIGUE]=(int)(sinfo[SI_SPELLFATIGUE]*fatigue_modifier))<2)
        sinfo[SI_SPELLFATIGUE]=2;

  if(HAS_MYSTERY(caster, MYSTERY_BREATHING_TECHNIQUE)) {
    sinfo[SI_SPELLFATIGUE] = (int) (sinfo[SI_SPELLFATIGUE] / caster->QueryProp(P_GUILD_LEVEL) * 0.13);
    if(sinfo[SI_SPELLFATIGUE] < 1) {
      if(caster->QueryProp(P_DRUID_LAST_SPELL) == time()) {
        sinfo[SI_RAW_SPELLCOST] *= 2;
        sinfo[SI_SPELLFATIGUE] = 1;
      }
    }
    sinfo[SI_PREPARE_TIME] = (int) (sinfo[SI_PREPARE_TIME] / caster->QueryProp(P_GUILD_LEVEL) * 0.13);
  }
  return sinfo;
}

int SpellEnhanceModifier(object caster, string element, int value) 
{
  object ob;
  ob=present(DRUIDEN_SPELL_ENHANCE, caster);
  if(!ob) 
    return value;
  if(ob->GetElement() != element)
    return value;
  value=(int)(value*DRUID_ENHANCEMENT); // 10% Verstaerkung des Wertes
  return value;
}

float CheckElementalItem(object pl, string element) {
  object *obj;
  int i, value;
  mixed h;
  value=0;
  if(!objectp(pl)) return 0.0;
  obj=pl->QueryProp(P_ARMOURS);
  if(!sizeof(obj)) return 0.0;
  for(i=sizeof(obj)-1;i>=0;i--) {
    if(objectp(obj[i]) && (h=obj[i]->QueryProp(P_ITEMD_ELEMENTAL_VALUE))) {
      if(intp(h) ) value+=h;
      else if( mappingp(h) ) {
        if (member(h, element))
          value+=h[element];
        else
          value+=h["all"];
      }
    }
  }
  return value/100.0;
}

/* Hier wird geprueft, ob der Spell gesprochen werden darf */
nosave CheckIfSpellAllowed(object caster) 
{
  object ob, weapon, *armours;
  int var;
  if(caster->QueryProp(P_FROG)) 
  {
    printf(BS("Wahhhhhh. Ein Frosch! Als Frosch kannst Du "
        +"nicht zaubern!\n"));
    return "";
  }
  if(caster->QueryProp(P_GHOST)) 
  {
    printf(BS("Buaaahhhhh. Ein Geist! Als Geist kannst Du "
        +"nicht zaubern!\n"));
    return "";
  }
  /*
  if(caster->QueryProp(P_BLIND) && caster->QueryProp(P_GUILD_LEVEL)<16) { 
    printf(BS("Blind kannst Du nicht zaubern!\n"));
    return "";
  }
  */
  if(!ob=present(DRUIDENAMULETT, TP)) 
  {
    printf(BS("Ohne das Druidenamulett kannst Du nicht zaubern!\n"));
    write_secure_log(sprintf("%s versucht ohne Amulett zu zaubern!\n", 
          CAP(getuid(caster))));
    return "";
  }
  if(interactive(caster) && ob->QueryVersion()!=LATEST_AMULET_VERSION) 
  {
    printf(BS("Dein Amulett scheint abgenutzt zu sein! Du solltest "
         "Dir ein Neues von Anvar holen! (frag anvar nach neuem amulett)"));
    return ""; 
  }
  if((var=QueryMetal(caster)) > (caster->QueryProp(P_GUILD_LEVEL)*20)) 
  {
    printf("Mit soviel Metall am Koerper kannst Du nicht zaubern!\nDer "
        "Versuch zu Zaubern erschoepft Dich!\n");
    caster->AddHp(-random(20));
    caster->SetProp(P_NEXT_SPELL_TIME, time()+(int)var/10);
    ob->SetWornMetal(var); // uebergeben des Metalls an das Amulett
    return "";
  }
  ob->SetWornMetal(var); // uebergeben des Metalls an das Amulett
  if(ob->QueryProp(P_WORN)!=caster) 
  {
    printf(BS("Du musst das Amulett schon tragen, wenn Du zaubern "
        "willst"));
    return "";
  }
  if(interactive(caster) && !IS_WIZARD(caster) &&
     !call_other(DRUIDENMASTER, "CheckPreviousTasks", caster,
     caster->QueryProp(P_GUILD_LEVEL)-1) && 
     !caster->QueryProp(P_TESTPLAYER))
  {
   //printf(BS("Du kannst nicht zaubern! Komisch, oder?\n"));
    if(find_player("angrox"))
      tell_angrox(sprintf("%s hat nicht alle Aufgaben fuer Level %d!\n", 
          CAP(getuid(caster)), caster->QueryProp(P_GUILD_LEVEL)));
     write_secure_log(sprintf("%s hat nicht alle Aufgaben fuer Level %d!\n", 
          CAP(getuid(caster)), caster->QueryProp(P_GUILD_LEVEL)));
  } 
  return 0;
}

// 
// Ueberpruefen auf verbotenes metall
// Es kann sowohl ein Living wie auch ein Objekt angegeben werden.
// Rueckgabewert: Metall in Gramm;
//
int QueryMetal(object ob) 
{
  object *items;
  int total_metal, i,j,x,rtn;
  mapping mat_map;
  string *mat, *fm;
  fm=FORBIDDEN_METAL;
  items=({});
  if(living(ob)) {
    items=({ ob->QueryProp(P_WEAPON) });
    if(sizeof(ob->QueryProp(P_ARMOURS)))
      items+=ob->QueryProp(P_ARMOURS);
    items-=({0});
  }
  else items+=({ob});
  if(!sizeof(items)) return 0;
  for(i=sizeof(items)-1;i>=0;i--) {
    if(items[i]->QueryMaterialGroup(MATGROUP_METAL) &&
        !items[i]->id(DRUID_ALLOWED_METAL_ITEM)) 
    {
      mat_map=items[i]->QueryProp(P_MATERIAL);
      mat=m_indices(mat_map);
      for(j=sizeof(mat)-1;j>=0;j--) {
        if((x=member(fm, mat[j]))!=-1)
          total_metal+=(int)((float)(items[i]->QueryProp(P_WEIGHT)/100)*
            mat_map[fm[x]]);
      }
    }          
  }

  if(HAS_MYSTERY(ob, MYSTERY_IRON_AURA)) {
    return total_metal - ob->QueryProp(P_GUILD_LEVEL) * 200;
  }

  return total_metal; // getragenes Metall in Gramm
}

/*Was besteht woraus?*/
string GetMaterialString(object ob, object caster) {
  string *mat_indices, *mat_values, result;
  mapping material;
  int i;

  result=CAP(ob->QueryPronoun(WER))+(ob->IsPlural()?" bestehen ":" besteht ");
  material=ob->QueryProp(P_MATERIAL);
  if(!material || !mappingp(material))
    return "aus einer voellig unbekannten Materie";
  mat_values=m_values(material);
  mat_indices=m_indices(material);
  for(i=sizeof(mat_values)-1; i>=0; i--) {
    switch(mat_values[i]) {
      case -100..-1: result+="aus Anti-";
                         break;
      case 0: continue;
            case 1..20:  result+="zu einem geringen Anteil aus ";
                        break;
      case 21..40: result+="zu einem maessigen Anteil aus ";
                        break; 
      case 41..60: result+="etwa zur Haelfte aus "; 
                        break;
      case 61..80: result+="zum Grossteil aus ";
                        break;
      case 81..99: result+="fast ausschliesslich aus ";
                        break;
      case 100:    result+="vollstaendig aus ";
                        break;
      default:     result+="zu einem undefinierbaren Anteil aus ";
    }        
    result+=MATERIALDB->MaterialName(mat_indices[i],WEM,caster);
    if(i>1) result+=", ";
    else if(i==1) result+=" und ";
    else if(i==0) result+=".";
  } 
  return result;
}



/*
// Hier wird das Elementar geclont und die Werte berechnet
*/
object CreateElemental(object caster, int suc, string element) 
{
  object e;

  e=clone_object(NPC("elementar"));
  e->Customize(element, caster, suc);
  return e;
}

/*
//
// Ueberpruefung ob schon eine eigene Kreatur da ist 
//
*/
int QueryOwnCreature(object caster, int flag, int what) 
{
  object *inv;
  int i, value;
  string ident;
  if (!objectp(caster) || !pointerp(caster->QueryPursuers()))
    return -1;
  value=0;
  if(!flag)
    ident="elementar";
  else ident="feuerwusel";
  inv=filter_array(all_inventory(ENV(caster)), "filter_func", TO, ident);
  inv+=filter_array(caster->QueryPursuers(), "filter_func",TO,ident);
  //TELL("angrox", sprintf("%O\n", inv));
  for(i=sizeof(inv)-1;i>=0;i--) 
  {
    if(objectp(inv[i]) && living(inv[i]) && inv[i]->QueryProp(P_IDS) &&
       member(inv[i]->QueryProp(P_IDS), ident)!=-1)
      switch(what) 
      {
        // Es steht schon ein Teil von dem caster rum
        case 0:if(inv[i]->QueryProp(ELEMENTAL_CASTER)==caster)
                       value++;
               break;
        // Das ist sein eigenes Teil
        case 1:if(inv[i]->QueryProp(ELEMENTAL_OWNER)==caster)
                       value++;
               break;
        // Er hat hat schon ein Teil
        // 1999-12-13: Ein verschenktes elementar hindert nichtmehr
        //             am beschwoeren eines neuen <iwo>
        case 2:if((!inv[i]->QueryProp(ELEMENTAL_OWNER) 
                    && inv[i]->QueryProp(ELEMENTAL_CASTER)==caster) ||
                  inv[i]->QueryProp(ELEMENTAL_OWNER)==caster)
                       value++;
               break;
      } 
  } 
//  if(value>1) 
//     write_secure_log(sprintf("%d %s , CST: %O, ENV:%O\n", value, 
//         CAP(ident), caster, environment(caster)));
  return value;
}


int filter_func(object ob, string ident) 
{
  if(ob->id(ident)) return 1;
  return 0;
}

//
// Gegner fuer Area Spells, mindestens aber einer!
//
nosave mixed get_enemies(object caster, int chance) 
{
  object *all_enemies;
  object *enemies;
  int i;
  enemies=({});
  all_enemies=FindGroupP(caster, -1, 100);
  if (!sizeof(all_enemies)) return ({});
  enemies+=({all_enemies[0]});
  all_enemies-=({all_enemies[0]});
  for (i=sizeof(all_enemies)-1;i>=0;i--) 
    if(random(100)<=chance) enemies+=({all_enemies[i]});
  //TELL("angrox", sprintf("druid_spells(get_enemies): chance=%d\nenemies=%O\n",
  //      chance, enemies));
  return enemies;
}


// hier ueberschrieben fuer "Meister der Zauberei" und anderen Talenten
#define SMUL(x,y) ((x<0 && y<0)?(-1*x*y):(x*y))
int SpellSuccess(object caster, mapping sinfo) {
  int suc, r;
  float refund;
  int cval,abil,res, *sp_count, diff, chance;
  mapping env;

  abil=sinfo[SI_SKILLABILITY];
  cval=(int)caster->UseSkill(SK_CASTING);
  suc=abil + (SMUL(abil,cval)) / MAX_ABILITY - 
      random(MAX_ABILITY-(abil==MAX_ABILITY?2000:0));
  
  //suc = spellbook::SpellSucces(caster, sinfo);

  r = random(10000);
  if(HAS_MYSTERY(caster, MYSTERY_MASTER_SORCERER) && suc > 0) {
    if(IS_LEARNER(caster)) {
      tell_object(caster, sprintf("MASTER_SORCERER: %d < %d\n", r, suc));
    }

    if(r < suc) {
      // je mehr erfolg, desto hoeher die chance auf reduzierte kosten -> bedeutet SP zurueck geben, da ueberschreiben von sinfo hier nicht geht
      refund = (suc/20000.0);
      if(refund > 0.5) refund = 0.5;
      call_out("mastery_refund_sp", 0, caster, sinfo[SI_RAW_SPELLCOST]*refund);
    }
  }

  if(HAS_MYSTERY(caster, MYSTERY_SPORES) && suc > 0 && sinfo[SI_ELEMENT] != EIS) {
    chance = caster->QueryProp(P_GUILD_LEVEL) * 2 + suc/1000;
    if(sinfo[SI_ELEMENT] == HUMUS) chance += 25;
    else if(sinfo[SI_ELEMENT] == FEUER) chance -= 10;
    else if(sinfo[SI_ELEMENT] == WASSER) chance += 10;

    if(random(100) < chance) {
      call_out("activateSpores", 0, caster, suc);
    }
  }

  if(HAS_MYSTERY(caster, MYSTERY_FREEZE) && suc > 0) {
    chance = caster->QueryProp(P_GUILD_LEVEL) * 2 + suc/1000;
    if(sinfo[SI_ELEMENT] == EIS) chance += 25;
    else if(sinfo[SI_ELEMENT] == FEUER) chance -= 10;
    else if(sinfo[SI_ELEMENT] == WASSER) chance += 10;
    else if(sinfo[SI_ELEMENT] == HUMUS) chance -= 25;

    if(random(100) < chance) {
      call_out("activateFreeze", 0, caster, suc);
    }
  }

  if(HAS_MYSTERY(caster, MYSTERY_HOT_SPOTS) && suc > 0) {
    env = ENV(caster)->QueryProp(P_ENVIRONMENT);
    if(!env) env = ([]);
    
    // nur, wenn wir nicht im wasser sind
    if(env[ENV_TERRAIN] != TT_WATER && env[ENV_TERRAIN] != TT_UNDERWATER) {
      chance = caster->QueryProp(P_GUILD_LEVEL) * 2 + suc/1000;
      if(sinfo[SI_ELEMENT] == FEUER) chance += 25;
      else if(sinfo[SI_ELEMENT] == EIS) chance -= 20;
      else if(sinfo[SI_ELEMENT] == WASSER) chance -= 33;
      else chance -= 10;

      if(random(100) < chance) {
        call_out("activateHotspot", 0, caster, suc);
      }
    }
  }

  if(HAS_MYSTERY(caster, MYSTERY_WALL_OF_STONE) && suc > 0 && sinfo[SI_ELEMENT] == ERZ) {
    if(IS_LEARNER(caster)) {
      tell_object(caster, sprintf("stone slab :: 1:%d\n", 20 - caster->QueryProp(P_GUILD_LEVEL)));
    }
    if(!objectp(present(ID_STONESLAB, ENV(caster))) && !random(20 - caster->QueryProp(P_GUILD_LEVEL))) {
      call_out("createStoneslab", 0, caster, suc);
    }
  }

  if(HAS_MYSTERY(caster, MYSTERY_RAIN) && suc > 0 && sinfo[SI_ELEMENT] == WASSER) {
    chance = caster->QueryProp(P_GUILD_LEVEL) * 2 + suc/1000;
    if(sinfo[SI_ELEMENT] == WASSER) chance += 25;
    else if(sinfo[SI_ELEMENT] == ERZ) chance -= 10;
    else if(sinfo[SI_ELEMENT] == EIS) chance += 10;
    else if(sinfo[SI_ELEMENT] == FEUER) chance -= 25;

    if(random(100) < chance) {
      call_out("activateRain", 0, caster, suc);
    }
  }

  if(HAS_MYSTERY(caster, MYSTERY_WEATHER_MASTERY) && suc > 0 && sinfo[SI_ELEMENT] == LUFT) {
    chance = caster->QueryProp(P_GUILD_LEVEL) * 2 + suc/1000;
    if(sinfo[SI_ELEMENT] == LUFT) chance += 25;
    else if(sinfo[SI_ELEMENT] == ERZ) chance -= 25;

    if(random(100) < chance) {
      call_out("activateStorm", 0, caster, suc);
    }
  }

  caster->SetProp(P_DRUID_LAST_SPELL, time());

  return suc;
}

public void createStoneslab(object caster, int success) {
  object slab;

  slab = clone_object(OBJ("stoneslab"));
  if(!slab->SetOwner(caster, success/1000)) {
    slab->remove(1);
  }
  
  return;
}

public void activateStorm(object caster, int success) {
  object cloud;
  int str;

  str = success/1000;

  if(objectp(cloud=present(ID_WEATHERMASTERY, environment(caster)))) {
    cloud->AddStrength(str);
  } else {
    cloud = clone_object(OBJ("gewitter"));
    if(cloud->move(ENV(caster), M_PUT|M_NOCHECK) != 1) {
      cloud->remove(1);
    }
    cloud->Start(str, caster);
    write_color(BS("Nach deinem Zauber bleibt ein steter Wind zurueck."), LUFT, caster, 0);
    tell_room(environment(caster), BS("Ein Wind, ausgehend von "+caster->name(WEM, 1)+", hebt an."), ({caster}));
  }

  return;
}

public void activateSpores(object caster, int success) {
  object cloud;
