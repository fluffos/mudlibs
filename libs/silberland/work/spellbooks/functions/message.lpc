// Erleichterung der Ausgabe
nosave varargs int Message(object caster, object victim, string msg, int flag);


nosave varargs int
Message(object caster, object victim, string msg, int flag) {
  if(!objectp(caster)) caster=TP;
  if(!msg) return 0;
  if(!objectp(victim) && (flag==1 || flag==2)) return 0;
  switch(flag) {
    case 0: catch(tell_object(caster, msg));
            break;
    case 1: tell_object(victim, msg);
            break;
    case 2: if(ENV(caster))
              tell_room(ENV(caster), msg, ({caster, victim}));
            break;
    case 3: if(ENV(caster))
              tell_room(ENV(caster), msg, ({caster}));
            break;
    case 4: if(ENV(caster))
              tell_room(ENV(caster), msg, ({victim}));
            break;
    default: raise_error("Fehler in Message() ("+file_name(ME)+")");
  }
  return 1;
}
