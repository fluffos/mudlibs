// Prototypen
int wundenblick(object caster, mapping sinfo);



int wundenblick(object caster, mapping sinfo) {
  int suc, percent, hp, max_hp,i;
  object *liv;
  string str;

  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so keine Lebewesen "
         "erkennen!\n"),0);
    return 0;
  }

  if (ENV(caster) && ENV(caster)->_query_total_light() < 1) {
    Message(caster,0,
      BS("Bei Dusty, hier ist es VIEL zu dunkel dafuer!\n"),0);
    return 0;
  }

  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du flehst Dusty leise an, Dir die Wunden aller "
      +"im Raum zu zeigen...\n", 0);
  if((suc=SpellSuccess(caster,sinfo))<=0) {
    Message(caster, 0, "Dusty scheint Deine Gebete nicht zu erhoeren!\n", 0);
    return MISSERFOLG;
  }
  if(!ENV(caster)) {
    Message(caster, 0, "Bei Dusty, das funktioniert hier nicht!\n", 0);
    return ERFOLG;
  }
  liv=filter_array(all_inventory(ENV(caster)), #'living);
  Message(caster,0,
    BS("Du kannst mit goettlicher Hilfe folgendes erkennen:"),0);
  Message(caster,0, BS("------------------------------------------------"
                       "------------------------------"), 0);
  for(i=sizeof(liv)-1;i>=0;i--) {
    if (liv[i]->QueryProp(P_INVIS)) continue;
    if (caster->InFight())
      if (!interactive(liv[i]) && !liv[i]->IsEnemy(caster)) continue;
    str=sprintf(" %-10s",liv[i]->Name(WER));
    if(call_other(NPCMASTER, "IsPaladinEnemy", liv[i]))
      str+="ist ein Feind der Paladine!";
    else if(present("DANTE_ZOMBIE_VIRUS", liv[i]))
      str+="hat sich mit dem Zombievirus infiziert!";
    else {
      hp=liv[i]->QueryProp(P_HP);
      if (hp < 0) hp=0;
      max_hp=liv[i]->QueryProp(P_MAX_HP);
      if (max_hp < 1) max_hp=1;
      percent=100*hp/max_hp;
      str+=perc2str(percent);
    }
    Message(caster, 0, BS(str), 0);
  }
  Message(caster,0, BS("------------------------------------------------"
                       "------------------------------"), 0);
  return ERFOLG;
}


