// Prototypen
int prep_eifer(object caster, mapping sinfo);
int eifer(object caster, mapping sinfo);




int prep_eifer(object caster, mapping sinfo) {
  mixed h;
  object *armour;
  int i;
  if (sinfo[SI_SKILLARG] != 0 && sinfo[SI_SKILLARG] != "") {
    write(BS("Der goettliche Eifer kann nur auf Dich wirken, Paladin!"));
    return 0;
  }
  if(caster->QueryProp(P_TMP_ATTACK_HOOK)) {
    Message(caster, 0, BS("Paladin! Du kannst Dich im Moment nicht in goettlichen "
          "Eifer versetzen!"),0);
    return 0;
  }
  if(interactive(caster) && present("\neifer", caster)) {
    Message(caster, 0, BS("Paladin! Du befindest Dich bereits im goettlichen Eifer!"),0);
    return 0;
  }
  if(interactive(caster) && GetAlign(caster)<0) {
    write("Frevler! Mit Deiner Gesinnung wird Dusty Dich NIE erhoeren!\n");
    DoFailure(caster, 1);
    return 0;
  }
  return 1;
}


int eifer(object caster, mapping sinfo) {
  object eifer;
  int suc,d_time,align;
  string cn;

  if( !prep_eifer( caster, sinfo) ) return 0;

  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, "Nichts passiert! Du fuehlst Dich verausgabt.\n", 0);
    return MISSERFOLG;
  }
  cn=caster->Name(WER);
  Message(caster, 0,  
      "Du fuehlst die Macht Dusty's durch Dich stroemen!\n"
      "Du rufst: Herrin Dusty!\n"+
      BS("Du rufst: Deine Hand fuehre mein Schwert gegen die Ausgeburt der "
      "Unterwelt!")+
      BS("Du rufst: Deine goettliche Kraft lasse mich diesen Kampf bestehen!")+
      "Du rufst: Dein Wille fuehre mich zum Sieg!\n\n"
      "Du rufst voller Inbrunst: FUER DUSTY!\n", 0);
  Message(caster, 0, sprintf(
        BS("%s ruft:  Deine Hand fuehre mein Schwert gegen die Ausgeburt "
          "der Unterwelt!")+
        BS("%s ruft: Deine goettliche Kraft lasse mich diesen Kampf "
          "bestehen!")+
        BS("%s ruft: Dein Wille fuehre mich zum Sieg!")+
        "%s ruft voller Inbrunst: FUER DUSTY!\n"
        "%s bekommt einen durchdringenden Blick!\n"
        ,cn,cn,cn,cn,cn)
      ,3);
  eifer=clone_object(OBJ("eifer"));
  eifer->move(caster,M_NOCHECK);
  d_time=(40*suc/MAX_ABILITY)+30+random(20);
  d_time=DoModificationByAlign(d_time, caster);
  caster->SetProp(P_TMP_ATTACK_HOOK,({time()+d_time+10,eifer,"MultipleAttack"}));
  eifer->start_remove(d_time+10);
  return ERFOLG;
}


