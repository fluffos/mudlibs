int auferstehung(object caster, mapping sinfo) {
  object victim, pl, ob, stein;
  int hands, suc, heal, hp, max_hp, percent;
  int f_hands, needed_money, max;

  victim=FindVictim(sinfo[SI_SKILLARG],caster,
              BS("Wen willst Du mit der Macht Dustys wiederauferstehen "
                "lassen?"));
  if (!victim || (victim && victim->QueryProp(P_INVIS)))
    return 0;
  f_hands=caster->QueryProp(P_MAX_HANDS)-caster->QueryProp(P_USED_HANDS);
  if(present("\nspiegelschild", caster)) {
    f_hands+=1;
  }
  if(interactive(caster) && f_hands < 2)
  {
    Message(caster,0,
      BS("Du hast nicht genug Haende frei."),0);
    return 0;
  }
  if(caster->QueryProp(P_BLIND)) {
    Message(caster,0,
      BS("Bei Dusty, Du bist blind und kannst so niemanden wiederauferstehen "
        "lassen"),0);
    return 0;
  }

  if(!victim->id("Leiche"))
  {
    Message(caster, 0, BS("PALADIN! Du kannst nur Tote wieder auferstehen "
        "lassen!"),0);
    return 0;
  }

  if(pointerp(victim->QueryProp(P_IGNORE)) && member(
        victim->QueryProp(P_IGNORE), "auferstehung") != -1) 
  {
    Message(caster, 0, BS("PALADIN! Eine seltsame Macht haelt Dich davon "
          "ab, diese Leiche auferstehen zu lassen!"),0);
    return 0;
  }
  if(victim->QueryProp("revived")) {
    Message(caster, 0, BS("PALADIN! Du kannst diese Leiche nicht mehr "
          "auferstehen lassen!"),0);
    return 0;
  }
  TELL("angrox", sprintf("**PAL, auferstehung. victim: %O, guild: %O\n", victim,
                victim->QueryProp(P_GUILD)));

  if(victim->QueryProp(P_GUILD) == "nekromanten") {
    Message(caster, 0, BS("PALADIN! Willst Du Dustys Zorn auf Dich "
          "herabbeschwoeren in dem Du unseren Feinden hilfst?"),0);
    return 0;
  }

  if(victim->id("Dunkelelfenspieler")) {
    Message(caster, 0, BS("PALADIN! Dunkelelfen stehen Dusty nicht nah "
          "genug um wiederbelebt zu werden."),0);
    return 0;
  }

  if(victim->QueryProp(P_LEVEL) < 30) {
    Message(caster, 0, BS(sprintf("PALADIN! %s Seele ist noch nicht fest genug "
          "im Silberland verankert um wiederbelebt zu werden.",
          victim->Name(WESSEN))),0);
    return 0;
  }

  if(!pl=find_player(lower_case(victim->QueryProp(P_ORIG_NAME)))) {
    Message(caster, 0, BS(sprintf("PALADIN! %s ist nicht mehr auffindbar!", 
          victim->QueryProp(P_ORIG_NAME))),0);
    return 0;
  }

  if(pl->QueryGuest()) {
    Message(caster, 0, BS("PALADIN! Du kannst keine Gaeste "
            "auferstehen lassen!" ),0);
    return 0;
  }
  if(IS_LEARNER(pl) || (pl->QueryProp(P_TESTPLAYER) && !IS_LEARNER(caster)) ) {
    Message(caster, 0, BS(sprintf("PALADIN! %s steht unter dem besonderen "
            "Schutz von Dusty und benoetigt keine Auferstehung!",
            pl->Name(WER))),0);
    return 0;
  }
  if( present(PALADINREVIVED, pl) )
  {
    Message(caster, 0, BS(sprintf("%s hat die Schuld von der letzen "
            "Auferstehung noch nicht getilgt und kann daher nicht noch "
            "einmal wiederbelebt werden!", 
            victim->QueryProp(P_ORIG_NAME))), 0);
    return 0;
  }

  if(call_other(NPCMASTER, "IsFeind", pl) && victim!=caster) {
    Message(caster,0,
          BS("BEI DUSTY! Du wuerdest einen FEIND der Paladine und somit "
          "auch einen FEIND Deiner Goettin auferstehen lassen? Dafuer gibt "
          "es nur EINE Strafe!!!"),0);
    call_out("DoFakeDeath",0,caster);
    return 0;
  }
  if (!(stein = present("magiestein", caster)) || 
      stein->QueryProp(P_AMOUNT) < MAGICSTONES_FOR_RESURRECT)
  {
    Message(caster,0,
          BS("Du brauchst " + MAGICSTONES_FOR_RESURRECT + " Magiesteine, "
            "um jemanden wiederauferstehen zu lassen!"), 0);
    return 0;
  }
  
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  max = sinfo[SI_SKILLABILITY] == MAX_ABILITY;
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, "Du beginnst leise zu Dusty zu beten!\n", 0);
  Message(caster, 0, sprintf("%s scheint leise zu beten.\n",caster->Name(WER)),
      3);
//  needed_money=800000+random(400000)-(int)(300000*suc/MAX_ABILITY);
  needed_money = 30000 / (max + 1) + pl->QueryProp(P_LEVEL) * 
    (4000 - 1500*(suc+sinfo[SI_SKILLABILITY]/2)/MAX_ABILITY);
  if(call_other(PALADINMASTER, "GetSacrificedMoney", caster) < needed_money) {
    Message(caster, 0, BS("PALADIN! Du musst Dusty erst mehr opfern "
          "bevor Du jemanden wieder auferstehen lassen kannst!"),0);
    return 0;
  }

  if((suc=SpellSuccess(caster,sinfo))<=0) {
    call_other(PALADINMASTER, "SacrificeMoney", caster, -(needed_money/20));
    return MISSERFOLG;
  }
  stein->AddAmount(-MAGICSTONES_FOR_RESURRECT);
  call_other(PALADINMASTER, "SacrificeMoney", caster, -needed_money + max * needed_money/6);
  write_file("/gilden/paladine/spells/auferstehung",
        sprintf("CST: %O, VIC: %O, CA: %d, VA: %d, suc: %d, "
        "MP: %d, Kosten: %d, XP: %2d%%\n", caster, pl, caster->QueryProp(P_ALIGN),
        pl->QueryProp(P_ALIGN), suc,sinfo[SI_RAW_SPELLCOST],needed_money,
        15+(suc + sinfo[SI_SKILLABILITY]/2)/250));
  tell_room(ENV(caster), BS(sprintf("%s legt %s Hand auf die Leiche von %s.\n",
        caster->Name(WER), caster->QueryPossPronoun(FEMALE),
        pl->name(WEM))), ({caster}));
  tell_object(caster, BS(sprintf("Du legst Deine Hand auf die Leiche "
       "von %s.", victim->name(WEM))));
  tell_room(ENV(caster), BS(sprintf("Strahlendes Licht erfuellt den "
          "Raum! Als das Licht verebbt, steht %s neben Dir, so wie Dusty "
          "%s geschaffen hat!", pl->name(WER), pl->QueryPronoun(WEN))));
  pl->move(ENV(caster), M_NOCHECK|M_SILENT);
  pl->SetProp(P_GHOST, 0);
  pl->SetProp(P_HP, pl->QueryProp(P_MAX_HP)/2);
  pl->resurrect(15 + 10 * max + (suc + sinfo[SI_SKILLABILITY]/2)/250);
  if(ob = present("\ndeath_mark", pl))
    ob->remove();
  victim->SetProp("revived", 1);
  ob = clone_object(OBJ("revived"));
  ob->move(pl, M_NOCHECK);
  ob->SetVariables(getuid(caster), 2 * needed_money / 3);
  if(caster->QueryProp(P_ALIGN) < 1100)
    caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)+random(10));
  return ERFOLG;
}



