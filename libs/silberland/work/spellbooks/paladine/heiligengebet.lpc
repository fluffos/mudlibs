// Prototypem
//

#define NEKRO_CAN_BE_REANIMATED "\nnekrocanbereanimated"
#define NEKRO_BONES "\nnekromanten_knochen"


int heiligengebet(object caster, mapping sinfo);

private void anathema(object caster, object victim) {
  if(!objectp(victim)) return;
  if( random(caster->QueryAttribute(A_INT) + caster->QueryProp(P_ALIGN) / 60) >
      victim->QueryProp(P_NOMAGIC) - random(victim->QueryProp(P_ALIGN)/44) && !victim->QueryProp(P_TMP_PALADINE_ANATHEMA)) {
    tell_room(ENV(victim), BS(sprintf("%s verhaengt das Anathema ueber %s! %s ist nun anfaelliger gegenueber Dustys Strafen.",
              caster->Name(WER, 1), victim->name(WEN, 1), capitalize(victim->QueryPronoun()))), ({caster}));
    tell_object(caster, BS(sprintf("Du verhaengst das Anathema ueber %s! %s ist nun anfaelliger gegenueber Dustys Strafen.",
              victim->name(WEN, 1), capitalize(victim->QueryPronoun()))));
    victim->AddResistanceModifier(([DT_HOLY: caster->QueryProp(P_GUILD_LEVEL)/100.0]));
    victim->UpdateResistanceStrengths();
    victim->SetProp(P_TMP_PALADINE_ANATHEMA, 1);
    call_out("revoke_anathema", caster->QueryAttribute(A_CON) + caster->QueryProp(P_GUILD_LEVEL) - (victim->QueryProp(P_ALIGN) / 10), victim);
  }
  return;
}

public void revoke_anathema(object victim) {
  if(!objectp(victim)) return;
  if(!victim->QueryProp(P_TMP_PALADINE_ANATHEMA)) return;

  tell_object(victim, BS("Dustys Anathema weicht von dir."));
  tell_room(ENV(victim), BS(victim->Name(WER, 1) + " ist nun nicht mehr anfaelliger gegenueber Dustys Strafen!"));
  victim->RemoveResistanceModifier();
  victim->SetProp(P_TMP_PALADINE_ANATHEMA, 0);
}

int heiligengebet(object caster, mapping sinfo) {
  object victim;
  int suc, dam;
  int lvl;
  if(stringp(sinfo[SI_SKILLARG]) && (victim=present(sinfo[SI_SKILLARG], 
      ENV(caster))) && !living(victim)) 
  {
    if(!victim->id("Leiche") && !victim->id(NEKRO_CAN_BE_REANIMATED) &&
       !victim->id(NEKRO_BONES) && !victim->id("Spielerleiche"))
    {
      Message(caster, 0, BS("Paladin! Diesen Gegenstand kannst Du nicht "
            "segnen!"));
      return 0;
    }
    if(victim->QueryProp(P_NOMAGIC) == "dusty") {
     Message(caster,0,BS(sprintf("Paladin! %s ist bereits gesegnet!",
             victim->Name(WER))));
      return 0;
    }
    sinfo=DoSpellModification(caster, sinfo);
    if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
    }
    caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
    Message(caster, 0, BSA(sprintf("DUSTY! Erhoere "
       +"mich und segne %s, auf das kein Fluch oder Daemon von %s "
       "Besitz ergreifen kann!", victim->name(WEN), victim->QueryPronoun(WEM)),
       "Du rufst: "), 0);
    Message(caster, 0, BSA(sprintf("DUSTY! Erhoere "
       +"mich segne %s, auf das kein Fluch oder Daemon von %s "
       "Besitz ergreifen kann!", victim->name(WEN), victim->QueryPronoun(WEM)),
       caster->Name(WER)+" ruft: "), 3);
    if((suc=SpellSuccess(caster, sinfo))<=0) {
      Message(caster, 0, BS("Dusty erhoert Dein Flehen nicht!\n"), 0);
      Message(caster, 0, BS("Nichts passiert.\n"), 3);
      return MISSERFOLG;
    }
    ENV(caster)->Message(BS(sprintf("Ueber %s bildet sich kurz ein "
          "goldener Schimmer, der langsam wieder verblasst.",
          victim->name(WEM))), MSGFLAG_VISUAL);
    victim->SetProp(P_SHORT, victim->QueryProp(P_SHORT)+sprintf(" (von %s "
          "gesegnet)", caster->name(WEM)));
    victim->SetProp(P_NOMAGIC, "dusty");
    if(!victim->id(NEKRO_CAN_BE_REANIMATED))
      victim->SetShortAddon(sprintf("(von %s gesegnet)",  caster->name(WEM)));
    if (victim->id("Spielerleiche"))
      victim->SetProp("corpse_decay", victim->QueryProp("corpse_decay") * 2);
    lvl=victim->QueryProp(P_LEVEL);
    if(caster->QueryProp(P_ALIGN) < 1000) {
      caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)+random(lvl)+lvl+5);
    }

    return ERFOLG;
  }
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
             "Welchen Frevler moechtest Du strafen?\n");
  if(!victim) return 0;
  sinfo=DoSpellModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      printf(sinfo[SI_SP_LOW_MSG]);
      return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  Message(caster, 0, BSA(sprintf("DUSTY! Erhoere "
      +"mich und strafe %s mit Deiner Macht!", victim->name(WEN)),
      "Du rufst: "), 0);
  Message(caster, 0, BSA(sprintf("DUSTY! Erhoere "
      +"mich und strafe %s mit Deiner Macht!", victim->name(WEN)),
       caster->Name(WER)+" ruft: "), 3);
  if((suc=SpellSuccess(caster, sinfo))<=0) {
    Message(caster, 0, BS("Dusty erhoert Dein Flehen nicht!\n"), 0);
    Message(caster, 0, BS("Nichts passiert.\n"), 3);
    return MISSERFOLG;
  }

  if(suc>7000 && !random(2) && !present("\neifer", caster))
      victim->ModifySkillAttribute(caster, SA_SPEED, 200, 2+random(4));
  dam=sinfo[SI_SKILLDAMAGE]+caster->QueryProp(P_GUILD_LEVEL)*3;
  sinfo[SI_SKILLDAMAGE]=DoModificationByAlign(dam, caster, victim);

  if (sinfo[SI_SKILLDAMAGE] > 350) sinfo[SI_SKILLDAMAGE]=350;
  // ZUM LOGGEN DER SPELLSTAERKE!
  if(enable_spell_log)
    write_file("/gilden/paladine/spells/heiligengebet",
        sprintf("CST: %O, CA: %d, VA: %d, suc: %d, dam: %d\n",
            caster, caster->QueryProp(P_ALIGN), victim->QueryProp(P_ALIGN),
            suc, sinfo[SI_SKILLDAMAGE]));
  // ----------------------------
  Message(caster, 0, BS(sprintf("Es zuckt ein Blitz aus "
      +"Deiner Hand und trifft %s! Gepriesen sei Dusty!",
      victim->name(WEN))), 0);
  Message(caster, victim, BS(sprintf("Es zuckt ein Blitz "
      +"aus der Hand von %s und trifft Dich!", caster->name(WER))),1);
  Message(caster, victim, BS(sprintf("Es zuckt ein Blitz "
      +"aus der Hand von %s und trifft %s!", caster->name(WER),
      victim->name(WEN))),2);
  TryDefaultAttackSpell(victim,caster,sinfo,
            ([SP_NAME:"heiligengebet", SP_SHOW_DAMAGE:1]));


  if(HAS_BLESSING(caster, BLESSING_ANATHEMA)) {
    anathema(caster, victim);
  }
  return ERFOLG;
}


