inherit "/std/spellbook";

public void create() {
  mapping original;

  ::create();
  SetProp(P_SB_CASTVERB, "spiele");
  SetProp(P_SB_PARSE_FUNC, "parse_spell");
  SetProp(P_SB_NO_CASTVERB_NEEDED_MSG, "Dieses Lied kannst Du nicht spielen!\n");
  SetProp(P_GLOBAL_SKILLPROPS,
          ([SI_SPELLFATIGUE: 2,              // 2 Sekunden kein neuer Spell
	          SI_SKILLLEARN: 2,                // 0.04% pro 2 A_DEX 
	          OFFSET(SI_SKILLLEARN): 3,        // plus 0.05% in jedem Fall
	          SI_SKILLLEARN_ATTRIBUTE: A_DEX,
	          SI_SP_LOW_MSG:"Deine Kraft reicht fuer ein neues Lied nicht aus!\n",
	          SI_TIME_MSG: "Du musst Dich erst wieder etwas sammeln!\n",
	          SI_ENABLE_CASTVERB: 1,
	  ]));
  
  AddSpell("das gelueftete geheimnis", 0, ([
              SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 1]),
