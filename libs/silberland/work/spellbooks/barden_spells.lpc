private int modifyBySkillAttribute(object caster, int baseVal, string skillAttribute) {
  return (int) (baseVal * (caster->QuerySkillAttribute(skillAttribute) / 100.0));
}


public int filterEverything(object ob) {
  return 1;
}

public int isPotentialEnemy(object ob) {
  return living(ob) && !query_once_interactive(ob) && !ob->QueryProp(P_NOATTACK) && !ob->QueryProp(P_FRIEND);
}

varargs public object* findTargets(object caster, string filter, object funObj, int min) {
  object *all, *targets, t;
  int n;


  if(!objectp(caster)) {
    raise_error("cannot find targets without caster");
    return 0;
  }

  if(!min) min = 1;

  if(TALENTMASTER->HasTalent(caster, TALENT_FORTE_FORTISSIMO)) {
    min += caster->QueryProp(P_BARD_INSPIRATION_LEVEL);
  }

  if(!stringp(filter)) filter = "filterEverything";
  if(!objectp(funObj)) funObj = this_object();

  all = filter_array(all_inventory(environment(caster)), filter, funObj);
  targets = ({});
  n = min;
  if(TALENTMASTER->HasTalent(caster, TALENT_FORTE_FORTISSIMO)) {
    n += caster->QueryProp(P_BARD_INSPIRATION_LEVEL);
  }

  n = modifyBySkillAttribute(caster, n, SA_EXTENSION);
  if(n>sizeof(all)) n = sizeof(all);

  while(n > 0) {
    t = all[random(sizeof(all))];
    if(member(targets, t) < 0) {
      targets += ({ t });
      n--;
    }
  }

  return targets;
}

private string tooLowSpMessage(mapping sinfo) {
  return BS(sprintf("Fuer dieses benoetigst du %d Magiepunkte!", sinfo[SI_RAW_SPELLCOST]));
}

// AKTUELLES INSTRUMENT FINDEN
public int isInstrument(object ob) {
  return ob->id("\ninstrument") && ob->QueryProp(P_INSTRUMENT_TYPE) != 0;
}

public object getInstrument(object who) {
  object *armours;
  if(!objectp(who)) return 0;
  armours = who->QueryArmours();
  if(objectp(who->QueryProp(P_WEAPON))) {
    armours += ({ who->QueryProp(P_WEAPON) });
  }
  armours = filter_array(armours, "isInstrument");
  if(sizeof(armours) < 1) {
    return 0;
  }

  return armours[0];
}

// LIEDTEXTE SPIELEN
void play_song_text(string file, object bard)
{
  string *lines;
  if(bard->QueryProp(P_TESTPLAYER)) {
    tell_object(bard, BS(sprintf("play_song_text :: file=%s", file)));
  }

  lines = explode(read_file(file), "\n");
  //DEBUG(sprintf("song: %s d: %O\n", file, lines));
  call_out("song", 0, 0, bard, lines);
}

private string parse_song_text(string str, object bard) {
  object instrument;
  instrument = getInstrument(bard);

  // Name des Barden
  if (strstr(str,"@WER",0) != -1)
  str = regreplace(str,"@WER", bard->name(WER,1),1);
  if (strstr(str,"@WESSEN",0) != -1)
    str = regreplace(str,"@WESSEN", bard->name(WESSEN,1),1);
  if (strstr(str,"@WEM",0) != -1)
    str = regreplace(str,"@WEM", bard->name(WEM,1),1);
  if (strstr(str,"@WEN",0) != -1)
    str = regreplace(str,"@WEN", bard->name(WEN,1),1);

  // benutztes Instrument
  if (strstr(str, "@INSTRUMENT2", 0) != -1) {
    str = regreplace(str, "@INSTRUMENT2", instrument->name(WESSEN, 1),1);
  }
  if (strstr(str, "@INSTRUMENT3", 0) != -1) {
    str = regreplace(str, "@INSTRUMENT3", instrument->name(WEM, 1),1);
  }
  if (strstr(str, "@INSTRUMENT4", 0) != -1) {
    str = regreplace(str, "@INSTRUMENT4", instrument->name(WEN, 1),1);
  }
  if (strstr(str, "@INSTRUMENT", 0) != -1) {
    str = regreplace(str, "@INSTRUMENT", instrument->name(WER, 1),1);
  }

  // Extrawuerste
  if (strstr(str, "||", 0) != -1) {
    str = regreplace(str, "\\|\\|", "\n", 1);
  }
  
  return str;
}

public int ignoresSongtext(object ob) {
  if(!pointerp(ob->QueryProp(P_IGNORE))) return 0;
  return member(ob->QueryProp(P_IGNORE), "barden.liedtext") >= 0;
}

void song(int line, object bard, string *lines)
{
  string envtext;
  object *ignorants;

  if(line >= sizeof(lines)) return;
  if(!pointerp(bard->QueryProp(P_PREPARED_SPELL))) {
    tell_object(bard, BS("Du beendest dein Lied."));
    tell_room(ENV(bard), BS(sprintf("%s beendet das Lied.", bard->Name(WER, 1))), ({bard}));
    return;
  }

  // Pause
  if(lines[line][0..1] == "--")
  {
    call_out("song", 1, line+1, bard, lines);
    return;
  }

  // Ausgabe fuer den Singenden
  tell_object(bard, break_string(parse_song_text(lines[line], bard), 78, 0, BS_LEAVE_MY_LFS));

  // Ausgabe an den Raum
  ignorants = filter_array(all_inventory(environment(bard)), "ignoresSongtext");
  if(sizeof(ignorants) > 0 && bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("ignorants = %O\n", ignorants));
  if(strstr(lines[line+1], "&&", 0) != -1) {
    // compatibility fuer aeltere liedformate
    envtext = BS(implode(explode(lines[line+1], "&&"), bard->Name(WER)));
    if(sizeof(explode(lines[1+line], "&&")) < 2)
      envtext = BS(bard->Name(WER)+envtext);	
  } else {
    envtext = break_string(parse_song_text(lines[line+1], bard), 78, 0, BS_LEAVE_MY_LFS);
  }  
  tell_room(ENV(bard), envtext, ({bard}) + ignorants);
  
  call_out("song", 0, 2+line, bard, lines);
  return;
}

// PARSE-FUN aus dem Nekro-Spellbook

mixed parse_target(string str)
{
  string wer;
  if(!str) return str;
  if(sscanf(str, "auf %s", wer)!=1)
    return 0;
  return wer;
}


mixed parse_spell(string str)
{
      string *parts;
      string arg;
      if(!sizeof(regexp( ({ str }), "'.*'"))) {
        write(BS("Du kannst ein Lied nur spielen, wenn Du seinen Namen "
		 "zwischen die Symbole ' ' gibst!"));
        return 0;
      }
      parts=explode(str, "'");
      if(sizeof(parts) > 1) {
        arg=implode(parts[1..], " ");
        if(arg[0..0] == " ") {
          arg=arg[1..];
        }
        arg=parse_target(arg);
        return ({ arg, parts[0] });
      }
      else
        return ({ 0, parts[0] });
}

private int convertGuildLevelToInstrumentLevel(int glvl) {
  return glvl / 3 + 1;
}

private int modifyInstrumentLevelByCaster(object bard, object instrument) {
  string bardGroup;
  int convertedBardLevel, instrumentLevel;

  if(!objectp(instrument)) {
    return 0;
  }

  bardGroup = "/gilden/bardengilde/master/bardenmaster"->GetBardGroup(bard);
  convertedBardLevel = convertGuildLevelToInstrumentLevel(bard->QueryProp(P_GUILD_LEVEL));
  instrumentLevel = instrument->QueryProp(P_INSTRUMENT_LEVEL);

  if(instrument->QueryProp(P_INSTRUMENT_TYPE) != BARD_GROUP_INSTRUMENT[bardGroup]) {
    return instrumentLevel - 1;
  }

  if(instrument->QueryProp(P_INSTRUMENT_LEVEL) > convertedBardLevel) {
    return convertedBardLevel;
  }

  return instrumentLevel;
}

// INSPIRATION AUFBAUEN

private void printInspirationLevelChangeMessage(object bard) {
  string msg;

  switch(bard->QueryProp(P_BARD_INSPIRATION_LEVEL)) {
    case 0:
      msg = "Deine kreative Energie ist erschoepft.";
      break;
    case 1:
      msg = "Langsam drehen sich kreative Gedanken in deinem Kopf.";
      break;
    case 2:
      msg = "Melodien und Verse fuellen deinen Kopf.";
      break;
    case 3:
      msg = "Die Welt um dich herum inspriert immer neue kreative Gedanken!";
      break;
    case 4:
      msg = "Du spruehst regelrecht vor kreativer Energie!";
      break;
    case 5:
      msg = "Du fuehlst dich so inspriert wie nie zuvor! Kreativitaet pulsiert durch deine Adern.";
      break;
    case 6:
      msg = "Alles um dich ist ein Strudel aus Farben und Melodien.";
      break;
    case 7:
      msg = "Jeder Lufthauch, jeder Stein und jedes Wort sind reinster Quell der Inspiration!";
      break;
    case 8:
      msg = "Alles um dich verschwimmt in einem Strudel aus kreativen Gedanken.";
      break;
    case 9:
      msg = "Milliarden von Ideen fuer neue Kunst durchflutet dich.";
      break;
    default:
      msg = "Du hoerst den transzendenten Gesang der Musen.";
      break;
  }

  tell_object(bard, BS(msg));
  return;
}

private varargs void calculateInspirationLevel(object bard, int overflow) {
  int ln, inspiration, currentLevel;

  if(!objectp(bard)) return;

  currentLevel = bard->QueryProp(P_BARD_INSPIRATION_LEVEL);
  
  inspiration = bard->QueryProp(P_BARD_INSPIRATION);
  if(inspiration == 0) {
    bard->SetProp(P_BARD_INSPIRATION_LEVEL, 0);
  } else {   
    ln = (int) log((float) inspiration);
    bard->SetProp(P_BARD_INSPIRATION_LEVEL, ln);
  }

  if(ln > 10) {
    ln = 10;
  }

  if(currentLevel != ln) {
    printInspirationLevelChangeMessage(bard);
    TALENTMASTER->AdaptHeroPowersToInspiration(bard);
  }

  return;
}

public varargs void accumulateInspiration(object caster, int inspirationPoints, int overflow) {
  int prevInsp, inspDiff, maxInsp;

  if(!objectp(caster)) return;
  overflow = caster->QueryProp(P_BARD_INSPIRATION_OVERFLOW_UNTIL) >= time();

  if(!overflow && ((inspirationPoints > 0 && time()-caster->QueryProp(P_BARD_LAST_INSPIRED) < 5) || inspirationPoints == 0)) {
    return; // nur alle 5 Sekunden Inspiration aufbauen 
  }

  prevInsp = caster->QueryProp(P_BARD_INSPIRATION);

  if(caster->QueryProp(P_BARD_INSPIRATION_OVERFLOW_UNTIL) > 0 && overflow) {
    maxInsp = prevInsp;
  } else {
    if(caster->QueryProp(P_BARD_INSPIRATION_OVERFLOW_UNTIL) != 0) {
      caster->SetProp(P_BARD_INSPIRATION_OVERFLOW_UNTIL, 0);
      tell_object(caster, BS("Der Gesang der Musen verlaesst deinen Geist. Deine Inspiration kehrt auf normales Niveau zurueck."));
    }
    maxInsp = 150;
  }

  if(prevInsp+inspirationPoints > maxInsp && !overflow && inspirationPoints > 0) {
    tell_object(caster, BS("Du spruehst vor Inspiration!"));
    inspDiff = caster->QueryProp(P_BARD_INSPIRATION) - maxInsp;
    caster->AddSp(random(inspDiff/20));
    caster->SetProp(P_BARD_INSPIRATION, maxInsp);
  } else {
    caster->SetProp(P_BARD_INSPIRATION, prevInsp + inspirationPoints);
  }

  if(caster->QueryProp(P_BARD_INSPIRATION) <= 0) {
    caster->SetProp(P_BARD_INSPIRATION, 0);
  }

  caster->SetProp(P_BARD_LAST_INSPIRED, time());

  calculateInspirationLevel(caster, overflow);

  return;
}

private int limitSuccessByInstrument(object caster, int success) {
  object instrument;
  int instrumentLevel;

  instrument = getInstrument(caster);
  if(!objectp(instrument)) {
    tell_object(caster, BS("Ohne Instrument kannst du auch nicht Musizieren :("));
    return 0;
  }

  instrumentLevel =  modifyInstrumentLevelByCaster(caster, instrument);

  if(success > instrumentLevel*2000 ) {
    tell_object(caster, BS("Leider ist dein Instrument nicht gut genug, um deine volle "
                           "musikalische Bandbreite wieder zugeben."));
    return instrumentLevel*2000;
  }

  return success;
}

// SpellSuccess wird ueberschrieben... wir verwenden SK_MUSIC und SK_SINGING statt
// SK_CASTING
#define SMUL(x,y) ((x<0 && y<0)?(-1*x*y):(x*y))
int SpellSuccess(object caster, mapping sinfo) {
  int cval,abil,res, *sp_count, diff, i, sv, bonus, roll, skill, pureskill;
  string *skills;

  // relevant skills fuer diesen spell feststellen
  if(pointerp(sinfo[SI_CAST_SKILL])) {
      skills = sinfo[SI_CAST_SKILL];
  } else {
      skills = ({ sinfo[SI_CAST_SKILL] });
  }

  // zaubererfolg ausrechnen
  abil=sinfo[SI_SKILLABILITY];
  if(caster->QueryProp(P_BARD_TMP_NEXT_SPELL_IS_MAX_SUCCESS)) {
    res = (int) (abil * 1.3);
    caster->SetProp(P_BARD_TMP_NEXT_SPELL_IS_MAX_SUCCESS, 0);
  } else {
    // skills ausfuehren
    for(i=0; i<sizeof(skills); ++i) {
        sv = (int) caster->UseSkill(skills[i]);
        if(caster->QueryProp(P_TESTPLAYER)) 
            tell_object(caster, sprintf("skill '%s': %d\n", skills[i], sv));

        if(skills[i] == SK_MUSIC) {
          sv = limitSuccessByInstrument(caster, sv);
        }
        cval += sv;
    }

    cval = (int) cval / (sizeof(skills)>0?sizeof(skills):1); // bei mehren skills nur anteilig
    if(cval > abil) cval = abil;
    roll = random(MAX_ABILITY-(abil==MAX_ABILITY?2000:0));
    skill = abil + random((SMUL(abil,cval)) / MAX_ABILITY); 
    res   = skill - roll;

    if(caster->QueryProp(P_TESTPLAYER)) {
      tell_object(caster, sprintf("SpellSuccess :: %s :: res = %d skill = %d pure = %d roll = %d\n", 
                                  lowerstring(sinfo[SI_CAP_NAME]), res, skill, abil, roll));
    }

    if(res > 0 && (abil-roll) < 0) {
      if(caster->QueryProp(P_TESTPLAYER)) {
        tell_object(caster, sprintf("SpellSucces :: recovered fail simulRes = %d\n", abil-roll));
      }
      tell_object(caster, BS("Dank deiner Kunstfertigkeit ist das Lied gerade noch gelungen!"));
      Learn(caster, lowerstring(sinfo[SI_CAP_NAME]), sinfo);
    }


    if(TALENTMASTER->HasTalent(caster, TALENT_CRESCENDO)) {
      bonus = caster->QueryProp(P_BARD_INSPIRATION_LEVEL) * 5;
      res = (int) ( res * (1.0 + (bonus  /100.)));
    }

    accumulateInspiration(caster, (res/1000));
  }

  return res;
}

private float CalculateCostReductionByEquipment(object pl) {
  object *obj, wea;
  int i, value, h;
  value=0;
  if(!objectp(pl)) return 0.0;
  obj=({});
  obj=pl->QueryProp(P_ARMOURS);
  if( wea=pl->QueryProp(P_WEAPON) )
    obj+=({wea});
  if(!sizeof(obj)) return 0.0;
  for(i=sizeof(obj)-1;i>=0;i--) {
    if(h=obj[i]->QueryProp(P_BARDEN_SPELLCOST))
      value+=h;
  }
  return value/100.0;
}

private float CalculateInstrumentCostFactor(object caster, int spellLevel) {
  object instrument;
  int convertedSpellLevel, instrumentLevel;

  convertedSpellLevel = convertGuildLevelToInstrumentLevel(spellLevel);

  instrument = getInstrument(caster);
  instrumentLevel = modifyInstrumentLevelByCaster(caster, instrument);

  if(caster->QueryProp(P_TESTPLAYER)) {
    tell_object(caster, sprintf("instrument cost: ilvl=%d slvl = %d\n", instrumentLevel, convertedSpellLevel));
  }

  if(convertedSpellLevel > instrumentLevel) {
    return (convertedSpellLevel - instrumentLevel) * 0.1; // +10% spellkosten fuer fehlende levels
  } else if(convertedSpellLevel < instrumentLevel) {
    return (convertedSpellLevel - instrumentLevel) * 0.01; // -1% spellkosten fuer uebererfuellung
  }

  return 0.0;
}

public int modifyCostWithSpellsong(object caster, int cost) {
  float factor, int_factor;
  
  if(caster->QueryProp(P_TMP_BARDS_ZAUBERMELODIE)) { // Das Zauberlied erhoeht zwar die Wirkung, aber auch die Kosten der Zauber
    int_factor = 0.5 - ((float) caster->QueryAttribute(A_INT)) / 143.0; // und zwar abhaengig von INT um 33% bis mindestens 5% bei INT 40
    if(TALENTMASTER->HasTalent(caster, TALENT_ELFISCHE_MELODIE)) {
      int_factor -= (int_factor/3); // Das Talent reduziert die Kosten um 1/3
    }

    factor = 1.0 + int_factor; 
    if(caster->QueryProp(P_TESTPLAYER)) {
      write(sprintf("CostFactor(ZL) = %.2f\n", factor));
    }

    cost = (int) (cost * factor);
    if(caster->QueryProp(P_TESTPLAYER)) {
      write(sprintf("Cost(ZL) = %d\n", cost));
    }
  }

  return cost;
}

// SPELLKOSTEN ANPASSEN
mapping DoCostModification(object caster, mapping sinfo)
{
  int final_cost;
  float factor, int_factor, inst_factor, lvl_factor;

  factor = 0.0;
  final_cost=sinfo[SI_RAW_SPELLCOST];

  final_cost = modifyCostWithSpellsong(caster,final_cost);

  factor = CalculateCostReductionByEquipment(caster);
  if(caster->QueryProp(P_TESTPLAYER)) {
    write(sprintf("CostFactor(equip) = %.2f\n", factor));
  }

  if(caster->QueryProp(P_TESTPLAYER)) {
    write(sprintf("CostFactor(Inspiration) = %.2f\n", caster->QueryProp(P_BARD_INSPIRATION_LEVEL) * 0.02));
  }
  factor += caster->QueryProp(P_BARD_INSPIRATION_LEVEL) * 0.02;

  inst_factor = CalculateInstrumentCostFactor(caster, sinfo[SI_SKILLRESTR_USE][P_GUILD_LEVEL]);
  if(caster->QueryProp(P_TESTPLAYER)) {
    write(sprintf("CostFactor(instrument) = %.2f\n", inst_factor * -1));
  }
  factor -= inst_factor;

  // spells werden mit steigender stufe etwas billiger
  lvl_factor = -1 * (caster->QueryProp(P_GUILD_LEVEL) - sinfo[SI_SKILLRESTR_USE][P_GUILD_LEVEL])*1.5/100;
  if(caster->QueryProp(P_GUILD_LEVEL) > sinfo[SI_SKILLRESTR_USE][P_GUILD_LEVEL]) {
    factor -= lvl_factor;
  }
  if(caster->QueryProp(P_TESTPLAYER)) {
    write(sprintf("CostFactor(level) = %.2f\n", lvl_factor * -1));
  }

  if(caster->QueryProp(P_TESTPLAYER)) {
    write(sprintf("CostFactor = %.2f\n", 1.0 - factor));
  }

  final_cost = (int) (final_cost * (1.0 - factor));

  sinfo[SI_RAW_SPELLCOST]=final_cost;

  if(final_cost < 1) {
    sinfo[SI_RAW_SPELLCOST] = 1;
  }

  return sinfo;
}

varargs int TryAttackSpell(object victim, int damage, mixed dtypes, mixed is_spell, object caster, mapping sinfo) {
  int bonusDamage, roll;

   // Xulgsch-Helden haben einen Bonus, wenn sie "Gutes" angreifen
   if(objectp(victim) && BARDENMASTER->HasHeroPathLevel(caster, HERO_XULGSCH, 3)) {
    roll = random(10);
    if(caster->QuerProp(P_TESTPLAYER))
      tell_object(caster, sprintf("Xulgsch Bonus ::  roll=%d align=%d\n", roll, victim->QueryProp(P_ALIGN)));

    if(roll < caster->QueryProp(P_BARD_INSPIRATION_LEVEL) && victim->QueryProp(P_ALIGN) > 0) {
      tell_object(caster, BS("Der Geist von Xulgsch ergreift Besitz von dir und verstaerkt deinen Angriff!"));
      tell_room(ENV(caster), BS(caster->Name(WER, 1) + " bekommt glasige Augen und eine hassverzerrte Fratze!"), ({caster}));
      bonusDamage = random(caster->QueryProp(P_BARD_INSPIRATION_LEVEL)*30);
      if(caster->QueryProp(P_TESTPLAYER))
        tell_object(caster, sprintf("Xulgsch Bonus :: damage=%d bonusDamage=%d\n", damage, bonusDamage));
      
      damage += bonusDamage;
      sinfo[SI_MAX_DAMAGE] += bonusDamage;
      if(member(dtypes, DT_UNHOLY) < 0) dtypes += ({ DT_UNHOLY });
    }
  }

  return ::TryAttackSpell(victim, damage, dtypes, is_spell, caster, sinfo);
}



// AUSGABE BEIM MISSLINGEN DES SPELLS

nosave int total_fail;

void Misserfolg(object caster, string spell, mapping sinfo)
{
    int old_abil;
    
    total_fail = 0;  // gleich zuruecksetzen
    old_abil = sinfo[SI_SKILLABILITY];
    if(old_abil < MAX_ABILITY) {
      Learn(caster, spell, sinfo);
      sinfo=caster->QuerySkill(spell);
      if (old_abil < (mappingp(sinfo) ? sinfo[SI_SKILLABILITY] : sinfo))
          write("Du lernst aus deinen Misstoenen!\n");
      else
          write("Leider lernst Du trotzdem nichts dazu :(\n");
    }
}

// BEI GELUNGENEN SPELLS
void Erfolg(object caster, string spell, mapping sinfo)
{
  mapping skill;
  int learnAttribute, learned;

  ::Erfolg(caster, spell, sinfo);
  skill = caster->QuerySkill(spell);
  skill[SI_USR]++;
  

  if(!pointerp(sinfo[SI_CAST_SKILL])) {
    learnAttribute = (sinfo[SI_CAST_SKILL] == SK_MUSIC?caster->QueryAttribute(A_DEX):caster->QueryAttribute(A_INT));
  } else {
    learnAttribute = (caster->QueryAttribute(A_DEX) + caster->QueryAttribute(A_INT))/2;
  }

  learned = 0;
  if(!random(50-learnAttribute) && sinfo[SI_SKILLABILITY] < MAX_ABILITY) {
    skill[SI_SKILLABILITY] = skill[SI_SKILLABILITY] + learnAttribute/5 + 1;
    learned = 1;
  }

  caster->ModifySkill(spell, skill);
  if(learned && caster->QuerySkillAbility(spell) > skill[SI_SKILLABILITY]) {
      tell_object(caster, BS("Du lernst aus deinem Erfolg!"));
  }
  return;
}

private string CheckGeneralSpellRestrictions(object caster, mapping sinfo) {
  if(caster->QueryProp(P_DEAF) != 0 && lowerstring(sinfo[SI_CAP_NAME]) != "ein ton in der stille") {
    return "Wenn Du Dich selbst nicht hoerst kannst Du kein Instrument spielen!\n";
  }

  if(caster->QueryProp(P_FROG) != 0) {
    return "Du quakst leise vor Dich hin...\n";
  }

  if(caster->QueryProp(P_GHOST) != 0) {
    return "Als Geist geht das nicht!\n";
  }

  return 0;
}

public string CheckCastWithMusic(object caster, mapping sinfo) {
  object instrument, w;
  int freeHands;

  instrument = getInstrument(caster);
  if(!objectp(instrument)) {
    return "Dazu benoetigst Du ein Instrument!\n";
  }

  freeHands = caster->QueryProp(P_MAX_HANDS) - caster->QueryProp(P_USED_HANDS) + 1; // +1 weil das Instrument immer eine Hand belegt
  if(objectp(w=caster->QueryProp(P_WEAPON))) {
    if(w->QueryProp(P_BARD_DANCING_WEAPON)) {
      freeHands += 1; // mit dem lied 'tanz der saebel' traegt man die waffe nicht wirklich
    }
  }
  if(instrument->QueryProp(P_HANDS) > freeHands) {
    return sprintf("Du benoetigst %d Haende um dein Instrument zu spielen.\n", instrument->QueryProp(P_HANDS));
  }

  return CheckGeneralSpellRestrictions(caster, sinfo);
}

public string CheckCastWithSinging(object caster, mapping sinfo) {
  if(objectp(caster->QueryProp(P_PERM_STRING))) {
    return "Deine Zunge gehorcht Dir nicht!\n";
  }

  return CheckGeneralSpellRestrictions(caster, sinfo);
}

public string CheckCastWithSingingAndMusic(object caster, mapping sinfo) {
  mixed result;

  result = CheckCastWithMusic(caster, sinfo);
  if(!result) {
    result = CheckCastWithSinging(caster, sinfo);
  }

  return result;
}

/* Bonuesse abfragen */
int CheckEquip(object caster, string prop)
{
  int r,i,x;
  object *a;
  object w;
  mapping map;
  r=0;
  if (!pointerp(a=caster->QueryProp(P_ARMOURS)) ) a=({});
  if( w=caster->QueryProp(P_WEAPON)) a+=({w});
  a-=({0});
  for(i=sizeof(a);i--;)
  {
    if( objectp(a[i]) && mappingp(map=a[i]->QueryProp(P_BARDEN_BONUS)) &&
        a[i]->QueryProp(P_EQUIP_TIME) + 3 < time())
      if( (x=map[prop]) || (x=map["all"]) ) 
        if(intp(x) && x>0)
          r+=x>MAX_EQUIP_BONUS?MAX_EQUIP_BONUS:x;
  }

  r = (r>TOTAL_EQUIP_BONUS?TOTAL_EQUIP_BONUS:r);
  return r;
}

public int isUpkeepEffect(object ob) {
  return ob->id(BARD_UPKEEP_EFFECT);
}

private string* getCurrentUpkeepMode(object caster) {
  object *upkeeps;
  int i, j;
  string *modes, *tmpModes;

  upkeeps = filter_array(all_inventory(caster), "isUpkeepEffect");
  modes = ({ });
  for(i=0; i<sizeof(upkeeps); ++i) {
    if(pointerp(upkeeps[i]->QueryProp(P_BARD_UPKEEP_MODES))) {
      modes += upkeeps[i]->QueryProp(P_BARD_UPKEEP_MODES);
    } else {
      modes += ({ upkeeps[i]->QueryProp(P_BARD_UPKEEP_MODES) });
    }
  }

  return modes;
}

// prueft und adaptiert einen zauber fuer die ausfuehrung
// zB:
// - Auf Instrument pruefen
// - Zauberkosten anpassen
mapping prepare_song(object caster, mapping sinfo)
{
    string *skill, checkResult, *activeUpkeep;
    int bonus, requiresSinging, requiresInstrument;
    
    requiresSinging = 0;
    requiresInstrument = 0;

    if(pointerp(sinfo[SI_CAST_SKILL])) {
      checkResult = CheckCastWithSingingAndMusic(caster, sinfo);
      requiresInstrument = 1;
      requiresSinging = 1;
    } else {
      if(sinfo[SI_CAST_SKILL] == SK_MUSIC) {
        checkResult = CheckCastWithMusic(caster, sinfo);
        requiresInstrument = 1;
      } else {
        checkResult = CheckCastWithSinging(caster, sinfo);
        requiresSinging = 1;
      }
    }

    if(checkResult != 0) {
      tell_object(caster, BS(checkResult));
      return 0;
    }

    // auf upkeep spells pruefen
    activeUpkeep = getCurrentUpkeepMode(caster);
    if(caster->QueryProp(P_TESTPLAYER)) {
      tell_object(caster, sprintf("upkeeps: %O\n", activeUpkeep));
    }
    if(pointerp(sinfo[SI_CAST_SKILL]) && sizeof(activeUpkeep) != 0) {
      tell_object(caster, BS("Dieses Lied kannst du grade nicht spielen, da schon singst oder musizierst!"));
      return 0;
    } else if(sinfo[SI_CAST_SKILL] == SK_MUSIC && member(activeUpkeep, SK_MUSIC) >= 0) {
      tell_object(caster, BS("Du kannst nur ein Musikstueck zu einer Zeit mit dem Instrument spielen!"));
      return 0;
    } else if(sinfo[SI_CAST_SKILL] == SK_SINGING && member(activeUpkeep, SK_SINGING) >= 0) {
      tell_object(caster, BS("Du kannst nicht zwei Lieder gleichzeitig singen!"));
      return 0;
    }

    return sinfo;
}

private varargs int paySpellCost(object caster, mapping sinfo, int checkOnly) {
  sinfo=DoCostModification(caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    tell_object(caster, tooLowSpMessage(sinfo));
    return 0;
  }
  if(!checkOnly) caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  return 1;
}

int isHumanoid(string str)
{
  if (member( ({"mensch", "elf", "zwerg", "hobbit", "fee", "troll", "xandim",
                "oger", "ork", "gaffo", "goblin", "gnom", "dunkelelf", 
                "halbelf", "froglok" , "zentaur"}),
      lower_case(str) )!=-1) return 1;
  return 0;
}

public int canBeCharmed(object victim, object caster) {
  int maxLevel, abil, iLevel;
  object instrument;

  abil = caster->QuerySkillAbility("sieben schritte");
  if(abil <= 0) return -1;
  if(query_once_interactive(victim)) return -1;
  if(!isHumanoid(victim->QueryProp(P_RACE)) && !TALENTMASTER->HasTalent(caster, TALENT_AGITATOR)) return -2;

  instrument = getInstrument(caster);
  if(objectp(instrument)) iLevel = instrument->QueryProp(P_INSTRUMENT_LEVEL);
  else iLevel = 0;

  maxLevel = 10 + caster->QueryProp(P_GUILD_LEVEL) + (abil/2000) + ( iLevel/2);
  if(TALENTMASTER->HasTalent(caster, TALENT_AGITATOR)) {
    maxLevel += (int) (caster->QueryAttribute(A_INT) / 8);
  }

  if(caster->QueryProp(P_TESTPLAYER)) tell_object(caster, sprintf("charm maxLevel = %d victimLevel = %d\n", maxLevel, victim->QueryProp(P_LEVEL)));
  
  return !(victim->QueryProp(P_LEVEL) > maxLevel ||
         victim->QueryProp(P_GUARD) || victim->QueryProp(P_NOATTACK) ||
         victim->id("NOCONTROL"));
}


