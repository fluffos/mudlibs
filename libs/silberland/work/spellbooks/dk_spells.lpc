string eng2germ(string eng)
{
    switch(eng)
    {
      case DT_FIRE: return "Feuerschaden";
      case DT_MAGIC: return "Magieschaden";
      case DT_COLD: return "Eisschaden";
      case DT_ACID: return "Saeureschaden";
      case DT_TERROR: return "Terrorschaden";
      case DT_POISON: return "Giftschaden";
      case DT_HOLY: return "heiligen Schaden";
      case DT_UNHOLY: return "unheiligen Schaden";
      case DT_LIGHT: return "Lichtschaden";
      case DT_SOUND: return "Laermschaden";
      case DT_WATER: return "Wasserschaden";
      case DT_LIGHTNING: return "Blitzschlag";
      case DT_ELECTRIC: return "Stromschaden";
      case DT_EXPLOSION: return "Explosionsschaden";
      case DT_AIR: return "Luftschaden";
      case DT_MIND: return "geistigen Schaden";
      default: return eng;
    }
}

void Misserfolg(object caster, string spell, mapping sinfo) 
{
  int old_abil, modifier, abil, new_abil;
  object victim;

  if( stringp(sinfo[SI_SKILLARG]) && 
      (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
       (victim=present(sinfo[SI_SKILLARG], caster))))
  {
    if(victim->id(SID_NOLEARN)) 
    {
      printf("Leider lernst Du nicht aus Deinem Fehler.\n");
      return;
    }
  }
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "todesritter");
  if(caster->QueryProp(P_ALIGN )> 0) {
    printf("Werde erstmal boeser! So lernst Du nie was!\n");
    return;
  }
  old_abil=caster->QuerySkillAbility(spell);
  Learn(caster, spell, sinfo);
  new_abil=caster->QuerySkillAbility(spell);
  if (old_abil < new_abil) 
  {
    printf("Du lernst aus Deinem Fehler.\n" ); 
    if(new_abil==MAX_ABILITY)
      tell_object(caster, BS(sprintf("%s teilt Dir mit: Du kannst %s "
          "nun daemonisch gut! WEITER SO!", GUILDNPC_NAME, CAP(spell))));
  }
  else 
    printf( "Leider lernst Du nicht aus Deinem Fehler.\n" );
  return;
}

void Erfolg(object caster, string spell, mapping sinfo) 
{
  int abil;
  object victim;
  if(!interactive(caster)) 
    return;
  abil=sinfo[SI_SKILLABILITY];
  if (abil!=MAX_ABILITY && random(MAX_ABILITY)<abil-MAX_ABILITY+100 )
  {
    if( stringp(sinfo[SI_SKILLARG]) && 
        (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
         (victim=present(sinfo[SI_SKILLARG], caster))))
    {
      if(victim->id(SID_NOLEARN)) 
      {
        printf("Der Gegner war zu leicht. Du lernst nichts!\n");
        return;
      }
    }
    if(caster->QueryProp(P_ALIGN) > 0) {
      printf("Werde erstmal boeser! So lernst Du nie was!\n");
      return;
    }
    caster->ModifySkill( spell, ([ SI_SKILLABILITY: ++abil ]), 0, "nekromanten");
    tell_object(caster,"Du lernst aus Deinem Erfolg.\n");
    if (abil==MAX_ABILITY)
    {
      tell_object(caster, BS(sprintf("%s teilt Dir mit: Du kannst %s "
          "nun absolut perfekt! WEITER SO!", GUILDNPC_NAME, CAP(spell))));
    }
  }
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "nekromanten");
  if( !random(3) && caster->QueryProp(P_ALIGN)>-1500) 
    caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)-1);
  return;
}

// Ab und zu gehen Spells einfach so schief, nur auf 7/7 nicht
int SpellSuccess(object caster, mapping sinfo) 
{
  int suc;
  suc=::SpellSuccess(caster, sinfo);
  if(random(4000) || (caster->QueryProp(P_GUILD_LEVEL) != 7 &&
      caster->QueryProp(P_GUILD_CIRCLE) != 7)  )
    return suc;
  return -10000+suc;
}

/* Hier wird geprueft, ob der Spell gesprochen werden darf */
varargs string CheckIfSpellAllowed(object caster, mapping sinfo) 
{
  object ob;
  if(caster->QueryProp("dk_tmp_default_guild"))
    return 0;
  if( sinfo[SI_SKILLRESTR_LEARN][P_GUILD_LEVEL] > caster->QueryProp(P_GUILD_LEVEL) )
    return BS("Dazu reicht Deine Gildenstufe nicht aus!");
  if (caster->QueryProp(P_FROG))
    return "Als Frosch? IDIOT!\n";
  if (caster->QueryProp(P_BLIND) && caster->QueryProp(P_GUILD_LEVEL)<7)
    return BS("Bei allen Niederhoellen! DU BIST BLIND!");
  if(!ob=present(NEKRO_GUILDITEM_ID, caster))
    return("DU VERSAGER! OHNE DEINE MASKE KANNST DU NICHT ZAUBERN!!\n");
  if(ob->QueryProp(P_WORN) != caster) 
    return("DU VERSAGER! OHNE DEINE MASKE KANNST DU NICHT ZAUBERN!!\n");

  if(ob->QueryVersion()!=LAST_GUILDITEM_UPDATE) 
    return(BS("DEINE MASKE BRAUCHT FRISCHE ENERGIE! HOL SIE DIR VON "
          "XARFAI!\n"));

  if(GetAlign(caster) > 500)
    return BS(
      "HARHAR! Mit Deiner Gesinnung sollte man Dich wie die Paladine "
      "aufschlitzen!");   
  if(caster->QueryProp(P_SP)<=0 )
    return "IDIOT! Ohne MAGIEPUNKTE geht gar nichts!\n";
  return 0;
}


int TryAttackSpell(object victim, int dam, mixed dtypes,
                   mixed is_spell, object caster, mapping sinfo) 
{
  string msg;
  object corpse;
  msg = CAP(caster->query_real_name())+" ("+ caster->QueryProp(P_ALIGN)+ 
    ") gegen "+ victim->name(WEN)+" ("+ victim->QueryProp(P_ALIGN)+
    ") : "+dam ;
  tell_saf(is_spell[SP_NAME]+": "+ msg);
//  write_nekro_log( is_spell[SP_NAME]+".log", msg+"\n");
  dam=::TryAttackSpell(victim, dam, dtypes, is_spell, caster, sinfo);
  if( !victim && !random(20+caster->QueryProp(P_GUILD_LEVEL)*5) ) 
  {
    if(corpse=present("Leiche", ENV(caster)) ) 
    {
      if(corpse->QueryProp(P_KILLER)==caster ) 
      {
        tell_object(caster, BS("HARHAR! Nach Deiner kleinen Demonstration "
              "konnte die verdammte Seele Deines Opfers keine Ruhe finden!"));
        tell_room(ENV(caster), BS("Nach diesem brutalen Angriff "+
            caster->name(WESSEN,1)+" konnte die Seele dieses armen Opfers "
            "keine Ruhe finden und kehrt als Geist zurueck."), ({caster}) );
        CloneGhost(corpse, caster, 10000); 
      }
    }
  }
  return dam;
}

int Darkness(object victim, object caster, int suc) 
{
  object ob;
  tell_room(ENV(caster), BS(sprintf("Eine daemonische Dunkelheit geht "
            "ploetzlich von %s aus!", victim->name(WEM))), ({victim}));
  tell_object(victim, "Du strahlst ploetzlich eine daemonische "
        "Dunkelheit aus!");
  if(ob=present(NEKRO_DARKNESS_OBJ, victim))
    ob->ChangeLightLevel();
  else 
  {
    ob=clone_object(OBJ "darkness");
    ob->Setup(caster, suc);
  }
  return 1;
}

int is_humanoid(string str)
{
  if( member( ({"mensch", "elf", "zwerg", "hobbit", "fee", "troll", "xandim",
                "oger", "ork", "gaffo", "goblin", "gnom", "dunkelelf", 
                "halbelf", "froglok" , "zentaur"}),
      lower_case(str) )!=-1 ) return 1;
  return 0;
}

int is_living(object victim)
{
  if( victim->is_class_member(CL_UNDEAD) || 
      victim->is_class_member(CL_DEMON) ||
      member( ({"geist", "elementar", "golem"}), 
        lower_case(victim->QueryProp(P_RACE)) ) != -1 ||
      victim->QueryProp(P_MAGIC)) 
    return 0;
  return 1;
}

int clone_properties(object new, object old) 
{
  mapping properties;
  int i;
  mixed ind, val;
  string *not_set;
  not_set=({"clone_time","commands","cloner","last_use", "ids"});
  properties=old->__query_properties(old,0)[0];
  ind=m_indices(properties);
  val=m_values(properties);
  for(i=sizeof(ind)-1;i>=0;i--) 
  {
    if(member(not_set,ind[i])==-1) 
      new->SetProp(ind[i],val[i]);
  } 
  return 1;
}

mixed parse_target(string str) 
{
  string wer;
  if(!str) return str;
  if(sscanf(str, "auf %s", wer)!=1) 
    return 0;
  return wer;
}

string checkgender(object pl, string female, string male) 
{
  if(pl->QueryProp(P_GENDER) == FEMALE)
    return female;
  return male;
}

mixed nekro_parse_func(string str) 
{
  string *parts;
  string arg;
  if(!sizeof(regexp( ({ str }), "'.*'"))) 
  {
    write(BS("Magie kann nur wirken wenn sie zwischen den mystischen "
        "Symbolen ' ' steht!"));
    return 0;
  }
  parts=explode(str, "'");
  if(sizeof(parts) < 1) //bei zaubere '' ohne arg
  {
      write(BS("Magie kann nur wirken wenn sie zwischen den mystischen "
        "Symbolen ' ' steht!"));
      return 0;
  }
  arg=implode(parts[1..], " ");
  if(arg[0..0] == " ") 
  {
    arg=arg[1..];
  }
  arg=parse_target(arg);
  return ({ arg, parts[0] });
}

void do_spellbook_damage(int dam, object pl, string killer, mixed kill_msg) 
{
  string killer_orig;
  mixed killmsg_orig;
  killer_orig=QueryProp(P_KILL_NAME);
  killmsg_orig=QueryProp(P_KILL_MSG);
  SetProp(P_KILL_NAME, killer);
  SetProp(P_KILL_MSG, kill_msg);
  pl->do_damage(dam);
  SetProp(P_KILL_NAME, killer_orig);
  SetProp(P_KILL_MSG, kill_msg);
  return;
}

//Archon 14.06.2003
int present_victim(object victim,object caster)
{
  if (!objectp(victim) || !objectp(caster)) return 0;
  // Selber Raum -> OK
  if (environment(caster) && (environment(victim)==environment(caster)))
    return 1;
  // Opfer im Caster -> OK
  if (environment(victim)==caster) return 1;
  return 0;
}

//Archon 23.06.2003 - holt die skillpunkte fuer einen spell
int get_skillpoints(object pl,string skill)
{
  mixed sp;
  sp=call_other(NEKROMASTER, "QuerySkillPoints",pl);
  if (!mappingp(sp))
    return 0;
  else if (sp[skill]) return sp[skill];
  return 0;
}

//Archon 23.06.2003
//Berechnet fuer alle Dam-Spells den modifizierten damage
//selbe gilt fuer Zeiten
int get_dam_with_skillpoints(int dam,int skillpunkte)
{
  if (skillpunkte<0) skillpunkte=0;
  if (skillpunkte>10) skillpunkte=10;
  if (dam<1) return 0;
  dam=dam*(85+2*skillpunkte)/100;
  if (dam<1) dam=1;
  return dam;
}

//Angrox 08.08.2003
varargs int UseBlood(int value) 
{
  int *blood;
  int percent;
  if(!value) value=1;
  if(blood_check_counter>50) {
    blood_check_counter=0;
    blood=call_other(NEKROMASTER, "QueryBloodPool");
    percent=100*blood[0]/blood[1]; 
    if(percent > 85) blood_value_add=1;
    else  blood_value_add=0;
  }
  blood_check_counter++;
  if(!call_other(NEKROMASTER, "UseBloodPool",(value+blood_value_add)*
        BLOODUSE_FACTOR)) 
  {
    tell_object(TP, BS("Du fuehlst einen Schmerz in Dir, als die unheilige "
          "Anrufung einen Teil Deiner Lebensessenz entzieht! Opfert mehr "
          "Seelen, ihr Narren!!"));
    do_spellbook_damage(random(7)+3*value, TP, "Machtgier",0);
    return 0;
  } 
  return 1;
}

//Archon 13.08.2003
//Berechnet Schutzmodifikation fuer einen Dam-Wert
int get_schutz_with_skillpoints(int dam,int skillpunkte)
{
  int schutz;
  if (skillpunkte<1) return 0;
  if (skillpunkte>10) skillpunkte=10;
  if (dam<1) return 0;
  schutz=dam*skillpunkte/100;
  if (schutz<1) schutz=1;
  return schutz;
}


object CloneGhost(object corpse, object caster, int succ)
{
  object ghost;

  ghost=clone_object(NPC "geist");
  ghost->SetGhost(corpse, caster, succ); 
  ghost->move(environment(corpse), M_NOCHECK | M_SILENT);
  corpse->remove(1);

  return ghost;
}
