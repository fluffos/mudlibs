void create() 
{
  ::create();
  SetProp(P_SB_CASTVERB, "zaubere");
  SetProp(P_SB_PARSE_FUNC, "nekro_parse_func");
  SetProp(P_SB_NEW_PREPAREFUNC,1);
  SetProp(P_GLOBAL_SKILLPROPS,
          ([SI_SKILLRESTR_USE: ([SR_FUN:"CheckIfSpellAllowed"]),
            SI_SKILLLEARN:1,         // 0.05% pro 2 A_INT 
            OFFSET(SI_SKILLLEARN):2, // plus 0.05% in jedem Fall
            SI_SKILLLEARN_ATTRIBUTE: A_INT, 
            SI_SPELLFATIGUE:2,       // 2 Sekunden kein neuer Spell
            SI_PREPARE_TIME: 0,     
            SI_TIME_MSG: BS("NARR! Du bist noch zu erschoepft von Deiner "
                           "letzten unheiligen Anrufung!"),
            SI_SP_LOW_MSG: BS("NARR! Deine unheilige Macht reicht fuer diese "
                             "Anrufung nicht aus."),
            SI_NOMAGIC_MSG: BS("BEI ALLEN DAEMONISCHEN GESCHOEPFEN! Eine "
                             "heilige Macht verhindert Deine Anrufung!"),
            SI_LEARN_MSG: BS("Endlich! Deine Anrufung ist nun besser "
                            "geworden!"),
            SI_NOLEARN_MSG: BS("NARR! DU HAST NICHTS GELERNT!"),
            SI_ENABLE_CASTVERB: 0,
          ]));


  //
  //  ALLE DAMAGESPELLS WURDEN UM ca. 10 % gesenkt !!
  //  (siehe kommentar "orginal <zahl>"
  // 

  // --- LVL 1 ---
  AddSpell("auge des khaza-dhunaar", 0,
          ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:1]),
            SI_SKILLLEARN: 2,
            SI_RAW_SPELLCOST: 20,
            SI_DIFFICULTY: 10,
            SI_SPELLFATIGUE: 4,
            SI_PREPARE_TIME: 2,
            SI_PREPARE_MSG: BS("Du konzentrierst Dich auf die unheilige "
                              "Anrufung ..."),
            SI_PREPAREFUNC: "prep_schaetzident",
            SI_SPELLFUNC: "schaetzident",
          ]));

  AddSpell("todesfluch", 0,
          ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL:1]),
            SI_SKILLLEARN: 2,
            SI_RAW_SPELLCOST: 20,
            SI_DIFFICULTY: 10,
            SI_SPELLFATIGUE: 4,
            SI_PREPARE_TIME: 0,
            SI_SKILLDAMAGE_TYPE: ({DT_UNHOLY}),
            SI_SKILLDAMAGE: 225,
            OFFSET(SI_SKILLDAMAGE):100,
            SI_MAX_DAMAGE: 600,
            SI_SPELLFUNC: "verbannung",
          ]));

  AddSpell("parade", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 2]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 2,
                                 A_DEX: 11, A_INT: 5, A_STR: 9]),
             SI_DIFFICULTY: 15,
             SI_RAW_SPELLCOST:15,
             SI_SPELLFATIGUE:4,
             SI_SPELLFUNC: "schildparade",
           ]));
  
}
