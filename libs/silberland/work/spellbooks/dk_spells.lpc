varargs int DoModificationByAlign(int value, object caster, object victim) 
{
  int flag, caster_align, victim_align, diff;
  flag=1;
  if(!intp(value)) return 0;
  if(!objectp(caster)) caster=TP;
  if(!objectp(victim)) flag=0;
  caster_align=GetAlign(caster);
  if(!intp(caster_align)) caster_align=0;
  if(flag) {
    victim_align=GetAlign(victim);
    if(!intp(victim_align)) victim_align=0;
  }
  if(victim_align<-400) victim_align*=2;
  if((diff=caster_align-victim_align)==0) return value;
  //diff=diff<0?-diff:diff;
  //TELL("angrox", sprintf("NEKRO, DoModificationByAlign: align c/v: %d/%d, "
    //    "value v/n: %d/%d\n", caster_align, victim_align, value, 
    //    (int)(value*(1-(diff/3000.0)))));
  return (int)(value*(1-(diff/4000.0)));
  //  diff/3000
  // caster        Victim=1000    400      0       -400     -500   -1000
  // --------------------------------------------------------------------
  // -1100              +70%     +50%     +36%     +23%      +3%    -30%
  // -1000              +66%     +46%     +33%     +20%       0     -33%
  //  -500              +50%     +30%     +16%      +3%     -16%    -50%
  //     0              +33%     +13%       0      -13%     -33%    -66%    
  //
  // diff/4000
  // caster        Victim=1000    400      0       -400     -500   -1000
  // --------------------------------------------------------------------
  // -1100              +52%     +37%     +27%     +17%      +2%    -22%
  // -1000              +50%     +34%     +23%     +15%       0     -25%
  //  -500              +37%     +28%     +12%      +2%     -12%    -37%
  //     0              +25%     +10%       0      -10%     -25%    -50%    
}

//liefert die summer aller bonusobjekte zurueck
int CheckEquip(object caster, string prop)
{
  int r,i,x;
  object *a;
  object w;
  mapping map;
  r=0;
  if (!pointerp(a=caster->QueryProp(P_ARMOURS)) ) a=({});
  if( w=caster->QueryProp(P_WEAPON)) a+=({w});
  a-=({0});
  for(i=sizeof(a);i--;)
  {
    if( objectp(a[i]) && mappingp(map=a[i]->QueryProp(P_NEKRO_BONUS)) &&
        a[i]->QueryProp(P_EQUIP_TIME) + 3 < time())
      if( (x=map[prop]) || (x=map["all"]) ) 
        if(intp(x) && x>0)
          r+=x>MAX_EQUIP_BONUS?MAX_EQUIP_BONUS:x;
  }
  return (r>TOTAL_EQUIP_BONUS?TOTAL_EQUIP_BONUS:r);
}

float CheckItems(object pl) {
  object *obj, wea;
  int i, value, h;
  value=0;
  if(!objectp(pl)) return 0.0;
  obj=({});
  obj=pl->QueryProp(P_ARMOURS);
  if( wea=pl->QueryProp(P_WEAPON) )
    obj+=({wea});
  if(!sizeof(obj)) return 0.0;
  for(i=sizeof(obj)-1;i>=0;i--) {
    if(h=obj[i]->QueryProp(P_NEKRO_SPELLCOST))
      value+=h;
    if(h=obj[i]->QueryProp(P_CURSED)) 
      value+=random(3);
  }
  return value/100.0;
}

nosave mapping DoSpellModification(object caster,mapping sinfo) 
{
  int align, mod, kosten;
  float cost_modifier, fatigue_modifier, dam_modifier;
  cost_modifier=1.0;
  fatigue_modifier=1.0;
  dam_modifier=1.0;
  align=GetAlign(caster);
  if(align>100) {
    // align 500 -> 0.79, align 1000 -> 1.11
    cost_modifier+=sqrt((float)(align)/(float)800);
    fatigue_modifier+=sqrt((float)(align)/(float)800);
  }
  
  if(dtime(time())[19..20]==" 0" &&  // zwischen 0 udn 1 Uhr (geisterstunde)
     sinfo[SI_SKILLFUNC]=="pforte_ins_totenreich" )
    sinfo[SI_RAW_SPELLCOST]=10;  // ist geisterrufen sehr billig
  
  if(dtime(time())[0..6]=="Fre, 13")  // am Freitag dem 13
    cost_modifier-=0.4;               // sind die spells billiger 
  
  if(dtime(time())[5..11]=="31. Oct")  // an Halloween
    cost_modifier-=0.4;               // sind die spells billiger 
  // Wenn die Standarte da ist: +10% Damage
  if (find_object(NEKRO_ROOMS+"gruft") &&
      present("\npaladinstandarte\n", find_object(NEKRO_ROOMS+"gruft"))) {
     dam_modifier+=0.1;
  }
  // align -1000 -> -0.06 .. -0.03,
  if(align<-700) 
    cost_modifier+=(float)((float)(align+700))/((float)(2000+random(2000)));
 
  // Wenn man Gildenstufe 7 ist kosten alle spells um bis zu 3 weniger 
  if(caster->QueryProp(P_GUILD_LEVEL)>6 && sinfo[SI_RAW_SPELLCOST]>=10) 
    sinfo[SI_RAW_SPELLCOST]-=random(4);

  // Kostenreduzierung durch innere Grade:
  // 1. Grad -> +0.28, 7. Grad -> -0.14
  cost_modifier+=(5-caster->QueryProp(P_GUILD_CIRCLE))/14.0;
  
  // Schadenserhoehung durch innere Grade:
  // 1. Grad -> -0.1, 7. Grad -> +0.2
  dam_modifier+=(caster->QueryProp(P_GUILD_CIRCLE)-3)/20.0;

  // Licht: pro negativer Lichtstufe um 0.01 billiger
  // Lichtlvl -1 -> -0.01, Lichtlvl 1 -> +0.01
  if(ENV(caster)) {
    cost_modifier+=ENV(caster)->QueryProp(P_LIGHT)*0.01; 
                   // in std-maessig hellen raeumen kostets mehr.
  }
  // Items Check
  cost_modifier-=CheckItems(caster);

  // Caster hat Dantes Zombievirus
  if(present("DANTE_ZOMBIE_VIRUS", caster))
    cost_modifier-=0.05;

  // Nach einem Tod eine Stunde lang billigere Spells
  if((time()-3600) < caster->QueryProp(P_LAST_DIE_TIME)) 
    cost_modifier-=0.1;

  if(cost_modifier<0.4) cost_modifier=0.4;
  if(fatigue_modifier<0.3) fatigue_modifier=0.3;
  if(dam_modifier>1.3) dam_modifier=1.3;
  
  if(!sinfo[SI_SPELLFATIGUE]) sinfo[SI_SPELLFATIGUE]=2;
  if((sinfo[SI_SPELLFATIGUE]=(int)(sinfo[SI_SPELLFATIGUE]*fatigue_modifier))<2)
    sinfo[SI_SPELLFATIGUE]=2;
  sinfo[SI_RAW_SPELLCOST]=(int)(sinfo[SI_RAW_SPELLCOST]*cost_modifier);
  sinfo[SI_SKILLDAMAGE]=(int)(sinfo[SI_SKILLDAMAGE]*dam_modifier);
  //TELL("angrox", sprintf("NEKROspell: cm: %O, fm: %O, dm: %O, align: %d\n",
  //      cost_modifier, fatigue_modifier, dam_modifier, align));
  return sinfo;
}

nosave int tell_saf(string msg) 
{
  tell_angrox( BSA( msg+ANSI_NORMAL, ANSI_BLACK+ANSI_BG_RED+"*** "));
  return 1;
}

nosave int GetAlign(object spieler) 
{
  int align;
  string msg;
  if(!intp(align=spieler->QueryProp(P_ALIGN))) {
    tell_saf(sprintf("nekro_spells: GetAlign, %s hat falschen Datentyp fuer "
      "Align!", spieler->Name(WER)));
    spieler->SetProp(P_ALIGN, -1);
    tell_object(spieler, "[BUG:"+CAP(getuid(spieler))+"] Falscher Datentyp im "
        "Align!!! Bitte Magier verstaendigen!\n");
    return 0;
  }
  if(align<-1100) return -1100;
  else if(align>1000) return 1000;
  return align;
}

