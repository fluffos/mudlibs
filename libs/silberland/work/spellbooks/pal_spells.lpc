#include "paladine/entfluche.lpc"
#include "paladine/zielattacke.lpc"
#include "paladine/heiligengebet.lpc"
#include "paladine/ruestungssegen.lpc"
#include "paladine/waffensegen.lpc"
#include "paladine/gottsegen.lpc"
#include "paladine/goetterschutz.lpc"
#include "paladine/massenheilung.lpc"
#include "paladine/talisman.lpc"
#include "paladine/spiegelschild.lpc"
#include "paladine/stossgebet.lpc"
#include "paladine/eifer.lpc"
#include "paladine/auferstehung.lpc"


// Shadow? Nein danke!
nomask query_prevent_shadow() { return 1; }

create() {
  ::create();
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Lars");
  SetProp(P_GLOBAL_SKILLPROPS,
          ([SI_SKILLRESTR_USE: ([SR_FUN:"CheckIfSpellAllowed"]),
            SI_SKILLLEARN:2,  // 0.01 pro 2 A_DEX
            OFFSET(SI_SKILLLEARN): 2, // 0.02% sicher
            SI_SKILLLEARN_ATTRIBUTE: A_DEX,
            SI_SPELLFATIGUE:2,
            SI_TIME_MSG: BS("Du musst noch warten, bis Du Dusty das naechste "
                         +"Mal anrufen kannst."),
            SI_SP_LOW_MSG:BS("Du hast zuwenig Magie, um Dusty um Ihre "
                             +"Macht anzurufen."),
            ]));


  AddSpell("erblicke", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 1]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 1,
                                 A_DEX: 10, A_INT: 3, A_STR: 8]),
             OFFSET(SI_SKILLLEARN): 4,
             SI_SKILLLEARN_ATTRIBUTE: A_INT,
             SI_DIFFICULTY: 10,
             SI_RAW_SPELLCOST:10,
           ]));

  AddSpell("verbannung", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 3]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 3,
                                 A_DEX: 12, A_INT: 7, A_STR: 10]),
             SI_DIFFICULTY: 10,
             SI_RAW_SPELLCOST:15, // 10->15 :)
             SI_SKILLDAMAGE_TYPE: ({DT_HOLY}),
             SI_SKILLDAMAGE: 225,
             OFFSET(SI_SKILLDAMAGE):100,
             SI_MAX_DAMAGE: 475,
             SI_DIE_MSG: " wird endgueltig aus dieser Welt verbannt.\n",
           ]));

  AddSpell("heiligenschein", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 2]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 2,
                                 A_DEX: 11, A_INT: 5, A_STR: 9]),
             SI_SKILLLEARN:3,
             OFFSET(SI_SKILLLEARN): 4,
             SI_DIFFICULTY: 20,
             SI_RAW_SPELLCOST:20,
             SI_SPELLFATIGUE:8,
           ]));

  AddSpell("schildparade", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 2]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 2,
                                 A_DEX: 11, A_INT: 5, A_STR: 9]),
             SI_DIFFICULTY: 15,
             SI_RAW_SPELLCOST:15,
             SI_SPELLFATIGUE:4,
           ]));

  AddSpell("schaetz", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 1]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 1,
                                 A_DEX: 10, A_INT: 3, A_STR: 8]),
             SI_SKILLLEARN:3,
             OFFSET(SI_SKILLLEARN): 4,
             SI_SKILLLEARN_ATTRIBUTE: A_INT,
             SI_DIFFICULTY: 10,
             SI_RAW_SPELLCOST:10,
           ]));

  AddSpell("behandle", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 3]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 3,
                                 A_DEX: 12, A_INT: 7, A_STR: 10]),
             SI_DIFFICULTY: 100,
             SI_RAW_SPELLCOST:16, // Heilspells kosten dem Paladin nicht viel
             SI_SPELLFATIGUE:14,
           ]));

  AddSpell("gottheilung", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 4]),
             SI_SKILLRESTR_USE:([SR_FREE_HANDS:2,   // Keine Attri-anforderungen, sonst kann man 
                                 P_GUILD_LEVEL: 4]),// sich selber nicht mehr entfroschen :)
             SI_SKILLLEARN: 4,
             OFFSET(SI_SKILLLEARN): 4,
             SI_DIFFICULTY: 50,
             SI_RAW_SPELLCOST:0,
             SI_SPELLFATIGUE: 20,
           ]));

  AddSpell("wundenblick", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 4]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 4,
                                 A_DEX: 14, A_INT: 9, A_STR: 12]),
             SI_SKILLLEARN:3,
             SI_RAW_SPELLCOST:5,
           ]));

  AddSpell("lokation", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 5]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 5,
                                 A_DEX: 15, A_INT: 11, A_STR: 14]),
             SI_SKILLLEARN:5,
             OFFSET(SI_SKILLLEARN): 4,
             SI_SKILLLEARN_ATTRIBUTE: A_INT,
             SI_DIFFICULTY: 50,
             SI_RAW_SPELLCOST:10,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG:
                  BS("Du konzentrierst Dich und laesst Deinen Geist "
                      +"schweifen..."),
             SI_PREPAREFUNC: "prep_lokation",
           ]));

  AddSpell("heiligengebet", 0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 5]),
             SI_SKILLRESTR_USE:([SR_FREE_HANDS:1,
                                 P_GUILD_LEVEL: 5,
                                 A_DEX: 15, A_INT: 11, A_STR: 14]),
             SI_DIFFICULTY: 15,
             SI_RAW_SPELLCOST:15, // 10->15 :)
             SI_SKILLDAMAGE_TYPE: ({DT_HOLY, DT_LIGHTNING}),
             SI_SKILLDAMAGE: 125,
             OFFSET(SI_SKILLDAMAGE):50,
             SI_MAX_DAMAGE: 400,
             SI_DIE_MSG: " wird von diesem Blitz in ein Aschehaeufchen "
             "verwandelt.\n",
           ]));

  AddSpell("ruestungssegen",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:6]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 6,
                                 A_DEX: 16, A_INT: 12, A_STR: 15]),
             SI_SKILLLEARN:3,
             SI_DIFFICULTY: 30,
             SI_RAW_SPELLCOST: 30,
             SI_SPELLFATIGUE: 6,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG:
                  BS("Langsam versinkst Du in Meditation, um die Ruestung "
                      +"zu segnen..."),
             SI_PREPAREFUNC: "prep_ruestungssegen",
             ]));

  AddSpell("waffensegen",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:7]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 7,
                                 A_DEX: 18, A_INT: 14, A_STR: 17]),
             SI_SKILLLEARN:3,
             SI_DIFFICULTY: 50,
             SI_RAW_SPELLCOST: 50,
             SI_SPELLFATIGUE: 8,
             SI_PREPARE_TIME: 6,
             SI_PREPARE_MSG:
                  BS("Langsam versinkst Du in Meditation, um die Waffe "
                      +"zu segnen..."),
             SI_PREPAREFUNC: "prep_waffensegen",
             ]));

  AddSpell("reparatur",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:7]),
             SI_SKILLRESTR_USE:([SR_FREE_HANDS:2,
                                 P_GUILD_LEVEL: 7,
                                 A_DEX: 18, A_INT: 14, A_STR: 17]),
             SI_SKILLLEARN:3,
             SI_DIFFICULTY: 100,
             SI_RAW_SPELLCOST: 10,
             SI_SPELLFATIGUE: 8,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG:
                  BS("Du bereitest Dich mental auf die Reparatur vor..."),
             SI_PREPAREFUNC: "prep_reparatur",
             ]));

  AddSpell("meditation",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:8]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 8,
                                 A_DEX: 19, A_INT: 15, A_STR: 18]),
             SI_SKILLLEARN: 5,
             OFFSET(SI_SKILLLEARN): 4,
             SI_SKILLLEARN_ATTRIBUTE: A_INT,
             SI_DIFFICULTY: 100,
             SI_RAW_SPELLCOST: 60,
             SI_SPELLFATIGUE: 60,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG: BS(
               "Du faengst an, Dich langsam zu beruhigen und fuer eine "
               "tiefe Meditation vorzubereiten."),
             SI_PREPAREFUNC: "prep_meditation",
             ]));

  AddSpell("goetterschutz",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:9]),
             SI_SKILLRESTR_USE:([SR_FREE_HANDS:1,
                                 P_GUILD_LEVEL: 9,
                                 A_DEX: 21, A_INT: 15, A_STR: 20]),
             SI_SKILLLEARN: 4,
             OFFSET(SI_SKILLLEARN): 3,
             SI_DIFFICULTY: 150,
             SI_RAW_SPELLCOST: 30,
             SI_SPELLFATIGUE: 12,
             SI_PREPARE_TIME: 4,
             SI_PREPARE_MSG:
                BS("Du bereitest Dich auf die Anrufung Dustys vor..."),
             SI_PREPAREFUNC: "prep_goetterschutz",
             ]));

  AddSpell("zielattacke",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:10]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 10,
                                 A_DEX: 18, A_INT: 15, A_STR: 17]),
             SI_SKILLLEARN_ATTRIBUTE: A_STR,
             SI_DIFFICULTY: 200,
             SI_RAW_SPELLCOST: 50,
             SI_SPELLFATIGUE: 6,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: BS("Du konzentrierst Dich auf Deinen "
                                 +"Gegner und flehst Dusty um Ihre "
                                 +"Macht an..."),
             SI_PREPAREFUNC: "prep_zielattacke",
             SI_MAX_DAMAGE: 900,
             SI_NOMAGIC:100,
             SI_DIE_MSG: " stirbt an dieser goettlichen Schwertattacke.\n",
             ]));

  AddSpell("entfluche",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:11]),
             SI_SKILLRESTR_USE:([ P_GUILD_LEVEL: 11,
                                 A_DEX: 24, A_INT: 15, A_STR: 23]),
             SI_SKILLLEARN: 7,
             OFFSET(SI_SKILLLEARN): 5,
             SI_SKILLLEARN_ATTRIBUTE: A_INT,
             SI_DIFFICULTY: 200,
             SI_RAW_SPELLCOST: 150,
             SI_SPELLFATIGUE: 50,
             SI_PREPARE_TIME: 10,
             SI_PREPARE_MSG: BS(
               "Du haeltst inne und rufst Dusty um ihre Hilfe beim "
               "Entfluchen an..."),
             SI_PREPAREFUNC: "prep_entfluche",
             ]));

  AddSpell("gottsegen",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:11]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 11,
                                 A_DEX: 24, A_INT: 15, A_STR: 23]),
             SI_SKILLLEARN: 4,
             OFFSET(SI_SKILLLEARN): 3,
             SI_DIFFICULTY: 200,
             SI_RAW_SPELLCOST: 50, // 40->50 senken koennen wirs immer noch
             SI_SPELLFATIGUE: 24,
             SI_PREPARE_TIME: 6,
             SI_PREPARE_MSG: BS("Du bereitest Dich auf die Segnung vor..."),
             SI_PREPAREFUNC: "prep_gottsegen",
             ]));

  AddSpell("talisman",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:12]),
             SI_SKILLRESTR_USE:([SR_FREE_HANDS:1,
                                 P_GUILD_LEVEL: 12,
                                 A_DEX: 25, A_INT: 15, A_STR: 24]),
             SI_SKILLLEARN: 20,
             OFFSET(SI_SKILLLEARN): 10,
             SI_DIFFICULTY: 150,
             SI_RAW_SPELLCOST: 90,
             SI_SPELLFATIGUE: 40,
             SI_PREPARE_TIME: 12,
             SI_PREPARE_MSG:
                 BS("Du laesst vor Deinen Augen das Talismanschwert "
                       +"entstehen..."),
             SI_PREPAREFUNC: "prep_talisman",
             ]));

  AddSpell("spiegelschild",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:13]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 13,
                                 SR_FREE_HANDS:  1,
                                 A_DEX: 26, A_INT: 15, A_STR: 25,
                                 SM_RACE:(["Fee": ([A_STR:24])])]),
             SI_SKILLLEARN: 4,
             OFFSET(SI_SKILLLEARN): 3,
             SI_DIFFICULTY: 150,
             SI_RAW_SPELLCOST: 50,
             SI_SPELLFATIGUE: 10,
             SI_PREPARE_TIME: 10,
             SI_PREPARE_MSG: BS("Du bereitest Dich mental auf die Bitte zu "
                                "Dusty vor..."),
             SI_PREPAREFUNC: "prep_spiegelschild",
             ]));

  AddSpell("massenheilung",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:14]),
             SI_SKILLRESTR_USE:([SR_FREE_HANDS:0,
                                 P_GUILD_LEVEL: 14,
                                 A_DEX: 27, A_INT: 15, A_STR: 26,
                                 SM_RACE:(["Troll": ([A_DEX:26]), 
                                           "Fee": ([A_STR:24]) ])]),
             SI_SKILLLEARN: 3,
             SI_DIFFICULTY: 300,
             SI_RAW_SPELLCOST: 40, // Heilspells sollten nicht viel kosten
             SI_SPELLFATIGUE: 14,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: BS("Du versinkst in absolute Ruhe..."),
             SI_PREPAREFUNC: "prep_massenheilung",
             ]));


/*
  AddSpell("stossgebet",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:15]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 15,
                                 A_DEX: 28,
                                 A_INT: 15,
                                 A_STR: 27]),
             SI_RAW_SPELLCOST: 100,
             SI_SPELLFATIGUE: 60,
             SI_DIFFICULTY: 400
             ]));
*/
  AddSpell("eifer",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:15]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 15,
                                 A_DEX: 28, A_INT: 15, A_STR: 27,
                                 SM_RACE:(["Troll": ([A_DEX:26]), 
                                           "Fee": ([A_STR:24]),
                                           "Elf": ([A_STR:26])])]),
             SI_DIFFICULTY: 400,
             SI_RAW_SPELLCOST: 100,
             SI_SPELLFATIGUE: 10,
             SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: BS("Du schickst ein kurzes Gebet an Dusty..."),
             SI_PREPAREFUNC: "prep_eifer",
             ]));
  
  AddSpell("auferstehung",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:16]),
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL: 16]),
             SI_SKILLLEARN: 25,
             OFFSET(SI_SKILLLEARN): 15,
             SI_DIFFICULTY: 400,
             SI_RAW_SPELLCOST: 150,
             SI_SPELLFATIGUE: 40,
             ]));
}


//
// SpellSuccess ueberschreiben
//

int
SpellSuccess(object caster, mapping sinfo) {
  int suc;
  suc=::SpellSuccess(caster, sinfo);
  if(!random(3000) && caster->QueryProp(P_ALIGN)<1111) 
    return -suc;
  return suc;
}

int is_wiz_level_ge(object ob, mixed x) { return (query_wiz_level(ob)>=x); }



/*
//
// FUNCTIONS --- FUNCTIONS --- FUNCTIONS --- FUNCTIONS --- FUNCTIONS
//
*/

int ShoutPrayer(object caster) {
  int i;
  mapping prayers;
  prayers=
    ([0:
    "Herrin Dusty, durchdringe uns und fuelle uns mit Deinem Geist,\n"
   +"dring ein in unsere Glieder und gebe ihnen Kraft,\n"
   +"dring ein in unsere Herzen und gebe ihnen Mut,\n"
   +"dring ein in unsere Seelen und gebe ihnen Zorn!\n"
   +"Mein Leben sei Dein, und den Leib des Feindes will ich Dir opfern.\n"
   +"Rotes Blut, heiliges Blut - Blut wasche rein - so sei es!\n",
     1:
    "Dir zu Ehren kaempfe und streite ich!\n"
   +"Dir zu Ehren nur in Deinem Namen!\n"
   +"Dir zu Ehren ich leb',\n"
   +"Dir zu Ehren ich sterb',\n"
   +"Dir zu Ehren bis in Ewigkeit!\n",
     2:
    "Es segne uns Dusty, die Herrin des Krieges!\n"
   +"Es bewahre uns Dusty, die Beherrscherin des Sturmes!\n"
   +"Es erleuchte uns Dusty, die herrliche Loewin des Kampfes!\n"
   +"Es staerke uns die Kraft des gleissendes Stahls,\n"
   +"und unser Wille, der als ehernes Schild vor uns steht!\n"
   +"Dein Wille, o Herrin, sei unser Befehl!\n",
     3:
    "Wir werden sein Ihre Zunge, zu kuenden von Ihrer Herrlichkeit!\n"
   +"Wir werden sein Ihr Herz, zu wahren Ihre Gebote!\n"
   +"Wir werden sein Ihr Geist, zu leben Ihre Gnade!\n"
   +"Wir werden sein Ihr Schild, zu schuetzen die geheiligten Lande!\n"
   +"Wir werden sein Ihr Schwert, zu fechten wider die dunklen Maechte!\n"
    ]);
  if(!ENV(caster)) return 0;
  i=random(sizeof(m_indices(prayers))-1);
  tell_object(caster, BS("Du reckst Deinen Schwertarm gen Himmel und betest "
      +"voller Inbrunst zu Dusty:\n"));
  tell_room(ENV(caster), BS(sprintf("%s reckt %sn Schwertarm gen Himmel "
      +"und betet zu Dusty:\n", caster->Name(WER),
      caster->QueryPossPronoun(FEMALE))), ({caster}));
  tell_object(caster, BSA(prayers[i],"Du rufst: "));
  tell_room(ENV(caster), BSA(prayers[i], TP->Name(WER)+" ruft: "),
      ({caster}));
  return 1;
  }

varargs int
DoModificationByAlign(int value, object caster, object victim) {
  int flag, caster_align, victim_align, diff;
  flag=1;
  if(!intp(value)) return 0;
  if(!objectp(caster)) caster=TP;
  if(!objectp(victim)) flag=0;
  caster_align=GetAlign(caster);
  if(!intp(caster_align)) caster_align=0;
  if(flag) {
    victim_align=GetAlign(victim);
    if(!intp(victim_align)) victim_align=0;
  }
  if(victim_align>400) victim_align*=2;
  value=(int)(value*(1+CalcBiorythm("phy")));
  if((diff=victim_align-caster_align)==0) return value;
  return (int)(value*(1-(diff/(float)2000)));
}

nosave mapping
DoSpellModification(object caster,mapping sinfo) {
  int align, mod, kosten, sac_money;
  float cost_modifier, fatigue_modifier, money;
  object ayla, env_flag, flag, room;
  cost_modifier=1.0;
  fatigue_modifier=1.0;
  align=GetAlign(caster);
  if(find_player("dusty") || find_living(DUSTY_AVATAR)) {
    cost_modifier-=0.1;
    fatigue_modifier-=0.1;
  }
  if(dtime(time())[5..11]=="20. Nov")  // Dustys Geburtstag :)
    cost_modifier-=0.4;
  if(dtime(time())[5..11]=="26. May")  // Hochzeittags Dusty :)
    cost_modifier-=0.4;
  /*
  if(caster->QueryProp("friends"))
    if(member(caster->QueryProp("friends"), "dusty")!=-1) {
      fatigue_modifier-=0.2;
      cost_modifier-=0.1;
    }
  */
  if(caster->QueryProp(P_WAITFOR))
    if(member(caster->QueryProp(P_WAITFOR), "dusty")!=-1)
      cost_modifier-=0.05;
  if(align<0) {
    cost_modifier+=sqrt(-(float)(align)/(float)800);
    fatigue_modifier+=sqrt(-(float)(align)/(float)800);
  }
  if(align>1000) 
    cost_modifier-=((float)align-700)/((float)5000+random(5000));
  if(align>700) {
    cost_modifier-=((float)align-700)/((float)10000+random(5000));
  }
  if((sac_money=call_other(PALADINMASTER, "GetSacrificedMoney", caster))>
      500000) {
    //
    // cost_modifier-=(float)sac_money/(2000000*100); // pro  Million 0.5%
    //
    // ab jetzt ist das eine konvergente Funktion... Zordan
    // cost_modifier-=(float)(1.0-((float)sac_money)/
    //              ((float)sac_money+100000000.0))*((float)sac_money/199000000.0);
    // Ist ja eine schoene Funktion, aber mit etwas umformen laesst sie sich
    // auch in einer lesbaren Form anschreiben.
    money = (float) sac_money / 1000000.0;
    cost_modifier-= 0.45 * money / (money + 100.0);
    //               A                              B
    // A ist der Konvergenzwert der Funktion, also bei unendlich viel geopfertem Geld
    // B bestimmt, wie schnell sich die Funktion dem Konvergenzwert annaehert,
    // je groesser B ist, desto laenger dauert es, bei B=0 wirds eine konstante Funktion

  }
  // Items Check
  cost_modifier-=CheckItems(caster);

  // Caster hat Dantes Zombievirus
  if(present("DANTE_ZOMBIE_VIRUS", caster))
    cost_modifier+=0.2;

  if(caster->QueryProp(P_GUILD_LEVEL)>13 && sinfo[SI_RAW_SPELLCOST]>=13) {
    sinfo[SI_RAW_SPELLCOST]-=caster->QueryProp(P_GUILD_LEVEL)-13;
  }

  // Dustys Biorythmus :-)
  cost_modifier-=CalcBiorythm("int");

  if(cost_modifier<0.35) cost_modifier=0.35;
  if(fatigue_modifier<0.4) fatigue_modifier=0.4;

  // der Paladin hat nach der Meditation noch eine Offenbarung
  if(caster->QueryProp(P_TMP_PALADINE_REVELATION_END) > time()) {
    cost_modifier -= 0.02 + caster->QueryProp(P_GUILD_LEVEL)/100.0;
    fatigue_modifier -= 0.02 + caster->QueryProp(P_GUILD_LEVEL)/100.0;
  }

  // Paladin braucht keine Daemonen.
  if(present("\nknarkdaemon_"+getuid(caster))) {
    if(cost_modifier < 1.0) cost_modifier=1.0;
  }
  
  // Standarte nicht in der Schatzkammer!
  //call_other(ROOM("burg_schatzkammer"), "???");
  room=find_object(ROOM("burg_schatzkammer"));
  if ( room && !present(PALADIN_STANDARTE, room))
  {
    cost_modifier+=0.3;
    fatigue_modifier+=0.3;
    if(ayla_flag_shout) {
      flag=room->QueryProp("standarte");
      if(ayla=find_living("ayla")) {
         ayla_flag_shout=0;
         if(!objectp(flag))
           ayla->command_me("prufe Paladine! Die heilige Standarte wurde "
               "vernichtet! Lasst uns in Demut zu Dusty beten damit sie "
               "uns bald eine Neue schenke!");
         else if(env_flag=ENV(flag)) {
           if(query_once_interactive(env_flag)) {
             ayla->command_me(sprintf("prufe Paladine! %s hat unsere "
                   "Standarte! Ueberzeugt %s das %s sie uns zurueckgibt!",
                   env_flag->Name(WER), env_flag->QueryPronoun(WEN), 
                   env_flag->QueryPronoun(WER)));
           }
           else if(living(env_flag)) {
             ayla->command_me(sprintf("prufe Paladine! Die Standarte "
                   "befindet sich in Besitz von %s! Bringt %s zur "
                   "Strecke und bringt die Standarte zurueck!", 
                   env_flag->name(WEM), env_flag->QueryPronoun(WEN)));
           }
           if(!living(env_flag)) {
             ayla->command_me(sprintf("prufe Paladine! Die heilige "
                   "Standarte befindet sich in einem Gebiet das '"
                   "%s' genannt wird! Holt die Standarte zurueck!", 
                   env_flag->QueryProp(P_INT_SHORT)));
           }
         }
      }
    }
  }
  else {
    ayla_flag_shout=1;
  }

  if(!sinfo[SI_SPELLFATIGUE]) sinfo[SI_SPELLFATIGUE]=2;
  if((sinfo[SI_SPELLFATIGUE]=(int)(sinfo[SI_SPELLFATIGUE]*fatigue_modifier))<2)
                 sinfo[SI_SPELLFATIGUE]=2;
  sinfo[SI_RAW_SPELLCOST]=(int)(sinfo[SI_RAW_SPELLCOST]*cost_modifier);


  // Abfrage auf P_PALADIN_LAST_PGESANG_TIME -> 15 Minuten 30% mehr schaden
  if((caster->QueryProp(P_PALADIN_LAST_PGESANG_TIME)+(15*60)) > time()) {
    sinfo[SI_SKILLDAMAGE]=to_int(1.3*sinfo[SI_SKILLDAMAGE]);
  }


  return sinfo;
}

/* Hier wird geprueft, ob der Spell gesprochen werden darf */
CheckIfSpellAllowed(object caster) {
  object ob;
  // ok, sicherheitshalber mal die Gildenstufe abfragen :(
  if( caster->QueryProp(P_GUILD_LEVEL) > 16) {
    write_secure_log(sprintf("%s: %s hatte Level %d!\n",
      dtime(time()), CAP(getuid(caster)),caster->QueryProp(P_GUILD_LEVEL)));
    caster->SetProp(P_GUILD_LEVEL, 16);
  }
  if(caster->QueryProp(P_GHOST)) {
    printf(BS("PALADIN! Nur in der Stofflichkeit kannst Du Dusty "
        +"um ein Wunder anflehen!\n"));
    return "";
  }
  if(caster->QueryProp(P_ALIGN)<-500) {
    printf(BS("FREVLER! WIE KANNST DU ES WAGEN, BEI EINER SOLCHEN "
        +"GESINNUNG DUSTY ANZURUFEN! FREVLER!\n"));
    return "";
  }
  if(!ob=present(WAPPENROCK, caster)) {
    printf(BS("Ohne den goettlichen Wappenrock kannst Du nicht zaubern!\n"));
    write_secure_log(sprintf("%s: %s versucht ohne Wappenrock zu zaubern!\n",
        ctime(), CAP(getuid(caster))));
    return "";
  }
  if(ob->QueryVersion()!=LAST_GUILDITEM_UPDATE) {
    printf(BS("Bei Dusty! Dein Wappenrock ist total zerrissen! Du solltest "
         "Dir einen Neuen von Ayla holen! (frag ayla nach neuem "
         "wappenrock)"));
    return "";
  }
  return 0;
}



// Alignbeschraenkung auf -1000 ... +1000
nosave int GetAlign(object spieler) {
  int align;
  string msg;
  if(!intp(align=spieler->QueryProp(P_ALIGN))) {
  tell_za(sprintf("pal_spells: GetAlign, %s hat falschen Datentyp fuer "
      +"Align!", spieler->Name(WER)));
  return 0;
  }
  if(align>5000 && !spieler->QueryProp(P_TESTPLAYER) &&
      !IS_WIZARD(spieler) && interactive(spieler))
  {
    msg=sprintf("PL: %s, ALIGN: %d, PO: %O",getuid(spieler), align,
        previous_object());
    write_paladin_log("align.log", msg+"\n");
    tell_za(msg);
    spieler->SetProp(P_ALIGN, 1000);
  }
  if(align<-1100) return -1100;
  else if(align>1100) return 1100;
  if(interactive(spieler) && call_other("/gilden/obj/check_user", "check_user",
        getuid(spieler)))
  {
    align/=2;
  }
  return align;
}

