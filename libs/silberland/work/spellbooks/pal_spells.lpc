/*
//  DAS SPELLBOOK DER PALADINE
//
//  (c) Angrox@SilberLand 28.05.1998
//
//
//  Updates:
//      15-08-2000: May the balance be with me :)
//                  Stossgebet aufgewertet, max Zeit verdoppelt, dafuer _nur_
//                  im Kampf, Weiters Heilung um random(align/25)
//      10-08-2000: Schildparade laenger, dafuer weniger Wirkung,
//                  insgesamt ~ gleich!
//      05-08-2000: Ausgabe beim Behandeln geaendert (LE Anzeige NACH heilen!)
//      17-04-2000: Magic Items koennen nicht mehr durch
//                  waffensegen/ruestungssegen erhoeht werden
//      09-04-2000: Gildenpcs werden durch behandle doppelt geheilt
//      30-12-1999: Typofix im Fakedeath
//      15-12-1999: Ab nun kann man auch NPCs heilen
//      01-11-1999: Ein paar Texte hinzugefuegt fuer mehr Flair
//      28-10-1999: Von Nekromanten verpestete Waffen, die verflucht sind,
//                  koennen nicht entflucht werden.
//      13-01-1999: Erblicke auf den Schwertkampf angepasst
//      10-01-1999: Lokation nicht mehr moeglich, wenn Victim im gleichen Raum
//      09-01-1999: Bei Schaetz in Schwertkampf keine Spieler mehr
                    Schildparade um 0-4 Sek aufgewertet je nach Erfolg
                    Waffensegen abgewertet von 2/3 auf 1/2 der WC !!!!!
                      und auf wc_boni>300 check wegen MAX_WC
//      06-01-1999: Schaetz zeigt an, ob man bei Gegner Schwertkampf lernt
//      28-05-1998: Release
//
*/

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <attributes.h>
#include <combat.h>
#include <wizlevels.h>
#include <new_skills.h>
#include <material.h>
#include <ansi.h>
#include <class.h>
#include "/gilden/paladine/paladin.h"
#include "/gilden/paladine/blessing.h"
#define P_NEKRO_PESTERED "nekro_pestered"
//#include "/gilden/nekromanten/nekro_properties.h"
inherit "/std/spellbook";

// Funktionen includen
#include "/spellbooks/functions/message.lpc"


#define MAX_EQUIP_BONUS 30
#define TOTAL_EQUIP_BONUS 100


// Globvars
nosave mapping
     diener=([0:({"Deinem Diener","Deinem Diener", "Deiner Dienerin",
                  "Deines Dieners"}),
              1:({"Deinen Diener","Deinen Diener", "Deine Dienerin",
                  "Deinen Diener"})]);
nosave int ayla_flag_shout=1;
nosave int enable_spell_log=0;
// Prototypen
varargs int
DoModificationByAlign(int value, object caster, object victim);
nosave mapping DoSpellModification(object caster,mapping sinfo);
CheckIfSpellAllowed(object caster);
int ShoutPrayer(object caster);
//nosave varargs int Message(object caster, object victim, string msg, int flag);
nosave int GetAlign(object spieler);
nosave int tell_za(string msg);
nosave int DoFailure(object caster, int rnd);
nosave int DoFakeDeath(object caster);
float CheckItems(object pl); 
nosave string check_plural(object ob, string singular, string plural);
float CalcBiorythm(string what);
nosave string int2string(int wert);
int CheckEquip(object caster, string prop);



/**************************************
 Hier werden die spells reingeladen
 **************************************/
#include "paladine/erblicke.lpc"
#include "paladine/verbannung.lpc"
#include "paladine/schaetz.lpc"
#include "paladine/schildparade.lpc"
#include "paladine/heiligenschein.lpc"
