nosave int tell_za(string msg) {
  tell_angrox(BSA(msg, ANSI_RED+ANSI_BLINK+"*** "+ANSI_NORMAL));
  tell_zordan(BSA(msg, ANSI_RED+ANSI_BLINK+"*** "+ANSI_NORMAL));
  return 1;
}


void Erfolg(object caster, string spell, mapping sinfo) {
  int abil;
  if(!interactive(caster)) 
    return;
  abil=sinfo[SI_SKILLABILITY];
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "CheckAbility", caster, spell, abil);
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0,
      "paladine");
  // NEKRO HINT
  // Kann nach entdeckung der nekros wieder entfernt werden
  //if(!random(40)) {
  //  call_out("nekro_vision", random(100)+100, caster);
 // }
  if (abil!=MAX_ABILITY && random(MAX_ABILITY)<abil-MAX_ABILITY+100 )
  {
    caster->ModifySkill( spell, ([ SI_SKILLABILITY: ++abil ]), 0, "paladine");
    tell_object(caster,"Du lernst aus Deinem Erfolg.\n");
    if (abil==MAX_ABILITY)
    {
        Message(caster,0,break_string("Bravo Paladin, Du beherrschst '"+
          CAP(spell)+"' jetzt"+int2string(abil),80,"Ayla teilt Dir mit: "),0);
    }
  }
  if(!random(20))
    if (spell != "verbannung" && spell != "zielattacke" &&
        spell != "heiligengebet")
      ShoutPrayer(caster);
  return;
}

nosave string int2string(int wert) {
 string str;
 switch(wert) {
   case 0..500    : str=" wie ein Druide - naemlich ueberhaupt nicht!"; break;
   case 501..1000 : str=" fast ueberhaupt nicht!"; break;
   case 1001..1500: str=" miserabel wie ein Vagabund!"; break;
   case 1501..2000: str=" wie ein blutiger Anfaenger!"; break;
   case 2001..2500: str=" wie ein junger Knappe!"; break;
   case 2501..3000: str=" schlecht!"; break;
   case 3001..3500: str=" maessig!"; break;
   case 3501..4000: str=" mittelmaessig!"; break;
   case 4001..4500: str=" unterdurchschnittlich wie ein Soeldner!"; break;
   case 4501..5000: str=" durchschnittlich!";  break;
   case 5001..5500: str=" ueberdurchschnittlich!"; break;
   case 5501..6000: str=" gut!"; break;
   case 6001..6500: str=" sehr gut!"; break;
   case 6501..7000: str=" wie ein Burgwaechter!"; break;
   case 7001..7500: str=" wie ein hochdekorierter Veteran!"; break;
   case 7501..8000: str=" wie ein hochbegabter Meister!"; break;
   case 8001..8500: str=" beinahe engelgleich!"; break;
   case 8501..9000: str=" engelgleich!"; break;
   case 9001..9500: str=" legendaer!"; break;
   case 9501..9999: str=" beinahe goettlich!"; break;
   case 10000     : str=" goettlich!"; break;
  }
  return str;
}

void Misserfolg(object caster, string spell, mapping sinfo) {
  int old_abil,new_abil;
  object victim;
  string txt;
  if(!interactive(caster)) 
    return;
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0, "paladine");
  if(sinfo[SI_SKILLARG] && (victim=present(sinfo[SI_SKILLARG], ENV(caster)) ||
        victim=present(sinfo[SI_SKILLARG], caster)))
  {
    if(victim->id(SID_NOLEARN)) {
      TELL("angrox", sprintf("PAL_SPELLS(3936), ID: SID_NOLEARN, object: %O\n", 
          victim));
       write(BS("Paladin! Du lernst aus Deinem Fehler nicht dazu!"));
      return;
    }
  }
  old_abil = sinfo[SI_SKILLABILITY];
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "CheckAbility", caster, spell, old_abil);
  Learn(caster, spell, sinfo);
  new_abil=caster->QuerySkillAbility(spell);
  if(!IS_WIZARD(caster) && !caster->QueryProp(P_TESTPLAYER))
    call_other(ABILMASTER, "UpdateAbility", caster, spell, new_abil);
  if (old_abil < new_abil) {
    switch(random(5)) {
      case 0:
        write(BS("Auch wenn Du versagt hast, lernst Du aus Deinem Fehler, "
                +"Paladin!"));
        break;
      case 1:
        write(BS("Dein Fehler verhilft Dir '"+CAP(spell)+"' weiter zu lernen, "
                +"Paladin!"));
        break;
      case 2:
        write(BS("Du dankst Dusty fuer den Fehlschlag und lernst fuer die "
                +"Zukunft dazu, Paladin!"));
        break;
      case 3:
        write(BS("Trotz Deines Fehlschlages lernst Du aus Deinem Fehler dazu, "
                +"Paladin!"));
        break;
      default:
      case 4:
        write(BS("Paladin! Du lernst aus Deinem Fehler dazu!"));
        break;
    }
    if((old_abil/500) != ((new_abil-1)/500)) {
      if(find_living("ayla")) {
        txt=int2string(new_abil);
        Message(caster,0,break_string("Bravo Paladin, Du beherrschst '"+
          CAP(spell)+"' jetzt"+txt,80,"Ayla teilt Dir mit: "),0);
      }
    }
  } else
    write(BS("Du lernst nichts mehr, Paladin! Du musst erst besser werden!"));
  DoFailure(caster, 5);
  return;
}

nosave int DoFailure(object caster, int rnd) {
  int max_val, val;
  max_val=68-(int)(3*68*CalcBiorythm("emo"));
  if(max_val < 65) max_val=65;
  if(rnd<1) rnd=1;
  if(present(PALA_NOFAILURE, caster))
    return 1;
  if(!random(rnd)) {
    val=random(max_val+1);
    if(val >= 0 && val <= 5) {
      printf(BS("Du opferst Dusty ein paar Lebenspunkte!\n"));
      caster->reduce_hit_point(random(20)+1);
    }
    else if (val >= 6 && val <= 10) {
      printf("Deine Gesinnung sinkt!\n");
      caster->SetProp(P_ALIGN, caster->QueryProp(P_ALIGN)- random(50)); 
    }
    else if (val >= 11 && val <= 15) {
      printf(BS("Du musst mehr Magie opfern, um Dustys Zorn zu "
                    +"besaenftigen."));
      caster->AddSp(-random(40)+1);
    }
    else if (val >= 16 && val <= 20) {
      printf(BS("Du bist ploetzlich ziemlich eingeschuechtert!\n"));
      caster->SetProp(P_WIMPY, caster->QueryProp(P_WIMPY)+
                   (caster->QueryProp(P_MAX_HP)-caster->QueryProp(P_HP))/2);
    }
    else if (val >= 21 && val <= 25) {
      printf(BS("Du kannst fuer einige Zeit lang Dusty nicht "
                     +"mehr anrufen!!!"));
      caster->SetProp(P_NEXT_SPELL_TIME, time()+random(25)+50);
    }
    else if (val >= 26 && val <= 30) {
      printf(BS("Dusty laesst Dich ob Deines Misserfolges erblinden!!!"));
      caster->SetProp(P_BLIND, random(20)+20);
    }
    else if (val >= 31 && val <= 35) {
      printf(BS("Dusty laesst Dich ob Deines Misserfolges ertauben!!!"));
      caster->SetProp(P_DEAF, random(40)+20);
    }
    else if (val >= 36 && val <= 40) {
      printf(BS("Du fuehlst Dich ploetzlich so erschoepft!"));
      caster->SetProp(P_MV, random(20)+25);
    }
    else if (val >= 41 && val <= 45) {
      printf(BS("Du fuehlst Dich *hicks* beschipscht!\n"));
      caster->SetProp(P_ALCOHOL, caster->QueryProp(P_MAX_ALCOHOL));
    }
    else if (val >= 46 && val <= 50) {
      printf(BS("Du fuehlst Dich ploetzlich sehr gesaettigt!\n"));
      caster->SetProp(P_FOOD, caster->QueryProp(P_MAX_FOOD));
    }
    else if (val >= 51 && val <= 55) {
      printf(BS("Irgendwie fuehlst Du keinen Durst mehr!\n"));
      caster->SetProp(P_DRINK, caster->QueryProp(P_MAX_DRINK));
    }
    else if (val >= 56 && val <= 60) {
      printf(BS("Dusty verfroscht Dich ob Deines Misserfolges!\n"));
      caster->SetProp(P_FROG, random(40)+20);
    }
    else if (val >= 61 && val <= 63) {
      printf(BS("Durch Deinen Misserfolg bist Du wie paralysiert!"));
      caster->SetProp(P_PARALYZED,
                    ([PARALYZE_TIME:random(10)+1,
                      PARALYZE_MSG: BS("Durch Deinen Misserfolg bist "
                           +"Du wie paralysiert!\n"),
                      PARALYZE_END: BS("Gepriesen sei Dusty! Du kannst "
                           +"Dich wieder bewegen!\n"),
                      PARALYZE_MSG_OTHER: BS(sprintf("%s ist durch " +
                           caster->QueryPossPronoun(MALE, WEN, SINGULAR)
                           +" Misserfolg wie gelaehmt!\n",
                           caster->Name(WER))),
                      PARALYZE_END_OTHER: BS(sprintf("%s kann sich wieder "
                           +"bewegen!\n", caster->Name(WER)))
                    ]));
    }
    else if (val >= 64 && val <= max_val) {
      call_out("DoFakeDeath",0,caster);
    }
    else {
      printf(BS("Nichts passiert.\n"));
    }
  }
}

int DustyKillsPaladins(object paladin) {
  if(getuid(TP)!="dusty") return 0;
  return DoFakeDeath(paladin);
}

nosave int DoFakeDeath(object caster) {
  object ob;
  
  // 2014-03-20 Gwenshara: sicherheits-if um "doppeltode" zu verhindern
  if(caster->QueryProp(P_GHOST))
    return 1;
  
  if(ENV(caster))
    caster->SetProp(P_TMP_PRAY_ROOM, file_name(ENV(caster)));
  Message(caster, 0, BS("Dusty bestraft Deine Unverfrorenheit "
          +"mit Deinem sofortigen TOD!\n"), 0);
  Message(caster, 0, BS(sprintf("%s bricht tot nieder. Offenbar ist %s "
          +"bei Dusty in Ungnade gefallen.\n", caster->Name(WER),
          caster->QueryPronoun(WER))), 3);
  caster->SetProp(P_GHOST,1);
  caster->SetProp(P_KILLER, TO);
  caster->SetProp(P_BLIND,0);
  caster->SetProp(P_DEAF, 0);
  caster->SetProp(P_POISON,0);
  caster->SetProp(P_FOOD, 0);
  caster->SetProp(P_DRINK, 0);
  caster->SetProp(P_ALCOHOL, 0);
  SetProp(P_KILL_NAME,"Dustys Macht");
//  SetProp(P_KILL_MSG,"Test");
//  ob=clone_object("/room/death/death_mark");
//  ob->move(caster, M_NOCHECK|M_SILENT);
  caster->SetProp("no_ghost_after_seq", 1);
  caster->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW|M_SILENT);
  caster->SetProp(P_KILLER,0);
//  CHMASTER->join("Tod",TO);
//  catch(CHMASTER->send("Tod",TO,
//      sprintf("Dustys Macht hat gerade %s vernichtet!", CAP(getuid(caster))),
//      MSG_SAY));
  return 1;
}

float CheckItems(object pl) {
  object *obj, wea;
  int i, value, h;
  value=0;
  if(!objectp(pl)) return 0.0;
  obj=pl->QueryProp(P_ARMOURS);
  if( wea=pl->QueryProp(P_WEAPON) )
    obj+=({wea});
  if(!sizeof(obj)) return 0.0;
  for(i=sizeof(obj)-1;i>=0;i--) {
    if(objectp(obj[i]) && intp(h=obj[i]->QueryProp("paladin_spellcost"))) {
      value+=h;
    }
  }
  return value/100.0;
}

int FindPaladinFriends(object ob) {
  if(call_other(NPCMASTER, "IsPaladinEnemy", ob)) return 0;
  if(
      living(ob) && 
      ob->QueryProp(P_ALIGN) > 0 && 
      !IS_WIZARD(ob) &&
      !ob->QueryGuest() &&
      !ob->QueryClass(CL_UNDEAD) &&
      !ob->QueryClass(CL_DEMON)
    )
    return 1;
  return 0;
}


//
// Plural checken
// 
nosave string check_plural(object ob, string singular, string plural) {
  if(ob->QueryProp(P_PLURAL)) return plural;
  if(ob->QueryProp(P_AMOUNT)>1) return plural;
  return singular;
}

//
// File Log einschalten
//
int enable_spell_logging() {
  if(!IS_ARCH(TP)) return 0;
  enable_spell_log=1;
  return 1;
}

int disable_spell_logging() {
  if(!IS_ARCH(TP)) return 0;
  enable_spell_log=0;
  return 1;
}

//
// Biorhytmus berechnen
/*
Formel f�r die 3 Kurven:
Zustand (Alter in Tagen) = 100% * sin ( 2*PI *(Alter / 23))
  Zustand (Alter in Tagen) = 100% * sin ( 2*PI *(Alter / 28))
  Zustand (Alter in Tagen) = 100% * sin ( 2*PI *(Alter / 33))
  (2*PI = 360 Grad)
  
  - Physische Kurve: 23 Tage
  - Emotionale Kurve: 28 Tage
  - Intellektuelle Kurve: 33 Tage
  //
  //
*/
float CalcBiorythm(string what) {
  float pi;
  int days,ddays;
  pi=3.1415926535897932;
  switch(what) {
    case "phy": days=23; break;
    case "emo": days=28; break;
    case "int": days=33; break;
  }
  ddays=call_other(PALADINMASTER, "QueryDustyAge");
  return 5*sin(2*pi*((float)ddays/days))/100.0;
}

//liefert die summe aller bonusobjekte zurueck
int CheckEquip(object caster, string prop)
{
  int r,i,x;
  object *a;
  object w;
  mapping map;
  r=0;
  if (!pointerp(a=caster->QueryProp(P_ARMOURS)) ) a=({});
  if( w=caster->QueryProp(P_WEAPON)) a+=({w});
  a-=({0});
  for(i=sizeof(a);i--;)
  {
    if( objectp(a[i]) && mappingp(map=a[i]->QueryProp(P_PALADIN_BONUS)) &&
        a[i]->QueryProp(P_EQUIP_TIME) + 3 < time())
      if( (x=map[prop]) || (x=map["all"]) ) 
        if(intp(x) && x>0)
          r+=x>MAX_EQUIP_BONUS?MAX_EQUIP_BONUS:x;
  }
  return (r>TOTAL_EQUIP_BONUS?TOTAL_EQUIP_BONUS:r);
}

void nekro_vision(object caster) {
  if(!caster) return ;
  if(find_call_out("nekro_vision") != -1 ) return ;
  if(!caster->QueryProp("had_nekro_vision")) {
    caster->SetProp("had_nekro_vision", time());
    TELL("angrox", sprintf("*** PAL SPELLS: Nekroinfo -> %s\n", getuid(caster)));
    tell_object(caster, BS("Ploetzlich siehst Du vor Deinem geistigen Auge "
          "eine grauenhafte Vision:")+"\n");
    tell_object(caster, BS("Das Silberland liegt vor Dir ... fast voellig in "
          "Licht getaucht. Ploetzlich schiebt sich eine skelettierte Hand in "
          "Dein Blickfeld und will nach dem Silberland greifen. Eine nie "
          "gekannte "
          "Dunkelheit legt sich ueber das Land ...")+"\n");
    tell_object(caster, BS("Die Vision endet und Du fuehlst Dich seltsam..."));
    return;
  } 
  else if(!caster->QueryProp("had_nekro_vision2")) {
    caster->SetProp("had_nekro_vision2", time());
    TELL("angrox", sprintf("*** PAL SPELLS: Nekroinfo2 -> %s\n", getuid(caster)));
    tell_object(caster, BS("Ploetzlich siehst Du vor Deinem geistigen Auge "
          "eine weitere grauenhafte Vision:")+"\n");
    tell_object(caster, BS("Dein Blick faellt auf ein Dir unbekanntes "
          "Gebiet ... auf einen Steinkreis dessen Monolithen seltsam "
          "verzerrt emporragen, so wie die Klauen einer Hand. Die Monolithen "
          "strahlen eine unbarmherzige Kaelte aus, das schwarze Material "
          "ist von blutroten Adern durchzogen die unablaessig pulsieren ...")+
        "\n");
    tell_object(caster, BS("Die Vision endet und Du fuehlst Dich unwohl ..."));
    return;
  }
  else if(!caster->QueryProp("had_nekro_vision3")) {
    caster->SetProp("had_nekro_vision3", time());
    TELL("angrox", sprintf("*** PAL SPELLS: Nekroinfo3 -> %s\n", getuid(caster)));
    tell_object(caster, BS("Ploetzlich siehst Du vor Deinem geistigen Auge "
          "eine weitere Vision:")+"\n");
    tell_object(caster, BS("Du liegst nackt auf einem Altar. Du kannst "
        "Dich nicht bewegen, Dein Blick ist starr nach oben gerichtet. Weit "
        "ueber "
        "Dir kannst Du die Decke einer Hoehle ausmachen ... "));
    tell_object(caster, BS("Seltsame Worte dringen an Dein Ohr, Du kannst "
        "sie nicht verstehen. Ploetzlich taucht eine Gestalt ueber Dir auf, "
        "in eine dunkle Kutte gehuellt, mit einem Dolch in der Hand. "
        "Die Hand saust nach unten und der Dolch bohrt sich in Deine "
        "Brust, schneidet Dir Dein Herz heraus ... Deine Sinne schwinden "
        "und Du weisst das ist das Ende ...")+"\n");
    tell_object(caster, BS("Die Vision endet und Du fuehlst Dich dem Tode "
          "knapp entronnen ..."));
    return;
  }
  else if(!caster->QueryProp("had_nekro_vision4")) {
    caster->SetProp("had_nekro_vision4", time());
    TELL("angrox", sprintf("*** PAL SPELLS: Nekroinfo4 -> %s\n", getuid(caster)));
    tell_object(caster, BS("Ploetzlich siehst Du vor Deinem geistigen Auge "
          "eine weitere Vision:")+"\n");
    tell_object(caster, BS("Du bist ein Zwerg ... man hat Dich angekettet "
          "und zwingt Dich einen Gang zu graben. Irgendwann stoesst "
          "Du gegen etwas sehr Hartes, gegen das Deine Spitzhacke nicht "
          "ankommt. Sie zwingen Dich weiter zu graben, als ploetzlich "
          "Gestalten in dunklen Kutten erscheinen und alle niedermachen ...")+
        "\n");
    tell_object(caster, BS("Die Vision endet und Du fuehlst Dich dem Tode "
          "sehr knapp entronnen ..."));
    return;
  }
  else if(!caster->QueryProp("had_nekro_vision5")) {
    caster->SetProp("had_nekro_vision5", time());
    TELL("angrox", sprintf("*** PAL SPELLS: Nekroinfo4 -> %s\n", getuid(caster)));
    tell_object(caster, BS("Ploetzlich siehst Du vor Deinem geistigen Auge "
          "eine weitere Vision:")+"\n");
    tell_object(caster, BS("Seit Jahrhunderten liegst Du hier ... "
          "Deine Seele ist an Deine Ueberreste gefesselt ... Du wartest "
          "auf Erloesung ...")+"\n");
    tell_object(caster, BS("Die Vision endet und Du fuehlst Dich verloren "
          "..."));
    return;
  }
  return;
}

// Wird von einigen Spells gebraucht, die nach ihrem Ende etwas updaten wollen
public void UpdateAttributesOf(object pl) {
  call_out("_update_attributes", 0, pl);
}

public void _update_attributes(object pl) {
  pl->UpdateAttributes();
}
