	     ]));

  AddSpell("bestrafung",90,10);
  AddSpell("aufloesung",80,10);

}

// Abchecken ob man zaubern darf

checkstatus(object caster) 
{
  if(caster->QueryProp(P_FROG)) 
    {
      write(BS("Du kannst als Frosch nicht zaubern!"));
      return "";
    }
  if(caster->QueryProp(P_GHOST)) 
    {
      write(BS("Du kannst als Geist nicht zaubern!"));
      return "";
    }
  if(caster->QueryProp(P_ALIGN) > 400) 
    {
      write(BS("Du bist nicht boese genug zum Zaubern!"));
      return "";
    }
  return 0;
}

// Abchecken bei Erfolg

void Erfolg(object caster, string spell, mapping sinfo) 
{
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0,"spinnenkrieger");
  return ::Erfolg(caster,spell,sinfo);
}

// Abchecken bei Misserfolg

void Misserfolg(object caster, string spell, mapping sinfo) 
{
  int old_abil;
  int new_abil;

  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR]+1]),0,"spinnenkrieger");

  if(!total_fail) 
    {
      switch(spell) 
	{
	case "identifiziere":
	  write("Du kannst leider nichts besonderes erkennen.\n");
	  break;
	case "schaetz":
	  write("Du verschaetzt Dich total.\n");
	  break;
	case "parieren":
	  write("Du schaffst es nicht die Attacken Deines Gegners zu parieren.\n");
	  break;
	case "schnell":
	  write("Lloth gewaehrt Dir diesen Vorteil nicht!\n");
	  break;
	case "dunkelkugel":
	  write("Deine Dunkelkugel zerplatzt...\n");
	  tell_room(ENV(caster), caster->Name(WESSEN)+" laesst eine Kugel "+
		    "in "+caster->QueryPossPronoun(WEM)+" Hand entstehen...\n"+
		    "Jedoch sie zerplatzt...\n",({caster}));
	  break;
	case "blutbad":
	  write("Du kannst Dich nicht richtig konzentrieren um Lloth's Gebet auszusprechen!\n");
	  tell_room(ENV(caster), caster->Name(WER)+" versucht ein Gebet zu Lloth zu sprechen...\n",
		    ({caster}));
	  break;
	case "kniestoss":
	  write("Dein Knie prallt seitlich ab...\n");
	  tell_room(ENV(caster), caster->Name(WER)+" verpatzt einen Kniestoss!\n",
		    ({caster}));
	  break;
	case "ellenbogenschlag":
	  write("Dein Ellenbogen faehrt ins Leere...\n");
	  tell_room(ENV(caster), caster->Name(WER)+" verpatzt einen Ellenbogenschlag!\n",
		    ({caster}));
	  break;
	default:
	  write("Lloth scheint Dich nicht erhoert zu haben...\n");
	  break;
    }
  }
  total_fail=0;  // gleich zuruecksetzen, besser und sicherer ist das
  old_abil=sinfo[SI_SKILLABILITY];
  //  if(LLOTH->Gunst(caster))
  Learn(caster, spell, sinfo);
  sinfo=caster->QuerySkill(spell);
  if(mappingp(sinfo))
    new_abil=sinfo[SI_SKILLABILITY];
  else
    new_abil=(int)sinfo;
  if(old_abil < new_abil)
    {
      write("Lloth gewaehrt Dir, aus Deinem Fehler zu lernen.\n");
      DB("*** Spinnenkrieger: "+caster->Name()+" Spell \'"+spell+"\' lernt: "+
	 (new_abil-old_abil)+"\n");
    }
  else
    write("Lloth laesst Dich nicht aus Deinem Fehler lernen.\n" );
  return;
}

// Dunkelkugel, sie wird einfach in den Raum geworfen und es wird Success-abh
// duenkler und dauert unterschiedlich lang. Gilt auch als angriffspell
// der Gegner ist dadurch verwirrt...

int dunkelkugel(object caster, mapping sinfo) 
{
  int dauer, lvl, suc;
  string v;
  object du,vic;

  if(caster->InFight())
    return write("Konzentriere Dich lieber auf den Kampf!!\n"),0;
  if(present(D_DUNKEL,ENV(caster)))
    return write("Die Magie einer bereits vorhandenen Kugel stoert Dich!\n"),0;

  write("In Deiner Hand entsteht eine kleine Kugel der Dunkelheit.\n");

  suc=SpellSuccess(caster,sinfo);

  if((-3000 <= suc) && (suc <= 0)) return MISSERFOLG;

  dauer=caster->QueryAttribute(A_INT)+15*random(sinfo[SI_SKILLABILITY]/1000)+
    caster->QueryProp(P_GUILD_LEVEL)*2+caster->QueryAttribute(A_DEX);

  lvl=-1-suc/2000-random(caster->QueryProp(P_GUILD_LEVEL)/2);

  du=clone_object(SOBJ "dunkelkugel");
  du->move(environment(caster), M_NOCHECK);
  du->verdunkeln(caster,lvl,dauer);

  if(v=sinfo[SI_SKILLARG])
    if(vic=present(v,ENV(caster)))
      {
	TryDefaultAttackSpell(vic,caster,sinfo,
			      ([SP_NAME:"Dunkelkugel",SP_SHOW_DAMAGE:1]));
	if(vic)
	  {
	    vic->SetProp(P_BLIND, 
			 ([BLIND_MSG:"Du bist von der Dunkelheit geblendet!\n",
			 BLIND_TIME:suc/50+random(caster->QueryAttribute(A_DEX))]));
	    if(suc>5000 && random(3))
	      {
		vic->SetProp(P_DISABLE_ATTACK, random(3));
		write("Dein Gegner ist nun vollkommen verwirrt. Nuetze die "+
		      "Gelegenheit!\n");
		tell_object(vic, caster->Name(WESSEN)+" Angriff hat Dich "+
			    "vollkommen verwirrt!\n");
	      }
	  }
      }
  
  //lerne dunkelsicht
  
  return ERFOLG;
}

// Man badet im Blut eines toten Gegners. Dabei muss es dunkel sein, damit Lloth
// das Blut segnen kann. Dient generell zum heilen und in hoeheren GLVL hilft es
// gegen Blindheit, Taubheit, Frosch, Sprachflueche, Krankheiten

is_leiche(object ob)
{
  if(ob->id("Leiche")&&ob->QueryProp(P_SIZE)>80)
    return 1;
  return 0;
}

is_krank(object ob)
{
  if(ob->is_class_member(CL_DISEASE))
    return 1;
  return 0;
}

is_verflucht(object ob)
{
  if(ob->is_class_member(CL_CURSE))
    return 1;
  return 0;
}

int blutbad(object caster, mapping sinfo)
{
  object *le;
  object l,we;
  int siz,suc,t;
  string ti;

  if(caster->InFight())
    return write("Konzentriere Dich lieber auf den Kampf!\n"),0;
  
  if ((suc=SpellSuccess(caster,sinfo)) <= 0) return MISSERFOLG;
  
  if(ENV(caster)->_query_total_light()>0)
    return write("In dieser furchtbaren Helligkeit hat Lloth nicht genug Macht!\n"),0;

  if((!we=caster->QueryProp(P_WEAPON))&&(we->QueryProp(P_WEAPON_TYPE)!=WT_KNIFE))
    return write("Du benoeigst einen gezueckten Dolch, um die Leiche zu zerfleischen!"),0;
  
  le=filter_array(all_inventory(environment(TP)),CLOSURE(is_leiche));
  
  siz=sizeof(le);
  if(!siz) 
    return write("Hier ist kein geigneter, toter Gegner!\n"),0;
  
  l=le[random(siz)];
  
  write(BR("Du murmelst ein Gebet zu Lloth, auf das sie das Blut Deiner toten Gegner "+
	   " segnen moege. "+
	   "Danach stuerzt Du Dich auf die Leiche, die frueher einmal '"+l->QueryProp(P_ORIG_NAME)+
	   "' genannt wurde, beginnst sie zu zerfleischen und badest Dich in ihrem Blut...\n\n"));
  tell_room(ENV(caster),
	    BR(caster->Name()+" murmelt einige unverstaendliche Worte...\n"+
	       "Ploetzlich stuerzt "+caster->QueryPronoun(WER)+" sich auf eine Leiche, "+
	       "zerfleischt sie und beginnt sich in dessen Blut zu baden...\n\n"),
	    ({caster}));
  
  
  t=10+random(5);
  ti=caster->QueryProp(P_TITLE);
  caster->SetProp(P_TITLE,ti+"(in Blut badend)");
  call_out("blutbad2",t, caster, l, suc, ti);
  caster->SetProp(P_PARALYZED,
		  ([
		    PARALYZE_TIME:t,
		    PARALYZE_MSG:"Du badest im Blut Deiner toten Feinde! "+
		    "Geniesse es!\n",
		    PARALYZE_MSG_OTHER:"%s windet sich im Blut der Leiche.\n",
		    PARALYZE_END:""
		   ]));
  return ERFOLG;
}

blutbad2(object caster,object l, int suc,string ti)
{
  int h;
  object uw;  
  object *kf;

  h=random(caster->QueryAttribute(A_DEX)/2)+(l->QueryProp(P_SIZE)/3*suc/10000)+
    random(caster->QueryAttribute(A_CON))/2;
  if(h>200) h=200;
  
  if(caster->QueryProp(P_FROG) && suc > random(7000) && 
     caster->QueryProp(P_GUILD_LEVEL)>=3)
    {
      write("Lloth laesst Dich in Deine alte Gestalt zurueckkehren...\n");
      caster->SetProp(P_FROG,0);
    }
  
  if(caster->QueryProp(P_BLIND) && suc > random(4000) && 
     caster->QueryProp(P_GUILD_LEVEL)>=3)
    {
      write("Lloth's Magie beruehrt Deine toten Augen...\n");
      if(suc>5000)
	{
	  write("Deine Augen koennen nun wieder sehen!\n");
	  caster->SetProp(P_BLIND,0);
	}
      else
	{
	  write("Das Dunkel in Deinen Augen laesst etwas nach.\n");
	  caster->SetProp(P_BLIND,caster->QueryProp(P_BLIND)/(suc/1000));
	}
    }
  
  if(caster->QueryProp(P_DEAF) && suc > random(8000) &&
     caster->QueryProp(P_GUILD_LEVEL)>=3)
    {
      write("Lloth's Magie beruehrt Deine tauben Ohren...\n");
      if(suc>5000)
	{
	  write("Deine Ohren koennen nun wieder Geraeusche vernehmen!\n");
	  caster->SetProp(P_DEAF,0);
	}
      else
	{
	  write("Die Taubheit in Deinen Ohren laesst etwas nach.\n");
	  caster->SetProp(P_DEAF,caster->QueryProp(P_DEAF)/(suc/1000));
	}
    }
  
  if(sizeof(kf=filter_array(all_inventory(environment(TP)),CLOSURE(is_krank))) 
     && suc > random(8000) && caster->QueryProp(P_GUILD_LEVEL)>=5)
    {
      uw=kf[random(sizeof(kf))];
      write("Lloth's Magie erkennt eine Krankheit in Dir...\n");
      if(uw->remove(1))
	write("Nun bist Du geheilt!\n");
    }
  
  if(sizeof(kf=filter_array(all_inventory(environment(TP)),CLOSURE(is_verflucht))) 
     && suc > random(9000) && caster->QueryProp(P_GUILD_LEVEL)>=8)
    {
      uw=kf[random(sizeof(kf))];
      write("Lloth's Magie erkennt einen Fluch an Dir...\n");
      if(uw->remove(1))
	write("Nun bist Du den Fluch los!\n");
    }
  
  write(BR((caster->QueryProp(P_ARMOURS) ? "Mit blutdurchtraenkter Kleidung ":
	    "Vollkommen mit Blut "+"bedeckt ")+"entsteigst Du der blutigen Lacke "+
	   "und grinst boese. Lloth hat das Blut der Leiche fuer Dich gesegnet "+
	   "und nun fuehlst Du Dich wieder bereit fuer den Kampf!\n"));
  tell_room(ENV(caster), caster->Name()+" entsteigt blutueberstroemt und boshaft "+
	    "grinsend einer Blutlacke.\n",({caster}));
  
  caster->SetProp(P_PARALYZED,0);
  caster->AddHp(h);
  caster->SetProp(P_TITLE, ti);
  if((l) && (l->QueryProp(P_SIZE)<500)) l->remove();
  
  DB("*** Blutbad: "+caster->Name()+" mit "+h+" Lp\n");
  return;
}
  
// Der Identifiziere Spell, bis auf Magic/Cursed/Nerverdrop den Abenteurern
// entnommen. Weight, Value, Restrictions, Autoload ... dazu, weil kein 
// schaetz fuer gegenstaende! Ein paar strings aus dem Berserkerspellbook

// Restrictions vielleicht spaeter...
  
int identifiziere(object caster, mapping sinfo) 
{
  object ob;
  string *fi;
  string *dam;
  mapping dt;
  string in,s,wc,va,we,da;
  mapping mat;
  int suc,tm,c,h;

  if(caster->InFight())
    return write("Du solltest Lloth waehrend eines Kampfes nicht deswegen anrufen!\n"),0;
  
  ob=FindVictim(sinfo[SI_SKILLARG], caster, 
		"Welchem Gegenstand willst Du das Geheimniss entreissen?\n");
  if (!ob) return 0;
  
  if(ob==caster)
    return write("Hoer auf, fuer so etwas Deine Magie zu verschwenden!\n"),0;

  suc=SpellSuccess(caster,sinfo);

  if(-1000 <= suc && suc<=0) 
    return MISSERFOLG;

  if(living(ob)&&!ob->QueryProp(P_INFO))
    return write("Gegner sollte man eher einschaetzen!\n"),0;
  
  if(suc<-1000)
    {
      total_fail=1;
      write("Deine Augen leuchten auf, als Dich Lloths Magie durchfaehrt...\n"+
	    "Du versuchst Dich auf "+ob->name(WEN,1)+" zu konzentrieren...\n"+
	    "Da durchfaehrt Dich ein blendend blauer Blitz!\n");
      caster->SetProp(P_BLIND, ([
				 BLIND_MSG:"Alles erscheint in blauem Licht...\n",
				 BLIND_TIME:5+random(10)]));
      if(random(1000)==666)
	ob->SetProp(P_CURSED, "Lloth hat diesen Gegenstand verflucht!!\n");
      
      return MISSERFOLG;
    }
  write("Deine Augen leuchten auf, als Dich Lloths Magie durchfaehrt...\n"+
	"Du lenkst Deinen Blick auf "+ob->name(WEN, 1)+" und siehst "+
	ob->QueryPronoun(WEN)+" ploetzlich ganz klar...\n");
  say(CAP(caster->name(WESSEN))+" Augen leuchten in einem magischen Blau auf.\n"+
      CAP(caster->QueryPossPronoun(WESSEN))+" Blick richtet sich auf "+ob->name(WEN, 1)+".\n");  

  s="";
  if (in=ob->info(caster) || ob->QueryProp(P_INFO))
    s+=in;

  if (ob->QueryProp(P_MAGIC) && suc>1000)
    s+=CAP(ob->QueryPronoun(WER))+" scheint ein altes, magisches Artefakt zu sein.\n";

  if(ob->QueryProp(P_NEVERDROP))
    s+=CAP(ob->QueryPronoun(WEN))+" behaelst Du selbst nach einem feigen Tod.\n";

  if (ob->QueryProp(P_CURSED) && suc>2000)
    s+=CAP(ob->QueryPronoun(WER))+" scheint nicht mit einem Fluch belegt zu sein!\n";

  if (ob->QueryProp(P_AUTOLOADOBJ) && suc>5000)
    s+=CAP(ob->QueryPronoun(WER))+" wird Dir selbst nach einem Weltuntergang erhalten bleiben!\n";
  
  if ((mat=ob->QueryProp(P_MATERIAL)) && (pointerp(mat))) 
    {
      if (sizeof(mat))
	s+=break_string(sprintf("%s besteh%s aus %s.", ob->Name(WER,1),
	   (ob->IsUnit() && ob->QueryProp(P_REQUESTED_AMOUNT) != 1 ? "en" : "t"),
           ob->MatList(WEM) || "einem Dir unbekannten Material"), 78);
    } 
  else 
    if (mappingp(mat) && sizeof(mat-([MAT_MISC_LIVING]))) 
      {
	s+=break_string(sprintf("%s besteh%s aus %s.", ob->Name(WER,1),
         (ob->IsUnit() && ob->QueryProp(P_REQUESTED_AMOUNT) != 1 ? "en" : "t"),
         ob->MaterialList(WEM, caster) || "einem Dir unbekannten Material"), 78);
      }
  
  switch(ob->QueryProp(P_VALUE))
    {
    case 0            : va=" voellig wertlos";  break;
    case 1    ..  100 : va=" fast wertlos";     break;
    case 101  ..  500 : va=" wenig wertvoll";   break;
    case 501  .. 1000 : va=" wertvoll";         break;
    case 1001 .. 3000 : va=" ziemlich wertvoll";break;
    default           : va=" aeusserst wertvoll";
    }
  
  switch(ob->QueryProp(P_WEIGHT))
    {
    case 0    ..  100 : we=" federleicht";      break;
    case 101  ..  300 : we=" eher leicht";      break;
    case 301  ..  500 : we=" leicht";           break;
    case 501  .. 1000 : we=" mittel schwer";    break;
    case 1001 .. 2000 : we=" ziemlich schwer";  break;
    case 2001 .. 4000 : we=" auesserst schwer"; break;
    default           : we=" unhandlich schwer";
    }

  // Ist es eine Ruestung?


  if(ob->QueryProp(P_ARMOUR_TYPE))
    {
      s+="Fuer ein";
      
      switch(ob->QueryProp(P_ARMOUR_TYPE))
	{
	case AT_ARMOUR   : s+="en Panzer";         break;
	case AT_HELMET   : s+="en Helm";           break;
	case AT_AMULET   : s+=" Amulett";          break;
	case AT_RING     : s+="en Ring";           break;
	case AT_GLOVE    : s+=" Paar Handschuhe";  break;
	case AT_CLOAK    : s+="en Umhang";         break;
	case AT_BOOT     : s+=" Paar Schuhe";      break;
	case AT_SHIELD   : s+=" Schild";           break;
	case AT_TROUSERS : s+=" Paar Hosen";       break;
	case AT_BELT     : s+="en Guertel";        break;
	case AT_BRACERS  : s+=" Paar Armschienen"; break;
	case AT_MISC     : s+="e Ruestung";
	}

      s+=" scheint Dich "+ob->Name(WER,1);

      tm=ob->QueryProp(P_AC)*100/VALID_ARMOUR_CLASS[ob->QueryProp(P_ARMOUR_TYPE)];

      switch(tm)
	{
	case 0  ..  10 : s+=" gar nicht";            break;
	case 11 ..  20 : s+=" fast gar nicht";       break;
	case 21 ..  30 : s+=" aeusserst wenig";      break;
	case 31 ..  40 : s+=" nur wenig";            break;
	case 41 ..  50 : s+=" nur etwas";            break;
	case 51 ..  60 : s+=" mittelmaessig";        break;
	case 61 ..  70 : s+=" recht gut";            break;
	case 71 ..  80 : s+=" ziemlich gut";         break;
	case 81 ..  90 : s+=" auesserst gut";        break;
	case 91 .. 100 : s+=" beinahe vollstaendig";
	}

      s+=" zu schuetzen.\n";
      
      if(mappingp(mat=ob->QueryProp(P_TEMPERATURE_PROTECTION))) 
	{
	  
	  s+=CAP(ob->QueryPronoun(WER));
	  c=mat[T_COLD_PROT];
	  h=mat[T_HEAT_PROT];
	  
	  if(c) 
	    {
	      s+=" stellt bei Kaelte ";
	      if (c < -10) s+="eine enorme Belastung";
	      else if (c < -5) s+="eine ziemliche Belastung";
	      else if (c < -2) s+="eine spuerbare Belastung";
	      else if (c < -1) s+="eine leichte Belastung";
	      else if (c < 0)  s+="eine geringe Belastung";
	      else if (c > 10) s+="einen enormen Schutz";
	      else if (c > 5)  s+="einen sehr guten Schutz";
	      else if (c > 2)  s+="einen guten Schutz";
	      else if (c > 1)  s+="einen ganz brauchbaren Schutz";
	      else s+="einen eher geringen Schutz";
	      s+=" dar";
	    }
	  
	  if(h) 
	    {
	      if(c) s+=" und";
	      else s+=CAP(ob->QueryPronoun(WER));
	      if (h < -10) s+=" belastet Dich"+(c<-10 ? " auch" : "")+" bei Hitze enorm stark";
	      else if (h < -5) s+=" bringt Dich bei Hitze schnell zum Schwitzen";
	      else if (h < -2) s+=" laesst Dich bei Hitze leicht schwitzen";
	      else if (h < -1) s+=" laesst Dich bei Hitze leichter schwitzen";
	      else if (h < -1) s+=" laesst Dich bei Hitze leichter schwitzen";
	      else if (h < 0)  s+=" ist bei Hitze eine leichte Belastung fuer Dich";
	      else if (h > 10) s+=" schuetzt Dich unglaublich gut vor Hitze";
	      else if (h > 5)  s+=" bietet Dir einen beachtlichen Hitzeschutz";
	      else if (h > 2)  s+=" schuetzt Dich recht gut vor Hitze";
	      else if (h > 1)  s+=" schuetzt Dich einigermassen vor Hitze";
	      else s+=" schuetzt Dich ein wenig vor Hitze";
	    }
	  s+=".\n";
	}
      
      if((suc>5000) && caster->QueryProp(P_GUILD_LEVEL)>=6)
	{
	  dt=ob->QueryProp(P_DAM_PROTECTION);
	  dt-=([DT_SLASH,DT_BLUDGEON,DT_PIERCE,DT_SQUEEZE,DT_WHIP,DT_RIP]);
	  dam=m_indices(dt);

	  if(sizeof(dam))
	    {
	      
	      s+=CAP(ob->QueryPronoun(WER));

	      switch(dam[random(sizeof(dam))])
		{
		case DT_FIRE      :
		case DT_COLD      :
		case DT_WATER     :
		case DT_AIR       :s+=" scheint Dich vor den Elementen selbst zu schuetzen!";
		  break;
		case DT_LIGHTNING :s+=" scheint Blitze abwehren zu koennen!";
		  break;
		case DT_EXPLOSION :s+=" scheint Dich vor Explosionen schuetzen zu koennen!";
		  break;
		case DT_SOUND     :s+=" schirmt laute Geraeusche ab!";
		  break;
		case DT_LIGHT     :s+=" schuetzt Dich gegen Licht!";
		  break;
		case DT_ELECTRIC  :s+=" schuetzt Dich gegen Stromschlaege!";
		  break;
		case DT_ACID      :s+=" scheint gegen Saeure imun zu sein!";
		  break;
		case DT_POISON    :s+=" ist fuer Gift unantastbar";
		  break;
		case DT_TERROR    :s+=" haelt schreckliches von Dir ab!";
		  break;
		case DT_HOLY      :s+=" wehrt heiligen Schaden ab!!!!";
		  break;
		case DT_UNHOLY    :s+=" wehrt unheilige Attacken ab!";
		  break;
		case DT_MIND      :s+=" schuetzt Deinen Geist!";
		  break;
		case DT_MAGIC     :s+=" scheint Dich mit Magie schuetzen zu koennen!";
		  break;
		default           :s+=" schuetzt Dich auf eigenartige Art und Weise!";
		}
	    }
	}
      CAP(ob->QueryPronoun(WER))+" sieht"+va+" aus und ist"+we+".\n";
    }
  
  // Ist es eine Waffe?

  if(ob->QueryProp(P_WEAPON_TYPE))
    {
      s+=ob->Name(WER,1)+" scheint Dir";
      switch(ob->QueryProp(P_WC))
	{
	case 0   ..  20 : wc=" sehr schlecht";      break;
	case 21  .. 100 : wc=" eher schlecht";      break;
	case 101 .. 150 : wc=" ganz brauchbar";     break;
	case 151 .. 200 : wc=" recht gut";          break;
	case 201 .. 250 : wc=" ziemlich gut";       break;
	case 251 .. 300 : wc=" hervorragend gut";   break;
	default         : wc=" unschlagbar gut";
	}
      switch(ob->QueryProp(P_WEAPON_TYPE))
	{
	case WT_AXE   : s+=" eine"+wc+"e Axt";	        break;
	case WT_SWORD : s+=" ein"+wc+" Schwert";        break;
	case WT_KNIFE : s+=" ein"+wc+"er Dolch";        break;
	case WT_CLUB  : s+=" eine"+wc+"e Keule";	break;
	case WT_SPEAR : s+=" ein"+wc+"er Speer";        break;
	case WT_WHIP  : s+=" eine"+wc+"e Peitsche";     break;
	case WT_CHAIN : s+=" eine"+wc+"e Kettenwaxffe";  break;
	case WT_BOW   : s+=" ein"+wc+"er Bogen";        break;
	default       : s+=" eine"+wc+"e Waffe";
	}
      
      s+=" zu sein.\n";
      CAP(ob->QueryPronoun(WER))+" sieht"+va+" aus und ist"+we+".\n";

      //Man muss ja schliesslich wissen womit man da kaempft!
      
      if(member(({WT_BOW,WT_KNIFE}),ob->QueryProp(P_WEAPON_TYPE))>-1)
	{
	  s+=CAP(ob->QueryPronoun(WER))+" liegt";	  

	  switch(ob->QueryProp(P_WC_FIX))
	    {
	    case 80 : s+=" excellent";               break;
	    case 70 : s+=" extrem gut";              break;
	    case 60 : s+=" sehr gut";                break;
	    case 50 : s+=" besser";                  break;
	    case 40 : s+=" gut";                     break;
	    case 30 : s+=" normal";                  break;
	    case 20 : s+=" schlecht";                break;
	    case 10 : s+=" sehr schlecht";           break;
	    default: s+=" extrem schlecht";
	    }

	  s+=" in Deiner Hand und nuetzt sich";
	  
	  switch(ob->QueryProp(P_QUALITY_DECAY))
	    {
	    case 501 .. 900 : s+=" praktisch gar nicht";   break;
	    case 301 .. 500 : s+=" extrem langsam";        break;
	    case 201 .. 300 : s+=" sehr langsam";          break;
	    case 121 .. 200 : s+=" langsam";               break;
	    case  91 .. 120 : s+=" etwas langsamer";       break;
	    case  71 .. 90  : s+=" normal";                break;
	    case  51 .. 70  : s+=" etwas schneller";       break;
	    case  31 .. 50  : s+=" schnell";               break;
	    case  11 .. 30  : s+=" sehr schnell";          break;
	    case   1 .. 10  : s+=" extrem schnell";        break;
	    case        0   : s+=" fuerchterlich schnell"; break;
	    default         : s+=" gar nicht";
	    }

	  s+=" ab.\n";
	  s+=CAP(ob->QueryPronoun(WER));

	  dam=ob->QueryProp(P_DAM_TYPE);	  
	  switch(dam[random(sizeof(dam))])
	    {
	    case DT_FIRE      :
	    case DT_COLD      :
	    case DT_WATER     :
	    case DT_AIR       :s+=" scheint die Elemente zu beherrschen!";
	      break;
	    case DT_LIGHTNING :s+=" ist von kleinen Blitzen umgeben!";
	      break;
	    case DT_EXPLOSION :s+=" verfuegt ueber hochexplosive Kraefte!";
	      break;
	    case DT_SOUND     :s+=" verursacht einen grauenvollen Laerm!";
	      break;
	    case DT_LIGHT     :s+=" scheint extrem hell zu leuchten!";
	      break;
 	    case DT_ELECTRIC  :s+=" ist von einem elektrisierenden Feld umgeben!";
	      break;
	    case DT_ACID      :s+=" trieft vor aetzender Saeure!";
	      break;
	    case DT_POISON    :s+=" verstroemt giftige Gase!";
	      break;
	    case DT_TERROR    :s+=" scheint die Gegner einzuschuechtern!";
	      break;
	    case DT_HOLY      :s+=" ist von einer heiligen Aura umgeben! *pfui*";
	      break;
	    case DT_UNHOLY    :s+=" verbreitet eine angenehme Boshaftigkeit!";
	      break;
	    case DT_MIND      :s+=" verstroemt eine starke psychische Praesenz!";
	      break;
	    case DT_MAGIC     :s+=" umgibt eine magische Aura!";
	      break;
	    default           :s+=" scheint Dir eine normale Waffe zu sein.";
	    }
	}
    }
  if(!strlen(s)) 
    write("An "+ob->Name(WEM)+" scheint Nichts besonders zu sein!\n");
  else
    caster->More(BR(s));
  
  return ERFOLG;
}

faehigkeiten(object who)
{
  int i, wert;
  string *arm, s,t;
  mapping res;
  
  s=sprintf("+%'-<>-'70|s+\n","  Du schaetzt Dich ungefaehr so ein:  ");
  s+=sprintf("|%70s|\n"," ");
  res=this_player()->QueryProp(P_NEWSKILLS);
  arm=sort_array(m_indices(res), CLOSURE(<));
  for(i = sizeof(arm)-1;i>=0;i--)
    {
      if(arm[i]!="Fight_knife" && arm[i]!="Fight_bow")
	{
	  wert=TP->QuerySkillAbility(arm[i]);   
	  s+=sprintf("|     %30s%' .'25s          |\n",
		     CAP(arm[i])+" kannst Du:", int2string(wert));
	}
    }   
  s+=sprintf("|%70s|\n"," ");
  t=int2string(TP->QuerySkillAbility("Fight_knife"));
  s+=sprintf("|     %30s%' .'25s          |\n","Den Dolchkampf kannst Du:",t);
  t=int2string(TP->QuerySkillAbility("Fight_bow"));
  s+=sprintf("|     %30s%' .'25s          |\n","Den Bogenkampf kannst Du:",t);
  s+=sprintf("|%70s|\n"," ");
  s+=sprintf("+%'-<>-'70|s+\n","###-");
  who->More(s);
  say(sprintf("%s schaetzt %se Fertigkeiten ein.\n", CAP(getuid(TP)), 
	      TP->QueryPossPronoun(WESSEN)));
}


// Der 'schaetz' Spruch. Nahezu komplett der Abenteurer uebernommen

int schaetz(object caster, mapping sinfo) 
{
  object vic;
  int hpdiff, wcdiff, acdiff;
  int hp, vhp, wc, vwc, ac, vac, gen, val, suc;
  string result;
  string vname, vnamegen;

  if (caster->InFight())
    return write("Du kannst im Kampf nichts einschaetzen!\n"),0;

  vic=FindVictim(sinfo[SI_SKILLARG],caster,
		    "Wen willst Du denn einschaetzen?\n");

  if(!vic) return 0;
  if(!living(vic)) 
    return write("Nur Lebewesen kann man einschaetzen!\n"),0;

  suc=SpellSuccess(caster,sinfo);

  if(-1500 <= suc && suc<=0) 
    return MISSERFOLG;

  if(vic==caster)
    {
      faehigkeiten(caster);
      return ERFOLG;
    }
  
  if(suc<-1500)
    if(!random(3) && !vic->QueryProp(P_NOATTACK))
      {
	total_fail=1;
	write("Dein Einschaetzversuch hat "+vic->Name(WEN)+" offensichtlich "+
	      "veraergert...\n");
	vic->Kill(caster);
	return MISSERFOLG;
      }
    else
      return MISSERFOLG;
  
  result="Du schaetzt "+vic->name(WEN)+" ab und kommst zu folgendem Schluss:\n";
  result+=STRICH;

  hp=caster->QueryProp(P_HP);
  vhp=vic->QueryProp(P_HP);
  wc=caster->QueryProp(P_TOTAL_WC);
  vwc=vic->QueryProp(P_TOTAL_WC);
  ac=caster->QueryProp(P_TOTAL_AC);
  vac=vic->QueryProp(P_TOTAL_AC);
  hpdiff=hp-vhp;
  wcdiff=wc-vwc;
  acdiff=ac-vac;
  vname=vic->name(WER, 1);
  vnamegen=vic->name(WESSEN, 1);
  gen=vic->QueryProp(P_GENDER);

  tell_object(vic,CAP(caster->Name())+" schaetzt Dich ein.\n");
  say(CAP(caster->Name())+" schaetzt "+vic->name(WEN,2)+" ein.\n",vic);

  if (hpdiff > 2*vhp)
    result+="Du bist "+vic->name(WEM, 1)+" haushoch ueberlegen.\n";
  else if (hpdiff > vhp)
    result+="Du bist viel staerker als "+vname+".\n";
  else if (hpdiff > vhp/5)
    result+="Du bist staerker als "+vname+".\n";
  else if (-hpdiff > 2*hp)
    result+=CAP(vname)+" ist Dir haushoch ueberlegen.\n";
  else if (-hpdiff > hp)
    result+=CAP(vname)+" ist viel staerker als Du.\n";
  else if (-hpdiff > hp/5)
    result+=CAP(vname)+" ist staerker als Du.\n";
  else
    result+=CAP(vname)+" ist etwa gleich stark wie Du.\n";
  
  if (acdiff > 2*vac)
    result+="Deine Ruestung ist unglaublich viel besser als die "+vnamegen+".\n";
  else if (acdiff > vac)
    result+="Deine Ruestung ist viel besser als die "+vnamegen+".\n"; 
  else if (acdiff >vac/5)
    result+="Deine Ruestung ist besser als die "+vnamegen+".\n";
  else if (-acdiff > 2*ac)
    result+="Die Ruestung "+vnamegen+" ist unglaublich viel besser als Deine.\n";
  else if (-acdiff > ac)
    result+="Die Ruestung "+vnamegen+" ist viel besser als Deine.\n";
  else if (-acdiff > ac/5)
    result+="Die Ruestung "+vnamegen+" ist besser als Deine.\n";
  else
    result+="Eure Ruestungen sind etwa gleich gut.\n";

  if (wcdiff > 2*vwc)
    result+="Deine Waffe ist eigentlich schon zu gut fuer diesen Gegner.\n";
  else if (wcdiff > vwc)
    result+="Deine Waffe ist viel besser als die " +vnamegen+".\n";
  else if (wcdiff > vwc/5)
    result+="Deine Waffe ist besser als die " +vnamegen+".\n";
  else if (-wcdiff > 2*wc)
    result+="Die Waffe "+vnamegen+" laesst Deine ganz mickrig aussehen.\n";
  else if (-wcdiff > wc)
    result+="Die Waffe "+vnamegen+" ist viel besser als Deine.\n";
  else if (-wcdiff > wc/5)
    result+="Die Waffe "+vnamegen+" ist besser als Deine.\n";
  else
    result+="Eure Waffen sind etwa gleich gut.\n";

  result+=capitalize(vic->QueryPronoun(WER) || "es");
  if ((val=vic->QueryProp(P_ALIGN)) <= -1000)
    result+=" ist von satanischer Gesinnung.\n";
  else if (val <= -200)
    result+=" ist von boeser Gesinnung.\n";
  else if (val <= -40)
    result+=sprintf(" ist ein%s unfreundliche%s Zeitgenoss%s.\n",
          (gen == FEMALE ? "e" : ""), (gen == FEMALE ? "" : "r"),
          (gen == FEMALE ? "in" : "e") );
  else if (val <= 40)
    result+=" ist so ziemlich neutral.\n";
  else if (val <= 200)
    result+=" ist eigentlich ganz nett.\n";
  else if (val < 1000)
    result+=" ist von guter Gesinnung.\n";
  else
    result+=" strahlt eine gewisse Heiligkeit aus.\n";
  result+=STRICH;
  write(result);

  return ERFOLG;
}


// Parieren, angelehnt an Abenteurer, wirkt aber ein 
// wenig besser bei guten Gegnern und schlechter bei boesen Gegnern

int parieren(object caster, mapping sinfo)
{
  mixed h;
  int suc,dauer;

  if (!caster->InFight())
    return write("Aber es herrscht doch gar kein Kampf!\n"),0;

  if(h=caster->QueryProp(P_TMP_DEFEND_HOOK)) 
    if((h[1]==this_object()) && (h[2]=="par")) 
      if(h[0] >= time())
	return write("Du kannst nicht noch mehr parieren!\n"),0;
      else
	return write("Lloth scheint Dich zu ignorieren!\n"),0;

  suc=SpellSuccess(caster,sinfo);

  if(-1500 <= suc && suc<=0) 
    return MISSERFOLG;

  if(suc<-1500)
    {
      total_fail=1;
      write("Lloth's Macht bringt Dich aus dem Gleichgewicht...\n");
      caster->SetProp(P_TMP_DEFEND_HOOK,({time()+random(5),TO,"paripatz"}));
      return MISSERFOLG;
    }
      
  dauer=2+caster->QueryAttribute(A_DEX)/6+(suc/5000)+caster->QueryProp(P_GUILD_LEVEL)/2;

  caster->SetProp(P_TMP_DEFEND_HOOK,({time()+dauer,TO,"par"}));

  write("Du hebst Deine Waffen und versuchst ein paar Attacken zu parieren.\n");
  say(caster->Name()+" hebt die Waffen und konzentriert sich auf den Kampf.\n");

  return ERFOLG;
}

mixed paripatz(int dam, mixed dam_type, mixed spell, object enemy) 
{
  if(sizeof(filter_array(dam_type,PHYSICAL_DAMAGE_TYPES)))
    {
      tell_object(PO, enemy->Name(WER)+" trifft Dich mit voller Wucht!\n");
      return ({ dam/3*2, dam_type, spell, enemy });
    }
  return ({ dam, dam_type, spell, enemy });
}

mixed par(int dam, mixed dam_type, mixed spell, object enemy) 
{
  object po;
  int ndam,pr;
  
  if(sizeof(filter_array(dam_type,PHYSICAL_DAMAGE_TYPES))) 
    {
      po=previous_object();
      ndam=dam;

     if(enemy->QueryAttribute(A_DEX) < po->QueryAttribute(A_DEX)) 
       ndam /= 4;
     else 
       if(enemy->QueryAttribute(A_DEX) > po->QueryAttribute(A_DEX)+10) 
	 ndam /= 3;
       else 
	 ndam /= 2;
     pr=ndam*100/dam;

     if(pr<30) 
       tell_object(po, "Haha! Diese Attacke parierst Du mit Leichtigkeit.\n");
     else 
	if(pr<40) 
	  tell_object(po, "Diese Attacke ist kein Problem fuer Dich.\n");
	else 
	  tell_object(po, "Du kannst einen Teil der Attacke parieren.\n");

      return ({ndam, dam_type, spell, enemy});
    }

  tell_object(po, "Diesen Angriff konntest Du nicht parieren!\n");

  return ({ dam, dam_type, spell, enemy });
}

// Ziemlich 1 zu 1 uebernommen von der Dunkelelfengilde. Der Spieler trifft dabei
// oefter pro Kampfrunde

int schnell(object caster, mapping sinfo) 
{
  int dauer, suc, light;

  if (!caster->InFight())
    return write("Nur im Kampf kannst Du Diesen Zauber vollfuehren.\n"),0;
  
  suc=SpellSuccess(caster,sinfo);

  if(-1000 <= suc && suc<=0) 
    return MISSERFOLG;

  dauer = caster->QueryAttribute(A_DEX) + random(sinfo[SI_SKILLABILITY]/1000);

  light=ENV(caster)->_query_total_light();

  if(light!=0) 
    dauer-=4*light;

  if(suc < -1000) 
    {
      total_fail=1;
      write("Dein Zauber misslingt und Lloth bestraft Dich mit ihren Spinnweben...\n");
      say(BR(caster->Name(WESSEN)+" Zauber wendet sich gegen "+
	     caster->QueryPronoun(WEN)+" und "+caster->QueryPronoun(WER)+
	     " bewegt sich ploetzlich um einiges langsamer!\n"));
      caster->ModifySkillAttribute(caster,SA_SPEED,50,dauer);
      return MISSERFOLG;
    }
  
  say(caster->Name()+" nimmt seine Waffen fester in die Haende und beginnt sich "+
      "wied ein Wirbelwind um seinen Gegner herumzubewegen...\n");
  
  if(suc > 6000) 
    {
      write("Lloth segnet Deine Attacken und Du fuehlst Dich sehr viel schneller.\n");
      caster->ModifySkillAttribute(caster,SA_SPEED,300,dauer/2);
    } 
  else 
    {
      write("Lloth segnet Deine Attacken und Dein Kampf beschleunigt sich.\n");
      caster->ModifySkillAttribute(caster,SA_SPEED,200,dauer);
    }

  return ERFOLG;
}

// Der Ellenbogenschlag wird von Oben nach unten durchgefuehrt. Bei recht schweren
// Armschienen kann man den Gegner bei seiner Konzentration stoeren und somit
// seine Zauber verlangsamen.

int ellenbogenschlag(object caster, mapping sinfo)
{
  object vic,wa,ob;
  object *ar;
  int suc,dam,kon;

  vic=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
		      "Wem willst Du einen Schlag verpassen?\n");
  if(!vic) return 0;
  
  if(vic->QueryProp(P_SIZE) > (caster->QueryProp(P_SIZE)*3/2))
    return write(vic->Name()+" ist zu gross versuch es lieber mit einem Kniestoss!\n"),0;
  
  if((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  
  dam=(random(caster->QueryAttribute(A_STR))+random(caster->QueryAttribute(A_DEX)))*suc/1000;

  if(sizeof(ar=filter_objects(caster->QueryProp(P_ARMOURS), "id", AT_BRACERS)))
    {
      dam+=(ar[0]->QueryProp(P_AC)*suc/1000)+(ar[0]->QueryProp(P_WEIGHT)/100)+
	(ar[0]->QueryProp(P_EFFECTIVE_WC));
      ar[0]->TakeFlaw(({DT_BLUDGEON}));
    }

  if(dam>600) dam=600;
  
  DB("*** Spinnenkrieger: Ellenbogenschlag "+caster->Name()+" dam: "+dam+" bei "+suc+"\n");
  TryAttackSpell(vic, dam, ({DT_BLUDGEON,DT_SLASH}), sinfo[SI_SPELL],
  caster,sinfo);
  
  if(dam> 400 && caster->QueryProp(P_GUILD_LEVEL) > 5 && suc > random(8000))
    {
      write("Durch Deinen maechtigen Schlag verliert "+vic->name(WER)+
	    " "+vic->QueryPossPronoun(WEN)+" Konzentration.\n");
      tell_object(vic, "Durch "+caster->name(WESSEN)+" Schlag verlierst "+
		  "Du einen Teil Deiner Konzentration...\n");

      if(kon=vic->QueryProp(P_SPELLRATE))
	vic->SetProp(P_SPELLRATE, kon-random(suc/1000));
    }
  
  if(sizeof(filter_objects(vic->QueryProp(P_ARMOURS), "id", AT_HELMET)))
    {
      write("Du stoesst Dir Deinen Ellenbogen hart am Helm "+
	    vic->Name(WESSEN)+".\n");
      caster->reduce_hit_point(10+random(5));

      if(random(1000)==666)
	{
	  ob=clone_object(SOBJ "barm");
	  ob->move(caster, M_NOCHECK);
	  write("Mit einem lauten, schmerzvollen 'Knack' bricht Dein Arm...\n");
	}
    }
  else
    if(!sizeof(ar) && ! random(3))
      {
	write(({"Dein Ellenbogen faerbt sich deutlich rot...\n",
		  "Ein jaeher Schmaerz durchfaehrt Deinen Ellenbogen!\n",
		  "Irgendwas hat gerade 'Krack' gemacht in Deinem Ellenbogen!\n",
		  "Ein dumpfes Pochen durchfaehrt Deinen Unterarm...\n"})[random(4)]);
	caster->reduce_hit_point(3+random(5));
      }
  return ERFOLG;
}

// Der Kniestoss ist ein einfacher Kampfspell, der besser wirkt, wenn man
// Ruestung AT_TROUSERS traegt. Bei hohem Success wird der Gegner kurz
// disabled ;)

int kniestoss(object caster, mapping sinfo)
{
  object vic,ob;
  object *ar;
  object *p;
  int dam,suc;

  vic=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Wem willst Du Dein Knie reinrammen?\n");
  if(!vic) return 0;

  if(vic->QueryProp(P_SIZE) < caster->QueryProp(P_SIZE)/2)
    return write(vic->Name()+" ist zu klein versuch es lieber mit einem Ellenbogenschlag!\n"),0;
  
  if((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;

  dam=(random(caster->QueryAttribute(A_STR))+random(caster->QueryAttribute(A_DEX)))*suc/1000;
  
  if(sizeof(ar=filter_objects(caster->QueryProp(P_ARMOURS), "id", AT_TROUSERS)))
    {
      dam+=(ar[0]->QueryProp(P_AC)*suc/1000)+(ar[0]->QueryProp(P_EFFECTIVE_WC));
      ar[0]->TakeFlaw(({DT_BLUDGEON}));
    }
  
  if(dam>500) dam=500;
  
  DB("*** Spinnenkrieger: Kniestoss "+caster->Name()+" dam: "+dam+"bei "+suc+"\n");
  TryAttackSpell(vic, dam, ({DT_BLUDGEON,DT_SQUEEZE}), sinfo[SI_SPELL],
  caster,sinfo);
  
  if(suc > random(8000) && caster->QueryProp(P_GUILD_LEVEL) > 8)
    {
      vic->SetProp(P_DISABLE_ATTACK, random(3));
      write(vic->Name()+" beginnt zu spucken und faellt auf die Knie!\n");
      tell_object(vic, "Dein Magen wehrt sich gegen "+caster->Name(WESSEN)+
		  "Angriffe und Du brichst zusammen!\n");
    }
  
  if(sizeof(ar=filter_objects(vic->QueryProp(P_ARMOURS), "id", AT_ARMOUR)))
    {
      write(({"Du stoesst Dir Dein Knie hart am Panzer "+vic->Name(WESSEN)+".\n",
		"Dein Knie faerbt sich tiefrot, als es an den Panzer prallt!\n"})[random(2)]);
      caster->reduce_hit_point(10+random(5));
      if(random(1000)==666)
	{
	  ob=clone_object(SOBJ "bbein");
	  ob->move(caster, M_NOCHECK);
	  write("Mit einem lauten, schmerzvollen 'Knack' bricht Dein Bein...\n");
	}
    }
  else
    if(!sizeof(ar) && ! random(3))
      {
	write(({"Dein Knie beginnt schmerzhaft zu pochen!\n",
		  "Ein stechender Schmerz durchfaehrt Dein Knie!\n",
		  "Schmerzerfuellt umfasst Du Dein Knie!\n"})[random(3)]);
	caster->reduce_hit_point(3+random(5));
      }
  return ERFOLG;
}

// Der Dolchwurf: Besitzt man einen Dolch und hat ihn gezueckt, so kann man ihn 
// dem Gegner entgegenschleudern. Bei Pech behaelt sich der Gegner den Dolch

int dolchwurf(object caster, mapping sinfo)
{
  object vic,wa;
  int suc,dam;
  string d;

  vic=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
		      "Auf wen willst Du Deinen Dolch schleudern?\n");
  if(!vic) return 0;
  
  suc=SpellSuccess(caster,sinfo);

  if(-1000 <= suc && suc<=0)
    return MISSERFOLG;

  wa=caster->QueryProp(P_WEAPON);

  if(!wa)
    return write("Du kannst nur einen gezueckten Dolch werfen!\n"),0;

  if(wa->QueryProp(P_WEAPON_TYPE)!=WT_KNIFE)
    return write("Du kannst nur einen Dolch werfen!\n"),0;

  if(wa->QueryProp(P_CURSED))
    return write("So leicht wirst Du einen verfluchten Dolch nicht los!\n"),0;

  if(suc<-1000)
    if(!random(caster->QueryAttribute(A_DEX)))
      {
	total_fail=1;
	write("Ungeschickt wie Du bist, wirfst Du "+wa->Name(WEN)+" "+
	      vic->Name(WEM)+" zu!\n");
	tell_object(vic, caster->Name(WER)+" wirft Dir ungeschickterweise "+
		    caster->QueryPronoun(WEN)+" Waffe zu!\n");
	tell_room(ENV(caster), caster->Name(WER)+" wirft "+vic->Name(WEM)+
		  " ungeschickterweise "+caster->QueryPronoun(WEN)+
		  " Waffe zu!\n",({caster,vic}));
	wa->move(vic,M_NOCHECK);
	return MISSERFOLG;
      }
    else
      return MISSERFOLG;
  
  dam=caster->QueryAttribute(A_STR)+caster->QueryAttribute(A_DEX)+
    (wa->QueryProp(P_WEIGHT)/10*caster->QueryProp(P_GUILD_LEVEL)/2)+
    (wa->QueryProp(P_WC)/2*suc/2500);
  
  if(dam>700) dam=700;

  switch(dam)
    {
    case        700 : d="perfekt ";               break;
    case 600 .. 699 : d="fast perfekt ";          break;
    case 500 .. 599 : d="ziemlich gekonnt ";      break;
    case 400 .. 499 : d="gekonnt ";               break;
    case 300 .. 399 : d="mittelmaessig ";         break;
    case 200 .. 299 : d="unterdurchschnittlich "; break;
    case 100 .. 199 : d="schlecht ";              break;
    case   0 ..  99 : d="miserabel ";             break;
    default         : d="seltsam ";
    }
  
  write("Dein"+(wa->QueryProp(P_GENDER)==FEMALE ? "e "+d+" geworfene ":
		" "+d+" geworfener ")+wa->Name(RAW)+" bohrt sich "+
	(dam>350 ? "tief ":" ")+"in den Koerper "+vic->name(WESSEN)+".\n");
  tell_object(vic, caster->Name(WESSEN)+" "+d+"geworfene"+
	      (wa->QueryProp(P_GENDER)==FEMALE ? " ":"r ")+wa->Name(RAW)+
	      " bohrt sich "+(dam>350 ? "tief ":" ")+"in Deinen Koerper.\n");
  tell_room(ENV(caster), caster->Name(WESSEN)+" "+d+"geworfene"+
	    (wa->QueryProp(P_GENDER)==FEMALE ? " ":"r ")+wa->Name(RAW)+
	    " bohrt sich "+(dam>350 ? "tief ":" ")+"in den Koerper "+
	    vic->Name(WESSEN)+".\n",({vic,caster}));
  
  TryAttackSpell(vic, dam, ({DT_PIERCE})+wa->QueryProp(P_DAM_TYPE),
  sinfo[SI_SPELL],caster,sinfo);

  wa->TakeFlaw(2);
  
  /*
    wa->DoUnwield(1);

  if(suc<(vic->QueryAttribute(A_DEX)*200) && !random(caster->QueryAttribute(A_DEX)/2))
    {
      write("So ein Pech! "+vic->Name(WER)+" hat "+wa->Name(WEN)+" aufgefangen!\n");
      wa->move(vic,M_NOCHECK);
    }
  else
    wa->move(ENV(vic),M_NOCHECK);
  */
  DB("*** Spinnenkrieger: Dolchwurf: "+caster->Name()+" dam "+dam+" bei "+suc+"\n");
  return ERFOLG;
}

string int2string(int wert)
{
 string str;
 
 switch(wert) 
   {
   case 0   .. 500: str="so gut wie gar nicht";      break;
   case 501 ..1000: str="fast gar nicht";            break;
   case 1001..1500: str="kaum";                      break;
   case 1501..2000: str="sehr miserabel";            break;
   case 2001..2500: str="miserabel";                 break;
   case 2501..3000: str="ziemlich schlecht";         break;
   case 3001..3500: str="schlecht";                  break;
   case 3501..4000: str="maessig";                   break;
   case 4001..4500: str="unterdurchschnittlich";     break;
   case 4501..5000: str="durchschnittlich";          break;
   case 5001..5500: str="ueberdurchschnittlich";     break;
   case 5501..6000: str="gut";                       break;
   case 6001..6500: str="wirklich gut";              break;
   case 6501..7000: str="sehr gut";                  break;
   case 7001..7500: str="unglaublich gut";           break;
   case 7501..8000: str="phantastisch gut";          break;
   case 8001..8500: str="ausgezeichnet";             break;
   case 8501..9000: str="hervorragend";              break;
   case 9001..9500: str="meisterhaft";               break;
   case 9501..9999: str="nahezu perfekt";            break;
   case      10000: str="absolut perfekt";           break;
   default: str="ueberhaupt nicht";
   }
 return str;
}

string BlindTest(object caster, mapping sinfo)
{
  if(caster->QueryProp(P_BLIND))
    return "Wie willst Du jemanden einschaetzen, wenn Du nichts siehst!\n";
}

string WaffenTest(object caster, mapping sinfo)
{
  if(caster->QueryProp(P_WEAPON))
    return "Zuecke Deine Waffe, sonst wird Dich Lloth fuer diese sinnlose Bitte bestrafen!\n";
}
