  AddSpell("giftpfeil",30,7);
  AddSpell("driderruf",160,8);
  AddSpell("schnell",50,
	   ([
	     SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:9]),
	     SI_SKILLRESTR_USE: ([SR_FUN:"WaffenTest"]),
	     SI_SKILLRESTR_USE: ([A_DEX:18]),
	     SI_SKILLLEARN_ATTRIBUTE: A_DEX,
	     SI_PREPARE_TIME:2,
	     SI_SPELLFATIGUE:4,
