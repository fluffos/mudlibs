             SI_FAIL_MSG: "Nichts spiegelt sich.\n",
           ]));

  AddSpell("speerzauber", 0,
           ([SI_SKILLRESTR_LEARN: ([P_GUILD_LEVEL: 14]),
             SI_SKILLRESTR_USE:([SR_FUN: "AmazonenTest", A_INT: 16, P_GUILD_LEVEL: 13]),
             SI_SKILLLEARN: 6,
             OFFSET(SI_SKILLLEARN): 8,
             SI_SKILLLEARN_ATTRIBUTE: A_INT,
             SI_DIFFICULTY: 0,
