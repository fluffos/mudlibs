nosave string sekunden()
{
  int t;
  t = this_player()->QueryProp(P_NEXT_SPELL_TIME)-time();
  if (t > 10000) return "ewig lang";
  if (t > 3600) return "stundenlang";
  if (t > 300) return "viele Minuten";
  if (t > 60) return "minutenlang";
  if (t > 30) return "extrem lang";
  if (t > 16) return "sehr lang";
  if (t > 12) return "lang";
  if (t > 8) return "nicht mehr lang";
  if (t > 6) return "etwas";
  if (t > 4) return "kurz";
  if (t > 2) return "sehr kurz";
  return "ganz kurz";
}


nosave string time_msg()
{
  return 
    "Du musst " + sekunden() + " warten, bis Du wieder etwas machen kannst!\n";
}


nosave string learn_msg()
{
  return ({
      "Du lernst aus Deinem Fehler.\n",
      "Du lernst aus Deinem Versagen.\n",
      "Du machst einen Fehler, aber lernst daraus.\n",
      "Du versagst, aber lernst daraus.\n",
      "Trotz Deines Fehlschlages lernst Du aus Deinem Fehler dazu.\n",
      })[random(5)];
}


nosave string nolearn_msg()
{
  return ({
      "Leider lernst Du nicht aus Deinem Fehler.\n",
      "Du musst besser werden, um aus Deinem Fehler zu lernen.\n",
      })[random(2)];
}


nosave string sp_low_msg()
{
  return ({
      "Deine magische Kraft reicht dafuer nicht aus!\n",
      "Deine magische Energie ist zu niedrig dafuer!\n",
      "Du hast zu wenig Magiepunkte dafuer!\n",
      "Es fehlen Dir die Magiepunkte dafuer!\n",
      "Deine Konzentration ist fuer diese Faehigkeit zu gering.\n",
      })[random(5)];
}


nosave string AmazonenTest(object caster, mapping sinfo)
{
  object item;
  item = present(GUILD_ITEM, caster);
  if (!item || item->QueryVersion() != LATEST_GUILDITEM_VERSION) 
  {
    if (item)
      item->remove(1);
    (item = clone_object( GUILD_ITEM_FILENAME))->move(caster, M_NOCHECK);
  }
  if (item->QueryProp(P_WORN) != caster)
    return "Du musst Dein Amazonenamulett auch tragen!\n";
  return 0;
}


nosave string FroschTest(object caster, mapping sinfo)
{
  if (caster->QueryProp(P_FROG))
    return "Als Frosch kannst Du das nicht!\n";
  return AmazonenTest(caster, sinfo);
}


nosave string BlindTest(object caster, mapping sinfo)
{
  if (caster->QueryProp(P_BLIND))
    return "Da Du blind bist, kannst Du das nicht machen!\n";
  return AmazonenTest(caster, sinfo);
}


nosave void Misserfolg(object caster, string spell, mapping sinfo)
{
  int old_abil, new_abil;
  
  if (!total_fail) 
    write(sinfo[SI_FAIL_MSG]);
  total_fail = 0;
  old_abil = sinfo[SI_SKILLABILITY];
  Learn(caster, spell, sinfo);
  new_abil=caster->QuerySkillAbility(spell);

  if (old_abil < new_abil)
  {
    if (new_abil == MAX_ABILITY)
      write(BS("Du lernst aus Deinem Fehler und kannst " + capitalize(spell) +
            " nun goettlich!!!"));
    else
      write(learn_msg());
  }
  else
    write(nolearn_msg());
}


nosave void Erfolg(object caster, string spell, mapping sinfo) 
{
  int abil;
  abil = sinfo[SI_SKILLABILITY];
  if (abil != MAX_ABILITY && random(MAX_ABILITY) < abil - (MAX_ABILITY - 30))
  {
    caster->ModifySkill( spell, ([ SI_SKILLABILITY: ++abil ]), 0, GUILDNAME);
    if (abil == MAX_ABILITY)
      tell_object(caster, "Du lernst aus Deinem Erfolg und kannst "+
          capitalize(spell)+ " nun goettlich!!!\n");
    else
      tell_object(caster, "Du lernst aus Deinem Erfolg.\n");
  }
  caster->ModifySkill(spell,([SI_USR:sinfo[SI_USR] + 1]),0, GUILDNAME);
}


int is_humanoid(string str)
{
  if (member( ({"mensch", "elf", "zwerg", "hobbit", "fee", "troll", "xandim",
                "oger", "ork", "gaffo", "goblin", "gnom", "dunkelelf", 
                "halbelf", "froglok" , "zentaur"}),
      lower_case(str) )!=-1) return 1;
  return 0;
}


int CheckItems(object caster) 
{
  object *obj, wea;
  int i, value, h;

  value = 0;
  if (!objectp(caster)) return 0;
  obj = caster->QueryProp(P_ARMOURS);
  if (wea = caster->QueryProp(P_WEAPON))
    obj += ({wea});
  if (!sizeof(obj)) return 0;
  for (i = sizeof(obj) - 1; i >= 0; i--) 
    if (h = obj[i]->QueryProp(P_AMAZONEN_SPELLCOST)) 
      value += h;
  return value;
}


int CheckEquip(object caster, string prop)
{
  int r,i,x;
  object *a;
  object w;
  mapping map;
  
  r = 0;
  if (!pointerp(a = caster->QueryProp(P_ARMOURS))) a = ({});
  if (w = caster->QueryProp(P_WEAPON)) a += ({w});
  for (i = sizeof(a) - 1; i >= 0; i--)
  {
    if (objectp(a[i]) && mappingp(map = a[i]->QueryProp(P_AMAZONEN_BONUS)) &&
        a[i]->QueryProp(P_EQUIP_TIME) + 3 < time())
      if ((x = map[prop]) || (x = map["all"])) 
        if (intp(x) && x > 0)
          r += (x > MAX_EQUIP_BONUS ? MAX_EQUIP_BONUS : x);
  }
  return (r > TOTAL_EQUIP_BONUS ? TOTAL_EQUIP_BONUS : r);
}

#define SMUL(x,y) ((x<0 && y<0)?(-1*x*y):(x*y))
nosave int SpellSuccess(object caster, mapping sinfo) 
{
  int suc;
  int cval,abil,res, *sp_count, diff, roll;

  abil=sinfo[SI_SKILLABILITY];
  cval=(int)caster->UseSkill(SK_CASTING);
  roll = random(MAX_ABILITY-(abil==MAX_ABILITY?2000:0));
  suc = abil + (SMUL(abil,cval)) / MAX_ABILITY - roll;

  if(suc > 0 && (abil-roll) < 0) {
    if(caster->QueryProp(P_TESTPLAYER)) {
      tell_object(caster, sprintf("SpellSucces :: recovered fail simulRes = %d\n", abil-roll));
    }
    tell_object(caster, BS("Die Faehigkeit ist dir gerade noch gelungen!"));
    Learn(caster, lowerstring(sinfo[SI_SPELLFUNC]), sinfo);
}
  
  if (!random(4321) && interactive(caster) && caster->QueryProp(P_GUILD_LEVEL) != 15) 
    return -MAX_ABILITY + suc;
  if(suc < 0) return suc;
  return suc + CheckEquip(caster, sinfo[SI_SPELLFUNC]) * 50;
}


nosave mapping DoSpellModification(object caster,mapping sinfo) 
{
  int level, factor;
  int cost_modifier, fatigue_modifier, dam_modifier;
  string order;

  cost_modifier = 100;
  dam_modifier = 100;

  if ((level = caster->QueryProp(P_GUILD_LEVEL)) >= 10) 
    sinfo[SI_RAW_SPELLCOST] -= 2;
  else if ((level = caster->QueryProp(P_GUILD_LEVEL)) == 9) 
    sinfo[SI_RAW_SPELLCOST] -= 1;
  if (level > 4) 
    cost_modifier -= (level - 4) * random(level / 2);

  // AUSRUESTUNG
  cost_modifier -= CheckItems(caster);

  // HOHE DEX
  if ((factor = caster->QueryAttribute(A_DEX)) > 30) 
  {
    // Dex 31:1, 32:3, 33:4, 34:6, 35:8, 36:10, 37:12, 38:15, 39:17 40: 20, 
    // das doppelte beim Schaden, aber random
    cost_modifier -= (factor * (factor - 30)) / 20;
    dam_modifier += random((factor * (factor - 30)) / 10);
  }

  dam_modifier += random(CheckEquip(caster, sinfo[SI_SPELLFUNC]) / 2);
  if (objectp(sinfo[SI_ENEMY]) &&
      sinfo[SI_ENEMY]->QueryProp(P_GENDER) == MALE &&
      is_humanoid(sinfo[SI_ENEMY]->QueryProp(P_RACE)) )
    dam_modifier += random(10);

  if (cost_modifier < 30) cost_modifier = 30;
  if (cost_modifier > 200) cost_modifier = 200;
  if (dam_modifier > 150) dam_modifier = 150;

  order = AMASTER->QueryMemberEntry(getuid(caster))[POS_ORDER];
  if(order == AMAZONEN_ORDEN_SPEERSEELE && (sinfo[SI_SPELLFUNC] == "speerzauber" || sinfo[SI_SPELLFUNC] == "speerstoss" || sinfo[SI_SPELLFUNC] == "aufspiessen") ||
     order == AMAZONEN_ORDEN_ORAKEL && (sinfo[SI_SPELLFUNC] == "strahlenkranz" || sinfo[SI_SPELLFUNC] == "lebenskraft" || sinfo[SI_SPELLFUNC] == "spiegelbild") || 
     order == AMAZONEN_ORDEN_SCHILDMAID && (sinfo[SI_SPELLFUNC] == "betoeren" || sinfo[SI_SPELLFUNC] == "duell" || sinfo[SI_SPELLFUNC] == "selbstbeherrschung") ||
     order == AMAZONEN_ORDEN_VALKYRE && (sinfo[SI_SPELLFUNC] == "speerwurf" || sinfo[SI_SPELLFUNC] == "blitzschlag" || sinfo[SI_SPELLFUNC] == "schnelligkeit")) {
      cost_modifier -= 15;
      dam_modifier += 15;
  }

  sinfo[SI_SKILLPOINTS] = AMAZONEN_TALENTMASTER->QuerySpentPoints(getuid(caster), sinfo[SI_SPELLFUNC]);

  if(caster->QueryProp(P_AMAZONEN_STURZFLUG) > time() && AMAZONEN_TALENTMASTER->QuerySpentPoints(getuid(caster), "sturzflug") > 2) {
    dam_modifier += 20;
  }
  
  sinfo[SI_RAW_SPELLCOST] = (sinfo[SI_RAW_SPELLCOST] * cost_modifier) / 100;
  sinfo[SI_SKILLDAMAGE] = (sinfo[SI_SKILLDAMAGE] * dam_modifier) / 100;

  if(sinfo[SI_SKILLPOINTS] > 0) {
    if(sinfo[SI_SPELLFUNC] == "erkenntnis" || sinfo[SI_SPELLFUNC] == "speerstoss" || 
      sinfo[SI_SPELLFUNC] == "schnelligkeit" || sinfo[SI_SPELLFUNC] == "aufspiessen" ||
      sinfo[SI_SPELLFUNC] == "wirbelwind") {
      sinfo[SI_RAW_SPELLCOST] -= sinfo[SI_SKILLPOINTS] * 2;
    } else if(sinfo[SI_SPELLFUNC] == "weitblick") {
      sinfo[SI_RAW_SPELLCOST] -= sinfo[SI_SKILLPOINTS];
    } else if(sinfo[SI_SPELLFUNC] == "blitzschlag" || sinfo[SI_SPELLFUNC] == "kampfgebruell" || sinfo[SI_SPELLFUNC] == "schildwall" ||
              sinfo[SI_SPELLFUNC] == "fluegelschlag" || sinfo[SI_SPELLFUNC] == "selbstbeherrschung" || sinfo[SI_SPELLFUNC] == "speerzauber" ||
              sinfo[SI_SPELLFUNC] == "spiegelbild" || sinfo[SI_SPELLFUNC] == "abwehrhaltung" || sinfo[SI_SPELLFUNC] == "durchbohren" ||
              sinfo[SI_SPELLFUNC] == "einschlag" || sinfo[SI_SPELLFUNC] == "heldenaura" || sinfo[SI_SPELLFUNC] == "sonnenstrahl" ||
              sinfo[SI_SPELLFUNC] == "standhaftigkeit") {
      sinfo[SI_RAW_SPELLCOST] /= 2;
    }
  }
  if(sinfo[SI_SPELLFUNC] == "provozieren" && sinfo[SI_SKILLPOINTS] > 2) sinfo[SI_RAW_SPELLCOST] /= 2;
  return sinfo;
}


nosave varargs mapping pay_for_spell(object caster, mapping sinfo, int flag)
{
  sinfo = DoSpellModification(caster, sinfo);
  if (caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    tell_object(caster, process_string(sinfo[SI_SP_LOW_MSG])); 
    return 0;
  }
  if (!flag)
    caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  return sinfo;
}


