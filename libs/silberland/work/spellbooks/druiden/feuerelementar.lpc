/*
 * Feuerementar
 *
 *
 * Kosten: 
 * Level : 15
 * Objekte:
 * Damage:
 *
 */

int prep_feuerelementar(object caster, mapping sinfo) 
{
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  if(present(DRUIDEN_SPELL_ENHANCE, caster)) 
  {
    write_color(BS("Du kannst aufgrund Deiner elementaren Veraenderung "
          "kein Elementar beschwoeren!"), FEUER, caster);
    return 0;
  }
  write_color(BS("Du murmelst Worte der Beschwoerung und beschwoerst "
          "die Macht des Feuers in eine Gestalt..."), FEUER, caster);
    
  say(sprintf("%s murmelt einige Worte.\n",capitalize(caster->name())));
  return 1;
}

int feuerelementar(object caster, mapping sinfo) 
{
  object l;
  int suc;
  int level, hands, e_defends;
   
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(FEUER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  
  if((suc=SpellSuccess(caster,sinfo))<=0) 
  {
    if(suc<-2000) 
    {        
      write_color(BS("Ploetzlich manifestiert sich eine Gestalt aus reinstem "
           "Feuer, dass DICH sofort attackiert!"), FEUER, caster);
      say(BS(sprintf("Ploetzlich manifestiert sich eine Gestalt aus "
              "reinstem Feuer, die %s attackiert\n", caster->Name())));
      l=CreateElemental(caster, suc, FEUER);
      l->SetAggressive(caster);
      caster->AddPursuer(l);   
      l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
      l->Kill(caster);
    }        
    return MISSERFOLG;
  } 
  l=CreateElemental(caster, suc, FEUER);
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  write_color(BS("Ploetzlich manifestiert sich eine Gestalt aus reinstem "
          "Feuer, "+l->name(WER,0)+"."), FEUER, caster);
  say(BS("Ploetzlich manifestiert sich eine Gestalt aus "
              "reinstem Feuer, "+l->name(WER,0)+"."));
  return ERFOLG;
}
