/*
 * Feuersturm
 *
 *
 * Kosten: 
 * Level : 15
 * Objekte:
 * Damage:
 *
 */

int prep_feuersturm(object caster, mapping sinfo) 
{
  object *enemies; 
  enemies=FindGroup(caster, -1);
  if((!enemies || !sizeof(enemies)) && (!HasElementalRing(FEUER, caster) &&
       call_other(DRUIDENMASTER, "GetDruidElement", caster)!=FEUER))
  {
    write("Ohne Gegner ist ein Feuersturm ziemlich sinnlos!\n");
    return 0;
  }
  if(present(DRUIDEN_DOT, caster)) 
  {
    write("Du hast schon eine elementare Aura um Dich!\n");
    return 0;
  }
  write_color("Grosse Flammen schlagen aus Deinen Haenden.\n", FEUER, caster);
  return 1;
}

int feuersturm(object caster, mapping sinfo) 
{
  object ob;
  int suc;
   
  sinfo=DoSpellModification(FEUER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  write_color(BS("Du konzentrierst Dich auf das Element Feuer und "
          +"formst Zeichen der Macht."), FEUER, caster);
  say(sprintf(BS("%s konzentriert sich und formt seltsame Zeichen mit "
       +"der rechten Hand."), 
              capitalize(caster->name())), caster);
  suc=SpellSuccess(caster,sinfo);
  if (suc<=0) return MISSERFOLG;

  write_color(BS("Ein elementarer Feuersturm umgibt Dich wie eine "
      "toedliche Wand!"), FEUER, caster, 1);
  tell_room(ENV(caster), BS(sprintf("%s ist nun von einem gewaltigen "
            "Feuersturm umgeben! %s muss wahrhaft %s "
            "sein!\n", caster->Name(WER), CAP(caster->QueryPronoun(WER)),
            caster->QueryProp(P_GENDER)==FEMALE?"eine maechtige Druidin":
            "ein maechtiger Druide")), ({caster}));
  ob=clone_object(OBJ("dot"));
  ob->move(caster, M_NOCHECK);
  ob->SetVariables(6+(suc/3000), FEUER, suc, caster, 1);

  return ERFOLG;
}
