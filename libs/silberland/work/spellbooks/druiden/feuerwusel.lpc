/*
 * Feuerwusel
 *
 *
 * Kosten: 
 * Level : 2
 * Objekte:
 * Damage:
 *
 */

int prep_feuerwusel(object caster, mapping sinfo) 
{
  if(caster->InFight()) 
  {
    printf(BS("Du kannst Dich nicht auf die Muster des Zaubers "
              +"konzentrieren."));
    return 0;  
  }
  if(QueryOwnCreature(caster, 1, 0)) 
  {
    printf("Du hast schon einen Feuerwusel.\n");
    return 0; 
  }
  write_color("Du konzentrierst Dich auf die Macht des Feuers...\n", FEUER, caster);
  say(sprintf("%s scheint sich zu konzentrieren.\n", 
      capitalize(caster->name())));
  return 1;
}

int feuerwusel(object caster, mapping sinfo) 
{
  object l;

  sinfo=DoSpellModification(FEUER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  
  if(SpellSuccess(caster,sinfo)<=0)
  {
    write("....aber kein Feuerwusel erscheint.\n");
    return MISSERFOLG;
  }
 
  if(HAS_MYSTERY(caster, MYSTERY_FLAMEGHOST)) {
    write_color(BS("Wie aus dem Nichts erscheint ein kleiner Flammengeist, "
    +"der Dir von nun an folgt und Licht spendet."),FEUER, caster,1);
    say(sprintf(BS("Ploetzlich erscheint ein kleiner Feuerwusel, der "
    +"%s folgt und Licht spendet."),  capitalize(caster->name())));
    l = clone_object(NPC("flammengeist"));
  } else {
    write_color(BS("Wie aus dem Nichts erscheint ein kleiner Feuerwusel, "
    +"der Dir von nun an folgt und Licht spendet."),FEUER, caster,1);
    say(sprintf(BS("Ploetzlich erscheint ein kleiner Feuerwusel, der "
    +"%s folgt und Licht spendet."),  capitalize(caster->name())));
     l=clone_object(NPC("feuerwusel"));
  }
  l->move(environment(caster), M_NOCHECK|M_SILENT); 
  l->SetOwner(caster);
  l->LightOn(caster->QueryProp(P_GUILD_LEVEL)*50);
  l->SetProp(P_MSGOUT, "wuselt hinter "+caster->QueryProp(P_NAME)+" her");
  l->SetProp(ELEMENTAL_CASTER, caster);
  return ERFOLG;
}
