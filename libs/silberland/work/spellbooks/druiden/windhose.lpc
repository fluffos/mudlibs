/*
 * Windhose
 *
 *
 * Kosten: 
 * Level : 11
 * Objekte:
 * Damage:
 *
 */

int prep_windhose(object caster, mapping sinfo) 
{
  object *enemies; 
  enemies=FindGroup(caster, -1);
  if((!enemies || !sizeof(enemies)) && ( !HasElementalRing(LUFT, caster) && 
       call_other(DRUIDENMASTER, "GetDruidElement", caster)!=LUFT))
  {
    write("Ohne Gegner ist eine Windhose ziemlich sinnlos!\n");
    return 0;
  }
  if(present(DRUIDEN_DOT, caster)) 
  {
    write("Du hast schon eine elementare Aura um Dich!\n");
    return 0;
  }

  write_color("Grosse Luftwirbel bilden sich um Deine Haende.\n", LUFT,caster);
  return 1;
}

int windhose(object caster, mapping sinfo) 
{
  int suc;
  object ob;
  
  sinfo=DoSpellModification(LUFT, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  write_color(BS("Du konzentrierst Dich auf das Element Luft und machst "
           +"eine weitreichende Bewegung."),LUFT,caster);
  say(sprintf(BS("%s konzentriert sich und macht eine weitreichende "
      +"Bewegung.\n"), 
      capitalize(caster->name())), caster);
  suc=SpellSuccess(caster,sinfo);

  if (suc<=0) return MISSERFOLG;

  write_color("Eine gewaltige Windhose umgibt Dich nun!\n",LUFT, caster,1 );
  tell_room(ENV(caster), BS(sprintf("%s ist nun von einer gewaltigen "
            "Windhose umgeben!\n", caster->Name(WER))), ({caster}));
  ob=clone_object(OBJ("dot"));
  ob->move(caster, M_NOCHECK);
  ob->SetVariables(5+(suc/3000), LUFT, suc, caster, 1);

  return ERFOLG;
}

