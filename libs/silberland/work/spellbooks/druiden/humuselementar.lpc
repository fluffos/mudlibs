/*
 * Humusementar
 *
 *
 * Kosten: 
 * Level : 14
 * Objekte:
 * Damage:
 *
 */


int prep_humuselementar(object caster, mapping sinfo) 
{
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  if(present(DRUIDEN_SPELL_ENHANCE, caster)) 
  {
    write_color(BS("Du kannst aufgrund Deiner elementaren Veraenderung "
          "kein Elementar beschwoeren!"), HUMUS, caster);
    return 0;
  }
  write_color(BS("Du kniest Dich nieder, nimmst eine Handvoll Erde in die "
        "Hand und beschwoerst die Essenz des Elements..."),HUMUS,caster);
    
  say(BS(sprintf("%s kniet sich nieder, nimmt etwas Erde in die Hand "
          "und scheint sich zu konzentrieren...", caster->Name(WER,1))));
  return 1;
}

int humuselementar(object caster, mapping sinfo) 
{
  object l;
  int suc;
  int level, hands, e_defends;
   
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(HUMUS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  
  if((suc=SpellSuccess(caster,sinfo))<=0) 
  {
    if(suc<-2000) 
    {        
      write_color(BS("Aus der Erde entsteht eine Gestalt aus reinstem Humus, "
            "die Dich sofort attackiert!"),HUMUS, caster);
      say(BS(sprintf("Aus der Erde entsteht eine Gestalt aus reinstem "
              "Humus, die %s sofort attackiert!", caster->name(WEN, 1))));
      l=CreateElemental(caster, suc, HUMUS);
      l->SetAggressive(caster);
      caster->AddPursuer(l);   
      l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
      l->Kill(caster);
    }        
    return MISSERFOLG;
  } 
  l=CreateElemental(caster, suc, HUMUS);
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  write_color(BS("Aus der Erde entsteht eine baumhohe Gestalt aus "
        "Erde, Laub und Holz, umgeben von Dornenranken, "+l->name(WER,0)+"!"), 
      HUMUS, caster);
  tell_room(ENV(caster),BS("Aus der Erde entsteht eine baumhohe Gestalt aus "
      "Erde, Laub und Holz, umgeben von Dornenranken, "+l->name(WER,0)+"!"), 
      ({caster}));
  return ERFOLG;
}
