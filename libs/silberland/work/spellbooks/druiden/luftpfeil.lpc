/*
 * Luftpfeil
 *
 *
 * Kosten: 
 * Level : 1
 * Objekte:
 * Damage:
 *
 */

int luftpfeil(object caster, mapping sinfo) 
{
  object victim, o; 
  string vn, vnw, cn, resist_txt;
  int dam, suc;
  object ob;
  mapping resists;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Nach wem willst Du einen Luftpfeil werfen?\n");
  if (!victim)
    return 0;
  
  sinfo=DoSpellModification(LUFT, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  if((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  
  dam=sinfo[SI_SKILLDAMAGE]+
    5*suc*(caster->QueryProp(P_GUILD_LEVEL))/MAX_ABILITY; 
  dam=(dam/2)+random(dam/2); 
  cn = capitalize(caster->name());
  vnw = victim->name(WEN, 2);
  say(BS(sprintf("%s feuert einen elementaren Luftpfeil auf %s ab.\n",cn, vnw)),
      victim);
  write_color(BS("Du feuerst einen elementaren Luftpfeil auf "+vnw+" ab."), 
      LUFT, caster, 1);
  tell_object(victim,sprintf("%s feuert einen elementaren Luftpfeil "
      +"auf Dich ab.\n",cn));
  TryAttackSpell(victim,dam, DT_AIR, 
      ([SP_NAME:"luftpfeil",SP_SHOW_DAMAGE:1]),caster,sinfo );

  if(victim && (suc > 10000 && !random(3) || HAS_MYSTERY(caster, MYSTERY_DUSTSPRAY) && random(15000) < suc ) && !present("\n"+LUFT+"pfeil_enhance", victim)) 
  {
    ob=clone_object(OBJ("arrow_special"));
    ob->move(victim, M_NOCHECK);
    ob->SetVariables(caster, LUFT, victim);
  } else if(victim && sinfo[SI_SKILLABILITY] == MAX_ABILITY && suc > 7000 && !present(DRUIDEN_RESIST_MOD, victim) )
  {   
    if( !mappingp(resists=victim->QueryProp(P_RESISTANCE_STRENGTHS)) ||
        1.0*(resists[DT_MAGIC])<=0.1 )
    { 
      ob=clone_object(OBJ("resist"));
      ob->move(victim, M_NOCHECK);
      ob->SetVariables(caster,LUFT, victim, suc);
      resist_txt = BS(victim->Name(WER)+" wird von einer luftigen Aura umhuellt "
            "und ist jetzt anfaelliger gegen Erz.");
      write_color(resist_txt, LUFT, caster, 1);
      environment(caster)->Message(resist_txt, MSGFLAG_VISUAL, 
          ([MSGFLAG_EXCLUDE: ({caster})]) );
    }
  }

  if(objectp(victim) && objectp(o=present(ID_WEATHERMASTERY, ENV(caster)))) {
    o->lightningStike(victim);
  }
  
  return ERFOLG;
}
