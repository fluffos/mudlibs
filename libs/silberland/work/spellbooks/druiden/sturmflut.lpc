/*
 * Sturmflut
 *
 *
 * Kosten: 
 * Level : 12
 * Objekte:
 * Damage:
 *
 */

int prep_sturmflut(object caster, mapping sinfo) 
{
  object *enemies; 
  enemies=FindGroup(caster, -1);
  if((!enemies || !sizeof(enemies)) && (!HasElementalRing(WASSER, caster) &&
       call_other(DRUIDENMASTER, "GetDruidElement", caster)!=WASSER))
  {
    write("Ohne Gegner ist eine Sturmflut ziemlich sinnlos!\n");
    return 0;
  }
  if(present(DRUIDEN_DOT, caster)) 
  {
    write("Du hast schon eine elementare Aura um Dich!\n");
    return 0;
  }
  write_color("Du machst eine Wellenbewegung mit beiden Haenden.\n",
      WASSER, caster);
  return 1;
}

int sturmflut(object caster, mapping sinfo) 
{
  object ob;
  int suc;
  
  sinfo=DoSpellModification(WASSER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  write_color(BS("Du konzentrierst Dich auf das Element Wasser und blaest "
           +"in die zur Halbkugel geformten Haende."), WASSER, caster);
  say(sprintf(BS("%s konzentriert sich und blaest in die zur "
           +"Halbkugel geformten Haende.\n"), 
              capitalize(caster->name())), caster);
  suc=SpellSuccess(caster,sinfo);
  if (suc<=0) return MISSERFOLG;

  write_color(BS("Eine gewaltige elementare Sturmwelle umgibt Dich "
      "ploetzlich!"), WASSER, caster, 1);
  tell_room(ENV(caster), BS(sprintf("%s ist nun von einer gewaltigen "
            "Sturmwelle umgeben!\n", caster->Name(WER))), ({caster}));
  ob=clone_object(OBJ("dot"));
  ob->move(caster, M_NOCHECK);
  ob->SetVariables(5+(suc/3000), WASSER, suc, caster, 1);
  return ERFOLG;
}
