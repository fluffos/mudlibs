/*
 * Erzelementar
 *
 *
 * Kosten: 
 * Level : 11
 * Objekte:
 * Damage:
 *
 */


int prep_erzelementar(object caster, mapping sinfo) 
{
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  if(present(DRUIDEN_SPELL_ENHANCE, caster)) 
  {
    write_color(BS("Du kannst aufgrund Deiner elementaren Veraenderung "
          "kein Elementar beschwoeren!"), ERZ, caster);
    return 0;
  }
  write_color(BS("Du konzentrierst Dich auf das Element Erz, kniest Dich "
       +"nieder und beschwoerst die Macht der Elemente...\n"), ERZ, caster);
  say(sprintf("%s scheint sich zu konzentrieren und beruehrt die Erde. "
            +"Sie beginnt ganz leicht zu vibrieren...\n",
               capitalize(caster->name())));
  return 1;
}

int erzelementar(object caster, mapping sinfo) 
{
   object l;
   int suc;
   int level, hands, e_defends;
 
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(ERZ, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);

  if((suc=SpellSuccess(caster,sinfo))<=0) 
  {
    if(suc<-2000) 
    {
      write_color(BS("Ploetzlich bricht die Erde auf, und ein Elementar "
            "aus purem Erz entsteht aus dem Krater. Es wirkt SEHR "
            "wuetend..."), ERZ, caster);
      say(BS("Ploetzlich bricht die Erde auf und ein "
              "Elementar aus purem Erz waechst aus der Erde."));
      l=CreateElemental(caster, suc, ERZ);
      l->SetAggressive(caster);
      caster->AddPursuer(l);
      l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
      l->Kill(caster);
    }        
    return MISSERFOLG;
  } 
  l=CreateElemental(caster, suc, ERZ);
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  write_color(BS("Ploetzlich bricht die Erde auf, und "+l->name(WER,0)+
            " entsteht aus dem Krater."), ERZ, caster);
  say(BS("Ploetzlich bricht die Erde auf und "+l->name(WER,0)+
              " waechst aus der Erde.\n"));
  return ERFOLG;
}
