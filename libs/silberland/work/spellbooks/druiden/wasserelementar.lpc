/*
 * Wasserelementar
 *
 *
 * Kosten: 
 * Level : 12
 * Objekte:
 * Damage:
 *
 */

int prep_wasserelementar(object caster, mapping sinfo) 
{
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  if(present(DRUIDEN_SPELL_ENHANCE, caster)) 
  {
    write_color(BS("Du kannst aufgrund Deiner elementaren Veraenderung "
          "kein Elementar beschwoeren!"), WASSER, caster);
    return 0;
  }
  write_color(BS("Du konzentrierst Dich auf das Element Wasser, "
        "formst mit Deinen Haenden eine Welle "
        "und beschwoerst die Macht der Elemente..."), WASSER, caster);
  say(sprintf("%s scheint sich zu konzentrieren und bewegt seltsam "
            "die Haende.\n",capitalize(caster->name())));
  return 1;
}

int wasserelementar(object caster, mapping sinfo) 
{
  object l;
  int suc;
  int level, hands, e_defends;
  
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(WASSER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  
  if((suc=SpellSuccess(caster,sinfo))<=0) 
  {
    if(suc<-2000) 
    {
      write_color(BS("Wie aus dem Nichts entsteht eine Gestalt aus "
            "Wasser, die Dich mit "
            "zornerfuellten Blick anstarrt und dann ..."), WASSER, caster);
      say(sprintf(BS("Wie aus dem Nichts entsteht eine Gestalt aus Wasser, "
             "die %s zornerfuellt anblickt und ihn dann attackiert.\n"),
              caster->name()));
      l=CreateElemental(caster, suc, WASSER);
      l->SetAggressive(caster);
      l->move(environment(this_player()), M_NOCHECK|M_SILENT);
      l->Kill(caster);
    }
    return MISSERFOLG;
  }
  l=CreateElemental(caster, suc, WASSER);
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  write_color(BS("Wie aus dem Nichts entsteht "+l->name(WER,0)+"."), WASSER, caster);
  say(BS("Wie aus dem Nichts entsteht "+l->name(WER,0)+"."));
  return ERFOLG;
}

