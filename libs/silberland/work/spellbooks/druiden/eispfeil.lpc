/*
 * Eispfeil
 *
 *
 * Kosten: 
 * Level : 4
 * Objekte:
 * Damage:
 *
 */

int eispfeil(object caster, mapping sinfo) 
{
  object victim, ob;
  string vn, vnw, cn, resist_txt;
  int suc, dam;
  mapping resists;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
              BS("Nach wem willst Du einen elementaren Eispfeil werfen?\n"));
  if (!victim)
    return 0;
  
  sinfo=DoSpellModification(EIS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  if ((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  
  dam=sinfo[SI_SKILLDAMAGE]+
    5*suc*(caster->QueryProp(P_GUILD_LEVEL))/MAX_ABILITY; 
  dam=(dam/2)+random(dam/2);
  dam=(int)dam; 
  cn = caster->name();
  vnw = victim->name(WEN, 2);
  say(BS(sprintf("%s feuert einen elementaren Eispfeil auf %s ab.\n",cn, vnw)),
      victim);
  write_color(BS("Du feuerst einen elementaren Eispfeil auf "+vnw+" ab."), 
      EIS, caster, 1);
  tell_object(victim,sprintf("%s feuert einen elementaren "
              +"Eispfeil auf Dich ab.\n",cn));
  TryAttackSpell(victim,dam, DT_COLD, 
      ([SP_NAME:"eispfeil",SP_SHOW_DAMAGE:1]),caster,sinfo );
  if(victim && (suc > 10000 && !random(3) || HAS_MYSTERY(caster, MYSTERY_RIME) && random(15000) < suc ) && !present("\n"+EIS+"pfeil_enhance", victim)
     && !present("\n"+EIS+"pfeil_enhance", victim)) 
  {
    ob=clone_object(OBJ("arrow_special"));
    ob->move(victim, M_NOCHECK);
    ob->SetVariables(caster,EIS, victim);
  }
  else if(victim && sinfo[SI_SKILLABILITY] == MAX_ABILITY && suc > 7000 &&
      !present(DRUIDEN_RESIST_MOD, victim))
  {
    if( !mappingp(resists=victim->QueryProp(P_RESISTANCE_STRENGTHS)) || 
        (1.0*(resists[DT_FIRE])<=0.1 && 1.0*(resists[DT_POISON])<=0.1))
    {
      ob=clone_object(OBJ("resist"));
      ob->move(victim, M_NOCHECK);
      ob->SetVariables(caster,EIS, victim, suc);
      resist_txt = BS(victim->Name(WER)+" wird von einer eisigen Aura umhuellt "
            "und ist jetzt anfaelliger gegen Feuer und Humus.");
      write_color(resist_txt, EIS, caster, 1);
      environment(caster)->Message(resist_txt, MSGFLAG_VISUAL, 
          ([MSGFLAG_EXCLUDE: ({caster})]) );
    }
  }
  return ERFOLG;
}

