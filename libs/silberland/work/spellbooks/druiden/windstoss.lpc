/*
 * Windstoss
 *
 *
 * Kosten: 
 * Level : 6
 * Objekte:
 * Damage:
 *
 */

int prep_windstoss(object caster, mapping sinfo) 
{
  if( !FindEnemyVictim(sinfo[SI_SKILLARG],caster,
        "Auf wen willst Du einen elementaren Windstoss schleudern?\n") )
    return 0;
  write_color("Ein kleiner Luftwirbel bildet sich um Deine Hand.\n",
        LUFT, caster);  
  return 1;
}

int windstoss(object caster, mapping sinfo) 
{
  object victim, o, ob;
  object* victims;
  int hands, suc, dam, i;
  string vnw;  
 
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
        "Auf wen willst Du einen elementaren Windstoss schleudern?\n");
  if (!victim)
    return 0;
  
  sinfo=DoSpellModification(LUFT, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  if ((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  
  dam=to_int(sinfo[SI_SKILLDAMAGE]+
      (exp(caster->QueryProp(P_GUILD_LEVEL)/3.35)*suc/MAX_ABILITY));
  dam=(3*dam/5)+random(2*dam/5);
  
  vnw = victim->name(WEN, 2);
  say(BS(sprintf("%s konzentriert sich und feuert einen elementaren Windstoss "
       "auf %s.\n", capitalize(caster->name()), vnw)), victim);
  write_color(BS(sprintf("Du konzentrierst Deine Gedanken auf Deine Haende, "
          "in denen "
          "sich augenblicklich die Kraefte des Windes manifestieren "
          "und auf %s zuschiessen!", vnw)), LUFT, caster, 1);
  tell_object(victim, BS(sprintf("%s konzentriert sich und feuert einen "
        "elementaren Windstoss auf Dich.\n", capitalize(caster->name()))));
  TryAttackSpell(victim,dam, sinfo[SI_SKILLDAMAGE_TYPE],
      ([SP_NAME:sinfo[SI_SPELLNAME] ,SP_SHOW_DAMAGE:1]),caster,sinfo );

  if(victim && HAS_MYSTERY(caster, MYSTERY_DUSTSPRAY) && random(15000) < suc & !present("\n"+LUFT+"pfeil_enhance", victim)) {
    ob=clone_object(OBJ("arrow_special"));
    ob->move(victim, M_NOCHECK);
    ob->SetVariables(caster,LUFT, victim);
  }

  if( sinfo[SI_SKILLABILITY] == MAX_ABILITY && suc > MAX_ABILITY && 
      sizeof(victims=caster->PresentEnemies())>1 ) 
  {
    dam = dam/sizeof(victims);
    for(i=sizeof(victims)-1; i>=0; i--)
    {
      if (victims[i] != victim)
      {
        tell_object(victims[i], BS(
              "Ein Teil des Windstosses trifft auch Dich!\n"));
        TryAttackSpell(victims[i], dam/2+random(dam/2), sinfo[SI_SKILLDAMAGE_TYPE],
            ([SP_NAME:sinfo[SI_SPELLNAME], SP_SHOW_DAMAGE:1]), caster, sinfo);
      }
    }
  }

  if(objectp(victim) && objectp(o=present(ID_WEATHERMASTERY, ENV(caster)))) {
    o->lightningStike(victim);
  }

  return ERFOLG;
}
