/*
 * Erdbeben
 *
 *
 * Kosten: 
 * Level : 8
 * Objekte:
 * Damage:
 *
 */

int prep_erdbeben(object caster, mapping sinfo) 
{
  object *enemies; 
  enemies=FindGroup(caster, -1);
  if((!enemies || !sizeof(enemies)) && (!HasElementalRing(ERZ, caster) &&
       call_other(DRUIDENMASTER, "GetDruidElement", caster)!=ERZ))
  {
    write("Ohne Gegner ist ein Erdbeben ziemlich sinnlos!\n");
    return 0;
  }
  if(present(DRUIDEN_DOT, caster)) {
    write("Du hast schon eine elementare Aura um Dich!\n");
    return 0;
  }
  write_color("Du legst beide Handflaechen auf den Boden.\n", ERZ, caster);
  return 1;
}

int erdbeben(object caster, mapping sinfo) 
{
  int suc;
  object ob;

  sinfo=DoSpellModification(ERZ, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  write_color(BS("Du konzentrierst Dich auf das Element Erz und beruehrst "
           +"die Erde."),ERZ,caster);
  say(BS(sprintf("%s konzentriert sich und beruehrt die Erde.", 
              capitalize(caster->name()))));
  suc=SpellSuccess(caster,sinfo);
  if (suc<=0) return MISSERFOLG;

  write_color("Die Erde beginnt unter Deinen Fuessen zu beben!\n", ERZ,
      caster, 1);
  tell_room(ENV(caster), "Die Erde beginnt zu beben!\n", ({caster}));
  ob=clone_object(OBJ("dot"));
  ob->move(caster, M_NOCHECK);
  ob->SetVariables(5+(suc/2000), ERZ, suc, caster, 1);
  return ERFOLG;
}
