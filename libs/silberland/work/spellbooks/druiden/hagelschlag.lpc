/*
 * Hagelschlag
 *
 *
 * Kosten: 
 * Level : 14
 * Objekte:
 * Damage:
 *
 */

int prep_hagelschlag(object caster, mapping sinfo) 
{
  object *enemies; 
  enemies=FindGroup(caster, -1);
  if((!enemies || !sizeof(enemies)) && (!HasElementalRing(EIS, caster) &&
       call_other(DRUIDENMASTER, "GetDruidElement", caster)!=EIS))
  {
    write("Ohne Gegner ist ein Hagelschlag ziemlich sinnlos!\n");
    return 0;
  }
  if(present(DRUIDEN_DOT, caster)) 
  {
    write("Du hast schon eine elementare Aura um Dich!\n");
    return 0;
  }
  write_color("Eine eisige Wolke entsteht zwischen Deinen Haenden.\n",
      EIS, caster);
  return 1;
}

int hagelschlag(object caster, mapping sinfo) 
{
  object ob;
  int suc;
  
  sinfo=DoSpellModification(EIS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  write_color(BS("Du konzentrierst Dich auf das Element Eis und "
           +"erstarrst wie eine Eisstatue."), EIS, caster);
  say(sprintf(BS("%s konzentriert sich und erstarrt."), 
              capitalize(caster->name())), caster);
  suc=SpellSuccess(caster,sinfo);
  if (suc<=0) return MISSERFOLG;

  write_color(BS("Ein gewaltiger elementarer Hagelsturm umtost Dich "
      "nun!"), EIS, caster, 1);
  tell_room(ENV(caster), BS(sprintf("%s wird ploetzlich von einem gewaltigen "
          "Hagelsturm umtost!", caster->Name(WER))), ({caster}));
  ob=clone_object(OBJ("dot"));
  ob->move(caster, M_NOCHECK);
  ob->SetVariables(5+(suc/3000), EIS, suc, caster, 1);
  return ERFOLG;
}
