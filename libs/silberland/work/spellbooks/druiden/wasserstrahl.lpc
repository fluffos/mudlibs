/*
 * Wasserstrahl
 *
 *
 * Kosten: 
 * Level : 8
 * Objekte:
 * Damage:
 *
 */

int prep_wasserstrahl(object caster, mapping sinfo) 
{
  if (!FindEnemyVictim(sinfo[SI_SKILLARG],caster,
        "Auf wen willst Du einen elementaren Wasserstrahl abfeuern?\n") )
    return 0;
  write_color("Elementares Wasser sammelt sich in Deiner Hand.\n", WASSER, 
      caster);  
  return 1;
}

int wasserstrahl(object caster, mapping sinfo) 
{
  object victim;
  int hands, kosten, suc, dam;
  string vnw; 
  object *victims;
  int i;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
        "Auf wen willst Du einen elementaren Wasserstrahl abfeuern?\n");
  if (!victim)
    return 0;
  sinfo=DoSpellModification(WASSER, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  if ((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  dam=to_int(sinfo[SI_SKILLDAMAGE]+(exp(caster->QueryProp(P_GUILD_LEVEL)/3.35)*
    ((float)suc/MAX_ABILITY)));
  dam=(3*dam/5)+random(2*dam/5);
  vnw = victim->name(WEN, 2);
  say(BS(sprintf("%s konzentriert sich und ein Strahl elementar reinen "
       "Wassers schiesst auf %s zu.\n", capitalize(caster->name()), vnw)), 
      victim);
  write_color(BS(sprintf("In Deinen zur Halbschale geoeffneten Haenden "
          "manifestiert "
          "sich elementar reines Wasser, um mit gewaltiger Kraft auf %s "
          "zuzuschiessen!", vnw)), WASSER, caster, 1);
  tell_object(victim, BS(sprintf("%s wirft einen elementar reinen Wasser"
        "strahl nach Dir!\n", capitalize(caster->name()))));
  TryAttackSpell(victim,dam, sinfo[SI_SKILLDAMAGE_TYPE], 
      ([SP_NAME:sinfo[SI_SPELLNAME],SP_SHOW_DAMAGE:1]),caster,sinfo );

  if( sinfo[SI_SKILLABILITY] == MAX_ABILITY && suc > MAX_ABILITY && 
      sizeof(victims=caster->PresentEnemies())>1 ) 
  {
    dam = dam/sizeof(victims);
    for(i=sizeof(victims)-1; i>=0; i--)
    {
      if (victims[i] != victim)
      {
        tell_object(victims[i], BS(
              "Ein Teil des Wasserstrahles trifft auch Dich!\n"));
        TryAttackSpell(victims[i], dam/2+random(dam/2), sinfo[SI_SKILLDAMAGE_TYPE],
            ([SP_NAME:sinfo[SI_SPELLNAME], SP_SHOW_DAMAGE:1]), caster, sinfo);
      }
    }
  }

  if(objectp(victim)) {
    drown(caster, victim, suc);
  }

  return ERFOLG;
}
