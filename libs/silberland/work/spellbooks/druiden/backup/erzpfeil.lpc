/*
 * Erzpfeil
 *
 *
 * Kosten: 
 * Level : 2
 * Objekte:
 * Damage:
 *
 */

int erzpfeil(object caster, mapping sinfo) 
{
  object victim, ob;
  string vn, vnw, cn;
  int suc, dam;

  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Nach wem willst Du einen Erzpfeil werfen?\n");
  if (!victim)
    return 0;
  
  sinfo=DoSpellModification(ERZ, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  if ((suc=SpellSuccess(caster,sinfo))<=0)
    return MISSERFOLG;
  
  dam=sinfo[SI_SKILLDAMAGE]+
    5*suc*(caster->QueryProp(P_GUILD_LEVEL))/MAX_ABILITY; 
  if(dam >250) dam=250;
  dam=(dam/2)+random(dam/2);
  
  cn = caster->name();
  vnw = victim->name(WEN, 2);
  say(BS(sprintf("%s feuert einen elementaren Erzpfeil auf %s ab.\n",cn, vnw)),
    victim);
  write_color(BS("Du feuerst einen elementaren Erzpfeil auf "+vnw+" ab."), 
    ERZ, caster, 1);
  tell_object(victim,sprintf("%s feuert einen elementaren "
              +"Erzpfeil auf Dich ab.\n",cn));
  if(suc > 10000 && !random(3)) 
  {
    if(!present("\n"+ERZ+"pfeil_enhance", victim)) 
    {
      ob=clone_object(OBJ("arrow_special"));
      ob->move(victim, M_NOCHECK);
      ob->SetVariables(caster,ERZ, victim);
    }
  }
  TryAttackSpell(victim,dam, sinfo[SI_SKILLDAMAGE_TYPE], 
      ([SP_NAME:"erzpfeil",SP_SHOW_DAMAGE:1]),caster,sinfo );

  return ERFOLG;
}
