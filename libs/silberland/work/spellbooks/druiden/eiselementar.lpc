/*
 * Eiselementar
 *
 *
 * Kosten: 
 * Level : 13
 * Objekte:
 * Damage:
 *
 */


int prep_eiselementar(object caster, mapping sinfo) 
{
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  if(present(DRUIDEN_SPELL_ENHANCE, caster)) 
  {
    write_color(BS("Du kannst aufgrund Deiner elementaren Veraenderung "
          "kein Elementar beschwoeren!"), EIS, caster);
    return 0;
  }
  write_color(BS("Du presst Deine Haende zusammen, konzentrierst "
        "Dich auf die Macht des Eises und murmelst leise "
       "die Beschwoerungsformeln."), EIS, caster);
  say(sprintf(BS("%s murmelt etwas und presst die Haende "
       "zusammen.\n"),capitalize(caster->name())));
  return 1;
}

int eiselementar(object caster, mapping sinfo) 
{
  object l;
  int suc;
  int level, hands, e_defends;
   
  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(EIS, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  
  if((suc=SpellSuccess(caster,sinfo))<=0) 
  {
    if(suc<-2000) 
    {
      write_color(BS("Ploetzlich faellt die Temperatur rapide ab "
            "und ein Eiselementar formt sich aus der Kaelte. Es "
            "blickt Dich hasserfuellt an... und attackiert Dich!"),
          EIS, caster); 
      say(sprintf(BS("Urploetzlich faellt die Temperatur ab, und aus "
                "der Kaelte formt sich ein Eiselementar, welches %s "
                "sofort attackiert!\n"),caster->name()));
      l=CreateElemental(caster, suc, EIS);
      caster->AddPursuer(l);
      l->SetAggressive(caster);
      l->move(environment(this_player()), M_NOCHECK|M_SILENT);  
      l->Kill(caster);
    }        
    return MISSERFOLG;  
  } 
  l=CreateElemental(caster, suc, EIS);
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  write_color(BS("Ploetzlich faellt die Temperatur rapide ab "  
      "und "+l->name(WER,0)+" formt sich aus der Kaelte."), EIS, caster);   
  say(BS("Urploetzlich faellt die Temperatur ab, und aus "
                "der Kaelte formt sich "+l->name(WER,0)+"."));
  return ERFOLG;
}
