/*
 * Luftelementar
 *
 *
 * Kosten: 
 * Level : 10
 * Objekte:
 * Damage:
 *
 */

int prep_luftelementar(object caster, mapping sinfo) 
{
  if(QueryOwnCreature(caster, 0, 2))
  {
    printf("Da ist schon ein Elementar.\n");
    return 0;
  }
  if(present(DRUIDEN_SPELL_ENHANCE, caster)) 
  {
    write_color(BS("Du kannst aufgrund Deiner elementaren Veraenderung "
          "kein Elementar beschwoeren!"), LUFT, caster);
    return 0;
  }
  write_color(BS("Du konzentrierst Dich auf das Element Luft und "
       "laesst das Bild eines Luftelementars in Deinem "
       "Geist entstehen.\n"), LUFT, caster);
  say(sprintf("%s scheint sich zu konzentrieren. "
               +"Die Luft beginnt zu flimmern...\n",
               capitalize(caster->name())));
  return 1;
}

int luftelementar(object caster, mapping sinfo) 
{
  object l;
  int suc;
  int level, hands, e_defends;

  if(QueryOwnCreature(caster, 0, 2)) 
  {
    printf("Da ist schon ein Elementar.\n");
    return 0; 
  }
  sinfo=DoSpellModification(LUFT, caster, sinfo);
  if(caster->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) 
  {
    printf(sinfo[SI_SP_LOW_MSG]); 
    return 0;
  }
  caster->AddSp(-sinfo[SI_RAW_SPELLCOST]);
  
  if((suc=SpellSuccess(caster,sinfo))<=0) 
  {
    if(suc<-2000) 
    {
      write_color(BS("Urploetzlich beginnt sich die Luft zu verwirbeln, "
             "und ein Luftelementar erscheint, dass ziemlich aergerlich "
             "und wuetend zu sein scheint!!! Es attackiert Dich!\n"), LUFT,
             caster);
      say(sprintf(BS("Urploetzlich beginnt sich die Luft zu verwirbeln, "
            "und ein Luftelementar erscheint, dass auf %s ziemlich wuetend "
            "zu sein scheint...\n"),  caster->name()));
      l=CreateElemental(caster, suc, LUFT);
      l->SetAggressive(caster);
      caster->AddPursuer(l);
      l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
      l->Kill(caster);
    }
    return MISSERFOLG;
  } 
  l=CreateElemental(caster, suc, LUFT);
  l->move(environment(this_player()), M_NOCHECK|M_SILENT); 
  write_color(BS("Urploetzlich beginnt sich die Luft zu verwirbeln, "
            "und "+l->name(WER,0)+" erscheint."), LUFT, caster);
  say(BS("Urploetzlich beginnt sich die Luft zu verwirbeln, "
            "und "+l->name(WER,0)+" erscheint.\n"));
  return ERFOLG;
}
