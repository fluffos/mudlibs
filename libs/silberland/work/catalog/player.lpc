/*
 * Catalog player for SilberLand Strategy A (LDMud -> FluffOS).
 * Starts in /gilden/abenteurer (Die beruehmte Abenteurergilde) and walks
 * /room/treff and central Midas (/d/ebene/Midas/room/) with German + English commands.
 */

string name;
string password;
int guest_mode;
int hp;
int max_hp;
int sp;
int max_sp;
int money;

int cmd_look(string arg);
int cmd_read(string arg);
int cmd_smell(string arg);
int cmd_listen(string arg);
int cmd_feel(string arg);
int cmd_score(string arg);
int cmd_inventory(string arg);
int cmd_help(string arg);
int cmd_go(string dir);
int cmd_quit(string arg);
void save_me();

void create() {
  seteuid(getuid());
  hp = 50;
  max_hp = 50;
  sp = 50;
  max_sp = 50;
  money = 100;
}

void set_guest(int g) { guest_mode = g; }
string query_name() { return name; }
string query_password() { return password; }
int query_hp() { return hp; }
int query_mhp() { return max_hp; }
int query_level() { return 1; }
int query_money() { return money; }

string save_path() {
  if (!name || name == "" || guest_mode)
    return 0;
  return sprintf("/data/%c/%s", name[0], name);
}

void ensure_letter_dir() {
  string d;

  if (!name || guest_mode)
    return;
  d = sprintf("/data/%c", name[0]);
  if (file_size("/data") != -2)
    mkdir("/data");
  if (file_size(d) != -2)
    mkdir(d);
}

int restore_me(string n) {
  name = n;
  guest_mode = 0;
  if (!restore_object(save_path()))
    return 0;
  if (max_hp < 1)
    max_hp = 50;
  if (hp < 1)
    hp = max_hp;
  if (max_sp < 1)
    max_sp = 50;
  if (sp < 1)
    sp = max_sp;
  return 1;
}

void setup_new(string n, string pw) {
  name = n;
  password = pw;
  hp = 50;
  max_hp = 50;
  sp = 50;
  max_sp = 50;
  money = 100;
}

void save_me() {
  string p;

  p = save_path();
  if (!p)
    return;
  ensure_letter_dir();
  save_object(p);
}

void wire_commands() {
  enable_commands();
  add_action("cmd_look", "schau");
  add_action("cmd_look", "schaue");
  add_action("cmd_look", "untersuche");
  add_action("cmd_look", "unt");
  add_action("cmd_look", "look");
  add_action("cmd_look", "l");
  add_action("cmd_read", "lies");
  add_action("cmd_read", "lese");
  add_action("cmd_read", "read");
  add_action("cmd_smell", "rieche");
  add_action("cmd_smell", "smell");
  add_action("cmd_listen", "lausche");
  add_action("cmd_listen", "horche");
  add_action("cmd_listen", "hoere");
  add_action("cmd_listen", "listen");
  add_action("cmd_feel", "fuehle");
  add_action("cmd_feel", "betaste");
  add_action("cmd_feel", "feel");
  add_action("cmd_score", "status");
  add_action("cmd_score", "score");
  add_action("cmd_score", "sc");
  add_action("cmd_inventory", "inventar");
  add_action("cmd_inventory", "inventory");
  add_action("cmd_inventory", "i");
  add_action("cmd_help", "hilfe");
  add_action("cmd_help", "help");
  add_action("cmd_quit", "ende");
  add_action("cmd_quit", "quit");
  add_action("cmd_go", "norden");
  add_action("cmd_go", "nord");
  add_action("cmd_go", "sueden");
  add_action("cmd_go", "sued");
  add_action("cmd_go", "osten");
  add_action("cmd_go", "ost");
  add_action("cmd_go", "westen");
  add_action("cmd_go", "hoch");
  add_action("cmd_go", "oben");
  add_action("cmd_go", "runter");
  add_action("cmd_go", "unten");
  add_action("cmd_go", "north");
  add_action("cmd_go", "south");
  add_action("cmd_go", "east");
  add_action("cmd_go", "west");
  add_action("cmd_go", "up");
  add_action("cmd_go", "down");
  add_action("cmd_go", "n");
  add_action("cmd_go", "s");
  add_action("cmd_go", "o");
  add_action("cmd_go", "e");
  add_action("cmd_go", "w");
  add_action("cmd_go", "u");
  add_action("cmd_go", "d");
  add_action("cmd_go", "welt");
  add_action("cmd_go", "raus");
}

void enter_world() {
  object dest;

  set_living_name(name);
  wire_commands();
  dest = 0;
  catch(dest = load_object("/gilden/abenteurer"));
  if (!dest)
    catch(dest = load_object("/room/void"));
  if (dest)
    efun::move_object(dest);
  write("\n");
  command("schau");
  save_me();
}

mixed process_input(string str) {
  string verb, rest;

  if (!str)
    return 0;
  if (sscanf(str, "%s %s", verb, rest) != 2) {
    verb = str;
    rest = 0;
  }
  switch (verb) {
    case "schau":
    case "schaue":
    case "untersuche":
    case "unt":
    case "look":
    case "l":
      cmd_look(rest);
      return 1;
    case "lies":
    case "lese":
    case "read":
      cmd_read(rest);
      return 1;
    case "rieche":
    case "smell":
      cmd_smell(rest);
      return 1;
    case "lausche":
    case "horche":
    case "hoere":
    case "listen":
      cmd_listen(rest);
      return 1;
    case "fuehle":
    case "betaste":
    case "feel":
      cmd_feel(rest);
      return 1;
    case "status":
    case "score":
    case "sc":
      cmd_score(rest);
      return 1;
    case "inventar":
    case "inventory":
    case "i":
      cmd_inventory(rest);
      return 1;
    case "hilfe":
    case "help":
      cmd_help(rest);
      return 1;
    case "ende":
    case "quit":
      cmd_quit(rest);
      return 1;
    case "norden":
    case "nord":
    case "sueden":
    case "sued":
    case "osten":
    case "ost":
    case "westen":
    case "hoch":
    case "oben":
    case "runter":
    case "unten":
    case "north":
    case "south":
    case "east":
    case "west":
    case "up":
    case "down":
    case "n":
    case "s":
    case "o":
    case "e":
    case "w":
    case "u":
    case "d":
    case "welt":
    case "raus":
      cmd_go(verb);
      return 1;
  }
  return 0;
}

int cmd_look(string arg) {
  object env, *inv;
  string out, brief, item;
  int i;

  env = environment();
  if (!env) {
    write("Du bist im Nirgendwo.\n");
    return 1;
  }
  if (arg && sscanf(arg, "an %s", arg) == 1)
    ;
  if (arg && sscanf(arg, "at %s", arg) == 1)
    ;
  if (arg && arg != "") {
    if (function_exists("query_item", env)) {
      item = env->query_item(arg);
      if (stringp(item) && item != "") {
        write(item);
        return 1;
      }
    }
    write("Du siehst nichts Besonderes.\n");
    return 1;
  }
  brief = env->query_short();
  if (brief && brief != "")
    write(brief + "\n");
  out = env->query_long();
  if (!out || out == "")
    out = "Du siehst nichts Besonderes.";
  write(out);
  if (out[<1] != '\n')
    write("\n");
  if (function_exists("query_exit_string", env))
    write(env->query_exit_string());
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] != this_object() && inv[i]->query_name())
      write(capitalize(inv[i]->query_name()) + " steht hier.\n");
  }
  return 1;
}

int cmd_read(string arg) {
  object env;
  string s;

  env = environment();
  if (!env)
    return 1;
  if (arg && function_exists("query_read", env)) {
    s = env->query_read(arg);
    if (stringp(s) && s != "") {
      write(s);
      return 1;
    }
  }
  write("Das kannst Du nicht lesen.\n");
  return 1;
}

int cmd_smell(string arg) {
  object env;
  string s;

  env = environment();
  if (!env)
    return 1;
  if (function_exists("query_smell", env)) {
    s = env->query_smell(arg);
    if (stringp(s) && s != "") {
      write(s);
      return 1;
    }
  }
  write("Du riechst nichts Besonderes.\n");
  return 1;
}

int cmd_listen(string arg) {
  object env;
  string s;

  env = environment();
  if (!env)
    return 1;
  if (function_exists("query_noise", env)) {
    s = env->query_noise(arg);
    if (stringp(s) && s != "") {
      write(s);
      return 1;
    }
  }
  write("Du hoerst nichts Besonderes.\n");
  return 1;
}

int cmd_feel(string arg) {
  object env;
  string s;

  env = environment();
  if (!env)
    return 1;
  if (arg && function_exists("query_feel", env)) {
    s = env->query_feel(arg);
    if (stringp(s) && s != "") {
      write(s);
      return 1;
    }
  }
  write("Du fuehlst nichts Ungewoehnliches.\n");
  return 1;
}

int cmd_score(string arg) {
  write(capitalize(name || "jemand") + " (Stufe " + query_level() + ")\n");
  write("LP: " + hp + "/" + max_hp + "  MP: " + sp + "/" + max_sp + "  Muenzen: " + money + "\n");
  return 1;
}

int cmd_inventory(string arg) {
  object *inv;
  string brief;
  int i, n;

  inv = all_inventory(this_object());
  n = sizeof(inv);
  if (!n) {
    write("Du traegst nichts bei Dir.\n");
    return 1;
  }
  write("Du traegst bei Dir:\n");
  for (i = 0; i < n; i++) {
    brief = inv[i]->query_short();
    if (!brief || brief == "")
      brief = inv[i]->query_name();
    if (brief && brief != "")
      write("  " + brief + "\n");
  }
  return 1;
}

int cmd_help(string arg) {
  write(
    "Befehle: schau/unt/look [etwas], lies/read <etwas>, rieche/smell,\n"
    "         lausche/listen [etwas], fuehle/feel <etwas>,\n"
    "         norden/n, sueden/s, osten/o/e, westen/w, oben/u, unten/d,\n"
    "         status/score, inventar/i, ende/quit.\n"
  );
  return 1;
}

int cmd_go(string dir) {
  object env, dest;
  string path;

  if (!dir)
    dir = query_verb();
  env = environment();
  if (!env) {
    write("Du bist im Nirgendwo.\n");
    return 1;
  }
  path = env->query_exit(dir);
  if (!path) {
    write("In diese Richtung geht es nicht.\n");
    return 1;
  }
  dest = 0;
  catch(dest = load_object(path));
  if (!dest) {
    write("Dieser Ausgang fuehrt ins Leere.\n");
    return 1;
  }
  efun::move_object(dest);
  command("schau");
  return 1;
}

int cmd_quit(string arg) {
  if (guest_mode)
    write("Auf Wiedersehen im SilberLand!\n");
  else {
    write("Speichere " + capitalize(name || "jemand") + ".\n");
    save_me();
  }
  destruct(this_object());
  return 1;
}
