/*
 * Base room for the SilberLand LDMud -> FluffOS catalog overlay.
 */

private string short_desc;
private string long_desc;
private string exit_str;
private mapping exits;
private mapping items;
private mapping reads;
private mapping smells;
private mapping noises;

void create() {
  exits = ([]);
  items = ([]);
  reads = ([]);
  smells = ([]);
  noises = ([]);
}

void set_short(string s) { short_desc = s; }
void set_long(string s) { long_desc = s; }
void set_exit_string(string s) { exit_str = s; }
void set_exits(mapping m) { exits = m || ([]); }
void set_items(mapping m) { items = m || ([]); }
void set_reads(mapping m) { reads = m || ([]); }
void set_smells(mapping m) { smells = m || ([]); }
void set_noises(mapping m) { noises = m || ([]); }

string query_short() { return short_desc || ""; }
string query_long() { return long_desc || ""; }
string long() { return query_long(); }

string normalize_dir(string dir) {
  switch (dir) {
    case "n":
    case "nord":
    case "north":
      return "norden";
    case "s":
    case "sued":
    case "south":
      return "sueden";
    case "o":
    case "ost":
    case "e":
    case "east":
      return "osten";
    case "w":
    case "west":
      return "westen";
    case "u":
    case "up":
    case "hoch":
      return "oben";
    case "d":
    case "down":
    case "runter":
      return "unten";
    default:
      return dir;
  }
}

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  dir = lower_case(dir);
  if (exits[dir])
    return exits[dir];
  return exits[normalize_dir(dir)];
}

string query_exit_string() {
  string *dirs;
  int n;

  if (exit_str && exit_str != "")
    return exit_str;
  if (!exits || !sizeof(exits))
    return "Es gibt keine sichtbaren Ausgaenge.\n";
  dirs = sort_array(keys(exits), 1);
  n = sizeof(dirs);
  if (n == 1)
    return "Es gibt einen sichtbaren Ausgang: " + dirs[0] + ".\n";
  return "Es gibt " + n + " sichtbare Ausgaenge: " + implode(
    dirs[0..<2],
    ", "
  ) + " und " + dirs[<1] + ".\n";
}

string query_item(string arg) {
  if (!items || !arg)
    return 0;
  return items[lower_case(arg)];
}

string query_read(string arg) {
  if (!reads || !arg)
    return 0;
  return reads[lower_case(arg)];
}

string query_smell(string arg) {
  if (!smells)
    return 0;
  return smells[arg ? lower_case(arg) : "default"];
}

string query_noise(string arg) {
  if (!noises)
    return 0;
  return noises[arg ? lower_case(arg) : "default"];
}
