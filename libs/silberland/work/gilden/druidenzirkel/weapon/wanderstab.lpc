
inherit "std/weapon";

#include <properties.h>     // Properties definieren 
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "../druiden.h"

int heal=1;
int time=0;
create()
{
  if (!is_clone(TO)) return;
  ::create(); 
  SetProp(P_SHORT, "Ein Wanderstab");    //Kurzbeschreibung
  SetProp(P_LONG,
      "Ein ganz normaler Wanderstab. Mit ihm kann man gut wandern.");
  AddId (({"stab", "wanderstab"}));
  SetProp (P_NAME, "Wanderstab");
  SetProp (P_GENDER, MALE);  
  SetProp (P_VALUE, 10000); 
  SetProp (P_WEIGHT, 1000); 
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, ({DT_BLUDGEON})); 
  SetProp (P_NOBUY, 0);
  SetProp (P_MAGIC, 0);
  SetProp (P_WC,100);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, MAT_OAK);
  SetProp (P_INFO, "Der Stab kann Dich in gewissen Zeitabstaenden "
           +"heilen und zwar mit dem Wort \"humusmacht\".\n"); 
  SetWieldFunc(TO);
  AddCmd("humusmacht", "heilung");
}

reset()
{
  object ob;
  if(living(ob=ENV(ME))) {
     if(ob->InFight()) ob->heal_self(15+random(5));
     else ob->heal_self(random(5));
     tell_object(ob, BS("Dein Wanderstab leuchtet kurz auf "
        "und Du fuehlst Dich ploetzlich wohler!\n"));
     tell_room(ENV(ob), sprintf("Der Wanderstab von %s "
          +"leuchtet kurz auf.\n", ob->name()), ({ob}));
     if(!heal) heal++;
     else if(!random(2) && heal<4) heal++;
     if(!random(20) && heal<18 && interactive(ENV(TO))) heal=heal+5;
  }
 ::reset();
}

heilung()
{
 notify_fail("Du musst den Wanderstab erst zuecken.\n");
 if((TP->QueryProp(P_WEAPON))!=ME) return 0;
 notify_fail("Der Stab muss erst neue Kraft gewinnen.\n");
 if(!heal) return 0;
 notify_fail("Du musst noch ein bisschen warten, bis die Humuskraft "
        +"Dich heilen kann.\n");
 if(time>time()) return 0;
 write("Die Kraft des Humus fliesst in Dich und heilt Dich.\n");
 say(BS(TPN+" umklammert seinen Stab und scheint sich gleich besser "
       +"zu fuehlen."));
 TP->heal_self(40+random(20));
 heal--;
 time=time()+10;
 return 1;
}

int WieldFunc(object ob)
{
 time=time()+10; 
 return 1;
}

int QueryHeals()
{
 return heal;
}
