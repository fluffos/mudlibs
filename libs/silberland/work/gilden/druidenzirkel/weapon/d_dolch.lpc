// /gilden/druidenzirkel/weapon/d_dolch.c
// Der Druidendolch
// 02.08.1997  Angrox@SilberLand

#include "/gilden/druidenzirkel/druiden.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Der Druidendolch");
  SetProp(P_LONG, BS( 
    "Der Druidendolch besteht aus Obsidan und ist das Ritualwerkzeug "
   +"der Druiden."));
  SetProp(P_INFO, "Nur mit diesem Dolch koennen die Druiden zaubern.");
  SetProp(P_NAME, "Druidendolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "druidendolch", "\ndruidendolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 100);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_GLASS);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

}


int WieldFunc(object waffe)
{
  write("\nWieldFunc!\n");
  if(TP->QueryProp(P_GUILD)!= "druidenzirkel")
  {
    write("Wie kommst DU denn zu einem Druidendolch?\n");
    call_out("remove",0);
    return 1;
  }
  if(waffe==ME) return 1;
  //material=waffe->QueryProp(P_MATERIAL);
  if(member_array(MAT_METAL,waffe->QueryProp(P_MATERIAL) )!=-1 ||
     member_array(MAT_IRON,waffe->QueryProp(P_MATERIAL) )!=-1 ||
     member_array(MAT_GOLD,waffe->QueryProp(P_MATERIAL) )!=-1)
  {
    write("Als Druide darfst Du keine Waffe aus Metall haben.\n");
    return 0;
  }
  return 1; 
}

int UnwieldFunc(object waffe)
{
 return 1;
}


void init()
{
  ::init();
  if(!interactive(MENV))
    call_out("remove",0);
  if(MENV->QueryProp(P_GUILD)!= "druidenzirkel")
  {
    write("Wie kommst DU denn zu einem Druidendolch?\n");
    call_out("remove",0);
    return 0;
  }
  if(TP!=MENV) return 0;
  MENV->SetProp(P_WIELD_FUNC, TO);
  MENV->SetProp(P_UNWIELD_FUNC, TO);
}



