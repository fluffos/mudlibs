{
  string name;

  if(sizeof(fruits) == 6)
  {
    write("Du hast schon genug Fruechte fuer dieses Rezept.\n");
    return 0;
  }
  name = fruit->QueryProp(P_NAME);
  if(member(fruits, name) == -1)
  {
    fruits += ({name});
    return 1;
  }
  else
  {
    write("Du brauchst keine zwei gleichen Fruechte fuer dieses Rezept.\n");
    return 0;
  }
}

int CheckIce(object ice)
{
  string name;

  if(sizeof(ices) == 6)
  {
    write("Du hast schon genug Eis fuer dieses Rezept.\n");
    return 0;
  }
  name = ice->QueryProp(P_NAME);
  if(member(ices, name) == -1)
  {
    ices += ({name});
    return 1;
  }
  else
  {
    write("Du brauchst keine zwei gleichen Eise fuer dieses Rezept.\n");
    return 0;
  }
}

int CheckMetal(object metal)
{
  string mat;

  if(sizeof(metals) == 6)
  {
    write("Du hast schon genug Metalle fuer dieses Rezept.\n");
    return 0;
  }
  mat = m_indices(metal->QueryProp(P_MATERIAL))[0];
  if(member(metals, mat) == -1)
  {
    metals += ({mat});
    return 1;
  }
  else
  {
    write("Du brauchst keine zwei gleichen Metalle fuer dieses Rezept.\n");
    return 0;
  }
}

varargs int PreventInsert(object ob) 
{
  int mp;

  if( TP->QueryProp(P_SP) < (mp = 1 + sizeof(all_inventory(TO))) )
  {
    write("Aber Deine Magie ist dazu zu schwach!\n");
    return 1;
  }

  if(file_name(ob)[0..41] == "/gilden/druidenzirkel/armour/elementarring" && 
      CheckRing(ob))
  {
    write(ob->Name(WER,1) + " ist ein passender Ring zu diesem Rezept.\n");
  }
  else if(file_name(ob)[0..9] == "/obj/gems/" && 
      member(all_gems, (explode(file_name(ob),"#")[0])[10..]) != -1 && 
      CheckGem(ob)) 
  {
    write(ob->Name(WER,1) + " sind passende Edelsteine zu diesem Rezept.\n");
  }
  else if(file_name(ob)[0..11] == "/obj/pearls/" && 
      member(all_pearls, (explode(file_name(ob),"#")[0])[12..]) != -1 && 
      CheckPearl(ob)) 
  {
    write(ob->Name(WER,1) + " sind passende Perlen zu diesem Rezept.\n");
  }
  else if(member(all_fruits, ob->QueryProp(P_NAME)) != -1 && CheckFruit(ob))
  {
    write(ob->Name(WER,1) + " ist eine passende Frucht zu diesem Rezept.\n");
  }
  else if(member(all_ice, ob->QueryProp(P_NAME)) != -1 && CheckIce(ob))
  {
    write(ob->Name(WER,1) + " ist ein passendes Eis zu diesem Rezept.\n");
  }
  else if(ob->QueryMaterialGroup(MATGROUP_METAL) == 100 && 
          sizeof(ob->QueryProp(P_MATERIAL)) == 1 &&
          CheckMetal(ob)) 
  {
    write(MATERIALDB->MaterialName(m_indices(ob->QueryProp(P_MATERIAL))[0], WER) +
        " ist ein passendes Metall zu diesem Rezept.\n");
  }
  else
  {
    write(ob->Name(WER,1) + " pass" + (ob->IsPlural() ? "en" : "t") +
        " nicht in dieses Rezept.\n");
    return 1;
  }

  write("Ein Teil Deiner Magie fliesst in das Rezept mit ein.\n");
  TP->AddSp(-mp);
  call_out("CheckAll", 0);
  return ::PreventInsert(ob); 
}

varargs int PreventLeave(object ob, mixed dest)
{
  write("Du kannst nichts mehr aus diesem Rezept entfernen!\n");
  return 1;
}

