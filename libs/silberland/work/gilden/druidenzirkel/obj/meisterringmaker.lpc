// Meisterringmaker, container fuer die Ringquest der Druiden
// 10.1.2004 Feyaria@SilberLand
// 14.1.2004 Feyaria - 6 edelsteine und perlen, metall besser ausgeben
 
inherit "/std/container";

#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>

string* gems = ({});
string* pearls = ({});
string* metals = ({});
string* ices = ({});
string* fruits = ({});
string* rings = ({});

string* all_fruits;
string* all_gems;
string* all_pearls;
string* all_ice;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Das Rezept fuer den Ring");
  SetProp(P_LONG, 
      "Dieses seltsame Rezept sieht eigentlich eher aus wie ein ganz normaler "
      "Lederbeutel, allerdings ist das Leder ueber und ueber mit seltsamen "
      "magischen Schriftzeichen bedeckt.");
      
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Rezept");
  AddId( ({"rezept",  "\nmeisterring_rezept"}) );

  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAX_WEIGHT, 50000);
  SetProp(P_WEIGHT_PERCENT, 25);
  SetProp(P_MATERIAL, ([MAT_LEATHER:50, MAT_MISC_MAGIC:50]) );

  AddDetail( ({"leder", "lederbeutel", "schriftzeichen"}),
      "Wirklich seltsame Schriftzeichen, die sich da auf dem Leder befinden.");

  all_fruits = ({"Apfel", "Birne", "Erdbeere", "Himbeere", "Marille", "Ribisel",
      "Stachelbeere", "Zwetschke", "Zwergananas", "Passionsfrucht", "Mango",
      "Mandastromo", "Banane", "Papaya", "Heidelbeere"});

  all_ice = ({"Twinni", "Calippo", "Paiper", "Solero", "Jolly", "Nogger", "Tschisi"});

  all_gems = ({"saphir", "granat", "topas", "smaragd", "rubin", "aquamarin"});

  all_pearls = ({"polarperle", "tijaraperle", "quaulperle", "tiefseeperle",
      "midasperle", "felseninselperle"});

  SUID;
}

void CheckAll()
{
  object ob, next;
  string logstr;

  if( sizeof(gems) == 6 && sizeof(pearls) == 6 && sizeof(metals) == 6 &&
      sizeof(rings) == 6 && sizeof(fruits) == 6 && sizeof(ices) == 6)
  {
    write(BS("Alle 36 Teile verbinden sich und ploetzlich hast Du einen "
          "kleinen Ring im Inventar."));
    clone_object("/gilden/druidenzirkel/armour/meisterring")->move(TP, M_NOCHECK);
    logstr = "erzeugt einen Meisterring";
    for(ob = first_inventory(TO); ob;) 
    {
      logstr += ".\n    " + ob->Name() + " (" + ob->QueryProp(P_CLONER) + ")";
      next = next_inventory(ob);
      ob->remove();
      if(ob) destruct(ob);
      ob = next;
    }
    WLOG("/gilden/druidenzirkel/log/meisterring", logstr);
    remove();
    if(TO) destruct(TO);
  }
}

int CheckRing(object ring)
{
  string name;
  
  if(sizeof(rings) == 6)
  {
    write("Du hast schon genug Ringe fuer dieses Rezept.\n");
    return 0;
  }
  name = ring->QueryProp(P_NAME);
  if(member(rings, name) == -1)
  {
    rings += ({name});
    return 1;
  }
  else
  {
    write("Du brauchst keine zwei gleichen Ringe fuer dieses Rezept.\n");
    return 0;
  }
}

int CheckGem(object gem)
{
  string name;

  if(sizeof(gems) == 6)
  {
    write("Du hast schon genug Edelsteine fuer dieses Rezept.\n");
    return 0;
  }
  name = gem->QueryProp(P_NAME);
  if(member(gems, name) == -1)
  {
    if(gem->QueryProp(P_REQUESTED_AMOUNT) == 6)
    {
      gems += ({name});
      return 1;
    }
    else
    {
      write("Du brauchst 6 davon!\n");
      return 0;
    }
  }
  else
  {
    write("Du brauchst keine zwei gleichen Edelsteine fuer dieses Rezept.\n");
    return 0;
  }
}

int CheckPearl(object pearl)
{
  string name;

  if(sizeof(pearls) == 6)
  {
    write("Du hast schon genug Perlen fuer dieses Rezept.\n");
    return 0;
  }
  name = pearl->QueryProp(P_NAME);
  if(member(pearls, name) == -1)
  {
    if(pearl->QueryProp(P_REQUESTED_AMOUNT) == 6)
    {
      pearls += ({name});
      return 1;
    }
    else
    {
      write("Du brauchst 6 davon!\n");
      return 0;
    }
  }
  else
  {
    write("Du brauchst keine zwei gleichen Perlen fuer dieses Rezept.\n");
    return 0;
  }
}

