inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../druiden.h"

string ele;
object caster;
string caster_name;
int duration;

create() {
  if(!is_clone(TO)) return;
  duration=1;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({ DRUIDEN_SPELL_ENHANCE }));
}

int Setup(string element, object caster) {
  ele=element;
  caster_name=getuid(caster);
  AddId( ({ "\n"+element+"_enhance" }) );
  return 1;
}

string GetElement() {
  return ele;
}

void reset() {  
  ::reset();
  duration--;
  if(duration < 1) 
    remove();
  return ;
}

int remove() {
  if(ENV(ME) && interactive(ENV(ME))) {
    tell_object(ENV(ME), BS("Deine elementare Verstaerkung erlischt!\n"));
  }
  ::remove();
}

