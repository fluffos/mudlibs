// Stein
// 
// 1997-08-03  Angrox@SilberLand

#include "/gilden/druidenzirkel/druiden.h"

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Stein");
  SetProp(P_LONG, BS( 
    "Dieser kleine Stein kann Dich von der Abenteuerergilde in den "
   +"Druidenzirkel bringen. Das Kommando dazu lautet \"dzirkel\"."));
  SetProp(P_NAME, "Stein");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stein"}) );
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 10); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  AddCmd("dzirkel", "Druiden");
}

Druiden(string str)
{
 notify_fail("Das geht nur von der Abenteuerergilde aus.\n");
 if(ENV(TP)->QueryProp(P_INT_SHORT)!="Die beruehmte Abenteurergilde")
   return 0;
 TP->move("/gilden/druidenzirkel", M_TPORT);
 return 1;
}
