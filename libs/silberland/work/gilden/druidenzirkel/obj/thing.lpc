inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() 
{
  if(!is_clone(this_object())) return;
  ::create();
}

reset() 
{
  if(!is_clone(this_object())) return;
  ::reset();
  if(environment(this_object()) && 
      strstr(file_name(environment(this_object())), 
        "/gilden/druidenzirkel/obj/meisterringmasker") != -1  )
    return ;
  this_object()->remove(); 
}
