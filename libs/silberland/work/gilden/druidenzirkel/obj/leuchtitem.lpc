#include <properties.h>
#include <language.h>


inherit "/std/thing";

object wusel;

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, 0);  // Das Zeug ist unsichtbar, klar.
  SetProp(P_LONG, 0);
  AddId( ({ "LEUCHTITEM" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS,1);

  wusel = 0;
}

void SetWusel(object ob)
{
  if(wusel == 0) wusel = ob;
}

object QueryWusel()
{
  return wusel;
}

void reset()
{
  ::reset();

  if(!objectp(wusel)) call_out("remove", 0, 1);
}


