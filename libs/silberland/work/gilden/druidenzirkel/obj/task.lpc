

inherit "std/thing";

#include "/gilden/druidenzirkel/druiden.h"
#include <properties.h>
#include <language.h>

object spieler;
int nummer=0;

create()
{
  if (!is_clone(TO) )  return;

  ::create();
  SUID;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
 
  SetProp(P_GENDER, NEUTER);
  AddId(TASKITEM);
  //SetProp(P_NAME, "task");
  
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(ELEMENT_SECURE, 0);
  SetProp(E_TIME, 0);
}

reset()
{
  ::reset();
  if(!objectp(ENV(ME)) || 
      !query_once_interactive(ENV(ME)) || 
      ENV(ME)->QueryProp(P_GUILD)!="druidenzirkel")
    ME->remove();
}

// Hier wird das Mapping wieder in die Properties eingetragen
void _set_autoloadobj(mixed data)
{
  if(mappingp(data) && sizeof(data)==2) {
    SetProp(ELEMENT_SECURE, data[ELEMENT_SECURE]);
    SetProp(E_TIME, data[E_TIME]);
  }
  return;
}

// Und hier wird gespeichert
mapping _query_autoloadobj()
{
  return ([E_TIME: QueryProp(E_TIME), ELEMENT_SECURE: QueryProp(ELEMENT_SECURE)]); 
}

