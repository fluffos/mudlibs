inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../druiden.h"
#include "../mysteries.h"

void create()
{
  if(!is_clone(TO))
    return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({ DRUIDEN_RESIST_MOD }));
}

int SetVariables(object player, string element, object victim, int succ) 
{
  mapping resist;
  float value;
  int time;

  value = 0.1 + succ / (10.0 * MAX_ABILITY); // 0.1 bis 0.3
  time = 4 + 4 * succ / MAX_ABILITY; // 4 bis 12 sec

  if(victim->QueryProp(P_TMP_DRUID_RESISTANCE_PROCC)) {
    time *= 2;
  }

  switch(element)
  {
    case FEUER:
      resist = ([DT_FIRE:-2*value, DT_COLD:value, DT_WATER:value]);
      break;
    case WASSER:
      resist = ([DT_WATER:-2*value, DT_FIRE:value, DT_LIGHTNING:value]);
      break;
    case EIS:
      resist = ([DT_COLD:-2*value, DT_FIRE:value, DT_POISON:value]);
      break;
    case LUFT:
      resist = ([DT_AIR:-2*value, DT_MAGIC:value]);
      break;
    case ERZ:
      resist = ([DT_MAGIC:-2*value, DT_AIR:value]);
      break;
  }
  victim->AddResistanceModifier( resist, DRUIDEN_RESIST_MOD );
  call_out("remove_me", time, player, element, victim);
  return 1;
}

int remove_me(object player, string element, object victim)
{
  if(objectp(victim))
  {  
    victim->RemoveResistanceModifier();
    if (player && environment(victim) && present(player, environment(victim)))
      tell_object(player, victim->Name(WER,1) + " erholt sich von Deinem "+
          capitalize(element) + "pfeil.\n");
  }
  remove();
}

void init()
{
  ::init();
  if (environment() && !living(environment()))
    call_out("remove", 0);
}

