inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../druiden.h"

void create() {
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC,0);
  SetProp(P_INVIS,1);
  AddId(({ "\ntempschutz"}));
  if(getuid(previous_object())!="GUILD.druidenzirkel") {
   call_out("remove", 1);
   return 0;
  }
}

int SetVariables(mixed val, int time) {
  if(getuid(previous_object())!="GUILD.druidenzirkel") {
   call_out("remove", 1);
   return 0;
  }
  SetProp(P_TEMPERATURE_PROTECTION, val);
//  call_out("remove", random(300)+300);  // wieso wird da time extra uebergeben und dann nicht verwendet?
  call_out("remove", time); 
  return 1;
}

void remove() {
  if (is_clone(this_object()) && MENV && QueryProp(P_WORN)) 
  {
    DoUnwear(1);
    tell_object(MENV, "Dein elementarer Temperaturschutz erlischt!\n");
  }
  while(remove_call_out("remove")!=-1);
  ::remove();
}

void init() {
  ::init();
  if(!living(ENV(ME)))
    call_out("remove", 0);
}

void reset() {
  ::reset();
  if (!is_clone(this_object())) return;
  if (find_call_out("remove") == -1)
    call_out("remove", 0);
}

void BecomesNetDead(object wer) {
  if(wer==MENV)
    remove();
}
