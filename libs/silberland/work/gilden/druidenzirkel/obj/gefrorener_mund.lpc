inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\neiselementar_gef_mund"}));
}

init() {
  ::init();
  if(interactive(ENV(ME)))
    ENV(ME)->SetProp(P_PERM_STRING, this_object());
}


string permutate_string (string str) {
 int words;
 string sent;
 int i;
 sent="";
 words=sizeof(explode(str, " "));
 if(words > 30) words=25+random(10);
 for (i=words; i>=0; i--) {
   sent+="Mmmmm";
   if(!random(3)) sent+=" ";
 }
 sent+="!";
 return sent;
}

int start_remove(int time) {
  call_out("remove", time);
  return 1;
}

int auftauen() {
  if(ENV(ME) && living(ENV(ME))) 
    tell_object(ENV(ME), "Dein Mund taut wieder auf!\n");
  remove();
}

