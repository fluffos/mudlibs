inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include "/gilden/druidenzirkel/druiden.h"

private int power;
private object caster;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine gruenlich glitzernde Sporenwolke huellt alles ein");
  SetProp(P_LONG,
    "Diese gruen glitzernde Wolke aus feinen Sporen und Pollen huellt alles hier ein. "
    "Sie besteht aus der reinen Energie des elementaren Humus.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Die Sporenwolke ist eine elementare Manifestation des Humus und "
                  "wurde von einem Druiden beschworen.");
  SetProp(P_NAME, "Sporenwolke");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wolke", "sporenwolke", "\ndruid_spore_cloud", DRUID_ID_ELEMENTAL_BOOST(HUMUS)}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_PLANT);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, 1);
}

public string elemental_room() {
  return HUMUS;
}

public int _query_druid_elemental_boost_bonus() {
  return power;
}

public void Start(int _power, object _caster) {
  power = _power;
  caster = _caster;
  ENV(TO)->Set(P_ELEMENTAL_ROOM, symbol_function("elemental_room", TO), F_QUERY_METHOD);
  call_out("do_heal", 6);
  call_out("end", 30);
}

public int isValidTarget(object o) {
  return !caster->IsEnemy(o) && living(o);
}

public void do_heal() {
  object *targets, t;

  targets = filter_array(all_inventory(ENV(TO)), "isValidTarget");
  if(sizeof(targets) > 0) {
    t = targets[random(sizeof(targets))];
    if(!objectp(t)) return;

    tell_object(t, BS("Du atmest Sporen ein und fuehlst dich erfrischt."));
    tell_room(ENV(t), BS(t->Name(WER, 1) + " atmet Sporen ein und sieht erfrischt aus."), ({t}));
    t->AddHp(power/3);
  }

  call_out("do_heal", 6);
  return;
}

public void AddStrength(int _power) {
  power += _power;
  if(power > 66) power = 66;
  while(find_call_out("end") != -1) remove_call_out("end");
  call_out("end", 30);
}

public void end() {
  tell_room(environment(TO), BS("Die Sporenwolke sinkt zu Boden und loest sich auf."));
  remove(1);
}
