// Elementarsphaere
// Angrox@SL, 03.03.2006
//
// Customizing: init_sphere(string element, string adjective);

inherit "std/thing";

#include "/gilden/druidenzirkel/druiden.h"


#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>


private nosave int is_autoload;
private nosave int autoload_time=5;
private nosave string element;
private nosave string name_adj;
private nosave int is_set=0;

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine undefinierbare Elementarsphaere");
  SetProp(P_LONG, 
    "Seltsam. Diese Elementarsphaere scheint keinem Element zugeordnet zu "
    "sein.");
  SetProp(P_NAME, "Elementarsphaere");  
  SetProp(P_NAME_ADJ, "undefinierbar");  
  SetProp(P_GENDER, FEMALE); 
  AddId("elementarsphaere");
  AddId("sphaere");
  SetProp(P_MATERIAL, ([MAT_PERGAMENT:90, MAT_INK:5])); 
  SetProp(P_WEIGHT, 200); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_AUTOLOADOBJ, 0);
  SetProp(P_NOBUY, 1);
  SUID;
  is_autoload==-1;
} 

void init() {
  return ::init();
}

void reset() {
  return ::reset();
}

varargs int init_sphere(string choosen_element, string adjective) {
  string *adjs;
  if(is_set) return 0;
  adjs=({"perfekt", "unfoermig", "unregelmaessig", "zerstoert"});
  if(!stringp(adjective)) 
    adjective=adjs[random(sizeof(adjs))];
  name_adj=adjective;
  element=choosen_element;
  SetProp(P_NAME_ADJ, adjective);
  SetProp(P_SHORT, "Eine "+adjective+"e "+CAP(element)+"elementarsphaere");
  SetProp(P_NAME, CAP(element)+"elementarsphaere");
  AddId(lower_case(element)+"elementarsphaere");
  if(adjective == "perfekt") {
    AddId(ELEMENTAL_SPHERE+"_"+element);
    SetProp(P_LONG, "Eine perfekt geformte Kugel aus dem Element "+
        CAP(element)+". "
        "Du spuerst eine Aura der Maechtigkeit um sie herum.");
    is_autoload=1;
    SetProp(P_NODROP, "Du moechtest die Sphaere nicht hergeben!\n");
  }
  else {
    AddId(lower_case(element)+"elementarsphaere");
    SetProp(P_SHORT, "Eine "+adjective+"e "+CAP(element)+"elementarsphaere");
    SetProp(P_LONG, "Eine "+adjective+"e Kugel aus dem Element "+
        CAP(element)+". Sie scheint "
        "sehr unregelmaessig und nicht perfekt geformt zu sein. "
        "Fuer was sie wohl einst gut war ?");
    is_autoload=-1;
    SetProp(P_NODROP, 0);
  }
  is_set=1;
  return 1;
}



// Und hier wird gespeichert
mixed _query_autoloadobj()
{
  if(is_autoload==-1) return 0;
  return (["adjective": name_adj, 
           "autoload_time": autoload_time,
           "element": element,
           ]);
}

// Eventuelles Autoload
void _set_autoloadobj(mixed data)
{
  if(is_autoload==-1) return 0;
  if(mappingp(data)) {
    name_adj=data["adjective"];
    autoload_time=data["autoload_time"];
    element=data["element"];
  }
  if(stringp(name_adj)) {
    if(autoload_time < 0) {
      call_out("init_sphere", 0, element,"zerstoert");
    }
    else {
      call_out("init_sphere", 0, element,name_adj);
      autoload_time-=1;
    }
  }
  //else {
  //  call_out("remove", 0);
  //}
  return;
}
