inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>


private int count=0;
private int started=0;
create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"HUMUS_AURA_OBJ_ID"}));
}


int start_heal() {
  if(started) return 0;
  started=1;
  call_out("do_heal",6);
  return 1;
}

nosave int do_heal() {
  object *liv;
  int i;
  liv=filter_array(all_inventory(ENV(ME)), #'living);
  for (i=sizeof(liv)-1; i>=0; i--) {
    tell_object(liv[i], "Du fuehlst Dich gestaerkt!\n");
    liv[i]->AddHp(3+random(9));
    liv[i]->AddSp(-1+random(2));
  }
  count++;
  if(count>10) {
    tell_room(ENV(ME), BS("Die Umgebung normalisiert sich wieder. Die "
          "Kraft des Humus' scheint nun wieder normal zu sein."));
    ME->remove();
    return 1;
  }
  call_out("do_heal", 6);
}
