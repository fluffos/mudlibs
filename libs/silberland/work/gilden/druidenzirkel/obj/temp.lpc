inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../druiden.h"

nosave mapping value;
nosave mapping old_val;
nosave object env;
create() {
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NOGET, 1);
  AddId(({ "\ntemp"}));
  if(getuid(previous_object())!="GUILD.druidenzirkel") {
   call_out("remove", 1);
   return 0;
  }
}

int SetVariables(mapping val, mapping val2) {
  env=MENV;
  if(getuid(previous_object())!="GUILD.druidenzirkel") {
   call_out("remove", 1);
   return 0;
  }
  value=val;
  old_val=val2;
  if(!env->Query(P_ENVIRONMENT, F_QUERY_METHOD)) { 
    env->SetProp(P_ENVIRONMENT, value); 
  }
  return 1;
}

mixed QueryVariables() {
  return ({value, old_val});
}


remove() {
  if(env) 
    env->SetProp(P_ENVIRONMENT, old_val); 
  while(remove_call_out("remove")!=-1);
  ::remove();
}



init() {
  ::init();
  if(living(ENV(ME)))
    call_out("remove", 0);
}

reset() {
  ::reset();
  if (!is_clone(this_object())) return;
  call_out("remove", 0);
}

