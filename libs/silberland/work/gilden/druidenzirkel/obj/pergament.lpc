// Ein Pergament fuer den Druidenzirkel
// Sat Aug 16 14:41:11 CEST 1997
//

inherit "std/thing";

#include "/gilden/druidenzirkel/druiden.h"


#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Pergament");
  SetProp(P_LONG, BS( 
    "Auf diesem Pergament sind die Funktionen des Druidenzirkels erklaert. "
    +"Du kannst es lesen.\n")); 
  SetProp(P_NAME, "Pergament");  
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"pergament"}) ); 
  SetProp(P_MATERIAL, ([MAT_PERGAMENT:90, MAT_INK:5])); 
  SetProp(P_WEIGHT, 10); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_AUTOLOADOBJ, 0);
  SetProp(P_NOBUY, 1);
  AddReadDetail("pergament", "@@text@@");
  SUID;
} 

string text()
{
 TP->More(read_file(OBJ("pergament_text")));
 return "";
}
