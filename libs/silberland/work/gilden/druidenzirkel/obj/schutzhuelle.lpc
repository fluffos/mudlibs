
// Schutzhuelle der Druiden
// Angrox@SL, 06.11.2000
// Changes:
// 
//  

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../druiden.h"
#include <wizlevels.h>

int last_time;
string element;

void create() {
  if( !is_clone(TO) ) return;
  ::create();

  last_time=0;

  AddId (({SCHUTZHUELLE}));
  SetProp (P_SHORT, 0);
  SetProp (P_INVIS, 1);
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MAGIC, 1);
  SetProp (P_ARMOUR_TYPE, AT_MISC );
  SetProp (P_AC, 0);
  SetProp (P_MATERIAL, MAT_MAGIC  );
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_DEFEND_FUNC, TO );

  if(getuid(previous_object())!="GUILD.druidenzirkel" && 
     !IS_ARCH(getuid(previous_object()))) {
   call_out("remove", 1);
  }
}

int DefendFunc(mixed dam_type, mixed spell, object enemy) {
  object owner;
  string ele_dam;

  if(!owner=ENV(ME)) return 0;
  if(element==FEUER) {
    ele_dam=DT_FIRE;
  }
  else if(element==EIS) {
    ele_dam=DT_COLD;
  }
  if(member(dam_type, ele_dam)!=-1) {
    tell_object(owner, BS("Deine Schutzhuelle flackert kurz auf!"));
    tell_room(ENV(owner), BS(sprintf("%s Schutzhuelle flackert kurz "
            "auf!", owner->Name(WESSEN,1))), ({ owner }));
    return 10 + random(owner->QueryProp(P_GUILD_LEVEL)*5);
  }
  return 0;
}

string extra_look() {
  object player;
  string color;
  player=ENV(ME);
  if(element == FEUER) color="roetlichen";
  else if(element == EIS) color="blaeulichen";
  if(player->QueryProp(P_GENDER)==FEMALE)
    return "Sie ist von einer "+color+" Schutzhuelle umgeben.\n";
          
  else 
    return "Er ist von einer "+color+" Schutzhuelle umgeben.";
           
}


void remove_me() {
  object player, room;

  if (IS_CLONE(ME))
  {
    if(player=ENV(ME)) 
      tell_object(player, "Deine Schutzhuelle faellt zusammen.\n");
    if(room=ENV(player))
      tell_room(room, sprintf("%s Schutzhuelle faellt zusammen.\n", player->Name(WESSEN)),
          ({player}));
  }
  remove();
}

int set_element(string ele, int dur) {
  element=ele;
  if (element == FEUER) 
    SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT: 3, T_COLD_PROT: 0]) );
  else if (element == EIS) 
    SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT: 0, T_COLD_PROT: 3]) );
  set_next_reset(dur);
}



void reset() {
  ::reset();
  if (!is_clone(this_object())) return;
  call_out("remove_me", 1);
}

varargs int DoWear(int silent, int all) {
  int ret;
  if (all) return 0;
  ret=::DoWear(1,all); // silent
  return ret;
}

varargs int DoUnwear(int silent, int all) {
  int ret;
  if (all) return 0;
  ret = ::DoUnwear(1); // silent
  return ret;
}
