
inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../druiden.h"

int allow_setup=1;
create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("\nfeuerelementar_enthaare");
  SetProp (P_SHORT, 0);
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_MISC);
  call_out("weg", 40);
}

string extra_look()
{
   if(previous_object() && previous_object(2) && previous_object(2)==ENV(ME))
     return BS("Du hast keine Haare mehr !!! OH GOTT SIEHT DAS SCHRECKLICH "
         "AUS!");
   if (environment()->QueryProp(P_GENDER)==2)
      return BS("Sie hat ueberhaupt keine Koerperbehaarung. Keine Kopfhaare, "
          "keine Augenbrauen - nichts! Du fragst Dich ob sie am ganzen "
          "Koerper keine Haare mehr hat. :) ");
   else
      return BS("Er hat ueberhaupt keine Koerperbehaarung. Keine Kopfhaare, "
          "keine Augenbrauen - nichts! Du fragst Dich ob er am ganzen "
          "Koerper keine Haare mehr hat. :) ");
  
}

void weg(int zeit) {
  //call_out("remove", zeit); 
  return;
}
 
void reset() {
  ::reset();
  if (!is_clone(this_object())) return;
  call_out("remove",0);
}

void remove() {
  object pl,ob;
  if(objectp(pl=ENV(ME)) && objectp(ob=ENV(ENV(ME))) && 
      interactive(ENV(ME))) 
  {
    tell_room(ob, BS(sprintf("%s ist nun wieder behaart. Ihhh.", 
            pl->Name(WER))), ({pl}));
    if (pl->id("Hobbitspieler"))
      tell_object(pl, "Du fuehlst, dass Deine Haare wieder nachgewachsen sind.\n");
    else
      tell_object(pl, "Du bist nun wieder behaart.\n");
    if(pl->Query(P_HAIR_COLOR, F_QUERY_METHOD))
      pl->Set(P_HAIR_COLOR, 0, F_QUERY_METHOD);
  }
  ::remove();
}

int Setup(object pl) {
  write ("1\n");
  if(!allow_setup) return 0; 
  write ("2\n");
  if(!pl->QueryProp(P_HAIR_COLOR))
     return 0;
  write ("3\n");
  if(pl->Query(P_HAIR_COLOR, F_QUERY_METHOD)) return 0;
  write ("4\n");
  allow_setup=0;
  pl->Set(P_HAIR_COLOR, symbol_function("nohair", TO), F_QUERY_METHOD);
  return 1;
}

string nohair() {
  return "keine";
}
