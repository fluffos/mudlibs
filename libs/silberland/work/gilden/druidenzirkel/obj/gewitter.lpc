inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include "/gilden/druidenzirkel/druiden.h"
#include <new_skills.h>
#include  "/gilden/druidenzirkel/mysteries.h"
#include <wizlevels.h>

private int power;
private object caster;
private mapping originalEnv;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_LONG,
    "Wirbelnde und flackernde Luft zischt um dich herum.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Dieser Wind ist eine reine Manifestation des Elements Luft. "
                  "Er wurde einem Druiden erschaffen.");
  SetProp(P_NAME, "Wind");
  SetProp(P_GENDER, MALE);
  AddId(({"wind", "brise", "sturm", "windhose", ID_WEATHERMASTERY}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WATER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, 1);
}

public string _query_short() {
  switch(power) {
    case 0..5: return "Eine leichte Brise weht hier"; break;
    case 6..15: return "Eine steife Brise weht dir um die Ohren"; break;
    case 16..20: return "Bestaendiger Wind braut sich hier zusammen"; break;
    case 21..25: return "Ein starker Wind zischt an dirP vorbei"; break;
    case 26..30: return "Eine kleine Windhose wirbelt hier herum"; break;
    default: return "Ein regelrechter Wirbelsturm tobt hier"; break;
  }
}

public string elemental_room() {
  return LUFT;
}

public void Start(int _power, object _caster) {
  power = _power;
  caster = _caster;
  ENV(TO)->Set(P_ELEMENTAL_ROOM, symbol_function("elemental_room", TO), F_QUERY_METHOD);
  call_out("end", 30);
}

public int isValidTarget(object o) {
  return caster->IsEnemy(o) && living(o);
}

public void AddStrength(int _power) {
  int op;
  op = power;
  power += _power;
  if(power > 33) power = 33;
  while(find_call_out("end") != -1) remove_call_out("end");
  call_out("end", 30);
  if(op != power) tell_room(ENV(TO), BS("Der Wind wird staerker."));
}

public void end() {
  tell_room(environment(TO), BS("Der Wind legt sich."));
  remove(1);
}

public void lightningStike(object victim) {
  if(random(50) > power) return;
  tell_room(ENV(victim), BS(sprintf("Statische Elektrizitaet loest sich in einem Blitz, der %s trifft.", victim->name(WEN,1))));
  victim->Defend(100 + 2*random(power), ({DT_LIGHTNING, DT_ELECTRIC}), ([SP_NAME: "Wettermeisterschaft", SP_SHOW_DAMAGE: 1]), caster);
  return;
}
