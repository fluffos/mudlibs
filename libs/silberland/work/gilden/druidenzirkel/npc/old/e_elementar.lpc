//
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden.h"
int fehler;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein Erzelementar");
  SetProp(P_NAME, "Erzelementar");
  SetProp(P_GENDER, NEUTER);
  AddId(({"elementar", "erzelementar"}));
  create_default_npc(1);
// P_LEVEL   = x                            =
// P_SP/P_HP = [(10+x*x)*(95+rnd(10))]/100  =
// P_HANDS   = x*10                         =
// bei x>30  = 300+5*(x-30)                 =
// P_BODY    = x*4                          =  
// P_XP      = HP*HANDS*5                   =   
                          // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({"mit erzenen Faeusten",100,DT_BLUDGEON}));
  SetProp(P_RACE, "Elementar");
  SetProp(P_XP, 0);
   SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
 // Verwundbarkeiten und Resistenzen
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.9,     DT_BLUDGEON   :-0.9,     DT_PIERCE     :-0.9,
    DT_SQUEEZE    :-0.9,     DT_WHIP       :-0.9,     DT_RIP        :-0.9,
    DT_FIRE       :0,        DT_COLD       :0,        DT_WATER      :0,    
    DT_AIR        :2,        DT_LIGHTNING  :0,        DT_EXPLOSION  :0, 
    DT_SOUND      :0,        DT_LIGHT      :0,        DT_ELECTRIC   :0,    
    DT_ACID       :-1,       DT_POISON     :0,        DT_TERROR     :-1,     
    DT_HOLY       :-1,       DT_UNHOLY     :-1,       DT_MAGIC      :0]) );
 
 
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "waechst aus dem Boden");
  SetProp(P_MMSGIN, "waechst aus dem Boden");
  SetProp(P_MMSGOUT, "verschwindet im Boden"); 
  SetProp(P_DIE_MSG,  " zerbroeckelt.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:50, MAT_MISC_STONE:50]));
  SetProp(P_KILL_NAME, "Ein Erzelementar");
  SetProp(P_KILL_MSG, "Mein Meister wollte Deinen Tod, %s!");
  AddInfo(DEFAULT_INFO, "reagiert nicht auf Dich.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Erzelementar ignoriert Dich.\n" }) );
  SetProp(ELEMENT_DEFENDS, 1);
}


init()
{
object ob;
::init();

ob=find_living(lower_case(QueryProp(ELEMENT_CASTER)));
if(!ob)
  {
    say(BS("Das Erzelementar verschwindet im Boden.\n"));
    ME->remove();
    return ;
  }
if(ob && ob->QueryProp(P_GHOST))
  {
    say(BS("Das Erzelementar verschwindet im Boden.\n"));
    ME->remove();
  }
if(objectp(ob) && present(getuid(ob))) 
          ob->AddDefender(TO);
  
}


reset()
{
  ::reset();
  say(BS("Das Erzelementar verschwindet im Boden.\n"));
  ME->remove();
}


/*
InformDefend(object enemy)
{
  ::InformDefend();
 ME->Kill(enemy);
}
*/


set_fehler()
{
 fehler=1;
}

DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{
 mixed res;
 int i;
 object caster;

 if(fehler)
   {
    res=({dam, dam_type, spell, enemy});
    return res;
   }  
 i=random(3);
 if(!caster)
   {
    caster=find_living(lower_case(QueryProp(ELEMENT_CASTER)));
   }
 if(!i)
   { 
     if(member_array(dam_type, m_indices(PHYSICAL_DAMAGE_TYPES))!=-1 && 
        sizeof(dam_type)!=-1)
       {
         say(sprintf(BS("Das Erzelement wehrt eine Attacke "
             +"fast ganz fuer %s ab!\n"),QueryProp(ELEMENT_CASTER)),caster);
         tell_object(caster, BS("Das Erzelementar wehrt eine Attacke "
            "fast ganz fuer Dich ab!\n"));
         dam=dam*0.2;
       } 
     else
       {
         tell_object(caster, "Das Erzelement schwaecht die Attacke ab!\n");
         say(sprintf(BS("Das Erzelementar schwaecht eine "
           +"Attacke fuer %s ab."), QueryProp(ELEMENT_CASTER)), caster);
         dam=dam*0.5;
	}
     SetProp(ELEMENT_DEFENDS, QueryProp(ELEMENT_DEFENDS)-1); 
   }

 if(QueryProp(ELEMENT_DEFENDS)<1)
   {
    say("Das Erzelementar loest sich nach dieser parierten Attacke auf!\n");
    ME->remove();
   }
 res=({dam, dam_type, spell, enemy});
 return res;
}
