/* 
// /gilden/druidenzirkel/npcs/f_elementar.c   
//
// Luftelementar der Druidengilde
// 26-06-1997
// Angrox@Silberland
//
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden.h"
int fehler=0;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein Luftelementar");
  SetProp(P_NAME, "Luftelementar");
  SetProp(P_GENDER, NEUTER);
  AddId(({"elementar", "Luftelementar"}));
  create_default_npc(1);
// P_LEVEL   = x                            =
// P_SP/P_HP = [(10+x*x)*(95+rnd(10))]/100  =
// P_HANDS   = x*10                         =
// bei x>30  = 300+5*(x-30)                 =
// P_BODY    = x*4                          =  
// P_XP      = HP*HANDS*5                   =   
                          // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({"mit einem Windstoss",100,DT_AIR}));
  SetProp(P_RACE, "Elementar");
  SetProp(P_XP, 0);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :2,        DT_BLUDGEON   :2,        DT_PIERCE     :2,
    DT_SQUEEZE    :2,        DT_WHIP       :2,        DT_RIP        :2,
    DT_FIRE       :0,        DT_COLD       :0,        DT_WATER      :0,    
    DT_AIR        :-1,       DT_LIGHTNING  :0,        DT_EXPLOSION  :0, 
    DT_SOUND      :0,        DT_LIGHT      :0,        DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON     :0,       DT_TERROR     :0,     
    DT_HOLY       :-1,       DT_UNHOLY     :-1,        DT_MAGIC      :0]) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MATERIAL, MAT_AIR);
  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MMSGIN, "manifestiert sich");
  SetProp(P_MMSGOUT, "loest sich auf");
  SetProp(P_DIE_MSG,  " verdampft.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Luftelementar");
  SetProp(P_KILL_MSG, "Mein Meister wollte Deinen Tod, %s!");

  AddInfo(DEFAULT_INFO, "reagiert nicht auf Dich.\n");
 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Luftelementar ignoriert Dich.\n" }) );

  SetProp(ELEMENT_DEFENDS, 1);
}

reset()
{
  ::reset();
  say(BS("Das Luftelementar loest sich in einen kleinen Sturm auf.\n"));
  ME->remove();
}

init()
{
 object ob;
 ::init();
 if(!QueryProp(ELEMENT_CASTER)) return;
 ob=find_living(lower_case(QueryProp(ELEMENT_CASTER)));
 if(!ob || QueryProp(ELEMENT_DEFENDS)<1)
  {
    say(BS("Das Luftelementar loest sich in einen kleinen Sturm auf.\n"));
    ME->remove();
    return;
  }
 if(ob && ob->QueryProp(P_GHOST))
  {
    say(BS("Das Luftelementar loest sich in einen kleinen Sturm auf.\n"));
    ME->remove();
  }
if(objectp(ob) && present(getuid(ob))) 
          ob->AddDefender(TO);
  
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if(player==find_living(lower_case(QueryProp(ELEMENT_CASTER))));  
   {
     say(BS("Das Luftelementar loest sich in einem kleinen Sturm auf.\n"));
     ME->remove();
   }
}



set_fehler()
{
 fehler=1;
}


DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{
 mixed res;
 int i;
 object caster; 

 if(fehler)
   {
    res=({dam, dam_type, spell, enemy});
    return res;
   }
 if(!caster)
   {
    caster=find_living(lower_case(QueryProp(ELEMENT_CASTER)));
   }
 i=random(3); 
 if(!i)
   {    
     if(member(dam_type,DT_AIR)!=-1)
       {
         say(sprintf("Das Luftelement wehrt eine Attacke "
             +"fuer %s fast ganz ab!\n",QueryProp(ELEMENT_CASTER)), caster);
         tell_object(caster, BS("Das Luftelementar wehrt eine Attacke "
            "fast ganz fuer Dich ab!\n"));
         dam=dam*0.2;
       } 
     else
       {
         write("Das Luftelement schwaecht die Attacke ab!\n");
         say(BS("Das Luftelementar schwaecht eine Attacke fuer "
            +QueryProp(ELEMENT_CASTER)+ " ab!"));
         dam=dam*0.55555;
       }
     SetProp(ELEMENT_DEFENDS, QueryProp(ELEMENT_DEFENDS)-1);
   }

 if(QueryProp(ELEMENT_DEFENDS)<1)
   {
    write("Das Luftelement loest sich nach dieser parierten Attacke "
          +"auf!\n");
    say("Das Luftelementar loest sich auf!\n");
    ME->remove();
   }
 res=({dam, dam_type, spell, enemy});
 return res;
}
