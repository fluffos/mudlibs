// /d/<region>/<magiername>/<gebiet>/npc/standard_npc.c   
// Ein Standard File fuer NPCs
// 27-10-1996  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Feuerwusel");
  SetProp(P_LONG, BS(
    "Der Feuerwusel ist eine handgrosse Feuerkugel, die Dir Licht spendet.\n"));
  SetProp(P_NAME, "Feuerwusel");
  SetProp(P_GENDER, MALE);
  AddId(({"wusel", "feuerwusel"}));
  set_living_name("feuerwusel");

  create_default_npc(1);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({"mit Flammen",40, DT_FIRE}));
  SetProp(P_MAX_HP, 100);
  SetProp(P_BODY, 100);
  SetProp(P_XP, QueryProp(P_XP)); // Bonus fuer Spells
  SetProp(P_RACE, "Elementar");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "weicht geschickt aus.");
  SetProp(P_FRIEND,1);
  SetProp(P_LIGHT, 1);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt");
  SetProp(P_MMSGIN, "erscheint urploetzlich");
  SetProp(P_MMSGOUT, "loest sich auf");
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Feuerwusel will Deine Sachen nicht tragen.\n" }) );
}

init() {
  ::init();
  if(ENV(ME) && (ENV(ME)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]==TT_UNDERWATER ||
      ENV(ME)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]==TT_WATER)) 
  {
    call_out("waterdeath", 0);
    return ;
  }
}

waterdeath() {
  say("Der "+QueryProp(P_NAME)+" verdampft mit einem leisen Seufzer.\n");
  ME->remove();
}

void start_remove(int zeit) {
 call_out("wegbinich", zeit);
 return ;
}

wegbinich() {
 tell_room(environment(ME), BS("Der "+QueryProp(P_NAME)+" loest sich in ein "
     +"Rauchwoelkchen auf."));
 remove();
}


//////////////////////////////////////////////////////////////////////////////
// Reactions
//////////////////////////////////////////////////////////////////////////////

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  // feuerelementare knuddeln, wuscheln ist mal keine gute idee
  if(touch)
    call_out("fire", 0);
  return;
}

void fire()
{
  tell_room(MENV, sprintf("%s verbrennt sich furchtbar an dem "
      "%s!\n%s schreit laut auf!\n", TP->Name(WER), QueryProp(P_NAME),
      TP->Name(WER)), ({TP}));
  tell_object(TP, BS(sprintf("WAHHHH! Du verbrennst Dich furchtbar an dem "
      "%s!", QueryProp(P_NAME))));
  if(TP->is_class_member(CL_TROLL))
    TP->AddHp(-random(20)+21);
  else 
    TP->AddHp(-random(20)+1); 
}
