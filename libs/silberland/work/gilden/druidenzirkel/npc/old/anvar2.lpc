void laehme(object enemy,int damage, mixed dam_type)
{
 int speed;
 switch(random(10)) {
   case 0..3:  speed=75; break;
   case 4..6:  speed=50; break;
   case 7:     speed=30; break;
   case 8..9:  speed=20; break;
 }
 enemy->ModifySkillAttribute(TO,SA_SPEED,speed,60);
}
