// /d/gebirge/angrox/4elem/npc/anvar.c   
// Anvar, das "Questorakel" der 4elem - quest 
// xx-xx-1997 GildenNPC
// 27-10-1996 Angrox@SilberLand

inherit "std/npc";
inherit "std/spellbook";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "/gilden/druidenzirkel/druiden.h"

#define BSA(x, y) break_string(x, 78, y)
/* Fuer die Windquest, Orginal in /d/gebirge/angrox/4elem/4elem.h */
#define W_Q_ITEM "\nwindquest"
#define WIND_QUEST "Cailleac'h's Harfe"
#define SW_Q_ITEM "\nerdequest"
#define OBJ2(x) "/d/gebirge/angrox/4elem/obj/obj/"+x
/* Windquest Ende */


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Anvar, der Druide");
  SetProp(P_LONG, BS(
    "Anvar ist eine grosse, hagere Gestalt, dessen Gesicht hinter der "
   +"Kapuze seines grauen Mantels versteckt ist. Er strahlt eine "
   +"innere Ruhe aus, der Du Dich nicht entziehen kannst. Er traegt "
   +"einen langen Stab bei sich, auf welchen er sich stuetzt."));
  AddDetail("mantel", "Der Graue Kapuzenmantel laesst Anvar unheimlich "
   +"wirken...");
 
   SetProp(P_NAME, "Anvar");
  SetProp(P_GENDER, MALE);
  AddId(({"anvar", "druide", "anvar"}));
  set_living_name("anvar");

  create_default_npc(50);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_GUILD, "druidenzirkel");
  SetProp(P_GUILD_LEVEL, 15);
  SetProp(P_HANDS, ({"mit flammenden Haenden",300,DT_FIRE}));
  SetProp(P_XP, QueryProp(P_XP)); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,60);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das war ein dummer Zufall!");
  SetProp(P_KILL_NAME, "Anvar");
  SetProp(P_KILL_MSG, "Ein Frevler weniger! Wo ist der naechste?");
  SetProp(P_SPELLRATE, 60);
  
  AddSpell(5,200,
    "Anvar wirft einen elementaren Luftpfeil nach Dir.\n",
    "Anvar wirft einen elementaren Luftpfeil nach @WEN.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,250,
    "Anvar wirft einen elementaren Erzpfeil nach Dir.\n",
    "Anvar wirft einen elementaren Erzpfeil nach @WEN.\n",
     ({DT_BLUDGEON, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(5,300,
    "Anvar wirft einen elementaren Feuerpfeil nach Dir.\n",
    "Anvar wirft einen elementaren Feuerpfeil nach @WEN.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,250,
    "Anvar wirft einen elementaren Wasserpfeil nach Dir.\n",
    "Anvar wirft einen elementaren Wasserpfeil nach @WEN.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,300,
    "Anvar wirft einen elementaren Eispfeil nach Dir.\n",
    "Anvar wirft einen elementaren Eispfeil nach @WEN.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));  
  AddSpell(2,1,
    "Anvar konzentriert sich und macht eine weitreichende "
    +"Bewegung.\n",
    "Anvar konzentriert sich und macht eine weitreichende "
    +"Bewegung.\n",    
     DT_AIR, "windhose");
  AddSpell(2,1,
    "Anvar konzentriert sich und beruehrt die Erde.\n",
    "Anvar konzentriert sich und beruehrt die Erde.\n",
     ({DT_BLUDGEON, DT_MAGIC}), "erdbeben");
  AddSpell(2,1,
    "Anvar konzentriert sich und blaest in die zur Halbkugel "
   +"geformten Haende.\n",
    "Anvar konzentriert sich und blaest in die zur Halbkugel "
   +"geformten Haende.\n",    
     DT_WATER, "sturmflut");
  AddSpell(2,1,
    "Anvar konzentriert sich und erstarrt.\n",
    "Anvar konzentriert sich und erstarrt.\n",    
     DT_COLD, "hagelschlag");
  AddSpell(2,1,
    "Anvar konzentriert sich und formt seltsame Zeichen mit "
   +"der rechten Hand.\n",
    "Anvar konzentriert sich und formt seltsame Zeichen mit "
   +"der rechten Hand.\n",    
     DT_FIRE, "feuersturm");  
  AddSpell(2,1,
    "Anvar laehmt Dich.\n",
    "Anvar laehmt @WEN.\n",    
     DT_BLUDGEON, "laehme");  

  /*
  AddSpell(5,700,
    "Anvar konzentriert sich und beruehrt die Erde.\n",
    "Anvar konzentriert sich und beruehrt die Erde.\n",
     ({DT_BLUDGEON, DT_MAGIC}), "erdbeben");
     */ 
  AddInfo(DEFAULT_INFO,
	 ({"blickt Dich traurig an...\n",
	   "scheint Dich zu ignorieren.\n",
	   "gruebelt vor sich hin.\n",
	   "spricht: Das Gleichgewicht der Elemente ist in Gefahr.\n",
     	   "sagt: Darueber weiss ich nichts.\n",
           "sagt: Darueber wollte Woody auch was wissen.\n", 
           "sagt: Darueber wollte Dusty auch was wissen.\n", 
           "sagt: Ja, das ist eine ernste Sache.\n",
           "sagt: Das ist nicht wichtig.\n"
           }));

  AddInfo(({"angrox", "creative"}),
	   "Creative und Angrox haben mich erschaffen.", "sagt: ");

  AddInfo(({"druide", "druiden"}),
	   "Die Druiden sind die Weisen des Waldes. Wir versuchen "
	  +"die Natur und ihre Elemente zu verstehen und mit ihr "
	  +"im Einklang zu leben. Das setzt natuerlich ein "
	  +"Verstaendnis der Harmonie vorraus.",
	  "belehrt Dich: ");

  AddInfo("dusty", 
           "Dusty ist eine maechtige, gerechte und weise Goettin!", 
           "Anvar spricht voller Ehrfurcht: ");

  AddInfo("einklang",
	   "Ja, das Leben in Einklang und Harmonie ist fuer einen "
	  +"Druiden sehr wichtig.", "erklaert: ");

  AddInfo("harmonie",
	   "Harmonie kann nur bestehen, wenn ein Gleichgewicht zwischen "
	  +"Gut und Boese, also ein gewisses Quantum an Neutralitaet "
	  +"besteht.", "belehrt Dich: ");

  AddInfo(({"gut", "boese"}),
	   "Beide muessen vorhanden sein, damit Harmonie bestehen kann.",
	   "erklaert: ");

  AddInfo("neutralitaet",
	   "Auch Neutralitaet ist fuer uns Druiden wichtig, da wir sonst "
	  +"unsere Kraefte nicht frei entfalten koennen.", "spricht: ");

  AddInfo("kraefte",
	   "Unsere Zauberkraefte natuerlich!", "erklaert: ");

  AddInfo("zauberkraefte",
	   "Wir Druiden verstehen uns auf die Meisterung der Elemente in "
	  +"all ihren Formen.", "erklaert: ");

  AddInfo(({"formen", "form"}),
	   "Es gibt viele Formen von elementarer Magie: Beschwoerungen, "
	  +"destruktive Hermetik, Heilzauberei und dergleichen.",
	   "sagt: ");

  AddInfo(({"destruktive hermetik", "hermetik"}),
	   "Gemeint ist die Kampfmagie, bei der die Kraft der Element in "
	  +"roher Form auf den Gegner geworfen werden. Das gilt natuerlich "
	  +"nicht fuer das Element Humus.",
	   "erklaert: ");

  AddInfo("heilzauberei",
	   "Heilzauberei stammt vom Element Humus ab. Darunter fallen "
	  +"Zauber wie \"heile\", \"entfrosche\" und \"entgifte\".",
	   "erklaert: ");

  AddInfo(({"wald", "waelder"}),
	   "Die Waelder sind die Zuflucht derer, die mit der Natur "
	  +"in Einklang leben.", "erklaert: ");

  AddInfo("woody",
	   "Woody ... ja, hier im Wald ist man Woody sehr nahe.", "spricht: ");

  AddInfo("feyaria",
	   "Feyaria ... eine Erzmagierin, oder? Sehr maechtig. "
	  +"Sehr weise.", "schaetzt: ");

  AddInfo("eros",
	   "Eros ist einer der Herren ueber das Element Erz ... "
	  +"repraesentiert durch seine "
	  +"Herrschaft im Gebirge.", "sagt: ");

  AddInfo("herren",
	   "Herren, Gebieter, wie immer Du es haben willst.",
	   "erklaert entnervt: ");

  AddInfo("natur",
	   "Die Natur lehrt uns Vieles, auch die Beherrschung der "
	  +"Elemente faellt darunter.", "sagt: ");

  AddInfo(({"elemente", "element"}),
	   "Dero Elemente gibt es sechs: Luft, Feuer, Erz, Wasser, Humus "
	  +"und Eis. Leider ist das Gleichgewicht der "
	  +"Elemente gestoert.", "spricht ernst: ");

  AddInfo("beherrschung",
	   "Die Beherrschung der Elemente liegt in der Beschwoerung von "
	  +"minderen Elementargeistern und Dschinnen.", "belehrt Dich: ");

  AddInfo(({"beschwoerung", "beschwoerungen"}),
	   "Die Beschwoerung der Elemente ist ein gefaehrliches Unterfange. "
	  +"Bei missglueckter Beschwoerung kann ein Elementar sich leicht "
	  +"gegen den Beschwoerer richten.",
           "sagt: ");

  AddInfo("beschwoerer",
	   "Derjenige, der beschwoert!", "spricht entnervt: ");

  AddInfo(({"druidenzirkel", "zirkel", "gilde", "druidengilde"}),
	   "Hier im Druidenzirkel finden sich die Druiden ein, "
          +"um ihre Kenntnisse der Elemente zu verbessern. Es steht "
          +"im Prinzip jedem frei, unserem Zirkel bezutreten. "
          +"Allerdings muss man schon gewisse Vorraussetzungen "
          +"mitbringen. Du kannst Dich hier dem kaempferischen Zweig des "
          +"Zirkels verschreiben, bei welchem Du Dich noch zwischen den "
          +"Elementen Feuer, Eis, Wasser, Luft und Erz entscheiden "
          +"(Syntax: trete <element> bei). Diese Wahl ist nicht einfach."
          +"Es gibt allerdings einen Preis fuer die "
          +"Faehigkeit der elementaren Beherrschung: Es ist uns Druiden "
          +"unmoeglich, Ruestungen und Waffen zu benutzen, die aus "
          +"bearbeitetem Metall bestehen. " 
          +"Falls Du eingetreten bist, und "
          +"Du moechstest wieder austreten (was ich nicht hoffe), kannst "
          +"Du das mit \"austritt\" vollfuehren. Dabei verlierst Du aber "
          +"einiges an Wissen, dass Du in der Gilde gelernt hast und Du "
          +"wirst wieder Mitglied der laecherlichen Abenteurergilde.", 
           "sagt: ");

  AddInfo("hermetik", 
          "Kampfzauber.", "erklaert: ");

  AddInfo("wahl", 
          "Durch die Wahl eines bestimmten Elementes erhaelt man enorme "
         +"Vorteile in den Zaubern, die diesem Element zugeordnet sind. "
         +"Nachteile erleidet man nur in den Zaubern des entgegengesetzen "
         +"Elementes.", "sagt: ");

  AddInfo(({"vorraussetzungen", "vorrausssetzung"}),
          "Nun, mann muss intelligent und einigermassen "
         +"welterfahren sein. Auch die Weltansicht ist ein Kriterium. "
         +"Du musst auch gewisse Aufgaben erfuellen, damit Du im " 
         +"Zirkel aufsteigen kannst.",
          "sagt: ");

  AddInfo("metall", 
          "Jegliches geschmiedetes Metall behindert den elementaren "
         +"Fluss rund um den Druiden. Deswegen ist es uns nicht gestattet, "
         +"solche Ruestungen zu tragen und solche Waffen zu benuetzen.",
          "erklaert: ");

  AddInfo("weltansicht", 
          "Gemeint ist eine gewisse Neutralitaet.", "sagt: ");

  AddInfo("neutralitaet", 
          "Nicht zu gut und nicht zu boese.", "schmunzelt: ");

  AddInfo("elementar",
	   "Von jedem Element kann ein Elementar - ob Dschinn, ob "
	  +"Elementargeist - beschworen werden.", "erklaert: ");

  AddInfo("elementargeister",
	   "Die Elementargeister koennen niedere Dienste verrichten "
	  +"und verfuegen natuerlich ueber die Faehigkeiten ihres "
	  +"Elementes.", "spricht: ");

  AddInfo("dschinnen",
	   "Dschinne sind sehr maechtig. Sie koennen ueber einen "
	  +"gewissen Zeitraum dienen.");

  AddInfo("feuer",
	   "Das Feuer steht nicht fuer das Herd- oder Lagerfeuer, "
	  +"sondern ist die Essenz von Waerme und Licht, Umwaelzung "
	  +"und Vernichtung. Viele Arten destruktiver Magie werden "
	  +"dem Feuer zugeschrieben, aber auch der "
	  +"schoepferisch-brennende Geist und der aktive, nach aussen "
	  +"draengende Wille.", "erklaert: ");

  AddInfo("essenz",
	   "Das Wesentliche natuerlich!", "erklaert entnervt: ");

  AddInfo(({"herdfeuer", "lagerfeuer"}),
	   "Ja, jedes noch so kleine Feuer stellt eine elementare "
	  +"Manifestiation des Elementes Feuer dar.", "spricht: ");

  AddInfo(({"waerme", "licht", "umwaelzung", "vernichtung"}),
	   "All das sind Eigenschaften des Elementes Feuer.",
	   "erklaert: ");

  AddInfo(({"eigenschaft", "eigenschaften", "charakterzuege",
			"repraesentation"}),
	   "Jedem Element sind eine oder mehrere Eigenschaften "
	  +"zugeordnet.", "sagt: ");

  AddInfo("luft",
	   "Dies ist nicht nur die Luft, die wir atmen, es sind auch "
	  +"Faulgase aus einem Sumpf oder Alchemistenlabor und - vor "
	  +"allem - der Wind, vom lauen Lueftchen bis hin zum Orkan. "
	  +"Demzufolge sind mit der Luft auch solche Eigenschaften wie "
	  +"Bewegung, Fluechtigkeit, aber auch Hellsicht und "
	  +"Verstaendigung verbunden. So wie der Humus ist auch der "
	  +"Wind eines der lebensspendenden Elemente.",
	   "erklaert: ");

  AddInfo(({"gase", "faulgase", "lueftchen", "orkan"}),
	   "Das ist eine Manifestation des Elementes Luft.", "sagt");

  AddInfo(({"bewegung", "fluechtigkeit", "hellsicht", "verstaendigung"}),
	   "Das ist eine Eigenschaft des Elementes Luft.");

  AddInfo("erz",
	   "Dies ist das Reich der unbelebten Materie. Felsen, Sand, "
	  +"Erze, Metalle, aber auch Salze, Edelsteine oder einfach "
	  +"Staub zaehlen zu den elementaren Manifestationen von "
	  +"Erz. Schwere, Bestaendigkeit und Festigkeit sind die "
	  +"Eigenschaften des Erzes, im uebertragenen Sinne auch "
	  +"Starrsinn oder Willenskraft, Unbeugsamkeit und Staerke. "
	  +"Diese Charakterzuege wuerzeln in der Erde selbst.",
	   "erklaert: ");

  AddInfo("materie",
	   "In welchem Zusammenhang?", "fragt: ");

  AddInfo(({"salz", "salze", "edelstein", "edelsteine", "sand",
			"fels", "felsen", "staub"}),
	   "So koennte sich das Element Erz manifestieren.", "spricht: ");

  AddInfo(({"schwere", "bestaendigkeit", "festigkeit"}),
	   "Das ist eine Eigenschaft des Elementes Erz.", "sagt: ");

  AddInfo(({"starrsinn", "willenskraft", "unbeugsamkeit", "staerke"}),
	   "Im uebertragenen Sinne ist das auch eine Eigenschaft "
	  +"des Elementes Erz.", "sagt: ");

  AddInfo("sinne",
	   "Im uebertragenen Sinne, ja.", "sagt: ");

  AddInfo("wasser",
	   "Im Wasser finden nicht nur Tiefe und "
	  +"Unergruendlichkeit ihre Repraesentation, sondern vor "
	  +"allem die Veraenderbarkeit und die Kraft der langsamen, "
	  +"aber stetigen Veraenderung. Unergruendlicher Geist, "
	  +"aber auch Melancholie und Wahnsinn, werden ebenso mit "
	  +"Wasser assoziiert, wie Wandelbarkeit, Beweglichkeit und "
	  +"Eleganz.", "erklaert: ");

  AddInfo(({"tiefe", "unergruendlichkeit", "veraenderbarkeit",
			"unergruendlicher geist", "melancholie", "wahnsinn",
			"wandelbarkeit", "beweglichkeit", "eleganz"}),
	   "Das ist eine Eigenschaft des Elementes Wasser.", "sagt: ");

  AddInfo("humus",
	   "Hier findet sich alle belebte Materie wieder - vom "
	  +"lebensspendenden Humus, die Grundlage alles lebenden "
	  +"Seins, ueber Kaefer und Wuermer, Kraeuter und Baeume bis "
	  +"hin zu den grossen Tieren und kulturschaffenden Rassen. "
	  +"Aber auch alle Dinge, die aus dem Humus entstanden sind, "
	  +"zaehlen noch zu den Manifestationen dieses Elementes: "
	  +"Holz und Leder, Knochen und welkes Laub - im elementaren "
	  +"Sinne sind sogar die Leiber von Untoten aus einer, wenn "
	  +"auch umgewandelten und pervertierten, Art von Humus geformt. "
	  +"Kein Wunder also, dass die wichtigste Eigenschaft des "
	  +"Humus Leben in all seinen Formen ist, dass ihm Lebenskraft "
	  +"und Heilzauberei zugeordnet sind.",
	   "erklaert: ");

  AddInfo(({"leder", "holz", "knochen", "laub", "kaefer", "wuermer",
			"kraeuter", "baeume", "tiere"}),
	   "Das ist eine Manifestation des Elementes Humus.", "sagt: ");

  AddInfo("untote",
	   "Auch in Untoten ist - wenn auch auf eine pervertierte Art - "
	  +"die Kraft des Humus wirksam.", "sagt: ");

  AddInfo(({"lebenskraft", "heilzauberei"}),
	   "Die Lebenskraft, bzw die Heilzauberei, sind Manifestationen "
	  +"des Elementes Humus.", "sagt: ");

  AddInfo("eis",
	   "Die Macht des Eises und der Kaelte scheint begrenzt, "
	  +"doch manifestiert sie sich nicht nur im ewigen Eis, sondern "
	  +"auch in jeder Schneeflocke, ja sogar in jeder Kaelte, "
	  +"jeder niedrigen Temperatur, und nach Meinungen einiger "
	  +"sogar in der Dunkelheit. Vor allem ist das Eis aber in "
	  +"der sprichwoertlichen \"kalten Logik\" praesent, die "
	  +"sich mal kristallscharf und unbeugsam, mal schneeweich "
	  +"und wandelbar zeigen kann. Nach Auffassung einiger Druiden "
	  +"steht dieses Element fuer mehr als nur gefrorenes Wasser: "
	  +"Es soll auch die Eiseskaelte, die alles erstarren laesst, "
	  +"bezeichnen, den Frost, der das Leben beendet, die weisse "
	  +"Oednis, die sich ueber das Land senkt und Stillstand bringt.",
	   "erklaert: ");

  AddInfo(({"schneeflocke", "kaelte", "temperatur", "dunkelheit",
			"logik"}),
	   "Das ist eine der Manifestationen des Elementes Eis.", "sagt: ");

  AddInfo(({"eiseskaelte", "frost", "oednis", "stillstand"}),
	   "Nach Auffassung einger Druiden sollen dies die totbringenden "
	  +"Eigenschaften von Eis sein.", "sagt: ");

  AddInfo("auffassung",
	   "Diese Auffassung teilen wir hier nicht! Alle Elemente sind "
	  +"von konstruktiver Natur.", "sagt: ");

  AddInfo("gleichgewicht",
	   "Das Gleichgewicht der Elemente Feuer, Wasser, Wind und "
	  +"Humus ist gestoert. Einige maechtige Artefakte, in die "
	  +"die Macht der Elemente verankert wurden, werden "
	  +"benoetigt, um das Gleichgewicht wieder herzustellen.",
	   "spricht ernst: ");

  AddInfo("artefakte",
	   "Die Artefakte wurden einst geschaffen, um den Missbrauch "
	  +"der Kraft, die heute als Magie bekannt ist, zu verhindern. "
	  +"Wenn der Missbrauch durch skrupellose Magiebegabte "
	  +"ueberhand nimmt, so wird die Welt vernichtet werden.",
	   "sagt: ");

  AddInfo("missbrauch",
	   "Ich fuerchte, das Schreckliche ist eingetreten, und es ist "
	  +"nur mehr eine Frage der Zeit, bis der prophezeite Untergang "
	  +"stattfindet. Nur mit der Hilfe der Artefakte ist es moeglich, "
	  +"das Chaos zu stoppen...wenn diese mit Hilfe eines "
	  +"Mutigen gefunden werden.",
	   "fluestert: " );

  AddInfo("untergang",
	   "Die Welt wird nicht dann nicht mehr so existieren, wie wir "
	  +"sie kennen. Das Chaos wird ueberall sein, und keiner kann "
	  +"dem Boesen dann noch entkommen.", "sagt: ");

  AddInfo(({"chaos", "boesem"}),
	   "Wenn erst das Chaos die Ueberhand gewinnt, dann ist die "
	  +"Welt verloren.", "erklaert: ");

  AddInfo("welt",
	   "Die Welt, in der wir leben, wird von vielen Kraeften "
	  +"kontrolliert. Eine davon ist die Kraft der Elemente.",
	   "erklaert: ");

  AddInfo("magiebegabte",
	   "Alle Rassen sind heute in der Lage, die Magier nach ihren "
	  +"Wuenschen zu benutzen.", "sagt: ");

  AddInfo("rassen",
	   "Ja, alle Rassen.", "sagt: ");

  AddInfo("hilfe",
	  "Hmmm ... Du wuerdest mit helfen? Nun, wenn Du mir wirklich "
	 +"Deine Hilfe anbietest, dann bedenke, dass dies eine Quest "
	 +"von grossem Ausmass sein wird.", "erlaeutert: ");

  AddInfo("quest",
	   "@@queste@@", "sagt: ", "Anvar erzaehlt etwas, das Du "
	  +"nicht verstehen kannst.\n");

  AddInfo(({"kelch", "schwert", "stab"}),
	   "Darueber muss ich erst Informationen sammeln. Komme "
	  +"zu einem spaetern Zeitpunkt wieder.", "meint: ");

  AddInfo("harfe", "@@harfen_info@@", "sagt: ", "Anvar spricht leise, "
	  +"sodass Du ihn nicht verstehst.\n");

  AddInfo("hueterin",
	   "Es heisst, sie ist sehr gerissen!", "warnt Dich: ");

  AddInfo("zauber", 
           // Kaempferzweig
           "Folgende Zauber kannst Du hier erlernen: "
          +"Luftpfeil, Erzpfeil, Wasserpfeil, Eispfeil, Feuerpfeil, "
          +"Windstoss, Wasserstrahl, Erzstrahl, Froststrahl, Feuerball, "
          +"Erdbeben, Windhose, Hagelschlag, Sturmflut, Feuersturm, "
          +"Luftelementar, Erzelementar, Wasserelementar, Eiselementar "
          +"und Feuerelementar, "
          +"Erkenne, Schaetz, Laehme, Behandle, "
          +"Dzuecke, Elementarpanzer, Feuerhand und Feuerwusel. "
          +"Du kannst mich zu jedem Zauber einzeln befragen, und du kannst "
          +"mich auch fragen, ab welcher Gildenstufe man den Zauber "
          +"lernen kann. (Syntax: frag anvar nach zauber der stufe <x>)", 
           "sagt: "); 
          
  AddInfo("zauber der stufe 1", 
           "In dieser Stufe kannst Du Luftpfeil und Erkenne lernen.", 
           "sagt: ");
  AddInfo("zauber der stufe 2", 
           "In dieser Stufe kannst Du Erzpfeil und Feuerwusel lernen.", 
           "sagt: ");
  AddInfo("zauber der stufe 3", 
           "In dieser Stufe kannst Du Wasserpfeil und Schaetz lernen.", 
           "sagt: ");
  AddInfo("zauber der stufe 4", 
