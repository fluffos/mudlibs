#pragma strong_types;

inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <wizlevels.h>
#include <armour.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden.h"

nosave int CheckPursuers();
nosave int zeit=0;
nosave int can_act=1;
nosave int setremove=0;
nosave int fehler=0;
nosave string element;
nosave int *e_dam_type;


void create() {
  if (!is_clone(TO)) return;
  ::create();
  element="Neutral";
  e_dam_type=({DT_BLUDGEON});
  SetProp(P_SHORT, "Elementar");
  SetProp(P_NAME, "Elementar");
  SetProp(P_GENDER, NEUTER);
  AddId(({"elementar", DRUIDENELEMENTAR}));
  create_default_npc(1);

  SetProp(P_HANDS, ({" mit elementarer Macht",100,DT_MAGIC}));
  SetProp(P_RACE, "Elementar");
  SetProp(P_XP, 0);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
   // Verwundbarkeiten und Resistenzen
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0,        DT_BLUDGEON   :0,        DT_PIERCE     :0,
    DT_SQUEEZE    :0,        DT_WHIP       :0,        DT_RIP        :0,
    DT_FIRE       :0,        DT_COLD       :0,        DT_WATER      :0,    
    DT_AIR        :0,        DT_LIGHTNING  :0,        DT_EXPLOSION  :0, 
    DT_SOUND      :-0.5,     DT_LIGHT      :-0.5,     DT_ELECTRIC   :0,    
    DT_ACID       :-0.5,     DT_POISON     :0,        DT_TERROR     :-0.5,   
    DT_HOLY       :-0.5,     DT_UNHOLY     :-0.5,     DT_MAGIC      :0,
    DT_MIND       :-0.5,     DT_STONE       :0]) );
  SetProp(P_NOMAGIC,10);
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MMSGIN, "stapft");
  SetProp(P_MMSGOUT, "stapft"); 
  SetProp(P_DIE_MSG,  " verschwindet.\n");
  SetProp(P_NOCORPSE,1);
  SetProp(P_KILL_NAME, "Ein Elementar");
  SetProp(P_KILL_MSG, "Mein Meister wollte Deinen Tod!");
  AddInfo(DEFAULT_INFO, "reagiert nicht auf Dich.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Elementar ignoriert Dich.\n" }) );
  SetProp(E_REMOVE_MSG, "Das Elementar verschwindet.\n");
}

//Fuer das filter_array in catch_tell:
int is_elemental(object ob) {
  if(ob->id(DRUIDENELEMENTAR))
    return 1; 
  return 0;
}

init() {
  object owner;
  ::init();
  // Feuerelementar soll im Wasser verdampfen
  if(lower_case(element)=="feuer" && ( 
      ENV(ME)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]==TT_UNDERWATER ||
      ENV(ME)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]==TT_WATER))
  {
    call_out("waterdeath", 0);
    return ;
  }
  if(ENV(ME)&& !QueryProp(ELEMENTAL_OWNER) &&
        sizeof(filter_array(all_inventory(ENV(ME)),#'is_elemental))>10) 
  {
    call_out("remove", 2);
    return;
  }
    
  if(member(users(), QueryProp(ELEMENTAL_CASTER))==-1) {
    ME->remove();
    return;
  }
  if(objectp(QueryProp(ELEMENTAL_OWNER))) {
     if(!living(owner=QueryProp(ELEMENTAL_OWNER))) {
       ME->remove();
       return;
     }
     if(objectp(owner))
       owner->AddDefender(TO);
  }
  
  return;
}

void reset() {
  ::reset();
  ME->remove();
}

int remove() {
  object owner;
  if(objectp(QueryProp(ELEMENTAL_OWNER)))
    if(living(owner=QueryProp(ELEMENTAL_OWNER))) {
      owner->RemovePursuer(ME);
      tell_room(MENV, BS(QueryProp(E_REMOVE_MSG)));
    }
  while(remove_call_out("remove")!=-1);
  return ::remove();
}


nosave void waterdeath() {
  SetProp(E_REMOVE_MSG, "Das Feuerelementar verdampft mit "
      "Schmerzgebruell.\n");
  ME->remove();
}


int PreventFollow(object dest) {
  object owner;
  if(objectp(QueryProp(ELEMENTAL_OWNER))) {
    owner=find_living(getuid(QueryProp(ELEMENTAL_OWNER)));
    if(!owner || owner->QueryProp(P_GHOST)) {
      call_out("remove", 0);
      return 1;
    }
  }
  return 0;
}

// Ueberpruefen des Ringes
nosave int check_ring(string ele, object pl) {
  string ring_id;
  object ob;
  ring_id="\nelement_ring_"+ele;
  if(!ob=present(ring_id, TP)) return 0;
  if(!ob->QueryProp(P_WORN)) return 0;
  if(!ob->check_equip_time()) return 0;
  return 1; 
}

void set_time(int x) {
  zeit=x;
}

void set_fehler() {
  fehler=1;
}

int set_element(string str) {
  mapping res;
  res=QueryProp(P_RESISTANCE_STRENGTHS);
  element=lower_case(str);
  switch (lower_case(str)) {
    case "feuer": 
      e_dam_type=({DT_FIRE});
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_FIRE:-1, DT_WATER:3, 
                                            DT_COLD:1]));
      AddInfo(({"dienst", "dienste"}), "@@feuer_info@@", "sagt: "); 
      SetProp(P_MSGOUT, "brennt sich seinen Weg");
      SetProp(P_MMSGOUT, "verschwindet in einer Flammensaeule");
      SetProp(P_MMSGIN, "materialisiert sich in einer Flammensaeule");
      break;
      
    case "wasser": 
      e_dam_type=({DT_WATER});
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_WATER:-1, DT_FIRE:3]));
      AddInfo(({"dienst", "dienste"}), "@@wasser_info@@","sagt: "); 
      SetProp(P_MSGOUT, "fliesst");
      SetProp(P_MMSGOUT, "versickert im Erdboden");
      SetProp(P_MMSGIN, "entsteht aus der Luftfeuchtigkeit");
      break;
      
    case "eis": 
      e_dam_type=({DT_COLD});
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_COLD:-1, DT_FIRE:1, 
                                            DT_POISON:3]));
      AddInfo(({"dienst", "dienste"}), "@@eis_info@@","sagt :");
      SetProp(P_MSGOUT, "verbreitet seine Kaelte");
      SetProp(P_MMSGOUT, "verschwindet in eisiger Kaelte");
      SetProp(P_MMSGIN, "materialisiert sich aus der Kaelte");
      break;
    
    case "erz": 
      e_dam_type=({DT_BLUDGEON, DT_MAGIC});
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_SLASH:-0.9, DT_BLUDGEON:-0.9,
            DT_PIERCE:-0.9, DT_SQUEEZE:-0.9,DT_WHIP:-0.9,DT_RIP:-0.9, 
            DT_STONE:-0.9,DT_AIR:3]));
      AddInfo(({"dienst", "dienste"}), "@@erz_info@@","sagt: ");
      SetProp(P_MSGOUT, "stapft schweren Schrittes");
      SetProp(P_MMSGOUT, "verschwindet im Erdboden");
      SetProp(P_MMSGIN, "entsteigt der Erde");
      break;
    
    case "luft": 
      e_dam_type=({DT_AIR});
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_SLASH:2, DT_BLUDGEON:2
          ,DT_PIERCE:2, DT_SQUEEZE:2,DT_WHIP:2,DT_RIP:2, DT_STONE:2, 
          DT_AIR:-1]));
      AddInfo(({"dienst", "dienste"}), "@@luft_info@@","sagt: ");
      SetProp(P_MSGOUT, "weht");
      SetProp(P_MMSGOUT, "fliegt weg");
      SetProp(P_MMSGIN, "fliegt mit Sturmgebruell herein");
      break;
      
    case "humus": 
      e_dam_type=({DT_POISON});
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_POISON:-1, DT_COLD: 2]));
      AddInfo(({"dienst", "dienste"}), "@@humus_info@@","sagt: ");
      SetProp(P_MSGOUT, "stapft");
      SetProp(P_MMSGOUT, "verschwindet im Erdboden");
      SetProp(P_MMSGIN, "entsteigt der Erde");
      break;
  }
  return 1;
  set_next_reset(15+random(20));
}

/* Ausgabe der Frage nach Dienst */
nosave string luft_info() {
  if(TP!=QueryProp(ELEMENTAL_OWNER))
    return "Du bist nicht mein Meister!";
  if(!check_ring(LUFT, TP)) 
    return "Meister, Dir werde ich keine Dienste erfuellen!";
  if(TP->QueryProp(P_GUILD)!="druidenzirkel")
    return "Meine Dienste biete ich nur Druiden an.";
  return sprintf("Diese Dienste kann ich Dir anbieten, Meister: "
      "Ich kann Deine Magie auffrischen (sag luftelementar frische "
      "meine magie auf), ich kann Gegenstaende zu anderen Spielern "
      "bringen (sag luftelementar bringe <spieler> <gegenstand> - "
      "%d MP fuer Sender (+ Gewichtszuschlag) und Empfaenger) und ich kann Dich im ganzen "
      "SilberLand umherfliegen (sag luftelementar fliege mich nach "
      "<ziel> - %d MP + Gewichtszuschlag, 1 Magiestein). Die Wegpunkte, zu denen ich Dich fliegen "
      "kann, musst Du allerdings selbst herausfinden.", LUFT_BRINGEN,
      LUFT_FLIEGEN);
}

nosave string humus_info() {
  //if(!IS_WIZARD(TP)) return "Das geht Dich nichts an!";
  if(TP!=QueryProp(ELEMENTAL_OWNER))
    return "Du bist nicht mein Meister!";
  if(!check_ring(HUMUS, TP)) 
    return "Meister, Dir werde ich keine Dienste erfuellen!";
  if(TP->QueryProp(P_GUILD)!="druidenzirkel")
    return "Meine Dienste biete ich nur Druiden an.";
  return sprintf("Diese Dienste kann ich Dir anbieten, Meister: "
      "Ich kann Dich heilen (sag humuselementar heile mich)");
}

nosave string erz_info() {
  //if(!IS_WIZARD(TP)) return "Das geht Dich nichts an!";
  if(TP!=QueryProp(ELEMENTAL_OWNER))
    return "Du bist nicht mein Meister!";
  if(!check_ring(ERZ, TP)) 
    return "Meister, Dir werde ich keine Dienste erfuellen!";
  if(TP->QueryProp(P_GUILD)!="druidenzirkel")
    return "Meine Dienste biete ich nur Druiden an.";
  return sprintf( 
        "All das kann ich Dir bieten, Meister: Ich kann mich in Edelsteine "
        "verwandeln (sag erzelementar verwandle dich in edelsteine - %d MP) "
        
        "<material> - %d MP), ich kann einen Teil Deiner getragenen "
        " Ausruestung reparieren (sag erzelementar reapriere ausruestung - "
        "%d MP) und Dich vor physischen Schaeden schuetzen (sag erz"
        "elementar schuetze mich - %d MP).",ERZ_EDELSTEIN, ERZ_MATERIE,
        ERZ_REPARIEREN,ERZ_SCHUTZ);
}

nosave string feuer_info() {
  //if(!IS_WIZARD(TP)) return "Das geht Dich nichts an!";
  if(TP!=QueryProp(ELEMENTAL_OWNER))
    return "Du bist nicht mein Meister!";
  if(!check_ring(FEUER, TP)) 
    return "Meister, Dir werde ich keine Dienste erfuellen!";
  if(TP->QueryProp(P_GUILD)!="druidenzirkel")
    return "Meine Dienste biete ich nur Druiden an.";
  return sprintf( 
        "Folgende Dienste kann ich Euch anbieten, Meister: Hitzeschutz "
