nosave int feuer_temp() {
  object ob;
  mapping temp;
  command_me("sag Meister, ich kann im Moment die Temperatur nicht "
      "veraendern!");
  return 1;
  if(TP->QueryProp(P_SP)<FEUER_TEMP) {
    command_me("sag Meister, Ihr habt zuwenig Magie!");
    return 0;
  }
  if(!MENV) {
    command_me("sag Meister, hier im Nichts gibt es keine Temperatur!");
    return 0;
  }
  if(!member(MENV->QueryProp(P_ENVIRONMENT), ENV_TEMPERATURE)) {
    command_me("sag Meister, hier gibt es keine Temperatur!");
    return 0;
  }
  if(MENV->Query(P_ENVIRONMENT, F_QUERY_METHOD) || present("\ntemp", MENV)) 
  {
    command_me("sag Meister, die Temperatur wurde hier schon veraendert!");
    return 0;
  }
  TP->AddSp(-FEUER_TEMP);
  temp=MENV->QueryProp(P_ENVIRONMENT);
  temp[ENV_TEMPERATURE]+=QueryProp(P_LEVEL)/2;
  ob=clone_object(DRUIDEN("obj/temp"));
  ob->move(MENV, M_NOCHECK);
  ob->SetVariables(temp, MENV->QueryProp(P_ENVIRONMENT));
  tell_room(MENV, BS("Das Feuerelementar verwandelt sich in feurige Hitze "
      "und erhoeht die Temperatur des Raumes!"));
  ME->remove();
  return 1;
}

nosave int feuer_enthaare(string pl_name) {
  object ob,pl;
  mapping temp;
  int wiz;
  wiz=0;
  if(TP->QueryProp(P_SP)<FEUER_ENTHAARE) {
    command_me("sag Meister, Ihr habt zuwenig Magie!");
    return 0;
  }
  if(!pl=find_player(lower_case(pl_name))) {
    command_me(sprintf("sag Meister, %s ist nicht anwesend!", CAP(pl_name)));
    return 0;
  }
  if((ENV(pl) != ENV(ME)) && !IS_WIZARD(TP)) {
    command_me(sprintf("sag Meister, %s ist nicht hier im Raum!", 
          CAP(pl_name)));
    return 0;
  }
  else if(IS_WIZARD(TP)) {
    wiz=1;
  }
  if(present("\nfeuerelementar_enthaare", pl)) {
    command_me(sprintf("sag Meister, %s hat bereits keine Haare mehr!", 
          CAP(pl_name)));
    return 0;
  }
  TP->AddSp(-FEUER_ENTHAARE);
  ob=CLONEOB(OBJ("enthaarung"));
  ob->move(pl, M_NOCHECK);
  ob->weg((TP->QueryProp(P_GUILD_LEVEL)*100));
  tell_room(MENV, BS(sprintf("Das Feuerelementar verwandelt sich in eine "
          "grosse Feuerkugel und schiesst auf %s zu! Es huellt %s kurz ein "
          "und verbrennt %s komplette Koerperbehaarung, ohne %s zu "
          "verletzen!", CAP(pl_name), pl->QueryPronoun(WEN), 
          pl->QueryPossPronoun(WEM),pl->QueryPronoun(WEN))), ({pl}));
  tell_object(pl, BS("Das Feuerelementar verwandelt sich in eine Feuerkugel "
        "schiesst auf Dich zu! WUSCH - Du bist von Flammen umhuellt, spuerst "
        "die segende Hitze. Mit einem Schlag ist die Hitze verschwunden - "
        "genauso wie Deine komplette Koerperbehaarung!"));
  ME->remove();
  return 1;
}

/* Elementar einem anderem Spieler uebergeben */
nosave int element_change(string n_owner, object owner, object caster) {
  string name1;
  object new_owner,ob;
  int helpvar;
  if(!new_owner=find_living(n_owner)) {
    say(BSA(sprintf("Meister, es gibt kein Lebewesen, dass '%s' heisst!", 
       CAP(n_owner)), "Das "+QueryProp(P_NAME)+" spricht: "));
    return 0;
  }
  if(new_owner->id(DRUIDENELEMENTAR) || new_owner->id("feuerwusel")) 
    return 0;
  if(owner==new_owner) return 0;
  if(!present(n_owner, ENV(ME))) {
    say(BSA(sprintf("Meister, hier ist niemand, der '%s' heisst!", 
          CAP(n_owner)), "Das "+QueryProp(P_NAME)+" spricht: "));
    return 0;
  }
  tdm(sprintf("Owner: %O, Caster: %O, New_Owner: %O\n",
      owner, QueryProp(ELEMENTAL_CASTER), new_owner));
  if(call_other("/spellbooks/druiden_spells", "QueryOwnCreature", 
       new_owner, 0, 1)) 
  {
    say(BSA(sprintf("Meister, %s hat bereits ein anderes Elementar!",
          new_owner->name(WER)),"Das "+QueryProp(P_NAME)+" spricht: "));
     return 0;
  }
  if(!ob=present("magiestein", owner)) {
    command_me("sag Meister, Ihr benoetigt einen Magiestein!");
    return 0;
  }
  if(new_owner->QueryProp(P_GUILD)=="druidenzirkel" || 
     ( stringp( owner->QueryProp(P_MARRIED) )  &&    // Bugfix Feyaria 
       lower_case(owner->QueryProp(P_MARRIED))==n_owner) )
  {
    helpvar=50; //kosten fuers Uebertragen   
  }
  else 
    helpvar=225; // kosten
  if(owner->QueryProp(P_SP)<helpvar) {
    say(BSA("Meister, Du bist nicht maechtig genug!", 
        "Das "+QueryProp(P_NAME)+" spricht: "));
    return 0;
  }
  owner->AddSp(-helpvar);
  ob->AddAmount(-1);
  catch(owner->RemovePursuer(ME));
  catch(owner->SetProp(P_DEFENDERS, owner->QueryProp(P_DEFENDERS)-({ME})));
  SetProp(ELEMENTAL_OWNER, new_owner);
  new_owner->AddDefender(TO);
  new_owner->AddPursuer(TO);
  //CheckPursuers();
  SetProp(P_LONG, call_other("/spellbooks/druiden_spells", "Set_P_LONG",
      element)+(" Es bleibt staendig in der Naehe von "
      +(new_owner->name(WEM))+".")); 
  SetProp(P_MSGOUT, "folgt "+new_owner->name(WEM));
  SetProp(P_MMSGOUT, "folgt "+new_owner->name(WEM));
  SetProp(E_REMOVE_MSG, BS(sprintf("Das %selementar von %s loest sich "
      "nach erfuelltem Dienst auf.", CAP(QueryElement()), 
      new_owner->Name(WER))));
  say(BSA(sprintf("Ab nun gehorche ich %s.", new_owner->name(WEM)), 
	   "Das "+QueryProp(P_NAME)+" spricht: "));
  write_file(LOG("element_transfer"), 
	      sprintf("%s: %s.%s->%s (%s)\n", 
	      dtime(time()), getuid(owner), QueryProp(P_NAME), 
	      QueryProp(ELEMENTAL_OWNER)->name(WER), 
	      file_name(ENV(ME))));
  return 1;
} 



//////////////////////////////////////////////////////////////////////////////
// Reactions
//////////////////////////////////////////////////////////////////////////////

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  // feuerelementare knuddeln, wuscheln ist mal keine gute idee
  if(touch && (element=="feuer"|| element=="eis")) {
    call_out("fire", 0);
    return;
  }
  if(member( ({"spuck", "spucke", "sabbere", "sabber"}), verb)!=-1)
  {  
   if(element=="feuer")
    call_out("attack", 0);
   if(element=="wasser")
     call_out("smile", 0);
  }
  return;
}
/*
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
    return StartReaction(verb, gruppe, adverb, touch);
}
*/
void fire()
{
  if(element=="feuer") {
    tell_room(MENV, sprintf("%s verbrennt sich furchtbar an dem "
        "Feuerelementar!\n%s schreit laut auf!\n", TP->Name(WER),
        TP->Name(WER)), ({TP}));
    tell_object(TP, BS("WAHHHH! Du verbrennst Dich furchtbar an dem "
        "Feuerelementar!"));
  }
  else {
    tell_room(MENV, BS(sprintf("%s bleibt an dem Eiselementar haften und "
        "reisst sich gewaltsam los!\n%s schreit laut auf!\n", TP->Name(WER),
        TP->Name(WER))), ({TP}));
    tell_object(TP, BS("WAHHHH! Du bleibst an dem Eiselementar haften. Du "
        "reisst Dich gewaltsam los!"));
  }
  if(TP->is_class_member(CL_TROLL))
    TP->AddHp(-random(20)+21);
  else 
    TP->AddHp(-random(20)+1); 
}

void attack() {
  tell_room(MENV, BS("Das Feuerelementar scheint das nicht witzig zu "
      "finden!"));
  ME->Kill(TP);
} 

void smile() {
  tell_room(MENV, BS(sprintf("Das Wasserelementar scheint sich zu freuen und "
      "laechelt %s an!", TP->name(WEN))),({TP}));
  tell_object(TP, BS("Das Wasserelementar scheint sich zu freuen und laechelt "
      "Dich an!"));
} 
