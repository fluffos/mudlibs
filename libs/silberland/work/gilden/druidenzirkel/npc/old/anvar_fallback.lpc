nosave void Channel(string msg) {
  CHMASTER->join("Info",TO);
  CHMASTER->send("Info",TO,msg,MSG_SAY);
}

reset() {
  ::reset();
  perg_count=10;
}

void heart_beat() {
  ::heart_beat();
  hb_time=time();
}

string pergament() {
 object ob;
 if(perg_count<1) 
    return "Tut mir leid, aber ich habe keine mehr. Komm doch "
          +"spaeter nochmal vorbei.";
 if(deep_present("pergament", TP))
   return "Aber Du hast doch schon ein Pergament.";
 ob=clone_object(OBJ("pergament"));
 ob->move(TP, M_NOCHECK);
 perg_count--;
 return "Hier!";
}



 
string queste() {
 object ob;
 if(!present(W_Q_ITEM, TP) && !(TP->QueryQuest(WIND_QUEST))) {
   ob=CLONEOB(OBJ2("windquest"));
   ob->move(TP, M_NOCHECK);
   return "Gut, mein Freund, so hoere. Vier Artefakte wurden einst "
       +"geschaffen, um die prophezeite Katastrophe abzuwenden: "
       +"Die Harfe der Winde, der Kelch des Wassers, das Schwert "
       +"des Feuers und der Stab der Erde. Diese Artefakte "
       +"wurden gut versteckt, und nur die Tapfersten, Mutigsten und "
       +"Kluegsten koennen diese Artefakte bergen. Nun, Deine "
       +"Aufgabe besteht nun darin, die Harfe der Winde zu suchen. "
       +"Die Legenden berichten, dass sie in einer sagenhaften "
       +"unterirdischem Steinwald verborgen ist, der sich irgendwo im "
       +"Gebirge befindet und von einer "
       +"Hueterin bewacht wird. Finde diese Harfe und kehre mit ihr "
       +"zurueck. Den richtigen Ort, wo dieser Wald zu finden ist, erkennst "
       +"Du an Versteinerungen in der Pflanzenwelt. "
       +"Ich muss erst die Verstecke der anderen Artefakte "
       +"lokalisieren, ich hoffe jedoch, sie bald zu erfahren."; 
 }
 if(present(W_Q_ITEM, TP))
   return "Du hilfst mir bereits.";
 if(!present(SW_Q_ITEM) && TP->QueryQuest(WIND_QUEST));
   return "Sehr gut! Leider weiss ich den Aufenthalt des "
          +"Stabes der Erde noch nicht. Komm spaeter nocheinmal "
          +"vorbei.";
}

string harfen_info() {
  if(!present(W_Q_ITEM, TP))
     return "Darueber kann ich Dir nichts sagen!!!!";
  return "Die Harfe der Winde liegt wird von einer Hueterin "
        +"bewacht. Pass gut auf, auf dass sie Dich nicht "
        +"verfuehrt!";
}


/* ----------------------------------------
          GILDENFUNKTIONEN
---------------------------------------- */

string test1() {
  if(TP->QueryProp(P_GUILD)=="druidenzirkel" ||
     present("task1", TP))
    return "Du hast mir das Kraut schon gebracht!";
  return "Suche es und bringe es mir!";
}


void LogTask(object pl, int stufe) {
  if(call_other(DRUIDENMASTER, "CheckTask", pl, stufe) &&
      stufe==15 && stufe==6) return;
  write_file(MEMBER_LOG(getuid(pl)+".log"),
             dtime(time())+": "+CAP(getuid(pl))+" hat Aufgabe "
             +stufe+" geloest.\n");
  return; 
}

give_notify(object obj) {
  object ob;
  int x;
  if(obj->id("wirselkraut")) {
    if(TP->QueryProp(P_GUILD)=="druidenzirkel") {
      tell_object(ENV(ME), BSA("Danke!", "Anvar sagt: "));
      obj->remove();
      return 1;
  	}
    write(BSA("Ah, ein Wirselkraut! Sehr Gut! Nun "
       	 +"sei dir erlaubt, der Gilde beizutreten!", "Anvar sagt: "));
    tell_room(ENV(ME), BSA("Ah, ein Wirselkraut! Sehr Gut! Nun "
	       +"sei dir erlaubt, der Gilde beizutreten!", 
         "Anvar sagt zu "+CAP(getuid(TP))+": "), ({TP}));
    obj->remove();
    call_other(DRUIDENMASTER, "SetTask", TP, 1);
    call_other(DRUIDENMASTER, "SetXp",TP, 
             TP->QueryProp(P_XP)+XP_LVL1);
    LogTask(TP, 1);
    ob=clone_object(OBJ("task"));
    ob->SetProp(ELEMENT_SECURE, 1);
    ob->move(TP, M_NOCHECK);
    return 1;
  }
  if(obj->id("silberhai")) {
    if(TP->QueryProp(P_GUILD)=="druidenzirkel" && 
       TP->QueryProp(P_GUILD_LEVEL)!=1)
    {
      tell_object(ENV(ME), BSA("Danke", "Anvar sagt: "));
      obj->remove();
      return 1;
	  }
    write(BSA("Ah, der Silberhai! Sehr Gut! Nun "
	        +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
    tell_room(ENV(ME), BSA("Ah, der Silberhai! Sehr Gut! Nun "
	          +"sei dir erlaubt, eine Stufe aufzusteigen!\n"
            , "Anvar sagt zu "+CAP(getuid(TP))+
            ": "), ({TP}));
    obj->remove();
    x=call_other(DRUIDENMASTER, "SetTask", TP, 2);
      //tell_object(find_player("angrox"), sprintf("\nMaster: %d \n", x));
    LogTask(TP, 2);
    return 1;
  } 
  if(obj->id("adlerfeder")) {
    if(TP->QueryProp(P_GUILD)=="druidenzirkel" && 
         TP->QueryProp(P_GUILD_LEVEL)!=4)
    {
      tell_object(ENV(ME), BSA("Danke", "Anvar sagt: "));
      obj->remove();
      return 1;
    }	
    write(BSA("Ah, eine Adlerfeder! Sehr Gut! Nun "
	       +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
    tell_room(ENV(ME), BSA("Ah, eine Adlerfeder! Sehr Gut! Nun "
	       +"sei dir erlaubt, eine Stufe aufzusteigen!\n"
          , "Anvar sagt zu "+CAP(getuid(TP))+
           ": "), ({TP}));
    obj->remove();
    call_other(DRUIDENMASTER, "SetTask", TP, 5);
    LogTask(TP, 5);
    return 1;
  } 
  if(obj->id("\nkajuboknospe")) {
      if(TP->QueryProp(P_GUILD)=="druidenzirkel" && 
         TP->QueryProp(P_GUILD_LEVEL)!=2)
      {
        tell_object(ENV(ME), BSA("Danke", "Anvar sagt: "));
        obj->remove();
        return 1;
      }	
      write(BSA("Ah, eine Kajuboknospe! Sehr Gut! Nun "
	          +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
      tell_room(ENV(ME), BSA("Ah, eine Kajuboknospe! Sehr Gut! Nun "
	          +"sei dir erlaubt, eine Stufe aufzusteigen!\n"
            , "Anvar sagt zu "+CAP(getuid(TP))+
           ": "), ({TP}));
      obj->remove();
      call_other(DRUIDENMASTER, "SetTask", TP, 3);
      LogTask(TP, 3);
      return 1;
    }
  if(obj->id("\nschupp")) {
     if(TP->QueryProp(P_GUILD)=="druidenzirkel" && 
         TP->QueryProp(P_GUILD_LEVEL)!=8)
     {
       tell_object(ENV(ME), BSA("Danke", "Anvar sagt: "));
       obj->remove();
       return 1;
     }	
     if(obj->QueryProp(P_AMOUNT)>1) {
        write(BSA("Ah, Drachenschuppen! Sehr Gut! Nun "
	          +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
        tell_room(ENV(ME), BSA("Ah, Drachenschuppen! Sehr Gut! Nun "
	             +"sei dir erlaubt, eine Stufe aufzusteigen!\n",
              "Anvar sagt zu "+CAP(getuid(TP))+": "), ({TP}));
     }	
     else {
        write(BSA("Ah, eine Drachenschuppe! Sehr Gut! Nun "
	          +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
        tell_room(ENV(ME), BSA("Ah, eine Drachenschuppe! Sehr Gut! Nun "
	         +"sei dir erlaubt, eine Stufe aufzusteigen!\n",
              "Anvar sagt zu "+CAP(getuid(TP))+": "), ({TP}));
     }	
     obj->remove();
     call_other(DRUIDENMASTER, "SetTask", TP, 9);
     LogTask(TP, 9);
     return 1;
  } 
  if(obj->id("machtszepter")) {
     if(TP->QueryProp(P_GUILD)=="druidenzirkel" && 
         TP->QueryProp(P_GUILD_LEVEL)!=9)
     {
       tell_object(ENV(ME), BSA("Danke", "Anvar sagt: "));
       obj->remove();
       return 1;
     }	
     write(BSA("Ah, das Szepter! Sehr Gut! Nun "
	        +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
     tell_room(ENV(ME), BSA("Ah, das Szepter! Sehr Gut! Nun "
	        +"sei dir erlaubt, eine Stufe aufzusteigen!\n",
              "Anvar sagt zu "+CAP(getuid(TP))+": "), ({TP}));	
     obj->remove();
     call_other(DRUIDENMASTER, "SetTask", TP, 10);
     LogTask(TP, 10);
     return 1;
  } 
  if(obj->id("wunderheiltrank")) {
     if(TP->QueryProp(P_GUILD)=="druidenzirkel" && 
         TP->QueryProp(P_GUILD_LEVEL)!=10)
     {
       tell_object(ENV(ME), BSA("Danke", "Anvar sagt: "));
       obj->remove();
       return 1;
     }	
     write(BSA("Ah, der Heiltrank! Sehr Gut! Nun "
	         +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
     tell_room(ENV(ME), BSA("Ah, der Heiltrank! Sehr Gut! Nun "
	         +"sei dir erlaubt, eine Stufe aufzusteigen!\n"
           , "Anvar sagt zu "+CAP(getuid(TP))+
           ": "), ({TP}));
     obj->remove();
     call_other(DRUIDENMASTER, "SetTask", TP, 11);
     LogTask(TP, 11);
     return 1;
  } 
  if(obj->id("lichtkeule")) {
     if(TP->QueryProp(P_GUILD)=="druidenzirkel" && 
         TP->QueryProp(P_GUILD_LEVEL)!=6)
     {
       tell_object(ENV(ME), BSA("Danke", "Anvar sagt: "));
       obj->remove();
       return 1;
     }	
     write(BSA("Ah, die Lichtkeule! Sehr Gut! Nun "
	         +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
     tell_room(ENV(ME), BSA("Ah, die Lichtkeule! Sehr Gut! Nun "
	         +"sei dir erlaubt, eine Stufe aufzusteigen!\n"
          , "Anvar sagt zu "+CAP(getuid(TP))+
           ": "), ({TP}));
     obj->remove();
     call_other(DRUIDENMASTER, "SetTask", TP, 7);
     LogTask(TP, 7);
     return 1;
  } 
  if(obj->id("\nhaegarhammer")) {
      if(TP->QueryProp(P_GUILD)=="druidenzirkel" && 
         TP->QueryProp(P_GUILD_LEVEL)!=12)
      {
        tell_object(ENV(ME), BSA("Danke", "Anvar sagt: "));
        obj->remove();
        return 1;
      }	
      ob=deep_present(TASKITEM, TP);
      if(ob && ob->QueryProp(ELEMENT_SECURE)==99) {
         write(BSA("Ah, Haegars Hammer! Sehr Gut! Nun "
	          +"sei dir erlaubt, eine Stufe aufzusteigen!\n", "Anvar sagt: "));
         tell_room(ENV(ME), BSA("Ah, Haegars Hammer! Sehr Gut! Nun "
	          +"sei dir erlaubt, eine Stufe aufzusteigen!\n",
            "Anvar sagt zu "+CAP(getuid(TP))+": "), ({TP}));
         obj->remove();
         ob->remove(); 
         call_other(DRUIDENMASTER, "SetTask", TP, 13);
         LogTask(TP, 14);
         return 1;
      }	
      write(BSA("Du hast zwar den Hammer, aber den Drachen nicht "
          +"selbst besiegt. Du bist nicht wuerdig, eine Stufe "
          +"aufzusteigen.", "Anvar spricht erzuernt: "));
      say(BSA("Du hast zwar den Hammer, aber den Drachen nicht "
          +"selbst besiegt. Du bist nicht wuerdig, eine Stufe "
          +"aufzusteigen.", 
           "Anvar spricht erzuernt zu "+CAP(getuid(TP))+": "));
      obj->remove();
      ob->remove();
      return 1;
  }
  if(obj->id("magiestein")) {
    x=call_other(DRUIDENMASTER, "QueryLvl16Quest", TP);
    if(TP->QueryProp(P_GUILD)=="druidenzirkel" && x>1 &&
      ob=present(TASKITEM, TP))
    {
      x=obj->QueryProp(P_AMOUNT);
      ob->SetProp(ELEMENT_SECURE, ob->QueryProp(ELEMENT_SECURE)+x);
      command_me("sag Gut.");
      if(ob->QueryProp(ELEMENT_SECURE)>=50 &&  
          call_other(DRUIDENMASTER, "QueryLvl16Quest", TP)<3)
      {
        call_out("GetLvl16Quest", 2, TP);
      }
    }
  }
  if(explode(file_name(obj),"#")[0]=="/d/dschungel/feyaria/tijara/"
      "armour/armband") 
  {
    x=call_other(DRUIDENMASTER, "QueryLvl16Quest", TP);
    if(TP->QueryProp(P_GUILD)=="druidenzirkel" && x>2 &&
        ob=present(TASKITEM, TP))
    {
      obj->remove();
      ob->remove();
      call_other(DRUIDENMASTER, "QueryLvl16Quest", TP);
      call_out("DoLvl16", 4, TP);
      return 1;
    }
  }
  return ::give_notify(obj);
}

nosave int GetLvl16Quest(object pl) {
  object amulett;
  amulett=present("\ndruidenamulett", pl);
  if(ENV(pl)!=ENV(ME)) return 0;
  
  tell_object(pl, BSA("Gut. Nun hast Du Dich als wuerdig erwiesen, Du bist "
      "bereit fuer die grosse Aufgabe. Ich werde sie Dir nur ein einziges "
      "Mal nennen: Es existiert ein magisches Armband, welches unter anderem "
      "die Faehigkeit der Dimensionreise besitzt, wenn auch nur als "
      "unerwuenschter Nebeneffekt. Das Armband schimmert in einem hellen Licht "
      "und besteht zum Grossteil aus Obsidian, daran kannst Du es erkennen. "
      "Leider ist der Aufenthaltsort dieses Armbandes unbekannt, und selbst "
      "die Legenden bieten keinen Aufschluss darueber, wo es sich befindet. " 
      "Es heisst jedoch, dass es einst von diesem Ort gestohlen wurde und "
      "in ein fernes Land gebracht wurde. Dort soll "
      "es von einem maechtigen Waechter beschuetzt werden, der dieses Armband "
      "versteckt bei sich traegt. Leider brauche ich dieses Armband innerhalb "
      "der naechsten vier Tage. Vergiss nicht, Du hast nur diesen einen Versuch. "
      "Solltest Du scheitern, erhaeltst Du erst irgendwann wieder diese "
      "Aufgabe von mir. "
      "Viel Glueck!", "Anvar teilt Dir mit: "));
  call_other(DRUIDENMASTER, "SetLvl16Quest", pl, 3);
  write_file(LOG("lvl16quest"), sprintf("%s: %s bekommt Aufgabe 2!\n",
      dtime(time()), CAP(getuid(pl))));
  amulett->SetProp(E_TIME, time());
  return 1;          
}

int DoLvl16(object pl) {
  string txt;
  txt=sprintf("Welch Unglaubliche Leistung! %s hat es nach langen Muehen "
      +"geschafft, und ist durch ausserordentliche Taten und tapferes "
      +"Handeln auf Gildenstufe SECHSZEHN der Druiden aufgestiegen. Meine "
      +"allerbesten Glueckwuensche!", pl->Name(WER));
  pl->SetProp(P_GUILD_LEVEL, 16);
  pl->SetProp(P_XP, pl->QueryProp(P_XP)+500000); // halbe million xp
  tell_object(pl, BSA("AUSGEZEICHNET! Du hast eine unglaubliche "
      "Leistung vollbracht. Als Dank befoerdere ich Dich auf Gildenstufe "
      "Sechzehn. In dieser Stufe hast Du automatisch und ohne weitere "
      "Kosten die Faehigkeit, die Spellabwehr Deiner Gegner zu senken. Weiters "
      "besitzt Du nun die Faehigkeit, Dein Element zu wechseln. Dazu musst "
      "Du bei den Monolithen, die den Druidenzirkel umgeben, meditieren. "
      "Alle weiteren Vorteile musst Du selber herausfinden, das sollte "
      "jedoch fuer Dich kein Problem sein. Nochmals meine Glueckwuensche!",
      "Anvar teilt Dir mit: "));
  Channel(txt); 
  write_file(LOG("lvl16quest"), sprintf("%s: %s wird Gildenlevel 16!\n",
      dtime(time()), CAP(getuid(pl))));
  return 1;
}


string DruidAmulett() {
 if(TP->QueryProp(P_GUILD)!="druidenzirkel")
   return "Das Amulett ist das Zeichen der Mitgliedschaft "
         +"des Druidenzirkels.";
 if(!present("\ndruidenamulett", TP)) {
   call_out("GiveAmulett",0, TP);
   return "Huch! Du scheinst Dein Amulett verloren zu haben. "
          +"Hier, nimm ein Neues.";
 }
 return "Das Amulett, welches Du traegst, ist ein Zeichen Deiner "
       +"Mitgliedschaft im Druidenzirkel.";
}

string NewAmulett() {
  object ob;
  if(TP->QueryProp(P_GUILD)!="druidenzirkel")
   return "Du bist kein Mitglied im Druidenzirkel.";
  if(!ob=present("\ndruidenamulett", TP)) {
    call_out("GiveAmulett",0, TP);
    return "Huch! Du scheinst Dein Amulett verloren zu haben. "
          +"Hier, nimm ein Neues.";
  }
  ob->SetProp(P_CURSED, 0);
  ob->remove();
  call_out("GiveAmulett",0, TP);
  return "Ein Neues, bitte sehr.";
}


void GiveAmulett(object pl) {
  object ob;
  write("Anvar gibt Dir ein Druidenamulett.\n");
  tell_room(ENV(TP),BS("Anvar gibt "+CAP(getuid(TP))+" ein Amulett.\n"),
             ({TP}));
  call_other(ENV(TO), "UnWearArmour", TP);
  ob=CLONEOB(ARMOUR("d_amulett"));
  ob->move(TP, M_NOCHECK);
  return;
}

string fertigkeiten() {
  call_other(ENV(TO), "faehigkeiten");
  return "";
}



/* SPELLS */


void windhose(object enemy,int damage, mixed dam_type)
{
  int i;
  object *inv;
  inv=PresentEnemies();
  damage=700+random(600);
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Eine Windhose entsteht!\n"));
  for(i=sizeof(inv)-1;i>=0;i--) { 
    if(!IS_WIZARD(inv[i]) && 
      member_array("anvar",inv[i]->QueryProp(P_IDS))==-1 &&
      (inv[i]->QueryProp(ELEMENT_CASTER)!="anvar")) {
        tell_object(inv[i], "Die Windhose von Anvar wirbelt "
         +"Dich herum.\n");
        tell_room(ENV(ME), BS(sprintf("Die Windhose von Anvar "
         +"wirbelt %s umher.\n", CAP(inv[i]->name(RAW)))), ({inv[i]}));
        inv[i]->Defend(damage, dam_type,  
         ([SP_SHOW_DAMAGE:1,SP_NAME:"Windhose"]), this_object()); 
    }
  } 
  return; 
} 

