void laehme(object enemy,int damage, mixed dam_type)
{
 int speed;
 switch(random(10)) {
   case 0:     speed=75; break;
   case 1..4:  speed=50; break;
   case 5..7:  speed=30; break;
   case 8..9:  speed=20; break;
   default: speed=50;
 }
 enemy->ModifySkillAttribute(enemy,SA_SPEED,speed,100);
 return;
}


void elementar(object enemy,int damage, mixed dam_type)
{
 object *inv, l;
 int i, present, kill;
 string file, long;
 mixed hands;
 present=0;
 kill=0;
 //tell_room(ENV(ME), "1\n");
 inv=FindGroupP(TO, 0, 100);
 for (i=sizeof(inv)-1;i>=0;i--) {
  if(member_array("elementar",inv[i]->QueryProp(P_IDS))!=-1 &&
     lower_case(inv[i]->QueryProp(ELEMENT_CASTER))=="anvar")
    present=1;
 }
 if(!present) {
  //tell_room(ENV(ME), "2\n");
  switch(random(5)) {
   case 0: file="e_elementar"; 
          long="Von dem Eiselementar geht eine toetliche Kaelte aus. "
         +"Es besteht vollkommen aus Eis, und wird Anvar "
         +"im Kampf unterstuetzen."; 
          hands=({" mit Eiskrallen ", DT_COLD });
          break;
   case 1: file="w_elementar"; 
          long="Das Elementar ist eine Gestalt aus Wasser, "
                +"zusammengehalten durch ihre immense Macht. "
                +"Es bleibt staendig in der Naehe von Anvar.";
          hands=({" mit einem Wasserstrahl ", DT_WATER });
          break;
   case 2: file="ee_elementar"; 
          long="Von dem Eiselementar geht eine toetliche Kaelte aus. "
         +"Es besteht vollkommen aus Eis, und wird Anvar "
         +"im Kampf unterstuetzen.";
          hands=({" mit scharfen Klauen ", ({DT_BLUDGEON, DT_MAGIC}) });
          break;
   case 3: file="l_elementar"; 
          long="Das Luftelementar gleicht einer "
              +"kleinen Windhose, die staendig in der Naehe "
              +"von Anvar bleibt. Durch "
              +"ihre Anwesenheit weht hier ein starker Wind.";
          hands=({" mit einem Luftstoss ", DT_AIR});
          break;
   case 4: file="f_elementar";  
          long="Das Feuerelementar sieht wie eine riesige, "
         +"flammenumwaberte Gestalt dar. Es bleibt staendig in der "
         +"Naehe von Anvar.";
          hands=({" mit einem Feuerstrahl ", DT_FIRE });
          break;
  }
  //tell_room(ENV(ME), file+"\n");
  l=clone_object(NPC(file));
  l->create_default_npc(23);
  l->SetProp(ELEMENT_DEFENDS, 28);
  l->SetProp(P_LONG, long);
  l->SetProp(P_HANDS, ({hands[0], 200, hands[1]}));
  l->SetProp(P_BODY, 23*5);
  l->SetProp(P_MSGOUT, "folgt "+ME->QueryProp(P_NAME));
  l->SetProp(ELEMENT_CASTER, ME->QueryProp(P_NAME));
  l->SetProp(P_FRIEND, 0);
  l->set_time(TO->QueryAttribute(A_INT)*3+ME->QueryProp(P_GUILD_LEVEL));
  ME->AddDefender(l);
  ME->AddPursuer(l);
  //tell_room(ENV(ME), sprintf("%O\n", l));
  l->move(ENV(ME), M_NOCHECK); 
 }
 else tell_room(ENV(ME), BS("Nichts passiert.\n"));
}

void equip_tel(object enemy,int damage, mixed dam_type)
{
 object *inv;
 int i, nr;
 string where, str, *rooms, *w_rooms;
 if(IS_LEARNER(enemy) || !query_once_interactive(enemy)) return;
 inv=all_inventory(enemy);
 rooms=({});
 w_rooms=({"/d/dschungel/feyaria/felseninsel/room/strand4",
         "/d/gebirge/angrox/room/ebene4/ebene4_x7y4",
         "/d/polar/lamuerte/eishoehle/dorf/rooms/kneipe",
         "/d/ebene/Midas/room/kanal/kanal_g7",
         "/d/ebene/lamuerte/burg/mauer/5x12y",
         "/d/huegelland/feyaria/weg/room/sumpf1",
         "/d/dschungel/feyaria/dorf/room/dorf-016",
         "/d/huegelland/feyaria/weg/room/0515",
         "/d/unterwelt/amazora/dimension/room/kneipe",
         "/d/wasser/stahldorn/knarkh/room/dorf_a7",
         "/d/dschungel/dante/stein/room/stein13",
         "/d/dschungel/dante/stein/room/stein20",
         "/d/dschungel/dante/hoehle/room/farm",
         "/d/kristallwald/sargola/wald/room/huette",
         "/d/ebene/creative/feldlager/room/zelte/a7_a0_g",
         "/d/wasser/woody/fischerdorf/room/hinterhof", 
         "/d/dschungel/feyaria/dorf/room/lich-016"});
 for(i=sizeof(w_rooms)-1;i>=0;i--) {
    if(!catch(call_other(w_rooms[i], "???", 0))) 
      rooms+=({w_rooms[i]});
 }
 enemy->command_me("ziehe alles aus");
 if(enemy->QueryProp(P_WEAPON))
    (enemy->QueryProp(P_WEAPON))->DoUnwield(1);
 for(i=sizeof(inv)-1;i>=0;i--) {
  if(!inv[i]->QueryProp(P_NEVERDROP) && !inv[i]->QueryProp(P_CURSED)
     && !inv[i]->QueryProp(P_NODROP)) {
    nr=random(sizeof(rooms));
    inv[i]->move(rooms[nr], M_NOCHECK|M_SILENT);
    if((inv[i]->QueryProp(P_AMOUNT))>1) str="en";
    else str="t"; 
    tell_room(rooms[nr], sprintf("Ploetzlich materialisier%s sich %s "
          +"im Raum!\n", str, inv[i]->name(WER)));
  }
 }
}


init()
{
 if(QueryProp(P_WIMPY)) SetProp(P_WIMPY, 0);
 ::init();
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if( killer == TO )
    write_file(LOG ("anvar.kills"),
       sprintf( ctime()+": Anvar hat gerade "+CAP(getuid(player))
       +" umgebracht - %d EP!\n", lostexp));
 return ;
}

void die(int poisondeath) {
  object ob;
  if((time()-hb_time)>4) { // dann war der HB wohl weg
    heal_self(3000);
    return; 
  }
  write_file(LOG("anvar.kills"),
      dtime(time())+": "+CAP(getuid(TP))+" toetet Anvar.\n");
  if(ob=present("elementarpanzer", TO))
  ob->panzer_weg(300);
  ::die(poisondeath);
}


