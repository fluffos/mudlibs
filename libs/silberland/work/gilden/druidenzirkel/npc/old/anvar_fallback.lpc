}


void _set_druid_info() {
  mapping druids;
  string *legendary, *names, err;
  string number_one, text;
  int i, gender;
   
  text="%s dient dem Element %O und hat bereits Gildenstufe %O erreicht.";
  druids=call_other(DRUIDENMASTER, "QueryAll");
  number_one=call_other(DRUIDENMASTER, "QueryNumberOne");
  legendary=call_other(DRUIDENMASTER, "QueryLegendary");
  names=m_indices(druids);
  if(!pointerp(names)) return;
  for(i=sizeof(druids)-1;i>=0;i--) {
    if(stringp(druids[names[i],16]) && 
        member(({"angrox", "creative"}),names[i])==-1)
    {
      err=catch(RemoveInfo(names[i]));
      if(err) {
        TELL("angrox", sprintf("Fehler in Anvar, RemoveInfo, name:%s, element:"
              "%s, gstufe:%d, Fehler: %s\n", names[i], capitalize(druids[names[i], 16]), druids[names[i], 1], err));
      }
      err=catch(AddInfo(({names[i]}), sprintf(text, CAP(names[i]), 
            capitalize(druids[names[i], 16]),
               druids[names[i], 1]), "sagt: "));
      if(err) {
        TELL("angrox", sprintf("Fehler in Anvar, AddInfo, name: %s, "
              "Fehler: %s\n", names[i], err));
      }
    }
  }
}

