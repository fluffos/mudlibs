string _query_long()
{
  string s;
  object pl;

  s = "";

  if (objectp(QueryProp(ELEMENTAL_OWNER)) &&
     living(QueryProp(ELEMENTAL_OWNER))   )
  {
    pl = QueryProp(ELEMENTAL_OWNER);

    switch(modus)
    {
      case MOD_NONE:
        s = " Es bleibt staendig in der Naehe von "+pl->Name(RAW)+".";
        break;

      case MOD_KAMPF:
        s = " Es wird "+pl->Name(RAW)+" im Kampf unterstuetzen.";
        break;

      case MOD_VERTEIDIGUNG:
        s = " Es wird "+pl->Name(RAW)+" mit seinem Leben beschuetzen.";
    }
  }

  return BS(long_msg + s);
}

int _set_hp(int hp)
{
  int currenthp, maxhp, itsme;

  itsme = 0;
  if (previous_object(1) == TO) itsme = 1;
  if ((previous_object(0) == TO) && (previous_object(1) == 0) ) itsme = 1;

  currenthp = Query(P_HP);
  maxhp     = Query(P_MAX_HP);

//  DBR(sprintf("HP: %d +/-: %d itsme: %d (%O) (%O)",currenthp, hp, itsme,
//              previous_object(0), previous_object(1)));

  if ((hp > maxhp) || (currenthp > maxhp))
  {
    return Set(P_HP, maxhp);
  }

  if (hp > currenthp)
  {
    if (itsme) return Set(P_HP, hp); else return currenthp;
  }
  else
  {
    return Set(P_HP, hp);
  }
}

void heart_beat()
{
  object room;
  ::heart_beat();

  if (!TO || !(room = ENV(TO))) return;

  if (QueryProp(P_ELEMENT) == FEUER && (
      room->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == TT_UNDERWATER ||
      room->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == TT_WATER))
  {
    AddHp(-10);
    if (QueryProp(P_HP) <= 10)
    {
      SetProp(E_REMOVE_MSG, Name(WER,1) + " verdampft mit "
                          "Schmerzgebruell.\n");
      remove();
    }
  }
}

void init()
{
  object owner, room, caster;

  ::init();

  if (!(room = ENV(TO))) return;

  if (QueryProp(P_ELEMENT) == FEUER && (
      room->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == TT_UNDERWATER ||
      room->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == TT_WATER))
  {
    AddHp(-10);
    if (QueryProp(P_HP) <= 10)
    {
      SetProp(E_REMOVE_MSG, Name(WER,1) + " verdampft mit "
                          "Schmerzgebruell.\n");
      call_out("remove", 0);
    }
    return ;
  }

  if (!QueryProp(ELEMENTAL_OWNER) &&
      sizeof(filter_objects(all_inventory(room),"id",DRUIDENELEMENTAR)) > 10 )
  {
    call_out("remove", 0);
    return;
  }

  if ((caster = QueryProp(ELEMENTAL_CASTER)) && query_once_interactive(caster) &&
     member(users(), QueryProp(ELEMENTAL_CASTER)) == -1)
  {
    call_out("remove",0);
    return;
  }

  if (objectp(owner = QueryProp(ELEMENTAL_OWNER)))
  {
     if (!living(owner))
     {
       call_out("remove",0);
       return;
     }
     owner->AddDefender(TO);
  }
  return;
}

void reset()
{
  if (!is_clone(this_object()))
    return;
  ::reset();
  if (QueryProp(P_FRIEND))
    call_out("remove",0);
}

varargs int remove(int silent)
{
  object caster, owner;
  int xp;

  if (objectp(owner = QueryProp(ELEMENTAL_OWNER)) && living(owner))
  {
    owner->RemovePursuer(ME);
  }
  while (remove_call_out("remove") != -1);

  if (QueryProp(E_REMOVE_MSG) && !silent) 
    tell_room(ENV(TO), BS(QueryProp(E_REMOVE_MSG)));

  if (modus == MOD_KAMPF && objectp(caster = QueryProp(ELEMENTAL_OWNER)) && 
      objectp(owner = QueryProp(ELEMENTAL_CASTER)))
  {
    xp = QueryProp(P_XP) / 100;
    if (caster == owner)
      caster->AddExp((XP_RATIO + caster->QueryProp(P_GUILD_LEVEL)) * xp);
  }
  return ::remove(silent);
}

int PreventFollow(object dest)
{
  object owner;

  if (objectp(owner=QueryProp(ELEMENTAL_OWNER)))
  {
    if (living(owner) && !query_once_interactive(owner))  return 0; //NPC
    if (interactive(owner) && !owner->QueryProp(P_GHOST)) return 0; //spieler
  }

  if (modus != MOD_AGGRESSIV) call_out("remove", 0);
  return 1;
}

void InformDefend(object enemy)
{
  ::InformDefend();

  if (modus != MOD_KAMPF) return;

  Kill(enemy);
}

mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{
  mixed res;
  object owner;
  int my_dam,org_dam,lp;

  if (modus != MOD_VERTEIDIGUNG)                  return 0;
  if (!ENV(TO))                                   return 0;
  if (!objectp(owner=QueryProp(ELEMENTAL_OWNER))) return 0;
  if ((owner->QueryProp(P_ALIGN) >  500) ||
      (owner->QueryProp(P_ALIGN) < -500)  )       return 0;

  if (member(PresentEnemies(), owner) != -1)
  {
    owner->RemoveDefender(TO);
    modus = MOD_NONE;
    return 0;
  }

  my_dam  = 0;
  lp      = 0;
  org_dam = dam;

  if (random(3) && (dam > 50) && member(dam_type, e_dam_type) != -1)
  {
//    tell_room(ENV(TO), BS(Name(WER,1)+" wehrt eine Attacke fuer "+
//                          owner->name(WEN)+" ab!\n"), ({owner}) );
    tell_object(owner, Name(WER,1) + " wehrt eine Attacke fuer Dich ab!\n");
    my_dam = dam / 4;
    dam    = dam / 10;
  }
  // keine Verteidigung gegen gegensaetzliches Element
  else if (random(3) && dam > 100 && member(dam_type, c_dam_type) == -1)
  {
/*  Nicht zuviel Kampfscroll....  
    tell_room(ENV(TO), BS(Name(WER,1)+" schwaecht eine Attacke fuer "+
                          owner->name(WEN)+" ab!\n"), ({owner}) );
*/
    tell_object(owner, Name(WER,1) + " schwaecht eine Attacke fuer Dich ab!\n");
    my_dam = dam / 2;
    dam   -= my_dam;
  }

  if (my_dam > 0)
  {
    lp = (my_dam - random(QueryProp(P_BODY))) / 8;
    if (lp > 0) do_damage(lp);
  }

//DBR(sprintf("%s Schaden: %d - %d = %d => %d => %d",Name(WER,1),org_dam,my_dam,dam,lp,QueryProp(P_HP)));

  return ({dam, dam_type, spell});
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object owner;

  if (modus != MOD_AGGRESSIV && modus != MOD_AGGRESSIV_OTHER && enemy && 
      interactive(enemy))
  {
    owner = QueryProp(ELEMENTAL_OWNER);
    if (objectp(owner) && interactive(owner) &&
        !call_other("/obj/pkmaster", "PK_allowed", environment(enemy), enemy, owner))
    {
      tell_object(enemy, "Du kannst " + name(WEN,1) + " nicht toeten, denn "
          "es gehorcht " + ( enemy == owner ? "Dir" : owner->name(WEM,1)) + "!\n");
      enemy->StopHuntFor(TO, 1);
      StopHuntFor(enemy, 1);
      return 0;
    }
    else
    {
      if (owner == enemy)
      {
        modus = MOD_AGGRESSIV;
        meine_dienste = ([ ]);
      }
      else 
        modus = MOD_AGGRESSIV_OTHER;
      Kill(enemy);
    }
  }

  if (modus != MOD_KAMPF && modus != MOD_AGGRESSIV && modus != MOD_AGGRESSIV_OTHER)
  {
    enemy->StopHuntFor(TO, 1);
    StopHuntFor(enemy, 1);
    WLOG ( LOG ("elemental_attack"), 
        sprintf(": %s darf nicht angegriffen werden! MODUS = %d", 
          Name(WER,1), modus) );
    return 0;
  }

  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int hit,r;

  if (modus != MOD_KAMPF && modus != MOD_AGGRESSIV && modus != MOD_AGGRESSIV_OTHER)
  {
    WLOG ( LOG ("elemental_attack"), 
        sprintf(": %s darf nicht angreifen! MODUS = %d", 
          Name(WER,1), modus));
    enemy->StopHuntFor(TO, 1);
    StopHuntFor(enemy, 1);
    return;
  }

  ::Attack(enemy);

  r = random(6) + 6;
  hit = strength / r;

//DBR(sprintf("apool %d strength %d hit %d r %d \n",apool,strength,hit,r));

  apool -= hit;

  if (apool <= 0) call_out("remove", 0);
}

varargs void Customize(string element, object caster, int success, int level, int noname)
{
  int hands,align,skill, index;
  string *s, *names;
  string caster_element, adj;
  object ob;
  mapping elemental_adj;

  if (!objectp(caster) || (!living(caster))) return;

  /*if (caster->QueryProp(P_GUILD) != "druidenzirkel")
  {
    call_out("remove", 0);
    return;
  }*/

  if (!(element == WASSER  ||
       element == EIS     ||
       element == FEUER   ||
       element == LUFT    ||
       element == HUMUS   ||
       element == ERZ     ))
  {
    call_out("remove", 0);
    raise_error("ungueltiges element");
    return;
  }

  if (success < 0)                  success = MAX_ABILITY;
  else if (success > 2*MAX_ABILITY) success = 2*MAX_ABILITY;

  AddId( ({element+"elementar" }) );

  AddInfo(({"dienst", "dienste"}), "@@dienste_info@@","sagt: ");

  meine_dienste = alle_dienste[element, 0] + alle_dienste["spezial", 0];

  if (DRUIDENMASTER->GetDruidElement(caster) == element)
  {
    s = explode(meine_dienste["z_enhance", KEY_TEXT], "*");
    meine_dienste["z_enhance",KEY_TEXT] = s[0] + CAP(element) + s[1];
  }
  else
  {
    meine_dienste["z_enhance",KEY_STATUS] = 0;
  }

  if (!level)
  {
    // Level des Elementars haengt primar von der Gildenstufe ab
    level  = caster->QueryProp(P_GUILD_LEVEL) - 10; // LVL  0 .. +6
    // und von der Spielerstufe
    level  += caster->QueryProp(P_LEVEL) / 10;      // LVL +3 .. +8
    // und vom Erfolg des Zaubers
    level += success / 2500;                        // LVL  0 .. +7

    align = caster->QueryProp(P_ALIGN);
    if (align < 0)   align = -align;
    // Je neutraler, desto staerker
    if (align < 600) level += random(7-(align/100)); // LVL  0 .. 6

    // Je nach den Rassen-vorlieben fuer bestimmte Elemente +1 oder -1
    switch (caster->QueryProp(P_RACE))              // LVL -1 .. +1
    {
      case "Gaffo":
        if(member(E_GAFFO[0],element) != -1) level += 1;
        else if(member(E_GAFFO[1],element) != -1) level -= 1;
        break;
      case "Fee":
        if(member(E_FAIRY[0],element) != -1) level += 1;
        else if(member(E_FAIRY[1],element) != -1) level -= 1;
        break;

      case "Mensch" :
        if(member(E_HUMAN[0],element) != -1) level += 1;
        else if(member(E_HUMAN[1],element) != -1) level -= 1;
        break;

      case "Elf" :
        if(member(E_ELF[0],element) != -1) level += 1;
        else if(member(E_ELF[1],element) != -1) level -= 1;
        break;

      case "Zwerg" :
        if(member(E_DWARF[0],element) != -1) level += 1;
        else if(member(E_DWARF[1],element) != -1) level -= 1;
        break;

      case "Hobbit" :
        if(member(E_HOBBIT[0],element) != -1) level += 1;
        else if(member(E_HOBBIT[1],element) != -1) level -= 1;
        break;

      case "Dunkelelf" :
        if(member(E_DARKELF[0],element) != -1) level += 1;
        else if(member(E_DARKELF[1],element) != -1) level -= 1;
        break;

      case "Oger" :
        if(member(E_OGRE[0],element) != -1) level += 1;
        else if(member(E_OGRE[1],element) != -1) level -= 1;
        break;

      default :
        if(member(E_DEFAULT[0],element) != -1) level += 1;
        else if(member(E_DEFAULT[1],element) != -1) level -= 1;
    }

    if (interactive(caster))
    {
      // Wenn man den Zauberspruch perfekt kann, wird das Elementar besser
      if (caster->QuerySkill(element+"elementar") &&
          (skill = caster->QuerySkill(element+"elementar")[SI_SKILLABILITY]) == MAX_ABILITY)
        level += 1 + random(3);                     // LVL  0 .. 3

      caster_element = call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster));
      // Geist-Druiden haben einen kleinen Bonus bei allen Elementaren
      if (caster_element == GEIST)                 // LVL -1 .. 2
        level += random(2);
      // Andere +2 nur fuer eigenes Element
      else if (caster_element == element)
        level += 2;
      // dafuer aber auch -1 beim entgegengesetzem Element
      else if (caster_element != GEIST && COMPLEMENT_ELEMENTS[caster_element] == element)
        level -= 1;
      // Ein Elementarring erhoeht die Stufe auch
      if (objectp(ob = present(ELEMENT_RING_ + element, caster)) && 
          ob->check_equip_time())                   // LVL  0 .. 2
        level += 1 + random(2);
      // Legendaere Druiden haben noch einen zusaetzlichen Bonus
      if( member( call_other(DRUIDENMASTER, "QueryLegendary"), getuid(caster)) != -1 )
        level += 1 + random(2);                     // LVL  0 .. 2
    }
    else
      level += random(caster->QueryProp(P_LEVEL) / 5);
    // Ein aktiver Fokus erhoeht die Stufe auch
    if (objectp(ob = present(DRUIDEN_FOCUS + element, caster))) 
    {
      write_file(LOG("focus.log"), sprintf("%s: %O (%s) old lvl: %d, ",
            dtime(time()),caster,element,level));  
      level += (ob->QueryVariables()[1] + 1) / 3 + 
        random(ob->QueryVariables()[1]);            // LVL 0 .. 6
      write_file(LOG("focus.log"), sprintf("new lvl: %d\n",level));
    }
    // Hohe Intelligenz macht das Elementar staerker
    if (caster->QueryAttribute(A_INT) > 30)         // LVL 0 .. 9
      level += random(caster->QueryAttribute(A_INT) - 30);
  }
  if (level < 10) level = 10;
  if (level > 30) level = 30;
  
  elemental_adj = ([
      "default":"mickrig"; "winzig"; "sehr klein"; "klein";
                "gross"; "sehr gross"; "extrem gross";
                "riesig"; "maechtig"; "gigantisch"; "ultimativ", 
      LUFT:   "erstickend"; "roechelnd"; "boeig"; "pfeifend"; 
                "wehend"; "singend"; "brausend"; 
                "tosend"; "stuermend"; "donnernd"; "fauchend",
      ERZ:    "zerfallend"; "broeckelnd"; "sehr weich"; "weich";
                "hart"; "sehr hart"; "extrem hart";
                "stampfend"; "schlagend"; "droehnend"; "wuetend",
      WASSER: "zerfliessend"; "blubbernd"; "schluckend"; "gurgelnd";
                "wellig"; "nass"; "fliessend";
                "rauschend"; "wild"; "peitschend"; "flutend",
      HUMUS:  "modernd"; "krank"; "stinkend"; "sabbernd";
                "lebend"; "wachsend"; "heilend";
                "stachelig"; "dornig"; "dornenbewachsen"; "vergiftend",
      EIS:    "schmelzend"; "schwitzend"; "tropfend"; "flockig";
                "kuehlend"; "kalt"; "eiskalt";
                "klirrend"; "frostig"; "gefrierend"; "blitzend",
      FEUER:  "rauchend"; "schlotternd"; "flackernd"; "leuchtend"; 
                "waermend"; "flammend"; "heiss";
                "gluehend"; "sengend"; "verbrennend"; "pulsierend",
           ]);

  index = -1;
  switch (level)
  {
    case 0..11:  index = 0; break;
    case 12..13: index = 1; break;
    case 14..15: index = 2; break;
    case 16..17: index = 3; break;
    case 21..22: index = 4; break;
    case 23..24: index = 5; break;
    case 25..26: index = 6; break;
    case 27: index = 7; break;
    case 28: index = 8; break;
    case 29: index = 9; break;
    case 30: index = 10; break;
  }
  if (index != -1)
  {
    adj = elemental_adj[(random(3)?element:"default"),index];
  }
  if (!noname)
  {
    if (level >= 27 && !random(35 - 5 * (level - 27)))
    {
      names = ELEMENTAL_NAMES[element];
      SetProp(P_NAME, names[random(sizeof(names))]);
      AddId( ({lower_case(QueryProp(P_NAME)), NAMED_DRUIDE_ELEMENTAR}) );
      SetProp(P_ARTICLE, 0);
      SetProp(P_SHORT, Name()+", das "+adj+"e "+CAP(element)+"elementar");
      level += 2 + random(4);
      meine_dienste = m_delete(meine_dienste, "z_weggeben");
    }
    else
    {
      if (adj)
      {
        SetProp(P_NAME_ADJ, adj);
        AddAdjective( ({adj, adj+"es", adj+"en"}) );
      }
      SetProp(P_NAME, CAP(element)+"elementar");
      SetProp(P_SHORT, Name(WER,0));
    }
  }
  else if (!QueryProp(P_ARTICLE))
    meine_dienste = m_delete(meine_dienste, "z_weggeben");

  SetProp(P_KILL_NAME, Name(WER,0));

  create_default_npc(level);
//hands    = QueryProp(P_HANDS)[1];
//hands    = level * 12; 
  hands    = level * 6 + level * 6 * skill / MAX_ABILITY;
  strength =  (2 * hands + 10 * QueryAttribute(A_STR)) / 3;
  apool    = 2 * QueryProp(P_SP);

  SetProp(ELEMENTAL_CASTER, caster);
  SetProp(P_FRIEND, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_XP, 0);
  SetProp(P_LIGHT, 0);
  SetProp(P_ELEMENT, element);
  SetProp(P_NOMAGIC, level - 10);
  SetProp(P_SIZE, 40 + level * 10 + random(21));

  switch (element)
  {
    case LUFT:
      long_msg = "Das Luftelementar sieht wie eine kleine Windhose aus. "
                 "Durch seine rapiden Drehungen verursacht es einen starken "
                 "Wind.";

      SetProp(P_HANDS, ({" mit einem Windstoss", hands, DT_AIR}));

      SetProp(P_MSGIN, "weht herein");
      SetProp(P_MSGOUT, "weht");
      SetProp(P_MMSGOUT, "fliegt tosend weg");
      SetProp(P_MMSGIN, "fliegt mit Sturmgebruell herein");

      SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");

      AddProp(P_RESISTANCE_STRENGTHS,
        ([DT_SLASH:    1.0,
          DT_BLUDGEON: 2.0,
          DT_PIERCE:   1.0,
          DT_SQUEEZE:  1.0,
          DT_WHIP:     1.0,
          DT_RIP:      1.0,
          DT_AIR:     -1.0,
          DT_SOUND:    1.0,
          DT_MAGIC:    2.0,
         ])
      );

      SetProp(P_MATERIAL, ([MAT_AIR:100]) );
      SetProp(E_REMOVE_MSG, Name(WER,1)+" loest sich auf.\n");
      SetProp(P_SOUND, Name(WER,1)+" tost wie ein gewaltiger Sturm.\n");
      SetProp(P_WEIGHT, 5000);

      break;

    case WASSER:
      long_msg = "Das Wasserelementar sieht wie eine gewaltige, aus "
                 "durchscheinendem Wasser gebildete Gestalt aus. In seiner "
                 "Naehe ist das Rauschen des Meeres zu hoeren. Es ist etwa "+
                 ({"","ein", "zwei", "drei", "vier", "fuenf"})[(level + 5) / 10]+
                 " Schritt hoch.";

      SetProp(P_HANDS, ({" mit einer Flutwelle", hands, DT_WATER}));

      SetProp(P_MSGIN, "fliesst herein");
      SetProp(P_MSGOUT, "fliesst");
      SetProp(P_MMSGOUT, "versickert im Erdboden");
      SetProp(P_MMSGIN, "entsteht aus der Luftfeuchtigkeit");

      SetProp(P_DIE_MSG, " zerrinnt.\n");
      AddId("WATERBREATH");

      AddProp(P_RESISTANCE_STRENGTHS,
        ([DT_WATER:    -1.0,
          DT_FIRE:      3.0,
          DT_ELECTRIC:  1.0,
          DT_LIGHTNING: 1.0,
         ])
      );

      SetProp(P_MATERIAL, ([MAT_WATER:100]) );

      SetProp(E_REMOVE_MSG, Name(WER,1)+" zerfliesst.\n");
      SetProp(P_SOUND,Name(WER,1)+"rauscht wie ein Meer im Sturm.\n");
      SetProp(P_WEIGHT, 75000);

      SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-500,T_RANGE_MAX:50]));

      break;

    case ERZ:
      long_msg = "Das Erzelementar ist eine Gestalt aus reinstem Erz, mit "
                 "rubinernen Augen und Gold als Haaren. Durch seine Adern "
                 "fliesst reinstes Quecksilber.";

      SetProp(P_HANDS, ({" mit staehlerner Faust", hands, ({DT_MAGIC,DT_BLUDGEON}) }) );

      SetProp(P_MSGIN, "stapft herein");
      SetProp(P_MSGOUT, "stapft schweren Schrittes");
      SetProp(P_MMSGOUT, "verschwindet im Erdboden");
      SetProp(P_MMSGIN, "entsteigt der Erde");

      SetProp(P_DIE_MSG, " verschwindet in der Erde.\n");

      AddProp(P_RESISTANCE_STRENGTHS,
        ([DT_SLASH:    -0.7,
          DT_BLUDGEON: -0.7,
          DT_PIERCE:   -0.7,
          DT_SQUEEZE:  -0.7,
          DT_WHIP:     -0.7,
          DT_RIP:      -0.7,
          DT_AIR:       3.0,
          DT_ACID:      1.0,
         ])
      );

      SetProp(P_MATERIAL, ([MAT_STONE:100]) );

      SetProp(E_REMOVE_MSG, Name(WER,1)+" verschwindet im Boden.\n");
      SetProp(P_SOUND,Name(WER,1)+" rumpelt wie ein Erdbeben.\n");
      SetProp(P_WEIGHT, 180000);

      break;

    case FEUER:
      long_msg = "Das Feuerelementar sieht wie eine gewaltige, "
                 "flammenumwaberte Gestalt aus. Es ist etwa "+
                 ({"","ein", "zwei", "drei", "vier", "fuenf"})[(level + 5) / 10]+
                 " Schritt hoch und es strahlt eine enorme Hitze ab.";

      SetProp(P_HANDS, ({" mit Feuerhaenden", hands, DT_FIRE}));

      SetProp(P_MSGIN, "schwebt herein");
      SetProp(P_MSGOUT, "brennt sich seinen Weg");
      SetProp(P_MMSGOUT, "verschwindet in einer Flammensaeule");
      SetProp(P_MMSGIN, "materialisiert sich in einer Flammensaeule");

      SetProp(P_DIE_MSG, " erlischt.\n");

      AddProp(P_RESISTANCE_STRENGTHS,
        ([DT_FIRE: -1.0,
          DT_WATER: 3.0,
          DT_COLD:  1.0,
         ])
      );

      SetProp(P_MATERIAL, ([MAT_FIRE:100]) );

      SetProp(E_REMOVE_MSG, Name(WER,1)+" loest sich auf.\n");
      SetProp(P_SOUND, Name(WER,1)+" rauscht wie ein Waldbrand.\n");
      SetProp(P_LIGHT, 1);
      SetProp(P_WEIGHT, 1000);

      break;

    case EIS:
      long_msg = "Das Eiselementar ist eine gewaltige, "+
                 ({"","ein", "zwei", "drei", "vier", "fuenf"})[(level + 5) / 10]+
                 " Schritt hohe Gestalt aus purem Eis, von der eine "
                 "toedliche Kaelte ausgeht.";

      SetProp(P_HANDS, ({" mit eisiger Kaelte", hands, DT_COLD}));

      SetProp(P_MSGIN, "stapft herein");
      SetProp(P_MSGOUT, "verbreitet seine Kaelte");
      SetProp(P_MMSGOUT, "verschwindet in eisiger Kaelte");
      SetProp(P_MMSGIN, "materialisiert sich aus der Kaelte");

      SetProp(P_DIE_MSG, " zerrinnt.\n");

      AddProp(P_RESISTANCE_STRENGTHS,
        ([DT_COLD:  -1.0,
         DT_FIRE:    1.0,
         DT_POISON:  3.0,
        ])
      );

      SetProp(P_MATERIAL, ([MAT_ICE:100]) );

      SetProp(E_REMOVE_MSG, Name(WER,1)+" zerfliesst.\n");
      SetProp(P_SOUND, Name(WER,1)+" knistert leise wie Eisschollen.\n");
      SetProp(P_WEIGHT, 50000);

      SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-500,
                                     T_RANGE_MAX:10 + QueryProp(P_LEVEL) / 2]));

      break;

    case HUMUS:
      long_msg = "Das Humuselementar besteht vollkommen aus Erde, Laub und "
                 "Dornenranken. Eine eigentuemliche Kraft des Lebens geht "
                 "von ihm aus, ja Du spuerst diese Kraft sogar.";

      SetProp(P_HANDS, ({" mit Giftstacheln", hands, DT_POISON }) );

      SetProp(P_MSGIN, "stapft herein");
      SetProp(P_MSGOUT, "stapft");
      SetProp(P_MMSGOUT, "verschwindet im Erdboden");
      SetProp(P_MMSGIN, "entsteigt der Erde");

      SetProp(P_DIE_MSG, " verschwindet in der Erde.\n");

      AddProp(P_RESISTANCE_STRENGTHS,
        ([DT_POISON: -1.0,
          DT_COLD:    3.0,
          DT_TERROR:  1.0,
         ])
      );

      SetProp(P_MATERIAL, ([MAT_EARTH:100]) );

      SetProp(E_REMOVE_MSG, Name(WER,1)+" verschwindet im Boden.\n");
      SetProp(P_SOUND, Name(WER,1)+" raschelt wie ein Haufen Laub.\n");
      SetProp(P_WEIGHT, 40000);

      break;
  }

  e_dam_type = ELEMENT_DAMAGE[element];
  c_dam_type = ELEMENT_DAMAGE[COMPLEMENT_ELEMENTS[element]];


}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  return;
}

void BecomesNetDead(object ob)
{
  if ((ob == QueryProp(ELEMENTAL_OWNER)) && 
      (modus != MOD_AGGRESSIV && modus != MOD_AGGRESSIV_OTHER))
  {
    remove();
  }
}

void BecomesNetAlive(object ob)
{
//DBR(sprintf("%O %O %d",ob,QueryProp(ELEMENTAL_OWNER),modus));
  if ((modus == MOD_AGGRESSIV) && (ob == QueryProp(ELEMENTAL_OWNER)))
  {
    ob->AddPursuer(TO);
    Kill(ob);
  }
}

void die(int poisondeath)
{
  SetProp(E_REMOVE_MSG, 0);
  ::die(poisondeath);
}

//**************************************************************************
//**************************************************************************
//
// Dienstefunktionen Luft
//
//**************************************************************************
//**************************************************************************

int luft_magie(object caster, string *arg)
{
  int vorher, nachher, luft;


  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == LUFT)
    luft = 3;
  else
    luft = 1;
  vorher  = caster->QueryProp(P_SP);
  nachher = caster->QueryProp(P_MAX_SP) - random(20 / luft);

  WriteLog(sprintf("Heilung von %d auf %d",vorher,nachher));
  PayForService(0);

  Tell("Sehr wohl, Meister. Euer Wunsch ist mein Befehl.");

  Effect(caster,
         "Das Luftelementar beginnt sich immer schneller um Dich zu "
         "drehen, bis es schliesslich vor Deinen Augen verschwimmt. Du "
         "fuehlst ploetzlich maechtige Magie durch Dich fliessen."
         ,
         "Das Luftelementar beginnt sich um "+caster->name(WEN)+" zu "
         "drehen, bis es schliesslich vor Deinen Augen verschwimmt. "+
         caster->Name(WER)+" scheint nun maechtiger zu sein!"
  );

  caster->SetProp(P_SP, nachher);
  caster->AddHp(-random((45 - QueryProp(P_LEVEL)) / luft));

  call_out("remove", 0);
  return 1;
}

int luft_bringen(object caster, string *arg)
{
  object recipient, item;
  int fix_kosten, var_kosten, tot_kosten;
  string* ignore;

  recipient = find_player(lower_case(arg[0]));

  if (!recipient)
  {
    Tell("Meister, ich denke ein Spieler namens \""+arg[0]+"\" "
         "existiert nicht!");
    return 0;
  }

  if (recipient->QueryProp(P_INVIS))
  {
    Tell("Meister, ich denke ein Spieler namens "+arg[0]+"\" "
         "existiert nicht!");
    return 0;
  }

  if (IS_LEARNER(recipient))
  {
    Tell("Einem Magier kann ich nichts bringen!");
    return 0;
  }

  if (pointerp(ignore = recipient->QueryProp(P_IGNORE)) &&
        (member(ignore, "luftelementar.bringen") != -1 ||
        member(ignore, "luftelementar.bringen." + getuid(caster)) != -1))
  {
    Tell("Meister, "+recipient->name(WER)+" moechte nichts geschickt "
         "bekommen.");
    return 0;
  }

  if (member(({NO_TPORT_OUT, NO_TPORT}),ENV(TO)->QueryProp(P_NO_TPORT)) != -1 ||
      MENV->QueryProp(P_NOMAGIC))
  {
    Tell("Meister, von hier aus kann ich nichts transportieren.");
    return 0;
  }

  if (ENV(recipient) && member(({NO_TPORT_IN, NO_TPORT}), 
        ENV(recipient)->QueryProp(P_NO_TPORT)) != -1)
  {
    Tell("Meister, ich kann den Gegenstand nicht in diese "
         "Gegend transportieren. Eine magische Macht haelt mich davon "
         "ab!");
    return 0;
  }

  if (!(item = present(lower_case(arg[1]), caster)))
  {
    Tell("Meister, Ihr habt nichts dergleichen!");
    return 0;
  }

  if (item->id("jojo")) {
    Tell("Meister, das geht nicht!");
    return 0;
  }

  fix_kosten = meine_dienste["luft_bringen",KEY_SP];
  var_kosten = item->QueryProp(P_TOTAL_WEIGHT) / 100;
  tot_kosten = var_kosten + fix_kosten;

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == LUFT)
    tot_kosten -= tot_kosten / 10;

  if (caster->QueryProp(P_SP) < tot_kosten)
  {
    Tell("Meister, Ihr seid nicht maechtig genug!");
    return 0;
  }

  if (item->QueryProp(P_REQUESTED_AMOUNT) > 1)
  {
    Tell("Meister, ich kann immer nur einen Gegenstand auf einmal "
         "transportieren!");
    return 0;
  }

  if (item->QueryProp(P_CONTAINER) && sizeof(all_inventory(item)))
  {
    Tell("Meister, ich kann immer nur einen Gegenstand auf einmal "
         "transportieren!");
    return 0;
  }

  if (item->QueryProp(P_AUTOLOADOBJ) ||
      item->QueryProp(P_NODROP)      ||
      item->QueryProp(P_NEVERDROP)   ||
      item->QueryProp(P_CURSED)       )
  {
    Tell("Meister, diesen Gegenstand kann ich nicht transportieren!");
    return 0;
  }

  WriteLog(sprintf("sendet %s zu %s in %s (%d MP)",
        file_name(item), getuid(recipient), file_name(ENV(recipient)), tot_kosten));

  PayForService(var_kosten);

  item->move(TO,M_NOCHECK|M_SILENT|M_GIVE);

  Tell("Meister, euer Wunsch ist mir Befehl.");

  Effect(caster,
         item->Name(WER)+" materialisiert sich im Luftelementar."
         ,
         "Ploetzlich materialisiert sich "+item->name(WER)+" im "
         "Luftelementar."
  );

  call_out("luft_bringen_2", 4, caster,recipient,item,tot_kosten);
  return 1;
}

void luft_bringen_2(object caster, object recipient, object item, int tot_kosten)
{
  caster->RemovePursuer(TO);

  Effect(caster,
    "Das Luftelementar fliegt mit Sturmgebruell davon."
    ,
    "Das Luftelementar fliegt mit Sturmgebruell davon."
  );

  TO->move("/room/npcasylraum", M_GO|M_NOCHECK|M_SILENT);

  call_out("luft_bringen_3", 2 * random(5) + 20, caster, recipient, item, tot_kosten);
  return;
}

void luft_bringen_3(object caster, object recipient, object item, int tot_kosten)
{
  int sp;

  if (!recipient || !interactive(recipient))
  {
    call_out("luft_bringen_4", 0, caster,recipient,item, tot_kosten);
    return;
  }

  TO->move(ENV(recipient), M_GO|M_NOCHECK|M_SILENT);

  Effect(recipient,
    "Ein Luftelementar fliegt mit Sturmgebruell herein."
    ,
    "Ein Luftelementar fliegt mit Sturmgebruell herein."
  );

  if (!item)
  {
    Tell("Ich sollte Euch etwas bringen, aber es ist auf seltsame weise "
        "verschwunden!");
    call_out("luft_bringen_4", 2, caster,recipient,item, tot_kosten);
    return;
  }
  
  if (caster->QueryProp(P_GENDER) == FEMALE)
  {
    Tell("Meine Meisterin "+caster->name(WER)+" schickt Euch "+
         item->name(WEN,0)+", "+recipient->name(WER)+"!");
  }
  else
  {
    Tell("Mein Meister "+caster->name(WER)+" schickt Euch "+
         item->name(WEN,0)+", "+recipient->name(WER)+"!");
  }

  if (item->move(recipient,M_GIVE) != 1)
  {
    Tell("Ihr seid ein Schwaechling, "+recipient->name(WER)+"!");
    item->move(ENV(recipient),M_PUT|M_NOCHECK);
  }

  if ((sp = recipient->QueryProp(P_SP)) < tot_kosten)
  {
    Tell("Ihr habt zu wenig Magiepunkte, "+recipient->name(WER)+"! Aber ich "
         "nehme auch Lebenspunkte!");
    recipient->AddSp(-sp);
    recipient->AddHp(-tot_kosten+sp);
  }
  else
  {
    recipient->AddSp(-tot_kosten);
  }

  call_out("luft_bringen_4", 2, caster,recipient,item, tot_kosten);
  return;
}

void luft_bringen_4(object caster,object recipient,object item, int tot_kosten)
{

  if (!caster || !interactive(caster))
  {
    remove();
    return;
  }

  Effect(recipient,
    "Das Luftelementar fliegt mit Sturmgebruell davon."
    ,
    "Das Luftelementar fliegt mit Sturmgebruell davon."
  );

  TO->move(ENV(caster), M_GO|M_NOCHECK|M_SILENT);

  Effect(caster,
    "Das Luftelementar fliegt mit Sturmgebruell herein."
    ,
    "Das Luftelementar fliegt mit Sturmgebruell herein."
  );

  if (!item)
  {
    Tell("Meister, Euer Gegenstand hat sich in Luft aufgeloest!");
    call_out("remove",0);
    return;
  }

  if (!present(item, TO))
  {
    Tell("Meister, ich habe Euren Auftrag erfuellt!");
    call_out("remove",0);
    return;
  }

  Tell("Meister, ich habe Euren Auftrag nicht erfuellen koennen!");

  if (item->move(caster,M_GIVE) != 1)
  {
    Tell("Ihr sein ein Schwaechling, Meister!");
    item->move(ENV(caster),M_PUT|M_NOCHECK);
  }

  call_out("remove",0);
  return;
}

int luft_fliegen(object caster, string *arg)
{
  mapping ziele;
  string target;
  int fix_kosten, var_kosten, tot_kosten;

  ziele = LUFT_ZIELE;

  if (!ENV(TO)) return 0;

  if (MENV->QueryProp(P_INDOORS))
  {
    Tell("Meister! Ich kann Euch hier nicht befoerdern! Ich "
         "kann Euch nur im freien Gelaende befoerdern!");
    return 0;
  }

  if (member(({NO_TPORT_OUT, NO_TPORT}), MENV->QueryProp(P_NO_TPORT)) != -1 ||
      MENV->QueryProp(P_NOMAGIC))
  {
    Tell("Meister, hier haelt mich eine magische Macht fest. Ich "
         "kann Euch nicht transportieren.");
    return 0;
  }

  fix_kosten = meine_dienste["luft_fliegen",KEY_SP];
  var_kosten = caster->QueryProp(P_TOTAL_WEIGHT) / 1000;
  tot_kosten = fix_kosten + var_kosten;

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == LUFT)
    tot_kosten -= tot_kosten / 10;

  if (caster->QueryProp(P_SP)< tot_kosten)
  {
    Tell("Meister, Ihr seid nicht maechtig genug! Ich kann "
         "Euch nirgends hinfliegen!");
    return 0;
  }

  if (!member(ziele,arg[0]))
  {
    Tell("Meister, ich weiss nicht wo das ist!");
    return 0;
  }

  target = ziele[arg[0]][random(sizeof(ziele[arg[0]]))];

  WriteLog(sprintf("fliegt nach %s (%d MP)",target, tot_kosten));
  PayForService(var_kosten);

  Tell("Meister, macht Euch bereit!");

  call_out("luft_fliegen_2", 2, caster, target);

  return 1;
}

void luft_fliegen_2(object caster, string target)
{
  caster->SetProp("destination",target);

  Effect(caster,
         ""
         ,
         "Das Luftelementar schnappt "+caster->name(WEN)+" und fliegt mit "+
         caster->QueryPronoun(WEM)+" davon."
  );

  caster->move(DRUIDEN("room/himmel:"+getuid(caster)), M_GO,
      "mit dem Luftelementar davon", "fliegt", "fliegt mit dem "
      "Luftelementar davon");
  SetProp(E_REMOVE_MSG, "");

  call_out("remove",0);
  return;
}

int luft_muedigkeit(object caster, string *arg)
{
  if (caster->QueryProp(P_MV) >= caster->QueryProp(P_MAX_MV) / 2)
  {
    Tell("Meister, Ihr seid ja gar nicht muede.");
    return 0;
  }

  WriteLog("");
  PayForService(0);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Dein Luftelementar wirbelt einmal um Dich herum und loest sich "
         "dann auf. Durch die frische Brise ist Deine Muedigkeit "
         "vollkommen verschwunden."
         ,
         "Das Luftelementar von "+caster->name(WEM)+" wirbelt einmal um "+
         caster->QueryPronoun(WEN)+" herum und loest sich dann auf. "+
         caster->Name(WER)+" schaut nun gar nicht mehr muede aus."
  );

  caster->SetProp(P_MV, caster->QueryProp(P_MAX_MV));

  call_out("remove",0);
  return 1;
}

int luft_fluegel(object caster, string *arg)
{
  object ob;
  int val;

  if ((((ob = present(WINGS, caster))) && ob->query_duration() > 100) ||
      caster->is_class_member(CL_FLYING))
  {
    Tell("Meister, Ihr habt ja schon Fluegel.");
    return 0;
  }

  WriteLog("");
  PayForService(0);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Dein Luftelementar wirbelt einmal um Dich herum und loest sich "
         "dann auf. Ploetzlich hebst Du vom Boden ab und schwebst mitten in "
         "der Luft."
         ,
         "Das Luftelementar von "+caster->name(WEM)+" wirbelt einmal um "+
         caster->QueryPronoun(WEN)+" herum und loest sich dann auf.\n"+
         caster->Name(WER)+" schwebt ploetzlich in der Luft."
  );

  
  val = (QueryProp(P_LEVEL) + random(6)) * 10;
  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == LUFT)
    val *= 2;
  if (strstr(file_name(ENV(caster)), SPECIAL_WINGS) != -1)
    val *= 10;


  if (!ob = present(WINGS, caster))
  {
    ob = clone_object(WINGS_OBJ);
    ob->move(caster, M_NOCHECK);
  }
  ob->fliegen(caster, val);

  call_out("remove",0);
  return 1;
}

//**************************************************************************
//**************************************************************************
//
// Dienstefunktionen Feuer
//
//**************************************************************************
//**************************************************************************

int feuer_schutz(object caster, string *arg)
{
  object ob;
  int val, prot_time, feuer;

  if (present("\ntempschutz", caster))
  {
    Tell("Meister, Ihr habt schon einen Temperaturschutz!");
    return 0;
  }
  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == FEUER)
    feuer = 12;
  else
    feuer = 5;

  val = feuer + QueryProp(P_LEVEL) / 4;
  prot_time = 90 * feuer + 15 * caster->QueryProp(P_GUILD_LEVEL) + 
    random(5 * feuer * QueryProp(P_LEVEL));

  // ist es ein Raum, in dem der hitzeschutz viel besser wirken soll?
  if (strstr(file_name(ENV(caster)), SPECIAL_HEAT_PROTECTION) != -1)
  {
    val *= 4;
    prot_time *= 4;
  }
  
  WriteLog(sprintf("Hitzeschutz: %d fuer %d sec",val, prot_time));
  PayForService(0);

  ob = clone_object(DRUIDEN("obj/tempschutz"));
  ob->SetVariables(([T_HEAT_PROT: val, T_COLD_PROT:0]), prot_time);
  ob->move(caster,M_NOCHECK);
  ob->DoWear(1);

  Tell("Ich werde Euch schuetzen, Meister!");

  Effect(caster,
         "Das Feuerelementar bildet eine feurige Aura um Dich. Du bist nun "
         "gegen hohe Temperaturen geschuetzt."
         ,
         "Das Feuerelementar bildet eine feurige Aura, die "+
         caster->name(WEN)+" umgibt."
  );

  call_out("remove", 0);
  return 1;
}

int feuer_schutzhuelle(object caster, string *arg)
{
  object ob;
  mapping temp;

  if (present("SCHUTZHUELLE", caster))
  {
    Tell("Meister, Ihr habt schon eine andere Schutzhuelle!");
    return 0;
  }

  WriteLog(sprintf("Feuerschutz fuer %d sec", 30 * QueryProp(P_LEVEL)));
  PayForService(0);

  ob = clone_object(DRUIDEN("obj/schutzhuelle"));
  ob->set_element(FEUER, 30 * QueryProp(P_LEVEL));
  ob->move(TP,M_NOCHECK);
  ob->DoWear(1);

  Tell("Ich werde Euch schuetzen, Meister!");

  Effect(caster,
         "Das Feuerelementar bildet eine feuerrote Schutzhuelle um Dich."
         ,
         "Das Feuerelementar bildet eine feuerrote Schutzhuelle, die "+
         caster->name(WEN)+" umgibt."
  );

  call_out("remove",0);
  return 1;
}

int feuer_enthaare(object caster, string *arg)
{
  object victim,ob;

  victim = find_player(lower_case(arg[0]));

  if (!victim)
  {
    Tell("Meister, ich denke ein Spieler namens \""+arg[0]+"\" "
         "existiert nicht!");
    return 0;
  }

  if (victim->QueryProp(P_INVIS))
  {
    Tell("Meister, ich denke ein Spieler namens "+arg[0]+"\" "
         "existiert nicht!");
    return 0;
  }

  if (IS_LEARNER(victim))
  {
    Tell("Meine Macht reicht nicht aus, einen Magier zu enthaaren!");
    return 0;
  }

  if (ENV(victim) != ENV(TO))
  {
    Tell("Meister, "+victim->name(WER)+" ist nicht hier im Raum!");
    return 0;
  }

  if (victim->QueryProp(P_FROG))
  {
    Tell("Meister, also wirklich! Froesche haben nun wirklich keine Haare!");
    return 0;
  }

  if (victim->QueryProp(P_GHOST))
  {
    Tell("Meister, also wirklich! Geister haben nun wirklich keine Haare!");
    return 0;
  }

  if (present("\nfeuerelementar_enthaare", victim))
  {
    Tell("Meister, "+victim->name(WER)+" hat bereits keine Haare mehr!");
    return 0;
  }

  if (victim->is_class_member(CL_UNDEAD))
  {
    Tell("Igitt, "+victim->name(WER)+" lebt ja gar nicht! So ein Wesen kann "
        "ich nicht enhthaaren, Meister!");
    return 0;
  }

  WriteLog(sprintf("Opfer: %s", getuid(victim)));
  PayForService(0);

  ob = present("\nfrisur", victim);
  if (ob && objectp(ob)) ob->remove();

  ob = present("\nklette", victim);
  if (ob && objectp(ob)) ob->remove();

  ob = clone_object(OBJ("enthaarung"));
  ob->move(victim, M_NOCHECK);
  ob->weg((caster->QueryProp(P_GUILD_LEVEL) * 100));

  Tell("Meister, Ihr seid heute wieder besonders spassig!");

  Effect(victim,
         "Das Feuerelementar verwandelt sich in eine Feuerkugel schiesst "
         "auf Dich zu! WUSCH - Du bist von Flammen umhuellt, spuerst die "
         "sengende Hitze. Mit einem Schlag ist die Hitze verschwunden - "
         "genauso wie Deine komplette Koerperbehaarung!"
         ,
         "Das Feuerelementar verwandelt sich in eine grosse Feuerkugel und "
         "schiesst auf "+victim->name(WEN)+" zu! Es huellt "+
         victim->QueryPronoun(WEN)+" kurz ein und verbrennt "+
         victim->QPP(FEMALE,WEN,SINGULAR)+" komplette "
         "Koerperbehaarung, ohne "+victim->QueryPronoun(WEN)+" zu verletzen!"
  );

  call_out("remove",0);
  return 1;
}

int feuer_temp(object caster, string *arg)
{
  object ob;
  mapping new_temp, help_temp;
  mixed env_ind, env_val;
  int i, feuer;
  new_temp=([]);
  help_temp=([]);

  if (!MENV)
  {
    Tell("Meister, hier im Nichts gibt es keine Temperatur!");
    return 0;
  }

  new_temp=MENV->QueryProp(P_ENVIRONMENT);
  if (!member(new_temp, ENV_TEMPERATURE))
  {
    Tell("Meister, hier gibt es keine Temperatur!");
    return 0;
  }

  if (MENV->Query(P_ENVIRONMENT, F_QUERY_METHOD) || present("\ntemp", MENV))
  {
    Tell("Meister, die Temperatur wurde hier schon veraendert!");
    return 0;
  }

  if (new_temp[ENV_TEMPERATURE]>20)
  {
    Tell("Meister, hier ist es doch schon angehem warm!");
    return 0;
  }
  env_val=m_values(new_temp);
  env_ind=m_indices(new_temp);
  for(i = sizeof(env_ind) - 1; i >= 0; i--) {
    help_temp += ([env_ind[i]:env_val[i]]);
  }
  
  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == FEUER)
    feuer = 4;
  else
    feuer = 1;
  new_temp[ENV_TEMPERATURE] = new_temp[ENV_TEMPERATURE] + feuer +
    random(QueryProp(P_LEVEL) / 2) + QueryProp(P_LEVEL) / 7;

  WriteLog(sprintf("%d Grad -> %d Grad",
                help_temp[ENV_TEMPERATURE], new_temp[ENV_TEMPERATURE]));
  PayForService(0);

  Effect(caster,
         "Das Feuerelementar verwandelt sich in feurige Hitze "
         "und erhoeht die Temperatur des Raumes deutlich!"
         ,
         "Das Feuerelementar verwandelt sich in feurige Hitze "
         "und erhoeht die Temperatur des Raumes deutlich!"
  );

  ob=clone_object(DRUIDEN("obj/temp"));
  ob->move(MENV, M_NOCHECK);
  ob->SetVariables(new_temp, help_temp);

  call_out("remove",0);
  return 1;
}
//**************************************************************************
//**************************************************************************
//
// Dienstefunktionen Erz
//
//**************************************************************************
//**************************************************************************

int erz_verwandle_gem(object caster,string *arg)
{
  int erz;

  WriteLog("");
  PayForService(0);

  Tell("Sehr wohl, Meister!");

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == ERZ)
    erz = 5;
  else
    erz = 2;
  erz += QueryProp(P_LEVEL) / 15;
  "/obj/gemmaster"->DistributeGem(erz / 2, 1 + erz, 1, 1);

  Effect(caster,
         "Das Erzelementar beginnt sich zu verfluessigen. Das fluessige "
         "Elementar verdichtet sich am Boden zu einer strahlenden Masse, "
         "deren Lichtintensitaet alles, was Du bisher gesehen hast, "
         "uebertrifft. Auf einmal erlischt das Licht, und am Boden liegen "
         "ein paar Edelsteine."
         ,
         "Das Erzelementar beginnt sich zu verfluessigen. Das fluessige "
         "Elementar verdichtet sich am Boden zu einer strahlenden Masse, "
         "deren Lichtintensitaet alles, was Du bisher gesehen hast, "
         "uebertrifft. Auf einmal erlischt das Licht, und am Boden liegen "
         "ein paar Edelsteine."
  );

  call_out("remove",0);
  return 1;
}

int erz_verwandle_mat(object caster,string *arg)
{
  mixed mat;
  string *members, material;
  object ob;

  material = arg[0];

  if (!stringp(mat=MATERIALDB->String2Material(material)))
  {
    Tell("Meister, solche Materie kenne ich nicht!");
    return 0;
  }

  members=MATERIALDB->GetMatMembership(mat);
  if (member(members, MATGROUP_METAL)   == -1 &&
      member(members, MATGROUP_MINERAL) == -1 &&
      member(members, MATGROUP_JEWEL)   == -1 &&
      member(members, MATGROUP_STONE)   == -1  )
  {
     Tell("Meister, in "+CAP(material)+" kann ich mich nicht "
          "verwandeln!");
     return 0;
  }

  WriteLog(sprintf("Material: %s", material));
  PayForService(0);

  ob = clone_object(DRUIDEN("obj/thing"));
  ob->SetProp(P_MATERIAL, ([mat:100]));
  ob->SetProp(P_SHORT, sprintf("Ein Klumpen %s", CAP(material)));
  ob->SetProp(P_GENDER, MALE);
  ob->SetProp(P_WEIGHT, 1000);
  ob->SetProp(P_MAGIC, 1);
  ob->SetProp(P_LONG, sprintf(
      "Das ist ein Klumpen aus reinem %s. Er muss wohl etwa ein "
      "Kilogramm wiegen.", CAP(material)));
  ob->SetProp(P_NOSELL, "Du willst den Klumpen gar nicht verkaufen!\n");
  ob->SetProp(P_NAME, sprintf("Klumpen %s", CAP(material)));
  ob->AddId(({material+"klumpen", "\n"+material, "klumpen", material}));
  ob->move(ME, M_NOCHECK);

  Tell("So soll es sein, Meister!");

  Effect(caster,
         "Das Erzelementar beginnt sich zu verfluessigen. Das fluessige "
         "Elementar verdichtet sich am Boden zu einer strahlenden Masse, "
         "deren Lichtintensitaet alles, was Du bisher gesehen hast, "
         "uebertrifft. Mit einem mal erlischt das Licht, und am Boden "
         "liegt ein Klumpen "+CAP(material)+"."
         ,
         "Das Erzelementar beginnt sich zu verfluessigen. Das fluessige "
         "Elementar verdichtet sich am Boden zu einer strahlenden Masse, "
         "deren Lichtintensitaet alles, was Du bisher gesehen hast, "
         "uebertrifft. Mit einem mal erlischt das Licht, und am Boden "
         "liegt ein Klumpen "+CAP(material)+"."
  );

  call_out("remove",0);
  return 1;
}

int erz_reparieren(object caster,string *arg)
{
  object *items;
  int i, dam, erz, rep;

  items = caster->QueryProp(P_ARMOURS);
  if (!sizeof(items))
  {
    Tell("Meister, Ihr habt nichts an, was man reparieren koennte!");
    return 0;
  }

  Tell("Wie Ihr wuenscht, Meister");

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == ERZ)
    erz = 2;
  else
    erz = 1;
  dam = 0;
  for (i = sizeof(items) - 1; i >= 0; i--) 
  {
    if (items[i]->QueryProp(P_DAMAGED) >= 1 + random(3-erz)) 
    {
      if (!items[i]->Query(P_AC, F_QUERY_METHOD)) 
      {
        rep = (erz + items[i]->QueryProp(P_DAMAGED) + random(2)) / 2;
        dam += rep;
        items[i]->Damage(-rep);
      }
    }
  }

  WriteLog(sprintf("%d Schaden repariert",dam));
  PayForService(dam * 3);

  Effect(caster,
         "Das Erzelementar verwandelt sich in viele kleine Naehnadeln, die "
         "Deine Ausruestung reparieren."
         ,
         "Das Erzelementar verwandelt sich in viele kleine Naehnadeln, die "
         "die Ausruestung von "+caster->name(WEM)+" reparieren!"
  );

  call_out("remove",0);
  return 1;
}

int erz_schutz(object caster,string *arg)
{
  object ob;
  int val,prot_time, erz;

  if (caster->Query(P_BODY,F_QUERY_METHOD))
  {
    Tell("Meister, Ihr habt schon einen Schutz!");
    return 0;
  }

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == ERZ)
    erz = 2;
  else
    erz = 1;
  val = erz * QueryProp(P_LEVEL) / 2 + random(QueryProp(P_LEVEL) + 17);
  prot_time = 300 * erz + random(erz * 20 * QueryProp(P_LEVEL));

  WriteLog(sprintf("Schutzstaerke %d : Schutzdauer %d", val, prot_time));
  PayForService(0);

  Tell("Wie Ihr wuenscht, Meister!");

  Effect(caster,
         "Dein Erzelementar verfluessigt sich und bildet einen Schutzpanzer "
         "um Dich!"
         ,
         "Das Erzelementar verfluessigt sich und bildet einen Schutzpanzer "
         "um "+caster->name(WER)+"."
  );

  ob = clone_object(DRUIDEN("obj/schutz"));
  ob->move(caster, M_NOCHECK);
  ob->SetVariables(TP,val,prot_time, "erz");

  call_out("remove",0);
  return 1;
}

int erz_transport(object caster, string *arg)
{
  mapping ziele;
  string target;
  int fix_kosten, var_kosten, tot_kosten;

  ziele = ERZ_TRANSPORT;

  if (!ENV(TO)) return 0;

  if (!MENV->QueryProp(P_INDOORS))
  {
    Tell("Meister! Ich kann Euch hier nicht befoerdern! Ich "
         "kann Euch nur in geschlossenen Raeumen transportieren!");
    return 0;
  }

  if (member(({NO_TPORT_OUT, NO_TPORT}), MENV->QueryProp(P_NO_TPORT)) != -1 ||
      MENV->QueryProp(P_NOMAGIC))
  {
    Tell("Meister, hier haelt mich eine magische Macht fest. Ich "
         "kann Euch nicht transportieren.");
    return 0;
  }

  if(!deep_present(ELEMENTAL_SPHERE+"_"+ERZ, caster)) {
    Tell("Meister, fuer diesen Dienst benoetigt ihr eine perfekte "
        "Erzelementarsphaere.");
    return 0;
  }


  fix_kosten = meine_dienste["erz_transport",KEY_SP];
  var_kosten = caster->QueryProp(P_TOTAL_WEIGHT) / 1000;
  tot_kosten = fix_kosten + var_kosten;

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == ERZ)
    tot_kosten -= tot_kosten / 10;

  if (caster->QueryProp(P_SP)< tot_kosten)
  {
    Tell("Meister, Ihr seid nicht maechtig genug! Ich kann "
         "Euch nicht durch die Tiefen des Silberlands transportieren.");
    return 0;
  }

  if (!member(ziele,arg[0]))
  {
    Tell("Meister, ich weiss nicht wo Ihr hinwollt.");
    return 0;
  }

  target = ziele[arg[0]][random(sizeof(ziele[arg[0]]))];

  WriteLog(sprintf("laesst sich nach %s transportieren(%d MP)",target, 
        tot_kosten));
  PayForService(var_kosten);

  Tell("Meister, macht Euch bereit!");

  call_out("erz_transport2", 2, caster, target);

  return 1;
}

void erz_transport2(object caster, string target)
{
  caster->SetProp("destination",target);

  Effect(caster, "" ,
         "Das Erzelementar umschliesst "+caster->name(WEN)+" komplett und "
         "verschmilzt danach mit dem Boden.");

  caster->move(DRUIDEN("room/fels:"+getuid(caster)), M_NOCHECK,
      "mit dem Erzelementar im Boden", "verschwindet", "verschwindet mit dem "
      "Erzelementar im Boden");
  SetProp(E_REMOVE_MSG, "");

  call_out("remove",0);
  return;
}

//**************************************************************************
//**************************************************************************
//
// Dienstefunktionen Humus
//
//**************************************************************************
//**************************************************************************

int humus_heilen(object caster, string *arg)
{
  int vorher, nachher, humus;

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == HUMUS)
    humus = 2;
  else
    humus = 1;
  vorher  = caster->QueryProp(P_HP);
  nachher = caster->QueryProp(P_MAX_HP) - random((30 - QueryProp(P_LEVEL)) / humus);

  Tell("Sehr wohl, Meister. Euer Wunsch ist mein Befehl!");

  WriteLog(sprintf("Heilung von %d auf %d", vorher, nachher));
  PayForService(0);

  Effect(caster,
         "Das Humuselementar huellt Dich ein, bis Du nichts "
         "mehr siehst - Du nimmst nur mehr die Kraft des Humus wahr. "
         "Schliesslich broeckelt die Erde an Dir herunter, und du fuehlst "
         "Dich vollstaendig geheilt!"
         ,
         "Das Humuselementar umarmt "+caster->Name(RAW)+", bis "+
         caster->QueryPronoun(WER, 1)+" nicht mehr zu sehen ist. "
         "Schliesslich faellt die Erde an "+caster->QueryPronoun(WEM)+
         " herunter und keine Wunden sind an "+caster->name(WER,1)+
         " mehr zu sehen!"
  );

  caster->SetProp(P_HP, nachher);

  call_out("remove",0);
  return 1;
}

int humus_aura(object caster, string *arg)
{
  object ob;

  if (present(HUMUS_AURA_OBJ_ID, ENV(TO)))
  {
    Tell("Meister, dieses Gebiet ist schon von der Macht des "
         "Humus durchflossen!");
    return 0;
  }

  if (ENV(TO)->QueryProp(P_INDOORS) == 1)
  {
    Tell("Meister, ich kann die Umgebung nur draussen beleben!");
    return 0;
  }

  WriteLog("");
  PayForService(0);

  Tell("Wie Ihr wuenscht, Meister!");

  Effect(caster,
         "Das Humuselementar schlaegt Wurzeln - im wahrsten Sinne des "
         "Wortes und verwaechst komplett mit dem Erdreich. Du spuerst "
         "foermlich wie sich die Gegend belebt, wie alles zu bluehen "
         "beginnt und wie die Macht des Lebens durch dieses Gebiet fliesst!"
         ,
         "Das Humuselementar schlaegt Wurzeln - im wahrsten Sinne des "
         "Wortes und verwaechst komplett mit dem Erdreich. Du spuerst "
         "foermlich wie sich die Gegend belebt, wie alles zu bluehen "
         "beginnt und wie die Macht des Lebens durch dieses Gebiet fliesst!"
  );

  ob=clone_object(DRUIDEN("obj/humusaura"));
  ob->move(ENV(TO), M_NOCHECK);
  ob->start_heal();

  call_out("remove",0);
  return 1;
}

int humus_leben(object caster, string *arg)
{
  object ob;
  string *allowed_terrains;

  allowed_terrains=({TT_HILL,TT_FOREST,TT_MOUNTAIN,TT_JUNGLE,TT_SWAMP,
                     TT_PLAIN });

  if (member(allowed_terrains,
        ENV(ME)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]) == -1 &&
        ENV(ME)->QueryProp(P_INDOORS) == 1)
  {
    Tell("Meister, das kann ich hier nicht!");
    return 0;
  }

  WriteLog("");
  PayForService(0);

  Tell("Wie Ihr wuenscht, Meister!");

  Effect(caster,
         "Das Humuselementar zerfaellt in fruchtbaren fruchtbaren Humus, "
         "der sich mit dem Erdreich vermengt und eine urwuechsige "
         "Lebenskraft im Boden zuruecklaesst!"
         ,
         "Das Humuselementar zerfaellt in fruchtbaren fruchtbaren Humus, "
         "der sich mit dem Erdreich vermengt und eine urwuechsige "
         "Lebenskraft im Boden zuruecklaesst!"
  );

  ob=clone_object(DRUIDEN("obj/humus_samen"));
  ob->move(ENV(TO), M_NOCHECK);
  ob->start_grow();

  call_out("remove",0);
  return 1;
}

int humus_essen(object caster, string *arg)
{
  int vorher, nachher;

  if (caster->QueryProp(P_FOOD) >= caster->QueryProp(P_MAX_FOOD))
  {
    Tell("Meister, Ihr habt bereits einen vollen Bauch.");
    return 0;
  }

  vorher  = caster->QueryProp(P_FOOD);
  nachher = caster->QueryProp(P_MAX_FOOD);

  WriteLog(sprintf("Hunger von %d auf %d", vorher, nachher));
  PayForService(0);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Dein Humuselementar verwandelt sich in pure Nahrung "
         "und verschwindet in Deinem Mund. Ein angenehmes Saettigungsgefuehl "
         "macht sich in Deinem Bauch breit."
         ,
         "Das Humuselementar von "+caster->name(WEM)+" verwandelt sich "
         "in pure Nahrung und wird von "+caster->QueryPronoun(WEM)+
         " verschluckt. "+caster->Name(WESSEN)+" Bauch schaut jetzt "
         "viel runder aus."
  );

  caster->SetProp(P_FOOD, nachher);

  call_out("remove",0);
  return 1;
}

int humus_hunger(object caster, string *arg)
{
  int var_kosten, fix_kosten, vorher, nachher, humus;

  if (caster->QueryProp(P_FOOD) <= caster->QueryProp(P_MAX_FOOD) / 2)
  {
    Tell("Meister, Ihr seid doch gar nicht richtig satt.");
    return 0;
  }

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == HUMUS)
    humus = 10;
  else
    humus = 5;
  fix_kosten = meine_dienste["humus_essen",KEY_SP];
  var_kosten = caster->QueryProp(P_FOOD) / humus;

  if (caster->QueryProp(P_SP) < (var_kosten + fix_kosten))
  {
    Tell("Meister, ihr seid nicht maechtig genug!");
    return 0;
  }

  vorher  = caster->QueryProp(P_FOOD);
  nachher = caster->QueryProp(P_FOOD)/5;

  WriteLog(sprintf("Hunger von %d auf %d", vorher, nachher));
  PayForService(var_kosten);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Dein Humuselementar saugt Nahrung aus Deinem Koerper, bedankt "
         "sich artig fuer diese Spende und verschwindet."
         ,
         "Das Humuselementar von "+caster->name(WEM)+" saugt Nahrung "
         "aus "+caster->QPP(MALE,WEM,SINGULAR)+" Koerper und "
         "verschwindet dann froehlich."
  );

  caster->SetProp(P_FOOD, nachher);

  call_out("remove",0);
  return 1;
}

int humus_entgiften(object caster, string *arg)
{
  int poison, pmax, var_kosten, fix_kosten, humus;

  if ((poison = caster->QueryProp(P_POISON)) <=0)
  {
    Tell("Meister, Ihr ja gar nicht vergiftet.");
    return 0;
  }

  fix_kosten = meine_dienste["humus_entgiften",KEY_SP];

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == HUMUS)
    fix_kosten = 2 * fix_kosten / 3;
  pmax = QueryProp(P_SP) / fix_kosten;
  if (poison < pmax) pmax = poison;

  var_kosten = (pmax - 1) * fix_kosten;

  WriteLog(sprintf("Entgiftung %d", pmax));
  PayForService(var_kosten);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Dein Humuselementar saugt "+
         ((pmax==poison)?"saemtliches":"einiges")+
         " Gift aus Deinem Koerper und verschwindet."
         ,
         "Das Humuselementar von "+caster->name(WEM)+" saugt "+
         (pmax==poison?"saemtliches":"einiges")+
         " Gift aus "+caster->QPP(MALE,WEM,SINGULAR)+" Koerper "
         "und verschwindet dann."
  );

  caster->AddPoison(-pmax);

  call_out("remove",0);
  return 1;
}

//**************************************************************************
//**************************************************************************
//
// Dienstefunktionen Wasser
//
//**************************************************************************
//**************************************************************************

int wasser_atmen(object caster, string *arg)
{
  object ob;
  int val;

  if (present(WATERBREATH, caster))
  {
    Tell("Meister, Ihr koennt schon unter Wasser atmen.");
    return 0;
  }

  val = (QueryProp(P_LEVEL) / 2 + random(6)) * 60;
  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == WASSER)
    val *= 2;

  // ist es ein Raum, in dem unterwasseratmen viel besser wirken soll?
  if (strstr(file_name(ENV(caster)), SPECIAL_WATERBREATH) != -1)
    val *= 4;

  WriteLog(sprintf("Zeit : %d", val));
  PayForService(0);

  Tell("Schon geschehen, Meister! Ihr koennt nun unter Wasser atmen!");

  ob = clone_object(WATERBREATH_OBJ);
  ob->move(TP, M_NOCHECK);
  ob->atmen(val);

  call_out("remove",0);
  return 1;
}

int wasser_durst(object caster, string *arg)
{
  if (caster->QueryProp(P_DRINK) >= caster->QueryProp(P_MAX_DRINK))
  {
    Tell("Meister, Euer Bauch gluckert schon genug!");
    return 0;
  }

  WriteLog(sprintf("Durst von %d auf %d", caster->QueryProp(P_DRINK), 
        caster->QueryProp(P_MAX_DRINK)));
  PayForService(0);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Dein Wasserelementar verfluessigt sich und wird von Deinem Koerper"
         " absorbiert."
         ,
         "Das Wasserelementar von "+caster->name(WEM)+" verfluessigt sich "
         "und wird von "+caster->QPP(MALE,WEM,SINGULAR)+
         " Koerper absorbiert."
  );

  caster->SetProp(P_DRINK, caster->QueryProp(P_MAX_DRINK));

  call_out("remove",0);
  return 1;
}

int wasser_beschleunigen(object caster, string *arg)
{
  int speed, duration, wasser;

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == WASSER)
    wasser = 2;
  else
    wasser = 1;

  speed    = 140 + 20 * wasser + random(35);
  duration =  wasser * 60 + random(120 * wasser);

  WriteLog(sprintf("Geschwindigkeit %d : Dauer %d", speed, duration));
  PayForService(0);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Das Wasserelementar verliert seine Gestalt und fliesst in Deine "
         "Arme und Beine. Du fuehlst Dich nun viel geschmeidiger."
         ,
         "Das Wasserelementar verliert seine Gestalt und beginnt in die "
         "Arme und Beine von "+caster->name(WER)+" zu fliessen. "+
         CAP(caster->QueryPronoun(WER))+" bewegt sich nun viel schneller "
         "und geschmeidiger!"
  );

  caster->ModifySkillAttribute(TP, SA_SPEED, speed, duration);

  call_out("remove",0);
  return 1;
}

int wasser_trinken(object caster, string *arg)
{
  int var_kosten,fix_kosten, wasser;

  if (caster->QueryProp(P_DRINK) <= caster->QueryProp(P_MAX_DRINK) / 2)
  {
    Tell("Meister, Ihr habt ja fast noch gar nichts getrunken.");
    return 0;
  }

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == WASSER)
    wasser = 10;
  else
    wasser = 5;
  var_kosten = caster->QueryProp(P_DRINK) / wasser;
  fix_kosten = meine_dienste["wasser_trinken", KEY_SP];

  if (caster->QueryProp(P_SP) < (var_kosten+fix_kosten))
  {
    Tell("Meister, Ihr seid nicht maechtig genug.");
    return 0;
  }

  WriteLog(sprintf("Durst von %d auf %d", caster->QueryProp(P_DRINK), 
        caster->QueryProp(P_DRINK) / 5));
  PayForService(var_kosten);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Dein Wasserelementar saugt Fluessigkeit aus Deinem Koerper, "
         "bedankt sich artig fuer diese Spende und verschwindet."
         ,
         "Das Wasserelementar von "+caster->name(WEM)+" saugt Fluessigkeit "
         "aus "+caster->QPP(MALE,WEM,SINGULAR)+" Koerper und "
         "verschwindet dann froehlich."
  );

  caster->SetProp(P_DRINK, caster->QueryProp(P_DRINK) / 5);
  call_out("remove",0);
  return 1;
}

int wasser_perlen(object caster, string *arg)
{
  object ob;
  int wasser;

  WriteLog("");
  PayForService(0);

  Tell("Sehr wohl, Meister!");

  Effect(caster,
         "Das Wasserelementar beginnt sich zu verfluessigen. Das fluessige "
         "Elementar verdichtet sich am Boden zu einigen strahlenden "
         "Muscheln, deren Lichtintensitaet alles, was Du bisher gesehen "
         "hast, uebertrifft. Mit einem mal erlischt das Licht, die "
         "Muscheln loesen sich auf und am Boden bleiben einige Perlen "
         "liegen."
         ,
         "Das Wasserelementar beginnt sich zu verfluessigen. Das fluessige "
         "Elementar verdichtet sich am Boden zu einigen strahlenden "
         "Muscheln, deren Lichtintensitaet alles, was Du bisher gesehen "
         "hast, uebertrifft. Mit einem mal erlischt das Licht, die "
         "Muscheln loesen sich auf und am Boden bleiben einige Perlen "
         "liegen."
  );

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == WASSER)
    wasser = 5;
  else
    wasser = 2;
  wasser += QueryProp(P_LEVEL) / 15;
  "/obj/pearlmaster"->DistributePearl(wasser / 2, 1 + wasser, 1, 1);

  call_out("remove",0);
  return 1;
}

//**************************************************************************
//**************************************************************************
//
// Dienstefunktionen Eis
//
//**************************************************************************
//**************************************************************************

int eis_schutz(object caster,string *arg)
{
  object ob;
  mapping temp;
  int val, prot_time, eis;

  if (present("\ntempschutz", caster))
  {
    Tell("sag Meister, Ihr habt schon einen anderen Temperaturschutz!");
    return 0;
  }

  PayForService(0);

  Tell("Ich werde Euch schuetzen, Meister!");

  Effect(caster,
         "Das Eiselementar bildet einen eisblauen Schimmer um Dich. Du "
         "bist nun gegen die Kaelte geschuetzt."
         ,
         "Das Eiselementar bildet einen eisblauen Schimmer, der "+
         caster->name(WEN)+" umgibt."
  );

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == EIS)
    eis = 12;
  else
    eis = 5;

  val = eis + QueryProp(P_LEVEL) / 4 + caster->QueryProp(P_GUILD_LEVEL) / 4;
  prot_time = 90 * eis + 15 * caster->QueryProp(P_GUILD_LEVEL) +
    random(5 * eis * QueryProp(P_LEVEL));

  // ist es ein Raum, in dem der kaelteschutz viel besser wirken soll?
  if (strstr(file_name(ENV(caster)), SPECIAL_COLD_PROTECTION) != -1)
  {
    val *= 4;
    prot_time *= 4;
  }

  WriteLog(sprintf("Kaelteschutz: %d fuer %d sec",val, prot_time));

  ob=clone_object(DRUIDEN("obj/tempschutz"));
  ob->SetVariables(([T_COLD_PROT: val, T_HEAT_PROT:0]), prot_time);

  ob->move(caster,M_NOCHECK);
  ob->DoWear(1);

  call_out("remove");
  return 1;
}

int eis_schutzhuelle(object caster,string *arg)
{
  object ob;

  if (present("SCHUTZHUELLE", caster))
  {
    Tell("Meister, Ihr habt schon eine andere Schutzhuelle!");
    return 0;
  }

  WriteLog(sprintf("Eisschutz fuer %d sec", 30 * QueryProp(P_LEVEL)));
  PayForService(0);

  Tell("Ich werde Euch schuetzen, Meister!");

  Effect(caster,
         "Das Eiselementar bildet eine eisblaue Schutzhuelle um Dich."
         ,
         "Das Eiselementar bildet eine eisblaue Schutzhuelle, die "+
         caster->name(WEN)+" umgibt."
  );

  ob = clone_object(DRUIDEN("obj/schutzhuelle"));
  ob->set_element(EIS, 30 * QueryProp(P_LEVEL));
  ob->move(caster,M_NOCHECK);
  ob->DoWear(1);

  call_out("remove",0);
  return 1;
}

int eis_temp(object caster, string *arg)
{
  object ob;
  mapping new_temp, help_temp;
  mixed env_ind, env_val;
  int i, eis;
  new_temp=([]);
  help_temp=([]);

  if (!MENV)
  {
    Tell("Meister, hier im Nichts gibt es keine Temperatur!");
    return 0;
  }

  new_temp = MENV->QueryProp(P_ENVIRONMENT);
  if (!member(new_temp, ENV_TEMPERATURE))
  {
    Tell("Meister, hier gibt es keine Temperatur!");
    return 0;
  }

  if (MENV->Query(P_ENVIRONMENT, F_QUERY_METHOD) || present("\ntemp", MENV))
  {
    Tell("Meister, die Temperatur wurde hier schon veraendert!");
    return 0;
  }

  if (new_temp[ENV_TEMPERATURE] < 10)
  {
    Tell("Meister, hier ist es doch schon angehem kalt!");
    return 0;
  }

  env_val = m_values(new_temp);
  env_ind = m_indices(new_temp);
  for (i = sizeof(env_ind) - 1; i >= 0; i--) 
  {
    help_temp+=([env_ind[i]:env_val[i]]);
  }

  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == EIS)
    eis = 4;
  else
    eis = 1;
  new_temp[ENV_TEMPERATURE] = new_temp[ENV_TEMPERATURE] - eis -
    random(QueryProp(P_LEVEL) / 2) - QueryProp(P_LEVEL) / 7;

  WriteLog(sprintf("%d Grad -> %d Grad",
                help_temp[ENV_TEMPERATURE], new_temp[ENV_TEMPERATURE]));
  PayForService(0);

  Effect(caster,
         "Das Eiselementar verwandelt sich in eisige Kaelte und senkt "
         "die Temperatur des Raumes rapide ab!"
         ,
         "Das Eiselementar verwandelt sich in eisige Kaelte und senkt "
         "die Temperatur des Raumes rapide ab!"
  );

  ob = clone_object(DRUIDEN("obj/temp"));
  ob->move(MENV, M_NOCHECK);
  ob->SetVariables(new_temp, help_temp);

  call_out("remove",0);
  return 1;
}

int eis_eis(object caster, string *arg)
{
  object ob;
  int i, sorten;
  string *eis_sorten;

  eis_sorten = EIS_SORTEN;

  if (!ENV(ME))
  {
    Tell("Meister, das kann ich hier nicht!");
    return 0;
  }

  WriteLog("");
  PayForService(0);

  Effect(caster,
         "Das Eiselementar beginnt sich irrsinnig schnell zu drehen! "
         "Ploetzlich schiesst das Elementar in die Luft, und kurze Zeit "
         "spaeter fallen einige seltsame Eisbrocken wieder zu Boden!"
         ,
         "Das Eiselementar beginnt sich irrsinnig schnell zu drehen! "
         "Ploetzlich schiesst das Elementar in die Luft, und kurze Zeit "
         "spaeter fallen einige seltsame Eisbrocken wieder zu Boden!"
  );

  sorten = sizeof(eis_sorten);
  i      = random(3) + 1;
  if (call_other(DRUIDENMASTER, "GetDruidElement", getuid(caster)) == EIS)
    i += 2;
  while (i--)
  {
    ob=clone_object(eis_sorten[random(sorten)]);
    ob->move(ENV(ME), M_NOCHECK);
  }

  call_out("remove",0);
  return 1;
}

int eis_frieren(object caster,string *arg)
{
  object target, ob;
  int kosten,val;

  target = find_player(lower_case(arg[0]));

  if (!target || target->QueryProp(P_INVIS))
  {
    Tell("Meister, ich denke ein Spieler namens "+arg[0]+" existiert "
         "nicht!");
    return 0;
  }

  if (IS_LEARNER(target))
  {
    Tell("Einen Magier werde ich nicht einfrieren!");
    return 0;
  }

  if (ENV(target) != ENV(caster))
  {
    Tell("Meister, "+target->name(WER)+" befindet sich nicht hier!");
    return 0;
  }

  if (present("\neiselementar_gef_mund", target))
  {
    Tell("Meister, der Mund von "+target->name(WEM)+" ist bereits "
         "eingefroren!");
    return 0;
  }

  PayForService(0);

  Effect(caster,
    "Ploetzlich spuerst Du den Griff einer eisigen Kaelte, wie sie Deine "
    "Beine hochkriecht, immer weiter, bis sie sich schliesslich in Deinem "
    "Mund zu konzentrieren scheint. Du versuchst zu schreien - "
    "erfolglos ..."
    ,
    "Das Eiselementar von "+caster->name(WEM)+" loest sich urploetzlich auf "
    "und verwandelt sich in einen eiskalten Nebel, der auf "+
    target->name(WEN)+" zufliesst, an "+
    target->QPP(FEMALE,WEN,PLURAL)+" Beinen "
    "hochklettert bis er schliesslich "+
    target->QPP(MALE,WEN,SINGULAR)+" Mund "
    "erreicht und diesen zufriert. "+target->Name(WER)+
    " versucht noch zu schreien, aber ausser \"Mmmmmm! "
    "Mmmmmm!\" ist nichts mehr zu verstehen!"
  );

  ob = clone_object(OBJ("gefrorener_mund"));
  ob->move(target, M_NOCHECK);
  val = (caster->QueryProp(P_GUILD_LEVEL) / 2) * 20;
  ob->start_remove(val);

  WriteLog(sprintf("%O fuer %d sec", target, val));

  call_out("remove",0);
  return 1;
}

//**************************************************************************
//**************************************************************************
//
// Dienstefunktionen Spezial
//
//**************************************************************************
//**************************************************************************

int z_weggeben(object caster, string *arg)
{
  object new_owner;
  int fix_kosten, var_kosten;

  new_owner = find_living(arg[0]);

  if (modus != MOD_KAMPF)
  {
    write("Du kannst nur Elementare im Kampfmodus weitergeben!\n");
    return 0;
  }

  if (!new_owner)
  {
    Tell("Meister, einen "+CAP(arg[0])+" kenne ich nicht!");
    return 0;
  }

  if (new_owner->QueryProp(P_INVIS))
  {
    Tell("Meister, einen "+CAP(arg[0])+" kenne ich nicht!");
    return 0;
  }

  if (ENV(TO) != ENV(new_owner))
  {
    Tell("Meister, "+new_owner->name(WEN)+" kann ich hier nicht sehen!");
    return 0;
  }

  if (!query_once_interactive(new_owner))
  {
    if (new_owner->id(DRUIDENELEMENTAR) ||
        new_owner->id("feuerwusel") ||
        new_owner->QueryProp(P_FRIEND) ||
        new_owner->is_class_member(CL_UNDEAD) ||
        new_owner->is_class_member(CL_DEMON))
    {
      Tell("Meister, "+new_owner->name(WEM,0)+" gehorche ich nicht!");
      return 0;
    }
  }

  if (new_owner->QueryProp(P_GHOST))
  {
    Tell("Meister, einem Geist diene ich nicht!");
    return 0;
  }

  if (new_owner->QueryProp(P_FROG))
  {
    Tell("Meister, einem Frosch diene ich nicht!");
    return 0;
  }

  if (new_owner->QueryGuest())
  {
    Tell("Meister, einem Gast diene ich nicht!");
    return 0;
  }

  if (new_owner->QueryProp(P_GUILD) == "nekromanten")
  {
    Tell("Meister, den Nekromanten werde ich niemals dienen!");
    return 0;
  }

  if (call_other(DRUIDENSPELLS, "QueryOwnCreature", new_owner, 0, 1))
  {
    Tell("Meister, "+new_owner->name(WER)+" hat bereits ein anderes "
         "Elementar!");
     return 0;
  }

  if (new_owner->QueryProp(P_LEVEL) < QueryProp(P_LEVEL))
  {
    Tell("Meister, " + new_owner->name(WER,1) + " ist nicht maechtig genug!");
    return 0;
  }

  fix_kosten = meine_dienste["z_weitergeben",KEY_SP]; 
  if (new_owner->QueryProp(P_GUILD) == "druidenzirkel" ||
     (stringp(caster->QueryProp(P_MARRIED))  &&
      lower_case(caster->QueryProp(P_MARRIED)) == getuid(new_owner) ) )
  {
    var_kosten = -3 * fix_kosten / 4;
  }
  else
  {
    var_kosten = 0;
  }

  if (caster->QueryProp(P_SP) < (fix_kosten + var_kosten))
  {
    Tell("Meister, Ihr seid nicht maechtig genung!");
    return 0;
  }
  if (sizeof(QueryEnemies()[0])) 
  {
    WriteLog(sprintf("uebergibt %s an %s IM KAMPF gegen %O", 
          name(WEN),new_owner->name(WEN),QueryEnemies()[0]));
  }
  else
  {
    WriteLog(sprintf("uebergibt %s an %s",name(WEN),new_owner->name(WEN)));
  }
  PayForService(var_kosten);

  Tell("Sehr wohl Meister, ab nun gehorche ich "+new_owner->name(WEM)+".");

  catch(caster->RemovePursuer(ME));
  catch(caster->SetProp(P_DEFENDERS, caster->QueryProp(P_DEFENDERS)-({ME})));

  if (QueryProp(P_MAX_HP) > 400)
    SetProp(P_MAX_HP, 400);
  apool /= 2;
  
  SetOwner(new_owner, 1);

  new_owner->AddDefender(TO);

  return 1;
}

int z_kaempfen(object caster, string *arg)
{
  modus = MOD_KAMPF;
  caster->AddDefender(TO);

  Tell("Meister, ich werde Euch jetzt im Kampf unterstuetzen!");

  meine_dienste = filter_mapping(alle_dienste["spezial",KEY_STATUS],
                                 lambda(({'k}),({#'==,'k,"z_weggeben"}) ) ) +
                  filter_mapping(alle_dienste["spezial",KEY_STATUS],
                                 lambda(({'k}),({#'==,'k,"z_verschwinde"}) ) );
  
  act_service = "";
  if (objectp(QueryProp(ELEMENTAL_CASTER)))
    if (QueryProp(ELEMENTAL_CASTER) != caster)
      apool /= 2;

  return 1;
}

int z_verteidigen(object caster, string *arg)
{
  modus = MOD_VERTEIDIGUNG;
  caster->AddDefender(TO);

  Tell("Meister, ich werde Euch jetzt im Kampf verteidigen!");

//  meine_dienste = filter_mapping(alle_dienste["spezial",KEY_STATUS],
//                                 lambda(({'k}),({#'==,'k,"z_weggeben"}) ) );
// Verteidigungsdienst ist jetzt zu stark fuer nicht-Druiden
  meine_dienste = filter_mapping(alle_dienste["spezial",KEY_STATUS],
                                 lambda(({'k}),({#'==,'k,"z_verschwinde"}) ) );
  act_service = "";
  return 1;
}

int z_enhance(object caster, string *arg)
{
  object ob;

  Tell("Sehr wohl, Meister. Euer Wunsch ist mein Befehl! Vergesst nicht, "
       "dass Ihr waehrend der elementaren Verstaerkung kein weiteres "
       "Elementar beschwoeren koennt! Ihr muesst warten bis die Wirkung "
       "abgeklungen ist.");

  Effect(caster,
         "Du bist kurzzeitig von einer Aura elementarer Macht umgeben. Als "
         "sie abgeklungen ist, fuehlst Du eine starke Affinitaet zu dem "
         "Element "+CAP(QueryProp(P_ELEMENT))+"!"
         ,
         caster->Name(WER)+" ist kurzzeitig von einer Aura der Macht "
         "umgeben!"
  );

  ob = clone_object(OBJ("druid_enhance"));
  ob->Setup(QueryProp(P_ELEMENT), caster);
  ob->move(caster, M_NOCHECK);

  call_out("remove",0);
  return 1;
}

int z_verschwinde(object caster, string *arg)
{
  object ob;
  string day;

  switch (to_int(dtime()[19..20]))
  {
    case 6..12: day = "Einen schoenen Tag noch!"; break;
    case 13..17: day = "Einen schoenen Nachmittag noch!"; break;
    case 18..22: day = "Einen schoenen Abend noch!"; break;
    default : day = "Gute Nacht!"; break;
  }
  Tell("Sehr wohl, Meister. Euer Wunsch ist mein Befehl! " + day);

  call_out("remove",0);
  return 1;
}

//**************************************************************************
//**************************************************************************
//
// Allgemeine Funktionen fuer Dienste
//
//**************************************************************************
//**************************************************************************

void Effect(object caster, string pstr, string ostr)
{
  object *lvs,room;
  int i;

  if (interactive(caster) && (strlen(pstr) > 0))
  {
    if (caster->CannotSee(1))
    {
      pstr = "Du bemerkst, dass sich etwas um Dich herum tut, aber da Du "
             "blind bist, siehst Du natuerlich nichts.";
    }

    tell_object(caster,"\n"+BS(pstr));
  }

  if (!(room = ENV(TO))) return;

  lvs = filter_array(all_inventory(room), #'living) - ({ caster });

  i   = sizeof(lvs);
  while (i--)
  {
    if(lvs[i]->CannotSee(1))
    {
      tell_object(lvs[i],"\n"+BS("Du bemerkst, dass sich etwas um Dich "
                         "herum tut, aber da Du blind bist, siehst Du "
                         "natuerlich nichts."));
    }
    else
    {
      tell_object(lvs[i], "\n"+BS(ostr));
    }

  }

  return;
}

void Tell(string s)
{
  object *lvs, room;
  int i;

  if (!(room = ENV(TO))) return;

  lvs = filter_array(all_inventory(room), #'living);

  i   = sizeof(lvs);
  while (i--)
  {
    if (lvs[i]->QueryProp(P_DEAF) && lvs[i]->CannotSee(1))
    {
      //spieler bekommt gar nichts mit
    }
    else if (lvs[i]->QueryProp(P_DEAF))
    {
      tell_object(lvs[i], "\n"+BS(Name(WER,1)+" bewegt seine Lippen, aber "
                          "Du kannst nichts hoeren."));
    }
    else if (lvs[i]->CannotSee(1))
    {
      tell_object(lvs[i],"\n"+BSI(s,"Jemand sagt: "));
    }
    else
    {
      tell_object(lvs[i], "\n"+BSI(s,Name(WER,1)+" sagt: "));
    }
  }

  return;
}

int _extern_set_modus(int x_mod)
{        
  object po;

  if (!po = previous_object()) return 0;

  if (!po->id("anvar")) return 0;

  modus = x_mod;

  return modus;
} 

int CheckServiceStatus(string key)
{
  if (meine_dienste[key,KEY_STATUS] == 1) return 1;
  return 0;
}

void PayForService(int mpadd)
{
  object *items,caster,amulett;
  int i,n,nitems;

  caster = QueryProp(ELEMENTAL_OWNER);
  if (!caster)              return;
  if (!interactive(caster)) return;

  caster->AddSp(-meine_dienste[act_service,KEY_SP]-mpadd);

  nitems = meine_dienste[act_service,KEY_COUNT];
  if (nitems > 0)
  {
    items = filter_objects(all_inventory(caster),"id",meine_dienste[act_service,KEY_ID]);

    if (items[0]->IsUnit())
    {
      n  = items[0]->QueryProp(P_AMOUNT);
      n -= nitems;
      if(n < 0) n = 0;
      items[0]->SetProp(P_AMOUNT, n);
    }
    else
    {
      i = nitems;
      while (i--) 
        items[i]->remove(1);
    }
  }

  amulett = present(DRUIDENAMULETT, caster);

  if (objectp(amulett) && (n = meine_dienste[act_service,KEY_SERVICE]) > 0)
  {
    amulett->ChangeService(QueryProp(P_ELEMENT),-n);
  }

  meine_dienste = ([ ]);
}

string dienste_info()
{
  string *keys, *s, str;
  int i;

  keys = filter_array(m_indices(meine_dienste),"CheckServiceStatus");
  keys = sort_array(keys,#'<);

  if ((i = sizeof(keys)) == 0)
  {
    Tell("Ich kann Euch keine Dienste erbringen!");
    return "";
  }

  s = ({ });
  while (i--)
  {
    str  = meine_dienste[keys[i],KEY_TEXT];
    str += " (\"sag "+lowerstring(name(RAW))+" "+meine_dienste[keys[i],KEY_SYNTAX]+"\"";

    if (meine_dienste[keys[i],KEY_SP] > 0)
    {
      str += ", "+meine_dienste[keys[i],KEY_SP]+" Magiepunkt";
      if (meine_dienste[keys[i],KEY_SP] > 1) 
        str += "e";
      if (strlen(meine_dienste[keys[i],KEY_SP_TEXT])) 
        str += meine_dienste[keys[i],KEY_SP_TEXT];
    }

    if (meine_dienste[keys[i],KEY_COUNT] > 0)
    {
      str += ", "+meine_dienste[keys[i],KEY_COUNT]+" ";
      if (meine_dienste[keys[i],KEY_COUNT] == 1)
        str += meine_dienste[keys[i],KEY_SING_TEXT];
      else
        str += meine_dienste[keys[i],KEY_PLUR_TEXT];
    }

    str += ")";

    s += ({ str });
  }

  str = "Ich kann " + LW(s) + ". ";

  Tell(str);
  return "";
}

void Parse2(string key,int stat,int service,int sp,string sp_addon,
            int number,string id,string singular,string plural,
            string desc,string syntax,
            object pl,string action)
{
  string *arg,*slist,*alist;
  int result,cnt,i,n;
  object amulett,*items;

  if (stat != 1)         return;
  if (act_service != "") return;

  slist = explode(syntax," ");
  alist = explode(action," ");

  n = sizeof(slist);
  if (n > sizeof(alist)) return;

  arg = ({ });
  cnt = 0;

  for (i = 0; i < n; i++)
  {
    if (slist[i] == alist[i])
    {
      cnt++;
    }
    else if ((slist[i][0..0] == "<") && (slist[i][<1..] == ">"))
    {
      cnt++;
      if (i == n - 1 && n < sizeof(alist))
        arg += ({ implode(alist[i..], " ") });
      else
        arg += ({ alist[i] }) ;
    }
  }

  if (cnt != n) return;

//-------------------------------------------------------------------------
// Eventuell falschen match korrigieren
//-------------------------------------------------------------------------

  if ((key == "erz_verwandle_mat") &&
      (sizeof(arg) > 0)            &&
      (arg[0] == "edelsteine")      ) 
    return;

//--------------------------------------------------------------------------
// Ab hier wurde Syntax gefunden, allgemeine Pruefungen zuerst
//--------------------------------------------------------------------------

  if (pl != QueryProp(ELEMENTAL_OWNER))
  {
    Tell("Du bist nicht mein Meister! Verschwinde, Du Wurm!");
    return;
  }

  /*if (pl->QueryProp(P_GUILD) != "druidenzirkel")
  {
    Tell("Es tut mir leid, Meister. Nur Druiden biete "
         "ich meine Dienste an!");
    return;
  }*/

  if (pl->QueryProp(P_ALIGN) < -500)
  {
    Tell("Meister, Ihr seid zu boese. Dem Boesen diene ich nicht.");
    return;
  }

  if (pl->QueryProp(P_ALIGN) > 500)
  {
    Tell("Meister, Ihr seid zu gut. Ich erfuelle nur Neutralen Wuensche.");
    return;
  }

  if (!(amulett = present(DRUIDENAMULETT,pl)))
  {
    Tell("Meister, Ihr scheint die Aura eines Druiden zu haben, aber Ihr "
         "tragt nicht das Zeichen der Druiden!");
    return;
  }

  if ((!IS_LORD(pl))                                    &&
      (service != 0)                                    &&
      (amulett->QueryService(QueryProp(P_ELEMENT)) < 1)  )
  {
    Tell("Meister, Ihr muesst warten, bis ich Euch Euren Wunsch "
         "erfuellen kann!");
    return;
  }

  if ((service != 0) && !call_other(DRUIDENSPELLS, "HasElementalRing", 
        QueryProp(P_ELEMENT), pl))
  {
    Tell("Meister, Ihr habt nicht genug Macht fuer diesen Dienst!");
    return;
  }

  if (sizeof(meine_dienste) == 0)
  {
    Tell("Meister, ich kann Euch keine weiteren Dienste mehr erbringen.");
    return;
  }

//--------------------------------------------------------------------------
// Ab hier spezielle Pruefungen (Magiepunkte und Items zB)
//--------------------------------------------------------------------------

//-------------------------------------------------------------------------
// Korrektur fuer z_weggeben, erstmal nur auf 50 sp testen
//-------------------------------------------------------------------------

//  if(act_service == "z_weggeben") sp = 50;

  if (pl->QueryProp(P_MAX_SP) < sp)
  {
    Tell("Meister, Ihr verlangt das Unmoegliche! Ihr werdet nie maechtig "
        "genug fuer diesen Dienst sein!");
    call_out("remove", 0);
    return;
  }

  if (pl->QueryProp(P_SP) < sp)
  {
    Tell("Meister, Ihr seid nicht maechtig genug!");
    return;
  }

  if (number > 0)
  {
    items = filter_objects(all_inventory(pl),"id",id);

    if (sizeof(items) == 0)
    {
      Tell("Meister, Ihr habt nicht genuegend "+plural+" bei Euch.");
      return;
    }

    if (items[0]->IsUnit())
    {
      if (items[0]->QueryProp(P_AMOUNT) < number)
      {
        Tell("Meister, Ihr habt nicht genuegend "+plural+" bei Euch.");
        return;
      }
    }
    else
    {
      if (sizeof(items) < number)
      {
        Tell("Meister, Ihr habt nicht genuegend "+plural+" bei Euch.");
        return;
      }
    }
  }

//DBR(sprintf("Parse: %O / %O / %O / %s",slist,alist,arg,key));

  if (!function_exists(key,TO))
  {
    Tell("Meister, ich weiss nicht was ich da machen soll! Fragt einen "
         "Magier!");
    return;
  }

  act_service = key;
  result = (int) call_other(TO,key,QueryProp(ELEMENTAL_OWNER),arg);
  if (result != 1) act_service = "";

  return;
}

void Parse1(object pl, string action)
{
  walk_mapping(meine_dienste,"Parse2",TO,pl,action);
}

void catch_tell(string str)
{
  string who,target,action;
  object owner;

  if (!str)                                                          return;
  if (!query_verb())                                                 return;
  if (!(query_verb()[0..2] == "sag" || query_verb()[0..0] == "'"))   return;
  if (!TP || !TI || TP != TI)                                        return;
  if (sscanf(str,"%s sagt: %s %s",who,target,action) != 3)           return;
  if (!id(target))                                                   return;
  if (!(owner = QueryProp(ELEMENTAL_OWNER)))                         return;
  if (!living(owner) || owner != TP)                                 return;

  if (action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);

//mit call_out verzoegern, damit zuerst die meldung des spielers kommt und
//dann erst die reaktion des elementars erfolgt

  call_out("Parse1",0,TP,action);
}

//**************************************************************************
//**************************************************************************
//
// Schnittstellen
//
//**************************************************************************
//**************************************************************************

void SetAggressive(object pl)
{
//DBR("Elementar => Aggressiv");
  meine_dienste = ([ ]);
  if (pl == QueryProp(ELEMENTAL_OWNER))
    modus = MOD_AGGRESSIV;
  else
    modus = MOD_AGGRESSIV_OTHER;
  pl->AddPursuer(TO);
  Kill(pl);
}

int SetOwner(object pl, int success)
{
  int ok;

  ok = 0;

  if (living(pl) && !query_once_interactive(pl))  ok = 1;
  if (interactive(pl) && !pl->QueryProp(P_GHOST)) ok = 1;

  if (!ok) return 0;

  SetProp(ELEMENTAL_OWNER, pl);

  if (success >= 0)
  {
    pl->AddPursuer(TO);

    SetProp(P_MSGOUT , "folgt "+pl->name(WEM));
    SetProp(P_MMSGOUT, "folgt "+pl->name(WEM));
  }
  else
  {
    SetAggressive(pl);
  }
  
  call_out("_setnolearn", 2);
  return 1;
}


string QueryElement()
{
  return QueryProp(P_ELEMENT);
}

int CheckPursuers()
{
  object owner, *p;
  int i;
  string my_file_name;

  if (!objectp(owner=QueryProp(ELEMENTAL_OWNER))) return 1;

  p = owner->QueryPursuers();
  i = sizeof(p);
  my_file_name = BLUE_NAME(TO);
//DBR(my_file_name);
  while (i--)
  {
    if (strstr(file_name(p[i]), my_file_name)!=-1)
    {
      tdm(sprintf("%O hat mehrere Elementare!\n%O\n\n", owner, p));
      return 0;
    }
  }
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
// Reactions
//////////////////////////////////////////////////////////////////////////////

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (touch && (QueryProp(P_ELEMENT) == FEUER ||
               QueryProp(P_ELEMENT) == EIS   ))
  {
    call_out("ElementalTouch",0,TP);
    return;
  }

  if (member( ({"spuck", "spucke", "sabbere", "sabber"}), verb)!=-1)
  {
    if (QueryProp(P_ELEMENT) == FEUER)  call_out("SpiteAttack",0,TP);
    if (QueryProp(P_ELEMENT) == WASSER) call_out("SpiteSmile",0,TP);
  }

  return;
}

void ElementalTouch(object pl)
{
  if (!interactive(pl)) return;

  if (QueryProp(P_ELEMENT) == FEUER)
  {
    tell_room(MENV, sprintf("%s verbrennt sich furchtbar an dem "
        "Feuerelementar!\n%s schreit laut auf!\n", pl->Name(WER),
        pl->Name(WER)), ({pl}));
    tell_object(pl, BS("WAHHHH! Du verbrennst Dich furchtbar an dem "
        "Feuerelementar!"));
  }
  else
  {
    tell_room(MENV, sprintf("%s bleibt an dem Eiselementar haften und "
        "reisst sich gewaltsam los!\n%s schreit laut auf!\n", pl->Name(WER),
        pl->Name(WER))), ({pl});
    tell_object(TP, "WAHHHH! Du bleibst an dem Eiselementar haften.\n Du "
        "reisst Dich gewaltsam los!");
  }

  if (pl->is_class_member(CL_TROLL) && QueryProp(P_ELEMENT) == FEUER)
    pl->AddHp(-random(20) - 11);
  else
    pl->AddHp(-random(20) - 1);
}

void SpiteAttack(object pl)
{
  tell_room(MENV, BS("Das Feuerelementar scheint das nicht witzig zu "
      "finden!"));
  if (objectp(QueryProp(ELEMENTAL_OWNER)) && interactive(QueryProp(ELEMENTAL_OWNER)))
    return;
  SetAggressive(pl);
}

void SpiteSmile(object pl)
{
  tell_room(MENV, BS(sprintf("Das Wasserelementar scheint sich zu freuen und "
      "laechelt %s an!", pl->name(WEN))),({pl}));
  tell_object(pl, BS("Das Wasserelementar scheint sich zu freuen und laechelt "
      "Dich an!"));
}

void WriteLog(string msg)
{
  string filename, roompath, s, *p;
  object pl, room;
  int i;

  pl = QueryProp(ELEMENTAL_OWNER);

  if (!pl)                                         return;
  if (!query_once_interactive(pl))                 return;
//  if (meine_dienste[act_service,KEY_SERVICE] != 1) return;

  if ((room=ENV(pl)))
  {
    roompath = file_name(room);
  }
  else
  {
    roompath = "Pfad nicht feststellbar!";
  }

  filename = ELEMENT_LOG(act_service);
  s = sprintf("%s : %s : %s",pl->QueryProp(P_RACE),getuid(TP),roompath);

  if (strlen(msg) > 0) s += " : " + msg;

  s += "\n";

  write_file(filename, sprintf("%s: %s",dtime(time()),s));

  if ((LOG_TO_ANGROX == 0) && (LOG_TO_RONJA == 0)) return;

  p = explode(roompath, "/");
  if (p[0] == "d") p = p[1..];

  i = sizeof(p);
  while (i--)
  {
    if(strlen(p[i]) > 5) p[i] = p[i][0..2] + "..";
  }
  roompath = implode(p, "/");

  s = sprintf("ELEMENTAR: %s : %s : %s",act_service, getuid(TP), roompath);
  if (strlen(msg) > 0) s += " : " + msg;

  if (LOG_TO_ANGROX == 1)
  {
    if (pl = find_player("angrox"))
    {
      if (pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
      tell_object(pl, s+"\n");
    }
  }

  if (LOG_TO_RONJA == 1)
  {
    if (pl = find_player("ronja"))
    {
      if (pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
      tell_object(pl, s + "\n");
    }
  }
}

nosave void _setnolearn() {
  AddId(SID_NOLEARN);

}

mixed meine_dienste() {
  return meine_dienste;
}

