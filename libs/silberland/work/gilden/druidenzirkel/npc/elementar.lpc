#define LOG_TO_ANGROX 1
#define LOG_TO_RONJA 0

#define DBR(x) if(find_player("ronja")) tell_object(find_player("ronja"), "\nXXX "+x+"\n")
#define LW(x) (sizeof(x)==1 ? x[0] : implode(x[0..<2],", ")+" und "+x[<1])
#define BSI(x,y) break_string(x,78,y,1)
#define QP QueryPronoun
#define PLROOM file_name(ENV(player))
#define MOD_NONE 0
#define MOD_KAMPF 1
#define MOD_VERTEIDIGUNG 2
#define MOD_AGGRESSIV 3
#define MOD_AGGRESSIV_OTHER 4

#define KEY_STATUS 0
#define KEY_SERVICE 1
#define KEY_SP 2
#define KEY_SP_TEXT 3
#define KEY_COUNT 4
#define KEY_ID 5
#define KEY_SING_TEXT 6
#define KEY_PLUR_TEXT 7
#define KEY_TEXT 8
#define KEY_SYNTAX 9

nosave int     callouts;
nosave string  e_dam_type, c_dam_type;
nosave mapping alle_dienste, meine_dienste;
nosave string  act_service;
nosave string  long_msg;
nosave int     modus;
nosave int     strength;
nosave int     apool;

void PayForService(int mpadd);
void Tell(string s);
void Effect(object caster, string pstr, string ostr);
void WriteLog(string msg);
int  SetOwner(object pl, int success);

//**************************************************************************
//
// Untermapping im mapping alle_dienste:
//
// key        Dienst, der Name ist gleichzeitig die Funktion, welche
//            aufgerufen wird, wenn der Parser eine Syntaxuebereinstimmung
//            feststellt
//
// value      Bedeutung
//   0        Status (1 = aktiv, alle anderen = nicht aktiv)
//   1        Anzahl der Dienste, die im Amulett abgezogen werden
//   2        Anzahl Spellpoints, die benoetigt werden
//   3        ggfls Zusatz zu den Spellpoints
//   4        Anzahl zusaetzlicher Objekte
//   5        id der zusaetzlichen Objekte
//   6        Singularname des Objektes
//   7        Pluralname des Objektes
//   8        Erklaerungstext (Ich kann ....)
//   9        syntax fuer spieler
//
// An dem Punkt, wo MP und evtl. spezielle Sachen entfernt werden sollen,
// ist die Funktion PayForService(mpadd) aufzurufen. Diese rechnet zu den
// MPs noch mpadd hinzu, zieht diese vom Spieler ab und entfernt die
// notwendigen Items. Fuer das verschwinden lassen des Elementars ist jede
// Dienstefunktion selbst zustaendig.
//**************************************************************************

