
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Druide");
  SetProp(P_LONG, BS(
      "Der kleine Druide sitzt dort, wo Du die die Vorderseite der Plattform "
      "vermutest. Mit Mistelzweigen in den Haenden vollfuehert er "
      "seltsame Gesten. Es scheint, als wuerde nur seine Kraft die "
      "steinerne Plattform auf der Du Dich befindest in der Luft halten."
    ));

  SetProp(P_NAME, "Druide");
  SetProp(P_NAME_ADJ, "jung");
  SetProp(P_GENDER, MALE);
  AddId(({"druide", "liftdruide"}));
  set_living_name("liftdruide");

  create_default_npc(1);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_MAX_HP, 500);
  SetProp(P_BODY, 500);
  SetProp(P_XP, QueryProp(P_XP)); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_SIZE, 140);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint urploetzlich");
  SetProp(P_MMSGOUT, "loest sich auf");
  AddInfo(DEFAULT_INFO, "ist zu beschaeftigt.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Druide will Deine Sachen nicht haben.\n" }) );
}
