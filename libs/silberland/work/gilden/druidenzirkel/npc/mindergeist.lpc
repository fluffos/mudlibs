inherit "std/npc";
inherit "/std/npc/spells";

#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <class.h>
#include <ansi.h>

#include "/gilden/druidenzirkel/druiden.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

string elementA; // Das erste Element für den Geist
string elementB; // Das zweite Element für den Geist
int intensity; // Staerke des Geists
object caster;

// Funktion zur Generierung des Namens basierend auf den Elementen
string generateName()
{
    // Setze den Namen des Geistes basierend auf den Elementenkombinationen
    string ghostName;
    ghostName = "";

    if(elementA == FEUER && elementB == WASSER || elementA == WASSER && elementB == FEUER) ghostName = "Dampfgeist";
    else if(elementA == FEUER && elementB == ERZ || elementA == ERZ && elementB == FEUER) ghostName = "Magmageist";
    else if(elementA == FEUER && elementB == LUFT || elementA == LUFT && elementB == FEUER) ghostName = "Aschegeist";
    else if(elementA == FEUER && elementB == HUMUS || elementA == HUMUS && elementB == FEUER) ghostName = "Glutnestling";
    else if(elementA == FEUER && elementB == EIS || elementA == EIS && elementB == FEUER) ghostName = "Schmelzwaechter";
    else if(elementA == WASSER && elementB == ERZ || elementA == ERZ && elementB == WASSER) ghostName = "Schlammgeist";
    else if(elementA == WASSER && elementB == LUFT || elementA == LUFT && elementB == WASSER) ghostName = "Nebelwesen";
    else if(elementA == WASSER && elementB == HUMUS || elementA == HUMUS && elementB == WASSER) ghostName = "Moosmaennchen";
    else if(elementA == WASSER && elementB == EIS || elementA == EIS && elementB == WASSER) ghostName = "Eiszapfling";
    else if(elementA == ERZ && elementB == LUFT || elementA == LUFT && elementB == ERZ) ghostName = "Staubgeist";
    else if(elementA == ERZ && elementB == HUMUS || elementA == HUMUS && elementB == ERZ) ghostName = "Steinkrautling";
    else if(elementA == ERZ && elementB == EIS || elementA == EIS && elementB == ERZ) ghostName = "Gletschermaennlein";
    else if(elementA == LUFT && elementB == HUMUS || elementA == HUMUS && elementB == LUFT) ghostName = "Pollengespenst";
    else if(elementA == LUFT && elementB == EIS || elementA == EIS && elementB == LUFT) ghostName = "Schneestuermling";
    else if(elementA == HUMUS && elementB == EIS || elementA == EIS && elementB == HUMUS) ghostName = "Raureifgeist"; 
    else ghostName = "Mindergeist";

    return ghostName;
}

// Funktion zur Setzung der Widerstands-Einstellungen basierend auf den Elementen des NPCs
mapping setResistances(string elemA, string elemB)
{
    mapping resistances;
    
    resistances = ([ // Standardwerte für alle Elemente
        DT_FIRE: 0.0,
        DT_COLD: 0.0,
        DT_WATER: 0.0,
        DT_AIR: 0.0,
        DT_LIGHTNING: 0.0,
        DT_EXPLOSION: 0.0,
        DT_SOUND: 0.0,
        DT_LIGHT: 0.0,
        DT_ELECTRIC: 0.0,
        DT_ACID: 0.0,
        DT_POISON: 0.0,
        DT_TERROR: 0.0,
        DT_HOLY: 0.0,
        DT_UNHOLY: 0.0,
        DT_MAGIC: 0.0,
        DT_MIND: 0.0,
        DT_SLASH: 0.0,
        DT_BLUDGEON: 0.0,
        DT_PIERCE: 0.0,
        DT_SQUEEZE: 0.0,
        DT_WHIP: 0.0,
        DT_RIP: 0.0,
    ]);

    // Setze die Stärken und Schwächen basierend auf den Elementen des NPCs
    switch (elemA)
    {
        case FEUER: resistances[DT_WATER] = 0.5; resistances[DT_FIRE] = -0.5; break;
        case LUFT: resistances[DT_BLUDGEON] = 0.5; resistances[DT_AIR] = -0.5; break;
        case WASSER: resistances[DT_FIRE] = 0.5; resistances[DT_WATER] = -0.5; break;
        case ERZ: resistances[DT_BLUDGEON] = 0.5; resistances[DT_AIR] = -0.5; break;
        case HUMUS: resistances[DT_COLD] = 0.5; resistances[DT_POISON] = -0.5; break;
        case EIS: resistances[DT_POISON] = 0.5; resistances[DT_COLD] = -0.5; break;
        default: break;
    }

    switch (elemB)
    {
        case FEUER: resistances[DT_WATER] = 0.5; resistances[DT_FIRE] = -0.5; break;
        case LUFT: resistances[DT_BLUDGEON] = 0.5; resistances[DT_AIR] = -0.5; break;
        case WASSER: resistances[DT_FIRE] = 0.5; resistances[DT_WATER] = -0.5; break;
        case ERZ: resistances[DT_BLUDGEON] = 0.5; resistances[DT_AIR] = -0.5; break;
        case HUMUS: resistances[DT_COLD] = 0.5; resistances[DT_POISON] = -0.5; break;
        case EIS: resistances[DT_POISON] = 0.5; resistances[DT_COLD] = -0.5; break;
        default: break;
    }

    return resistances;
}


void create()
{
    if (!is_clone(TO))
        return;

    ::create();

    create_default_npc(5);
    
    SetProp(P_NAME, "Mindergeist");
    SetProp(P_SHORT, "Ein Mindergeist");
    SetProp(P_GENDER, MALE);
    SetProp(P_ARTICLE, 1);
    SetProp(P_RACE, "Elementar");
    SetProp(P_SIZE, 10);
    SetProp(P_WEIGHT, 500); // Gewicht in Gramm
    SetProp(P_ALIGN, 0);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_HEAL, 1);
    SetProp(P_AGGRESSIVE, 0);
    SetProp(P_WIMPY, 0);
    SetProp(P_NOMAGIC, 0);

    AddId(({"\ndruiden_mindergeist", "mindergeist"}));

    // Bewegungs-Einstellungen
    SetProp(P_MSGIN, "erscheint");
    SetProp(P_MSGOUT, "verschwindet");
    SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
    SetProp(P_MMSGOUT, "verschwindet mit einem Flüstern");

    // Todesnachrichten
    SetProp(P_DIE_MSG, " zerfaellt in elementare Partikel.\n");
    SetProp(P_NOCORPSE, 1);

    SetProp(P_NOATTACK, "ist koerperlos.");

}

public void setElements(string elemA, string elemB) {

    // Setze die Elemente des Geistes basierend auf den übergebenen Variablen
    elementA = elemA;
    elementB = elemB;

    // Setze den Namen und die Beschreibung des Geistes basierend auf den Elementen
    SetProp(P_NAME, generateName());
    SetProp(P_SHORT, "Ein " + QueryProp(P_NAME));
    SetProp(P_LONG, "Dieser kleine Geist ist eine mindere Elementarmanifestation aus den "
                    "Elementen " + elementA + " und " + elementB + ". Solche Mindergeister "
                    "sind eher schwachlich und oftmals ein Nebeneffekt starker elementarer "
                    "Manifestationen.");

    // Füge die Elemente als IDs hinzu
    AddId(elementA + "_geist");
    AddId(elementB + "_geist");
    AddId(lower_case(QueryProp(P_NAME)));


    // Widerstands-Einstellungen basierend auf den Elementen
    SetProp(P_RESISTANCE_STRENGTHS, setResistances(elementA, elementB));

    

    if(elementA == FEUER || elementB == FEUER) {
        SetProp(P_HANDS, ({" mit kleinen Flaemmchen", 30, DT_FIRE}) );
        SetProp(P_LIGHT, 1);
    }
    
    call_out("die", 120);
}

public varargs void setCaster(object _caster, int staerke) {
    if(!living(_caster)) return;
    if(!staerke) staerke = 1;
    if(staerke > 5) staerke = 5;

    intensity = staerke;
    caster = _caster;
    caster->AddDefender(this_object());
    caster->AddFollower(this_object());

    SetProp(P_LONG, QueryProp(P_LONG)+"Er schwirrt um " + caster->name(WEN, 1) + "herum.");
    tell_room(environment(this_object()), BS(Name(WER, 1) + " beginnt um " + caster->name(WEN, 1) + " herumzschwirren."), ({caster}));
    tell_object(caster, BS(Name(WER, 1) + " schwirrt um dich herum."));
}

public void elementEmpower(string element, object enemy) {
    string msg;

    msg = Name(WER, 1) + " ";
    switch(element) {
        case FEUER: 
            msg += "verbrennt " + enemy->name(WEN, 1)+".";
            enemy->AddHp(random(intensity * -10));
            break;
        case WASSER:
            msg += "erfrischt dich.";
            caster->AddSp(random(intensity * 5));
            break;
        case HUMUS:
            msg += "gibt dir Lebenskraft zurueck.";
            caster->AddHp(random(intensity * 5));
            break;
        case EIS:
            msg += "friert " + enemy->name(WEN, 1)+" ein.";
            enemy->SetProp(P_DISABLE_ATTACK, intensity);
            break;
        case ERZ:
            msg += "schleudert Staub und Drek in "+enemy->name(WESSEN, 1)+" Augen.";
            enemy->SetProp(P_BLIND, intensity);
            break;
        case LUFT:
            msg += "enzieht "+enemy->name(WEM, 1)+" die Luft zum Sprechen!";
            enemy->SetProp(P_DISABLE_SPELLS, intensity);
            break;
    }

    tell_object(caster, BS(msg));

    return;
}

public mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy) {
    string *dt;
    int i;

    if(random(7-intensity)) return ({dam, dam_type, spell}); // keine wirkung
    if(!pointerp(dam_type)) dt = ({dam_type});
    else dt = dam_type;

    for(i=0; i<sizeof(dt); i++) {
        if(!member(QueryProp(P_RESISTANCE_STRENGTHS), dt)) continue;

        if(QueryProp(P_RESISTANCE_STRENGTHS, dt) > 0) {
            tell_object(caster, BS(Name(WER, 1) + " schirmt dich ab!"));
            tell_room(environment(caster), BS(caster->Name(WER, 1) + " wird von " + name(WER, 1) + " abgeschirmt!"));
            call_out("die", 0, 0);
            return ({dam*0.5, dam_type, spell});
        }
    }

    if(!random(2)) {
        elementEmpower((random(2)?elementA:elementB), enemy);
        call_out("die", 0);
    }

    return ({dam, dam_type, spell});
}
