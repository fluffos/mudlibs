// Der Feuersalamander
// 2001-06-02  Feyaria@SilberLand

inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Feuersalamander");
  SetProp(P_LONG, 
      "Der Feuersalamander ist eines der maechtigsten Elementarwesen des "
      "Feuers. Nur die maechtigsten Beschwoerer sind faehig, solch eine "
      "Kreatur zu beherrschen. Er sieht aus wie eine 4 Meter lange Echse, "
      "die vollstaendig aus Flammen besteht. ");
  SetProp(P_NAME, "Feuersalamander");
  SetProp(P_GENDER, MALE);
  AddId(({"salamander", "feuersalamander"}));

  create_default_npc(30);
  SetProp(P_BODY, QueryProp(P_BODY)*2);
  SetProp(P_HANDS, ({" mit Flammen",300, DT_FIRE}));
  SetProp(P_XP, 0);
  SetProp(P_RACE, "Elementar");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:1000000]));
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_FRIEND,1);
  SetProp(P_LIGHT, 3);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_HP_DELAY, 0);
  SetProp(P_MAX_DRINK,0);
  SetProp(P_MAX_FOOD,0);
  SetProp(P_MAX_ALCOHOL,0);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_MSGIN, "brennt sich herein");
  SetProp(P_MSGOUT, "brennt sich");
  SetProp(P_MMSGIN, "entsteht aus einer Flammenexplosion");
  SetProp(P_MMSGOUT, "vergeht in einer Flammenexplosion");
  SetProp(P_DIE_MSG, " vergeht in einer Flammenexplosion!\n");
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "@WER verbrennt sofort.\n" }) );
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.5,     DT_BLUDGEON   :-0.5,     DT_RIP        :-0.5,    
    DT_SQUEEZE    :-0.5,     DT_WHIP       :-0.5,     DT_PIERCE     :-0.5,    
    DT_FIRE       :-1,       DT_COLD       :0.3,      DT_WATER      :0.3,    
    DT_AIR        :-0.3,     DT_LIGHTNING  :-0.3,     DT_EXPLOSION  :0.3, 
    DT_SOUND      :-0.7,     DT_LIGHT      :-0.5,     DT_ELECTRIC   :-0.3,    
    DT_ACID       :-0.3,     DT_POISON     :-0.7,     DT_TERROR     :-0.7,   
    DT_HOLY       :-0.5,     DT_UNHOLY     :-0.5,     DT_MAGIC      :-0.2,
    DT_MIND       :-0.5 
    ]) );

  SetProp(P_NOMAGIC,60);
  
  SetProp(P_SPELLRATE, 70);
  AddDefaultSpell( 5, 500, DS_MASS_DAMAGE,
      Name(WER,1)+" verbrennt die gesamte Umgebung!\n",
      Name(WER,1)+" verbrennt die gesamte Umgebung!\n",
      DT_FIRE);
  AddSpell(9,700,
      Name(WER,1)+" huellt Dich in Flammen ein!\n",
      Name(WER,1)+" huellt @WEN in Flammen ein!\n",
      DT_FIRE);
  AddSpell(1,1500,
      Name(WER,1)+" verwandelt Dich in ein flammendes Inferno!\n",
      Name(WER,1)+" verwandelt @WEN in ein flammendes Inferno!\n",
      DT_FIRE);
}

void init() {
  ::init();
  if(ENV(ME) && (ENV(ME)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]==TT_UNDERWATER ||
      ENV(ME)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]==TT_WATER)) 
  {
    call_out("waterdeath", 0);
    return ;
  }
}

void waterdeath() {
  say(Name(WER,1)+" bringt das Wasser zum Verdampfen!\n");
  AddHp(-random(10));;
}

void start_remove(int zeit) {
 call_out("wegbinich", zeit);
 return ;
}

void wegbinich() {
 tell_room(environment(ME), BS(Name(WER,1)+" loest sich in einer "
     "Flammenexplosion auf."));
 remove();
}


varargs void remove(int silent)
{
  object owner;
  int xp;

  xp = QueryProp(P_XP) / 133;
  if( objectp(owner = QueryProp(ELEMENTAL_OWNER)))
    owner->AddExp(xp);
  ::remove(silent);
}
//////////////////////////////////////////////////////////////////////////////
// Reactions
//////////////////////////////////////////////////////////////////////////////

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  // feuerelementare knuddeln, wuscheln ist mal keine gute idee
  if(touch)
    call_out("fire", 0);
  return;
}

void fire()
{
  tell_room(MENV, sprintf("%s verbrennt sich furchtbar an dem "
      "%s!\n%s schreit laut auf!\n", TP->Name(WER), QueryProp(P_NAME),
      TP->Name(WER)), ({TP}));
  tell_object(TP, BS(sprintf("WAHHHH! Du verbrennst Dich furchtbar an dem "
      "%s!", QueryProp(P_NAME))));
  if(TP->is_class_member(CL_TROLL))
    TP->AddHp(-random(20)+21);
  else 
    TP->AddHp(-random(20)+1); 

}
