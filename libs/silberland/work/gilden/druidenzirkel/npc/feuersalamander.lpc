  object owner;
  if(objectp(QueryProp(ELEMENTAL_OWNER))) {
    owner=find_living(getuid(QueryProp(ELEMENTAL_OWNER)));
    if(!owner || owner->QueryProp(P_GHOST)) {
      call_out("remove", 0);
      return 1;
    }
  }
  return 0;
}
*/
void InformDefend(object enemy) 
{
  Kill(enemy);
}

void BecomesNetDead(object wer) {
  if (wer==QueryProp(ELEMENTAL_OWNER)) 
    ME->remove();
}

void die(int poisondeath)
{
  ::die(poisondeath);
}

