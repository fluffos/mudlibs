/* SPELLS */


void windhose(object enemy,int damage, mixed dam_type)
{
  int i;
  object *inv;
  inv=PresentEnemies();
  damage=700+random(600);
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Eine Windhose entsteht!\n"));
  for(i=sizeof(inv)-1;i>=0;i--) { 
    if(!IS_WIZARD(inv[i]) && 
      member_array("anvar",inv[i]->QueryProp(P_IDS))==-1 &&
      (inv[i]->QueryProp(ELEMENT_CASTER)!="anvar")) {
        tell_object(inv[i], "Die Windhose von Anvar wirbelt "
         +"Dich herum.\n");
        tell_room(ENV(ME), BS(sprintf("Die Windhose von Anvar "
         +"wirbelt %s umher.\n", CAP(inv[i]->name(RAW)))), ({inv[i]}));
        inv[i]->Defend(damage, dam_type,  
         ([SP_SHOW_DAMAGE:1,SP_NAME:"Windhose"]), this_object()); 
    }
  } 
  return; 
} 

void erdbeben(object enemy,int damage, mixed dam_type)
{
  int i;
  object *inv;
  inv=PresentEnemies();
  damage=700+random(700);
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Die Erde beginnt zu beben!\n"));
  for(i=sizeof(inv)-1;i>=0;i--) { 
    if(!IS_WIZARD(inv[i]) && 
      member_array("anvar",inv[i]->QueryProp(P_IDS))==-1 &&
      (inv[i]->QueryProp(ELEMENT_CASTER))!="Anvar") {
        tell_object(inv[i], "Das Erdbeben von Anvar wirft Dich "
         +"zu Boden.\n");
        tell_room(ENV(ME), BS(sprintf("Das Erdbeben von Anvar "
         +"wirft %s zu Boden.\n", CAP(inv[i]->name(RAW)))), ({inv[i]}));
        inv[i]->Defend(damage, dam_type,  
         ([SP_SHOW_DAMAGE:1,SP_NAME:"Erdbeben"]), this_object()); 
    }
  } 
  return; 
} 

void sturmflut(object enemy,int damage, mixed dam_type)
{
  int i;
  object *inv;
  inv=PresentEnemies();
  damage=700+random(700);
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Eine Sturmflut entsteht ganz in der Naehe!\n"));
  for(i=sizeof(inv)-1;i>=0;i--) { 
    if(!IS_WIZARD(inv[i]) && 
      member_array("anvar",inv[i]->QueryProp(P_IDS))==-1 &&
      (inv[i]->QueryProp(ELEMENT_CASTER))!="Anvar") {
        tell_object(inv[i], "Die Sturmflut von Anvar bricht ueber "
         +"Dich herein.\n");
        tell_room(ENV(ME), BS(sprintf("Die Sturmflut von Anvar "
         +"bricht ueber %s herein.\n", CAP(inv[i]->name(RAW)))), ({inv[i]}));
        inv[i]->Defend(damage, dam_type,  
         ([SP_SHOW_DAMAGE:1,SP_NAME:"Sturmflut"]), this_object()); 
    }
  } 
  return; 
} 

void hagelschlag(object enemy,int damage, mixed dam_type)
{
  int i;
  object *inv;
  inv=PresentEnemies();
  damage=700+random(800);
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Ein Hagelsturm prasselt hernieder!\n"));
  for(i=sizeof(inv)-1;i>=0;i--) { 
    if(!IS_WIZARD(inv[i]) && 
      member_array("anvar",inv[i]->QueryProp(P_IDS))==-1 &&
      (inv[i]->QueryProp(ELEMENT_CASTER))!="Anvar") {
        tell_object(inv[i], "Der Hagelschlag von Anvar bricht "
         +"ueber Dich herein.\n");
        tell_room(ENV(ME), BS(sprintf("Der Hagelschlag von Anvar "
         +"bricht ueber %s herein.\n", CAP(inv[i]->name(RAW)))), ({inv[i]}));
        inv[i]->Defend(damage, dam_type,  
         ([SP_SHOW_DAMAGE:1,SP_NAME:"Hagelschlag"]), this_object()); 
    }
  } 
  return; 
} 

void feuersturm(object enemy,int damage, mixed dam_type)
{
  int i;
  object *inv;
  //inv=PresentEnemies();
  inv=filter_array(all_environment(ME), #'interactive); 
  damage=900+random(900);
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Der Feuersturm rast auf Dich zu!\n"));
  for(i=sizeof(inv)-1;i>=0;i--) { 
    if(!IS_WIZARD(inv[i]) && 
      member_array("anvar",inv[i]->QueryProp(P_IDS))==-1 &&
      (inv[i]->QueryProp(ELEMENT_CASTER))!="Anvar") 
    {
      tell_object(inv[i], "Der Feuersturm von Anvar huellt "
         +"Dich ein.\n");
      tell_room(ENV(ME), BS(sprintf("Der Feuersturm von Anvar "
         +"huellt %s ein.\n", CAP(inv[i]->name(RAW)))), ({inv[i]}));
      inv[i]->Defend(damage, dam_type,  
         ([SP_SHOW_DAMAGE:1,SP_NAME:"Feuersturm"]), this_object()); 
    }
  } 
  return; 
} 


void laehme(object enemy,int damage, mixed dam_type)
{
 int speed;
 switch(random(10)) {
   case 0:     speed=50; break;
   case 1..4:  speed=30; break;
   case 5..7:  speed=20; break;
   case 8..9:  speed=10; break;
   default: speed=50;
 }
 enemy->ModifySkillAttribute(enemy,SA_SPEED,speed,600);
 return;
}


void elementar(object enemy,int damage, mixed dam_type)
{
