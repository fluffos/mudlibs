void aergerlich6 ()
    {
    if(TP==ME) return;   
    tell_room(MENV, BS("Anvar deutet mit dem Stab auf " + TP->Name(WEN,2) 
              + "."),
              ({ TP }));
    tell_object(TP, BS("Anvar deutet mit seinem Stab auf Dich."));
    tell_room(MENV, BS("Angst durchfaehrt Deine Glieder als Du die magische "
              " Kraft der Elemente an diesem Ort zusammenfliessen spuerst."));
    call_out("aergerlich7", 4);
    }

void aergerlich7 ()
    {
    if(TP==ME) return;   
    tell_room(MENV, BS("Anvar ruft ein paar Worte in einer Fremden Sprache "
              "gen Himmel. Ein Blitz loest sich von dem Stock und huellt " +
               TP->Name(WEN,2) + " in ein sonderbares Licht."), ({ TP }));

    tell_room(MENV, BS("Anvar ruft ein paar Worte in einer Fremden Sprache "
              "gen Himmel. Ein Blitz loest sich von dem Stock und huellt " +
               "Dich in ein sonderbares Licht."), ({ TP }));    

    call_out("aergerlich8", 4);
    }

void aergerlich8 ()
    {
    if(TP==ME) return;   
    tell_object(TP, BS("Du fuehlst Dich ploetzlich so klein und "
                "unbedeutend."));
    tell_room(MENV, BS(TPN + " fuehlt sich ploetzlich so klein "
              "und unbedeutend."), ({ TP }));
    TP->SetProp(P_FROG, 1);
    TP->SetProp(P_HP, 0);
    TP->SetProp(P_SP, 0);
    in_emotion = 0;
    }  

void froh ()
    {
    tell_room(MENV, BS("Anvar grinst " + TP->Name(WEN,2) + " an."),
             ({ TP }));
    tell_object(TP, BS("Anvar grinst Dich an."));
    return;
    }

void albern ()
    {
    tell_room(MENV, BS("Anvar lacht.\nAnvar sagt: Wird denn das Kind in Dir "
              "niemals sterben, " + TPN + "?"));
    return;
    }
