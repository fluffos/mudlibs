void fies ()
    {
    string * replies;
    replies = ({ "Lass das, ",
                 "Verschwinde! Was soll das, ",
		 "Los mi auglahnt, ",
		 "Wage es nich nocheinmal, " });
    
    command_me("sag " + replies[random(sizeof(replies))] + TPN + "!");
    
    return;
    }

void boese ()
    {
    tell_object(TP, BS("Etwas ging schief. Bitte Iwo kontaktieren."));
    return;
    }

void frech ()
    {
    if (TP->QueryProp(P_FROG) == 1)
        {
        tell_room(MENV, BS("Anvar sagt: Verschwinde, Frosch!"));
        return;
        }

    tell_room(MENV, BS("Anvar blickt " + TP->Name(WEN,2) + " mit funkelnden "
              "Augen an."), ({ TP }));
    tell_object(TP, BS("Anvar blickt Dich mit funkelnden Augen an."));
    return;
    }

void traurig ()
    {
    tell_room(MENV, BS("Anvar troestet " + TP->Name(WEN,2) + "."),
              ({ TP }));
    tell_object(TP, BS("Anvar troestet Dich."));
    return;
    }

void aengstlich ()
    {
    tell_room(MENV, BS("Anvar sagt: Fuerchte Dich nicht, " + TPN + "."));
    return;
    }

void aergerlich ()
    {
    if(TP==ME) return;   
    if (in_emotion == 1) return;
    in_emotion = 1;
    TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:10,
      PARALYZE_MSG: BS("Du kannst Dich nicht bewegen vor Angst.")]));

    tell_room(MENV, BS("Mit funkelnden Augen senkt Anvar seinen "
              "Blick auf " + TP->Name(WEN,2) + " hinab."), ({ TP }));
    tell_object(TP, BS("Mit funkelnden Augen senkt Anvar seinen "
              "Blick auf Dich herab."));

    call_out("aergerlich2", 4);
    return;
    }

void aergerlich2()
    {
    if(TP==ME) return;   
    tell_room(MENV, BS(TPN + " erstarrt vor Furcht."), ({ TP }));
    tell_object(TP, BS("Du erstarrst vor Furcht."));   
    call_out("aergerlich3", 4);
    }

void aergerlich3 ()
    {
    if(TP==ME) return;   
    tell_room(MENV, BS("Seine Stimme erhebt sich zu einem "
              "gewaltigen Grollen."));
    call_out("aergerlich4", 4);
    }    

void aergerlich4 ()
    {
    if(TP==ME) return;   
    tell_room(MENV, BS("Anvar ruft: Wage es nicht nocheinmal, "+ TPN + "!"));
    call_out("aergerlich5", 4);
    }

void aergerlich5 ()
    {
    if(TP==ME) return;   
    tell_room(MENV, BS("Anvar hebt seinen Wanderstab. Furchterregende Blitze "
              "zucken ueber den Kunstvoll verzierten Knauf."));
    call_out("aergerlich6", 4);
