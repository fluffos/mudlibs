 AddInfo(({"wasserzauber"}),"@@fertigkeiten_wasser@@", "");
 AddInfo(({"humuszauber"}),"@@fertigkeiten_humus@@", "");
 AddInfo(({"eiszauber"}),"@@fertigkeiten_eis@@", "");
 AddInfo(({"luftzauber"}),"@@fertigkeiten_luft@@", "");
 AddInfo(({"erzzauber"}),"@@fertigkeiten_erz@@", "");
 AddInfo(({"sortierten fertigkeiten", "sortierten faehigkeiten"}),
     "@@fertigkeiten_sort@@", "");
 AddInfo( ({"beurteilungen", "beurteilung"}),
     "Wenn Du mich nach fertigkeiten fragst, sage ich Dir, wie gut Du die "
     "Zauber schon gelernt hast. Du kannst mich auch nach feuerzauber, "
     "wasserzauber fragen, wenn Du wissen willst, wie gut Du in einem Element "
     "bist. Und als besonderes Service kannst Du auch nach sortierten "
     "Fertigkeiten fragen, damit Du weisst, welchen Zauber Du am besten "
     "kannst.", "sagt: ");
     
/* ------------------------------------------------
        FRAGEN DIE GILDENAUFGABEN BETREFFEND
------------------------------------------------ */
  
  AddInfo(({"wirselkraut", "kraut"}), "@@test1@@", "sagt: ");
  AddInfo("kreatur", 
          "Die Kreatur nennt sich \"Silberhai\".");
  AddInfo(({"hai", "silberhai"}),
          "Suche in der Naehe von Wasser, beim Fischerdorf", "sagt: ");
  AddInfo("fischerdorf", 
          "Wenn ich Dir alles sagen wuerde, waere es keine "
         +"Aufgabe mehr.", "sagt: ");
  AddInfo("gewaechs", 
          "Es laesst sich auf einer anderen Insel "
         +"finden.", "sagt: ");
  AddInfo("insel", 
          "Tijara befindet sich auch dort. Suche dort am Kuestenweg.", "sagt: ");
  AddInfo("kuestenweg", 
          "Dort wirst Du es finden. Du musst dort alles sehr genau "
          "absuchen!", "sagt: ");
  AddInfo("adlerfeder", 
          "Eventuell im Huegelland?", "sagt: ");
  AddInfo("seelendieb", 
          "Sie leben in der Klamm der Seelen.", "erklaert: ");
  AddInfo(({"klamm", "seelen"}), 
          "Ja, und nun suche sie und toete einen von ihnen!", "sagt: ");
  AddInfo("balrog", 
          "Er soll im Bergwerk hausen.", "sagt: ");
  AddInfo(({"schuppe", "drachenschuppe"}), 
          "Eine Drachenschuppe! Hole sie, dann kannst "
         +"Du aufsteigen.", "sagt: ");
  AddInfo("elsurion", 
          "Er hat uns Druiden verraten. Toete ihn! Er lebt in "
         +"Tijara.\n", "sagt: ");
  AddInfo("tijara", 
          "Tijara liegt auf einer anderen Insel.", "sagt: ");
  AddInfo(({"szepter", "szepter der macht"}), 
          "Das Szepter der Macht befindet sich derzeit gerade in "
         +"den Haenden der Trolle. Suche es und bringe es zurueck.", 
          "sagt: ");
  AddInfo("trolle", 
          "Sie wurden im Gebirge und am Westweg gesehen.", "sagt: ");
  AddInfo(({"waffe des lichts", "waffe", "lichtkeule"}), 
          "Suche sie und bringe sie uns. Sie soll im Gebirge versteckt "
         +"sein.", "sagt: ");
  AddInfo("gebirge",
          "Suche dort im Bergwerk.", "sagt: ");
  AddInfo("bergwerk", 
          "Im Bergwerk der Zwerge soll sowohl die Waffe des Lichts "
         +"versteckt sein, als auch der Balrog hausen.", "sagt: ");
  AddInfo("kyranda", 
          "In dieser Stadt ist der schwarze Drache!", "sagt: ");
  AddInfo("drache",
          "Du musst diesen schwarzen Drachen toeten und den Hammer zu "
         +"uns bringen.", "erklaert: ");
  AddInfo("hammer", 
          "Der Hammer ermoeglicht es, jegliches Erz problemlos zu "
         +"schmieden.", "erklaert: ");
  AddInfo("haegar",
          "Haegar ist ein Schmied in Kyranda.", "sagt: ");
  AddInfo("bestie", 
          "Die gehoernte Bestie wurde zuletzt in der Naehe von "
         +"Knarkh gesehen.", "sagt: ");
  AddInfo("knarkh", 
          "Knarkh ist ein Dorf in der Naehe von Midas.", "sagt: ");
  AddInfo("heiltrank", 
          "Du kannst ihn im Feldlager bekommen.", "sagt: ");
  AddInfo("feldlager",  
          "Das Feldlager liegt oestlich von Midas.", "sagt: ");
  AddInfo("ruestungsteil", 
      "Der Legende zufolge handelt es sich dabei um Beinschienen.", "sagt: ");
  AddInfo("beinschienen", 
      "Es heisst, sie wurden vom Elementarherren des Feuers selbst "
      "erschaffen.", "sagt: ");
  AddInfo("elementarherr", 
      "Der Elementarherr des Feuers ist die Essenz des Elementes an sich.", 
      "sagt: ");


