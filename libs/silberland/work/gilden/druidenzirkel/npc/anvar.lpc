      "sagt: ");



  //AddInfo("test123", "@@zauber_info@@", "sagt: ");
  //
AddInfo("xarfai",
"Xarfai ... es ist lange her, dass ich diesen Namen hoerte. Xarfai war ... ist "
"mein Bruder. Wir beide wurden von den Elementarherren selbst in die Kunst "
"der elmentaren Magie eingeweiht. Doch Xarfai suchte immer mehr Macht und "
"verbuendete sich mit dunklen Maechten. Nur mit Hilfe des Elementarherren "
"des Erzes konnte ich ihn verbannen.", "seufzt: ");

AddInfo("bruder",
"Xarfai ... mein Bruder ... lange ist es her seit ich von ihm hoerte. ", 
"seufzt: "
);

AddInfo(({"elementarherren","ausbildung","jahrhunderte"}),
"Die Elementarherren bildenten Xarfai und mich aus. Jahrhunderte dauerte die "
"Ausbildung. Als unsere Ausbildung beendet war schickten sie uns zurueck "
"in das Silberland, um dort das Gleichgewicht zu bewahren.", "sagt: ");

AddInfo( ({"macht","maechte"}),
"Ich weiss nicht genau wie er es anstellte, aber pervertierte das eine "
"Element das alle umschloss. Der Monolith dieses Elements ist seit unserem "
"ersten Kampf zerstoert ...", "sagt: ");

AddInfo("kampf", 
"Im ersten Kampf konnte ich ihn und seinen Warlock nicht vernichten. Erst "
"im zweiten Kampf konnte ich ihn - nur mit Hilfe des Elementarherren des "
"Erzes - verbannen.", "sagt: ");

  AddInfo( ({"unausgewogenheit", "schwingungen"}),
      "Ja, ich habe sie auch gespuert. Irgendetwas hat sich veraendert, "
      "ist zurueckgekehrt, hat sich nach Jahrhunderten des Schlafes "
      "manifestiert.", "sagt: ");
  AddInfo( ({"jahrhunderten", "schlafes"}),
      "Es ist an der Zeit das Vergessene zu suchen. Ich spuere die "
      "Erschuetterung kommt aus den Tiefen des Silberlandes. Gehe "
      "hinab und suche danach. Vielleicht kannst Du herausfinden was "
      "vorgeht ...", "sagt: ");
  AddInfo( ({"vergessene"}),
      "Noch mag ich mich nicht dazu aeussern. Ich brauche erst Beweise ...",
      "fluestert geheimnisvoll: ");
  AddInfo( ({"beweise", "dagewesenes", "tiefe"}),
      "Gehe hinab und suche etwas noch nicht Dagewesenes.", "sagt: ");

/*---------------------------------------------- */
 
  SetProp(P_LOG_INFO, "gilden/anvar.log");
  // Hier werden die Infos fuer Mitglieder gesetzt
  _set_druid_info();


  AddCmd( ({"bitte", "bitte"}), "cmd_bitten");
}

int cmd_bitten(string str)
{
  notify_fail("Wen willst Du worum bitten?\n");
  if(str != "anvar um rezept")
    return 0;
  
  if(TP->QueryProp(P_GUILD) != "druidenzirkel" || 
      TP->QueryProp(P_GUILD_LEVEL) < 15)
  {
    write("Anvar sagt: Du wuerdest dieses Rezept nie verstehen!\n");
    return 1;
  }
  if(present("\nmeisterring_rezept", TP) || deep_present("meisterring", TP))
  {
    write("Anvar sagt: Du brauchst das Rezept ja gar nicht!\n");
    return 1;
  }
  write(BSA("Hoffentlich schaffst Du es, den Meisterring wiederzuerlangen. "
        "Moegen die Elemente mit Dir sein.", "Anvar sagt: "));
  write("Anvar gibt Dir das Rezept.\n");
  tell_room(MENV, "Anvar gibt " + TPN + " etwas.\n", ({TP}));
  clone_object( OBJ("meisterringmaker"))->move(TP, M_NOCHECK);
  return 1;
}

nosave void Channel(string msg) {
  CHMASTER->join("Info",TO);
  CHMASTER->send("Info",TO,msg,MSG_SAY);
}

void reset() {
  ::reset();
  perg_count=10;
  //_set_druid_info();
}

void heart_beat() {
  ::heart_beat();
  hb_time=time();
}

string pergament() {
 object ob;
 if(perg_count<1) 
    return "Tut mir leid, aber ich habe keine mehr. Komm doch "
          +"spaeter nochmal vorbei.";
 if(deep_present("pergament", TP))
   return "Aber Du hast doch schon ein Pergament.";
 ob=clone_object(OBJ("pergament"));
 ob->move(TP, M_NOCHECK);
 perg_count--;
 return "Hier!";
}



 
string queste() {
 object ob;
 if(!present(W_Q_ITEM, TP) && !(TP->QueryQuest(WIND_QUEST))) {
   ob=CLONEOB(OBJ2("windquest"));
   ob->move(TP, M_NOCHECK);
   return "Gut, mein Freund, so hoere. Vier Artefakte wurden einst "
       +"geschaffen, um die prophezeite Katastrophe abzuwenden: "
       +"Die Harfe der Winde, der Kelch des Wassers, das Schwert "
       +"des Feuers und der Stab der Erde. Diese Artefakte "
       +"wurden gut versteckt, und nur die Tapfersten, Mutigsten und "
       +"Kluegsten koennen diese Artefakte bergen. Nun, Deine "
       +"Aufgabe besteht nun darin, die Harfe der Winde zu suchen. "
       +"Die Legenden berichten, dass sie in einer sagenhaften "
       +"unterirdischem Steinwald verborgen ist, der sich irgendwo im "
       +"Gebirge befindet und von einer "
       +"Hueterin bewacht wird. Finde diese Harfe und kehre mit ihr "
       +"zurueck. Den richtigen Ort, wo dieser Wald zu finden ist, erkennst "
       +"Du an Versteinerungen in der Pflanzenwelt. "
       +"Ich muss erst die Verstecke der anderen Artefakte "
       +"lokalisieren, ich hoffe jedoch, sie bald zu erfahren."; 
 }
 if(present(W_Q_ITEM, TP))
   return "Du hilfst mir bereits.";
 if(!present(SW_Q_ITEM) && TP->QueryQuest(WIND_QUEST));
   return "Sehr gut! Leider weiss ich den Aufenthalt des "
          +"Stabes der Erde noch nicht. Komm spaeter nocheinmal "
          +"vorbei.";
}

string harfen_info() {
  if(!present(W_Q_ITEM, TP))
     return "Darueber kann ich Dir nichts sagen!!!!";
  return "Die Harfe der Winde liegt wird von einer Hueterin "
        +"bewacht. Pass gut auf, auf dass sie Dich nicht "
        +"verfuehrt!";
}


