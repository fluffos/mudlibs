 int i, present, kill;
 string ele, long;
 mixed hands;
 present=0;
 kill=0;
 //tell_room(ENV(ME), "1\n");
 inv = filter_array(all_inventory(environment(this_object())), #'living);
 for (i=sizeof(inv)-1;i>=0;i--) {
  if (inv[i]->id("elementar") &&
     (inv[i]->QueryProp(ELEMENTAL_OWNER) == this_object())) 
    present++;
 }
 if(present < 2) {
  //tell_room(ENV(ME), "2\n");
  switch(random(6)) {
   case 0: ele=EIS; break;
   case 1: ele=WASSER; break;
   case 2: ele=EIS; break;
   case 3: ele=LUFT; break;
   case 4: ele=FEUER;  break;
   case 5: ele=HUMUS;  break;
  }
  //tell_room(ENV(ME), file+"\n");
  l=clone_object(NPC("elementar"));
/*
  l->create_default_npc(23);
  l->SetProp(ELEMENT_DEFENDS, 28);
  l->SetProp(P_LONG, long);
  l->SetProp(P_HANDS, ({hands[0], 200, hands[1]}));
  l->SetProp(P_BODY, 23*5);
  l->SetProp(P_MSGOUT, "folgt "+ME->QueryProp(P_NAME));
  l->SetProp(ELEMENT_CASTER, ME->QueryProp(P_NAME));
  l->SetProp(P_FRIEND, 0);
  l->set_time(TO->QueryAttribute(A_INT)*3+ME->QueryProp(P_GUILD_LEVEL));
  ME->AddDefender(l);
  ME->AddPursuer(l);
*/
  l->Customize(ele, this_object(), 20000);
//  l->_extern_set_modus(1);
  l->SetProp(ELEMENTAL_CASTER, 0);
  l->z_kaempfen(this_object(), ({}));
  l->SetProp(ELEMENTAL_OWNER, this_object());

  //tell_room(ENV(ME), sprintf("%O\n", l));
 
  l->move(ENV(ME), M_GO); 
 }
 else tell_room(ENV(ME), BS("Nichts passiert.\n"));
}

void equip_tel(object enemy,int damage, mixed dam_type)
{
 object *inv;
 int i, nr, old_curse;
 string where, str, *rooms, *w_rooms;
 if(IS_LEARNER(enemy) || !query_once_interactive(enemy)) return;
 inv=all_inventory(enemy);
 rooms=({});
 w_rooms=({"/d/dschungel/feyaria/felseninsel/room/strand4",
         "/d/gebirge/angrox/room/ebene4/ebene4_x7y4",
         "/d/ebene/Midas/room/lagerraum",
         "/d/polar/lamuerte/eishoehle/dorf/rooms/kneipe",
         "/d/ebene/Midas/room/kanal/kanal_g7",
         "/d/ebene/lamuerte/burg/mauer/5x12y",
         "/d/polar/thor/xandim/room/lagerraum",
         "/gilden/paladine/room/burg_schatzkammer",
         "/gilden/paladine/room/burg_unten",
         "/d/kristallwald/sargola/insel/room/3",
         "/d/dschungel/feyaria/dorf/room/dorf-016",
         "/d/huegelland/feyaria/weg/room/0515",
         "/d/unterwelt/amazora/dimension/room/kneipe",
         "/d/wasser/stahldorn/knarkh/room/dorf_a7",
         "/d/dschungel/dante/stein/room/stein13",
         "/d/dschungel/dante/stein/room/stein20",
         "/d/gebirge/dante/room/kvio",
         "/d/polar/thor/berge/room/bergweg1",
         "/d/ebene/ronja/feenquest/room/verlies2",
         "/d/wasser/lupus/mauritius/room/strand24",
         "/d/unterwelt/vernichtung/eingang3",
         "/d/dschungel/dante/hoehle/room/farm",
         "/d/kristallwald/sargola/wald/room/huette",
         "/d/ebene/creative/feldlager/room/zelte/a7_a0_g",
         "/d/wasser/woody/fischerdorf/room/hinterhof", 
         "/d/dschungel/feyaria/dorf/room/lich-016",
         "/d/unterwelt/nekromanten/room/acid_lake/buchinsel",
         "/d/unterwelt/nekromanten/room/yaq-monoq/e4",
         });
 /*
         "/d/gebirge/dante/room/kvio",
         "/d/ebene/ronja/feenquest/room/verlies2",
         "/d/wasser/lupus/mauritius/room/strand24",
         "/d/unterwelt/vernichtung/eingang3",
    */
  for(i=sizeof(w_rooms)-1;i>=0;i--) {
     if(!catch(call_other(w_rooms[i], "???", 0))) 
       rooms+=({w_rooms[i]});
  }
  enemy->command_me("unali lass");
  enemy->command_me("lass alles fallen");
  if(enemy->QueryProp(P_WEAPON))
     (enemy->QueryProp(P_WEAPON))->DoUnwield(1);
  for(i=sizeof(inv)-1;i>=0;i--) {
    if(!inv[i]->QueryProp(P_NEVERDROP)&& !inv[i]->QueryProp(P_NODROP)) {
      nr=random(sizeof(rooms));
      if(inv[i]->QueryProp(P_WORN)==enemy) {
        old_curse=inv[i]->QueryProp(P_CURSED);
        inv[i]->SetProp(P_CURSED,0);
        if(inv[i]->QueryProp(P_WORN)) {
          inv[i]->DoUnwear(1);
          inv[i]->SetProp(P_WORN, 0);
          enemy->SetProp(P_ARMOURS, enemy->QueryProp(P_ARMOURS)-({inv[i]}));
        }
        inv[i]->SetProp(P_CURSED,old_curse);
        inv[i]->SetProp(P_WORN, 0);
      }
      inv[i]->move(rooms[nr], M_NOCHECK|M_SILENT);
      if((inv[i]->QueryProp(P_AMOUNT))>1) str="en";
      else str="t"; 
      tell_room(rooms[nr], sprintf("Ploetzlich materialisier%s sich %s "
            +"im Raum!\n", str, inv[i]->name(WER)));
    }
  }

}


void init()
{
  if(QueryProp(P_WIMPY)) SetProp(P_WIMPY, 0);
  if (member(reactionstats, PO)!=-1 && reactionstats[PO, 0] > SCHWELLE) 
    Kill(TP);
  ::init();
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if( killer == TO )
    write_file(LOG ("anvar.kills"),
       sprintf( ctime()+": Anvar hat gerade "+CAP(getuid(player))
       +" umgebracht - %d EP!\n", lostexp));
 return ;
}

void die(int poisondeath) {
  object ob;
  if((time()-hb_time)>4) { // dann war der HB wohl weg
    heal_self(3000);
    return; 
  }
  write_file(LOG("anvar.kills"),
      dtime(time())+": "+CAP(getuid(TP))+" toetet Anvar.\n");
  if(ob=present("elementarpanzer", TO))
  ob->panzer_weg(300);
  ::die(poisondeath);
}


/* AttackChats Attacken! */ 
string AttackLight()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Anvar laesst Feuer auf "
      + capitalize(en->name()) + " niederprasseln."), ({en}));
    tell_object(en, "Anvar laesst Feuer auf Dich niederprasseln.\n");
    en->Defend(100+random(300), DT_FIRE,
        ([SP_NAME:"Feuerregen", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

string AttackMedium()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Anvar laesst Erzbrocken auf "
      + capitalize(en->name()) + " niederprasseln."), ({en}));
    tell_object(en, "Anvar laesst Erzbrocken auf Dich niederprasseln.\n");
    en->Defend(200+random(400), DT_BLUDGEON,
        ([SP_NAME:"Erzbrocken", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

string AttackSerious()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Anvar laesst toedliche Eisbrocken auf "
      + capitalize(en->name()) + " niederprasseln."), ({en}));
    tell_object(en, "Anvar laesst toedliche Eisbrocken auf Dich "
      +"niederprasseln.\n");
    en->Defend(300+random(500), DT_COLD,
        ([SP_NAME:"Eisbrocken", SP_SHOW_DAMAGE:1]), TO);
    en->SetProp(P_PARALYZED,2);
  }
  return "";
}

string AttackBlast()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Anvar beschwoert das Element Humus und "
      + "vergiftet "+capitalize(en->name()) + "."), ({en}));
    tell_object(en, "Anvar beschwoert das Element Humus und vergiftet Dich.\n");
    en->AddPoison(random(7)+1);
  }
  return "";
}

Defend(int dam, string dam_type, mixed spell, object enemy)
{
 if(enemy->id("elementar"))
 {
   say("Anvar blickt " + enemy->name(WEN) + " befehlend an.\n");
   enemy->remove();
   return;
 }
 ::Defend(dam, dam_type, spell, enemy);
}


void _set_druid_info() {
  mapping druids;
  string *legendary, *names, err;
  string number_one, text;
  int i, gender;
   
  text="%s dient dem Element %O und hat bereits Gildenstufe %O erreicht.";
  druids=call_other(DRUIDENMASTER, "QueryAll");
  number_one=call_other(DRUIDENMASTER, "QueryNumberOne");
  legendary=call_other(DRUIDENMASTER, "QueryLegendary");
  names=m_indices(druids);
  if(!pointerp(names)) return;
  for(i=sizeof(druids)-1;i>=0;i--) {
    if(stringp(druids[names[i],16]) && 
        member(({"angrox", "creative"}),names[i])==-1)
    {
      err=catch(RemoveInfo(names[i]));
      if(err) {
        tdm(sprintf("Fehler in Anvar, RemoveInfo, name:%s, element:"
              "%s, gstufe:%d, Fehler: %s\n", names[i], capitalize(druids[names[i], 16]), druids[names[i], 1], err));
      }
      if(names[i]=="yeza") {
        err=catch(AddInfo(({"yeza"}), 
                "Yeza ist meine beste Schuelerin. Bei ihr bin ich mir "
                "sicher, dass sie dereinst so maechtig wie ich wird.", 
                "sagt voller Stolz: "));
      }
      else {
        err=catch(AddInfo(({names[i]}), sprintf(text, CAP(names[i]), 
              capitalize(druids[names[i], 16]), druids[names[i], 1]), 
              "sagt: "));
      }
      if(err) {
        tdm(sprintf("Fehler in Anvar, AddInfo, name: %s, "
              "Fehler: %s\n", names[i], err));
      }
    }
  }
}

/* --------------------------------------------------------- *
 *                      R E A C T I O N S                    *
 * --------------------------------------------------------- */


int MakeSauer(object player)
{
  int lh;
  
  if (member(reactionstats, TP)== -1)
    reactionstats += ([ TP, 0 ]);

  reactionstats[TP, 0]++;
  
  if (reactionstats[TP, 0] == SCHWELLE - 1)
    {
      command_me("sag Nocheinmal und ich werde Dich toeten, " + TPN + "!");
    }
  if (reactionstats[TP, 0] >= SCHWELLE)
  {
    lh = TP->QueryProp(P_ALIGN);
    if (lh > -800) TP->SetProp(P_ALIGN, lh-200);
    Kill(TP);
    return 1;
  }
  return 0;
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
    {
    
    /*
     * Ok, zuerstmal zerlegen den mist und die
     * passende function dazu aufrufen
     */
    switch (gruppe)
        {
        case "nett":
            if(find_call_out("gut") != -1) return;
            call_out("gut",0);
            break;
        case "gut":
            if(find_call_out("gut") != -1) return;
            call_out("gut", 0);
            break;
        case "intim":
            if(find_call_out("intim") != -1) return;
            call_out("intim", 0);
            break;
        case "fies":
	          if (MakeSauer(TP)) break;
            if(find_call_out("fies") != -1) return;
            call_out("fies", 0);
            break;
        case "boese":
	          if (MakeSauer(TP)) break;
            if(find_call_out("boese") != -1) return;
            call_out("boese", 0);
            break;
        case "frech":
            if(find_call_out("frech") != -1) return;
            call_out("frech", 0);
            break;
        case "traurig":
            if(find_call_out("traurig") != -1) return;
            call_out("traurig", 0);
            break;
        case "aengstlich":
            if(find_call_out("aengstlich") != -1) return;
            call_out("aengstlich", 0);
            break;
        case "aergerlich":
	          if (MakeSauer(TP)) break;
            if(find_call_out("aergerlich") != -1) return;
            call_out("aergerlich", 0);
            break;
        case "froh":
            if(find_call_out("froh") != -1) return;
            call_out("froh", 0);
            break;
        case "albern":
            if(find_call_out("albern") != -1) return;
            call_out("albern", 0);
            break;
        default:
            break;
        }
    }

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
    {
    return StartReaction(verb, gruppe, adverb, touch);
    }

void gut()
    {
    string * replies;
    /* wenn der Spieler net da iss damma nix */
    if (!present(TP,MENV)) return;

    /* damits net fad wird verschiedene replies */
    replies = ({ "Moege die Macht der Elemente Dich begleiten, ",
                 "Kraft der Elemente! Beschuetze ",
                 "Moegen die Elemente Dich schuetzen, " });

    command_me("sag " + replies[random(sizeof(replies))] + TPN + "!");
    }


