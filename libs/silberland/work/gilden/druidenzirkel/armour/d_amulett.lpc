void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  std_service=([FEUER:4,WASSER:4,EIS:4,HUMUS:4,LUFT:4,ERZ:4]);
  service=copy_mapping(std_service);
  akt_lvl=set_bit(akt_lvl, 1);
  akt_lvl=set_bit(akt_lvl, 0);
  service=([FEUER:0,WASSER:0,EIS:0,HUMUS:0,LUFT:0,ERZ:0]);
  std_colors=({ANSI_GREEN, ANSI_YELLOW, ANSI_CYAN, ANSI_BLUE, ANSI_RED});
  report_colors=call_other(DRUIDENMASTER, "QueryColors", TP);
  if(!pointerp(report_colors) || !sizeof(report_colors)) 
    report_colors=std_colors;
  SetProp(P_SHORT, "Das Druidenamulett");
  SetProp(P_LONG, BS( 
    "Das Amulett ist der Fokus eines jeden Druiden, ohne den das "
   "Beherrschen der Elemente unmoeglich wird. Das Amulett besteht aus "
   "schwarzem Obsidian und haengt an einer Lederschnur. Mit 'dhilfe' "
   "bekommst Du Informationen ueber die Funktionsweise des Amuletts."));
  AddDetail("Obsisdian",
    "Der Obsidian ist schwarz.");
  SetProp(P_NAME, "Druidenamulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", "druidenamulett", "\ndruidenamulett"}) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_OBSIDIAN:50, MAT_LEATHER:10, MAT_MISC_MAGIC:40]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 800+random(100) );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NO_DAMAGE_DESTRUCT, 1);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MAGIC, 1);
  SetProp(P_CURSED, 0);
  SetProp(P_WORN_TEXT, "um den Hals getragen");
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_QUALITY_DECAY, 0);
  
  AddCmd(({"drufe", "druf"}), "guild_shout");
  AddCmd ("dkwer", "dkwer");
  AddCmd ("dwer", "dwer");
  AddCmd("dreport", "Report");
  AddCmd(({"dwink", "dwinke"}), "dwinken");
  AddCmd(({"dknuddle", "dknuddel"}), "dknuddeln");
  AddCmd("machtwort", "dtele");
  AddCmd(({"dhist", "dhistory"}), "ShowHistory");
  AddCmd(({"dhilfe"}),               "dhilfe");
  AddCmd(({"dstatus"}),              "Status");
  AddCmd(({"ddienste"}),             "ElementarDienste");
  AddCmd(({"dzauberfarben"}),        "Spellcolors");
  AddCmd(({"dfarben"}),              "SetColors");

  seteuid(getuid());                    // fuer 'dhilfe druf'
}


void init() {
  object ob;
  ::init();
  if(!living(MENV))
    call_out("remove",0);
  if(MENV->QueryProp(P_GUILD)!= "druidenzirkel" && !IS_WIZARD(MENV) ) {
    write("Das Amulett loest sich zischend auf!\n");
    call_out("remove",0);
    return;
  }
  if(TP!=MENV) return 0;
  if( present("\ndruidenamulett 2", MENV) ) { 
    write("Ein Druidenamulett loest sich zischend auf!\n");
    call_out("remove",0);
    return;
  }
  if(!QueryProp(P_WORN)) {
    MENV->SetProp(P_WEAR_FUNC, TO);
    MENV->SetProp(P_WIELD_FUNC, TO);
    MENV->SetProp(P_UNWIELD_FUNC, TO);
    MENV->SetProp(P_REMOVE_FUNC, TO);
    DoWear();
    tell_object(MENV, "Du fuehlst elementare Macht durch Dich fliessen.\n");
    SetListener(1);
    if (call_other(DRUIDENMASTER, "GetDruidElement", MENV) == "geist")
      element_ghost = 1;
  }
}


void CalcNewServices() {
  int i;
  string *e;
  e=m_indices(std_service);
  for(i=sizeof(e)-1;i>=0;i--) {
    service[e[i]]+=5;
    if(service[e[i]] > std_service[e[i]])
      service[e[i]]=std_service[e[i]];
  }
}

void reset() {
  ::reset();
  if(!ENV(ME) || (!query_once_interactive(ENV(ME)) && !living(ENV(ME))))
  {
    remove();
    return;
  }
  set_next_reset(3400);
  if(teleportation<2)
     teleportation++;
  else teleportation=2;
  lvl_sixteen=1; // Fuer stufe 16
  if(QueryProp(P_WORN))
    catch(QueryProp(P_WORN)->RemovePursuer(0));
  CalcNewServices();
  //service=copy_mapping(std_service);
  switch(call_other(DRUIDENMASTER,"GetDruidElement",MENV)) {
    case "erz":    service[ERZ]+=3; service[LUFT]-=2; break;
    case "eis":    service[EIS]+=3; service[HUMUS]-=2; break;
    case "feuer":  service[FEUER]+=3; service[WASSER]-=2; break;
    case "wasser": service[WASSER]+=3; service[FEUER]-=2; break;
    case "luft":   service[LUFT]+=3; service[ERZ]-=2; break;
    case "humus":  service[HUMUS]+=3; service[EIS]-=2; break;
  }
}

public void deactivateElementalAdjustment(object wer) {
  if(HAS_MYSTERY(wer, MYSTERY_ELEMENTAL_ADJUSTMENT)) {
    tell_object(wer, BS("Dein elementarer Schutz verlaesst dich."));
    wer->RemoveResistanceModifier("elemental_adjustment");
    wer->UpdateResistanceStrengths();
  }
}

public void deactivateElementalResistance(object wer) {
  if(HAS_MYSTERY(wer, MYSTERY_ELEMENTAL_RESISTANCE)) {
    tell_object(wer, BS("Dein elementarer Widerstand erlischt."));
    wer->RemoveResistanceModifier("elemental_resistance");
    wer->UpdateResistanceStrengths();
  }
}


void BecomesNetDead(object wer) {
  if(wer != MENV) return;
  deactivateElementalAdjustment(wer);
  deactivateElementalResistance(wer);  
}

void BecomesNetAlive(object wer) {
  if(wer != MENV) return;

  call_out("welcome", 2, wer);

  if(HAS_MYSTERY(wer, MYSTERY_ELEMENTAL_ADJUSTMENT)) {
    call_out("elemental_adjustment", 0, wer);
  }

  if(HAS_MYSTERY(wer, MYSTERY_ELEMENTAL_RESISTANCE)) {
    call_out("elemental_resistance", 0, wer);
  }
}

public void elemental_adjustment(object pl) {
  string element;
  if(!HAS_MYSTERY(pl, MYSTERY_ELEMENTAL_RESISTANCE)) return;

  element = DRUIDENMASTER->GetDruidElement(pl);
  pl->AddResistanceModifier(([ELEMENT_DAMAGE[element]: pl->QueryProp(P_GUILD_LEVEL)*-0.005]), "elemental_adjustment");
  pl->UpdateResistanceStrengths();
  DRUIDENSPELLS->write_color(BS("Dein Astralkoerpert passt sich an das Element "+CAP(element)+" an. Du bist nun davor geschuetzt."), element, pl, 1);
}

public void elemental_resistance(object pl) {
  string element;
  if(!HAS_MYSTERY(pl, MYSTERY_ELEMENTAL_RESISTANCE)) return;
  element = COMPLEMENT_ELEMENTS[DRUIDENMASTER->GetDruidElement(pl)];
  pl->AddResistanceModifier(([ELEMENT_DAMAGE[element]: pl->QueryProp(P_GUILD_LEVEL)*-0.005]), "elemental_resistance");
  pl->UpdateResistanceStrengths();
  DRUIDENSPELLS->write_color(BS("Dein Astralkoerpert stemmt sich gegen das Element "+CAP(element)+" an. Du bist nun davor geschuetzt."), element, pl, 1);
}

void welcome(object wer)
{
  if(time()-lastlogin > 1000 && !IS_WIZARD(wer)) {
    wer->Message(BSA(sprintf(
            ({"Willkommen, %s!",
             "Die Macht der Elemente mit Dir, %s!",
             "Sei willkommen, %s!" })[random(3)], wer->Name()), 
          "Anvar teilt Dir mit: "), MSGFLAG_TELL);
  }
  lastlogin=time();
  if(aktiv) {
    wer->RemoveHpHook(ME);
    activate(wer);
  }
}

string _query_info() {
   object pl;
   string text;
   text="Das Amulett dient als Fokus der Zauberkraft. Folgende "
        "Kommandos stehen Dir zur Verfuegung: drufe, dhist, dknuddel, "
        "dwinke, dwer <ort>, dkwer, dreport <ein|aus>, dstatus, ddienste, "
        "dzauberfarben, dfarben";
   if(member(call_other(DRUIDENMASTER, "QueryNumberOne") + 
             call_other(DRUIDENMASTER, "QueryLegendary"), getuid(TP))!=-1 ||
      TP->QueryProp(P_TESTPLAYER) || IS_WIZARD(TP) )
     text+=", und fuer Dich als Meisterdruiden: machtwort.";
   return text;
}

public void activate_waterbreath() {
  if(id(WATERBREATH)) return;

  tell_object(MENV, BS("Die Elementarkraft des Wassers durchstroemt dich. Du kannst nun unter Wasser atmen."));
  AddId(WATERBREATH);
  return;
}

public void deactivate_waterbreath() {
  if(!id(WATERBREATH)) return;
  RemoveId(WATERBREATH);
  tell_object(MENV, BS("Du kannst nicht mehr unter Wasser atmen."));
}

int WearFunc(object ob) {
  object pl;
  if( TP->QueryProp(P_GUILD)!= "druidenzirkel" && !IS_WIZARD(TP)) {
    write("Das Amulett loest sich zischend auf!\n");
    call_out("remove",0);
    return 1;
  }
  if(hands_changed && (ob->QueryProp(P_ARMOUR_TYPE))==AT_SHIELD) {
    write(BS("Du kannst im Moment kein Schild tragen!\n"));
    return 0;
  } 
  if(ob == TO)
  {
    call_out("SetRes", 0);
    if (MENV->QueryProp(P_GUILD) == "druidenzirkel")
      call_out("activate", 0, MENV);
    SetListener(1);
    call_out("elemental_adjustment", 0, MENV);
    call_out("elemental_resistance", 0, MENV);
    
    if(HAS_MYSTERY(MENV, MYSTERY_WATERBREATH)) {
      call_out("activate_waterbreath", 0);
    }

    if(HAS_MYSTERY(MENV, MYSTERY_GLIDE) && !MENV->is_class_member(CL_FLYING)) {
      tell_object(MENV, BS("Elementare Stroeme der Luft tragen dich nach oben. Du beginnst leicht zu schweben."));
      MENV->AddClass(CL_FLYING);
    }

    if(HAS_MYSTERY(MENV, MYSTERY_WINDGHOSTS)) {
      tell_object(MENV, BS("Verspielte Windgeister sausen durch deine Kleidung. Du fuehlst dich leichter."));
      SetProp(P_WEIGHT, MENV->QueryProp(P_GUILD_LEVEL) * -1000);
    }
  }
  return 1;
}

int RemoveFunc(object ob, int silent) {
  object pl;
  int var;
  if(!pl = QueryProp(P_WORN)) return 1;
  if(ob == TO)
  {
    pl->RemoveResistanceModifier("druidenamulett");
    SetListener(0);
    deactivateElementalAdjustment(pl);
    deactivateElementalResistance(pl);
    call_out("deactivate_waterbreath", 0);

    if(HAS_MYSTERY(MENV, MYSTERY_GLIDE) && MENV->QueryProp(P_RACE) != "Fee") {
      tell_object(MENV, BS("Die elementaren Luftstroeme versiegen. Du schwebst nun nicht mehr."));
      MENV->RemoveClass(CL_FLYING);
    }

    SetProp(P_WEIGHT, 50);
  }
  if(pl->QueryProp(P_GUILD)!= "druidenzirkel" && IS_WIZARD(pl)) 
    return 1;
  if(var=call_other(DRUIDENSPELLS, "QueryMetal", ob)) {
    if (!silent)
      write(BS("Du ziehst "+ob->name(WEN)+" aus, fuehlst Dich immer "
        "noch zu unkonzentriert zum Zaubern!"));
    if(TP) {
      if(TP->QueryProp(P_NEXT_SPELL_TIME)<(time()+(int)var/100))
        TP->SetProp(P_NEXT_SPELL_TIME, time()+(int)var/100);
      else 
        TP->SetProp(P_NEXT_SPELL_TIME, TP->QueryProp(P_NEXT_SPELL_TIME)+
            (int)var/100);
    }
  }
  return 1;
}

int UnwieldFunc(object ob) {
  int var;
  string err;
  object pl;
  if(!pl = ob->QueryProp(P_WIELDED)) return 1;
  if( pl->QueryProp(P_GUILD)!= "druidenzirkel" && IS_WIZARD(pl)) 
    return 1;
  if(var=call_other(DRUIDENSPELLS, "QueryMetal", ob)) {
    tell_object(pl, BS("Du steckst die Waffe weg, fuehlst Dich aber "
        "noch zu unkonzentriert zum Zaubern!"));
    if(pl->QueryProp(P_NEXT_SPELL_TIME)<(time()+(int)var/100))
      pl->SetProp(P_NEXT_SPELL_TIME, time()+(int)var/100);
    else 
      pl->SetProp(P_NEXT_SPELL_TIME, pl->QueryProp(P_NEXT_SPELL_TIME)+
          (int)var/100);
  }
  return 1;
}

int WieldFunc(object ob) {
  int var;
  if(!MENV || (IS_WIZARD(MENV) && MENV->QueryProp(P_GUILD) != "druidenzirkel")) 
    return 1;
  if(MENV->QueryProp(P_GUILD)!= "druidenzirkel") {
    tell_object(MENV, "Wie kommst DU denn zu einem Druidenamulett?\n");
    call_out("remove",0);
    return 1;
  }
  if(hands_changed) {
   tell_object(MENV, BS("Du kannst im Moment keine Waffe zuecken."));
   return 0;
  }
  
  if((ob->QueryMaterialGroup(MATGROUP_METAL)>10)) {
    tell_object(MENV, BS("Du spuerst wie das Ungleichgewicht der Elemente "
              +"Deine Konzentration stoert!\n"));
  }
  return 1; 
}

int SetService(string ele, int value) {
  object env;  
  if(getuid(PO)!="GUILD.druidenzirkel"){
    env=objectp(QueryProp(P_WORN))?QueryProp(P_WORN):(MENV?MENV:ME);
    TELL("angrox", sprintf("** DAMULETT: SetService von %O, uid %s an %s (%s -> %d)\n",
          PO, getuid(PO), getuid(env), ele, value));
    write_file(LOG("druidenamulett.log"), sprintf("%s: SetService von "
          "%O, uid %s an %s (%s -> %d)\n", dtime(time()), PO, getuid(PO), 
          getuid(env), ele, value));
  }
  service[ele]=value;
  return 1;
}

int SetStdServices(int fi, int wa, int ei, int hu, int lu, int er) {
  mapping new_services;
  object env;  
  new_services=([FEUER:0,WASSER:0,EIS:0,HUMUS:0,LUFT:0,ERZ:0]);
  if(fi==-1) 
    new_services[FEUER]=std_service[FEUER];
  else 
    new_services[FEUER]=fi;
  if(wa==-1) 
    new_services[WASSER]=std_service[WASSER];
  else 
    new_services[WASSER]=wa;
  if(ei==-1) 
    new_services[EIS]=std_service[EIS];
  else 
    new_services[EIS]=ei;
  if(hu==-1) 
    new_services[HUMUS]=std_service[HUMUS];
  else 
    new_services[HUMUS]=hu;
  if(lu==-1) 
    new_services[LUFT]=std_service[LUFT];
  else 
    new_services[LUFT]=lu;
  if(er==-1) 
    new_services[ERZ]=std_service[ERZ];
  else 
    new_services[ERZ]=er;
  if(getuid(PO)!="GUILD.druidenzirkel"){
    env=objectp(QueryProp(P_WORN))?QueryProp(P_WORN):(MENV?MENV:ME);
    TELL("angrox",(sprintf("** DAMULETT: SetStdServices von "
          "%O, uid %s an %s (%d, %d, %d, %d, %d, %d)\n", PO, 
          getuid(PO), getuid(env), fi, wa, ei, hu, lu, er)));
    write_file(LOG("druidenamulett.log"), sprintf("%s: SetStdServices von "
          "%O, uid %s an %s (%d, %d, %d, %d, %d, %d)\n", dtime(time()), PO, 
          getuid(PO), getuid(env), fi, wa, ei, hu, lu, er));
  }
  std_service=copy_mapping(new_services);
  return 1;
}

int SetWornMetal(int x) {
  worn_metal=x;
}

int QueryWornMetal() {
  return worn_metal;
}

int DoSetHands(int duration) {
  hands_changed=1;

  if(HAS_MYSTERY(owner, MYSTERY_POISIONOUS_THORNS) && !owner->QueryProp(P_TMP_ATTACK_HOOK)) {
    owner->SetProp(P_TMP_ATTACK_HOOK, ({time()+duration, TO, "poisonousThorns"}));
    tell_object(owner, BS("Bunte und giftige Blueten spriessen aus den Dornenranken um deine Haende."));
  }

  if(HAS_MYSTERY(owner, MYSTERY_SHATTERING_STRIKES) &&  !owner->QueryProp(P_TMP_ATTACK_HOOK)) {
    owner->SetProp(P_TMP_ATTACK_HOOK, ({time()+duration, TO, "shatteringStrike"}));
    tell_object(owner, BS("Der Erzmantel um deine Haende bildet harte Wucherungen aus, um die Panzerung deiner Gegner zu zertruemmern."));
  }

  return 1;
}

public int shatteringStrike(object enemy) {
  int dc, reduction;

  if(!owner->QueryProp(E_HANDS)) {
    owner->SetProp(P_TMP_ATTACK_HOOK, 0);
    return 1;
  }

  dc = 13-(owner->QuerySkillAbility(FIGHT(WT_HANDS))/1000);
  if(IS_LEARNER(owner)) {
    tell_object(owner, sprintf("shattering strike :: chance = 1:%d\n", dc));
  }
  if(!random(dc) && !query_once_interactive(enemy) && enemy->QueryProp(P_BODY) > 10) {
    reduction = owner->QueryProp(P_GUILD_LEVEL) + owner->QuerySkillAbility(FIGHT(WT_HANDS)) / 1000 + owner->QueryAttribute(A_STR)/2;
    tell_object(owner, BS(sprintf("Mit einem maechtigen Hieb zertruemmerst du die Verteidigung von %s.", enemy->name(WEM, 1))));
    tell_room(ENV(owner), BS(sprintf("%s zertruemmert die Verteidigung von %s mit einem kraeftigen Hieb.",
              owner->Name(WER, 1), enemy->name(WEM, 1))), ({owner}));
    enemy->SetProp(P_BODY, enemy->QueryProp(P_BODY) - reduction);
  }

  return 1;
}

public int poisonousThorns(object enemy) {
  int dc;

  if(!owner->QueryProp(E_HANDS)) {
    owner->SetProp(P_TMP_ATTACK_HOOK, 0);
    return 1;
  }

  if( (enemy->QueryProp(P_POISON) < (owner->QueryProp(P_GUILD_LEVEL) / 4)) && !random(5)) {
    dc = owner->QueryProp(P_GUILD_LEVEL) + owner->QuerySkillAbility(FIGHT(WT_HANDS)) / 1000 + owner->QueryAttribute(A_DEX);
    if(IS_LEARNER(owner)) {
      tell_object(owner, sprintf("poison thorns :: dc = %d\n", dc));
    }
    if(random(enemy->QueryAttribute(A_DEX)) < dc) {
      tell_room(environment(enemy), BS(enemy->Name(WER, 1) + " vergiftet sich an " + owner->name(WESSEN, 1) + " Dornen."), ({owner}));
      tell_object(owner, BS(enemy->Name(WER, 1) + " vergiftet sich an deinen Dornen."));
      enemy->AddPoison(1);
    }
  }

  return 1;
}

int RemoveSetHands() {
  hands_changed=0;
  return 1;
}

int CheckHands() {
  return hands_changed;
}

int Query16() {
  return lvl_sixteen;
}

string QueryVersion() {
  return LATEST_AMULET_VERSION;
}

int Del16() {
  lvl_sixteen=0;
  return 1;
}

//  Element Geist - Vorteile noch vorhanden?, bzw setzen wir es
int SetGhost(int time) {
  element_ghost=time;
  informed = 0;
  return 1;
}

int QueryGhost() {
  if(time()<element_ghost)
    return element_ghost-time();
  if (!informed)
    tell_object(MENV, 
        "Du fuehlst Dich unkonzentriert. Du musst wieder meditieren.\n");
    informed = 1;
  return 0;
}

mixed QueryAllServices() {
  return ({ std_service, service });
}

int QueryService(string element) {
  return service[element];
}

int ChangeService(string element, int value) {
  service[element]+=value;
  if(service[element]<0) service[element]=0;
  return service[element]; 
}

//
// Gildeninterner Ruf -> Speichern im Master
//
nosave int guild_shout(string str) {
  int i, no_msg, invis, no_colors;
  object *members;
  string *presay, *ignores, pre, std_pre;
  no_msg=0;
  if(ENV(ME) && living(ENV(ME)) && !interactive(ENV(ME)) && TI) {
    if(!IS_ARCH(TI)) {
      return 0;
    }
  }
  notify_fail("Was moechtest Du den anderen Druiden mitteilen?\n");
  if (!stringp(str)) 
    return 0;
  members=filter_array(users(), "IsListener");
  if(member(DRUIDENPAPAS, getuid(TP))!=-1)
    presay=({"Druidenpapa","Druidenpapa ", "Druidenmama "});
  else {
    if(call_other(GUILD_MASTER, "QueryNumberOne") && 
       member(call_other(GUILD_MASTER, "QueryNumberOne"), getuid(TP))!=-1)
      presay=({"Meisterdruidenetwas ", "Meisterdruide ", "Meisterdruidin "});
    else if(member(call_other(DRUIDENMASTER, "QueryLegendary"), getuid(TP))!=-1)
      presay=({"Das legendaere Druidenetwas ", "Der legendaere Druide ", "Die legendaere Druidin "});
    else if(!is_clone(TP) && !TP->QueryProp(P_FROG))
      presay=({"Druidenetwas ", "Druide ", "Druidin "});
    else 
      presay=({"",""});
  }
  std_pre=presay[TP->QueryProp(P_GENDER)]+TP->name(WER)+" teilt euch mit: ";
  if(TP->QueryProp(P_INVIS)) {
    invis=1;
    std_pre="("+CAP(getuid(TP))+") teilt euch mit: ";
  }
  else {
    std_pre=presay[TP->QueryProp(P_GENDER)]+TP->name(WER)+
      " teilt euch mit: ";
    invis=-1;
  }
  for(i=sizeof(members)-1;i>=0; i--) {
    if(members[i]==TP) {
      write(expand_color_strings(TP->_unparsed_args(),
           "Du teilst den Druiden mit: ", TP));
    } else {
      ignores=members[i]->QueryProp(P_IGNORE); // check der ignores
      if(sizeof(ignores)) { 
        if(member(ignores, "drufe")!=-1 || member(ignores, "druf") != -1||
              member(ignores,"drufe_"+getuid(members[i]))!=-1) 
        {
          no_msg=1;
        }
        else no_msg=0;
        if(member(ignores, "drufe_farben")!=-1) no_colors=1;
        else no_colors=0;
      }
      if (members[i]->QueryProp(P_DEAF) && !IS_WIZARD(members[i])) 
        no_msg=1;
      if(!no_msg) {
        if(TP->QueryProp(P_INVIS) && !IS_WIZARD(members[i]))
          pre="Ein unsichtbarer Druide teilt Euch mit: ";
        else if(TP->QueryProp(P_INVIS) && IS_WIZARD(members[i]))
          pre="("+CAP(getuid(TP))+") teilt Euch mit: ";  
        else     
          pre=presay[TP->QueryProp(P_GENDER)]+TP->Name(WER)+
                   " teilt Euch mit: ";
        if(interactive(TP)) {
          tell_object(members[i], color_tell(TP->_unparsed_args(),
                pre, members[i], no_colors));
        } 
        else {
          tell_object(members[i], color_tell(str,pre,members[i],
                no_colors));
        }
      }
    }
  }
  if(interactive(TP)) {
    call_other(GUILD_MASTER, "AddHistory",std_pre,  
        color_tell(TP->_unparsed_args(), "", ""), invis); 
  } 
  else {
    call_other(GUILD_MASTER, "AddHistory",std_pre, 
        color_tell(str, "", ""));
                                      // speichern
  }
  return 1;
}


nosave int ShowHistory(string str)
{
  int i, n;
  string *msgs, txt;
  mixed *history;
  mixed *hist_time;

  history = call_other(GUILD_MASTER, "QueryHistory");
  hist_time = history[0];
  history = history[1];

  if (sizeof(history)==0)
  {
    write("Die Druiden haben Dir noch nichts mitgeteilt.\n");
    return 1;
  }

  if (str)
    if ((to_string(n = to_int(str)) == str) && (n > 0))
    {
      history = history[<n..];
      hist_time = hist_time[<n..];
      str = 0;
    }
    else
      str = lower_case(TP->_unparsed_args());

  txt="Das haben Dir die anderen Druiden mitgeteilt:\n";
  txt+="-----------------------------------------------"
       +"-------------------------------\n";

  for(i=0;i<=sizeof(history)-1;i++)
  {
    msgs = explode(history[i],"&&*%%");

    if (str && (strstr(lower_case(msgs[0] + msgs[1]), str) == -1))
      continue;

    if (((time()+7200)/86400)>((hist_time[i]+7200)/86400))
      txt += BS(dtime(hist_time[i]));
    else
      txt += BS(dtime(hist_time[i])[19..26]);

    if (msgs[2]=="1" && !IS_WIZARD(TP))
      txt += BSA(msgs[1], "Ein unsichtbarer Druide teilt euch mit: ");
    else
      txt += BSA(msgs[1], msgs[0]);
  }
  txt+="-----------------------------------------------"
       +"-------------------------------\n";
  TP->More(txt);
  return 1;  
}

//
// history des mkreische anzeigen
//

nosave int ShowMagesHistory() {
  int i;
  string *msgs;
  mixed *history;
  mixed *hist_time;
  
  if (member(DRUIDENPAPAS,getuid(TP))==-1)
    return 0;
  history=call_other(GUILD_MASTER, "QueryMagesHistory");
  hist_time=history[0];
  history=history[1];
  if (sizeof(history)==0)
  {
    write("Die Druidengildenmagier haben Dir noch nichts mittgeteilt.\n");
    return 1;
  }
  write("Das haben Dir die anderen Druidengildenmagier mitgeteilt:\n");
  write(BS("-----------------------------------------------"
       +"-------------------------------\n"));
  for(i=0;i<=sizeof(history)-1;i++) {
    msgs=explode(history[i],"&&*%%");
    if ((time()/86400)>(hist_time[i]/86400))
      write(BS(dtime(hist_time[i])));
    else
      write(BS(dtime(hist_time[i])[19..26]));
    write(BSA(msgs[1], msgs[0]));
  }
  write("-----------------------------------------------"
       +"-------------------------------\n");
  return 1;  
}


// LISTENER HANDLING
// Ueberpruefung ob der Spieler am nkreische lauscht
int IsListener(object wer) {
  if(!is_clone(wer) && wer->QueryProp(P_TMP_DRUID_LISTENER))
  {
    return 1;
  }
  return 0;
}

// Setzen auf Listener
void SetListener(int flag) {
  if(MENV && interactive(MENV)) {
    if(flag)
      MENV->SetProp(P_TMP_DRUID_LISTENER, 1);
    else 
      MENV->SetProp(P_TMP_DRUID_LISTENER, 0);
  } 
  return ;
}

/* Ist das Objekt ein Druide? */
int is_druid(object ob)
{
  return (ob->QueryProp(P_GUILD)==GUILDNAME?1:0);
}

int dknuddeln(string str) {
  int i;
  object *spieler;
  spieler=users();
  for(i=sizeof(spieler)-1;i>=0; i--) {    
    if((spieler[i]->QueryProp(P_GUILD))=="druidenzirkel" ) {
      if(spieler[i]==TP)
        write(BS("Du knuddelst alle anwesenden Druiden aus "
                     +"der Ferne."));
      else {
        if(TP->QueryProp(P_GENDER)==FEMALE)
          tell_object(spieler[i], sprintf("Deine Druidenkollegin %s "
             "knuddelt Dich aus der Ferne.\n", TP->name()));
        else 
          tell_object(spieler[i], sprintf("Dein Druidenkollege %s "
               "knuddelt Dich aus der Ferne.\n", TP->name()));
      }
    }
  }
 return 1;
}

