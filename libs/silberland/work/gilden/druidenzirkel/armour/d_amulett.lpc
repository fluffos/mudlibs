nosave int MySort(object a, object b) {
  if(a->Name(WER) > b->Name(WER)) return 0;
  return 1;
}

int dkwer(string str)
{
  int i;
  object *spieler;
  string druids, element, level ,sh;
  druids="";
  write("Folgende Druiden sind anwesend:\n");

  // Druiden aussortieren:
  spieler = filter_array( users(),
      lambda( ({ 'a }),
        ({ #'==,
         ({ #'call_other, 'a, "QueryProp", P_GUILD }),
         "druidenzirkel" }) ) );

  // Spieler sehen unsichtbare Magier nicht:
  if ( !IS_LEARNING(TP) )
    spieler -= filter_objects( spieler, "QueryProp", P_INVIS );

  spieler = sort_array(spieler, "MySort");
  for(i=sizeof(spieler)-1;i>=0; i--)
  {    
    element=call_other(DRUIDENMASTER,"GetDruidElement",spieler[i]);
    level=sprintf("%d", spieler[i]->QueryProp(P_GUILD_LEVEL));
    if( IS_LEARNER(spieler[i]) ) level = "M";
    if(!stringp(element)) element="unbekannt";
    /* Fuer Debugzwecke: 
       tell_object(find_living("angrox"), CAP(getuid(spieler[i]))+
       ":"+element+"\n");
       */
    if (str == "ort") {
      druids+=sprintf("%13s(%2s) - ",CAP(getuid(spieler[i])),level);
      if (ENV(spieler[i]) && (sh=ENV(spieler[i])->QueryProp(P_INT_SHORT)) 
          && (!IS_LEARNER(spieler[i]) || IS_LEARNER(TP) ) )
        druids+=sh+".\n";
      else
        druids+="Im Nirgendwo.\n";
    } else {
      druids+=CAP(getuid(spieler[i]))+"("+level+"/"+CAP(element)+"), ";
    }
  }
  if( str == "ort" )
    write( druids);
  else
    write( BS( druids[0..<3] ) );
  return 1;
}

public mapping _query_temperature_protection() {
  int cold, heat;

  if(HAS_MYSTERY(owner, MYSTERY_COLD_ADJUSTMENT)) {
    cold = owner->QueryProp(P_GUILD_LEVEL) * 2;
  }

  if(HAS_MYSTERY(owner, MYSTERY_HEAT_ADJUSTED)) {
    heat = owner->QueryProp(P_GUILD_LEVEL) * 2;
  }

  return ([T_HEAT_PROT: heat, T_COLD_PROT: cold]);
}


// Maximumsermittlung fuer beliebig viele Argumente...
private int max(varargs int *val)       // written by Woody
{
  int i,m;

  if (!sizeof(val)) return 0;
  m = val[0];
  for (i = 1; i < sizeof(val); i++)
    if (val[i] > m) m = val[i];
  return m;
}


int dwer(string str)             // written by Woody
{
  int i, j;
  object *druids;
  string *elements;
  string element;
  string mask;
  string *list1, *list2;
  mapping dlist, delems;
 
  if( str == "ort" )
    return dkwer(str);
  mask = "\n"
    ".------------------.------------------.------------------.------------------.\n"
    "| Erz              | Feuer            | Luft             | Wasser           |\n"
    ")------------------+------------------+------------------+------------------(\n"
    "%s"
    "`--------.---------^--------.---------^--------.---------^--------.---------'\n"
    "         | Humus            | Eis              | Geist            |\n"
    "         )------------------+------------------+------------------(\n"
    "%s"
    "         `------------------^------------------^------------------'\n\n";
 
  // Druiden aussortieren:
  druids = filter_array( users(),
      lambda( ({ 'a }),
        ({ #'==,
           ({ #'call_other, 'a, "QueryProp", P_GUILD }),
           "druidenzirkel" }) ) );

  // Spieler sehen unsichtbare Magier nicht:
  if ( !IS_LEARNING(TP) )
    druids -= filter_objects( druids, "QueryProp", P_INVIS );

  // Nach Gildenlevel sortieren:
  druids = sort_array( druids,
      lambda( ({'a,'b}), 
        ({ #'>,
           ({ #'call_other, 'a, "QueryProp", P_GUILD_LEVEL }),
           ({ #'call_other, 'b, "QueryProp", P_GUILD_LEVEL }) }) ) ); //'

  dlist = ([ ]);
  delems = ([ ]);
  for (i = sizeof(druids); i-->0;)
  {
    if ( !stringp(element = DRUIDENMASTER->GetDruidElement(druids[i])) ||
         !strlen(element) )
      element = "Geist";
    else
      element = capitalize( element );
    if (pointerp(dlist[element]))
      dlist[element] += ({ druids[i] });
    else
      dlist[element] = ({ druids[i] });
    delems[element]++;
  }

  // start with empty lists
  list1 = ({ });
  list2 = ({ });

  for (i = max(delems["Erz"],delems["Feuer"],delems["Luft"],delems["Wasser"]); i --> 0;)
    list1 += ({ "|                  |                  |                  |                  |\n" });

  elements = ({ "Erz", "Feuer", "Luft", "Wasser" });
  for ( j = 0; j < sizeof(elements); j++ )
  {
    element = elements[j];
    for (i = 0; i < delems[element]; i++)
      list1[i][19*j+1..19*j+17] =
        sprintf( "%:3s %-:13s",
            IS_LEARNER(dlist[element][i]) ? "M" : sprintf("%2d",dlist[element][i]->QueryProp(P_GUILD_LEVEL)),
            dlist[element][i]->QueryProp(P_INVIS) ?
              "(" + capitalize(getuid(dlist[element][i])) + ")" :
              capitalize(getuid(dlist[element][i])) );
  }

  for (i = max(delems["Humus"],delems["Eis"],delems["Geist"]); i --> 0;)
    list2 += ({ "         |                  |                  |                  |\n" });

  elements = ({ "Humus", "Eis", "Geist" });
  for ( j = 0; j < sizeof(elements); j++ )
  {
    element = elements[j];
    for (i = 0; i < delems[element]; i++)
      list2[i][19*j+10..19*j+26] =
        sprintf( "%:3s %-:13s",
            IS_LEARNER(dlist[element][i]) ? "M" : sprintf("%2d",dlist[element][i]->QueryProp(P_GUILD_LEVEL)),
            dlist[element][i]->QueryProp(P_INVIS) ?
              "(" + capitalize(getuid(dlist[element][i])) + ")" :
              capitalize(getuid(dlist[element][i])) );
  }

  TP->More( sprintf( mask, implode( list1, "" ), implode( list2, "" ) ) );
  return 1;
}


int dtele() {
  object mstein;
  mixed tport;
  //tell_object(find_player("angrox"), "\nTeleFunc ok!\n");
  if(member(call_other(DRUIDENMASTER, "QueryNumberOne"), getuid(TP))==-1 &&
      member(call_other(DRUIDENMASTER, "QueryLegendary"), getuid(TP))==-1 &&
     !IS_WIZARD(TP) && !TP->QueryProp(P_TESTPLAYER))
    return 0;
  notify_fail(BS("Du musst noch warten, ehe Du die Worte neu "
     +"intonieren kannst.\n"));
  if(!teleportation) return 0;

  notify_fail("Deine Erfahrung reicht dafuer nicht aus!\n");
  if(TP->QueryProp(P_XP) < 55000000 || TP->QueryProp(P_LEVEL)<55) return 0;

  notify_fail("Eine Stoerung im astralen Gefuege verhindert das Machtwort!\n");
  if( (tport = ENV(TP)->QueryProp(P_NO_TPORT)) && 
      (tport & NO_TPORT_OUT || tport & NO_TPORT) )
    return 0;

  write(BS("Du intonierst die ueberlieferten Worte der Macht: "
          +"IN VAS YLEM POR !!!\n"));
  say(BS(TPN+" intoniert: IN VAS YLEM POR"));
  if(!mstein = deep_present("magiestein", TP)) {
    write("Da Du keinen Magiestein hast, opferst Du einen Teil Deiner "
        "Erfahrung, um hier weg zu kommen.\n");
    write_file(LOG("machtwort.log"), 
        sprintf("%s opfert %d XP statt einem Magiestein!\n", 
          CAP(getuid(TP)), TP->QueryProp(P_XP)/100));
    TP->SetProp(P_XP,to_int((TP->QueryProp(P_XP)*0.99)));
  }
  else
    mstein->AddAmount(-1);
  if(TP->InFight()) {
    write("Du opferst einen Teil Deiner Erfahrung, um aus dem Kampf zu "
        "entkommen.\n");
    write_file(LOG("machtwort.log"), 
        sprintf("%s opfert %d XP wegen Kampf!\n", 
          CAP(getuid(TP)), TP->QueryProp(P_XP)/50));
    TP->SetProp(P_XP,to_int((TP->QueryProp(P_XP)*0.98)));
  }
  write(BS("Du verlierst die Orientierung!"));
  say(BS("Astrale Funken umgeben "+TP->name(WEN) + " und ploetzlich ist "+
      TP->QueryPronoun(WER)+" nicht mehr hier!"));
  if(!IS_WIZARD(TP)) {
    TP->Set(P_SP, 0); // damits nur eine reportmeldung gibt
    TP->AddHp(-100);
    TP->SetProp(P_MV, 10);
    TP->SetProp(P_NEXT_SPELL_TIME, time() + 3 * 60);
  }
  write_file(LOG("machtwort.log"), 
    sprintf("%s %s teleportiert von %s in die Gilde.\n", 
      dtime(), CAP(getuid(TP)), file_name(ENV(TP))));
  TP->move("/gilden/druidenzirkel", M_TPORT|M_SILENT);
  say(BS("Ein astraler Wirbel bildet sich in der Mitte des Raumes, Funken und "
        "Lichtblitze verwirren Deine Wahrnehmung und ploetzlich erscheint "+
        TPN+" von einem strahlenden Licht umgeben."));
  teleportation--;
  return 1;
}

nosave string int2dienste(int anzahl)
{
  switch(anzahl)
  {
    case 0: return "keine Dienste";
    case 1: return "ein Dienst";
    case 2..3: return "wenige Dienste";
    case 4..6: return "mehrere Dienste";
    case 7..9: return "viele Dienste";
    case 10..15: return "sehr viele Dienste";
    case 16..25: return "extrem viele Dienste";
    default: return "nahezu unbeschraenkt viele Dienste";
  }
}

int ElementarDienste(string str) {
  mapping dienste;
  string *ind;
  int i;
  dienste=QueryAllServices()[1];
  ind=m_indices(dienste);
  write("Folgende Dienste der Elementare stehen Dir zur Zeit zur "
      "Verfuegung:\n");
  for(i=sizeof(dienste)-1;i>=0;i--) 
    write(sprintf("%-20s%s\n", CAP(ind[i])+":",int2dienste(dienste[ind[i]]) ));
  if((TP->QueryProp(P_ALIGN) > 500) || (TP->QueryProp(P_ALIGN) < -500))
    write(BS("Durch Deine derzeitige Gesinnung kannst Du Dir keine Dienste "
        "erfuellen lassen!"));
  return 1;
}


string GetAlign(int i)
{
  string ret;
  
  if(!intp(i)) i = 0;

  if(i <= -1000) ret = "satanisch";
  else
    switch(i)
    {
      case  -999 ..  -500: ret = "zu boese";   break;
      case  -499 ..  -200: ret = "boese";      break;
      case  -199 ..   -40: ret = "frech";      break;
      case   -39 ..    39: ret = "neutral";    break;
      case    40 ..   199: ret = "nett";       break;
      case   200 ..   499: ret = "gut";        break;
      case   500 ..   999: ret = "zu gut";     break;
      default:             ret = "heilig";
    }
  return ret;
}

public void root_regeneration() {
  owner->SetProp(P_TMP_DRUID_LAST_ROOT_REGENREATION, time());
  if(owner->QueryProp(P_HP) < owner->QueryProp(P_MAX_HP)) owner->AddHp(1);
  if(owner->QueryProp(P_SP) < owner->QueryProp(P_MAX_SP)) owner->AddSp(1);
  if(owner->QueryProp(P_DRINK) > 0) owner->drink_drink(-1, 0, 0);
  if(owner->QueryProp(P_FOOD) > 0) owner->eat_food(-1, 0);
  return;
}

public void refreshing_current() {
  int h;

  owner->SetProp(P_LAST_WATER_REGENERATION, time());
  if(owner->QueryProp(P_SP) < owner->QueryProp(P_MAX_SP)) {
    owner->AddSp(1+random(owner->QueryProp(P_GUILD_LEVEL)/2));
    h = 1;
  }

  if(h) tell_object(owner, BS("Die Kraft des elementaren Wassers erfrischt dich."));
  return;
}

public void soild_regeneration() {
  int h;

  owner->SetProp(P_LAST_SOIL_REGENERATION, time());
  if(owner->QueryProp(P_HP) < owner->QueryProp(P_MAX_HP)) {
    owner->AddHp(1+random(owner->QueryProp(P_GUILD_LEVEL)/4));
    h = 1;
  } 

  if(owner->QueryProp(P_SP) < owner->QueryProp(P_MAX_SP)) {
    owner->AddSp(1+random(owner->QueryProp(P_GUILD_LEVEL)/4));
    h = 1;
  } 

  if(h) tell_object(owner, BS("Kraft stroemt aus der Erde in dich. Du fuehlst dich erfrischt."));
  return;
}

/*
Eiskalt vom Teddy kopiert :) 
*/

varargs void NotifyHpChange(int force) {
  int hp, mhp, sp, msp, HPdif, length,stat, changedHP, changedSP;
  string color, msg, flags, help;
  object teddy, oenv;
  mapping envinfo;
  mixed terrain; 

  color="";
  flags="";
  stat=0;
  // Sicherheits-Check
  if (!previous_object()) return;
  if (owner != previous_object()) {
    if (TO != previous_object()) return;
    stat=1;
  }
  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv && !stat) {
    if (owner!=find_netdead(getuid(owner)))
      owner->RemoveHpHook(ME);   // geht nur bei nicht-netztoten Spielern
    return;
  }
  // Test auf Geist
  if (owner->QueryProp(P_GHOST))
    return;

  if(!query_once_interactive(owner)) {
    activate(0);
    return;
  }

  // Festwurzeln-Mysterium
  if(HAS_MYSTERY(owner, MYSTERY_GROW_ROOTS) && !owner->InFight()) {
    if((owner->QueryProp(P_LAST_MOVE) + 30 - (owner->QueryProp(P_GUILD_LEVEL))) < time()) {
      if(!owner->QueryProp(P_TMP_DRUID_ROOTED)) {
        owner->SetProp(P_TMP_DRUID_ROOTED, 1);
        tell_object(owner, BS("Aus deinen Fuessen wachseln Wurzeln aus elementarem Humus in den Boden."));
        tell_room(environment(owner), BS("Aus "+owner->name(WESSEN, 1)+" Fuessen wachseln Wurzeln in den Boden."), ({owner}));
      }

      if(owner->QueryProp(P_TMP_DRUID_LAST_ROOT_REGENREATION)+8 < time()) {
        call_out("root_regeneration", 0);
      }
    } else {
      if(owner->QueryProp(P_TMP_DRUID_ROOTED)) {
        owner->SetProp(P_TMP_DRUID_ROOTED, 0);
        tell_object(owner, BS("Deine elementaren Humuswurzeln loesen sich auf."));
      }
    }
  }

  // Kraft der Erde Mysterium
  oenv = environment(owner);
  envinfo = oenv->QueryProp(P_ENVIRONMENT);
  if(!mappingp(envinfo)) envinfo = ([ ]);
  if(member(envinfo, ENV_TERRAIN)) terrain = envinfo[ENV_TERRAIN];
  else terrain = TT_OTHER;

  if(HAS_MYSTERY(owner, MYSTERY_POWER_OF_THE_SOIL) && !owner->InFight() && member(({TT_HILL, TT_FOREST, TT_JUNGLE, TT_PLAIN, TT_SWAMP}), terrain) > -1) {
        if(owner->QueryProp(P_LAST_SOIL_REGENERATION) + 8 < time() && !random(20-owner->QueryProp(P_GUILD_LEVEL))) {
          if(find_call_out("soild_regeneration") == -1) call_out("soild_regeneration", 0);
        }
  }

  // Erfrischende Stroemung
  if(HAS_MYSTERY(owner, MYSTERY_REFRESHING_CURRENT) && (member(({TT_WATER, TT_UNDERWATER, TT_ARCTIC}), terrain) > -1 ||
      oenv->QueryProp(P_ELEMENTAL_ROOM) == WASSER || file_name(oenv)[0..9] == "/d/wasser/"))   {
        if(owner->QueryProp(P_LAST_WATER_REGENERATION) + 8 < time() && !random(20-owner->QueryProp(P_GUILD_LEVEL))) {
          if(find_call_out("refreshing_current") == -1) call_out("refreshing_current", 0);
        }
  }

  // Feen werden entschoepft, wenn sie gleiten, da sie ja nicht fliegen bekomman als Bonus
  if(owner->QueryProp(P_RACE) == "Fee" && !random(3) && HAS_MYSTERY(owner, MYSTERY_GLIDE)) {
    owner->do_exhaust(random(MVP_GAIN_NORMAL));
  }

  // Teddy ausschalten, damit nicht 2 Reports aktiv sind
  if(!test_bit(akt_lvl, 3) &&  teddy=present("teddy", owner) )
      teddy->activate(0);
  // aktuelle Werte ermitteln
  hp = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);
  if (noscroll &&
      hp - scrollHP >= 0 && hp - scrollHP < 5 &&
      sp - scrollSP >= 0 && sp - scrollSP < 5)
  {
    scroll += hp - scrollHP + sp - scrollSP;
    scrollHP = hp;
    scrollSP = sp;
    if (!force && scroll < noscroll && 
        !(hp == mhp && hp != lastHP) &&
        !(sp == msp && sp != lastSP))
      return;
  }
  scroll = 0;
  scrollHP = hp;
  scrollSP = sp;
  if(test_bit(akt_lvl, 1)) {
    switch(hp*100/mhp) {
      case 0..20: color=report_colors[4];
                  break;
      case 21..40: color=report_colors[3];
                  break;
      case 41..60: color=report_colors[2];
                  break;
      case 61..80: color=report_colors[1];
                  break;
      case 81..100: color=report_colors[0];
                  break;
      default: color=ANSI_NORMAL;
    }
  }
  if(test_bit(akt_lvl, 0)) 
    flags=EnhancedReport(owner, enh);
  else
    flags="-----------------------------";
  if(cnt>5 || align=="") { 
      align = GetAlign(owner->QueryProp(P_ALIGN));
    cnt=0;
  }
  cnt++;
  length=18-strlen(align)-2;
  // Vergleich und Ausgabe
  changedHP=hp-lasthp;
  changedSP=sp-lastsp;
  if ((((hp < lastHP) || (hp > lastHP && (sp == msp || callout)) || 
       (sp != lastSP) || (stat)) && (changedHP || changedSP)) || force ) 
  {
    if(test_bit(akt_lvl, 4)) {
      msg=sprintf("%sLP %d MP %d%s",
        color,hp,sp,ANSI_NORMAL);
    }
    else if(test_bit(akt_lvl, 2))
    {
      help = sprintf("(%s)%*'-'s", align,length,"");
      msg=sprintf("%s%s%s LPs: %d/%d(%s), MPs: %d/%d(%s)%s",
        color, flags[4..], help[0..<5], hp, mhp, (changedHP>0?"+":"")+
        changedHP, sp, msp, (changedSP>0?"+":"")+changedSP, ANSI_NORMAL);
    }
    else
      msg=sprintf("%s%s(%s)%*'-'s LPs: %d(%s), MPs: %d(%s)%s",
        color, flags, align,length, "", hp, (changedHP>0?"+":"")+
        changedHP, sp, (changedSP>0?"+":"")+changedSP, ANSI_NORMAL);
    tell_object(owner, msg+"\n"); 
    lastsp = sp;
    lasthp = hp;
    callout = 0;
    lastHP = hp; 
  }
  else if( !callout && (hp > lastHP+1) )
  {
    callout = 1;
    call_out("NotifyHpChange",0);
  }
  else 
  {
    callout = 0;
    lastHP = hp; 
  }
  // neue Werte merken
  lastSP = sp;
}

nosave int Status(string str) {
  notify_fail("Du musst den DReport dafuer aktiviert haben!\n");
  if(!aktiv) return 0;
  NotifyHpChange(1);
  return 1;
}

nosave void activate(object ob)
{
  object teddy;
  if (objectp(ob)) {
    if(!test_bit(akt_lvl, 3) &&  teddy=present("teddy", ob) )
      teddy->activate(0);
    aktiv = 1;
    owner = ob;
    owner_name = getuid(owner);
    ob->AddHpHook(ME);
    scrollHP = lastHP = ob->QueryProp(P_HP);
    scrollSP = lastSP = ob->QueryProp(P_SP);
    NotifyHpChange(1);
  } else {
    if (ob=(owner||TP)) ob->RemoveHpHook(ME);
    owner = owner_name = aktiv = 0;
  }
}

nosave int Report(string str) {
  string *msg;
  notify_fail("Syntax: dreport ein|aus|level <0|1|2>|max <0|1>|farben <0|1>|scroll x.\n");
  if(!sizeof(msg=explode(str, " "))) return 0;
  switch (msg[0]) {
    case "ein":
      if (aktiv && objectp(owner))
        write("Der DReport-Modus ist schon eingeschaltet!\n");
      else {
        write("DReport-Modus ist jetzt eingeschaltet.\n");
        activate(TP);
      }
      break;
    case "aus":
      if (!aktiv)
        write("Der DReport-Modus ist doch schon ausgeschaltet!\n");
      else { 
        write("DReport-Modus ist nun ausgeschaltet.\n");
        activate(0);
      }
      break;
    case "level":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 0);
      else 
        write("Syntax: dreport level <0|1>\n"); 
      break;
    case "farben":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 1);
      else 
        write("Syntax: dreport farben <0|1>\n"); 
      break;
    case "max":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 2);
      else 
        write("Syntax: dreport max <0|1>\n"); 
      break;
    case "teddy":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 3);
      else 
        write("Syntax: dreport teddy <0|1>\n"); 
      break;
    case "minimal":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 4);
      else 
        write("Syntax: dreport minimal <0|1>\n"); 
      break;
    case "hilfe":
      ShowReportHelp();
      break;
    case "scroll":  
      if(sizeof(msg)>1)
      {
        noscroll = to_int(msg[1]);
        if (noscroll > 1 && noscroll < 100)
        {
          write("Dreport erst, wenn " + noscroll + " Punkte hochgeidelt.\n");
        }
        else
          write("DReport mit normalem Scroll.\n");
      }
      else 
      {
        write("DReport mit normalem Scroll.\n"); 
        noscroll = 0;
      }
      break;
    default:
      return 0;
  }
  return 1;
}

//
// Fuer Stufe 16
//

int SetDruidElement(string element, object pl) {
  if(file_name(previous_object())[0..39]!=
      "/d/huegelland/angrox/druidenzirkel/room/" && 
      !IS_ARCH(previous_object())) 
    return 0;
  call_other(DRUIDENMASTER, "SetDruidElement", pl, element);
  SetRes();
  return 1;
}

//
// 0 ... Level
// 1 ... Farben
// 2 ... Max
//
//
nosave int ConfigureReport(string str, int what) {
 int flag;
 string txt;
 flag=to_int(str);
 switch (what) {
   case 0: txt="Level"; break;
   case 1: txt="Farben"; break;
   case 2: txt="Max"; break;
   case 3: txt="Teddy"; break;
   case 4: txt="Minimal"; break;
   default: flag=-1;
 }
 if(flag<0 || flag>1) {
   write("Falsche Eingabe!\n");
   return 1;
 }
 if(flag==0) 
   akt_lvl=clear_bit(akt_lvl, what);
 else if(flag==1) {
   if(what==0) enh=1;
   akt_lvl=set_bit(akt_lvl, what);
 }
//else if(flag==2 && what==0) {
 //  enh=0;
  // akt_lvl=set_bit(akt_lvl, what);
// }
 write("Ok, "+txt+" auf "+flag+" gesetzt!\n");
 //TELL("angrox", sprintf("--damulett, what: %d, flag: %d, txt: %s, enh: %d\n", what, flag, txt,enh));
 return 1;
}

