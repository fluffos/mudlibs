nosave int dhilfe(string str) {
  if(!str) {
  write("\nDas ermoeglicht folgende Kommandos:\n"
      "dreport hilfe    : Hilfeseite zu dreport\n"
      "dfarben hilfe    : Hilfe zu den Farbeinstellungen\n"
      "druf(e)          : Teile-mit fuer Druiden\n"
      "dhilfe drufe     : Genauere Hilfe zu drufe\n" 
      "dwer/dkwer       : Welcher Druide ist gerade da\n"
      "dwink(e)         : Allen Druiden zuwinken\n"
      "dknuddle         : Alle Druiden knuddeln\n"
      "dhist [<n>|text] : History\n"
      "ddienste         : Zeigt die freien Dienste der Elementare an\n"
      "dzauberfarben    : Schaltet die Farben bei den Zauber <an> oder <aus>\n"
      "dstatus          : Eigener Status\n\n");
  return 1;
  }
  if(str=="drufe") {
    TP->More(read_file("/gilden/obj/help_color_tells"));
    return 1; 
  }
}

nosave int ShowReportHelp() {
 write("\ndreport Kommandos   :\n"
       "dreport hilfe         : Dieses hier\n"
       "dreport ein           : Schaltet den Report ein\n"
       "dreport aus           : Schaltet den Report aus\n"
       "dreport level <0|1>   : Schaltet zwischen erweitertem und normalen\n"
       "                        Modus um\n"
       "dreport max <0|1>     : Schaltet Anzeige der maximalen Punkte ein\n"
       "dreport farben <0|1>  : Farben aus|ein\n"
       "dreport teddy <0|1>   : Teddyreport ein/aus nach aktivem dreport ein\n"
