       " -               123456789A\n"
       "1 ... Elementarpanzer    6 ... Vergiftet\n"
       "2 ... Elementarhand      7 ... Frosch\n" 
       "3 ... Erschoepft         8 ... Alkoholisiert\n" 
       "4 ... Taub               9 ... Paralysiert\n"
       "5 ... Blind              A ... kein Zauberspruch moeglich\n"
       "\n");
 return 1;
}

nosave string EnhancedReport(object owner, int flag) {
  mixed h;
  string flags;
  object ob;
    flags="---------------[";
  if(present("\ne_panzer", owner))
    flags+="E";
  else flags+="-";
  if(closurep(owner->Query(P_HANDS, F_QUERY_METHOD)))
   flags+="H";
  else flags+="-";
  if(owner->QueryProp(P_MV)*100/owner->QueryProp(P_MAX_MV)<10)
    flags+="M";
  else flags+="-";
  if(owner->QueryProp(P_DEAF))
    flags+="T";
  else flags+="-";
  if(owner->QueryProp(P_BLIND))
    flags+="B";
  else flags+="-";
  if(h=owner->QueryProp(P_POISON))
  {
    if(h<=3) flags+="v"; else flags+="V";
  }
  else flags+="-";
  if(owner->QueryProp(P_FROG))
    flags+="F";
  else flags+="-";
  if(h=owner->QueryProp(P_ALCOHOL))
  {
    if(h<=20) flags+="a"; else flags+="A";
  }
  else flags+="-";
  if(owner->QueryProp(P_PARALYZED))
    flags+="P";
  else flags+="-";
  if(time()<owner->QueryProp(P_NEXT_SPELL_TIME))
    flags+="N";
  else flags+="-";
  if (element_ghost)
  {
    if (element_ghost < time())
      flags+="X";
    else
      flags+="-";
    flags +="]-";
  }
  else
    flags+="]--";
  return flags;
}

varargs mixed GetDruidElement(object pl) {
  string e1,e2,dam1,dam2;
  mapping comp, edam;
  comp=COMPLEMENT_ELEMENTS;
  edam=ELEMENT_DAMAGE;
  if(!objectp(pl)) pl=ENV(ME);
  e1=call_other(DRUIDENMASTER, "GetDruidElement", pl);
  e2=comp[e1];
  dam1=edam[e1];
  dam2=edam[e2];
  eles=({e1,dam1,e2,dam2});
  return ({e1,dam1,e2,dam2});
}
 
nosave int SetRes() {
  object pl;
  if(!ENV(ME) || !living(ENV(ME)) || !pl=QueryProp(P_WORN)) return 0;
  GetDruidElement(pl);
  if(eles[0]==GEIST) {
    pl->AddResistanceModifier( ([DT_MAGIC: -0.05,
                                 DT_FIRE: -0.05,
                                 DT_COLD: -0.05,
                                 DT_WATER: -0.05,
                                 DT_AIR: -0.05,
                                 DT_BLUDGEON: -0.05,
                                 DT_POISON: -0.05,
                                 ]), "druidenamulett");
  }
  else if (eles[0]==LUFT) {
    pl->AddResistanceModifier(  ([eles[1]:-0.1,
                                  DT_BLUDGEON: 0.05,
                                  DT_MAGIC: 0.05,
                                  ]), "druidenamulett");
  }
  else if (eles[0]==ERZ) {
    pl->AddResistanceModifier(  ([DT_MAGIC: -0.05,
                                  DT_BLUDGEON: -0.05,
                                  DT_AIR: 0.1,
                                  ]), "druidenamulett");
  }
  else {
    pl->AddResistanceModifier( ([eles[1]:-0.1, eles[3]:0.1]),
        "druidenamulett");
  }
  return 1; 
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int damReduction;
  if(!pointerp(eles))   // just to be safe - woody, 20080706
    return 0;

  damReduction = 0;

  if(member(dtyp, eles[1])!=-1)
   damReduction += random(QueryProp(P_WORN)->QueryProp(P_GUILD_LEVEL));

  if(HAS_MYSTERY(QueryProp(P_WORN), MYSTERY_BODY_OF_STONE)) {
    damReduction += QueryProp(P_WORN)->QueryProp(P_GUILD_LEVEL);
  }

  return damReduction;
}

nosave int Spellcolors(string what) {
  if(what=="an") {
    TP->SetProp(P_DRUID_SPELL_COLORS, 1);
    write("Ab nun sind Deine Zauber farbig unterlegt.\n");
    return 1;
  }
  if(what=="aus") {
    TP->SetProp(P_DRUID_SPELL_COLORS, 0);
    write("Ab nun sind Deine Zauber nicht mehr farbig unterlegt.\n");
    return 1;
  }
  write("dzauberfarben <an|aus>\n");
  return 1;
}

nosave int ShowColorHelp() {
  write("\nHilfe zu 'dfarben':\n"
     "Mit diesem Kommando kann man sich die Farben des 'dreports' setzen.\n"
     "Fuer jeden der 5 Abstufungen kann eine eigene Farbe gewaehlt werden.\n"
     "Syntax: dfarben farbe1 farbe2 farbe3 farbe4 farbe5\n\n"
     "Moegliche Farben:  schwarz, rot, gruen, gelb, blau, lila, zyan, "
     "weiss.\n\n");
  return 1;
}

nosave int SetColors(string cols) {
  string *colors, *set_cols;
  mapping valid_colors;
  int i;
  set_cols=({});
  valid_colors=(["schwarz":ANSI_BLACK,
                 "rot":ANSI_RED,
                 "gruen":ANSI_GREEN,
                 "gelb":ANSI_YELLOW,
                 "blau":ANSI_BLUE,
                 "lila":ANSI_PURPLE,
                 "zyan":ANSI_CYAN,
                 "weiss":ANSI_WHITE,
                 "normal":ANSI_NORMAL]);
  if(!cols) cols="standard";
  cols=lower_case(cols);
  if(cols=="standard") {
    report_colors=std_colors;
    write(BS("Ok, Standard Farben (Gruen, Gelb, Zyan, Blau, Rot) "
          "gesetzt!\n"));
    call_other(DRUIDENMASTER, "SetColors", TP, set_cols);
    return 1; 
  }
  if(cols=="hilfe") {
    return ShowColorHelp(); 
  }
  colors=explode(cols, " ");
  if(sizeof(colors)!=5) {
    write("Es muessen fuenf Farben angegeben werden!\n");
    return 0;
  }
  for(i=0;i<=sizeof(colors)-1;i++) {
    if(!member(valid_colors, colors[i])) {
      write(sprintf("Falsche Farbe: %s!\n", colors[i]));
      return 0;
    }
    set_cols+=({valid_colors[colors[i]]});
  }
  report_colors=set_cols;
  write("Ok, Farben gesetzt!\n");
  call_other(DRUIDENMASTER, "SetColors", TP, set_cols);
  return 1;
}  

string short()
{ 
  if (QueryProp(P_WORN) && TP && TP != QueryProp(P_WORN) &&
      QueryProp(P_WORN)->QueryProp(P_GUILD) != GUILDNAME)
    return 0;
  return ::short();
}

public string extra_look() {
  if(!objectp(QueryProp(P_WORN))) return 0;

  if(HAS_MYSTERY(QueryProp(P_WORN), MYSTERY_BODY_OF_STONE)) {
    return sprintf("%s Haut scheint aus Marmor zu bestehen.\n", CAP(QueryProp(P_WORN)->QueryPossPronoun(FEMALE, WER)));
  }

  return 0;
}

