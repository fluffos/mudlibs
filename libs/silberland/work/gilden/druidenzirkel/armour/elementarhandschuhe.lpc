   */


inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden.h"

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein magisches Paar Elementarhandschuhe");
  SetProp(P_LONG,
      "Die Elemente selbst formten diese Handschuhe: " 
      "Quecksilber, durch die Macht des Elementes Erz gebunden, formt "
      "den Handschuh. Die Finger scheinen aus reinstem Feuer zu bestehen, "
      "waehrend das Futter aus Humus und Wasser zu bestehen scheint, "
      "die Oberseite ist mit Stacheln aus purem Eis uebersaeht, waehrend "
      "staendig ein seltsamer Wind die Handschuhe umgibt.");
  SetProp(P_NAME, "Paar Elementarhandschuhe");
  SetProp(P_NAME_ADJ, "magisch");
  SetProp(P_GENDER, NEUTER);
  AddId(({"handschuhe", "elementarhandschuhe", ELEMENTARHANDSCHUHE, 
        DRUID_ALLOWED_METAL_ITEM}));
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 5);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
      ([DT_FIRE:3, DT_WATER:3, DT_AIR:3, DT_MAGIC:3, DT_COLD:3, DT_POISON:3]));
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:10, MAT_FIRE:15, MAT_ICE:15, 
     MAT_WATER:15, MAT_AIR:15, MAT_EARTH:15, MAT_MERCURY:15]));
  SetProp(P_WEIGHT, 1500);  
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 1000);
  SetProp(P_NOBUY, 1); 
  SetProp(P_MAGIC, 1); 
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 30);
  SetProp(P_INFO, BS("Wenn die Handschuhe einige Zeit lang getragen werden, "
      "unterstuetzen sie die Faehigkeiten eines Druiden. Doch auch fuer "
      "Andere sind diese Handschuhe eine exzellenter Schutz."));
}


