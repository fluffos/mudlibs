/*
** Elementarring fuer die Elementardienste (Version fuer kleine Druiden)
** 23.09.2002 Feyaria@SilberLand
**
** 
**
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../druiden.h"

nosave string element;

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"ring"}));
  SetProp (P_SHORT, "Ein Steinring");
  SetProp (P_LONG,
           "Ein ganz normaler Steinring. Er ist schon etwas "
          +"zerkratzt.");
  SetProp (P_NAME, "Ring");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 10+random(30));
  SetProp (P_VALUE, 1000);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_RING);
  SetProp (P_AC, random(5));
  SetProp (P_MAGIC, 1);
  SetProp (P_QUALITY_DECAY, 200+random(500));
  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "druidenzirkel"]) );
  SetProp(P_WEAR_FUNC, TO);
}

int WearFunc(object ruest,int silent)
{
  if (TP->QueryProp(P_GUILD_LEVEL) < 15)
    return 1;
  write("Du bist schon zu erfahren, um solch einen kleinen Ring verwenden zu koennen!\n");
  return 0;
}

string _query_info() {
  return BS(sprintf("Dieser machtvolle Ring hilft Dir dabei %selementare "
        "besser zu beherrschen.", CAP(element)));
}

int _query_cursed() {
  return 0;
}

int check_equip_time() {
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}

int set_ring_element(string str) {
  element=str;
  SetProp(P_ELEMENT, element);
  switch(str) {
    case FEUER: 
      SetProp(P_SHORT, "Ein kleiner, gluehender Feuerring");
      SetProp(P_NAME, "Feuerring");
      SetProp(P_NAME_ADJ, ({"klein", "gluehend"}));
      AddAdjective( ({"klein", "kleinen", "kleiner", "gluehend", "gluehenden", "gluehender"}) );
      SetProp(P_LONG, "Der gluehende Ring besteht vollkommen aus "
          "elementarem Feuer. Die Flammen befinden sich staendig "
          "in Bewegung. Von dem Ring geht eine angenehme Waerme "
          "aus, selbst wenn Du den Ring am Finger traegst wirst "
          "Du Dich nicht verbrennen.");
      SetProp(P_WORN_TEXT, "am linken kleinen Finger getragen");
      SetProp(P_MATERIAL, ([MAT_FIRE:100]));
      AddProp(P_DAM_PROTECTION, ([DT_FIRE:1]) );
      AddId( ({ELEMENT_RING_FEUER, "feuerring"}) );
      break;
      
    case EIS:
      SetProp(P_SHORT, "Ein kleiner, geforener Eisring");
      SetProp(P_NAME_ADJ, ({"klein", "gefroren"}) );
      AddAdjective( ({"klein", "kleinen", "kleiner", "gefrorenen", "gefroren", "gefrorener"}) );
      SetProp(P_NAME, "Eisring");
      SetProp(P_LONG, "Dieser Ring besteht vollkommen aus Eis. Seltsamerweise "
          "spuerst Du nur eine angenehme Kaelte von dem Ring ausgehen. "
          "Du hast das Gefuehl als bestuende dieser Ring aus dem reinsten "
          "elementaren Eis.");
      SetProp(P_WORN_TEXT, "am rechten Zeigefinger getragen");
      SetProp(P_MATERIAL, ([MAT_ICE:100]));
      AddProp(P_DAM_PROTECTION, ([DT_COLD:1]) );
      AddId( ({ELEMENT_RING_EIS, "eisring"}) );
      break;

    case HUMUS:
      SetProp(P_SHORT, "Ein kleiner, lebendiger Erdring");
      SetProp(P_NAME_ADJ, ({"klein", "lebendig"}));
      AddAdjective( ({"klein", "kleinen", "kleiner", "lebendig", "lebendiger", "lebendigen"}) );
      SetProp(P_NAME, "Erdring");
      SetProp(P_LONG, "Der Ring scheint sich leicht zu bewegen. Er besteht "
          "vollkommen aus saftigem Humus. Ein paar kleine gruene Grashalme "
          "haben es sich auf dem Ring bequem gemacht und gedeihen praechtig, "
          "auch wenn sie etwas kleiner als die ueblichen Halme aussehen.");
      SetProp(P_WORN_TEXT, "am linken Zeigefinger getragen");
      SetProp(P_MATERIAL, ([MAT_EARTH:100]));
      AddProp(P_DAM_PROTECTION, ([DT_POISON:1]) );
      AddId( ({ELEMENT_RING_HUMUS, "erdring"}) );
      break;
      
    case WASSER:
      SetProp(P_SHORT, "Ein kleiner, tiefblauer Wasserring");
      SetProp(P_NAME_ADJ, ({"klein", "tiefblau"}));
      AddAdjective( ({"klein", "kleinen", "kleiner", "tiefblauen", "tiefblau", "tiefblauer"}) );
      SetProp(P_NAME, "Wasserring");
      SetProp(P_LONG, "Der tiefblaue Ring besteht vollkommen aus Wasser, "
        "das durch eine maechtige Magie in dieser Form gehalten wird. Es "
        "scheint sich leicht zu bewegen und ist vollkommen rein. Irgendwie "
        "hast Du das Gefuehl, als ob der Ring aus reinstem elementaren "
        "Wasser besteht.");
      SetProp(P_WORN_TEXT, "am rechten kleinen Finger getragen");
      SetProp(P_MATERIAL, ([MAT_WATER:100]));
      AddProp(P_DAM_PROTECTION, ([DT_WATER:1]) );
      AddId( ({ELEMENT_RING_WASSER, "wasserring"}) );
      break;

    case LUFT:  
      SetProp(P_SHORT, "Ein kleiner Luftring" );
      SetProp(P_NAME, "Luftring");
      SetProp(P_NAME_ADJ, ({"klein"}));
      AddAdjective( ({"klein", "kleinen", "kleiner"}) );
      SetProp(P_LONG, "Der Luftring besteht aus verwirbelnder Luft, die "
          "sich in Kreisform bewegt. Seltsam, obwohl man ihn nicht richtig "
          "sieht, kann man ihn doch beruehren, so als sei er aus festem "
          "Material.");
      SetProp(P_WORN_TEXT, "am linken Ringfinger getragen");
      SetProp(P_MATERIAL, ([MAT_AIR:100]));
      AddProp(P_DAM_PROTECTION, ([DT_AIR:1]) );
      AddId( ({ELEMENT_RING_LUFT, "luftring"}) );
      break;

    case ERZ: 
      SetProp(P_SHORT, "Ein kleiner, bestaendiger Metallring");
      SetProp(P_NAME_ADJ, ({"klein", "bestaendig"}));
      AddAdjective( ({"klein", "kleinen", "kleiner", "bestaendig", "bestaendiger", "bestaendigen"}) );
      SetProp(P_NAME, "Metallring");
      SetProp(P_LONG, "Dieser Metallring ist voellig schmucklos und besteht "
        "aus einem seltsam glaenzenden Metall. Dir faellt auf, dass seine "
        "Oberflaeche unbearbeitet ist und das der ganze Ring keinerlei "
        "Bearbeitungsspuren aufweist. Das Metall ist auch irgendwie komisch, "
        "es strahlt eine gewisse Kraft und Reinheit aus.");
      SetProp(P_WORN_TEXT, "am rechten Ringfinger getragen");
      SetProp(P_MATERIAL, ([MAT_MISC_METAL:100]));
      AddId( ({ELEMENT_RING_ERZ, "metallring", DRUID_ALLOWED_METAL_ITEM}) );
      break;
      
  }
}

int do_remove() {
  if(ENV(ME) && interactive(ENV(ME))) 
    tell_object(ENV(ME), BS(sprintf("Ploetzlich loest sich Dein "
            "%s auf!", QueryProp(P_NAME))));
  remove();
  return 1;
}

mixed query_itemd_elemental_value()
{
  if( !check_equip_time() ) return 0;
  return ([QueryProp(P_ELEMENT): 1+random(5)]);
}
