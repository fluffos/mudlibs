/*
** Der Meisterring
** 17.05.2002 Feyaria@SilberLand
**
** 
**
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../druiden.h"

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"ring", "meisterring", "elementarring", 
        ELEMENT_RING_FEUER, ELEMENT_RING_EIS, ELEMENT_RING_HUMUS, 
        ELEMENT_RING_ERZ, ELEMENT_RING_WASSER, ELEMENT_RING_LUFT}));
  SetProp(P_SHORT, "Der Ring");
  SetProp(P_LONG,
           "Ein unscheinbarer schmaler Goldring. Wer weiss, was es damit auf "
           "sich hat.");
  SetProp(P_NAME, "Ring");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10+random(30));
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Deinen Schatz willst Du nicht hergeben!\n");
  SetProp(P_NODROP, "Deinen Schatz willst Du nicht hergeben!\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 4);
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_MAGIC, 6);
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_MATERIAL, ([MAT_GOLD:40, MAT_EARTH:10, MAT_MAGIC:10, MAT_AIR:10, 
                        MAT_FIRE:10, MAT_ICE:10, MAT_WATER:10]));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_COLD: 2, 
         DT_FIRE: 2, DT_AIR: 2, DT_POISON: 2, DT_WATER: 2, DT_MAGIC: 2]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "druidenzirkel", P_GUILD_LEVEL:14]) );
  SetProp(P_AUTOLOADOBJ, 300);
}

string _query_info() {
  return "\nSechs Ringe den Elementen, \n"
      "einer dem kalten Eis und Schnee im Polar, \n"
      "einer dem heissen Feuer und der Gluthitze der Wueste,\n"
      "einer dem fliessenden Wasser der Fluesse und Meere,\n"
      "einer der pfeifenden Luft und brausendem Wind,\n"
      "einer dem Humus, lebenspendend fuer Pflanzen und Tiere\n"
      "und einer dem harten Erz, Stein und Metall.\n\n"
      "Aber ein Ring dem Meister der Elemente, \n"
      "alle Elementare zu beherrschen, \n"
      "sie in seinen Dienst zu zwingen \n"
      "und auf ewig zu binden.\n\n";
}


int _query_cursed() {
  return 0;
}

int check_equip_time() {
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}

mixed _query_itemd_elemental_value()
{
  if( !check_equip_time() ) return 0;
  return 2+random(6);
}

void reset()
{
  if (!is_clone(this_object()))
    return;
  ::reset();
  if (QueryProp(P_AUTOLOADOBJ))
    SetProp(P_AUTOLOADOBJ, QueryProp(P_AUTOLOADOBJ) - 1);
}

