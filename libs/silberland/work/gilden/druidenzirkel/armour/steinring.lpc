/*
** INT Ring
** 07-12-1997
**
** 
**
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../druiden.h"
int bonus;

create()
{
  bonus=random(2)+1;
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"ring","steinring"}));
  SetProp (P_SHORT, "Ein Steinring");
  SetProp (P_LONG,
           "Ein ganz normaler Steinring. Er ist schon etwas "
          +"zerkratzt.");
  SetProp (P_NAME, "Steinring");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 3000);
  SetProp (P_NOBUY, 0);
  SetProp (P_ARMOUR_TYPE, AT_RING);
  SetProp (P_AC, 3);
  SetProp (P_QUALITY_DECAY, 600);
  SetProp (P_WEAR_RESTRICTIONS, ([P_FROG:1, A_INT:20, SR_SEER:1]));
  SetProp (P_MATERIAL, ([MAT_MISC_STONE:100]));
  SetProp(P_INFO, BS("Dieser Ring macht Dich klueger.\n"));
  SetProp (P_X_ATTR_MOD, ([ A_INT:bonus]) );
}

