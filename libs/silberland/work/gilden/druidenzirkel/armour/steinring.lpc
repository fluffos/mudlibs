reset()
{
 object ob;
 if(living(ob=ENV(ME))) {
   SetProp(P_M_ATTR_MOD, 0);
   ob->UpdateAttributes();
   SetProp(P_M_ATTR_MOD, ([A_INT:(random(3)+1)]));
   ob->UpdateAttributes();
   tell_object(ob, BS("Dein Steinring erwaermt sich kurz und "
         +"kuehlt kurz danach wieder ab.\n"));
 }
 ::reset();
}

