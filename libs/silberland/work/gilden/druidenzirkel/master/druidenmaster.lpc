//#define WDB(xx) if(find_player("angrox")) \
//   tell_object(find_player("angrox"),sprintf("[%s] %s\n",ctime()[11..18],xx));
#define WDB(xx)

/* Topliste updaten (ohne Parameter aufrufen!!) */
varargs int UpdateTopList(mixed names)
{
  int rating, i, g_rat;
  object pl;

  // Immer nur ein Update auf einmal
  if (find_call_out("UpdateTopList") != -1)
    return 0;

  if (!names)
  {
    names = m_indices(druids);
    tmp_top = ([ ]);
  }

  i = 0;
  while (i < sizeof(names))
  {
    //WDB("now processing "+names[i]+"...");
    rating = g_rat = 0;
    if(query_wiz_level(names[i]) < 10)
    {
      if(((pl=find_player(names[i])) || (pl=find_netdead(names[i]))) &&
          !pl->QueryProp(P_TESTPLAYER))
      {
        if(pl->QueryProp(P_GUILD) != "druidenzirkel" ) {
          WDB(names[i]+" ist kein Druide!\n");
          call_out("DeleteMember",0,pl);
          i++;
          continue;
        }
        rating = CalculateRating( names[i],
                                  g_rat = pl->QueryProp(P_GUILD_RATING),
                                  pl->QueryProp(P_LEVEL),
                                  druids[names[i],1]);
      }
      else if(call_other(SAVEMASTER, "QueryFileProp", names[i],P_TESTPLAYER)==0)
      {
        if(call_other(SAVEMASTER, "QueryFileProp", names[i],P_GUILD) != 
            "druidenzirkel" )
        {
          WDB(names[i]+" ist kein Druide!\n");
          call_out("DeleteMember",0,pl);
          i++;
          continue;
        }
        rating = CalculateRating( names[i],
                                  g_rat = call_other(SAVEMASTER,
                                    "QueryFileProp", names[i], P_GUILD_RATING),
                                  call_other(SAVEMASTER,
                                    "QueryFileProp", names[i], P_LEVEL),
                                  druids[names[i],1]);
      }
    } 
    WDB("now processing "+names[i]+"..."+rating);
    if(rating && CheckLegendary(names[i],g_rat) == -1) {
      if(!member(tmp_top, rating)) {
        tmp_top += ([rating:({names[i]})]);
      }
      else tmp_top[rating] += ({names[i]});
    }

    i++;
    if ((i >= 20) && sizeof(names) > i)
    {
      WDB("callout iteration");
      names = names[i..];
      call_out("UpdateTopList", 2, names);
      return 2;
    }
  }

  WDB("deleting zerovalued druids");
  for(i = sizeof(m_indices(tmp_top)); i-->0;) {
    if(!sizeof(m_values(tmp_top)[i]))
       tmp_top = m_delete(tmp_top, m_indices(tmp_top)[i]);
  }
  top = tmp_top;        // top passt jetzt
  tmp_top = ([ ]);

  WDB("saving");
  saveload=top;
  save_object(TOPLIST);
  saveload=0;

  // Abschliessendes...
  WDB("MakeReadList");
  MakeReadList();
  WDB("SetNumberOne");
  SetNumberOne();    
  WDB("Finished.");

  return 1;
}

/* Topliste in file 'toplist.read' schreiben, Ausgabe ueber 'more' */
int MakeReadList()
{
 int *arm, i, j, k,tabs, stufe, nummer;
 float best, fac;
 string name, element, l_druids;

 rm(REALTOPLIST);
 l_druids="";
 nummer=1;
 write_file(REALTOPLIST, "(Stand vom "+dtime()[0..23]+
     ")\n\nLEGENDAERE DRUIDEN:\n");
 for(i=0;i<=sizeof(legendary)-1;i++) {
   if(stringp(legendary[i]))
     l_druids+=CAP(legendary[i])+"(" + 
       capitalize(druids[legendary[i], 16]) + "), ";
 }
 if(l_druids=="") l_druids="Keine  ";
 l_druids+="\b\b";
 write_file(REALTOPLIST, break_string(l_druids,60, "\t")+"\n\n");
 write_file(REALTOPLIST, "        Name\t\tElement\tGstufe\tWertung "
                        +"(Nr.1=100)\n");
 write_file(REALTOPLIST, "--------------------------------------"
                     +"--------------------\n");
 arm=sort_array(m_indices(top), #'>); //');
 k=sizeof(arm);
 if(k>100) k=100;
 for(i=k-1;i>=0;i--) {
   if(arm[i]) {
     if(i==k-1) {
       best=(float)arm[i];
     }
     for(j=sizeof(top[arm[i]])-1;j>=0;j--) {
       name=CAP(top[arm[i]][j]);
       fac=(float)(arm[i]/best)*100;
       if(!catch(element=capitalize(druids[lower_case(name), 16])) &&
           nummer<100) {
         tabs=2-(int)(strlen(name)/8);
         stufe=druids[lower_case(name), 1];
         if(arm[i]==1)
	   write_file(REALTOPLIST, sprintf("%2d.\t%s%*'\t's%s\t%2d\t  -.---\n", 
 		    nummer, name, tabs, "", element, stufe)); 
         else 
           write_file(REALTOPLIST, sprintf("%2d.\t%s%*'\t's%s\t%2d\t%7.3f\n", 
                    nummer, name, tabs, "", element, stufe, fac));
         nummer++;
       }
     }
   }
 }
 return 1;
}

