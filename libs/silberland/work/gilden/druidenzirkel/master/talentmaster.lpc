#define TALENTS "/gilden/druidenzirkel/backup/talents"
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>
#include <language.h>
#include <combat.h>
#include <properties.h>
#include <moving.h>
#include "../druiden.h"
#include "../mysteries.h"

#define BACKUP(x) "/gilden/druidenzirkel/backup"+x

nosave mapping players = ([ ]);
nosave mapping lastTalentReset = ([ ]);
mixed saveload;

public void create() {
  seteuid(getuid(this_object()));
  if (restore_object(TALENTS))
   players=saveload;
  saveload=0;
  return;
}

mixed GetSaveLoad()
{
  return saveload;
}

public int DoBackup() {
  saveload=players;
  save_object(TALENTS);
  rm(BACKUP("talents.log"));
  write_file(BACKUP("talents.log"),
             "Letztes Backup: "+dtime(time())+"\n");
  return 1;
}


public int DoRestore() {
  if(restore_object(TALENTS))
    save_object(TALENTS);
  players = saveload;
  return 1;
}

public int HasTalent(object ob, int talent)
{
  string pl;
  if(!objectp(ob)) return 0;
  
  pl = getuid(ob);

  if(!member(players, pl)) players += ([ pl:"" ]);

  return test_bit(players[pl], talent);
}

public int ActivateTalent(object ob, int talent) {
  string pl;
  pl = getuid(ob);
  if(!member(players, pl)) players+=([pl: ""]);

  if(!member(players, pl)) {
    players += ([pl: ""]);
  }

  players[pl] = set_bit(players[pl], talent);
  DoBackup();
  return HasTalent(ob, talent);
}

public int DeactivateTalent(object ob, int talent) {
  string pl;
  pl = getuid(ob);
  if(!member(players, pl)) players+=([pl:([])]);

  if(!member(players, pl)) {
    players += ([pl: ""]);
  }

  players[pl] = clear_bit(players[pl], talent);

  DoBackup();
  return !HasTalent(ob, talent);
}

public mapping GetAll() {
  return players;
}

public void reset() {
  DoBackup();
  return;
}

public int* GetActiveTalents(object pl) {
  int i;
  int *activeTalents;

  activeTalents = ({ });

  for(i=0; i<MAX_TALENT_NR; ++i) {
    if(HasTalent(pl, i)) {
      activeTalents += ({ i });
    }
  }

  return activeTalents;
}

public int ResetTalents(object ob) {
  string pl;
  int sacrificed;

  pl = getuid(ob);
  
  /*if(member(lastTalentReset, pl)) {
    if( ( lastTalentReset[pl] - sacrificed) > 0) {
      return lastTalentReset[pl] - sacrificed;
    } else {
      lastTalentReset = m_delete(lastTalentReset, pl);
    }
  }
*/
  
  players[pl] = "";
  lastTalentReset[pl] = time();
  return 0;
}
