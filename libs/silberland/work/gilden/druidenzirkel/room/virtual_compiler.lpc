inherit "std/virtual/v_compiler";
#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include "../druiden.h"
#define P_VALID_NAME "valid_name"

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, DRUIDEN("room/") );
  SetProp(P_STD_OBJECT, DRUIDEN("room/himmel"));
  SetProp(P_VALID_NAME, ({"himmel", "fels"}));
}


string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1) &&
      (who==lower_case(who)))
  {
    SetProp(P_STD_OBJECT, DRUIDEN("room/"+name));
    return file;
  }
}


int CustomizeObject()
{
  string name,foo, who;
  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%s",foo,who)!=2)
    return 0;
  return 1;
}



