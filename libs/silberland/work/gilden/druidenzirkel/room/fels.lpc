inherit "std/room";

#include <player.h>
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../druiden.h"

void create() {
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_AIR, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im erzernen Herzen des Silberlandes");
  SetProp (P_NOMAGIC, 200);
  SetProp (P_HIDE_EXITS, 1);
  SetProp (P_NOQUIT, 1);
  SetProp (P_NO_TPORT, NO_TPORT);
  SetProp (P_NOMAGIC, 500);
  SetProp (P_INT_LONG, 
      "Dunkelheit. Du kannst nichts erkennen. Du fuehlst Dich, als waerst "
      "Du Teil des Elementes Erz.");

  AddCmd( ({"schlafe", "schlaf"}), "no_sleep");
  AddRoomMessage( ({
        "Du fuehlst Dich dem Element Erz sehr nahe.\n",
        "Ein wohliger Schauer laeuft ueber Deinen Ruecken.\n",
        "Zeit hat fuer Dich nun keine Bedeutung mehr.\n",
        BS("Du schauderst, als Du mit dem Erzelementar durch eine Goldader "
          "gleitest."),
        "Du fuehlst die Ewigkeit um Dich herum.\n",
        "Du erahnst grosse Reichtuemer in Deiner Naehe.\n", 
        "Die Macht des Erzes erfuellt Dich!\n",
        }),30);
  previous_object()->CustomizeObject();
}

int no_sleep() {
  tell_object(TP, "Hier kannst Du nicht einschlafen.\n");
  return 1;
}


string raum() {
 return QueryProp(P_INT_LONG);
}

void init() {
  ::init();
  if(stringp(TP->QueryProp("destination")) && interactive(TP)) {
    call_out("DoJourney", 0);
  }
}

int DoJourney() {
  tell_room(ME, "Es wird dunkel, als das Erzelementar Dich umschliesst!\n");
  call_out("EndJourneyNear", random(60)+100);
  return 1;
}

int EndJourneyNear() {
  tell_room(ME, "Du hast das Gefuehl, als ware Deine Reise bald zu Ende.\n");
  call_out("EndJourney", random(10)+6);
  return 1;
}

int EndJourney() {
  string dest;
  tell_room(ME, BS("Das Erzelementar laesst Dich foermlich aus dem Boden "
        "wachsen. Du bist am Ziel Deiner Reise angekommen."));
  dest=TP->QueryProp("destination");
  if(!dest || catch(call_other(dest,"???"))) 
  {
    dest="/gilden/druidenzirkel";
  }
  TP->SetProp("destination",0);
  TP->move(dest, M_NOCHECK|M_SILENT);
  tell_room(dest, BS(sprintf("%s waechst ploetzlich aus dem Boden heraus!",
          TP->Name(WER))), ({TP}));
  return 1;
}
