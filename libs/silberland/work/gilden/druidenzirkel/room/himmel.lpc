/*
** Auf dem Ruecken des Luftelementars
** (c) Angox@SL
** 09.11.1998
*/

inherit "std/room";

#include <player.h>
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../druiden.h"

void create() {
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_AIR, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf dem Ruecken eines Luftelementars");
  SetProp (P_NOREST, "In luftiger Hoehe zu rasten ist keine so gute Idee!\n");
  SetProp (P_NOMAGIC, 200);
  SetProp (P_HIDE_EXITS, 1);
  SetProp (P_NOQUIT, 1);
  SetProp (P_NO_TPORT, NO_TPORT);
  SetProp (P_INT_LONG, 
      "Der Wind zersaust Dir Dein Haar, als Du auf dem Ruecken Deines "
      "Luftelementars ueber das SilberLand fliegst. Von hier oben "
      "hast Du einen wunderbaren Ausblick ueber das gesamte Land. "
      "Durch die grosse Hoehe kannst Du keine genauen Einzelheiten erkennen, "
      "jedoch ist das Gefuehl, hier zu fliegen, einfach phaenomenal!");

  AddDetail( ({"wind", "luft", "luefte"}),
      "Du spuerst die Kraft des Windes an Deinem Gewand ziehen. Es ist "
      "einfach ein herrliches Gefuehl.");
  AddDetail( ({"gewand"}), 
      "Woodyseidank, Du hast alles festgeschnallt, und so kann Dir vom "
      "Wind auch nichts weggerissen werden.");
  AddDetail( ({"gefuehl"}),
      "Du fuehlst Dich einfach gut, hier durch die Luft zu fliegen.");
  AddDetail( ({"haar"}), 
      "Durch den starken Wind ist Dein Haar komplett zersaust. Aber nichts"
      "desdotrotz - was fuer ein herrliches Gefuehl, zu die Luefte "
      "zu brausen!");
  AddDetail( ({"luftelementar", "elementar", "gestalt"}),
      "Die Gestalt, die Dich mit elementarer Kraft an sich bindet, laechelt "
      "Dir zu, und instinktiv weisst Du, dass Du keine Angst zu haben "
      "brauchst.");
  AddDetail( ({"kraft"}),
      "Die elementare Kraft des Luftelementars ist gigantisch. Wie auf "
      "Schwingen gleitet es durch die Luefte. Du fuehlst Dich "
      "hier absolut sicher.");
  AddDetail( ({"hoehe"}), 
      "Ja, es ist schon sehr hoch. Sei froh dass Dich das Luftelementar "
      "festhaelt, so kannst Du nicht nach untenfallen, falls du ohnmaechtig "
      "wirst.");
  AddDetail( ({"ruecken"}),
      "Ja, Du bist hier am Ruecken des Luftelementars. Sei froh, sonst "
      "wuerdest Du wohl bald tot sein :)");
  AddDetail( ({"ausblick", "silberland", "land"}),
      "Der Ausblick ist gigantisch! Das ganz SilberLand ist unter Dir zu "
      "erkennen: Ganz im Norden sind die Auslaeufer des Polargebietes zu "
      "sehen, direkt unter Dir siehst Du den Hauptkontinet mit Midas, "
      "Elessar, Kyranda, Derlim, das Fischerdorf, Knarkh, die grossen "
      "Gebirgszuege, "
      "die weite Ebene, selbst die Wueste ist zu sehen. All das ist winzig "
      "klein, so dass Du nichts genaueres erkennen kannst.");
  AddDetail( ({"norden","polargebiet"}),
      "Hoch im Norden siehst Du das Polargebiet. Leider ist es zu weit "
      "weg, um etwas genaueres zu erkennen.");
  AddDetail( ({"hauptkontinent"}),
      "Der Hauptkoninent liegt genau unter Dir. Du erkennst, dass er "
      "sehr gross ist, und dass grosse Teile noch nicht erforscht sind.");
  AddDetail( ({"midas", "elessar", "kyranda", "derlim", "fischerdorf", 
      "knarkh"}),
      "Diese Doerfer und Staedte liegen unter Dir. Leider kannst Du "
      "nichts erkennen, da Du zu hoch fliegst.");
  AddDetail( ({"staedte", "doerfer"}),
      "Kyranda, Knarkh, das Fischerdorf, Midas, Elessar, Derlim.");
  AddDetail( ({"wueste"}),
      "Die Wueste scheint riesig zu sein, selbst aus dieser Hoehe.");
  AddDetail( ({"ebene"}),
      "Die Ebene ist auch sehr gross. Inmitten von ihr liegt Midas.");
  AddDetail ( ({"einzelheiten"}),
      "Um Einzelheiten zu erkennen, bist Du leider zu hoch.");
  AddDetail( ({"himmel"}),
      "Du BIST fast im Himmel. Hier und da kannst Du eine Leiter "
      "erkennen, wo jemand die Farbe blau pflueckt.");
  AddDetail( ({"leiter"}),
      "Du schaust nochmal genau hin ... getaeuscht ... puhh.");
  AddDetail( ({"farbe"}),
      "Ja, der Himmel ist schoen blau - so blau wie ein Zechpreller.");
  AddDetail( ({"zechpreller"}),
      "Dustyseidank ist keiner hier.");
  AddDetail ( ({"gebirgszuege", "gebirge"}),
      "Die Gebirgszuege liegen inmitten und im Nordwesten des "
      "Hauptkontinents.");
  AddDetail( ({"nordwesten"}),
      "Hmm ... sieht geheimnissvoll aus. Sehr verlockend.");
  AddDetail( ({"boden"}),
      "Der Boden ist weit unter Dir.");
  AddDetail( ({"angst"}),
      "Du hast keine Angst.");
  AddDetail( ({"ohren"}),
      "Ja, Deine Ohren.");
  AddSmell(DEFAULT_SMELL, 
    "Ahhh, der frische Wind riecht gut.");
  AddSmell("wind", 
    "So richtig frisch!");
  AddSound(DEFAULT_SOUND, 
    "Du hoerst das Rauschen des Windes, sonst nichts.");
  AddSound( ({"wind", "rauschen"}), 
    "Das Rauschen droehnt in Deinen Ohren!");
  AddRoomMessage( ({"Der Wind zersaust Deine Haare.\n",
      "Ein Vogel fliegt vorbei.\n",
      "Das Elementar weicht einem anderem aus.\n",
      "Dir ist leicht schwindelig.\n",
      BS("Ein Seher fliegt vorbei. Offenbar wurde er gerade 'rund ums "
          "Silberland' geschleudert."),
      "Du siehst ein paar Magier hier oben herumideln.\n",
      "In der Ferne pflueckt gerade jemand etwas Blau vom Himmel.\n",
      "Das Rauschen des Windes droehnt in Deinen Ohren!\n",
      "Der Wind zerrt an Deinen Kleidern.\n",
      "Das Luftelementar fliegt einen Looping. Dir wird uebel.\n",
      "Das Luftelementar scheint hier oben an Staerke zu gewinnen.\n"}),
      15);
  
  AddCmd( ({"schlafe", "schlaf"}), "no_sleep");
  previous_object()->CustomizeObject();
}

nosave int no_sleep() {
  tell_object(TP, "Hier kannst Du nicht einschlafen.\n");
  return 1;
}


string raum() {
 return QueryProp(P_INT_LONG);
}

void init() {
  ::init();
  if(stringp(TP->QueryProp("destination")) && interactive(TP)) {
    call_out("DoJourney", 0);
  }
}

int DoJourney() {
  tell_room(ME, "Das Luftelementar fliegt weit nach oben!\n");
  call_out("EndJourneyNear", random(60)+100);
}

int EndJourneyNear() {
  tell_room(ME, "Das Luftelementar bereitet sich auf die Landung vor.\n");
  call_out("EndJourney", random(10)+6);
}

int EndJourney() {
  string dest;
  tell_room(ME, BS("Das Luftelementar landet und setzt Dich ab. Danach "
      "verschwindet es."));
  dest=TP->QueryProp("destination");
  if(!dest || catch(call_other(dest,"???"))) 
  {
    dest="/gilden/druidenzirkel";
  }
  TP->SetProp("destinstation",0);
  TP->move(dest, M_GO, "abgesetzt", "wird von "
      "einem Luftelementar", "wird von einem Luftelementar hereingebracht "
      "und abgesetzt");
}
