/*
   Dhrkion, die Dunkelelfenstadt - Zordan@SL

   2000-13-02: Iwo
               Spell 'kontrolliere' added.

   2002-12-03: Ronja
               Magier entfernt, da eigenstaendiger NPC
*/

inherit  "/std/gilden_room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <properties.h>
#include <rooms.h>
#include <language.h>
#include <bank.h>
#include <defines.h>
#include <new_skills.h>

#define ENTFROSCHEPREIS 400
#define ENTGIFTEPREIS   200

#include "/gilden/dunkelelfen/dunkelelfen.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Thronsaal von Dhrkion" );
  SetProp(P_INT_LONG,
    "Du spuerst hier gleich die majestaetische Ausstrahlung des Palastes. "
    "Hier muss das Zentrum von Dhrkion sein. Entlang des Thronsaales schweift "
    "Dein Blick auf den grossen Thron, der etwas abgehoben im noerdlichen "
    "Bereich steht. Ein paar Dunkelelfen stehen neben dem Thron und ein "
    "paar Andere liegen voller Ehrfurcht davor. Der Saal selber ist nicht "
    "einmal so dermassen prunktvoll ausgestattet. Aber immer noch ziemlich "
    "stark mit Edelsteinen und anderen wertvollen Dingen versetzt. "
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "rand" }),
    "Das ist eine nicht so gut einsehbare Wand.");

  AddDetail( ({ "waende","wand" }),
    "Auch die Waende sind mit vielen tausenden von kleinen Edelsteinen "
    "verziert worden. An einer Wand steht der Thron."
  );

  AddDetail( ({ "edelsteine","edelstein" }),
    "Mit vielen Edelsteinen ist der Saal ausgeschmueckt worden. Der Reichtum "
    "von Dhrkion muss unermesslich sein. Selbst die Decke und die Waende sind "
    "mit vielen, kleinen Edelsteinen verziert worden.");

  AddDetail( ({ "decke" }),
    "An der Decke haengen viele tausend Edelsteine und verschoenern den "
    "Saal wirklich sehr. Lampen oder Leuchten kannst Du nicht erkennen. Wie "
    "auch im Zentrum der Dunkelstadt.");

  AddDetail( ({ "lampen","leuchten" }),
    "Wo?");

  AddDetail( ({ "dunkelstadt" }),
    "Dhrkion wird auch die Dunkelstadt genannt, da sie fast komplett "
    "in der Dunkelheit liegt. Aber das ist ist ja auch klar, wenn die Bewohner "
    "empfindlich auf Licht reagieren.");

  AddDetail( ({ "licht" }),
    "Hier Licht zu machen kommt fast einer Gotteslaesterung nahe. Allzu lange "
    "solltest Du hier kein Licht machen. Man wuerde Dich eventuell dafuer "
    "einsperren oder gar toeten.");

  AddDetail( ({ "gotteslaesterung","laesterung" }),
    "Es sind schon welche fuer weniger getoetet worden. Da bist Du Dir "
    "ganz sicher!");

  AddDetail( ({ "dinge","ding" }),
    "Sie aufzuzaehlen wuerde einfach zu lange dauern.");

  AddDetail( ({ "gold" }),
    "Das Gold ist sehr rein und sicher viel wert.");

  AddDetail( ({ "ehrfurcht" }),
    "Man hat grossen Respekt und Ehrfurcht vor der Koenigin und befolgt "
    "jeden Befehl von ihr. So gehoert sich das auch.");

  AddDetail( ({ "thron" }),
    "Der Thron ist einfach nur ueberwaeltigend. Er stellt einen Spinnenkoerper "
    "mit acht Beinen dar. Auf ihr sitzt die Koenigin und regiert ueber Dhrkion. "
    "Er ist komplett aus Gold hergestellt worden und waere auch gross genug, "
    "um acht Koeniginnen Platz zu bieten.");

  AddDetail( ({ "platz" }),
    "Der Platz wuerde wirklich leicht ausreichen.");

  AddDetail( ({ "koeniginnen" }),
    "Natuerlich kann es nur eine Koenigin geben. Aber es wird niemals einen "
    "Koenig geben.");

  AddDetail( ({ "koenig","herrscher" }),
    "Einen maennlichen Herrscher wird es unter den Dunkelelfen niemals geben. "
    "Es herrschen immer nur die weiblichen Dunkelelfen. Das koennte auch "
    "daran liegen, dass die Gottheit der Dunkelelfen eine weibliche Spinne "
    "ist.");

  AddDetail( ({ "gottheit","spinne" }),
    "Die Gottheit der Dunkelelfen ist die Spinne Lloth.");

  AddDetail( ({ "lloth" }),
    "Ueber Lloth gibt es nicht viele Informationen und man wird Dir auch "
    "kaum etwas ueber sie erzaehlen koennen. Sie ist eine Goettin und man "
    "lebt nach ihren Vorstellungen. Ausserdem hat sie diese Stadt und "
    "auch die Dunkelelfen selber erschaffen um sich im SilberLand zu "
    "manifestieren.");

  AddDetail( ({ "silberland","land" }),
    "Na Du bist im SilberLand, schon vergessen?");

  AddDetail( ({ "informationen","information" }),
    "Du kannst ja versuchen, welche bei den Dunkelelfen zu bekommen. Aber "
    "Du glaubst kaum, dass das viel sein wird.");

  AddDetail( ({ "vorstellungen" }),
    "Wie die genau aussehen, weiss wohl nur Lloth selber.");

  AddDetail( ({ "boden" }),
    "Der Boden ist mit huebschen Marmorsteinen ausgelegt worden. Ein "
    "paar Dunkelelfen liegen auf dem Boden und huldigen ihrer Koenigin.");

  AddDetail( ({ "dunkelelfen","andere" }),
    "Ein paar Dunkelelfen stehen neben der Koenigin und ein paar andere "
    "liegen auf dem Boden vor dem Thron. Jeder von ihnen wuerde auf ein "
    "Wort der Koenigin sofort losgehen und deren Befehl ausfuehren.");

  AddDetail( ({ "blick" }),
    "Dein Blick kommt an dem Thron einfach nicht vorbei. Er ueberwiegt "
    "alles bisher dagewesene.");

  AddDetail( ({ "bereich" }),
    "Der Thronsaal ist in zwei Bereiche aufgeteilt. Einen fuer die normalen "
    "Dunkelelfen und einen fuer die Koenigin, der nicht zu betreten ist.");

  AddDetail( ({ "thronsaal","hauptsitz","saal" }),
    "Der Thronsaal ist der Hauptsitz der Koenigin von Dhrkion. Von hier aus "
    "regiert sie ueber alle Dunkelefen und entscheidet ueber alles. Der "
    "Saal selber ist nicht so prunktvoll ausgestattet, wie etwa der Tempel. "
    "Trotzdem zeigt er deutlich die Macht der Koenigin. Desweiteren nutzt "
    "man den Thronsaal als Gilde fuer die Abenteurer der Dunkelelfen.");

  AddDetail( ({ "tempel" }),
    "Der Tempel bildet ortsmaessig gesehen den Mittelpunkt der Stadt. Er ist "
    "ziemlich pruntkvoll ausgestattet und uebertrifft den Thronsaal sehr stark.");

  AddDetail( ({ "macht","frage" }),
    "Die Macht der Koenigin steht hier ausser Frage. Sie ist so dermassen gross, "
    "so dass sich die Dunkelelfen auf ein Wort von ihr auch selber umbringen "
    "wuerden.");

  AddDetail( ({ "wort" }),
    "Man koennte auch Befehl dazu sagen, stimmt schon.");

  AddDetail( ({ "befehl" }),
    "Was die Koenigin sagt wird sofort und unverzueglich ausgefuehrt.");

  AddDetail( ({ "ausstrahlung" }),
    "Die majestaetische Ausstrahlung ist hier sehr deutlich zu spueren. "
    "Du bist ueberwaelltigt und auch ein wenig eingeschuechtert.");

  AddDetail( ({ "palast" }),
    "Du stehst im Zentrum des Palastes, dem Thronsaal.");

  AddDetail( ({ "zentrum" }),
    "Der Palast bildet das absolute Zentrum in Dhrkion. Hier werden die "
    "zukuenftigen Entscheidungen von der Koenigin getroffen.");

  AddDetail( ({ "dhrkion","stadt" }),
    "Dhrkion ist die Stadt und Heimat der Dunkelelfen. Die bist derzeit im "
    "Zentrum, dem Thronsaal des Palastes.");

  AddDetail( ({ "heimat" }),
    "Hier leben die Dunkelelfen.");

  AddSound( ({ DEFAULT_SOUND }),
    "Ein paar Dunkelelfen beten leise in Richtung Thron.");

  AddSound( ({ "dunkelelfen","elfen" }),
    "Oh nein, Du bist auch eingeschuechtert und hoerst den Elfen sicher "
    "nicht beim Beten zu.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Etwas, was wie Schleim aussieht, riecht ein wenig streng.");

  AddSmell( ({ "etwas","schleim","gift","spinnengift","geruch" }),
    "Der Schleim verbreitet einen leicht ekeligen Geruch im ganzen Raum "
    "Aber niemand ausser Dir scheint sich daran zu stoeren.");

  AddDetail( ({ "abenteurer" }),
    "Die Abenteurer der Dunkelelfen legen mehr Wert auf Magie als die der "
    "anderen Rassen.");

  AddDetail( ({ "wert","magie" }),
    "Dunkelelfen beherrschen die Magie mehr als ausgezeichnet.");

  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen im SilberLand. Die Dunkelefen sind "
    "eine davon.");

  AddDetail( ({ "gilde" }),
    "Du kannst hier folgende Befehle der Abenteurer Gilde benutzen:\n\n"
    "liste           - Die Liste der verfuegbaren/geloesten Quests\n"
    "erhoehe (stufe) - Die Stufe oder Attribute erhoehen\n"
    "kosten          - Zeigt Dir die zunaechst benoetigten Stufenpunkte an\n"
    "lerne (spruch)  - Erlernen eines neuen Zauberspruches\n\n"
    "Der Magier kann Dir folgende Dienste anbieten:\n\n"
    "entfrosche      - "+ENTFROSCHEPREIS+" Muenzen\n"
    "entgifte        - "+ENTGIFTEPREIS+" Muenzen pro Giftgrad\n"
  );

  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"darkelf_spells");

  AddSpell("terrorblitz");
  AddSpell("identifiziere");
  AddSpell("schaetz");
  AddSpell("dunkelheit");
  AddSpell("ausweichen");
  AddSpell("dunkellanze");
  AddSpell("schnell");
  AddSpell("drider");
  // 2000-13-02 Iwo
  AddSpell("kontrolliere");
  // 2005-0529 Feyaria
  AddSpell("spinnenfluch");

  AddItem("/d/unterwelt/zordan/dhrkion/npc/koenigin", REFRESH_DESTRUCT);
  AddItem("/d/unterwelt/zordan/dhrkion/npc/mystixfis", REFRESH_DESTRUCT);

  AddCmd( ({"kosten", "wandle", "erhoehe", "lern", "lerne"}), "delfengilde");
  AddCmd( ({"entfrosche","entfrosch","entgifte"}) ,"cmd_magier");

  AddExit( "suedosten",     "/d/unterwelt/zordan/dhrkion/room/palast-f3" );
  AddExit( "suedwesten",    "/d/unterwelt/zordan/dhrkion/room/palast-d3" );

  AddSpecialDetail( "koenigin","koeniginfkt" );

  SetProp(P_GUILD_MALE_TITLES,
     ([1 : "der hoffnungsvolle Dunkelelf",
       2 : "der kleine Boesewicht",
       3 : "der Dunkle",
       4 : "der fiese Kundschafter",
       5 : "der Dunkelreichdiener",
       6 : "der Meuchler",
       7 : "der Schattenbringer",
       8 : "der Diener des Zwielichts",
       9 : "der Schattenkaempfer",
       10: "der Verfechter der Dunkelheit",
       11: "der finstere Magiekundige",
       12: "der boese Magiemeister",
       13: "der finstere Gelehrte",
       14: "der Totenbeschwoerer",
       15: "der Verfechter des Boesen",
       16: "der Gesandte von Lloth",
       17: "der angehende Dunkelelfenpriester",
       18: "der Dunkelelfenpriester",
       19: "der angehende Dunkelelfenseher",
       20: "der Dunkelelfenseher" ]));

  SetProp(P_GUILD_FEMALE_TITLES,
     ([1 : "die hoffnungsvolle Dunkelelfin",
       2 : "die kleine Boesewichtin",
       3 : "die Dunkle",
       4 : "die fiese Kundschafterin",
       5 : "die Dunkelreichdienerin",
       6 : "die Meuchlerin",
       7 : "die Schattenbringerin",
       8 : "die Dienerin des Zwielichts",
       9 : "die Schattenkaempferin",
       10: "die Verfechterin der Dunkelheit",
       11: "die finstere Magiekundige",
       12: "die boese Magiemeisterin",
       13: "die finstere Gelehrte",
       14: "die Totenbeschwoererin",
       15: "die Verfechterin des Boesen",
       16: "die Gesandte von Lloth",
       17: "die Dunkelelfenpriesterin",
       18: "die Oberin",
       19: "die angehende Dunkelelfenseherin",
       20: "die Dunkelelfenseherin" ]));
}

int cmd_magier(string str)
{
  if(!present("mystixfis",TO))
  {
    tell_object(TP,"Das kann nur der Magier, und der ist zur Zeit nicht "
                   "da!\n");
    return 1;
  }
  return 0;
}

string koeniginfkt(string str) {
  if(!present("koenigin")) {
    return "Oh, wo ist sie denn hin?\n";
  } else {
    return "Sie sitzt doch auf ihrem Thron!\n";
  }
}

int MaxGuildRating() {
  return 8000;
}

int GuildRating(object pl) {
  return pl->SetProp(P_GUILD_RATING,
      ::GuildRating(pl)*4/5);
}

int bei_oder_aus_treten(string str) {
  return 0;
}

int delfengilde(string str) {
  string race;
  if( (race=TP->QueryProp(P_RACE)) != "Dunkelelf") {
    notify_fail("Hier ist die Dunkelelfengilde. Als "+race+" hast Du hier "
                "wirklich nichts zu suchen.\n");
    return 0;
  }
  switch(query_verb()) {
    case "kosten":  return kosten(str);
    case "wandle":  return change(str);
    case "erhoehe": return advance(str);
    case "lern":
    case "lerne":   return LearnSpell(str);
  }
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
