//
// INIT 
//
void init() {
  string txt;
  object amulett, ob;
  int x, y, rnd, l_stat;
  mapping help_map;
  mixed help_mixed;
  ::init();
  // STUFE 16 Check :)
  if (interactive(TP) && IsGuildMember(TP) && 
      TP->QueryProp(P_GUILD_LEVEL)==15 && TP->QueryProp(P_LEVEL)>=60 &&
      TP->QueryProp(P_GUILD_RATING) > 9000) 
  {
    amulett=present("\ndruidenamulett", TP);
    l_stat=call_other(DRUIDENMASTER, "QueryLvl16Quest", TP);
    txt=sprintf("Druide:[%O]", TP);
    if (objectp(amulett) && (amulett->Query16() || IS_ARCH(TP)) && 
        (l_stat==1 || l_stat==99))
    {
      if(l_stat==1) rnd=50;
      else rnd=150;
      if( member(call_other(DRUIDENMASTER, "QueryLegendary"), getuid(TP)) != -1)
        rnd /= 2; // Legendaere haben hoehre chance... da wirds ja zeit dass die 16 werden
      txt+=", 1st check ok";
      if(!(x=random(rnd))) {
        call_out("GetLvl16Quest", (y=random(300)+190), TP);
        tdm(sprintf("\n%s***%s %s koennte Aufgabe 1 fuer GST 16 bekommen!\n", 
            ANSI_BLINK+ANSI_RED, ANSI_NORMAL, CAP(getuid(TP))));
        write_file(LOG("lvl16quest"), sprintf("%s: %s koennte die erste "
            "Aufgabe bekommen (%ds)!\n", dtime(time()), CAP(getuid(TP)), x));
      }
      txt+=sprintf(", rnd: %d(%d)", x, rnd);
      amulett->Del16();
      txt+="\n";
      if(!IS_LEARNER(TP))
        write_file(LOG("lvl16rnd"), sprintf("%s: %s", dtime(time())[5..], txt));
    }
    if(objectp(ob=present(TASKITEM, TP)) && (time()-ob->QueryProp(E_TIME)) > 
        43200 && call_other(DRUIDENMASTER, "QueryLvl16Quest", TP)==2)
    {
      call_out("Lvl16Failed", 0, TP);
    }
    if(objectp(ob=present(TASKITEM, TP)) && (time()-ob->QueryProp(E_TIME)) > 
        345600 && call_other(DRUIDENMASTER, "QueryLvl16Quest", TP)==3)
    {
      call_out("Lvl16Failed", 0, TP);
    }
  }

}


// TEST
mixed test123() {
 write(sprintf("%O\n", QueryProp(P_GUILD_LEVELS)[TP->QueryProp(P_GUILD_LEVEL)+1]));
 return call_other(RES_CHECKER, "check_restrictions", TP,
    QueryProp(P_GUILD_LEVELS)[TP->QueryProp(P_GUILD_LEVEL)+1]);
}



string maghelp()
{
 if(!IS_LORD(TP) && member(DRUIDENMAGIER, TP->query_real_name())==-1) return "";
 return "\nMagInfo: Hilfe fuer Magierbefehle mit 'gilde hilfe'.";
}
/* Funktionen fuer Magier */
int magfunc(mixed str)
{
  mixed *txt;
  object ob;
  int err, task;
  string name;
  if(!IS_LORD(TP) && member(DRUIDENMAGIER, TP->query_real_name())==-1) return 0;
  if(!str) str="hilfe";
  if(str=="hilfe") {
   write("Folgende Befehle sind moeglich:\n"
         "gilde hilfe  : Dieses hier\n"
         "gilde backup : Backup des Memberfiles\n"
         "gilde restore: Zurueckspielen des Backups\n"
         "gilde toplist: Updaten der Topliste\n"
         "gilde set_task <name> <task> : Setzen eines Tasks\n"
         "gilde del_task <name> <task> : Loeschen eines Tasks\n"
         "gilde memberdel <name> : Spieler aus Gilde loeschen\n");
   return 1;
  }
  txt=explode(str, " ");
  if(member(({"backup", "restore", "set_task", "del_task"}), txt[0])!=-1) {
    if(!IS_ARCH(TP) && member(DRUIDENMAGIER, TP->query_real_name())==-1) {
      write_secure_log(sprintf("Versuchte Aenderung im Gildenmaster (%s) "
		       "von %s\n", str, CAP(getuid(TP))));
      write("Befehl nicht ausfuehrbar. Grund: Magierlevel < 60\n");
      return 1;
    }
    else write_file(LOG("changes"), sprintf("Aenderung im Gildenmaster"
           "(%s): gilde %s\n", CAP(getuid(TP)), str));
  }
  
  if(txt[0]=="memberdel") {
    if(sizeof(txt)<2) {
     tell_object(TP, "Syntax: gilde memberdel <name> \n");
     return 1;
    }
    name=lower_case(to_string(txt[1]));
    err=call_other(DRUIDENMASTER, "DeleteMember", name);
    if(err!=1) {
      tell_object(TP, sprintf("DeleteMember: Fehler. Code %d\n", err));
      return 1;
    }
    err=call_other(DRUIDENMASTER, "DeleteTopEntry", name);
    if(err!=1) {
      tell_object(TP, "Task geloescht.\n");
      return 1;
    }
  }
 
  if(txt[0]=="backup") {
    call_other(DRUIDENMASTER, "DoBackup"); 
    tell_object(TP, "Kopiere members/members.o nach "
              "backup/members_backup.o\n");
    return 1;
  }
  if(txt[0]=="restore") {
    if(call_other(DRUIDENMASTER, "DoRestore")==-2){
      tell_object(TP, "Fehler! Members.o konnte nicht restored "
                  "werden!\n");
      return 1;
    } 
    tell_object(TP, "Kopiere backup/members_backup.o nach "
                  "members/members.o\n");
    return 1;
  }
  if(txt[0]=="toplist") {
    call_other(DRUIDENMASTER, "UpdateMemberLevels");
    call_other(DRUIDENMASTER, "UpdateTopList");
    // call_other(DRUIDENMASTER, "MakeReadList");
    // call_other(DRUIDENMASTER, "SetNumberOne");
    tell_object(TP,"Memberliste ist in Kuerze (ca. 15 Sekunden) up-to-date.\n");
    return 1;
  }
  if(txt[0]=="set_task") {
    if(sizeof(txt)<3) {
      tell_object(TP, "Syntax: gilde set_task <name> <Task>\n");
      return 1;
    }
    task=to_int(txt[2]);
    name=lower_case(to_string(txt[1]));
    if(!(ob=find_player(name)) && !(ob=find_netdead(name))) {
      tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
      return 1;
    }
    err=call_other(DRUIDENMASTER, "SetTask", ob, task);
    if(err!=1) {
       tell_object(TP, sprintf("Fehler. Code %d\n", err));
       return 1;
    }
    tell_object(TP, "Task gesetzt.\n");
    return 1;
 } 
 if(txt[0]=="del_task") {
   if(sizeof(txt)<3) {
     tell_object(TP, "Syntax: gilde del_task <name> <Task>\n");
     return 1;
   }
   task=to_int(txt[2]);
   name=lower_case(to_string(txt[1]));
   if(!(ob=find_player(name)) && !(ob=find_netdead(name))) {
     tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
     return 1;
    }
   err=call_other(DRUIDENMASTER, "DeleteTask", ob, task);
   if(err!=1) {
      tell_object(TP, sprintf("Fehler. Code %d\n", err));
      return 1;
   }
    tell_object(TP, "Task geloescht.\n");
    return 1;
 }

  tell_object(TP, "Befehl nicht moeglich!\n");
  return 1;
}


/* Bestenliste */
string liste()
{
 TP->More("\nDIE BESTEN DER DRUIDEN:\n"+read_file(REALTOPLIST));
 tell_room(TO, BS(sprintf("%s schaut sich den Altar genauer an.", 
           TP->Name(WER))), ({TP}));
 return "";
}



/* Backup der Memberliste */
reset()
{
  ::reset();
  zaehler++;
  if(zaehler==5) {
    call_other(DRUIDENMASTER, "DoBackup"); 
    zaehler=0;
  }
}

// Funktionen zwecks resetlag ueber crontab 
void toplist_update() {
  call_other(DRUIDENMASTER, "UpdateMemberLevels");
  call_other(DRUIDENMASTER, "UpdateTopList"); 
  // call_other(DRUIDENMASTER, "MakeReadList"); 
  // call_other(DRUIDENMASTER, "SetNumberOne");
  return;
}

/* Skillablilty am Anfang in einen Bereich 3000..5000 setzen */
nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if(value<3000) value=3000;
  else if(value>5000) value=5000;
  return value;
}


int GuildRating(object pl) {
  string c_element, *z;
  mapping ski;
  string *sk;
  int i, cnt, sum;
  closure qsa;
  
  if (!IsGuildMember(pl)||!query_once_interactive(pl))
       return 0;
  if (!(ski = QueryProp(P_GUILD_SKILLS)) ||
      !(qsa = symbol_function("QuerySkillAbility",pl)))
     return 0;
  
  sk=m_indices(ski);
  switch(call_other(DRUIDENMASTER, "GetDruidElement", pl)) {
    case FEUER  : z=wasser; break;
    case WASSER : z=feuer;  break;
    case EIS    : z=humus;  break;
    case HUMUS  : z=eis;    break;
    case ERZ    : z=luft;   break;
    case LUFT   : z=erz;    break;
    default     : z=({});             
  }
  if (pl->QueryProp(P_GUILD_LEVEL) == 16) // Auf Stufe 16 zaehlen allen Zauber
    z = ({});
  sk-=z;
  //tell_angrox(sprintf("%O\n", sk));
  cnt=sizeof(sk);

  for (i=cnt-1, sum=0; i>=0; i--)
  sum += funcall(qsa, sk[i]);

  sum = sum/cnt;
  if (sum < 0)
  sum = 0;
  else if (sum > MAX_ABILITY)
  sum = MAX_ABILITY;
  
  return pl->SetProp(P_GUILD_RATING, sum);
}
  

/* So gehts nicht :> */
int falscher_syntax()
{
  if(!present("anvar", TO)) {
    write(BS("Ohne Anvar laeuft hier gar nichts!\n"));
    return 1;
  }
  write(BSA("Du musst Dich nun entscheiden, welchem Element Du "
            "beitreten willst. (Syntax: \"trete <element> bei\")"
            "Du kannst zwischen Humus, Eis, Wasser, Feuer, Erz "
            "und Luft auswaehlen.",
             "Anvar teilt Dir mit: "));
  return 1;
}

/* Austritt aus der Gilde */
int austreten()
{
  object ob;
  if(!present("anvar", TO)) {
    write(BS("Ohne Anvar laeuft hier gar nichts!\n"));
    return 1;
  }          
  if(!IsGuildMember(TP))
    return 1;
  this_player()->SetProp( P_GUILD_LEVEL, 0);
  WLOG("/log/gilden/druiden", "tritt aus der Gilde aus");
  write(BSA("Wir halten Dich nicht auf ... ziehe Deines Weges...\n", 
      "Anvar sagt traurig: "));
  say(BSA("Wir halten Dich nicht auf, "+CAP(getuid(TP))+" ... ziehe "
      "Deines Weges...\n", "Anvar sagt traurig: "));
  if(ob=present("\ndruidenamulett",TP)) 
    {
      ob->SetProp(P_CURSED, 0);
      ob->remove();
    }
  call_other(DRUIDENMASTER, "DeleteMember", TP);
  call_other(DRUIDENMASTER, "DeleteTopEntry", getuid(TP));
  call_other(DRUIDENMASTER, "DeleteLegendary", getuid(TP));
  call_other(ABILMASTER, "DeleteEntry", getuid(TP));
  //rm(LOG(getuid(TP)+".log"));
  Channel(CAP(getuid(TP))+" ist gerade aus dem Druidenzirkel ausgetreten.");
  return ::austreten();
}

/* Gildenbeitritt */
int tritt(string str)
{
  string wo, restr;
  string not_fail;
  if(!present("anvar", TO)) {
    write(BS("Ohne Anvar laeuft hier gar nichts!\n"));
    return 1;
  } 
  not_fail="Du musst Dich nun zwischen den Elementen entscheiden. "
    "Waehle weise, denn das Element, welches Du waehlst, "
    "gewaehrt Dir viele Vorteile. Die Syntax lautet: "
    "\"trete <element> bei\".";
  if (!str)
  {
    //write(BSA(not_fail, "Anvar teilt Dir mit: "));
    return 0;
  }
  if(sscanf(str, "%s bei", wo)!=1)
  {
    //write(BSA(not_fail, "Anvar teilt Dir mit: "));
    return 0; 
  }
  if(wo!="eis" && wo!="feuer" && wo!="wasser" && wo!="humus" &&
      wo!="erz" && wo!="luft")
  {
    TP->Message(BSA(not_fail, "Anvar teilt Dir mit: "), MSGFLAG_TELL);
    return 1;
  }
  druid_element=wo;
  if(IsGuildMember(TP))
  {
    TP->Message(BSA("Aber Du bist doch schon Mitglied!", "Anvar staunt: "),
        MSGFLAG_SAY);
    return 1;
  }

  restr=call_other(RES_CHECKER, "check_restrictions", TP,
      QueryProp(P_GUILD_RESTRICTIONS));
  if(stringp(restr))
  {
    Message(BSA(sprintf("Du erfuellst nicht alle Anforderungen, "
            "um Druide zu werden, %s! %s\n", TP->Name(WER), restr), 
        "Anvar sagt: "), MSGFLAG_SAY);
    return 1;
  }
  return beitreten();  
}
 

/* Eigentliche Beitrittsfunktion, wird von tritt() aufgerufen */
int beitreten()
{
  int b;
  object ob;
  if( (b = ::beitreten()) < 0) return 1;
  TP->Message(BSA("Als Zeichen der Mitgliedschaft im Druidenzirkel bekommst "
            "Du ein Amulett, dass auch als Fokus fuer Deine Zauberkraefte "
            "dient. Ohne dieses Amulett kannst Du nicht zaubern.\n", 
            "Anvar sagt: "), MSGFLAG_SAY);
  Message(BSA("Als Zeichen der Mitgliedschaft im Druidenzirkel bekommst "
            "Du ein Amulett, dass auch als Fokus fuer Deine Zauberkraefte "
            "dient. Ohne dieses Amulett kannst Du nicht zaubern.\n", 
            "Anvar sagt zu "+CAP(getuid(TP))+": "),
      MSGFLAG_SAY | MSGFLAG_NO_TP);
  write(BS("Anvar ueberreicht Dir ein Amulett.\n"));
  say(BS("Anvar ueberreicht "+CAP(getuid(TP))+" ein Amulett.\n"));
  ob=clone_object(ARMOUR("d_amulett"));
  ob->move(TP, M_NOCHECK);
  call_other(DRUIDENMASTER, "AddMember", this_player());
  call_other(DRUIDENMASTER, "SetDruidElement", TP, druid_element);
  druid_element="";
  write(BSA("Willkommen im Zirkel der Druiden!\n", "Anvar freut sich: "));
  say(BSA("Willkommen im Zirkel der Druiden, "+CAP(getuid(TP))+"!\n"
         , "Anvar freut sich: "));
  TP->Message(BSA("So, nun einige wichtige Dinge: Du kannst nur zaubern, "
        "wenn Du kein Frosch, kein Geist und nicht blind bist. Weiters "
        "benoetigst Du zum Zaubern das Druidenamulett. Solltest Du es "
        "wider erwarten verlieren, frag mich danach und ich gebe Dir ein "
        "Neues. Wenn Du denkst, Du koennest eine Stufe aufsteigen, so "
        "kannst Du das mit \"erhoehe Gildenstufe\" probieren. Ich kann "
        "Dir auch Deine Fertigkeiten in den Zaubern sagen, der Syntax "
        "dazu lautet \"fertigkeiten\".", "Anvar teilt Dir mit: "),
      MSGFLAG_TELL); 
  say(BS("Anvar gibt "+CAP(getuid(TP))+" ein Pergament.\n"));
  write(BS("Anvar gibt Dir ein Pergament."));
  ob=clone_object(OBJ("pergament"));
  ob->move(TP, M_NOCHECK);   
  WLOG("/log/gilden/druiden", "tritt in die Gilde ein.");
  call_other(DRUIDENMASTER, "AddMember", this_player());
  this_player()->ModifySkill(FIGHT(WT_HANDS),
    QuerySkill(FIGHT(WT_HANDS)),0,"druidenzirkel");
  this_player()->ModifySkill(SK_CASTING,
     QuerySkill(SK_CASTING),0, "druidenzirkel" );
  write_file(MEMBER_LOG(getuid(TP)+".log"),
             dtime(time())+": "+CAP(getuid(TP))+" ist "
             +"in die Gilde eingetreten.\n");
  Channel(CAP(getuid(TP))+" ist gerade in den Druidenzirkel eingetreten.");
  return b;
}

/* Aufstieg */
advance(string str)
{
  mixed b, restr;
  object anvar;
  if(!anvar=present("anvar", TO)) {
    write(BS("Ohne Anvar laeuft hier gar nichts!\n"));
    return 1;
  } 
    
  notify_fail(BSA("Du kannst hier nur die Gildenstufe erhoehen.", 
    "Anvar sagt: "));
  if(!str) return 0;
  if(!IsGuildMember(TP)) {
    tell_room(TO, BSA(sprintf("Du bist kein Druide, %s", TP->Name(WER)),
        "Anvar sagt: "));  
    return 1;
  }
  if(str=="stufe" || str2attr(str))
     return 0;
  if(str=="gildenstufe" || str=="gilde") {
    if(TP->QueryProp(P_GUILD_LEVEL)>=15) {
       write(BSA("Du kannst nicht mehr weiter aufsteigen.\n", 
                 "Anvar sagt: "));
       say(BSA("Du kannst nicht mehr weiter aufsteigen, "
             +CAP(getuid(TP))+".\n", "Anvar sagt: "));
       return 1;
    }

    if((restr=call_other(RES_CHECKER, "check_restrictions", TP,
          QueryProp(P_GUILD_LEVELS)[TP->QueryProp(P_GUILD_LEVEL)+1]))!=0 )
    {
      Message(BSA(sprintf("Du erfuellst nicht alle Anforderungen, "
         "um aufsteigen zu koennen, %s! %s\n", TP->Name(WER), restr), 
        "Anvar sagt: "), MSGFLAG_SAY);
      return 1;
    }
    //write(restr+"\n");
    anvar->_set_druid_info();
    do_advance();
    if(TP->QueryProp(P_GUILD_LEVEL)>14) {
      TP->Message(BSA("Sei willkommen auf der Ebene der "
               "absoluten Vollkommenheit.\n", "Anvar spricht "
               "feierlich: "), MSGFLAG_SAY); 
      Message(BSA("Sei willkommen auf der Ebene der "
               "absoluten Vollkommenheit, "+CAP(getuid(TP))+
              ".\n", "Anvar spricht feierlich: "), MSGFLAG_SAY|MSGFLAG_NO_TP); 
      write_file(MEMBER_LOG(getuid(TP)+".log"),
             dtime(time())+": "+CAP(getuid(TP))+" hat "
              "die hoechste Stufe erreicht.\n");    
      Channel(CAP(getuid(TP))+" hat im Druidenzirkel gerade Gildenstufe 15 "
               "und somit die Vollendung erreicht.");
      return 1;
    } 
    TP->Message(BSA("Sei willkommen auf einer hoeheren "
               "Ebene der Vollkommenheit.\n", "Anvar spricht "
               "feierlich: "), MSGFLAG_SAY);
    Message(BSA("Sei willkommen auf einer hoeheren "
               "Ebene der Vollkommenheit, "+CAP(getuid(TP))+
              ".\n", "Anvar spricht feierlich: "), MSGFLAG_SAY);     
    write_file(MEMBER_LOG(getuid(TP)+".log"),
             dtime(time())+": "+CAP(getuid(TP))+" ist "
              "eine Stufe aufgestiegen.\n"); 
    Channel(CAP(getuid(TP))+" hat im Druidenzirkel Gildenstufe "
              +TP->QueryProp(P_GUILD_LEVEL)+" erreicht.");
    call_other(DRUIDENMASTER, "SetXp", TP, TP->QueryProp(P_XP)+
              XP_PER_LEVEL[TP->QueryProp(P_GUILD_LEVEL)]);
    return 1; 
  }
    /*
    else {
      tell_room(ENV(TP), BSA(sprintf("Du erfuellst nicht alle Anforderungen, "
        +"um aufsteigen zu koennen, %s! %s\n", TP->Name(WER), restr), 
        "Anvar sagt: "));
      return 1;
    }
    */
  return 1;
}

/* Spells lernen */
OwnLearnSpell(string str)
{
 
  if(!present("anvar", TO)) {
     write(BS("Ohne Anvar laeuft hier gar nichts!\n"));
     return 1;
  }   
  if(!IsGuildMember(TP))
  {
    write(BSA("Du bist kein Mitglied dieser Gilde!\n", "Anvar sagt: "));
    return 1;
  }
  notify_fail("Was moechtest Du hier lernen?\n");
  if(!str)
  {
    TP->Message(BSA("Welchen Zauber moechtest Du lernen? Du kannst mich "
         "nach auch nach den Zaubern fragen!", "Anvar sagt: "), MSGFLAG_SAY);
    Message(BSA("Welchen Zauber moechtest Du lernen? Du kannst mich "
         "nach auch nach den Zaubern fragen!",
         "Anvar sagt zu "+CAP(getuid(TP))+": "), MSGFLAG_SAY);
    return 1;
  }
    
  return LearnSpell(str);
}



