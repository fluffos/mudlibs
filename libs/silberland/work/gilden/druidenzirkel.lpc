/*
//
// Ausgabe der Fertigkeiten
//
*/

mixed skill(string skill1, string skill2)
{
  return TP->QuerySkillAbility(skill1)>TP->QuerySkillAbility(skill2); 
}

varargs int faehigkeiten(string sortmod)
{
  int i, wert, sum;
  string *arm, *arm2, s;
  mapping res;
  string output;
  
  if(0 && IS_LEARNING(this_player()))
  {
    write(BSA("Deine Skills: ", "Anvar sagt: "));
    s="";
    res = this_player()->QueryProp(P_NEWSKILLS);
    arm=sort_array(m_indices(res), #'<); //')
    for (i = sizeof(arm)-1;i>=0;i--)
    {
      s += arm[i]+": ";
      if (mappingp(res[arm[i]])) s += res[arm[i]][SI_SKILLABILITY];
      else s += res[arm[i]];
      s += "\n";
      write(BSA(s, "Anvar sagt: "));
      s="";
    }
    return 1;   
  }
  if(!IsGuildMember(TP))
  {
    TP->Message(BSA("Du gehoerst nicht dieser Gilde an!", "Anvar sagt: "),
        MSGFLAG_SAY);
    return 1;
  }
  s="";
  sum = 0;
  res=this_player()->QueryProp(P_NEWSKILLS);
  arm2 = m_indices(res);
  if( member(m_indices(ELEMENT_DAMAGE), sortmod)!=-1 )
  {
    switch (sortmod)
    {
      case FEUER  : arm2=feuer; break;
      case WASSER : arm2=wasser;  break;
      case EIS    : arm2=eis;  break;
      case HUMUS  : arm2=humus;    break;
      case ERZ    : arm2=erz;   break;
      case LUFT   : arm2=luft;    break;
    }
    output = BSA("Du beherrschst Deine "+CAP(sortmod)+"zauber wie folgt: ", 
          "Anvar sagt: ");
  }
  else
    output = BSA("Du beherrschst Deine Zauber wie folgt: ", "Anvar sagt: ");
  if(sortmod=="skill")
    arm=sort_array(arm2, "skill") ; 
  else
    arm=sort_array(arm2, #'<); //')
  for (i = sizeof(arm)-1;i>=0;i--) {
    if(member(({"Cast", "Fight_hands"}), arm[i])==-1) {
      s += CAP(arm[i])+" beherrschst Du";
      wert=TP->QuerySkillAbility(arm[i]);   
      sum += wert;
      s+=int2string(wert);
      if(wert)
        output += BSA(s, "Anvar sagt: ");
      s="";         
    }
  }
  if( member(m_indices(ELEMENT_DAMAGE), sortmod)==-1 )
  {
    s=int2string(TP->QuerySkillAbility("Cast"));
    output += BSA("Die Fertigkeit Zaubern beherrschst Du"+s,"Anvar sagt: ");
    s=int2string(TP->QuerySkillAbility("Fight_hands"));
    output += BSA("Den waffenlosen Kampf beherrschst Du"+s, "Anvar sagt: ");
    if((wert=TP->QueryProp(P_GUILD_RATING))<1501) wert=1501;
    s=int2string(wert);
    output += BSA("Insgesamt betrachtet bist Du"+s, "Anvar sagt: "); 
  }
  else
  {
    s = int2string(sum/sizeof(arm2));
    output += BSA("Insgesamt betrachtet kannst Du die "+CAP(sortmod)+"zauber"+s, 
          "Anvar sagt: "); 
  }
  TP->Message(output, MSGFLAG_SAY);
  say(sprintf("Anvar klaert %s ueber %se Fertigkeiten auf.\n", 
         CAP(getuid(TP)), 
  TP->QueryPossPronoun(WESSEN)));
  return 1;
}

/* Fertigkeitswert in entsprechende Ausgabe umwandeln */
string int2string(int wert) {
 string str;
 switch(wert) {
   case 0..500 : str=" so gut wie gar nicht.\n"; break;
   case 501..1000: str=" fast gar nicht.\n"; break;
   case 1001..1500: str=" kaum.\n"; break;
   case 1501..2000: str=" sehr miserabel.\n"; break;
   case 2001..2500: str=" miserabel.\n"; break;
   case 2501..3000: str=" ziemlich schlecht.\n"; break;
   case 3001..3500: str=" schlecht.\n"; break;
   case 3501..4000: str=" maessig.\n"; break;
   case 4001..4500: str=" unterdurchschnittlich.\n"; break;
   case 4501..5000: str=" durchschnittlich.\n"; break;
   case 5001..5500: str=" ueberdurchschnittlich.\n"; break;
   case 5501..6000: str=" gut.\n"; break;
   case 6001..6500: str=" wirklich gut.\n"; break;
   case 6501..7000: str=" sehr gut.\n"; break;
   case 7001..7500: str=" unglaublich gut.\n"; break;
   case 7501..8000: str=" phantastisch gut.\n"; break;
   case 8001..8500: str=" ausgezeichnet.\n"; break;
   case 8501..9000: str=" hervorragend.\n"; break;
   case 9001..9300: str=" exzellent.\n"; break;
   case 9301..9500: str=" beinahe meisterhaft.\n"; break;
   case 9501..9700: str=" meisterhaft.\n"; break;
   case 9701..9850: str=" nahezu perfekt.\n"; break;
   case 9851..9999: str=" perfekt.\n"; break;
   case 10000: str=" absolut perfekt.\n"; break;
   default: str=" ueberhaupt nicht.\n"; 
 } 
 return str;
}




/*
//
// Funktion fuer den Waffenlosen Kampf
//
*/
mapping HandKampf( object user, string sname, mapping sinfo )
{
  int abil, diff, val, learn, vorher, i, bonus;
  object *arms;
  learn=0;
  if( !mappingp(sinfo)) return 0; 
  if(!objectp(sinfo[SI_ENEMY])) return sinfo;
  abil = sinfo[SI_SKILLABILITY];
  
  vorher=sinfo[SI_SKILLDAMAGE];
  val=user->QueryProp(P_GUILD_LEVEL)*2+
    random(abil*(10+user->QueryAttribute(A_STR)*2+
    user->QueryAttribute(A_DEX)*2+user->QueryAttribute(A_INT))/MAX_ABILITY);  
  if(val > MAX_HANDKAMPF) val=MAX_HANDKAMPF;
  sinfo[SI_SKILLDAMAGE]+=val;
  if(sizeof(arms=filter_array(user->QueryProp(P_ARMOURS), "check_id"))) {
    for(i=sizeof(arms)-1;i>=0;i--) {
      bonus+=arms[i]->QueryProp(P_DRUID_ADD_HAND_DAMAGE);
    }
    bonus=bonus/2+random(bonus/2);
    if(bonus > 50) bonus=50;
    sinfo[SI_SKILLDAMAGE]+=sinfo[SI_SKILLDAMAGE]*bonus/100;
  }
  if(!random(500)) {
    tell_object(user, "Die Kraft der Elemente verstaerkt Deine Attacke!\n");
    learn=1;
    sinfo[SI_SKILLDAMAGE]+=100+abil/30;
  }
  else if (!random(1000)) {
    sinfo[SI_SKILLDAMAGE]/=4;
  }
  //TELL("angrox", sprintf("DRUIDENZIRKEL: Handkampf bei %s: %d (boni: %d)\n", 
  //      CAP(getuid(user)), sinfo[SI_SKILLDAMAGE], bonus));
  if((!random(2) && ((10000-abil) > random(MAX_ABILITY))) || learn) {
    learn=0;
    user->LearnSkill(sname, (2*user->QueryAttribute(A_STR)+
      2*user->QueryAttribute(A_DEX)+user->QueryAttribute(A_INT))/40); 
  }
  if (abil < MAX_ABILITY && 
      user->QuerySkill(FIGHT(WT_HANDS))[SI_SKILLABILITY] == MAX_ABILITY)
    user->Message("Anvar teilt Dir mit: Du kannst Handkampf nun absolut perfekt!\n",
        MSGFLAG_TELL);

  if(HAS_MYSTERY(user, MYSTERY_FIND_WEAKNESS) && sinfo[SI_ENEMY]->QueryProp(P_RESISTANCE_STRENGTHS) && !random(abil/(user->QueryProp(E_HANDS)?300:100))) {
    tell_object(user, BS("Du erkennst eine Schwaeche deines Gegners. Rasch formt das elementare Wasser in dir "
                         "eine Struktur, um diese auszunutzen."));
    sinfo[SI_SKILLDAMAGE] = (int) (sinfo[SI_SKILLDAMAGE] * (1.0 + 
                                    sort_array(map_array(m_values(sinfo[SI_ENEMY]->QueryProp(P_RESISTANCE_STRENGTHS)), #'to_float ), #'<)[0]));
  }

  if(HAS_MYSTERY(user, MYSTERY_STORM_STRIKES) && !random(abil/(user->QueryProp(E_HANDS)?300:100))) {
    tell_object(user, BS("Die Kraft des Sturms faehrt in deine Gleider. Wie Blitz, Donner und Sturm faehrst du auf deine Feinde nieder!"));
    tell_room(ENV(user), BS(sprintf("Die Schlaege von %s rasen in unglaublicher Geschwindigkeit auf %s Feinde zu.", 
                            user->name(WEM, 1), user->QueryPossPronoun(MALE, WEN, 1))), ({user}));
    user->ModifySkillAttribute(user, SA_SPEED, 200 + random(100), 2 + random(abil/2500));
    sinfo[SI_SKILLDAMAGE_TYPE] = ({DT_AIR, DT_LIGHTNING});
  }

  return sinfo;                                                     
}                                                       

int check_id(object ob) {
  if(objectp(ob) && ob->QueryProp(P_DRUID_ADD_HAND_DAMAGE)) return 1;
  return 0;
}
/*
//
// Funktion fuer den Zaubernskill
//
*/
int Zaubern(object user, string sname, mapping sinfo)
{
  int abil, cur_alk, max_alk, value, modifier;
  int learn_abil;
  if(!mappingp(sinfo)) return 0; 
  cur_alk=user->QueryProp(P_ALCOHOL);
  max_alk=user->QueryProp(P_MAX_ALCOHOL);
// value=user->QueryAttribute(A_INT)/10;
// modifier=(((max_alk/3)-cur_alk)/4)+value;
// TELL("feyaria", "MAX_ALK="+max_alk+" ALK="+cur_alk+" INT="+value+" mod="+modifier+"\n");
  value=user->QueryAttribute(A_INT);
  modifier=value/3-cur_alk/(6-value/10);
// Neue lernberechnung, spieler mit hoeherem max_alk lernen zaubern jetzt nicht mehr schneller
  abil=sinfo[SI_SKILLABILITY]+modifier;
  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  if(abil<0) abil=0;
  if(modifier<0) {
    user->ModifySkill(SK_CASTING, abil, 150, "druidenzirkel");
    return -abil * cur_alk / max_alk;
  }
  learn_abil=((MAX_ABILITY - sinfo[SI_SKILLABILITY]) + (value / 5))/2;
  if(learn_abil < 100)
    learn_abil*=2;
  if((!random(15) && random(MAX_ABILITY) <= learn_abil) || 
      (sinfo[SI_SKILLABILITY]>9950 && !random(30))) {
    user->ModifySkill(SK_CASTING, abil, 150, "druidenzirkel");
  }
  else if( !random(MAX_ABILITY * (MAX_ABILITY - abil + 1) / value) ) {
    user->ModifySkill(SK_CASTING, ++sinfo[SI_SKILLABILITY], 150, "druidenzirkel");
  }

  if (abil < MAX_ABILITY && 
      user->QuerySkill(SK_CASTING)[SI_SKILLABILITY] == MAX_ABILITY)
    user->Message("Anvar teilt Dir mit: Du kannst Zaubern nun absolut perfekt!\n",
        MSGFLAG_TELL);
  abil -= abil * cur_alk / max_alk;
  if(!random(2000)) {
    tell_object(user, "Irgendetwas scheint schiefzugehen ...\n");
    return random(abil)-MAX_ABILITY;
  }
  else 
    return random(abil);
}



