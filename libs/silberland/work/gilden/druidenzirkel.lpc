/*
//
// Ausgabe beim Levelaufstieg
//
*/
nosave string NeedMoreXP(object pl, int xp) {
 string str;
 int percent, x;
 str="";
 str="Obwohl Du wuerdig bist, musst Du noch mehr Erfahrung sammeln. "
     +"Von den Erfahrungspunkten, die Du benoetigst, fehlen Dir ";
 x=call_other(DRUIDENMASTER, "GetXpDifference", pl, 
              pl->QueryProp(P_XP));
 percent=100*x/xp;
 switch (percent)
  {
    case  0..10:  str+="nur mehr ganz wenige. ";     break;
    case 11..20:  str+="weniger als ein Viertel. ";  break;
    case 21..30:  str+="etwa ein Viertel. ";         break;
    case 31..40:  str+="weniger als die Haelfte. ";  break;
    case 41..50:  str+="etwa die Haelfte. ";         break;
    case 51..60:  str+="mehr als die Haelfte. ";     break;
    case 61..70:  str+="weniger als drei Viertel. "; break;
    case 71..80:  str+="etwa drei Viertel. ";        break;
    case 81..90:  str+="mehr als drei Viertel. ";    break;
    case 91..99 : str+="beinahe alle. ";             break;
    case 100    : str+="alle. ";                     break;
    default:      str+="viel mehr als gefordert. ";  break; 
  }
 //call_other(DRUIDENMASTER, "SetXp", pl, pl->QueryProp(P_XP)+xp);
 return str;
}


/*
//
// Loggen des Taskloesen
//
*/
void LogTask(object pl, int stufe)
{
  if(call_other(DRUIDENMASTER, "CheckTask", pl, stufe) &&
      stufe==15 && stufe==6) return;
  write_file(MEMBER_LOG(getuid(pl)+".log"),
             dtime(time())+": "+CAP(getuid(pl))+" hat Aufgabe "
             +stufe+" geloest.\n");
  return; 
}

mixed Test(object pl) {
  string txt;
  object ob;
  int lvl,n_lvl, *xp_per_level;
  txt="";
  xp_per_level=XP_PER_LEVEL;
  if(pl->QueryProp(P_FROG)) 
      return BS("Igitt! Ein Frosch! Hau bloss ab!");
  if(pl->QueryProp(P_GHOST)) 
       return BS("Ein Geist! Hau bloss ab, bevor wir "
	            +"Dich verbannen!");
  lvl=pl->QueryProp(P_GUILD_LEVEL);
  n_lvl=lvl+1;
  if(!call_other(DRUIDENMASTER, "CheckPreviousTasks", pl, lvl)) {
    write_file(DRUID_SUSPICIOUS_LOG, sprintf("%s: %s fehlt eine vorhergehende "
         "Aufgabe zu Gildenlevel %d\n", dtime(time()), CAP(getuid(pl)), 
        n_lvl)); 
    return sprintf("Du kannst nicht aufsteigen, %s! Du hast nicht "
         "alle vorhergehenden Aufgaben geloest! Das ist SEHR dubios. "
         "Bereite Dich darauf vor, Dich dafuer zu verantworten!\n", 
        pl->name(WER));
  }
  if(!call_other(DRUIDENMASTER, "CheckXp", pl, pl->QueryProp(P_XP))
      && !IS_WIZARD(pl) && !pl->QueryProp(P_TESTPLAYER))
  {
    txt+=NeedMoreXP(pl, xp_per_level[lvl]);
  }
  /*
  else 
    call_other(DRUIDENMASTER, "SetXp", pl, pl->QueryProp(P_XP)+
        XP_PER_LEVEL[n_lvl]);
        */
  if(lvl==7 && pl->QueryQuest("Cailleac'h's Harfe")) {
    call_other(DRUIDENMASTER, "SetTask", TP, 8);
  }
  if(lvl==3 && objectp(ob=present(TASKITEM, pl)) && 
      (ob->QueryProp(ELEMENT_SECURE))==4)
  { 
    call_other(DRUIDENMASTER, "SetTask", TP, 4);
    ob->remove();
  }
  if(!call_other(DRUIDENMASTER, "CheckTask", pl,n_lvl)) {
    switch(n_lvl) {
      case 2 : 
           txt+=BS("Gut, Schueler. Um hoehere Weihen zu erlangen, musst "
                  "Du eine Kreatur des Elementes Wasser holen. Es ist eine "
                  "Kreatur, die in den Weiten des SilberMeeres lebt, ein "
                  "Raubfisch, der nach seiner Farbe benannt ist, so wie vieles "
                  "hier.");
           break;
      case 3 :  
           txt+=BS("Nun gut, Schueler, um Aufzusteigen musst Du "
                  "erneut auf die Suche gehen. Es gibt ein magisches "
                  "Gewaechs, welches den Anwender befaehigt, unter Wasser "
                  "zu atmen. Diese Frucht existiert im Dschungel. Finde "
                  "sie und bringe ein Exemplar."); 
           break;
      case 4 :
           txt+=BS("Nun wird es an der Zeit, dass Du Deine Faehigkeiten "
                  "an einem verderbten Wesen ausprobierst: Toete einen "
                  "Seelendieb!");
           break;
      case 5 :
           txt+=BS("Gut, Schueler. Um hoehere Weihen zu erlangen, musst "
                  "Du ein Symbol des Elementes Luft holen, welches wir "
                  "dringend zur permaneten Bindung eines Luftelementars "
                  "in einen Teppich benoetigen: Eine Adlerfeder.");
           break;
      case 6 :
           txt+=BS("Um aufzusteigen, musst Du zeigen, was Du "
                  "bisher gelernt hast: Toete den Balrog, der das "
                  "Symbol des verderbten Feuers repraesentiert! Diese "
                  "Ausgeburt der Hoelle muss sich irgendwo im "
                  "Gebirge befinden!");
           break;
      case 7 :
           txt+=BS("In den Tiefen des Berges, so sagt man, ist eine "
                  "Waffe des Lichts verborgen. Suche und Finde sie!");
           break;
      case 8 :
           txt+=BS("Gut, Schueler. Nun gibt es eine weitere "
                  "Aufgabe: Finde die Harfe der Winde!");
           break;
      case 9 :
           txt+=BS("Hoere, Schueler! Wir benoetigen dringend "
                  "die Schuppe eines Drachen. Zeit ist fuer diese "
                  "Aufgabe ein wichtiges Kriterium, also eile Dich!"); 
           break;
      case 10 :  
           txt+=BS("Hoere nun, Schueler. Die Trolle haben einst ein maechtiges "
                  "Artefakt gestohlen. Es handelt sich dabei um das Szepter "
                  "der Macht. Suche es und bring es uns.");
           break;
      case 11 :  
           txt+=BS("Schueler! Wir benoetigen dringend einen Heiltrank. "
                  "Allerdings nicht irgendeinen, sondern einen speziellen. "
                  "Im Lager oestlich von Midas soll es angeblich exzellente "
                  "Traenke geben."); 
           break;
      case 12 :  
           txt+=BS("Es erwartet Dich eine der schwersten Pruefungen, "
                  "Schueler! In dem Dorf Knarkh leben etliche Bestien. "
                  "Eine davon ist die gefuerchtete gehoernte Bestie. Zum "
                  "Beweis der Beherrschung Deiner Zauber: Toete diese "
                  "Bestie!!"); 
           break;
      case 13 :  
           txt+=BS("In der Stadt Kyranda existiert eine Waffe, der "
                  "Schmiedehammer des Haegar, der in der Lage ist, "
                  "jegliches Metall problemlos zu schmieden. Wir "
                  "vermuten, dass dieser Hammer mit einem verschollenen "
                  "Zauber belegt ist. Bringe uns diesen Hammer. Es ist "
                  "auch noch von groesster Wichtigkeit, dass der Drache "
                  "von Dir persoenlich getoetet wird. Und nun geh!"); 
           break;
      case 14 :  
           txt+=BS("Eines unserer Mitglieder, Elsurion, hat uns verraten. "
                  "Dafuer gibt es nur eine Strafe, und Dir wurde die Ehre, "
                  "zuteil, diese Strafe auszufuehren."); 
           break;
      case 15 :
           txt+=BS("Du stehst nun kurz vor der Vollendung, "+CAP(getuid(TP))
                  +". Nur noch eine Aufgabe liegt vor Dir. Die Legende "
                  "erzaehlt von einem riesigen Golem aus Stein, Soordhin, "
                  "den Steinritter. Finde ihn und toete ihn, doch sei "
                  "auf der Hut. Viele haben ihn schon aufgesucht, "
                  "nur wenige sind zurueckgekehrt. Er traegt eine "
                  "maechtige Waffe mit sich, also sei auf der Hut. Du "
                  "findest ihn im Gebirge, in einer Stadt aus Stein.");
           break;
      default : break;
    }
  }
  //if(txt=="")  {
  //  return 0;
 // }
  return txt;
}

string Test1(object pl) {  
  object ob;
  int *xp_per_level;
  xp_per_level=XP_PER_LEVEL;
  if(pl->QueryProp(P_FROG)) 
      return BS("Igitt! Ein Frosch! Hau bloss ab!"); 
  if(pl->QueryProp(P_GHOST)) 
       return BS("Ein Geist! Hau bloss ab, bevor wir "
	           +"Dich verbannen!");
  ob=present(TASKITEM, pl);
  if(ob && (ob->QueryProp(ELEMENT_SECURE))==1) {
     call_other(DRUIDENMASTER, "SetTask", TP, 1);
     call_other(DRUIDENMASTER, "SetXp",TP, 
        TP->QueryProp(P_XP)+xp_per_level[0]);
     return 0;
  }
  return BS("Du willst also die Mysterien der "
             "Druiden erlernen. Nun, ich sehe, dass Du "
             "durchaus dazu geeignet bist. Bevor wir Dich "
             "jedoch in den Druidenzirkel aufnehmen, muesstest "
             "Du uns eine kleine Gefaelligkeit erweisen. "
             "Wir benoetigen dringend fuer ein Elixier eine "
             "Portion Wirselkraut. Bringe mir solch ein Kraut, "
             "und wir werden Dich in unsere Reihen "
             "aufnehmen.");
}

int GetLvl16Quest(object player) {
  object amulett, ob;
  string gem_name;

  if (!player || !interactive(player))  return 0;
  amulett=present("\ndruidenamulett", player);
  ob=clone_object(OBJ("task"));
  ob->SetProp(E_TIME, time());
  ob->move(player, M_NOCHECK);
  gem_name=({"rubin","smaragd","saphir","granat","amethyst","topas","aquamarin"})[random(7)];
  ob->SetProp(P_LEVEL_SIXTEEN_GEM, gem_name);
  player->Message(BSA(sprintf("Hoere, %s, ich benoetige "
      "%s faehig%s Druid%s, denn ich habe eine sehr wichtige "
      "Aufgabe, eine sehr wichtige, schwere und gefaehrliche "
      "Aufgabe. Solltest Du versagen, es also nicht innerhalb der "
      "vorgegebenen Zeit schaffen, werde ich es mir gut ueberlegen, "
      "Dir jemals erneut diese Aufgabe zu stellen. "
      "Zuerst musst Du Dich allerdings als wuerdig erweisen, und "
      "um mir das zu beweisen, musst Du mir "+player->QueryProp(P_LEVEL)+ " "+
      CAP(gem_name)+"e bringen. "
      "Du hast 12 Stunden dafuer Zeit. Sollte waehrenddessen ein "
      "Weltuntergang stattfinden oder Du mit 'Ende' aussteigen, hast "
      "Du ebenfalls versagt. Und nun geh!", player->Name(WER), 
      TP->QueryProp(P_GENDER)==FEMALE?"eine":"einen",
      TP->QueryProp(P_GENDER)==FEMALE?"e":"en",
      TP->QueryProp(P_GENDER)==FEMALE?"in":"en"),
       "Anvar teilt Dir mit: "), MSGFLAG_TELL);
  call_other(DRUIDENMASTER, "SetLvl16Quest", player, 2);
  tdm(sprintf("%s***%s %s hat Aufgabe 1 fuer GST 16 bekommen!\n", 
      ANSI_BLINK+ANSI_RED, ANSI_NORMAL, player->Name(WER)));
  write_file(LOG("lvl16quest"), sprintf("%s: %s erhaelt die erste Aufgabe! (50 "+
        CAP(gem_name)+"e\n", 
      dtime(time()), CAP(getuid(player))));
  return 1;
}

nosave int Lvl16Failed(object pl) {
  object ob;
  pl->Message(BSA("Du hast versagt! Die Zeit ist um! Vielleicht werde "
      "ich Dir irgendwann die Aufgabe nocheinmal stellen...", 
      "Anvar teilt Dir mit: "), MSGFLAG_TELL);
  tdm(sprintf("%s***%s %s hat bei Lvl16Quest versagt!\n", 
      ANSI_BLINK+ANSI_RED, ANSI_NORMAL, pl->Name(WER)));
  write_file(LOG("lvl16quest"), sprintf("%s: %s hat versagt! So ein Lulu :)\n", 
      dtime(time()), CAP(getuid(pl))));
  if(ob=present(TASKITEM, pl)) {
   ob->remove();
  }
  call_other(DRUIDENMASTER, "SetLvl16Quest", pl, 99);
  return 1;
}

int GiveSkills(string pl_name) {
  object pl;
  if(getuid(TP)!="angrox") return 0;
  pl=find_player(pl_name);
  if(!pl) return 0;
  pl->ModifySkill(FIGHT(WT_HANDS), 
      QuerySkill(FIGHT(WT_HANDS)),0,"druidenzirkel");
  pl->ModifySkill(SK_CASTING, QuerySkill(SK_CASTING),0, "druidenzirkel" );
  write("Done!\n");
  return 1;
}
