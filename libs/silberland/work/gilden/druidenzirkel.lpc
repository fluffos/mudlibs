create()
{
  ::create();
  SetProp( P_INT_SHORT, "Der Steinkreis des Druidenzirkels" ); 
  SetProp( P_INT_LONG, BS(
    "Du betrittst die kleine Lichtung und merkst sofort, dass Du Dich "
    "an einer Staette alter Macht befindest. Die Lichtung wird von "
    "sieben gigantischen Monolithen umringt, jeder viermal so gross wie "
    "Du selbst. Einer der Monolithen ist in der Mitte zersplittert, die "
    "Reste liegen auf dem Gras der Lichtung. Inmitten der Lichtung befindet "
    "sich ein Altar in Form eines Steinblockes, in den sieben Symbole in "
    "den Stein eingelassen sind. Zahlreiche Gestalten, bei denen es sich "
    "wohl um Druiden handelt, befinden sich auf der Lichtung, in "
    "verschiedene Handlungen vertieft. @@maghelp@@"));
  SetProp(P_NAME, "Anvar");
  SetProp(P_ARTICLE, 0);
  AddDetail(({"raum", "lichtung"}),
    "Die Lichtung strahlt eine gewisse Aura der Macht ab. In der Mitte "
    "der Lichtung steht ein Steinblock, der offenbar eine Art Altar "
    "darstellt. Um die Lichtung herum stehen 7 Monolithen, von denen der "
    "suedliche zerbrochen ist.");

  AddDetail( "handlungen", 
      "Leider kannst Du nicht genau erkennen, was die Druiden da machen.");
  
  AddDetail("art", 
    "Du wuerdest das schon als Altar bezeichnen.");
 
  AddDetail("boden",
    "Der Boden der Lichtung ist mit frischem, saftigem Gras bedeckt.");

  AddDetail("gras",
    "Das Gras sieht ungewoehnlich saftig aus.");

  AddDetail("himmel",
    "Der Himmel ist strahlend blau.");

  AddDetail("reste",
      "Die Reste des zerstoerten Monolithen liegen im Nordwesten.");
  
  AddDetail(({"monolithen", "monolith"}),
    "Die Monolithen stehen, von der Lichtung aus gesehen, im Nordosten, "
    "im Osten, im Suedosten, im Sueden, im Suedwesten, im Westen und im "
    "Nordwesten. Um die genauer zu sehen, muesstest Du schon hingehen.");

  AddDetail(({"nordosten", "osten", "suedosten", "suedwesten", "westen",
	      "nordwesten"}),
    "Da steht ein Monolith. Wenn Du naeher hingehst, koenntest Du ihn "
    "genauer sehen.");

  AddDetail("sueden",
    "Der Monolith, der im Sueden steht, ist in der Mitte zerbrochen. "
    "Wenn Du naeher hingehst, koenntest Du ihn genauer sehen.");

  AddDetail(({"altar", "steinblock"}),
    "Der Altar, oder besser gesagt der Steinblock, steht in der Mitte "
    "der Lichtung. Er ist kreisrund und etwa einen Schritt hoch. Auf "
    "der Oberseite sind sieben Symbole eingelassen. Eine seltsame Aura "
    "der Macht geht von dem Altar aus. Auf einer Seite ist eine "
    "Liste eingraviert, welche magisch leuchtet.");

  AddDetail(({"seite", "altarseite"}),
    "Auf einer Altarseite ist eine Liste eingraviert. "
    "Sie leuchtet magisch.");
  AddDetail("liste", "Du koenntest sie lesen.");
  AddReadDetail(({"liste", "topliste"}), "@@liste@@");
  AddDetail("form", 
    "Der Altar ist kreisrund.");

  AddDetail("mitte", 
    "In der Mitte der Lichtung befindet sich ein Altar.");

  AddDetail("aura",
    "Du kannst es nicht beschreiben ... aber Du fuehlst Dich wohl hier.");

  AddDetail("macht",
    "Die Macht dieser Staette ist beinahe koerperlich zu spueren.");

  AddDetail("symbole",
    "Die Symbole zeigen folgendes: Ein Dreieck, zwei "
    "uebereinanderliegende Wellenlinien, ein auf einer Kante stehendes "
    "Quadrat oder Rechteck, eine Spirale, zwei Kreise, wobei einer im "
    "anderen liegt, und 4 Linien, von denen je 2 parallel liegen und "
    "die anderen zwei kreuzen.");

  AddDetail("dreieck",
    "Das Dreieck stellt das Symbol fuer das Element \"Feuer\" dar.");

  AddDetail("wellenlinien",
    "Die Wellenlinien stehen fuer das Element \"Wasser\".");

  AddDetail("rechteck",
    "Das Rechteck ist das Symbol des Elementes \"Erz\".");

  AddDetail("spirale",
    "Die Spirale ist das Symbol des Elementes \"Luft\".");

  AddDetail(({"kreise", "kreis"}),
    "Die Kreise stellen das Symbol des Elementes \"Humus\" dar.");

  AddDetail("linien",
    "Die Linien (#) stellen das Symbol des Elementes \"Eis\" "
    "dar.");

  AddDetail("quadrat",
      "Das Quadrat steht fuer das Element \"Erz\".");
  
  AddDetail(({"oberseite", "oberflaeche"}),
    "Auf der steinernen Oberflaeche des Altars sind sieben Symbole "
    "eingelassen.");

  AddDetail("gestalten",
    "Die Druiden sind hier wohl zum Meditieren hergekommen.");

  AddDetail("druiden",
    "Es befinden sich etliche hier. Am Besten stoerst Du sie nicht!");

  AddDetail("meditieren",
    "Stoer sie besser nicht.\n");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE: 13]) );
