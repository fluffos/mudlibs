            TP->Name(WER), res), GUILDNPC_NAME+" kichert irr: "));
      return 1;
    }
  }
  return 0;
}

void reset_guild_npc()
{
  object gnpc;
  if(gnpc=present(GUILDNPC_ID)) 
  {
    gnpc->SetProp(P_NOATTACK,0);
    gnpc->SetProp(P_CHAT_CHANCE,1);
  }
}

nosave varargs int advance2(object pl) 
{
  mixed b;

  reset_guild_npc();
  if(!pl) pl=TP;
  TP->SetProp(P_PARALYZED, 0);
  gilden_room::advance(); // Eigentlicher Aufstieg der Gildenstufe
  TP->SetProp(P_GUILD_CIRCLE, 1);
  call_other(NMASTER, "AdvanceLevel", TP);
  if(TP->QueryProp(P_GUILD_LEVEL)>5) 
  {
    write_file(MEMBERLOG+getuid(TP)+".log", dtime(time())+": "+
               CAP(getuid(TP))+" hat " +"die hoechste Stufe erreicht.\n");
  /*  Channel(sprintf("HARHAR! Fuerchtet Euch, ihr Narren! Ein weiterer "
          "maechtiger Untoter wird euch nun heimsuchen und eure Alptraeume "
          "wahr werden lassen! Und Du, %s, VERNICHTE SIE ALLE !!!", 
          CAP(getuid(TP))));*/
    return 1;
  }
  write_file(MEMBERLOG+getuid(TP)+".log",
             dtime(time())+": "+CAP(getuid(TP))+" ist "
             +"eine Stufe (->"+TP->QueryProp(P_GUILD_LEVEL)+
              ") aufgestiegen.\n");
 /* Channel(sprintf("HARHAR! %s ist nun naeher an der Macht der Untoten. "
          "Ihr Narren zittert vor %s neuen Macht!",
          CAP(getuid(TP)),TP->QueryPossPronoun(FEMALE,WESSEN)));*/
  return 1;
}

int OwnLearnSpell(string str) 
{
  mapping sprueche;
  if(!present(GUILDNPC_ID, ME)) 
  {
    write(BS(GUILDNPC_LONGNAME+" ist nicht hier! VERSCHWINDE!!\n"));
    return 1;
  }
  str=TP->_unparsed_args();
  if(!IsGuildMember(TP)) 
  {
    tell_room(ME,BSA("DU WURM!!\n", GUILDNPC_NAME+" bruellt: "));
    return 1;
  }
  notify_fail("Welche hoellische Macht soll Dir gehorchen?\n");
  if(!str) 
  {
    tell_room(ME, BSA(sprintf("Du weisst nicht was Du willst? "
              "Wie willst Du unsere Feinde dann bekaempfen, %s?!",
              TP->Name(WER)), GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return LearnSpell(str);
}

nosave int GetAlign(object spieler) 
{
  mixed align;
  string msg;
  if(!intp(align=spieler->QueryProp(P_ALIGN))) {
    raise_error(sprintf("GetAlign, %s hat falschen Datentyp fuer "
      "Align: %O", spieler->Name(WER), align));
    spieler->SetProp(P_ALIGN, -1);
    tell_object(spieler, "[BUG:"+CAP(getuid(spieler))+"] Falscher Datentyp im "
        "Align!!! Bitte Magier verstaendigen!\n");
    return 0;
  }
  if(align<-1000) return -1000;
  else if(align>1000) return 1000;
  return align;
}

mapping Schwertkampf(object player, string skill, mapping sinfo) 
{ 
  int abil, ud, val, bonus, i;
  object o;
  string id, *id_list;

  ud=sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  val = (2* player->QueryAttribute(A_DEX) +  player->QueryAttribute(A_STR) +
         3*player->QueryProp(P_GUILD_LEVEL) + 2*player->QueryProp(P_GUILD_CIRCLE) 
        ) * abil / MAX_ABILITY;

  bonus=random(val);
  bonus=(bonus>MAX_SWORDBONUS && interactive(player)?MAX_SWORDBONUS:bonus);
  sinfo[SI_SKILLDAMAGE] += bonus * player->QuerySkillAttribute(SA_DAMAGE)/100;
  if( player->QueryProp(P_FROG) || 
      player->QueryProp(P_WEAPON)->QueryProp(P_WC) < abil/100 ) return sinfo;
  if( (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > abil/400 || !random(10) )
     && ++ud > abil/50 && abil<MAX_ABILITY) 
  {
    ud = 0;
    abil += random(player->QuerProp(P_GUILD_LEVEL) + 
            player->QueryAttribute(A_DEX)/3 - GetAlign(player)/166);
    if (abil+player->QuerSkillAbility(SK_TWOHANDED) >= MAX_ABILITY*2)
      player->Message(GUILDNPC_NAME+" teilt Dir mit: Du beherrscht den Kampf "
          "mit dem Zweihandschwert nun daemonisch!!!\n", MSGFLAG_TELL);
  }
  if(!random(500+MAX_ABILITY-abil) ) {
    tell_object(player, "Das Boese selbst fuehrt Deine Hand!\n");
    sinfo[SI_SKILLDAMAGE]+=400;
  }
  else if(!random(200+MAX_ABILITY-abil) && abil>2000 &&
          player->QuerySkillAttribute(SA_SPEED)<=100){
    tell_object(player, BS("Du nimmst Deine Waffe fest in die Hand und "
               "wagst einen Ausfall!"));
    tell_room(ENV(player), BS(player->Name(WER)+" beginnt einen Aufall."),
             ({player}));
    player->ModifySkillAttribute(TO, SA_SPEED, 200, 2+random(5));
  }
  else if(!random(300+MAX_ABILITY-abil) && abil>4000)
  {
    tell_object(player, BS("Du konzentrierst unheilige Kraft in Deinen "
                "Schlag und schlaegst Deinem Gegner eine unheilige Wunde!"));
    tell_room(ENV(player), BS(player->Name(WESSEN)+" Waffe glueht dunkel auf!"),
              ({player}));
    o = clone_object(OBJ "unheilige_wunde");
    o->move(sinfo[SI_ENEMY], M_NOCHECK);
    o->initial(player->QueryProp(P_GUILD_LEVEL),
             player->QuerySkillAbility(SK_SWORDFIGHTING)/1000);
  }
  else if(!random(400+MAX_ABILITY-abil) && abil > 8000 && 
          objectp(o=sinfo[SI_ENEMY]->QueryProp(P_WEAPON)))
  {
    tell_object(player, BS("Dir gelingt es Deinen Gegner durch ein geschicktes "
                "Manoever zu entwaffnen!"));
    tell_room(ENV(player), BS(player->Name(WER)+" entfwaffnet "+
              sinfo[SI_ENEMY]->Name(WEN)+"."), ({player}));
    o->DoUnwield(1);

    for(i=0; i<sizeof(o->QueryProp(P_IDS)); ++i)
    {
      id=o->QueryProp(P_IDS)[i];
      if(id[0..0]!="\n" && id[0..0]>="a" && id[0..0]<="z")
        break;
    }

    if(!objectp(sinfo[SI_ENEMY]->QueryProp(P_WEAPON)))
    {
      o = clone_object(OBJ "entwaffnen");
      o->move(sinfo[SI_ENEMY], M_NOCHECK);
      o->wield_weapon_in(player->QuerySkillAbility(SK_SWORDFIGHTING)/1000, id);
    }
    else
      tell_object(player, BS("Dein Gegner haelt die Waffe mit "
                 "eisernem Griff!"));
  }

  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  player->ModifySkill( SK_SWORDFIGHTING, ([ SI_USR: ud, SI_SKILLABILITY: abil ]),
                       sinfo[SI_DIFFICULTY], "todesritter");
  return sinfo;
}

mapping Zweihandkampf(object player, string skill, mapping sinfo) 
{ 
  int abil, ud, val, bonus, i;
  object *o;

  ud=sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  val = (2* player->QueryAttribute(A_DEX) +  player->QueryAttribute(A_STR) +
         3*player->QueryProp(P_GUILD_LEVEL) + 2*player->QueryProp(P_GUILD_CIRCLE) 
        ) * abil / MAX_ABILITY;

  bonus=random(val);
  bonus=(bonus>MAX_TWOHANDBONUS && interactive(player)?MAX_TWOHANDBONUS:bonus);
  sinfo[SI_SKILLDAMAGE] += bonus * player->QuerySkillAttribute(SA_DAMAGE)/100;
  if( player->QueryProp(P_FROG) || 
      player->QueryProp(P_WEAPON)->QueryProp(P_WC) < abil/100 ) return sinfo;
  if( (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > abil/400 || !random(10) )
     && ++ud > abil/50 && abil<MAX_ABILITY) 
  {
    ud = 0;
    abil += random(player->QuerProp(P_GUILD_LEVEL) + 
            player->QueryAttribute(A_DEX)/3 - GetAlign(player)/166);
    if (abil+player->QuerSkillAbility(SK_SWORDFIGHTING) >= MAX_ABILITY*2)
      player->Message(GUILDNPC_NAME+" teilt Dir mit: Du beherrscht den Kampf "
          "mit dem Zweihandschwert nun daemonisch!!!\n", MSGFLAG_TELL);;
  }
  if(!random(500+MAX_ABILITY-abil) ) {
    tell_object(player, "Das Boese verstaerkt den Schwung Deiner Waffe!\n");
    sinfo[SI_SKILLDAMAGE]+=400;
  }
  else if(!random(200+MAX_ABILITY-abil) && abil>2000){
    o = player->QueryEnemies()[0];
    if(sizeof(o))
    {
      tell_object(player, BS("Du schwingst Deine Waffe wie eine Windmuehle!"));
      tell_room(ENV(player), BS(player->Name(WER)+" laesst "+
                player->QueryPossPronoun()+"e Waffe ueber dem Kopf kreisen."),
                ({player}));
      for(i=0; i<sizeof(o); ++i)
      {
        tell_room(ENV(player), BS(o[i]->Name(WER)+" wird getroffen!"));
        o[i]->Defend(sinfo[SI_SKILLDAMAGE], sinfo[SI_SKILLDAMAGE_TYPE], sinfo, player);
      }
    }
  }
  else if(!random(300+MAX_ABILITY-abil) && abil>4000)
  {
    if(sinfo[SI_ENEMY]->QueryProp(P_WEIGHT) < player->QueryProp(P_WEIGHT)*2)
    {
      tell_object(player, BS("Dein Hieb schmettert Deinen Gegner zu Boden."));
      tell_room(ENV(player),  BS(player->Name(WESSEN)+" Hieb schmettert "+
                player->QueryPossPronoun()+"en Gegner zu Biden:"),
                ({player}));
      sinfo[SI_ENEMY]->SetProp(P_DISABLE_ATTACK, 2+random(5));
    }
  }
  else if(!random(400+MAX_ABILITY-abil) && abil>8000)
  {
    tell_object(player, BS("Eine unheilige Macht regeneriert Dich durch "
                "diesen Hieb."));
    player->AddHp(sinfo[SI_SKILLDAMAGE]/10);
    player->AddSp(sinfo[SI_SKILLDAMAGE]/10);
  }

  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  player->ModifySkill( SK_TWOHANDED, ([ SI_USR: ud, SI_SKILLABILITY: abil ]),
                       sinfo[SI_DIFFICULTY], "todesritter");
  return sinfo;
}

//
//
// Auswertung der Aufstiegsbedingungen
//
//
string Lcond(object pl) 
{
  string str;
  mixed var;
  str="";
  if(!IsGuildMember(pl)) return "Verschwinde!";
  if(pl->QueryProp(P_FROG))
     return BSA("Muahahahar! Du IDIOT! Als Frosch wagst Du Dich hier her!"
          "VERSCHWINDE BEVOR ICH DICH VERNICHTE!", 
          GUILDNPC_NAME+" kreischt: ");
  if(stringp(var=check_lvl_cond(pl, 0))) // XP
      str+=var;
  if(stringp(var=check_lvl_cond(pl, 1))) // LXP
      str+=var;
  if(stringp(var=check_lvl_cond(pl, 2))) // Bloodopfer
      str+=var;
  if(str=="") return 0; // Ok, wir duerfen aufsteigen
  return str; // Och, leider nicht :(
}

/* Eintrittsueberpruefung */
string pal_dk_initial_check(object pl)
{
  string str;
