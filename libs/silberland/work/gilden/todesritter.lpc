// Auswertung des Mappings und Ausgabe was denn wo fehlt
nosave string check_lvl_cond(object pl, int flag) 
{
  string str;
  int percent, x,lvl, value;
  mixed cond;
  cond=({XP_PER_LEVEL,LXP_PER_LEVEL,BLOOD_PER_LEVEL, KILLS_PER_INNERCIRCLE});
  str="";
  x=0;
  lvl=pl->QueryProp(P_GUILD_LEVEL);
  switch(flag) {
    case 0: 
       if(x=call_other(DKMASTER, "QueryXpDifference", pl)) 
         str="Ahhh, ich sehe von der geforderten Erfahrung fehlt Dir ";
       break;
    case 1:
       if(x=call_other(DKMASTER, "QueryLXpDifference", pl)) 
         str="Harhar! Todeserfahrungen! Davon fehlen Dir ";
       break;
    case 2:
       if(x=call_other(DKMASTER, "QueryNeededBlood", pl)) //Bluuuuuuuut ;)
         str="Und eines noch! Vergiss nicht das Wichtigste: Seelen! Du "
             "musst mehr Seelen opfern! Es fehlen Dir ";
       break;
    case 3:
       lvl=pl->QueryProp(P_GUILD_CIRCLE);
       if(x=call_other(DKMASTER, "QueryToSacrify", pl))
         str="Ich sehe, Du musst noch toeten! Toeten! TOETEN! Geh hinaus "
           "und toete! Um aufsteigen zu koennen musst Du mehr "
           "Lebewesen toeten, es fehlen Dir ";
  }
  if(x<=1) return 0; // Alles erfuellt?
  return str+integer2percent(100*x/cond[flag][lvl-1]);
}

// integer -> percent-string 
nosave string integer2percent(int percent) 
{
  string str;
  str="";
  switch (percent) {
    case 0..10:  str+="fast gar keine mehr.";
                 break;
    case 11..20: str+="weniger als ein Viertel.";
                 break;
    case 21..30: str+="etwa ein Viertel.";
                 break;
    case 31..40: str+="weniger als die Haelfte.";
                 break;
    case 41..60: str+="in etwa die Haelfte.";
                 break;
    case 61..70: str+="mehr als die Haelfte.";
                 break;
    case 71..80: str+="etwa drei Viertel.";
                 break;
    case 81..90: str+="mehr als drei Viertel.";
                 break;
    case 91..99: str+="beinahe alle.";
                  break;
    case 100   : str+="alle.";
                  break;
    case 101..150: str+="mehr als gewoehnlich. Harhar! Betrachte das "
                    "als Strafe fuer Dein staendiges Versagen!";
                   break;
    case 151..199: str+="viel mehr als gewoehnlich. Harhar! Betrachte das "
                    "als Strafe fuer Dein staendiges Versagen!";
                   break;
    case 200..299: str+="doppelt soviel als gewoehnlich. Harhar! Betrachte das "
                    "als Strafe fuer Dein staendiges Versagen!";
                   break;
    case 300..399: str+="dreimal soviel als gewoehnlich. Harhar! Betrachte das "
                    "als Strafe fuer Dein staendiges Versagen!";
                   break;
    case 400..499: str+="viermal soviel als gewoehnlich. Harhar! Betrachte das "
                    "als Strafe fuer Dein staendiges Versagen!";
                   break;
    case 500..599: str+="fuenfmal soviel als gewoehnlich. Harhar! Betrachte das "
                    "als Strafe fuer Dein staendiges Versagen!";
                   break;
    default: str+="mehr als fuenfmal soviel als gewoehnlich. Harhar! "
             "Betrachte das als Strafe fuer Dein ewiges Versagen!";
                   break;
                   
  }
  return str+" ";
}

int Nightvision(object me, string sname, mixed sinfo) 
{
  int abil,light,llt,dt,res;

  if (!sinfo || !environment(me) || !interactive(me)) 
    return 0;
  if (intp(sinfo)) 
    sinfo=([SI_SKILLABILITY:sinfo]);
  if (!mappingp(sinfo)) 
    return 0;
  if ((light = environment(me)->QueryProp(P_TOTAL_LIGHT)) > 0) {
    me->ModifySkill(sname,([SI_LASTLIGHT:time()]));
    return light;
  }
  abil=sinfo[SI_SKILLABILITY];
  if (!(llt=sinfo[SI_LASTLIGHT])) {
    me->ModifySkill(sname,([SI_LASTLIGHT:time()]));
    dt=0;
  } else {
    dt=time()-llt;
    if (dt<0) dt=0;
    if (dt>86400) dt=86400;
  }

  res=(abil*dt)/(2*MAX_ABILITY)+light;
  if (res<=0) {
    res--; // Wert muss !=0 sein
    if (res<-MAX_ABILITY) res=-MAX_ABILITY;
  } else {
    if (res>MAX_ABILITY) res=MAX_ABILITY;
  }
  return res;
}


string get_skill_name(string in)
{
  switch(in)
  {
    case "auge des khaza-dhunaar": return "Auge des Khaza-dhunaar";
    case "pforte ins totenreich": return "Pforte ins Totenreich";
    case "strahlen der dunkelheit": return "Strahlen der Dunkelheit";
    case "beruehrung von zum-uul": return "Beruehrung von Zum-uul";
    case "anrufung des kharr-zzteth": return "Anrufung des Kharr-zzteth";
    case "unterwerfung der toten": return "Unterwerfung der Toten";
    case "kochendes blut": return "Kochendes Blut";
    case "dunkler pakt": return "Dunkler Pakt";
    case "schleier des val-tkro-tthar": return "Schleier des Val-tkro-tthar";
    case "hauch der verwesung": return "Hauch der Verwesung";
    case "fluch der klinge": return "Fluch der Klinge";
    case "biss des vampirs": return "Biss des Vampirs";
    case "ruf der ghoule": return "Ruf der Ghoule";
    case "geifer der verdammten": return "Geifer der Verdammten";
    case "schrecken der finsternis": return "Schrecken der Finsternis";
    case "empathie der schatten": return "Empathie der Schatten";
    case "gekreische der todesfee": return "Gekreische der Todesfee";
    case "mysterium von yok-njarg-zirm": return "Mysterium von Yok-njarg-zirm";
    case "blutpakt der verdammten": return "Blutpakt der Verdammten";
    case "fluch der mumie": return "Fluch der Mumie";
    default: return CAP(in); break;
  }
}

//
// Auswertung der Faehigkeiten
//
string skill_string(object pl) {
  int i, wert;
  string txt, s;
  string *arm;
  mapping res,sp;
  res=pl->QueryProp(P_NEWSKILLS);
  arm = sort_array(m_indices(res), #'<);
  sp=call_other(DKMASTER, "QuerySkillPoints",pl);
  if(!mappingp(sp)) sp=([]);
  txt=sprintf("%-36s %-29s %s\n","Zauber/Faehigkeit","Guete","Skillpunkte");
  txt+=sprintf("%'-'-78s\n","");
  for (i = sizeof(arm)-1;i>=0;i--) 
  {
    if(arm[i]!=SK_SWORDFIGHTING && arm[i]!=SK_TWOHANDED && arm[i]!="Nightvision") 
    {
      if (sp[arm[i]])
        s=sprintf("%2d",sp[arm[i]]);
      else
      { //is faehig?
        if (member_array(arm[i],skillpointable)<0)
          s=" -";
        else
          s=" 0";
      }
     txt+=sprintf("%-36s %-37s %-2s\n",get_skill_name(arm[i]),
         int2string(TP->QuerySkillAbility(arm[i])),s);
    }
  }
  txt+=sprintf("%-36s %-37s %-2s\n","Kampf mit Zweihandschwertern",
      int2string((TP->QuerySkillAbility(SK_SWORDFIGHTING)+
		  TP->QuerySkillAbility(SK_TWOHANDED))/2)," -");

  if(TP->QueryProp(P_GUILD_LEVEL)>2)
    txt+=sprintf("%-36s %-37s %-2s\n","Dunkelsicht",
         int2string(TP->QuerySkillAbility("Nightvision"))," -");
  if((wert=TP->QueryProp(P_GUILD_RATING))<1501) wert=1501;
  s=int2string(wert);
  txt+="\n"+BS("In der Summe gesehen bist Du "+s+".");
  return txt;
}

// Ausgabe der Fertigkeiten
// ersteinmal nur eine kopie der pali's
int faehigkeiten(string str) 
{
  int i, wert;
  string *arm, s;
  mapping res,sp;

  if(!present(GUILDNPC_ID, ME)) 
  {
    write("Ohne "+GUILDNPC_NAME+" laeuft hier gar nichts!\n");
    return 1;
  }
  if(!IsGuildMember(TP)) 
  {
    tell_room(ME, BSA(sprintf("Du dienst nicht dem Boesen, %s! "
             +"Du wirst hier Deine kuemmerlichen Fertigkeiten nicht erfahren!",
             TP->Name(WER)), GUILDNPC_NAME+" spricht energisch: "));
    return 1;
  }
  write(BS("Du opferst etwas Blut am Altar und erkennst folgendes:")+"\n");
  write(skill_string(TP));
  say(sprintf("%s opfert Blut am Knochenalter.\n",
              TP->Name(WER)));
  return 1;
}

