              "zuerst in einen hoeheren Kreis der Verdammnis aufsteigen, "
                +CAP(getuid(TP))+".\n", GUILDNPC_NAME +" sagt: "));
      }
      return 1;
    }
    /* Restrictions pruefen */
    cond=QueryProp(P_GUILD_CIRCLE_LEVELS)[glvl];
    res=call_other(RES_CHECKER, "check_new_restrictions", TP, cond[ggrad+1]);
    if(!stringp(res)) {
      TP->SetProp(P_GUILD_CIRCLE, ggrad+1);

      if(glvl>2)
      {
        if(!TP->QuerySkill(SK_NIGHTVISION))
            TP->ModifySkill(SK_NIGHTVISION, 375,100,"todesritter");
        abil=TP->QuerySkill( SK_NIGHTVISION)[SI_SKILLABILITY]+375;
        TP->ModifySkill( SK_NIGHTVISION, ([ SI_SKILLABILITY: 
            (abil>MAX_ABILITY?MAX_ABILITY:abil) ]), 1,"todesritter" );
      }

      call_other(DKMASTER, "AdvanceInnerCircle", TP);

      /* In der Testphase deaktiviert
      xarfai->command_me("nkreische "+sprintf("Har! %s hat soeben den "
            "%d. inneren Grad des %d. Kreises der Verdammnis erreicht!",
            TP->Name(WER), ggrad+1,glvl));*/

      write(BS(
        "Du bist soeben in den "+(ggrad+1)+". Grad des "+glvl+". Kreises "
        "der Verdammnis aufgestiegen."));
      say(BS(
        TP->Name()+" hat soeben den "+(ggrad+1)+". Grad des "+glvl+". Kreises "
        "der Verdammnis erreicht."));
    write_file(MEMBERLOG+getuid(TP)+".log", dtime(time())+": "+
        CAP(getuid(TP))+" hat den " + (ggrad+1) + " Kreis erreicht.\n");
      return 1;
    }
    else {
