  str = "";

  // Nur Paladine duerfen!
  if(pl->QueryProp(P_GUILD) != "paladine" && 
     !pl->QueryProp("dk_tmp_default_guild")) 
    str+="Nur Paladine koennen uns beitreten, Du Nichtsnutz! ";
  else if(pl->QueryProp(P_GUILD_LEVEL) < 13)
    str+="Du bist ein Paladin? Noch nicht ein Mal vor dem Guten hast "+
         "Du Dich bewiesen! PAH! WURM!";

  // Fehlt: Abfrage auf Wiedererweckung, gesammeltes Align
  //        und erledigte Einstiegsquest

  if(str=="") return 0; //OK
  else return  str;
}

string LCond2(object pl) 
{
  string str;
