      say(BSA("Du kannst nicht mehr weiter aufsteigen, "
              +CAP(getuid(TP))+".\n", GUILDNPC_NAME +" sagt: "));
      return 1;
    }
    if (glvl>6)
    {
        write(BSA("Du kannst nicht mehr weiter aufsteigen! "
              "Dein Gildenlevel ist zu hoch. Rufe einen Magier!"
                  ,GUILDNPC_NAME" sagt: "));       
        say(BSA("Du kannst nicht mehr weiter aufsteigen! Dein Gildenlevel "
              "ist zu hoch. Rufe einen Magier!"
                +CAP(getuid(TP))+".",GUILDNPC_NAME" sagt: ")); 
      return 1;
    }
    if(ggrad!=7) {
      write(BSA("VERSAGER! Du musst zuerst den 7. Grad des "+glvl+". Kreises "
            "der Verdammnis erreicht haben!\n", GUILDNPC_NAME+" sagt: "));
      say(BSA("VERSAGER! Du musst zuerst den 7. Grad des "+glvl+". Kreises der "
            "Verdammnis erreicht haben, "
              +CAP(getuid(TP))+".\n", GUILDNPC_NAME +" bruellt: "));
      return 1;
    }
   /* if(glvl==6 && present("TEUFEL_SEELE")) { -- Es gibt keine 7. Stufe
      tell_room(ME, BSA(sprintf("%s! Wie ich sehe hast Du Deine Seele "
              "bereits jemanden geopfert. HAHAHAHA! Du kannst nicht weiter "
              "aufsteigen - nicht ohne dem Opfer Deiner Seele! HAHAHAHA!", 
              TP->Name(WER)), GUILDNPC_NAME+" kichert: "));
      return 1;
    }
    if(glvl == 6 && !TP->QueryProp("nekro_lvl_7_inform")) {
      tell_room(ME, BSA("SO! DU WILLST ALSO AUFSTEIGEN! Nun denn, " 
              "hoer genau zu ...", GUILDNPC_NAME+" schnaubt: "));
      tell_room(ME, BSA(sprintf("%s! Wenn Du in den siebten Kreis der "
              "Verdammnis gelangen willst, musst Du ein Opfer bringen. "
              "Du musst Deine Seele eintauschen gegen die Macht der "
              "Finsternis, fuer die Kraft die in Dir die Unsterblich"
              "keit der Untoten erwecken wird. Wenn Du also alle " 
              "Anforderungen erfuellst und das naechste Mal "
              "einen weiteren Kreis aufsteigen willst,  so bedeutet dies, das "
              "Du bereit bist Deine Seele zu opfern. Das bedeutet auch, das "
              "Du uns, die Nekromanten, NIE mehr verlassen kannst! "
              "Du wirst dann fuer immer einer der maechtigen Untoten sein! "
              "Wenn Du dies nicht moechtest und somit der absoluten Macht "
              "entsagst, so halte Dich von dem naechsten Kreis der "
              "Verdammnis fern! Ein unsichtbares Mal zeichnet Dich nun, "
              "das Du diese Warnung erhalten hast. VERGISS DAS NICHT!", 
              TP->Name(WER)), GUILDNPC_NAME+" fluestert: "));
      TP->SetProp(P_NEKRO_LVL_7_INFORM, time());
      TP->Set(P_NEKRO_LVL_7_INFORM, SAVE, F_MODE);
      return 1;
    }*/
    cond=QueryProp(P_GUILD_LEVELS);
    res=call_other(RES_CHECKER, "check_new_restrictions", TP, cond[glvl+1]);
    if(!stringp(res)) {
     /* TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:200, PARALYZE_MSG:"", 
            PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));*/
      while(remove_call_out("reset_guild_npc") != -1) ;
      call_out("reset_guild_npc", 200);
      xarfai->SetProp(P_NOATTACK,"ist zu vertieft in die Zeremonie.");
      xarfai->SetProp(P_CHAT_CHANCE,0);
      /* Das muss nach advance2()
      gilden_room::advance(); // Eigentlicher Aufstieg der Gildenstufe
      */
      if(glvl>1) // Dunkelsicht gibts erst ab Stufe 3
      {
        if(!TP->QuerySkill(SK_NIGHTVISION))
            TP->ModifySkill(SK_NIGHTVISION, 375,100,"todesritter");
        abil=TP->QuerySkill( SK_NIGHTVISION)[SI_SKILLABILITY]+375;
        TP->ModifySkill( SK_NIGHTVISION, ([ SI_SKILLABILITY: 
            (abil>MAX_ABILITY?MAX_ABILITY:abil) ]), 1,"todesritter" );
      }
       LoadSequenz(SEQ+"aufstieg.seq", TP, #'advance2);
      return 1;
    }
    else {
      if(res!="")
        tell_room(ME, BSA(sprintf("Du kannst noch nicht aufsteigen, %s! %s", 
            TP->Name(WER), res), GUILDNPC_NAME+" sagt: "));
      return 1;
    }
  }
  // AB HIER DER INNERE GRAD
  if(member(({"kreisstufe", "grad", "innerer grad", "inneren grad"}), str)!=-1)
  {
    if(!IsGuildMember(TP)) {
      tell_room(ME, BSA(sprintf("Du kannst hier nicht erhoehen, Du "
                +"bist keiner von uns, %s!\n", TP->Name(WER)), GUILDNPC_NAME
                +" sagt: "));
      return 1;
    }
    
    if (glvl>6)
    {
        write(BSA("Du kannst nicht mehr weiter aufsteigen! Dein Gildenlevel ist zu hoch. Rufe einen Magier!\n"
                  ,GUILDNPC_NAME" sagt: "));       
        say(BSA("Du kannst nicht mehr weiter aufsteigen! Dein Gildenlevel ist zu hoch. Rufe einen Magier!\n"
                +CAP(getuid(TP))+".\n",GUILDNPC_NAME" sagt: ")); 
      return 1;
    }
    if(ggrad>=7) {
