int blut_opfer(string str)
{
  notify_fail("Was willst Du opfern?\n");
  if(!str || str=="") return 0;
  if(!(str == "blut" ||
       str == "blut mit schwert" ||
       str == "seele")) return 0;
  
  if(str == "blut" || str == "blut mit schwert")
  {
    if(TP->QueryProp(P_GUILD)=="todesritter")
    {
      write(BS("Du opferst etwas Blut am Altar."));
      say(BS(TPN+" opfer Blut."));
      TP->AddHp(-5);
      return 1;
    }
    notify_fail("Du zitterst vor Angst und laesst es lieber.\n");
    if(TP->QueryProp(P_GUILD)!="paladine") return 0;

    notify_fail("Du benoetigst eine gesegnete Waffe!\n");
    if(!present("\nwaffensegen", TP)) return 0;
   // Sequenz fuer die Einstiegsquest
    TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:200, PARALYZE_MSG:"", 
           PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
    LoadSequenz(SEQ+"blutopfer.seq", TP, #'give_start_quest);
    return 1;
  }
  else if(str == "seele")
  {
    notify_fail("Du bist schon ein Todesritter!\n");
    if(TP->QueryProp(P_GUILD)=="todesritter") return 0;

    //Ueberpruefung auf Erledigte Quest

    Anathema();
    return 1;
  }
  
  return 0;
}

void give_start_quest()
{
  TP->AddHp(-50);
  write(TPN+": give_start_quest()\n");
}

int testbeitritt(string str)
{
  int b;
  if(!TP->QueryProp(P_TESTPLAYER)) return 0;
  if(b=::beitreten()<0) return 1;
  TP->ModifySkill(SK_SWORDFIGHTING, QuerySkill(SK_SWORDFIGHTING),100,
      "todesritter");
  TP->ModifySkill(SK_TWOHANDED, QuerySkill(SK_TWOHANDED),100,
      "todesritter");
  TP->SetProp(P_GUILD_CIRCLE, 1);
  TP->SetProp(P_GUILD_LEVEL, 1);
  write(BS("Beitritt erfolgreich!"));
  return 1;
}

nosave int magfunc(mixed str) {
  mixed *txt;
  object ob;
  int err, task;
  string name;
  if(!IS_LORD(TP)) return 0;
  if(!str) str="hilfe";
  if(str=="hilfe") {
    write("Folgende Befehle sind moeglich:\n"
          " gilde hilfe                  : Dieses hier\n"
          " gilde toplist                : Updaten der Topliste\n");
    if (IS_ARCH(TP) || member(MASTER_MAGES, getuid(TP)) != -1 ) {
      write(
            " gilde zaubern (ein|aus)      : Zaubern (de-)aktivieren\n"
            " gilde backup                 : Backup des Memberfiles\n"
            " gilde restore                : Zurueckspielen des Backups\n"
            " gilde status <name>          : Ausgeben des Status' eines Spielers\n"
            " gilde memberdel <name>       : Spieler aus Gilde loeschen\n");
    }
    return 1;
  }
  txt=explode(str, " ");
  if(member(({"backup", "restore", "memberdel", "zaubern", "status"}), 
      txt[0])!=-1) 
  {
    if (!IS_ARCH(TP) && member(MASTER_MAGES, getuid(TP)) == -1 ) {
      write_secure_log(sprintf("Versuchte Aenderung im Gildenmaster (%s) "
		      +"von %s\n", str, CAP(getuid(TP))));
      write("Befehl nicht ausfuehrbar! Grund: Magierlevel < 60\n");
      tell_angrox(sprintf("%s***%s Versuchte Aenderung im Gildenmaster von "
          "%s!\n", ANSI_BLINK+ANSI_RED, ANSI_NORMAL, CAP(getuid(TP))));
      return 1;
    }
    else {
      if(txt[0] != "status");
        //write_nekro_log("changes", sprintf("Aenderung im Gildenmaster"
        //    +"(%s): gilde %s\n", CAP(getuid(TP)), str));
    }
  }

  if (txt[0] == "status") {
    if (sizeof(txt)<2)
    {
      tell_object(TP, "Syntax: gilde status <name>\n");
      return 1;
    }
    call_other(DKMASTER, "PrintMemberEntry", txt[1]);
    return 1;
  }
  // Hier wird zaubern ein- oder ausgeschaltet (Iwo)
  if (txt[0] == "zaubern")
    {
      if (sizeof(txt)<2)
        {
          tell_object(TP, "Syntax: gilde zaubern (ein|aus)\n");
          return 1;
        }

      if (txt[1] == "ein")
        {
          tell_object(TP, "Zaubern ist nun EINgeschaltet!\n");
          cast_disabled = 0;
        }
      else if (txt[1] == "aus")
        {
          tell_object(TP, "Zaubern ist nun AUSgeschaltet!\n");
          cast_disabled = 1;
        }
      else
        tell_object(TP, "Stoned, eh?\n");
         
      return 1;

    }

  if(txt[0]=="memberdel") {
    if(sizeof(txt)<2) {
      tell_object(TP, "Syntax: gilde memberdel <name> \n");
      return 1;
    }
    name=lower_case(to_string(txt[1]));
    err=call_other(DKMASTER, "DeleteMember", name);
    if(err!=1)
      tell_object(TP, sprintf("DeleteMember: Fehler. Code %d\n", err));
    else 
      tell_object(TP, "DKMASTER: DeleteMember ok!\n");
    err=call_other(DKMASTER, "DeleteTopEntry", name);
    if(err!=1) 
      tell_object(TP, sprintf("DeleteTopEntry: Fehler. Code %d\n", err));
    else 
      tell_object(TP, "DKMASTER: DeleteTopEntry ok!\n");

    tell_object(TP, "Spieler aus Gilde geloescht!\n");
    return 1;

  }
  if(txt[0]=="backup") {
    call_other(DKMASTER, "DoBackup"); 
    tell_object(TP, 
        "Kopiere members/members.o nach backup/members_backup.o\n");
    return 1;
  }
  if(txt[0]=="restore") {
    if(call_other(DKMASTER, "DoRestore")==-2) {
      tell_object(TP, 
        "Fehler! Members.o konnte nicht restored werden!\n");
      return 1;
    } 
    tell_object(TP, 
      "Kopiere backup/members_backup.o nach members/members.o\n");
    return 1;
  }
  if(txt[0]=="toplist") {
    call_out("complete_toplist_update",0);
    tell_object(TP, "Memberliste ist ist in 15 - 30 Sekunden fertig!\n");
    return 1;
  }
  tell_object(TP, "Diesen Befehl gibt es nicht!\n");
  return 1;
}


string check_gender(string _male, string _female) {
  if(TP->QueryProp(P_GENDER)==FEMALE)
    return _female;
  return _male;
}

/*
//
// Austritt aus der Nekromantengilde
//
*/
int LeaveCeremony(string str) 
{
  object gnpc; 
  if(!gnpc=present(GUILDNPC_ID, ME)) 
  {
    write("Ohne "+GUILDNPC_LONGNAME+" laeuft hier gar nichts!\n");
    return 1;
  }
  if(!IsGuildMember(TP)) 
  {
    write("Du bist kein Todesritter, Unwuerdiger!\n");
    return 1;
  } 
  while(remove_call_out("reset_guild_npc") != -1) ;
  call_out("reset_guild_npc", 200);
  gnpc->SetProp(P_NOATTACK,"laesst sich nun nicht beirren.");
  gnpc->SetProp(P_CHAT_CHANCE,0);
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:200, PARALYZE_MSG:"", 
           PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  LoadSequenz(SEQ+"austritt.seq", TP, #'austreten);

  return 1;
}

int austreten() 
{
  object ob,gnpc;
  if(TP->QueryProp(P_GUILD)!="todesritter")
    return 0;

  if(!gnpc=present(GUILDNPC_ID, ME)) 
  {
    write("Ohne "+GUILDNPC_LONGNAME+" laeuft hier gar nichts!\n");
    return 1;
  }
  reset_guild_npc();
  WLOG("/log/gilden/todesritter", "tritt aus der Gilde aus. ('austreten' in gilden/todesritter.c)");
  if(ob=present(GUILD_ITEM_ID,TP)) 
  {
	  ob->SetProp(P_CURSED, 0);
	  ob->remove();
  }
  call_other(NMASTER, "DeleteMember", TP);
  call_other(NMASTER, "DeleteTopEntry", getuid(TP));
  /*Channel(sprintf("%s hat gerade Verrat begangen und uns verlassen! "
      "TOETET %s UND BRINGT MIR %s HERZ! Dann werden wir %sen "
      "Geist in eine Leiche bannen, und %s wird uns auf immer als "
      "verrottender Zombie dienen!!!", TP->Name(WER),
      check_gender("IHN", "SIE"), check_gender("SEIN", "IHR"),
      check_gender("sein","ihr"),check_gender("er","sie")));*/
  // Nekromanten sollen attack auf spieler sein :P
  write_file(MEMBERLOG+getuid(TP)+".log",
             dtime(time())+": "+CAP(getuid(TP))+" ist "
			 +"aus der Gilde ausgetreten.\n");
  TP->SetProp(P_NEKRO_SKILLS_MOD, 0);
  TP->SetProp(P_NEKRO_TASK_POINTS, 0);
  TP->SetProp(P_TMP_DEATHKNIGHT_LISTENER, 0);
  TP->SetProp(P_PARALYZED, 0);
  TP->SetProp(P_GUILD_LEVEL, 0);
  TP->SetProp(P_GUILD_CIRCLE, 0);
  TP->Set(P_GUILD_CIRCLE,SAVE,F_MODE);
//  gnpc->Kill(TP);
  call_out("kill_player", 4);
  return ::austreten();
}

void kill_player()
{
  object gnpc;

  if(TP && present(TP, TO) && objectp(gnpc=present(GUILDNPC_ID, TO)) ) 
    gnpc->Kill(TP);
}


/*Hier beginnt das Anathema, die Selbstverdammung!*/
nosave int Anathema() 
{
  string restr;
  object gnpc, ob;

  /*
  notify_fail(BS(
    "Zur Zeit duerfen nur Testspieler und Magier in dieser Gilde "
    "Paladine opfern! Aber bald!"));
  if(!TP->QueryProp(P_TESTPLAYER) && !IS_LEARNING(TP))
    return 0;
  */

  notify_fail("Ohne "+GUILDNPC_LONGNAME+" laeuft hier gar nichts!\n");
  if(!gnpc=present(GUILDNPC_ID, ME))
    return 0;

  if(gnpc->QueryProp(P_NOATTACK) == "ist zu vertieft in die Zeremonie.") {
    write(GUILDNPC_LONGNAME+" hat gerade keine Zeit.\n");
    return 1;
  }
  // Zuweisung erst NACH dem Check ob Xarfai Zeit hat.
  
  notify_fail(
    BSA("Du Narr bist bereits ein Ritter unseres Ordens!",
        GUILDNPC_NAME+" kraechzt: "));
  if(IsGuildMember(TP))
     return 0;
  if( TP->QueryProp(P_GUILD) != "paladine") 
  {
    tell_room(ENV(TP), BSA(sprintf("Bei allen Daemonen aus der Hoelle! "
              "DU UNWUERDIGE%s %s! NUR PALADINE KOENNEN UNS FOLGEN!", 
            check_gender("r",""),check_gender("NARR","NAERRIN"),
            TP->name(WER)), GUILDNPC_NAME+" bruellt: "));
    return 1;
    
  }
  
  if(restr=call_other(RES_CHECKER, "check_new_restrictions", TP,  
      QueryProp(P_GUILD_RESTRICTIONS))) 
  {
     tell_room(ENV(TP), BSA(sprintf("Du elendig%s Versager%s! Wenn Du "
               "nicht staerker wirst werden wir Dich nie aufnehmen, %s! "
               "%s", 
             check_gender("er","e"), check_gender("","in"),
             TP->Name(WER), restr), GUILDNPC_NAME+" bruellt: "));
    return 1;
  }
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:200, PARALYZE_MSG:"", 
           PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  gnpc->SetProp(P_NOATTACK,"ist zu vertieft in die Zeremonie.");
  gnpc->SetProp(P_CHAT_CHANCE,0);
  while(remove_call_out("reset_guild_npc") != -1) ;
  call_out("reset_guild_npc", 200);
  
  if( IS_LEARNER(TP) || (TP->QueryProp(P_TESTPLAYER) && 
        !IS_ARCH(lower_case(TP->QueryProp(P_TESTPLAYER)))) ) 
    test_flag = 1; 
  else
    test_flag = 0;
  TP->SetProp(P_NOATTACK, 1);
  if(!present("\n"+P_NOATTACK, TP)) {
    ob=clone_object("/gilden/nekromanten/obj/noattack"); 
    ob->move(TP, M_NOCHECK);
  }
  LoadSequenz(SEQ+"beitritt.seq", TP, #'Sacrifice_Part_Two); 
  return 1;
}

nosave void Sacrifice_Part_Two() 
{
 write(BS("Um den Weg der Verdammnis, zur Macht der Todesritter "
          "zu waehlen, gib 'salutiere' ein!"));
 write("Was moechtest Du nun tun?\n");
 input_to("Sacrifice_Part_Two_input"); 
}

nosave void Sacrifice_Part_Two_input(string str) 
{
  string *req_input;
  object xarfai, ob;
  req_input=({"salutier", "salutiere"});
  xarfai=present(GUILDNPC_ID);
  if(!str || member(req_input, str)==-1) {
    if(objectp(xarfai)) {
      tell_room(ENV(TP), BSA("Du wagst es?! STIRB!", 
          GUILDNPC_NAME+" wuetet: "));
      reset_guild_npc();
      TP->SetProp(P_NOATTACK, 0);
      if(ob=present("\n"+P_NOATTACK, TP)) {
        ob->remove();
      }
      TP->SetProp(P_PARALYZED, 0);
      xarfai->Kill(TP);
    }
    return;
  }
  LoadSequenz(SEQ+"beitritt2.seq", TP, #'Sacrifice_Part_Three); 
}

nosave void Sacrifice_Part_Three() 
{
  object opfer;
  string *msgs;
  msgs=({BSA("UND DIE FLUESSE FAERBEN SICH ROOOOOOOOOOOOOOOOOOT!!!!!", 
        "bruellt: "),
      "kreischt: Stirb Paladinpack!", "kreischt: Ich bin euer schlimmster "
      "Alptraum!", "bruellt: WO IST DER NAECHSTE VON EUCH?", "lacht wie von "
      "Sinnen!", BSA("FEIGLINGE! VERKRIECHT EUCH IN EURE BURG!", "bruellt: "), 
      "bruellt: UND SIE FALLEN IN HEKATOMBEN!"});      
  if(!test_flag) {
    call_other(PNPCMASTER, "AddFeind", TP);
    call_out("ayla_shout", 6);
  }
  else {
    TELL("gwenshara", "TESTFLAG gesetzt, keine ausgabe auf -T\n");
  }
  LoadSequenz(SEQ+"beitritt3.seq", TP, #'beitreten);
  return;
}

nosave void ayla_shout() 
{
  object ayla;
  if(ayla=find_living("ayla"))
    ayla->command_me(sprintf("prufe PALADINE! %s hat uns den Ruecken gekehrt "
          "und sich den finsteren Horden der Unterwelt angeschlossen! Es "
          "gibt nur eine Strafe dafuer: Vernichtet die verderbte Seele von %s!", 
          TP->Name(WER), TP->name(WER)));
  return;
}


int beitreten() 
{
  int b, ogl;
  object ob,gnpc;
  string *who;

  if(!gnpc=present(GUILDNPC_ID, ME)) {
    write("Ohne "+GUILDNPC_LONGNAME+" laeuft hier gar nichts!\n");
    return 1;
  }
  reset_guild_npc();
  if(ob=present("\n"+P_NOATTACK, TP)) {
    ob->remove();
  }
  who=({"Etwas", "Todesritter", "Todesritterin"});
  TP->SetProp(P_PARALYZED, 0);
  TP->SetProp(P_NOATTACK, 0);
  if(ob=present("\n"+P_NOATTACK, TP)) {
    ob->remove();
  }

  /* Muss man machen, damit ::beitreten() klappt: */
  ogl = TP->QueryProp(P_GUILD_LEVEL);
  TP->SetProp(P_GUILD, 0);
  TP->SetProp("dk_tmp_default_guild", 1);

  if((b=::beitreten())<0)
  {
   // WEnns nicht kalppt bleien wir paladin!
   TP->SetProp(P_GUILD, "paladine");
   TP->SetProp(P_GUILD_LEVEL, ogl);
   return 1;
  }

  tell_room(ENV(TP), BSA(sprintf("Sei unsere Reihen aufgenommen", 
          TP->Name(WER)), GUILDNPC_NAME+" sagt: "));
  write(BS("Mit Stolz in den Augen nimmst Du den schwarz-roten Wappenrock "
        "vom Altar und ziehst ihn ueber deine Ruestung!"));
  say(BS(sprintf("Mit Mordlust in den Augen nimmt %s den blutigen "
      "Wappenrock vom Knochenalter und zieht ihn ueber.", TP->Name(WER))));

  /* Alter Wappenrock weg, neuer her */
  if(objectp(ob=present("\npaladinwappenrock", TP)))
    ob->remove(1);
  ob=clone_object(ARMOUR+"wappenrock");
  ob->move(TP, M_NOCHECK);
  ob->DoWear(0);
  WLOG("/log/gilden/todesritter", "tritt in die Gilde ein.");
  //TELL("gwenshara", ""+call_other(NMASTER, "AddMember", TP, 0, "todesritter"));
  TP->ModifySkill(SK_SWORDFIGHTING, QuerySkill(SK_SWORDFIGHTING),100,
      "todesritter");
  TP->ModifySkill(SK_TWOHANDED, QuerySkill(SK_TWOHANDED),100,
      "todesritter");
  TP->Set(P_NEKRO_SKILLS_MOD, SAVE, F_MODE_AS);
  TP->Set(P_NEKRO_TASK_POINTS, SAVE, F_MODE_AS);
  TP->Set(P_GUILD_CIRCLE,SAVE,F_MODE_AS);
  TP->SetProp(P_GUILD_CIRCLE,1);
  TP->SetProp(P_GUILD_LEVEL,1);
  write_file(MEMBERLOG+getuid(TP)+".log",
             dtime(time())+": "+CAP(getuid(TP))+" ist "
			 +"in die Gilde eingetreten.\n");
  /*if( !test_flag )
    Channel(sprintf("%s! Ich wusste, dass Deine schwarze Seele "
        "eines Tages zu uns Nekromanten finden wuerde! Bei "
        "den endlosen Heerscharen von Yaq'Monoq, den verfluchten "
        "Ebenen von Ylem'Huran und dem bluttriefenden Steinkreis von "
        "Rot'Manuq, "
        "moegest Du stets die Seelen der Unschuldigen verfuehren und "
        "den dunklen Maechten opfern, auf dass sie eines Tages ihre "
        "blutige Herrschaft ueber das SilberLand erlangen moegen!",
      TP->Name(WER), who[TP->QueryProp(P_GENDER)]));*/
  tell_room(ME, BSA("Vergiss nicht die Hilfe zu lesen! (hilfe todesritter)",
        GUILDNPC_NAME+" spricht: "));
 return b;
}

/* Skillablilty am Anfang in einen Bereich 2500..3500 setzen */
nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl)-random(500)+random(500);
  if( value > 3500 ) value = 3500;
  if( value < 2500 ) value = 2500;
  return value;
}

nosave void Channel(string msg) 
{
  if(!test_flag) {
    CHMASTER->join("Info",TO);
    CHMASTER->send("Info",TO,msg,MSG_SAY);
  }
  else {
    TELL("angrox", sprintf("NEKROCHANNEL: %s\n", msg));
    TELL("archon", sprintf("NEKROCHANNEL: %s\n", msg));
  }
  return ;
}

int show_skillpunkte(string str)
{
  int punkte;
  mapping sp;
  string *skills;
  string ret;
  int i;
  
  if(!IsGuildMember(TP)) 
  {
    tell_room(ME, BSA(sprintf("Hau ab! Du "
                  "bist keiner von uns, %s!\n", TP->Name(WER)), GUILDNPC_NAME
                  +" sagt: "));
    return 1;
  }

  sp=call_other(DKMASTER, "QuerySkillPoints",PL);
  if (!mappingp(sp))
  {
    punkte=0;
    sp=([]);
  }
  else
    punkte=sp["freiepunkte"];
  skills=m_indices(sp-(["freiepunkte"]));
  ret="\nSkillpunkte\n************\n\n";
  if (punkte==1)
    ret+="Du hast noch einen Skillpunkt zur Verfuegung.\n";
  else if (punkte)
    ret+="Du hast noch "+punkte+" Skillpunkte zur Verfuegung.\n";
  else
    ret+="Du hast keine Skillpunkte zur Verfuegung.\n";
  ret+="\n";
  if (!sizeof(skills))
    ret+="Du hast noch keine Skillpunkte verteilt.\n";
  else
    for (i=sizeof(skills);i--;)
    {
      if (skills[i]=="time") ; 
      else if (skills[i]=="auge des khaza-dhunaar")
       ret+="Du hast fuer "+sprintf("%-29s",get_skill_name(skills[i]))+
           " "+sp[skills[i]]+"/ 2 Skillpunkte vergeben.\n";
      else
       ret+="Du hast fuer "+sprintf("%-29s",get_skill_name(skills[i]))+
           " "+sp[skills[i]]+"/10 Skillpunkte vergeben.\n";
    }
  ret+="\nDu kannst Deine Fertigkeiten in den folgenden Skills verbessern:\n";
  skills = skillpointable-skills;
  for (i=sizeof(skills);i--;)
  {
    ret+="  "+get_skill_name(skills[i])+"\n";
  }
  write(ret);
  return 1;
}

nosave int advance_skill(string str)
{
  string skill;
  string *skills;
  mapping sp;
  mixed help;
  int punkte;

  str=lower_case(TP->_unparsed_args()); //da sonst skills wie hauch der verwesung nicht gehen
  if (sscanf(str,"zauber %s",skill)!=1)
  {
    write("Wenn Du einen Skill erhoehen willst, solltest Du ihn als Argument "
          "angeben.\nSyntax: erhoehe zauber <name>\n");
    return show_skillpunkte("");
  }
  help=PL->QueryProp(P_NEWSKILLS);
  if (!mappingp(help))
  {
    tell_room(ME,BSA("So etwas beherrschst Du ueberhaupt nicht!\n",
                 GUILDNPC_NAME+" kreischt: "));
    return 1;    
  }
  if (!help[skill])
  {
    tell_room(ME,BSA("So etwas beherrschst Du ueberhaupt nicht!\n",
                 GUILDNPC_NAME+" kreischt: "));
    return 1;    
  }
  if (member_array(skill,skillpointable)<0)
  {
    tell_room(ME,BSA("Dies kannst Du nicht erhoehen!\n",
                 GUILDNPC_NAME+" kreischt: "));
    return 1;
  }
  sp=call_other(DKMASTER, "QuerySkillPoints",PL);
  if (!mappingp(sp))
    punkte=0;
  else
    punkte=sp["freiepunkte"];
  if (punkte<1)
  {
    tell_room(ME,BSA("Dummkopf! Du hast ueberhaupt keine Skillpunkte "
                 "zum Verteilen!\n",
                 GUILDNPC_NAME+" kreischt: "));
    return 1;
  }
  if (sp["time"] > time())
  {
    tell_room(ME,BSA("Du musst noch warten, bis Du wieder einen "
          "Skillpunkt verteilen kannst.\n",
                 GUILDNPC_NAME+" kreischt: "));
    return 1;
  }
  if (TP->QueryProp(P_SP) < SKILLPOINT_COST)
  {
    tell_room(ME,BSA("Deine magische Kraft ist zu gering!\n",
                 GUILDNPC_NAME+" kreischt: "));
    return 1;
  }
  punkte=sp[skill];
  if ( (skill=="auge des khaza-dhunaar" && punkte>1) || punkte>9)
  {
    tell_room(ME,BSA("Dummkopf! Du hast diesen Skill schon voll "
                 "ausgeschoepft!\n",
                 GUILDNPC_NAME+" kreischt: "));
    return 1;
  }
  TP->AddSp(-SKILLPOINT_COST);
  sp["freiepunkte"]--;
  if (!sp[skill])
    sp+=([skill:1]);
  else
    sp[skill]++;
  sp += (["time": time() + SKILLPOINT_TIME]);
  call_other(DKMASTER, "SetSkillPoints",PL,sp);
  if ((skill=="auge des khaza-dhunaar" && sp[skill]==2) || sp[skill]==10)
    write(BS("Du erhoest den Skill '"+get_skill_name(skill)+"' und hast nun "
          "die maximale Skillpunktanzahl auf diesen Skill verwendet."));
  else
    write(BS("Du erhoest den Skill '"+get_skill_name(skill)+"' und hast nun "
          +sp[skill]+"/" + (skill == "auge des khaza-dhunaar" ? "2" : "10") +
          " Skillpunkte auf diesen Skill verwendet."));
  write_file(MEMBERLOG+getuid(TP)+".log", dtime(time())+": "+ CAP(getuid(TP))+
      " verteilt Skillpunkt auf "+skill+" ("+ sp[skill]+").\n");
  return 1;
}

nosave mixed advance(string str) 
{
  mixed res;
  mapping cond;
  int glvl, ggrad, abil;
  object xarfai;

  glvl=TP->QueryProp(P_GUILD_LEVEL);
