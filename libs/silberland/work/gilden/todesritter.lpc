int cmd_blutpool(string str)
{
  mixed blut;
  int prozent;
  
  if(!IsGuildMember(TP)) 
    return 0;
  blut=call_other(DKMASTER,"QueryBloodPool");
  if (!pointerp(blut)) prozent=0;
  else
    prozent=blut[0]*100/blut[1];
  if (prozent<0) prozent=0;
  if (prozent>100) prozent=100;
  switch(prozent)
  {
    case 0: 
      str=sprintf("Die Seelenmuehle ist ausgetrocknet. Versager%s, "
                  "Du musst viel mehr Seelen opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"in":"");
    break;
    case 1..9: 
      str=sprintf("Nur noch ein paar Seelen stehen uns zur Verfuegung. "
          "Versager%s, Du musst viel mehr Seelen opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"in":"");
    break;
    case 10..19: 
      str="WIR HABEN ZUWENIG SEELEN! Du Wurm! "
                  "Du musst viel mehr Seelen opfern.";
    break;
    case 20..29: 
      str=sprintf("Die Anzahl der vorhandenen Seelen ist kaum der "
          "Rede wert. Versager%s, Du musst viel mehr opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"in":"");
    break;
    case 30..39: 
      str=sprintf("Steh hier nicht rum, Versager%s! "
                  "Du musst viel mehr opfern. Die Seelen reichen noch lange "
                  "nicht!",
                  TP->QueryProp(P_GENDER)==FEMALE?"in":"");
    break;
    case 40..49: 
      str=sprintf("Noch nichtmal halbvoll! Versager%s, "
                  "Du musst mehr opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"in":"");
    break;
    case 50..59: 
      str=sprintf("Halbleer! Schaff mehr Seelen herbei, Nekromant%s! "
                  "Du musst mehr opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"in":"");
    break;
    case 60..69: 
      str=sprintf("Langsam wird es! Doch wir brauchen mehr Seelen! "
          "Nekromant%s, Du musst mehr opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"in":"");
    break;
    case 70..79: 
      str=sprintf("Mehr! Ich brauche noch mehr Seelen! Nekromant%s, "
                  "Du musst mehr opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"in":"");
    break;
    case 80..89: 
      str=sprintf("Ein wenig mehr muss es schon noch werden. Elend%s, "
                  "Du musst mehr opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"e":"er");
    break;
    case 90..99: 
      str=sprintf("JA! Fast! Bald ist die Seelenmuehle voll. Elend%s, "
                  "Du musst noch ein wenig mehr Seelen opfern.",
                  TP->QueryProp(P_GENDER)==FEMALE?"e":"er");
    break;
    default: str="Die Seelenmuehle ist randvoll mit gefuellt. Was fuer "
             "ein Fest!"; break;
  }
  write(BSA(str,GUILDNPC_NAME+" kreischt: "));
  return 1;
}

