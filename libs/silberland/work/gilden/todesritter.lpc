  return ;
}


void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
  if(victim == SeqPlayer()) {
    StopSequence();
  }
  return;
}

void BecomesNetDead(object player) {
  if(player == SeqPlayer()) {
    StopSequence();
  }
  return;
}


//
// Wenn der Spieler die Sequenz verlaesst, wird einfach aufgehoert oder
// der Spieler getoetet. haha :)
//
void sequence_player_left(mixed player) {
  object gnpc;
  if(!gnpc=present(GUILDNPC_NAME)) return;
  reset_guild_npc();
  if(!objectp(player)) return;
  if(environment(player) == this_object()) return;
  call_other(NNPCMASTER, "AddFeind", player);
  Message(BSA("Wage es nicht noch einmal hierher zu kommen!",
        GUILDNPC_NAME+" teilt Dir mit: "), MSGFLAG_TELL);
  gnpc->Kill(player);
  return ::sequence_player_left(player);
}

int IsCastDisabled()
{
  return (cast_disabled == 1);
}

varargs mixed check_advance(object pl, int flag) {
  int ggrad, glvl;
  mapping cond;
  mixed res;
  ggrad=pl->QueryProp(P_GUILD_CIRCLE);
  glvl=pl->QueryProp(P_GUILD_LEVEL);
  if(flag) {
    if(glvl > 6) return "Du bist schon im siebten Kreis der Verdammnis!";
    cond=QueryProp(P_GUILD_LEVELS);
    res=call_other(RES_CHECKER, "check_new_restrictions", pl, cond[glvl+1]);
  }
  else {
    if(ggrad > 6) return "Du bist schon im inneren Grad sieben!";
    cond=QueryProp(P_GUILD_CIRCLE_LEVELS)[glvl];
    res=call_other(RES_CHECKER, "check_new_restrictions", pl, cond[ggrad+1]);
  }
  return res;
}

void add_room_messages() {
  AddRoomMessage( ({ "" }), 35, "BeNasty");
  return ;
}
