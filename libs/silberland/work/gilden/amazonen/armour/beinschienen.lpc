#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Goldene Beinschienen");
  SetProp(P_LONG,
    "Goldene Beinschienen, die man sich auf die Beine schnallen kann, "
    "die damit sehr gut vor Schlaegen geschuetzt sind. Einfache Muster "
    "sind in den Rand der Beinschienen graviert." );
  SetProp(P_INFO, BS(
    "Bei genauerem Betrachten bestehen die Beinschienen nur aus vergoldeter "
    "Bronze.") );  
  SetProp(P_NAME, "Beinschienen");
  SetProp(P_PLURAL, 1);
  SetProp(P_NAME_ADJ, "golden" );
  SetProp(P_GENDER, FEMALE);
  AddId( ({"beinschienen", "\namamzonen_beinschienen", "\namazonen_item"}) );
  AddAdjective( ({"golden", "goldene"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([ MAT_GOLD:20, MAT_BRONCE:80 ]) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 120);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "amazonen"]) );
}
