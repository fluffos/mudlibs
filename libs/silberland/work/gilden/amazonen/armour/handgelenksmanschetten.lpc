#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Handgelenksmanschetten");
  SetProp(P_LONG,
    "Diese Handgelenksmanschetten bestehen aus hartem Leder, das mit "
    "eisernen Nieten verstaerkt ist und schuetzen die Handgelenkte und "
    "einen Teil der Oberseite der Haende. Die Finger und Handballen "
    "sind ganz frei und dadurch voll beweglich." );
  SetProp(P_NAME, "Handgelenksmanschetten");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"handgelenksmanschetten", "manschetten", 
           "\namamzonen_handgelenksmanschetten", "\namazonen_item"}) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_LEATHER:70, MAT_IRON:30 ]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 200);

}
