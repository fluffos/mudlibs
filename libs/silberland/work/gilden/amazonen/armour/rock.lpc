#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein stahlverstaerktes Roeckchen");
  SetProp(P_LONG,
    "Dieses Roeckchen besteht aus weichem Rauleder und ist mit Eisennieten "
    "verstaerkt. Dazwischen befinden sich zusaetzlich noch duenne "
    "Stahlstreifen, die den Ruestungsschutz noch verstaerken. "
    "Da es nur bis knapp zur Mitte der Oberschenkel reicht, bietet es "
    "guten Einblick auf die wohlgeformten Beine seiner Traegerin und "
    "behindern diese kaum in ihrer Bewegungsfreiheit." );
  SetProp(P_INFO, BS("Natuerlich tragen nur Frauen solche Roeckchen.") );
  SetProp(P_NAME, "Roeckchen");
  SetProp(P_NAME_ADJ, "stahlverstaerkt" );
  SetProp(P_GENDER, NEUTER);
  AddId( ({"roeckchen", "\namamzonen_roeckchen", "\namazonen_item"}) );
  AddAdjective( ({"stahlverstaerkt", "stahlverstaerktes", "stahlverstaerkte"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_LEATHER: 50, MAT_IRON:20, MAT_STEEL:30 ]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}
