// Amazonenausruestung
// 13-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Amazonenhelm mit Pferdeschwanz");
  SetProp(P_LONG,
    "Ein Helm wie ihn nur echte Amazonen tragen. Er besteht aus vergoldeter "
    "Bronze und ist mit vielen Verzierungen geschmueckt. Er schuetzt den "
    "ganzen Kopf, statt einem Visier schuetzen nur zwei kleine Metallplatten "
    "die Wangen. Im Nacken befindet sich eine Ausbuchtung, damit die langen "
    "Haare der Traegerin nicht zu sehr verdrueckt werden. Zum Schmuck "
    "haengt ein rotgefaerbter Pferdeschwanz vom Helm herunter." );
  SetProp(P_NAME, "Amazonenhelm");
  SetProp(P_INFO, BS(
    "Der Pferdeschwanz bedeutet wohl, dass dieser Helm nur von einer "
    "besonders ausgezeichneten Amazone getragen werden darf."));
  SetProp(P_GENDER, MALE);
  AddId( ({"amazonenhelm", "helm", "\namamzonen_helm", "\namazonen_item"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([ MAT_GOLD:20, MAT_BRONCE:80 ]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 2000);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "amazonen", P_GUILD_LEVEL:5]) );
}
