// Amazonenausruestung
// 13-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein feuerroter Umhang");
  SetProp(P_LONG,
    "Ein Umhang aus feuerrotem Stoff, wie ihn Offizierinnen der Amazonen "
    "gern tragen. Mit einer goldenen Spange kann man dem Umhang an der "
    "Ruestung befestigen. Der Saum ist mit wertvollen Stickereien "
    "geschmueckt, die Amazonen im Kampf mit boesen Monstern zeigen." );
  SetProp(P_NAME, "Umhang");
  SetProp(P_NAME_ADJ, "feuerrot");
  SetProp(P_INFO, BS(
    "Dieser Umhang scheint gegen boese und schreckliche Monster zu "
    "schuetzen, ob er aufgrund seiner Farbe auch gegen Feuer schuetzt?"));
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "offiziersumhang", "\namamzonen_umhang", "\namamzonen_item"}) );
  AddAdjective( ({"feuerrot", "feuerroten", "feuerrotem"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([ MAT_CLOTH: 95, MAT_GOLD:5 ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 150);
  AddProp(P_DAM_PROTECTION, ([DT_TERROR: 1, DT_UNHOLY: 1, DT_FIRE:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "amazonen", P_GUILD_LEVEL: 8]) );
}
