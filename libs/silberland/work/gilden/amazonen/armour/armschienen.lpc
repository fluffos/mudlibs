#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Goldene Armschienen");
  SetProp(P_LONG,
    "Goldene Armschienen, die man sich auf die Unterarme schnallen kann, "
    "die damit sehr gut vor Schlaegen geschuetzt sind. Einfache Muster "
    "sind in den Rand der Armschienen graviert." );
  SetProp(P_INFO, BS(
    "Bei genauerem Betrachten bestehen die Armschienen nur aus vergoldeter "
    "Bronze.") );  
  SetProp(P_NAME, "Armschienen");
  SetProp(P_PLURAL, 1);
  SetProp(P_NAME_ADJ, "golden" );
  SetProp(P_GENDER, NEUTER);
  AddId( ({"armschienen", "\namamzonen_armschienen", "\namazonen_item"}) );
  AddAdjective( ({"golden", "goldene"}) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([ MAT_GOLD:20, MAT_BRONCE:80 ]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 120);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "amazonen"]) );
}
