#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Waffengurt");
  SetProp(P_LONG,
    "Dieser Waffengurt ist ein breiter Guertel, der nicht nur die Taille "
    "schuetzt, sondern auch die Figur seiner Traegerin vorteilhaft zur "
    "Geltung bringt." );
  SetProp(P_NAME, "Waffengurt");
  SetProp(P_GENDER, MALE);
  AddId( ({"waffengurt", "gurt", "\namamzonen_gurt", "\namamzonen_item"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([ MAT_LEATHER: 100 ]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 250);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}
