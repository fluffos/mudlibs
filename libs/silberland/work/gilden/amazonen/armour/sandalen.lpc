#include "../def.h"

inherit "std/armour";

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Sandalen mit langen Riemchen");
  SetProp(P_LONG,
    "Diese Sandalen haben eine stabile, aber weiche Sohle aus hellbraunem "
    "Leder und sind mit kleinen Metallnieten verstaerkt. Mit zwei "
    "kreuzfoermig gefuehrten Lederriemchen sind die Sandalen am Fuss der "
    "Traegerin befestigt. Sie reichen bis knapp unters Knie und lassen, "
    "zusammen mit dem hohen Absatz, die Beine irgendwie laenger aussehen.");
  SetProp(P_NAME, "Riemchensandalen");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"riemchensandalen", "sandalen", "\namamzonen_sandalen", 
           "\namazonen_item"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([ MAT_STEEL:20, MAT_LEATHER:80 ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 120);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}
