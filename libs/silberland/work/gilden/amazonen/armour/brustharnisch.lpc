#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein vergoldeter Brustharnisch");
  SetProp(P_LONG,
    "Dieser Brustharnisch ist genau den weiblichen Proportionen nachgeahmt. "
    "Der Harnisch bedeckt fast den ganzen Oberkoerper, die Schultern sind "
    "aber komplett frei, um die Beweglichkeit nicht einzuschraenken. "
    "Man hat auch ein freizuegigen Einblick auf das Dekollete der Traegerin." );
  SetProp(P_INFO, BS(
    "Der Harnisch scheint durch magische Behandlung leichter gemacht worden "
    "zu sein.") );  
  SetProp(P_NAME, "Brustharnisch");
  SetProp(P_NAME_ADJ, "vergoldet" );
  SetProp(P_GENDER, MALE);
  AddId( ({"brustharnisch", "harnisch", "\namamzonen_brustharnisch", "\namazonen_item"}) );
  AddAdjective( ({"vergoldet", "vergoldeter", "vergoldeten"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 25);
  SetProp(P_MATERIAL, ([ MAT_GOLD:20, MAT_BRONCE:80 ]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1500);
  SetProp(P_QUALITY_DECAY, 120);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}
