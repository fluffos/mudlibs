#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Rundschild");
  SetProp(P_LONG,
    "Ein Rundschild, wie er gerne von leicht geruesteten Kaempfern getragen "
    "wird. Er liegt gut auf dem Arm, ist wegen seiner mittleren Groesse "
    "keine echte Behinderung und trotzdem ein guter Schutz. Der Schild "
    "besteht aus einem runden Holzrahmen, der mit Leder bespannt ist. "
    "In der Mitte und am Rand ist er aber mit Hartmetall verstaerkt." );
  SetProp(P_NAME, "Rundschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"rundschild", "schild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 19);
  SetProp(P_MATERIAL, ([ MAT_IRON:20, MAT_LEATHER:35, MAT_WOOD:45 ]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 700);

}
