// Amazonenausruestung
// 13-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein roter Umhang");
  SetProp(P_LONG,
    "Ein Umhang aus rotem Stoff, wie ihn Amazonen gern tragen. "
    "Mit einer silbernen Spange kann man dem Umhang an der "
    "Ruestung befestigen. " );
  SetProp(P_NAME, "Umhang");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "\namamzonen_umhang", "\namamzonen_item"}) );
  AddAdjective( ({"rot", "roten", "rotem"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_CLOTH: 95, MAT_SILVER:5 ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  
  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "amazonen"]) );
}
