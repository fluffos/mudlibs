#include "../def.h"

inherit "std/weapon";

void create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Wurfspeer");
  SetProp(P_LONG,
    "Ein einfacher Wurfspeer aus poliertem Eschenholz und staehlerner "
    "Spitze." );
  SetProp(P_NAME, "Wurfspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"wurfspeer", "speer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 120);
  SetProp(P_WC_FIX, 0);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_ASH_WOOD:90, MAT_STEEL:10]) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 100);

  SetProp(P_WC_BONUS, 
    (["Speerkaempfer": 50, "Speerexperte":120, "Speermeister":250 ]) );
}

