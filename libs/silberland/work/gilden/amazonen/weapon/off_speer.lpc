#include "../def.h"

inherit "std/weapon";

void create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Offizierinnenspeer");
  SetProp(P_LONG,
    "Dieser Speer schaut aus wie ein normaler Amazonenspeer, nur ist der "
    "Holzstiel mit vielen Verzierungen und Schnitzereien verschoenert. "
    "Der Griff ist mit einem rotem Band umwickelt, damit man nicht so "
    "leicht abrutschen kann. Die staehlerne Spitze ist mit feinen "
    "Ziselierungen verziert und schaut extrem scharf aus." );
  SetProp(P_NAME, "Offizierinnenspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"offizierinnenspeer", "speer", "\namazonenoffspeer", "\namazonen_item"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 180);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:90, MAT_STEEL:10]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1500);

  SetProp(P_WC_BONUS, (["Speerkaempfer": 50, "Speerexperte":100, "Speermeister":175 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD: "amazonen", P_GUILD_LEVEL: 8 ]) );
}

