// Amazonenausruestung
// 13-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

void create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Amazonenspeer");
  SetProp(P_LONG,
    "Dieser Speer ist die Hauptwaffe der Amazonen. Man kann damit zustossen, "
    "aber auch fuer einen gutgezielten Wurf ist dieser Speer geeignet. "
    "Der lange hoelzerne Speerschaft ist mit leichten Rippen versehen, um "
    "die Grifffestigkeit zu erhoehen. Die staehlerne Spitze besitzt "
    "zusaetzlich noch auf beiden Seiten eine scharfe Schneide." );
  SetProp(P_NAME, "Amazonenspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"amazonenspeer", "speer", "\namazonenspeer", "\namazonen_item"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:90, MAT_STEEL:10]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 500);

  SetProp(P_WC_BONUS, (["Speerkaempfer": 50, "Speerexperte":100, "Speermeister":200 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD: "amazonen" ]) );
}

