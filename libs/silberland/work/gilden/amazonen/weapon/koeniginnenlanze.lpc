#include "../def.h"

inherit "std/weapon";

void create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Die Koeniginnenlanze");
  SetProp(P_LONG,
    "Dies ist die herrliche Lanze der Amazonenkoenigin. Der Stiel besteht "
    "aus schwaerzestem Ebenholz und ist mit wertvollen Edelsteinen verziert. "
    "Die Spitze aus gleissendem Metall glitzert gefaehrlich." );
  SetProp(P_NAME, "Koeniginnenlanze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"koeniginnenlanze", "lanze", "\namazonenlanze", "\namazonen_item"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 260);
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_EBONY:50, MAT_ADAMANT:20, MAT_MITHRIL:20,
                        MAT_DIAMOND:2, MAT_RUBY:2, MAT_EMERALD:2,
                        MAT_SAPPHIRE:2, MAT_MAGIC:2]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 10000);

  SetProp(P_WC_BONUS, (["Speerkaempfer": 50, "Speerexperte":100, 
                        "Speermeister":200, GUILD_NPC_ID: 740 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD: "amazonen", P_GUILD_LEVEL: 10 ]) );

  SetProp(P_HIT_FUNC, TO);
  SetProp("waffenbalsam", 10);
}

int runden;

int HitFunc( object enemy ) 
{
  int ret_value;
  mapping resist;
  string damtype;
  
  ret_value=0;
  if( !runden )
  {
    if( !random(5) )
    {
      if(mappingp(resist=enemy->QueryProp(P_RESISTANCE_STRENGTHS) ) )
      {
        if(random(2) && to_float(resist[DT_EXPLOSION])>0.0)
        {
          SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_EXPLOSION}) );
          runden=5+random(10);
          tell_object(QueryProp(P_WIELDED), 
            "Ein Diamant der Koeniginnenlanze leuchtet auf.\n"); 
        }
        else if( random(2) && to_float(resist[DT_FIRE])>0.0)
        {
          SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_FIRE}) );
          runden=5+random(10);
          tell_object(QueryProp(P_WIELDED), 
            "Ein Rubin der Koeniginnenlanze leuchtet auf.\n"); 
        }
        else if( random(2) && to_float(resist[DT_COLD])>0.0)
        {
          SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_COLD}) );
          runden=5+random(10);
          tell_object(QueryProp(P_WIELDED), 
            "Ein Saphir der Koeniginnenlanze leuchtet auf.\n"); 
        }
        else if( random(2) && to_float(resist[DT_POISON])>0.0)
        {
          SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_POISON}) );
          runden=5+random(10);
          tell_object(QueryProp(P_WIELDED), 
            "Ein Smaragd der Koeniginnenlanze leuchtet auf.\n"); 
        }
        else if (sizeof(QueryProp(P_DAM_TYPE)) > 1)
        {
          tell_object(QueryProp(P_WIELDED),
              "Das Leuchten der Koeniginnenlanze verschwindet.\n");
          SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
        }
      }
    }
  }
  else
  {
    runden--;
    if( !random(5) || QueryProp(P_WIELDED)->id("\namazonenkoenigin") )
    {
      if( sizeof(QueryProp(P_DAM_TYPE)) >= 2 )
      {
        damtype=(QueryProp(P_DAM_TYPE)-({DT_PIERCE}))[0];
        switch( damtype )
        {
          case DT_EXPLOSION:
            tell_object(enemy, "Die Koeniginnenlanze verursacht eine heftige "
                               "Explosion bei diesem Treffer.\n");
            tell_object(QueryProp(P_WIELDED), 
                "Die Koeniginnenlanze verursacht eine heftige "
                               "Explosion bei diesem Treffer.\n");
            ret_value=100+random(100);
            break;
          case DT_FIRE:
            tell_object(enemy, "Flammen springen von der Koeniginnenlanze auf "
                               "Dich ueber.\n");
            tell_object(QueryProp(P_WIELDED), "Flammen springen von der "
                "Koeniginnenlanze auf "+enemy->name(WEN)+" ueber.\n");
            ret_value=100+random(100);
            break;
          case DT_COLD:
            tell_object(enemy, "Die Koeniginnenlanze friert Dich ein.\n");
            tell_object(QueryProp(P_WIELDED), "Die Koeniginnenlanze friert "+
                enemy->name(WEN)+" ein.\n");
            ret_value= 100+random(100);
            break;
          case DT_POISON:
            tell_object(enemy, "Die Koeniginnenlanze verspritzt giftige "
                               "Fluessigkeit auf Dich.\n");
            tell_object(QueryProp(P_WIELDED), "Die Koeniginnenlanze verspritzt giftige "
                               "Fluessigkeit auf "+enemy->name(WEN)+".\n");
            ret_value=100+random(100);
            break;
          default: ret_value=random(100);
        }
      }
    }
  }
  if( !random(15) && QueryProp(P_WIELDED)->id("\namazonenkoenigin") )
    ret_value+=100+random(300);
  return ret_value;
}
