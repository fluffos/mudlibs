// Edynia - Questitem - Blitzableiter


inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Blitzableiter");
  SetProp(P_LONG, 
      "Ein selbst gebastelter Blitzableiter aus einem simplen Holzstab, "
      "einer Metallspitze und etwas Draht. Ob der funktioniert?");
  SetProp(P_NAME, "Blitzableiter");
  SetProp(P_GENDER, MALE); 
  AddId( ({"ableiter","blitzableiter","QUEST-BLITZABLEITER"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, ([MAT_MISC:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
 
}  
 


