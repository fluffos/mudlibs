#include "../def.h"

inherit "std/thing";

#define ANZAHL 5

mapping fragen = ([
    1:"\nWieviele Kampfsoldaten bewachen Midas?\n"
      "A: 8, B: 10, C: 12\n\n"; "a",
  
    2:"\nWie lange faehrt die Karavelle vom Fischerdorf bis Tijaras?\n"
      "A: 1 min, B: 2 min, C: 3 min\n\n"; "a",

    3:"\nWie viele Boeszwerge gibt es?\n"
      "A: 5, B: 6, C: 7\n\n"; "c",

    4:"\nWelches Schuhwerk tragen die Elfen in Elessar?\n"
      "A: Stiefel, B: Sandalen, C: Mokkasins\n\n"; "c",

    5:"\nWelche Frucht waechst nicht auf den Plantagen von Tijara?\n"
      "A: Mandarine, B: Banane, C: Ananas\n\n"; "a",

    6:"\nWorauf kann man in Polar reiten?\n"
      "A: Rentier, B: Wind, C: Elch\n\n"; "b",

    7:"\nWelche Stadt befindet sich in der Wueste?\n"
      "A: Felonia, B: Quaul, C: Derlim\n\n"; "b",

    8:"\nWieviele Gardisten bewachen Tijara?\n"
      "A: 6, B: 7, C: 8\n\n"; "c",
  
    ]);

int richtig;
int *nr = ({});

void create()
{
  int i, f, *ff;
  
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  AddId( ({"\namazonen_erkenntnis"}) );

  ff = m_indices(fragen);
  for (i = 0; i < ANZAHL; i++)
  {
    f = random(sizeof(ff));
    nr += ({ ff[f] });
    ff -= ({ ff[f] });
  }
}

void init()
{
  ::init();
  richtig = 0;
  call_out("frage",2);
}


void frage()
{
  write(fragen[nr[0]]);
  input_to("antworten",0);
}

void antworten(string str)
{
  if (member(({"a", "b", "c"}), str) == -1)
  {
    write("\nBitte nur mit a, b oder c antworten!\n\n");
    call_out("frage", 2);
    return;
  }
  if (str == fragen[nr[0],1])
    richtig++;
  nr -= ({ nr[0] });
  if (sizeof(nr))
    call_out("frage", 2);
  else
    call_out("fertig", 2);
}

void fertig()
{
  if (IS_WIZARD(TP))
    write("MAGIERINFO: " +richtig + " richtige Anworten bei " + ANZAHL + 
        " Fragen.\n\n");
  if (richtig > ANZAHL * 3 / 4)
  {
    write("Du hast sehr gut geschaetzt und erlernst nun den Spruch "
        "'Erkenntnis'.\n");
    find_object("/gilden/amazonen")->LearnSpell("erkenntnis", TP); 
  }
  else
  {
    write("Du hast Dich verschaezt, Du solltest noch mehr ueben und es nochmal "
        "probieren.\n");
  }
  remove();
}
