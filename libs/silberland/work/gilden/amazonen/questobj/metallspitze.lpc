inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine kleine Metallspitze");
  SetProp(P_LONG, 
      "Ein kleine Metallspitze. Fuer irgendwas ist sie sicher gut.");
  SetProp(P_NAME, "Metallspitze");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"metallspitze","spitze","kleine metallspitze","QUEST-METALLSPITZE"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_PLURAL, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_IRON:100]));
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);

   
}  
 


