inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Holzstab");
  SetProp(P_LONG, 
      "Ein einfacher Holzstab.");
  SetProp(P_NAME, "Holzstab");
  SetProp(P_GENDER, MALE); 
  AddId( ({"holzstab","stab","QUEST-HOLZSTAB"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_PLURAL, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
//  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);

   
}  
 


