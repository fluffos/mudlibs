inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein kleines Giesskaennchen");
  SetProp(P_LONG, 
      "Ein kleines, suesses Giesskaennchen, das mit Wasser gefuellt ist.");
  SetProp(P_NAME, "Giesskaennchen");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kaennchen","giesskaennchen","QUEST-GIESSKAENNCHEN2"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_PLURAL, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_CERAMIC:100]));
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);

   
}  
 


