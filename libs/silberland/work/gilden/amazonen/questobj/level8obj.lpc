//TODO bei der raumabfrage nachher noch den pfad aendern.. da jetzt noch im 
//playersverzeichnis

inherit "std/thing";
#include "../def.h"

 object *obs;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, 0);
  AddId( "LEVEL8OBJEKT");
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NEVERDROP, 1);

 AddCmd( ({ "bastle", "bastel" }), "c_basteln");
 AddCmd( ({ "beschwoer", "beschwoere" }), "c_beschwoeren");
 }
 int c_basteln(string str)
 {
   
   obs[0]= present("QUEST-KRISTALLSTAB", TP);
   obs[1]= present("HMO_Goldenes Vlies", TP);
   obs[2]= present("\nluftkraut", TP);
   obs[3]= present("rubin", TP);
   obs[4]= present("saphir", TP);
   obs[5]= present("aquamarin", TP);
   obs[6]= present("topas", TP);
   obs[7]= present("granat", TP);
   obs[8]= present("smaragd", TP);
  
   notify_fail(BS("Was moechtest Du basteln?"));
   if(!((str == "speer der winde") || (str == "speer")))
 {   
   return 0;
 }
   if(obs[0] && obs[1] && obs[2] && obs[3] && obs[4] && obs[5] &&
      obs[6] && obs[7] && obs[8])
 {
    call_out("seq1", 0);
    return 1;
  }
  else
  {
    write(BS("Dir fehlen leider noch ein paar Dinge um den Speer zu bauen."));
    tell_room(ENV(TP), TPN+" denkt scharf nach.\n", ({TP}));
    return -1;  
 }
 }
  void seq1()
 {
  if (!TP) return;
  write("Du laesst den Kristallstab durch Deine Hand gleiten.\n");
  call_out("seq2", 4);
  tell_room(ENV(TP), TPN+" beginnt einen Speer zu basteln.\n", ({TP}));
 }

 void seq2()
 {
  if (!TP) return;
  write("Du wickelst das Luftkraut um ein Ende des Kristallstabes.\n");
  call_out("seq3", 4);
 }
 void seq3()
 {
  if (!TP) return;
  write("Ploetzlich verwandelt sich das Luftkraut in eine kegelfoermige\n"
	"Speerspitze, die noch etwas locker sitzt.\n");
  call_out("seq4", 4);
 }
  void seq4()
 {
  if (!TP) return;
  write("Behutsam befestigst Du die Speerspitze mit dem Goldenen Vlies.\n");
  call_out("seq5", 4);
 }
 void seq5()
 {
  if (!TP) return;
  write("Die Edelsteine in Deiner Hand beginnen magisch zu gluehen.\n");
  call_out("seq6", 4);
 }
 void seq6()
 {
  if (!TP) return;
  write("Jeder einzelne der Elementaredelsteine schwebt Dir aus der Hand.\n");
  call_out("seq7", 4);
 }
 void seq7()
 {
  if (!TP) return;
  write("Nacheinander schwebt jeder Edelstein auf den Stab zu.\n");
  call_out("seq8", 4);
 }
 void seq8()
 {
  if (!TP) return;
  write("Du schaust fasziniert zu.\n");
  call_out("seq9", 4);
 }
 void seq9()
 {
  if (!TP) return;
  write("Die Edelsteine legen sich auf den Stab und beginnen sich mit ihm\n"
	"zu verschmelzen.\n");
  call_out("seq10", 4);
 }
 void seq10()
 {
  if (!TP) return;
  write("Der Stab beginnt magisch zu leuchten und aufzugluehen.\n");
  call_out("seq11", 4);
 }
 void seq11()
 {
  if (!TP) return;
  write("Die Kraft der Elementarsteine fliesst in den Kristallstab.\n");
  call_out("seq12", 4);
 }
 void seq12()
 {
  if (!TP) return;
  write("Ploetzlich enstehen blaeuliche Winde, die um den Kristallstab wehen.\n");
  call_out("seq13", 4);
 }
 void seq13()
 {
 int i;
  
  if (!TP) return;
  write("Der maechtige Speer der Winde ist nun fertig.\n");

 for (i=0; i<9; i++)
 if (obs[i]->IsUnit()) obs[i]->AddAmount(-1); else obs[i]->remove();

  clone_object(OBJ "windesspeer")->move(TP, M_NOCHECK);
  remove();
 
  }
 
 int c_beschwoeren(string str)
   {
   notify_fail(BS("Wo moechtest Du mit dem Speer der Winde beschwoeren?"));
   if(!((str == "wind") || (str == "winde")))
    
   {
     return 0;
   }
   if(!present("QUEST-WINDESSPEER", TP)) 
   {
    
   write(BS("Ohne den Speer der Winde wird das wohl nichts."));
   tell_room(ENV(TP), TPN+" fuchtelt mit den Haenden in der Luft herum.\n", ({TP}));

   return -1;
   
 }
  
   if(file_name(ENV(TP)) != "/players/aaliyah/edynia/room/wolke9")
  
 {
    write(BS("Du bist leider nicht am richtigen Ort um die Winde zu "
	     "beschwoeren."));
    return -1;
 }
   else
 {
      write(BS("Du haelst den Speer in die Luft und unzaehlige Winde wehen von "
               "ueberall her. Sie umschliessen Dich und segnen Dich mit ihrer Kraft."));
      tell_room(ENV(TP), TPN+" beschwoert die Winde und sieht erfahrener aus.\n", ({TP}));
      find_object("/gilden/amazonen")->LearnSpell("wirbelwind", TP); 
      remove();
      return 1;
 
  }
 }
 
   
