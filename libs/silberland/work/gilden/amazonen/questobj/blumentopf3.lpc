// Edynia - Questitem - Blumentopf


inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein huebscher Blumentopf");
  SetProp(P_LONG, 
      "Ein huebscher Blumentopf aus Ton. Ein kleiner Samen wurde in "
      "die Erde gepflanzt und man sieht einen kleinen Huegel.");
  SetProp(P_NAME, "Blumentopf");
  SetProp(P_GENDER, MALE); 
  AddId( ({"blumentopf","huebscher blumentopf","QUEST-BLUMENTOPF3"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_PLURAL, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_CERAMIC:100]));
  SetProp(P_NAME_ADJ, "huebsch");
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);

  AddDetail( ({"huegel"}),
	"Da wo der Same in der Erde steckt, sieht man einen kleinen "
	"Huegel.");

  AddDetail( ({"erde"}),
	 "Hellrote Erde befindet sich in dem Blumentopf.");
 
 
}  
 


