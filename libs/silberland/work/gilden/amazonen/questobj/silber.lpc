// Edynia - Questitem - Silberstueck


inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Stueck Silber");
  SetProp(P_LONG, 
      "Ein unfoermiges Stueck Silber. Wer weiss wozu man dass noch gebrauchen "
      "kann.");
  SetProp(P_NAME, "Stueck Silber");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"stueck","stueck silber","silber","QUEST-SILBERSTUECK"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1000);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
 
}  
 


