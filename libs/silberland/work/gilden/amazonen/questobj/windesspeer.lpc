// 6. September 2006
// created by Aaliyah@Silberland
// Edynia - Questitem - Der Speer der Winde


inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Der Speer der Winde");
  SetProp(P_LONG, 
      "Die gebuendelte Energie von unzaehligen Winden steckt in diesem "
      "maechtigen Artefakt. Der Speer der Winde besteht aus einem edlen "
      "Kristallstab, in dem unzaehlige Wirbel glitzern. Die Speerspitze "
      "hat die Form eines spitzen Kegels und ist von blaeulichen Winden "
      "umgeben.");
  SetProp(P_NAME, "Speer der Winde");
  SetProp(P_GENDER, MALE); 
  AddId( ({"speer","artefakt","speer der winde","QUEST-WINDESSPEER"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 270);
  SetProp(P_WC_FIX, 27);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP, DT_AIR}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:60, MAT_MAGIC:30, MAT_AIR:10]) );

  AddDetail( ({"wirbel","orkan","orkane"}),
    "Die Wirbel sehen aus wie lauter kleine Orkane. Anscheinend befindet "
    "sich in diesem Stab geballte Luft.");

  AddDetail( ({"speerspitze","spitze","form","kegel","kegels"}),
    "Die kristalline Speerspitze hat die Form eines Kegels. Sie wurde mit "
    "goldenem Vlies am Speer befestigt.");
  
  AddDetail( ({"vlies","goldenes vlies","goldstraenge","seil","goldstrang"}),
    "Viele zarte Goldstraenge, die locker zu einem Seil gebunden wurden.");

  AddDetail( ({"wirbel"}),
    "Die Wirbel befinden sich im Kristallstab und glitzern magisch.");
 
  AddDetail( ({"kristallstab","stab"}),
    "Der Speer besteht aus einem Kristallstab. Er ist durchsichtig und "
    "in ihm glitzern unzaehlige magische Wirbel.");
 
  AddDetail( ({"wind","winden","winde"}),
    "Unzaehlige blaeuliche Winde wehen um die Speerspitze.");
  
  AddDetail( ({"energie"}),
    "In diesem Speer steckt die Energie von unzaehligen Winden.");
  
         
}  
 


