// created by Aaliyah@Silberland
// Edynia - Questitem - Kristallstab


inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Kristalltab");
  SetProp(P_LONG, 
      "Dieser filigrane Kristallstab ist ungefaehr zwei Meter lang. Er wurde "
      "schoen geschliffen und in ihm glitzern unzaehlige kleine Wirbel.");
  SetProp(P_NAME, "Kristallstab");
  SetProp(P_GENDER, MALE); 
  AddId( ({"stab","kristallstab","QUEST-KRISTALLSTAB"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:60, MAT_MAGIC:30, MAT_AIR:10]) );

  AddDetail( ({"wirbel","orkan","orkane"}),
    "Die Wirbel sehen aus wie lauter kleine Orkane. Anscheinend befindet "
    "sich in diesem Stab geballte Luft.");

}  
 


