// Gilden/Amazonen Questobjekt fuer Gildenlevel 2


inherit "std/thing";
#include "../def.h"

 object *obs;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, 0);
  AddId( "LEVEL2OBJEKT");
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NEVERDROP, 1);

 AddCmd( ({ "baue", "bau" }), "c_bauen");

 }
 int c_bauen(string str)
 {
   
   obs[0]= present("QUEST-PURPURLINDENAST", TP);
   obs[1]= present("QUEST-SPEERSPITZE", TP);
   obs[2]= present("QUEST-LEDERBAND", TP);
   
   notify_fail(BS("Was moechtest Du bauen?"));
   if(!((str == "speer")))
 {   
   return 0;
 }
   if(obs[0] && obs[1] && obs[2])
 {
    call_out("seq1", 0);
    return 1;
  }
  else
  {
    write(BS("Dir fehlen leider noch ein paar Dinge um den Speer zu bauen."));
    tell_room(ENV(TP), TPN+" gruebelt.\n", ({TP}));
    return -1;  
 }
 }
  void seq1()
 {
  if (!TP) return;
  write("Etwas unbeholfen guckst Du Dir den purpurnen Ast an.\n");
  call_out("seq2", 4);
  tell_room(ENV(TP), TPN+" beginnt einen Speer zu basteln.\n", ({TP}));
 }

 void seq2()
 {
  if (!TP) return;
  write("Du nimmst den Ast fest in Deine Haende.\n");
  call_out("seq3", 4);
 }
 void seq3()
 {
  if (!TP) return;
  write("Die Speerspitze funkelt frisch poliert.\n");
  call_out("seq4", 4);
 }
  void seq4()
 {
  if (!TP) return;
  write("Du wickelst das Lederband ein paarmal um den Ast.\n");
  call_out("seq5", 4);
 }
 void seq5()
 {
  if (!TP) return;
  write("Du ziehst fest am Lederband an und machst einen Knoten.\n");
  call_out("seq6", 4);
 }
 void seq6()
 {
  if (!TP) return;
  write("Du drueckst die Speerspitze gegen den Knoten und wickelst das Band um\n"
        "den Speer.\n");
  call_out("seq7", 4);
 }
 void seq7()
 {
  if (!TP) return;
  write("Geschickt verknotest Du die Speerspitze mit dem Ast.\n");
  call_out("seq8", 4);
 }
 void seq8()
 {
  if (!TP) return;
  write("Irgendwie sieht dieser Speer echt bescheuert aus.\n");
  call_out("seq9", 4);
 }
 void seq9()
 {
  if (!TP) return;
  write("Du ueberlegst .. und .. und ueberlegst....\n");
  call_out("seq10", 4);
 }
 void seq10()
 {
  if (!TP) return;
  write("....und .. ueberlegst...\n");
  call_out("seq11", 4);
 }
 void seq11()
 {
  if (!TP) return;
  write("... und... ueberlegst noch immer....\n");
  call_out("seq12", 4);
 }
 void seq12()
 {
  if (!TP) return;
  write("Dein Kopf tut vom vielen Ueberlegen schon weh.\n");
  call_out("seq13", 4);
 }
 void seq13()
 {
 int i;
  
  if (!TP) return;
  write("Dir faellt nichts ein, Du laesst den Speer so wie er ist.\n");

 for (i=0; i<3; i++)
 if (obs[i]->IsUnit()) obs[i]->AddAmount(-1); else obs[i]->remove();

  clone_object(OBJ "speer")->move(TP, M_NOCHECK);
  remove();
 
  }
 
 
 
   
