#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO) )  return;

  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  AddId( ({"\namazonen_aufspiessen_quest"}) );
}

void fertig()
{
  if (explode(file_name(previous_object()),"#")[0] != 
      "/d/dschungel/feyaria/tijara/npc/shagraz")
    return;
  call_out("fertig2", 2);
}

nosave void fertig2()
{
  tell_object(environment(),BS(
      "\nDurch Deinen Sieg gegen Shagraz bist Du nun faehig, "
      "'Aufspiessen' zu verwenden!\n\n"));
  find_object("/gilden/amazonen")->LearnSpell("aufspiessen", environment()); 
  remove();
}
