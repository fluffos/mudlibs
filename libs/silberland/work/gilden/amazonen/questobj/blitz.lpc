inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Blitz");
  SetProp(P_LONG, 
      "Ein gleissend greller Blitz, der so enorme Hitze ausstrahlt dass "
      "Du befuerchtest, Dich an ihm zu verbrennen. Der Blitz ist klein "
      "und wirkt irgendwie wie ein zackiger Lichtstrahl.");
  SetProp(P_NAME, "Blitz");
  SetProp(P_GENDER, MALE); 
  AddId( ({"blitz","QUEST-BLITZ"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, ([MAT_LIGHTNING:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
 
}  
 


