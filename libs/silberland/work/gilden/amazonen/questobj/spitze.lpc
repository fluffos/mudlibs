// Edynia - Questitem - Speerspitze


inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein silberne Speerspitze");
  SetProp(P_LONG, 
      "Eine glaenzende, silberne Speerspitze.");
  SetProp(P_NAME, "Speerspitze");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"speerspitze","spitze","QUEST-SPEERSPITZE"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME_ADJ, "silbern");
 
}  
 


