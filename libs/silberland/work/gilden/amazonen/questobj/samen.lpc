inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein paar Orchideensamen");
  SetProp(P_LONG, 
      "Ein paar kleine Samen einer Orchidee. Man koennte sie wo "
      "einpflanzen.");
  SetProp(P_NAME, "paar Orchideensamen");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"orchideensamen","samen","QUEST-SAMEN"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_PLURAL, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
 
 
}  
 


