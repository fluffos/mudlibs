// by Aaliyah
// Edynia - Questitem - Speer


inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Speer");
  SetProp(P_LONG, 
      "Dieser Speer wurde selbstgemacht. Zum Kaempfen eignet er sich nicht "
      "wirklich, viel zu locker sitzt die Speerspitze. Aber dennoch erfuellt "
      "er einen Nutzen.");
  SetProp(P_NAME, "Speer");
  SetProp(P_GENDER, MALE); 
  AddId( ({"speer","QUEST-SPEER"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:60, MAT_SILVER:30, MAT_LEATHER:10]) );

}  
 


