inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein bisschen rote Erde");
  SetProp(P_LONG, 
      "Ein bisschen rote Erde. Sie eignet sich perfekt zum Anpflanzen von "
      "Blumen.");
  SetProp(P_NAME, "bisschen rote Erde");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"erde","rote erde","QUEST-ERDE"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_PLURAL, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_EARTH:100]));
//  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);

   
}  
 


