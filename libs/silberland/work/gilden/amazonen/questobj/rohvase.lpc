inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Vase");
  SetProp(P_LONG, 
      "Diese Vase besteht aus Ton. Sie hat zwar eine huebsche Form, muesste "
      "aber noch in einem Ofen gebrannt werden.");
  SetProp(P_NAME, "Vase");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"vase","QUEST-ROHVASE"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, ([MAT_EARTH:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
  AddDetail( ({"form","glockenblume"}),
	"Die Vase hat die Form einer Glockenblume.");
}  
 


