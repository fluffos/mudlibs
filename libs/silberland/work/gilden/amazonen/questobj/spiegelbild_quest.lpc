#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO) )  return;

  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  AddId( ({"\namazonen_spiegelbild_quest"}) );
}

void fertig()
{
  if (explode(file_name(previous_object()),"#")[0] != 
      "/d/dschungel/dante/stein/npc/eben")
    return;
  call_out("spiegel", 2);
}

nosave void spiegel()
{
  tell_object(environment(),BS(
      "\nDurch Deinen Sieg gegen das Spiegelbild bist Du nun faehig, "
      "Dein eigenes Spiegelbild zu beschwoeren.\n\n"));
  find_object("/gilden/amazonen")->LearnSpell("spiegelbild", environment()); 
  remove();
}
