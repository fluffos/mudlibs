inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Stueck Draht");
  SetProp(P_LONG, 
      "Ein Stueck Draht, mit dem man wohl etwas basteln kann.");
  SetProp(P_NAME, "Stueck Draht");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"draht","stueck","stueck draht","QUEST-DRAHT"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_PLURAL, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_IRON:100]));
//  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);

   
}  
 


