void init()
{
  ::init();
  if (TP != TO && TP->QueryProp(P_GUILD) == GUILDNAME && 
      TP->QueryProp(P_GUILD_LEVEL) > random(10) )
    call_out("gruss",0);
}

void gruss()
{
  int zeit;
  object wea;

  if (present(TP, MENV))
  {
    if (IS_WIZARD(TP))
    {
      command("sag Welche Ehre, "+TPN+"!");
      if (member(GUILD_WIZARDS, getuid(TP)) != -1) 
        wizard(); 
    }
    else
    {
      switch( random(4) )
      {
        case 0: command("sag Willkommen, Amazone "+TPN+"!"); break;
        case 1: command("sag Was kann ich Dir beibringen, "+TPN+"?"); break;
        case 2: command("sag Willkommen, Schwester."); break;
        case 3: command("emote nickt Dir wohlwollend zu."); break;
      }
    }
  }
}

  
void amazonen_info() 
{
  mapping amazonen;
  string *names;
  string text;
  int i, level;
  mapping leveltxt;
  object ob;
   
  text="%s %s.";
  leveltxt = ([
      12: "ist eine Amazonenkoenigin und mir ebenbuertig", 
      11: "ist eine Legende unter den Amazonen", 
      10: "ist eine Amazonenprinzessin",
       9: "ist ein Amazonenheldin, ",
       8: "ist ein Offizierin",
       7: "ist ein Amazone der Gildenstufe 7", 
       6: "ist ein Amazone der Gildenstufe 6",
       5: "ist ein Amazone der Gildenstufe 5",
       4: "ist ein Amazone der Gildenstufe 4",
       3: "ist ein Amazone der Gildenstufe 3",
       2: "ist ein Amazone der Gildenstufe 2",
       ]);
  amazonen=call_other(AMASTER, "QueryAll");
  if (!sizeof(amazonen))
    return;
  names=m_indices(amazonen);
  if(!pointerp(names)) return;
  for(i=sizeof(names)-1;i>=0;i--) 
  {
    if(!IS_LEARNER(names[i]) && amazonen[names[i],0] > 4)
    {
      if (!GetInfo(names[i]))
      {
        AddInfo(({names[i]}), 
            sprintf(text, CAP(names[i]), leveltxt[amazonen[names[i],0]]),
            "sagt: ");
      }
    }
  }
}

string _query_kill_msg()
{
  object wer;
  int g;

  if (!objectp(wer = previous_object(2)))
    return "Du hast keine Chance gegen mich!";
  g = wer->QueryProp(P_GENDER) == FEMALE;
  switch(wer->QueryProp(P_GUILD))
  {
    case "amazonen": return "Ein gutes Duell, Schwester, aber Du musst noch "
                            "viel lernen."; 
    case "berserker": return "Ein Speer ist toedlicher als eine Axt, hast Du "
      "das jetzt verstanden, Du " + (g ? "Berserkerin" : "Berserker") + "!";
    case "druidenzirkel": return "Mich ohne Waffe besiegen zu wollen, das "
      "kann auch nur " + (g ? "einer Druidin" : "einem Druiden") + " einfallen!";
    case "paladin": return "Dich hinter Deinem Schild verstecken hat Dir "
      "auch nichts gebracht, Du " + (g ? "Paladinbraut" : "Paladin") + "!";
    case "nekromanten": return "Tot sein ist doch eh das schoenste fuer " +
      (g ? "eine Nekromantin" : "einen Nekromanten") + " wie Dich!";
    case "zechpreller": return "Geh lieber was trinken, Du Zechpreller" + 
                               (g ? "in" : "");
    case "dunkelelfen": return "Versteck Dich lieber in der Unterwelt, Du " + 
                               (g ? "Dunkelelfin" : "Dunkelelf") + "!";
    case "abenteurer": return "Mach besser Quests statt zu Kaempfen, Du " + 
                               (g ? "Abenteurerin" : "Abenteurer") + "!";
    default: return "Du hast keine Chance gegen mich!";
  }
}
 
string info_laune()
{
  return sprintf(
      "Du willst wissen wieso ich schlecht gelaunt bin? Ich kann Dir das "
      "schon sagen. Weil %s, dieses Miststueck, gestern Verrat begangen "
      "hat. Ich bin so wuetend. Meine Lieblingsvase habe ich auch schon vor "
      "lauter Wut zerschlagen. Das hat mir aber nicht Erleichterung gebracht, "
      "es macht mich nur noch wuetender. Es war doch schliesslich meine "
      "Lieblingsvase. Jetzt bin ich traurig _und_ wuetend.", traitor); 
}

string info_vase()
{
  return 
      "Wenn ich wieder so eine schoene Vase haette, haette ich sicher wieder "
      "bessere Laune.";
}

  string i_speer()

{ 
  object ob;

  int i,r;
  string ret;
  
  if (present("SPEERSTOSSOBJEKT", TP))
  return "Hoerst Du schlecht? Ich sagte Du sollst zu Xanthippe gehen.";

  ob = clone_object(OBJ "speerobjekt");

  ob->move(TP, M_NOCHECK);

  ret = "Fuer den zauber 'Speerstoss' musst Du eine kleine Aufgabe erfuellen. Darf ich Dich "
	 "dafuer auf Xanthippe verweisen? Ich habe keine Zeit. ";
  
 }
