void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, GUILD_NPC_SHORT);
  SetProp(P_LONG, 
    "Hippolyte ist eine grosse und majestaetische Erscheinung. Lange blonde "
    "Haare umrahmen ein ernstes, aber wunderschoenes Gesicht mit klaren "
    "hellblauen Augen und vollen roten Lippen. Ihr goldener Brustharnisch "
    "bringt ihre weiblichen Rundungen gut zur Geltung. Ein feuerroter "
    "Umhang umschmeichelt ihren schlanken, aber muskuloesen Koerper. "
    "Hippolyte ist von einer Aura von Macht umgeben, die Dich vor "
    "Ehrfurcht erschauern laesst.");
  SetProp(P_NAME, GUILD_NPC_NAME);
  SetProp(P_KILL_NAME, GUILD_NPC_SHORT);
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hippolyte", "koenigin", "amazone", "amazonenkoenigin", 
        GUILD_NPC_ID}) );
           
  SetProp(P_SMELL, "Hippolyte duftet wie frisch gebadet.\n");

  create_default_npc(50);
  SetProp(P_HANDS, ({" mit unglaublicher Amazonenkraft", 3000, DT_BLUDGEON}));
  SetProp(P_BODY, 345);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180+random(10) );
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 80);
  SetProp(P_HP_DELAY, 0);

  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_FIRE:      -0.7, DT_COLD:     -0.2, DT_WATER: -0.5, DT_AIR:    -0.3,
        DT_LIGHTNING: -0.9, DT_ELECTRIC: -0.5, DT_LIGHT: -0.5, DT_MAGIC:  -0.3,
        DT_ACID:      -0.5, DT_POISON:   -0.2, DT_MIND:  -0.7, DT_TERROR: -0.7,
        DT_EXPLOSION: -0.8, DT_UNHOLY:   -0.4, DT_HOLY:  -0.4, DT_SOUND:  -0.6,
        DT_SLASH:     -0.3, DT_BLUDGEON: -0.3, DT_RIP: -0.3, 
        DT_PIERCE:    -0.3, DT_SQUEEZE:  -0.3, DT_WHIP: -0.3,
        ]) );
  
  SetProp(P_GUILD, "amazonen");
  SetProp(P_GUILD_LEVEL, 12);
  call_other("/gilden/amazonen","learn_berserker_skills", 10000, 10000); 
  
  SetProp(P_MSGIN, "schreitet elegant herein");
  SetProp(P_MSGOUT, "schreitet elegant");
  SetProp(P_MMSGIN, "materialisiert sich");
  SetProp(P_MMSGOUT, "loest sich langsam auf und verschwindet");

  SetProp(P_DIE_MSG,  " stirbt einen Amazonentod.\n");

  AddInfo(DEFAULT_INFO, ({
    "laechelt Dich belustig an!\n",
    "sagt neugierig: Gibts das wirklich?\n",
    "sagt: Aha.\n",
    "fragt: Meinst Du das wirklich so?\n",
    "sagt: Nicht alles Wissen kann man durch Fragen erlangen!\n",
    "sagt: Frag doch eine Druidin!\n",
    "sagt: Frag doch einen Paladin!\n",
    "sagt: Frag doch einen Berserker!\n",
    "schaut Dich erstaunt an.\n",
    "sagt: Sowas ist nichts fuer eine echte Amazone!\n",
    "ignoriert Deine Frage.\n",
    "scheint Dich nicht verstanden zu haben.\n",
    "fragt: Warum fragst Du mich das?\n",
    "beachtet Dich und Deine sinnlosen Fragen gar nicht!\n",
    "ueberhoert Deine unschickliche Frage!\n",
    "laechelt Dich einfach nur an.\n",
    "fragt: Willst Du nicht lieber etwas ueber die Amazonen erfahren?\n"}) );


  AddInfo( ({"speerstoss"}), #'i_speer, "sagt: ");

   
  AddInfo( ({"aufgabe"}), 
    "Darf ich Dich auf Xanthippe verweisen? Sie wird Dir die Aufgabe "
    "fuer diese Gildenstufe geben.","sagt: ");

  AddInfo( ({"xanthippe","schmiedin"}), 
    "Xanthippe ist unsere Schmiedin. Eine nette Person!","sagt: ");
 

  AddLibrary(NPC "infos.lib", 2);
  AddLibrary(AMAZONEN "libs/hippolyte.lib", 5);
  AddLibrary( "/d/dschungel/feyaria/tijara/npc/spieler.lib",1); 
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"skills","faehigkeiten", "fertigkeiten"}), #'faehigkeiten, 1);
  AddInfo( ({"lerne", "lernen", "lern"}), #'lernen, 1);
//  AddInfo( ({"stufe 9", "stufe neun", "gildenstufe 9"}), #'stufe9 ); 
//  AddInfo( ({"stufe 10", "stufe zehn", "gildenstufe 10"}), #'stufe10 ); 

// Quests
  AddInfo( ({"laune"}), #'info_laune, "sagt: ");
  AddInfo( ({"silvie", "verraeterin"}),
      "Wenn ich dich in die Finger kriege, Verraeterin!", "bruellt wuetend: ");
  AddInfo( ({"vase", "lieblingsvase"}), #'info_vase, "sagt: ");
  AddInfo( ({"blume", "blumen"}), "Ich liebe die weissen Lilien, die hier "
      "in Edynia wachsen.", "sagt: ");
  
  SetProp(P_LOG_INFO, "feyaria/hippolyte");  

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER) + " bedankt sich fuer das Geschenk.\n" }) );

  SetChats(2, ({
    Name(WER) + " sagt: Die Amazonengilde ist die beste aller Gilden!\n",
    Name(WER) + " streicht sich eine Haarstraehne aus ihrem Gesicht.\n",
    Name(WER) + " laechelt Dich an.\n",
    Name(WESSEN) + " majestaetische Erscheinung laesst Dich vor Ehrfurcht erschaudern.\n",
    Name(WER) + " rueckt ihre Ruestung gerade.\n",
    Name(WER) + " schaut einfach umwerfend aus.\n",
    Name(WER) + " mustert Dich mit einem majestaetischen Blick.\n",
    Name(WER) + " schaut Dich wohlwollend an.\n"}) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(2,2000,
      Name(WER,1) + " sticht Dir mit ihrer Lanze ins Herz.\n",
      Name(WER,1) + " sticht @WEM mit ihrer Lanze ins Herz.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE: 1]) );
  AddSpell(1,2500,
      Name(WER,1) + " laesst einen gewaltigen Blitz auf Dich niedersausen.\n",
      Name(WER,1) + " laesst einen gewaltigen Blitz auf @WEN niedersausen.\n",
      DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]) );
  AddDefaultSpell(1,1500, DS_MASS_DAMAGE,
      Name(WER,1) + " wirbelt ihre Lanze herum und trifft Dich.\n",
      Name(WER,1) + " wirbelt ihre Lanze herum und trifft Dich.\n",
      DT_PIERCE);
  
  SUID;
  CLONEME(WEAPON "koeniginnenlanze");
  command("zuecke lanze");
  CLONEME(ARMOUR "sandalen");
  CLONEME(ARMOUR "beinschienen");
  CLONEME(ARMOUR "waffengurt");
  CLONEME(ARMOUR "off_umhang");
  CLONEME(ARMOUR "armschienen");
  CLONEME(ARMOUR "brustharnisch");
  CLONEME(ARMOUR "guilditem");
  command("trage alles");
  call_out("amazonen_info", 10);
}


int Defend(int dam, mixed dtype, int spell, object enemy)
{
  if (!query_once_interactive(enemy))
  {
    enemy->remove();
    return 0;
  }
  if (!random(5) && !enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1 + random(2));
  else if (!random(5) && !enemy->QueryProp(P_DISABLE_SPELLS))
    enemy->SetProp(P_DISABLE_SPELLS, 1 + random(2));
  if (time() - (enemy->QueryProp(P_LAST_MOVE)) <= 6)
    dam /= 5;
  else if (dam > 900) 
    dam = 900;
  return ::Defend(dam, dtype, spell, enemy);
}


void heart_beat()
{
  int i;
  object *enemies;

  ::heart_beat();
  if(InFight() && !random(4) && sizeof(enemies = PresentEnemies()) >= 3)
  {
    tell_room(environment(this_object()),
        Name(WER) + " wirbelt ihre Lanze im Kreis!\n");
    for(i = sizeof(enemies) - 1; i >= 0; i--)
    {
      enemies[i]->SetProp(P_PARALYZED, 1 + random(2));
      enemies[i]->Defend(500 + random(500), DT_PIERCE, 
          ([SP_NAME:"rundumschlag", SP_SHOW_DAMAGE:1, SP_PHYSICAL_ATTACK:1]), 
          this_object());
    }
  }
}


void reset()
{
  object ob;

  ::reset();
  if( !is_clone(TO) ) return; 
  if( !random(10) )
    call_out("amazonen_info", 10);
  heal_self(3000);
}


// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  WLOG( LOG "Hippolyte", " schafft das unmoegliche und killt Hippolyte");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer== ME )
  write_file( LOG "Hippolyte" , dtime(time()) + " "+ 
    player->Name()+" stirbt den Heldentod. ( -"+ lostexp+" XP )\n");
}


string faehigkeiten()
{
  call_other(MENV, "faehigkeiten");
  return "";
}

string lernen()
{
  call_other(MENV, "lernen");
  return "";
}
 

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( member(GUILD_WIZARDS, getuid(TP)) != -1)
  {
    if( random(2) ) call_out("wizard",0);
    return;
  }
  if ((gruppe=="nett" || gruppe=="intim") && 
      find_call_out("gut")==-1) 
    call_out("gut",0);
  else if ((gruppe=="fies" || gruppe=="frech") && 
      find_call_out("boese")==-1)
    call_out("boese",0);
  else if ((gruppe=="traurig" || gruppe=="aengstlich" || gruppe=="aergerlich")
      && find_call_out("troesten")==-1 )
    call_out("troesten",0);
  else if ((gruppe=="froh" || gruppe=="albern" || gruppe=="neutral") && 
      find_call_out("lustig")==-1)
    call_out("lustig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void wizard()
{
  switch( random(2) ){
    case 0: command_me("emote verneigt sich ehrfuerchtig vor "+TPN+".");
            break;
    case 1: command_me("laechelt "+TPN+" an.\n");
            break;
  }
}

void gut()
{
  string *guttext;
  if( TP->QueryProp(P_GENDER) == FEMALE)
  {
    switch( random(3) )
    {
      case 0: tell_object(TP, Name(WER) + " laechelt Dich an.\n");
              tell_room(MENV, Name(WER) + " laechelt "+TPN+" an.\n", ({TP}) );
              break;
      case 1: tell_object(TP, Name(WER) + " knuddelt Dich.\n");
              tell_room(MENV, Name(WER) + " knuddelt "+TPN+".\n", ({TP}) );
              break;
      case 2: tell_object(TP, Name(WER) + " umarmt Dich.\n");
              tell_room(MENV, Name(WER) + " umarmt "+TPN+".\n", ({TP}) );
              break;
    }
    return;
  }
  switch (random(4))
  {
    case 0: command("emote sagt empoert: Hoer auf, mich zu belaestigen, " + TPN + "!");
            break;
    case 1: command("emote sagt veraergert: Ich mag das nicht, " + TPN + "!");
            break;
    case 2: command("emote schimpft: Was erlaubst Du Dir eigentlich " + TPN + "?!");
            break;
  }
}

void boese()
{
  string *boestext;
  boestext=({ "sagt veraergert: Das merk ich mir, %s!", 
              "sagt entruestet: Wo sind Deine Manieren, %s?",
              "sagt kalt: Ich lass mich nicht von Dir provozieren, %s!",
              "sagt wuetend: Willst Du, dass ich Dich zerschmettere, %s?"});
  command("emote " + sprintf(boestext[random(sizeof(boestext))], TPN));
}

void lustig()
{
  if( TP->QueryProp(P_GENDER) == FEMALE)
  {
    switch( random(3) )
    {
      case 0: tell_object(TP, Name(WER) + " grinst Dich an.\n");
              tell_room(MENV, Name(WER) + " grinst "+TPN+" an.\n", ({TP}) );
              break;
      case 1: tell_object(TP, Name(WER) + " knuddelt Dich.\n");
              tell_room(MENV, Name(WER) + " knuddelt "+TPN+".\n", ({TP}) );
              break;
      case 2: tell_object(TP, Name(WER) + " zwinkert Dir zu.\n");
              tell_room(MENV, Name(WER) + " zwinkert "+TPN+" zu.\n", ({TP}) );
              break;
    }
  }
  else
  {
    switch( random(3) )
    {
      case 0: tell_object(TP, Name(WER) + " lacht Dich aus.\n");
              tell_room(MENV, Name(WER) + " lacht "+TPN+" aus.\n", ({TP}) );
              break;
      case 1: tell_object(TP, Name(WER) + " ignoriert Dich.\n");
              tell_room(MENV, Name(WER) + " ignoriert "+TPN+".\n", ({TP}) );
              break;
      case 2: tell_object(TP, Name(WER) + " funkelt Dich boese an.\n");
              tell_room(MENV, Name(WER) + " funkelt "+TPN+" boese an.\n", ({TP}) );
              break;
    }
  }
}

void troesten()
{
  if( TP->QueryProp(P_GENDER) == FEMALE)
  {
    tell_object(TP, Name(WER) + " troestet Dich.\n");
    tell_room(MENV, Name(WER) + " troestet "+TPN+".\n", ({TP}) );
  }
  else
    command(({"sag Du Heulsuse!", 
          "emote lacht nur.",
          "sag Du Schwaechling!", 
          "sag Pff! Typisch Mann!"})[random(3)]);
}

void antwort(object pl,string ret)
{
  tell_object(pl,ret);
}

void catch_tell(string str)
{
  object pl, ob;
  string ret,ret2;

  if (!str) return;
  if (!pl=find_player(lower_case(explode(str," ")[0])) ) return;
  if (pl->QueryProp(P_GUILD)!="amazonen" ) return;
  if ((strstr(str, "teilt Dir mit: ") != -1) && 
      ( strstr(str, "erhoehen") != -1 || strstr(str, "erhoehe") != -1 || strstr(str, "anforderungen") != -1 ))
  {
    ret = call_other("/gilden/amazonen", "check_advance", pl);
    if (!ret) {
        ret="Hippolyte teilt Dir mit: Komm sofort her und erhoehe Deine Stufe!\n";
    }
    tell_object(pl, break_string(ret, 78, "Hippolyte teilt Dir mit: "));
  }
  if( strstr(str, "teilt Dir mit: ") != -1 && strstr(str, "amulett") != -1 )
  {
    if( ob = present(GUILD_ITEM, pl) )
      ob->remove(1);
    CLONE( ARMOUR "guilditem", pl );
  }
}


varargs void
ModifySkillAttribute(object caster, string atrname, int value, int duration,
                         mixed fun) 
{
  if (previous_object() && previous_object()!=this_object() && 
      getuid(previous_object())!="GUILD.amazonen")
    return;
  ::ModifySkillAttribute(caster, atrname, value, duration, fun);
}
