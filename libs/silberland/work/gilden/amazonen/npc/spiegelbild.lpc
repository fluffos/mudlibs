#include "../def.h"
#include <npcmaster.h>

inherit "/std/npc";

object caster;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_GENDER, NEUTER);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_FRIEND, 1);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_HP_DELAY, 10000);
  SetProp(P_DIE_MSG, " zerfaellt in kleine Splitter.\n");
  SetProp(P_TEMPERATURE_RANGE, ([0:-100, 1: 100]) );
  AddId( ({"spiegelbild", "NOT_LIVING", "SKILL_NOLEARN", "NOCONTROL", 
        "NOWIMPY"}) );
}

void set_variables(object _caster, int suc)
{
  int glevel;

  caster = _caster;
  glevel = caster->QueryProp(P_GUILD_LEVEL);

  create_default_npc(glevel * 2);
  SetProp(P_XP, 0);
  SetProp(P_BODY, suc / 100 + glevel * 5);
  SetProp(P_MAX_HP, caster->QueryProp(P_HP) + suc / 50 + glevel * 10);

  SetProp(P_NAME, caster->Name(WESSEN, 1) + " Spiegelbild");
  SetProp(P_LONG, caster->long());
  SetProp(P_SHORT, (caster->short() || "Ein Spiegelbild.\n")[0..<3]);
  SetProp(P_RACE, caster->QueryProp(P_RACE));
  AddId( ({lower_case(QueryProp(P_NAME))}) );
  call_out("die", 30 + suc/300);
}

void init()
{
  ::init();
  if (objectp(caster) && interactive(caster))
    caster->AddDefender(this_object());
}

void InformDefend(object enemy)
{
  enemy->Kill(this_object());
}

void Attack(object enemy)
{
  return;
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  return ::Defend(2 * dam, dam_type_list, spell, enemy);
}

