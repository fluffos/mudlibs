inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>

#define SHADOW "/std/player/shadows/amazonenpferd"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp(P_SHORT, "Ein Pferd");
  SetProp(P_LONG, 
      "Ein Pferd. Du kannst auf ihm reiten.");
  SetProp(P_NAME, "Pferd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nshadowpferd"}) );
  
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Hufen", 200, DT_BLUDGEON}) );
  SetProp(P_ALIGN, 100);
  SetProp(P_SIZE, 170);
  SetProp(P_FRIEND, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_NOATTACK, "schnaubt nur.");

  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MSGIN, "trabt herein");

  SetChats(1, ({
    "Das Pferd knabbert ein wenig an Deinem Ohr. Wie das kitzelt!\n",
    "Das Pferd wiehert leise.\n",
    "Das Pferd stupst Dich mit seiner Nase sanft an.\n",
    "Das Pferd blickt Dich mit seinen nussbraunen Augen treuherzig an.\n",
    "Das Pferd schnaubt ein wenig.\n"
  }) );

  SetProp (P_DIE_MSG, "wiehert noch ein letztes Mal.\n" );
  SetProp (P_DEFAULT_INFO, ({
      "schaut Dich fragend an.\n",
      "schuettelt sich.\n",
      "stupst Dich mit seiner Nase an.\n" }) );

  AddCmd( ({"reite", "reit"}), "cmd_reiten");
}

int cmd_reiten(string str)
{
  string wem;
  notify_fail("Auf wem willst Du reiten?\n");
  if (sscanf(str, "auf %s", wem) == 1)
    str = wem;
  if (!str || !id(str)) return 0;

  if (environment(this_player())->QueryProp(P_INDOORS))
  {
    write("Du kannst nur im Freien reiten!\n");
    return 1;
  }
  write("Du schwingst Dich in den Sattel.\n");
  tell_room(environment(this_player()), break_string(
      this_player()->Name() + " schwingt sich in den Sattel und reitet nun "
      "auf " + name(WEM) + ".", 78) );
  clone_object(SHADOW);
  remove();
  return 1;
}

