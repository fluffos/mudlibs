inherit "/std/mnpc";
inherit "/std/npc/spells";

#include "../def.h"
#include <mnpc.h>
#include "namen.h"

void create()
{
  string  *namen;
  string race;
  int off;

  if (!is_clone(this_object())) return;

  ::create();

  namen = NAMEN;
  SetProp(P_NAME, namen[random(sizeof(namen))]);
  SetProp(P_GENDER, FEMALE);
  switch (random(80))
  {
    case 0..9: 
      SetProp(P_RACE, "Elf");
      SetProp(P_ALIGN, 300);
      SetProp(P_SIZE, 195);
      race = "Elfe";
      break;
    case 10..19: 
      SetProp(P_RACE, "Mensch");
      SetProp(P_ALIGN, 100);
      SetProp(P_SIZE, 170);
      race = "Menschenfrau";
      break;
    case 20..29: 
      SetProp(P_RACE, "DunkelElf");
      SetProp(P_ALIGN, -300);
      SetProp(P_SIZE, 185);
      race = "Dunkelelfe";
      break;
    case 30..39: 
      SetProp(P_RACE, "Hobbit");
      SetProp(P_ALIGN, 50);
      SetProp(P_SIZE, 90);
      race = "Hobbitfrau";
      break;
    case 40..49: 
      SetProp(P_RACE, "Zwerg");
      SetProp(P_ALIGN, 200);
      SetProp(P_SIZE, 120);
      race = "Zwergin";
      break;
    case 50..59: 
      SetProp(P_RACE, "Fee");
      SetProp(P_ALIGN, 700);
      SetProp(P_SIZE, 50);
      race = "Fee";
      break;
    case 60..69: 
      SetProp(P_RACE, "Troll");
      SetProp(P_ALIGN, -100);
      SetProp(P_SIZE, 350);
      race = "Trollfrau";
      break;
    case 70..79: 
      SetProp(P_RACE, "Oger");
      SetProp(P_ALIGN, -200);
      SetProp(P_SIZE, 250);
      race = "Ogerfrau";
      break;
  }
  off = !random(10);
  AddId ( ({"amazone", "Speerkaempfer", lower_case(QueryProp(P_NAME))}) );

  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, QueryProp(P_NAME) + ", die Amazone");
  SetProp(P_LONG, 
      "Das ist " + QueryProp(P_NAME) + ", die Amazone. " + 
      "Sie ist gross gewachsen, schlank und muskuloes, zumindest fuer eine " + 
      race + ". "
      "Sie traegt die uebliche Ruestung der Amazonen und schaut Dich mit "
      "strahlenden Augen an." +
      (off ? " An ihrem praechtigen Umhang und dem Federbusch am Helm "
       "erkennst Du sofort, dass es sich hier um eine Offizierin handelt." : ""));

  create_default_npc(20 + off * 10);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({"mit ihren Haenden", 190, DT_BLUDGEON}) );
  SetProp(P_GUILD, GUILDNAME);
  SetProp(P_GUILD_LEVEL, (off ? 8 + random(2) : 2 + random(6)));

  SetProp(P_MSGIN, "kommt wachsam an");
  SetProp(P_MSGOUT, "geht wachsam");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, GUILD);
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG, " stirbt einen Amazonentod.\n");

  SetProp(P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" sagt: Ich bin nicht bestechlich!\n" }) );

  SetProp(P_LOG_INFO,"feyaria/amazonen");
  AddInfo( DEFAULT_INFO, ({
    "sagt: Was willst Du?\n" }) );

  SetProp(P_NOMAGIC, 10 + 20 * off);
  SetProp(P_SPELLRATE, 30 + 20 * off);
  AddSpell( 1, 700 + 500 * off,
    Name(WER,1)+" sticht Dich mit ihrem Speer.\n",
    Name(WER,1)+" sticht @WEN mit ihrem Speer.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]) );
 
  SUID;

  if (off)
    CLONEME(WEAPON "off_speer");
  else
    CLONEME(WEAPON "amazonenspeer");
  command("zuecke speer");
  if (random(2))
    CLONEME(ARMOUR "rundschild");
  CLONEME(ARMOUR "sandalen");
  if (random(2))
    CLONEME(ARMOUR "beinschienen");
  else
    CLONEME(ARMOUR "beinschienen");
  if (random(2))
    CLONEME(ARMOUR "waffengurt");
  if (off)
    CLONEME(ARMOUR "off_umhang");
  if (random(2))
    CLONEME(ARMOUR "umhang");
  if (random(2))
    CLONEME(ARMOUR "armschienen");
  if (random(2))
    CLONEME(ARMOUR "handgelenksmanschetten");
  CLONEME(ARMOUR "brustharnisch");
  if (off)
    CLONEME(ARMOUR "helm3");
  if (random(2))
    CLONEME(ARMOUR "helm");
  CLONEME(ARMOUR "guilditem");
  command( "trage alles" );
}
/*
