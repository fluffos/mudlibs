#include "../def.h"
#include <npcmaster.h>

inherit "/std/npc";

object caster;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
}

int move_and_wear(object ob)
{
  ob->move(this_object(), M_NOCHECK);
  if (ob->QueryProp(P_WEAPON_TYPE))
    command("zuecke " + ob->QueryProp(P_IDS)[0]);
}

void set_variables(object _caster, object victim, int suc)
{
  string *not_set;
  mapping properties;
  mixed *ind, *val;
  int i;

  caster = _caster;
  not_set = ({"clone_time","commands","cloner","last_combat_time",
      "armours","last_move", "weapon", });
  properties = victim->__query_properties(victim,0) [0];
  ind = m_indices(properties);
  val = m_values(properties);
  for (i = sizeof(ind) - 1; i >= 0; i--) 
  {
    if (member(not_set, ind[i]) == -1) 
      SetProp(ind[i], val[i]);
  }
  if (sizeof(all_inventory(victim)))
    filter_array(all_inventory(victim), "move_and_wear");
  command("trage alles");

  SetProp(P_LONG, QueryProp(P_LONG) + sprintf("Er folgt %s und wird sie mit "
        "seinem Leben beschuetzen.\n", caster->name(WEM,1)));
  SetProp(P_FRIEND, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_XP, 0);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_MSGOUT, "folgt " + caster->name(WEM));
  SetProp(P_MMSGOUT, "folgt " + caster->name(WEM));
  caster->AddPursuer(this_object());
  call_out("die", 300 + suc/30);
}

void init()
{
  ::init();
  if (objectp(caster) && interactive(caster))
    caster->AddDefender(this_object());
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void die(int poisondeath)
{
  int xp;

  xp = QueryProp(P_XP) / 100;
  if (objectp(caster))
  caster->AddExp((XP_RATIO + caster->QueryProp(P_GUILD_LEVEL)) * xp);
  ::die(poisondeath);
}

