// Amazonenfestung
// 20-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In der Amazonenfestung" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich in der Amazonenfestung. Im "+CAP(DIR5)+" befindet sich "
    "eine steile Stiege, die auf den Wachgang fuehrt. Im "+CAP(DIR1)+
    "kommt man auf den Hof zurueck. Im "+CAP(DIR7)+" ist der Eingang zur "
    "gemuetlichen Amazonenkneipe.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Sorry, gibt noch keine Details!");
  
  AddExit( DIR5O, "./wach_s" );
  AddExit( DIR1, "./hof2" );
  AddExit( DIR7, "./kneipe" );


}
