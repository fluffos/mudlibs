// Amazonenfestung
// 20-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Vor der Amazonenfestung" );
  SetProp(P_INT_LONG, 
    "Du stehst vor der Amazonenfestung. Im "+CAP(DIR3)+" siehst Du ein "
    "gewaltiges Tor. Es ist die einzige Moeglichkeit, in die "
    "Amazonenfestung zu kommen, denn die hohe Festungsmauer scheint "
    "nicht erkletterbar zu sein.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Sorry, gibt noch keine Details!");
  
  AddExit( DIR3, "./tor" );
  AddExit( DIR7, "./weg" );

}
