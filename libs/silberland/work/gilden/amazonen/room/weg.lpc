#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf dem Weg zur Amazonenfestung" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Weg zur Amazonenfestung.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Sorry, gibt noch keine Details!");
  
  AddExit( "gilde", "in die Abenteurergilde#/gilden/abenteurer" );
  AddExit( DIR3, "./eingang" );

}
