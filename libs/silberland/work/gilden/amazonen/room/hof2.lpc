// Amazonenfestung
// 20-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf dem Hof der Amazonenfestung" );
  SetProp(P_INT_LONG, 
    "Du stehst mitten im Hof der Amazonenfestung. Im "+CAP(DIR3)+
    "ist der Eingang zum Palast der Amazonenkoenigin, der Hof erstreckt "
    "sich in alle anderen Richtungen.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Sorry, gibt noch keine Details!");
  
  AddExit( DIR1, "./stiege1" );
  AddExit( DIR3, "./palast" );
  AddExit( DIR5, "./stiege2" );
  AddExit( DIR7, "./hof1" );

}
