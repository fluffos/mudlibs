// Amazonenfestung
// 20-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Im Palast der Amazonenkoenigin" );
  SetProp(P_INT_LONG, 
    "Du stehst im Palast der Amazonenkoenigin. Im "+CAP(DIR5)+" ist das "
    "Empfangszimmer der Koenigin. Im "+CAP(DIR7)+" geht es auf den Hof "
    "hinaus.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Sorry, gibt noch keine Details!");
  
  AddExit( DIR7, "./hof2" );
  AddExit( DIR5, "/gilden/amazonen" );

}
