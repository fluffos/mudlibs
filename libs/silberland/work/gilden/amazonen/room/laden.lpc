// Amazonenfestung
// 20-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "/std/laden";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Im Laden der Amazonenfestung" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Laden der Amazonenfestung. Hinter einer massiven "
    "Holztheke werden Speere, Schilde und Ruestungsteile angeboten, wie sie "
    "die Amazonen im Alltag und im Kampf verwenden. An den Waenden stehen "
    "Regale und Gestelle mit Waren, sorgfaeltig geordnet nach Groesse und "
    "Zustand. Eine Tafel mit eingeritzten Zeilen haengt gut sichtbar neben "
    "der Theke und nennt die Regeln des Handels. Der Geruch von geoeltem "
    "Leder und Metall liegt in der Luft.\n"
    "Nach Westen gelangst Du zurueck in die Waffenkammer.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetStorageRoom(ROOM "lagerraum");
  RemoveFixedObject();

  AddDetail( ({"laden","raum"}), QueryProp(P_INT_LONG));
  AddDetail( ({"theke","holztheke","tresen","holz","kerben","kratzer",
      "lederriemen"}),
      "Die Theke ist aus dunklem, dickem Holz gefertigt und voller "
      "Kerben und Kratzer. Auf ihr liegen ein paar Lederriemen, eine "
      "Waage und ein aufgeschlagenes Buch fuer Notizen.");
  AddDetail( ({"waage"}),
      "Eine robuste Waage, mit der Waren abgeschaetzt und abgewogen werden "
      "koennen.");
  AddDetail( ({"buch","notizbuch","buches","buchs","listen","notizen",
      "kaeufe","verkaeufe","bestellungen"}),
      "In dem Buch werden Kaeufe, Verkaeufe und Bestellungen vermerkt.");
  AddDetail( ({"tafel","schild","regeln","zeilen","handel","handels"}),
      "In die Tafel sind einfache Regeln geritzt: Fairer Handel, keine "
      "gezueckten Waffen, und wer zu laut wird, wird hinauskomplimentiert.");
  AddDetail( ({"regale","gestelle","waren","ausruestung","speer","speere",
      "schild","schilde","ruestung","ruestungen","helm","helme","waffen",
      "ruestungsteile","wurfspeer","wurfspeere","groesse","zustand"}),
      "In den Regalen liegen Speere, Wurfspeere und einfache Schilde; an den "
      "Gestellen haengen Helme und Ruestungsteile. Alles wirkt gebraucht, "
      "aber gut gepflegt.");
  AddDetail( ({"wand","waende","trophaeen","bannerschnipsel"}),
      "An den Waenden stehen Regale und Gestelle; dazwischen haengen ein "
      "paar Trophaeen und alte Bannerschnipsel.");
  AddDetail( ({"boden","stiefeln","stiefel"}),
      "Der Boden ist sauber, aber von vielen Stiefeln blank getreten.");
  AddDetail( ({"decke","ladenhelligkeit"}),
      "Die Decke ist schlicht gehalten, damit der Ladenhelligkeit nichts im "
      "Weg steht.");
  AddDetail( ({"amazonen","amazonenfestung","alltag","kampf","dinge","zierrat"}),
      "Hier werden die Dinge gehandelt, die die Amazonen in ihrem Alltag "
      "tragen und im Kampf brauchen: solide Ausruestung statt Zierrat.");
  AddDetail( ({"geruch","luft","hauch","leder","metall","wachs"}),
      "Die Luft ist geschwaengert vom Geruch geoelten Leders, kalten "
      "Metalls und einem Hauch Wachs.");
  AddDetail( ({"klirren","rascheln","geraeusch","geraeusche","ladenbetrieb",
      "ohren"}),
      "Aus dem Ladenbetrieb bleiben das leise Klirren von Metall und das "
      "Rascheln von Leder in Deinen Ohren.");
  AddDetail( ({"waffenkammer","weg","westen"}),
      "Der Weg nach Westen fuehrt zurueck in die Waffenkammer.");

  AddSmell(DEFAULT_SMELL,
      "Du riechst geoeltes Leder, Metall und einen Hauch von Wachs.");
  AddSound(DEFAULT_SOUND,
      "Du hoerst das leise Klirren von Metall und das Rascheln von Leder.");
  
  AddExit( "westen", "/d/wasser/aaliyah/edynia/room/waffen" );

}
