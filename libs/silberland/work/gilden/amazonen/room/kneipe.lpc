#include "../def.h"

inherit "/std/pub";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In der Amazonenkneipe" );
  SetProp(P_INT_LONG, 
    "Du stehst in der Kneipe der Amazonenfestung.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Sorry, gibt noch keine Details!");
  
  AddExit( DIR3, "./stiege2" );

}
