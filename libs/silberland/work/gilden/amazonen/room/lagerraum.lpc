   AddItem( WEAPON "wurfspeer", REFRESH_REMOVE);
  AddItem( WEAPON "wurfspeer", REFRESH_REMOVE);
  AddItem( WEAPON "wurfspeer", REFRESH_REMOVE);
  AddItem( WEAPON "amazonenspeer", REFRESH_REMOVE);
  AddItem( ARMOUR "helm", REFRESH_REMOVE);
  AddItem( ARMOUR "rock", REFRESH_REMOVE);
  AddItem( ARMOUR "umhang", REFRESH_REMOVE);
  AddItem( ARMOUR "rundschild", REFRESH_REMOVE);
  AddItem( ARMOUR "brustharnisch", REFRESH_REMOVE);
  AddItem( ARMOUR "speerkoecher", REFRESH_REMOVE);
