// Amazonenfestung
// 20-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In der Amazonenfestung" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich in der Amazonenfestung. Im "+CAP(DIR1)+" befindet sich "
    "eine steile Stiege, die auf den Wachgang fuehrt. Im "+CAP(DIR5)+
    "kommt man auf den Hof zurueck. Im "+CAP(DIR3)+" ist eine grosse "
    "Schmiede und im "+CAP(DIR7)+" ein Laden.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Sorry, gibt noch keine Details!");
  
  AddExit( DIR1O, "./wach_n" );
  AddExit( DIR3, "./schmiede" );
  AddExit( DIR5, "./hof2" );
  AddExit( DIR7, "./laden" );

}
