// Amazonenfestung
// 20-10-2000 Feyaria@SilberLand

#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf dem Hof der Amazonenfestung" );
  SetProp(P_INT_LONG, 
    "Du stehst auf dem Hof der Amazonenfestung. Im "+CAP(DIR7)+" befindet "
    "sich das grosse Eingangstor. Im "+CAP(DIR3)+" kommt man zur "
    "Hofmitte.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Sorry, gibt noch keine Details!");
  
  AddExit( DIR7, "./tor" );
  AddExit( DIR3, "./hof2" );

}
