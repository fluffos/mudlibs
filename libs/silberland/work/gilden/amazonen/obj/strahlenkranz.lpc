// Strahlenkranz der Amazonen

inherit "std/thing";
#include "../def.h"

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"strahlenkranz", STRAHLENKRANZ}));
  SetProp(P_SHORT, 0); 
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_INVIS, 1);

  if (getuid(previous_object()) != SPELL_UID)
    call_out("remove", 1);
}

void init()
{
  ::init();
  if (!TO || !MENV || MENV->QueryProp(P_GUILD) != GUILDNAME)
    call_out("remove",0);
}

string extra_look() 
{
  object player;
  if (!player = environment()) return "";
  if (player->QueryProp(P_GENDER) == FEMALE)
    return "Ihrem Haupt ist von einem hellen Strahlenkranz umgeben.\n";
  else 
    return "Sein Haupt ist von einem hellen Strahlenkranz umgeben.\n";
}

int start_remove(int time) 
{
  call_out("remove", time);
  return 1;
}

varargs int remove(int silent) 
{
  object player, ob;
  if (player = environment()) 
  {
    if (!silent)
      tell_object(player, "Dein Strahlenkranz verblasst.\n");
    player->RemoveResistanceModifier();
    if ((ob = environment(player)) && !silent)
      ob->Message(sprintf("Der Strahlenkranz von %s verblasst.\n",
            player->name(WEM)), MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({player}) ]) );
    if(player->QueryProp(P_RACE) == "Dunkelelf") {
      player->SetProp("darkelf_light_adapted", 0);
    }
    if (ob = present(GUILD_ITEM, player))
      ob->UnregisterEffect(STRAHLENKRANZ);
  }
  return ::remove(silent);
}

void setup(object caster, float res)
{
  object ob;
  caster->AddResistanceModifier( ([DT_LIGHT: res, DT_FIRE: 2 * res / 3]) );
  if(caster->QueryProp(P_RACE) == "Dunkelelf") {
    caster->SetProp("darkelf_light_adapted", 1);
    tell_object(caster, BS("Durch den Strahlenkranz kannst du dich nun auch im hellen Licht wohl fuehlen."));
  }
  if (ob = present(GUILD_ITEM, caster))
    ob->RegisterEffect();
}

