// Schnelligkeit der Amazonen

inherit "std/thing";
#include "../def.h"

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"\nspeed", AMAZON_SPEED, "DEX_BUFF"}));
  SetProp(P_SHORT, 0); 
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_INVIS, 1);

  if (getuid(previous_object()) != SPELL_UID)
    call_out("remove", 1);
}

void init()
{
  ::init();
  if (!TO || !MENV || MENV->QueryProp(P_GUILD) != GUILDNAME)
    call_out("remove",0);
}

string extra_look() 
{
  object player;
  if (!player = environment()) return "";
  if (player->QueryProp(P_GENDER) == FEMALE)
    return "Sie bewegt sich mit unglaublicher Schnelligkeit und Anmut.\n";
  else 
    return "Er bewegt sich mit unglaublicher Schnelligkeit und Anmut.\n";
}

int start_remove(int time) 
{
  call_out("remove", time);
  return 1;
}

varargs int remove(int silent) 
{
  object player, ob;
  if (player = environment()) 
  {
    if (!silent)
      tell_object(player, "Deine Schnelligkeit laesst nach.\n");
    SetProp(P_X_ATTR_MOD, 0);
    player->UpdateAttributes();
    if ((ob = environment(player)) && !silent)
      ob->Message(sprintf("%s bewegt sich nun wieder langsamer.\n",
            player->Name(WER)), MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({player}) ]) );
    if (ob = present(GUILD_ITEM, player))
      ob->UnregisterEffect(AMAZON_SPEED);
  }
  return ::remove(silent);
}

void setup(object player, int dex, int speed, int dur)
{
  object ob;
  SetProp(P_X_ATTR_MOD, ([A_DEX: dex]));
  player->UpdateAttributes();
  player->ModifySkillAttribute(player, SA_SPEED, speed, dur);
  start_remove(dur);
  if (ob = present(GUILD_ITEM, player))
    ob->RegisterEffect();
}

