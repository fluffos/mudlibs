#include <properties.h>
#include <moving.h>

#define PFERD "/gilden/amazonen/npc/pferd.lpc"

inherit "std/thing";

nosave object pl;

void create()
{
  ::create();
  SetProp( P_SHORT, 0 );
  SetProp( P_NAME, "Pferdhook" );
  SetProp( P_NODROP, 1 );
  if( !is_clone(this_object()) ) return;
  move_object(this_object(),this_player());
  pl = this_player();
}

id() { return 0; }

void init()
{
  ::init();
  add_action( "steigen", "steig", 1 );
  add_action( "reite", "reite" );
}

string extra_look()
{
  return capitalize(pl->QueryPronoun(WER))+" sitzt auf einem Pferd.\n";
}

int steigen( string str )
{
  string arg;

  if( pl!=this_player() ) return 0;
  if( !pl->QueryReiter() )
  {
    destruct(this_object());
    return 0;
  }
  if( !str || ( 
        sscanf( str, "von %s", arg ) != 1 && sscanf( str, "vom %s", arg ) != 1 )
    )
  {
    if( str != "ab" )
      return 0;
  }
  else
  {
    str = arg;
    if( sscanf( str, "%s ab", arg ) == 1
        || sscanf( str, "%s herunter", arg ) == 1
        || sscanf( str, "%s runter", arg ) == 1 )
      str = arg;
    if( str != "pferd" ) return 0;
  }
  clone_object(PFERD)->move(environment(this_player()),M_SILENT|M_GO);
  say( capitalize(this_player()->name(WER))+" steigt vom Pferd herunter.\n" );
  write( "Du steigst vom Pferd herunter.\n" );
  pl->absteigen();
  destruct(this_object());
  return 1;
}

int reite(string str)
{
  write( "Du reitest schon.\n" );
  return 1;
}
