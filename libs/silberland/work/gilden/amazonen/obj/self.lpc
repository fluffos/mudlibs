// Lebenskraft der Amazonen

inherit "std/armour";
#include "../def.h"

#define MAX_C 15
#define MAX_H 10

string *props;

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"\nself", AMAZON_SELF}));
  SetProp(P_SHORT, 0); 
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_MAGIC, 1);
  SetProp(P_NOGET, "");
  SetProp(P_INVIS, 1);

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);

  if (getuid(previous_object()) != SPELL_UID)
    call_out("remove", 1);
}

void init()
{
  ::init();
  if (!TO || !MENV || MENV->QueryProp(P_GUILD) != GUILDNAME)
    call_out("remove",0);
}

int start_remove(int time) 
{
  call_out("remove", time);
  return 1;
}

int remove_method(string prop)
{
  environment()->Set(prop, 0, F_QUERY_METHOD);
  return 0;
}

varargs int remove(int silent) 
{
  object player, ob;
  if (query_once_interactive(player = environment()))
  {
    if (!silent)
      tell_object(player, "Deine Selbstbeherrschung laesst nach.\n");
    if (pointerp(props))
      filter_array(props, "remove_method");
    if (ob = present(GUILD_ITEM, player))
      ob->UnregisterEffect(AMAZON_SELF);
  }
  DoUnwear(1);
  return ::remove(silent);
}

int set_method(string prop)
{
  if (environment()->Query(prop, F_QUERY_METHOD))
    props -= ({prop});
  else {
    environment()->Set(prop, symbol_function("null", TO), F_QUERY_METHOD);
    environment()->Set(prop, symbol_function("null", TO), F_SET_METHOD);
    if(prop == P_PARALYZED) {
       environment()->Set(P_DISABLE_ATTACK, symbol_function("null", TO), F_QUERY_METHOD);
       environment()->Set(P_DISABLE_ATTACK, symbol_function("null", TO), F_SET_METHOD);
       environment()->Set(P_DISABLE_SPELLS, symbol_function("null", TO), F_QUERY_METHOD);
       environment()->Set(P_DISABLE_SPELLS, symbol_function("null", TO), F_SET_METHOD);
       props += ({P_DISABLE_ATTACK, P_DISABLE_SPELLS});
    }
  }
  return 0;
}

void setup(object player, int cold, int heat, string* p, int dur)
{
  object ob;

  if (pointerp(props = p))
    filter_array(props, "set_method");
  SetProp(P_TEMPERATURE_PROTECTION, 
      ([ T_COLD_PROT: (cold > MAX_C ? MAX_C : cold), 
         T_HEAT_PROT: (heat > MAX_H ? MAX_H : heat) ]) );
  DoWear(1);
  start_remove(dur);
  if (ob = present(GUILD_ITEM, player))
    ob->RegisterEffect();
}

int null()
{
  return 0;
}

