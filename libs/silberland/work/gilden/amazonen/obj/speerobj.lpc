inherit "std/thing";
#include "../def.h"

string* materialien;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, 0);
  AddId( "SPEERSTOSSOBJEKT");
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NEVERDROP, 1);

  }
 

 
 
  
  
  
  
   
