// Lebenskraft der Amazonen

inherit "std/thing";
#include "../def.h"

string *props;

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"\nlife", AMAZON_LIFE}));
  SetProp(P_SHORT, 0); 
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_INVIS, 1);

  if (getuid(previous_object()) != SPELL_UID)
    call_out("remove", 1);
}

void init()
{
  ::init();
  if (!TO || !MENV || MENV->QueryProp(P_GUILD) != GUILDNAME)
    call_out("remove",0);
}

int start_remove(int time) 
{
  call_out("remove", time);
  return 1;
}

int remove_delay(string delay)
{
  environment()->Set(delay, 0, F_QUERY_METHOD);
  return 0;
}

varargs int remove(int silent) 
{
  object player, ob;
  if (player = environment()) 
  {
    if (!silent)
      tell_object(player, "Deine Lebenskraft laesst nach.\n");
    SetProp(P_X_HEALTH_MOD, 0);
    player->UpdateAttributes();
    filter_array(props, "remove_delay");
    if (ob = present(GUILD_ITEM, player))
      ob->UnregisterEffect(AMAZON_LIFE);
  }
  return ::remove(silent);
}

int set_delay(string delay)
{
  if (environment()->Query(delay, F_QUERY_METHOD))
    props -= ({delay});
  else
    environment()->Set(delay, symbol_function("delay", TO), F_QUERY_METHOD);
  return 0;
}

void setup(object player, int hp, string* delays, int dur)
{
  object ob;
  props = delays;
  SetProp(P_X_HEALTH_MOD, ([P_HP: hp]));
  player->UpdateAttributes();
  player->AddHp(1 + random(hp));
  filter_array(props, "set_delay");
  start_remove(dur);
  if (ob = present(GUILD_ITEM, player))
    ob->RegisterEffect();
}

int delay()
{
  return 0;
}

public void heart_beat()
{
  object player;
  if (objectp(player = environment()))
  {
    player->AddHp(1);
    player->AddSp(1);
  }
}