// Heldensegen: kurzer STR/DEX Buff fuer ein Ziel.

#include "../def.h"

inherit "std/thing";

int bonus;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId(({"\namz_heldensegen"}));
  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);

  if (getuid(previous_object()) != SPELL_UID)
    call_out("remove", 1);
}

void init()
{
  ::init();
  if (!environment() || environment()->QueryProp(P_GUILD) != GUILDNAME)
    call_out("remove", 0);
}

public void setup_heldensegen(object target, int b, int dur)
{
  bonus = b;

  while (find_call_out("remove") != -1)
    remove_call_out("remove");
  call_out("remove", dur, 1);

  SetProp(P_X_ATTR_MOD, ([A_STR: bonus, A_DEX: bonus]));
  target->UpdateAttributes();
}

public int remove(int silent)
{
  object target;
  target = environment();
  if (objectp(target))
  {
    SetProp(P_X_ATTR_MOD, 0);
    target->UpdateAttributes();
  }
  return ::remove(silent);
}

