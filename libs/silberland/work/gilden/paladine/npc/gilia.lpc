inherit "std/inpc";
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <combat.h>
#include <moving.h>
#include <inpc.h>
#include "../paladin.h"

private nosave int shout_for_help;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  shout_for_help = 1;
  AddId (({ISPALADIN, "gilia", "paladin","mystikerin", "elfe", "\npaladin"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_RACE, "Elf");
  SetProp (P_NAME, "Gilia");
  SetProp (P_SHORT, "Gilia Leuenglanz, Mystikerin der Dusty, Hueterin des Schreins");
  SetProp (P_LONG, 
      "Gilia Leuenglanz ist eine hochgewachsene, athletische Elfe. Ihr Koerper ist "
      "von jahrelanger Uebung gestaehlt. Ihren Wappenrock traegt sie stolz ueber "
      "einer schimmernd polierten Ruestung. Ihr blauschwarzes Haar faellt in langen "
      "Wellen ueber ihre Schultern. Am auffaelligsten sind ihre Augen. Offenbar "
      "ist Gilia blind, da sie ihre Augen hinter einer weissen Binde verbirgt.");

  create_default_npc(42);
  SetProp (P_ARTICLE, 0);
  SetProp (P_ALIGN, 1000);
  SetProp (P_SIZE, 194);
  SetProp (P_BODY, 140);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit starken Haenden", 300, DT_BLUDGEON}) );
  SetProp (P_GUILD, "paladine");
  SetProp (P_GUILD_LEVEL, 15);
  SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelf":0.05]),
                          P_GUILD:(["nekromanten":1])])); 

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.4,     DT_BLUDGEON   :0,        DT_PIERCE     :0,
    DT_SQUEEZE    :0,        DT_WHIP       :0,        DT_RIP        :0,
    DT_FIRE       :-0.4,     DT_COLD       :-0.2,     DT_WATER      :-0.2, 
    DT_AIR        :-0.3 ,    DT_LIGHTNING  :0,        DT_EXPLOSION  :0, 
    DT_SOUND      :-0.2,     DT_LIGHT      :-1.0,        DT_ELECTRIC   :0,    
    DT_ACID       :0.3,      DT_POISON     :-0.1,     DT_TERROR     :-0.2,  
    DT_HOLY       :-1.0,     DT_UNHOLY     :0.1,      DT_MAGIC      :-0.1]));
  set_living_name("gilia");
  
  call_other("/gilden/paladine","learn_paladin_skills", 10000);
  ModifySkill("behandle",      10000);
  ModifySkill("behandle",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  ModifySkill("waffensegen",   10000);
  ModifySkill("waffensegen",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("zielattacke",   10000);
  ModifySkill("zielattacke",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("behandle",      10000);
  ModifySkill("behandle",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("heiligengebet", 10000);
  ModifySkill("heiligengebet", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("spiegelschild", 10000);
  ModifySkill("spiegelschild", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("goetterschutz", 10000);
  ModifySkill("goetterschutz", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  ModifySkill("talisman", 10000);
  ModifySkill("talisman", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  ModifySkill("schildparade", 10000);
  ModifySkill("schildparade", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  
  
  AddArmour("kettenhemd", ARMOUR("p_khemd"));
  AddArmour("wappenrock", ARMOUR("wappenrock"));
  AddArmour("wappenmantel", ARMOUR("wappenmantel"));
  AddArmour("mithrilschild", "/p/armour/shield/mithrilschild");
  AddArmour("lederstiefel", "/p/armour/boots/lederstiefel");
  AddArmour("guertel", "/p/armour/belt/guertel");
  AddWeapon("ritterschwert", WEAPON("paladinschwert"));
  AddMoney(100+random(1000));  
  if(find_object("/p/daemon/itemd/itemd") && !random(2)) {
    find_object("/p/daemon/itemd/itemd")->identify(present("ritterschwert",ME),
        -1, 100, 100, ({40,80,100,102,103}));
  }

  command_me("trage schild");

  SetProp(P_LOG_INFO, "gilden/paladine.log");
  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("ayla.lib"),      1);
  AddLibrary(LIBS("schenke.lib"),   1);
  AddLibrary(LIBS("schmied.lib"),   1);
  AddLibrary(LIBS("laden.lib"),     1);
  AddLibrary(LIBS("drache.lib"),    1);
  AddLibrary(LIBS("segnungen.lib"), 1);

  SetChats(3, ({
    "Gilia betet zu Dusty.\n",
    "Gilia laesst ihr Schwert in einem wilden Schwerttanz wirbeln.\n",
    "Gilia sagt: Dusty offenbart ihre Weisheit, wenn wir lernen zu sehen.\n",
    "Gilia fragt dich: Hast du heute schon gebetet?\n",
    "Gilia betet: Dein Wille, o Herrin, sei unser Befehl!\n",
    "Eine Welle positiver Energie durchstroemt dich.\n",
    "Gilia faellt auf die Knie und fleht Dusty an.\n",
    "Du fuehlst dich von Dusty geschuetzt.\n",
    "Gilias Schwert wird von silbrigem Glanz umspielt.\n",
    "Ein sanftes Gluehen huellt Gilia ein.\n",
    "Gilia fuellt etwas Weihrauch in die Schale.\n",
    "Gilia betet: Rotes Blut, heiliges Blut - Blut wasche rein - so sei es!\n",
    "Gilia betet: Herrin Dusty, durchdringe uns und fuelle uns mit Deinem Geist.\n"
  }));
  
  SetProp (P_DIE_MSG,
	" bricht mit einem Gebet auf den Lippen zusammen!\n");
  SetProp (P_DEFAULT_INFO,
	   ({"fragt: Ihr wuenscht??\n", 
	     "sagt: Moege Dusty Euch segnen!\n"}));
  SetProp( P_REJECT,({ REJECT_GIVE,
	"Gilia sagt: Brauch ich nicht!\n" })); 
  SetProp(P_KILL_MSG, 
        "Die Goettin wird dich richten");
  SetProp(P_MURDER_MSG, "Dusty! Ich habe versagt!");
  SetAttackChats(50, ({
    "@@attackspell@@", }) );
  
  SetProp(P_SPELLRATE,30);
  AddSpell(1,500,
    "Mythar macht eine Drehung und schlaegt Dir seinen Fuss in den Bauch.\n",
    "Mythar macht eine Drehung und schlaegt @WEM seinen Fuss in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300,
    "Mythar macht eine Finte und schlaegt Dir in die Seite.\n",
    "Mythar macht eine Finte und schlaegt @WEM in die Seite.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,500,
    "Mythar attackiert Dich mit einem Doppelschlag.\n",
    "Mythar attackiert @WEN mit einem Doppelschlag.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
 call_other(NPCMASTER,"add_npc");
}

int p_shout(string msg) {
  if(member(UID_ALLOWED, getuid(previous_object()))==-1)
    return 0;
  command_me("prufe "+msg);
  return 1;
}

void init() {
  ::init();
  if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);
}

remove(int arg) {
 call_other(NPCMASTER,"del_npc");
  ::remove(arg);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  call_other(NPCMASTER,"help_me",enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

// SPELLS
string attackspell() {
  object en;
  if(QueryProp(P_HP) < 900 && shout_for_help) {
    shout_for_help=0;
    command_me("prufe Helft mir!");
    call_other(NPCMASTER, "RequestHelp", 10+random(30));
    return "";
  }
  if(!present(AMARYLLION, ME) && !random(10)) {
    command_me("stecke schwert zurueck");
    command_me("talisman");
    return "";
  }
  if(!QueryProp(P_TMP_DEFEND_HOOK)) {
    if(!random(2))
      command_me("schildparade");
    else 
      command_me("goetterschutz");
    return "";
  }
  if(en=QueryEnemy()) {
    if(!random(2))
      command_me("zielattacke");
    else 
      command_me("heiligengebet");
  }
  return "";
}

int test123() {
  command_me("goetterschutz");
  return 1;

}

heart_beat() {
  object en; 
  int i, x, eval, old_eval;
  if(!objectp(QueryProp(P_WEAPON)) && !present(AMARYLLION, ME))
    command_me("zuecke schwert");
  ::heart_beat();
  return ;
}


die(int pd) {
  call_other(NPCMASTER, "del_npc", TP);
  ::die(pd);
}
  
void NotifyPlayerDeath(object player, object killer, int lostexp) {
  write_file(LOG("npc.kills"), sprintf(
      "%s: Mythar killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
  command_me("prufe Dusty sei gepriesen! Die Gerechtigkeit hat gesiegt!");
  command_me("nimm alles aus leiche");
  return ;
}

void reset() {
  ::reset();
  shout_for_help=1;
}
