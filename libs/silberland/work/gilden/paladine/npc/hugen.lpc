
inherit "std/repair";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../paladin.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Hugen, der Schmied");
  SetProp(P_LONG,
    "Vor Dir steht ein wahrlich statthafter Zwerg. Er gehoert wohl zu den "
    "Paladinen, was man an seiner Rose als Taetowierung auf seiner Brust "
    "sehen kann. Seine Muskeln sind zum fuerchten.");
  SetProp(P_NAME, "Hugen");
  SetProp(P_GENDER, MALE);
  AddId( ({ISPALADIN, "hugen", "schmied", "\n_hugen"}) );
  set_living_name("hugen");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen starken Haenden",
    QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 140+random(10));
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_COLD:      0.1, DT_WATER:   0.3, DT_AIR:    0.0, 
      DT_LIGHTNING:  0.0, DT_EXPLOSION: 0.0, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:      0.0, DT_POISON: -0.5, DT_TERROR: 0.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.2, DT_MAGIC:   0.2 ]) );
  SetProp(P_ARTICLE, 0);

  SetProp (P_GUILD, "paladine");
  SetProp (P_GUILD_LEVEL, 8);

  SetProp(P_MSGIN, "kommt herein und faengt an ein Schwert zu schmieden");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kracht toedlich getroffen auf den Boden.\n");

  AddInfo(DEFAULT_INFO, "ist zu sehr mit seiner Arbeit beschaeftigt.\n");
  AddInfo("zordan", "Zordan hat mich schon oft besucht.","sagt: ");

  SetProp(P_LOG_INFO, "gilden/paladine.log");
  SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelf":0.05]),
                          P_GUILD:(["nekromanten":1])])); 

  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("ayla.lib"),      1);
  AddLibrary(LIBS("schenke.lib"),   1);
  AddLibrary(LIBS("schmied.lib"),   5);
  AddLibrary(LIBS("laden.lib"),     1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Hugen will nichts tragen.\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(8,400,
    "Hugen schlaegt Dir den Schaedel ein.\n",
    "Hugen schlaegt @WEM den Schaedel ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,500,
    "Hugen wirft einen heiligen Pfeil auf Dich.\n",
    "Hugen wirft einen heiligen Pfeil auf @WEN .\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1000,
    "Hugen wirft Dich in das Feuer.\n",
    "Hugen wirft @WEN in das Feuer.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Hugen taucht das gluehende Schwert kurz in kaltes Wasser.\n",
    "Hugen schaut Dich kurz an.\n",
    "Wasser rinnt an Hugen herunter.\n",
    "Hugen bearbeitet ein Schwert.\n",
    "Hugen begutachtet sein neues Schwert.\n"}) );
  SetAttackChats(10, ({
    "Hugen schreit: Dusty wird mich raechen!\n",
    "Hugen sagt: Du bist doch ein Wimp!\n",
    "Hugen schaut Dich unglaeubig an.\n"}) );

  SUID;
  CLONEME( "/p/weapon/club/schmiedehammer" );
  command("zuecke hammer");
  CLONEME( "/p/armour/trousers/hose" );
  CLONEME( "/p/armour/boots/lederschuhe" );
  CLONEME( ARMOUR("p_beinschienen") );
  command("trage alles");
  call_other(NPCMASTER,"add_npc");
}


int _query_wimpy() { return 0; }

// Reactions

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
    case "traurig":
      call_out("reaction", 0, TP, 
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
    case "aergerlich":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "schaut Dich vorwurfsvoll an.",
        "schaut "+TPN+" vorwurfsvoll an.");
      break;
    case "nett":
    case "albern":
    case "froh":
      call_out("reaction", 0, TP,
        "grinst Dich an.", 
        "grinst "+TPN+" an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "haut Dir eine runter.",
        "haut "+TPN+" eine runter.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "schaut Dich einfach nur an.",
        "schaut "+TPN+" einfach nur an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

int rep_auswahl(object ob) {
  if(ob->QueryProp(P_WEAPON_TYPE) == WT_SWORD) {
    write("Hugen sagt: "+ob->Name(WER,1)+" ist super. Darauf bin ich spezialisiert!\n");
    return 1;
  }
  if(ob->QueryProp(P_WEAPON_TYPE)) {
    write("Hugen sagt: Ich kann leider nur Schwerter reparieren!\n");
    return 0;
  }
  if (ob->QueryMaterialGroup(MATGROUP_METAL)) {
    write("Hugen sagt: "+ob->Name()+" besteht aus Metall, da kann ich helfen!\n");
    return 1;
  }
  if (member(({AT_RING, AT_AMULET}), ob->QueryProp(P_ARMOUR_TYPE)) != -1) {
    write("Hugen sagt: Ich repariere keinen Schmuck!\n");
    return 1;
  }
  write("Hugen sagt: Ich kann nur Ruestungen aus Metall reparieren!\n");
  return 0;
}

int p_shout(string msg) {
  if(member(UID_ALLOWED, getuid(previous_object()))==-1)
    return 0;
  command_me("prufe "+msg);
  return 1;
}

void init() {
  ::init();
  if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);

  if(objectp(present(RANGER_TASK_SCHNITZELJAGD, TP))) {
    call_out("greet_rager", 0, TP);
  }
}

public void greet_rager(object pl) {
  command_me("emote steckt hastig eine Nachricht in seine Hose.");
  command_me("sag He, "+pl->name(WER)+", schau nicht so doof! Ich hab dir nichts zu sagen.");
  return;
}

/*
void InformDefend(object enemy) {
  Kill(enemy);
}
*/
remove(int arg) {
  call_other(NPCMASTER,"del_npc");
  ::remove(arg);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  call_other(NPCMASTER,"help_me",enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}


void die(int poisondeath) {
  object ob;

  call_other(NPCMASTER, "del_npc", TP);
  write_file(LOG("npc.kills"), sprintf(
      "%s: %s killt Hugen (LVL:%d, GLVL:%d-%s)\n",
      ctime(),CAP(getuid(TP)), TP->QueryProp(P_LEVEL), 
      TP->QueryProp(P_GUILD_LEVEL), TP->QueryProp(P_GUILD)));
  command_me("prufe NEIN, DAS IST NICHT MOEG....");
  tell_object(PL,
    "Dusty erscheint und laesst einen Blitz auf dich niederbrechen.\n"
    "Dusty sagt erzuernt: Tu meinen Paladinen nie wiedes etwas an!!!\n"
    "Dusty verschwindet in einer Rauchwolke.\n"
    "Du windest Dich unter groessten Schmerzen.\n");
  PL->SetProp(P_HP,1);

  if(objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, TP)) && ob->QueryStage() == 0) {
    ob->HugenKilled();
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  write_file(LOG("npc.kills"), sprintf(
      "%s: Hugen killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
  command_me("prufe Frevler besiegt! Wo ist der naechste?");
}
