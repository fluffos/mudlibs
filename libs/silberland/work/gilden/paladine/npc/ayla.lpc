  CLONEME( "/p/armour/belt/guertel.lpc" );
  CLONEME( "/p/armour/boots/lederstiefel.lpc" );
  CLONEME( "/p/armour/amulet/amulett.lpc" );
  CLONEME( "/p/armour/ring/ring.lpc" );
  CLONEME( "/d/gebirge/eros/ruestung/platinring.lpc" );
  CLONEME( ARMOUR("p_armschienen") );
  CLONEME( ARMOUR("p_beinschienen") );
  CLONEME( ARMOUR("p_helm") );
