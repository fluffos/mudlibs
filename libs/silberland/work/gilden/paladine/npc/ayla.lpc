  AddSpell(1,2500,
      "Dustys Macht straft Dich!\n",
      "Dustys Macht straft @WEN!\n",
      DT_HOLY, ([SP_SHOW_DAMAGE:1]));
      
  SetChats(1, ({
    "Die Aura um Ayla leuchtet kurz hell auf.\n",
    "Ayla laechelt Dich an.\n",
    "Ayla haelt ein kurzes Gebet zu Dusty.\n",
    "Du spuerst eine heilige Anwesenheit.\n",
    "Die Haare von Ayla wehen im Wind.\n",
    "Ayla strahlt ueber das ganze Gesicht.\n",
    "Ayla fragt: Moechtest Du nicht fuer das Gute eintreten?\n",
