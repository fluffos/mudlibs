//////////////////////////////////////////////////////////////////////////////
// Misc
//////////////////////////////////////////////////////////////////////////////

int _query_wimpy() { return 0; }

nomask query_prevent_shadow() { return 1; }


void init() {
  ::init();
  if(interactive(TP) && getuid(TP)=="juny") {
    call_out("greet_juny", 0);
  }
  if(interactive(TP) && getuid(TP)=="sennah") {
    call_out("greet_sennah", 0);
  }
  if(choosen_one && TP == choosen_one) {
    call_out("give_quest", 0);
  }
  if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);
  if(present("faehnchen", ME)) 
    call_out("faehnchen", 0);
}

void faehnchen() {
  command_me("schwenke faehnchen");
}


varargs int remove(int arg) {
  call_other(NPCMASTER,"del_npc");
  ::remove(arg);
}

void reset() {
  object ob,*inv,what,neu, flag,pl;
  int nr;
  string name;
  if(!is_clone(TO)) return ::reset();
  shout_for_help=1;
  call_other(ROOM("burg_schatzkammer"), "???");
  if(!random(2)) {
    call_out("tell_about_nekro", random(30)+30);
  }
  flag=find_object(ROOM("burg_schatzkammer"))->QueryProp("standarte");
  if(flag && ENV(flag) && (file_name(ENV(flag)) != ROOM("burg_schatzkammer"))) {
    command_me("prufe Paladine! Die Standarte ist noch immer nicht "
        "in der Schatzkammer!");
  }
  
  if (ob=present("glasschwert",ME)) {
    command_me("stecke glasschwert weg");
    command_me("emote laesst ein Glasschwert in einem hellen Blitz verschwinden.");
    ob->remove();
  }
  perg_count=5;
  get_angry=({});
  switch (random(10)) {
    case 0..6:
      inv=QueryProp(P_ARMOURS);
      nr=-1;
      if (sizeof(inv)>4) {
        while (nr==-1) {
          nr=random(sizeof(inv));
          what=inv[nr];
          if (what->QueryProp(P_ARMOUR_TYPE) == AT_MISC) nr=-1;
        }
        nr=-1;
        while (nr==-1) {
          nr=random(4);
          if (neu) neu->remove();
          neu=clone_object(ruest[what->QueryProp(P_ARMOUR_TYPE),nr]);
          if (what->Name() == neu->Name()) nr=-1;
        }
        if (MENV) {
          tell_room(MENV,BS(
            "Ayla versinkt fuer einen kurzen Moment in tiefster "
            "Konzentration..." ));
          name=what->Name();
          what->SetProp(P_CURSED,0);
          what->DoUnwear(0);
          what->remove();
          tell_room(MENV,BS(
            CAP(name)+" verschwindet in einem grellen Blitz." ));
          neu->SetProp(P_CURSED,0);
          neu->move(ME,M_SILENT + M_NOCHECK);
          if(!random(10))
            catch(find_object(ITEMD)->identify(neu, 1, 100, 100, 
                ({100,300,500,700,1300})));
          tell_room(MENV,BS(
            CAP(neu->Name())+" entsteht in Aylas heiligen Haenden." ));
          command_me("trage alles");
          tell_room(MENV,BS(
            "Ayla fluestert leise: Danke Dusty."));
        }
      }
      break;

    case 7..9:
    default:
      if (MENV) {
        inv=all_inventory(MENV);
        tell_room(MENV,BS(
          GUILDNPC_NAME+" reisst auf einmal die Haende gen Decke."));
        tell_room(MENV,break_string(
          "Gepriesene Dusty, gibt mir die Kraft diesen Armen hier Deine "
          "Macht zu zeigen!",78,GUILDNPC_NAME+" ruft: "));
        for (nr=0;nr<sizeof(inv);nr++) {
          if(interactive(inv[nr]) && !InFight(inv[nr]) && !IS_WIZARD(inv[nr])){
            name=inv[nr]->Name();
            switch (random(4)) {
              case 0:
                tell_object(inv[nr],BS(
                  GUILDNPC_NAME+" beruehrt Deine Stirn und und Du fuehlst "
                  "Dich erfrischt und gestaerkt."));
                tell_room(MENV,BS(
                  GUILDNPC_NAME+" beruehrt die Stirn von "+name+
                  "."), ({ inv[nr] }) );
                inv[nr]->heal_self(30+random(30));
                break;
              case 1:
                tell_object(inv[nr],BS(
                  GUILDNPC_NAME+" faesst Dir kurz auf den Magen. Du hast "
                  "auf einmal das Verlangen nach was zu Essen und Trinken."));
                tell_room(MENV,BS(
                  GUILDNPC_NAME+" faesst den Magen von "+name+
                  " an."), ({ inv[nr] }) );
                inv[nr]->SetProp(P_FOOD, 0);
                inv[nr]->SetProp(P_DRINK, 0);
                inv[nr]->SetProp(P_ALCOHOL, 0);
                break;
              case 2:
                if(inv[nr]->QueryProp(P_ALIGN)<1000 )
                {
                  tell_object(inv[nr],BS(
                        GUILDNPC_NAME+" segnet Dich. Deine Gesinnung hat sich in "
                        "Richtung des Guten veraendert."));
                  tell_room(MENV,BS(
                        GUILDNPC_NAME+" segnet "+name+
                        "."), ({ inv[nr] }) );
                  inv[nr]->SetProp(P_ALIGN,
                      inv[nr]->QueryProp(P_ALIGN)+25+random(25));
                }
                break;
              default:
              case 3:
                tell_object(inv[nr],BS(
                  GUILDNPC_NAME+" umfasst Deine Beinmuskeln. Du fuehlst Dich "
                  "auf einmal flink wie ein Wiesel."));
                tell_room(MENV,BS(
                  GUILDNPC_NAME+" umfasst die Beinmuskeln von "+name+
                  "."), ({ inv[nr] }) );
                inv[nr]->SetProp(P_MV,inv[nr]->QueryProp(P_MAX_MV));
                break;
            }
          }
        }
      }
      break;
  }
  if(call_other(PALADINMASTER, "QuestLvl16Free")) {
    call_out("check_paladin_quest", 10,0);
  }
  else if(time() > call_other(PALADINMASTER, "QueryQuestLvl16")["time"]) {
    pl=find_player(call_other(PALADINMASTER, "QueryQuestLvl16")["player"]);
    if(!pl) {
      pl=find_netdead(call_other(PALADINMASTER, "QueryQuestLvl16")["player"]);
      if(pl) {
        ob=clone_object(OBJ("msg"));
        ob->Setup("Du hast versagt, Paladin! Die dreissig Tage sind um "
          "und das Herz des Boesen wurde nicht geopfert!", "Ayla teilt Dir"
          "mit");
        ob->move(pl);
      }
    }
    else {
      pl->Message(BSA("Du hast versagt Paladin! Die dreissig Tage sind um "
            "und das Herz des Boesen wurde nicht geopfert! Doch sorge Dich "
            "nicht, es wird ein Wuerdiger gefunden werden, der diese Aufgabe "
            "uebernehmen wird, der Du nicht gewachsen warst!", "Ayla teilt "
            "Dir mit: "));
    }
    call_other(PALADINMASTER, "SetQuestLvl16Solved");
  }
  ::reset();
}

string fertigkeiten() {
  call_other(ENV(TO), "faehigkeiten");
  return "";
}

string schatzkammer() {
  object room, *inv;
  string roomname, txt;
  int i, value;
  
  txt="Die Schatzkammer ist ein geheimer Ort. Darin bewahren wir die "
    "Kostbarkeiten der Burg auf. Ein Anteil der Opfergaben wird "
    "ebensfalls in die Schatzkammer transferiert. Im Moment befinden "
    "sich ";
  value=0;
  roomname=ROOM("burg_schatzkammer2");
  call_other(roomname, "???");
  room=find_object(roomname);
  inv=all_inventory(room); 
  for(i=sizeof(inv)-1;i>=0;i--) 
    value+=inv[i]->QueryProp(P_VALUE);
  if(value>0) 
    txt+="zusaetzliche Opfergaben im Wert von "+value+" Muenzen in der Kammer.";
  else
    txt+="keine Opfergaben in der Schatzkammer.";
  return txt;
}


//////////////////////////////////////////////////////////////////////////////
// Erwartete Personen
//////////////////////////////////////////////////////////////////////////////

void heart_beat() {
  object *all;
  int i;
  string names;
  ::heart_beat();
  waiting_check();
  TO->SetProp(P_HB,1);
  hb_time=time();
  cnt++;
  if(cnt==30) {
    names=ctime()[11..18]+": ";
    all=users();
    for(i=sizeof(all)-1;i>=0;i--) {
      if(!is_clone(all[i])) {
        names+=getuid(all[i])+" ";
      }
    }
    rm(LOG("online"));
    write_file(LOG("online"), sprintf("%s", names));
    call_out("smscheck", 0); // Auswerten der teilemits per sms
    cnt=0;
  }
}



void smscheck() {
  string text, *msgs, *smstell;
  object pl;  
  int i;
  if(!text=read_file("/gilden/paladine/log/tell.txt")) return; 
  rm("/gilden/paladine/log/tell.txt");
  msgs=explode(text, "\n");
  for(i=sizeof(msgs)-1;i>=0;i--) {
    smstell=explode(msgs[i],";;"); 
    if(pl=find_player(lower_case(smstell[1]))) {
       pl->Message(break_string(smstell[2]+" (Absender: "+smstell[0]+")", 
             78,"*** SMS Mitteilung: "), MSGFLAG_TELL);
    }  
  }
  return;
}

void waiting_check() {
  object dusty, angrox, zordan, stahldorn, avatar;
  string zeit;
  zeit=dtime(time());
  dusty=find_player("dusty");
  zordan=find_player("zordan");
  angrox=find_player("angrox");
  stahldorn=find_player("stahldorn");
  avatar=find_living(DUSTY_AVATAR);
  if(objectp(dusty) && objectp(avatar)) {
    if(!interactive(avatar)) {
      avatar->move("/room/npcasylroom", M_TPORT);
      avatar->remove();
      waiting_for["avatar"]=0;
    }
  }  
  if(objectp(dusty) && !waiting_for["dusty"]) {
    if(!dusty->QueryProp(P_INVIS)) {
      if(zeit[5..11]=="20. Nov" && !helpvar) {
        command_me("prufe PALADINE! Unsere Goettin ist erschienen "
            "und sie hat heute Geburtstag!");
        shout("Ayla von Schattengrund ruft: Herrin Dusty!\n");
        shout(BSA("Alles Gute zu Eurem Geburtstag, Herrin!", "Ayla von "
            "Schattengrund ruft: "));
        shout("Mythar ruft: Herrin! Alles Gute!\n");
        shout("Ardare ruft: Auch von mir die allerbesten Glueckwuensche, "
            "Herrin!\n");
        shout(BSA("Moegen die Elemente stehts mit Euch sein, Goettin! "
            "Auch von den Druiden alles Gute!", "Anvar ruft: "));
        shout(BSA("Dusty! Moege Deine Axt stehts vom Blut Deiner "
            "Feinde geschaerft bleiben! Alles Gute!", "Kronang bruellt: "));
        shout(BSA("Wasch isch losch? Hab ich wasch <Hicks> verpascht?", 
            "Zechus lallt lauthals: "));
        helpvar=1;    
      }
      else 
      {
        command_me("prufe Paladine! Unsere Goettin ist erschienen! Lasst sie "
            +"uns preisen! Heilig! Heilig! Heilig!");
        shout("Ayla von Schattengrund ruft: Herrin Dusty!\n");
      }
      waiting_for["dusty"]=1;
      DoKneeFall();
    }
  }
  if(objectp(angrox) && !waiting_for["angrox"]) {
    if(!angrox->QueryProp(P_INVIS)) {
      command_me("prufe Ah! Lord Angrox! Seid herzlichst willkommen! "
          "Keine besonderen Vorkommnisse seit Eurem letzten Besuch!");
      waiting_for["angrox"]=1;
    }
  }
  if(objectp(zordan) && !waiting_for["zordan"]) {
    if(!zordan->QueryProp(P_INVIS)) {
      if(!helpvar && zeit[5..11]==" 4. Mai") 
        command_me("prufe Lord Zordan! Alles Gute zu Eurem Geburtstag! Ihr "
            "haltet Euch fuer Euer Alter fabelhaft!");
      else       
        command_me("prufe Lord Zordan! Seid herzlich willkommen!");
      waiting_for["zordan"]=1;
    }
  }
  if(objectp(stahldorn) && !waiting_for["stahldorn"]) {
    if(!stahldorn->QueryProp(P_INVIS)) {
      if(!helpvar && zeit[5..11]=="26. Mai") 
        command_me("prufe Herre Stahldorn! Seid herzlichst willkommen "
           "an diesem besonderen Tag!"); 
      else       
        command_me("prufe Herre Stahldorn! Seid herzlichst willkommen!");
      waiting_for["stahldorn"]=1;
    }
  }
  if(objectp(avatar) && !waiting_for["avatar"]) {
    if(!avatar->QueryProp(P_INVIS)) {
      command_me("prufe Der Avatar der Herrin ist erschienen! Er wird "
        "uns geleiten und Dustys Wille ausfuehren!");
      waiting_for["avatar"]=1;
    }
  }
  

  if((!objectp(dusty)||dusty->QueryProp(P_INVIS)) && waiting_for["dusty"]) {
    command_me("prufe Paladine! Dusty hat uns verlassen! Lasst uns beten, "
        +"auf das sie bald wieder erscheinen moege!");
    waiting_for["dusty"]=0;
  }

  if((!objectp(angrox)||angrox->QueryProp(P_INVIS)) && 
      waiting_for["angrox"]) 
  {
    waiting_for["angrox"]=0;
  }
  if((!objectp(zordan)||zordan->QueryProp(P_INVIS)) && 
      waiting_for["zordan"]) 
  {
    waiting_for["zordan"]=0;
  }
  if((!objectp(stahldorn)||stahldorn->QueryProp(P_INVIS)) && 
      waiting_for["stahldorn"]) 
  {
    waiting_for["stahldorn"]=0;
  }
  if((!objectp(avatar)|| avatar->QueryProp(P_INVIS) )&& waiting_for["avatar"]) {
    command_me("prufe Der Avatar der Herrin hat uns verlassen um die "
        "Herrin Dusty aufzusuchen! Lasst uns beten, auf dass er bald "
        "wieder erscheint!");
    waiting_for["avatar"]=0;
  }
  return;
}


void DoKneeFall() {
  string *members; 
  object *spieler, rock;
  int i;
  members=call_other(PALADINMASTER, "QueryMembers");
  spieler=users();
  for(i=sizeof(spieler)-1;i>=0; i--) {
    if(member(members, getuid(spieler[i]))!=-1 && 
        rock=present(WAPPENROCK, spieler[i]))
    {
      rock->KneeDown();
      spieler[i]->heal_self(random(10)+5);
      if( spieler[i]->QueryProp(P_ALIGN)<1000 )
        spieler[i]->SetProp(P_ALIGN, spieler[i]->QueryProp(P_ALIGN)+random(15));
    }
  }
  return;
}

//////////////////////////////////////////////////////////////////////////////
// Logs
//////////////////////////////////////////////////////////////////////////////

void die(int poisondeath) {
  if((time()-hb_time)>4) { // Dann hat wohl der Herzschlag ausgesetzt -> bug
    heal_self(3000);
    return;
  }
  call_other(NPCMASTER, "del_npc", TP);
  write_file(LOG("npc.kills"), sprintf(
      "%s: %s killt Ayla (LVL:%d, GLVL:%d-%s)\n",
      ctime(),CAP(getuid(TP)), TP->QueryProp(P_LEVEL), 
      TP->QueryProp(P_GUILD_LEVEL), TP->QueryProp(P_GUILD)));
  command_me("prufe PALADINE! Sofort zur Burg! Wir ... NEIN, DUSTY STEH "
      "MIR ...");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if (killer==ME) {
    write_file(LOG("npc.kills"), sprintf(
      "%s: Ayla killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
    command_me("prufe Ein Frevler weniger!");
  }
}


//////////////////////////////////////////////////////////////////////////////
// Defend -> Clonen des Schwertes
//////////////////////////////////////////////////////////////////////////////

int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  object ob;
  int al,en;
  SetProp(P_ALIGN, 1000);
  if (!present("glasschwert",ME)) {
    ob=clone_object("/p/magic/glasschwert");
    ob->move(ME,M_NOCHECK|M_SILENT);
  }
  if (!QueryProp(P_WEAPON)) {
    command_me("zuecke glasschwert");
  }
  if ((al=enemy->QueryProp(P_ALIGN)) > 100) {
    if (random(100) < 10) {
      tell_object(enemy,
        "Die gute Seite in Dir laesst Deinen eigenen Angriff abschwaechen.\n");
    }
    dam-=al/(5+random(6));
    if (dam<0) dam=0;
  }
  call_other(NPCMASTER,"help_me",enemy);
  en=(sizeof(PresentEnemies()))*100;
  if(en>600) en=600;
  if(en>=100 && !random(2)) ME->ModifySkillAttribute(ME,SA_SPEED,en,4);
  TO->SetProp(P_SP,TO->QueryProp(P_MAX_SP));
  return ::Defend(dam, dam_type, spell, enemy);
}

varargs void ModifySkillAttribute(object caster, string atrname, int value, int duration, mixed fun) {
  if (PO && PO!=TO && getuid(PO)!="GUILD.paladine") return;
  ::ModifySkillAttribute(caster, atrname, value, duration, fun);
}

//////////////////////////////////////////////////////////////////////////////
// Spells
//////////////////////////////////////////////////////////////////////////////

void alignspell(object enemy, int damage, mixed dam_type) {
  enemy->SetProp(P_ALIGN,enemy->QueryProp(P_ALIGN)+10+random(10));
  enemy->Defend(damage, dam_type, ([SP_SHOW_DAMAGE:1,SP_NAME:"Align"]), TO); 
  return;
}


