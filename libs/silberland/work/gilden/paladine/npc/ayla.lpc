//////////////////////////////////////////////////////////////////////////////
// Gildensachen
//////////////////////////////////////////////////////////////////////////////

string Wappenrock() {
  if(TP->QueryProp(P_GUILD)!="paladine")
    return "Der Wappenrock ist eine Gabe von Dusty an uns Paladine. Er ist "
           "ein Zeichen fuer unsere Hingabe.";
  if(!present(WAPPENROCK, TP)) {
    call_out("GiveRock",0, TP);
    return "Bei Dusty, wo ist Dein Wappenrock hin? Hier, nimm einen Neuen.";
  }
  return "Der Wappenrock den Du traegst ist eine Gabe von Dusty an uns. Er "
         "ist ein Zeichen fuer unsere Mitgliedschaft im auserwaehlten Kreis "
         "der Paladine.";
}

string FlagPosition() {
  object flag, env_flag;
  mixed wo, wo2;

  flag=find_object(ROOM("burg_schatzkammer"))->QueryProp("standarte");
  if(!flag)
    return "Dusty steh uns bei! Die heilige Standarte ist vernichtet!";
  env_flag=ENV(flag);
  if(!env_flag)
    return "Dusty hat uns die Standarte entzogen! Sie schwebt nun im "
      "absoluten Nichts zwischen den Welten!";
  if(file_name(env_flag) == ROOM("burg_schatzkammer"))
    return "Die heilige Standarte befindet sich in der Schatzkammer! "
      "Damit ruht der Segen Dustys auf uns.";
  if(living(env_flag))
    return sprintf("Bei Dusty! %s hat die Standarte gestohlen und "
        "befindet sich damit auf der Flucht!", env_flag->Name());
  if(!living(env_flag))
    if (wo = env_flag->name(WEM))
      if (environment(env_flag) &&
          (wo2 = all_environment(flag)[<1]->QueryProp(P_INT_SHORT)))
        return sprintf("Bei Dusty! Die heilige Standarte befindet sich in "
            "%s an einem Ort der '%s' genannt wird!! "
          "Hole sie und bringe sie mir!", wo, wo2);
      else
        return sprintf("Bei Dusty! Die heilige Standarte befindet sich %s! "
          "Hole sie und bringe sie mir!", wo);
    else if (wo = env_flag->QueryProp(P_INT_SHORT))
      return sprintf("Bei Dusty! Die heilige Standarte befindet sich an "
        "einem Ort der '%s' genannt wird! Hole sie und bringe sie mir!",
        wo);
  return "Bei Dusty! Ich kann nicht erkennen wo sich die Standarte befindet!";
}

string NewRock() {
  object ob;
  if(TP->QueryProp(P_GUILD)!="paladine")
    return "Du gehoerst nicht zu dem auserwaehlten Kreis der Paladine.";
  if(!ob=present(WAPPENROCK, TP)) {
    call_out("GiveRock",0, TP);
    return "Bei Dusty. Du hast wohl Deinen Wappenrock verloren. Hier "
           "hast Du einen Neuen.";
  }
  ob->SetProp(P_CURSED, 0);
  ob->remove();
  call_out("GiveRock",0, TP);
  return "Ein nagelneuer Wappenrock. Bitte sehr.";
}

void GiveRock(object pl) {
  object ob;
  write("Ayla gibt Dir einen Wappenrock.\n");
  tell_room(ENV(TP),BS("Ayla gibt "+CAP(getuid(TP))+" einen Wappenrock.\n"),
           ({TP}));
  ob=CLONEOB(ARMOUR("wappenrock"));
  ob->move(TP, M_NOCHECK);
  return;
}

string Pergament() {
  object ob;
  if(perg_count<1) 
    return "Tut mir leid, aber ich habe keine mehr. Komm doch "
           "spaeter nochmal vorbei.";
  if(deep_present("pergament", TP))
    return "Aber Du hast doch schon ein Pergament.";
//  ob=clone_object(OBJ("pergament"));
//  ob->move(TP, M_NOCHECK);
  perg_count--;
  return "Hier bitte. Und viel Spass beim lesen.";
}

//////////////////////////////////////////////////////////////////////////////
// Spells
//////////////////////////////////////////////////////////////////////////////

string attackspell() {
  object en;
  if(!present(AMARYLLION, ME) && (QueryProp(P_HP) < QueryProp(P_MAX_HP)/2)) {
    command_me("stecke schwert zurueck");
    command_me("talisman");
    return "";
  }
  if(shout_for_help && QueryProp(P_HP) < 600) {
     shout_for_help=0;
     command_me("prufe Paladine! Helft mir!");
     call_other(NPCMASTER, "RequestHelp", 100);
     return "";
  }
  if(QueryProp(P_HP) < 200 && !random(QueryProp(P_HP)/2)) {
    command_me("behandle");
    return "";
  }
  if(!present("\nspiegelschild", ME)) {
    command_me("spiegelschild");
    return "";
  }
  if(!ME->QueryProp(P_TMP_DEFEND_HOOK)) {
    command_me("goetterschutz");
    return "";
  }
  if (en = QueryEnemy()) {
    if (random(3)) {
      command_me("zielattacke");
    } else {
      command_me("heiligengebet");
    }
    return "";
  }
  // ME->SetProp(P_NEXT_SPELL_TIME,time());
  // ME->SetProp(P_LAST_SPELL_TIME,time());
  return "";
}


//////////////////////////////////////////////////////////////////////////////
// Reactions
//////////////////////////////////////////////////////////////////////////////

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  //if(TPN=="Angrox" || TPN=="Zordan") return;
  if(TP->QueryGuest()) return;
  if(TP->QueryProp(P_RACE)=="Dunkelelf" && 
      member(({"fies", "frech", "boese", "intim"}), gruppe)==-1)
  {
    call_out("react_on_delf", 0);
    return;
  }
  switch(gruppe) {
    case "nett"      : call_out("gut", 0); 
                       break;
    case "gut"      :  call_out("gut", 0); 
                       break;
    case "intim"     : call_out("intim", 0); 
                       break;
    case "fies"      : call_out("boese", 0);
                       break;
    case "frech"     : call_out("boese",0); 
                       break;
    case "boese"     : call_out("boese",0);
                       break;
    case "traurig"   : call_out("traurig", 0); 
                       break;
    case "aengstlich": call_out("traurig", 0);
                       break;
    case "aergerlich": call_out("aergerlich", 0); 
                       break;
    case "froh"      : call_out("lustig", 0); 
                       break;
    case "albern"    : call_out("lustig", 0); 
                       break;
    default          : break;                   
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
    return StartReaction(verb, gruppe, adverb, touch);
}

void react_on_delf() {
  string *delftext;
  if(!TP || !present(TP,MENV)) return;
  if(!random(30)) {
    command_me("sag Das wirst Du buessen, in Dusty's Namen!");
    ME->Kill(TP);
  }
  else {
    delftext=({"Verschwinde, Du Ausgeburt der Unterwelt!",
             "Moege Dusty Dich dafuer vernichten!",
             "Noch einmal, und Du wirst in der Hoelle schmoren!"});
    command_me("sag "+delftext[random(sizeof(delftext))]);
  }
}


void gut() {
  string *guttext;
  if(!TP || !present(TP,MENV)) return;
  guttext= ({ "Moege Dusty Dich beschuetzen, ",
              "Dusty mit Dir, ",
              "Dusty's Segen mit Dir, ",
              "Moege Dusty Deine Wege erleuchten, " });
  command_me("sag " + guttext[random(sizeof(guttext))] + TPN+ "!");
}

void intim() {
  string *intimtext;
  if(!TP || !present(TP,MENV)) return;
  if(TP->QueryProp(P_RACE)=="Dunkelelf") {
    command_me("sag DU WAGST ES, DU AUSGEBURT DER UNTERWELT !?!?");
    ME->Kill(TP);
    return;
  }
  if(TP->QueryProp(P_GENDER)==MALE) {
    intimtext=({"Kein Interesse, ",
                "Nein, ",
                "Werde einmal ein Mann, dann sehen wir weiter, ",
                "Mit einem Waschlappen wie Dir fange ich bestimmt nichts an, ",
                "Was soll ich mit einem Versager wie Dir, ",
                "Geh spielen, ",
                "Mit Dir? Verschwinde, "});
  }
  else {
    intimtext=({"Vielleicht heute abend, ",
                "Ich hab Dienst, ", 
                "Mhhhh, heute abend nach Dienstschluss, ",
                "Vielleicht heute abend, ",
                "Hmmm, das waere zu ueberlegen, ",
                "Heute hat mich Yeza schon gefragt, "});
  }
  command_me("sag " + intimtext[random(sizeof(intimtext))] + TPN+ "!");
}

void boese() {
  string *boestext;
  if(!TP || !present(TP,MENV)) return;
  if(TP->QueryProp(P_RACE)=="Dunkelelf") {
    command_me("sag STIRB, DU AUSGEBURT DER UNTERWELT!");
    ME->Kill(TP);
    return;
  }
  boestext=({ "Verschwinde, oder ich toete Dich, ",
              "Ich lass mich nicht von Dir provozieren. Noch einmal, "
              "und ich toete Dich, ",
              "Noch einmal, und ich beschwoere Dusty's Zorn auf "
              +"Dich herab, "});
  if(member(get_angry, getuid(TP))==-1) { 
    command_me("sag " + boestext[random(sizeof(boestext))] + TPN + "!" );
    get_angry+=({getuid(TP)});
   }
  else { 
    if(IS_WIZARD(TP))
      command_me("sag Wenn Du kein Magier waerest, wuerde ich Dich toeten!");
    else
      Kill(TP);
  }
  return;
}

void lustig() {
  if(!TP || !present(TP,MENV)) return;
  command_me("lache");
}

void aergerlich() {
  if(!TP || !present(TP,MENV)) return;
  command_me("sag Ruhe hier, "+TPN+"!");
}

void troesten() {
  if(!TP || !present(TP,MENV)) return;
  command_me("sag Dusty wird Dir beistehen, "+TP->Name(WER)+"!");
}

void give_notify(object ob) {
  if(ob->id(PALADIN_STANDARTE)) {
    command_me("sag Dusty sei Dank! Du hast die Standarte zurueckgebracht!");
    command_me(sprintf("prufe Dusty sei gepriesen! %s hat die Standarte "
          "zurueckgebracht!", TP->Name(WER)));
    ob->move(ROOM("burg_schatzkammer"), M_NOCHECK);
    tell_room(ENV(ME), "Die Standarte verschwindet mit einem hellen "
        "Leuchten!\n");
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)+300);
    TP->SetProp(P_XP, TP->QueryProp(P_XP)+10000);
    return ;
  }
  return ::give_notify(ob);
}

void greet_juny() {
  object juny;
  juny=find_player("juny");
  if(juny && ENV(juny)==ENV(ME)) {
    command_me("sag Juny! Moege Dusty stets Ihre schuetzende Hand ueber "
        "Dich halten!");
    tell_room(ENV(ME), "Ayla laechelt.\n");
  }
  return ;
}
void greet_sennah() {
  object sennah;
  sennah=find_player("sennah");
  if(sennah && ENV(sennah)==ENV(ME)) {
    command_me("sag Moege Dusty Deine Wege stets erleuchten, Ritter der "
        "Goettin!");
    tell_room(ENV(ME), "Ayla laechelt Sennah an.\n", ({sennah}));
    tell_object(sennah, "Ayla laechelt Dich an.\n");
  }
  return ;
}


int filter_paladin_quest_player(object ob) {
  if(IS_LEARNING(ob) || ob->QueryProp(P_TESTPLAYER)) return 0;
  if(ob->QueryProp(P_GUILD) == "paladine" &&
     ob->QueryProp(P_GUILD_LEVEL) == 15 &&
     ob->QueryProp(P_LEVEL) >= 60 &&
     query_idle(ob) < 600 && 
     ob->QueryProp(P_ALIGN) > 600 &&
     ENV(ob) != ENV(ME)) 
  {
    return 1;
  }
  return 0;
}

varargs void check_paladin_quest(int override) {
  int x,i, bonus;
  object *pal;
  bonus=0; // Bonus muss man mal einbauen, aber da faellt mir grad nix ein (angrox, 27.03.09)
  pal=filter_array(users(), "filter_paladin_quest_player");
  if(sizeof(pal)) {
    choosen_one=pal[random(sizeof(pal))];
    bonus+=(choosen_one->QueryProp(P_ALIGN)-600)/5;
    bonus+=call_other(PALADINMASTER, "GetSacrificedMoney", choosen_one)/1000000;
  } else {
    return;
  }
  if(find_player("dusty"))
    bonus+=250;
  if(bonus>600) bonus=600;
  x=random((700-bonus));
  if(file_size(LOG("lvl16quest_rnd")) > 300000)
     rm(LOG("lvl16quest_rnd"));
  write_file(LOG("lvl16quest_rnd"), sprintf("%s: x=%d, choosen=%O, bonus=%d, *pal = ", 
         dtime(time()), x, choosen_one, bonus));
  for(i=sizeof(pal)-1;i>=0;i--) {
    write_file(LOG("lvl16quest_rnd"), sprintf("%s, ", getuid(pal[i])));
  }
  write_file(LOG("lvl16quest_rnd"),"\n");
  if(override==5) {
    x=0;
    override=0;
  }
  if(x > 5) {
    choosen_one=0;
    write_file(LOG("lvl16quest_rnd"),"   -> Leider nicht (x<=5 nicht erfuellt)\n");
    return; // nur wenn x <= 5 ist solls hier weitergehen
  }
  write_file(LOG("lvl16quest"), sprintf("Quest - pl: %O, x=%d, bonus=%d\n",choosen_one, 
        x,bonus));
  tell_object(choosen_one, "\n\n");
  choosen_one->Message(BSA("Paladin! Komm auf die Burg zum Rapport! Ich "
        "habe eine Aufgabe fuer Dich!", "Ayla teilt Dir mit: "), 
      MSGFLAG_TELL);
  tell_object(choosen_one, "\n\n");
  write_file(LOG("lvl16quest"), sprintf("%s: %s -> Rapportbefehl!\n", 
          dtime(time()), getuid(choosen_one)));
  call_out("paladin_missed_quest", 1200);
  return;
}

void paladin_missed_quest() {
   if(!objectp(choosen_one))
     return;
   choosen_one->Message(BSA("Gut, wenn Du nicht kommst suche ich mir einen "
         "Anderen fuer diese ehrenvolle Aufgabe.", "Ayla teilt Dir mit: "),
          MSGFLAG_TELL);
   write_file(LOG("lvl16quest"), sprintf("%s: %s -> kam nicht zu Ayla! "
           "Questende!\n", dtime(time()), getuid(choosen_one)));
   choosen_one=0;
   return ;
}

void give_quest()  {
   if(!present(choosen_one, ENV(ME)))
     return ;
   if(find_call_out("paladin_missed_quest") != -1) 
     remove_call_out("paladin_missed_quest");
   command_me(sprintf("sag Ahhh, %s, Du bist hier. Sehr gut. Ich habe eine "
         "dringliche Aufgabe fuer Dich.", choosen_one->name(WER)));
   write_file(LOG("lvl16quest"), sprintf("%s: %s -> kommt bei Ayla an!\n",
           dtime(time()), getuid(choosen_one)));
   call_out("give_quest2", 8);
   return ;
}

void give_quest2() {
   if(!present(choosen_one, ENV(ME))) {
     paladin_missed_quest();
     return;
   }
   command_me("sag Es gibt ein Bedrohung fuer das Silberland, welcher "
         "wir entgegenwirken muessen. Wir koennen die Bedrohung durch den "
         "alten Feind, durch DAS BOESE, nicht entgueltig beenden, aber wir "
         "koennen Zeit fuer die Verteidigung unser Welt herausholen.");
   call_out("give_quest3", 8);
   return ;
}

void give_quest3() {
   if(!present(choosen_one, ENV(ME))) {
     paladin_missed_quest();
     return;
   }
   command_me("sag DAS BOESE ist gerade wieder am erstarken. Du musst einen "
       "Teil der Essenz des Boesen, das sogenannte 'Herz des Boesen' "
       "erbeuten und hier am Altar Dusty opfern. Damit koennen wir genuegend "
       "Zeit erlangen, die das Silberland braucht um nicht von den Horden "
       "des Boesen ueberrannt zu werden.");
   call_out("give_quest4", 8);
}

void give_quest4() {
   if(!present(choosen_one, ENV(ME))) {
     paladin_missed_quest();
     return;
   }
   command_me("sag Nimmst Du die Aufgabe an, Paladin?");
   write ("\nWas moechtest Du Ayla antworten (ja/nein) ?\n");
   input_to("give_quest5");
}

void give_quest5(string str) {
   if(str != "ja" && str != "nein") {
     write ("\nWas moechtest Du Ayla antworten (ja/nein) ?\n");
     input_to("give_quest5");
     return ;
   }
   if(str=="nein") {
     tell_room(ENV(ME), BSA("Nein, Ayla, ich bin nicht bereit dafuer. "
           "Es tut mir leid...", TPN+" sagt: "), ({TP}));
     tell_object(TP, BSA("Nein, Ayla, ich bin nicht bereit dafuer. Es tut "
           "mir leid...", "Du sagst: "));
     choosen_one=0;
     command_me("sag Tritt mir aus den Augen.");
     write_file(LOG("lvl16quest"), sprintf("%s: %s -> lehnt die Quest ab!\n",
           dtime(time()), getuid(choosen_one)));
     return;
   }
   if(str=="ja") {
     tell_room(ENV(ME), BSA("Ja, Ayla, ich bin bereit! Ich bin bereit mein "
           "Leben fuer diese Sache in die Waagschale zu werfen! Ich werde "
           "das Herz des Boesen finden und opfern!", TPN+" sagt stolz: "),
         ({TP}));
     tell_object(TP, BSA("Ja, Ayla, ich bin bereit! Ich bin bereit mein "
           "Leben fuer diese Sache in die Waagschale zu werfen! Ich werde "
           "das Herz des Boesen finden und opfern!", "Du sagst stolz: "));
     write_file(LOG("lvl16quest"), sprintf("%s: %s -> nimmt die Quest an!\n",
           dtime(time()), getuid(choosen_one)));
     call_out("give_quest6", 2);
   }
   return;
}
 
void give_quest6() {
   if(!present(choosen_one, ENV(ME))) {
     paladin_missed_quest();
     return;
   }
   command_me("sag Gut so, Paladin! Dann mache Dich auf den Weg! Die Zeit "
       "draengt. Du musst DAS BOESE innerhalb von zehn Tagen vernichten, "
       "sonst hast Du versagt!");
   write_file(LOG("lvl16quest"), sprintf("%s: %s -> wird als Quester fix "
           "eingetragen!\n", dtime(time()), getuid(choosen_one)));
   call_other(PALADINMASTER, "SetQuestLvl16", choosen_one, time()+10*24*3600);
   choosen_one=0;
   return ;
}

void tell_about_nekro() {
  switch(random(3)) {
    case 0: tell_room(ENV(ME), "Ayla seufzt.\n"); 
            command_me("sag Dunkle Zeiten brechen an ...");
            break;
    case 1: command_me("sag Sie sind wieder da. Bei Dusty ...");
            break;
    case 2: command_me("sag Die Verdammten sind auf dem Vormarsch ...");
  }
  return ;
}
