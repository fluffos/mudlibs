  AddDefaultSpell(2, 700, DS_PARALYZE,
     "Die Macht Dusty's laesst Dich erstarren!\n",
     "Die Macht Dusty's laesst @WEN erstarren!\n" );

  AddDefaultSpell(1, 1200, DS_FEAR,
     "Ayla schlaegt Dich mit einem sehr hartem Schwerthieb aus dem "
