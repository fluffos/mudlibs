  AddInfo(DEFAULT_INFO, ({
    "fragt: Was genau meinst Du denn jetzt?\n",
    "sagt: Dusty kennt auf alles eine Antwort, frag sie doch mal.\n",
    "schaut Dich nur laechelnd an.\n",
    "sagt: Darueber habe ich noch nie nachgedacht.\n",
    "sagt: Bete zu Dusty und Du wirst Erleuchtung finden.\n" }) );
  AddInfo(({"wappenrock","rock"}), "@@Wappenrock@@", 
