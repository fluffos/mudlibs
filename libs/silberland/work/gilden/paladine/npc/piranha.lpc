
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../paladin.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Piranha");
  SetProp(P_LONG,
    "Ein fieser kleiner Piranha. Er ist nur auf eines aus: Dein Blut!");
  SetProp(P_NAME, "Piranha");
  SetProp(P_GENDER, MALE);
  AddId( ({ISPALADIN, "piranha"}) );

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen spitzen Zaehnen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "fisch");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:      -0.8, DT_WATER:  -1.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  -0.2 ]) );

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "taucht nach unten");

  SetProp(P_DIE_MSG,  " schwimmt jetzt tot auf der Wasseroberflaeche.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Piranha will NUR Blut!!\n" }) );

  SetProp(P_SPELLRATE,100);

  AddSpell(2,150,
    "Der Piranha beisst Dir hart in den Arm.\n",
    "Der Piranha beisst @WEM hart in den Arm.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,150,
    "Der Piranha beisst Dir hart in ein Bein.\n",
    "Der Piranha beisst @WEM hart in ein Bein.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,250,
    "Der Piranha beisst sich unglaublich hart in Dir fest.\n",
    "Der Piranha beisst sich unglaublich hart in @WEM fest.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,350,
    "Der Piranha beisst Dir ein Stueck Fleisch heraus.\n",
    "Der Piranha beisst @WEM ein Stueck Fleisch heraus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
}
