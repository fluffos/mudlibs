inherit "std/inpc";
inherit "std/npc/spells";
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <inpc.h>
#include "../paladin.h"

nosave int hb_count;
nosave mapping damage;

void create()
{
  object ob;
  hb_count=0;
  damage=0;
  if (!is_clone(this_object())) return;
  ::create();
  AddId (({ISPALADIN, "ardare", "paladin", "\nschatzkammer_waechter"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_RACE, "Mensch");
  SetProp (P_NAME, "Ardare");
  SetProp (P_SHORT, "Ardare, die Waechterin des Tores");
  SetProp (P_LONG, 
          "Ardare ist eine hochgewachsene, muskuloese Frau in "
          "den besten Jahren. Man sieht ihr ihre jahrelange Kampferfahrung "
          "an zahlreichen Narben an. Sie beschuetzt hier die Schatzkammer "
          "vor Eindringlingen.");
  create_default_npc(35+random(10)); 
  //create_default_npc(15+random(6)); // EIN TEST, bitte, ja? :)

  SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelf":0.05]),
                          P_GUILD:(["nekromanten":1])])); 

  SetProp (P_ARTICLE, 0);
  SetProp (P_ALIGN, 1000);
  SetProp (P_SIZE, 181);
  SetProp (P_BODY, 150);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit starken Haenden", 300, DT_BLUDGEON}) );
  SetProp (P_GUILD, "paladine");
  SetProp (P_GUILD_LEVEL, 15);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.4,     DT_BLUDGEON   :0,        DT_PIERCE     :0,
    DT_SQUEEZE    :0,        DT_WHIP       :0,        DT_RIP        :0,
    DT_FIRE       :-0.4,     DT_COLD       :-0.4,     DT_WATER      :0,    
    DT_AIR        :0,        DT_LIGHTNING  :-0.4,     DT_EXPLOSION  :0, 
    DT_SOUND      :0,        DT_LIGHT      :0,        DT_ELECTRIC   :0,    
    DT_ACID       :0,        DT_POISON     :0,        DT_TERROR     :0,     
    DT_HOLY       :-0.7,     DT_UNHOLY     :0.3,      DT_MAGIC      :0]) );
  set_living_name("ardare");
  
  call_other("/gilden/paladine","learn_paladin_skills", 10000);
  ModifySkill("behandle",      10000);
  ModifySkill("behandle",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  ModifySkill("waffensegen",   10000);
  ModifySkill("waffensegen",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("zielattacke",   12000);
  ModifySkill("zielattacke",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("behandle",      10000);
  ModifySkill("behandle",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("heiligengebet", 10000);
  ModifySkill("heiligengebet", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("spiegelschild", 10000);
  ModifySkill("spiegelschild", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("goetterschutz", 10000);
  ModifySkill("goetterschutz", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  ModifySkill("talisman", 10000);
  ModifySkill("talisman", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  
  
  AddArmour("kettenhemd", ARMOUR("p_khemd"));
  AddArmour("wappenrock", ARMOUR("wappenrock"));
  AddArmour("wappenmantel", ARMOUR("wappenmantel"));
  AddArmour("mithrilschild", "/p/armour/shield/mithrilschild");
  AddArmour("lederstiefel", "/p/armour/boots/lederstiefel");
  AddArmour("guertel", "/p/armour/belt/guertel");
  AddWeapon("glasschwert", "/p/magic/glasschwert");
  ob=clone_object(WEAPON("paladinschwert")); 
  ob->move(ME, M_NOCHECK);
  AddMoney(100+random(1000));  
  SetProp(P_LOG_INFO, "gilden/paladine.log");

  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("ayla.lib"),      1);
  AddLibrary(LIBS("schenke.lib"),   1);
  AddLibrary(LIBS("schmied.lib"),   1);
  AddLibrary(LIBS("laden.lib"),     1);
  AddLibrary(LIBS("drache.lib"),     1);
  
  AddInfo ( ({"tor", "mithriltor"}),
      "Ich bewache das Mithriltor!", "sagt: ");
  AddInfo ( ({"schatzkammer"}),
      "Keine Auskunft!", "sagt harsch: ");
  
  SetProp (P_DIE_MSG,
	" bricht mit einem Gebet auf den Lippen zusammen!\n");
  SetProp (P_DEFAULT_INFO,
	   ({"fragt: Ihr wuenscht??\n", 
	     "sagt: Moege Dusty Euch segnen!\n"}));
  SetProp( P_REJECT,({ REJECT_GIVE,
	"Ardare sagt: Brauch ich nicht!\n" })); 
  SetProp(P_KILL_MSG, 
        "Frevler! In der ewigen Verdammnis sollst Du schmoren!");
  SetProp(P_MURDER_MSG, "Raecht mich! Toetet %s, in Dusty's Namen!");
  SetAttackChats(70, ({
    "@@attackspell@@", }) );
  
  SetProp(P_SPELLRATE,55+random(10));
  AddDefaultSpell(3,500, DS_REDUCE_AC,
    "Ardare macht eine Drehung und schlaegt Dir ihren Fuss in den Bauch.\n",
    "Ardare macht eine Drehung und schlaegt @WEM ihren Fuss in den Bauch.\n");

  AddSpell(3,500,
    "Ardare macht eine Finte und schlaegt Dir in die Seite.\n",
    "Ardare macht eine Finte und schlaegt @WEM in die Seite.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(3,800, DS_DISARM,
    "Ardare attackiert Dich mit einem Doppelschlag.\n",
    "Ardare attackiert @WEN mit einem Doppelschlag.\n");

  AddDefaultSpell(1,700, DS_ANTIMAGIC,
    "Die Macht Dustys vernichtet Dich!\n",
    "Die Macht Dustys vernichtet @WEN!\n",
    50+random(20));
  /*
  AddDefaultSpell(3,1000, DS_CURSE_WEAPON, 
    "Dustys Macht straft Dich!\n",
    "Dustys Macht straft @WEN!\n");
  AddDefaultSpell(3,500, DS_CURSE_ARMOUR, 
    "Dustys Macht straft Dich!\n",
    "Dustys Macht straft @WEN!\n");
    */

 call_other(NPCMASTER,"add_npc");
}

int p_shout(string msg) {
  if(member(UID_ALLOWED, getuid(previous_object()))==-1)
    return 0;
  command_me("prufe "+msg);
  return 1;
}

void init() {
  ::init();
  command_me("schliesse mithriltor");
  if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);
}

remove(int arg) {
 call_other(NPCMASTER,"del_npc");
  ::remove(arg);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  string en_name;
  object ob;
  /*
  if(interactive(enemy)) { // Speichern der Schaeden.
    en_name=getuid(enemy);
    if(member(damage, en_name)==-1)
      damage+=([en_name:dam]);
    else 
      damage[en_name]=(int)(damage[en_name]+dam)/2; 
  }
  */
  call_other(NPCMASTER,"help_me",enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

// SPELLS
string attackspell() {
  object en;
  if(!ME->QueryProp(P_TMP_DEFEND_HOOK)) {
    command_me("goetterschutz");
    return "";
  }
  if (en = QueryEnemy()) {
    if (random(2))
      command_me("zielattacke");
    else 
      command_me("heiligengebet");
    return "";
  }
  return "";
}

heart_beat() {
  object en; 
  int i, x, eval, old_eval, how;
  ::heart_beat();
  if(!objectp(QueryProp(P_WEAPON)))
    command_me("zuecke schwert");
  if((sizeof(en=PresentEnemies()))<2) return;
  
  hb_count++;
  how=1;
  if(hb_count>3 && objectp(en=GetEnemy(how))) {
    SetProp(P_PREFERED_ENEMY, ({100, en}));
    hb_count=0;
  }
  /* 
  for(i=sizeof(en)-1;i>=0;i--) {
    eval=2*en[i]->QueryProp(P_TOTAL_AC)+en[i]->QueryProp(P_TOTAL_WC)+
      3*en[i]->QueryProp(P_HP)+en[i]->QueryProp(P_ALIGN)/2;
    
    if(eval<x) x=i;
    old_eval=eval;
  } 
  SetProp(P_PREFERED_ENEMY, ({70, en[x]}));
  */
  return ;
}


die(int pd) {
  object ob;
  command_me("prufe Schnell, Verstaerkung zur Schatzkammer ... "
      "WAAAAAAAAAAAAAAAAAAAAAARGHHHH!");
  call_other(NPCMASTER, "del_npc", TP);
  ob=clone_object(NPC("schatzwaechter"));
  ob->move(MENV, M_GO);
  call_other(ROOM("burg_schatzkammer2"), "reset");
  write_file(LOG("npc.kills"), sprintf(
      "%s: %s killt Ardare (LVL:%d, GLVL:%d-%s)\n",
      ctime(),CAP(getuid(TP)), TP->QueryProp(P_LEVEL), 
      TP->QueryProp(P_GUILD_LEVEL), TP->QueryProp(P_GUILD)));
  ::die(pd);
}
  
void NotifyPlayerDeath(object player, object killer, int lostexp) {
  int i;
  object *inv,ob;
  write_file(LOG("npc.kills"), sprintf(
      "%s: Ardare killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
  if(ob=present("Leiche", MENV)) 
    inv=all_inventory(ob);
  else inv=all_inventory(MENV);
  if(!sizeof(inv)) return;
  for(i=sizeof(inv)-1;i>=0;i--) 
    inv[i]->move(ROOM("burg_schatzkammer2"), M_NOCHECK|M_SILENT);
  tell_room(MENV, "Aldare zaubert die Ausruestung in die Schatzkammer.\n");
  command_me("prufe Melde gehorsamst: Feind besiegt und Ausruestung in "
      "Schatzkammer gesichert!");
  return;
}
