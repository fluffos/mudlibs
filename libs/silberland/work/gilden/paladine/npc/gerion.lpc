/*
// Gerion, der Waffen- und Ruestungshaendler
//  Angrox@SL
//  10.12.1997
//
*/

inherit "std/inpc";
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <combat.h>
#include <moving.h>
#include <inpc.h>
#include "../paladin.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId (({ISPALADIN, "gerion","paladin","haendler"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Mensch");
  SetProp (P_NAME, "Gerion");
  SetProp (P_SHORT, "Gerion, der Waffen- und Ruestungshaendler");
  SetProp (P_LONG, 
           "Vor Dir steht ein graubaertiger, alter Paladin, der "
          +"in ein Kettenhemd und einem Wappenrock gewandet ist. "
          +"Seine grauen Augen spruehen noch vor jugendlicher "
          +"Energie. Er strahlt eine gewisse Erhabenheit aus.");
  create_default_npc(18);
  SetProp (P_ARTICLE, 0);
  SetProp (P_ALIGN, 500);
  SetProp (P_SIZE, 194);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit alten Haenden", 150, DT_BLUDGEON}) );
  SetProp (P_GUILD, "paladine");
  SetProp (P_GUILD_LEVEL, 9);
  
  AddArmour("kettenhemd", ARMOUR("p_khemd"));
  AddArmour("wappenrock", ARMOUR("wappenrock"));
  AddMoney(100+random(100));  
  SetProp(P_SPELLRATE,10);

  SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelf":0.05]),
                          P_GUILD:(["nekromanten":1])])); 
  SetProp(P_LOG_INFO, "gilden/paladine.log");

  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("ayla.lib"),      1);
  AddLibrary(LIBS("schenke.lib"),   1);
  AddLibrary(LIBS("schmied.lib"),   1);
  AddLibrary(LIBS("laden.lib"),     5);
  AddLibrary(LIBS("drache.lib"),    1);
  
  AddSpell(5,100,
	"Gerion schlaegt Dir ins Gesicht.\n",
	"Gerion schlaegt @WEN ins Gesicht.\n");

  AddSpell(1,500,
	"Gerion beschwoert goettlichen Zorn auf Dich herab\n",
	"Gerion beschwoert goettlichen Zorn auf @WEN herab\n");

  SetAttackChats(40, ({
	"Gerion kaempft verbissen.\n",
	"Gerion ruft: ALARM! \n",
	"Gerion vernichtet Dich.\n"
	}) );

  SetProp (P_DIE_MSG,
	" faellt tot um.\n");

  SetProp (P_DEFAULT_INFO,
	   ({"fragt: Wie bitte?\n", 
             "sagt: Jaja, damals ...\n",
	     "sagt: Tut mir leid, darueber weiss ich nichts"}));

  SetProp( P_REJECT,({ REJECT_GIVE,
	"Gerion sagt: Nein, nein, behalte es ruhig.\n" }));
  call_other(NPCMASTER,"add_npc");
}

int p_shout(string msg) {
  if(member(UID_ALLOWED, getuid(previous_object()))==-1)
    return 0;
  command_me("prufe "+msg);
  return 1;
}

void init() {
  ::init();
  if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);
}

varargs int remove(int arg) {
  call_other(NPCMASTER,"del_npc");
  return ::remove(arg);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  call_other(NPCMASTER,"help_me",enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}


void die(int poisondeath) {
  call_other(NPCMASTER, "del_npc", TP);
  write_file(LOG("npc.kills"), sprintf(
      "%s: %s killt Gerion (LVL:%d, GLVL:%d-%s)\n",
      ctime(),CAP(getuid(TP)), TP->QueryProp(P_LEVEL), 
      TP->QueryProp(P_GUILD_LEVEL), TP->QueryProp(P_GUILD)));
  command_me("prufe Dusty! Vergib mir, ich habe versagt!");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  write_file(LOG("npc.kills"), sprintf(
      "%s: Gerion killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
  command_me("prufe Fuer Dusty!");
}
