
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../paladin.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

#define COST 50
int gesch;
int busy=0;
int is_moving=0;
string geschstr;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  gesch=random(2);

  if (gesch) {
    SetProp(P_SHORT, "Ein Paladinwaechter");
    SetProp(P_LONG,
      "Vor Dir steht ein sehr gut ausgebildeter Paladinwaechter. Seine "
      "goettliche Ausstrahlung laesst Dich fast erzittern. Sollte sich "
      "wirklich jemand erdreisten ihn anzugreifen, legt er sich bestimmt auch "
      "gleich mit den Goettern an.");
    SetProp(P_NAME, "Paladinwaechter");
    SetProp(P_GENDER, MALE);
    geschstr="Der Paladinwaechter";
    SetProp(P_HANDS, ({" mit seinen heiligen Haenden",
      QueryProp(P_HANDS)[1],DT_HOLY}));
  } else {
    SetProp(P_SHORT, "Eine Paladinwaechterin");
    SetProp(P_LONG,
      "Vor Dir steht eine sehr gut ausgebildete Paladinwaechterin. Ihre "
      "goettliche Ausstrahlung laesst Dich fast erzittern. Sollte sich "
      "wirklich jemand erdreisten sie anzugreifen, legt er sich bestimmt auch "
      "gleich mit den Goettern an.");
    SetProp(P_NAME, "Paladinwaechterin");
    SetProp(P_GENDER, FEMALE);
    geschstr="Die Paladinwaechterin";
    SetProp(P_HANDS, ({" mit ihren heiligen Haenden",
      QueryProp(P_HANDS)[1],DT_HOLY}));
  }

  AddId( ({ "paladinwaechterin","paladinwaechter", "waechter", 
            "waechterin", "paladin", "\n_p_waechter" }) );

  create_default_npc(20+random(5));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 150+random(20));
  SetProp(P_ALIGN, 700+random(200));
  SetProp(P_MAX_HANDS, 2);

  SetProp (P_GUILD, "paladine");
  SetProp (P_GUILD_LEVEL, 8+random(3));

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      -0.2, DT_WATER:  -0.2, DT_AIR:    -0.1, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:  -0.2, DT_LIGHT:  -0.3,
      DT_ELECTRIC:  -0.1, DT_ACID:      -0.1, DT_POISON: -0.3, DT_TERROR: -0.1,
      DT_HOLY:      -0.8, DT_UNHOLY:     0.3, DT_MAGIC:  -0.2 ]) );

  SetProp(P_MSGIN, "kommt weisen Schrittes an");
  SetProp(P_MSGOUT, "geht weisen Schrittes weiter");
  SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelf":0.05]),
                        P_GUILD:(["nekromanten":1])]));    
  
  SetProp(P_MNPC_AREA, ROOM("w_weg") );
  SetProp(P_MNPC_WAIT, ({ 15, 40, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("w_weg_a2") );
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "verrichtet seine Wache und antwortet Dir nicht.\n");
  AddInfo("zordan", "Zordan ist mir nicht heilig genug.","sagt: ");

  SetProp(P_LOG_INFO, "gilden/paladine.log");

  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("ayla.lib"),      1);
  AddLibrary(LIBS("schenke.lib"),   1);
  AddLibrary(LIBS("schmied.lib"),   1);
  AddLibrary(LIBS("laden.lib"),     1);
  AddLibrary(LIBS("drache.lib"),    1);
  
  SetProp( P_REJECT, ({ REJECT_KEEP,
    geschstr+" bedankt sich bei Dir.\n" }) );

  SetProp(P_SPELLRATE,80);

  AddSpell(3,200,
    geschstr+" macht eine raffinierte Finte.\n",
    geschstr+" macht eine raffinierte Finte.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300,
    geschstr+" fleht Dusty um Hilfe an.\n",
    geschstr+" fleht Dusty um Hilfe an.\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    geschstr+" reisst Dir das Fleisch auf.\n",
    geschstr+" reisst @WEM das Fleisch auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,800,
    geschstr+" greift Dich mit der heiligen Macht an.\n",
    geschstr+" greift @WEN mit der heiligen Macht an.\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    geschstr+" schaut sich die Landschaft an.\n",
    geschstr+" haelt ein kurzes Gebet.\n",
    geschstr+" pfeift eine froehliche Melodie.\n",
    geschstr+" zwinkert Dir aufmunternd zu.\n",
    geschstr+" laechelt Dich an.\n",
    geschstr+" rueckt die Ausruestung zurecht.\n"}) );
  SetAttackChats(30, ({
    geschstr+" schreit: Dusty wird mich raechen!!!\n",
    geschstr+" tritt Dir hart gegen Dein Schienbein.\n",
    geschstr+" weicht Deinem Schlag gekonnt aus.\n",
    geschstr+" hat goettlichen Schutz.\n",
    geschstr+" kaempft wie in Trance.\n"}) );

  SUID;
  if (random(100) > 75) {
    CLONEME( "/p/weapon/sword/langschwert" );
    present("schwert")->AddId(PALADINITEM);
    command("zuecke schwert");
  } else {
    CLONEME( WEAPON("paladinschwert") );
    command("zuecke schwert");
  }
  if (random(100) > 75) {
    CLONEME( "/p/armour/armour/kettenhemd" );
    present("kettenhemd")->AddId(PALADINITEM);
  } else {
    CLONEME( ARMOUR("p_khemd") );
  }
  if (random(100) > 50) {
    CLONEME( "/p/armour/boots/lederstiefel" );
    present("stiefel")->AddId(PALADINITEM);
  } else {
    CLONEME( "/p/armour/boots/lederschuhe" );
    present("schuhe")->AddId(PALADINITEM);
  }
  if (random(100) > 75) {
    CLONEME( "/p/armour/helm/titanhelm" );
    present("helm")->AddId(PALADINITEM);
  } else {
    CLONEME( ARMOUR("p_helm") );
  }
  if (random(100) > 75) {
    CLONEME( "/p/armour/gloves/kettenhandschuhe" );
    present("handschuhe")->AddId(PALADINITEM);
  }
  CLONEME( ARMOUR("wappenrock") );
  command("trage alles");

  if(!random(5)) {
    CLONEME("/p/std/skills/reading/books/guild_buffs/paladine_spellcost_1");
  }
  
  // Ja, wir helfen uns gegenseitig ;)
  call_other(NPCMASTER,"add_npc");
}

void init() {
  ::init();
  if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);
}
/*
void InformDefend(object enemy) {
  Kill(enemy);
}
*/
remove(int arg) {
  call_other(NPCMASTER,"del_npc");
  ::remove(arg);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  call_other(NPCMASTER,"help_me",enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

int p_shout(string msg) {
  if(member(UID_ALLOWED, getuid(previous_object()))==-1) 
  {
    return 0;
  }
  command_me("prufe "+msg);
  return 1;
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
  object ob, ob2;
  object *inv;
  player->RemovePursuer(ME);
  p_shout(sprintf("DUSTY SEI DANK! %s ist vernichtet!", player->name(WER)));
  write_file(LOG("npc.kills"), sprintf(
      "%s: Ein Paladinwaechter killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
  if(ob=present("Leiche", MENV)) {
    inv=all_inventory(ob);
    if(ob2=present(PALADIN_STANDARTE, ob)) {
      ob2->move(ROOM("burg_schatzkammer"), M_NOCHECK);
      p_shout("Die heilige Standarte ist wieder in unserem Besitz!");
      call_out("go_home");
    }
    if(!sizeof(inv)) return;
    inv[random(sizeof(inv))]->move(ROOM("burg_schatzkammer2"), M_NOCHECK);
  }
  command_me("nimm alles aus leiche");
}

void die(int pd) {
  object ob, killer;
  call_other(NPCMASTER, "del_npc", TP);
  command_me("prufe Dusty! Ich habe versagt!!!!");

  killer = QueryProp(P_KILLER) || TP;
  if(objectp(killer)) {
    if(killer->id("\nranger_pet")) {
      killer = killer->QueryOwner();
    }

    if(objectp(ob=present(RANGER_TASK_PALA_KILLER, killer)) && ob->QueryStage() == 1) {
      ob->AcceptKill();
    }
  }

  return ::die(pd);
}


int CanHelp() {
  return 1;
}

int IsBusy() {
  return busy;
}

int IsMoving() {
  return is_moving;
}

void SetBusy() {
  busy=1;
  SetProp(P_MNPC_FLAGS,0);
}

void SetFree() {
  busy=0;
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
}


int DoWay(mixed way) {
  int i;
  SetBusy();
  is_moving=1;
  //tell_angrox("Waechter: Weg fun ok!\n");
  //tell_angrox(sprintf("Waechterweg: %O\n", way));
  if(!sizeof(way)) return 0;
  call_out("NextStep", 2, way);
  return 1;
}

nosave int NextStep(mixed way) {
  if(!sizeof(way)) {
    is_moving=0;
    call_out("SetFree", 120);
    return 1;
  }
  command_me(way[0]);
  //tell_angrox(sprintf("%O --> %s\n", ME, way[0]));
  call_out("NextStep", 2, way[1..]);
  return 1;
}

void go_home() {
   ME->move(ROOM("w_weg_a2"), M_GO);
   SetProp(P_MNPC_AREA, ROOM("w_weg") );
   SetProp(P_MNPC_WAIT, ({ 15, 40, 40 }));
   SetProp(P_MNPC_DEFAULTROOM, ROOM("w_weg_a2") );
   SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
   return ;
}

void catch_tell(string str) {
  string sayer, to_protect;
  object pl,npc;
  mixed way;
  if(sscanf(str, "%s sagt: beschuetze %s!\n", sayer, to_protect)!=2)
    return ;
  if(!pl=find_player(lower_case(sayer))) return ;
  to_protect=lower_case(to_protect);
  if(pl->QueryProp(P_GUILD)!="paladine") {
    call_out("say_delayed", 0, "sag In Dustys Namen! Du hast hier nichts zu sagen!");
    return ;
  }
  if(pl->QueryProp(P_GUILD_LEVEL) < 15) {
    call_out("say_delayed", 0, "sag Paladin! Mit Deinem Dienstgrad "
        "werde ich nichts dergleichen tun!");
    return ;
  }
  if(member( ({"ayla", "mythar", "portal", "seherportal", "bordur"}), 
        lower_case(to_protect))==-1) 
  {
    call_out("say_delayed", 0,"sag Paladin! Ich kann nur Ayla, Mythar und "
        "Bordur "
        "beschuetzen, und auch nur wenn sie da sind! Ausserdem kann ich "
        "das Seherportal beschuetzen");
    return ;
  }

  if(member( ({"portal", "seherportal" }), to_protect)!=-1) {
    call_other(ROOM("w_weg_a1"), "???");
    if (present("\n_p_waechter", find_object(ROOM("w_weg_a1"))))
    {
      call_out("say_delayed", 0, "sag Aber dort stehen doch schon genug Wachen!");
      return;
    }
    if (pl->QueryProp(P_SP) < COST)
    {
      call_out("say_delayed", 0, "sag Deine Macht ist zu gering, um mich "
          "herumzokommandieren!");
      return;
    }
    pl->AddSp(-COST);
    way=find_object(WAYD)->find_way(ENV(ME),find_object(ROOM("w_weg_a1")));
    call_out("say_delayed", 0, "sag Jawoll, ich bin schon auf dem Weg!");
    call_out("DoWay", 0, way[1]);
    write_file(LOG("waechter_befehlen"), sprintf("%s: %O befiehlt %O von %s "
        "zum Seherportal\n", dtime(time()), pl, ME, file_name(ENV(pl))));
    return ;
  }
  npc=find_living(to_protect);
  if(!npc) {
    call_out("say_delayed", 0, sprintf("sag Es tut mir leid, %s scheint "
          "nicht hier zu sein!", CAP(to_protect)));
    return ;
  }
  if(IsBusy()) {
    call_out("say_delayed", 0, "sag Es tut mir leid! Ich bin gerade mit "
        "einer anderen Aufgabe beschaeftigt!");
    return ;
  }
  if(!ENV(npc) || explode(file_name(ENV(npc)), "/")[0]!="gilden") {
    call_out("say_delayed", 0, "sag Es tut mir leid, aber ich kann "
        "dorthin nicht gehen!");
    return ;
  }
  call_other(WAYD, "???");
  way=find_object(WAYD)->find_way(ENV(ME), ENV(npc));
  if(sizeof(way) < 2 || !sizeof(way[1]))
  {
    return ;
  }
  if (pl->QueryProp(P_SP) < COST)
  {
    call_out("say_delayed", 0, "sag Deine Macht ist zu gering, um mich "
        "herumzokommandieren!");
    return;
  }
  pl->AddSp(-COST);
  call_out("say_delayed", 0, "sag Jawoll, ich bin schon auf dem Weg!");
  write_file(LOG("waechter_befehlen"), sprintf("%s: %O befiehlt %O von %s "
        "zu %s (%s)\n", dtime(time()), pl, ME, file_name(ENV(pl)), 
        CAP(to_protect), file_name(ENV(npc))));
  call_out("DoWay", 0, way[1]);
  return ;
}

void say_delayed(string str) {
   command_me(str);
   return ;
}
