/*
//  Bordur, der Wirt
//  Angrox@SL
//  10.12.1997
//
*/

inherit "std/inpc";
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <combat.h>
#include <moving.h>
#include <inpc.h>
#include "../paladin.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId (({ISPALADIN, "bordur", "paladin","wirt", "zwerg"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Zwerg");
  SetProp (P_NAME, "Bordur");
  SetProp (P_SHORT, "Bordur, der Wirt");
  SetProp (P_LONG, 
           "Bordur ist ein staemmiger Zwerg mit einem roten, gut "
          +"gepflegtem Vollbart. Er ist in ein Kettenhemd gewandet "
          +"und traegt eine schwere Axt bei sich. Er ist der Inhaber "
          +"des 'Schwert und Schild' und als Zwerg ist er einfach der "
          +"perfekte Schankwirt.");
  create_default_npc(25);
  SetProp (P_ARTICLE, 0);
  SetProp (P_ALIGN, 600);
  SetProp (P_SIZE, 124);
  SetProp (P_BODY, 140);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit Zwergenhaenden", 100, DT_BLUDGEON}) );
  SetProp (P_GUILD, "paladine");
  SetProp (P_GUILD_LEVEL, 10);
  set_living_name("bordur");
  
  AddArmour("kettenhemd", ARMOUR("p_khemd"));
  AddArmour("wappenrock", ARMOUR("wappenrock"));
  AddWeapon("zwergenaxt", "/d/gebirge/angrox/obj/zwergenaxt");
  AddMoney(100+random(100));  
  SetProp(P_SPELLRATE,40);

  SetProp(P_LOG_INFO, "gilden/paladine.log");

  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("ayla.lib"),      1);
  AddLibrary(LIBS("schenke.lib"),   5);
  AddLibrary(LIBS("schmied.lib"),   1);
  AddLibrary(LIBS("laden.lib"),     1);
  AddLibrary(LIBS("drache.lib"),    1);

  SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelf":0.05]),
                          P_GUILD:(["nekromanten":1])])); 

  AddSpell(3,100,
	"Bordur schlaegt Dir ins Gesicht.\n",
	"Bordur schlaegt @WEN ins Gesicht.\n");
  AddSpell(1,1300,
	"Bordur beschwoert goettlichen Zorn auf Dich herab\n",
	"Bordur beschwoert goettlichen Zorn auf @WEN herab\n");
  SetAttackChats(40, ({
	"Bordur kaempft verbissen.\n",
	"Bordur ruft: ALARM! \n",
	"Bordur vernichtet Dich.\n"
	}) );
  SetProp (P_DIE_MSG,
	" faellt tot zu Boden.\n");
  SetProp (P_DEFAULT_INFO,
	   ({"fragt: Wie bitte?\n", 
             "fragt: Ein Bier oder zwei?\n",
	     "sagt: Tut mir leid, darueber weiss ich nichts.\n"}));
  SetProp( P_REJECT,({ REJECT_GIVE,
	"Bordur sagt: Brauch ich nicht!\n" })); 
  SetProp(P_KILL_MSG, 
        "Und jetzt auf ein Bier! Prost!");
  call_other(NPCMASTER,"add_npc");
}

int p_shout(string msg) {
  if(member(UID_ALLOWED, getuid(previous_object()))==-1)
    return 0;
  command_me("prufe "+msg);
  return 1;
}

void init() {
  ::init();
  if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);
}

remove(int arg) {
  call_other(NPCMASTER,"del_npc");
  ::remove(arg);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  call_other(NPCMASTER,"help_me",enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}


void die(int poisondeath) {
  call_other(NPCMASTER, "del_npc", TP);
  write_file(LOG("npc.kills"), sprintf(
      "%s: %s killt Bordur (LVL:%d, GLVL:%d-%s)\n",
      ctime(),CAP(getuid(TP)), TP->QueryProp(P_LEVEL), 
      TP->QueryProp(P_GUILD_LEVEL), TP->QueryProp(P_GUILD)));
  command_me("prufe Dusty, ich habe versagt!");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  write_file(LOG("npc.kills"), sprintf(
      "%s: Bordur killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
  command_me("prufe Ein Feind in der Kneipe ist tot!");
}
