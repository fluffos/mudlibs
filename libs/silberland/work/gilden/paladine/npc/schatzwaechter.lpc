
inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../paladin.h"

int gesch;
string geschstr;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  gesch=random(2);
  create_default_npc(30+random(3));
  if (gesch) {
    SetProp(P_SHORT, "Ein Schatzwaechter");
    SetProp(P_LONG,
      "Vor Dir steht ein sehr gut ausgebildeter Schatzwaechter. Seine "
      "goettliche Ausstrahlung laesst Dich fast erzittern. Sollte sich "
      "wirklich jemand erdreisten ihn anzugreifen, legt er sich bestimmt auch "
      "gleich mit den Goettern an.");
    SetProp(P_NAME, "Schatzwaechter");
    SetProp(P_GENDER, MALE);
    geschstr="Der Schatzwaechter";
    SetProp(P_HANDS, ({" mit seinen heiligen Haenden",
      QueryProp(P_HANDS)[1],DT_HOLY}));
  } else {
    SetProp(P_SHORT, "Eine Schatzwaechterin");
    SetProp(P_LONG,
      "Vor Dir steht eine sehr gut ausgebildete Schatzwaechterin. Ihre "
      "goettliche Ausstrahlung laesst Dich fast erzittern. Sollte sich "
      "wirklich jemand erdreisten sie anzugreifen, legt er sich bestimmt auch "
      "gleich mit den Goettern an.");
    SetProp(P_NAME, "Schatzwaechterin");
    SetProp(P_GENDER, FEMALE);
    geschstr="Die Schatzwaechterin";
    SetProp(P_HANDS, ({" mit ihren heiligen Haenden",
      QueryProp(P_HANDS)[1],DT_HOLY}));
  }

  AddId( ({ISPALADIN,  "schatzwaechterin","schatzwaechter", "waechter", 
            "waechterin", "paladin", "\npaladin", "Schwertmeister", 
            "\n_s_waechter", "\nschatzkammer_waechter" }) );

  //create_default_npc(25+random(5));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 150+random(20));
  SetProp(P_ALIGN, 700+random(200));
  SetProp(P_MAX_HANDS, 2);

  SetProp (P_GUILD, "paladine");
  SetProp (P_GUILD_LEVEL, 10+random(3));
    SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelf":0.05]),
                                  P_GUILD:(["nekromanten":1])])); 


  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      -0.2, DT_WATER:  -0.2, DT_AIR:    -0.1, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:  -0.2, DT_LIGHT:  -0.3,
      DT_ELECTRIC:  -0.1, DT_ACID:      -0.1, DT_POISON: -0.3, DT_TERROR: -0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:     0.4, DT_MAGIC:  -0.2 ]) );

  SetProp(P_MSGIN, "kommt weisen Schrittes an");
  SetProp(P_MSGOUT, "geht weisen Schrittes weiter");

  SetProp(P_DIE_MSG,  " faellt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "verrichtet seine Wache und antwortet Dir nicht.\n");
  AddInfo("zordan", "Zordan ist mir nicht heilig genug.","sagt: ");

  SetProp(P_LOG_INFO, "gilden/paladine.log");

  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("ayla.lib"),      1);
  AddLibrary(LIBS("schenke.lib"),   1);
  AddLibrary(LIBS("schmied.lib"),   1);
  AddLibrary(LIBS("laden.lib"),     1);
  AddLibrary(LIBS("drache.lib"),    1);
  
  SetProp( P_REJECT, ({ REJECT_KEEP,
    geschstr+" bedankt sich bei Dir.\n" }) );

  SetProp(P_SPELLRATE,90);

  AddSpell(3,400,
    geschstr+" macht eine raffinierte Finte.\n",
    geschstr+" macht eine raffinierte Finte.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

/*
  AddDefaultSpell(2,400, DS_FEAR,
    geschstr+" fleht Dusty um Hilfe an.\n",
    geschstr+" fleht Dusty um Hilfe an.\n");
*/

  AddSpell(2,500,
    geschstr+" fleht Dusty um Hilfe an.\n",
    geschstr+" fleht Dusty um Hilfe an.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(2,400,
    geschstr+" reisst Dir das Fleisch auf.\n",
    geschstr+" reisst @WEM das Fleisch auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,900,
    geschstr+" greift Dich mit der heiligen Macht an.\n",
    geschstr+" greift @WEN mit der heiligen Macht an.\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(30, ({
    geschstr+" schreit: Dusty wird mich raechen!!!\n",
    geschstr+" tritt Dir hart gegen Dein Schienbein.\n",
    geschstr+" weicht Deinem Schlag gekonnt aus.\n",
    geschstr+" hat goettlichen Schutz.\n",
    geschstr+" kaempft wie in Trance.\n"}) );

  SUID;
  if (random(100) > 75) {
    CLONEME( "/p/weapon/sword/langschwert" );
    command("zuecke schwert");
  } else {
    CLONEME( WEAPON("paladinschwert") );
    command("zuecke schwert");
  }
  if (random(100) > 75) {
    CLONEME( "/p/armour/armour/kettenhemd" );
  } else {
    CLONEME( ARMOUR("p_khemd") );
  }
  if (random(100) > 50) {
    CLONEME( "/p/armour/boots/lederstiefel" );
  } else {
    CLONEME( "/p/armour/boots/lederschuhe" );
  }
  if (random(100) > 75) {
    CLONEME( "/p/armour/helm/topfhelm" );
  } else {
    CLONEME( ARMOUR("p_helm") );
  }
  if (random(100) > 75) {
    CLONEME( "/p/armour/gloves/kettenhandschuhe" );
  }
  CLONEME( ARMOUR("wappenrock") );
  CLONEME( "/p/armour/ring/ring" );
  command("trage alles");
  
  // Ja, wir helfen uns gegenseitig ;)
  call_other(NPCMASTER,"add_npc");
}

void init() {
  ::init();
  if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);
}
/*
void InformDefend(object enemy) {
  Kill(enemy);
}
*/
remove(int arg) {
  call_other(NPCMASTER,"del_npc");
  ::remove(arg);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  call_other(NPCMASTER,"help_me",enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

int p_shout(string msg) {
  if(member(UID_ALLOWED, getuid(previous_object()))==-1) 
  {
    return 0;
  }
  command_me("prufe "+msg);
  return 1;
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
  p_shout(sprintf("DUSTY SEI DANK! %s ist vernichtet!", player->name(WER)));
  command_me("nimm alles aus leiche");
  write_file(LOG("npc.kills"), sprintf(
      "%s: Ein Schatzwaechter killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
}

void die(int pd) {
  call_other(NPCMASTER, "del_npc", TP);
  command_me("prufe Wir brauchen Verstaerkung ... Hiiiilf..");
  return ::die(pd);
}

