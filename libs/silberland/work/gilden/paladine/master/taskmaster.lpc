// Task 10

nosave mixed Task10(object player) {
  object ob;
  string str;
  if(!ENV(player)) return 0;
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(10, player);
  }
  else {
    if(!ob->GetTask(10, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
      return _error(-3, getuid(player)+"/Task10");
    }
  }
  str=sprintf("Folgende Aufgabe hast Du zu loesen, %s: Im Bergwerk der "
      +"Zwerge soll sich - so heisst es - sich eine Horde Untote "
      +"herumtreiben. Deine ehrenvolle Aufgabe soll nun sein, noch %d dieser "
      +"Ausgeburten der Unterwelt zu vernichten.",
      player->Name(WER),14-(ob->GetVar()>14?14:ob->GetVar()));
  if (!test_bit(ob->GetFlag() ,0))
  str+=" Ach ja, wenn Du schon in der Gegend bist, dann vernichte auch den "
       "schrecklichen Balrog, der ebenfalls in diesem Bergwerk hausen soll!";
  return str;
}

nosave int CheckTask10(object player, int level) {
  object ob;
  if(call_other(PALADINMASTER, "CheckTask", player, 10)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(10, player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask10");
  }
  if((ob->GetVar()>=14 && test_bit(ob->GetFlag() ,0)) || 
      call_other(PALADINMASTER, "CheckTask", player, 10)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 10);
    tell_room(ENV(player), BSA( sprintf("Ah, %s, ich habe von den Zwergen "
        +"erfahren, dass Du Deine Aufgabe erledigt hast! Sehr gut, Paladin!", 
        player->name(WER)), GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}


// Task 11

nosave mixed Task11(object player) {
  object ob;
  string str;
  if(!ENV(player)) return 0;
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(11, player);
  }
  else {
    if(!ob->GetTask(11, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
      return _error(-3, getuid(player)+"/Task11");
    }
  }
  str=sprintf("Du musst folgende glorreiche Aufgabe erfuellen, %s: "
              "In der Hauptstadt der Dunkelelfen musst Du unter Beweis "
              "stellen, dass Du in der Lage bist ganze Rotten dieser "
              "Frevler hinzuraffen. Du musst noch %d Dunkelelfen in Dustys "
              "Namen erlegen!",player->Name(WER),20-ob->GetVar());
  return str;
}

nosave int CheckTask11(object player, int level) {
  object ob;
  if(call_other(PALADINMASTER, "CheckTask", player, 11)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(11, player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask11");
  }
  if((ob->GetVar()>=20) || 
      call_other(PALADINMASTER, "CheckTask", player, 11)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 11);
    tell_room(ENV(player), BSA( sprintf(
      "Ah, %s, ich habe soeben von Reisenden gehoert, dass Du genuegend "
      "Dunkelelfen ins Reich des Todes geschickt hast. Sehr gut, Paladin!", 
        player->name(WER)), GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}


