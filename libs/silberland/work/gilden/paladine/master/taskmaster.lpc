// Task 13

nosave mixed Task13(object player) {
  object ob;
  string str;
  if(!ENV(player)) return 0;
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(13, player);
    ob->SetVar(0);
  }
  else {
    if(!ob->GetTask(13, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
      return _error(-3, getuid(player)+"/Task13");
    }
  }
  str=sprintf("%s, folgende Aufgabe wartet auf Dich: In der Unterwelt, "
      +"nahe der dustyverdammten Stadt Dhrkion hausen schreckliche "
      +"Insektengeister, auch Sichelschrecken genannt. Von dieser "
      +"schrecklichen Plage musst Du %d zurueck in die Hoelle schicken!",
      player->Name(WER),4-ob->GetVar());
  return str;
}

nosave int CheckTask13(object player, int level) {
  object ob;
  if(call_other(PALADINMASTER, "CheckTask", player, 13)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(13, player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask13");
  }
  if(test_bit(ob->GetFlag() ,0)|| 
      call_other(PALADINMASTER, "CheckTask", player, 13)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 13);
    tell_room(ENV(player), BSA( sprintf("Ah, %s, bei Dusty, diese "
        +"Aufgabe hast Du vorzueglich gemeistert! Alle 4 Sichelschrecken "
        +"sind tot!", player->name(WER)), GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}




// Task 14

#define daemonen ({ "Azathoth", "Cthuga", "Cthulhu", "Glaaki", "Hastur", \
                    "Nyarlathothep", "Shodagoi", "Shubb-Niggurath", \
                    "Shudde-M'ell", "Tsathoggua", "Wendigo", "Yibb-Tsstl", \
                    "Yogsothoth" })

nosave mixed Task14(object player) {
  object ob;
  string str,welche,var;
  int i;

  if(!ENV(player)) return 0;
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(14, player);
  } else {
    if(!ob->GetTask(14, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
      return _error(-3, getuid(player)+"/Task14");
    }
  }
  welche="";
  var=ob->GetFlag();
  for(i=0;i<13;i++) {
    if(!test_bit(var, i)) {
      welche+=daemonen[i]+", ";
    }
  }
  if(welche=="") welche="Keine.";
  str=sprintf("Folgende Aufgabe hast Du zu loesen, %s: Es heisst, "
      +"dass das Boese in Form von Daemonen die Welt bald heimsuchen "
      +"wird. Dieses Boese lauert derzeit in einer anderen Dimension, "
      +"kann aber jederzeit unsere Welt heimsuchen. Ich sehe schon, Du "
      +"weisst von wem ich rede: Von den grossen Alten. Deine ehrenvolle "
      +"Aufgabe soll nun sein, einen jeden von ihnen im Namen Dusty's "
      +"niederzustrecken! Dir fehlen noch: %s\b\b.\n",player->Name(WER),welche);
  return str;
}

/*
/d/unterwelt/clementine/dimension/npc/az.c:
/d/unterwelt/clementine/dimension/npc/cthuga.c:
/d/unterwelt/clementine/dimension/npc/cthulhu.c:
/d/unterwelt/clementine/dimension/npc/glaaki.c:
/d/unterwelt/clementine/dimension/npc/hastur.c:
/d/unterwelt/clementine/dimension/npc/nya.c:
/d/unterwelt/clementine/dimension/npc/sho.c:
/d/unterwelt/clementine/dimension/npc/shubb.c:
/d/unterwelt/clementine/dimension/npc/shudde.c:
/d/unterwelt/clementine/dimension/npc/tsa.c:
/d/unterwelt/clementine/dimension/npc/wendigo.c:
/d/unterwelt/clementine/dimension/npc/yibb.c:
/d/unterwelt/clementine/dimension/npc/yog.c:
*/
nosave int CheckTask14(object player, int level) {
  object ob;
  int i, foo;
  string var;
  foo=0;
  if(call_other(PALADINMASTER, "CheckTask", player, 14)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(14,player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask14");
  }
  var=ob->GetFlag();
  for(i=0; i<=12;i++) 
    if(test_bit(var, i)) foo++;
  
  if(foo==13 || call_other(PALADINMASTER, "CheckTask", player, 14)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 14);
    tell_room(ENV(player), BSA( sprintf("Paladin! Eine unglaubliche Leistung! "
        +"Nur ein Auserwaehlter Dusty's konnte diese Aufgabe erledigen!"), 
        GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}


// Task 15

#define bestien ({ "die Gehoernte", "die Klauen", \
                   "die Reisser", "die Gefluegelte" })

nosave mixed Task15(object player) {
  object ob;
  string str,welche,var;
  int i;
  
  if(!ENV(player)) return 0;
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(15, player);
  }
  else {
    if(!ob->GetTask(15, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
      return _error(-3, getuid(player)+"/Task15");
    }
  }
  welche="";
  var=ob->GetFlag();
  for(i=0;i<4;i++) {
    if(!test_bit(var, i)) {
      welche+=bestien[i]+", ";
    }
  }
  if(welche=="") welche="Keine.";
  str=sprintf("Hoere, %s! In dem verfluchten Knarkh werden vier toedliche "
      +"Bestien der Unterwelt gehalten. Finde diese Bestien - und "
      +"vernichte sie! Dir fehlen noch folgende Bestien: %s\b\b." ,
      player->Name(WER),welche); 
  return str;
}

nosave int CheckTask15(object player, int level) {
  object ob;
  int i, foo;
  string var;
  foo=0;
  if(call_other(PALADINMASTER, "CheckTask", player, 15)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(15,player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask15");
  }
  var=ob->GetFlag();
  for(i=0; i<=3;i++) 
    if(test_bit(var, i)) foo++;
  
  if(foo==4 || call_other(PALADINMASTER, "CheckTask", player, 15)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 15);
    tell_room(ENV(player), BSA( sprintf("Paladin! Eine unglaubliche Leistung! "
        +"Nur ein Auserwaehlter Dusty's konnte diese Aufgabe erledigen!"), 
        GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}

/*
//
// FUNCTIONS FUNCTIONS FUNCTIONS FUNCTIONS FUNCTIONS FUNCTIONS FUNCTIONS 
//
*/
nosave int GetGuildLevel(object player) {
  int level;
  level=player->QueryProp(P_GUILD_LEVEL);
  if(level<1 || level>14) return -1;
  else return level;
}

nosave int _error(int nr, string arg) {
  string msg;
  switch(nr) {
    case  0: break;
    case -1: msg="Taskmaster: Spieler nicht gefunden ("+arg+")!";
             break;
    case -2: msg="Taskmaster: Falsche Gildenlevel ("+arg+")!";         
            break;
    case -3: msg="Falsches Taskobjekt ("+arg+")!";
            break;
    case -4: msg="Taskmaster: Taskobjektfehler! ("+arg+")!";
             break;
    default: msg=sprintf("%s, PO: %O", arg, previous_object());
  }
  if(nr<0) {
  tell_angrox(BSA(msg, ANSI_RED+ANSI_BLINK+"*** "+ANSI_NORMAL));
  tell_zordan(BSA(msg, ANSI_RED+ANSI_BLINK+"*** "+ANSI_NORMAL));
  write_error_log(msg+"\n");
  }
  return nr;
}


mixed ShowTask(mixed name) {
  int level;
  mixed task;
  if(!name=string2object(name)) return -1;
  if(!CheckIfAllowed()) return -2;
  level=GetGuildLevel(name);
  switch(level+1) {
    case 2: task=Task2(name); break; 
    case 3: task=Task3(name); break; 
    case 4: task=Task4(name); break; 
    case 5: task=Task5(name); break; 
    case 6: task=Task6(name); break; 
    case 7: task=Task7(name); break; 
    case 8: task=Task8(name); break; 
    case 9: task=Task9(name); break; 
    case 10: task=Task10(name); break; 
    case 11: task=Task11(name); break; 
    case 12: task=Task12(name); break;
    case 13: task=Task13(name); break; 
    case 14: task=Task14(name); break; 
    case 15: task=Task15(name); break; 
    default: task=0;         
  }
 return task;
}

int CheckTask(mixed name) {
  int level, task;
  if(!name=string2object(name)) return -1;
  if(!CheckIfAllowed()) return -2;
  level=GetGuildLevel(name);
  switch(level+1) {
    case 2: task=CheckTask2(name, level+1); break;  
    case 3: task=CheckTask3(name, level+1); break; 
    case 4: task=CheckTask4(name, level+1); break; 
    case 5: task=CheckTask5(name, level+1); break; 
    case 6: task=CheckTask6(name, level+1); break; 
    case 7: task=CheckTask7(name, level+1); break; 
    case 8: task=CheckTask8(name, level+1); break; 
    case 9: task=CheckTask9(name, level+1); break; 
    case 10: task=CheckTask10(name, level+1); break; 
    case 11: task=CheckTask11(name, level+1); break; 
    case 12: task=CheckTask12(name, level+1); break; 
    case 13: task=CheckTask13(name, level+1); break; 
    case 14: task=CheckTask14(name, level+1); break; 
    case 15: task=CheckTask15(name, level+1); break; 
    default: return 1;        
  }
 if(task<1) 
   return _error(task, sprintf("Error in CheckTask(taskmaster), "
     +"TP: %O, Fehlercode: %d!", name, task));
 return 1;
}

