#include <wizlevels.h>
#include <language.h>
#include <config.h>
#include <new_skills.h>
#include <properties.h>
#include <ansi.h>
#include <moving.h>
#include "../paladin.h"

nosave mixed object2string(mixed name);
nosave mixed string2object(mixed name);
nosave int GetGuildLevel(object player);
nosave int _error(int nr, mixed arg);


create() {
  if (is_clone(this_object())) {
    destruct(this_object());
    return 1;
  }
  seteuid(getuid(this_object()));
}

nomask query_prevent_shadow() { return 1; }


nosave int CheckIfAllowed() {
  object ob;
  string fname;
  ob=previous_object();
  fname=file_name(ob);
  if(!IS_ARCH(getuid(ob)) && member(UID_ALLOWED, getuid(ob))==-1) { 
      tell_angrox(sprintf("Versuchte Aenderung im Gildenmaster der Paladine "
         +"von %s (direkt!)\n", CAP(getuid(ob))));
      tell_zordan(sprintf("Versuchte Aenderung im Gildenmaster der Paladine "
         +"von %s (direkt!)\n", CAP(getuid(ob))));
  
      write_secure_log(ctime()+": Versuchte Aenderung im Taskmaster "
             +"von "+CAP(getuid(ob))+" (direkt!)\n");
      return 0;      
    }
  return 1;
}

nosave mixed object2string(mixed name) {
  if(objectp(name)) return getuid(name);
  if(stringp(name)) return lower_case(name);
  return 0;
}

nosave mixed string2object(mixed name) {
  if(objectp(name)) return name;
  if(stringp(name))
    if(name=find_player(name) || name=find_netdead(name)) return name;
  return 0;
}


// Task 2

nosave mixed Task2(object player) {
  object ob;
  string str;
  if(!ENV(player)) return 0;
  str=sprintf("Es gibt eine Aufgabe fuer Dich, %s: In der Naehe von Midas, "
      +"in Kyranda und im Dschungel gibt es Bettler und Landstreicher. "
      +"Zeige Deine Gutherzigkeit und bringe den Dreien jeweils "
      +"3000 Muenzen.",player->Name(WER)); 
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(2, player);
  }
  else {
    if(!ob->GetTask(2, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
      return _error(-3, getuid(player)+"/Task2");
    }
  }
  return str;
}

nosave int CheckTask2(object player, int level) {
  object ob;
  if(call_other(PALADINMASTER, "CheckTask", player, 2)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(2, player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask2");
  }
  if((test_bit(ob->GetFlag() ,0) && test_bit(ob->GetFlag(), 1) &&
      test_bit(ob->GetFlag(), 2))|| 
      call_other(PALADINMASTER, "CheckTask", player, 2)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 2);
    tell_room(ENV(player), 
      BSA(sprintf("Sehr gut, %s, Du hast Deine Gutherzigkeit unter "
          +"Beweis gestellt!", 
          player->name(WER)), GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}


// Task 3

nosave mixed Task3(object player) {
  object ob;
  string str;
  if(!ENV(player)) return 0;
  str=sprintf("%s, Du musst den Armen zeigen, dass Du auf ihrer Seite "
              "stehst. Im Huegelland huetet ein Schafhirte seine Schafe und "
              "er scheint erkrankt zu sein. Hilf ihm in Dusty's Namen!"
              ,player->Name(WER)); 
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(3, player);
  }
  else {
    if(!ob->GetTask(3, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
      return _error(-3, getuid(player)+"/Task3");
    }
  }
  return str;
}

nosave int CheckTask3(object player, int level) {
  object ob;
  if(call_other(PALADINMASTER, "CheckTask", player, 3)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(3, player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask3");
  }
  if((test_bit(ob->GetFlag() ,0)) ||
      call_other(PALADINMASTER, "CheckTask", player, 3)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 3);
    tell_room(ENV(player), 
      BSA(sprintf("Sehr gut, %s, Du hast uns gezeigt, dass Du den Armen "
                  "helfen kannst!", 
          player->name(WER)), GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}


// Task 4 

nosave mixed Task4(object player) {
  object ob;
  string str, txt;
  mapping vars;
  if(!ENV(player)) return 0;
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(4, player);
    ob->SetVar((["schatten":0, "seelendieb":0]));
  }
  else {
    if(!ob->GetTask(4, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
      return _error(-3, getuid(player)+"/Task4");
    }
  }
  vars=ob->GetVar();
  txt=sprintf("%d Seelendiebe und %d Schatten", 3-vars["seelendieb"], 
      3-vars["schatten"]);
  str=sprintf("Folgende Aufgabe hast Du zu loesen, %s: Im Gebirge, in einer "
      +"verborgenen Klamm, leben schreckliche Ausgeburten der Hoelle: "
      +"Seelendiebe und Schatten. Du musst nun eine gewisse Anzahl von "
      +"Seelendieben und Schatten toeten, und zwar %s!",
      player->Name(WER), txt);
  return str;
}

nosave int CheckTask4(object player, int level) {
  object ob;
  if(call_other(PALADINMASTER, "CheckTask", player, 4)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(4, player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask4");
  }
  if((test_bit(ob->GetFlag() ,0) && test_bit(ob->GetFlag() ,1)) || 
      call_other(PALADINMASTER, "CheckTask", player, 4)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 4);
    tell_room(ENV(player), BSA( sprintf("Ah, %s, Du hast die Seelendiebe " 
        +"und die Schatten vernichtet!",
        player->name(WER)), GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}

