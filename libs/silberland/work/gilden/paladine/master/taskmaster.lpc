    }
  }
  return str;
}

nosave int CheckTask5(object player, int level) {
  object ob;
  if(call_other(PALADINMASTER, "CheckTask", player, 5)) return 1;
  if(!ob=present(PALADINTASK, player)) return 0;
  if(!ob->GetTask(5, player)) {
    ob->remove();
    write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
    return _error(-3, getuid(player)+"/CheckTask5");
  }
  if((test_bit(ob->GetFlag() ,0) && test_bit(ob->GetFlag() ,1)) || 
      call_other(PALADINMASTER, "CheckTask", player, 5)) 
  {
    ob->remove();
    call_other(PALADINMASTER, "SetTask", player, 5);
    tell_room(ENV(player), 
      BSA(sprintf("Gratuliere, %s, Du hast den Ketzer vernichtet! Gepriesen "
          +"sei Dusty!", 
          player->name(WER)), GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  return 0;
}


// Task 6

