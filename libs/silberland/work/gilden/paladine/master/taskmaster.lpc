       "Burgwaechter, doch er wandte sich von Dusty ab, legte seinen "
       "Namen ab und nennt sich seitdem nur mehr 'Ketzer'! Reise nun nach "
       "Tijara und vernichte diesen Frevler! Ausserdem musst Du ein "
       "Amulett was er traegt Dusty opfern!",player->Name(WER)); 
  if(!ob=present(PALADINTASK, player)) {
    ob=CLONEOB(OBJ("task"));
    ob->move(player, M_NOCHECK|M_SILENT);
    ob->SetTask(5, player);
  }
  else {
    if(!ob->GetTask(5, player)) {
      ob->remove();
      write("Fehler! Falsches Taskitem! Bitte Magier verstaendigen!\n");
