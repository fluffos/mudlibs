void reset() {
   int i;
   object *online_users;
   object pl;
   feinde_reset--;
   if(feinde_reset < 0) {
     feinde=({});
     feinde_reset=5;
   }
   online_users=users();
   for(i=sizeof(kill_at_reset)-1; i>=0;i--) {
     if(pl=find_player(kill_at_reset[i]) &&
         member(feinde, pl) !=-1)
     {
       feinde+=({pl});
     }
   }
   for(i=sizeof(feinde)-1;i>=0;i--) {
     if(random(3)) 
       continue;
     if(member(online_users, feinde[i])!=-1) {
       tell_object(feinde[i], BS(sprintf("Du spuerst Dustys Zorn, Frevler%s!", 
             feinde[i]->QueryProp(P_GENDER)==FEMALE?"in":"")));
       feinde[i]->do_damage(10+random(6), this_object());
       if(!random(3)) 
         feinde[i]->SetProp(P_DISABLE_ATTACK, 10);
     }
   }
   set_next_reset(600);
}
