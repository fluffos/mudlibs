private int getTalentForGroup(int *group, int *activeTalents) {
  int i;
  for(i=0; i<sizeof(group); ++i) {
    if(member(activeTalents, group[i]) >= 0) {
      return group[i];
    }
  }

  return -1;
}

public void printTalents() {
	int* activeTalents;
	int openTalentSlots, i;

	write(sprintf("+%73'='s+\n", ""));
	write(sprintf("| %|71' 's |\n", "Erhaltene Segnungen"));
	write(sprintf("+%73'~'s+\n", ""));
	activeTalents = TALENTMASTER->GetActiveTalents(this_player());
	
  if(TP->QueryProp(P_GUILD_LEVEL) < 3) {
    write(sprintf("| %|71' 's |\n", "Segnungen kannst du erst ab Gildenstufe 3 erhalten."));
  } else {
    if(TP->QueryProp(P_GUILD_LEVEL) >= 3) {
      i = getTalentForGroup(BLESSING_GROUP_1, activeTalents);
      write(sprintf("| %|71' 's |\n", sprintf("Stufe 3: %s", (i>-1?BLESSING_NAMES[i]:"<keine>"))));
    }
    if(TP->QueryProp(P_GUILD_LEVEL) >= 6) {
      i = getTalentForGroup(BLESSING_GROUP_2, activeTalents);
      write(sprintf("| %|71' 's |\n", sprintf("Stufe 6: %s", (i>-1?BLESSING_NAMES[i]:"<keine>"))));
    }
    if(TP->QueryProp(P_GUILD_LEVEL) >= 9) {
      i = getTalentForGroup(BLESSING_GROUP_3, activeTalents);
      write(sprintf("| %|71' 's |\n", sprintf("Stufe 9: %s", (i>-1?BLESSING_NAMES[i]:"<keine>"))));
    }
    if(TP->QueryProp(P_GUILD_LEVEL) >= 12) {
      i = getTalentForGroup(BLESSING_GROUP_4, activeTalents);
      write(sprintf("| %|71' 's |\n", sprintf("Stufe 12: %s", (i>-1?BLESSING_NAMES[i]:"<keine>"))));
    }
    if(TP->QueryProp(P_GUILD_LEVEL) >= 15) {
      i = getTalentForGroup(BLESSING_GROUP_5, activeTalents);
      write(sprintf("| %|71' 's |\n", sprintf("Stufe 15: %s", (i>-1?BLESSING_NAMES[i]:"<keine>"))));
    }
  }
	write(sprintf("+%73'~'s+\n", ""));
}

public void printTalentMenu() {
	write(sprintf("|%|73' 's|\n", " Was moechtest du tun? "));
	write(sprintf("| %2s - %-66' 's |\n", "1", "Neue Segnung erhalten"));
	write(sprintf("| %2s - %-66' 's |\n", "2", "Segnung zuruecksetzen"));
	write(sprintf("| %2s - %-66' 's |\n", "X", "Beenden"));
	write(sprintf("+%73'='s+\n", ""));
	input_to("talentMenuSelection");
}


public void learnTalentMenu() {
	int *activeTalents;
  activeTalents = TALENTMASTER->GetActiveTalents(this_player());
	write(sprintf("+%73'='s+\n", ""));
	write(sprintf("| %|71' 's |\n", "Folgende Segnungen sind noch nicht festgelegt:"));
	if(getTalentForGroup(BLESSING_GROUP_1, activeTalents)<0 || getTalentForGroup(BLESSING_GROUP_2, activeTalents)<0 ||
     getTalentForGroup(BLESSING_GROUP_3, activeTalents)<0 || getTalentForGroup(BLESSING_GROUP_4, activeTalents)<0 || 
     getTalentForGroup(BLESSING_GROUP_5, activeTalents)<0) { 
    if(getTalentForGroup(BLESSING_GROUP_1, activeTalents)<0) write(sprintf("| %|71' 's |\n", "Stufe 3: <keine>"));
    if(getTalentForGroup(BLESSING_GROUP_2, activeTalents)<0) write(sprintf("| %|71' 's |\n", "Stufe 6: <keine>"));
    if(getTalentForGroup(BLESSING_GROUP_3, activeTalents)<0) write(sprintf("| %|71' 's |\n", "Stufe 9: <keine>"));
    if(getTalentForGroup(BLESSING_GROUP_4, activeTalents)<0) write(sprintf("| %|71' 's |\n", "Stufe 12: <keine>"));
    if(getTalentForGroup(BLESSING_GROUP_5, activeTalents)<0) write(sprintf("| %|71' 's |\n", "Stufe 15: <keine>"));
    write(sprintf("+%73'='s+\n", ""));
    write(BS("Die Segnung welcher Stufe willst du erhalten? [X = abbrechen]"));
    input_to("selectTalentGroup");
	} else {
    write(sprintf("| %|71' 's |\n", "Du hast alle Segnungen erhalten."));
    write(sprintf("+%73'='s+\n", ""));
	}
}

public void selectTalentGroup(string sGrp) {
  int grp, i, *grpTalents;

  if(lowerstring(sGrp) == "x") {
		write(BS("Auf bald!"));
		return;
	}

  if(sscanf(sGrp, "%d", grp) != 1) {
		write(BS("Du musst eine Stufe angeben!"));
		learnTalentMenu();
		return;
	}

  if(member(({3, 6, 9, 12, 15}), grp) < 0) {
    write(BS("Ungueltige Stufe!"));
    learnTalentMenu();
    return;
  }

  grp /= 3;
  grp--;
  grpTalents = BLESSING_GROUPS[grp];

  if(getTalentForGroup(grpTalents, TALENTMASTER->GetActiveTalents(TP)) >= 0) {
    write(BS("In dieser Gruppe hast du bereits eine Segnung ausgewahlt."));
    learnTalentMenu();
    return;
  }

  write(sprintf("+%73'='s+\n", ""));
  for(i=0; i<sizeof(grpTalents); ++i) {
    write(sprintf("| %|71' 's |\n", sprintf("%d. %s", grpTalents[i], BLESSING_NAMES[grpTalents[i]])));
  }
  write(sprintf("+%73'='s+\n", ""));
  write(BS("Welche Segnung willst du erhalten? [X = abbrechen]"));
  input_to("learnTalent", 0, grpTalents);
}

public void learnTalent(string idStr, int *grpTalents) {
	int id, ret, grp;

	if(lowerstring(idStr) == "x") {
		write(BS("Auf bald!"));
		return;
	}
	
	if(sscanf(idStr, "%d", id) != 1) {
		write(BS("Du musst eine Segnungsnummer angeben!"));
		learnTalentMenu();
		return;
	}

	if(member(grpTalents, id) < 0) {
    write(BS("Ungueltige Auswahl fuer die gewaehlte Stufe."));
    learnTalentMenu();
    return;
  }

	if(TALENTMASTER->HasTalent(this_player(), id)) {
		write(BS("Dieses Talent ist bereits aktiv."));
		learnTalentMenu();
		return;
	}

	if(id < 0 || id > MAX_TALENT_NR) {
		write(BS("Unbekannte Talentnummer."));
		learnTalentMenu();
		return;
	}

	ret = TALENTMASTER->ActivateTalent(this_player(), id);
	if(ret <= 0) {
		if(ret == -1){
			write(BS("Fehler: Du darfst das nicht!\n"));
		} else if(ret == -2) {
			write(BS("Fehler: Du bist kein Barde!\n"));
		} else if(ret == 0) {
			write(BS("Fehler: Aktivierung fehlgeschlagen.\n"));
		} else {
			write(BS("Fehler: " + ret + "\n"));
		}
		return;
	} else {
		write(BS("Du fuehlst wie dich goettliche Inspiration durchstroemt."));
		write(BS(sprintf("Du hast die Segunung '%s' erhalten.", BLESSING_NAMES[id])));
		say(BS(sprintf("%s sieht gesegnet aus!", this_player()->Name(WER, 1))));
	}
	return;
}


public void resetTalents(string confirm) {
	int ret;
	if(lowerstring(confirm) != "zuruecksetzen") {
		write(BS("Abgebrochen."));
		return;
	}

	ret = TALENTMASTER->ResetTalents(this_player());
	if(ret > 0) {
			write(BS(sprintf("Du kannst deine Talente noch nicht zuruecksetzen. Du musst noch Gegenstaende "
                       "im Gegenwert von %d Muenzen opfern.", ret)));
      return;
	}

	write(BS("Dusty nimmt die Segnungen von dir!"));
	this_player()->SetProp(P_SP, 0);
	this_player()->AddExp(-50000);
}

public void resetTalentMenu() {
	printTalents();
	write(sprintf("|%|73' 's|\n", " Zuruecksetzen der Segnungen bestaetigen! "));
	write(sprintf("|%-73' 's|\n", " Wenn du deine Segnungen zuruecksetzt musst du folgendes bedenken: "));
	write(sprintf("|%-73' 's|\n", "   1. Jedes Zueruecksetzen kostet 50.000 Erfahrungspunkte.  "));
	write(sprintf("|%-73' 's|\n", "   2. Bevor du nochmals Zuruecksetzen kannst, verlangt Dusty ein Opfer. "));
	write(sprintf("+%73'='s+\n", ""));
	write("[Zum Zuruecksetzen gib 'zuruecksetzen' ein] ==> ");
	input_to("resetTalents");
}


public void talentMenuSelection(string choice) {
	if(choice == "1") {
		learnTalentMenu();
	} else if(choice == "2") {
		resetTalentMenu();
	} else if(lowerstring(choice) == "x") {
		write(BS("Auf bald!"));
	} else {
		printTalentMenu();
	}
}

public void wantToManageTalents(string yesno) {
	if(yesno == "j" || yesno == "ja") {
		printTalents();
		printTalentMenu();
	}
}

public int cmd_meditation() { 
	int alignment;
	if(this_player()->InFight()) {
		write(BS("Das geht nicht, wenn du gerade kaempfst!"));
		return -1;
	}

	write(BS("Du versinkst in stiller Meditation und oeffnest Dusty deinen Geist.\n"));
	say(BS(TP->name(WER)+" versinkt in stiller Meditation.\n"));
	
	// TALENTE LERNEN
	if(this_player()->QueryProp(P_GUILD) == "paladine") {
		write(BS("Du spuehrst Dustys Naehe in deinem Geist. Moechtest du deine Segnungen verwalten? [ja/nein]"));
		input_to("wantToManageTalents");
	} else {
    write(BS("Nichts geschieht."));
  }	
  return 1;
}


public int cmd_waschen(string str) {
  notify_fail("WAS willst du WO waschen?\n");
  if(str != "haende in becken" && str != "haende in waschbecken" &&
     str != "hand in becken" && str != "haende in becken") return 0;

  write(BS("Du waeschst deine Haende im Becken und fuehlst dich seelisch gereinigt."));
  say(BS(TPN+" waescht " + TP->QueryPossPronoun(WESSEN) + "e Haende im Becken."));
  return 1;
}

public int cmd_beten() {
  write(BS("Du kniest vor dem Altar nieder und haeltst eine kurze Andacht an Dusty."));
  say(BS(TPN+" kniet vor dem Altar nieder und haelt eine kurze Andacht."));

  if(TP->QueryProp(P_GUILD) == "nekromanten" || TP->QueryProp(P_RACE) == "Dunkelelf") {
    write(BS("Dustys Zorn faehrt auf dich herab, Kreatur der Finsternis!"));
    say(BS(TPN + " zuckt schmerzerfuellt zusammen!"));
    TP->AddHp(-random(50));
    return -1;
  }

  if(TP->QueryProp(P_ALIGN) < 300) {
    write(BS("Nichts geschieht. Dusty scheint dich nicht zu erhoeren."));
    return -1;
  }

  if(TP->QueryProp(P_GHOST) || TP->QueryProp(P_FROG)) {
    write(BS("Du spuehrst Dustys Gnade deinen Geist beruehren und dein Koerper materialisiert sich wieder."));
    say(BS(TPN + " wird von hellem Licht eingehuellt."));
    TP->SetProp(P_GHOST, 0);
    TP->SetProp(P_FROG, 0);
  } else {
    write(BS("Eine wohlige Waerme und Guete umfaengt dich. Moechtest du nach deinem naechsten Tod "
             "in diesem Tempel wieder erwachen? [ja/nein]"));
    input_to("set_pray_room_here");
  }

  return 1;
}

public void set_pray_room_here(string input) {
  if(input == "ja" || input == "j") {
    write(BS("Du fuehlst, wie Dustys Licht dich umarmt und Waerme deine Seele durchflutet. Deine Seele ist nun hier verankert."));
    write(BS("Wenn du das naechste mal stirbst, wirst du hier erwachen."));
    TP->SetProp(P_TMP_PRAY_ROOM, this_object());
  } else {
    write(BS("Die wohlige Waerme vergeht wieder. Nichts weiter geschieht."));
  }
}
