
#include "../paladin.h"
inherit ROOM("w_weg_inh");


#include <properties.h>
#include <language.h>

create() {
  ::create();
 
  SetProp(P_HIDE_EXITS, ({ "osten" }) );

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2]+
    " Eine kleine Treppe fuehrt Dich im Osten nach unten.");

  AddDetail( ({ "treppe" }),
    "Eine ziemlich stabile und breite Treppe.");

  AddExit( "norden",   "./w_weg_a1" );
  AddExit( "sueden",   "./w_weg_a3" );
  AddExit( "ostunten", "./burg_b2" );
  AddExit( "osten",    "./burg_b2" );
}


