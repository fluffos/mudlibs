/*
** Burg der Paladine - Drachenturm
** Angox@SL
** 
** 16.03.1998
*/

inherit "std/room";

#include <player.h>
#include <properties.h>
#include <language.h>
#include "../paladin.h"

create() {
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf dem Drachenturm der Burg Sturmfels");
  SetProp (P_INT_LONG,
      "Nachdem Du die Treppe erklommen hast, stehst Du auf der "
      "Turmspitze. Der Turm wird von einer Mauer abgegrenzt, die "
      "mit Zinnen versehen ist. Der Boden des Turmes ist mit "
      "schweren Steinplatten ausgelegt, und trotzdem befinden sich "
      "fingertiefe Krallenspuren in den Platten. Was immer diese "
      "Spuren verursacht hat, scheint sehr scharfe Krallen zu haben.");
    
  AddDetail( ({"raum", "turm"}), QueryProp(P_INT_LONG));
  AddDetail(({"burg", "sturmfels"}),
      "Die Burg Sturmfels ist wahrlich eine praechtige Burg. Sie "
      "ist gut zu verteidigen, und wird sicherlich nicht so schnell "
      "eingenommen.");
  AddDetail( ({"boden"}), 
      "Der Boden ist mit schweren Steinplatten ausgelegt. Sie weisen "
      "einige tiefe Krallenspuren auf. Du schluckst trocken.");
  AddDetail( ({"krallenspuren", "spuren"}),
      "Was immer so tiefe Spuren macht, Du moechtest ihm "
      "nicht begegnen wenn es wuetend ist."); 
  AddDetail("himmel", 
    "Der ist - dustyseidank - noch immer ober Dir.");
  AddDetail( ({"mauer"}),
      "Die Turmspitze wird von einer Mauer mit Zinnen umringt.");
  AddDetail( ({"krallen"}),
      "Schluck, die muessen gross sein.");
  AddDetail( ({"zinnen"}),
      "Die Mauer des Turmes hat mannshohen Zinnen."); 
  AddDetail( ({"steinplatten", "platten"}),
      "Die Steinplatten bilden den Boden des Turmes. Sie bestehen aus "
      "Granit und weisen einige tiefe Krallenspuren auf.");
  AddDetail( ({"spitze", "turmspitze"}), 
      "Du befindest Dich hier auf der offenen Turmspitze. Ober Dir "
      "kannst du den Himmel erkennen.");
  AddDetail(({"goettin", "dusty"}),
    "Dusty ist die Goettin der Paladine. Ihr gilt ihre Huldigung.");
  AddDetail("huldigung", 
    "Gehuldigt wird in der Kapelle, aber nicht hier!");
  AddDetail("treppe", 
    "Die Treppe auf den Wehrgang ist sehr schmal. Wenn Du da raufgehst, "
    "musst Du vorsichtig sein, um nicht auszurutschen und runter zu "
    "stuerzen.");
  AddDetail("wehrgang", 
    "Der Wehrgang befindet sich auf den maechtigen Burgmauern. Hier "
    "patrollieren die wachsamen Paladine der Burg, um jegliche "
    "Gefahr sofort zu erblicken.");
  AddDetail("gefahr",
    "Momentan scheint aber alles ruhig zu sein.");
  AddDetail("paladine", 
    "Die Paladine sind maechtige Kaempfer, stets bereit, das Boese "
    "zu vernichten.");
  AddDetail("boese", 
    "Das Boese ist immer und ueberall!");
  AddDetail("kaempfer", 
    "Die hier ausgebildenten Paladine sind ausgezeichnete Kaempfer. "
    "Fordere sie bloss nicht heraus, dass waere Dein Ende.");
  AddDetail("ende", 
    "Der Tod fluestert Dir zu: DU WEISST SCHON WAS ICH MEINE!");
  AddDetail("tod",
    "Du Weisst Schon Wer Das Ist.");
  AddDetail(({"mauern", "burgmauern"}),
    "Die Burgmauern bestehen aus haertestem Granit des Silbergebirges. "
    "Sie sind meterdick und halten sicherlich jeder Belagerung stand.");
  AddDetail( ({"silbergebirge", "gebirge"}),
    "Das Silbergebirge ist das groesste Gebirge im Silberland. Von hier "
    "oben kannst Du es wunderbar ueberblicken.");
  AddDetail("silberland", 
    "Du befindest Dich im Silberland.");
  AddDetail(({"granit", "baumaterial", "material"}),
    "Granit ist fuer Burgmauern ein teures, aber gutes Baumaterial.");
  AddDetail("belagerung", 
    "Im Moment wird die Burg nicht belagert, sonst waerst Du ja nicht "
    "hier, oder?");
  AddDetail("moment", 
    "Ja. Jetzt. Hier. In diesem Moment.");
  
  AddExit("unten", "./burg_no_turm3");
  AddItem(NPC("drache"), REFRESH_DESTRUCT);
}

