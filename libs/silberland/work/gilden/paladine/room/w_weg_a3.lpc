
#include "../paladin.h"

inherit ROOM("w_weg_inh");

#include <properties.h>
#include <language.h>

create() {
  ::create();

  AddDetail( ({"stein", "besonderer"}),
      "Tatsaechlich, ein besonderer Stein. Es sieht so aus, als koenntest "
      "Du den Stein druecken!");
  AddItem( NPC("waechter"), REFRESH_DESTRUCT );

  AddCmd( ({"druecke", "drueck"}), "stein_druecken");
  
  AddExit( "norden", "./w_weg_a2" );
  AddExit( "osten",  "./w_weg_b3" );
  AddExit( "oben",  "./burg_sw_turm1" );
}

int stein_druecken(string str) {
  if(!str) return 0;
  if(str!="stein") return 0;
  tell_object(TP, BS("Du drueckst den Stein. Du hoerst ein leises Rumpeln "
      "unter Dir."));
  tell_room(ME, BS(sprintf("%s fummelt an der Wand herum. Ploetzlich ist "
      "ein Rumpeln zu hoeren.", TP->Name(WER))), ({TP}));
  call_other(ROOM("burg_geheim2"), "SetKnopf1");
  return 1;  
}
