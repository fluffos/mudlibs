
#include "../paladin.h"

inherit ROOM("w_weg_inh");

#include <properties.h>
#include <language.h>

create() {
  ::create();
  SetProp(P_INT_LONG,
    "Du stehst auf dem Wehrgang der Burg Sturmfels. Dicke Planken sind "
    "fest in die Wand eingebracht worden und bilden den Boden. Ueber "
    "breite Schiessscharten hinweg hast Du einen wunderbaren Ausblick "
    "auf das weite Land. Ausserhalb wird die Burg von einem Graben "
    "umgeben, in dem Wasser fliesst. Im Norden befindet sich ein Turm, "
    "im direkten Anschluss an den Wehrgang. Eine Treppe fuehrt nach oben.");
  AddItem( NPC("waechter"), REFRESH_DESTRUCT );

  AddDetail( ({"turm"}),
    "Der Turm ist in direkten Anschluss an der Wehrgang gebaut worden. "
    "Eine Treppe fuehrt nach oben zu seinen weiteren Stockwerken. Schon "
    "von hier aus kannst Du seine Zinnen erkennen.");
  AddDetail( ({"anschluss"}),
      "Direkt an den Wehrgang gebaut.");
  AddDetail( ({"treppe"}),
      "Die steinerne Treppe fuehrt nach oben.");
  AddDetail("zinnen",
      "Die Zinnen sitzen am oberen Teil des Turmes. Offenbar hat der "
      "Turm nur ein Stockwerk.");
  AddDetail( ({"stockwerk"}),
      "Der Turm besitzt nur ein Stockwerk. Eine Treppe fuehrt nach oben.");
  AddDetail( ({"teil"}),
      "Welches Teil moechtest Du genauer untersuchen?");
  
  AddExit( "sueden", "./w_weg_e2" );
  AddExit( "westen", "./w_weg_d1" );
  AddExit( "oben", "./burg_no_turm1");    
}
