
/*
**
** Westlicher Haupthof der Paladine
** 30.04.1998 Angrox, Zordan
**
*/

inherit "std/room";

#include <player.h>
#include <properties.h>
#include <language.h>
#include "../paladin.h"

create() {
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Burghof in Burg Sturmfels");
  SetProp (P_INT_LONG, 
      "Du befindest Dich inmitten des Burghofes der Burg Sturmfels. "
      +"Der Boden des Hofes besteht aus festgestampftem Lehm, auf dem "
      +"Unmengen von Stroh verteilt wurde. Westlich von Dir scheint sich "
      +"der hiesige Laden zu befinden, waehrend sich im Norden wohl "
      +"eine Schenke befindet. Der Burghof erstreckt sich weiter nach "
      +"Osten. Eine Treppe nach Westoben fuehrt auf den Wehrgang rund um "
      +"die Burgmauer.");
    
  AddDetail("unmengen", 
      "Das ist wirklich sehr, sehr viel Stroh.");
  AddSpecialDetail(({"raum", "hof", "burghof"}), "raum");
  AddDetail(({"burg", "sturmfels"}),
      "Die Burg Sturmfels ist wahrlich eine praechtige Burg. Sie "
      "ist gut zu verteidigen, und wird sicherlich nicht so schnell "
      "eingenommen.");
  AddDetail("boden", 
      "Der Boden hier besteht aus festgestampftem Lehm. Ueberall am "
      "Boden ist Heu verstreut.");
  AddDetail("himmel", 
      "Der ist - dustyseidank - noch immer ober Dir.");
  AddDetail("lehm",
      "Der Lehm hier ist festgestampft, dadurch ergibt sich ein "
      "recht harter und rutschfester Boden.");
  AddDetail(({"stroh", "heu"}),
      "Das Stroh ist am ganzen Burghof am Boden verstreut. Zu was es "
      "wohl gut sein mag?");
  AddDetail("norden", 
      "Im Norden von Dir befindet sich wohl der Waffenladen. Das Schild "
      "ueber der Tuer weist ihn zumindest dafuer aus.");
  AddDetail("tuer", 
      "Du siehst zwei Tueren: Eine im Westen, und eine im Norden.");
  AddDetail("schild", 
      "Du siehst zwei Schilder: Das ueber der westlichen Tuer zeigt "
      "eine Ruestung und das im Norden zeigt ein Schwert und ein Schild.");
  AddDetail(({"schwert", "schwert und schild", "schenke"}),
      "Das muss wohl die Schenke 'Schwert und Schild' sein.");
  AddDetail("waffenladen", 
      "Schau doch einfach mal rein!");
  AddDetail("norden",
      "Im Norden fuehrt eine Tuer in die hiesige Schenke. Ueber der Tuer "
      "haengt ein Schild.");
  AddDetail("osten", 
      "Nach Osten erstreckt sich der Burghof.");
  AddDetail("westoben", 
      "Eine Treppe Richtung Westoben fuehrt auf den Wehrgang rund um "
      "die Burgmauer.");
  AddDetail("treppe", 
      "Die Treppe auf den Wehrgang ist sehr schmal. Wenn Du da raufgehst, "
      "musst Du vorsichtig sein, um nicht auszurutschen und runter zu "
      "stuerzen.");
  AddDetail("westen",
      "Im Westen scheint sich der Ruestungs- und Waffenladen zu befinden. "
      "Ueber der Tuer haengt ein Schild.");
  AddDetail("ruestung", 
      "Das ist auf dem Schild des Waffenladens.");
  AddDetail(({"laden", "waffenladen", "ruestungsladen"}),
      "Der befindet sich im Westen.");
  AddDetail("wehrgang", 
      "Der Wehrgang befindet sich auf den maechtigen Burgmauern. Hier "
      "patroullieren die wachsamen Paladine der Burg, um jegliche "
      "Gefahr sofort zu erblicken.");
  AddDetail("gefahr",
      "Momentan scheint aber alles ruhig zu sein.");
  AddDetail("paladine", 
      "Die Paladine sind maechtige Kaempfer, stets bereit, das Boese "
      "zu vernichten.");
  AddDetail("boese", 
      "Das Boese ist immer und ueberall!");
  AddDetail(({"ende","lars"}), 
      "Leg Dich mit den Paladinen an und Du wirst Lars schnell besuchen.");
  AddDetail("kaempfer", 
      "Die hier ausgebildenten Paladine sind ausgezeichnete Kaempfer. "
      "Fordere sie bloss nicht heraus, dass waere Dein Ende.");
  AddDetail(({"mauern", "burgmauern"}),
      "Die Burgmauern bestehen aus haertestem Granit des Silbergebirges. "
      "Sie sind meterdick und halten sicherlich jeder Belagerung stand.");
  AddDetail(({"silbergebirge","gebirge"}),
      "Das Silbergebirge ist das groesste Gebirge im Silberland.");
  AddDetail("silberland", 
      "Du befindest Dich im Silberland.");
  AddDetail(({"granit", "baumaterial", "material"}),
      "Granit ist fuer Burgmauern ein teures, aber gutes Baumaterial.");
  AddDetail("belagerung", 
      "Im Moment wird die Burg nicht belagert, sonst waerst Du ja nicht "
      "hier, oder?");
  AddDetail("moment", 
      "Ja. Jetzt. Hier. In diesem Moment.");
  
  AddExit("osten", "./burg_c2");
  AddExit("norden", "./burg_b1");
  AddExit("westen", "./burg_a2");
  AddExit("westoben", "./w_weg_a2");
  AddItem(NPC("waechter"), REFRESH_DESTRUCT);
}

string raum() {
 return QueryProp(P_INT_LONG);
}
