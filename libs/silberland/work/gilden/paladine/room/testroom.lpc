
#include "../paladin.h"

inherit "std/room";
inherit "/gilden/paladine/master/sequencer";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Testraum" );
  SetProp( P_INT_LONG,
    "Hier ist nichts." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

}
