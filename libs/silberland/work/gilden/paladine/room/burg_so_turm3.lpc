/*
** Burg der Paladine - Drachenturm
** Angox@SL
** 
** 16.03.1998
*/

inherit "std/room";

#include <player.h>
#include <properties.h>
#include <language.h>
#include "../paladin.h"

create() {
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einer schmalen Wendeltreppe");
  SetProp (P_INT_LONG,
      "Du befindest Dich hier auf einer schmalen Wendeltreppe innerhalb "
      "eines Turmes auf der Burg Sturmfels. Die Treppe wird nur durch "
      "winzige Oeffnungen an der Aussenwand erhellt. Pass bloss auf, sonst "
      "faellst Du nach unten und brichst Dir alle Knochen. Ein Eingang "
      "fuehrt hier in einen winzigen Nebenraum.");
    
  AddDetail( ({"raum", "turm"}), QueryProp(P_INT_LONG));
  AddDetail(({"burg", "sturmfels"}),
      "Die Burg Sturmfels ist wahrlich eine praechtige Burg. Sie "
      "ist gut zu verteidigen, und wird sicherlich nicht so schnell "
      "eingenommen.");
  AddDetail( ({"boden"}), 
      "Hier ist eigentlich kein Boden, sondern eine Treppe.");
  AddDetail( ({"treppe", "wendeltreppe"}), 
      "Die Treppe fuehrt sowohl nach oben wie auch nach unten. "
      "Sie verlaeuft sehr steil, und Du solltest wirklich aufpassen, "
      "dass Du hier nicht stolperst.");
  AddDetail( ({"oeffnungen"}),
      "Durch die Oeffnungen dringt Licht herein und erhellt den Raum etwas.");
  AddDetail( ({"aussenwand", "wand"}),
      "In der Aussenwand befinden sich etliche Oeffnungen, durch denen Licht "
      "hereinfaellt.");
  AddDetail( ({"licht"}), 
      "Das Licht, welches durch die Oeffnungen faellt, erhellt den winzigen Raum.");
  AddDetail( ({"waende"}),
      "Die Waende des Turmes sind ziemlich dich. An der Aussenwand befinden sich "
      "etliche Oeffnungen, durch welches Licht faellt.");
  AddDetail( ({"knochen"}),
      "Deine Knochen natuerlich. Wenn Du hier runterfaellst, sind wohl etliche "
      "davon gebrochen.");
  AddDetail( ({ "decke"}), 
      "Die Decke ist ueber Dir.");
  AddDetail( ({"eingang"}),
      "Der Eingang fuehrt in einen anderen kleinen Raum. Neben dem Eingang ist "
      "ein kleines Schild angebracht.");
  AddDetail( ({"schild"}),
      "Du koenntest es lesen.");
  AddReadDetail( ({"schild"}),
      "+===========================+\n"
      "|                           |\n"
      "|                           |\n"
      "|      PALADIN XELIAS       |\n"
      "|                           |\n"
      "|                           |\n"
      "+===========================+\n");
  AddDetail( ({"nebenraum"}),
      "Schau rein, dann siehst Du, was sich da befindet!");
  AddExit("unten", "./burg_so_turm2");
  AddExit("oben", "./burg_so_turm4");
}

