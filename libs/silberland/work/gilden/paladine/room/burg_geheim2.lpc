
#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

nosave int *knopf=({0,0});

nosave int DoOpen();
nosave int CloseSecret();
nosave int OpenSecret();

create() {
  ::create();
  SetProp(P_INT_SHORT, "Unter der Burg Sturmfels" );
  SetProp(P_INT_LONG,
      "Du bist hier in einem kleinen Gang unter der Paladinburg. "
      "Alles besteht hier aus grobem Fels. Der Gang wird nur spaerlich "
      "beleuchtet. Ansonsten gibt es nichts besonderes hier." );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang", "raum" }), 
      QueryProp(P_INT_LONG));
  AddDetail( ({"boden"}),
      "Der Boden besteht aus roh behauenem Fels.");
  AddDetail( ({"decke"}),
      "Die Decke ist ueber Dir. Sie besteht, wie der gesamte Gang, "
      "aus roh behauenem Fels.");
  AddDetail(({"nichts"}),
      "Du siehst nichts.");
  AddDetail( ({"waende", "wand"}),
      "Die Waende bestehen, wie alles hier, aus roh behauenem Fels. "
      "An den Waenden stecken Fackeln in Fackelhaltern. Ueberall befinden "
      "die geheiligten Symbole der Dusty.");
  AddDetail( ({"fackeln"}),
      "Die Fackeln erhellen den Gang nur spaerlich.");
  AddDetail( ({"fackelhalter"}),
      "Die Fackelhalter sind sehr schlicht und zweckgemaess gehalten. "
      "Sie bestehen aus Eisen oder Stahl.");
  AddDetail( ({"eisen", "stahl"}),
      "Daraus bestehen die Fackelhalter");
  AddDetail( ({"fels"}),
      "Der Fels hier sieht sehr roh bearbeitet aus. Er ist kuehl.");
  AddDetail( ({"symbole"}),
      "Auf den Waenden sind die heiligen Symbole der Dusty - "
      "Schwert und Rose - abgebildet.");
  AddDetail( ({"rose"}),
      "Die Rose ist eines der heiligen Symbole der Dusty. Die Blaetter "
      "sind sehr gut gearbeitet.");
  AddDetail( ({"blaetter"}), 
      "Die Blaetter sind exzellent gearbeitet. Ein Blatt faellt Dir "
      "besonders auf.");
  AddDetail( ({"blatt"}),
      "Huch. Als Du genauer hinschaust, faellt Dir auf, dass es ein Knopf "
      "ist.");
  AddDetail( ({"knopf"}), 
      "Du koennstest ihn druecken.");
  AddDetail( ({"schwert"}), 
      "Das Schwert ist eines der heiligen Symbole der Dusty. Das Schwert "
      "hat einen auffaellig Griff.");
  AddDetail( ({"griff"}),
      "Hm, Du hast Dich wohl getaeuscht. Da ist nichts ungewoehnliches.");
  AddDetail( ({"dusty", "goettin"}),
      "Dusty ist die Goettin der Paladine.");
  AddDetail( ({"burg", "paladinburg"}),
      "Du befindest Dich unter der Paladinburg.");
  AddDetail( ({"paladine", "verteidiger"}),
      "Die Paladine sind die Verteidiger des Guten. Pass bloss auf, "
      "dass sie Dich nicht hier unten erwischen.");
  AddDetail( ({"gute"}),
      "Das Gute ist hier immer und ueberall.");
  AddDetail( ({"westwand"}),
      "Die faellt nichts besonderes an der Westwand auf.");
  
  AddCmd( ({"druecke", "drueck"}), "knopf_druecken");
  
  AddExit("sueden", ([EX_DEST:ROOM("burg_geheim3"),
                      EXG_ID:"\n_s_waechter",
                      EXG_PLMSG: "Der Schatzwaechter haelt Dich fest!\n",
                      EXG_RMMSG: "@Wer@ wird von der Wache festgehalten!\n"]));

  AddExit("osten", ROOM("burg_geheim1"));
  AddItem(NPC("schatzwaechter"), REFRESH_DESTRUCT);
  AddItem(NPC("schatzwaechter"), REFRESH_DESTRUCT);
}

reset() {
 set_next_reset(1000+random(200));
  ::reset();
  if(find_call_out("CloseSecret")==-1 && knopf[0]&&knopf[1]) 
    CloseSecret();
  knopf=({0,0});
}

int knopf_druecken(string str) {
  if(!str) return 0;
  if(str!="knopf") return 0;
  knopf[0]=1;
  if(!knopf[1]) {
    tell_object(TP,BS("Du drueckst den Knopf. Ein Rumpeln in der Wand ist zu "
        "hoeren. Ansonsten passiert nichts."));
    tell_room(ME, sprintf("%s drueckt an der Wand herum.\n", TP->Name(WER)),
        ({TP}));
    return 1;
  }
  if(knopf[0]&&knopf[1]) {
    tell_object(TP, BS("Du drueckst den Knopf.\n"));
    tell_room(ME, sprintf("%s drueckt an der Wand herum.\n", TP->Name(WER)),
        ({TP}));
    DoOpen();
    return 1;
  }
  return 1;
}

nosave int DoOpen() {
  if(knopf[0]&&knopf[1]) {
    call_out("OpenSecret", 4);
    call_out("CloseSecret", 500+random(500));
    return 1;
  }
}

int SetKnopf1() {
  knopf[1]=1;
  tell_room(ME, "Ein Rumpeln ist von hinter der Westwand zu hoeren.\n");
  DoOpen();
  return 1;
}

nosave int OpenSecret() {
  tell_room(ME,BS("Ein Rumpeln ist zu hoeren und eine geheime Tuer im Westen "
      "schwingt auf."));
  call_other(ROOM("burg_graben1"), "OpenSecret");
  AddExit("westen", ROOM("burg_graben1"));
  return 1;
}

nosave int CloseSecret() {
  tell_room(ME, "Die Geheimtuer schwingt wieder zu.\n");
  knopf=({0,0});
  call_other(ROOM("burg_graben1"), "CloseSecret");
  RemoveExit("westen");
  return 1;
}
