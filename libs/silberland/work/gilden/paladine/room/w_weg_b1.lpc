
#include "../paladin.h"

inherit ROOM("w_weg_inh");

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2]+ 
    " Ein kleiner Steg fuehrt ueber den Abgrund nach Osten.");

  AddDetail( ({ "steg","seite" }),
    "Der Steg besteht aus ein paar Brettern. Er sieht aber stabil genug aus, "
    "so dass man wohl auf die andere Seite klettern kann.");

  AddDetail( ({ "bretter" }),
    "Die sind aus Holz und sehen doch recht stabil aus.");

  AddDetail( ({ "abgrund","klettern" }),
    "Solltest Du nicht geschickt genug sein, koenntest Du beim Klettern "
    "vielleicht abstuerzen.");

  AddCmd( ({ "kletter","klettere" }) , "kletterfkt" );

  AddExit( "westen", "./w_weg_a1" );
}

int kletterfkt(string str) {
  notify_fail("Worueber willst Du klettern?\n");
  if (str != "ueber steg") return 0;
  if (random(TP->QueryAttribute(A_DEX)) < 5) {
    write(BS(
      "Du bist zu ungeschickt und stuerzt ab."));
    TP->move( ROOM("burg_c2") , M_GO, 0,
      "faellt den Abgrund hinunter",
      "faellt von oben herein");
    TP->reduce_hit_point(20+random(20));
    return 1;
  }
  write(BS(
    "Geschickt kletterst Du ueber den Abgrund auf die andere Seite."));
  TP->move( ROOM("w_weg_d1") , M_GO, 0,
    "klettert ueber den Steg",
    "kommt ueber den Steg hereingeklettert");
  return 1;
}
