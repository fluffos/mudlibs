
#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int last_time;

create() {
  ::create();
  
  last_time=0;
  
  SetProp(P_INT_SHORT, "Unter der Burg Sturmfels" );
  SetProp(P_INT_LONG,
      "Du bist hier in einem kleinen Gang unter der Paladinburg. "
      "Alles besteht hier aus grobem Fels. Der Gang wird nur spaerlich "
      "beleuchtet. Am Suedende ist ein Tor aus reinstem Mithril zu "
      "erkennen.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang", "raum" }), 
      QueryProp(P_INT_LONG));
  AddDetail( ({"boden"}),
      "Der Boden besteht aus roh behauenem Fels.");
  AddDetail( ({"decke"}),
      "Die Decke ist ueber Dir. Sie besteht, wie der gesamte Gang, "
      "aus roh behauenem Fels.");
  AddDetail( ({"waende", "wand"}),
      "Die Waende bestehen, wie alles hier, aus roh behauenem Fels. "
      "An den Waenden stecken Fackeln in Fackelhaltern.");
  AddDetail( ({"fackeln"}),
      "Die Fackeln erhellen den Gang nur spaerlich.");
  AddDetail( ({"fackelhalter"}),
      "Die Fackelhalter sind sehr schlicht und zweckgemaess gehalten. "
      "Sie bestehen aus Eisen oder Stahl.");
  AddDetail( ({"eisen", "stahl"}),
      "Daraus bestehen die Fackelhalter");
  AddDetail( ({"fels"}),
      "Der Fels hier sieht sehr roh bearbeitet aus. Er ist kuehl.");
  AddDetail( ({"symbole"}),
      "Auf dem Mithriltor sind die heiligen Symbole der Dusty - "
      "Schwert und Rose - abgebildet.");
  AddDetail( ({"schwert", "rose"}),
      "Schwert und Rose sind die heiligen Symbole der Dusty!");
  AddDetail( ({"dusty", "goettin"}),
      "Dusty ist die Goettin der Paladine.");
  AddDetail( ({"burg", "paladinburg"}),
      "Du befindest Dich unter der Paladinburg.");
  AddDetail( ({"paladine", "verteidiger"}),
      "Die Paladine sind die Verteidiger des Guten. Pass bloss auf, "
      "dass sie Dich nicht hier unten erwischen.");
  AddDetail( ({"gute"}),
      "Das Gute ist hier immer und ueberall.");
  AddDetail( ({"mithril"}),
      "Das Mithriltor im Sueden ist aus Mithril.");
  AddDetail( ({"tor"}),
      "Das Tor ist ein Mithriltor.");
  AddDetail( ({"suedende"}),
      "Am Suedende des Ganges ist ein glaenzendes Mithriltor.");
     
  AddExit("norden", ROOM("burg_geheim2"));  

  AddItem(NPC("ardare"), REFRESH_DESTRUCT);
  AddItem(NPC("schatzwaechter"), REFRESH_DESTRUCT);
  
  NewDoor("sueden", ROOM("burg_schatzkammer"), ({"mithriltor", "tor"}), 
      ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY,
        D_LONG, BS("Das Mithriltor ist ueber und ueber mit "
            "den heiligen Symbolen der Dusty verziert. Sie "
            "sieht sehr stabil und vor allem sehr wertvoll "
            "aus."),
        D_GENDER, NEUTER,
        D_SHORT,"Ein %ses Mithriltor.\n", 
        D_NAME,"Mithriltor",
        D_FUNC,"Alarm",
        D_OPENTESTFUNC, "ardare_check",
        D_MSGS, ({"das Mithriltor", "durchschreitet", "kommt durch "
            "das Mithriltor herein"})
        }));
}

int ardare_check() {
  if(present("ardare")) {
    tell_room(ME, sprintf("Ardare laesst %s das Tor nicht oeffnen.\n",
        TP->name(WEN)),({TP}));
    write("Ardare laesst Dich das Tor nicht oeffnen!\n");
    return 1;
  }
  return 0;
}

int Alarm() {
  object ayla;
  if(ayla=find_living("ayla")) {
    if(time()-last_time > 60) {
      ayla->command_me("prufe Die Schatzkammer wurde von Eindringlingen "
          "erstuermt! Schuetzt die heilige Standarte!");
      last_time=time();
    }
  }
  return 1;
}
