
/*
** Die Schmiede der Paladine
** Zordan@SL
**
*/

#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <bank.h>
#include <combat.h>
#include <wizlevels.h>
#include <moving.h>

#define VGL_PREIS 600
#define WEBS(x) break_string( x, 78, "Hugen sagt: " )

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine glorreiche Schmiede" );
  SetProp( P_INT_LONG,
    "Einen ziemlich verdreckten Ort siehst Du hier. Dicke Russschwaden haengen "
    "an der Decke und den Waenden. Aufgrund des Ambosses, dem riesigen Feuer "
    "und den vielen Waffen und Ruestungen erkennst Du sofort: Du bist in "
    "einer Schmiede gelandet. Durch einen dreckigen Vorhang kannst Du die "
    "Schmiede wieder nach Westen verlassen. Die verrauchte Luft kann wohl "
    "nicht komplett durch den Abzug nach oben verschwinden. Daher hast "
    "Du doch einige Probleme beim Atmen. @@schmied@@" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "ruestung","ruestungen" }),
    "Viele verschiedene Ruestungen haengen hier. Von Stiefel bis Helm ist "
    "einfach alles vertreten. Aber kaufen kann man hier wohl nichts. Da "
    "musst Du schon in den Laden gehen.");

  AddDetail( ({ "stiefel","helm" }),
    "Die sind wirklich wunderschoen gearbeitet worden. Du wirst richtig "
    "neidisch und moechtest Dir etwas einstecken. Aber eine innere Stimme "
    "haelt Dich davon ab.");

  AddDetail( ({ "stimme" }),
    "Dusty teilt Dir mit: tu es und ich loesche Dich.");

  AddDetail( ({ "laden" }),
    "Der ist weiter im Westen.");

  AddDetail( ({ "feuer" }),
    "Das Feuer brennt hell und heiss. Das braucht man auch in einer Schmiede.");

  AddDetail( ({ "waffen","waffe" }),
    "Erst jetzt siehst Du, dass es sich nur um Schwerter handelt. Sie "
    "haengen fein saeuberlich an den Waenden.");

  AddDetail( ({ "schwerter" }),
    "Paladine kaempfen nur mit Schwertern. Die schoensten ihrer Art "
    "haengen an den Waenden.");

  AddDetail( ({ "art" }),
    "Das sind einfach unglaublich viele.");

  AddDetail( ({ "metall","mithril" }),
    "Das koennte Mithril sein. Du bist Dir aber nicht sicher. Es ist einfach "
    "schon zu abgenutzt und dreckig.");

  AddDetail( ({ "lehm" }),
    "Der dreckige Lehm ist sehr sehr hart.");

  AddDetail( ({ "schmieden" }),
    "Nein, Du kannst das nicht.");

  AddDetail( ({ "boden" }),
    "Der Boden ist aus festem Lehm und sehr hart. Ein grosser Amboss steht "
    "neben dem Feuer.");

  AddDetail( ({ "amboss","faelle","fall" }),
    "Ein riesiger Amboss aus Metall. Er wird fuer das Schmieden der "
    "Waffen und Ruestungen auf alle Faelle gebraucht. Er sieht ziemlich "
    "abgenutzt aus.");

  AddDetail( ({ "atmen","beschreiben","atem" }),
    "Mir geht der Atem beim Beschreiben aus.");

  AddDetail( ({ "probleme","problem" }),
    "Hast Du ein Problem damit?");

  AddDetail( ({ "luft" }),
    "Die Luft ist total mit Rauch verqualmt.");

  AddDetail( ({ "rauch" }),
    "Der Rauch entsteht von dem riesigen Feuer. Er brennt in Deinen Augen.");

  AddDetail( ({ "augen","auge" }),
    "Du kannst Deine Augen nicht sehen.");

  AddDetail( ({ "schmied" }),
    "Hugen ist der Schmied.");

  AddDetail( ({ "vorhang" }),
    "Ein dunkler Vorhang soll wohl verhindern, dass der Wind in die Schmiede "
    "gelangt. Das waere auch ziemlich fatal fuer den Schmied.");

  AddDetail( ({ "wind" }),
    "Wenn hier Wind waere, koennte man nicht arbeiten.");

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind total dreckig. Neben einem kleinen Schild haengen "
    "wirklich viele Waffen und Ruestungen. Durch einen Vorhang im Westen "
    "kannst Du die Schmiede wieder verlassen.");

  AddDetail( ({ "schild" }),
    "Ein kleines Schild aus Holz.");

  AddDetail( ({ "holz" }),
    "Dunkles Holz, total dreckig.");

  AddDetail( ({ "schmiede" }),
    "Du stehst doch mittendrin. Schau Dich einfach um." );

  AddDetail( ({ "ort" }),
    "Die stehst in der Schmiede der Paladine.");

  AddDetail( ({ "paladine","paladin" }),
    "Hier werden alle Waffen und Ruestungen der Paladine hergestellt. Man "
    "kann sie bestimmt auch reparieren lassen.");

  AddDetail( ({ "russschwaden","schwaden" }),
    "Dicke schwarze Russschwaden verhaengen die Waende und die Decke. "
    "Eigentlich sieht es recht eklig aus.");

  AddDetail( ({ "decke" }),
    "An der Decke haengt eine kleine Lampe. Die Decke selbst ist total "
    "schwarz und ein kleiner Abzug verschwindet nach oben.");

  AddDetail( ({ "lampe","betrieb" }),
    "Die kleine Lampe ist nicht mehr in Betrieb. Das Feuer erhellt die "
    "Schmiede ausreichend.");

  AddDetail( ({ "abzug" }),
    "Der Rauch soll eigentlich durch den Abzug nach oben entweichen. Leider "
    "ist der Abzug wohl zu klein, so dass viele Russschwaden in der Schmiede "
    "verteilt sind.");

  AddDetail( ({ "schwert" }),
    "Hier haengen viele Schwerter. Eines schoener als das andere.");

  AddReadDetail( ({ "schild" }),
    " _______________________________________________________________ ___ __ _\n"
    "/\n"
    "| Sehr geehrte Paladine,\n"
    "|\n"
    "| Sie koennen hier folgende Dienstleistungen in Anspruch nehmen:\n"
    "|\n"
    "|  vergleiche   <gegenstand1 mit gegenstand2>\n"
    "|  repariere    <waffe oder ruestung>\n"
    "|\n"
    "| Die Preise teile ich Ihnen immer umgehend mit.\n"
    "|\n"
    "|                                        Hochachtungsvoll, Hugen\n"
    "\\_______________________________________________________________ ___ __ _\n"
  );

  AddSound( DEFAULT_SOUND,
    "Das Feuer knistert leise vor sich hin.");
    
  AddSound( ({ "feuer","knistern" }) ,
    "Wenn Hugen nicht gerade an einem Schwert arbeitet, dann kann man doch "
    "tatsaechlich auch mal das Knistern des Feuers neben seinen lauten "
    "Schlaegen hoeren.");
    
  AddSound( ({ "hugen","schlaege" }) ,
    "*rumms* *rumms*");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier total verbrannt.");

  AddCmd( ({ "vergleiche","vergleich" }), "vergleichefkt" );
  AddCmd( ({ "kletter","klettere" }),     "kletterfkt" );

  AddItem( NPC("hugen"), REFRESH_DESTRUCT );
  AddItem(NPC("portalwaechter"), REFRESH_DESTRUCT);

  AddExit("westen", "./burg_d2");
}

string schmied() {
 if(present("\n_hugen", TO))
   return "Hugen steht am Feuer und schmiedet ein Schwert.";
 return "Der Schmied ist wohl gerade nicht da.";
}

sell() {
  notify_fail("Du kannst hier nichts verkaufen!\n" );
  return 0;
}

force_sell() { 
  return sell(); 
}

evaluate() { 
  return sell(); 
}

string comp_quality(object ob1, object ob2, int typ) {
  int wert1, wert2, diff, h1, h2;
  string name1, name2;
  name1 = capitalize(ob1->name(WER, 1));
  name2 = ob2->name(WER, 1);
  if (typ == 1) {
    wert1 = ob1->QueryProp(P_WC);
    wert2 = ob2->QueryProp(P_WC);
    h1 = ob1->QueryProp(P_NR_HANDS);
    h2 = ob2->QueryProp(P_NR_HANDS);
    write(BS(name1 + " ist ein "+(h1==1?"Einh":(h1==2?"Zweih":h1+"-H"))+
      "aender, " + name2 + (h1==h2?" auch":" ein "+
      (h2==1?"Einh":(h2==2?"Zweih":h2+"-H"))+ "aender")+".\n"));
    h1 = ob1->QueryProp(P_WC_FIXFACTOR);
    h2 = ob2->QueryProp(P_WC_FIXFACTOR);
    if (h1 > h2)
      write(name1+" liegt besser in der Hand als "+name2+".\n");
    else if (h1 < h2)
      write(name1+" liegt schlechter in der Hand als "+name2+".\n");
    else
      write(name1+" und "+name2+" liegen etwa gleich gut in der Hand.\n");
  } else {
    wert1 = ob1->QueryProp(P_AC);
    wert2 = ob2->QueryProp(P_AC);
  }
  diff = wert1 - wert2;
  if (IS_WIZARD(TP) && TP->QueryProp(P_WANTS_TO_LEARN)) {
    write("  Typ = " + typ + ", d.h. " + (typ==1 ? "Waffen" : "Ruestungs") + "vergleich.\n");
    write("  Hands1: " + h1 + "\n");
    write("  Hands2: " + h2 + "\n");
    write("  Wert1: " + wert1 + "\n");
    write("  Wert2: " + wert2 + "\n");
    write("  Wertdifferenz: " + diff + "\n");
  }
  if (diff > 2*wert2) return  (name1 + " laesst " + name2 + " richtig mickrig aussehen" );
  if (diff > wert2) return (name1 + " ist viel besser als " + name2);
  if (diff > wert2/5) return (name1 + " ist besser als " + name2);
  if (diff > wert2/10) return (name1 + " ist etwas besser als " + name2);
  if (-diff > 2*wert1) return (name1 + " wirkt mickrig neben " + name2);
  if (-diff > wert1) return (name1 + " ist viel schlechter als " + name2);
  if (-diff > wert1/5) return (name1 + " ist schlechter als " + name2);
  if (-diff > wert1/10) return (name1 + " ist etwas schlechter als " + name2);
  return (name1 + " und " + name2 + " sind etwa gleich gut");
}

string comp_weight(object ob1, object ob2) {
  string name1, name2;
  int wert1, wert2, diff;
  name1 = capitalize(ob1->name(WER, 1));
  name2 = ob2->name(WER, 1);
  wert1 = ob1->QueryProp(P_WEIGHT);
  wert2 = ob2->QueryProp(P_WEIGHT);
  diff = wert1 - wert2;
  if (IS_LEARNER(TP) && TP->QueryProp(P_WANTS_TO_LEARN)) {
    write("  Gewicht1: " + wert1 + "\n");
    write("  Gewicht2: " + wert2 + "\n"); 
    write("  Gewichtsdifferenz: " + diff + "\n");
  }
  if (diff > wert2*3/2) return (name1 + " ist viel schwerer als " + name2);
  if (diff > wert2/3) return (name1 + " ist schwerer als " + name2);
  if (diff > wert2/6) return (name1 + " ist etwas schwerer als " + name2);
  if (-diff > wert1*3/2) return (name1 + " ist viel leichter als " + name2);
  if (-diff > wert1/3) return (name1 + " ist leichter als " + name2);
  if (-diff > wert1/6) return (name1 + " ist etwas leichter als " + name2);
  return (name1 + " und " + name2 + " sind etwa gleich schwer");
}

int vergleichefkt(string str) {
  object ob1, ob2;
  string str1, str2;
  if(!present("\n_hugen")) {
    notify_fail("Hugen ist leider gerade nicht da!\n");
    return 0;
  }
  notify_fail("Hugen fragt Dich: Was moechtest Du miteinander vergleichen?\n");
  if (!str || !stringp(str)) return 0;
  if (sscanf( str, "%s mit %s", str1, str2) != 2) return 0;
  ob1=present(str1,TP);
  ob2=present(str2,TP);
  if (!ob1 || !ob2) {
    write(WEBS("Wenn Du eine Einschaetzung haben moechtest, dann solltest Du "
      "diese Gegenstaende auch schon bei Dir haben!"));
    return 1;
  }
  if (ob1==ob2) {
    write (BS("Hugen ist es zu bloed, "+ob1->name(WEN,1)+
      " mit sich selbst zu vergleichen. Er drueckt "+ob1->QueryPronoun(WEN)+
      " Dir daher wieder in die Hand."));
    return 1;
  }
  if (!IS_WIZARD(TP)) {
    if (TP->QueryMoney() < VGL_PREIS) {
      write (WEBS("Das wuerde Dich nur eine Kleinigkeit von "+VGL_PREIS+
          " Muenzen kosten, aber Du hast nicht soviel dabei!\n"));
      return 1;
    }
  }
  if (ob1->QueryProp(P_WEAPON_TYPE) && ob2->QueryProp(P_WEAPON_TYPE)) {
    write (BS(
      "Hugen nimmt "+ob1->name(WEN, 1)+" und "+
      ob2->name(WEN, 1)+" und vergleicht beide miteinander. "+
      "Schliesslich kommt er zu folgender Beurteilung:")+"\n");
    write (BS(comp_quality(ob1, ob2, 1) + "."));
  } else if (ob1->QueryProp(P_ARMOUR_TYPE) && ob2->QueryProp(P_ARMOUR_TYPE)) {
    write (BS(
      "Hugen nimmt "+ob1->name(WEN, 1)+" und "+
      ob2->name(WEN, 1)+" und vergleicht beide miteinander. "+
      "Schliesslich kommt er zu folgender Beurteilung:")+"\n");
    write (BS(comp_quality(ob1, ob2, 2) + ".") + "\n");
  } else {
    write (WEBS("Ich kenne mich nur mit Waffen und Ruestungen "+
      "aus. Aber nicht mit dem Zeug, das Du da bei Dir hast!"));
    return 1;
  }
  write (BS(comp_weight(ob1, ob2) + "."));
  if (!IS_LEARNER(TP)) {
    TP->AddMoney(-VGL_PREIS);
    ZENTRALBANK->PayIn(VGL_PREIS);
    write ("\n"+BS("Hugen bittet Dich um die "+VGL_PREIS+" Muenzen. "+
      "Ehrlich wie Du bist zahlst Du auch und bist letztendlich froh, "+
      "etwas Wichtiges erfahren zu haben.\n"));
  } else {
    write("\n"+WEBS("Jaja, fuer Dich Magier erlasse ich die "+
    VGL_PREIS+" Muenzen!")+"\n");
  }
  return 1;
}

int kletterfkt(string str) {
  notify_fail("Ja, wohin denn so?\n");
  if (str != "in abzug") return 0;
  write(BS(
    "Du stellst Dich auf den Amboss und haeltst Dich an dem Abzug fest. Dann "
    "ziehst Du Dich rauf, bis Du komplett in dem Abzug steckst."));
  TP->move( ROOM("burg_ab") , M_GO, 0,
    "stellt sich auf den Amboss und verschwindet in der Decke",
    "kommt hereingeklettert");
  return 1;
}
