inherit "std/laden";

#include <properties.h>
#include <laden.h>
#include "../paladin.h"

create() {
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG,
        "Du befindest Dich hier im Waffen- und Ruestungsladen "
       +"der Paladine. Ueberall haengen Waffen und Ruestungen, "
       +"die praechtig anzusehen sind. Der Fussboden und die "
       +"Decke bestehen aus massiver Eiche. Im hinteren "
       +"Teil des Ladens befinden sich Unmengen von Regalen, "
       +"in der die Waffen, Ruestungen und anderen Gegenstaende "
       +"gelagert werden. @@haendler@@");

  SetProp(P_INT_SHORT,"Im Laden der Paladine");
  SetProp(P_SHOPKEEPER_ID, "gerion");
  SetProp(P_SHOPKEEPER_NAME, "Gerion");
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM("p_lager"));

  AddDetail(({"waffenladen","ruestungsladen","laden"}), 
    "Du stehst mittendrin.\n");
  AddDetail(({"fussboden", "boden"}), 
    "Der Boden besteht aus massivem Eichenholz. Er ist "
    "blankgebohnert.");
  AddDetail(({"unmengen"}), 
    "Es sind einfach zu viele um alle zu zaehlen.");
  AddDetail(({"wand", "waende"}),
    "Die Waende sind ueber und ueber mit Waffen und "
    "Ruestungen behaengt. An einer Wand haengt eine Tafel.");
  AddDetail("decke", 
    "Die Decke besteht aus massiver Eiche.");
  AddDetail("tafel", 
    "Du kannst sie lesen.\n");
  AddDetail(({"haendler", "paladin"}),
    "Der Haendler ist ein alter Paladin, der Dich "
    "freundlich anblickt.");
  AddDetail("waffen", 
    "Die Waffen, vorwiegend Schwerter, haengen teilweise "
    "an der Wand oder liegen in den Regalen.");
  AddDetail(({"schwert","schwerter","grossteil"}), 
    "Der Grossteil der Waffen hier sind eindeutig Schwerter. Es gibt sie "
    "in allen moeglichen Variationen.");
  AddDetail(({"variationen","zeit"}), 
    "Du hast sicher keine Zeit Dir alle genau anzusehen.");
  AddDetail(({"regal", "regale"}),
    "Die Regale, welche im hinteren Teil des Ladens stehen, "
    "sind mit Waffen und Ruestungen, sowie mit diversen "
    "anderen Gegenstaenden, ueberfuellt.");
  AddDetail("gegenstaende", 
    "Mach mal 'zeige'.");
  AddDetail(({"ruestungen", "helme", "kettenhemden"}), 
    "Diverse Helme, Kettenhemden und andere Ruestungen haengen "
    "an den Waenden.");
  AddDetail("eiche", 
    "Das Holz, aus dem Decke und Boden besteht, ist "
    "Eichenholz. Es sieht sehr massiv aus.");
  AddDetail(({"holz", "eichenholz"}), 
    "Das Holz sieht sehr stabil aus.");
  AddDetail("teil", 
    "Die Regale sind im hinteren Teil des Ladens.");
  AddReadDetail ("tafel",
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands "+
    "der Liste aus.\n"+
    "<kaufe> nummer oder\n"+
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
    "                  Haendler dafuer bezahlt.\n"+
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  AddItem(NPC("gerion"), REFRESH_DESTRUCT);
  AddItem(NPC("portalwaechter"), REFRESH_DESTRUCT);

  AddExit ("osten", "./burg_b2");
}



string haendler() {
 if(present("gerion", TO))
   return "Im hinteren Teil des Raumes steht der Haendler, "
         +"ein alter Paladin.";
 return "Leider ist im Moment keiner im Laden.";
}

int _add_money_if_needed(int i) {
  if(_query_current_money() < 25000) {
    _add_money(i);
    return 1;
  }
  return 0;
}
