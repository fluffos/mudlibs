
#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int last_time;

create() {
  ::create();
  
  last_time=0;
  
  SetProp(P_INT_SHORT, "Unter der Burg Sturmfels" );
  SetProp(P_INT_LONG,
      "Du bist hier in einem kleinen Gang unter der Paladinburg. "
      "Alles besteht hier aus grobem Fels. Der Gang wird nur spaerlich "
      "beleuchtet. Am Nordende des Ganges befindet sich ein schmuckloses "
      "silbernes Portal.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang", "raum" }), 
      QueryProp(P_INT_LONG));
  AddDetail( ({"boden"}),
      "Der Boden besteht aus roh behauenem Fels.");
  AddDetail( ({"decke"}),
      "Die Decke ist ueber Dir. Sie besteht, wie der gesamte Gang, "
      "aus roh behauenem Fels.");
  AddDetail( ({"waende", "wand"}),
      "Die Waende bestehen, wie alles hier, aus roh behauenem Fels. "
      "An den Waenden stecken Fackeln in Fackelhaltern.");
  AddDetail( ({"fackeln"}),
      "Die Fackeln erhellen den Gang nur spaerlich.");
  AddDetail( ({"fackelhalter"}),
      "Die Fackelhalter sind sehr schlicht und zweckgemaess gehalten. "
      "Sie bestehen aus Eisen oder Stahl.");
  AddDetail( ({"eisen", "stahl"}),
      "Daraus bestehen die Fackelhalter");
  AddDetail( ({"fels"}),
      "Der Fels hier sieht sehr roh bearbeitet aus. Er ist kuehl.");
  AddDetail( ({"symbole"}),
      "Auf dem Mithriltor sind die heiligen Symbole der Dusty - "
      "Schwert und Rose - abgebildet.");
  AddDetail( ({"schwert", "rose"}),
      "Schwert und Rose sind die heiligen Symbole der Dusty!");
  AddDetail( ({"dusty", "goettin"}),
      "Dusty ist die Goettin der Paladine.");
  AddDetail( ({"burg", "paladinburg"}),
      "Du befindest Dich unter der Paladinburg.");
  AddDetail( ({"paladine", "verteidiger"}),
      "Die Paladine sind die Verteidiger des Guten. Pass bloss auf, "
      "dass sie Dich nicht hier unten erwischen.");
  AddDetail( ({"gute"}),
      "Das Gute ist hier immer und ueberall.");
  AddDetail( ({"mithril"}),
      "Das Goldtor im Sueden ist aus Mithril.");
  AddDetail( ({"tor"}),
      "Das Tor ist ein Goldtor.");
  AddDetail( ({"nordende"}),
      "Am Suedende des Ganges ist ein Goldtor.");
     
  AddExit("osten", ROOM("burg_geheim5"));  

  NewDoor("westen", ROOM("burg_schatzkammer2"), ({"goldtor", "tor"}), 
      ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY,
        D_LONG, BS("Dieses Goldtor ist voellig schmucklos."),
        D_GENDER, NEUTER,
        D_SHORT,"Im Westen befindet sich ein schmuckloses Goldtor.\n", 
        D_NAME,"Goldtor",
        D_OPENTESTFUNC, "waechter_check",
        D_MSGS, ({"das Goldtor", "durchschreitet", "kommt durch "
            "das Goldtor herein"})
        }));

  AddItem(NPC("ruestung"), REFRESH_DESTRUCT);
  AddItem(NPC("ruestung"), REFRESH_DESTRUCT);

  
}

int waechter_check() {
  object ob;
  if(ob=present("\nschatzkammer_waechter")) {
    tell_room(ME, sprintf("%s laesst %s das Portal nicht oeffnen.\n",
        ob->Name(WER),TP->name(WEN)),({TP}));
    write(sprintf("%s laesst Dich das Portal nicht oeffnen!\n", 
          ob->Name(WER)));
    return 1;
  }
  return 0;
}


void BecomesNetAlive(object spieler) {
  catch(present("mithrilschluessel", spieler)->remove());
  catch(present("silberschluessel", spieler)->remove());
  catch(present("goldschluessel", spieler)->remove());
  return ;
}
