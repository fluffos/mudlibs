/*
** Burg der Paladine
** Angox@SL
** Zordan
** 16.03.1998
*/

inherit "std/room";

#include <player.h>
#include <properties.h>
#include <language.h>
#include "../paladin.h"

create() {
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Burghof in Burg Sturmfels");
  SetProp (P_KILL_NAME, "Illegales");
  SetProp (P_INT_LONG, 
      "Du befindest Dich hier am oestlichen Teil des Burghofes "
      +"auf Burg Sturmfels. Hier geht es ruhig zu, wenn man von "
      +"von dem staendigen Haemmern aus der Schmiede oestlich "
      +"von hier absieht. Im Norden scheint sich eine Art Tempel "
      +"zu befinden. Auf dem lehmigen Boden hier befindet sich "
      +"viel Stroh. Ab und zu siehst Du eine Maus zwischen den Halmen "
      +"hin und her huschen.");
    
  AddSpecialDetail(({"raum", "hof", "burghof","teil"}), "raum");
  AddDetail(({"burg", "sturmfels"}),
    "Die Burg Sturmfels ist wahrlich eine praechtige Burg. Sie "
    "ist gut zu verteidigen, und wird sicherlich nicht so schnell "
    "eingenommen.");
  AddDetail("boden", 
    "Der Boden hier besteht aus festgestampftem Lehm. Ueberall am "
    "Boden ist Heu verstreut. Ab und zu siehst Du eine Maus "
    "durch das Stroh huschen.");
  AddDetail("maus", 
    "Im Moment ist keine da. Die verstecken sich wohl vor Dir.");
  AddDetail("himmel", 
    "Der ist - dustyseidank - noch immer ober Dir.");
  AddDetail("lehm",
    "Der Lehm hier ist festgestampft, dadurch ergibt sich ein "
    "recht harter und rutscherfester Boden.");
  AddDetail(({"stroh", "heu", "halme", "halmen"}),
    "Das Stroh ist am ganzen Burghof am Boden verstreut. Zu was es "
    "wohl gut sein mag?");
  AddDetail("norden",
    "Im Norden befindet sich eine Kapelle. Hier huldigen die Paladine "
    "ihrer Goettin Dusty.");
  AddDetail(({"kapelle", "tempel","art","muehen"}),
    "Die Kapelle ist von aussen betrachtet ein prunkvolles Gebaeude, "
    "mit Gold verziert. Die Paladine dieser Burg haben keine Muehen "
    "gescheut, ihrer Goettin zu huldigen.");
  AddDetail(({"goettin", "dusty"}),
    "Dusty ist die Goettin der Paladine. Ihr gilt ihre Huldigung.");
  AddDetail("huldigung", 
    "Gehuldigt wird in der Kapelle, aber nicht hier!");
  AddDetail("gold", 
    "Die Kapelle ist mit Gold verziert. Mit viel Gold. SEHR viel.");
  AddDetail("gebaeude", 
    "Die Kapelle ist ein grosses Gebaeude. Gerade gross genug, um "
    "Dusty die entsprechende Ehrerbietung zu geben.");
  AddDetail("ehrerbietung", 
    "'Und siehe. Nachdem der Woody die Welt erschaffen hatte und die "
    "Lebewesen und die Spieler und Seher, erschien Dusty, und gebat "
    "dem gestrengen Gott Einhalt, auf dass die Spieler und Seher "
    "mit Gerechtigkeit und Wuerde behandelt wuerden...*blalaberfasel*'");
  AddDetail(({"gott", "woody"}),
    "Woody hat die Welt erschaffen ... zumindest in den Grundzuegen.");
  AddDetail("welt", 
    "Na, das Silberland natuerlich.");
  AddDetail("grundzuegen", 
    "Schau Dich doch mal um.");
  AddDetail(({"seher", "spieler", "lebewesen"}),
    "Alle Lebewesen im Silberland eben.");
  AddDetail(({"gerechtigkeit", "wuerde", "einhalt"}),
    "Dusty brachte Gerechtigkeit und Wuerde. Gepriesen sei die Goettin.");
  AddDetail("woody", 
    "Die Paladine glauben auch an Woody, aber dennoch verehren sie "
    "Dusty, die Allgegenwaertige.");
  AddDetail("allgegenwertige", 
    "Einer der vielen Beinamen Dustys.");
  AddDetail("beinamen",
    "Es sind zu viele um die aufzuzaehlen.");
  AddDetail("osten", 
    "Im Osten befindest sich eine Schmiede. Metallisches Haemmern dringt "
    "an Dein Ohr.");
  AddDetail("schmiede", 
    "In der Schmiede wird hier vorwiegend Waffen und Ruestungen gefertigt. "
    "Du koenntest ja mal reinschauen, es gibt dort sicherlich gute "
    "Ausruestung, oder zumindest koenntest Du Deine Ausruestung "
    "reparieren lassen.");
  AddDetail("ausruestung", 
    "Na, gib einfach mal 'ausruestung' ein!");
  AddDetail("kampf", 
    "Die Paladine bekaempfen das Boese wo sie nur koennen.");
  AddDetail(({"waffen", "ruestungen"}),
    "Waffen und Ruestungen benoetigen die Paladine im Kampf gegen das "
    "Boese.");
  AddDetail("ostoben", 
    "Eine Treppe Richtung Ostoben fuehrt auf den Wehrgang rund um "
    "die Burgmauer.");
  AddDetail("treppe", 
    "Die Treppe auf den Wehrgang ist sehr schmal. Wenn Du da raufgehst, "
    "musst Du vorsichtig sein, um nicht auszurutschen und runter zu "
    "stuerzen.");
  AddDetail("wehrgang", 
    "Der Wehrgang befindet sich auf den maechtigen Burgmauern. Hier "
    "patrollieren die wachsamen Paladine der Burg, um jegliche "
    "Gefahr sofort zu erblicken.");
  AddDetail("gefahr",
    "Momentan scheint aber alles ruhig zu sein.");
  AddDetail("paladine", 
    "Die Paladine sind maechtige Kaempfer, stets bereit, das Boese "
    "zu vernichten.");
  AddDetail("boese", 
    "Das Boese ist immer und ueberall!");
  AddDetail("kaempfer", 
    "Die hier ausgebildenten Paladine sind ausgezeichnete Kaempfer. "
    "Fordere sie bloss nicht heraus, dass waere Dein Ende.");
  AddDetail("ende", 
    "Der Tod fluestert Dir zu: DU WEISST SCHON WAS ICH MEINE!");
  AddDetail("tod",
    "Du Weisst Schon Wer Das Ist.");
  AddDetail(({"du", "weisst", "schon", "was", "ich", "meine", "ist"}),
    "Die Deckens besteht Aus weisses Mamor. Darin befindet sich seltsame "
    +"Spreknel. Weiteruntersuchen auf eigene Gefar. Das sieht sehr schoen "
    +"aus. Es koennte aber auch gefaehrlich sein. Sieht nach Fale aus."
    +"Das Mutser der Spreknel ist ganz schoen verwirrend. Wenn Du hier "
    +"was weiteruntersuchst, loest Du die Skriptfalle aus. Der Mammor ist "
    +"ganz kalt. Es koennte Dich alle Erfarungspunkde kosten");
  AddSpecialDetail(({"deckens", "aus", "mammor", "spreknel", 
      "weiteruntersuchen", "gefar", "fale", "mutser", "spreknel", 
      "skriptfalle", "erfarungspunkde"}), "Script");
  AddDetail(({"mauern", "burgmauern"}),
    "Die Burgmauern bestehen aus haertestem Granit des Silbergebirges. "
    "Sie sind meterdick und halten sicherlich jeder Belagerung stand.");
  AddDetail("silbergebirge", 
    "Das Silbergebirge ist das groesste Gebirge im Silberland.");
  AddDetail("silberland", 
    "Du befindest Dich im Silberland.");
  AddDetail(({"granit", "baumaterial", "material"}),
    "Granit ist fuer Burgmauern ein teures, aber gutes Baumaterial.");
  AddDetail("belagerung", 
    "Im Moment wird die Burg nicht belagert, sonst waerst Du ja nicht "
    "hier, oder?");
  AddDetail("moment", 
    "Ja. Jetzt. Hier. In diesem Moment.");
  AddSmell(DEFAULT_SMELL, 
    "Es riecht hier nach Heu, Feuer und Weihrauch.");
  AddSmell("heu", 
    "Das Heu, welches am Boden liegt, ist ganz deutlich zu riechen.");
  AddSmell("feuer", 
    "Scheint wohl von der Schmiede zu kommen.");
  AddSmell(({"weihrauch", "geruch"}),
    "Der Geruch von Weihrauch kommt vom Norden aus dem Tempel.");
  AddSound(DEFAULT_SOUND, 
    "Du hoerst neben einigen entfernten Schreien vorwiegend das "
    "Haemmern aus der Schmiede.");
  AddSound("schreien", 
    "Offenbar schreit da wer Anweisungen.");
  AddSound("anweisungen", 
    "Leider kannst Du sie nicht verstehen, dafuer ist das Haemmern zu "
    "laut.");
  AddSound("haemmern",
    "Das Haemmern kommt aus der Schmiede. Da drinnen wird offenbar "
    "schwer gearbeitet.");

  AddExit("osten", "./burg_e2");
  AddExit("norden", "./burg_d1");
  AddExit("westen", "./burg_c2");
  AddExit("ostoben", "./w_weg_e2");
 
}

string raum() {
 return QueryProp(P_INT_LONG);
}

string Script() {
 int lostxp;
 if(TP->QueryProp(P_LEVEL)>10) {
   lostxp=(int)(TP->QueryProp(P_XP)*0.8);
   TP->SetProp(P_XP, TP->QueryProp(P_XP)-lostxp);
   SetProp(P_KILL_NAME, "Automatisierung");
   SetProp(P_KILL_MSG,sprintf("Na, wie ist der Verlust von %d XPs?", 
       lostxp));
   TP->die();
 }
 write_paladin_log("scriptfalle", sprintf("%s loest Falle aus. Lvl:%d, "
     +"IP:%s, lost XP:%d\n", TP->Name(WER),TP->QueryProp(P_LEVEL),
     TP->QueryProp(P_CALLED_FROM_IP),lostxp));
 return "So soll es sein! Wir sehen uns. Mit einem anderem Char von Dir.\n";
}
