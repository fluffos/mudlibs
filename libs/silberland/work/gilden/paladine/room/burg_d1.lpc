#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int anzahl;

reset() {
  ::reset();
  anzahl=2;
}

create() {
  ::create();

  anzahl=2;

  SetProp( P_INT_SHORT, "Ein heiliger Ort auf Burg Sturmfels" );
  SetProp( P_INT_LONG,
    "Ehrfuerchtig stehst Du an einem unglaublich nach Heiligtum strahlendem "
    "Ort. Man kann die Waende eigentlich schon nicht mehr als solche "
    "bezeichnen. Sie bestehen naemlich aus reinstem Gold. Im noerdlichen "
    "Bereich steht ein geoeffneter Schrein auf einem gigantischen Altar "
    "aus purem Gold. Zwei grosse Fackelhalter mit ihren Fackeln erhellen "
    "diesen Ort so sehr, dass Du fast blinzeln musst. Die Reflektionen des "
    "Lichtes am Gold verteilen sich in alle Richtungen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_HOUSE]) );

  SetProp (P_KILL_NAME, "Ein Scriptverdacht");

  AddDetail( ({ "altar" }),
    "Der Altar uebertrifft alles an Reichtum, was Du bisher in Deinem Leben "
    "gesehen hast. Viele kleine, weisse Kerzen und ein kleiner Schrein sind "
    "auf ihm verteilt. Er besteht komplett aus Gold und ist reichlich mit "
    "Edelsteinen aller Art verziert.");

  AddDetail( ({ "art","arten" }),
    "Alle Arten die Dir einfallen sind vertreten.");

  AddDetail( ({ "leben" }),
    "Du lebst dank Dusty.");

  AddDetail( ({ "schrein" }),
    "Der Schrein liegt geoeffnet auf dem Altar. In ihm kannst Du neben "
    "einem Abbild von Dusty ein grosses Schwert, eine Rose und einen Umhang "
    "liegen sehen.");

  AddDetail( ({ "dusty" }),
    "Dusty ist die Goettin der Paladine. Sie ist aber auch allen Rassen "
    "friedlich gesonnen. Sie steht fuer das Gute, die Gerechtigkeit und die "
    "Wuerde im SilberLand.");

  AddDetail( ({ "rassen","rasse" }),
    "Na einfach alle.");

  AddDetail( ({ "gerechtigkeit","wuerde" }),
    "Ohne Dusty wuerde es das nicht im SilberLand geben.");

  AddDetail( ({ "abbild","einhalt" }),
    "Das Abbild zeigt Dusty, wie sie das SilberLand erschuf und dabei dafuer "
    "sorgte, dass das Gute dem Boesen immer Einhalt gebietet.");

  AddDetail( ({ "schwert","silberschwert" }),
    "Ein riesiges Silberschwert liegt in dem Schrein. Es hat eine lange Klinge "
    "aus Mithril und einen Griff aus purem Gold, versetzt mit wertvollen "
    "Edelsteinen.");

  AddDetail( ({ "klinge","mithril","schlag" }),
    "Die Klinge aus Mithril ist wahrlich ehrfurchterregend. Mit ihr kann man "
    "sicher jeden Gegner mit einem Schlag toeten.");

  AddDetail( ({ "gegner" }),
    "Damit sind natuerlich boese Gegner gemeint.");

  AddDetail( ({ "griff" }),
    "Der Griff scheint irgendwie magisch zu sein. Sein Gold scheint nicht "
    "ganz fest zu sein, damit es sich seinem Traeger genau anpassen kann.");

  AddDetail( ({ "traeger" }),
    "Du bezweifelst, dass Du das jemals sein wirst.");

  AddDetail( ({ "rose" }),
    "Eine immer bluehende, rote Rose liegt in dem Schrein.");

  AddDetail( ({ "umhang" }),
    "Ein weisser Umhang mit den Zeichen der Paladine.");

  AddDetail( ({ "zeichen" }),
    "Leider liegt der Umhang falsch herum. Du kannst nicht alles erkennen.");

  AddDetail( ({ "diamanten","diamant","guete" }),
    "Diamanten reinster Guete. Sie funkeln im Licht.");

  AddDetail( ({ "fackelhalter" }),
    "Die Fackelhalter bestehen doch tatsaechlich aus fein geschliffenen "
    "Diamanten. Sie halten in sich grosse Fackeln. Sie sind schon recht "
    "gross.");

  AddDetail( ({ "ort" }),
    "Dieser Ort ist das Heiligtum der Paladine.");

  AddDetail( ({ "heiligtum" }),
    "Hier huldigen die Paladine ihrer Goettin.");

  AddDetail( ({ "bereich" }),
    "Im noerdlichen Bereich steht ein grosser Altar.");

  AddDetail( ({ "fackeln" }),
    "Zwei grosse Fackeln stecken in noch viel groesseren Fackelhaltern und "
    "erhellen diesen Ort wirklich bis in die letzte Ecke.");

  AddDetail( ({ "ecke","ecken" }),
    "Richtige Ecken kannst Du eigentlich gar nicht sehen. Alles ist mehr "
    "oder weniger rund gehalten.");

  AddDetail( ({ "decke" }),
    "An der Decke tanzen viele Schatten von den Fackeln herum. Auf den "
    "Reflektionen sieht das eigentlich schon lustig aus. Aber Du traust "
    "Dich nicht, darueber zu lachen und unterdrueckst sogar ein Laecheln.");

  AddDetail( ({ "laecheln" }),
    "Obwohl es eigentlich gar nicht schlimm waere, aber man macht soetwas "
    "automatisch hier nicht.");

  AddDetail( ({ "schatten" }),
    "Die Schatten entstehen durch die Fackelhalter an der Decke.");

  AddDetail( ({ "reflektionen","reflektion" }),
    "Das pure Gold reflektiert das Licht ein paar Mal. Das verleiht diesem "
    "Ort noch mehr heilige Aura.");

  AddDetail( ({ "licht" }),
    "Das Licht entsteht hier durch zwei grosse Fackeln und wird mehrfach "
    "gebrochen und reflektiert.");

  AddDetail( ({ "aura","worte" }),
    "Die heilige Aura dieses Ortes ist nicht mehr in Worte zu fassen.");

  AddDetail( ({ "mal" }),
    "Zaehlen kannst Du es nicht.");

  AddDetail( ({ "boden" }),
    "Der Boden wurde mit goldenen Platten ausgelegt.");

  AddDetail( ({ "platten" }),
    "Die Platten bestehen auch aus Gold und sind mit reichlich "
    "Edelsteinen verziert worden.");

  AddDetail( ({ "edelstein","edelsteine" }),
    "Die Edelsteine auf dem Boden und dem Altar ergeben viele verschiedene "
    "Muster. Sie muessen unglaublich viel wert sein.");

  AddDetail( ({ "muster","rechtecke","kreise","linien","linie",
                "rechteck","kreis" }),
    "Die Muster zeigen keine Bilder oder aehnliches. Es sind einfache "
    "Muster wie Rechtecke, Kreise und einfache Linien.");

  AddDetail( ({ "bilder","patsch","dinge","sehr","auch","scripter" }),
    "*PATSCH* Auch wenn Du kein Scripter sein solltest, sei vorsichtiger. "
    "Denn wenn man Dinge untersucht die gar nicht da sind, kannst Du SEHR "
    "schnell dran sterben!!!");

  AddDetail( ({ "knistern" }),
    "Du kannst es weder hoeren noch sehen.");

  AddDetail( ({ "waende" }),
    "Die Waende bestehen aus purem Gold. Sie alleine muessen schon einen "
    "unschaetzbaren Wert darstellen. Sie sind verziert mit allerlei "
    "Abbildungen. An einer Wand stehen drei Statuen.");

  AddDetail( ({ "wand" }),
    "An der oestlichen Wand stehen drei mittelgrosse Statuen.");

  AddDetail( ({ "statuen" }),
    "Die Statuen zeigen die hoechsten drei Paladine im SilberLand, wie "
    "sie ihr Leben fuer das Gute opferten.");

  AddDetail( ({ "gute","guten","verfechter","gutes" }),
    "Paladine sind Verfechter des Guten.");

  AddDetail( ({ "leben" }),
    "Ja, Paladine wuerden ihr Leben fuer das Gute opfern.");

  AddDetail( ({ "silberland" }),
    "In dem leben die Paladine. Neben dem Guten und dem Boesen.");

  AddDetail( ({ "abbildungen" }),
    "Die Abbildungen zeigen verschiedene Paladine, wie sie gegen das Boese "
    "mit Hilfe ihrer Goettin im Kampf bestehen und siegen.");

  AddDetail( ({ "goettin" }),
    "Dusty ist die Goettin der Paladine. Sie beschuetzt und fuehrt die "
    "Paladine im Kampf gegen das Boese. Alle Paladine huldigen ihr.");

  AddDetail( ({ "hilfe" }),
    "Paladine koennen jederzeit mit der Hilfe ihrer Goettin rechnen, wenn "
    "sie gegen das Boese kaempfen.");

  AddDetail( ({ "paladine" }),
    "Die Paladine haben ihren Kampf siegreich beendet und halten ihre "
    "Schwerter in die Hoehe.");

  AddDetail( ({ "hoehe" }),
    "Na hoch halt.");

  AddDetail( ({ "schwerter","silberschwerter" }),
    "Das sind hell leuchtende Silberschwerter. Wie es sich fuer richtige "
    "Paladine gehoert.");

  AddDetail( ({ "kampf" }),
    "Das ist der Kampf gegen das Boese.");

  AddDetail( ({ "boese","boesen","boeses" }),
    "Das wirst Du an diesem Ort sicher nicht finden.");

  AddDetail( ({ "wert" }),
    "Er ist unschaetzbar hoch.");

  AddDetail( ({ "gold" }),
    "Das reinste Gold was Du jemals gesehen hast.");

  AddDetail( ({ "kerzen","kerze" }),
    "Unzaehlbar viele weisse Kerzen stehen auf dem Altar und um den Schrein "
    "herum.");

  AddDetail( ({ "wachs","aussehen" }),
    "Das weisse Wachs verleiht den Kerzen ein heiliges Aussehen.");

  AddDetail( ({ "weihrauch" }),
    "Komisch, man kann davon gar nichts sehen. Nur riechen kann man es "
    "sehr deutlich.");

  AddSound( DEFAULT_SOUND,
    "Hier ist absolut nichts zu hoeren. Selbst das vermutbare Knistern "
    "der Fackeln wird irgenwie unterdrueckt.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier frisch und angenehm. Ein paar Kerzen auf dem Altar "
    "riechen nach Wachs. Ein sanfter Geruch von Weihrauch liegt in der "
    "Luft.");

  AddSmell( "kerzen",
    "Die riechen nach Wachs.");

  AddSmell( "wachs",
    "Wonach soll Wachs schon riechen? Nach Wachs halt :)");

  AddSmell( ({ "geruch","weihrauch","luft" }) ,
    "Ein sanfter Geruch von Weihrauch liegt in der Luft. Er ist angenehm "
    "und wohltuend.");

// nach cadrims tod deaktiviert, zordan
//  AddSpecialDetail( ({ "lichtes","ortes","edelsteinen" }), "falle" );

  AddCmd( ({ "nimm","nehm","nehme" }) , "nehmfkt" );
  AddCmd( ({ "huldige" }) , "huldigefkt" );

  AddExit("sueden", "./burg_d2");
}

int nehmfkt(string str) {
  string was;
  notify_fail("WAS nehmen ?\n");
  if (!str) return 0;
  notify_fail("Das geht nicht!\n");
  if (sscanf(str,"%s aus schrein",was) != 1) return 0;
  write(BS(
    "Du wuerdest diesen Ort niemals schaenden und etwas aus dem Schrein "
    "nehmen." ));
  return 1;
}

string falle(string str) {
  int lostxp;
  lostxp=TP->QueryProp(P_XP)/2;
  write_paladin_log("scriptfalle", sprintf("%s loest Falle im Tempel aus. "
    "Lvl:%d, IP:%s, lost XP:%d\n", TP->Name(WER),TP->QueryProp(P_LEVEL),
    TP->QueryProp(P_CALLED_FROM_IP),lostxp));
  if(TP->QueryProp(P_LEVEL)<10) return "Sowas siehst Du da nicht!\n";
  TP->SetProp(P_XP, lostxp);
  TP->die();
  return BS(
    "Da Menschen solche Worte nicht untersuchen, verlierst Du hiermit "
    "die Haelfte aller Deiner Erfahrungspunkte, bekommst einen Eintrag "
    "in einem Logfile und bei Wiederholung wirst Du geloescht. OHNE GNADE. "
    "Solltest Du dennoch nicht betrogen haben, kannst Du ja versuchen, Dich "
    "an einen Erzmagier wenden und ihm diesen Raum zeigen.");
}

int huldigefkt(string str) {
  int a;
  notify_fail("Wen willst Du huldigen?\n");
  if (!str) return 0;
  if (str != "dusty") {
    write(BS(
      "Du huldigst "+CAP(str)+" und Dich durchfaehrt ein stechender Schmerz. "
      "Vielleicht solltest Du besser jemand anderen hier huldigen."));
    TP->reduce_hit_point(10+random(10));
    return 1;
  }
  a=TP->QueryProp(P_ALIGN);
  if (anzahl < 0 || a<-1000 || a>1000) {
    write(BS(
      "Du huldigst Dusty doch irgendwie passiert gar nichts."));
    return 1;
  }
  anzahl--;
  if( a < 0) {
    write(BS(
      "Du huldigst Dusty und spuerst wie ihre Gutmuetigkeit Dich "
      "durchfaehrt."));
    TP->SetProp(P_ALIGN,a-(a/10));
    return 1;
  }
  write(BS(
    "Du huldigst Dusty und spuerst wie ihre Gutmuetigkeit Dich "
    "durchfaehrt."));
  TP->SetProp(P_ALIGN,a+(a/10));
  return 1;
}
