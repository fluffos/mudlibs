#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

nosave int *kisten=({1,1,1});
nosave string *staender=({"/p/magic/glasschwert",
                       "/gilden/paladine/weapon/spalter",
                       "/gilden/paladine/weapon/blitzschwert"});


create() {
  ::create();
  
  SetProp( P_INT_SHORT, "In einer Schatzkammer" );
  SetProp( P_INT_LONG,
      "Du befindest Dich hier in einer hell erleuchteten Kammer. Die "
      "Fackeln an den Waenden erhellen den Raum in einen gleissenden "
      "Licht. Der Boden und die Waende scheinen aus poliertem "
      "Kupfer zu bestehen und reflektieren das Licht noch mehr. "
      "An den Waenden sind Staender mit verschiedenen Waffen zu "
      "erkennen, am hinteren Ende stehen mehrere eisenverstaerkte "
      "Kisten. Offenbar befindest Du Dich hier in der Schatzkammer "
      "der Burg Sturmfels.");

  SetProp( P_LIGHT, 5 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"raum"}),
      "Offenbar befindest Du Dich hier in einer Schatzkammer.");
  AddDetail( ({"schatzkammer", "kammer"}),
      "Die Schaetze scheinen wohl in den Kisten und auf den "
      "Staendern zu sein.");
  AddDetail( ({"schaetze"}),
      "Wer weiss welche Reichtuemer hier in den Kisten liegen ...");
  AddDetail ( ({"reichtuemer"}),
      "Schau doch einfach nach!");
  AddDetail( ({"boden" }),
      "Der Boden ist - wie sollte es sein - unter Dir. Er besteht "
      "aus poliertem Kupfer und reflektiert das Licht tausendfach.");
  AddDetail( ({"decke" }),
      "Die Decke besteht - wie alles hier - aus poliertem Kupfer.");
  AddDetail( ({"wand","waende" }), 
      "Die Waende rings um Dich sind mit poliertem Kupfer verkleidet. "
      "Sie reflektieren das Licht der an ihnen angebrachten Fackeln "
      "tausendfach und erhellen somit den Raum. Im hinteren Teil "
      "des Raumes befinden sich Staender mit verschiedenen Waffen.");
  AddDetail( ({"teil"}),
      "Im hinteren Teil der Schatzkammer befinden sich Staender mit "
      "verschiedenen Waffen.");
  AddDetail( ({"waffen"}),
      "Auf den ersten Blick siehst Du Schwerter.");
  AddDetail( ({"blick"}),
      "Ja, es sind Schwerter.");
  AddDetail(({"schwerter"}),
    "Paladine kaempfen mit Schwerter, so ist es nicht verwunderlich, "
    "das in der Schatzkammer nur die besten Schwerter zu finden sind.");
  AddDetail( ({"paladine"}),
      "Pass bloss auf, dass Dich keiner hier unten erwischt.");
  AddDetail( ({"kupfer"}),
      "Die Waende, die Decke und der Boden hier sind mit poliertem "
      "Kupfer ueberzogen. Dadurch wird das Licht der Fackel "
      "tausendfach verstaerkt und erhellt den Raum in einem "
      "gleissenden Strahlen.");
  AddDetail( ({"strahlen" }),
      "Der Raum ist extrem hell und blendet Dich ziemlich.");
  AddDetail( ({"licht" }),
      "Das Licht, welches von den Waenden refelktiert wird, erhellt "
      "den Raum ungemein. Es blendet schon fast.");
  AddDetail( ({"fackel", "fackeln" }), 
      "Die Fackeln haengen an den Waenden. Sie sind entzuendet und "
      "erhellen den Raum.");
  AddDetail( ({"ende"}),
      "Im hinteren Ende der Schatzkammer befinden sich drei Kisten!");
  AddDetail( ({"burg", "paladinburg", "festung"}),
      "Diese stolze Burg ist die Festung der Paladine! Ihr Name ist "
      "Sturmfels.");
  AddDetail( ({"sturmfels", "name"}),
      "Das ist der Name der Paladinburg.");
  AddDetail( ({"symbole"}),
      "Auf dem Mithriltor sind die heiligen Symbole der Dusty - "
      "Schwert und Rose - abgebildet.");
  AddDetail( ({"schwert", "rose"}),
      "Schwert und Rose sind die heiligen Symbole der Dusty!");
  AddDetail( ({"dusty", "goettin"}),
      "Dusty ist die Goettin der Paladine.");

  AddSound(DEFAULT_SOUND, "Es ist still hier.");
  
  AddSpecialDetail( ({"staender", "waffenstaender"}), "staender_status");
  AddSpecialDetail( ({"kisten",}), "kisten_status"); 
  
  AddCmd( ({"nimm"}), "schatz_nehmen");
  AddCmd( ({"oeffne","oeffnen"}), "kisten_oeffnen");
  
  NewDoor("osten", ROOM("burg_geheim6"), ({"goldtor", "tor"}), 
      ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY,
        D_LONG, BS("Das Goldtor sieht sehr massiv aus. Es scheint "
          "wirklich aus massivem Gold zu sein."),
        D_SHORT,"Im Osten siehst Du ein %ses Goldtor.\n", 
        D_NAME,"Mithriltor",
        D_MSGS, ({"das Goldtor", "durchschreitet", "kommt durch "
            "das Goldtor herein"})
        }));

  SUID;
  set_next_reset(300);
}

int waechter_check() {
  object ob;
  if(ob=present("schatzwaechter")) {
    tell_room(ME, sprintf("%s laesst %s das Tor nicht oeffnen.\n",
        ob->Name(WER),TP->name(WEN)),({TP}));
    write(sprintf("%s laesst Dich das Tor nicht oeffnen!\n", 
          ob->Name(WER)));
    return 1;
  }
  return 0;
}

reset() {
  object *inv;
  int i, x;
  x=0;
  ::reset();
  inv=all_inventory(ME);
  for(i=sizeof(inv)-1;i>=0;i--) {
    if(query_once_interactive(inv[i]))
      x++;
  }
  if(!x) {
    kisten=({1,1,1});
    staender=({"/p/magic/glasschwert",
               "/gilden/paladine/weapon/spalter",
               "/gilden/paladine/weapon/blitzschwert"});
  }
}

nosave string kisten_status() {
  string txt;
  txt="Die Kisten stehen im hinteren Teil der Kammer. Es sind drei an "
      "der Zahl. Die Kisten sind mit Eisenbaendern verstaerkt und sehen "
      "sehr stabil aus. "; 
  
  if(kisten[0]&&kisten[1]&&kisten[2]) 
    return BS(txt+"Alle Kisten sind verschlossen.");
  
  txt+="Folgende Kisten sind verschlossen: ";
  if(kisten[0]) txt+="die Erste, ";
  if(kisten[1]) txt+="die Zweite, ";
  if(kisten[2]) txt+="die Dritte";
  if(!kisten[0]&&!kisten[1]&&!kisten[2]) txt+="Keine";
  txt+=".";
  return BS(txt);
}

nosave string staender_status() {
  string txt;
  txt="Die Waffenstaender stehen an der hinteren Wand. Sie scheinen aus "
    "purem Gold zu bestehen. ";
  if(staender[0]) txt+="Auf dem ersten Staender befindet sich "
      "ein glaesernes Schwert. ";
  if(staender[1]) txt+="Auf dem zweiten Staender befindet sich ein "
    "wuchtiges Schwert. ";
  if(staender[2]) txt+="Am dritten Waffenstaender befindet sich ein "
    "Schwert, das von Blitzen umzuckt wird. ";
  
  return BS(txt);
}

nosave int schatz_nehmen(string str) {
  string was, v_wo, nummer;
  object schwert;
  int nr;
  if(!str) return 0;
  if(sscanf(str,"%s von %s %s", was, v_wo, nummer)==3) {
    if((lower_case(was)=="schwert") &&
        (member(({"waffenstaender", "staender"}), lower_case(v_wo))!=-1)) 
    {
      switch(lower_case(nummer)) {
        case "1":
        case "eins": nr=0; break;
        case "2":
        case "zwei": nr=1; break;
        case "3":
        case "drei": nr=2; break;
        default: nr=-1;
      }
      if(nr==-1) {
        write("Es sind drei Staender hier. Welchen meinst Du?\n");
        return 1;
      }
      if(!staender[nr]) {
        write("Dieser Staender ist leider leer.\n");
        return 1;
      }
      schwert=clone_object(staender[nr]);
      if(schwert->move(TP, M_GET)==ME_TOO_HEAVY) {
        write("Leider ist Dir das Schwert zu schwer.\n");
        schwert->remove();
        return 1;
      }
      write("Du nimmst das Schwert vom Waffenstaender.\n");
      say(sprintf("%s nimmt ein Schwert von einem der Waffenstaender.\n", 
          TP->Name(WER)));
      staender[nr]=0;
      return 1;
    }
    else {
      write("Was willst Du von den Waffenstaendern nehmen?\n");
      return 1;
    }
  }
  return 0;
}

nosave int kisten_oeffnen(string str) {
  string was,nummer;
  int nr,i;
  object *ob;
  ob=({});
  if(!str) {
    write("Was willst Du womit von wo oeffnen?\n");
    return 1;
  }
  if(sizeof(regexp(({str}), "[Tt]or")))
    return 0;
  if(sscanf(str, "%s %s", was, nummer)==2) {
    if(member(({"kiste", "schatzkiste"}), lower_case(was))==-1)
      return 0;
    switch(lower_case(nummer)) {
      case "1":
      case "eins": nr=0; break;
      case "2":
      case "zwei": nr=1; 
           ob+=({clone_object("/gilden/druidenzirkel/armour/"
               "elementarhandschuhe")});
           ob+=({clone_object("/p/armour/armour/plattenpanzer")});
           ob+=({clone_object("/p/armour/helm/topfhelm")});
           break;
      case "3":
      case "drei": nr=2; 
           ob+=({clone_object("/p/weapon/axe/streitaxt")});
           break;
      default: nr=-1;
    }
    if(nr==-1) {
      write("Welche Kiste moechtest Du oeffnen. Es sind drei "
          "Kisten hier.\n");
      return 1;
    }
    if(!kisten[nr]) {
      write("Diese Kiste ist leider leer.\n");
      for(i=sizeof(ob)-1;i>=0;i--) {
        if(objectp(ob[i]))
         ob[i]->remove(); 
      }
      return 1;
    }
    write("Du oeffnest die Kiste und legst die Schaetze auf den Boden!\n");
    say(BS(sprintf("%s oeffnet eine Kiste und legt die Schaetze auf den "
        "Boden.\n", TP->Name(WER))));
    while(sizeof(ob)) {
      if(objectp(ob[0]) && ob[0]->id("streitaxt")) {
        find_object(ITEMD)->identify(ob[0],-1,50,random(20),
            ({1,50,100,1000,1001}),1,0);
      }
      ob[0]->move(ME, M_NOCHECK);
      ob-=({ob[0]}); 
    }
    "/obj/gemmaster"->DistributeGem(10+random(10),5,1,1);
    kisten[nr]=0;
  }
  else write("Welche Kiste moechstest Du oeffnen?\n");
 return 1; 
}

void clean_double() {} // Keine Items zerstoeren
int clean_up(int refcount) { return 1; }

void BecomesNetAlive(object spieler) {
  object ayla;
  call_other(NPCMASTER, "AddEnemy", spieler);
  if(ayla=find_living("ayla"))
    ayla->command_me("prufe Paladine! "+CAP(getuid(spieler))+" war so schlau, "
        "in der Schatzkammer einzuschlafen und versucht sie nun ein zweites "
        "Mal zu pluendern! Passt auf was mit solchen Leuten passiert!");
  tell_room(ME, "Das Mithriltor oeffnet sich!\n");
  call_other(NPCMASTER, "AddEnemy", spieler);
  CLONEME(NPC("schatzwaechter"));
  CLONEME(NPC("schatzwaechter"));
  catch(present("mithrilschluessel", spieler)->remove());
  tell_room(ME, "Der Schatzwaechter sagt: Nun bist Du dran!\n");
  tell_room(ME, "Das Mithriltor schliesst sich!\n");
  catch(present("schatzwaechter")->Kill(spieler)); // quick'n'dirty :)
  catch(present("schatzwaechter 2")->Kill(spieler));
  return ;
}

