
/*
**
** Der Ziehbrunnen der Paladine ( hauptplatz )
** Zordan@SL
** 30.04.1998
**
*/

#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int wo,wasser,anzahl,unterwegs;

reset() {
  ::reset();
  anzahl=3+random(2);
}

create() {
  ::create();

  wo=0;
  wasser=0;
  unterwegs=0;
  anzahl=3;

  SetProp( P_INT_SHORT, "Haupthof in Burg Sturmfels" );
  SetProp( P_INT_LONG,
    "Du findest Dich inmitten der Burg Sturmfels wieder. Hier scheint der "
    "genaue Mittelpunkt der Burg zu sein. Der Weg teilt sich vom Sueden her "
    "nach Westen und Osten. Das ausgelegte Stroh fuehrt in einem grossen "
    "Kreis um einen grossen Ziehbrunnen herum. Nach Norden kannst Du den "
    "Burgfried betreten." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "wasser" }),
    "Das Wasser sieht klar und frisch aus.");

  AddSpecialDetail( ({ "ziehbrunnen","brunnen" }), "brunnen");

  AddDetail( ({ "aufbau" }),
    "Recht gewaltig schaut der Ziehbrunnen schon aus.");

  AddDetail( ({ "steine" }),
    "Das sind ziemlich grobe und grosse Steine. Hellweiss leuchten sie in der "
    "Sonne. Fugen kannst Du komischerweise keine sehen. Dafuer kannst Du "
    "eine kleine Vorrichtung inmitten eines Steines sehen.");

  AddDetail( ({ "stein" }),
    "In einem Stein ist eine kleine Vorrichtung eingebaut worden.");

  AddDetail( ({ "vorrichtung" }),
    "Mit dieser Vorrichtung kann man wohl den Eimer hinauf- und hinablassen.");

  AddSpecialDetail( ({ "eimer" }), "eimer");

  AddDetail( ({ "seil","dienst" }),
    "Das Seil ist zwar schon uralt und meist feucht, aber es wird noch "
    "jahrelang seinen Dienst verrichten.");

  AddDetail( ({ "fugen" }),
    "*seufz* Danke, hier sind keine Fugen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne strahlt vom Himmel herunter und erwaermt diesen Ort.");

  AddDetail( ({ "boden" }),
    "Der Weg teil sich vom Sueden her nach Osten und Westen. Er ist komplett "
    "mit Stroh ausgelegt und ziemlich hart.");

  AddDetail( ({ "himmel" }),
    "Solange Dusty bei Dir ist, ist der glatt ueber Dir.");

  AddDetail( ({ "dusty","goettin" }),
    "Dusty ist die Goettin der Paladine und wacht sehr genau ueber sie.");

  AddDetail( ({ "burgfried","fried","norden" }),
    "Der Burgfried liegt ruhig im Norden. Du kannst ihn leicht betreten. "
    "Allerdings liegt auf dem Weg dorthin kein Stroh. Dafuer gibt es umso "
    "mehr Spuren.");

  AddDetail( ({ "spuren" }),
    "Sehr viele Spuren fuehren in den Burgfried. Hier gehen wohl haeufiger "
    "Paladine ein und aus. Der Boden ist wirklich unglaublich hart geworden.");

  AddDetail( ({ "paladine" }),
    "Paladin oder Paladine, das ist hier die Frage.");

  AddDetail( ({ "paladin" }),
    "Aha, ein Paladin steht vor dem Burgfried und laechelt Dich an. Er winkt "
    "Dir sogar zu, den Burgfried zu betreten. Du denkst . o O ( Eigentlich "
    "sind die Paladine wirklich hoeflich )");

  AddDetail( ({ "frage" }),
    "Oder Antwort?");

  AddDetail( ({ "antwort" }),
    "Oder Frage?");

  AddDetail( ({ "burg","ort" }),
    "Du stehst mitten in der Burg. Die Burg ist naemlich symmetrisch, wie "
    "Du jetzt feststellen musst.");

  AddDetail( ({ "sturmfels" }),
    "Die Burg hat schon so manchen Angriff abgewehrt. Es scheint fast "
    "unmoeglich, sie einnehmen zu koennen.");

  AddDetail( ({ "angriff" }),
    "Sogar heute noch kommen selten welche vor. Aber die werden immer ganz "
    "leicht abgeschlagen.");

  AddDetail( ({ "mittelpunkt","punkt","mitte" }),
    "Du stehst genau in der Mitte der Burg. Der Ziehbrunnen scheint sehr "
    "zentral zu sein.");

  AddDetail( ({ "weg" }),
    "Lehm ist der Hauptbestandteil des Weges. Viel von dem herumliegendem "
    "Stroh wurde inzwischen fest in den Boden getreten.");

  AddDetail( ({ "lehm" }),
    "Der Lehm ist dunkelbraun und schon wirklich sehr festgetreten. Dadurch "
    "wurde der Boden sehr fest und man kann hier sehr gut kaempfen.");

  AddDetail( ({ "hauptbestandteil" }),
    "Davon ist halt am meisten da.");

  AddDetail( ({ "stroh" }),
    "Das Stroh wurde in einem grossen Kreis um den Ziehbrunnen verteilt. Es "
    "saeumt den Weg und gibt Dir sicheren Halt beim Gehen. Oder sollte "
    "es einen anderen Grund dafuer geben?");

  AddDetail( ({ "kreis" }),
    "Na perfekt ist der Kreis nicht. Aber schon ganz gut gelungen.");

  AddDetail( ({ "halt","gehen" }),
    "Du wirst hier wohl nicht ausrutschen.");

  AddDetail( ({ "grund" }),
    "Ob Du ihn herausfinden kannst?");

  AddSound( DEFAULT_SOUND,
    "Der Wind weht hier leise, macht es aber ein weniger kuehler als sonst.");
    
  AddSound( "wind",
    "Der Wind pfeift vor sich hin.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Stroh.");

  AddSmell( "stroh",
    "Das Stroh riecht nicht mehr so ganz frisch.");

  AddCmd( ({ "lass","lasse" }), "lassefkt" );
  AddCmd( ({ "trink","trinke" }), "trinkefkt" );

  AddExit("osten", "./burg_d2");
  AddExit("norden", "../../paladine");
  AddExit("westen", "./burg_b2");
  AddExit("sueden", "./burg_c3");
  AddItem(NPC("waechter"), REFRESH_DESTRUCT);
  AddItem(NPC("portalwaechter"), REFRESH_DESTRUCT);
  AddItem(NPC("portalwaechter"), REFRESH_DESTRUCT);
}

string brunnen() {
  string str;
  str="Der Ziehbrunnen bildet den Mittelpunkt der Burg Sturmfels. Steine "
     +"wurden fuer seinen Aufbau benutzt. Nahezu kreisrund ist er gemauert. ";
  if (wo==1)
    return BS(str+"Ein Seil haengt hinunter.");
  return BS(str+"Ein kleiner Eimer haengt an einem Seil daran.");
}

string eimer() {
  string str;
  str="Das ist ein ganz normaler Eimer an einem Seil. ";
  if (wo==1)
    return BS(str+"Der Eimer ist zu weit unten, als das Du etwas genauer erkennen "
          +"koenntest.");
  if (wasser==0)
    return BS(str+"Der Eimer ist leer.");
  return BS(str+"Der Eimer ist voller frischem Wasser.");
}

int lassefkt(string str) {
  notify_fail("Der Eimer ist noch unterwegs!\n");
  if (unterwegs!=0) return 0;
  notify_fail("Was willst Du genau machen?\n");
  if (str== "eimer hinab") {
    if (wo==1) {
      write("Aber der Eimer ist doch schon unten.\n");
      return 1;
    }
    if (wasser==1) {
      write("Wozu den Eimer hinablassen, wenn er schon voller Wasser ist?\n");
      return 1;
    }
    write(BS("Du betaetigst die Vorrichtung und der Eimer gleitet langsam "
             "nach unten."));
    say(BS(CAP_TPN+" laesst den Eimer langsam hinab."));
    unterwegs=1;
    wo=1;
    call_out("runter1",5);
    return 1;
  }
  if (str== "eimer hinauf") {
    if (wo==0) {
      write("Aber der Eimer ist doch schon oben.\n");
      return 1;
    }
    write(BS("Du betaetigst die Vorrichtung und der Eimer gleitet langsam "
             "nach oben."));
    say(BS(CAP_TPN+" holt den Eimer langsam rauf."));
    unterwegs=1;
    wo=0;
    call_out("rauf1",5);
    return 1;
  }
  return 0;
}

void runter1() {
  tell_room(ME,
    BS("Der Eimer platscht in das Wasser und fuellt sich.\n"));
  call_out("runter2",5);
}

void runter2() {
  tell_room(ME,
    BS("Mit einem lauten Glucksen hat sich der Eimer jetzt mit Wasser "
       "gefuellt.\n"));
  unterwegs=0;
  wasser=1;
}

void rauf1() {
  tell_room(ME,
    BS("Der Eimer gleitet weiter nach oben.\n"));
  call_out("rauf2",5);
}

void rauf2() {
  tell_room(ME,
    BS("Der Eimer ist jetzt ganz oben angekommen.\n"));
  unterwegs=0;
  anzahl--;
  if (anzahl < 0) {
    wasser=0;
    tell_room(ME,
      BS("Leider ist auf dem Weg nach oben das ganze Wasser entwichen.\n"));
  }
}

int trinkefkt(string str) {
  notify_fail("Was willst Du trinken?\n");
  if ((str != "wasser") && (str != "wasser aus eimer") && (str != "aus eimer")) {
    return 0;
  }
  if (unterwegs==1) {
    write(BS("Aber der Eimer ist doch noch unterwegs!\n"));
    return 1;
  }
  if (wo==1) {
    write(BS("Aber der Eimer ist doch viel zu weit unten!\n"));
    return 1;
  }
  if (wasser==0) {
    write(BS("Aber der Eimer ist doch leer!\n"));
    return 1;
  }
  wasser=0;
  TP->heal_self(40+random(40));
  write(BS("Du trinkst das Wasser und fuehlst Dich sofort erfrischt "
           "und sogar gestaerkt."));
  say(BS(CAP_TPN+" trinkt das Wasser und sieht gestaerkt aus."));
  return 1;
}
