
#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int found;

reset() {
  ::reset();
  found=0;
}

create() {
  ::create();

  found=0;

  SetProp( P_INT_SHORT, "In einem engen Abzug" );
  SetProp( P_INT_LONG,
    "Du steckst mitten in einem winzigen Abzug fest. Rauch zieht an Dir "
    "vorbei und macht Dir im wahrsten Sinne des Wortes das Leben schwer. "
    "Die Waende bestehen komplett aus schwarzen Steinen. In der Decke und "
    "im Boden siehst Du ein kleines Loch." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "abzug" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "wand","waende" }),
    "Waende kann man eigentlich gar nicht sagen. Rings um Dich herum "
    "sind nur schwarze Steine.");

  AddDetail( ({ "steine" }),
    "Die Steine sind in den Jahren komplett schwarz geworden. Ihre "
    "Konturen kann man heute nur noch erahnen. Von den Fugen sieht man "
    "schon gar nichts mehr.");

  AddDetail( ({ "jahre","jahr","schmied" }),
    "Die Burg gibt es ja schon laenger. Und den Schmied sicherlich auch.");

  AddDetail( ({ "burg","sturmfels" }),
    "Du bist immer noch auf der Burg Sturmfels. Allerdings in einem Abzug "
    "gefangen.");

  AddDetail( ({ "konturen" }),
    "Du kannst die Konturen nicht mehr erkennen.");

  AddDetail( ({ "fugen" }),
    "Du kannst keine Fugen mehr erkennen.");

  AddDetail( ({ "loch","loecher" }),
    "Die beiden Loecher sind wirklich winzig. Mit einer Menge Glueck kommst "
    "Du hier vielleicht wieder raus. Falls nicht, wirst Du hier wohl sterben.");

  AddDetail( ({ "menge","glueck" }),
    "Ob man hier wirklich eine Menge Glueck braucht?");

  AddDetail( ({ "himmel" }),
    "Durch das Loch in der Decke kannst Du tatsaechlich den blauen Himmel "
    "sehen.");

  AddDetail( ({ "decke" }),
    "Durch das Loch in der Decke scheint ein wenig Licht herein.");

  AddDetail( ({ "licht" }),
    "Es reicht leicht aus, so dass Du hier genug sehen kannst.");

  AddDetail( ({ "boden" }),
    "Der Boden ist eigentlich nur ein kleines Loch.");

  AddDetail( ({ "leben" }),
    "Du bekommst hier echt nicht viel Luft. Besser Du versuchst so schnell "
    "wie moeglich wieder hier rauszukommen.");

  AddDetail( ({ "luft" }),
    "Die Luft hier ist so dreckig, dass man sie wirklich nicht einatmen "
    "sollte. Aber was bleibt Dir uebrig, solange Du hier drinnen festsitzt...");

  AddDetail( ({ "sinne","wort","worte","wortes" }),
    "Jemand seufzt.");

  AddDetail( ({ "augen" }),
    "Deine Augen traenen.");

  AddDetail( ({ "jemand" }),
    "Jemand arglt.");

  AddDetail( ({ "rauch" }),
    "Der Rauch zieht von unten her nach oben an Dir vorbei. Er treibt Dir "
    "dicke Traenen in die Augen und Du kannst nur sehr schwer atmen.");

  AddDetail( ({ "traenen" }),
    "Dicke Traenen laufen an Deinem Gesicht herunter.");

  AddDetail( ({ "gesicht" }),
    "Das Wasser Deiner Traenen und der Rauch vermischen sich zu einer "
    "dreckigen Schicht auf Deiner Haut.");

  AddDetail( ({ "wasser" }),
    "Das Wasser Deiner Traenen. Waschen kann man sich damit aber nicht :)");

  AddDetail( ({ "haut","schicht" }),
    "Du bist super dreckig geworden hier drin.");

  AddSound( DEFAULT_SOUND,
    "Von unten hoerst Du lautes Haemmern.");
    
  AddSound( "haemmern",
    "Es hoert sich an, als ob Jemand etwas schmiedet.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier arg nach Rauch.");

  AddSmell( "rauch",
    "Der Rauch riecht wirklich ekelhaft. Er treibt Dir Traenen in die Augen.");

  AddSpecialDetail( "hebel", "hebelfkt" );

  AddCmd( ({ "erahn","erahne" }),   "erahnfkt" );
  AddCmd( ({ "drueck","druecke" }), "drueckfkt" );
  AddCmd( ({ "zieh","ziehe" }),     "ziehfkt" );

  AddSpecialExit( "unten", "untenfkt" );
  AddSpecialExit( "oben", "obenfkt" );
}

int untenfkt(string str) {
  if (random(100) > 20) {
    write(BS(
      "Du versuchst Dich nach unten aus dem Abzug fallen zu lassen. Aber "
      "Du schaffst es nicht, weil Du im Moment zu festgeklemmt bist."));
    return 1;
  }
  write(BS(
    "Du versuchst Dich nach unten aus dem Abzug fallen zu lassen. Da "
    "Du im Moment nicht so sehr festgeklemmt bist, schaffst Du es auch."));
  TP->move( ROOM("burg_e2") , M_GO, 0,
    "laesst sich nach unten fallen",
    "faellt aus der Decke herunter");
  return 1;
}

int obenfkt(string str) {
  write(BS(
    "Du versuchst nach oben aus dem Abzug rauszuklettern. Aber "
    "Du schaffst es nicht, weil Du im Moment zu festgeklemmt bist."));
  return 1;
}

int erahnfkt(string str) {
  notify_fail("Was willst Du denn erahnen?\n");
  if (str != "kontur" && str != "konturen") return 0;
  found=1;
  write(BS(
    "Du versuchst die Konturen genauer zu erahnen. Du schaffst es nicht. "
    "Aber auf einmal faellt Dir doch tatsaechlich ein kleiner Hebel auf."));
  return 1;
}

string hebelfkt() {
  if (found==0) return 0;
  return BS(
    "Der kleine Hebel sitzt in der Wand fest. Komisch, was macht denn "
    "hier ein kleiner Hebel?");
}

int ziehfkt(string str) {
  if (found==0) return 0;
  notify_fail("An was willst Du ziehen?\n");
  if (str != "hebel") return 0;
  write(BS(
    "Du ziehst an dem Hebel. Du hoerst nur ein leises *Klick*"));
  return 1;
}

int drueckfkt(string str) {
  if (found==0) return 0;
  notify_fail("Was oder wen willst Du denn druecken?\n");
  if (str != "hebel") return 0;
  call_other( ROOM("w_weg_e2"), "hebelfkt");
  write(BS(
    "Du drueckst den Hebel nach oben. Du hoerst nur ein leises *Klick*"));
  return 1;
}
