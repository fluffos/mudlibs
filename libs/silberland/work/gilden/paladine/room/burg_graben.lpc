
#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einem Burggraben" );
  SetProp( P_INT_LONG,
    "Du schwimmst mitten in dem sehr kalten Burggraben. Die Haengebruecke ist "
    "direkt ueber Dir. Leider siehst Du keine Chance hier jemals wieder zu "
    "entkommen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_WATER]) );
  SetProp(P_NO_TPORT, NO_TPORT);
  
  AddDetail( ({ "himmel" }),
    "Die Sonne steht hoch am Himmel.");

  AddDetail( ({ "sonne" }),
    "Sie strahlt herunter, aber erwaermt das Wasser wirklich nicht besonders.");

  AddDetail( ({ "boden" }),
    "Boden gibt es hier nicht, nur Wasser.");

  AddDetail( ({ "burg" }),
    "Die Burg ist vor und ueber Dir.");

  AddDetail( ({ "burggraben","graben" }),
    "Du schwimmst mitten in ihm.");

  AddDetail( ({ "haengebruecke","bruecke" }),
    "Die Bruecke ist viel zu weit ueber Dir, als das Du sie jemals erreichen "
    "koenntest.");

  AddDetail( ({ "chance" }),
    "Du siehst hier wirklich keine Chance!!!");

  AddDetail( ({ "glucksen" }),
    "Das entsteht wenn das Wasser am Ufer anschlaegt.");

  AddDetail( ({ "ufer" }),
    "Das Ufer ist zwar genau neben Dir. Aber dort kannst Du niemals rauf.");

  AddDetail( ({ "wasser" }),
    "Das Wasser ist eisig kalt.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leises Glucksen.");
  AddSound("glucksen",
    "Das Glucksen hoert sich lustig an, ist aber in dieser Situation eher "
    "nebensaechlich.");

    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach abgestandenem Wasser.");

  AddSmell( "wasser",
    "Das Wasser riecht total abgestanden und faul.");

  AddItem( NPC("piranha") , REFRESH_DESTRUCT );

  AddCmd( ({ "schwimme","schwimm" }) , "schwimmfkt" );
  AddCmd( ({ "tauch","tauche" }) , "tauchfkt" );
}

int schwimmfkt(string str) {
  write(BS(
    "Ja genau, Du schwimmst immer noch in dem Burggraben."));
  return 1;
}

int tauchfkt(string str) {
  notify_fail("Tauchen? Hier?\n");
  if (str != "nach unten" && str != "unten" && str != "runter") return 0;
  write(BS(
    "Du holst tief Luft und tauchst nach unten."));
  TP->move( ROOM("burg_unten") , M_GO, 0,
    "taucht nach unten",
    "kommt hereingetaucht");
  return 1;
}

