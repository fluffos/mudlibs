
#include "../paladin.h"

inherit ROOM("w_weg_inh");

#include <properties.h>
#include <language.h>
#include <moving.h>

int hebel;

reset() {
  ::reset();
  hebel=0;
}

create() {
  ::create();

  SetProp( P_HIDE_EXITS, ({ "westen" }) );

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2]+
    " Eine kleine Treppe fuehrt Dich im Westen nach unten.");

  AddDetail( ({ "treppe" }),
    "Eine ziemlich stabile und breite Treppe.");

  AddDetail( ({ "stein" }),
    "Huch, ein Stein scheint ein wenig lose zu sein.");

  AddDetail( ({ "boden" }),
    "Einen richtigen Boden gibt es eigentlich gar nicht. Hunderte von dicken "
    "Planken bietet aber festen Halt. Ein kleines Loch ist hier im Boden.");

  AddDetail( ({ "knopf" }),
    "Ein silberner Knopf halt.");

  AddDetail( ({ "loch" }),
    "Aus dem Loch steigt Rauch auf.");

  AddDetail( ({ "rauch" }),
    "Du schaltest schnell und bist ziemlich sicher, dass es sich um den "
    "Rauch aus der Schmiede handelt.");

  AddDetail( ({ "schmiede" }),
    "Die muss wohl direkt unter Dir sein.");

  AddCmd( ({ "locker","lockere" }) , "lockerfkt" );
  AddCmd( ({ "betaetige" }) , "betaetigefkt" );
  AddCmd( ({ "spring","springe" }) , "springefkt" );

  AddExit( "norden",    "./w_weg_e1" );
  AddExit( "sueden",    "./w_weg_e3" );
  AddExit( "westunten", "./burg_d2" );
  AddExit( "westen",    "./burg_d2" );
}

int lockerfkt(string str) {
  notify_fail("Was willst Du lockern?\n");
  if (str != "stein") return 0;
  write(BS(
    "Du versuchst den Stein zu lockern. Allerdings steckt er doch noch "
    "zu fest in der Mauer. Dafuer findest Du zu Deinem Erstaunen einen "
    "kleinen Knopf. Das ist wohl auch der Grund, warum gerade dieser Stein "
    "so lose ist. Vielleicht kann man ihn ja betaetigen?" ));
  return 1;
}

int springefkt(string str) {
  notify_fail("wohin willst Du springen?\n");
  if (str != "loch" && str != "in loch") return 0;
  write(BS(
    "Du springst in das Loch und findest Dich in dem Abzug wieder." ));
  TP->move( ROOM("burg_ab") , M_GO, 0,
    "springt in das Loch",
    "springt von oben herein");
  return 1;
}

hebelfkt() {
  hebel=1;
}

int betaetigefkt(string str) {
  notify_fail("Was willst Du betaetigen?\n");
  if (str != "knopf") return 0;
  say(BS(CAP_TPN+" fummelt an der Mauer herum."));
  if (hebel == 0) {
    write(BS(
      "Du betaetigst den Knopf. Doch komisch. Du hoerst zwar ein 'Klick', "
      "doch es passiert weiter nichts."));
    return 1;
  }
  write(BS(
    "Du betaetigst den Knopf. Ein kurzes Klicken, dann Staunen, dann Leere "
    "unter Deinen Fuessen. Du faellst hinunter."));
  TP->move( ROOM("burg_geheim") , M_GO, 0,
    "faellt auf einmal durch ein Loch nach schraeg unten",
    "faellt aus der Decke herunter");
  return 1;
}
