
#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
object ob;
int reset_ohne_waechter=0;

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine grosse Haengebruecke" );
  SetProp( P_INT_LONG,
    "Im Eingangsbereich zur Burg Sturmfels stehst Du auf einer riesigen "
    "Haengebruecke. Zum Glueck ist sie derzeit herabgelassen und Du kannst "
    "die Burg leicht nach Norden betreten. Wasser schwappt unter der Bruecke "
    "in einem Graben entlang. Oben auf der Mauer enden zwei lange Stege." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "haengebruecke","bruecke" }),
    "Du stehst mitten auf der Haengebruecke. Sie ist komplett aus dicken "
    "Planken gezimmert worden. Starke Eisenketten werden dazu benutzt, sie "
    "raufzuziehen und hinabzulassen.");

  AddDetail( ({ "eisenketten","ketten" }),
    "Armdicke Ketten sorgen dafuer, dass man diese sehr schwere Bruecke "
    "ueberhaupt noch bewegen kann.");

  AddDetail( ({ "boden" }),
    "Du stehst auf der Haengebruecke, also ist der Boden aus hoelzernen "
    "Planken.");

  AddDetail( ({ "planken","holz" }),
    "Die Planken sind aus sehr stabilem Holz. Einige Eisentraeger wurden "
    "zur Verstaerkung noch mit eingearbeitet.");

  AddDetail( ({ "eisentraeger","traeger","verstaerkung" }),
    "Die Eisentraeger machen es unmoeglich, diese Haengebruecke zu zerstoeren.");

  AddDetail( ({ "stege" }),
    "Du kannst nichts auf einem der Stege sehen.");

  AddDetail( ({ "mauer" }),
    "Oben auf der Mauer scheint man gehen zu koennen. Wie weit und warum "
    "kannst Du von hier noch nicht sehen. Aber gegen Angriffe scheint "
    "man diese Konstellation zu nutzen und von dort oben schlimme Dinge "
    "mit seinen Feinden zu machen.");

  AddDetail( ({ "dinge" }),
    "Das ist sowas wie heisses Oel auf die Angreifer schuetten, oder Steine "
    "werfen. Oder aber einfach mit Pfeil und Bogen aus einer Deckung zu "
    "schliessen.");

  AddDetail( ({ "pfeil","bogen","deckung" }),
    "Von dort oben kann man aus einer sehr guten Deckung heraus auf die "
    "Angreifer schiessen. Die Angreifer haetten fast keine Chance.");

  AddDetail( ({ "angreifer" }),
    "Keiner da.");

  AddDetail( ({ "chance" }),
    "Die waere jedenfalls sehr gering.");

  AddDetail( ({ "steine" }),
    "Ein paar kleine Steine liegen noch auf dem Boden.");

  AddDetail( ({ "oel" }),
    "Sei froh das gerade keines auf Dich faellt.");

  AddDetail( ({ "feinde","feind" }),
    "Bist Du denn einer? Falls nicht, dann siehst Du auch keine.");

  AddDetail( ({ "konstellation" }),
    "Man kann von dort oben hervorragend verteidigen und es duerfte ziemlich "
    "unmoeglich sein, diese Burg einzunehmen.");

  AddDetail( ({ "angriffe","angriff","idee" }),
    "Es waere eine sehr schlechte Idee, diese Burg anzugreifen.");

  AddDetail( ({ "graben" }),
    "Der Graben fuehrt wohl rund um die Burg. Kleine Enten schwimmen darin.");

  AddDetail( ({ "enten","ente" }),
    "Grosse und kleine Enten schwimmen in dem Graben und suchen vor allem "
    "nach Futter.");

  AddDetail( ({ "futter" }),
    "Die Enten suchen, finden aber anscheinend nichts.");

  AddDetail( ({ "wasser" }),
    "Das Wasser fliesst ganz langsam in einem kleinen Graben um die Burg "
    "herum. Es laedt fast zum schwimmen ein.");

  AddDetail( ({ "glueck" }),
    "Manchmal muss man auch einfach nur Glueck haben. :)");

  AddDetail( ({ "eingang","eingangsbereich","bereich" }),
    "Du stehst direkt vor der Burg auf einer herabgelassenen Haengebruecke.");

  AddDetail( ({ "burg","sturmfels" }),
    "Die Burg vor Dir strahlt im Sonnenschein. Sie wirkt sehr majestetisch in "
    "ihrem Aussehen.");

  AddDetail( ({ "aussehen","schauer" }),
    "Ein kleiner Schauer rinnt Dir ueber den Ruecken. Diese Burg muss etwas "
    "besonderes sein.");

  AddDetail( ({ "ruecken" }),
    "Du kratzt Dich.");

  AddDetail( ({ "sonnenschein","schein" }),
    "Die Sonne braeht Dich gut von oben.");

  AddDetail( ({ "sonne" }),
    "Die steht am Himmel und strahl Dich an.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist wolkenlos.");

  AddSound( DEFAULT_SOUND,
    "Wasser gluckst im Graben.");
    
  AddSound( ({ "wasser","graben" }) ,
    "*gluck* *gluck*");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht komischerweise nach Stroh. Komisch.");

  AddSmell( ({ "stroh","geruch" }) ,
    "Tatsaechlich. Aus dem Norden stroemt der Geruch von Stroh herein.");

  AddCmd( ({ "oeffne","schliesse","lasse","lass","ziehe","zieh" }) , "oeffnefkt" );
  AddCmd( ({ "schwimm","schwimme" }) , "schwimmfkt" );
  AddCmd( ({ "spring","springe" }) ,   "springfkt" );

  ob=clone_object(NPC("waechter"));
  ob->SetProp(P_MNPC_FLAGS, 0);
  ob->move(ME, M_NOCHECK|M_SILENT);

  AddExit("norden", "./burg_c3");
  AddExit("suedwesten", ANSCHLUSSWEG);
}

int oeffnefkt(string str) {
  string was;
  if (!str) return 0;
  if ((sscanf(str,"bruecke%s",was) == 1) ||
      (sscanf(str,"haengebruecke%s",was) == 1)) {
    write(BS(
      "Leider findest Du im Moment keine Moeglichkeit, dass zu tun."));
    return 1;
  }
  return 0;
}

int schwimmfkt(string str) {
  notify_fail("Wo willst Du schwimmen?\n");
  if (!str) return 0;
  if (str != "graben" && str != "in graben") return 0;
  write(BS(
    "Du findest keine geeignete Stelle um schwimmen zu gehen. Man koennte "
    "ja aber mal wagemutig einfach runterspringen. Das wuerde allerdings "
    "komplett auf eigene Gefahr geschehen!!!"));
  return 1;
}

int springfkt(string str) {
  notify_fail("Springen? Warum?\n");
  if (!str) return 0;
  if (str != "runter" && str != "in graben") return 0;
  write(BS(
    "Du nimmst all Deinen Mut zusammen und springst in den Graben. Selber "
    "Schuld dachtest Du noch. Aber jetzt ist es zu spaet."));
  TP->move( ROOM("burg_graben") , M_GO, 0,
    "springt in den Graben",
    "kommt hereingesprungen");
  return 1;
}

init() {
  ::init(); 
}

void reset() {
  int i;
  ::reset();
  if(present("\n_p_waechter")) {
    reset_ohne_waechter=0;
    return;
  }
  if(reset_ohne_waechter<4)
    reset_ohne_waechter++;
  for (i=0;i<=reset_ohne_waechter;i++) {
    ob=clone_object(NPC("waechter"));
    ob->SetProp(P_MNPC_FLAGS, 0);
    ob->move(ME, M_NOCHECK|M_SILENT);
  }
}
