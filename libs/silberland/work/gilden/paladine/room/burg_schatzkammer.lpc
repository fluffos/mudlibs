#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>



create() {
  ::create();
  
  SetProp( P_INT_SHORT, "In einer Schatzkammer" );
  SetProp( P_INT_LONG,
      "Du befindest Dich hier in einer hell erleuchteten Kammer. Die "
      "Fackeln an den Waenden erhellen den Raum in einen gleissenden "
      "Licht. Der Boden und die Waende scheinen aus poliertem "
      "Kupfer zu bestehen und reflektieren das Licht noch mehr. "
      "Offenbar befindest Du Dich hier in einer der Schatzkammer "
      "der Burg Sturmfels.");

  SetProp( P_LIGHT, 5 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"raum"}),
      "Offenbar befindest Du Dich hier in einer Schatzkammer.");
  AddDetail( ({"schatzkammer", "kammer"}),
      "Schau Dich nur genau um!");
  AddDetail ( ({"reichtuemer"}),
      "Schau doch einfach nach!");
  AddDetail( ({"boden" }),
      "Der Boden ist - wie sollte es sein - unter Dir. Er besteht "
      "aus poliertem Kupfer und reflektiert das Licht tausendfach.");
  AddDetail( ({"decke" }),
      "Die Decke besteht - wie alles hier - aus poliertem Kupfer.");
  AddDetail( ({"wand","waende" }), 
      "Die Waende rings um Dich sind mit poliertem Kupfer verkleidet. "
      "Sie reflektieren das Licht der an ihnen angebrachten Fackeln "
      "tausendfach und erhellen somit den Raum.");
  AddDetail(({"schwerter"}),
    "Paladine kaempfen mit Schwerter, so ist es nicht verwunderlich, "
    "das in der Schatzkammer nur die besten Schwerter zu finden sind.");
  AddDetail( ({"paladine"}),
      "Pass bloss auf, dass Dich keiner hier unten erwischt.");
  AddDetail( ({"kupfer"}),
      "Die Waende, die Decke und der Boden hier sind mit poliertem "
      "Kupfer ueberzogen. Dadurch wird das Licht der Fackel "
      "tausendfach verstaerkt und erhellt den Raum in einem "
      "gleissenden Strahlen.");
  AddDetail( ({"strahlen" }),
      "Der Raum ist extrem hell und blendet Dich ziemlich.");
  AddDetail( ({"licht" }),
      "Das Licht, welches von den Waenden reflektiert wird, erhellt "
      "den Raum ungemein. Es blendet schon fast.");
  AddDetail( ({"fackel", "fackeln" }), 
      "Die Fackeln haengen an den Waenden. Sie sind entzuendet und "
      "erhellen den Raum.");
  AddDetail( ({"burg", "paladinburg", "festung"}),
      "Diese stolze Burg ist die Festung der Paladine! Ihr Name ist "
      "Sturmfels.");
  AddDetail( ({"sturmfels", "name"}),
      "Das ist der Name der Paladinburg.");
  AddDetail( ({"symbole"}),
      "Auf dem Mithriltor sind die heiligen Symbole der Dusty - "
      "Schwert und Rose - abgebildet.");
  AddDetail( ({"schwert", "rose"}),
      "Schwert und Rose sind die heiligen Symbole der Dusty!");
  AddDetail( ({"dusty", "goettin"}),
      "Dusty ist die Goettin der Paladine.");

  AddSound(DEFAULT_SOUND, "Es ist still hier.");
  
  AddSpecialDetail( ({"staender", "waffenstaender"}), "staender_status");
  AddSpecialDetail( ({"kisten",}), "kisten_status"); 
  
  
  NewDoor("norden", ROOM("burg_geheim3"), ({"mithriltor", "tor"}), 
      ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY,
        D_LONG, BS("Das Mithriltor ist ueber und ueber mit "
            "den heiligen Symbolen der Dusty verziert. Sie "
            "sieht sehr stabil und vor allem sehr wertvoll "
            "aus."),
        D_SHORT,"Im Norden siehst Du ein %ses Mithriltor.\n", 
        D_NAME,"Mithriltor",
        D_MSGS, ({"das Mithriltor", "durchschreitet", "kommt durch "
            "das Mithriltor herein"})
        }));

  NewDoor("sueden", ROOM("burg_geheim4"), ({"silberportal", "portal"}), 
      ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY,
        D_LONG, BS("Dieses Portal aus reinestem Silber ist "
            "voellig schmucklos."),
        D_SHORT,"Im Sueden befindet sich ein schmuckloses Silberportal.\n", 
        D_NAME,"Silberportal",
        D_GENDER, NEUTER,
        D_OPENTESTFUNC, "waechter_check",
        D_MSGS, ({"das Silberportal", "durchschreitet", "kommt durch "
            "das Silberportal herein"})
        }));

  SUID;
  set_next_reset(300);
  call_out("clone_standarte", 0);
}

int waechter_check() {
  object ob;
  if(ob=present("schatzwaechter")) {
    tell_room(ME, sprintf("%s laesst %s das Tor nicht oeffnen.\n",
        ob->Name(WER),TP->name(WEN)),({TP}));
    write(sprintf("%s laesst Dich das Tor nicht oeffnen!\n", 
          ob->Name(WER)));
    return 1;
  }
  return 0;
}

reset() {
  object *inv;
  int i, x;
  x=0;
  ::reset();
  inv=all_inventory(ME);
  for(i=sizeof(inv)-1;i>=0;i--) {
    if(query_once_interactive(inv[i]))
      x++;
  }
  if(!QueryProp("standarte")) {
    call_out("clone_standarte",0);
  }
}


void clean_double() {} // Keine Items zerstoeren
int clean_up(int refcount) { return 0; }

void BecomesNetAlive(object spieler) {
  object ayla;
  call_other(NPCMASTER, "AddEnemy", spieler);
  if(ayla=find_living("ayla"))
    ayla->command_me("prufe Paladine! "+CAP(getuid(spieler))+" war so schlau, "
        "in der Schatzkammer einzuschlafen und versucht sie nun ein zweites "
        "Mal zu pluendern! Passt auf was mit solchen Leuten passiert!");
  tell_room(ME, "Das Mithriltor oeffnet sich!\n");
  call_other(NPCMASTER, "AddEnemy", spieler);
  CLONEME(NPC("schatzwaechter"));
  CLONEME(NPC("schatzwaechter"));
  catch(present("mithrilschluessel", spieler)->remove());
  catch(present("silberschluessel", spieler)->remove());
  catch(present("goldschluessel", spieler)->remove());
  tell_room(ME, "Der Schatzwaechter sagt: Nun bist Du dran!\n");
  tell_room(ME, "Das Mithriltor schliesst sich!\n");
  catch(present("schatzwaechter")->Kill(spieler)); // quick'n'dirty :)
  catch(present("schatzwaechter 2")->Kill(spieler));
  return ;
}

void clone_standarte() {
  object ob;
  if(objectp(ob=find_object(ITEMD)->GenerateUnique(WEAPON("standarte"),1,1)))
  {
    ob->move(TO);
  }
}
