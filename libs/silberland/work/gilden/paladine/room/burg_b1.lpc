inherit "std/pub";

#include <moving.h>
#include <pub.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../paladin.h"

#define AddPropTP(x,y) this_player()->SetProp(x,this_player()->QueryProp(x)+y)
nosave int lager=40;


create() {
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Schenke 'Schwert und Schild'");
  SetProp (P_INT_LONG, 
           "Du befindest Dich in der Schenke 'Schwert und Schild' " 
          +"in Burg Sturmfels. Im ganzen Raum verteilt stehen "
          +"Tische und Stuehle, die genug Platz bieten, um sich "
          +"gemuetlich auf ein Bier niederzulassen. An den Waenden "
          +"haengen etliche Waffen und Ruestungen, und verleihen "
          +"damit der Schenke ein kriegerisches Flair. An der Nordwand "
          +"hinter der Theke haengt eine Tafel, die Du lesen kannst. "
          +"@@pubkeeper1@@");

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "bordur");
  SetProp(P_PUBKEEPER_NAME, "Bordur");
  SetProp(P_PUBMSG_NOKEEPER, "Bordur ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Bordur. Kein Wunder, "
      "dass er Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Bordur kaempft. Da hat er wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Bordur kaempft gerade.\n");

  AddDetail("burg", 
      "Burg Sturmfels ist wahrhaft eine praechtige Burg.");
  AddDetail("platz", 
      "Ja, Platz bieten sie wirklich ausreichend.");
  AddDetail("sturmfels", 
      "Du befindest Dich in ihr. Du fuehlst Dich irgendwie sicher.");
  AddDetail(({"schwert", "schild"}),
      "Ja, so heisst die Schenke: Schwert und Schild.");
  AddDetail("boden", 
      "Der Boden besteht aus massiven Holzdielen. Er ist blitzblank geputzt.");
  AddDetail(({"holzdielen", "dielen"}),
      "Die Holzdielen sehen sehr massiv aus. Sie sind blitzblank geputzt.");
  AddDetail("decke", 
      "An der Decke haengen einige Lampen, die dem Raum "
      "Licht spenden.");
  AddDetail(({"lampen", "lampe", "oellampen"}),
      "Die Oellampen erhellen den Raum und tauchen ihn in ein angenehmes "
      "Licht. Sie haengen an die Decke.");
  AddDetail("licht", 
      "Das Licht ist leicht daemmrig.");
  AddDetail(({"waende", "wand"}), 
      "An den Waenden haengen verschiedene Waffen und Ruestungen. An der "
      "Nordwand ist eine Tafel zu sehen.");
  AddDetail("waffen", 
      "Verschiedene Waffen haengen als Zierde an den Waenden: "
      "Schwerter, Aexte, Dolche, und sogar ein Drachentoeter.");
  AddDetail("zierde",
      "All diese Waffen und Ruestungen sind eine wahrhaft "
      "edle Zierde fuer diese Schenke.");
  AddDetail("aexte",
      "Die Aexte, die an der Wand haengen, sehen sehr maechtig aus.");
  AddDetail("schwerter",
      "Maechtige und edle Schwerter haengen an der Wand.");
  AddDetail("dolche", 
      "Die Dolche sind sehr verziert, und sehen trotz ihrer "
      "geringen Groesse gefaehrlich aus.");
  AddDetail("groesse", 
      "Naja, gross sind sie wirklich nicht.");
  AddDetail("drachentoeter", 
      "Unfassbar! Ein riesiger Drachentoeter haengt hier! "
      "Er ist so gross, dass er von einer Wand zur naechten reicht.");
  AddDetail("ruestungen", 
      "An den Waenden haengen verschiedene prachtvolle Ruestungen: "
      "Kettenhemden, Metallpanzer, Arm- und Beinschienen und dergleichen.");
  AddDetail("kettenhemden", 
      "Die blankpolierten Kettenhemden sind eine wahre Pracht. Sie sind "
      "aus dem besten Zwergenstahl hergestellt.");
  AddDetail("pracht",
      "Ja, dass sind sie.");
  AddDetail("zwergenstahl",
      "Zwergenstahl ist der beste Stahl ueberhaupt. Extrem biegsam und " 
      "dennoch hart.");
  AddDetail(({"metallpanzer", "panzer"}),
      "Der Metallpanzer ist blitzplank geputzt. Er sieht schon recht "
      "alt aus.");
  AddDetail(({"armschienen", "beinschienen", "schienen"}),
      "Die Arm- und Beinschienen sehen sehr alt und abgenutzt ab.");
  AddSpecialDetail(({"raum", "schenke"}), "schenke");
  AddDetail("stuehle", 
      "Sehr viele Stuehle stehen in der Schenke herum, so dass "
      "es sich die Gaeste bequem machen koennen.");
  AddDetail("gaeste", 
      "Es sind einige Gaeste anwesend.");
  AddDetail("tische",
      "Die Tische sind aus massivem Holz gefertigt.");
  AddDetail("holz",  
      "Es handelt sich um massives Eichenholz.");
  AddDetail("eichenholz", 
      "Es sieht sehr massiv aus.");
  AddDetail("flair", 
      "Es ist recht gemuetlich hier.");
  AddDetail("nordwand", 
      "An der Nordwand haengt eine Tafel.");
  AddDetail("tafel", 
      "Du kannst sie mit <menue> lesen.");
  AddSpecialDetail("theke", "pubkeeper");
  AddDetail("bier", 
      "Ja, ein Bier waer jetzt lecker.");
  AddSound(DEFAULT_SOUND,
      "Stimmengemurmel der Gaeste erfuellt die Schenke.");
  AddSound(({"stimmengemurmel", "stimmen", "gemurmel", "gaeste"}),
      "Die Gaeste unterhalten sich. Leider kannst Du "
      "nicht viel verstehen.");
  AddSmell(DEFAULT_SMELL, 
      "Der Geruch von Bier erfuellt den Raum.");
  AddSmell("bier", 
      "Mhhhhhhh... wuerzig!");
  AddSmell("geruch", 
      "Der Geruch von Bier erfuellt den Raum.");
  
  AddDrink("Wasser", ({"wasser"}),
           1, 0, 0, 1, 
           ({"Bordur gibt Dir einen Becher Wasser,den Du "
            +"sofort austrinkst.\n",
             "&& trinkt einen Becher Wasser.\n"}));

  AddDrink("Apfelsaft", ({"saft", "apfelsaft"}),
           50, 12, 0, 5,
           ({"Bordur bringt schmunzelnd einen Becher leckeren "
            +"Apfelsaft.\nDu leerst den Becher in einem Zug.\n",
             "&& trinkt einen schmackhaften Apfelsaft.\n"}));

  AddDrink("Bier", "bier", 
           120, 25, 6, 4,
           ({"Bordur laechelt und bringt Dir einen Humpen Bier.\n",
             "&& trinkt einen Humpen Bier.\n"}));

  AddDrink("Ruebenschnaps", ({"ruebenschnaps", "schnaps"}), 
            150, 28, 15, 1,
           ({"Bordur bringt Dir einen kleinen Ruebenschnaps.\n"
            +"ROECHEL!!!! Der war scharf!!\n",
             "&& trinkt ein Stamperl Schnaps und roechelt dabei.\n"}));

  AddDrink("Sturmfelsbraeu", ({"sturmfelsbraeu", "felsbraeu", "braeu"}),
           200, 33, 20, 8,
           ({"Bordur nickt Dir zu und bringt Dir einen Humpen "
            +"Sturmfelsbraeu.\nDu trinst das Bier voller Genuss.\n",
             "&& trinkt einen Humpen Sturmfelsbraeu.\n&& grinst.\n"}));

  AddFood("Bohnensuppe", ({"suppe", "bohnensuppe"}), 100, 40, 17, 
           ({"Bordur bringt Dir eine Bohnensuppe trintrasiler Art. "
            +"\nHmmmm, die ist lecker, auch wenn sie ein bisschen "
            "fad schmeckt.\n",
             "&& isst eine Bohnensuppe.\n"}));
  AddFood("Ein saftiges Kotlett", ({"kotlett"}), 250, 30, 10, 
           ({"Bordur bringt Dir ein leckeres Kotlett!\n"
            +BS("Wow, ist das Fleisch zart. Du hast schon viele Kotletts "
                "gegessen aber dieses hier ist aussergewoehnlich gut! "
                "Gierig isst Du alles auf und nagst auch den Knochen "
                "komplett ab!"),
             "&& isst gierig ein lecker aussehendes Kotlett!\n"}));

  AddFood("Ein Teller Sauerkraut", ({"sauerkraut", "kraut"}), 100, 15, 5, 
           ({"Bordur bringt Dir einen Teller Sauerkraut!\n"
            +BS("Als Du ihn siehst, bekommst Du so einen Heisshunger, "
              "dass Du ihn auf einmal runterschlingst! Hmmmm "
              "das war lecker! Als Du fertig bist fragst Du Dich warum "
              "Du ploetzlich so gierig darauf warst."),
             "&& isst gierig einen ganzen Teller Sauerkraut!\n"}));
//  auskommentiert weil eh inherited, Zordan
//  AddCmd (({"kauf","kaufe","bestell","bestelle"}),"bestelle");
//  AddCmd (({"spendier","spendiere"}),"spendiere");
//  AddCmd ("","able",1);

  AddCmd(({"hol", "hole"}), "get_heal");
      
  AddItem(NPC("bordur"), REFRESH_DESTRUCT);
  AddItem(NPC("portalwaechter"), REFRESH_DESTRUCT);

  AddExit("sueden", "./burg_b2");
}

reset() {
  ::reset();
  lager=40;
}

string schenke() {
 return process_string(QueryProp(P_INT_LONG));
}

string pubkeeper1() {
  if(present("bordur", TO)) 
    return "Hinter der Theke steht Bordur, der Wirt.";
  return "Im Moment ist die Theke leider verweist.";
}

string pubkeeper() {
  if(present("bordur", TO)) 
    return BS("Hinter der Theke steht Bordur, der Wirt. Wenn er nicht "
      "hier waere, koenntest Du Dir sicher alles umsonst holen.");
  return BS("Im Moment ist die Theke leider verweist. Du koenntest Dir "
    "nun alle Getraenke und Speisen umsonst holen.");
}

int get_heal(string str) {
  mixed drink, food, nr;
  int i;
  nr=({0,-1});
  if(present("bordur", TO)) return 0;
  if(!str) {
    write("Was willst Du Dir holen?\n");
    return 0;
  }
  drink=query_drink();
  food=query_food();
  for(i=sizeof(drink)-1;i>=0;i--)
    if(member(drink[i][1], str)!=-1)
      nr=({"drink",i});
  if(nr[0]!="drink")
    for(i=sizeof(food)-1;i>=0;i--)
      if(member(food[i][1], str)!=-1)
        nr=({"food",i});
  if(!stringp(nr[0])) {
    write("So was findest Du nicht.\n");
    return 1;
  }
  if(!lager) {
    write("Leider sind keine Getraenke oder Speisen mehr da.\n");
    return 0;
  }
  if(nr[0]=="drink") {
    if(TP->QueryProp(P_MAX_ALCOHOL)-TP->QueryProp(P_ALCOHOL) < 
        drink[nr[1]][4])
    {
      write("Soviel Alkohol vertraegst Du nicht!\n");
      return 1;
    }
    if(TP->QueryProp(P_MAX_DRINK)-TP->QueryProp(P_DRINK) < 
        drink[nr[1]][5])
    {
      write("Soviel Fluessigkeit kannst Du nicht trinken!\n");
      return 1;
    }
    tell_room(ME, BS(sprintf("%s holt sich hinter der Theke was "
        "zu trinken.", TP->Name(WER))), ({TP}));
    write("Du holst Dir hinter der Theke Dein Getraenk.\n");
    AddPropTP(P_DRINK, drink[nr[1]][5]);
    AddPropTP(P_ALCOHOL, drink[nr[1]][4]);
    TP->AddHp(drink[nr[1]][3][0]);
    TP->AddSp(drink[nr[1]][3][1]);
    lager--;
    return 1;
  }
  else {
    if(TP->QueryProp(P_MAX_FOOD)-TP->QueryProp(P_FOOD) < 
        food[nr[1]][4])
    {
      write("Soviel kannst Du momentan nicht essen!\n");
      return 1;
    }
    tell_room(ME, BS(sprintf("%s holt sich hinter der Theke was "
        "zu essen.", TP->Name(WER))), ({TP}));
    write("Du holst Dir hinter der Theke Dein Essen.\n");
    AddPropTP(P_FOOD, food[nr[1]][4]);
    TP->AddHp(food[nr[1]][3][0]);
    TP->AddSp(food[nr[1]][3][1]);
    lager--;
    return 1; 
  }
  return 1;
}
