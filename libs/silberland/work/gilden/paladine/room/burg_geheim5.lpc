
#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>


int dam_func;

create() {
  ::create();
  
  dam_func=0;
  
  SetProp(P_INT_SHORT, "Unter der Burg Sturmfels" );
  SetProp(P_INT_LONG,
      "Du bist hier in einem kleinen Gang unter der Paladinburg. "
      "Alles besteht hier aus grobem Fels. Der Gang wird nur spaerlich "
      "beleuchtet. Eine kleine Statue von Dusty befindet sich hier an der "
      "Wand. Der Gang fuehrt sowohl nach Westen wie auch nach Osten "
      "weiter.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang", "raum" }), 
      QueryProp(P_INT_LONG));
  AddDetail( ({"boden"}),
      "Der Boden besteht aus roh behauenem Fels.");
  AddDetail( ({"decke"}),
      "Die Decke ist ueber Dir. Sie besteht, wie der gesamte Gang, "
      "aus roh behauenem Fels.");
  AddDetail( ({"waende", "wand"}),
      "Die Waende bestehen, wie alles hier, aus roh behauenem Fels. "
      "An den Waenden stecken Fackeln in Fackelhaltern.");
  AddDetail( ({"fackeln"}),
      "Die Fackeln erhellen den Gang nur spaerlich.");
  AddDetail( ({"fackelhalter"}),
      "Die Fackelhalter sind sehr schlicht und zweckgemaess gehalten. "
      "Sie bestehen aus Eisen oder Stahl.");
  AddDetail( ({"eisen", "stahl"}),
      "Daraus bestehen die Fackelhalter");
  AddDetail( ({"fels"}),
      "Der Fels hier sieht sehr roh bearbeitet aus. Er ist kuehl.");
  AddDetail( ({"symbole"}),
      "Auf dem Mithriltor sind die heiligen Symbole der Dusty - "
      "Schwert und Rose - abgebildet.");
  AddDetail( ({"schwert", "rose"}),
      "Schwert und Rose sind die heiligen Symbole der Dusty!");
  AddDetail( ({"dusty", "goettin"}),
      "Dusty ist die Goettin der Paladine.");
  AddDetail( ({"burg", "paladinburg"}),
      "Du befindest Dich unter der Paladinburg.");
  AddDetail( ({"paladine", "verteidiger"}),
      "Die Paladine sind die Verteidiger des Guten. Pass bloss auf, "
      "dass sie Dich nicht hier unten erwischen.");
  AddDetail( ({"gute"}),
      "Das Gute ist hier immer und ueberall.");
  AddDetail( ({"nische"}),
      "Eine kleine Statue von Dusty befindet sich an der Wand.");
  AddDetail( ({"dusty", "statue"}),
      "Obwohl die Statue recht schmucklos ist, strahlt sie doch eine "
      "starke Heiligkeit aus.");
  AddDetail( ({"heiligkeit"}),
      "Du fuehlst die Heiligkeit dieses Ortes.");  
     
  AddExit("westen", ROOM("burg_geheim6"));  
  AddExit("osten", ROOM("burg_geheim4"));  
  if(find_call_out("do_damage")==-1 && !dam_func) {
    call_out("do_damage", 2);
  }

  
}

init() {
  ::init();
  if(find_call_out("do_damage")==-1 && !dam_func) {
    call_out("do_damage", 2);
  }
  return ;
}

void do_damage() {
  object *liv;
  int i;
  dam_func=1;
  liv=filter_array(all_inventory(ME), "filter_check");
  for(i=sizeof(liv)-1;i>=0;i--)  {
    liv[i]->do_damage(random(3)+1);
    if(!random(5))
      tell_object(liv[i], "Du fuehlst Dich ueberhaupt nicht wohl!\n");
  }
  dam_func=0;
  if(find_call_out("do_damage")==-1)
    call_out("do_damage", 2);
  return;
}


int filter_check(object ob) {
  if(!living(ob)) return 0;
  if(ob->QueryProp(P_ALIGN) >= 0) 
    return 0;
  return 1;
}
