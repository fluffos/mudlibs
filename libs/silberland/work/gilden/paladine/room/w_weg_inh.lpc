
/*
**
** Inherit fuer den Wachgang bei den Paladinen
** 03.05.98 Zordan@SL
**
*/

inherit "std/room";

#include "../paladin.h"
#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Wehrgang" );
  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 18+random(5), ENV_TERRAIN: TT_TOWN]) );

  SetProp(P_INT_LONG,
    "Du stehst auf dem Wehrgang der Burg Sturmfels. Dicke Planken sind "
    "fest in die Wand eingebracht worden und bilden den Boden. Ueber "
    "breite Schiessscharten hinweg hast Du einen wunderbaren Ausblick "
    "auf das weite Land. Ausserhalb wird die Burg von einem Graben "
    "umgeben, in dem Wasser fliesst.");

  AddDetail( ({ "himmel" }),
    "Die Sonne scheint doch noch recht warm vom Himmel herunter.");

  AddDetail( ({ "sonne" }),
    "Sie waermt Dich.");

  AddDetail( ({ "graben" }),
    "Der Graben umgibt die Burg komplett. Das Wasser in ihm bewegt sich "
    "allerdings kaum.");

  AddDetail( ({ "wasser" }),
    "Das Wasser sieht grauslich aus. Es steht wohl schon zu lange in dem "
    "Graben.");

  AddDetail( ({ "ausblick" }),
    "Der Ausblick ueber das Land und das Gebirge ist einfach himmlisch.");

  AddDetail( ({ "land" }),
    "Du kannst einen Teil des SilberLandes sehen. Es ist wunderschoen "
    "im Gebirge gelegen.");

  AddDetail( ({ "silberland" }),
    "Du bist daran, schon bemerkt?");

  AddDetail( ({ "gebirge" }),
    "Grosse und kleine Berge sind in alle Richtungen ausserhalb der Burg "
    "zu sehen. Einen hast Du auch erklommen, um hierher zu kommen. Die Burg "
    "selber liegt allerdings auf einem kleinen Berg.");

  AddDetail( ({ "berge" }),
    "Die Berge umgeben die Burg. Manche ihrer Spitzen sind sogar weiss.");

  AddDetail( ({ "spitzen","spitze" }),
    "Auf ihnen liegt sicher viel Schnee und es ist bitterkalt.");

  AddDetail( ({ "schnee" }),
    "Hier liegt allerdings kein Schnee.");

  AddDetail( ({ "berg" }),
    "Die Burg liegt auf einem kleinen Berg.");

  AddDetail( ({ "wand","waende","mauer" }),
    "Die Waende sind aus grossen Steinen gebaut worden. In ihnen sind "
    "oben in regelmaessigen Abstaenden Schiessscharten eingelassen worden. "
    "Weiter unten sind dicke Planken in die Wand eingebracht worden.");

  AddDetail( ({ "abstand","abstaende" }),
    "So alle zwei Meter gibt es eine Schiessscharte.");

  AddDetail( ({ "jahre","jahr","zeit" }),
    "Eine lange Zeit.");

  AddDetail( ({ "meter" }),
    "Was ein Meter ist weisst Du ja wohl.");

  AddDetail( ({ "schiessscharte","schiessscharten","einlaesse" }),
    "Die Schiessscharten sind einfache Einlaesse in der Mauer. Sie sind etwa "
    "einen halben Meter breit und bieten den Paladinen eine hervorragende "
    "Verteidigung.");

  AddDetail( ({ "verteidigung" }),
    "Diese Burg zu verteidigen gestaltet sich nicht sonderlich schwer.");

  AddDetail( ({ "paladin","paladine" }),
    "Derzeit ist wohl keiner da.");

  AddDetail( ({ "steine" }),
    "Die Steine sind breiter als Dein Koerper und aus weissem Gestein. "
    "Sie wurden wohl aus der nahen Umgebung hierher gebracht und fuer den "
    "Bau der Burg verwendet. Ist da nicht sogar ein Besonderer dazwischen?");

  AddDetail( ({ "stein" }),
    "Du dachtest erst der Stein waere was besonderes. Du hast Dich aber "
    "getaeuscht.");

  AddDetail( ({ "bau" }),
    "Das ist schon Jahre her. Die Burg wurde wohl nie ernsthaft bedroht, "
    "was man an dem perfektem Zustand erkennen kann.");

  AddDetail( ({ "zustand" }),
    "Die Burg ist in einem unglaublich perfektem Zustand.");

  AddDetail( ({ "umgebung","steinbruch" }),
    "Einen Steinbruch oder so kannst Du von hier aus nicht erkennen.");

  AddDetail( ({ "gestein" }),
    "Das Gestein ist hellweiss. Selten zu finden. Aber irgendwo hier "
    "in der Umgebung hat man es wohl abgebaut.");

  AddDetail( ({ "koerper" }),
    "Uff, bist Du breit, aber die Steine sind breiter.");

  AddDetail( ({ "wehrgang","wehr","gang" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "burg","sturmfels" }),
    "Du stehst hoch oben auf einem Wehrgang der Burg. Unter Dir kannst "
    "Du den Innenhof genau sehen.");

  AddDetail( ({ "planken","planke" }),
    "Die dicken Planken sind aus sehr hartem Holz gefertigt worden. Sie sind "
    "fest in die Waende eingebracht worden und beduerfen daher keinerlei "
    "Stuetze von unten.");

  AddDetail( ({ "stuetze","hirnstuetze" }),
    "Brauchst Du ne Hirnstuetze???");

  AddDetail( ({ "holz" }),
    "Das festeste Holz aus dem Dschungel.");

  AddDetail( ({ "dschungel" }),
    "Der ist meilenweit entfernt.");

  AddDetail( ({ "innenhof","hof" }),
    "Der komplette Hof wurde mit Stroh ausgelegt. Genau in dessen Mitte "
    "kannst Du einen Brunnen erkennen.");

  AddDetail( ({ "stroh" }),
    "Hier oben liegt kein Stroh, nur unten.");

  AddDetail( ({ "boden" }),
    "Einen richtigen Boden gibt es eigentlich gar nicht. Hunderte von dicken "
    "Planken bietet aber festen Halt.");

  AddDetail( ({ "halt" }),
    "Die Planken haben schon weitaus schwerere Lebewesen getragen.");

  AddDetail( ({ "lebewesen" }),
    "Du bist eines von ihnen :)");

  AddDetail( ({ "teil" }),
    "Das SilberLand ist schon groesser. Von hier hast Du nur einen Ausblick "
    "auf einen kleinen Teil davon.");

  AddDetail( ({ "mitte","mittelpunkt" }),
    "Genau dort findet sich ein Brunnen.");

  AddDetail( ({ "brunnen" }),
    "Der Brunnen bildet den Mittelpunkt der Burg. Von hier aus kannst Du "
    "aber nicht viel vom Brunnen erkennen.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht nach Stroh und der Wind traegt den Geruch von vielerlei "
    "Pflanzen heran." );

  AddSmell( ({ "stroh" }),
    "Das Stroh von unten kann man sogar bis hier oben riechen." );

  AddSmell( ({ "geruch","pflanzen","pflanze" }),
    "Die riechst viele Pflanzen durcheinander. Du kannst sie nicht "
    "unterscheiden. Aber es riecht dafuer trotzdem herrlich angenehm." );

  AddSound( ({ DEFAULT_SOUND }),
    "Du kannst nur den Wind ganz leise hoeren." );

  AddSound( ({ "wind" }),
    "Der Wind pfeift ganz leise." );
}
