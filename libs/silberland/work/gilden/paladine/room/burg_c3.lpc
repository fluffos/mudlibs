#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

nosave int CheckMythar();

create() {
  ::create();

  SetProp( P_INT_SHORT, "Haupthof in Burg Sturmfels" );
  SetProp( P_INT_LONG,
      "Du bist hier am suedlichen Teil des Burghofes der Burg Sturmfels. "
      "Links und rechts ragen die Befestigungen hoch hinauf. Links und rechts "
      "befindet sich je eine eisenverstaerkte Tuer, die Spalten daneben sind "
      "wohl Schiesscharten und sollen im Falle eines Eindringens von "
      "Feinden Unterstuetzung liefern. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"himmel"}), 
      "Der Himmel befindet sich ueber Dir. Er ist strahlend blau.");
  AddDetail( ({"boden"}),
      "Der Boden ist hart und besteht aus zusammengestampftem Lehm.");
  AddDetail( ({"lehm"}),
      "Der Lehm wurde so fest zusammengedrueckt, dass man keinen "
      "Millimeter weit einsinkt.");
  AddDetail( ({"millimeter"}),
      "Das ist halt so ein kleiner Abstand.");
  AddDetail( ({"abstand"}), 
      "Du errinnerst Dich an die Worte Deiner Mami: Hoer auf so neugierig "
      "zu sein.");
  AddDetail( ({"worte", "mami"}),
      "AUS! :)");
  AddDetail( ({"teil"}), 
      "Du befindest Dich hier am suedlichen Teil des Burghofes.");
  AddDetail( ({"burghof"}), 
      "Der Burghof ist sehr gross. Weiter im Norden weitet er sich sogar "
      "noch aus.");
  AddDetail( ({"norden"}), 
      "Im Norden weitet sich der Burghof aus. Schau doch einfach mal hin!");
  AddDetail( ({"burg"}),
      "Du bist hier in einer Burg, ja. Sie traegt den stolzen Namen "
      "Sturmfels.");
  AddDetail( ({"sturmfels"}),
      "So heisst diese stolze Burg.");
  AddDetail( ({"name", "namen"}),
      "Diese Burg heisst Sturmfels.");
  AddDetail( ({"befestigung", "befestigungen"}),
      "Die Befestigungen ragen hoch in den Himmel hinauf. An ihren Seiten "
      "befinden sich je eine Tuer und eine Schiesscharte.");
  AddDetail( ({"tuer"}),
      "Meinst du die Westtuer oder die Osttuer?");
  AddDetail( ({"schiesscharte", "schiesscharten"}), 
      "Die sehen gefaehrlich aus. Wenn sich dahinter wer verbirgt, kann er "
      "Dich leicht attackieren, und Du kannst nichts dagegen tun.");
  AddDetail( ({"spalten"}),
      "Das sind Schiesscharten!");
  AddDetail( ({"eindringens", "falle"}),
      "Was immer passiert, hier ist jeder geruestet!");
  AddDetail( ({"unterstuetzung"}), 
      "Die Schiesscharten bieten sicher eine enorme Unterstuetzung.");
  AddDetail( ({"feinde", "feinden"}),
      "Feinde sind ueberall. Vor allem das Geschmeiss der Unterwelt.");
  AddDetail(({"geschmeiss", "unterwelt"}),
      "Es wird der Tag kommen, an dem wir sie ausradieren!!!");

  AddDetail(({"eichenholz", "holz"}),
      "Das Holz der Tueren ist mit Eisenbaendern verstaerkt. Dadurch "
      "sind die Tueren aeusserst stabil.");
  AddDetail( ({"eisenbaender"}),
      "Die dienen als Verstaerkung der Tueren.");
  AddDetail("verstaerkung", 
      "Die Tueren tritt keiner ein. Zu stabil.");
  AddDetail("tag", 
      "Bald, sehr bald ...");
  AddItem(NPC("mythar"), REFRESH_DESTRUCT);
  AddItem(NPC("waechter"), REFRESH_DESTRUCT);
  AddItem(NPC("portalwaechter"), REFRESH_DESTRUCT);
  AddExit("norden", ([EX_DEST:"./burg_c2",
                      EX_TESTFUNC:#'CheckMythar]));
  AddExit("sueden", "./burg_c4");
  AddCmd("oeffne", "oeffne");
  NewDoor("osten", ROOM("burg_b3"), "osttuer", 
      ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY,
        D_LONG, BS("Die Tuer besteht aus mit Eisenbaendern verstaerkten "
                   "Eichenholz. Sie sieht sehr stabil aus."),
        D_SHORT,"Eine %se Tuer an der Ostwand.\n", 
        D_NAME,"Osttuer",
        D_FUNC2,"DelfTest",
        D_TESTFUNC,"EnterTestFunc",
        D_OPENTESTFUNC,"OpenTestFunc",
        D_KEYTESTFUNC,"KeyTestFunc",
        D_CLOSETESTFUNC, "CloseTestFunc"
        }));
  NewDoor("westen", ROOM("burg_d3"), "westtuer", 
      ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY,
        D_LONG, BS("Die Tuer besteht aus mit Eisenbaendern verstaerkten "
                   "Eichenholz. Sie sieht sehr stabil aus."),
        D_SHORT,"Eine %se Tuer an der Westwand.\n", 
        D_NAME,"Westtuer",
        D_FUNC2,"DelfTest2",
        D_TESTFUNC,"EnterTestFunc2",
        D_OPENTESTFUNC,"OpenTestFunc2",
        D_KEYTESTFUNC,"KeyTestFunc2",
        D_CLOSETESTFUNC, "CloseTestFunc2"
        }));
}

nosave int CheckMythar() {
  if(!present("hauptmann", ME)) return 1;
  if(call_other(NPCMASTER, "IsFeind", TP)) {
    write("Mythar laesst Dich nicht passieren, Frevler!\n");
    return 0;
  }
  return 1;
}

int oeffne(string str) {
  if(!str) return 0;
  if(str=="tuer") {
    write("Meinst Du die Ost- oder die Westtuer?\n");
    return 1;
  }
  return 0;
}
