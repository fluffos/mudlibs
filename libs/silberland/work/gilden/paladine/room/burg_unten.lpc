
#include "../paladin.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Unter Wasser" );
  SetProp( P_INT_LONG,
    "Du tauchst tief unten in dem Burggraben. Rings um Dich herum ist "
    "fauliges Wasser. Riechen kannst Du natuerlich nichts, aber Du spuerst "
    "wie das Wasser auf deiner Haut prickelt. Fast eisig kalt ist es hier." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 2, ENV_TERRAIN: TT_UNDERWATER]) );
  SetProp(P_NO_TPORT, NO_TPORT);
  
  AddDetail( ({"waende"}), 
      "Du siehst Dich nach den Waenden um, kannst aber nur die Wand zur "
      "Burg hin entdecken.");

  AddDetail( ({"wand"}), 
      "Du schwimmst etwas zu dieser Wand und siehe da: Da ist ein kleiner "
      "Spalt. Du koenntest probieren durchzutauchen.");

  AddDetail( ({"spalt"}),
      "Der Spalt ist gerade gross genug fuer einen Menschen oder Elfen.");

  AddDetail( ({"mensch", "elfen"}),
      "Alles, was groesser ist, passt da wohl nicht durch.");
  
  AddDetail( ({ "rohr" }),
    "Das Rohr kommt aus der Burg. Derzeit ist eine Klappe davor geschlossen. "
    "Unter der Klappe ist eine kleine Tafel.");

  AddDetail("tafel", 
    "Auf ihr steht etwas geschrieben, allerdings kannst Du es durch den "
    "vielen Rost nicht erkennen.");
 
  AddDetail("rost", 
    "Der Rost bedeckt die komplette Tafel. Wenn man den nur runterbekommen "
    "koennte.");

  AddDetail( ({ "klappe" }),
    "Die Klappe ist geschlossen. Dir faellt ein kleines Handrad daran auf.");

  AddDetail( ({ "handrad" }),
    "Ein winziges Handrad. Was man damit wohl anstellen koennte?");

  AddDetail( ({ "eis" }),
    "Fast unglaublich. Aber eine kleine Eisscholle treibt hier im Wasser "
    "herum.");

  AddDetail( ({ "rand" }),
    "Im Norden kannst Du den Rand des Grabens genau sehen. In dem ganzen "
    "Dreck faellt Dir zuerst gar nichts auf.");

  AddDetail( ({ "dreck","haufen" }),
    "Ein Haufen Dreck liegt hier rum. Vielleicht sollte man es mal genauer "
    "untersuchen?");

  AddDetail( ({ "himmel" }),
    "Du kannst den Himmel leider nicht mehr sehen.");

  AddDetail( ({ "boden" }),
    "Das Wasser ist so dermassen trueb, dass Du den Boden nicht sehen kannst.");

  AddDetail( ({ "haut" }),
    "Dieses Wasser kann nicht gesund sein. Komm bloss nicht auf die Idee "
    "daovn zu trinken. Es koennte Dein Ende sein.");

  AddDetail( ({ "idee" }),
    "Verwerf diesen Gedanken lieber wieder ganz schnell!");

  AddDetail( ({ "gedanken","gedanke" }),
    "Lass ihn endlich sein!");

  AddDetail( ({ "ende" }),
    "Du koenntest eventuell daran sterben. Wer weiss.");

  AddDetail( ({ "wasser" }),
    "Das Wasser ist sehr kalt. Nur wenige Fische schwimmen hier unten herum. "
    "Das Wasser ist ausserdem ziemlich truebe und riecht sehr abgestanden.");

  AddDetail( ({ "fische" }),
    "Nur sehr wenige Fische schwimmen hier herum. Du hast oft Probleme sie "
    "in dem dreckigen Wasser genau zu erkennen. Ein kleiner Fisch bleibt "
    "aber immer in Deiner Naehe irgendwie.");

  AddDetail( ({ "naehe" }),
    "Mal ist er hinter Dir, mal vor Dir. Aber immer bei Dir.");

  AddDetail( ({ "problem","probleme" }),
    "Hast Du welche? JA!");

  AddDetail( ({ "fisch" }),
    "Ein kleiner Fisch schwimmt immer um Dich herum. Er scheint Deine "
    "Wunden gerochen zu haben und laechzt nach Deinem Blut.");

  AddDetail( ({ "wunden","wunde" }),
    "Aus Deinen Wunden stroemt Blut heraus.");

  AddDetail( ({ "blut" }),
    "Dein Blut faerbt das Wasser dunkelrot. Aber nicht einmal sehr, weil "
    "das Wasser eh schon sehr sehr trueb ist.");

  AddDetail( ({ "burg" }),
    "Du kannst Du Burg von hier aus nicht mehr sehen.");

  AddDetail( ({ "burggraben","graben" }),
    "Du tauchst tief unten in dem Graben. Hier ist es schon sehr dunkel. Aber "
    "es scheint zum Glueck noch ein wenig Licht herein.");

  AddDetail( ({ "glueck" }),
    "Du wirst hier mehr Glueck als Verstand brauchen.");

  AddDetail( ({ "verstand" }),
    "Hoffentlich hast Du genug davon. *grins*");

  AddDetail( ({ "licht","sonne" }),
    "Das Licht der Sonne scheint von oben herein. Das aendert aber nichts "
    "an der Tatsache, dass es hier wirklich sehr sehr kalt ist.");

  AddDetail( ({ "tatsache" }),
    "Du schlotterst am ganzen Koerper.");

  AddDetail( ({ "koerper" }),
    "Dein Koerper zitter wirklich sehr stark. Die Feuchtigkeit und die Kaelte "
    "setzen Dir wirklich sehr zu.");

  AddDetail( ({ "feuchtigkeit" }),
    "Wasser ist feucht. Tolle Erkenntnis, oder?");

  AddDetail( ({ "erkenntnis" }),
    "Na wenn es weiter nichts ist.");

  AddDetail( ({ "kaelte" }),
    "Es ist grauslich kalt hier unten.");

  AddSound( DEFAULT_SOUND,
    "Du kannst nichts hoeren unter Wasser.");
    
  AddSmell( DEFAULT_SMELL,
    "Du kannst nicht riechen unter Wasser.");

  AddSpecialDetail( ({ "eisscholle","scholle" }), "eisscholle" );

  AddCmd( "","allesfkt",1);
  AddCmd( ({ "dreh","drehe" }),   "drehfkt" );
  AddCmd( ({ "trink","trinke" }), "trinkfkt" );
  AddCmd( ({ "kratze", "kratz" }), "kratzfkt" );
  AddCmd( ({ "durchsuche","durchsuch","durchwuehl","durchwuehle" }), "wuehlfkt" );
  AddCmd( ({ "tauch", "tauche"}), "tauchen"); 
   
  AddExit( "rauf" , "./burg_graben" );
}

int tauchen(string str) {
  notify_fail("Wo moechtest du hindurch tauchen?\n");
  if(str!="durch spalt" && str!="spalt") return 0;
 // if(TP->QueryProp(P_SIZE)>210) {
    write("Du bist zu gross. Du wuerdest da nie durchpassen.\n");
    return 1;
//  }
  write("Du tauchst durch den Spalt!\n\n");
  TP->move(ROOM("burg_graben1"),M_GO, "durch den Spalt hindurch", "taucht", 
      "taucht aus dem ueberfluteten Gang auf");
  return 1;
}

int drehfkt(string str) {
//  notify_fail("WAS willst Du denn drehen?\n"); kein bock mehr auf notify_fail
  if (!str) return 0;
  if (str == "rad" || str == "an rad" || str == "am rad") {
    write(BS(
      "Komisch, wie kommst Du nur auf 'Rad' ? Gefunden hast Du jedenfalls "
      "keines."));
    write_paladin_log("burggraben", sprintf("%s von %s dreht am Rad.\n",
      getuid(TP),TP->QueryProp(P_CALLED_FROM_IP)));
    return 1;
  }
  if (str != "handrad" && str != "an handrad" && str != "am handrad") return 0;
  write(BS(
    "Du drehst vorsichtig an dem Handrad. Auf einmal oeffnet sich die Klappe "
    "und ein maechtiger Wasserstrahl schiesst auf Dich zu. Er erwischt Dich "
    "hart und schleudert Dich gewaltig nach oben."));
  write(BS(
    "In einem hohen Bogen fliegst Du aus dem Burggraben raus und schwebst "
    "sogar fuer eine gewisse Zeit in der Luft."));
  write(BS(
    "Dann schlaegt Du hart auf der Haengebruecke auf."));
  TP->move( ROOM("burg_c3") , M_GO, 0,
    "wird hinfortgespuelt",
    "fliegt in einem hohen Bogen herein");
  TP->reduce_hit_point(20+random(20));
  return 1;
}

int allesfkt(string str) {
  if(random(100) < 15 && !IS_WIZARD(TP) && !TP->QueryProp(P_GHOST)) {
    write(BS(
      "Ein Blutegel beisst sich auf einmal an Dir fest und faengt an "
      "Dich auszusaugen. Du solltest diesen Egel so schnell wie moeglich "
      "wieder loswerden, sonst hast Du nachher gar kein Blut mehr."));
    CLONE ( OBJ("blutegel"),TP);
  }
}

int wuehlfkt(string str) {
  notify_fail("WAS willst Du denn genau machen?\n");
  if (!str) return 0;
  if (str != "dreck" && str != "haufen") return 0;
  write(BS(
    "Du untersuchst den Dreck genauer und findest ein verrostetes Rohr."));
  return 1;
}

int trinkfkt(string str) {
  notify_fail("WAS willst Du trinken?\n");
  if (!str) return 0;
  if (str != "wasser") return 0;
  write(BS(
    "Du nimmst einen grossen Schluck Wasser zu Dir. Das war sicher keine "
    "gute Idee. Du fuehlst Dich irgendwie so komisch auf einmal."));
  TP->AddHp(-random(40));
  return 1;
}

int kratzfkt(string str) {
  notify_fail("WO willst Du kratzen?\n");
  if(!str) return 0;
  if(str!="tafel" && str!="rost" && str!="rost von tafel") return 0;
  if(!TP->FindPotion(
      "Du kratzt den Rost von der Tafel, und tatsaechlich, Du kannst "
      +"die Schrift lesen. Da steht in grossen Buchstaben: ZAUBERTRANK!"))
    write(BS("Du kratzt den Rost von der Tafel, kannst aber leider immer "
        +"noch nichts lesen."));
  say(TPN+" kratzt an einem Rohr herum.\n");
  return 1;
}

string eisscholle() {
  write_paladin_log("burggraben", sprintf("%s von %s untersucht die Eisscholle.\n",
    getuid(TP),TP->QueryProp(P_CALLED_FROM_IP)));
  return BS(
    "Die Eisscholle treibt am Rand des Grabens. Komisch, sie scheint sich "
    "in Richtung Burg zu bewegen.");
}
