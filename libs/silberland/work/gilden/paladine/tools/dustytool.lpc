#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <new_skills.h>
#include <ansi.h>
#include <wizlevels.h>
#include "../paladin.h"
inherit "std/thing";

// DEFINES
#define VERSION "0.01"
#define LAST_CHANGE "15.08.2002"
#define TD(x) if(find_player("dusty")) tell_object(find_player("dusty"),x)
#define LINE1 "=============================================================================="
#define LINE2 "+============================================================================+"

// VARIABLEN
private nosave string *color;
private nosave int segenstaerke=1;
// PROTOTYPES
nosave int SetColors(string terminal);
void create() {
  
  if( !is_clone(TO) ) return;
  ::create();
  SetColors(TP->QueryProp(P_TTY));
  TD(sprintf("%s***%s Dusty-Tool geclont!\n", ANSI_RED, 
      ANSI_NORMAL, CAP(getuid(TP))));
  //if(getuid(TP)!="dusty") { call_out("remove", 0); return;}
  SetProp(P_LONG, sprintf(
    "%s\nDas Dusty-Tool v%s (%s)\nGoettin! Dieses Tool ermoeglicht "
    "Euch mit Euren Dienern, den Paladinen, in Kontakt zu treten! "
    "Sie werden unter Eurer Stimme erzittern und Euch jeden Wunsch "
    "von den Lippen ablesen!\n"
    "Hilfe mit <dustyhilfe>.\n%s%s\n%s", LINE1, VERSION, LAST_CHANGE, color[4],
    color[0],LINE1));
  SetProp(P_NAME, "Dustys Goettinnen Tool v"+VERSION);
  SetProp(P_SHORT, "Dusty Goettinnen Tool v"+VERSION);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"dt", "dtool", "dustytool", "tool", "goettinnentool"}) );
  SetProp(P_MATERIAL, ([MAT_MISC:100]));
  SetProp(P_WEIGHT, 1); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, "Goettin! Ihr wuerdet dieses Tool niemals dem Poebel "
      "geben!\n");
  SetProp(P_NEVERDROP, "Goettin! Ihr wuerdet dieses Tool niemals dem "
      "Poebel geben!\n");
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_KILL_NAME, "Dusty persoenlich");
  seteuid(getuid(this_object()));
}

void init() {
  ::init();
  add_action("DHelp", "dustyhilfe");
  add_action("opferreport", "opferreport");
  add_action("ftoete", "ftoete");
  add_action("segne", "segne");
  add_action("segenstaerke", "segenstaerke");
  
  SetColors(TP->QueryProp(P_TTY));  
}

nosave int SetColors(string terminal) {
  // Farbgebung von Zordan@SL
  color = ({ 0,0,0,0,0 });
  if(terminal=="ansi") {
    color[0] = ANSI_NORMAL;
    color[1] = ANSI_BOLD;
    color[2] = ANSI_UNDERL;
    color[3] = ANSI_BLUE;
    color[4] = ANSI_RED;
  } else if (terminal=="vt100") {
    color[0]=ANSI_NORMAL;
    color[1]=ANSI_BOLD;
    color[2]=ANSI_BOLD;
    color[3]=ANSI_NORMAL;
    color[4]=ANSI_NORMAL;
  } else {
    color[0]=color[1]=color[2]=color[3]=color[4]=ANSI_NORMAL;
  }

}


int opferreport(string str) {
  if(str=="ein") {
    call_other("/gilden/paladine", "set_opferreport", 1);
    write(BS("Goettin, Ihr seht nun was euch die Paladine opfern!"));
    return 1;
  }
  if(str=="aus") {
    call_other("/gilden/paladine", "set_opferreport", 0);
    write(BS("Goettin, Ihr seht nun nicht mehr was euch die Paladine "
          "opfern!"));
    return 1;
  }
  write(BS("Goettin, verzeiht unsere Ungeschicktheit! Wir werden das Tool "
        "verbessern so das Ihr nicht staendig mit unserer Dummheit "
        "zu kaempfen habt! (opferreport ein|aus)"));
  return 1;
}

int ftoete(string wer) {
  object pl;
  notify_fail("Goettin! Wen wollt Ihr Eurer Herrlichkeit zu Ehren opfern?\n");
  if(!wer) return 0;
  wer=lower_case(wer);
  if(!pl=find_player(wer))
    return 0;
  if(pl->QueryProp(P_GUILD) != "paladine") {
    write("Goettin! Ihr koennt nur Paladine opfern!\n");
    return 1;
  }
  tell_object(pl, "\n\nDIE GOETTIN IST ERZUERNT UEBER DICH, PALADIN!\n"
      "SEI DIR DEINER SCHULD BEWUSST, TUE BUSSE UND AKZEPTIERE IHRE MACHT!\n\n");
  tell_room(ENV(pl), "Dusty persoenlich streckt "+pl->Name()+" nieder!\n", ({pl, TP}));
  call_other("/spellbooks/pal_spells", "DustyKillsPaladins", pl);
  return 1;
}

//
// Hilfeseite
//
nosave int DHelp() {
  string txt, hlpline;
  txt="| %-30s | %-41s |\n";
  hlpline=sprintf("+%*'='s+%*'='s+\n",32,"",43,"");
  write(sprintf("\n%s\n| %s%|74s%s |\n%s\n",LINE2,color[1],
      "-=- Funktionen des Dusty-Tools -=-",color[0],LINE2));
  write(sprintf(txt, "Name", "Funktion"));
  write(hlpline);
  write(sprintf(txt, "dustyhilfe", "Hilfeseite aufrufen"));
  write(sprintf(txt, "opferreport", "Ihr seht was Euch die Paladine opfern"));
  write(sprintf(txt, "segne <paladin>", "Ihr segnet einen Eurer Paladine"));
  write(sprintf(txt, "segenstaerke", "Wie stark Ihr segnen wollt"));
  write(sprintf(txt, "bestrafe <paladin>", "Ihr bestraft einen Eurer Paladine"));
  write(sprintf(txt, "ftoete <paladin>", "Faketod fuer einen Eurer Paladine"));
  write(hlpline+"\n");
      
  return 1;
}

int segne(string wer) {
  object pl;
  object ob;
  notify_fail("Goettin! Wen wollt Ihr segnen?\n");
  if(!wer) return 0;
  wer=lower_case(wer);
  if(!pl=find_player(wer))
    return 0;
  if(pl->QueryProp(P_GUILD) != "paladine") {
    write("Goettin! Ihr koennt nur Paladine segnen!\n");
    return 1;
  }
  write(BS(sprintf("Eure Herrlichkeit und Gnade wird %s zuteil!\n", 
          pl->name(WER))));
  tell_object(pl, "\n\n"+BS("Gleissendes Licht ergiesst sich ueber Dich als "
      "die Goettin persoenlich Dich segnet, Paladin! Du spuerst "
      "ihre Macht und Deine Gewissheit steigt, dass Du hoch in Ihrer "
      "Gunst stehst!")+"\n\n");
  tell_room(ENV(pl), "\n\n"+BS(sprintf("Gleissendes Licht ergiesst "
          "sich ueber %s, "
        "als %s eine goettliche Macht segnet! %s sieht gestaerkt aus und "
        "steht eindeutig unter dem Schutz Dustys!", pl->name(WER),
        pl->QueryPronoun(WESSEN),
        CAP(pl->QueryPronoun(WER))))+"\n\n", ({pl}));
  pl->AddHp(random(20));
  pl->AddSp(random(20));

  if(!present("\nsegen",pl) && segenstaerke > 1) {
    ob=clone_object(OBJ("segen"));
    ob->move(pl,M_NOCHECK);
    ob->SetVariables(TP,pl,600,(segenstaerke-1)*3000);
  }
  if(ob=present("\nheiligenschein",pl)) {
    ob->remove();
  }
  ob=clone_object(OBJ("heiligenschein"));
  ob->move(pl,M_NOCHECK);
  ob->start_remove(1000);
  ob->AddId(PALA_NOFAILURE);
  return 1;

}

int segenstaerke(string y) {
  int x;
  notify_fail(sprintf("Die aktuelle Segensstaerke betraegt %d aus 5!\n",
        segenstaerke));
  if(!y) return 0;
  x=to_int(y);
  if(!x || x==0) return 0;
  if(x<1 || x > 5) {
    write("Die Segensstaerke kann zwischen 1 und 5 liegen, Goettin\n");
    return 1;
  }
  segenstaerke=x;
  write("Goettin, die Segensstaerke wuerde auf "+x+" geaendert!\n");
  return 1;
}
