reset() {
  object pl;
  ::reset(); 
  if( !is_clone(TO) ) return;
//  update_check_evil();
  if(objectp(pl=QueryProp(P_WORN)))
  {
    amaryllion=1+random(pl->QueryProp(P_GUILD_LEVEL)-10);
    if(call_other(PALADINMASTER, "QueryNumberOne") &&
        member(call_other(PALADINMASTER, "QueryNumberOne"), getuid(pl))!=-1)
      pl->SetProp(P_GUILD_TITLE, 
          ({"das Streiter des Lichts", "der Streiter des Lichts", 
           "die Streiterin des Lichts"})[pl->QueryProp(P_GENDER)] );
    else if ( member( ({"das Streiter des Lichts", "der Streiter des Lichts", 
           "die Streiterin des Lichts"}),pl->QueryProp(P_GUILD_TITLE))!=-1 )
      call_other("/gilden/paladine", "adjust_title", pl);
  }
  if(necromancer_hploss<=0) 
    necromancer_hploss=1; // Damit die Nekros LPs stehlen koennen.
  else if(!random(100))
    necromancer_hploss++;
}

int update_glvl() {
  my_glvl=ENV(ME)->QueryProp(P_GUILD_LEVEL);
  return 1;
}

int query_glvl() {
  return my_glvl;
}

int WearFunc(object ob) {
  if (TP->QueryProp(P_GUILD) != "paladine" && !IS_WIZARD(TP)) {
    write("Der Wappenrock zerfaellt zu Staub.\n");
    call_out("remove",0);
  }
  if(ob == TO)
  {
    if (MENV->QueryProp(P_GUILD) == "paladine")
      call_out("activate", 0, MENV);
    SetListener(1);
    my_glvl=TP->QueryProp(P_GUILD_LEVEL);
    if(my_glvl > 14 || IS_ARCH(TP))
      TP->AddPursuer(ME);
  }
  return 1;
}

int RemoveFunc(object ob, int silent) {
  SetListener(0);
  my_glvl=0;
  if(QueryProp(P_WORN))
    QueryProp(P_WORN)->RemovePursuer(ME);
  return 1;
}

int WieldFunc(object ob) {
  return 1; 
}

int IsListener(object wer) {
  return (!is_clone(wer) && wer->QueryProp(P_TMP_PALADIN_LISTENER));
}

mixed QueryVersion() {
  return LAST_GUILDITEM_UPDATE; 
}

nosave object CheckGuildItem(object wer) {
  int i;
  object *inv;
  inv=all_inventory(wer);
  for(i=sizeof(inv)-1;i>=0;i--) {
    if(inv[i]->id(WAPPENROCK))
      return inv[i];
  }
  return 0;
}

nosave int pgebet(string str) {
  call_other("/spellbooks/pal_spells", "ShoutPrayer", TP);
  return 1;
}

nosave int guild_shout(string str)
{
  int i, invis, no_colors;
  object *members, paladin;
  string *presay, *ignores, pre, std_pre;
  mapping extra_title;

  extra_title=PALADIN_EXTRA_TITLE;

  // NPCs duerfen nur von Erzmagiern zu pruf gezwungen werden
  if(ENV(ME) && living(ENV(ME)) && !query_once_interactive(ENV(ME)) && TI)
    if(!IS_ARCH(TI))
      return 0;

  //if(previous_object(2) && previous_object(2)!=ENV(ME)) {
  //  TELL("angrox", sprintf("WAPPENROCK, PO: %O\n, PO(2): %O", PO, 
  //        previous_object(2)));
  //  if(member(({"zordan", "angrox"}), getuid(previous_object(2)))==-1) {
  //    return 0;
  //  }
 // }

  // Nix zum prufen angegeben?
  if (!stringp(str)) 
    return notify_fail("Was moechtest Du den Paladinen mitteilen?\n"), 0;

  // Rausfinden, wer aller da ist.
  members = filter_array(users(), "IsListener");

  // Presay ermitteln (Array: NEUTER, MALE, FEMALE)
  if(getuid(TP)=="angrox" || getuid(TP)=="zordan" || TP->id("ayla"))
    presay = ({"Paladinmeisteretwas ", "Paladinmeister ", "Paladinmeisterin "});
  else if( IS_GOD(TP) )
    presay = ({"Gott ","Gott ","Goettin "});
  else if( IS_WIZARD(TP) )
    presay = ({"Paladinmagier ","Paladinmagier " ,"Paladinmagierin "});
  else if(call_other(PALADINMASTER, "QueryNumberOne") &&
          member(call_other(PALADINMASTER, "QueryNumberOne"), getuid(TP))!=-1)
    presay = ({"Das Streiter des Lichts ", "Der Streiter des Lichts ",
               "Die Streiterin des Lichts "});
  else if(member(extra_title, getuid(TP)))
    presay=extra_title[getuid(TP)];
  else if( TP->QueryProp(P_GUILD_LEVEL)>=16)
    presay= ({"Das heilige ", "Der heilige ", "Die heilige "});
  else if(!is_clone(TP) && !TP->QueryProp(P_FROG))
    presay = ({"Paladinetwas ", "Paladin ", "Paladin "});
  else
    presay = ({"","",""});

  // Standard-Presay (fuer die History):
  if(TP->QueryProp(P_INVIS)) {
    invis = 1;
    std_pre = "("+CAP(getuid(TP))+") teilt Euch mit: ";
  }
  else {
    invis = -1;
    std_pre = capitalize(presay[TP->QueryProp(P_GENDER)] +
              TP->name(WER)) + " teilt Euch mit: ";
  }

  // So und jetzt verteilen:
  for(i = sizeof(members); i-->0; )
  {
    if(members[i] == TP) {
      write(expand_color_strings(TP->_unparsed_args(), 
           "Du teilst den Paladinen mit: ", TP));
    }
    else
    {
      if (pointerp(ignores=members[i]->QueryProp(P_IGNORE)) && sizeof(ignores))
        no_colors = (member(ignores, "prufe_farben") != -1);

      // Prefix:
      if (TP->QueryProp(P_INVIS))
        if (IS_LEARNING(members[i]))
          pre = "(" + CAP(getuid(TP)) + ") teilt Euch mit: ";  
        else
          pre = "Jemand teilt Euch mit: ";
      else     
        pre = presay[TP->QueryProp(P_GENDER)] + TP->Name(WER) +
              " teilt Euch mit: ";

      members[i]->Message(
          expand_color_strings( interactive(TP) ? TP->_unparsed_args() : str,
          pre, members[i], no_colors ), MSGFLAG_CHANNEL | MSGFLAG_SILENT );
    }
  }

  // Messages von Spielern in die History aufnehmen:
  if(interactive(TP))
    call_other(GUILD_MASTER, "AddHistory", std_pre,
        expand_color_strings(TP->_unparsed_args(), "", ""), invis);
  else
    call_other(GUILD_MASTER, "AddHistory", std_pre,
        expand_color_strings(str, "", ""));

  return 1;
}


nosave int ShowHistory(string str)
{
  int i,first;
  string *msgs, txt;
  mixed *history;
  mixed *hist_time;

  history=call_other(GUILD_MASTER, "QueryHistory");
  hist_time=history[0];
  history=history[1];
  if (sizeof(history)==0)
  {
    write("Die anderen Paladine haben Dir noch nichts mitgeteilt.\n");
    return 1;
  }

  if (to_int(str) > 0) {
    first = sizeof(history) - to_int(str);
    if (first < 0) first = 0;
  }
  else
    first = 0;

  txt="Das haben Dir die anderen Paladine mitgeteilt:\n";
  txt+="-----------------------------------------------"
       +"-------------------------------\n";
  for(i=first;i<=sizeof(history)-1;i++) {
    msgs=explode(history[i],"&&*%%");

    if (((time()+7200)/86400)>((hist_time[i]+7200)/86400)) {
      txt+=BS(dtime(hist_time[i]));
    }
    else {
      txt+=BS(dtime(hist_time[i])[19..26]);
    }
    if(msgs[2]=="1" && !IS_WIZARD(TP)) {
      txt+=BSA(msgs[1], "Jemand (Dusty?) teilt Euch mit: ");
    }
    else {
    txt+=BSA(msgs[1], CAP(msgs[0]));
    }
  }
  txt+="-----------------------------------------------"
       +"-------------------------------\n";
  TP->More(txt);
  return 1;  
}


nosave int pknuddeln(string str) {
  int i;
  object *spieler;
  spieler=users();
  for(i=sizeof(spieler)-1;i>=0; i--) {  
    if(IsListener(spieler[i])) {
      if(spieler[i]==TP) {
        write(BS("Du knuddelst alle anwesenden Paladine aus "
                +"der Ferne."));
      } else { 
        if(TP->QueryProp(P_GENDER)==FEMALE)
          tell_object(spieler[i], sprintf("Lady %s "
            +"knuddelt Euch aus der Ferne.\n", TP->name()));
        else 
          tell_object(spieler[i], sprintf("Lord %s "
            +"knuddelt Euch aus der Ferne.\n", TP->name()));
      }
    }      
  }
  return 1;
}

nosave int pwinken(string str) {
  int i;
  object *spieler;
  spieler=users();
  for(i=sizeof(spieler)-1;i>=0; i--) {    
    if(IsListener(spieler[i])) {
      if(spieler[i]==TP)
        write(BS("Du winkst alle anwesenden Paladinen aus der Ferne zu."));
      else {
        if(TP->QueryProp(P_GENDER)==FEMALE)
          tell_object(spieler[i], sprintf("Lady %s "
            +"winkt Euch aus der Ferne zu.\n", TP->name()));
        else 
          tell_object(spieler[i], sprintf("Lord %s "
            +"winkt Euch aus der Ferne zu.\n", TP->name()));
      }
    }
  }
  
  return 1;
}


nosave int MySort(object a, object b) {
  if(a->Name(WER) > b->Name(WER)) return 0;
  return 1;
}

nosave int pwer(string str) {
  int i;
  object *spieler,ayla;
  string level;
  string paladine, align, sh;

  paladine="";
  write("Folgende Paladine sind anwesend:\n");
  spieler=sort_array((users()-filter_array(users(), #'is_clone)),"MySort",ME);
  for(i=sizeof(spieler)-1;i>=0; i--) {    
    if((IsListener(spieler[i]) ||
        member(({"zordan", "angrox"}), getuid(spieler[i]))!=-1)
        && !spieler[i]->QueryProp(P_INVIS)) {
      level=sprintf("%d", spieler[i]->QueryProp(P_GUILD_LEVEL));
      if( IS_GOD(spieler[i]) ) level ="G";
      else if( IS_LEARNER(spieler[i]) ) level = "M";
      align=spieler[i]->al_to_title(spieler[i]->QueryProp(P_ALIGN));
      if( IS_GOD(spieler[i]) ) align ="goettlich";
      if (str == "ort") {
        paladine+=sprintf("%13s(%2s) - ",CAP(getuid(spieler[i])),level);
        if (ENV(spieler[i]) && (sh=ENV(spieler[i])->QueryProp(P_INT_SHORT)) 
            && (!IS_LEARNER(spieler[i]) || IS_LEARNER(TP) ) )
          paladine+=sh+".\n";
        else
          paladine+="Im Nirgendwo.\n";
      } else {
        paladine+=CAP(getuid(spieler[i]))+"("+level+"/"+align+"), ";
      }
    }
  }
  if (str == "ort") {
    if(ayla=find_living("ayla")) 
      paladine="         Ayla(16) - "+ENV(ayla)->QueryProp(P_INT_SHORT)+".\n"
               +paladine;
    write(paladine);
  } else {
    if(find_living("ayla")) 
      paladine="Ayla(16/heilig), "+paladine;
    write(BS(paladine+"\b\b.\n"));
  }
  return 1;
}

void init() {
  object ob;
  ::init();
  if(!living(MENV))
    call_out("remove",0);
  if( MENV->QueryProp(P_GUILD)!= "paladine" && !IS_WIZARD(MENV)) {
    write("Der Wappenrock loest sich auf!\n");
    call_out("remove",0);
    return 0;
  }
  if(TP!=MENV) return 0;
  DoWear();
  tell_object(MENV, "Du spuerst die goettliche Kraft durch Dich fliessen.\n");
  owner=MENV;
  align=owner->al_to_title(owner->QueryProp(P_ALIGN));
  MENV->SetProp(P_WEAR_FUNC, TO);
  MENV->SetProp(P_WIELD_FUNC, TO); 
}

void SetListener(int flag) {
  if(MENV && interactive(MENV)) {
    if(flag)
      MENV->SetProp(P_TMP_PALADIN_LISTENER, 1);
    else 
      MENV->SetProp(P_TMP_PALADIN_LISTENER, 0);
  } 
  return ;
}

void punishEvilPaladin()
{
    if(!objectp(owner))
        return;

    tell_object(owner, "FREVLER! DAFUER WIRD DUSTY DICH STRAFEN!\n");
    tell_object(owner, "Da Du nicht mehr wuerdig bist, loest sich "
          "der Wappenrock auf!\n");
    owner->RemoveHpHook(ME);
    owner->SetProp(P_SP, 0);
    call_other(NPCMASTER, "AddFeind", owner);
    DoUnwear(); // Unwear vor remove, sonst buggt das (Feyaria)
    remove();
}

int isSchildparadeActive() {
    mixed h;

    if(h=owner->QueryProp(P_TMP_DEFEND_HOOK)) {
      if(h[1] && getuid(h[1])=="GUILD.pal_spells" && h[2]=="schildparade_func")
      {
      if(h[0]>=time()) {
        return 1;
      }
      else return 0;
    }
    else return 0;
  }

}

string GetBlindStatusLine() {
    string *s, zst;
    s = ({ });

    if(isSchildparadeActive()) {
        s += ({ "schildparade" });
    }

    if(present("\nruestungssegen", owner)) {
        s += ({ "ruestungssegen" });
    }

    if(present("\nwaffensegen", owner)) {
        s += ({ "waffensegen" });
    }

    if(present("\nsegen", owner)) {
        s += ({ "segen" });
    }

    if(present("\neifer", owner)) {
        s += ({ "eifer" });
    }

    if(owner->QueryProp(P_FROG)) {
        zst  = "frosch";
    } else if(owner->QueryProp(P_POISON)) {
        zst = "vergiftet";
    } else if(owner->QueryProp(P_DEAF)) {
        zst = "taub";
    } else if(owner->QueryProp(P_BLIND)) {
        zst = "blind";
    } else if(owner->QueryProp(P_PARALYZED)) {
        zst = "paralysiert";
    } else {
        zst = "normal";
    }

    return sprintf("Zauber: %s Zustand: %s", (sizeof(s) > 0 ? implode(s, " "):"keine"), zst);
}

/*
   PALADIN-REPORT!
*/

varargs void NotifyHpChange(int force) {
  int hp, mhp, sp, msp, HPdif, length, stat, changedHP, changedSP;
  string color, msg, flags;
  color="";
  flags="";
  stat=0;
  
  // Sicherheits-Check
  if (!previous_object() || !owner) return;
  if (owner != previous_object()) {
    if (TO != previous_object()) return;
    stat=1;
  }
  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv && !stat) {
    if (owner!=find_netdead(getuid(owner)))
      owner->RemoveHpHook(ME);   // geht nur bei nicht-netztoten Spielern
    return;
  }
  
  if(!query_once_interactive(owner)) {
    activate(0);
    return;
  }

  if(owner->QueryProp(P_ALIGN) < -500) {
      call_out("punishEvilPaladin", 1);
      return ;
  }

  // aktuelle Werte ermitteln
  hp = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);
  if (noscroll &&
      hp - scrollHP >= 0 && hp - scrollHP < 5 &&
      sp - scrollSP >= 0 && sp - scrollSP < 5)
  {
    scroll += hp - scrollHP + sp - scrollSP;
    scrollHP = hp;
    scrollSP = sp;
    if (!force && scroll < noscroll && 
        !(hp == mhp && hp != lastHP) &&
        !(sp == msp && sp != lastSP))
      return;
  }
  scroll = 0;
  scrollHP = hp;
  scrollSP = sp;
  if(test_bit(akt_lvl, 1)) {
    switch(hp*100/mhp) {
      case 0..20: color=report_colors[4];
                  break;
      case 21..40: color=report_colors[3];
                  break;
      case 41..60: color=report_colors[2];
                  break;
      case 61..80: color=report_colors[1];
                  break;
      case 81..100: color=report_colors[0];
                  break;
      default: color=ANSI_NORMAL;
    }
  }
  if(owner->QueryProp(P_ALIGN)>0 && test_bit(akt_lvl, 0))
  {
    if( time() != last_enh) {
      flags=EnhancedReport(owner, enh);
      last_flag=flags;
      last_enh=time();
    }
    else
      flags=last_flag;
  } else if(blindReport) {
      flags = GetBlindStatusLine();
  }
  else
    flags="-----------------------------";
  if(cnt>5) { 
      align=owner->al_to_title(owner->QueryProp(P_ALIGN));
    cnt=0;
  }
  cnt++;
  length=16-strlen(align)-2;
  // Vergleich und Ausgabe
  changedHP=hp-lasthp;
  changedSP=sp-lastsp;
  if ((((hp < lastHP) || (hp > lastHP && (sp == msp || callout)) || 
       (sp != lastSP) || (stat)) && (changedHP || changedSP)) || force) 
  {
    if(blindReport) {
      msg = sprintf("%sLP: %d MP: %d %s%s", color, hp, sp, flags, ANSI_NORMAL); 
    } else {
      msg=sprintf("%s%s(%s)%*'-'s LPs: %d(%s), MPs: %d(%s)%s",
          color, flags, align,length, "", hp, (changedHP>0?"+":"")+
          changedHP, sp, (changedSP>0?"+":"")+changedSP, ANSI_NORMAL);
    }
    tell_object(owner, msg+"\n");
    lastsp = sp;
    lasthp = hp;
    callout = 0;
    lastHP = hp; 
  }
  else if( !callout && (hp > lastHP+1) )
  {
    callout = 1;
    call_out("NotifyHpChange",0);
  }
  else 
  {
    callout = 0;
    lastHP = hp; 
  }
  // neue Werte merken
  lastSP = sp;
}

nosave void activate(object ob) {
  if (objectp(ob)) {
    aktiv = 1;
    owner = ob;
    owner_name = getuid(owner);
    ob->AddHpHook(ME);
    scrollHP = lastHP = ob->QueryProp(P_HP);
    scrollSP = lastSP = ob->QueryProp(P_SP);
    NotifyHpChange(1);
  } else {
    if (ob=(owner||TP)) ob->RemoveHpHook(ME);
    owner = owner_name = aktiv = 0;
  }
}

nosave Report(str) {
  string *msg;
  notify_fail("Syntax: preport ein|aus|level <0|1>|farben <0|1>|scroll x.\n");
  if(!sizeof(msg=explode(str, " "))) return 0;
  switch (msg[0]) {
    case "ein":
      if (aktiv && objectp(owner))
        write("Der Report-Modus ist schon eingeschaltet!\n");
      else {
        write("Report-Modus ist jetzt eingeschaltet.\n");
        activate(TP);
      }
      break;
    case "aus":
      if (!aktiv)
        write("Der Report-Modus ist doch schon ausgeschaltet!\n");
      else { 
        write("Report-Modus ist nun ausgeschaltet.\n");
        activate(0);
      }
      break;
    case "level":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 0);
      else 
        write("Syntax: preport level <0|1|2>\n"); 
      break;
    case "farben":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 1);
      else 
        write("Syntax: preport farben <0|1>\n"); 
      break;
    case "scroll":  
      if(sizeof(msg)>1)
      {
        noscroll = to_int(msg[1]);
        if (noscroll > 1 && noscroll < 100)
        {
          write("Preport erst, wenn " + noscroll + " Punkte hochgeidelt.\n");
        }
        else
          write("PReport mit normalem Scroll.\n");
      }
      else 
      {
        write("PReport mit normalem Scroll.\n"); 
        noscroll = 0;
      }
      break;
    case "hilfe":
      ShowReportHelp();
      break;
    case "blind":
      if(blindReport) {
          write("PReport nicht mehr im 'blind' Modus\n");
          blindReport = 0;
      } else {
          write("PReport ist jetzt im 'blind' Modus.\n");
          blindReport = 1;
      }
      break;
    default:
      return 0;
  }
  return 1;
}


nosave int ConfigureReport(string str, int what) {
 int flag;
 string txt;
 flag=to_int(str);
 if(flag<0 || flag>2) {
   write("Falsche Eingabe!\n");
   return 1;
 }
 if(what==1) txt="Farben";
 else txt="Level";
 if(flag==0) 
   akt_lvl=clear_bit(akt_lvl, what);
 else if(flag==1) {
   if(what==0) enh=1;
   akt_lvl=set_bit(akt_lvl, what);
 }
 else if(flag==2 && what==0) {
   enh=0;
   akt_lvl=set_bit(akt_lvl, what);
 }
 write("Ok, "+txt+" auf "+flag+" gesetzt!\n");
 return 1;
}

