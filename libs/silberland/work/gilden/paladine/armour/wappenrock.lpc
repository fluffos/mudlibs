//Prototypes
nosave string EnhancedReport(object owner, int flag);
nosave void activate(object ob);
int QueryAmaryllion(object caster);
int ShowColorHelp();
void SetListener(int flag);
int update_check_evil();
// No Shadows, thank you :)
nomask query_prevent_shadow() { return 1; }

create() {
  string *spells;

  if( !is_clone(TO) ) return;
  ::create();
  SUID;
  lay_hands=time()+25*3600;
  std_colors=({ANSI_GREEN, ANSI_YELLOW, ANSI_CYAN, ANSI_BLUE, ANSI_RED});
  report_colors=call_other(PALADINMASTER, "QueryColors", TP);
  if(!pointerp(report_colors) || !sizeof(report_colors)) 
    report_colors=std_colors;
  akt_lvl=set_bit(akt_lvl, 1);
  SetProp(P_SHORT, "Der Wappenrock der Paladine");
  SetProp(P_LONG, BS( 
    "Der Wappenrock der Paladine besteht aus feinstem Tuch, "
    "das in schlichtem Weiss gehalten ist. Auf der Vorder- und "
    "der Rueckseite ist ein kunstvolles Wappen zu sehen, welches "
    "eine Rose inmitten zweier gekreuzter Schwerter zeigt. "
    "Zusammengehalten wird der Wappenrock durch zwei silberne "
    "Spangen."));
  AddDetail("tuch",
     "Das Tuch aus dem der Wappenrock besteht ist sehr fest. Es "
    +"ist weiss.");
  AddDetail(({"vorderseite", "rueckseite"}), 
     "Sie zeigt ein Wappen.");
  AddDetail("wappen", 
     "Das Wappen stellt eine Rose in zwei gekreuzten Schwertern dar.");
  AddDetail("rose", 
     "Sie ist sehr kunstvoll gearbeitet.");
  AddDetail(({"schwerter", "paladinschwerter"}), 
     "Typische Paladinschwerter eben, wie Du sie sicher auch schon kennst.");
  AddDetail( ({"spange","spangen"}), 
     "Die Spangen bestehen aus blitzendem Silber.");
  AddDetail("silber", 
     "Kein einziger Kratzer verunstaltet die glaenzenden Spangen.");
  SetProp(P_NAME, "Wappenrock");
  SetProp(P_GENDER, MALE);
  AddId( ({"wappenrock", "rock", GUILDITEM_ID }) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILVER:10, MAT_CLOTH:90]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_NO_DAMAGE_DESTRUCT, 1);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_VALUE, 100);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_CURSED, 0);
  SetProp(P_INFO,
      "Der Wappenrock der Paladine ist ein hochmagisches Artefakt.\n"
      "Mit 'philfe' erfaehrst Du mehr ueber seine Faehigkeiten.\n" );
  SetProp(P_WORN_TEXT, "ueber der Ruestung getragen");

  AddCmd(({"prufe", "pruf"}),        "guild_shout");
  AddCmd(({"pwer"}),                 "pwer");
  AddCmd(({"preport"}),              "Report");
  AddCmd(({"pwink", "pwinke"}),      "pwinken");
  AddCmd(({"pknuddle", "pknuddel"}), "pknuddeln");
  AddCmd(({"pgebet"}),               "pgebet");
  AddCmd(({"phist"}),                "ShowHistory");
  AddCmd(({"philfe"}),               "philfe");
  AddCmd(({"pstatus"}),              "Status");
  AddCmd(({"pfarben"}),              "SetColors");
  AddCmd(({"pgesang"}),              "fuer_dusty");
  AddCmd(({"wirke", "wirk"}),        "layhands");
  AddCmd(({"beende", "beend"}),      "beenden");

  // Dies ist fuer den Spell-blocker
  // Alle spell commandos in eine checkfun umleiten
  spells = m_indices(call_other("/gilden/paladine", "QueryProp", P_GUILD_SKILLS));
  AddCmd( spells, "CastCheck" );

  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
//  call_out("update_check_evil", 4);
}

// Simpler check ob casten erlaubt ist
int CastCheck(string str)
{
  if (call_other("/gilden/paladine", "IsCastDisabled"))
    {
      // Die duerfen immer
      if (IS_LORD(TP) || TP->QueryProp(P_TESTPLAYER))
        return 0;

      tell_object(this_player(), "Dusty erhoert Dich nicht!\n");
      return 1;
    }

  return 0;
}

