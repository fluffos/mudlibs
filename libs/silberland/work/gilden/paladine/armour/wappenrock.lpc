  write("\nDer Wappenrock ermoeglicht folgende Kommandos:\n"
       "preport hilfe     : Hilfeseite zu preport\n"
       "pfarben hilfe     : Hilfe zu den Farbeinstellungen\n"
       "pruf(e)           : Teile mit fuer Paladine\n"
       "pwer (ort)        : Welcher Paladin ist gerade da und evtl. wo\n"
       "pwink(e)          : Allen Paladinen zuwinken\n"
       "pknuddle          : Alle Paladine knuddeln\n");
  if(TP->QueryProp(P_GUILD_LEVEL) > 14) 
 write("pgesang           : Fuer Dusty!\n");
  if(TP->QueryProp(P_GUILD_LEVEL) > 15)
 write("wirke dustys macht: Dustys Macht heilt alle!\n");
 write("phist             : History\n"
       "pstatus           : Eigener Status\n"
       "pgebet            : Gebet aufsagen :)\n"
       "beende (schutz)   : beenden von Schildparade/Goetterschutz/Spiegelschild\n");
