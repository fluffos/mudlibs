inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../paladin.h"


create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Staehlerne Beinschienen");
  SetProp(P_LONG, 
      "Die staehlernen Beinschienen sehen so aus, als wuerden "
      +"sie einiges an Schutz bieten. Auf der Frontseite ist "
      +"eine Rose inmitten zwei gekreuzter Schwerter eingraviert.");
  SetProp(P_NAME, "Beinschienen");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, "staehlern");
  SetProp(P_GENDER, FEMALE);
  AddId(({"beinschienen", "schienen", PALADINITEM}));
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_STEEL:95, MAT_BRONCE:5]));
  SetProp(P_WEIGHT, 1000);  
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1); 
  SetProp(P_INFO, BS("Nur Paladine koennen diese Beinschienen "
          +"tragen.\n"));
  SetWearFunc(TO);
}


int WearFunc(object ob)
{
  if(TP->QueryProp(P_GUILD)!="paladine") {
   write(BS("Nur Paladine duerfen diese Beinschienen "
           +"tragen."));
   return 0;
  }  
 return 1;
}




