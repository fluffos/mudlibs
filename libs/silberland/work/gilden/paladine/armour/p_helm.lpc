inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../paladin.h"


create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein staehlerner Paladinhelm");
  SetProp(P_LONG, 
          "Auf der Spitze dieses Helmes sitzt ein grosser, roter "
         +"Pferdeschweif. Der Helm stelbst besteht aus robustem und "
         +"exzellent verarbeiteten Zwergenstahl. Auf der Vorderseite "
         +"ist ein Wappen in Form einer Rose inmitten zwei gekreuzter "
         +"Schwerter eingraviert und bronziert.");
  SetProp(P_NAME, "Paladinhelm");
  SetProp(P_NAME_ADJ, "staehlern");
  SetProp(P_GENDER, MALE);
  AddId(({"helm", "paladinhelm", PALADINITEM}));
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_STEEL:95, MAT_BRONCE:5]));
  SetProp(P_WEIGHT, 1000);  
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1); 
  SetProp(P_INFO, BS("Nur Paladine koennen diesen Helm "
          +"tragen.\n"));
  SetWearFunc(TO);
}


int WearFunc(object ob)
{
  if(TP->QueryProp(P_GUILD)!="paladine") {
   write(BS("Nur Paladine duerfen diesen Helm "
           +"tragen."));
   return 0;
  }  
 return 1;
}




