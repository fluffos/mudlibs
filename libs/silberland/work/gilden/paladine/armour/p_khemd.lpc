inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../paladin.h"


create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein bronziertes Kettenhemd");
  SetProp(P_LONG, 
    "Das Kettenhemd besteht aus abertausenden Kettengliedern, "
   +"die ineinander verschlungen sind, so dass ein extrem feines "
   +"Kettengeflecht entsteht. Auf der Vorderseite ist das kunstvolle "
   +"Bild einer Rose inmitten von 2 gekreuzten Schwertern bronziert."); 
  SetProp(P_NAME, "Kettenhemd");
  SetProp(P_NAME_ADJ, "bronziert");
  SetProp(P_GENDER, NEUTER);
  AddId(({"hemd", "kettenhemd", PALADINITEM}));
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 35);
  SetProp(P_MATERIAL, ([MAT_STEEL:95, MAT_BRONCE:5]));
  SetProp(P_WEIGHT, 3000);  
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1); 
  SetProp(P_INFO, BS("Nur Paladine koennen dieses Kettenhemd "
          +"tragen.\n"));
  SetWearFunc(TO);
}


int WearFunc(object ob)
{
  if(TP->QueryProp(P_GUILD)!="paladine") {
   write(BS("Nur Paladine duerfen dieses Kettenhemd "
           +"tragen.\n"));
   return 0;
  }  
 return 1;
}




