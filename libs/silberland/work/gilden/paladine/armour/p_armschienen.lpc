inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../paladin.h"


create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Staehlerne Armschienen");
  SetProp(P_LONG, 
          "Auf der Front dieser Armschienen sind zwei Loewen "
         +"in kunstvoller Art eingraviert. Sie sehen so aus, "
         +"als bieten sie einiges an Schutz.");
  SetProp(P_NAME, "Armschienen");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, "staehlern");
  SetProp(P_GENDER, FEMALE);
  AddId(({"armschienen", "schienen", PALADINITEM}));
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_STEEL:95, MAT_BRONCE:5]));
  SetProp(P_WEIGHT, 1000);  
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1); 
  SetProp(P_INFO, BS("Nur Paladine koennen diese Armschienen "
          +"tragen.\n"));
  SetWearFunc(TO);
}


int WearFunc(object ob)
{
  if(TP->QueryProp(P_GUILD)!="paladine") {
   write(BS("Nur Paladine duerfen diese Armschienen "
           +"tragen."));
   return 0;
  }  
 return 1;
}




