inherit "std/armour";

#include "../paladin.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Der Wappenmantel der Paladine");
  SetProp(P_LONG, 
    "Der Wappenrock der Paladine besteht aus feinstem Tuch, "
   +"welches in schlichtem Weiss gehalten wird. "
   +"Auf der Rueckseite ist ein Wappen zu sehen, welches "
   +"eine Rose inmitten zwei gekreuzten Schwerter zeigt. ");
  AddDetail("tuch",
     "Das Tuch aus dem der Wappenrock besteht ist sehr fest. Es "
    +"ist weiss.");
  AddDetail("wappen", 
     "Das Wappen stellt eine Rose in zwei gekreuzten Schwertern "
    +"dar.");
  SetProp(P_NAME, "Wappenmantel");
  SetProp(P_GENDER, MALE);
  AddId( ({"wappenmantel", "mantel", PALADINITEM}) );
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_SILVER:10, MAT_CLOTH:90]));
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO, "Nur Paladine koennen diesen Mantel tragen.\n");
  SetProp(P_WORN_TEXT, "umgehaengt");
  
}


int WearFunc(object ob)
{
  if(TP->QueryProp(P_GUILD)!="paladine") {
    write(BS("Nur Paladine duerfen diesen Wappenmantel "
            +"tragen.\n"));
    return 0;
  }
  return 1;
}

