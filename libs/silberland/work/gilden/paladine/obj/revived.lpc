// Objekt, in dem gespeichert wird, wieviel man opfern muss nachdem 
// man auferstanden wurde
// 24.02.2004 Feyaria
//


inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../paladin.h"

string caster;
int opfermenge, total, viertel;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({PALADINITEM, "\nrevived", PALADINREVIVED}));
  if(getuid(previous_object()) != "GUILD.pal_spells" &&
      getuid(previous_object()) != "feyaria" &&
      getuid(previous_object()) != "angrox") 
  {
   call_out("remove", 1);
   return 0;
  }
}

int SetVariables(string caster1, int opfermenge1)
{
  int value;
  int ob;

  if(getuid(previous_object()) != "GUILD.pal_spells" && getuid(TP) != "feyaria")
  {
   call_out("remove", 1);
   return 0;
  }
  caster = caster1;
  total = opfermenge = opfermenge1;
  viertel = 3;
  return 1;
}

int opfer(int ammount)
{
  if(getuid(previous_object())!="GUILD.paladine") 
    return -1;
  if( (opfermenge -= ammount) < 0 )
  {
    tell_object(MENV, "Deine Schuld gegenueber " + CAP(caster) + " ist "
          "nun getilgt.\n");
    remove();
  }
  else if(viertel && opfermenge < viertel * total / 4)
  {
    tell_object(MENV, to_string(4 - viertel) + " Viertel Deiner Schuld "
        "gegenueber " + CAP(caster) + " " + (viertel == 3 ? "ist" : "sind")+ 
        " nun getilgt.\n");
    viertel --;
  }
  return 1;
}

mixed QueryVariables() {
  return ({caster, opfermenge, total});
}

string QueryPaladin()
{
  return caster;
}

void init() 
{
  ::init();
  if(!living(ENV(ME)))
    call_out("remove", 0);
}

void reset()
{
  ::reset();
  if(!is_clone(TO)) return;
  if( objectp(MENV) && interactive(MENV))
  {
    tell_object(MENV, BS("Dein Gewissen plagt Dich, da Du Deine Schuld "
          "gegenueber " + CAP(caster || "Dusty") + " noch nicht getilgt hast."));
    MENV->AddSp(-random(30));
  }
  set_next_reset(1000);
}

// Hier wird das Mapping wieder in die Properties eingetragen
void _set_autoloadobj(mixed data)
{
  if(mappingp(data) && sizeof(data)==4){
    caster=data["caster"];
    opfermenge=data["opfermenge"];
    total=data["total"];
    viertel=data["viertel"];
  }
  return;
}

// Und hier wird gespeichert
mapping _query_autoloadobj()
{
  return (["caster": caster, "opfermenge":opfermenge, "total":total,
      "viertel": viertel]);
}
