

#include "../paladin.h"
#include "crash.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <ansi.h>
nosave object spieler;
nosave int nummer=0;
nosave mixed var;
nosave string flag="";

// Hier wird das Mapping wieder in die Properties eingetragen
void _set_autoloadobj(mixed data)
{
  if(mappingp(data) && sizeof(data)==4){
    var=data["var"];
    flag=data["flag"];
    nummer=data["nummer"];
    spieler=find_player(data["spieler"]);
  }
  return;
}

// Und hier wird gespeichert
mapping _query_autoloadobj()
{
  return (["var": var, "flag":flag, "nummer":nummer,
      "spieler": (objectp(spieler)?getuid(spieler):"")]); 
}

create()
{
  if (!is_clone(TO) )  return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_GENDER, NEUTER);
  AddId(({PALADINITEM, PALADINTASK}));
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SUID;
}

reset()
{
  ::reset();
 if(!objectp(ENV(ME)) || 
       !query_once_interactive(ENV(ME)) ||
       ENV(ME)->QueryProp(P_GUILD)!="paladine")
    ME->remove();
}

int SetTask(int nr, object pl) {
  string prev, fn, msg;
  prev=getuid(PO);
  catch(fn=explode(file_name(PO), "#")[0]);
  if(member(UID_ALLOWED, prev)==-1) {
    msg=sprintf("Versuchte Aenderung (Task), PO: %O, NR: %d, "
      +"TP: %O\n", previous_object(), nr, TP);
    write_secure_log(msg);
    tell_angrox(ANSI_RED+msg);
    tell_zordan(ANSI_RED+msg);
    call_out("remove", 0);
    return 0;
  }
  nummer=nr;
  spieler=pl;
  return 1;
}

int GetTask(int nr, object pl)  {
  string prev, fn, msg;
  prev=getuid(PO);
  catch(fn=explode(file_name(PO), "#")[0]);
  if(member(FN_TASK_ALLOWED, fn)==-1 &&
     member(UID_ALLOWED, prev)==-1) 
  {
    return 0;
  }
  //tell_angrox(sprintf("OBJ: %O, nr: %O, nummer: %O, pl: %O, spieler: %O\n", TO, nr, nummer, pl, spieler));
  if(nr==nummer && pl==spieler) return 1;
  else return 0;
}


mixed GetVar() {
  return var;
}

int SetVar(mixed var1) {
  string prev, fn, msg;
  prev=getuid(PO);
  catch(fn=explode(file_name(PO), "#")[0]);
  if(member(FN_TASK_ALLOWED, fn)==-1 &&
      member(UID_ALLOWED, prev)==-1) 
  {
    msg=sprintf("Versuchte Aenderung (Task), PO: %O, NR: %d, "
      +"TP: %O\n", PO, var1, TP);
    write_secure_log(msg);
    tell_angrox(ANSI_RED+msg);
    tell_zordan(ANSI_RED+msg);
    call_out("remove", 0);
    return 0;
  }
  var=var1;
  if (MENV && living(MENV)) {
    write_file(MEMBERLOG(getuid(MENV)+".log"),sprintf(
      "%s: SetVar von %s auf %O\n",dtime(time()),fn,var1));
  }
  return 1;
}

string GetFlag() {
  return flag;
}


int SetFlag(int var) {
  string prev, fn, msg, vorher;
  prev=getuid(PO);
  catch(fn=explode(file_name(PO), "#")[0]);
  if(member(FN_TASK_ALLOWED, fn)==-1 &&
      member(UID_ALLOWED, prev)==-1) 
  {
    msg=sprintf("Versuchte Aenderung (Task), PO: %O, FLAG: %s, "
      +"TP: %O\n", PO, flag, TP);
    write_secure_log(msg);
    tell_angrox(ANSI_RED+msg);
    tell_zordan(ANSI_RED+msg);
    call_out("remove", 0);
    return 0;
  }
  vorher=flag;
  flag=set_bit(flag, var); 
  if (MENV && living(MENV)) {
    write_file(MEMBERLOG(getuid(MENV)+".log"),sprintf(
      "%s: SetFlag von %s von '%s' auf '%s' (%d).\n",
      dtime(time()),fn,vorher,flag,var));
  }
  return 1;
}


int ClearFlag(int var) {
  string prev, fn, msg;
  prev=getuid(PO);
  catch(fn=explode(file_name(PO), "#")[0]);
  if(member(FN_TASK_ALLOWED, fn)==-1 &&
      member(UID_ALLOWED, prev)==-1) 
  {
    msg=sprintf("Versuchte Aenderung (Task), PO: %O, FLAG: %s, "
      +"TP: %O\n",PO , flag, TP);
    write_secure_log(msg);
    tell_angrox(ANSI_RED+msg);
    tell_zordan(ANSI_RED+msg);
    call_out("remove", 0);
    return 0;
  }
  flag=clear_bit(flag, var); 
  return 1;
}



