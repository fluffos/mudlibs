inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../paladin.h"


nosave string ind,msg;
create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0); 
  SetProp(P_LONG, "");
  SetProp(P_NAME, "");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\msg"}) );
  SetProp(P_WEIGHT, 1); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

int Setup(string str, string str1) {
  msg=str;
  ind=str1;
  return 1;
}


void BecomesNetAlive(object wer) {
  int i;
  call_out("teile_mit", 4);
  return;
}

void teile_mit() {
   if(msg) 
     ENV(ME)->Message(BSA(msg,ind));
   remove();
   return;
}
