
inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../paladin.h"


nosave string prayroom;
nosave object *enemies;
create()
{
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({PALADINITEM, "\nstossgebet"}));
  if(getuid(previous_object())!="GUILD.pal_spells") {
   call_out("remove", 1);
   return 0;
  }
}

int SetFailure(string str) {
  if(getuid(previous_object())!="GUILD.pal_spells") {
    remove();
    return 0;
  }
  prayroom=str;
  call_out("Old", 500);
  return 1;
}

Old() {
  if(ENV(ME) && stringp(prayroom))
    ENV(ME)->SetPrayRoom(prayroom);
  remove();
}

int SetSuccess(int time) {
  if(getuid(previous_object())!="GUILD.pal_spells") {
    remove();
    return 0;
  }
  call_out("remove", time);
  if(ENV(ME))
    enemies=ENV(ME)->InFight();
  return 1;
}

remove() {
 if(ENV(ME) && interactive(ENV(ME)) && !stringp(prayroom)) {
   tell_object(ENV(ME), "Du bist wieder sterblich, Paladin!\n");
   if(pointerp(enemies))
     ENV(ME)->SetEnemies(enemies);
 }
 ::remove();
}


