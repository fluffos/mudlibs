
#include "../paladin.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein mieser Blutegel");
  SetProp(P_LONG,
    "Der Blutegel hat sich in Deiner Haut festgebissen und saugt ganz "
    "langsam und genuesslich Dein Blut aus. Entweder Du versuchst ihn jetzt "
    "ganz schnell loszuwerden, oder Du wirst am Ende noch daran sterben!!" );
  SetProp(P_INFO, "Irgendwie muss man dieses Biest doch entfernen koennen.");
  SetProp(P_NAME, "Blutegel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "blutegel","egel","QUESTOBJ" }) );

  SetProp (P_KILL_NAME, "Ein Blutegel");

  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd( "","allesfkt",1);
  AddCmd( ({ "entfern","entferne" }) , "entfernfkt" );
}

int entfernfkt(string str) {
  notify_fail("Was moechtest Du denn entfernen?\n");
  if (str != "egel" && str != "blutegel") return 0;
  if (random(100) < 20) {
    write(BS(
      "Du drehst den Blutegel leider genau falsch herum. Dadurch entsteht "
      "eine richtig blutende Wunde. Aua, das tat echt weh!"));
    TP->do_damage(10+random(10));
    return 1;
  }
  write(BS(
    "Gekonnt drehst Du den Blutegel im Kreis und entfernst ihn sauber von "
    "Deiner Haut."));
  ME->remove();
  return 1;
}

int allesfkt(string str) {
  if (random(100) < 10) {
    write(BS(
      "Der Blutegel zehrt von Deinem Blut. Das tut hoellisch weh!!"));
    TP->do_damage(5+random(5));
  }
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  remove();
}
