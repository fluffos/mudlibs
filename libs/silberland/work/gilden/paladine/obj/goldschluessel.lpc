/*
** Der Schluessel zum Goldtor
** 
** 08-10-1996  Angrox@SL
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "../paladin.h"

nosave int decay_resets=15;


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Goldschluessel");
  SetProp (P_LONG, 
               "Der Schluessel besteht aus purem Gold.");
  SetProp (P_NAME, "Goldschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 0);
  SetProp(P_MATERIAL, MAT_GOLD);
  AddId (({"goldschluessel", "schluessel", "\nschatzkammerschluessel3"}));
  
}

string QueryDoorKey()
{
  return ROOM("burg_geheim6")+":"+ROOM("burg_schatzkammer2");
}


void reset()
{
  object e;

  ::reset();
  if (!(--decay_resets))
  {
    if ((e = ENV(ME)) && interactive(e))
      tell_object(e, BS("Der Goldschluessel verschwindet in einem "
          "hellen Gleissen!"));
    remove();
  }
}

