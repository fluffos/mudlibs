inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../paladin.h"

nosave object player;
nosave int nr;
nosave int heal_value;

create() {
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({ PALADIN_MASSENHEILUNG }));
}

int start_heal(int heal, int n, object pl) {
  player=pl;
  heal_value=heal/n;
  if(heal % n)
    n++;
  nr=n;
  call_out("do_heal", 2);
  return 1;
}

void do_heal() {
  if(!objectp(player)) {
    remove();
    return;
  }
  player->AddHp(heal_value);
  nr--;
  if(nr<1) {
    tell_object(player, BS("Dustys heilende Kraft verlaesst Dich!"));
    remove();
    return;
  }
  call_out("do_heal", 3);
  return ;
}

