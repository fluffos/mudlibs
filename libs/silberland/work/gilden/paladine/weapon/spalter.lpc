#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
inherit "/std/weapon";

void create()
{
  object ob;
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Spalter, das Koboldsschwert");
  SetProp(P_LONG, 
      "Der Spalter ist ein besonderes Schwert: Seine Klinge ist "
      "dreimal so breit wie das eines normalen Schwertes. Die "
      "Oberseite der Klinge ist von Zacken ueberzogen, die den "
      "Spalter zu einer toetlichen Waffe machen. Aber warum nennt "
      "man es nur 'Koboldsschwert'?");
      
  SetProp(P_NAME, "Spalter");                 
  SetProp(P_GENDER, MALE);
  AddId( ({"schwert", "spalter", "\nberserker_spalten_waffe"}) );  

  SetProp(P_INFO, 
      "Mit der noetigen Staerke kann dieses Schwert auch "
      "einhaendig gefuehrt werden.");
  
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 220);
  SetProp(P_WC_FIXFACTOR, 0.3);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_RIP}) );
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_VALUE, 4500);
  SetProp(P_WEIGHT, 3300);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:40, A_STR:25]) );
  SetProp(P_MATERIAL, ([MAT_TITANIUM:60, MAT_STEEL:40]) ); 
  call_other("/p/daemon/itemd/functions/hitfuncrandom1", "???");
  ob=find_object("/p/daemon/itemd/functions/hitfuncrandom1");
  SetProp(P_HIT_FUNC, ob);
}

int _query_nr_hands() {
   if(TP->QueryAttribute(A_STR)<28)
     return 2;
   return 1;
}
