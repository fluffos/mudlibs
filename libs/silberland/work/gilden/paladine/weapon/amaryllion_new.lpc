inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>
#include <wizlevels.h>
#include <ansi.h>
#include <vt100.h>

#include "../paladin.h"

#define P_NEKRO_PESTERED "nekro_pestered"

nosave int attack;
nosave string fun;
nosave string oldfun;
nosave int pestered=0;

void set_amaryllion();

create() {
  if (is_clone(TO)) return 0;
  ::create();
  attack=0;
  set_amaryllion();
}

void set_amaryllion() {
  fun="hitfuncundead2";
  oldfun=fun;
  SetProp(P_SHORT, "Amaryllion, das Talismanschwert der Dusty");
  SetProp(P_LONG,  
    "Amaryllion, das Talismanschwert der Dusty, ist ein gefaehrlich "
    "aussehendes Schwert. Seine Klinge ist gerade und extrem scharf, "
    "mit langem Hohlschliff und einer tiefen Blutrinne. Die Parierstange "
    "ist in Form zweier Rosen gearbeitet, die zum Herz des Schwertes "
    "in Kupfer uebergehen. Die Stiele winden sich um den Griff zum "
    "Knauf des Schwertes, der als glaenzende Sonne dargestellt ist.");
  SetProp(P_NAME, "Amaryllion");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 0);
  AddId(({AMARYLLION, "schwert", "amaryllion", "talismanschwert", 
      PALADINITEM }));
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 200);
  SetProp(P_WC_FIX, 60);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_HOLY}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:90, MAT_COPPER: 5, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 15000000);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_WC_BONUS, (["\npaladin":300]));
  SetProp(P_INFO, BS("Das Talismanschwert der Dusty ist besonders gegen "
      +"Untote und Daemonen effektiv. Es ist so gut wie unzerstoerbar."));
  SetProp(P_QUALITY_DECAY, 0);
  SetHitFunc(TO);
  SetWieldFunc(TO);
  if(getuid(previous_object())!="GUILD.pal_spells" && !IS_ARCH(TP)) {
    call_out("remove", 1);
    return ;
  }
  AddDetail ( ({"klinge"}), 
      "Die Klinge von Amaryllion ist praezise und extrem scharf geschliffen. "
      "Die Blutrinne macht die Klinge sehr leicht, so das sie ohne Muehe "
      "geschwungen werden kann. Die Klinge schimmert leicht in einem "
      "ueberirdischen Glanz!");
  AddDetail ( ({ "blutrinne" }), 
      "Die Blutrinne macht die Klinge sehr leicht und balanciert Amaryllion "
      "sehr gut aus.");
  AddDetail ( ({ "glanz" }), 
      "Die Klinge von Amaryllion erstrahlt in einem leichten Glanz! Dusty "
      "ist eindeutig mit Dir!");
  
  AddDetail ( ({"parierstange"}), 
      "Die Parierstange ist in Form zweier Rosen gearbeitet. Zum Herz des "
      "Schwertes hin bilden die beiden Rosen den geschwungenen Griff, "
      "der sich zum Knauf hin windet.");

  AddDetail( ({"rosen"}), 
      "Die Rosen sind sehr filigran gearbeitet und haben einen kupfernen "
      "Glanz.");

  AddDetail( ({"knauf"}), 
      "Der Knauf von Amaryllion ist in Form einer goldenen Sonne gearbeitet, "
      "von der eine leichte Waerme auszugehen scheint. Du fuehlst wie die "
      "Macht Dustys Dich durchflutet, Paladin!");

  AddDetail( ({"macht"}), 
      "Dusty ist mit Dir!");

  AddDetail( ({"sonne"}), 
      "Vom Knauf, der wie eine Sonne gearbeitet ist, geht eine sehr angenehme "
      "Waerme aus. Deine Zuversicht ist gestaerkt!");

  AddDetail( ({"stiele", "stiel"}), 
      "Die Stiele der zwei Rosen, die die Parierstange bilden, winden sich in "
      "der Mitte als Griff des Schwertes zum Knauf, der wie eine prunkvolle "
      "Sonne gearbeitet ist! Ein wahrhaft goettliches Schwert!");
  return;
}

void set_pestered_amaryllion() {
  fun="hitfuncundead2";
  oldfun=fun;
  SetProp(P_LONG,  
    "Amaryllion, die Rache der Niederhoellen ist eine bluttriefende "
    "Waffe, von der niederhoellische Kaelte ausgeht. "
    "Seine Klinge ist gerade und extrem scharf, "
    "mit langem Hohlschliff und einer tiefen Blutrinne. Die Parierstange "
    "ist in Form zweier schwarzer Rosen gearbeitet, die zum Herz des Schwertes "
    "in Kupfer uebergehen. Die Stiele winden sich um den Griff zum "
    "Knauf des Schwertes, der als Totenkopf dargestellt ist.");
  SetProp(P_NAME, "Amaryllion");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 0);
  AddId(({AMARYLLION, "schwert", "amaryllion", "talismanschwert", 
      }));
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 200);
  SetProp(P_WC_FIX, 60);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:80, MAT_COPPER: 5, MAT_LEATHER:5, 
    MAT_MISC_UNHOLY:10]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 15000000);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_INFO, BS("TOETE! TOETE! TOETE ALLES DAMIT!"));
  SetProp(P_QUALITY_DECAY, 0);
  SetHitFunc(TO);
  SetWieldFunc(TO);
  AddDetail ( ({"klinge"}), 
      "Die Klinge von Amaryllion ist praezise und extrem scharf geschliffen. "
      "Die Blutrinne macht die Klinge sehr leicht, so das sie ohne Muehe "
      "geschwungen werden kann. Von der Klinge laeuft staendig ein leichter "
      "Blutstrom. Sie ist eiskalt.");
  AddDetail ( ({ "blutrinne" }), 
      "Die Blutrinne macht die Klinge sehr leicht und balanciert Amaryllion "
      "sehr gut aus.");
  AddDetail ( ({ "blutstrom" }), 
      "Ein staendiger Blutstrom laeuft von der Klinge.");
  
  AddDetail ( ({"parierstange"}), 
      "Die Parierstange ist in Form zweier schwarzer Rosen gearbeitet. "
      "Zum Herz des "
      "Schwertes hin bilden die beiden Rosen den geschwungenen Griff, "
      "der sich zum Knauf hin windet.");

  AddDetail( ({"rosen"}), 
      "Die Rosen sind sehr filigran gearbeitet und haben einen schwarzen "
      "Glanz.");
  AddDetail( ({"knauf"}), 
      "Der Knauf von Amaryllion ist in Form eines Totenschaedels gearbeitet.");
  AddDetail( ({"totenschaedel"}), 
      "Er scheint haemisch zu grinsen.");
  return;
}

int HitFunc(object enemy) {
  int align, bonus, daemon,x;
  object wielder;
  string *txt, err;
  bonus=random(30);
  align=enemy->QueryProp(P_ALIGN);
  wielder=QueryProp(P_WIELDED);
  if(!wielder) return 0;
  if(!pestered) {
    if(align>0 && !random(3) && interactive(wielder) )
    {
      tell_object(wielder, BS("FREVLER! Das Talismanschwert "
            "dient nur zu Bekaempfung des BOESEN!!!"));
      wielder->SetProp(P_ALIGN, 0);
      wielder->SetProp(P_SP, 0);
      wielder->AddHp(-(random(50)+50));
      call_out("remove", 0, 1);
    }
    if(align<0)
      bonus-=align/10;
    if(enemy->is_class_member(CL_UNDEAD) || enemy->is_class_member(CL_DEMON)) {
      daemon=1;
    }
    else {
      daemon=0;
    }
  }
  else {
      bonus=wielder->QueryProp(P_ALIGN)/10;
  }
  if(attack > 20 && wielder->QueryProp(P_SP) > 10) {
    attack=0;
    wielder->AddSp(-10);
    do {
      switch(random(100)) {
        case 0..4   : fun="hitfunc3"; 
                      txt=({"'Und siehe! Dustys Macht verstaerkt sich in der "
                        "Hand eines glaeubigen Paladins!'",
                        "Niederhoellische Maechte manifestieren sich in "
                        "Amaryllion!"});
                      break;
        case 5..12  : fun="hitfunc2";
                      txt=({"'Und siehe! Dustys Macht verstaerkt sich in der "
                        "Hand eines glaeubigen Paladins!'",
                        "Schneller toeten! DU MUSST SCHNELLER TOETEN! "
                        "AMARYLLION BRAUCHT BLUT!"});
                      break;
        case 13..30 : if(!pestered) fun="hitfuncundead1"; 
                        else fun="hitfuncpaladin1";  
                      txt=({"'In Dustys Namen: Fahret zurueck in die Nieder"
                        "hoellen, untotes Gezuecht!'",
                        "TOETE PALADINE! AMARYLLION WILL PALADINBLUT!"});
                      break;
        case 31..35 : fun="hitfuncvampire2";
                      txt=({"'Die goettliche Kraft ermoeglicht es dem "
                        "Sterblichen Berge zu versetzen!'",
                        "Du spuerst wie unheilige Macht Dich durch"
                        "pulst!"});
                      break;
        case 36..40 : fun="hitfuncblood2";
                      txt=({"'Wer den gottgefaelligen Weg waehlt findet "
                        "Gefallen im Auge der Goettin!'",
                        "Du spuerst wie unheilige Lebenskraft Dich durch"
                        "pulst!"});
                      break;
        case 41..45 : fun="hitfuncspeed2";
                      txt=({"'Kaempfe fuer Dusty! Schnell und hart!'",
                          "AMARYLLION WILL SCHNELLER BLUT!"});
                      break;
        case 46..55 : fun="hitfuncmaertyrer1";
                      txt=({"'Wer sein Leben fuer die rechte Sache in die "
                        "Waagschale wirft wird die Kraft der Goettin "
                        "in sich spueren!'",
                        "Amaryllion will auch DEIN Blut!"});
                      break;
        case 56..65 : fun="hitfuncblood1";
                      txt=({"'Wer den gottgefaelligen Weg waehlt findet "
                        "Gefallen im Auge der Goettin!'",
                        "Du spuerst wie unheilige Lebenskraft Dich durch"
                        "pulst!"});
                      break;
        case 66..75 : fun="hitfuncvampire2";
                      txt=({"'Die goettliche Kraft ermoeglicht es dem "
                        "Sterblichen Berge zu versetzen!'",
                        "Du spuerst wie unheilige Macht Dich durch"
                        "pulst!"});
                      break;
        case 76..81 : fun="hitfuncparalyze1";
                      txt=({"'Erstarrt vor Furcht, ihr, die ihr Dustys "
                        "Macht verhoehnt!'",
                        "Die unheilige Macht Amaryllions' laesst Deine "
                        "Gegner erstarren!"});
                      break;
        case 82..83 : fun="hitfuncblutrausch1";
                      txt=({"'Nur der Glaeubige wird bestehen!'",
                          "JETZT ODER NIE! TOETEN OHNE RUECKSICHT!"});
                      attack=19;
                      break;
        case 84..95 : if (!pestered) fun="hitfuncundead2";
                        else fun="hitfuncpaladin2";  
                      txt=({"'In Dustys Namen: Fahret zurueck in die Nieder"
                        "hoellen, untotes Gezuecht!'",
                        "MEHR PALADINLEICHEN FUER AMARYLLION!"});
                      break;
        case 96..100: fun="hitfuncmoney2";
                      txt=({"'Der Glaeubige hilft den Armen mit dem Reichtum, "
                        "den Dusty beschert!'",
                        "Geld bedeutet MACHT!"});
                      break;
                      
      }
    } while((oldfun == fun) && !fun && (fun == ""));
    oldfun=fun;
    tell_object(wielder, BS(txt[pestered]));
  }
  attack++;
  //TELL("angrox", sprintf("AMA: %O, %O, %O\n", wielder, fun, attack));
  if(err = catch(call_other("/p/daemon/itemd/functions/"+fun, "???")))
  {
    TELL("angrox", sprintf("AMARYLLION ERROR: (%s), fun = %O, Player = %O\n", 
          err, fun, wielder));
    write_file(LOG("ama.error"), sprintf("%s: (%s), fun = %O, Player = %O\n",
          dtime(time()), err, fun, wielder));
    fun="hitfunc1";
  }
  else {
    bonus+=call_other("/p/daemon/itemd/functions/"+fun, "HitFunc",enemy);
  }
  if(bonus > 200) bonus=200;
  if(daemon) bonus*=2;
  return (bonus/3)+random(2*bonus/3);
}

int start_remove(int time) {
  while(find_call_out("remove")!=-1)
    remove_call_out("remove");
  call_out("remove", time);
  return 1;
}

reset() {
  ::reset();
  call_out("remove", 0);
}

int WieldFunc(object ob) {
  if(!pestered) {
    if(TP->QueryProp(P_GUILD)!="paladine") {
      write(BS("Nur Paladine koennen dieses Schwert "
            +"zuecken. Das Schwert kehrt zu Dusty zurueck."));
      call_out("remove", 0,1);
      return 0;
    }
    return 1;
  }
  else {
    if(TP->QueryProp(P_GUILD)!="nekromanten") {
      write(BS("Nur verfluchte Nekromanten koennen das Schwert zuecken."));
      return 0;
    }
    return 1;
  }
}


BecomesNetDead(object wer) {
  call_out("remove",100);
}


varargs remove(int flag) {
  ME->SetProp(P_CURSED,0);
  if(ENV(ME) && !flag) {
    if(!pestered)
      tell_object(ENV(ME), BS("Amaryllion kehrt zu Dusty zurueck! Du "
        +"dankst Dusty fuer ihre Leihgabe!"));
    else 
      tell_object(ENV(ME), BS("HARHAR! Was fuer ein feistes Blutfest "
            "dies war!"));
  }
  ::remove();
}

varargs void write_color(string text, string color )
{
  string tty;
  tty=ENV(ME)->QueryProp(P_TTY);
  if(tty=="ansi")
    write(color+text+ANSI_NORMAL);
  else
    write(text);
}

string short()
{
  string s;
  if (QueryProp(P_WIELDED)) 
    s=" (gezueckt)";
  else
    s="";
  if(this_player() && this_player()->QueryProp(P_TTY)=="ansi") {
    if(!pestered)
      return VT_RED+"Amaryllion, das Talismanschwert der Dusty"+s+"."+
      VT_NORMAL+"\n";
    else
      return VT_RED+"Amaryllion, die Rache der Niederhoellen (verpestet)"+
        s+"."+VT_NORMAL+"\n";
  }
  if(!pestered)
    return "Amaryllion, das Talismanschwert der Dusty"+s+".\n";
  else
    return "Amaryllion, die Rache der Niederhoellen (verpestet)"+s+".\n";
}   

string name(int casus, int daemon)
{
  string n;
  n=::name(casus, daemon);
  if( this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return VT_RED+n+VT_NORMAL;
  return n;
}

string Name(int casus, int daemon)
{
  return capitalize(name(casus,daemon));
}

void set_pestered(object _nekro) {
  if(pestered) return;
  pestered=1;
  SetProp(P_NEKRO_PESTERED, _nekro);
  set_pestered_amaryllion();
  while(find_call_out("start_remove")!=-1) 
    remove_call_out("start_remove");
  start_remove(300+random(300));
  return ;
}

void unset_pestered() {
  SetProp(P_NEKRO_PESTERED, 0);
  pestered=0;
  return;
}

