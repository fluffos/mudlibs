inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../paladin.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schwert", "ritterschwert", "\n_paladinschwert",
           PALADINITEM}));
  SetProp (P_SHORT, "Ein prachtvolles Ritterschwert");
  SetProp (P_LONG,
      "Dieses Ritterschwert ist eine maechtige Waffe, geschmiedet "
      +"aus dem besten Zwergenstahl. Es weisst eine lange Hohlschaerfe "
      +"auf, der Griff ist mit Kupfer umwickelt und die Parierstangen "
      +"sind in Form zweier stilisierter Rosen gearbeitet.");
  SetProp (P_NAME, "Ritterschwert");
  SetProp (P_NAME_ADJ, "prachtvoll"); 
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 8000);
  SetProp (P_WEIGHT, 2000);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_WC, 150);
  SetProp (P_WC_FIXFACTOR, 0.5);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_STEEL: 80, MAT_COPPER:10, MAT_MITHRIL:10]));
  SetProp (P_INFO, BS(
      "Das Ritterschwert ist die Waffe des Paladins. Nur er oder sie kann "
      +"das heilige Schwert zuecken und fuehren.\n"));
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR:15,A_DEX:18]) );
  SetProp (P_WC_BONUS, ([ "\npaladin"      : 250, 
                          "\n_p_waechter"  : 25,
                          "Schwertkaempfer": 75,
                          "\n_ayla"        : 350 ]) );  
  SetProp(P_WIELD_FUNC, TO);
}

int WieldFunc(object ob) {
  if(MENV->QueryProp(P_GUILD)!="paladine") {
    write(BS("Nur Paladine koennen dieses Schwert "
            +"zuecken.\n"));
    return 0;
  }
  return 1;
}

