#include <wizlevels.h>
#include <language.h>
#include <config.h>
#include <new_skills.h>
#include <properties.h>
#include <defines.h>
#include <moredef.h>


create() {
  if (is_clone(this_object())) {
    destruct(this_object());
    return 1;
  }
  seteuid(getuid(this_object()));
}


int check_user(string user) {
  object tante;
  string output,out1;
  string *users;
  if(!tante=find_living("tratschtante"))
    return 0;
  output=tante->tantenwer();
  catch(out1=lower_case(explode(explode(output, "Fans: ")[1], 
          ". Insgesamt")[0]));
  catch(users=explode(out1, ", "));
  if(!pointerp(users)) return 0;
  if(member(users, user) == -1 ) return 0;
  return 1;
}
