#include <wizlevels.h>
#include <language.h>
#include <config.h>
#include <new_skills.h>
#include <properties.h>
#include <defines.h>
#include <moredef.h>

mapping properties;
create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));
}

mixed QueryFileProp(string player, string prop)
{
 player=lower_case(player);
 if(!restore_object("/save/"+player[0..0]+"/"+player))
   return 0;
 if(mappingp(properties)) return properties[prop];
 else return 0;
}
