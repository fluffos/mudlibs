#include <wizlevels.h>
#include <language.h>
#include <config.h>
#include <new_skills.h>
#include <properties.h>
#include <defines.h>
#include <moredef.h>

mapping properties;
create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));
}

// Wir machen unseren eigenen Res_checker, der alle Anforderungen ausgibt :)
// Vorteil: Gibt genau aus, was Spieler fehlt. Eventuell sollte man ihn 
// (wenn er so funktioniert), in die MudLib einbauen?
varargs mixed check_new_restrictions(object pl, mapping gotrestr, int flag) {
  string guild,race,res,s;
  int i;
  mixed newres;
  mapping restr;

  restr=copy_mapping(gotrestr); // lassma das original mal so wie es ist :-)
   
  if(!mappingp(restr)) return 0;
  if(!objectp(pl)) return "";
  if(!intp(flag)) flag=0;
  s="";
  guild=pl->QueryProp(P_GUILD);
  race=pl->QueryProp(P_RACE);
  if(restr[SM_RACE] && mappingp(restr[SM_RACE]) &&
      member(restr[SM_RACE], race) && mappingp(restr[SM_RACE][race]))
  {
    // hehe, uebergebene mappings aendern... das ist schon fies :-)
    restr+=restr[SM_RACE][race];
    restr=m_delete(restr, SM_RACE);
  }
  if(restr[P_FROG] && pl->QueryProp(P_FROG))
    s+="Als Frosch kannst Du das nicht! ";
  if(pl->QueryProp(P_LEVEL)<restr[P_LEVEL])
    s+="Dir fehl"+((i=restr[P_LEVEL]-pl->QueryProp(P_LEVEL))==1?"t":"en")+
      " noch "+i+" Stufe"+(i==1?"":"n")+". ";
  if(pl->QueryProp(P_GUILD_LEVEL) < restr[P_GUILD_LEVEL])
    s+="Du musst noch "+(i=restr[P_GUILD_LEVEL]-pl->QueryProp(P_GUILD_LEVEL))+
      " Gildenstufe"+(i==1?"":"n")+" erhoehen. ";
  if (pl->QueryProp(P_XP) < restr[P_XP])
    s+="Dir fehlen noch "+(i=restr[P_XP] - pl->QueryProp(P_XP))+
       " Erfahrungspunkt"+(i==1?"":"e")+". ";
  if (pl->QueryProp(P_QP) < restr[P_QP])
    s+="Dir fehlen noch "+(i=restr[P_QP] - pl->QueryProp(P_QP))+
      " Abenteuerpunkt"+(i==1?"":"e")+". ";
  if (pl->QueryProp(P_DEADS) < restr[P_DEADS])
    s+="Du musst noch "+(restr[P_DEADS]-pl->QueryProp(P_DEADS))+" Mal "
      "sterben. ";
  if (pl->QueryProp(P_TOTAL_LOST_XP) < restr[P_LOST_XP])
    s+="Du musst noch "+(i=restr[P_LOST_XP]-pl->QueryProp(P_TOTAL_LOST_XP))+
      " Erfahrungspunkt"+(i==1?"":"e")+" durch Tode verlieren. ";
  if (pl->QueryAttribute(A_INT) < restr[A_INT])
    s+="Deine Intelligenz ist um "+(restr[A_INT]-pl->QueryAttribute(A_INT))+
       " zu niedrig. ";
  if (pl->QueryAttribute(A_DEX) < restr[A_DEX])
    s+="Deine Geschicklichkeit musst Du noch um "+ 
       (restr[A_DEX]-pl->QueryAttribute(A_DEX))+" Punkt"+(i==1?"":"e")+" steigern. ";
  if (pl->QueryAttribute(A_CON) < restr[A_CON])
    s+="Dir fehlen noch "+
       (restr[A_CON]-pl->QueryAttribute(A_CON))+" Ausdauerpunkt"+(i==1?"":"e")+". ";
  if(pl->QueryAttribute(A_STR) < restr[A_STR])
    s+="Deine Staerke ist um "+
       (restr[A_STR]-pl->QueryAttribute(A_STR))+" zu niedrig. ";
  if(restr[SR_SEER] && !IS_SEER(pl))
    s+= "Du musst dazu erst Seher werden. ";
  if(restr[SR_BAD] && pl->QueryProp(P_ALIGN)<restr[SR_BAD])
    s+="Du bist zu boese. ";
  if(restr[SR_GOOD] && pl->QueryProp(P_ALIGN)>restr[SR_GOOD])
    s+="Du bist nicht boese genug. ";
  if(restr[SR_MAX_SIZE] && pl->QueryProp(P_SIZE)>restr[SR_MAX_SIZE])
    s+="Du bist zu gross. ";
  if(restr[SR_MIN_SIZE] && pl->QueryProp(P_SIZE)<restr[SR_MIN_SIZE])
    s+="Du bist zu klein. ";
  if(restr[SR_MAX_ALC] && pl->QueryProp(P_ALCOHOL)>restr[SR_MAX_ALC])
    s+="Du bist zu betrunken. ";
  if(restr[SR_MIN_ALC] && pl->QueryProp(P_ALCOHOL)<restr[SR_MIN_ALC])
    s+="Du bist zu nuechtern. ";
  if(restr[SR_MAX_DRINK] && pl->QueryProp(P_DRINK)>restr[SR_MAX_DRINK])
    s+="Du hast zuviel getrunken. ";
  if(restr[SR_MIN_DRINK] && pl->QueryProp(P_DRINK)<restr[SR_MIN_DRINK])
    s+="Du musst mehr trinken. ";
  if(restr[SR_MAX_FOOD] && pl->QueryProp(P_FOOD)>restr[SR_MAX_FOOD])
    s+="Du hast zuviel gegessen. ";
  if(restr[SR_MIN_FOOD] && pl->QueryProp(P_FOOD)<restr[SR_MIN_FOOD])
    s+="Du musst mehr essen. ";
  if(restr[SR_FREE_HANDS] && (pl->QueryProp(P_MAX_HANDS)-
      pl->QueryProp(P_USED_HANDS))<restr[SR_FREE_HANDS])
    s+="Du hast nicht genug freie Haende. ";
  if((pointerp(restr[SR_EXCLUDE_GUILD]) &&
       member(restr[SR_EXCLUDE_GUILD],guild)>=0) ||
      (pointerp(restr[SR_INCLUDE_GUILD]) &&
       member(restr[SR_INCLUDE_GUILD],guild)<0))
    s += ("Als Mitglied der Gilde "+capitalize(guild)+" kannst Du das nicht. ");
  if((pointerp(restr[SR_EXCLUDE_RACE]) &&
       member(restr[SR_EXCLUDE_RACE],race)>=0) ||
      (pointerp(restr[SR_INCLUDE_RACE]) &&
       member(restr[SR_INCLUDE_RACE],race)<0))
    s += ("Als "+race+" kannst Du das nicht. ");
  if(restr[SR_FUN]) {
    res=call_other(previous_object(),restr[SR_FUN],pl);
    if(res) s+=res;
  }
  if(!s||s=="") s=0;
  return s;
}


// Kompatiblitaetsfunktion zu /std/restrictions_checker.c

string check_restrictions(object pl, mapping restr) {
  return check_new_restrictions(pl, restr); 
}
