int access_rights(string name, string file, int readflag, int def)
{
  string s1;

  if (readflag) return def;

  name=lower_case(name);
  if (file=="access_rights.lpc") return 0;
  if (sscanf(file,"%s",s1)!=1) return 0;
  // Berserkergilde fuer Feyaria
  if( name=="feyaria" && s1=="berserker_spells" ) 
    return 1;
  // Hexengilde fuer Amazora
  if( name=="amazora" && s1=="hexen_spells" ) 
    return 1;
  // Druidengilde fuer Angrox
  if( name="angrox" && s1="druiden_spells")
    return 1;   
  // Wandlergilde fuer Sargola
  if( name="sargola" && s1="wandler_spells")
    return 1;   
  // Alchemistengilde fuer Stahldorn
  if( name="stahldorn" && s1="alch_spells")
    return 1;   
  // Runencaster-gilde fuer Lamuerte und Trantor
  if( name="lamuerte" || name="trantor" && s1="runen_spells")
    return 1;   
}
