#define KEY_SERVICE 1
#define KEY_SP 2
#define KEY_SP_TEXT 3
#define KEY_COUNT 4
#define KEY_ID 5
#define KEY_SING_TEXT 6
#define KEY_PLUR_TEXT 7
#define KEY_TEXT 8
#define KEY_SYNTAX 9

nosave int     callouts;
