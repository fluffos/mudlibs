int
blitz(object caster, mapping sinfo) 
{
   object l;

   printf("Du konzentrierst Dich auf Deine Umgebung.\n");
   say(sprintf("%s versinkt fuer einen Augenblick in tiefster Konzentration.\n", 
               caster->name()));

   if (SpellSuccess(caster,sinfo)<=0)
      return MISSERFOLG;

   printf("Fuer einen kurzen Augenblick siehst Du alles ganz klar.\n");
   printf(
     environment(caster)->int_long(caster, caster) ||
     "Irgendwie kannst Du nichts erkennen, so sehr Du dich auch anstrengst.\n");

   return ERFOLG;
}

int ausweichen(object caster, mapping sinfo)
{
  mixed h;
  int suc,dauer;

  if (!caster->InFight())
  {
    write("Aber Du kaempfst doch gar nicht!\n");
    return 0;
  }
  if (h=caster->QueryProp(P_TMP_DEFEND_HOOK))
  {
    if ((h[1]==this_object()) && (h[2]=="ausgewichen")) {
      if (h[0] >= time())
        return write("Noch mehr ausweichen kannst Du nicht.\n"), 0;
    } else
      return write("Irgendwie klappt das gerade nicht.\n"), 0;
  }
  if ((suc=SpellSuccess(caster,sinfo)) <= 0)
    return MISSERFOLG;

  dauer = 2 + caster->QueryAttribute(A_DEX)/6 + (suc/5000);
  caster->SetProp(P_TMP_DEFEND_HOOK,
      ({ time()+dauer, this_object(), "ausgewichen" }));
  write("Du gehst ein wenig in Deckung.\n");
  return ERFOLG;
}

mixed ausgewichen(int dam, mixed dam_type, mixed spell, object enemy)
{
  if (sizeof(filter_array(dam_type,PHYSICAL_DAMAGE_TYPES)))
  {
    dam /= 3;
    if (dam < 20)
      tell_object(previous_object(), "Du weichst gekonnt aus.\n");
    else
      tell_object(previous_object(), "Du weichst ein wenig aus.\n");
    return ({ dam, dam_type, spell, enemy });
  }
  tell_object(previous_object(),
      "Es gelingt Dir nicht, den Angriffen Deines Gegners auszuweichen.\n");
  return ({ dam, dam_type, spell, enemy });
}

int 
feuerball(object caster, mapping sinfo) {
  object victim;
  int hands, suc;
  string vnw, feuertext;
  
  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Auf wen willst Du einen Feuerball schleudern?\n");
  if (!victim)
    return 0;
   if ( (suc=SpellSuccess(caster,sinfo)) <=0)
    return MISSERFOLG;

  if( suc<2000 )
    feuertext = "ein kleines Feuerbaellchen";
  else if( suc<6000 )
    feuertext = "einen Feuerball";
  else if( suc<8000 )
    feuertext = "einen grossen Feuerball";
  else
    feuertext = "einen gewaltig grossen Feuerball";
  vnw = victim->name(WEM, 2);
  say(sprintf("%s wirft "+feuertext+" nach %s.\n", 
              capitalize(caster->name()), vnw), victim);
  printf("Du wirfst "+feuertext+" nach %s.\n", vnw);
  tell_object(victim, sprintf("%s wirft "+feuertext+" nach Dir.\n",
                              capitalize(caster->name())));

  TryDefaultAttackSpell(victim,caster,sinfo,
                        ([SP_NAME:"Feuerball",SP_SHOW_DAMAGE:1]));
  return ERFOLG;
}

int
pfeil(object caster, mapping sinfo) {
  object victim;
  int hands;
  string vn, vnw, cn;


  victim=FindEnemyVictim(sinfo[SI_SKILLARG],caster,
                         "Nach wem willst Du einen magischen Pfeil werfen?\n");
  if (!victim)
    return 0;
  if (SpellSuccess(caster,sinfo)<=0)
    return MISSERFOLG;

  cn = capitalize(caster->name());
  vnw = victim->name(WEN, 2);
  say(sprintf("%s feuert einen magischen Pfeil auf %s ab.\n",cn, vnw),
      victim);
  printf("Du feuerst einen magischen Pfeil auf %s ab.\n", vnw);
  tell_object(victim,sprintf("%s feuert einen magischen Pfeil auf Dich ab.\n",
                             cn));
  TryDefaultAttackSpell(victim,caster,sinfo,
                        ([SP_NAME:"Pfeil",SP_SHOW_DAMAGE:1]));
  return ERFOLG;
}

int 
schnell(object caster, mapping sinfo) {
  int dauer, erfolg;

  erfolg = SpellSuccess(caster,sinfo);
  if (-2000 <= erfolg && erfolg<=0)
    return MISSERFOLG;

  dauer = caster->QueryAttribute(A_DEX) + random(sinfo[SI_SKILLABILITY]/1000);
  if (erfolg < -2000)
  {
    total_fail = 1;
    write("Der Spruch ging total daneben! Alles wird so zaehhh...\n");
    caster->ModifySkillAttribute(caster,SA_SPEED,50,dauer);
    return MISSERFOLG;
  }
  if (erfolg > 6000)
  {
    write("Du fuehlst Dich ploetzlich sehr viel schneller.\n");
    caster->ModifySkillAttribute(caster,SA_SPEED,300,dauer/2);
  }
  else
  {
    write("Du fuehlst Dich ploetzlich deutlich schneller.\n");
    caster->ModifySkillAttribute(caster,SA_SPEED,200,dauer);
  }

  return ERFOLG;
}
