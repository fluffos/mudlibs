void all_spells()
{
  write(
    "Du kannst hier folgende Faehigkeiten lernen:\n"
    "Niemand sagt: Extraktion   : Ab Gildenstufe 1.\n");
}

OwnLearnSpell(string str)
{
  mixed ret;

  if(!IsGuildMember(this_player()))
  {
    write( "Du bist kein Mitglied dieser Gilde!\n");
    return 1;
  }
  notify_fail("Was moechtest Du hier lernen?\n");

  if(!str)
  { 
    all_spells();
    return 1;
  }
  ret = LearnSpell(str);
  if((str == "extraktion") && ret) //da InitialSkillAbility a SCHAS is
    this_player()->ModifySkill("extraktion", 5000);

  return ret;
}

string int2string(int wert)
{
  string str;
  switch(wert)
  {
    case    0..500 : str="so gut wie gar nicht";    break;
    case  501..1000: str="fast gar nicht";          break;
    case 1001..1500: str="kaum";                    break;
    case 1501..2000: str="sehr miserabel";          break;
    case 2001..2500: str="miserabel";               break;
    case 2501..3000: str="ziemlich schlecht";       break;
    case 3001..3500: str="schlecht";                break;
    case 3501..4000: str="maessig";                 break;
    case 4001..4500: str="unterdurchschnittlich";   break;
    case 4501..5000: str="durchschnittlich";        break;
    case 5001..5500: str="ueberdurchschnittlich";   break;
    case 5501..6000: str="gut";                     break;
    case 6001..6500: str="wirklich gut";            break;
    case 6501..7000: str="sehr gut";                break;
    case 7001..7500: str="unglaublich gut";         break;
    case 7501..8000: str="phantastisch gut";        break;
    case 8001..8500: str="ausgezeichnet";           break;
    case 8501..9000: str="hervorragend";            break;
    case 9001..9500: str="meisterhaft";             break;
    case 9501..9999: str="nahezu perfekt";          break;
    case 10000:      str="absolut perfekt";         break;
  }
  return str;
}

string NeedMoreXP(object pl, int xp)
{
  string str;
  int percent, x;
  write("Kronang sagt: Du musst noch mehr Erfahrung sammeln!\n");
             
  say("Kronang sagt zu "+capitalize(getuid(pl))+": Du musst noch mehr "
      "Erfahrung sammeln!\n");
//  x=call_other(BMASTER, "GetXpDifference", pl,
//              pl->QueryProp(P_XP));
  percent=100*x/xp;
  switch (percent)
  {
    case  0..10:  str="nur mehr ganz wenige";         break;
    case 11..20:  str="weniger als ein Viertel der";  break;
    case 21..30:  str="etwa ein Viertel der";         break;
    case 31..40:  str="weniger als die Haelfte der";  break;
    case 41..50:  str="etwa die Haelfte der";         break;
    case 51..60:  str="mehr als die Haelfte der";     break;
    case 61..70:  str="weniger als drei Viertel der"; break;
    case 71..80:  str="etwa drei Viertel der";        break;
    case 81..90:  str="mehr als drei Viertel der";    break;
    case 91..100: str="beinahe alle";                 break;
    default:      str="SEHR viele";                   break;
  }
 write("Kronang sagt: Dir fehlen noch "+str+" Erfahrungspunkte.\n");
 return "";
}

string Test1( object pl)
{
  if( pl->QueryProp(P_FROG) ) 
    return "Igitt! Ein Frosch! Hau bloss ab!\n";
  if(pl->QueryProp(P_GHOST))
       return "Keiner glaubt hier an Geister!\n";
//  call_other(BMASTER, "SetXp", pl, pl->QueryProp(P_XP)+ 50*1000);
 return 0;
}


