void Channel(string msg);

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Die Gilde der Alchemisten" );
  SetProp( P_INT_LONG, 
    "Hier ist sie also. Die Gilde der Alchemisten.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Nix interessantes. Das isn Gildenraum, keine Kunstgalerie!\n");

  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"alch_spells");

  SetProp(P_GUILD_RESTRICTIONS, 
    ([ SR_FUN: "Test1"]) );

  SetProp(P_GUILD_LEVELS,
   ([1: ([ SR_FUN: "Test1"]),
     2: ([ SR_FUN: "Test2"]),
     3: ([ SR_FUN: "Test3"]),
     4: ([ SR_FUN: "Test4"]),
     5: ([ SR_FUN: "Test5"]),
     6: ([ SR_FUN: "Test6"]),
     7: ([ SR_FUN: "Test7"]),
     8: ([ SR_FUN: "Test8"]),
     9: ([ SR_FUN: "Test9"]),
     10: ([ SR_FUN: "Test10"]),
     11: ([ SR_FUN: "Test11"]),
     12: ([ SR_FUN: "Test12"]),
    ]) );

 SetProp(P_GUILD_MALE_TITLES,
    ([ 1 : "der Alchemieanfaenger",
       2 : "der Alchemienovize",
       3 : "der Alchemieschueler",
       4 : "der Alchemielehrling",
       5 : "der Alchemiegeselle",
       6 : "der fortgeschrittene Alchemiegeselle",
       7 : "der Alchemiekenner",
       8 : "der Alchemistenanwaerter",
       9 : "der Alchemist",
       10 : "der angesehene Alchemist",
       11 : "der Profialchemist",
       12 : "der Meisterialchemist" ]));
  SetProp(P_GUILD_FEMALE_TITLES,
    ([ 1 : "die Alchemieanfaengerin",
       2 : "die Alchemienovizin",
       3 : "die Alchemieschuelerin",
       4 : "die Alchemielehrlingsmaid",
       5 : "die Alchemiegesellin",
       6 : "die fortgeschrittene Alchemiegesellin",
       7 : "die Alchemiekennerin",
       8 : "die Alchemistenanwaerterin",
       9 : "die Alchemistin",
       10 : "die angesehene Alchemistin",
       11 : "die Profialchemistin",
       12 : "die Meisterialchemistin" ]));

  AddSpell("extraktion");
  AddSpell("analyse");
/*  AddSpell("schaetz");
  AddSpell("rauchbombe");
  AddSpell("");
  AddSpell("");
  AddSpell("");
  AddSpell("");
  AddSpell("");
  AddSpell("");
  AddSpell("");
  AddSpell("");
*/
  AddExit( "gilde", "in die Abenteurergilde#/gilden/abenteurer" );

  AddCmd(({"tritt","trete"}),"treten");
  AddCmd(({"beitreten"}),"beitreten");
  AddCmd(({"austreten"}),"austreten");
  AddCmd(({ "lerne", "lern" }), "OwnLearnSpell" );
  AddCmd("austritt","austreten");
  AddCmd("beitritt", "beitreten");
  AddCmd( ({"skills", "faehigkeiten", "fertigkeiten"}), "faehigkeiten");

//  AddItem( NPC "", REFRESH_DESTRUCT);
}
