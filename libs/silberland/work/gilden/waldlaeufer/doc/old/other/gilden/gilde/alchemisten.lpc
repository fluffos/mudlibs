int austreten()
{
  object ob;
  if(!IsGuildMember(this_player()))
  {
     write("Aber Du bist doch gar kein Mitglied!\n");
     return 1;
  }
  this_player()->SetProp( P_GUILD_LEVEL, 0);
//  WLOG("/log/gilden/alchemisten", "tritt aus der Gilde aus");
  write("Ok, kleiner Alchemist. Suche Dein Glueck in anderen Gilden.\n");
  if(ob=present("alch_kasten\n", this_player()))
  {
    ob->remove();
  }
/*  call_other(ALCHMASTER, "DeleteMember", this_player());
  WLOG(LOG + getuid(this_player())+".log", "tritt aus der Alch.-gilde aus");
  Channel(capitalize(getuid(this_player()))+" ist gerade aus der "
          "Alchemistengilde ausgetreten.");
*/  return ::austreten();
}

int treten( string str)
{
  if( str=="in gilde ein" )
    return beitreten();
  if( str=="aus gilde aus")
    return austreten();
  return 0;
}

int beitreten()
{
  int b;
  if( !this_player()->QueryProp(P_TESTPLAYER) )
  {
    write("Zur Zeit duerfen nur Testspieler "
          "beitreten!\n");
    return 1;
  }
  if(IsGuildMember(this_player()))
  {
     write("Aber Du bist doch schon Mitglied!\n");
     return 1;
  }
  if( (b = ::beitreten()) < 0) return 1;
  write( "Willkommen in der Alchemistengilde!\n");
  clone_object(OBJ "kasten")->move(this_player(),M_NOCHECK);
/*  WLOG("/log/gilden/alchemisten", "tritt in die Gilde ein");
  call_other(ALCHMASTER, "AddMember", this_player());
  WLOG(LOG+getuid(this_player())+".log", "ist in die Alch.-gilde eingetreten");
  Channel(capitalize(getuid(this_player()))+
    " ist gerade in die Alchemistengilde eingetreten.");
*/  return b;
}

