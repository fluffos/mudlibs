//
// AUSGABE DER FERTIGKEITEN
//

int faehigkeiten()
{
  int i, wert;
  string *arm, s;
  mapping res;
  
  if(IS_WIZARD(this_player()))
    {
      write(BSA("Soviel hast du Magierwurschtl bisher gelernt: ", "Artyrian sagt: "));
      s="";
      res = this_player()->QueryProp(P_NEWSKILLS);
      arm=sort_array(m_indices(res), #'<); //')
	for (i = sizeof(arm)-1;i>=0;i--)
	  {
	    s += arm[i]+": ";
	    if (mappingp(res[arm[i]])) s += res[arm[i]][SI_SKILLABILITY];
	    else s += res[arm[i]];
	    s += "\n";
	    write(BSA(s, "Artyrian sagt: "));
	    s="";
	  }
      return 1;   
    }

  if(!IsGuildMember(TP))
    {
      write(BSA("Du bist kein Mitglied der Bardengilde. Willst du nicht vielleicht eines werden?", 
		"Artyrian sagt: "));
      return 1;
    }
  write(BSA("Soviel hast du bisher gelernt: ", "Artyrian sagt: "));
  s="";
  res=this_player()->QueryProp(P_NEWSKILLS);
  arm=sort_array(m_indices(res), #'<); //')
    for (i = sizeof(arm)-1;i>=0;i--)
      {
	if(arm[i]!="singen" && arm[i]!="musizieren")
	  {
	    s += CAP(arm[i])+" beherrscht Du";
	    wert=TP->QuerySkillAbility(arm[i]);   
	    s+=int2string(wert);
	    write(BSA(s, "Artyrian sagt: "));
	    s="";         
	  }
      }   
  s=int2string(TP->QuerySkillAbility("musizieren"));
  write(BSA("Du musizierst"+s,"Artyrian sagt: "));
  s=int2string(TP->QuerySkillAbility("singen"));
  write(BSA("Und Du singst"+s, "Artyrian sagt: "));
  if((wert=TP->QueryProp(P_GUILD_RATING))<1501) wert=1501;
  s=int2string(wert);
  write(BSA("Insgesamt betrachtet bist Du"+s, "Artyrian sagt: ")); 
  say(sprintf("Artyrian klaert %s ueber %se Fertigkeiten auf.\n", CAP(getuid(TP)), 
	      TP->QueryPossPronoun(WESSEN)));
  return 1;
}


// FERTIGKEITSWERT IN ENTSPRECHENDE AUSGABE UMWANDELN

string int2string(int wert)
{
 string str;
 switch(wert) 
       {
	case 0..500 : str=" zum Davonlaufen.\n";
                        break;
	case 501..1000: str=" absolut miserabel.\n"; 
                        break;
	case 1001..1500: str=" elendiglich.\n";
                        break;
	case 1501..2000: str=" sehr schlecht.\n";
                        break;
	case 2001..2500: str=" schlecht.\n";
                        break;
	case 2501..3000: str=" nicht besonders.\n";
                        break;
	case 3001..3500: str=" einigermassen passabel\n";
                        break;
	case 3501..4000: str=" passabel.\n";
                        break;
	case 4001..4500: str=" unterdurchschnittlich\n";
                        break;
	case 4501..5000: str=" durchschnittlich.\n";
                        break;
	case 5001..5500: str=" ueberdurchschnittlich.\n";
                        break;
        case 5501..6000: str=" gut.\n";
                        break;
        case 6001..6500: str=" sehr gut.\n";
                        break;
        case 6501..7000: str=" wirklich toll.\n";
                        break;
        case 7001..7500: str=" hervorragend.\n";
                        break;
        case 7501..8000: str=" ausgezeichnet.\n";
                        break;
        case 8001..8500: str=" einfach wunderbar.\n";
                        break;
        case 8501..9000: str=" exzellent.\n";
                        break;
        case 9001..9500: str=" unglaublich gut.\n";
                        break;
        case 9501..9999: str=" virtuos.\n";
                        break;
        case 10000: str=" unuebertreffbar.\n";
                        break;
        default: str=" ueberhaupt nicht.\n";
       } 
return str;
}


//
// AUSGABE BEIM LEVELAUFSTIEG
//

string NeedMoreXP(object pl, int xp)
{
  string str;
  int percent, x;
  
  str="Obwohl Du wuerdig bist, musst Du noch mehr Erfahrung sammeln. "
    +"Von den Erfahrungspunkten, die Du benoetigst, fehlen Dir ";
  x=call_other(BARDENMASTER, "GetXpDifference", pl, 
	       pl->QueryProp(P_XP));
  percent=100*x/xp;
  //write("\n"+percent+"\n");
  switch (percent)
    {
    case  0..10:  str+="nur mehr ganz wenige.";     break;
    case 11..20:  str+="weniger als ein Viertel.";  break;
    case 21..30:  str+="etwa ein Viertel.";         break;
    case 31..40:  str+="weniger als die Haelfte.";  break;
    case 41..50:  str+="etwa die Haelfte.";         break;
    case 51..60:  str+="mehr als die Haelfte.";     break;
    case 61..70:  str+="weniger als drei Viertel."; break;
    case 71..80:  str+="etwa drei Viertel.";        break;
    case 81..90:  str+="mehr als drei Viertel.";    break;
    case 91..99 : str+="beinahe alle.";             break;
    case 100    : str+="alle.";                     break;
    default:      str+="viel mehr als gefordert.";  break; 
      call_other(BARDENMASTER, "SetXp", pl, pl->QueryProp(P_XP)+ xp);
    }
  write(BSA(str, "Artyrian sagt: "));
  say(BSA(str,"Artyrian sagt zu "+CAP(getuid(pl))+": "));
  return "";
}


//
// ->>> SKILLS <<<-
//

// SKILL SINGEN LERNEN

void LearnSinging(object user, mapping sinfo, int alc)
{
  int abil, max;
  abil=sinfo[SI_SKILLABILITY];
  if(abil>max) abil=max;
  user->ModifySkill( SK_SINGING, abil);
}

// SKILL MUSIZIEREN LERNEN

void LearnMusic(object user, mapping sinfo, int alc)
{
  int abil, max;
  abil=sinfo[SI_SKILLABILITY];
  if(abil>max) abil=max;
}


// BERECHNUNG DES GILDENRATINGS

int GuildRating(object pl)
{
  mapping ski;
  string *sk, bardentyp;
  int i, cnt, sum;
  closure qsa;
  mapping barden_skills;
  string *sel_skills;
  
  barden_skills=(["alestra":({"schrei", "instrumentenkunde", "schaetzlied", "lichtschein", "feuerlied", "erkennungslied", "ruhegift", 
			      "heiligenfeuer", "schutzlied", "schlaflied", "rastelied", "satanslied", "engelslied", "blitzballade", 
			      "schreckenslied", "friedenslied", "stillebrechen", "schutzmelodie", "erneuern", "giftsymphonie",
			      "heilungslied", "erstarren", "geisterlied"}),
		 "tirena":({"schrei", "instrumentenkunde", "schaetzlied", "lichtschein", "sturmlied", "erkennungslied", "ruhegift", 
			    "heiligenfeuer", "schildlied", "schlaflied", "erholelied", "satanslied", "engelslied", "terrorballade", 
			    "schreckenslied", "friedenslied", "stillebrechen", "schildmelodie", "erneuern", "saeuresymphonie",
			    "heilungslied", "erstarren", "geisterlied"}),
		 "sarrian":({"schrei", "instrumentenkunde", "schaetzlied", "lichtschein", "terrorlied", "erkennungslied", "ruhegift", 
			     "heiligenfeuer", "panzerlied", "schlaflied", "regenerationslied", "satanslied", "engelslied", "sturmballade", 
			     "schreckenslied", "friedenslied", "stillebrechen", "panzermelodie", "erneuern", "schocksymphonie",
			     "heilungslied", "erstarren", "geisterlied"}),
		 "korriax":({"schrei", "instrumentenkunde", "schaetzlied", "lichtschein", "blitzlied", "erkennungslied", "ruhegift", 
			     "heiligenfeuer", "schallmauerlied", "schlaflied", "staerkungslied", "satanslied", "engelslied", "schockballade", 
			     "schreckenslied", "friedenslied", "stillebrechen", "schallmauermelodie", "erneuern", "horrorsymphonie",
			     "heilungslied", "erstarren", "geisterlied"})]);
  if (!IsGuildMember(pl)||!query_once_interactive(pl))
    return 0;
  
  if (pl->QueryProp(P_RACE)=="dunkelelf");
  {
    barden_skills=(["alestra":({"schrei", "instrumentenkunde", "schaetzlied", "dunkelheit", "feuerlied", "erkennungslied", "ruhegift", 
			      "heiligenfeuer", "schutzlied", "schlaflied", "rastelied", "satanslied", "engelslied", "blitzballade", 
			      "schreckenslied", "friedenslied", "stillebrechen", "schutzmelodie", "erneuern", "giftsymphonie",
			      "heilungslied", "erstarren", "geisterlied"}),
		 "tirena":({"schrei", "instrumentenkunde", "schaetzlied", "dunkelheit", "sturmlied", "erkennungslied", "ruhegift", 
			    "heiligenfeuer", "schildlied", "schlaflied", "erholelied", "satanslied", "engelslied", "terrorballade", 
			    "schreckenslied", "friedenslied", "stillebrechen", "schildmelodie", "erneuern", "saeuresymphonie",
			    "heilungslied", "erstarren", "geisterlied"}),
		 "sarrian":({"schrei", "instrumentenkunde", "schaetzlied", "dunkelheit", "terrorlied", "erkennungslied", "ruhegift", 
			     "heiligenfeuer", "panzerlied", "schlaflied", "regenerationslied", "satanslied", "engelslied", "sturmballade", 
			     "schreckenslied", "friedenslied", "stillebrechen", "panzermelodie", "erneuern", "schocksymphonie",
			     "heilungslied", "erstarren", "geisterlied"}),
		 "korriax":({"schrei", "instrumentenkunde", "schaetzlied", "dunkelheit", "blitzlied", "erkennungslied", "ruhegift", 
			     "heiligenfeuer", "schallmauerlied", "schlaflied", "staerkungslied", "satanslied", "engelslied", "schockballade", 
			     "schreckenslied", "friedenslied", "stillebrechen", "schallmauermelodie", "erneuern", "horrorsymphonie",
			     "heilungslied", "erstarren", "geisterlied"})]);   
  }  
  bardentyp=call_other(BARDENMASTER, "GetBardGroup", pl);
  sel_skills=barden_skills[bardentyp];
  if (!(ski = QueryProp(P_GUILD_SKILLS)) ||
      !(qsa = symbol_function("QuerySkillAbility",pl)))
    return 0;

  sk = m_indices(ski);
  cnt=0;
  for (i=cnt-1, sum=0; i>=0; i--) {
    if(member(sel_skills, sk[i])!=-1) {
      sum += funcall(qsa,sk[i]);
      cnt++;
    }
  }
  if(!cnt) cnt=1;
  sum = sum/cnt;
  if (sum < 0)
    sum = 0;
  else if (sum > MAX_ABILITY)
    sum = MAX_ABILITY;

  return pl->SetProp(P_GUILD_RATING, sum);
}


// AUSGABEN UND FUNKTIONEN BEIM SPELL LERNEN

int
LearnSpell(string spell) 
{
  mapping ski,restr;
  object pl;
  string res;
  mixed learn_initfunc;
  int abil,diff;
  if (!IsGuildMember(pl=this_player())) {
    _notify_fail("Du gehoerst ja gar nicht nicht zur Bardengilde!\n");
    return 0;
  }
  _notify_fail("Was moechtest Du lernen?\n");
  if (!spell)
    return SkillListe(0x01);
  spell=lower_case(spell);
  if (!(ski=QuerySpell(spell)))
    return 0;
  if (pl->QuerySkill(spell)) {
    _notify_fail("Du kannst dieses Musikstueck doch schon!\n");
    return 0;
  }
  if ((restr=ski[SI_SKILLRESTR_LEARN])
      && (res=check_restrictions(pl,restr))) {
    printf("Du kannst dieses Musikstueck noch nicht lernen.\nGrund: %s",res);
    return 1;
  }
  abil=InitialSkillAbility(ski,pl);
  if (abil<1) abil=1;
  if (abil>7500) abil=7500;
  write("Du lernst ein neues Musikstueck.\n");
  if (!(diff=GetFValueO(SI_DIFFICULTY,ski,pl)))
    diff=GetFValueO(SI_SPELLCOST,ski,pl);
  pl->ModifySkill(spell,abil,diff);
  return 1;
}

// TESTFUNKTION FUER DAS SPELLSLERNEN;
int teste_was()
{
  LearnSpell("instrumentenkunde");
  write("EINS!\n");
  LearnSpell("schrei");
  LearnSpell("hmpf");
  write("ZWEI\n");
  write("GESCHAFFT !!!\n");
  return 1;
}

//
// LOGGEN DES TASKLOESEN
//

void LogTask(object pl, int stufe)
{
  if(call_other(BARDENMASTER, "CheckTask", pl, stufe) &&
     stufe==15 && stufe==6) return;
  write_file(MEMBER_LOG(getuid(pl)+".log"),
             dtime(time())+": "+CAP(getuid(pl))+" hat Aufgabe "
             +stufe+" geloest.\n");
  return; 
}
 
