// AUFSTIEG

advancelevel(string str)
{
  string spell1, spell2, bardgroup;
  object artyrian;
  notify_fail(BSA("Hier kannst Du nur die Gildenstufe erhoehen.\n", 
		  "Artyrian sagt: "));
  if(!artyrian=present(GUILDNPC_ID, ME)) 
    {
      write("Ohne Artyrian geht das nicht!\n");
      return 1;
    }
  
  if(!str) return 0;
  if(str=="stufe" || str2attr(str))
    return 0;
  if(str=="gildenstufe" || str=="gilde")
    {
      
      // ABFRAGEN OB ER HIER UEBERHAUPT ERHOEHEN DARF (FUNKT NO NED)
      
      /*
	if (call_other(BARDENMASTER, "IsMember") == -1 ) 
	// (TP->QueryProp(P_GUILD)!="bardengilde"))
	{
	write(BSA("Dazu solltest du ja vielleicht erst den Barden beitreten!\n", 
	"Artyrian meint lachend: "));
	return 1;
	}
      */

      // HIER NOCH TASKS UND ANFORDERUNGEN CHECKEN (oder wird das wo andwers aufgerufen ?)
            
      if(TP->QueryProp(P_GUILD_LEVEL)>=12)
	{
	  if(TP->QueryProp(P_GENDER)==MALE)
	    {
	      write(BSA("Du bist doch schon ein Meisterbarde!\n", 
			"Artyrian meint: "));
	      say(BSA("Du bist doch schon ein Meisterbarde, "
		      +CAP(getuid(TP))+"!\n", "Artyrian meint: "));
	      return 1;
	    }
	  if(TP->QueryProp(P_GENDER)==FEMALE)
	    {
	      write(BSA("Du bist doch schon eine Meisterbardin!\n", 
			"Artyrian meint: "));
	      say(BSA("Du bist doch schon eine Meisterbardin, "
		      +CAP(getuid(TP))+"!\n", "Artyrian meint: "));
	      return 1;
	    }
	  return 1;
	}
 
      // HIER SOLLEN DANN DIE EINZELNEN EROEFFNUNGSSEQUENZEN
      // GELADEN WERDEN!
      
      // ARTYRIAN WIRD LEISE UND FRIEDLICH
      
      write ("1\n");
      artyrian->SetProp(P_NOATTACK,1);
      artyrian->SetProp(P_CHAT_CHANCE,0);
      
      // SPIELER STONEN NICHT VERGESSEN ;)
      
      TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:-1, PARALYZE_MSG:"", 
      PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
            
      // HIER WERDEN DIE SPELLS AUTOMATISCH GELERNT (funzt no ned)
      write("2\n");
      call_other(BARDENMASTER, "AdvanceLevel",TP);
      
      write("3\n");
      write_file(MEMBER_LOG(getuid(TP)+".log"),
		 dtime(time())+": "+CAP(getuid(TP))+" ist "
		 +"eine Stufe aufgestiegen.\n"); 
      write("4\n");
      switch(TP->QueryProp(P_GUILD_LEVEL))
	{
	case 2: 
	  LoadSequenz(LEVELSEQ("level2"), TP, CLOSURE(advancelevel2));		
	  break;
	case 3: 
	  LoadSequenz(LEVELSEQ("level3"), TP, CLOSURE(advancelevel2));
	  break;
	case 4:  
	  LoadSequenz(LEVELSEQ("level4"), TP, CLOSURE(advancelevel2));
	  break;	
	case 5:   
	  LoadSequenz(LEVELSEQ("level5"), TP, CLOSURE(advancelevel2));	
	  break;	
	case 6: 
	  LoadSequenz(LEVELSEQ("level6"), TP, CLOSURE(advancelevel2));	
	  break;	
	case 7: 
	  LoadSequenz(LEVELSEQ("level7"), TP, CLOSURE(advancelevel2));	
	  break;
	case 8:  
	  LoadSequenz(LEVELSEQ("level8"), TP, CLOSURE(advancelevel2));	
	  break;
	case 9:
	  LoadSequenz(LEVELSEQ("level9"), TP, CLOSURE(advancelevel2));	
	  break;
	case 10: 
	  LoadSequenz(LEVELSEQ("level10"), TP, CLOSURE(advancelevel2));	
	  break;
	case 11:  
	  LoadSequenz(LEVELSEQ("level11"), TP, CLOSURE(advancelevel2));	
	  break;
	case 12:
	  LoadSequenz(LEVELSEQ("level12"), TP, CLOSURE(advancelevel2));	
	  break;
	default:
	  write("BUG BEI DEN LEVELAUFSTIEGSSEQUENCEN!!! Andyl verstaendigen!\n");
	}
    }
  return 1;
}


// SPELLS LERNEN

OwnLearnSpell(string str)
{
  
  if(!present("artyrian", TO)) 
    {
      write(BS("Ohne Artyrian geht das nicht!\n"));
      return 1;
    } 
  
  if(!IsGuildMember(TP))
    {
      write(BSA("Du gehoerst ja gar nicht zu den Barden!\n"
		+"Willst Du uns vielleicht beitreten?\n", "Artyrian sagt: "));
      return 1;
    }
  
  notify_fail("Was moechtest Du hier lernen?\n");
  if(!str)
    {
      write(BSA("Welches Musikstueck moechtest du denn lernen? Du kannst mich "
		+"auch nach den Musikstuecken fragen!", "Artyrian sagt: "));
      say(BSA("Welchen Musikstueck moechtest Du lernen? Du kannst mich "
	      +"auch nach den Musikstuecken fragen!",
	      "Artyrian sagt zu "+CAP(getuid(TP))+": "));
      return 1;
    }

  if ((str=="schrei" || str=="instrumentenkunde" || str=="schaetzlied" || str=="erkennungslied" || 
       str=="ruhegift" || str=="heiligenfeuer" || str=="schlaflied" || str=="satanslied" ||
       str=="engelslied" || str=="schreckenslied" || str=="friedenslied" || str=="stillebrechen" ||
       str=="erneuern" || str=="heilungslied" || str=="erstarren" || str=="geisterlied"))
    return LearnSpell(str);
  
  
  if(str=="dunkelheit")
    {    
      if ((TP->QueryProp(P_RACE))!="dunkelelf")
	{
	  write(BSA("Dieses Musikstueck koennen nur Dunkelelfen erlernen!", "Artyrian sagt: "));
	  return 1;
	}
      else return LearnSpell(str);
    }
  
  if(str=="lichtschein") 
    {
      if ((TP->QueryProp(P_RACE))!="dunkelelf")
	{
	  return LearnSpell(str);
	}
      else
	{
	  write(BSA("Dunkelelfen koennen dieses Musikstueck nicht erlernen!", "Artyrian sagt: "));
	  return 1;
	}
    }
  
  if((str=="feuerlied" || str=="schutzlied" || str=="rastelied" || str=="blitzballade" ||
      str=="schutzmelodie" || str=="giftsymphonie"))
    {
      if ((call_other(BARDENMASTER,"GetBardGroup",TP)!="alestra"))
	{
	  write(BSA("Dieses Musikstueck koennen nur Barden von Alestra erlernen!", "Artyrian sagt: "));
	  return 1;
	}
      else return LearnSpell(str);
    }
  
  if((str=="sturmlied" || str=="schildlied" || str=="erholelied" || str=="terrorballade" ||
      str=="schildmelodie" || str=="saeuresymphonie"))
    {
      if ((call_other(BARDENMASTER,"GetBardGroup",TP)!="tirena"))
	{
	  write(BSA("Dieses Musikstueck koennen nur Barden von Tirena erlernen!", "Artyrian sagt: "));
	  return 1;    
	}
      else return LearnSpell(str);
    }
  
  if((str=="terrorlied" || str=="panzerlied" || str=="regenerationslied" || str=="sturmballade" ||
      str=="panzermelodie" || str=="schocksymphonie"))
    {
      if ((call_other(BARDENMASTER,"GetBardGroup",TP)!="korriax"))
	{
	  write(BSA("Dieses Musikstueck koennen nur Barden von Korriax erlernen!", "Artyrian sagt: "));
	  return 1;    
	}
      else return LearnSpell(str);
    } 
  
  if((str=="blitzlied" || str=="schallmauerlied" || str=="staerkungslied" || str=="schockballade" ||
      str=="schallmauermelodie" || str=="horrorsymphonie"))   
    {
      if ((call_other(BARDENMASTER,"GetBardGroup",TP)!="sarrian"))
	{
	  write(BSA("Dieses Musikstueck koennen nur Barden von Sarrian erlernen!", "Artyrian sagt: "));
	  return 1;      
	}
      else return LearnSpell(str);
    }
  return 0;
}

