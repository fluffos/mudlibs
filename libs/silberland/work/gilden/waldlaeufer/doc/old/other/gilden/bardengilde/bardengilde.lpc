#include "/gilden/bardengilde/bardengilde.h"

/* 
Alle wichtigen Funktionen sind in /std/gilden_ob.c 
definiert! 
gilden_ob.c -> gilde.c -> gilden_room.c
*/

inherit "/std/gilden_room";
inherit "/std/living/std_skills";
inherit "/gilden/obj/sequencer";

#include <properties.h>
#include <rooms.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#define BSA(x, y) break_string(x, 78, y)

int zaehler=0;
string int2string(int wert);
string bardgroup="";
void Channel(string msg);

query_prevent_shadow() { return 1; }

create()
{
  ::create();
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Artyrian");
  SetProp( P_INT_SHORT, "Der Hauptsitz der Bardengilde" ); 
  SetProp( P_INT_LONG,  "Du befindest Dich hier im Hauptsitz der Bardengilde.\n"
	   +"Es ist ein sehr schoener Ort, wenn auch ein wenig ungewoehnlich fuer eine "
	   +"Gilde. Um Dich herum sind verschiedenste Baeume in einer Kreisform "
	   +"eingepflanzt worden. Die Staemme der Baeume wurden mit einem Geflecht aus "
	   +"Zweigen verbunden, sodass das Ganze wie eine Wand wirkt. In die Wand wurden "
	   +"verschiedenfoermige Loecher geschnitten in die dann Rahmen eingebaut und "
	   +"mehrfaerbiges Glas eingesetzt wurden, sodass das Sonnenlicht durch diese "
	   +"Fenster in den verschiedensten Farben hereinscheinen kann. Ueber Dir bilden "
	   +"die Aeste eine Kuppel welche so dicht ist, dass kein Wasser durchdringen kann. "
	   +"Der Boden besteht aus nur minimal bearbeitetetn Steinplatten die einfach "
	   +"nebeneinander gelegt wurden. "
	   +"Ein paar Baumstuempfe dienen hier als Tische und Sessel. "
	   +"Im Nordosten fuehrt ein Pfad zum Gedenkhain der Bardengilde. Im Norden "
	   +"kannst du eine kleine Huette erkennen ueber der ein kleines Schild "
	   +"haengt und im Westen siehst Du einen Tempel aus Kristall."
	   +"@@maghelp@@");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE: 22]) );
  
  // ES MUSS EIN GUELTIGES SPELLBOOK FESTGELEGT WERDEN!
  
  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"barden_spells"); 
  
  // AUFNAHMEBEDINGUNGEN FUER DIE GILDE
  
  SetProp(P_GUILD_RESTRICTIONS, ([P_LEVEL: 6,    
  A_DEX  : 10 ]) );
  
  /* -----------------------------------------------------
     Fuer jede Gildenstufe (!= Spielerstufe) werden bestimmte
     Bedingungen festgelegt. Diese Bedingungen werden in Form
     eines Mappings fuer jede (!) Stufe einzelnen angegeben.
     Die Defines sind in der Gildendoku nachzulesen.
     ----------------------------------------------------- */
  
  SetProp(P_GUILD_LEVELS,
	  ([1: ([ A_DEX: 10, P_LEVEL: 6]),
	   2:  ([ SR_FUN: "Test2", A_DEX: 11, P_LEVEL: 6]),
	   3:  ([ SR_FUN: "Test3", A_DEX: 12, P_LEVEL: 10]),
	   4:  ([ SR_FUN: "Test4", A_DEX: 13, P_LEVEL: 12]),
	   5:  ([ SR_FUN: "Test5", A_DEX: 14, P_LEVEL: 16]),
	   6:  ([ SR_FUN: "Test6", A_DEX: 15, P_LEVEL: 18]),
	   7:  ([ SR_FUN: "Test7", A_DEX: 16, P_LEVEL: 22]),
	   8:  ([ SR_FUN: "Test8", A_DEX: 17, P_LEVEL: 24]),
	   9:  ([ SR_FUN: "Test9", A_DEX: 20, P_LEVEL: 28]),
	   10: ([ SR_FUN: "Test10", A_DEX: 21, P_LEVEL:32]),
	   11: ([ SR_FUN: "Test11", A_DEX: 22,  P_LEVEL: 34]),
	   12: ([ SR_FUN: "Test12", A_DEX: 23, A_INT: 21, 
 	   SM_RACE:(["Zwerg":([A_DEX:23])]),
	   SM_RACE:(["Hobbit":([A_DEX:24])]), 
	   SM_RACE:(["Elf":([A_INT:25])])]),
	   ]) );
  
  /* ---------------------------------------------------------
     Wenn der Barde/die Bardin noch kein Seher/Seherin ist, dann werden diese 
     Titel verwendet, die in Form eines Mappings angegeben 
     werden: 
     --------------------------------------------------------- */ 
  SetProp(P_GUILD_MALE_TITLES,
	  ([1 : "der Krachmacher",
	   2 : "der Instrumentenwuerger",
	   3 : "der Notenverdreher",
	   4 : "der Moechtegernmusiker",
	   5 : "der Musikschueler",
	   6 : "der Musiker",
	   7 : "der Bardengeselle", 
	   8 : "der angehende Barde", 
	   9 : "der Barde",
	   10: "der erfahrene Barde",
	   11: "der unglaubliche Barde",
	   12: "der Meisterbarde", ]));
  SetProp(P_GUILD_FEMALE_TITLES,
	  ([1 : "die Krachmacherin",
	   2 : "die Instrumentenwuergerin",
	   3 : "die Notenverdreherin",
	   4 : "die Moechtegernmusikerin",
	   5 : "die Musikschuelerin",
	   6 : "die Musikerin",
	   7 : "die Bardengesellin", 
	   8 : "die angehende Bardin", 
	   9 : "die Bardin",
	   10: "die erfahrene Bardin",
	   11: "die unglaubliche Bardin",
	   12: "die Meisterbardin", ]));
  
  // WICHTIGE INFOS FUER DEN SEQUENCER
  
  SetNames(GUILDNPC_LONGNAME ,GUILDNPC_NAME);		
  SetThirdPerson("niemand", "niemand", "niemand", "niemand");
  
  /* Tolle Details ;) */
  AddDetail(("himmel"),
	    "Du kannst den Himmel durch die Kuppel nicht sehen aber das die "
	    +"Sonne scheint kannst Du an den Sonnenstrahlen erkennen, "
	    +"die durch die vielfarbigen Fenster scheinen.\n");
  AddDetail(({"tempel", "kristall"}),
	    "Im Westen kannst Du einen Tempel aus Kristall erkennen. Vielleicht solltest "
	    +"Du ihn Dir mal ansehen.\n");
  AddDetail(("boden"),
	    "Der Boden ist mit minimal bearbeiteten Steinplatten ausgelegt.\n");
  AddDetail(({"wand", "waende", "zweige", "zweigen", "geflecht", "ganze"}),
	    "Die Wand besteht aus einem Geflecht von Zweigen welches durch "
	    +"die Baeume geflochten wurde. In die Wand wurden noch einige "
	    +"verschiedenfaerbige Fenster eingesetzt.\n");
  AddDetail(("art"),
	    "Bei dem Geflecht scheint es sich tatsaechlich um eine Art Wand zu handeln.\n");
  AddDetail(({"kuppel", "ast", "aeste"}),
	    "Die Kuppel wird durch die Aeste in den Kronen der Baeume gebildet. "
	    +"Sie ist so dicht, dass Wasser nicht durchrinnen kann.\n");
  AddDetail(({"wasser", "dach", "decke"}),
	    "Die Kuppel, welche das Dach bildet, ist so dicht, dass kein Wasser "
	    +"durchtropfen kann.\n");
  AddDetail(({"krone", "kronen", "baumkrone", "baumkronen", "hoehe"}),
	    "Die Baumkronen sind mittlerweile schon in einer beachtlichen Hoehe.\n");  
  AddDetail(({"anzahl", "baeume"}),
	    "Du siehst hier eine grosse Anzahl von Baeumen, hauptsaechlich Eichen "
	    +"Foehren und einige kristallisierte Baeume.\n");
  AddDetail(({"stamm", "staemme"}),
	    "Die Baeume rings um Dich haben ausgesprochen dicke Staemme. Die Baeume muessen "
	    +"schon ziemlich alt sein.\n");
  AddDetail(({"eiche", "eichen"}),
	    "Eichen sind so ziemlich die robustesten Baeume die Du kennst.\n");
  AddDetail(({"foehre", "foehren", "nadelbaum", "nadelbaeume"}),
	    "Die Foehren sind Nadelbaeume welche wunderschoene Foehrenzapfen haben.\n"); 
  AddDetail(({"foehrenzapfen", "zapfen"}),
	    "Die Foehrenzapfen sind wirklich sehr schoen anzuschauen.\n");
  AddDetail(({"kristallisierte baeume", "kristallisierter baum"}),
	    "Viele Baume im Kristallwald sind einst kristallisiert worden.\n");
  AddDetail(({"wald", "kristallwald"}),
	    "Du befindest Dich hier im Kristallwald.\n");
  AddDetail(({"platten", "steinplatten", "platte", "steinplatte", "verbunden", "steinarten", "Verbund"}),
	    "Es sind einfache schmucklosse Steinplatten die hier nebeneinander aufgelegt "
	    +"wurden. Sie bestehen wahrscheinlich aus einem Verbund mehrerer Steinarten.\n");
  AddDetail(({"fenster", "loch", "loecher"}),
	    "Die Fenster hier bestehen aus verschiedenfoermigen Loechern die in die Wand "
	    +"geschnitten wurden und in welche dann  verschiedenfaerbiges Glas eingesetzt "
	    +"wurde.\n");
  AddDetail(({"glas", "fensterglas", "farben", "dunkelblau", "hellrot"}),
	    "Das Glas in den Fenstern hat die verschiedensten Farben. Von Dunkelblau bis "
	    +"Hellrot ist alles vertreten.\n");
  AddDetail(({"rahmen", "fensterrahmen"}),
	    "Ohne die hölzernen Fensterrahmen wuerde das Fensterglas wohl aus "
	    +"den Loechern in der Wand herausfallen. Das waere vermutlich nicht "
	    +"unbedingt wuenschenswert.\n");
  AddDetail(({"sonnenlicht", "farbtoene", "farbtoenen"}),
	    "In allen moeglichen Farbtoenen scheint das Sonnenlicht durch die "
	    +"verschiedenfaerbigen Fenster.\n");
  AddDetail(({"sonne", "sonnenstrahl", "sonnenstrahlen", "strahl", "strahlen"}),
	    "Du kannst die Sonne zwar nicht sehen, aber ihre Sonnenenstrahlen scheinen "
	    +"Durch die Fenster in diesen Raum.\n"); 
  AddDetail(({"raum", "halle"}),
	    "Dieser Raum welchen man schon fast als Halle bezeichnen koennte ist der "
	    +"Hauptsitz der Bardengilde.\n");
  AddDetail(("norden"),
	    "Im Norden siehst du eine kleine Huette ueber der ein Schild haengt.\n");
  AddDetail(("huette"),
	    "Es ist eine einfache kleine Huette aus Eichenholz ueber der ein "
	    +"Schild haengt.\n");
  AddDetail(({"eichenholz", "holz"}),
	    "Eichenholz ist das ideale Holz fuer eine Huette, da es sich sehr lange "
	    +"haelt und ausserst robust ist.\n");
  AddDetail(("schild"),
	    "Du kannst es lesen.\n");
  AddReadDetail(("schild"),
		"\n"
		+"+------------------------+\n"
                +"|                        |\n"
                +"|  << Brabo Glasfuss >>  |\n"
                +"|                        |\n"
                +"| Instrumentenverkauf,   |\n"
                +"| Reparatur und Beratung |\n"
                +"|                        |\n"
		+"+------------------------+\n");
  AddDetail(("nordosten"),
	    "Im Nordosten fuehrt ein Pfad zum Gedenkhain der Bardengilde.\n");
  AddDetail(("pfad"),
	    "Der Pfad fuehrt zum Gedenkhain der Bardengilde.\n");
  AddDetail(({"gedenkhain", "hain"}),
	    "Im Nordosten befindet sich der Gedenkhain der Bardengilde.\n");
  AddDetail(({"hauptsitz", "sitz", "bardengilde", "gilde"}),
	    "Du befindest Dich hier im Hauptsitz der Bardengilde.\n");
  AddDetail(("ort"),
	    "Dieser wunderschoene Ort hier ist der Hauptsitz der Bardengilde.\n");
  AddDetail(({"baumstuempfe", "baumstumpf", "stumpf", "stuempfe", "sessel", "tische"}),
	    "Ein paar Baumstuempfe dienen hier als Sessel und Tische. An einem Tisch kannst "
	    +"du ein paar Schnitzereien entecken.\n");
  AddDetail(("tisch"),
	    "Auf dem Tisch sind ein paar Schnitzereien zu entdecken.\n");
  AddDetail(({"schnitzerei", "schnitzereien", "gestalten", "goettin"}),
	    "Die Schnitzerei zeigt eine Goettin und darunter vier verschieden grosse "
	    +"Gestalten die zu ihr hochblicken. Was kann das wohl darstellen?\n");
  AddDetail(({"kreisform", "kreis"}),
	    "Die Baeume welche auch die Waende des Raumes bilden sind in einer "
	    +"Kreisform angepflanzt worden.\n");
  /* Sound'n Smells */
  AddSound( DEFAULT_SOUND,
	    "Du hoerst leisen Gesang aus dem Westen.\n");
  AddSound(({"gesang", "westen"}),
	   "Der Gesang scheint aus dem Tempel zu kommen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier angenehm nach Wald.\n");
  AddSmell(({"wald", "waldgeruch"}),
	   "Dieser Waldgeruch ist aeusserst angenehm. So richtig erfrischend.\n");
  
  /* EVENTUELLE SKILLS WERDEN EBENFALLS MAL DEFINIERT: */
  AddSkill(SK_SINGING, ([ SI_SKILLABILITY:1]));
  AddSkill(SK_MUSIC, ([ SI_SKILLABILITY:1]));
  
  AddItem(NPC("artyrian"), REFRESH_DESTRUCT);
  AddItem(OBJ("tafel"), REFRESH_DESTRUCT);
  RemoveItem( "/obj/zeitungsautomat");
  AddExit("westen", ("/gilden/bardengilde/room/tempel.lpc"));
  AddExit("suedwesten", ("/gilden/abenteurer.lpc"));
  AddExit("nordosten", ("/gilden/bardengilde/room/hain.lpc"));
  AddExit("norden", ("/gilden/bardengilde/room/ishop.lpc"));
  
  AddCmd(({"tritt","trete"}),"tritt");
  AddCmd(({ "lerne", "lern" }), "OwnLearnSpell" );
  AddCmd("austritt", "leave");
  AddCmd("beitritt", "falscher_syntax");
  AddCmd( ({"fertigkeiten"}), "faehigkeiten");
  AddCmd("gilde", "magfunc");
  AddCmd("topliste", "topliste");
  AddCmd("erhoehe", "advancelevel");
 
  // TESTCOMMANDO FUER DIE SEQUENZEN DER BARDENGILDE
  
  AddCmd(({"lade", "lad"}), "lade_was");
  
  // TESTCOMMANDO FUER DAS SPELLLERNEN
  AddCmd("test", "teste_was");
 
  /* ---------------------------------------------------------
     Die gueltigen Spells des Spellbooks muessen auch im Gilden-
     object definiert werden:
     --------------------------------------------------------- */
  
  AddSpell("instrumentenkunde");
  AddSpell("schrei");
  AddSpell("schaetzlied");
  AddSpell("lichtschein");
  AddSpell("dunkelheit");
  AddSpell("feuerlied");
