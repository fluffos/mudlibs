#include <properties.h>
#include <language.h>
#include <defines.h>
#define LOG(x) "d/unterwelt/hexenkonvent/amazora/log/" + x
inherit "std/npc";
create(){
    if(!is_clone(ME))return;
    ::create();
    SetProp(P_SHORT, "Katherina Schraderin");
    SetProp(P_LONG, break_string("Das ist Katherina Schraderin. Eine weise alte Hexe. Sie ist die Hohepriesterin vom Hexenkonvent. Sie erledigt alle Antraege und Konventsbeitritte. Wenn Du etwas ueber den Hexenkonvent wissen willst, kannst Du sie fragen, sie wird Dir gern mit Rat und Tat zur Seite stehn.", 78));
    SetProp(P_NAME, "Katherina");
    SetProp(P_GENDER, 2);
    AddId("katherina");
    AddId("kraeuterhexe");
    AddId("hexe");
    AddId("frau");
    create_default_npc(20);
    set_living_name("katherina");
    SetProp(P_BODY, 100);
   SetProp(P_HANDS, ({" mit der Macht Liliths", 100}));
SetProp(P_ALIGN, 1000);
    SetProp(P_ARTICLE, 0);
    SetProp(P_RACE, "Mensch");
    SetProp(P_XP, 2000);
    SetProp(P_LOG_INFO, 1);
    SetProp(P_DEFAULT_INFO, "sagt: Frag Amazora!\n");
    AddInfo("hexensabat", break_string(
"Er findet auf dem Blocksberg statt oder an versteckten, unheimlichen Orten wie Friedhoefen, Ruinen oder einsam gelegenen Wiesen. Auf den Hexensabatten ist alles erlaubt was Spass macht. ", 78));
    
  }
    Defend(dam, dam_type, spells, enemy)
    {
        if(enemy->QueryProp(P_POISON)<10){
            enemy->SetProp(P_POISON, enemy->QueryProp(P_POISON)+1);
            write("Katharina vergiftet Dich.\n");
        }
     return ::Defend(0, dam_type, spells, enemy);
    }
void die(int poisondeath)
{
  write_file(LOG("katharina.kills"),
    ctime()+": "+CAP(getuid(PL))+" killt Katharina. Kann nicht sein!\n");
  ::die(poisondeath);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("katherina.deads"),
    ctime()+": Katherina hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

