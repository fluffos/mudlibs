#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <new_skills.h>
#include "d/unterwelt/amazora/hexenkonvent/gilde.h"
inherit "std/npc";

string beurteilung();
string erhoehen();
void tell_player( string s, object pl);

create()
{
  if (!is_clone(this_object())) return;
  ::create();
SetProp(P_SHORT, "Lilith die Meisterin der Hexen");
  SetProp(P_LONG, 
   SetProp(P_NAME, "Lilith");
SetProp(P_GENDER, 1);
SetProp( P_ARTICLE, 0);
create_default_npc( 20);
  SetProp(P_MAX_HP, 1000);
  SetProp(P_XP, 1250000);
  SetProp(P_ALIGN, 100);
  SetProp(P_SIZE, 210);
  SetProp(P_HANDS, ({" mit der Frauenpower", 250 }));
  SetProp(P_BODY, 210);
  SetProp(P_RACE, "Mensch");
  SetProp( P_DEFAULT_INFO, "sagt: Frag mal Katherina.\n");
  AddId(({ "meisterin", "lilith", "hexe" }));
  SetAttackChats( 60, ({ "@@auffe_schnauze@@" }));
set_living_name( "lilith" );
  
AddInfo( "lilith",
"Ja?", "sagt: ");
AddInfo(({ "gilde" }),
"Im Hexenkonvent wird nur jemand aufgenommen, der unsere Religion "+
"vertritt. Eine gewisse Liebe zur Natur ist dafuer schon noetig. Nur "+
"dann kann man mit der maechtigen Magie der Natur "+
"umgehen. Die Natur kann Dich beschuetzen aber auch toeten! "+
"Du kannst der Gilde mit 'trete gilde bei' beitreten.", 
"sagt: " );
AddInfo( "magier",
"Magier sind doof und stinken!", "sagt: ");
AddInfo(({ "nachtblind", "nachtblindheit" }),
"Wenn die Nachtsicht nachlaesst, dann kann man fuer einige Zeit keinen "+
"neuen Nachtsichtzauber sprechen. Man ist solange nachtblind. Je hoeher "+
"deine Stufe in der Gilde ist, umso kuerzer ist diese Zeit.", "sagt: ");
AddInfo(({ "ziele", "ziel" }),
"Unsere Ziele sind es, die Naturgesetze zu befolgen.", "sagt: ");
AddInfo( "grundeinstellung",
"Du musst schon eine gewisse Liebe zur Natur haben, um in unserer Gilde aufgenommen zu werden.",
"sagt: ");
AddInfo( "amazora",
"Amazora ist die Magierin die diese Gilde ghier erschaffen hat..", "sagt: ");
AddInfo( "katherina",
"Katherina ist die wichtigste in dieser Gilde. "+
"Sie erledigt den ganzen Verwaltungskram. "+,
"sagt: ");
AddInfo( "verwaltungskram",
"Fuer den Verwaltungskram ist Katherina zustaendig.", "sagt: " );
AddInfo(({ "magie", "religion", "naturgesetze", "natur", "glauben", "naturglauben" }),
"Also es gibt fuer uns praktisch nur eine Religion: Die Natur. "+
"Wir haben uns praktisch total dem Naturglauben verschrieben. Das ist unsere Religion. "+
"Wir befolgen die Naturgesetze. Sie kann sehr maechtig sein. Sie kann Dich heilen, Dich beschuetzen, "+
"aber sie kann Dich auch toeten. Huete Dich!",
"sagt: " );
AddInfo(({ "lernen", "lerne" }),
"Mit 'lerne' erhaelst Du eine Liste aller Zaubersprueche dieser Gilde. "+
"Du kannst mich dann zu jedem dieser Zaubersprueche befragen, ich kenne "+
"sie alle.", "sagt: ");
AddInfo(({ "zauberspruch", "zaubersprueche", "spruch", "sprueche", "spells",  
        "zauberspruechen", "zauber", "zauberei", "spruechen", "zaubern" }),
"Du kannst mit 'lerne <name>' die Zaubersprueche lernen, wenn Du die "+
"entsprechende Gildenstufe erreicht hast. Zu den Gildenstufen kann Dir "+
"Katherina mehr sagen, aber ich kann Deine Zauber-Faehigkeiten beurteilen.",
 "sagt: ");
AddInfo(({ "faehigkeiten", "faehigkeit", "zauberfaehigkeit", "koennen",
        "zauberfaehigkeiten", "beurteilung", "beurteilen", "status",
        "beherrschung" }),
        "@@sag_beurteilung@@" );
AddInfo(({ "anforderungen", "anforderung", "eintritt", "aufnahme", "antrag",
        "eintreten", "beitreten", "beitritt", "stufe", "stufen", "level",
        "gildenstufe", "gildenstufen", "bedingungen", "bedingung", "gildentitel", 
        "gildenlevel", "aufnahmebedingungen", "aufnahmebedingung", "titel", 
        "gilden-titel", "anmeldung" }),
"Frag mal Katherina, die ist dafuer zustaendig.", "sagt: ");
AddInfo(({ "erhoehung", "erhoehen", "erhoehe", "stufenerhoehung", 
        "gildenerhoehung", "gildenstufenerhoehung", "aufsteigen", "aufstieg", 
        "eignung", "erfordernis", "erfordernissen" }), 
        "@@erhoehen@@", "sagt: ");
AddInfo(({ "aufgabe", "aufgaben" }),
"Um eine Stufe zu erhoehen muss jedes Mitglied eine Pruefung und in "+
"manchen Stufen auch eine besondere Aufgabe loesen und bestehen. Dies "+
"wird dir in den Anforderungen zur Erhoehung erklaert.", "sagt: ");
}


void catch_tell( string str)
{
  int zeit;
 string spieler, was, s, bla, blub;
  object pl;
  npc::catch_tell(str);
  str = lower_case( str);
  if( !sscanf( str, "%s teilt dir mit: %s", spieler, was)) return;
  if( !pl = find_player( spieler)) return;
  was = was[0..<2];
  if( was == "beurteilung" || was == "faehigkeit" || was == "faehigkeiten"
    || was == "zauberfaehigkeit" || was == "zauberfaehigkeiten" ||
    was == "koennen" )
  {
    s = "Lilith teilt Dir mit:\n";
    s += beurteilung();
    call_out( "tell_player", 0, s, pl );
  }
  if( was == "erhoehen" || was == "erhoehung" || was == "aufsteigen" 
    || was == "stufenerhoehung" || was == "anforderung" )
  {
    s = break_string( erhoehen(), 78, "Lilith teilt Dir mit: ");
    call_out( "tell_player", 0, s, pl);
 }
  if( sscanf( was, "%smeld%s", bla, blub ) == 2)
  {
    if( this_player()->QueryProp( P_GUILD) != "hexenkonvent" ) 
    {
      s = "Lilithteilt Dir mit: Du bist keine Hexe!\n";
      call_out( "tell_player", 0, s, pl );
      return;
    }
    if( this_player()->QueryProp( P_GUILD_LEVEL) < 11) 
    {
      s = "Lilith teilt Dir mit: Du bist keine Hexe!\n";
      call_out( "tell_player", 0, s, pl );
      return;
    }
string erhoehen()
{
int level;
string bla;
if( this_player()->QueryProp( P_GUILD) != "hexenkonvent" )
        return "Du gehoerst nicht dieser Gilde an!";


