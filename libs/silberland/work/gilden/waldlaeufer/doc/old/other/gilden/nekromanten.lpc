void Channel(string msg);

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Die Gilde der Nekromanten" );
  SetProp( P_INT_LONG, 
    "Hier ist sie also. Die Gilde der Nekromanten. "
    "Alles ist duester und schwarz und... *laberfasel*");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Nix interessantes. Das isn Gildenraum, keine Kunstgalerie!\n");

  AddItem("/d/ebene/trogor/npc/fee", REFRESH_DESTRUCT, (["mnpc_flags":0]));

  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"nekro_spells");

  SetProp(P_GUILD_RESTRICTIONS, 
    ([ SR_FUN: "Test1"]) );

  SetProp(P_GUILD_LEVELS,
   ([1: ([ SR_FUN: "Test1"]),
     2: ([ SR_FUN: "Test2"]),
     3: ([ SR_FUN: "Test3"]),
     4: ([ SR_FUN: "Test4"]),
     5: ([ SR_FUN: "Test5"]),
     6: ([ SR_FUN: "Test6"]), 
     7: ([ SR_FUN: "Test7"]),
     8: ([ SR_FUN: "Test8"])
    ]) );

 SetProp(P_GUILD_MALE_TITLES,
    ([ 1 : "der Hobbynekromant",
       2 : "der Leichenfresser",
       3 : "der Verpester",
       4 : "der Totenbeschwoerer",
       5 : "der Nekromant",
       6 : "der Meisternekromant",
       7 : "der Todesengel",
       8 : "der Untote" ]));
 SetProp(P_GUILD_FEMALE_TITLES,
    ([ 1 : "die Hobbynekromantin",
       2 : "die Leichenfresserin",
       3 : "die Verpesterin",
       4 : "die Totenbeschwoererin",
       5 : "die Nekromantin",
       6 : "die Meisternekromantin",
       7 : "die Todesengelin",
       8 : "die Untote" ]));

  AddSkill( FIGHT(WT_WHIP), 
    ([ SI_SKILLFUNC: "Peitschenkampf", SI_DIFFICULTY: 100 ]) );
  AddSkill( SK_NIGHTVISION, ([ SI_SKILLABILITY: 10000 ]) );

  AddSpell("identifiziere", ([SI_SPELLBOOK:"ab_spells",
                              SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:2])]));
  AddSpell("schaetz", ([SI_SPELLBOOK:"ab_spells"]));
  AddSpell("verpeste");
  AddSpell("verfluche");
  AddSpell("beschwoere");
  AddSpell("beherrsche");
  AddSpell("kannibalismus");
  AddSpell("kreische");
  AddSpell("faeulnis");
  AddSpell("terror");
  AddSpell("todesgesang");
  AddSpell("eiterhuelle");
  AddSpell("seelenfrass");
//  AddSpell("spioniere");

  AddExit( "gilde", "in die Abenteurergilde#/gilden/abenteurer" );

  AddCmd(({"tritt","trete"}),"treten");
  AddCmd(({"beitreten"}),"beitreten");
  AddCmd(({"austreten"}),"austreten");
  AddCmd(({ "lerne", "lern" }), "OwnLearnSpell" );
  AddCmd("austritt","austreten");
  AddCmd("beitritt", "beitreten");
  AddCmd( ({"skills", "faehigkeiten", "fertigkeiten"}), "faehigkeiten");

//  AddItem( NPC "", REFRESH_DESTRUCT);
}

int austreten()
{
  object ob;
  if(!IsGuildMember(this_player()))
  {
     write("Aber Du bist doch gar kein Mitglied!\n");
     return 1;
  }
  this_player()->SetProp( P_GUILD_LEVEL, 0);
//  WLOG("/log/gilden/alchemisten", "tritt aus der Gilde aus");
  write("Ok, kleiner Nekromant. Suche Dein Glueck in anderen Gilden.\n");
  return ::austreten();
}

int treten( string str)
{
  if( str=="in gilde ein" )
    return beitreten();
  if( str=="aus gilde aus")
    return austreten();
  return 0;
}

int beitreten()
{
  int b;
  if( !this_player()->QueryProp(P_TESTPLAYER) )
  {
    write("Zur Zeit duerfen nur Testspieler "
          "beitreten!\n");
    return 1;
  }
  if(IsGuildMember(this_player()))
  {
     write("Aber Du bist doch schon Mitglied!\n");
     return 1;
  }
  if( (b = ::beitreten()) < 0) return 1;
  write( "Willkommen in der Nekromantengilde!\n");

  if(!(TP->QuerySkillAbility(FIGHT(WT_WHIP))))
    TP->ModifySkill(FIGHT(WT_WHIP), 
        QuerySkill(FIGHT(WT_WHIP))+([SI_SKILLABILITY:10 ]), 100,"nekromanten");

    TP->LearnSkill(SK_NIGHTVISION);
    TP->ModifySkill(SK_NIGHTVISION, 
        TP->QuerySkill(SK_NIGHTVISION)+([SI_SKILLABILITY:10000]),0,"nekromanten");


  return b;
}

