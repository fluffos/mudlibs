void all_spells()
{
  write(
    "Du kannst hier folgende Faehigkeiten lernen:\n"
    "Niemand sagt: ???   : Ab Gildenstufe 1.\n");
}

mixed OwnLearnSpell(string str)
{

  if(!IsGuildMember(this_player()))
  {
    write( "Du bist kein Mitglied dieser Gilde!\n");
    return 1;
  }
  notify_fail("Was moechtest Du hier lernen?\n");

  if(!str)
  { 
    all_spells();
    return 1;
  }
  return LearnSpell(str);
}


mapping Peitschenkampf(object player, string skill, mapping sinfo)
{ 
  int abil, ud, val;

  ud=sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  val = (3* player->QueryAttribute(A_DEX) +  player->QueryAttribute(A_STR) +
         2*player->QueryProp(P_GUILD_LEVEL) ) * abil / MAX_ABILITY;

  DB("Ohne Skill: "+sinfo[SI_SKILLDAMAGE]);
  sinfo[SI_SKILLDAMAGE] += random(val);
  DB("Mit Skill: "+sinfo[SI_SKILLDAMAGE]);
  if (++ud > abil/50) 
  {
    DB("GELERNT!");
    ud = 0;
    abil += random(player->QuerProp(P_GUILD_LEVEL)) + 
            player->QueryAttribute(A_DEX)/3;
  }

  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  player->ModifySkill( FIGHT(WT_WHIP), ([ SI_USR: ud, SI_SKILLABILITY: abil ]),
                       sinfo[SI_DIFFICULTY], "nekromanten");
  return sinfo;
}


string Test1( object pl)
{
  if( pl->QueryProp(P_FROG) ) 
    return "Igitt! Ein Frosch! Hau bloss ab!\n";
  if(pl->QueryProp(P_GHOST))
       return "Keiner glaubt hier an Geister!\n";
//  call_other(BMASTER, "SetXp", pl, pl->QueryProp(P_XP)+ 50*1000);
 return 0;
}


