inherit "std/thing";
#include "../def.h"
#include "/spellbooks/waldlaeufer/std/restrictions.lpc"

#define NONE 0
#define BLUE 3
#define VIOLETT 9

//#define DBW(x) if (find_player("wraz")) tell_object(find_player("wraz"),(x))

int counter, type, time, is_collapsed, triggeredThisRound;
object owner, weapon;
mixed *bonus;

//** StandardFunktionen ****************************************************//
//-- Create eines typischen Invisobjekts -------------------------------------
void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_GENDER, FEMALE); 
  AddId(FLAME_CONTROL_ID);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_KILL_NAME, "Die Gier nach dem Sieg");
  counter=0;
  type=NONE;
  bonus=({});
}

//-- Remove, alles moegliche rueckgaengig machen -----------------------------
int remove()
{
  object ob;
  string s;
  
  if(objectp(ob=ENV(TO)))
  {
    ob->SetProp(P_PARALYZED, 0);
    ob->SetProp(P_TMP_DIE_HOOK, 0);
    ob->SetProp(P_TMP_ATTACK_HOOK, 0);
    ob->SetProp(P_TMP_MOVE_HOOK, 0);
    ob->SetProp(P_TMP_DEFEND_HOOK, 0);
    ob->UpdateAttributes();
    if(weapon) {weapon->Set(P_CURSED, 0, F_QUERY_METHOD);}
   
    s = owner->QueryProp(P_RANGER_ACTIVE_SPELLS);
    if(!stringp(s)) s = "";
    s = clear_bit(s, TB_EBER_TRANCE);
    owner->SetProp(P_RANGER_ACTIVE_SPELLS, s);
  }
  return ::remove(1);  
}

//-- Der Reset (sollte es eigentlich nie erleben) ----------------------------
void reset() { 
  if (!is_clone(TO)) return;
  remove();
}
  
//-- Anpassung ---------------------------------------------------------------
int customize(int ability, int success, int t, int skp)
{
  int rounds, maxAtrriBonus, i, roundAttriBonus, roundDamageBonus, maxDamage;
  string s;

  //DBW(sprintf("eber_trance :: customize :: ability=%d success=%d t=%d skp=%d\n", ability, success, t, skp));
  
  if(!objectp(ENV(TO))) {
    remove();
    return 0;
  }
  
  owner=ENV(TO);
  time=t; 
  is_collapsed=0;
  call_out("collapse", 1+t-time(), "Die Wildheit des Ebers versiegt und du brichst erschoepft zusammen!");
  
  rounds = MAX_FLAME_ROUNDS*(ability+success)/20000;
  rounds += rounds * SPELL_BONUS(owner, "trance des wilden ebers") / 100;

  // der Schadensbonus und Effekte steigen verteilt ueber die runden
  maxAtrriBonus =  ability/2000 + success/2000;
  maxAtrriBonus += maxAtrriBonus * SPELL_BONUS(owner, "trance des wilden ebers") / 100;
  if(maxAtrriBonus>rounds/2) maxAtrriBonus = rounds/2; // maximal bis zur halben wirkundsdauer steigen und dann wieder abfallen

  maxDamage = ability/100 + success/100;

  pDebug(owner, sprintf("eber_trance :: customize :: rounds=%d maxAttri=%d maxDamage=%d\n", rounds, maxAtrriBonus, 100+maxDamage));

  roundAttriBonus = 0;
  roundDamageBonus = 0;
  for(i=0; i<rounds; ++i) {
    if(roundAttriBonus<maxAtrriBonus) roundAttriBonus++; // die ersten runden steigen
    if(roundAttriBonus>=maxAtrriBonus && i >= rounds-maxAtrriBonus) roundAttriBonus--; // die letzten runden wieder abfallen
    if(i<rounds/2 && roundDamageBonus < maxDamage) roundDamageBonus += SPELL_DAMAGE_BONUS(owner, "trance des wilden ebers", 10);
    else roundDamageBonus -= 10;
    
    if(roundAttriBonus<0) roundAttriBonus = 0;
    if(roundDamageBonus<0) roundDamageBonus = 0;

    bonus += ({ ({roundAttriBonus, 100+roundDamageBonus}) });
  }

  // noch ein eintrag ale bonus buffer
  bonus += ({ ({0, 100}) });
  
  counter = rounds;
  if(counter>sizeof(bonus)) counter=sizeof(bonus);

  s = owner->QueryProp(P_RANGER_ACTIVE_SPELLS);
  if(!stringp(s)) s = "";
  s = set_bit(s, TB_EBER_TRANCE);
  owner->SetProp(P_RANGER_ACTIVE_SPELLS, s);
  owner->SetProp(P_RANGER_TRANCE_ROUND, 0);

  return 1;
}

//-- Testfunktion ------------------------------------------------------------

mixed QueryBonus() {
  return bonus;
}

mixed QueryCounter() {
  return counter;
}

//**************************************************************************//



//** Der Zusammenbruch *****************************************************//
//-- Der eigentliche Zusammenbruch -------------------------------------------
void collapse(string msg)
{
  int t;
  
  if(!objectp(owner)) {
    remove();
    return;
  }

  if(is_collapsed) return;

  is_collapsed=1;

  t=30-(owner->QueryProp(P_GUILD_LEVEL));
  if(t < 5) t=5;

  tell_room(ENV(owner),BS(owner->Name(WEN, 1)+" scheint ploetzlich von aller Wildheit "
                         "verlassen und "+owner->name(WER, 1)+" sackt kraftlos zusammen."), ({owner}));
  tell_object(owner, BS(msg));

  owner->SetProp(P_DISABLE_SPELLS, t);
  owner->SetProp(P_DISABLE_ATTACK, t);
  owner->SetProp(P_PARALYZED, ([PARALYZE_TIME: t/2,
                                PARALYZE_MSG: BS("All deine Kraft ist aufgebraucht. Du kannst dich nicht ruehren."),
                                PARALYZE_MSG_OTHER: "%s liegt zitternd am Boden.\n",
                                PARALYZE_END: "Deine Muskeln kommen wieder zu Kraeften und du stehst auf.\n",
                                PARALYZE_END_OTHER: "%s steht auf.\n"]));
  owner->do_exhaust(t*50, 1);

  SetProp(P_X_ATTR_MOD, ([A_STR: -10, A_DEX: -10]));
  owner->UpdateAttributes();
  call_out("endMsg", t);
}

public void endMsg() {
  tell_object(owner, "Dein Koerper hat sich beruhigt und wieder Kraft gesammelt.");
  tell_object(ENV(owner), BS(owner->Name(WER)+" hat sich wieder erholt."));
  SetProp(P_X_ATTR_MOD, 0);
  owner->UpdateAttributes();
  remove(1);
  return;
}

//-- ein Test ob noch im Kampf -----------------------------------------------
void fight_test()
{
  //DBD("\n~~~~~~~~~~ Aufgerufen ~~~~~~~~~~~~~\n");
  if(!objectp(owner)) {remove(); return;}
  if(!(owner->InFight())) { 
    collapse("Der Kampf ist beendet, die Wildheit des Ebers verlaesst dich."); 
    return;
  }
  return;
}

//-- Die Bedingungen gesammelt (ausser counter und InFight) ------------------
int collapse_test() {
  object *enemies;
  int i;
  
  if(!objectp(owner)) {
    remove(); 
    return 0;
  }
  
  if(time() >= time) {
    collapse("Die Wildheit des Ebers ist aufgebraucht. Erschoepft brichst du zusammen");
    return 0;
  }

  if(sizeof(enemies=owner->PresentEnemies()) < 1) { 
    collapse("Wuetend heulst du auf! Hier ist kein Feind mehr, den du bezwingen kannst!");
    return 0;
  }

  return 1;
}
//**************************************************************************//



//** Hooks *****************************************************************//
//-- Diese Funktion wird bei jedem Attack() des spielers aufgerufen ----------
mixed attack_hook(object enemy)
{
  int i, d, round;
  object *enemies;
  mixed dts;

  if(triggeredThisRound) return 1;
  if(!objectp(owner)) return 0;

  round = owner->QueryProp(P_RANGER_TRANCE_ROUND);
  if(round >= sizeof(bonus)) round = sizeof(bonus) - 1;

  SetProp(P_X_ATTR_MOD, ([A_STR: bonus[round][0], A_DEX:bonus[round][0]]));
  owner->UpdateAttributes();
  owner->ModifySkillAttribute(owner, SA_DAMAGE, bonus[round][1], 2);

  pDebug(owner, sprintf("eber_trance :: round=%d/%d attriBonus=%d damageBonus=%d\n", round, counter, bonus[round][0], bonus[round][1]));

  call_out("fight_test", 4);
  if(!collapse_test()) {return 0;}
  if(round>=counter) { 
    collapse("Die Wildheit des Ebers ist versiegt. Erschoepft brichst du zusammen!");
    return 0;
  }

  owner->SetProp(P_RANGER_TRANCE_ROUND, ++round);
  return 1;
}
//**************************************************************************//