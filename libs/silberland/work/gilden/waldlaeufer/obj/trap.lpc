#include "../def.h"
inherit "std/thing";

int ausloesen(string str);
int stolpern(int counter);

object owner;
int mode, abil, aktiv, owner_ges, giftskill, skill, bonus;

#define M_NORMAL 0
#define M_FESSELFALLE 1
#define M_FANGFALLE 2
#define M_STOLPERDRAHT 3
#define M_PFEILFALLE 4

//** StandardFunktionen ****************************************************//
//-- normales Create() -------------------------------------------------------
void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, "Falle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({FALLE_ID, "falle"}) );
  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 100+random(600));
  SetProp(P_SIZE, 50+random(20));
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  aktiv=1;  
  mode=M_NORMAL;
}

//-- Remove mit eigener Meldung ----------------------------------------------
int remove(int silent)
{
  if(!silent)
  { if(ENV(TO)) tell_room(ENV(TO), BS(Name(WER, 1)+" faellt auseinander.")); }
  return ::remove(1);
}

//-- Der reset beseitigt spaetestens die Falle -------------------------------
void reset() {remove(0); return;}

//-- Wem gehoert die Falle ---------------------------------------------------
mixed QueryOwner() {if(owner) {return owner;} return 0;}

//**************************************************************************//



//** Anpassung der Fallen **************************************************//
//-- Fesselfalle -------------------------------------------------------------
int Fesselfalle(object caster, int ability)
{
  if(!caster || !ENV(TO) || (mode!=M_NORMAL) ) { remove(1); return 0;}

  owner=caster; 
  mode=M_FESSELFALLE;
  abil=ability;
  bonus = call_other(GUILD_SPELLBOOK, "get_equip_bonus", caster, "fesselfalle");

  AddCmd("loes|loese&falle|fesselfalle&aus"
        ,CLOSURE(ausloesen)
        ,"Was willst Du ausloesen?|Welche Falle willst Du ausloesen?");
        
  //Aeusserlichkeiten
  SetProp(P_SHORT, "Eine Fesselfalle");
  SetProp(P_LONG,  "Eine Falle wie sie typisch ist fuer die Waldlaeufer. Ein "
                   "paar Seile und Ranken wurden mit Holzpfloecken ueber den "
                   "Boden gespannt. Wenn der Waldlaeufer im richtigen Moment "
                   "das richtige Seil durchtrennt, kann er damit ein "
                   "Lebewesen in dem Gemisch aus Ranken und Seilen fesseln.");
  SetProp(P_NAME, "Fesselfalle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({FESSELFALLE_ID, "fesselfalle"}) );
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:20, MAT_MISC_HERBAL:80]) );
  
  return 1;
}

//-- Fangfalle ---------------------------------------------------------------
int Fangfalle(object caster, int ability)
{
  if(!caster || !ENV(TO) || (mode!=M_NORMAL) ) { remove(1); return 0;}
  owner=caster; mode=M_FANGFALLE; abil=ability;

  bonus = call_other(GUILD_SPELLBOOK, "get_equip_bonus", caster, "fangfalle");

  AddCmd("loes|loese&falle|fangfalle&aus"
        ,CLOSURE(ausloesen)
        ,"Was willst Du ausloesen?|Welche Falle willst Du ausloesen?");
        
  //Aeusserlichkeiten
  SetProp(P_SHORT, "Eine Fangfalle");
  SetProp(P_LONG,  "Im Boden stecken einige kleine Messer und angespitze "
                   "Aeste. Eine giftgruene Fluessigkeit schimmert auf einigen"
                   " Spitzen. Ein groesserer Ast liegt ueber der kleinen "
                   "Grube. Wenn der Waldlaeufer den Ast entfernt, bricht das "
                   "Opfer ein und wird sich sicherlich verletzen.");
  SetProp(P_NAME, "Fangfalle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({FANGFALLE_ID, "fangfalle"}) );
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:60, MAT_MISC_HERBAL:20, MAT_STEEL:20]));
    
  return 1;
}

//-- Stolperdraht ------------------------------------------------------------
int Stolperdraht(object caster, int ability)
{
  if(!caster || !ENV(TO) || (mode!=M_NORMAL) ) { remove(1); return 0;}
  owner=caster; mode=M_STOLPERDRAHT; abil=ability;
  bonus = call_other(GUILD_SPELLBOOK, "get_equip_bonus", caster, "stolperdraht");
  owner_ges=owner->QueryAttribute(A_DEX);
  AddCmd("aktiviere|spanne|spanne&draht|draehte|stolperdraht|stolperdraehte"
        ,CLOSURE(ausloesen)
        ,"Was willst Du ausloesen?|Welche Falle willst Du ausloesen?");  
  AddCmd("loese|loes&draht|stolperdraht|stolperdraehte|draehte&aus", CLOSURE(ausloesen), "Welche Falle willst du ausloesen?");
  //Aeusserlichkeiten
  SetProp(P_SHORT, "Hier ist ueberall Stolperdraht gespannt");
  SetProp(P_LONG,  "Aus duenne, gruen gefaerbten Draht und kleine Ranken, die"
                   " ueber einige Holzpfaehle gespannt wurden, hat hier ein "
                   "Waldlaeufer diese Stolperdrahtfalle errichtet. Jeder der "
                   "ueber so einen Draht stolpern kann, wird dies vermutlich "
                   "im Kampfgetuemmel tun.");
                   //keine CL_FLYING, nichts ab einem gewissen gewicht, keine
                   //Geister, auch Spieler mit einer Geschicklichkeit kleiner
                   //der des Owners (keine waldlaeufer)
  SetProp(P_NAME, "Stolperdraht");
  SetProp(P_GENDER, MALE);
  RemoveId( ({"falle"}) );
  AddId( ({STOLPERDRAHT_ID, "stolperdraht", "draht"}) );
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:20, MAT_MISC_HERBAL:40, 
                        MAT_MISC_WOOD:20, MAT_COPPER:20]) );  
  
  return 1;
}

//-- Pfeilfalle --------------------------------------------------------------
int Pfeilfalle(object caster, int ability)
{
  if(!caster || !ENV(TO) || (mode!=M_NORMAL) ) { remove(1); return 0;}
  owner=caster; mode=M_PFEILFALLE; abil=ability;
  bonus = call_other(GUILD_SPELLBOOK, "get_equip_bonus", caster, "pfeilfalle");
  AddCmd("loes|loese&falle|pfeilfalle&aus"
        ,CLOSURE(ausloesen)
        ,"Was willst Du ausloesen?|Welche Falle willst Du ausloesen?");
        
  //Aeusserlichkeiten
  SetProp(P_SHORT, "Eine Pfeilfalle");
  SetProp(P_LONG,  "Diese komplizierte Falle gehoert zu den schwierigsten und"
                   " auch gefaehrlichsten der Waldlaeufer. Auf einigen "
                   "Astgabel wurden jeweils einige Pfeile gespannt. Wenn "
                   "eines der Hauptseile durchtrennt wird, fliegen gleich "
                   "mehrere Pfeile auf die Gegner.");
  SetProp(P_NAME, "Pfeilfalle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({PFEILFALLE_ID, "pfeilfalle"}) );
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:60, MAT_MISC_HERBAL:40]) );
  aktiv=abil/1000;
  skill=R_SKILLMASTER->HasSkill(getuid(owner), GROSSWILDJAEGER);
  if(aktiv<1) aktiv=1;
  if(aktiv>(5+5*skill)) aktiv=(5+5*skill);

  aktiv += aktiv * bonus / 100;

  giftskill=R_SKILLMASTER->HasSkill(getuid(caster), MEISTER_DER_GIFTE);
  return 1;
}
//**************************************************************************//



//** Die Auswirkungen der Falle ********************************************//
//-- ausloesen der Falle------------------------------------------------------
int ausloesen(string str)
{
  string *cmd;
  object ob, *enemies;
  int i, dam;
  
  if(!owner || !ENV(TO) || !TP || (mode==M_NORMAL)) 
  { remove(1); return 0; }
  if(TP!=owner)
  { tell_object(TP, BS("Du darfst Die Falle nicht ausloesen!"));
    if(present(owner,ENV(TO))) 
    { tell_object(owner, BS(TP->Name(WER, 1)+" versucht Deine "+
                         QueryProp(P_NAME)+" auszuloesen.")); }
    tell_room(ENV(TO),
              BS(TP->Name()+" versucht "+owner->name(WESSEN, 1)+" Falle "
              "auszuloesen."),
              ({owner, TP}));
    return 1;
  }
  if(aktiv<1) 
  {tell_object(TP, BS("Die Falle ist schon aktiv.")); return 1;}
  if(!(TP->InFight()))
  {tell_object(TP, BS("Das geht nur im Kampf.")); return 1;}
  aktiv--;
  skill=R_SKILLMASTER->HasSkill(getuid(owner), GROSSWILDJAEGER);

  //Feind auswahl bei Fang/Fesselfalle (ob)
  cmd=explode(str, " ");
  if(sizeof(cmd)>2)
  { str=cmd[(sizeof(cmd)-1)];
    if(str)
    { if(present(str, ENV(TO))) {ob=present(str,ENV(TO)); }  }
  }
  if(!ob)
  {
    enemies=TP->PresentEnemies();
    if(sizeof(enemies)<1)
    {tell_object(TP, BS("Du hast keine Feinde hier!")); aktiv--; return 1;}
    ob=enemies[random(sizeof(enemies))];
  }

  switch(mode)
  {
    case M_STOLPERDRAHT: 
      if(!(TP->InFight())) { 
        tell_object(TP, BS("Du bist nicht im Kampf. Das macht keinen Sinn.")); 
        aktiv++; return 1;
      }
      tell_object(TP, BS("Du spannst die Draehte."));
      
      i=abil/2000;
      if(i<1) i=1;
      if(i>4) i=5;

      i += i * bonus / 100;
      
      stolpern(1+i+2*skill);
      break;
    case M_FESSELFALLE:
      tell_object(TP, BS("Du durchtrennst die Fangschnur der Fesselfalle."));
      if(ob->QueryProp(P_SIZE) <= 400) {
        i = (2*skill)+(abil/2000);
        i += i * bonus / 100;

        ob->SetProp(P_PARALYZED, i);
        tell_room(ENV(ob),BS(TP->Name(WER, 1)+" loest die Fesselfalle aus."), ({TP}));
        tell_room(ENV(ob), BS(ob->Name(WER, 1)+" ist in der Falle und kann sich nicht bewegen."));
        remove(1); 
        return 1;
      }

      tell_object(TP, BS(ob->Name(WER, 1)+" ist zu gross fuer die Falle!"));
      remove(0); 
      break;
    case M_FANGFALLE:
      tell_object(TP, BS("Du entfernst schnell den Ast.")); 
      tell_room(ENV(ob), BS(TP->Name(WER, 1)+" loest die Fangfalle aus."), ({TP}));
      tell_room(ENV(ob), BS(ob->Name(WER, 1)+" tritt in die Falle."));

      dam = (abil/10)*(2*skill);
      dam = call_other(GUILD_SPELLBOOK, "get_equip_damage", TP, "fangfalle", dam);

      ob->Defend(dam, ({DT_PIERCE}),0, TP );
      remove(0);  
      break;
    case M_PFEILFALLE:
      if(!(TP->InFight()) || (sizeof(TP->PresentEnemies())<1) ) { 
        tell_object(TP, BS("Du bist nicht im Kampf. Das macht keinen Sinn."));
        aktiv++; 
        return 1; 
      }

      tell_object(TP, BS("Du kappst ein Seil der Pfeilfalle.")); 
      tell_room(ENV(TO), BS(TP->Name(WER, 1)+" loest die Pfeilfalle aus. Pfeile schwirren auf Dich zu. BRING DICH IN DECKUNG!"), ({TP}));
      enemies=TP->PresentEnemies();

      dam = abil/20;
      dam = call_other(GUILD_SPELLBOOK, "get_equip_damage", TP, "pfeilfalle", dam);      

      for(i=0;i<=sizeof(enemies)-1;i++) {
        enemies[i]->Defend(dam, ((random(2)&&giftskill)?({DT_POISON}):({DT_PIERCE})),0,TP );
      }

      if(aktiv<1) {
        remove(0);
        return 1;
      }

      break;
  }
  return 1;  
}
//-- Gibt die 'stolperfaehigen' zurueck --------------------------------------
int stolpernSort(object ob) {

  return owner->IsEnemy(ob) && !ob->is_class_member(CL_FLYING) && !ob->id(NOFALLDOWN) &&
         ob->QueryProp(P_RACE) != "Geist" && ob->QueryAttribute(A_DEX) < owner_ges+10+random(owner->QueryProp(P_GUILD_LEVEL)) &&
         !ob->QueryProp(P_PARALYZED);
}
//-- Spezieller Teil der stolperfalle ----------------------------------------
int stolpern(int counter)
{
  object *opfer;
  int i;

  pDebug(owner, sprintf("stolperdraht :: counter=%d\n", counter));

  if( counter <= 0 || !ENV(TO) || !owner || !(owner->InFight()) )  {
    pDebug(owner, sprintf("stolperdraht :: exit counter=%d env=%O owner=%O inFight=%d\n", counter, ENV(TO), owner, owner->InFight()));
    remove(0); 
    return 1;
  }

  opfer=filter_array(all_inventory(ENV(TO)), "stolpernSort");

  for(i=0;i<=sizeof(opfer)-1;i++)
  { 
    if(!random(2)) {
      pDebug(owner, sprintf("stolperdraht :: opfer=%O\n", opfer[i]));
      tell_room( ENV(TO),BS(opfer[i]->Name(WER, 1)+" stolpert und geht zu "
                  "Boden."), ({opfer[i]})); 
      tell_object(opfer[i], BS("Du stolperst und faellst zu Boden"));
      opfer[i]->SetProp(P_DISABLE_ATTACK, 1);
      opfer[i]->SetProp(P_LAST_RAMMEN_TIME, (2+time()));
    }
  }

  call_out("stolpern",(2+random(3)),(counter-(random(2))));
  return 1;
}
//**************************************************************************//