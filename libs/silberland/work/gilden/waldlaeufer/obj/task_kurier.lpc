#include "../def.h"
#include "../ranger.h"
#include "../ranger_tasks.h"

inherit "std/thing";

int *teile;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------
  SetProp(P_SHORT, "Die Nachricht des Kuriers der Kultisten");
  SetProp(P_LONG, "Diese Nachricht hast du von einem Kurier der Kulisten des "
                  "Omegatherions abgefangen. Auf ihr steht geschribene, wo "
                  "die Teile eurer Waffe versteckt sind.\n@@teile_status@@");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Nachricht");
  SetProp(P_GENDER, NEUTER);
  AddId(({"QUESTOBJ", RANGER_TASK_COURIER, "nachricht"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 0);;
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd("lies|lese&nachricht|nachricht des kuriers", "cmd_lesen");

  teile = ({0, 0, 0, 0});
}

public string teile_status() {
  string str;
  str = "";
  if(teile[0]) str += "Das erste Teil hast du bereits geborgen.\n";
  if(teile[1]) str += "Das zweite Teil hast du bereits geborgen.\n";
  if(teile[2]) str += "Das dritte Teil hast du bereits geborgen.\n";
  if(teile[3]) str += "Das vierte Teil hast du bereits geborgen.\n";

  return str;
}

public void SetTeil(int n) {
  object owner;

  if(n<1 || n>4) return;

  teile[n-1] = 1;

  owner = ENV(TO);
  if(teile[0] && teile[1] && teile[2] && teile[3]) {
    owner->Message(break_string("Wir haben nun alle Teile. Du hast deine Aufgabe hervorragend erledigt!", 78, "Raziel teilt Dir mit: "));
    RANGER_SET_TASK(owner, 18);
    call_out("remove", 0);
  } else {
    owner->Message(break_string("Gut gemacht! Unsere Agenten werden sich um alles weitere kuemmern. Suche das naechste Teil.", 78, "Raziel teilt Dir mit: "));
  }
}

public int cmd_lesen(string str) {
  write("Du liest die Nachricht des Kuriers:\n\n");
  write("Ehrenwerter Meister,\n\n");
  write(BS("Da wir die Schmiedekunst des dustyverfluchten Zwergen nicht zerstoeren konnten "
           "haben wir unser Bestes getan die zerschmetterten Teile der Waldlaeuferwaffe "
           "an unzugaenglichen Orten zu verstecken. Dabei haben wir keine Muehen gescheut und die "
           "verderbtesten Verbuendeten angerufen, die wir kennen."));
  write("\n");
  write(BS("Das erste Teil haben wir dem Blutdrachen zum Frass vorgeworfen. Er hat es verschlungen, "
           "und es wir wohl kaum moeglich sein es aus seinem Magen herauszuschneiden."));
  write("\n");
  write(BS("Das zweite Teil hat einer unserer Brueder in die Wueste gebracht, um es dort, wo die "
           "Sanddrachen leben auf ewig in einer bodenlosten Spalte verschwinden zu lassen."));
  write("\n");
  write(BS("Das dritte Teil wollten wir auf den hoechsten Gipfel der Berge bringen. Doch unser "
           "Knappe wurde dabei von einem riesigen Vogel erwischt und verschleppt. Vermutlich hat "
           "das Monster ihn seinen Kindern verfuettert."));
  write("\n");
  write(BS("Das letzte Teil haben wir in das Loch der grossen Mutter in den Hoehlen des ersten "
           "Tempels geworfen. Niemand wird es dem vielkoepfigen Scheusal entreissen koennen!"));
  write(BS("\n"));
  write(BS("Ehre der Monstermutter, auf das Ende der Welt,"));
  write("Euer ergebsnster Diener\n");

  say(BS(TPN+" liest einen Zettel."));
  return 1;
}