/***************** Kraeuterbeutel der Waldlaeufergilde ***********************
26.09.06 - Begin
*****************************************************************************/
//** INHERIT + INCLUDE + DEFINE ********************************************//
inherit "/std/container";

#include "../def.h"
//**************************************************************************//



//** StandardFunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  ::create();
  
  SetProp(P_NAME, "Kraeuterbeutel");
  SetProp(P_SHORT, "Ein Kraeuterbeutel");
  SetProp(P_LONG, "Dieser lederne Kraeuterbeutel wird von den Waldlaeufern "
    "benutzt, um die Kraeuter, die sie finden zu verwahren. Die Kraeuter "
    "scheinen dort nicht zu vertrocknen. Mit einer kleinen Schnur kannst Du "
    "ihn oeffnen oder schliessen.");
  AddId(({"beutel", "kraeuterbeutel", FOOD_CONTAINER_ID}));
  
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE,  80);
  SetProp(P_WEIGHT, 300);
  SetProp(P_MAX_WEIGHT, 2000); //100-200 Kraeuter
  SetProp(P_WEIGHT_PERCENT, 10);
  
  add_openclose_commands();
}

//-- Nimmt nur die Kraeuter auf ----------------------------------------------
varargs int PreventInsert(object ob)
{
  object ob2;
  if(ob && ob->id(KRAUT_ID) ) { return (int)::PreventInsert(ob); }
  return 1;
}

//-- Nur Waldlaeufer duerfen den Kraeuterbeutel tragen -----------------------
void init()
{
  ::init();
  if(!objectp(MENV) || (MENV->QueryProp(P_GUILD)!= GUILDNAME) )
  { write("Der Kraeuterbeutel wird zu Staub.\n");
    call_out("remove",0);
    return 0; }
}

//-- Der Reset ---------------------------------------------------------------
void reset()
{
  if(!is_clone(this_object())) return; 
  ::reset();
}

//-- Vereinfachte Syntax -----------------------------------------------------
//int is_kraut(object ob) { return ob->id(KRAUT_ID); }
object *present_objects(string complex_desc) 
{
  //mixed obs, env;
  
  if(complex_desc == "alle kraeuter") { complex_desc="alles"; }
  /*if(complex_desc == "alle kraeuter" && objectp(env=ENV(TO)) )
  { obs=filter_array(all_inventory(env), "is_kraut");
    if(!obs) { obs=({}); }
    return obs; }*/
  return ::present_objects(complex_desc);
}
//**************************************************************************//