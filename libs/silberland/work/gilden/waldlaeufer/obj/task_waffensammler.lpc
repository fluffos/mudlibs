#include "../def.h"
#include "../ranger.h"
#include "../ranger_tasks.h"

inherit "std/thing";

string *gathered;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INVIS, 1);
  SetProp(P_SHORT, "Waffensammeln fuer Kronosch");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waffensammeln");
  SetProp(P_GENDER, NEUTER);
  AddId(({"QUESTOBJ", RANGER_TASK_WEAPON_GATHER}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);;
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  gathered = ({ });
}

public int QueryGiven(string wt) {
  return member(gathered, wt) >= 0;
}

public void Accept(string wt) {
  if(!QueryGiven(wt)) gathered += ({wt});
  return;
}

public int Complete() {
  if(QueryGiven(WT_KNIFE) && QueryGiven(WT_SWORD) && QueryGiven(WT_AXE) && QueryGiven(WT_SPEAR) && QueryGiven(WT_CLUB)) {
    GUILD_MASTER->SetTask(getuid(ENV(TO)), 7);
    call_out("remove", 0, 1);
    return 1;
  }
  return 0;
}