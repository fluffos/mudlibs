#include "../def.h"
#include "../ranger.h"
#include "../ranger_tasks.h"

inherit "std/thing";

int schattenschwert, blauschwert, eisdorn, dornenzweig, luftschwert, lichtkeule, silberschwert, flammenpeitsche;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INVIS, 1);
  SetProp(P_SHORT, "Waffensammeln  II fuer Kronosch");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waffensammeln");
  SetProp(P_GENDER, NEUTER);
  AddId(({"QUESTOBJ", RANGER_TASK_MAGIC_WEAPONS}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);;
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}

public int Accept(object item) {
  if(item->id("\neisdorn")) {
    eisdorn = 1;
    return 1;
  }
  if(item->id("schattenschwert")) {
    schattenschwert = 1;
    return 1;
  }

  if(item->id("flammenpeitsche")) {
    flammenpeitsche = 1;
    return 1;
  }

  if(item->id("luftschwert")) {
    luftschwert = 1;
    return 1;
  }

  if(item->id("lichtkeule")) {
    lichtkeule = 1;
    return 1;
  }

  if(item->id("blauschwert")) {
    blauschwert = 1;
    return 1;
  }

  if(item->id("silberschwert")) {
    silberschwert = 1;
    return 1;
  }

  return 0;
}


public int Complete() {
  if(eisdorn && schattenschwert && flammenpeitsche && luftschwert && lichtkeule && blauschwert && silberschwert) {
    GUILD_MASTER->SetTask(getuid(ENV(TO)), 8);
    call_out("remove", 0, 1);
    return 1;
  }
  return 0;
}