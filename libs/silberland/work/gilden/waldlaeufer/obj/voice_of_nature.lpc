inherit "/std/thing";

#include "../def.h"

private string endMessage;

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    AddId(({"\nvoice_of_nature"}));

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_WEIGHT, 0);  
    SetProp(P_VALUE, 1);
    SetProp(P_NOBUY, 1); 
    SetProp(P_NODROP, 1);
    SetProp(P_NOGET, 1);
    SetProp(P_NEVERDROP, 1);
    SetProp(P_NOSELL, 1);
}

public void set_timeout(int duration) {
    while(find_call_out("remove") != -1) remove_call_out("remove");
    call_out("remove", duration, 1);
}

public void set_end_message(string message) {
    endMessage = message;
}

public int remove(int silent) {
    if(stringp(endMessage) && objectp(environment(this_object()))) {
        tell_object(environment(this_object()), BS(endMessage));
        environment(this_object())->UpdateAttributes();
    }

    return ::remove(silent);
}

public void activate_terrain(string terrain) {
  string msg;
  SetProp("terrain", terrain);

  switch(terrain) {
    // hier gibt es einen buff je nach terrain. ein paar sind wegen aehnlichkeit zusammen gefasst
    case TT_CAVE:
    case TT_HOUSE:
        msg = "Eine beruhigende Stimme fluestert Dir zu: 'In der Geborgenheit der Hoehle, fernab von Gefahren, findest Du Ruhe und Kraft.'";
        SetProp(P_X_HEALTH_MOD, ([P_HP: 10]));
        set_end_message("Du verlierst das Gefuehl der Sicherheit der Hoehle.");
        break;
    case TT_HILL:
    case TT_PLAIN:
        msg = "Eine sanfte Stimme fliegt mit dem Wind zu Dir: 'In der Weite der Ebene findest Du Freiheit und Klarheit.'";
        SetProp(P_X_HEALTH_MOD, ([P_SP: 10]));
        set_end_message("Du verlierst das Gefuehl der Freiheit der Ebene.");
        break;
    case TT_FOREST:
    case TT_JUNGLE:
        msg = "Eine vertraute Stimme raunt Dir zu: 'Im Schutz des Waldes findest Du Kraft und Verbundenheit.'";
        SetProp(P_X_HEALTH_MOD, ([P_HP: 5, P_SP: 5]));
        set_end_message("Du verlierst das Gefuehl der Verbundenheit des Waldes.");
        break;
    case TT_TOWN:
        msg = "Eine geschäftige Stimme flüstert Dir zu: 'In der Hektik der Stadt findest Du Anpassungsfähigkeit.'";
        SetProp(P_X_ATTR_MOD, ([A_DEX: 2]));
        set_end_message("Du verlierst das Gefuehl der Wachsamkeit der Stadt.");
        break;
    case TT_MOUNTAIN:
        msg = "Eine majestätische Stimme hallt in Dir nach: 'In der Erhabenheit der Berge findest Du Standhaftigkeit und Stärke.'";
        SetProp(P_X_ATTR_MOD, ([A_STR: 2]));
        set_end_message("Du verlierst das Gefuehl der Standhaftigkeit der Berge.");
        break;
    case TT_DESERT:
        msg = "Eine ruhige Stimme flüstert Dir zu: 'In der Weite der Wüste findest Du Ausdauer und Gelassenheit.'";
        SetProp(P_X_ATTR_MOD, ([A_CON: 2]));
        set_end_message("Du verlierst das Gefuehl der Ausdauer der Wüste.");
        break;
    case TT_SWAMP:
        msg = "Eine geheimnisvolle Stimme flüstert Dir zu: 'Im Sumpfgebiet findest Du Anpassungsfähigkeit und Überlebenskunst.'";
        SetProp(P_X_ATTR_MOD, ([A_INT: 2]));
        set_end_message("Du verlierst das Gefuehl der Anpassungsfähigkeit des Sumpfes.");
        break;
    case TT_ARCTIC:
        msg = "Eine klare Stimme flüstert Dir zu: 'In der Kälte der Arktis findest Du Klarheit und Fokus.'";
        SetProp(P_X_ATTR_MOD, ([A_INT: 2]));
        set_end_message("Du verlierst das Gefuehl der Klarheit der Arktis.");
        break;
    case TT_UNDERWATER:
    case TT_WATER:
        msg = "Eine fließende Stimme umgibt Dich: 'Im Wasser findest Du Flexibilität und Ruhe.'";
        SetProp(P_X_ATTR_MOD, ([A_DEX: 2]));
        set_end_message("Du verlierst das Gefuehl der Flexibilität des Wassers.");
        break;
    case TT_ROAD:
        msg = "Eine zielgerichtete Stimme flüstert Dir zu: 'Auf der Straße findest Du Entschlossenheit und Richtung.'";
        SetProp(P_X_ATTR_MOD, ([A_DEX: 1, A_STR: 1]));
        set_end_message("Du verlierst das Gefuehl der Entschlossenheit der Straße.");
        break;
    case TT_AIR:
        msg = "Eine erhabene Stimme flüstert Dir zu: 'In der Weite des Himmels findest Du Freiheit und Inspiration.'";
        SetProp(P_X_ATTR_MOD, ([A_DEX: 1, A_INT: 1]));
        set_end_message("Du verlierst das Gefuehl der Freiheit des Himmels.");
        break;
    default:
        msg = "Eine neutrale Stimme flüstert Dir zu: 'In dieser Umgebung findest Du Balance.'";
        SetProp(P_X_HEALTH_MOD, ([P_HP: 5, P_SP: 5]));
        set_end_message("Du verlierst das Gefuehl der Balance.");
        break;
  }

  tell_object(ENV(TO), BS(msg));
  ENV(TO)->UpdateAttributes();

  set_timeout(300);
}