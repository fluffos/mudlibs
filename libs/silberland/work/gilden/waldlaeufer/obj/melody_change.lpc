inherit "std/armour";
#include "../def.h"
#include "/spellbooks/waldlaeufer/std/restrictions.lpc"

object owner;
int reactionSpeed;
mapping temperatureProtection = ([]);
mapping specialDamageDefense = ([]);
mapping damageTypeHitsTaken = ([]);

