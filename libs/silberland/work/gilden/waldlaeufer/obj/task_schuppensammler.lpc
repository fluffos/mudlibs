#include "../def.h"
#include "../ranger.h"
#include "../ranger_tasks.h"

inherit "std/thing";

int schuppen, fragmente;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INVIS, 1);
  SetProp(P_SHORT, "Itemssamelln  III fuer Kronosch");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waffensammeln");
  SetProp(P_GENDER, NEUTER);
  AddId(({"QUESTOBJ", RANGER_TASK_SCALE_GATHERER}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);;
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  schuppen = fragmente = 0;
}

public void AcceptScales(int amount) {
  schuppen += amount;
  return;
}

public void AcceptFragments(int amount) {
  fragmente += amount;
  return;
}

public int *QueryGiven() {
  return ({schuppen, fragmente});
}

public int Complete() {
  if(schuppen >= 10 && fragmente >= 10) {
    RANGER_SET_TASK(ENV(TO), 10);
    call_out("remove", 0, 1);
    return 1;
  }
  return 0;
}