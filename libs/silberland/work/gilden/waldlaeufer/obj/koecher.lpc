//** Titel/presay setzen ***************************************************//
//-- Der Gildenraum uebernimmt alles -----------------------------------------
int AdjustTitle()
{
  if(objectp(TP)) GUILD_ROOM->adjust_title(TP, 1);
  return 1;
}
//**************************************************************************//



//** Testplayer-Zusaetze ***************************************************//
//-- Transport in die Gilde --------------------------------------------------
int gilde()
{
  if(TP->QueryProp(P_TESTPLAYER) || IS_WIZARD(TP)) 
  { TP->move(GUILD_ROOM, M_TPORT); }
  return 1;
}

//-- Combochancen/-schaden fuer Testies anzeigen? ----------------------------
int combo_trigger(string str)
{
  int i;
  
  
  if(!TP->QueryProp(P_TESTPLAYER) && !IS_WIZARD(TP)) return 0;
  
  notify_fail("Befehl: <wlcombo 0|1>\n");
  if(!str || !stringp(str) ) return 0;
  if(str != "0" && str != "1") return 0;
  i=to_int(str);
  i=limit(i,0,1);
  
  //DBD(to_string(i));
  
  if(objectp(owner))
  {
    owner->SetProp(P_RANGER_SHOW_COMBOS, i);
    owner->Set(P_RANGER_SHOW_COMBOS, SAVE, i);
    write("Comboanzeige "+(i?"ein":"aus")+"geschaltet.\n");
    return 1;
  }
  return 0;
}

//-- Gildenquest setzen ------------------------------------------------------
int set_quest(string str)
{
  mixed s;
  int i;
  
  if(!TP->QueryProp(P_TESTPLAYER) && !IS_WIZARD(TP)) return 0;
  
  notify_fail("Befehl: <wlsettask 1 ... 20>\n");
  i=to_int(str);
  if(!i || i>20) return 0;
  s=TP->QueryProp(P_RANGER_NEED_QUEST);
  if(!stringp(s)) s="";
  if(test_bit(s, i))
  {
    s=clear_bit(s,i);
    TP->SetProp(P_RANGER_NEED_QUEST, s);
    write(BS("Die Quest fuer Gildenstufe "+to_string(i)+" ist jetzt wieder "
          "notwendig!"));
    return 1;    
  }
  else
  {
    s=set_bit(s,i);
    TP->SetProp(P_RANGER_NEED_QUEST, s);
    write(BS("Die Quest fuer Gildenstufe "+to_string(i)+" ist jetzt nicht "
          "mehr notwendig!"));
    return 1;    
  }
  return 0;
  
}

//-- Gildentask setzen -------------------------------------------------------
int set_task(string str)
{
  int i;
  
  if(!TP->QueryProp(P_TESTPLAYER) && !IS_WIZARD(TP)) return 0;
  
  notify_fail("Befehl: <wlsetquest 1 ... 20>\n");
  i=to_int(str);
  if(!i || i>20) return 0;
  if(objectp(owner))
  {
    RANGERMASTER->SetTask(getuid(owner), i);
    write("Gildenaufgabe fuer Gildenstufe "+to_string(i)+" gesetzt.\n");
    return 1;
  }
  return 0;
  
}

//**************************************************************************//



//** Leichenueberpruefung fuer Task und Archenemey *************************//
//-- Filterfunktion um nur an die Leichen zu kommen --------------------------
int is_correct_corpse(object ob)
{
  if( objectp(ob) && objectp(owner) && ob->id("Leiche") &&  
      owner==ob->QueryProp(P_KILLER) && 
      !stringp(ob->QueryProp(P_CORPSE_MARK))  )
  { ob->SetProp(P_CORPSE_MARK, getuid(owner));
    //DBD(to_string(ob)+" correct_corpse akzeptiert!");
    return 1; }
  return 0;
}

//-- ErzfeindTest ------------------------------------------------------------
int archenemy_test(object corpse)
{
  if(!objectp(corpse) || !objectp(owner) ) { return 0; }
  if( GUILD_MASTER->is_archenemy_of(getuid(owner), corpse) && 
      (corpse->QueryProp(P_LEVEL))>=(owner->QueryProp(P_GUILD_LEVEL)) )
  { 
    GUILD_MASTER->IncKilledArchenemys(getuid(owner), corpse->QueryProp(P_LEVEL)); 
    //DBD(to_string(corpse)+" archenemy_test akzeptiert!");
    return 1;
  }
  return 0;
}

//-- TaskTest ----------------------------------------------------------------
void task_test(object corpse)
{
  if(!objectp(corpse) || !objectp(owner) ) { return; }
  return;
}

//-- Hauptfunktion -----------------------------------------------------------
int corpse_test()
{
  mixed obs, env;
  object ob;
  string s;
  int i, task_flag, res;
  
  notify_fail("Du spuerst nichts.\n");
  res=0;
  if(!objectp(TP) || !objectp(env=ENV(TP)) ) { return 0; }
  
  obs=filter_array(all_inventory(env), "is_correct_corpse");
  if(!pointerp(obs) || sizeof(obs)<1) { return 0; }
  if(present(TASK_OBJECT_ID, TP)) { task_flag=1; }
  for(i=0;i<sizeof(obs);i++)
  { //DBD(to_string(obs[i]));
    res+=archenemy_test(obs[i]);
    if(task_flag) { task_test(obs[i]); } }
  if(!res) return 0;
  tell_object(TP, BS(res==1?("Die Leiche wurde akzeptiert."):("Von den "
                  "Leichen wurden "+to_string(res)+" akzeptiert.")));
  return 1;
}
//**************************************************************************//

public void updateSummonInvest() {
  summons -= ({0}); // aufraeumen
  if(RANGERMASTER->GetMasterAbility(getuid(owner)) != MASTER_ABIILITY_IMPROVED_BINDING) 
    SetProp(P_X_HEALTH_MOD, ([P_SP: -(50*sizeof(summons))]));
  owner->UpdateAttributes();
  return;
}

//-- Summons Managen ----------------------------------------------------------
public void RegisterSummon() {
  if(!objectp(PO)) return;
  if(!PO->id(SUMMON_ID)) return;

  summons += ({PO});
  updateSummonInvest();
}

public void UnregisterSummon() {
  if(!objectp(PO)) return;
  if(!PO->id(SUMMON_ID)) return;

  summons -= ({PO});
  updateSummonInvest();
}

public int Version() {
  return KOECHER_VERSION;
}