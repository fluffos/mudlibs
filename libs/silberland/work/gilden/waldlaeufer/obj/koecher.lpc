//-- MainHelp ----------------------------------------------------------------
nosave int ShowHelp()
{
  string s;
  
  s="\nMit dem Koecher hast Du folgende Moeglichkeiten:\n\n"
    "  wlhilfe       : Diese Hilfseite\n"
    "  wlreport hilfe: Hilfeseite zum wlreport\n"
    "  wlfarben hilfe: Hilfe zu den Farbeinstellungen\n"
    "  wlstatus      : Status des wlreport\n"
    "  wlfarbe <0|1> : Farben aus/an (report ausgenommen)\n"
    "  wlinfo/wlsinfo: WaldlaeuferInfo/Kurzform\n"
    "  wlwer <kurz>  : Welche Waldlaeufer sind anwesend?\n"
    "  wlpunkte      : Wie hast Du Deine Fertigkeitspunkte verteilt?\n"
    "  wlwisper      : Du laesst den anderen Waldlaeufern eine Nachricht\n"
    "                  zukommen. (emote mit <wlemote>)\n"
    "  wllausch <nr> : Was haben die anderen Waldlaeufer besprochen?\n"
    "  wltitel       : Setzt den Gildentitel und Presay\n"
    "  wlpruefe      : Welche der Leichen gehoert zu Deinen Erzfeinden?\n";
  if(TP->QueryProp(P_TESTPLAYER) || IS_WIZARD(TP))
  { s+="\n Ab Testspieler: \n";
    s+="  wlgilde        : Transport in die Gilde \n";
    s+="  wlcombo <0|1>  : Zeigt Combochancen/-schaden \n";
    s+="  wlsettask <nr> : Setzt die Gildenaufgabe als erledigt f�r die \n"
       "                   angegebene Gildenstufe (1-20)\n";
    s+="  wlsetquest <nr>: Setzt die Quest f�r Gildenstufe (1-20)als "
       "erledigt\n";
  }
  if(member(MASTER_MAGES, getuid(TP)) != -1)
  { s+="\n Ab Gildenmagier: \n";
    s+="  mwisper       : Den Gildenmagierin etwas mitteilen \n";
    s+="  mwlhist       : Was haben die Gildenmagier gesagt? \n";
