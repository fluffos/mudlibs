//** Skillpunkte einsehen **************************************************//
//-- Alles vorgefertigt im Skillmaster ---------------------------------------
int ShowSkillPoints()
{
  mixed res;
  
  res=R_SKILLMASTER->QuerySkillTree(getuid(TP));
  if(stringp(res)) {TP->More(res);}
  return 1;  
}
