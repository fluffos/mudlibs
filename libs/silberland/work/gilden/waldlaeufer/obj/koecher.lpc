//** StandardFunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  //Die Farben festsetzen
  std_colors=({ANSI_GREEN, ANSI_BOLD+ANSI_YELLOW, ANSI_CYAN, 
               ANSI_BOLD+ANSI_BLUE, ANSI_PURPLE, ANSI_RED});
  report_colors=std_colors;

  SetProp(P_SHORT, "Ein grauer Koecher");
  SetProp(P_LONG, 
    "Dieser schlichte Koecher ist das Zeichen der Waldlaeufer. Er wurde "
    "an der ewigen Flamme von Tethyr genaeht und durch die Magie der Flamme "
    "scheint der Vorrat von Pfeilen nie zu enden.\n@@freipfeile@@");
  
  AddDetail( ({"koecher"}),
    "Darin bewahrt man Pfeile auf. Davon brauchen die Waldlaeufer viel.");
    
  AddDetail( ({"zeichen", "waldlaeufer", "laeufer"}),
    "Der Koecher ist das Zeichen der Waldlaeufer.");
    
  AddDetail( ({"vorrat", "pfeile", "pfeil"}),
    "Der Vorrat an Pfeilen in diesem Koecher scheint gespeisst durch die "
    "Macht der ewigen Flamme nie zu enden.");
    
  AddDetail( ({"macht", "flamme", "tethyr"}),
    "Die Magie kommt aus der ewigen Flamme von Tethyr.");
  
  SetProp(P_NAME, "Koecher");
  SetProp(P_NAME_ADJ, "grau");
  SetProp(P_GENDER, MALE );
  SetProp(P_INFO, 
    "Das Geschenk der Waldlaeufer. <wlhilfe> fuer mehr Infos.\n");
  AddId( ({"koecher", GUILD_OBJ_ID}) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 800+random(100) );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_WORN_TEXT, "um den Ruecken gebunden");
  SetProp(P_WEAR_TEXT, ({ "Du wirfst Dir den Koecher ueber den Ruecken.\n", 
                          " wirft sich den Koecher ueber den Ruecken.\n" }));
  SetProp(P_UNWEAR_TEXT, ({ "Du nimmst den Koecher vom Ruecken.\n", 
                            " nimmt den Koecher vom Ruecken.\n" }));
                          
  AddCmd( "wlhilfe"   , "ShowHelp"        ); //HilfeSeite
  AddCmd( "wlinfo"    , "wlinfo"          ); //Info
  AddCmd( "wlsinfo"   , "wlinfo_short"    ); //Info kurz
  AddCmd( "wlwisper"  , "guild_shout"     ); //Gildeninternes rufen
  AddCmd( "wlemote"   , "guild_shout"     ); //mit wlemote auch emote moeglich
  AddCmd( "wllausch"  , "ShowHistory"     ); //History des guild_shout
  AddCmd( "mwisper"   , "mages_shout"     ); //Kommunikation fuer Gildenmagier
  AddCmd( "mwlhist"   , "ShowMagesHistory"); //GildenmagierHist
  AddCmd( "wlpunkte"  , "ShowSkillPoints" ); //SKillpoints
  AddCmd( "wlwer"     , "guild_who"       ); //Waldlaeufer-Wer,wlwer kurz 
  AddCmd( "wlreport"  , "report"          ); //Ranger_Report
  AddCmd( "wlstatus"  , "wl_status"       ); //Ranger_Report_Status
  AddCmd( "wlfarben"  , "SetColors"       ); //REPORT Farben
  AddCmd( "wlfarbe"   , "ColorSetting"    ); //Farbe AN oder AUS 
  AddCmd( "wltitel"   , "AdjustTitle"     ); //Titel setzen
  AddCmd( "wlgilde"   , "gilde"           ); //Transport in Gilde (Testies)
  AddCmd( "wlcombo"   , "combo_trigger"   ); //Comboschaden anzeigen (Testies)
  AddCmd( "wlsettask" , "set_task"        ); //Gildenaufgaben setzen (Testies)
  AddCmd( "wlsetquest", "set_quest"       ); //Gildenquest setzen (Testies)
  AddCmd( "wlpruefe"  , "corpse_test"     ); //Leichenpruefung
  AddCmd( "freipfeil",  "cmd_freipfeil"   ); // fuer Bogenschuetzen, die Freipfeile beschwoeren koennen    
  
  call_out("SetListener",2,1);
}

public string freipfeileStatus() {
  mixed *fs;
  fs = QueryProp(P_RANGER_FREISCHUETZ);

  if(fs && fs[RANGER_FREISCHUETZ_COUNT] > 0) return sprintf("Du hast noch %d Freipfeile im Koecher.", fs[RANGER_FREISCHUETZ_COUNT]);
  else {
    SetProp(P_RANGER_FREISCHUETZ, 0);
    return "Du hast keine Freipfeile mehr im Koecher.";
  } 
}

public int cmd_freipfeil(string str) {
  mixed *fs;
  fs = QueryProp(P_RANGER_FREISCHUETZ);
  if(!fs) return 0;
  if(fs[RANGER_FREISCHUETZ_ACTIVE]) {
    write(BS("Du hast bereits einen Freipfeil eingelegt."));
    return 1;
  }

  write(BS("Du ziehst einen Freipfeil auf den Koecher und legst ihn auf die Sehne."));
  say(BS(TPN+" zieht einen schwarzen Pfeil mit roten Federn aus dem Koecher und legt ihn auf die Sehne."));
  
  fs[RANGER_FREISCHUETZ_ACTIVE] = 1;
  fs[RANGER_FREISCHUETZ_COUNT] = fs[RANGER_FREISCHUETZ_COUNT] - 1;
  SetProp(P_RANGER_FREISCHUETZ, fs);
  
  write(BS(freipfeileStatus()));

  return 1;
}

public void UseFreipfeil() {
  mixed *fs;
  fs = QueryProp(P_RANGER_FREISCHUETZ);
  fs[RANGER_FREISCHUETZ_ACTIVE] = 0;
  SetProp(P_RANGER_FREISCHUETZ, fs);
  return;
}


public string freipfeile() {
  mixed *fs;
  fs = QueryProp(P_RANGER_FREISCHUETZ);
  if(!fs) return "\b";

  return freipfeileStatus();
}

//-- Remove ------------------------------------------------------------------
int remove(int silent)
{
  if(!silent) { write("Der Koecher wird zu Staub.\n"); }
  SetListener(0);
  return ::remove(1);
}

//-- Reset -------------------------------------------------------------------
void reset()
{
  if(!is_clone(this_object())) return; 
  ::reset();
}

//-- NetDead & Alive ---------------------------------------------------------
void BecomesNetAlive(object wer) 
{
  if(wer==MENV) 
  { if(aktiv) 
    { wer->RemoveHpHook(ME);
      activate(wer); //Report
    }
  }
}      

//-- Nur Waldlaeufer duerfen Koecher tragen ----------------------------------
int WearFunc(object ob)
{
  if(TP->QueryProp(P_GUILD)!= GUILD)
  { tell_object(TP, BS("Nur Waldlaeufer duerfen diesen Koecher tragen!\n"));
    remove(); return 0; }
  SetListener(1);

  call_out("set_master_ability", 0);

  return 1;
}

public void set_master_ability() {
  if(!objectp(owner)) return;
  if(owner->QueryProp(P_GUILD_LEVEL) > 19) {
    masterAbility = RANGERMASTER->GetMasterAbility(getuid(owner));
  }
  return;
}

public string _query_master_ability() {
  if(!objectp(owner)) return 0;
  if(owner->QueryProp(P_GUILD_LEVEL) > 19) {
    return masterAbility;
  }
  return 0;
}

//-- Das Init ----------------------------------------------------------------
void init()
{
  object ob, env;
  
  ::init();
  // Tests
  if(!objectp(env=MENV) || !living(env)) {remove(); return 0;}
  if((env->QueryProp(P_GUILD)!= GUILD) && (!IS_WIZARD(env)) )
  { remove(); return 0; }
  if(TP!=env) { return 0; }
  
  // Nur ein Koecher im INV
  TO->RemoveId(GUILD_OBJ_ID);
  if(objectp(ob=present(GUILD_OBJ_ID, env))) { ob->remove(1); }
  TO->AddId(GUILD_OBJ_ID);
  
  owner=env;

  // Sofort anziehen
  DoWear();
  env->SetProp(P_WEAR_FUNC, TO);
  call_out("set_master_ability", 0);
}

//-- Ist der Report aktiv? ---------------------------------------------------
int query_aktiv() { return aktiv; }

//-- Das Ausziehen -----------------------------------------------------------
int RemoveFunc(object me)
{
  int ob;
  ob=QueryProp(P_WORN);
  if(!ob) return 1;
  if(ob->QueryProp(P_GUILD) != GUILD) 
  { ob->SetProp(P_TMP_RANGER_LISTENER, 0); }
  return 1;
}
