#define RL_MAX 2
#define RL_SPECIAL 3
#define RL_SPELL 4
#define RL_ALIGN 5
#define RL_EXTRA_WIDE 6
#define RL_XP 7
#define RL_TEDDY 8
#define RL_PET 9

