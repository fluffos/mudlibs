//** Ranger_Report *********************************************************//
//-- Ranger_Report_Status (saukomplex) ---------------------------------------
int wl_status(string str) 
{
  notify_fail("Du musst die Reportfunktion erst aktivieren.\n");
  if(!aktiv) { return 0; }
  NotifyHpChange(1);
  return 1;
}

//-- Welche Spells sind aktiv? -----------------------------------------------
string active_spells(object ob)
{
  string s, active;
  mixed p;
  int i;

  active = ob->QueryProp(P_RANGER_ACTIVE_SPELLS);
  if(!stringp(active)) {
    active = "";
  }
  
  if(test_bit(active, TB_RINDENHAUT)) { 
    s = "R"; 
  } else { 
    s = "-"; 
  }

  if(test_bit(active, TB_VISION)) { 
    s+="A"; 
  } else { 
    s+="-"; 
  }
  
  if(pointerp(ob->QueryProp(P_RANGER_SPEED_ACTIVE))) {
    i = ob->QueryProp(P_RANGER_SPEED_ACTIVE)[0];
    if(i>= time()) s+="S";
    else           s+="s";
  } else { 
    s+="-"; 
  }
  
  if(test_bit(active, TB_EBER_TRANCE)) { 
    s+="E"; 
  } else {
    s+="-";
  } 
    
  if(test_bit(active, TB_MDO)) { 
    s+="O"; 
  } else {
    s+="-";
  }
  if(test_bit(active, TB_AVATARA)) { 
    s+="M"; 
  } else {
    s+="-";
  }
  
  if(objectp(p=FindPet(ob))) { 
    if(p->QueryBiest()) { 
      s+="U"; 
    } else if(!p->QueryBiestReady()) {
      s+="u";
    }
      else {
      s+="-";
    }
    if(p->QueryTeam())  { 
      s+="G"; 
    } else {
      s+="-";
    } 
    if(ob->QueryProp(P_RANGER_PET_SUPPORT)) {
      s+="M";
    } else {
      s+="-";
    }
    if(test_bit(active, TB_KRAFT_DES_TIERES)) { 
      s+="T"; 
    } else {
      s+="-";
    }
  } else {
    s+="----";
  }
    
  if(pointerp(p=ob->QueryProp(P_RANGER_COLD_FLAME)) && to_int(p[1]) >= time()) {
    s += "B";
  } else {
    s += "-";
  }

  if(test_bit(active, TB_ODS)) {
    s += "D";
  } else {
    s += "-";
  }

  if(test_bit(active, TB_BLUTDORN)) {
    s += "K";
  } else {
    s += "-";
  }
  
  return s;
}

//-- Der neue Report ---------------------------------------------------------
/*
78er Aufteilung: spells: 8, align: 12, lps:13, mps:13, special: 8
[~<-------->~~[________]~~{Durchtrieben}~~{LP:282/282(+281)|MP:282/282(+282)}]

120er: xp: 10, tierzustand: 7
~~+Tier:    +~~~~|Erfahrung:           |~~
*/

private int getPetHpPercentage() {
  object pet;

  if(!objectp(pet=FindHelpPet(owner))) return 0;

  return pet->QueryProp(P_HP);
} 

private void update_x_mod(int modSp, int modHp, int sp, int hp) {
  mapping mods;
  
  mods = QueryProp(P_X_HEALTH_MOD);
  if(!mappingp(mods)) mods = ([]);

  if(modSp) {
    if(sp) {
      mods[P_SP] = sp;
    } else if(member(mods, P_SP)) {
      mods = m_delete(mods, P_SP);
    }
  }

  if(modHp) {
    if(hp) {
      mods[P_HP] = hp;
    } else if(member(mods, P_HP)) {
      mods = m_delete(mods, P_HP);
    }
  }

  if(modHp || modSp) {
    SetProp(P_X_HEALTH_MOD, mods);
    owner->UpdateAttributes();
  }

  return;
}

public void check_deep_bonds() {
  object p;
  string bondEffect, attr, r;
  mapping mods;
  int changed;

  last_bond_check = time();

  if(!objectp(p=FindPet(owner))) {
   update_x_mod(0, 1, 0, 0);
   if(last_bond_animal != 0) tell_object(owner, BS("Das Band zu deinem Tier versiegt bis ihr euch wieder trefft."));
   SetProp(P_X_ATTR_MOD, 0);
   owner->UpdateAttributes();
   last_bond_animal = 0;
   return;
  } 

  r = p->QueryProp(P_RANGER_PET_RACE);
  changed = last_bond_animal != r;

  switch(last_bond_animal = r) {
    case "insekt":
      update_x_mod(1, 0, p->QueryProp(P_LEVEL)/10*2, 0);
    case "katze":
    case "vogel":
    case "spinne":
    case "huftier":
    case "echse":
    case "kleintier":
      attr = A_DEX;
      break;
    case "bear":
      update_x_mod(0, 1, 0, p->QueryProp(P_LEVEL)/10*2);
    case "wolf":
    case "riese":
    case "panzertier":
      attr = A_STR;
      break;
  }

  SetProp(P_X_ATTR_MOD, ([attr: p->QueryProp(P_LEVEL)/10]));
  if(changed) tell_object(owner, BS("Das Band zu deinem Tier verstaerkt dich."));
  return;
}

varargs void NotifyHpChange(int status_cmd)
{
  int hp, mhp, sp, msp, stat, changedHP, changedSP, i, k, changedAnimalPercent;
  string color, s;
  mixed pet;

  /*Existiert das aufrufende Objekt noch
  if (!previous_object()) { return; }
  if (owner != previous_object() && previous_object() != FindHelpPet(owner)) { 
    if (TO != previous_object() ) { 
      return; 
    }
    stat=1; 
  }  */
  
  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv && !stat)
  { if (owner!=find_netdead(getuid(owner))) 
    { owner->RemoveHpHook(ME); } // geht nur bei nicht-netztoten Spielern
    return; }
  if(!query_once_interactive(owner)) {activate(0); return;}

  if(owner->QueryProp(P_GUILD_LEVEL) > 19) {
    if(masterAbility == 0) call_out("set_master_ability", 0);
    else if(masterAbility == MASTER_ABIILITY_DEEP_BOND && last_bond_check < time()-30) {
      call_out("check_deep_bonds", 0);
    }
  }
  
  // aktuelle Werte ermitteln + ReportFarbe
  hp  = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp  = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);
  // Werte berechnen und soll gesendet werden? 
  changedHP=hp-lasthp;
  changedSP=sp-lastsp;    
  changedAnimalPercent = (test_bit(akt_lvl, RL_PET) && objectp(pet=FindHelpPet(owner)) ? getPetHpPercentage() - lastAnimalHp : 0);

  if (  (  ( (hp < lastHP)                           || 
             (hp > lastHP && (sp == msp || callout)) || 
             (sp != lastSP)                          ||
             (changedAnimalPercent != 0) ||
             (stat)
           ) && ( changedHP || changedSP )
        )  || status_cmd )
  {
    // Teddy-Report?
    if(test_bit(akt_lvl, RL_TEDDY))
    {
      s="Du hast jetzt "+to_string(hp)+" ("+to_string(mhp)+") Lebenspunkte "
        "und "+to_string(sp)+" ("+to_string(msp)+") Magiepunkte.\n"; 
      if(test_bit(akt_lvl, RL_SPELL)) // einzige Teddy-Erweiterung
      { s+="[Zauber: "+active_spells(owner)+"]\n"; }
    }
    else
    {
      // Farben Ja|Nein
      if(test_bit(akt_lvl, RL_COLOR))
      { switch(hp*100/mhp)
        { case 0 .. 16: color=report_colors[5]; break;
          case 17.. 32: color=report_colors[4]; break;
          case 33.. 48: color=report_colors[3]; break;
          case 49.. 64: color=report_colors[2]; break;
          case 65.. 80: color=report_colors[1]; break;
          case 81..100: color=report_colors[0]; break;
          default:      color="";           break;
        } 
      }
      else { color=""; }
      if(cnt>5) { align=GetAlign(owner->QueryProp(P_ALIGN)); cnt=0; }
      cnt++;
      s=sprintf(color+"~[%s]~%s~%s~{LP:"+normal+"%d%s%s"+color+"|MP:"
                +normal+"%d%s%s"+color+"}]"
          ,(test_bit(akt_lvl, RL_SPELL)?
            ""+normal+active_spells(owner)+color+"":
            "")
          ,(test_bit(akt_lvl, RL_SPECIAL)?
            "["+normal+SpecialReport(owner)+color+"]":
            "")
          ,(test_bit(akt_lvl, RL_ALIGN)?
            "{"+normal+align+color+"}":
            "")
          ,hp
          ,(test_bit(akt_lvl, RL_MAX)?"/"+to_string(mhp):"")
          ,(changedHP?"("+(changedHP>0?"+":"")+to_string(changedHP)+")":"")
          ,sp
          ,(test_bit(akt_lvl, RL_MAX)?"/"+to_string(msp):"")
          ,(changedSP?"("+(changedSP>0?"+":"")+to_string(changedSP)+")":"")
          );
      if(test_bit(akt_lvl, RL_EXTRA_WIDE))
      {
        i=strlen(s); i-=2; s=s[0..i];
        if(test_bit(akt_lvl, RL_PET) && objectp(pet=FindHelpPet(owner)) ) { 
          k=getPetHpPercentage();
          changedAnimalPercent = k - lastAnimalHp;
          lastAnimalHp = k;
        } else { 
          k=0; 
        } 

        if(k) {
          s += sprintf("~[Tier: "+normal+"%3d"+color+"%s|%s]~",
              k,
               (lastAnimalHp==0?"":sprintf(normal+"(%+d)"+color, changedAnimalPercent)),
               (pet->QueryProp(P_RANGER_NEXT_ANIMAL_ATACK) < time()?" ":"!"));
        }

        if (test_bit(akt_lvl, RL_XP)) {
              s += sprintf("~[XP: "+normal+"%d"+color+"]", owner->QueryProp(P_XP));
        }
      }
    }

    tell_object(owner, s+normal+"\n"); 
    lastsp  = sp; lasthp  = hp;
    callout = 0;  lastHP  = hp; 
  }
  else if( !callout && (hp > lastHP+1) )
  { callout = 1;
    call_out("NotifyHpChange",0); }
  else { callout = 0; lastHP = hp; }
  lastSP = sp;
}

//-- Report aktivieren -------------------------------------------------------
nosave void activate(object ob) 
{
  mixed m;
  
  if(objectp(ob)) {
    if(stringp(m=ob->QueryProp(P_RANGER_REPORT_LEVEL))) {akt_lvl=m;}
     aktiv = 1;
    owner = ob;
    owner_name = getuid(owner);
    ob->AddHpHook(ME);
    lastHP = ob->QueryProp(P_HP);
    lastSP = ob->QueryProp(P_SP);
  } 
  else 
  { if(ob=(owner||TP)) { ob->RemoveHpHook(ME); }
  if(stringp(m=ob->QueryProp(P_RANGER_REPORT_LEVEL))) {akt_lvl=m;}
    owner = owner_name = aktiv = 0; }
}

//-- Report_cmd --------------------------------------------------------------
nosave int report(string str) 
{
  string *msg;

  notify_fail("Den Befehl gibt es nicht, Hilfe mit 'wlreport hilfe'.\n");
  if(!sizeof(msg=explode(str," "))) { return 0; }
  switch(msg[0])
  {
    case "ein":
      if (aktiv && objectp(owner)) { write("Der Report war schon aktiv.\n"); }
      else 
      { write("Der Report ist jetzt aktiv.\n");
        activate(TP); }
    break;
    
    case "aus":
      if (!aktiv) { write("Der Report ist schon ausgeschaltet.\n"); }
      else 
      { write("Der Report ist nun ausgeschaltet.\n");
        activate(0); }
    break;
    
    case "farben":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_COLOR); }
      else { write("Befehl: wlreport farben 0|1\n"); }
    break;
    
    case "max":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_MAX); }
      else { write("Befehl: wlreport max 0|1\n"); }
    break;
    
    case "spezial":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_SPECIAL); }
      else { write("Befehl: wlreport spezial 0|1\n"); }
    break;
    
    case "zauber":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_SPELL); }
      else { write("Befehl: wlreport zauber 0|1\n"); }
    break;
    
    case "gesinnung":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_ALIGN); }
      else { write("Befehl: wlreport gesinnung 0|1\n"); }
    break;
    
    case "teddy":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_TEDDY); }
      else { write("Befehl: wlreport teddy 0|1\n"); }
    break;
    
    case "erweitert":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_EXTRA_WIDE); }
      else { write("Befehl: wlreport erweitert 0|1\n"); }
    break;
    
    case "erfahrung":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_XP); }
      else { write("Befehl: wlreport erfahrung 0|1\n"); }
    break;
    
    case "tierleben":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_PET); }
      else { write("Befehl: wlreport tierleben 0|1\n"); }
    break;
    
    case "hilfe": 
      ShowReportHelp(); 
    break;

    default: return 0; break;
  }
  return 1;
}

//-- Report konfigurieren ----------------------------------------------------
nosave int ConfigureReport(string str, int what) 
{
  int flag;
  string anzeige;
  
  flag=to_int(str);
  anzeige="";
  if(flag<0 || flag>1) {  write("Falsche Eingabe!\n"); return 1; }
  if(flag==0) { akt_lvl=clear_bit(akt_lvl, what); }
  else { akt_lvl=set_bit(akt_lvl, what); }
  switch(what)
  {
    case RL_COLOR:      anzeige="Farben"; break; 
    case RL_MAX:        anzeige="maximalen Lebens\\Magiepunkte"; break;
    case RL_SPECIAL:    anzeige="Zustaende"; break; 
    case RL_SPELL:      anzeige="Zauberanzeige"; break;
    case RL_TEDDY:      anzeige="Teddyreport"; break;
    case RL_XP:         anzeige="Erfahrungspunkte"; break;
    case RL_PET:        anzeige="Gesundheit des Tieres"; break;
    case RL_EXTRA_WIDE: anzeige="Erweiterung"; break;
    case RL_ALIGN:      anzeige="Gesinnung"; break;
  }
  write(BS("Du hast jetzt die "+anzeige+" "+(flag?"ein":"ab")+"gestellt."));
  if(objectp(owner))
  { owner->SetProp(P_RANGER_REPORT_LEVEL, akt_lvl);
    owner->Set(P_RANGER_REPORT_LEVEL, SAVE, F_MODE_AS); }
  return 1;
}

//-- Ausgabe des Erweiterten Reports -----------------------------------------
nosave string SpecialReport(object owner) 
{
  string flags;

  flags="";
  if(owner->QueryProp(P_MV)*100/owner->QueryProp(P_MAX_MV)<10) {flags+="E";}
  else { flags+="_"; }
  if(owner->QueryProp(P_DEAF)) { flags+="T"; }
  else { flags+="_"; }
  if(owner->QueryProp(P_BLIND)) { flags+="B"; }
  else { flags+="_"; }
  if(owner->QueryProp(P_POISON)) { flags+="V"; }
  else { flags+="_"; }
  if(owner->QueryProp(P_FROG)) { flags+="F"; }
  else { flags+="_"; }
  if(owner->QueryProp(P_GHOST)) { flags+="G"; }
  else { flags+="_"; }
  if(owner->QueryProp(P_PARALYZED)) { flags+="P"; }
  else { flags+="_"; }
  if(time()<owner->QueryProp(P_NEXT_SPELL_TIME)) { flags+="N"; }
  else { flags+="_"; }
  return flags;
}
//**************************************************************************//



//** GildenWer *************************************************************//
//-- Sortfunktion ------------------------------------------------------------
int Sort(object a, object b)
{ if(a->Name(WER) < b->Name(WER)) { return 0; }
  return 1; }

//-- Welche Waldlaeufer sind online? -----------------------------------------
nosave int guild_who(string str)
{
  string s, name, circle_string, addon;
  mixed listener, m, env;
  object ob;
  int grad, gl, short, i;
  
  if(str == "kurz") {short=1;}
  else {short=0;}

  listener=filter_array(users(), "IsRanger");
  for(i=0;i<sizeof(MASTER_MAGES);i++)
  {
    if( (objectp(ob=find_player(MASTER_MAGES[i]))) && 
        (member(listener,ob)==-1) )
    { listener+=({ob}); }
  }
    
  listener=sort_array(listener,"Sort",ME);
  
  if(short) {s="Gilde Waldlaeufer:\n";}
  else
  { s="\n |"+std_colors[3]+"\\\\\\\\\\\\_"+normal+"\n |"+std_colors[3]+
      "\\\\\\\\\\\\\\\\\\\\_"+normal+"      GILDE\n |"+std_colors[3]+
      "\\\\\\\\\\\\\\\\\\\\\\\\\\_ "+normal+"      DER\n |"+std_colors[3]+
      "\\\\\\\\\\\\\\_"+normal+"               WALDLAEUFER\n |\n"; }
  
  for(i=0;i<sizeof(listener);i++) 
  {
    ob=listener[i];    
    if((ob->QueryProp(P_INVIS)) && !IS_WIZARD(TP)) { continue; }
    name=CAP(getuid(ob));
    gl=ob->QueryProp(P_GUILD_LEVEL);
    grad=GetGrad(gl);
    circle_string=circle_to_string(GetCircle(gl));
    if(ob->QueryProp(P_GENDER)==2) {circle_string+="in";}
    if(short)
    { s+=sprintf(" %+13s | (%s|%d)\n", name, circle_string, grad);
      continue; }
    env=ENV(ob);
    if(m=ob->InFight())
    { addon="Im Kampf"+(objectp(m)?" ["+m->Name(WER)+"]":""); }
    else if(query_idle(ob) >= 2*60)
    { addon="Rastend"+(stringp(m=ob->QueryProp(P_AWAY))?" ["+m+"]":""); }
    else
    { addon="Unterwegs";
      if(objectp(env) && pointerp(m=explode(file_name(env), "/")) )
      { switch(m[0])
        {
          case "gilden": addon+=" ["+CAP(m[1])+"]"; break;
          case "d":
            switch(m[1])
            {
              case "seher": addon+=" [Im Land der Seher]"; break;
              case "pk": addon+=" [Auf einem Schlachtfeld]"; break;
              case "event": break;
              default: addon+=" ["+CAP(m[1])+"]"; break;
            }
          break;
          default: addon+=" [Ausserhalb des bekannten SilberLandes]"; break;
        }
      }
    }
    s+=sprintf(" |    %-12s %-22s %+19s\n"
               " |    - %-70s \n"
               " |    - %-70s \n"
               " |\n"
               ,name
               ,(objectp(m=ob->QueryProp(P_WEAPON))?"{"+m->Name(WER)+"}":"")
               , sprintf("[%s|%d]", circle_string, grad)
               ,( (objectp(env) && 
                   stringp(m=env->QueryProp(P_INT_SHORT))) ? m : "In "
                   "unbekannten Gebiet")
               , addon
               );
  }
  if(!short)
  {
    s+=" \\   Welche Mitstreiter                               "
       +std_colors[3]+"/\\"+normal+"  \n  \\_              sind anwesend?    "
       "                 "+std_colors[3]+"//\\\\"+normal+" \n    \\~~~~~~~~~~"
       "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"+std_colors[3]+"///\\\\\\"
       +normal+"\n";
  }
  TP->More(s);
  return 1;
}
//**************************************************************************//



//** Gildeninternes Rufen (Magier/Spieler) *********************************//
//-- Vorfunktionen fuer das Wispern ------------------------------------------
int IsListener(object wer) 
{ if(!is_clone(wer) && wer->QueryProp(P_TMP_RANGER_LISTENER))  { return 1; }
  return 0; }

//-- Ein/Ausschalten des Fluesterns ------------------------------------------
void SetListener(int flag)
{
  if(MENV && interactive(MENV))
  {
    if(flag) { MENV->SetProp(P_TMP_RANGER_LISTENER, 1); }
    else { MENV->SetProp(P_TMP_RANGER_LISTENER, 0); }
  } 
  return;
}

//-- Gildenmagier? -----------------------------------------------------------
int IsWiz(object pl) { return (member(MASTER_MAGES,getuid(pl)) != -1); }

//-- Zusammengefasste Zuhoererfunktion ---------------------------------------
int is_wiz_or_listener(object ob)
{
  if(IsWiz(ob)) {return 1;}
  if(IsListener(ob)) {return 1;}
  return 0; 
}

//-- Ruf der Gildenmagier ----------------------------------------------------
nosave int mages_shout(string str)
{
  object *members, ob;
  string s, *msg;
  int i, k;
  
  ob=TP;
  if(!IsWiz(ob)) { return 0;}
  notify_fail("Was moechtest Du den anderen Gildenmagier mitteilen?\n");
  if (!stringp(str)) { return 0; }
  members=filter_array(users(),"IsWiz");
  for(i=0;i<sizeof(members);i++) 
  { 
    if(member(members[i]->QueryProp(P_IGNORE), "mwisper") != -1) {continue;}
    if(members[i]==ob) { s="Du teilst den Gildenmagiern mit:\n"; } 
    else { s="Gildenmagier (Waldlaeufer) "+std_colors[3]+CAP(getuid(ob))
             +normal+" teilt Euch mit:\n"; }
    msg=explode(break_string(str, 76), "\n");
    for(k=0;k<sizeof(msg);k++) {s+=" "+msg[k]+"\n";}
    members[i]->More(s);
  }
  GUILD_MASTER->AddMagesHistory(getuid(ob),ob->_unparsed_args());
  return 1;
}

//-- Gildenruf + Emote -------------------------------------------------------
nosave int guild_shout(string msg)
{
  string s, pre, p2, *str, name, n2;
  object *members, ob;
  int i, k, emote, invis;
  
  ob=TP;
  if(query_verb()=="wlemote") {emote=1;}
  else {emote=0;};
  notify_fail("Was soll der Wind den Waldlaeufern uebermitteln?\n");
  if (!stringp(msg)) { return 0; }
  if(ob->QueryProp(P_INVIS)) {invis=1;}
  name=ob->Name(RAW);
  if(invis) {name=CAP(getuid(ob));}
  if(interactive(ob)) { msg=ob->_unparsed_args(); }
  
  //Sprachfluch
  if(objectp(ob->QueryProp(P_PERM_STRING)))
  { msg=call_other(ob->QueryProp(P_PERM_STRING),"permutate_string",msg)||""; }
  
  members=filter_array(users(), "is_wiz_or_listener");
  pre=" "+((ob->QueryProp(P_GENDER)==FEMALE)?"von der":"vom");
  if(member(MASTER_MAGES, getuid(ob))!=-1 || ob->Name(WER)==GUILD_NPC)
  { pre+=" "+(ob->QueryProp(P_GENDER)==FEMALE?"Waldgoettin":"Waldavatara")+
         " "; }
  else
  { pre+=" "+circle_to_string(GetCircle(ob->QueryProp(P_GUILD_LEVEL)))+
         (ob->QueryProp(P_GENDER)==FEMALE?"in":"")+" "; }
  if(getuid(ob)=="torian")  { pre=" vom Waldopa "; }
    
  for(i=0;i<sizeof(members);i++) 
  {
    n2=name;
    p2=pre;
    k=IS_WIZARD(members[i]);
    if(member(members[i]->QueryProp(P_IGNORE), "wlwisper")!= -1 ) {continue;}
    if(members[i]->QueryProp(P_DEAF) && !k) {continue;}
    if(invis)
    { if(k) {n2="("+n2+")";   p2="von "+n2;}
      else  {n2="Ein Schatten"; p2="von einem Schatten";} }
    else { p2+=n2; }
    s="Der Wind traegt Euch eine Botschaft"+p2+" heran:\n";
    str=explode(break_string(msg, 60), "\n");
    for(k=0;k<sizeof(str);k++)
    {
      s+=sprintf("{%s%s%s}\n"
             ,(k?sprintf( "%"+to_string(1+!emote+strlen(n2))+"s", "")
                :n2+normal)
             ,(k?"":(emote?" ":": "))
             ,str[k]);
    }
    //DBD(members[i]->Name()+"\n"+s);
    members[i]->More(s);
  }
  GUILD_MASTER->AddHistory(getuid(ob), ob->_unparsed_args(), invis, emote);
  return 1;
}

//-- RangersHistory ----------------------------------------------------------
nosave varargs int ShowHistory(int n) 
{
  int i, k, iw;
  mixed history, m;
  string s, msg, *str, name;
  
  notify_fail("Befehl: <mwlhist nr> (1-20)\n");
  if(!n) n=20;
  n=limit(n,1,20);
  n--;
  history=GUILD_MASTER->QueryHistory();
  if(sizeof(m=m_indices(history))<1)
  { tell_object(TP,BS("Der Wind schweigt."));
    return 1; }
  
  s=std_colors[3]+"Diese Nachrichten kannst Du dem Wind entnehmen:\n~~~~~~~~~"
    "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
    +normal;
  iw=IS_WIZARD(TP);
  for(i=0;i<sizeof(m);i++) 
  {
    if(i>n) {break;}
    name=history[i, HIST_NAME];
    name=CAP(name);
    name=std_colors[3]+name+normal;
    if(history[i, HIST_INVIS])
    { if(iw) { name="("+name+")"; } 
      else {name="Ein Schatten"; } }
    msg=history[i, M_HIST_MSG];
    if(!history[i, HIST_EMOTE])
    { name+=":"; }
    name+=" ";
    s+=sprintf("%s:\n",dtime(history[i, HIST_TIME]) );
    msg=name+msg;
    str=explode(break_string(msg, 76), "\n");
    for(k=0;k<sizeof(str);k++) {s+=(!k?"":"  ")+str[k]+"\n";}
    s+="\n";
  }
  s+=std_colors[3]+"\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
     "~~~~~~~~~~~~~~~~~~~~~~~\n"+normal;
  TP->More(s);
  return 1;  
}

//-- MagierHistory -----------------------------------------------------------
nosave int ShowMagesHistory(int n) 
{
  int i, k;
  mixed history, m;
  string s, msg, *str, name;
  
  notify_fail("Befehl: <mwlhist nr> (1-20)\n");
  if(!n) n=20;
  n=limit(n,1,20);
  n--;
  history=GUILD_MASTER->QueryMagesHistory();
  if(sizeof(m=m_indices(history))<1)
  { tell_object(TP,BS("Die Gildenmagier haben Dir noch nichts mittgeteilt."));
    return 1; }
  
  s=std_colors[3]+"Das haben Dir die anderen Gildenmagier mitgeteilt:\n~~~~~~"
    "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    "\n"+normal;
  for(i=0;i<sizeof(m);i++) 
  {
    if(i>n) {break;}
    msg=history[i, M_HIST_MSG];
    name=history[i, M_HIST_NAME];
    name=CAP(name);
    s+=sprintf("%s <%s>:\n"
              ,name
              ,dtime(history[i, M_HIST_TIME]) );
    str=explode(break_string(msg, 76), "\n");
    for(k=0;k<sizeof(str);k++) {s+="  "+str[k]+"\n";}
  }
  s+=std_colors[3]+"\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
     "~~~~~~~~~~~~~~~~~~~~~~~\n"+normal;
  TP->More(s);
  return 1;  
}
//**************************************************************************//



//** Waldlaeufer Info ******************************************************//
//-- Balken ausgeben ---------------------------------------------------------
string get_bars(int percent)
{
  string s;
  int i;
  
  percent=limit(percent,0,100);
  percent=percent/10; s="";
  for(i=0;i<10;i++) { s+=(percent>i?"#":"."); }
  //if(strlen(s)!= 10) { s="..........";}
  return s;
}

//-- Belastungsbalken --------------------------------------------------------
int get_belastung(object ob)
{
  float f;
  int i;
  
  f=to_float((ob->QueryProp(P_TOTAL_WEIGHT))-(ob->QueryProp(P_WEIGHT)))/to_float((ob->QueryProp(P_MAX_WEIGHT)));
  i=limit(to_int(f*100),0,100);
  return i;
}

//-- Ausdauerbalken ----------------------------------------------------------
int get_ausdauer(object ob)
{
  float f;
  int i;
  
  f=to_float(ob->QueryProp(P_MV))/to_float(ob->QueryProp(P_MAX_MV));
  i=to_int(f*100);
  return i;
}

//-- Environment-Beschreibung ------------------------------------------------
string get_env_description(int env)
{
  string s;
  
  switch(env)
  {
    case TT_CAVE:       s="in einer Hoehle";         break;
    case TT_HOUSE:      s="in einem Haus";           break;
    case TT_HILL:       s="in huegeligen Land";      break;
    case TT_FOREST:     s="im Wald" ;                break;
    case TT_TOWN:       s="in der Stadt";            break;
    case TT_MOUNTAIN:   s="im Gebirge";              break;
    case TT_DESERT:     s="in der Wueste";           break;
    case TT_JUNGLE:     s="im Dschungel";            break;
    case TT_SWAMP:      s="in einem Sumpf";          break;
    case TT_PLAIN:      s="auf einer Ebene";         break;
    case TT_ARCTIC:     s="in arktischen Gefilden";  break;
    case TT_UNDERWATER: s="unter Wasser";            break;
    case TT_WATER:      s="im Wasser";               break;
    case TT_ROAD:       s="auf einer Strasse";       break;
    case TT_AIR:        s="in der Luft";             break;
    default:            s="in unbekannter Umgebung"; break;
  }
  return s;
}

public string petStatus() {
  object pet;
  int levelProgress;
  string progressStr;

  if(!objectp(pet=FindPet(owner))) {
    return "keines";
  }

  if(pet->QueryProp(P_LEVEL) >= pet->QueryProp(P_RANGER_MAX_PET_LEVEL)) {
    return sprintf("%-30s     [%|10d]   ", sprintf("%s (%s)", pet->Name(RAW), pet->QueryProp(P_RACE)), pet->QueryProp(P_LEVEL));
  }

  levelProgress = 10*pet->QueryProp(P_XP)/pet->GetNextLevelXp();

  progressStr = "";
  for(; levelProgress > 0; --levelProgress) {
    progressStr += "#";
  }

  return sprintf("%-30s  %d [%-10s] %d", sprintf("%s (%s)", pet->Name(RAW), pet->QueryProp(P_RACE)), pet->QueryProp(P_LEVEL), progressStr, pet->QueryProp(P_LEVEL)+1);
}

//-- Hauptfunktion -----------------------------------------------------------
int wlinfo(string cmd) 
{
  string s, *ae;
  object ob;
  mixed m, n, p;
  int i, j, k, l;

  ob=TP;
  if(ob->QueryProp(P_GHOST)) 
  { tell_object(ob, BS("Als Geist ist das nicht moeglich!\n"));
    return 1; }
    
  s="\n       "+std_colors[3]+"/\\"+normal+"                                 "
    "                            "+std_colors[0]+"__"+normal+" \n      "
    +std_colors[3]+"//\\\\"+normal+"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    "~~~~~~~~~~~~~~~~~~"+std_colors[0]+"(__)"+normal+"\n";

  //Titel/Presay
  if(ob->QueryProp(P_INVIS)) { m="("+CAP(getuid(ob))+")";}
  else 
  { 
    m=ob->short(); 
    if(m[<1]=='\n') { m=m[0..<2]; } 
  }
  m=m[0..54];
  i=55; 
  n=explode(m, "\b");
  j=sizeof(n);
  j--;
  if(j>0) {i+=(2*j);}
  s+=sprintf("     "+std_colors[3]+"///\\\\\\"+normal+"  %|"+to_string(i)+"s "
             +std_colors[0]+"(__)"+normal+"\n", m); 
  s+="    "+std_colors[3]+"////\\\\\\\\"+normal+"~~~~~~~~~~~~~~~~~~~~~~~~+~~~"
     "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"+std_colors[0]+"(__)"+normal+"\n";
  
  //Erste 3 Attribute, Leben, Magie
  s+=sprintf(
       "   "+std_colors[3]+"////"+normal+"||"+std_colors[3]+"\\\\\\\\"
       +normal+"     Ausdauer: %2d(%+3d) | Magie: %4d/%4d             "
       +std_colors[0]+"__"+std_colors[0]+"(__)"+normal+std_colors[0]+"___"
       +normal+"\n"+std_colors[3]+" _/////"+normal+"||"+std_colors[3]+
       "\\\\\\\\\\_"+normal+"    Staerke: %2d(%+3d) | Leben: %4d/%4d         "
       "  "+std_colors[0]+"/__________\\"+normal+"\n   "+std_colors[3]+"_///"
       +normal+"||"+std_colors[3]+"\\\\\\\\_"+normal+"    Geschick: %2d(%+3d)"
       " +~~~~~~~~~~~~~~~~~~~~~~~~~~~"+std_colors[0]+"(/"+normal+"   | "
       +std_colors[2]+"|"+normal+"|   "+std_colors[0]+"\\)"+normal+"\n"
      ,ob->QueryProp(P_ATTRIBUTES)[A_CON]
      ,ob->QueryAttributeOffset(A_CON)
      ,ob->QueryProp(P_SP)
      ,ob->QueryProp(P_MAX_SP)
      ,ob->QueryProp(P_ATTRIBUTES)[A_STR]
      ,ob->QueryAttributeOffset(A_STR)
      ,ob->QueryProp(P_HP)
      ,ob->QueryProp(P_MAX_HP)
      ,ob->QueryProp(P_ATTRIBUTES)[A_DEX]
      ,ob->QueryAttributeOffset(A_DEX)
      );
      
  //4. Attribut, Kreis, Attributpunkte, Rang, Pfade, Level, Fertigkeitspunkte
  i=ob->QueryProp(P_GUILD_LEVEL);
  m=RANGERMASTER->GetPaths(getuid(TP));
  if(!m || !pointerp(m) || sizeof(m)<1) {
    n="";
  }
  else {
    if(stringp(RANGERMASTER->GetMasterPath(getuid(TP)))) {
      m[member(m, RANGERMASTER->GetMasterPath(getuid(TP)))] = "*"+RANGERMASTER->GetMasterPath(getuid(TP));
    }
    n=sprintf("%-23s", implode(m, ", "))[0..21];
  }
  j=ob->LpLevel(); //das richtige Level des Spielers 
  
  s+=sprintf(
       std_colors[3]+"_//////"+normal+"||"+std_colors[3]+"\\\\\\\\\\\\\\\_"+normal+"    Geist: %2d(%+3d) |  Kreis: %-22s | "+std_colors[2]+"|"+normal+"|\n "+std_colors[3]+"_/////"+normal+"||"+std_colors[3]+"\\\\\\\\_"+normal+" Attributpunkte:  %2d  |   Rang: %-22d | "+std_colors[2]+"|"+normal+"|\n"+
       std_colors[3]+"_//////"+normal+"||"+std_colors[3]+"\\\\\\\\\\\\_"+normal+"~~~~~~~~~~~~~~~~~~~~+  Pfade: %-22s | "+std_colors[2]+"|"+normal+"|\n"
       "       ||   %d [%-'.'*s] %d+ |  Fertigkeitspunkte: %-10d | "+std_colors[2]+"|"+normal+"|\n       || Spielerlevel:         %3d +~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~| "+std_colors[2]+"|"+normal+"|\n" 
      ,ob->QueryProp(P_ATTRIBUTES)[A_INT]
      ,ob->QueryAttributeOffset(A_INT)
      ,circle_to_string(GetCircle(i))
      ,ob->QueryProp(P_AP)
      ,GetGrad(i)
      ,n
      ,j
      ,(p=18-strlen(to_string(j))-strlen(to_string(j+1)))
      ,sprintf("%'#'*s", ob->LevelPerc(j+1)*p/100,"")
      ,(j+1)
      ,R_SKILLMASTER->GetFreeSkillPoints(getuid(TP))
      ,ob->QueryProp(P_LEVEL)
      );
      
  //Erfahrung, Belastung, QPs, Ausdauer, Rasse, Vermoegen
  m=get_bars(get_belastung(ob));
  n=get_bars(get_ausdauer(ob));
  s+=sprintf(
       "       || Erfahrung:     %10d | Belastung:        [%10s] | "
       +std_colors[2]+"|"+normal+"|\n       || Abenteuer:      %4d/%4d |  "
       "Ausdauer:        [%10s] | "+std_colors[2]+"|"+normal+"|\n      /  \\"
       "Rasse: %18s | Vermoegen:  %10d Muenzen | "+std_colors[2]+"|"+normal+
       "|\n     +    +~~~~~~~~~~~~~~~~~~~~~~~~~+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
       "~~~| "+std_colors[2]+"|"+normal+"|\n"
      ,ob->QueryProp(P_XP)
      ,m
      ,ob->QueryProp(P_QP)
      ,QUESTMASTER->QueryAllQP()
      ,n
      ,(ob->QueryProp(P_RACE)[0..17])
      ,ob->QueryDeepMoney()
      );
      
  //Poison, Blind, Deaf, Frog
  if( (ob->QueryProp(P_POISON)) || (ob->QueryProp(P_BLIND)) ||
      (ob->QueryProp(P_DEAF))   || (ob->QueryProp(P_FROG)) )
  {
    m=({});
    if(i=ob->QueryProp(P_POISON) )
    { m+=({(i<4 ? "leicht vergiftet" : "vergiftet")}); }
    if(ob->QueryProp(P_BLIND) ) { m+=({"blind"}); }
    if(ob->QueryProp(P_DEAF) )  { m+=({"taub"}); }
    if(ob->QueryProp(P_FROG) )  { m+=({"verfroscht"}); }
    if(sizeof(m)>0)
    {
      n=m[0];
      if(sizeof(m)>1)
      {
        p=({m[sizeof(m)-1]});
        p+=({m[sizeof(m)-2]});
        n=implode(p, " und ");
        m-=p; m+=({""});
        if(sizeof(m)>0) { n=implode(m, ", ")+n; }
      }
      n+=".";
      s+=sprintf("     | Du bist %-53s | "+std_colors[2]+"|"+normal+"|\n",n);
    }
  }
  
  //Vorsicht, Gesinnung, Alter
  s+=sprintf(
       "     | Rueckzug: %3d%:-48s | "+std_colors[2]+"|"+normal+"|\n     | "
       "Einstellung: %-48s | "+std_colors[2]+"|"+normal+"|\n     | Alter: "
       "%-54s | "+std_colors[2]+"|"+normal+"|\n"
      ,ob->QueryProp(P_WIMPY)
      ,(ob->QueryProp(P_WIMPY_DIRECTION)? ", Fluchtrichtung: "
        +to_string(ob->QueryProp(P_WIMPY_DIRECTION)):"")
      ,GetAlign(ob->QueryProp(P_ALIGN))
      ,ob->get_age()
      );
      
  //Umgebungsbeschreibung
  m=explode(file_name(ENV(ob)), "/");
  if(member( ({"d","gilden"}), m[0]) == -1) 
  { n="Du hast keine Ahnung wo Du bist."; }
  else 
  {
    if(m[0] == "gilden") {n="Gildengebiet";}
    else { n=CAP(m[1]); }
    n+=", Du bist ";
    if(!objectp(ENV(ob))) {p=0;}
    else {p=ENV(ob)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN];}
    n+=get_env_description(p); n+=".";
    n=n[0..50];
  }
 
  s+=sprintf(
       "     | Umgebung: %-51s | "+std_colors[2]+"|"+normal+"|\n"
       "     | Erzfeindrasse: %-46s | "+std_colors[2]+"|"+normal+"|\n"
       "     | Tier: %-55s | "+std_colors[2]+"|"+normal+"|\n"
       "     +~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~| "+std_colors[2]+"|"+normal+"|\n",
       n,
       implode(map_array(RANGERMASTER->GetArchenemy(getuid(ob)), "get_race_plural", find_object(RANGERMASTER)), ", "),
       petStatus()
  );
       
  //Forscherfortschritt
  m=explode(break_string(ob->Forschung(), 61), "\n");
  for(i=0;i<sizeof(m);i++)
  { s+=sprintf("     | %-61s | "+std_colors[2]+"|"+normal+"|\n", m[i]); }
  
  // Feinde aufzaehlen (direkt uebernommen)
  m=((mixed) ob->QueryEnemies())[0];
  if(sizeof(m))
  {
    n=({});
    p=all_inventory(ENV(ob));
    for(i=0;i<sizeof(m);i++)
    { if(member_array(m[i], p) == -1) { n+=({m[i]}); } }
    if(sizeof(n))
    {
      m=explode(break_string("Du verfolgst "
          +ob->CountUp(map_objects(n,"name",WEN))+".", 61), "\n");
      for(i=0;i<sizeof(m);i++)
      { s+=sprintf("     | %-61s | "+std_colors[2]+"|"+normal+"|\n"
                     , to_string(m[i])); }
    }
  }
  
  //Abschluss
  s+="     +~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\"
     " "+std_colors[2]+"|"+normal+"/\n                                       "
     "                               \\/\n";
  TP->More(s);
  return 1; 
}

//-- Die Kurzversion ---------------------------------------------------------
/*
  Werte: Leben, Magie, Attris, Taub/blind..., Erschoepfung, Belastung, 
  Vorsicht, XP, Levelanstieg, im Wald?
*/
int wlinfo_short()
{
  object ob;
  int i, j;
  string s;
  mixed m,n,p;
  
  if(!objectp(ob=ENV(TO))) {return 1;}
  i=ob->LpLevel();
  s=sprintf(
       "\n      /\\~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
       "~~+\n     //\\\\  %|56s |\n   _///\\\\\\~~~~~~~~~~~~~~~~~~~~~~~~~+~~~"
       "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~|\n    //||\\\\\\_     Ausdauer: "
       "%2d(%+3d) | Magie: %3d/%3d Leben: %3d/%3d  |\n _////||\\\\\\\\_     "
       "Staerke: %2d(%+3d) +~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~+\n  "
       "_///||\\\\\\\\\\\\_  Geschick: %2d(%+3d) | Belastung:        [%10s] "
       "|\n      ||            Geist: %2d(%+3d) | Ausdauer:         [%10s] "
       "|\n      ||  %d [%-'.'*s] %d+  | Erfahrung:          %10d |\n      "
       "||  Rueckzug: %3d%:-44s |\n"
      ,"Du bist "+(IsInForest(ob)?"im Wald, Deine Zauber "
        "sind nun staerker!":"nicht im Wald, Deine Zauber sind nun "
        "schwaecher!")
      ,ob->QueryProp(P_ATTRIBUTES)[A_CON]
      ,ob->QueryAttributeOffset(A_CON)
      ,ob->QueryProp(P_SP)
      ,ob->QueryProp(P_MAX_SP)
      ,ob->QueryProp(P_HP)
      ,ob->QueryProp(P_MAX_HP)
      ,ob->QueryProp(P_ATTRIBUTES)[A_STR]
      ,ob->QueryAttributeOffset(A_STR)
      ,ob->QueryProp(P_ATTRIBUTES)[A_DEX]
      ,ob->QueryAttributeOffset(A_DEX)
      ,get_bars(get_belastung(ob))
      ,ob->QueryProp(P_ATTRIBUTES)[A_INT]
      ,ob->QueryAttributeOffset(A_INT)
      ,get_bars(get_ausdauer(ob))
      ,i
      ,(j=18-strlen(to_string(i))-strlen(to_string(i+1)))
      ,sprintf("%'#'*s", ob->LevelPerc(i+1)*j/100,"")
      ,(i+1)
      ,ob->QueryProp(P_XP)
      ,ob->QueryProp(P_WIMPY)
      ,(ob->QueryProp(P_WIMPY_DIRECTION)? ", Fluchtrichtung: "
        +to_string(ob->QueryProp(P_WIMPY_DIRECTION)):"")
      );

  //Poison, Blind, Deaf, Frog
  if( (ob->QueryProp(P_POISON)) || (ob->QueryProp(P_BLIND)) ||
      (ob->QueryProp(P_DEAF))   || (ob->QueryProp(P_FROG)) )
  {
    m=({});
    if(i=ob->QueryProp(P_POISON) )
    { m+=({(i<4 ? "leicht vergiftet" : "vergiftet")}); }
    if(ob->QueryProp(P_BLIND) ) {m+=({"blind"}); }
    if( TP->QueryProp(P_DEAF) ) {m+=({"taub"}); }
    if( TP->QueryProp(P_FROG) ) {m+=({"verfroscht"}); }
    if(sizeof(m)>0)
    {
      n=m[0];
      if(sizeof(m)>1)
      {
        p=({m[sizeof(m)-1]});
        p+=({m[sizeof(m)-2]});
        n=implode(p, " und ");
        m-=p; m+=({""});
        if(sizeof(m)>0) { n=implode(m, ", ")+n; }
      }
      n+=".";
      s+=sprintf("      ||  Du bist %-49s | \n",n);
    }
  }
  
  //MetallTest
  if(QueryMetal(ob))
  { s+=sprintf("      ||  Du bist %-49s | \n",
               "Du traegst zuviel Metall bei Dir!"); }
   
  s+="     \\\\\\\\__________________________________________________________"
     "_|\\\n     ////                                                        "
     "   |/\n";
  ob->More(s);
  return 1;
}
