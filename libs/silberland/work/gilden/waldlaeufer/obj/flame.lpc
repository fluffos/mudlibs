inherit "std/thing";
#include "../def.h"
#include "/spellbooks/waldlaeufer/std/restrictions.lpc"

#define NONE 0
#define BLUE 3
#define VIOLETT 9

int counter, type, *dam, time, is_collapsed;
object owner, weapon;

//** StandardFunktionen ****************************************************//
//-- Create eines typischen Invisobjekts -------------------------------------
void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_GENDER, FEMALE); 
  AddId(FLAME_CONTROL_ID);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_KILL_NAME, "Die Gier nach dem Sieg");
  counter=0;
  type=NONE;
  dam=({});
}

//-- Remove, alles moegliche rueckgaengig machen -----------------------------
int remove()
{
  object ob;
  
  if(objectp(ob=ENV(TO)))
  {
    ob->SetProp(P_PARALYZED, 0);
    ob->SetProp(P_TMP_DIE_HOOK, 0);
    ob->SetProp(P_TMP_ATTACK_HOOK, 0);
    ob->SetProp(P_TMP_MOVE_HOOK, 0);
    ob->SetProp(P_TMP_DEFEND_HOOK, 0);
    if(weapon) {weapon->Set(P_CURSED, 0, F_QUERY_METHOD);}
  }
  return ::remove(1);  
}

//-- Der Reset (sollte es eigentlich nie erleben) ----------------------------
void reset()
{ if (!is_clone(TO)) return;
  remove(); }
  
//-- Anpassung ---------------------------------------------------------------
int customize(int blue, int ability, int success, int t)
{
  int i, b;
  
  if(objectp(ENV(TO)))
  { 
    owner=ENV(TO);
    if(blue) {type=BLUE;}
    else {type=VIOLETT;}
    time=t; b=100;
    is_collapsed=0;
    call_out("collapse", 1+t-time(), "Die Zeit, welche Dir zur Verfuegung "
                                     "gestellt wurde, ist abgelaufen und die "
                                     "Kraft der Flamme versiegt!");
    weapon=owner->QueryProp(P_WEAPON);
    weapon->Set(P_CURSED, BS("Du kannst keine Waffe wegstecken, Die von der "
                          "Macht der Flamme durchzogen ist."),F_QUERY_METHOD);
    /*Jetzt wird festgelegt, wieviele Runden die Flamme maximal haelt,
      ob die Flamme den caster am Leben erhaelt, und legt einen array mit
      dem schaden an, der verteilt wird. der Schaden steigt und wird dann
      schwaecher, der schaden wird in einem array gesetzt
    */
    if(type==VIOLETT) {b+=100;}
    
    //Skillpoint
    if(R_SKILLMASTER->HasSkill(getuid(owner), KLINGENMEISTER)) 
    { b+=50+random(50); }
    
    counter=(ability*(MAX_FLAME_ROUNDS/2))/10000;
    for(i=1;i<=counter;i++)
    { dam+=({(success/100)+b+((200*i)/(MAX_FLAME_ROUNDS/2)) }); }
    for(i=counter;i>0;i--)
    { dam+=({(success/100)+b+((250*i)/(MAX_FLAME_ROUNDS/2)) }); }
    counter=2*counter;
    if(counter>sizeof(dam)) counter=sizeof(dam);
    return 1;}
  return 0;
}

//-- Testfunktion ------------------------------------------------------------
mixed QueryDamList() {return dam;}
mixed QueryCounter() {return counter;}
//-- Farbtest/ermittlung -----------------------------------------------------
int is_blue() {return (type==BLUE);}
int is_violett() {return (type==VIOLETT);}
//**************************************************************************//



//** Der Zusammenbruch *****************************************************//
//-- Der eigentliche Zusammenbruch -------------------------------------------
void collapse(string msg)
{
  int t;
  
  if(!objectp(owner))
  {
    remove();
    return;
  }
  if(is_collapsed) return;
  is_collapsed=1;
  t=40-(owner->QueryProp(P_GUILD_LEVEL));
  if(!t) t=20;
  if(ENV(owner))
  {
    tell_room(ENV(owner),BS(owner->Name(WEN, 1)+" scheinen ploetzlich die "
                         "magischen Kraefte zu verlassen. Der magische "
                         "Schimmer verschwindet und "+owner->name(WER, 1)+
                         " sackt kraftlos zusammen."), ({owner}));
  }
  tell_object(owner, BS(msg+" Die Kraefte der Flamme verlassen Dich, Du "
                         "sinkst kraftlos nieder und brichst zusammen. Dein "
                         "Herz rast noch."));
  owner->SetProp(P_PARALYZED, ([PARALYZE_TIME: t,
                                PARALYZE_MSG: BS("Du musst erst Dein Herz "
                                              "wieder zur Ruhe kommen lassen"
                                              ". Sonst wuerdest Du einfach "
                                              "kollabieren!"),
                                PARALYZE_MSG_OTHER: "%s liegt zitternd am "
                                                    "Boden.\n",
                                PARALYZE_END: "Dein Herz hat sich wieder "
                                              "beruhigt.\n",
                                PARALYZE_END_OTHER: "%s steht auf.\n"]));
  owner->do_exhaust(t*25, 1);
  call_out("remove",t*2);
  return;
}

//-- ein Test ob noch im Kampf -----------------------------------------------
void fight_test()
{
  //DBD("\n~~~~~~~~~~ Aufgerufen ~~~~~~~~~~~~~\n");
  if(!objectp(owner)) {remove(); return;}
  if(!(owner->InFight())) 
  { collapse("Der Kampf ist beendet, die Flamme verlaesst Dich."); return;}
  if(!weapon)
  { collapse("Deine Waffe ist verschwunden, Die Flamme stuerzt sich auf "
             "Deine inneren Kraefte!"); return;}
  return;
}

//-- Die Bedingungen gesammelt (ausser counter und InFight) ------------------
int collapse_test()
{
  object *enemies;
  int i;
  
  if(!objectp(owner)) {remove(); return 0;}
  if(!objectp(weapon))
  { collapse("Deine Waffe ist verschwunden, Die Flamme stuerzt sich auf "
             "Deine inneren Kraefte!"); return 0;}
  if(time() >= time)
  { collapse("Die Zeit, welche Dir zur Verfuegung gestellt wurde, ist "
             "abgelaufen und die Kraft der Flamme versiegt!"); return 0;}
  if(type != BLUE && type != VIOLETT) 
  {
    //DBD("test-flame.lpc"); 
    remove();
    return 0;
  }
  if(sizeof(enemies=owner->PresentEnemies()) < 1)
  { collapse("Du hast zu wenig Feinde fuer Die verzehrende Kraft der "
             "Flamme!"); return 0;}
  
  //Ab hier immer return 1; <-  beachten!
  if(type==BLUE)
  {
    /*for(i=0;i<sizeof(enemies);i++)
    {
      if(IsDemonDragonGolem(enemies[i]))
      { owner->Message(BS(enemies[i]->Name(WER, 1)+" ist kein Opfer der "
                       "blauen Flamme, Die Kraft schwindet schneller und "
                       "raubt Dir Energie!")); 
        if(random(3)) {owner->AddSp(-random(5));}
        else {owner->AddHp(-random(5));}
        counter-=1+random(2);
        return 1;}
    }*/
    return 1;
  }
  else if(type==VIOLETT)
  {
    for(i=0;i<sizeof(enemies);i++)
    {
      if(!IsUndead(enemies[i]))
      { owner->Message(BS(enemies[i]->Name(WER, 1)+" ist kein Untotes Wesen. "
                       "Du verlierst langsam die Macht ueber die Flamme!")); 
        if(random(3)) {owner->AddSp(-random(5));}
        else {owner->AddHp(-random(5));}
        counter-=1+random(2);
        return 1;}
    }
  }
  return 1;
}
//**************************************************************************//



//** Hooks *****************************************************************//
//-- Diese Funktion wird bei jedem Attack() des spielers aufgerufen ----------
mixed attack_hook(object enemy)
{
  int i, d;
  object *enemies;
  mixed dts;
  
  //DBD("aufgerufen:"+to_string(enemy));
  if(owner)
  {
    call_out("fight_test", 4);
    if(!collapse_test()) {return 0;}
    if(counter<1)
    { collapse("Du hast die Macht der Flamme verbraucht, die Flamme "
               "verlaesst Dich.");
      return 0;}
    enemies=owner->PresentEnemies();
    if(type==VIOLETT) { dts=({DT_FIRE, DT_LIGHT, DT_HOLY}); }
    else { dts=({DT_MAGIC}); }
    for(i=0;i<sizeof(enemies);i++)
    {
      d=0;
      if(IsDemonDragonGolem(enemies[i])) { d+=50+random(50); }
      enemies[i]->Defend(  d+dam[sizeof(dam)-counter]
                         , dts
                         , ([SP_SHOW_DAMAGE:1])
                         , owner);
    }
    counter--;
  }
  return 0;
}
//**************************************************************************//