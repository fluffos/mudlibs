#include "../def.h"
inherit "std/thing";

object animal;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_GENDER, MALE);
  AddId(ANIMAL_CONTROL_ID);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}

int get_control(object pet)
{
  object ob;
  
  animal=pet;
  ob=ENV(TO);
  if( !(ob) )              {return 0;}
  if( !(interactive(ob)) ) {return 0;}
  ob->Message(BS("Was soll dein Begleiter tun?"));
  input_to("cmd");
  return 1;
}

nosave void cmd(string str)
{
  object ob;
  
  ob=ENV(TO);
  //DBD("CMD_CONTROL aufgerufen: "+str);
  if(str == "abbruch"   || 
     str == "ende"      || 
     str == "schluss"   || 
     str == "abbrechen" ||
     str == "aufhoeren") 
  {
    ob->SetProp(P_TMP_MOVE_HOOK, ({time()+4, ob, "disable"}));
    ob->SetProp(P_TMP_ATTACK_HOOK, ({time()+4, ob, "disable"}));
    ob->SetProp(P_TMP_DEFEND_HOOK, ({time()+4, ob, "disable"}));
    call_out("remove", 0);
    return;
  }
  animal->explore(str, TO);
  ob->Message(BS("Was soll dein Begleiter jetzt tun?\n"
                 "(<abbruch> zum beenden)"));
  input_to("cmd2");
  return;  
}
nosave void cmd2(string str)
{
  object ob;
  
  ob=ENV(TO);
  //DBD("CMD_CONTROL_2 aufgerufen: "+str);
  if(str == "abbruch"   || 
     str == "ende"      || 
     str == "schluss"   || 
     str == "abbrechen" ||
     str == "aufhoeren") 
  {
    ob->SetProp(P_TMP_MOVE_HOOK, ({time()+4, ob, "disable"}));
    ob->SetProp(P_TMP_ATTACK_HOOK, ({time()+4, ob, "disable"}));
    ob->SetProp(P_TMP_DEFEND_HOOK, ({time()+4, ob, "disable"}));
    call_out("remove", 0);
    return;
  }
  animal->explore(str, TO);
  ob->Message(BS("Was soll dein Begleiter jetzt tun?\n"
                 "(<abbruch> zum beenden)"));
  input_to("cmd");
  return;  
}

string disable()
{ return "Du gewinnst nach und nach Kontrolle ueber deinen eigenen Geist."; }

int remove()
{
  if(animal)
  { ENV(TO)->Message(BS(animal->Name(WER)+" hat Deinen Wunsch erfuellt und "
    "verschwindet."));
    call_other(animal, "remove", 0); }
  return ::remove();
}