#include "../def.h"

mapping data;
mapping res_str;

nosave string *RELEVANT_PROPS = ({
    P_RANGER_PET_RACE, P_SHORT, P_LONG, P_NAME, P_GENDER, P_RANGER_PET_OWNER, 
    P_IDS, P_CLASS, P_ARTICLE, P_LEVEL, P_RANGER_MAX_PET_LEVEL, P_ATTRIBUTES,
    P_MAX_HP, P_MAX_SP, P_HANDS, P_BODY, P_XP, P_RACE, P_SIZE, P_WEIGHT,
    P_MAX_HANDS, P_ALIGN, P_NOMAGIC, P_MSGIN, P_MSGOUT,
    P_MMSGIN, P_MMSGOUT, P_DIE_MSG, P_NOCORPSE, P_MURDER_MSG, P_KILL_NAME,
    "ranger_pet_remove_time", P_HP, P_SPELLS, P_SPELLRATE, P_NPC_SPELL_VECTOR,
    P_RANGER_PET_RENAMED
  });
  
  

public void create() {
    data= ([]);
}

public int multiplyBy100(mixed n, mixed m) {
   // tell_object(find_player("gwenshara"), sprintf("n=%O m=%O\n", n, m));
    return (int) (m[n]*100);
}

public void copyData(object pet) {
    int i;

    for(i=0; i<sizeof(RELEVANT_PROPS); ++i) {
        data += ([RELEVANT_PROPS[i]: pet->QueryProp(RELEVANT_PROPS[i])]);
    }

    // save_object speichert floats in eine rmap inkorrekt.
    res_str = pet->QueryProp(P_RESISTANCE_STRENGTHS);
    if(mappingp(res_str)) {
        res_str = map_mapping(res_str, "multiplyBy100", TO, res_str);
    } else {
        res_str = ([]);
    }

    return;
}

public void Save(object owner) {
    save_object(MEMBERS_PETS+getuid(owner));
    return;
}

// wel wir ein problem beim speichern von floats in maps haben
public float divideBy100(mixed n, mixed m) {
  //  tell_object(find_player("gwenshara"), sprintf("n=%O m=%O\n", n, m));
    return ((float) (m[n]/100.0));
}

public void LoadFrom(string s) {
    restore_object(s);
    data += ([P_RESISTANCE_STRENGTHS: map_mapping(res_str, "divideBy100", TO, res_str)]);
    return;
}

public mapping GetData() {
    return data;
}