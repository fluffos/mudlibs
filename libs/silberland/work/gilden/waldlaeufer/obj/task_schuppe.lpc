#include "../def.h"
#include "../ranger.h"
#include "../ranger_tasks.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine unbekannte Schuppe");
  SetProp(P_LONG,
    "Diese Schuppe wurde bei den Wilderern im suedlichen Tethyrwald gefunden. "
    "Sie ist Raziel und den Waldlaeufern unbekannt. Du sollst herausfinden "
    "woher sie stammt. Sie schimmert dunkelgruen und scheint extrem hart.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schuppe");
  SetProp(P_ADJECTIVES, "unbekannt");
  SetProp(P_GENDER, FEMALE);
  AddId(({"QUESTOBJ", RANGER_TASK_SCHUPPE, "schuppe"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 10);;
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}
