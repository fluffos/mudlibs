//-- Inherite, Include, Defines ----------------------------------------------
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../../def.h"

mapping m;
mixed beeren, nuesse, fleisch;
//**************************************************************************//



//** StandardFunktionen fuer Nahrung ***************************************//
//-- Create() ----------------------------------------------------------------
create()
{
  if (!is_clone(ME)) return;

  ::create( ({"iss","esse"}) );     
  
  
  beeren=({"Blaubeere", "Stachelbeere", "Johannisbeere", 
           "Waldbeere", "Fubarbeere", "Gruenbeere"});
  nuesse=({"Walnuss","Erdnuss","Haselnuss",
           "Gaffonuss","Kastanie","Paranuss"});
  fleisch=({"Hasenflanke","Hasenohr","Wieselmagen",
            "Huehnerbrust","Huehnerfluegel","Biberschwanz"});
  m=([BEERE: beeren, NUSS: nuesse, FLEISCH: fleisch]);
  
  SetProp(P_VALUE, 5+random(5));
  SetProp(P_WEIGHT, 20+random(30));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
}

//-- Keine Wiederverwendung --------------------------------------------------
second_life(object pl) { return 0; }

//-- Loest sich ausserhalb eines geeigneten Containers auf -------------------
void reset()
{
  if (!is_clone(this_object())) return;
  if(!objectp(ENV(TO))) return;
  if( member(ENV(TO)->QueryProp(P_IDS), FOOD_CONTAINER_ID) != -1 )
  { ::reset(); }
  else { remove(); }
}
//**************************************************************************//



//** Nahrungseffekte *******************************************************//
//-- Anpassung ---------------------------------------------------------------
int customize(string type)
{
  string food;
  int hp, sp, i;
  string s1, s2;
  mixed t;
  
  if(member(m_indices(m), type) == -1) {remove(1); return 0;}
  t=m[type, 0];
  food=t[random(sizeof(t))];
  SetProp(P_NAME, food); 
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  hp=sp=0; s1=s2="";
  switch(lower_case(food))
  {
    case "hasenflanke":    hp=10;        AddId( ({"flanke"}) );      break;
    case "hasenohr":       hp=6;         SetProp (P_GENDER, NEUTER); 
                                         AddId( ({"beere"}) );       break;
    case "wieselmagen":    hp=12;        SetProp (P_GENDER, MALE);   break;
    case "huehnerbrust":   hp=8;         AddId( ({"brust"}) );       break;
    case "huehnerfluegel": hp=7;         SetProp (P_GENDER, MALE);
                                         AddId( ({"fluegel"}) );     break;
    case "biberschwanz":   hp=9;         SetProp (P_GENDER, MALE);   break;
    
    case "blaubeere":             sp=12; break;
    case "stachelbeere":          sp=10; break;
    case "johannisbeere":         sp=11; break;
    case "waldbeere":      hp=5;  sp=5;  break;
    case "fubarbeere":            sp=8;  break;
    case "gruenbeere":            sp=9;  break;
    
    case "walnuss":        hp=5;  sp=5;  break;
    case "erdnuss":        hp=4;  sp=5;  break;
    case "haselnuss":      hp=4;  sp=4;  break;
    case "gaffonuss":      hp=15; sp=-5; break;
    case "kastanie":       hp=6;  sp=5;  break;
    case "paranuss":       hp=-5; sp=16; break;
  }
  switch(type)
  {
    case BEERE:
      AddId( ({"beere"}) );
      SetProp(P_MATERIAL, ({ MAT_FRUIT }) );
      s1=Name(WER, 1)+" vertrocknet.\n";
      s2=Name(WER, 1)+" ist vertrocknet, Du wirfst sie weg.\n";
    break;
    case NUSS:
      AddId( ({"nuss"}) );
      SetProp(P_MATERIAL, ({ MAT_MISC_FOOD }) );
      s1=Name(WER, 1)+" wird zu alt.\n";
      s2=Name(WER, 1)+" ist zu hart geworden, Du wirfst sie weg.\n";
    break;
    case FLEISCH:
      DBD("mist");
      AddId( ({"fleisch"}) );
      SetProp(P_MATERIAL, ({ MAT_FLESH , MAT_MISC_DEAD }) );
      s1=Name(WER, 1)+" verschimmelt.\n";
      s2=Name(WER, 1)+" ist verschimmelt, Du wirfst "+name(WEN, 1)+" weg.\n";
    break;
  }
  
  SetProp (P_SHORT, Name(WER, 1) );
  SetProp (P_LONG, Name(WER, 1)+" wurde Dir von einem Waldtier gebracht. Du "
                   "kannst "+name(WEN, 1)+" essen.");
  AddId( ({lower_case(name(RAW)), FOOD_ID}) );
  SetProp(P_FOOD_INFO, 
   ([ F_HEAL: ({ hp , sp }),
      F_SOAK: 1+random(4),   
      F_MSG: "Du isst "+name(WEN, 1)+".",
      F_MSG_ROOM: "isst "+name(WEN, 1)+".",
      F_MSG_DECAY: s1,
      F_MSG_REMOVE: s2,
      F_SHOW_RAW: 0,
      F_VERB: "essen"]) );
  return 1;
}
//**************************************************************************//