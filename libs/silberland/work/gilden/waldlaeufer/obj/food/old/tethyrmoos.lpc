inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../../def.h"

create()
{
  if (!is_clone(ME)) return;

  ::create( ({"iss","esse"}) );     
  
  SetProp (P_NAME, "Tethyrmoos"); 
  SetProp (P_GENDER, NEUTER);
  
  AddId( ({"moos", lower_case(TO->QueryProp(P_NAME)), "\nranger_food"}) );

  SetProp (P_SHORT, CAP(TO->QueryArticle(0,0,1))+TO->QueryProp(P_NAME) );
  SetProp (P_LONG,
      CAP(TO->QueryArticle(0,1,1))+TO->QueryProp(P_NAME)+" wurde Dir von "
      "einem Waldtier gebracht. Du kannst "+TO->QueryArticle(0,1,1)+
      TO->QueryProp(P_NAME)+" essen.");
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 10+random(10));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_INFO, "Du weisst nicht was Tethyrmoss macht, aber Froesche "
    "vertragen es bekanntermassen nicht.\n");
  SetProp (P_MATERIAL,
      ({ MAT_MISC_PLANT }) );

  SetProp (P_FOOD_INFO, 
   ([ F_HEAL: ({ 0 , 0 }),
      F_SOAK: 5,   
      F_DRINK: 0, 
      F_ALCOHOL: 0,
      F_POISON: 0,  
      F_MSG: "Du isst "+TO->QueryArticle(0,0,1)
             +TO->QueryProp(P_NAME)+".",
      F_MSG_ROOM: "isst "+TO->QueryArticle(0,0,1)
                  +TO->QueryProp(P_NAME)+".",
      F_MSG_DECAY: "Das Tethyrmoos vertrocknet.\n",
      F_MSG_REMOVE: "Das Tethyrmoos vertrocknet, Du wirfst es weg.\n",
      F_SHOW_RAW: 0,
      F_VERB: "essen"]) );

}

BeimEssen()
{
  if( TP->QueryProp(P_FROG) )
  { 
    tell_object(TP, BS("Du siehst die Welt wieder aus normaler Hoehe."));    
    TP->SetProp(P_FROG, 0);
    return;
  }
}

second_life(object pl)
{ return 0; }

void reset()
{
  if (!is_clone(this_object())) return;
  
  if(!objectp(ENV(TO))) return;
 
  if( member(ENV(TO)->QueryProp(P_IDS), "\nranger_food_container") != -1 )
  { ::reset(); }
  else
  { TO->remove(); }
}