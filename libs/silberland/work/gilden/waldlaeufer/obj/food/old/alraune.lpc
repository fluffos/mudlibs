inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../../def.h"

create()
{
  if (!is_clone(ME)) return;

  ::create( ({"iss","esse"}) );     
  
  SetProp (P_NAME, "Alraune"); 
  SetProp (P_GENDER, FEMALE);
  
  AddId( ({ "wurzel", lower_case(TO->QueryProp(P_NAME)), "\nranger_food"}) );

  SetProp (P_SHORT, CAP(TO->QueryArticle(0,0,1))+TO->QueryProp(P_NAME) );
  SetProp (P_LONG,
      CAP(TO->QueryArticle(0,1,1))+TO->QueryProp(P_NAME)+" wurde Dir von "
      "einem Waldtier gebracht. Du kannst "+TO->QueryArticle(0,1,1)+
      TO->QueryProp(P_NAME)+" essen.");
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 10+random(10));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_INFO, "Im rohen Zustand soll die Alraune eine beruhigende "
    "Wirkung auf den Magen haben.\n");
  SetProp (P_MATERIAL,
      ({ MAT_MISC_PLANT }) );

  SetProp (P_FOOD_INFO, 
   ([ F_HEAL: ({ 0 , 0 }),
      F_SOAK: -11-random(10),   
      F_DRINK: 5, 
      F_ALCOHOL: 0,
      F_POISON: 0,  
      F_MSG: "Du zerdrueckst "+TO->QueryArticle(0,0,1)
             +TO->QueryProp(P_NAME)+" und trinkst den Saft der Wurzel.",
      F_MSG_ROOM: "trink den Saft "+TO->QueryArticle(1,1,1)
                  +TO->QueryProp(P_NAME)+".",
      F_MSG_DECAY: "Die Alraune vertrocknet.\n",
      F_MSG_REMOVE: "Die Alraune vertrocknet, Du wirfst sie weg.\n",
      F_SHOW_RAW: 0,
      F_VERB: "essen"]) );

}

BeimEssen()
{
  if( TP->QueryProp(P_POISON) )
  { 
    tell_object(TP, BS("Das Grummeln in deinem Magen laesst langsam nach."));
    TP->AddPoison(-2); 
    return;
  }
}

second_life(object pl)
{ return 0; }

void reset()
{
  if (!is_clone(this_object())) return;
  
  if(!objectp(ENV(TO))) return;
 
  if( member(ENV(TO)->QueryProp(P_IDS), "\nranger_food_container") != -1 )
  { ::reset(); }
  else
  { TO->remove(); }
}