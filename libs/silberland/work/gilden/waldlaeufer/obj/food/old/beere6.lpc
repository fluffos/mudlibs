inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../../def.h"

create()
{
  if (!is_clone(ME)) return;

  ::create( ({"iss","esse"}) );     
  
  SetProp (P_NAME, "Stachelbeere"); 
  SetProp (P_GENDER, FEMALE);
  
  AddId( ({"beere", lower_case(TO->QueryProp(P_NAME)), "\nranger_food"}) );

  SetProp (P_SHORT, CAP(TO->QueryArticle(0,0,1))+TO->QueryProp(P_NAME) );
  SetProp (P_LONG,
      CAP(TO->QueryArticle(0,1,1))+TO->QueryProp(P_NAME)+" wurde Dir von "
      "einem Waldtier gebracht. Du kannst "+TO->QueryArticle(0,1,1)+
      TO->QueryProp(P_NAME)+" essen.");
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 50+random(50));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_INFO, "Diese Beere wird Deine magischen Kraefte "
    "auffrischen.\n");
  SetProp (P_MATERIAL,
      ({ MAT_FRUIT }) );

  SetProp (P_FOOD_INFO, 
   ([ F_HEAL: ({ 0 , 10+random(2) }),
      F_SOAK: 4,   
      F_DRINK: 0, 
      F_ALCOHOL: 0,
      F_POISON: 0,  
      F_MSG: "Du isst "+TO->QueryArticle(0,0,1)
             +TO->QueryProp(P_NAME)+".",
      F_MSG_ROOM: "isst "+TO->QueryArticle(0,0,1)
                  +TO->QueryProp(P_NAME)+".",
      F_MSG_DECAY: "Die Beeren vertrocknen.\n",
      F_MSG_REMOVE: "Die Beeren sind vertrocknet, Du wirfst sie weg.\n",
      F_SHOW_RAW: 0,
      F_VERB: "essen"]) );

}

BeimEssen()
{

}

second_life(object pl)
{ return 0; }

void reset()
{
  if (!is_clone(this_object())) return;
  
  if(!objectp(ENV(TO))) return;
 
  if( member(ENV(TO)->QueryProp(P_IDS), "\nranger_food_container") != -1 )
  { ::reset(); }
  else
  { TO->remove(); }
}