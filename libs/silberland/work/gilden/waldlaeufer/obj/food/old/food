------------------------------------[food]------------------------------------
STANDARD NAHRUNGS OBJEKT
        "/std/food"

BENUTZUNG:
        inherit "/std/food";

        #include <properties.h>
        #include <food.h>

PROPERTIES:
        P_FOOD_STATE
          Zustand des Nahrungsobjekts, moegliche Werte:
          F_RAW (roh), F_COOKED (gekocht), F_FRIED (gebraten),
          F_SPOILT (verdorben)

        P_FOOD_INFO
          Mapping mit den Parametern eines Nahrungsobjektes:
          Key          Value   Beschreibung
          F_HEAL       int x   Heilung von x HP und x SP
                       int *x  Heilung von x[0] HP und x[1] SP
          F_SOAK       int x   Saettigung um x erhoehen
          F_DRINK      int x   Trink-Saettigung um x erhoehen
          F_ALCOHOL    int x   Alkoholisierung um x erhoehen
          F_POISON     int x   Vergiftung um x erhoehen
          F_MSG        string  Text, der an den Spieler beim
                               Essen ausgegeben werden soll
          F_MSG_ROOM   string  Text, der an den Raum ausgegeben
                               werden soll. Dem Text werden der Name
                               des Spielers sowie ein Leerzeichen
                               vorangestellt.
          F_MSG_DECAY  string  Text, der beim Verschimmeln an das
                               environment() (sei es Spieler oder
                               Raum) ausgegeben wird
          F_MSG_REMOVE string  Text, der beim Zerfallen an das
                               environment() (sei es Spieler oder
                               Raum) ausgegeben wird
          F_SHOW_RAW   int x   Flag, ob Zustand in long(), wenn roh, als
                               solcher angezeigt werden soll
          F_VERB       string  "Iss"-Verb in Nennform (Default: "essen")
                               Wird fuer Fehlertext bei falscher Syntax
                               ("Was willst Du essen?") benoetigt.

FUNKTIONEN:
        varargs create(mixed commands)
          Beim Aufruf kann man optional die zum Verzehr des Objekts
          bestimmten Verben als String oder Array von Strings ueber-
          geben (Default ist ({ "iss","esse" }) ).

        void BeimEssen()
          Wird in der 'Essfunktion' aufgerufen. Das Nahrungsobjekt
          wird anschliessend zerstoert, es sei denn, second_life()
          gibt einen Wert ungleich 0 zurueck.

        int second_life(object pl)
          Wenn diese Funktion einen Wert ungleich 0 zurueckliefert,
          wird das Objekt nach dem Essen nicht zerstoert. Sollte nur
          mit Vorsicht verwendet werden, kann allerdings zum Clonen
          von leeren Flaschen etc. verwendet werden.

        void start_decay(int decay_time, int remove_time)
          Startet den Verwesungsvorgang des Objekts. decay_time ist
          dabei die Anzahl der Sekunden, bis das Objekt verschimmelt,
          remove_time die Anzahl der Sekunden danach, bis es dann
          zerfaellt. Soll einer der beiden Vorgaenge nicht statt-
          finden, so kann man den entsprechenden Wert auf -1 setzen.
          Standardmaessig wird in std/food.c KEIN Verwesungsvorgang
          gestartet, sodass Nahrungsobjekte ohne expliziten Aufruf
          dieser Methode ewig halten!

        int decay(int silent)
          Diese Funktion wird automatisch aufgerufen, nachdem mit
          start_decay() der Verwesungsvorgang eingeleitet wurde,
          sobald die decay_time abgelaufen ist. Die Methode in
          std/food setzt hierbei die Heilungswerte, wenn sie vorher
          groesser als 0 waren, auf 0, und den Vergiftungsgrad, wenn
          es vorher noch keinen gesetzt gab (oder nur Entgiftung),
          auf 1. Weiters werden die Meldungen F_MSG und F_MSG_ROOM
          auf passende Defaulttexte sowie in P_FOOD_STATE das Flag
          F_SPOILT gesetzt.

        string decay_desc()
          Diese Funktion gibt, je nach P_FOOD_STATE, das passende
          Wort ("roh" nur, wenn F_SHOW_RAW gesetzt ist!) zurueck
          und wird in long() zur Ausgabe des Zustandes verwendet.

BEMERKUNGEN:
        Da tragbare Heilung auch bei kleinen Heilraten sehr maechtig ist
        und das Gleichgewicht in abgeschlossenen Gebieten teils erheblich
        gefaehrden kann, ist JEDES NAHRUNGSOBJEKT MELDEPFLICHTIG (beim
        Erzmagier fuer Balance). Das Verhaeltnis Heilung zu Saettigung
        sollte ganz grob 2:1 nicht ueberschreiten.

        In /obj/food/ sollten sich (bald) einige Standard-Nahrungsobjekte
        finden, in /obj/food/ingredients/ einzelne Zutaten zur weiteren
        Verarbeitung durch Wirte, etc.

BEISPIEL:
        Ein umfangreicheres Beispiel befindet sich in:
        /players/woody/obj/gift.c

