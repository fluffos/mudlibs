/*
** Eine Testflasche - Woody
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;

  ::create( ({"trink","trinke"}) );     // muss nur angegeben werden,
                                        // wenn ungleich "iss"
  AddId ("flasche");
  AddId ("fluessigkeit");
  AddId ("gift");

  SetProp (P_SHORT, "Eine geheimnisvolle Flasche");
  SetProp (P_LONG,
      "Eine Flasche mit einer eklig-gruenen Fluessigkeit.\n"
      "Vermutlich Gift.\n");
  SetProp (P_NAME, "Flasche");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 150);
  SetProp (P_NOBUY, 1);
  SetProp (P_INFO, "Sogar ganz bestimmt Gift!!\n");
  SetProp (P_MATERIAL,
      ({ MAT_GLASS, MAT_MISC_DRUG, MAT_MISC_FLUID, MAT_ALCOHOL }) );

  SetProp (P_FOOD_INFO, ([
      F_HEAL     : ({10,5}),               // 10 LP, 5 MP
      F_DRINK:5, F_ALCOHOL:2, F_POISON:2,  // Saettigungswerte, Gift!!
      F_MSG      : "Du trinkst die Flasche Gift aus...\n"
                   "...und bist vergiftet. Welch Ueberraschung!!",
      F_MSG_ROOM : "trinkt eine Flasche mit eklig gruener Fluessigkeit leer "
                   "und schuettelt sich ploetzlich. Das wird doch nicht etwa "
                   "Gift gewesen sein...?",
      F_VERB     : "trinken" ]) );
    /*
    P_FOOD_STATE
          Zustand des Nahrungsobjekts, moegliche Werte:
          F_RAW (roh), F_COOKED (gekocht), F_FRIED (gebraten),
          F_SPOILT (verdorben)

        P_FOOD_INFO
          Mapping mit den Parametern eines Nahrungsobjektes:
          Key          Value   Beschreibung
          F_HEAL       int x   Heilung von x HP und x SP
                       int *x  Heilung von x[0] HP und x[1] SP
          F_SOAK       int x   Saettigung um x erhoehen
          F_DRINK      int x   Trink-Saettigung um x erhoehen
          F_ALCOHOL    int x   Alkoholisierung um x erhoehen
          F_POISON     int x   Vergiftung um x erhoehen
          F_MSG        string  Text, der an den Spieler beim
                               Essen ausgegeben werden soll
          F_MSG_ROOM   string  Text, der an den Raum ausgegeben
                               werden soll. Dem Text werden der Name
                               des Spielers sowie ein Leerzeichen
                               vorangestellt.
          F_MSG_DECAY  string  Text, der beim Verschimmeln an das
                               environment() (sei es Spieler oder
                               Raum) ausgegeben wird
          F_MSG_REMOVE string  Text, der beim Zerfallen an das
                                environment() (sei es Spieler oder
                               Raum) ausgegeben wird
          F_SHOW_RAW   int x   Flag, ob Zustand in long(), wenn roh, als
                               solcher angezeigt werden soll
          F_VERB       string  "Iss"-Verb in Nennform (Default: "essen")
                               Wird fuer Fehlertext bei falscher Syntax
                               ("Was willst Du essen?") benoetigt.
  */

}


BeimEssen()
{
  // Wird beim Essen bzw. Trinken aufgerufen, Wirkungen, die man
  // mit P_FOOD_INFO alleine nicht erreichen kann, kann man hier
  // reinprogrammieren.
}

second_life(object pl)
{
  // Hier koennte man dem Spieler (pl) z.B. eine leere Flasche clonen

  return 0;     // 0 bedeutet, dass die Flasche kein 'zweites Leben' hat,
                // also nach dem Essen/Trinken destructed werden soll.
}

