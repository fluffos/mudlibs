inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../../def.h"

create()
{
  if (!is_clone(ME)) return;

  ::create( ({"iss","esse"}) );     
  
  SetProp (P_NAME, "Jaegerkresse"); 
  SetProp (P_GENDER, FEMALE);
  
  AddId( ({"kresse", lower_case(TO->QueryProp(P_NAME)), "\nranger_food"}) );

  SetProp (P_SHORT, CAP(TO->QueryArticle(0,0,1))+TO->QueryProp(P_NAME) );
  SetProp (P_LONG,
      CAP(TO->QueryArticle(0,1,1))+TO->QueryProp(P_NAME)+" wurde Dir von "
      "einem Waldtier gebracht. Du kannst "+TO->QueryArticle(0,1,1)+
      TO->QueryProp(P_NAME)+" essen.");
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 10+random(10));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_INFO, "Die Kresse hat ihren Namen von ihrer heilenden Wirkung "
    "auf Gehoergaenge und Sehnerven. Es heisst in manchen Situationen "
    "hat die Kresse schon einigen Jaegern das Leben gerettet.\n");
  SetProp (P_MATERIAL,
      ({ MAT_MISC_PLANT }) );

  SetProp (P_FOOD_INFO, 
   ([ F_HEAL: ({ 0 , 0 }),
      F_SOAK: 5,   
      F_DRINK: 0, 
      F_ALCOHOL: 0,
      F_POISON: 0,  
      F_MSG: "Du isst "+TO->QueryArticle(0,0,1)
             +TO->QueryProp(P_NAME)+".",
      F_MSG_ROOM: "isst "+TO->QueryArticle(0,0,1)
                  +TO->QueryProp(P_NAME)+".",
      F_MSG_DECAY: "Die Jaegerkresse vertrocknet.\n",
      F_MSG_REMOVE: "Die Jaegerkresse vertrocknet, Du wirfst sie weg.\n",
      F_SHOW_RAW: 0,
      F_VERB: "essen"]) );

}

BeimEssen()
{
  if( TP->QueryProp(P_BLIND) )
  { 
    tell_object(TP, BS("Deine Sehkraft kehrt langsam zurueck."));    
    TP->SetProp(P_BLIND, 
    ([BLIND_TIME: 2, 
      BLIND_MSG: "Deine Sehkraft kehrt langsam zurueck.\n",
      BLIND_END_MSG: "Du kannst nun wieder sehen!\n"]) ); 
    return;
  }
  else if( TP->QueryProp(P_DEAF) )
  { 
    tell_object(TP, BS("Du wirst gleich wieder hoeren koennen."));
    TP->SetProp(P_DEAF, 
    ([DEAF_TIME: 2, 
      DEAF_MSG: "Du wirst gleich wieder hoeren koennen.\n",
      DEAF_END_MSG: "Du kannst nun wieder hoeren!\n"]) ); 
    return;
  }
}

second_life(object pl)
{ return 0; }

void reset()
{
  if (!is_clone(this_object())) return;
  
  if(!objectp(ENV(TO))) return;
 
  if( member(ENV(TO)->QueryProp(P_IDS), "\nranger_food_container") != -1 )
  { ::reset(); }
  else
  { TO->remove(); }
}