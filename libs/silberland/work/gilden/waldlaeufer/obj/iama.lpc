/******************** Iama der Waldlaeufergilde ******************************
12.10.05 - Begin
*****************************************************************************/
//** INHERIT + INCLUDE + DEFINE ********************************************//
inherit "std/thing";

#include "../def.h"
//**************************************************************************//



//** StandardFunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  

  SetProp(P_SHORT, "Eine Iama");
  SetProp(P_LONG, 
    "Eine Iama ist nichts anderes als eine Okarina aus Holz. Doch diese hier "
    "wurde von den Waldlaeufern mit magischen Kraeften versehen. Es gelingt "
    "dem Besitzer somit sein gezaehmtes Tier zu rufen und mit ihm zu "
    "kommunizieren. Zudem ist die Iama natuerlich unersetzbar fuer die "
    "wenigen alten Lieder der Waldlaeufer.");
  
  AddDetail( ({"okarina", "holzokarina"}),
    "Sie ist sehr kurz gehalten und nicht verziert.");
    
  AddDetail( ({"waldlaeufer", "laeufer"}),
    "Die Iama gehoert den Waldlaeufern.");
    
  AddDetail( ({"tier"}),
    "Dazu muss der Besitzer natuerlich eines gefangen haben.");
    
  AddDetail( ({"magie", "flamme", "tethyr", "kraefte"}),
    "Die Magie kommt aus der ewigen Flamme von Tethyr.");
  
  SetProp(P_NAME, "Iama");
  SetProp(P_GENDER, FEMALE );
  SetProp(P_INFO, 
    "Ein Geschenk der Waldlaeufer. Syntax <spiele> \n"
    "  - Melodie der Treue (Dein Begleiter kehrt zu Dir zurueck)\n"
    "  - Melodie der Waldtiere (Entlaesst ein Waldtier aus Deinen Diensten)\n"
    );
  AddId( ({"iama", IAMA_ID}) );
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 0 );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  AddCmd( ({"spiele", "spiel"}) , "spiele_cmd");
  SUID;
}

//-- Nur Waldlaeufer duerfen Iama tragen ------------------------------------
void init()
{
  ::init();
  if(!objectp(MENV) || (MENV->QueryProp(P_GUILD)!= GUILDNAME) )
  { write("Die Iama wird zu Staub.\n");
    call_out("remove",0);
    return 0; }
}
//**************************************************************************//



//** Spiele-Cmds ***********************************************************//
int spiele_cmd(string str)
{
  mixed owner;
  
  owner=MENV;
  if( !objectp(owner) || ( owner->QueryProp(P_GUILD)!= GUILDNAME ) )
  { call_out("remove", 0); return 0; }
  
  if(owner != this_player())
  { call_out("remove", 0); return 0; }
  
  if(!str || str=="") 
  { tell_object(owner, BS("Was fuer eine Melodie willst Du spielen? "
                          "<spiele melodie des beispiels>"));
    return 1;}
  
  str=owner->_unparsed_args();
  str=lower_case(str);
  
  if(str=="melodie der treue")
  { call_out("BringPetBack", 0, owner); return 1;}
  
  if(str=="melodie der waldtiere")
  { call_out("RemoveAnimals", 0, owner); return 1;}

  tell_object(owner, BS("Was fuer eine Melodie willst Du spielen? "
                     "<spiele melodie des beispiels>") );
  return 1;
}
//**************************************************************************//



//** PetKontrolle **********************************************************//
//-- Findet das Pet des Rangers ----------------------------------------------
int BringPetBack(object owner)
{
  object ob;
  mixed env;
  int i;
  
  if(!owner || !objectp(env=ENV(owner)) ) { return 0; }
  if(PETMASTER->IsPetOwner(getuid(owner)) != 1)
  { tell_object(owner, BS("Du hast gar kein Tier gezaehmt!")); 
    return 0; }
    
  if( ob=present("\n"+getuid(owner)+"_ranger_pet", env) ) 
  { tell_object(owner, BS("Dein Tier steht neben Dir."));
    PETMASTER->SetPet(owner, ob);
    return 1; }
  
  if(ob=PETMASTER->GetPet(owner)) 
  {
    ob->move(ENV(owner), M_GO|M_SILENT);
    owner->AddPursuer(ob);
    owner->AddDefender(ob);
    PETMASTER->SetPet(owner, ob);
    return 1;
  }
  
  //Tier wird neu erschaffen
  if(ob=clone_object(NPC"pet")) ob->second_create(owner); 
  if(ob)
  { tell_object(owner, BS("Du spielst die Melodie an und nach kurzer "
                          "Zeit erscheint Dein Tier."));
    return 1;
  }
  return 0;
}

//-- Laesst ein gerufenes noch existentes Waldtier verschwinden --------------
int RemoveAnimals(object owner)
{
  mixed ob;
  
  if(objectp(ob=PETMASTER->GetPet(owner, 1)))
  { tell_object(owner, BS("Du entlaesst "+ob->name(WEN, 1)+" aus Deinen "
                       "Diensten."));
    ob->remove(); return 1;}
  tell_object(owner,BS("Es befindet sich kein Waldtier in Deinen Diensten."));
  return 0;
}
//**************************************************************************//

public void SongPlayed() {
  if(RANGERMASTER->GetMasterAbility(getuid(this_player())) !=MASTER_ABIILITY_RAGE_OF_NATURE) return;
  if(find_call_out("rage_of_avatara") != -1) return;
  call_out("rage_of_avatara", random(30), this_player());
  tell_object(this_player(), BS("Die Wildheit der Avatara umgibt dich."));
  return;
}

public void rage_of_avatara(object caster) {
  object enemy, *prenemies;
  if(!objectp(caster)) return;
  if(RANGERMASTER->GetMasterAbility(getuid(caster)) != MASTER_ABIILITY_RAGE_OF_NATURE) return;
  prenemies = caster->PresentEnemies();
  if(sizeof(prenemies)) {
    enemy = prenemies[random(sizeof(prenemies))];
    if(objectp(enemy)) {
      call_other(GUILD_SPELLBOOK, "rage_of_avatara", caster, enemy);
    }
  }

  if(objectp(present(HEAL_OBJ_ID, caster)) || objectp(present(MELODY_OF_CHANGE_ID, caster)) ||
     objectp(present(MELODY_TIME_ID, caster)) || objectp(present(HYMNEN_SPAWNER, caster)) || 
     objectp(present(AVATARA_ARMOUR_ID, caster)) || objectp(present(MELODIE_DES_OSTENS_ID, caster)) ) {
    call_out("rage_of_avatara", 5 + random(25), caster, enemy);
  } else {
    tell_object(caster, BS("Die Wildheit der Avatara verlässt Dich."));
  }
  return;
}