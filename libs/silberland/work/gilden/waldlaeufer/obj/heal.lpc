#include "../def.h"
inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_GENDER, MALE);
  AddId(HEAL_OBJ_ID);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}

int remove()
{
  if(ENV(TO)) 
  { ENV(TO)->SetProp(P_PARALYZED, ([PARALYZE_TIME: 0, 
							PARALYZE_MSG: BS(""), 
							PARALYZE_MSG_OTHER: "", 
							PARALYZE_END: BS(""), 
							PARALYZE_END_OTHER: ""]));
    ENV(TO)->Message(BS("Du beendest Deine Konzentration.")); }
  return ::remove();
}


int heal(int wdh, int hp)
{
  object pl;
  int next_heal;
  string *imessages, *omessages;
  
  if(!(ENV(TO)) || !(ENV(ENV(TO))) ) {remove(); return 0;}
  if(!(interactive(ENV(TO))) ) {remove(); return 0;}
  if(wdh <1) {call_out("remove", 30); return 1;}
  pl=ENV(TO);

  hp = SPELL_DAMAGE_BONUS(ENV(TO), "melodie der ruhe", hp);
  
  pl->AddHp((hp)+random(6));
  if(random(2)) {
    pl->AddSp(random(hp/2));
  }

  pl->do_exhaust(-(hp*4));

  next_heal=5+1+random(5);

  imessages=({"Die sanften Toene Deiner Melodie gaukeln Dir eine "
              "wunderschoene Landschaft vor.",
              "Du siehst Baeche und Fluesse, die sich ihren Weg durch einen "
              "ruhigen Wald bahnen.",
              "Der Wald von Tethyr erscheint vor Deinen Augen. Du fuehlst "
              "Dich wohler und wohler.",
              "Du beruhigst Dich nach und nach. Dein Koerper regeneriert "
              "seine Kraefte.",
              "Die Muedigkeit weicht langsam aus Deinen Gliedern.",
              "Du bist jetzt entspannt."});
  omessages=({pl->Name(WER)+" haelt die Augen geschlossen und entspannt sich "
              "sichtlich.",
              "Die sanften Klaenge, die von "+pl->name(WESSEN, 1)+" Iama "
              "ausgehen, gefallen Dir.",
              pl->Name(WER)+"sitzt ruhig auf dem Boden und spielt eine "
              "Melodie.",
              "Du summst unbewusst "+pl->Name(WESSEN)+" Melodie mit.",
              pl->Name(WER)+" erholt sich langsam und Du siehst, wie sich "
              "die Wunden schliessen.",
              pl->Name(WER)+" spielt die 'Melodie der Ruhe'."});
  tell_object(pl, BS(imessages[random(sizeof(imessages))]));
  tell_room(ENV(pl), BS(omessages[random(sizeof(omessages))]), ({pl}));
  pl->SetProp(P_PARALYZED, ([PARALYZE_TIME: (next_heal), 
							PARALYZE_MSG: BS("Du kannst die Melodie nicht unterbrechen."), 
							PARALYZE_MSG_OTHER: "%s spielt eine sanfte Melodie.\n", 
							PARALYZE_END: BS(""), 
							PARALYZE_END_OTHER: ""]));
  call_out("heal", next_heal, (wdh-1), hp);
  return 1;
}