//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"
inherit "std/thing";

nosave object owner;
nosave int nummer=0;
nosave string flag="";
//**************************************************************************//



//** StandardFunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
create()
{
  if(!is_clone(TO) ) { return; }
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({TASK_OBJECT_ID}) );
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SUID;
}

//-- Reset falls es noch da ist ----------------------------------------------
void reset()
{
  if(!is_clone(this_object())) { return; }
  ::reset();
  if(!objectp(ENV(TO)) || !query_once_interactive(ENV(TO))) { remove(1); }
}
//**************************************************************************//



//** TaskVerwaltung ********************************************************//
//-- Task setzen -------------------------------------------------------------
int SetTask(int nr, object pl)
{
  return 1;
}

//-- Welcher Task ist gesetzt? -----------------------------------------------
int GetTask(int nr, object pl)
{
  return 1;
}
