#include "../def.h"
#include "../ranger.h"
#include "../ranger_tasks.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Hydraschuppe");
  SetProp(P_LONG,
    "Diese Schuppe wurde bei den Wilderern im suedlichen Tethyrwald gefunden. "
    "Sie schimmert dunkelgruen und scheint extrem hart. Du hast herausgefunden, "
    "dass sie von der Insel Hypros stammt. Geh dort hin und zeige sie den Bewohnern. "
    "Vielleicht kannst du herausfinden was es mit ihr auf sich hat und warum sie "
    "im Besitz der Wilderer war.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hydraschuppe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"QUESTOBJ", RANGER_TASK_SCHUPPE2, "schuppe", "hydraschuppe"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 10);;
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}
