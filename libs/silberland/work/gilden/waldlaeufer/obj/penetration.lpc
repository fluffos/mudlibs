inherit "std/thing";
#include "../def.h"
#include "/spellbooks/waldlaeufer/std/restrictions.lpc"

object victim;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_GENDER, FEMALE); 
  AddId(PENETRATING_SHOT_ID);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}

public int BreakResistance(object target, float factor) {
  string *dtypes;
  int i;
  mapping mod;

  if(!objectp(target)) {
    remove(1);
    return -1;
  }

  if(!living(target)) {
    remove(1);
    return -2;
  }

  victim = target;

  dtypes = m_indices(PHYSICAL_DAMAGE_TYPES);

  if(TO->move(victim, M_SILENT|M_NOCHECK) != 1) {
    return -3;
  }

  mod = ([]);
  for(i = 0; i < sizeof(dtypes); i++) {
    mod[dtypes[i]] = factor;
  }	

  if(victim->AddResistanceModifier(mod, factor) != 1) {
    return -4;
  }

  victim->UpdateResistanceStrengths();
  
  tell_object(victim, BS("Deine Panzerung ist durch den Schuss beschaedigt worden."));
  tell_room(ENV(victim), BS(victim->Name(WESSEN)+" Panzerung ist durch den Schuss beschaedigt worden."), ({victim}));

  if(!query_once_interactive(victim)) {
    victim->SetProp(P_LONG, CAP(victim->QueryPossPronoun(FEMALE, WER))+" Panzerung ist beschaedigt.");
  }

  return 1;
}

public string extra_look() {
  return CAP(victim->QueryPossPronoun(FEMALE, WER))+" Panzerung ist beschaedigt.";
}

public void reset() {
  ::reset();

  if(!is_clone(TO)) return;

  remove(1);
}

public void init() {
  ::init();
  if(!objectp(victim) || ENV(TO) != victim) {
    call_out("remove", 0, 1);
  }
}

public object QueryVictim() {
  return victim;
}