#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    "Du gelangst immer hoeher auf dem gewaltigen Baum, bist aber immer "
    "noch viele Meter weit vom Wipfel entfernt. Das Blaetterwerk ueber "
    "Dir beginnt sich jedoch bereits zu lichten, so dass Du problemlos "
    "den blauen Himmel ueber Dir sehen kannst. Helle Sonnenstrahlen "
    "fallen hier und da durch das Geaest und sorgen fuer eine wohltuende "
    "Waerme auf Deiner Haut. Ein kleiner Unterstand steht in einer Ecke "
    "der Plattform, auf der Du gerade herumwanderst.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "baum" }),
    "Du fuehlst Dich auf diesem Baum schon fast wie zuhause.");

  AddDetail( ({ "meter" }),
    "Es sind noch einige.");

  AddDetail( ({ "wipfel", "baumwipfel" }),
    "Weit ueber Dir erhebt sich der Wipfel des Baumes in den Himmel und "
    "wiegt sich leicht im Wind.");

  AddDetail( ({ "wind" }),
    "Obwohl der Wind hier oben langsam staerker wird, ist er dennoch "
    "nicht unangenehm.");

  AddDetail( ({ "blaetterwerk", "geaest" }),
    "Das Blaetterwerk ueber Dir wird immer weniger dicht, so dass Du "
    "grosse Teile des blauen Himmels ueber Dir sehen kannst.");

  AddDetail( ({ "teile", "teil" }),
    "An vielen Stellen siehst Du den blauen Himmel durchschimmern.");

  AddDetail( ({ "stellen", "stelle" }),
    "Ueber Dir.");

  AddDetail( ({ "himmel" }),
    "Der wolkenlose, babyblaue Himmel ist direkt ueber Dir. Die Sonne "
    "scheint mit aller Kraft auf Dich herab, als wolle sie Dir ihre "
    "grosse Macht demonstrieren.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint und scheint und scheint mit aller Kraft.");

  AddDetail( ({ "kraft" }),
    "Mit aller Kraft scheint die Sonne auf Dich herab.");

  AddDetail( ({ "macht" }),
    "Die Sonne hat sehr viel Macht ueber das Leben und Vergehen der Natur.");

  AddDetail( ({ "leben" }),
    "Sie schenkt vielen Wesen das Leben und macht es reicher.");

  AddDetail( ({ "wesen" }),
  ([ 0: "Auch Dir.",
  "dunkelelf": "Nun ja, Du persoenlich wuerdest wohl auch sehr gut ohne "
    +"sie klarkommen." ]) );

  AddDetail( ({ "vergehen" }),
    "Entzoege man Pflanzen und Lebewesen die Kraft der Sonne, waere es "
    "schnell um sie geschehen.");

  AddDetail( ({ "natur" }),
    "Auch Du bist ein Teil der Natur.");

  AddDetail( ({ "pflanzen" }),
    "Nun, schau Dich doch um. Vieles von dem, was Du hier siehst, wuerde "
    "ohne Sonnenlicht nicht lange ueberleben. Die Baeume, die Blaetter, "
    "das Moos... das alles wuerde es nicht geben. Selbst die Insekten, "
    "die Dich gerade umschwirren, waeren fort.");

  AddDetail( ({ "baeume" }),
    "Du befindest Dich bereits hoeher als die meisten der Baeume um "
    "Dich herum gewachsen sind. Du laesst Deinen Blick rundherum schweifen "
    "und betrachtest das Meer aus blauen Tannenspitzen, das sich vor "
    "Dir ausbreitet.");

  AddDetail( ({ "blick" }),
    "Dein Blick schweift neugierig umher.");

  AddDetail( ({ "meer", "aussicht" }),
    "Ein gewaltiges Meer von Tannen befindet sich in weitem Umkreis um "
    "Dich herum. Es scheint fast bis zum Horizont zu reichen. Erst jetzt "
    "realisierst Du, wie atemberaubend gross der Wald von Tethyr "
    "eigentlich ist.");

  AddDetail( ({ "tannen", "tanne" }),
    "Hier und da sind auch einige Laubbaeume zu sehen, doch der Anteil "
    "der Tannen in diesem Wald ueberwiegt eindeutig.");

  AddDetail( ({ "laubbaeume", "laubbaum" }),
    "Hier und da siehst Du den einen oder anderen Laubbaum zwischen den "
    "Tannen stehen.");

  AddDetail( ({ "anteil" }),
    "Es gibt weitaus mehr Tannen als Laubbaeume in diesem Wald.");

  AddDetail( ({ "wald", "tethyr" }),
    "Dies ist der Wald von Tethyr.");

  AddDetail( ({ "tannenspitzen", "spitzen", "tannenspitze", "spitze" }),
    "Sie breiten sich wie ein einziges, gewaltiges blaues Meer vor Dir "
    "aus.");

  AddDetail( ({ "umkreis" }),
    "Du kannst nur erahnen, wie gross er tatsaechlich ist.");

  AddDetail( ({ "horizont" }),
    "Soweit Dein Auge reicht, siehst Du blaue Tannenspitzen.");

  AddDetail( ({ "auge", "augen" }),
    "Mit grossen Augen betrachtest Du die Aussicht von hier oben.");

  AddDetail( ({ "blaetter" }),
    "Blaue Blaetter wachsen ueberall um Dich herum.");

  AddDetail( ({ "stamm", "baumstamm" }),
    "Der Stamm des Baumes wird von weichem, blauschimmerndem Moos bedeckt.");

  AddDetail( ({ "moos" }),
    "Es schimmert blaeulich.");

  AddDetail( ({ "lebewesen" }),
  ([ 0: "Auch Du bist eines.",
  "untoter": "Naja, Du bist wohl keines. Jedenfalls nicht in dem Sinne." ]) );

  AddDetail( ({ "sinn", "sinne" }),
    "Oder?");

  AddDetail( ({ "insekten", "insekt" }),
    "Ein paar Muecken umfliegen Dich neugierig. Obwohl Du auf sie "
    "jetzt gerade eigentlich ganz gut verzichten koenntest, musst Du "
    "doch zugeben, dass auch sie zum Kreislauf des Lebens dazugehoeren.");

  AddDetail( ({ "muecken", "muecke" }),
    "Winzige kleine Muecken fliegen mit ihren zarten, durchsichtigen "
    "Fluegelchen um Dich herum und scheinen Dich auf merkwuerdige Art "
    "und Weise zu begutachten.");

  AddDetail( ({ "fluegel", "fluegelchen" }),
    "Sie sind kaum zu sehen.");

  AddDetail( ({ "art", "weise" }),
    "Irgendwie merkwuerdig. Aber solange sie Dich nicht stechen, bist "
    "Du ganz zufrieden.");

  AddDetail( ({ "kreislauf" }),
    "Du verfaellst in eine kurze, aber hochphilosophische Diskussion mit "
    "Dir selbst, waehrend Du ueber den Kreislauf des Lebens nachdenkst.");

  AddDetail( ({ "diskussion" }),
    "Du sprichst in Gedanken mit Dir selbst.");

  AddDetail( ({ "gedanken" }),
    "Du solltest Dir nicht gar zu viele Gedanken machen. Sieh Dich lieber "
    "weiter um.");

  AddDetail( ({ "sonnenstrahlen", "strahlen", "sonnenstrahl", "strahl" }),
  ([ 0: "Du haeltst Dein Gesicht in die Sonne und geniesst die Waerme.",
  "dunkelelf": "Angewidert wendest Du Dein Gesicht ab. Grauenvoll, "
    +"dieses Licht!" ]) );

  AddDetail( ({ "sonnenlicht", "licht" }),
    "Helles Sonnenlicht dringt durch das Blaetterwerk.");

  AddDetail( ({ "gesicht" }),
  ([ 0: "Du spuerst die Sonne auf Deiner Haut und hoffst, dass Du endlich "
    +"mal so richtig braun wirst.",
  "dunkelelf": "Du bedeckst Dein Gesicht." ]) );

  AddDetail( ({ "waerme" }),
    "Die Sonne scheint auf Dich herab und waermt Deine Haut.");

  AddDetail( ({ "haut" }),
    "Deine Haut ist schon ganz warm von der Sonne.");

  AddDetail( ({ "unterstand" }),
    "Ein kleiner Unterstand aus Holz steht in einer Ecke auf der Plattform. "
    "Er scheint noch unbewohnt zu sein, denn es gibt noch keine Tuer und "
    "sein Inneres ist gaenzlich leer.");

  AddDetail( ({ "tuer" }),
    "Es gibt keine Tuer.");

  AddDetail( ({ "inneres", "innere" }),
    "Das Innere des Unterstandes ist vollkommen leer. Scheinbar wohnt hier "
    "noch niemand.");

  AddDetail( ({ "ecke" }),
    "In einer Ecke der Plattform steht ein kleiner Unterstand aus "
    "Holz.");

  AddDetail( ({ "plattform" }),
    "Du stehst auf einer grossen, hoelzernen Plattform hoch ueber dem "
    "Boden des Waldes.");

  AddDetail( ({ "holz", "bretter", "holzbretter", "brett", "holzbrett" }),
    "Die Bretter, aus denen der Boden und der Unterstand gefertigt sind, "
    "bestehen aus Holz.");

  AddDetail( ({ "boden" }),
    "Die Holzbretter unter Deinen Fuessen knarren ein wenig beim Gehen.");

  AddDetail( ({ "fuss", "fuesse", "gehen" }),
    "Du gehst langsam hin und her.");

  AddSound( DEFAULT_SOUND,
    "Der Wind weht mit einem leisen Rauschen durch die Blaetter und "
    "Zweige der Baeume.");

  AddSound( ({ "wind" }),
    "Der Wind rauscht leise und gleichmaessig vor sich hin.");

  AddSound( ({ "rauschen" }),
    "Es rauscht leise.");

  AddSound( ({ "blaetter", "blatt", "zweige", "zweig" }),
    "Der Wind rauscht in den Blaettern und Zweigen.");

  AddSound( ({ "baeume" }),
    "Die Baeume selbst geben keinen Laut von sich.");

  AddSound( ({ "laut" }),
    "Nein, so nicht.");

  AddSmell( DEFAULT_SMELL,
    "Du schnupperst eine ganze Weile lang herum und saugst den Duft des "
    "Waldes in Dich hinein.");

  AddSmell( ({ "weile" }),
    "Das riecht nach nichts.");

  AddSmell( ({ "duft" }),
    "Herrlich!");

  AddSmell( ({ "wald" }),
    "Der Wald riecht sehr angenehm.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedostoben", ROOM "d2" );
  AddExit( "suedwestunten", ROOM "b2" );
  
  SetProp(P_HIDE_EXITS, ({"suedosten","suedwesten"}) );
   AddExit("suedosten", ROOM "d2");
   AddExit("suedwesten", ROOM "b2");

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wl7" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Details------------------------------------------------
