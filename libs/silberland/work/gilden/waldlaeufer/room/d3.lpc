#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Baum der Gezeiten");
  SetProp(P_INT_LONG,
    "Der Gildenraum, noch ohne Langbeschreibung.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

//--Ausgaenge--------------------------------------------------------------

  //AddExit( "norden", ROOM "d2" );
  AddExit( "nordosten", ROOM "e2" );
  AddExit( "osten", ROOM "e3" );
  AddExit( "suedosten", ROOM "e4" );
  AddExit( "sueden", ROOM "d4" );
  AddExit( "suedwesten", ROOM "c4" );
  AddExit( "westen", ROOM "c3" );
  AddExit( "nordwesten", ROOM "c2" );

  AddExit( "norden", ([
    EX_DEST    : ROOM "d2",
    EX_MSG     : "durch den Vorhang hinaus",
    EX_MSG_OUT : "geht",
    EX_MSG_IN  : "kommt aus dem Inneren des Stammes" ]) );

//--Items & NPCs-----------------------------------------------------------

//  AddItem(NPC "raziel" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Details------------------------------------------------
