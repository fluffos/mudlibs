  AddDetail( "spuren",
    "Die Werkstatt traegt die Spuren vergangener Stunden, in denen der Dunkelelfenwaldlaeufer an seinen Fertigkeiten "
    "gearbeitet hat, und erinnert an erlebte Abenteuer.");

  AddDetail( "stunden",
    "Die glatte Oberflaeche des Eichentisches traegt die Spuren zahlloser Stunden harter Arbeit, waehrend der "
    "Waldlaeufer seine Fertigkeiten perfektionierte.");

  AddDetail( "thranduil",
    "Die Werkstatt ist ein Abbild der Fertigkeiten und der Persoenlichkeit von Thranduil Duesterschatten, des "
    "Dunkelelfenwaldlaeufers.");

  AddDetail( "ueberlebenskunst",
    "Die Werkstatt ist nicht nur ein Ort der Kunst, sondern auch ein Ort der Ueberlebenskunst, wo der "
    "Dunkelelfenwaldlaeufer seine Fertigkeiten fuer das Ueberleben im Wald verfeinert hat.");

  AddDetail( "umgebung",
    "Die Umgebung der Werkstatt ist durchzogen von der natuerlichen Wildnis des Waldes, die durch die "
    "kuenstlerische Gestaltung des Waldlaeufers unterstrichen wird.");

  AddDetail( "verbindung",
    "Die enge Verbindung zwischen dem Dunkelelfenwaldlaeufer und der Natur wird in der Werkstatt sichtbar, "
    "wo Naturmaterialien und handwerkliche Kunst in Harmonie miteinander verschmelzen.");

  AddDetail( "vorbereitung",
    "Die glatte Oberflaeche des Eichentisches zeugt von sorgfaeltiger Vorbereitung und einem Streben nach "
    "handwerklicher Perfektion.");

  AddDetail( "wald",
    "Die Werkstatt ist ein heiliger Ort im Herzen des Waldes, wo die natuerlichen Elemente und die Fertigkeiten "
