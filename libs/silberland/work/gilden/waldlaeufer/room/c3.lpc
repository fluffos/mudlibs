#include "../def.h"

#define PREIS_GUERTEL 3000
#define PREIS_REFILL  1000
#define PREIS_MESSER  500
#define PREIS_BASEEQ  20000
#define PREIS_KBEUTEL 200
#define PREIS_BANDOLIER 10000

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Werkstatt der Waldlaeufer");
  SetProp(P_INT_LONG,
    "Du betrittst einen majestaetischen Raum hoch oben in den Aesten eines "
    "riesigen Baumes. Das gedaempfte Licht durchdringt das dichte Blaetterdach "
    "und taucht den Raum in mystisches Halbdunkel. Ein suesslicher Duft nach "
    "Tannennadeln liegt in der Luft, begleitet von einem leichten Knistern von"
    "Harz. Inmitten des Raumes steht ein grosser Tisch aus dunklem Eichenholz, "
    "auf dem Werkzeuge und Materialien fein saeuberlich angeordnet sind. Netzwerke "
    "aus Seilen haengen um den Raum, in denen kunstvoll versteckte Fallen lauern. "
    "Die Luft ist erfuellt von einem dunstigen Nebel.\n"
    "Auf dem Tisch liegt eine Liste mit den Dingen, die hier zu erlangen sind.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({"liste", "dingen", "dinge"}),
    "Du kannst die Liste lesen.");

  AddReadDetail( ({"liste"}),
    "Geehrter Waldlaeufer,\n"
    "Fuer Mitglieder unserer Gemeinschaft kann ich einige Dinge anfertigen.\n"
    "\n"
    "  Fallenguertel ..............  "+PREIS_GUERTEL+" Muenzen\n"
    "  Fallenguertel auffuellen ...  "+PREIS_REFILL+" Muenzen\n"
    "  10 Wurfmesser ..............   "+PREIS_MESSER+" Muenzen\n"
    "  Basisausruestung ........... "+PREIS_BASEEQ+" Muenzen\n"
    "  Kraeuterbeutel .............   "+PREIS_KBEUTEL+" Muenzen\n"
    "  Bandolier des Waldlaeufers . "+PREIS_BANDOLIER+" Muenzen\n"
    "\n"
    "Bitte mich einfach um das was du haben willst. Ich arbeite staendig an neuer und besserer Ausruestung." );

  AddDetail( ({ "aesten", "baumes" }),
    "Die Aeste des riesigen Baumes erstrecken sich hoch ueber dir, und du spuerst die "
    "urige Stabilitaet, die sie dem Raum verleihen.");

  AddDetail( "blaetterdach",
    "Das dichte Blaetterdach laesst nur gedaempftes Licht hindurch, taucht den Raum "
    "in ein mystisches Halbdunkel.");

  AddDetail( "boden",
    "Der Boden besteht aus einem glatten, festen Material, das von einem leicht "
    "klebrigen Harzgeruch durchzogen ist.");

  AddDetail( "duft",
    "Ein suesslicher Duft nach Tannennadeln liegt in der Luft, begleitet von einem "
    "leichten Knistern von Harz.");

  AddDetail( "eichenholz",
    "Der grosse Tisch in der Mitte des Raumes besteht aus dunklem Eichenholz, "
    "dessen Maserung von zahllosen Geschichten zu erzaehlen scheint.");

  AddDetail( "fallen",
    "Kunstvoll versteckte Fallen haengen in Netzwerken aus Seilen um den Raum herum, "
    "bereit, jeden Eindringling zu ueberraschen.");

  AddDetail( "halbdunkel",
    "Das Halbdunkel im Raum macht ihn geheimnisvoll, in der die "
    "Silhouetten der Werkzeuge und Materialien nur schwach zu erkennen sind.");

  AddDetail( "himmel",
    "Der Himmel draussen ist nicht zu sehen, aber die dichten Aeste des Baumes erzeugen "
    "ein Gefuehl von Sicherheit und Geborgenheit.");

  AddDetail( "knistern",
    "Ein leichtes Knistern von Harz erfuellt die Luft und verleiht dem Raum eine "
    "lebendige, organische Aura.");

  AddDetail( "licht",
    "Das gedaempfte Licht dringt durch das dichte Blaetterdach und taucht den Raum "
    "in ein mystisches Halbdunkel.");

  AddDetail( "luft",
    "Die Luft ist erfuellt von einem dunstigen Nebel, der eine geheimnisvolle "
    "Stimmung schafft.");

  AddDetail( "materialien",
    "Werkzeuge und Materialien sind fein saeuberlich auf dem grossen Eichentisch "
    "angeordnet, bereit fuer die geschickten Haende des Waldlaeufers.");

    AddDetail( "nebel",
    "Ein dunstiger Nebel schwebt in der Luft und verleiht dem Raum eine mystische "
    "Stimmung.");

  AddDetail( "raum",
    "Dieser majestaetische Raum erstreckt sich hoch oben in den Aesten des riesigen "
    "Baumes.");

  AddDetail( "seilen",
    "Netzwerke aus Seilen sind kunstvoll um den Raum herum angeordnet, in denen "
    "Fallen lauern.");

  AddDetail( "tannennadeln",
    "Ein suesslicher Duft nach Tannennadeln liegt in der Luft und verleiht dem Raum "
    "eine frische, natuerliche Note.");

  AddDetail( "tisch",
    "Der grosse Tisch aus dunklem Eichenholz ist das Herzstueck der Werkstatt, "
    "auf dem Werkzeuge und Materialien bereitliegen.");

  AddDetail( "werkzeuge",
    "Werkzeuge aller Art sind auf dem grossen Eichentisch fein saeuberlich angeordnet, "
    "zeugend von der Geschicklichkeit des Dunkelelfenwaldlaeufers.");

    AddDetail( ({ "aeste", "art" }),
    "Die Aeste des riesigen Baumes zeichnen eine beeindruckende Kunstfertigkeit in "
    "ihrer Gestaltung, und ihre Art verleiht dem Raum eine natuerliche Schoenheit.");

  AddDetail( "aura",
    "Die Aura des Raumes ist durchzogen von einem Hauch von Mysterium, waehrend die "
    "dunkle Energie des Dunkelelfenwaldlaeufers spuerbar wird.");

  AddDetail( "dunkelelfenwaldlaeufer",
    "Der Dunkelelfenwaldlaeufer, Thranduil Duesterschatten, ist ein Meister seines Fachs, "
    "und die Werkstatt traegt die Spuren seiner faszinierenden Persoenlichkeit.");

  AddDetail( "eichentisch",
    "Der Eichentisch bildet das Herzstueck der Werkstatt. Seine glatte Oberflaeche zeugt "
    "von vielen Stunden akribischer Arbeit und Vorbereitung.");

  AddDetail( "eindringling",
    "Jeder Eindringling, der sich hierher wagt, wird von den kunstvoll versteckten Fallen "
    "und den scharfen Sinnen des Waldlaeufers sofort wahrgenommen.");

  AddDetail( "geborgenheit",
    "Die dichten Aeste des Baumes vermitteln ein Gefuehl von Geborgenheit, als ob der Raum "
    "einen sicheren Zufluchtsort inmitten des Waldes darstellen wuerde.");

  AddDetail( "gefuehl",
    "Ein Gefuehl von Mystik und Abenteuer liegt in der Luft, verstaerkt durch die Praesenz "
    "des Dunkelelfenwaldlaeufers und seiner faszinierenden Werkstatt.");

  AddDetail( "geschichten",
    "Die Maserung des Eichenholztisches erzaehlt stumme Geschichten von vergangenen Abenteuern, "
    "und die Aura des Raumes scheint von zahllosen erlebten Geschichten durchdrungen zu sein.");

  AddDetail( "geschicklichkeit",
    "Die geschickten Haende des Dunkelelfenwaldlaeufers sind ueberall in der Werkstatt zu spueren, "
    "insbesondere in der geschickten Anordnung von Werkzeugen und Fallen.");

  AddDetail( "haende",
    "Die Haende des Dunkelelfenwaldlaeufers sind die Werkzeuge seiner Kunst. Sie arbeiten "
    "behende mit Seilen und Werkzeugen, geschaffen fuer die Herausforderungen des Waldes.");

  AddDetail( "harz",
    "Das Harz, das den Boden bedeckt, ist klebrig und duftet nach der Essenz des Waldes. "
    "Es wird oft fuer verschiedene Zwecke in der Werkstatt verwendet.");

  AddDetail( "harzgeruch",
    "Der leicht klebrige Harzgeruch erfuellt die Luft und verleiht der Umgebung einen Hauch "
    "von Wildnis und Naturverbundenheit.");

  AddDetail( "herzstueck",
    "Der Eichentisch ist das unbestrittene Herzstueck der Werkstatt, auf dem die Essenz des "
    "Waldlaeufers und seiner Fertigkeiten sichtbar wird.");

  AddDetail( "maserung",
    "Die Maserung des Eichenholztisches ist wie ein Gemaelde aus Linien und Formen, "
    "die die Geschichte des Baumes selbst erzaehlen.");

  AddDetail( "material",
    "Werkzeuge und Materialien sind fein saeuberlich auf dem grossen Eichentisch "
    "angeordnet, bereit fuer die geschickten Haende des Waldlaeufers.");

  AddDetail( "mitte",
    "Die Mitte des Raumes wird von dem imposanten Eichentisch dominiert, auf dem "
    "Werkzeuge und Materialien geschickt angeordnet sind.");

  AddDetail( "netzwerken",
    "Netzwerke aus Seilen haengen kunstvoll um den Raum herum, als ob sie die Verbindung "
    "zwischen dem Wald und seiner gefaehrlichen Schoenheit symbolisieren.");

  AddDetail( "note",
    "Die Note von Tannennadeln in der Luft verleiht dem Raum eine frische und natuerliche "
    "Atmosphaere, die den Waldlaeufer und seine Werkstatt umgibt.");

  AddDetail( "sicherheit",
    "Die dichten Aeste des Baumes vermitteln ein Gefuehl von Sicherheit und Geborgenheit, "
    "als ob der Raum von der Natur selbst geschuetzt wuerde.");

  AddDetail( "silhouetten",
    "Die Silhouetten der Werkzeuge und Materialien sind im Halbdunkel nur schwach zu erkennen, "
    "was dem Raum eine geheimnisvolle Atmosphaere verleiht.");

  AddDetail( "stabilitaet",
    "Die Aeste des Baumes geben dem Raum eine erdige Stabilitaet, als ob er von der Natur selbst getragen wuerde.");

  AddDetail( "stimmung",
    "Die mystische Stimmung im Raum wird durch den dunstigen Nebel, die kunstvollen Fallen "
    "und die geschickte Anordnung der Werkzeuge verstaerkt.");

  AddDetail( "waldlaeufer",
    "Der Waldlaeufer, Thranduil Duesterschatten, hat die Werkstatt zu einem Spiegel seiner "
    "Fertigkeiten und seiner Verbindung zum Wald gemacht.");

  AddDetail( "werkstatt",
    "Die Werkstatt ist ein Ort der Kreativitaet und Ueberlebenskunst, wo der Dunkelelfenwaldlaeufer "
    "seine Fertigkeiten als Fallensteller und Bastler zum Ausdruck bringt.");

    AddDetail( ({ "abenteuer", "abenteuern" }),
    "Die Geschichte des Dunkelelfenwaldlaeufers ist gepraegt von zahllosen Abenteuern, die "
    "sich in der Gestaltung seiner Werkstatt widerspiegeln.");

  AddDetail( "anordnung",
    "Die geschickte Anordnung von Werkzeugen und Materialien auf dem Eichentisch zeugt von "
    "der kreativen Ordnung des Dunkelelfenwaldlaeufers.");

  AddDetail( "arbeit",
    "Die Oberflaeche des Eichentisches traegt Spuren stundenlanger Arbeit, waehrend der Waldlaeufer "
    "seine Fertigkeiten als Bastler und Fallensteller verfeinert hat.");

  AddDetail( "atmosphaere",
    "Die mystische Stimmung in der Werkstatt ist durchzogen von einem Hauch von Mysterium, "
    "der die Umgebung in eine einzigartige Atmosphaere taucht.");

  AddDetail( "ausdruck",
    "Der Eichentisch ist der Ausdruck der kuenstlerischen Ader des Dunkelelfenwaldlaeufers, "
    "wo seine Fertigkeiten und seine Persoenlichkeit sichtbar werden.");

  AddDetail( "bastler",
    "Der Dunkelelfenwaldlaeufer ist nicht nur ein geschickter Fallensteller, sondern auch ein "
    "kreativer Bastler, dessen Werkstatt von seiner handwerklichen Leidenschaft zeugt.");

  AddDetail( "duesterschatten",
    "Thranduil Duesterschatten hat seine Persoenlichkeit in jedem Detail der Werkstatt eingefangen, "
    "insbesondere in den kunstvoll versteckten Fallen und der schattigen Aura.");

  AddDetail( "eichenholztisches",
    "Die Maserung des Eichenholztisches ist wie ein Gemaelde aus Linien und Formen, "
    "das die Geschichte des Waldes und des Waldlaeufers erzaehlt.");

  AddDetail( "energie",
    "Die dunkle Energie des Dunkelelfenwaldlaeufers durchdringt die Werkstatt, verleiht ihr eine "
    "geheimnisvolle Energie, die von Abenteuerlust und Wildnis durchzogen ist.");

  AddDetail( "essenz",
    "Das klebrige Harz auf dem Boden verbreitet die Essenz des Waldes und unterstreicht die "
    "Naturverbundenheit, die den Raum durchdringt.");

  AddDetail( "fachs",
    "Die Werkstatt ist das Fach des Dunkelelfenwaldlaeufers, in dem seine Fertigkeiten als Fallensteller "
    "und Bastler zu einer beeindruckenden Einheit verschmelzen.");

  AddDetail( "fallensteller",
    "Thranduil Duesterschatten ist nicht nur ein erfahrener Waldlaeufer, sondern auch ein meisterhafter "
    "Fallensteller, wie die kunstvoll platzierten Fallen in der Werkstatt bezeugen.");

  AddDetail( "fertigkeiten",
    "Die geschickten Haende des Dunkelelfenwaldlaeufers haben im Laufe der Zeit vielfaeltige Fertigkeiten "
    "entwickelt, die in jedem Detail der Werkstatt erkennbar sind.");

  AddDetail( "formen",
    "Die Maserung des Eichenholztisches bildet faszinierende Formen, die die Handwerkskunst des "
    "Waldlaeufers auf einzigartige Weise zum Ausdruck bringen.");

  AddDetail( "gemaelde",
    "Die Maserung des Eichenholztisches ist wie ein lebendiges Gemaelde, das die Geschichten des Waldes und "
    "des Waldlaeufers auf beeindruckende Weise einfaengt.");

  AddDetail( "geschichte",
    "Die Geschichte des Baumes und die persoenliche Geschichte des Dunkelelfenwaldlaeufers sind in der "
    "Werkstatt auf faszinierende Weise miteinander verknuepft.");

  AddDetail( "gestaltung",
    "Die Gestaltung der Werkstatt zeugt von einer meisterhaften Kunstfertigkeit, bei der die Natur selbst "
    "als inspirierender Kuenstler diente.");

  AddDetail( "hauch",
    "Ein Hauch von Mysterium liegt in der Luft, als ob die Werkstatt von unsichtbaren Kraeften und "
    "geheimnisvollen Energien durchzogen waere.");

  AddDetail( "herausforderungen",
    "Die Werkstatt ist nicht nur ein Ort der Kreativitaet, sondern auch ein Ort, der die Herausforderungen "
    "des Waldes und der Natur reflektiert.");

  AddDetail( "kreativitaet",
    "Die kreative Kreativitaet des Dunkelelfenwaldlaeufers manifestiert sich in jedem Werkzeug, in jeder "
    "Fallenkonstruktion und in der gesamten Atmosphaere der Werkstatt.");

  AddDetail( "kunst",
    "Die Werkstatt ist ein Ort der Kunst, an dem die Natur selbst als kreativer Kuenstler wirkt, waehrend der "
    "Waldlaeufer seine handwerkliche Kunst verfeinert.");

  AddDetail( "kunstfertigkeit",
    "Die Kunstfertigkeit des Dunkelelfenwaldlaeufers spiegelt sich in jedem Werkzeug und in der geschickten "
    "Anordnung von Materialien auf dem Eichentisch wider.");

  AddDetail( "linien",
    "Die Maserung des Eichenholztisches bildet elegante Linien, die die Kunst und die Geschichte des "
    "Waldlaeufers in einem visuellen Erlebnis vereinen.");

  AddDetail( "meister",
    "Thranduil Duesterschatten ist ein Meister seines Fachs, dessen Koennen in der Gestaltung der Werkstatt "
    "unuebersehbar ist.");

  AddDetail( "mysterium",
    "Ein Hauch von Mysterium durchzieht die Werkstatt und verleiht ihr eine geheimnisvolle Aura, die "
    "Abenteuerlust und Neugier weckt.");

  AddDetail( "mystik",
    "Die mystische Stimmung in der Werkstatt wird von einer tiefen Mystik begleitet, die den Raum mit einer "
    "unverwechselbaren Magie erfuellt.");

  AddDetail( "natur",
    "Die Werkstatt ist durchdrungen von der puren Natur, von der inspirierenden Schoenheit des Waldes und der "
    "rohen Authentizitaet der Naturmaterialien.");

  AddDetail( "naturverbundenheit",
    "Die Naturverbundenheit des Dunkelelfenwaldlaeufers ist in der Werkstatt allgegenwaertig, von den natuerlichen "
    "Materialien bis hin zur geschickten Anordnung der Werkzeuge.");

  AddDetail( "oberflaeche",
    "Die glatte Oberflaeche des Eichentisches ist das Ergebnis sorgfaeltiger Vorbereitung und praegt den Raum "
    "mit einer handwerklichen Eleganz.");

  AddDetail( "ort",
    "Die Werkstatt ist nicht nur ein physischer Ort, sondern auch ein spiritueller Raum, der die Verbindung des "
    "Dunkelelfenwaldlaeufers zur Natur widerspiegelt.");

  AddDetail( "persoenlichkeit",
    "Die Werkstatt traegt die Persoenlichkeit des Dunkelelfenwaldlaeufers, Thranduil Duesterschatten, in jedem "
    "Detail und jeder geschickt platzierten Falle.");

  AddDetail( "praesenz",
    "Die beeindruckende Praesenz des Dunkelelfenwaldlaeufers ist spuerbar, als ob seine Anwesenheit die Werkstatt "
