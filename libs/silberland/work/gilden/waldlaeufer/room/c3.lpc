  AddDetail( "abenteuerlust",
    "Die Werkstatt weckt die Abenteuerlust in jedem, der sie betritt, und vermittelt das Gefuehl, dass "
    "hier Geschichten von faszinierenden Abenteuern geschaffen werden.");

  AddDetail( "ader",
    "Die kreative Ader des Dunkelelfenwaldlaeufers fliesst durch jedes Werkzeug, jede Falle und jede Anordnung "
