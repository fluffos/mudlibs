public int cmd_buy(string str) {
  string what, file, *items, irrelevant;
  int price, i;
  object npc, belt;

  if(!objectp(npc=present("\nwl_zeugmeister"))) {
    write(BS("Thurandul ist nicht anwesend."));
    return -1;
  }

  if(TP->QueryProp(P_GUILD) != "waldlaeufer") {
    npc->command_me("sag Du bist kein Waldlaeufer, "+TPN+".");
    return -1;
  }

  notify_fail("Um was willst du bitten?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "um %s", what) != 1 && sscanf(str, "%s um %s", irrelevant, what) != 2) return 0;

  switch(what) {
    case "guertel":
    case "fallenguertel":
      price = PREIS_GUERTEL;
      file = ARMOUR "fguertel";
      break;
    case "fallenguertel auffuellen":
    case "auffuellen":
    case "guertel fuellen":
    case "fuellung":
    case "guertel auffuellen":
      price = PREIS_REFILL;
      file = "__refill__";
      break;
    case "messer":
    case "wurfmesser":
    case "10 wurfmesser":
      price = PREIS_MESSER;
      file = WEAPON "wurfmesser";
      break;
    case "ausruestung":
    case "basisausruestung":
      price = PREIS_BASEEQ;
      file = "__equip__";
      break;
    case "beutel":
    case "kraeuterbeutel":
      price = PREIS_KBEUTEL;
      file = OBJ "kbeutel";
      break;
    case "bandolier":
    case "bandolier des waldlaeufers":
    case "waldlaeuferbandolier":
      if(TP->QueryProp(P_GUILD_LEVEL) < 6) {
        npc->command_me("sag Ein Bandolier gebe ich nur jenen, die sich als Waldlaeufer bewiesen haben, "+TPN+".");
        return -1;
      }

      if(objectp(present(BANDOLIER_ID, TP))) {
        npc->command_me("sag Du hast bereits ein Bandolier, "+TPN+".");
        return -1;
      }

      price = PREIS_BANDOLIER;
      file = ARMOUR "bandolier";
      break;
    default:
      npc->command_me("sag Das habe ich leider nicht fuer dich, "+TPN+".");
      return -1;
      break;
  }

  if(TP->QueryMoney() < price) {
    npc->command_me("sag Du hast nicht genug Geld bei dir, "+TPN+". Du benoetigst "+price+" Muenzen.");
    return -1;
  }

  switch(file) {
    case "__refill__":
      if(!objectp(belt=present(TRAP_BELT_ID, TP))) {
        npc->command_me("sag Du hast gar keinen Fallenguertel, "+TPN+".");
        return -1;
      }
      belt->fill(MAX_FALLEN_LADUNGEN);
      write(BS(npc->Name(WER, 1)+" fuellt deinen Fallenguertel wieder auf."));
      say(BS(npc->Name(WER, 1)+" fuelt "+TP->name(WESSEN, 1)+" Fallenguertel wieder auf."));
      break;
    case "__equip__":
      npc->command_me("sag Hier hast du die Grundausruestung eines Waldlaeufers, "+TPN+"!");
      items = ({ARMOUR "umhang", "/obj/seil", "/obj/fackel", "/p/armour/boots/lederstiefel",
                "/p/armour/bracers/lederarmschienen", "/p/armour/armour/lederruestung",
                "/p/armour/gloves/lederhandschuhe", "/p/armour/trousers/lederhose",
                "/p/weapon/bow/langbogen", "/p/weapon/knife/jagdmesser"});
      for(i=0; i<sizeof(items); ++i) {
        belt = clone_object(items[i]);
        belt->move(TP, M_NOCHECK);
        write(BS(npc->Name(WER)+" gibt dir "+belt->name(WEN)+"."));
        say(BS(npc->Name(WER)+" gibt "+TP->name(WEM)+" "+belt->name(WEN)+"."));
      }
      break;
    default:
      belt = clone_object(file);
      if(belt->move(TP) != 1) {
        npc->command_me("sag Du kannst das gerade nicht tragen!");
        return -1;
      }

      if(file == WEAPON "wurfmesser") {
        belt->AddAmount(9);
      }

      npc->command_me("sag Hier hast du "+belt->name(WEN)+", "+TPN+".");
      write(BS(npc->Name(WER)+" gibt dir "+belt->name(WEN)+"."));
      say(BS(npc->Name(WER)+" gibt "+TP->name(WEM)+" "+belt->name(WEN)+"."));
      break;
  }

  TP->AddMoney(-price);
  write(BS("Du gibst "+npc->name(WEM)+" "+price+" Muenzen."));
  say(BS(TPN+" gibt "+npc->name(WEM)+" "+price+" Muenzen."));

  return 1;
}
