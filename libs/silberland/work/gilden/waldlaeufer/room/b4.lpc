#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    "Du befindest Dich etwa auf mittlerer Hoehe des riesigen Baumes auf "
    "einer grossen Plattform. Immer noch ragt der gewaltige Baumstamm "
    "neben Dir viele Meter weit nach oben, als ob er gar kein Ende nehmen "
    "will. Das Blattwerk um Dich herum wird allmaehlich ein wenig "
    "durchlaessiger und laesst den einen oder anderen Sonnenstrahl "
    "hindurch. Ueber weitere Plattformen kannst Du weiter hinauf "
    "oder auch wieder hinunter gelangen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "hoehe" }),
    "Du befindest Dich ungefaehr auf mittlerer Hoehe des Baumes. "
    "Hoffentlich bist Du schwindelfrei.");

  AddDetail( ({ "schwindelfrei" }),
    "Falls nicht, solltest Du vielleicht lieber wieder auf den sicheren "
    "Waldboden zurueckkehren.");

  AddDetail( ({ "baum" }),
    "Du befindest Dich auf dem wohl groessten Baum, der im gesamten "
    "Tethyrwald nur zu finden ist. Vielleicht sogar auf dem groessten im "
    "ganzen Silberland. Wer weiss das schon.");

  AddDetail( ({ "silberland" }),
    "Das Silberland ist ueberall um Dich herum. Alles, was Du hier siehst, "
    "gehoert dazu.");

  AddDetail( ({ "tethyrwald", "wald", "tethyr" }),
    "Dies ist der Wald von Tethyr.");

  AddDetail( ({ "plattform" }),
    "Du stehst mitten auf einer grossen, hoelzernen Plattform. Wie bereits "
    "zuvor auf den anderen Plattformen siehst Du auch hier einen "
    "Unterstand, der einem der Waldlaeufer als Unterkunft zu dienen "
    "scheint.");

  AddDetail( ({ "unterstand" }),
    "Ein kleiner, aus Holzbrettern zusammengesetzter Unterstand steht "
    "hier. Seine Tuer ist mit einem dicken Seil fest verschlossen, so "
    "dass Du das Innere des Unterstandes leider nicht sehen kannst.");

  AddDetail( ({ "tuer" }),
    "Die Tuer zum Unterstand ist fest verschlossen.");

  AddDetail( ({ "seil" }),
    "Ein kurzes, dickes Seil verschliesst die Tuer.");

  AddDetail( ({ "innere", "inneres" }),
    "Du kannst nicht in das Innere des Unterstandes schauen. Aber "
    "eigentlich interessiert es Dich auch gar nicht, was dort "
    "drinnen ist.");

  AddDetail( ({ "waldlaeufer" }),
    "Die meisten Waldlaeufer sind sehr genuegsam und kommen mit den "
    "widrigsten Gegebenheiten zurecht. Auch auf eine prunkvolle Unterkunft "
    "legen sie wenig Wert, viel wichtiger ist Sinn und Zweckmaessigkeit "
    "solcher Dinge.");

  AddDetail( ({ "gegebenheiten", "gegebenheit" }),
    "Sie kommen mit den meisten Situationen problemlos klar.");

  AddDetail( ({ "situationen", "situation" }),
    "Auch Du warst bestimmt schon in so mancher Situation, in der Du "
    "lieber nicht gewesen waerst.");

  AddDetail( ({ "wert" }),
    "Legst Du Wert darauf?");

  AddDetail( ({ "sinn" }),
    "Alles muss seinen Sinn haben.");

  AddDetail( ({ "zweckmaessigkeit", "zweck" }),
    "Dieser Unterstand hier erfuellt seine Zweckmaessigkeit voll und ganz.");

  AddDetail( ({ "dinge" }),
    "Dinge wie der Unterstand zum Beispiel.");

  AddDetail( ({ "beispiel" }),
    "Das war eines.");

  AddDetail( ({ "unterkunft" }),
    "Der Unterstand ist wahrlich keine prunkvolle Unterkunft. Aber er "
    "erfuellt seinen Zweck.");

  AddDetail( ({ "baumstamm", "stamm" }),
    "Der Baumstamm wird von weichem Moos bedeckt.");

  AddDetail( ({ "moos" }),
    "Es schimmert leicht blaeulich. Als Du vorsichtig mit der Hand "
    "darueber faehrst, merkst Du, wie seidig weich es sich anfuehlt.");

  AddDetail( ({ "hand" }),
    "Du laesst Deine Hand eine Weile lang auf dem Baumstamm ruhen und "
    "geniesst das angenehme Gefuehl unter Deinen Fingern.");

  AddDetail( ({ "weile" }),
    "Eine Weile lang eben.");

  AddDetail( ({ "gefuehl" }),
    "Es fuehlt sich sehr angenehm an. Seidig weich und irgendwie "
    "ein wenig kuehl.");

  AddDetail( ({ "finger" }),
    "Deine Finger ruhen auf dem Moos des Baumstammes.");

  AddDetail( ({ "meter" }),
    "Du kannst es nicht genau sagen, aber es sind sehr viele.");

  AddDetail( ({ "ende" }),
    "Das Ende des Stammes ist von hier aus noch laengst nicht abzusehen. "
    "Es befindet sich viel, viel weiter oben.");

  AddDetail( ({ "blattwerk", "blaetterwerk" }),
    "Die Blaetter wachsen hier oben immer noch recht dicht, sind aber "
    "laengst nicht mehr so undurchdringlich wie weiter unten. Hier und "
    "da kannst Du ein Stueckchen Himmel sehen.");

  AddDetail( ({ "blaetter", "blatt" }),
    "Blaue Blaetter wachsen um Dich herum. Einige von ihnen liegen zu "
    "einem kleinen Haufen gekehrt auf dem Boden der Plattform.");

  AddDetail( ({ "stueckchen" }),
    "Hier und da siehst Du das helle Blau des Himmels durch die "
    "Blaetter scheinen.");

  AddDetail( ({ "blau" }),
    "Das helle Blau das Himmels hebt sich von der ebenfalls blaeulichen "
    "Faerbung der Blaetter um Dich herum ab.");

  AddDetail( ({ "faerbung" }),
    "Auch die Blaetter um Dich herum haben eine blaue Farbe, "
    "das Blau ist jedoch wesentlich intensiver und etwas dunkler "
    "als das eher zarte Blau des Himmels.");

  AddDetail( ({ "farbe" }),
    "Blau.");

  AddDetail( ({ "himmel" }),
    "Der blaue Himmel ist weit ueber Dir und scheint durch die Blaetter "
    "hindurch.");

  AddDetail( ({ "sonnenstrahl", "strahl", "sonnenstrahlen", "strahlen" }),
    "Der eine oder andere Sonnenstrahl dringt durch das hier oben "
    "etwas weniger dichte Blaetterwerk und kitzelt Dich an der Nase.");

  AddDetail( ({ "nase" }),
    "Du kratzt Dich.");

  AddDetail( ({ "plattformen" }),
    "Die Plattformen fuehren spiralfoermig um den Stamm herum.");

  AddDetail( ({ "boden" }),
    "Der Boden der Plattform besteht aus einfachen, aneinandergereihten "
    "Holzbrettern. An einer Stelle liegt ein kleiner Blaetterhaufen.");

  AddDetail( ({ "holzbretter", "bretter", "holzbrett", "brett" }),
    "Sie sehen aus, als waeren sie vor ihrer Verwendung kaum oder gar "
    "nicht bearbeitet worden.");

  AddDetail( ({ "verwendung" }),
    "Sie wurden zum Bau sowohl der Plattform als auch des Unterstandes "
    "verwendet.");

  AddDetail( ({ "bau" }),
    "Die groesse Arbeit duerfte es gewesen sein, die Bretter hier herauf "
    "zu schaffen.");

  AddDetail( ({ "arbeit" }),
    "Das war wohl die schwerste Arbeit bei diesem Unterfangen.");

  AddDetail( ({ "unterfangen" }),
    "Nun, irgendwer muss diese ganzen Plattformen ja gebaut haben, oder "
    "nicht?");

  AddDetail( ({ "stelle", "stellen" }),
    "An einer Stelle liegt ein Blaetterhaufen auf dem Boden.");

  AddDetail( ({ "blaetterhaufen", "haufen" }),
    "Ein kleiner Haufen von Blaettern liegt hier auf dem Boden.");

  AddDetail( ({ "waldboden" }),
    "Du kannst ihn von hier oben kaum noch sehen, aber Du weisst, "
    "dass er irgendwo unter Dir sein muss.");

  AddSound( DEFAULT_SOUND,
    "Du geniesst die friedliche Ruhe, die hier oben herrscht.");

  AddSound( ({ "ruhe" }),
    "Nur das leise Rauschen des Windes ist zu hoeren.");

  AddSound( ({ "rauschen" }),
    "*rausch*");

  AddSound( ({ "wind" }),
    "Der Wind rauscht leise.");

  AddSmell( DEFAULT_SMELL,
    "An die frische Waldluft koenntest Du Dich durchaus gewoehnen.");

  AddSmell( ({ "waldluft", "luft" }),
    "Du atmest tief ein und aus. Das tut gut!");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedostunten", ROOM "c5" );
  AddExit( "nordwestoben", ROOM "a3" );
  
  SetProp(P_HIDE_EXITS, ({"suedosten","nordwesten"}) );
   AddExit("suedosten", ROOM "c5");
   AddExit("nordwesten", ROOM "a3");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "durchsuch", "durchsuche", "durchwuehl", "durchwuehle" }),
    "wuehlen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wl4" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Details------------------------------------------------

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "tuer" ||
       str == "holztuer" ||
       str == "die tuer" ||
       str == "die holztuer" )) return 0;

  write(BS("Du fummelst an dem dicken Seil herum, bekommst den Knoten aber "
  +"nicht auf."));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" fummelt an dem Tuer herum."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

int wuehlen(string str)
{
  notify_fail("Was willst Du durchwuehlen?\n");

  if(!str || str == "") return 0;

  if(!(str == "haufen" ||
       str == "blaetterhaufen" ||
       str == "blaetter" ||
       str == "den haufen" ||
       str == "den blaetterhaufen" ||
       str == "die blaetter" )) return 0;

  write(BS("Du wuehlst mit beiden Haenden in dem Blaetterhaufen herum."));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" durchwuehlt den Blaetterhaufen."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}