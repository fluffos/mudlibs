#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    "Du befindest Dich auf einer grossen, hoelzernen Plattform hoch ueber "
    "dem Boden. Ein rundherum gefuehrtes Gelaender sorgt dafuer, dass Du "
    "nicht hinunterfallen kannst. In einer Ecke der Plattform steht ein "
    "kleiner, nur grob aus Holzbrettern gezimmerter Unterstand. Als Du "
    "hinaufschaust, siehst Du noch weitere Konstruktionen dieser Art, "
    "die scheinbar spiralfoermig rund um den Stamm des Baumes weiter "
    "hinauffuehren.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "plattform" }),
    "Die Plattform befindet sich hoch ueber dem Waldboden und wird nur "
    "von einigen starken Aesten des Baumes gehalten. In einer Ecke siehst "
    "Du einen kleinen Unterstand.");

  AddDetail( ({ "boden" }),
    "Der Boden unter Deinen Fuessen besteht aus einfachen, schmalen "
    "Holzbrettern. Durch die fuer Deinen Geschmack etwas zu grossen "
    "Ritzen zwischen den Brettern kannst Du klar und deutlich den "
    "Waldboden erkennen.");

  AddDetail( ({ "fuesse", "fuss" }),
  ([ 0: "Du denkst   . o O (Hoffentlich halten die Bretter mein Gewicht.)",
  "fee": "Pass auf, dass Du nicht durch die Ritzen hindurchfaellst." ]) );

  AddDetail( ({ "ritze", "ritzen" }),
  ([ 0: "Die Ritzen zwischen den Brettern sind fast faustbreit, ein wenig "
    "zuviel fuer Deinen Geschmack.",
  "fee": "Die Ritzen sind fast so gross wie Du selbst." ]) );

  AddDetail( ({ "geschmack" }),
    "Dir waere es wesentlich lieber, wenn die Ritzen etwas kleiner "
    "waeren.");

  AddDetail( ({ "gewicht" }),
  ([ 0: "Du denkst daran, was Du heute schon alles zu Dir genommen hast.",
  "fee": "Dein Gewicht traegt die Plattform muehelos." ]) );

  AddDetail( ({ "waldboden" }),
    "Du wirfst einen Blick ueber das Gelaender nach unten. Dort, einige "
    "Meter unter Dir, befindet sich der Waldboden.");

  AddDetail( ({ "blick" }),
    "Du schaust Dich um.");

  AddDetail( ({ "meter" }),
    "Du schaetzt die Entfernung von hier oben bis zum Waldboden auf etwa "
    "25 Meter.");

  AddDetail( ({ "entfernung" }),
    "Die Entfernung von Dir bis hinunter zum Waldboden betraegt einige "
    "Meter.");

  AddDetail( ({ "25", "menge" }),
    "Das ist schon eine ganze Menge.");

  AddDetail( ({ "gelaender" }),
    "Das Gelaender besteht aus einfachen Aesten, die quer um die Plattform "
    "herum gezogen wurden. Es verhindert, dass Du durch grobe Unachtsamkeit "
    "hinunterfaellst, dennoch solltest Du darauf achten, wo Du entlang "
    "gehst.");

  AddDetail( ({ "aeste" }),
    "Die Plattform wird von starken Aesten getragen. Auch das Gelaender "
    "wird aus Aesten gebildet. Sie sind nicht so dick wie tragenden "
    "Aeste an der Unterseite der Plattform, aber scheinbar dennoch "
    "stabil genug, dass man sich unbesorgt daran anlehnen kann.");

  AddDetail( ({ "unterseite" }),
    "Du weisst, dass sie da ist, aber Du kannst sie von hier aus "
    "nicht sehen.");

  AddDetail( ({ "unachtsamkeit" }),
    "Du solltest schon ein wenig aufpassen hier oben. So ein Sturz aus "
    "grosser Hoehe tut meistens nicht gut.");

  AddDetail( ({ "sturz" }),
    "Den willst Du sicher nicht erleben.");

  AddDetail( ({ "hoehe" }),
    "Du befindest Dich in einiger Hoehe ueber dem Waldboden.");

  AddDetail( ({ "ecke" }),
    "In einer Ecke der Plattform steht ein kleiner Unterstand.");

  AddDetail( ({ "holzbretter", "bretter", "holzbrett", "brett" }),
    "Sowohl die Plattform selbst als auch der kleine Unterstand sind "
    "aus schlichten, nur grob zurechtgeschnitzten Holzbrettern gefertigt. "
    "Auf Schoenheit wurde hierbei nicht sehr viel Wert gelegt, wichtiger "
    "schien hingegen die reine Zweckmaessigkeit.");

  AddDetail( ({ "holz" }),
    "Der Unterstand besteht komplett aus Holz.");

  AddDetail( ({ "unterstand" }),
    "Waere der Unterstand ein wenig groesser, koennte man ihn schon fast "
    "als eine Huette bezeichnen, doch dafuer ist er eigentlich zu klein. "
    "Sein Eingang ist mit einer einfachen Holztuer verschlossen und an "
    "einer Seite siehst Du sogar ein kleines Fenster.");

  AddDetail( ({ "huette" }),
    "Huette ist eigentlich uebertrieben fuer diesen Unterstand. Allerdings "
    "weist er sowohl eine Tuer als auch ein kleines Fenster auf, was fuer "
    "einen Unterstand wiederum eher ungewoehnlich ist.");

  AddDetail( ({ "eingang" }),
    "Der Eingang des Unterstandes ist mit einer einfachen Holztuer "
    "verschlossen.");

  AddDetail( ({ "tuer", "holztuer" }),
    "Die Tuer ist nur ein schlichtes breites Holzbrett ohne jegliche "
    "Verzierungen. Sie ist geschlossen.");

  AddDetail( ({ "verzierungen", "verzierung" }),
    "Es sind keine vorhanden.");

  AddDetail( ({ "schoenheit", "wert" }),
    "Auf Schoenheit wurde nicht sehr viel Wert gelegt.");

  AddDetail( ({ "zweckmaessigkeit" }),
    "Zweckmaessigkeit ist hier wichtiger als blosse Schoenheit.");

  AddDetail( ({ "seite" }),
    "An einer Seite siehst Du ein kleines Fenster.");

  AddDetail( ({ "fenster" }),
    "Das Fenster befindet sich nach aussen hin direkt ueber dem Gelaender, "
    "so dass Du leider keine Moeglichkeit siehst, durch das Fenster "
    "hindurchzuschauen.");

  AddDetail( ({ "moeglichkeit" }),
    "Es gibt keine.");

  AddDetail( ({ "plattformen", "konstruktionen", "konstruktion" }),
    "Ueber Dir siehst Du noch weitere Plattformen dieser Art, die "
    "sich spiralfoermig um den gewaltigen Stamm herum bis nach weit "
    "oben ziehen. Schmale Holzbruecken fuehren jeweils von einer "
    "Plattform bis zur naechsten.");

  AddDetail( ({ "art" }),
    "Auch die oberen Plattformen sehen, soweit Du das von hier unten aus "
    "sagen kannst, so aehnlich aus wie diese hier.");

  AddDetail( ({ "stamm" }),
    "Mit grosser Bewunderung betrachtest Du den Stamm des riesigen Baumes. "
    "Er hat einen gewaltigen Durchmesser.");

  AddDetail( ({ "bewunderung" }),
    "Du bewunderst die uneingeschraenkte Macht der Natur, die sich hier "
    "in solcher Pracht und Groesse vor Dir offenbart. Kein Lebewesen "
    "waere in der Lage, derartiges zu erschaffen.");

  AddDetail( ({ "macht" }),
    "Die Natur ist maechtiger als alles andere, was Du Dir vorstellen "
    "kannst.");

  AddDetail( ({ "natur" }),
    "Du befindest Dich hier draussen in der Natur.");

  AddDetail( ({ "pracht", "groesse" }),
    "Alleine die Ausmasse des Stammes sind einfach gewaltig.");

  AddDetail( ({ "ausmasse", "durchmesser" }),
    "Du wuerdest den Stamm gerne ausmessen, doch ein solch langes "
    "Massband duerfte nur aeusserst schwer aufzutreiben sein.");

  AddDetail( ({ "massband", "band" }),
    "Selbst wenn Du eines dabeihast, es wird mit Sicherheit viel zu "
    "kurz sein.");

  AddDetail( ({ "sicherheit" }),
    "Mit an Sicherheit grenzender Wahrscheinlichkeit.");

  AddDetail( ({ "wahrscheinlichkeit" }),
    "Es ist wirklich sehr unwahrscheinlich.");

  AddDetail( ({ "lebewesen" }),
    "Kein einziges.");

  AddDetail( ({ "lage" }),
    "Nein, auch Du nicht.");

  AddDetail( ({ "baum", "baeume" }),
    "Wenn Du Dich umschaust, siehst Du rund um Dich herum nichts als "
    "Baeume. Einige enden auf dieser Hoehe, andere wachsen noch weiter "
    "hinauf. Doch keiner ist auch nur annaehernd so gewaltig gross wie "
    "der, auf - oder besser gesagt an - dem Du Dich derzeit befindest.");

  AddDetail( ({ "holzbruecken", "bruecken", "holzbruecke", "bruecke" }),
    "Eine schmale Holzbruecke fuehrt von hier aus weiter hinauf bis "
    "zur naechsten Plattform, ueber eine weitere kannst Du wieder hinunter "
    "auf den Waldboden gelangen.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist von hier aus kaum zu sehen. Die Aeste und Wipfel "
    "der Baeume verbergen die Sicht nach oben.");

  AddDetail( ({ "sicht" }),
    "Die Sicht nach oben wird durch die Aeste und Wipfel der Baeume "
    "versperrt.");

  AddDetail( ({ "wipfel" }),
    "Die Wipfel der Baeume wiegen sich leicht im Wind.");

  AddDetail( ({ "wind" }),
    "Eine leichter Wind weht hier oben und verschafft Dir ein wenig "
    "Abkuehlung.");

  AddDetail( ({ "abkuehlung" }),
    "Du faechelst Dir ein wenig Luft zu.");

  AddDetail( ({ "luft" }),
    "Die reine Waldluft tut Dir richtig gut.");

  AddDetail( ({ "waldluft" }),
    "Du kannst sie riechen.");

  AddDetail( ({ "voegel", "vogel" }),
    "Du kannst leider keine Voegel sehen, aber Du kannst sie hoeren.");

  AddDetail( ({ "wolldecke", "decke" }),
    "Hier draussen siehst Du keine.");

  AddSound( DEFAULT_SOUND,
    "Durch das leise Rauschen des Windes dringt Vogelgezwitscher "
    "an Dein Ohr.");

  AddSound( ({ "rauschen", "wind" }),
    "Der Wind rauscht leise.");

  AddSound( ({ "vogelgezwitscher", "gezwitscher", "voegel", "vogel" }),
    "Die Voegel zwitschern eine lustige Melodie. Du summst leise mit.");

  AddSound( ({ "melodie" }),
    "Du hast sie noch nie zuvor gehoert, aber sie gefaellt Dir.");

  AddSound( ({ "ohr" }),
    "Dein Ohr schweigt vor sich hin.");

  AddSmell( DEFAULT_SMELL,
    "Die frische, reine Waldluft dringt in Deine Lungen.");

  AddSmell( ({ "waldluft", "luft" }),
    "Frisch und sauber und herrlich angenehm.");

  AddSmell( ({ "lungen" }),
    "Die riechen sicher nicht so angenehm wie die Luft hier oben.");

  AddSmell( ({ "lunge" }),
    "Die riecht sicher nicht so angenehm wie die Luft hier oben.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", ROOM "f6" );
  AddExit( "westoben", ROOM "d6" );
  
  SetProp(P_HIDE_EXITS, ({"westen"}) );
   AddExit("westen", ROOM "d6");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "lehn", "lehne" }), "lehnen" );
  AddCmd( ({ "oeffne" }), "oeffnen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wl1" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen ------------------------------------------------------------

int lehnen(string str)
{
  notify_fail("Woran willst Du Dich lehnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "an gelaender" ||
       str == "an gelaender an" ||
       str == "an das gelaender" ||
       str == "an das gelaender an" ||
       str == "an aeste" ||
       str == "an aeste an" ||
       str == "an die aeste" )) return 0;

  write(BS("Mit einem etwas mulmigen Gefuehl lehnst Du Dich an das "
  "Gelaender. Auf einmal ueberkommt Dich ein leichtes Schwindelgefuehl "
  "und Du machst rasch wieder einen Schritt nach vorn."));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" lehnt sich an das Gelaender."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "tuer" ||
       str == "holztuer" ||
       str == "die tuer" ||
       str == "die holztuer")) return 0;

  write(break_string("Du oeffnest die Tuer und wirfst einen kurzen Blick "
  "in das Innere. Bis auf eine dicke Wolldecke auf dem Boden kannst Du "
  "nichts weiter entdecken.\nEnttaeuscht schliesst Du die Tuer "
  "wieder.", 78,0,1));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" schaut sich den Unterstand etwas "
  "genauer an."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}
