#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    "Eine weitere, grosse Plattform aus Holz breitet sich hier vor Dir "
    "aus. Dein Blick streift nur kurz das Gelaender aus Aesten und den "
    "kleinen Unterstand, der sich ein Stueckchen weiter links von Dir "
    "auf der Plattform befindet. Auch die beiden Holzbruecken, die "
    "weiter hinauf und hinunter fuehren, sind kein sehr neuer Anblick "
    "fuer Dich. Vielleicht ist hier oben ja wenigstens die Aussicht "
    "schoen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "plattform" }),
    "Die Plattform besteht ebenso wie die anderen, ueber die Du hierher "
    "gelangt bist, aus einfachen Holzbrettern.");

  AddDetail( ({ "boden" }),
    "Der Boden der Plattform besteht aus Holzbrettern.");

  AddDetail( ({ "holzbretter", "bretter", "holzbrett", "brett" }),
    "Einfache, schlichte Bretter aus Holz.");

  AddDetail( ({ "holz" }),
    "Vieles hier oben besteht aus Holz. Die Plattform selbst, die Aeste "
    "und Zweige des Baumes, der Baumstamm, die Holzbruecken...");

  AddDetail( ({ "baum" }),
    "Du befindest Dich hoch auf einem Baum. Naja, AN einem Baum waere "
    "wohl richtiger. Oder auch auf einer Plattform an einem Baum. Aber "
    "wer will schon so kleinlich sein.");

  AddDetail( ({ "kleinlich" }),
    "Ok, ich sehe schon, Du bist wirklich so kleinlich.");

  AddDetail( ({ "baumstamm", "stamm" }),
    "Der gewaltige, von weichem Moos bedeckte Baumstamm ragt neben Dir "
    "zum Himmel empor.");

  AddDetail( ({ "moos" }),
    "Das weiche, blaeulich schimmernde Moos bildet eine dicke Schicht "
    "um die Rinde des Stammes.");

  AddDetail( ({ "schicht" }),
    "Sie scheint recht dick zu sein.");

  AddDetail( ({ "rinde" }),
    "Die Rinde des Stammes ist nur an wenigen Stellen unter dem Moos "
    "zu erkennen, der Grossteil von ihr wird verdeckt.");

  AddDetail( ({ "stellen", "stelle" }),
    "Nur an wenigen Stellen siehst Du ein wenig Rinde durchschimmern.");

  AddDetail( ({ "grossteil" }),
    "Die Rinde wird groesstenteils vom Moos verdeckt.");

  AddDetail( ({ "blick" }),
    "Dein Blick schweift hin und her.");

  AddDetail( ({ "gelaender" }),
    "Das Gelaender um die Plattform herum besteht aus einfachen Aesten.");

  AddDetail( ({ "aeste", "ast", "zweige", "zweig" }),
    "Hier gibt es ziemlich viele davon.");

  AddDetail( ({ "unterstand" }),
    "Der kleine, aus Holz gebaute Unterstand auf der Plattform hat eine "
    "niedrige Tuer und auch ein kleines Fenster. Beide stehen zur Zeit "
    "offen.");

  AddDetail( ({ "tuer" }),
    "Die Tuer des Unterstandes steht offen, so dass Du einen Blick ins "
    "Innere werfen kannst.");

  AddDetail( ({ "fenster" }),
    "Das Fenster, das zum Gelaender hin zeigt, ist geoeffnet, so dass "
    "frische Luft in das Innere gelangen kann.");

  AddDetail( ({ "inneres", "innere" }),
    "Du schaust neugierig ins Innere des Unterstandes. Auf dem Fussboden "
    "liegt ein alter, ein wenig schmuddeliger Teppich und an der Rueckwand "
    "steht eine klapprige kleine Liege. Anscheinend wird der Unterstand "
    "von jemandem bewohnt.");

  AddDetail( ({ "fussboden" }),
    "Der Fussboden des Unterstandes ist mit einem alten Teppich ausgelegt.");

  AddDetail( ({ "teppich" }),
    "Er sieht nicht sehr sauber aus.");

  AddDetail( ({ "rueckwand", "wand" }),
    "An der Rueckwand des Unterstandes steht eine kleine Liege.");

  AddDetail( ({ "liege" }),
    "Auch die Liege hat wohl schon bessere Zeiten gesehen. Eine loecherige "
    "Wolldecke liegt auf ihr. Ob das der Schlafplatz des Bewohners ist?");

  AddDetail( ({ "wolldecke", "decke" }),
    "Sie sieht sehr zerschliessen und loecherig aus.");

  AddDetail( ({ "schlafplatz" }),
    "Also Dir waere dieser Schlafplatz eindeutig zu primitiv. Aber als "
    "Waldlaeufer ist man ja genuegsam.");

  AddDetail( ({ "bewohner" }),
    "Vermutlich einer der Waldlaeufer.");

  AddDetail( ({ "waldlaeufer" }),
    "Du hast bestimmt schon den einen oder anderen getroffen.");

  AddDetail( ({ "zeit", "zeiten" }),
    "Die Zeit verrinnt langsam, aber stetig.");

  AddDetail( ({ "stueckchen" }),
    "Er ist ein Stueckchen weiter links von Dir.");

  AddDetail( ({ "holzbruecken", "holzbruecke", "bruecken", "bruecke" }),
    "Eine Holzbruecke fuehrt weiter nach oben zur naechsten Plattform, "
    "eine andere fuehrt nach unten.");

  AddDetail( ({ "anblick" }),
    "Hier oben bietet sich ein fast schon vertrauter Anblick fuer Dich.");

  AddDetail( ({ "aussicht" }),
    "Gespannt schaust Du Dich um. Naja. Also sehr viel ist von hier oben "
    "auch nicht zu sehen. Aber halt, im Gegensatz zu weiter unten kannst "
    "Du von hier aus sogar ein Fitzelchen Himmel erkennen, welches zwischen "
    "den ganzen Aesten und Zweigen hervorlugt.");

  AddDetail( ({ "gegensatz" }),
    "Von weiter unten ist der Himmel gar nicht zu sehen.");

  AddDetail( ({ "fitzelchen", "fitzel" }),
    "Nur ein winziges bisschen, aber immerhin.");

  AddDetail( ({ "bisschen" }),
    "Das ist doch besser als nichts, oder?");

  AddDetail( ({ "himmel" }),
    "Du siehst ein wenig Himmel zwischen den Aesten hervorblitzen. "
    "Es scheint immer noch recht gutes Wetter zu sein, soweit Du "
    "das beurteilen kannst. Aber ganz sicher bist Du Dir auch nicht.");

  AddDetail( ({ "wetter" }),
    "Der Himmel scheint huebsch blau zu sein, also kann das Wetter nicht "
    "allzu schlecht sein. Ab und zu faellt sogar ein wenig Sonnenlicht "
    "durch die Luecken.");

  AddDetail( ({ "luecken", "luecke" }),
    "Durch die Luecken zwischen den Blaettern siehst Du ein wenig "
    "Sonnenlicht hervorblitzen.");

  AddDetail( ({ "sonnenlicht", "licht" }),
  ([ 0: "Du freust Dich ueber jeden Sonnenstrahl.",
  "dunkelelf": "Eigentlich bist Du ja froh ueber jeden Sonnenstrahl, der "
    "Dir verborgen bleibt." ]) );

  AddDetail( ({ "sonne" }),
    "Die Sonne kannst Du von hier aus nicht sehen. Nur ab und zu faellt "
    "ein schwacher Sonnenstrahl durch die Blaetter.");

  AddDetail( ({ "sonnenstrahl", "strahl", "sonnenstrahlen", "strahlen" }),
    "Nur sehr wenige davon fallen durch das Blaetterwerk herab.");

  AddDetail( ({ "blaetterwerk" }),
    "Zahlreiche blaue Blaetter wiegen sich ueber, unter und neben Dir im "
    "Wind.");

  AddDetail( ({ "blaetter", "blatt" }),
    "Sie haben eine huebsche, blaue Faerbung und feine Veraestelungen auf "
    "ihrer Oberflaeche.");

  AddDetail( ({ "faerbung" }),
    "Alle Blaetter, die Du siehst, sind blau gefaerbt.");

  AddDetail( ({ "veraestelungen", "veraestelung" }),
    "Sie sind sehr fein und kaum zu erkennen.");

  AddDetail( ({ "oberflaeche", "oberflaechen" }),
    "Die Oberflaeche der Blaetter wird von feinen Veraestelungen "
    "durchzogen.");

  AddDetail( ({ "wind" }),
    "Hier oben weht eine leichte Brise.");

  AddDetail( ({ "brise" }),
    "Sie ist nur sehr schwach, Du brauchst also keine Angst haben, dass "
    "sie Dir oder der Plattform etwas anhaben koennte.");

  AddDetail( ({ "angst" }),
    "Du brauchst keine zu haben.");

  AddSound( DEFAULT_SOUND,
    "Ausser dem Rauschen des Windes und einem leisen Knarren hoerst Du "
    "nichts weiter.");

  AddSound( ({ "rauschen" }),
    "Der Wind rauscht.");

  AddSound( ({ "wind" }),
    "Hier oben weht ein leichter Wind.");

  AddSound( ({ "knarren" }),
    "Ein leises Knarren ist ab und an zu hoeren. Es scheint von den "
    "Holzbruecken zu kommen.");

  AddSound( ({ "bruecken", "holzbruecken" }),
    "Die Holzbruecken knarren leise im Wind.");

  AddSmell( DEFAULT_SMELL,
    "Wohlig atmest Du die frische Waldluft in Dich hinein.");

  AddSmell( ({ "waldluft", "luft" }),
    "Die Luft hier oben ist sehr frisch und rein. Eine pure Wohltat!");

  AddSmell( ({ "wohltat" }),
    "Es duftet angenehm.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedostunten", ROOM "d6" );
  AddExit( "nordwestoben", ROOM "b4" );
  
  SetProp(P_HIDE_EXITS, ({"suedosten","nordwesten"}) );
   AddExit("suedosten", ROOM "d6");
   AddExit("nordwesten", ROOM "b4");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "schliess", "schliesse" }), "schliessen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wl3" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen ------------------------------------------------------------

int schliessen(string str)
{
  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;

  if(str == "tuer" ||
     str == "holztuer" ||
     str == "die tuer" ||
     str == "die holztuer")
  {
    write(BS("Du ueberlegst kurz, ob Du die Tuer schliessen solltest, "
    +"bist dann aber doch zu faul dazu."));

    ENV(TP)->Message(BS(TP->Name(WER, 1)+" sieht nicht sehr "
    +"unternehmungslustig aus."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }

  if(str == "fenster" ||
     str == "das fenster")
  {
    write(BS("Du kommst leider nicht bis an das Fenster heran. Dazu "
    +"befindet es sich zu nahe am Gelaender."));

    ENV(TP)->Message(BS(TP->Name(WER, 1)+" betrachtet den Unterstand "
    +"nachdenklich."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }

  return 1;
}
