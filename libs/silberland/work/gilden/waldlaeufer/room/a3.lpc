#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    "Die grosse Plattform, auf der Du gerade stehst, ruht sicher und "
    "stabil auf den dicken Aesten des gewaltigen Baumes, an dem diese "
    "und weitere Plattformen spiralfoermig entlangfuehren. Ein erst "
    "halbfertiger Unterstand steht in einer Ecke der Plattform. Helles "
    "Licht durchdringt die Blaetter und Zweige ueber Dir, und Du "
    "hoerst froehliches Vogelgezwitscher.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "plattform" }),
    "Du laeufst einmal quer ueber die gesamte Plattform, wirfst einen "
    "kurzen Blick ueber das Gelaender und bleibst schliesslich in der "
    "Mitte der Plattform wieder stehen.");

  AddDetail( ({ "blick" }),
    "Er war gerade lang genug, um zu erkennen, dass Du Dich ziemlich weit "
    "hoch oben ueber dem eigentlichen Waldboden befindest.");

  AddDetail( ({ "gelaender" }),
    "Die gesamte Plattform ist von einem Gelaender aus Aesten umgeben, "
    "worueber Du auch ganz froh bist.");

  AddDetail( ({ "mitte" }),
    "Du stehst genau in der Mitte der Plattform.");

  AddDetail( ({ "boden" }),
    "Der Boden, auf dem Du stehst, besteht aus einfachen Holzbrettern.");

  AddDetail( ({ "waldboden" }),
    "Du kannst keine genauen Einzelheiten des Waldbodens mehr erkennen, "
    "Du weisst nur, dass er irgendwo da unten ist.");

  AddDetail( ({ "einzelheiten", "einzelheit" }),
    "Du kannst keine erkennen.");

  AddDetail( ({ "aeste", "ast" }),
    "Du befindest Dich hier auf einem Baum, also gibt es auch mehr "
    "als genug Aeste zu sehen. Auf einem der etwas duenneren Aeste ganz "
    "in Deiner Naehe sitzen zwei Amseln und unterhalten sich lautstark.");

  AddDetail( ({ "plattformen" }),
    "Es fuehren mehrere Plattformen spiralfoermig um den Stamm des Baumes "
    "herum.");

  AddDetail( ({ "stamm" }),
    "Der Stamm des Baumes hat einen gewaltigen Umfang. Er ist mit einer "
    "dicken Schicht Moos bewachsen.");

  AddDetail( ({ "umfang" }),
    "Er ist gewaltig gross.");

  AddDetail( ({ "schicht" }),
    "Eine dicke Schicht Moos bedeckt den Stamm des Baumes.");

  AddDetail( ({ "moos" }),
    "Das herabfallende Licht laesst das Moos in den verschiedensten "
    "Blautoenen glitzern und schimmern.");

  AddDetail( ({ "blautoene", "toene", "blauton", "ton" }),
    "Das Moos glaenzt und schimmert in den verschiedensten Blautoenen. "
    "Es sieht fast aus wie im Maerchen.");

  AddDetail( ({ "maerchen" }),
    "Du fuehlst Dich fast ein wenig wie in einem Maerchen.");

  AddDetail( ({ "baum", "baeume" }),
    "Ueberall um Dich herum sind Baeume. Unter Dir, neben Dir... Und auf "
    "dem groessten von ihnen befindest Du Dich gerade.");

  AddDetail( ({ "wald", "tethyr", "tethyrwald" }),
    "Du befindest Dich im Wald von Tethyr.");

  AddDetail( ({ "unterstand" }),
    "Der Unterstand scheint sich noch im Bau zu befinden. Er besteht "
    "bislang im Grunde genommen nur aus zwei rechtwinkligen Waenden, "
    "die restlichen Holzbretter stehen und liegen achtlos daneben "
    "auf dem Boden.");

  AddDetail( ({ "bau" }),
    "Da hat wohl jemand seine Arbeit noch nicht ganz beendet.");

  AddDetail( ({ "jemand" }),
    "Du hast keine Ahnung, wer diesen Unterstand gebaut hat.");

  AddDetail( ({ "ahnung" }),
    "Du hast keine. Oder etwa doch?");

  AddDetail( ({ "arbeit" }),
    "Die Arbeit an diesem Unterstand ist noch nicht beendet.");

  AddDetail( ({ "grunde", "grund" }),
    "Im Grunde genommen besteht der Unterstand nur aus zwei Waenden.");

  AddDetail( ({ "waende", "wand" }),
    "Die Rueckwand und eine der Seitenwaende stehen bereits rechtwinklig "
    "zueinander auf der Plattform.");

  AddDetail( ({ "rueckwand" }),
    "Die Rueckwand des Unterstandes wurde schon aufgestellt.");

  AddDetail( ({ "seitenwand", "seitenwaende" }),
    "Bislang steht nur eine der beiden Seitenwaende, die andere fehlt "
    "noch.");

  AddDetail( ({ "holzbretter", "holzbrett", "bretter", "brett" }),
    "Ein paar Holzbretter liegen und stehen neben dem Unterstand auf dem "
    "Boden herum. Auch der Boden selbst besteht aus ihnen.");

  AddDetail( ({ "ecke" }),
    "In einer Ecke der Plattform steht ein erst halbfertig gebauter "
    "Unterstand.");

  AddDetail( ({ "licht", "sonnenlicht" }),
    "Helles Sonnenlicht scheint zwischen den Blaettern und Zweigen ueber "
    "Dir hindurch und kitzelt Dich an der Nase.");

  AddDetail( ({ "sonnenstrahlen", "strahlen", "sonnenstrahl", "strahl" }),
    "Helle Sonnenstrahlen durchdringen das Blaetterwerk.");

  AddDetail( ({ "nase" }),
    "Die Sonnenstrahlen kitzeln Dich an der Nase.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist hellblau und die Sonne scheint. Du kannst nicht eine "
    "einzige Wolke sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint durch das Blaetterwerk auf Dich herab.");

  AddDetail( ({ "wolke" }),
    "Es ist keine zu sehen.");

  AddDetail( ({ "blaetterwerk" }),
    "Die vielen Blaetter und Zweige ueber Dir kann man auch als solches "
    "bezeichnen.");

  AddDetail( ({ "blaetter", "blatt" }),
    "Blauschimmernde Blaetter wachsen ueberall an den Aesten und Zweigen. "
    "Ob sie wohl herunterfallen, wenn man daran ruettelt?");

  AddDetail( ({ "zweige", "zweig" }),
    "Ueber Dir siehst Du zahlreiche Zweige, an denen blaue Blaetter "
    "wachsen.");

  AddDetail( ({ "vogelgezwitscher", "gezwitscher", "zwitschern" }),
    "Du koenntest ihm lauschen.");

  AddDetail( ({ "voegel", "vogel" }),
    "Hier und da kannst Du das bunte Gefieder von Voegeln durch das "
    "Geaest schimmern sehen.");

  AddDetail( ({ "geaest" }),
    "Im Geaest um Dich herum kannst Du einige Voegel sehen.");

  AddDetail( ({ "gefieder" }),
    "Anhand des Gefieders kannst Du ein paar Rotkehlchen, zwei Amseln "
    "und die eine oder andere Kohlmeise identifizieren.");

  AddDetail( ({ "rotkehlchen" }),
    "Die hellen, orangeroten Brustfedern der Rotkehlchen leuchten "
    "auffaellig durch die blauschimmernden Blaetter des Baumes hindurch.");

  AddDetail( ({ "brustfeder", "brustfedern", "federn" }),
    "Die Brustfedern der Rotkehlchen haben eine helle, orangerote Faerbung, "
    "waehrend die oberen Federn eher unauffaellig olivbraun schimmern.");

  AddDetail( ({ "faerbung" }),
    "Sieht wirklich huebsch aus.");

  AddDetail( ({ "amseln", "amsel" }),
    "Zwei Amseln sitzen auf einem Ast ganz in Deiner Naehe und scheinen "
    "sich angeregt zu unterhalten. Ihr lautes Gezwitscher klingt sehr "
    "aufgeregt.");

  AddDetail( ({ "naehe" }),
    "Der Ast befindet sich ganz in Deiner Naehe.");

  AddDetail( ({ "kohlmeise", "kohlmeisen" }),
    "Hier und da kannst Du das schwarzgelbe Gefieder einer Kohlmeise "
    "erkennen.");

  AddDetail( ({ "holzbruecke", "holzbruecken", "bruecke", "bruecken" }),
    "Wackelige Holzbruecken fuehren hinauf und hinunter zu weiteren "
    "Plattformen.");

  AddSound( DEFAULT_SOUND,
    "Froehliches Vogelgezwitscher uebertoent das leise Rauschen des "
    "Windes.");

  AddSound( ({ "vogelgezwitscher", "gezwitscher", "zwitschern", "voegel",
    "vogel" }),
    "*pieppiep*  *zwitscher*  *tschilp*");

  AddSound( ({ "rauschen", "wind" }),
    "Das leise Rauschen des Windes wird von dem froehlichen "
    "Vogelgezwitscher fast gaenzlich uebertoent.");

  AddSound( ({ "amseln", "amsel" }),
    "Du lauschst dem Gespraech der beiden Amseln, verstehst jedoch "
    "nicht, worum es geht.");

  AddSound( ({ "gespraech" }),
    "Eigentlich ist es ja aeusserst unhoeflich, fremde Gespraeche zu "
    "belauschen.");

  AddSmell( DEFAULT_SMELL,
    "Von der frischen Waldluft hier oben kannst Du gar nicht genug "
    "bekommen. Tief atmest Du ein und wieder aus.");

  AddSmell( ({ "waldluft", "luft" }),
    "Die Luft ist erfuellt von den Geruechen des Waldes.");

  AddSmell( ({ "gerueche", "geruch" }),
    "Ueberall riecht es nach Wald.");

  AddDetail( ({ "wald" }),
    "Der Wald stroemt seinen unverkennbaren Geruch aus.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedostunten", ROOM "b4" );
  AddExit( "nordostoben", ROOM "b2" );
  
  SetProp(P_HIDE_EXITS, ({"suedosten", "nordosten"}) );
   AddExit("suedosten", ROOM "b4");
   AddExit("nordosten", ROOM "b2");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "ruettel", "ruettle", "ruettele", "ruettl", "schuettel",
    "schuettle", "schuettele", "schuettl" }), "ruetteln" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wl5" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen ------------------------------------------------------------

int ruetteln(string str)
{
  notify_fail("Woran willst Du ruetteln?\n");

  if(!str || str == "") return 0;

  if(!(str == "an zweig" ||
       str == "an zweige" ||
       str == "an zweigen" ||
       str == "zweig" ||
       str == "zweige" ||
       str == "an ast" ||
       str == "an aeste" ||
       str == "an aesten" ||
       str == "ast" ||
       str == "aeste" )) return 0;

  write(BS("Du ruettelst an einem Zweig herum und loest damit einen "
  +"gewaltigen Blaetterregen aus, der um Dich herum aufwirbelt und "
  +"dann gemaechlich in Richtung Waldboden schwebt."));

  ENV(TP)->Message(break_string(TP->Name(WER, 1)+" loest einen gewaltigen "
  +"Blaetterregen aus.\nBlaue Blaetter tanzen in der Luft um Dich herum.",
  78,0,1), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}
