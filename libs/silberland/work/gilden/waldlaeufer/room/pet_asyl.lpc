#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "");
  SetProp(P_INT_LONG,
    "");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

}