#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Baum der Gezeiten");
  SetProp(P_INT_LONG,
    "Du bist auf der obersten Plattform angekommen. Weiter hinauf geht "
    "es nun nicht mehr, nur noch nach unten. Aufmerksam blickst Du Dich "
    "um und bemerkst, dass eine grosse Oeffnung hier oben mitten in den "
    "Stamm des Baumes hineinzufuehren scheint. Ueber Dir schwankt der "
    "gewaltige Wipfel leicht im Wind und vom makellos blauen Himmel "
    "strahlt die Sonne auf Dich herab.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "plattform" }),
    "Du befindest Dich auf der obersten der insgesamt acht Plattformen, "
    "ueber die Du hierher gelangt bist. Umgeben von einem Gelaender aus "
    "Aesten, macht sie einen recht sicheren und stabilen Eindruck. Von "
    "hier oben hast Du einen guten Ausblick auf den Wald.");

  AddDetail( ({ "ausblick" }),
    "Egal, in welche Richtung Du auch schaust, Du siehst Hunderte und "
    "Aberhunderte von blauen, wogenden Tannenspitzen, die sich bis zum "
    "Horizont hin auszubreiten scheinen. ");

  AddDetail( ({ "richtung", "richtungen" }),
    "Du drehst Dich einmal um Dich selbst und kommst zu dem Schluss, dass "
    "Du Dich mitten im Wald befindest. In jeder Richtung sind nur Baeume "
    "zu sehen.");

  AddDetail( ({ "schluss" }),
    "Da gibt es nichts dran zu ruetteln.");

  AddDetail( ({ "baeume" }),
    "In diesem Wald gibt es ziemlich viele davon. Tannen, Laubbaeume... "
    "alles, was das Herz begehrt.");

  AddDetail( ({ "tannen", "tanne" }),
    "Blaue Tannen recken sich zum Himmel empor, als wollten sie ihn mit "
    "ihren Spitzen beruehren.");

  AddDetail( ({ "laubbaeume", "laubbaum" }),
    "Hier und da lugt der eine oder andere Laubbaum zwischen den "
    "Tannenspitzen empor.");

  AddDetail( ({ "herz" }),
    "Und was wuenscht Du Dir gerade?");

  AddDetail( ({ "osten", "westen", "sueden", "norden" }),
    "Baeume, nichts als Baeume.");

  AddDetail( ({ "hunderte" }),
    "Hunderte blauer Tannen stehen in diesem Wald.");

  AddDetail( ({ "aberhunderte" }),
    "Das sind ziemlich viele.");

  AddDetail( ({ "tannenspitzen", "spitzen" }),
    "Die Tannenspitzen wiegen sich leicht im Wind und bilden ein "
    "einziges, wogendes blaues Meer.");

  AddDetail( ({ "wind" }),
    "Ein leichter Wind weht hier oben. Das erkennst Du an den sich "
    "wiegenden Wipfeln der Baeume um Dich herum.");

  AddDetail( ({ "meer" }),
    "Nun, es ist natuerlich kein richtiges Meer, so ganz ohne Wasser. "
    "Aber es sieht fast so aus wie eines.");

  AddDetail( ({ "wasser" }),
    "Du siehst hier oben nirgendwo Wasser. Anscheinend hat es schon "
    "laenger nicht mehr geregnet.");

  AddDetail( ({ "horizont" }),
    "Du kneifst die Augen zusammen und blickst bis zum Horizont.");

  AddDetail( ({ "auge", "augen" }),
    "Du kneifst Deine Augen ein wenig zusammen.");

  AddDetail( ({ "wald", "tethyrwald", "tethyr" }),
    "Der mystische Wald von Tethyr umgibt Dich von allen Seiten.");

  AddDetail( ({ "seiten" }),
    "Egal, wo du hinschaust.");

  AddDetail( ({ "gelaender" }),
    "Ein Gelaender aus Aesten fuehrt um die Plattform herum.");

  AddDetail( ({ "aeste" }),
    "Auch dieser Baum hier hat Aeste. Sogar Blaetter und kleinere Zweige "
    "kannst Du sehen.");

  AddDetail( ({ "eindruck" }),
    "Du fuehlst Dich recht sicher hier oben.");

  AddDetail( ({ "boden" }),
    "Du betrachtest den Boden, auf dem Du stehst, sorgfaeltig. 'Einfache "
    "Holzbretter, mit schlichten Naegeln zusammengehaemmert', sagt Dir "
    "Dein geschulter Verstand.");

  AddDetail( ({ "holzbretter", "bretter", "holzbrett", "brett" }),
    "Der Boden der Plattform besteht aus Holzbrettern.");

  AddDetail( ({ "naegel", "nagel" }),
    "Als Du genau hinschaust, kannst Du die Naegel sehen, die die "
    "Holzbretter zusammenhalten.");

  AddDetail( ({ "verstand" }),
    "Du bist mehr als zufrieden mit Deinem Verstand, der diese Tatsache "
    "so unglaublich schnell erkannt hat.");

  AddDetail( ({ "tatsache" }),
    "Die Tatsache, dass der Boden der Plattform aus Holzbrettern besteht, "
    "die von Naegeln zusammengehalten werden.");

  AddDetail( ({ "waldboden" }),
    "Der ist von hier aus nicht zu sehen. Wenn Du nicht genau wuesstest, "
    "dass er irgendwo da unten sein muss, wuerdest Du daran zweifeln.");

  AddDetail( ({ "plattformen" }),
    "Unter Dir kannst Du weitere Plattformen sehen, die spiralfoermig "
    "um den grossen Baum herumfuehren. Eine schmale Holzbruecke fuehrt "
    "von hier oben auf die naechste tiefergelegene Plattform herab.");

  AddDetail( ({ "holzbruecke", "bruecke", "holzbruecken", "bruecke" }),
    "Eine schmale Holzbruecke fuehrt nach unten auf die tiefergelegene "
    "Plattform zurueck.");

  AddDetail( ({ "oeffnung" }),
    "Suedlich von Dir fuehrt eine grosse dunkle Oeffnung mitten in den "
    "hier oben scheinbar ausgehoehlten Stamm des Baumes hinein. Du kannst "
    "nur wenige Meter in das Innere hineinblicken, bevor Dir der Blick von "
    "einem dicken, ledernen Vorhang versperrt wird.");

  AddDetail( ({ "meter" }),
    "Nach wenigen Metern wird Dein Blick durch den Vorhang gestopt.");

  AddDetail( ({ "vorhang" }),
    "An einer dicken Stange, die am oberen Ende in die Oeffnung zwischen "
    "den Stamm geklemmt wurde, haengt ein dunkler Vorhang aus schwerem "
    "Leder herab und versperrt Dir so jeglichen Blick auf das, "
    "was sich dahinter verbirgt.");

  AddDetail( ({ "stange" }),
    "Eine dicke Stange wurde in die Oeffnung des Stammes geklemmt, um "
    "so den Vorhang zu halten.");

  AddDetail( ({ "ende" }),
    "Am oberen Ende der Oeffnung.");

  AddDetail( ({ "stamm", "baumstamm" }),
    "Der gewaltige, moosbedeckte Stamm des Baumes scheint hier oben "
    "ausgehoehlt worden zu sein. Eine grosse Oeffnung fuehrt nach "
    "Sueden in das Innere hinein.");

  AddDetail( ({ "innere", "inneres" }),
    "Um zu sehen, was hinter dem Vorhang ist, muesstest Du schon nach "
    "Sueden gehen.");

  AddDetail( ({ "sueden" }),
    "Im Sueden kannst Du das Innere des Baumes betreten.");

  AddDetail( ({ "leder" }),
    "Der Vorhang besteht aus schwerem, dunkelbraunem Leder.");

  AddDetail( ({ "baum" }),
    "Noch einmal bewunderst Du den gewaltigen Baum in seiner ganzen "
    "Schoenheit.");

  AddDetail( ({ "schoenheit" }),
    "Er ist wirklich beeindruckend.");

  AddDetail( ({ "wipfel" }),
    "Der mit blauen Blaettern gekroente Wipfel des Baumes wiegt sich "
    "ueber Dir leicht im Wind. Dir wird ein wenig mulmig, als Du so "
    "hinaufstarrst und den Bewegungen des Baumes mit Deinen Blicken "
    "folgst. Schnell wendest Du Dich wieder Deiner unmittelbaren "
    "Umgebung zu.");

  AddDetail( ({ "moos" }),
    "Blauschimmerndes Moos bedeckt nahezu den gesamten Stamm des Baumes.");

  AddDetail( ({ "blaetter", "blatt" }),
    "Die Blaetter des Baumes schimmern in einem huebschen Blau.");

  AddDetail( ({ "blau" }),
    "Das typische Blau des Tethyrwaldes.");

  AddDetail( ({ "zweige", "zweig" }),
    "Hier und da siehst Du einen.");

  AddDetail( ({ "bewegung", "bewegungen" }),
    "Du hast fast das Gefuehl, zu schwanken.");

  AddDetail( ({ "gefuehl" }),
    "Du fuehlst Dich einen Moment lang etwas unsicher.");

  AddDetail( ({ "moment" }),
    "Jetzt ist er vorbei.");

  AddDetail( ({ "blicke", "blick" }),
    "Dein Blick ist aufmerksam auf Deine Umgebung gerichtet.");

  AddDetail( ({ "umgebung" }),
    "Schau Dich nur weiter um!");

  AddDetail( ({ "himmel" }),
    "Der blaue, wolkenlose Himmel erstreckt sich ueber Dir.");

  AddDetail( ({ "sonne" }),
    "Die Sonne strahlt vom blauen Himmel auf Dich herab. Ihr Glanz wird "
    "von keiner einzigen Wolke getruebt.");

  AddDetail( ({ "glanz" }),
    "Die Sonne scheint ungehindert vom Himmel.");

  AddDetail( ({ "wolke" }),
    "Es ist keine einzige Wolke am Himmel zu sehen.");

  AddDetail( ({ "stimmen", "stimme", "stimmengemurmel", "gemurmel" }),
    "Um die Stimmen naeher zu ergruenden, solltest Du nach Sueden gehen.");

  AddSound( DEFAULT_SOUND,
    "Durch das Rauschen des Windes hindurch kannst Du ein leises "
    "Stimmengemurmel vernehmen, das aus dem Sueden zu kommen scheint.");

  AddSound( ({ "rauschen", "wind" }),
    "Das leise Rauschen des Windes wirkt beruhigend auf Dich.");

  AddSound( ({ "stimmengemurmel", "gemurmel", "stimmen", "stimme" }),
    "Du kannst leise Stimmen aus dem Sueden hoeren.");

  AddSound( ({ "sueden" }),
    "Leise, unterdrueckte Stimmen ertoenen aus dem Sueden.");

  AddSmell( DEFAULT_SMELL,
    "Durch den leichten Wind hier oben ist die Luft unheimlich frisch "
    "und sauber und bestimmt auch sehr gesund.");

  AddSmell( ({ "wind" }),
    "Du haeltst Deine Nase mitten in den Wind.");

  AddSmell( ({ "nase" }),
    "Deine Nase wird kalt.");

  AddSmell( ({ "luft" }),
    "Frische Waldluft, die immer wieder von dem Wind erneuert wird, "
    "herrscht hier oben.");

  AddSmell( ({ "waldluft" }),
    "Du schnueffelst und schnupperst und kannst Dich gar nicht daran "
    "sattriechen.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordwestunten", ROOM "c1" );
  //AddExit( "sueden", ROOM "d3" );
  
  SetProp(P_HIDE_EXITS, ({"nordwesten"}) );
   AddExit("nordwesten", ROOM "c1");

  AddExit( "sueden", ([
    EX_DEST    : GUILD_ROOM,
    EX_MSG     : "hinter dem Vorhang",
    EX_MSG_OUT : "verschwindet",
    EX_MSG_IN  : "kommt durch den Vorhang herein" ]) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "wuensch", "wuensche" }), "wuenschen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wache3" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Details------------------------------------------------

int wuenschen(string str)
{
  notify_fail("Willst Du Dir etwas wuenschen?\n");

  if(!str || str == "") return 0;

  if(!(str == "etwas" ||
       str == "mir etwas" ||
       str == "dir etwas" ||
       str == "was" ||
       str == "mir was" ||
       str == "dir was" )) return 0;

  write(BS("Du schliesst die Augen und denkst an Deinen innigsten "
  +"Herzenswunsch.\nVielleicht geht er ja in Erfuellung, wer weiss."));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" blickt traeumerisch vor sich "
  +"hin."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}
