  AddDetail( ({ "aura" }),
    "Der Kraeutergarten strahlt eine heilsame Aura aus, die durch die Kombination von Pflanzen, Licht und Geraeuschen geschaffen wird.");

  AddDetail( ({ "besinnung" }),
