#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Kraeutergarten der Waldlaeufer");
  SetProp(P_INT_LONG,
    "Auf einer Holzplattform zwischen den maechtigen Aesten des majestaetischen "
    "Baumes erstreckt sich der Kraeutergarten der Waldlaeufergilde. Die kunstvoll "
    "angelegte Plattform bietet einen sicheren Raum, in dem eine Fuelle von "
    "Kraeutern gedeiht. Die frischen Duefte durchdringen die Luft, waehrend ein "
    "sanfter Wind die Blaetter und Blueten der Pflanzen streichelt. Sonnenstrahlen "
    "durchbrechen das Blaetterdach, und das Zwitschern von Voegeln begleitet die "
    "idyllische Szenerie. Dieser gruene Rueckzugsort verbindet die funktionale "
    "Schoenheit eines Kraeutergartens mit der erhebenden Atmosphaere eines hochgelegenen "
    "Refugiums, ideal fuer Waldlaeufer, um inmitten der Natur zu entspannen und "
    "Heilkraeuter zu ernten.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "aesten" }),
    "Die maechtigen Aeste des majestaetischen Baumes bilden eine natuerliche Umgebung um den Kraeutergarten, die die Plattform schuetzend umgibt.");

  AddDetail( ({ "atmosphaere" }),
    "Die Atmosphaere dieses Ortes ist gepraegt von frischen Dueften, dem sanften Streicheln des Winds und dem harmonischen Zwitschern der Voegel, was eine idyllische Ruhe schafft.");

  AddDetail( ({ "baumes" }),
    "Der majestaetische Baum, dessen Aeste die Plattform umgeben, strahlt eine imposante Praesenz aus und verleiht dem Kraeutergarten eine einzigartige Kulisse.");

  AddDetail( ({ "blaetter" }),
    "Die Blaetter der Pflanzen im Kraeutergarten sind in verschiedenen Gruentoenen gehalten und tragen zur natuerlichen Schoenheit des Raumes bei.");

  AddDetail( ({ "blaetterdach" }),
    "Das Blaetterdach ueber der Plattform laesst gelegentlich Sonnenstrahlen hindurchscheinen und schafft eine zauberhafte Lichtstimmung im Kraeutergarten.");

  AddDetail( ({ "blueten" }),
    "Zarte Blueten der Kraeuter fuegen Farbtupfer zu der gruenen Umgebung hinzu und verleihen dem Garten eine bezaubernde Pracht.");

  AddDetail( ({ "boden" }),
    "Der Boden der Plattform ist aus robustem Holz gefertigt und gibt dem Raum eine solide Basis, waehrend er gleichzeitig natuerliche Waerme ausstrahlt.");

  AddDetail( ({ "duefte" }),
    "Die frischen Duefte von Kraeutern durchdringen die Luft, und jeder Atemzug vermittelt ein Gefuehl von Naturverbundenheit und Frische.");

  AddDetail( ({ "fuelle" }),
    "Eine Fuelle von Kraeutern gedeiht auf der Plattform und bildet einen reichen Schatz an Heilpflanzen fuer die Waldlaeufer der Gilde.");

  AddDetail( ({ "heilkraeuter" }),
    "Die Heilkraeuter auf der Plattform tragen nicht nur zur Schoenheit des Gartens bei, sondern dienen auch als wichtige Ressource fuer die Waldlaeufergilde.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ueber dem Kraeutergarten ist durch das Blaetterdach nur teilweise sichtbar, jedoch tragen gelegentliche Sonnenstrahlen dazu bei, eine beruhigende Atmosphaere zu schaffen.");

  AddDetail( ({ "holzplattform" }),
    "Die kunstvoll angelegte Holzplattform bietet nicht nur einen sicheren Raum fuer den Kraeutergarten, sondern auch einen gemuetlichen Rueckzugsort hoch zwischen den Aesten des Baumes.");

  AddDetail( ({ "kraeutergarten" }),
    "Der Kraeutergarten erstreckt sich in liebevoller Anordnung auf der Plattform, und sein Anblick verbindet natuerliche Schoenheit mit funktionaler Zweckmaessigkeit.");

  AddDetail( ({ "kraeutern" }),
    "Die verschiedenen Kraeuter auf der Plattform zeigen eine harmonische Vielfalt und tragen zur medizinischen Ressource der Waldlaeufergilde bei.");

  AddDetail( ({ "luft" }),
    "Die Luft auf der Plattform ist erfuellt von frischen Aromen der Kraeuter, die eine beruhigende und belebende Wirkung zugleich haben.");

  AddDetail( ({ "natur" }),
    "Die gesamte Umgebung des Kraeutergartens strahlt die Schoenheit und Harmonie der Natur aus, eingebettet zwischen den maechtigen Aesten des Baumes.");

  AddDetail( ({ "pflanzen", "pflanze" }),
    "Die Pflanzen im Kraeutergarten zeigen sich in ihrer ganzen Pracht, und ihre verschiedenen Formen und Farben tragen zur aesthetischen Vielfalt des Gartens bei.");

  AddDetail( ({ "plattform" }),
    "Die kunstvoll angelegte Holzplattform dient nicht nur als Basis fuer den Kraeutergarten, sondern auch als erhoehter Aussichtspunkt und Rueckzugsort.");

  AddDetail( ({ "raum" }),
    "Der Raum auf der Plattform zwischen den Aesten des Baumes bildet einen gruenen Rueckzugsort, der von der Natur selbst geschaffen zu sein scheint.");

  AddDetail( ({ "refugiums" }),
    "Die erhebende Atmosphaere dieses Ortes verleiht dem Kraeutergarten das Gefuehl eines geschuetzten Refugiums hoch ueber dem Waldboden.");

  AddDetail( ({ "rueckzugsort" }),
    "Die Plattform mit dem Kraeutergarten fungiert als gemuetlicher Rueckzugsort fuer die Waldlaeufer, um sich inmitten der Natur zu entspannen und zu regenerieren.");

  AddDetail( ({ "schoenheit" }),
    "Die Schoenheit des Kraeutergartens zeigt sich in der Vielfalt der Pflanzen, den frischen Dueften und der harmonischen Anordnung auf der Holzplattform.");

  AddDetail( ({ "szenerie" }),
    "Die idyllische Szenerie wird von der kunstvoll angelegten Holzplattform, den gruenen Kraeutern und dem sanften Lichtspiel des Blaetterdachs gepraegt.");

  AddDetail( ({ "voegeln" }),
    "Das Zwitschern der Voegel rundet die natuerliche Symphonie dieses Ortes ab und fuegt der Szenerie eine lebendige Klangnote hinzu.");

  AddDetail( ({ "waldlaeufer" }),
    "Der Kraeutergarten ist nicht nur ein Ort des Anbaus, sondern auch eine wichtige Ressource fuer die Waldlaeufer der Gilde, die hier Heilkraeuter ernten und nutzen.");

  AddDetail( ({ "waldlaeufergilde" }),
    "Die Waldlaeufergilde pflegt diesen Kraeutergarten als eine lebenswichtige Quelle von Heilpflanzen, die ihre Ueberlebenskunst in der Wildnis unterstuetzt.");

  AddDetail( ({ "wind" }),
    "Ein sanfter Wind streicht durch die Aeste und bringt nicht nur frische Luft, sondern auch die subtilen Duefte der Kraeuter zu den Besuchern.");

  AddDetail( ({ "zwitschern" }),
    "Das Zwitschern der Voegel rund um den Kraeutergarten verleiht dem Raum eine lebendige und harmonische Klangkulisse, die die Naturverbundenheit unterstreicht.");

  //--Details----------------------------------------------------------------

  AddDetail( ({ "aeste" }),
    "Die Aeste des majestaetischen Baumes bilden eine natuerliche Kulisse um den Kraeutergarten und vermitteln ein Gefuehl von Geborgenheit und Schutz.");

  AddDetail( ({ "anbaus" }),
    "Der Anbau von Heilkraeutern auf der Plattform zeigt die geschickte Anordnung und Pflege, die von den Mitgliedern der Waldlaeufergilde hier betrieben wird.");

  AddDetail( ({ "anblick" }),
    "Der Anblick des Kraeutergartens auf der Holzplattform vermittelt eine beeindruckende Verbindung von funktionaler Zweckmaessigkeit und natuerlicher Schoenheit.");

  AddDetail( ({ "anordnung" }),
    "Die sorgfaeltige Anordnung der verschiedenen Kraeuterbeete auf der Plattform zeigt die Kunstfertigkeit und Aufmerksamkeit, die in den Kraeutergarten investiert wurde.");

  AddDetail( ({ "aromen" }),
    "Die Aromen der verschiedenen Kraeuter vermischen sich in der Luft und schaffen eine duftende Atmosphaere, die den Raum mit Frische erfuellt.");

  AddDetail( ({ "atemzug" }),
    "Jeder Atemzug auf der Plattform bringt die belebenden Duefte der Kraeuter mit sich und foerdert ein Gefuehl von Ruhe und Verbundenheit mit der Natur.");

  AddDetail( ({ "aussichtspunkt" }),
    "Die Holzplattform dient nicht nur als Kraeutergarten, sondern auch als erhoehter Aussichtspunkt, der einen malerischen Blick ueber den Tethyrwald ermoeglicht.");

  AddDetail( ({ "basis" }),
    "Die Holzplattform bildet die solide Basis fuer den Kraeutergarten und vermittelt ein Gefuehl von Handwerk und natuerlicher Aesthetik.");

  AddDetail( ({ "baum" }),
    "Der majestaetische Baum, der die Plattform umgibt, repraesentiert die Naturverbundenheit und die erdende Praesenz dieses Ortes.");

  AddDetail( ({ "besuchern" }),
    "Die Plattform laedt Besucher ein, den Kraeutergarten zu erkunden und inmitten der Natur die heilende Wirkung der Pflanzen zu erleben.");

  AddDetail( ({ "farben" }),
    "Die verschiedenen Gruentoene der Pflanzenblaetter und Blueten fuegen dem Kraeutergarten eine farbenfrohe Vielfalt hinzu.");

  AddDetail( ({ "farbtupfer" }),
    "Die zarten Blueten der Kraeuter setzen Farbtupfer auf der gruenen Plattform und verstaerken die aesthetische Pracht des Gartens.");

  AddDetail( ({ "formen" }),
    "Die Formen der verschiedenen Kraeuterpflanzen tragen zur visuellen Vielfalt des Kraeutergartens bei und schaffen eine harmonische Szenerie.");

  AddDetail( ({ "frische" }),
    "Die Frische der Luft auf der Plattform wird durch die Aromen der Kraeuter verstaerkt und traegt zur belebenden Atmosphaere des Gartens bei.");

  AddDetail( ({ "garten" }),
    "Der Kraeutergarten auf der Plattform ist nicht nur eine Quelle von Heilpflanzen, sondern auch ein Ort der Entspannung und visuellen Freude.");

  AddDetail( ({ "gefuehl" }),
    "Der Kraeutergarten vermittelt ein Gefuehl von Ruhe, Naturverbundenheit und Gesundheit, das Besucher tief beruehrt.");

  AddDetail( ({ "gilde" }),
    "Die Waldlaeufergilde pflegt den Kraeutergarten als eine wichtige Ressource und Ort der Zusammenkunft fuer die Mitglieder.");

  AddDetail( ({ "gruentoenen" }),
    "Die verschiedenen Gruentoene der Pflanzenblaetter und das sattgruene Blaetterdach verleihen dem Kraeutergarten eine erfrischende Natuerlichkeit.");

  AddDetail( ({ "harmonie" }),
    "Die harmonische Anordnung der Kraeuter und die umgebende Natur schaffen eine Atmosphaere der Gleichgewichts und aesthetischen Harmonie.");

  AddDetail( ({ "heilkra" }),
    "Der Anbau von Heilkraeutern auf der Plattform dient als Grundlage fuer die Heilkuenste der Waldlaeufergilde und unterstreicht ihre Ueberlebenskunst.");

  AddDetail( ({ "heilpflanzen" }),
    "Die Heilpflanzen in diesem Kraeutergarten sind eine wertvolle Ressource fuer die Waldlaeufergilde und dienen der Foerderung von Gesundheit und Wohlbefinden.");

  AddDetail( ({ "holz" }),
    "Das Holz der Plattform und der umgebenden Gelaender vermittelt eine warme und natuerliche Aesthetik, die sich gut in die Waldumgebung einfuegt.");

  AddDetail( ({ "klangkulisse" }),
    "Die Klangkulisse wird von den zarten Klaengen des Windes, dem Zwitschern der Voegel und den sanften Geraeuschen der Natur dominiert, was eine beruhigende Atmosphaere schafft.");

  AddDetail( ({ "klangnote" }),
    "Die Klangnote des Kraeutergartens wird von den natuerlichen Geraeuschen der Umgebung begleitet und verleiht dem Ort eine lebendige und harmonische Aura.");

  AddDetail( ({ "kraeuter" }),
    "Die Kraeuter auf der Plattform reichen von duftenden Minzen bis hin zu bluehenden Lavendelbueschen und bilden eine vielfaeltige Sammlung fuer die Gilde.");

  AddDetail( ({ "kulisse" }),
    "Die natuerliche Kulisse, bestehend aus den Aesten des Baumes und dem Blaetterdach, bildet einen malerischen Hintergrund fuer den Kraeutergarten.");

  AddDetail( ({ "lichtspiel" }),
    "Das Lichtspiel, das durch das Blaetterdach faellt, erzeugt zauberhafte Schattenspiele auf der Plattform und betont die natuerliche Schoenheit des Gartens.");

  AddDetail( ({ "lichtstimmung" }),
    "Die Lichtstimmung auf der Plattform variiert je nach Sonnenstand und schafft eine wechselnde, aber stets beruhigende Atmosphaere im Kraeutergarten.");

  AddDetail( ({ "naturverbundenheit" }),
    "Die gesamte Umgebung des Kraeutergartens zeugt von einer starken Naturverbundenheit, die in der Pflege des Gartens und dem Einsatz fuer Heilkraeuter deutlich wird.");

  AddDetail( ({ "ort" }),
    "Der Kraeutergarten ist nicht nur ein Ort des Anbaus, sondern auch ein Ort der Entspannung und des Innehaltens, umgeben von der belebenden Kraft der Natur.");

  AddDetail( ({ "ortes" }),
    "Die holzgerahmte Plattform vermittelt das Gefuehl, an einem besonderen Ort des Wohlbefindens und der Gemeinschaft zu verweilen.");

  AddDetail( ({ "pracht" }),
    "Die Pracht des Kraeutergartens zeigt sich in der Vielfalt der Pflanzen, ihrer Farben und dem harmonischen Gesamtbild auf der Plattform.");

  AddDetail( ({ "praesenz" }),
    "Die Praesenz des Kraeutergartens auf der Plattform wird durch die sorgfaeltige Pflege und die geschickte Anordnung der Kraeuter unterstrichen.");

  AddDetail( ({ "quelle" }),
    "Der Kraeutergarten ist eine wichtige Quelle von Heilpflanzen und symbolisiert die Verbindung der Waldlaeufergilde mit der Natur.");

  AddDetail( ({ "ressource" }),
    "Als wertvolle Ressource bietet der Kraeutergarten eine Fuelle von Heilkraeutern, die von den Waldlaeufern genutzt werden, um ihre Ueberlebenskunst zu staerken.");

  AddDetail( ({ "ruhe" }),
    "Die ruhige Atmosphaere des Kraeutergartens, begleitet von den natuerlichen Geraeuschen der Umgebung, schafft einen idealen Ort fuer Entspannung und Besinnung.");

  AddDetail( ({ "schatz" }),
    "Der Kraeutergarten ist ein kostbarer Schatz fuer die Waldlaeufergilde, der nicht nur Heilpflanzen liefert, sondern auch eine Oase der Schoenheit und Ruhe darstellt.");

  AddDetail( ({ "sonnenstrahlen" }),
    "Die gelegentlich durch das Blaetterdach hindurchfallenden Sonnenstrahlen verleihen dem Kraeutergarten eine natuerliche und wohltuende Helligkeit.");

  AddDetail( ({ "streicheln" }),
    "Der sanfte Wind streichelt die Blaetter der Kraeuter auf der Plattform und traegt zur entspannten Atmosphaere des Gartens bei.");

  AddDetail( ({ "symphonie" }),
    "Die Symphonie der Natur wird durch den Klang des Windes, das Zwitschern der Voegel und die sanften Geraeusche der Kraeuter in einen harmonischen Einklang gebracht.");

  AddDetail( ({ "ueberlebenskunst" }),
    "Der Kraeutergarten ist nicht nur ein Ort des Anbaus, sondern auch ein Symbol fuer die Ueberlebenskunst der Waldlaeufer, die in der Natur ihre Ressourcen finden.");

  AddDetail( ({ "umgebung" }),
    "Die umgebende Natur und die Aeste des Baumes schaffen eine einladende Umgebung fuer den Kraeutergarten, die von Frieden und Wohlbefinden gepraegt ist.");

  AddDetail( ({ "vielfalt" }),
    "Die Vielfalt der Kraeuter im Garten, sowohl in ihrer Art als auch in ihrer Anordnung, bildet eine faszinierende und harmonische Gesamtkomposition.");

  AddDetail( ({ "voegel" }),
