  AddDetail( ({ "aesthetik" }),
    "Die Aesthetik des Kraeutergartens manifestiert sich in der harmonischen Verbindung von Natur, Kunstfertigkeit und funktionalem Design.");

  AddDetail( ({ "anbau" }),
