  AddExit( "nordwesten", GUILD_ROOM );

//--Items & NPCs-----------------------------------------------------------

  AddItem( NPC "hork" , REFRESH_DESTRUCT);
}

public void init() {
  ::init();

  if(!RANGER_CHECK_TASK(TP, 12)) {
    call_out("inform_quest", 0, TP);
  }
  return;
}

public void inform_quest(object pl) {
  tell_object(pl, break_string("Hey, "+pl->name(WER)+"! Raziel schickt dich, richtig? Wenn du bereit bist die Verraeterin zu fangen, dann steig auf meinen Adler!", 78,
                 "Hork sagt: "));
  return;
}

public int cmd_gs12quest() {
  object questroom;

  if(RANGER_CHECK_TASK(TP, 12)) {
    write(BS("Hork sagt: Du hast diese Aufgabe bereits erledigt!"));
    return -1;
  }

  if(!objectp(find_object("/gilden/waldlaeufer/room/gs12_quest"))) {
    call_other("/gilden/waldlaeufer/room/gs12_quest", "???");
  }

  if(!objectp(questroom=find_object("/gilden/waldlaeufer/room/gs12_quest"))) {
    write(BS("Fehler: Quest kann nicht geladen werden. Bitte einem Magier melden."));
    return -1;
  }

  if(objectp(questroom->CurrentPlayer())) {
    write(BS("Hork sagt: Ich habe meinen Adler gerade an "+questroom->CurrentPlayer()->Name(WEN)+" verliehen. Komm bitte spaeter wieder!"));
    return -1;
  }

  questroom->Start(TP);
  return 1;
}
