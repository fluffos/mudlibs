#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"
inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In Horks Tierstation");
  SetProp(P_INT_LONG,
    "Du befindest dich hoch oben in den Astgabeln auf einer geraeumigen Plattform, "
    "erreichbar durch ein mannsgrosses Astloch. Auf der Plattform, die geschickt "
    "in den Baum gebaut wurde, befindet sich eine rustikale Tierpflegestation. "
    "Hier werden verschiedene Waldtiere liebevoll versorgt und gepflegt. Umgeben "
    "von natuerlicher Schoenheit, strahlt der Raum eine Aura der Geborgenheit und "
    "des Respekts vor der Natur und Tierwelt aus. Das Nest eines riesigen Adlers "
    "befindet sich etwas ueber dir.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

AddDetail( ({ "nest" }),
"Das imposante Nest eines riesigen Adlers thront majestaetisch ueber dir, " +
"ausgekleidet mit Zweigen und Moos, ein Symbol der Wildnis und Freiheit.");

AddDetail( ({"adler", "adlers"}),
"Ein riesiger Adler sitzt in einem Nest ueber dir und putzt sein Gefieder.");

AddDetail( ({"gefieder"}),
"Das Gefieder des majestaetischen Tiers ist braun und weiss.");

AddDetail( ({ "astgabeln", "astloch" }),
"Die Astgabeln erstrecken sich weit um dich herum und bilden die Struktur, " +
"die diese Plattform traegt. Das Astloch, durch das du eingetreten bist, " +
"ermoeglicht den Zugang zu diesem versteckten Ort.");

AddDetail( ({ "aura", "geborgenheit", "respekts" }),
"Die Aura dieses Raumes ist von Geborgenheit und Respekt vor der Natur und " +
"der Tierwelt erfuellt.");

AddDetail( ({"baum", "baeumen", "baeume"}),
"Der Baum, der diese Plattform traegt, ist ein majestaetisches Exemplar, " +
"dessen Aeste sich hoch ueber dir erstrecken und eine Schutz " +
"bietende Kulisse fuer diesen Raum bilden.");

AddDetail( "boden",
"Der Boden der Plattform besteht aus festen Holzplanken, die von " +
"geschickten Haenden in den Astgabeln des Baumes verankert wurden.");

AddDetail( "himmel",
"Der Himmel ueber dir erstreckt sich weit und blau, durchzogen von " +
"weichen Wolken, die langsam ueber das Blaetterdach des Waldes ziehen.");

AddDetail( "natur",
"Die Natur um dich herum ist lebendig und pulsierend, von den " +
"vogelgesungenen Melodien bis hin zum sanften Rascheln der Blaetter.");

AddDetail( "plattform",
"Die Plattform, auf der du stehst, wurde geschickt in den Baum gebaut " +
"und dient als Zentrum der Tierpflege und des Zusammenkommens fuer die " +
"Mitglieder der Waldlaeufergilde.");

AddDetail( "raum",
"Der Raum, in dem du dich befindest, ist ein Rueckzugsort der Naturverbundenheit " +
"und des Friedens, wo die Kraefte des Waldes spuerbar sind.");

AddDetail( "schoenheit",
"Die Schoenheit dieses Ortes ist ueberwaeltigend, von der majestaetischen " +
"Pracht des Baumes bis hin zu den sanften Klaengen der Natur.");

AddDetail( "tierpflegestation",
"Die rustikale Tierpflegestation auf der Plattform ist das Herz dieses " +
"Raumes, wo Waldtiere liebevoll versorgt und gepflegt werden.");

AddDetail( ({ "tierwelt", "waldtiere" }),
"Die Tierwelt des Waldes ist reich und vielfaeltig, von flinken Eichhoernchen " +
"bis hin zu majestaetischen Adlern, die hoch ueber den Wipfeln kreisen.");

AddDetail( ({ "aeste", "blaetter" }),
    "Die Aeste und Blaetter des Baumes erstrecken sich weit ueber die Plattform hinaus, " +
    "ein Schutz und eine Kulisse fuer diesen Ort der Ruhe und Harmonie.");

AddDetail( "blaetterdach",
    "Das Blaetterdach des Baumes bildet ein schuetzendes Zelt ueber dir, " +
    "durch das gelegentlich Sonnenstrahlen hindurchdringen und den Raum beleuchten.");

AddDetail( "eichhoernchen",
    "Flinke Eichhoernchen huschen geschickt durch die Aeste des Baumes, " +
    "waehrend sie nach Nuessen und anderen Leckereien suchen.");

AddDetail( "exemplar",
    "Der Baum, an dem diese Plattform gebaut wurde, ist ein beeindruckendes " +
    "Exemplar seiner Art.");

AddDetail( "freiheit",
    "Das Nest des Adlers, hoch ueber dir, ist ein Symbol der Freiheit und " +
    "der ungebaendigten Natur, die diesen Ort umgibt.");

AddDetail( "friedens",
    "Dieser Ort strahlt eine Aura des Friedens und der Ruhe aus, " +
    "wo Mensch und Natur im Einklang leben.");

AddDetail( "haenden",
    "Die Plattform wurde mit geschickten Haenden in den Astgabeln des Baumes " +
    "gebaut, ein Zeugnis handwerklichen Koennens und natuerlicher Verbundenheit.");

AddDetail( "herz",
    "Die Tierpflegestation ist das Herz dieses Raumes, wo die beduerftigen " +
    "Bewohner des Waldes Zuflucht und Pflege finden.");

AddDetail( ({"tiere", "bewohner"}),
    "Allerlei TIere sind Bewohner des Waldes. Sie werden hier gepflegt und geheilt.");

AddDetail( "holzplanken",
    "Die Holzplanken, die den Boden der Plattform bilden, " +
    "knarren sanft unter deinen Fuessen.");

AddDetail( "klaengen",
    "Die sanften Klaenge der Natur fuellen die Luft, von den zwitschernden " +
    "Voegeln bis hin zum sanften Rauschen des Windes.");

AddDetail( "kraefte",
    "Die Kraefte des Waldes sind hier spuerbar, von den starken Aesten des " +
    "Baumes bis hin zur vitalen Tierwelt, die ihn bewohnt.");

AddDetail( "kulisse",
    "Die umgebende Kulisse aus Baumwipfeln und Blaetterdaechern bildet " +
    "eine beeindruckende Szenerie um diesen Raum der Harmonie.");

AddDetail( "melodien",
    "Die melodischen Gesaenge der Voegel erfuellen die Luft, ein beruhigendes " +
    "Lied, das von der Natur selbst komponiert zu sein scheint.");

AddDetail( "mitglieder",
    "Die Mitglieder der Waldlaeufergilde nutzen diesen Ort als Treffpunkt " +
    "und Zentrum ihrer Aktivitaeten, ein Ort um mehr ueber Tiere zu lernen.");

AddDetail( "moos",
    "Das Moos, das die Baumstaemme und Aeste bedeckt, verleiht diesem " +
    "Ort eine zusaetzliche Portion Natuerlichkeit und Schoenheit.");

AddDetail( "naturverbundenheit",
    "Die Naturverbundenheit ist hier greifbar, eine tiefe Verbindung zwischen " +
    "Mensch und Umwelt.");

AddDetail( "ort",
    "Dieser Ort, hoch oben in den Astgabeln des Baumes, ist ein " +
    "Rueckzugsort der Ruhe und Naturverbundenheit.");

AddDetail( "pracht",
    "Die Pracht des Waldes offenbart sich hier, von den " +
    "majestaetischen Baeumen bis hin zu den winzigen Blueten am Boden.");

AddDetail( "rascheln",
    "Das sanfte Rascheln der Blaetter begleitet dich, waehrend der " +
    "Wind durch die Baumkronen streicht.");

AddDetail( "respekt",
    "Ein tiefes Gefuehl des Respekts vor der Natur und allen Lebewesen " +
    "durchdringt diesen Raum.");

AddDetail( "rueckzugsort",
    "Diese Plattform ist ein Rueckzugsort.");

AddDetail( "schutz",
    "Die Aeste und Blaetter des Baumes bieten Schutz vor der Sonne " +
    "und den Elemente.");

AddDetail( "struktur",
    "Die Struktur dieser Plattform ist solide und zuverlaessig, " +
    "ein sicherer Ort hoch oben in den Baeumen.");

AddDetail( "symbol",
    "Das Nest des Adlers ist ein Symbol fuer die Wildnis und Freiheit, " +
    "das hoch ueber den Baumwipfeln thront.");

AddDetail( "tierpflege",
    "Die Tierpflegestation auf der Plattform ist ein Ort der Fuersorge " +
    "und Liebe fuer die Bewohner des Waldes.");

AddDetail( "tiers",
    "Die Bewohner des Waldes, von den kleinsten Insekten bis zu den " +
    "majestaetischen Adlern, finden hier eine Heimat.");

AddDetail( "waldes",
    "Die Gerueche und Geraeusche des Waldes erfuellen die Luft, " +
    "ein staendiges Zeugnis der natuerlichen Pracht und Vielfalt.");

AddDetail( "waldlaeufergilde",
    "Die Waldlaeufergilde nutzt diesen Ort zur Ausbildung und Tierpflege.");

AddDetail( "wildnis",
    "Die ungebaendigte Wildnis des Waldes erstreckt sich um dich herum, " +
    "ein endloses Meer aus gruenen Blaettern und schattigen Baeumen.");

AddDetail( "wipfeln",
    "Die Baumwipfel wiegen sich sanft im Wind.");

AddDetail( "wolken",
    "Die Wolken ziehen langsam am Himmel vorbei, " +
    "ein staendiges Schauspiel ueber dem Blaetterdach des Waldes.");

AddDetail( "zentrum",
    "Diese Plattform dient als Zentrum der Aktivitaeten fuer die " +
    "Mitglieder der Waldlaeufergilde.");

AddDetail( "zugang",
    "Das Astloch, durch das du eingetreten bist, " +
    "bietet den Zugang zu diesem versteckten Ort der Natur.");

AddDetail( "zusammenkommens",
    "Die Plattform ist ein Ort der Gemeinschaft.");

AddDetail( "zweigen",
    "Die Zweige des Baumes wiegen sich sanft im Wind.");

AddDetail( "aktivitaeten", "Durch den Wald laufen und sowas.");

AddDetail( "art",
    "Die Art dieses Ortes ist von natuerlicher Schoenheit und harmonischer " +
    "Ausgeglichenheit gepraegt, ein Ort der Ruhe und des Friedens.");

AddDetail( "ausbildung",
    "Die Waldlaeufergilde nutzt diesen Ort auch zur Ausbildung ihrer Mitglieder, " +
    "ein Ort des Lernens und der Weiterentwicklung ihrer Faehigkeiten.");

AddDetail( ({ "baumkronen", "baumstaemme" }),
    "Die Baumkronen und Baumstaemme bilden die Struktur dieses " +
    "Platzes der Ruhe und Schoenheit, ein Schutz und eine Kulisse " +
    "fuer alles Leben, das ihn bewohnt.");

AddDetail( ({ "baumwipfel", "baumwipfeln" }),
    "Die Baumwipfel wiegen sich sanft im Wind, ein beruhigendes " +
    "Bild, das den Himmel ueber dir umrahmt und dir das Gefuehl " +
    "gibt, eins mit der Natur zu sein.");

AddDetail( "blaetterdaechern",
    "Die Blaetterdaecher der Baeume bilden ein schuetzendes Zelt ueber " +
    "dir, das dich vor der Sonne und den Elementen schuetzt.");

AddDetail( "blueten",
    "Die Blueten am Boden verstroemen einen suessen Duft und fuegen " +
    "diesem Ort eine weitere Portion Natuerlichkeit und Schoenheit hinzu.");

AddDetail( "einklang",
    "Dieser Ort ist ein Symbol des Einklangs zwischen Mensch und Natur, " +
    "ein Ort, an dem beide in Harmonie miteinander leben.");

AddDetail( "elemente",
    "Die Elemente der Natur sind hier allgegenwaertig, von der Sonne " +
    "ueber dir bis zum sanften Rauschen des Windes.");

AddDetail( "fuersorge",
    "Die Fuersorge, die hier den Tieren zuteil wird, ist ein Zeichen " +
    "der Liebe und Verbundenheit, die diesen Ort ausmacht.");

AddDetail( "fuessen",
    "Die Holzplanken knarren sanft unter deinen Fuessen, " +
    "ein vertrautes Geraeusch in dieser natuerlichen Umgebung.");

AddDetail( "gefuehl",
    "Ein Gefuehl der Ruhe und Gelassenheit erfuellt diesen Ort, " +
    "ein Ort der Entspannung und des inneren Friedens.");

AddDetail( "gemeinschaft",
    "Die Gemeinschaft der Waldlaeufergilde findet hier " +
    "einen Ort des Zusammenkommens und der Verbundenheit.");

AddDetail( "geraeusche",
    "Die Geraeusche der Natur erfuellen die Luft, ein staendiges " +
    "Symphonie der Klaenge, die dich umgeben.");

AddDetail( "gerueche",
    "Die Gerueche des Waldes haengen in der Luft, ein wuerziges " +
    "Bouquet aus Moos, Erde und frischer Luft.");

AddDetail( "gesaenge",
    "Die melodischen Gesaenge der Voegel fuellen die Luft, " +
    "ein beruhigendes Lied, das von der Natur selbst komponiert zu sein scheint.");

AddDetail( "harmonie",
    "Die Harmonie dieses Ortes ist spuerbar, ein Ort, an dem " +
    "Mensch und Natur in perfektem Gleichklang leben.");

AddDetail( "heimat",
    "Dieser Ort ist eine Heimat fuer alle Lebewesen des Waldes, " +
    "ein Ort der Sicherheit und Geborgenheit.");

AddDetail( "insekten",
    "Winzige Insekten summen umher, ein Zeichen des " +
    "reichen Lebens, das diesen Ort belebt.");

AddDetail( "klaenge",
    "Die sanften Klaenge der Natur fuellen die Luft, ein beruhigendes " +
    "Orchester aus Vogelgesaengen und Blaetterrauschen.");

AddDetail( "koennens",
    "Das handwerkliche Koennen, das in den Bau dieser Plattform " +
    "geflossen ist, ist offensichtlich, ein Zeugnis menschlicher " +
    "Kreativitaet und Naturverbundenheit.");

AddDetail( "lebewesen",
    "Die Vielfalt der Lebewesen, die diesen Ort bewohnen, ist " +
    "beeindruckend, von den kleinsten Insekten bis zu den majestaetischen " +
    "Adlern, die hoch ueber den Baumwipfeln kreisen.");

AddDetail( "leckereien",
    "Koestliche Leckereien locken die Waldtiere an, die sich hier " +
    "einfinden, um sich zu staerken und zu erholen.");

AddDetail( "liebe",
    "Die Liebe zur Natur und zu allen Lebewesen ist hier spuerbar, " +
    "ein Gefuehl, das diesen Ort mit Waerme und Guete erfuellt.");

AddDetail( "lied",
    "Das Lied der Natur erklingt ueberall um dich herum, " +
    "von den sanften Klaengen des Windes bis zu den melodischen " +
    "Gesaengen der Voegel.");

AddDetail( "luft",
    "Die Luft hier ist frisch und rein, erfuellt mit dem Duft " +
    "des Waldes und dem Atem der Natur.");

AddDetail( "meer",
    "Dieser Ort ist ein endloses Meer aus gruenen Blaettern " +
    "und schattigen Baeumen, eine unendliche Weite der Natur.");

AddDetail( "mensch",
    "Der Mensch und die Natur leben hier in Harmonie zusammen, " +
    "ein Zeichen der gegenseitigen Akzeptanz und Verbundenheit.");

AddDetail( "natuerlichkeit",
    "Die Natuerlichkeit dieses Ortes ist ueberwaeltigend, " +
    "ein Ort, an dem die Grenzen zwischen Mensch und Natur verschwimmen.");

AddDetail( "nuessen",
    "Nuesse und andere Leckereien sind reichlich vorhanden, " +
    "um die hungrigen Bewohner des Waldes zu ernaehren.");

AddDetail( "pflege",
    "Die liebevolle Pflege, die den Tieren hier zuteil wird, " +
    "ist ein Zeichen der Verbundenheit und des Respekts vor allem Leben.");

AddDetail( "portion",
    "Eine weitere Portion Naturverbundenheit und Schoenheit " +
    "findet sich an jedem einzelnen Detail dieses Ortes.");

AddDetail( "rauschen",
    "Das sanfte Rauschen der Blaetter begleitet dich, " +
    "waehrend der Wind durch die Baumkronen streicht.");

AddDetail( "ruhe",
    "Die Ruhe dieses Ortes ist unerklaerlich und beruhigend, " +
    "ein Ort des Friedens und der Gelassenheit.");

AddDetail( "schauSpiel",
    "Das Schauspiel des Waldes entfaltet sich um dich herum, " +
    "ein staendiges Theaterstueck der Natur.");

AddDetail( "sonne",
    "Die Sonne scheint warm durch das Blaetterdach, " +
    "ein sanfter Glanz, der den Raum erhellt und erwaermt.");

AddDetail( "sonnenstrahlen",
    "Die Sonnenstrahlen dringen gelegentlich durch das Blaetterdach, " +
