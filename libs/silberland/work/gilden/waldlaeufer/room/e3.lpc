#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "");
  SetProp(P_INT_LONG,
    "");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "");

  AddSpecialDetail( ({ "" }),
    "detail_fun");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage(
    ({""}),30,"func");

//--Kommandos--------------------------------------------------------------

  //AddCmd( ({ "tue" }), "cmd_tun" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", GUILD_ROOM );

//--Items & NPCs-----------------------------------------------------------

  //AddItem( "item" , REFRESH_DESTRUCT);
}
