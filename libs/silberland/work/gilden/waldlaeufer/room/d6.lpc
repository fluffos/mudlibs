#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

#define WEG  0
#define DA   1

int seil;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  seil = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    "Immer noch befindest Du Dich weit oben ueber dem Waldboden auf einer "
    "grossen Plattform. Auch hier wird das hoelzerne Konstrukt von einem "
    "natuerlichen Gelaender aus Aesten umgeben, und in einer Ecke siehst "
    "Du einen Haufen alter Bretter auf dem Boden liegen. Zwei wackelige "
    "Holzbruecken fuehren weiter nach oben und nach unten zu weiteren "
    "Plattformen, die spiralfoermig um den Stamm des Baumes herumfuehren.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "waldboden" }),
    "Der Waldboden befindet weit, weit unter Dir.");

  AddDetail( ({ "boden" }),
    "Der Boden der Plattform wurde aus einfachen, schmalen Holzbrettern "
    "angefertigt. Da die einzelnen Bretter nicht voellig nahtlos "
    "aneinander gelegt wurden, kannst Du dazwischen den Waldboden "
    "erkennen.");

  AddDetail( ({ "himmel" }),
    "Du legst Deinen Kopf in den Nacken und starrst eine Weile hinauf. "
    "Mist. Vor lauter Baeumen und Blaetter kannst Du vom Himmel leider "
    "gar nichts erkennen.");

  AddDetail( ({ "kopf" }),
    "Dein Kopf befindet sich immer noch dort, wo Du ihn das letzte Mal "
    "im Spiegel vorgefunden hast.");

  AddDetail( ({ "mal" }),
    "Das ist schon laenger her, oder?");

  AddDetail( ({ "spiegel" }),
    "Hier oben siehst Du leider keinen.");

  AddDetail( ({ "nacken" }),
    "Dein Nacken schmerzt ein wenig.");

  AddDetail( ({ "weile" }),
    "Schon vorbei.");

  AddDetail( ({ "mist" }),
    "Sowas Dummes aber auch.");

  AddDetail( ({ "dummes" }),
    "Ja, das ist wirklich dumm.");

  AddDetail( ({ "blaetter" }),
    "An den Aesten und Zweigen rings um Dich herum haengen lauter blaue "
    "Blaetter. Eines haengt gerade direkt vor Deiner Nase.");

  AddDetail( ({ "blatt" }),
    "Direkt vor Deiner Nase haengt ein kleines blaues Blatt. Du kannst "
    "seine feinen Veraestelungen deutlich erkennen.");

  AddDetail( ({ "nase" }),
    "Du unterziehst Deine Nase einer genaueren Untersuchung.");

  AddDetail( ({ "untersuchung" }),
    "Du bist eben sehr gruendlich.");

  AddDetail( ({ "veraestelung", "veraestelungen" }),
    "Feine Linien durchziehen das Blatt von oben nach unten. Dir faellt "
    "ein winziger schwarzer Punkt auf.");

  AddDetail( ({ "linie", "linien" }),
    "Feine Linien ueberziehen das blaue Blatt und bilden ein huebsches "
    "Muster.");

  AddDetail( ({ "muster" }),
    "Es ist sehr huebsch.");

  AddDetail( ({ "punkt" }),
    "Du siehst genauer hin und merkst, dass der Punkt gar kein Punkt ist, "
    "sondern eine winzige Ameise, die es sich mitten auf dem Blatt "
    "gemuetlich gemacht hat.");

  AddDetail( ({ "ameise" }),
    "Sie hockt mitten auf dem Blatt und laesst es sich gutgehen. Lass "
    "sie lieber in Ruhe.");

  AddDetail( ({ "ruhe" }),
    "Auch Ameisen brauchen ihre Ruhe.");

  AddDetail( ({ "plattform" }),
    "Die Plattform, auf der Du stehst, ruht auf den starken Aesten des "
    "Baumes. Sie befindet sich hoch ueber dem Waldboden und wird von "
    "einem Gelaender umfasst.");

  AddDetail( ({ "gelaender" }),
    "Ein Gelaender aus Aesten zieht sich um die Plattform herum.");

  AddDetail( ({ "konstrukt" }),
    "Damit ist die Plattform gemeint, auf der Du stehst.");

  AddDetail( ({ "richtung", "richtungen" }),
    "Norden, Sueden, Osten und Westen, das alles sind Richtungen.");

  AddDetail( ({ "norden", "sueden", "osten", "westen" }),
    "Das ist eine Richtung.");

  AddDetail( ({ "ecke" }),
    "In einer Ecke der Plattform liegt ein Haufen alter Bretter herum.");

  AddDetail( ({ "haufen" }),
    "Mehrere Bretter liegen zu einem unordentlichen Haufen gestapelt "
    "auf dem Boden. Wozu sie wohl da sind?");

  AddDetail( ({ "holzbretter", "bretter", "holzbrett," "brett" }),
    "Die Plattform wurde aus schmalen Holzbrettern angefertigt. Einige "
    "weitere Bretter liegen in einem unordentlichen Haufen in einer "
    "Ecke auf dem Boden.");

  AddDetail( ({ "holzbruecken", "bruecken", "holzbruecke", "bruecke" }),
    "Die Holzbruecken, die nach oben und unten zu weiteren Plattformen "
    "fuehren, sehen ziemlich wackelig aus. Insbesondere die Tatsache, "
    "dass sie anscheinend nur locker von kurzen Seilen zusammengehalten "
    "werden und in der Mitte etwas durchhaengen, macht Dich nervoes.");

  AddDetail( ({ "tatsache", "tatsachen" }),
    "Das ist eine Tatsache.");

  AddDetail( ({ "seile" }),
    "Kurze, schon leicht durchgescheuerte Seile halten die Holzbruecke "
    "zusammen.");

  AddDetail( ({ "mitte" }),
    "Die Holzbruecken haengen in der Mitte ein wenig durch, da sie nur "
    "von Seilen zusammengehalten werden.");

  AddDetail( ({ "plattformen" }),
    "Ueber und unter Dir fuehren mehrere Plattformen spiralfoermig um "
    "den gewaltigen Stamm des Baumes herum.");

  AddDetail( ({ "stamm" }),
    "Der gewaltige Stamm des Baumes wird von einer dicken Schicht Moos "
    "bedeckt.");

  AddDetail( ({ "schicht" }),
    "Sie ist bestimmt mehrere Zentimeter dick.");

  AddDetail( ({ "zentimeter" }),
    "Du weisst es nicht ganz genau.");

  AddDetail( ({ "moos" }),
    "Blaeulich schimmerndes Moos bedeckt den Stamm des Baumes fast "
    "vollstaendig. Es fuehlt sich sehr weich und ein wenig feucht an.");

  AddDetail( ({ "baum" }),
    "Der Baum, auf - oder besser gesagt an - dem Du Dich gerade befindest, "
    "ist riesig. Er ragt etliche Meter weit sowohl in die Hoehe als auch "
    "in die Tiefe hinab.");

  AddDetail( ({ "meter" }),
    "Es sind einige Meter.");

  AddDetail( ({ "hoehe" }),
    "Der Baum ragt weit in die Hoehe.");

  AddDetail( ({ "tiefe" }),
    "Hoffentlich bist Du schwindelfrei.");

  AddDetail( ({ "baeume" }),
    "Du befindest Dich mitten in einem Wald und wirst somit von Baeumen "
    "umringt.");

  AddDetail( ({ "wald", "tethyr" }),
    "Du befindest Dich im Wald von Tethyr.");

  AddSpecialDetail( ({ "aeste", "zweige" }),
    "straeste");

  AddSpecialDetail( ({ "ast" }),
    "strast");

  AddSpecialDetail( ({ "knoten" }),
    "strknoten");

  AddSpecialDetail( ({ "seil" }),
    "strseil");

  AddSpecialDetail( ({ "lauf", "blick", "blicke" }),
    "strlauf");

  AddSpecialDetail( ({ "ende" }),
    "strende");

  AddSpecialDetail( ({ "schlaufe" }),
    "strschlaufe");

  AddSpecialDetail( ({ "erkenntnis" }),
    "strerkenntnis");

  AddSound( DEFAULT_SOUND,
    "Das Rauschen des Windes dringt an Dein Ohr.");

  AddSound( ({ "rauschen" }),
    "Leise rauscht der Wind hier oben.");

  AddSound( ({ "wind" }),
    "Der Wind rauscht leise.");

  AddSound( ({ "ohr" }),
    "Das geht doch nicht.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Wald.");

  AddSmell( ({ "wald" }),
    "Frisch und wuerzig.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "ostunten", ROOM "e6" );
  AddExit( "nordwestoben", ROOM "c5" );
  
  SetProp(P_HIDE_EXITS, ({"osten","nordwesten"}) );
   AddExit("osten", ROOM "e6");
   AddExit("nordwesten", ROOM "c5");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "loes", "loese", "oeffne" }), "knoten_loesen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wl2" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails ----------------------------------------

string straeste(string str)
{
  string s;

  if(seil == DA)
  {
  	s = "Egal, in welche Richtung Du schaust, Du siehst ueberall Aeste "
       +"und Zweige. An einem Ast scheint etwas zu sein.";
  }
  else
  {
  	s = "Egal, in welche Richtung Du schaust, Du siehst ueberall Aeste "
       +"und Zweige.";
  }
  return BS(s);
}

string strast(string str)
{
  string s;

  if(seil == DA)
  {
  	s = "An einem Ast direkt ueber Dir hat jemand ein Seil mit einem "
  	   +"dicken Knoten befestigt. Es haengt bis auf den Boden der "
  	   +"Plattform herab.";
  }
  else
  {
  	s = "Egal, in welche Richtung Du schaust, Du siehst ueberall Aeste "
       +"und Zweige.";
  }
  return BS(s);
}

string strknoten(string str)
{
  string s;

  if(seil == DA)
  {
  	s = "Ein dicker Knoten sorgt dafuer, dass das Seil nicht "
  	   +"hinunterfaellt.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strseil(string str)
{
  string s;

  if(seil == DA)
  {
  	s = "Als Du dem Lauf des Seiles mit Deinen Blicken folgst, faellt Dir "
       +"auf, dass sein unteres Ende in einer runden Schlaufe auf den "
       +"Boden faellt.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strlauf(string str)
{
  string s;

  if(seil == DA)
  {
  	s = "Du folgst dem Lauf des Seiles mit Deinen Blicken.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strende(string str)
{
  string s;

  if(seil == DA)
  {
  	s = "Das untere Ende des Seiles liegt in einer runden Schlaufe auf "
    "dem Boden.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strschlaufe(string str)
{
  string s;

  if(seil == DA)
  {
  	s = "Dir faellt auf, dass Du mitten in dieser Schlaufe stehst. "
       +"Irgendwie fuehlst Du Dich etwas unwohl bei dieser Erkenntnis.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strerkenntnis(string str)
{
  string s;

  if(seil == DA)
  {
  	s = "Du denkst   . o O (Hoffentlich hat das nichts zu bedeuten.)";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

//--Funktionen ------------------------------------------------------------

int knoten_loesen(string str)
{
  object myseil;

  notify_fail("Was willst Du loesen oder oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "knoten" ||
       str == "den knoten" )) return 0;

  if(seil == DA)
  {
    myseil = clone_object("/obj/seil");
    myseil->move(ENV(TP), M_PUT|M_SILENT);

    write(BS("Mit ein wenig Anstrengung schaffst Du es, den Knoten "
    +"zu loesen. Du fuehlst Dich seltsam erleichtert, als das Seil "
    +"widerspruchslos zu Boden faellt."));

    ENV(TP)->Message(BS(TP->Name(WER, 1)+" hantiert an einem Ast herum."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    seil = WEG;
    return 1;
  }
  else
  {
    write(BS("Du siehst hier weit und breit keinen Knoten, den "
    +"Du loesen koenntest."));
    return -1;
  }
}

void reset ()
{
  ::reset();
  seil = DA;
}
