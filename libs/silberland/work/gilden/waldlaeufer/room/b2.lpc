#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    "Du stehst in luftiger Hoehe auf einer weiteren, nahe an dem dicken "
    "Stamm gelegenen Plattform. Ein leichtes Schwindelgefuehl ueberkommt "
    "Dich, als Du den Blick ueber das Gelaender wagst. Auch hier befindet "
    "sich ein kleiner, hoelzerner Unterstand ein Stueck weit neben Dir. "
    "Der Boden der Plattform wird an einer Stelle von dickem Astgeflecht "
    "unterbrochen, die sich irgendwie den Weg durch die Holzbretter "
    "hindurch gebahnt haben.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "hoehe" }),
    "Obwohl Du Dich in extremer Hoehe ueber dem Waldboden befindest, "
    "scheint Dir der gewaltige Baum, auf dem Du Dich befindest, "
    "irgendwie Sicherheit zu geben.");

  AddDetail( ({ "baum" }),
    "Der gewaltige Baum scheint ueberhaupt kein Ende nehmen zu wollen. "
    "Du legst den Kopf in den Nacken und starrst zum Wipfel des Baumes "
    "empor.");

  AddDetail( ({ "ende" }),
    "Du hast es noch nicht erreicht.");

  AddDetail( ({ "kopf" }),
    "Den Kopf hast Du weit in den Nacken gelegt.");

  AddDetail( ({ "nacken" }),
    "Du hast doch einen, oder? Falls nicht, hast Du eindeutig ein Problem.");

  AddDetail( ({ "problem" }),
    "Hast Du eines?");

  AddDetail( ({ "wipfel", "baumwipfel" }),
    "Der Wipfel des Baumes ragt viele Meter ueber Dir in den blauen "
    "Himmel hinauf und schwankt leicht im Wind. ");

  AddDetail( ({ "meter" }),
    "Es sind noch einige Meter bis zum Baumwipfel.");

  AddDetail( ({ "himmel" }),
    "Du kannst den blauen, wolkenlosen Himmel ueber Dir sehen. Die Sonne "
    "scheint durch die Aeste und Zweige ueber Dir auf Dich herab.");

  AddDetail( ({ "wolke", "wolken" }),
    "Du siehst keine einzige.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint.");

  AddDetail( ({ "wind" }),
    "Je hoeher Du gelangst, umso mehr spuerst Du den leichten Wind, "
    "der hier oben weht.");

  AddDetail( ({ "sicherheit" }),
    "Du fuehlst Dich relativ sicher hier oben.");

  AddDetail( ({ "stamm", "baumstamm" }),
    "Der mit blauem Moos bewachsene Baumstamm fasziniert Dich immer noch.");

  AddDetail( ({ "moos" }),
    "Es schimmert in den verschiedensten Blautoenen.");

  AddDetail( ({ "blautoene", "blauton", "ton", "toene" }),
    "Du kannst Dich gar nicht daran sattsehen.");

  AddDetail( ({ "aeste", "ast" }),
    "Rund um Dich herum siehst Du ueberall Aeste aus dem Baumstamm "
    "spriessen. Einige sind sogar durch den Boden der Plattform "
    "gedrungen und bilden dort ein dichtes Astgeflecht. Auch das "
    "Gelaender um die Plattform herum besteht aus Aesten.");

  AddDetail( ({ "zweige", "zweig" }),
    "Du siehst sehr viele davon.");

  AddDetail( ({ "plattform" }),
    "Die Plattform ist ebenso wie die vorherigen recht gross und bietet "
    "ausreichend Platz fuer mehrere Personen.");

  AddDetail( ({ "platz" }),
    "Es ist genuegend Platz hier oben.");

  AddDetail( ({ "personen" }),
  ([ 0: "Es ist genug Platz fuer alle da.",
  "fee": "Du brauchst keine Angst haben, zerquetscht zu werden.",
  "troll": "Selbst wenn sie von Deiner Statur sind.",
  "oger": "Selbst wenn sie von Deiner Statur sind." ]) );

  AddDetail( ({ "statur" }),
  ([ 0: "Sowas siehst Du da nicht!",
  "troll": "Du bist nicht gerade klein.",
  "oger": "Du bist nicht gerade klein." ]) );

  AddDetail( ({ "schwindelgefuehl", "gefuehl" }),
    "Obwohl Du Dich hier oben recht sicher fuehlst, ueberkommt Dich ein "
    "leichtes Schwindelgefuehl, als Du nach unten blickst.");

  AddDetail( ({ "blick" }),
    "Du schaust hinunter und versuchst vergeblich, den Waldboden zu "
    "erkennen.");

  AddDetail( ({ "gelaender" }),
    "Ein natuerliches Gelaender aus Aesten schuetzt Dich vor dem Fall "
    "nach unten.");

  AddDetail( ({ "fall" }),
    "Du faellst schon nicht hinunter, keine Bange.");

  AddDetail( ({ "bange", "angst" }),
    "Wirklich nicht.");

  AddDetail( ({ "unterstand" }),
    "Der Unterstand sieht genauso aus wie die vorherigen, die Du auf den "
    "anderen Plattformen schon begutachten konntest. Dieser hier hat "
    "kein Fenster, dafuer steht seine Tuer weit offen, so dass Du die "
    "karge Einrichtung darin sehen kannst.");

  AddDetail( ({ "fenster" }),
    "Es ist keines da.");

  AddDetail( ({ "tuer" }),
    "Die Tuer des Unterstandes steht weit offen.");

  AddDetail( ({ "einrichtung" }),
    "Eine dicke Wolldecke auf dem Boden bildet das Schlaflager, "
    "abgesehen davon ist der Unterstand vollkommen leer.");

  AddDetail( ({ "wolldecke", "decke" }),
    "Sie ist dick und warm, so dass man auch in Naechten nicht zu frieren "
    "braucht.");

  AddDetail( ({ "naechte", "nacht" }),
    "Ist es etwa schon Nacht?");

  AddDetail( ({ "schlaflager", "lager" }),
    "Es besteht nur aus einer warmen Decke. Mehr braucht man zum Schlafen "
    "auch nicht.");

  AddDetail( ({ "schlafen" }),
    "Du unterdrueckst ein Gaehnen.");

  AddDetail( ({ "gaehnen" }),
    "Ok, nun musst Du doch gaehnen. Selber schuld.");

  AddDetail( ({ "stueck" }),
    "Der Unterstand steht ein Stueck weit von Dir entfernt.");

  AddDetail( ({ "boden" }),
    "Der Boden der Plattform besteht aus Holzbrettern.");

  AddDetail( ({ "waldboden" }),
    "Du kannst ihn von hier oben nicht mehr sehen.");

  AddDetail( ({ "stelle" }),
    "An einer Stelle sind Aeste durch die Plattform gedrungen.");

  AddDetail( ({ "astgeflecht", "geflecht" }),
    "Mehrere Aeste haben sich den Weg durch die Plattform gebahnt und "
    "wachsen nun kreuz und quer uebereinander. Sie bilden ein dichtes "
    "Astgeflecht auf dem Boden der Plattform und Du solltest aufpassen, "
    "dass Du Dich nicht darin verhedderst.");

  AddDetail( ({ "weg" }),
    "Das hat sicher einige Zeit gedauert.");

  AddDetail( ({ "zeit" }),
    "Du nimmst Dir ausreichend Zeit, um Dich hier oben genau umzusehen "
    "und jede Einzelheit einer genauen Untersuchung zu unterziehen.");

  AddDetail( ({ "einzelheiten", "einzelheit" }),
    "Es gibt hier einige.");

  AddDetail( ({ "untersuchung" }),
    "Siehst Du? :-)");

  AddDetail( ({ "holzbretter", "bretter", "holzbrett", "brett" }),
    "Sowohl der Boden der Plattform als auch der kleine Unterstand darauf "
    "wurden aus einfachen, schlichten Holzbrettern angefertigt.");

  AddDetail( ({ "holz" }),
    "Das Holz hat eine warme, mittelbraune Farbe und eine natuerliche "
    "Maserung.");

  AddDetail( ({ "farbe", "faerbung", "farbmischung", "mischung" }),
    "Das warme Braun des Holzes bildet einen schoenen Kontrast zu dem "
    "leuchtenden Blau der Blaetter um Dich herum.");

  AddDetail( ({ "braun" }),
    "Das Holz hat eine warme, mittelbraune Faerbung.");

  AddDetail( ({ "kontrast" }),
    "Es ist eine sehr schoene, stimmige Farbmischung, die Dich umgibt. "
    "Sie wirkt geradezu beruhigend auf Dich.");

  AddDetail( ({ "blau" }),
    "Die Blaetter des Baumes sind leuchtend blau.");

  AddDetail( ({ "blaetter", "blatt" }),
    "Blaue Blaetter wachsen an den Aesten.");

  AddDetail( ({ "maserung" }),
    "Das Holz hat keine voellig glatte Oberflaeche, sondern ist natuerlich "
    "gemasert.");

  AddDetail( ({ "oberflaeche" }),
    "Du hockst Dich kurz hin und befuehlst die Oberflaeche der Holzbretter. "
    "Sie fuehlt sich etwas uneben und auf eine seltsame Weise irgendwie... "
    "nun ja, lebendig an.");

  AddDetail( ({ "weise" }),
    "Du kannst es Dir nicht erklaeren.");

  AddSound( DEFAULT_SOUND,
    "Du stehst ganz still und lauschst dem Rauschen des Windes und dem "
    "leisen Knacken der Aeste.");

  AddSound( ({ "rauschen" }),
    "*rausch*");

  AddSound( ({ "wind" }),
    "Der Wind rauscht leise in den Blaettern und Zweigen des Baumes.");

  AddSound( ({ "blaetter", "zweige", "aeste" }),
    "Sie bewegen sich leicht im Wind.");

  AddSound( ({ "baum", "stamm" }),
    "Du lauschst am Stamm des Baumes, doch dieser bleibt still.");

  AddSound( ({ "knacken" }),
    "Ab und zu hoerst Du ein leises Knacken, wenn der Wind die Aeste "
    "und Zweige bewegt.");

  AddSmell( DEFAULT_SMELL,
    "Du kannst gar nicht genug bekommen von der frischen Waldluft. Du "
    "schliesst einen Moment lang die Augen und atmest tief ein und aus.");

  AddSmell( ({ "waldluft", "luft" }),
    "Frische, wuerzige Waldluft umschmeichelt Deine Nase.");

  AddSmell( ({ "wald" }),
    "Der Wald duftet frisch und wuerzig.");

  AddSmell( ({ "nase", "augen" }),
    "Also bitte, das ist technisch nun wirklich vollkommen unmoeglich.");

  AddSmell( ({ "moment" }),
    "Nein, so wird das nichts mit Dir.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedwestunten", ROOM "a3" );
  AddExit( "nordostoben", ROOM "c1" );
  
  SetProp(P_HIDE_EXITS, ({"suedwesten","nordosten"}) );
   AddExit("suedwesten", ROOM "a3");
   AddExit("nordosten", ROOM "c1");

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wl6" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Details------------------------------------------------
