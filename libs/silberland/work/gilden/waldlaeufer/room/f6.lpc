#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    "Nur wenige Meter vor Dir ragt ein gewaltiger Baumriese in den Himmel "
    "empor. Voellig ueberwaeltigt starrst Du in die geradezu endlos "
    "wirkende Hoehe und wunderst Dich ein wenig, wieso Dir dieses Ungetuem "
    "von einem Baum nicht schon frueher aufgefallen ist. Erst nach einer "
    "Weile bemerkst Du die seltsame Konstruktion, die sich ein Stueck "
    "weiter oben an dem riesigen Stamm befindet.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "meter" }),
    "Du befindest Dich nur ein paar Meter von dem emporragenden Stamm des "
    "riesigen Baumes entfernt.");

  AddDetail( ({ "baumriese", "riese" }),
    "Du hast schon viel Ungewoehnliches in Deinem Leben gesehen, aber "
    "der gewaltige Baum vor Dir ist wirklich bemerkenswert.");

  AddDetail( ({ "ungewoehnliches" }),
    "Dir sind schon Sachen untergekommen, von denen Du selbst nicht einmal "
    "im Traum gedacht haettest, dass sie ueberhaupt existieren.");

  AddDetail( ({ "sachen" }),
    "Ungewoehnliche Sachen.");

  AddDetail( ({ "dinge" }),
    "Du wirst schon sehen.");

  AddDetail( ({ "traum" }),
    "Nein, dies hier ist kein Traum. Du bist hellwach.");

  AddDetail( ({ "leben" }),
    "Du hast noch ein langes Leben vor Dir und wirst sicherlich noch sehr "
    "viel mehr ungewoehnliche Dinge sehen.");

  AddDetail( ({ "himmel" }),
    "Weit ueber Dir befindet sich der Himmel, auch wenn Du ihn von hier "
    "aus nur erahnen kannst. Die Aeste und Wipfel der Baeume ringsum "
    "versperren Dir jegliche Sicht auf das Blau des Himmels.");

  AddDetail( ({ "ast", "aeste" }),
    "Ein gewaltiges Netzwerk von Aesten versperrt Dir jegliche "
    "Sicht nach oben auf den Himmel.");

  AddDetail( ({ "netzwerk" }),
    "Die Aeste der Baeume bilden ein gewaltiges Netzwerk ueber Dir.");

  AddDetail( ({ "wipfel" }),
    "Die Wipfel der Baeume ringsum schwanken leicht im Wind.");

  AddDetail( ({ "wind" }),
    "Du spuerst einen schwachen Windhauch auf Deiner Haut.");

  AddDetail( ({ "hauch", "windhauch" }),
    "Er ist kaum zu spueren und eigentlich ganz angenehm.");

  AddDetail( ({ "haut" }),
    "Deine Haut koennte ruhig mal ein wenig Sonne vertragen.");

  AddDetail( ({ "sonne" }),
    "Die ist von hier aus nicht zu sehen.");

  AddDetail( ({ "wolke", "wolken" }),
    "Du kannst keine einzige Wolke sehen. Vielleicht liegt das daran, "
    "dass Dir jeglicher Blick auf den Himmel von hier versperrt wird.");

  AddDetail( ({ "blick" }),
    "Dein Blick schweift hin und her, immer in der Erwartung, etwas "
    "Neues zu erblicken.");

  AddDetail( ({ "erwartung", "neues" }),
    "Erwartungsvoll schaust Du Dich um.");

  AddDetail( ({ "sicht" }),
    "Die Sicht auf den Himmel wird Dir hier voellig versperrt. Du siehst "
    "nur Baeume, egal wo Du auch hinschaust.");

  AddDetail( ({ "blau" }),
    "Den blauen Himmel kannst Du von hier aus leider nicht sehen, aber "
    "es ist ja ohnehin nahezu alles um Dich herum in ein zartes Blau "
    "getaucht. So langsam gewoehnst Du Dich auch an den Anblick.");

  AddDetail( ({ "anblick" }),
    "An all das Blau in diesem Wald muss man sich erst einmal gewoehnen.");

  AddDetail( ({ "wald", "tethyr" }),
    "Du befindest Dich irgendwo mitten in dem geheimnisvollen Wald von "
    "Tethyr.");

  AddDetail( ({ "hoehe" }),
    "Der Baum vor Dir ragt endlos weit in die Hoehe.");

  AddDetail( ({ "ungetuem" }),
    "Man kann wirklich fast von einem Ungetuem sprechen.");

  AddDetail( ({ "baum", "baeume" }),
    "Ueberall um Dich herum sind Baeume, Baeume und nochmals Baeume, egal "
    "wohin Du Dich auch wendest. Sie wirken durch ihre blaue Faerbung fast "
    "ein wenig unwirklich.");

  AddDetail( ({ "farbe", "faerbung" }),
    "Alles um Dich herum ist blau, die Blaetter der Baeume, das Moos zu "
    "Deinen Fuessen, ja selbst die Aeste und Zweige schimmern leicht "
    "blaeulich.");

  AddDetail( ({ "blaetter", "blatt" }),
    "Die Blaetter der Baeume um Dich herum sind blau gefaerbt. Aber "
    "das duerfte Dir bereits aufgefallen sein. Auch auf dem Boden siehst "
    "Du einige der blauen Blaetter liegen.");

  AddDetail( ({ "zweig", "zweige" }),
    "Einige kleinere Zweige liegen auf dem Boden verstreut. Sie schimmern "
    "leicht blaeulich.");

  AddDetail( ({ "fuss", "fuesse" }),
    "Du stehst mit beiden Fuessen fest auf dem Boden.");

  AddDetail( ({ "weile" }),
    "Du warst noch voellig gefangen von den blossen Ausmassen des "
    "Baumes, dass Du auf nichts anderes geachtet hast.");

  AddDetail( ({ "ausmass", "ausmasse" }),
    "Die Ausmasse sind wirklich gewaltig.");

  AddDetail( ({ "konstruktion", "gebilde" }),
    "Du betrachtest das seltsame Gebilde etwas naeher. Es besteht aus "
    "mehreren nebeneinander befestigten Holzbrettern, die wohl "
    "eine Art Plattform zu bilden scheinen. Dir faellt eine lange, sehr "
    "schmale Holzbruecke ins Auge, die zu der Plattform hinauffuehrt.");

  AddDetail( ({ "holzbretter", "bretter", "holzbrett", "brett" }),
    "Mehrere aneinander befestigte Bretter bilden eine grosse Plattform, "
    "die sich in luftiger Hoehe am Stamm des Baumes befindet und nur "
    "von wenigen starken Aesten getragen zu werden scheint.");

  AddDetail( ({ "art" }),
    "Die Konstruktion scheint eine Art Plattform darzustellen.");

  AddDetail( ({ "plattform" }),
    "Was sich dort oben wohl befinden mag?");

  AddDetail( ({ "stueck" }),
    "Die Plattform befindet sich ein ganzes Stueck ueber Dir.");

  AddDetail( ({ "auge" }),
    "Das war bildlich gemeint.");

  AddDetail( ({ "stamm", "staemme" }),
    "Der gewaltige Stamm ragt vor Dir empor.");

  AddDetail( ({ "boden", "waldboden" }),
    "Der Waldboden unter Deinen Fuessen ist mit weichem Moos bedeckt. Hier "
    "und da siehst Du einige kleinere Zweige und Blaetter liegen, die wohl "
    "von den Baeumen gefallen sind.");

  AddDetail( ({ "moos" }),
    "Weiches Moos bildet den Untergrund unter Deinen Fuessen. Es ist "
    "herrlich angenehm, darauf zu laufen. Du hast fast das Gefuehl, zu "
    "schweben.");

  AddDetail( ({ "untergrund" }),
    "Unter Dir befindet sich der Waldboden.");

  AddDetail( ({ "gefuehl" }),
    "Es ist ein sehr schoenes Gefuehl.");

  AddDetail( ({ "schatten" }),
    "Die Baeume um Dich herum werfen ihre grossen Schatten auf den Boden.");

  AddSpecialDetail( ({ "holzbruecke", "bruecke" }),
    "strbruecke");

  AddSpecialDetail( ({ "gestalt", "gestalten" }),
    "strgestalt");

  AddSound( DEFAULT_SOUND,
    "Du lauscht dem Rauschen des Windes. Gelegentlich kannst Du ein leises "
    "Rascheln hoeren, das irgendwo aus dem Wald zu kommen scheint.");

  AddSound( ({ "rauschen", "wind" }),
    "Der Wind rauscht leise vor sich hin.");

  AddSound( ({ "rascheln", "wald" }),
    "Ab und zu ist ein leises Rascheln aus dem Wald zu hoeren. "
    "Sicher nur ein Tier auf Futtersuche oder so.");

  AddSound( ({ "tier", "futtersuche" }),
    "Nichts, worueber Du Dir Sorgen machen muesstest.");

  AddSound( ({ "sorgen" }),
    "Du lauschst angestrengt.");

  AddSmell( DEFAULT_SMELL,
    "Der Wald verstroemt einen intensiven, leicht wuerzigen Duft nach... "
    "nun ja, nach Wald eben.");

  AddSmell( ({ "duft", "wald" }),
    "Du saugst den frischen Duft des Waldes foermlich in Dich hinein. "
    "Einfach herrlich!");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", "nach Osten#" + GILDE_WALD );
  AddExit( "westen", "nach Westen#" + "./e6" );

  /*
  AddExit( "westen", ([ EX_DEST:     "././e6",
                      EX_MSG:      "nach Westen",
                      EX_TESTFUNC: "exit_test" ]) ); */

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wache1" , REFRESH_DESTRUCT);
  AddItem(NPC "wache2" , REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Details------------------------------------------------

string strbruecke(string str)
{
  string s;
  object *wachen;
  wachen = all_inventory(TO);
  wachen = filter_objects(wachen,"id","\nwlwache");

  switch(sizeof(wachen))
  {
    case 0:
      s = "Eine schmale, ziemlich wackelig aussehende Holzbruecke fuehrt "
          "zu der Plattform hinauf.";
      break;

    case 1:
      s = "Eine schmale, ziemlich wackelig aussehende Holzbruecke fuehrt "
          "zu der Plattform hinauf. Sie wird von einer dunkel "
          "gekleideten Gestalt bewacht.";
      break;

    default:
      s = "Eine schmale, ziemlich wackelig aussehende Holzbruecke fuehrt "
          "zu der Plattform hinauf. Sie wird von zwei dunkel gekleideten "
          "Gestalten bewacht.";
     break;
  }

  return BS(s);
}

string strgestalt(string str)
{
  string s;
  object *wachen;
  wachen = all_inventory(TO);
  wachen = filter_objects(wachen,"id","\nwlwache");

  switch(sizeof(wachen))
  {
    case 0:
      s = "Sowas siehst Du da nicht!";
      break;

    case 1:
      s = "Eine dunkle Gestalt lehnt im Schatten des Baumes an dessen "
          "Stamm. Sie scheint Dich bereits seit geraumer Zeit "
          "zu beobachten.";
      break;

    default:
      s = "Du siehst zwei dunkle Gestalten im Schatten der Baeume stehen. "
          "Sie scheinen Dich bereits seit geraumer Zeit zu beobachten.";
     break;
  }

  return BS(s);
}

//--Funktion fuer Ausgang--------------------------------------------------

