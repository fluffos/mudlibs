#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Hoch auf einem maechtigen Baum");
  SetProp(P_INT_LONG,
    "Auf einem grossen und starken Ast hoch oben im majestaetischen Baum "
    "thront der Raum von Fianna Lauscht-dem-Wind, der Meisterin des Iama. "
    "Von hier aus erstreckt sich ein atemberaubender Panoramablick ueber den "
    "gesamten Tethyrwald, und die sanften Geraeusche, die der Wind herbeitraegt, "
    "wirken wie eine zauberhafte Symphonie von Musik und Melodien. In dieser "
    "erhabenen Umgebung, wo Natur und Klang in perfekter Harmonie verschmelzen, "
    "empfaengt die Elfe ihre Gaeste und teilt die Weisheiten des Iama.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

AddDetail( "ast",
"Der grosse und starke Ast, auf dem sich der Raum erhebt, bietet eine stabile Plattform hoch ueber dem Boden, "
"umgeben von den majestaetischen Aesten des Baumes.");

AddDetail( "baum",
"Der majestaetische Baum erstreckt seine imposanten Aeste weit ueber den Raum hinaus und verleiht dem Ort eine "
"erhabene und natuerliche Atmosphaere.");

AddDetail( "boden",
"Der Boden des Raumes besteht aus dem festen Holz des Astes, auf dem sich der Raum befindet, und bietet einen "
"sicheren Untergrund hoch oben in den Wipfeln des Baumes.");

AddDetail( "gaeste",
"Die Gaeste, die diesen Raum betreten, erleben eine beeindruckende Aussicht auf den Tethyrwald und koennen den "
"sanften Klaengen lauschen, die der Wind herbeitraegt.");

AddDetail( "geraeusche",
"Die sanften Geraeusche, die der Wind mit sich bringt, erschaffen eine zauberhafte Symphonie von Melodien, die den "
"Raum mit einer harmonischen Klangkulisse fuellen.");

AddDetail( "harmonie",
"In dieser erhabenen Umgebung verschmelzen Natur und Klang in perfekter Harmonie, und der Raum strahlt eine "
"friedliche und ausgewogene Atmosphaere aus.");

AddDetail( "himmel",
"Der Himmel erstreckt sich ueber den Tethyrwald, und von diesem erhoehten Standpunkt aus bietet sich ein beeindruckender "
"Panoramablick auf die umliegende Landschaft.");

AddDetail( "iama",
"Der Raum traegt die Aura des Iama, und die Weisheiten dieser Lehre sind hier spuerbar, waehrend die Elfe Fianna "
"Lauscht-dem-Wind ihre Gaeste empfaengt.");

AddDetail( "klang",
"Die Klangkulisse des Raumes wird von den sanften Geraeuschen des Windes bestimmt, die wie eine Melodie durch die "
"Aeste des Baumes schweben.");

AddDetail( "lauscht",
"Fianna Lauscht-dem-Wind, die Meisterin des Iama, lauscht hier den natuerlichen Klaengen und teilt ihre Weisheiten "
"mit denjenigen, die den Raum betreten.");

AddDetail( "meisterin",
"Der Raum wird von Fianna Lauscht-dem-Wind, der Meisterin des Iama, beherrscht, die hier hoch oben ihre Weisheiten "
"vermittelt.");

AddDetail( "melodien",
"Die sanften Geraeusche des Windes formen Melodien, die wie eine zauberhafte Symphonie den Raum erfuellen und eine "
"beruhigende Atmosphaere schaffen.");

AddDetail( "musik",
"Die natuerliche Musik, die der Wind mit sich bringt, fuellt den Raum mit harmonischen Klaengen, die die Umgebung "
"verzaubern.");

AddDetail( "natur",
"Die umgebende Natur, repraesentiert durch den Tethyrwald, bildet die Kulisse fuer diesen erhabenen Raum, der "
"durch den Wind belebt wird.");

AddDetail( "panoramablick",
"Von diesem erhoehten Standpunkt aus bietet sich ein atemberaubender Panoramablick auf den gesamten Tethyrwald, "
"der die Gaeste in Staunen versetzt.");

AddDetail( "raum",
"Der Raum thront hoch oben auf einem grossen Ast im majestaetischen Baum und oeffnet sich zu einem beeindruckenden "
"Panoramablick ueber den Tethyrwald.");

AddDetail( "symphonie",
"Die Kombination der sanften Geraeusche des Windes, die durch die Aeste schweben, bildet eine zauberhafte Symphonie, "
"die den Raum mit einer melodischen Atmosphaere erfuellt.");

AddDetail( "tethyrwald",
"Der gesamte Tethyrwald breitet sich vor den Augen der Gaeste aus, und der Raum bietet einen einzigartigen Blick auf "
"diese majestaetische Waldlandschaft.");

AddDetail( "umgebung",
"Die Umgebung dieses Raumes wird von der natuerlichen Pracht des Tethyrwaldes bestimmt, die den Raum mit einer "
"ruhigen und idyllischen Atmosphaere umgibt.");

AddDetail( "weisheiten",
"Die Weisheiten des Iama werden in diesem Raum von Fianna Lauscht-dem-Wind geteilt, die den Gaesten Einsicht und "
"Verstaendnis fuer die Harmonie von Natur und Klang vermittelt.");

AddDetail( "wind",
"Der Wind spielt eine zentrale Rolle in diesem Raum und traegt die sanften Geraeusche mit sich, die wie eine "
"zauberhafte Musik durch die Wipfel des Baumes klingen.");

AddDetail( "aeste",
"Die Aeste des Baumes, die sich weit ueber den Raum erstrecken, verleihen dem Ort eine natuerliche Struktur und fuegen sich "
"harmonisch in die Gesamtheit der Umgebung ein.");

AddDetail( "aesten",
"Die Aesten des Baumes bilden ein filigranes Netzwerk hoch ueber dem Boden und bieten gleichzeitig eine malerische "
"Kulisse fuer den erhabenen Raum.");

AddDetail( "atmosphaere",
"Die Atmosphaere dieses Raumes ist durch die natuerliche Harmonie von Klang und Landschaft gepraegt, wodurch eine "
"beruhigende und inspirierende Stimmung entsteht.");

AddDetail( "augen",
"Die Augen der Gaeste werden mit einem beeindruckenden Anblick beschenkt, wenn sie den Panoramablick auf den Tethyrwald "
"und die idyllische Waldlandschaft geniessen.");

AddDetail( "aura",
"Eine besondere Aura umgibt diesen Raum, getragen von der Anwesenheit von Fianna Lauscht-dem-Wind und den Lehren des Iama, "
"die hier vermittelt werden.");

AddDetail( "aussicht",
"Die Aussicht, die sich von diesem Raum aus bietet, ist von einer unvergleichlichen Schoenheit, da der Blick ueber den gesamten "
"Tethyrwald schweift.");

AddDetail( "blick",
"Der Blick von diesem Raum aus erstreckt sich ueber die Wipfel des Tethyrwaldes und ermoeglicht eine beeindruckende Perspektive "
"auf die umliegende Landschaft.");

AddDetail( "einsicht",
"In diesem Raum koennen die Gaeste Einsicht in die Schoenheit der Natur gewinnen und die harmonische Verbindung von Klang und "
"Landschaft verstehen.");

AddDetail( "holz",
"Das Holz des Astes bildet den Untergrund dieses Raumes und verleiht dem Ort eine natuerliche und warme Ausstrahlung.");

AddDetail( "klaengen",
"Die Klaenge des Windes, die durch die Wipfel der Baeume schweben, fuegen sich zu einer beeindruckenden Klangkulisse zusammen, "
"die den Raum mit Musik erfuellt.");

AddDetail( "klangkulisse",
"Die Klangkulisse dieses Raumes wird von den sanften Geraeuschen des Windes und den natuerlichen Klaengen der umgebenden Natur "
"gepraegt, die zusammen eine harmonische Melodie bilden.");

AddDetail( "kombination",
"Die Kombination von Panoramablick, harmonischer Atmosphaere und den Lehren des Iama schafft in diesem Raum eine einzigartige "
"und inspirierende Umgebung.");

AddDetail( "kulisse",
"Die Kulisse dieses Raumes wird von den Aesten, dem Holz des Astes und der umgebenden Natur gebildet, die eine malerische "
"Rahmung fuer den Raum darstellen.");

AddDetail( "landschaft",
"Die Landschaft, die sich vor den Augen der Gaeste ausbreitet, ist von einer unberuehrten Schoenheit gepraegt, waehrend der Blick "
"ueber den Tethyrwald schweift.");

AddDetail( "lehre",
"Die Lehren des Iama sind in diesem Raum spuerbar, und die Gaeste haben die Moeglichkeit, Einsicht in die Weisheiten der Natur "
"unter der Anleitung von Fianna Lauscht-dem-Wind zu gewinnen.");

AddDetail( "melodie",
"Die Melodie, die die sanften Klaenge des Windes und der Natur bilden, erfuellt den Raum mit einer zauberhaften und beruhigenden Aura.");

AddDetail( "ort",
"Dieser Raum ist mehr als nur ein physischer Ort; er ist ein spiritueller Raum, der durch die Anwesenheit von Fianna Lauscht-dem-Wind "
"und die Natur um ihn herum gepraegt ist.");

AddDetail( "plattform",
"Die Plattform des Astes bietet einen erhoehten Standpunkt, von dem aus die Gaeste einen einzigartigen Blick auf die umliegende "
"Waldlandschaft geniessen koennen.");

AddDetail( "pracht",
"Die Pracht dieses Raumes liegt in der natuerlichen Schoenheit der Landschaft, der harmonischen Klangkulisse und der spirituellen Aura, "
"die ihn umgibt.");

AddDetail( "rolle",
"Die Rolle dieses Raumes als Treffpunkt fuer Lehren des Iama und als Ort des Staunens ueber die Schoenheit der Natur wird durch "
"die Anwesenheit von Fianna Lauscht-dem-Wind deutlich.");

AddDetail( "standpunkt",
"Der erhoehte Standpunkt dieses Raumes ermoeglicht den Gaesten einen einzigartigen Blick auf die Wipfel des Tethyrwaldes und die "
"weitlaeufige Waldlandschaft.");

AddDetail( "staunen",
"Der Panoramablick und die natuerliche Schoenheit des Raumes versetzen die Gaeste in Staunen, wenn sie die Pracht des Tethyrwaldes "
"und der umgebenden Landschaft bewundern.");

AddDetail( "untergrund",
"Der Untergrund dieses Raumes, bestehend aus dem Holz des Astes, vermittelt ein Gefuehl von Naturverbundenheit und bietet gleichzeitig "
"einen sicheren Untergrund hoch oben in den Wipfeln des Baumes.");

AddDetail( "verstaendnis",
"Dieser Raum ist ein Ort des Verstaendnisses, an dem Gaeste Einsicht in die Lehren des Iama gewinnen und eine tiefere Verbundenheit mit "
"der Natur erlangen koennen.");

AddDetail( "waldlandschaft",
"Die Waldlandschaft, die sich unterhalb des Raumes erstreckt, praesentiert sich als unberuehrte Kulisse, die die Gaeste mit ihrer "
"Naturpracht beeindruckt.");

AddDetail( "wipfel",
"Die Wipfel des Tethyrwaldes erstrecken sich vor den Augen der Gaeste, und von diesem Standpunkt aus wirken sie wie eine malerische "
"Landschaft im Panoramablick.");

AddDetail( "wipfeln",
"Die Wipfeln der Baeume bilden eine beeindruckende Silhouette gegen den Himmel, und ihre sanften Bewegungen im Wind tragen zur "
"magischen Atmosphaere des Raumes bei.");

AddDetail( "anblick",
"Der Anblick, der sich den Gaesten bietet, wenn sie den Raum betreten, ist atemberaubend, da sie von der Schoenheit der "
"umliegenden Natur und des Tethyrwaldes umgeben sind.");

AddDetail( "anleitung",
"Fianna Lauscht-dem-Wind bietet in diesem Raum Anleitung und teilt die Lehren des Iama mit den Gaesten, um Einsicht und "
"Verstaendnis fuer die Natur zu foerdern.");

AddDetail( "anwesenheit",
"Die Anwesenheit von Fianna Lauscht-dem-Wind fuellt den Raum mit einer besonderen Energie und verleiht dem Ort eine spirituelle Praesenz.");

AddDetail( "ausstrahlung",
"Die Ausstrahlung dieses Raumes ist gepraegt von der Natuerlichkeit der umgebenden Landschaft und der spirituellen Aura, die durch "
"die Anwesenheit von Fianna Lauscht-dem-Wind verstaerkt wird.");

AddDetail( "baeume",
"Die Baeume des Tethyrwaldes bilden ein beeindruckendes Netzwerk von Wipfeln, das die Umgebung des Raumes mit einer natuerlichen Struktur umgibt.");

AddDetail( "bewegungen",
"Die sanften Bewegungen der Baeume im Wind schaffen eine lebendige Kulisse, die die Atmosphaere dieses Raumes mit einer beruhigenden Dynamik erfuellt.");

AddDetail( "gefuehl",
"Ein Gefuehl der Ruhe und Verbundenheit durchstroemt den Raum, wenn die Gaeste die natuerliche Schoenheit und die harmonische Klangkulisse erleben.");

AddDetail( "gesamtheit",
"Die Gesamtheit dieses Raumes, von der spirituellen Praesenz bis zur atemberaubenden Landschaft, bildet einen einzigartigen Ort des Staunens und Verstehens.");

AddDetail( "klaenge",
"Die Klaenge, die den Raum erfuellen, sind eine Sinfonie der Natur, bei der der Wind, die Voegel und die Bewegungen der Baeume zu einer harmonischen Melodie verschmelzen.");

AddDetail( "moeglichkeit",
"In diesem Raum haben die Gaeste die Moeglichkeit, sich von der Natur inspirieren zu lassen, Einsicht in die Lehren des Iama zu gewinnen und eine tiefere Verbindung zur Umwelt zu erleben.");

AddDetail( "naturpracht",
"Die Naturpracht des Tethyrwaldes, die sich in der Landschaft unterhalb des Raumes erstreckt, ist ein beeindruckender Ausdruck der unberuehrten Schoenheit der Natur.");

AddDetail( "naturverbundenheit",
"Die Naturverbundenheit dieses Raumes wird durch die Anwesenheit von Fianna Lauscht-dem-Wind und die umgebende Waldlandschaft deutlich spuerbar.");

AddDetail( "netzwerk",
"Das Netzwerk von Baeumen und Aesten, das den Raum umgibt, bildet eine natuerliche Struktur und verleiht dem Ort eine organische und harmonische Komposition.");

AddDetail( "perspektive",
"Die Perspektive, die sich den Gaesten bietet, ermoeglicht einen einzigartigen Blick auf die Natur und den Tethyrwald, der die Schoenheit der Umgebung in den Fokus rueckt.");

AddDetail( "rahmung",
"Die Baeume und Aeste bilden eine natuerliche Rahmung um den Raum, wodurch die Umgebung wie ein lebendiges Gemaelde in den Fokus gerueckt wird.");

AddDetail( "schoenheit",
"Die Schoenheit dieses Raumes liegt nicht nur in der umgebenden Naturpracht, sondern auch in der Ausstrahlung der spirituellen Energie, die den Ort durchdringt.");

AddDetail( "silhouette",
"Die Silhouette der Baeume, die sich gegen den Himmel abzeichnet, verleiht dem Raum eine zauberhafte Atmosphaere und betont die natuerliche Harmonie dieses Ortes.");

AddDetail( "stimmung",
"Die Stimmung dieses Raumes ist gepraegt von Ruhe, Frieden und der Magie der Natur, die die Gaeste in eine harmonische und inspirierende Atmosphaere eintauchen laesst.");

AddDetail( "struktur",
"Die Struktur dieses Raumes wird von der natuerlichen Anordnung der Baeume und Aeste gebildet, die eine organische und ausgewogene Komposition erschaffen.");

AddDetail( "treffpunkt",
"Als Treffpunkt fuer die Lehren des Iama und als Ort des Staunens ueber die Natur dient dieser Raum als bedeutender Treffpunkt fuer die Waldlaeufergilde.");

AddDetail( "verbindung",
"Die Verbindung zwischen der natuerlichen Umgebung, den Lehren des Iama und der spirituellen Anwesenheit von Fianna Lauscht-dem-Wind schafft eine einzigartige Atmosphaere.");

AddDetail( "verbundenheit",
"Die Verbundenheit dieses Raumes, zwischen den Gaesten, der Natur und den Lehren des Iama, bildet ein spirituelles Band, das den Raum mit einer besonderen Energie durchflutet.");

AddDetail( "verstaendnisses",
"Dieser Raum ist ein Ort des Verstaendnisses, an dem Gaeste die Natur in ihrer ganzen Pracht erleben und durch die Lehren des Iama ein tieferes Verstaendnis fuer die Welt gewinnen koennen.");

AddDetail( "anordnung",
"Die Anordnung der Baeume und Aeste, die den Raum umgeben, folgt einer natuerlichen Harmonie und vermittelt ein Gefuehl von Ausgewogenheit und Struktur.");

AddDetail( "ausdruck",
"Die Umgebung dieses Raumes ist ein ausdrucksvolles Bild der Natur, bei dem sich die Schoenheit der Landschaft in jedem Detail widerspiegelt.");

AddDetail( "band",
"Ein unsichtbares Band der Verbundenheit zieht sich durch diesen Raum, verknuepfend zwischen den Gaesten, der Natur und den Lehren des Iama.");

AddDetail( "dynamik",
"Die Dynamik dieses Raumes wird durch die lebendigen Bewegungen der Baeume im Wind und die sich veraendernde Klangkulisse geschaffen, die eine lebendige Atmosphaere erzeugt.");

AddDetail( "elfe",
"Fianna Lauscht-dem-Wind, die Elfe und Meisterin des Iama, verleiht diesem Raum ihre einzigartige Praesenz und fuellt ihn mit spiritueller Energie.");

AddDetail( "energie",
"Die Energie dieses Raumes ist spuerbar und wird durch die Anwesenheit von Fianna Lauscht-dem-Wind verstaerkt, die eine inspirierende und spirituelle Aura ausstrahlt.");

AddDetail( "fianna",
"Fianna Lauscht-dem-Wind, die Meisterin des Iama, praegt diesen Raum mit ihrer Weisheit, Anleitung und spirituellen Ausstrahlung.");

AddDetail( "fokus",
"Der Fokus dieses Raumes liegt auf der natuerlichen Umgebung, dem Panoramablick, den Klaengen der Natur und den Lehren des Iama, die eine harmonische Einheit bilden.");

AddDetail( "frieden",
"Die Atmosphaere dieses Raumes strahlt Frieden aus, und die Gaeste koennen sich inmitten der Naturpracht und Ruhe des Tethyrwaldes in einen Zustand der inneren Harmonie versetzen.");

AddDetail( "gemaede",
"Die gesamte Umgebung dieses Raumes ist wie ein lebendiges Gemaelde, in dem die Natur die Hauptdarstellerin ist und jede Szene eine harmonische Komposition bildet.");

AddDetail( "komposition",
"Die Komposition dieses Raumes wird von den natuerlichen Elementen, den Lehren des Iama und der spirituellen Anwesenheit von Fianna Lauscht-dem-Wind gepraegt.");

AddDetail( "magie",
"Eine subtile Magie liegt in der Luft dieses Raumes, die von der Natuerlichkeit und der Verbindung zur spirituellen Welt durchdrungen ist, und sie verleiht dem Ort eine zauberhafte Aura.");

AddDetail( "natuerlichkeit",
"Die Natuerlichkeit dieses Raumes ist spuerbar, von der organischen Anordnung der Baeume bis zur harmonischen Einbindung in die umgebende Waldlandschaft.");

AddDetail( "praesenz",
"Die Praesenz von Fianna Lauscht-dem-Wind, der Elfe und Meisterin des Iama, fuellt den Raum mit einer einzigartigen Ausstrahlung und spirituellen Energie.");

AddDetail( "ruhe",
"Die Ruhe, die diesen Raum durchdringt, ermoeglicht den Gaesten, sich vom Trubel der Welt zu loesen und in eine entspannte und harmonische Umgebung einzutauchen.");

AddDetail( "sinfonie",
"Die Natur dieses Raumes spielt eine Sinfonie der Elemente, bei der die Klaenge des Windes, die Anordnung der Baeume und die spirituelle Praesenz von Fianna Lauscht-dem-Wind harmonisch zusammenkommen.");

AddDetail( "umwelt",
"Die Umwelt dieses Raumes ist gepraegt von der natuerlichen Schoenheit des Tethyrwaldes, die in der harmonischen Verbindung mit dem Raum eine einzigartige Atmosphaere schafft.");

AddDetail( "verstehens",
"Dieser Raum dient als Ort des Verstehens, an dem die Gaeste durch die Lehren des Iama und die Naturpracht des Tethyrwaldes ein tiefes Verstaendnis fuer ihre Umwelt gewinnen koennen.");

AddDetail( "voegel",
"Die Voegel der Umgebung tragen zur lebendigen Klangkulisse dieses Raumes bei und fuegen sich in die natuerliche Symphonie der Natur ein.");

AddDetail( "waldlaeufergilde",
"Als Treffpunkt fuer die Waldlaeufergilde ist dieser Raum ein bedeutender Ort des Austauschs, der Lehren des Iama und der gemeinsamen Verbundenheit mit der Natur.");

AddDetail( "welt",
"Dieser Raum ist eine Verkoerperung der Welt um uns herum, in der die Elemente der Natur, die spirituelle Ausstrahlung von Fianna Lauscht-dem-Wind und die Anwesenheit der Gaeste miteinander verschmelzen.");

AddDetail( "ausgewogenheit",
"Die Ausgewogenheit dieses Raumes zeigt sich in der harmonischen Verbindung von natuerlichen Elementen, spiritueller Energie und dem Austausch zwischen Gaesten und Natur.");

AddDetail( "austauschs",
"Als Treffpunkt fuer die Waldlaeufergilde dient dieser Raum als Ort des Austauschs, der Lehren des Iama und der gemeinsamen Verbundenheit mit der Natur.");

AddDetail( "bild",
"Die gesamte Umgebung dieses Raumes formt ein beeindruckendes Bild, in dem die Natuerlichkeit der Landschaft, die spirituelle Aura und die lebendige Anwesenheit der Gaeste eine Einheit bilden.");

AddDetail( "detail",
"Jedes Detail dieses Raumes traegt zur Gesamtheit bei, sei es die Anordnung der Baeume, die Klaenge der Natur oder die Praesenz von Fianna Lauscht-dem-Wind.");

AddDetail( "einbindung",
"Die Einbindung dieses Raumes in die umgebende Natur ist nahtlos und zeigt, wie der Raum ein Teil des Tethyrwaldes ist, waehrend er gleichzeitig ein eigener, einzigartiger Ort bleibt.");

AddDetail( "einheit",
"Die Einheit dieses Raumes wird durch die gelungene Verbindung von natuerlichen Elementen, spiritueller Energie und der Anwesenheit der Gaeste geschaffen.");

AddDetail( "elemente",
"Die Elemente dieses Raumes, von den Baeumen bis zu den Klaengen der Natur, bilden eine harmonische Symbiose, die den Raum mit einer natuerlichen Schoenheit erfuellt.");

AddDetail( "elementen",
"Die Elementen dieses Raumes, von den Baeumen bis zu den Klaengen der Natur, bilden eine harmonische Symbiose, die den Raum mit einer natuerlichen Schoenheit erfuellt.");

AddDetail( "gemaede",
"Die gesamte Umgebung dieses Raumes ist wie ein lebendiges Gemaelde, in dem die Natur die Hauptdarstellerin ist und jede Szene eine harmonische Komposition bildet.");

AddDetail( "luft",
"Die Luft dieses Raumes ist erfuellt von der Frische des Tethyrwaldes und traegt dazu bei, eine belebende Atmosphaere zu schaffen, die die Gaeste mit Energie erfuellt.");

AddDetail( "trubel",
"Die Ruhe dieses Raumes steht im starken Kontrast zum Trubel der Welt draussen, und Gaeste koennen hier einen Ort der Entspannung und inneren Einkehr finden.");

AddDetail( "verkoerperung",
"Dieser Raum ist die Verkoerperung der natuerlichen Schoenheit des Tethyrwaldes, der spirituellen Weisheit des Iama und des harmonischen Zustands zwischen Mensch und Natur.");

AddDetail( "weisheit",
"Die Weisheit dieses Raumes zeigt sich nicht nur in den Lehren des Iama, sondern auch in der natuerlichen Intelligenz und Harmonie der Umgebung.");

AddDetail( "zustand",
"Der Zustand dieses Raumes ist gepraegt von Frieden, Ruhe und einer einzigartigen Atmosphaere, die den Gaesten einen Ort der inneren Einkehr und Verbundenheit bietet.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", GUILD_ROOM );

