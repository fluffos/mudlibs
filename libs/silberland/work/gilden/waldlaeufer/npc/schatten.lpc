//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit "std/player/soul"; //zum steuern
//-- Vars --------------------------------------------------------------------

//-- Prototypes --------------------------------------------------------------

//**************************************************************************//

  
  
//** Standardfunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schatten");
  SetProp(P_LONG,
    "Der Schatten ist viel zu schnell in seiner Bewegung, um ihn genauer zu "
    "fokusieren.");
  SetProp(P_NAME, "Schatten");
  SetProp(P_GENDER, MALE);
  AddId(({NOCONTROL, NOWIMPY, "schatten", SHADOW_NPC_ID, SKILL_NOLEARN, 
          "Spieler","Interactive"}));
  SetProp(P_RACE, "Untoter");
  AddClass( ({CL_NIGHTVISION }) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(10);
  SetProp(P_FRIEND, 1);
  SetProp(P_NOATTACK, "verschwimmt ploetzlich.");
  SetProp(P_HANDS, ({" mit seinen Schattenwaffen", QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})   }) );
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );

  SetProp(P_MSGIN, "huscht herein");
  SetProp(P_MSGOUT, "huscht");
  SetProp(P_MMSGIN, "huscht herein");
  SetProp(P_MMSGOUT, "verschwindet hinter Dir");
  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE,  1);
  SetProp(P_KILL_NAME, "Ein Schatten");
  AddInfo(DEFAULT_INFO, "kann Deine Sprache nicht verstehen.\n");
  AddInfo(({"lilyth", "torian", "delgo"}), "kreischt.","");
  
  add_soul_commands();

}

//-- Bleibt nur einen Reset --------------------------------------------------
void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  call_out("remove",0);
}
//**************************************************************************//



//** Raumerkundung *********************************************************//
//-- Hauptfunktion -----------------------------------------------------------
int explore(string str, object controler, object owner)
{
  string res, *doors;
  object room;
  mixed map, inv;
  mapping m;
  int i;
  
  doors=({}); inv=({});
  if(!objectp(controler) || !objectp(TO) || 
     !objectp(room=ENV(TO)) ) { return 0; }
  switch(str)
  {
    case "o":    str="osten";         break;
    case "w":    str="westen";        break;
    case "n":    str="norden";        break;
    case "s":    str="sueden";        break;
    case "no":   str="nordosten";     break;
    case "nw":   str="nordwesten";    break;
    case "so":   str="suedosten";     break;
    case "sw":   str="suedwesten";    break;
    case "swob": str="suedwestoben";  break;
    case "wob":  str="westoben";      break;
    case "nwob": str="nordwestoben";  break;
    case "nob":  str="nordoben";      break;
    case "noob": str="nordostoben";   break;
    case "oob":  str="ostoben";       break;
    case "soob": str="suedostoben";   break;
    case "sob":  str="suedoben";      break;
    case "su":   str="suedunten";     break;
    case "swu":  str="suedwestunten"; break;
    case "wu":   str="westunten";     break;
    case "nwu":  str="nordwestunten"; break;
    case "nu":   str="nordunten";     break;
    case "nou":  str="nordostunten";  break;
    case "ou":   str="ostunten";      break;
    case "sou":  str="suedostunten";  break;
    case "ob":   str="oben";          break;
    case "u":    str="unten";         break;
    default:     str=str;             break;
  }
  
  if(str == "schau" || str == "schaue")
  {
    res=room->int_long(owner, TO, 2);
    owner->Message(break_string(res, 78, 0, 1));
    return 1;
  }
  else
  {
    if( member(room->QueryProp(P_EXITS), str) )
    {
      command_me(str);
      explore("schau", controler, owner);
      return 1;
    }
    if(map=room->QueryProp(P_DOOR_INFOS))
    //P_DOOR_INFOS liefert ein array von mappings (ein mapping pro tuer, 
    //wobei key1 (mapping[1]) die richtung ist
    {
      for(i=0; i<=sizeof(map)-1; i++)
      {
        m=map[i];
        doors+=({ to_string(m[1]) });
      }
      if(member(doors, str))
      {
        command_me(str);
        explore("schau", controler, owner);
        return 1;
      }
    }    
  }
  
  return 1;
}
//**************************************************************************//



//** REACTIONS *************************************************************//
//--Reactions-----------------------------------------------------------------
void StartReaction(string verb, string gruppe, string adverb, int touch)
{ if(find_call_out("reaction") != -1) return;
  call_out("reaction", 0, TP, "laesst das nicht mit sich machen.", 
                              "ist nicht greifbar."); }

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{ return StartReaction(verb, gruppe, adverb, touch); }

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
//**************************************************************************//