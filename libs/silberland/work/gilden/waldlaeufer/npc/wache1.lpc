#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Dalvon, ein Waechter der Waldlaeufer");
  SetProp(P_LONG,
    "Die dunkle Gestalt vor Dir traegt einen etwa knoechellangen, "
    "dunklen Wollumhang, der recht abgenutzt und an den Enden ziemlich "
    "zerschlissen aussieht. Die grosse Kapuze und das schwarze Tuch "
    "um den Hals verbergen das darunter befindliche Gesicht, das Du "
    "so nur erahnen kannst. Unter dem Umhang siehst Du den schmalen Griff "
    "eines Messers hervorblitzen.");

  AddDetail( ({ "gestalt" }),
    "Eine dunkel gekleidete Gestalt steht vor Dir.");

  AddDetail( ({ "wollumhang", "umhang" }),
    "Der Umhang sieht schon ziemlich abgenutzt aus. Seine Enden sind "
    "zerschlissen und an einigen Stellen bereits eingerissen.");

  AddDetail( ({ "wolle" }),
    "Der Umhang scheint aus dicker, warmer Wolle zu bestehen.");

  AddDetail( ({ "enden" }),
    "Dort wird die Wolle am meisten beansprucht und sieht "
    "dementsprechend abgenutzt aus.");

  AddDetail( ({ "kapuze", "tuch", "halstuch" }),
    "Die Kapuze und das Halstuch verbergen das Gesicht vollstaendig.");

  AddDetail( ({ "gesicht" }),
    "Du kannst es nur erahnen.");

  AddDetail( ({ "griff" }),
    "Ein schlicht aussehender Griff ragt aus dem Umhang hervor.");

  AddDetail( ({ "messer" }),
    "Der Griff gehoert eindeutig zu einem Messer.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Dalvon");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"dalvon", "waechter", "mensch", "\nwlwache"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(24);

  SetProp(P_HANDS, ({" mit seinen blossen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 173);
  SetProp(P_WEIGHT, 78);
  SetProp(P_ALIGN, 30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" schuettelt nur den Kopf.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "uebernimmt seine Schicht");
  SetProp(P_MMSGOUT, "hat einen wichtigen Auftrag zu erledigen");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Dalvon, der Waechter der Waldlaeufer");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "ignoriert Dich voellig.\n",
            "runzelt die Stirn.\n",
            "schaut nicht einmal zu Dir herueber.\n"}));

//  AddInfo( ({""}),
//  "",
//  "sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" beobachtet Dich unverwandt.\n",
    Name(WER, 1)+" blickt sich um.\n",
    Name(WER, 1)+" betrachtet Dich aufmerksam.\n",
    Name(WER, 1)+" raeuspert sich.\n",
    Name(WER, 1)+" wirft einen Blick nach oben.\n" }));

//--Ausruestung------------------------------------------------------------

//  SUID;

//  clone_object("/p/armour/helm/kettenhaube")->move(TO);
//  clone_object("/d/kristallwald/lilyth/palast/weapon/langbogen")->move(TO);

//  command("zieh alles an");
//  command("zuecke messer");

//--Create Ende------------------------------------------------------------

}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "blickt Dich einfach nur an.",
        "blickt "+TP->name(WEN)+" einfach nur an.");
      break;

    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "legt warnend seine Hand auf sein Messer.",
        "legt warnend seine Hand auf sein Messer.");
        break;

    case "frech":
      call_out("reaction", 0, TP,
        "reagiert gar nicht auf Deine Frechheit.",
        "reagiert gar nicht auf "+TP->name(WESSEN)+" Frechheit.");
      break;

    case "albern":
    case "froh":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "brummt: Nimm die Finger da weg.",
        "brummt: Nimm die Finger da weg.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TP->name(WEN)+" gar nicht.");
      break;

    case "traurig":
    case "nett":
      call_out("reaction", 0, TP,
        "mustert Dich stumm.",
        "mustert "+TP->name(WEN)+" stumm.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

