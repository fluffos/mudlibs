#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Thurandul Duesterschatten, Zeugmeister der Waldlaeufer");
  SetProp(P_LONG,
    "Ein dunkelelfischer Waldläufer von beeindruckender Gestalt, dessen dunkle "
    "Augen die Erfahrung zahlreicher Abenteuer widerspiegeln. Seine geschickten "
    "Hände arbeiten behände mit Seilen und Werkzeugen. Ein leiser, scharfer "
    "Blick trifft dich, als er dich in seiner Werkstatt bemerkt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Thurandul Duesterschatten");
  SetProp(P_GENDER, MALE);
  AddId(({"thurandul", "duesterschatten", "dunkelelf", "zeugmeister", "Messermeister", "\nwl_zeugmeister"}));
  AddClass( ({CL_DARKELF, CL_NIGHTVISION}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     0.2, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.5,
       DT_HOLY:      0.1, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.1,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " schweigt.\n");

  AddInfo( ({"guertel","fallenguertel","auffuellen"}),
    "Jeder Waldlaeufer, der Fallen als Vorbereitung auf den Kampf errichten moechte, benoetigt "
    "die Grundmaterialien. Diese bewahren wir normalerweise in einem eigenen Guertel dafuer auf. "
    "Ich kann dir einen Fallenguertel aushaendigen oder wieder auffuellen, wenn deiner leer "
    "geworden ist.",
    "sagt: ");

  AddInfo( ({"messer", "wurfmesser"}),
    "Die Wurfmesser sind besonders fuer die Hueter am Pfad der Messer nuetzlich. Ich habe sie "
    "besonders dafuer entwickelt, dass sie gut mit dem Messerwurf geworfen werden koennen. Wenn "
    "du diese Faehigkeite anwendest und Wurfmesser dabei hast, dann wirst du zuerst diese verwenden, "
    "bevor du deine gezueckte Waffe auf den Gegner wirfst. Auch Waldlaeufer, die den Messerwurf "
    "nicht beherrschen koennen sie auf Gegner werfen. Aber natuerlich wesentlich weniger effizient.",
    "sagt: ");
  
  AddInfo( ({"ausruestung", "basisausruestung"}),
    "Die Basisausruestung ist vor allem fuer neue Waldlaeufer, oder jene die ihre gesamte "
    "Ausruestung verloren haben, gedacht. Sie besteht aus einem unserer Umhaenge, Stiefeln, "
    "einer Lederruestung, Handschuhen, einer Hose, Armschienen, einem Seil, einer Fackel, sowie "
    "einem Jagdmesser und einem Langbogen. Nichts besonderes, aber eine gute Starthilfe.", "sagt: ");

  AddInfo( ({"fallen"}),
    "Ich habe einige Fallen entwickelt, die wir Waldlaeufer vorbereiten koennen, um sie "
    "wahrend dem Kampf auszuloesen. Gute Vorbereitung erleichtert den Sieg. Dazu gehoeren "
    "die Fesselfalle, die Fangfalle, der Stolperdraht und die Pfeilfalle.", "sagt: ");

  AddInfo( ({"fesselfalle"}),
    "Die Fesselfalle ist sehr nuetzlich um Gegner kurzzeitig auszuschalten. Wenn sie "
    "ausgeloest wird, wickeln sich Seile, Ranken oder sogar ein Netz um deinen Gegner "
    "und machen ihn handlungsunfaehig bis er sich befreit hat.", "erklaert: ");

  AddInfo( ({"stolperdraht"}),
    "Der Stolperdraht bringt einen Gegner kurz zum stolpern. Oftmals faellt er dann, "
    "wie nach einem guten Fusstritt, auf den Boden und du kannst ihn dann mit einem "
    "Folgeangriff, wie dem Ausweiden, richtig zerlegen.", "erklaert: ");

  AddInfo( ({"fangfalle", "baerenfalle"}),
    "Bei der Fangfalle, auch oft als Baerenfalle bekannt, wartest du bis dein Ziel "
    "in den vorbereiteten Bereich tritt. Wenn du die Falle dann ausloest, bohren sich "
    "angespitzte Pflocke in ihn und koennen ziemlichen Schaden anrichten.", "erklaert: ");

  AddInfo( ({"pfeilfalle"}),
    "Die Pfeilfalle ist eine der fortgeschrittensten Fallen. Mit ihr praeparierst du "
    "den Kampfplatz so, dass du mehrere Pfeile auf Sehnen bereit machst, die du auf "
    "deinen Gegner schiesst, wenn du die Falle ausloest. Der Vorteil ist, dass du hier "
    "eben nicht nur einmal ausloesen kansnt, sondern oefters. Perfekt um deine Feinde "
    "in einem Pfeilhagel zu Boden zu schicken.", "sagt: ");

  AddInfo( ({"beutel", "kraeuterbeutel"}),
    "Der Kraeuterbeutel ist besonders nuetzlich, wenn du viele Pflanzen bei dir tragen "
    "willst. Darin kannst du sie besonders gut aufbewahren.", "sagt: ");

  AddInfo( ({"bandolier", "bandolier des waldlaeufers"}),
    "Das Bandolier des Waldlaeufers ist fuer all jene, die den Rang des Schuelers hinter sich "
    "gelassen haben. Es ist der ideale Begleiter in der Wildnis und bietet Platz fuer gesammelte "
    "Kraeuter, Wurfmesser und Kraeutermixturen.", "sagt: ");

  SetChats(1, ({
    "Thurandul bastelt an einer Fangfalle.\n",
    "Thurandul spannt ein paar Seile quer durch den Raum.\n",
    "Ein Waldlaeufer kommt an und holt sich neue Ausruestung bei Thurandul Duesterschatten ab.\n",
    "Thurandul Duesterschatten arbeitet an einer seiner Skizzen.\n",
    "Thurandul schleift ein paar Pfeilspitzen an.\n",
    "Du bist dir nicht sicher, aber es sieht so aus als wuerde Thurandul eine Giftmischung zubereiten.\n",
    "Thurandul schleift sein Messer nach.\n",
    "Eine Waldlaeuferin kommt an.\nThurandul gibt ihr einen neuen Kraeuterbeutel.\n",
    "Thurandul Duesterschatten fragt dich: Benoetigst du etwas bestimmtes?\n",
    "Thurandul Duesterschatten tueftelt an einer neuen Erfindung.\n",
    "Thurandul fertigt einen weiteren Koecher mit Spezialpfeilen an.\n"
  }));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

  AddSpell(3, 450,
    Name(WER) + " laeuft auf Dich zu, springt ab und stoesst zu.\n",
    Name(WER) + " laeuft auf @WEN zu, springt ab und stoesst zu.\n", 
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(2, 250, DS_PARALYZE,
      Name(WER) + " tritt Dich kraeftig.\n",
      Name(WER) + " tritt @WEN kraeftig.\n", 
      DT_SQUEEZE, 1);

  AddDefaultSpell(1, 600, DS_MASS_DAMAGE,
    Name(WER)+" laesst seine Klingen wirbeln und trifft alle um sich.\n",
    Name(WER)+" laesst seine Klingen wirbeln und trifft alle um sich.\n", DT_SLASH);
  
  AddSpell(1, 800,
    Name(WER)+" rammt dir seinen Dolch in den Bauch und weidet dich aus.\n",
    Name(WER)+" rammt @WEM seinen Dolch in den Bauch und schneidet ihn auf.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE: 1]), "ausweiden");

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/knife/langdolch" );
  command("zuecke dolch");

  CLONEME(ARMOUR "umhang" );
  command("trage alles");
}

public void ausweiden(object enemy) {
  enemy->SetProp(P_RANGER_EVISCERATED_UNTIL, time()+10);

  call_other("/spellbooks/waldlaeufer_spells", "eviscerate_bleed", enemy, 50, TO);
  return;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {  
  if(!random(20)) {
    tell_room(ENV(TO), BS(Name(WER) + " weicht geschickt aus."));
    return 0;
  }

  if(QuerySkillAttribute(SA_SPEED) < 200 && !random(3)) {
    tell_room(ENV(TO), BS("Thurandul spannt seine Muskeln an und bewegt sich schneller!"));
    ModifySkillAttribute(TO, SA_SPEED, 200+random(150), random(10));
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}