//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit "std/player/soul"; //zum steuern

#define OFF 0
#define NPC_WAIT 1
//-- Vars --------------------------------------------------------------------
object owner;
int service, ec; //ec -> exploartion-counter
int mode;
string npc, rasse;
//-- Prototypes --------------------------------------------------------------

//**************************************************************************//

  
  
//** Standardfunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_FRIEND, 1);
  SetProp(P_NOATTACK, "schaut Dich fragend an.");
  SetProp(P_NO_GLOBAL_ATTACK, 1); 
  SetProp(P_RACE, "Tiere");
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOCORPSE,  1);
  SetProp(P_KILL_NAME, "Ein Betrueger");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  AddInfo(DEFAULT_INFO, "kann Deine Sprache nicht verstehen.\n");
  AddId(({NOCONTROL, NOWIMPY, FELL_WUSCHEL, ANIMAL_ID , SKILL_NOLEARN}));
  AddClass( ({CL_ANIMAL }) ); 

  create_default_npc(10);
  enable_commands();
  
  ec=5;
  mode = OFF;
  add_soul_commands();
  SUID;
}

//-- Remove ------------------------------------------------------------------
int remove()
{
  if(objectp(TO) && objectp(owner))
  { //owner->SetProp(P_RANGER_LAST_ANIMAL, time());
    owner->RemovePursuer(TO); }
  return ::remove();
}

//-- Normaler Tod ------------------------------------------------------------
void die(int poisondeath)
{ //if(owner) owner->SetProp(P_RANGER_LAST_ANIMAL, time());
  ::die(poisondeath); }
 
//-- Nur einen Reset da ------------------------------------------------------
void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  call_out("remove",0);
}

//-- Verschwindet beim Spielertod --------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ if(objectp(owner) && (player == owner)) { call_out("remove", 0); } }

//**************************************************************************//



//** Anpassung *************************************************************//
//-- Hauptfunktion -----------------------------------------------------------
int customize(object caster, string r)
{ //man koennte auch hier auswuerfeln, aber so kann man zum testen waehlen
  owner=caster;
  owner->AddPursuer(TO);
  
  if(!objectp(TO)) { return 0; }
  switch(r)
  {
    case "fledermaus":
      SetProp(P_SHORT, "Eine Fledermaus");
      SetProp(P_LONG,
        "Der schwarze Schatten der wild umherflattert, ist eine Kreatur aus "
        "dem fernen Wald von Tethyr. Die Fledermaus ist klein und "
        "unauffaellig, sie ist sicher ein ausgezeichneter Spion.");
      SetProp(P_NAME, "Fledermaus");
      SetProp(P_GENDER, FEMALE);
      SetProp(P_HANDS, ({" mit ihren Krallen", QueryProp(P_HANDS)[1],
                       ({DT_BLUDGEON})   }) );
      SetProp(P_SIZE, 70);
      SetProp(P_WEIGHT, 16000);
      SetProp(P_ALIGN, -1000);
      SetProp(P_MSGIN, "flattert herein");
      SetProp(P_MSGOUT, "flattert");
      SetProp(P_MMSGIN, "flattert heran");
      SetProp(P_MMSGOUT, "erhebt sich in die Luefte");
      SetProp(P_DIE_MSG,  " flattert davon.\n");
      
      SetChats(10, ({
        Name(WER, 1)+" kreischt.\n",
        Name(WER, 1)+" flattert wild im Kreis herum.\n", }) );
      
      AddClass( ({CL_FLYING }) );
    break;
    
    case "eichhoernchen":
      SetProp(P_SHORT, "Ein Eichhoernchen");
      SetProp(P_LONG,
        "Das kleine flinke Eichhoernchen aus dem fernen Tethyr hat "
        "rotbraunes Fell und einen langen buschigen Schwanz. Es bewegt sich "
        "die ganze Zeit, sodass Du es nicht richtig untersuchen kannst.");
      SetProp(P_NAME, "Eichhoernchen");
      SetProp(P_GENDER, NEUTER);
      SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1],
                       ({DT_BLUDGEON})   }) );
      SetProp(P_SIZE, 75);
      SetProp(P_WEIGHT, 18000);
      SetProp(P_ALIGN, 1000);
      SetProp(P_MSGIN, "springt herein");
      SetProp(P_MSGOUT, "springt");
      SetProp(P_MMSGIN, "springt herein");
      SetProp(P_MMSGOUT, "springt geschickt aus Deiner Reichweite");
      SetProp(P_DIE_MSG,  " springt davon.\n");
      
      SetChats(10, ({
        Name(WER, 1)+" schaut sich nervoes um.\n",
        Name(WER, 1)+" stellt sich kurz auf.\n", }) );
    break;
    
    case "hase":
      SetProp(P_SHORT, "Ein Hase");
      SetProp(P_LONG,
        "Der kleine braune Waldhase kommt aus dem Wald von Tethyr. Er blickt "
        "Dich aus seinen suessen grossen braunen Augen an. Wird da ein "
        "Abenteurer weich?");
      SetProp(P_NAME, "Hase");
      SetProp(P_GENDER, MALE);
      SetProp(P_HANDS, ({" mit seinen Pfoten", QueryProp(P_HANDS)[1],
                       ({DT_BLUDGEON})   }) );
      SetProp(P_SIZE, 100);
      SetProp(P_WEIGHT, 20000);
      SetProp(P_ALIGN, 500);
      SetProp(P_MSGIN, "hoppelt herein");
      SetProp(P_MSGOUT, "hoppelt");
      SetProp(P_MMSGIN, "hoppelt herein");
      SetProp(P_MMSGOUT, "hoppelt davon");
      SetProp(P_DIE_MSG,  " schlaegt Haken und verschwindet.\n");
      
      SetChats(10, ({
        Name(WER, 1)+" hoppelt im Kreis.\n",
        Name(WER, 1)+" kuschelt sich an Dich an.\n", }) );
    break;
    
    case "falke":
      SetProp(P_SHORT, "Ein Falke");
      SetProp(P_LONG,
        "Der Falke beobachtet Dich aufmerksam. Du weisst nicht woher er "
        "kommt aber gefaerlich sieht er nicht aus. Er macht eher einen "
        "friedlichen Eindruck.");
      SetProp(P_NAME, "Falke");
      SetProp(P_GENDER, MALE);
      SetProp(P_NOATTACK, "schaut Dich fragend an.");
      SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1],
                       ({DT_BLUDGEON})   }) );
      SetProp(P_SIZE, 80);
      SetProp(P_WEIGHT, 8000);
      SetProp(P_ALIGN, 300);
      SetProp(P_MSGIN, "fliegt herein");
      SetProp(P_MSGOUT, "fliegt");
      SetProp(P_MMSGIN, "landet hier");
      SetProp(P_MMSGOUT, "erhebt sich in die Luefte");
      SetProp(P_DIE_MSG,  " faellt tot um.\n");
      
      SetChats(10, ({
        Name(WER, 1)+" segelt ueber Deinen Kopf hinweg.\n",
        Name(WER, 1)+" schlaegt mit den Fluegeln.\n", }) );
      RemoveId( ({FELL_WUSCHEL}) );
      AddId( ({FEDERN_WUSCHEL}) );
      AddClass( ({CL_FLYING }) );
    break;
    
    case "fuchs":
      SetProp(P_SHORT, "Ein Fuchs");
      SetProp(P_LONG,
        "Die blaubraune Faerbung des Fells ist ein eindeutiges "
        "Erkennungsmerkmal fuer den gemeinen Tethyrfuchs. Die spitzen Ohren "
        "vernehmen alle Graeusche im Umkreis und die wachen Augen schliessen "
        "die perfekte Ueberwachung ab.");
      SetProp(P_NAME, "Fuchs");
      SetProp(P_GENDER, MALE);   
      SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1],
                       ({DT_BLUDGEON})   }) );
      SetProp(P_SIZE, 130);
      SetProp(P_WEIGHT, 25000);
      SetProp(P_ALIGN, -500);
      SetProp(P_MSGIN, "schleicht herein");
      SetProp(P_MSGOUT, "schleicht");
      SetProp(P_MMSGIN, "schleicht herein");
      SetProp(P_MMSGOUT, "schleicht davon");
      SetProp(P_DIE_MSG,  " schleicht davon.\n");
      
      SetChats(10, ({
        Name(WER, 1)+" lauert am Boden.\n",
        Name(WER, 1)+" sucht seine Beute.\n", }) );
    break;
    
    default: //wiesel
      SetProp(P_SHORT, "Ein Wiesel");
      SetProp(P_LONG,
        "Das Wiesel ist ein kleines und sehr bewegliches Tier aus dem Wald "
        "von Tethyr. Es kann unbemerkt umherschleichen und sogar einige "
        "Tricks von Menschen lernen.");
      SetProp(P_NAME, "Wiesel");
      SetProp(P_GENDER, NEUTER);
      SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1],
                       ({DT_BLUDGEON})   }) );
      SetProp(P_SIZE, 80);
      SetProp(P_WEIGHT, 20000);
      SetProp(P_ALIGN, -100);
      SetProp(P_MSGIN, "wieselt herein");
      SetProp(P_MSGOUT, "wieselt");
      SetProp(P_MMSGIN, "wieselt herein");
      SetProp(P_MMSGOUT, "wieselt davon");
      SetProp(P_DIE_MSG,  " wieselt davon.\n");
      
      SetChats(10, ({
        Name(WER, 1)+" wuselt am Boden herum.\n",
        Name(WER, 1)+" verwieselt sich.\n", }) );
    break;
  }
  rasse=lower_case(to_string(QueryProp(P_NAME)));
  AddId( ({lower_case(to_string(QueryProp(P_NAME)))}) );
  SetProp( P_REJECT, ({ REJECT_DROP, Name(WER,1)+" kann sowas nicht.\n" }) );
  return 1;
}
//**************************************************************************//



//** Komunikation **********************************************************//
//-- Die Kommandos auffangen -------------------------------------------------
void catch_tell(string str)
{
  string who,target,action;
  
  if(!((query_verb() == "sag") /*|| (query_verb()[0..0] == "'")*/))return;
                              //buggt. 
  if(sscanf(str,"%s sagt: %s %s",who,target,action) != 3)      return;
  if(!id(target))                                              return;
  if(find_player(lower_case(who)) != owner)                    return;
  if(action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);
  call_out("order",0,action);
  return;
}

//-- Befehle auswerten -------------------------------------------------------
int order(string action)
{
  object ob;
  string *s, *po, *pp;
  int i, *t;
  mixed env;
  
  if(!objectp(TO) || !objectp(env=ENV(TO)) || !objectp(owner)) { return 0; }
  //Standard Befehle -------------------------------------
  if(action == "verschwinde"  ||
     action == "hau ab"       ||
     action == "verzieh dich" ||
     action == "geh")
  { tell_room(env, BS(Name(WER, 1)+" "+QueryProp(P_MMSGOUT)+".") );
    call_out("remove", 0);
    return 1;}
  
  //Jagen/Sammeln ----------------------------------------
  if( action == "bring mir nahrung"  
      || ((action == "sammel beeren")   && (rasse == "wiesel"))
      || ((action == "sammel kraeuter") && (rasse == "hase"))
      || ((action == "sammel nuesse" )  && (rasse == "eichhoernchen"))
      || ((action == "jage fleisch" )   && (rasse == "fuchs"))
      || ((action == "jage" )           && (rasse == "fuchs"))
      || ( ((action == "sammel") || (action == "sammele")) && 
           ((rasse=="wiesel") || (rasse=="hase") || (rasse=="eichhoernchen")))
    )
  { if( member( ({"hase","fuchs","wiesel","eichhoernchen"}), rasse) == -1 )
    {return 1;}
    //man soll 3 mal innerhalb einer halben stunde jagen/sammeln koennen
    //ergo werden in einer propertie 3 jagdzeiten gespeichert und immer die
    //erste nicht abgelaufene zeit ersetzt
    if(!pointerp(owner->QueryProp(P_RANGER_LAST_HUNT)))
    {owner->SetProp(P_RANGER_LAST_HUNT, ({time()-1,time()+1,time()+2}) );}
    t=owner->QueryProp(P_RANGER_LAST_HUNT);
    for(i=0;i<=sizeof(t)-1;i++)
    {
      if(t[i]<=time())
      { call_out("hunting", 6);
        tell_object(owner, BS(Name(WER, 1)+" wird jetzt fuer Dich nach "
                           "Essbarem suchen."));
        move(ROOM "air", M_TPORT); 
        t[i]=(time()+1800); //DBD(to_string(t)+":"+to_string(t[i]));
        owner->SetProp(P_RANGER_LAST_HUNT, t );
        return 1;}
    }
    tell_object(owner, BS("Deine Tiere koennen noch nichts Essbares "
                       "finden. Probiere es spaeter wieder."));
    return 1;
  }  
  
  //Erkunden ---------------------------------------------
  if(action == "erkunde"            ||
     action == "beobachte umgebung" ||
     action == "erkunde umgebung")
  { if( member( ({"fuchs","wiesel","falke"}), rasse) == -1 )
    {return 1;}
    ob=clone_object(OBJ "animal_control");
    if(!ob) {owner->Message(BS("Ein Fehler ist aufgetreten. Wende Dich an "
                               "einen Gildenmagier.")); return 1;}
    ob->move(owner, M_GET | M_SILENT);
    ob->get_control(TO);
    owner->Message(BS("Du kniest nieder und versuchst mit Deinem Geist in die"
                      " Gedanken "+name(WESSEN, 1)+" einzudringen."));
    return 1;}

  s=explode(action, " ");
  for(i=0;i<=sizeof(s)-1;i++)
  {s[i]=lower_case(s[i]);}
  //Lokalisieren -----------------------------------------
  if(s[0] == "finde"       ||
     s[0] == "lokalisiere" ||
     s[0] == "suche")
  {
    if( member( ({"fledermaus","falke"}), rasse) == -1 )
    {return 1;}
    if(sizeof(s)<2)
    { owner->Message(BS("Wen soll "+name(WER, 1)+" suchen?")); 
      return 1;}
    tell_room(env, BS(owner->Name(WER,1)+" gibt "+name(WEM, 1)+" ein "
                          "Zeichen und "+QueryPronoun()+" "
                          +QueryProp(P_MSGOUT)+" davon.")
                          , ({owner}) );
    owner->Message(BS("Du gibst "+name(WEM, 1)+" ein Zeichen und "
                      +QueryPronoun()+" "+QueryProp(P_MSGOUT)+" davon."));
    move(ROOM "air", M_GO | M_SILENT);
    ob=find_living(s[1]);
    if(!ob) {call_out("location", 4, ob, s[1], 0); return 1;}
    else if(ob->QueryProp(P_INVIS)) 
    {call_out("location", 4, ob, s[1], 0); return 1;}
    else if(ob->QueryProp(P_PALADIN_NO_LOCATION))
    { call_out("location", 4, ob, s[1], 1); return 1; }
    else
    {
      i=10; //Zeit
      po=explode(file_name(ENV(ob)), "/");
      pp=explode(file_name(ENV(owner)), "/");
      if( po[1] == pp[1] )  { i-=2; } //selbe Region
      if( po[1] == "luft" ) { i-=2; } //Region Luft findets natuerlich eher
      if( ob->QueryProp(P_SIZE) > 499 ) { i-=2; } //Riesige erkennts frueher
      call_out("location", i, ob, s[1], 2);
    }
    return 1;    
  }
 
  //NPC-erwarten -----------------------------------------
  if(s[0] == "erwarte")
  {  
    if( member( ({"fledermaus","eichhoernchen","hase"}), rasse) == -1 )
    {return 1;}
    if(sizeof(s)<=1)
    {owner->Message(BS("Wen soll "+name(WER, 1)+" erwarten?")); return 1;}
    s[1]=lower_case(s[1]);
    tell_room(env, BS(owner->Name(WER,1)+" gibt "+name(WEM, 1)+" ein "
                          "Zeichen und "+QueryPronoun()+" zieht sich "
                          "zurueck in den Hintergrund.")
                          , ({owner}) );
    owner->Message(BS("Du gibst "+name(WEM, 1)+" ein Zeichen, "
                      +QueryPronoun()+" solle hier auf '"+CAP(s[1])+"' "
                      "warten."));
    owner->RemovePursuer(TO); npc=s[1];
    mode=NPC_WAIT;
    return 1;    
  }
  return 1;

}
//**************************************************************************//



//** Die Dienste ***********************************************************//
//-- Jagen -------------------------------------------------------------------
int hunting()
{
  int i, k;
  object *food, ob;
  mapping m;
  mixed env;
  
  if(!objectp(TO) || !objectp(owner) || !objectp(env=ENV(owner)) ) {return 0;}
  food=({});
  if(!rasse) 
  { tell_object(owner, BS("Es ist ein Fehler aufgetreten. Verstaendige einen "
                          "Gildenmagier(hunting/rasse)")); 
    call_out("remove", 0);
    return 0;}
  switch(rasse)
  {
    case "hase":
      i=7000;
      if( mappingp(m=owner->QueryProp(P_NEWSKILLS)[SK_RANGER_HERBALISM]) )
      {i=m[SI_SKILLABILITY];}
      HERBS_MASTER->DistributeHerbs(4,2,7000,owner);
    break;
    
    case "fuchs":
      for(i=0; i<5; i++)
      { k=1+random(8);
        switch(k)
        { case 7..8: break;
          default: 
            if(k<1) {k=1;} if(k>6) {k=6;}
            ob=clone_object(FOOD"food");
            ob->customize(FLEISCH);
            food+=({ ob });
          break; } }       
    break;
    
    case "eichhoernchen":
      for(i=0; i<5; i++)
      { k=1+random(8);
        switch(k)
        { case 7..8: break;
          default: 
            if(k<1) {k=1;} if(k>6) {k=6;}
            ob=clone_object(FOOD"food");
            ob->customize(NUSS);
            food+=({ ob });
          break; } }      
    break;
    
    case "wiesel":
      for(i=0; i<5; i++)
      { k=1+random(8);
        switch(k)
        { case 7..8: break;
          default: 
            if(k<1) {k=1;} if(k>6) {k=6;}
            ob=clone_object(FOOD"food");
            ob->customize(BEERE);
            food+=({ ob });
          break; } }
    break;
  }
  move(file_name(env), M_TPORT);
  tell_object(owner, BS(Name(WER, 1)+" hinterlaesst Dir einen Teil "
                     +QueryPossPronoun(FEMALE,1,0)+" Beute."));
  if(!(rasse=="hase"))
  { for(i=0; i<=sizeof(food)-1; i++)
    { food[i]->move(owner, M_GET); } }
  call_out("remove", 1);
  return 1;  
}

//-- Raumerkundung -----------------------------------------------------------
int explore(string str, object controler)
{
  string res, *doors;
  object room;
  mixed map, inv;
  mapping m;
  int i;
  
  if(!objectp(TO) || !objectp(room=ENV(TO)) || !objectp(owner)) { return 0; }
  doors=({}); inv=({});

  switch(str)
  {
    case "o":    str="osten";         break;
    case "w":    str="westen";        break;
    case "n":    str="norden";        break;
    case "s":    str="sueden";        break;
    case "no":   str="nordosten";     break;
    case "nw":   str="nordwesten";    break;
    case "so":   str="suedosten";     break;
    case "sw":   str="suedwesten";    break;
    case "swob": str="suedwestoben";  break;
    case "wob":  str="westoben";      break;
    case "nwob": str="nordwestoben";  break;
    case "nob":  str="nordoben";      break;
    case "noob": str="nordostoben";   break;
    case "oob":  str="ostoben";       break;
    case "soob": str="suedostoben";   break;
    case "sob":  str="suedoben";      break;
    case "su":   str="suedunten";     break;
    case "swu":  str="suedwestunten"; break;
    case "wu":   str="westunten";     break;
    case "nwu":  str="nordwestunten"; break;
    case "nu":   str="nordunten";     break;
    case "nou":  str="nordostunten";  break;
    case "ou":   str="ostunten";      break;
    case "sou":  str="suedostunten";  break;
    case "ob":   str="oben";          break;
    case "u":    str="unten";         break;
    default: str=str; break;      
  }
  
  if(ec<1)
  { call_other(controler, "remove", 0); return 1;}
  
  if(str == "schau" || str == "schaue")
  { res=room->int_long(owner, TO, 2);
    owner->Message(break_string("Du siehst Durch die Augen "+name(WESSEN, 1)+
                                ":\n"+res, 78, 0, 1));
    return 1;}
  else
  { if( member(room->QueryProp(P_EXITS), str) )
    {
      command_me(str);
      explore("schau", controler);
      ec--;
      if(ec<1)
      { call_other(controler, "remove", 0); return 1;}      
      return 1;
    }
    if(map=room->QueryProp(P_DOOR_INFOS))
    //P_DOOR_INFOS liefert ein array von mappings (ein mapping pro tuer, 
    //wobei key1 (mapping[1]) die richtung ist
    {
      for(i=0; i<=sizeof(map)-1; i++)
      { m=map[i]; 
        doors+=({ to_string(m[1]) }); }
      if(member(doors, str))
      {
        command_me(str);
        explore("schau", controler);
        ec--;
        if(ec<1)
        { call_other(controler, "remove", 0); return 1;}        
        return 1;
      }
    }    
  }
  return 1;
}

//-- NPC-Erwarten ------------------------------------------------------------
void init()
{
  mixed env;
  
  ::init();
  
  if(!objectp(TP) || !objectp(owner) || !objectp(env=ENV(owner)) ) {return;}  
  if(mode==NPC_WAIT)
  { 
    if( TP->id(npc) || lower_case(TP->QueryProp(P_NAME)) == npc)
    {
      if(owner)
      {
        tell_room(env, BS(Name(WER, 1)+" "+QueryProp(P_MSGOUT)+ 
                              " herein und stupst "+owner->name(WEN,1)+" kurz"
                              " an. Danach verschwindet "+name(WER, 1)+
                              " wieder."), ({owner}) );
        owner->Message(BS(Name(WER, 1)+" "+QueryProp(P_MSGOUT)+" herein und "
                          "stupst Dich kurz an. Scheinbar ist '"+CAP(npc)+"' "
                          "jetzt da."));
        call_out("remove", 1);
      }
    }    
  }
}

//-- Lokation ----------------------------------------------------------------
int location(object ob, string namen, int flag)
{
  string res;
  mixed env;
  
  //Flags:
  //0 - invis, nichtvorhanden
  //1 - lokations-schutz (cain usw.)
  //2 - okay
  
  if(!objectp(TO) || !objectp(owner) || !objectp(ob) || 
     !objectp(env=ENV(ob)) ) {return 0;}
  
  if(flag == 0)
  { owner->Message(BS(CAP(namen)+" konnte nicht gefunden werden.")); }
  else if(flag == 1)
  { owner->Message(BS(CAP(namen)+" ist untergetaucht und laesst sich "
                      "nicht finden.")); }
  else
  {
    move(file_name(env), M_GO | M_SILENT);
    tell_room(env, BS(Name(WER, 0)+" fliegt kurz herein, beobachtet die "
                        "Umgebung und verschwindet wieder."));
    res=env->int_long(owner, TO, 2);
    owner->Message(break_string("Ein Schmerz zuckt durch Deinen Kopf und kurz"
                                " siehst Du durch die Augen "+name(WESSEN, 1)+
                                " ein klares Bild:\n"+res, 78, 0, 1));
  }
  call_out("remove",1);
  return 1;
}
//**************************************************************************//



//** REACTIONS *************************************************************//
//--Reactions-----------------------------------------------------------------
void StartReaction(string verb, string gruppe, string adverb, int touch)
{ if(find_call_out("reaction") != -1) return;
  call_out("reaction", 0, TP, "schreckt zurueck.", "schreckt zurueck."); }

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
//**************************************************************************//