//** KampfFunktionen/Spells ************************************************//
//--Welche spezielle Eigenschaft hat das Tier? (Kraft des Tieres)-------------
int SwitchBonus(int faktor)
{
  string c, s;
  mapping m;
  int i, skill, t, k, n, v;
  object bonus;
  
/*Rasse       Eigenschaft
  wolf:       Staerke, Geschick
  katze:      Geschick
  baer:       Staerkebonus, Ausdauer
  riese:      Staerkebonus
  vogel:      Ausdauerbonus
  spinne:     Intelligenz
  panzertier: Body
  huftier:    Ausdauerbonus
  echse:      Geschick, Body
  kleintier:  Geschick
*/
  
  if(!objectp(owner) || !objectp(TO) ) { return 0; }
  c=QueryProp(P_RANGER_PET_RACE);
  skill=R_SKILLMASTER->HasSkill(getuid(owner), GEWALT_DER_URAHNEN);
  if(faktor<1) faktor=1;
  if(faktor>(5+5*skill)) faktor=(5+5*skill);
  
  if(QueryBiest()) i=2;
  else {i=1;}

  m=(["wolf":      "Aehnlich einem Wolf, attackierst Du Deine Feinde.";
                   ({DEX, STR}),
      "katze":     "Mit unendlicher Geschmeidigkeit fuehrst Du Deinen Kampf.";
                   ({DEX}),
      "baer":      "Du erhaelst die Kraft und das Durchhaltevermoegen eines Baeren.";
                   ({STR, CON}),
      "riese":     "Deine Muskeln wachsen enorm an und Du wirst Deine Feinde "
                   "zerschmettern.";
                   ({STR}),
      "vogel":     "Die Schwerelosigkeit erfasst Dich und Du bewegst Dich mit"
                   " leichten Bewegungen fort.";
                   ({CON}),
      "spinne":    "Deine Sinne flackern kurz und die Gerissenheit der Spinne erfuellt dich.";
                   ({INT}),
      "panzertier":"Du fuehlst wie Deine Haut haerter wird.";
                   ({BODY}),
      "huftier":   "Endlose Landstriche ziehen an Deinem geistigen Auge "
                   "vorbei und Du spuerst wie Du ohne Muehe ganze Berge "
                   "erklimmen koenntest.";
                   ({CON}),
      "echse":     "Du siehst Dich mit einem Schuppenkleid geschichkt durch die Reihen der Feinde "
                   "schlaengeln.";
                   ({DEX, BODY}),
      "kleintier": "Deine Bewegungen werden schneller und geschickter.";
                   ({DEX}),
      "insekt":    "Wie das Surren tausender Fluegel rasen deine Gedanken und deine Haut wird zu hartem "
                   "Chitin";
                   ({INT,BODY})]);
  
  s=BS(to_string("Du spuerst auf einmal eine geistige Verbindung zu "+P(WEM)+
                 ". "+m[c, 0]));

  n = sizeof(m[c, 1]);
  for(k=0; k<n; k++) {
    switch(m[c, 1][k])
    {
      case SPEED: 
        v = limit(200*i/n, 200, 400);
        v = SPELL_DAMAGE_BONUS(owner, "kraft des tieres", v);
        owner->ModifySkillAttribute(owner, SA_SPEED, v, SPELL_DAMAGE_BONUS(owner, "kraft des tieres", faktor*2)); 
        t=faktor*20;
        pDebug(owner, sprintf("kraft_des_tieres :: speed=%d t=%d\n", v, t));
      break;
      case DEX:
      case CON:
      case STR:
      case INT:
        v = limit((i*faktor/2)+random(1+i)/n, 1, 10);
        v = SPELL_DAMAGE_BONUS(owner, "kraft des tieres", v);
        bonus=clone_object(OBJ"bonus");
        bonus->move(owner, M_SILENT);
        bonus->SetBonus(m[c, 1][k],v,60*faktor);
        t=60*faktor;
        pDebug(owner, sprintf("kraft_des_tieres :: %s=%d t=%d\n", m[c, 1][k], v, t));
        break;
      case BODY:
        v = limit((faktor*(i+1)+random(faktor))/n, 1, 100);
        v = SPELL_DAMAGE_BONUS(owner, "kraft des tieres", v);
        bonus=clone_object(ARMOUR"invis_armour");
        bonus->SetProp(P_SHORT, "Kraft des Tieres");
        bonus->move(owner, M_SILENT);
        bonus->SetBonus( ({DT_SLASH, DT_BLUDGEON, DT_PIERCE, DT_SQUEEZE, DT_WHIP, DT_RIP}) , v, 30*faktor);
        t=30*faktor;
        pDebug(owner, sprintf("kraft_des_tieres :: body=%d t=%d\n", v, t));
        break;
    }
  }
  tell_object(owner, s);  
  return t;
}

//--Setzt auf den TEAM-Modus (Kampfgeist)-------------------------------------
int SetTeam(int duration, int ability, int success)
{
  duration=limit(duration,1,10);
  teamtime=time()+duration*30;
  teampower = ability/1000 + success/1000;
  return 1;
}

//--beendet den TeamModus (testzwecke)----------------------------------------
int UndoTeam()
{ teamtime=0; return 1; }

//--Schon im TEAM-Modus?------------------------------------------------------
int QueryTeam() 
{ 
  if((teamtime)>=time()) return 1; 
  return 0; 
}

//--Kaempft das Tier mit?-----------------------------------------------------
int QueryFight() 
{ 
  if(mode==MOD_ATTACK) return 1; 
  return 0; 
}

//--Erweckt das Biest im Pet (Kraft der Ahnen)--------------------------------
int SetBiest(int faktor)
{
  int old_level, level;
  string *msg;
  
  if(!objectp(owner) || !objectp(TO) ) { return 0; }
  if(QueryBiest()) return 0;
  faktor=limit(faktor,1,15);
  
  old_level=QueryProp(P_LEVEL);
  SetProp(P_LEVEL, faktor+QueryProp(P_LEVEL));
  level=QueryProp(P_LEVEL);
  
  SetProp(P_ATTRIBUTES, ([A_CON: level, A_DEX: level,
                          A_STR: level, A_INT: level]));  
  SetProp(P_MAX_HP, 30+level*level);
  SetProp(P_MAX_SP, QueryProp(P_MAX_HP));
  SetProp(P_HANDS, ({QueryProp(P_HANDS)[0],
                    hand_damage(level), QueryProp(P_HANDS)[2] }) );
  
  call_out("ReBiest", 60*faktor, old_level);
  fightmode=BIEST;
  return 1;
}

//--ReBiest verwandelt das Tier zurueck---------------------------------------
int ReBiest(int level)
{
  if(level>30) { level=30; }
  SetProp(P_LEVEL, level);
  SetProp(P_ATTRIBUTES, ([A_CON: level, A_DEX: level,
                          A_STR: level, A_INT: level]));  
  SetProp(P_MAX_HP, 30+level*level);
  SetProp(P_MAX_SP, QueryProp(P_MAX_HP));
  SetProp(P_HANDS, ({QueryProp(P_HANDS)[0],
                    hand_damage(level), QueryProp(P_HANDS)[2] }) );
  fightmode=NORMAL;
  if(owner) { tell_object(owner, BS(Name(WER, 1)+" wird wieder normal.")); }
  beastReady = 0;
  set_next_reset(600 + random(600));
  return 1;  
}

//--Schon im BIEST-Modus?-----------------------------------------------------
int QueryBiest() 
{ 
  if(fightmode==BIEST) { return 1; }
  return 0; 
}

public int QueryBiestReady() {
  return beastReady;
}

//--Mit welcher Kraft greift das Tier an? (Gemeinsame Attacke)----------------
int QueryStrength(int i)
{
  int damage, baseDamage;
  i=limit(i,1,5);
  baseDamage = QueryProp(P_HANDS)[1];
  damage =  baseDamage + random(i*baseDamage/10) + 10*QueryAttribute(A_STR)/3;
  pDebug(owner, sprintf("pet :: QueryStrength :: hands=%d str=%d i=%d damage=%d\n",
                        baseDamage, QueryAttribute(A_STR), i, damage));
  return damage;
}

//--Verteidigung des Owners---------------------------------------------------
mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{ 
  string c, *dts, msg;
  int i, t, bufferedDamage;
  mixed env;
  float reduction;
  
  if(!objectp(owner) || !objectp(TO) || !objectp(env=ENV(TO)) ) { 
    return ({dam, dam_type, spell}); 
  }
  
  c=QueryProp(P_RANGER_PET_RACE);
  dts = m_indices(PHYSICAL_DAMAGE_TYPES); // wir fangen grundsaetzlich nur physische angriffe ab
  
  if(QueryTeam() && QueryProp(P_RANGER_LAST_PET_DEFENCE)+2<=time() && !random(15-teampower)) {
    t = 0;
    if(pointerp(dam_type)) {
      for(i=0; i<sizeof(dam_type); ++i) {
        if(member(dts, dam_type[i]) >= 0) {
          t++;
        }
      }
    } else if(member(dts, dam_type) >= 0) {
      t = 1;
    }

    if(t<=0) return ({dam, dam_type, spell}); // kein schaden den wir abfangen koennen

    reduction = (teampower + random(QueryProp(P_LEVEL))) / 100.0; // bis zu 20% fixe schadenreduktion mit level drin ist auch der Biest-Mode eingerechnet
    if(c == "panzertier") reduction = reduction * 1.5; // panzertiere blocken besser
    reduction = reduction * ((float) t)/sizeof(dam_type); // bei mehrfach schaden zaehlt nur was wir absorbieren koennen
    bufferedDamage = (int) (dam * reduction);
    bufferedDamage = SPELL_DAMAGE_BONUS(owner, "kampfgeist", bufferedDamage);

    if(owner->QueryProp(P_TESTPLAYER)) {
      tell_object(owner, sprintf("kampfgeist :: reduction=%.2f bufferedDamage=%d remainder=%d\n", reduction, bufferedDamage, dam - bufferedDamage));
    }
    

    if(bufferedDamage > dam) {
      msg =  BS(Name(WER)+" faengt den Treffer vollstaendig ab.");
      bufferedDamage = dam;
    } else {
      msg = BS(Name(WER)+" faengt einen Teil des Treffers ab.");
    }

    tell_object(owner, msg);
    
    Defend(bufferedDamage*2, dam_type, ([SP_SHOW_DAMAGE: 1, SP_NAME: "kampfgeist"]), enemy); // wir werden getroffen
    
    SetProp(P_RANGER_LAST_PET_DEFENCE, time());

    return ({dam - bufferedDamage, dam_type, spell});
  }

  return ({dam, dam_type, spell});  
}

public void InformDefend(object enemy) {
  if(mode==MOD_ATTACK) {
    Kill(enemy);
  }
  return;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  if(QueryProp("panzertier_defense") > 0) {
    dam -= random(dam);
    SetProp("panzertier_defense", QueryProp("panzertier_defense")-1);
    if(QueryProp("panzertier_defense") <= 0) {
      tell_object(owner, BS("Der harte Panzer von "+Name(WEM)+" ist aufgebraucht."));
    }
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}

//-- Der eigene Angriff ------------------------------------------------------
void Attack(object enemy)
{
  int dam, oldStr;
  string c;

  if(enemy == owner) {
    tell_object(enemy, BS(Name(WER)+" kaempft nicht gegen dich."));
    StopHuntFor(enemy);
    enemy->StopHuntFor(this_object());
    return;
  }
  
  c=QueryProp(P_RANGER_PET_RACE);
  dam=(2*QueryProp(P_HANDS)[1]+10*(QueryProp(P_ATTRIBUTES)[A_STR]))/3;
  if(QueryTeam() && QueryBiest())
  { 
    if(c=="panzertier") dam=dam*2;
    else {dam=(dam*5)/2;}
    enemy->Defend(dam, QueryProp(P_HANDS)[2], 0, TO); 
    return;
  }
  else if(QueryBiest())
  { 
    if(c=="panzertier") dam=(dam*3)/2;
    else {dam=dam*2;}    
    enemy->Defend(dam, QueryProp(P_HANDS)[2], 0, TO); 
    return;
  }
  
  oldStr = -1;
  if(QueryProp(P_PREFERED_ENEMY)) {
    // markierte beute!
    oldStr = QueryAttribute(A_STR);
    SetAttribute(A_STR, (int) (QueryAttribute(A_STR) * (1.0 + owner->QueryProp(P_GUILD_LEVEL) / 50 )));
  }
  ::Attack(enemy);
  if(oldStr > 0) {
    SetAttribute(A_STR, oldStr);
  }

  if(objectp(enemy) && objectp(owner)) {
    call_other(GUILD_ROOM, "registerArchenemyAttack", enemy, owner);
  }

  if(owner->QueryProp(P_GUILD_LEVEL) > 19 && objectp(enemy) && c=="wolf" && RANGERMASTER->GetMasterAbility(getuid(owner)) == MASTER_ABIILITY_DEEP_BOND && !random(5)) {
    // zusatzangriff
    tell_object(owner, BS("Wie ein Wolf umrundest du dein Opfer und schlaegst ploetzlich zu."));
    owner->Attack(enemy);
  }

  return;
}

//--Vorfunktion fuer den TMP_ATTACK_HOOK--------------------------------------
int noattack(object enemy) { 
  switch(random(3)) {
    case 0:
      tell_room(ENV(enemy), PO->Name(WER)+" schlaegt vor Verwirrung daneben.\n");
      return 0;
      break;
    case 1:
      tell_room(ENV(enemy), PO->Name(WER)+" hat sich vor Verwirrung selbst verletzt.\n");
      PO->AddHp(-QueryProp(P_LEVEL));
      return 0;
      break;
    default: return 1;
  }

  return 1;
}

//--Der Spezialangriff (Tierangriff)------------------------------------------
int SpezialAttack(object enemy, int ability, int success)
{
  mapping m, sinfo;
  int dam, d, i, bonus;
  string c;
  mixed env;
  object ob;

  i = ability / 2000;
  
  /*Rasse     Angriff          Schaden     Zusatzeffekt
  
  wolf:       biss          -> RIP      ** blutende wunde  -> reduce total_ac
  katze:      kratzen       -> RIP      ** blutende wunde  -> reduce total_ac
  baer:       bruellen      -> SOUND    ** veraengstigt    -> reduce total_wc
  riese:      trampeln      -> SQUEEZE  ** zu boden werfen
  vogel:      fluegelschlag -> SLASH    ** 1-2 runden verwirrt, ATTACK_HOOK
  spinne:     stechen       -> POISON   ** verlangsamen
! panzertier: verteidigen   ->          ** 1-2 komplette angriffe abwehren  !
  huftier:    rammen        -> BLUDGEON ** zu boden werfen
  echse:      biss          -> SLASH    ** verlangsamen
  kleintier:  kratzen       -> SLASH    ** augen zerkratzt -> blind

             key       0              1          2     3        4
  mapping=([gruppe:caster-meldung;env-meldung;damage;dam_type;effekt]);*/
  
  if(!objectp(owner) || !objectp(TO) || !objectp(env=ENV(TO)) || !objectp(enemy) ) return 0;

  i = limit(i,1,5);
  c=QueryProp(P_RANGER_PET_RACE);
  dam = (int) ((QueryProp(P_HANDS)[1] / 2) + ability/2000 * 50 + success / 2000 * 50); //Schaden wird beim BIEST automatisch hoeher
  
  /*if((c=="panzertier") && ((QueryProp(P_RANGER_LAST_PET_DEFENCE)+12)>=time()))
  {
    tell_object(owner, BS("Dein Tier kann Dich noch nicht wieder eine "
                          "ganze Attacke fuer Dich abfangen."));
    return 0;
  }*/
  m=(["wolf":      "Du zeigst auf "+E(WEN)+" und "+P(WER)+" springt "+E(WEN)+
                   " an und beisst zu.";
                   CAP(P(WER))+" springt "+E(WEN)+" an und beisst zu.";
                   dam; DT_RIP; REDUCE_AC,
      "katze":     "Du zeigst auf "+E(WEN)+" und "+P(WER)+" springt "+E(WEN)+
                   " an."+P(WER)+" faehrt die Krallen aus.";
                   CAP(P(WER))+" greift "+E(WEN)+" mit den Krallen an.";
                   dam; DT_RIP; BLEED,
      "baer":      "Du zeigst auf "+E(WEN)+" und "+P(WER)+" richtet sich auf "
                   "und bruellt "+E(WEN)+" an.";
                   CAP(P(WER))+" richtet sich auf und bruellt "+E(WEN)+" an.";
                   dam; DT_SOUND; REDUCE_WC,
      "riese":     "Du zeigst auf "+E(WEN)+" und "+P(WER)+" rennt auf "
                   +E(WEN)+" zu um "+E(WEN)+" zu zertrampeln.";
                   CAP(P(WER))+" rennt auf "+E(WEN)+" zu um "+E(WEN)+" zu "
                   "zertrampeln.";
                   dam; DT_SQUEEZE; RAMMEN,
      "vogel":     "Du zeigst auf "+E(WEN)+" und "+P(WER)+" fliegt auf "
                   +E(WEN)+" zum, um "+E(WEM)+" abzulenken.";
                   CAP(P(WER))+" fliegt im Sturzflug auf "+E(WEN)+" zu.";
                   dam; DT_SLASH; NO_ATTACK,
      "spinne":    "Du zeigst auf "+E(WEN)+" und "+P(WER)+" krabbelt auf "
                   +E(WEN)+" zu und setzt zum Stich an.";
                   CAP(P(WER))+" krabbelt auf "+E(WEN)+" zu.";
                   dam; DT_POISON; SLOW,
      "panzertier":"Der Panzer von "+CAP(P(WEM))+" verhaertet sich.";
                   CAP(P(WESSEN))+" Panzer verhaertet sich.";
                   0; DT_MAGIC; DEFENCE,
      "huftier":   "Du zeigst auf "+E(WEN)+" und "+P(WER)+" rammt "+E(WEN)+
                   " mit voller Kraft.";
                   CAP(P(WER))+" rammt "+E(WEN)+" mit voller Kraft.";
                   dam; DT_BLUDGEON; RAMMEN,
      "echse":     "Du zeigst auf "+E(WEN)+" und "+P(WER)+" schnellt vor und "
                   "beisst "+E(WEN)+".";
                   CAP(P(WER))+" schnellt nach vorne und beisst "+E(WEN)+".";
                   dam; DT_SLASH; SLOW,
      "kleintier": "Du zeigst auf "+E(WEN)+" und "+P(WER)+" springt "+E(WEN)+
                   " an um "+E(WEM)+" die Augen zu zerkratzen.";
                   CAP(P(WER))+" springt "+E(WEN)+" an und kratzt wie wild.";
                   dam; DT_SLASH; PBLIND,
      "insekt":    "Du zeigst auf "+E(WEN)+". "+CAP(P(WER))+" fliegt surrend um "+
                   E(WEN)+" herum und beisst "+E(WEN);
                   CAP(P(WER))+" surrt um "+E(WEN)+" herum und beisst.";
                   dam; DT_RIP; NOMAGIC]);
  
  tell_object(owner, BS(to_string(m[c, 0])) );
  tell_room(env, BS(to_string(m[c, 1])), ({owner, TO}) );    
  
  if(c!="panzertier") {   
    sinfo=([SI_SPELLNAME: TIERANGRIFF,
            SI_SPELLFATIGUE: 6,
            SI_SKILLDAMAGE: m[c, 2] ]);
    sinfo=GUILD_SPELLBOOK->ComboModification(enemy, owner, sinfo);

    d=enemy->Defend(SPELL_DAMAGE_BONUS(owner, "tierangriff", sinfo[SI_SKILLDAMAGE]), m[c, 3], 0, TO);

    if(!d || !objectp(enemy) ) {GUILD_SPELLBOOK->ComboFail(owner, sinfo);}
    else {GUILD_SPELLBOOK->ComboDone(owner, enemy, sinfo);}
  }

  if(to_string(m[c, 4]) == DEFENCE) {
    SetProp("panzertier_defense", SPELL_DAMAGE_BONUS(owner, "tierangriff", ability/3333+success/3333+QueryProp(P_LEVEL)/10));
    return 1;
  }
  
  if(objectp(enemy) && (QueryBiest() || success > 8000)) {
    switch (to_string(m[c, 4]))
    {
      case REDUCE_AC: //TOTAL_AC nicht aenderbar->BODY reduzieren
        if(interactive(enemy)) break; //noch was einfallen lassen
        tell_room(env, BS(CAP(P(WER))+" hat die Panzerung von "+E(WEM)+" zerfetzt."), ({enemy}) );
        tell_object(enemy, BS("Fuerchterliche Schmerzen durchzucken deinen "
                           "Koerper, als Du von scharfen Klauen aufgerissen "
                           "wirst."));        
        enemy->SetProp(P_BODY, SPELL_DAMAGE_BONUS(owner, "tierangriff", (enemy->QueryProp(P_BODY))-((enemy->QueryProp(P_BODY))/20)));
        break;
      case REDUCE_WC:
        if(interactive(enemy)) break; //noch was einfallen lassen
        if((enemy->QueryProp(P_LEVEL))<=(QueryProp(P_LEVEL)) )
        {
          tell_room(env, BS(CAP(P(WER))+" hat "+E(WEN)+" veraengstigt. "
                             +CAP(E(WER))+"greift jetzt schwaecher an."), 
                    ({enemy}) );
          tell_object(enemy, BS("Du bekommst Angst vor "+P(WEM)+". Du traust "
                             "Dich kaum, noch anzugreifen."));        
          enemy->SetAttribute(A_STR, (enemy->QueryAttribute(A_STR) - ability/2000 - success/2000 + QueryProp(P_LEVEL)/10) );
        }
        break;
      case RAMMEN:
        tell_room(env, BS(CAP(P(WER))+" hat "+E(WEN)+" zu Boden "
                           "geworfen. "), ({enemy}) );
        tell_object(enemy, BS(CAP(P(WER))+" die kraeftige Attacke hat Dich "
                           "von den Fuessen geholt."));        
        enemy->SetProp(P_LAST_RAMMEN_TIME, time()+i+QueryProp(P_LEVEL)/5);
        enemy->SetProp(P_DISABLE_ATTACK, success/2000);
        break;
      case NO_ATTACK:
        tell_room(env, BS(CAP(P(WER))+" hat "+E(WEN)+" total verwirrt. "), 
                  ({enemy}) );
        tell_object(enemy, BS(CAP(P(WER))+" greift Dich nichtmehr an, aber "
                           "dafuer weist Du jetzt auch nichtmehr wo oben und "
                           "unten ist."));        
        enemy->SetProp(P_TMP_ATTACK_HOOK, ({time()+(ability/3333 + success/2000 + QueryProp(P_LEVEL)/5), TO, "noattack"}));
        break;
      case SLOW:
        tell_room(env, BS(CAP(P(WER))+" hat "+E(WEN)+" stark verwundet. "+
                           E(WER)+" wird langsamer."), ({enemy}) );
        tell_object(enemy, BS(CAP(P(WER))+" hat Dich schwer verletzt. Deine "
                           "Bewegungen werden traege."));
        enemy->ModifySkillAttribute(TO, SA_SPEED, 50,  QueryProp(P_LEVEL)/5 + ability/3333 + success/3333);
        break;
      case PBLIND:
        tell_room(env, BS(CAP(P(WER))+" hat "+E(WEM)+" die Augen "
                           "zerkratzt. "+E(WER)+" ist jetzt blind.")
                           , ({enemy}) );
        tell_object(enemy, BS(CAP(P(WER))+" hat Dir die Augen zerkratzt. Du "
                           "bist blind!"));
        enemy->SetProp(P_BLIND, ability/2000 + success/2000 + QueryProp(P_LEVEL)/5);
        break;
      case NOMAGIC:
        tell_room(env, BS(CAP(P(WER)+" hat "+E(WEN)+" so sehr abgelenkt, dass "
                          +E(WER)+" sich weniger auf Spezialangriffe konzentriert!")), ({enemy}));
        enemy->SetProp(P_SPELLRATE, enemy->QueryProp(P_SPELLRATE)-ability/10000 - success/3333 - QueryProp(P_LEVEL)/2);
        break;
      case DEFENCE: 
        SetProp("panzertier_defense", ability/3333+success/3333+QueryProp(P_LEVEL)/10);
      case BLEED:
        enemy->SetProp(P_RANGER_EVISCERATED_UNTIL, time() + ability/2000 + success / 3333);
        call_other("/spellbooks/waldlaeufer_spells", "eviscerate_bleed", enemy, QueryProp(P_LEVEL)/2 + ability/1000 + success/2000, owner);
        tell_room(env, BS(CAP(P(WER))+" reisst "+E(WEM)+" eine blutende Wunde."), ({enemy}) );
        tell_object(enemy, BS("Fuerchterliche Schmerzen durchzucken deinen "
                           "Koerper, als Du von scharfen Klauen aufgerissen "
                           "wirst."));
        break;
    }
  }
  return 1;
}
