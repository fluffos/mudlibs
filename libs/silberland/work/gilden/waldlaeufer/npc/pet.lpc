                   "stoesst Dich leicht mit dem Kopf";
                     "stoesst "+R(WEN)+" leicht mit dem Kopf";
                   "scharrt mit den Hufen";"scharrt mit den Hufen";
                   "macht einige kleine Spruenge zurueck";
                     "macht einige kleine Spruenge zurueck";
                   "scharrt mit den Hufen";"scharrt mit den Hufen";
                   "scharrt mit den Hufen";"scharrt mit den Hufen";
                   "blickt Dich aus grossen Augen an";
                     "schaut "+R(WEN)+" an",
         "echse":"zischt leise";"zischt leise";
                 "huscht davon";"huscht davon";
                 "beachtet Dich nicht";"beachtet Euch nicht";
                 "schnappt nach Dir";"schnappt nach "+R(WEM);
                 "naehert sich Dir auf bedrohlicher Art und Weise";
                   "naehert sich "+R(WEM)+" auf bedrohlicher Art und Weise";
                 "bewegt sich nicht";"bewegt sich nicht";
                 "erstarrt auf einmal";"erstarrt auf einmal";
                 "weicht Dir aus";"weicht "+R(WEM)+" aus";
                 "reagiert nicht";"zeigt keine Reaktion";
                 "zeigt keine Reaktion";"reagiert nicht",
         "kleintier":"schaut Dich mit grossen Augen an";
                       "schaut Dich mit grossen Augen an";
                     "ignoriert Dich";"ignoriert "+R(WEN);
                     "schaut drollig";"schaut drollig";
                     "beisst Dich und rennt weg";
                       "beisst "+R(WEN)+" und rennt weg";
                     "wuselt davon";"wuselt davon";
                     "wuselt aufgeregt um Dich herum";
                       "wusel aufgeregt um "+R(WEN)+" herum";
                     "schaut lieb";"schaut lieb";
                     "richtet sich kurz vor Dir auf";
                       "richtet sich kurz vor "+R(WEM)+" auf";
                     "schaut Dich fragend an";"schaut "+R(WEN)+" fragend an";
                     "schaut Dich troestend an";
                       "schaut "+R(WEN)+" troestend an"]);
  
  emotions=(["aengstlich": pets[c,  0]; pets[c,  1],    //0
             "aergerlich": pets[c,  2]; pets[c,  3],    //1
             "albern":     pets[c,  4]; pets[c,  5],    //2
             "fies":       pets[c,  6]; pets[c,  7],    //3
             "frech":      pets[c,  8]; pets[c,  9],    //4
             "froh":       pets[c, 10]; pets[c, 11],    //5
             "intim":      pets[c, 12]; pets[c, 13],    //6
             "nett":       pets[c, 14]; pets[c, 15],    //7
             "neutral":    pets[c, 16]; pets[c, 17],    //8
             "traurig":    pets[c, 18]; pets[c, 19] ]); //9
        
  return to_string(emotions[gruppe, i]);
}

//--Start der Reaktionen------------------------------------------------------
void StartReaction(string verb, string gruppe, string adverb, int touch)
{ if(find_call_out("reaction") != -1) return;
  call_out("reaction", 0, TP, cr(gruppe,1), cr(gruppe,2)); }
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{ return StartReaction(verb, gruppe, adverb, touch); }

//--Ausgabe der Reaktionen----------------------------------------------------
void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher+"."));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere+"."), ({pl}) );
}
//**************************************************************************//

public int _query_ranger_max_pet_level() {
  int lvl;
  if(!objectp(owner)) return 30;

  lvl = 10;
  lvl += owner->QueryProp(P_GUILD_LEVEL); 
  if(R_SKILLMASTER->HasSkill(getuid(owner), VERBESSERTE_ZAEHMUNG)) {
    lvl += 5;
  }
  if(R_SKILLMASTER->HasSkill(getuid(owner), TIER_RESPEKT)) {
    lvl += 5;
 }

  return lvl;
}

public int AddHp(int value) {
  object koecher;
  int r;

  r = ::AddHp(value);
  if(objectp(owner) && objectp(koecher=present(GUILD_OBJ_ID, owner))) {
    koecher->NotifyHpChange(1);
  }

  return r;
}

public int do_damage(int dam, mixed enemy) {
  object koecher;
  int r;

  r = ::do_damage(dam, enemy);
  if(objectp(owner) && objectp(koecher=present(GUILD_OBJ_ID, owner))) {
    koecher->NotifyHpChange(1);
  }

  return r;
}

public void ActivateSupportBenefit(int ability, int success) {
  int duration, chance;
  string msgOwner, msgOthers;

  if(!objectp(owner)) return;

  duration = SPELL_DAMAGE_BONUS(owner, "gemeinsame attacke", owner->QueryAttribute(A_INT)/2 + ability/200 + success/100);
  chance   = owner->QueryAttribute(A_INT) +  ability/333 + success/666;

  switch(QueryProp(P_RANGER_PET_RACE)) {
    case "wolf":
      // beisst zu und verlangsamt den gegner damit kurz 
      msgOwner  = Name(WER)+" stellt sich knurrend an deine Seite und wartet auf eine Gelegenheit zuzuschnappen.";
      msgOthers = Name(WER)+" stellt sich knurrend an die Seite von "+owner->Name(WEM)+".";
      break;
    case "katze":
      // gegner umwerfen
      msgOwner  = Name(WER)+" huscht durch die Beine deine Gegner.";
      msgOthers = Name(WER)+" beginnt durch die Beine von "+owner->Name(WESSEN)+" Gegnern zu laufen.";
      break;
    case "baer":
      // zusaetzlicher angriff
      msgOwner  = Name(WER)+" laeuft hinter deine Gegner und stellt sich auf die Hinterbeine.";
      msgOthers = Name(WER)+" laeuft um die Gegner von "+owner->Name(WEM)+" herum und stellt sich auf die Hinterbeine.";
      break;
    case "riese":
      // miss chance fuer gegner
      msgOwner  = Name(WER)+" beginnt deine Gegner zum umkreisen und wirbelt Staub auf.";
      msgOthers = Name(WER)+" beginnt die Feinde zum umkreisen und Staub aufzuwirbeln.";
      break;
    case "vogel":
      // bonus schaden fuer waffenskill
      msgOwner  = Name(WER)+" steigt hoch ueber deinen Feinden kreisend auf und sucht nach Schwachstellen.";
      msgOthers = Name(WER)+" steigt auf und dreht kreischend Kreise ueber den Kaempfenden.";
      break;
    case "spinne":
      // webt in kokon ein -> schutz
      msgOwner  = Name(WER)+" beginnt einen dicken Faden zu weben, um dich notfalls damit zu schuetzen.";
      msgOthers = Name(WER)+" beginnt einen dicken Faden zu weben.";
      break;
    case "panzertier":
      // umwerfen
      msgOwner  = Name(WER)+" scharrt mit den Fuessen und wartet auf seine Gelegenheit.";
      msgOthers = Name(WER)+" scharrt nervoes mit den Fuessen.";
      break;
    case "huftier":
      // rüstung zertruemmern
      msgOwner  = Name(WER)+" wendet deinen Gegnern das Hinterteil zu, um sofort zuzutreten.";
      msgOthers = Name(WER)+" wendet sich um, um mit den Hinterhufen zu treten.";
      break;
    case "echse":
      // gegner vergiften
      msgOwner  = Name(WER)+" faucht und macht sich bereit mit seinen giftigen Zaehnen zuzubeissen.";
      msgOthers = Name(WER)+" feucht und bleckt gifttriefende Zaehne.";
      break;
    case "kleintier":
      // zauberkosten reduziert
      msgOwner  = Name(WER)+" schmiegt sich eng an dich.";
      msgOthers = Name(WER)+" schmiet sich eng an "+owner->Name(WEN)+".";
      break;
    case "insekt":
      // angriffe schwaechen
      msgOwner  = Name(WER)+" plustert sich schillernd auf, bereit loszuwirbeln.";
      msgOthers = Name(WER)+" plustert sich schillernd auf.";
      break;
  }

  owner->SetProp(P_RANGER_PET_SUPPORT, ({TO, time()+duration, chance}));
  tell_object(owner, BS(msgOwner));
  tell_room(ENV(TO), BS(msgOthers), ({owner}));

  pDebug(owner, sprintf("gemeinsame attacke :: duration=%d chance=%d\n", duration, chance));

  call_out("endSupport", duration);
  return;
}

public void endSupport() {
  while(find_call_out("endSupport") != -1) remove_call_out("endSupport");

  owner->SetProp(P_RANGER_PET_SUPPORT, 0);
  tell_object(owner, BS(Name(WER)+" greift nicht mehr gemeinsam mit dir an."));
  tell_room(ENV(TO), BS(Name(WER)+" greift nicht mehr gemeinsam mit "+owner->Name(WEM)+" an."), ({owner}));
  return;
}

public int supportRanger(object enemy) {
  int *support, r, i;
  string msgOwner, msgOthers;
  object ob;

  support = owner->QueryProp(P_RANGER_PET_SUPPORT);
  if(!pointerp(support)) return 0; // support nicht aktiv

  if(time() > support[1]) {
    endSupport();
    return 0;
  }

  // effekt schon aktiv
  if(objectp(present(SPIDER_KOKON_ID, owner)) && QueryProp(P_RANGER_PET_RACE) == "spinne" ||
     objectp(present(NPC_POISON_ID+"_companion_"+getuid(owner), enemy)) && QueryProp(P_RANGER_PET_RACE) == "echse" ||
     objectp(present(SPELLSUPPORT, owner)) && QueryProp(P_RANGER_PET_RACE == "kleintier")) return 0; 
     

  if(random(100) > support[2]) return 0; // nicht ausgeloest

  owner->AddSp(-2);

  r = 0;
  switch(QueryProp(P_RANGER_PET_RACE)) {
    case "wolf":
      // beisst zu und verlangsamt den gegner damit kurz 
      msgOwner  = Name(WER)+" schnappt nach den Gliedmassen von "+enemy->name(WEM)+".";
      msgOthers = Name(WER)+" schnappt nach den Gliedmassen von "+enemy->name(WEM)+".";
      enemy->ModifySkillAttribute(TO, SA_SPEED, 50,  QueryProp(P_LEVEL)/4);
      break;
    case "katze":
      // gegner umwerfen
      msgOwner  = Name(WER)+" bringt "+enemy->name(WEN)+" zu Fall.";
      msgOthers = Name(WER)+" bringt "+enemy->name(WEN)+" zu Fall.";
      enemy->SetProp(P_LAST_RAMMEN_TIME, time()+QueryProp(P_LEVEL)/2);
      enemy->SetProp(P_DISABLE_ATTACK, QueryProp(P_LEVEL)/10);
      break;
    case "baer":
      // zusaetzlicher angriff
      msgOwner  = Name(WER)+" laesst die Pranken auf "+enemy->name(WEN)+" herabsausen.";
      msgOthers = Name(WER)+" laesst die Pranken auf "+enemy->name(WEN)+" herabsausen.";
      i = QueryAttribute(A_STR);
      SetAttribute(A_STR, i + QueryProp(P_LEVEL));
      Attack(enemy);
      SetAttribute(A_STR, i);
      break;
    case "riese":
      // miss chance fuer gegner
      msgOwner  = Name(WER)+" wirbelt Staub um "+enemy->Name(WEN)+" auf.";
      msgOthers  = Name(WER)+" wirbelt Staub um "+enemy->Name(WEN)+" auf.";
      enemy->SetProp(P_BLIND, QueryProp(P_LEVEL) / 4);
      break;
    case "vogel":
      // bonus schaden fuer waffenskill
      msgOwner  = Name(WER)+" stoesst einen schrillen Schrei aus, der dich den richtigen Moment zum Angriff hinweist.";
      msgOthers = Name(WER)+" stoesst einen schrillen Schrei aus.";
      r = QueryProp(P_LEVEL)*5 + random(QueryProp(P_LEVEL)*5);
      break;
    case "spinne":
      // webt in kokon ein -> schutz
      msgOwner  = Name(WER)+" wirft Spinnfaeden nach dir, die dich in einen schuetzenden Kokon einweben.";
      msgOthers = Name(WER)+" webt "+owner->name(WEN)+" in einen schuetzenden Konkon.";
      ob = clone_object(ARMOUR"invis_armour");
      ob->SetProp(P_SHORT, "Spinnenkokon"); // es kann nur ein AT_MISC pro Short getragen werden
      ob->move(owner, M_SILENT);
      ob->SetBonus( ({DT_SLASH,DT_BLUDGEON,DT_PIERCE,DT_SQUEEZE,DT_WHIP,DT_RIP,
                        DT_POISON}), QueryProp(P_LEVEL)/2, 4);
      ob->AddId(SPIDER_KOKON_ID);
      break;
    case "panzertier":
      msgOwner  = Name(WER)+" rammt "+enemy->name(WEN)+" mit aller Kraft und "+enemy->QueryPronoun()+" faellt zu Boden.";
      msgOthers =  Name(WER)+" rammt "+enemy->name(WEN)+" mit aller Kraft und "+enemy->QueryPronoun()+" faellt zu Boden.";
      enemy->SetProp(P_LAST_RAMMEN_TIME, time()+QueryProp(P_LEVEL)/4);
      enemy->SetProp(P_DISABLE_ATTACK, QueryProp(P_LEVEL)/20);
      Attack(enemy);
      break;
    case "huftier":
      // rüstung zertruemmern
      msgOwner  = Name(WER)+" tritt "+enemy->name(WEN)+" mit den Hufen und zertruemmert dessen Schutz.";
      msgOthers = Name(WER)+" tritt "+enemy->name(WEN)+" mit den Hufen und zertruemmert dessen Schutz.";
      if(!interactive(enemy)) enemy->SetProp(P_BODY, (enemy->QueryProp(P_BODY))-(QueryProp(P_LEVEL)));
      break;
    case "echse":
      // gegner vergiften
      msgOwner  = Name(WER)+" erwischt "+enemy->name(WEN)+" mit einem Giftbiss.";
      msgOthers = Name(WER)+" erwischt "+enemy->name(WEN)+" mit einem Giftbiss.";
      ob=clone_object(OBJ "npc_poison"); 
      ob->AddId(NPC_POISON_ID+"_companion_"+getuid(owner));
      ob->move(enemy, M_NOCHECK|M_SILENT);
      ob->poison(enemy, owner, 0, random(QueryProp(P_LEVEL) * 100));
      break;
    case "kleintier":
      // zauberkosten reduziert
      msgOwner  = Name(WER)+" staerkt dein Band zur Natur und erleichtert deine Zauber.";
      msgOthers = Name(WER)+" drueckt sich eng an "+owner->Name(WEN)+".";
      ob = clone_object(ARMOUR"invis_armour");
      ob->SetProp(P_SHORT, "Zauberbonus"); // es kann nur ein AT_MISC pro Short getragen werden
      ob->move(owner, M_SILENT);
      ob->SetProp(P_RANGER_SPELLCOST, QueryProp(P_LEVEL));
      ob->AddId(SPELLSUPPORT);
      break;
    case "insekt":
      // angriffe schwaechen
      msgOwner  = Name(WER)+" lenkt "+enemy->name(WEN)+" ab.";
      msgOthers =Name(WER)+" lenkt "+enemy->name(WEN)+" ab.";
      enemy->SetProp(P_TMP_ATTACK_HOOK, ({time()+(QueryProp(P_LEVEL)/5), TO, "noattack"}));
      SetProp("support_noattack", enemy);
      break;
  }

  tell_object(owner, BS(msgOwner));
  tell_room(ENV(TO), BS(msgOthers), ({owner}));

  if(QueryProp(P_SP) < 5) {
    tell_object(owner, BS(Name(WER)+" ist erschoepft."));
    endSupport();
  } else {
    AddSp(-5);
  }
  
  return r;
}

public string pet_race_to_king(string race) {
  return ([
  "wolf":       ({"morcan", "morcan", "morcan", "lir"})[random(4)],
  "katze":      ({"aedan", "aedan", "aedan", "eoin"})[random(4)],
  "baer":       ({"morcan", "ciaran"})[random(2)],
  "riese":      ({"belenus", "thorondor"})[random(2)],
  "vogel":      ({"eoin", "arawn", "thorondor", "bran"})[random(3)],
  "spinne":     ({"fiachra", "arawn"})[random(2)],
  "panzertier": ({"fiachra", "lir"})[random(2)],
  "huftier":    ({"ciaran", "bran", "lir"})[random(3)],
  "echse":      ({"belenus", "brenin"})[random(2)],
  "kleintier":  ({"eoin", "bran", "brenin", "aedan"})[random(4)],
  "insekt":     ({"brenin", "fiachra"})[random(2)]
  ])[race];
}

