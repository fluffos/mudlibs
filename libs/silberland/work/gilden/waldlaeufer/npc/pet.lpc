//** Komunikation **********************************************************//
//--Kommandos empfangen-------------------------------------------------------
void catch_tell(string str)
{
  string who,target,action;

  if(!objectp(owner) || !interactive(owner)) return;
  
  if(!((query_verb() == "sag") /*|| (query_verb()[0..0] == "'")*/))return;
                              //buggt. 
  if(sscanf(str,"%s sagt: %s %s",who,target,action) != 3)      return;
  if(!id(target))                                              return;
  if(find_player(lower_case(who)) != owner)                    return;
  if(action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);
  call_out("order",0,action);
  return;
}

public void attack_order(string action) {
  int space;
  string target;
  object enemy;

  space = strstr("toete hansi", " ", 0);
  if(space < 0) {
    command_me("emote sieht sich verwirrt um.");
    return;
  }

  target = action[space+1..];
  if(!objectp(enemy = present(target, ENV(TO)))) {
    command_me("emote sucht das Ziel, findet aber niemanden.");
    return;
  }

  if(query_once_interactive(enemy)) {
    command_me("emote winselt leise.");
    return;
  }

  command_me("emote stuerzt sich auf "+enemy->name(WEN));
  Kill(enemy);
  return;
}

//--Die moeglichen Anweisungen------------------------------------------------
int order(string action)
{
  object *enemies;
  int i;
  string path;
  mixed env;
  
  path=MEMBERS_PETS+lower_case(to_string(owner->QueryProp(P_NAME)))+".o";
  if(!objectp(TO) || !objectp(owner) || !objectp(env=ENV(owner)))
  { return 0; }

  if(action == "versteck dich"  ||
     action == "verstecke dich" ||
     action == "geh")
  { tell_room(env, BS(Name()+" verschwindet."));
    call_out("remove", 0);
    return 1;}
    
  if(action == "du bist frei" ||
     action == "verschwinde"  ||
     action == "hau ab"       ||
     action == "verzieh dich")
  { if(!objectp(owner) || !interactive(owner)) return 1;
    tell_room(env, BS(Name()+" verschwindet fuer Immer."));
    if((file_size(path))>0) { rm(path); }
    call_out("remove", 0);
    return 1;}
  
  if(action == "kaempfe"     ||
     action == "kaempf"      ||
     action == "kaempfe mit" ||
     action == "hilf mir"    ||
     action == "kaempfe mit mir")
  { tell_object(owner, BS(Name()+" kaempft jetzt mit Dir zusammen."));
    if(pointerp(enemies=owner->PresentEnemies()) && (sizeof(enemies)>0))
    { for(i=0; i<=sizeof(enemies)-1; i++)
      {Kill(enemies[i]);} }
    owner->AddDefender(TO);
    mode=MOD_ATTACK;
    return 1; } 
    
  if(action == "pause"       ||
     action == "kampfpause"  ||
     action == "stopp")
  { tell_object(owner, BS( "Du kaempfst jetzt alleine.")); 
    owner->RemoveDefender(TO);
    mode=MOD_PEACE;
    enemies=QueryEnemies()[0];
    for(i=0; i<=sizeof(enemies)-1; i++)
    { enemies[i]->StopHuntFor(TO,1);
      StopHuntFor(enemies[i],1); }
    return 1; } 

  if(action[0..3] == "toet" || action[0..8] == "attackiere") {
    attack_order(action);
  }
  
}
//**************************************************************************//



//** Sterben/Pause und Wiederbeleben ***************************************//
//--Die Pausezeit erimmteln---------------------------------------------------
int QueryDietime()
{
  string backupfile, *lines, *pos;
  int i, dietime;  
  
  if(!objectp(owner) || !interactive(owner)) { return 1; }
  
  dietime=0;
  if(backupfile=read_file(R_PET_DIETIME))
  {
    lines=explode(backupfile, "\n");
    for(i=0; i<=sizeof(lines)-1; i++)
    {
      pos=explode(lines[i], "**");
      if(to_string(pos[0])==QueryProp(P_RANGER_PET_OWNER))
      { dietime=to_int(pos[1]); }
    }
  }
  return dietime;
}

//--Ist die Zeit vorbei?------------------------------------------------------
int CanComeback()
{
  if(objectp(owner) && !interactive(owner)) return 1;
  
  if(QueryDietime()+600 > time()) return 0; //10 Min Pause
  return 1;
}

//--Pausezeit wird gesetzt----------------------------------------------------
int SetDietime()
{
  string backupfile, *lines, *pos, new_file;
  int i;  
  
  if(!objectp(owner) || !interactive(owner)) return 1;
  
  if(backupfile=read_file(R_PET_DIETIME))
  {
    new_file="";
    lines=explode(backupfile, "\n");
    for(i=0; i<=sizeof(lines)-1; i++)
    {
      pos=explode(lines[i], "**");
      if(to_string(pos[0])==QueryProp(P_RANGER_PET_OWNER))
      { continue; }
      new_file+=to_string(lines[i])+"\n"; 
    }
    new_file+=QueryProp(P_RANGER_PET_OWNER)+"**"+to_string(time())+"\n";
    write_bytes(R_PET_DIETIME, 0, new_file);
    return 1;
  }
  return 0;
}

//--Pausezeit beim DIE--------------------------------------------------------
void die(int poisondeath)
{ 
  int lostxp;
  if(objectp(ENV(TO))) {
    tell_room(ENV(TO), BS(Name(WER)+" zieht sich schwer verwundet zurueck."));
  }
  SetDietime();

  lostxp = QueryProp(P_LEVEL) * 1500;
  if(QueryProp(P_XP)-lostxp < 0) {
    lostxp -= QueryProp(P_XP);
    new_level(-1); // wir fallen um ein level nach unten
    SetProp(P_XP, GetNextLevelXp()-lostxp);
  } else {
    SetProp(P_XP, QueryProp(P_XP) - lostxp);
  }

  remove(1);
  return;
}
