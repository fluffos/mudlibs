int SetIncarnation(int ability, int success) {
  string attr;
  object bonus;
  int duration;

  incarnation = limit(ability/2000 + success/2000, 1, 10);
  duration = random(owner->QueryAttribute(A_INT) * 10) + ability/16 + success / 16;

  pDebug(owner, sprintf("pet :: SetIncarnation incarnation=%d duration=%d\n", incarnation, duration));

  current_tierkoenig = pet_race_to_king(QueryProp(P_RANGER_PET_RACE));
  tell_room(ENV(TO), BS(sprintf("Der Tierkoenig %s beseelt %s mit urtuemlicher Kraft.", capitalize(current_tierkoenig), name(WEN, 1))));
  tell_room(ENV(TO), BS(sprintf("%s erhaelt einen Schutz vor %s.", Name(WER, 1), tk_protection_text(current_tierkoenig))));

  if(incarnation > 4) {
    attr = tk_attr_bonus(current_tierkoenig);
    tell_room(ENV(TO), BS(attr_boost_text(attr)));
    bonus = clone_object(OBJ "bonus");
    if(!bonus->move(TO)) {
      destruct(bonus);
    } else {
      bonus->SetBonus(attr, incarnation * 2, duration);
      bonus->AddId("\ntk_incarnation");
    }
    UpdateAttributes();
  }

  if(incarnation > 6) {
    tell_room(ENV(TO), BS(sprintf("%s Angriffe werden zu %s.", Name(WESSEN, 1), tk_hand_message(current_tierkoenig))));
  }

  SetProp(P_HP, QueryProp(P_MAX_HP));
  SetProp(P_SP, QueryProp(P_MAX_SP));

  call_out("deincarnate", duration);
}

public void deincarnate() {
  if(!QueryIncarnation()) return;

  incarnation = 0;
  if(present("\ntk_incarnation")) present("\ntk_incarnation")->remove(1);
  
  tell_room(ENV(TO), BS("Die Macht der Tierkoenige verlaesst "+name(WEN, 1)+" wieder."));
  return;
}

public mixed* _query_hands() {
  mixed *dt;

  if(!hand_overwrite) return hand_base;

  if(QueryIncarnation() > 6) {
    dt = hand_base[2];
    if(!pointerp(dt)) dt = ({ dt });
    return ({tk_hand_message(current_tierkoenig), hand_damage(QueryProp(P_LEVEL)), dt + ({ tk_dam_type(current_tierkoenig) }) });
  }

  if(!hand_base) return 0;

  return ({ hand_base[0],  hand_damage(QueryProp(P_LEVEL)), hand_base[2] });
}

public mapping _query_resistance_strengths() {
  float f;

  if(!hand_overwrite) return res_str_overwrite;
  if(!QueryIncarnation()) return res_str_overwrite;

  if(!mappingp(res_str_overwrite)) res_str_overwrite = ([]);

  f = -0.1 * QueryIncarnation();

  return res_str_overwrite + ([tk_dam_type(current_tierkoenig): f]);
}
