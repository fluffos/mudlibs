public int QueryIncarnation() {
  return incarnation;
}



//** Standardfunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_FRIEND, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1); 
  SetProp(P_NO_SCORE, 1); 
  enable_commands();
  mode=MOD_PEACE;
  teamtime=0;
  beastReady=1;
  hand_overwrite = 0;
  SUID;

  AddCmd(({"nenne", "nenn", "benenne", "benenn", "taufe", "tauf"}), "cmd_rename");
}

public int cmd_rename(string str) {
  string wen, wie, oldName;

  if(TP != owner) return 0;
  if(QueryProp(P_RANGER_PET_RENAMED)) {
    write(BS("Du hast deinem Begleiter schon einen Namen gegeben."));
    return -1;
  }

  notify_fail("Wen willst du wie taufen?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s %s", wen, wie) != 2) return 0;

  notify_fail("Aber sojemand ist hier doch gar nicht?\n");
  if(!id(wen)) return 0;

  oldName = QueryProp(P_NAME);
  write(BS(sprintf("%s hoert nun auf den Namen %s.", oldName, wie)));
  SetProp(P_NAME, capitalize(wie));
  SetProp(P_SHORT, sprintf("%s, %sgezaehmte %s von %s", wie, QueryArticle(WER, 1), oldName, owner->Name(WEM)));
  AddId(wie);
  SetProp(P_RANGER_PET_RENAMED, 1);
  SetProp(P_ARTICLE, 0);
  return 1;
}

string _query_noattack() {
  if(TP == owner) return "will nicht gegen dich kaempfen.";
  if(interactive(TP)) return "gehoert einem anderen Spieler.";
  return 0;
}

//-- Wer ist der Besitzer? ---------------------------------------------------
mixed QueryOwner()
{ if(owner) { return owner; }
  return 0; }
  
//-- Beim Tod verschwinden ---------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(objectp(owner) && (player == owner))
  { call_out("remove", 0); }
  return;
}

//-- Remove ------------------------------------------------------------------
int remove()
{
  string path;
  
  if(!objectp(owner) || !interactive(owner)) { return ::remove(); }

  SetProp("ranger_pet_remove_time", time());
  
  path=MEMBERS_PETS+lower_case(to_string(owner->QueryProp(P_NAME)))+".o";
  if((file_size(path))>0) {
    SavePet();
  } 
  
  owner->RemovePursuer(TO);
  owner->RemoveDefender(TO);
  while(remove_call_out("remove")!=-1);
  return ::remove();
}

//-- Reset -------------------------------------------------------------------
void reset()
{
  mixed env;
  
  ::reset();
  
  if( objectp(owner) && owner->id(DEFAULT_RANGER_ID) ) return; 

  if(!objectp(owner)  || !interactive(owner) || !objectp(find_player(QueryProp(P_RANGER_PET_OWNER)))) {
    remove();
    return;
  }
  
  /*Warum nehmen wir einem Tiermeister seine Faehigkeiten fuer lange Zeit weg??
  if(breakcounter>=4)
  {
    SetDietime();
    if(objectp(env=ENV(TO)))
    { tell_room(env,BS(Name()+" braucht eine Ruhepause und verschwindet.")); }
    remove(); 
  }*/
  breakcounter+=1;

  if(!beastReady) {
    beastReady=1;
    if(objectp(env=ENV(TO))) {
      tell_room(env, BS(sprintf("%s erholt sich und kann wieder von einem Naturgeist beseelt werden",
                Name(WER))));
    }
    set_next_reset(3600);
  }
}
//**************************************************************************//

public int _query_spellrate() {

  if(QueryIncarnation()) {
    return QueryAttribute(A_INT);
  }

  if(QueryProp(P_LEVEL) > 10 && QueryProp(P_SPELLS)) {
   return QueryProp(P_LEVEL) / 2;
  }
  return 0;
}

//** Speichern und Laden ***************************************************//
//--Die Erschaffung-----------------------------------------------------------
int second_create(object caster, mixed m)
{
  string s, *indices;
  int i;
  mixed env;
  object dto;
  
  if(!objectp(caster) || !living(caster) || !objectp(TO) ||
     !objectp(env=ENV(caster)) )
  { return 0; }
  if(!interactive(caster) && stringp(m) && m!=0){ s=m; }
  else { s=getuid(caster); }
  s=MEMBERS_PETS+s;
  
  if(file_size(s+".o") > 0){ 
    owner=caster; 
    dto = clone_object(OBJ "pet_data_holder");
    dto->LoadFrom(s);
    indices = m_indices(dto->GetData());
    for(i=0; i<sizeof(indices); ++i) {
      if(indices[i] == P_HANDS) {
        hand_base = dto->GetData()[indices[i]];
      } else {
        SetProp(indices[i], dto->GetData()[indices[i]]);
      }
    }
    destruct(dto);
  }
  else {
    tell_object(caster, BS("Dein Tier gibt es nicht."));
    remove();
    return 0;
  }
  if(!CanComeback())
  {
    tell_object(caster,BS("Dein Tier benotigt noch eine Ruhepause, bis Du es "
                          "wieder rufen kannst."));
    remove();
    return 0;
  }
  
  AddHp(time()-QueryProp("ranger_pet_remove_time"));

  move(env, M_GO|M_SILENT);
  PETMASTER->SetPet(caster, TO);
  caster->AddPursuer(TO);
  caster->AddDefender(TO);
  breakcounter=0;
  teamtime=0;

  if(QueryProp(P_LEVEL) > QueryProp(P_RANGER_MAX_PET_LEVEL)) {
    pDebug(owner, sprintf("ranger pet :: max level(%d) < level (%d)", QueryProp(P_RANGER_MAX_PET_LEVEL), QueryProp(P_LEVEL)));
    new_level(QueryProp(P_RANGER_MAX_PET_LEVEL) - QueryProp(P_LEVEL));
  }

  if(lower_case(QueryProp(P_RACE)) == "npc" || lower_case(QueryProp(P_RACE)) == "tier") {
    SetProp(P_RACE, capitalize(QueryProp(P_RANGER_PET_RACE)));
  }

  res_str_overwrite = QueryProp(P_RESISTANCE_STRENGTHS);
  hand_overwrite = 1;
  return 1;
}

//--Speichern-----------------------------------------------------------------
int SavePet() {
  object dto;

  if(QueryBiest()) return 1;
  if(QueryIncarnation()) return 0;
  if(!objectp(owner) || !interactive(owner)) { return 1; }

  hand_overwrite = 0;
  
  dto = clone_object(OBJ "pet_data_holder");
  dto->copyData(TO);
  dto->Save(owner);
  destruct(dto);

  hand_overwrite = 1;

  return 1;
}
//**************************************************************************//



//** XPs/Level *************************************************************//
//-- Auslagerung wegen der Skillpunkte noetig --------------------------------
int hand_damage(int level)
{
  int i, skill;
 
  if(objectp(owner)) {
     skill = (R_SKILLMASTER->HasSkill(getuid(owner), TIER_ATTACKEN));
  }

  if(level<=30) {
    i = 10 * QueryAttribute(A_STR);
  } else {
    i = 300 + 5 * (QueryAttribute(A_STR) - 30);
  }

  if(skill) i = (int) (i * 1.1);
  
  return i;  
}


//-- Auslagerung wegen der Skillpunkte noetig --------------------------------
int body(int level)
{
  int i, skill;

   if(objectp(owner)) {
     skill = (R_SKILLMASTER->HasSkill(getuid(owner), TIER_VERTEIDIGUNG));
  }

  i = 4* level;

  if(skill) {
    i = (int) (i * 1.1);
  }
  
  return i;  
}

public int _query_body() {
  return body(QueryProp(P_LEVEL));
}

//--Anpassung des NPCs--------------------------------------------------------
varargs int new_level(int gainedLevels)
{
  int level;
  
  level=QueryProp(P_LEVEL);
  if(!objectp(owner)) { return 0; }
  if(level>=MAX_LEVEL && gainedLevels > 0) return 1;
  if(level>=QueryProp(P_RANGER_MAX_PET_LEVEL) && gainedLevels > 0) return 1;
  if(gainedLevels != 0) {
    level += gainedLevels;
  } else {
    level += 1;
  }

  SetProp(P_LEVEL, level);
  SetProp(P_ATTRIBUTES, ([A_CON: level, A_DEX: level,
                          A_STR: level, A_INT: level]));  
  SetProp(P_MAX_HP, 30+level*level);
  SetProp(P_MAX_SP, QueryProp(P_MAX_HP));
  SetProp(P_HANDS, ({QueryProp(P_HANDS)[0],
                    hand_damage(level), QueryProp(P_HANDS)[2] }) );
  SetProp(P_XP, 0);

  SavePet();
  if(gainedLevels>=0) tell_object(owner, BS(Name(WER)+" ist staerker geworden."));
  else tell_object(owner, BS(Name(WER)+" ist schwaecher geworden!"));
  return 1;
}

public int GetNextLevelXp() {
  int level;

  level = QueryProp(P_LEVEL);
  if(level >= QueryProp(P_RANGER_MAX_PET_LEVEL)) return -1;
  return next_level[1+level];
}

//--Hier werden die erfahrungspunkte aufgeschlagen und ausgewertet------------
int AddExp(int points)
{
  int al;
  
  if(RANGERMASTER->GetMasterAbility(getuid(owner)) == MASTER_ABIILITY_POWERFUL_COMPANION) {
    owner->AddExp(points);
  } else {  
    if(objectp(owner) && QueryProp(P_LEVEL) < QueryProp(P_RANGER_MAX_PET_LEVEL) ) { 
      owner->AddExp(points/2); 
    } else {
      owner->AddExp(points);
      return ::AddExp(0);
    }
  }
  
  al=QueryProp(P_LEVEL);
  if(al>=(sizeof(next_level)-1)) {
    al=(sizeof(next_level)-2);
  }

  if(QueryProp(P_XP) >= (next_level[1+al]) && QueryProp(P_LEVEL) < QueryProp(P_RANGER_MAX_PET_LEVEL)) { 
    new_level(); 
  } else { 
    if(!random(6)) SavePet(); // speicher sparender
  }

  return ::AddExp(points);
}
