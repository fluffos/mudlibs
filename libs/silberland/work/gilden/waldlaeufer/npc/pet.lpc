#define MOD_ATTACK 1

#define NORMAL 0
#define BIEST 1

#define REDUCE_AC "reduce_ac"
#define REDUCE_WC "reduce_wc"
#define RAMMEN "rammen"
#define NO_ATTACK "no_attack"
#define SLOW "slow"
#define PBLIND "blind"
#define DEFENCE "defence"
#define NOMAGIC "nomagic"
#define BLEED "bleeding"

#define SPEED "speed"
#define SPEED_DEX "speed_dex"
