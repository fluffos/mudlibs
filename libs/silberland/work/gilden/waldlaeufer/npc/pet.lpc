int QueryBiest();
int QueryTeam();
int hand_damage(int level);
int body(int level);
int SavePet();
void SetDietime();
int QueryDietime();
varargs int new_level(int gainedLevels);

//--globale Variablen---------------------------------------------------------
private nosave int breakcounter;
private nosave int mode;
private nosave int fightmode;
private nosave int teamtime;
private nosave object owner;
private nosave int teampower;
private nosave int incarnation;
private nosave mixed* hand_base;
private nosave int hand_overwrite;
private nosave string current_tierkoenig;
