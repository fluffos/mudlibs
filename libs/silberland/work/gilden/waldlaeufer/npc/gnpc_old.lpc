/*****************************************************************************
Gilden NPC der WaldlaeuferGilde
11.08.06 - Begin
*****************************************************************************/
//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"
inherit "/p/std/npc/default_ranger_npc.lpc";
inherit "std/player/soul";
//-- Vars --------------------------------------------------------------------

//-- Prototypes --------------------------------------------------------------
void reaction2(object pl, string macher, string andere, int silent);
void reaction(object pl, string macher, string andere, int silent);
//**************************************************************************//



//** Standardfunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, GUILD_NPC_LONG);
  SetProp(P_LONG,
    "Gekleidet in einer einfachen Robe, deren Farbe sich immer dem "
    "Hintergrund anzupassen scheint, faellt es Dir nur schwer "+GUILD_NPC+" "
    "auf ein Alter zu schaetzen. Sein Gesicht zeigt keine Falten und auch in "
    "den kinnlangen schwarzen Haaren kannst Du keine graue Straehne erkennen."
    " Doch in den grossen blaugrauen Augen erkennst du eine Weisheit und ein "
    "Alter, welche scheinbar schon Jahrhunderte ueberlebt haben. Wie es fuer "
    "einen Elfen ueblich ist, ist er eher schlank, doch er wirkt laengst "
    "nicht schwaechlich.");

  SetProp(P_NAME, GUILD_NPC);
  SetProp(P_GENDER, MALE);
  AddId(({GUILD_NPC_ID, "meister", lower_case(GUILD_NPC)}));
  AddClass( ({CL_NIGHTVISION, CL_ELF}) );
  SetProp(P_ARTICLE, 0);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 205);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 50);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+"sagt: Das kann ich nicht gebrauchen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.4, DT_COLD:     -0.4, DT_WATER:      -0.5,
       DT_AIR:      -0.6, DT_LIGHTNING:-0.3, DT_EXPLOSION:  -0.2,
       DT_SOUND:     0.2, DT_LIGHT:    -0.5, DT_ELECTRIC:   -0.3,
       DT_ACID:     -0.1, DT_POISON:   -1.0, DT_TERROR:     -0.5,
       DT_HOLY:      0.1, DT_UNHOLY:    0.1, DT_MAGIC:      -0.2,
       DT_MIND:     -0.4, DT_SLASH:    -0.4, DT_BLUDGEON:   -0.4,
       DT_PIERCE:   -0.5, DT_SQUEEZE:  -0.4, DT_WHIP:       -0.3,
       DT_RIP:      -0.3,
     ]) );
  SetProp(P_MSGIN, "schleicht heran.\nRuhe erfuellt den Raum");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "tritt aus einem Schatten hervor.\nRuhe erfuellt den "
                    "Raum");
  SetProp(P_MMSGOUT, "laesst sich selbst verschwinden");
  SetProp(P_DIE_MSG,  " sagt: Gut gekaempft. Ich werde mich jetzt "
                      "zurueckziehen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Das Oberhaupt der Waldlaeufer");

  AddInfo(DEFAULT_INFO, ({
    "schweigt.\n",
    "gruebelt ueber die Frage nach.\n"
    "hat Dich scheinbar nich gehoert.\n",
    "sagt: Ich werde mich danach erkundigen.\n"}) );

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_SPELLRATE, 100);

  SetChats(1,
  ({Name(WESSEN, 1)+" Umhang weht kurz im Wind.\n",
    Name(WER, 1)+" uebt eine beruhigende Wirkung auf die Umgebung aus.\n",
    "Du glaubst "+name(WER, 1)+" hat Dich gerade angesehen.\n",
    Name(WER, 1)+" sagt: Der Wald wird wieder sicher.\n",
   }) );

  SUID;

  create_default_ranger(55,20, ({MESSER_PFAD, TIERMEISTER_PFAD}) );

  CLONEME("/p/weapon/knife/meucheldolch" );
  command("zuecke dolch");

  //CLONEME(ARMOUR "" );
  command("trage alles");
  add_soul_commands();
}

//-- Der Tod -----------------------------------------------------------------
void die(int poisondeath)
{
  ::die(poisondeath);
}

//-- Spielertode -------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  
}
//**************************************************************************//



//** GildenItems ***********************************************************//
//-- Neues Item --------------------------------------------------------------
void new_guilditem(object player) 
{
  object ob;
  int aktiv;
  
  tell_object(player, BS("Dein Koecher scheint sich zu veraendern ..."));
  if(objectp(ob=present(GUILD_OBJ_ID, player))) { aktiv=ob->query_aktiv(); }
  ob=clone_object(OBJ"koecher");
  ob->move(player, M_NOCHECK);
  if(aktiv) { ob->activate(player); }
  return;
}
//**************************************************************************//



//** Reaktionen ************************************************************//
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "versucht Dich nicht einzuschuechtern.",
        "schaut "+TP->name(WEN, 1)+" unglaeubig an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Beruhige Dich!",
        "sagt: Beruhige Dich "+TP->name(WER)+"!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->name(WEN, 1)+".");
      break;

    case "fies":
      call_out("reaction2", 2, TP,
        "Du erhebst Dich grummelnd.",
        TP->Name(WER, 1)+" erhebt sich grummelnd.", 1);
      reaction(TP,
        "weicht geschickt Deiner Beruehrung aus und schubst Dich zu Boden.",
        "weicht "+TP->name(WEM, 1)+" geschickt aus und schubst "
        +TP->name(WEN, 1)+" zu Boden.", 0);
      TP->AddHp(-5+random(5));
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt aergerlich: Lass das!",
        "sagt aergerlich: Lass das "+TP->name(WER)+"!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "hebt fragend eine Augenbraue.",
        "hebt fragend eine Augenbraue.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        (TP->QueryProp(P_GENDER)==2?"sagt: Ich bin bereits vergeben.":"sagt: "
         "Komm als Frau wieder!"),
        (TP->QueryProp(P_GENDER)==2?"sagt: Ich bin bereits vergeben.":"sagt: "
         "Komm als Frau wieder "+TP->name(WER)+"!"));
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->name(WEN, 1)+" an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht weiter.",
        "beachtet "+TP->name(WEN, 1)+" nicht weiter.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht Dich zu troesten.",
        "versucht "+TP->name(WEN, 1)+" zu troesten.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{ return StartReaction(verb, gruppe, adverb, touch); }
void reaction(object pl, string macher, string andere, int silent)
{ if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS((!silent?Name(WER, 1)+" ":"")+macher));
  tell_room(ENV(TO), BS((!silent?Name(WER, 1)+" ":"")+andere), ({pl}) ); }
void reaction2(object pl, string macher, string andere, int silent)
{ if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS((!silent?Name(WER, 1)+" ":"")+macher));
  tell_room(ENV(TO), BS((!silent?Name(WER, 1)+" ":"")+andere), ({pl}) ); }
//**************************************************************************//