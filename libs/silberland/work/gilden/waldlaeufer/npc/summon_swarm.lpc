#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

#include "../functions.h"

object owner;

#define TC_NAME 0
#define TC_MOVE 1
#define TC_DAMAGE 2
#define TC_DEBUFF 3

#define A_DISABLE_ATTACK 1
#define A_BLIND 2
#define A_FALLDOWN 3
#define A_LPBACK 4
#define A_POISION 5
mapping terrainCustomization = ([
  TT_HILL: ({"Fliegen", "schwirrt", DT_BLUDGEON, A_DISABLE_ATTACK}),
  TT_CAVE: ({"Fledermaeuse", "flattert", DT_RIP, A_BLIND}),
  TT_HOUSE: ({"Ratten", "wuselt", DT_PIERCE, A_FALLDOWN}),
  TT_FOREST: ({"Kaefer", "schwirrt", DT_RIP, A_BLIND}),
  TT_TOWN: ({"Ratten", "wuselt", DT_PIERCE, A_FALLDOWN}),
  TT_MOUNTAIN: ({"Ameisen", "wuselt", DT_RIP, A_DISABLE_ATTACK}),
  TT_DESERT: ({"Skarabaen", "krabbelt", DT_RIP, A_DISABLE_ATTACK}),
  TT_JUNGLE: ({"Moskitos", "surrt", DT_PIERCE, A_LPBACK}),
  TT_SWAMP: ({"Stechmuecken", "surrt", DT_PIERCE, A_LPBACK}),
  TT_PLAIN: ({"Fliegen", "schwirrt", DT_BLUDGEON, A_DISABLE_ATTACK}),
  TT_ARCTIC: ({"Frostmilben", "kriecht", DT_RIP, A_BLIND}),
  TT_UNDERWATER: ({"Quallen", "treibt", DT_ACID, A_POISION}),
  TT_WATER: ({"Quallen", "treibt", DT_ACID, A_POISION}),
  TT_ROAD: ({"Ameisen", "wuselt", DT_RIP, A_FALLDOWN}),
  TT_AIR: ({"Spatzen", "fliegt", DT_BLUDGEON, A_BLIND})
]);

string *powerDescription = ({"sehr klein", "klein", "mittel", "gross", "sehr gross"});

int power;

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_FRIEND, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1); 
  SetProp(P_ARTICLE, 1);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_DIE_MSG, "loest sich in viele einzelne Tiere auf und verschwindet");
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_NOATTACK, "weicht deiner Attacke aus, in dem sich die Tiere kurz aufteilen.");
  AddInfo(DEFAULT_INFO, "kann Deine Sprache nicht verstehen.\n");
  AddId(({NOCONTROL, NOWIMPY, SUMMON_ID, SKILL_NOLEARN, SUMMON_SWARM_ID, "schwarm" }));
  AddClass( ({CL_ANIMAL }) ); 
  SUID;
}

//-- Remove ------------------------------------------------------------------
int remove()
{
  if(objectp(owner)) {
     owner->RemovePursuer(TO);
     owner->RemoveDefender(TO); 
     present(GUILD_OBJ_ID, owner)->UnregisterSummon();
  }
  while(remove_call_out("remove")!=-1);
  return ::remove(); 
}

//-- Haut beim Spielertod ab -------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(objectp(owner) && (player == owner)) { 
    remove(); 
  }
}

//-- Bei ranger_npc verschwindet das Tier nicht beim Reset -------------------
void reset() 
{
  if(!is_clone(TO)) return; 
  ::reset();  

  if(objectp(owner) && !interactive(owner) && (owner->id(DEFAULT_RANGER_ID)) ) {
    return; 
  }

  remove(); 
}
//**************************************************************************//
 
//** Komunikation **********************************************************//
//-- Die Kommandos auffangen -------------------------------------------------
void catch_tell(string str)
{
  string who,target,action;
  
  if(!((query_verb() == "sag") /*|| (query_verb()[0..0] == "'")*/))return;
                              //buggt. 
  if(sscanf(str,"%s sagt: %s %s",who,target,action) != 3)      return;
  if(!id(target))                                              return;
  if(find_player(lower_case(who)) != owner)                    return;
  if(action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);
  call_out("order",0,action);
  return;
}

//-- Befehle auswerten -------------------------------------------------------
int order(string action)
{
  mixed envo, envt;
  
  if(!objectp(TO) || !objectp(owner) || !objectp(envt=ENV(TO)) || 
     !objectp(envo=ENV(owner))) {return 0;}

  if(action == "verschwinde" || action == "hau ab" || action == "verzieh dich" || action == "geh") { 
    envo->Message(BS(Name(WER, 1)+" "+QueryProp(P_MMSGOUT)+"."));
    remove();
    return 1;
  } else if(action == "kaempfe" || action == "kaempfe mit mir" || action == "kaempfe mit" || action == "hilf mir") {
    owner->Message(BS(Name(WER, 1)+" schaut Dir kurz in die Augen "
                      "und Du weist, "+QueryPronoun()+" hat verstanden.")); 
    owner->AddDefender(TO);
  } else if(action == "pause" || action == "kampfpause" || action == "stopp") { 
    envo->Message(BS(Name(WER, 1)+" hoert auf zu kaempfen.")); 
    owner->RemoveDefender(TO);
  }

  return 1;
}
//**************************************************************************//

//--Hier werden die erfahrungspunkte aufgeschlagen und ausgewertet------------
int AddExp(int points)
{ if(owner) {owner->AddExp(points/2);}
  return ::AddExp(points);}
  
//-- Wer ist der owner -------------------------------------------------------
mixed get_owner() {
  return owner;
}
  
//**************************************************************************//

public void heart_beat() {
  object ob, enemy, *enemies;

  if(!owner->InFight()) return;
  
  enemies = owner->PresentEnemies();
  if(sizeof(enemies) < 1) return;

  enemy = enemies[random(sizeof(enemies))];

  pDebug(owner, sprintf("summon_swarm :: debuffChance=20<%d enemy=%O\n", power, enemy))
  if(random(20) < power) {
    switch(QueryProp("debuff")) {
      case A_DISABLE_ATTACK:
        tell_room(ENV(TO), BS(Name(WER)+" verwirrt "+enemy->name(WEN)+"."));
        enemy->SetProp(P_DISABLE_ATTACK, 1+random(power/2));
        break;
      case A_BLIND:
        tell_room(ENV(TO), BS(Name(WER)+" blendet "+enemy->name(WEN)+"."));
        enemy->SetProp(P_BLIND, 1+random(power/2));
        break;
      case A_FALLDOWN:
        tell_room(ENV(TO), BS(Name(WER)+" bringt "+enemy->name(WEN)+" zu Fall."));
        enemy->SetProp(P_DISABLE_ATTACK, 1);
        enemy->SetProp(P_LAST_RAMMEN_TIME, time());
        break;
      case A_LPBACK:
        tell_room(ENV(TO), BS(Name(WER)+" saugt "+enemy->name(WEM)+" Blut ab."));
        owner->AddHp(power*2);
        break;
      case A_POISION:
        ob=clone_object(OBJ "npc_poison"); 
        ob->AddId(NPC_POISON_ID+"_swarm_"+getuid(owner));
        ob->move(enemy, M_NOCHECK|M_SILENT);
        ob->poison(enemy, owner, 0, random(power * 200));
        break;
    }
  }

  pDebug(owner, sprintf("summon_swarm :: damageChance=1:%d\n", 13-power));
  if(!random(13-power)) {
    call_out("damage_enemy", 0, enemy);
  }

  return;
} 

public void damage_enemy(object enemy) {
  int d;

  if(!objectp(enemy)) return;
  
  d = power*20 + random(power*30);
  d = SPELL_DAMAGE_BONUS(owner, "wilder schwarm", d);
  pDebug(owner, sprintf("summon_swarm :: damage_enemy damage=%d enemy=%O\n", d, enemy));
  enemy->Defend(d, ({QueryProp(P_DAM_TYPE)}), ([SP_PHYSICAL_ATTACK: 1, SP_SHOW_DAMAGE: 1]), this_object());
  
  return;
}

//-- Der Angriff -------------------------------------------------------------
void Attack(object enemy) {
  return; // keine Angriffe
}

private void customizePerRegion(int terrain, int power) {
  mixed *m;
  string powerAdj;

  m = terrainCustomization[terrain];
  powerAdj = powerDescription[power/2];

  SetProp(P_NAME, m[TC_NAME]+"schwarm");
  SetProp(P_SHORT, sprintf("Ein %ser Schwarm von %s", powerAdj, m[TC_NAME]));
  SetProp(P_LONG, sprintf("Ein %ser Schwarm aus %s %s hier herum.", powerAdj, m[TC_NAME], m[TC_MOVE]));
  SetProp(P_MSGIN, sprintf("%s herein", m[TC_MOVE]));
  SetProp(P_MSGOUT, m[TC_MOVE]);
  SetProp(P_DAM_TYPE, m[TC_DAMAGE]);
  SetProp(P_NAME_ADJ, powerAdj);
  SetProp(P_GENDER, MALE);
  SetProp("debuff", m[TC_DEBUFF]);

  AddId(lower_case(m[TC_NAME]));

  return;
}

public void Setup(object caster, int ability, int success, int terrain) {
  owner = caster;

  power = limit(ability/1428 + success/3333, 1, 10);
  
  customizePerRegion(terrain, power);

  AddId(SUMMON_SWARM_ID+"_"+getuid(caster));

  caster->AddPursuer(TO);
  set_heart_beat(1);

  if(RANGERMASTER->GetMasterAbility(getuid(owner)) != MASTER_ABIILITY_PERMANENT_SUMMON)
    call_out("go_away", 60*ability/1000 + random(success/1000)*30);

  present(GUILD_OBJ_ID, owner)->RegisterSummon();
}

public void go_away() {
  if(objectp(ENV(TO))) {
    tell_room(ENV(TO), BS(Name(WER)+" loest sich in alle Richtungen auf."));
  }

  remove(1);
  return;
}