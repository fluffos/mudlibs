#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Creon, ein Waldlaeufer");
  SetProp(P_LONG,
    "Die dunkle Gestalt vor Dir traegt einen etwa knoechellangen, "
    "dunklen Wollumhang, der recht abgenutzt und an den Enden ziemlich "
    "zerschlissen aussieht. Die grosse Kapuze und das schwarze Tuch "
    "um den Hals verbergen das darunter befindliche Gesicht, das Du "
    "so nur erahnen kannst.");

  AddDetail( ({ "gestalt" }),
    "Eine dunkel gekleidete Gestalt steht vor Dir.");

  AddDetail( ({ "wollumhang", "umhang" }),
    "Der Umhang sieht schon ziemlich abgenutzt aus. Seine Enden sind "
    "zerschlissen und an einigen Stellen bereits eingerissen.");

  AddDetail( ({ "wolle" }),
    "Der Umhang scheint aus dicker, warmer Wolle zu bestehen.");

  AddDetail( ({ "enden" }),
    "Dort wird die Wolle am meisten beansprucht und sieht "
    "dementsprechend abgenutzt aus.");

  AddDetail( ({ "kapuze", "tuch", "halstuch" }),
    "Die Kapuze und das Halstuch verbergen das Gesicht vollstaendig.");

  AddDetail( ({ "gesicht" }),
    "Du kannst es nur erahnen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Creon");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"creon", "waldlaeufer", "mensch"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(21);

  SetProp(P_HANDS, ({" mit blossen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 178);
  SetProp(P_WEIGHT, 75);
  SetProp(P_ALIGN, 30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Ich nehme nichts von Dir.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt von einem wichtigen Auftrag wieder");
  SetProp(P_MMSGOUT, "hat einen wichtigen Auftrag zu erledigen");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Waldlaeufer");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "beachtet Dich nicht.\n",
            "runzelt die Stirn.\n",
            "blickt Dich schweigend an.\n"}));

//  AddInfo( ({""}),
//  "",
//  "sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" lehnt sich laessig an das Gelaender.\n",
    Name(WER, 1)+" prueft eines der Holzbretter.\n",
    Name(WER, 1)+" wirft einen Blick nach unten.\n",
    Name(WER, 1)+" raeuspert sich.\n",
    Name(WER, 1)+" murmelt vor sich hin.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;

  clone_object(ARMOUR "umhang")->move(TO);
  command("zieh alles an");

//--Create Ende------------------------------------------------------------

}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schuettelt verwundert den Kopf.",
        "schuettelt verwundert den Kopf.");
      break;

    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "knurrt: Leg Dich nicht mit mir an!",
        "knurrt: Leg Dich nicht mit mir an!");
        break;

    case "frech":
      call_out("reaction", 0, TP,
        "brummt Dich unwirsch an.",
        "brummt "+TP->name(WESSEN)+" unwirsch an.");
      break;

    case "albern":
    case "froh":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Lass das lieber sein.",
        "sagt: Lass das lieber sein.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TP->name(WEN)+" gar nicht.");
      break;

    case "traurig":
    case "nett":
      call_out("reaction", 0, TP,
        "mustert Dich stumm.",
        "mustert "+TP->name(WEN)+" stumm.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

