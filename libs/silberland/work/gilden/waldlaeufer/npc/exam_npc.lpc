/*****************************************************************************
Gilden NPC der WaldlaeuferGilde
11.08.06 - Begin
*****************************************************************************/
//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

#include "/gilden/waldlaeufer/functions.h"
//-- Vars --------------------------------------------------------------------
object env, pl;
int last_time;

//-- Prototypes --------------------------------------------------------------

//**************************************************************************//



//** Standardfunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if(!is_clone(TO)) { return; }

  ::create();

  SetProp(P_SHORT, "Eine verhuellte Kaempferin");
  SetProp(P_LONG,
    "Die verhuellte Kaempferin verbirgt ihr Gesicht hinter der Kapuze, Du "
    "bist Dir nichtmal sicher ob sich ueberhaupt etwas dahinter verbirgt.");
  SetProp(P_NAME, "Kaempferin");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kaempferin", EXAM_NPC_ID}) );
  AddClass( ({CL_NIGHTVISION}) );
  SetProp(P_ARTICLE, 1);

  SetProp(P_RACE, ({"Elf", "Dunkelelf", "Troll", "Hobbit", "Zwerg", "Fee", "Oger", "Mensch"})[random(8)]);
  SetProp(P_SIZE, 168);
  SetProp(P_WEIGHT, 53000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 100);
  SetProp(P_WIMPY, 0);
  SetProp( P_REJECT, ({ REJECT_DROP, 
                        Name(WER,1)+" will @WEN nicht haben.\n" }) );
  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Angst");
  AddInfo(DEFAULT_INFO, "kaempft unbeirrt weiter.\n");
  
  // Kampfstaerke
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihren Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );
  SetProp(P_NOMAGIC, 25);
  SetProp(P_SPELLRATE, 0);
  
  SUID;
}

//-- Sterbefunktion ----------------------------------------------------------
void die(int poisondeath) {
  string s;
  object player;

  player = QueryProp(P_KILLER) || TP;

  s=GUILD_MASTER->GetExamRoom(getuid(player));
  GUILD_MASTER->SetExamRoom(getuid(player), set_bit(s, level));
  tell_object(player, BS("Du hast Dich als wuerdig erwiesen."));
  ::die(poisondeath);
  return;
}

//-- Der Spieler stirbt ------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  mixed corpse;
  
  if(objectp(player)) { player->move(GUILD_ROOM, M_SILENT); }
  if(objectp(corpse=present("Leiche")))
  { corpse->move(GUILD_ROOM, M_SILENT); }
  if(objectp(environment(TO)) && player==pl ) environment(TO)->remove();
  return;
}

//-- Init, Der NPC darf nur im exam-raum 'leben' -----------------------------
void init()
{
  ::init();
  
  if( !objectp(TO) || !objectp(env=ENV(TO)) || 
      (explode(file_name(env),":")[0] != ROOM"exam") ) { remove(); }
}

//-- Remove, schwert vernichten ----------------------------------------------
int remove(int silent)
{
  object ob;
  
  if(objectp(ob=present("langschwert"))) { ob->remove(); }
  return ::remove(silent);
}


//** PruefungsRaumfunktionen ***********************************************//
//-- Level und Staerke setzen ------------------------------------------------
void set_level(int level, object ob)
{
  int i, gl;

  level=limit(level,1,35);
  if(!objectp(ob)) { return; }
  

  create_default_npc(level);

  if(!random(2)) {
    CLONEME("/p/weapon/knife/jagdmesser");
    command_me("zuecke messer");
  } else {
    CLONEME("/p/weapon/bow/langbogen");
    command_me("zuecke bogen");
  }

  gl = ob->QueryProp(P_GUILD_LEVEL);
  SetProp(P_GUILD_LEVEL, gl);
  SetProp(P_SPELLRATE, 10+gl*2);

  switch(gl) {
    case 3:
      if(present("messer")) AddSpell(3, 100+gl*30, Name(WER)+" springt nach vorne und sticht dich mit einem Messer.\n","",DT_PIERCE,([SP_SHOW_DAMAGE:1 ]));
      if(present("bogen")) AddSpell(3, 100+gl*30, Name(WER)+" zielt kurz und schiesst auf dich.\n","",DT_PIERCE,([SP_SHOW_DAMAGE:1 ]));
    case 6:
      AddId("Messerkaempfer");
      AddId("Bogenkaempfer");
    case 9:
      AddSpell(1, 200+gl*10, Name(WER)+" verpasst dir einen harten Fusstritt.\n", "", DT_SQUEEZE, "fusstritt", ([SP_SHOW_DAMAGE: 1]));
    case 14:
      AddId("Messerexperte");
      AddId("Bogenexperte");
    case 20:
      AddId("Bogenmeister");
      AddId("Messermeister");
  }

  return;
}

public void fusstritt(object enemy) {
  enem->SetProp(P_DISABLE_SPELLS, 1+random(gl/4));
  return;
}

public  Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  if(!random(30-QueryProp(P_GUILD_LEVEL))) {
    tell_room(ENV(TO), BS(Name(WER)+" weicht geschickt aus."));
    return 0;
  }

  if(QueryProp(P_GUILD_LEVEL) > 4 && !random(25-gl)) {
    tell_room(ENV(TO), BS(Name(WER)+" spannt die Muskeln an und bewegt sich schneller."));
    ModifySkillAttribute(TO, SA_SPEED, 200, 4+random(10));
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}