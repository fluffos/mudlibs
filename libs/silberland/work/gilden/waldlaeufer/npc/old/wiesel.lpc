//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit "std/player/soul";
//zum steuern

object owner;
int service, ec; //ec -> exploartion-counter

//**************************************************************************//

  
  
//** CREATE ****************************************************************//
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Wiesel");
  SetProp(P_LONG,
    "Das Wiesel ist ein kleines und sehr bewegliches Tier aus dem Wald "
    "von Tethyr. Es kann unbemerkt umherschleichen und sogar einige Tricks "
    "von Menschen lernen.");
  SetProp(P_NAME, "Wiesel");
  SetProp(P_GENDER, NEUTER);
  AddId(({NOCONTROL, NOWIMPY, FELL_WUSCHEL, "wiesel" }));
  SetProp(P_RACE, "Tiere");
  AddClass( ({CL_ANIMAL }) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(10);
  SetProp(P_FRIEND, 1);
  SetProp(P_NOATTACK, "schaut Dich fragend an.");
  SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})   }) );
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );

  SetProp(P_MSGIN, "wieselt herein");
  SetProp(P_MSGOUT, "wieselt");
  SetProp(P_MMSGIN, "wieselt herein");
  SetProp(P_MMSGOUT, "wieselt davon");
  SetProp(P_DIE_MSG,  " wieselt davon.\n");
  SetProp(P_NOCORPSE,  1);
  SetProp(P_KILL_NAME, "Ein Betrueger");
  AddInfo(DEFAULT_INFO, "kann Deine Sprache nicht verstehen.\n");
  AddInfo(({"lilyth", "torian", "delgo"}), "quiekt.","");

  SetProp(P_SPELLRATE, 0);
  
  SetChats(1,
  ({Name(WER, 1)+" wuselt am Boden herum.\n",
    Name(WER, 1)+" verwieselt sich.\n",
   }) );

  ec=5;
  
  add_soul_commands();

}
//**************************************************************************//


//** Customize *************************************************************//
int customize(object caster)
{
  
  owner=caster;
  
  owner->AddPursuer(TO);
  
  return 1;
}
//**************************************************************************//



//** Komunikation **********************************************************//
void catch_tell(string str)
{
  string who,target,action;
  
  if(!((query_verb() == "sag") /*|| (query_verb()[0..0] == "'")*/))return;
                              //buggt. 
  if(sscanf(str,"%s sagt: %s %s",who,target,action) != 3)      return;
  if(!id(target))                                              return;
  if(find_player(lower_case(who)) != owner)                    return;
  if(action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);
  call_out("order",0,action);
  return;
}

int order(string action)
{
  object ob;
  string *s, *po, *pp;
  int i, hunt, ht;
  
  if(action == "verschwinde"  ||
     action == "hau ab"       ||
     action == "verzieh dich" ||
     action == "geh")
  { ENV(owner)->Message(BS("Das Wiesel wieselt davon."));
    call_out("remove", 0);
    return 1;}
  
  //Jagen/Sammeln
  if(action == "sammel beeren"     ||
     action == "bring mir nahrung" ||
     action == "sammel"            ||
     action == "sammele")
  { 
    hunt=owner->QueryProp(P_RANGER_LAST_HUNT);
    if( ( hunt > 3 ) && ( 1800+hunt >= time() ) )
    { //Schon 3 mal gejagt, aber Zeit noch nicht um
      owner->Message(BS("Deine Tiere werden noch nichts Essbares finden."));
      ht=(1800+hunt)-time();
      if( ht > 300 && ht <=  600 )
      { owner->Message(BS("Du musst noch kurz warten.")); }
      else if( ht > 600 && ht <= 1200)
      { owner->Message(BS("Du musst noch lang warten.")); }
      else if( ht > 1200 )
      { owner->Message(BS("Du musst noch sehr lang warten.")); }
      else
      { owner->Message(BS("Du musst noch sehr kurz warten.")); }
    }
    else if( ( hunt > 3 ) && ( 1800+hunt < time() ) )
    { //Schon 3 mal gejagt und Wartezeit ist um
      hunt=1;
      call_out("hunting", 6, hunt);
      owner->Message(BS("Das Wiesel wird jetzt fuer Dich Beeren "
                     "sammeln."));
      TO->move(ROOM "air", M_TPORT);      
    }
    else if( hunt <= 3 )
    { //Noch nicht 3 mal gejagt
      hunt++;
      call_out("hunting", 6+hunt, hunt); 
      owner->Message(BS("Das Wiesel wird jetzt fuer Dich Beeren "
                     "sammeln."));
      TO->move(ROOM "air", M_TPORT);
    }
    else
    {owner->Message(BS("Ein Fehler ist aufgetreten. Wende Dich an einen "
                    "Gildenmagier.(Wiesel/Sammeln)")); return 1;}
    return 1;
  }  
  
  //Erkunden
  if(action == "erkunde"            ||
     action == "beobachte umgebung" ||
     action == "erkunde umgebung")
  { ob=clone_object(OBJ "animal_control");
    if(!ob) {owner->Message(BS("Ein Fehler ist aufgetreten. Wende Dich an "
                               "einen Gildenmagier.")); return 1;}
    ob->move(owner, M_GET | M_SILENT);
    ob->get_control(TO);
    owner->Message(BS("Du kniest nieder und versuchst mit Deinem Geist in die"
                   " Gedanken des Wiesels einzudringen."));
    return 1;}

}
//**************************************************************************//



//** Raumerkundung *********************************************************//
int explore(string str, object controler)
{
  string res, *doors;
  object room;
  mixed map, inv;
  mapping m;
  int i;
  
  doors=({}); inv=({});
  room=ENV(TO);

  switch(str)
  {
    case "o":    str="osten";         break;
    case "w":    str="westen";        break;
    case "n":    str="norden";        break;
    case "s":    str="sueden";        break;
    case "no":   str="nordosten";     break;
    case "nw":   str="nordwesten";    break;
    case "so":   str="suedosten";     break;
    case "sw":   str="suedwesten";    break;
    case "swob": str="suedwestoben";  break;
    case "wob":  str="westoben";      break;
    case "nwob": str="nordwestoben";  break;
    case "nob":  str="nordoben";      break;
    case "noob": str="nordostoben";   break;
    case "oob":  str="ostoben";       break;
    case "soob": str="suedostoben";   break;
    case "sob":  str="suedoben";      break;
    case "su":   str="suedunten";     break;
    case "swu":  str="suedwestunten"; break;
    case "wu":   str="westunten";     break;
    case "nwu":  str="nordwestunten"; break;
    case "nu":   str="nordunten";     break;
    case "nou":  str="nordostunten";  break;
    case "ou":   str="ostunten";      break;
    case "sou":  str="suedostunten";  break;
    case "ob":   str="oben";          break;
    case "u":    str="unten";         break;
    default: str=str; break;      
  }
  
  if(ec<1)
  { call_other(controler, "remove", 0); return 1;}
  
  if(str == "schau" || str == "schaue")
  {
    res=ENV(TO)->int_long(owner, TO, 2);
    owner->Message(break_string("Du siehst Durch die Augen des Wiesels:\n"
                                +res, 78, 0, 1));
    return 1;
  }
  else
  {
    if( member(ENV(TO)->QueryProp(P_EXITS), str) )
    {
      command_me(str);
      TO->explore("schau", controler);
      ec--;
      if(ec<1)
      { call_other(controler, "remove", 0); return 1;}      
      return 1;
    }
    if(map=ENV(TO)->QueryProp(P_DOOR_INFOS))
    //P_DOOR_INFOS liefert ein array von mappings (ein mapping pro tuer, 
    //wobei key1 (mapping[1]) die richtung ist
    {
      for(i=0; i<=sizeof(map)-1; i++)
      {
        m=map[i];
        doors+=({ to_string(m[1]) });
      }
      if(member(doors, str))
      {
        command_me(str);
        TO->explore("schau", controler);
        ec--;
        if(ec<1)
        { call_other(controler, "remove", 0); return 1;}        
        return 1;
      }
    }    
  }
  
  return 1;
}

//**************************************************************************//



//** Jagen/Sammeln *********************************************************//
int hunting(int hunt)
{
  int i, k;
  object *food;
  
  if(hunt > 3)
  { owner->SetProp(P_RANGER_LAST_HUNT, time() ); }
  else
  { owner->SetProp(P_RANGER_LAST_HUNT, hunt); }
  
  food=({});  
  for(i=0; i<5; i++)
  {
    k=1+random(8);
    switch(k)
    {
      case 7..8: break;
      
      default: 
        if(k<1) {k=1;}
        if(k>6) {k=6;}
        food+=({ clone_object(FOOD "beere"+to_string(k)) });
      break;
    }    
  }
  TO->move(file_name(ENV(owner)), M_TPORT);
  for(i=0; i<=sizeof(food)-1; i++)
  {
    food[i]->move(owner, M_GET);
  }
  owner->Message(BS("Das Wiesel hinterlaesst Dir einen Teil seiner Beute. Du "
                 "erhaelst "+to_string(sizeof(food))+" Beeren."));
  //DBD("HUNT: "+to_string(hunt));
  call_out("remove", 1);
  
  return 1;  
  
}
//**************************************************************************//



//** StandartFunktionen ****************************************************//
void die(int poisondeath)
{
  if(owner) owner->SetProp(P_RANGER_LAST_ANIMAL, time());
  ::die(poisondeath);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(player == owner)
  {call_out("remove", 0);}
}
int remove()
{
  if(owner) owner->SetProp(P_RANGER_LAST_ANIMAL, time());
  if(owner) owner->RemovePursuer(TO);
  return ::remove();
}
void reset()
{
  ::reset();
  call_out("remove",0);
}
//**************************************************************************//



//** REACTIONS *************************************************************//
//--Reactions-----------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{ if(find_call_out("reaction") != -1) return;
  call_out("reaction", 0, TP, "quiekt.", "quiekt."); }

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
//**************************************************************************//