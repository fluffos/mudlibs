//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit "std/player/soul";
//zum steuern

object owner;
int service, ec; //ec -> exploartion-counter

//**************************************************************************//

  
  
//** CREATE ****************************************************************//
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Falke");
  SetProp(P_LONG,
    "Der Falke beobachtet Dich aufmerksam. Du weisst nicht woher er kommt "
    "aber gefaerlich sieht er nicht aus. Er macht eher einen friedlichen "
    "Eindruck.");
  SetProp(P_NAME, "Falke");
  SetProp(P_GENDER, MALE);
  AddId(({NOCONTROL, NOWIMPY, "falke", FEDERN_WUSCHEL }));
  SetProp(P_RACE, "Tiere");
  AddClass( ({CL_ANIMAL, CL_FLYING }) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(10);
  SetProp(P_FRIEND, 1);
  SetProp(P_NOATTACK, "schaut Dich fragend an.");
  SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})   }) );
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 8000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "landet hier");
  SetProp(P_MMSGOUT, "erhebt sich in die Luefte");
  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE,  0);
  SetProp(P_KILL_NAME, "Ein Betrueger");
  AddInfo(DEFAULT_INFO, "kann Deine Sprache nicht verstehen.\n");
  AddInfo(({"lilyth", "torian", "delgo"}), "kreischt.","");

  SetProp(P_SPELLRATE, 0);
  
  SetChats(1,
  ({Name(WER, 1)+" segelt ueber Deinen Kopf hinweg.\n",
    Name(WER, 1)+" schlaegt mit den Fluegeln.\n",
   }) );
   
  ec=5;
  
  add_soul_commands();

}
//**************************************************************************//


//** Customize *************************************************************//
int customize(object caster)
{ owner=caster;
  owner->AddPursuer(TO);SetProp(P_LONG, 
    QueryProp(P_LONG)+"Er gehorcht "+to_string(owner->Name())+".");
  return 1; }
//**************************************************************************//



//** Komunikation **********************************************************//
void catch_tell(string str)
{
  string who,target,action;
  
  if(!((query_verb() == "sag") /*|| (query_verb()[0..0] == "'")*/))return;
                              //buggt. 
  if(sscanf(str,"%s sagt: %s %s",who,target,action) != 3)      return;
  if(!id(target))                                              return;
  if(find_player(lower_case(who)) != owner)                    return;
  if(action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);
  call_out("order",0,action);
  return;
}

int order(string action)
{
  object ob;
  string *s, *po, *pp;
  int i;
  
  if(action == "verschwinde"  ||
     action == "hau ab"       ||
     action == "verzieh dich" ||
     action == "geh")
  { ENV(owner)->Message(BS("Der Falke fliegt davon."));
    call_out("remove", 0);
    return 1;}
  
  //Erkunden
  if(action == "erkunde"            ||
     action == "beobachte umgebung" ||
     action == "erkunde umgebung")
  { ob=clone_object(OBJ "animal_control");
    if(!ob) {owner->Message(BS("Ein Fehler ist aufgetreten. Wende Dich an "
                               "einen Gildenmagier.")); return 1;}
    ob->move(owner, M_GET | M_SILENT);
    ob->get_control(TO);
    owner->Message(BS("Du setzt Dich hin und versetzt Dich in den Geist des "
                      "Falken."));
    return 1;}
    
  //Lokalisieren
  s=explode(action, " ");
  if(sizeof(s)<=1) {owner->Message(BS("Wen soll der Falke suchen?")); 
                    return 1;}
  s[1]=lower_case(s[1]);
  
  if(s[0] == "finde"       ||
     s[0] == "lokalisiere" ||
     s[0] == "suche")
  {
    tell_room(ENV(TO), BS(owner->Name(WER,1)+" gibt dem Falken ein Zeichen "
                          "und dieser steigt in den Himmel hinauf.")
                          , ({owner}) );
    owner->Message(BS("Du gibst Deinem Falken ein Zeichen und er steigt"
                      " in den Himmel hinauf."));
    TO->move(ROOM "air", M_GO | M_SILENT);
    ob=find_living(s[1]);
    if(!ob) {call_out("location", 4, ob, s[1], 0); return 1;}
    else if(ob->QueryProp(P_INVIS)) 
    {call_out("location", 4, ob, s[1], 0); return 1;}
    else if(ob->QueryProp(P_PALADIN_NO_LOCATION))
    { call_out("location", 4, ob, s[1], 1); return 1; }
    else
    {
      i=10;
      po=explode(file_name(ENV(ob)), "/");
      pp=explode(file_name(ENV(owner)), "/");
      if( po[1] == pp[1] ) //selbe Region
      { i=i-2; }
      if( po[1] == "luft" ) //Region Luft findet ers natuerlich eher
      { i=i-2; }
      if( ob->QueryProp(P_SIZE) > 499 ) //Riesige erkennt er frueher
      { i=i-2; }
      call_out("location", i, ob, s[1], 2);
    }
    return 1;    
  }

}
//**************************************************************************//



//** Lokation **************************************************************//
int location(object ob, string name, int flag)
{
  string res;
  
  //Flags:
  //0 - invis, nichtvorhanden
  //1 - lokations-schutz (cain usw.)
  //2 - okay
  
  if(flag == 0)
  { owner->Message(BS(CAP(name)+" konnte nicht gefunden werden.")); }
  else if(flag == 1)
  { owner->Message(BS(CAP(name)+" ist untergetaucht und laesst sich "
                      "nicht finden.")); }
  else
  {
    TO->move(file_name(ENV(ob)), M_GO | M_SILENT);
    ENV(TO)->Message(BS("Ein Falke fiegt kurz herein, beobachtet die Umgebung"
                        " und verschwindet wieder."), MSGFLAG_VISUAL);
    res=ENV(TO)->int_long(owner, TO, 2);
    owner->Message(break_string("Ein Schmerz zuckt durch Deinen Kopf und kurz"
                                " siehst Du durch die Augen deines Falken ein"
                                " klares Bild:\n"
                                +res, 78, 0, 1));
  }
  
  call_out("remove",1);
  return 1;
}

//**************************************************************************//



//** Raumerkundung *********************************************************//
int explore(string str, object controler)
{
  string res, *doors;
  object room;
  mixed map, inv;
  mapping m;
  int i;
  
  doors=({}); inv=({});
  room=ENV(TO);

  switch(str)
  {
    case "o":    str="osten";         break;
    case "w":    str="westen";        break;
    case "n":    str="norden";        break;
    case "s":    str="sueden";        break;
    case "no":   str="nordosten";     break;
    case "nw":   str="nordwesten";    break;
    case "so":   str="suedosten";     break;
    case "sw":   str="suedwesten";    break;
    case "swob": str="suedwestoben";  break;
    case "wob":  str="westoben";      break;
    case "nwob": str="nordwestoben";  break;
    case "nob":  str="nordoben";      break;
    case "noob": str="nordostoben";   break;
    case "oob":  str="ostoben";       break;
    case "soob": str="suedostoben";   break;
    case "sob":  str="suedoben";      break;
    case "su":   str="suedunten";     break;
    case "swu":  str="suedwestunten"; break;
    case "wu":   str="westunten";     break;
    case "nwu":  str="nordwestunten"; break;
    case "nu":   str="nordunten";     break;
    case "nou":  str="nordostunten";  break;
    case "ou":   str="ostunten";      break;
    case "sou":  str="suedostunten";  break;
    case "ob":   str="oben";          break;
    case "u":    str="unten";         break;
    default: str=str; break;      
  }
  
  if(ec<1)
  { call_other(controler, "remove", 0); return 1;}
  
  if(str == "schau" || str == "schaue")
  {
    res=ENV(TO)->int_long(owner, TO, 2);
    owner->Message(break_string("Du siehst Durch die Augen des Falken:\n"
                                +res, 78, 0, 1));
    return 1;
  }
  else
  {
    if( member(ENV(TO)->QueryProp(P_EXITS), str) )
    {
      command_me(str);
      TO->explore("schau", controler);
      ec--;
      if(ec<1)
      { call_other(controler, "remove", 0); return 1;}
      return 1;
    }
    if(map=ENV(TO)->QueryProp(P_DOOR_INFOS))
    //P_DOOR_INFOS liefert ein array von mappings (ein mapping pro tuer, 
    //wobei key1 (mapping[1]) die richtung ist
    {
      for(i=0; i<=sizeof(map)-1; i++)
      {
        m=map[i];
        doors+=({ to_string(m[1]) });
      }
      if(member(doors, str))
      {
        command_me(str);
        TO->explore("schau", controler);
        ec--;
        if(ec<1)
        { call_other(controler, "remove", 0); return 1;}        
        return 1;
      }
    }    
  }
  
  return 1;
}

//**************************************************************************//



//** StandartFunktionen ****************************************************//
void die(int poisondeath)
{
  if(owner) owner->SetProp(P_RANGER_LAST_ANIMAL, time());
  ::die(poisondeath);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(player == owner)
  {call_out("remove", 0);}
}
int remove()
{
  if(owner) owner->SetProp(P_RANGER_LAST_ANIMAL, time());
  if(owner) owner->RemovePursuer(TO);
  return ::remove();
}
void reset()
{
  ::reset();
  call_out("remove",0);
}
//**************************************************************************//



//** REACTIONS *************************************************************//
//--Reactions-----------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{ if(find_call_out("reaction") != -1) return;
  call_out("reaction", 0, TP, "kreischt.", "kreischt."); }

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{ return StartReaction(verb, gruppe, adverb, touch); }

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
//**************************************************************************//