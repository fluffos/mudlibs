//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "/gilden/waldlaeufer/def.h"

inherit "std/npc";
inherit "/std/npc/spells";

#define MOD_PEACE 0
#define MOD_ATTACK 1
#define MOD_DEFEND 2

private nosave string r_owner, category;
private nosave int mode;
//mapping p;
private nosave object owner;

// From the savefile:
string category;
mapping properties;
mapping attributes;
mapping attributes_modifier;
mapping infos;
mapping libraries;

//**************************************************************************//



//** CREATE ****************************************************************//
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_FRIEND, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);  
  enable_commands();
  mode=MOD_PEACE;
  
  SUID;
}
//**************************************************************************//



//** SECOND-CREATE *********************************************************//
int second_create(object caster)
{
  int i,x;
  string *keys;
  write(sprintf("pet.c: CASTER Object: %O\n",caster));
  write(sprintf("pet.c: restoring:  %s\n",MEMBERS_PETS+(getuid(caster))));
  x=restore_object(MEMBERS_PETS+(getuid(caster)));
  write(sprintf("pet.c: Status of restore: %d\n",x));
  write(sprintf("pet.c: CATEGORY: %O\n", category));
  SetProperties(properties);
  keys=m_indices(attributes);
  for(i=sizeof(keys)-1;i>=0;i--)
    SetAttribute(keys[i], properties[keys[i]]);
  
    
  //ZUSATZFUNKTIONEN
  TO->move(ENV(caster), M_GO|M_SILENT);
  caster->AddPursuer(TO);
  caster->AddDefender(TO);
  caster->SetProp(P_RANGER_HAS_ANIMAL, 1);

  return 1;
}
//**************************************************************************//




//** Komunikation **********************************************************//
void catch_tell(string str)
{
  string who,target,action;
  
  if(!((query_verb() == "sag") /*|| (query_verb()[0..0] == "'")*/))return;
                              //buggt. 
  if(sscanf(str,"%s sagt: %s %s",who,target,action) != 3)      return;
  if(!id(target))                                              return;
  if(find_player(lower_case(who)) != owner)                    return;
  if(action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);
  call_out("order",0,action);
  return;
}

int order(string action)
{
  object *enemies;
  int i;

  if(action == "verschwinde"  ||
     action == "hau ab"       ||
     action == "verzieh dich" ||
     action == "geh")
  { tell_room(ENV(owner), BS( TO->Name()+" verschwindet."));
    call_out("remove", 0);
    return 1;}
  
  if(action == "kaempfe"         ||
     action == "kaempf"          ||
     action == "kaempfe mit"     ||
     action == "hilf mir"        ||
     action == "kaempfe mit mir")
  { tell_object(owner, BS( TO->Name()+" kaempft jetzt mit Dir zusammen."));
    owner->AddDefender(TO);
    mode=MOD_ATTACK;
    return 1; } 
    
  if(action == "pause"       ||
     action == "kampfpause"  ||
     action == "stopp")
  { tell_object(owner, BS( "Du kaempfst jetzt alleine.")); 
    owner->RemoveDefender(TO);
    mode=MOD_PEACE;
    enemies=TO->QueryEnemies()[0];
    for(i=0; i<=sizeof(enemies)-1; i++)
    { enemies[i]->StopHuntFor(TO,1);
      TO->StopHuntFor(enemies[i],1); }
    return 1; } 
  
}

//**************************************************************************//



//** StandartFunktionen ****************************************************//
mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{ 
  if(!mode=MOD_DEFEND)
  {
    return ({dam, dam_type, spell}); 
  }
  
}

void die(int poisondeath)
{
  ::die(poisondeath);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(player == owner)
  {  
    if(objectp(owner)) owner->RemovePursuer(TO);
    if(objectp(owner)) owner->RemoveDefender(TO);
    if(owner) owner->SetProp(P_RANGER_HAS_ANIMAL, 0);
    TO->move(ROOM"pet_asyl", M_TPORT);
  }
}
int remove()
{
  if(objectp(owner)) owner->RemovePursuer(TO);
  if(objectp(owner)) owner->RemoveDefender(TO);
  while(remove_call_out("remove")!=-1);
  if(owner) owner->SetProp(P_RANGER_HAS_ANIMAL, 0);
  return ::remove();
}
void reset()
{
  ::reset();
}
