//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

object owner;

//**************************************************************************//



//** CREATE ****************************************************************//
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Waldwolf");
  SetProp(P_LONG,
    "Der Waldwolf ist eine Kreatur die im Wald von Tethyr zuhause ist. Er "
    "fletscht seine Zaehne und entbloesst sein riesiges Gebiss. "
    "Das schwarze Fell ist struppig und dreckig. Der Wolf scheint schon "
    "einige Kaempfe hinter sich gebracht zu haben.");
  SetProp(P_NAME, "Wolf");
  SetProp(P_GENDER, MALE);
  AddId(({"wolf", "waldwolf", "\nranger_wolf", NOCONTROL, NOWIMPY, 
    SKILL_NOLEARN, FELL_WUSCHEL }));
  SetProp(P_RACE, "Wolf");
  AddClass( ({CL_ANIMAL, CL_NIGHTVISION }) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(15);
  SetProp(P_FRIEND, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);  
  SetProp(P_HANDS, ({" mit seinen Pfoten", QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})   }) );

  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 65000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );
     
  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "knurrt");
  SetProp(P_MMSGOUT, "folgt seinem Herren");
  SetProp(P_DIE_MSG,  " rennt davon.\n");
  SetProp(P_NOCORPSE,  1);
  SetProp(P_KILL_NAME, "Ein Waldwolf");
  AddInfo(DEFAULT_INFO, "kann Deine Sprache nicht verstehen.\n");
  AddInfo(({"lilyth", "torian", "delgo"}), "knurrt.","");

  SetProp(P_SPELLRATE, 0);
  
  SetChats(1,
  ({Name(WER, 1)+" lauert.\n",
    Name(WER, 1)+" knurrt.\n",
   }) );
  SetAttackChats(10,
  ({Name(WER, 1)+" kaempft immer wilder.\n",
    Name(WER, 1)+" attackiert von hinten.\n",
   }) );


}
//**************************************************************************//



//** Komunikation **********************************************************//
void catch_tell(string str)
{
  string who,target,action;
  
  if(!((query_verb() == "sag") /*|| (query_verb()[0..0] == "'")*/))return;
                              //buggt. 
  if(sscanf(str,"%s sagt: %s %s",who,target,action) != 3)      return;
  if(!id(target))                                              return;
  if(find_player(lower_case(who)) != owner)                    return;
  if(action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);
  call_out("order",0,action);
  return;
}

int order(string action)
{
  object *enemies;
  int i;

  if(action == "verschwinde"  ||
     action == "hau ab"       ||
     action == "verzieh dich" ||
     action == "geh")
  { ENV(owner)->Message(BS(TO->Name(WER, 1)+" senkt kurz seinen Kopf und "
                           "spurtet los."));
    TO->remove();
    return 1;}
  
  if(action == "sitz" ||
     action == "brav") 
  { ENV(owner)->Message(BS(TO->Name(WER, 1)+" zieht eine Augenbraue hoch.")); 
    return 1;}
  
  if(action == "kaempfe"         ||
     action == "kaempf"          ||
     action == "kaempfe mit"     ||
     action == "hilf mir"        ||
     action == "kaempfe mit mir")
  { ENV(owner)->Message(BS(TO->Name(WER, 1)+" knurrt kampfbereit.")); 
    owner->AddDefender(TO);
    return 1; } 
    
  if(action == "pause"       ||
     action == "kampfpause"  ||
     action == "stopp")
  { ENV(owner)->Message(BS(TO->Name(WER, 1)+" schleicht in den "
                        "Hintergrund.")); 
    owner->RemoveDefender(TO);
    enemies=TO->QueryEnemies()[0];
    for(i=0; i<=sizeof(enemies)-1; i++)
    { enemies[i]->StopHuntFor(TO,1);
      TO->StopHuntFor(enemies[i],1); }
    return 1; } 
  
}

//**************************************************************************//



//** CUSTOMIZE *************************************************************//
//-- Die schattenwoelfe ------------------------------------------------------
int shadow_wolf(object caster, int success)
{
  int level;
  
  
  // WERTE
  if(!caster) return 0;
  if(!success) return 0;
  
  owner=caster;
  
  if(success < 0) success=0;
  if(success > 10000) success=10000;
  
  level = 23; 
  level+=random(3); //min +0; max +2
  if(ENV(owner)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == 4) //FORREST
  { level+=2; } //max +2 
  
  
  //ANPASSUNG
  SetProp(P_SHORT, "Ein Schattenwolf");
  SetProp(P_LONG,
    "Der Schattenwolf ist eine furchteinfloessende Bestie, die nur von den "
    "Waldlaeufern gerufen werden kann. In alten Religionen galten sie als "
    "Diener der Totenwelt. Erkennen kannst Du nur unscharfe Umrisse und "
    "zwei leuchtende blaue Augen. Dieses Exemplar wurde von "+owner->Name()+
    " gerufen.");
  AddId(({"\nranger_shadow_wolf" }));
  SetProp(P_MSGIN, "kommt aus dem Schatten");
  SetProp(P_MSGOUT, "wird zu "+owner->Name(WESSEN)+" Schatten");
  SetProp(P_MSGIN, "kommt aus dem Schatten");
  SetProp(P_MSGOUT, "wird zu "+owner->Name(WESSEN)+" Schatten");
  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_KILL_NAME, "Ein Schattenwolf");
  AddInfo(DEFAULT_INFO, "kann Deine Sprache nicht verstehen.\n");
  AddInfo(({"lilyth", "torian", "delgo"}), "knurrt.","");
  SetProp(P_SPELLRATE, 0);
  SetChats(1,
  ({Name(WER, 1)+" heult laut.\n",
    Name(WER, 1)+" knurrt bedrohlich.\n",
   }) );
  SetAttackChats(10,
  ({Name(WER, 1)+" wird schneller.\n",
    Name(WER, 1)+" wird zu einem undurchdringlichen Schatten.\n",
   }) );
  //create_default_npc(level)- BEGIN
  SetProp(P_LEVEL, level);
  SetProp(P_ATTRIBUTES, ([A_CON: level, A_DEX: level,
                          A_STR: level, A_INT: level]));  
  SetProp(P_MAX_HP, 30+level*level);
  SetProp(P_MAX_SP, QueryProp(P_MAX_HP));
  SetProp(P_HANDS, ({" mit seinen Pfoten",
                    10*level, ({DT_BLUDGEON}) }) );
  SetProp(P_BODY, 4*level);
  SetProp(P_XP, 0);
  //create_default_npc(level) - ENDE
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)*2);
  SetProp(P_HANDS, ({" mit seinen Pfoten",
                    (QueryProp(P_HANDS)[1])+10*level, ({DT_BLUDGEON}) }) );
                    //460-530
  SetProp(P_SIZE, 200+level*3);
  SetProp(P_WEIGHT, QueryProp(P_SIZE)*10);
  SetProp(P_ALIGN, -500+random(100));
  SetProp(P_NOMAGIC, level-10); //13-17
  
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_LIGHT:     0.5, DT_TERROR:   -0.5, DT_HOLY:     -0.4, 
       DT_UNHOLY:   -0.5, DT_MAGIC:     0.3, DT_SLASH:    -0.5, 
       DT_BLUDGEON: -0.5, DT_PIERCE:   -0.5, DT_SQUEEZE:  -0.5, 
       DT_WHIP:     -0.5, DT_RIP:      -0.5 ]) );
     
  //ZUSATZFUNKTIONEN
  owner->AddPursuer(TO);
  owner->AddDefender(TO);
  
  return 1;
}

//-- Der normale Waldwolf ----------------------------------------------------
int customize(object caster, int success)
{
  int level;
  
  // WERTE
  if(!caster) return 0;
  if(!success) return 0;
  
  owner=caster;
  
  if(success < 0) success=0;
  if(success > 10000) success=10000;
  
  level =owner->QueryProp(P_GUILD_LEVEL)+3; //min 15; max 18
  level+=(success*3)/10000; //min 0; max +3
  level+=2-random(3); //min +0; max +2
  if(ENV(owner)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == 4) //FORREST
  { level+=2; } //max +2 
  
  
  //ANPASSUNG  
  SetProp(P_LONG, 
    QueryProp(P_LONG)+"Er gehorcht "+to_string(owner->Name())+".");
  //create_default_npc(level)- BEGIN
  SetProp(P_LEVEL, level);
  SetProp(P_ATTRIBUTES, ([A_CON: level, A_DEX: level,
                          A_STR: level, A_INT: level]));  
  SetProp(P_MAX_HP, 30+level*level);
  SetProp(P_MAX_SP, QueryProp(P_MAX_HP));
  SetProp(P_HANDS, ({" mit seinen Pfoten",
                    10*level, ({DT_BLUDGEON}) }) );
  SetProp(P_BODY, 4*level);
  SetProp(P_XP, 0);
  //create_default_npc(level) - ENDE
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)*3/2);
  SetProp(P_HANDS, ({" mit seinen Pfoten",
                    (QueryProp(P_HANDS)[1])+8*level, ({DT_BLUDGEON}) }) );
                    //270-450
  SetProp(P_SIZE, 180+level*3);
  SetProp(P_WEIGHT, QueryProp(P_SIZE)*300);
  SetProp(P_ALIGN, -200+random(100));
  SetProp(P_NOMAGIC, level-10); //5-15
  
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:       0.2, DT_COLD:      -0.2, DT_AIR:       -0.2, 
       DT_POISON:    -0.1, DT_TERROR:    -0.1, DT_MAGIC:      0.2 ]) );
     
  SetProp(P_MSGOUT, "schleicht hinter "+to_string(owner->Name())
                    +" hinterher" );
  SetProp(P_MMSGOUT, "folgt "+to_string(owner->Name()) );
  SetProp(P_KILL_NAME, "Ein Waldwolf");
  
  //ZUSATZFUNKTIONEN
  owner->AddPursuer(TO);
  owner->AddDefender(TO);
  
  return 1;
}

mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{ 
  Kill(enemy);
  return ({dam, dam_type, spell}); 
} //Keinerlei Verteidigung

//**************************************************************************//



//** StandardFunktionen ****************************************************//
void die(int poisondeath)
{
  if(objectp(owner)) owner->RemovePursuer(TO);
  if(objectp(owner)) owner->RemoveDefender(TO);
  ::die(poisondeath);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(player == owner)
  {TO->remove();}
}
int remove()
{
  if(objectp(owner)) owner->RemovePursuer(TO);
  if(objectp(owner)) owner->RemoveDefender(TO);
  while(remove_call_out("remove")!=-1);
  return ::remove();
}
void reset()
{
  ::reset();
  call_out("remove",0);
}
//**************************************************************************//



//** REACTIONS *************************************************************//
//--Reactions-----------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{ if(find_call_out("reaction") != -1) return;
  call_out("reaction", 0, TP, "knurrt Dich an.", "knurrt."); }

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
//**************************************************************************//