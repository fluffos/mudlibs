//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

object owner;

//**************************************************************************//



//** CREATE ****************************************************************//
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schwarzbaer");
  SetProp(P_LONG,
    "Der Schwarzbaer kommt aus dem Wald Tethyrs. Er ist sehr gross und "
    "unheimlich kraeftig. Das Fell ist schon an manchen Stellen zerissen. "
    "Der Baer lebt aber noch, er scheint viel auszuhalten.");
  SetProp(P_NAME, "Baer");
  SetProp(P_GENDER, MALE);
  AddId(({"baer", "schwarzbaer", "\nranger_bear", NOCONTROL, NOWIMPY
    , SKILL_NOLEARN, FELL_WUSCHEL }));
  SetProp(P_RACE, "Baer");
  AddClass( ({CL_ANIMAL }) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(15);
  SetProp(P_FRIEND, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);  
  SetProp(P_HANDS, ({" mit seinen Pranken", QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})   }) );

  SetProp(P_SIZE, 300);
  SetProp(P_WEIGHT, 165000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "knurrt");
  SetProp(P_MMSGOUT, "folgt seinem Herren");
  SetProp(P_DIE_MSG,  " bruellt laut und verschwindet schnell.\n");
  SetProp(P_NOCORPSE,  1);
  SetProp(P_KILL_NAME, "Ein Schwarzbaer");
  AddInfo(DEFAULT_INFO, "kann Deine Sprache nicht verstehen.\n");
  AddInfo(({"lilyth", "torian", "delgo"}), "bruellt.","");

  SetProp(P_SPELLRATE, 0);
  
  SetChats(1,
  ({Name(WER, 1)+" trottet neben Dir her.\n",
    Name(WER, 1)+" brummt.\n",
   }) );
  SetAttackChats(10,
  ({Name(WER, 1)+" faengt an zu bruellen.\n",
    Name(WER, 1)+" teilt mit seinen Pranken aus.\n",
   }) );
}
//**************************************************************************//



//** Komunikation **********************************************************//
void catch_tell(string str)
{
  string who,target,action;
  
  if(!((query_verb() == "sag") /*|| (query_verb()[0..0] == "'")*/))return;
                              //buggt. 
  if(sscanf(str,"%s sagt: %s %s",who,target,action) != 3)      return;
  if(!id(target))                                              return;
  if(find_player(lower_case(who)) != owner)                    return;
  if(action[<1..] == "\n") action = action[0..<2];
  action = lower_case(action);
  call_out("order",0,action);
  return;
}

int order(string action)
{
  object *enemies;
  int i;

  if(action == "verschwinde"  ||
     action == "hau ab"       ||
     action == "verzieh dich" ||
     action == "geh")
  { ENV(owner)->Message(BS(TO->Name(WER, 1)+" brummt leise und trottet "
                        "davon."));
    TO->remove();
    return 1;}
  
  if(action == "sitz" ||
     action == "brav") 
  { ENV(owner)->Message(BS(TO->Name(WER, 1)+" schuettelt nur den Kopf.")); 
    return 1;}
  
  if(action == "hilfe"           ||
     action == "beschuetze mich" ||
     action == "verteidige mich" ||
     action == "hilf mir")
  { ENV(owner)->Message(BS(TO->Name(WER, 1)+" stellt sich schuetzend an Deine"
                           " Seite.")); 
    owner->AddDefender(TO);
    return 1; } 
    
  if(action == "pause"       ||
     action == "kampfpause"  ||
     action == "stopp")
  { ENV(owner)->Message(BS(TO->Name(WER, 1)+" laesst Dich alleine "
                        "kaempfen.")); 
    owner->RemoveDefender(TO);
    enemies=TO->QueryEnemies()[0];
    for(i=0; i<=sizeof(enemies)-1; i++)
    { enemies[i]->StopHuntFor(TO,1);
      TO->StopHuntFor(enemies[i],1); }
    return 1; } 
  
}

//**************************************************************************//



//** CUSTOMIZE *************************************************************//
//-- Der Grizzly -------------------------------------------------------------
int shadow_wolf(object caster, int success)
{
  int level;
  
  
  // WERTE
  if(!caster) return 0;
  if(!success) return 0;
  
  owner=caster;
  
  if(success < 0) success=0;
  if(success > 10000) success=10000;
  
  level = 23; 
  level+=random(3); //min +0; max +2
  if(ENV(owner)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == 4) //FORREST
  { level+=2; } //max +2 
  
  
  //ANPASSUNG
  SetProp(P_SHORT, "Ein Grizzly");
  SetProp(P_LONG,
    "Dieser Riese des Waldes wurde "+owner->Name(WEM)+" geschickt. Die Baeren "
    "galten seit Anbeginn der Zeit als Beschuetzer des Waldes. Mit ihrer "
    "grossen Kraft sind sie in der Lage Baeume auszureissen, doch "
    "gefuerchteter sind sie wegen ihrer Zaehigkeit.");
  SetProp(P_NAME, "Grizzly");
  SetProp(P_GENDER, MALE);
  RemoveId(({"baer", "schwarzbaer"}));
  AddId(({"grizzly", "\nranger_grizzly"}));
  SetProp(P_MSGOUT, "stapft hinter "+to_string(owner->Name())
                    +" hinterher" );
  SetProp(P_MMSGOUT, "folgt "+to_string(owner->Name()) );
  SetProp(P_DIE_MSG,  " verschwindet auf einmal.\n");
  SetProp(P_KILL_NAME, "Ein Grizzly");
  //create_default_npc(level)- BEGIN
  SetProp(P_LEVEL, level);
  SetProp(P_ATTRIBUTES, ([A_CON: level, A_DEX: level,
                          A_STR: level, A_INT: level]));  
  SetProp(P_MAX_HP, 30+level*level);
  SetProp(P_MAX_SP, QueryProp(P_MAX_HP));
  SetProp(P_HANDS, ({" mit seinen Pfoten",
                    10*level, ({DT_BLUDGEON}) }) );
  SetProp(P_BODY, 4*level);
  SetProp(P_XP, 0);
  //create_default_npc(level) - ENDE
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)*3);
  SetProp(P_SIZE, 300+level*3);
  SetProp(P_WEIGHT, QueryProp(P_SIZE)*600);
  SetProp(P_ALIGN, 100+random(100));
  SetProp(P_NOMAGIC, level+6);
  
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_COLD:     -0.5, DT_WATER:      -0.2, DT_ACID:      0.2,
       DT_MAGIC:     0.2, DT_SLASH:      -0.7, DT_BLUDGEON: -0.7,
       DT_PIERCE:   -0.5, DT_SQUEEZE:    -0.7, DT_WHIP:     -0.7,
       DT_RIP:      -0.5]) );
       
  SetChats(1,
  ({Name(WER, 1)+" trottet neben Dir her.\n",
    Name(WER, 1)+" brummt.\n",
   }) );
  SetAttackChats(10,
  ({Name(WER, 1)+" faengt an zu bruellen.\n",
    Name(WER, 1)+" teilt mit seinen Pranken aus.\n",
   }) );
     
  //ZUSATZFUNKTIONEN
  owner->AddPursuer(TO);
  owner->AddDefender(TO);
  
  return 1;
}

//-- Der normale Schwarzbaer -------------------------------------------------
int customize(object caster, int success)
{
  int level;
  
  // WERTE
  if(!caster) return 0;
  if(!success) return 0;
  
  owner=caster;
  
  if(success < 0) success=0;
  if(success > 10000) success=10000;
  
  level =owner->QueryProp(P_GUILD_LEVEL)+5; //min 18; max 20
  level+=(success*3)/10000; //min 0; max +3
  if(ENV(owner)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == 4) //FORREST
  { level+=2; } //max +2 
  
  
  //ANPASSUNG  
  SetProp(P_LONG, 
    QueryProp(P_LONG)+"Er gehorcht "+to_string(owner->Name())+".");
  //create_default_npc(level)- BEGIN
  SetProp(P_LEVEL, level);
  SetProp(P_ATTRIBUTES, ([A_CON: level, A_DEX: level,
                          A_STR: level, A_INT: level]));  
  SetProp(P_MAX_HP, 30+level*level);
  SetProp(P_MAX_SP, QueryProp(P_MAX_HP));
  SetProp(P_HANDS, ({" mit seinen Pfoten",
                    10*level, ({DT_BLUDGEON}) }) );
  SetProp(P_BODY, 4*level);
  SetProp(P_XP, 0);
  //create_default_npc(level) - ENDE
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)*2);
  SetProp(P_BODY, QueryProp(P_BODY)*2);
  SetProp(P_SIZE, 280+level*3);
  SetProp(P_WEIGHT, QueryProp(P_SIZE)*500);
  SetProp(P_ALIGN, 0+random(200));
  SetProp(P_NOMAGIC, level); 
    
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:     -0.2, DT_POISON:    0.2]) );
     
  SetProp(P_MSGOUT, "stapft hinter "+to_string(owner->Name())
                    +" hinterher" );
  SetProp(P_MMSGOUT, "folgt "+to_string(owner->Name()) );
  
  //ZUSATZFUNKTIONEN
  owner->AddPursuer(TO);
  owner->AddDefender(TO);
  
  return 1;
}

void Attack(object enemy)
{ 
  return; } //Kaempft nicht mit

mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{ 
  int dam_new;
  
  if( member_array("slash",dam_type)   !=-1  ||
      member_array("pierce",dam_type)  !=-1  ||
      member_array("bludgeon",dam_type)!=-1  ||
      member_array("rip",dam_type)     !=-1  ||
      member_array("whip",dam_type)    !=-1  ||
      member_array("squeeze",dam_type) !=-1)
  {
    if(TO->QueryProp(P_NAME) == "Grizzly") 
    { 
      dam_new=dam/2;
      tell_room(ENV(TO), BS(Name(WER,1)+" faengt einen Angriff fuer "+
                          owner->Name(WEN)+" ab!\n"), ({owner}) );
      owner->Message(BS(Name(WER, 1)+" faengt einen Angriff fuer Dich ab."));
    }
    else 
    { 
      dam_new=dam/3;
      tell_room(ENV(TO), BS(Name(WER,1)+" schwaecht einen Angriff fuer "+
                          owner->Name(WEN)+" ab!\n"), ({owner}) );                          
      owner->Message(BS(Name(WER, 1)+" schwaecht einen Angriff fuer Dich "
                                     "ab."));
    }
  }
  enemy->Kill(TO);
  dam=dam-dam_new;
  
  return ({dam, dam_type, spell}); 
} 

//**************************************************************************//



//** StandartFunktionen ****************************************************//
void die(int poisondeath)
{
  if(objectp(owner)) owner->RemovePursuer(TO);
  if(objectp(owner)) owner->RemoveDefender(TO);
  ::die(poisondeath);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(player == owner)
  {TO->remove();}
}
int remove()
{
  if(objectp(owner)) owner->RemovePursuer(TO);
  if(objectp(owner)) owner->RemoveDefender(TO);
  while(remove_call_out("remove")!=-1);
  return ::remove();
}
void reset()
{
  ::reset();
  call_out("remove",0);
}
//**************************************************************************//



//** REACTIONS *************************************************************//
//--Reactions-----------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{ if(find_call_out("reaction") != -1) return;
  call_out("reaction", 0, TP, "brummt leise.", "brummt leise."); }

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
//**************************************************************************//