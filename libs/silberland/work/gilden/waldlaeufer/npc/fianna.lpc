#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Fianna Lauscht-dem-Wind");
  SetProp(P_LONG,
    "Fianna Lauscht-dem-Wind, Meisterin des Iama in der Waldlaeufergilde, "
    "verkörpert natuerliche Eleganz und tiefe Verbundenheit mit der Natur. "
    "Mit gruenen, seidigen Haaren und einem organischen Gewand fuegt sie sich "
    "perfekt in die Waldlandschaft. Ihre Augen strahlen Weisheit aus, begleitet "
    "von einem Laecheln der Freude ueber die Natur. Fianna bewegt sich anmutig, "
    "im Einklang mit den Klaengen der Umgebung. Als Lehrerin des Iama uebermittelt "
    "sie Gelassenheit und spirituelle Praesenz mit einer Stimme, die dem leisen "
    "Rascheln der Blaetter gleicht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fianna");
  SetProp(P_GENDER, FEMALE);
  AddId(({"fianna", "lauscht-dem-wind", "lauschtdemwind", "elfe", "Bogenmeister", "\nwl_iamameister"}));
  AddClass( ({CL_ELF}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit ihren Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0,
       DT_AIR:      -0.2, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:    -0.2, DT_LIGHT:    -0.2, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.2,
       DT_HOLY:     -0.1, DT_UNHOLY:    0.2, DT_MAGIC:      -0.5,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " spielt auf einer Okarina und ignoriert dich.\n");

  AddInfo( ({"iama","instrument","okarina"}),
    "Die Iama ist das Instrument der Waldlaeufer. Es wir genutzt um uralte "
    "Melodien zu spielen. Diese Kunst ist verwandt mit den Zauberliedern der "
    "Barden, aber doch anders. Das Iama selbst geht auf alte elfische Traiditionen "
    "zurueck. Wenn du dein eigenes Iama benoetigst, kannst du mich darum bitten.",
    "sagt: ");

  AddInfo( ({"melodien", "lieder"}),
    "Die Meldoien, die wir Waldlaeufer spielen, sind nicht so Komplex und "
    "variantenreich, wie die Lieder der Barden. Sie gehen auf die Zeit zurueck, "
    "als die Welt von den Unsterblichen gerade ins Sein gesungen wurde. Jede "
    "Melodie verknuepft dich also unmittelbar mit uralten Maechten.", "sagt: ");

  AddInfo( ({"barden", "bardengilde", "artyrian"}),
    "Die Bardengilde befindet sich weiter suedlich im Kristallwald. Unter "
    "der Leitung von Artyrian singen sie maechtige und komplizierte "
    "Zauberlieder. Die Bardengruenderin Tirena war sogar meine Tante.", "sagt: ");

  AddInfo( ({"tirena", "bardengruenderin"}),
     "Die Elfe Tirena hat die Bardengilde mitbegruendet. Sie war meine Tante und "
     "eine sehr talentierte Musikerin.", "sagt: ");

  AddInfo( ({"avatara", "tierkoenige", "tiergeister", "namen der avatara", "melodie der avatara"}),
    "Die Avatara sind die Tierkoenige. Die ersten ihrer Art, die die Welt geformt haben. "
    "Mit der Melodie der Avatara bitten wir um ihren Beistand. Wer ihre Namen kennt, "
    "kann sie gezielt anrufen. Die Namen selbst huetet der Gruene Mann in der Grotte im "
    "Herzen des Waldes.", "sagt: ");

  AddInfo( ({"hymne des waldes"}),
    "Die Hymne des Waldes weckt die Erinnerung und Traeume an die ersten Urwaelder. "
    "Sie bringt hervor, was schon lange bevor Menschen das Land besiedelt haben, ueberall war.", "sagt: ");

  AddInfo( ({"ode des sturms", "ode des sturmes"}),
    "Die Ode des Sturms ruft die unbaendige Kraft von Natur und Wind herbei. Ein Gewitter zieht auf "
    "und zeigt unseren Feinden die rohe, zerstoererische Macht von Wind und Wetter.", "sagt: ");

  AddInfo( ({"melodie des ostens"}),
    "Die Melodie des Ostens wurde schon von den ersten Elfen gespielt. Sie bringt laesst uns feinste "
    "Bewegungen koordinieren und erhoeht unsere Geschicklichkeit ins Unermessliche.", "sagt: ");

  AddInfo( ({"melodie der ruhe"}),
    "Die Melodie der Ruhe schenkt uns Rast und Kraft, wenn wir dies am meisten benoetigen. "
    "Sie stellt unsere Kraefte wieder her.", "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 66);
  AddSpell(3, 400, 
    Name(WER, 1) + " zielt mit einem raschen Schuss auf Dich.\n",
    Name(WER, 1) + " zielt mit einem raschen Schuss auf @WEN.\n", 
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
  
  AddDefaultSpell(2, 350, DS_PARALYZE,
    Name(WER, 1) + " tritt Dich kraeftig.\n",
    Name(WER, 1) + " tritt @WEN kraeftig.\n", 
    DT_SQUEEZE, 1);

  AddDefaultSpell(2, 400, DS_POISON, 
    Name(WER, 1) + " trifft dich mit einem Giftpfeil.\n",
    Name(WER, 1) + " trifft @WEN mit einem Giftpfeil.\n");

  AddDefaultSpell(2, 600, DS_MASS_DAMAGE,
    Name(WER, 1)+" laeuft ein paar Schritte weg und feuert eine Salve auf alle ab.\n",
    Name(WER, 1)+" laeuft ein paar Schritte weg und feuert eine Salve auf alle ab.\n",
    DT_PIERCE);

  AddDefaultSpell(2, 700, DS_MASS_DAMAGE,
    Name(WER, 1)+" spielt eine Melodie auf ihrer Okarina und Blitze schlagen um dich ein.\n",
    Name(WER, 1)+" spielt eine Melodie auf ihrer Okarina und Blitze schlagen um dich ein.\n",
    DT_LIGHTNING);

  AddSpell(1, 0, 
    Name(WER, 1)+" spielt eine ruhige Melodie auf ihrer Okarina und heilt sich.\n",
    Name(WER, 1)+" spielt eine ruhige Melodie auf ihrer Okarina und heilt sich.\n",
    DT_SOUND, "heal_self", ([SP_SHOW_DAMAGE: 0]));
  

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/bow/elfenbogen" );
  command("zuecke bogen");

  CLONEME(ARMOUR "umhang" );
  CLONEME( "/gilden/waldlaeufer/armour/okarina" );
  command("trage alles");

  AddCmd("bitte|bitt&fianna|elfe|meisterin&um&iama|okarina|instrument", "cmd_bitte", "Wen willst du um was bitten?");
}

public int cmd_bitte() {
  object iama;

  if(TP->QueryProp(P_GUILD) != "waldlaeufer") {
    command_me("sag Ich haendige ein Iama nur an Waldlaeufer aus!");
    return -1;
  }

  if(TP->QueryProp(P_GUILD_LEVEL) < 6) {
    command_me("sag "+TPN+", ich gebe dir gerne ein Iama, wenn du dich als Schueler bewiesen und in den Kreis der Waldlaeufer aufgenommen bist.");
    return -1;
  }

  if(objectp(present(IAMA_ID, TP))) {
    command_me("sag Du hast bereits eine Iama bei dir!");
    return -1;
  }

  iama = clone_object(OBJ "iama");
  if(iama->move(TP, M_GET) != 1) {
    command_me("sag Du kannst die Iama gerade nicht tragen! Komm wieder wenn du kannst.");
    return -1;
  }

  command_me("sag Hier, bitte, "+TPN+". Eine Iama fuer dich.");
  write(BS(Name(WER)+" gibt dir eine Iama."));
  say(BS(Name(WER)+" gibt "+TPN+" eine Iama."));
  return 1;

}

public void heal_self(object enemy) {
  AddHp(50+random(50));
  return;
}

public void zielschuss(object enemy) {
  SetProp(P_DISABLE_ATTACK, 3);
  SetProp(P_DISABLE_SPELLS, 3);
  call_out("zielschuss_treffer", 4, enemy);
}

public void zielschuss_treffer(object enemy) {
  tell_room(ENV(TO), BS(Name(WER, 1)+" laesst den Pfeil loss und trifft "+enemy->name(WEN)+" mitten in den Koerper!"),
            ({enemy}));
  tell_object(enemy, BS(Name(WER, 1)+" laesst den Pfeil loss und trifft dich mitten in den Koerper!"));

  enemy->Defend(800+random(400) + (200*enemy->QueryProp(P_HP)/enemy->QueryProp(P_MAX_HP)), ({DT_PIERCE, DT_MAGIC}), ([SP_SHOW_DAMAGE:1, SP_PHYSICAL_ATTACK:1]), TO);
  return;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {  
  if(!random(20)) {
    tell_room(ENV(TO), BS(Name(WER) + " weicht geschickt aus."));
    return 0;
  }

  if(enemy->QueryProp(P_HP) < enemy->QueryProp(P_MAX_HP)/2 && !random(5) && !QueryProp(P_DISABLE_ATTACK)) {
    tell_room(ENV(TO), BS("Fianna legt einen Pfeil auf ihren Bogen zielt konzentriert auf "+enemy->name(WEN)), ({enemy}));
    tell_object(enemy, BS("Fianna legt einen Pfeil auf ihren Bogen zielt konzentriert auf dich."));
    zielschuss(enemy);
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}