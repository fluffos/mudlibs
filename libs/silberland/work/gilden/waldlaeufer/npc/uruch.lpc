#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Uruch Einauge, ein alter Troll der den Kraeutergarten pflegt");
  SetProp(P_LONG,
    "Uruch Einauge ist ein imposanter, alter Troll mit einer imposanten Statur "
    "und einem auffaelligen, einzelnen Auge, das tiefes Wissen und jahrzehntelange "
    "Erfahrung widerspiegelt. Sein verwittertes, gruenes Fell und die von der Zeit "
    "gezeichneten Haende zeugen von seiner engen Verbundenheit mit der Natur. Uruch "
    "traegt einfache, aber robuste Kleidung, waehrend Ranken von Heilkraeutern seinen "
    "massiven Koerper schmuecken. Sein Anblick strahlt Ruhe und Weisheit aus, und seine "
    "behutsamen Bewegungen enthuellen die liebevolle Sorgfalt, mit der er den Kraeutergarten pflegt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Uruch");
  SetProp(P_GENDER, MALE);
  AddId(({"uruch", "einauge", "troll", "Messermeister", "\nwl_krautling"}));
  AddClass( ({CL_TROLL}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(37);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 300);
  SetProp(P_WEIGHT, 275000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.5, DT_COLD:     -0.5, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.2,
       DT_SOUND:    -0.2, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0,
       DT_ACID:     -0.2, DT_POISON:   -0.5, DT_TERROR:     -0.5,
       DT_HOLY:      0.1, DT_UNHOLY:   -0.1, DT_MAGIC:       0.1,
       DT_MIND:      0.0, DT_SLASH:     0.2, DT_BLUDGEON:    0.2,
       DT_PIERCE:    0.2, DT_SQUEEZE:   0.2, DT_WHIP:        0.2,
       DT_RIP:       0.2,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " nickt geistesabwesend.\n");

  AddInfo( ({"kraeuter","pflanzen","garten", "kraeutergarten"}),
    "Hmmmmhmmm... der Garten ist mein Schatz. Alles hier selbst gezuechtet. "
    "Kraeutersammeln ist gut fuer Koerper und Geist.",
    "sagt: ");

  AddInfo( ({"kraeutersammeln", "sichel", "kraeutersichel"}),
    "Huuuuuhomm. Du willst Kraeutersammeln? Dazu brauchst du eine Sichel. "
    "Jedem Waldlaeufer gebe ich gerne eine, fuer ein Straeusschen Wirselkraut.", "sagt: ");

  AddInfo( ({"wirselkraut"}),
    "Oh. Ja. Hmhm. Das wachst hier nicht. Darum suche ich eines. Ein weiser Kraeutermann "
    "in Tijara soll eines haben. Hat mir Anvar erzaehlt. Jaja.", "sagt: ");

  AddInfo( ({"anvar", "druiden", "druidenzirkel"}),
    "Anvar ist das Oberhaupt des Druidenzirkels. Jaja. Das ist er. Aber Druiden moegen keine "
    "Trolle. Darum bin ich hier.", "sagt: ");

  // TODO alle moeglichen Kraeuterinfos

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 66);
  AddSpell(3, 400, 
    Name(WER, 1) + " springt auf dich und sticht dich mit seiner Sichel.\n",
    Name(WER, 1) + " sprint auf @WEN und sticht mit seiner Sichel zu.\n", 
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(2, 800, 
    Name(WER, 1) + " weidet dich mit seiner Sichel aus.\n",
    Name(WER, 1) + " weidet @WEN mit seiner Sichel aus.\n", 
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
  
  AddDefaultSpell(2, 350, DS_PARALYZE,
    Name(WER, 1) + " tritt Dich kraeftig.\n",
    Name(WER, 1) + " tritt @WEN kraeftig.\n", 
    DT_SQUEEZE, 1);

  AddDefaultSpell(2, 400, DS_POISON, 
    Name(WER, 1) + " stopft dir giftige Kraeuter ins Maul.\n",
    Name(WER, 1) + " stopft @WEM giftige Kraeuter ins Maul.\n");

  AddSpell(1, 0, 
    Name(WER, 1)+" isst ein paar Heilkraeuter und sieht gleich besser aus.\n",
    Name(WER, 1)+" isst ein paar Heilkraeuter und sieht gleich besser aus.\n",
    DT_SOUND, "heal_self", ([SP_SHOW_DAMAGE: 0]));
  

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( WEAPON "troll_sichel" );
  command("zuecke sichel");

  CLONEME(ARMOUR "umhang" );
  CLONEME( "/gilden/waldlaeufer/armour/okarina" );
  command("trage alles");
}

public void heal_self(object enemy) {
  AddHp(100+random(100));
  return;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {  
  if(!random(25)) {
    tell_room(ENV(TO), BS(Name(WER) + " weicht geschickt aus."));
    return 0;
  }

  if(QuerySkillAttribute(SA_SPEED) < 150 && !random(3)) {
    tell_room(ENV(TO), BS("Uruch spannt seine Muskeln an und bewegt sich schneller!"));
    ModifySkillAttribute(TO, SA_SPEED, 150+random(151), random(10));
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}

public void give_notify(object ob) {
  object sichel;
  if(ob->id("wirselkraut")) {
    if(TP->QueryProp(P_GUILD) == "waldlaeufer") {
      if(present(SICHEL_ID, TP)) {
        command_me("sag Danke, "+TPN+". Aber du hast schon eine Sichel.");
      } else {
        sichel = clone_object(WEAPON "sichel");
        if(sichel->move(TP) != 1) {
          command_me("sag Du kannst die Sichel gerade nicht tragen.");
          sichel->remove();
          return;
        }

        ob->remove(1);
        command_me("sag Bitte! Hier hast du eine Sichel. Damit kannst du Kraeutersammeln.");
        tell_room(ENV(TO), Name(WER)+" gibt "+TPN+" eine Sichel.\n", ({TP}));
        tell_object(TP, Name(WER)+" gibt dir eine Sichel.\n");
      }
    } else {
      command_me("sag Danke! Aber ich gebe nur Waldlaeufern eine Sichel zum Kraeutersammeln.");
      ob->remove(1);
    }
  }
  return;
}
