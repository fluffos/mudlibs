#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

private void loadAnimalInfos() {
  int i, j;
  string *keys, cat;
  mapping m;

  m = PETMASTER->GetPetCategories();
  keys = m_indices(m);

  for(i=0; i<sizeof(keys); ++i) {
    for(j=1; j<sizeof(m[keys[i]]); ++j) {
      AddInfo( ({m[keys[i]][j]}),
               sprintf("Ein %s ist ein %s.", CAP(m[keys[i]][j]), CAP(keys[i])),
               "sagt: ");
    }
  }

  return;
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Zwergenwaldlaeufer Hork kuemmert sich um die Tiere");
  SetProp(P_LONG,
    "Hork ist ein gedrungener Zwerg mit kraeftigen Armen und einem dichten, "
    "rotbraunen Bart. Seine Augen blitzen intelligent, wie zwei Kohlenstuecke "
    "ueber seiner Knollnase hervor. Er ist ein meisterhafter Wildhueter und "
    "kenner der Tierwelt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hork");
  SetProp(P_GENDER, MALE);
  AddId(({"hork", "zwerg", "zwergenwaldlaeufer", "Bogenmeister", "\nwl_tiermeister"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(45);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 135);
  SetProp(P_WEIGHT, 275000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:     -0.2, DT_WATER:       0.2,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:    -0.1, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:     -0.1, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:      -0.2,
       DT_MIND:     -0.1, DT_SLASH:     0.0, DT_BLUDGEON:    0.1,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.1, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " murmelt etwas Unverstaendliches.\n");

  AddInfo( ({"tiere","tier"}),
    "Ich kuemmere mich hier um die Tiere des Waldes. Ihnen habe ich mein Leben "
    "verschrieben. Es gibt so viele verschiedene von ihnen, die unsere Tiermeister "
    "und Beschwoerer meistern koennen.",
    "sagt: ");

  AddInfo( ({"tiermeister"}),
    "Tiermeister vereinen ihren Geist mit dem ihres Jagdgefaehrten. Mit der Zaehmung "
    "kann jeder Waldlaeufer einen Tiergefaehrten haben, doch nur Tiermeister holen "
    "das Beste aus ihnen heraus!", "sagt: ");

  AddInfo( ({"tiergefaehrten", "gefaehrten", "zaehmung"}),
    "Mit der Zaehmung koennen wir Waldlaeufer Tiergefaehrten zu unseren Begleitern machen. "
    "Es lassen sich alle Arten von Woelfen, Katzen, Baeren, Riesentiere, Voegel, Spinnen, "
    "Panzertieren, Huftieren, Echsen, Insketen und Kleintieren gezaehmt werden.", "sagt: ");

  AddInfo( ({"woelfe", "hunde", "woelfen", "wolf"}),
    "Woelfe sind treue begleiter. In dieser Tierart fassen wir alle arten von Woelfen und "
    "Hundeartigen zusammen. Ein Tiermeister, der einen Wolf als Gefaehrten hat, kann seine "
    "Staerke und sein Geschick uebernehmen, und Feinden an die Kehle gehen. Der Angriff eines "
    "Wolfs kann die natuerliche Panzerung seines Gegners nachhaltig zerstoeren. Wenn dich ein "
    "Wolf im Kampf unterstuetze, dann kann er die Beine deines Gegners packen und ihn so "
    "verlangsamen.", "sagt: ");

  AddInfo( ({"katze", "katzen"}),
    "Katzen sind flinke und wendige, aber auch eigenwillige Tiere. Zu ihnen zaehlen alle "
    "Grosskatzen, wie Loewen und Tiger, bis hin zur gemeinen Hauskatze. Interessanter Weise "
    "sind sogar Hyaenen im Silberland Katzen, obwohl sie eigentlich eine ganz eigene Gattung "
    "sind. Der Angriff einer Katze fuegt blutige Verletzungen zu. Tiermeister, die sich mit "
    "einer Katze verbinden erhalten deren hohe Geschicklichkeit. Eine katze, die dich im "
    "Kampf untersuetzt wird deine Gegner fuer dich zu Fall bringen.", "sagt: ");

  AddInfo( ({"baer", "baeren"}),
   "Baeren sind Woelfen nicht unaehnlich. Zu dieser Tiergattung gehoeren Grizzlies, Schwarzbaeren, "
   "Eisbaeren und Braunbaeren, die in vielen Waeldern heimisch sind. Die Angriffe eines Baeren, "
   "der mit einem Tiermeister kaempft, schuechtern Angreifer ein, sodass sie schlechter treffen. "
   "Wenn du deinen Geist mit der 'Kraft der Tiere' mit dem Baeren verbindest, erhaeltst du "
   "dessen Ausdauer und Kraft. Ein Baer kann dich im Kampf unterstuetzen und wird dann, in einem "
   "geeigneten Moment deinen Gegner mit seinen Pranken angreifen.", "sagt: ");

  AddInfo( ({"riese", "riesentier", "grosstiere", "grosswild"}),
   "Riesentiere, oder auch Grosswild genannt, ist die Gattung, der ich alle wirklich grossen "
   "Tiere zuzaehle, wie zum Beispiel Elefanten, Nashoerner oder Bueffel. Einem Tiermeister "
   "kann ihre unglaubliche Kraft zu teil werden. Im Kampf sind bepnders die Trampelangriffe "
   "dieser Tiere gefaehrlich. Sie zerstampfen Gegner gerne unter ihren massiven Fuessen. Wenn "
   "ein Grosswild mit dir kaempft, umrundet es deine Gegner und wirbelt Staub auf, der deine "
   "Feinde blendet.", "sagt: ");

  AddInfo( ({"vogel", "voegel", "flugtiere", "gefieder", "federvieh"}),
   "Zu den Voegeln gehoert fast alles was fliegt. Also auch Fledermaeuse. Die sind ja sowas "
   "wie Vogelmaeuse, nicht? Jedenfalls alles was Federn hat mindestens. Ein Tiermeister "
   "kann die Leichtigkeit und Ausdauer dieser grazilen Tiere uebernehmen. Im Kampf fuehren sie "
   "als Attacke einen Sturzflug aus, der das Opfer bei einem guten Treffer verwirren kann. "
   "Wenn du mit einem Vogel gemeinsam kaempfst, kreist er ueber deinen Feinden und gibt dir "
   "in einem guenstigen Moment ein Signal zum Angriff, wodurch du eine Schwachstelle "
   "deiner Gegner treffen kannst.", "sagt: ");

  AddInfo( ({"spinne", "spinnen"}),
   "Ob du es glaubst oder nicht: Spinnen sind exzellente Kampfgefaehrten. Sie sind sehr flink "
   "und koennen sehr gefaehrlich fuer deine Feinde werden. Alle Arten von Achtbeinigen gehoern "
   "zu der Tiergattung. Vom Weberknecht bis zur giftigen Riesenspinne. Da sie extrem gerissen sind "
   "koennen auch Tiermeister diese Intelligenz von ihren Begleitern uebernehmen. Im Kampf kann "
   "das Gift ihres Angriffs deine Gegner verlangsamen. Wer mit einer Spinne zusammen kaempft, "
   "den wird sie im Kampf in einen dicken Kokon huellen, der vor Angriffen schuetzt. Ich wuerde "
   "sagen, Spinnen sind sehr flexible und abgerunde Kampfgefaehrten.", "sagt: ");

  AddInfo( ({"panzertier", "panzertiere"}),
   "Zu den Panzertieren zaehlt alles, was eine harte Schale hat: Schildkrueten, Schaltentiere, Krebse "
   "Hummer und so weiter. Fuer eine Tiermeisterin, die die Kraft der Panzertiere annehmen will "
   "bedeutet das einen hervorragenden Schutz, wenn seine Haut selbst zum Panzer wird. Oben drein "
   "schuetzt der Panzer dieser Tiere besondersgut, wenn ihr Kampfgeist geweckt ist. Jetzt musst du "
   "auch noch wissen, dass Panzertiere nicht gerne Angrifen. Ihre Tierattacke besteht darin sich "
   "auf deinen Schutz zu konzentrieren. Wenn du als Tiermeister mit einem Panzertier gemeinsam "
   "kaempfst, dann nutzt es Gelegenheiten, die deine Angriffe bieten, um eure Gegner umzurammen. "
   "Wie du sehen kannst sind Panzertiere sehr defensive Tiere.", "sagt: ");

  AddInfo( ({"huftier", "huftiere", "paarhufer"}),
   "Zu den Huftieren gehoeren Kuehe, Pferde, allerlei Schafe und Boecke - also alles was Hufe hat eben. "
   "Sie sind extrem ausdauernd, und diese Kraft koennen sie auch auf einen Tiermeister "
   "uebertragen. Im Kampf besteht ihre bevorzugte Attacke darin Gegner mit einem starken Stoss "
   "umzurammen. Kaempfst du mit einem Huftier zusammen, dann kann es Gelegenheiten, die du ihm "
   "bietest nutzen, um sich umzudrehen und mit seinen starken Hufen die Ruestung deiner Gegner "
   "zu zertruemmern.", "sagt: ");

  AddInfo( ({"echse", "echsen", "schuppentiere"}),
    "Als Echse bezeichnen wir alles, das Schuppen hat: Eidechsen, Warane, Krokodile, Schlangen und so weiter. "
    "Sie sind sowohl geschickt, als auch durch ihre Schuppen gut geschuetzt. Zwei Kraefte, die ein "
    "Tiermeister von ihnen uebernehmen wird. Wenn der Tiermeister von einer Echse im Kampf unterstuetzt wird, "
    "dann vergiftet ihr Biss den Feind. Egal, ob die Echse natuerliches Gift hat oder nicht. Muss wohl "
    "eine sponane Mutation sein. Jedenfalls, befiehlst du der Echse den Angriff, wird sie deine "
    "Gegner an einer empfindlichen Stelle beissen und damit verlangsamen.", "sagt: ");

  AddInfo( ({"kleintier", "kleintiere"}),
    "Kleintiere sind fast alles was klein und wuselig ist. Egal ob Eichhoernchen, Biber, "
    "Stinktier oder kleine Aeffchen. Sie zeichnen sich vorallem dadurch aus, dass sie klein und "
    "oft flauschig sind. Gerade weil sie so klein und unscheinbar sind, werden sie im Kampf "
    "gerne unterschaetzt. Zum einen kann eine Tiermeisterin von der Geschicklichkeit solcher "
    "Gefaehrten zehren. Zum andern sind ihre Angriffe praezise und gefaehrlich. Bei einer "
    "Attacke koennen sie ihren Gegner die Augen auskratzen und damit blenden. Noch besser "
    "wird es, wenn sie dich im Kampf unterstuetzen! Diese kleinen Fellknaeul erinnern uns "
    "immer wieder an unsere Bande zur Natur, wodurch unsere Zauber weniger Kraft kosten.", "sagt: ");
  
  AddInfo( ({"insekt", "insekten"}),
    "Insekten sind interessant. Manche sind sehr klein, wie Bienen oder Ameisen. Andere, wie "
    "die Sichelschrecken, koennen riesig sein. Wenn ein Tiermeister die Kraft der Insekten "
    "uebernimmt werden Koerper und Geist in Balance gestaerkt. Die Gedanken rasen mit unheimlicher "
    "Intelligenz durch den Kopf und der Koerper wird hart wie Chitin. Bei ihrer Attacke rasen "
    "Insekten um ihre Ziele herum und verwirren sie oft so sehr, dass sie weniger Spezialangriffe "
    "und zauber einsetzen. Ein Insekt, dass dich im Kampf unterstützt wirbeln sie im rechten Moment "
    "um dein Ziel herum und verwirren es, sodass es sich vielleicht sogar selbst verletzt.", "sagt: ");


//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 66);
  AddSpell(3, 400, 
    Name(WER, 1) + " schiesst mit seiner Armbrust auf dich.\n",
    Name(WER, 1) + " schiesst mit seiner Armbrust auf @WEN.\n", 
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(2, 600, 
    Name(WER, 1) + " gibt einem Wolf den Befehl dich zu attackieren.\n",
    Name(WER, 1) + " gibt einem Wolf den Befehl @WEN zu attackieren.\n", 
    DT_RIP, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(2, 350, DS_FEAR,
      Name(WER, 1) + " gibt einem Baren ein Zeichen und dieser bruellt dich furchterregend an.\n",
      Name(WER, 1) + " gibt einem Baeren ein Zeichen, der @WEN furchterregend anbruellt.\n");
  
  AddDefaultSpell(2, 350, DS_PARALYZE,
    Name(WER, 1) + " tritt Dich kraeftig.\n",
    Name(WER, 1) + " tritt @WEN kraeftig.\n", 
    DT_SQUEEZE, 1);

  AddDefaultSpell(2, 400, DS_POISON, 
    Name(WER, 1) + " gibt einer Spinne den Befehl dich zu beissen.\n",
    Name(WER, 1) + " gibt einer Spinne den Befehl @WEN zu beissen.\n");

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( WEAPON "zwerg_armbrust" );
  command("zuecke armbrust");

  CLONEME(ARMOUR "umhang" );
  command("trage alles");

  loadAnimalInfos();
}


public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {  
  if(!random(25)) {
    tell_room(ENV(TO), BS(Name(WER) + " weicht geschickt aus."));
    return 0;
  }

  if(QuerySkillAttribute(SA_SPEED) < 150 && !random(3)) {
    tell_room(ENV(TO), BS("Hork spannt seine Muskeln an und bewegt sich schneller!"));
    ModifySkillAttribute(TO, SA_SPEED, 150+random(151), random(10));
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}
