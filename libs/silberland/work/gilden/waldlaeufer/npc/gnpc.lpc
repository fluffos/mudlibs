/*****************************************************************************
Gilden NPC der WaldlaeuferGilde
11.08.06 - Begin
*****************************************************************************/
//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"
inherit "/p/std/npc/default_ranger_npc.lpc";
inherit "std/player/soul";
//-- Vars --------------------------------------------------------------------

//-- Prototypes --------------------------------------------------------------
void reaction2(object pl, string macher, string andere, int silent);
void reaction(object pl, string macher, string andere, int silent);
void fertigkeiten();
void learn_spells();
void new_guilditem();
void new_iama();
void new_sichel();
//**************************************************************************//



//** Standardfunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, GUILD_NPC_LONG);
  SetProp(P_LONG,
    "Gekleidet in einer einfachen Robe, deren Farbe sich immer dem "
    "Hintergrund anzupassen scheint, faellt es Dir nur schwer "+GUILD_NPC+" "
    "auf ein Alter zu schaetzen. Sein Gesicht zeigt keine Falten und auch in "
    "den kinnlangen schwarzen Haaren kannst Du keine graue Straehne erkennen."
    " Doch in den grossen blaugrauen Augen erkennst du eine Weisheit und ein "
    "Alter, welche scheinbar schon Jahrhunderte ueberlebt haben. Wie es fuer "
    "einen Elfen ueblich ist, ist er eher schlank, doch er wirkt laengst "
    "nicht schwaechlich.");

  SetProp(P_NAME, GUILD_NPC);
  SetProp(P_GENDER, MALE);
  AddId(({GUILD_NPC_ID, "meister", lower_case(GUILD_NPC)}));
  AddClass( ({CL_NIGHTVISION, CL_ELF}) );
  SetProp(P_ARTICLE, 0);

  create_default_npc(50);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 205);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 50);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+"sagt: Das kann ich nicht gebrauchen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.4, DT_COLD:     -0.4, DT_WATER:      -0.5,
       DT_AIR:      -0.6, DT_LIGHTNING:-0.3, DT_EXPLOSION:  -0.2,
       DT_SOUND:     0.2, DT_LIGHT:    -0.5, DT_ELECTRIC:   -0.3,
       DT_ACID:     -0.1, DT_POISON:   -1.0, DT_TERROR:     -0.5,
       DT_HOLY:      0.1, DT_UNHOLY:    0.1, DT_MAGIC:      -0.2,
       DT_MIND:     -0.4, DT_SLASH:    -0.4, DT_BLUDGEON:   -0.4,
       DT_PIERCE:   -0.5, DT_SQUEEZE:  -0.4, DT_WHIP:       -0.3,
       DT_RIP:      -0.3,
     ]) );
  SetProp(P_MSGIN, "schleicht heran.\nRuhe erfuellt den Raum");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "tritt aus einem Schatten hervor.\nRuhe erfuellt den "
                    "Raum");
  SetProp(P_MMSGOUT, "laesst sich selbst verschwinden");
  SetProp(P_DIE_MSG,  " sagt: Gut gekaempft. Ich werde mich jetzt "
                      "zurueckziehen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Das Oberhaupt der Waldlaeufer");

  AddInfo(DEFAULT_INFO, ({
    "schweigt.\n",
    "gruebelt ueber die Frage nach.\n",
    "hat Dich scheinbar nicht gehoert.\n",
    "sagt: Ich werde mich danach erkundigen.\n",
    "tippt sich nachdenklich an die Stirn.\n",
    "sagt: Ich werde meine Spaeher danach fragen.\n",
    "sagt: Die Tiere des Waldes kennen auch keine Antwort darauf.\n"}) );

  AddInfo( ({"waldlaeufer","gilde","gemeinschaft","waldlaeufern"}),
    "Ich bin der Anfuehrer der Waldlaeufer. Wir verteidigen die Natur und Schuetzen die "
    "Wildnis. Wir bewegen uns wie Schatten durch die Waelder, kennen die Melodien aus "
    "uralter Zeit, jedes Kraut und jede Pflanze. Die Tiere und Geister des Waldes sind "
    "unsere Verbuendeten. In unserer Gemeinschaft gibt es kein Zoegern, wenn getan werden "
    "muss, was getan werden muss. Die Flamme von Tethyr naehrt unsere Kraft, wie wir mit "
    "unserem Leben ihre Kraft naehren. So lange noch einer von uns im Silberland wandelt, "
    "so lange wird die Widlnis siegen. Wenn du wissen willst, wie du uns beitreten kannst, "
    "frag mich nach 'beitritt'.",
    "sagt: ");

  AddInfo( ({"beitritt","beitreten"}),
    "Du willst dich also als einer der Waldlaeufer beweisen? Also gut. Zuerst musst du wissen, "
    "dass ein jeder aus unseren Reihen seine eigenen Gruende hat ein Waldlaeufer zu werden. "
    "Was uns allen gemein ist, ist, dass jeder von uns einen Erzfeind hat - eine Rasse, die "
    "er oder sie besonders zu ihrem Feind erwaehlt und mit grosser Inbrunst verfolgt. Weiters "
    "muss jeder Waldlaeufer ohne zu zoegern meinem Befehl gehorchen. Wenn ich dir sage 'toete', "
    "dann toetest du. Wenn ich dir sage 'lauf', dann laeufst du. Verstanden? Gut.\nWenn du also "
    "bereit bist in unsere Reihen einzutreten, dann sei dir bewusst, dass du zuerst einige Zeit "
    "als Anwaerter im Rang eines Schuelers beginnst. Du kannst dich beweisen und zeigen, dass "
    "du aus dem richtigen Holz geschnitzt bist.\nUm ein Schueler zu werden, musst du zuerst "
    "beweisen, dass du meine Zeit wert bist. Dazu musst du die Pruefung von Tenobaal im Dschungel "
    "bestehen und den 'Wettkampf der Bogenschuetzen' gewinnen. Ebenso musst du mindestens Stufe 10 "
    "erreicht, eine Geschicklichkeit von 10 und eine Intelligenz von 7 haben. Wenn du dann soweit "
    "bist, waehle hier deinen Erzfeind (<waehle erzfeind>) und dann kannst du uns beitreten "
    "(trete gilde bei).",
    "sagt: ");
  
    AddInfo( ({"erzfeind","feinde","erzfeinde"}),
    "Wir Waldlaeufer haben viele Feinde, die die Natur und die Wildnis bedrohen. Doch jeder von "
    "uns weilt eine Art von Gegnern als Erzfeind aus. Ueber die Zeit erlangen wir mehr und mehr "
    "wissen ueber unsere Erzfeinde und werden so besser darin sie zu toeten. Die Wahl des richtigen "
    "Erzfeindes ist sehr wichtig. Mir ist egal warum du genau diese Feinde zu deinen Erzfeinen "
    "auserwaehlst. Es ist nur wichtig, dass du einen hast.\nWaehle weise wer deinen Zorn verdient!",
    "sagt: ");

  AddInfo( ({"rang","raenge","kreis","grad"}),
  "Die Gemeinschaft der Waldlaeufer gliedert sich in vier Kreise zu jeweils fuenf Graden\n."
  "Der Erste ist der 'Kreis der Schueler'. Dort beginnen Waldlaeufer ihre Laufbahn. Hier erlernst "
  "du grundlegende Faehigkeiten, die jeder Waldlaeufer beherrscht. Du hast Zeit wichtige Aspekte "
  "unserer Gemeinschaft zu erkunden. Ebenso erlernst du grundlegende Verteidigungen und Angriffe, "
  "sowohl mit dem Messer, als auch mit dem Bogen. Dieser Kreis dient dazu deine Eignung zu pruefen.\n"
  "Der zweite Kreis ist der 'Kreis der Waldlaeufer'. Jene die den fuenften Rang der Schueler erlangt "
  "und alle meine Pruefungen bestanden haben werden vollends als Teil der Gemeinschaft anerkannt. "
  "Als Waldlaeufer entscheidest du dich welchem der Pfade du folgen wirst, und damit bestimmst du welche "
  "Rolle du in unsererem Verbund einnehmen wirst.\n"
  "Der dritte Kreis ist der 'Kreis der Hueter'. Jene Waldlaeufer, die sich als besonders geeigent "
  "erwiesen haben werden in diesen Kreis aufgenommen. Sie sind besonders faehig und fuehren unsere "
  "Spaeher an.\n"
  "Der vierte und letzte ist der 'Kreis der Meister'. Nur jene, die besonders vertrauenswuerdig "
  "und besonders Faehig in unseren Kuensten sind werden in ihn aufgenommen. Als Meister bist du am "
  "Pfad zur endgueltigen Vollendung.",
  "sagt: ");

  AddInfo( ({"flamme","feuer","flamme von tethyr"}),
    "Die Flamme von Tethyr die hier brennt ist eng mit der Lebenskraft des Waldes, ja aller Waelder "
    "und wilden Tiere verbunden. Wir beziehen unsere Macht von ihr und mit dem Beitritt in unsere Reihen "
    "zehrt auch sie von deiner Lebenskraft. Als Waldlaeufer gehoert es zu unseren Aufgaben die Flamme "
    "zu schuetzen und zu verbreiten.",
    "sagt: ");

  AddInfo( ({"pfad","pfade"}),
    "Wenn man in den Kreis der Hueter aufsteigt, dann kann man zwei Pfade waehlen denen man "
    "folgt. Diese Pfade stellen unsere Spezialisierungen dar und zeigen was deine Aufgabe in unserer "
    "Gemeinschaft ist. Es gibt den Pfad des Bogens, den Pfad der Messer, den Pfad der Tiermeister, "
    "den Pfad des Iama und den Pfad der Beschwoerer mit <hilfe wl_pfade> kannst du mehr dazu erfahren.",
    "sagt: ");

  AddInfo( ({"iama","okarina"}),
    "Fianna Lauscht-dem-Wind ist die Meisterin der Melodien unter uns Waldlaeufern. Wenn du mehr "
    "ueber die uralten Melodien wissen willst, die wir spielen koennen, dann wende dich an sie. "
    "Sie kann dir, wenn du ein Waldlaeufer bist, ebenso dein Iama, dein Instrument, ueberreichen, sobald "
    "du dafuer bereit ist. Du findest sie suedlich von hier.",
    "sagt: ");

  AddInfo( ({"kaeuter","kraeuterkunde","kraeutersammeln"}),
    "Das Kraeutersammeln ist eine wichtige Kunst fuer uns. Mit einer Kraeutersichel kannst du "
    "in Waeldern nach Heilkraeutern suchen. Obwohl sie erst mit der Kraeutermixtur, die du "
    "am Ende deiner Waldlaeuferausbildung im fuenften Rang der Waldlaeufer erlerns, ihre volle "
    "Wirkung entfalten, sind sie bereits davor nuetzlich. Die gesammelten Heilkraeuter koennen "
    "die im Notfall das Leben retten.",
    "sagt: ");
  
  AddInfo( ({"sichel","kraeutersichel"}),
    "Uruch Einauge, den du im Kraeutergarten suedwestlich von hier findest, kann dir eine "
    "Kraeutersichel aushaendigen, wenn du eine benoetigst. Er weiss ebenso viel ueber die "
    "Kraeuter, die du finden kannst.",
    "sagt: ");

  AddInfo( ({"fallen","fallenguertel"}),
    "Im Arsenal unserer Spaeher sind Fallen und andere nuetzliche Werkzeuge unersetzlich. "
    "Deine erste Falle wirst du im fuenften Rang der Schueler erlernen. Die Fallen und "
    "andere nuetzliche Werkzeuge, sowie eine Grundausruestung kannst du von unserem Zeugmeister "
    "Thurandul Duesterschatten in seiner Werkstatt oestlich von hier erhalten. Er kann dir "
    "auch einen Fallenguertel geben und auffuellen, den du zum errichten von Fallen benoetigst.",
    "sagt: ");

  AddInfo( ({"bogen","bogenkampf","messer","messerkampf"}),
    "Neben dem Messer ist der Bogen die zweite Waffe mit der wir Waldlaeufer kaempfen. Jeder "
    "hat seine eigenen Pfaeferenzen welche der Waffen er bevorzugt. Messer sind wendiger, schneller "
    "und flinker, doch verursachen in der Regel weniger Schaden. Der Bogen dagegen ist eine Waffe "
    "fuer geduldige Scharfschuetzen. Die Pfade der Messer und des Bogens vertiefen diese "
    "Kampffertigkeit noch weiter.",
    "sagt: ");

  AddInfo( ({"koecher","grauer koecher","grauem koecher"}),
    "Der graue Kocher ist das Erkennungszeichen unserer Gilde. Er haelt nicht nur deine Pfeile, "
    "wenn du mit dem Bogen kaempfst, sodern hat auch weitere nuetzliche Funktionen, die du mit "
    "<wlhilfe> einsehen kannst. Wenn du deinen verloren hat oder einen neuen benoetigst, frag "
    "mich nach 'neuem koecher'.",
    "sagt: ");

  AddInfo( ({"pruefung","raum der pruefung"}),
    "Um einen Rang aufzusteigen musst du deine Kampfkraft, Mut und Loyalitaet beweisen. Dazu "
    "musst du dich im Raum der Pruefung einem anderen Waldlaeufer, meist von viel hoeherem Rang, "
    "stellen. Du wirst nie wissen gegen wen du antrittst. Wenn du bereit bist zur Pruefung "
    "anzutreten, dann <fordere pruefung>.",
    "sagt: ");
  
  AddInfo( ({"fertigkeitspunkte","skillpunkte","talente"}),
    "Auf den Gildenstufen 2, 5, 8, 11, 14, 16, 18 und 20 erhaeltst du jeweils einen "
    "Fertigkeitspunkt. Mit diesem kannst du dich auf bestimmte Fertigkeiten spezialisieren. "
    "Wenn du soweit bist kannst du hier mit <lerne fertigkeiten> deine Punkte verteilen. Mit "
    "<verlerne fertigkeiten> kannst du diese Auswahl jederzeit aufheben. Dies kostet "
    "dich jedoch zunehmend mehr.",
    "sagt: ");

  AddInfo( ({"fertigkeiten","faehigkeiten"}),         CLOSURE(fertigkeiten));
  AddInfo( ({"zauber"}),                              CLOSURE(learn_spells));
  AddInfo( ({"neuer koecher", "neuem koecher"}),      CLOSURE(new_guilditem));  

  SetProp(P_SPELLRATE, 0);

  SetChats(1,
  ({Name(WESSEN, 1)+" Umhang weht kurz im Wind.\n",
    Name(WER, 1)+" uebt eine beruhigende Wirkung auf die Umgebung aus.\n",
    "Du glaubst "+name(WER, 1)+" hat Dich gerade angesehen.\n",
    Name(WER, 1)+" sagt: Der Wald wird wieder sicher.\n",
    Name(WER, 1)+" spricht kurz mit einem Eichhoernchen, das zu ihm gelaufen kommt.\n",
    "Ein Waldlaeufer kommt herein und erhaelt von "+name(WEM)+" einen Auftrag.\n",
    "Ein Falke landet am Arm von "+name(WEM)+" und stoesst sich kurz danach wieder ab.\n",
    Name(WER)+" krault seinen Tiger am Kopf.\n",
    Name(WER)+" sagt: Wir treten fuer den Schutz der Waelder ein.\n",
    Name(WER)+" nickt dir kurz zu.\n"
   }) );

  SUID;

  create_default_ranger(55,20, ({MESSER_PFAD, TIERMEISTER_PFAD}), "tiger" );

  CLONEME("/p/weapon/knife/meucheldolch" );
  command("zuecke dolch");

  CLONEME(ARMOUR "umhang" );
  CLONEME("/p/armour/armour/mithrilpanzer");
  CLONEME("/p/armour/bracers/mithrilarmschienen");
  CLONEME("/p/armour/trousers/lederhose");
  command("trage alles");
  add_soul_commands();
}

//-- Der Tod -----------------------------------------------------------------
void die(int poisondeath)
{
  ::die(poisondeath);
}

//-- Spielertode -------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  
}
//**************************************************************************//



//** Fertigkeiten/Zauber ausgeben ******************************************//
//-- fertigkeiten ------------------------------------------------------------
void fertigkeiten()
{
  if(!IsRanger(this_player()))
  {
    write(BS("Das geht nur als Waldlaeufer!"));
    return;
  }
  
  write(GUILD_ROOM->fertigkeiten(TP));
}
//-- erlernbare Zauber -------------------------------------------------------
void learn_spells()
{ write (GUILD_ROOM->get_zauberliste()); }
//**************************************************************************//



//** GildenItems ***********************************************************//
//-- Neues Item --------------------------------------------------------------
void new_guilditem() 
{
  object ob, player;
  int aktiv;
  
  if(!objectp(player=TP)) return;
  
  if(!IsRanger(player))
  {
    write(BS("Das geht nur als Waldlaeufer!"));
    return;
  }
  
  tell_object(player, BS("Dein Koecher scheint sich zu veraendern ..."));
  if(objectp(ob=present(GUILD_OBJ_ID, player))) { aktiv=ob->query_aktiv(); }
  ob=clone_object(OBJ"koecher");
  ob->move(player, M_NOCHECK);
  if(aktiv) { ob->activate(player); }
  return;
}

//-- Neue Iama ---------------------------------------------------------------
void new_iama() 
{
  object ob, player, env;
  int lvl, flag;
  
  if(!objectp(player=TP)) return;
  
  if(!IsRanger(player))
  {
    write(BS("Das geht nur als Waldlaeufer!"));
    return;
  }
  
  lvl=GUILD_SPELLBOOK->get_spell_use_guild_level(ZAEHMUNG);
  if(lvl > player->QueryProp(P_GUILD_LEVEL))
  {
    write(BS("Du kannst die Iama nur fordern wenn Dein Rang fuer die "
          "'Zaehmung' reicht!"));
    return;
  }
  if(objectp(ob=present(IAMA_ID, player)))
  {
    flag=1;
    ob->remove(1);
  }
  ob=clone_object(OBJ"iama");
  ob->move(player, M_NOCHECK);
  write(BS(flag?"Deine Iama blitzt kurz silbern auf.":GUILD_NPC+" gibt Dir "
        "eine Iama."));
  if(!flag && objectp(env=environment(TO)))
  {
    tell_room(env, BS(GUILD_NPC+" drueckt "+TP->name(WEM)+" etwas in die "
                   "Hand."), ({player}));
  }
  command("ja "+lower_case(getuid(TP)));
  return;
}

//-- Neue Sichel -------------------------------------------------------------
void new_sichel() 
{
  object ob, player, env;
  int lvl, flag;
  
  if(!objectp(player=TP)) return;
  
  if(!IsRanger(player))
  {
    write(BS("Das geht nur als Waldlaeufer!"));
    return;
  }
  
  if(objectp(ob=present(SICHEL_ID, player)))
  {
    flag=1;
    ob->remove(1);
  }
  ob=clone_object(WEAPON"sichel");
  ob->move(player, M_NOCHECK);
  write(BS(flag?"Deine Sichel blitzt kurz gruen auf.":GUILD_NPC+" gibt Dir "
        "eine Sichel."));
  if(!flag && objectp(env=environment(TO)))
  {
    tell_room(env, BS(GUILD_NPC+" drueckt "+TP->name(WEM)+" etwas in die "
                   "Hand."), ({player}));
  }
  command("ja "+lower_case(getuid(TP)));
  return;
}
//**************************************************************************//



//** Reaktionen ************************************************************//
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "versucht Dich nicht einzuschuechtern.",
        "schaut "+TP->name(WEN, 1)+" unglaeubig an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Beruhige Dich!",
        "sagt: Beruhige Dich "+TP->name(WER)+"!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->name(WEN, 1)+".");
      break;

    case "fies":
      call_out("reaction2", 2, TP,
        "Du erhebst Dich grummelnd.",
        TP->Name(WER, 1)+" erhebt sich grummelnd.", 1);
      reaction(TP,
        "weicht geschickt Deiner Beruehrung aus und schubst Dich zu Boden.",
        "weicht "+TP->name(WEM, 1)+" geschickt aus und schubst "
        +TP->name(WEN, 1)+" zu Boden.", 0);
      TP->AddHp(-5+random(5));
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt aergerlich: Lass das!",
        "sagt aergerlich: Lass das "+TP->name(WER)+"!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "hebt fragend eine Augenbraue.",
        "hebt fragend eine Augenbraue.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        (TP->QueryProp(P_GENDER)==2?"sagt: Ich bin bereits vergeben.":"sagt: "
         "Komm als Frau wieder!"),
        (TP->QueryProp(P_GENDER)==2?"sagt: Ich bin bereits vergeben.":"sagt: "
         "Komm als Frau wieder "+TP->name(WER)+"!"));
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->name(WEN, 1)+" an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht weiter.",
        "beachtet "+TP->name(WEN, 1)+" nicht weiter.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht Dich zu troesten.",
        "versucht "+TP->name(WEN, 1)+" zu troesten.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{ return StartReaction(verb, gruppe, adverb, touch); }
void reaction(object pl, string macher, string andere, int silent)
{ if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS((!silent?Name(WER, 1)+" ":"")+macher));
  tell_room(ENV(TO), BS((!silent?Name(WER, 1)+" ":"")+andere), ({pl}) ); }
void reaction2(object pl, string macher, string andere, int silent)
{ if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS((!silent?Name(WER, 1)+" ":"")+macher));
  tell_room(ENV(TO), BS((!silent?Name(WER, 1)+" ":"")+andere), ({pl}) ); }
//**************************************************************************//

void catch_tell(string str) {
  string wer, was;
  mixed res;
  mapping cond;
  int blood_status;
  int flag;
  if(sscanf(str, "%s teilt Dir mit: %s\n", wer, was)!=2) return ;
  if(!TI || lower_case(wer) != getuid(TI)) return ;
  if(TI->QueryProp(P_GUILD)!=GUILDNAME) return;

  gl = TI->QueryProp(P_GUILD_LEVEL);

  if(was == "erhoehe") {
    res=call_other("/gilden/waldlaeufer", "check_advance", TI);
    if(stringp(res))
      TI->Message(BSA(res, "Raziel teilt Dir mit: "), MSGFLAG_TELL);
    else 
      TI->Message(BSA("Du hast dich bewiesen. Komm her und lass mich dich pruefen!", 
            Name(WER)+" teilt Dir mit: "), MSGFLAG_TELL);
  }
 /* else if(was == "fertigkeiten") {
    res=call_other(GUILD_ROOM, "skill_string", TI);
    tell_object(TI,"Dunkelheit umfaengt Dich und Du erkennst folgendes:\n\n");
    tell_object(TI, res);
    tell_object(TI, "Die Dunkelheit loest sich auf.\n");
  }*/
  TP->AddSp(-random(5) - TI->QueryProp(P_GUILD_LEVEL));
  return;
}
