//-- Create ------------------------------------------------------------------
void create()
{
  if(is_clone(TO))
  { destruct(TO); return; }

  return;
}
//-- Int-Begrenzer -----------------------------------------------------------
int limit(int i, int min, int max)
{
  if(i<min) {i=min;}
  if(i>max) {i=max;}
  return i;
}

