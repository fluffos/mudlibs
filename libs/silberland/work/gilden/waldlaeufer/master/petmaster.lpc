//** INHERIT + INCLUDE + DEFINE ********************************************//
#include "../def.h"

#define BOREON "boreon"
#define TEKKI "tekki"
#define ANKSUNAMUN "ank'su'namun"

//--Vars----------------------------------------------------------------------
string *woelfe, *katzen, *voegel, *spinnen, *kleintiere, *riesen, *insekten;
string *panzertiere, *huftiere, *baeren, *echsen, *chamaeleon;
mixed all;
mapping legends;
//--Prototypes----------------------------------------------------------------


