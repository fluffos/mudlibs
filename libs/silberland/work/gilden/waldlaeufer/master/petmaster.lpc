//** CREATE ****************************************************************//
//--Have to be----------------------------------------------------------------
void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }
  
  legends=([BOREON:0,TEKKI:0,ANKSUNAMUN:0]);

  seteuid(getuid(this_object()));

//Die Tier-Kategorien (!!!erstes element nie aendern!!!)
  woelfe=({"wolf", "schakal", "wolfshund", "werwolf", "polarwolf", 
          "schneewolf", "sandwolf", "hund", "hunde", "waldwolf", "eiswolf"});
  katzen=({"katze", "katzen", "tiger", "wildkatze","puma", "raubkatze",
           "schneeleopard", "sandloewe", "sandtiger", "loewe", "leopard", 
           "gepard", "panther", "jaguar"});  
  baeren=({"baer", "schwarzbaer", "grizzly", "eisbaer", "baeren", 
           "grizzlys", "braunbaer", "ameisenbaer"});  
  riesen=({"riese", "nashorn", "mammut", "elefant", "bueffel", "nashoerner", "gorilla"});
  voegel=({"vogel", "fledermaus", "voegel", "schleiereule", "waldkauz", 
           "eule", "spechte", "specht", "baumschreier", 
           "buntfalke", "silberfalke", "sperber", "steinadler", "wanderfalke"
         , "rothe", "falke", "geier", "uhu", "adler"});
  spinnen=({"spinne", "spinnentier", "skorpion", "riesenspinne", "tarantel"});
  panzertiere=({"panzertier", "schalentier", "krustentier", "krebs", 
                "schildkroete", "hummer", "sandkrebs"});
  huftiere=({"huftier", "pferd", "kamel", "esel", "rind","steinboecke","steinbock",
             "hirsch", "reh", "stier", "elch", "rentier", 
             "zebra", "schwein", "einhorn", "antilope", "kuh", "gnu", "kuehe"
           , "bock", "ziege", "boecke", "ziegen", "tapir"});
  echsen=({"echse", "schlange", "riesenechse", "eidechse",
           "krokodil", "alligator", "todesviper", "kobra", "schlangen", 
           "echsen", "vipern", "kobras", "viper", "frosch"});
  kleintiere=({"kleintier", "affe" , "otter", "biber", 
               "fuchs", "erdmaennchen", "frettchen", "waschbaer", 
               "dachs", "marder", "stinktier", "mungo", "hase", "eichhoernchen",
               "marder", "wiesel", "maulwurf", "ratte", "maus"});
  insekten=({"insekt","ameise","libelle","biene","wespe","kaefer"});
  all=({woelfe, katzen, baeren, riesen, voegel, spinnen, panzertiere, 
        huftiere, echsen, kleintiere,insekten});

  return;
}
//**************************************************************************//



//** LegendaereTiere *******************************************************//
//-- Das Tier registrieren ---------------------------------------------------
int SetLegend(object legend)
{
  string s;
  s=lower_case(to_string(legend->QueryProp(P_NAME)));
  legends[s, 0]=to_string(legend);
  return 1;
}

//-- Kann das Tier gerufen werden? -------------------------------------------
int QueryLegend(object caster, string s)
{
  object ob;
  mixed value;
  int i;
  
  s=lower_case(s);
  switch(s)
  {
    case BOREON:     i=caster->QueryProp(P_RANGER_NEXT_BOREON);     break;
    case TEKKI:      i=caster->QueryProp(P_RANGER_NEXT_TEKKI);      break;
    case ANKSUNAMUN: i=caster->QueryProp(P_RANGER_NEXT_ANKSUNAMUN); break;
  } 
  if(i>=time()) 
  { tell_object(caster, BS("Du kannst "+CAP(s)+" noch nicht rufen. Du musst "
                        "noch warten."));
    return 0;}
  if(member( m_indices(legends) , s) == -1) 
  { tell_object(caster, BS("Dieses Tier gibt es nicht."));
    return 0;}
  value=legends[s, 0]; if(value==0) {return 1;}
  if(find_object(to_string(value))) 
  { tell_object(caster, BS("Du kannst "+CAP(s)+" nicht rufen. "+CAP(s)+" "
                        "wird noch gebraucht."));
    return 0;}
  return 1;
}

//-- testfunktionen/Debugging ------------------------------------------------
mixed get_boreon()
{ object ob; if(ob=find_object(to_string(legends[BOREON,0]))) {return ob;}
  return to_string(legends[BOREON, 0]);}
mixed get_tekki()
{ object ob; if(ob=find_object(to_string(legends[TEKKI,0]))) {return ob;}
  return to_string(legends[TEKKI, 0]);}
mixed get_anksunamun()
{ object ob; if(ob=find_object(to_string(legends[ANKSUNAMUN,0]))) {return ob;}
  return to_string(legends[ANKSUNAMUN, 0]);}
//**************************************************************************//



//**PetFunktionen***********************************************************//
//-- Besistzt der Ranger ein Tier?--------------------------------------------
int IsPetOwner(mixed ranger)
{
  string s;
  
  if(objectp(ranger) && interactive(ranger))
  { s=lower_case(to_string(ranger->QueryProp(P_NAME))); }
  else if(stringp(ranger)) s=lower_case(ranger);
  else return -1;
  
  s+=".o";
  if((file_size(MEMBERS_PETS+s)) >= 0) return 1;
  else return 0;
}

public mapping GetPetCategories() {
  mapping m;
  int i;
  int j;

  m = ([ ]);
  for(i=0;i<sizeof(all);++i) {
    m[all[i][0]] = all[i];
  }

  return m;
}

//-- gehoert das Pet zu den kategorien/ist es somit zaehmbar? ----------------
mixed PetCategory(mixed pet)
{
  int i, k;
  mixed position;
  
  if(!pet) return 0;
  
  if(stringp(pet))
  {
    for(k=0; k<=sizeof(all)-1; k++)
    { if(member_array(lower_case(pet), all[k]) != -1) return all[k][0]; }
    return 0;
  }
  else if(objectp(pet))
  {
    for(k=0; k<=sizeof(all)-1; k++)
    {
      position=all[k];
      if( member_array(lower_case(pet->QueryProp(P_RACE)), all[k]) != -1)
      { return position[0]; break;}
      for(i=0; i<=sizeof(all[k])-1; i++)
      { 
        if( pet->id(position[i]) )
        {return position[0]; break; } 
      }
    
    }
    
  }
  else return 0;  
}

//-- Kompletter ZaehmbarkeitsTest --------------------------------------------
int is_zaehmbar(object caster, int ability, object ob, int silent)
{
  int max_level, max_level_diff;
  mixed res;
  
  max_level=30;
  max_level_diff=5;
  if(R_SKILLMASTER->HasSkill(getuid(caster), VERBESSERTE_ZAEHMUNG)) { 
    max_level+=5; max_level_diff+=5; 
  }
  if(R_SKILLMASTER->HasSkill(getuid(caster), TIER_RESPEKT)) {
     max_level+=5; max_level_diff+=10; 
  }

  if(!ob) return 0;

  // id NOZAEHMUNG
  if( member(ob->QueryProp(P_IDS), NOZAEHMUNG) != -1 )
  { if(!silent)
    {tell_object(caster, BS("Du darfst das nicht zaehmen."));}
    return 0;}
  
  // Falls es irgendwann mal spielbare Tierrassen gibt
  if( interactive(ob) )
  { if(!silent)
    {tell_object(caster, BS("Netter Versuch."));}
    return 0;}
  
  // Ist es ein Tier?
  /*
  if( !(ob->is_class_member(CL_ANIMAL)) )
  { if(!silent)
    {tell_object(caster, BS("Das ist kein Tier!"));}
    return 0;}*/
  
  //Ist das Objekt ein Bewacher?
  if(ob->QueryProp(P_GUARD))
  { if(!silent)
    {tell_object(caster, BS("Dieses Tier darfst Du nicht zaehmen."));}
    return 0;}
    
  //Neue Methode
  /*if( (ob->QueryGuardProtection())+1 > ability/100)
  { tell_object(caster, BS("Dieses Tier darfst Du nicht zaehmen."));
    return 0;}*/
    
  //Level-gerecht?
  if( (ob->QueryProp(P_LEVEL) > 30) ||  
      ((caster->QueryProp(P_LEVEL))-(ob->QueryProp(P_LEVEL))<max_level_diff))
  { if(!silent)
    {tell_object(caster, BS("Du bist nicht erfahren genug fuer Dieses Tier. "
                         "Suche Dir ein anderes."));}
    return 0;}
    
  //Passt es in die Kategorien?
  res=PETMASTER->PetCategory(ob);
  if( !stringp(res) )
  { if(!silent)
    {tell_object(caster,BS("Mit Diesem Tier koenntest Du nichts anfangen."));}
    return 0;}  
    
  return 1;
}
//**************************************************************************//



//** PetSuchFunktion *******************************************************//
//-- ObjectSpeichern ---------------------------------------------------------
mixed SetObject(string owner, string pet, int animal)
{
  string fn, backupfile, *lines, *pos, new_file;
  int i;  
  
  fn=GET_PET_LOG;
  if(animal) {fn=GET_ANIMAL_LOG;}  
  
  if(backupfile=read_file(fn))
  {
    new_file="";
    lines=explode(backupfile, "\n");
    for(i=0; i<=sizeof(lines)-1; i++)
    {
      pos=explode(lines[i], "**");
      if(to_string(pos[0])==lower_case(to_string(owner)))
      { continue; }
      new_file+=to_string(lines[i])+"\n"; 
    }
    new_file+=owner+"**"+pet+"\n";
    write_bytes(fn, 0, new_file);
    return 1;
  }
  return 0;  
}

//-- ObjectLaden -------------------------------------------------------------
mixed QueryObject(string owner, int animal)
{
  string backupfile, fn, pet, *lines, *pos;
  int i;  
  
  fn=GET_PET_LOG;
  if(animal) {fn=GET_ANIMAL_LOG;}  
  
  if(backupfile=read_file(fn))
  { lines=explode(backupfile, "\n");
    for(i=0; i<=sizeof(lines)-1; i++)
    { pos=explode(lines[i], "**");
      if(to_string(pos[0])==lower_case(to_string(owner)))
      { return to_string(pos[1]); } } }
  return 0;
}

//-- Pet/animal zurueckliefern -----------------------------------------------
mixed GetPet(object owner, int animal)
{
  object ob;
  mixed s;
  
  if( !stringp(s=QueryObject(to_string(getuid(owner)), animal)) ) {return 0;}
  if( !objectp(ob=find_object(to_string(s))) ) {return 0;}
  return ob;
}

//-- Pet/animal regsitrieren -------------------------------------------------
mixed SetPet(object owner, object pet)
{
  int animal;
  
  if(member(pet->QueryProp(P_IDS), ANIMAL_ID) != -1) {animal=1;}
  else {animal=0;} //animal oder kampfbegleiter?
  
  if(owner->id("Spieler")) {
    if(!SetObject(to_string(getuid(owner)),to_string(pet),animal)) {return 0;}
  } 
  return 1;    
}

