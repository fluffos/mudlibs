/*
**************** Kraeuter_master der Waldlaeufergilde ***************************
22.02.2006 - Begin (Lilyth, Torian, Delgo)@Silberland <sl.mud.at>
Wirkungsweise: im mapping kraeuter werden saemtliche Kraeuter mit allen Infos
  abgespeichert. In kraeuter_sort werden kraeuter nach der seltenheit im 
  bereich 1..10 gespeichert. Zum erzeugen der Kraeuter wird das erste 
  mapping genutzt, zu ermitteln welche ausgegeben werden sollen, das 2te.
*/
//** INHERIT + INCLUDE + DEFINE ********************************************//

#include "../def.h"

//--Vars----------------------------------------------------------------------
mapping kraeuter, kraeuter_sort;
string *kraeuterliste, *roomlist;
int *rare_list;

//--Prototypes----------------------------------------------------------------
object CloneHerb(string krautname);

//**************************************************************************//



//** CREATE ****************************************************************//
//--Have to be----------------------------------------------------------------
void create()
{ 
  int i, rare;
  string s;
  mixed k;
  
  if(is_clone(this_object()))
  { destruct(this_object()); return; }
  
  roomlist=({});
  //name:rareness;long;gender;heileffekt;heilstaerke
  kraeuter=(["tethyrblatt":250;
                           "Das gemeine Tethyrblatt ist stark verbreitet und "
                           "die blaue Faerbung verraet leicht seinen "
                           "natuerlichen Standort. Man sagt ihm eine geringe "
                           "Heilwirkung nach.";
                           NEUTER; HERBS_HEAL; 1;
                           (["faerbung":"Das Tethyrblatt hat eine blaue "
                                        "Faerbung.\n",
                             "standort":"Der ist nicht schwer zu erraten.\n",
                             "heilwirkung":"Angeblich kann das Tethyrblatt "
                                           "kleinere Verletzungen heilen.\n",
                             "verletzungen":"Sagt man jedenfalls.\n"]),
             "tethyrkraut":4500;
                           "Das blaue Tethyrkraut ist ein bekanntes "
                           "Heilkraut. Seine vier bis fuenf Blaetter sind "
                           "leicht gezackt.";
                           NEUTER; HERBS_HEAL; 3;
                           (["heilkraut":"Das Tethyrkraut ist auch als "
                                         "Heilkraut bekannt.\n",
                             "blaetter":"Die Blaetter dieses Krautes sind "
                                        "leicht gezackt.\n"]),
             "tethyrwurzel":8750;
                            "Diese Wurzel ist sehr selten, jedoch hat der "
                            "Saft in ihr eine heilende Wirkung. Ansonsten "
                            "kannst Du nichts Auffaelliges an ihr erkennen.";
                            FEMALE; HERBS_HEAL; 4;
                            (["saft":"Der Saft dieser Wurzel soll eine "
                                     "heilende Wirkung haben.\n",
                              "wirkung":"Der Saft dieser Wurzel soll eine "
                                        "heilende Wirkung haben.\n",
                              "auffaelliges":"Die Tethyrwurzel sieht recht "
                                             "unscheinbar aus.\n"]),
             "feuerblatt":1250;
                          "Das Feuerblatt hat seinen Namen daher, dass es "
                          "muede Geister wieder anregt, aehnlich dem Wuchs "
                          "einer Flamme. Das Blatt ist rund und weist eine "
                          "dunkelrote Farbe auf.";
                          NEUTER; HERBS_REFRESH; 1;
                          (["name":"Es heisst Feuerblatt.\n",
                            "namen":"Es heisst Feuerblatt.\n",
                            "geister":"Solche wie Dich zum Beispiel.\n",
                            "beispiel":"Das war eines.\n",
                            "wuchs":"Das sollte nur zur Verdeutlichung "
                                    "dienen.\n",
                            "flamme":"Das Feuerblatt sieht fast so aus wie "
                                     "eine kleine Flamme.\n",
                            "farbe":"Das Feuerblatt hat eine dunkelrote "
                                    "Farbe.\n"]),
             "feuerkraut":5500;
                          "Das Feuerkraut besteht aus mehreren "
                          "Feuerblaettern, die zusammen eine regenerierende "
                          "Wirkung auf den Verstand aufweisen.";
                          NEUTER; HERBS_REFRESH; 3;
                          (["feuerblaetter":"Das Feuerkraut besteht aus "
                                            "mehreren, roetlich gefaerbten "
                                            "Feuerblaettern.\n",
                            "feuerblatt":"Das Feuerkraut besteht aus "
                                         "mehreren, roetlich gefaerbten "
                                         "Feuerblaettern.\n",
                            "blaetter":"Das Feuerkraut besteht aus mehreren, "
                                       "roetlich gefaerbten "
                                       "Feuerblaettern.\n",
                            "wirkung":"Die Blaetter des Feuerkrautes haben "
                                      "eine regenerierende Wirkung auf den "
                                      "Verstand.\n",
                            "verstand":"Probier es ruhig einmal aus.\n"]),
             "feuerwurzel":9250;
                           "Die Feuerwurzel ist extrem selten, da ihre Kraft "
                           "sehr gross ist. Nur Kraeuterkundige verstehen es, "
                           "die feinen Wurzeln unbeschadet aus dem Waldboden "
                           "zu entnehmen.";
                           FEMALE; HERBS_REFRESH; 4;
                           (["kraft":"Sie ist eine sehr maechtige Wurzel.\n",
                             "kraeuterkundige":"Bist Du einer?\n",
                             "wurzeln":"Die feinen Wurzeln gehen schnell "
                                       "kaputt, wenn man unachtsam ist.\n",
                             "waldboden":"Die Feuerwurzel waechst "
                                         "normalerweise im Wald.\n"]),
             "waldlotus":6500;
                         "Diese kleine Blume hat heilende Kraefte fuer "
                         "Koerper und Verstand. Diese Heilpflanze ist nicht "
                         "immer leicht zu finden, da die Bluetenblaetter die "
                         "Farbe ihres Standortes annehmen.";
                         MALE; ({HERBS_HEAL, HERBS_REFRESH}); 3;
                         (["blume":"Der Waldlotus ist eine kleine, recht "
                                   "unscheinbare Blume.\n",
                           "kraefte":"Man sagt dieser Blume Heilkraefte "
                                     "nach.\n",
                           "heilkraefte":"Man sagt dieser Blume Heilkraefte "
                                         "nach.\n",
                           "koerper":"Diese Blume hat heilende Kraefte.\n",
                           "verstand":"Diese Blume hat heilende Kraefte.\n",
                           "heilpflanze":"Der Waldlotus ist eine "
                                         "Heilpflanze.\n",
                           "bluetenblaetter":"Die Bluetenblaetter dieser "
                                             "Pflanze passen sich in ihrer "
                                             "Farbe der Umgebung an.\n",
                           "farbe":"Die Farbe der Bluetenblaetter passt sich "
                                   "immer an die jeweilige Umgebung an.\n",
                           "standort":"Man findet den Waldlotus "
                                      "normalerweise im Wald.\n",
                           "umgebung":"Schau Dich einfach um.\n"]),
             "kronstoeckl":6750;
                           "Der Kronstoeckl ist eine mystische Pflanze. "
                           "Angeblich wird er fuer viele magische Rituale "
                           "benoetigt. In diesen Ritualen geht es meistens "
                           "um die Verwandlung von Lebewesen.";
                           MALE; HERBS_FROG; 0;
                           (["pflanze":"Der Kronstoeckl gilt als mystisch.\n",
                             "rituale":"Kennst Du Dich damit denn aus?\n",
                             "verwandlung":"Die Verwandlung eines Lebewesens "
                                           "in ein anderes.\n",
                             "lebewesen":"Du bist eines.\n"]),
             "teichkraut":2750;
                          "Das Teichkraut waechst meistens in der Naehe von "
                          "kleinen Teichen. Angeblich ist es (nach Fliegen "
                          "natuerlich) das Lieblingsfutter von Froeschen.";
                          NEUTER; HERBS_FROG; 0;
                          (["naehe":"Nun, in der Naehe halt.\n",
                            "teiche":"Siehst Du hier irgendwo einen?\n",
                            "teich":"Siehst Du hier irgendwo einen?\n",
                            "fliegen":"Diese nervigen kleinen Dinger.\n",
                            "dinger":"Fliegen.\n",
                            "lieblingsfutter":"Auch Froesche muessen "
                                              "schliesslich von irgendetwas "
                                              "leben, oder nicht?\n",
                            "froesche":"Die kennst Du doch bestimmt. Gruen, "
                                       "nass, glibschig...\n"]),
             "dunkelbeere":2000;
                           "Die Dunkelbeere ist eine sehr verbreitete "
                           "Waldfrucht. Hausfrauen (und auch Hauszwerginnen) "
                           "brauen aus diesen dunklen Trauben ein Getraenk, "
                           "welches ihre Maenner von den Nachwirkungen des "
                           "Alkohols befreit.";
                           FEMALE; HERBS_ALCOHOL; 3;
                           (["waldfrucht":"Dunkelbeeren findet man in der "
                                          "Regel im Wald.\n",
                             "hausfrauen":"Bist Du eine?\n",
                             "hausfrau":"Bist Du eine?\n",
                             "hauszwerginnen":"Bist Du eine?\n",
                             "hauszwergin":"Bist Du eine?\n",
                             "trauben":"Damit sind die Beeren gemeint.\n",
                             "getraenk":"Wie das wohl schmeckt?\n",
                             "maenner":"Auch bei Frauen zeigt das Getraenk "
                                       "seine Wirkung.\n",
                             "nachwirkungen":"Die koennen ganz schoen "
                                             "schmerzhaft sein.\n",
                             "alkohol":"Nun ja, manche koennen halt einfach "
                                       "nicht die Finger davon lassen...\n",
                             "finger":"Du beaeugst Deine Finger "
                                      "misstrauisch.\n"]),
             "gruenblatt":7000;
                          "Das Gruenblatt wird scherzhafterweise auch "
                          "Blaublatt genannt, da es angeblich beim "
                          "Ausnuechtern helfen soll.";
                          NEUTER; HERBS_ALCOHOL; 4;
                          (["blaublatt":"Das Gruenblatt wird scherzhaft auch "
                                        "Blaublatt genannt.\n",
                            "ausnuechtern":"Auch das muss manchmal sein.\n"]),
             "schattengras":8250;
                            "Das Schattengras, auch 'Zechprellertod' genannt, "
                            "befreit unter besonderen Umstaenden jeden Geist "
                            "augenblicklich vom Alkohol.";
                            NEUTER; HERBS_ALCOHOL; 5;
                            (["zechprellertod":"So wird das Schattengras "
                                               "auch genannt.\n",
                              "umstaende":"Nur unter besonderen "
                                          "Umstaenden.\n",
                              "geist":"Alkohol hat eine oft fatale Wirkung "
                                      "auf den Geist.\n",
                              "alkohol":"Alkohol hat eine oft fatale Wirkung "
                                        "auf den Geist.\n"]),
             "mondwurzel":1750;
                          "Die Mondwurzel ist in vielen Waeldern heimisch "
                          "und daher sehr bekannt. Die Wurzel ist sehr "
                          "salzig und weckt den Durst des 'Geniessers'. "
                          "Allerdings nur bei besonderer Zubereitung.";
                          FEMALE; HERBS_DRINK; 3;
                          (["waelder":"Man findet die Mondwurzel in vielen "
                                      "Waeldern.\n",
                            "durst":"Du wirst wissen, was damit gemeint ist, "
                                    "wenn Du die Wurzel probiert hast.\n",
                            "geniesser":"Nun, ueber Geschmack laesst sich "
                                        "gluecklicherweise nicht streiten.\n",
                            "geschmack":"Nein, darueber laesst sich wirklich "
                                        "nicht streiten.\n",
                            "zubereitung":"Kennst Du Dich damit aus?\n"]),
             "sandwurzel":7250;
                          "Die Sandwurzel hat ihren Namen daher, dass sie so "
                          "unheimlich trocken ist, dass der Mund sofort "
                          "austrocknet, wenn man ihren Saft trinkt.";
                          FEMALE; HERBS_DRINK; 4;
                          (["namen":"Sandwurzel ist der Name dieser "
                                    "Pflanze.\n",
                            "name":"Sandwurzel ist der Name dieser "
                                   "Pflanze.\n",
                            "mund":"Deine Mundhoehle fuehlt sich eigentlich "
                                   "noch ziemlich waessrig an.\n",
                            "mundhoehle":"Deine Mundhoehle fuehlt sich "
                                         "eigentlich noch ziemlich waessrig "
                                         "an.\n",
                            "saft":"Der Saft dieser Wurzel trocknet den Mund "
                                   "stark aus.\n"]),
             "spinnenmoos":8000;
                           "Das Spinnenmoos ist selten und sehr begehrt. Das "
                           "dunkelgruen leuchtende Moos entzieht dem "
                           "Koerper - bei richtiger Anwendung - "
                           "Fluessigkeit.";
                           NEUTER; HERBS_DRINK; 5;
                           (["koerper":"Der Koerper besteht zu einem "
                                       "Grossteil aus Fluessigkeit.\n",
                             "anwendung":"Nur bei richtiger Anwendung.\n",
                             "fluessigkeit":"Der Koerper besteht zu einem "
                                            "Grossteil aus Fluessigkeit.\n",
                             "grossteil":"Der Grossteil eben.\n"]),
             "waldefeu":1500;
                        "Der Waldefeu rankt sich am liebsten an Baeumen "
                        "empor. Geniesst man den Waldefeu richtig, so "
                        "staerkt er angeblich den Hunger.";
                        MALE; HERBS_FOOD; 2;
                        (["baeume":"Am wohlsten fuehlt sich der Waldefeu, "
                                   "wenn er von Baeumen umgeben ist.\n",
                          "hunger":"Wenn Du unter Appetitlosigkeit leidest, "
                                   "ist der Waldefeu genau das Richtige fuer "
                                   "Dich.\n",
                          "appetitlosigkeit":"Leidest Du darunter?\n"]),
             "kreuwurzel":3250;
                          "Die Kreuwurzel wurde frueher von Ogerhausfrauen "
                          "verwendet, um den Hunger ihrer Maenner anzuregen. "
                          "Doch scheinbar ging etwas schief und eine "
                          "gewisse permanente Wirkung ist heute nicht mehr "
                          "abzustreiten.";
                          FEMALE; HERBS_FOOD; 3;
                          (["ogerhausfrauen":"Doch doch, auch Oger fuehren "
                                             "einen Haushalt.\n",
                            "hausfrauen":"Doch doch, auch Oger fuehren einen "
                                         "Haushalt.\n",
                            "haushalt":"Glaubst Du das etwa nicht?\n",
                            "hunger":"Diese Wurzel regt den Hunger an.\n",
                            "maenner":"Die Armen waren aber auch sooo "
                                      "schmaechtig...\n",
                            "wirkung":"Schon mal einen schlanken Oger "
                                      "gesehen?\n"]),
             "guertelgras":5750;
                           "Das Guertelgras hat diesen Namen erhalten, weil "
                           "es dazu verwendet wurde, die Essfaehigkeit zu "
                           "steigern. Das hat kein Guertel ausgehalten ...";
                           NEUTER; HERBS_FOOD; 4;
                           (["name":"Dieses Gras nennt man Guertelgras.\n",
                             "namen":"Dieses Gras nennt man Guertelgras.\n",
                             "essfaehigkeit":"'Ist der Magen zu klein, nimm "
                                             "Guertelgras ein!'\n",
                             "magen":"Hast Du ueberhaupt einen?\n",
                             "guertel":"Deiner scheint noch zu halten.\n"]),
             "zwergenfinger":8000;
                             "Diese Blaetter wachsen zusammengerollt, so "
                             "dass sie mit viel Phantasie (oder dem Genuss "
                             "anderer Pflanzen) aussehen wie die Finger eines"
