             "wanderwurzel":3600;
                            "Die Wanderwurzel ist schon fast selten, doch "
                            "ihre Wirkung ist weithin bekannt. So mancher "
                            "Kaempfer am Ende seiner Kraefte hat dank dieser "
                            "Wurzel seine Kondition wiedererlangt.";
                            FEMALE; HERBS_MV; 4;
                            (["wirkung":"Sie staerkt die Kondition "
                                        "ungemein.\n",
                              "kaempfer":"Diese Wurzel hat schon so manchem "
                                         "mueden Kaempfer wieder auf die "
                                         "Beine geholfen.\n",
                              "ende":"Er war am Ende seiner Kraefte.\n",
                              "kraefte":"Er war am Ende seiner Kraefte.\n",
                              "kondition":"Sie staerkt die Kondition.\n"]),
             "lungenkraut":4000;
                           "Das Lungenkraut ist der nordische Vertreter der "
                           "Kajuboknospe und fuellt die Lungen des Anwenders "
                           "fuer laengere Zeit mit ausreichend Luft, um eine "
                           "Atmung unter der Wasseroberflaeche zu "
                           "gewaehrleisten.";
                           NEUTER; HERBS_WATER; 0;
                           (["vertreter":"Das Lungenkraut kommt nur in den "
                                         "noerdlicheren Gefilden vor.\n",
                             "gefilde":"Oder hast Du es woanders gefunden?\n",
                             "kajuboknospe":"Ist sie Dir bekannt?\n",
                             "lungen":"Das Kraut fuellt Deine Lungen mit "
                                      "Luft. Auch unter Wasser.\n",
                             "anwender":"Du musst es natuerlich richtig "
                                        "anwenden.\n",
                             "zeit":"Nur eine gewisse Zeit lang.\n",
                             "luft":"Auch Du brauchst Luft zum Atmen.\n",
                             "atmung":"Unter Wasser faellt einem das Atmen "
                                      "doch recht schwer.\n",
                             "wasseroberflaeche":"Wenn Du Dich haeufig unter "
                                                 "ihr aufhaeltst, ist Dir "
                                                 "dieses Kraut sicherlich "
                                                 "eine Hilfe.\n"]),
             "kreuzblatt":9500;
                          "Das Kreuzblatt ist extrem selten und nur bei "
                          "einigen Medizinern dafuer bekannt, dass es das "
                          "Blut augenblicklich von jedem Gift befreit.";
                          NEUTER; HERBS_POISON; 5;
                          (["mediziner":"Die veruschen das Blut im Gift zu "
                                        "neutralisieren. Oder so aehnlich.\n",
                            "blut":"Fliesst vermutlich Durch Deine Adern.\n",
                            "gift":"Meisstens ist es toedlich.\n"]),
             "sonnenwurzel":6250;
                            "Die Sonnenwurzel ist ein seltenes Gewaechs mit "
                            "einer heilenden Wirkung auf einige Krankheiten."
                            " So zum Beispiel auch Malaria.";
                            FEMALE; HERBS_MALARIA; 0;
                            (["gewaechs":"Die Sonnenwurzel kommt nur sehr "
                                         "selten vor.\n",
                              "wirkung":"Sie hat eine heilende Wirkung bei "
                                        "gewissen Krankheiten.\n",
                              "krankheiten":"Viele Krankheiten koennen mit "
                                            "dieser Wurzel geheilt werden.\n",
                              "beispiel":"Malaria ist solch ein Beispiel.\n",
                              "malaria":"Das ist nur ein Beispiel.\n"]) ]);
  kraeuterliste=m_indices(kraeuter);
  kraeuter_sort=([0:({"kraut","namen"})]);
  if(mappingp(kraeuter) && pointerp(kraeuterliste))
  {
    for(i=0;i<=sizeof(kraeuterliste)-1;i++)
    {
      s=kraeuterliste[i];
      rare=kraeuter[s, 0];
      k=({});
      if( (member(m_indices(kraeuter_sort), rare) != -1) )
      { if(!(k=kraeuter_sort[rare, 0])) {continue;}
        k+=({s}); kraeuter_sort[rare]=k; continue; }
      kraeuter_sort[rare]=({s});      
    }
  }
  if(mappingp(kraeuter_sort))
  { rare_list=m_indices(kraeuter_sort);
    rare_list=sort_array(rare_list, CLOSURE(>));
    rare_list-=({0});
  }
}

//**************************************************************************//



//** KraeutersucheFunktionen ***********************************************//
//-- Welche Kraeuter gibt es zur Zeit? ---------------------------------------
mixed QueryHerbs()
{ if(!pointerp(kraeuterliste)) return 0;
  return kraeuterliste; }

public string QueryHerbDescription(string herb) {
  if(!stringp(herb) || !member(kraeuter, herb)) return 0;
  return kraeuter[herb, 1];
}

//-- Verteilung von Kraeutern, aehnlich DistributeGem ------------------------
int DistributeHerbs(int n, int r, int rareness, mixed aim, mixed types)
{
  object herb, bandolier;
  int i, *tmp_list;
  string *herbs;
  
  n=n+random(r);
  if(n<1) return 0;
  if(!aim) aim=PO;
  if(stringp(types)) {
    //Falls ein spezielles Kraut gewuenscht wurde 
    for(i=0; i<=n; i++) {
      if(herb=CloneHerb(types)) { 
        if(objectp(bandolier=present("bandolier", aim))) {
          if(!bandolier->CanPutHerb(herb->QueryProp(P_NAME))) {
            tell_object(aim, BS("Du findest "+herb->name(WEN, 1)+", hast aber schon genug von dieser Art."));
            herb->remove(1);
          } else {
            bandolier->PushKraut(herb);
            tell_object(aim, BS("Du steckst "+herb->name(WEN, 1)+" in dein Bandolier."));
          }
        } else {
          if(herb->move(aim, M_GET) == ME_TOO_HEAVY) { 
            tell_object(aim, "Du kannst nicht mehr tragen.");
            return 0;
          }
          if(herb->move(aim, M_GET) != 1) { 
            tell_object(aim, "Du kannst die Kraeuter nicht nehmen.");
            return 0;
          }
          else {
            herb->move(aim, M_GET);
          }
        }
      }
    }
    return 1;
  }

  if(pointerp(types)) { //Falls einige spez. Kraeuter gewuenscht wurde
    for(i=0; i<=n; i++) {
      if(herb=CloneHerb(types[random(sizeof(types))])) { 
        if(objectp(bandolier=present("bandolier", aim))) {
          if(!bandolier->CanPutHerb(herb->QueryProp(P_NAME))) {
            tell_object(aim, BS("Du findest "+herb->name(WEN, 1)+", hast aber schon genug von dieser Art."));
            herb->remove(1);
          } else {
            bandolier->PushKraut(herb);
            tell_object(aim, BS("Du steckst "+herb->name(WEN, 1)+" in dein Bandolier."));
          }
        } else {
          if(herb->move(aim, M_GET) == ME_TOO_HEAVY) { 
            tell_object(aim, "Du kannst nicht mehr tragen.");
            return 0;
          }
          if(herb->move(aim, M_GET) != 1) { 
            tell_object(aim, "Du kannst die Kraeuter nicht nehmen.");
            return 0;
          } else {
            herb->move(aim, M_GET);
          }
        }
      }
    }
    return 1;
  }

  //Jetzt die Wahl abhaengig vom Skill
  if(rareness>10000) rareness=10000;  
  if(rareness<1) rareness=1;
  
  for(i=0; i<=sizeof(rare_list)-1; i++) {
    if(rareness>rare_list[i]) continue;
    if(rareness<=rare_list[i]) break;
  }

  if(i==sizeof(rare_list)) tmp_list=rare_list;
  else {
    tmp_list=exclude_array(rare_list, (i+1), (sizeof(rare_list)+1));
  }

  for(i=0;i<=n;i++) {
    herbs=kraeuter_sort[ (tmp_list[random(sizeof(tmp_list))]), 0 ];

    if(herb=CloneHerb(herbs[random(sizeof(herbs))])) {
      if(objectp(bandolier=present("bandolier", aim))) {
        if(!bandolier->CanPutHerb(herb->QueryProp(P_NAME))) {
          tell_object(aim, BS("Du findest "+herb->name(WEN, 1)+", hast aber schon genug von dieser Art."));
          herb->remove(1);
        } else {
          bandolier->PushKraut(herb);
          tell_object(aim, BS("Du steckst "+herb->name(WEN, 1)+" in dein Bandolier."));
        }
      } else {
        if(herb->move(aim, M_GET) == ME_TOO_HEAVY) { 
          tell_object(aim, "Du kannst nicht mehr tragen.");
          return 0;
        }

        if(herb->move(aim, M_GET) != 1) { 
          tell_object(aim, "Du kannst die Kraeuter nicht nehmen.");
          return 0;
        } else {
          herb->move(aim, M_GET);
        }
      }
    }    
  }

  return 1;
}

//-- Kraut wird generiert ----------------------------------------------------
object CloneHerb(string krautname)
{
  object herb;
  if(herb=clone_object(FOOD"kraut"))
  {
    herb->customize(krautname,
                    kraeuter[krautname,1], kraeuter[krautname,2],
                    kraeuter[krautname,3], kraeuter[krautname,4],
                    kraeuter[krautname,5]);
    return herb;
  }
  return 0;
}

//-- Einige Testfunktionen ---------------------------------------------------
mixed test()
{ return kraeuter_sort; }
mixed test2()
{ return rare_list; }

//-- Welche Kraeuter gibt es? (Wichtig fuer Spell) ---------------------------
mixed QueryKraeuterliste() {return kraeuterliste;}

//**************************************************************************//


//** Raumverwaltung (welche wurden schon abgegrast) ************************//
//-- Ist der Raum schon durchsucht worden? -----------------------------------
int QueryRoom(string room)
{ if(member(roomlist, room) != -1) {return 1;}
  return 0;
} 

//-- einen Raum zu den durchsuchten hinzufuegen ------------------------------
int AddRoom(string room)
{ roomlist+=({room});
  return 1;
}

//-- Welche Raeume sind belegt? ----------------------------------------------
mixed QueryRooms() {return roomlist;}

//-- Raeume manuell umsetzen -------------------------------------------------
mixed SetRooms(mixed rooms) {roomlist=rooms;}

//**************************************************************************//



//** Standard Funktionen ***************************************************//
//-- Im Reset werden die Raeume wieder mit Kraeutern besetzt -----------------
void reset() {roomlist=({});}

//**************************************************************************//