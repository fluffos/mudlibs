#include "../def.h"
#include <verben.h>

inherit "std/unit";

void create()
{
  if(!is_clone(TO) ) return;
  ::create();

//--Beschreibungen---------------------------------------------------------


  SetProp(P_SHORT, "Wurfmesser");
  SetProp(P_LONG,
    "Das Wurfmesser ist relativ klein, leicht und aus einem einzigen Guss "
    "gefertigt. Sein Griff ist schwerer als bei einem normalen Dolch und die "
    "Klinge besonders lang und duenn, damit man es gut werfen kann. Zum Kaempfen sind "
    "sie abseits des Messerwerfens nicht geeignet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, ({"Wurfmesser", "Wurfmesser"}));
  SetProp(P_GENDER, NEUTER);
  AddId(({"messer", "wurfmesser", THROWING_KNIFE_ID}));

  SetCoinsPerUnits(50);
  SetGramsPerUnits(200);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_STEEL);
  SetProp(P_SIZE, 33);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);

//--Details----------------------------------------------------------------
  SetProp(P_INFO, BS("Diese Wurfmesser sind besonders gut fuer den Messerwurf der Waldlaeufer geeignet."));

  AddCmd("zuecke|zueck&messer|wurfmesser", "cmd_nixda");
  AddCmd(CMD_WERFEN, "cmd_werfen");
}

public int cmd_nixda() {
    notify_fail("Die Wurfmesser sind zum Kaempfen nicht geeignet.\n");
    return 0;
}

public void RangerKnifeThrownAt(object enemy) {
    if(!objectp(enemy)) return;
    tell_room(ENV(enemy), BS("Das Wurfmesser bleibt in "+enemy->name(WEM)+" stecken."));
    return;
}


public int cmd_werfen(string str) {
    string target, what;
    object victim;
    int fix, r, dc;

    notify_fail("Was willst du auf wen werfen?\n");
    if(!str || str == "") return 0;
    if(sscanf(str, "%s auf %s", what, target) != 2) return 0;
    if(!id(what)) return 0;

    notify_fail("Dein Ziel ist gar nicht hier!");
    if(!objectp(victim=present(target, ENV(TP)))) return 0;
    
    if(query_once_interactive(victim)) {
        write(BS("Du wirfst das Messer lieber nicht auf andere Spieler..."));
        return -1;
    }

    if(!living(victim)) {
        write(BS("Mit einem *PLONK* prallt das Wurfmesser von "+victim->name(WEM)+" ab. Du sammelst es wieder auf."));
        say(BS(TPN+" wirft ein Wurfmesser gegen "+victim->name(WEN)+" und sammelt es wieder auf."));
        return 1;
    }

    write(BS("Mit einem kraeftigen Wurf schleuderst du "+name(WEN)+" auf "+victim->name(WEN)+"."));
    say(BS(TPN+" wirft "+name(WEN)+ " auf "+victim->name(WEN)+"."));

    r = random(TP->QueryAttribute(A_DEX));
    dc = random(victim->QueryAttribute(A_DEX));
    if(r > dc) {
         fix = QueryProp(P_WC) * QueryProp(P_WC_FIX) / 100;
        victim->Defend(fix+TP->QueryAttribute(A_DEX)+random(QueryProp(P_WC)-fix), ({DT_PIERCE}), 
                       ([SP_NAME: "Wurfmesser", SP_SHOW_DAMAGE: 1, SP_PHYSICAL_ATTACK: 1]), TP);
        RangerKnifeThrownAt(victim);
    } else {
        write(BS("Du verfehlst."));
    }

    AddAmount(-1);
    return 1;
}

