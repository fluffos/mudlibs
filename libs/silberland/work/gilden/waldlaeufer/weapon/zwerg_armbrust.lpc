#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine schwere Armbrust");
  SetProp(P_LONG,
    "Diese Armbrust ist schwer und massiv gefertigt. Eindeutig von zwergischer "
    "Bauart benoetigt sie viel Kraft um effektiv genutzt zu werden. Der Arm "
    "ist aus massivem Stahl und sie verschießt dicke Bolzen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Armbrust");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"armbrust"}) );

  SetProp(P_NAME_ADJ, "schwer");
  AddAdjective( ({"schwere","schweren","schwerem","schwerer"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 70, MAT_STEEL: 30]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WEAPON_TYPE, WT_BOW );
  SetProp(P_WC, 280);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["Bogenmeister": 200,]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 25, A_STR: 24]) );

}