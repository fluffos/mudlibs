#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "");
  SetProp(P_LONG,
    "");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Knife");
  SetProp(P_GENDER, MALE);
  AddId( ({"knife", "messer"}) );


//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 300);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);


//--Details----------------------------------------------------------------
}

int QueryDamage(object enemy)
{
  
  DBD("Kampfrunde!");
  
  return ::QueryDamage(enemy);
}