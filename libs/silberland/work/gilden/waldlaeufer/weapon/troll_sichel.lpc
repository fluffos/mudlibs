#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine goldene Sichel");
  SetProp(P_LONG,
    "Dies ist eine besondere Sichel. Sie wird von Meistern der Kraeuterkunde "
    "verwendet und ist lauterem Gold gehaemmert. Abseits dessen ist sie eine "
    "toedliche Waffe.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Sichel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"sichel", ""}) );

  SetProp(P_NAME_ADJ, "golden");
  AddAdjective( ({"goldenen","goldener","goldenem","goldenes","goldene"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["Messerkaempfer": 50, "Messerexperte": 100, "Messermeister": 150]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 25]) );

}