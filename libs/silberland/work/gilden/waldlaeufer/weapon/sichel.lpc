/*************** Sichel der Waldlaeufergilde *********************************
26.02.2006 - Begin (Lilyth, Torian, Delgo)@Silberland <sl.mud.at>*/
//** INHERIT + INCLUDE + DEFINE ********************************************//
#include "../def.h"
inherit "std/living/skills.lpc";
inherit "std/weapon";
//**************************************************************************//



//** StandardFunktionen ****************************************************//
//-- Create() ----------------------------------------------------------------
create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine kleine Kraeutersichel");
  SetProp(P_LONG, 
    "Du haelst eine kleine Kraeutersichel in der Hand. Sie ist als Waffe "
    "kaum zu gebrauchen, doch ein Kraeuterkundiger versteht es damit "
    "Kraeuter zu sammeln ohne sie zu beschaedigen. Diese Sichel gehoert den "
    "Waldlaeufern.");
  
  SetProp(P_NAME, "Sichel");
  SetProp(P_GENDER, FEMALE );
  SetProp(P_ARTICLE, 1);
  AddId( ({"sichel", SICHEL_ID, "kraeutersichel"}) );
  SetProp(P_MATERIAL, ([MAT_OAK: 70,MAT_IRON: 30]) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_VALUE, 400+random(100) );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 25);
  SetProp(P_WC_FIX, 50);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":160, "Messermeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
                            
  AddCmd( "kraeutersuche" , "herbalism");
}

//-- Nur Waldlaeufer duerfen Sichel tragen -----------------------------------
void init()
{
  ::init();
  if(!objectp(MENV) || MENV->QueryProp(P_GUILD)!= GUILDNAME)
  { write("Die Sichel wird zu Staub.\n");
    call_out("remove",0);
    return; }
}
//**************************************************************************//



//** KraeutersucheFunktionen ***********************************************//
//-- Die cmd zum suchen ------------------------------------------------------
int herbalism() 
{ 
  mapping m;
  
  if(!objectp(TP)      || !objectp(TO) || 
     !objectp(ENV(TP)) || !objectp(ENV(TO)) ) return 0;
  if(!QueryProp(P_WIELDED))
  { tell_object(TP, BS("Du musst die Sichel dazu zuecken.")); return 1;}  
  TP->UseSkill(SK_RANGER_HERBALISM, ([SI_ENVIRONMENT: file_name(ENV(TP))]));
  return 1;
}
//**************************************************************************//