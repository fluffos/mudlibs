data (["ranger_pet_renamed":1,"name":"Mandy","ranger_pet_owner":"zoe","ids":({"Ding","Container","NPC","mandrill","killermandrill","\nzoe_ranger_pet","NOZAEHMUNG","\nranger_pet","SKILL_NOLEARN","mandy",}),"npc:rate_array":({0,1,}),"max_hp":706,"max_sp":706,"level":26,"align":-84,"hp":706,"attributes":(["int":26,"con":26,"str":26,"dex":26,]),"ranger_max_pet_level":26,"class":({"tier",}),"murder_msg":"Warte nur, %s! Das naechste Mal bist Du machtlos.","size":172,"nomagic":12,"race":"Affe","msgin":"wuselt heran","msgout":"wuselt","mmsgout":"folgt Zoe","hands":({" mit seinen scharfen Krallen",260,"bludgeon",}),"gender":1,"body":104,"max_hands":2,"die_msg":" wuselt davon.\n","weight":75000,"long":"Der Killermandrill sieht aus wie ein zu gross geratener Affe. Das Haar wuchert\nihm vom Kopf bis zum Ende des Rueckgrats, mit seinen breiten Schultern und\nueberlangen Armen wirkt er auf Dich ziemlich bedrohlich. So richtig mulmig\nwird Dir aber erst, als Du seine langen Reisszaehne und die scharfen, harten\nKrallen an seinen Fingern bemerkst...\n(gezaehmt von Zoe)\n","xp":10403,"article":0,"ranger_pet_race":"kleintier","short":"mandy, der gezaehmte Killermandrill von Zoe","kill_name":"Ein Killermandrill","ranger_pet_remove_time":1713704438,"nocorpse":1,"spellrate":13,"spells":({({600,"Der Killermandrill kratzt Dich mit seinen Krallen, bis das Blut rinnt.\n","Der Killermandrill kratzt @WEN mit seinen Krallen blutig.\n","rip",(["si_damage":56,"sp_showdamage":1,]),0,}),({750,"Der Killermandrill reisst Dir mit seinen Zaehnen den Bauch auf.\n","Der Killermandrill reisst @WEM mit seinen Zaehnen den Bauch auf.\n","rip",(["si_damage":690,"sp_showdamage":1,]),0,}),}),"mmsgin":"wuselt heran",])
