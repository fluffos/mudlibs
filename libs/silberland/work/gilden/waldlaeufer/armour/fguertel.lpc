/***************** Fallenguertel der Waldlaeufergilde ************************
26.09.06 - Begin
*****************************************************************************/
//** INHERIT + INCLUDE + DEFINE ********************************************//
inherit "std/armour";
#include "../def.h"
#include "/gilden/waldlaeufer/functions.h"

//-- Vars --------------------------------------------------------------------
int ladungen;
//-- Prototypes --------------------------------------------------------------
string filled();
//**************************************************************************//



//** StandardFunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Fallenguertel");
  SetProp(P_NAME, "Fallenguertel");
  SetProp(P_GENDER, MALE );
  AddId( ({"guertel", "fallenguertel", TRAP_BELT_ID}) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 10 );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WORN_TEXT, "ueber der Ruestung getragen");
  ladungen=MAX_FALLEN_LADUNGEN;
}

//-- Remove ------------------------------------------------------------------
int remove(int silent)
{
  if(!silent) { write("Der Fallenguertel wird zu Staub.\n"); }
  return ::remove(1);
}

//-- Nur Waldlaeufer duerfen diesen Guertel tragen ---------------------------
int WearFunc(object ob)
{
  if(objectp(TP) && TP->QueryProp(P_GUILD)!= GUILDNAME)
  { tell_object(TP, BS("Nur Waldlaeufer duerfen diesen Guertel tragen!\n"));
    remove(); return 0; }
  return 1;
}

//-- Die Long ----------------------------------------------------------------
string _query_long()
{
  string s;
  
  s="Der braune, breite Lederguertel bietet Dir zwar keinerlei Schutz, doch "
    "bieten zahlreiche kleine Taschen und Schlaufen die Moeglichkeit, kleine "
    "Draehte, Klingen, Seile und allerlei Fallenmaterial unterzubringen."
    " Nur Mitglieder der Waldlaeufer koennen diesen Guertel tragen. Er ist "
    +filled()+".";
  return BS(s);
}
//**************************************************************************//



//** Fallenfunktionen ******************************************************//
//-- Wieviele Ladungen hat der Guertel noch? ---------------------------------
int get_ladungen() { return ladungen; }

//-- Ladungen setzen ---------------------------------------------------------
int set_ladungen(int i) { return ladungen=limit(i,0,MAX_FALLEN_LADUNGEN); }

//-- Darf die Falle gebaut werden? -------------------------------------------
int can_build(int i) { return (QueryWorn() && (ladungen-i>=0)); }

//-- Ladungen voll fuellen ---------------------------------------------------
int full_fill() { return ladungen=MAX_FALLEN_LADUNGEN; }

//-- ladungen auffuellen -----------------------------------------------------
int fill(int i) { return ladungen=limit(ladungen+i,0,MAX_FALLEN_LADUNGEN); }

//-- Wieviele Ladungen fehlen zum FullFill? ----------------------------------
int get_missing() { return MAX_FALLEN_LADUNGEN-ladungen; }

//-- Ladung aufbrauchen ------------------------------------------------------
void dec_ladungen(int i) { ladungen=limit(ladungen-i,0,MAX_FALLEN_LADUNGEN); }

//-- Fuellzustand ------------------------------------------------------------
string filled()
{
  int i;
  
  i=10*ladungen/MAX_FALLEN_LADUNGEN;
  return (({"leer","fast leer","kaum gefuellt","weniger als halb voll",
            "halb voll", "noch mehr als halb voll", "noch gut gefuellt",
            "zu dreiviertel gefuellt","ausreichend gefuellt","fast voll",
            "voll"})[i]);
}
//**************************************************************************//