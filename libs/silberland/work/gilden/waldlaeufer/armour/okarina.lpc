inherit "/gilden/bardengilde/instrument/base_floete";

#include <properties.h>
#include <combat.h>
#include "/p/std/barden/instrument.h"
#include "../def.h"

public void create() {
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Okarina");
  SetProp(P_LONG, 
    "Die Okarina, ein zartes Musikinstrument aus glasiertem Ton, "
    "fasziniert mit ihrer eleganten Form und kunstvollen Verzierungen. "
    "Die handliche Gestaltung und glatte Oberflaeche machen das Halten "
    "und Spielen der Okarina zu einem sinnlichen Erlebnis. Ihre klaren, "
    "verzaubernden Toene entlocken dem Instrument eine magische Melodie, "
    "die den Spieler auf eine reizvolle musikalische Reise entfuehrt."); 
  SetProp(P_NAME, "Okarina");
  SetProp(P_GENDER, FEMALE);
  AddId(({"okarina"}));
  SetProp(P_INSTRUMENT_LEVEL, 5);
  SetProp(P_HANDS, 1);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_CERAMIC:100]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}














