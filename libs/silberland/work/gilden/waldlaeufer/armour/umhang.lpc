#include "../def.h"

inherit "std/armour";

//--Variablen&Defines------------------------------------------------------

string farbe; // Umhangfarbe

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  switch(random(15))
  {
    case 1:
      farbe = "braun";
      break;

    case 2:
      farbe = "schwarz";
      break;

    default:
      farbe = "blau";
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+farbe+"er Wollumhang");
  SetProp(P_LONG,
    "Dieser Umhang besteht aus grober, etwas dickerer "+farbe+"er Wolle, "
    "die recht abgenutzt und besonders an den Enden ziemlich zerschlissen "
    "aussieht. Der Umhang ist etwa knoechellang und besitzt eine sehr "
    "weite Kapuze, die das Gesicht des Traegers nahezu vollstaendig "
    "verhuellt. Er wird bevorzugt von Waldlaeufern getragen.");

  AddDetail( ({ "wolle", "wollstoff", "stoff" }),
    "Der Umhang besteht aus einem groben, leicht angerauhten Wollstoff, "
    "der einen guten Schutz vor Wind und Wetter bietet und dennoch "
    "angenehm zu tragen ist.");

  AddDetail( ({ "schutz" }),
    "Ein guter Schutz bei jedem Wetter ist notwendig, besonders da sich "
    "Waldlaeufer im Allgemeinen eher draussen als drinnen aufhalten.");

  AddDetail( ({ "allgemeinen", "allgemeines", "allgemein", "freies",
    "freien" }),
    "Meistens halten sie sich im Freien auf.");

  AddDetail( ({ "wind", "wetter" }),
    "Besonders bei kaltem Wind und schlechtem Wetter bietet der Umhang "
    "einen guten Schutz.");

  AddDetail( ({ "enden" }),
    "Insbesondere an den Enden ist der Umhang sehr zerschlissen und "
    "teilweise eingerissen.");

  AddDetail( ({ "kapuze" }),
    "Die weite Kapuze verbirgt das Gesicht des Traegers nahezu "
    "vollstaendig.");

  AddDetail( ({ "gesicht" }),
    "Mit der Kapuze kann man sein Gesicht sehr gut verbergen, was ja "
    "in manchen Faellen durchaus sinnvoll sein kann.");

  AddDetail( ({ "traeger" }),
    "Derjenige, der den Umhang traegt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Wollumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "wollumhang"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOL);
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 850);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 7);
  SetProp(P_QUALITY_DECAY, 100);

//--Create Ende------------------------------------------------------------

}
