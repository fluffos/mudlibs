#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "");
  SetProp(P_LONG,
    "");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "");
  SetProp(P_GENDER, FEMALE MALE NEUTER);
  AddId( ({"", "", ""}) );

  SetProp(P_NAME_ADJ, ({"xx-"}) );
  AddAdjective( ({"xx-en","xx-er","xx-em","xx-es","xx-e"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_ );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_ );
  SetProp(P_AC, );
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, ([DT_xx:]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_xx:]) );

  SetProp(P_INFO, BS(".") );
}

int WearFunc(object me)
{
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}
