inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <player.h>
#include <moving.h>
#include <wizlevels.h>
#include <moredef.h>

#pragma strong_types

string name = "einem Paladin";

void create()
    {
    if( !is_clone(this_object()) ) return;
    ::create();

    AddId( ({"schaedel", "paladinschaedel"}) );
    SetProp(P_SHORT, "Ein verwesender Paladinschaedel");
    SetProp(P_LONG, "Der verwesende Schaedel eines toten Paladin.");
    SetProp(P_INFO, "So ein suppa Schaedel. Nur Iwo kann so bloed sein "
                    "sowas zu machen.");    
    SetProp(P_NAME, "Paladinschaedel");
    SetProp(P_GENDER, MALE);
    set_living_name("paladinschaedel");
    
    create_default_npc(1);
    SetProp(P_RACE, "Ball");
    SetProp(P_SIZE, 32);
    SetProp(P_ALIGN, 0);
    SetProp(P_MAX_HANDS, 0);
    SetProp(P_ARTICLE, 1);
    SetProp(P_NAME_ADJ, "verwesend");
    SetProp(P_NOATTACK, "bewegt sich nicht. Einen toten Schaedel angreiffen? Wie kann man nur so tief sinken ...");
    SetProp(P_DEFAULT_INFO, "bewegt sich nicht. Schaedel? Reden? Bloedsinn!");
    SetProp(P_REJECT, REJECT_DROP);
    SetProp(P_SMELL, "Er stinkt fuerchterlich. Du moechtest Dich uebergeben.\n");

    SetChats(5, ({"Der Schaedel liegt einfach nur da, verwest und verbreitet einen ueblen Geruch.\n"}) );
    SetProp(P_WIMPY, 10);
    SetProp(P_MSGIN, "rollt herein und bleibt vor Deinen Fuessen liegen.");
    SetProp(P_MSGOUT, "rollt");

    AddCmd( ({"trete", "tret", "tritt"}), "trete");

    call_out("die", 2000);
}

int SetName(string plstr)
{
  if (!plstr) return 0;
  
  SetProp(P_NAME, sprintf("Schaedel von %s", CAP(plstr)));
  SetProp(P_SHORT, sprintf("Der verwesende Schaedel von %s", CAP(plstr)));
  SetProp(P_LONG, sprintf("Der verwesende Schaedel von %s. Ob er ihn wohl vermisst?", CAP(plstr)));
  name = CAP(plstr);
}

int trete ( string str )
    {
    string * local_exits;

    
    if (!str && str != "fussball" && str != "schaedel")
        {
        notify_fail("WAS willst Du treten?");
        return 0;
        }

    local_exits = m_indices(environment(this_object())->QueryProp(P_EXITS));

    if(sizeof(local_exits)<1) {
        this_object()->move("/gilde/abenteurer", M_GO);
        return 1;
        }

    tell_room(environment(this_object()),  BS(TP->Name() + " tritt den verwesenden Schaedel von " + name + ". Leichensaft spritzt durch die Gegend.\n"), ({ TP }));
    tell_object(TP, BS("Du trittst den verwesenden Schaedel von " + name + ". Leichensaft spritzt durch die Gegend.\n"));

    command(local_exits[random(sizeof(local_exits))]);

    return 1;
    
    }

