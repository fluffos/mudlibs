#pragma strong_types

inherit "/std/npc";

#include <properties.h>
#include <wizlevels.h>  
#include <npc.h>
#include <moving.h>
#include <language.h>
#include <attributes.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>


#define SFILE "/gilden/secure/tod/tod.log"

string death="fake";

mapping waitfor = ([]);


void create ()
    {
    if (is_clone(TO)) TO->remove(); 
    ::create();

//    seteuid(getuid(TO));

    create_default_npc(100);

    enable_commands();

    AddId( ({ "tod", "gevatter" }) );

    set_living_name("tod");


    SetProp(P_NAME, "Tod");
    SetProp(P_MSGIN, "kommt an.\nDu bekommst es mit der Angst zu tun");
    SetProp(P_MSGOUT, "geht#.\nDu wischt Dir den Schweiss von der Stirn");
    SetProp(P_MMSGOUT, "loest sich vor Deinen Augen auf");
    SetProp(P_GENDER, MALE );
    SetProp(P_RACE, "Skelett");
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_TEMPERATURE_RANGE, ([0:-100, 1:100]));
    SetProp(P_ARTICLE, 0);
    SetProp(P_HANDS, ({" mit seinen Klauen", 1000, DT_RIP }) );
    SetProp(P_BODY, 1000);
    SetProp(P_XP, 0);
    SetProp(P_TRANSPARENT, 0);
    SetProp(P_WEIGHT, 20);
    SetProp(P_SIZE, 300);

    SetProp(P_SHORT, "Der Tod");
    SetProp(P_ALIGN, 0);
    SetProp(P_RESISTANCE_STRENGTHS, ([DT_HOLY:1]) );

    SetProp(P_NOATTACK, "lacht sich fast tot.");

    SetChats(6, ({
             "Der Tod wetzt seine Sense.\n",
             "Du hoerst die Knochen klappern.\n",
             "Du moechtest Dich irgendwo verstecken.\n",
             "Du hoffst, dass er nicht gekommen ist Dich zu holen.\n",
             "Kalte Schauer laufen Dir ueber den Ruecken.\n",
             "Ein blaeulicher Schimmer laeuft ueber die Sense.\n",
             "Der Umhang Todes wallt furchteinfloessend.\n",
             "Der Tod lacht: HAR HAR HAR!\n",
                           }) );



    SetProp(P_LONG,
      "Du zitterst am ganzen Leib als Du die furchteinfloessende Gestalt betrachtest. Ein "
      "schwarzer Mantel, dunkler als alles, was Du jemals gesehen hat, verhuellt zum Teil "
      "die blanken Knochen. Tief in den leeren Augenhoehlen glaubst Du ein schwaches "
      "Schimmern wahrzunehmen. Die langen, knochigen Fingern umklammern mit festem "
      "Griff eine gewaltige Sense, deren Schneide Du lieber nicht zu nahe kommen moechtest.");

    SetProp(P_HP, 0 + 10);


    AddCmd( ({"richte", "faketod", "fake"}), "faketod");
    AddCmd( ({"rfake"}), "rfake");
    AddCmd( ({"realtod"}), "realtod");

    TO->move("/players/iwo/workroom", M_TPORT + M_NOCHECK);

//    call_out("gotoiwo", 15);

}




void mylog (string logtext)
    {
    string text;

    text = sprintf("%s: %s\n", ctime(), logtext);

    write_file(SFILE, text);
    }                                          

void tell_iwo(string text)
    {
    if (find_player("iwo")) 
      tell_object(find_player("iwo"), break_string(text, 78, "TOD: "));
    return;
    }



int killplayer(string method, object player, string reason)
  {
  int damage;
  object ob;

  if (!IS_ARCH(TP) && getuid(TP) != "iwo") return 0;  
  
  if (method == "realdeath") damage = 10000;
  else damage = 0;
  
  if (!find_player(getuid(player)))
    {
      tell_iwo(player->Name() + " VERSUCHT MIR ZU ENTKOMMEN!");
      waitfor += ([player->get_real_name(): method]);
    }
  
  tell_object(player, BS("Der Tod holt mit seiner gewaltigen Sense aus, und "
                         "schlaegt Dir den Kopf ab."));

  clone_object("/gilden/secure/tod/schaedel")->move(ENV(ME), M_NOCHECK + M_SILENT);
		      
  tell_room(environment(player), BS("Der Tod holt mit seiner gewaltigen Sense aus, "
                                    "und schlaegt " + player->Name(WEM) + " den "
				    "Kopf ab."), ({ player }));
  
  if (!reason || reason == "")
  SetProp(P_KILL_NAME, "Der Tod");
  else SetProp(P_KILL_NAME, capitalize(reason));

  player->RemovePursuer(TO);

  if (damage == 0)
    {
      player->SetProp(P_HP, 0);
      player->SetProp(P_GHOST, 1);
      player->move("/room/death/death_room", M_SILENT + M_NOCHECK);
    }
  else player->do_damage(damage);
  
  command_me("rufe FRUEHER ODER SPAETER KRIEGE ICH EUCH ALLE! HAR HAR HAR!");
  
  TO->move(environment(TP), M_GO + M_NOCHECK);
  
  command_me("sag MEISTER, ICH HABE EUREN AUFTRAG AUSGEFUEHRT!");
  
  return 1;
  }






int faketod(string playerstr)
{
  object player;
  string reason;
  
  if (!IS_ARCH(TP) && getuid(TP) != "iwo")
    {
    
      command_me("sag VERSCHWINDE DU ELENDIGER WURM!");
      return 1;
    }
  
  
  if (!playerstr)
    {
    command_me("sag WEN SOLL ICH TOETEN, MEISTER?");
    return 1;
    }
    
  if (!player = find_player(playerstr))
    {
    command_me("sag SO EINEN SPIELER KANN ICH NICHT FINDEN!");
    return 1;
    }
    
  command_me("sag GERNE MEISTER. ICH WERDE UMGEHEND EUREN AUFTRAG ERFUELLEN!");

  mylog(TP->Name() + " hat mir befohlen " + player->Name(WEM) + " einen Faketod zu verpassen.");
  tell_iwo(TP->Name() + " hat mir befohlen " + player->Name(WEM) + " einen Faketod zu verpassen.");
 
  player->AddPursuer(TO);
  TO->move(environment(player), M_TPORT + M_NOCHECK);
  
  call_out("killplayer", 60, "fake", player, reason);

  return 1;
  
}


int rfake(string str)
{
  object player;
  string reason;
  string *split;
  string playerstr;  
  
  
  if (!IS_ARCH(TP) && getuid(TP) != "iwo")
    {
    
      command_me("sag VERSCHWINDE DU ELENDIGER WURM!");
      return 1;
    }

  notify_fail("Usage: rfake <string player> <string reason>\n");
  if (!str) return 0;
  
  split = explode(str, " ");
  
  playerstr = split[0];
  
  split[0] = "";
  
  reason = str[strlen(playerstr)+1..<1];
  
  
  
  if (!playerstr)
    {
    command_me("sag WEN SOLL ICH TOETEN, MEISTER?");
    return 1;
    }
    

  if (!player = find_player(playerstr))
    {
    command_me("sag SO EINEN SPIELER KANN ICH NICHT FINDEN!");
    return 1;
    }
    
  command_me("sag GERNE MEISTER. ICH WERDE UMGEHEND EUREN AUFTRAG ERFUELLEN!");

  mylog(TP->Name() + " hat mir befohlen " + player->Name(WEM) + " einen Faketod zu verpassen.");
  tell_iwo(TP->Name() + " hat mir befohlen " + player->Name(WEM) + " einen Faketod zu verpassen.");
 
  player->AddPursuer(TO);
  TO->move(environment(player), M_TPORT + M_NOCHECK);
  
  call_out("killplayer", 60, "fake", player, reason);

  return 1;
  
}


int gotoiwo()
{
  if(find_player("iwo")) find_player("iwo")->AddPursuer(TO);

  return 1; 
}
