/* 

   Ein Drider der die Dunkelelfen im Kampf unterstuetzen kann
   Zordan@SL

*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#include "/gilden/dunkelelfen/dunkelelfen.h"

int removing;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  removing=0;

  SetProp(P_SHORT, "Ein Drider");
  SetProp(P_NAME, "Drider");
  SetProp(P_GENDER, MALE);
  AddId( ({"drider", D_DRIDER}) );
  create_default_npc(1);
  SetProp(P_HANDS, ({"mit einem seiner Beine",100,DT_PIERCE}));
  SetProp(P_RACE, "Drider");
  SetProp(P_XP, 0);
  SetProp(P_SIZE, 200+random(20));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL,0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(D_CASTER, 0);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.5, DT_COLD:      0.0, DT_WATER:  -0.1, DT_AIR:    0.0,
      DT_LIGHTNING: -0.1, DT_EXPLOSION: 0.5, DT_SOUND:  0.0, DT_LIGHT:  0.5,
      DT_ELECTRIC:  0.1, DT_ACID:      0.1, DT_POISON: -0.8, DT_TERROR: -1,
      DT_HOLY:      1, DT_UNHOLY:    -1, DT_MAGIC:  -0.8 ]) );

  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MMSGIN, "krabbelt");
  SetProp(P_MMSGOUT, "krabbelt"); 
  SetProp(P_DIE_MSG,  " verschwindet in einer dunklen Wolke.\n");
  SetProp(P_NOCORPSE,1);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_KILL_NAME, "Ein Drider");
  SetProp(P_KILL_MSG, "Lloth hat mir befohlen Dich zu toeten!");
  AddInfo(DEFAULT_INFO, "ist stumm.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Drider achtet nicht einmal auf Dich.\n" }) );
}

init() {
  object ob;
  ::init();
  ob=find_living(LOWER(QueryProp(D_CASTER)));
  if(!ob) {
    say(BS("Der Drider verschwindet in einer dunklen Wolke.\n"));
    ME->remove();
    return;
  }
  if(ob && ob->QueryProp(P_GHOST)) {
    say(BS("Der Drider verschwindet in einer dunklen Wolke.\n"));
    ME->remove();
  }
  if(objectp(ob) && present(getuid(ob))) 
    ob->AddDefender(TO);
}

reset() {
  ::reset();
  say(BS("Der Drider verschwindet in einer dunklen Wolke.\n"));
  ME->remove();
}

InformDefend(object enemy) {
  ::InformDefend();
  if(!QueryProp(P_FRIEND)) return;
  ME->Kill(enemy);
  if(!removing) {
    call_out("removemenow", QueryProp(P_LEVEL)*2);
    removing=1;
  }
}

removemenow() {
  say(BS("Der Drider verschwindet in einer dunklen Wolke.\n"));
  ME->remove();
}

void remove() {
  object ob;
  if(ME->QueryProp(D_CASTER) != 0) {
    if (ob=find_living(LOWER(ME->QueryProp(D_CASTER)))) {
      ob->RemovePursuer(ME);
    } else if (ob=find_netdead(LOWER(ME->QueryProp(D_CASTER)))) {
      ob->RemovePursuer(ME);
    }
  }
  ::remove();
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  player->RemovePursuer(ME);
}
