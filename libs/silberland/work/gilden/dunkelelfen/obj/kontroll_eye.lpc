
inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object caster;
object victim;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"\nkontroll_eye", }));
  SetProp (P_GENDER, NEUTER);
  SetProp (P_NAME, "MagicEye");
  SetProp (P_SHORT, "Ein MagicEye");
  SetProp (P_LONG, "keine long");

  SetProp (P_ALIGN, 0);
  create_default_npc(1);
  SetProp (P_SIZE, 30);
  SetProp (P_MAX_HP, random(10)+5);
  SetProp (P_WIMPY, QueryProp(P_MAX_HP)-5);
  SetProp (P_HP, QueryProp(P_MAX_HP));
  SetProp (P_WEIGHT, 2000);
  SetProp (P_RACE, "Karnickel");
  SetProp (P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp (P_XP, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_FRIEND, 1);
  SetProp(P_NOATTACK, 1);
}


int StartUp(object c, object v)
  {
  caster = c;
  victim = v;

  victim->AddPursuer(this_object());

  return 1;

  }


void catch_tell(string str)
  {
  if (!interactive(caster) || !living(victim))
    {
    remove();
    }
  else
    tell_object(caster, str);
  return;
  }
  
 