/* Das object fuer kontrolliere
   iwo@SL
*/

inherit "std/thing";

#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include "/gilden/dunkelelfen/dunkelelfen.h"

int dauer;
int timestamp;
object caster;
object victim;


int debug = 0;


create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0 );
  SetProp(P_NAME, "\nkontrollobj");
  SetProp(P_GENDER, NEUTER);
  AddId( "\nkontrollobj", "obj" );
  SetProp(P_WEIGHT,0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);

  // Wird nun ueber input_do abgewickelt
  // AddCmd( ({"befehl", "befehle", "zwinge" }), "victim_do");



}



int get_tha_cmd()
{

  if (time() < (timestamp + dauer))
    {
      tell_object(caster, ":>");
      input_to("victim_do");
      
      if (debug)
        tell_object(find_player("iwo"), "Warte auf input.\n");
    }

  else
    {
    remove();    
    }
  
  return 1;
}




int StartUp(object c, object v, int d)
{
  caster = c;
  victim = v;
  dauer = d;




  if (debug)
    tell_object(find_player("iwo"), sprintf("Caster: %s, Victim: %s, Dauer: %d", caster->Name(), victim->Name(), dauer));  


  call_out("remove", dauer + 30);

  timestamp = time();

  tell_object(caster, BS("Mit einem kurzen mentalen Ruck zerstoerst Du den "
                         "Geist des Lebewesens und vereinigst Dich mit "
                         "seinem erloeschenden Dasein."));
  call_out("sup2", 5);

  return 1;
}


int sup2()
{
  tell_object(caster, BS("Der Atem Todes trifft Deinen Koerper und greift "
                         "mit toedlicher Kaelte nach Deinem Geist."));
  tell_object(caster, BS("Leblos sackst Du zu Boden."));
  tell_room(ENV(caster), BS(caster->Name(WER) + " sackt leblos zu Boden."), ({ caster }) );

  call_out("sup3", 5);

  return 1;
}


int sup3()
{
  tell_object(caster, BS("Langsam beginnst Du die Umgebung durch die leblosen "
                         + "Augen Deines Opfers wahrzunehmen."));

  call_out("sup4", 5);

   return 1;
}

int sup4()
{
  string longint;
  object ob;


  tell_object(caster, BS("Du hast nun Kontrolle ueber Koerper und Geist des Wesens."));
  victim->SetProp(P_NOATTACK, 0);

  longint = sprintf("%sDie Augen wirken merkwuerdig.", victim->QueryProp(P_LONG));
  victim->AddDetail(({"auge", "augen"}), "Die Augen wirken kalt und leer, als waere "
                                        +"das Leben hinter ihnen erloschen.");
  victim->SetProp(P_LONG, longint);

  victim->enable_commands();

  caster->SetProp(P_PARALYZED, 0);

  // MagicEye laden
  ob = clone_object( OBJ("kontroll_eye"));
  ob->move(environment(victim), M_GO + M_SILENT);
  ob->StartUp(caster, victim);


  call_out("get_tha_cmd", 0);

}               



void look_around()
{
  tell_object(caster, environment(victim)->int_long( caster,victim,0 )); 
}




string parse_action(string action)
{
  string * cmd;
  
  // HIER ALLE ACTIONS PARSEN, AUCH SAG, EBENEN,....
  // SAUBER PROGGEN !!!!!!

  cmd = explode(action, " ");
  
  switch(cmd[0])
    {
    
    // Spielercommandos
    case "rufe"     : caster->command_me(action);
                      break;
    case "ruf"      : caster->command_me(action);
                      break;
    // Victim kann nun reden
    //case "sag"    : caster->command_me(action);
    //                  break;
    //case "sage"   : caster->command_me(action);
    //                  break;
    case "teile"    : caster->command_me(action);
                      break;
    case "teil"     : caster->command_me(action);
                      break;
    case "tm"       : caster->command_me(action);
                      break;
    case "wer"      : caster->command_me(action);
                      break;
    case "kwer"     : caster->command_me(action);
                      break;
    case "fwer"     : caster->command_me(action);
                      break;
    case "finger"   : caster->command_me(action);
                      break;
    case "kkwer"    : caster->command_me(action);
                      break;
    case "hist"     : caster->command_me(action);
                      break;
    case "thist"    : caster->command_me(action);
                      break;
    
    // Steuerkommandos
    case "stirb"    : call_out("remove", 1);
                      break;
    case "schau"    : look_around();
                      break;
    case "schaue"   : look_around();
                      break;

    
    // Himmelsrichtingen und so
    case "n"        : victim->command_me("norden");
                      break;
    case "no"       : victim->command_me("nordosten");
                      break;
    case "o"        : victim->command_me("osten");
                      break;
    case "so"       : victim->command_me("suedosten");
                      break;
    case "s"        : victim->command_me("sueden");
                      break;
    case "sw"       : victim->command_me("suedwesten");
                      break;
    case "w"        : victim->command_me("westen");
                      break;
    case "nw"       : victim->command_me("nordwesten");
                      break;
    case "ob"       : victim->command_me("oben");
                      break;
    case "u"        : victim->command_me("unten");
                      break;
    
    
    // Verbotene Kommandos
    case "nimm"     : break;
    case "nehme"    : break;
    case "verkaufe" : break;
    case "toete"    : break;    
    case "lege"     : break;
    case "leg"      : break;    
    case "kaufe"    : break;
    case "gib"      : break;
    
    
    // Wenns nicht parsed wird, dann ausfuehren
    default         : // Die Ebenen werden hier abgefangen
                      if (cmd[0][0..0] == "-")
		        {
			caster->command_me(action);
			}
		      else
		        {
			victim->command_me(action);
			}
			
                      break;
		      		       
    } /* switch(cmd[0]) */

}







int victim_do(string action)
{
  string * chk;
  object oldenv,newenv;
  int checkval;

  if (!living(victim))
    {
    remove();
    return 0;
    }

  oldenv = environment(victim);

  notify_fail("Was soll Dein Opfer machen?\n");

  if (!action || action =="")
    {
    call_out("get_tha_cmd");
    return 1;
    }

  caster->AddSp(-random(2));
  
  parse_action(action);
  
  if(!objectp(victim))
  {
    remove();
    return 0;
  }
  
  if(newenv = environment(victim))
    if (oldenv != newenv)
      look_around();

  if (caster->QueryProp(P_SP) <= 0)
    {
    remove();
    return 0;
    }

  get_tha_cmd();

  return 1;

}



reset() {
  if (!MENV || !interactive(MENV)) remove();
  if (!living(victim) || !living(caster)) remove();
  if (time() > time() + (2 * dauer)) remove();
  // Kein reset wegen den Variablen
  //::reset();
}


remove()
{
  if ((caster) && interactive(caster)) tell_object(caster, BS("Ploetzlich weicht jegliches Leben aus dem Koerper Deines Opfers."));
  if (living(victim)) victim->die();
  return ::remove();
}
