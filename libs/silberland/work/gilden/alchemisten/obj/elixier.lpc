#include <properties.h>
inherit "/std/thing";
#include "/gilden/alchemisten/def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_LONG, 
    "Ein Elixierflaeschchen.");
  SetProp(P_SHORT, "Ein Elixier"); 
  AddId(({"elixier", "elixierflaeschchen", "flaeschchen" }));
  SetProp(P_NAME, "Elixier");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_MAGIC, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_DRUG: 100]));
}

string short()
{  
  if(!QueryProp(P_ALCH_ELIXIER)) return ::short();
  return (QueryProp(P_SHORT) + " ("+QueryProp(P_ALCH_ELIXIER)+").\n");
}
