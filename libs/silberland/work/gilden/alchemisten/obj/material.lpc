inherit "std/unit";

#include <properties.h>
#include <language.h>

#ifndef MATMASTER
#define MATMASTER "/p/daemon/materialdb.lpc"
#endif

#ifndef P_ALCH_MAT
#define P_ALCH_MAT "a_mat"
#endif

create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  AddId( ({"material"}) );
  SetCoinsPerUnits(1,1);
  SetGramsPerUnits(1,1);
  SetProp(P_NAME, ({"Material", "Materialien"}));
  SetProp(P_GENDER, NEUTER);
//  if(objectp(previous_object()) && previous_object()->id("alch_material\n"))
//    SetMaterial(previous_object()->QueryProp(P_ALCH_MAT));
}


varargs int SetMaterial(string emat, string dmat)
{
  if(!dmat) dmat = MATMASTER->MaterialName(emat, 0, 100);
  if(!emat) return 0;

  SetProp(P_ALCH_MAT, emat);
  emat=lower_case(emat);
  dmat=lower_case(dmat);

  SetProp(P_SHORT, "Gramm "+capitalize(dmat));
  SetProp(P_NAME,({"Gramm "+capitalize(dmat),
                   "Gramm "+capitalize(dmat)}));

  RemoveId(({ dmat, "alch_material\n"}));
  RemoveSingularId( ({"gramm "+dmat}) );
  RemovePluralId( ({"gramm "+dmat}) );

  AddSingularId( ({"gramm "+dmat}) );
  AddPluralId( ({"gramm "+dmat}) );
  AddId(({ dmat, "alch_material\n"}));

  SetProp(P_MATERIAL, emat );
  return 1;
}

varargs int move(mixed dest, int method)
{
  int ret;
  object ob;

  ret = ::move(dest, method);
  if(objectp(ob=QueryProp(P_GIVEN_OBJECT))) 
    ob->SetMaterial(QueryProp(P_ALCH_MAT));
  return ret;
}
