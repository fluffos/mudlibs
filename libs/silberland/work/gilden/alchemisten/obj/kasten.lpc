#include <properties.h>
inherit "/std/container";
#include "/gilden/alchemisten/def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_LONG, 
    "Ein typischer Alchemiebaukasten fuer Alchemisten.");
  SetProp(P_SHORT, "Ein Alchemiebaukasten"); 
  AddId(({"kasten", "alchemiebaukasten", "baukasten", "alch_kasten\n"}));
  SetProp(P_NAME, "Alchemiebaukasten");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 500);
  SetProp(P_WEIGHT_PERCENT, 0);
  SetProp(P_MAX_WEIGHT, 10000000); // in Worten: 10 Millionen
  SetProp(P_VALUE, 0);
  SetProp(P_MAGIC, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD: 90, MAT_IRON:10]));
}

varargs int PreventInsert(object ob)
{
  if(!ob->id("alch_material\n")) return 1;
  else return 0;
}
