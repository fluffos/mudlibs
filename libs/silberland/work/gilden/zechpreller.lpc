public int cmd_forget_talents(string str) {
  if(!IsGuildMember(TP)) {
    write(BSA("Verschwind!!!\n", "Zechus lallt: "));
    return 1;
  }

  write(BSA("Bischt da sicha??? [ja/nein]", "Zechus lallt: "));
  input_to("confirm_delete_talents");
  return 1;
}

public void confirm_delete_talents(string yesno) {
  if(yesno != "ja" && yesno != "j") yesno = "nein";

  if(yesno == "nein") {
    write(BS("Abgebrochen."));
    return;
  }

  write(BS("Zechus fuellt dir einen starken Schnaps ab, den du gleich reinkippst..."));
  write(BS("... und SCHWUPS! Alles vergessen!"));
  ZTMASTER->ResetTalents(TP);
  return;
}

nosave mixed *QueryTalentTrees()
{
  mixed trees, entry;
  mixed *result;
  string *indices;
  int i, j;

  trees = ZT_TREES;
  result = ({});

  if(mappingp(trees)) {
    indices = sort_array(m_indices(trees), #'<); //')
    for(i = 0; i < sizeof(indices); i++) {
      result += ({ ({ indices[i], trees[indices[i]] }) });
    }
    return result;
  }

  if(pointerp(trees)) {
    for(i = 0; i < sizeof(trees); i++) {
      entry = trees[i];
      if(mappingp(entry)) {
        indices = sort_array(m_indices(entry), #'<); //')
        for(j = 0; j < sizeof(indices); j++) {
          result += ({ ({ indices[j], entry[indices[j]] }) });
        }
        continue;
      }
      if(stringp(entry) && i + 1 < sizeof(trees) && pointerp(trees[i + 1])) {
        result += ({ ({ entry, trees[i + 1] }) });
        i++;
      }
    }
  }

  return result;
}

public int get_available_talent_points(object pl)
{
  mixed *tree_entries, *tiers, tier;
  int i, j, k, spent, available, glevel, extra, talent, lvl;

  if(!objectp(pl))
    return 0;

  tree_entries = QueryTalentTrees();

  for(i = 0; i < sizeof(tree_entries); i++) {
    tiers = tree_entries[i][1];
    if(!pointerp(tiers))
      continue;
    for(j = 0; j < sizeof(tiers); j++) {
      tier = tiers[j];
      if(!pointerp(tier))
        continue;
      for(k = 0; k < sizeof(tier); k++) {
        talent = tier[k];
        if(!intp(talent))
          continue;
        lvl = ZTMASTER->GetTalent(pl, talent);
        if(lvl > 0)
          spent += lvl;
      }
    }
  }

  glevel = pl->QueryProp(P_GUILD_LEVEL);
  if(glevel < 0)
    glevel = 0;
  available = glevel;
  if(available > 9)
    available = 9;
  extra = glevel - 9;
  if(extra < 0)
    extra = 0;
  if(extra > 2)
    extra = 2;
  available += extra * 2;

  available -= spent;
  if(available < 0)
    available = 0;
  return available;
}

public int cmd_raise_talent(string str)
{
  mixed *tree_entries, *tiers, tier;
  string *names;
  string talent_name, lowered, condensed, key;
  mapping tier_points;
  int i, j, k, talent, lvl, prev_sum;
  int tier_index, tree_index, tier_sum, current, free_points;

  if(!IsGuildMember(TP)) {
    write(BSA("Verschwind!!!\n", "Zechus lallt: "));
    return 1;
  }

  tree_entries = QueryTalentTrees();
  if(!sizeof(tree_entries)) {
    write(BSA("Hier gibt es noch keine Talente.\n", "Zechus lallt: "));
    return 1;
  }

  notify_fail("Was willst Du erhoehen?\n");
  if(!stringp(str) || !strlen(str))
    return 0;

  lowered = lower_case(str);
  sscanf(lowered, "talent %s", lowered);

  while(strlen(lowered) && lowered[0] == ' ')
    lowered = lowered[1..];
  while(strlen(lowered) && lowered[strlen(lowered)-1] == ' ')
    lowered = lowered[0..strlen(lowered)-2];
  if(!strlen(lowered))
    return 0;

  condensed = regreplace(lowered, " ", "", 1);
  names = ZT_TALENT_NAMES;
  talent = -1;
  for(i = 0; i < sizeof(names); i++) {
    if(!stringp(names[i]))
      continue;
    if(lower_case(names[i]) == lowered ||
       regreplace(lower_case(names[i]), " ", "", 1) == condensed) {
      talent = i;
      break;
    }
  }
  if(talent < 0) {
    if(sscanf(lowered, "%d", i) == 1)
      talent = i;
  }

  if(talent < 0 || talent >= MAX_TALENT_NR) {
    notify_fail(BSA("So ein Talent kenn ich nicht!\n", "Zechus lallt: "));
    return 0;
  }

  tier_index = -1;
  tree_index = -1;
  for(i = 0; i < sizeof(tree_entries); i++) {
    tiers = tree_entries[i][1];
    if(!pointerp(tiers))
      continue;
    for(j = 0; j < sizeof(tiers); j++) {
      tier = tiers[j];
      if(!pointerp(tier))
        continue;
      for(k = 0; k < sizeof(tier); k++) {
        if(intp(tier[k]) && tier[k] == talent) {
          tree_index = i;
          tier_index = j;
          break;
        }
      }
      if(tree_index != -1)
        break;
    }
    if(tree_index != -1)
      break;
  }

  if(tree_index == -1) {
    write(BSA("Dieses Talent gibt's hier nicht.\n", "Zechus lallt: "));
    return 1;
  }

  lvl = ZTMASTER->GetTalent(TP, talent);
  if(lvl >= 3) {
    write(BSA("Mehr als dreimal geht das nich!\n", "Zechus lallt: "));
    return 1;
  }

  free_points = get_available_talent_points(TP);
  if(free_points <= 0) {
    write(BSA("Du hast keine Talentpunkte mehr frei!\n", "Zechus lallt: "));
    return 1;
  }

  tier_points = ([]);
  for(i = 0; i < sizeof(tree_entries); i++) {
    tiers = tree_entries[i][1];
    if(!pointerp(tiers))
      continue;
    for(j = 0; j < sizeof(tiers); j++) {
      tier = tiers[j];
      if(!pointerp(tier))
        continue;
      tier_sum = 0;
      for(k = 0; k < sizeof(tier); k++) {
        if(!intp(tier[k]))
          continue;
        current = ZTMASTER->GetTalent(TP, tier[k]);
        if(current > 0)
          tier_sum += current;
      }
      key = sprintf("%d:%d", i, j);
      tier_points[key] = tier_sum;
    }
  }

  if(tier_index > 0) {
    key = sprintf("%d:%d", tree_index, tier_index - 1);
    prev_sum = tier_points[key];
    if(prev_sum < 2) {
      write(BSA("Vorher musst Du erst die fruehere Stufe besser kennen!\n",
                "Zechus lallt: "));
      return 1;
    }
  }

  lvl++;
  ZTMASTER->SetTalent(TP, talent, lvl);
  if(talent < sizeof(names) && stringp(names[talent]))
    talent_name = names[talent];
  else
    talent_name = sprintf("Talent %d", talent);
  write(BSA(sprintf("Alles klar, %s is jetzt auf Stufe %d.\n",
                    talent_name, lvl),
            "Zechus lallt: "));
  return 1;
}

public int cmd_show_talents(string str)
{
  mixed *tree_entries, *tiers, tier;
  string *names;
  string output, tree, talent_name, marks;
  int i, j, k, talent, level, l;

  if(!IsGuildMember(TP)) {
    write(BSA("Verschwind!!!\n", "Zechus lallt: "));
    return 1;
  }

  tree_entries = QueryTalentTrees();
  if(!sizeof(tree_entries)) {
    write(BSA("Hier gibt es noch keine Talente.\n", "Zechus lallt: "));
    return 1;
  }
  names = ZT_TALENT_NAMES;

  output = sprintf("Hier sind deine Talente.\nDu hast noch %d freie Talentpunkte.\n", get_available_talent_points(TP));

  for(i = 0; i < sizeof(tree_entries); i++) {
    tree = tree_entries[i][0];
    tiers = tree_entries[i][1];
    output += "\n" + tree + ":\n";
    if(!pointerp(tiers))
      continue;
    for(j = 0; j < sizeof(tiers); j++) {
      output += sprintf("  Stufe %d\n", j+1);
      tier = tiers[j];
      if(!pointerp(tier))
        continue;
      for(k = 0; k < sizeof(tier); k++) {
        talent = tier[k];
        if(!intp(talent))
          continue;
        if(talent >= 0 && talent < sizeof(names))
          talent_name = names[talent];
        else
          talent_name = sprintf("Talent %d", talent);
        level = ZTMASTER->GetTalent(TP, talent);
        if(level < 0)
          level = 0;
        if(level > 3)
          level = 3;
        marks = "";
        for(l = 0; l < level && l < 3; l++)
          marks += "#";
        while(strlen(marks) < 3)
          marks += " ";
        output += sprintf("    %-15s [%s] %s\n", talent_name, marks, ZT_TALENT_DESCR[talent]);
      }
    }
  }

  TP->More(output);
  return 1;
}

string topdrinker()
{
  string str;
  str = "Mit Kreide wurde folgendes auf die Tafel geschrieben:\n";
  str+=call_other(ZECHMASTER, "GetTopDrinker");
  TP->More(str);
  return "";
}

int erbe(string str)
{
  object quest;
  int xp, percent;
  string dummy;

  // GS 11 ready by Gwenshara 01.09.09
  //notify_fail("Derzeit ist das nur Testspielern moeglich!\n");
  //if(!TP->QueryProp(P_TESTPLAYER)) return 0;

  notify_fail("Wem willst Du folgen?\n");
  if(!str || str == "") return 0;
  notify_fail("So einen Gildengruender gab es nie!\n");
  if(!(str == "zechus" ||
       str == "tarxes" ||
       str == "artanok" ||
       str == "lanestra" )) return 0;

  notify_fail("Ohne Zechus geht das nicht!\n");
  if(!present("\nzechusprellus", TO)) return 0;
  notify_fail("Du bist doch schon Gildenerbe!\n");
  if(TP->QueryProp(P_GUILD_LEVEL) > 10) return 0;
  
  if(TP->QueryProp(P_GUILD_LEVEL) != 10 || TP->QueryProp(P_LEVEL) < 60)
  {
    say(BSA("Du kannscht noch keinem Gildenerben folgen, "+TPN+"! Du "
          "musscht dafuer Gildenstufe 10 und Spielerstufe 60 erreicht "
          "haben!", "Zechus lallt: "));
    write(BSA("Du kannscht noch keinem Gildenerben folgen, "+TPN+"! Du "
          "musscht dafuer Gildenstufe 10 und Spielerstufe 60 erreicht "
          "haben!", "Zechus lallt: "));
    return -1;
  }

  dummy = "";
  xp = call_other(ZECHMASTER, "GetXpDifference", TP, TP->QueryProp(P_XP));
  if(xp>0)
  {
    percent = (int) -(100*xp/10000000)+100;
    dummy   = "Dasch kannscht noch nicht, "+TPN+"! Du musscht noch ";
    switch(percent)
    {
      case 0 .. 5:  dummy+="kaum etwas an";
               break;
      case 6 .. 20: dummy+="weniger als ein Viertel an";
               break;
      case 21 .. 30: dummy+="etwa ein Viertel der";
                break;
      case 31 .. 45: dummy+="weniger als die Haelfte der";
                break;
      case 46 .. 55: dummy+="etwa die Haelfte der";
                break;
      case 56 .. 60: dummy+="mehr als die Haelfte der";
                break;
      case 61 .. 70: dummy+="weniger als drei Viertel der";
                break;
      case 71 .. 80: dummy+="etwa drei Viertel der";
                break;
      case 81 .. 90: dummy+="mehr als drei Viertel von der";
                break;
      case 91 .. 95: dummy+="fast die ganze";
                break;
      default: dummy+="die ganze";
               break;
    }
    dummy+=" Erfahrung fuer <HICKS> die letschte Gildenstufe schammeln!";
  }

  if(TP->QuerySkillAbility("prelle")<9500 ||
       TP->QuerySkillAbility("identifiziere")<9500 ||
       TP->QuerySkillAbility("schaetz")<9500 ||
       TP->QuerySkillAbility("ruelpser") <9500 ||
       TP->QuerySkillAbility("uebergeben") <9500 ||
       TP->QuerySkillAbility("destilliere")<9500 ||
       TP->QuerySkillAbility("anhauchen")<9500 ||
       TP->QuerySkillAbility("rumkugeln")<9500 ||
       TP->QuerySkillAbility("staenkern")<9500 ||
       TP->QuerySkillAbility("groehlen") <9500 ||
       TP->QuerySkillAbility("dunstpanzer")<9500 ||
       TP->QuerySkillAbility("alkoholisiere") <9500 ||
       TP->QuerySkillAbility("torkeln")<9500 ||
       TP->QuerySkillAbility("alkoholwolke")<9500 ||
       TP->QuerySkillAbility("trunkspruch")<9500 ||
       TP->QuerySkillAbility("weingeist")<8000) dummy+=" Du musscht Deine "+
       "Zauber noch mehr ueben!";

  if(!TP->QueryProp(P_TESTPLAYER))
    if(call_other("/secure/questmaster", "QueryAllQP")>TP->QueryProp(P_QP))
      dummy+=" Du musscht erschtmal alle Abenteuer bestehen!";
    
  if(dummy != "")
  {
    say(BSA(dummy, "Zechus lallt: "));
    write(BSA(dummy, "Zechus lallt: "));
    return 1;
  }

  if(present("\nzechpreller_quest_11", TP))
  {
    say(BSA("Du versuchscht es doch schon!", "Zechus lallt: "));
    write(BSA("Du versuchscht es doch schon!", "Zechus lallt: "));
    return 1;
  }
  
  quest = clone_object(OBJ("quest_lvl11"));
  quest->move(TP);
  write("Du willst dem Erbe von "+CAP(str)+" folgen.\n");
  if(str == "zechus")
  {
     dummy = "Aaaahhhh! Du willscht also mir nach <HICKS> folgen... "+
             "Dann passch auf! Du musscht jene Gegner, die auch ich "+
	     "auf meiner Reise erledigt hat umhaun, klar?! Welche das sind "+
	     "verraten Dir die alten Geschichten! Worauf wartescht! Eine "
	     "Stunde hast Zeit! AB JETZT!!!!";
     quest->Start(ZECHUS_NPC, ERBE_ZECHUS, TP);
  }
  if(str == "lanestra")
  {
    dummy =  "Aaaahhhh! Du willscht also Lanestra nach <HICKS> folgen... "+
             "Dann passch auf! Du musscht jene Gegner, die auch Lanestra "+
	     "auf ihrer Reise erledigt hat umhaun, klar?! Welche das sind "+
	     "verraten Dir die alten Geschichten! Worauf wartescht! Eine "
	     "Stunde hast Zeit! AB JETZT!!!!";
    quest->Start(LANESTRA_NPC, ERBE_LANESTRA, TP);
  }
  if(str == "artanok")
  {
    dummy =  "Aaaahhhh! Du willscht also Artanok nach <HICKS> folgen... "+
             "Dann passch auf! Du musscht jene Gegner, die auch Artanok "+
	     "auf seiner Reise erledigt hat umhaun, klar?! Welche das sind "+
	     "verraten Dir die alten Geschichten! Worauf wartescht! Eine "
	     "Stunde hast Zeit! AB JETZT!!!!";
    quest->Start(ARTANOK_NPC, ERBE_ARTANOK, TP);
  }
  if(str == "tarxes")
  {
    dummy =  "Aaaahhhh! Du willscht also Tarxes nach <HICKS> folgen... "+
             "Dann passch auf! Du musscht jene Gegner, die auch Tarxes "+
	     "auf seiner Reise erledigt hat umhaun, klar?! Welche das sind "+
	     "verraten Dir die alten Geschichten! Worauf wartescht! Eine "
	     "Stunde hast Zeit! AB JETZT!!!!";
    quest->Start(TARXES_NPC, ERBE_TARXES, TP);
  }

  say(BSA(dummy, "Zechus lallt: "));
  write(BSA(dummy, "Zechus lallt: "));
  return 1;
}

int tl(string str)
{
  if(!(TP->QueryProp(P_TESTPLAYER) || !(TP->QueryProp(P_GUILD) == "zechpreller"))) return 0;
  if(str == "keulenkampf")
  {
    TP->ModifySkill(FIGHT(WT_CLUB),QuerySkill(FIGHT(WT_CLUB)),0, "zechpreller" );
    write("Keulenkampf gelernt.\n");
  }
  else if(str == "trinklied")
  {
    LearnSpell("trinklied", TP);
    write("Trinklied gelernt.\n");
  }
  else if(str == "donnerruelpser")
  {
    LearnSpell("donnerruelpser", TP);
    write("Donnerruelpser gelernt.\n");
  }
  else if(str == "improvisiere")
  {
    LearnSpell("improvisiere", TP);
    write("Improvisiere gelernt.\n");
  }
  else if(str == "fahne")
  {
    LearnSpell("fahne", TP);
    write("Fahne gelernt.\n");
  }
  write("Kein solcher SpelL!\n");
  return 1;
}

/* Ausgabe in der P_INT_LONG */
string maghelp()
{
 if(!IS_LORD(TP)) return "";
 return "\nMagInfo: Hilfe fuer Magierbefehle mit 'gilde hilfe'.";
}

int magfunc(string str)
{
  //nur Gildenmagier und R+ d|rfen
  if(!(IS_LORD(TP) || member(GILDENMAGIER, getuid(TP)))) return 0;
  if(!str) str="hilfe";
  if(str=="hilfe") {
   write("Folgende Befehle sind moeglich:\n"
        +"gilde hilfe  : Dieses hier\n"
        +"gilde backup : Backup des Memberfiles (Arch-only)\n"
        +"gilde restore: Zurueckspielen des Backups (Arch-only)\n"
        +"gilde toplist: Updaten der Topliste\n");
   return 1;
  }
  if(str=="backup" && IS_ARCH(TP)) {
    call_other(ZECHMASTER, "DoBackup"); 
    tell_object(TP, "Kopiere members/members.o nach "
             +"backup/members_backup.o\n");
    return 1;
  }
  if(str=="restore" && IS_ARCH(TP)) {
    if(call_other(ZECHMASTER, "DoRestore")==-2){
      tell_object(TP, "Fehler! Members.o konnte nicht restored "
                 +"werden!\n");
      return 1;
    } 
    tell_object(TP, "Kopiere backup/members_backup.o nach "
               +"members.o\n");
    return 1;
  }
  if(str=="toplist") {
    call_other(ZECHMASTER, "UpdateMemberLevels");
    call_other(ZECHMASTER, "UpdateTopList");
    call_other(ZECHMASTER, "MakeReadList");
    call_other(ZECHMASTER, "SetNumberOne");
    tell_object(TP, "Memberliste ist nun up-to-date.\n");
    return 1;
  }
 tell_object(TP, "Befehl nicht moeglich!\n");
 return 1;
}


/* Bestenliste */
string liste()
{
 TP->More("\nDIE BESTEN SAEUFER:\n\n"+read_file(REALTOPLIST));
 tell_room(TO, BS(sprintf("%s schaut sich die Liste genauer an.", 
           TP->Name(WER))), ({TP}));
 return "";
}

/* Backup der Memberliste */
reset()
{
  ::reset();
  zaehler++;
  if(zaehler==1) {
    call_other(ZECHMASTER, "UpdateTopList");
    call_other(ZECHMASTER, "MakeReadList");
    call_other(ZECHMASTER, "SetNumberOne");
  }
  if(zaehler==5) {
    call_other(ZECHMASTER, "DoBackup"); 
    zaehler=0;
  }
}

/* Skillablilty am Anfang in einen Bereich 2000..4000 setzen */
nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if(value<2000) value=2000;
  else if(value>4000) value=4000;
  return value;
}

#define TG(x) if(objectp(find_player("gwenshara")))\
	        tell_object(find_player("gwenshara"),\
		            break_string(x, 78, "ZECH: "))

int GuildRating(object pl)
{
    int spellrating, stufenrating, rating;
    string erbe;

    // Spellrating berechnen
    spellrating = 0;
    spellrating += pl->QuerySkillAbility(SK_BOOZE);
    spellrating += pl->QuerySkillability(FIGHT(WT_CLUB));
    spellrating += pl->QuerySkillAbility("alkoholisiere");
    spellrating += pl->QuerySkillAbility("alkoholwolke");
    spellrating += pl->QuerySkillAbility("anhauchen");
    spellrating += pl->QuerySkillAbility("destilliere");
    spellrating += pl->QuerySkillAbility("dunstpanzer");
    spellrating += pl->QuerySkillAbility("groehlen");
    spellrating += pl->QuerySkillAbility("identifiziere");
    spellrating += pl->QuerySkillAbility("prelle");
    spellrating += pl->QuerySkillAbility("ruelpser");
    spellrating += pl->QuerySkillAbility("rumkugeln");
    spellrating += pl->QuerySkillAbility("schaetz");
    spellrating += pl->QuerySkillAbility("staenkern");
    spellrating += pl->QuerySkillAbility("torkeln");
    spellrating += pl->QuerySkillAbility("trunkspruch");
    spellrating += pl->QuerySkillAbility("uebergeben");
    spellrating += pl->QuerySkillAbility("weingeist");

    /*TG(sprintf("Rating(%s) = ::spellrating = %d)",
       getuid(pl), spellrating));*/

    if(pl->QueryProp(P_GUILD_LEVEL) > MAX_GUILD_LEVEL)
    {
      erbe = call_other(ERBMASTER, "QueryErbe", pl);
      
      if(erbe ==ERBE_ARTANOK)
        spellrating += pl->QuerySkillAbility("improvisiere");
      if(erbe ==ERBE_LANESTRA)
        spellrating += pl->QuerySkillAbility("trinklied");
      if(erbe ==ERBE_TARXES)
        spellrating += pl->QuerySkillAbility("donnerruelpser");
      if(erbe ==ERBE_ZECHUS)
        spellrating += pl->QuerySkillAbility("fahne");
    }

    spellrating = (int) (spellrating/19);
/*    TG(sprintf("Rating(%s) = ::spellrating(%d)",
       getuid(pl), spellrating));*/

    // Stufenrating berechnen
    stufenrating = 0;
    stufenrating = (int) (pl->QueryProp(P_GUILD_LEVEL)/11.0*10000);
/*    TG(sprintf("Rating(%s) = ::stufenrating(%d)",
       getuid(pl), stufenrating));*/

    // Gesamtrating
    rating = (int) ((spellrating*0.6)+(stufenrating*0.4));
/*    TG(sprintf("Rating(%s) = ::rating(%d)",
       getuid(pl), rating));*/

    return pl->SetProp(P_GUILD_RATING, rating);
}


/* So gehts nicht :> */
int falscher_syntax()
{
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nix!\n"));
    return 1;
  }
  write(BSA("Du muscht mich schon fragen oder <Hicks!> einfach "
           +"'tritt gilde bei' eingeben. So isch dasch, jaja...",
            "Zechus lallt Dir ins Ohr: "));
  return 1;
}

/* Austritt aus der Gilde */
int austreten()
{
  object ob;
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  }      
  if(TP->QueryProp(P_GUILD) != "zechpreller")
  {
    write(BS("Das geht wohl nur als Zechpreller."));
    return 1;
  }
  if(TP->QueryProp(P_GUILD_LEVEL) > 10)
  {
    write(BSA("Da Du dasch Erbe unscherer Gilde angenommen hascht, "
          "ischt es Dir nicht mehr moeglich schie zu verlassen!",
          "Zechus lallt: "));
    say(BS(TPN+" spricht mit Zechus."));
    return 1;
  }
  
  this_player()->SetProp( P_GUILD_LEVEL, 0);
  this_player()->SetProp(P_GUILD, 0);
  WLOG("/log/gilden/zechpreller", " tritt aus der Gilde aus");
  write(BSA("WAAAAAAAASCH! Du willscht nuechtern werden. Hau blossch ab...", 
      "Zechus lallt: "));
  say(BSA("WAAAAAAASCH, Du willscht nuechtern werden, "+CAP(getuid(TP))+"? "
     +"Hau blossch ab!", "Zechus lallt: "));

  /* Gildenitems entfernen */
  if(ob=present(GILDENOBJ,TP)) 
    ob->remove();
  if(ob=present(GQID, TP))
    ob->remove(1);

  /* Entries aus dem Master entfernen */
  call_other(ZECHMASTER, "DeleteMember", TP);
  call_other(ZECHMASTER, "DeleteTopEntry", getuid(TP));

  /* Channeling */
  Channel(CAP(getuid(TP))+" "+msg_out[random(sizeof(msg_out))]);

  TP->SetProp(P_ALCOHOL, 0);
  return ::austreten();
}

/* Gildenbeitritt */
int tritt(string str)
{
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  } 
  if(str!="gilde bei" && str!="zechpreller bei") return 0;

  beitreten();  
  return 1;
}
 

/* Eigentliche Beitrittsfunktion, wird von tritt() aufgerufen */
int beitreten()
{
  int b;
  object ob;
  string restr;
  if(IsGuildMember(TP)) {
     write(BSA("Aber hey, du <Hicks!> bischt ja schon einer "
              +"von unsch ... hehe!", "Zechus lallt: "));
     return 1;
    }
  restr=call_other(RES_CHECKER, "check_restrictions", TP,
      QueryProp(P_GUILD_RESTRICTIONS));
  if(stringp(restr))
  {
    tell_room(ENV(TP), 
     BSA(sprintf("Du kannscht unsch Saeu^H^H^H^H"
        "Alkoholgeniessern noch nicht beitreten, %s! %s\n", 
        TP->Name(WER), restr), 
        "Zechus lallt: "));
    return 1;
  }

  if((b = ::beitreten()) < 0) return 1;
  write(BSA("Na alscho. Hier, trink gleich mal einen Schnapsch. Du "
           +"kriegscht <Hick!> einen Siebschenerschluesschel von mir, "
           +"damit jeder *ruelps* - ups, 'schulligung - wo war ich ... "
           +"*gruebel* ah ja! Alscho, den kriegscht, damit jeder weisch, "
           +"dasch Du tschu uns gehoerscht. Ausscherdem kannscht Du die "
           +"Zauber mit 'lerne' lernen, und Du kannsscht mich nach "
           +"'Fertigkeiten' fragen. "
           +"Allesch ok?\n", 
            "Zechus lallt: "));
  say(BSA("Na alscho. Hier, trink gleich mal einen Schnapsch. Du "+
           "kriegscht <Hick!> einen Siebschenerschluesschel von mir, "+
           "damit jeder *ruelps* - ups, 'schulligung - wo war ich ... "+
           "*gruebel* ah ja! Alscho, den kriegscht, damit jeder weisch, "+
           "dasch Du tschu uns gehoerscht. Allesch ok?\n",
            "Zechus lallt zu "+CAP(getuid(TP))+": "));
  write(BS("Zechus gibt Dir einen Bieroeffner.\n"));
  say(BS("Zechus gib "+CAP(getuid(TP))+" einen Bieroeffner.\n"));

  /* Gildenobjekt uebergeben */
  ob=clone_object(OBJ("z_17erschluessel"));
  ob->move(TP, M_NOCHECK);
  
  /* In den Master eintragen */
  call_other(ZECHMASTER, "AddMember", this_player());
  
  write(BSA("PROSCHT und willkommen!", "Zechus lallt erfreut: "));
  say(BSA("PROSCHT und willkommen, "+CAP(getuid(TP))+"!\n"
         , "Zechus lallt erfreut: "));
  /*
  say(BS("Zechus Prellus gibt "+CAP(getuid(TP))+" ein Pergament.\n"));
  write(BS("Zechus Prellus gibt Dir ein Pergament."));
  ob=clone_object(OBJ("pergament"));
  ob->move(TP, M_NOCHECK);   
  */
  
  WLOG("/log/gilden/zechpreller", "tritt in die Gilde ein.\n");
  //call_other(ZECHMASTER, "AddMember", this_player()); - Wozu 2 mal?!
  //tell_angrox("AddMember Ok!\n");

  /* Gildenskill eintragen */
  TP->ModifySkill(SK_BOOZE,QuerySkill(SK_BOOZE),0, "zechpreller" );
  TP->ModifySkill(FIGHT(WT_CLUB), QuerySkill(FIGHT(WT_CLUB)), 0, "zechpreller");
  
  //tell_angrox("SetSkill ok!\n");
  write_file(LOG(getuid(TP)+".log"),
             dtime(time())+": "+CAP(getuid(TP))+" ist "
             +"in die Gilde eingetreten.\n");
  //tell_angrox("Log ok!\n");
  Channel(CAP(getuid(TP))+" "+msg_in[random(sizeof(msg_in))]);
  //tell_angrox("Alles ok!\n");
  
  /* Master updaten */
  call_other(ZECHMASTER, "UpdateMemberLevels"); 
  call_other(ZECHMASTER, "SetXp",TP, TP->QueryProp(P_XP)+LVL_XP[0]);
  return b;
}

/* Aufstieg */
advance(string str)
{
  mixed b;
  string restr;
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  }   
  notify_fail(BSA("Nur die Sschtufe der Zechpreller, okeee?.", 
    "Zechus lallt: "));
  if(!str || !IsGuildMember(TP)) return 0;
  if(str=="stufe" || str2attr(str))
     return 0;
  if(str=="gildenstufe" || str=="gilde") {
    LevelText(TP);
    if(TP->QueryProp(P_GUILD_LEVEL)>=MAX_GUILD_LEVEL){
      write(BSA("Weiter getsch net!!!\n", 
                    "Zechus lallt: "));
      say(BSA("Weiter getsch nimmer, "
              +CAP(getuid(TP))+".\n", "Zechus lallt: "));
      return 1;
    }
    else if(TP->QueryProp(P_GUILD_LEVEL)>=10) {
      write(BSA("Weiter getsch net!!!\n", 
                    "Zechus lallt: "));
      say(BSA("Weiter getsch nimmer, "
              +CAP(getuid(TP))+".\n", "Zechus lallt: "));
      return 1;
    }
    if((restr=call_other(RES_CHECKER, "check_restrictions", TP,
          QueryProp(P_GUILD_LEVELS)[TP->QueryProp(P_GUILD_LEVEL)+1]))!=0 &&
        restr!="0")
    {
      tell_room(ENV(TP), BSA(sprintf("Du erfuellst nicht alle Anforderungen, "
        +"um aufsteigen zu koennen, %s! %s\n", TP->Name(WER), restr), 
        "Zechus lallt: "));
      return 1;
    }

    b=::advance();

    call_other(ZECHMASTER, "SetXp", TP, 
        (TP->QueryProp(P_XP)+LVL_XP[TP->QueryProp(P_GUILD_LEVEL)-1]));      

    if(b) {
      if(TP->QueryProp(P_GUILD_LEVEL)>MAX_GUILD_LEVEL-1) {
        write(BSA("Schupa! Endlich hascht es g'schafft!\n",
                  "Zechus lallt: "));
        say(BSA("Schupa! Endlich hascht es g'schafft, "+
                CAP(getuid(TP))+".\n", "Zechus lallt: "));
        write_file(LOG(getuid(TP)+".log"),
                   dtime(time())+": "+CAP(getuid(TP))+" hat "
                   +"die hoechste Stufe erreicht.\n");    
        if(!(TP->QueryProp(P_TESTPLAYER)))
        Channel(CAP(getuid(TP))+" hat bei den Zechprellern "
                +"die Vollendung des Suffs erreicht!");
        call_other(ZECHMASTER, "UpdateMemberLevels"); 
        printLevelSpells(TP);
        return b;
      }
      write(BSA("Gratuliere!!\n", "Zechus spricht erstaunlich klar: "));
      say(BSA("Gratuliere, "+CAP(getuid(TP))+".\n",
              "Zechus spricht erstaunlich klar: "));     
      write_file(LOG(getuid(TP)+".log"),
                 dtime(time())+": "+CAP(getuid(TP))+" ist "
                 +"eine Stufe aufgestiegen.\n"); 
      if(!(TP->QueryProp(P_TESTPLAYER)))
      Channel(CAP(getuid(TP))+" "+sprintf(msg_up[random(sizeof(msg_up))], 
              TP->QueryProp(P_GUILD_LEVEL)));
      call_other(ZECHMASTER, "UpdateMemberLevels"); 
      printLevelSpells(TP);
      return b;
    }

  }
  return b;
}

/* Spells lernen */
OwnLearnSpell(string str)
{
  string path; 
  if(!present(GILDENNPC, TO)) {
     write(BS("Ohne Zechus laeuft hier gar nichts!\n"));
     return 1;
  }   
  if(!IsGuildMember(TP))
  {
    write(BSA("Verschwind!!! Du bischt keiner von unsch!!!\n", 
       "Zechus groehlt: "));
    return 1;
  }
  notify_fail("Was moechtest Du hier lernen?\n");
  if(!str || str == "")
  {
    write(BSA("Wasch magscht lernen, "+TPN+"?", "Zechus lallt: "));
    say(BSA("Wasch magscht lernen, "+TPN+"?", "Zechus lallt: "));
    return 1;
  }

  if(str == "improvisiere" ||
     str == "trinklied" ||
     str == "fahne" ||
     str == "donnerruelpser")
  {
    write(BS("Das kannst Du so nicht lernen!"));
    return 1;
  }

  if(str == "keulenkampf")
  {
   
    if(!TP->QuerySkill("Fight_club"))
    {
      TP->ModifySkill(FIGHT(WT_CLUB), QuerySkill(FIGHT(WT_CLUB)), 0, "zechpreller");
      write("Du erlernst das Kaempfen mit stumpfen Waffen!\n");
    }
    else
      write("Das beherrschst Du schon!\n");
    return 1;
  }

  path ="/gilden/zechpreller/desc/"+lower_case(str)+".dsc";
  if(file_size(path))
    call_other("/gilden/zechpreller/desc/descriptor", "Describe", path, TO, TP);
  
    
  return LearnSpell(str);
}


/*
//
// Senden auf dem Channel info
//
*/
nosave void Channel(string msg)
{
    //if(!interactive(previous_object()))
        // return;
    call_other(CHMASTER, "join","Info", this_object());
    call_other(CHMASTER, "send", "Info", TO, msg, MSG_SAY);
}


/*
//
// Ausgabe der Fertigkeiten
//
*/
int faehigkeiten()
{
  int i, wert, sum;
  string *arm, s;
  mapping res;

  sum = 0;
  
  if(IS_WIZARD(this_player()))
  {
    write(BSA("Deine Skills: ", "Zechus sagt: "));
    s="";
    res = this_player()->QueryProp(P_NEWSKILLS);
    arm=sort_array(m_indices(res), #'<); //')
    for (i = sizeof(arm)-1;i>=0;i--)
    {
      s += arm[i]+": ";
      if (mappingp(res[arm[i]])) s += res[arm[i]][SI_SKILLABILITY];
      else s += res[arm[i]];
      s += "\n";
      write(BSA(s, "Zechus sagt: "));
      s="";
    }
   return 1;   
  }
  if(!IsGuildMember(TP))
    {
     write(BSA("Verschwind!!!\n", "Zechus lallt: "));
     return 1;
    }
  write(BSA("Dasch kannscht Du: ", "Zechus lallt: "));
  s="";
  res=this_player()->QueryProp(P_NEWSKILLS);
  arm=sort_array(m_indices(res), #'<); //')
  for (i = sizeof(arm)-1;i>=0;i--)
   {
    if(arm[i]!="Booze" && arm[i]!=FIGHT(WT_CLUB))
     {
      s += CAP(arm[i])+" kannscht Du";
      wert=TP->QuerySkillAbility(arm[i]);   
      s+=int2string(wert);
      write(BSA(s, "Zechus lallt: "));
      s="";         
      sum+=wert;
     }
   }   
 s=int2string(TP->QuerySkillAbility("Booze"));
 write(BSA("Und Allohol vertraegscht Du"+s,"Zechus lallt: "));
 s=int2string(TP->QuerySkillAbility(FIGHT(WT_CLUB)));
 write(BSA("Mit stumpfen Waffen kannscht"+s+"\b\b umgehen.", "Zechus lallt: "));
 if((wert=TP->QueryProp(P_GUILD_RATING))<1501) wert=1501;
 if(wert > 10000) wert = 10000;
 sum+=TP->QuerySkillAbility("Booze");
 sum+=TP->QuerySkillAbility(FIGHT(WT_CLUB));

 if(TP->QueryProp(P_GUILD_LEVEL) > 10)
   s=int2string((int) (sum/19));
 else
   s=int2string((int) (sum/18));
 write(BSA("Inschgeschamt betrachtet bist Du"+s, "Zechus lallt: ")); 
 say(sprintf("Zechus klaert %s ueber %se Fertigkeiten auf.\n", CAP(getuid(TP)), 
      TP->QueryPossPronoun(WESSEN)));
return 1;
}

/* Fertigkeitswert in entsprechende Ausgabe umwandeln */
string int2string(int wert)
{
 string str;
 switch(wert) 
       {
        case 0..500 : str=" scho gut wie gar nicht.\n";
                        break;
        case 501..1000: str=" fast gar *ruelps* nicht.\n"; 
                        break;
        case 1001..1500: str=" kaum.\n";
                        break;
        case 1501..2000: str=" schehr miserabel.\n";
                        break;
        case 2001..2500: str=" mischerabel.\n";
                        break;
        case 2501..3000: str=" ziemlich schlecht.\n";
                        break;
        case 3001..3500: str=" schlecht, gaaaanz schlecht.\n";
                        break;
        case 3501..4000: str=" maesschig.\n";
                        break;
        case 4001..4500: str=" unterdurchschnittililich oder wie dasch "
                            +"heisst.\n";
                        break;
        case 4501..5000: str=" durchschnittlich.\n";
                        break;
        case 5001..5500: str=" ueberdurchschnittillich.\n";
                        break;
        case 5501..6000: str=" gut. <HICKs>.\n";
                        break;
        case 6001..6500: str=" wirklich *ruelps* gut.\n";
                        break;
        case 6501..7000: str=" schehr gut.\n";
                        break;
        case 7001..7500: str=" ungllllaublich guttt.\n";
                        break;
        case 7501..8000: str=" phantastisch gut.\n";
                        break;
        case 8001..8500: str=" ausgetscheichnet.\n";
                        break;
        case 8501..9000: str=" hervorragend.\n";
                        break;
        case 9001..9500: str=" meischterhaft.\n";
                        break;
        case 9501..9999: str=" nahetschu perfekt.\n";
                        break;
        case 10000: str=" abscholut perfekt.\n";
                        break;
        default: str=" ueberhaupt nicht, du SCHTUEMPER!\n";
       } 
return str;
}




/*
//
// Funktion fuers Saufen
//
*/

void LearnBooze(object user, mapping sinfo, int alc)
{
  int abil, max, max_alc;
  abil=sinfo[SI_SKILLABILITY];
  if(abil>MAX_ABILITY-1) return; // absoult perfekt -> lernen unnoetig
  max_alc=user->QueryProp(P_MAX_ALCOHOL);
  abil+=1+random((int)(alc/15));
  max=MAX_ABILITY-200*(6-user->QueryProp(P_GUILD_LEVEL));
  if(abil>max) abil=max;
  user->ModifySkill( SK_BOOZE, abil);
  if(user->QuerySkillAbility(SK_BOOZE) == MAX_ABILITY)
    user->Message("Zechus teilt Dir mit: Saufen kannscht jetscht abscholut perfekt!\n",
                  MSGFLAG_TELL);
}

int Saufen(object user, string sname, mapping sinfo)
{
 
  int val, abil;
  if(!sinfo || (val=sinfo[SI_SKILLARG]) <0 ) return 0;
  abil=sinfo[SI_SKILLABILITY];
  val+=(val*abil)/(MAX_ABILITY+5000);
  if(val<0) val=0;
  abil=user->QueryProp(P_ALCOHOL);
  if(!random(8))
    LearnBooze(user, sinfo, abil);
  call_other(ZECHMASTER, "DrinksAlcohol", user, val);

  if((val=ZTMASTER->GetTalent(user, ZT_WARMUP))) {
    tell_object(user, BS("Der Alkohol faehrt dir ins Hirn. Deine Zauber sind jetzt kurzzeitig staerker!"));
    user->ModifySkillAttribute(TO, SA_DAMAGE, 100 + (val * 10), val * 30);
  }

  return val;
}

/* Funktion fuer den Kampf mit stumpfen Waffen 
 * frech von den Nekromanten geklaut */

mapping Keulenkampf(object user, string skill, mapping sinfo)
{
  int bonus, ut, val, abil, dam_old, x;
  object enemy;

  
  if(user->QueryProp(P_TESTPLAYER))
  {
    dam_old = sinfo[SI_SKILLDAMAGE];
  }
  
  ut    = sinfo[SI_USR];
  abil  = sinfo[SI_SKILLABILITY];
  val   = (2 * user->QueryAttribute(A_STR) + user->QueryAttribute(A_DEX) +
          4*user->QueryProp(P_GUILD_LEVEL)) * abil/MAX_ABILITY;
  
  // Bonus berechnen
  bonus = random(val);
  bonus = (bonus>150&&interactive(user)?150:bonus);

  /* Ein Ahnengeist gibt uns Vorteile... */
  if(user->QueryProp(P_GUILD_LEVEL) > 10)
    if(present(EPIC_ITEM, TP))
      if(present(EPIC_ITEM, TP)->QueryGhost())
        if(bonus<80) bonus = 80;

  sinfo[SI_SKILLDAMAGE] += bonus * user->QuerySkillAttribute(SA_DAMAGE)/100;
  //tell_object(user, BS("Kampfbonus: "+bonus+", Dam: "+sinfo[SI_SKILLDAMAGE]+", USR: "+sinfo[SI_USR]));

  // Lernen: Kein Frosch, Waffe macht genug schaden, Gegnerlevel, Anwendungszahl
  if(objectp(sinfo[SI_ENEMY]) && !user->QueryProp(P_FROG) && 
     user->QueryProp(P_WEAPON)->QueryProp(P_WC) > abil/100 && 
     (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > abil/250 || !random(10) ) &&
      ut > abil/50 && abil<MAX_ABILITY) 
  {
    ut = 0; // Anwendungen zuruecksetzen
    abil += random(user->QuerProp(P_GUILD_LEVEL) + 
            user->QueryAttribute(A_STR)/3 + user->QueryProp(P_ALCOHOL)/4);
    if (abil >= MAX_ABILITY)
      user->Message("Zechus teilt Dir mit: Du kannscht jetscht abscholut "
                      "perfekt mit stumpfen Waffen kaempfen!\n", MSGFLAG_TELL);
    
  }

  // Einen kleinen Bonus gibts auch noch
  if(!random(500+MAX_ABILITY-abil))
  { 
    enemy = sinfo[SI_ENEMY];
    switch(random(5))
    {
      case 1: tell_object(user, BS("Du laesst Deine Waffe mit einem "
                         "Schaedelbrecher-Spezial auf "+enemy->Name(WEN, 1)+
                         " niedersausen!"));
              tell_room(ENV(user), BS(user->Name(WER, 1)+" laesst "+
                        user->QueryPossPronoun(WESSEN)+"e Waffe mit einem "
                        "Schaedelbrecher-Spezial auf "+enemy->Name(WER, 1)+
                        " niedersausen!"), ({enemy, user}));
              tell_object(enemy, BS(user->Name(WER, 1)+" laesst "+
                        user->QueryPossPronoun(WESSEN)+"e Waffe mit einem "
                        "Schaedelbrecher-Spezial auf Dich niedersausen!"));
              break;
      case 2: tell_object(user, BS("Du wendest bei "+enemy->Name(WEM, 1)+
                          "einen Stuhlbeinschwinger an!"));
              tell_room(ENV(user), BS(user->Name(WER, 1)+" wendet bei "+
                        enemy->Name(WEM, 1)+" einen Stuhlbeinschwinger an!"),
                        ({enemy, user}));
              tell_object(enemy, BS(user->Name(WER, 1)+" wendet einen "
                          "Stuhlbeinschwinger bei Dir an!"));
              break;
      case 3: tell_object(user, BS("Krachend fuehrst Du einen "
                          "Thekenschmetterer gegen "+enemy->Name(WEN, 1)+
                          " aus!"));
              tell_room(ENV(user), BS(user->Name(WER, 1)+" fuehrt einen "
                        "Thekenschmetterer gegen "+enemy->Name(WEN, 1)+
                        " aus!"), ({enemy, user}));
              tell_object(enemy, BS(user->Name(WER, 1)+" fuehrt einen "
                          "Thekenschmetterer gegen Dich aus!"));
              break;
     case 4: tell_object(user, BS("Du schleuderst "+enemy->Name(WEM, 1)+
                         " Deine Waffe mit einem Hosenbodenheber entgegen!"));
              tell_room(ENV(user), BS(user->Name(WER, 1)+" schleudert "+
                        enemy->Name(WEM, 1)+" "+user->QueryPossPronoun(WESSEN)+
                        "e Waffe mit einem Hosenbodenheber entgegen!"), 
                        ({enemy, user}));
              tell_object(enemy, BS(user->Name(WER, 1)+" schleudert Dir "+
                        user->QueryPossPronoun(WESSEN)+"e Waffe mit einem "
                        "Hosenbodenheber entgegen!"));
              break;
     default: tell_object(user, BS("Du laesst "+enemy->Name(WEN, 1)+
                         " Deinen Bierhumpenmatscher spueren!"));
              tell_room(ENV(user), BS(user->Name(WER, 1)+" laesst "+
                        enemy->Name(WEN, 1)+" "+user->QueryPossPronoun(WESSEN)+
                        "en Bierhumpenmatscher spueren!"), ({enemy, user}));
              tell_object(enemy, BS(user->Name(WER, 1)+" laesst "+
                        " Dich "+user->QueryPossPronoun(WESSEN)+
                        "en Bierhumpenmatscher spueren!"));
              break;
    }

    sinfo[SI_SKILLDAMAGE]+=400;
  }

  enemy = sinfo[SI_ENEMY];
  if(objectp(enemy)) {
    if((x=ZTMASTER->GetTalent(user, ZT_BARREL_BASH)) && !random(25-(QueryProp(P_GUILD_LEVEL))-x)) {
      tell_object(user, BS("Du schmetterst "+enemy->name(WEM)+" einen Fasshieb mitten ins Gesicht!"));
      tell_room(ENV(enemy), BS(user->Name(WER)+" schmettert "+enemy->name(WEM)+" einen Hieb mitten ins Gesicht!"), ({user}));
      enemy->SetProp(P_DISABLE_ATTACK, x);
    }
    
    if((x=ZTMASTER->GetTalent(user, ZT_BEER_FIST))) {
      if(random(100) < 6 + ((x-1)*4)) {
        tell_object(user, BS("Beim Hinhauen stoesst es dir gleich mit auf. Du kannst jetzt einen 'ruelpser' machen!"));
        user->SetProp(P_ZECHPRELLER_FREE_BURP, 1);
      }
    }

    if((x=ZTMASTER->GetTalent(user, ZT_BARRELWALZ)) && (enemy->QueryProp(P_DISABLE_ATTACK) || enemy->QueryProp(P_PARALYZED))) {
      if(enemy->QueryProp(P_ZECHPRELLER_LAST_BARRELWALZ) < time()-6) {
        tell_object(user, BS("Du drehst dich um deine eigene Achse und drischst "+enemy->name(WEM)+" deinen Pruegel rein!"));
        tell_room(ENV(enemy), BS(user->Name(WER)+" dreht sich um die eigene Achse und drischt "+enemy->name(WEM)+" den Pruegel rein!"), ({user}));
        sinfo[SI_SKILLDAMAGE] += (int) ((100*x) * (user->QueryProp(P_GUILD_LEVEL)/10.0));
        enemy->SetProp(P_ZECHPRELLER_LAST_BARRELWALZ, time());
      }
    }

    if((x=ZTMASTER->GetTalent(user, ZT_BARRELSTORM)) && !random(50 - 10*x)) {
      tell_object(user, BS("Du entfesselst den Faessersturm auf deine Gegner!!!"));
      user->ModifySkillAttribute(TO, SA_SPEED, 150 + x*50, 2 + random(2+x));
    }

    if((x=ZTMASTER->GetTalent(user, ZT_HUMPKING)) && !random(7-x)) {
      user->AddSp(x);
    }

     if((x=ZTMASTER->GetTalent(user, ZT_BARRELSAINT)) && !random(7-x)) {
      sinfo[SI_SKILLDAMAGE] += x * 50;
    }
  }

  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  ut++;
  user->ModifySkill( FIGHT(WT_CLUB), ([ SI_USR: ut, SI_SKILLABILITY: abil ]),
                       sinfo[SI_DIFFICULTY], "zechpreller");

  if(dam_old && user->QueryProp(P_TESTPLAYER))
  {
    tell_object(user, BS(sprintf("Keulenskill: %d -> %d", dam_old,
			 sinfo[SI_SKILLDAMAGE])));
  }
  return sinfo;
}

/*
//
// Ausgabe beim Levelaufstieg
//
*/
void LevelText(object pl)
{
 write(BS("Du fragst Zechus, ob Du aufsteigen darfst.\n"));
 say(BS(CAP(getuid(pl))+ " fragt Zechus etwas...\n"));
 return ;
}



/*
//
// Ausgabe beim Levelaufstieg
//
*/
string NeedMoreXP(object pl, int xp)
{
 string str;
 int percent, x;
 
 str="Du brauchscht mehr Erfah ... <HICKs> ... rung. "
     +"Von den Erfahrungspunkten, die Du benoetigst, fehlen Dir ";
 x=call_other(ZECHMASTER, "GetXpDifference", pl, 
              pl->QueryProp(P_XP));
 percent=100*x/xp;
 //write("\n"+percent+"\n");
 switch (percent)
  {
    case  0..10:  str+="nur mehr ganz wenige.";     break;
    case 11..20:  str+="weniger als ein Viertel.";  break;
    case 21..30:  str+="etwa ein Viertel.";         break;
    case 31..40:  str+="weniger als die Haelfte.";  break;
    case 41..50:  str+="etwa die Haelfte.";         break;
    case 51..60:  str+="mehr als die Haelfte.";     break;
    case 61..70:  str+="weniger als drei Viertel."; break;
    case 71..80:  str+="etwa drei Viertel.";         break;
    case 81..90:  str+="mehr als drei Viertel.";    break;
    case 91..99 : str+="beinahe alle.";             break;
    case 100    : str+="alle.";                     break;
    default:      str+="viel mehr als gefordert.";  break; 
  }
  if (IS_WIZARD(TP) || TP->QueryProp(P_TESTPLAYER))
   str+=" ("+x+")";

 return str;
}


/*
//
// Aufgaben: ALK und XP! 
//
*/
string Test(object pl)
{  
  int req_alc, alc, max_alc,flag;
  string retstring,restr;
  flag=0;
  if(pl->QueryProp(P_FROG)) 
      return BSA("Ein Frosssssschhh!!! Warscht wohl beim Maksch! "
              +"Hau blosch ab!!!", 
                          "Zechus lallt: ");
  if(pl->QueryProp(P_GHOST)) 
       return BSA("Hascht Dich wohl *ruelps* tschu Tode g'schoffn, "
          +"was. Hau blosch ab!!! ", "Zechus lallt: ");

  alc=pl->QueryProp(P_ALCOHOL);
  max_alc=pl->QueryProp(P_MAX_ALCOHOL);
  req_alc=(int)(100*alc/max_alc);
  retstring=""; 
  if(req_alc<80) {
    retstring="Du bischt viel zu nuechtern! ";
    flag=1;
  }
  if(IsGuildMember(pl) && pl->QuerProp(P_GUILD_LEVEL)!=1) {
    //tell_angrox(sprintf("Level:%d\n", pl->QueryProp(P_GUILD_LEVEL)));
    if(!call_other(ZECHMASTER, "CheckXp", pl, pl->QueryProp(P_XP)))
     { retstring=retstring+
                  NeedMoreXP(pl, LVL_XP[pl->QueryProp(P_GUILD_LEVEL)-1]);
       flag=1;
     }
  }

 /* Gildenquest checks */
  if(CheckGuildQuest(TP) != "")
  {
    retstring += CheckGuildQuest(TP);
    flag       = 1;
  }

  if (flag) return retstring;
  return 0;
}

string CheckGuildQuest(object pl)
{
  int glvl;
  int *quested;
  string str;
  object ob;
  glvl = TP->QueryProp(P_GUILD_LEVEL);
  str  = "";
  
  if(!(TP->QueryProp(P_GUILD) == "zechpreller")) return "";

  if(!(quested = call_other("/gilden/zechpreller/master/questmaster",
                          "QueryQuesterEntry", getuid(pl))))
  {
    call_other("/gilden/zechpreller/master/questmaster", "AddQuester", pl);
    quested = call_other("/gilden/zechpreller/master/questmaster", 
                         "QueryQuesterEntry", getuid(pl));
  }

  if(glvl > 1 && !quested[0]) // 1. Gildenquest
    str = "Wennscht aufsteigen willst, dann musscht mir ein Faesschen mit "
          "Met bringen! Wennscht mich nach nem Rezept fragscht kriegsts! ";
  if(glvl > 4 && !pl->QueryQuest("Der verschollene Hoehlenforscher"))
    str = "In der Naehe der Tschwergenstadt Felonia findescht einen "
          "Hoehlenforscher, der Deine Hilfe braucht! Wennscht ihm hilfst, "
          "dann kriegst eine Thermoskanne! Alscho los! ";
  if(glvl > 6 && !quested[1])
    str = "Einer der erschten Zechpreller, Torxes, hatte einscht ein "
          "magisches Trinkhorn! Er isch in die Wueste getschogen und "
          "dasch Horn is verschollen! Jetscht hams zwiehilichtige Banditen "
          "gefunden! Bringsch am Besten gleich her! ";
  if(glvl > 8 && !quested[2])
  {
    str = "Vor langer Tscheit hat mir dsch Boesche drei Pruefungen gestellt, "
          "wart bis esch sich bei Dir meldet und besteh die drei Pruefungen! "
          "Dann kannscht ein Zechprellermeister werden! ";
    if(!present(GQID+"10", TP))
    {
      ob = clone_object(OBJ("quest_lvl10"));
      ob->move(TP);
      ob->SetOwner(TP);
    }
  }
  
  return str;
}

/* Auf GS 11 erhoehen */

void advance_11(string erbe, object who)
{
  object gobj;
  /*Security!!!*/
  if(!PO) return;
  if(strstr(file_name(PO), "/gilden/") != 0 &&
     member(GILDENMAGIER, getuid(PO)) < 0) return;

  who->SetProp(P_GUILD_LEVEL, 11);
  if(present(GILDENOBJ, who)) present(GILDENOBJ, who)->remove(1);
  //gobj = clone_object(EPIC("g_obj_"+erbe));
  //gobj->move(who);
  tell_object(who, BS("Zechus tauscht Deinen alten Siebzehnerschluessel gegen "
              "ein neues Zeichen deines Standes."));
  tell_room(TO, BS("Zechus gibt "+who->Name(WEM)+" etwas."));

  call_other(ERBMASTER, "AddErben", who, erbe); // In den Master eintragen
  Channel(who->Name(WER)+" hat alle gestellten Pruefungen durch die Kraft "
             "des Alkohols bestanden und bewiesen die Trinkfestigkeit eines wahren "
             "Zechprellers zu besitzen! Aufgrund "+who->QueryPossPronoun()+"er Taten "
             "soll "+who->Name(WER)+" von nun an als Erbe der alten Gildengruender "
             "bekannt sein!");

  // Spells lernen
  if(erbe == ERBE_ARTANOK)
  {
    tell_room(TO, BSA("Alscho... weil Du scho geschickt bischt wie einst "
	      "Artanok, verfuegscht jetscht ueber die Gabe den Tschauber "
	      "'improvisiere' tschu nutschen!", "Zechus lallt stolz: "));
    LearnSpell("improvisiere", who);
  }
  if(erbe == ERBE_LANESTRA)
  {
    tell_room(TO, BSA("Von nun an scholl Deine Stimme <HICKS!> als Erbe von "
              "Lanestra weit hin eschschschallen! Darum kannscht jetscht "
	      "auch den Tschauber 'trinklied' benutschen!", 
	      "Zechus lallt stolz: "));
    LearnSpell("trinklied", who);
  }
  if(erbe == ERBE_TARXES)
  {
    tell_room(TO, BSA("Moegen Deine Ruelpscher maechtig schein, mein Freund! "
	      "Ahja! Und donnern schollnse! Wie bim 'donnerruelpser' denscht "
	      "jetscht kannscht!", 
	      "Zechus lallt stolz: "));
    LearnSpell("donnerruelpser", who);
  }
  if(erbe == ERBE_ZECHUS)
  {
    tell_room(TO, BSA("Aaaah! Mein Erbe! Ab jetscht wird Deine Fahne Deine "
	      "Feinde einnebeln! Also hier, jetscht kannscht die 'fahne' tschaubern!", 
	      "Zechus lallt stolz: "));
    LearnSpell("fahne", who);
  }

  return;
}

void printLevelSpells(object o)
{
  string out;
  out = "Du kannst nun folgende Zauber erlernen: ";
  
  switch(o->QueryProp(P_GUILD_LEVEL))
  {
    case 1: out+="prelle, identifiziere";
            break;
    case 2: out+="schaetz, ruelpser";
            break;
    case 3: out+="uebergeben";
            break;
    case 4: out+="anhauchen, destilliere";
            break;
    case 5: out+="rumkugeln";
            break;
    case 6: out+="staenkern, groehlen";
            break;
    case 7: out+="alkoholisiere, dunstpanzer";
            break;
    case 8: out+="torkeln, alkoholwolke";
            break;
    case 9: out+="trunkspruch";
            break;
    case 10: out+="weingeist";
             break;
    default: out+="Du kannst schon alles.";
             break;
  }  

  tell_object(o, out+"\n");
  return;
}

