/*
  Lloth! by PROtheG
  
  Verwaltet u.a. Info-Channel-Ausgabe fuer Hochzeit in Ardulvhier
*/

#pragma strong_types;

#include "../def.h"

#define HISTSIZE 10
#define INFOMASTER "/obj/infomaster"
#define SPINNE SOBJ "spinnentool"
#define HZM "/d/unterwelt/protheg/avmitte/room/hzm"
#define DIENERIN "/d/unterwelt/protheg/avmitte/npc/dienerin"

int version;
nosave string *history;

nomask int query_prevent_shadow() { return 1; }

nomask varargs nosave int allowed(mixed prev, string what)
{
  if(!objectp(prev)) return 0;
  
  if((TP) && (interactive(TP)) && (getuid(TP)=="protheg")) return 1;
  
  if(interactive(prev)) return 0;
  
  if(stringp(what))
    if(explode(file_name(prev), "#")[0]!=what)
      {
	DB(sprintf("*** Spinnentool %O messed by %O [%O]\n",
		   ENV(ME), prev, prev->QueryProp(P_CLONER)));
	return 0;
      }
  
  return 1;
}

nomask void create()
{
  SUID;
  
  history=({});
  
  restore_object(LLOTHSAVE);

  DB("*** LLOTH create() by "+sprintf("%O [%O]",PO, PO->QueryProp(P_CLONER))+"\n");
  //set_living_name("lloth");
}

nomask public void AddHistory(string who, string what)
{
  if(!allowed(PO, SPINNE)) return;  
  
  history+=({"<"+dtime(time())[<8..<1]+"> "+
	       CAP(who)+" teilte Euch mit:\n"+
	       break_string(what, 78, "           ")});
  
  if(sizeof(history) > HISTSIZE)
    history-=({history[0]});
}

nomask public string QueryHistory()
{
  if(!allowed(PO, SPINNE)) return "";
  
  return implode(history, "");
}

nomask nosave int is_listening(object who)
{
  if(who->QueryProp(SKLISTENER)) 
    return 1;
  else 
    return 0; 
}

nomask public object *QueryListeners()
{
  return filter_array(users(), "is_listening");
}

nomask public string blubb(int i)
{
  if(!allowed(PO, SPINNE)) return "";

  if(!i) return history[0];
  else return history[i];
}

nomask public int GetCurrentVersion()
{
  return version;  
}

varargs nomask public int UpdateCurrentVersion(int flag)
{
  object *pls;
  object sp;
  int i;

  if(!allowed(PO)) return 0;
  
  if(!flag) version++;
  save_object(LLOTHSAVE);
  
  if(sizeof(pls=QueryListeners()))
    for(i=sizeof(pls)-1;i>=0;i--)
      if(sp=present(SPINNENTOOL, pls[i]))
	sp->erneuern(1);

  return version;
}

nomask public int SetCurrentVersion(int i)
{
  if(!allowed(PO, SPINNE)) return 0;

  version=i;
  save_object(LLOTHSAVE);
  return version;
}

nomask public void Hochzeitsinform(string one, string two, int scheidung)
{
  DB("*** Spinnentool Hochzeitsinform PO="+sprintf("%O",PO)+"\n");

  if((!allowed(PO, DIENERIN)) && (!allowed(PO, HZM))) return;

  if(!find_player(one)) return;
  if(!find_player(two)) return;
  
  if(scheidung)
    {
      if(find_player(one)->QueryProp(P_GENDER)==FEMALE)
	INFOMASTER->InfoMsg(BS(CAP(one)+" liess sich soeben von "+CAP(two)+
			       " scheiden."));
      else
	INFOMASTER->InfoMsg(BS(CAP(two)+" liess sich soeben von "+CAP(one)+
			       " scheiden."));
    }
  else
    INFOMASTER->InfoMsg(BS(CAP(one)+" und "+CAP(two)+
			   " sind soeben mit Lloths Einverstaendnis den "
			   "Bund der Ehe eingegangen."));
  
  return;
}
