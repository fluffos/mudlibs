**
** basierend auf:
**   Vrai's Freundschaftsband (Adverbparsing),
**   Mupfel's sprechender Stein (LP/MP Anzeige),
**   Diddl-Maus (Ideen fuer diverse r-Verben)
**
** Was r-Verben angeht: funktioniert im Grunde gleich wie die
** Diddl-Maus, erlaubt hierbei aber relativ komplexes Parsing bzw.
** Wortstellungen durch Makros.
**
** Ausserdem wird "in der Ferne" nicht ausgegeben, wenn sich Spieler
** und Zielperson im selben Raum befinden (in diesem Fall wird
** ausserdem zusaetzlich eine Raummeldung an alle anderen anwesenden
** Spieler ausgegeben).
**
** Zur Erweiterung der r* Befehle am besten vorher den Header zur
** Funktion rbefehl() durchlesen!! (ist die letzte Funktion, ganz
** unten)
**
** Ach ja, fast haett ichs vergessen: Anders als bei der Maus kann
** man mit diesem Teddy Adverben verwenden, genau wie bei allen
** Standardverben (rwuschel woody froe = Du verwuschelst Woodys
** Haare froehlich aus der Ferne.). Quoted Adverbs wieder per /
** hintendran, wie gewohnt.
**
** Weiters kann das Aufspueren von unsichtbaren Magiern mit diesem
** Teddy gegebenenfalls per #define INVIS_SPERRE verhindert werden.
**
*/

#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit "std/thing";
inherit MOST "std_things";

#define VER 41
#define SPINNENTOOL "\nspinnentool"
#define DHRKIONMASTER "/d/unterwelt/zordan/dhrkion/master/dhrkion"
#define SOULFILE "/gilden/spinnenkrieger/master/soul"
#define LLOTH "/gilden/spinnenkrieger/master/lloth"
#define QM "/secure/questmaster"
#define DUNKEL 10

// Reporteinstellungen
#define NORMAL      0
#define KURZ        1
#define SPEZIAL     2
#define SPEZIALKURZ 3

#define C +GetColor()+
#define O +NormalColor()+

/*
** Wird folgende Zeile aktiviert, so koennen unsichtbare Magier
** mit dem Teddy nicht mehr aufgespuert werden, andernfalls
** heissts halt wieder "Jemand" etc.
*/
#define INVIS_SPERRE

#define INV_TEST(x,y,z) (IS_LEARNER(x) && IS_LEARNER(y) && \
                         z->QueryProp(P_INVIS))
#define WIZ_NAME(pl,genitiv) ("("+capitalize(getuid(pl))+ \
    (genitiv ? (strstr("xsz",getuid(pl)[<1..])!=-1?"'":"s"):"")+")")

nosave int lastHP, lastSP, aktiv=0, show, dunkel, setting, xpdiff, souldate;
nosave object owner;
nosave string owner_name, currentcolor;
nosave mapping soulcmds;

varargs nosave string huefe(int flag);
nosave varargs int rbefehl(string str, string *form, int sp, int nearonly);
varargs void init_soul_cmds(int force);

string NormalColor()
{
  if(setting)
    return ANSI_NORMAL;
  else
    return "";
}

varargs GetColor(int i)
{
  if(!i) 
    return currentcolor;
  else
    if(setting)
      currentcolor=({ANSI_RED,ANSI_GREEN,ANSI_BLUE,ANSI_CYAN,ANSI_PURPLE})[random(5)];
    else
      currentcolor="";
}

nomask void create()
{
  if (!is_clone(ME)) return;  // (return on BP)
  ::create();

  SetProp(P_SHORT, "Eine kleine Spinne");
  SetProp(P_LONG,
	  BS("Eine kleine Spinne aus Obsidian, die Dir wertvolle Dienste "
	     "leisten wird, solange Du sie auf der Schulter traegst. Sie "
	     "ist von Lloth persoenlich geweiht worden, also achte auf sie!"));
  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne", "spinnentool", SPINNENTOOL}));

  SetProp(P_WEIGHT, 150);
  SetProp(P_MATERIAL, ([MAT_OBSIDIAN:90,MAT_MISC_UNHOLY:10]));
  SetProp(P_MAGIC, 1);
  SetProp(P_NEVERDROP, 1);  
  SetProp(P_NODROP, "Lloth wuerde das nicht zulassen!!\n");
  lastHP = lastSP = -1;
  setting=0;
  xpdiff=-1;

  SetProp(P_NOSELL,
	  "Du hoerst eine Stimme im Kopf: 'Wage es bloss nicht!'\n");
  SetProp(P_INFO,
	  "Lausche, welche Dienste Dir die Spinne bieten kann!\n");

  AddDetail("dienste",
	    "Lausche, welche Dienste sie Dir bieten kann!\n");
  
  SetProp(P_SOUND, CLOSURE(huefe));
  
  AddCmd("spreport", "Report");
  
  //Cmds fuer die Drow-komunikation
  
  AddCmd(({"spruf","sprufe"}), "sprufen");
  AddCmd(({"sphist"}), "sphist");
  AddCmd(({"spwink","spwinke"}), "spwink");
  AddCmd(({"spdunkel"}), "spdunkel");
  //AddCmd(({"spdolch"}), "spdolch"); raus weil wollte keiner :/
  AddCmd(({"sphass"}), "sphass"); 

  AddCmd(({"spinfo"}), "spinfo");
  AddCmd(({"spwer"}), "spwer");
  AddCmd(({"spfarbe","spfarben"}), "spfarbe");

  AddCmd(({"sppresay"}), "sppresay");

  //Anzeige der Feinde von Dhrkion...
  
  AddCmd(({"spfeinde"}),"spfeinde");
  AddCmd(({"sphilfe"}), "sphilfe");

  GetColor(1);
  
  SUID;

  // r* commands:
  init_soul_cmds(1);
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  call_out("init_soul_cmds", 5+random(10));
}

nosave void Setting(int i)
{
  setting=i;
  GetColor(1);
}

varargs nosave string huefe(int flag)
{
  string ret, rcmds;
  int i;
  
  rcmds="";
  
  if(IS_SEER(TP))
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+".";
	else
	  rcmds+=soulcmds[i][0]+", ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    }
  else
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+"("+soulcmds[i,2]+").";
	else
	  rcmds+=soulcmds[i][0]+"("+soulcmds[i,2]+"), ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
      
      rcmds+="Die Zahlen in den Klammern sind die Magiepunkte, die Euch die\n"
	"Aktionen kosten werden.\n \n";
      
    }
  
  ret="\n \n"
    "Ich kann Euch jederzeit darueber informieren, wie es mit Eurer\n"
    "Lebensenergie und Eurer Zauberkraft aussieht.\n \n"
    "Die Kommandos dazu lauten wie folgt:\n"
    " <spreport ein>   baut eine telepathische Verbindung mit mir auf.\n"
    " <spreport aus>   bricht die Verbindung wieder ab.\n \n"
    "Ausserdem ermoegliche ich Euch einige zusaetzliche Kommandos:\n"+
    rcmds+
    "Lloth hat jedoch noch mehr zu sagen...\n"
    " 'Durch meine Kraft, die Euch umgibt und durchdringt ist es\n"
    "  Euch moeglich ueber grosse Distanzen mit den anderen\n"
    "  Dunkelelfen zu kommunizieren!'\n \n"
    "  Ihr koennt Euch zurufen mit:    sprufe <text>\n"
    "  Vergangene Rufe seht Ihr bei:   sphist\n \n"
    "  Infobefehle:\n"
    "    spwer, spinfo, spfarbe\n \n"
    "  Weitere Befehle sind:\n"
    "    spwinke, spdunkel, sphass, spfeinde, sppresay.\n \n"
    "  Hilfe zu den Befehlen erhaltet Ihr mit:  sphilfe\n \n"
    "  Ihr koennt Spieler ignorieren\n"
    "    ignoriere name, ignoriere name.spinne\n"
    "  Oder jegliche Aktionen der Spinne\n"
    "    ignoriere spinne\n"
    "                                                         Ver 1."+VER+"\n";

  if(TP->QueryProp(P_GUILD)=="spinnenkrieger")
    ret+="blubb\n";
  
  if(flag) return ret;
  
  TP->More(make_dokument(ret));
  return "";
}

nosave int sphilfe(string str)
{
  string ret;

  if(str) str=explode(str, " ")[0];

  switch(str)
    {
    case "spreport": 
      ret="Der 'spreport' informiert Euch jeweils ueber den Zustand\n"
	"Eurer Lebens- und Magiepunkte.\n"
	"Moegliche Einstellungen sind:\n"
	"* spreport normal      - Schaltet den Report normal ein.\n"
	"* spreport kurz        - Schaltet den Report kurz ein.\n"
	"* spreport spezial     - Schaltet den Report in Farbe ein.\n"
	"* spreport spezialkurz - Schaltet den Report faerbig und\n"
	"                         kurz ein.\n"
	"* spreport aus         - Schaltet den Report wieder aus.\n";
      break;
    case "spinfo": 
      ret="In 'spinfo' habt Ihr eine Alternative zu der normalen\n"
	"Infoanzeige bei 'info'.\n"
	"Die einzelnen Angaben sollten Euch eigentlich genuegen\n"
	"fuer den Kampf gegen das Gute.\n \n"
	"Je nach Farbeinstellung 'spfarbe' habt Ihr hier ein anderes\n"
	"Farbbild.\n"
	"Einige unwichtige Angaben werden im Normalfall unterdrueckt.\n";
      break;
    case "spwer": 
      ret="Mit 'spwer' seht Ihr die Dunkelelfen Taktikliste:\n \n"
	"*  Welcher Deiner Brueder/Schwestern ist anwesen?\n"
	"*  Ist er/sie wuerdig? (traegt eine Spinne)\n"
	"*  Oder traegt er/sie gar noch einen Teddy\n"
	"*  Ist er/sie anwesend, oder idle?\n"
	"*  Was fuer eine Waffe hat er/sie gezueckt?\n"
	"*  Ist er/sie von boeser Gesinnung?\n"
	"*  Wo befindet er/sie sich?\n"
	"*  Mit wem kaempft er/sie denn in dem Augenblick (optional)\n\n"
	"Mit 'spwer kurz' seht Ihr das ganze etwas kompakter.\n";
    break;
    case "spfarben":
    case "spfarbe": 
      ret="Mit '"+str+"' habt ihr 3 verschiedene Farbeinstellungen:\n \n"
	"* spfarbe 0  -  Keine Farben.\n"
	"* spfarbe 1  -  Spezialfarbeinstellung 1.\n"
	"* spfarbe 2  -  Spezialfarbeinstellung 2.\n \n"
	"Welche Euch besser gefaellt, muesst Ihr selbst entscheiden.\n";
    break;
    case "sprufe": 
      ret="Mit 'sprufe' habt Ihr die Moeglichkeit, den Anderen etwas\n"
	"mitzuteilen, ohne dass andere Rassen mithoeren koennen.\n"
	"Mit 'sphist' koennt Ihr die Rufe nocheinmal lesen.\n";
    break;
    case "sphist": 
      ret="Mit 'sphist' erweist Euch Lloth die Gnade, vergangene Rufe\n"
	"von 'sprufe' nocheinmal in einer, nach der Zeit geordneten\n"
	"Liste zu sehen.\n"
	"Jedoch ist die Liste in ihrer Groesse beschraenkt.\n";
    break;
    case "spfeinde": 
      ret="Mit 'spfeinde' seht Ihr, genau aufgelistet, die aktuellen\n"
	"und auch die ewigen Feinde von Eurer Heimatstadt Dhrkion.\n";
    break;
    case "spdunkel": 
      ret="Mit 'spdunkel' koennt Ihr einen Teil Eurer Macht aufwenden,\n"
	"um den anderen Dunkelelfen dunkle Gruesse zu uebersenden.\n"
	"Ihr koennt mit 'spdunkel <name>' auch jemand Bestimmten gruessen.\n";
    break;
    case "spwinke":
    case "spwink": 
      ret="Mit '"+str+"' koennt Ihr den anderen Dunkelelfen zuwinken.\n"; 
      break;
    case "sphass": 
      ret="Mit 'sphass' koennt Ihr die Anderen an Eurem Hass und\n"
	"Eurer Abscheu dem Guten gegenueber teilhaben lassen.\n";
    break;
    case "sppresay":
      ret="Mit 'sppresay' koennt Ihr Euch das Dunkelelfen-Presay welches\n"
	"z.B. bei 'spwer' gezeigt wird, permanent als Presay setzen.\n\n"
	"Mit 'sppresay loeschen' wird Euer Presay geloescht.\n";
      break;
    case "allgemein":
      ret=huefe(1);
      break;
    default: 
      ret="Mit 'sphilfe' koennt Ihr Euch ueber folgende Themen informieren:\n \n"
	"sphilfe <spreport>   Wie steht es um Eure Lebenskraft und Magie?\n"
	"        <spinfo>     Ein etwas anderes 'info'.\n"
	"        <spwer>      Welcher Dunkelelf ist anwesend?\n"
	"        <spfarbe>    3 verschiedene Farbeinstellungen.\n"
	"        <sppresay>   Dunkelelfen-Presay fix setzen.\n"
	"        <sprufe>     Teilt den anderen Dunkelelfen etwas mit.\n"
	"        <sphist>     Wer hat Euch wann, was mitgeteilt?\n"
	"        <spfeinde>   Die Feinde der Dunkelelfen!\n"
	"        <spdunkel>   Versendet dunkle Gruesse.\n"
	"        <spwink>     Winkt eurem Dunkelelfenvolk zu.\n"
	"        <sphass>     Teilt den Anderen Euren Hass mit!\n"
	"        <allgemein>  Allgemeine Uebersicht.\n";
    }
  return TP->More(make_dokument(ret)),1;
}

void activate(object ob)
{
  if (objectp(ob)) 
    {
      aktiv = 1;
      owner = ob;
      owner_name = getuid(owner);
      ob->AddHpHook(ME);
      lastHP = ob->QueryProp(P_HP);
      lastSP = ob->QueryProp(P_SP);
    } 
  else 
    {
      if (ob=(owner||TP)) ob->RemoveHpHook(ME);
      owner = owner_name = aktiv = 0;
    }
}

public varargs void erneuern(int force)
{
  object neue_spinne;

  if (!is_clone(ME)) return;

  if((!force) && (LLOTH->GetCurrentVersion()==VER)) return;
  
  RemoveCmd(0);
  
  SetProp(P_INVIS, 1);
  
  // neue spinne
  //neue_spinne=clone_object(explode(file_name(ME), "#")[0]);
  neue_spinne=clone_object("/p/service/protheg/rt/obj/drowspinne");
  neue_spinne->move(MENV, M_NOCHECK);

  if(aktiv) neue_spinne->activate(MENV);

  neue_spinne->Setting(setting);

  activate(0);
  
  call_out("remove", 0);
}

void BecomesNetDead(object who)
{
  if((objectp(who)) && (who==MENV))
    {
      DB("*** Spinnentool BecomesNetDead in "+sprintf("%O\n",who));

      xpdiff=who->QueryProp(P_XP);
    }
}

void BecomesNetAlive(object who)
{
  xpdiff=-1;

  if((ENV(ME)) && (ENV(ME)==who))
    {
      if(LLOTH->GetCurrentVersion()!=VER)
	{
	  call_out("erneuern", 0, 1);
	  
	  DB("*** Spinnentool Renew in "+sprintf("%O\n",who));
	  
	  tell_object(who,
		      BS("Irgendwas scheint mit Deiner Spinne zu geschehen!"));
	  
	  return;
	}

      DB("*** Spinnentool BecomesNetAlive in "+sprintf("%O\n",who));
      
      xpdiff=who->QueryProp(P_XP);
      
      tell_object(who, 
	  BS("Die kleine Spinne auf Deiner Schulter blickt Dich an "
	     "und ploetzlich hoerst Du eine durchdringende Stimme in "
	     "Deinem Kopf:")+
	  BS(({"  'Mehre meinen Ruhm, oder erwarte meine Strafe!'",
		 "  'Moege Dich meine Dunkelheit begleiten!'",
		 "  'Finsternis und Verwuestung ueber das Silberland!'",
		 "  'Toetet ein paar stinkende Elfen fuer mich!'",
		 "  'Opfert mir ein paar Feen!'",
		 "  'Diesmal will ich die Verwuestung von Derlim!'",
		 "  'Mich duerstet nach dem Blut von Midas' Buergern!'",
		 "  'Nieder mit Elessar! Tod den Elfen!'",
		 "  'Ruhm und Ehre fuer mich! Lloth, Deine Goettin!'",
		 "  'Geh und erkunde das feindliche Oberland fuer mich!'",
		 "  'Schneidet den Elfen die Ohren ab!'",
		 "  'Bringt mir ein paar Zwerge als Sklaven!'",
		 "  'Drachenblut, Drachenblut, Drachenblut!!'"})[random(13)]));
    }
}

nosave int spfeinde(string str)
{
  string ret;
  object m;

  catch(call_other(DHRKIONMASTER, "???"));
	  
  if(m=find_object(DHRKIONMASTER))
    {
      ret="Dhrkions ewige Feinde:\n";
      ret+=m->getpermfeinde();
      ret+="\nZur Zeit wuetet in Dhrkion rum:\n";
      ret+=(m->getfeinde() == "Keine." ? "* Niemand.\n": m->getfeinde())+"\n";
    }
  else 
    return 1;

  return write(make_document(ret)),1;
}

nosave varargs string gettitle(object who, int flag)
{
  string ret;

  if(!who->QueryProp(SKLISTENER))
    if(!present("\nspinnentool", who))
      return "Unwuerdige"+(who->QueryProp(P_GENDER)==FEMALE ? " ":"r ");
    else
      who->SetProp(SKLISTENER, 1);
  
  if((!flag) && ((who->QueryProp(P_INVIS)) || (who->QueryProp(P_FROG))))
    return "";
  
  if(who->QueryProp(P_GUILD)=="spinnenkrieger")
    ret="Spinnen";
  else
    ret="Drow";

  if(IS_WIZARD(who))
    ret+="magier"+(who->QueryProp(P_GENDER)==FEMALE ? "in ":" ");
  else 
    {
      if(who->QueryProp(P_GUILD)=="druidenzirkel")
	return "Drowdruid"+(who->QueryProp(P_GENDER)==FEMALE ? "in ":"e ");

      if(who->QueryProp(P_GUILD)=="zechpreller")
	return "Drowsaeufer"+(who->QueryProp(P_GENDER)==FEMALE ? "in ":" ");

      if(who->QueryProp(P_GUILD)=="berserker")
	return "Drowberserker"+(who->QueryProp(P_GENDER)==FEMALE ? "in ":" ");
      
      if(who->QueryProp(P_GUILD)=="nekromanten")
	return "Drownekromant ";
      
      if(IS_SEER(who))
	ret+=""+(who->QueryProp(P_GENDER)==FEMALE ? "priesterin ":"krieger ");
      else
	ret+="elf"+(who->QueryProp(P_GENDER)==FEMALE ? "e ":" ");
    }

  return ret;
}

nosave int is_drow(object who)
{
  if(who->QueryProp(P_RACE)=="Dunkelelf") return 1;
  else return 0;
}

nosave int is_higher(object a, object b)
{
  if((a->QueryProp(P_LP))>(b->QueryProp(P_LP))) return 1;
  else return 0;
}

nosave int is_not_ignoring(object pl, string str)
{
  string *ign;
  
  if(!interactive(pl)) return 0;
  if(!pointerp(ign=pl->QueryProp(P_IGNORE))) return 0;
  
  if((member(ign, str+".spinne")==-1) &&
     (member(ign, "spinne")==-1) && 
     (member(ign, str)==-1))
    return 1;
  else
    return 0;
}

varargs string getalign(int i, int flag)
{
  string ret;
  
  if(!intp(i)) i=0;
  
  if(i<= -1200) ret="diabolisch";
  else
    switch(i)
      {
      case -1199 .. -1000: ret="satanisch";  break;
      case  -999 ..  -800: ret="sehr boese"; break;
      case  -799 ..  -500: ret="boese";      break;
      case  -499 ..  -200: ret="gemein";     break;
      case  -199 ..   -40: ret="frech";      break;
      case   -39 ..    39: ret="neutral";    break;
      case    40 ..   199: ret="nett";       break;
      case   200 ..   499: ret="lieb";       break;
      case   500 ..   799: ret="!gut!";      break;
      case   800 ..   999: ret="!sehr gut!"; break;
      default:             ret="!!heilig!!";
      }
  
  if(flag)
    return ret;
  else
    return "[ "+ret+" ]";
}

nosave string erschoepfung(object tp)
{
  int p, c;

  p = 100 * tp->QueryProp(P_MV) / tp->QueryProp(P_MAX_MV);
  c=setting;
  
  switch (p)
    {
    case 0..5:   
      return "["+(c ? ANSI_RED : "")+
	sprintf("%18|s", "STOPP!! LUFT!!")+
	(c ? ANSI_NORMAL : "")+"]";
    case 6..15:  
      return "["+(c ? ANSI_YELLOW : "")+
	sprintf("%18|s", "total ausser Atem")+
	(c ? ANSI_NORMAL : "")+"]";
    case 16..30: 
      return "["+(c ? ANSI_GREEN : "")+
	sprintf("%18|s", "etwas erschoepft")+
	(c ? ANSI_NORMAL : "")+"]";
    default:     
      return "";
    }
}

nosave string gewicht(object tp)
{
  int p, c;

  p = 100 * (tp->QueryProp(P_TOTAL_WEIGHT) - tp->QueryProp(P_WEIGHT) )
    / tp->QueryProp(P_MAX_WEIGHT);
  c=setting;

  switch (p)
    {
    case  0 ..  50: 
      return "";
    case 51 ..  60: 
      return "- ["+(c ? ANSI_GREEN : "")+
	sprintf("%17|s", "etwas beladen")+(c ? ANSI_NORMAL : "")+" ]";
    case 61 ..  70: 
      return "- ["+(c ? ANSI_GREEN : "")+
	sprintf("%17|s", "ziemlich beladen")+(c ? ANSI_NORMAL : "")+" ]";
    case 71 ..  80: 
      return "- ["+(c ? ANSI_YELLOW : "")+
	sprintf("%17|s", "schwer beladen")+(c ? ANSI_NORMAL : "")+" ]";
    case 81 ..  90: 
      return "- ["+(c ? ANSI_YELLOW : "")+
	sprintf("%17|s", "sehr beladen")+(c ? ANSI_NORMAL : "")+" ]";
    case 91 ..  95: 
      return "- ["+(c ? ANSI_RED : "")+
	sprintf("%17|s", "extrem beladen!")+(c ? ANSI_NORMAL : "")+" ]";
    default:
      return "- ["+(c ? ANSI_RED : "")+
	sprintf("%17|s", "UFFF!! beladen!")+(c ? ANSI_NORMAL : "")+" ]";
    }
}

nosave string balken(int aktuell, int max, int colorflag, int wimpy)
{
  string ret;
  int i,w,s;
  
  if(aktuell > max) aktuell=max;

  i=(aktuell*100/max)/5;
  if(wimpy) w=(wimpy*100/max)/5;

  ret=duplicate(" ",20);
  
  if(!colorflag)
    {
      if(wimpy)
	if(aktuell<=wimpy)
	  ret=duplicate("+",w)+duplicate("-",20-w);
	else
	  ret=duplicate("+", w)+duplicate("#",i-w)+duplicate("-",20-i);
      else
	ret=duplicate("#",i)+duplicate("-",20-i);

      ret=sprintf("%3d",aktuell)+" ["+sprintf("%3d",max)+"] "+ret;
    }
  else
    if(colorflag==1)
      {
	s=strlen(to_string(aktuell));
	ret[<s+1..<2]=to_string(aktuell);
	if(wimpy)
	  if(aktuell<=wimpy)
	    ret=ANSI_BLACK+ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_RED+ret[w..<0]+ANSI_NORMAL;
	  else
	    ret=ANSI_BLACK+ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_GREEN+ret[w..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
	else
	  ret=ANSI_BLACK+ANSI_BG_GREEN+ret[0..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
	
      	ret=duplicate(" ",4)+ret;
	ret=ret+" ["+sprintf("%3d",max)+"]";
      }
    else
      {
	if(wimpy)
	  if(aktuell<=wimpy)
	    ret=ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_RED+ret[w..<0]+ANSI_NORMAL;
	  else
	    ret=ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_GREEN+ret[w..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
	else
	  ret=ANSI_BG_GREEN+ret[0..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
	ret=sprintf("%3d",aktuell)+" ["+sprintf("%3d",max)+"] "+ret;
      }
  return ret;
}

nosave string stupse(object pl)
{
  string ret;
  int i, lvl, rlvl;
  
  if((pl->LpLevel()==(pl->QueryProp(P_LEVEL)+1))
     && (pl->LevelPerc(pl->LpLevel()+1) < 20))
    lvl=pl->QueryProp(P_LEVEL);
  else
    lvl=pl->LpLevel();

  if(((lvl+1) < pl->QueryProp(P_LEVEL)) ||
     (lvl > pl->QueryProp(P_LEVEL)))
    rlvl=pl->QueryProp(P_LEVEL);
  
  i=pl->LevelPerc(lvl+1)/10;

  if(!setting)
    ret=sprintf("%10'-'-s", duplicate("#",i));
  else
    {
      ret=duplicate(" ", 10);
      ret=ANSI_BG_GREEN+ret[0..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
    }
  
  return sprintf("%3d+ [%s] %3d", lvl, ret, (rlvl ? rlvl : lvl+1));

}

nosave string zustand(object tp)
{
  string ret;
  int tmp;

  if(!tp) return "";

  ret="";

  if(tp->QueryProp(P_FROG))       
    ret+=" Frosch";

  if(tmp=tp->QueryProp(P_POISON)) 
    ret+=(tmp > 5 ? " GIFT!":" Gift");

  if(tp->QueryProp(P_BLIND))      
    ret+=(tp->QueryProp(P_BLIND)[BLIND_TIME] > 15 ? " BLIND!" : " Blind");

  if(tp->QueryProp(P_DEAF))
    ret+=(tp->QueryProp(P_DEAF)[DEAF_TIME] > 15 ? " TAUB!" : " Taub");

  if(!strlen(ret)) ret=" Normal.";

  return ret;
}

nosave int spfarbe(string str)
{
  notify_fail("Syntax: spfarbe 0 | 1 | 2\n");
  if(!str) return 0;
  
  switch(to_int(str))
    {
    case 0: 
      Setting(0); 
      return write("Farbmodus wird auf normal gesetzt.\n"), 1; 
      break;

    case 1: 
      Setting(1); 
      return write("Farbmodus wird auf spezial1 gesetzt.\n"), 1; 
      break;

    case 2: 
      Setting(2); 
      return write("Farbmodus wird auf spezial2 gesetzt.\n"), 1; 
      break;

    default : 
      return 0;
    }
  
  return 0;
}

nosave int sppresay(string str)
{
  string np, op;

  notify_fail(BS("Ihr koennt mit 'sppresay' nur Euer Dunkelelfen-Presay "
		 "setzen!")+
	      BS("Ihr koennt aber auch mit 'sppresay loeschen' das Presay "
		 "entfernen."));
  
  if(strlen(str)) 
    if(str=="loeschen")
      {
	if(!strlen(TP->QueryProp(P_PRESAY)))
	  return write(BS("Ihr hattet doch gar kein Presay gesetzt!?")), 1;
	
	TP->SetProp(P_PRESAY, "");
	
	return write(BS("Euer Presay wurde geloescht.")), 1;
      }
    else
      return 0;

  np=gettitle(TP, 1);
  
  if(strlen(op=TP->QueryProp(P_PRESAY)))
    if(np!=op)
      write(BS("Euer voriges Presay '"+op+"' wird ersetzt."));
  
  np=np[0..<2];
  
  TP->SetProp(P_PRESAY, np);
  
  write(BS("Ihr seid nun:")+
	BS(np+" "+CAP(getuid(TP))+" "+(TP->QueryProp(P_TITLE) || "")));
  
  return 1;
}

nosave int spinfo(string str)
{
  object tp;
  mapping at;
  int xp;
  
  tp=TP;

  if(tp->QueryProp(P_GHOST))
    return write("Geister haben keine Punkte!\n"),1;
  
  at=tp->QueryProp(P_ATTRIBUTES);

  if(xpdiff<=0) xpdiff=tp->QueryProp(P_XP);

  xp=tp->QueryProp(P_XP);

  write(sprintf(
    "\n"C"                                    /   \\\n"
    "                            )      ((   ))     (\n"
    "                           /|\\      ))_((     /|\\"O"\n"
    " _                   "C"     / | \\    (/\\|/\\)   / | \\ "O"                        _ \n"
    "| |----------------------"C"/"O"--"C"|"O"-"C"voV"O"---"C"\\`|'/"O"--"C"Vov"O"-"C"|"O
    "--"C"\\"O"-----------------------| |\n"
    "| | %29.29-s  "C" (o o)     "O"  %25s | |\n"
    "| |                                 "C"`\\Y/'"O"                                 | |\n"
    "| | Erfahrung:        %10d                                          | |\n"
    "| | Unterschied:      %10d    Leben: %30s | |\n"
    "| | Abenteuer:       %4d [%4d]    Magie: %30s | |\n"
    "| | Stufe: %21s                                          | |\n"
    "| |-----------------------------------------------------------------------| |\n"
    "| | Intelligenz:         %8-s   %37.37-s | |\n"
    "| | Ausdauer:            %8-s   Zustand:%28-s  | |\n"
    "| | Kraft:               %8-s   %14-s %22-s | |\n"
    "| | Geschicklichkeit:    %8-s   %20-s %16s | |\n"
    "| |_______________________________________________________________________| |\n"
    "(@)                 "C" l   /\\ /       ( (       \\ /\\   l "O"                   (@)\n"
    "                    "C" l /   V         \\ \\       V   \\ l\n"
    "                     l/              _) )_          \\I\n"
    "                                     `\\ /'\n"
    "                                       `"O"\n",

    gettitle(tp)+CAP(getuid(tp)),
    CAP(tp->QueryProp(P_GUILD))+" ["+tp->QueryProp(P_GUILD_LEVEL)+"]",
    xp, xp-xpdiff, 
    balken(tp->QueryProp(P_HP), tp->QueryProp(P_MAX_HP), setting, tp->QueryProp(P_WIMPY)),
    tp->QueryProp(P_QP), QM->QueryAllQP(),
    balken(tp->QueryProp(P_SP), tp->QueryProp(P_MAX_SP), setting,0),
//    stupse(tp->NextLevelPerc(), tp->QueryProp(P_LEVEL), setting),
    stupse(tp),
    sprintf("%d [%+d]", at[A_INT], tp->QueryAttributeOffset(A_INT)),
    (tp->QueryProp(P_WIMPY) ? 
     sprintf("Vo: %3d %30-s",tp->QueryProp(P_WIMPY),
	     (tp->QueryProp(P_WIMPY_DIRECTION) ? 
	      "Ri: "+tp->QueryProp(P_WIMPY_DIRECTION) : "")):""),
    sprintf("%d [%+d]", at[A_CON], tp->QueryAttributeOffset(A_CON)),
    zustand(tp),
    sprintf("%d [%+d]", at[A_STR], tp->QueryAttributeOffset(A_STR)),
    getalign(tp->QueryProp(P_ALIGN)), gewicht(tp),
    sprintf("%d [%+d]", at[A_DEX], tp->QueryAttributeOffset(A_DEX)),
    erschoepfung(tp), (tp->QueryMoney() ? tp->QueryMoney()+" Muenzen" : "")
    ));

  GetColor(1);
  return 1;
}

nosave int sphass(string str)
{
  object *drow;
  string me,what,bla,who;
  int i;

  if(TP->QueryProp(P_INVIS)) return write("Das geht nur, wenn Du sichtbar bist!!\n"),1;
  
  drow=filter_array(users(), "is_drow");
  drow=filter_array(drow, CLOSURE(is_not_ignoring), getuid(TP));
  drow-=({TP});

  me=gettitle(TP)+CAP(getuid(TP));
  what=({"Tod den ",
	   "Zur Hoelle mit den ",
	   "Tod und Verderben den ",
	   "Nieder mit den "})[random(4)];
  bla=({"verruchten ",
	  "stinkigen ",
	  "verfluchten ",
	  "frevelhaften ",
	  "ekelhaft guten ",
	  "seicherlhaften "})[random(5)];
  who=({"Elfen",
	  "Feen",
	  "Paladinen",
	  "Feinden",
	  "Zwergen"})[random(5)];

  for(i=sizeof(drow)-1;i>=0;i--)
    tell_object(drow[i], 
		me+" groehlt Euch zu: "+what+bla+who+"!!\n");
  
  write("Ihr groehlt den Anderen zu: "+what+bla+who+"!!\n");
  return 1;
}

nosave int spdunkel(string str)
{
  object *drow;
  object pl;
  string me;
  mixed m;
  
  int i;

  if(TP->QueryProp(P_INVIS)) return write("Das geht nur, wenn Du sichtbar bist!!\n"),1;
    
  if(str)
    {
      m=match_living(str, 1);
      if(m==-1)
        return write("Das war nicht eindeutig!\n"),1;
      if(m==-2)
      return write("Wen meint Ihr denn?\n"),1;
      
      if(pl=find_player(m))
        {
          if(pl==TP)
	    return write("Euch selbst?!\n"),1;
          if(pl->QueryProp(P_RACE)!="Dunkelelf")
            return write("Nur Dunkelelfen kommt dieses Privileg zugute!\n"),1;
	  
	  if(!is_not_ignoring(pl, getuid(TP)))
	    return write(CAP(getuid(TP))+" ignoriert Euch, oder Euren Befehl.\n"),1;
          me=gettitle(TP)+CAP(getuid(TP));
	  
          if(dunkel<=time() && (TP->QueryProp(P_SP)>DUNKEL))
	    {
              tell_object(pl,
           		  "Eine Aura des Boesen legt sich ueber Euch!\n"+
			  me+" sendet Euch dunkle Gruesse und einen Teil "+
			  TP->QueryPossPronoun(FEMALE, WESSEN)+
			  " Macht!\n");
              write("Ihr sendet Gruesse und einen Teil Eurer dunklen Macht an "+CAP(m)+".\n");
	      if(!IS_WIZARD(pl))
		{
		  TP->AddSp(-DUNKEL);
		  pl->AddSp(DUNKEL);
		}
	      
	      dunkel=time()+300+random(100);
	    }
	  else
	    {
	      tell_object(pl,
			  "Eine Aura des Boesen legt sich ueber Euch!\n"+
			  me+" uebersendet Euch dunkle Gruesse.\n"+
			  "Ihr dankt "+TP->name(WEM)+" aus der Ferne.\n"); 
	      write("Ihr uebersendet dunkle Gruesse an "+CAP(m)+".\n"+
		    CAP(m)+" dankt Euch aus der Ferne.\n");
	    }
        }
      else return write("Wen meint Ihr denn?\n"),1;
    }
  else
    {
      drow=filter_array(users(), "is_drow");
      drow=filter_array(drow, CLOSURE(is_not_ignoring), getuid(TP));
      drow-=({TP});
      
      me=gettitle(TP)+CAP(getuid(TP));
      
      for(i=sizeof(drow)-1;i>=0;i--)
	tell_object(drow[i], 
		    "Eine Aura des Boesen legt sich ueber Euch!\n"+
		    me+" huellt alle Dunkelelfen aus der Ferne in Lloths Finsternis.\n");
      
      write("Ihr sendet einen Teil Eurer Finsternis an Euer Volk.\n");
    }
  return 1;
}

nosave int spwink(string str)
{
  object *drow;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) return write("Das geht nur, wenn Du sichtbar bist!!\n"),1;
  
  drow=filter_array(users(), "is_drow");
  drow=filter_array(drow, CLOSURE(is_not_ignoring), getuid(TP));
  drow-=({TP});

  me=gettitle(TP)+CAP(getuid(TP));
  
  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(drow)-1;i>=0;i--)
    tell_object(drow[i], me+" winkt Euch "+str+"aus der Ferne zu.\n");

  write("Ihr winkt Eurem Volk "+str+"aus der Ferne zu.\n");
  return 1;
}

nosave int spwer(string str)
{
  string ret, n, li, reg;
  object *drow, *listeners;
  object en, we;
  int i, uc, siz;

  drow=filter_array(users(), "is_drow");
  drow=sort_array(drow, "is_higher");

  ret="Folgende Dunkelelfen sind anwesend:\n \n";

  ret+=sprintf("%25-s %6s %20-s%10s\n%64'-'s\n","Name","","Waffe","Gesinnung",""); 
  
  uc=0;  
  siz=0;

  for(i=sizeof(drow)-1;i>=0;i--)
    {
      if(!IS_WIZARD(TP)) if(drow[i]->QueryProp(P_INVIS)) continue;

      en=drow[i]->InFight();
      we=drow[i]->QueryProp(P_WEAPON);
      
      n=gettitle(drow[i]);
      
      if(strstr(n, "Unwuerdig", 0)!=-1)
	uc++;
      else
	siz++;
      
      if((IS_SEER(TP)) && (ENV(drow[i])))
        {
	  string *fn;
	  
	  fn=explode(file_name(ENV(drow[i])), "/");

	  switch(fn[0])
	    {
	    case "d":
	      reg=sprintf(" (%s)", CAP(fn[1]));

	      if(fn[1]=="seher")
		reg=" (Seherhaus)";
		
	      if((fn[1]=="unterwelt")&&(fn[2]=="zordan")&&(fn[3]=="dhrkion"))
		reg=" (Dhrkion)";
	      
	      if((fn[1]=="unterwelt")&&(fn[2]=="protheg")&&(fn[3][0..1]=="av"))
		reg=" (ArdulVhier)";
	      break;
	    case "gilden":
	      reg=" (Gilden)";
	      break;
	    case "players":
	      reg=" (Magiergebiet)";                              
	      break;
	    case "room":
	      if(fn[1]=="death")
		reg=" (Bei Lars)";
	      break;
	    default:
	      reg="";
	    }
	}
      else
	reg="";
      

      ret+=sprintf("%25-s %6s %20.20-s %10s\n - Standort: %-50.50s\n%s", 
		   n+CAP(getuid(drow[i])),
		   (query_idle(drow[i])>120 ? 
		    (query_idle(drow[i])>1800 ? "(IDLE)":"(idle)"):""),
		   (we ? extract_colors(we->Name(RAW)) : ""),
		   getalign(drow[i]->QueryProp(P_ALIGN), 1),
		   (ENV(drow[i]) ? ENV(drow[i])->QueryProp(P_INT_SHORT)+reg: 
		    "Im Nirvana"),
		   (en ? " - Im Kampf mit: "+en->Name(WER)+"\n" : "")+
		   (str=="kurz" ? "":"\n"));
    }

  listeners=users()-drow;
  li="";

  for(i=sizeof(listeners)-1;i>=0;i--)
    if((listeners[i]->QueryProp(SKLISTENER)) && 
       (!listeners[i]->QueryProp(P_INVIS)))
      li+=CAP(getuid(listeners[i]))+"-";

  ret+=BS("Das sind "+siz+" Drow"+
	  (uc ? " und "+uc+" Unwuerdige"+(uc==1 ? "r":""):"")+".")+"\n";

  if(strlen(li))
    ret+="Stille Lauscher:\n"+BS(implode(explode(li, "-"), ", "));
  
  TP->More(make_dokument(ret));
  return 1;
}

nosave int sphist(string str)
{
  object pl;
  string ret;

  if(pl=ENV(ME))
    if(interactive(pl))
      if(pl==TP)
	if(strlen(ret=LLOTH->QueryHistory()))
	  pl->More(ret);
	else
	  write(BS("In letzter Zeit war es recht ruhig..."));

  return 1;
}

nosave int sprufen(string str)
{
  object *plr;
  string pre;
  int i;
  
  notify_fail(BS("Was wollt Ihr Eurem Volk mitteilen?"));
  if(!str) return 0;
  
  if(!TP) return 0;
  if(!MENV) return 0;
  if(TP!=MENV) return 0;
  
  if(TP->QueryProp(P_INVIS)) return write("Das geht nur, wenn Du sichtbar bist!!\n"),1;
  
  plr=users()-({TP});
  
  str=TP->_unparsed_args();
  
  pre=gettitle(TP);
  pre+=CAP(getuid(TP))+" teilt Euch mit: ";

  pre=break_string(str, 78, pre);
  
  for(i=sizeof(plr)-1;i>=0;i--)
    {
      if(plr[i]->QueryProp(SKLISTENER))
	if(is_not_ignoring(plr[i], getuid(TP)))
	  tell_object(plr[i], pre);
    }
  
  if(!IS_SEER(TP)) TP->AddSp(-1);
  
  write(break_string(str, 78, "Ihr teilt den anderen Drow mit: "));
  LLOTH->AddHistory(getuid(TP),implode(explode(str,"\n"),""));
  return 1;
}

string extra_look()
{
  return capitalize(environment()->QueryPronoun())+
    " hat eine kleine Spinne auf "+
    environment()->QueryPossPronoun(2,2) + " Schulter sitzen.\n";
}

void NotifyHpChange()
{
  int    hp, mhp, sp, msp, prz;
  string col;
  
  // Sicherheits-Check
  if (!previous_object() || !owner || (owner != previous_object()))
    return;

  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv)
  {
    //SetProp(P_NODROP, 0);
    if (owner!=find_netdead(getuid(owner)))
      owner->RemoveHpHook(ME);   // geht nur bei nicht-netztoten Spielern
    return;
  }

  // Test auf Geist
  if (owner->QueryProp(P_GHOST))
    return;

  // aktuelle Werte ermitteln
  hp = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);

  // Vergleich und Ausgabe
  if((hp < lastHP) || (hp != lastHP && sp == msp) || (sp != lastSP))
    {
      switch(show)
	{
	case KURZ:
	  tell_object(owner,
		      "* LP: "+hp+" ("+mhp+") MP: "+sp+" ("+msp+")\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, "Ihr seid nun wieder absolut fit.\n");
	  break;
	case SPEZIAL:
	  switch (hp*100/mhp)
	    {
	    case  0 ..  20: col=ANSI_RED+ANSI_BOLD;    break;
	    case 21 ..  40: col=ANSI_BLUE+ANSI_BOLD;   break;
	    case 41 ..  60: col=ANSI_CYAN+ANSI_BOLD;   break;
	    case 61 ..  80: col=ANSI_YELLOW+ANSI_BOLD; break;
	    case 81 .. 100: col=ANSI_GREEN+ANSI_BOLD;  break;
	    default: col=ANSI_NORMAL;
	    }
	  tell_object(owner,
		      col+"* Ihr habt nun "+hp+" von "+mhp+" Lebenspunkten und "+
		      sp+" von "+msp+" Magiepunkten."+ANSI_NORMAL+"\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, 
			col+"* Ihr seid nun wieder absolut fit."+ANSI_NORMAL+"\n");
	  break;
	case SPEZIALKURZ:
	  switch (hp*100/mhp)
	    {
	    case  0 ..  20: col=ANSI_RED+ANSI_BOLD;    break;
	    case 21 ..  40: col=ANSI_BLUE+ANSI_BOLD;   break;
	    case 41 ..  60: col=ANSI_CYAN+ANSI_BOLD;   break;
	    case 61 ..  80: col=ANSI_YELLOW+ANSI_BOLD; break;
	    case 81 .. 100: col=ANSI_GREEN+ANSI_BOLD;  break;
	    default: col=ANSI_NORMAL;
	    }
	  tell_object(owner,
		      col+"* LP: "+hp+" ("+mhp+") MP: "+sp+" ("+msp+")"+ANSI_NORMAL+"\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, 
			col+"* Ihr seid nun wieder absolut fit."+ANSI_NORMAL+"\n");
	  break;
	default:
	  tell_object(owner,
		      "* Ihr habt nun "+hp+" von "+mhp+" Lebenspunkten und "+
		      sp+" von "+msp+" Magiepunkten.\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, "* Ihr seid nun wieder absolut fit.\n");
	}
    }
  // neue Werte merken
  lastHP = hp; lastSP = sp;
}

nosave int Report(string str)
{
  if (MENV != TP)
    return notify_fail("Die Spinne muss Dir auf der Schulter sitzen, um "+
      "dies zu koennen!\n"), 0;

  notify_fail("Syntax: report ein|aus|kurz|spezial|spezialk.\n");

  switch (str)
    {
    case "ein":
    case "n":
    case "normal":
      if (aktiv && objectp(owner))
	if(show==NORMAL)
	  write("Der Report-Modus normal ist schon eingeschaltet!\n");
	else
	  {
	    show=NORMAL;
	    write("Der Report-Modus wird auf normal umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus ist jetzt eingeschaltet.\n");
	  activate(TP);
	  show=NORMAL;
	}
      break;
    case "a":
    case "aus":
      if (!aktiv)
        write("Der Report-Modus ist doch schon ausgeschaltet!\n");
      else 
	{ 
	  write("Report-Modus ist nun ausgeschaltet.\n");
	  activate(0);
	}
      break;
    case "k":
    case "kurz":
      if(aktiv && objectp(owner))
	if(show==KURZ)
	  write("Der Report-Modus kurz ist schon eingeschaltet!\n");
	else
	  {
	    show=KURZ;
	    write("Der Report-Modus wird auf kurz umgestellt!\n");
	  }
      else
	{
	  write("Report-Modus kurz ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=1;
      break;
    case "s":
    case "spezial":
      if(aktiv && objectp(owner))
	if(show==SPEZIAL)
	  write("Der Report-Modus spezial ist schon eingeschaltet!\n");
	else
	  {
	    show=SPEZIAL;
	    write("Der Report-Modus wird auf spezial umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus spezial ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=2;
      break;
    case "sk":
    case "spezialkurz":
      if(aktiv && objectp(owner))
	if(show==SPEZIALKURZ)
	  write("Der Report-Modus spezialkurz ist schon eingeschaltet!\n");
	else
	  {
	    show=SPEZIALKURZ;
	    write("Der Report-Modus wird auf spezialkurz umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus spezialkurz ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=3;
      break;
    default:
      return 0;
    }
  return 1;
}

void kreisch(object who)
{
  tell_object(who, "Die Spinne bruellt: 'Du bist kein Dunkelelf!!'\nDann "+
	      "laeuft sie weg und verschwindet in irgendeiner Spalte.\n");
  call_out("remove", 0);
}

varargs int move(mixed dest, int method)
{
  int res;
  object env;
  
  res=::move(dest,method);
  
  env=MENV;
  
  if((IS_LEARNER(env)) || env->QueryProp(P_TESTPLAYER))
    SetProp(P_AUTOLOADOBJ, 1);        // fuer Magier autoload
  else
    SetProp(P_AUTOLOADOBJ, 0);

  if((interactive(env)) && (env->QueryProp(P_RACE)!="Dunkelelf") &&
     (!IS_WIZARD(env)))
    call_out("kreisch",0,env);
  else
    {
      if((interactive(env)) && (env->QueryProp(P_RACE)=="Dunkelelf"))
	{
	  env->SetProp(SKLISTENER, 1);
	  DB("*** Activating Property SKLISTENER in "+CAP(getuid(env))+
	     ". Version 1."+VER+"\n");
	}

      if(xpdiff<=0) xpdiff=env->QueryProp(P_XP);
      
      call_out("checkowner", 1);
    }
    
  return res;
}


void checkowner()
{
  if (aktiv && !objectp(owner) && stringp(owner_name)) 
    {
      owner = find_player(owner_name);
      if(!objectp(owner)) 
	activate(0);
      else 
	activate(owner);
    }
}

int remove(int x)
{
  if((TP) && (MENV) && (TP==MENV))
    {
      if(aktiv) MENV->RemoveHpHook(ME);
      if(!(present(SPINNENTOOL, TP)))
	MENV->SetProp(SKLISTENER, 0);
    }
  
  return ::remove(x);
}

// ---------------------------------------------------------------------------

varargs void init_soul_cmds(int force)
{
  string *cmds;
  string *tmp;
  int i;
  
  if((!force) && (file_date(SOULFILE)==souldate)) return;
  
  souldate=file_date(SOULFILE);

  DB(BS("*** Spinnensoul in "+sprintf("%O", (MENV||TP||"-"))+
	" Rehashing from file ("+ctime(souldate)+")"));
  
  soulcmds=([]);
    
  cmds=explode(read_file(SOULFILE), "\n");
  
  for(i=sizeof(cmds)-1;i>=0;i--)
    {
      tmp=explode(cmds[i], "##");

      if(sizeof(tmp)!=9)
	{
	  DB("*** Spinnensoul: Fehler beim Einlesen ("+i+")\n");
	  continue;
	}
      
      soulcmds+=([i:explode(tmp[0],","); ({ tmp[1], tmp[2], tmp[3], tmp[4],
		  tmp[5], tmp[6]}); tmp[7]; tmp[8]]);
      
      AddCmd(soulcmds[i], "spinnensoulcmd");
    }
}

nosave int spinnensoulcmd(string str)
{
  int i;
  
  for(i=sizeof(soulcmds)-1;i>=0;i--)
    if(member(soulcmds[i], query_verb())!=-1)
      return rbefehl (str, soulcmds[i,1], to_int(soulcmds[i,2]), 
		      to_int(soulcmds[i,3]));
  
  return 0;
}

string _in(string a, mapping m)
{
  if (member(m,lower_case(a)))
    return m[a];
  else
    return "";
}

string ParseAdverben(string str, object ob)
{
  string *advpart;
  mixed quotedpart;
  mapping adverben;

  if (!str) return 0;
  str=" "+str;
  adverben=ob->QueryStdAdverbs()+ob->QueryAdverbs();
  advpart=explode(str,"/");
  if (sizeof(advpart)>1)
    quotedpart=" "+implode(advpart[1..],"/");
  else
    quotedpart="";
  advpart=regexplode(advpart[0],"\\<[^, ]*\\>");
  advpart=map_array(advpart,CLOSURE(_in),adverben) - ({""});
  return sizeof(advpart) ? ob->CountUp(advpart)+quotedpart : quotedpart[1..];
}

/*
explode_str() - ersetzt @@...@@ Makros
-------------
str ......... der String
ob .......... das Objekt, dessen Name eingesetzt werden soll
adv ......... Adverben
fern ........ 0: Naehe, 1: aus der Ferne
*/
varargs string explode_str(string str, object ob, string adv, int fern)
{
  string s,s1,s2,x;
  s2=str;
  s="";

  while (sscanf(s2, "%s@@%s@@%s", s1, x, s2) == 3)
    {
      switch (x)
	{
	case "WER":    
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WER);
	  break;

	case "WESSEN": 
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,1);
	  else s+=s1+ob->name(WESSEN);
	  break;

	case "WEM":
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WEM);
	  break;

	case "WEN":
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WEN);
	  break;

	case "WIE":
	  s+=s1+adv; 
	  break;
	  
	case "FERN":   
	  if (fern>0) s+=s1+" aus der Ferne"; 
	  else s+=s1; 
	  break;
	  
	case "HAARFARBE":
	  s+=s1+ob->QueryProp(P_HAIR_COLOR)+"e ";
	  break;
	  
	case "HAARFARBEN":
	  s+=s1+ob->QueryProp(P_HAIR_COLOR)+"en ";
	  break;
	}
    }
  
  s+=s2;
  
  return s;
}

/*
  
rbefehl()
---------
str ......... der String, wie er beim Befehl angehaengt wurde
form ........ ein Array mit den diversen Meldungen:
form[0].... Fehlermeldung, wenn str leer ist
form[1].... Fehlermeldung, wenn Spieler == Zielperson
form[2].... sprintf Fehlermeldung bei nicht parse-baren Adverben
"...%s...", Zielperson->Name(casus)
form[3].... sprintf Maske fuer Zielperson
"%s...%s...%s.\n", Spieler, Adverben, ["Ferne"]
form[4].... sprintf Maske fuer Spieler
"...%s...%s...%s.\n", Zielperson->Name(casus), Adverben, ["Ferne"]
form[5].... sprintf Maske fuer Raum
"%s...%s...%s...", Spieler, Zielperson->Name(casus), Adverben
sp........... Kosten (spellpoints)
---
Anmerkungen:

"Ferne"  ist " aus der Ferne", wenn die Spieler in verschiedenen Raeumen
            stehen, sonst ein Leerstring ("").
Adverben   werden wie soul-Adverben geparsed, ihnen wird ausserdem ein
           Space vorangestellt (um sie fuer die sprintf Maske optional
           zu machen).
*/
 
varargs int rbefehl(string str, string *form, int sp, int nearonly)
{
  string *s, adv, away;
  mixed ob;
  object room;
  int i, ferne;
  
  if(MENV != TP)
    return notify_fail(BS("Dazu musst Du "+name(WEN,1)+" erst einmal "
			  "an Dich nehmen!")), 0;
  if(!IS_SEER(TP) && (TP->QueryProp(P_SP) < sp))
    return notify_fail("Dazu hast Du zuwenig Magiepunkte!\n"), 0;
  
  notify_fail(BS(form[0]));
  
  str=TP->_unparsed_args();
  
  if (!stringp(str) || str=="") return 0;
  
  s=explode (str, " ");
  if(!i=sizeof(s)) return 0;
  
  s[0]=LOWER(s[0]);
  
  ob=find_player(s[0]) || match_living(s[0], 1);
  // ergibt:  - Spielerobjekt oder
  //          - String (passender Spielername) oder
  //          - Integer (-1: multiple matches, -2: no matches)
  if (stringp(ob)) ob=find_player(ob);
  // Jetzt: - Spielerobjekt oder
  //        - Integer (0 oder -2: nicht da, -1: mehrere da)
  
#ifdef INVIS_SPERRE
  if (objectp(ob) && !IS_WIZARD(TP) && ob->QueryProp(P_INVIS)) ob=0;
#endif
  
  if (!objectp(ob)) 
  {
    if (ob==-1)
      return notify_fail("Das war nicht eindeutig!\n"), 0;
    else
      return notify_fail("Kein solcher Spieler!\n"), 0;
  }
  
  if (ob==TP) return notify_fail(BS(form[1])), 0;
  
  if (i<2) adv="";
  else
    {
      if (!adv=ParseAdverben(implode(s[1..], " "), TP))
	return notify_fail (BS(sprintf(explode_str(form[2], ob)))), 0;
      else
	if (strlen(adv)) adv=" "+adv;
    }
  
  // aus der Ferne?
  // (Bei der Gelegenheit ausserdem gleich room und ferne setzen)
  ferne=(room=ENV(TP)) != ENV(ob);
  
  if(nearonly && ferne)
    return write(BS(ob->Name(WER)+" ist zuweit weg von Dir...")), 1;
  
  if(s=ob->QueryProp(P_IGNORE))
    if(member(s, lower_case(getuid(TP))+".spinne") != -1)
      return write(BS(ob->Name(WER)+" ignoriert Deine Spinne. (Wie "
		      "gemein...)\n")), 1;

  // Nun die eigentliche Ausgabe:
  // tell_object (ob, bs(sprintf(explode_str(form[3], ob, adv, ferne), TPN)));
  if(ob->Message(BS(CAP(sprintf(explode_str(form[3], ob, adv, ferne),
          gettitle(TP)+(INV_TEST(ob,TP,TP) ? WIZ_NAME(TP,0) : TPN)))))==-1)
    write(ob->Name(WER)+" ignoriert Dich oder diesen Befehl.\n");
  else 
  {
    write(BS(CAP(sprintf(explode_str(form[4], ob, adv, ferne)))));
    if (!ferne)
      tell_room(room, BS(CAP(
	  sprintf(explode_str(form[5], ob, adv, -1), gettitle(TP)+TPN))), 
	  ({TP,ob}) );
  }
  
  if(interactive(ob) && ((i=query_idle(ob)) >= 600))
  {
    if(i < 3600)
      away = time2string("%m %M", i);
    else
      away = time2string("%h %H und %m %M", i);

    printf("%s ist seit %s passiv.\n", ob->Name(WER), away);
  }
  
  
  if (!IS_SEER(TP) && sp)
    TP->AddSp(-sp);

  return 1;
}
