/*
  Dunkelkugelitem fuer Spell der Spinnenkrieger
  Teilweise aus Dunkelheit der Delfen uebernommen
  wegen Kompatibilitaet
*/

inherit "std/thing";

#include <properties.h>
#include <class.h>
#include "../def.h"

create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,0);
  SetProp(P_LONG,0);
  SetProp(P_NAME,"Dunkelheit");
  SetProp(P_GENDER,FEMALE);
  AddId(D_DUNKEL);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE,0);
  SetProp(P_LIGHT,0);
}

init() 
{
  ::init();
  if (MENV && living(MENV)) call_out("undweg",0);
}

reset()
{
  ::reset();
  call_out("undweg",0);
}

undweg() 
{
  if(MENV) 
    tell_room(MENV, 
	      "Das Licht um Dich herum beginnt sich zu veraendern!\n"+
	      "Deine Umgebung scheint "+
	      (QueryProp(P_LIGHT) >0 ? "dunkler ":"heller ")+
	      "zu werden...\n");
  call_out("remove",0);
}

verdunkeln(object not, int lvl, int dauer)
{
  object *loo;
  int i,b;

  
  loo=all_inventory(environment(not));
  loo=loo-({not});
  tell_object(not,
	      BS("Du wirfst die Kugel auf den Boden und wendest Deine "+
		 "empfindlichen Augen ab. Du merkst nur wie sich ploetzlich "+
		 "Deine Umgebung "+(lvl<-3 ? "extrem ":"")+"aendert..."));
  tell_room(environment(not),
	    not->Name(WER,1)+" wirft eine kleine Kugel vor sich auf den "+
	    "Boden...\nPloetzlich wird alles "+(lvl<-3 ? "extrem ":"")+
	    "dunkel!\n",({not}));
  DB("*** Dunkelkugel: "+not->Name()+" - Lvl "+lvl+" - Dauer "+dauer+".\n");
  for(i=sizeof(loo)-1;i>=0;i--) if(living(loo[i]))
    if(!loo[i]->is_class_member(CL_NIGHTVISION))
      {
	b=10-random(lvl)*3;
	DB("*** Dunkelkugel erwischt: "+loo[i]->Name()+" mit "+b+".\n");
	loo[i]->SetProp(P_BLIND, 
			([BLIND_MSG:"Du bist von der Dunkelheit geblendet!\n",
			BLIND_TIME:b]));
      }
  SetProp(P_LIGHT, lvl);
  call_out("undweg",dauer);
}
