/*
** Ein Spinnenautomat, uebernommen vom Teddyautomat
**
** ---
**
** 2000-03-05 PROtheG  Umbau des Teddyautomaten mit Anpassung 
**                     an das Spinnentool
**
** 2001-03-21 PROtheG  Spinnen bekommt man jetzt nur, wenn man
**                     Odanias Quest bestanden hat
*/

inherit "std/thing";

#define SPINNE "/p/service/protheg/rt/obj/drowspinne"
#define ODANIAQUEST "Finde das Juwel"

#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();

  AddId(({"netz","spinnennetz"}));
  SetProp(P_SHORT, "Ein Spinnennetz");
  SetProp(P_LONG, 
	  BS("Ein aufgehaengtes Spinnennetz, auf dem es nur so vor Spinnen "
	     "wimmelt. Es scheint von einer magischen Aura umgeben zu sein."));
  SetProp(P_INFO,
	  BS("Vielleicht geht ein Teil der Aura auf Dich ueber, wenn "
	     "Du das Netz beruehrst."));
  
  AddDetail(({"spinne","spinnen"}),
	    "Viele kleine Spinnen tummeln sich auf dem Netz herum.");
  AddDetail(({"teil","aura"}), 
	    "Vielleicht geht ein Teil von ihr auf Dich ueber, wenn "
	    "Du das Netz beruehrst.");
  
  SetProp(P_NAME, "Spinnennetz");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 1);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_NOGET, "Nein! Du wuerdest es sicher zerstoeren!\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_SILK:80,MAT_MISC_LIVING:20]));
  AddCmd(({"beruehre","beruehr"}), "beruehren");
  SUID;
}

nosave beruehren(string str)
{
  object spinne;
  
  notify_fail("Was willst Du denn beruehren?\n");
  if(!str) return 0;
  
  if(str=="netz"||str=="spinnennetz")
    {
      if(!TP->QueryQuest(ODANIAQUEST))
	return write(BS("Du beruehrst das Spinnennetz, doch keine der Spinnen "
			"scheint Dich wahrzunehmen. Da vernimmst Du eine "
			"Stimme in Deinem Kopf:")+
		     "'Erst wenn Du Odanias Aufgabe erledigt hast, helfe ich "
		     "Dir!'\n"),1;
      
      if(TP->QueryProp(P_RACE)!="Dunkelelf")
	{
	  write(BS("Du beruehrst das Spinnennetz, und spuerst eine "
		   "leichte Vibration, als sich eine Spinne auf Deine "
		   "Hand zubewegt...")+
		BS("Autsch! Die Spinne hat Dich gebissen?!")), 1;
	  
	  TP->AddHp(-3);
	  TP->AddPoison(1);
	  
	  return 1;
	}
      
      if(spinne=present("\nPROtheG_Racetool",TP))
	{
	  spinne->remove();
	  write(BS("Du beruehrst das Spinnennetz und spuerst eine leichte "
		   "Vibration, als Dich Lloths Macht durchdringt. Da wird die "
		   "kleine Spinne auf Deiner Schulter ploetzlich lebendig und "
		   "kehrt zurueck auf das Netz. Jedoch eine andere Spinne "
		   "krabbelt Dir auf die Hand und klettert auf Deine Schulter..."));
	  say(BS(CAP_TPN+" beruehrt vorsichtig das Spinnennetz, wodurch sich "
		 "die Spinne auf "+TP->QueryPossPronoun(FEMALE,WEM)+
		 " Schulter loest und durch eine andere Spinne, die von dem "
		 "Netz herunterkrabbelt, ersetzt wird."));
	}
      else
	{
	  write(BS("Du beruehrst das Spinnennetz und spuerst eine leichte "
		   "Vibration, als Dich Lloths Macht durchdringt. Eine kleine "
		   "Spinne loest sich aus dem Getuemmel und krabbelt auf Deine "
		   "Schulter, wo sie erstarrt."));
	  say(BS(CAP_TPN+" beruehrt vorsichtig das Spinnennetz, wodurch sich "
		 "eine Spinne aus der Menge loest und "+TP->QueryPronoun(WEM)+
		 " auf die Schulter krabbelt."));
	}

      spinne=clone_object(SPINNE);
      spinne->move(TP, M_NOCHECK);

      return 1;
    }

  return 0;
}
