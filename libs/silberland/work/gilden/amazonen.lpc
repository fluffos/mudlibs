int cmd_verbessere(string str)
{
  string spell;
  int current, points, total, max_total;

  notify_fail("Welchen Zauberspruch willst Du verbessern?\n");
  if (!str)
    return 0;

  if (!IsGuildMember(this_player()))
  {
    write("Du gehoerst dieser Gilde nicht an!\n");
    return 1;
  }

  spell = implode(explode(lower_case(str), " "), "");
  if (!strlen(spell))
    return 0;

  if (!QuerySpell(spell))
  {
    write("Diesen Zauberspruch gibt es hier nicht.\n");
    return 1;
  }

  max_total = this_player()->QueryProp(P_GUILD_LEVEL);
  if (max_total < 0) max_total = 0;
  total = AMAZONEN_TALENTMASTER->QuerySpentTotal(this_player());
  if (total >= max_total)
  {
    write(sprintf("Du hast bereits alle Deine Talentpunkte ausgegeben (%d/%d).\n",
                  total, max_total));
    return 1;
  }

  current = AMAZONEN_TALENTMASTER->QuerySpentPoints(this_player(), spell);
  if (current >= 3)
  {
    write(sprintf("Du kannst %s nicht weiter verbessern (Maximum: 3).\n",
                  capitalize(spell)));
    return 1;
  }

  points = AMAZONEN_TALENTMASTER->AddSpentPoints(this_player(), spell, 1);
  if (points < 0 || points == current)
  {
    write("Du kannst gerade keinen weiteren Talentpunkt investieren.\n");
    return 1;
  }

  write(sprintf("Du verbesserst %s. (Punkte: %d/3)\n", capitalize(spell), points));
  return 1;
}

int cmd_ordenwechsel(string str)
{
  string new_orden, old_orden;
  mixed entry;

  if (!present(GUILD_NPC_ID))
  {
    write(GUILD_NPC_NAME + " ist nicht da.... so ein Pech!\n");
    return 1;
  }

  if (!IsGuildMember(this_player()))
  {
    write(GUILD_NPC_NAME+" sagt: Du bist ja gar keine Amazone!\n");
    return 1;
  }

  entry = AMASTER->QueryMemberEntry(getuid(this_player()));
  old_orden = (pointerp(entry) && sizeof(entry) > POS_ORDER) ? entry[POS_ORDER] : 0;

  notify_fail("Welchen Orden willst Du waehlen? (Orakel|Schildmaid|Valkyre|Speertaenzer)\n");
  if (!str)
  {
    write(sprintf(GUILD_NPC_NAME+" sagt: Du gehoerst derzeit zum Orden: %s\n",
                  stringp(old_orden) && strlen(old_orden) ? old_orden : "-"));
    return 0;
  }

  new_orden = normalize_orden(str);
  if (!new_orden)
  {
    write("Diesen Orden gibt es nicht.\n");
    return 1;
  }
  if (stringp(old_orden) && old_orden == new_orden)
  {
    write("Du gehoerst diesem Orden bereits an.\n");
    return 1;
  }

  if (AMASTER->SetOrder(this_player(), new_orden) < 1)
  {
    write("Das geht gerade nicht.\n");
    return 1;
  }

  reset_order_kit(this_player(), new_orden);
  write(sprintf("Du schlaegst von nun an den Weg der %s ein.\n", new_orden));
  return 1;
}

int cmd_verlerne(string str)
{
  int freed;

  notify_fail("Was willst Du verlernen?\n");
  if (!str)
    return 0;

  str = implode(explode(lower_case(str), " "), "");
  if (str != "verbesserungen")
    return 0;

  if (!present(GUILD_NPC_ID))
  {
    write("Hier ist leider niemand, der Dir dabei helfen koennte!\n");
    return 1;
  }

  if (!IsGuildMember(this_player()))
  {
    write("Du gehoerst dieser Gilde nicht an!\n");
    return 1;
  }

  freed = AMAZONEN_TALENTMASTER->ResetSpentSpells(this_player());
  if (freed < 0)
  {
    write("Das geht gerade nicht.\n");
    return 1;
  }

  write(sprintf("Du verlernst alle Verbesserungen. (%d Talentpunkte freigegeben)\n",
                freed));
  return 1;
}


string int2string(int wert)
{
  string str;
  switch(wert)
  {
    case    0..250 : str = "gar nicht"; break;
    case  251..500 : str = "so gut wie gar nicht"; break;
    case  501..750 : str = "fast gar nicht"; break;
    case  751..1000: str = "ganz wenig"; break;
    case 1001..1250: str = "kaum"; break;
    case 1251..1500: str = "sehr miserabel"; break;
    case 1501..1750: str = "miserabel"; break;
    case 1751..2000: str = "erbaermlich"; break;
    case 2001..2250: str = "wie eine blutige Anfaengerin"; break;
    case 2251..2500: str = "wie eine Anfaengerin"; break;
    case 2501..2750: str = "ziemlich schlecht"; break;
    case 2751..3000: str = "schlecht"; break;
    case 3001..3250: str = "nicht ganz so schlecht"; break;
    case 3251..3500: str = "sehr laienhaft"; break;
    case 3501..3750: str = "laienhaft"; break;
    case 3751..4000: str = "nicht mehr ganz laienhaft"; break;
    case 4001..4250: str = "weit unterdurchschnittlich"; break;
    case 4251..4500: str = "unterdurchschnittlich"; break;
    case 4501..4750: str = "fast durchschnittlich"; break;
    case 4751..5000: str = "durchschnittlich"; break;
    case 5001..5250: str = "mittelmaessig"; break;
    case 5251..5500: str = "ueberdurchschnittlich"; break;
    case 5501..5750: str = "weit ueberdurchschnittlich"; break;
    case 5751..6000: str = "einigermassen"; break;
    case 6001..6250: str = "befriedigend"; break;
    case 6251..6500: str = "sehr befriedigend"; break;
    case 6501..6750: str = "akzeptabel"; break;
    case 6751..7000: str = "sehr akzeptabel"; break;
    case 7001..7250: str = "recht gut"; break;
    case 7251..7500: str = "ganz gut"; break;
    case 7501..7750: str = "gut"; break;
    case 7751..8000: str = "wirklich gut"; break;
    case 8001..8250: str = "sehr gut"; break;
    case 8251..8500: str = "unglaublich gut"; break;
    case 8501..8750: str = "phantastisch gut"; break;
    case 8751..9000: str = "ausgezeichnet"; break;
    case 9001..9200: str = "bewundernswert"; break;
    case 9201..9400: str = "hervorragend"; break;
    case 9401..9600: str = "exzellent"; break;
    case 9601..9700: str = "meisterhaft"; break;
    case 9701..9800: str = "veteranenhaft"; break;
    case 9801..9850: str = "wie eine alte Veteranin"; break;
    case 9851..9900: str = "legendaer"; break;
    case 9901..9950: str = "perfekt"; break;
    case 9951..9999: str = "beinahe goettlich"; break;
    case 10000:      str = "goettlich"; break;
    default: str = "buggend!!!!";
  }
  return str;
}


string skillname(string skill, string order)
{
  if (skill == SK_MAGIC_DEFENSE)
    return (order==AMAZONEN_ORDEN_SCHILDMAID?"den Schildkampf":"das Ausweichen");
  else if (skill == FIGHT(WT_SPEAR)) 
    return "den Speerkampf";
  else if(skill == SK_CASTING)
    return "die Zauberei";
  else
    return CAP(skill);
}


int cmd_faehigkeiten(string str)
{
  int i, wert;
  string *arm, s, order;
  mapping res, spent_spells;
  string *spells, *spent_names;
  string table;
  int points, max_total, total, avail;

  if (IS_LEARNING(this_player()))
  {
    s = GUILD_NPC_NAME+" sagt: Weil Du Magier bist - Deine Skills:\n";
    res = this_player()->QueryProp(P_NEWSKILLS);
    arm = sort_array(m_indices(res),#'<);
    for (i = sizeof(arm)-1;i>=0;i--)
    {
      s += sprintf(GUILD_NPC_NAME+" sagt: %-15s: ", arm[i]);
      if (mappingp(res[arm[i]])) s += res[arm[i]][SI_SKILLABILITY];
      else s += res[arm[i]];
      s += "\n";
    }
    printf( s );
    return 1;
  }
  if (!present(GUILD_NPC_ID))
  {
    write(GUILD_NPC_NAME+" ist nicht da.... so ein Pech!\n");
    return 1;
  }
  if (!IsGuildMember(this_player()))
  {
    write(GUILD_NPC_NAME+" sagt: Du bist ja gar keine Amazone!\n");
    return 1;
  }
  write(GUILD_NPC_NAME+" sagt: Folgende Faehigkeiten hast Du schon erlernt:\n");
  res = this_player()->QueryProp(P_NEWSKILLS);
  arm = sort_array(m_indices(res),#'<);
  order = AMASTER->QueryMemberEntry(getuid(this_player()))[POS_ORDER];

  max_total = this_player()->QueryProp(P_GUILD_LEVEL);
  if (max_total < 0) max_total = 0;
  total = AMAZONEN_TALENTMASTER->QuerySpentTotal(this_player());
  if (total < 0) total = 0;
  if (total > max_total) total = max_total;
  avail = max_total - total;
  write(sprintf(GUILD_NPC_NAME+" sagt: Du hast noch %d von %d Talentpunkten uebrig.\n",
                avail, max_total));

  spent_spells = AMAZONEN_TALENTMASTER->QuerySpentSpells(this_player());
  spells = ({ });
  for (i = sizeof(arm) - 1; i >= 0; i--)
    if (QuerySpell(arm[i]))
      spells += ({ arm[i] });
  if (mappingp(spent_spells) && sizeof(spent_spells))
  {
    spent_names = m_indices(spent_spells);
    for (i = sizeof(spent_names) - 1; i >= 0; i--)
      if (QuerySpell(spent_names[i]) && member(spells, spent_names[i]) == -1)
        spells += ({ spent_names[i] });
  }

  if (sizeof(spells))
  {
    spells = sort_array(spells, #'<);
    table = sprintf("%-24s %-39s %s\n", "Zauber", "Guete", "Talentpunkte");
    table += sprintf("%'-'-78s\n", "");
    for (i = sizeof(spells) - 1; i >= 0; i--)
    {
      points = AMAZONEN_TALENTMASTER->QuerySpentPoints(this_player(), spells[i]);
      if (points < 0) points = 0;
      if (points > 3) points = 3;
      table += sprintf("%-24s %-39s %d/3\n",
                       capitalize(spells[i]),
                       int2string(this_player()->QuerySkillAbility(spells[i])),
                       points);
    }
    write("\n");
    write(table);
  }

  write("\n");
  for (i = sizeof(arm) - 1; i >= 0; i--)
  {
    if (QuerySpell(arm[i]))
      continue;
    write(GUILD_NPC_NAME + " sagt: " + CAP(skillname(arm[i], order))
        + " beherrscht Du "
        + int2string(this_player()->QuerySkillAbility(arm[i])) + ".\n");
  }   
  if ((wert = this_player()->QueryProp(P_GUILD_RATING)) < 1251) 
    wert = 1251;
  s = int2string(wert);
  write(GUILD_NPC_NAME + " sagt: Insgesamt betrachtet bist Du " + s + ".\n"); 
  say(sprintf(GUILD_NPC_NAME + " klaert %s ueber %s Fertigkeiten auf.\n", 
      capitalize(getuid(this_player())), 
      this_player()->QueryPossPronoun(FEMALE, WEN, PLURAL)));
  return 1;
}


///////////////////////////////////////////////////////////////////////////
// Skills
///////////////////////////////////////////////////////////////////////////

mapping Speerkampf(object player, string skill, mapping sinfo)
{ 
  int abil, ud, val, hp_bonus;
  int bonus, eff_bonus, spear_bonus, ascent;
  int sturz_active, adj, skp;
  mixed *duell;
  float duel_mult;
  object duel_target;

  ud = sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  if (abil > MAX_ABILITY) abil = MAX_ABILITY;
  val = (3 * player->QueryAttribute(A_DEX) + player->QueryAttribute(A_STR) + 
        player->QueryProp(P_GUILD_LEVEL) ) * abil / MAX_ABILITY;
  bonus = random(2 * val / 3) + val / 3;
  bonus = (bonus > MAX_SPEAR && interactive(player) ? MAX_SPEAR : bonus);
  pDebug(player, sprintf("Speerbonus = %d\n", bonus));
  eff_bonus = bonus;

  // wenn der strahlenkranz P_BLIND gesetzt hat besteht eine guild_level bezogene chance gegner zu blenden
  if(objectp(present(STRAHLENKRANZ, player)) && present(STRAHLENKRANZ, player)->QueryProp(P_BLIND) &&
     !random(18-player->QueryProp(P_GUILD_LEVEL))) {
    sinfo[SI_ENEMY]->SetProp(P_BLIND, 2);
    tell_room(environment(sinfo[SI_ENEMY]), sinfo[SI_ENEMY]->name() + " wird durch den grellen Strahlenkranz von " +
      player->name() + " geblendet!\n", ({sinfo[SI_ENEMY]}));
  }

  sturz_active = intp(player->QueryProp(P_AMAZONEN_STURZFLUG)) &&
                 player->QueryProp(P_AMAZONEN_STURZFLUG) >= time();

  // Reduce or invert the bonus based on Flughöhe.
  ascent = player->QueryProp(P_AMAZONEN_ASCENT);
  if (ascent > 0 && ascent <= 10)
  {
    if (sturz_active) {
      skp = AMAZONEN_TALENTMASTER->QuerySpentPoints(player, "sturzflug");
      ascent += skp;
      if(ascent < 0) ascent = 0;
      adj = (bonus * ascent) / 10;
      eff_bonus += adj;
    }
    else {
      skp = AMAZONEN_TALENTMASTER->QuerySpentPoints(player, "himmelsritt");
      ascent -= skp;
      if(ascent < 0) ascent = 0;
      adj = (bonus * ascent) / 10;
      eff_bonus -= adj;
    }
  }
  if (eff_bonus < 0) eff_bonus = 0;

  // Duell: Bonus gegen ein Ziel, Malus gegen alle anderen.
  if (pointerp(duell = player->QueryProp(P_AMAZONEN_DUELL)) && sizeof(duell) >= 3)
  {
    skp = AMAZONEN_TALENTMASTER->QuerySpentPoints(player, "duell");
    if (duell[0] <= time() || !objectp(duel_target = duell[1]))
    {
      player->SetProp(P_AMAZONEN_DUELL, 0);
    }
    else
    {
      duel_mult = duell[2];
      if (duel_mult < 0.0) duel_mult = 0.0;
      if (duel_mult > 0.5) duel_mult = 0.5;

      if(skp > 0) duel_mult += skp * 0.1;

      if (sinfo[SI_ENEMY] == duel_target)
        eff_bonus += (int)(eff_bonus * duel_mult);
      else {
        if(skp > 1) duel_mult -= 0.2; // weniger schadensmalus gegen andere
        eff_bonus -= (int)(eff_bonus * duel_mult);
      }

      if (eff_bonus < 0) eff_bonus = 0;
      if(skp > 2 && sinfo[SI_ENEMY] == duel_target && !random(25-player->QueryProp(P_GUILD_LEVEL))) {
         // chance auf kritischen treffer bei duell         
         eff_bonus += random(player->QueryProp(P_GUILD_LEVEL) * 20);
         tell_object(player, "Im Duell gelingt Dir ein kritischer Treffer!\n");
      }
    }
  }

  pDebug(player, sprintf("ohne speerbonus = %d\n", sinfo[SI_SKILLDAMAGE]));
  pDebug(player, sprintf("eff Speerbonus = %d (mit SA_DAMAGE: %d)\n", eff_bonus, (int) (eff_bonus * player->QuerySkillAttribute(SA_DAMAGE) / 100.0)));
  sinfo[SI_SKILLDAMAGE] += (int) (eff_bonus * player->QuerySkillAttribute(SA_DAMAGE) / 100.0);
  pDebug(player, sprintf("mit Speerbonus = %d\n", sinfo[SI_SKILLDAMAGE]));

  // Sonnenspeer Heilung basierend auf dem Speerbonus.
  spear_bonus = player->QueryProp(P_AMAZONEN_SONNENSPEER);
  if (intp(spear_bonus))
  {
    if (spear_bonus < time())
      player->SetProp(P_AMAZONEN_SONNENSPEER, 0);
    else
    {
      hp_bonus = eff_bonus / 6 + 1;
      skp = AMAZONEN_TALENTMASTER->QuerySpentPoints(player, "sonnenspeer");
      if(skp > 2) hp_bonus += skp * 5;
      if(skp > 1) {
         sinfo[SI_SKILLDAMAGE] += random(player->QueryProp(P_GUILD_LEVEL) * 10);
      }
      player->AddHp(hp_bonus);
      if(!pointerp(sinfo[SI_SKILLDAMAGE_TYPE])) sinfo[SI_SKILLDAMAGE_TYPE] = ({sinfo[SI_SKILLDAMAGE_TYPE]});
      sinfo[SI_SKILLDAMAGE_TYPE] += ({DT_LIGHT});
    }
  }

  // Speertanz-Bonus erhoeht den Speerkampf-Schaden zusaetzlich prozentual.
  spear_bonus = player->QueryProp(P_AMAZONEN_SPEAR_BONUS);
  if (intp(spear_bonus) && spear_bonus > 0)
  {
    sinfo[SI_SKILLDAMAGE] += eff_bonus *
      player->QuerySkillAttribute(SA_DAMAGE) *
      spear_bonus / 10000;
  }
  
  if( player->QueryProp(P_FROG) ||
      player->QueryProp(P_WEAPON)->QueryProp(P_WC) < abil / 50 ) return sinfo;
  // Nichts lernen als Frosch oder mit einem schlechten Speer.
  if( (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) * 400 > abil || !random(10) ) && ++ud > abil / 100 && abil < MAX_ABILITY) 
  {
    ud = 0;
    abil += player->QueryAttribute(A_DEX) / 3;
    if (abil >= MAX_ABILITY)
      player->Message(GUILD_NPC_NAME + " teilt Dir mit: Du kannst den "
          "Speerkampf nun goettlich!!!\n", MSGFLAG_TELL);
  }
  if (abil > MAX_ABILITY) 
    abil = MAX_ABILITY;
  player->ModifySkill( FIGHT(WT_SPEAR), ([ SI_USR: ud, SI_SKILLABILITY: abil ]), 150, GUILDNAME);
  return sinfo;
}


/*
//
// Funktion fuer den Zaubernskill
//
*/
int Zaubern(object user, string sname, mapping sinfo)
{
  int abil, cur_alk, max_alk, value, bonus;
  int learn_abil;
  if(!mappingp(sinfo)) return 0; 
  cur_alk=user->QueryProp(P_ALCOHOL);
  max_alk=user->QueryProp(P_MAX_ALCOHOL);
  value=user->QueryAttribute(A_INT);
  abil=sinfo[SI_SKILLABILITY] + value/3;
  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  if(abil<0) abil=0;
  learn_abil=((MAX_ABILITY - sinfo[SI_SKILLABILITY]) + (value / 5))/2;
  if(learn_abil < 100)
    learn_abil*=2;
  if((random(MAX_ABILITY) <= learn_abil) || (sinfo[SI_SKILLABILITY]>9950 && !random(30))) {
    user->ModifySkill(SK_CASTING, abil, 150, "amazonen");
  }
  else if( !random(MAX_ABILITY * (MAX_ABILITY - abil + 1) / value) ) {
    user->ModifySkill(SK_CASTING, ++sinfo[SI_SKILLABILITY], 150, "amazonen");
  }

  if (abil < MAX_ABILITY && 
      user->QuerySkill(SK_CASTING)[SI_SKILLABILITY] == MAX_ABILITY)
    user->Message("Hyppolite teilt Dir mit: Du kannst Zaubern nun absolut perfekt!\n",
        MSGFLAG_TELL);

  bonus = random(abil);
  pDebug(user, sprintf("Zauberbonus = %d\n", bonus));
  return random(abil);
}



mapping Zweihandkampf(object player, string skill, mapping sinfo)
{ 
  int abil, ud, val, hp_bonus;
  int bonus;

  ud = sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  if (abil > MAX_ABILITY) abil = MAX_ABILITY;
  val = (3 * player->QueryAttribute(A_DEX) + player->QueryAttribute(A_STR) + 
        player->QueryProp(P_GUILD_LEVEL) ) * abil / MAX_ABILITY;
  bonus = random(2 * val / 3) + val / 3;
  bonus = (bonus > MAX_SPEAR && interactive(player) ? MAX_SPEAR : bonus);
  pDebug(player, sprintf("Zweihandbonus = %d\n", bonus));
  sinfo[SI_SKILLDAMAGE] += bonus * player->QuerySkillAttribute(SA_DAMAGE) / 100;
  if( player->QueryProp(P_FROG) ||
      player->QueryProp(P_WEAPON)->QueryProp(P_WC) < abil / 50 ) return sinfo;
  // Nichts lernen als Frosch oder mit einem schlechten Speer.
  if( (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) * 400 > abil || !random(10) )
       && ++ud > abil / 50 && abil < MAX_ABILITY) 
  {
    ud = 0;
    abil += player->QueryAttribute(A_DEX) / 3;
    if (abil >= MAX_ABILITY)
      player->Message(GUILD_NPC_NAME + " teilt Dir mit: Du kannst den "
          "Zweihandkampf nun goettlich!!!\n", MSGFLAG_TELL);
  }
  if (abil > MAX_ABILITY) 
    abil = MAX_ABILITY;
  player->ModifySkill( SK_TWOHANDED, ([ SI_USR: ud, SI_SKILLABILITY: abil ]),
                       150, GUILDNAME);
  return sinfo;
}


mapping Ausweichen(object player, string skill, mapping sinfo)
{
  object ob;
  int dam, dam2, load, usage, ability;
  int ascent, skp;

  ability = sinfo[SI_SKILLABILITY];

  if (!sizeof(filter_array(sinfo[SI_SKILLDAMAGE_TYPE], PHYSICAL_DAMAGE_TYPES)))
    return sinfo;
  dam = sinfo[SI_SKILLDAMAGE];
  if (dam < 20)
    return sinfo;
  if (!objectp(ob = player->QueryProp(P_GUILD_ITEM)))
    return sinfo;
  dam2 = dam - (player->QueryAttribute(A_DEX) + player->QueryProp(P_GUILD_LEVEL) +
    dam * sinfo[SI_SKILLABILITY] / (3 * MAX_ABILITY)) / (1 + load);

  if (dam2 < 0) dam2 = 0;
  ascent = player->QueryProp(P_AMAZONEN_ASCENT);
  if (ascent >= 0 && ascent <= 10) {
    skp = AMAZONEN_TALENTMASTER->QuerySpentPoints(player, "himmelsritt");
    dam2 = dam2 * (15 - ascent - skp) / 15;
  }

  pDebug(player, sprintf("vorher:%d, nacher: %d\n", dam, dam2));
  sinfo[SI_SKILLDAMAGE] = dam2;
  player->AddSp(-(dam - dam2) / (20 + random(10 * player->QueryProp(P_GUILD_LEVEL))));
  if (dam < 20)
    tell_object(player, "Du weichst gekonnt aus.\n");
  else
    tell_object(player, "Du weichst ein wenig aus.\n");

  
   //Das Lernen:
  //kein lernen wenn der Gegner zu schwach ist, der auszuweichende schaden zu
  //gering und natuerlich nur sehr selten, da dieser Skill bei JEDEM Defend
  //aufgerufen wird!
  usage=sinfo[SI_USR] + 1;
  if( (!random(5))                                                      &&
      (ability < MAX_ABILITY)                                           &&
      (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > ability/333)               &&
      (usage > ability/50)  ) {
    usage=0;
    ability+=1+random(player->QuerProp(P_GUILD_LEVEL)+player->QueryAttribute(A_DEX)/2); //1-30
    if (ability >= MAX_ABILITY) { 
      tell_object(player, BS("Du beherrschst das Ausweichen nun absolut perfekt!"));
      ability=MAX_ABILITY;
    } 
  }
  player->ModifySkill( SK_MAGIC_DEFENSE, ([ SI_USR: usage, SI_SKILLABILITY: ability ]), sinfo[SI_DIFFICULTY],"amazonen");

  return sinfo;
}

mapping Schildkampf(object player, string skill, mapping sinfo)
{
  object ob, shield;
  int dam, dam2, ac, usage, ability, skp;

  ability = sinfo[SI_SKILLABILITY];

  if(sizeof(player->QueryArmours(AT_SHIELD))==0)
    return sinfo;
  shield = player->QueryArmours(AT_SHIELD)[0];
  if(!objectp(shield))
    return sinfo;

  dam = sinfo[SI_SKILLDAMAGE];
  ac = shield->QueryProp(P_AC);
  dam2 = dam - (ac + player->QueryProp(P_GUILD_LEVEL) + dam * sinfo[SI_SKILLABILITY] / (3 * MAX_ABILITY)) / 2;

  pDebug(player, sprintf("schildkampf :: vorher:%d, nacher: %d\n", dam, dam2));

  // Special critical defense based on skill and random factor
  if(sinfo[SI_SKILLABILITY]>(5000+random(5000)) && !random(20)) {
    tell_object(player, BS("Du reisst deinen Schild hoch und blockst den Angriff komplett!"));
    dam2=0;
  } else if(sinfo[SI_SKILLABILITY]>8000 && !random(12) && sinfo[SI_ENEMY]->QueryProp(P_DISABLE_ATTACK)==0) {
    tell_object(player, BS("Du rammst deinen Schild gegen "+sinfo[SI_ENEMY]->name()+"!"));
    sinfo[SI_ENEMY]->SetProp(P_DISABLE_ATTACK, 1);
  }

  if(player->QueryProp(P_AMAZONEN_SCHILDWALL)) {
    dam2 = dam2 - random(player->QueryProp(P_AMAZONEN_SCHILDWALL));
    tell_object(player, BS("Du blockst den Angriff mit deinem Schild!"));
    shield->TakeFlaw();
  }

  sinfo[SI_SKILLDAMAGE] = dam2;

  //Das Lernen:
  //kein lernen wenn der Gegner zu schwach ist, der auszuweichende schaden zu
  //gering und natuerlich nur sehr selten, da dieser Skill bei JEDEM Defend
  //aufgerufen wird!
  usage=sinfo[SI_USR] + 1;
  if( (!random(5))                                                      &&
      (ability < MAX_ABILITY)                                           &&
      (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > ability/333)               &&
      (sinfo[SI_SKILLDAMAGE] >= ability/500)                            &&
      (usage > ability/50)  ) {
    usage=0;
    ability+=1+random(player->QuerProp(P_GUILD_LEVEL)+player->QueryAttribute(A_DEX)/2); //1-30
    if (ability >= MAX_ABILITY) { 
      tell_object(player, BS("Du beherrschst den Schildkampf nun absolut perfekt!"));
      ability=MAX_ABILITY;
    }
  }

  player->ModifySkill( SK_MAGIC_DEFENSE, ([ SI_USR: usage, SI_SKILLABILITY: ability ]), sinfo[SI_DIFFICULTY],"amazonen"); 

  return sinfo;
}


///////////////////////////////////////////////////////////////////////////
// Aufstiegs-testfunktionen
///////////////////////////////////////////////////////////////////////////

string *sagen=({GUILD_NPC_NAME+" sagt:", GUILD_NPC_NAME+" teilt Dir mit:", ""});

varargs string NeedMoreXP(object pl, int xp, int tell)
{
  string str, ret_string;
  int percent, x;

  ret_string =" Du musst noch mehr Erfahrung sammeln!\n";
  x = call_other(AMASTER, "GetXpDifference", pl);
  percent = 100 * x / xp;
  switch (percent)
  {
    case  0..10:  str = "nur mehr ganz wenige";         break;
    case 11..20:  str = "weniger als ein Viertel der";  break;
    case 21..30:  str = "etwa ein Viertel der";         break;
    case 31..40:  str = "weniger als die Haelfte der";  break;
    case 41..50:  str = "etwa die Haelfte der";         break;
    case 51..60:  str = "mehr als die Haelfte der";     break;
    case 61..70:  str = "weniger als drei Viertel der"; break;
    case 71..80:  str = "etwa drei Viertel der";        break;
    case 81..90:  str = "mehr als drei Viertel der";    break;
    case 91..99:  str = "beinahe alle";                 break;
    default:      str = "SEHR viele";                   
                  call_other(AMASTER, "SetXp", pl, pl->QueryProp(P_XP) +
                      pl->QueryProp(P_TOTAL_LOST_XP) + xp);
  }
  ret_string += "Dir fehlen " + str + " Erfahrungspunkte.\n";
  return ret_string;
}


string ghost_check(object pl)
{
  if (pl->QueryProp(P_FROG)) 
    return GUILD_NPC_NAME + " sagt: Igitt! Ein ekliger Frosch! Verschwinde!\n";
  if (pl->QueryProp(P_GHOST))
       return GUILD_NPC_NAME + " schreit wuetend: Hinfort mit Dir Du boeser Geist!\n";
  return 0;
}


