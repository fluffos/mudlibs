"speerstoss":         0;0;30;40;50;55;60;65;70;70;75;80;85;90;100,
"speerwurf":          0;0;0;0;30;40;50;60;70;75;85;85;90;95;100,
"weitblick":          0;0;0;0;30;40;50;60;70;75;85;85;90;95;100,
