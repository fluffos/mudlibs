public void unlearn_order_spells(object who)
{
  mapping skills;
  string *remove_skills;
  int i;

  if (!objectp(who))
    return;

  skills = who->QueryProp(P_NEWSKILLS);
  if (!mappingp(skills) || !sizeof(skills))
    return;

  remove_skills = ({
      SK_CASTING,
      SK_MAGIC_DEFENSE,
      SK_TWOHANDED,
  });

  for (i = sizeof(remove_skills) - 1; i >= 0; i--)
  {
    skills = who->QueryProp(P_NEWSKILLS);
    if (member(skills, remove_skills[i]))
      who->SetProp(P_NEWSKILLS, m_delete(skills, remove_skills[i]));
  }

  
}

int cmd_austreten(string str)
{
  object ob;
  if (!present(GUILD_NPC_ID))
  {
    write(GUILD_NPC_NAME + " ist nicht da.... so ein Pech!\n");
    return 1;
  }
  if (!IsGuildMember(this_player()))
  {
     write(GUILD_NPC_NAME + " sagt: Aber Du bist doch gar kein Mitglied!\n");
     return 1;
  }
  this_player()->SetProp(P_GUILD_LEVEL, 0);
  WLOG("/log/gilden/amazonen", "tritt aus der Gilde aus");
  tell_room(this_object(), GUILD_NPC_NAME + " sagt: Schade, wieder eine Amazone "
                           "weniger.. :(\n");
  if (ob = present(GUILD_ITEM, this_player()))
    ob->remove();
  call_other(AMASTER, "DeleteMember", this_player());
  call_other(AMASTER, "DeleteTopEntry", getuid(this_player()));
  WLOG(LOG + getuid(this_player())+".log", "tritt aus der Amazonengilde aus");
  Channel(capitalize(getuid(this_player()))+" ist gerade aus der "
          "Amazonengilde ausgetreten.");
  unlearn_order_spells(TP);
  return ::austreten();
}


public void learnOrderPassives(object pl)
{
  string orden;

  orden = AMASTER->QueryMemberEntry(getuid(pl))[15];
  switch(orden)
  {
    case AMAZONEN_ORDEN_ORAKEL:
      if (!pl->QuerySkillAbility(SK_CASTING))
        pl->ModifySkill(SK_CASTING, ([ SI_SKILLFUNC: "Zaubern", SI_SKILLABILITY: InitialAbil(pl,SK_PRECOGNITION)]), 150, GUILDNAME);
      break;
    case AMAZONEN_ORDEN_SCHILDMAID:
      if (!pl->QuerySkillAbility(SK_MAGIC_DEFENSE))
        pl->ModifySkill(SK_MAGIC_DEFENSE, ([ SI_SKILLFUNC: "Schildkampf", SI_SKILLABILITY: InitialAbil(pl,SK_MAGIC_DEFENSE)]), 150, GUILDNAME);
      break;
    case AMAZONEN_ORDEN_VALKYRE:
      if (!pl->QuerySkillAbility(SK_MAGIC_DEFENSE))
        pl->ModifySkill(SK_MAGIC_DEFENSE, ([ SI_SKILLFUNC: "Ausweichen", SI_SKILLABILITY: InitialAbil(pl,SK_MAGIC_DEFENSE)]), 150, GUILDNAME);
      break;
    case AMAZONEN_ORDEN_SPEERSEELE:
      if (!pl->QuerySkillAbility(SK_TWOHANDED))
        pl->ModifySkill(SK_TWOHANDED, ([ SI_SKILLFUNC: "Zweihandkampf", SI_SKILLABILITY: InitialAbil(pl,SK_TWOHANDED)]), 150, GUILDNAME);
      break;
  }
  return;
}

int cmd_beitreten(string str)
{
  int b;
  object ob;
  string orden;

  if (!present(GUILD_NPC_ID))
  {
    write(GUILD_NPC_NAME + " ist nicht da.... so ein Pech!\n");
    return 1;
  }

  /*if (!this_player()->QueryProp(P_TESTPLAYER) && !IS_LEARNER(this_player()))
  {
    write(GUILD_NPC_NAME+" sagt bedauernd: Zur Zeit duerfen nur Testspieler "
          "beitreten!\n");
    return 1;
  }*/

  if (IsGuildMember(this_player()))
  {
     write(GUILD_NPC_NAME + " sagt: Aber Du bist doch schon Mitglied!\n");
     return 1;
  }

  if(str == 0 || (CAP(str) != AMAZONEN_ORDEN_ORAKEL && CAP(str) != AMAZONEN_ORDEN_SCHILDMAID &&
     CAP(str) != AMAZONEN_ORDEN_VALKYRE && CAP(str) != AMAZONEN_ORDEN_SPEERSEELE))
  {
    write(GUILD_NPC_NAME + " sagt: Du musst Dich fuer einen Orden "
          "entscheiden: '"+AMAZONEN_ORDEN_ORAKEL+"', '"
          +AMAZONEN_ORDEN_SCHILDMAID+"', '"+AMAZONEN_ORDEN_VALKYRE+"' oder '"
          +AMAZONEN_ORDEN_SPEERSEELE+"'.\n");
    return 1;
  }

  orden = CAP(str);

  if ((b = ::beitreten()) < 0) return 1;
  tell_room(this_object(), SAG(sprintf("Willkommen bei den "
          "Amazonen, Schwester %s! Zuerst solltest Du zu Ulyssa gehen und Dir "
          "eine Amazonenruestung und einen Speer ausfassen. Dann solltest Du "
          "Dich um die Zauber der ersten Stufe kuemmern. Strahlenkranz und "
          "Erkenntnis kannst du als erstes lernen.",
          this_player()->name() )));
  WLOG("/log/gilden/amazonen", "tritt in die Gilde ein");
  if (!(this_player()->QuerySkillAbility(FIGHT(WT_SPEAR))))
    this_player()->ModifySkill(FIGHT(WT_SPEAR),
      QuerySkill(FIGHT(WT_SPEAR))+([ SI_SKILLABILITY: InitialAbil(this_player(),
       "spear")]), 150, GUILDNAME);
  
  call_other(AMASTER, "AddMember", this_player(), orden);
  WLOG(LOG + getuid(this_player()) + ".log", "ist in die Amazonengilde eingetreten");
  this_player()->command_me("-amazonen+");
  this_player()->SetProp(P_TITLE, 0);
  Channel(capitalize(getuid(this_player()))+
    " ist gerade in die Amazonengilde eingetreten.");

  if (!present(GUILD_ITEM, this_player()))
    clone_object(GUILD_ITEM_FILENAME)->move(this_player(),M_NOCHECK);

  learnOrderPassives(TP);
  return b;
}


nosave void Channel(string msg) 
{
 // write("[Info:" + GUILD_NPC_NAME + "] " + msg + "\n"); // TODO Channel reaktivieren
  CHMASTER->join("Info", TO);
  CHMASTER->send("Info", TO, msg, MSG_SAY);
}

nosave string normalize_orden(string str)
{
  if (!stringp(str))
    return 0;
  str = implode(explode(lower_case(str), " "), "");
  switch (str)
  {
    case "orakel": return AMAZONEN_ORDEN_ORAKEL;
    case "schildmaid": return AMAZONEN_ORDEN_SCHILDMAID;
    case "valkyre": return AMAZONEN_ORDEN_VALKYRE;
    case "speertaenzer":
    case "speertaenzerin":
    case "speertaenzerinnen":
    case "speertaenzerinnenweg":
    case "speerseele":
      return AMAZONEN_ORDEN_SPEERSEELE;
  }
  return 0;
}

nosave string *order_spells(string orden)
{
  switch (orden)
  {
    case AMAZONEN_ORDEN_SPEERSEELE:
      return ({"niederwerfen","verwunden","sehnenstich","speertanz","durchbohren"});
    case AMAZONEN_ORDEN_SCHILDMAID:
      return ({"schildschlag","schildwall","abwehrhaltung","provozieren","standhaftigkeit"});
    case AMAZONEN_ORDEN_VALKYRE:
      return ({"himmelsritt","fluegelschlag","sturzflug","sturmwirbel","einschlag"});
    case AMAZONEN_ORDEN_ORAKEL:
      return ({"sonnenspeer","kampfgebruell","sturmschild","sonnenstrahl","heldenaura"});
  }
  return ({});
}

nosave string *all_order_spells()
{
  return order_spells(AMAZONEN_ORDEN_SPEERSEELE)
       + order_spells(AMAZONEN_ORDEN_SCHILDMAID)
       + order_spells(AMAZONEN_ORDEN_VALKYRE)
       + order_spells(AMAZONEN_ORDEN_ORAKEL);
}

nosave void remove_skills_from_player(object who, string *names)
{
  mapping skills;
  int i;

  if (!objectp(who) || !pointerp(names) || !sizeof(names))
    return;

  skills = who->QueryProp(P_NEWSKILLS);
  if (!mappingp(skills) || !sizeof(skills))
    return;

  for (i = sizeof(names) - 1; i >= 0; i--)
    if (member(skills, names[i]))
      skills = m_delete(skills, names[i]);

  who->SetProp(P_NEWSKILLS, skills);
}

nosave int can_learn_now(object who, string spell)
{
  mapping ski, restr;
  string res;

  if (!objectp(who) || !stringp(spell) || !strlen(spell))
    return 0;
  if (!(ski = QuerySpell(spell)))
    return 0;
  if (mappingp(restr = ski[SI_SKILLRESTR_LEARN]) &&
      (res = check_restrictions(who, restr)))
    return 0;
  return 1;
}

nosave void reset_order_kit(object who, string new_orden)
{
  string *to_remove, *to_add;
  int i;
  object item;

  if (!objectp(who) || !stringp(new_orden))
    return;

  to_remove = all_order_spells() + ({SK_CASTING, SK_MAGIC_DEFENSE, SK_TWOHANDED});
  remove_skills_from_player(who, to_remove);

  switch (new_orden)
  {
    case AMAZONEN_ORDEN_ORAKEL:
      who->ModifySkill(SK_CASTING,
        ([ SI_SKILLFUNC: "Zaubern", SI_SKILLABILITY: 0 ]), 150, GUILDNAME);
      break;
    case AMAZONEN_ORDEN_SCHILDMAID:
      who->ModifySkill(SK_MAGIC_DEFENSE,
        ([ SI_SKILLFUNC: "Schildkampf", SI_SKILLABILITY: 0 ]), 150, GUILDNAME);
      break;
    case AMAZONEN_ORDEN_VALKYRE:
      who->ModifySkill(SK_MAGIC_DEFENSE,
        ([ SI_SKILLFUNC: "Ausweichen", SI_SKILLABILITY: 0 ]), 150, GUILDNAME);
      break;
    case AMAZONEN_ORDEN_SPEERSEELE:
      who->ModifySkill(SK_TWOHANDED,
        ([ SI_SKILLFUNC: "Zweihandkampf", SI_SKILLABILITY: 0 ]), 150, GUILDNAME);
      break;
  }

  to_add = order_spells(new_orden);
  for (i = sizeof(to_add) - 1; i >= 0; i--)
  {
    if (!can_learn_now(who, to_add[i]))
      continue;
    who->ModifySkill(to_add[i], ([ SI_SKILLABILITY: 0 ]), 0, GUILDNAME);
  }

  if (objectp(item = present(GUILD_ITEM, who)))
    item->SetProp("orden", new_orden);
}

varargs mixed check_advance(object pl) {
  int ggrad, glvl;
  mapping cond;
  mixed res;
  glvl=pl->QueryProp(P_GUILD_LEVEL);
  if(glvl > 14) return "Du kannst nicht mehr weiter aufsteigen!";
  cond=QueryProp(P_GUILD_LEVELS);
  res=call_other(RES_CHECKER, "check_new_restrictions", pl, cond[glvl+1]);
  return res;
}


int advance(string str)
{
  mixed b;

  notify_fail ("Was willst Du erhoehen?\n"+ "Stufe, Gildenstufe, Kraft, "
               "Int(elligenz), Aus(dauer), Gesch(icklichkeit)?\n");
  if (!str) return 0;
  if (!present(GUILD_NPC_ID))
  {
    write("Hier ist leider niemand, der Dich erhoehen koennte!\n");
    return 1;
  }
  if (str == "stufe" || str2attr(str) )
    return ::advance(str);
  if (str == "gildenstufe" || str=="gilde")
  {
    if (!IsGuildMember(this_player()))
    {
      tell_room(this_object(),GUILD_NPC_NAME + " sagt: Aber Du bist doch gar "
          "kein Mitglied, " + this_player()->name() + "!\n");
      return 1;
    }
    if (this_player()->QueryProp(P_GUILD_LEVEL) >= 15)
    {
      tell_room(this_object(), GUILD_NPC_NAME+" sagt: Du kannst nicht "
          "noch hoeher aufsteigen, Schwester "+this_player()->name()+"!\n");
      return 1;
    }
    b = check_advance(TP);
    if (!b) {
      b = gilden_ob::try_advance();
      if(b) {
        write("Gratulation zu Deiner neuen Stufe!\n");
        WLOG(LOG + getuid(this_player()) + ".log", "hat Stufe "
          + this_player()->QueryProp(P_GUILD_LEVEL) + " erreicht");
        Channel(capitalize(getuid(this_player())) + " hat in der Amazonengilde "
          "Stufe " + this_player()->QueryProp(P_GUILD_LEVEL) + " erreicht.");
        call_other(AMASTER, "SetXp", TP, TP->QueryProp(P_XP) + TP->QueryProp(P_TOTAL_LOST_XP) + XP_PER_LEVEL[TP->QueryProp(P_GUILD_LEVEL) - 1]);
        return 1;
      } else {
        write("Aufstiegsfehler!\n");
        return -1;
      }
    } else {
      write(break_string(b, 78, "Hippolyte sagt: "));
      return -1;
    }
    return 1;
  }
  return 0;
}


///////////////////////////////////////////////////////////////////////////
// Spells lernen
///////////////////////////////////////////////////////////////////////////

int InitialAbil(object player, string what)
{
  int bonus, abil;

  if (what == "ausweichen" && player->QueryProp(P_RACE) == "Hobbit")
    bonus = 10 + random(100);
  else if (what == "spear" && player->QueryProp(P_RACE) == "Elf")
    bonus = 30 + random(80);
  else
    bonus = 0;
  abil = 3 * player->QueryAttribute(A_DEX) + bonus;
  return (abil > 0 ? abil : 1);
}


nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if (value > 4000) value = 4000;
  if (value < 2500) value = 2500;
  return value;
}


int cmd_learnspell(string str)
{
  mapping ski, restr;
  string required_order, player_order;

  if( !present(GUILD_NPC_ID) )
  {
    write("Hier ist leider niemand, der Dir etwas beibringen koennte!\n");
    return 1;
  }
  if(!IsGuildMember(this_player()))
  {
    write( GUILD_NPC_NAME+" sagt: Du bist kein Mitglied dieser Gilde!\n");
    return 1;
  }
  notify_fail(GUILD_NPC_NAME+" sagt: Was moechtest Du hier lernen?\n");
  if(!str)
  {
    write(
      GUILD_NPC_NAME+" sagt: Du kannst hier folgende Faehigkeiten lernen:\n"
