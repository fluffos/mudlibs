  // Falls ein Spell einem Orden zugeordnet ist, darf ihn nur dieser Orden lernen.
  ski = QuerySpell(lower_case(str));
  if (mappingp(ski) &&
      mappingp(restr = ski[SI_SKILLRESTR_LEARN]) &&
      stringp(required_order = restr["order"]) &&
