nosave void toplist_update()
{
  write("Topliste ist in 10 Sekunden upgedatet.\n");
  call_other(AMASTER, "UpdateMemberLevels");
  call_out("toplist2", 2);
  call_out("toplist3", 4);
  call_out("toplist4", 6);
}


nosave void toplist2()
{
  call_other(AMASTER, "UpdateTopList");
}


nosave void toplist3()
{
  call_other(AMASTER, "MakeReadList");
}


nosave void toplist4()
{
  call_other(AMASTER, "SetNumberOne");
}


int cmd_magfunc(mixed str)
{
  object ob;
  int err;
  string name;

  if (!IS_ARCH(TP) && member(GUILD_WIZARDS, getuid(TP)) != -1) 
    return 0;
  if (!str) str = "hilfe";
  if (str == "hilfe") 
  {
    write("Folgende Befehle sind moeglich:\n"
        "agilde hilfe    : Dieses hier\n"
        "agilde backup   : Backup des Memberfiles\n"
        "agilde restore  : Zurueckspielen des Backups\n"
        "agilde topliste : Updaten der Topliste\n");
    return 1;
  }
  if (str == "backup") 
  {
    call_other(AMASTER, "DoBackup");
    tell_object(TP, "Kopiere members/members.o nach "
              "backup/members_backup.o\n");
    return 1;
  }
  if (str == "restore") 
  {
    if(call_other(AMASTER, "DoRestore") == -2)
    {
      tell_object(TP, "Fehler! Members.o konnte nicht restored "
          "werden!\n");
      return 1;
    } 
    tell_object(TP, "Kopiere backup/members_backup.o nach "
                  "members/members.o\n");
    return 1;
  }
  if (str == "topliste" || str == "toplist") 
  {
    toplist_update();
    tell_object(TP, "Memberliste ist nun up-to-date.\n");
    return 1;
  }

  notify_fail("Befehl nicht moeglich!\n");
  return 0;
}

string read_liste()
{
  string content;
  content = read_file(REALTOPLIST);
  TP->More(content);
  return "";
}


