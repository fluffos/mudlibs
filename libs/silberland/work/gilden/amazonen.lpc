]);


string lern_prozent(int zahl)
{
  switch(zahl)
  {
    case 0..30:      return "einmal";
    case 31..100:    return "ein paar mal";
    case 101..500:   return "einige male";
    case 501..1000:  return "oft";
    case 1001..2000: return "viel";
    case 2001..4000: return "sehr fleissig";
    case 4001..6000: return "extrem fleissig";
    default: return "beinahe unendlich oft";
  }
}


string abilcheck(object pl, int tell)
{
  int i;    // schleifenvariable
  int lvl;  // gildenstufe
  int a;    // so hoch muss der skill zum erhoehen sein
  int b;    // so hoch ist der skill jetzt
  string str;
  string *skills;
  string order;
  
  lvl = pl->QueryProp(P_GUILD_LEVEL);
  str = "";
  skills = m_indices(abils);
  order = AMASTER->QueryMemberEntry(getuid(pl))[POS_ORDER];
  for (i = sizeof(skills) - 1; i >= 0; i--)
  {
     if ((a = abils[skills[i],lvl]) &&
         (b = a * MAX_ABILITY / 100 - pl->QuerySkillAbility(skills[i])) > 0)
       str += "Du musst '" + skillname( skills[i], order ) +
            "' noch " + lern_prozent(b) + " ueben.\n";
  }
  return str;
}


varargs string Beitrittstest( object pl, int tell)
{
  object ob;
  if (!AMASTER->CheckTask(pl, 0))
  {
    if (!present("AMAZONENBEITRITTSOBJEKT", this_player()))
      clone_object(QUEST0)->move(TP, M_NOCHECK);
    tell_room(this_object(), SAG(sprintf("Du willst den Amazonen beitreten, %s? "
            "Ich bin im Moment einfach viel zu schlecht gelaunt um jemand in "
            "unseren Kreis aufzunehmen.", this_player()->name() )));
    return "";
  }
  return 0;
}


varargs string Test( object pl, int tell)
{
  string str;
  int glevel;

  if (stringp(str = ghost_check(pl)) )
    return str;
  str = "";
  str += abilcheck(pl, tell);
  glevel = pl->QueryProp(P_GUILD_LEVEL);
  if (!call_other(AMASTER, "CheckXp", pl, pl->QueryProp(P_XP) + pl->QueryProp(P_TOTAL_LOST_XP)) )
    str += NeedMoreXP(pl, XP_PER_LEVEL[glevel], tell);
  if (str != "") return str;
  return 0;
}


varargs void learn_amazonen_skills(int spear)
{
  object wer;

  wer = previous_object();
  if (!wer || interactive(wer) || query_once_interactive(wer) ) return;
  if (!spear) spear = 1000 * wer->QueryProp(P_GUILD_LEVEL);
  wer->ModifySkill(FIGHT(WT_SPEAR),
    QuerySkill(FIGHT(WT_SPEAR)) + ([ SI_SKILLABILITY: spear]), 150, GUILDNAME);
  switch( wer->QueryProp(P_GUILD_LEVEL) )
  {
    case 10: wer->ModifySkill( "speerzauber", QuerySkill("speerzauber") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
    case 9: wer->ModifySkill( "spiegelbild", QuerySkill("spiegelbild") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
    case 8: wer->ModifySkill( "wirbelwind", QuerySkill("wirbelwind") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
    case 7: wer->ModifySkill( "aufspiessen", QuerySkill("aufspiessen") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
    case 6: wer->ModifySkill( "duell", QuerySkill("duell") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
            wer->ModifySkill( "selbstbeherrschung", QuerySkill("seblstbeherrschung") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
    case 5: wer->ModifySkill( "schnelligkeit", QuerySkill("schnelligkeit") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
            wer->ModifySkill( "blitzschlag", QuerySkill("blitzschlag") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
    case 4: wer->ModifySkill( "knietritt", QuerySkill("knietritt") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
    case 3: wer->ModifySkill( "speerwurf", QuerySkill("speerwurf") +
            ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
    case 2: wer->ModifySkill( "speerstoss", QuerySkill("speerstoss") +
            ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
            wer->ModifySkill( "betoeren", QuerySkill("betoeren") +
             ([SI_SKILLABILITY: 10000, SI_PREPARE_TIME: 0, SI_SPELLCOST: 0]) );
  }
}

