#include "../arkanisten.h"

void register_ability(string path);
void register_abilities();

nosave mapping abilities;

public void create() {
   register_abilities();
}

public void register_abilities() {
    abilities = ([ ]);

    // Gadgeteer
    register_ability("/gilden/arkanisten/abilities/gadgeteer/light_coil");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/smokebomb");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/shrapnel_grenade");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/handcranked_crossbow");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/clockwork_snare");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/tesla_baton");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/gyroscopic_stabilizer");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/springloaded_gloves");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/deployable_shield");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/flamethrower");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/electric_gloves");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/inferno_module");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/hidden_dagger");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/assassins_hands");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/doubleslice");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/magnetgrapple");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/titanwrestler");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/choking_hands");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/explosive_bolts");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/gun");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/pistolero_stance");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/clockwork_armour");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/reinforced_braces");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/chain_lightning_projector");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/puls_generator");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/electrified_defenses");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/reactive_defenses");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/gadget_overdrive");
    register_ability("/gilden/arkanisten/abilities/gadgeteer/temporal_disruptor");

    // Alchemist
    register_ability("/gilden/arkanisten/abilities/alchemist/quick_remedy");
    register_ability("/gilden/arkanisten/abilities/alchemist/adrenaline_shot");
    register_ability("/gilden/arkanisten/abilities/alchemist/healing_tonic");
    register_ability("/gilden/arkanisten/abilities/alchemist/mutagenic_elixir");
    register_ability("/gilden/arkanisten/abilities/alchemist/cognitive_mutagen");
    register_ability("/gilden/arkanisten/abilities/alchemist/antidote");
    register_ability("/gilden/arkanisten/abilities/alchemist/draught_of_thought");
    register_ability("/gilden/arkanisten/abilities/alchemist/transmuting_elixir");
    register_ability("/gilden/arkanisten/abilities/alchemist/acid_splash");
}

public object get_ability_by_name(string name) {
    return abilities[name];
}

public bool has_ability_registered(object ob) {
    object *v;
    v = m_values(abilities);
    return member(v, ob) > -1;
}

public void register_ability(string path) {
    object ability_obj;

    if(!objectp(ability_obj = find_object(path))) {
        call_other(path, "???");
        if(!objectp(ability_obj = find_object(path))) {
            raise_error("failed to load ability object: " + path);
            return;
        }
    }

    if(member(inherit_list(ability_obj), "gilden/arkanisten/abilities/ability.lpc") < 0) {
        raise_error("registering non-ability path is not allowed");
        return;
    }
    if(has_ability_registered(ability_obj)) return;

    abilities[ability_obj->skill_name()] = ability_obj;
    return;
}

public int match_group(object ob, string group) {
    return member(ob->QueryProp(P_ABILITY_GROUP), group) > -1;
}

varargs public object* get_all_abilities(string group) {
    if(member(m_values(abilities), 0)) register_abilities();
    if(stringp(group)) {
        return filter_array(m_values(abilities), "match_group", TO, group);
    }
    return m_values(abilities);
}

varargs public object* get_all_learned_by(object player, string group) {
    int i;
    object *list, ab;
    string *indices, index;
    int idx;

    list = ({});
    indices = m_indices(abilities);
    foreach(idx, indices, index, {
        ab = abilities[index];
        if(!objectp(ab)) register_abilities();
        if(ab->has_learned(player) && (!stringp(group) || member(ab->QueryProp(P_ABILITY_GROUP), group) > -1)) 
            list += ({ ab });
    });

    return list;
}

public void reload_all() {
    string *indices, index;
    object ob;
    int idx;

    indices = m_indices(abilities);
    foreach(idx, indices, index, destruct(abilities[index]));
    if(objectp(ob=find_object(EVENT_DISPATCH))) destruct(ob);
    if(objectp(ob=find_object("/gilden/arkanisten/abilities/ability"))) destruct(ob);

    register_abilities();
}