#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, CAP(REACTIVE_DEFENSES));
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Deine Uhrwerkruestung ist mit einem Satz kleiner, federbelasteter Platten "
        "ausgestattet, die bei einem harten Treffer sofort ausfahren koennen. Sie aktivieren "
        "sich reflexartig, um den Aufprall zu absorbieren und die Wucht des Schlages zu verringern.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_PASSIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_STR);
    SetProp(P_ABILITY_CASTVERB, 0);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGET_POWERUP, ABILITY_GROUP_GADGETS}));
    SetProp(P_ABILITY_REQUIRES, ({CLOCKWORK_ARMOUR}));
    SetProp(P_ABILITY_SPELLBREAK, 0);
    SetProp(P_ABILITY_MIN_GUILD_LEVEL, 11);

    modify(CLOCKWORK_ARMOUR, MODIFY_CUSTOM_VALUE);
}

public mapping modify_ability(string sender, int mtype, mapping payload) {
    int sc, abil;
    object user;

    if(sender != CLOCKWORK_ARMOUR) return payload;
    if(mtype != MODIFY_CUSTOM_VALUE) return payload;
    if(!objectp(user=payload[SI_ABILITY_USER])) return payload;

    abil = user->QuerySkillAbility(REACTIVE_DEFENSES);
    sc = use(user, ([SI_SKILLABILITY: abil, SI_ABILITY_SILENT: 1]), 1);
    pDebug(user, sprintf("reactive_defenses :: success=%d\n", sc));
    if(random(100) < sc/2000 + abil/2000) {
        tell_object(user, BS("Deine Uhrwerkruestung federt den Schlag zusaetzlich ab!"));
        tell_room(environment(user), BS("Die Uhrwerkruestung von " + user->Name(WESSEN) + " federt den Schlag ab!"), ({ user }));
        payload[SI_ABILITY_VALUE] = (sc + abil) / 500;
    }
    return payload;
}