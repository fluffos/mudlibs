#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, "Handkurbelarmbrust");
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Die Handkurbelarmbrust ist eine feinmechanische Waffe. Es handlet sich dabei um eine Handarmbrust, die du "
        "bequem mit einer Hand bedienen kannst. Sie laesst sich nach einem Schuss, dank einer Handkurbel und einer kleinen "
        "Trommel mit mehreren Bolzen, rasch wieder aufziehen. Somit kann ein geuebter Schuetze mit ihr rasche Salven abgeben, "
        "wenn er gut genug ist.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_WIELD);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGETS}));
    SetProp(P_ABILITY_COST, 0);
    SetProp(P_ABILITY_REQUIRES, ({}));
    SetProp(P_ABILITY_SPELLBREAK, 0);
}

public mapping prepare_use(object user, mapping sinfo) {
    if(present(CROSSBOW_ID, user)) {
        tell_object(user, BS("Du hast deine Waffe bereits gezogen"));
        return 0;
    }

    if(get_free_hands(user) < 1 || objectp(user->QueryProp(P_WEAPON))) {
        tell_object(user, BS("Du musst eine freie Hand haben, um deine Armbrust zu zuecken!"));
        return 0;
    }

    sinfo[SI_ABILITY_NOLEARN] = 1;

    return ::prepare_use(user, sinfo);
}

public void success(object user, mapping sinfo, int skillcheck) {
    object cb;

    if(objectp(cb=present(CROSSBOW_ID, user))) {
        // dual-use of this ability
        cb->SetProp("damage_benefit", skillcheck/333);
    } else {
        cb = clone_object(OBJ "crossbow");
        if(!cb->move(user)) {
            tell_object(user, BS("Du kannst das gerade nicht tun."));
            destruct(cb);
            return;
        }

        cb->setup(user);
        cb->wield_me();
    }

    return;
}
public int on_use_after_eval(object user, mapping sinfo, int skillcheck) {
    if(!objectp(present(CROSSBOW_ID, user))) return ERFOLG; // always succeed in wielding it
    return ::on_use_after_eval(user, sinfo, skillcheck);
}