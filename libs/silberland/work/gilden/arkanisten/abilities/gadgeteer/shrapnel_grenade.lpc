#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, "Splittergranate");
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Diese Bombe ist mit kleinen Metallteilen gefuellt. Wenn du sie wurfst, explodiert sie kurz darauf "
        "und schleudert die Schrapnelle herum. Sie kann alle deine Gegner treffen.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_THROW);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGETS, ABILITY_GROUP_BOMBS}));
    SetProp(P_ABILITY_COST, ([
        P_SP: 30,
        P_MV: 100,
    ]));
    SetProp(P_ABILITY_REQUIRES, ({SMOKEBOMB}));
}

public mapping prepare_use(object user, mapping sinfo) {
    object *enemies;

    if(get_free_hands(user) < 1) {
        tell_object(user, BS("Du musst eine freie Hand haben, um eine Bombe zu werfen!"));
        return 0;
    }

    enemies = filter_array(all_inventory(ENV(user)), "valid_target");
    enemies -= ({ user });
    if(sizeof(enemies) < 1) {
        tell_object(user, BS("Ohne Gegner macht diese Bombe keinen Sinn."));
        return 0;
    }
    
    tell_object(user, BS("Du zuendest die Lunte einer Splittergranate an und wirfst sie..."));
    tell_room(ENV(user), BS(user->Name(WER)+" zuendet eine kleine Metallkugel an und wirft sie..."), ({user}));

    sinfo[SI_PREPARE_TIME] = 2 + random(4);
    sinfo[SI_SKILLDAMAGE_TYPE] = ({ DT_EXPLOSION, DT_SLASH });
    sinfo[SI_SKILLDAMAGE] = 100;
    sinfo[OFFSET(SI_SKILLDAMAGE)] = 50;
    sinfo[SI_MAX_DAMAGE] = 300;
    sinfo[SI_NOMAGIC] = 100;

    return ::prepare_use(user, sinfo);
}

public void failed(object user, mapping sinfo, int skillcheck) {
    if(skillcheck < -3000 || !random(5)) {
        tell_object(user, BS("Die Bombe explodiert in deiner Hand!"));
        tell_room(ENV(user), BS("Irgendetwas explodiert in "+user->name(WESSEN)+" Hand."));
        user->AddHp(-random(20));
    }

    tell_room(ENV(user), BS("Die Metallkugel explodiert mit einem lauten Knall, aber ohne weiter Schaden anzurichten."), ({user}));
    tell_object(user, BS("Die Splittergranate explodiert mit einem dumpfen Knall in einer Fehlzuendung."));
    
    return ::failed(user, sinfo, skillcheck);
}

public int valid_target(object ob) {
    return living(ob) && !query_once_interactive(ob) && !ob->QueryProp(P_NOATTACK) && !ob->QueryProp(P_FRIEND);
}

public void success(object user, mapping sinfo, int skillcheck) {
    object *enemies, enemy;
    int idx;

    enemies = filter_array(all_inventory(ENV(user)), "valid_target");
    enemies -= ({ user });
    if(sizeof(enemies) < 1) {
        tell_object(user, BS("Deine Splittergranate explodiert, doch ist niemand mehr da, dem sie schaden koennte."));
        tell_room(ENV(user), BS("Mit einem lauten Knall explodiert die Metallkugel und schleudert scharfe Metallteile durch die Gegend. Leider trifft sie niemanden."), ({user}));
        return;
    }
    
    sinfo[SI_SKILLDAMAGE] += skillcheck / 100;

    tell_room(ENV(user), BS("Mit einem lauten Knall explodiert die Metallkugel und schleudert messerscharfe Metallteile herum."));
    foreach(idx, enemies, enemy, {
        if(enemy != user) call_other("/std/spellbook", "TryDefaultAttackSpell", enemy, user, sinfo, ([SP_NAME: "Splittergranate", SP_SHOW_DAMAGE: 1]));
    });

    return;
}
