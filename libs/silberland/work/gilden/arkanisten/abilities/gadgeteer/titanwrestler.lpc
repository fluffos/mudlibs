#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, CAP(TITAN_WRESTLER));
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Der gyroskopische Stabilisator ist ein kunstvolles Monokel mit einer bernsteinfarbenen "
        "Linse, gefasst in graviertem Messing. Versteckte gyroskopische Mechanismen gleichen Bewegungen "
        "aus und projizieren ein zartes Fadenkreuz auf die Sicht, das praezises Zielen ermoeglicht. Das "
        "leichte Gestell, gepolstert mit weichem Leder, verbindet Handwerkskunst und Funktionalitaet fuer "
        "hoechste Genauigkeit im Kampf.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_PASSIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_STR);
    SetProp(P_ABILITY_CASTVERB, 0);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGET_POWERUP, ABILITY_GROUP_GADGETS}));
    SetProp(P_ABILITY_REQUIRES, ({MAGNET_GRAPPLE}));
    SetProp(P_ABILITY_SPELLBREAK, 0);
    SetProp(P_ABILITY_MIN_GUILD_LEVEL, 21);

    modify(MAGNET_GRAPPLE, MODIFY_CUSTOM_VALUE);
}

public mapping modify_ability(string sender, int mtype, mapping payload) {
    int sc;
    object user;

    if(sender != MAGNET_GRAPPLE) return payload;
    if(mtype != MODIFY_CUSTOM_VALUE) return payload;
    if(!objectp(user=payload[SI_ABILIT_USER])) return payload;

    sc = use(user, ([SI_SKILLABILITY: user->QuerySkillAbility(TITAN_WRESTLER), SI_ABILITY_SILENT: 1]), 1);
    if(sc > 0) payload[SI_ABILITY_VALUE] += sc/5000.0;
    pDebug(user, sprintf("titanwrestler :: success=%d\n", sc));
    return payload;
}