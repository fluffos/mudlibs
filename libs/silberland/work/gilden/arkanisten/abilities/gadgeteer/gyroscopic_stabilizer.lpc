#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, "Gyroskopischer Stabilisator");
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Der gyroskopische Stabilisator ist ein kunstvolles Monokel mit einer bernsteinfarbenen "
        "Linse, gefasst in graviertem Messing. Versteckte gyroskopische Mechanismen gleichen Bewegungen "
        "aus und projizieren ein zartes Fadenkreuz auf die Sicht, das praezises Zielen ermoeglicht. Das "
        "leichte Gestell, gepolstert mit weichem Leder, verbindet Handwerkskunst und Funktionalitaet fuer "
        "hoechste Genauigkeit im Kampf.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_PASSIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_INT);
    SetProp(P_ABILITY_CASTVERB, 0);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGETS}));
    SetProp(P_ABILITY_REQUIRES, ({REINFORCED_BRACES}));
    SetProp(P_ABILITY_SPELLBREAK, 0);
}

public void success(object user, mapping sinfo, int skillcheck) {
    pDebug(user, sprintf("gyrscopic_stabilizer :: success=%d\n", skillcheck));
    sinfo[SI_SKILLDAMAGE] += skillcheck/100;
    return;
}

// called to set up a passive ability for a player
public void activate_for(object user) {
    tell_object(user, BS("Du klappst die Linse deines gyroskopischen Stablisiators vor dein linkes Auge. Ein zartes Fadenkreuz zeigt dir nun genau wohin du zielst."));

    if(!mappingp(user->QuerySkill(SK_FIGHT))) {
        user->ModifySkill(SK_FIGHT, ([SI_SKILLABILITY: 0, SI_SKILLFUNC: "Kampfskill"]), 100, "arkanisten");
    }

    register_attack_ability(user);
    return;
}

// called to tear down a passive for a player
public void deactivate_for(object user) {
    tell_object(user, BS("Du klappst die Linse deines gyroskopischen Stabilisators weg."));
    unregister_attack_ability(user);
    return;
}
