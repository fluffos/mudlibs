#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, "Versteckte Klinge");
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "tbd");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_PASSIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGET_POWERUP, ABILITY_GROUP_GADGETS}));
    SetProp(P_ABILITY_REQUIRES, ({DEPLOYABLE_SHIELD}));

    modify(SPRINGLOADED_GLOVES, MODIFY_DAMAGE);
}

public mapping modify_ability(string sender, int mtype, mapping payload) {
    int sc, damage;
    object user;

    if(sender != SPRINGLOADED_GLOVES) return payload;
    if(mtype != MODIFY_DAMAGE) return payload;
    if(!objectp(user=payload[SI_ABILIT_USER])) return payload;
    if(!member(payload, SI_SKILLDAMAGE)) return payload;
    if(!intp(payload[SI_SKILLDAMAGE])) return payload;

    sc = use(user, ([SI_SKILLABILITY: user->QuerySkillAbility(HIDDEN_DAGGER), SI_ABILITY_SILENT: 1]), 1);
    if(sc > 0 && !random(13 - user->QuerySkillAbility(HIDDEN_DAGGER)/1000)) {
        tell_object(user, BS("Beim Zuschlagen laesst du deine versteckte Klinge hervorschnellen."));
        pDebug(user, sprintf("hidden_dagger :: sc=%d dam=%d\n", sc, sc/150));
        payload[SI_SKILLDAMAGE] += sc/150;
    }
    return payload;
}