#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, "Lichtbringerspule");
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Du kannst eine Lichtbringerspule basteln. Dabei handelt es sich um ein nuetzliches Werkzeug, "
        "das mittels induzierter Elektrizitaet fuer einige Zeit einen gefrorenen Blitz zwischen zwei "
        "Kupferspulen erzeugt. Dieser Lichtbogen erhellt deine Umgebung.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_ACTIVATE);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGETS}));
    SetProp(P_ABILITY_COST, ([
        P_SP: 10
    ]));
}

public mapping prepare_use(object user, mapping sinfo) {
    if(present(LIGHTCOIL_ID, user)) {
        tell_object(user, BS("Deine Lichtbringerspule leuchtet bereits mit einem hellen Lichtbogen."));
        return 0;
    }
    
    tell_object(user, BS("Wie wild beginnst du die Kurbel deiner Lichtbringerspule zu drehen."));
    tell_room(ENV(user), BS(user->Name(WER)+" beginnt wie wild an der Kurbel einer kleinen Drahtkonstruktion zu drehen."), ({user}));
    return ::prepare_use(user, sinfo);
}

public int on_use_before_evaluation(object user, mapping sinfo, int skillcheck) {
    return true;
}

public int on_use_after_eval(object user, mapping sinfo, int skillcheck) {
    if(skillcheck < -3000) {
        tell_object(user, BS("Du erhaeltst einen kleinen Stromschlag!"));
        user->AddHp(-random(20));
    }
    return ::on_use_after_eval(user, sinfo, skillcheck);
}


public void success(object caster, mapping sinfo, int skillcheck) {
    object ob;

    ob = clone_object(OBJ "lightbringercoil");
    if(!ob->move(caster)) {
        tell_object(caster, BS("Hm. Aus irgendeinem Grund beginnt die Spule nicht zu leuchten!"));
        destruct(ob);
        return;
    }

    tell_object(caster, BS("Geschafft! Nach einem kurzen Moment entsteht ein heller Lichtbogen zwischen den Gabeln der Spule."));
    tell_room(ENV(caster), BS("Nach einem kurzen Moment entsteht ein hell flackernder Lichtblitz in den Haenden von "+caster->name(WEM)+"."), ({caster}));
    ob->setup(sinfo[SI_SKILLABILITY], skillcheck);
    return;
}
