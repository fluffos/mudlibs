//** INHERIT + INCLUDE + DEFINE ********************************************//
inherit "std/armour";
#include "../arkanisten.h"

//-- Farben ------------------------------------------------------------------
nosave string *std_colors=({});    //Farben vom Spieler setzbar
nosave string *report_colors=({}); //Idee von den Nekros uebernommen
nosave string normal=ANSI_NORMAL;
//-- Report-Vars -------------------------------------------------------------
#define RL_COLOR 1
#define RL_MAX 2
#define RL_SPECIAL 3
#define RL_SPELL 4
#define RL_ALIGN 5
#define RL_EXTRA_WIDE 6
#define RL_XP 7
#define RL_TEDDY 8
#define RL_PET 9

#define PASSIVE_ABILITY_CV "__passive__"

nosave int cnt=5; // fuer Align-Anzeige
nosave int callout;
nosave int aktiv=0;
nosave int lastHP, lastSP, lasthp, lastsp, lastAnimalHp;
nosave string akt_lvl="";
nosave string align="";
nosave string owner_name;
nosave object owner;
nosave mapping active_abilities;

nosave string SpecialReport(object owner);
void NotifyHpChange(int force);
nosave void activate(object ob);
nosave int ConfigureReport(string str, int what);
nosave int ShowReportHelp();
nosave int ShowColorHelp();


nomask int query_prevent_shadow() { return 1; }

public void clear_abilities() {
  // clear castverb functions
  active_abilities = ([ 
    PASSIVE_ABILITY_CV: ({ }),
   ]);
}

private void register_active_ability(object ab) {
    string castverb;

    castverb = ab->QueryProp(P_ABILITY_CASTVERB);

    if(stringp(castverb)) {
      // abilities with a castverb are a group that will be activate with the command '<castverb> <name>'
      if(!member(active_abilities, castverb)) active_abilities[castverb] = ({ });
      active_abilities[castverb] += ({ ab });
    } else {
      // active abilities without a castverb will be a command in themselves
      active_abilities[ab->skill_name()] = ab;
    }

    return;
}

private void register_passive_ability(object ab) {
  // activate any passive abilities for the player
  active_abilities[PASSIVE_ABILITY_CV] += ({ ab }); // we remember them here for deactivation later
  ab->activate_for(owner);
  return;
}

public void add_castverb_commands() {
  string *verbs, verb;
  mixed ability_obj;

  verbs = m_indices(active_abilities);

  foreach(verbs, verb, {
    if(verb == PASSIVE_ABILITY_CV) continue;
    ability_obj = active_abilities[verb];
    if(pointerp(ability_obj)) {
      AddCmd(verb, "cmd_castverb_group");
    } else {
      pDebug(TP, sprintf("add_castverb_commands :: single_cast='%s'\n", verb));
      AddCmd(verb, "cmd_single_cast");
    }
  });

  return;
}

varargs public int use_ability(object who, string name, string args) {
  object ability;
  mapping sinfo;

  ability = ABILITY_SERVICE->get_ability_by_name(name);
  if(!objectp(ability)) {
    write(BS("So eine Faehigkeit gibt es nicht."));
    return -1;
  }

  if(!ability->has_learned(owner)) {
    write(BS("Du hast diese Faehigkeit nicht erlernt."));
  }

  if(ability->QueryProp(P_ABILITY_TYPE) != ABILITY_TYPE_ACTIVE) {
    write(BS("Diese Faehigkeit ist passiv und immer aktiv."));
  }

  pDebug(TP, sprintf("use_ability :: who=%O\n", who));
  sinfo = ability->prepare_use(who, ([
    SI_SKILLARG: args,
  ]));
  if(!sinfo) {
    return -1;
  }

  if(member(sinfo, SI_PREPARE_TIME) && sinfo[SI_PREPARE_TIME] > 0) {
    SetProp(P_WATCHER_PREPARING_ABILITY, ({ability, sinfo}));
    call_out("execute_ability_after_prepare", sinfo[SI_PREPARE_TIME]);
    return 1;
  }

  pDebug(TP, sprintf("use_ability :: sinfo=%O\n", sinfo));
  return ability->use(who, sinfo);
}

public void execute_ability_after_prepare() {
  object ab;
  mapping sinfo;

  if(!QueryProp(P_WATCHER_PREPARING_ABILITY)) return;

  ab = QueryProp(P_WATCHER_PREPARING_ABILITY)[0];
  sinfo = QueryProp(P_WATCHER_PREPARING_ABILITY)[1];
  SetProp(P_WATCHER_PREPARING_ABILITY, 0);

  pDebug(TP, sprintf("execute_ability_after_prepare :: sinfo=%O\n", sinfo));
  ab->use(owner, sinfo);
}

public int cmd_castverb_group(string str) {
  string verb, name, args, *parts, p;

  verb = query_verb();
  notify_fail("Was willst du "+verb+"n? ("+verb+" <name>)\n");
  if(str == 0 || str == "") return 0;

  parts = explode(str, " ");
  if(sizeof(parts) < 2) return use_ability(TP, str);

  name = "";
  foreach(parts, p, {
    if(objectp(ABILITY_SERVICE->get_ability_by_name(name))) break;
    if(name != "") name += " ";
    name += p;
  });

  if(strlen(name) != strlen(str)) args = str[strlen(name)+1..];
  else args = 0;

  pDebug(TP, sprintf("cmd_castverb_group :: name='%s' args='%s\n", name, args||"__none__"));
  return use_ability(TP, name, args);
}

public int cmd_single_cast(string str) {
  string verb;
  verb = query_verb();
  pDebug(TP, sprintf("cmd_single_cast :: verb=%s args=%s\n", verb, TP->_unparsed_args() || "__none__"));
  return use_ability(TP, verb, TP->_unparsed_args());
}

public void remove_castverb_commands() {
  string *verbs, verb;

  verbs = m_indices(active_abilities);

  foreach(verbs, verb, {
    if(verb == PASSIVE_ABILITY_CV) continue;
    RemoveCmd(verb);
  });

  return;
}

private void update_castverb_commands() {
  remove_castverb_commands();
  add_castverb_commands();
  return;
}

public void activate_learned_abilities() {
  object *learned, ab;
  int i;

  if(!objectp(owner)) return;

  learned = ABILITY_SERVICE->get_all_learned_by(owner);
  for(i = 0; i<sizeof(learned); ++i) {
    ab = learned[i];
    if(ab->QueryProp(P_ABILITY_TYPE) == ABILITY_TYPE_ACTIVE) {
      register_active_ability(ab);
    } else if(ab->QueryProp(P_ABILITY_TYPE) == ABILITY_TYPE_PASSIVE) {
      register_passive_ability(ab);
    } else {
      raise_error("illegal ability type: " + ab->QueryProp(P_ABILITY_TYPE));
      return;
    }
  }

  update_castverb_commands();
}


public void create() {
  if( !is_clone(TO) ) return;
  ::create();
  
  //Die Farben festsetzen
  std_colors=({ANSI_GREEN, ANSI_BOLD+ANSI_YELLOW, ANSI_CYAN, 
               ANSI_BOLD+ANSI_BLUE, ANSI_PURPLE, ANSI_RED});
  report_colors=std_colors;

  SetProp(P_SHORT, "Das Bandolier des Waechterordens");
  SetProp(P_LONG, 
    "Dieses Bandolier ist eine Shaerpe aus robustem Leder, die du um deinen Oberkoerper legst. "
    "Es hat einige Schlaufen, Haken und Taschen, um allerlei Werkzeuge, Flaeschchen und Mittelchen "
    "aufzubewahren. Mitglieder des Waechterordens nutzen so ein Bandolier, um ihre Wissenschaften "
    "auszueben.\n@@guild_rank_info@@\n@@gadgets@@");
  
  SetProp(P_NAME, "Bandolier");
  SetProp(P_GENDER, NEUTER );
  SetProp(P_INFO, 
    "Mit <whilfe> kannst du sehen welche Moeglichkeiten das Bandolier einem Waechter bietet.\n");
  AddId( ({"bandolier", GUILD_OBJ_ID}) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 800+random(100) );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_WORN_TEXT, "umgehaengt");
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_WATCHER_PREPARING_ABILITY, 0);
  SetProp(P_WATCHER_COMBAT_ABILITIES, ({}));
  SetProp(P_WATCHER_DEFENSIVE_ABILITIES, ({}));
                          
  AddCmd( "whilfe"   , "ShowHelp"        ); //HilfeSeite
  AddCmd( "wreport"  , "report"          ); //Ranger_Report
  AddCmd( "wstatus"  , "wl_status"       ); //Ranger_Report_Status
  AddCmd( "wfarben"  , "SetColors"       ); //REPORT Farben
  AddCmd( "wfarbe"   , "ColorSetting"    ); //Farbe AN oder AUS   

  clear_abilities();
}

public int abort_prepare_ability() {
  if(QueryProp(P_WATCHER_PREPARING_ABILITY) == 0) return 0;
  while(find_call_out("execute_ability_after_prepare")!=-1) remove_call_out("execute_ability_after_prepare");

  tell_object(owner, BS("Du brichst deine Vorbereitungen ab."));
  SetProp(P_WATCHER_PREPARING_ABILITY, 0);
  return 1;
}

public string guild_rank_info() {
    string str;

    str = "Da, wo die Schulter ist, prangt ein ";

    switch(ENV(TO)->QueryProp(P_GUILD_LEVEL)) {
        case 1 .. 10: str += "schwarzes, geschlossenes Auge"; break;
        case 11 .. 20: str += "geoeffnetes Auge in Silber"; break;
        case 21 .. 30: str += "goldenes, geoeffnetes Auge"; break;
        default: str += "goldenes Auge ueber einen Pyramide"; break;
    }

    return str + ".";
}

public string gadgets() {
    string s;
    object ab, *gadgets;
    mixed *gadget_names, *n;

    gadget_names = ({ });

    gadgets = ABILITY_SERVICE->get_all_learned_by(owner, ABILITY_GROUP_GADGETS);
    foreach(gadgets, ab, {
      if(ab->has_learned(owner)) {
        gadget_names += ({ ({ab->QueryProp(P_ABILITY_NAME), ab->QueryProp(P_ABILITY_CASTVERB)}) });
      }
    });

    if(sizeof(gadget_names) < 1) return "";

    s = "An deinem Bandolier haengen folgende Werkzeuge:";
    foreach(gadget_names, n, {
      s += sprintf("\n  %s (%sbar)", n[0], (n[1]?n[1]:"passiv"));
    });
    return s+"\n";
}

//-- Remove ------------------------------------------------------------------
int remove(int silent)
{
  if(!silent) { write("Dein Bandolier zerfaellt in alle Einzelteile.\n"); }
  return ::remove(1);
}

//-- Reset -------------------------------------------------------------------
void reset()
{
  if(!is_clone(this_object())) return; 
  ::reset();
}

//-- NetDead & Alive ---------------------------------------------------------
void BecomesNetAlive(object wer) 
{
  if(wer==MENV) { 
    if(aktiv) { 
      wer->RemoveHpHook(ME);
      activate(wer); //Report
    }

    clear_abilities();
    activate_learned_abilities();

  }
}      

private void deactive_passive_abilities(object pl) {
  object *abs, ab;

  abs = active_abilities[PASSIVE_ABILITY_CV];
  foreach(abs, ab, {
    ab->deactivate_for(pl);
  });

  return;
}

public  void BecomesNetDead(object spieler) {
  if(spieler == MENV) {
    deactive_passive_abilities(spieler);
  }
}

int WearFunc(object ob)
{
  owner = TP;
  if(TP->QueryProp(P_GUILD)!= GUILD) { 
    tell_object(TP, BS("Nur Mitglieder des Waechterordens duerfen dieses Bandolier tragen!\n"));
    remove(); 
    return 0; 
  }

  clear_abilities();
  activate_learned_abilities();

  return 1;
}

//-- Das Init ----------------------------------------------------------------
void init()
{
  object ob, env;
  
  ::init();
  // Tests
  if(!objectp(env=MENV) || !living(env)) {remove(); return 0;}
  if((env->QueryProp(P_GUILD)!= GUILD) && (!IS_WIZARD(env)) )
  { remove(); return 0; }
  if(TP!=env) { return 0; }
  
  // Nur ein Koecher im INV
  TO->RemoveId(GUILD_OBJ_ID);
  if(objectp(ob=present(GUILD_OBJ_ID, env))) { ob->remove(1); }
  TO->AddId(GUILD_OBJ_ID);
  
  owner=env;

  add_action("abort_prepare_ability", "", 1);
}

//-- Ist der Report aktiv? ---------------------------------------------------
int query_aktiv() { return aktiv; }

