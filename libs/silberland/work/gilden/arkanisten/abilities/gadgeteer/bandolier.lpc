//**************************************************************************//



//** Farb-Einstellungen ****************************************************//
//--- Allg. Farben -----------------------------------------------------------
int ColorSetting(string str)
{
  notify_fail("Befehl: <wlfarbe 0|1>\n"); //Farbe an oder aus?
  if(str == "1")
  { std_colors=({ANSI_GREEN, ANSI_BOLD+ANSI_YELLOW, ANSI_CYAN, 
                 ANSI_BOLD+ANSI_BLUE, ANSI_PURPLE, ANSI_RED});
    write("Farben eingeschaltet.\n");
    return 1; }
  if(str == "0")
  { std_colors=({ANSI_NORMAL, ANSI_NORMAL, ANSI_NORMAL, 
                 ANSI_NORMAL, ANSI_NORMAL, ANSI_NORMAL});
    write("Farben ausgeschaltet.\n");
    return 1; }
  return 0;
}

//-- Report_Farben -----------------------------------------------------------
nosave int SetColors(string cols) 
{
  string *colors, *set_cols;
  mapping valid_colors;
  int i;

  notify_fail("Befehl: "
              "<wlfarben farbe1 farbe2 farbe3 farbe4 farbe5 farbe6>\n");
  set_cols=({});
  valid_colors=(["schwarz": ANSI_BLACK,
                 "rot"    : ANSI_RED,
                 "gruen"  : ANSI_GREEN,
                 "gelb"   : ANSI_BOLD+ANSI_YELLOW,
                 "blau"   : ANSI_BOLD+ANSI_BLUE,
                 "lila"   : ANSI_PURPLE,
                 "cyan"   : ANSI_CYAN,
                 "zyan"   : ANSI_CYAN,
                 "weiss"  : ANSI_WHITE,
                 "normal" : ANSI_NORMAL]);
  if(!cols) { cols="standard";}
  cols=lower_case(cols);
  if(cols=="standard") 
  { report_colors=({ANSI_GREEN, ANSI_BOLD+ANSI_YELLOW, ANSI_CYAN, 
                    ANSI_BOLD+ANSI_BLUE, ANSI_PURPLE, ANSI_RED});
    write(BS("Ok, Standard Farben gesetzt!\n"));
    return 1; }
  if(cols=="hilfe") { return ShowColorHelp(); }
  colors=explode(cols, " ");
  if(sizeof(colors)!=6)
  { write("Es muessen sechs Farben angegeben werden!\n");
    return 0; }
  for(i=0;i<=sizeof(colors)-1;i++)
  {
    if(!member(valid_colors, colors[i]))
    { write(sprintf("Falsche Farbe: %s!\n", colors[i]));
      return 0; }
    set_cols+=({valid_colors[colors[i]]});
  }
  report_colors=set_cols;
  write("Neuer Farben fuer den Report wurden gesetzt.\n");
  return 1;
}
//**************************************************************************//



//** Ranger_Report *********************************************************//
//-- Ranger_Report_Status (saukomplex) ---------------------------------------
int wl_status(string str) 
{
  notify_fail("Du musst die Reportfunktion erst aktivieren.\n");
  if(!aktiv) { return 0; }
  NotifyHpChange(1);
  return 1;
}

//-- Welche Spells sind aktiv? -----------------------------------------------
string active_spells(object ob)
{
    string s;
    mixed *h;


    s = "";

    if(objectp(present(LIGHTCOIL_ID, ob))) {
      s += "L";
    }

    if(objectp(present(MAGNET_GRAPPLE_ID, ob))) {
      s += "G";
    }

    if(ob->QueryProp(P_WATCHER_ELECTRIC_GLOVES) > time()) {
      s += "e";
    }

    if (h=ob->QueryProp(P_TMP_DEFEND_HOOK)) {
      switch(h[2]) {
        case "handschild_func": s += "S";
      }
    }

    return s;
}

string GetAlign(int i)
{
  string align;
  
  if(!intp(i)) i = 0;
  
  if(i> 999) {i=1000;}
  if(i< -999) {i= -1000;}
  switch(i) {
    case -1000:         align="Satanisch";         break;
    case  -999 .. -801: align="Teuflisch";         break;
    case  -800 .. -601: align="Extrem boese";      break;
    case  -600 .. -401: align="Verdorben";         break;
    case  -400 .. -201: align="Boese";             break;
    case  -200 ..  -51: align="Durchtrieben";      break;
    case   -50 ..   50: align="Neutral";           break;
    case    51 ..  200: align="Freundlich";        break;
    case   201 ..  400: align="Hilfsbereit";       break;
    case   401 ..  600: align="Gut";               break;
    case   601 ..  800: align="Sehr gut";          break;
    case   801 ..  999: align="Fast Heilig";       break;
    default:            align="Heilig";            break; }
   
  return align;
}

varargs void NotifyHpChange(int status_cmd)
{
  int hp, mhp, sp, msp, stat, changedHP, changedSP, i, k, changedAnimalPercent;
  string color, s;
  mixed pet;

  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv && !stat)
  { if (owner!=find_netdead(getuid(owner))) 
    { owner->RemoveHpHook(ME); } // geht nur bei nicht-netztoten Spielern
    return; }
  if(!query_once_interactive(owner)) {activate(0); return;}
  
  // aktuelle Werte ermitteln + ReportFarbe
  hp  = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp  = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);
  // Werte berechnen und soll gesendet werden? 
  changedHP=hp-lasthp;
  changedSP=sp-lastsp;    

  if (  (  ( (hp < lastHP)                           || 
             (hp > lastHP && (sp == msp || callout)) || 
             (sp != lastSP)                          ||
             (stat)
           ) && ( changedHP || changedSP )
        )  || status_cmd )
  {
    // Teddy-Report?
    if(test_bit(akt_lvl, RL_TEDDY))
    {
      s="Du hast jetzt "+to_string(hp)+" ("+to_string(mhp)+") Lebenspunkte "
        "und "+to_string(sp)+" ("+to_string(msp)+") Magiepunkte.\n"; 
      if(test_bit(akt_lvl, RL_SPELL)) // einzige Teddy-Erweiterung
      { s+="[Zauber: "+active_spells(owner)+"]\n"; }
    }
    else
    {
      // Farben Ja|Nein
      if(test_bit(akt_lvl, RL_COLOR))
      { switch(hp*100/mhp)
        { case 0 .. 16: color=report_colors[5]; break;
          case 17.. 32: color=report_colors[4]; break;
          case 33.. 48: color=report_colors[3]; break;
          case 49.. 64: color=report_colors[2]; break;
          case 65.. 80: color=report_colors[1]; break;
          case 81..100: color=report_colors[0]; break;
          default:      color="";           break;
        } 
      }
      else { color=""; }
      if(cnt>5) { align=GetAlign(owner->QueryProp(P_ALIGN)); cnt=0; }
      cnt++;
      s=sprintf(color+"~[%s]~%s~%s~{LP:"+normal+"%d%s%s"+color+"|MP:"
                +normal+"%d%s%s"+color+"}]"
          ,(test_bit(akt_lvl, RL_SPELL)?
            ""+normal+active_spells(owner)+color+"":
            "")
          ,(test_bit(akt_lvl, RL_SPECIAL)?
            "["+normal+SpecialReport(owner)+color+"]":
            "")
          ,(test_bit(akt_lvl, RL_ALIGN)?
            "{"+normal+align+color+"}":
            "")
          ,hp
          ,(test_bit(akt_lvl, RL_MAX)?"/"+to_string(mhp):"")
          ,(changedHP?"("+(changedHP>0?"+":"")+to_string(changedHP)+")":"")
          ,sp
          ,(test_bit(akt_lvl, RL_MAX)?"/"+to_string(msp):"")
          ,(changedSP?"("+(changedSP>0?"+":"")+to_string(changedSP)+")":"")
          );
    }

    tell_object(owner, s+normal+"\n"); 
    lastsp  = sp; lasthp  = hp;
    callout = 0;  lastHP  = hp; 
  }
  else if( !callout && (hp > lastHP+1) )
  { callout = 1;
    call_out("NotifyHpChange",0); }
  else { callout = 0; lastHP = hp; }
  lastSP = sp;
}

//-- Report aktivieren -------------------------------------------------------
nosave void activate(object ob) 
{
  mixed m;
  
  if(objectp(ob)) {
    if(stringp(m=ob->QueryProp(P_WATCHER_REPORT_LEVEL))) {akt_lvl=m;}
     aktiv = 1;
    owner = ob;
    owner_name = getuid(owner);
    ob->AddHpHook(ME);
    lastHP = ob->QueryProp(P_HP);
    lastSP = ob->QueryProp(P_SP);
  } 
  else 
  { if(ob=(owner||TP)) { ob->RemoveHpHook(ME); }
  if(stringp(m=ob->QueryProp(P_WATCHER_REPORT_LEVEL))) {akt_lvl=m;}
    owner = owner_name = aktiv = 0; }
}

nosave int ConfigureReport(string str, int what) 
{
  int flag;
  string anzeige;
  
  flag=to_int(str);
  anzeige="";
  if(flag<0 || flag>1) {  write("Falsche Eingabe!\n"); return 1; }
  if(flag==0) { akt_lvl=clear_bit(akt_lvl, what); }
  else { akt_lvl=set_bit(akt_lvl, what); }
  switch(what)
  {
    case RL_COLOR:      anzeige="Farben"; break; 
    case RL_MAX:        anzeige="maximalen Lebens\\Magiepunkte"; break;
    case RL_SPECIAL:    anzeige="Zustaende"; break; 
    case RL_SPELL:      anzeige="Zauberanzeige"; break;
    case RL_TEDDY:      anzeige="Teddyreport"; break;
    case RL_XP:         anzeige="Erfahrungspunkte"; break;
    case RL_PET:        anzeige="Gesundheit des Tieres"; break;
    case RL_EXTRA_WIDE: anzeige="Erweiterung"; break;
    case RL_ALIGN:      anzeige="Gesinnung"; break;
  }
  write(BS("Du hast jetzt die "+anzeige+" "+(flag?"ein":"ab")+"gestellt."));
  if(objectp(owner))
  { owner->SetProp(P_WATCHER_REPORT_LEVEL, akt_lvl);
    owner->Set(P_WATCHER_REPORT_LEVEL, SAVE, F_MODE_AS); }
  return 1;
}

//-- Report_cmd --------------------------------------------------------------
nosave int report(string str) 
{
  string *msg;

  notify_fail("Den Befehl gibt es nicht, Hilfe mit 'wlreport hilfe'.\n");
  if(!sizeof(msg=explode(str," "))) { return 0; }
  switch(msg[0])
  {
    case "ein":
      if (aktiv && objectp(owner)) { write("Der Report war schon aktiv.\n"); }
      else 
      { write("Der Report ist jetzt aktiv.\n");
        activate(TP); }
    break;
    
    case "aus":
      if (!aktiv) { write("Der Report ist schon ausgeschaltet.\n"); }
      else 
      { write("Der Report ist nun ausgeschaltet.\n");
        activate(0); }
    break;
    
    case "farben":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_COLOR); }
      else { write("Befehl: wreport farben 0|1\n"); }
    break;
    
    case "max":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_MAX); }
      else { write("Befehl: wreport max 0|1\n"); }
    break;

    case "zauber":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_SPELL); }
      else { write("Befehl: wlreport zauber 0|1\n"); }
    break;
    
    case "gesinnung":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_ALIGN); }
      else { write("Befehl: wlreport gesinnung 0|1\n"); }
    break;
    
    case "teddy":
      if(sizeof(msg)>1) { ConfigureReport(msg[1], RL_TEDDY); }
      else { write("Befehl: wlreport teddy 0|1\n"); }
    break;

    case "hilfe": 
    ShowReportHelp(); 
  break;

  default: return 0; break;
  }

  return 1;
}

public void AddAttackAbility(string name) {
  if(member(QueryProp(P_WATCHER_COMBAT_ABILITIES), name) < 0) {
    SetProp(P_WATCHER_COMBAT_ABILITIES, QueryProp(P_WATCHER_COMBAT_ABILITIES) + ({ name }));
  }
}

public void RemoveAttackAbility(string name) {
  if(member(QueryProp(P_WATCHER_COMBAT_ABILITIES), name) >= 0) {
    SetProp(P_WATCHER_COMBAT_ABILITIES, QueryProp(P_WATCHER_COMBAT_ABILITIES) - ({ name }));
  }
}

public void AddDefenseAbility(string name) {
  if(member(QueryProp(P_WATCHER_DEFENSIVE_ABILITIES), name) < 0) {
    SetProp(P_WATCHER_DEFENSIVE_ABILITIES, QueryProp(P_WATCHER_COMBAT_ABILITIES) + ({ name }));
  }
}

public void RemoveDefenseAbility(string name) {
  if(member(QueryProp(P_WATCHER_DEFENSIVE_ABILITIES), name) >= 0) {
    SetProp(P_WATCHER_DEFENSIVE_ABILITIES, QueryProp(P_WATCHER_COMBAT_ABILITIES) - ({ name }));
  }
}

public void reactivate_abilities() {
    clear_abilities();
    activate_learned_abilities();
}