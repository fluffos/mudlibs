#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, CAP(PULSE_GENERATOR));
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Dein Blitzstab wird mit einem selbstaufladenden Generator aufgeruestet. Dieser Generator "
        "erzeugt regelmaessig eine hohe elektrische Ladung, die bei Aktivierung als Kettenblitz "
        "entladen wird. Der Blitz trifft alle deine Feinde gleichzeitig.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_ACTIVATE);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGETS, ABILITY_GROUP_GADGET_POWERUP}));
    SetProp(P_ABILITY_COST, 40);
    SetProp(P_ABILITY_REQUIRES, ({CHAIN_LIGHTING_PROJECTOR}));
    SetProp(P_ABILITY_SPELLBREAK, 4);
    SetProp(P_ABILITY_MIN_GUILD_LEVEL, 21);
}

public mapping prepare_use(object user, mapping sinfo) {
    object rod;

    if(!objectp(rod=present(TESLA_BATON_ID, user))) {
        tell_object(user, BS("Um den Pulsgenerator zu aktivieren musst du deinen Blitzstab gezueckt haben."));
        return 0;
    }

    if(rod->query_pulse_active()) {
        tell_object(user, BS("Der Pulsgenerator ist bereits aktiviert."));
        return 0;
    }
    
    tell_object(user, BS("Du entriegelst den Pulsgenerator."));
    tell_room(ENV(user), BS(user->Name(WER)+" entfernt einen kleinen Riegel am Blitzstab."), ({user}));

    sinfo[SI_PREPARE_TIME] = 6;

    return ::prepare_use(user, sinfo);
}

public void failed(object caster, mapping sinfo, int skillcheck) {
    tell_object(caster, BS("Der Generator springt nicht an."));

    return ::failed(caster, sinfo, skillcheck);
}

public void success(object user, mapping sinfo, int skillcheck) {
    object rod;

    if(!objectp(rod=present(TESLA_BATON_ID, user))) {
        tell_object(user, BS("Um den Pulsgenerator zu aktivieren musst du deinen Blitzstab gezueckt haben."));
        return;
    }
    
    tell_object(user, BS("Funkenschlagend springt der Generator an und beginnt den Blitzstab zu laden."));
    tell_room(ENV(user), BS(user->Name(WER)+" dreht den Blitzstab probehalber und Funken stoben auf."), ({user}));

    rod->activate_pulse_generator(user, sinfo, skillcheck);

    return;
}
