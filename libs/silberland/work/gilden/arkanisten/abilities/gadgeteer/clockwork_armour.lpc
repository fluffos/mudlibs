#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, CAP(CLOCKWORK_ARMOUR));
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Die Uhrwerkruestung ist eine raffinierte Brustplatte aus beweglichen "
        "Messing- und Stahlplatten, die mit einem Uhrwerkmechanismus versehen ist. "
        "Im Ruhezustand kompakt, entfaltet sie sich auf Knopfdruck in einem praezisen "
        "Zusammenspiel von Zahnraedern und Scharnieren. Binnen Sekunden umschliesst sie "
        "den Oberkoerper des Traegers, bietet robusten Schutz und passt sich perfekt an, "
        "ohne die Beweglichkeit stark zu beeintraechtigen.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_ACTIVATE);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGETS}));
    SetProp(P_ABILITY_COST, 0);
    SetProp(P_ABILITY_REQUIRES, ({REINFORCED_BRACES}));
    SetProp(P_ABILITY_SPELLBREAK, 0);
}

public mapping prepare_use(object user, mapping sinfo) {
    if(present(CLOCKWORK_ARMOUR_ID, user)) {
        tell_object(user, BS("Du traegst die Uhrwerkruestung bereits."));
        return 0;
    }

    if(sizeof(user->QueryArmours(AT_ARMOUR)) > 0) {
        tell_object(user, BS("Du kannst keinen anderen Penzer tragen, wenn du die Uhrwerkruestung aktivieren willst."));
        return 0;
    }

    return ::prepare_use(user, sinfo);
}

public void success(object user, mapping sinfo, int skillcheck) {
    object cb;
    int val;
    mixed h;
    mapping mod;

    if(objectp(cb=present(CLOCKWORK_ARMOUR_ID, user))) {
       val = (int) (sinfo[SI_SKILLDAMAGE] * ((float) skillcheck / MAX_ABILITY / 10.0));
       pDebug(user, sprintf("clockwork_armour :: reduction=%d\n", val));
       val -= apply_modifications(MODIFY_CUSTOM_VALUE, ([
        SI_ABILIT_USER: user,
        SI_ABILITY_USAGE: "defense_bonus",
        SI_ABILITY_VALUE: 0
    ]))[SI_ABILITY_VALUE];
    } else {
        cb = clone_object(OBJ "clockwork_armour");
        if(!cb->move(user)) {
            tell_object(user, BS("Du kannst das gerade nicht tun."));
            destruct(cb);
            return;
        }

        cb->setup(user);
        cb->do_wear(CLOCKWORK_ARMOUR_ID);
    }

    return;
}

public int on_use_after_eval(object user, mapping sinfo, int skillcheck) {
    if(!objectp(present(CLOCKWORK_ARMOUR_ID, user))) return ERFOLG; // always succeed in wearing it
    return ::on_use_after_eval(user, sinfo, skillcheck);
}