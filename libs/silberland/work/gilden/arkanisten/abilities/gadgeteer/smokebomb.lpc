#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, "Rauchbombe");
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Du wirst eine Rauchbombe, die vor dir explodiert. Sie vernebelt deinen Gegnern die Sicht auf dich und "
        "sorgt dafuer, dass sie dich schlechter treffen.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_THROW);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_GADGETS, ABILITY_GROUP_BOMBS}));
    SetProp(P_ABILITY_COST, ([
        P_SP: 10,
        P_MV: 100,
    ]));
}

public mapping prepare_use(object user, mapping sinfo) {
    if(get_free_hands(user) < 1) {
        tell_object(user, BS("Du musst eine freie Hand haben, um eine Bombe zu werfen!"));
        return 0;
    }

    if(present(SMOKE_BOMB_ID, ENV(user))) {
        tell_object(user, BS("Hier wurde bereits eine Rauchbombe gezuendet."));
        return 0;
    }
    
    tell_object(user, BS("Du nimmst eine Rauchbombe in die Hand und zuendest die Lunte an."));
    tell_room(ENV(user), BS(user->Name(WER)+" nimmt eine kleine Papierkugel in die Hand und zuendet deren Lunte."), ({user}));

    sinfo[SI_PREPARE_TIME] = 4;
    return ::prepare_use(user, sinfo);
}

public void failed(object user, mapping sinfo, int skillcheck) {
    if(skillcheck < -3000 || !random(5)) {
        tell_object(user, BS("Die Bombe explodiert in deiner Hand!"));
        tell_room(ENV(user), BS("Irgendetwas explodiert in "+user->name(WESSEN)+" Hand.")), ({user});
        user->AddHp(-random(20));
    }
    
    return ::failed(user, sinfo, skillcheck);
}


public void success(object caster, mapping sinfo, int skillcheck) {
    object ob;

    ob = clone_object(OBJ "smoke");
    ob->setup(caster, sinfo[SI_SKILLABILITY], skillcheck);
    if(!ob->move(ENV(caster))) {
        tell_object(caster, BS("Hm. Die Bombe verpufft einfach!"));
        destruct(ob);
        return;
    }

    tell_object(caster, BS("Du wirfst die Bombe vor dir auf den Boden. Mit einem lauten Zischen beginnt sie stark zu rauchen!"));
    tell_room(ENV(caster), BS(caster->Name(WER)+" wirft etwas auf den Boden, dass mit einem lauten Zischen dichten Rauch verbeitet und deine Sicht vernebelt."), ({caster}));
    return;
}
