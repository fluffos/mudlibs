#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, CAP(ADRENALINE_SHOT));
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Mit der Stimulanzienspritze kannst du dir einen Schuss Adrenalin verabreichen, "
        "der deine Sinne schärft und dich für kurze Zeit schneller und wacher macht.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_INJECT);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_ALCHEMY}));
    SetProp(P_ABILITY_COST, ([
        P_SP: 25,
    ]));
    SetProp(P_ABILITY_REQUIRES, ({ QUICK_REMEDY }));
}

public mapping prepare_use(object user, mapping sinfo) {
    object victim;

    if(get_free_hands(user) < 1) {
        tell_object(user, BS("Du musst eine freie Hand haben, um die Spritze zu nutzen!"));
        return 0;
    }

    if(strlen(sinfo[SI_SKILLARG]) == 0) {
        victim = user;
    } else {
        victim = FindLivingVictim(sinfo[SI_SKILLARG], user);
        if(!objectp(victim)) {
            victim = user;
        }
    }

    
    tell_object(user, BS("Du ziehst eine kleine Spritze mit gelbleuchtender Fluessigkeit auf."));
    tell_room(ENV(user), BS(user->Name(WER)+" nimmt eine gefaehrlich dicke Nadel aus dem Bandolier und fuellt eine gelbe Fluessigkeit ein."), ({user}));

    sinfo[SI_PREPARE_TIME] = 6;
    sinfo[SI_SKILLARG] = victim;

    return ::prepare_use(user, sinfo);
}

public void failed(object user, mapping sinfo, int skillcheck) {
    object victim;
    victim = sinfo[SI_SKILLARG];
    if(skillcheck < -3000) {
        tell_object(user, BS("Du hast die Nadel verkantet!"));
        tell_room(ENV(user), BS("Die Nadel von "+user->name(WEM)+" verkantet sich und sticht "+victim->name(WEN)+" in die Hand!"), ({user}));
        if(victim != user) {
            tell_object(victim, BS("Autsch! Die Nadel von "+user->name(WEM)+" verkantet sich und sticht dir in die Hand!"));
        }
        victim->AddHp(-random(5)+1);
        return ::failed(user, sinfo, skillcheck);
    }

   tell_room(ENV(user), BS(user->Name(WER)+" injiziert das Mittel in das Bein von "+victim->name(WEM)+". Nichts passiert."), ({user, victim}));
    if(victim != user) {
         tell_object(victim, BS(user->name(WEM)+" injiziert dir das Mittel in das Bein. Nichts passiert."));
    }
    tell_object(user, BS("Das Mittel scheint nicht zu wirken."));
    
    return ::failed(user, sinfo, skillcheck);
}

public void success(object user, mapping sinfo, int skillcheck) {
    object victim;
    int duration;

    victim = sinfo[SI_SKILLARG];
    if(!objectp(victim)) {
        tell_object(user, BS("Nanu? Dein Ziel ist nicht mehr da!"));
        return;
    }

    if(victim == user) {
        tell_object(user, BS("Du injizierst dir die Stimulanzien ins Bein. Mit einem Schlag bist du hellwach und deine Muskeln gespannt."));
        tell_room(ENV(user), BS(user->Name(WER)+" injiziert sich die Stimulanzien in ein Bein."), ({user}));
    } else {
        tell_object(user, BS("Du injizierst "+victim->name(WEN)+" Stimulanzien in ein Bein."));
        tell_object(victim, BS(user->name(WEM)+" injiziert dir eine stimulierende Mishung in den Arm. Ploetzlich fuehlst du dich hellwach und schnell."));
        tell_room(ENV(user), BS(user->Name(WER)+" injiziert "+victim->name(WEM)+" eine Sprize ins Bein."), ({user, victim}));
    }

    duration = 5 + skillcheck / 1000;
    victim->ModifySkillAttribute(user, SA_SPEED, 100 + skillcheck / 100 + sinfo[SI_SKILLABILITY] / 80, duration);
    pDebug(user, sprintf("adrenaline_shot :: success :: speed bonus %d for %d rounds\n", 100 + skillcheck / 100 + sinfo[SI_SKILLABILITY] / 80, 5 + skillcheck / 1000));
    victim->do_exhaust(- (sinfo[SI_SKILLABILITY] / 10));

    call_out("end_effect", duration, victim);

    return;
}

public void end_effect(object victim) {
    if(!objectp(victim)) return;
    tell_object(victim, BS("Die Wirkung der Stimulanzien lässt nach und du fühlst dich wieder normal."));
    return;
}