#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, CAP(ACID_SPLASH));
    SetProp(P_ABILITY_DESCRIPTIPON, 
       "Du wirfst ein kleines Flaeschchen mit Saeure auf dein Opfer, das bei Aufprall "
       "zersplittert. Die aetzende Fluessigkeit ergiesst sich sodann ueber das Ziel und "
       "fuegt ihm Veraetzungen zu.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_THROW);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_ALCHEMY}));
    SetProp(P_ABILITY_COST, ([
        P_SP: 15,
        P_MV: 100,
    ]));
    SetProp(P_ABILITY_REQUIRES, 0);
}

public mapping prepare_use(object user, mapping sinfo) {
    object victim;

    if(get_free_hands(user) < 1) {
        tell_object(user, BS("Du musst eine freie Hand haben, um das Saeureflaeschchen zu werfen!"));
        return 0;
    }

    victim = FindEnemyVictim(sinfo[SI_SKILLARG], user);
    if(!objectp(victim)) {
        tell_object(user, BS("Dazu benoetigst du einen Gegner!"));
        return 0;
    }
    
    tell_object(user, BS("Du nimmst ein Flaeschchen mit gruener Saeure in die Hand und zielst..."));
    tell_room(ENV(user), BS(user->Name(WER)+" nimmt ein kleines Glasflaeschchen mit gruener Fluessigkeit in die Hand..."), ({user}));

    sinfo[SI_PREPARE_TIME] = 2;
    sinfo[SI_SKILLDAMAGE_TYPE] = ({ DT_ACID });
    sinfo[SI_SKILLDAMAGE] = 100;
    sinfo[OFFSET(SI_SKILLDAMAGE)] = 100;
    sinfo[SI_MAX_DAMAGE] = 300;
    sinfo[SI_NOMAGIC] = 100;
    sinfo[SI_SKILLARG] = victim;

    return ::prepare_use(user, sinfo);
}

public void failed(object user, mapping sinfo, int skillcheck) {
    if(skillcheck < -3000 || !random(5)) {
        tell_object(user, BS("Du zerbrichst das Flaeschchen in deiner Hand!"));
        tell_room(ENV(user), BS(user->Name(WER)+" zerbricht das Flaeschchen in der Hand und aetzende Saeure ergiesst sich daraus."), ({user}));
        user->AddHp(-random(20));
        return ::failed(user, sinfo, skillcheck);
    }

    tell_room(ENV(user), BS("... und wirft es auf den Boden, wo es keinen Schaden anrichtet."), ({user}));
    tell_object(user, BS("... du wirfst und verfehlst dein Ziel."));
    
    return ::failed(user, sinfo, skillcheck);
}

public void success(object user, mapping sinfo, int skillcheck) {
    object victim, ob;

    victim = sinfo[SI_SKILLARG];
    if(!objectp(victim)) {
        tell_object(user, BS("Nanu? Dein Opfer ist nicht mehr da!"));
        return;
    }
    
    sinfo[SI_SKILLDAMAGE] += skillcheck / 100;

    tell_room(ENV(user), BS(user->Name(WER)+" schleudert das Flaeschchen auf " + victim->name(WEN) + " und aetzende Saeure ergiesst sich daraus."), ({user}));
    tell_object(user, BS("... du wirfst das Flaeschchen und triffst " + victim->name(WEN) +"."));

    pDebug(user, sprintf("acid_splash :: victim=%O damage=%d..%d\n", victim, sinfo[OFFSET(SI_SKILLDAMAGE)], sinfo[SI_SKILLDAMAGE]));
    default_attack_spell(victim, user, sinfo, ([SP_NAME: ACID_SPLASH, SP_SHOW_DAMAGE: 1]));

    if(skillcheck > 8000) {
        tell_room(ENV(victim), BS("Saeurerueckstaende bleiben auf " + victim->name(WEM) + " kleben."));
        call_out("acid_dot", 0, victim, 1 + random(3), (10000 - skillcheck) / 100, user);
        pDebug(user, sprintf("acid_splash :: damage over time bonusDmg=%d\n", (10000 - skillcheck) / 100));
    }
    return;
}

public void acid_dot(object victim, int remainingRounds, int dmgBonus, object user) {
    int dmg;
    string strength;

    if(!objectp(victim) || remainingRounds-- <= 0) return;

    dmg = (random(20) + dmgBonus) * 10;
    victim->Defend(dmg, DT_ACID, ([SP_SHOW_DAMAGE: (ENV(user) == ENV(victim)), SP_NAME: ACID_SPLASH]), user);
    call_out("acid_dot", 0, remainingRounds, dmgBonus, user);
}
