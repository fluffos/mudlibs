#include "../../arkanisten.h"

inherit GUILD_FOLDER "abilities/ability.lpc";

public void create() {
    if(is_clone(TO)) return;

    ::create();
    SetProp(P_ABILITY_NAME, CAP(QUICK_REMEDY));
    SetProp(P_ABILITY_DESCRIPTIPON, 
        "Mit dem Schnellheilmittel kannst du kleinere Wunden sofort versorgen. "
        "Du trinkst eine injizierst dir eine Phiole mit einer heilenden Mixtur, "
        "die deine Wunden schliesst und dich etwas erholt.");    
    SetProp(P_ABILITY_TYPE, ABILITY_TYPE_ACTIVE);
    SetProp(P_ABILITY_BASE_ATTRIBUTE, A_DEX);
    SetProp(P_ABILITY_CASTVERB, CAST_VERB_INJECT);
    SetProp(P_ABILITY_GROUP, ({ABILITY_GROUP_ALCHEMY}));
    SetProp(P_ABILITY_COST, ([
        P_SP: 20,
    ]));
}

public mapping prepare_use(object user, mapping sinfo) {
    object victim;

    if(get_free_hands(user) < 1) {
        tell_object(user, BS("Du musst eine freie Hand haben, um das Schnellheilmittel zu nutzen!"));
        return 0;
    }

    victim = FindLivingVictim(sinfo[SI_SKILLARG], user);
    if(!objectp(victim)) {
        victim = user;
    }

    
    tell_object(user, BS("Du ziehst eine kleine Spritze mit dem Schnellheilmittel auf."));
    tell_room(ENV(user), BS(user->Name(WER)+" nimmt eine gefaehrlich dicke Nadel aus dem Bandolier und fuellt eine gruene Fluessigkeit ein."), ({user}));

    sinfo[SI_PREPARE_TIME] = 6;
    sinfo[SI_SKILLARG] = victim;

    return ::prepare_use(user, sinfo);
}

public void failed(object user, mapping sinfo, int skillcheck) {
    object victim;
    victim = sinfo[SI_SKILLARG];
    if(skillcheck < -3000) {
        tell_object(user, BS("Du hast die Nadel verkantet!"));
        tell_room(ENV(user), BS("Die Nadel von "+user->name(WEM)+" verkantet sich und sticht "+victim->name(WEN)+" in die Hand!"), ({user}));
        if(victim != user) {
            tell_object(victim, BS("Autsch! Die Nadel von "+user->name(WEM)+" verkantet sich und sticht dir in die Hand!"));
        }
        victim->AddHp(-random(5)+1);
        return ::failed(user, sinfo, skillcheck);
    }

   tell_room(ENV(user), BS(user->Name(WER)+" injiziert das Mittel in den Arm von "+victim->name(WEM)+". Nichts passiert."), ({user, victim}));
    if(victim != user) {
         tell_object(victim, BS(user->name(WEM)+" injiziert dir das Mittel in den Arm. Nichts passiert."));
    }
    tell_object(user, BS("Das Mittel scheint nicht zu wirken."));
    
    return ::failed(user, sinfo, skillcheck);
}

public void success(object user, mapping sinfo, int skillcheck) {
    object victim;

    victim = sinfo[SI_SKILLARG];
    if(!objectp(victim)) {
        tell_object(user, BS("Nanu? Dein Ziel ist nicht mehr da!"));
        return;
    }

    if(victim == user) {
        tell_object(user, BS("Du injizierst dir das Schnellheilmittel in den Arm. Deine Wunden schliessen sich und du fühlst dich etwas erholter."));
        tell_room(ENV(user), BS(user->Name(WER)+" injiziert sich das Schnellheilmittel in den Arm. Seine Wunden scheinen sich zu schliessen."), ({user}));
    } else {
        tell_object(user, BS("Du injizierst "+victim->name(WEN)+" das Schnellheilmittel in den Arm. Seine Wunden scheinen sich zu schliessen."));
        tell_object(victim, BS(user->name(WEM)+" injiziert dir das Schnellheilmittel in den Arm. Deine Wunden scheinen sich zu schliessen."));
        tell_room(ENV(user), BS(user->Name(WER)+" injiziert "+victim->name(WEN)+" das Schnellheilmittel in den Arm. Seine Wunden scheinen sich zu schliessen."), ({user, victim}));
    }

    victim->AddHp(10 + skillcheck / 1000);

    return;
}
