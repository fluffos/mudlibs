
#include "../waechter.h"

inherit "std/armour";

object owner;

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Verstaerkende Schienen");
  SetProp(P_LONG,
    "Es handelt sich um ein Buendel aus Metallstangen und -schienen, das mit einem komplexen Uhrwerk "
    "verbunden ist. Wenn das Uhrwerk, so wie jetzt, aufgezogen ist und arbeitt, dann unterstuetzt es "
    "dank der mechanischen Gelenke mit Zahnraedern das Heben und Tragen schwerer Lasten." );
  SetProp(P_INFO, BS("Diese Schienen helfen dir schwere Lasten zu tragen.") );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({REINFORCED_BRACES_ID, "schienen"}) );
  SetProp(P_NAME_ADJ, "verstaerkend");

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_MATERIAL, ([ MAT_IRON: 80, MAT_COPPER: 10, MAT_BRASS: 5, MAT_LEATHER: 5]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: GUILD]) );

  SetProp(P_WEAR_TEXT, ({"Du schnallst die verstaerkenden Schienen an.\n", " schnallt sich verstaerkende Schienen um.\n"}));
  SetProp(P_UNWEAR_TEXT, ({"Du steckst die Schienen in dein Bandolier.\n", " steckt ein paar Metallstangen in das Bandolier.\n"}));
}

int WearFunc(object me) {
    if(me != TO) return 0;
    if(!ABILITY_SERVICE->get_ability_by_name(REINFORCED_BRACES)->has_learned(TP)) {
        tell_object(TP, BS("Du kannst mit so einem Ding doch gar nicht umgehen!"));
        remove(1);
        return 0;
    }
    return 1;
}

int RemoveFunc(object me) {
    call_out("remove", 0, 1);
  return 1;
}

public void set_timeout(int t) {
    call_out("end", t);
}

public void end() {
    tell_object(ENV(TO), BS("Das Uhrwerk der verstaerkenden Schienen hoert auf zu ticken."));
    DoUnwear(0);
    remove(1);
    return;
}