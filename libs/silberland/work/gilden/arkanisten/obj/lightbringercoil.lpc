
#include "../waechter.h"

inherit "std/thing";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_LIGHT, 1);

  AddId(({GADGET_ID, LIGHTCOIL_ID}));
}

public void setup(int ability, int success) {
    call_out("turn_off", ability/50 + success/80);
    return;
}

public void turn_off() {
    tell_object(ENV(TO), BS("Der Lichtbogen deiner Lichtbringerspule erlischt flackernd."));
    tell_room(ENV(TO), BS("Das elektrische Leuchten, um "+ENV(TO)->name(WEN)+" verlischt flackernd."));
    remove(1);
    return;
}


public void NotifyPlayerDeath(object pl) {
    if(pl == ENV(TO)) {
        remove(1);
    }
    return;
}