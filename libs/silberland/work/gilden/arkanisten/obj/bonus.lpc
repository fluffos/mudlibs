inherit "/std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <new_skills.h>
#include <moredef.h>
#include "/gilden/arkanisten/arkanisten.h"

private string endMessage;
private string extra_look;

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    AddId(({"\narkanisten_bonus"}));

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_WEIGHT, 0);  
    SetProp(P_VALUE, 1);
    SetProp(P_NOBUY, 1); 
    SetProp(P_NODROP, 1);
    SetProp(P_NOGET, 1);
    SetProp(P_NEVERDROP, 1);
    SetProp(P_NOSELL, 1);
}

public void set_extra_look(string str) {
    extra_look = str;
    return;
}

public string extra_look() {
    return extra_look+"\n";
}

public void set_timeout(int duration) {
    while(find_call_out("remove") != -1) remove_call_out("remove");
    call_out("remove", duration, 1);
}

public void set_end_message(string message) {
    endMessage = message;
}

public int remove(int silent) {
    if(stringp(endMessage) && objectp(environment(this_object()))) {
        tell_object(environment(this_object()), BS(endMessage));
        environment(this_object())->UpdateAttributes();
    }

    return ::remove(silent);
}
