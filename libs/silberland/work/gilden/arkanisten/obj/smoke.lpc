
#include "../waechter.h"

inherit "std/thing";

object caster;
int chance;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_INVIS, 0);
  SetProp(P_NOGET, "Deine Haende gleiten durch die Rauchwolke.");

  AddId(({GADGET_ID, SMOKE_BOMB_ID, "wolke", "rauchwolke"}));
}

public string _query_short() {
    if(!objectp(caster)) {
        remove(1);
        return "";
    }

    if(TP == caster) return "Eine Rauchwolke vernebelt die Sicht auf dich";
    return sprintf("Eine Rauchwolke vernebelt deine Sicht auf %s", caster->name(WEN));
}

public string _query_long() {
    if(!objectp(caster)) {
        remove(1);
        return "";
    }

    return sprintf("Eine Rauchwolke vernebelt deine Sicht auf %s", caster->name(WEN));
}


public void setup(object user, int ability, int success) {
    caster = user;
    chance = ability/666 + success/2000 + user->QueryAttribute(A_DEX) / 10;
    call_out("turn_off", ability/500 + success/800);
    caster->AddDefender(TO);
    call_out("check_presence", 2);
    return;
}

public void turn_off() {
    tell_object(ENV(TO), BS("Die Rauchwolke um dich lichtet sich."));
    tell_room(ENV(TO), BS("Die Rauchwolke um "+caster->name(WEN)+" lichtet sich."));
    remove(1);
    return;
}


public void check_presence() {
    if(!present(caster, ENV(TO))) {
        turn_off();
    }
    call_out("check_presence", 2);
    return;
}

public void NotifyPlayerDeath(object pl) {
    if(pl == ENV(TO)) {
        turn_off();
    }
    return;
}

public mixed DefendOther(int dam,mixed dam_type,mixed spell,object enemy) {
    if(dam > 0 && random(100) < chance && objectp(enemy)) {
        tell_object(enemy, BS("Du kannst "+caster->name(WEN)+" in der Rauchwolke nicht ausmachen."));
        tell_object(caster, BS(enemy->Name(WER)+" kann dich in der Rauchwolke verborgen nicht erwischen."));
        tell_room(ENV(caster), BS(caster->Name(WER)+" ist in der Rauchwolke nicht zu erkennen."), ({caster, enemy}));
        return ({0, dam_type, spell});
    }

    return ({dam, dam_type, spell});
}