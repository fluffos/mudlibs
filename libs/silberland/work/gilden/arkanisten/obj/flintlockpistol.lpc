
#include "../waechter.h"

inherit "std/weapon";

object owner;
int ability;

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_LONG,
        "Die Steinschlosspistole ist eine mechanische Weiterentwicklung der Armbrust. Statt Bolzen "
        "ueber das Spannen einer Sehne zu verschiessen, wird eine kleine Explosion von "
        "Schwarzpulver genutzt, um eine kleine Bleikugel zu verschiessen. Sie ist langsamer "
        "als die Handarmbrust, kann dafuer Ruestungen besser durchschlagen." );
  SetProp(P_INFO, "Diese Waffe kann nur von Mitgliedern des Waechterordens korrekt bedient werden.");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"pistole", "steinschlosspistole", PISTOL_ID, CAN_EXPLOSIVE_AMMO_ID}) );

  SetProp(P_WEAPON_TYPE, WT_BOW );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON: 80, MAT_WOOD: 10, MAT_GUNPOWDER: 10]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 300);
  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:20]) );
  
  SetProp(P_UNWIELD_TEXT, ({"Du steckst %s in dein Bandolier.\n", " steckt %s weg.\n"}));
  SetProp(P_WIELD_TEXT, ({"Du ziehst %s aus deinem Bandolier.\n", " zieht %s hervor.\n"}));

  SetProp(P_NOGET, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

public string _query_name() {
    if(!objectp(owner)) return "Steinschlosspistole";

    return owner->Name(WESSEN)+" Steinschlosspistole";
}

public string _query_short() {
    if(!objectp(owner)) return "Eine Steinschlosspistole";

    return owner->Name(WESSEN)+" Steinschlosspistole";
}

public void setup(object caster) {
    owner = caster;
}

int WieldFunc(object waffe) {
    if(waffe != TO) return 0;
    if(!ABILITY_SERVICE->get_ability_by_name(FLINTLOCK_PISTOL)->has_learned(TP)) {
        tell_object(TP, BS("Du kannst mit so einer Waffe doch gar nicht umgehen!"));
        remove(1);
        return 0;
    }
    
    tell_object(owner, BS("Du steckst eine Bleikugel in den Lauf deiner Pistole und fuellst die Pulverkammer."));

    if(!mappingp(owner->QuerySkill(SK_FIGHT))) {
        owner->ModifySkill(SK_FIGHT, ([SI_SKILLABILITY: 0, SI_SKILLFUNC: "Kampfskill"]), 100, "waechter");
    }

    present(GUILD_OBJ_ID, owner)->AddAttackAbility(FLINTLOCK_PISTOL);
    return 1;
}

int UnwieldFunc(object waffe) {
    present(GUILD_OBJ_ID, owner)->RemoveAttackAbility(FLINTLOCK_PISTOL);
    call_out("remove", 0, 1);
    return 1;
}

varargs public int remove(int silent) {
    if(present(PISTOLERO_OFFHAND_ID, ENV(TO))) {
        present(PISTOLERO_OFFHAND_ID)->remove(silent);
    }
    return ::remove(silent);
}


public int _query_wc() {
    if(!objectp(owner)) return 0;
    return owner->QuerySkillAbility(FLINTLOCK_PISTOL) / 100;
}

public string* _query_dam_type() {
    return ({DT_PIERCE, DT_BLUDGEON});
}