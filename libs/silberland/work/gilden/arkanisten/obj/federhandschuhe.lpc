
#include "../waechter.h"

inherit "std/armour";

object owner;

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_LONG,
        "Die federmechanischen Handschuhe sind aus festem Leder "
        "gefertigt und mit Messing- und Stahlplatten an den Knöcheln "
        "verstärkt. In ihrem Inneren verborgene Federmechanismen spannen "
        "sich bei jeder Faustbewegung und setzen beim Schlag eine explosive "
        "zusätzliche Energie frei. Ein leises Zischen und das mechanische "
        "Klicken begleiten jede Bewegung, bevor der verstärkte Hieb mit "
        "verheerender Wucht zuschlägt. Diese Mischung aus präziser Ingenieurskunst "
        "und brutaler Effektivität macht die Handschuhe zu einer gefürchteten "
        "Waffe, die rohe Stärke und technischen Einfallsreichtum vereint." );
  SetProp(P_INFO, BS("Diese Handschuhe verstaerken die Hiebe deiner Faeuste. Sie koennen nur von Mitgliedern des Waechterordens genutzt werden.") );
  SetProp(P_GENDER, MALE);
  AddId( ({SPRINGLOADED_GLOVES_ID, "handschuhe"}) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_MATERIAL, ([ MAT_IRON: 80, MAT_BRASS: 10, MAT_IRON: 5, MAT_LEATHER: 5]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: GUILD]) );
}

public string _query_name() {
    if(!objectp(owner)) return "Handschuhe";

    return owner->Name(WESSEN)+" Handschuhe";
}

public string _query_short() {
    if(!objectp(owner)) return "Ein paar federmechanischer Handschuhe";

    return owner->Name(WESSEN)+" Paar federmechanischer Handschuhe";
}

public void setup(object caster) {
    owner = caster;
}


int WearFunc(object me) {
    if(me != TO) return 0;
    if(!ABILITY_SERVICE->get_ability_by_name(TESLA_BATON)->has_learned(TP)) {
        tell_object(TP, BS("Du kannst mit so einem Ding doch gar nicht umgehen!"));
        remove(1);
        return 0;
    }
    
    tell_object(owner, BS("Du spannst probehalber die Faeuste und hoerst das Zischen des Federmechanismus in den Handschuhen."));

    if(!mappingp(owner->QuerySkill(SK_FIGHT))) {
        owner->ModifySkill(SK_FIGHT, ([SI_SKILLABILITY: 0, SI_SKILLFUNC: "Kampfskill"]), 100, "waechter");
    }

    present(GUILD_OBJ_ID, owner)->AddAttackAbility(SPRINGLOADED_GLOVES);
    return 1;
}

int RemoveFunc(object me) {
    if(me != TO) return 0;
    tell_object(owner, BS("Du steckst Handschuhe zurueck ins Bandolier."));
    present(GUILD_OBJ_ID, owner)->RemoveAttackAbility(SPRINGLOADED_GLOVES);

    call_out("remove", 0, 1);
  return 1;
}

public int _query_ac() {
    if(!objectp(owner)) return 0;
    return owner->QuerySkillAbility(TESLA_BATON) / 2000;
}