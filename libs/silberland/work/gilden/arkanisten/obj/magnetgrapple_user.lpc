
#include "../waechter.h"

inherit "std/thing";

object victim;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_INVIS, 1);
  AddId(({GADGET_ID, MAGNET_GRAPPLE_ID,}));
}


public void setup(object _victim, int ability, int success) {
    victim = _victim;
    call_out("turn_off", ability/500 + success/800);
    call_out("check_presence", 2);
    SetProp(P_X_ATTR_MOD, ([A_DEX: -4 + ability/2500]));
    ENV(TO)->UpdateAttributes();
    return;
}

public void turn_off() {
    tell_object(ENV(TO), BS("Du laesst deinen Gegner wieder los als die Magneten aufhoeren zu Surren."));
    if(objectp(victim)) tell_room(ENV(TO), BS(ENV(TO)->Name(WER)+" laesst "+victim->name(WEN)+" wieder los als das Surren verstummt."), ({ENV(TO)}));
    if(present(MAGNET_GRAPPLE_ID, victim)) present(MAGNET_GRAPPLE_ID, victim)->remove(1);
    remove(1);
    return;
}


public void check_presence() {
    if(!present(victim, ENV(ENV(TO))) || !ENV(TO)->InFight()) {
        turn_off();
    }
    call_out("check_presence", 2);
    return;
}

public void NotifyPlayerDeath(object pl) {
    if(pl == ENV(TO)) {
        turn_off();
    }
    return;
}
