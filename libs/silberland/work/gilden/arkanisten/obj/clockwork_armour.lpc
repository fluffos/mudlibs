
#include "../waechter.h"

inherit "std/armour";

object owner;

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_LONG,
        "Die Uhrwerkruestung ist eine raffinierte Brustplatte aus beweglichen "
        "Messing- und Stahlplatten, die mit einem Uhrwerkmechanismus versehen ist. "
        "Im Ruhezustand kompakt, entfaltet sie sich auf Knopfdruck in einem praezisen "
        "Zusammenspiel von Zahnraedern und Scharnieren. Binnen Sekunden umschliesst sie "
        "den Oberkoerper des Traegers, bietet robusten Schutz und passt sich perfekt an, "
        "ohne die Beweglichkeit stark zu beeintraechtigen." );
  SetProp(P_INFO, BS("Diese Ruestung kann nur von Mitgliedern des Waechterordens getragen werden.") );
  SetProp(P_GENDER, MALE);
  AddId( ({CLOCKWORK_ARMOUR_ID, "ruestung", "uhrwerkruestung", "NODESTRUCT"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_MATERIAL, ([ MAT_IRON: 80, MAT_BRASS: 10, MAT_IRON: 5, MAT_LEATHER: 5]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 999);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: GUILD]) );
}

public string _query_name() {
    if(!objectp(owner)) return "Uhrwerkruestung";

    return owner->Name(WESSEN)+" Uhrwerkruestung";
}

public string _query_short() {
    if(!objectp(owner)) return "Eine Uhrwerkruestung";

    return owner->Name(WESSEN)+" Uhrwerkruestung";
}

public void setup(object caster) {
    owner = caster;
}


int WearFunc(object me) {
    if(me != TO) return 0;
    if(!ABILITY_SERVICE->get_ability_by_name(CLOCKWORK_ARMOUR)->has_learned(TP)) {
        tell_object(TP, BS("Du kannst mit so einem Ding doch gar nicht umgehen!"));
        remove(1);
        return 0;
    }
    
    tell_object(owner, BS("Klackernd und ratternd schliesst sich das Uhrwerk um dich. Ein leises Ticken zeigt, dass die Ruestung bereit ist."));
    ABILITY_SERVICE->get_ability_by_name(CLOCKWORK_ARMOUR)->register_defensive_ability(TP);
    return 1;
}

int RemoveFunc(object me) {
    if(me != TO) return 0;
    tell_object(owner, BS("Surrend und klackernd zieht sich die Uhrwerkruestung in dein Bandolier zurueck."));
    ABILITY_SERVICE->get_ability_by_name(CLOCKWORK_ARMOUR)->unregister_defensive_ability(TP);
    call_out("remove", 0, 1);
  return 1;
}

public int _query_ac() {
    if(!objectp(owner)) return 0;
    return owner->QuerySkillAbility(CLOCKWORK_ARMOUR) / 250;
}
