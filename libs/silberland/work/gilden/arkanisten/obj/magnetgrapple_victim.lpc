
#include "../waechter.h"

inherit "std/thing";

object victim;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_INVIS, 1);
  AddId(({MAGNET_GRAPPLE_ID,}));
}

private int get_metal(object ob) {
    return ob->QueryMaterial(MAT_MISC_METAL) +
           ob->QueryMaterial(MAT_IRON) +
           ob->QueryMaterial(MAT_STEEL) +
           ob->QueryMaterial(MAT_COPPER) +
           ob->QueryMaterial(MAT_BRONCE) +
           ob->QueryMaterial(MAT_BRASS) +
           ob->QueryMaterial(MAT_TIN) +
           ob->QueryMaterial(MAT_LEAD) +
           ob->QueryMaterial(MAT_TITANIUM) +
           ob->QueryMaterial(MAT_MERCURY) +
           ob->QueryMaterial(MAT_ALUMINIUM) +
           ob->QueryMaterial(MAT_TUNGSTEN) +
           ob->QueryMaterial(MAT_COBALT) +
           ob->QueryMaterial(MAT_IRIDIUM);
}

public void setup(int ability, int success) {
    int malus, metal, inventory_metal;
    object v, *inventory, item;

    v = ENV(TO);

    // Calculate initial malus
    malus = -ability / 1000 - success / 10000;
    malus = (int)(malus * (1.0 + get_metal(v) / 100));

    // Check the inventory of 'v' for metal items
    inventory = all_inventory(v); // Get all objects in the inventory
    inventory_metal = 0;

    foreach (inventory, item, {
        if (item) {
            inventory_metal += get_metal(item);
        }
    });

    // Adjust malus based on inventory metal
    malus = (int)(malus * (1.0 + inventory_metal / 100));

    // Apply the malus as a dexterity modifier
    SetProp(P_X_ATTR_MOD, ([A_DEX: malus, A_STR: malus / 3]));
    ENV(TO)->UpdateAttributes();


    call_out("remove", ability/500 + success/800, 1);
    return;
}
