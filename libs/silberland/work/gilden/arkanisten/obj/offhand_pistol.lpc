
#include "../waechter.h"

inherit "std/armour";

object owner;

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_LONG,
    "Die Steinschlosspostiole ist eine mechanische Weiterentwicklung der Armbrust. Statt Bolzen "
    "ueber das Spannen einer Sehne zu verschiessen, wird eine kleine Explosion von "
    "Schwarzpulver genutzt, um eine kleine Bleikugel zu verschiessen. Sie ist langsamer "
    "als die Handarmbrust, kann dafuer Ruestungen besser durchschlagen." );
  SetProp(P_GENDER, FEMALE);
  AddId( ({PISTOLERO_OFFHAND_ID, "pistole", "steinschlosspistole"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_MATERIAL, ([MAT_IRON: 80, MAT_WOOD: 10, MAT_GUNPOWDER: 10]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: GUILD]) );

  SetProp(P_WEAR_TEXT, ({"Du zueckst die Steinschlosspistole in der zweiten Hand.\n", " zueckt eine zweite Steinschlosspistole.\n"}));
  SetProp(P_UNWEAR_TEXT, ({"Du steckst die Steinschlosspistole in dein Bandolier.\n", " steckt eine Steinschlosspistole in das Bandolier.\n"}));
}

public string _query_name() {
    if(!objectp(owner)) return "Steinschlosspistole";

    return owner->Name(WESSEN)+" Steinschlosspistole";
}

public string _query_short() {
    if(!objectp(owner)) return "Eine Steinschlosspistole";

    return owner->Name(WESSEN)+" Steinschlosspistole";
}

public void setup(object caster) {
    owner = caster;
}


int WearFunc(object me) {
    if(me != TO) return 0;
    if(!ABILITY_SERVICE->get_ability_by_name(PISTOLERO_STANCE)->has_learned(TP)) {
        tell_object(TP, BS("Du kannst mit so einem Ding doch gar nicht umgehen!"));
        remove(1);
        return 0;
    }

    if(!objectp(present(PISTOL_ID, TP))) {
        tell_object(TP, BS("Du kannst die zweite Pistole nur nutzen, wenn du eine in der andern Hand hast."));
        remove(1);
        return 0;
    }
    return 1;
}

int RemoveFunc(object me) {
    call_out("remove", 0, 1);
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
    object ab;
    int skill;

    skill = owner->QuerySkillAbility(PISTOLERO_STANCE);

    if(!random(20-(skill/1000))) {
        tell_object(owner, BS("Du feuerst beide Pistolen gleichzeitig ab."));
        tell_room(ENV(owner), BS(owner->Name(WER)+" feuert beide Pistolen gleichzeitig ab."), ({owner}));
        owner->ModifySkillAttribute(TO, SA_SPEED, 200, 2);
    }

    return 0;
}

public int _query_ac() {
    return 0;
}