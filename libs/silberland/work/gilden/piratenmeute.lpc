//wird am Ende der Beitrittsequenz von Roger aufgerufen
int beitreten(object neuling)
{

	if(::beitreten()<0) return 1; //wenn er nicht beitreten kann
		
	neuling->SetProp(P_TITLE, 0);
	
	RogerX(neuling->name()+" ist gerade der Piratenmeute beigetreten.");
	
	if((!IS_LEARNER(neuling)||(getiuid(neuling)=="yondala"))
		BSGMASTER->NeuesMitglied(getuid(neuling));
	DO_LOG_EINAUS("eingetreten");
	neuling->SetProp(P_GUILD_LEVEL, 1);
	DO_LOG_ADVANCED(1);
	return;
}

//Hier wird die Stufe erhoeht
mixed advance(string str)
{
	mixed r1 r2;
	notify_fail("Syntax: erhoehe <spieler|gilde>\n");
	
	if(!present("roger_schwarzbart", this_object()))
	{
		write("Das geht nur, wenn Roger Schwarzbart hier ist.\n"+
		"teile Roger mit Ich moechte eine Piratenangelegenheit besprechen");
		return 1;
	}
	
	if(!str) return 0;
	if(str!="spielerstufe"&&str!="spieler"&&str!="gilde"&&str!="gildenstufe") return 0;
	if(str=="gilde"||str=="gildenstufe")
	{
		if(!(TP->QueryProp(P_GUILD)=="piratenmeute"))
		{
			write("Roger sagt: Hier koennen nur Piraten ihre Stufe erhoehen. Verschwinde!\n");
			return 1;
		}
		if(TP->QueryProp(P_GUILD_LEVEL)==10)
		{
			write("Roger sagt: Weiter koennt Ihr nicht aufsteigen, "+TPN+".\n");
			return 1;
		}
		r1=gilden_ob::try_advance();
		if(r1)
		{
			adjust_title(TP);

			write("Roger sagt: Herzlichen Glueckwunsch, Du bist nun "+TPN+" "+TP->QueryProp(P_TITLE)+"!\n");
			//
			ROGERX( +TPN+" ist nun "+TP->QueryProp(P_TITLE));
			
			//rufe in Roger die allgemeine sequenz-Funktion auf, uebergebe Spieler und Level
			//Die Funktion muss noch geschrieben werden
			present("roger_schwarzbart", this_object())->sequenz(TP,TP->QueryProp(P_GUILD_LEVEL));			

			DO_LOG_ADVANCED(TP->QueryProp(P_GUILD_LEVEL));
			return r1;
		}
	}
	else
	{
		r2=gilde::advance();
		return r2;
	}
	return r1;
}


