		//Hier noch dem Spieler eine Papageinleiche geben
		//mit der Leiche im Inv wird er von allen als Verraeter erkannt und angegriffen
		say("Roger tritt "+TPN+" den Papagei von der Schulter.\n",this_player());
		ob->remove();
	}

//Auf der Ebene bekannt geben
	ROGERX(TPN+" ist nun ein Verraeter. TOETET "+upperstring(TP->QueryPronoun())+"!");
	
