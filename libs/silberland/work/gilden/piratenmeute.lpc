string SkillText(string sp)
{
	int w, lev, rlev;
	string s, fr, levst;
	fr="..............................................";
	rlev=this_player()->QueryProp(P_GUILD_LEVEL);
	if(sp!="GESAMT") w=this_player()->QuerySkillAbility(sp);
	else w=this_player()->QueryProp(P_GUILD_RATING);
	s=sp+extract(fr,0,15-strlen(sp));
	levst=lower_case(extract(s,0,9));
	switch(levst)
	{
		case "GESAMT....":{lev=0;break;}
		case "beurteile.":{lev=1;break;}
		case "muenzwurf.":{lev=1;break;}
		case "trete.....":{lev=2;break;}
		case "zerlege...":{lev=3;break;}
		case "herstellen":{lev=3;break;}
		case "kinnhaken.":{lev=3;break;}
		case "taenzeln..":{lev=4;break;}
		case "improvisie":{lev=4;break;}
		case "rueckschla":{lev=5;break;}
		case "vergleiche":{lev=5;break;}
		case "repariere.":{lev=6;break;}
		case "rundumschl":{lev=6;break;}
		case "verbessere":{lev=7;break;}
		case "yohoho....":{lev=7;break;}
		case "versklave.":{lev=8;break;}
		case "fokussiere":{lev=9;break;}
		case "schlachtru":{lev=9;break;}
		case "beschuetze":{lev=10;break;}
		case "verbinde..":{lev=10;break;}

	}
	
	s="";
	//holt sich hier den "Koennentext" aus dem Array bez (oben definiert)
	//vermutlich ist die 500 nicht richtig, weil auf mehr Koennenabstufungen ausgerichtet.
	//TESTEN!
	if(w) s+=bez[w/500];
	else{
		if(rlev<lev)
		{
			s+="Ab Gildenlevel "+lev+"!    ";
			if(lev<10)s+=" ";
		}
		else s+="NOCH NICHT GELERNT!    ";
	}
	return s;	
}


