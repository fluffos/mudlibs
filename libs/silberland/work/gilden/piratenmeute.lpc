	/*
*/
int bei_oder_austreten(string str)
{
	notify_fail("Wem oder was moechtest Du beitreten?\n");
	if(str=="piraten bei"||str=="piratenmeute bei"||str=="meute bei")
	{
		if(!present("roger",this_object()))
		{
			write("Das geht nur, wenn Roger da ist.\n");
			return 1;
		}
		else//Roger ist da
		{
			if((TP->QueryProp(P_GUILD)=="piratenmeute")) write("Du bist doch schon Pirat.\n");
			else write("sag Ich moechte Pirat werden, wenn Du Pirat werden moechtest.\n");
			return 1;
		}
	}
	return 0;
	
}
