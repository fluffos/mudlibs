
#include "/d/ebene/zordan/ogerhoehle/def.h"

inherit "/gilden/abenteurer";

#include <properties.h>
#include <language.h>

string Funktion();

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine helle Ecke" );
  SetProp( P_INT_LONG,
    "Du kommst in eine seltsame Ecke der Hoehle. Hier liegen quer verstreut "
    "dutzende von abgenagten Knochen herum. Zwischen vier grossen Fackelhaltern "
    "ist ein Podest aufgestellt worden. Direkt hinter dem Podest stehen zwei "
    "Oger und stehen wohl Wache. Ein kleines Schild neben einer Uhr deutet an, "
    "was Du hier als Oger machen kannst!" );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  // aufraeumen
  SetProp(P_DETAILS, ([]) );
  RemoveExit("westen");

  AddDetail( ({ "decke" }),
    "Die Decke ist ziemlich hoch, aber ziemlich glatt.");

  AddDetail( ({ "waende","wand" }),
    "An den Waenden stehen ein paar Statuen. Ansonsten sind sie aus "
    "glattem Fels.");

  AddDetail( ({ "statuen" }),
    "Die Statuen zeigen verschiedene Kaempfe. Eine Statue faellt Dir "
    "besonders auf.");

  AddDetail( ({ "statue" }),
    "Die kleine Statue scheint ueber die Zukunft zu richten.");

  AddDetail( ({ "zukunft" }),
    "Ueber die Zukunft kann nur ein Gott richten.");

  AddDetail( ({ "gott" }),
    "Hier spuert man seine Anwesenheit nicht sehr. Dazu musst Du einen "
    "anderen Teil der Hoehle aufsuchen.");

  AddDetail( ({ "teil" }),
    "Den musst Du schon selber finden. Sehen kannst Du ihn von hier aus "
    "nicht.");

  AddDetail( ({ "anwesenheit" }),
    "Sie ist schon zu spueren. Aber nicht sehr.");

  AddDetail( ({ "kampf","kaempfe" }),
    "Sie zeigen Oger, wie sie andere Staedte ueberfallen und ausrauben.");

  AddDetail( ({ "staedte","stadt","rassen","rasse" }),
    "Die meisten Rassen wohnen in einer Stadt. Aber nicht die Oger.");

  AddDetail( ({ "fels" }),
    "Heller Fels, wie sonst auch ueberall in der Hoehle hier.");

  AddDetail( ({ "podest" }),
    "Das Podest besteht aus Stein und ist einfach nur gigantisch gross. In "
    "ihm sitzt wohl normalerweise eine hohe Persoenlichkeit. Ein paar "
    "Zeichen sind auf dem Podest eingraviert worden.");

  AddDetail( ({ "stein" }),
    "Harter Stein. Fast so hart wie die Haut eines Ogers.");

  AddDetail( ({ "haut" }),
    ([ 0:      "Deine Haut ist eher zierlich.",
       "oger": "Deine Haut ist hart wie Stein.",
       "troll":"Deine Haut ist haerter als Stein." ]) );

  AddDetail( ({ "harz" }),
    "Das ist ganz normales Harz wie man es von ueberall her kennt. Auffaellig "
    "ist vielleicht nur, dass es rot ist.");

  AddDetail( ({ "zeichen" }),
    "Die Zeichen zeigen Oger im Kampf und wie sie ihre Opfer danach "
    "aufessen.");

  AddDetail( ({ "opfer" }),
    ([ 0:       "Du kannst Dir fast sicher sein, keines von ihnen zu sein.",
       "mensch":"Als Mensch hast Du staendig Angst, dass Dich ein Oger "
                "ueberfaellt und auffrisst." ]) );

  AddDetail( ({ "mensch","angst" }),
    "Du hast Angst!");

  AddDetail( ({ "fackelhalter","halter" }),
    "Die riesigen Fackelhalter stehen um das Podest herum und erhellen mit "
    "ihren grossen Fackeln die Hoehle sehr stark. Sie sind ziemlich grob "
    "hergestellt worden und aus Metall.");

  AddDetail( ({ "fackel","fackeln" }),
    "Grosse Fackeln aus Harz erhellen diese Hoehle sehr stark.");

  AddDetail( ({ "metall","art" }),
    "Du kannst die Art des Metalls nicht genau ausmachen. Aber irgendwie "
    "scheint es gar nicht mal so wertlos zu sein. Es schimmert ein wenig "
    "gelb durch.");

  AddDetail( ({ "gold" }),
    "Richtig. Die Fackelhalter sind tatsaechlich aus Gold!");

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "ecke" }),
    "Hier scheint eine hohe Persoenlichkeit zu wohnen.");

  AddDetail( ({ "persoenlichkeit" }),
    "Dabei handelt es sich wohl um den Anfuehrer der Oger.");

  AddDetail( ({ "oger" }),
    "Die Oger stehen Wache.");

  AddDetail( ({ "wache","wachen" }),
    "Sie passen wohl auf den Anfuehrer auf. Sie regen sich nicht und geben "
    "auch keinen Laut von sich.");

  AddDetail( ({ "laut" }),
    "Den koennte man hoeren, wenn er denn da waere.");

  AddDetail( ({ "anfuehrer" }),
    "Ist er gerade nicht da?");

  AddDetail( ({ "boden" }),
    "Der Boden ist uebersaet mit vielen abgenagten Knochen.");

  AddDetail( ({ "knochen" }),
    "Bei den abgenagten Knochen handelt es sich wohl um Menschenknochen.");

  AddDetail( ({ "menschenknochen" }),
    ([ 0:     "Dich ekelt es bei diesem Gedanken.",
       "oger":"Als Du Dir die Knochen naeher ansiehst, musst Du sofort an "
              "Beorn denken." ]) );

  AddDetail( ({ "beorn","koch" }),
    "Beorn ist doch Euer Koch.");

  AddDetail( ({ "gedanken","gedanke" }),
    "Du machst Dir besser keine weiteren darueber. Sonst fluechtest Du nachher "
    "noch.");

  AddSound( DEFAULT_SOUND,
    "Die Wachen geben nicht einen Laut von sich.");
    
  AddSound( "laut",
    "Davon ist keiner zu hoeren!");
    
  AddSound( ({ "wache","wachen" }) ,
    "Davon ist keiner zu hoeren!");
    
  AddSmell( DEFAULT_SMELL,
    ([ 0:     "Es riecht ekelhaft und abstossend hier.",
       "oger":"Der Geruch nach Menschfleisch entzueckt Deine Nase." ]) );

  AddSmell( "geruch",
    ([ 0:     "Haeh?",
       "oger":"Es riecht himmlisch nach frischem Menschenfleisch." ]) );

  AddSmell( ({ "fleisch","menschenfleisch" }),
    ([ 0:     "Haeh?",
       "oger":"Als Du das Fleisch riechst, bekommst Du sofort wieder Hunger." ]) );

  AddSpecialDetail("uhr","zeige_reboot");
  AddDetail(({"funktion", "schild"}), #'Funktion);
  AddReadDetail(({"funktion", "schild"}), #'Funktion);

  AddItem( NPC "grimow", REFRESH_DESTRUCT);
  RemoveItem( "/p/service/obj/zettel/zettelmaschine");
  
  AddCmd( ({"kosten", "wandle", "erhoehe", "lern", "lerne"}), "ogergilde");

//  AddExit( "sueden",  "./room_d4" );
  AddExit( "sueden",  "/d/ebene/zordan/ogerhoehle/room/room_d4" );
}

string GuildName() {
  return "abenteurer";
}

ogergilde(string str) {  
  string race;
  race = this_player()->QueryProp(P_RACE); 

  if (race != "Oger") {
    switch (race) {
      case "Dunkelelf":
        return notify_fail(BS(
          "Das hier ist die Ogergilde! Verzieh Dich boeser Dunkelelf!"));
      case "Zwerg":
        return notify_fail(BS(
          "Was willst Du denn als Mikrozwerg hier?"));
      case "Troll":
        return notify_fail(BS(
          "Wenn Du nicht sofort gehst wirst DU wohl bald gefressen!"));
      case "Mensch":
        return notify_fail(BS(
          "Geh lieber nach Midas, hier ist es viel zu heiss fuer Dich!"));
      case "Elf":
        return notify_fail(BS(
          "Oger fressen Elfen normalerweise nicht aber sicher kannst Du "
          "Dir nicht sein!"));
      case "Fee":
        return notify_fail(BS(
          "Eine mickrige Fee sollte lieber schnell wegfliegen!"));
      case "Hobbit":
        return notify_fail(BS(
          "Dein Fell moegen die Oger nur tragen!"));
      default:
        return notify_fail(BS(
          "Das ist die Ogergilde, da hast Du als "+race+
          " nichts zu suchen!\n"));
    }
  }
  switch(query_verb()) {
    case "kosten": return kosten(str);
    case "wandle": return change(str);
    case "erhoehe": return advance(str);
    case "lern":
    case "lerne": return OwnLearnSpell(str);
  }
}
