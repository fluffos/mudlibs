#include "/d/ebene/Gaffos/gaffos.h"

inherit "/gilden/abenteurer";

#include <properties.h>
#include <language.h>

void create() {
  ::create();

  SetProp(P_INT_SHORT, "Im Langhaus der Gaffos");
  SetProp(P_INT_LONG,
    "Du befindest dich im Langhaus der Gaffos, einem weitlaeufigen Raum, der von warmem Holz und "
    "handgefertigten Verzierungen gepraegt ist. Die Waende sind mit Bannzeichen gegen boese Magie "
    "und mystische Kreaturen versehen. Ein grosser, massiver Tisch dominiert die Mitte des Raumes, "
    "an dem sich die Gaffo-Abenteurer versammeln, um Plaene zu schmieden. Eine Tafel an der Wand "
    "zeigt wichtige Informationen, waehrend ein alter Kamin an der Ostseite wohlige Waerme spendet. "
    "Ein gefluegelter Banner mit dem Emblem der Gaffos haengt ueber dem Eingang und verleiht dem Raum "
    "eine ehrwuerdige Atmosphaere.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]));

  // Details
  AddDetail("langhaus", "Das Langhaus der Gaffos ist ein beeindruckendes Bauwerk aus massivem Holz mit kunstvollen Verzierungen.");
  AddDetail("waende", "Die Waende sind mit Bannzeichen und Schutzrunen versehen, um magische Gefahren abzuwehren.");
  AddDetail("tisch", "Ein grosser, schwerer Holztisch, an dem die Gaffos wichtige Plaene schmieden und Mahlzeiten teilen.");
  AddDetail("tafel", "Die Tafel zeigt wichtige Informationen fuer die Gaffo-Abenteurer. Du kannst sie lesen.");
  AddDetail("kamin", "Der Kamin an der Ostseite verbreitet Waerme und sorgt fuer eine gemuetliche Atmosphaere.");
  AddDetail("banner", "Ein stolzes Banner mit dem Emblem der Gaffos haengt ueber dem Eingang und symbolisiert ihre Einheit.");
  AddDetail("atmosphaere", "Die Atmosphaere im Langhaus ist ehrwuerdig und zugleich gemuetlich.");
AddDetail("bannzeichen", "Die Bannzeichen an den Waenden schuetzen vor dunkler Magie und gefaehrlichen Kreaturen.");
AddDetail("bauwerk", "Das Langhaus ist ein stattliches Bauwerk aus robustem Holz, das den Gaffos Schutz bietet.");
AddDetail("duft", "Ein angenehmer Duft von frischem Holz und Gewuerzen liegt in der Luft.");
AddDetail("eingang", "Der Eingang wird von einem majestaetischen Banner mit dem Emblem der Gaffos geziert.");
AddDetail("einheit", "Das Banner symbolisiert die starke Einheit und den Zusammenhalt der Gaffos.");
AddDetail("emblem", "Das Emblem der Gaffos auf dem Banner zeigt den Stolz und die Staerke ihres Volkes.");
AddDetail("feuer", "Das Knistern des Feuers im Kamin erfuellt den Raum mit einem beruhigenden Geraeusch.");
AddDetail("gaffo", "Die Gaffos sind ein tapferes und stolzes Volk von Abenteurern.");
AddDetail("gaffos", "Die Gaffos widmen sich dem Schutz ihres Volkes und der Bekaempfung dunkler Maechte.");
AddDetail("gefahren", "Die Bannzeichen und Runen sollen vor magischen Gefahren und mystischen Bedrohungen schuetzen.");
AddDetail("gemurmel", "Leises Gemurmel von Gespraechen ist aus dem Raum zu hoeren.");
AddDetail("gespraeche", "In den Gespraechen geht es um Abenteuer, Herausforderungen und die Sicherheit der Gaffos.");
AddDetail("holztisch", "Der massive Holztisch ist der Mittelpunkt des Raumes, an dem Plaene geschmiedet werden.");
AddDetail("informationen", "Die Tafel zeigt stets aktuelle Informationen fuer die Gaffo-Abenteurer.");
AddDetail("knistern", "Das Knistern des Feuers im Kamin sorgt fuer eine warme und einladende Atmosphaere.");
AddDetail("kreaturen", "Die Schutzrunen an den Waenden bewahren vor gefaehrlichen Kreaturen.");
AddDetail("luft", "Die Luft ist frisch, vermischt mit dem Duft von Holz und speziellem Essen.");
AddDetail("magie", "Die Bannzeichen schuetzen vor schwarzer Magie und Zauberangriffen.");
AddDetail("mahlzeiten", "Mahlzeiten werden oft an dem grossen Tisch geteilt und besprochen.");
AddDetail("mitte", "In der Mitte des Raumes steht der grosse Tisch, der die Gaffos zusammenfuehrt.");
AddDetail("plaene", "An diesem Tisch werden wichtige Plaene und Strategien entwickelt.");
AddDetail("schutzrunen", "Die Runen an den Waenden bieten magischen Schutz vor dunklen Kraeften.");
AddDetail("speisen", "Leicht gewuerzte Speisen und der Duft von frisch zubereitetem Essen liegen in der Luft.");
AddDetail("verzierungen", "Die handgefertigten Verzierungen an Waenden und Moebeln zeugen vom Kunsthandwerk der Gaffos.");
AddDetail("waerme", "Die Waerme des Kamins sorgt fuer eine gemuetliche Atmosphaere im Raum.");
AddDetail("atmosphaere", "Die Atmosphaere im Langhaus ist ehrwuerdig und zugleich gemuetlich.");
AddDetail("bedrohungen", "Die Schutzrunen und Bannzeichen sollen die Gaffos vor dunklen Bedrohungen bewahren.");
AddDetail("bekaempfung", "Die Gaffos kaempfen gegen magische Bedrohungen und mystische Maechte.");
AddDetail("essen", "Leckere, leicht gewuerzte Speisen werden hier oft geteilt und genossen.");
AddDetail("geraeusch", "Das sanfte Knistern des Feuers und das Murmeln von Gespraechen fuellen den Raum.");
AddDetail("gewuerzen", "Die Gerueche von Gewuerzen und frisch zubereitetem Essen durchziehen die Luft.");
AddDetail("herausforderungen", "Die Gaffos stellen sich grossen Herausforderungen, um ihr Volk zu schuetzen.");
AddDetail("kraeften", "Die Gaffos setzen ihre Kraefte ein, um ihre Heimat vor dunklen Maechten zu verteidigen.");
AddDetail("kunsthandwerk", "Das Kunsthandwerk in diesem Langhaus spiegelt die Fertigkeiten und den Stolz der Gaffos wider.");
AddDetail("maechte", "Die Gaffos bekaempfen finstere Maechte, die das Land bedrohen.");
AddDetail("mittelpunkt", "Der grosse Holztisch bildet den Mittelpunkt des Langhauses, an dem Plaene geschmiedet werden.");
AddDetail("moebeln", "Die Moebel im Langhaus sind robust und kunstvoll aus Holz gefertigt.");
AddDetail("runen", "Schutzrunen zieren die Waende, um vor magischen Gefahren zu schuetzen.");
AddDetail("schutz", "Der Schutz des Volkes steht an erster Stelle, und magische Schutzmassnahmen werden eingesetzt.");
AddDetail("sicherheit", "Das Langhaus bietet den Gaffos Sicherheit vor magischen Bedrohungen und Angriffen.");
AddDetail("staerke", "Die Staerke der Gaffos liegt in ihrem Zusammenhalt und der Bereitschaft, fuer ihr Volk zu kaempfen.");
AddDetail("stolz", "Stolz auf ihre Traditionen und ihre Staerke ist den Gaffos anzumerken.");
AddDetail("strategien", "An dem Tisch werden Strategien fuer die Abenteurer und ihre kommenden Herausforderungen besprochen.");
AddDetail("volk", "Das Volk der Gaffos ist tapfer und vereint in seiner Verteidigung gegen dunkle Maechte.");
AddDetail("volkes", "Der Zusammenhalt des Volkes ist die Grundlage fuer seine Staerke und Bestaendigkeit.");
AddDetail("zauberangriffen", "Die Bannzeichen schuetzen das Langhaus vor Zauberangriffen und magischen Angriffen.");
AddDetail("zusammenhalt", "Der Zusammenhalt der Gaffos ist unerschuetterlich und gibt ihnen die noetige Kraft gegen jede Bedrohung.");
AddDetail("angriffen", "Das Langhaus ist gut geschuetzt gegen Angriffe von aussen, insbesondere magische Angriffe.");
AddDetail("bedrohung", "Das Langhaus und seine Bewohner sind staendig Bedrohungen durch dunkle Maechte ausgesetzt.");
AddDetail("bereitschaft", "Die Gaffos zeigen stets eine hohe Bereitschaft, ihre Heimat gegen jede Bedrohung zu verteidigen.");
AddDetail("bestaendigkeit", "Die Bestaendigkeit des Langhauses symbolisiert die Unerschuetterlichkeit der Gaffos.");
AddDetail("fertigkeiten", "Die Fertigkeiten der Gaffos in Magieabwehr und Handwerkskunst sind unuebertroffen.");
AddDetail("gerueche", "Es liegen Geruechte ueber bevorstehende Bedrohungen in der Luft, die die Gaffos alarmieren.");
AddDetail("grundlage", "Die Grundlage fuer den Erfolg der Gaffos ist ihr Zusammenhalt und ihre unerschuetterliche Loyalitaet.");
AddDetail("heimat", "Das Langhaus ist ein sicherer Ort, der das Herz der Gaffos und ihrer Heimat symbolisiert.");
AddDetail("kraefte", "Die Gaffos buendeln ihre Kraefte, um gegen dunkle Maechte und Magie zu kaempfen.");
AddDetail("kraft", "Die Kraft der Gaffos liegt in ihrer Gemeinschaft und der Faehigkeit, Herausforderungen zu meistern.");
AddDetail("moebel", "Die Moebel im Langhaus sind aus robustem Holz gefertigt und passen zur Atmosphaere des Raumes.");
AddDetail("murmel", "Das Murmeln von Gespraechen und das Knistern des Feuers verleihen dem Raum eine beruhigende Atmosphaere.");
AddDetail("schutzmassnahmen", "Verschiedene Schutzmassnahmen wurden getroffen, um das Langhaus vor Bedrohungen zu schuetzen.");
AddDetail("traditionen", "Die Traditionen der Gaffos sind tief in ihrer Kultur verankert und werden mit Stolz bewahrt.");
AddDetail("verteidigung", "Die Verteidigung des Langhauses und der Siedlung ist den Gaffos heilig.");

  // Aktionen
  AddReadDetail("tafel", #'Funktion); //'

  // Sounds und Gerueche
  AddSound(DEFAULT_SOUND, "Das Knistern des Feuers im Kamin und das leise Gemurmel von Gespraechen erfuellen den Raum.");
  AddSmell(DEFAULT_SMELL, "Der Duft von Holz und leicht gewuerzten Speisen liegt in der Luft.");

  // Kommandos
  AddCmd(({"kosten", "wandle", "erhoehe", "lern", "lerne"}), "gaffogilde");

  // Exits
  AddExit("suedwesten", ROOM("weg_k4"));
  RemoveExit("westen");

  AddItem(NPC("obergaffo"), REFRESH_DESTRUCT);
}

string GuildName() {
  return "abenteurer";
}

gaffogilde(string str) {
  // Nur Mitglieder der Gaffos duerfen die Gilde nutzen
  if (this_player()->QueryProp(P_RACE) != "Gaffo") {
    notify_fail("Nur Mitglieder der Gaffo-Gemeinschaft koennen diese Gilde nutzen.\n");
    return 0;
  }
  switch (query_verb()) {
    case "kosten": return kosten(str);
    case "wandle": return change(str);
    case "erhoehe": return advance(str);
    case "lern":
    case "lerne": return OwnLearnSpell(str);
  }

  return 0;
}
