// Andracia

inherit "/gilden/abenteurer";

#include <properties.h>
#include <rooms.h>
#include <wizlevels.h>
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <new_skills.h>
#include <config.h>
#include <moredef.h>


string unt_bilder();
string unt_portraits();

//string raum = "/d/huegelland/yason/friedheim/room/burg/zs_burg_og3_a2.lpc";
string raum = "/d/andracia/yondala/friedheim/room/burg/zs_burg_og3_a2.lpc";

string *bilder =({
	"Hier haengt ein besonders schoenes Bild von Aboriville.",
	"Das Bild hier zeigt den erstaunlichen Marmorturm, den Sitz der Zaubererzunft.",
	"Dieses Panoramabild zeigt die Gebirge von Andracia.",
  "Dieses Bild zeigt die Burg Friedheim." });
string *portraits =({
	"Dieses Portrait zeigt den Freiherrn von Friedheim bei der Jagd.",
  "Das wunderbare Antlitz von Yondala, das hier im Portrait verewigt wurde, laesst Dein Herz hoeher schlagen.",
  "Diese Bild zeigt den Vorsteher der Zaubererzunft, Golith Kupferfeld.",
  "Die schreckliche Fratze Aginors, das dieses Bild zeigt, jagt Dir einen Schauer ueber den Ruecken."});


string GuildName() {
  return "abenteurer";
}

void init()
{
  ::init();
  // Sichergehen, dass sindar tucher auch geladen ist.
  if (interactive(this_player()))
  {
    catch(call_other( raum, "???"));
  }
}

void create()
{
  ::create();

  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"ab_spells");

  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );


  // wird alles inherited:
  /*
  AddSpell("blitz");
  AddSpell("identifiziere");
  AddSpell("schaetz");
  AddSpell("pfeil");
  AddSpell("ausweichen");
  AddSpell("feuerball");
  AddSpell("schnell");
  AddSpell("faustschlag");
  AddSpell("wuergen");
  */

/*  
  AddSpell("blitz");
  AddSpell("lichtkugel");
  AddSpell("vision");
  AddSpell("bruelle");
  AddSpell("identifiziere");
  AddSpell("schaetz");
  AddSpell("ausweichen");
  AddSpell("pupse");
  AddSpell("schnell");
  AddSpell("ruelpe");
  AddSpell("magiepfeil");
  AddSpell("trete");
  AddSpell("aufplustern");
  AddSpell("magiekugel");
  AddSpell("heile");
  AddSpell("wirf");
  AddSpell("ramme");
  AddSpell("teleportiere");
 */     

  SetProp(P_INT_SHORT,"Die Kapelle von Friedheim");
  SetProp(P_INT_LONG,
    BS("Du befindest Dich hier in der grossen Kapelle von Friedheim. Der hohe Raum "+
      "wird nur durch dicke Querbalken unterbrochen und durch hohe Fenster faellt buntes "+
      "Licht auf den steinernen Altar an der Nordwand. Zwischen den bunten Scheiben der "+
      "Fenster haengen an Ost- und Westwand Bilder, mit Zeichnungen und Gemaelde von "+
      "Andracia. Ueber dem Altar selbst haengt eine Tafel mit den Dienstleistungen die "+
      "man hier in der Kapelle erhalten kann. Sonst gibt es hier nur noch den Ausgang "+
      "in der Suedwand, welcher hinaus in das Dorf Friedheim fuehrt.") );

  AddDetail( ({"kapelle", "raum"}),
    BS("Du befindest Dich hier in der grossen Kapelle von Friedheim. Durch die bunten "+
    "Fenster faellt Licht auf den Altar und auf die darueber angebrachte Tafel. An den "+
    "Waenden nach Osten und Westen haengen viele Bilder mit allerlei Motiven aus Andracia. "+
    "Im Norden befindet sich der Ausgang hinaus in das Dorf Friedheim. ") );
  AddDetail( ({"friedheim", "dorf", "zentrum"}),
    BS("Du befindest Dich hier im Zentrum des Dorf Friedheim. In dieser Kapelle stehen "+
    "Dir viele Moeglichkeiten zur Verfuegung. Lies am besten die Tafel direkt ueber dem "+
    "Altar. ") );
  AddDetail( ({"balken", "querbalken" }),
    BS("Der Querbalken stuetzt die Ost- und Westwand. Ansonsten ist die Kapelle nur ein "+
    "grosser, hoher Raum. ") );
  AddDetail( ({"fenster", "scheiben", "glasscheiben", "licht", "farbe", "faerbung", "stimmung"}),
    BS("Die Fenster bestehen aus bunten Glasscheiben, zeigen aber keine Motive. Das Licht "+
    "erhaelt hier seine Faerbung und sorgt damit fuer eine angenehme Stimmung in diesem "+
    "ansonsten kargen Raum. ") );
  AddDetail( ({"altar", "granitblock"}),
    BS("Der Altar besteht aus einem grossen Granitblock. Eine Tafel haengt darueber und "+
    "gibt auskunft ueber die Dienstleistung die hier angeboten werden. ") );
  AddDetail( ({"nordwand"}),
    BS("An der Nordwand steht der Altar und darueber haengt eine Tafel. ") );
  AddDetail( ({"ostwand", "westwand"}),
    BS("Neben den bunten Scheiben haengen Zeichnungen und Bilder von Andracia an der Wand. ") );
  AddDetail( ({"suedwand", "ausgang"}),
    BS("Im Sueden befindet sich der Ausgang zum Dorf Friedheim. ") );
  AddDetail( ({"zeichnungen", "gemaelde", "bilder"}),
    BS("Die Zeichnungen zeigen verschiedenste Bereiche Andracias. Neben Landkarten und "+
    "Panoramabildern sind aber auch Portraits von bekannten Persoenlichkeiten Andracias zu finden. ") );
  AddDetail( ({"andracia", "land"}),
    BS("So einfach kann man dieses Land nicht untersuchen.") );
  AddDetail( ({"tafel", "dienstleistungen", "dienste", "dienstleistung", "moeglichkeiten"}),
    BS("Die Tafel ist mit allen Informationen beschriftet - daher hilft lesen eher.") );
  AddDetail( ({"boden"}),
    BS("Einfache Steinplatten bilden den Boden.") );
  AddDetail( ({"decke"}),
    BS("Die hohe Decke wurde hellblau gestrichen. Ansonsten kannst Du nicht interessantes an der Decke erkennen.") );
  AddDetail( ({"wand", "waende"}),
    BS("Welche Wand moechtest Du untersuchen?") );
  AddDetail( ({"informationen"}),
    BS("Lies doch am besten die Zeitung.") );
  AddDetail( ({"motive", "motiv"}),
    BS("Die bunten Fenster zeigen keine Motive. Es sind einfach nur bunte Scheiben. ") );
  AddDetail( ({"panoramabilder"}), #'unt_bilder );
  AddDetail( ({"portraits", "persoenlichkeiten"}), #'unt_portraits );
  AddDetail( ({"landkarten", "bereiche"}),
    BS("Leider hast Du keine solch guten Landkarten wie hier haengen.") );
  AddDetail( ({"steinplatten", "steinplatte"}),
    BS("Die Steinplatten, die den Boden hier bilden, sind schon sehr abgetreten. ") );

/*
  AddDetail( ({""}),
    BS("") );
*/

  AddReadDetail( ({"tafel", "dienstleistungen", "dienste", "dienstleistung", "moeglichkeiten"}),
      "Dir stehen hier folgende Dienstleistungen zur Verfuegung:\n"
		  "- liste [[nicht] geloest]\n"
		  "- erhoehe [stufe]\n"
		  "- kosten \n"
		  "- lerne <faehigkeit> \n"
		  "- wandle <attribut> in <attribut>\n" );


  RemoveExit();         // alle inherited Exits entfernen
  AddExit( "sueden", "/d/andracia/yondala/friedheim/room/dorf/friedheim_dorf_c4.lpc" );

//  AddCmd(({ "lerne", "lern" }), "OwnLearnSpell" );

  AddCmd("bete","bete");

  AddItem("/p/service/obj/zettel/zettelmaschine", REFRESH_REMOVE);
  //AddItem("/p/service/obj/party/board", REFRESH_REMOVE);

  // Damit Sindar Tucher geladen ist.
  catch(call_other( raum, "???"));

}

int bete() {
   write("Du haeltst eine kurze Andacht.\n");
   if (this_player()->QueryProp(P_GHOST))
   {
	write("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder aus.\n");
	say(this_player()->name()+" erscheint in koerperlicher Form.\n");
	this_player()->SetProp(P_GHOST,0);
   }
   return 1;
}

string unt_bilder() {
	return BS(bilder[random(sizeof(bilder))]);
}
string unt_portraits() {
	return BS(portraits[random(sizeof(portraits))]);
}
	
int bei_oder_aus_treten(string str) {
  return 0;
}

void adjust_title(object pl) {
  int lv;

  if (!pl || !IsGuildMember(pl))
    return;
  lv=pl->QueryProp(P_LEVEL);
  pl->SetProp(P_GUILD_LEVEL,lv);
  if (!lv) lv=1;
  pl->SetProp(P_GUILD_TITLE,get_new_title(lv, pl));
}

