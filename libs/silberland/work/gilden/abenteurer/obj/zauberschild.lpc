#include <properties.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>

inherit "std/armour";

private int _schutz, removing;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein schimmernder Zauberschild");
  SetProp(P_LONG,
    "Vor dir schwebt ein schimmernder Zauberschild, der sich immer in deine "
    "Blickrichtung bewegt. Er schuetzt dich vor boesartigen Zaubern und, "
    "zu einem kleineren Teil, vor koerperlichen Angriffen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Zauberschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"\nab_zauberschild", "schild", "zauberschild", "NODESTRUCT"}) );

  SetProp(P_NAME_ADJ, ({"schimmernder", "schimmernden", "schimmernden", "schimmerndem"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_NO_DAMAGE_DESTRUCT, 0);

  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_INFO, BS("Dieser Zauberschild schuetzt dich vor feindlichen Zaubern.") );
  removing = 0;
}

public void start(object caster, int dauer, int schutz) {
    _schutz = schutz;
    DoWear(1);
    call_out("remove", dauer);
}

public int remove(int silent) {
    removing = 1;
    if(!silent) {
        tell_object(ENV(TO), BS("Der schimmernde Zauberschild bricht zusammen."));
    }
    return ::remove(1);
}

int RemoveFunc(object me) {
    if(me != TO) return 0;
  if(!removing) remove();
  return 1;
}

int DefendFunc (mixed dam_type, mixed spell, object enemy) {
    int works, i;

    works = 0;
    if(spell != 0) {
        if(!spell[SP_PHYSICAL_ATTACK]) works = 1;
    }

    if(!works) {
        if(!pointerp(dam_type)) dam_type = ({ dam_type });
        for(i = 0; i<sizeof(dam_type); ++i) {
            if(member(MAGICAL_DAMAGE_TYPES, dam_type[i])) {
                works = 1; 
                break;
            }
        }
    }

    if(works) {
        tell_object(ENV(TO), BS("Der Zauberschild flackert magisch auf."));
        return _schutz / 2 + random(_schutz / 2);
    }

    if(!random(5)) tell_object(ENV(TO), BS("Der Zauberschild schimmert leicht."));
    return random(_schutz / 2);
}
