#include <properties.h>
#include <moredef.h>
#include <combat.h>

inherit "std/thing";

string* lagerfeuer_meldungen = ({
  "Das Feuer knistert leise, waehrend Funken in die Dunkelheit tanzen.",
  "Ein angenehm warmer Luftzug weht von den Flammen herueber und huellt dich ein.",
  "Das Holz knackt laut, als die Flammen es weiter verzehren.",
  "Ein flackernder Schatten wird von den Flammen an die Waende geworfen.",
  "Die Glut glimmt tiefrot, waehrend die Flammen sanft tanzen.",
  "Ein Stueck Holz bricht zusammen, und ein Schwarm Funken steigt in den Himmel auf.",
  "Die Waerme des Feuers vertreibt die Kaelte der Umgebung.",
  "Der Geruch von verbranntem Holz liegt in der Luft.",
  "Ein leises, beruhigendes Prasseln begleitet die tanzenden Flammen.",
  "Ein heller Funkenregen erhellt kurz die Umgebung, bevor er erlischt.",
  "Das Lagerfeuer spendet nicht nur Waerme, sondern auch Trost und Sicherheit.",
  "Ein kleiner Windstoss laesst die Flammen flackern, bevor sie sich wieder beruhigen.",
  "Ein Knistern und Knacken verraet, dass das Holz frisch und trocken ist.",
  "Die Flammen werfen ein warmes Licht auf die Gesichter der Anwesenden.",
  "Ein Funke springt auf einen nahen Stein, nur um dort zu vergluehen.",
  "Die Glut pulsiert rhythmisch, als ob das Feuer atmen wuerde.",
  "Eine kleine Rauchwolke steigt auf und verliert sich im naechtlichen Himmel.",
  "Das Feuer leuchtet hell und wirft lange Schatten in die Nacht.",
  "Ein leichter Duft von Harz und verbranntem Holz erfuellt den Raum.",
  "Die tanzenden Flammen laden zum Verweilen und Nachdenken ein."
});


void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kinsterndes Lagerfeuer");
  SetProp(P_LONG, "Hier hat jemand ein kleines, heimelig knisterndes Lagerfeuer "
                  "errichtet. Es waermt herrlich und du fuehlst dich ganz wohl "
                  "in seiner Naehe.");
  SetProp(P_INVIS, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Lagerfeuer");
  SetProp(P_GENDER, MALE);
  AddId(({"\nab_campfire", "lagerfeuer", "feuer"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_LIGHT, 1);
}

public void start(int dauer) {
    call_out("do_heal", 0);
    call_out("remove", dauer);
    return;
}

public int valid_target(object ob) {
  return (ob->Id("Spieler") || ob->QueryProp(P_FRIEND)) && !ob->InFight();
}

public void do_heal() {
    object *targets;
    int i;
    targets = filter_array(all_inventory(ENV(TO)), "valid_target");
    for(i=0; i<sizeof(targets); ++i) {
      targets->AddHp(1);
      targets->AddSp(1);
    }

    if(!random(4)) tell_room(environment(this_object()), BS(lagerfeuer_meldungen[random(sizeof(lagerfeuer_meldungen))]));
    call_out("do_heal", random(6));
    return;
}

public int remove(int silent) {
    if(!silent && objectp(ENV(TO))) tell_room(ENV(TO), BS("Das Lagerfeuer geht aus."));
    return ::remove(silent);
}
