#include <properties.h>
#include <moredef.h>

inherit "std/thing";

private int heal_fix, heal_rnd, duration;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Heilung");
  SetProp(P_GENDER, FEMALE);
  AddId("\nabenteurer_healing");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
}

public void init() {
    ::init();
    add_action("aufhoeren", "", 1);
}

public int aufhoeren() {
    remove();
    return 1;
}

public void start(object target, object caster, int ability, int success) {
    heal_fix = ability / 2000;
    heal_rnd = success / 2500 + caster->QueryAttribtute(A_INT) / 10;
    duration = ability / 3333 + caster->QueryAttribute(A_DEX) / 4;
    call_out("do_heal", 0, caster, target);
    return;
}

public void do_heal(object caster, object target) {
    if(duration <= 0 || caster->InFight() || ENV(caster) != ENV(target)) {
        remove();
        return;
    }

    target->AddHp(heal_fix + random(heal_rnd));
    duration--;
    call_out("do_heal", 0, caster, target);
    return;
}

public int remove(int silent) {
    object caster;
    caster = ENV(TO);
    if(objectp(caster) && !silent) {
        tell_object(caster, BS("Du beendest die Wundversorgung."));
        tell_room(ENV(caster), BS(caster->Name(WER)+" beendet die Wundversorgung.")), ({caster});
    }
    return ::remove(silent);
}
