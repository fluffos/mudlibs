#include <properties.h>
#include <moredef.h>

inherit "std/thing";

int orig, debuff;
object _caster, _target;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Heldenmut");
  SetProp(P_GENDER, MALE);
  AddId("\nab_racebuff");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
}

public void start(object caster, int ability, int success) {
    int duration, bonus, hpbonus;

    duration = caster->QueryProp(P_LEVEL) * 2 + ability / 100 + caster->QueryAttribute(A_INT);
    bonus = success / 3333 + ability / 5000;
    hpbonus = success / 1000 + ability / 1000;

    SetProp(P_X_ATTR_MOD, ([A_DEX: bonus, A_STR: bonus]));
    SetProp(P_X_HEALTH_MOD, ([P_HP: hpbonus]));
    SetProp(P_X_MAX_HEALTH_MOD, ([P_HP: hpbonus]));
    ENV(TO)->UpdateAttributes();

    call_out("remove", duration);
    return;
}

public int remove(int silent) {
  object target;
  target = ENV(TO);
    if(!silent && objectp(target)) {
      tell_object(target, BS("Dein Heldenmut versiegt."));
    }

    if(objectp(target)) {
      SetProp(P_X_ATTR_MOD, 0);
      SetProp(P_X_HEALTH_MOD, 0);
      SetProp(P_X_MAX_HEALTH_MOD, 0);
      target->UpdateAttributes();
    }

    return ::remove(silent);
}
