#include <properties.h>
#include <moredef.h>

inherit "std/thing";

int orig, debuff;
object _caster, _target;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Funke");
  SetProp(P_GENDER, FEMALE);
  AddId("\nab_lightob");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_LIGHT, 1);
}

public void start(object caster, int ability, int success) {
    int duration;
    _caster = caster;
    duration = caster->QueryProp(P_LEVEL) + caster->QueryAttribtute(A_INT) + ability / 500 + success / 1000;
    call_out("remove", duration);
}

public int remove(int silent) {
    if(!silent && objectp(_target) && objectp(_caster)) {
      tell_object(_caster, BS("Dein Lichtfunke erlischt."));
    }
    return ::remove(silent);
}
