#include <properties.h>
#include <moredef.h>

inherit "std/thing";

int orig, debuff;
object _caster, _target;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Verhexung");
  SetProp(P_GENDER, FEMALE);
  AddId("\nab_hex");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
}

public int body_ow() {
  return orig - debuff;
}

public void start(object target, object caster, int ability, int success) {
    int duration;
    string what;

    _caster = caster;
    _target = target;

    debuff = caster->QueryAttribtute(A_INT) / 5 + ability / 1250 + success / 1000;
    duration = ability / 666 + success / 666 + caster->QueryProp(P_LEVEL) / 3;

    switch(random(4)) {
      case 0:
        SetProp(P_X_ATTR_MOD, ([A_DEX: -debuff]));
        what = target->Name(WER)+" beginnt zu stolpern und schient viel ungeschickter.";
        break;
      case 1:
        SetProp(P_X_ATTR_MOD, ([A_STR: -debuff]));
        what = target->Name(WESSEN)+" Muskeln verkuemmern.";
        break;
      case 2:
        orig = target->QueryProp(P_BODY);
        target->Set(P_BODY, symbol_function("body_ow", TO), F_QUERY_METHOD);
        what = target->Name(WESSEN)+" Ruestung wird bruechig.";
        break;
      case 3:
        orig = target->QueryProp(P_SPELLRATE);
        target->Set(P_SPELLRATE, symbol_function("body_ow", TO), F_QUERY_METHOD);
        what = target->Name(WER)+" buesst Zauberkraft ein.";
        break;
    }

    target->UpdateAttributes();
    call_out("remove", duration);
    tell_room(ENV(target), BS(what));
    return;
}

public int remove(int silent) {
    if(!silent && objectp(_target) && objectp(_caster)) {
      tell_object(_caster, BS("Deine Verhexung von "+_target->name(WEM)+" endet."));
    }

    if(objectp(_target)) {
      SetProp(P_X_ATTR_MOD, 0);
      _target->UpdateAttributes();
    }

    return ::remove(silent);
}
