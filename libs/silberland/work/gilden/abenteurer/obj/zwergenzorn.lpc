#include <properties.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>

inherit "std/thing";

int chance, attacking;
object _caster;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Zwergenzorn");
  SetProp(P_GENDER, MALE);
  AddId("\nab_racebuff");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
}

public void start(object caster, int ability, int success) {
    int duration, bonus;
    
    _caster = caster;
    duration = ability / 1000 + success / 500 + caster->QueryAttribute(A_CON) / 2;
    bonus = success / 2000   + ability / 666;
    chance = ability / 2000 + success / 1000;
    attacking = 0;

    SetProp(P_X_ATTR_MOD, ([A_STR: bonus]));
    caster->SetProp(P_TMP_ATTACK_HOOK, ({time() + duration, TO, "AttackHook"}));
    caster->UpdateAttributes();

    call_out("remove", duration);
    return;
}

public int remove(int silent) {
  object target;
  target = ENV(TO);
    if(!silent && objectp(target)) {
      tell_object(target, BS("Dein Zwergenzorn versiegt wieder."));
    }

    if(objectp(target)) {
      SetProp(P_X_ATTR_MOD, 0);
      target->UpdateAttributes();
    }

    return ::remove(silent);
}

public int AttackHook(object enemy) {
  int r;
  r = random(100);
  if(TP->QueryProp(P_TESTPLAYER)) write(sprintf("chance=%d r=%d\n", chance, r));
  if(!attacking && objectp(enemy) && r < chance) {
    attacking = 1;
    _caster->do_my_heart_beat(); // damit no_more_attack auf 0 gesetzt wird
    _caster->Attack(enemy);
    attacking = 0;
  }
  return objectp(enemy);
}