#include <properties.h>
#include <moredef.h>

inherit "std/thing";

int orig, debuff;
object _caster, _target;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Trollregeneration");
  SetProp(P_GENDER, FEMALE);
  AddId("\nab_racebuff");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
}

public void start(object caster, int ability, int success) {
    int duration, heal;

    duration = caster->QueryProp(P_LEVEL) / 10 + ability / 2000 + caster->QueryAttribute(A_CON) / 5 + success / 2000;
    heal = ability/2000 + success/2000;
    _caster = caster;

    call_out("heal", 0, heal);
    call_out("remove", duration);
    return;
}

public void heal(int h) {
  if(!objectp(_caster)) {
    remove(1);
    return;
  }

  if(_caster->QueryProp(P_SP) < 5) {
    remove();
    return;
  }

  _caster->AddHp(1+random(h));
  _caster->AddSp(-5);
  call_out("heal", 0, h);
}

public int remove(int silent) {
    if(!silent && objectp(_caster)) {
      tell_object(_caster, BS("Dein Koerper heilt wieder normal schnell."));
    }

    return ::remove(silent);
}
