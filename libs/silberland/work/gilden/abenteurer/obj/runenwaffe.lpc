
inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

object traeger;
object caster;
object weapon;
string damtype;
int value, sets;
object hitFunc;

create() {
  if( !is_clone(TO) ) return;
  ::create();
  sets=0;
  SetProp(P_SHORT, 0);
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_WC, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({"\nab_runenwaffe"}));
  SUID;
}

void start(object _caster, object _weapon, int wc, int dauer) {
  if(sets) {
    call_out("remove", 0);
    return 0;
  }
  caster=_caster;
  weapon=_weapon;
  value=wc;
 
  weapon->Set(P_WC_BONUS, symbol_function("wc_change", TO), F_QUERY_METHOD);
  weapon->Set(P_NOBUY, symbol_function("wc_change", TO), F_QUERY_METHOD);
  weapon->Set(P_NODROP, symbol_function("nodrop", TO), F_QUERY_METHOD);
  weapon->DoUnwield(1);
  weapon->wield_me(1);
  call_out("remove", dauer);
  return;
}

mixed QueryVariables() {
  return ({caster, weapon, value});
}

mapping wc_change() {
  return (["Spieler":value]);
}

string nodrop() {
  return "Die Runen binden die Waffe an dich!\n";
}

remove() {
  mixed ob;
  
  if(objectp(weapon)) {
      if (ENV(weapon)) traeger=ENV(weapon);
      if(objectp(caster)) tell_object(caster, BS(sprintf("Die Runen von %s verblassen!\n", weapon->name(WEM))));
      weapon->Set(P_WC_BONUS, 0, F_QUERY_METHOD);
      weapon->Set(P_NOBUY, 0, F_QUERY_METHOD);
      weapon->Set(P_NODROP, 0, F_QUERY_METHOD);
      weapon->DoUnwield(1);
      weapon->wield_me(1);
  }

  while(remove_call_out("remove")!=-1);
  ::remove();
}

init() {
 ::init();
 if(!living(ENV(ME)))
   call_out("remove", 0);
}

reset() {
  ::reset();
  if (is_clone(TO)) call_out("remove", 0);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
  if(victim == ENV(TO)) {
    remove();
  }
  return;
}