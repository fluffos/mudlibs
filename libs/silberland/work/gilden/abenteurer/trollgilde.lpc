
#include "/d/gebirge/speedy/trollager/def.h"

inherit "/gilden/abenteurer";

#include <properties.h>
#include <language.h>

string Funktion();
string tafel();

void create() {
  ::create();

  SetProp(P_INT_SHORT, "In der Trollgilde" );
  SetProp(P_INT_LONG, 
    "Eine seltsame Huette ist das hier schon irgendwie. Obwohl Du dachtest "
    "Trolle koennen gar nicht lesen, liegt auf einem staubigen Tisch eine "
    "kleine beschriebene Tafel. Unter einem Haufen Truemmer kannst Du "
    "sogar eine kleine Uhr erkennen. Die Funktion dieser Huette wird Dir "
    "erst klar, als Du das kleine Schild siehst.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );

  // aufraeumen
  SetProp(P_DETAILS, ([]) );
  RemoveExit("westen");

  AddDetail( ({ "huette" }),
    "Die Huette wurde notduerftig aus ein paar Hoelzern und Blaettern "
    "zusammengebaut. Handwerklich eher ungeschickt wuerdest Du sagen.");

  AddDetail( ({ "hoelzer","holz" }),
    "Die Hoelzer sind sehr grob bearbeitet und stinken. Sie stammen aus "
    "den umliegenden Waeldern.");

  AddDetail( ({ "wald","waelder" }),
    "Da die Huette keine Fenster hat, kannst Du keinen Wald sehen. Aber "
    "Du weisst halt, dass um das Trollager auch ein Wald ist.");

  AddDetail( ({ "fenster" }),
    "*seufz*");

  AddDetail( ({ "blaetter","blatt" }),
    "Die Blaetter sind schon recht vergilbt. Aber sie halten den Wind "
    "noch ganz gut ab.");

  AddDetail( ({ "wind" }),
    "Du spuerst ihn kaum hier drinnen.");

  AddDetail( ({ "trollager","lager" }),
    "Die Huette steht mitten im Lager. Du kannst sie nach Sueden verlassen.");

  AddDetail( ({ "troll","trolle" }),
    "Du bist in der Trollgilde. Kein Wunder, dass sich hier soviele Trolle "
    "rumtreiben.");

  AddDetail( ({ "trollgilde","gilde" }),
    "Die Trollgilde ist ausschliesslich fuer die Trolle da. Sie koennen "
    "hier Informationen sammeln und ihre Stufen erhoehen.");

  AddDetail( ({ "informationen","information","stufe","stufen" }),
    "Schau Dir mal das Schild naeher an.");

  AddDetail( ({ "wunder" }),
    "Nein, Du wunderst Dich wirklich nicht.");

  AddDetail( ({ "tisch" }),
    "Naja, Tisch zu sagen ist schon fast uebertrieben. Zusammengebrochen "
    "liegt er auf dem Boden. Eine kleine Tafel liegt neben viel Staub darauf.");

  AddDetail( ({ "boden" }),
    "Der Boden ist aus harter Erde. Man hat sich keine Muehe fuer einen "
    "richtigen Boden gegeben.");

  AddDetail( ({ "erde" }),
    "Schwarze, dunkle Erde ist das.");

  AddDetail( ({ "muehe" }),
    "Die hat man sich wirklich nicht gegeben. Ziemlich verkommen ist die "
    "Huette.");

  AddDetail( ({ "staub" }),
    "Der Staub muss schon sehr alt sein. Zentimeterdick stapelt er sich "
    "nicht nur auf dem Tisch.");

  AddDetail( ({ "haufen","truemmer" }),
    "Das waren wohl mal die anderen Einrichtungsgegenstaende. Aber die "
    "Trolle haben alles im Laufe der Zeit zerstoert.");

  AddDetail( ({ "einrichtungsgegenstaende","gegenstaende" }),
    "Du kannst nicht mehr erkennen was das genau war. Es sind wirklich nur "
    "noch Truemmer uebrig. Und letztendlich interessiert es Dich eigentlich "
    "auch gar nicht.");

  AddDetail( ({ "laufe","zeit","moment" }),
    "Wie die Zeit doch so vergeht...");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind aus Holz. Auffaellig ist eigentlich nur, dass es nicht "
    "ein einziges Fenster gibt.");

  AddDetail( ({ "decke" }),
    "Die Decke ist dicht und schuetzt vor Regen.");

  AddDetail( ({ "regen" }),
    "Im Moment ist es aber trocken. Du brauchst Dir also keine Sorgen machen.");

  AddDetail( ({ "sorgen" }),
    "Vor Trollen sollte man sich aber schon hueten.");

  AddDetail( ({ "tuer" }),
    "Oh, wie wahr. Im Sueden kannst Du die Huette durch eine kleine Tuer "
    "verlassen. Sie haengt noch so gerade in den Angeln, aber das tut sie "
    "wohl schon laenger.");

  AddDetail( ({ "angeln","tuerangeln" }),
    "Sie koennen die Tuer gerade noch so halten. Die Tuer steht deshalb aber "
    "auch immer offen.");

  AddDetail( ({ "tier","tiere" }),
    "Du kannst hier keine sehen. Die stecken sicher unter dem Staub "
    "vergraben.");

  AddDetail( ({ "draussen" }),
    "Du musst schon nach Sueden gehen. Von hier kannst Du nichts sehen.");

  AddSound( DEFAULT_SOUND,
    "Ein leises Summen kommt von Draussen herein.");
    
  AddSound( "summen",
    "Das muessen wohl irgendwelche Tiere sein.");
    
  AddSmell ( DEFAULT_SMELL,
    "Es riecht nach Trollen.");

  AddSmell ( ({"troll","trolle","geruch" }),
    "Der Geruch nach Trollen schwebt hier ueberall.");

  AddSpecialDetail("uhr","zeige_reboot");
  AddDetail(({"funktion", "schild"}), #'Funktion);
  AddReadDetail(({"funktion", "schild"}), #'Funktion);

  AddDetail("tafel",#'tafel);
  AddReadDetail("tafel",#'tafel);

  RemoveItem( "/p/service/obj/zettel/zettelmaschine");
  
  AddCmd( ({"kosten", "wandle", "erhoehe", "lern", "lerne"}), "trollgilde");

  AddExit( "sueden","/d/gebirge/speedy/trollager/room/t3" );
}

string GuildName() {
  return "abenteurer";
}

tafel() {
   return TP->More(read_file("/etc/toptrolle.read"));
}

trollgilde(string str) {  
  string race;
  race = this_player()->QueryProp(P_RACE); 

  if (race != "Troll") {  
    switch (race) {
      case "Dunkelelf":
        return notify_fail(BS(
          "Das hier ist die Trollgilde, hau ab zurueck in die Finsternis, "
          "wo Du hergekommen bist!"));
      case "Zwerg":
        return notify_fail(BS(
          "Was willst Du denn als winziger Zwerg hier?"));
      case "Oger":
        return notify_fail(BS(
          "Wenn Du nicht sofort gehst wirst DU wohl bald gefressen!"));
      case "Mensch":
        return notify_fail(BS(
          "Geh lieber nach Midas, hier ist es viel zu heiss fuer Dich!"));
      case "Elf":
        return notify_fail(BS(
          "Trolle fressen Elfen und daher kannst Du hier nichts machen!"));
      case "Fee":
        return notify_fail(BS(
          "Eine mickrige Fee hat hier wirklich nichts zu suchen!"));
      case "Hobbit":
        return notify_fail(BS(
          "Soll Dein Fell ueber dem Spiess verbrennen?"));
      default:
        return notify_fail(BS(
          "Das ist die Trollgilde, da hast Du als "+race+
          " nichts zu suchen!\n"));
    }
  }
  switch(query_verb()) {
    case "kosten": return kosten(str);
    case "wandle": return change(str);
    case "erhoehe": return advance(str);
    case "lern":
    case "lerne": return OwnLearnSpell(str);
  }
}
