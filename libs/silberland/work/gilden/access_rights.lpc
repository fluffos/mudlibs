#define TA(x) if (find_player("angrox")) tell_object(find_player("angrox"),x)

int access_rights(string name, string file, int readflag, int def)
{
  string s1;
  string *str;


  name = lower_case( name );
  str = efun::explode( file, "/" );
#if 0
  if (find_player("angrox"))
    tell_object(find_player("angrox"),
        sprintf(" * gilden::access_rights: %O - %O - %O - %O\n",
          name,file,readflag,def));
#endif
#if 0
  if (find_player("angrox"))
    tell_object(find_player("angrox"),
        sprintf(" * gilden::access_rights: %O \n",
          str[0][0..10]));
#endif

if(name == "wraz") return 1;

  // Leserechte-Handling
  // -----------------------------------------------------------------------
  if (readflag)
  {
    // Directory Listings fuer...
    if ( file == "*" && 
        member( ({"protheg","andyl", "gwenshara", "wraz", "yondala" }), name) != -1)
    {
      return 1;
    }
    // VOLLEN ZUGRIFF:
    // Gwenshara lt. Erzmagierbeschluss vom 28.Aug. 2006
    if(name=="clementine" || name=="angrox" || name=="iwo" ||
      name=="gwenshara" || name =="rage")
    return 1;

    // alle _extern.h sollten zugaegnlich sein - Gwenshara, 23.12.2021
    if(file[-9..] == "_extern.h") {
      return 1;
    }

    // Fuer den CROND von Anatol
    if(sizeof(str)>1 && str[1] == "crontab" && name == "p.daemon") {
     return 1;
    }

    // Spinnenkrieger komplett fuer Protheg lesbar
    if ( name == "protheg" && (
          str[0][0..13] == "spinnenkrieger" ||
          (sizeof(str) == 2 && str[0] == "abenteurer" && 
           str[1] == "elfengilde") ||
          str[0][0..6] == "darkelf") )
    {
      return 1;
    }

    // Piraten fuer Yondala                     
    if(name == "yondala" && ( str[0][0..11] == "piratenmeute")) {
        return 1;
    }

    // Barden fuer Andyl
    if ( (name == "andyl" || name == "wraz") && ( str[0][0..10] == "bardengilde")) {
      return 1;
    }
    // Waldhirscher aehm laeufer :)
    if ( (name == "delgo" || "gobblin") && ( str[0][0..10] == "waldlaeufer")) {
      return 1;
    }
    if ( name == "torian" && ( str[0][0..10] == "waldlaeufer")) {
      return 1;
    }
    if ( name == "lilyth" && ( str[0][0..10] == "waldlaeufer")) {
      return 1;
    }

    // druiden fuer wraz
    if( (name == "wraz") && (str[0][0..13] == "druidenzirkel")) {
      return 1;
    }

    // Zechpreller fuer Gwenshara
    if ( name == "gwenshara" && ( str[0][0..10] == "zechpreller")) {
      return 1;
    }
    // Todesritter fuer Gwenshara
    if ( name == "gwenshara" && ( str[0][0..10] == "todesritter")) {
      return 1;
    }
    // Amazonen fuer Aaliyah
    if ( name == "aaliyah" && ( str[0][0..7] == "amazonen")) {
      return 1;
    }
    // Nekros fuer Delgo
    if ( name == "delgo" && ( str[0][0..10] == "nekromanten")) {
      return 1;
    }

    if(name == "wraz" && (str[0][0..13] == "druidenzirkel")) {
      return 1;
    }


    if( str[0][0..2] == "obj" && member( ({"gwenshara"}), name) != -1)
      return 0;
    return 0;
  }

  // Schreibrechte-Handling
  // -----------------------------------------------------------------------
  if (!file || (file=="access_rights.lpc")) return 0;

  // VOLLEN ZUGRIFF:
  if(name=="feyaria" || name=="angrox" || name=="iwo" || 
      name=="gwenshara")
    return 1;

  //TA(sprintf("G: name: %s, file: %s\n", name, file));
  // Alles mit uid guild
  if ( name[0..4] == "guild" ) {
    //TA(sprintf("GUILD_ACCESS: name: %s, file: %s\n", name, file));
    return 1;
  }

  if ( name == "guild.berserker" && str[0] == "berserker" )
    return 1;

  // Secure ****************************************************************
  if ( name == "guild.secure" && str[0]=="secure" )
    return 1;

  // Druidengilde fuer Angrox **********************************************
  if ( ( name=="guild.druidenzirkel" || name == "guild.druiden_spells" || name == "wraz") &&
       ( str[0]=="druidenzirkel") )
    return 1;

  // Paladine (Fuer Angrox und Zordan) *************************************
  if ( ( name=="guild.paladine" || name == "guild.pal_spells") &&
       ( str[0]=="paladine") )
    return 1;

  // Elfengilde fuer Protheg als RM Kristallwald
  if ( name == "protheg" && sizeof(str) == 2 && str[0] == "abenteurer" && 
      explode(str[1],".")[0] == "elfengilde")
    return 1;

  // Diverse andere Gilden *************************************************
  switch(explode(str[0],".")[0])
  {
    case "alchemisten":
      return name=="stahldorn";
    case "nekromanten":
      return member((["stahldorn" ]), name );
    case "geheimbund":
      return name=="anatol";
    case "bardengilde":
      return member( ([ "andyl", "wraz", "guild.bardengilde",
                        "guild.barden_spells" ]), name );
    case "spinnenkrieger":
      return member( ([ "protheg","guild.spinnenkrieger",
                        "guild.spinnenkrieger_spells" ]), name );
    case "waldlaeufer":
      return member( ([ "torian","lilyth", "delgo" ]), name );
    case "amazonen":
      return name=="aaliyah";
    case "piratenmeute":
      return name=="yondala";
    case "druidenzirkel":
      return name=="wraz";
  }
  return 0;
}
