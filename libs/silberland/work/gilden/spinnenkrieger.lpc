	  ([
	    1 : "der ungeschickte Neuling",
	    2 : "der Druidenlehrling",
	    3 : "der Jungdruide",
	    4 : "der Hilfselementarist",
	    5 : "der Elementaristadept",
	    6 : "der angehende Elementarist",
	    7 : "der Elementarist", 
	    8 : "der fortgeschrittene Elementarist", 
	    9 : "der baldige Elementarbeschwoerer",
	    10: "der Elementarbeschwoerer" 
	   ]));

  AddSpell("identifiziere"); 
  AddSpell("schaetz"); 
  AddSpell("parieren"); 
  AddSpell("blutbad"); 
  AddSpell("dunkelkugel"); 
  AddSpell("schnell"); 
  AddSpell("kniestoss"); 
