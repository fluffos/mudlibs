  AddSkill(FIGHT(WT_KNIFE), ([SI_SKILLFUNC:"DolchKampf", SI_DIFFICULTY:150]));
  AddSkill(FIGHT(WT_BOW), ([SI_SKILLFUNC:"BogenKampf", SI_DIFFICULTY:150]));
  
  AddCmd(({"tritt","trete"}), "beitreten");
  AddCmd("schlucker","schlucker");
  AddCmd("doc","showdocu");
  AddExit("gi","in die Gilde#/gilden/abenteurer");
}

showdocu(string str)
{
  TP->more("/players/protheg/doc/sk");
  return 1;
}

schlucker(string str)
{
  object sc;
  
  sc=clone_object("/obj/entsorg");
  sc->move(ME, M_NOCHECK);
  return 1;
}

beitreten(string str)
{
  int b;
  if(str=="gilde bei")
    {
      if((b=::beitreten()) < 0) return 1;
      write("Du trittst den Spinnenkriegern bei!\n");
      this_player()->ModifySkill(FIGHT(WT_KNIFE),
        QuerySkill(FIGHT(WT_KNIFE)),0,"spinnenkrieger");
      this_player()->ModifySkill(FIGHT(WT_BOW),
        QuerySkill(FIGHT(WT_BOW)),0, "spinnenkrieger");
      return b;
    }
  if(str=="aus")
    return ::austreten();
}

nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if(value<3000) value=3000;
  else if(value>5000) value=5000;
  return value;
}

void Channel(string msg)
{
  catch(VOICEMASTER->SendToChannel("Spinnenkrieger",TO,SAY,msg));
}

mapping DolchKampf(object user, string sname, mapping sinfo)
{
  int abil, diff;

  if(!mappingp(sinfo)) return 0;
  abil = sinfo[SI_SKILLABILITY];
  sinfo[SI_SKILLDAMAGE]+=user->QueryProp(P_GUILD_LEVEL)*3+
    random((abil/MAX_ABILITY)*(80+user->QueryAttribute(A_STR)*2+
    user->QueryAttribute(A_DEX)*2));
  DB("*** Spinnenkrieger Dolchkampf: - "+user->name(WER)+" ("+
     sinfo[SI_SKILLDAMAGE]+")\n");
  if(!random(10) && (10000-abil)/2 > random(MAX_ABILITY))
    user->LearnSkill(sname, user->QueryAttribute(A_STR)/7);
  return sinfo;
}

mapping BogenKampf(object user, string sname, mapping sinfo)
{
  int abil, diff;

  if(!mappingp(sinfo)) return 0;
  abil = sinfo[SI_SKILLABILITY];
  sinfo[SI_SKILLDAMAGE]+=user->QueryProp(P_GUILD_LEVEL)*3+
    random((abil/MAX_ABILITY)*(80+user->QueryAttribute(A_STR)*2+
    user->QueryAttribute(A_DEX)*2));
  DB("*** Spinnenkrieger Bogemkampf: "+user->name(WER)+" ("+
     sinfo[SI_SKILLDAMAGE]+")\n");
  if(!random(10) && (10000-abil)/2 > random(MAX_ABILITY))
    user->LearnSkill(sname, user->QueryAttribute(A_STR)/7);
  return sinfo;
}

