/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original LDMud room preserved as /gilden/abenteurer_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Die beruehmte Abenteurergilde");
  set_long(
    "Der grosse Raum mit seiner niedrigen Decke und den grob geschnittenen "
    "Querbalken hat Platz fuer sehr viele Personen. Knarrende Dielen erzaehlen "
    "ueber Heldentaten laengst vergessener Abenteurer, beruehmter als mancher "
    "Weise unserer Zeit. Abenteurer, aber auch andere Bewohner dieser Welt "
    "kommen hierher, um sich zu informieren, ihre Erfahrungen auszutauschen "
    "oder sich in den verschiedensten Wissenschaften zu verbessern. Durch die "
    "immer offene Tuer scheint die aufgehende Sonne herein und fuellt den Raum "
    "mit ihrem goldenen Licht. Im Westen fuehrt der Ausgang hinaus nach Midas "
    "und oben liegt 'das juengste Geruecht'.\n"
  );
  set_exits(([
    "westen": "/d/ebene/Midas/room/room_d6",
    "oben": "/room/treff",
  ]));
  set_items(([
    "bilder":
    "Die Zeichnungen und Gemaelde stellen SilberLand aus den verschiedensten "
    "Perspektiven dar — Gebirge, Ebene und See. Ausserdem siehst Du ein "
    "kleines Schild an einer Wand.\n",
    "schild":
    "Auf dem Schild stehen die Moeglichkeiten der Gilde (liste, erhoehe, kosten, lerne, oben).\n",
    "uhr":
    "Die Uhr zeigt Dir die Stunde an.\n",
    "balken":
    "Die Holzbalken tragen das Obergeschoss des Gildenhauses und sind teilweise von Schwertstreichen zernarbt.\n",
    "dielen":
    "Die knarrenden Dielen der Gilde sind schon alt und abgeschabt.\n",
  ]));
  set_reads(([
    "schild":
    "Moeglichkeiten der Abenteurergilde: liste, erhoehe [stufe], kosten, lerne <zauberspruch>, wandle <attr>.\n",
    "uhr":
    "Es ist " + ctime(time())[11..15] + " Uhr in Midas.\n",
  ]));
}
