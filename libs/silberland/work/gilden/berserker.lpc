void learn_berserker_skills( int axt, int bihand)
{
  object wer;
  
  wer = previous_object();
  if( !wer || interactive(wer) || query_once_interactive(wer) ) return;
  wer->ModifySkill(FIGHT(WT_AXE),
    QuerySkill(FIGHT(WT_AXE))+([ SI_SKILLABILITY: axt]), 1,"berserker");
  wer->ModifySkill( SK_TWOHANDED,
    QuerySkill( SK_TWOHANDED)+([ SI_SKILLABILITY: bihand]), 1, "berserker" );
  switch( wer->QueryProp(P_GUILD_LEVEL) )
  {
    case 12:
    case 11:
    case 10:wer->ModifySkill( "blutrausch", QuerySkill("blutrausch")+
             ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 9: wer->ModifySkill( "schlachtruf", QuerySkill("schlachtruf")+
             ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 8:
    case 7: wer->ModifySkill( "spalten", QuerySkill("spalten")+
             ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 6: wer->ModifySkill( "eisenhaut", QuerySkill("eisenhaut")+
             ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
            wer->ModifySkill( "kopfstoss", QuerySkill("kopfstoss")+
             ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 5: wer->ModifySkill( "kampfschrei", QuerySkill("kampfschrei")+
             ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
            wer->ModifySkill( "willenskraft", QuerySkill("willenskraft")+
             ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 4: wer->ModifySkill( "rammen", QuerySkill("rammen")+
             ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 3: wer->ModifySkill( "augeinauge", QuerySkill("augeinauge")+
            ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 2: wer->ModifySkill( "zertreten", QuerySkill("zertreten")+
            ([SI_DIFFICULTY: 1, SI_SKILLABILITY:10000, SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  }
}



void remote_advance(object wer, object promoter)
{
  switch(wer->QueryProp(P_GUILD_LEVEL))
  {
    case 1: Test2(wer,0);break;
    case 2: Test3(wer,0);break;
    case 3: Test4(wer,0);break;
    case 4: Test5(wer,0);break;
    case 5: Test6(wer,0);break;
    case 6: Test7(wer,0);break;
    case 7: Test8(wer,0);break;
    case 8: Test9(wer,0);break;
  }
  wer->SetProp(P_GUILD_LEVEL, wer->QueryProp(P_GUILD_LEVEL)+1);
  ::adjust_title(wer);
  write_file(LOG + "Befoerderungen", sprintf("%s  %s %s.\n",dtime(time()),
        capitalize(getuid(wer)), "wurde von "+capitalize(getuid(promoter))+ 
        " auf Stufe " +wer->QueryProp(P_GUILD_LEVEL)+" befoerdert"));
  write_file(LOG + getuid(wer)+".log", sprintf("%s  %s %s.\n",dtime(time()),
        capitalize(getuid(wer)), "hat Stufe "
      +wer->QueryProp(P_GUILD_LEVEL)+" erreicht ("+getuid(promoter)+")"));
  Channel(capitalize(getuid(wer))+" wurde von "+capitalize(getuid(promoter))+
      " auf Berserkerstufe " +wer->QueryProp(P_GUILD_LEVEL)+" befoerdert.");
  AfterAdvance(wer);
}

void level_12()
{
  object ob;

  write( break_string (TP->Name(WER)+ ", aufgrund Deiner "
        "grossen Verdienste um Die Berserkergilde verleihe ich Dir hiermit "
        "den Titel eines Berserkergildenmeisters!", 78, "Kronang sagt: "));
  TP->SetProp(P_GUILD_LEVEL, 12);
  TP->SetProp(P_START_HOME, "/gilden/berserker");
  ::adjust_title(TP);
  AfterAdvance(TP);
  WLOG(LOG + getuid(TP)+".log", "wird Gildenmeister!");
  WLOG(LOG + "Stufe12.log", "wird Gildenmeister!");
  Channel(capitalize(getuid(TP))+" wurde "+
      (TP->QueryProp(P_GENDER)==FEMALE?"zur Gildenmeisterin":"zum Gildenmeister")+
      " der Berserker befoerdert und ist nun "+
      (TP->QueryProp(P_GENDER)==FEMALE?"meine offizielle Stellvertreterin":
       "mein offizieller Stellvertreter")+"!");
  ob=clone_object(WEAPON "berserkeraxt");
  ob->SetProp(P_SHORT, TP->Name(WESSEN)+" Berserkeraxt "+
      (TP->QueryProp(P_GENDER)==FEMALE ? "der Gildenmeisterin" : "des Gildenmeisters"));
  ob->SetProp(P_NAME_ADJ, "meisterlich");
  ob->SetProp(P_NODROP, 1);
  ob->move(TP,M_NOCHECK);
  ob->wield_me();
  WLOG( LOG "Berserkeraxt", "bekommt eine Berserkeraxt fuer GS 12");
  call_out("remove_kronang", 2);
}   

void remove_kronang()
{
  Channel2("begibt sich nun auf einen wohlverdienten Urlaub!");
  Channel2("gratuliert "+capitalize(getuid(TP))+ " nocheinmal ganz herzlichst zu "
        "dieser unglaublichen Leistung!");
  Channel2("winkt und verschwindet");
  present("kronang")->destruct_equip();
  present("kronang")->remove();
}

void spell_log(object pl, string was)
{
  if( !objectp(pl) || !stringp(was) ) return;
  WLOG(LOG + "Spells.log", " bringt "+CAP(getuid(pl))+" '"+CAP(was)+"' bei");
}

