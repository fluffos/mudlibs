int level_11(object pl)
{
  pl->SetProp(P_GUILD_LEVEL, 11);
  ::adjust_title(pl);
  AfterAdvance(pl);
  WLOG(LOG + getuid(pl)+".log", "wird Berserkerlegende");
  WLOG(LOG + "Stufe11.log", "wird Berserkerlegende");
  log_file(B11_LOG,sprintf("[%s] %O wird Berserkerlegende!\n", dtime(time()), TP));
  Channel(capitalize(getuid(pl))+" hat das Raetsel der Raetsel "
      "geloest, den Edelstein der Edelsteine erschaffen, auf dem Weg der "
      "Ahnen eine komplette Berserkerruestung errungen und ist ab sofort "
      "eine Berserkerlegende!");

