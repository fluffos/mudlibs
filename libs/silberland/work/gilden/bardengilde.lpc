int knowsSpell(string spell, object who) {
  return who->QuerySkill(spell) != 0;
}


nosave string TestSkillAbility(string str,int akt,int min, int max) {
  string out;
  int percent;
  out="";

  percent=100-(akt-min*100)/(max-min);
  if(TP->QueryProp(P_TESTPLAYER)) {
    write(sprintf("%-30s %5s %3s -> %3s\n", "Skill", "Abil", "%", "%"));
    write(sprintf("%-30s %5d %3d -> %3d\n", str, akt, percent, max));
  }

  if(akt<max*MAX_ABILITY/100) {
    out+="Du musst "+str+" ";
    switch (percent) {
      case -10000..10:  
                   out+="noch eine Winzigkeit mehr";
                   break;
      case 11..20: out+="nur noch sehr minimal";
                   break;
      case 21..30: out+="noch sehr wenig";
                   break;
      case 31..40: out+="noch ein wenig";
                   break;
      case 41..60: out+="etwa nochmal soviel";
                   break;
      case 61..70: out+="noch mehr";
                   break;
      case 71..80: out+="noch viel";
                   break;
      case 81..90: out+="noch sehr viel";
                   break;
      case 91..100: out+="noch unglaublich viel";
                    break;
      default:      out+="noch ungewoehnlich viel";
                    raise_error(sprintf(
                      "%s: Ungereimtheit beim Erhoehen: TP: %s, SPELL: %s, "
                      "Akt: %d, Min: %d, Max: %d\n",
                    dtime(time()), CAP(getuid(TP)), str, akt, min*100, 
                    max*100));
                    break;
    }
    out+=" ueben. ";
  }
  return out;
}

private string insertBardGroupSpell(string str, object who) {
  int i;
  string *keys, grp, *variants;

  keys = m_indices(GROUP_SPECIFIC_SPELLS);
  for(i=0; i<sizeof(keys); ++i) {
    grp = sprintf("@@%s@@", keys[i]);
    if(strstr(str, grp, 0) != -1) {
      str = regreplace(str, grp, GROUP_SPECIFIC_SPELLS[keys[i]][BARD_GROUP(who)], 1);
    }
  }


  if(strstr(str, "|", 0) != -1) {
    variants = explode(str, "|");
    // es gibt einen alternativen heldepfad spell -> pruefen, ob der barde am pfad ist
    if(BARDENMASTER->HasHeroPathLevel(who, variants[1], 2)) {
      return HERO_SPECIFIC_SPELLS[variants[1]];
    } else {
      return variants[0];
    }
  }

  return str;
}

public mixed LevelTest(object who) {
  int lvl, i, targetLevel;
  string str, *levelSpells, *spellsToLearn, spellName, lcName, *toCheck;

  str = "";
  spellsToLearn = ({ });

  targetLevel = who->QueryProp(P_GUILD_LEVEL);

  // fuer jedes level die notwendigen zauber und skills pruefen
  for(lvl = who->QueryProp(P_GUILD_LEVEL)-1; lvl >= 0; lvl--) {
    levelSpells = SPELLS_PER_LEVEL[lvl];
    for(i=0; i<sizeof(levelSpells); ++i) {
      spellName = insertBardGroupSpell(levelSpells[i], who);
      lcName = (spellName != SK_SINGING && spellName != SK_MUSIC ? lowerstring(spellName) : spellName);
      if(!knowsSpell(lcName, who)) {
        spellsToLearn += ({ spellName });
      } else {
        if(spellName == SK_SINGING || spellName == SK_MUSIC) {
          str += TestSkillAbility(sprintf("'%s'", spellName), who->QuerySkillAbility(lcName), 0, 20 + (5 * (targetLevel-lvl+1)));
        } else {
          str += TestSkillAbility(sprintf("'%s'", spellName), who->QuerySkillAbility(lcName), 0, 36 + (4 * (targetLevel-lvl+1)));
        }
      }
    }
  }

  if(sizeof(spellsToLearn) > 0) {
    str += sprintf("Du hast noch nicht alle Zauberlieder fuer diesen Grad erlernt. Gehe hinaus in die Welt und "
           "Suche nach Inspiration fuer %s.", implode(spellsToLearn, ", "));
  }

  if(str != "") return str;

  return 0;
}

int sequenzende()
{
  object ob,artyrian;
  if(artyrian=present(GUILDNPC_ID, ME)) 
    {
      artyrian->SetProp(P_NOATTACK,0);
      artyrian->SetProp(P_CHAT_CHANCE,1);
    }
  
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:0, PARALYZE_MSG:"", 
  PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  return 1;
  
  write("ENDE DER SEQUENZ, YIPPIE !!!.\n");
  return 1;
}

// TESTFUNKTIONEN ZUM ANSCHAUN VON SEQUENZEN!

dummy()
{
  write("geschafft!\n");
}

int lade_was(string str) 
{
  object artyrian;
  string not_fail, stri1, stri2;
  not_fail="Wos wuelst lodn, heast?\n";
  sscanf(str, "%s %s", stri1, stri2);
  if(!str) return 0;
  
  if (stri1=="level")
    {
      write("Levelsequenz folgt:\n");
      write("Geladen wird "+LEVELSEQ(stri2)+"\n");
      LoadSequenz(LEVELSEQ(stri2), TP, CLOSURE(dummy));
      return 1;
    }
  if (stri1=="task")
    {
      write("Tasksequenz folgt:\n");
      write("Geladen wird "+TASKSEQ(stri2)+"\n");
      LoadSequenz(TASKSEQ(stri2), TP, CLOSURE(dummy));
      return 1;
    }
  if (stri1=="spell")
    {
      write("Spellsequenz folgt:\n");
      write("Geladen wird "+SPELLSEQ(stri2)+"\n");
      LoadSequenz(SPELLSEQ(stri2), TP, CLOSURE(dummy));
      return 1;
    }
  write(not_fail);
  return 1;
}

// ENDE DER TESTFUNKTIONEN


string maghelp()
{
  if(IS_WIZARD(TP)) 
    return "\nMagInfo: Hilfe fuer Magierbefehle mit <gilde hilfe>.";
  if(!(TP->QueryProp(P_TESTPLAYER))==0)
    return "\nTestiInfo: Anzeigen von Befehlen fuer Testis <testibefehle>.";
  return "";
}

int testibefehle()
{
  if( ( !(TP->QueryProp(P_TESTPLAYER))==0) || IS_WIZARD(TP) ) 
    {
      write("Befehle fuer Testis:\n"	  
	    +"----------------------------------------------------------------------------\n"
	    +"testibeitritt <bardgroup>: Schneller Beitritt von Testis.\n"
	    +"testiaustritt : Schneller Austritt fuer Testis.\n"
	    +"----------------------------------------------------------------------------\n"
	    );
      return 1;
    }
  return 0;
}

/* Funktionen fuer Magier */
int magfunc(mixed str)
{
  mixed *txt;
  object ob;
  int err, task;
  string name;
  string grichtung;
  if(!IS_WIZARD(TP)) return 0;
  if(!str) str="hilfe";
  if(str=="hilfe") {
    write("Folgende Befehle sind moeglich:\n"
	  +"----------------------------------------------------------------------------\n"
	  +"gilde hilfe  : Hilfe fuer Magier anzeigen\n"
	  +"gilde backup : Backup des Memberfiles\n"
	  +"gilde restore: Zurueckspielen des Backups\n"
	  +"gilde toplist: Updaten der Topliste\n"
	  +"gilde set_task <name> <task> : Setzen eines Tasks\n"
	  +"gilde del_task <name> : Loescht alle Tasks eines Spielers\n"
	  +"gilde check_task <name> <task> : Checkt ob Spieler einen Task hat\n"
	  +"gilde memberdel <name> : Spieler aus Gilde loeschen\n"
	  +"gilde viewtasks <name> : Zeigt die Tasks eines Spielers\n"
	  +"gilde members : Zeigt alle Barden an.\n"
	  +"gilde bardgroup <name> : Zeigt Gildenrichtung eines Spielers an\n"
	  +"gilde set_bardgroup <name> <bardgroup>: Setzt die Gildenrichtung\n"
    +"----------------------------------------------------------------------------\n"
    +"Befehle fuer Heldenpfade:\n"
    +"gilde set_heropath <name> <pfad>: Setzt den Heldenpfad fuer den spieler\n"
    +"gilde reset_heropath <name> <pfad>: Loescht den Heldenpfad eines Spielers\n"
    +"gilde heropath <name>: Zeigt den Heldenpfad eines Spielers an\n"
    +"gilde swapspells <name> <0|1>: Tauscht Lieder gegen den Heldenpfadsong\n"
	  +"----------------------------------------------------------------------------\n"
	  +"Befehle fuer Testis:\n"
	  +"testibeitritt <bardgroup>: Schneller Beitritt von Testis.\n"
	  +"testiaustritt : Schneller Austritt fuer Testis.\n"
	  +"----------------------------------------------------------------------------\n"
	  );
    return 1;
  }
  
  //AENDERUNGEN IN DAS LOGFILE SPIELEN
  
  txt=explode(str, " ");
  if(member(({"backup", "restore", "set_task", "del_task", "memberdel"}), txt[0])!=-1) {
    if((TP->query_real_name() == "andyl") || IS_ARCH(TP))  
      {
	write_file(LOG("changes"), sprintf("Aenderung im Gildenmaster"
					   +"(%s): gilde %s\n", CAP(getuid(TP)), str));
      }
    else
      {
	write_secure_log(sprintf("Versuchte Aenderung im Gildenmaster (%s) "
				 +"von %s\n", str, CAP(getuid(TP))));
	write("Befehl nicht ausfuehrbar. Grund: Nicht Gildenverantwortlicher und Magierlevel < 60\n");
	return 1;
	
      }
  }

  if(txt[0]=="swapspells") {
    if(sizeof(txt) < 3) {
      write(BS("syntax: gilde swapspells <uid> <0=heldenpfadlied lernen | 1=lernen rueckgaengig>"));
      return 1;
    }

    write(sprintf("Ergebnis: %d\n", BARDENMASTER->SwapHeroPathVariants(find_player(txt[1])  , to_int(txt[2]))));
    return 1;
  }

  if(txt[0]=="set_heropath") {
    if(sizeof(txt) < 3) {
      write(BS("syntax: gilde set_heropath <uid> <pfad>"));
      return 1;
    }

    write(sprintf("Ergebnis: %d\n", BARDENMASTER->SetHeroPath(txt[1], txt[2])));
    return 1;
  }

  if(txt[0]=="reset_heropath") {
    if(sizeof(txt) < 2) {
      write(BS("syntax: gilde reset_heropath <uid>"));
      return 1;
    }

    write(sprintf("Ergebnis: %d\n", BARDENMASTER->ResetHeroPath(txt[1])));
    return 1;
  }

  if(txt[0]=="heropath") {
    if(sizeof(txt) < 2) {
      write(BS("syntax: gilde heropath <uid>"));
      return 1;
    }

    write("Ergebnis: "+BARDENMASTER->GetHeroPath(txt[1])+"\n");
    return 1;
  }
  
  // ABFRAGEN ALLER MITGLIEDER DER BARDENGILDE
  
  if(txt[0]=="members") 
    {
      if(sizeof(txt)<1) 
	{
	  tell_object(TP, "Syntax: gilde members\n");
	  return 1;
	}
      write("Folgende Mitglieder gibt es:\n");
      write(BS(implode(call_other(BARDENMASTER, "QueryMembers"), ", ")));
      return 1;
    } 
  
  // ABFRAGEN DER GILDENRICHTUNG EINES SPIELERS
  
  if(txt[0]=="bardgroup") 
    {
      if(sizeof(txt)<2) 
	{
	  tell_object(TP, "Syntax: gilde bardgroup <name>\n");
	  return 1; 
	}
      name=lower_case(to_string(txt[1]));
      if(!(ob=find_player(name)) && !(ob=find_netdead(name))) 
	{
	  tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
	  return 1;
	}
      write("Folgender Bardengruppe gehoert "+capitalize(name)+" an:\n");
      write(call_other(BARDENMASTER, "GetBardGroup", name)+"\n");
      return 1;
    }
  
  if(txt[0]=="set_bardgroup") 
    {
      if(sizeof(txt)<3) 
	{
	  tell_object(TP, "Syntax: gilde set_bardgroup <name> <bardgroup>\n");
	  return 1; 
	}
      name=lower_case(to_string(txt[1]));
      bardgroup=lower_case(to_string(txt[2]));
      if(!(ob=find_player(name)) && !(ob=find_netdead(name))) 
	{
	  tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
	  return 1;
	}
      err=call_other(BARDENMASTER, "SetBardGroup", ob, bardgroup);
      if(err!=1) 
	{
	  tell_object(TP, sprintf("Fehler. Code %d\n", err));
	  return 1;
	}
      tell_object(TP, "Bardengruppe "+bardgroup+" fuer "+CAP(name)+" gesetzt.\n");
      return 1;
    } 
  
  // ABFRAGEN DER TASKS FUER EINEN SPIELER 
  
  if(txt[0]=="viewtasks") 
    {
      if(sizeof(txt)<2) 
	{
	  tell_object(TP, "Syntax: gilde viewtasks <name>\n");
	  return 1; 
	}
      name=lower_case(to_string(txt[1]));
      if(!(ob=find_player(name)) && !(ob=find_netdead(name))) 
	{
	  tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
	  return 1;
	}
      write("Folgende Tasks hat "+capitalize(name)+" absolviert:\n");
      write(call_other(BARDENMASTER, "ViewTasks", ob)+"\n");
      return 1;
    }

  // CHECKEN OB SPIELER EINEN TASK HAT

  if(txt[0]=="check_task") 
    {
      if(sizeof(txt)<3) 
	{
	  tell_object(TP, "Syntax: gilde check_task <name> <task>\n");
	  return 1; 
	}
      name=lower_case(to_string(txt[1]));
      task=to_int(txt[2]);
      if(!(ob=find_player(name)) && !(ob=find_netdead(name))) 
	{
	  tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
	  return 1;
	}
      if (call_other(BARDENMASTER, "CheckTask", ob, task)==1)
	{
	  write(capitalize(name)+" hat Task "+task+" bereits absolviert.\n");
	  return 1;
	}
      else
	{
	  write(capitalize(name)+" hat Task "+task+" noch nicht absolviert.\n");
	  return 1;
	}
    }
  
  //LOESCHEN EINES GILDENMITGLIEDS
  
  if(txt[0]=="memberdel") 
    {
      if(sizeof(txt)<2) 
	{
	  tell_object(TP, "Syntax: gilde memberdel <name> \n");
	  return 1;
	}
      name=lower_case(to_string(txt[1]));
      err=call_other(BARDENMASTER, "DeleteMember", name);
      if(err!=1)
	tell_object(TP, sprintf("DeleteMember: Fehler. Code %d\n", err));
      else tell_object(TP, "Bardenmaster: DeleteMember ok!\n");
      err=call_other(BARDENMASTER, "DeleteTopEntry", name);
      if(err!=1) 
	tell_object(TP, sprintf("DeleteTopEntry: Fehler. Code %d\n", err));
      else tell_object(TP, "Bardenmaster: DeleteTopEntry ok!\n");
      err=call_other(ABILMASTER, "DeleteEntry", name);
      if(err!=1) 
	tell_object(TP, sprintf("Abilmaster, DeleteEntry: Fehler. Code %d\n", 
				err));
      else tell_object(TP, "Abilmaster: DeleteEntry ok!\n");
      tell_object(TP, "Spieler "+CAP(name)+" aus Gilde geloescht!\n");  
    }
  
  // BACKUP DER GILDENMITGLIEDER
  
  if(txt[0]=="backup") 
    {
      call_other(BARDENMASTER, "DoBackup"); 
      tell_object(TP, "Kopiere members/members.o nach "
		  +"backup/members_backup.o\n");
      return 1;
    }
  if(txt[0]=="restore") 
    {
      if(call_other(BARDENMASTER, "DoRestore")==-2)
	{
	  tell_object(TP, "Fehler! Members.o konnte nicht restored "
		      +"werden!\n");
	  return 1;
	} 
      tell_object(TP, "Kopiere backup/members_backup.o nach "
		  +"members/members.o\n");
      return 1;
    }
  
  //UPDATEN DER TOPLISTE
  
  if(txt[0]=="toplist")
    {
      call_other(BARDENMASTER, "UpdateMemberLevels");
      call_other(BARDENMASTER, "UpdateTopList");
      call_other(BARDENMASTER, "MakeReadList");
      call_other(BARDENMASTER, "SetNumberOne");
      tell_object(TP, "Memberliste ist nun up-to-date.\n");
      return 1;
    }
  
  //SETZEN EINES TASKS FUER EINEN SPIELER
  
  if(txt[0]=="set_task") 
    {
      if(sizeof(txt)<3) 
	{
	  tell_object(TP, "Syntax: gilde set_task <name> <task>\n");
	  return 1;
	}
      task=to_int(txt[2]);
      name=lower_case(to_string(txt[1]));
      if(!(ob=find_player(name)) && !(ob=find_netdead(name))) 
	{
	  tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
	  return 1;
	}
      err=call_other(BARDENMASTER, "SetTask", ob, task);
      if(err!=1) 
	{
	  tell_object(TP, sprintf("Fehler. Code %d\n", err));
	  return 1;
	}
      tell_object(TP, "Task "+task+" fuer "+CAP(name)+" gesetzt.\n");
      return 1;
    } 
  
  //LOESCHEN ALLER TASKS EINES SPIELERS
  
  if(txt[0]=="del_task") 
    {
      if(sizeof(txt)<2) 
	{
	  tell_object(TP, "Syntax: gilde del_task <name>\n");
	  return 1;
	}
      name=lower_case(to_string(txt[1]));
    if(!(ob=find_player(name)) && !(ob=find_netdead(name))) 
      {
	tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
	return 1;
      }
    err=call_other(BARDENMASTER, "DeleteTask", ob);
    if(err!=1) 
      {
	tell_object(TP, sprintf("Fehler. Code %d\n", err));
	return 1;
      }
    tell_object(TP, "Alles Tasks von "+CAP(name)+" geloescht.\n");
    return 1;
    }
  
  tell_object(TP, "Ungueltiger Befehl!\n");
  return 1;
}

// DIE BESTENLISTE

topliste(str)
{
  notify_fail("Was fuer eine Topliste moechtest Du Dir ansehen?\n");
  if (!str)
    {
      
      tell_object(TP, "\n,-=-=-=-=-=-=-=-=-=-=-=-=-=-=.\n"
		  +"| DIE BESTEN DER BARDENGILDE |"
		  +"\n=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"
		  +"=-=-=-=-=-=-=-=-=-=-=-=-\n");
      TP->More(currentToplist);
      tell_room(TO, BS(sprintf("%s schaut sich die Topliste an.", 
			       TP->Name(WER))), ({TP}));
      return 1;
    }
  
  if (str=="alestra")
    {
      tell_object(TP, "\n,-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-.\n"
		  +"| DIE BESTEN BARDEN VON ALESTRA |"
		  +"\n=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"
		  +"=-=-=-=-=-=-=-=-=-=-=-=-\n"); 
      TP->More(ALESTRATOPLIST, 1);
      tell_room(TO, BS(sprintf("%s schaut sich die Topliste "
			       +"der Barden von Alestra an.", 
			       TP->Name(WER))), ({TP}));
      return 1; 
    }
  
  if (str=="tirena")
    {
      tell_object(TP, "\n,-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=.\n"
		  +"| DIE BESTEN BARDEN VON TIRENA |"
		  +"\n=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"
		  +"=-=-=-=-=-=-=-=-=-=-=-=-\n");
      TP->more(TIRENATOPLIST, 1);
      tell_room(TO, BS(sprintf("%s schaut sich die Topliste "
			       +"der Barden von Tirena an.", 
			       TP->Name(WER))), ({TP}));
      return 1; 
    }
  
  if (str=="sarrian")
    {
      tell_object(TP, "\n,-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-.\n"
		  +"| DIE BESTEN BARDEN VON SARRIAN |"
		  +"\n=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"
		  +"=-=-=-=-=-=-=-=-=-=-=-=-\n");   
      TP->more(SARRIANTOPLIST, 1);
      tell_room(TO, BS(sprintf("%s schaut sich die Topliste "
			       +"der Barden von Sarrian an.", 
			       TP->Name(WER))), ({TP}));
      return 1;
    }
  
  if (str=="korriax")
    {
      tell_object(TP, "\n,-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-.\n"
		  +"| DIE BESTEN BARDEN VON KORRIAX |"
		  +"\n=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"
		  +"=-=-=-=-=-=-=-=-=-=-=-=-\n");   
      TP->more(KORRIAXTOPLIST, 1);
      tell_room(TO, BS(sprintf("%s schaut sich die Topliste "
			       +"der Barden von Korriax an.", 
			       TP->Name(WER))), ({TP}));
      return 1;
    } 
  return 0;
}


// AUTOMATISCHES BACKUP DER MEMBERLISTE UND DER TOPLISTE

reset()
{
  ::reset();
  zaehler++;
  if(zaehler==1) {
    call_other(BARDENMASTER, "UpdateTopList");
    call_other(BARDENMASTER, "MakeReadList");
    call_other(BARDENMASTER, "SetNumberOne");
  }
  if(zaehler==5) {
    call_other(BARDENMASTER, "DoBackup"); 
    zaehler=0;
  }

  LoadCurrentTopList();
}


// SKILLABILITY AM ANFANG IN EINEN BEREICH 3000..5000 SETZEN

nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if(value<3000) value=3000;
  else if(value>5000) value=5000;
  return value;
}

// WAR WOHL NIX ;P

int falscher_syntax()
{
  string not_fail;
  if(!present("artyrian", TO)) {
    write(BS("Ohne Artyrian geht das nicht!\n"));
    return 1;
  }
  
  not_fail="Welcher Gruppe von Barden willst Du denn beitreten? " 
    +"Den Barden von Alestra, von Tirena, von Korriax oder von Sarrian? "
    +"Wenn Du willst kann ich Dir vorher auch etwas ueber die einzelnen Gruppen erzaehlen. " 
    +"Solltest Du Dich dann entschieden haben dann benutze folgende "
    +"Syntax: `tritt barden von <xxxx> bei'\n";
  write(BSA(not_fail, "Artyrian teilt Dir mit: "));
  return 1;
}


// AUSTRITT AUS DER GILDE

int leave() {
  object artyrian;
  if(!artyrian=present(GUILDNPC_ID, ME)) {
    write("Ohne Artyrian geht das nicht!\n");
    return 1;
  }
  if(!IsGuildMember(TP)) {
    write("Du bist ja gar kein Mitglied der Bardengilde!\n");
    return 1;
  }
  artyrian->SetProp(P_NOATTACK, "hat gerade keine Zeit.\n");
  artyrian->SetProp(P_CHAT_CHANCE, 0);
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:-1, PARALYZE_MSG:"", 
  PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  LoadSequenz(LEVELSEQ("leave"), TP, CLOSURE(austreten));  
  return 1;
}

private void removeSkills(object pl) {
  mixed *skills;
  int i;

  skills = m_indices(pl->QueryProp(P_NEWSKILLS));
  for(i=0;i<sizeof(skills);++i) {
    pl->SetProp(P_NEWSKILLS, m_delete(pl->QueryProp(P_NEWSKILLS), skills[i]));
  }
  return;
}

int austreten() {
  object ob;
  
  resetEverythingAfterSequence();

  this_player()->SetProp(P_GUILD_LEVEL, 0);
  WLOG("/log/gilden/barden", "tritt aus der Gilde aus");
  if(ob=present("\nbardenbrosche",TP)) {
      ob->SetProp(P_CURSED, 0);
      ob->remove();
    }
  call_other(BARDENMASTER, "DeleteMember", TP);
  call_other(BARDENMASTER, "DeleteTopEntry", getuid(TP));
  call_other(ABILMASTER, "DeleteEntry", getuid(TP));
  rm(LOG(getuid(TP)+".log"));

  // notwendig um pfadrelevante zauber zu verlernen
  removeSkills(TP);

  TP->SetProp(P_PARALYZED, 0);

  Channel(CAP(getuid(TP))+" ist gerade aus der Bardengilde ausgetreten.");
  return ::austreten();
}

int testiaustritt()
{
  object ob;
  if((TP->QueryProp(P_TESTPLAYER)==0))
    {
      write(BSA("Du bist kein Testspieler, du darfst das nicht.\n", "Artyrian sagt: "));
      return 1;
    }
  
  if(!IsGuildMember(TP))
    {
      write(BSA("Aber du bist kein Gildenmitglied. Abbruch.\n", "Artyrian sagt verwundert: "));
      return 1;
    }
  this_player()->SetProp( P_GUILD_LEVEL, 0);
  WLOG("/log/gilden/barden", "tritt aus der Gilde aus");
  if(ob=present("\nbardenbrosche",TP)) 
    {
      ob->SetProp(P_CURSED, 0);
      ob->remove();
    }
  call_other(BARDENMASTER, "DeleteMember", TP);
  call_other(BARDENMASTER, "DeleteTopEntry", getuid(TP));
  call_other(ABILMASTER, "DeleteEntry", getuid(TP));
  rm(LOG(getuid(TP)+".log"));  
  write((TP->name(WER, 0))+" ist aus den Barden ausgetreten.\n"); 
  return ::austreten();
}

int testibeitritt(string grichtung)
{
  int b;
  object ob;
  
  if((TP->QueryProp(P_TESTPLAYER)==0))
    {
      write(BSA("Du bist kein Testspieler, du darfst das nicht.\n", "Artyrian sagt: "));
      return 1;
    }
  
  if(IsGuildMember(TP))
    {
      write(BSA("Aber du bist schon ein Gildenmitglied. Abbruch.\n", "Artyrian sagt verwundert: "));
      return 1;
    }
  
  if(grichtung!="alestra" && grichtung!="tirena" && grichtung!="korriax" && grichtung!="sarrian")
    {
      write(BSA("Keine korrekte Gildenrichtung angegeben. Abbruch.\n", "Artyrian sagt verwundert: "));
      return 1; 
    }
  
  if ((TP->QueryProp(P_RACE))=="troll")
    {
      write(BSA((TP->name(WER, 0))+" du ist Troll. Trolle duerfen nicht. Abbruch.\n", "Artyrian teilt Dir mit: "));
      return 1;
    }
  
  if ((TP->QueryProp(P_RACE))=="oger")
    {
      write(BSA((TP->name(WER, 0))+" du bist Oger. Oger duerfen nicht. Abbruch.\n", "Artyrian teilt Dir mit: "));
      return 1;
    }

  if (b = ::beitreten() < 0) return 1;
  
  call_other(BARDENMASTER, "AddMember", TP, TP->QueryProp(P_XP), TP->QueryProp(P_LEVEL));
  call_other(BARDENMASTER, "SetBardGroup", TP, grichtung);
  call_other(BARDENMASTER, "AdvanceLevel", TP);
  
  ob=clone_object(ARMOUR("bbrosche"));
  ob->move(TP, M_NOCHECK);
  
  // BRAV LOGGEN :)
  
  WLOG("/log/gilden/barden", "tritt in die Gilde ein.\n");
  
  LearnSkills(TP); 
  write_file(MEMBER_LOG(getuid(TP)+".log"),
	     dtime(time())+": "+CAP(getuid(TP))+" ist "
             +"in die Gilde eingetreten.\n");
  write((TP->name(WER, 0))+" ist den Barden von "+capitalize(grichtung)+" beigetreten.\n");
  return 1;
}

// GILDENBEITRITT

int tritt(string str)
{
  object ob;
  string gruppe;
  string not_fail;
  if(!present("artyrian", TO)) 
    {
      write(BS("Ohne Artyrian geht das nicht!\n"));
      return 1;
    } 
  
  if ((TP->QueryProp(P_GUILD))=="bardengilde")
    {
      if ((str=="aus gilde aus" || str=="aus" || str=="aus bardengilde aus"))
	{
	  write(BS("Die Syntax fuers Austreten ist 'austritt'.\n"));
	  return 1;
	}
      else return 0;
    }
  
  not_fail="Welcher Gruppe von Barden willst Du denn beitreten? " 
    +"Den Barden von Alestra, von Tirena, von Korriax oder von Sarrian? "
    +"Wenn Du willst kann ich Dir vorher auch etwas ueber die einzelnen Gruppen erzaehlen. " 
    +"Solltest Du Dich dann entschieden haben dann benutze folgende "
    +"Syntax: `tritt barden von <xxxx> bei'\n";
  if (!str)
    {
      write(BSA(not_fail, "Artyrian teilt Dir mit: "));
      return 1;
    }
  
  if(sscanf(str, "barden von %s bei", gruppe)!=1)
    {
      write(BSA(not_fail, "Artyrian teilt Dir mit: "));
      return 1;
    }
  
  if(gruppe!="alestra" && gruppe!="tirena" && gruppe!="korriax" && gruppe!="sarrian")
    {
      write(BSA(not_fail, "Artyrian teilt Dir mit: "));
      return 1;
    }
  
  if (member(({"troll", "oger"}), lowerstring(this_player()->QueryProp(P_RACE))) != -1 && gruppe != "korriax") {
    write(BSA("Tut mir leid "+(TP->name(WER, 0))+", aber Trolle und Oger koennen nur den Barden von "
              "Korriax beitreten. Fuer alle anderen fehlt euch das Geschick!", "Artyrian teilt Dir mit: "));
    return 1;
  }
  
  // HIER NOCH CHECKEN OB SPIELER DIE ANFORDERUNGEN ERFUELLT, WIE ETWA DAS BENOETIGTE
  // SPIELERLEVEL/XP ETC.

  ob = present("\nbarden_empfehlung", this_player());
  if (!objectp(ob)) {
    write(BSA("Ohne Empfehlungsschreiben kannst Du kein Mitglied der Bardengilde werden, "+(TP->name(WER, 0))+
              ". Du koenntest aber versuchen Dir bei Serona ein solches zu besorgen.\n", "Arytrian meint: ")); 
    return 1;
  }
  ob->remove(1);
      
  // DIE BEITRITTSSEQUENZ KANN STARTEN 

  bardgroup=gruppe;
  return beitreten();  
}

// BEITRETEN2 WIRD VON BEITRETEN AUFGERUFEN !!!

int beitreten2()
{
  object ob;
  
  // BROSCHE FUER SPIELER
  ob=clone_object(ARMOUR("bbrosche"));
  ob->move(TP, M_NOCHECK);
  
  // BRAV LOGGEN :)
 
  WLOG("/log/gilden/barden", "tritt in die Gilde ein.\n");
  
  // HIER MUESSEN DIE SKILLS NOCH (ETWAS) RANDOMMAESSIG MODIFIZIERT WERDEN
  
  TP->ModifySkill(SK_SINGING, QuerySkill(SK_SINGING),100,"bardengilde");
  TP->ModifySkill(SK_MUSIC, QuerySkill(SK_MUSIC),100, "bardengilde" );
  write_file(MEMBER_LOG(getuid(TP)+".log"),
	     dtime(time())+": "+CAP(getuid(TP))+" ist "
             +"in die Gilde eingetreten.\n");
  Channel(CAP(getuid(TP))+" ist gerade in die Bardengilde eingetreten.");

  TP->SetProp(P_PARALYZED, 0);
  resetEverythingAfterSequence();
  return 1;
} 

// BEITRITTSFUNKTIONEN (WIRD VON TRITT AUFGERUFEN)

int beitreten()
{
  int b;
  object artyrian;
  if(IsGuildMember(TP))
    {
      write(BSA("Aber Du bist doch schon bei den Barden!", "Artyrian sagt laechelnd: "));
      return 1;
    }

  if( (b = ::beitreten()) < 0) return 1;
  

  call_other(BARDENMASTER, "AddMember", this_player(), this_player()->QueryProp(P_XP), this_player()->QueryProp(P_LEVEL));
  call_other(BARDENMASTER, "SetBardGroup", TP, bardgroup);
  bardgroup="";
  call_other(BARDENMASTER, "AdvanceLevel", TP);
  
  // ARTYRIAN SOLL NICHTS MEHR SPRECHEN UND AUCH NICHT KAEMPFEN
  
  if(!artyrian=present(GUILDNPC_ID, ME)) 
    {
      write("Ohne Artyrian geht das nicht!\n");
      return 1;
    }
  artyrian->SetProp(P_NOATTACK,1);
  artyrian->SetProp(P_CHAT_CHANCE,0); 
  
  // DEN SPIELER STONEN NICHT VERGESSEN ;)
  
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:-1, PARALYZE_MSG:"", 
  PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  
   // ARTYRIAN UNANSPRECHBAR MACHEN
   
   // not implementet yet...
  
   // HIER KOMMEN JETZT DIE VIER VERSCHIEDENEN EINSTIEGSSEQUENZEN
   // JE NACH BARDENGRUPPE
 
   if(!LoadSequenz(LEVELSEQ("entry"), TP, CLOSURE(beitreten2))) {
     write("FEHLER BEI SEQUENZ!!\n");
     TP->QueryProp(P_PARALYZED, 0);
   }
   return 1;
}

// WIRD VON "advancelevel" AUGERUFEN, NACHDEM DIE SEQUENZ GELAUFEN IST

public void advancelevel2() {
  Channel(CAP(getuid(TP))+" hat den " +TP->QueryProp(P_GUILD_LEVEL)+". Grad der Bardengilde erreicht.");	
  TP->SetProp(P_PARALYZED, 0);
  resetEverythingAfterSequence();  
}


// AUFSTIEG

nosave string NeedMoreXP(object pl, int xp) {
  string str;
  int percent, x;
  str="";
  str=" Du musst noch mehr Erfahrung sammeln. Geh hinaus in die Welt! "
      "Von den Erfahrungspunkten, die Du benoetigst, fehlen Dir ";
  x=call_other(BARDENMASTER, "GetXpDifference", pl, 
               pl->QueryProp(P_XP));
  percent=100*x/xp;
  switch (percent)
   {
     case  0..10:  str+="nur mehr ganz wenige. ";     break;
     case 11..20:  str+="weniger als ein Viertel. ";  break;
     case 21..30:  str+="etwa ein Viertel. ";         break;
     case 31..40:  str+="weniger als die Haelfte. ";  break;
     case 41..50:  str+="etwa die Haelfte. ";         break;
     case 51..60:  str+="mehr als die Haelfte. ";     break;
     case 61..70:  str+="weniger als drei Viertel. "; break;
     case 71..80:  str+="etwa drei Viertel. ";        break;
     case 81..90:  str+="mehr als drei Viertel. ";    break;
     case 91..99 : str+="beinahe alle. ";             break;
     case 100    : str+="alle. ";                     break;
     default:      str+="viel mehr als gefordert. ";  break; 
   }
  return str;
}

public int advancelevel(string str) {
    string spell1, spell2, bardgroup, restr;
    object artyrian;

    if(!artyrian=present(GUILDNPC_ID, ME)) {
        write("Ohne Artyrian geht das nicht!\n");
        return 1;
    }

    if(TP->QueryProp(P_GUILD)!="bardengilde")  {
      write(BSA("Dazu solltest du ja vielleicht erst den Barden beitreten!\n", "Artyrian meint lachend: "));
      return 1;
    }

    /*if(TP->QueryProp(P_GUILD_LEVEL) >= 8) {
      write(BSA("Diesen Grad kannst du derzeit noch nicht erlangen!", "Artyrian meint: "));
      say(BSA("Diesen Grad kannst du derzeit noch nicht erlangen, "+CAP(getuid(TP))+"!\n", "Artyrian meint: "));
      return 1;
    }*/

    if(TP->QueryProp(P_GUILD_LEVEL)>=15) {
      if(TP->QueryProp(P_GENDER)==MALE) {
        write(BSA("Du bist doch schon ein Meisterbarde!\n", "Artyrian meint: "));
        say(BSA("Du bist doch schon ein Meisterbarde, "+CAP(getuid(TP))+"!\n", "Artyrian meint: "));
      } else {
        write(BSA("Du bist doch schon eine Meisterbardin!\n", "Artyrian meint: "));
        say(BSA("Du bist doch schon eine Meisterbardin, "+CAP(getuid(TP))+"!\n", "Artyrian meint: "));
      }
      return 1;
    }

    restr = call_other(RES_CHECKER, "check_restrictions", TP, QueryProp(P_GUILD_LEVELS)[TP->QueryProp(P_GUILD_LEVEL)+1]);
    if(!call_other(BARDENMASTER, "CheckXp", TP, TP->QueryProp(P_XP)) && !IS_WIZARD(TP)) {
      if(!restr) restr = "";
      restr += NeedMoreXP(TP, XP_PER_LEVEL[TP->QueryProp(P_GUILD_LEVEL)-1]);
    }

    if(restr != 0)  {
      tell_room(ENV(TP), BSA(sprintf("Du erfuellst nicht alle Anforderungen, fuer den naechsten Grad, %s! %s\n", 
      TP->Name(WER), restr), "Artyrian sagt: "));
    }

    if(restr != 0) {
      return 1;
    }

    if(!::advance()) {
      write("Aufstieg abgebrochen.\n");
      return 1;
    }
      
    // ARTYRIAN WIRD LEISE UND FRIEDLICH
    artyrian->SetProp(P_NOATTACK,1);
    artyrian->SetProp(P_CHAT_CHANCE,0);
    
    // SPIELER STONEN NICHT VERGESSEN ;)
    TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:-1, PARALYZE_MSG:"", 
    PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
          
    call_other(BARDENMASTER, "AdvanceLevel",TP);
    write_file(MEMBER_LOG(getuid(TP)+".log"), dtime(time())+": "+CAP(getuid(TP))+" ist eine Stufe aufgestiegen.\n"); 
    
    LoadSequenz(LEVELSEQ("advance_level"), TP, CLOSURE(advancelevel2));
    return 1;
}

//
// SENDEN AUF DEM CHANNEL INFO
//

// Hier erfolgt die Ausgabe auf den Channel
void Channel(string msg)
{
    call_other(CHMASTER, "join","Info", this_object());
    call_other(CHMASTER, "send", "Info", TO, msg, MSG_SAY);
}

//
// AUSGABE DER FERTIGKEITEN
//

private void printSkillsForWizard() {
  string *arm, s;
  int i, wert;
  mapping res;

  write(BSA("Soviel hast du Magierwurschtl bisher gelernt: ", "Artyrian sagt: "));
  s="";
  res = this_player()->QueryProp(P_NEWSKILLS);
  arm=sort_array(m_indices(res), #'<); //')
  for (i = sizeof(arm)-1;i>=0;i--)
  {
    s += arm[i]+": ";
    if (mappingp(res[arm[i]])) s += res[arm[i]][SI_SKILLABILITY];
    else s += res[arm[i]];
    s += "\n";
    write(BSA(s, "Artyrian sagt: "));
    s="";
  }
  return;
}

private void printSkills(object pl) {
  string *arm, s;
  int i, wert;
  mapping res, sinfo;

  write(BSA("Soviel hast du bisher gelernt: ", "Artyrian sagt: "));

  s="";
  res=pl->QueryProp(P_NEWSKILLS);
  arm=sort_array(m_indices(res), #'<); //')
  for (i = sizeof(arm)-1;i>=0;i--)
  {
	  if(lowerstring(arm[i])!="singen" && lowerstring(arm[i])!="musizieren" && strstr(lowerstring(arm[i]), "heldentum_", 0) == -1)
	  {
      sinfo = call_other("/spellbooks/barden_spells", "QuerySpell", arm[i]);
	    s += sinfo[SI_CAP_NAME]+" beherrscht Du";
	    wert=pl->QuerySkillAbility(arm[i]);   
	    s+=int2string(wert);
	    write(BSA(s, "Artyrian sagt: "));
	    s="";         
	  }
  }   

  s=int2string(pl->QuerySkillAbility(SK_MUSIC));
  write(BSA("Du musizierst"+s,"Artyrian sagt: "));
  s=int2string(pl->QuerySkillAbility(SK_SINGING));
  write(BSA("Und Du singst"+s, "Artyrian sagt: "));
  if(BARDENMASTER->GetHeroPath(pl) != 0) {
    s = int2string(pl->QuerySkillAbility(SK_HEROISM(BARDENMASTER->GetHeroPath(pl))));
    write(BSA(sprintf("Den Helden %s verkoerperst du %s", capitalize(BARDENMASTER->GetHeroPath(pl)), s), "Artyrian sagt: "));
  }


  if((wert=pl->QueryProp(P_GUILD_RATING))<1501) wert=1501;
  s=int2string(wert);

  write(BSA("Insgesamt betrachtet bist Du"+s, "Artyrian sagt: ")); 
  say(sprintf("Artyrian klaert %s ueber %se Fertigkeiten auf.\n", CAP(getuid(TP)), pl->QueryPossPronoun(WESSEN)));
  return;
}

int faehigkeiten()
{
  if(IS_WIZARD(this_player()))
  {
    printSkillsForWizard();
    return 1;   
  }

  if(!IsGuildMember(this_player()))
  {
    write(BSA("Du bist kein Mitglied der Bardengilde. Willst du nicht vielleicht eines werden?", 
              "Artyrian sagt: "));
    return 1;
  }

  printSkills(this_player());
  return 1;
}


// FERTIGKEITSWERT IN ENTSPRECHENDE AUSGABE UMWANDELN

string int2string(int wert)
{
 string str;
 switch(wert) 
       {
	case 0..500 : str=" zum Davonlaufen.\n";
                        break;
	case 501..1000: str=" absolut miserabel.\n"; 
                        break;
	case 1001..1500: str=" elendiglich.\n";
                        break;
	case 1501..2000: str=" sehr schlecht.\n";
                        break;
	case 2001..2500: str=" schlecht.\n";
                        break;
	case 2501..3000: str=" nicht besonders.\n";
                        break;
	case 3001..3500: str=" einigermassen passabel\n";
                        break;
	case 3501..4000: str=" passabel.\n";
                        break;
	case 4001..4500: str=" unterdurchschnittlich\n";
                        break;
	case 4501..5000: str=" durchschnittlich.\n";
                        break;
	case 5001..5500: str=" ueberdurchschnittlich.\n";
                        break;
        case 5501..6000: str=" gut.\n";
                        break;
        case 6001..6500: str=" sehr gut.\n";
                        break;
        case 6501..7000: str=" wirklich toll.\n";
                        break;
        case 7001..7500: str=" hervorragend.\n";
                        break;
        case 7501..8000: str=" ausgezeichnet.\n";
                        break;
        case 8001..8500: str=" einfach wunderbar.\n";
                        break;
        case 8501..9000: str=" exzellent.\n";
                        break;
        case 9001..9500: str=" unglaublich gut.\n";
                        break;
        case 9501..9999: str=" virtuos.\n";
                        break;
        case 10000: str=" unuebertreffbar.\n";
                        break;
        default: str=" ueberhaupt nicht.\n";
       } 
return str;
}

