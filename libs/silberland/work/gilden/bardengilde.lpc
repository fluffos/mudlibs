public void resetEverythingAfterSequence() {
  object artyrian;
  artyrian = present("artyrian", this_object());
  if(objectp(artyrian)) {
    artyrian->SetProp(P_NOATTACK, 0);
    artyrian->SetProp(P_CHAT_CHANCE, 2);
  }
}

public string LoadCurrentTopList() {
  currentToplist = read_file(REALTOPLIST);
  return currentToplist;
}

public void create()
