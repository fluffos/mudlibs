public int GuildRating(object pl) {
  return call_other(BARDENMASTER, "GuildRating", pl);
}

void play_seq(string seq) {
  write("Play... "+seq+"\n");
  LoadSequenz(seq, TP, #'play_seq1);
  return ;
}

void init() {
    ::init();
    if(!objectp(TP)) return;
    if("bardengilde" != TP->QueryProp(P_GUILD)) return;

    LearnSkills(TP);
}

void LearnSkills(object pl) {
    if(!mappingp(pl->QuerySkill(SK_MUSIC))) {
        pl->ModifySkill(SK_MUSIC, QuerySkill(SK_MUSIC),0,"bardengilde");
        debugMsg("Gelernt: " + SK_MUSIC +"\n");
    }


    if(!mappingp(pl->QuerySkill(SK_SINGING))) {
        TP->ModifySkill(SK_SINGING, QuerySkill(SK_SINGING),0, "bardengilde" );
        debugMsg("Gelernt: " + SK_MUSIC +"\n");
    }
}

void debugMsg(string str) {
    if(TP->QueryProp(P_TESTPLAYER) || IS_WIZARD(TP)) {
        write(str);
    }
} 
