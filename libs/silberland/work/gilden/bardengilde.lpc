// SKILL SINGEN LERNEN

void LearnSinging(object user, mapping sinfo, int alc)
{
  int abil, max;
  abil=sinfo[SI_SKILLABILITY];
  if(abil>max) abil=max;
  user->ModifySkill( SK_SINGING, abil);
}

// SKILL MUSIZIEREN LERNEN

void LearnMusic(object user, mapping sinfo, int alc)
{
  int abil, max;
  abil=sinfo[SI_SKILLABILITY];
  if(abil>max) abil=max;
}


/* ----------------------------------------
   Die Skillfunktionen
   ---------------------------------------- */
void CheckAndLearnSkill(object player, string skill, int abil, int attribute) {
    int x, learnValue, learnDifficulty;

    learnDifficulty = ((MAX_ABILITY - abil) / 2) * 3;

    if(random(MAX_ABILITY) <= learnDifficulty || !random(30)) {       
      learnValue = attribute/4;
      abil += learnValue;
      player->ModifySkill(skill, abil, 0, "bardengilde");
    }

    if (abil < MAX_ABILITY && player->QuerySkill(skill)[SI_SKILLABILITY] == MAX_ABILITY) {
      player->Message(sprintf("Artyrian teilt Dir mit: Du kannst %s nun absolut perfekt!\n", skill), MSGFLAG_TELL);
    }
}

private void activateInspirationEffect(object bard) {
  tell_object(bard, BS("Deine Inspiration befluegelt ueberirdische Virtuositaet!"));
  bard->SetProp(P_BARD_TMP_NEXT_SPELL_IS_MAX_SUCCESS, 1);

  call_other(TALENTMASTER, "InspirationBurst", bard);
}

private void checkInspirationEffects(object bard) {
  if(random(100) < bard->QueryProp(P_BARD_INSPIRATION_LEVEL)*5) {
    activateInspirationEffect(bard);
  }
  return;
}

private int applySkill(object player, string skill, string attr, mapping sinfo) {
  int abil, a;

  abil = sinfo[SI_SKILLABILITY];
  a = player->QueryAttribute(attr);
  CheckAndLearnSkill(player, skill, abil, a);

  checkInspirationEffects(player);

  return random(sinfo[SI_SKILLABILITY]);
}

public int Singen(object player, string skill, mapping sinfo) {
    int success;
    success = applySkill(player, skill, A_INT, sinfo);

    if(TALENTMASTER->HasTalent(player, TALENT_ANGENEHME_STIMME)) {
      success = (int) (success * (player->QueryProp(P_BARD_INSPIRATION_LEVEL)/100.0));
    }

    TALENTMASTER->HeroAura(player, SK_SINGING);

    return success;
}

public int Musizieren(object player, string skill, mapping sinfo) {
  int success;
  success = applySkill(player, skill, A_DEX, sinfo);

  if(TALENTMASTER->HasTalent(player, TALENT_FLINKE_FINGER)) {
    success = (int) (success * (player->QueryProp(P_BARD_INSPIRATION_LEVEL)/100.0));
  }

  TALENTMASTER->HeroAura(player, SK_MUSIC);

  return success;
}

public mapping Khartak_FightSkill(object player, string skill, mapping sinfo) {
  int success, bonus;

  if(!BARDENMASTER->HasHeroPathLevel(player, HERO_KHARTAK, 3)) return sinfo; // hat den skill gar nicht
  if(sinfo[P_WEAPON_TYPE] == WT_HANDS) return sinfo; // nur bewaffneter nahkampf zaehlt

  success = player->UseSkill(SK_HEROISM(HERO_KHARTAK));

  bonus = (success/300) + player->QueryProp(P_BARD_INSPIRATION_LEVEL) * 10;
  if(bonus < 0) bonus = 0;

  tell_object(player, sprintf("khartak_fighting :: success = %d damage = %d  bonus = %d\n", success, sinfo[SI_SKILLDAMAGE], bonus));
  sinfo[SI_SKILLDAMAGE] += bonus/2 + random(bonus/2);
  return sinfo;
}

public int Heroism(object player, string skill, mapping sinfo) {
  int success, roll, maxLearn;
  string heroName;

  roll = random(MAX_ABILITY-(sinfo[SI_SKILLABILITY]==MAX_ABILITY?2000:0));
  success = sinfo[SI_SKILLABILITY] - roll;

  // Lernen
  if(success <= 0) { //&& !random(32 - player->QueryAttribute(A_INT)) && sinfo[SI_SKILLABILITY] < MAX_ABILITY) {
    heroName = capitalize(explode(skill, "_")[1]);

    if(BARDENMASTER->HasHeroPathLevel(player, lowerstring(heroName), 3))
      maxLearn = MAX_ABILITY;
    else if(BARDENMASTER->HasHeroPathLevel(player, lowerstring(heroName), 2)) {
      maxLearn = 8000;
    } else {
      maxLearn = 4000;
    }

    if(player->QueryProp(P_TESTPLAYER)) tell_object(player, sprintf("Herosim(%s) :: learn :: maxLearn = %d currentSkill = %d\n", heroName, maxLearn, sinfo[SI_SKILLABILITY]));

    if(sinfo[SI_SKILLABILITY] < maxLearn) {
      sinfo[SI_SKILLABILITY] = sinfo[SI_SKILLABILITY] + 1 + random(player->QueryAttribute(A_INT) / 10);
      if(!random(4)) tell_object(player, BS(sprintf("Du verkoerperst das Heldentum von %s jetzt etwas besser.", heroName)));

      if(sinfo[SI_SKILLABILITY] >= MAX_ABILITY) {
        tell_object(player, BS(sprintf("Du bist nun die personifizierte Verkoerperung von %s!", heroName)));
        sinfo[SI_SKILLABILITY] = MAX_ABILITY;
      }
    }
  }

  sinfo[SI_USR] = sinfo[SI_USR] + 1;

  player->ModifySkill(skill, ([SI_USR: sinfo[SI_USR], SI_SKILLABILITY: sinfo[SI_SKILLABILITY]]), 0, "bardengilde");
  return success;
}

