
inherit "/std/gilden_room";
inherit "/std/living/std_skills";

#include <properties.h>
#include <rooms.h>
#include <wizlevels.h>
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <new_skills.h>
#include <config.h>
#include <moredef.h>

#include "/gilden/zauberer/zauberer.h"
