mapping StickFight(object user, string sname, mapping sinfo)
{
  int ability, success, damage, skillbonus, bonus;
  object stick;

  // Kein Spellinfo
  if (!mappingp(sinfo)) return 0;

  if (!objectp(sinfo[SI_ENEMY])) return sinfo;

  // Waffe ist nicht der Zauberstab
  if (!objectp(stick = user->QueryProp(P_WEAPON)) 
      || !stick->id("\nzauberer_stab")) return 0;

  ability = sinfo[SI_SKILLABILITY];

  success = random(ability+2);

  bonus = ability/100;

  damage = sinfo["si_damage"] + bonus;

  Debug(sprintf("Success: %d, Dam: %d, NewDam: %d", success, sinfo["si_damage"], damage));
  

  if (!success)
     {
       // Traraa! Ein Patzer :-)
       // Caster und Enemy werden vertauscht :)
       tell_object(user, BS("Du verfehlst " 
         + sinfo[SI_ENEMY]->name(WEN) + " und triffst "
                            "Dich selbst."));
       tell_room(ENV(user), BS(user->Name(WER) + " verfehlt " +
         sinfo[SI_ENEMY]->name(WEN) + " und trifft sich selbst mit " + user->QueryPossPronoun(MALE, WEM, SINGULAR) + " Stab."), ({ user }));
       sinfo[SI_ENEMY] = user;
       user->Defend(sinfo["si_damage"], sinfo["si_damtyp"], 0, user);
       return 0;
     }

  Debug(sinfo);

  (void) DoLearn(user, FIGHT(WT_CLUB), sinfo);

  return sinfo;
 }


int DoLearn(object pl, string skill, mapping sinfo)
{
  int ability, max_ability, difficulty, guild_level, randbase;

  guild_level = 
    pl->QueryProp(P_GUILD_LEVEL) * pl->QueryProp(P_GUILD_CIRCLE);  

  max_ability = Z_FORMULA(guild_level);

  ability = sinfo[SI_SKILLABILITY];

  if (ability < 100)
    randbase = ability >= 2 ? ability : 2;
  else
    randbase = ability + sinfo["si_difficulty"];

  if (ability < max_ability && !random(randbase))
    {
      pl->ModifySkill(skill, 
            ([SI_USR: sinfo[SI_USR]+1, SI_SKILLABILITY: ability+1]),
            "zauberer");
      return 1;
    }

  return 0;
}
