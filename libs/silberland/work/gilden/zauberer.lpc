#define SIG(x) (x?(x>0?1:-1):0)


/* PROTOTYPES */

// Zauber lernen
int cmd_learn (string str);
// Gilde beitreten
int cmd_beitritt ();
// Austreten
int cmd_austritt ();
// Initialisierung
int zauberer_init(object pl);
// Spell lernen
int DoLearn(object pl, string skill, mapping sinfo);

/* FUNCTIONS */
void create() {
  gilden_room::create();

  seteuid(getuid(this_object()));

  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"zauberer_spells");

  SetProp(P_GUILD_RESTRICTIONS,
      ([P_LEVEL: 6,A_INT  : 10, P_QP   : 30, 
        SR_FUN : "join_testfunc", ]) );

  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT,"Die Gilde der Zauberer");
  SetProp(P_INT_LONG, "Du befindest Dich hier im Zimmer des obersten "
    "Zauberer. Hier geht er emsig seinen Studien nach, und empfaengt "
    "seine Schueler. Anden Waenden haengen grosse, rote Banner mit "
    "goldenen Streifen und Symbolen in der Mitte. Den Boden ziert "
    "ein riesiges, magisches Symbol. Eine der Waende ist voll mit "
    "Regalen voller Buecher, waehrend an einer anderen ein "
    "Schreibtisch nahe eines Fensters steht.");

  AddDetail( ({ "zauberer" }),
    "Hier lebt Kandurah - der oberste aller Zauberer.");
  AddDetail( ({ "stuidien" }),
    "Kandurar studiert hier die Lehre der Magie.");
  AddDetail( ({ "lehrer" }),
    "Hier wird Magie glernt und gelehrt.");
  AddDetail( ({ "schueler" }),
    "Du koenntest auch ein Schueler von Kandurah werden - wenn "
    "Du nicht schon einer bist.");
  AddDetail( ({ "waende" }),
    "An den Waenden haengen riesige, rote Banner. Eine der Waende ist "
    "voll von Buecherregalen, und in einer anderen Wand findet sich "
    "ein Fenster.");

  SetProp(P_GUILD_MALE_TITLES, 
    ([ 1: "der Magiedebuetant" ]));

  SetProp(P_GUILD_FEMALE_TITLES,
    ([ 1: "die Magiedebuetantin" ]));


  // Spells
  AddSpell("lichtstab");
  AddSpell("schaetz");
  AddSpell("kampfstab");
  AddSpell("erkenne");

  AddSkill(FIGHT(WT_CLUB),([SI_SKILLFUNC:"StickFight",SI_DIFFICULTY: 100]));

  AddCmd( ({"lerne", "lern"}), "cmd_learn");
  AddCmd( ({"beitritt"}), "cmd_beitritt");
  AddCmd( ({"austritt"}), "cmd_austritt");

  AddItem(Z_NPC "kandurah", REFRESH_DESTRUCT, 1);

  AddExit("unten", "/gilden/zauberer/room/turm1.lpc");

}

void join_testfunc(object pl)
{
  return;
}

int cmd_beitritt()
{
   object gnpc;

   gnpc  = present("\nz_guild_npc", this_object());

  //notify_fail("Du solltest Kandurah danach fragen!\n");
  //return 0;

  notify_fail("Du bist doch bereits mitglied einer Gilde!\n");
  if (lowerstring(TP->QueryProp(P_GUILD)) != DEFAULT_GUILD) return 0;
  
  notify_fail("Du hast nicht genug Abenteuerpunkte um beizutreten!\n");
  if (TP->QueryProp(P_QP)<GUILD_RESTRICTION_QP) return 0;

  notify_fail("Deine Intelligenz reicht nicht aus um beizutreten!\n");
  if (TP->QueryAttribute(A_INT)<GUILD_RESTRICTION_INT) return 0;

//  tell_object(TP, BS("Du trittst der Gilde bei."));

 ::beitreten();

 zauberer_init(TP); 
 
/*
  TP->SetProp(P_GUILD, "zauberer");
  TP->SetProp(P_GUILD_LEVEL, 1);
*/
  
  return 1;
}


int zauberer_init(object pl)
{
  if (!objectp(pl)) return 0;
  pl->ModifySkill(FIGHT(WT_CLUB), 
        QuerySkill(FIGHT(WT_CLUB)),100,"zauberer");

  pl->Set(P_GUILD_CIRCLE, 1, F_VALUE);
  pl->Set(P_GUILD_CIRCLE, SAVE, F_MODE_AS);
  //pl->Set(P_GUILD, "zauberer");
}



int cmd_austritt()
{
  notify_fail("Du solltest Kandurah danach fragen!\n");
  return 0;

  return ::austreten();
}


int cmd_learn(string str)
{  
  return ::LearnSpell(str);
}

