// AUSGABE BEIM MISSLINGEN DES SPELLS

nosave int total_fail;

void Misserfolg(object caster, string spell, mapping sinfo)
{
  int old_abil;
  
  if (!total_fail)
  {
    switch(spell)
      {
    case "instrumentenkunde":
      write("Du kannst nichts besonderes erkennen.\n");
      break;   
      default:
	write("Du scheinst etwas falsch gemacht zu haben.\n");
      }
  }
  total_fail = 0;  // gleich zuruecksetzen
  old_abil = sinfo[SI_SKILLABILITY];
  Learn(caster, spell, sinfo);
  sinfo=caster->QuerySkill(spell);
  if (old_abil < (mappingp(sinfo) ? sinfo[SI_SKILLABILITY] : sinfo))
    write("Du lernst aus deinen Misstoenen!\n");
  else
    write("Leider lernst Du trotzdem nichts dazu :(\n");
}

string BroscheTest(object caster, mapping sinfo)
{
  object brosche;
  if( (brosche = present("\nbardenbrosche", caster)) &&
      brosche->QueryProp(P_WORN) == caster )
    return 0;
  else
    return "Nanu, wohin ist denn Deine Bardenbrosche verschwunden?\n";
}


string BlindTest(object caster, mapping sinfo)
{
  if (TP->QueryProp(P_BLIND)==1)
    return "Tja, blind kannst du das wohl nicht vollbringen!\n";
  else
    return BroscheTest(caster, sinfo);;
}

// ES FEHLEN NOCH TAUB/STUMMTEST UND EVENTUELL ABFRAGE AUF DIE BENOETIGTEN SKILLS(wegen frosch)


int instrumentenkunde(object caster, mapping sinfo)
{
  object ob;
  string cn;
  string abn_str, wie, level;
  int suc, abn;
  mapping mat;
  
  if( !sinfo[SI_SKILLARG] || !(ob=present(sinfo[SI_SKILLARG], caster)) )
    {
      write("Welches Instrument moechtest Du denn naeher beaeugen?\n");
      return 0;
    }
  if( caster->InFight() )
    {
      write("Jetzt ist wohl nicht der geeigntete Zeitpunkt dafuer!\n");
      return 0;
    }
  cn = caster->name();
  
  if (((ob->QueryProp(P_ARMOUR_TYPE))==AT_SHIELD) && (ob->id("\ninstrument")))
    {
      if( (suc=SpellSuccess(caster,sinfo))<=0 )
	{
	  total_fail=1;
	  write("Du schaffst es nicht "+ob->name(WEM,1)+ " genauer zu untersuchen.\n");
	  return MISSERFOLG;
	}
      switch(ob->QueryProp(P_INSTRUMENT_LEVEL))
	{
	case 1:  level="leicht"; break;
	case 2:  level="durchschnittlich schwer"; break;
	case 3:  level="schwer"; break;
	case 4:  level="sehr schwer"; break;
	case 5:  level="unglaublich schwer"; break;
	default: level="von Sterblichen nicht";
	}
      tell_room(environment(caster), 
		break_string(caster->Name()+ " untersucht "+ob->name(WEN,2)+", dreht "
			     +ob->QueryPronoun(WEN)+ "ein paar "+
			     "mal herum, nickt dann zufrieden und steckt "+ob->QueryPronoun(WEN)+ 
			     " anschliessend wieder weg.",78),({caster}) );
       
      abn=ob->QueryProp(P_QUALITY_DECAY);
      if(      abn>900 ) abn_str="extrem wenig";
      else if( abn>500 ) abn_str="ausgesprochen wenig";
      else if( abn>300 ) abn_str="sehr wenig";
      else if( abn>200 ) abn_str="auffallend wenig";
      else if( abn>120 ) abn_str="ueberdurchschnittlich wenig";
      else if( abn>90  ) abn_str="ziemlich gewoehnlich";
      else if( abn>70  ) abn_str="ueberdurchschnittlich schnell";
      else if( abn>50  ) abn_str="auffallend schnell";
      else if( abn>30  ) abn_str="sehr schnell";
      else if( abn>10  ) abn_str="ausgesprochen schnell";
      else if( abn>0   ) abn_str="extrem schnell";
      else               abn_str="gar nicht";
      
      write("Folgendes kannst Du ueber das Instrument herausfinden:\n");
      write("--------------------------------------------------------\n");
      write(capitalize(ob->name(WER,1))+ " ist "+level+
	    " zu spielen und verstimmt sich "+abn_str+".\n");
            
      switch( ob->QueryProp(P_HANDS) )
	{
	case 0: wie = "keine Hand"; break;
	case 1: wie = "eine Hand"; break;
	case 2: wie = "zwei Haende"; break;
	case 3: wie = "drei Haende"; break;
	case 4: wie = "vier Haende"; break;
	default: wie = "sehr viele Haende";
	} 
      write("Du benoetigst "+wie+", um "+ob->QueryPronoun(WEN)+" spielen zu koennen.\n");
      
      if( (mat=ob->QueryProp(P_MATERIAL)) && (pointerp(mat)) )
	{
	  if (sizeof(mat))
	    write(break_string(sprintf("%s besteh%s aus %s.", ob->Name(WER,1),
				       (ob->IsUnit() && ob->QueryProp("u_req") != 1 ? "en" : "t"),
				       ob->MatList(WEM) || "unbekanntem Material"), 78));
	}
      else if (mappingp(mat))
	{
	  write(break_string(sprintf("%s besteh%s aus %s.", ob->Name(WER,1),
				     (ob->IsUnit() && ob->QueryProp("u_req") != 1 ? "en" : "t"),
				     ob->MaterialList(WEM,caster) || "unbekanntem Material"), 78));
	}
      write("Der Zustand "+ob->name(WESSEN,1)+" ist "+ob->dam_desc()+".\n");
      
      if (((ob->QueryProp(P_INSTRUMENT_TYPE)=="alestra") || 
	   (ob->QueryProp(P_INSTRUMENT_TYPE)=="tirena") || 
	   (ob->QueryProp(P_INSTRUMENT_TYPE)=="sarrian") || 
	   (ob->QueryProp(P_INSTRUMENT_TYPE)=="korriax"))) 
	{
	  write("Fuer folgende Bardenrichtungen ist "+((ob->name(WER,1)))+" besonders gut "
		+"geeignet:\n");
	  
	  switch(ob->QueryProp(P_INSTRUMENT_TYPE))
	    {
	    case "alestra":   
	      write("Barden von Alestra. ");
	      break;
	    case "tirena": 
	      write("Barden von Tirena. ");
	      break;
	    case "sarrian": 
	      write("Barden von Sarrian. ");
	      break;
	    case "korriax":  
	      write("Barden von Korriax. ");
	    }
          write("\n");
	}

      if(suc>4000)
	{
	  if (ob->QueryProp(P_VALUE)>2000)
	    {
	      write("Dieses Instrument ist ziemlich wertvoll.\n");
	    }
	  if (ob->QueryProp(P_MAGIC)==1) 
	    { 
	      write("Ausserdem scheint dieses Instrument magisch zu sein.\n");
	    }
	}
      write("--------------------------------------------------------\n");
    }
  
  else
    
    {
      write( capitalize(ob->name(WER,1))+ " scheint kein Musikinstrument zu sein..\n");
      return ERFOLG;
    }
}













int schrei(object caster, mapping sinfo)
{
  say(sprintf("SCHREI\n"));
  printf("SCHREI\n"); 
  return MISSERFOLG;
}
















int schaetzlied(object caster, mapping sinfo)
{
  object victim;
  int hpdiff, wcdiff, acdiff;
  int hp, vhp, wc, vwc, ac, vac, gen, val;
  string result;
  string vname, vnamegen;
  
  victim=FindVictim(sinfo[SI_SKILLARG],caster,
		    "Auf wen oder was willst Du das Lied richten?\n");
   if (!victim)
     return 0;
   if (SpellSuccess(caster,sinfo)<=0)
      return MISSERFOLG;

   if (!living(victim))
   {
     result = sprintf("\nDu stimmst 'Der Dinge wahrer Hintergrund an' und richtest deine Gedanken "+
		      "auf %s als ploetzlich eine Stimme in deinem Kopf saeuselt:\n"+
		      "--------------------------------------------------------\n",victim->name(WEN));
     if (val = victim->QueryProp(P_VALUE))
       result += sprintf("%s ha%s einen Wert von %d Muenze%s.\n",
			 capitalize(victim->name(WER,1)),
			 (victim->IsUnit() && victim->QueryProp(P_REQUESTED_AMOUNT) != 1) ?
			 "ben" : "t",
			 val, (val==1 ? "" : "n"));
     else
       result += sprintf("%s %s voellig wertlos...\n",
			 capitalize(victim->name(WER,1)),
			 (victim->IsUnit() && victim->QueryProp(P_REQUESTED_AMOUNT) != 1) ?
			 "sind" : "ist");
     
     if (victim->IsUnit())
       val = victim->QueryProp(P_WEIGHT);
     else
       val = victim->QueryProp(P_TOTAL_WEIGHT);

     // ab 6 kg nur mehr auf 1 kg genau
     if ( (val >= 6000) || (val > (3000+100*caster->QueryProp(P_LEVEL))) )
       vname = "in etwa "+((val+500)/1000)+" Kilogramm";
     else
     {
       if (val < 100)
         vname = "so gut wie nichts";
       else if (val < 950)
         vname = "ungefaehr "+((val+50)-(val+50)%100)+" Gramm";
         // vname=sprintf("%.1f",to_float(val)/1000);
       else
       {
         if (val >= 1500)
           val = val+random(100)-random(100);   // ein wenig random :)
         if (val >= 2000)
           val=(val+250)-(val+250)%500;
         else
           val=(val+125)-(val+125)%250;
         vname = "ungefaehr "+
           ({"","ein","zwei","drei","vier","fuenf","sechs"})[val/1000]+
           ({"","einviertel","einhalb","dreiviertel"})[(val%1000)/250]+
           " Kilogramm";
       }
     }

     result += sprintf("%s wieg%s %s.\n",
         capitalize(victim->QueryPronoun()),
         (victim->IsUnit() &&
          victim->QueryProp(P_REQUESTED_AMOUNT) != 1) ? "en" : "t", vname);
     result += sprintf ("--------------------------------------------------------\n");
     write (result);
     return ERFOLG;
   }

   hp = caster->QueryProp(P_HP);    vhp = victim->QueryProp(P_HP);
   wc = caster->QueryProp(P_TOTAL_WC);  vwc = victim->QueryProp(P_TOTAL_WC);
   ac = caster->QueryProp(P_TOTAL_AC);  vac = victim->QueryProp(P_TOTAL_AC);
   hpdiff = hp - vhp;
   wcdiff = wc - vwc;
   acdiff = ac - vac;
   vname = victim->name(WER, 1);
   vnamegen = victim->name(WESSEN, 1);
   gen = victim->QueryProp(P_GENDER);



   result = sprintf("\nDu stimmst 'Der Dinge wahrer Hintergrund an' und richtest deine Gedanken "+
		    "auf %s als ploetzlich eine Stimme in deinem Kopf saeuselt:\n"+
		    "--------------------------------------------------------\n",victim->name(WEN));
   write(result);
   if (hpdiff > 2*vhp)
      result = "Du bist " + victim->name(WEM, 1) + " haushoch ueberlegen.\n";
   else if (hpdiff > vhp)
      result = "Du bist viel staerker als " + vname + ".\n";
   else if (hpdiff > vhp/5)
      result = "Du bist staerker als " + vname + ".\n";
   else if (-hpdiff > 2*hp)
      result = capitalize(vname) + " ist Dir haushoch ueberlegen.\n";
   else if (-hpdiff > hp)
      result = capitalize(vname) + " ist viel staerker als Du.\n";
   else if (-hpdiff > hp/5)
      result = capitalize(vname) + " ist staerker als Du.\n";
   else
      result = capitalize(vname) + " ist etwa gleich stark wie Du.\n";
   write(result);

   if (acdiff > 2*vac)
      result = "Deine Ruestung ist unglaublich viel besser als die " 
     + vnamegen + ".\n";
   else if (acdiff > vac)
      result = "Deine Ruestung ist viel besser als die " + vnamegen + ".\n"; 
   else if (acdiff >vac/5)
      result = "Deine Ruestung ist besser als die " + vnamegen + ".\n";
   else if (-acdiff > 2*ac)
      result = "Die Ruestung " + vnamegen 
     + " ist unglaublich viel besser als Deine.\n";
   else if (-acdiff > ac)
      result = "Die Ruestung " + vnamegen + " ist viel besser als Deine.\n";
   else if (-acdiff > ac/5)
      result = "Die Ruestung " + vnamegen + " ist besser als Deine.\n";
   else
      result = "Eure Ruestungen sind etwa gleich gut.\n";
   write(result);

   if (wcdiff > 2*vwc)
      result = "Deine Waffe ist eigentlich zu gut fuer diesen Gegner.\n";
   else if (wcdiff > vwc)
      result = "Deine Waffe ist viel besser als die " +vnamegen + ".\n";
   else if (wcdiff > vwc/5)
      result = "Deine Waffe ist besser als die " +vnamegen + ".\n";
   else if (-wcdiff > 2*wc)
      result = "Die Waffe " + vnamegen 
     + " laesst Deine ganz mickrig aussehen.\n";
   else if (-wcdiff > wc)
      result = "Die Waffe " + vnamegen + " ist viel besser als Deine.\n";
   else if (-wcdiff > wc/5)
      result = "Die Waffe " + vnamegen + " ist besser als Deine.\n";
   else
      result = "Eure Waffen sind etwa gleich gut.\n";

  result += capitalize(victim->QueryPronoun(WER) || "es");
  if ((val = victim->QueryProp(P_ALIGN)) <= -1000)
    result += " ist von satanischer Gesinnung.\n";
  else if (val <= -200)
    result += " ist von boeser Gesinnung.\n";
  else if (val <= -40)
    result += sprintf(" ist ein%s unfreundliche%s Zeitgenoss%s.\n",
        (gen == FEMALE ? "e" : ""), (gen == FEMALE ? "" : "r"),
        (gen == FEMALE ? "in" : "e") );
  else if (val <= 40)
    result += " sieht die Welt mit neutralen Augen.\n";
  else if (val <= 200)
    result += " ist eigentlich ganz nett.\n";
  else if (val < 1000)
    result += " ist von guter Gesinnung.\n";
  else
    result += " strahlt eine gewisse Heiligkeit aus.\n";
  result+= sprintf ("--------------------------------------------------------\n");
  write(result); 
  return ERFOLG;
} 

