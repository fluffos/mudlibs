void create()
{
  ::create();
  SetProp(P_GLOBAL_SKILLPROPS,
          ([SI_SPELLFATIGUE: 2,              // 2 Sekunden kein neuer Spell
	  SI_SKILLLEARN: 2,                // 0.04% pro 2 A_STR 
	  OFFSET(SI_SKILLLEARN): 3,        // plus 0.05% in jedem Fall
	  SI_SKILLRESTR_USE: ([SR_FUN:"BroscheTest"]),
	  SI_SKILLLEARN_ATTRIBUTE: A_DEX,
	  SI_SP_LOW_MSG:"Du brauchst jetzt erstmal eine Pause.\n",
	  SI_TIME_MSG: "Du musst Dich erst wieder etwas sammeln!\n",
	  ]));
  
  AddSpell("instrumentenkunde", 0, 
	   ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL: 1]), 
