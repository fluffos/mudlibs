inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <new_skills.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

object caster;

public void create() {
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Nichts wichtiges...");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Lied der Zauber");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INVIS, 1);
  AddId(({"\nbarden_zauberlied"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}

public void start(object _caster, int duration) {
  call_out("end_song", duration);
  caster = _caster;
  caster->SetProp(P_TMP_BARDS_ZAUBERMELODIE, 1);
}

public void end_song() {
  tell_object(caster, BS("Die Wirkung der Zaubermelodie verfliegt..."));
  caster->SetProp(P_TMP_BARDS_ZAUBERMELODIE, 0);
  remove(1);
}