inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"tafel", "hinweistafel"}));
  SetProp(P_SHORT, "Eine Hinweistafel");
  SetProp(P_LONG, "Auf dieser Hinweistafel steht, was so "
	  +"so alles in der Gilde moeglich ist. Du kannst es "
	  +"lesen.\n");
  SetProp(P_NAME, "Hinweistafel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 5000);  

  AddCmd ("lies|lese&tafel|hinweis|hinwesitafel", "lies_was", "Was willst du lesen?");
}

public int lies_was()
{
  string tafel;
  notify_fail("Was willst Du lesen?\n");
  
  tafel = read_file("/gilden/bardengilde/obj/hinweistafel.txt"); 
  tell_object(this_player(), tafel);
  return 1;
}








