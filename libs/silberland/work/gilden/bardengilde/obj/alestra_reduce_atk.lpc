inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <new_skills.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

public void create() {
    if(!is_clone(this_object())) return;

    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_LONG, "Angst und Schwaeche");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_INVIS, 1);
    SetProp(P_MATERIAL, MAT_MAGIC );
    SetProp(P_WEIGHT, 0);
    SetProp(P_SIZE, 0);
    SetProp(P_VALUE, 0);
    SetProp(P_NOBUY, 1);
    SetProp(P_NOSELL, 1);
    SetProp(P_NEVERDROP, 1);

    AddId("\nbard_passive_weakness");
}

public void Setup(int inspiration) {
    while(find_call_out("remove") != -1) {
        remove_call_out("remove");
    }

    SetProp(P_X_ATTR_MOD,([A_STR:inspiration*-5]));

    call_out("remove", inspiration, 1);
}
