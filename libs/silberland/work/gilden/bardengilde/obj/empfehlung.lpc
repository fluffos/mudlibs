#include "/gilden/bardengilde/bardengilde.h"
#include <properties.h>
#include <moredef.h>

inherit "std/thing";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Empfehlungsschreiben");
  SetProp(P_LONG,
    "Hierbei handelt es sich um ein Empfehlungsschreiben fuer die legendaere"
    "Bardengilde. Es wurde in einen Umschlag aus Hirschleder gewickelt und mit "
    "der elfischen Rune Seronas versiegelt. Wenn du es nicht benoetigst, kannst "
    "du es einfach zerreissen.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Mit diesem Schreiben darf man in die Bardengilde eintreten!");
  SetProp(P_NAME, "Empfehlungsschreiben");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schreiben", "empfehlungsschreiben", "empfehlung", "\nbarden_empfehlung"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ({MAT_PAPER, MAT_LEATHER, MAT_INK,  MAT_WAX}) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd("zerreiss|zerreisse&brief|schreiben|empfehlung|empfehlungsschreiben", "cmd_zerreissen");
  AddCmd("lies|lese|les&brief|schreiben|empfehlung|empfehlungsschreiben", "cmd_lesen");
}


public int cmd_zerreissen(string args) {
    tell_object(this_player(), BS("Du zerreisst das Empfehlungsschreiben."));
    tell_room(environment(this_player()), BS(sprintf("%s zerreisst einen Brief.", this_player()->Name(WER, 1))), ({this_player()}));
    remove(1);
    return 1;
}

public int cmd_lesen(string args) {
    tell_object(this_player(), BS("Wenn du das tun wuerdest, dann muesstest du das Siegel brechen. "
    "Das waere eine Verletzung des Briefgeheimnisses, weshalb du es lieber sein laesst."));
    return 1;
}
