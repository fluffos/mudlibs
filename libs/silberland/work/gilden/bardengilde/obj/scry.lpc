inherit "/gilden/bardengilde/obj/std_song_effect";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <new_skills.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"
#include "bard_song.h"

int stepTime, steps, currentStep;

public void create() {
  if (!is_clone(TO)) return;

  ::create();
  AddId(({SONG_SCRY}));

  AddId(({SONG_DEPOISON}));
  setUpkeepMode( ({SK_MUSIC}), CANCEL_INTERACT);
  setEndSpellDelay(5);
}


public void prepareSong() {
  stepTime = 8 - (success/2000);
  if(stepTime < 2) {
      stepTime = 2;
  }

  stepTime = (int) (stepTime * factor);
  stepTime = modifyBySkillAttribute(stepTime, SA_DURATION);

  steps = 3 + ((ability - 2000) / 2000);
  if(steps > 6) {
      steps = 6;
  }

  steps = (int) (steps * factor);
  steps = modifyBySkillAttribute(steps, SA_DAMAGE);
  if(steps > 6) steps = 6;

  currentStep = 0;

  call_out("scry_info", stepTime);
}

private void regionInfo() {
    string *exp_fn;
    object room;

    room = environment(victim);
    exp_fn=explode(file_name(room), "/");

    tell_object(caster, BS("Du spielst einige langegezogene Takte, welche weithin klingen. Deine Sinne gehen auf Reisen..."));
    tell_room(environment(caster), BS(sprintf("%s spielt einige langegezogene Takte, welche weithin klingen.", caster->Name(WER, 1))), ({caster}));
    tell_room(room, BS("Der Wind weht einige langsame Takte Musik zu dir."));

    tell_object(caster, sprintf("%75'-'s\n", ""));
    if(exp_fn[0]=="d") {
      write(sprintf("Im Takt der Musik reisen deine Sinne in Richtung %s.\n", capitalize(exp_fn[1])));
    } else if(exp_fn[0]=="gilden") {
      write(sprintf("Deine Sinne reisen Richtung der Gilde der/des %s.\n", capitalize(exp_fn[1])));
    }
    tell_object(caster, sprintf("%75'-'s\n", ""));
    return;
}

private void conditionInfo() {
    tell_object(caster, BS("Du singst: Wind des Nordens, eil herbei."));
    tell_object(caster, BS("Du singst: Kalter Sturm, bring Eis und Schnee."));
    tell_object(caster, BS("Du singst: Sprich zu mir von fremder Laenderei, "));
    tell_object(caster, BS(sprintf("Du singst: Sag mir was ich bei %s wohl seh.", victim->name(WEM, 1))));
    
    tell_room(environment(caster), BS(sprintf("%s singt: Wind des Nordens, eil herbei.", caster->Name(WER, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: Kalter Sturm, bring Eis und Schnee.", caster->Name(WER, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: Sprich zu mir von fremder Laenderei, ", caster->Name(WER, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: Sag mir was ich bei %s wohl seh.", caster->Name(WER, 1), victim->name(WEM, 1))), ({caster}));



    call_out("give_temperature_info", 2);
    return;
}

public void give_temperature_info() {
    object room;
    string tempStr, lightStr;

    room = environment(victim);
    switch(room->QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE]) {
        case -10000..-50: tempStr ="toetlich kalt"; break;
        case -49..-30   : tempStr ="extrem kalt"; break;
        case -29..-10   : tempStr ="eiseskalt"; break;
        case  -9..4     : tempStr ="kalt"; break;
        case   5..15    : tempStr ="kuehl"; break;
        case  16..25    : tempStr ="angenehm warm"; break;
        case  26..30    : tempStr ="warm"; break;
        case  31..40    : tempStr ="heiss"; break;
        case  41..50    : tempStr ="sehr heiss"; break;
        case  51..60    : tempStr ="extrem heiss"; break;
        case  61..10000 : tempStr ="toetlich heiss"; break;
        default         : tempStr ="undefinierbar kalt oder warm"; break;
    }

    switch(room->_query_total_light()) {
        case -10000..-3: lightStr="absolute Schwarze";
                            break;
        case -2..-1:     lightStr="tiefe Dunkelheit";
                            break;
        case 0:          lightStr="Dunkelheit";
                            break;
        case 1:          lightStr="ein sanftes Leuchten";
                            break;
        case 2..3:       lightStr="ein helles Licht";
                            break;
        case 4..10000:   lightStr="strahlendes Leuchten";
                            break;
        default:         lightStr = "undefinierbares Grau";
    }
    
    tell_object(caster, sprintf("%75'-'s\n", ""));
    tell_object(caster, BS(sprintf("Langsam nimmst du %s wahr und dir ist %s.", lightStr, tempStr)));
    tell_object(caster, sprintf("%75'-'s\n", ""));
    tell_room(room, BS("Leise Musik ertoent. Jemand ist bei dir..."));
    return;
}

private void terrainInfo() {
    string str;
    int terrain;
    object room;

    room = environment(victim);

    tell_object(caster, BS("Ein rasantes Stakkato fokussiert deine Wahrnahmung staerker auf die Umgebung. Deine Sicht klaert sich etwas."));
    tell_room(environment(caster), BS(sprintf("%s spielt ein hallendes Stakkato das aus dem Raum hinaus klingt.", caster->Name(WER, 1))), ({caster}));
    tell_room(room, BS("Ein rasantes Stakkato erklingt um dich herum."));

    if(terrain=room->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN]) {
        str = sprintf("%s befindet sich ", victim->name(WER, 1));
        switch(terrain) {
          case TT_CAVE:  str+="in einer hoehlenaehnlichen Umgebung.";
                         break;
          case TT_HOUSE: str+="in einer geschlossenen Umgebung.";
                         break;
          case TT_HILL:  str+="in einer huegelligen Gegend.";
                         break;
          case TT_FOREST:str+="in einer waldaehnlichen Gegend.";
                         break;
          case TT_TOWN:  str+="in einer stadtaehnlichen Gegend.";
                         break;
          case TT_MOUNTAIN: str+="in einer sehr bergigen Gegend.";
                            break;
          case TT_DESERT:str+="in einer wuestenaehnlichen Gegend.";
                         break;
          case TT_JUNGLE:str+="in einer dschungelaehnlichen Gegend.";
                         break;
          case TT_SWAMP: str+="in einer mooraehnlichen Gegend.";
                         break;
          case TT_PLAIN: str+="in einer flachen Gegend.";
                         break;
          case TT_ARCTIC:str+="in einer arktischen Gegend.";
                         break;
          case TT_UNDERWATER:str+="unter Wasser.";
                             break;
          case TT_WATER:str+="im oder am Wasser.";
                        break;
          case TT_ROAD:  str+="in einer strassenaehnlichen Gegend.";
                         break;
          case TT_AIR:  str+="hoch oben in der Luft.";
                         break;
          case TT_OTHER:  
          default:        str+="in einem unbekannten Terrain.";
                         break;
        }
        tell_object(caster, sprintf("%75'-'s\n", ""));
        tell_object(caster, BS(str));
        tell_object(caster, sprintf("%75'-'s\n", ""));
    } else {
        tell_object(caster, sprintf("%75'-'s\n", ""));
        tell_object(caster, BS(sprintf("Seltsam... Du kannst due Umgebung von %s nicht genau wahrnehmen.", victim->name(WEM, 1))));
        tell_object(caster, sprintf("%75'-'s\n", ""));
    }
    return;
}

private void shortInfo() {
    tell_object(caster, BS("Du singst: Wind des Ostens, heule wild!"));
    tell_object(caster, BS("Du singst: Weh zu mir ein stetes Bild,"));
    tell_object(caster, BS(sprintf("Du singst: Erzaehl mir wies bei %s nur sei, ", victim->name(WEM, 1))));
    tell_object(caster, BS("Du singst: In fremder, ferner Laenderei."));
    
    tell_room(environment(caster), BS(sprintf("%s singt: Wind des Ostens, heule wild!", caster->Name(WER, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: Weh zu mir ein stetes Bild,", caster->Name(WER, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: Erzaehl mir wies bei %s nur sei, ", caster->Name(WER, 1), victim->name(WEM, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: In fremder, ferner Laenderei.", caster->Name(WER, 1))), ({caster}));


    call_out("give_short_info", 2);
    return;
}

public void give_short_info() {
    object room;
    room = environment(victim);
    tell_object(caster, sprintf("%75'-'s\n", ""));
    tell_object(caster, BS(sprintf("Unscharf erkennst du einen Ort, den man '%s' nennt.", room->QueryProp(P_INT_SHORT))));
    tell_object(caster, sprintf("%75'-'s\n", ""));
    tell_room(room, BS("Du hoerst eine Stimme im Wind singen und meinst eine geisterhafte Gestalt neben dir zu erkennen."));
}


private void longInfo() {
    tell_object(caster, BS("Du singst: Wind des Suedens, trag den Ton!"));
    tell_object(caster, BS("Du singst: Wind des Westens, bring den Dunst!"));
    tell_object(caster, BS("Du singst: In eurem steten Reigen schon "));
    tell_object(caster, BS("Du singst: Offenbart mir eure Gunst."));
    
    tell_room(environment(caster), BS(sprintf("%s singt: Wind des Suedens, trag den Ton!", caster->Name(WER, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: Wind des Westens, bring den Dunst!", caster->Name(WER, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: In eurem steten Reigen schon ", caster->Name(WER, 1), victim->name(WEM, 1))), ({caster}));
    tell_room(environment(caster), BS(sprintf("%s singt: Offenbart mir eure Gunst.", caster->Name(WER, 1))), ({caster}));

    call_out("give_long_info", 2);
    return;
}

public void give_long_info() {
    object room;
    room = environment(victim);
    tell_object(caster, BS("Vor deinem Auge schaelt sich die Welt aus dem Grau:"));
    tell_object(caster, sprintf("%75'-'s\n", ""));
    tell_object(caster, room->int_long(caster,caster,0));
    tell_object(caster, sprintf("%75'-'s\n", ""));

    tell_room(room, BS(sprintf("Ein geisterhaftes Abbild von %s materialisiert sich und sieht sich um.", caster->Name(WEM, 1))));
    return;
}

private void statusInfo() {
    int hpperc;
    string descr;

    descr = victim->Name(WER, 1);

    if(!victim->QueryProp(P_MAX_HP)) {
      descr += " hat keine Lebenskraft.\n";
    } else {
      hpperc = 100 * victim->QueryProp(P_HP) / victim->QueryProp(P_MAX_HP);      
      if (hpperc < 10)
        descr += " steht auf der Schwelle des Todes.\n";
      else if (hpperc < 20)
        descr += " braucht dringend einen Arzt.\n";
      else if (hpperc < 30)
        descr += " ist in keiner guten Verfassung.\n";
      else if (hpperc < 40)
        descr += " wankt bereits bedenklich.\n";
      else if (hpperc < 50)
        descr += " macht einen mitgenommenen Eindruck.\n";
      else if (hpperc < 60)
        descr += " sieht nicht mehr taufrisch aus.\n";
      else if (hpperc < 70)
        descr += " ist leicht angeschlagen.\n";
      else if (hpperc < 80)
        descr += " fuehlte sich heute schon besser.\n";
      else if (hpperc < 90)
        descr += " ist schon etwas geschwaecht.\n";
      else
        descr += " ist absolut fit.\n";
      }

    tell_object(caster, BS("Du laesst die Zaubermelodie sanft und leiser werdend ausklingen."));
    tell_room(environment(caster), BS(sprintf("%s laesst die Zaubermelodie sanft und leiser werdend ausklingen.", caster->Name(WER, 1))), ({caster}));
    tell_object(caster, sprintf("%75'-'s\n", ""));
    tell_object(caster, BS(descr));
    tell_object(caster, sprintf("%75'-'s\n", ""));
}

public void scry_info() {
    if(!objectp(victim)) {
      call_out("cancel_effect");
      return;
    }
    
    switch(++currentStep) {
        case 1: 
            regionInfo();
            break;
        case 2:
           conditionInfo();
            break;
        case 3:
            terrainInfo();
            break;
        case 4:
            shortInfo();
            break;
        case 5:
           longInfo();
            break;
        case 6:
            statusInfo();
            break;
        default:
            raise_error(sprintf("Falscher Scyringschritt (%d)", currentStep));
            break;
    }

    if(currentStep >= steps) {
        call_out("endSong", 0);
    } else {
        call_out("scry_info", stepTime/2);
    }
}
