#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

private int isEligibileToLearn(object player, string spell) {
    if(!objectp(player)) return 0;
	if(!interactive(player)) return 0;
    if(player->QuerySkill(spell) != 0) return 0;
    return player->QueryProp(P_GUILD) == "bardengilde";
}

public void LearnBardSpell(object player, string spell, string description, string syntax) {
    mapping sinfo;
    if(!isEligibileToLearn(player, spell)) return;

    call_other("/gilden/bardengilde", "InitSpells");

    sinfo = call_other("/gilden/bardengilde", "QuerySpell", spell);
    if(!sinfo) {
        tell_object(player, BS("(Barden) Fehler: der Spell existiert nicht."));
        return;
    }
    
	tell_object(player, "\n\n");
	tell_object(player, BS("=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~="));
	tell_object(player, BS("Ein Strudel der Inspiration erfasst deinen Geist und dir wird schwindlig!"));
	tell_object(player, BS(sprintf("In deinem Geist bildet sich die Melodie des Zauberliedes '%s' "
                           "und brennt sich fest darin ein.", sinfo[SI_CAP_NAME])));
    tell_object(player, BS(description));
	if(call_other("/gilden/bardengilde", "LearnSpell", spell, player) <= 0) {
		tell_object(player, BS(sprintf("!!!! Beim Lernen von '%s' ist ein Fehler aufgetreten. !!!!", spell)));
	} else {
        tell_object(player, BS(sprintf("syntax: %s", syntax)));
    }
	tell_object(player, BS("\n=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~="));
	tell_object(player, "\n\n");
	return;
}