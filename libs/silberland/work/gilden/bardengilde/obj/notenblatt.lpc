 *
 * Last updated: 30.5.1999
 */

inherit "/std/thing";
inherit "/mail/nedit";
inherit "/std/more";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>

#define UA this_interactive()->_unparsed_args()

create() {
  (::create());
  seteuid(getuid());
  SetProp(P_NAME, "Notenblatt");
  SetProp(P_SHORT, "Ein Notenblatt");
  SetProp(P_VALUE, 0); 
  SetProp(P_WEIGHT, 0);               
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_IDS, ({"notenblatt","blatt"}));
  SetProp(P_AUTOLOADOBJ, 4711);
  AddCmd(("liedneu"), "EditSong");
  AddCmd(("zeige"), "zeiglied");
}

long() {
  return "\
Ein Notenblatt. Damit kannst Du ein Lied aendern.\n\
Befehle:\n\
 liedneu      [laedt den vorhandenen Plan in den Editor bzw. legt neuen an]\n\
 liedneu loeschen\n\
";
}

 
EditSong(str) {
  string old,name,filename;
    name=geteuid(this_player());
  filename="/gilden/bardengilde/songs/"+name+".songs";
  if (str=="loeschen") {
    if (!(old=read_file(filename)))
      return notify_fail("Da war nix zum Loeschen!\n");
    rm(filename);
    write("Geloescht. Alter Text war:\n"+old);
    return 1;
  }
  if (str) return notify_fail("Kein brauchbarer Parameter.\n");
  if (!(old=read_file(filename)))
    write("Kein altes Lied vorhanden.\n");
  else write("Bisheriger Text:\n"+old);
  write("Bitte Text bearbeiten (~h Hilfsseite, ~q Abbruch, . wenn fertig)!\n");
  nedit("SaveSong", old);
  return 1;
}

SaveSong(str) {
  string filename;
  filename="/gilden/bardengilde/songs/"+geteuid(this_player())+".songs";
  if (!str) {
    write("Abbruch. Nichts gespeichert.\n");
    return 1;
  }
  rm(filename);
  write_file(filename,str);
  write("\
Neues Lied ist:\n"+str);
  return 1;
}
  





