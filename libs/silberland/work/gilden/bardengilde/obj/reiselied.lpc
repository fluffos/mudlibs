string *refrain = ({
  "Hey! Hey! Hey! Ich bin ein Freund aller Welt,\n"
  "Wenn ich's brauch, schnorr ich mir Geld!\n",
  "Hi-dideli-ho! Ich bin ein Freund aller Welt,\n"
  "Ich wandere hier durch, weil es mir gefaellt!",
  "Tralalala! Ich bin ein Freund aller Welt,\n"
  "Reise hin, wo es mir gefaellt.",
  "Huchezulejoh! Ich bin ein Freund aller Welt,\n"
  "Kein Weg belibt mir verstellt!",
