#include <class.h>
#include <moving.h>
#include "/gilden/bardengilde/bardengilde.h"

object victim, caster, wornItem;
float exhaustReduction, factor;
int flying, duration, canRecharge, ability, success;
mapping overwrittenMovingCost;

