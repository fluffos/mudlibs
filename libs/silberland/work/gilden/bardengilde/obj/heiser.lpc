/*
 * Die Heiserkeit beim verhaun von Schrei des Verderbens
 *
 * Gwenshara@Silberland
 *
 * 08.07.2007
*/

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

int timeout;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  timeout = 120;
  
  AddId (({"\nsprachfluch", "\nheiser"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, "Heiserkeit");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_MAGIC, 1);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
}

string permutate_string (string str)
{
  if(random(2)) return "*roechel*";
  return "*keuch*";
}

void setTimeOut(int to)
{
  timeout = to;
}

void start()
{
  if(!living(ENV(TO))) return;
  ENV(TO)->SetProp(P_PERM_STRING, TO);
  call_out("ende", timeout);
}

void ende()
{
  tell_object(ENV(TO), "Du bist nicht mehr heiser.\n");
  remove(1);
}
