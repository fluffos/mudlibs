
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

int north, south, east, west;

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();

  AddId(({"flasche", "windflasche", "\nbard_windflasche", "glasflasche"}));
  SetProp(P_SHORT, "Eine Windflasche");
  SetProp(P_LONG, "Hierbei handelt es sich um eine gruenliche, bauchig gestaltete "
                  "Glasflasche. Sie wurde ueber und ueber mit magischen Runen "
                  "verziert, welche irisierend schimmern.\n"
                  "Mit solchen Flaschen kann man elementare Geister einfangen. Wobei "
                  "diese spezielle Flasche fuer die Winde des Nordens, Ostens, Westens "
                  "und Suedens gefertigt wurde.\n@@wind_info@@");
  SetProp(P_NAME, "Windflasche");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 20);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 1000000);
  SetProp(P_NODROP, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:80, MAT_MAGIC:20]) );

  AddCmd( "trink|trinke&flasche|windflasche", "cmd_trinken", "Was willst du trinken?\n");

  north = south = east = west = 0;
}

public string wind_info() {
  string s;
  s = "";
  if(!north && !south && !east && !west) {
    return "Die Flasche ist leer.";
  }

  if(north) {
    s += "In der Flasche tobt ein kleiner Schneesturm.\n";
  }

  if(south) {
    s += "Ein heisser Sandsturm fegt durch die Flasche.\n";
  }

  if(west) {
    s += "Einige Gewitterwolken blitzen in der Flasche.\n";
  }

  if(east) {
    s += "Ein kleiner Wirbelsturm zischt im Inneren herum.";
  }

  return s;
}

int cmd_trinken(string str) {
  if(!north || !south || !east || !west) {
    tell_object(this_player(), BS("Es sind noch nicht alle Winde in der Flasche versammelt!"));
    return -1;
  }

  write(BS("Mit einem maechtigen Schluck stuerzt du die gefangenen Winde deine Kehle hinab..."));
  say(BS(this_player()->Name(WER, 1) + " leert sich den Inhalt einer merkwuerdigen Flasche in die Kehle..."));
  SetProp(P_INVIS, 1);
  call_out("nordwind", 5);
  return 1;
}

public void nordwind() {
  tell_object(this_player(), BS("Ploetzlich wird dir eiskalt. Als wuerde ein Schneesturm in deinem innersten toben."));
  tell_room(environment(this_player()), BS(sprintf("%s zittert vor Kaelte.", this_player()->Name(WER, 1))), ({this_player()}));
  this_player()->AddHp(-10);
  call_out("nordwind1", 3);
}

public void nordwind1() {
  tell_object(this_player(), BS("Raureif ueberzieht Deine Haut."));
  tell_room(environment(this_player()), BS(sprintf("%s Haut wird von einer Eisschicht ueberzogen.", this_player()->Name(WESSEN, 1))), ({this_player()}));
  this_player()->AddHp(-20);
  call_out("nordwind2", 5);
}

public void nordwind2() {
  tell_object(this_player(), BS("Du merkst, wie sich der Nordwind widerwillig deinem Willen beugt."));
  call_out("suedwind1", 5);
}

public void suedwind1() {
  tell_object(this_player(), BS("Hitze wallt in Dir auf..."));
  tell_room(environment(this_player()), BS(sprintf("%s bekommt einen fiebrigen Blick.", this_player()->Name(WER, 1))), ({this_player()}));
  this_player()->AddHp(-10);
  call_out("suedwind2", 5);
}

public void suedwind2() {
  tell_object(this_player(), BS("Du spuerst, wie du innerlich austrocknest."));
  tell_room(environment(this_player()), BS(sprintf("%s Lippen und Haut werden trocken und sproede.", this_player()->Name(WESSEN, 1))), ({this_player()}));
  this_player()->SetProp(P_DRINK, 0);
  call_out("suedwind3", 5);
}

public void suedwind3() {
  tell_object(this_player(), BS("Mit einem trockenen Zischen ergibt sich der Suedwind."));
  call_out("westwind1", 5);
}

public void westwind1() {
  tell_object(this_player(), BS("Irgendetwas braut sich in deiner Magengegend zusammen..."));
  tell_room(environment(this_player()), BS(sprintf("%s haelt sich den Bauch.", this_player()->Name(WER, 1))), ({this_player()}));
  this_player()->AddHp(-10);
  call_out("westwind2", 5);
}

public void westwind2() {
  tell_object(this_player(), BS("Ploetzlich zucken tausende kleiner Blitze ueber deinen Koerper und blenden Dich!"));
  tell_room(environment(this_player()), BS(sprintf("%s wird ploetzlich von mehreren Blitzen getroffen.", this_player()->Name(WER, 1))), ({this_player()}));
  this_player()->SetProp(P_BLIND, 5);
  call_out("westwind3", 5);
}

public void westwind3() {
  tell_object(this_player(), BS("Mit einem kurzen Zucken deiner Muskeln unterwirft sich der Westwind."));
  call_out("ostwind1", 5);
}

public void ostwind1() {
  tell_object(this_player(), BS("Mit einem heftigen Ruck wirst du in den Himmel geschleudert!"));
  tell_room(environment(this_player()), BS(sprintf("%s wird auf einmal von einem Windstoss in den Himmel geschleudert!", this_player()->Name(WER, 1))), ({this_player()}));
  this_player()->SetProp(P_PARALYZED, ([
    PARALYZE_TIME: -1,
    PARALYZE_MSG: "Du rast gerade mit irrsinniger Geschwindigkeit durch die Luft!\n",
    PARALYZE_MSG_OTHER: "",
    PARALYZE_END: "",
    PARALYZE_END_OTHER: ""]));
  this_player()->move("/d/luft/gwenshara/himmel", M_GO|M_NOCHECK|M_SILENT);
  call_out("ostwind2", 5);
}

public void ostwind2() {
  tell_object(this_player(), BS("Der Ostwind hat dich gepackt und schleudert dich durch die Wolken."));
  call_out("ostwind3", 3);
}

public void ostwind3() {
  tell_object(this_player(), BS("Muehselig versuchst du dich auf die Windboe zu schwingen, die dich fest umklammert haelt."));
  call_out("ostwind4", 4);
}

public void ostwind4() {
  tell_object(this_player(), BS("Mit einem Schlag laesst dich der Ostwind fallen! Du rast auf den Erdboden zu!"));
  call_out("ostwind5", 5);
}

public void ostwind5() {
  tell_object(this_player(), BS("In einem panischen Anflug von Verzweiflung packst du dein Insturment und beginnst zu spielen."));
  call_out("ostwind6", 3);
}

public void ostwind6() {
  tell_object(this_player(), BS("Mit einem Mal fuehlst du eine warme Brise, die dich umschmeichelt."));
  call_out("ostwind7", 2);
}

public void ostwind7() {
  tell_object(this_player(), BS("Ein kalter Luftzug umfaengt Dich!"));
  call_out("ostwind8", 2);
}

public void ostwind8() {
  tell_object(this_player(), BS("Und zu guter Letzt bildet sich eine kleine Gewitterwolke unter dir."));
  call_out("ostwind9", 2);
}

public void ostwind9() {
  tell_object(this_player(), BS("Langsam gleitest du getragen von den vier Winden zu Boden."));
  call_out("ostwind10", 4);
}

public void ostwind10() {
  this_player()->move("/gilden/bardengilde", M_GO|M_SILENT);
  tell_room(environment(this_player()), BS(sprintf("%s gleitet sanft vom Himmel herab.")), ({this_player()}));
  LearnBardSpell(this_player(), "lied der winde", "Mit diesem Lied kannst du andere aufspuehren!",
  "spiele 'lied der winde' auf <ziel>");
  this_player()->SetProp(P_PARALYZED, 0);
  remove(1);
}

public void SetNorth() { north = 1; }
public void SetSouth() { south = 1; }
public void SetEast() { east = 1; }
public void SetWest() { west = 1; }