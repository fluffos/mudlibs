inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

int currentVerse;
string *verses;
mixed *checkpoints;

public void create() {
  int i;
  if (!is_clone(this_object())) return; 
  
  ::create();
  SetProp(P_INVIS, 1);
  SetProp(P_NAME, "Wanderlied Quest");

  currentVerse = 0;
  verses = call_other("/gilden/bardengilde/obj/reiselied", "GetVerses");
  checkpoints = ({ 
    ({ "/d/ebene/Midas/room/kaeseladen", "/d/ebene/Midas/room/room_h5" }),
    ({ "/gilden/zechpreller" }),
    ({ "/d/huegelland/feyaria/weg/room/wald2" }),
    ({ "/d/huegelland/zordan/fischerweg/room/a9a0" }),
    ({ "/d/kristallwald/sargola/insel/room/1" }),
    ({ "/d/kristallwald/sargola/dorf/room/kneipe" }),
    ({ "/d/gebirge/eros/room/berg_d18", "/d/gebirge/dusty/zwerge/room/bierribs" }),
    ({ "/d/gebirge/iwo/arwenock/room/room_B-04" }),
    ({ "/d/dschungel/feyaria/kueste/room/room_q3" }),
    ({ "/d/dschungel/feyaria/dorf/room/dorf-001" }),
    ({ "/d/wueste/arthoas/erg/room/aragh/raum42", "/d/wueste/protheg/karavanen/room/arakar" }),
    ({ "/d/wueste/gwenshara/estadt/room/basari/basari_2x1", "/d/wueste/protheg/kraterrand/room/steg" }),
    ({ "/d/wasser/stahldorn/weg/weg12" }),
    ({ "/d/wasser/lupus/mauritius/room/strand03" }),
    ({ "/d/polar/aaliyah/christmas/room/vorraum" }),
    ({ "/d/wasser/feyaria/schiffe/walfaenger" }),
    ({ "/gilden/dunkelelfen" }),
    ({ "/d/unterwelt/ronja/sternenwald/room/einhorn_06_08" }),
    ({ "/d/luft/hicks/wolkenstadt/room/ws1" })
  });

  AddId("\nbarden_quest_awf");

  AddCmd( "erinner|erinnere&an&strophe", "cmd_erinnern");
}

public void printCurrentVerse() {
  tell_object(this_player(), "----\n");
  tell_object(this_player(), verses[currentVerse]);
  tell_object(this_player(), "----\n");
}

public int cmd_erinnern(string str) {
    tell_object(this_player(), "Du denkst angestrengt nach...\n");
    printCurrentVerse();
    return 1;
}

public void CheckLocation() {
  object player, location;

  player   = environment(this_object());
  location = environment(player);

  if(!objectp(player) || !objectp(location)) {
    return;
  }

  call_out("run_location_check", 1+random(3), file_name(location));
}

public void run_location_check(string filename) {
  if(member(checkpoints[currentVerse], filename) >= 0) {
    checkpoints[currentVerse] -= ({ filename });
  }  

  if(sizeof(checkpoints[currentVerse]) <= 0) {
    currentVerse++;
    if(currentVerse >= sizeof(verses)) {
      LearnBardSpell(this_player(), "aller welten freund", "Wenn du dieses Lied spielst, wirst du angenehmere Reisen haben!",
      "spiele 'aller welten freund'");
      call_out("remove", 0, 1);
    } else {
      tell_object(this_player(), "Nun, da du hier bist, faellt dir plotzlich ein neuer Vers ein:\n");
      printCurrentVerse();
    }
  }
}

public int QueryCurrentVerse() {
  return currentVerse;
}

public string* QueryCurrentLocations() {
  return checkpoints[currentVerse];
}
