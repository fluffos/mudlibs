
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();

  AddId(({"blumen", "strauss", "blumenstrauss"}));
  SetProp(P_SHORT, "Ein wunderschoener Blumenstrauss");
  SetProp(P_LONG, "Dieser Blumenstrauss wurde aus Dschungelblumen gebunden. Er dient dazu, den "
                  "gefallenen, grossen Helden einen letzten Tribut zu zollen. Wirf ihn in den "
                  "Eingang des geheimnisvollen Brunnens, der letzten Ruhestatt der Helden.");
  SetProp(P_NAME, "Blumenstrauss");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_MATERIAL, ([MAT_METAL:80, MAT_GLASS:20]) );

  AddCmd("wirf|werfe&blumen|blumenstrauss|strauss&in&brunnen|eingang", "cmd_werfen", "Was willst du wohin werfen?");
}

public int cmd_werfen() {
  if(!present("\nwellentrancenpc", ENV(TP))) {
    write("Aber der Brunnen ist doch gar nicht hier?!\n");
    return -1;
  }

  write(BS("Du wirfst den den Blumenstrauss in den Eingang des Brunnens und haeltst kurz inne, um der "
           "gefallenen Helden zu gedenken."));
  say(BS(TPN + " wirft einen Blumenstrauss in den Eingang zum Brunnen und haelt kurz inne, um der "
         "gefallenen Helden zu gedenken."));

  LearnBardSpell(TP, "ruf der helden", "spiele 'ruf der helden' [auf <ziel>]",
                 "Der Ruf der Helden manifestiert in einem Ziel die Eigenschaften der alten Helden und "
                 "erhoeht so die Attribute.");

  remove(1);
  return 1;
}
