#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

public void check_bard_awf_quest(object pl) {
    object task;
    if(pl->QueryProp(P_GUILD) == "bardengilde" && (task=present("\nbarden_quest_awf", pl))) {
        task->CheckLocation();
    }
}