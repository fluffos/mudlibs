
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>
#include <verben.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";



public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();

  AddId(({"zettel", "\nbard_gs7_strophe"}));
  SetProp(P_SHORT, "Ein abgerissener Zettel");
  SetProp(P_LONG, ".");
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_MATERIAL, ([MAT_PAPER:80, MAT_INK:10, MAT_MISC_LIVING: 5, MAT_MISC_UNHOLY: 5]) );

  AddCmd(CMD_LESEN, "cmd_lesen");
}

public int cmd_lesen(string str) {
  string brief;

  notify_fail("Was willst du lesen?\n");
  if(!id(str)) return 0;

  brief =  
  "Auf dem Zettel steht in krakeliger Handschrift geschrieben:\n\n";
  
  if(id(BARD_ID_GS7_STROPHE_1)) {
    brief += 
    "Mitternacht umgab mich schaurig, als ich einsam, trueb und traurig,\n"
    "Sinnend sass und las von mancher laengst verklung'nen Maehr' und Lehr' -\n"
    "Als ich schon mit matten Blicken im Begriff, in Schlaf zu nicken,\n"
    "Hoerte ploetzlich ich ein Ticken an die Zimmertuere her;\n"
    "\"Ein Besuch wohl noch,\" so dacht' ich, \"den der Zufall fuehret her -\n"
    "Ein Besuch und sonst Nichts mehr.\"\n"
    "\n"
    "Wohl hab' ich's im Sinn behalten, im Dezember war's, im kalten,\n"
    "Und gespenstige Gestalten warf des Feuers Schein umher.\n"
    "Sehnlich wuenscht' ich mir den Morgen, keine Lind'rung war zu borgen\n"
    "Aus den Buechern fuer die Sorgen - fuer die Sorgen tief und schwer\n"
    "Um die Sel'ge, die Lenoren nennt der Engel heilig Heer -\n"
    "Hier, ach, nennt sie Niemand mehr!\n"
    "\n"
    "Jedes Rauschen der Gardinen, die mir wie Gespenster schienen,\n"
    "Fuellte nun mein Herz mit Schrecken - Schrecken nie gefuehlt vorher;\n"
    "Wie es bebte, wie es zagte, bis ich endlich wieder sagte:\n"
    "\"Ein Besuch wohl, der es wagte, in der Nacht zu kommen her -\n"
    "Ein Besuch, der spaet es wagte, in der Nacht zu kommen her;\n"
    "Dies allein und sonst Nichts mehr.\"\n"
    "\n"
    "Und ermannt nach diesen Worten oeffnete ich stracks die Pforten:\n"
    "\"Dame oder Herr,\" so sprach ich, \"bitte um Verzeihung sehr!\n"
    "Doch ich war mit matten Blicken im Begriff, in Schlaf zu nicken,\n"
    "Und so leis scholl Euer Ticken an die Zimmertuere her,\n"
    "Dass ich kaum es recht vernommen; doch nun seid willkommen sehr!\" -\n"
    "Dunkel da und sonst Nichts mehr.\n"
    "\n"
    "Duester in das Dunkel schauend stand ich lange starr und grauend,\n"
    "Traeume traeumend, die hienieden nie ein Mensch getraeumt vorher;\n"
    "Zweifel schwarz den Sinn betoerte, Nichts die Stille draussen stoerte,\n"
    "Nur das eine Wort man hoerte, nur \"Lenore?\" klang es her;\n"
    "Selber haucht' ich's, und \"Lenore!\" trug das Echo trauernd her -\n"
    "Einzig dies und sonst Nichts mehr.\n"
    "\n";
  } else if(id(BARD_ID_GS7_STROPHE_2)) {
    brief += 
    "Als ich nun mit tiefem Bangen wieder ins Gemach gegangen,\n"
    "Hoert' ich bald ein neues Pochen, etwas lauter als vorher.\n"
    "\"Sicher,\" sprach ich da mit Beben, \"an das Fenster pocht' es eben,\n"
    "Nun wohlan, so lass mich streben, dass ich mir das Ding erklaer' -\n"
    "Still, mein Herz, dass ich mit Ruhe dies Geheimnis mir erklaer'\n"
    "Wohl der Wind und sonst Nichts mehr.\"\n"
    "\n"
    "Riss das Fenster auf jetzunder, und herein stolziert' - o Wunder!\n"
    "Ein gewalt'ger, hochbejahrter Rabe schwirrend zu mir her;\n"
    "Flog mit maecht'gen Fluegelstreichen, ohne Gruss und Dankeszeichen,\n"
    "Stolz und stattlich sonder Gleichen, nach der Tuere hoch und hehr -\n"
    "Flog nach einer Pallasbueste ob der Tuere hoch und hehr -\n"
    "Setzte sich und sonst Nichts mehr.\n"
    "\n"
    "Und trotz meiner Trauer brachte er dahin mich, dass ich lachte,\n"
    "So gesetzt und gravitaetisch herrscht' auf meiner Bueste er.\n"
    "\"Ob auch alt und nah dem Grabe,\" sprach ich, \"bist kein feiger Knabe,\n"
    "Grimmer, glattgeschor'ner Rabe, der Du kamst vom Schattenheer -\n"
    "Sprich, welch' stolzen Namen fuehrst Du in der Nacht pluton'schem Heer?\"\n"
    "Sprach der Rabe: \"Nimmermehr.\"\n"
    "\n"
    "Ganz erstaunt war ich, zu hoeren dies Geschoepf mich so belehren,\n"
    "Schien auch wenig Sinn zu liegen in dem Wort bedeutungsleer;\n"
    "Denn wohl Keiner koennte sagen, dass ihm je in seinen Tagen\n"
    "Sonder Zier und sonder Zagen so ein Tier erschienen waer',\n"
    "Das auf seiner Marmorbueste ob der Tuer gesessen waer'\n"
    "Mit dem Namen \"Nimmermehr.\"\n"
    "\n"
    "Dieses Wort nur sprach der Rabe dumpf und hohl, wie aus dem Grabe,\n"
    "Als ob seine ganze Seele in dem einen Worte waer'.\n"
    "Weiter Nichts ward dann gesprochen, nur mein Herz noch hoert' ich pochen,\n"
    "Bis das Schweigen ich gebrochen: \"Andre Freunde floh'n seither -\n"
    "Morgen wird auch er mich fliehen, wie die Hoffnung floh seither.\"\n"
    "Sprach der Rabe: \"Nimmermehr!\"\n"
    "\n"
    "Immer hoeher stieg mein Staunen bei des Raben dunklem Raunen,\n"
    "Doch ich dachte: \"Ohne Zweifel weiss er dies und sonst Nichts mehr;\n"
    "Hat's von seinem armen Meister, dem des Ungluecks finstre Geister\n"
    "Drohten dreist und drohten dreister, bis er trueb und trauerschwer -\n"
    "Bis ihm schwand der Hoffnung Schimmer, und er fortan seufzte schwer:\n"
    "‚O nimmer - nimmermehr!‘\"\n"
    "\n"
    "Trotz der Trauer wieder brachte er dahin mich, dass ich lachte;\n"
    "Einen Armstuhl endlich rollte ich zu Tuer und Vogel her.\n"
    "In den sammt'nen Kissen liegend, in die Hand die Wange schmiegend,\n"
    "Sann ich, hin und her mich wiegend, was des Wortes Deutung waer' -\n"
    "Was der grimme, finst're Vogel aus dem naecht'gen Schattenheer\n"
    "Wollt' mit seinem \"Nimmermehr.\"\n";
  } else {
    brief +=
    "Dieses sass ich still ermessend, doch des Vogels nicht vergessend,\n"
    "Dessen Feueraugen jetzo mir das Herz beklemmten sehr;\n"
    "Und mit schmerzlichen Gefuehlen liess mein Haupt ich lange wuehlen\n"
    "In den veilchenfarb'nen Pfuehlen, ueberstrahlt vom Lichte hehr -\n"
    "Ach, in diesen samtnen Pfuehlen, ueberstrahlt vom Lichte hehr -\n"
    "Ruhet sie jetzt nimmermehr!\n"
    "\n"
    "Und ich waehnte, durch die Luefte wallten suesse Weihrauchduefte,\n"
    "Ausgestreut durch unsichtbare Seraphshaende um mich her.\n"
    "\"Lethe,\" rief ich, \"suesse Spende schickt Dir Gott durch Engelshaende,\n"
    "Dass sich von Lenoren wende Deine Trauer tief und schwer!\n"
    "Nimm, o nimm die suesse Spende und vergiss der Trauer schwer!\"\n"
    "Sprach der Rabe: \"Nimmermehr!\"\n"
    "\n"
    "\"Gramprophet!\" rief ich voll Zweifel, \"ob Du Vogel oder Teufel!\n"
    "Ob die Hoelle Dich mir sandte, ob der Sturm Dich wehte her!\n"
    "Du, der von des Orkus Strande - Du, der von dem Schreckenlande\n"
    "Sich zu mir, dem Trueben, wandte - kuende mir mein heiss Begehr:\n"
    "Find' ich Balsam noch in Gilead! ist noch Trost im Gnadenmeer?\"\n"
    "Sprach der Rabe: \"Nimmermehr!\"\n"
    "\n"
    "\"Gramprophet!\" rief ich voll Zweifel, \"ob Du Vogel oder Teufel!\n"
    "Bei dem ew'gen Himmel droben, bei dem Gott, den ich verehr' -\n"
    "Kuende mir, ob ich Lenoren, die hienieden ich verloren,\n"
    "Wieder find' an Edens Toren - sie, die throhnt im Engelsheer -\n"
    "Jene Sel'ge, die Lenoren nennt der Engel heilig Heer!\"\n"
    "Sprach der Rabe: \"Nimmermehr!\"\n"
    "\n"
    "\"Sei dies Wort das Trennungszeichen! Vogel, Daemon, Du musst weichen!\n"
    "Fleuch zurueck zum Sturmesgrauen, oder zum pluton'schen Heer!\n"
    "Keine Feder lass zuruecke mir als Zeichen Deiner Tuecke;\n"
    "Lass allein mich dem Geschicke - wage nie Dich wieder her!\n"
    "Fort und lass mein Herz in Frieden, das gepeinigt Du so sehr!\"\n"
    "Sprach der Rabe: \"Nimmermehr!\"\n"
    "\n"
    "Und der Rabe weichet nimmer - sitzt noch immer, sitzt noch immer\n"
    "Auf der blassen Pallasbueste ob der Tuere hoch und hehr;\n"
    "Sitzt mit geisterhaftem Munkeln, seine Feueraugen funkeln\n"
    "Gar daemonisch aus dem dunkeln, duestern Schatten um ihn her;\n"
    "Und mein Geist wird aus dem Schatten, den er breitet um mich her,\n"
    "Sich erheben - nimmermehr!\n";
  }
  this_player()->More(brief);

  tell_room(environment(this_player()), sprintf("%s liest einen abgeranzten Zettel.\n", this_player()->Name(WER)), ({this_player()}));
  return 1;
}
