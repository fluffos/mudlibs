
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

string eaten, *foods;

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();

  AddId(({"liste", "essensliste", "speisenliste", "liste mit mahlzeiten", "liste mit essen", "bestes essen", BARD_ID_GS10_TASK}));
  SetProp(P_SHORT, "Eine Liste mit dem besten Essen im Silberland");
  SetProp(P_NAME, "Essensliste");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_MATERIAL, ([MAT_PAPER:80, MAT_INK:10, MAT_MISC_LIVING: 5, MAT_MISC_UNHOLY: 5]) );

  foods = ({
    "Ein Stueck Wildschweinbraten",
    "Ein Glas Green Tropical",
    "Eine Portion Hirschbraten",
    "Eine Flasche Hirnreiniger",
    "Die Pizza aller Pizzas",
    "Ein Seiterl Tipfer Urtyp",
    "Ein Teller Guhlasch",
    "Dantes Special",
    "Ein Becher Fruechtetraum",
    "Eine Knarkhwurst (knackig)",
    "Ein Kamelsteak (mit Hoecker!)",
    "Ein Stamperl Dunkelschnaps",
    "Ein Glas Erdbeerschlingline"
  });
  eaten = "";
}

public string _query_long() {
  string str;
  int i;

  str = BS("Diese Liste sieht aus, als haette sie jemand aus einem Restaurantfuehrer gerissen. "
        "In grossen Lettern pragt darauf: ");
  str += "\n * * * DIE BESTEN MAHLZEITEN IM SILBERLAND * * *\n";
  
  for(i=0; i<sizeof(foods); i++) {
    str += sprintf("%2d. %-32s %s\n", i+1, foods[i], (test_bit(eaten, i)?"(erledigt)":""));
  }

  str += "\nWo du das alles findest, steht hier leider nicht.\n";
  return str;
}

public void init() {
  object pl;
  ::init();
  if(!is_clone(this_object())) return;
  if(!interactive(pl=environment(this_object()))) {
    remove(1);
    return;
  }
}

private int hasEatenEverything() {
  int i;
  for(i=0; i<sizeof(foods); ++i) {
    if(!test_bit(eaten, i)) return 0;
  }
  return 1;
}

public void inspireSong() {
  tell_object(ENV(TO), BS("Nun hast du also die besten Speisen des Silberlands gekostet!"));

  call_out("LearnBardSpell", 0, environment(this_object()), "sei hier gast", 
           "Dieses Lied erhoeht die Qualitaet der Speisen und Getraenke eines Loklals.",
           "spiele 'sei hier gast'");

  call_out("remove", 2);
  return;
}

public void MarkFood(int nr) {
  tell_object(environment(this_object()), BS("Nachdem du dies genossen hast, streichst du Eintrag von deiner Liste."));
  eaten = set_bit(eaten, nr);

  if(hasEatenEverything()) {
    call_out("inspireSong", 0);
  }
  return;
}
