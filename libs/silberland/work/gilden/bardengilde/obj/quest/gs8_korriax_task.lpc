
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

int licked = 0;

string * wueten_messages = ({
  " ist wuetend.",
  " kocht vor Wut.",
  " brodelt.",
  " schaeumt vor Wut.",
  "s Halsschlagader schwillt unglaublich an.",
  " hat Tollwut?",
  " tobt schaeumend herum.",
  " beisst sich vor Wut die Lippen auf und schleckt das Blut gierig ab.",
  " schnaubt voller Wut.",
  " wird vor Wut ganz rot im Gesicht.",
  " zerplatzt fast vor Wut.",
  " grunzt wuetend.",
  " fletscht die Zaehne.",
  " bruellt wuetend.",
  " faucht Dich wuetend an.",
});

string *wueten_messages_self = ({
  "Du bist wuetend.",
  "Du kochst vor Wut.",
  "Du brodelst.",
  "Du schaeumst vor Wut.",
  "Deine Halsschlagader schwillt unglaublich an.",
  "Hast du Tollwut?",
  "Du tobst schaeumend herum.",
  "Du beisst dir vor Wut die Lippen auf und schleckst das Blut gierig ab.",
  "Du schnaubst voller Wut.",
  "Du wirst vor Wut ganz rot im Gesicht.",
  "Du zerplatzt fast vor Wut.",
  "Du grunzt wuetend.",
  "Du fletschst die Zaehne.",
  "Du bruellst wuetend.",
  "Du fauchst wuetend.",
});

void wueten_message()
{
  object owner;
  owner = environment(this_object());
  if(!owner) {
    remove(1);
    return;
  }

  ENV(owner)->Message( owner->Name(WER) + 
    wueten_messages[random(sizeof(wueten_messages))] + "\n",
    MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE: ({owner})]) );

  owner->Message(wueten_messages_self[random(sizeof(wueten_messages))] + "\n");

  call_out("wueten_message", 10+random(30));
}

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();

  AddId(({"\nbard_gs8_task"}));
  SetProp(P_SHORT,"""");
  SetProp(P_LONG, "");
  SetProp(P_NAME, "Eine Bardenaufgabe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
}

public void init() {
  object pl;
  ::init();
  if(!is_clone(this_object())) return;
  if(!interactive(pl=environment(this_object()))) {
    remove(1);
    return;
  }
}

public void SetLicked() {
  object pl;

  pl = environment(this_object());
  if(!objectp(pl)) {
    remove(1);
    return;
  } 

  licked = 1;
  tell_object(pl, "Unbaendige Wut wallt in dir hoch.");
  call_out("wueten_message", 10);
}

public void bear_killed() {
  object pl;

  pl = environment(this_object());
  if(!objectp(pl)) {
    remove(1);
    return;
  } 

  if(!licked) {
    tell_object(pl, BS("Tja, der Baer ist tot. Aber irgendwie bist du nicht wuetend genug."));
    return;
  }

  tell_object(pl, "\n\n");
  tell_object(pl, BS("Blutverschmiert erhebst du dich mit einem wuetenden Bruellen ueber deinen erschlagenen Feind!"));
  tell_object(pl, "\n\n");


  LearnBardSpell(pl, "toetet das biest",  
                 "Dieses Lied entfacht in dir eine heisse Wut, die deine Feinde verbrennen wird.", 
                 "spiele 'toetet das biest'");
  call_out("remove", 3, 1);
}