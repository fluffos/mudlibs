#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein paar vergilbte Notenblaetter");
  SetProp(P_NAME, "Notenblaetter");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LONG, "Du haeltst ein Buendel vergilbter Notenblaetter in deinen "
                  "Haenden. Sie fuehlen sich alt, ehrwuerdig und bruechig an. "
                  "In feiner Handschrift erkennst du den Titel des Werkes: @@title@@");
//--Namen------------------------------------------------------------------
  AddId(({"\nbarden_noten_schildlied", "notenblaetter", "blaetter", "noten"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PAPER: 70, MAT_INK: 10, MAT_MAGIC: 20]) );
  SetProp(P_VALUE, 100000000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Diese Notenblaetter solltest du besser studieren!");
  SetProp(P_INFO, "In diesen Notenblaettern ist ein altes Zauberlied niedergelegt. "
                  "Du solltest sie besser studieren!");

  AddCmd( "lies|les|lese|studiere|studier&noten|notenblaetter|blaetter|lied|zauberlied", "cmd_lesen", "Was willst du lesen?");
}

public int cmd_lesen() {
    string song;

    switch(this_player()->QueryProp(P_BARD_GROUP)) {
        case BARD_GROUP_ALESTRA:
            song = "ballade vom drachentoeter";
            break;
        case BARD_GROUP_TIRENA:
            song = "schildsang der walkueren";
            break;
        case BARD_GROUP_KORRIAX:
            song = "zwergisches ahnenlied";
            break;
        case BARD_GROUP_SARRIAN:
            song = "stolze mauer am fluss";
            break;
        default:
            song = "alle meine entchen";
            break;
    }

    if(this_player()->QuerySkill(song) != 0) {
        write("Das kennst du schon. Du wirfst die Notenblaetter weg.\n");
        remove(1);
        return -1;
    }

    write(BS("Sorgfaeltig studierst du den niedergeschriebenen Gesang..."));
    say(BS(this_player()->Name(WER, 1) + " studiert ein paar alte Notenblaetter."));

    LearnBardSpell(this_player(), song, "Dieses Lied wird dich schuetzen!",
            sprintf("spiele '%s' [auf <ziel>]", song));

    write(BS("Die Notenblaetter zerbroeseln unter deinen Fingern..."));
    remove(1);
    return 1;
}

public string title() {
    switch(this_player()->QueryProp(P_BARD_GROUP)) {
        case BARD_GROUP_ALESTRA:
            return "Ballade vom Drachentoeter";
            break;
        case BARD_GROUP_TIRENA:
            return "Schildsang der Walkueren";
            break;
        case BARD_GROUP_KORRIAX:
            return "Zwergisches Ahnenlied";
            break;
        case BARD_GROUP_SARRIAN:
            return "Stolze Mauer am Fluss";
            break;
        default:
            return "Alle meine Entchen! (Rock-Edition)";
            break;
    }
}

