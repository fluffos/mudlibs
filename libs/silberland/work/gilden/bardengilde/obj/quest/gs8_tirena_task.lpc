
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();

  AddId(({"brille", "aerendils brille", BARD_ID_GS8_BRILLE}));
  SetProp(P_SHORT, "Aerendils Brille");
  SetProp(P_LONG, "Es handelt sich hierbei um eine einfache Nickelbrille. Sie gehoert "
                  "Aerendil, dem Bibliothekar in Elessar.");
  SetProp(P_NAME, "Aerendils Brille");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_MATERIAL, ([MAT_METAL:80, MAT_GLASS:20]) );
}

public void reset() {
  object env;
  if(!is_clone(TO)) return;
  ::reset();

  env = ENV(TO);

  if(!objectp(env) || !living(ENV(TO))) {
    remove(1);
  }

  if(objectp(env) && env->QueryProp(P_GUILD) != "bardenglide") {
    remove();
  }
}
