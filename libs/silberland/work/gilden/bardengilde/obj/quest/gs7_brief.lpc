
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();

  AddId(({"brief", "abschiedsbrief", BARD_ID_GS7_BRIEF}));
  SetProp(P_SHORT, "Ein Abschiedsbrief");
  SetProp(P_LONG, "Dieser Brief wurde in ein verschlissenes Kuvert gesteckt und ist ueber und ueber "
                  "mit Tintenklecksen versehen. Als Absender steht dort: Edgar.");
  SetProp(P_NAME, "Abschiedsbrief");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_MATERIAL, ([MAT_PAPER:80, MAT_INK:10, MAT_MISC_LIVING: 5, MAT_MISC_UNHOLY: 5]) );

  AddCmd("lies|lese&brief|abschiedsbrief", "cmd_lesen", "Was willst du lesen?");
}

public int cmd_lesen(string str) {
  string brief;

  brief =  
  "  +-----------------------------------------------------------------------+\n"
  "  | Liebste Irinja,                                                       |\n"
  "  |                                                                       |\n"
  "  | Die letzten Jahre habe ich damit zugebracht ungeschen zu machen, was  |\n"
  "  | niemals haette geschehen sollen. Wenn du diese Zeilen liest, so ist   |\n"
  "  | der letzte Rest meiner selbst nicht mehr in dieser Welt gefangen.     |\n"
  "  | Ach ich armer Tor! Haette ich geahnt, welch schreckliche Folgen mein  |\n"
  "  | Magnum Opus fuer uns alle haben wird! Ich haette eingehalten!         |\n"
  "  |                                                                       |\n"
  "  | Nunmehr habe ich getan, was ich konnte, um mein Vermaechtnis, meine   |\n"
  "  | Werke zu zerstreuen. Jedes in sich ein Anker fuer die Welt der        |\n"
  "  | Traeume. Doch weh! Welche Traeume das sind. Welch Wahnsinn! Von da,   |\n"
  "  | wo ich die ersten Worte meiner Verse geschrieben, sind Wahn und Sinn  |\n"
  "  | verschmolzen, wie Wachs zyklopaeischer Kerzen im Dunkel des Verstands.|\n"
  "  | Und aus dem Wachs erhoben sich Kreaturen, alt und aelter als die      |\n"
  "  | Aeltesten! Aus den Fluten wird sich erheben, denn es ist nicht tot,   |\n"
  "  | was ewig liegt, bis dass die Zeit den Tod besiegt!                    |\n"
  "  |                                                                       |\n"
  "  | Dies werden meine letzten Zeilen sein. Ein einziges meiner Gedichte   |\n"
  "  | verbleibt noch. Ein einziger Anker der Nichtwelt in der Welt. Und SIE |\n"
  "  | wissen, dass ich versuche ihn zu vernichte. Ihre Diener sind bereits  |\n"
  "  | hinter mir in den Schatten! Ihre protoplasmischen, formlosen Arme     |\n"
  "  | greifen aus den Schatten schon nach mir.                              |\n"
  "  |                                                                       |\n"
  "  | Alsbald ich diesen Brief verschickt, begebe ich mich an jenen Ort,    |\n"
  "  | welcher meiner letzten Zeilen Ruhestatt ist. Allein die Praesenz      |\n"
  "  | der mystischen Worte zerreisst dort Raum und Zeit mit kosmischem      |\n"
  "  | Schrecken. Die Welt und Nichtwelt sind dort verwoben, und ziehen      |\n"
  "  | schon allerlei hexerisches Gesindel an.                               |\n"
  "  |                                                                       |\n"
  "  | Gelingt es mir die Zeilen in drei Stuecke zu zerreissen und jedes     |\n"
  "  | fuer sich zu vernichten in den reinigenden Flammen, so mag sich der   |\n"
  "  | der Zugang zur Nichtwelt, wo ER, der nicht tot, sondern nur           |\n"
  "  | schlafend ist, fuer immer schliessen.                                 |\n"
  "  |                                                                       |\n"
  "  | Doch gemahne ich SEINER Diener. Packen sie mich, bevor ich meine Tat  |\n"
  "  | vollbracht, so werden die Welten niemals getrennnt. Traum und Wahn    |\n"
  "  | werden Eins sein. Es ist mein erklaertes Ziel dies zu verhindern! Die |\n"
  "  | Tuer, welche ich aufgestossen, muss auch ich wieder schliessen.       |\n"
  "  |                                                                       |\n"
  "  | So du kein Wort mehr von mir hoerst, so bin ich wohl gescheitert und  |\n"
  "  | selbst Opfer meiner eigenen Groesse geworden. Ph’nglui mglw’nafh      |\n"
  "  | Cthulhu R’lyeh wgah’nagl fhtagn.                                      |\n"
  "  |                                                                       |\n"
  "  |                                                                 Edgar |\n"
  "  +-----------------------------------------------------------------------+\n";
  this_player()->More(brief);

  tell_room(environment(this_player()), sprintf("%s liest einen Brief.\n", this_player()->Name(WER)), ({this_player()}));
  return 1;
}

public void check_teile() {
  object pl;
  if(!interactive(pl=environment(this_object()))) {
    remove(1);
    return;
  }

  if(objectp(present(BARD_ID_GS7_STROPHE_1, pl)) &&
     objectp(present(BARD_ID_GS7_STROPHE_2, pl)) &&
     objectp(present(BARD_ID_GS7_STROPHE_3, pl))) {
       call_out("start_final_stage", 1);
  }
}

public void init() {
  object pl;
  ::init();
  if(!is_clone(this_object())) return;
  if(!interactive(pl=environment(this_object()))) {
    remove(1);
    return;
  }

  check_teile();
}

public void start_final_stage() {
  object pl; 
  if(!interactive(pl=environment(this_object()))) {
    remove(1);
    return;
  }

  tell_object(pl, BS("Du hast nun alle Teile beisammen. Jetzt wird es Zeit sie zu verbennen "
                     "und Edgars Werk ungeschehen zu machen!"));
  AddCmd("verbrenne|verbrenn&brief|gedicht|strophen|zettel", "cmd_verbrennen", "Was willst du verbrennen?\n");
}

public int cmd_verbrennen() {
  if(!objectp(present("fackel", this_player())) &&
     !objectp(present("feuerwusel", environment(this_player()))) &&
     !objectp(present("feuerelementar", environment(this_player()))) &&
     !stringp(environment(this_player())->GetDetail("feuerstelle"))) {
      tell_object(this_player(), "Um etwas zu verbrennen benoetigst du Feuer.\n");
      return -1;
  }

  this_player()->SetProp(P_PARALYZED, ([
    PARALYZE_TIME: 300,
    PARALYZE_MSG: "Du bist gerade dabei etwas zu verbennen.\n",
  ]));
  tell_object(this_player(), BS("Entschlossen nimmst du das Gedicht in die Hand."));

  call_out("sequence_burn", 1, 0, this_player());
  return 1;
}

public void sequence_burn(int step, object pl) {
  if(!objectp(pl)) return;

  switch(step) {
    case 0:
      tell_object(pl, BS("Du atmest noch einmal tief durch und haeltst das Papier ins Feuer."));
      break;
    case 1:
      tell_object(pl, BS("Das Feuer ergreift eine Ecke des Buendels und beginnt sich langsam auszubreiten."));
      break;
    case 2:
      tell_object(pl, BS("Schwarzer Rauch kraeuselt sich als das Papier sich schwarz faerbt. War das eine gute Idee?"));
      break;
    case 3:
      tell_object(pl, BS("Vielleicht koennte die Macht die in diesen Worten steckt doch nuetzlich sein?"));
      break;
    case 4:
      tell_object(pl, BS("Das Feuer breitet sich immer weiter aus. Nervoes siehst du weiter zu..."));
      break;
    case 5:
      tell_object(pl, BS("Als die Tinte zu verkochen beginnt steigst du unruhig von einem Fuss auf den anderen."));
      break;
    case 6:
      tell_object(pl, BS("Auf einmal ueberkommt dich der Wunsch die Worte zu lesen! Rasch blaest du die Flammen aus."));
      break;
    case 7:
      tell_object(pl, BS("Nur ein paar Zeilen sind nicht Raub der Flammen geworden. Schnell praegst du sie dir ein."));
      call_out("LearnBardSpell", 0, this_player(), "der besuch des raben", 
               "Mit diesem Gedicht treibst du deine Feinde in kosmischen Wahnsinn.", "spiele 'der besuch des raben' auf <gegner>");
      break;
    case 8:
      tell_object(pl, BS("Erleichtert atmest du auf."));
      break;
    case 9:
      tell_object(pl, BS("Von irgendwoher hoerst du leise ein dumpfes, boesartiges Lachen..."));
      while(objectp(present("\nbard_gs7_strophe", pl))) {
        present("\nbard_gs7_strophe", pl)->remove(1);
      }
      pl->SetProp(P_PARALYZED, 0);
      remove(1);
      break;
    default:
      raise_error("falscher sequenz schritt");
      break;
  }

  if(step < 9)  {
    call_out("sequence_burn", 4, ++step, this_player());
  }
}