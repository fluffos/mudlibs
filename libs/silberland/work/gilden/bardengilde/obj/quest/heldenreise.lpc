inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"
#include <wizlevels.h>

inherit "std/thing";

nosave mapping targets = ([
    HERO_ANGARA: "/d/wasser/stahldorn/knarkh/npc/dobbodox",
    HERO_ARCON: "/d/unterwelt/dante/skel/skelettdrache",
    HERO_FLAMMARA: "/d/kristallwald/delgo/wachweg/npc/fathania",
    HERO_GRIMM: "/d/kristallwald/chivas/orkhoehle/npc/ofuerst",
    HERO_KHARTAK: "/d/ebene/lamuerte/burg/npc/berzerker",
    HERO_NOGI: "/d/huegelland/raballion/hobbits/npc/bronzedrache",
    HERO_RYNOXA: "/d/wueste/andyl/kanalisation/npc/beholder",
    HERO_XULGSCH: "/gilden/paladine/npc/mythar",
]);

private int done;

public void create() {
    if (!is_clone(this_object())) return; 
    
    ::create();

    done = 0;

    SetProp(P_INVIS, 1);
    SetProp(P_NEVERDROP, 1);
    SetProp(P_NODROP, 1);
    SetProp(P_NOSELL, 1);
    SetProp(P_NAME, "Heldenpfad Quest");
    AddId("\nbarden_hero_killquest");
  }

  public void Mark() {

    if(environment(TO)->QueryProp(P_TESTPLAYER)) {
        tell_object(environment(TO), sprintf("heldenreise :: Mark() :: PO = %s\n", file_name(PO)));
    }

    if(explode(file_name(PO), "#")[0] == targets[QueryProp("hero")] || IS_ARCH(PO)) done = 1;

    return;
  }

  public int IsDone() {
    return done;
  }
  