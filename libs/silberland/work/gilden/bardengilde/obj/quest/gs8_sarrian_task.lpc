
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <moving.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

string seenBeasts;

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();

  AddId(({BARD_ID_GS8_TASK}));
  SetProp(P_SHORT,"");
  SetProp(P_LONG, "");
  SetProp(P_NAME, "Eine Bardenaufgabe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);

  seenBeasts = "";
}

public void init() {
  object pl;
  ::init();
  if(!is_clone(this_object())) return;
  if(!interactive(pl=environment(this_object()))) {
    remove(1);
    return;
  }
}

public void SetBeastSeen(int nr) {
  if(nr < 1 || nr > 4) {
    raise_error("Beast does not Exist");
    return;
  }

  seenBeasts = set_bit(seenBeasts, nr);

  if(test_bit(seenBeasts, 1) && test_bit(seenBeasts, 2) &&
     test_bit(seenBeasts, 3) && test_bit(seenBeasts, 4)) {
       call_out("all_seen", 0);
     }
}

public void all_seen() {
  object pl;

  pl = environment(this_object());
  if(!objectp(pl)) {
    remove(1);
    return;
  } 

  tell_object(pl, "\n\n");
  tell_object(pl, BS("Du zitterst vor Angst, jetzt, da du die vier Bestien gesehen hast!"));
  tell_object(pl, "\n\n");


  LearnBardSpell(pl, "wiegenlied des leids",  
                 "Mit diesem Lied strahlst du unheimliche Furcht aus, die das Herz deiner Feinde zum stocken bringt!", 
                 "spiele 'wiegenlied des leids' [auf <ziel>]");
  call_out("remove", 3, 1);
}