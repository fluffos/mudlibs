
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

int used;

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();
  used = 0;
  
  AddId(({"uhr", "spieluhr", "\nbard_spieluhr", "feenspieluhr"}));
  SetProp(P_SHORT, "Eine schoene Feenspieluhr");
  SetProp(P_LONG, "Diese schoen verzierte Schatulle ist etwa von der Groesse deiner Handflaeche und "
                  "etwa drei deiner Finger hoch. Sie wurde offenbar aus Eschenholz geschnitzt. "
                  "Elegante, feingearbeitete Einlegearbeiten aus Perlmutt und Elfenbein komplettieren "
                  "das Bild. Vorne ist sie mit einem kleinen Haeckchen verschlossen.");
  SetProp(P_NAME, "Feenspieluhr");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 20);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 1000000);
  SetProp(P_NODROP, 1);
  SetProp(P_MATERIAL, ([MAT_ASH_WOOD:50, MAT_COPPER:20, MAT_MAGIC:20, MAT_MISC_HOLY:10]) );
  SetProp(P_INFO, "In dieser Spieluhr steckt ein Zauberlied.");

  AddCmd( "oeffne|oeffen&spieluhr|uhr|feenspieluhr|schatulle", "cmd_oeffnen", "Was willst du oeffnen?\n");
}

public void musik(int scene) {
  string msg;

  if(!objectp(this_player()) || !used) {
    used = 0;
    return;
  }

  switch(scene) {
    case 0: 
      msg = "Die Musik klingt wie das Harfenspiel eines wahren Kuenstlers.";
      break;
    case 1:
      msg = "Langsam erheben sich durchscheinende, leuchtende Noten aus der Spieluhr.";
      break;
    case 2:
      msg = "Die materialisierte Musik schwirrt um dich herum.";
      break;
    case 3:
      msg = "Du spuerst wie dich diese ueberirdische Musik durchdringt.";
      this_player()->AddSp(20);
      break;
    case 4:
      msg = "Es fuehlt such an, als wuerde die Musik mit dir verschmelzen!";
      this_player()->AddSp(-20);
      break;
    case 5:
      msg = "Die Schatulle beginnt sich wieder zu schliessen.";
      break;
    case 6:
      msg = "Die Spieluhr klappt wieder zu. Mit einem kleinen Knall zerplatzt sie zu Feenstaub.";
      break;
    default:
      msg = "Fehler in der Spieluhr! Bitte einen Magier verstaendigen.";
      break;
  }

  tell_room(environment(this_player()), BS(msg));

  if(scene >= 6) {
    LearnBardSpell(this_player(), "lied der zauber", "Dieses Lied verstaerkt die Magie deiner anderen Lieder!",
            "spiele 'lied der zauber'");
    remove(1);
  } else {
    call_out("musik", 2+random(3), ++scene);
  }
  return;
}

public int cmd_oeffnen() {
  if(used) {
    tell_object(this_player(), BS("Die Spieluhr spielt doch schon Musik! Lausche einfach."));
    return -1;
  }

  tell_object(this_player(), BS("Du oeffnest die Spieluhr und wunderbare Feenmusik erklingt."));
  tell_room(environment(this_player()), BS(this_player()->Name(WER, 1) + " oeffnet eine Schatulle und wunderbare Feenmusik erklingt.")), ({this_player()});
  used = 1;
  call_out("musik", 2, 0);
  return 1;
}
