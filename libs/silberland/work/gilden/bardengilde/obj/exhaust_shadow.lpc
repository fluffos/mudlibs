object target;
float exhaustReduction;

public void activate(object _target, float _exhaustReduction) {
    target = _target;
    exhaustReduction = _exhaustReduction;

    shadow(target, 1);
}

varargs int do_exhaust(int exhaust, int silent) {
    tell_object(target, "shadowed do_exhaust called\n");
    return target->do_exhaust(exhaust, silent);
}
