/*
 * Das Lichtobjekt fuer 'Ode an die Sterne'
 *
 * Gwenshara@Silberland
 *
 * 11.07.2007
*/

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

object owner;

create()
{
  if (!is_clone(this_object())) return;
  ::create();  
  AddId (({BARDEN_SPELLID, SONG_STERNE}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, "Ode an die Sterne");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_MAGIC, 1);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);

  AddCmd("beende|beend&ode an die sterne", "cmd_beende");
}

int cmd_beende(string str) {
  write(BS("Du laesst die Ode an die Sterne verstummen."));
  say(BS(TPN+" laesst die Ode an die Sterne verstummen."));
  remove(1);
  return 1;
}

void SetVars(object caster, int suc)
{
  int abil, duration, lightLevel;
  abil = caster->QuerySkillAbility("ode an die sterne");
  owner = caster;

  duration = abil/100+(suc/100*2);
  lightLevel = 1;

  if(TALENTMASTER->HasTalent(caster, TALENT_LANDSTREICHER)) {
    duration = (int) (duration * (1.2 + caster->QueryProp(P_BARD_INSPIRATION_LEVEL) * 0.05));
    lightLevel += caster->QueryProp(P_BARD_INSPIRATION_LEVEL);
  }

  if(lightLevel < 0) {
    lightLevel = 1;
  }
  
  if(caster->QueryProp(P_RACE) == "Dunkelelf") {
    SetProp(P_LIGHT, -1 * lightLevel);
  } else {
    SetProp(P_LIGHT, lightLevel);
  }

  call_out("ende", duration);
}


void ende()
{
  tell_object(owner, "Die Wirkung Deiner 'Ode an die Sterne' schwindet!\n");
  remove(1);
}

void BecomesNetDead(object spieler)
{
  if(spieler == owner) remove(1);
  return;
}

public string extra_look() {
  if(QueryProp(P_LIGHT) > 0) {
    return owner->Name(WER, 1) + " wird von leuchtenden Sternen umschwaermt.\n";
  } else {
    return owner->Name(WER, 1) + " wird von dunklen Fetzen aus Nachthimmel umgeben.\n";
  }
}
