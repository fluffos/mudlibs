
inherit "std/thing";

#include <properties.h>
#include <language.h>

inherit "std/thing";

#include <properties.h>
#include <language.h>

#define DEFAULT_VALUE 150

int used;

public void create() {
  if (!is_clone(this_object())) return; 
  
  ::create();
  used = 0;
  
  AddId(({"gabel", "stimmgabel", "\nbard_stimmgabel"}));
  SetProp(P_SHORT, "Eine Stimmgabel");
  SetProp(P_LONG, "Diese Stimmgabel, oder auch Diapason, ist eine Metallgabel, deren Zinken beim Anschlagen einen "
                  "klaren, obertonarmen Ton erzeugen. Barden benoetigen sie um ihre Instrumente zu stimmen und "
                  "besondere Toene anzuschlagen. Sie ist in @@damageState@@ Zustand.");
  SetProp(P_NAME, "Stimmgabel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, DEFAULT_VALUE);
}

public string damageState() {
    int percent;
    percent = (int) (100.0*QueryProp(P_VALUE) / DEFAULT_VALUE);
    switch(percent) {
        case 0 .. 25:
            return "mieserablem";
            break;
        case 26 .. 50:
            return "schlechtem";
            break;
        case 51 .. 75:
            return "beschaedigtem";
            break;
        default:
            return "gutem";
            break;
    }
    return "fragwuerdigem";
}

public void use(object user, int intensity) {
    used += intensity;
    if(!random(100-used)) {
        SetProp(P_VALUE, QueryProp(P_VALUE) - random(10));
    }

    if(QueryProp(P_VALUE) <= 0) {
        call_out("broken", 0, user);
    }
    return;
}

public void broken(object user) {
    object env;
    env = environment(user);

    if(objectp(user)) {
        tell_object(user, break_string("Die Stimmgabel zerbricht! Enttaeuscht wirfst du sie weg.", 78));
    }
    if(objectp(env)) {
        tell_room(env, break_string(sprintf("%s wirft eine kaputte Stimmgabel weg.", user->Name(WER, 1)), 78), ({user}));
    }

    remove(1);
    return;
}
