inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId (({SONG_SMALL_AURA+"_fail", SONG_SMALL_AURA}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, "Aura");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_MAGIC, 1);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
}

private int getCharges() {
  return 0;
}


void start()
{
  if(living(ENV(TO)))
  {
    remove(1);
    return;
  }
  call_out("remove", 60, 1);
}

void init()
{
  if(!is_clone(TO)) return;
  ::init();

  if(!living(TP)) return;
  
  TP->AddSp(-10);
  tell_object(TP, BS("Du wirst magisch geschwaecht!"));
  return;
}
