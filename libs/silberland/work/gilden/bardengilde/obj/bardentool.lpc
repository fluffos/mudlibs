inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>

create() 
{
  ::create();
  SetProp(P_NAME, "Bardentool");
  SetProp(P_SHORT, "Ein Bardentool.");
  SetProp(P_LONG, "Dies ist das Bardentool. "
	  "Mit ihm kann man alles Moegliche ueber "
	  "die Bardengilde abfragen/einstellen. "
	  "Folgende Kommandos gibt es:\n"
	  "<bardengilde hilfe>\n"
	  "<bardengilde settask>\n" 
	  "<bardengilde deltask>\n" 
	  "<bardengilde members>\n" 
	  "<bardengilde viewtask>\n"
	  "<bardengilde viewspells>\n"
	  "<bardengilde viewabils>\n" 
	  "<bardengilde viewall>\n");
  SetProp(P_VALUE, 0); 
  SetProp(P_WEIGHT, 0);               
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_IDS, ({"tool","bardentool"}));
  SetProp(P_AUTOLOADOBJ, 1);
  AddCmd("bardengilde"), "bardengilde");
  
  AddCmd(("settask"), "settask");
  AddCmd(("deltask"), "deltask");
  AddCmd(("viewtask"), "viewtask");
  AddCmd(("viewspells"), "viewspells");
  AddCmd(("viewabils"), "viewabils");
  AddCmd(("viewall"), "viewall");
}


string maghelp()
{
  if(!IS_WIZARD(TP)) return ""; 
  return "\nMagInfo: Hilfe fuer Magierbefehle mit 'gilde hilfe'.";
}

/* Funktionen fuer Magier */
int magfunc(mixed str)
{
  mixed *txt;
  object ob;
  int err, task;
  string name;
  if(!IS_WIZARD(TP)) return 0;
  if(!str) str="hilfe";
  if(str=="hilfe") {
    write("Folgende Kommandos gibt es:\n"
	  "'bardengilde hilfe' : Zeigt diesen Text an\n"
	  "'bardengilde settask <name> <task>': Setzt einen Task\n" 
	  "'bardengilde deltask <name> <task>': Loescht einen Task.\n" 
	  "'bardengilde viewtask <name>': Taskanzeige eines Spielers.\n"
	  "'bardengilde viewspells <name>': Spellanzeige eines Spielers.\n"
	  "'bardengilde viewabils <name>': Skillanzeige eines Spielers.\n" 
	  "'bardengilde viewall <name>': Zeigt alle Infos eines Spielers an.\n"
	  "'bardengilde members': Zeigt alle Mitglieder der Bardengilde an.\n");
    return 1;
  }
  
  //AENDERUNGEN IN DAS LOGFILE SPIELEN
  
  txt=explode(str, " ");
  if(member(({"settask", "deltask", "viewtask", "viewspells", "viewabils", "viewall"}), txt[0])!=-1) {
    if!((TP->query_real_name() == "andyl") || IS_ARCH(TP))  
      {
	write("Befehl nicht ausfuehrbar. Grund: Nicht Gildenverantwortlicher und Magierlevel < 60\n");
	return 1;
      }
  }
  
  // SETZEN EINES TASKES FUER EINEN SPIELER
  
  if(txt[0]=="settask") {
    if(sizeof(txt)<3) {
      tell_object(TP, "Syntax: bardengilde settask <name> <Task>\n");
      return 1;
    }
    task=to_int(txt[2]);
    name=lower_case(to_string(txt[1]));
    if(!(ob=find_player(name)) && !(ob=find_netdead(name))) {
      tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
      return 1;
    }
    err=call_other(BARDENMASTER, "SetTask", ob, task);
    if(err!=1) {
      tell_object(TP, sprintf("Fehler. Code %d\n", err));
      return 1;
    }
    tell_object(TP, "Task gesetzt.\n");
    return 1;
  }  
  
  
  //LOESCHEN EINES TASKS FUER EINEN SPIELER
  
  if(txt[0]=="deltask") {
    if(sizeof(txt)<3) {
      tell_object(TP, "Syntax: bardengilde deltask <name> <Task>\n");
      return 1;
    }
    task=to_int(txt[2]);
    name=lower_case(to_string(txt[1]));
    if(!(ob=find_player(name)) && !(ob=find_netdead(name))) {
      tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
      return 1;
    }
    err=call_other(BARDENMASTER, "DeleteTask", ob, task);
    if(err!=1) {
      tell_object(TP, sprintf("Fehler. Code %d\n", err));
      return 1;
    }
    tell_object(TP, "Task geloescht.\n");
    return 1;
  }
  tell_object(TP, "Befehl nicht moeglich!\n");
  return 1;
  
  // ABFRAGEN DER TASKS FUER EINEN SPIELER
  /* 
     if(txt[0]=="viewtask") {
     if(sizeof(txt)<2) {
     tell_object(TP, "Syntax: bardengilde viewtask <name> <Task>\n");
     return 1;
     }
     task=to_int(txt[2]);
     name=lower_case(to_string(txt[1]));
     if(!(ob=find_player(name)) && !(ob=find_netdead(name))) {
     tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
     return 1;
     }
     err=call_other(BARDENMASTER, "DeleteTask", ob, task);
     if(err!=1) {
     tell_object(TP, sprintf("Fehler. Code %d\n", err));
     return 1;
     }
     tell_object(TP, "Task geloescht.\n");
     return 1;
     }
     tell_object(TP, "Befehl nicht moeglich!\n");
     return 1;
  */
  

  // ABFRAGEN ALLER MITGLIEDER DER BARDENGILDE

  
  if(txt[0]=="members") 
    {
      if(sizeof(txt)<1) 
	{
	  tell_object(TP, "Syntax: bardengilde members\n");
	  return 1;
	}
      
      call_other(BARDENMASTER, "QueryMembers");
      return 1;
    }
  
 





  


}




