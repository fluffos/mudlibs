void charge_sarrian()
{
  string *dtypes;
  tell_object(owner, BS("Blitze zucken um Dich! Die Geister von Blitz und Donner scheinen beeindruckt von dir. "
                        "Du kannst nun die Kraft des Gewitters entfesseln! (syntax: blitz)"));
  tell_room(ENV(owner), BS(sprintf("Mehrere Blitze zucken von %s Instrument aus in den Boden. Dir stehen die Haare zu Berge.",
    owner->name(WESSEN, 1))), ({owner}));
  

  dtypes = ({DT_LIGHTNING});
  if(TALENTMASTER->HasTalent(owner, TALENT_ALTE_GESCHICHTEN)) {
    dtypes += ({ DT_LIGHT });
  }
    
  dam_array = ({ dtypes,
                BS("Ein Blitz zuckt von Dir weg!"),
                BS("Ein Blitz trifft Dich!"),
                BS("Ein Blitz trifft %s!")});

  AddCmd( ({"blitze", "blitz"}), "damage");

  room_msg = ({
    ({"Alle deine Haare stehen dir zu Berge", owner->Name(WESSEN, 1)+" Haare stehen zu Berge."}),
    ({"Ein leises Summen geht von dir aus.", "Ein leises Summen geht von " + owner->name(WEM, 1) + " aus."}),
    ({"Ein paar kleine Blitze zucken von dir aus zu Boden.", "Ein paar kleine Blitzen zucken von " + owner->name(WEM, 1) + " aus zu Boden."}),
    ({"Du hoerst leises Donnergrollen.", "Du hoerst leises Donnergrollen."}),
    ({"Deine Augen leuchten kurz blaeulich auf.", "In " + owner->name(WESSEN, 1) + " Augen zucken kleine Blitze."}),
    ({"Blitze zucken um dich herum.", "Ein paar Blitze zucken von " + owner->name(WEM, 1) + " aus um dich herum."})
  });

  dischargeMessage = "Blitze zucken aus deinen Fuessen in den Boden hinab. Dein Gewitter wird schwaecher.";

  return;
}

public int getCharges() {
  return charges; 
}

varargs private void discharge(int silent) {
  string msg;
  msg = BS(dischargeMessage);
  if(!silent && objectp(owner) && !objectp(find_netdead(owner)) && stringp(msg)) {
    tell_object(owner, msg);
  }

  if(--charges <= 0) {
    if(objectp(owner)) {
      msg = BS("Deine Aura loest sich auf!");
      if(stringp(msg)) tell_object(owner, msg);
    }
    remove(1);
  }
  return;
}

int damage(string str)
{
  object *targets, t, *enemies;
  int n, m, damage, dmgOffset;
  mapping sinfo;
  if(owner->QueryProp(P_TESTPLAYER)) {
    tell_object(owner, sprintf("eval_cost = %d\n", get_eval_cost()));
  }

  notify_fail("Das geht nur im Kampf!\n");
  if(!owner->InFight()) return 0;

  // Check ob Nutzungspause um ist
  notify_fail("Deine Aura muss sich erst wieder aufladen!\n");
  if(next_spell>time()) return 0;

  // Schaden berechnen
  damage = (int) (150 * (1 + factor));
  dmgOffset = damage/3;

  sinfo =  ([SI_SKILLDAMAGE: damage,  
             OFFSET(SI_SKILLDAMAGE): dmgOffset, 
             SI_SKILLDAMAGE_TYPE: dam_array[0],
            SI_RAW_SPELLCOST: COST,
            SI_SKILLRESTR_USE:([P_GUILD_LEVEL:3])]);

    // MP kosten
    if(owner->QueryProp(P_TMP_BARDS_ZAUBERMELODIE)) {
      sinfo[SI_RAW_SPELLCOST] *= 2;
    }
  
    if(owner->QueryProp(P_SP) < sinfo[SI_RAW_SPELLCOST]) {
      tell_object(owner, BS("Du hast nicht genuegend magische Macht um die Aura zu entfachen."));
      return -1;
    }
    owner->AddSp(-1 * sinfo[SI_RAW_SPELLCOST]);

  // Ziel suchen
  targets = ({ });
  enemies = owner->PresentEnemies();
  m = 1;
  if(TALENTMASTER->HasTalent(owner, TALENT_FORTE_FORTISSIMO)) {
    m += owner->QueryProp(P_BARD_INSPIRATION_LEVEL);
  }
  m = modifyBySkillAttribute(m, SA_EXTENSION);
  if(m>sizeof(enemies)) m = sizeof(enemies);

  for(n=0; n<m; n++) {
    if(member(targets, enemies[n]) < 0) {
      targets += ({ enemies[n] });
    }
  }

  // Meldungen ausgeben
  tell_object(owner, dam_array[1]);

  for(n=0; n<sizeof(targets); ++n) {
    if(objectp(present(SONG_FEAR_BUILDUP, targets[n])) && targets[n]->QueryProp(P_DISABLE_ATTACK) > 0) {
      tell_object(owner, BS(sprintf("Dein Angriff erwischt %s im Zustand geistiger Verwirrung!", targets[n]->name(WEN, 1))));
      sinfo[SI_SKILLDAMAGE] += sinfo[OFFSET(SI_SKILLDAMAGE)];
    }

    tell_object(targets[n], dam_array[2]);
    tell_room(ENV(owner), sprintf(dam_array[3], targets[n]->Name(WER, 1)), ({owner, targets[n]}));
    "/spellbooks/barden_spells"->TryDefaultAttackSpell(targets[n], owner, sinfo, ([SP_NAME:"barden_kampfspell_klein", SP_SHOW_DAMAGE:1]));
    owner->AddSp((int) ((-1 * sinfo[SI_RAW_SPELLCOST])/2));
  }

  // Nur alle 5 Sekunden moeglich
  next_spell = time()+5;

  // Ladung abziehen
  discharge(1);

  return 1;
}

public int CanRecharge() {
  return charges <= (int) (initialCharges/4);
}

public void reset() {
  ::reset();
  if(!objectp(owner) || objectp(find_netdead(getuid(owner)))) {
    remove(1);
  }

  discharge();
}

public int element_arrow(string str) {
  string pfeil, dtype;

  pfeil = capitalize(query_verb());
  write("pfeil fuer: " + query_verb()+"\n");

  switch(query_verb()) {
    case "feuerpfeil": dtype = DT_FIRE; break;
    case "wasserpfeil": dtype = DT_WATER; break;
    case "luftpfeil": dtype = DT_AIR; break;
    case "erzpfeil": dtype = DT_BLUDGEON; break;
    case "eispfeil": dtype = DT_COLD; break;
    case "humuspfeil": dtype = DT_POISON; break;
    default: dtype = DT_MAGIC; break;
  }
  
  dam_array = ({ ({dtype}), 
                BS("Du wirfst einen "+pfeil+"."), 
                BS(owner->Name(WER)+" wirft einen "+pfeil+" nach dir!"),
                BS(owner->Name(WER)+" wirft einen "+pfeil+" nach %s!")});

  return damage(str);
}
