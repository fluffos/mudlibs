inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <new_skills.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

#define COST 1

string group, *dam_array, dischargeMessage;
mixed room_msg;
int charges, initialCharges, next_spell, time;
object caster, owner;
float factor;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Eine Aura.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Aura");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INVIS, 1);
  AddId(SONG_SMALL_AURA);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  dischargeMessage = "";

  AddCmd("beende|beend&aura|lied vom sturmvogel|flamme bin ich|des todes drei trommelschlaege|zafiras elementare elegie", "cmd_ende");
}

public int cmd_ende(string str) {
  write(BS("Mit einem lauten Knall entlaedst du die Energie deiner Aura. Es schmerzt!"));
  say(BS("Mit einem Knall bricht sich magische Energie um "+TPN+" herum Bahn."));
  TP->AddHp(-charges*3);
  remove(1);
  return 1;
}

private int modifyBySkillAttribute(int baseVal, string skillAttribute) {
  return (int) (baseVal * (owner->QuerySkillAttribute(skillAttribute) / 100.0));
}

void load(object _target, string g, int c, float f)
{
  if(c>20) c = 20;
  group   = g;
  factor  = f;
  owner = _target;
  next_spell = time();

  charges = modifyBySkillAttribute(c, SA_DURATION);
  if(charges < 1) {
    charges = 1;
  }

  initialCharges = charges;

  call_out("charge_"+g, 0);
  call_out("display_room_message", 130+random(30));
  return;
}

public void display_room_message() {
  object room;
  string *msg;

  if(!objectp(owner)) {
    remove(1);
    return;
  }

  room = environment(owner);
  if(!objectp(room)) {
    remove(1);
    return;
  }

  if(objectp(find_netdead(getuid(owner)))) {
    return;
  }

  if(room_msg == 0) {
    return;
  }

  msg = room_msg[random(sizeof(room_msg))];

  tell_object(owner, BS(msg[0]));
  tell_room(room, BS(msg[1]), ({owner}));

  call_out("display_room_message", 30+random(30));
}

public void BecomesNetAlive(object player) {
  if(player == owner) {
    call_out("display_room_message", 5+random(30));
  }
  return;
}

public void BecomesNetDead(object player) {
  while(remove_call_out("display_room_message") != -1);
  return;
}

void charge_zafira()
{
  string *dtypes;
  tell_object(owner, BS("Ein Wirbel an roher elementarer Kraft umfaengt dich. Kurz stoben Flammen auf, Regen geht nieder und "
                        "gefriert sofort. Fuer einen Moment spriessen Blumen um dich herum, nur um von einer Windboehe "
                        "fortgerissen zu werden. Zu letzt erbebt die Erde kurz unter deinen Fuessen."));
  tell_object(owner, BS("Du kannst nun die elementaren Kraefte als Elementarpfeile entfesseln! (<feuerpfeil>, <wasserpfeil>, <erzpfeil>, "
                        "<luftpfeil>, <eispfeil>, <humuspfeil>, <magiepfeil>)"));
  tell_room(ENV(owner), BS(sprintf("Ein Wirbel an roher elementarer Kraft umfaengt %s. Kurz stoben Flammen auf, Regen geht nieder und "
                        "gefriert sofort. Fuer einen Moment spriessen Blumen um dich herum, nur um von einer Windboehe "
                        "fortgerissen zu werden. Zu letzt erbebt die Erde kurz unter deinen Fuessen.",
    owner->name(WEN, 1))), ({owner}));
 
  room_msg = ({
    ({"Der Boden unter deinen Fuessen zittert leicht.", "Der Boden unter deinen Fuessen zittert leicht."}),
    ({"Ein wenig Regen geht um dich nieder.", "Ein wenig Regen geht um dich nieder."}),
    ({"Dein Atem bildet Dampfwolken.", owner->Name(WESSEN, 1) + " Atem bildet Dampfowlken. Dir ist kalt."}),
    ({"Um dich herum spriessen Blumen.", "Um " + owner->name(WEN, 1) + " spriessen Blumen."}),
    ({"Kleine Feuerwusel tanzen um dich herum.", "Kleine Feuerwusel tanzen um "+owner->Name(WEN, 1)+" herum."}),
    ({"Luftwirbel bilden sich um dich und lassen dein Haar wehen.", "Luftwirbel lassen " + owner->name(WESSEN, 1) + " Haar wehen."})
  });

  dischargeMessage = "Die Kraft der Element um dich wird schwaecher.";

  AddCmd( ({"eispfeil", "humuspfeil", "erzpfeil", "luftpfeil", "feuerpfeil", "wasserpfeil", "magiepfeil"}), "element_arrow");
  return;
} 
void charge_alestra()
{
  string *dtypes;
  tell_object(owner, BS("Du wirst kurz in Flammen gehuellt! Die Geister von Feuer und Hitze waren von deinem Lied beeindruckt. "
                        "Du kannst nun die Kraft der Flammen entfesseln! (syntax: brenne)"));
  tell_room(ENV(owner), BS(sprintf("Ein Ring aus Flammen lodert rund um %s auf. Bei dieser Hitze kommst du ins schwitzen.",
    owner->name(WEN, 1))), ({owner}));

  dtypes = ({DT_FIRE});
  if(TALENTMASTER->HasTalent(owner, TALENT_ALTE_GESCHICHTEN)) {
    dtypes += ({ DT_EXPLOSION });
  }

  dam_array = ({ dtypes,
                BS("Du flammst kurz auf!"),
                BS("Eine Flamme rast von "+owner->Name(WEM)+" auf Dich zu!"),
                BS("Eine Flamme rast von "+owner->Name(WEM)+" auf %s zu!")});

  room_msg = ({
    ({"Kleine Flammen tanzen auf deiner Kleidung.", "Kleine Flammen tanzen auf " + owner->name(WESSEN, 1) + " Kleidung."}),
    ({"Um dich Herum bildet sich ein kleiner Flammenkreis.", "Um " + owner->name(WEN, 1)+ " herum bildet sich ein kleiner Flammenkreis."}),
    ({"Du atmest ein kleines Rauchwoelkchen aus.", owner->Name(WER, 1) + " atmet eine kleine Rauchwolke aus."}),
    ({"Eine Woge der Hitze geht von dir aus.", "Eine Woge der Hitze geht von " + owner->name(WEM, 1) + " aus."}),
    ({"Es riecht nach verbranntem Holz.", "Es riecht nach verbranntem Holz."}),
    ({"Ein paar Ascheflocken bilden sich um dich herum.", "Ascheflocken wehen um " + owner->name(WEN, 1) + "."})
  });

  dischargeMessage = "Funken spruehen um dich herum. Deine innere Flamme wird kleiner.";

  AddCmd( ({"brenne", "brenn"}), "damage");
  return;
}

void charge_tirena()
{
  string *dtypes;
  tell_object(owner, BS("Einen kurzen Moment weht ein Sturm um Dich. Es scheint, die Sylphen waren von deinem Spiel beeindruckt. "
                        "Du kannst nun die Kraft des Sturms entfesseln! (syntax: wehe)"));
  tell_room(ENV(owner), BS(sprintf("Eine heftige Sturmboe geht von %s aus. Dreck und Staub wird herumgeschleudert.",
    owner->name(WEM, 1))), ({owner}));
  
  dtypes = ({DT_AIR});
  if(TALENTMASTER->HasTalent(owner, TALENT_ALTE_GESCHICHTEN)) {
    dtypes += ({ DT_COLD });
  }
  
  dam_array = ({ dtypes,
                BS("Eine Windmauer geht von Dir aus!"),
                BS("Ein Windstoss rast von "+owner->Name(WEM)+" auf Dich zu!"),
                BS("Ein Windstoss rast von "+owner->Name(WEM)+" auf %s zu!")});

  room_msg = ({
    ({"Deine Haare wehen leicht im Wind.", owner->Name(WESSEN, 1)+" Haare wehen leicht im Wind."}),
    ({"Ein sanfter Windhauch umweht dich.", "Ein sanfter Windhauch umweht dich."}),
    ({"Eine kurze Boehe geht von dir aus.", "Eine kurze Windboehe geht von " + owner->name(WEM, 1)+ " aus."}),
    ({"Eine Wolke Staub und Dreck wirbelt um dich.", "Eine Wolke aus Staub und Dreck wirbelt um " + owner->name(WEN, 1)+"."}),
    ({"Du hoerst das leise Fluestern der Sylphen.", "Ein leises Murmeln erhebt sich um " + owner->name(WEN, 1)+"."}),
    ({"Eine unsichtbare Gestalt spielt kichernd mit deinem Haar.", "Du hoerst ein leises Kichern von " + owner->name(WEM, 1)+"."})
  });

  dischargeMessage = "Der Wind um dich wird schwaecher. Ein Wenig von der Kraft der Sylphen verlaesst dich.";
         
