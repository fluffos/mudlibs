                        "Du kannst nun die Furcht vor dem Tod entfessln! (syntax: aengstige)"));
  tell_room(ENV(owner), BS(sprintf("Eine dunkle Gestalt legt einen aetherischen Mantel um %s. Du fuerchtest Dich!", 
                                   owner->Name(WEN, 1))), ({owner}));
  
  dtypes = ({DT_TERROR});
  if(TALENTMASTER->HasTalent(owner, TALENT_ALTE_GESCHICHTEN)) {
    dtypes += ({ DT_UNHOLY });
  }
  
  dam_array = ({ dtypes,
                BS("Du strahlst Furcht aus!"),
                BS("Du fuerchtest Dich fuerchterlich vor "+owner->Name(WEM)+"!"),
                BS("%s fuerchtet sich vor "+owner->Name(WEM)+"!")});

  room_msg = ({
    ({"Ein kalter Schauer laeuft deinen Ruecken hinab.", owner->Name(WER, 1)+" bekommt Gaensehaut."}),
    ({"Du siehst alle um dich etwas zurueckweichen.", "Du weichst einen Schritt vor " + owner->name(WEM, 1) + " zurueck."}),
    ({"Du hoerst ein unbestimmbares Wispern und Raunen.", "Ein unbestimmbares Wispern und Raunen ist von " + owner->name(WEM, 1) + " zu hoeren."}),
    ({"Eine geisterhafte Erscheinung wandert durch dich hindurch.", "Eine geisterhafte Erscheinung wandert durch " + owner->name(WEN, 1) + "."}),
    ({"Ein umheimliches Gluehen erhellt dich kurz.", owner->Name(WER, 1) + " wird kurz von einem unheimlichen Gluehen erhellt."}),
    ({"Kurz erscheint ein duesterer, durchscheinender Mantel um dich.", owner->Name(WER, 1) + " wird kurz von einem flatternden Geistermantel umgeben."})
  });

  dischargeMessage = "Du merkst die Todesangst von dir weichen. Der Mantel des Todes wird leichter um deine Schultern.";

  AddCmd( ({"aengstige", "aengstig"}), "damage");
  return;
