inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <new_skills.h>
#include <moredef.h>
#include <moving.h>
#include "/gilden/bardengilde/bardengilde.h"

string group, caster_name;
object owner, caster;
int reduction, time, chance, canRecharge;
float factor;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Ein Bannzauber.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ein Magiebann");
  SetProp(P_GENDER, MALE);
  SetProp(P_INVIS, 1);
  AddId(SONG_MAGIC_WARD);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}

private int modifyBySkillAttribute(int baseVal, string skillAttribute) {
  return (int) (baseVal * (caster->QuerySkillAttribute(skillAttribute) / 100.0));
}

public void Setup(object _caster, object _owner, string _bardGroup, int _ability, int _success, float _factor) {
  group   = _bardGroup;
  factor  = _factor;
  owner   = _owner;
  caster  = _caster;
  caster_name = caster->Name(WER);

  reduction = _ability/100 + _success/200;
  reduction = modifyBySkillAttribute(reduction, SA_DAMAGE);
  reduction = (int) (reduction * (1.0+factor));
  if(TALENTMASTER->HasTalent(caster, TALENT_BANNSAENGER)) {
    reduction = (int) (reduction * (1.0 + 0.1 * (caster->QueryProp(P_BARD_INSPIRATION_LEVEL))));
  }
  reduction = reduction > 400 ? (300+random(201)) : reduction; // maximal 500 damage (50 LP) werden abgefangen
  
  time = caster->QueryProp(P_GUILD_LEVEL)*5 + _ability/50 + _success/100;
  time = (int) (time * (1.0 + factor));
  time = modifyBySkillAttribute(time, SA_DURATION);
  time = time > 1400 ? (1300+random(201)) : time; // maximal 1500 Sekunden (25 Minuten), unten kommen nochmal 500s (8min) dazu
  
  chance = (int) (_ability/200)+(_success/250);
  chance = chance > 80 ? (70+random(21)) : chance; // maximal 90% der Spells werden abgewehrt/abgeschwaecht

  canRecharge = 0;

  owner->SetProp(P_TMP_DEFEND_HOOK, ({time()+500, TO, "SpellWard"}));

  if(owner->QueryProp(P_TESTPLAYER)) {
    tell_object(owner, sprintf("time=%d reduction=%d chance=%d\n", time, reduction, chance));
  }

  if(BARDENMASTER->HasHeroPathLevel(caster, HERO_ANGARA, 2)) {
    tell_object(owner, BS("Auf Hoehe deines Herzens bildet sich fuer einen Moment ein funkelnder Stein aus "
                          "Regenbogenlicht, dessen Strahlen sich dann ueber deinen ganzen Koerper verteilt."));
    tell_room(environment(owner), BS(sprintf("Auf Hoehe %s Herzen bildet sich fuer einen Moment ein funkelnder "
              "Edelstein aus Regenbogenlicht, dessen Strahlen sich dann ueber %s Koeper verteilt.", 
              owner->name(WESSEN, 1), owner->QueryPossPronoun())), ({owner}));
  } else {
    tell_object(owner, BS("Ein regenbogenfarbenes Netz schimmert kurz um dich.\n"));
    tell_room(environment(owner), BS(sprintf("Ein regenbogenfarbenes Netz schimmert kurz um %s auf.\n", owner->name(WEN, 1))), ({owner}));
  }

  call_out("warn_remove", (int) (time*0.5));

  // Logging
  bard_log_file("magic_ward.log", sprintf(
    "%20s %7s->%7s reduction=%5d _abil=%5d _suc=%5d glvl=%2d time=%3d factor=%3O INSP_LVL=%2d T_BANNSAENGER=%d\n", 
    ctime()[<20..],
    CAP(getuid(caster)),
    CAP(getuid(owner)),
    reduction,
    _ability,
    _success,
    caster->QueryProp(P_GUILD_LEVEL),
    time,
    factor, 
    to_int(caster->QueryProp(P_BARD_INSPIRATION_LEVEL)),
    TALENTMASTER->HasTalent(caster, TALENT_BANNSAENGER) ));
  return;
}

public void warn_remove() {
  if(!objectp(owner)) {
    remove(1);
    return;
  }

  tell_object(owner, BS("Das magische Regenbogennetz um dich wird etwas schwaecher."));

  call_out("recharge_warning", (int) (time*0.25));
}

public void recharge_warning() {
  if(!objectp(owner)) { 
    remove(1);
    return;
  }

  if(BARDENMASTER->HasHeroPathLevel(caster, HERO_ANGARA, 2)) {
    tell_object(owner, BS("Die Wirkung von 'Schuetzendes Herz des Berges' wird bald enden."));
  } else {
    tell_object(owner, BS("Die Wirkung von 'Lorica der Musen' wird bald enden."));
  }
  canRecharge = 1;
  call_out("remove_me", (int) (time*0.25));
}

public void remove_me() {
  if(!objectp(owner)){
    remove(1);
    return;
  }

  tell_object(owner, BS("Das regenbogenfarbene Netz um dich herum verblasst."));
  tell_room(environment(owner), BS(sprintf("Das regenbogenfarbene Netz um %s verblasst.", owner->name(WEN, 1))), ({owner}));
  remove(1);
  return;
}

public varargs int remove(int silent) {
  if(objectp(owner)) owner->SetProp(P_TMP_DEFEND_HOOK, 0);
  return ::remove(silent);
}

public mixed* SpellWard(int dam, string *dam_type, mixed spell) {
  int netDam, roll, success;
  if(spell == 0) return ({dam, dam_type, spell});
  if((roll=random(100)) > chance) return ({dam, dam_type, spell});
  if(!objectp(owner)) {
    remove(1);
    return ({dam, dam_type, spell});
  }

  netDam = dam - reduction - random(reduction/4);
  if(netDam <= 0) {
    tell_object(owner, BS("Regenbogenfarbenes Licht flackert um dich herum auf und absorbiert den Angriff.\n"));
    tell_room(environment(owner), BS(sprintf("Regenbogenfarbenes Licht flackert um %s herum auf und absorbiert den Angriff.\n", 
              owner->name(WEN, 1))), ({owner}));
    netDam = 0;
  } else {
    tell_object(owner, BS("Regenbogenfarbenes Licht flackert um dich herum auf und schwaecht den Angriff ab."));
    tell_room(environment(owner), BS(sprintf("Regenbogenfarbenes Licht flackert um %s herum auf und schwaecht den Angriff ab.\n", 
              owner->name(WEN, 1))), ({owner}));
  }
  TW(sprintf(" * %s magic_ward SpellWard DB: %s absorbiert %d/10 Schaden (netDam=%d, roll=%d, chance=%d, caster=%s).\n", dtime(time()), owner->name(WER), dam-netDam, netDam, roll, chance, caster_name));

  if(roll < (owner->QueryAttribute(A_INT) + owner->QueryAttribute(A_DEX))/2 || BARDENMASTER->HasHeroPathLevel(owner, HERO_ANGARA, 2)) {
    if(!BARDENMASTER->HasHeroPathLevel(owner, HERO_ANGARA, 2) || !random(3)) 
      tell_object(owner, BS("Ein Teil der absorbierten Magie fliesst in dich!"));

    owner->AddSp((dam-netDam)/10);
    TW(sprintf(" * %s magic_ward SpellWard DB (ANGARA): %s heilt %d SP (caster=%s).\n", dtime(time()), owner->name(WER), (dam-netDam)/10, caster_name));

    if(BARDENMASTER->HasHeroPathLevel(owner, HERO_ANGARA, 2)) {
      success = owner->UseSkill(SK_HEROISM(HERO_ANGARA));
      if(success > 0) {
        owner->AddSp(success/1000);
        owner->AddHp(success/1000);
        TW(sprintf(" * %s magic_ward SpellWard DB (ANGARA): %s heilt %d SP und %d LP (HEROISM) (caster=%s).\n", dtime(time()), owner->name(WER), success/1000, success/1000, caster_name));
      }
    }

    if(objectp(caster) && TALENTMASTER->HasTalent(caster, TALENT_HEILER)) {
      owner->AddSp(caster->QueryProp(P_BARD_INSPIRATION_LEVEL));
      if(BARDENMASTER->HasHeroPathLevel(owner, HERO_ANGARA, 2)) {
        owner->AddHp(caster->QueryProp(P_BARD_INSPIRATION_LEVEL));
        TW(sprintf(" * %s magic_ward SpellWard DB (ANGARA): %s heilt %d SP und %d LP (TALENT_HEILER, caster=%s).\n", dtime(time()), owner->name(WER), caster->QueryProp(P_BARD_INSPIRATION_LEVEL), caster->QueryProp(P_BARD_INSPIRATION_LEVEL), caster_name));
      }
    }
  }
  
  return ({netDam, dam_type, spell});
}

public int CanRecharge() {
  return canRecharge;
}

public void reset() {
  ::reset();
  if(!objectp(owner) || objectp(find_netdead(getuid(owner)))) {
    remove(1);
  }
}

