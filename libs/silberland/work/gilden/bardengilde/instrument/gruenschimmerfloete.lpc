inherit "/gilden/bardengilde/instrument/base_glass";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Gruenschimmerfloete");
  SetProp(P_LONG, 
	  BS("Die Gruenschimmerfloete ist ein lange Querfloete "
	     +"aus gruen schimmerndem Glas. Sie hat ein Mundstueck "
	     +"und neun Loecher davon eines an der Unterseite und "
	     +"die restlichen acht an der Oberseite. Wenn man sie "
	     +"spielt erklingen sanfte, angenehme Klaenge.\n")); 
  SetProp(P_NAME, "Gruenschimmerfloete");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"gruenschimmerfloete", "schimmerfloete", "floete", "querfloete"}) );
  SetProp(P_INSTRUMENT_LEVEL, 3);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
}














