inherit "/gilden/bardengilde/instrument/base_glass";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Froggolum");
  SetProp(P_LONG, 
	  BS("Das Froggulum ist ein besonders interessantes Glasinstrument. Es ist "
       "durch und durch gruen mit sieben Zipfeln, vier Pfeifen und achtunzwanzig "
       "Griffloechern. Eigentlich wurde es speziell fuer Froschhaende gefertigt, "
       "doch sollte es einem geuebten Barden moeglich sein aus diesem Glasinstrument "
       "formidable Toene zu entlocken.")); 
  SetProp(P_NAME, "Froggolum");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"froggolum", "glasinstrument"}) );
  SetProp(P_INSTRUMENT_LEVEL, 5);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
}














