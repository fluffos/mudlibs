inherit "/p/std/barden/instrument";

#include "../bardengilde.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_INSTRUMENT_TYPE, IT_GLASS);
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_INSTRUMENT_MESSAGES, ({
    ({"Du prustest in @INSTRUMENT3 und ausser Spucke hoerst du nichts.", "@WER prustet in @INSTRUMENT3. Da fliegen die Spucktropfen! Ih!"}), // Fehlschlag
    ({"Du blaest ein paar leise summende Toene auf @INSTRUMENT3.", "@WER blaest ein paar leise summende Toene auf @INSTRUMENT2."}), // 1000
    ({"Leise summend und sirrend spielst du eine einfache Tonfolge auf @INSTRUMENT3.", 
      "Leise summend und sirrend spielt @WER spielt eine Tonfolge auf @INSTRUMENT3."}), // 2000
    ({"Du spielst mit sirrend-singenden Lauten ein einfaches Lied auf @INSTRUMENT3.",
      "@WER spielt mit sirrend-singenden Lauten ein einfaches Lied auf @INSTRUMENT3."}), // 3000
    ({"Du spielst eine rhytmische und harmonische Melodie auf @INSTRUMENT3.",
      "@WER spielt eine rhytmische und harmonische Melodie auf @INSTRUMENT3."}), // 4000
    ({"Du spielst ein elegantes, melodisch summendes Lied auf @INSTRUMENT3, das deine Zuhoerer zum Schunkeln bringt.",
      "@WER spielt ein elegantes, melodisch summendes Lied auf @INSTRUMENT3. Du merkst, dass dich zum Schunkeln bringt."}), // 5000
    ({"Du spielst eine verwobene, ueberirdisch klingende Melodie auf @INSTRUMENT3. Einzelne Lichter scheinen darin aufzuglimmen.",
      "@WER spielt eine verwobene, ueberirdisch klingende Melodie auf @INSTRUMENT3. Einzelne Lichter scheinen darin aufzuglimmen."}), // 6000
    ({"Du laesst summende, zischende und saeuselnde Toene aus @INSTRUMENT3 erklingen. Im Takt des Liedes blitzen bunte Funken im Raum auf.",
      "@WER laesst summende, zischende und saeuselnde Toene aus @INSTRUMENT3 erklingen. Im Takt des Liedes blitzen bunte Funken im Raum auf."}), // 7000
    ({"Fliessende, summende, saeuselnde Harmonien ergiessen sich aus @INSTRUMENT. Regenbogenfarbenes Glitzern und leuchtende Lichtbaellchen begleiten die Musik.",
      "Fliessende, summende, saeuselnde Harmonien ergiessen sich aus @WESSEN @INSTRUMENT. Regenbogenfarbenes Glitzern und leuchtende Lichtbaellchen begleiten die Musik."}), // 8000
    ({"Du stimmst eine geradezu transsphaerische Harmonie mit @INSTRUMENT3 an. @INSTRUMENT erglueht in zur Stimmung passenden Aureolen und Elmsfeuer.",
      "@WER stimmt eine geradezu transsphaerische Harmonie mit @INSTRUMENT3 an. @INSTRUMENT erglueht in zur Stimmung passenden Aureolen und Elmsfeuer."}), // 9000
    ({"Ueberirdisch schoene Klaenge von ungeahnter Komplexitaet erfuellen den Raum, als du @INSTRUMENT anstimmst. Lichter flackern auf, Blitze zucken und es scheint, die Sphaeren selbst wuerden sich im Tanze drehen.",
      "Ueberirdisch schoene Klaenge von ungeahnter Komplexitaet erfuellen den Raum, als @WER @INSTRUMENT anstimmt. Lichter flackern auf, Blitze zucken und es scheint, die Sphaeren selbst wuerden sich im Tanze drehen."}), // 10000+
  }));

  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
  SetProp(P_WORN_TEXT, "in der Hand gehalten");
}














