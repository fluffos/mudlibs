inherit "/gilden/bardengilde/instrument/base_drum";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Rastak");
  SetProp(P_LONG, 
	  BS("Der Rastak ist ein Rythmusinstrument welches "
	     +"man mit einer Hand spielen kann. Es besteht aus "
	     +"einer hoelzernen kugelaehnlichen Umhuellung in "
	     +"der sich zwei kugelfoermige Steine befinden. "
	     +"Durch schuetteln des Rastak wird ein dumpfes, "
	     +"durchdringendes Geraeusch erzeugt. Man findet "
	     +"es haeufig bei Doerfern und Staedten in "
	     +"Meeresnaehe.\n")); 
  SetProp(P_NAME, "Rastak");
  SetProp(P_GENDER, MALE);
  AddId("rastak");
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_HANDS, 1);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:70, MAT_STONE:30]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
}














