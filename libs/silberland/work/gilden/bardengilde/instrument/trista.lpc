inherit "/gilden/bardengilde/instrument/base_floete";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Trista");
  SetProp(P_LONG, 
	  BS("Die Trista ist ein Holzblasinstrument welches "
	     +"stark einem Pfeifchen aehnelt. Es ist komplett "
	     +"aus Holz, sieht aus wie ein kleines Staebchen und "
	     +"hat oben drei und unten ein Loch. Vorne hat es noch "
	     +"ein Mundstueck, welches fuer die Tonerzeugung "
	     +"gebraucht wird.\n"));
  SetProp(P_NAME, "Trista");
  SetProp(P_GENDER, FEMALE);
  AddId("trista");
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_HANDS, 1);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
}














