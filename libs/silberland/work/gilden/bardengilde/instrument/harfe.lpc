inherit "/gilden/bardengilde/instrument/base_string";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Harfe");
  SetProp(P_LONG, 
	  BS("Die Harfe ist ein sehr altes Saiteninstrument, "
	     +"dass einen wunderschoen verzierten und gewoelbt "
	     +"geformten Holzrahmen besitzt zwischen dem 60 "
	     +"Saiten gespannt sind. Diese Saiten werden "
	     +"dann mit beiden Haenden gezupft. Sie ist "
	     +"allerdings nicht ganz leicht zu spielen.\n")); 
  SetProp(P_NAME, "Harfe");
  SetProp(P_GENDER, FEMALE);
  AddId("harfe");
  SetProp(P_INSTRUMENT_LEVEL, 3);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:40, MAT_BRONCE:60]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
}














