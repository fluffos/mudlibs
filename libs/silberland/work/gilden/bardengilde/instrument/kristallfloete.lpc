inherit "/gilden/bardengilde/instrument/base_floete";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Kristallfloete");
  SetProp(P_LONG, 
	  BS("Die Kristallfloete ist eine Floete die aus dem "
	     +"kristallinem Holz der Baeume aus dem Kristallwald "
	     +"gemacht wird. Sie hat sechs Loecher, eins an der Unterseite "
	     +"die restlichen fuenf an der Oberseite. Sie hat auch einen "
	     +"sehr schoenen, aber doch auch sehr eigenartigen Klang.\n")); 
  SetProp(P_NAME, "Kristallfloete");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kristallfloete", "floete"}));
  SetProp(P_INSTRUMENT_LEVEL, 2);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
}














