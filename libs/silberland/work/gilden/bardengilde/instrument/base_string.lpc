inherit "/p/std/barden/instrument";

#include "../bardengilde.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_INSTRUMENT_TYPE, IT_STRING);
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_INSTRUMENT_MESSAGES, ({
    ({"Du zupfst ein paar wirklich falsche Saiten. Autsch...", "@WER zupft ein paar falsche Saiten @INSTRUMENT3. Autsch..."}), // Fehlschlag
    ({"Du zupfst ein paar Saiten von @INSTRUMENT3.", "@WER zupft ein paar Saiten @INSTRUMENT2."}), // 1000
    ({"Du spielst ein paar Akkord auf @INSTRUMENT3.", "@WER spielt ein paar Akkorde auf @INSTRUMENT3."}), // 2000
    ({"Du streichst ueber die Saiten von @INSTRUMENT3 und spielst ein einfaches Lied.","@WER spielt ein einfaches Lied auf @INSTRUMENT3."}), // 3000
    ({"Du spielst eine rhytmische und harmonische Melodie auf @INSTRUMENT3.","@WER spielt eine rhytmische und harmonische Melodie auf @INSTRUMENT3."}), // 4000
    ({"Du spielst ein schnelles, melodisches Lied auf @INSTRUMENT3, das deine Zuhoerer zum Mitwippen bringt.",
      "@WER spielt ein schnelles, melodisches Lied auf @INSTRUMENT3. DU merkst, dass dein Fuss im Takt mitwippt."}), // 5000
    ({"Du spielst ein Lied mit vielen wechselnden Akkorden und Griffen, das durchaus anregend wirkt.",
      "@WER spielt ein Lied mit vielen wechselnden Akkorden und Griffen, das durchaus anregend wirkt."}), // 6000
    ({"Du streichst ein Lied mit rascher Folge aus rasant wechselnden Akkorden, wie ein romantischer Tango.",
      "@WER streicht auf @INSTRUMENT3 eine rasche Folge rasant wechselnder Akkorde, die wie ein romantischer Tango klingen. Gerne wuerdest du dazu tanzen!"}), // 7000
    ({"Du spielst ein Lied aus gezupften und gestrichenen Akkorden mit ineinandergreifenden Harmonien. Melancholisch weckt es die Sehnsucht nach der Ferne in deinen Zuhoerern.",
      "@WER entlockt @INSTRUMENT3 ein melancholisches Lied aus gezupften und gestrichenen Akkorden mit eineinandergreifenden Harmonien. Hach, eine Reise waere schoen!"}), // 8000
    ({"Du spielst ein verspieltes und wirbelndes Feenlied auf @INSTRUMENT3. Dein Publikum tanzt im Takt deiner rasanten Akkorde.",
      "@WER spielt ein verspieltes und wirbelndes Feenlied auf @INSTRUMMENT3. Du tanzt im Takt der rasanten Akkorde."}), // 9000
    ({"Du entlockst @INSTRUMENT eine Reihe ineinander verwobener Harmonien und Rhythmen. Ueberirdische Klaenge erfuellen den Raum. Dein Publikum tanzt begeistert mit!",
      "@WER entlockt @INSTRUMENT3 eine Reihe komplex ineinander verwobener Harmonien und Rhythemn. Ueberirdische Klaenge erfuellen den Raum. Begeistert schwingst du das Tanzbein!"}), // 10000+
  }));

  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:80, MAT_BRONCE:20]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
  SetProp(P_WORN_TEXT, "in der Hand gehalten");
}














