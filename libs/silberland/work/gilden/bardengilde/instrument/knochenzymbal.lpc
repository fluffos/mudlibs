inherit "/gilden/bardengilde/instrument/base_drum";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Knochenzymbal");
  SetProp(P_LONG, 
	  BS("Das Zymbal iet ein mit mehreren Klangsaiten bespanntes "
       "Hackbrett. Es wird mit zwei Kloeppeln bespielt. Ein "
       "lederner Gurt erlaubt dir es umzuhaengen. Was dir sofort "
       "auffaellt ist, dass dieses Zymbal offenbar aus Menschen"
       "knochen gefertigt mit Gedaermen bespannt wurde. Die "
       "Kloeppel sind aus Elle und Speiche geschnitzt und mit "
       "den Menschenhaar bespannt."));  
  SetProp(P_NAME, "Knochenzymbal");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"zymbal", "knochenzymbal"}) );
  SetProp(P_INSTRUMENT_LEVEL, 5);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_BONE:55, MAT_SKIN:20, MAT_HAIR:20, MAT_BLOOD:5]));
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
}














