/* Gewitterpauke
** 
** by Andyl@Silberland
**
** 1998-08-01
** Last updated: 1999-05-26
*/

inherit "/gilden/bardengilde/instrument/base_drum";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Gewitterpauke");
  SetProp(P_LONG, 
	  BS("Die Gewitterpauke ist eine gewaltige Pauke die mit Hilfe "
	     +"von zwei Lederbaendern vor dem Bauch befestigt wird "
	     +"und dann mit zwei maechtigen Paukenschlegeln welche an der "
	     +"Vorderseite mit etwas Stoff bedeckt sind geschlagen wird. "
	     +"Der Koerper der Trommel besteht aus Holz ueber dem eine "
	     +"Lederhaut gespannt wurde und direkt unter der Lederhaut "
	     +"ist noch eine Titanplatte befestigt. Wenn man jetzt mit den "
	     +"Schlegeln auf die Lederhaut schlaegt schwingt die Titanplatte "
	     +"darunter mit was einen bedrohlichen, tiefen, lauten Klang "
	     +"erzeugt.\n"));  
  SetProp(P_NAME, "Gewitterpauke");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"gewitterpauke", "pauke"}) );
  SetProp(P_INSTRUMENT_LEVEL, 4);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:55, MAT_LEATHER:20, MAT_TITANIUM:20, MAT_CLOTH:5]));
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}














