inherit "/gilden/bardengilde/instrument/base_string";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Astrone");
  SetProp(P_LONG, 
	  BS("Die Astrone ist ein Saiteninstrument welches "
	     +"man mit einer Hand spielen kann. Es wird um "
	     +"die Hand geschnallt, sodass die vier Saiten "
	     +"welche die Astrone hat, im Handballen zu sehen "
	     +"sind. So kann man die Saiten der Astrone mit "
	     +"seinen Fingern zupfen.\n")); 
  SetProp(P_NAME, "Astrone");
  SetProp(P_GENDER, FEMALE);
  AddId("astrone");
  SetProp(P_MATERIAL, ([MAT_WOOD:80, MAT_BRONCE:20]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
}














