inherit "/p/std/barden/instrument";

#include "../bardengilde.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_INSTRUMENT_TYPE, IT_DRUM);
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_INSTRUMENT_MESSAGES, ({
    ({"Du klopfst vollkommen aus dem Takt auf @INSTRUMENT3.", "@WER klopft vollkommen aus dem Takt auf @INSTRUMENT3."}), // Fehlschlag
    ({"Du spielst einen kleinen Rhythmus auf @INSTRUMENT3.", "@WER trommelt einen kleinen Rhythmus auf @INSTRUMENT3."}), // 1000
    ({"Du trommelst einen schnellen, aber recht montonen Rhythmus auf @INSTRUMENT3.", "@WER trommelt einen schnellen, aber recht monotonen Rhythmus auf @INSTRUMENT3."}), // 2000
    ({"Du spielst einen Rhythmus mit wechselnder Taktfolge auf @INSTRUMENT3.","@WER spielt einen Rhythmus mit wechselnder Taktfolge auf @INSTRUMENT3."}), // 3000
    ({"Du trommelst einen zackigen Marsch auf @INSTRUMENT3.","@WER trommelt einen zackigen Marsch auf @INSTRUMENT3."}), // 4000
    ({"Du trommelst einen rasanten Rhythmus mit leicht wechselnden Tonhoehen @INSTRUMENT3, das deine Zuhoerer zum Mitwippen bringt.",
      "@WER trommelt einen rasanten Rhythmus mit leicht wechselnden Tonhoehen auf @INSTRUMENT3. DU merkst, dass dein Fuss im Takt mitwippt."}), // 5000
    ({"Du laesst den Takt von @INSTRUMENT3 wild wirbeln mit rasch hochschraubenden Takten und dann wieder kurzen Pausen.",
      "@WER laesst den Takt von @INSTRUMENT wild wirbeln, mit rasch hochschraubenden Takten, und dann wieder kurzen Pausen."}), // 6000
    ({"Du trommelst mit lautem Droehnen und kurzen Zwischenrufen einen maechtigen Rhythmus mit @INSTRUMENT3.",
      "@WER trommelt mit lautem Droehnen und kurzen Zwischenrufen einen maechtigen Rhythmus mit @INSTRUMENT3."}), // 7000
    ({"Du trommelst eine Mischung aus raschem Basistakt, zwergischen Zwischenrufen und wummerndem Droehnen auf @INSTRUMENT3. Damit weckst du sicher den Kampfesmut in deinen Zuhoerern!",
      "@WER trommelt eine Mischung aus raschem Basistakt, zwergischen Zwischenrufen und wummerndem Droehnen auf @INSTRUMENT3. Dein Kampfesmut wird gestaerkt!"}), // 8000
    ({"Du trommelst einen hochkomplexen, verwobenen Rhythmus auf @INSTRUMENT3. Leise Schlaege wechseln sich mit lautem Droehnen, rasanten Marschkomponenten und einem Basistakt ab. Perfekt fuer Helden!",
      "@WER trommelst einen hochkomplexen, verwobenen Rhythmus auf @INSTRUMENT3. Leise Schlaege wechseln sich mit lautem Droehnen, rasanten Marschkomponenten und einem Basistakt ab. Du fuehlst dich wie ein wahrer Held!"}), // 9000
    ({"Du entlockst @INSTRUMENT3 verschiedene extrem schwierige Rhythmen. Einige bringen die Erde zum Beben, wahrend andere wie die Vibrationen fremder Dimensionen wirken. Schnell Rhythmen, kurze Pause, tiefes Drohnen und sanfte Schlaege wechseln sich rasant ab. Deine Zuhoerer lassen einen lauten Kampfschrei hoeren!",
      "@WER entlockt @INSTRUMENT3 verschiedene extrem schwierige Rhythmen. Einige bringen die Erde zum Beben, wahrend andere wie die Vibrationen fremder Dimensionen wirken. Schnell Rhythmen, kurze Pause, tiefes Drohnen und sanfte Schlaege wechseln sich rasant ab. Im Takt der Musik bruellst du einen lauten Kampfschrei!"}), // 10000+
  }));

  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:80, MAT_BRONCE:20]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
  SetProp(P_WORN_TEXT, "in der Hand gehalten");
}














