inherit "/gilden/bardengilde/instrument/base_glass";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Glaspfeifchen");
  SetProp(P_LONG, 
	  BS("Das Glaspfeifchen ist ein kleines einfaches "
	     +"Pfeifchen welches aus durchsichtigem Glas besteht. "
	     +"Es hat ein Mundstueck und drei Loecher an der "
	     +"Oberseite. Wenn man darauf pfeift erzeugt es "
	     +"helle, klare Toene.\n")); 
  SetProp(P_NAME, "Glaspfeifchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"pfeifchen", "glaspfeifchen"}) );
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_HANDS, 1);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
}














