inherit "/gilden/bardengilde/instrument/base_glass";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Trabok");
  SetProp(P_LONG, 
	  BS("Das Trabok ist das wohl am schwierigstem "
	     +"zu spielende Glasblasinstrument. Es besteht "
	     +"aus tiefrotem Glas und hat ein Mundstueck von dem "
	     +"zwei glaeserne viereckige Klangkoerper mit jeweils "
	     +"fuenf Loechern, wobei jeweils eines an der Unterseite und "
	     +"vier an der Oberseite sind, wegfuehren, die etwa in einem "
	     +"Winkel von 35 Grad zueinander stehen. Das Trabok ist ein "
	     +"sehr ausdruckstarkes Instrument welches ein grosses "
	     +"Klangspektrum abdeckt.\n"));
  SetProp(P_NAME, "Trabok");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"trabok"}) );
  SetProp(P_INSTRUMENT_LEVEL, 4);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}














