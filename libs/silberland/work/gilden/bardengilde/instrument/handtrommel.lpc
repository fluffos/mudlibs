inherit "/gilden/bardengilde/instrument/base_drum";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Handtrommel");
  SetProp(P_LONG, 
	  BS("Die Handtrommel ist eine kleine Trommel "
	     +"die man sich mit Hilfe eines Lederbandes umhaengt "
	     +"und dann mit den Haenden draufklopft. Der Koerper "
	     +"der Handtrommel besteht aus Holz ueber das ein "
	     +"Leder gespannt wurde. Man hoert einen kraeftigen, "
	     +"dumpfen Ton wenn man draufschlaegt.\n")); 
  SetProp(P_NAME, "Handtrommel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"handtrommel", "trommel"}) );
  SetProp(P_INSTRUMENT_LEVEL, 2);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:70, MAT_LEATHER:30]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
}














