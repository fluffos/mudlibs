inherit "/gilden/bardengilde/instrument/base_glass";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Tarano");
  SetProp(P_LONG, 
	  BS("Die Tarano ist eine mittelgrosse Floete "
	     +"die komplett aus durchsichtigem Glas besteht. Sie hat ein "
	     +"Mundstueck und sieben Loecher an der Oberseite. "
	     +"Wenn man auf ihr spielt erzeugt sie angenehme, klare "
	     +"Toene.\n")); 
  SetProp(P_NAME, "Tarano");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tarano", "floete"}) );
  SetProp(P_INSTRUMENT_LEVEL, 2);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
}














