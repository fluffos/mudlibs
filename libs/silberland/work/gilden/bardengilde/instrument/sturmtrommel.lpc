/* Sturmtrommel
** 
** by Andyl@Silberland
**
** 1998-08-01
** Last updated: 1999-05-26
*/

inherit "/gilden/bardengilde/instrument/base_drum";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Sturmtrommel");
  SetProp(P_LONG, 
	  BS("Die Sturmtrommel ist ein maechtige Trommel die "
	     +"mittels eines Lederbandes vor dem Bauch befestigt wird "
	     +"und dann mit Holzschlegeln die an der Seite der Trommel "
	     +"befestigt sind getrommelt wird. Der Koerper der Trommel besteht "
	     +"aus Holz und ueber dem Koerper ist eine Kupferplatte "
	     +"gespannt. Wenn man mit den Schlegeln auf die Platte "
	     +"trommelt hoert man einen intensiven lauten metallischen "
	     +"Klang.\n")); 
  SetProp(P_NAME, "Sturmtrommel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"sturmtrommel", "trommel"}) );
  SetProp(P_INSTRUMENT_LEVEL, 3);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:70, MAT_LEATHER:10, MAT_COPPER:20]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
}














