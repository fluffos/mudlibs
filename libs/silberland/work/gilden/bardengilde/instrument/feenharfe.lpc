inherit "/gilden/bardengilde/instrument/base_string";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Feenharfe");
  SetProp(P_LONG, 
	  BS("Die Feenharfe ist ein uraltes Saiteninstrument, "
	     +"dass einen wunderschoen verzierten und gewoelbt "
	     +"geformten Holzrahmen besitzt zwischen dem 90 "
	     +"Saiten sowohl senkrecht als auch waagrecht gespannt sind. "
	     +"Diese Saiten werden dann mit beiden Haenden gezupft. Um sie "
	     +"spielen zu koennen muss man allerdings aeusserst "
	     +"geschickt sein.\n")); 
  SetProp(P_NAME, "Feenharfe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"feenharfe", "harfe"}) );
  SetProp(P_INSTRUMENT_LEVEL, 4);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:40, MAT_BRONCE:60]));
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_WORN_TEXT, "getragen");
}














