inherit "/gilden/bardengilde/instrument/base_floete";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Lanara");
  SetProp(P_LONG, 
	  BS("Die Lanara ist ein wunderschoene lange Floete. "
	     +"Ihr Koerper besteht aus Holz und das Mundstueck "
	     +"aus Kristall. Sie hat insgesamt zehn Loecher, davon "
	     +"zwei an der Unterseite und acht an der Oberseite. "
	     +"Sie wurde von den Elfen entwickelt und wird auch "
	     +"hauptsaechlich von diesen gespielt. Sie kann sowohl "
	     +"wunderschoene tiefe als auch wunderschoene hohe Toene "
	     +"hervorbringen. Sie jedoch nicht einfach zu erlernen.\n")); 
  SetProp(P_NAME, "Lanara");
  SetProp(P_GENDER, FEMALE);
  AddId("lanara");
  SetProp(P_INSTRUMENT_LEVEL, 4);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:20, MAT_WOOD:80]));
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}














