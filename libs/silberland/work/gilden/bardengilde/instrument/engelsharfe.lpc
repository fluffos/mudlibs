inherit "/gilden/bardengilde/instrument/base_string";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Engelsharfe");
  SetProp(P_LONG, 
	  BS("Diese Harfe ist aus lauterem Gold gemacht, dass von innenheraus zu leuchten "
       "scheint. Ihre Saiten sind mit feinem Engelshaar bespannt. Sie gibt nur die "
       "klarsten Toene von sich. Mit einer Schlaufe aus weissem Leder kannst du sie "
       "ueber deine Schulter haengen.")); 
  SetProp(P_NAME, "Engelsharfe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"harfe", "engelsharfe"}));
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_GOLD:80, MAT_HAIR:20]));
  SetProp(P_WEIGHT, 2500);
  SetProp(P_INSTRUMENT_LEVEL, 5);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);
}














