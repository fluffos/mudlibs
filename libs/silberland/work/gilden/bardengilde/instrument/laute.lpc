inherit "/gilden/bardengilde/instrument/base_string";

#include "../bardengilde.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Laute");
  SetProp(P_LONG, 
	  BS("Die Laute ist ein Zupfinstrument dessen "
	     +"laenglich-ovaler Koerper mit sechs Saiten "
	     +"bespannt ist. Sie aehnelt ein wenig einer "
	     +"Gitarre mit dem Unterschied das sie etwas "
	     +"kleiner dafuer aber auch etwas bauchiger ist.\n")); 
  SetProp(P_NAME, "Laute");
  SetProp(P_GENDER, FEMALE);
  AddId("laute");
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:80, MAT_BRONCE:20]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_INSTRUMENT_LEVEL, 2);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
}














