alinjas_wut()
{
  TP->do_damage(110);
}



beruehre_was(str)
{
  notify_fail("Was wills du beruehren?\n");
  if (!str) return 0;
  if ((str == "pentagramm" || str == "symbol"))
    {
      write("Entaeuscht stellst Du fest, dass an dem Pentagramm nichts "
	    +"magisches zu finden ist.\n");
      return 1;
    }
  return 0;
}



nosave int opfer_was(string str)
{
  object item;
  if(!str) 
    {
      write("Was moechtest Du opfern?\n");
      return 1;
    }
  
  if (!present(("irinja"), TO))
    {
      write("Ohne Irinja kannst Du hier nichts opfern!\n");
      return 1;
    }

  if(!item=deep_present(str, TP)) 
    {
      write("So etwas besitzt Du nicht!\n");
      return 1;
    }
  
  if(item->QueryProp(P_CURSED) || item->QueryProp(P_AUTOLOADOBJ) ||
     item->QueryProp(P_NEVERDROP) || item->QueryProp(P_NOSELL) || 
     item->QueryProp(P_NODROP) || !item->QueryProp(P_VALUE)) 
    {
      write(BS("Irinja erklaert Dir: Dies ist kein geeignetes Opfer!\n"));
    return 1;
    }
  
  if(item->QueryProp(P_KEEP_ON_SELL)) 
    {
      write(BS(sprintf("Du wolltest %s doch behalten!", item->name(WEN))));
      return 1;
    }
  
  if(item->QueryProp(P_WORN)) 
    {
      write(BS(sprintf("Aber Du traegst %s doch noch!", item->name(WEN))));
      return 1;
    }
  
  if(TP->QueryProp(P_WEAPON)==item) {
    write(BS(sprintf("Du hast %s doch gezueckt!", item->name(WEN))));
    return 1;
  }

  write(BS(sprintf("Irinja nimmt %s entgegen und bringt es Alinja "
		   +"als Opfer dar.", item->name(WEN))));
  write(BS("Irinja bedankt sich bei Dir fuer die Spende.\n"));
  say(BS(sprintf("%s ueberreicht Irinja ein %s als Opfer fuer Alinja.\n", 
		 TP->Name(WER), item->name(WEN))));
  say(BS("Irinja bedankt sich bei "+TP->Name(WEN)+".\n"));
  item->remove();
  
  // Hier noch die value-Berechnung und moeglicherweise Eintragung in die Spendenliste
  // Ab einem gewissen Wert wird eine Belohnung wahrscheinlich (vorrausgesetzt der
  // barde/bardin hat align>=0. bei anderen gilden muss das align mind. >=300 sein) 

  return 1;
}

private int calculateFreeTalentSlots(object pl) {
	int *activeTalents, openTalentSlots;
	activeTalents = TALENTMASTER->GetActiveTalents(this_player());
	openTalentSlots = (this_player()->QueryProp(P_GUILD_LEVEL)/4) - sizeof(activeTalents);
	if(pl->QueryProp(P_GUILD_LEVEL) > 14) openTalentSlots++;
	if(pl->QueryProp(P_GUILD_LEVEL) > 15) openTalentSlots++;
	return openTalentSlots;
}

public void printTalents() {
	int* activeTalents;
	int openTalentSlots, i;

	write(sprintf("+%73'='s+\n", ""));
	write(sprintf("| %|71' 's |\n", "Aktive Talente"));
	write(sprintf("+%73'~'s+\n", ""));
	activeTalents = TALENTMASTER->GetActiveTalents(this_player());
	openTalentSlots = calculateFreeTalentSlots(this_player());
	if(openTalentSlots < 0) openTalentSlots = 0;
	for(i=0; i<sizeof(activeTalents); ++i) {
		write(sprintf("| * %-69' 's |\n", TALENT_ID_TO_STRING[activeTalents[i]]));
	}
	for(i=0; i<openTalentSlots; ++i) {
		write(sprintf("| * %-69' 's |\n", "<frei>"));
	}
	write(sprintf("+%73'~'s+\n", ""));
}

public void printTalentMenu() {
	write(sprintf("|%|73' 's|\n", " Was moechtest du tun? "));
	write(sprintf("| %2s - %-66' 's |\n", "1", "Neues Talent erlernen"));
	write(sprintf("| %2s - %-66' 's |\n", "2", "Alle Talente vergessen"));
	write(sprintf("| %2s - %-66' 's |\n", "X", "Beenden"));
	write(sprintf("+%73'='s+\n", ""));
	input_to("talentMenuSelection");
}

public void learnTalentMenu() {
	int openSlots, i, *activeTalents;
	openSlots = calculateFreeTalentSlots(this_player());
	write(sprintf("+%73'='s+\n", ""));
	write(sprintf("| Du hast %d freie Talentplaetze.                                          |\n", openSlots));
	if(openSlots > 0) {
		write(sprintf("|%73'-'s|\n", ""));
		write(sprintf("|%|73' 's|\n", " Welches  Talent moechtest du aktivieren?"));
		activeTalents = TALENTMASTER->GetActiveTalents(this_player());
		for(i=0; i<MAX_TALENT_NR; ++i) {
			if(member(activeTalents, i) >= 0) continue;
			write(sprintf("| %2d. %-66' 's |\n", i+1, TALENT_ID_TO_STRING[i]));
		}
		write(sprintf("| %2s. %-66' 's |\n", "x", "Abbrechen"));
		write(sprintf("+%73'='s+\n", ""));
		write("Talentnummer ==> ");
		input_to("learnTalent");
	} else {
		write(sprintf("+%73'='s+\n", ""));
	}
}

public void learnTalent(string idStr) {
	int id, ret;

	if(lowerstring(idStr) == "x") {
		write(BSA("Auf bald, Barde!", "Eine Stimme singt: "));
		return;
	}
	
	if(sscanf(idStr, "%d", id) != 1) {
		write(BS("Du musst eine Talentnummer angeben!"));
		learnTalentMenu();
		return;
	}

	id -= 1; // die IDs im vorherigen step werden "human readable", also basis 1, angezeigt

	if(TALENTMASTER->HasTalent(this_player(), id)) {
		write(BS("Dieses Talent ist bereits aktiv."));
		learnTalentMenu();
		return;
	}

	if(id < 0 || id > MAX_TALENT_NR) {
		write(BS("Unbekannte Talentnummer."));
		learnTalentMenu();
		return;
	}

	ret = TALENTMASTER->ActivateTalent(this_player(), id);
	if(ret <= 0) {
		if(ret == -1){
			write(BS("Fehler: Du darfst das nicht!\n"));
		} else if(ret == -2) {
			write(BS("Fehler: Du bist kein Barde!\n"));
		} else if(ret == 0) {
			write(BS("Fehler: Aktivierung fehlgeschlagen.\n"));
		} else {
			write(BS("Fehler: " + ret + "\n"));
		}
		return;
	} else {
		write(BS("Du fuehlst wie dich goettliche Inspiration durchstroemt."));
		write(BS(sprintf("Das Talent '%s' ist nun aktiviert.", TALENT_ID_TO_STRING[id])));
		say(BS(sprintf("%s sieht ploetzlich inspiriert aus!", this_player()->Name(WER, 1))));
	}
	return;
}

public void resetTalents(string confirm) {
	int ret;
	if(lowerstring(confirm) != "zuruecksetzen") {
		write(BS("Abgebrochen."));
		return;
	}

	ret = TALENTMASTER->ResetTalents(this_player());
	if(ret <= 0) {
		if(ret == -1){
			write(BS("Fehler: Du darfst das nicht!\n"));
		} else if(ret == -2) {
			write(BS("Fehler: Du bist kein Barde!\n"));
		} else {
			write(BS(sprintf("Du kannst deine Talente noch nicht zuruecksetzen. Komme in %.2f Tagen wieder.", TALENTMASTER->GetRemainingResetDays(this_player()))));
		}
		return;
	}

	write(BS("Wie eine leise Melodie entweicht die Erinnerung..."));
	this_player()->SetProp(P_SP, 0);
	//this_player()->AddExp(-50000); --> in der Alpha deaktiviert
}

public void resetTalentMenu() {
	printTalents();
	write(sprintf("|%|73' 's|\n", " Talente verlernen bestaetigen! "));
	write(sprintf("|%-73' 's|\n", " Achtung, nach der Alpha gilt: "));
	write(sprintf("|%-73' 's|\n", "   1. Du kannst deine Talente nur alle 28 Tage zuruecksetzen "));
	write(sprintf("|%-73' 's|\n", "   2. Das Zueruecksetzen kostet alle aktuellen Magiepunkte "));
	write(sprintf("|%-73' 's|\n", "   3. Jedes Zueruecksetzen kostet 50.000 Erfahrungspunkte "));
	write(sprintf("+%73'='s+\n", ""));
	write("[Zum Zuruecksetzen gib 'zuruecksetzen' ein] ==> ");
	input_to("resetTalents");
}

public void talentMenuSelection(string choice) {
	if(choice == "1") {
		learnTalentMenu();
	} else if(choice == "2") {
		resetTalentMenu();
	} else if(lowerstring(choice) == "x") {
		write(BSA("Auf bald, Barde!", "Eine Stimme singt: "));
	} else {
		printTalentMenu();
	}
}

public void wantToManageTalents(string yesno) {
	if(yesno == "j" || yesno == "ja") {
		printTalents();
		printTalentMenu();
	}
}

public int bete() { 
	int alignment;
	if(this_player()->InFight()) {
		write(BS("Das geht nicht, wenn du gerade kaempfst!"));
		return -1;
	}

	write(BS("Du versinkst in ein Gebet zu Alinja.\n"));
	say(BS(TP->name(WER)+" versinkt in einem Gebet zu Alinja.\n"));
	
	alignment = this_player()->QueryProp(P_ALIGN);
    if(alignment < 300	&& alignment > -300 || member(playerPrayed, getuid(this_player())) >= 0) {
		write(BS("Nichts geschieht..."));
	} else {
		if(alignment >= 300) {
			write(BS("Ein wohliges Gefuehl der Geborgenheit und Kreativitaet erfuellt dich!"));
		} else if(alignment <= -300) {
			write(BS("Due spuerst Alinjas Zorn auf dich herabregnen. Geh und mehre die Schoenheit der Welt!"));
		}
		this_player()->AddHp(alignment/100);
		this_player()->AddSp(alignment/100);
	}

	// TALENTE LERNEN
	if(this_player()->QueryProp(P_GUILD) == "bardengilde" && this_player()->QueryProp(P_GUILD_LEVEL) > 3) {
		write(BSA("Du bist ein Mehrer der Schoenheit. Willst du die Gabe der Inspiration einsehen? (Ja, nein)", "Eine sanfte Stimme singt: "));
		input_to("wantToManageTalents");
	}

	playerPrayed += ({getuid(this_player())});
	
  return 1;
}






