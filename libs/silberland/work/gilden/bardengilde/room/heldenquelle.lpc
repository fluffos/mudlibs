  AddDetail( ({"farbe"}),
    "Der Einband ist von satter, dunkelblauer Farbe.");

  AddDetail( ({"rindsviech", "rindsviechs"}),
    "Eine Kuh, du Ochse!");

  AddDetail( ({"kuh"}),
    "Ja, eine Kuh.");

  AddDetail( ({"ochse"}),
    "Du bist der metaphorisch gemeinte Ochse.");

  AddDetail( ({"kanten", "beschlaege", "goldbeschlaege"}),
    "Zur besseren Haltbarkeit wurden die Kanten des Buchs mit Gold beschlagen.");

  AddDetail( ({"haltbarkeit"}),
    "Du vermutest, dass das Buch sonst nicht all zu lange aushalten wuerde.");

  AddDetail( ({"gold"}),
    "Mit deinem Daumennagel kratzt du kurz darueber. Ja, echte Goldbeschlaege.");

  AddDetail( ({"daumennagel", "nagel"}),
    "Dein Daumennagel ist etwas verdreckt von deinen ganzen Abenteuern.");

  AddDetail( ({"abenteuer", "abenteuern"}),
    "Die findest du draussen, ueberall im Silberland.");

  AddDetail( ({"vermoegen"}),
    "Ja, das war wohl alles ziemlich teuer.");

  AddDetail( ({"lesezeichen", "baender"}),
    "Verschiedenfarbige Baender dienen als Lesezeichen. Sie markieren unterschiedliche "
    "Stellen im Buch, die sich wohl jemand merken wollte.");
  
  AddDetail( ({"stellen"}),
    "Verschiedene Kapitel im Buch sind markiert. Du koenntest es lesen.");

  AddDetail( ({"kapitel"}),
    "Jedes der Kapitel kann man lesen.");

  AddDetail( ({"titel", "lettern"}),
    "Der Titel wurde in silbernen Lettern auf das Buch gepresst.");

  AddReadDetail( ({"lettern", "titel"}), "Chronik der Helden");

  AddDetail( ({"kristall", "kristalle", "innen", "licht"}),
    "Verschiedenfarbige Kristalle, die von Innen heraus leuchten, spenden dem Schrein "
    "das notwendige Licht.");

  AddItem(NPC("sigibert"), REFRESH_DESTRUCT);

  AddCmd( CMD_LESEN, "cmd_heldenchronik");
  AddCmd( CMD_TRINKEN, "cmd_trink");

  AddExit("sueden", ROOM("hain"));
} 

public int cmd_trink(string str) {
  notify_fail("Was willst du trinken?\n");
  if(str != "wasser" && str != "teich" &&
     str != "aus teich" && str != "von quelle") return 0;

  write(BS("Du trinkst einen Schluck erfrischend kuehles Wasser."));
  say(BS(TPN+ " trinkt einen Schluck Wasser aus dem Teich."));
  return 1;
}

private string makeTitleFromFile(string file) {
  return implode(explode(file[3..], "_"), " ");
}

private void print_buchdeckel() {
  int i;
  string *files, title;

  write("Das Buch traegt den Titel:\n");
  write("\n");
  write("           Chronik der Helden\n");
  write("                            von Sigibert dem Barden\n");
  write("\n");
  write("Im Inhaltsverzeichnis sind folgende Kapitel angefuehrt:\n");
  write("\n");

  files = get_dir(ROOM("heldengeschichten/*"));
  for(i=0; i<sizeof(files); ++i) {
    if(files[i] == "." || files[i] == "..") continue;
    title = makeTitleFromFile(files[i]);
    write(sprintf("%2d. %40-s\n", i-1, title));
  }

  write(BS("Das Buch scheint noch nicht ganz fertig zu sein und wird "
  "wohl gerade noch erweitert um die Geschichten der andern "
  "Helden."));
}

private void print_kapitel(int kapitel) {
  string *files, filestart;
  int i;

  filestart = sprintf("%'0'2d_", kapitel);

  files = get_dir(ROOM("heldengeschichten/*"));
  for(i = 0; i<sizeof(files); ++i) {
    if(files[i][0..2] != filestart) continue;
    write("Du findest das passende Kapitel und beginnst zu lesen:\n");
    write("\n");
    write("      " + makeTitleFromFile(files[i]+"\n\n"));
    TP->More(read_file(ROOM("heldengeschichten/" + files[i])));
    return;
  }

  write(BS("Ein Kapitel mit dieser Nummer gibt es nicht."));
}

public int cmd_heldenchronik(string arg) {
  int kapitel;
  notify_fail("Was willst du lesen?\n");
  if(!arg || arg == "") return 0;

  if(arg == "buch" || arg == "chronik" || arg == "heldenchronik") {
    print_buchdeckel();
  } else if(sscanf(arg, "kapitel %d", kapitel) == 1){
    print_kapitel(kapitel);
  } else {
    notify_fail(BS("Willst du die Heldenchronik oder eines der Kapitel lesen?"));
    return 0;
  }

  return 1;
} 
