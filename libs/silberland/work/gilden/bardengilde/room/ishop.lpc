sell(string str, int f)
{
  object ob;
  string prefix;
  notify_fail("Brabo sagt bedauernd: Tut mir leid, aber hier kannst Du nur Instrumente verkaufen!\n");
  if(!present("brabo", TO)) 
    {
      write(BS("Ohne Brabo Glasfuss geht das nicht!\n"));
      return 1;
    }
  if (!str) 
    {
      write ("Brabo fragt: Was willst Du denn verkaufen?\n");
      return 1;
    }
  if (!ob=present(str, TP))
    {
      write ("Brabo meint: Du hast ja so etwas gar nicht dabei!\n");
      return 1;
    }

  if (ob->id("\ninstrument"))
    {
      write ("Brabo sagt: Na so etwas kaufe ich gerne!\n");
      this_object()->do_sell (ob,f,0,prefix);
      return 1;
    }
  else 
    {
      return 0;
    }
  return 0;
}

do_sell2(ob,value,prefix,reqamount)
{
  int ret;
  string str,at;
  closure qp;

  // if (value>MAX_VALUE) value=MAX_VALUE;
  if (value>mymoney)
  {
    write(prefix+"Ich hab das Geld leider nicht mehr.\n");
    return 1;
  }
  if (!ob || !deep_present(ob,this_player()))
  {
    write(break_string("Nanu, wo ist denn "+
        (ob ? ob->name(WER,1) : "der fragliche Gegenstand")+
        " hinverschwunden?", 78, prefix));
    return 1;
  }
  if (sizeof(all_inventory(ob)))
  {
    write(break_string("Aber "+ob->name(WER,1)+
        " ist doch gar nicht leer!", 78, prefix));
    return 1;
  }
  qp=symbol_function("QueryProp", ob);
  if (ob->IsUnit())
    if (funcall(qp,P_AMOUNT) < reqamount)
    {
      write(prefix+"Tut mir leid, aber irgendwas ging da schief.\n");
      return 1;
    }
    else
      ob->SetProp(P_REQUESTED_AMOUNT, reqamount);
  if (funcall(qp,P_NOBUY) || (funcall(qp,P_WC) > 150) ||
      ((at=funcall(qp,P_ARMOUR_TYPE)) &&
       funcall(qp,P_AC)>=KEEP_ARMOUR_CLASS[at]) )
  {
    string was;
    was = ob->name(WEM, 1);
    ret=ob->move(storage,M_PUT);
    if (ret>0)  /* Sonst werden auch Sachen */
      /* zerstoert, die man nicht weglegen kann */
      {
      say(this_player()->Name()+" verkauft "+ob->name(WEN)+".\n");
      write(
	    break_string(sprintf("%s ist hocherfreut ueber %s und legt %s zu seiner "+
				 "erstaunlichen Instrumentensammlung.", capitalize(KeeperPrefix("", "Brabo ")),
				 was, ob->QueryPronoun(WEN)), 78));
      give_money(value,ob,prefix);
      mymoney-=value;
      mymoney+=value*shop_percent_left/100; // Wegen Zerstoerung des Objektes
      UpdateCounter(ob,1);
      destruct(ob);
    }
    else if (ret == ME_CANT_BE_DROPPED)
    {
      if ((str=funcall(qp,P_NODROP)) && stringp(str))
      {
	write(str);
	return 1;
      }
      write("Du kannst "+ob->name(WEN,1)+" nicht verkaufen!\n");
      return 1;
    }
    else
      write(prefix+"Das interessiert mich nicht.\n");
  }
  else
    if (ob->move(storage,M_PUT)>0)
    {
      say(this_player()->Name()+" verkauft "+ob->name(WEN)+".\n");
      give_money(value,ob,prefix);
      mymoney-=value;
      UpdateCounter(ob,1);
    }
    else
      write(prefix+"Du kannst "+ob->name(WEN,1)+" nicht verkaufen!\n");
  return 1;
}
    
force_sell() { return sell(); }
evaluate() { return sell(); }

int repair(string str)
{
  object ob;
  int dam, wert, maxwert, damrest, preis, damrest_pct;
  
  notify_fail("Was willst Du reparieren lassen?\n");
  if (!str || !stringp(str)) return 0;
  if (!ob=present(str,TP)) 
    {
      write(BRAS("So etwas hast Du ja gar nicht dabei!\n"));
      return 1;
    }
  
  if(!present("brabo", TO)) 
    {
      write(BS("Ohne Brabo Glasfuss geht das nicht!\n"));
      return 1;
    }
  
  dam = ob->QueryProp(P_DAMAGED);
  
  
  if (ob->id("\ninstrument"))   
    { 
      write(BRAS("Ahja, mal sehen was ich da noch zaubern kann...!\n"));
      wert=ob->QueryProp(P_WC);
      damrest_pct=5+random(3);
      preis=50;   // Multiplikator
    }
  else
    {    
      write(BRAS("Tut mir leid, aber ich kann hier nur Instrumente reparieren.\n"));
      return 1;
    }
  
  write("Brabo sieht sich Dein Instrument naeher an.\n");
  maxwert = wert + dam;
  damrest = (maxwert * damrest_pct) / 100;
  if (damrest<1) damrest=1;
  if (dam <= damrest) {
    write(BRAS("Hmmm, ich kann keine Schaeden an "+ob->name(WEM,1)+" entdecken!\n"));
    return 1;
  }
  preis=preis*(dam-damrest);
  write(BRAS("Die Reparatur "+ob->name(WESSEN,1)+" wuerde Dich "+
	     preis+" Muenzen kosten."));
  write("Willst Du sie durchfuehren lassen? (ja/nein) -> ");
  input_to("repair2", 0, ob, dam-damrest, preis, time());
  return 1;
}

void repair2(string str, object ob, int damrep, int preis, int zeit)
{
  if (!TP) return;
  if (environment(TP) != ME) 
    {  // Spieler mit !bla rausgegangen...?
      write("Dazu ist es jetzt zu spaet!\n");
      return;
    }
  
  if (time() > (zeit+15))       // 15 Sekunden Zeit
    {
      write(BRAS("Du hast Dir zuviel Zeit gelassen! Ueberlege es Dir "
		 "noch einmal... unser Angebot bleibt natuerlich bestehen!"));
      return;
    }
  
  if ((str!="ja") && (str!="j")) 
    {
      write(BRAS("Na gut, wie Du meinst. Viel Spass noch damit!"));
      return;
    }
  
  if (!ob) 
    {
      write(BRAS("Nanu, wo ist denn das fragliche Instrument "
		 "so ploetzlich hinverschwunden?"));
      return;
    }
  
  if (environment(ob) != TP) 
    {
      write(BRAS("Nanu, wo ist denn "+ob->name(WER,1)+
		 " so ploetzlich hinverschwunden?"));
      return;
    }
  
  if (damrep > ob->QueryProp(P_DAMAGED)) 
    {
      write(BRAS("Huch, irgendwas stimmt da nicht, "+ob->name(WER,1)+
		 " ist ja gar nicht mehr so arg beschaedigt wie vorhin!"
		 " Probier es doch bitte noch einmal..."));
      return;
    }
  
  if (TP->QueryMoney() < preis) 
    {
      write(BRAS("Du hast "+preis+" Muenzen ja gar nicht dabei! Unter diesen "
		 +"Umstaenden kann ich Dir da leider nicht weiterhelfen.\n"));
      return;
    }
  
  TP->AddMoney(-preis);
  ZENTRALBANK->PayIn(preis);
  
  ob->SetProp(P_AC, ob->QueryProp(P_AC)+damrep);
  ob->SetProp(P_DAMAGED, ob->QueryProp(P_DAMAGED)-damrep);
  write(BS("Du gibst Brabo "+preis+" Muenzen der sogleich eifrig "
	   +"mit der Reparatur an "+ob->name(WESSEN,1)+" beginnt. Kurz darauf "
	   +"erscheint Brabo freudestrahlend wieder und drueckt "
	   +ob->QueryPronoun(WEN)+" mit der Bemerkung "
	   +"'Ist so gut wie neu!' in die Hand."));
}


