		+"`|___________________________________|'\n"
		+"\n" 
		+"  Syntax zum Lesen: lies kapitel <nr>  \n");
  
  AddSound( DEFAULT_SOUND,
	    "Du bildest Dir ein, dass hier irgendwo eine leise Melodie zu hoeren ist.\n");
  AddSound(("melodie"),
	   "Es ist eine sehr leise, aber dennoch wunderschoene Melodie. Aber du kannst "
	   +"absolut nicht bestimmen woher sie kommt.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier angenehm nach frischem Moos.\n");
  AddSmell(("moos"),
	   "Das Moos riecht angenehm frisch.\n");
  
  AddCmd(({"lies", "lese"}), "lies_was");
  AddCmd(({"bitte", "bitt"}), "cmd_lehren");
  AddExit("suedwesten","/gilden/bardengilde.lpc");
  AddExit("norden", ROOM("heldenquelle"));

  AddItem("/d/kristallwald/andyl/bardengilde/npc/kinathias", REFRESH_DESTRUCT);
} 

public int cmd_lehren(string str) {
	string wen, was;
	notify_fail("Wen willst du um was bitten?\n");

	if(!str || str == "") return 0;

	if(sscanf(str, "%s %s", wen, was) != 2) return 0;

	if(was != "mich zu lehren" && str != "um unterricht" &&
       was != "lied lernen" && was != "lied zu lehren" && 
	   was != "dich zu lehren") {
		write(BS("Um das kannst du hier nicht bitten."));
		return -1;
	}

	if(wen != "korriax" && wen != "alestra" && wen != "tirena" && wen != "sarrian") {
		write(BS("Diese Person kannst du hier nicht bitten."));
		return -1;
	}

	if(TP->QueryProp(P_GUILD) != "bardengilde") {
		write(BS("Nur Barden koennen hier um etwas bitten."));
		return -1;
	}

	if(mappingp(TP->QuerySkill("der alte pakt"))  || mappingp(TP->QuerySkill("requiem der traeume")) ||
	   mappingp(TP->QuerySkill("zug der tausend oger"))|| mappingp(TP->QuerySkill("lied der lieder"))) {
		write(BS("Du beherrscht bereits ein Lied der alten Bardenhelden. Mehr kann man dich hier nicht lehren."));
		return -1;
	}

	if(wen == "korriax" && TP->QueryProp("barden_tugend") == "tapferkeit") {
		write(BS("Korriax ist noch nicht bereit dich hier sein Lied zu lehren."));
		return 1;
	} else if(wen == "alestra" &&  TP->QueryProp("barden_tugend") == "vertrauen") {
		write(BS("Mit einem Mal erfuellt dich der Geist von Alestra. All ihr Wissen und ihre Erinnerung an das Lied "
	             "'Der alte Pakt' stroemen auf dich ein."));
	    call_out("LearnBardSpell", 0, TP, "der alte pakt", 
		         "Mit diesem Lied erschaffst du um dich eine Zone des Friedens und er Erholung.",
		         "spiele 'der alte pakt'");
	}  else if(wen == "tirena" &&  TP->QueryProp("barden_tugend") == "schoenheit") {
		write(BS("Mit einem Mal erfuellt dich der Geist von Tirena. All ihr Wissen und ihre Erinnerung an das "
	             "'Lied der Lieder' stroemen auf dich ein."));
	    call_out("LearnBardSpell", 0, TP, "lied der lieder", 
		         "Waehrend du das Lied der Lieder spielst sammelst du immer mehr Inspiration an, auch ueber "
				 "das gewoehliche Mass hinaus.",
		         "spiele 'lied der lieder'");
	} else if(wen == "sarrian" &&  TP->QueryProp("barden_tugend") == "mitleid") {
		write(BS("Mit einem Mal erfuellt dich der Geist von Sarrian. All ihr Wissen und ihre Erinnerung an das "
	             "'Requiem der Traeume' stroemen auf dich ein."));
	    call_out("LearnBardSpell", 0, TP, "requiem der traeume", 
		         "Wenn du das Reqiuem fuer jemanden spielst, wird die Erinnerung an ihn in der Welt manifestiert. "
				 "Bei seinem oder ihrem Tod werden die Auswirkungen geringer und den Ziel wird sich dort wieder "
				 "manifestieren, wo du dieses Lied gespielt hast.",
		         "spiele 'requiem der traeume' [fuer <spieler>]");
	} else {
		write(BS("Du bist nicht von der rechten Tugend erfuellt."));
	}

	return 1;
}

mapping stories = ([
	"kapitel 1": "/gilden/bardengilde/room/zusammentreffen.txt",
	"kapitel 2": "/gilden/bardengilde/room/zusammenschluss.txt",
	"kapitel 3": "/gilden/bardengilde/room/verschwinden.txt",
	"tafel von alinja": "/gilden/bardengilde/room/alinjageschichte.txt",
	"geschichte von alinja": "/gilden/bardengilde/room/alinjageschichte.txt",
	"tafel von alestra": "/gilden/bardengilde/room/alestrageschichte.txt",
	"geschichte von alestra": "/gilden/bardengilde/room/alestrageschichte.txt",
	"tafel von sarrian": "/gilden/bardengilde/room/sarriangeschichte.txt",
	"geschichte von sarrian": "/gilden/bardengilde/room/sarriangeschichte.txt",
	"tafel von tirena": "/gilden/bardengilde/room/tirenageschichte.txt",
	"geschichte von tirena": "/gilden/bardengilde/room/tirenageschichte.txt",
	"tafel von korriax": "/gilden/bardengilde/room/korriaxgeschichte.txt",
	"geschichte von korriax": "/gilden/bardengilde/room/korriaxgeschichte.txt"
]);

public int lies_was(string str) {
	string content, who, what;
	notify_fail("Was willst Du lesen?\n");
	if(str == "" || !member(stories, str)) {
		return 0;
	}

	content = read_file(stories[str]);
	this_player()->More(content);

	if(this_player()->QuerySkill("das gelueftete geheimnis") == 0) {
		if(sscanf(str, "%s von %s", what, who) == 2) {
			if(what == "geschichte" || what == "tafel") {
				if(call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", this_player()) == who) {
					LearnBardSpell(this_player(), "das gelueftete geheimnis", 
								   "Dieses Lied offenbart dir die Geheimnisse eines Gegenstands.",
								   "spiele 'das gelueftete geheimnis' auf <gegenstand>'");
				}
			}
		}
	}

	return 1;
}

public string skriptfalle()
{
  TP->die();
  return "";
}















