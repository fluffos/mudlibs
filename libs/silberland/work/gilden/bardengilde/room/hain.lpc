/*
** Gedenkhain der Bardengilde
**
** Andyl@Silberland
**
** 1998-07-24 
**
** Last updated: 1999-01-25
*/

inherit "std/room";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <properties.h>
#include "/gilden/bardengilde/bardengilde.h"

create()
{
  ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
	  "Du befindest dich hier im Gedenkhain der Bardengilde.\n"
	  +"Um Dich herum befinden sich eine grosse Anzahl von "
	  +"staemmigen Eichen, welche kreisfoermig angeordnet sind. "
	  +"Im Norden kannst du eine Statue der Goettin "
	  +"Alinja erkennen, im Osten siehst du eine Statue von Alestra, im Westen eine "
	  +"Statue von Sarrian, im Suedosten eine Statue von Tirena und im "
	  +"Suedwesten eine Statue von Korriax. Unter jeder Statue ist ein "
	  +"Tafel befestigt, welche die Geschichte der jeweiligen Person "
	  +"erzaehlt und somit die ganze Entstehung der Bardengilde enthalten. "
	  +"Mehrere Kieswege bilden zusammen ein Pentagramm in dessen Mitte ein hoelzernes "
	  +"Podest steht mit einem Buch darauf. "
	  +"Hier kannst du sicherlich einiges ueber die Bardengilde erfahren.\n");
  SetProp(P_INT_SHORT,"Gedenkhain der Bardengilde");
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE: 21]) );
  SetProp (P_NAME, "Andyls tueckische Skriptfalle");


  AddDetail(("person"),
    "Hier stehen die Statuen von Alinja, Alestra, Tirena, Sarrian "
	    +"und Korriax.\n");
  AddDetail(("norden"),
	    "Da steht eine Statue von Goettin Alinja.\n");
  AddDetail(("osten"),
	    "Da steht eine Statue von Alestra.\n");
  AddDetail(("westen"),
	    "Da steht ein Statue von Sarrian.\n");
  AddDetail(("suedosten"),
	    "Da steht eine Statue von Tirena.\n");
  AddDetail(("suedwesten"),
	    "Da steht eine Statue von Korriax. Ausserdem fuehrt ein "
	    +"Pfad in dieser Richtung zum Gildenhauptsitz.\n");
  AddDetail(("richtung"),
	    "Ein Pfad fuehrt in Richtung suedwesten zum Gildenhauptsitz.\n");
  AddDetail(("pfad"),
	    "Der Pfad fuehrt zum Gildenhauptsitz.\n");
  AddDetail(({"gildenhauptsitz", "hauptsitz"}),
	    "Im Suedwesten befindet sich der Gildenhauptsitz.\n");
  AddDetail(({"holz", "eichenholz"}),
	    "Solides Eichenholz.\n");
  AddDetail(({"podest"}),
	    "Ein einfaches Podest aus Eichenholz. Darauf liegt ein Buch.\n");
  AddDetail(("buch"),
	    "Ein schwarzer Einband mit silbernen Buchstaben umgibt das Buch. "
	    +"Du kannst es lesen wenn Du willst.\n");
  AddDetail(({"einband", "buchstaben", "vier"}),
	    "Auf dem schwarzem ledernem Einband des Buches steht in silbernen "
	    +"Buchstaben: 'Die Geschichte der grossen Vier'\n"); 
  AddDetail(({"anzahl"}),
	    "Rings um Dich herum kannst Du eine grosse Anzahl an Eichen erkennen.\n");
  AddDetail(({"himmel", "blick"}),
	    "Das dichte Blaetterdach der Eichen versperrt Dir den Blick "
	    +"auf den Himmel. Nur ein paar Sonnenstrahlen dringen durch die "
	    +"Baumkronen.");
  AddDetail(({"eiche", "eichen", "baum", "baeume"}),
	    "Kreisfoermig um diesen Ort herum sind praechtige Eichen angeordnet. "
	    +"Sie haben allesamt dicke und ueberaus kraeftige Staemme, tief im Boden "
	    +"verankerte Wurzeln und praechtige Baumkronen. Die muessen alle schon ein "
	    +"ziemliche hohes  Alter ereicht haben.\n");
  AddDetail(({"alter"}),
	    "Das Alter dieser Eichen duerfte ziemlich hoch sein.\n");
  AddDetail(({"wurzel", "wurzeln"}),
	    "Die Wurzeln der Eichen sehen ausgesprochen gesund aus und haben "
	    +"sich tief im Boden verankert.\n");
  AddDetail(({"stamm", "staemme", "baumstamm", "baumstaemme", "eichenstamm", "eichenstaemme"}),
	    "Die Staemme der Eichen haben einen so grossen Durchmesser, dass "
	    +"man darin eine Wohnung einrichten koennte. Sie bestehen aus ueberaus "
	    +"wiederstandsfaehigem Holz. Damit haetten so manche Holzhacker ein grosses "
	    +"Problem vor sich.\n");
  AddDetail(("durchmesser"),
	    "Der Durchmesser dieser Staemme ist zweifellos gewaltig.\n");
  AddDetail(("wohnung"),
	    "In jeden dieser Eichenstaemme koennte man problemlos eine Wohnung hineinbauen.\n");
  AddDetail(({"baumkrone", "baumkronen"}),
	    "Die Baumkronen dieser Eichen bilden ein dichtes Blaetterdach welches aus einem "
	    +"dichten Geaest besteht welches mit gruenen Blaettern und Eicheln besetzt ist.\n");
  AddDetail(("eicheln"),
	    "Ausgesprochen grosse, aber ansonsten ganz gewoehnliche Eicheln.\n");
  AddDetail(({"blaetterdach", "dach"}),
	    "Das Blaetterdach ist so dicht, dass kaum ein Sonnenstrahl hindurchscheint.\n");
  AddDetail(({"blaetter", "blatt", "eichenblaetter", "eichenblatt"}),
	    "Die Blaetter auf den Aesten der Eichen sind ausserst zahlreich und dicht "
	    +"beieinander. Da ist es nicht verwunderlich, dass kaum ein Sonnenstrahl den "
	    +"Boden erreicht. Auch auf der Toga von Tirena kannst du ein Stickmuster sehen "
	    +"welches viele kleine verschiedenartige Eichenblaetter zeigt.\n");
  AddDetail(({"geaest", "aeste", "ast"}),
	    "Das Geaest der Eichen ist extrem kraeftig und reicht bis weit in den Himmel. "
	    +"Sowas findet man sicher nicht so oft im Silberland.\n");
  AddDetail(({"silberland"}),
	    "Eigentlich solltest Du mittlerweise wissen was das Silberland ist.\n");
  AddDetail(({"dicke", "holzhacker", "problem"}),
	    "Bei der Dicke dieser Staemme haetten so manche Holzhacker ein Problem.\n");
  AddDetail(({"bardengilde", "gedenkhain"}),
	    "Du befinest Dich hier im Gedenkhain der Bardengilde. Hier ist "
	    +"die ganze Entstehung der Bardengilde festgehalten.\n");
  AddDetail(({"entstehung"}),
	    "Die Entstehung der Bardengilde ist auf den Tafeln unter den Statuen "
	    +"festgehalten.\n");
  AddDetail(("sonne"),
	    "Du kannst sie nicht direkt sehen aber die Sonnenstrahlen, welche Du "
	    +"hier sehen kannst, lassen darauf schliessen, dass sie irgendwo da "
	    +"oben sein muss.\n");
  AddDetail(({"strahlen", "sonnenstrahlen", "strahl", "sonnenstrahl"}),
	    "Einige Sonnenstrahlen schaffen es doch durch das dichte Blaetterdach der "
	    +"Eichen hindurchzudringen.\n"); 
  AddDetail(({"boden", "kreisform"}),
	    "Der Boden besteht zu einem grossteil aus weichem gruenem Moos. "
	    +"Die Statuen wurden mit schmalen Kieswegen in Form eines Pentagramms "
	    +"verbunden welches seinerseits wieder von einem Kiesweg in Kreisform umgeben "
	    +"ist.\n");
  AddDetail(({"kiesweg", "kieswege", "gesamtbild", "kreis"}),
	    "Die Kieswege verlaufen zwischen den einzelnen Statuen und ergeben im "
	    +"Gesamtbild ein Pentagramm welches von einem Kreis umgeben ist.\n");
  AddDetail(("kies"),
	    "Ganz gewoehnlicher Kies.\n");
  AddDetail(("moos"),
	    "Weiches, gruenes Moos.\n");
  AddDetail(({"pentagramm", "zeichen"}),
	    "Das von einem Kreis umgebene Pentagramm wird von den Kieswegen gebildet. "
	    +"Das Pentagramm ist fuer gewoehnlich das Zeichen der Magie. Man kann also "
	    +"davon ausgehen, dass dies hier ein magischer Ort ist. In der Mitte des "
	    +"Pentagramms steht ein hoelzernes Podest mit einem Buch darauf.\n");
  AddDetail(("mitte"),
	    "In der Mitte des Pentagramms steht ein hoelzernes Podest auf dem ein "
	    +"Buch liegt.\n");
  AddDetail(("ort"),
	    "An diesem Ort ist sicherlich ein Magie wirksam. Leider kannst Du nicht "
	    +"identifizieren um was fuer eine Magie es sich dabei handelt.\n");
  AddDetail(({"magie", "wirkung"}),
	    "Bei der Magie welche an diesem Ort wirksam ist, kannst Du nicht feststellen "
	    +"welche Wirkung sie hat.\n");
  AddDetail(({"statuen"}),
	    "Du siehst hier die Statuen von Alinja, Alestra, Sarrian, Tirena "
	    +"und von Korriax. Unter jeder Statue ist eine Tafel befestigt.\n");
  AddDetail(({"statue"}),
	    "Hier stehen mehrere Statuen. Welche Statue willst Du denn genau "
	    +"untersuchen? Die Statue von Alinja, von Alestra, von Sarrian, von "
	    +"Tirena oder von Korriax?\n");
  AddDetail(({"statue"}),
	    "Hier stehen mehrere Statuen. Welche Statue willst Du denn genau "
	    +"untersuchen? Die Statue von Alinja, von Alestra, von Sarrian, von "
	    +"Tirena oder von Korriax?\n");
  AddDetail(({"statue von alinja", "alinja", "gegensatz", "paar"}),
	    "Die Statue zeigt Alinja, die Goettin der Kunst. "
	    +"Im Gegensatz zu den anderen Statuen ist diese Statue nicht aus Stein oder Kristall "
	    +"sondern wirkt sogar ziemlich real. Du kannst nicht erkennen aus welchem Material "
	    +"diese Statue besteht. Die Goettin traegt ein schlichtes Kleid aus Leder mit einem "
	    +"einfachem Guertel und ein Paar Lederstiefel. Um ihr langes wallendes "
	    +"Haar traegt sie ein Stirnband mit einem leuchtenden Rubin in der Mitte."
	    +"In den sanften und guetigen Gesichtszuegen kannst Du ein freundliches Laecheln "
	    +"erkennen. "
	    +"In einer Hand haelt sie einen seltsamen Stab mit dem sie schraeg nach "
	    +"oben zeigt.\n");
  AddDetail(({"goettin", "kunst", "kuenste"}),
	    "Alinja ist die Goettin der Kuenste.\n");
  AddDetail(("kristall"),
	    "Ganz gewoehnliches Kristall wie man es im Kristallwald haeufig sieht.\n");
  AddDetail(({"kristallwald", "wald"}),
	    "Du befindest Dich gerade im Kristallwald.\n");
  AddDetail(({"guertel", "lederguertel"}),
	    "Welchen Guertel moechtest Du untersuchen? Den von Alinja oder den von Sarrian?\n");
  AddDetail(({"lederguertel von alinja", "guertel von alinja"}),
	    "Es ist ein Einfacher Lederguertel. Du kannst nichts besonderes an ihm erkennen.\n");
  AddDetail(("material"),
	    "Du kannst nicht erkennen aus welchem Material die Statue von Alinja besteht.\n");
  AddDetail(({"goettin" "kunst"}),
	    "Die Goettin der Kunst heisst Alinja.\n");
  AddDetail(({"kleid"}),
	    "Welches Kleid willst Du denn untersuchen? Das von Alinja oder das von Alestra?\n");
  AddDetail(({"kleid von alinja", "lederkleid"}),
	    "Das Kleid von Alinja ist ein schlichtes Lederkleid. Du kannst nichts "
	    +"besonderes daran erkennen.\n");
  AddDetail(({"lederstiefel", "stiefel"}),
	    "Ganz gewoehnliche Lederstiefel.\n");
  AddDetail(({"haar"}),
	    "Von wem moechtest Du das Haar untersuchen? Von Alinja, von Alestra oder von "
	    +"Tirena?\n");
  AddDetail(("haar von alinja"),
	    "Alinja hat langes schwarzes Haar. Um es herum ist ein Stirnband gebunden in dessen "
	    +"Mitte sich ein Rubin befindet.\n");
  AddDetail(({"stirnband", "lederstirnband"}),
	    "Ein ganz gewoehnliches Lederstirnband. In dessen Mitte befindet sich ein Rubin.\n");
  AddDetail(("rubin"),
	    "Von dem Rubin geht ein intensives rotes Schimmern aus. Ob der Rubin "
	    +"vielleicht magisch ist?\n");
  AddDetail(("schimmern"),
	    "Ein intensives roetliches Schimmern geht von dem Rubin aus. Moeglicherweise ist das "
	    +"etwas magisches.\n");
  AddDetail(({"haende", "hand"}),
	    "Von wem moechtest Du die Haende untersuchen? Von Alinja, von Alestra, von Sarrian, "
	    +"von Tirena oder von Korriax.\n");
  AddDetail (({"hand von alinja", "haende von alinja"}),
	     "In einer von Alinjas sanften Haenden haelt sie einen Stab mit dem sie schraeg "
	     +"nach oben zeigt.\n");
  AddDetail(("stab"),
	    "Der Stab von Alinja ist aus Holz hat eine selsam verschnoerkelte Form. Wozu der "
	    +"wohl brauchbar ist?\n");
  AddDetail(("form"),
	    "Die Form von Alinjas Stab ist seltsam verschnoerkelt.\n");
  AddDetail(("gesichtszuege"),
	    "Die Gesichtszuege von Alinja wirken sanft und guetig. In ihnen kannst Du ein "
	    +"freundliches Laecheln erkennen.\n");
  AddDetail(("laecheln"),
	    "Es ist ein ueberaus freundliches Laecheln. Du beschliesst es naeher zu beaeugen...\n"
	    +"...Hey, hat sich da nicht gerade ein Mundwinkel etwas bewegt?\n");
  AddDetail(("mundwinkel"),
	    "Du koenntest schwoeren, dass sich der Mundwinkel der Goettin gerade etwas bewegt "
	    +"hat.\n");
  AddDetail(("leder"),
	    "Ganz gewoehnliches hellbraunes Leder.\n");
  AddDetail(({"lederguertel von sarrian", "guertel von sarrian"}),
	    "Der Guertel von Sarrian ist sehr breit und besteht aus Leder. "
	    +"Auffaellig daran ist die praechtige Guertelschnalle.\n");
  AddDetail(({"statue von alestra", "alestra", "seide"}),
	    "Die Statue von Alestra ist komplett aus Marmor. Sie zeigt Alestra "
	    +"in einem fuer Feen typischen Kleid aus Seide und einer reichlich "
	    +"verzierten Haarspange in ihrem Haar. Ihr Blick ist auf die Statue von Alinja "
	    +"fixiert und in den Haenden haelt sie ihr Lieblingsinstrument, die Feenharfe.\n");
  AddDetail (({"hand von alestra", "haende von alestra"}),
	     "In ihren zierlichen Haenden haelt Alestra die Feenharfe.\n");
  AddDetail(({"marmor", "zwerge"}),
	    "Die Statue von Alestra ist aus feinstem Marmor gefertigt. Wahrscheinlich haben "
	    +"Zwerge den Marmor so geformt.\n");
  AddDetail(({"fee", "feen"}),
	    "Alestra war ein Fee.\n");
  AddDetail(("kleid von alestra"),
	    "Das Kleid von Alestra ist aus Seide, was bei Feen nicht ungewoehnlich ist.\n");
  AddDetail(("haarspange"),
	    "Die Haarspange von Alestra ist reichlich mit Edelsteinen verziert. Sie hat sie "
	    +"wahrscheinlich bei einem wichtigem Anlass bekommen.\n");
  AddDetail(("haar von alestra"),
	    "In ihrem goldblondem Haar traegt Alestra eine schoen verzierte Haarspange.\n");
  AddDetail(("anlass"),
	    "Vielleicht steht ja etwas ueber diesen Anlass auf der Tafel.\n");
  AddDetail(({"edelsteine", "edelstein"}),
	    "Die Edelsteine sind sicherlich aeusserst kostbar.\n");
  AddDetail(("blick"),
	    "Der Blick von Alestra ist auf Goettin Alinja fixiert.\n");
  AddDetail(("lieblingsinstrument"),
	    "Das Lieblingsinstrument von Alestra war die Feenharfe.\n");
  AddDetail(({"feenharfe", "harfe", "harfen", "saiten"}),
	    "Die Feenharfe, das Lieblingsinstrument von Alestra, ist keine "
	    +"gewoehnliche Harfe. Im Gegensatz zu gewoehnlichen Harfen sind die "
	    +"Saiten nicht nur senkrecht sondern auch waagrecht angeordnet. Man "
	    +"muss ausserordentlich geschickt sein um sie spielen zu koennen.\n");
  AddDetail(({"statue von sarrian", "sarrian"}),
	    "Die Statue von Sarrian ist aus Granit gefertigt. Sie zeigt den Hobbit in "
	    +"einer fuer Hobbits typischen Kleidung, bestehend aus einer bequemen Hose und "
	    +"einm kurzaermligen Hemd. Um seinen Bauch traegt er einen breiten Guertel mit einer "
	    +"praechtigen Guertelschnalle. Auf dem Kopf traegt er noch einen seltsam geformten "
	    +"Filzhut. Seine Aufmerksamkeit ist auf ein aus Glas "
	    +"gefertigtes Instrument gerichtet, welches "
	    +"er in seinen Haenden haelt und mit zufriedenen Augen ansieht.\n");
  AddDetail(({"hand von sarrian", "haende von sarrian"}),
	     "In seinen Haenden haelt Sarrian ein aus Glas gefertigtes Instrument.\n");
  AddDetail(("glas"),
	    "Das Glas, aus welchem das Instrument gefertigt ist, schimmert leicht roetlich.\n");
  AddDetail(("granit"),
	    "Die Statue von Sarrian ist komplett aus Granit gefertigt.\n");
  AddDetail(("instrument"),
	    "Das Instrument welches Sarrian in der Hand haelt duerfte ein Trabok sein.\n");
  AddDetail(({"trabok", "glasblasinstrument"}),
	    "Das Trabok ist ein Glasblasinstrument und gleichzeitigt das schoenste Instrument "
	    +"welches Sarrian erfunden hat.\n");
  AddDetail(({"hobbit", "hobbits"}),
	    "Sarrian war ein Hobbit.\n");
  AddDetail(("Kleidung"),
	    "Die Kleidung Sarrians besteht aus einer bequemen Hose und einem "
	    +"kurzaermligen Hemd.\n");
  AddDetail(("hose"),
	    "Die Hose von Sarrian scheint sehr bequem zu sein.\n");
  AddDetail(("hemd"),
	    "Sarrian traegt ein einfaches kurzaermliges Hemd.\n");
  AddDetail(("bauch"),
	    "Um seinen wohlgenaehrten Bauch traegt Sarrian einen breiten Guertel mit einer "
	    +"praechtigen Guertelschnalle.\n");
  AddDetail(("kopf"),
	    "Sarrian traegt auf seinem Kopf einen seltsamen Filzhut.\n");
  AddDetail(("aufmerksamkeit"),
	    "Die Aufmerksamkeit von Sarrian ist auf ein aus Glas gefertigtes Instrument "
	    +"gerichtet.\n"); 
  AddDetail(({"guertelschnalle", "schnalle", "gold"}),
	    "Die praechtige Guertelschnalle von Sarrian ist komplett aus Gold. So etwas "
	    +"kennzeichnet einen besonders angesehenen Hobbit.\n");
  AddDetail(("filzhut"),
	    "Der Filzhut von Sarrian ist eigenartig geformt. Die vordere Hutkrempe ist "
	    +"senkrecht nach oben gebogen und eine gruenlich schimmernde Feder steck darin.\n");
  AddDetail(("augen"),
	    "Die Augen von Sarrian blicken zufrieden auf das aus Glas gefertigte Instrument.\n");
  AddDetail(({"hutkrempe", "krempe"}),
	    "Die Hutkrempe des Filzhutes ist senkrecht nach oben gebogen.\n");
  AddDetail(("feder"),
	    "Die Feder auf dem Filzhut schimmert geheimnisvoll gruen.\n");
  AddDetail(({"statue von tirena", "tirena"}),
	    "Die Statue von Tirena besteht aus feinen, leuchtenden Kristall. Sie zeigt die Elfe "
	    +"Tirena auf einem Stein sitzend und die Lanara spielend. "
	    +"Sie traegt ein Toga mit einem "
	    +"huebschem Stickmuster darauf und an den Fuessen einfache, weiche Sandalen. "
	    +"Ihr Haar ist zu einem Zopf nach hinten geflochten und an ihren Armen traegt sie "
	    +"ein paar Armreifen. Sie scheint ganz in ihr Lanaraspiel vertieft zu sein.\n");
  AddDetail (({"hand von tirena", "haende von tirena"}),
	     "In ihren Haenden haelt Tirena die Lanara.\n");
  AddDetail(({"lanara", "floetenart"}),
	    "Die Lanara ist eine Floetenart.\n");
  AddDetail(("lanaraspiel"),
	    "Tirena scheint voellig in ihr Lanaraspiel vertieft zu sein.\n");
  AddDetail(({"elf", "elfe"}),
	    "Tirena war eine Elfe.\n");
  AddDetail(("stein"),
	    "Tirena sitzt auf einem Stein.\n");
  AddDetail(("toga"),
	    "Tirena traegt eine Toga auf der ein huebsches Stickmuster ist.\n");
  AddDetail(("stickmuster"),
	    "Das Stickmuster auf der Toga von Tirena zeigt viele kleine, verschiedenartige "
	    +"Eichenblaetter.\n");
  AddDetail(({"fuss","fuesse"}),
	    "An ihren Fuessen traegt Tirena weiche Sandalen.\n");
  AddDetail(("sandalen"),
	    "Es sind einfache weiche Sandalen aus Leder.\n");
  AddDetail(({"haar von tirena", "zopf"}),
	    "Das braune lange Haar von Tirena ist nach hinten zu einem Zopf geflochten.\n"); 
  AddDetail(({"arm", "arme"}),
	    "An ihren Armen traegt Tirena ein paar Armreifen.\n");
  AddDetail(({"armreifen", "armreife", "armreif", "silber"}),
	    "Die Armreifen von Tirena sind aus schoenstem Silber und funkeln unnatuerlich "
	    +"stark.\n");
  AddDetail(({"statue von korriax", "korriax"}),
	    "Die Statue von Korriax ist aus tiefschwarzem Quarz. Korriax, ein grosser "
	    +"kraeftiger Mensch, wird darauf "
	    +"in einer Eisenruestung, auf welcher sich ein Wappen befindet, gezeigt. "
	    +"Unter dem hochgeklapptem Visiers seines Helmes kann man sein entschlossenes "
	    +"Gesicht sehen. "
	    +"Mit seinen kraeftigen Haenden, in denen sich zwei Paukenschlegel befinden, "
	    +"scheint er gerade kraeftig auf seine umgeschnallte Gewitterpauke zu trommeln. "
	    +"Er steht auf einem boesen Daemon der sich unter ihm in Schmerzen "
	    +"zu winden scheint.\n");
  AddDetail (({"hand von korriax", "haende von korriax"}),
	     "In seinen Haenden haelt Korriax ein paar Paukenschlegel mit denen er auf "
	     +"seine umgeschnallte Gewitterpauke schlaegt.\n");
  AddDetail(("mensch"),
	    "Korriax war ein Mensch.\n");
  AddDetail(("quarz"),
	    "Der Quarz ist tiefschwarz.\n");
  AddDetail(({"eisenruestung", "ruestung", "koerper"}),
	    "Die Eisenruestung bedeckt den ganzen Koerper von Korriax. Irgendetwas an dieser "
	    +"Ruestung scheint ungewoehnlich zu sein.\n");
  AddDetail(("wappen"),
	    "Das Wappen auf Korriaxs Ruestung zeigt das Sternbild des Drachentoeters. Ein "
	    +"unheimliches Leuchten geht von ihm aus.\n");
  AddDetail(({"sternbild", "drachentoeter", "konstellation", "sterne" }),
	    "Das Sternbild des Drachentoeters ist eine Konstellation aus zwoelf Sternen. "
	    +"Es symbolisiert Mut und Furchtlosigkeit.\n");
  AddDetail(({"mut", "furchtlosigkeit"}),
	    "Mut und Furchtlosigkeit werden durch das Sternbild des Drachentoeters "
	    +"repraesentiert.\n");
  AddDetail(("leuchten"),
	    "Das unheimliche Leuchten geht von dem Wappen auf Korriaxs Ruestung aus.\n");
  AddDetail(({"helm", "eisenhelm"}),
	    "Korriaxs Helm ist ein schwerer Eisenhelm. Unter dem hochgeklappten Visier des "
	    +"Helmes kann man Korriaxs entschlossenes Gesicht erkennnen.\n");
  AddDetail(("visier"),
	    "Das Visier des Helmes ist hochgeklappt. So kann man des entschlossene Gesicht "
	    +"von Korriax erkennen.\n");
  AddDetail(({"gesicht", "entschlossenheit"}),
	    "Das Gesicht von Korriax ist ist von durchdringender "
	    +"Entschlossenheit gepraegt.\n");
  AddDetail(({"daemon", "schmerzen"}),
	    "Der Daemon windet sich unter Korriax in argen Schmerzen. Irgendetwas macht ihm "
	    +"arg zu schaffen.\n");
  AddDetail(({"schlegel", "paukenschlegel"}),
	    "Mit den Paukenschlegeln schlaegt Korriax auf die Gewitterpauke.\n");
  AddDetail(({"pauke", "gewitterpauke", "schlaginstrument", "toene"}),
	    "Die Gewitterpauke ist ein grosses Schlaginstrument mit dem man "
	    +"kraeftige laute tiefe Toene erzeugen kann.\n");
  AddReadDetail(({"tafeln", "tafel"}),
		"Unter jeder Statue kannst Du eine Tafel erkennen. Wenn Du "
		+"eine davon lesen willst, dann benutze diese Syntax:\n" 
		+"'lies tafel von <person>'.\n");
  AddDetail(("syntax"),
	    "Wow, Du untersuchst auch noch jedes so unsinige Wort, oder?\n");
  AddDetail(("wort"),
