inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create(); 
  SetProp(P_SHORT, "Ein weisses Kleid");
  SetProp(P_LONG, "Ein einfaches weisses Kleid ohne "
	  +"besondere Verzierungen wie es von Priesterinnen "
	  +"der Alinja getragen wird. Es ist vollstaendig aus "
	  +"Elfenseide gefertigt.\n");
  SetProp(P_NAME, "Kleid");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kleid", "weisses kleid"}));
  SetProp(P_MATERIAL, MAT_BAUSCH);
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 10);
}
