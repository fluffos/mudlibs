/* Customized Info Anzeige */

private string exhausted_text()
{
  int p;

  // Anzahl der verbleibenden Moving Points in Prozent:
  p = 100 * TP->QueryProp(P_MV) / TP->QueryProp(P_MAX_MV);

  switch (p)
  {
    case 0..5:   return "Du bist im Moment schwer erschoepft.";
    case 6..15:  return "Du bist ziemlich ausser Atem.";
    case 16..30: return "Du bist etwas erschoepft.";
    case 31..50: return "Du spuerst erste Anzeichen der Erschoepfung.";
    default:     return "";
  }
}

private string weight_text()
{
  int p;

  // Gewicht in Prozent ausrechnen:
  p = 100 * (TP->QueryProp(P_TOTAL_WEIGHT) - TP->QueryProp(P_WEIGHT) )
          / TP->QueryProp(P_MAX_WEIGHT);

  // Durch etwaige Antigewichte kann der Wert auch unter 0 sinken:
  if (p < 0) p = 0;

  switch (p)
  {
    case  0..50:  return "";
    case 51..60: return "Du traegst einiges Gewicht mit Dir herum.";
    case 61..70: return "Du bist ziemlich beladen.";
    case 71..80: return "Du bist schwer beladen.";
    case 81..90: return "Du bist sehr schwer beladen.";
    case 91..95: return "Du bist extrem schwer beladen.";
    case 96..100: return "Das schwere Gewicht zwingt Dich fast zu Boden.";
    default:     return "Du schleppst mehr als Du eigentlich tragen kannst.";
  }
}

private string score(string arg)
{
  string ret;
  mixed ind;
  int level, n;

  // Einzige Ausnahme von der Balkenanzeige: max. 20% vom naechsten Level
  if ((TP->LpLevel() == (TP->QueryProp(P_LEVEL)+1)) && (TP->LevelPerc(TP->LpLevel()+1) < 20))
    level = TP->QueryProp(P_LEVEL);
  else
    level = TP->LpLevel();

  ind = TP->QueryProp(P_ATTRIBUTES);

  if(TP->QueryProp(P_NO_ASCII_ART) || arg == "-k")
  {
    ret = sprintf(
      "Du bist: %s\n"+
      "%d Lebenspunkte (max: %d), %d Erfahrungspunkte\n"
      "%d Magiepunkte (max: %d), %d Abenteuerpunkte (max: %d)\n"
      "%d Attributpunkte, Stufe %d (%d Prozent zur Stufe %d)\n\n"
      "Ausdauer: %s, Kraft: %s\n"
      "Intelligenz: %s, Geschicklichkeit: %s\n",
      capitalize(TP->short() || "\n"),
      TP->QueryProp(P_HP), TP->QueryProp(P_MAX_HP),
      TP->QueryProp(P_XP),
      TP->QueryProp(P_SP), TP->QueryProp(P_MAX_SP),
      TP->QueryProp(P_QP), QM->QueryAllQP(),
      TP->QueryProp(P_AP),
      level, TP->LevelPerc( level + 1 ), level + 1,
      sprintf("%d (%+d)", ind[A_CON], TP->QueryAttributeOffset(A_CON)),
      sprintf("%d (%+d)", ind[A_STR], TP->QueryAttributeOffset(A_STR)),
      sprintf("%d (%+d)", ind[A_INT], TP->QueryAttributeOffset(A_INT)),
      sprintf("%d (%+d)", ind[A_DEX], TP->QueryAttributeOffset(A_DEX))
    );
  }
  else
  {
    ret = sprintf(
      "Du bist: %s"+
      "+-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-+\n"
      "| Lebenspunkte:      %3d (%3d) | Erfahrungspunkte: %10d |\n"
      "| Magiepunkte:       %3d (%3d) | Abenteuerpunkte: %4d (%4d) |\n"
      "| Attributpunkte:           %2d | Stufe %d [%-'.'*s] %d |\n"
      "+-=-=-=-=-=-=-=-=-=-=-=-=-=-=-+-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-+\n"
      "| Ausdauer:           %8s | Kraft:              %8s |\n"
      "| Intelligenz:        %8s | Geschicklichkeit:   %8s |\n"+
      "+-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-+\n",
      capitalize(TP->short() || "\n"),
      TP->QueryProp(P_HP), TP->QueryProp(P_MAX_HP),
      TP->QueryProp(P_XP),
      TP->QueryProp(P_SP), TP->QueryProp(P_MAX_SP),
      TP->QueryProp(P_QP), QM->QueryAllQP(),
      TP->QueryProp(P_AP),
      level,
      (n = 18 - strlen(to_string(level)) - strlen(to_string(level + 1))),
      sprintf("%'#'*s", TP->LevelPerc( level + 1 ) * n / 100, ""),
      level + 1,
      sprintf("%d (%+d)", ind[A_CON], TP->QueryAttributeOffset(A_CON)),
      sprintf("%d (%+d)", ind[A_STR], TP->QueryAttributeOffset(A_STR)),
      sprintf("%d (%+d)", ind[A_INT], TP->QueryAttributeOffset(A_INT)),
      sprintf("%d (%+d)", ind[A_DEX], TP->QueryAttributeOffset(A_DEX))
    );
  }

  return ret;
}

private string glvl_progress() {
  int percent, x;
  x=call_other(BARDENMASTER, "GetXpDifference", TP, 
               TP->QueryProp(P_XP));
  percent=10 - (10*x/XP_PER_LEVEL[TP->QueryProp(P_GUILD_LEVEL)-1]);
  if(percent < 0) percent = 0;
  if(percent > 10) percent = 10;

  if(TP->QueryProp(P_GUILD_LEVEL) < 15) {
    return sprintf(
      "%2d [%-'.'*s] %2d",
      TP->QueryProp(P_GUILD_LEVEL),
      10,
      sprintf("%'#'*s", percent, ""),
      TP->QueryProp(P_GUILD_LEVEL) + 1);
  } else {
    return sprintf("%' '18|s", "["+TP->QueryProp(P_GUILD_LEVEL)+"]");
  }
}

private string alignmentBar() {
  int align, i, pos;
  string ret;

  align = TP->QueryProp(P_ALIGN);
  if(align > 1000) align = 1000;
  else if(align < -1000) align = -1000;

  align += 1000;

  pos = 21 - ((int) (21 * (align/2000.0)));

  ret =  "Heilig [";
  for(i=0; i<pos; ++i) ret+= "-";
  ret += "#";
  for(i=1; i<(21-pos); ++i) ret += "-";
  ret += "] Satanisch";
  return ret;
}

