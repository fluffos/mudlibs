private string active_spells() {
  string ret;

  ret = sprintf("| [%s] %-25.25s [%s] %-25.25s |\n", (getReiseliedStatusDisplay()=="-"?" ":"X"), "Aller Welten Freund", (getShieldStatus(TP)=="------"?" ":"X"), protection_name());
  ret += sprintf("| [%s] %-25.25s [%s] %-25.25s |\n", (getZauberliedStatusDisplay()=="-"?" ":"X"), "Lied der Zauber", (getLorcaStatusDisplay()=="-"?" ":"X"), "Lorica der Musen");
  ret += sprintf("| [%s] %-25.25s [%s] %-25.25s |\n", (getLightStatus()=="-"?" ":"X"), "Ode an die Sterne", (getHeldenliedDisplay()=="-"?" ":"X"), "Ruf der Helden");
  ret += sprintf("| [%s] %-25.25s [%s] %-25.25s |\n", (present(SONG_REGENERATION, TP)?"X":" "), regeneration_name(), (getAttackStatusDisplay()=="-"?" ":"X"), passive_combat_name());
  ret += sprintf("| [%s] %-25.25s%30-s |\n", (getAuraChargeCountDisplay()=="--"?" ":"X"), aura_name(), "");
  return ret;
}

public int Info(string args) {
  string *strings, gift, ret, tmp, *ind;
  int i, val, sz;

  // aus base.c
  if (TP->QueryProp(P_GHOST)) {
    write("Im ewigen Leben gibt es keine Punkte.\n");
    return 1;
  }

  strings=({"","","",""});
  i=0;
  if (val=TP->QueryProp(P_POISON) ) {
    strings[i]=(val<4 ? "leicht vergiftet" : "vergiftet");
    i++;
  }
  if(TP->QueryProp(P_BLIND) ) {
    strings[i]="blind";
    i++;
  }
  if(TP->QueryProp(P_DEAF) ) {
    strings[i]="taub";
    i++;
  }
  if(TP->QueryProp(P_FROG) ) {
    strings[i]="ein Frosch";
    i++;
  }

  gift="";
  if( i ) {
    for( sz=0;sz<i;sz++)
      gift += strings[sz]+ (sz==i-1?".":(sz==i-2?" und ":", "));
    gift = "Du bist " + gift + "\n";
  }
  if ((tmp=exhausted_text()) != "")
    gift += tmp + "\n";
  if ((tmp=weight_text()) != "")
    gift += tmp + "\n";


  ret = score(args);

  ret += sprintf(
    "| Bardengilde (%7s) %s Inspiration: %s |\n",
    capitalize(TP->QueryProp(P_BARD_GROUP)),
    glvl_progress(),
    getInspirationString(TP)
    );
  ret += sprintf("|%61s|\n", "");
  ret += active_spells();
  ret += sprintf("|%61s|\n", "");
  if(TP->QuerySkill("sieben schritte") != 0) ret += sprintf("| Aktueller Begleiter: %38-s |\n", (TP->QueryProp(P_BARD_CHARMED)?TP->QueryProp(P_BARD_CHARMED)->Name(WER, 1):"niemand"));
  if(TP->QuerySkill("tanz der saebel") != 0 ||
     TP->QuerySkill("sturm der klingen") != 0)
       ret += sprintf("| Tanzende Waffe: %43-s |\n", (present(SONG_DANCING_ITEM, TP)&&objectp(TP->QueryProp(P_WEAPON))?TP->QueryProp(P_WEAPON)->Name(WER):"keine"));
  ret += "+-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-+\n";

  ret += sprintf("| %59|s |\n", alignmentBar());
  gift = implode(
    map_array(
      explode(gift, "\n"),
      lambda(({'x}), ({#'sprintf, "| %-59s |", 'x }) ) ), "\n");

  ret += break_string(gift, 0, "", BS_LEAVE_MY_LFS);
  ret += sprintf("| Vorsicht-Modus: %3d%:-40s |\n", 
                 TP->QueryProp(P_WIMPY),
                 (TP->QueryProp(P_WIMPY_DIRECTION) ? ", Fluchtrichtung: "+to_string(TP->QueryProp(P_WIMPY_DIRECTION)) : ""));
  ret += sprintf("| Alter: %-52s |\n", TP->get_age());
  ret += "+-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-+\n";
  ind = explode(break_string(TP->Forschung(), 59), "\n");
    for (i=0;i<sizeof(ind);i++)
      ret += sprintf("| %-59s |\n", to_string(ind[i]));
  ret += "+-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-+\n";
  TP->More(ret);
  return 1;
}