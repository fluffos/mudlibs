public void captureGrimValues() {
  mixed *hands;

  hands = environment(TO)->QueryProp(P_HANDS);
  heroPathSaveStringA = hands[0];
  heroPathSaveIntA    = hands[1];
  heroPathSaveStringB = hands[2];
}

public mixed* grimm_hands_override() {
  int iLevel, success, damage;
  string handsString;

  iLevel = environment(TO)->QueryProp(P_BARD_INSPIRATION_LEVEL);
  if(iLevel <= 0) {
    return ({heroPathSaveStringA, heroPathSaveIntA, heroPathSaveStringB}); // normale haende
  }

  success = environment(TO)->UseSkill(SK_HEROISM(HERO_GRIMM));
  switch(iLevel) {
    case 1: handsString = "mit grossen Faeusten"; break;
    case 2: handsString = "mit rieseigen Faeusten"; break;
    case 3: handsString = "mit den Pranken eines Riesen"; break;
    case 4: handsString = "mit den gewaltigen Pranken eines Riesen"; break;
    default: handsString = "mit der Verkoerperung von Grimms Faeusten"; break;
  }

  damage = heroPathSaveIntA + ((int) (iLevel*30*((float) success/MAX_ABILITY)));

  if(environment(TO)->QueryProp(P_TESTPLAYER))
    tell_object(environment(TO), sprintf("grimm_hands_override :: str = '%s' success = %d damage = %d\n", 
      handsString, success, damage));

  return ({handsString, damage, DT_BLUDGEON});

}

public void enableGrimm() {
  captureGrimValues();
  environment(TO)->Set(P_HANDS, symbol_function("grimm_hands_override", TO), F_QUERY_METHOD);
  tell_object(environment(TO), BS("Grimms Staerke faehrt dir in die Glieder. "
                                  "Deine Faeuste werden stark wie die eines Riesen!"));
}

public void disableGrimm() {
  environment(TO)->Set(P_HANDS, 0, F_QUERY_METHOD);
  tell_object(environment(TO), BS("Grimms Staerke verlaesst dich. Du wirst wieder klein und schwach."));
}

public void captureNogiValues() {
  heroPathSaveIntA = environment(TO)->QueryProp(P_BODY);
  if(environment(TO)->QueryProp(P_TESTPLAYER))
    tell_object(environment(TO), sprintf("brosche :: captureNogiValues :: body = %d\n", heroPathSaveIntA));
}

public int nogi_body_override() {
  int success, protectionSum, i, bodyNew;
  float bonus;
  object *armours, bard;

  if(!objectp(bard=environment(TO))) return heroPathSaveIntA;

  success = bard->UseSkill(SK_HEROISM(HERO_NOGI));
  bonus = (1 + bard->QueryProp(P_BARD_INSPIRATION_LEVEL)) * 0.05 * ((float) success/MAX_ABILITY);

  armours = bard->QueryArmours();
  for(i=0; i<sizeof(armours); ++i) {
    protectionSum += armours[i]->QueryProp(P_AC);
  }

  bodyNew = (int) (heroPathSaveIntA + protectionSum * bonus);

  if(bard->QueryProp(P_TESTPLAYER))
    tell_object(bard, sprintf("nogi_body_override :: success = %d totalProtection = %d bonus = %.2f body(old) = %d body(new) = %d\n",
                success, protectionSum, bonus, heroPathSaveIntA, bodyNew));

  return bodyNew;
}

public void enableNogi() {
  captureNogiValues();
  environment(TO)->Set(P_BODY, symbol_function("nogi_body_override", TO), F_QUERY_METHOD);
  tell_object(environment(TO), BS("Ein flackerndes leuchten durchfaehrt deine Ruestung. "
                                  "Nogis Heldenmacht verstaerkt ihren Schutz!"));
}

public void disableNogi() {
  environment(TO)->Set(P_BODY, 0, F_QUERY_METHOD);
  tell_object(environment(TO), BS("Nogis Heldenmacht verlaesst dich. Deine Ruestung wird wieder normal."));
}

