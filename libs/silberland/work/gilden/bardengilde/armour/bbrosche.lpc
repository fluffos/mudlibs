int bwer(string str)
{
 int i;
 object *spieler, p;
 string bards, group;
 bards="";
 write("\n.-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=.\n");  
 write("| Folgende Barden sind anwesend: |\n");
 write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="));

  spieler=filter_array(users(), "IsMember", BARDENMASTER);
  for(i=sizeof(spieler)-1;i>=0; i--) {    
    if(!spieler[i]->QueryProp(P_INVIS)) {
      group=CAP(call_other(BARDENMASTER,"GetBardGroup",spieler[i]));
      if(getuid(spieler[i]) == "gwenshara") continue;
      if(!stringp(group)) group="unbekannt";
      bards+= sprintf("%s(%d/%s), ", spieler[i]->Name(WER), spieler[i]->QueryProp(P_GUILD_LEVEL), group);
    }
  }

  if(objectp(p=find_player("gwenshara")) && !p->QueryProp(P_INVIS)) {
    bards += sprintf("%s(Soundmagier), ", p->Name(WER));
  }

  write(BS(bards+"\b\b\n"));
  write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=")); 
  return 1;
}

void init()
{
  object ob, pl;
  ::init();
  if(!living(MENV))
    call_out("remove",0);

  if( ((MENV->QueryProp(P_GUILD)!= "bardengilde")) &&
      (!IS_WIZARD(MENV)) )
    {
      write("Die Brosche loest sich auf einmal in Nichts auf!\n");
      call_out("remove",0);
      return 0;
    }
  
  pl = environment(this_object());
  if(this_player() != pl) return 0;

  DoWear();
  tell_object(pl, "Deine Kreativitaet beginnt langsam in Dir zu arbeiten.\n");
  pl->SetProp(P_WEAR_FUNC, TO);
  pl->SetProp(P_REMOVE_FUNC, TO); 

  if(query_once_interactive(pl)) {
    pl->AddHpHook(this_object()); // fuer "echte" Spieler gibt es den report
  }

  call_out("decreaseInspiration", 60);
}

public void decreaseInspiration() {
  object owner;
  int reduction, iLvl;

  owner = QueryProp(P_WORN);

  if(!objectp(owner)) {
    return;
  }

  if(time() - owner->QueryProp(P_BARD_LAST_INSPIRED) > 59) {
    iLvl = owner->QueryProp(P_BARD_INSPIRATION_LEVEL);
    reduction = iLvl * iLvl;
    if(iLvl>5) reduction += random(iLvl*2);
    call_other("/spellbooks/barden_spells", "accumulateInspiration", owner, -reduction);
  }

  if(interactive(owner)) {
    call_out("decreaseInspiration", 60);
  }
}

private string colorizeReport(string reportLine, int currentHp, int maxHp) {
  string color;
  int percentage;

  if(!isColorActive()) {
    return reportLine;
  }  

  percentage = (int) (((float) currentHp / (float) maxHp) * 100.0);
  switch(percentage) {
    case 0..20: color=ANSI_RED;
                break;
    case 21..40: color=ANSI_BLUE;
                break;
    case 41..60: color=ANSI_CYAN;
                break;
    case 61..80: color=ANSI_YELLOW;
                break;
    case 81..100: color=ANSI_GREEN;
                break;
    default: color=ANSI_NORMAL;
  }

  return sprintf("%s%s%s%s", ANSI_BOLD, color, reportLine, ANSI_NORMAL);
}

private string getReiseliedStatusDisplay() {
