int bwer(string str)
{
 int i;
 object *spieler, p;
 string bards, group;
 bards="";
 write("\n.-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=.\n");  
 write("| Folgende Barden sind anwesend: |\n");
 write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="));

  spieler=filter_array(users(), "IsMember", BARDENMASTER);
  for(i=sizeof(spieler)-1;i>=0; i--) {    
    if(!spieler[i]->QueryProp(P_INVIS)) {
      group=CAP(call_other(BARDENMASTER,"GetBardGroup",spieler[i]));
      if(getuid(spieler[i]) == "gwenshara") continue;
      if(!stringp(group)) group="unbekannt";
      bards+= sprintf("%s(%d/%s), ", spieler[i]->Name(WER), spieler[i]->QueryProp(P_GUILD_LEVEL), group);
    }
  }

  if(objectp(p=find_player("gwenshara")) && !p->QueryProp(P_INVIS)) {
    bards += sprintf("%s(Soundmagier), ", p->Name(WER));
  }

  write(BS(bards+"\b\b\n"));
  write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=")); 
  return 1;
}

void init()
{
  object ob, pl;
  ::init();
  if(!living(MENV))
    call_out("remove",0);

  if( ((MENV->QueryProp(P_GUILD)!= "bardengilde")) &&
      (!IS_WIZARD(MENV)) )
    {
      write("Die Brosche loest sich auf einmal in Nichts auf!\n");
      call_out("remove",0);
      return 0;
    }
  
  pl = environment(this_object());
  if(this_player() != pl) return 0;

  DoWear();
  tell_object(pl, "Deine Kreativitaet beginnt langsam in Dir zu arbeiten.\n");
  pl->SetProp(P_WEAR_FUNC, TO);
  pl->SetProp(P_WIELD_FUNC, TO); 

  if(query_once_interactive(pl)) {
    pl->AddHpHook(this_object()); // fuer "echte" Spieler gibt es den report
  }

  call_out("decreaseInspiration", 60);
}

public void decreaseInspiration() {
  object owner;
  int reduction, iLvl;

  owner = QueryProp(P_WORN);

  if(!objectp(owner)) {
    return;
  }

  if(time() - owner->QueryProp(P_BARD_LAST_INSPIRED) > 59) {
    iLvl = owner->QueryProp(P_BARD_INSPIRATION_LEVEL);
    reduction = iLvl * iLvl;
    call_other("/spellbooks/barden_spells", "accumulateInspiration", owner, -reduction);
  }

  if(interactive(owner)) {
    call_out("decreaseInspiration", 60);
  }
}

private string colorizeReport(string reportLine, int currentHp, int maxHp) {
  string color;
  int percentage;

  if(!isColorActive()) {
    return reportLine;
  }  

  percentage = (int) (((float) currentHp / (float) maxHp) * 100.0);
  switch(percentage) {
    case 0..20: color=ANSI_RED;
                break;
    case 21..40: color=ANSI_BLUE;
                break;
    case 41..60: color=ANSI_CYAN;
                break;
    case 61..80: color=ANSI_YELLOW;
                break;
    case 81..100: color=ANSI_GREEN;
                break;
    default: color=ANSI_NORMAL;
  }

  return sprintf("%s%s%s%s", ANSI_BOLD, color, reportLine, ANSI_NORMAL);
}

private string getReiseliedStatusDisplay() {
  object owner, ob;
  
  owner = QueryProp(P_WORN);
  if(!objectp(owner)) {
    return "-";
  }

  if(objectp(ob=present(SONG_TRAVELLER, owner))) {
    if(ob->CanRecharge()) return "r";
    return "R";
  }

  return "-";
}

private string getLorcaStatusDisplay() {
  object owner, ob;
  
  owner = QueryProp(P_WORN);
  if(!objectp(owner)) {
    return "-";
  }

  ob = present(SONG_MAGIC_WARD, owner);
  if(!objectp(ob)) {
    return "-";
  }

  if(ob->CanRecharge()) {
    return "l";
  } 

  return "L";
}

private string getAttackStatusDisplay() {
  object owner, ob;
  
  owner = QueryProp(P_WORN);
  if(!objectp(owner)) {
    return "-";
  }

  ob = present(SONG_PASSIVE_DMG, owner);
  if(!objectp(ob)) {
    return "-";
  }

  if(ob->CanRecharge()) {
    return "e";
  } 

  return "E";
}

private string getLightStatus() {
  object owner, ob;
  
  owner = QueryProp(P_WORN);
  if(!objectp(owner)) {
    return "-";
  }

  ob = present(SONG_STERNE, owner);
  if(!objectp(ob)) {
    return "-";
  }

  if(ob->CanRecharge()) {
    return "s";
  } 

  return "S";
}

private string getZauberliedStatusDisplay() {
  object owner, ob;
  
  owner = QueryProp(P_WORN);
  if(!objectp(owner)) {
    return "-";
  }
  ob = present(SONG_SPELLBUFF, owner);
  if(!objectp(ob)) {
    return "-";
  }

  if(ob->CanRecharge()) {
    return "z";
  } 

  return "Z";
}

private string getHeldenliedDisplay() {
  object owner, ob;
  
  owner = QueryProp(P_WORN);
  if(!objectp(owner)) {
    return "-";
  }
  ob = present(SONG_BUFF, owner);
  if(!objectp(ob)) {
    return "-";
  }

  if(ob->CanRecharge()) {
    return "h";
  } 

  return "H";
}

private string getAuraChargeCountDisplay() {
  object owner, aura;
  
  owner = QueryProp(P_WORN);
  if(!objectp(owner)) {
    return "--";
  }

  aura = present(SONG_SMALL_AURA, owner);
  if(!objectp(aura)) {
    return "--";
  }

  return sprintf("%2d", aura->getCharges());

}

private string getFlags(object owner) {
    string flags;
    int h;
    flags = "";

    if(owner->QueryProp(P_MV)*100/owner->QueryProp(P_MAX_MV)<10)
      flags+="M";
    else flags+="-";

    if(owner->QueryProp(P_DEAF))
      flags+="T";
    else flags+="-";

    if(owner->QueryProp(P_BLIND))
      flags+="B";
    else flags+="-";

    if(h=owner->QueryProp(P_POISON))
    {
      if(h<=3) flags+="v"; else flags+="V";
    }
    else flags+="-";

    if(owner->QueryProp(P_FROG))
      flags+="F";
    else flags+="-";

    if(h=owner->QueryProp(P_ALCOHOL))
    {
      if(h<=20) flags+="a"; else flags+="A";
    }
    else flags+="-";

    if(owner->QueryProp(P_PARALYZED))
      flags+="P";
    else flags+="-";

    if(objectp(present("\nsprachfluch", owner)))
      flags+="S";
    else flags+="-";

    if(time()<owner->QueryProp(P_NEXT_SPELL_TIME))
      flags+="N";
    else flags+="-";


    return flags;
}

int isBardicProtection(object ob) {
  if(!objectp(ob)) {
    return 0;
  }
  return ob->id(SONG_SCHUTZ);
}

private object findShield(object owner) {
  object *defenders;
  
  defenders = owner->QueryProp(P_DEFENDERS);
  if(!pointerp(defenders) || sizeof(defenders) == 0) {
    return 0;
  }

  defenders = filter_array(defenders, "isBardicProtection");
  if(sizeof(defenders) == 0) {
    return 0;
  }

  return defenders[0];
}

private string getShieldStatus(object owner) {
  object shield;
  int percentage;

  shield = findShield(owner);
  if(owner->QueryProp(P_GUILD_LEVEL) < 4 || !objectp(shield)) {
    return "------";
  }

  percentage = (int) (shield->QueryVolume() * 100.0 / shield->QueryMaxVolume());

  return sprintf("[%3d%%]", percentage);
}

private string getInspirationString(object owner) {
  string inspirationStr;
  int i;

  inspirationStr = "";
  for(i=0; i<owner->QueryProp(P_BARD_INSPIRATION_LEVEL); ++i) {
    inspirationStr += "#";
  }

  for(i=5; i>owner->QueryProp(P_BARD_INSPIRATION_LEVEL); --i) {
    inspirationStr += "-";
  }

  return inspirationStr;
}

#define REPORT_TEMPLATE "- LP: %3d/%3d (%s%3d) MP: %3d/%3d (%s%3d) -%s-[%s%s%s%s%2s%s%s]-[%s][%s]"
public void printReport(int force) {
  int currentHp, currentSp, maxHp, maxSp, hpDiff, spDiff;
  object owner;
  string reportLine, hpDiffSign, spDiffSign, hasZauberlied, auraCharges, hasReiselied,
         hasLorica, hasAttack;

  if(!isReportActive()) {
    return;
  }

  owner = QueryProp(P_WORN);
  if(!objectp(owner)) {
    return;
  }

  // Als Geist braucht man keinen Report, weil keine Stats
  if (owner->QueryProp(P_GHOST)) {
    return;
  }

  /* report nur 1 mal pro sekunde */
  if(lastReportTime == time() && !owner->InFight() && !force) {
    return;
  }
  lastReportTime = time();
  
  hasReiselied = getReiseliedStatusDisplay();
  hasZauberlied = getZauberliedStatusDisplay();
  auraCharges   = getAuraChargeCountDisplay();
  hasLorica     = getLorcaStatusDisplay();
  hasAttack     = getAttackStatusDisplay();
  
  currentHp = owner->QueryProp(P_HP);
  currentSp = owner->QueryProp(P_SP);
  maxHp     = owner->QueryProp(P_MAX_HP);
  maxSp     = owner->QueryProp(P_MAX_SP);
  hpDiff    = currentHp - lastHp;
  spDiff    = currentSp - lastSp;

  // keine aenderung, kein force, kein report
  if(!spDiff && !hpDiff && !force) {
    return;
  }

  if(hpDiff >= 0) {
     hpDiffSign = "+";
  } else {
    hpDiffSign = "-";
    hpDiff *= -1;
  }

  if(spDiff >= 0) {
    spDiffSign = "+";
  } else {
    spDiffSign = "-";
    spDiff *= -1;
  }

  reportLine = sprintf(REPORT_TEMPLATE, currentHp, maxHp, hpDiffSign, hpDiff, currentSp, maxSp, spDiffSign, 
    spDiff, getShieldStatus(owner), hasLorica, hasAttack, hasReiselied, hasZauberlied, auraCharges, 
    getLightStatus(), getHeldenliedDisplay(),
    getFlags(owner), getInspirationString(owner));

  reportLine = colorizeReport(reportLine, currentHp, maxHp);
  tell_object(owner, sprintf("%s\n", reportLine));

  lastHp = currentHp;
  lastSp = currentSp;
  return;
}

varargs void NotifyHpChange(int force) {
  if(interactive(QueryProp(P_WORN)) && find_call_out("decreaseInspiration") < 0) {
    call_out("decreaseInspiration", 60);
  }

  if(QueryProp(P_WORN)->InFight() || force) printReport(force);
  else call_out("printReport", 0, 0);
}


int Status(string args) {
  NotifyHpChange(1);
  return 1;
}

public void BecomesNetDead(object player) {
  if(player != QueryProp(P_WORN)) return;
  
  while(remove_call_out("decreaseInspiration") != -1);
}

public void BecomesNetAlive(object player) {
  if(player != QueryProp(P_WORN)) return;
  if(find_call_out("decreaseInspiration") == -1) {
    call_out("decreaseInspiration", 60);
  }
}
