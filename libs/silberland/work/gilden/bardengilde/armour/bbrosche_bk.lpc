inherit "std/armour";

#include "/gilden/bardengilde/bardengilde.h"
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <ansi.h>
#include <new_skills.h>


#define P_BARD_SHOW_REPORT "bard_show_report"

nosave object owner;
nosave string owner_name;
nosave int lastHP, lastSP, changedHP, changedSP;
nosave int aktiv=0;
nosave int teleportation=0;
nosave string *history=({});
nosave int lastReportTime=0;
string bardeninfo();

// for the report
int lastHp, lastSp;


create()
{
  if( !is_clone(TO) ) return;
  ::create();

  lastHp = 0;
  lastSp = 0;
  
  SetProp(P_SHORT, "Eine Bardenbrosche");
  SetProp(P_LONG, 
	  BS("Die Brosche hat die Form eines Notenschluessels und ist das Erkennungszeichen "
	     +"der Bardengilde. Die Brosche ist aus Kupfer und von einem "
	     +"leichten Schimmern umgeben.\n"));
  AddDetail(({"erkennungszeichen", "notenschluessel"}),
	    "Der Notenschluessel ist das Erkennungszeichen der Bardengilde.\n");
  AddDetail(("kupfer"),
	    "Ganz gewoehnliches Kupfer.");
  AddDetail(({"schimmern", "schutz"}),
	    "Das Schimmern scheint Dir etwas Schutz zu geben.\n"); 
  SetProp(P_NAME, "Bardenbrosche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"brosche", "bardenbrosche", "\nbardenbrosche"}) );
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_BRONCE:90, MAT_MISC_MAGIC:10]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_CURSED, 0);
  SetProp(P_INFO, "Mit 'bhilfe' siehst du, was du mit der Brosche machen kannst.");
  SetProp(P_WORN_TEXT, "angesteckt");
  SetProp(P_NO_DAMAGE_DESTRUCT, 1);
  
  AddCmd(({"bsinge", "bsing"}), "brufen");
  AddCmd(({"bwuschel", "bwuschle"}), "bwuschel");
  AddCmd(({"bbegruesse", "bhi"}), "bbegruesse");
  AddCmd ("bwer", "bwer");
  AddCmd(({"bwink", "bwinke"}), "bwinken");
  AddCmd(({"bknuddle", "bknuddel"}), "bknuddeln");
  AddCmd(({"bverneige", "bverneig"}), "bverneige");
  AddCmd(({"bnerve", "bnerv"}), "bnerve");
  AddCmd(({"bhist", "bhistory"}), "ShowHistory");
  AddCmd(({"breport", "brep"}), "Report");
  AddCmd(({"bfarben"}), "Colors");
  AddCmd(({"bstatus"}), "Status");
  AddCmd(({"bupdate"}), "Update");
  AddCmd(({"bhilfe"}), "Hilfe");
}


string bardeninfo()
{
  string text;
  text="Mit der Brosche kannst du folgende Aktionen ausfuehren:\n\n";
  text += "Kommunikiation:\n";
  text += sprintf("%-10s %s\n", "bsinge", "Teile anderen Barden etwas mit.");
  text += sprintf("%-10s %s\n", "bhist", "Sieh nach, was andere Barden dir mitgeteilt haben");
  text += "\nReport:\n";
  text += sprintf("%-10s %s\n", "breport", "Aktiviere oder deaktiviere den Bardenreport");
  text += sprintf("%-10s %s\n", "bfarben", "Aktiviere oder deaktiviere Farbausgabe.");
  text += "\nEmotes:\n";
  text += sprintf("%-10s %s\n", "bknuddel", "Knuddel alle anwesenden barden");
  text += sprintf("%-10s %s\n", "bwinke", "Winke den anderen Barden zu");
  text += sprintf("%-10s %s\n", "bwuschel", "Verwuschel die Haare der anwesenden Barden.");
  text += sprintf("%-10s %s\n", "bhi", "Gruesse die anwesenden Barden.");
  text += sprintf("%-10s %s\n", "bverneige", "Verneige dich vor allen anwesenden Barden.");
  text += sprintf("%-10s %s\n", "benrve", "Nerve anwesende Barden mit deinem Gesang.");
  text += "\nSonstiges:\n";
  text += sprintf("%-10s %s\n", "bupdate", "Hol dir eine neue Brosche.");
  text += sprintf("%-10s %s\n", "bwer", "Zeigt dir, welche Barden gerade online sind.");
  return text;
}

public int Hilfe() {
  write(bardeninfo());
  return 1;
}

public int Update() {
  object brosche, owner;
  if(!objectp(owner=QueryProp(P_WORN)))
  {
    write("Dazu musst du die Brosche tragen!\n");
    return -1;
  }
  
  brosche = clone_object(ARMOUR("bbrosche"));
  owner->Message(BSA("Hier hast du eine neue Brosche!", "Artyrian teilt Dir mit: "),MSGFLAG_TELL);
  TO->DoUnwear();
  brosche->move(owner);
  brosche->DoWear();
  brosche->SetProp(P_BARD_DISPLAY_COLOR, QueryProp(P_BARD_DISPLAY_COLOR));
  brosche->SetProp(P_BARD_SHOW_REPORT, QueryProp(P_BARD_SHOW_REPORT));
  TO->remove();
  return 1;
}


private int isColorActive() {
  object wearer;
  wearer = QueryProp(P_WORN);
  if(!objectp(wearer)) {
    return 0;
  }
  return wearer->QueryProp(P_BARD_DISPLAY_COLOR);
}

public int Colors(string args) {
  notify_fail("Aktiviere oder deaktiviere Farbunterstuetzung.\nsyntax: bfarben ein|aus\n");
  if(member(({"ein", "aus"}), args) == -1) return 0;

  if(args == "ein") {
    this_player()->SetProp(P_BARD_DISPLAY_COLOR, 1);
    write(BS("Farben ein."));
  } else {
    this_player()->SetProp(P_BARD_DISPLAY_COLOR, 0);
    write(BS("Farben aus."));
  }

  return 1;
}

private int isReportActive() {
  return QueryProp(P_BARD_SHOW_REPORT);
}

int Report(string args) {
  notify_fail("Aktiviere oder deaktiviere die Statusanzeige.\nsyntax: breport ein|aus\n");
  if(member(({"ein", "aus"}), args) == -1) return 0;

  if(isReportActive() && args == "ein") {
    write(BS("Der Bardenreport ist bereits aktiv!"));
    return -1;
  } else if(!isReportActive() && args == "aus") {
    write(BS("Der Bardenreport ist doch gar nicht aktiv!"));
    return -1;
  }

  if(args == "ein") {
    SetProp(P_BARD_SHOW_REPORT, 1);
    write(BS("Report ein."));
  } else {
    SetProp(P_BARD_SHOW_REPORT, 0);
    write(BS("Report aus."));
  }

  return 1;
}

string int2stars(int i)
{
  string str;
  str = "";
  for(;i>0;--i)
    str+="*";
  return str;
}

int WearFunc(object ob)
{
  if ( (TP->QueryProp(P_GUILD)!= "bardengilde") &&
       (!(IS_WIZARD(TP))) )
    {
      write("Die Bardenbrosche verschwindet ploetzlich!\n");
      call_out("remove",0);
      return 1;
    }    
  return 1;
}

int WieldFunc(object ob)
{
  if( (TP->QueryProp(P_GUILD)!= "bardengilde") &&
      (!(IS_WIZARD(TP))) )
    {
      write("Was machst DU denn mit einer Bardenbrosche?\n");
      call_out("remove",0);
      return 1;
    }
  return 1; 
}

int ShowHistory()
{
  int i;
 string *msgs;
 write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"  
	  +"=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="));
 write(BS("Folgendes haben Dir die Barden mitgeteilt:\n"));
 write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"  
	  +"=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="));
 for(i=0;i<=sizeof(history)-1;i++) {
   msgs=explode(history[i],"&&*%%");
   write(BS(msgs[0]));
   write(BSA(msgs[2], msgs[1]));
 }
 write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"  
	  +"=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="));
 return 1;
}

int AddHistory(string presay, string msg)
{
  int i;
  string timestring;
  timestring=dtime(time())[19..26];
  if(sizeof(history)>5)
    history-=({history[0]});
  history+=({implode(({timestring, presay, msg}), "&&*%%")});
  return 1;
}

mixed QueryHistory()
{
  return history;
}

int isPlayerIgnoringCall(object spieler) {
  string *ignores;
  ignores = spieler->QueryProp(P_IGNORE);

  if(sizeof(ignores) && (member(ignores, "bsinge")!=-1 || member(ignores, "bsing")!=-1)) {
    return 1;
  }

  return 0;
}

int isPlayerPosessingGuildItem(object spieler) {
  return objectp(present(BARDENBROSCHE, spieler));
}

int isPlayerBard(object spieler) {
  return spieler->QueryProp(P_GUILD) == "bardengilde";
}

int isPlayerEligibleForCall(object spieler) {
  if(isPlayerIgnoringCall(spieler)) {
    return 0;
  }

  if(IS_WIZARD(spieler) && isPlayerPosessingGuildItem(spieler)) {
    return 1;
  }

  if(isPlayerBard(spieler) && isPlayerPosessingGuildItem(spieler)) {
    return 1;
  }

  return 0;
}

private int isNumberOne(object pl) {
  string *number_one;

  number_one = call_other(BARDENMASTER, "QueryNumberOne");
  if(number_one == 0) {
    return 0;
  }

  return member(number_one, getuid(TP)) != -1;
}

string* getCallPresay(object player) {
  if(member(({"andyl", "gwenshara"}), getuid(TP)) != -1) {
    return ({"Soundmagier ", "Soundmagier "});
  }

  if(isNumberOne(this_player())) {
    return ({"Meisterbarde ", "Meisterbardin "});
  }
  
  return ({"Barde ", "Bardin "});
}

private void addToHistory(string prefix, string text, object pl) {
  object guildItem;

  guildItem = present(BARDENBROSCHE, pl);
  if(objectp(guildItem)) {
    guildItem->AddHistory(prefix, text);
  }
}

private void callToPlayer(string *presay, object currentPlayer, object target) {
  string prefix;
  prefix = presay[currentPlayer->QueryProp(P_GENDER)-1] + CAP(getuid(TP))+" teilt euch mit: ";

  addToHistory(prefix, currentPlayer->_unparsed_args(), target);
  tell_object(target, BSA(currentPlayer->_unparsed_args(), prefix));
  return;
}

int brufen(string str)
{
  int i, no_msg;
  object *spieler;
  string *presay, pre;
  object amulett;
  no_msg=0;
  notify_fail("Was moechtest Du denn den Barden mitteilen?\n");

  if (!stringp(str)) return 0;
  spieler=users();
  
  presay = getCallPresay(this_player());

  for(i=sizeof(spieler)-1;i>=0; i--) {
    if(spieler[i]==TP) {
      write(break_string(TP->_unparsed_args(), 78,  "Du teilst den Barden mit: "));
      addToHistory("Du teilst den Barden mit: ", this_player()->_unparsed_args(), this_player());
    } else if(isPlayerEligibleForCall(spieler[i])) {
      callToPlayer(presay, this_player(), spieler[i]);
   }
  }

  return 1;
}

int bknuddeln(string str)
{
  int i;
  object *spieler, amulett;
  spieler=users();
  for(i=sizeof(spieler)-1;i>=0; i--)
    {    
      if ( ((spieler[i]->QueryProp(P_GUILD)=="bardengilde")) ||
	   ((IS_WIZARD(spieler[i])) && (amulett=present(BARDENBROSCHE, spieler[i]))) ) 
	{
	  if(spieler[i]==TP)
	    write(BS("Du knuddelst alle anwesenden Barden aus "
		     +"der Ferne."));
	  else 
	    {
	      if(getuid(TP)=="andyl")
		{
		  tell_object(spieler[i], sprintf("Soundmagier Andyl "
						  +"knuddelt Dich aus der Ferne.\n", TP->name()));
		}
	      else
		{
		  if(TP->QueryProp(P_GENDER)==MALE)
		    tell_object(spieler[i], sprintf("Dein Bardenkollege %s "
						    +"knuddelt Dich aus der Ferne.\n", TP->name()));
		  else 
		    tell_object(spieler[i], sprintf("Deine Bardenkollegin %s "
						    +"knuddelt Dich aus der Ferne.\n", TP->name()));
		}
	    }
	}      
    }
  return 1;
}



