inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create(); 
  SetProp(P_SHORT, "Ein roetlicher Guertel");
  SetProp(P_LONG, "Ein .\n"
	  +"Ein roetlicher Guertel. Er besteht aus einem dunkelrotem "
	  +"Leder, die Guertelschnalle aus Rubin. Abgesehen "
	  +"davon, dass er wahrscheinlich sehr wertvoll ist scheint er "
	  +"auch etwas magisches an sich zu haben.\n"
	  +"un.\n");
  SetProp(P_NAME, "Guertel");
  SetProp(P_INFO, "Der Guertel schuetzt den Traeger vor Feuer.\n"); 
  SetProp(P_GENDER, MALE);
  AddId(({"guertel", "roetlicher guertel"}));
  SetProp(P_MATERIAL, ([MAT_LEATHER:80, MAT_RUBY:20]));
  SetProp(P_WEIGHT, 250);
  SetProp(P_MAGIC, 1);
  SetProp(P_VALUE, 4000);
  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 3);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if ((member(dam_type, DT_FIRE) != -1))
    {
      if( !random(3) )
        tell_object (QueryProp(P_WORN), 
		     "Der Guertel leuchtet feuerrot auf!\n");
    }
  return 0;
}




