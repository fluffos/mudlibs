inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create(); 
  SetProp(P_SHORT, "Ein Aquamarinstirnband");
  SetProp(P_LONG, "Eine praechtiges Aquamarinstirnband.\n"
	  +"So ein Stirnband muss von einem wahrem Meister gefertigt "
	  +"worden sein. Es ist vollkommen glatt und hat nicht einmal den "
	  +"kleinsten Kratzer. Seit ueber tausend Jahren werden solche "
	  +"Stirnbaender nicht mehr hergestellt. Es muss also sehr alt sein "
	  +"und ausserdem sehr wertvoll.\n");
  SetProp(P_NAME, "Aquamarinstirnband");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INFO, "Dieses Stirnband schuetzt den Traeger vor Wasser und "
	  +"Kaelteattacken. Ausserdem ist es unzerstoerbar.\n");
  AddId(({"stirnband", "band", "aquamarinstirnband"}));
  SetProp(P_MATERIAL, MAT_AQUAMARINE);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 9);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if ((member(dam_type, DT_COLD) != -1) || 
      (member(dam_type, DT_WATER) != -1 ))
    {
      if( !random(2) )
        tell_object (QueryProp(P_WORN), 
		     "Dein Stirnband blitzt grellblau auf!\n");
    }
  return 0;
}



