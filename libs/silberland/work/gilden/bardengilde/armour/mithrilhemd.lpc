inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create(); 
  SetProp(P_SHORT, "Ein Mithrilhemd");
  SetProp(P_LONG, "Ein hervorragend gefertigtes Mithrilhemd.\n "
	  +"Es ist ausgesprochen leicht und extrem widerstandsfaehig. "
	  +"Es ist mit hoher Wahrscheinlichkeit eine Zwergenarbeit. "
	  +"Es weisst keine Verzierungen oder magischen Muster auf.\n");
  SetProp(P_NAME, "Mithrilhemd");
  SetProp(P_GENDER, NEUTER);
  AddId(({"hemd", "mithrilhemd"}));
  SetProp(P_MATERIAL, MAT_MITHRIL);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 1000);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 15);
}




