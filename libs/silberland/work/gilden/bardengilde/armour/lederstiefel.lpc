inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create(); 
  SetProp(P_SHORT, "Ein Paar aussergewoehnliche Lederstiefel");
  SetProp(P_LONG, "Ein Paar aussergewoehnliche Lederstiefel.\n "
	  +"Augenscheinlich kannst Du nichts besonderes an ihnen "
	  +"erkennen. Aber Du kannst foermlich spueren das sie "
	  +"irgendeine magische Eigenschaft in sich tragen.\n");
  SetProp(P_NAME, "Lederstiefel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"stiefel", "lederstiefel", "aussergewoehnliche lederstiefel"}));
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_MAGIC, 1);
  SetProp(P_INFO, "Diese Lederstiefel schuetzen gegen alle Arten von "
	  +"Blitzen.\n");
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 5);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if ((member(dam_type, DT_LIGHTNING) != -1))
    {
      if( !random(2) )
        tell_object (QueryProp(P_WORN), 
		     "Deine Stiefel vibrieren ploetzlich!\n");
    }
  return 0;
}



