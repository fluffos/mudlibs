
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../barden_extern.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create(); 
  SetProp(P_SHORT, "Ein Barett mit Feder");
  SetProp(P_LONG, "Dieses schwarze Barett wirkt extrem mondaen und en vouge. Besonders mit "
                  "der roten Feder die daran baumelt. Eine brozefarbene Note wurde als Schmuck "
                  "daran gehaengt. Es scheint wie fuer einen Barden gemacht.");
  SetProp(P_NAME, "Barett"); 
  SetProp(P_GENDER, MALE);
  AddId(({"barett", "filzhut"}));
  SetProp(P_MATERIAL, MAT_FELT);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 800);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 4);
  SetProp(P_BARDEN_SPELLCOST, 10);
}




