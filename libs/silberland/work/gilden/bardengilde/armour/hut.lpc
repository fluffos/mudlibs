inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create(); 
  SetProp(P_SHORT, "Ein Filzhut");
  SetProp(P_LONG, "Dieser Filzhut scheint eine Nachbildung "
	  +"jenes Hutes zu sein, den Sarrian Glasfuss besessen hat. "
	  +"Dieser Hut scheint jedoch keine magischen Faehigkeiten zu "
	  +"besitzen.\n");
  SetProp(P_NAME, "Filzhut"); 
  SetProp(P_GENDER, MALE);
  AddId(({"hut", "filzhut"}));
  SetProp(P_MATERIAL, MAT_FELT);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 2);
}




