inherit "std/inpc";
inherit "std/spellbook";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <inpc.h>
#include "/gilden/bardengilde/bardengilde.h"

query_prevent_shadow() { return 1; }

void create()
{
  object ob; 
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Artyrian der Meisterbarde");
  SetProp(P_LONG,
          "Artyrian ist ein grosser schlanker Elf, der "
	  +"einen ziemlich edlen Eindruck auf Dich macht. Er traegt "
          +"ein Lanara bei sich und eine eigenartige, silbern glitzernde "
	  +"Kleidung. Um seine Huefte ist ein roetlicher Guertel geschnallt, "
	  +"welcher eine Guertelschnalle aus Rubin besitzt. "
	  +"Artyrian ist auch das Oberhaupt der Bardengilde und "
	  "scheint sehr viel ueber Musik zu wissen. Von ihm "
	  +"kann man sicher eine Menge lernen.\n");
  SetProp(P_NAME, "Artyrian");
  SetProp(P_GENDER, MALE);
  AddId(({"artyrian", "barde", "meisterbarde", "elf", "\nartyrian"}));
  set_living_name("artyrian");
  
  create_default_npc(50);
  SetProp(P_GUILD, "bardengilde");
  SetProp(P_GUILD_LEVEL, 12);
  ModifySkill(SK_SINGING,10000);
  ModifySkill(SK_MUSIC,10000);
  SetProp(P_XP, QueryProp(P_XP)+100*100);
  SetProp(P_HANDS, ({" mit geschickten Schlaegen",300,DT_BLUDGEON}));
  SetProp(P_XP, QueryProp(P_XP)); // Bonus fuer Spells
  SetProp(P_RACE, "elf");
  SetProp(P_BODY, 350);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,20);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 80);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Du bist eine Kunstbanause, %s!");
  SetProp(P_KILL_NAME, "Artyrian");
  SetProp(P_KILL_MSG, "Du hast es nicht anders gewollt!");
  SetProp(P_SPELLRATE, 80);

  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("artyrian.lib"), 1);

  SetAttackChats(10, ({ 
    "@@Attackchat1@@",
      "@@Attackchat2@@",
      "@@Attackchat3@@",
      "@@Attackchat4@@"}) );

  AddInfo(({"neuer brosche", "neuer bardenbrosche"}), "@@NewBrosche@@", 
	  "sagt: ");
 
  // INFOS ZUM GILDENBEITRITT

  AddInfo(({"empfehlungsschreiben", "schreiben"}),
	  "Ein Empfehlungsschreiben koenntest Du bei Serona bekommen. "
	  +"Sie ist eine Musiklehrerin in Elessar und ausserdem eine gute Freundin "
	  +"von mir. Vielleichtz kann sie Dir ja weiterhelfen.", "sagt: ");
  AddInfo(({"beitritt", "gildenbeitritt"}),
	  "Wenn Du den Barden beitreten willst musst Du ein Empfehlungsschreiben "
	  +"besitzen. Wenn Du ein solches hast, kannst Du den Barden mit "
	  +"<tritt barden von alestra/tirena/sarrian/korriax bei> beitreten, je "
	  +"nachdem fuer welche Gildenrichtung Du Dich entscheidest.","sagt: ");
  AddInfo(("hilfe"),
	  "Wie kann ich Dir denn helfen?\n", "meint: ");
  AddInfo(DEFAULT_INFO,
	  ({"belehrt Dich: Da hilft Dir nur viel Uebung.\n",
	      "meint: Ist das etwa wichtig?\n",
	      "versucht den Sinn deiner Worte zu begreifen.\n",
	      "spielt geistesabwesend eine kleine Melodie.\n",
	      "sagt: Davon hab ich keine Ahnung.\n",
	      "sagt: Erzaehl mir mehr darueber.\n", 
	      "sagt: Ich glaube nicht, dass das wichtig ist.\n", 
	      "sagt: Davon weisst du sicher mehr als ich.\n",
	      "sagt: Das scheint nichts mit Musik zu tun zu haben.\n"
	      }));

  AddInfo( ({"sei hier gast", "essenslied"}), "@@sei_hier_gast_info@@", "sagt: ");
  
  SetProp(P_LOG_INFO, "artyrian.log");
  
  ob=CLONEOB(ARMOUR("mithrilhemd"));
  ob->SetProp(P_AC, 40);
  ob->move(TO, M_NOCHECK);
  CLONEME(ARMOUR("guertel"));
  CLONEME(ARMOUR("lederstiefel"));
  CLONEME(INSTRUMENT("lanara"));
  CLONEME(ARMOUR("bbrosche"));
  command_me("trage alles");
  
  SetChats(2, ({
    "Artyrian meint: Die Bardengilde ist ein einzigartiges Erlebnis.\n",
      "Artyrian spielt gedankenverloren eine kleine Melodie.\n",
      "Artyrian sieht sich ein paar Notenhefte an.\n",
      "Artyrian mustert Dich eine zeitlang.\n",
      "Artyrian gruebelt eine Weile vor sich hin.\n"
      "Artyrian stimmt gewissenhaft sein Instrument.\n"
      }) );
} 

public string sei_hier_gast_info() {
  string str;

  str = "Das Lied 'Sei hier Gast' ist ein besonderer Lobgesang auf die Guete "
        "und Qualitaet der Speisen und Getraenke eines Wirten. Ein Barde, der "
        "dieses Lied beherrscht, legt mit diesem Zauberlied eine vollsesnsorische "
        "Illusion ueber die Kueche einer Kneipe. Das sorgt dafuer, dass die "
        "dort zubereiteten Speisen und Getraenke weniger rasch saettigen, und, "
        "wenn der Barde ein Meister dieses Lieds ist, auch fuer bessere Erholung "
        "sorgen.";

  if(TP->QueryProp(P_GUILD) == "bardengilde" && TP->QuerySkill("sei hier gast") == 0 &&
     !objectp(present(BARD_ID_GS10_TASK, TP))) {
       str += "\nUm dieses Lied zu erlernen solltest du von erlesendsten Speisen "
              "des Silberlands gekostet haben. Hier habe ich eine Liste genau dieser "
              "Dinge. Koste von jedem etwas, dann wirst du verstehen, wie dieses Lied "
              "zu singen ist!";
       call_out("give_sei_hier_gast_quest", 0, TP);
     } 

  return str;
}

public void give_sei_hier_gast_quest(object who) {
  object ob;

  if(!present(who, ENV(TO))) {
    command_me("emote sieht sich verwirrt um, da " + who->name(WER, 1) + " gar nicht mehr da ist.");
    return;
  }

  ob = clone_object(OBJ("quest/gs10_essensliste"));
  if(ob->move(who, M_GET) != 1) {
    command_me("sag Ohje, " + TPN + "! Komm doch wieder, wenn du meine Liste mit Spezialitaeten tragen kannst.");
    ob->remove(1);
    return;
  }

  tell_room(ENV(TO), BS(TO->Name(WER, 1) + " gibt "+who->name(WEM, 1) + " einen Zettel."), ({who}));
  tell_object(who, BS(TO->Name(WER, 1) + " drueckt dir eine Liste mit Spezialitaeten in die Hand."));
  return;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "wirft Dir einen finsteren Blick zu",
	       "wirft "+TP->name(WEN)+" einen finsteren Blick zu");
      break;

    case "aergerlich":
      call_out("react", 0, "sieht Dich zornig an", 
	       "sieht Dich zornig an");
      break;

    case "traurig":
      call_out("react", 0, "troestet Dich: Es wird schon wieder werden",
	       "troestet "+TP->name(WEN)+": Es wird schon wieder werden");
      break;

  case "albern":
    call_out("react", 0, "kann sich ein Grinsen nicht verkneifen",
	     "kann sich ein Grinsen ueber "+TP->name(WEN)+" nicht verkneifen");
      break;
      
  case "neutral":
    call_out("react", 0, "sieht Dich ausdruckslos an", "sieht "+TP->name(WEN)+" ausdruckslos an");
    break;
    
  case "intim":
    if (TP->QueryProp(P_GENDER)==MALE)
      call_out("react", 0, "sagt genervt: Lass das",
	       "sagt genervt: Lass das, "+TP->name(WEN));
    if (TP->QueryProp(P_GENDER)==FEMALE)
      call_out("react", 0, "meint laechelnd: Nicht so stuermisch Verehrteste",
	       "meint laechelnd zu "+TP->name(WEN)+": Nicht so stuermisch Verehrteste");     
    break;
    
  case "froh":
    call_out("react", 0,
	     "spielt ploetzlich ein froehliches Lied",
	     "spielt ploetzlich ein froehliches Lied");
    break;
    
  case "aengstlich":
    call_out("react", 0, "spielt Dir ein kleines Lied zur Aufmunterung vor",
	     "spielt "+TP->name(WEM)+" ein kleines Lied zur Aufmunterung vor");
    break;
      
  case "frech":
    call_out("react", 0, "blickt Dich tadelnd an", "blickt "+TP->name(WEN)+" tadelnd an");
    break;
    
  case "nett":
    call_out("react", 0, "klopft Dir freundschaftlich auf die Schulter", "klopft "+TP->name(WEN)
	     +" freundschaftlich auf die Schulter");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


string NewBrosche()
{
 object ob;
 if( (TP->QueryProp(P_GUILD)!="bardengilde") && (!IS_WIZARD(TP)) )
   return "Du bist kein Mitglied der Bardengilde.";
 if(!ob=present("\nbardenbrosche", TP))
   {
     call_out("GiveBrosche",0, TP);
     return "Huch! Du scheinst Deine Brosche verloren zu haben. "
       +"Hier, nimm eine Neue.";
   }
 ob->SetProp(P_CURSED, 0);
 ob->remove();
 call_out("GiveBrosche",0, TP);
 return "Hier hast Du eine neue Bardenbrosche.";
}

void GiveBrosche(object pl)
{
 object ob;
 write("Artyrian gibt Dir eine neue Bardenbrosche.\n");
 tell_room(ENV(TP),BS("Artyrian gibt "+CAP(getuid(TP))+" eine Brosche.\n"),
             ({TP}));
 call_other(ENV(TO), "UnWearArmour", TP);
 ob=CLONEOB(ARMOUR("bbrosche"));
 ob->move(TP, M_NOCHECK);
 return;
}





/* AttackChats Attacken! */ 
string AttackLight()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Anvar laesst Feuer auf "
      + capitalize(en->name()) + " niederprasseln."), ({en}));
    tell_object(en, "Anvar laesst Feuer auf Dich niederprasseln.\n");
    en->Defend(100+random(300), DT_FIRE,
        ([SP_NAME:"Feuerregen", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

string AttackMedium()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Anvar laesst Erzbrocken auf "
      + capitalize(en->name()) + " niederprasseln."), ({en}));
    tell_object(en, "Anvar laesst Erzbrocken auf Dich niederprasseln.\n");
    en->Defend(200+random(400), DT_BLUDGEON,
        ([SP_NAME:"Erzbrocken", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

string AttackSerious()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Anvar laesst toetliche Eisbrocken auf "
      + capitalize(en->name()) + " niederprasseln."), ({en}));
    tell_object(en, "Anvar laesst toetliche Eisbrocken auf Dich "
      +"niederprasseln.\n");
    en->Defend(300+random(500), DT_COLD,
        ([SP_NAME:"Eisbrocken", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

string AttackBlast()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Anvar beschwoert das Element Humus und "
      + "vergiftet "+capitalize(en->name()) + "."), ({en}));
    tell_object(en, "Anvar beschwoert das Element Humus und vergiftet Dich.\n");
    en->AddPoison(random(7)+1);
  }
  return "";
}




void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG ("kills"),
	       sprintf( ctime()+": Artyrian hat gerade "+CAP(getuid(player))
			+" umgebracht - %d EP!\n", lostexp));
  return ;
}

void die(int poisondeath)
{
 object ob;
 write_file(LOG("kills"),
	    dtime(time())+": "+CAP(getuid(TP))+" toetet Artyrian.\n");
 ::die(poisondeath);
}
