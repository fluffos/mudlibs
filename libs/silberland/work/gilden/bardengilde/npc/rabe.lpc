#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <class.h>
#include <moredef.h>
#include "../bardengilde.h"

inherit "std/npc";
inherit "/std/npc/spells";

object enemy, fearctrl;
mapping sinfo;
float factor;
object caster;
int ability;
int success;

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein zerzauster Rabe");
  SetProp(P_LONG,
    "Dieser Rabe sieht unheimlich zerzaust und wild aus. Seine Augen funkeln "
    "mit einem Schimmer des Wahnsinns. Zusaetzlich kommt dir vor, dass er nicht "
    "ganz materiell ist. So als waere er nur ein Traum, der vor dir flimmert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Rabe");
  SetProp(P_GENDER, MALE);
  AddId(({"rabe", SONG_DREAMRAVEN}));
  AddClass( ({CL_FLYING}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(3);

  SetProp(P_HANDS, ({" mit seinem Schnabel",
                    QueryProp(P_HANDS)[1],
                    ({DT_AIR, DT_LIGHTNING})
                    }) );

  SetProp(P_RACE, "Illusion");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" faellt einfach durch den Raben hindurch.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.1,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "loest sich auf");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " zerfliesst zu Traumstaub.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NOATTACK, " laesst deinen Angriff einfach durch sich hindurch gleiten. Als waere er gar nicht echt!\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " kraechzt: Nimmermehr!\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 1000);

}

public mixed DefendOther(int dam,mixed dam_type,mixed spell,object _enemy) {
  if(!objectp(enemy) || objectp(enemy) && !present(enemy, ENV(TO))) {
    if(objectp(fear)) {
      tell_room(ENV(TO), BS(Name(WER)+" hoert auf zu sprechen."));
      fear->remove(1);
    }
    command_me("emote richtet seinen Blick auf "+enemy->Name(WEN)+" und beginnt zu sprechen.");
    enemy = _enemy;
    call_out("start_haunt", 0);
  }
  return ({dam, dam_type,spell});
}

public void start_haunt() {
  object fear;
  fear = 
}

public void Setup(object _caster, int _ability, int _success, float _factor, mapping _sinfo) {
  sinfo = _sinfo;
  factor = _factor;
  caster = _caster;
  ability = _ability;
  success = _success;

  tell_room(ENV(TO), BS("Der Rabe setzt sich auf die Schulter von "+caster->name(WEM)+"."), ({caster}));
  tell_object(caster, BS("Der Rabe setzt sich auf deine Schulter."));

  caster->AddPursuer(TO);
  caster->AddDefender(TO);
}