inherit "std/inpc";
inherit "std/spellbook";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <inpc.h>
#include "/gilden/bardengilde/bardengilde.h"

query_prevent_shadow() { return 1; }

void create()
{
  object ob; 
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Brabo Glasfuss");
  SetProp(P_LONG,
          "Brabo Glasfuss ist ein ziemlich grosser Hobbit.\n"
          +"Er hat eine sehr dichte und sehr gepflegt wirkende Haarpracht "
	  +"an den Fuessen und ueberaus geschickte Haende. Er scheint einen "
	  +"sehr angenehmen und gemuetlichen Charakter zu besitzen, hat eine "
	  +"drollig wirkende Knollnase und ein freundliches Laecheln auf den "
	  +"Lippen. Man sagt, dass er aus der Familie Sarrians sei und ein "
	  +"ueberaus talentierter Instrumentenbauer ist. Von ihm kann man sicher "
	  +"viel ueber Instrumente erfahren.\n");
  SetProp(P_NAME, "Brabo");
  SetProp(P_GENDER, MALE);
  AddId(({"brabo", "glasfuss", "brabo glasfuss", "hobbit"}));
  set_living_name("brabo");
  create_default_npc(40);
  SetProp(P_GUILD, "bardengilde");
  SetProp(P_GUILD_LEVEL, 12);
  ModifySkill(SK_SINGING,10000);
  ModifySkill(SK_MUSIC,10000);
  SetProp(P_HANDS, ({" mit geschickten Faustschlaegen", 200, DT_SLASH}));
  SetProp(P_RACE, "hobbit");
  SetProp(P_BODY, 320);
  SetProp(P_SIZE, 120);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Du ruehrst mein Essen nicht mehr an!");
  SetProp(P_MURDER_MSG, "Ich hasse solche Banausen wie Dich, %s!");
  SetProp(P_KILL_NAME, "Brabo Glasfuss");  
  
  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("brabo.lib"), 1);
  
  AddInfo(DEFAULT_INFO,
	  ({"sagt: Achja? Das ist sicher eine Ueberlegung wert.\n",
	      "sagt: Davon hab ich ja noch nie gehoert.\n",
	      "meint: Das hoert sich nicht so an als haette es mit Instrumenten zu tun.\n",
	      "fragt erstaunt: Kann man das vielleicht essen?\n",
	      "sagt: Das kann sicher nichts wichtiges sein.\n",
	      "sagt: Frag mich lieber etwas ueber Instrumente, darueber weiss ich mehr.\n", 
	      "sagt: Davon weiss ich nichts, aber die Kneipen in Derlim "
	      +"sind echt zu empfehlen.\n", 
	      }));
  AddInfo( ({"erste strophe", "erster strophe", "strophe 1", "erste strophe von aller welten freund",
             "erster strophe von aller welten freund", "strophe 1 von aller welten freund"}), "@@awf_first_verse@@", "sagt: ");
  ob=CLONEOB(ARMOUR("mithrilhemd"));
  ob->SetProp(P_AC, 30);
  ob->move(TO, M_NOCHECK);
  CLONEME(ARMOUR("hut"));
  CLONEME(ARMOUR("lederstiefel"));
  CLONEME(INSTRUMENT("trabok"));
  CLONEME(ARMOUR("bbrosche"));
  command_me("trage alles");
  

  SetChats(2, ({
    "Brabo holt aus einem Versteck etwas zu essen hervor.\n",
      "Brabo sieht sich gewissenhaft eine Lanara an.\n",
      "Brabo murmelt irgendetwas von total verstimmten Instrumenten.\n",
      "Brabo raucht genuesslich an seiner Pfeife.\n",
      "Brabo meint: Jaja, der Sarrian war schon ein bewundernswerter Hobbit.\n",
      "Brabo spielt eine froehliche Melodie auf seinem Trabok.\n",
      "Brabo brummelt etwas von einer tollen Kneipe in Derlim.\n",
      "Brabo fragt Dich: Willst Du etwas ueber Instrumente wissen?\n",
      }) );  
} 

public void clone_task_awf(object pl) {
  object task;
  int mvCode;
  if(pl->QueryProp(P_GUILD) == "bardengilde" && pl->QueryProp(P_GUILD_LEVEL) == 6 &&
     pl->QuerySkill("aller welten freund") == 0 && !present("\nbarden_quest_awf", pl)) {
       task = clone_object("/gilden/bardengilde/obj/quest/reiselied_task");
       if((mvCode=task->move(pl, M_NOCHECK)) != 1) {
         tell_object(pl, sprintf("Bardengilde AWF: Ohje! Ein Fehler ist aufgetreten: %d\n", mvCode));
       }

    tell_object(pl, BS("Vielleicht fallen dir weitere Strophen ein, wenn du die Reise nachvollziehst?"));
    tell_object(pl, BS("Solltest du die aktuelle Strophe vergessen kannst du dich jederzeit daran erinnern. (<erinnere an strophe>)"));
  }
}

public string awf_first_verse() {
  call_out("clone_task_awf", 1, this_player());

  return "Ein wunderschoenes Wanderlied! Leider kenne ich nur die erste Strophe:\n"
         "Als Freund aller Welt, da komm ich weit hinaus.\n"
         "In Midas fing die Reise an.\n"
         "Bei Albin ging es los,\n"
         "Richtung Gaffodorf, zum Osttor 'raus!\n";
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
    {
    case "fies":
      call_out("react", 0, "schaut Dich so boese an als wolltest Du ihm sein Essen stehlen",
	       "schaut "+TP->name(WEN)+" so boese an als wollte man ihm sein Essen stehlen");
      break;
      
    case "aergerlich":
      call_out("react", 0, "laeuft hochrot an", "laeuft hochrot an");
      break;

    case "traurig":
      call_out("react", 0, "meint: Wird schon wieder werden, "+TP->name(WEN),
	       "meint: Wird schon wieder werden, "+TP->name(WEN));
      break;
    case "albern":
      call_out("react", 0, "kichert belustigt",
	       "kichert belustigt");
      break;

    case "neutral":
      call_out("react", 0, "raucht unbeeindruckt weiter an seiner Pfeife", 
	       "raucht unbeeindruckt weiter an seiner Pfeife");
      break;

    case "intim":
      if (TP->QueryProp(P_GENDER)==MALE)
	call_out("react", 0, "meint veraergert: Ich bin nicht so einer, "+TP->name(WEN),
		 "meint veraergert: Ich bin nicht so einer, "+TP->name(WEN));
      if (TP->QueryProp(P_GENDER)==FEMALE)
	call_out("react", 0, "sagt galant: Ich fuehle mich geehrt, "+TP->name(WEN),
		 "sagt galant: Ich fuehle mich geehrt, "+TP->name(WEN));
      break;
      
    case "froh":
      call_out("react", 0, "wirft laechelnd seinen Hut hoch und faengt ihn wieder auf",
	       "wirft laechelnd seinen Hut hoch und faengt ihn wieder auf");
      break;
      
    case "aengstlich":
      call_out("react", 0, "grinst belustigt",
	       "grinst belustigt");
      break;
      
    case "frech":
      call_out("react", 0, "verwuenscht Dich ein paar mal", 
	       "verwuenscht "+TP->name(WEN)+" ein paar mal");
      break;
      
    case "nett":
      call_out("react", 0, "verwuschelt Dir grinsend die Haare", 
	       "verwuschelt "+TP->name(WEN)+" grinsend die Haare");
      break;
    }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG ("kills"),
	       sprintf( ctime()+": Brabo hat gerade "+CAP(getuid(player))
			+" umgebracht - %d EP!\n", lostexp));
  return ;
}

void die(int poisondeath)
{
 object ob;
 write_file(LOG("kills"),
	    dtime(time())+": "+CAP(getuid(TP))+" toetet Brabo.\n");
 ::die(poisondeath);
}



