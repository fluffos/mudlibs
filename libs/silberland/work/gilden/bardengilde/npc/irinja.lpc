inherit "std/inpc";
inherit "std/spellbook";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <inpc.h>
#include "/gilden/bardengilde/bardengilde.h"

query_prevent_shadow() { return 1; }

void create()
{
  object ob; 
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Irinja Avia, Priesterin der Alinja");
  SetProp(P_LONG,
          "Irinja Avia, Priesterin der Alinja, ist die "
	  +"Hueterin dieses Tempels. Sie ist eine zierliche "
	  +"Fee mit huebsch glaenzenden gruenen Augen und "
	  +"einem freundlichem Laecheln auf den Lippen. Ihr "
	  +"rehbraunes Haar ist zu einem langem Zopf geflochten "
	  +"welcher bis zu ihren Hueften reicht. Sie traegt ein "
	  +"schlichtes weisses Kleid an das sie mit sichtlichem "
	  +"Stolz ihre Bardenbrosche gesteckt hat. Ausserdem traegt sie ein "
	  +"aussergewoehnliches Aquamarinstirnband. Es heisst, dass sie eine "
	  +"besonders enge Verbindung zur Goettin Alinja hat.\n");  
  SetProp(P_NAME, "Irinja");
  SetProp(P_NAME, "Irinja");
  SetProp(P_GENDER, FEMALE);
  AddId(({"irinja", "avia", "irinja avia", "fee", "priesterin"}));
  set_living_name("irinja");
  create_default_npc(38);
  SetProp(P_GUILD, "bardengilde");
  SetProp(P_GUILD_LEVEL, 12);
  ModifySkill(SK_SINGING,10000);
  ModifySkill(SK_MUSIC,10000);
  SetProp(P_HANDS, ({" mit ihren flinken Haenden", 180, DT_SLASH}));
  SetProp(P_RACE, "fee");
  SetProp(P_BODY, 300);
  SetProp(P_SIZE, 40);
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);
  SetProp(P_DIE_MSG,  " sinkt mit einem tiefem, herzzerreissendem Seufzen zu Boden und stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Oh Alinja, bestrafe %s fuer diese Tat!");
  SetProp(P_KILL_MSG, "So straft Alinja all jene welche ihren Tempel entweihen!");
  SetProp(P_KILL_NAME, "Irinja Avia");  
  
  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("irinja.lib"), 1);
  
  AddInfo(DEFAULT_INFO,
	  ({"sagt: Darueber weiss ich leider nichts.\n",
	      "sagt: Davon weiss ich nichts. Aber ich kann Dir etwas ueber Alinja erzaehlen.\n",  
	      "murmelt kopfschuettelnd ein Gebet an Alinja.\n",
	      "meint: Darueber musst Du jemand anderen fragen.\n",
	      "fragt laechelnd: Mit solchen Fragen belastest Du Dich?\n",
	      "sagt: Damit habe ich noch nichts zu tun gehabt.\n",
	      "zuckt ratlos mit den Schultern.\n",
	      "schenkt Dir nur ein ratloses Laecheln.\n",
	      "meint: Das gehoert nicht zu den Aufgaben einer Tempelwaechterin.\n"
	      }));

  AddInfo(({"edgar", "barde edgar", "besuch des raben", "der besuch des raben"}),
    "@@besuch_des_raben_start@@", "sagt: ");
  
  ob=CLONEOB(ARMOUR("kleid"));
  ob->SetProp(P_AC, 30);
  ob->move(TO, M_NOCHECK);
  CLONEME(ARMOUR("stirnband"));
  CLONEME(INSTRUMENT("feenharfe"));
  CLONEME(ARMOUR("bbrosche"));
  command_me("trage alles");
  
  SetChats(2, ({
    "Irinja murmelt andachtsvoll ein Gebet zu Alinja.\n",
      "Irinja summt eine kleine Melodie.\n",
      "Irinja nickt Dir mit einem freundlichem Laecheln zu.\n",
      "Irinja singt ein wunderschoenes Loblied fuer Alinja.\n",
      "Irinja zupft eine wunderschoene Melodie auf ihrer Harfe.\n"
      }) );
}

public void hand_over_gs7_letter(object pl) {
  object ob;
  if(!present(pl, environment(this_object()))) return;

  ob = clone_object("/gilden/bardengilde/obj/quest/gs7_brief");
  ob->move(pl, M_GET|M_NOCHECK);
  tell_object(pl, BS(sprintf("%s gibt Dir einen Brief.", Name(WER))));
  tell_room(environment(this_object()), BS(sprintf("%s gibt %s einen Brief.",
            Name(WER), pl->Name(WEM))), ({pl}));
  return;
}

public string besuch_des_raben_start() {
  if(this_player()->QueryProp(P_GUILD) == "bardengilde" &&
     this_player()->QueryProp(P_GUILD_LEVEL) > 6) {  
      if(this_player()->QuerySkill("der besuch des raben") == 0) {
       if(!objectp(present(BARD_ID_GS7_BRIEF, this_player()))) {
        call_out("hand_over_gs7_letter", 2, this_player());
      } 
      return "Der Barde Edgar war kein besonders guter Saenger. Aber er war "
              "ein begnadeter Dichter... obwohl seine Gedichte aeusserst verstoerend "
              "zu lesen waren. Er ist bereits vor einiger Zeit verschwunden und nicht "
              "wieder gekehrt. Bevor er irgendwo in den Sumpf nahe Derlim gestapft "
              "ist hat er mir noch einen letzten Brief hinterlassen.";
     } else {
       return "Gut zu sehen, dass du dieses Geheimnis bereits geloest hast!";
     }
  }

  return "Ich denke, dieses Geheimnis ist noch nichts fuer dich.";
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
    {
    case "fies":
      call_out("react", 0, "steigt die Zornesroete langsam ins Gesicht",
	       "steigt die Zornesroete langsam ins Gesicht");
      break;
    case "aergerlich":
      call_out("react", 0, "wendet sich veraergert von Dir ab", 
	       "wendet sich veraergert von "+TP->name(WEN)+" ab");
      break;
    case "traurig":
      call_out("react", 0, "meint mit betroffener Mine: Alinja wird Dir sicherlich Trost spenden, "+TP->name(WEN),
	       "meint mit betroffener Mine: Alinja wird Dir sicherlich Trost spenden, "+TP->name(WEN));
      break;
    case "albern":
      call_out("react", 0, "verzieht ihre Mundwinkel zu einem Grinsen",
	       "verzieht ihre Mundwinkel zu einem Grinsen");
      break;
    case "neutral":
      call_out("react", 0, "zuckt mit den Schultern",
	       "zuckt mit den Schultern");
      break;
    case "intim":
      call_out("react", 0, "laechelt schuechtern und ihre Wangen roeten sich",
	       "laechelt schuechtern und ihre Wangen roeten sich");
      break;
    case "froh":
      call_out("react", 0, "wirkt sichtlich erheitert",
	       "wirkt sichtlich erheitert");
      break;
    case "aengstlich":
      call_out("react", 0, "meint laechelnd: Vor mir brauchst Du keine Angst zu haben, "+TP->name(WEN),
	       "meint laechelnd: Vor mir brauchst Du keine Angst zu haben, "+TP->name(WEN));
      break;
    case "frech":
      call_out("react", 0, "wirft Dir einen strafenden Blick zu", 
	       "wirft "+TP->name(WEN)+" einen strafenden Blick zu");
      break;
    case "nett":
      call_out("react", 0, "sagt laechelnd: Moege Alinja ihre schuetzende Hand ueber Dich halten, "+TP->name(WEN), 
	       "sagt laechelnd zu "+TP->name(WEN)+": Moege Alinja ihre schuetzende Hand ueber Dich halten, "+TP->name(WEN));
      break;
    }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG ("kills"),
	       sprintf( ctime()+": Irinja hat gerade "+CAP(getuid(player))
			+" umgebracht - %d EP!\n", lostexp));
  return ;
}

void die(int poisondeath)
{
 object ob;
 write_file(LOG("kills"),
	    dtime(time())+": "+CAP(getuid(TP))+" toetet Irinja.\n");
 write("\nALINJAS WUT FAEHRT AUF DICH HERAB!!!\n\n");
 call_other(TEMPEL, "alinjas_wut");
 ::die(poisondeath);
}
