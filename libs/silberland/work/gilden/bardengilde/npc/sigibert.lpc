inherit "std/mnpc";
inherit "std/npc/spells";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <inpc.h>
#include <defines.h>
#include <moredef.h>
#include <new_skills.h>
#include <moving.h>
#include "../bardengilde.h"

create()
{
  if (!is_clone(TO)) return;
  ::create(); 
  SetProp(P_SHORT, "Sigibert der Froschbarde, Hueter der Heldensagen, badet in der Quelle");
  SetProp(P_LONG, "Nun, eines vorweg: Sigibert ist ein Forsch. Und nein, Sigibert ist kein "
                  "verfroschter Barde, sondern ein leibhafter, sprechender und singender "
                  "Frosch. Er gehoert der Bardengilde an und ist der Hueter der Heldensagen. "
                  "Zu seinen Aufgaben gehoert es die Erzaehlungen der grossen Helden "
                  "zu bewahren und aufstrebenden Barden darin anzuleiten diese Helden zu "
                  "verkoerpern und so andere zu inspirieren.\n"
                  "Auf seinem kleinen Froschopf sitzt ein schiefes Barret mit Feder und um "
                  "die 'Schultern' geschnallt hat er ein merkwuerdiges Glasinstrument.");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Sigibert");
  SetProp(P_ARTICLE, 0);
  AddId (({"sigibert", "frosch", "hueter", "froschbarde", "Schwertmeister"}));
  SetProp(P_DIE_MSG, 
	  " quakt ein letztes Mal und stirbt dann elendiglich.\n");
  SetProp(P_MURDER_MSG, "Oh neiiin! *Quak* Wer huetet nun die Heldensagen? *quak*");
  SetProp(P_KILL_MSG, "Tja, wenn du ein echter Held waerst, waer das nicht passiert!");
  create_default_npc (42);
  SetProp(P_HANDS, ({" mit seinen Froschfingern", QueryProp(P_HANDS)[1], DT_BLUDGEON}));
  SetProp(P_HEAL, 20);
  SetProp(P_RACE, "Frosch");
  SetProp(P_ALIGN, 600);
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 500);
  SetProp( P_REJECT, ({ REJECT_GIVE,
			  "@CAP_WER quakt: Was soll ich denn damit?!\n" }) );
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([DT_SOUND: -0.5, DT_WATER: -0.8, DT_ACID: -0.3, DT_POISON: -0.3]));
  
  set_living_name("sigibert");
  SetProp(P_GUILD, "bardengilde");
  SetProp(P_GUILD_LEVEL, 12);
  SetProp(P_BARD_GROUP, BARD_GROUP_SARRIAN);

  SetChats(1, ({
    Name(WER) + " quakt ein altes Froschlied.\n",
    Name(WER) + " spielt einen kurzen Marsch auf seinem Instrument.\n",
    Name(WER) + " schwimmt eine runde in der Quelle.\n",
    Name(WER) + " notiert rasch etwas in dem Buch im Schrein.\n",
    Name(WER) + " fragt: Weisst du wie mutig Arcon war?\n",
    Name(WER) + " meint: Angara hat die schoensten Juwelen gesammelt!\n",
    Name(WER) + " belehrt dich: Die grossen Helden haben ihr Leben gegeben, um DAS BOESE zu besiegen.\n",
    Name(WER) + " denkt . o ( Ob Grimm ein echter Riese war? )\n",
    Name(WER) + " quakt leise vor sich hin.\n",
    Name(WER) + " erdichtet einen neuen Reim.\n",
    Name(WER) + " sagt: Mira war einst eine Offizieren der Armee von Midas!\n",
    Name(WER) + " fluestert dir zu: Auch du kannst einmal ein echter Held sein!\n",
    Name(WER) + " meint bedauerlich: Flammara hat immer alles in Brand gesteckt. Schwere Kindheit und so...\n",
    Name(WER) + " ueberlegt, ob Khartak eigentlich nur mit Aexten kaempfte.\n",
    Name(WER) + " sagt: Einmal hat irgendein Depp einfach so ein Schwert in meinen See geworfen!\n",
    Name(WER) + " denkt . o ( Ob Nogis Ruestung noch irgendwo im Brunnen ist? )\n",
    Name(WER) + " fragt dich: Was denkst du - war Rynoxa die hellste Fee im Silberland?\n",
    Name(WER) + " kratzt sich am Kopf.\n",
    Name(WER) + " fluestert: Schlain konnte so leise schleichen, dass ihn niemand bemerkt hat.\n",
    Name(WER) + " plappert: Zafira war die Meisterin aller Elemente! Sicher besser als Anvar...\n",
    Name(WER) + " denkt . o ( Fraggin war ja eigentlich kein Held... aber... ) \n",
    Name(WER) + " blubbert etwas Wasser mit seinem Forschmaul.\n",
    Name(WER) + " blaest eine Seifenblase.\n",
    Name(WER) + " schnappt sich mit seiner klebrigen Zunge eine Fliege.\n",}) );  

  AddInfo( DEFAULT_INFO,({ 
    "starrt Dich etwas verwirrt an.\n",
		"fragt: Hast du schon in den Aufzeichnungen nachgelesen?\n",
		"sagt: Vielleicht fragst du besser Artyrian?.\n",
		"quakt etwas unverstaendliches.\n",
		"blickt dich nur mit grossen Froschaugen an.\n"}) );

  AddInfo( ({"helden", "krieger"}),
    "Die grossen Helden waren grosse Krieger gegen das Boese in der Zeit nach den Orkkriegen.",
    "sagt: ");

  AddInfo( ({"orks", "ork", "orkkriege", "orkkriegen", "orken", "orkenkrieg"}),
    "Der Orkenkrieg fand vor langer Zeit statt. Die Orks haben damals die freien Laender ueberrant. "
    "Waehrend diesem Krieg haben sich viele Helden hervorgetan.",
    "sagt: ");
  
  AddInfo( ({"boese", "das boese", "dem boesen", "boesen", "boesem"}),
    "Das Boese griff einst mit seinen gierigen Klauen nach dem Silberland. Ihm stellten sich "
    "die alten Helden entgegen und trieben es in Tiefen des Brunnens. Von ihrer letzten Schalcht "
    "kehrten sie nie wieder zurueck...",
    "sagt: ");

  AddInfo( ({"zeit"}),
    "Die grossen Helden lebten vor langer Zeit.",
    "sagt: ");

  AddInfo( ({"buch", "chronik", "chroniken", "heldenchronik"}),
    "Ich habe mein Leben dem Studium der alten Helden gewidmet und alles, was ich ueber sie "
    "in Erfahrungen bringen konnte in der Heldenchronik dort zusammengefasst.",
    "sagt: ");

  AddInfo( ({"pfad", "heldenpfad", "pfade", "heldenpfade"}),
    "Ab der dreizehnten Gildenstufe folgen viele Barden und Bardinnen einem Heldenpfad. "
    "Zu jedem der grossen Helden gibt es einen solchen Pfad. Auf dem ersten Schritt "
    "des Heldenpfads erlernen die Barden eine Heldenaura, auf dem zweiten Schritt eine "
    "Liedvariante und auf dem dritten Schritt die Verkoerperung des Helden selbst. Um einem "
    "dieser Heldenpfade zu folgen gilt es verschiedene Aufgaben zu loesen. Welcher Pfad "
    "welche Faehigkeiten verleiht, kannst du in meiner Heldenchronik nachlesen. Fuer jene, "
    "die den Pfad nicht beschreiten wollen, gibt es eine Alternative.",
    "sagt: ");

  AddInfo( ({"erster schritt", "ersten schritt", "erstem schritt", "aura", "heldenaura"}),
    "Der erste Schritt am Heldenpfad lehrt den Barden die Aura eines Helden zu verstroemen. "
    "Diese Aura wirkt aehlich zur Inspiration eines Barden. Je besser die Bardin ihre "
    "heldenhaftes Vorbild verkoerpert, desto mehr kommen diese Faehigkeiten zum Tragen. Um "
    "den ersten Schritt eines Heldenpfads zu gehen, musst du die Ehrenstatue deines Helden "
    "finden und ihm Ehrerbietung in Form von 100 der richtigen Edelsteine darbieten.",
    "sagt: ");

  AddInfo( ({"inspiration"}),
    "Barden erhalten Momente grosser Inspiration, die sich auf sie und ihre Umgebung auswirken.",
    "sagt: ");

  AddInfo( ({"vorbild"}),
    "Viele Barden nehmen sich einen der grossen Helden zum Vorbild.",
    "sagt: ");
  
  AddInfo( ({"faehigkeiten"}),
    "Die Faehigkeiten, die die einelnen Helden verleihen sind sehr unterschiedlich. Ueber "
    "deine Faehigkeiten aufklaeren kann dich Artyrian.",
    "sagt: ");

  AddInfo( ({"artyrian"}),
    "Artyrian leitet die Bardengilde an.",
    "sagt: ");

  AddInfo( ({"statue", "ehrenstatue"}),
    "Die Statuen der alten Helden wurden von ihren Verehrern an Orten errichtet, die fuer "
    "den jeweiligen oder die Heldin wichtig waren. Oft Staetten an denen sie gewirkt haben, "
    "oder an denen ihre Verehrung am groessten ist.",
    "sagt: ");

  AddInfo( ({"verehrung", "ehrung", "staette", "staetten"}),
    "In verschiedenen Teilen des Silberlands werden jeweils andere Helden besonders verehrt. "
    "Dies kann mit ihrer Herkunft, ihrer Abstammung oder einfach dem Ort, an dem sie gewirkt "
    "haben in Verbindung stehen. An solchen Orten hat man den Helden besondere Ehrenstatuen "
    "errichtet. Wo diese jeweils zu finden sind, kannst du anhand der Geschichte deines "
    "Helden ablesen.", "sagt: ");

  AddInfo( ({"edelstein", "edelsteine"}),
    "Jedem Helden sind andere Edelsteine gewidmet. Am ehesten erkennst du die richtigen "
    "an der Ehrenstatue der jeweiligen Heldin.",
    "sagt: ");

  AddInfo( ({"zweiter schritt", "zweiten schritt", "liedvariante", "variante"}),
    "Um den zweiten Schritt am Heldenpfad zu gehen und eine Liedvariante zu erlernen, "
    "musst du des Helden groesste Heldentat nachstellen. Welche das ist kannst du anhand "
    "der Abbildung des Helden in seiner Ehrenstatue erfahren. Um zur Heldentat anzutreten, "
    "suche die Ehrenstatue deines Helden auf. Bedenke, dass eine Liedvariante eines deiner "
    "bestehenden Lieder ersetzen wird!",
    "sagt: ");

  AddInfo( ({"heldentat"}),
    "Jeder Held hat eine grosse Tat vollbracht, bevor er sich dem Boesen stellte. Diese "
    "gilt es nachzustellen, um die Inspiration zur Liedvariante deines Helden zu erfahren. "
    "Welche Heldentat das ist, habe ich jeweils in der Chronik dort festgehalten.",
    "sagt: ");

  AddInfo( ({"dritter schritt", "drittem schritt", "verkoerperung", "heldenkraft"}),
    "Der dritte Schritt am Heldenpfad ist die Verkoerperung deines Helden. Wenn sie dir "
    "gelingt, faehrt die Heldenkraft in dich und laesst dich permanent an der Macht "
    "deiner Heldin teilhaben. Je nach Helden wirkt sie unterschiedlich. Um diesen "
    "Schritt zu gehen, musst du die letzte Ausruestung, die der Held getragen hat "
    "vervollstaendigen und so vor der Statue knien.",
    "sagt: ");

  AddInfo( ({"alternative"}),
    "Wenn du keinen der Pfade beschreiten willst, kannst du stattdessen am "
    "vierzehnten Grad der Bardengilde ein zusaetzliches Talent erlernen. Dazu "
    "musst du der Dame vom See einen bestimmten Gegenstand bringen.",
    "sagt: ");

  AddInfo( ({"dame", "dame vom see", "gegenstand", "frau", "fraum im teich", "goer"}),
    "Wenn du keinem Heldepfad folgst, den vierzehnten Grad der Barden erreicht hast "
    "und diesen Ort hier aufsuchst, wird dir die Dame vom See erscheinen und sagen, "
    "welcher Gegenstand dies sein muss. Was sie damit tut, kann ich dir nicht sagen. "
    "Ich habe da nur einen wagen Verdacht. Und 'Dame vom See' ist eigentlich falsch... "
    "Sie ist hoechstens ein freches Goer im Tuempel!",
    "sagt: ");

  AddInfo( ({"verdacht"}),
    "Nun ja, ich denke, sie besucht andere Welten und verschachert das Zeug dort "
    "zu einem guten Preis. Sonst waere der See schon voll mit Muell!",
    "sagt: ");

  AddInfo( ({"angara"}),
    "Angara war eine grosse Juewelieren aus dem Zwergenvolk der Feste von Ardhmir. "
    "Sie war bekannt dafuer mit ihren Steinen boesartige Magie einzudaemmen.",
    "sagt: ");

  AddInfo( ({"arcon"}),
    "Arcon war der kleinste, aber auch mutigste, aller Hobbits. Er gilt heute als "
    "so etwas, wie der erste Paladin!",
    "sagt: ");

  AddInfo( ({"flammara"}),
    "Flammara war mit Arcon verwandt und auch ein Hobbit. Sie besass eine grosse "
    "Affinitaet zum Feuer und konnte alles in Brand stecken.",
    "sagt: ");

  AddInfo( ({"grimm"}),
    "Grimm soll ein waschechter Riese gewesen sein. Seine Kraft war unerreicht und "
    "dennoch war er der hilfsbereiteste Kerl, den man sich vorstellen konnte.",
    "sagt: ");

  AddInfo( ({"khartak"}),
    "Khartak gehoert den Barbarenstaemmen des Ostens an. Als die Orks ihren Krieg "
    "begannen, stellte er sich gegen sie. Auch, wenn er meist fuer seine berserkerhafte "
    "Wut mit der Axt bekannt ist, war er tatsaechlich ein Meister aller Waffen.",
    "sagt: ");

  AddInfo( ({"mira"}),
    "Mira stammte aus Midas und war dort Offizierin. Sie befehligte die midasianischen "
    "Soldaten im Kampf gegen die Orks. Wie durch ein Wunder war wurde sie niemals im "
    "Kampf verletzt und war eine beliebte Anfuehrerin.",
    "sagt: ");

  AddInfo( ({"nogi"}),
    "Nogi stammte aus Felonia und war natuerlich ein Zwerg. Er widmete sein Leben der "
    "Schmeidekunst und der suche nach der perfekten Ruestung. Er soll sie tatsaechlich "
    "fertig gestellt haben und ist damit gegen das Boese gezogen.",
    "sagt: ");

  AddInfo( ({"rynoxa"}),
    "Rynoxa war eine Lichtfee. Mit ihrem leuchtenden Strahlen, und das meine ich nicht "
    "metaphorisch, erneuerte sie die Hoffnung all jener, die sie traf. Ihre magische Macht "
    "ueber das Licht war ebenso gross, wie ihre Faehigkeit die grossen Helden in der letzten "
    "Schlacht mit dem Band der Freundschaft zu vereinen.",
    "sagt: ");

  AddInfo( ({"schlain"}),
    "Schlain war der groesste Jaeger des Elfenvolks. Niemand bemerkte ihn, wenn er es nicht "
    "wollte. Er konnte alle Feinde aufspuehren und mit einem gezielten Blattschuss erledigen.",
    "sagt: ");

  AddInfo( ({"zafira"}),
    "Zafira gehoerte, wie auch Schlain, den Elfen an. Sie war eine Meisterin aller Elemente, "
    "die sie befehligte wie keine andere. Sie stand dem Druidenzirkel sehr nahe und es heisst, "
    "ihre elementare Macht durchstroemt noch heute den Brunnen.",
    "sagt: ");

  AddInfo( ({"xulgsch"}),
    "Xulgsch... nun. Ueber ihn sprechen wir wenig. Er war einst ein Mensch, der sich dem "
    "Boesen verschrieb und zum Nekromanten wurde. Eigentlich war er kein Held im eigentlichen "
    "Sinne, da er versuchte das Boese zu befreien. Sein Eintrag in der Chronik fehlt. Meine "
    "fruhere Gehilfing Zarisa hat sie herausgerissen...",
    "sagt: ");

  AddInfo( ({"fraggin"}),
    "Fraggin nennt man auch den 'Helden des Zufalls'. Er war gar nicht an der letzten Schlacht "
    "der grossen Helden beteiligt. Erst viele Jahre spaeter, als der Nekromant Xulgsch versuchte "
    "das Boese zu befreien viel er ihm, wie durch Zufall vor die Fuesse und besiegte ihn...",
    "sagt: ");

  AddInfo( ({"zarisa"}),
    "Zarisa war meine Gehilfin. Ich dachte, ich koennte sie aendern, denn eigentlich schloss "
    "sie sich uns nur an, weil die Nekromanten keine Feen aufnehmen... und in ihr steckte "
    "schon immer etwas Fieses. Jedenfalls stahl sie meine Aufzeichnungen zu Xulgsch und "
    "errichtet ihm wohl an irgendeinem finsteren Orte eine Ehrenstatue...",
    "sagt: ");

  AddInfo( ({"brunnen"}),
    "In ihrem letzten Kampf gegen das Boese, bannten die grossen Helden es tief in ein "
    "Labyrinth, das bis heute getarnt als Eingang zu einem einfachen Brunnen ueberall "
    "im Silberland erscheinen kann.",
    "sagt: ");

  AddInfo( ({"barde", "froschbarde"}),
    "Ja, ich bin Mitglied der Bardengilde. Warum fragst du sowas Dummes? Die Bardengilde "
    "steht schliesslich allen Rassen offen!",
    "sagt: ");

  AddInfo( ({"frosch"}),
    "Ich bin ein waschechter, sprechender Frosch - und der einzige Froschbarde, den "
    "ich kenne!",
    "sagt: ");

  AddInfo( ({"anvar"}),
    "Anvar ist das amtierende Oberhaupt des Druidenzirkels. Ueberhaupt... es gab nie "
    "andere Oberhaeupter. Ich wittere da Schiebung! Ausserdem denke ich, dass Zafira "
    "sicher besser war als der alte Sack!", "sagt: ");

  AddInfo( ({"heldenpfad wechseln", "heldenwechsel", "held wechseln", "pfad wechseln"}), 
    "Wenn du einen Heldenpfad beschritten hast und ihn wieder los werden willst, kannst du "
    "mich einfach kuessen. Das Gift meiner Froschhaut wird jede Erinnerung an deinen Helden "
    "verschwinden lassen.", "quakt: ");

  SetProp(P_SPELLRATE, 75);
  
  AddSpell(2, 200,
    "Eine Blitz schlaegt von "+Name(WEM)+" aus auf dich ein!\n",
    "Eine Blitz schlaegt von "+Name(WEM)+" aus auf @WEN ein!\n",
     DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 250,
    Name(WER)+" singt ein schrilles Vibrato, das in deinen Ohren schmerzt!\n",
    Name(WER)+" singt ein schrilles Vibrato!\n", 
    DT_SOUND, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 100, 
    Name(WER)+" schlaegt dir ins Gesicht.\n",
    Name(WER)+" schlaegt @WEM ins Gesicht.\n", DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 500, 
    Name(WER)+" ruft: \"Nimmermehr!\" und deutet auf dich.\n",
    Name(WER)+" ruft: \"Nimmermehr!\" und deutet auf @WEN.\n",
    DT_MIND, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 250, DS_DEAF,
    Name(WER)+ " quakt ein schrilles Vibrato, das in deinen Ohren schmerzt!\n",
    Name(WER)+" quakt ein schrilles Vibrato!\n");

  AddDefaultSpell(1, 0, DS_FROG, 
    Name(WER) + " verpasst dir einen fetten Schmatzer und dir wird gruen vor Augen...\n",
    Name(WER) + " verpasst @WEM einen fetten Schmatzer.");

  AddDefaultSpell(1, 1, DS_SLOW,
        Name(WER)+" singt: Abendstihille, uehueberall!\nDu wirst muede...",
        Name(WER)+" singt: Abendstihille, uehueberall!.\n@WER wird muede...");
  
  CLONEME(ARMOUR("bbrosche"));
  CLONEME(ARMOUR("barett"));
  CLONEME(INSTRUMENT("froggolum"));
  CLONEME("/p/weapon/sword/rapier");
  command_me("trage alles");
  command_me("zuecke rapier");

  AddCmd( ({"kuess", "kuesse", "knutsch", "knutsche"}), "cmd_kuessen");
}

public void confirm_reset_hero_path(string in) {
  if(lowerstring(in) != "j" && lowerstring(in) != "ja") {
    write("Du schuettelst die Wirkung des Gifts ab und nichts passiert.\n");
    return;
  }

  write(BS("Sigiberts Gift rast durch dein Hirn und loescht aller Erinnerungen an deinen Helden..."));
  BARDENMASTER->ResetHeroPath(TP);
  return;
}

public void reset_hero_path() {
  if(!BARDENMASTER->GetHeroPath(TP)) {
      command_me("sag Du hast gar keinen Heldenpfad gewaehlt. Also wirkt mein Gift nicht!");
      return;
  }

  write("Sigiberts Gift beginnt zu wirken...\n");
  write("Willst du deinen Heldenpfad zuruecksetzen? [ja/NEIN] ");
  input_to("confirm_reset_hero_path");
  return;
}

public int cmd_kuessen(string str) {
  if(!id(str)) return 0;

  if(TP->QueryProp(P_GUILD) == "bardengilde" && TP->QueryProp(P_GUILD_LEVEL) > 12) {
    call_out("reset_hero_path", 0);
  }
}

// TANKEN
public int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  string *dt;
  object ob;

  if(!pointerp(dam_type)) {
      dt = ({ dam_type });
  } else {
      dt = dam_type;
  }

  if(spell != 0 && !random(3)) {
      if(QueryProp("lorica")) {
        if(!random(3)) {
            tell_room(ENV(TO), BS("Regenbogenfarbenes Licht flackert um "+ TO->Name(WEN) +" herum auf und absorbiert den Angriff!"));
            return ::Defend(0, dt, spell, enemy);
        } else {
            tell_room(ENV(TO), BS("Regenbogenfarbenes Licht flackert um "+ TO->Name(WEN) +" herum auf und schwaecht den Angriff ab!"));
            return ::Defend(dam/2, dt, spell, enemy);
        }

        if(!random(4)) {
          tell_room(ENV(TO), BS("Das regenbogenfarbene um " + name(WEN, 1) + " verblasst."));
          SetProp("lorica", 0);
        }
      }
  }

  if(!random(2) && !QueryProp("lorica")) {
    tell_room(ENV(TO), BS(sprintf("Ein regenbogenfarbenes Netz schimmert kurz um %s auf.\n", name(WEN, 1))));
    SetProp("lorica", 1);
  }

  if(!random(4) || 
     member(dt, DT_LIGHT) > -1 || 
     member(dt, DT_LIGHTNING) > -1 || 
     member(dt, DT_RIP) > -1) {

    if(!QueryProp("no_schutz")) {
      tell_room(ENV(TO), "Eine Schallmauer rast von " + BS(Name(WEM, 1)+" gegen den Angriff und schwaecht ihn ab!"));

      if(!random(7)) {
        tell_room(ENV(TO), BS("Die Schutzmelodie um " + Name(WEN) + " verklingt!"));
        SetProp("no_schutz", 1);
      }
    } else {
      tell_room(ENV(TO), BS("Mit einem Knall bildet sich eine Schallmauer um " + Name(WEN, 1) + "."));
      SetProp("no_schutz", 0);
    }
      return ::Defend(dam/2, dt, spell, enemy);
  }

  if(!objectp(QueryProp("room_damage")) && !random(3)) {
    ob = clone_object(OBJ("room_damage_control"));
    ob->move(TO, M_NOCHECK);
    ob->Setup("Das Geheimnis der Insel", TO, 8000, random(8000), 1.0);
    SetProp("room_damage", ob);
  }

  return ::Defend(dam, dt, spell, enemy);
}

public void Attack(object enemy) {
  if(!random(3)) {
      enemy->Defend(75+random(200), DT_TERROR, ([SP_NAME:"wiegenlied des leids", SP_SHOW_DAMAGE: 1]), TO);
      if(!random(4)) {
          tell_object(enemy, BS("Unbaendige Furcht vor " + Name(WEM, 1)+" laehmt dich!"));
          enemy->ModifySkillAttribute(TO, SA_SPEED, 50, 2 + random(5));
      }
  }

  ::Attack(enemy);
  return;
}


// REAKTIONEN

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
    {
    case "fies":
      call_out("react", 0, "sieht Dich veraergert an",
	       "sieht "+TP->name(WEN)+" veraergert an");
      break;
      
    case "aergerlich":
      call_out("react", 0, "grummelt etwas vor sich hin", "grummelt etwas vor sich hin");
      break;
      
    case "traurig":
      call_out("react", 0, "meint: So schlimm kann es ja wohl nicht sein, oder "+TP->name(WEN)+"?",
	       "meint: So schlimm kanns es ja wohl nicht sein, oder "+TP->name(WEN))+"?";
      break;
    case "albern":
      call_out("react", 0, "grinst belustigt",
	       "grinst belustigt");
      break;

    case "neutral":
      call_out("react", 0, "taetschelt dir den Kopf.", 
	       "laesst sich von "+TP->name(WEN)+" nicht bei der Arbeit stoeren");
      break;

    case "intim":
      if (TP->QueryProp(P_GENDER)==MALE)
	call_out("react", 0, "meint: Lass das, "+TP->name(WEN),
		 "meint: Lass das , "+TP->name(WEN));
      if (TP->QueryProp(P_GENDER)==FEMALE)
	call_out("react", 0, "meint: Schoen Dich kennenzulernen, "+TP->name(WEN),
		 "meint: Schoen Dich kennenzulernen, "+TP->name(WEN));
      break;
      
    case "froh":
      call_out("react", 0, "laechelt",
	       "laechelt");
      break;
      
    case "aengstlich":
      call_out("react", 0, "verwuschelt Dir die Haare",
	       "verwuschelt "+TP->name(WEN)+" die Haare");
      break;
      
    case "frech":
      call_out("react", 0, "grummelt etwas veraergert", 
	       "grummelt etwas veraergert");
      break;
      
    case "nett":
      call_out("react", 0, "grinst Dich an", 
	       "grinst "+TP->name(WEN)+" an");
     break;
    }
}

void react(string victim, string others)
{
 if (present(TP, ENV(TO))) 
  {
     tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
   tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

/*public void catch_tell(string str) {
  tell_object(find_player("gwenshara"), sprintf("sigibert: %s", str));
}*/

public void init() {
  ::init();
  if(!is_clone(TO)) return;
  
  call_out("greet", 0, TP);
}

public void greet(object pl) {
  if(pl->QueryProp(P_INVIS)) {
    command_me("sag Huch? Ist da jemand?!");
    return;
  }

  if(pl->QueryProp(P_GUILD) == "bardengilde" &&
     pl->QueryProp(P_GUILD_LEVEL) >= 13) {
      command_me("sag Hallo, " + pl->name(WER, 1) + " wenn du gekommen bist um einen "
                 "Heldenpfad zu beschreiten, beachte, dass diese derzeit im Testmodus sind!");
  } else {
    command_me("sag Hallo " + pl->name(WER, 1)+", bist du gekommen um etwas ueber die "
               "alten Helden zu erfahren?");
  }
}

