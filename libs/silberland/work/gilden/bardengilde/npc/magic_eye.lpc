#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <class.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/npc";

object caster;

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_NAME, "Melodie");
    SetProp(P_SHORT, "Eine leise Melodie spielt hier");
    SetProp(P_LONG, "Du kannst die Melodie nicht sehen, nur hoeren...");
    SetProp(P_MSGIN, "erklingt um dich");
    SetProp(P_MSGOUT, "verklingt");
    SetProp(P_DIE_MSG, " verhallt leiser werdend.\n");
    SetProp(P_NOCORPSE, 1);
    SetProp(P_GENDER, FEMALE);
    SetProp(P_FRIEND, 1);
    SetProp(P_NOATTACK, " besteht doch nur aus Toenen!");
    SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -100, T_RANGE_MAX: 100]));

    AddId(({"melodie"}));

    create_default_npc(1);
}

public void Setup(object _caster) {
    caster = _caster;
    AddId(sprintf("%s_%s", SONG_SPAEHEN, getuid(caster)));
}

public string _query_sound() {
    string name;
    if(!objectp(caster)) {
        name = "Jemand";
    } else {
        name = caster->QueryProp(P_NAME);
    }

    return sprintf("Es klingt so, als wuerde %s ein leises Lied singen:\nDie Strasse gleitet fort und fort...\n", name);
}

public void catch_tell(string str) {
    if(objectp(caster) && environment(caster) != environment(this_object())) {
        tell_object(caster, "* " + str);
    }    
  return;
}

public int _query_hp() {
    return QueryProp(P_MAX_HP);
}
  
 