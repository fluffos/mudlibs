#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <class.h>
#include <moredef.h>
#include "/gilden/bardengilde/bardengilde.h"

inherit "std/npc";

object owner;

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_NAME, "Angaras Schutz");
    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_LONG, "Den Schutz von Angaras Macht kannst du nicht sehen.");
    /*SetProp(P_MSGIN, "erklingt um dich");
    SetProp(P_MSGOUT, "verklingt");*/
    SetProp(P_DIE_MSG, "loest sich auf.\n");
    SetProp(P_NOCORPSE, 1);
    SetProp(P_GENDER, MALE);
    SetProp(P_FRIEND, 1);
    SetProp(P_NOATTACK, " ist doch nur metaphysisch!");
    SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -100, T_RANGE_MAX: 100]));

    AddId(({"\nbardengilde_heldenpfad_angara_schutz"}));

    create_default_npc(1);
}

public void Setup(object bard) {
    if(!objectp(bard)) {
        remove(1);
        return;
    }

    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_ANGARA, 3)) {
        remove(1);
        return;
    }

    bard->AddPursuer(TO);
    bard->AddDefender(TO);
    owner = bard;

    tell_object(owner, BS("Die Heldenmacht Angaras durchstroemt dich und macht dich resistent gegen Zauberei."));
    return;
}

public mixed DefendOther(int dam,mixed dam_type,mixed spell,object enemy) {
    int success, nomagic;

    if(!BARDENMASTER->HasHeroPathLevel(owner, HERO_ANGARA, 3)) {
        remove(1);
        return ({dam, dam_type, spell});
    }

    if(spell != 0) {
        success = owner->UseSkill(SK_HEROISM(HERO_ANGARA));
        nomagic = (owner->QueryProp(P_BARD_INSPIRATION_LEVEL)*3) + (success/1000);
        if(owner->QueryProp(P_TESTPLAYER))
            tell_object(owner, sprintf("angara_antimagic :: nomagic = %d\n", nomagic));
        if(random(100) < nomagic) {
            tell_object(owner, "Angaras Heldenmacht wehrt den Zauber ab.\n");
            tell_room(environment(owner), sprintf("%s wehrt den Zauber mit Angaras Heldenmacht ab.\n", owner->Name(WER, 1)), ({owner, enemy}));
            tell_object(enemy, sprintf("%s wehrt Deinen Zauber ab.\n", owner->name(WER, 1)));
            spell[SP_SHOW_DAMAGE] = 0;
            return ({0, dam_type, spell});
        }
    }
  
    return ({dam, dam_type, spell});
  }

public int _query_hp() {
    return QueryProp(P_MAX_HP);
}

public void init() {
    ::init();

    if(this_player() == owner) {
        owner->AddDefender(this_object());
        owner->AddPursuer(this_object());
    }
}
  
 