

  //Temperatur-Range eingefuegt -> zur Vermeidung eines Temperaturtodes
  //Eros: 01.009.2021

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <class.h>
#include <moredef.h>

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kalte Boe des Nordwinds");
  SetProp(P_LONG,
    "Dieser Windgeist sieht aus wie ein kleiner wirbelnder Schneesturm. Eis "
    "und Schneeflocken tanzen wuetend in ihm.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Nordwind");
  SetProp(P_GENDER, MALE);
  AddId(({"wind", "boe", "nordwind", "\nbarden_wind"}));
  AddClass( ({CL_FLYING}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15);

  SetProp(P_HANDS, ({" mit eiskaltem Sturm",
                    QueryProp(P_HANDS)[1],
                    ({DT_AIR, DT_COLD})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:100]) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann nichts tragen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      -5.0, DT_WATER:       0.0,
       DT_AIR:       0.1, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.1,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:     0.8, DT_BLUDGEON:    0.8,
       DT_PIERCE:    0.8, DT_SQUEEZE:   0.8, DT_WHIP:        0.8,
       DT_RIP:       0.8,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "weht herein");
  SetProp(P_MSGOUT, "weht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verweht in alle Winde.\n");
  SetProp(P_NOCORPSE, 1);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(1, 150,
    Name(WER, 1) + " schleudert dir Eis und Schnee ins Gesicht.\n",
    Name(WER, 1) + " schleudert @WEM Eis und Schnee ins Gesicht.\n",
     DT_COLD, ([SP_SHOW_DAMAGE:1]));
}

void die(int poisondeath)
{
  object killer, flasche;
  killer = QueryProp(P_KILLER);
  if(killer->QueryProp(P_GUILD) == "bardengilde") {
      flasche = present("\nbard_windflasche", killer);
      if(objectp(flasche)) {
          tell_room(environment(this_object()), 
            BS("Mit einem maechtigen Brausen wird " + Name(WER, 1) + " in " + killer->Name(WESSEN, 1) + 
               " Windflasche gesogen."), ({killer}));
          tell_object(killer, BS("Mit einem maechtigen Brausen wird " + Name(WER, 1) + " in deine Windflasche gesogen."));
          flasche->SetNorth();
      }
  }
  ::die(poisondeath);
}
