inherit "/gilden/obj/sequencer";

#include <wizlevels.h>
#include <language.h>
#include <config.h>
#include <new_skills.h>
#include <properties.h>

#include "/gilden/bardengilde/bardengilde.h"

create()
{

  if (is_clone(this_object())) 
    {
      destruct(this_object());
      return 1;
    }
  seteuid(getuid(this_object()));

  // WICHTIGE INFOS FUER DEN SEQUENCER
  
  SetNames(GUILDNPC_LONGNAME ,GUILDNPC_NAME);		
  SetThirdPerson("niemand", "niemand", "niemand", "niemand");
}

// HIER KANN MAN DIE FUNKTIONEN NICHT MEHR UEBERSCHREIBEN ;P
 
nomask query_prevent_shadow() { return 1; }

// ABFRAGEN OB JEMAND MIT DEM MASTER PFUSCHEN DARF ODER NICHT

nosave int CheckIfAllowed()
{
 object ob;
 string fname;
 ob=previous_object();
 fname=explode(file_name(ob), "#")[0];
 if(getuid(ob)!="GUILD.bardengilde"  &&
    getuid(ob)!="GUILD.barden_spells")
   { 
     if(find_player("andyl")) {
      tell_object(find_player("andyl"), sprintf("Versuchte "
         +"Aenderung im Sequencemaster von %s (direkt!)\n", CAP(getuid(ob))));
     }
    write_secure_log("Versuchte Aenderung im Sequencemaster "
             +"von "+CAP(getuid(ob))+" (direkt!)\n");
    return 0;      
   }
 return 1;
}

int sequenzaus()
{
  call_other(BARDENMASTER, "sequenzende");
  return 1;
}

int AdvanceSequenz()
{  
  string spell1, spell2, bardgroup;
  bardgroup="";
  spell1="";
  spell2="";
 
 
  // JETZT DIE SPELLS FUER DEN SPIELER DEFINIEREN
  
  //BARDENGRUPPE DES SPIELERS ABFRAGEN
  
  bardgroup=(call_other(BARDENMASTER,"GetBardGroup",TP));

  switch(TP->QueryProp(P_GUILD_LEVEL))
    {
      
    case 1:
      {
	spell1="Instrumentenkunde";
	spell2="Schrei";
	break;
      }
      
    case 2: 
      {
	spell1="das Schaetzlied";
	if ((TP->QueryProp(P_RACE))=="dunkelelf")
	  {
	    spell2="Dunkelheit";
	  }
	else spell2="Lichtschein";
	break;
      }
      
    case 3: 
      {
	if (bardgroup=="alestra")
	  {
	    spell1="das Feuerlied";
	  }
	if (bardgroup=="tirena")
	  {
	    spell1="das Sturmlied";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spell1="das Terrorlied";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spell1="das Blitzlied";
	  }
	spell2="das Erkennungslied";
	break;
      } 

    case 4:  
      {
	spell1="Ruhegift";
	spell2="Heiligenfeuer";
	break;
      }
      
    case 5:
      {   
	if (bardgroup=="alestra")
	  {
	    spell1="das Schutzlied";
	  }
	if (bardgroup=="tirena")
	  {
	    spell1="das Schildlied";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spell1="das Panzerlied";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spell1="das Schallmauerlied";
	  }
	spell2="das Schlaflied";
	break;
      }
      
    case 6:
      {   
	if (bardgroup=="alestra")
	  {
	    spell1="das Rastelied";
	  }
	if (bardgroup=="tirena")
	  {
	    spell1="das Erholelied";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spell1="das Regenerationslied";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spell1="das Staerkungslied";
	  }
	spell2="das Satanslied";
	break;
      }
    case 7:
      {
	spell1="das verbesserte Schlaflied";
	spell2="das Engelslied";
	break;
      }
      
    case 8:
      {
	if (bardgroup=="alestra")
	  {
	    spell1="die Blitzballade";
	  }
	
	if (bardgroup=="tirena")
	  {
	    spell1="die Terrorballade";
	  }
      
	if (bardgroup=="korriax")
	  {
	    spell1="die Sturmballade";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spell1="die Schockballade";
	  }
	spell2="das Schreckenslied";
	break;
      }
      
    case 9:
      {
	spell1="das Friedenslied";
	spell2="Stillebrechen";
	break;
      }
      
    case 10:
      {   
	if (bardgroup=="alestra")
	  {
	    spell1="die Schutzmelodie";
	  }
	
	if (bardgroup=="tirena")
	  {
	    spell1="die Schildmelodie";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spell1="die Panzermelodie";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spell1="die Schallmauermelodie";
	  }
	spell2="Erneuern";
	break;
      }
      
    case 11:
      {
	if (bardgroup=="alestra")
	  {
		spell1="die Giftsymphonie";
	  }
	
	if (bardgroup=="tirena")
	  {
	    spell1="die Saeuresymphonie";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spell1="die Schocksymphonie";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spell1="die Horrorsymphonie";
	  }
	spell2="das Heilungslied";
	break;
      } 
      
    case 12:
      {
	spell1="Erstarren";
	spell2="das Geisterlied";	    
	break;
      }
      
    default:
      {
	write("BUG IM SEQUENCEMASTER! ERROR1 ! MAGIER VERSTAENDIGEN\n");
      }
    }
  
  // BEIM SPIELER DIE PARALYSE AUFHEBEN
  
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:0, PARALYZE_MSG:"", 
  PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  
  // SODA, DAS FRAGT JETZT ARTYRIAN
  write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"  
	   +"-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"));   
  write(BS("Artyrian fragt Dich: Also "+CAP(getuid(TP))+", worueber "
	   +"kann ich Dir noch etwas erzaehlen?\n"));
  write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"  
	   +"-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"));
  write("<1> Von Artyrian etwas ueber "+spell1+" erfahren.\n");
  write("<2> Von Artyrian etwas ueber "+spell2+" erfahren.\n");
  write("<3> Was wird meine naechste Gildenaufgabe sein?\n");
  write("<4> Dich von Artyrian verabschieden.\n"); 
  write(BS("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"  
	   +"-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"));  

  input_to("ask_decision", 0);
  return 1;
}   


int TaskSequenz()
{
  string task;
    switch(TP->QueryProp(P_GUILD_LEVEL))
	{
	case 1: 
	  LoadSequenz(TASKSEQ("task1"), TP, CLOSURE(AdvanceSequenz)); 	
	  break;
	case 2: 
	  LoadSequenz(TASKSEQ("task2"), TP, CLOSURE(AdvanceSequenz));		
	  break;
	case 3: 
	  LoadSequenz(TASKSEQ("task3"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	case 4:  
	  LoadSequenz(TASKSEQ("task4"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	case 5:   
	  LoadSequenz(TASKSEQ("task5"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	case 6: 
	  LoadSequenz(TASKSEQ("task6"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	case 7: 
	  LoadSequenz(TASKSEQ("task7"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	case 8:  
	  LoadSequenz(TASKSEQ("task8"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	case 9:
	  LoadSequenz(TASKSEQ("task9"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	case 10: 
	  LoadSequenz(TASKSEQ("task10"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	case 11:  
	  LoadSequenz(TASKSEQ("task11"), TP, CLOSURE(AdvanceSequenz));		
	  break;
	case 12:  
	  LoadSequenz(TASKSEQ("task12"), TP, CLOSURE(AdvanceSequenz));	
	  break;
	default:
	  write("BUG BEI DEN TASKSEQUENCEN!!! MAGIER VERSTAENDIGEN !!!\n");
	}
}

ask_decision(str)
{
   string bardgroup, spellsequenz1, spellsequenz2;
   bardgroup="";
   spellsequenz1="";
   spellsequenz2="";


 // HIER JETZT DIE SEQUENCEN DES EINZELNEN SPIELERS DEFINIEREN

 //BARDENGRUPPE DES SPIELERS ABFRAGEN
  
  bardgroup=(call_other(BARDENMASTER,"GetBardGroup",TP));

  switch(TP->QueryProp(P_GUILD_LEVEL))
    {
      
    case 1:
      {
	spellsequenz1="instrumentenkunde";
	spellsequenz2="schrei";
	break;
      }
      
    case 2: 
      {
	spellsequenz1="das Schaetzlied";
	if ((TP->QueryProp(P_RACE))=="dunkelelf")
	  {
	    spellsequenz2="dunkelheit";
	  }
	else spellsequenz2="lichtschein";
	break;
      }
      
    case 3: 
      {
	if (bardgroup=="alestra")
	  {
	    spellsequenz1="feuerlied";
	  }
	if (bardgroup=="tirena")
	  {
	    spellsequenz1="sturmlied";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spellsequenz1="terrorlied";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spellsequenz1="blitzlied";
	  }
	spellsequenz2="erkennungslied";
	break;
      }
      
    case 4:  
      {
	spellsequenz1="ruhegift";
	spellsequenz2="heiligenfeuer";
	break;
      }
      
    case 5:
      {   
	if (bardgroup=="alestra")
	  {
	    spellsequenz1="schutzlied";
	  }
	if (bardgroup=="tirena")
	  {
	    spellsequenz1="schildlied";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spellsequenz1="panzerlied";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spellsequenz1="schallmauerlied";
	  }
	spellsequenz2="schlaflied";
	break;
      }
      
    case 6:
      {   
	if (bardgroup=="alestra")
	  {
	    spellsequenz1="rastelied";
	  }
	if (bardgroup=="tirena")
	  {
	    spellsequenz1="erholelied";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spellsequenz1="regenerationslied";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spellsequenz1="staerkungslied";
	  }
	spellsequenz2="satanslied";
	break;
      }

    case 7:
      {
	spellsequenz1="verbessertesschlaflied";
	spellsequenz2="engelslied";
	break;
      }
      
    case 8:
      {
	if (bardgroup=="alestra")
	  {
	    spellsequenz1="blitzballade";
	  }
	
	if (bardgroup=="tirena")
	  {
	    spellsequenz1="terrorballade";
	  }
      
	if (bardgroup=="korriax")
	  {
	    spellsequenz1="sturmballade";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spellsequenz1="schockballade";
	  }
	spellsequenz2="schreckenslied";
	break;
      }
      
    case 9:
      {
	spellsequenz1="friedenslied";
	spellsequenz2="stillebrechen";
	break;
      }
      
    case 10:
      {   
	if (bardgroup=="alestra")
	  {
	    spellsequenz1="schutzmelodie";
	  }
	
	if (bardgroup=="tirena")
	  {
	    spellsequenz1="schildmelodie";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spellsequenz1="panzermelodie";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spellsequenz1="schallmauermelodie";
	  }
	spellsequenz2="Erneuern";
	break;
      }
      
    case 11:
      {
	if (bardgroup=="alestra")
	  {
		spellsequenz1="giftsymphonie";
	  }
	
	if (bardgroup=="tirena")
	  {
	    spellsequenz1="saeuresymphonie";
	  }
	
	if (bardgroup=="korriax")
	  {
	    spellsequenz1="schocksymphonie";
	  }
	
	if (bardgroup=="sarrian")
	  {
	    spellsequenz1="horrorsymphonie";
	  }
	spellsequenz2="heilungslied";
	break;
      } 
      
    case 12:
      {
	spellsequenz1="erstarren";
	spellsequenz2="geisterlied";	    
	break;
      }
      
    default:
      {
	write("BUG IM SEQUENCEMASTER! ERROR1 ! MAGIER VERSTAENDIGEN\n");
      }
    }

  if (str!="1" && str!="2" && str!="3" && str!="4")
    {
      write("Worueber willst Du mehr erfahren?\n");
      funcall(CLOSURE(AdvanceSequenz), TP);	
      return 1;
    }
  if (str=="1")
    {
      LoadSequenz(SPELLSEQ(spellsequenz1), TP, CLOSURE(AdvanceSequenz));	
      return 1;
    }
  if (str=="2")
    {
      LoadSequenz(SPELLSEQ(spellsequenz2), TP, CLOSURE(AdvanceSequenz));	
      return 1;
    }
  if (str=="3")
    {
      call_out("TaskSequenz", 0);	
      return 1;
    }
  if (str=="4")
    {
      write("Du beendest das Gespraech mit Artyrian.\n");
      CLOSURE(sequenzaus);
      return 1;
    }
}
  








