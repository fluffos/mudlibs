/*
    Talentmaster der Bardengilde
*/
#pragma no_clone, no_inherit, no_shadow
#include "../bardengilde.h"
#include "../access.h"
#define TALENTS "/gilden/bardengilde/backup/talents"
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>
#include <language.h>
#include <combat.h>
#include <properties.h>
#include <moving.h>
#include "/gilden/berserker/berserker_extern.h"

nosave mapping bards = ([ ]);
nosave mapping lastTalentReset = ([ ]);
mixed saveload;

public void create() {
  seteuid(getuid(this_object()));
  if (restore_object(TALENTS))
   bards=saveload;
  saveload=0;
  return;
}

mixed GetSaveLoad()
{
  return saveload;
}

public int DoBackup() {
  if (!CheckIfAllowed()) return -2;
  saveload=bards;
  save_object(TALENTS);
  rm (BACKUP("talents.log"));
  write_file(BACKUP("talents.log"),
             "Letztes Backup: "+dtime(time())+"\n");
  return 1;
}


public int DoRestore() {
  if(!CheckIfAllowed()) return -2;
  if(restore_object(TALENTS))
    save_object(TALENTS);
  bards = saveload;
  return 1;
}

int isBard(string uid) {
  return !(member(call_other(BARDENMASTER, "QueryMembers"), uid) < 0);
}

public int HasTalent(object ob, int talent)
{
  string pl;
  if(!objectp(ob)) return 0;
  
  pl = getuid(ob);

  if(!CheckIfAllowed()) return 0;
  if(!isBard(pl)) return 0;
  if(!member(bards, pl)) bards += ([ pl:"" ]);

  return test_bit(bards[pl], talent);
}

public int ActivateTalent(object ob, int talent) {
  string pl;
  pl = getuid(ob);
  if(!CheckIfAllowed()) return -1;
  if(!isBard(pl)) return -2;
  if(!member(bards, pl)) bards+=([pl: ""]);

  if(!member(bards, pl)) {
    bards += ([pl: ""]);
  }

  bards[pl] = set_bit(bards[pl], talent);
  DoBackup();
  return HasTalent(ob, talent);
}

public int DeactivateTalent(object ob, int talent) {
  string pl;
  pl = getuid(ob);
  if(!CheckIfAllowed()) return -1;
  if(!isBard(pl)) return -2;
  if(!member(bards, pl)) bards+=([pl:([])]);

  if(!member(bards, pl)) {
    bards += ([pl: ""]);
  }

  bards[pl] = clear_bit(bards[pl], talent);

  DoBackup();
  return !HasTalent(ob, talent);
}

public mapping GetAll() {
  return bards;
}

public void reset() {
  DoBackup();
  return;
}

public int isAlly(object ob) {
  return living(ob) && (query_once_interactive(ob) || ob->QueryProp(P_FRIEND));
}

public object* findAlliesInSameRoomAs(object bard) {
  object env;
  env = environment(bard);
  if(!objectp(env)) return ({});

  return filter_array(all_inventory(env), "isAlly");  
}

public void InspireAllegro(object bard) {
  object *allies;
  int i, iLvl, currentSaSpeed, defaultSaSpeed, newSaSpeed, maxSaSpeed;

  defaultSaSpeed = 200; // Default-Zielwert
  maxSaSpeed = 600; // Limit
  newSaSpeed = defaultSaSpeed; // Wert der dem Spieler gesetzt wird

  if(!objectp(bard)) return;

  allies = findAlliesInSameRoomAs(bard);
  allies += ({ bard });
  iLvl = bard->QueryProp(P_BARD_INSPIRATION_LEVEL);

  for(i=0; i<sizeof(allies); ++i) {
    if(allies[i] == bard) continue;
    // SA_SPEED Limit
    currentSaSpeed = allies[i]->QuerySkillAttribute(SA_SPEED);
    if((currentSaSpeed * defaultSaSpeed) / 100 >= maxSaSpeed) // Limit-Ueberschreitung ueberpruefen
      newSaSpeed = (int) (maxSaSpeed*100/currentSaSpeed);
    if(allies[i]->ModifySkillAttribute(bard, SA_SPEED, newSaSpeed, iLvl * 2) > 0) {
      tell_object(allies[i], BS(sprintf("Die Musik von %s inspiriert dich zu schnelleren Angriffen!", bard->name(WEM, 1))));
    }
  }

  tell_object(bard, BS("Du inspirierst deine Verbuendeten zu rascheren Attacken!"));
}

public void InspireHealing(object bard) {
  object *allies;
  int i;

  allies = findAlliesInSameRoomAs(bard);
  for(i=0; i<sizeof(allies); ++i) {
    allies[i]->AddHp(bard->QueryProp(P_BARD_INSPIRATION_LEVEL) * 3);
    allies[i]->AddSp(bard->QueryProp(P_BARD_INSPIRATION_LEVEL) * 3);
    if(allies[i] != bard) {
      tell_object(allies[i], BS(sprintf("Du schoepfst neue Kraft aus den ermutigenden Worten von %s!", bard->name(WEM, 1))));
    }
  }

  tell_object(bard, BS("Voll Inspiration rufst du deinen Verbuendeten ermutigende Worte zu!"));
}

public void InspireResetSpellpause(object bard) {
  object *allies;
  int i;

  allies = findAlliesInSameRoomAs(bard);
  allies += ({ bard });
  for(i=0; i<sizeof(allies); ++i) {
    allies[i]->SetProp(P_NEXT_SPELL_TIME, time()-1);
    tell_object(allies[i], BS("Deine Konzentration kehrt zurueck!"));
  }
}

public void InspireFascination(object bard) {
  object *victims;
  int i;

  victims = call_other("/spellbooks/barden_spells", "FindGroupN", bard, -1, bard->QueryProp(P_BARD_INSPIRATION_LEVEL));
  for(i=0; i<sizeof(victims); ++i) {
    tell_object(victims[i], BS(sprintf("Voller Faszination starrst du auf %s.", bard->name(WEN, 1))));
    tell_object(bard, BS(sprintf("%s starrt dich fasziniert an.", victims[i]->Name(WER, 1))));
    tell_room(environment(victims[i]), BS(sprintf("%s starrt voller Faszination auf %s.", victims[i]->Name(WER, 1), bard->name(WEN, 1))), ({bard}));
    victims[i]->SetProp(P_DISABLE_ATTACK, (int) (bard->QueryProp(P_BARD_INSPIRATION_LEVEL)/2));
  }
  return;
}

// Ausgeloeste Effekte bei Inspiration
public void InspirationBurst(object bard) {
  string uid;
  int *bursts;
  uid = getuid(bard);
  if(!isBard(uid)) return;

  bursts = ({ });

  if(HasTalent(bard, TALENT_ALLEGRO)  && bard->InFight()) {
    bursts += ({TALENT_ALLEGRO});
  }

  if(HasTalent(bard, TALENT_ERMUTIGENDE_WORTE)) {
    bursts += ({TALENT_ERMUTIGENDE_WORTE});
  }

  if(HasTalent(bard, TALENT_STAKKATO)) {
    bursts += ({TALENT_STAKKATO});
  }

  if(HasTalent(bard, TALENT_FASZINIERENDE_VORSTELLUNG) && bard->InFight()) {
    bursts += ({TALENT_FASZINIERENDE_VORSTELLUNG});
  }

  if(sizeof(bursts) > 0) {
    switch(bursts[random(sizeof(bursts))]) {
      case TALENT_ALLEGRO: InspireAllegro(bard); break;
      case TALENT_ERMUTIGENDE_WORTE: InspireHealing(bard); break;
      case TALENT_STAKKATO:  InspireResetSpellpause(bard); break;
      case TALENT_FASZINIERENDE_VORSTELLUNG: InspireFascination(bard); break;
      default: break; // nothing happens
    }
  }
}

public int* GetActiveTalents(object bard) {
  int i;
  int *activeTalents;

  activeTalents = ({ });

  for(i=0; i<MAX_TALENT_NR; ++i) {
    if(HasTalent(bard, i)) {
      activeTalents += ({ i });
    }
  }

  return activeTalents;
}

#define MONTH 2419200 

public int ResetTalents(object bard) {
  string pl;
  pl = getuid(bard);
  if(!CheckIfAllowed()) return -1;
  if(!isBard(pl)) return -2;  
  if(member(lastTalentReset, pl)) {
    if(lastTalentReset[getuid(bard)] + MONTH > time()) {
      return 0;
    }
  }

  bards[pl] = "";
  //lastTalentReset[pl] = time(); --> in der alpha deaktiviert
  return 1;
}

#define SECONDS_IN_A_DAY 86400.0
public float GetRemainingResetDays(object bard) {
  string pl;
  int remainingTime;
  pl = getuid(bard);
  if(!CheckIfAllowed()) return -1.0;
  if(!isBard(pl)) return -2.0;
  if(!member(lastTalentReset, pl)) {
    return 0.0;
  }

  remainingTime = (lastTalentReset[pl] + MONTH - time());

  return  remainingTime / SECONDS_IN_A_DAY;
}

