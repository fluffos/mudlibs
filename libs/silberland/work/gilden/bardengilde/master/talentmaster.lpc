#include "./hero/angara.lpc"
#include "./hero/arcon.lpc"
#include "./hero/flammara.lpc"
#include "./hero/grimm.lpc"
#include "./hero/khartak.lpc"
#include "./hero/nogi.lpc"
#include "./hero/rynoxa.lpc"
#include "./hero/xulgsch.lpc"
#include "./hero/fraggin.lpc"
#include "./hero/zafira.lpc"

#define ON  1
#define OFF 0

public void EnableHeroPassive(object bard) {
  string path, funname;
  path = BARDENMASTER->GetHeroPath(bard);
  if(!path) return; // hat keinen pfad

  if(!BARDENMASTER->HasHeroPathLevel(bard, path, 3)) return;

  funname = sprintf("HeroPassive_%s", capitalize(path));
  if(function_exists(funname, TO)) {
    funcall(symbol_function(funname, TO), bard, ON);
  }
  return;
}

public void DisableHeroPassive(object bard) {
  string path, funname;

  path = BARDENMASTER->GetHeroPath(bard);
  if(!path) return; // hat keinen pfad

  funname = sprintf("HeroPassive_%s", capitalize(path));
  //tell_object(bard, sprintf("disable passive: %s\n", funname));

  if(function_exists(funname, TO)) funcall(symbol_function(funname, TO), bard, OFF);
  return;
}

public void HeroAura(object bard, string skill) {
  string path, funName;
  int success, auraActive, roll;
  path = BARDENMASTER->GetHeroPath(bard);
  if(!path) return;
  if(!BARDENMASTER->HasHeroPathLevel(bard, path, 1)) return;

  

  auraActive = (skill == SK_SINGING && member(({HERO_ANGARA, HERO_FLAMMARA, HERO_GRIMM, HERO_NOGI, HERO_FRAGGIN}), path) >= 0) ||
               (skill == SK_MUSIC   && member(({HERO_ARCON, HERO_KHARTAK, HERO_RYNOXA, HERO_XULGSCH, HERO_ZAFIRA}), path) >= 0);
  if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("HeroAura :: path = %s skill = %s aura = %d\n", path, skill, auraActive));

  if(auraActive) {
    success = bard->UseSkill(SK_HEROISM(path));
    roll = random(MAX_ABILITY);
    if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("%s :: sucess = %d roll = %d\n", SK_HEROISM(path), success, roll));

    if(success < 0) return; // nicht erfolgreich
    if(roll > (success/2)) return; // zu wenig fuer einen effekt

    funName = sprintf("HeroAura_%s", capitalize(path));
    if(function_exists(funName, TO)) call_out(funName, 0, bard);
  } 

  return;
}

// Manche Heldenfaehigkeiten (z.B. Resistenzen) sind passiv durch Inspiration gesteuert, 
// diese Funktion wird beim Wechsel des Inspirationslevels durch das Spellbook aufgerufen, 
// um sie anzupassen.
public void AdaptHeroPowersToInspiration(object bard) {
  string path, adaptFunction;

  path = BARDENMASTER->GetHeroPath(bard);
  if(!path) return; // barde hat keinen pfad oder ist kein barde

  adaptFunction = sprintf("AdaptHeroPower_%s", capitalize(path));
  if(!function_exists(adaptFunction, TO)) return; // Adaptierfunktion existiert nicht -> kein Anpassen

  if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("talentmaster :: AdaptHeroPowersToInspiration :: path = %s\n", path));

  funcall(symbol_function(adaptFunction, TO), bard);
  return;
}

public void AdaptHeroPower_Arcon(object bard) {
  int level, success;
  float resistance;

  if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_ARCON, 3)) return; // nur fuer echte helden

  success = bard->UseSkill(SK_HEROISM(HERO_ARCON));
  level = bard->QueryProp(P_BARD_INSPIRATION_LEVEL);
  resistance = level / 10.0 * ((float) success/MAX_ABILITY);

  if(bard->QueryProp(P_TESTPLAYER)) 
    tell_object(bard, sprintf("talentmaster :: AdaptHeroPower_Arcon :: ilvl = %d success = %d resistance = %.2f\n", level, success, resistance));

  if(level <= 0 || bard->QueryProp(P_ALIGN) < 100 || success <= 0) {
    bard->RemoveResistanceModifier(HERO_ARCON);
    if(bard->QueryProp(P_TESTPLAYER)) 
      tell_object(bard, sprintf("talentmaster :: AdaptHeroPower_Arcon :: RemoveResistanceModifier :: ilvl = %d align = %d\n", level, bard->QueryProp(P_ALIGN)));
    tell_object(bard, BS("Deine Tapferkeit gegen die Kreaturen der Finsternis verebbt."));
    return;
  } else {
    bard->AddResistanceModifier(([DT_UNHOLY: -resistance, DT_TERROR: -resistance]), HERO_ARCON);
  }

  if(to_int(100*resistance) < bard->QueryProp("arcon_last_resistance_bonus")) {
    tell_object(bard, BS("Deine Tapferkeit gegen die Kreaturen der Finsternis laesst nach."));
  } else if( to_int(100*resistance) > bard->QueryProp("arcon_last_resistance_bonus")) {
    tell_object(bard, BS("Deine Tapferkeit gegen die Kreaturen der Finsternis nimmt zu."));
  } // else -> keine meldung
  bard->SetProp("arcon_last_resistance_bonus", to_int(100*resistance));
}

public void AdaptHeroPower_Flammara(object bard) {
  int level, success;
  float resistance;

  if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_FLAMMARA, 3)) return; // nur fuer echte helden

  success = bard->UseSkill(SK_HEROISM(HERO_FLAMMARA));
  level = bard->QueryProp(P_BARD_INSPIRATION_LEVEL) + 1;
  resistance = level / 10.0 * ((float) success/MAX_ABILITY);

  if(bard->QueryProp(P_TESTPLAYER)) 
    tell_object(bard, sprintf("talentmaster :: AdaptHeroPower_Flammara :: ilvl = %d success = %d resistance = %.2f\n", level, success, resistance));

  if(level <= 0 || success <= 0) {
    bard->RemoveResistanceModifier(HERO_FLAMMARA);
    if(bard->QueryProp(P_TESTPLAYER)) 
      tell_object(bard, sprintf("talentmaster :: AdaptHeroPower_Flammara :: RemoveResistanceModifier :: ilvl = %d \n", level));
    tell_object(bard, BS("Dein inneres Feuer erlischt."));
    return;
  } else {
    bard->AddResistanceModifier(([DT_FIRE: -resistance, DT_EXPLOSION: -resistance]), HERO_ARCON);
  }

  if(to_int(100*resistance) < bard->QueryProp("flammara_last_resistance_bonus")) {
    tell_object(bard, BS("Deine innere Flamme wird schwaecher."));
  } else if( to_int(100*resistance) > bard->QueryProp("flammara_last_resistance_bonus")) {
    tell_object(bard, BS("Deine innere Flamme waechst an."));
  } // else -> keine meldung
  bard->SetProp("flammara_last_resistance_bonus", to_int(100*resistance));
  return;
}

public void AdaptHeroPower_Zafira(object bard) {
  int level, success;
  float resistance;

  if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_ZAFIRA, 3)) return; // nur fuer echte helden

  success = bard->UseSkill(SK_HEROISM(HERO_ZAFIRA));
  level = bard->QueryProp(P_BARD_INSPIRATION_LEVEL) + 1;
  resistance = level / 20.0 * ((float) success/MAX_ABILITY);

  if(bard->QueryProp(P_TESTPLAYER)) 
    tell_object(bard, sprintf("talentmaster :: AdaptHeroPower_Zafira :: ilvl = %d success = %d resistance = %.2f\n", level, success, resistance));

  if(level <= 0 || success <= 0) {
    bard->RemoveResistanceModifier(HERO_ZAFIRA);
    if(bard->QueryProp(P_TESTPLAYER)) 
      tell_object(bard, sprintf("talentmaster :: AdaptHeroPowerZafira :: RemoveResistanceModifier :: ilvl = %d \n", level));
    tell_object(bard, BS("Dein Schutz vor den Elementen schwindet."));
    return;
  } else {
    bard->AddResistanceModifier(([DT_FIRE: -resistance, DT_POISON: -resistance, 
                                 DT_COLD: -resistance, DT_AIR: -resistance, 
                                 DT_WATER: -resistance]), HERO_ARCON);
  }

  if(to_int(100*resistance) < bard->QueryProp("zafira_last_resistance_bonus")) {
    tell_object(bard, BS("Dein elementarer Schutz wird schwaecher."));
  } else if( to_int(100*resistance) > bard->QueryProp("zafira_last_resistance_bonus")) {
    tell_object(bard, BS("Dein elementarer Schutz nimmt zu."));
  } // else -> keine meldung
  bard->SetProp("zafira_last_resistance_bonus", to_int(100*resistance));
  return;
}


public void AdaptHeroPower_Grimm(object bard) {
  int level, success;
  int strengthIncrease, currentStrBonus;
  object brosche;
  mapping attrMod;

  if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_GRIMM, 3)) return; // nur fuer echte helden

  success = bard->UseSkill(SK_HEROISM(HERO_GRIMM));
  level = bard->QueryProp(P_BARD_INSPIRATION_LEVEL);
  strengthIncrease = (int) (level * 1.4 * ((float) success/MAX_ABILITY));
  if(strengthIncrease > 7) {
    strengthIncrease = 0;
  }

  if(bard->QueryProp(P_TESTPLAYER)) 
    tell_object(bard, sprintf("talentmaster :: AdaptHeroPower_Grimm :: ilvl = %d success = %d strength = %d\n", level, success, strengthIncrease));

  if(!objectp(brosche=present("\nbardenbrosche", bard))) return;

  if(strengthIncrease > 0) {
    attrMod = brosche->QueryProp(P_X_ATTR_MOD);
    if(mappingp(attrMod) && member(attrMod, A_STR)) {
      currentStrBonus = attrMod[A_STR];
    } else {
      currentStrBonus = 0;
    }
  } else {
    brosche->SetProp(P_X_ATTR_MOD, 0);
    tell_object(bard, BS("Grimms Kraft verlaesst dich und du schrumpfst zu deinem alten Selbst."));
    return;
  }

  brosche->SetProp(P_X_ATTR_MOD, ([A_STR: strengthIncrease]));
  if(strengthIncrease > currentStrBonus) {
    tell_object(bard, BS("Du waechst und deine Muskeln schwellen an."));
  } else if(strengthIncrease < currentStrBonus) {
    tell_object(bard, BS("Ein Teil von Grimms Kraft verlaesst dich und du wirst etwas kleiner."));
  }

  return;
}

