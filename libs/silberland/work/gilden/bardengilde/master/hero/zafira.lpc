#define ZAFIRA_RANDOM_ELEMENT ({"feuer", "wasser", "eis", "humus", "luft", "erz"})[random(6)]

public void HeroAura_Zafira(object player) {
    int  i, insp;
    object mindergeist;
    string e1, e2;

    if(present("\ndruiden_mindergeist 3", environment(player))) return; // genug geister da
  
    tell_object(player, BS("Deine Musik lockt einen kleinen, elementaren Mindergeist an."));
    tell_room(environment(player), BS(player->Name(WESSEN, 1)+" Musik lockt einen kleinen, elementaren Mindergeist an."), ({player}));

    insp = player->QueryProp(P_BARD_INSPIRATION_LEVEL);
    mindergeist = clone_object("/gilden/druidenzirkel/npc/mindergeist");

    e1 = e2 = ZAFIRA_RANDOM_ELEMENT;
    while(e1 == e2) {
      e2 = ZAFIRA_RANDOM_ELEMENT;
    }

    if(player->QueryProp(P_TESTPLAYER)) {
      tell_object(player, sprintf("zafira :: mindergeist e1=%s e2=%s\n", e1, e2));
    }

    mindergeist->setElements(e1, e2);
    if(mindergeist->move(environment(player), M_GO|M_SILENT) != 1) {
      tell_object(player, BS("Der Mindergeist war instabil und ist sofort implodiert."));
      mindergeist->remove(1);
    }
    mindergeist->setCaster(player, insp);
  }
  
  public void HeroPassive_Zafira(object bard, int onoff) {
    object ob;  
    if(!objectp(bard)) return;
    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_ZAFIRA, 3)) return;
    if(!objectp(ob=present("\nbardenbrosche", bard))) return; // keine Brosche, keine Faehigkeiten

    if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("HeroPassive_Zafira :: onoff = %d\n", onoff));

    if(onoff) {
      tell_object(bard, BS("Mit einem Zischen erfuellt dich Zafiras elementare Macht."));
    } else {
      tell_object(bard, BS("Zafiras elementare Macht verlaesst dich."));
    }
  
    return;
  }
  