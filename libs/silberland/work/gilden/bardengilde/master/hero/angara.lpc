public void HeroAura_Angara(object player) {
    int i;
    object *enemies;
  
    if(!player->InFight()) return;
  
    tell_object(player, BS("Du triffst die magieneutralisierenden Toene Angaras und blockierst die Magie deiner Feinde!"));
    tell_room(environment(player), BS(player->Name(WER) + " trifft besonders magieneutralisierende Toene!"), ({player}));
    enemies = player->PresentEnemies();
    for(i=0; i<sizeof(enemies); ++i) {
      if(enemies[i]->QueryProp(P_NOMAGIC) && random(101) < enemies[i]->QueryProp(P_NOMAGIC)) {
        tell_object(player, BS(sprintf("%s durchbricht deinen Magiebann!", enemies[i]->name(WER, 1))));
        continue;
      }
      if(!enemies[i]->QueryProp(P_DISABLE_SPELLS)) enemies[i]->SetProp(P_DISABLE_SPELLS, player->QueryProp(P_BARD_INSPIRATION_LEVEL) + 1);
    }
  }
  
  public void HeroPassive_Angara(object bard, int onoff) {
    object ob;  
    if(!objectp(bard)) return;
    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_ANGARA, 3)) return;
  
    if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("HeroPassive_Angara :: onoff = %d\n", onoff));
  
    if(onoff) {
      if(objectp(bard->QueryProp("bard_angara_protection"))) return; // bereits aktiver schutz
  
      ob = clone_object(NPC("angara_antimagic"));
      ob->move(environment(bard), M_NOCHECK);
      ob->Setup(bard);
      bard->SetProp("bard_angara_protection", ob);
    } else if(objectp(bard->QueryProp("bard_angara_protection"))) {
        bard->QueryProp("bard_angara_protection")->remove(1);
        tell_object(bard, BS("Angaras Heldenmacht loest sich um dich herum auf."));
    }
  
    return;
  }
  