public int isHeroAura_FragginTarget(object ob) {
  return interactive(ob);
}

#define RANDOM_DRINK_OR_FOOD ({ \
  "den naechsten Schnaps", \
  "ein kuehles Blondes", \
  "'nen sueffigen Wein", \
  "einen saftigen Schinken", \
  "ein kraeftiges Schwarzbier", \
  "einen sauberen Magenbitter", \
  "ein paar Broetchen", \
  "a guads Lebakassemmal", \
  "eine Brezel zum Bier", \
  "'ne gscheite Mass", \
  "eine Portion Knoedel", \
  "ein leckeres Dessert", \
  "noch eine Portion", \
  "'was zum vorgluehen", \
  "den rauchigen Whiskey", \
  "eine Marmeladepalatschinke", \
  "eine Weisswurscht zur Mass", \
  "ein Heringsbroetchen", \
  "den naechsten Pina Colada"})[random(19)]

public void HeroAura_Fraggin(object player) {
    int  i, insp;
    object *people;
  
    insp = player->QueryProp(P_BARD_INSPIRATION_LEVEL);
    people = filter_array(all_inventory(environment(player)), "isHeroAura_FragginTarget", TO, player);
    for(i=0; i<sizeof(people); ++i) {
      if(!objectp(people[i])) continue;
      if(people[i]->QueryProp(P_FOOD) == 0 && people[i]->QueryProp(P_DRINK) == 0) continue;

      tell_object(people[i], BS(sprintf("Die Musik von %s bringt deine Verdauung ordentlich in Schwung. Wo gibt's denn hier %s?", 
                   player->name(WEM, 1), RANDOM_DRINK_OR_FOOD)));
      people[i]->eat_food(insp*-3);
      people[i]->drink_drink(insp*-3, 0);
    }
  }
  
  public void HeroPassive_Fraggin(object bard, int onoff) {
    object ob;  
    if(!objectp(bard)) return;
    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_FRAGGIN, 3)) return;
    if(!objectp(ob=present("\nbardenbrosche", bard))) return; // keine Brosche, keine Faehigkeiten

    if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("HeroPassive_Fraggin :: onoff = %d\n", onoff));

    if(onoff) {
      tell_object(bard, BS("Dein Magen knurrt. Es ware wohl mal wieder Zeit fuer ein Festmahl, ganz im Gedenken an Fraggin! Und ein Bier!"));
      ob->enableFraggin();
    } else {
      tell_object(bard, BS("Deine Lust auf Speis und Trank verlaesst dich. Vielleicht hast du Fraggin genug gedacht."));
      ob->disableFraggin();
    }
  
    return;
  }
  