
public void HeroAura_Grimm(object player) {
    int damage;
    object *enemies, enemy;
    string dtype;
  
    if(!player->InFight()) return;
  
    enemies = player->PresentEnemies();
    if(sizeof(enemies) < 1) return;
    enemy = enemies[random(sizeof(enemies))];
  
    tell_object(player, 
        BS(sprintf("Die riesenhafte Staerke Grimms durchfaehrt dich und du schlaegst %s zu Boden!", enemy->name(WEN, 1))));
    tell_room(environment(player), 
        BS(sprintf("%s Musklen schwellen unglaublich an und %s schlaegt %s mit einem Hieb zu Boden!", 
           player->Name(WER, 1), player->QueryPronoun(), enemy->name(WEN, 1))), 
        ({player}));
        
    damage = (int) (player->QueryProp(P_HANDS)[1] * ((float) 1.2 + (player->QueryProp(P_BARD_INSPIRATION_LEVEL)/10.0)));
    dtype = player->QueryProp(P_HANDS)[2];
  
    enemy->Defend(damage, dtype, ([SP_NAME: "bard_power_grimm", SP_SHOW_DAMAGE: 1, SP_PHYSICAL_ATTACK: 1]), player);
    if(objectp(enemy)) { // koennte tot sein
      enemy->SetProp(P_DISABLE_ATTACK, 1);
      enemy->SetProp(P_LAST_RAMMEN_TIME, time());
    }
    
    return;
  }
  
  public void HeroPassive_Grimm(object bard, int onoff) {
    object ob;  
    if(!objectp(bard)) return;
    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_GRIMM, 3)) return;
    if(!objectp(ob=present("\nbardenbrosche", bard))) return; // keine Brosche, keine Faehigkeiten
  
    if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("HeroPassive_Grimm :: onoff = %d\n", onoff));
  
    if(onoff) {
      ob->enableGrimm();
    } else {
      ob->disableGrimm();
    }
  
    return;
  }