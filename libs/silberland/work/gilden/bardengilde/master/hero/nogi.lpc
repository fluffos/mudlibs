public void HeroAura_Nogi(object player) {
    object *enemies, enemy, *allies, ally, weapon;
    int aopDifficulty, damage, dexPenalty;
    mixed damage_type;

    if(!objectp(player)) return;

    if(!player->InFight()) return;

    enemies = player->PresentEnemies();
    if(sizeof(enemies) < 1) return;

    tell_object(player, 
        BS(sprintf("Nogis Heldenmut packt dich und du ziehst die Aufmerksamkeit deiner Feinde auf dich!")));
    tell_room(environment(player), 
        BS(sprintf("%s wird von ploetzlichem Heldenmut uebermannt und zieht die Aufmerksamkeit eurer Feinde auf sich!", 
        player->Name(WER, 1))), ({player}));

    enemy = enemies[random(sizeof(enemies))];
    if(!objectp(enemy)) return;

    if(player->QueryProp(P_BARD_INSPIRATION_LEVEL) > 5) {
      dexPenalty = player->QueryProp(P_BARD_INSPIRATION_LEVEL) - 5;
    } else {
      dexPenalty = 0;
    }

    allies = findAlliesInSameRoomAs(enemy);
    ally = allies[random(sizeof(allies))];
    aopDifficulty = ally->QueryAttribute(A_DEX) + (player->QueryAttribute(A_DEX)/(6-player->QueryProp(P_BARD_INSPIRATION_LEVEL)));
    if(enemy->QueryAttribute(A_DEX)-dexPenalty < random(aopDifficulty)) {
      tell_object(ally, BS(sprintf("Du nutzt die Ablenkung aus und landest einen besonders guten Angriff gegen %s!", enemy->name(WEN, 1))));
      tell_room(environment(ally), BS(sprintf("%s nutzt die Ablenkung aus und landet einen besonders guten Angriff gegen %s!", 
                ally->Name(WER, 1), enemy->name(WEN, 1))), ({ally}));

      if (objectp(weapon = ally->QueryProp(P_WEAPON))) {
        damage = weapon->QueryDamage(enemy);
        damage_type = weapon->QueryProp(P_DAM_TYPE);
      } else {
        damage = ally->QueryProp(P_HANDS)[1];
        damage_type = ally->QueryProp(P_HANDS)[2];
      }

      damage = (int) (damage * (1.3 + (random(player->QueryProp(P_BARD_INSPIRATION_LEVEL))/10)));
      enemy->Defend(damage, damage_type, ([SP_SHOW_DAMAGE: 1]), ally);
    }

    enemy->SetProp(P_PREFERED_ENEMY, ({50 + player->QueryProp(P_BARD_INSPIRATION_LEVEL) * 10, player}));
    tell_object(player, BS(sprintf("%s konzentriert seine Angriffe jetzt auf dich!", enemy->Name(WER, 1))));
    return;
}

public void HeroPassive_Nogi(object bard, int onoff) {
    object ob;  
    if(!objectp(bard)) return;
    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_NOGI, 3)) return;
    if(!objectp(ob=present("\nbardenbrosche", bard))) return; // keine Brosche, keine Faehigkeiten
  
    if(onoff) {
      ob->enableNogi();
    } else {
      ob->disableNogi();
    }
  
    return;
  }