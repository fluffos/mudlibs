
public void HeroAura_Khartak(object player) {
    int damage, i;
    object *enemies, enemy, weapon;
    string *dtype;
  
    if(!objectp(player)) return;

    if(player->QueryProp(P_TESTPLAYER))
        tell_object(player, sprintf("HeroAura_Khartak :: start\n"));

    if(!player->InFight()) return;
    if(!objectp(weapon=player->QueryProp(P_WEAPON))) return;
  
    enemies = player->PresentEnemies();
    if(sizeof(enemies) < 1) return;
  
    tell_object(player, 
      BS(sprintf("Die Kampfeswut des Helden Khartak durchfaehrt dich und du stuerzt dich in den Kampf!")));
    tell_room(environment(player), 
      BS(sprintf("%s wird von Kampfeswut gepackt und stuerzt sich auf %s Feinde!", player->Name(WER, 1), player->QueryPronoun(WESSEN))), ({player}));
    for(i=0; i<player->QueryProp(P_BARD_INSPIRATION_LEVEL)+1; ++i) {
      enemy = enemies[random(sizeof(enemies))];
      if(!objectp(enemy)) continue;
      damage = (weapon->QueryProp(P_WC)/2  + random(weapon->QueryProp(P_WC)/2));
      dtype = weapon->QueryProp(P_DAM_TYPE);
  
      enemy->Defend(damage, dtype, ([SP_NAME: "bard_power_khartak", SP_SHOW_DAMAGE: 1, SP_PHYSICAL_ATTACK: 1]), player);
    }
    return;
  }
  
  public void HeroPassive_Khartak(object bard, int onoff) {
    if(!objectp(bard)) return;
    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_KHARTAK, 3)) return;
  
    if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("HeroPassive_Khartak :: onoff = %d\n", onoff));
  
    if(onoff) {
      tell_object(bard, BS("Khartaks Heldenmacht durchstroemt dich. Du spuehrst eine intuitive Meisterschaft im "
                           "Umhang mit allen Waffen."));
      bard->ModifySkill(SK_FIGHT, ([SI_SKILLABILITY: 0, SI_SKILLFUNC: "Khartak_FightSkill"]), 100, "bardengilde");
    } else {
      if(member(bard->QueryProp(P_NEWSKILLS), SK_FIGHT)) {
        tell_object(bard, BS("Khartaks Heldenmacht weicht aus dir. Du hast keine Ahnung mehr wie man mit Waffen umgeht."));
        bard->SetProp(P_NEWSKILLS, m_delete(bard->QueryProp(P_NEWSKILLS), SK_FIGHT));
      }
    }
  
    return;
  }