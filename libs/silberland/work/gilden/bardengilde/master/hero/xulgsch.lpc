public void HeroAura_Xulgsch(object player) {
    int i, inspiration;
    object *enemies, ob;
    string fluch;

    fluch = call_other("/spellbooks/nekro_spells", "random_fluch");
  
    if(!player->InFight()) return;

    if(player->QueryProp(P_ALIGN) > -100) {
      tell_object(player, BS(sprintf("%s Du ekelst dich vor deiner guten Gesinnung! Nur das Boese kann die "
                                     "Kraft von Xulgsch entfeseeln!")));
      return;
    }
  
    tell_object(player, BS(sprintf("%s Eine Welle nekrotischer, rot-schwarzer Energie breitet sich von dir aus!",
                                   fluch)));
    tell_room(environment(player), BS(sprintf("Ein Pulsieren nekrotischer, rot-schwarzer Energie geht sich von %s aus!",
                                              player->name(WEM, 1))), ({player}));

    enemies = player->PresentEnemies();
    inspiration =  player->QueryProp(P_BARD_INSPIRATION_LEVEL);
    if(player->QueryProp(P_TESTPLAYER)) tell_object(player, sprintf("xulgsch::aura enemies=%O\n", enemies));

    for(i=0; i<sizeof(enemies); ++i) {
      if(enemies[i]->QueryProp(P_ALIGN) < 0) continue;
      if(enemies[i]->QueryProp(P_NOMAGIC) && random(101) < enemies[i]->QueryProp(P_NOMAGIC)) {
        tell_object(player, BS(sprintf("%s durchbricht deinen Magiebann!", enemies[i]->name(WER, 1))));
        continue;
      }

      if(player->QueryProp(P_TESTPLAYER)) tell_object(player, sprintf("xulgsch::aura enemy=%O\n", enemies[i]));

      switch(random(4)) {
        case 0:
          tell_room(environment(enemies[i]), BS(sprintf("%s windet sich vor unsaeglichen Scherzen!", enemies[i]->Name(WER, 1))));
          enemies[i]->Defend(50 + inspiration*20, DT_UNHOLY, 
                             ([SP_SHOW_DAMAGE: 1, SP_NAME: "Schmerzwelle"]), player);
          break;
        case 1:
          tell_room(environment(enemies[i]), BS(sprintf("%s Muskeln verkuemmern!", enemies[i]->Name(WESSEN, 1))));
          ob = clone_object(OBJ("bonus"));
          ob->AddId("\nbard_xulgsch_debuff");
          ob->move(enemies[i], M_NOCHECK);
          ob->SetEndMessage("Deine Gliedmassen erholen sich wieder.");
          ob->SetProp(P_X_ATTR_MOD, ([A_STR: inspiration+random(inspiration)]));
          ob->SetTimeout(player->QueryProp(P_BARD_INSPIRATION_LEVEL) * 5);
          break;
        case 2:
          tell_room(environment(enemies[i]), BS(sprintf("%s Haut wird von widerlichen und eitrigen Geschwueren bedeckt!", enemies[i]->Name(WESSEN, 1))));
          if(!interactive(enemies[i])) {
            enemies[i]->SetProp(P_BODY, enemies[i]->QueryProp(P_BODY) - inspiration*5);
          }
          break;
        default:
          tell_room(environment(enemies[i]), BS(sprintf("%s Gelenke und Knochen brechen!", enemies[i]->Name(WESSEN, 1))));
          ob = clone_object(OBJ("bonus"));
          ob->AddId("\nbard_xulgsch_debuff");
          ob->move(enemies[i], M_NOCHECK);
          ob->SetEndMessage("Deine Gliedmassen erholen sich wieder.");
          ob->SetProp(P_X_ATTR_MOD, ([A_DEX: inspiration+random(inspiration)]));
          ob->SetTimeout(player->QueryProp(P_BARD_INSPIRATION_LEVEL) * 5);
          break;
      }
    }
  }
  
  public void HeroPassive_Xulgsch(object bard, int onoff) {
    object ob;  
    if(!objectp(bard)) return;
    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_XULGSCH, 3)) return;

    if(onoff) {
      tell_object(bard, BS("Dein Hass auf das Gute waechst an! Der Geist von Xulgsch steht dir bei um es ZU VERNICHTEN!!!"));
    } else {
      tell_object(bard, BS("Dein Hass auf das Gute verebbt. Du spuehrst wie der Geist von Xlugsch dich verlaesst..."));
    }
  
    return;
  }
  