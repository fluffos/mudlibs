public void flammara_burn_victim(object target, int turns, object bard) {
    if(!objectp(target)) return;
    target->Defend(100, DT_FIRE,
      ([SP_NAME: "barden_flammara_brennen", SP_SHOW_DAMAGE:
        ({
           ({ -1, "Die Flammen koennen dir nichts anhaben.",
                  "Die Flammen machen @WEM1 nichts aus.",
                  ""}),
           ({  0, "Kleine Flaemmchen tanzen unangenehm ueber dich.",
                  "Kleine Flaemmchen tanzen ueber @WEN1.",
                  "Kleine Flaemmchen tanzen ueber @WEN1."}),
           ({  5, "Die Flammen verbrennen dich!",
                  "Kleine Flammen schlagen aus @WEM1.",
                  "Kleine Flammen schlagen aus @WEM1."}),
           ({ 10, "Die Flammen verbrennen dich stark!",
                  "Flammen schlagen aus @WEM1.",
                  "Flammen schlagen aus @WEM1." }),
           ({ 15, "Eine Stichflamme schlaegt aus dir.",
                  "Eine Stichflamme schlaegt aus @WEM1.",
                  "Eine Stichflamme schlaegt aus @WEM1."}),
           ({ 20, "Du verkohlst unter dem Feuer von @WEM2.",
                  "@WER1 verkohlt unter gleissendem Feuer!",
                  "@WER1 verkohlt unter gleissendem Feuer!"}),
       })]), bard);

    if(!objectp(target))
       return; // ziel tot
       
    if(--turns > 0) {
        call_out("flammara_burn_victim", 0, target, turns, bard);
    } else {
        tell_room(environment(target), BS(target->Name(WER) + " brennt nicht mehr."));
    }
    return;
  }
  
  public void HeroAura_Flammara(object player) {
    int i;
    object *enemies;
  
    if(!player->InFight()) return;
  
    tell_object(player, BS("Du singst die Worte der Flamme und steckst deine Feinde in Brand!"));
    tell_room(environment(player), BS(player->Name(WER) + " singt die brennenden Worte der Flamme!"), ({player}));
    enemies = player->PresentEnemies();
    for(i=0; i<sizeof(enemies); ++i) {
      if(enemies[i]->QueryProp(P_NOMAGIC) && random(101) < enemies[i]->QueryProp(P_NOMAGIC)) {
        tell_object(player, BS(sprintf("%s widersteht deinen feurigen Worten!", enemies[i]->name(WER, 1))));
        continue;
      }
      call_out("flammara_burn_victim", 0, enemies[i], player->QueryProp(P_BARD_INSPIRATION_LEVEL), player);
    }
    return;
  }