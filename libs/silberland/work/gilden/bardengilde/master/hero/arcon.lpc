
public int isHeroAura_ArconTarget(object ob) {
    return living(ob) && ob->QueryProp(P_ALIGN) > 100;
  }
  
  public void HeroAura_Arcon(object player) {
    int  i, align, cnt;
    object *people;
  
    if(player->QueryProp(P_ALIGN) < 100) return; // nur gute spieler koennen Arcon verkoerpern
    
    cnt = 0;
    people = filter_array(all_inventory(environment(player)), "isHeroAura_ArconTarget");
    for(i=0; i<sizeof(people); ++i) {
      if(player->IsEnemy(people[i])) continue;
      if(people[i]->QueryProp("bard_arcon_last_inspire") + 10 > time()) continue;
  
      align = people[i]->QueryProp(P_ALIGN) - 200;
      if(align>1000) align = 1000;
  
      people[i]->ModifySkillAttribute(player, SA_DAMAGE, 100 + (align/10), player->QueryProp(P_BARD_INSPIRATION_LEVEL));
      people[i]->SetProp("bard_arcon_last_inspire", time());
  
      if(player != people[i]) tell_object(people[i], BS(sprintf("Die strahlende Praesenz von %s inspiriert die Kraft des Guten in dir!", player->name(WEM, 1))));
      cnt++;
    }
  
    if(cnt) tell_object(player, BS("Deine Praesenz inspiriert das die Kraft des Guten in deinen Verbuendeten!"));
  }
  
  public void HeroPassive_Arcon(object bard, int onoff) {
    object ob;  
    if(!objectp(bard)) return;
    if(!BARDENMASTER->HasHeroPathLevel(bard, HERO_ARCON, 3)) return;
  
    if(bard->QueryProp(P_TESTPLAYER)) tell_object(bard, sprintf("HeroPassive_Arcon :: onoff = %d\n", onoff));
  
    if(onoff) {
      tell_object(bard, BS("Arcons Heldenmacht durchfaehrt dich. Du bist ein starker Kaempfer wider das Boese!"));
    } else {
      tell_object(bard, BS("Arcons Heldenmacht loest sich um dich herum auf."));
    }
  
    return;
  }