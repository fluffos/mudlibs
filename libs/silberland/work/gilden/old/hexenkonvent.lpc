inherit  "/std/gilde";
inherit "/std/gilden_ob";
#include <properties.h>
#include <rooms.h>
#include <wizlevels.h>
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/unterwelt/amazora/hexenkonvent/gilde.h"

void create() {
  ::create();
SetProp( P_LIGHT, 1);
SetProp( P_INDOORS, 1);
SetProp( P_INT_SHORT, "Der Treffpunkt des Hexenkonvents");
SetProp( P_INT_LONG, 
"Du bist hier in der Anmeldung zum Hexenkonvent.\n"
+"Alles leuchtet wie in einem magischen blauen Licht eingetaucht. In der Mitte\n"
+"des Raumes steht ein grosser Steinaltar.\n");
AddDetail( ({"altar", "steinaltar"}),
"In der Mitte des Raumes steht ein grosser Steinaltar ueber dem ein rotes Seidentuch gespannt ist.\n");
AddDetail( "tuch",
"Ein dunkelrotes Seidentuch auf dem einige Dinge liegen.\n");
AddDetail( "dinge",
"Ein Kelch, ein grosses Buch und ein Dolch liegen auf dem Tuch.\n");
AddDetail( "kelch",
"Ein Kelch mit einer roten Fluessigkeit.\n");
AddDetail(" buch",
"Ein magisches Buch.\n");
AddDetail( ({"dolch", "ritualdolch"}),
"Ein typischer Ritualdolch.\n");

SetProp(P_GUILD_DEFAULT_SPELLBOOK,"hexen_sp");
SetProp(P_GUILD_RESTRICTIONS,
         ([ P_LEVEL: 3,
            P_QP: 50,  
            SR_FUN: "LevelTestFun1" ])); 
SetProp(P_GUILD_MALE_TITLES,
([ 1 : "der Anfaenger-Hexer",
    2 : "der kleine Hexer",
    3 : "der Hexenlehrling",
    4 : "der Wahrsager",
    5 : "der Kraeuterhexer",
    6 : "der Schamane",
    7 : "der Teufelshexer",
    8 : "der Oberhexer",
    9 : "der Hexenmeister",
   10 : "der Hohepriester"]));
 SetProp(P_GUILD_FEMALE_TITLES,
 ([ 1 : "die Anfaenger-Hexe",
    2 : "die kleine Hexe", 
    3 : "die Hexenadeptin",
    4 : "die Wahrsagerin",
    5 : "die Kraeuterhexe",
    6 : "die Schamanin", 
    7 : "die Teufelshexe",
    8 : "die Oberhexe",
    9 : "die Hexenmeisterin",
10 : "die Hohepriesterin", ]));
  SetProp(P_GUILD_LEVELS,
([ 1 : ([P_LEVEL : 3, P_QP : 50,
   SR_FUN: "LevelTestFun1" ]),
   2 : ([P_LEVEL : 5,
   SR_FUN: "LevelTestFun2" ]),
   3 : ([P_LEVEL : 6,
   SR_FUN: "LevelTestFun3" ]),
   4 : ([P_LEVEL : 10, P_QP : 150, 
   A_INT:5,
   SR_FUN : "LevelTestFun4" ]),
   5 : ([P_LEVEL : 12, 
   A_INT:10, A_CON:10,
   SR_FUN : "LevelTestFun5" ]),
   6 : ([P_LEVEL : 12, P_QP : 200,
   SR_FUN : "LevelTestFun6" ]),
   7 : ([P_LEVEL : 15,
   A_INT:15, A_DEX:10, A_STR:10, A_CON:10,
   SR_FUN : "LevelTestFun7" ]),
   8 : ([P_LEVEL : 18,
 SR_FUN : "LevelTestFun8" ]),
   9 : ([P_LEVEL : 21,  P_QP: 1600,
   A_CON:19, A_STR:15, A_DEX:17, A_INT:19,
   SR_FUN : "LevelTestFun9" ]),
   10 : ([ P_LEVEL: 25, P_QP: 1850,
   A_CON:20, A_STR:19, A_DEX:19, A_INT:20,
   SR_FUN : "LevelTestFun10" ]) ]) );
 AddSpell( "erhelle");
 AddSpell( "liebeszauber");
 AddSpell( "wahrsagen");
 AddSpell( "schaetze");
 AddSpell( "voodoo");
 AddSpell( "voodooschaden");
 AddSpell( "berausche");
 AddSpell( "entschlacke");
 AddSpell( "gewitter");
 AddSpell( "heile");
 AddSpell( "vergifte");
 AddSpell( "entgifte");
 AddSpell( "sturm");
 AddSpell( "teleportiere");
 AddSpell( "verfrosche");
 AddSpell( "entfrosche");
 AddSpell( "schuetze");
 AddSpell( "rabe");
 AddSpell( "fledermaus");
 AddSpell( "katze");
 AddSkill(SK_NIGHTVISION, ([ SI_SKILLFUNC : "nightvision" ]));
 AddCmd(({"tritt","trete"}),"bei_oder_aus_treten");
 AddCmd(({ "lerne", "lern" }), "OwnLearnSpell" );
 AddItem(" /d/unterwelt/amazora/hexenkonvent/npc/katherina",  REFRESH_REMOVE);
 AddItem(" /d/unterwelt/amazora/hexenkonvent/npc/lilith", REFRESH_REMOVE);
 AddExit( "oben", HEXEN_GILDEN_ROOM( "blocksberg1" ));
}

int austreten()
{
  if( !present( "lilith", this_object()))
        {
        write( "Lilith ist nicht da. Ohne sie laeuft hier gar nichts.\n");
        return 1;
     }
  write( "Du musst wissen, was Du tust.\n");
  this_player()->SetProp( P_GUILD_LEVEL, 0);
  HEXEN_GILDEN_MASTER->LoescheMitglied( getuid(this_player()));
  log_file( "amazora/gilde", capitalize(getuid(this_player()))+" ist am "+
    dtime(time())+" ausgetreten.\n");
  return ::austreten();
}


int beitreten()
{
  if( !present( "lilith", this_object()))
        {
        write( "Lilith ist nicht da. Ohne sie laeuft hier gar nichts.\n");
        return 1;
        }
  if( this_player()->QueryProp( P_GUILD) == "hexen" )
        {
        write( "Du bist schon ein Mitglied dieser Gilde.\n");
 return 1;
        }
  if(::beitreten() < 0) return 1;
  log_file( "amazora/gilde", capitalize(getuid(this_player()))+" ist am "+
    dtime(time())+" in die Gilde eingetreten.\n");
  write( "Willkommen im Hexenkonvent! Moege die grosse Lilith mit Dir sein!\n");
  HEXEN_GILDEN_MASTER->NeuesMitglied( getuid( this_player()));
return ::beitreten();
}

advance(string str)
{
  mixed r;
  notify_fail(
  "Was moechtest Du erhoehen: Deine Spielerstufe oder Deine Gildenstufe?\n"+
  "Syntax: erhoehe <spielerstufe | gildenstufe>\n"+
  "oder:   erhoehe <spieler      | gilde>\n");
  if(!str)return 0;
  if(str!="spielerstufe"&&str!="spieler"&&str!="gilde"&&str!="gildenstufe")
     return 0;
if(str=="gilde"||str=="gildenstufe")r=gilden_ob::try_advance();
  else r=gilde::advance();
  if(r){
    adjust_title(this_player());
    write("Eine flammende Aura umgibt Dich. Moege die grosse Lilith mit Dir sein.\n");
    }
  return r;
}
OwnLearnSpell(string str)
{
  notify_fail("Was moechtest Du hier lernen?\n");
  if(!str){
    write("Du kannst hier folgende Sprueche lernen:\n"+
 "erhelle             : Ab Gildenstufe 1.\n"+
 "liebeszauber        : Ab Gildenstufe 1.\n"+
 "wahrsagen           : Ab Gildenstufe 2.\n"+
 "schaetze            : Ab Gildenstufe 2.\n"+
 "voodoo              : Ab Gildenstufe 3.\n"+
 "voodooschaden       : Ab Gildenstufe 4.\n"+
 "berausche           : Ab Gildenstufe 5.\n"+
 "entschlacke         : Ab Gildenstufe 5.\n"+
 "gewitter            : Ab Gildenstufe 6.\n"+
 "vergifte            : Ab Gildenstufe 7.\n"+
 "entgifte            : Ab Gildenstufe 7.\n"+
 "verfrosche          : Ab Gildenstufe 8.\n"+
 "entfrosche          : Ab Gildenstufe 8.\n"+
 "heile               : Ab Gildenstufe 9.\n"+
 "sturm               : Ab Gildenstufe 9.\n"+
 "teleportiere        : Ab Gildenstufe 10.\n"+
 "schuetze            : Ab Gildenstufe 10.\n"+
 "Du kannst ja mal Lilith nach den einzelnen Zauberspruechen befragen.\n");
 return 1;
        }
  return LearnSpell(str);
}

