#define NEEDED_XP 0
#define NEEDED_QUEST 1
#define EXAM_ROOM 2
#define NEEDED_ARCHENEMYS 3
#define TASK_OBJECT 4

//--Vorfunktionen-------------------------------------------------------------
mapping Dolchkampf(object player, string skill, mapping sinfo);
mapping Bogenkampf(object player, string skill, mapping sinfo);
mapping Beweglichkeit(object player, string skill, mapping sinfo);
mapping Kraeuterkunde(object player, string skill, mapping sinfo);
string topliste();
void Channel(string msg);
string cap_skill(string str);
nosave mixed advance(string str);
nosave varargs int advance2();
string Lcond(object ob) ;
private void generateZauberliste();

//--Variablen-----------------------------------------------------------------
mapping guild_titles_male=([
          KREIS_1: "der Lehrling des Waldes"; "der Faehrtensucher";
                   "der Pfadfinder"; "der Kraeuterkundige"; 
                   "der Wildnisexperte",
          KREIS_2: "der Bewahrer des Waldes"; "der Waldakrobat"; 
                   "der Waldschleicher"; "der Waldgeist"; 
                   "der Hueter der Flamme"]);
mapping guild_titles_female=([
          KREIS_1: "der Lehrling des Waldes"; "die Faehrtensucherin"; 
                   "die Pfadfinderin"; "die Kraeuterkundige"; 
                   "die Wildnisexpertin",
          KREIS_2: "die Bewahrerin des Waldes"; "die Waldakrobatin"; 
                   "die Waldschleicherin"; "der Waldgeist"; 
                   "die Hueterin der Flamme"]);
mapping path_titles_male=([
          MESSER_PFAD: "der Messerkaempfer"; "der Messerwerfer"; 
                       "der Klingenwirbel"; "'Das Messer'"; 
                       "die Rache des Waldes",
          BOGEN_PFAD: "der Pfeilemacher"; "der Bogenschuetze"; 
                      "der Meisterschuetze"; "'Der stille Tod'"; 
                      "die Rache des Waldes",
          TIERMEISTER_PFAD:  "der Tierfluesterer"; "der Freund der Tiere";
                             "der Tierbaendiger"; "der Beschuetzer der Tiere";
                             "der Tiermeister",
          BESCHWOERER_PFAD:  "der Tierrufer"; "der Tierbeschwoerer";
                             "der Wolfsmeister"; "der Baerenmeister";
                             "der Spinnenmeister",
          IAMA_PFAD: "der Floetenspieler"; "der Melodienwahrer";
                     "der Meisterspieler";  "der Bewahrer der Melodie";
                     "der Meister der Iama"]);
mapping path_titles_female=([
          MESSER_PFAD: "die Messerkaempferin"; "die Messerwerferin"; 
                       "der Klingenwirbel"; "'Das Messer'"; 
                       "die Rache des Waldes",
          BOGEN_PFAD: "die Pfeilemacherin"; "die Bogenschuetzin"; 
                      "die Meisterschuetzin"; "'Der stille Tod'"; 
                      "die Rache des Waldes",
          TIERMEISTER_PFAD:  "die Tierfluesterin"; "die Freundin der Tiere";
                             "die Tierbaendigerin"; 
                             "die Beschuetzerin der Tiere";
                             "die Tiermeisterin",
          BESCHWOERER_PFAD:  "die Tierruferin"; "die Tierbeschwoererin";
                             "die Wolfsmeisterin"; "die Baerenmeisterin";
                             "die Spinnenmeisterin",
          IAMA_PFAD: "die Floetenspielerin"; "die Melodienwahrerin";
                     "die Meisterspielerin";  "die Bewahrerin der Melodie";
                     "die Meisterin der Iama"]);
mixed archenemys;
mixed paths;
mixed players_archenemy=([]);
string zauberliste;
