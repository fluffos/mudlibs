public int choose_master_skill(string str) {
  string *possible_paths, ret;
  int i;
  if(TP->QueryProp(P_GUILD_LEVEL) < 20) {
    write("Du kannst erst auf der letzten Stufe Meisterfertigkeiten erlernen.\n");
    return 1;
  }

  if(RANGERMASTER->GetMasterAbility(getuid(TP)) != 0) {
    write("Du hast bereits eine Meisterfertigkeit erlernt.\n");
    return 1;
   }

  
   switch(RANGERMASTER->GetMasterPath(getuid(TP))) {
      case TIERMEISTER_PFAD:
        possible_paths = ({MASTER_ABIILITY_DEEP_BOND, MASTER_ABIILITY_POWERFUL_COMPANION});
        break;
      case BOGEN_PFAD:
        possible_paths = ({MASTER_ABIILITY_CRITICAL_AIM, MASTER_ABIILITY_BACKOFF});
        break;
      case MESSER_PFAD:
        possible_paths = ({MASTER_ABIILITY_CRIPPLING_STRIKE, MASTER_ABIILITY_THOUSAND_CUTS});
        break;
      case IAMA_PFAD:
        possible_paths = ({MASTER_ABIILITY_VOICE_OF_NATURE, MASTER_ABIILITY_RAGE_OF_NATURE});
        break;
      case BESCHWOERER_PFAD:
        possible_paths = ({MASTER_ABIILITY_IMPROVED_BINDING, MASTER_ABIILITY_PERMANENT_SUMMON});
        break;
      default:
        write("Du hast keinen Meisterpfad gewaehlt.\n");
        return 1;
    }

  str = implode(explode(lower_case(TP->_unparsed_args(1)), " ")[1..], " ");
  for(i=0; i<sizeof(possible_paths); ++i) {
    if(str == lower_case(possible_paths[i])) break;
  }

  if(!str || i >= sizeof(possible_paths)) {
    write("Du kannst nur folgende Meisterfertigkeiten erlernen:\n");
    for(i=0; i<sizeof(possible_paths); ++i) {
      write(" - " + capitalize(possible_paths[i]) + "\n");
    }
    write("syntax: 'lerne meisterfertigkeit <fertigkeit>'\n");
    return 1;
  }

  if((ret=RANGERMASTER->SetMasterAbility(getuid(TP), possible_paths[i])) != 1) {
    write(ret+"\n");
    return 1;
  }

  write("Du hast die Meisterfertigkeit '"+possible_paths[i]+"' erlernt.\n");
  return 1;
}

public int mtoplist() {
  if(!IS_LEARNER(TP)) return 0;

  write(BS("*** TOPLIST UPDATE ***"));
  call_other(RANGERMASTER, "UpdateTopList");
  return 1;
}

public int compareSpellLevel(string spellA, string spellB) {
  return GUILD_SPELLBOOK->get_spell_use_guild_level(spellA) >  GUILD_SPELLBOOK->get_spell_use_guild_level(spellB);
}

private void generateZauberliste() {
  string s, *str, word, circle, grad, path;
  int i, k, lastLevel;
  mapping m, skills;

  s="Du kannst folgende Zauber erlernen: (Kreis\\Rang\\[\\Pfad])\n";
  skills = QueryProp(P_GUILD_SKILLS);
  str=m_indices(QueryProp(P_GUILD_SKILLS));
  str-=({SK_MAGIC_DEFENSE, FIGHT(WT_BOW), FIGHT(WT_KNIFE), 
         SK_RANGER_HERBALISM });
  str=sort_array(str, "compareSpellLevel", TO);
  lastLevel=1;
  for(i=0;i<sizeof(str);i++)
  {
    word=cap_skill(str[i]);
    k=GUILD_SPELLBOOK->get_spell_use_guild_level(str[i]);
    circle=circle_to_string(GetCircle(k));
    grad=to_string(GetGrad(k));
    m=GUILD_SPELLBOOK->QuerySpell(str[i]);
    if(k > lastLevel) s+="\n";
    if(mappingp(m) && stringp(path=m[SI_PATH]) )
    {
      s+=sprintf(" %-35s %-s \n", word, "("+circle+"\\"+grad+"\\"+path+")");
    }
    else
    {
      s+=sprintf(" %-35s %-s \n", word, "("+circle+"\\"+grad+")");
    }
    lastLevel=k;
  }
  s+="\n";
  zauberliste=s;
}


/** Gildenaufstiege/Pfadwahl/Skillpunktwahl *********************************/
//-- Raum der Pruefungen -----------------------------------------------------
int goto_exam_room()
{
  object ob;
  mixed env;
  
  if(!objectp(TP)) { return 0; }
  notify_fail("Du darfst den Raum nicht betreten.\n");
  if(!IsGuildMember(TP)) { return 0; }
  if(TP->QueryProp(P_GUILD_LEVEL) >= MAX_GUILD_LEVEL) { return 0; }
  env=ENV(TP);
 /*if( (5*60+QuerySpellTime("examroom", getuid(TP))) >= time() )
  { notify_fail("Du darfst den Raum noch nicht wieder betreten.\n");
    return 0; }*/
  SetSpellTime("examroom", getuid(TP));
  TP->move(ROOM "exam:"+getuid(TP), M_GO|M_SILENT);
  if(objectp(env))
  { tell_room(env, BS(TP->Name()+" stellt sich den geheimen Pruefungen der "
                   "Waldlaeufer.")); }
  return 1;
}
//-- Prozentausgabe in String ------------------------------------------------
string integer_to_percent(int percent) 
{
  string str;
  
  str="";
  percent=limit(percent,0,1000);
  switch (percent)
  {
    case   0.. 10: str+="fast gar keine";                     break;
    case  11.. 20: str+="weniger als ein Viertel";            break;
    case  21.. 30: str+="etwa ein Viertel";                   break;
    case  31.. 40: str+="weniger als die Haelfte";            break;
    case  41.. 60: str+="in etwa die Haelfte";                break;
    case  61.. 70: str+="mehr als die Haelfte";               break;
    case  71.. 80: str+="etwa drei Viertel";                  break;
    case  81.. 90: str+="mehr als drei Viertel";              break;
    case  91.. 99: str+="beinahe alle";                       break;
    case 100     : str+="alle";                               break;
    case 101..150: str+="mehr als gewoehnlich";               break;
    case 151..199: str+="viel mehr als gewoehnlich";          break;
    case 200..299: str+="doppelt soviel als gewoehnlich";     break;
    case 300..399: str+="dreimal soviel als gewoehnlich";     break;
    case 400..499: str+="viermal soviel als gewoehnlich";     break;
    case 500..599: str+="fuenfmal soviel als gewoehnlich";    break;
    default: str+="mehr als fuenfmal soviel als gewoehnlich"; break;
  }
  return str;
}

//-- FilterFunktion fuer anwesende Waldlaeufer -------------------------------
int lcond_filter_func(object ob, int gl)
{
  // DBD(getuid(ob)+":"+to_string(gl));
  if( interactive(ob) && IsGuildMember(ob) && 
      query_idle(ob)<=120  && ob->QueryProp(P_GUILD_LEVEL)>=gl ) { return 1; }
  return 0;
}

//-- Kreis der Schueler ------------------------------------------------------
string Lcond_Schueler(object ob) 
{
  string s;
  
  s="";
  
  if(s=="") { return 0; } // Erlaubt
  return s; // Zurueckgelieferte Begruendung
}

varargs string Test(string str,int akt,int min,int target) {
  string out;
  int percent;
  out="";

  if(akt < min) out+="noch ungewoehnlich viel";
  else if(akt < target) {
    akt -= min;
    target -= min;
    percent = 100 - (100*akt/target);
    out+="Du musst "+str+" ";
    switch (percent) {
      case -10000..10:  
                   out+="noch eine Winzigkeit mehr";
                   break;
      case 11..20: out+="nur noch sehr minimal";
                   break;
      case 21..30: out+="noch sehr wenig";
                   break;
      case 31..40: out+="noch ein wenig";
                   break;
      case 41..60: out+="etwa nochmal soviel";
                   break;
      case 61..70: out+="noch mehr";
                   break;
      case 71..80: out+="noch viel";
                   break;
      case 81..90: out+="noch sehr viel";
                   break;
      case 91..100: out+="noch unglaublich viel";
                    break;
      default:      out+="noch ungewoehnlich viel";
                    break;
    }
    out+=" ueben. ";
  }
  
  return out;
}

public string needsToLeadnSchuelerSkills(object ob, int targetValue) {
  string r, *skills;
  int i, sum, a, b;

  r = "";

  skills = ({"augen des jaegers", "durchdringe", "fesselfalle", "geschwindigkeit",
  "rindenhaut", "schaetz"});

  for(i=0; i<sizeof(skills); ++i) {
  sum += ob->QuerySkillAbility(skills[i]);
  }

  // entweder messerstich oder deutschuss zaehlen
  a = sum + ob->QuerySkillAbility("messerstich");
  b = sum + ob->QuerySkillAbility("deutschuss");
  sum = (a>b?a:b);
  r = Test("was du im Kreis der Schueler gelernt hast", sum/sizeof(skills)+1 , 0, targetValue);

  if(r != "") {
    r = sprintf("Du musst deine Zauber noch weiter ueben und zeigen, dass "
    "du unsere Grundfaehigkeiten als Schueler gut genug beherrschst. "
    "%sDu kannst dir aussuchen, ob du dich dabei auf den Messerstich oder den Deutschuss "
    "spezialisierst. ", r);
  }

  return r;
}

public string needsToLearnWaldlaeuferSkills(object ob, int targetValue) {
  string r, *skills;
  int i, sum, a, b;

  r = "";

  skills = ({"zaehmung", "markierung der beute", "fusstritt", "tiere besprechen", 
             "fangfalle", "kraeutermixtur"});

  for(i=0; i<sizeof(skills); ++i) {
    sum += ob->QuerySkillAbility(skills[i]);
  }

  //tell_object(ob, sprintf("sum = %d avg = %d target=%d\n", sum, sum/6, targetValue));

  r = Test("was du im Kreis der Waldlaeufer gelernt hast", sum/sizeof(skills) , 0, targetValue);

  if(r != "") {
    r = sprintf("Du musst deine Zauber noch weiter ueben und zeigen, dass "
    "du die Faehigkeiten eines Waldlaeufers gut genug beherrschst. "
    "%s", r);
  }

  return r;
}

//-- Kreis der Waldlaeufer ---------------------------------------------------
string Lcond_Waldlaeufer(object ob) 
{
  string s, r;
  int a, b;
  mixed res;
  
  res=Lcond(ob);
  if(!stringp(res)) { s=""; }
  else { s=res; }

  r = needsToLeadnSchuelerSkills(ob, 5500);
  if(r != "") {
    s += r;
  }

  a = ob->QuerySkillAbility(FIGHT(WT_BOW));
  b = ob->QuerySkillAbility(FIGHT(WT_KNIFE));
  s += Test("den Kampf mit dem Bogen oder dem Messer", a+b, 0, 1000);

  if(s=="") { return 0; } // Erlaubt
  return s; // Zurueckgelieferte Begruendung
}

//-- Kreis der Hueter --------------------------------------------------------
string Lcond_Hueter(object ob) 
{
  string s, r;
  int a, b;
  mixed res;
  
  res=Lcond(ob);
  if(!stringp(res)) { s=""; }
  else { s=res; }

  r = needsToLeadnSchuelerSkills(ob, 8000);
  if(r != "") {
    s += r;
  }

  r = needsToLearnWaldlaeuferSkills(ob, 5500);
  if(r != "") {
    s += r;
  }

  a = ob->QuerySkillAbility(FIGHT(WT_BOW));
  b = ob->QuerySkillAbility(FIGHT(WT_KNIFE));
  s += Test("den Kampf mit dem Bogen oder dem Messer", a+b, 0, 3333);

  if(s=="") { return 0; } // Erlaubt
  return s; // Zurueckgelieferte Begruendung
}

