//-- Trennung der Einzelanforderungen in Gildenstufen ------------------------
string check_lvl_cond(object ob, int flag) 
{
  string s, quest;
  int percent, res, gl, value, i, j;
  mixed cond, ae;
  float f;
  
  s="";
  res=0;
  gl=ob->QueryProp(P_GUILD_LEVEL);
  flag=limit(flag, NEEDED_XP, TASK_OBJECT);
  
  switch(flag)
  {
    case NEEDED_XP:
      j=GUILD_MASTER->GetNeededXp(getuid(ob)) - ob->QueryProp(P_XP);
      res = 100*j/XP_PER_LEVEL[gl+1];
      res=limit(res,0,100);
      if(ob->QueryProp(P_TESTPLAYER)) tell_object(ob, sprintf("xp = %d (%d/%d)\n", res, ob->QueryProp(P_XP), GUILD_MASTER->GetNeededXp(getuid(ob))));
      s+="Von den benoetigten Kampferfahrungen fehlen Dir "
         +integer_to_percent(res)+".";
      res=(ob->QueryProp(P_XP)<GUILD_MASTER->GetNeededXp(getuid(ob)));
      if(ob->QueryProp(P_TESTPLAYER)) tell_object(ob, sprintf("res = %d\n", res));
    break;
    
    case NEEDED_QUEST:
      //Testies
      if(TP->QueryProp(P_TESTPLAYER))
      {
        quest=TP->QueryProp(P_RANGER_NEED_QUEST);
        if(stringp(quest))
        {
          if(test_bit(quest, 1+gl))
          {
            res=0;
            break;
          }
        }
      }
            
      if(stringp(cond=GUILD_QUESTS[1+gl, 0]))
      { if(!ob->QueryQuest(cond))
        { res=1;
          s+="Du hast Deine Aufgabe noch nicht erfuellt. "
             +GUILD_QUESTS[1+gl, 1];
          break; } }
      res=0;
    break;
    
    case EXAM_ROOM:
      /*ae=GUILD_MASTER->GetExamRoom(getuid(ob));
      if(!stringp(ae)) { res=1; break; }
      res=1-test_bit(ae, gl+1);
      s+="Du musst Dich noch dem Raum der Pruefungen stellen.";*/
      // temporaer ausgesetzt
    break;
    
    case NEEDED_ARCHENEMYS:
      res=GUILD_MASTER->GetKilledArchenemys(getuid(ob));
      res=(100*res)/((gl+1)*200);
      res=limit(res,0,100);
      if(!stringp(ae=GUILD_MASTER->GetArchenemy(getuid(ob)))){ae="Erzfeinde";}
      else { ae=GUILD_MASTER->get_race_plural(ae); }
      s+="Du hast noch nicht genug ueber "+ae+" gelernt. Du musst noch mehr "
         "gegen sie kaempfen. " + 
         Test("das Kaempfen gegen "+ae, GUILD_MASTER->GetKilledArchenemys(getuid(ob)), 0, (gl+1)*200);
      res=99-res;
    break;
    
    case TASK_OBJECT:
      for(i=0; i<=gl; ++i) {
        ae=GUILD_MASTER->GetTask(getuid(ob));
        j=test_bit(ae, i+1);
        pDebug(ob, sprintf("task_object check :: gl=%d bit=%d\n", i+1, j));
        
        ae=guild_level_mission_text[i+1];
        if(!j && stringp(ae) && strlen(ae) > 0) {
          s+="Du hast Deinen Auftrag noch nicht erfuellt.";
         
          return s + ae + " ";
        }
      }
      res = 0;
    break;
  }
  
  if(res<1) { return 0; } // Alles erfuellt?
  return s+" ";
}

public string check_level20_skills(object pl) {
  string *skills_to_have, res;
  int i;

  skills_to_have = RANGERMASTER->GetAllSkillsFor(pl);

  res = "";
  for(i=0; i<sizeof(skills_to_have); ++i) {
    if(pl->QuerySkillAbility(skills_to_have[i]) < MAX_ABILITY) {
      if(skills_to_have[i] == "pakt der schatten") continue;
      if(skills_to_have[i] == SK_MAGIC_DEFENSE) res += " Ausweichen,";
      else if(skills_to_have[i] == SK_RANGER_HERBALISM) res += " Kraeutersuche,";
      else if(skills_to_have[i] == FIGHT(WT_BOW)) res += " Bogenkampf,";
      else if(skills_to_have[i] == FIGHT(WT_KNIFE)) res += " Messerkampf,";
      else res += " "+skills_to_have[i]+",";
    }
  }

  if(res == "") return 0;
  return "Du musst deine Faehigkeiten noch perfektionieren. Folgende Faehigkeiten mussst du ueben:"+res+"\b";
}

//-- Trennung in Einzelanforderungen -----------------------------------------
string Lcond(object ob) 
{
  string s;
  mixed res;
  int i;
  
  s="";
  if(!IsGuildMember(ob)) 
  { return BS("Du bist kein Mitglied der "+CAP(GUILDNAME)+"."); }
  if(stringp(res=check_lvl_cond(ob, NEEDED_XP)))         { s+=res; }
  if(stringp(res=check_lvl_cond(ob, NEEDED_QUEST )))     { s+=res; }
  if(stringp(res=check_lvl_cond(ob, EXAM_ROOM)))         { s+=res; }
  if(stringp(res=check_lvl_cond(ob, NEEDED_ARCHENEMYS))) { s+=res; }
  if(stringp(res=check_lvl_cond(ob, TASK_OBJECT)))       { s+=res; }
  if(ob->QueryProp(P_GUILD_LEVEL) >= 19 && stringp(res=check_level20_skills(ob))) { s+=res; }
  if(s=="") { return 0; } // Erlaubt
  return s; // Zurueckgelieferte Begruendung
}

//-- Hauptfunktion -----------------------------------------------------------
nosave mixed advance(string str) 
{
  mixed res;
  mapping cond;
  int gl, kreis, rang, i, kreis_flag;
  object gnpc;

  if(!objectp(gnpc=present(GUILD_NPC_ID, TO)))
  { notify_fail("Du brauchst "+GUILD_NPC_LONG+" dafuer!\n");
    return 0; }
  gl=TP->QueryProp(P_GUILD_LEVEL); kreis=GetCircle(gl); rang=GetGrad(gl);
    
  notify_fail(BSA("Was willst Du erhoehen? Deinen Rang oder Deinen Kreis?\n",
                  GUILD_NPC+" sagt: "));
  if(!str) { return 0; }
 
  str=TP->_unparsed_args();
  if(!IsGuildMember(TP)) 
  { notify_fail("Das geht nur als Mitglied der Gilde.");
    return 0; }
    
  if(str=="rang" || str=="kreis")
  {
    if(str=="rang")  { kreis_flag=0; }
    if(str=="kreis") { kreis_flag=1; }
    if(!kreis_flag && rang>=5)
    {
      gnpc->command_me("sag Du kannst Deinen Rang nicht weiter erhoehen "
                       +CAP(getuid(TP))+".");
      if(kreis<4)
      { gnpc->command_me("sag Du kannst nur im Kreis aufsteigen."); }
      return 1; 
    }
    if(kreis_flag && rang!=5 )
    {
      gnpc->command_me("sag Du kannst nur auf dem hoechsten Rang eines "
                       "Kreises den naechsten Kreis betreten "
                       +CAP(getuid(TP))+"."); 
      return 1;
    }
    if(gl>=MAX_GUILD_LEVEL)
    {
      gnpc->command_me("sag Du kannst nicht weiter erhoehen "
                       +CAP(getuid(TP))+". Du solltest das eigentlich "
                       "wissen."); 
      return 1;
    }
    cond=QueryProp(P_GUILD_LEVELS);
    res=call_other(RES_CHECKER, "check_new_restrictions", TP, cond[gl+1]);

    if(gl > 15 && RANGERMASTER->GetMasterPath(getuid(TP)) == 0) {
      if(stringp(res)) res += "Du musst noch deinen Meisterpfad auswaehlen.";
      else res =  "Du musst noch deinen Meisterpfad auswaehlen.";
    }
  
    if(!stringp(res))
    {
      //LoadSequenz(SEQ+"aufstieg.seq", TP, #'advance2);
      call_out("advance2",0,TP, kreis_flag);
      return 1;
    }
    else
    {
      if(res!="")
      { 
        tell_room(TO, break_string("Du kannst noch nicht aufsteigen, "+CAP(getuid(TP))+"! "+res,
                                   78, "Raziel sagt: "));
        return 1;
      }
    }
  }
  return 0;
}

public void give_task_item(int gl, object pl) {
  object task;

  if(test_bit(GUILD_MASTER->GetTask(getuid(pl)), gl+1)) return; // aufgabe bereits geloest

  switch(gl) {
    case 2:
      if(objectp(present(RANGER_TASK_SCHUPPE, pl))) return;
      tell_object(pl, BS("Raziel gibt dir eine unbekannte Schuppe."));
      tell_room(TO, BS("Raziel gibt "+pl->name(WEM)+" eine unbekannte Schuppe."));
      task = clone_object(OBJ "task_schuppe");
      task->move(pl, M_NOCHECK);
      break;
    case 3:
      if(objectp(present(RANGER_TASK_SCHUPPE2, pl))) return;
      tell_object(pl, BS("Raziel gibt dir eine Hydraschuppe."));
      tell_room(TO, BS("Raziel gibt "+pl->name(WEM)+" eine Schuppe."));
      task = clone_object(OBJ "task_schuppe2");
      task->move(pl, M_NOCHECK);
      break;
    case 6:
      if(objectp(present(RANGER_TASK_WEAPON_GATHER, pl))) return;
      task = clone_object(OBJ "task_waffensammler");
      task->move(pl, M_NOCHECK);
      tell_room(TO, BS("Raziel sagt: "+TPN+", geh und bring Kronosch die Waffen, damit er uns gewogen wird!"));
      break;
    case 7:
      if(objectp(present(RANGER_TASK_MAGIC_WEAPONS, pl))) return;
      task = clone_object(OBJ "task_waffensammler2");
      task->move(pl, M_NOCHECK);
      tell_room(TO, BS("Raziel sagt: Kronosch benoetigt bestimmte Gegenstaende, "+TPN+
      "! Geh und bring sie ihm.")); 
      break;
    case 9:
      if(objectp(present(RANGER_TASK_SCALE_GATHERER, pl))) return;
      task = clone_object(OBJ "task_schuppensammler");
      task->move(pl, M_NOCHECK);
      tell_room(TO, BS("Raziel sagt: Kronosch arbeitet gut, "+TPN+". Er hat allerdings nach Drachenschuppen und Wasserfragmenten gefragt. Besorge sie fuer ihn!")); 
      break;
    case 12:
      if(objectp(present(RANGER_TASK_PALA_KILLER, pl))) return;
      task = clone_object(OBJ "task_palakiller");
      task->move(pl, M_NOCHECK);
      tell_room(TO, BS("Raziel sagt: "+TPN+", eile dich! Greife das Haupttor der Paladine an. Es gilt keine Zeit zu verlieren!"));
    case 15:
      if(objectp(present(RANGER_TASK_SCHNITZELJAGD, pl))) return;
      task = clone_object(OBJ "task_schnitzeljagd");
      task->move(pl, M_NOCHECK);
      tell_room(TO, BS("Raziel sagt: "+TPN+", finder heraus was Hugen ueber unsere gestohlene Waffe weiss!"));
      break;
  }
}

//-- Eigentlicher Aufstieg ---------------------------------------------------
nosave varargs int advance2(object pl, int kreis) 
{
  mixed m;
  int gl, i, j, k;
  object task, gnpc;

  if(!objectp(gnpc=present(GUILD_NPC_ID, TO)))
  { write("Du brauchst "+GUILD_NPC_LONG+" dafuer!\n");
    return 1; }

  if(!pl) { pl=TP; }
  gilden_room::advance(); // Eigentlicher Aufstieg der Gildenstufe
  gl=pl->QueryProp(P_GUILD_LEVEL);
    
  gnpc->command_me("ja "+getuid(TP));
  i=pl->QueryProp(P_GENDER)==FEMALE;
  k=GetCircle(gl);
  if(kreis)
  {
    gnpc->command_me("sag "+CAP(getuid(pl))+", ab jetzt bist Du ein"
                     +(i?"e":"")+" "+circle_to_string(k)+(i?"in":"")+".");
    switch(k)
    {
      case 1:
        gnpc->command_me("sag Es wird jetzt Deine Aufgabe sein die "
                         "Grundfertigkeiten zu erlernen und stetig zu "
                         "verbessern. Uebe Dich.");
        gnpc->command_me("emote wendet sich ab.");
      break;
      case 2:
        gnpc->command_me("muster "+getuid(pl));
        gnpc->command_me("sag Du bist der Gilde also treu geblieben. Nun wir "
                         "werden sehen wie Du Dich weiter qualifizierst. Du "
                         "wirst jetzt maechtigere Zauber erlernen, aber "
                         "dafuer musst Du auch mehr arbeiten.");
        gnpc->command_me("emote verschraenkt die Arme vor der Brust.");
      break;
      case 3:
        gnpc->command_me("sag Betrete nun eine der Pfade. Du hast Deine "
                         "Vertrauenswuerdigkeit bewiesen und bist jetzt ein "
                         "vollwertiges Mitglied. Ab jetzt geht es los.");
        gnpc->command_me("laechel kalt");
      break;
      case 4:
        gnpc->command_me("sag Grosse Macht bringt grosse Verantwortung, Du "
                         "hast jetzt eine Vorbildfunktion fuer die anderen. "
                         "Bleibe ein treues Mitglied und Du wirst dafuer "
                         "belohnt.");
        gnpc->command_me("klopf "+getuid(pl)+" /respektvoll");
      break;
    }
  }
  else if(gl<MAX_GUILD_LEVEL) { 
    gnpc->command_me("sag Gut "+CAP(getuid(pl))+", aber arbeite weiter an Dir."); 
  }

  if(strlen(guild_level_mission_text[gl+1]) > 0) {
    gnpc->command_me("sag " + guild_level_mission_text[gl+1]);
  }

  give_task_item(gl, pl);
  
  if(gl<MAX_GUILD_LEVEL) {
    m=QueryProp(P_GUILD_LEVELS);
    m=m[gl+1]; 
    j=pl->QueryProp(P_XP) + XP_PER_LEVEL[gl+1];

    GUILD_MASTER->SetGuildLevel(getuid(pl), gl);
    GUILD_MASTER->SetNeededXp(getuid(pl), j);
    GUILD_MASTER->SetKilledArchenemys(getuid(pl), 0);
    i=0;
  }
  if(member(SKILL_POINT_LEVEL, gl)!= -1) // Neuer Skillpunkt
  { 
    R_SKILLMASTER->IncFreeSkillPoints(getuid(pl)); i=1;
    tell_object(TP, BS("Du hast einen Fertigkeitspunkt erhalten. Verteile ihn mit <lerne fertigkeiten>.")); 
  }
  
  if(kreis)
  {
    if(!IS_LEARNER(pl) ){ 
      Channel(CAP(getuid(pl))+" hat soeben den Kreis der "+circle_to_string(GetCircle(gl))+" betreten."); 
    }
  } else {
    if(!IS_LEARNER(pl)) {
      Channel(CAP(getuid(pl))+" hat soeben den "+GetGrad(gl)+". Rang im Kreis der "+circle_to_string(GetCircle(gl))+" erreicht."); 
    }
  }
  
  log_member(TP, "Neue Gildenstufe: "+to_string(gl)+(i?"(Skillpunkt)":"") );
  return 1;
}
/****************************************************************************/



/** Auswahl der Erzfeindrasse und speichern *********************************/
//-- Vorfunktion fuer Erzfeindauswahl ----------------------------------------
string print_archenemy_slots(object pl) {
  string s, *ae;

  ae = GUILD_MASTER->GetArchenemy(getuid(pl));

  if(sizeof(ae) < 1) s = "* <frei>\n";
  else s = "* "+GUILD_MASTER->get_race_plural(ae[0])+"\n";

  if(pl->QueryProp(P_GUILD_LEVEL) > 5) {
    if(sizeof(ae) < 2) s += "* <frei>\n";
    else s += "* "+GUILD_MASTER->get_race_plural(ae[1])+"\n";
  }

  if(pl->QueryProp(P_GUILD_LEVEL) > 10) {
    if(sizeof(ae) < 3) s += "* <frei>\n";
    else s += "* "+GUILD_MASTER->get_race_plural(ae[2])+"\n";
  }

  if(pl->QueryProp(P_GUILD_LEVEL) > 15) {
    if(sizeof(ae) < 4) s += "* <frei>\n";
    else s += "* "+GUILD_MASTER->get_race_plural(ae[3])+"\n";
  }

  if(pl->QueryProp(P_GUILD_LEVEL) >= 20) {
    if(sizeof(ae) < 5) s += "* <frei>\n";
    else s += "* "+GUILD_MASTER->get_race_plural(ae[4])+"\n";
  }

  return s;
}

int max_archenemy_slots(object pl) {
  return pl->QueryProp(P_GUILD_LEVEL) / 5 + 1;
}

int choose_archenemy()
{
  string s;
  int i;
  
  s="Du kannst diese Erzfeinde waehlen:\n";
  for(i=0;i<sizeof(archenemys);i+=2)
  { s+=sprintf(" %2s: %-18s", to_string(i+1), archenemys[i]);
    if((i+1)==sizeof(archenemys)) {break;}
    s+=sprintf("|  %2s: %-18s\n", to_string(i+2), archenemys[i+1]);
  }
  s+="\nWenn du gerade erst in der Gilde beginnst, empfiehlt sich ein einfacher "
     "Erzfeind (Menschen, Hobbits, Zwerge oder Elfen). Du kannst ihn spaeter "
     "gegen steigende Kosten wechseln.\nGegen deine Erzfeinde erhaeltst du einen "
     "Angriffsbonus. Du musst sie aber auch zum Aufstieg in der Gilde toeten.\n";
  s+="Du hast aktuell folgende Erzfeinde:\n";
  s+= print_archenemy_slots(TP);
  s+="\n";

  if(sizeof(GUILD_MASTER->GetArchenemy(getuid(TP))) >= max_archenemy_slots(TP)) {
    s += "Du hast bereits soviele Erzfeinde gewaehlt, wie du haben kannst.\nMoechtest du deine Erzfeinde zuruecksetzen? (ja/nein)";
    write(s);
    input_to("reset_archenemy");
    return 1;
  } else {
    s+="Welchen neuen Erzfeind (<Nr.>) waehlst Du: ";
    write(s);
    input_to("choose_archenemy_two");
    return 1;
  }
}

public void reset_archenemy(string str) {
  string res;

  if(!objectp(TP)) return;
  str = lower_case(str);
  if(str != "ja" && str != "j") {
    write("Abgebrochen.\n");
    return;
  }

  R_RES_CHECKER->reset_archenemy(TP);
}

void choose_archenemy_two(string str)
{
  int i;
  
  if( !intp(i=to_int(str)) || i>sizeof(archenemys) || i<1 )
  { write("\nDu musst eine Zahl zwischen 1 und "
          +to_string(sizeof(archenemys))+" eintippen!\n"); 
    return; }
  i--;
  players_archenemy+=([getuid(TP):archenemys[i]]);
  
  if(!IsGuildMember(TP))
  {
    write(BS("Du waehlst '"+archenemys[i]+"'."));
    return;

  }
  
  //else: Der Wechsel
  write(BS("Moechtest du wirklich den Erzfeind "+to_string(GUILD_MASTER->get_race_plural(players_archenemy[getuid(TP)]))+"' hinzufuegen? (ja/nein)"));
  input_to("change_archenemy");  
}
void change_archenemy(string str)
{
  int res;
  
  str=lower_case(str);
  if(!objectp(TP)) return;
  if(str!="ja" && str!="j" ) {
    write(BS("Abgebrochen."));
    return;
  }

  res=GUILD_MASTER->SetArchenemy(getuid(TP), players_archenemy[getuid(TP)]);
  if(res != 1) {
    write(BS("Fehler beim Setzen des Erzfeindes ("+players_archenemy[getuid(TP)]+", r="+res+")."));
    return;
  }

  write(BS(to_string(GUILD_MASTER->get_race_plural(players_archenemy[getuid(TP)]))+" sind nun deine Erzfeinde."));
  players_archenemy = m_delete(players_archenemy, getuid(TP));
  return;
}
mixed get_archenemys() { return players_archenemy; }
/****************************************************************************/



/** Fertigkeitspunkte investieren und resetten ******************************/
//-- Skill auswaehlen --------------------------------------------------------
int choose_skill()
{
  string s;
  
  if(!objectp(TP)) { return 1; }
  if(!IsGuildMember(TP)) 
  { tell_object(TP, BS("Du kannst hier nur als Waldlaeufer lernen."));
    return 1; }
  
  s=to_string(R_SKILLMASTER->QuerySkillTree(getuid(TP)))+"\n";
  s+="Welche Fertigkeiten willst Du erlernen? <Nr.>\n";
  write(s);
  input_to("set_skill");
  return 1;
}

//-- Der Skill wird evtl. gesetzt --------------------------------------------
void set_skill(string str)
{
  mixed list, m;
  string skill;
  int i, res;
  
  if(!objectp(TP)) return;
  if(!pointerp(list=R_SKILLMASTER->get_skill_list())) return;
  if( !intp(i=to_int(str)) || i>sizeof(list) || i<1 )
  { write("\nDu musst eine Zahl zwischen 1 und "
          +to_string(sizeof(list))+" eintippen!"); 
    return; }
  i--;
  skill=list[i];
  res=R_SKILLMASTER->AddSkillPoint(getuid(TP), skill);
  if(res == 1)
  {
    write(BS("Du erlernst '"+skill+"'."));
    return;
  }
  else 
  {
    res=res*(-1);
    m=({"Du bist kein Mitglied der Gilde", "Du hast nicht genug "
        "Fertigkeitspunkte", "Du hast diese Fertigkeit schon erlernt", 
        "Diese Fertigkeit gibt es nicht", "Du darfst nicht mehr Fertigkeiten "
        "erlernen", "Du brauchst dafuer noch '"
        +to_string(R_SKILLMASTER->QueryNeededSkill(skill))+"'"});
    res=limit(res,0,5);
    write(BS(m[res]+"."));
  }
  return;
}

//-- Skills werden alle verlernt und Skillpunkte wieder rausgegeben ----------
int unlearn_skills()
{
  string s;
  
  if(!objectp(TP)) { return 1; }
  if(!IsGuildMember(TP)) 
  { tell_object(TP, BS("Das kannst Du nur als Waldlaeufer."));
    return 1; }
  
  write("Willst Du sicher ALLE Fertigkeiten verlernen? (Ja/Nein)\n");
  input_to("unlearn_skills_two");
  return 1;
}
void unlearn_skills_two(string str)
{
  if(!objectp(TP)) return;
  str=lower_case(str);
  if(str=="ja" || str=="j")
  {
    R_RES_CHECKER->reset_skillpoints(TP);
    return;
  }
  write(BS("Du behaelst Deine Fertigkeiten."));
  return;
}
/****************************************************************************/



/** Pfade betreten und verlassen ********************************************/
//-- Den zu verlassenden Pfad auswaehlen -------------------------------------
int choose_loosen_path()
{
  string s;
  int i;
  mixed p;
  
  if(!IsGuildMember(TP))
  {
    write("Aber Du bist doch kein Mitglied!\n");
    return 1;
  }
  
  p=RANGERMASTER->GetPaths(getuid(TP));
  if( !pointerp(p) || sizeof(p)<1 )
  {
    write("Du hast Doch gar keinen Pfad betreten!\n");
    return 1;
  }
  s="Du kannst folgende Pfade verlassen:\n";
  for(i=0;i<sizeof(p);i++)
  { s+="  "+to_string(1+i)+". Pfad der "+p[i]+"\n"; }
  s+="\nWelchen Pfad (<Nr.>) waehlst Du: ";
  write(s);
  input_to("leave_path");
  return 1;
}

//-- Einen Pfad verlassen ----------------------------------------------------
void leave_path(string str)
{
  int i, res;
  string *m;
  mixed p;

  p=RANGERMASTER->GetPaths(getuid(TP));
  if( !pointerp(p) || sizeof(p)<1  ) return;
  if( !intp(i=to_int(str)) || i>sizeof(p) || i<1 )
  { write("\nSo einen Pfad hast Du nicht betreten!"); 
    return; }
  i--;
  if(!objectp(TP)) return;

  if(p[i] == RANGERMASTER->GetMasterPath(getuid(TP))) {
    write(BS("Deinen Meisterpfad kannst du nicht verlassen."));
    return;
  }

  R_RES_CHECKER->leave_path(TP, p[i]);
  return;
}

//-- Einen Pfad auswaehlen ---------------------------------------------------
int choose_path()
{
  string s;
  int i;
  
  if(!IsGuildMember(TP))
  { write("Aber Du bist doch kein Mitglied!\n"); return 1; }
  
  if(TP->QueryProp(P_GUILD_LEVEL) <= 10)
  { write("Deine Gildenstufe ist zu niedrig!\n"); return 1; }
  
  s="Du kannst folgende Pfade betreten:\n";
  for(i=0;i<sizeof(paths);i++)
  { s+="  "+to_string(1+i)+". Pfad der "+paths[i]+"\n"; }
  s+="\nWelchen Pfad (<Nr.>) waehlst Du: ";
  write(s);
  input_to("choose_path_two");
  return 1;
}

public int choose_master_path() {
  string s, *pfade;
  int i;
  if(!IsGuildMember(TP)) {
    write("Aber Du bist doch kein Mitglied!\n"); 
    return 1; 
  }
  
  if(TP->QueryProp(P_GUILD_LEVEL) <= 15) {
    write("Das kannst du nur im Kreis der Meister!\n");
    return 1; 
  }

  if(stringp(s=RANGERMASTER->GetMasterPath(getuid(TP)))) {
    write(BS("Du bist bereits ein Meister des "+s+"pfads."));
    return 1;
  }

  pfade = RANGERMASTER->GetPaths(getuid(TP));
  if(!pointerp(pfade) || sizeof(pfade) == 0) {
    write(BS("Du folgst keinem Pfad. Du kannst nur Meister eines bereits gefolgten Pfades werden."));
    return 1;
  }

  s="!!! Bedenke, dass du den Meisterpfad nicht mehr wechseln oderverlassen kannst. !!!\n";
  s+="Welcher Pfad soll dein Meisterpfad werden?\n\n";
  for(i=0; i<sizeof(pfade); ++i) {
    s+= BS(sprintf("%d. %s", i+1, CAP(pfade[i])));
  }
  s+="\nDeine Wahl: ";

  write(s);
  input_to("choose_master_path_2");
  return 1;
}

public void choose_master_path_2(string input) {
  mixed s;
  string *pfade;
  int i;

  pfade = RANGERMASTER->GetPaths(getuid(TP));
  i = to_int(input);
  if(i == 0) {
    write(BS("Abgebrochen."));
    return;
  }
  i -= 1;

  s = RANGERMASTER->SetMasterPath(getuid(TP), pfade[i]);
  if(stringp(s)) {
    write(BS(s));
    return;
  }

  write(BS("Du bist nun ein Meister des "+pfade[i]+"pfades."));
  return;
}

//-- Dem Pfad beitreten ------------------------------------------------------
void choose_path_two(string str)
{
  int i, res;
  string *m;
  
  if( !intp(i=to_int(str)) || i>sizeof(paths) || i<1 )
  { write("\nDu musst eine Zahl zwischen 1 und "
          +to_string(sizeof(paths))+" eintippen!"); 
    return; }
  i--;
  if(!objectp(TP)) return;
  res=GUILD_MASTER->AddPath(getuid(TP), to_string(paths[i]));
  if(res == 1)
  {
    write(BS("Du waehlst den '"+paths[i]+"pfad'."));
    return;
  }
  else 
  {
    res=res*(-1);
    m=({"Du bist kein Mitglied der Gilde", "Den Pfad gibt es nicht", 
        "Das Maximum an Pfaden ist erreicht", "Es sind noch nicht mehr Pfade "
        "erlaubt", "Du hast dem Pfad schon betreten", "Ein Fehler ist "
        "aufgetreten"});
    res=limit(res,0,5);
    write(BS(m[res]+"."));
  }
  return;
}
/****************************************************************************/



//** Eintreten und Austreten ***********************************************//
//-- Beitrittsfunktion -------------------------------------------------------
int beitreten()
{
  int i;
  object ob, gnpc;
  
  if(!objectp(gnpc=present(GUILD_NPC_ID, TO)))
  { write("Du brauchst "+GUILD_NPC_LONG+" dafuer!\n");
    return 1; }
  
 /* if(!TP->QueryProp(P_TESTPLAYER) && !IS_LEARNER(TP) )
  { write("Zur Zeit duerfen nur Testspieler beitreten!\n"); return 1; }*/
  
  if(IsGuildMember(TP) && !IS_ARCH(TP))
  { write("Aber Du bist doch schon Mitglied!\n"); return 1; }
  
  if(member(archenemys, players_archenemy[getuid(TP)]) == -1)
  { write("Du musst erst einen Erzfeind waehlen (<waehle erzfeind>)!\n");
    return 1; }
  
  if( (i=::beitreten()) < 0) { return 1; } // Meldung wird da uebernommen
  
  if(objectp(ob=clone_object(OBJ"koecher")) ) { ob->move(TP, M_NOCHECK); }

  gnpc->command_me("murmel");
  gnpc->command_me("ja "+getuid(TP));
  gnpc->command_me("sag Deine Gelegenheit Dich zu beweisen "
                   +CAP(getuid(TP))+".");
  gnpc->command_me("wlwisper Heisst "+CAP(getuid(TP))+" willkommen!");
  gnpc->command_me("sag Sieh dir <hilfe wl_uebersicht> an, um die Grundlagen der Gilde zu verstehen.");
  
  if(!IS_LEARNER(TP) )
  { Channel(CAP(getuid(TP))+" hat sich soeben den Waldlaeufern "
             "angeschlossen."); }
    
  // Grundwerte
  TP->SetProp(P_GUILD_LEVEL, 1);
  adjust_title(TP);
  GUILD_MASTER->AddMember(TP, players_archenemy[getuid(TP)]);

  // Skills
  if(!(TP->QuerySkillAbility(FIGHT(WT_KNIFE))))
    TP->ModifySkill(FIGHT(WT_KNIFE), 
        QuerySkill(FIGHT(WT_KNIFE))+([SI_SKILLABILITY:10 ]), 100
        ,GUILDNAME);

  if(!(TP->QuerySkillAbility(FIGHT(WT_BOW))))
    TP->ModifySkill(FIGHT(WT_BOW), 
        QuerySkill(FIGHT(WT_BOW))+([SI_SKILLABILITY:10 ]), 100
        ,GUILDNAME);
 
  if(!(TP->QuerySkillAbility(SK_MAGIC_DEFENSE)))
    TP->ModifySkill(SK_MAGIC_DEFENSE, 
        QuerySkill(SK_MAGIC_DEFENSE)+([SI_SKILLABILITY:10 ]), 100
        ,GUILDNAME);       

  if(!(TP->QuerySkillAbility(SK_RANGER_HERBALISM)))
    TP->ModifySkill(SK_RANGER_HERBALISM, 
        QuerySkill(SK_RANGER_HERBALISM)+([SI_SKILLABILITY:500 ]), 100
        ,GUILDNAME);
  
  WLOG(GUILD_LOG_FILE, "tritt den Waldlaeufern bei");
  WLOG(MEMBERLOG, "tritt der Gilde bei. Erzfeind: "
                   +players_archenemy[getuid(TP)] );
  log_member(TP, "Gildeneintritt, Erzfeind: "+players_archenemy[getuid(TP)]); 
  return 1;
}

//-- Austritt ----------------------------------------------------------------
int austreten()
{
  object ob, gnpc;
  int i;

  if(!objectp(TP)) { return 0; }
  if(!IsGuildMember(TP))
  {  write("Aber Du bist doch gar kein Mitglied!\n");
     return 1; }
     
  if(objectp(gnpc=present(GUILD_NPC_ID, TO)))
  { gnpc->command_me("nein");
    gnpc->command_me("sag Du warst eben zu schwach "+CAP(getuid(TP))+"."); }

  WLOG(GUILD_LOG_FILE, "verlaesst die Waldlaeufer");
  WLOG(MEMBERLOG, "verlaesst die Gilde auf Gildenstufe "
                   +to_string(TP->QueryProp(P_GUILD_LEVEL)));
  log_member(TP, "Gildenaustritt, Gildenstufe: "
                 +to_string(TP->QueryProp(P_GUILD_LEVEL)));
  GUILD_MASTER->RemoveMember(getuid(TP));
  TP->SetProp( P_GUILD_LEVEL, 0 );
  
  if(!IS_LEARNER(TP) )
  { Channel(CAP(getuid(TP))+" hat soeben die Waldlaeufer verlassen. Nicht "
            "jede"+(TP->QueryProp(P_GENDER)==FEMALE?"e":"r")+" ist bereit fuer uns zu kaempfen."); }
  
  for(i=0;i<sizeof(RANGER_ITEMS);i++)
  { if( objectp(ob=present(RANGER_ITEMS[i], TP)) ) { ob->remove(1); } }
  
  return ::austreten();
}

//-- Austritt, Sicherheitsabfrage --------------------------------------------
int second_austreten_test(string str)
{
  str=lower_case(str);
  if(str=="ja" || str=="j") { austreten(); return 1;}
  return 1;
}
int austreten_test()
{
  if(!objectp(TP)) { return 0; }
  if(!IsGuildMember(TP))
  {  write("Aber Du bist doch gar kein Mitglied!\n");
     return 1; }
  write("Willst Du wirklich austreten? Ja/Nein: \n");
  input_to("second_austreten_test");
  return 1;
}
//**************************************************************************//



//** Spellfunktionen *******************************************************//
//-- Spell lernen ------------------------------------------------------------
int NewLearnSpell(string str) 
{
  mixed path, s, res;
  int i, n, gl;
  
  str=TP->_unparsed_args();
  if(!IsGuildMember(TP)) 
  { tell_object(TP, BS("Du kannst hier nur als Waldlaeufer lernen."));
    return 1; }
  notify_fail("Welchen Zauber moechtest du erlernen?\n");
  if(!str) { write(zauberliste); return 1; }

  str=lower_case(str);
  s=m_indices(QueryProp(P_GUILD_SKILLS));
  s-=({SK_MAGIC_DEFENSE, FIGHT(WT_BOW), FIGHT(WT_KNIFE), 
       SK_RANGER_HERBALISM });
  if( member(s, str) == -1 )
  {
    write(BS("So einen Zauber gibt es nicht."));
    return 1;
  }

  
  if(stringp(path=RANGERMASTER->get_path(str)))
  {
    res=RANGERMASTER->GetPaths(getuid(TP));
    if(!pointerp(res)) { res=({"",""}); }
    n=member(res, path);
    if(n == -1)
    {
      tell_object(TP,BS("Du musst zuerst dem Pfad der "+path+" betreten."));
      return 1; 
    }

    gl = GUILD_SPELLBOOK->QuerySpell(str)[SI_SKILLRESTR_LEARN][P_GUILD_LEVEL];
    if(gl > 16 && RANGERMASTER->GetMasterPath(getuid(TP)) != path) {
      tell_object(TP, BS("Du musst Meister des Pfades der "+path+" sein, um diesen Zauber zu erlernen."));
      return 1;
    }
  }
  n = LearnSpell(str);
  if(n!=1) return n;

  TP->ModifySkill(str, ([SI_SKILLABILITY: 2000]));
  return n;
}
