//** StandardFunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  string s, *str, word, *words, circle, grad, path;
  int i, k;
  mixed m;
  
  ::create();

  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"waldlaeufer_spells");

  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );
  
  SetProp(P_GUILD_RESTRICTIONS, 
    ([  P_LEVEL:        10, 
        A_INT:          7, 
        A_DEX:          10,
        SR_FUN:         "Lcond_Schueler"]));

  SetProp(P_GUILD_LEVELS,
   ([ 1: ([P_LEVEL:10, A_DEX:10, SR_FUN: "Lcond_Schueler" ]),
      2: ([P_LEVEL:13, A_DEX:11, SR_FUN: "Lcond" ]),
      3: ([P_LEVEL:16, A_DEX:12, SR_FUN: "Lcond" ]),
      4: ([P_LEVEL:19, A_DEX:14, SR_FUN: "Lcond" ]),
      5: ([P_LEVEL:21, A_DEX:15, SR_FUN: "Lcond" ]),
      6: ([P_LEVEL:24, SR_FUN: "Lcond_Waldlaeufer",
            SM_RACE:([
              "Dunkelelf": ([A_DEX:18]),
              "Zwerg": ([A_DEX:17]),
              "Elf": ([A_DEX: 18]),
              "Fee": ([A_DEX: 17]),
              "Hobbit": ([A_DEX: 18]),
              "Mensch": ([A_DEX: 18]),
              "Oger": ([A_DEX: 16]),
              "Troll": ([A_DEX: 16])
            ])
        ]),
      7: ([P_LEVEL:26, SR_FUN: "Lcond", 
          SM_RACE:([
            "Dunkelelf": ([A_DEX:19]),
            "Zwerg": ([A_DEX:17]),
            "Elf": ([A_DEX: 19]),
            "Fee": ([A_DEX: 20]),
            "Hobbit": ([A_DEX: 20]),
            "Mensch": ([A_DEX: 19]),
            "Oger": ([A_DEX: 16]),
            "Troll": ([A_DEX: 16]),
            ])
          ]),
      8: ([P_LEVEL:28, SR_FUN: "Lcond" ]),
      9: ([P_LEVEL:31, SR_FUN: "Lcond", 
            SM_RACE: ([
              "Dunkelelf": ([A_DEX:20]),
              "Zwerg": ([A_DEX:18]),
              "Elf": ([A_DEX: 20]),
              "Fee": ([A_DEX: 21]),
              "Hobbit": ([A_DEX: 21]),
              "Mensch": ([A_DEX: 20]),
              "Oger": ([A_DEX: 16]),
              "Troll": ([A_DEX: 16]),
            ])
          ]),
     10: ([P_LEVEL:34, SR_FUN: "Lcond", 
            SM_RACE:([
              "Dunkelelf": ([A_DEX:22]),
              "Zwerg": ([A_DEX:20]),
              "Elf": ([A_DEX: 21]),
              "Fee": ([A_DEX: 22]),
              "Hobbit": ([A_DEX: 22]),
              "Mensch": ([A_DEX: 21]),
              "Oger": ([A_DEX: 17]),
              "Troll": ([A_DEX: 17]),
            ])
          ]),
     11: ([P_LEVEL:37, SR_FUN: "Lcond_Hueter",  SR_SEER: 1,
            SM_RACE:([
              "Dunkelelf": ([A_DEX:24]),
              "Zwerg": ([A_DEX:22]),
              "Elf": ([A_DEX: 23]),
              "Fee": ([A_DEX: 24]),
              "Hobbit": ([A_DEX: 24]),
              "Mensch": ([A_DEX: 23]),
              "Oger": ([A_DEX: 19]),
              "Troll": ([A_DEX: 19]),
            ])
          ]),
     12: ([P_LEVEL:40, SR_FUN: "Lcond", 
            SM_RACE:([
              "Dunkelelf": ([A_DEX:25]),
              "Zwerg": ([A_DEX:23]),
              "Elf": ([A_DEX: 24]),
              "Fee": ([A_DEX: 25]),
              "Hobbit": ([A_DEX: 25]),
              "Mensch": ([A_DEX: 24]),
              "Oger": ([A_DEX: 20]),
              "Troll": ([A_DEX: 20]),
            ])
          ]),
     13: ([P_LEVEL:43, SR_FUN: "Lcond",
            SM_RACE:([
              "Dunkelelf": ([A_DEX:27]),
              "Zwerg": ([A_DEX:25]),
              "Elf": ([A_DEX: 26]),
              "Fee": ([A_DEX: 27]),
              "Hobbit": ([A_DEX: 27]),
              "Mensch": ([A_DEX: 26]),
              "Oger": ([A_DEX: 22]),
              "Troll": ([A_DEX: 21]),
             ])
          ]),
     14: ([P_LEVEL:45, SR_FUN: "Lcond", 
            SM_RACE:([
              "Dunkelelf": ([A_DEX:29]),
              "Zwerg": ([A_DEX:27]),
              "Elf": ([A_DEX: 28]),
              "Fee": ([A_DEX: 29]),
              "Hobbit": ([A_DEX: 29]),
              "Mensch": ([A_DEX: 28]),
              "Oger": ([A_DEX: 24]),
              "Troll": ([A_DEX: 23]),
            ])
        ]),
     15: ([P_LEVEL:47, SR_FUN: "Lcond", 
            SM_RACE:([
              "Dunkelelf": ([A_DEX:31]),
              "Zwerg": ([A_DEX:29]),
              "Elf": ([A_DEX: 30]),
              "Fee": ([A_DEX: 31]),
              "Hobbit": ([A_DEX: 31]),
              "Mensch": ([A_DEX: 31]),
              "Oger": ([A_DEX: 26]),
              "Troll": ([A_DEX: 25]),
            ])
        ]),
     16: ([P_LEVEL:50, 
            SM_RACE: ([
              "Dunkelelf": ([A_DEX:32]),
              "Zwerg": ([A_DEX:30]),
              "Elf": ([A_DEX: 31]),
              "Fee": ([A_DEX: 32]),
              "Hobbit": ([A_DEX: 32]),
              "Mensch": ([A_DEX: 31]),
              "Oger": ([A_DEX: 27]),
              "Troll": ([A_DEX: 26]),
            ]), SR_FUN: "Lcond_Meister"]),
     17: ([P_LEVEL:55, SR_FUN: "Lcond", 
            SM_RACE:([
              "Fee": ([A_DEX:33]),
              "Hobbit": ([A_DEX:33])
          ])]),
     18: ([P_LEVEL:60, SR_FUN: "Lcond", 
            SM_RACE: (["Fee": ([A_DEX:34]) ])]),
     19: ([P_LEVEL:65, SR_FUN: "Lcond" ]),
     20: ([P_LEVEL:70,SR_FUN: "Lcond" ]) 
    ]) );
  
  AddSkill( FIGHT(WT_BOW), 
    ([ SI_SKILLFUNC:"Bogenkampf",SI_DIFFICULTY:100,SI_SKILLABILITY: 200]) );
  AddSkill( FIGHT(WT_KNIFE), 
    ([ SI_SKILLFUNC:"Dolchkampf",SI_DIFFICULTY:100,SI_SKILLABILITY: 200]) );
  AddSkill( SK_MAGIC_DEFENSE, 
    ([ SI_SKILLFUNC:"Beweglichkeit",SI_DIFFICULTY:100,SI_SKILLABILITY: 200]));
  AddSkill( SK_RANGER_HERBALISM, 
    ([ SI_SKILLFUNC:"Kraeuterkunde",SI_DIFFICULTY:100,SI_SKILLABILITY: 200]));
    
  archenemys=GUILD_MASTER->get_archenemy_list();
  if(!pointerp(archenemys)) { archenemys=({}); }
  paths=GUILD_MASTER->get_paths();
  if(!pointerp(paths)) { paths=({}); }

  //-- GS 1 - 10 ----------------------------------------------------
  AddSpell(DURCHDRINGE);
  AddSpell(SCHAETZ);
  AddSpell(AUGEN_DES_JAEGERS);
  AddSpell(DEUTSCHUSS);  // 3
  AddSpell(MESSERSTICH); // 3
  AddSpell(GESCHWINDIGKEIT);
  AddSpell(PAKT_DER_SCHATTEN);
  AddSpell(ZAEHMUNG);
  AddSpell(MARKIERUNGSSCHUSS);
  AddSpell(KRAEUTERMIXTUR);
  AddSpell(FUSSTRITT);
  AddSpell(TIERHEILUNG);

  AddSpell(FESSELFALLE);
  AddSpell(FANGFALLE);
  AddSpell(STOLPERDRAHT);
  AddSpell(PFEILFALLE);

  AddSpell(RINDENHAUT);

  AddSpell(ASPEKT_DES_PANTHERS);
  
  //-- Pfad der Tiere -----------------------------------------------
  AddSpell(TIERE_DES_WALDES);
  AddSpell(WALDWOLF);
  AddSpell(SCHWARZBAER);
  AddSpell(ADLER);
  AddSpell(SPINNE);
  AddSpell(WILDER_SCHWARM);
  AddSpell(WALDGEIST);

  //-- Pfad der Iama ------------------------------------------------
  AddSpell(MELODIE_DER_RUHE);
  AddSpell(ODE_DES_STURMES);
  AddSpell(MELODIE_DER_AVATARA);
  AddSpell(HYMNE_DES_WALDES);
  AddSpell(MELODIE_DES_OSTENS);
  AddSpell(MELODIE_DER_VERAENDERUNG);
  AddSpell(MELODIE_DER_ZEIT);

  //-- Pfad des Bogens ----------------------------------------------
  AddSpell(KALTE_FLAMME);
  AddSpell(ZIELSCHUSS);
  //AddSpell(DOPPELSCHUSS);
  AddSpell(PANZERBRECHENDER_SCHUSS);
  AddSpell(GIFTPFEIL);
  AddSpell(SALVE);
  AddSpell(BLICK_DES_FALKEN);
  AddSpell(FREIPFEILE);

  //-- Pfad der Messer ----------------------------------------------
  AddSpell(KLINGENWIRBEL);
  AddSpell(MESSERWURF);
  AddSpell(BLAUE_FLAMME);
  AddSpell(VIOLETTE_FLAMME);
  AddSpell(AUSWEIDEN);
  AddSpell(SEELE_DER_KLINGE);
  AddSpell(SCHATTENSCHNITT);

  //-- Pfad der Tiermeister -----------------------------------------
  AddSpell(TIERANGRIFF);
  AddSpell(KAMPFGEIST);
  AddSpell(KRAFT_DER_AHNEN);
  AddSpell(KRAFT_DES_TIERES);
  AddSpell(GEMEINSAME_ATTACKE);
  AddSpell(WUT_DER_BESTIE);
  AddSpell(INKARNATION_DER_KOEIGE);
  
  SetProp(P_INT_SHORT,"Im Herzen eines riesigen Baumes");
  SetProp(P_INT_LONG,
    "Deine wird Aufmerksamkeit sofort von der imposanten magischen Flamme in der "
    "Mitte des Raumes gefesselt. Die Flammen wechseln regelmaessig ihre Farben, von "
    "lebhaftem Gruen ueber strahlendes Blau bis hin zu warmem Rot, und erfuellen den "
    "Raum mit einem faszinierenden Lichtspiel. Die natuerliche Architektur des Raumes, "
    "die sich organisch in den Baum eingefuegt hat, zeigt sich in den geschwungenen "
    "Boegen und Strukturen, die eine harmonische Verbindung zur umgebenden Natur schaffen. "
    "Die Luft ist erfuellt von einem angenehmen Duft nach frischem Holz und der lebendigen "
    "Energie des Waldes. An einer der Waende ist eine gut sichtbare Rangliste der "
    "Waldlaeufer angebracht, die ihre Hierarchie und Verdienste zeigt. Hier, an diesem "
    "Ort, versammeln sich die Waldlaeufer, um ihre Auftraege zu empfangen."
    );

  //--Details----------------------------------------------------------------

  AddDetail( ({ "architektur" }),
    "Die Architektur des Raumes ist organisch und geschwungen, nahtlos in den Baum eingefuegt und schafft eine harmonische Verbindung zur umgebenden Natur.");

  AddDetail( ({ "aufmerksamkeit" }),
    "Die Aufmerksamkeit wird sofort von der imposanten magischen Flamme in der Mitte des Raumes gefesselt, die regelmaessig ihre Farben wechselt und ein faszinierendes Lichtspiel erzeugt.");

  AddDetail( ({ "auftraege" }),
    "Der Raum dient als der Ort, an dem die Waldlaeufer regelmaessig zusammenkommen, um Auftraege von ihrem Obersten entgegenzunehmen und strategische Entscheidungen zu treffen.");

  AddDetail( ({ "baum" }),
    "Der Raum ist im Inneren eines riesigen Baumes gelegen, dessen natuerliche Struktur eine einzigartige und inspirierende Umgebung schafft.");

  AddDetail( ({ "blau" }),
    "Die magische Flamme in der Mitte des Raumes wechselt regelmaessig zu einem strahlenden Blau.");

  AddDetail( ({ "boden" }),
    "Der Boden des Raumes besteht aus natuerlichen Materialien, die sich angenehm anfuehlen und die Verbundenheit zur Natur unterstreichen.");

  AddDetail( ({ "boegen" }),
    "Geschwungene Boegen praegen die Architektur des Raumes und fuegen sich organisch in die Struktur des riesigen Baumes ein.");

  AddDetail( ({ "duft" }),
    "Die Luft ist erfuellt von einem angenehmen Duft nach frischem Holz und der lebendigen Energie des Waldes, der den Raum durchzieht.");

  AddDetail( ({ "energie" }),
    "Die magische Flamme in der Mitte des Raumes strahlt eine lebendige Energie aus, die den Raum mit einer belebenden Praesenz erfuellt.");

  AddDetail( ({ "farben" }),
    "Die magische Flamme wechselt regelmaessig ihre Farben, von lebhaftem Gruen ueber strahlendes Blau bis hin zu warmem Rot, und taucht den Raum in ein faszinierendes Lichtspiel.");

  AddDetail( ({ "flamme" }),
    "Die imposante magische Flamme in der Mitte des Raumes ist als die Flamme von Tethyr bekannt und symbolisiert die Lebensquelle des gesamten Waldes.");

  AddDetail( ({ "gruen" }),
    "Die magische Flamme wechselt regelmaessig zu einem lebendigen Gruen, das lebendig erstrahlen laesst.");

  AddDetail( ({ "hierarchie" }),
    "An einer der Waende ist eine gut sichtbare Rangliste der Waldlaeufer angebracht, die ihre Hierarchie und Verdienste zeigt.");

  AddDetail( ({ "himmel" }),
    "Die organische Architektur ermoeglicht einen Blick auf den Himmel, der durch das Blaetterdach des Baumes hindurchscheint und eine natuerliche Verbindung zur Umgebung schafft.");

  AddDetail( ({ "holz" }),
    "Die natuerliche Struktur des Raumes besteht aus dem Holz des riesigen Baumes, das sehr natuerlich und rustikal wirkt.");

  AddDetail( ({ "lichtspiel" }),
    "Die magische Flamme erzeugt ein faszinierendes Lichtspiel im Raum, das durch die wechselnden Farben eine dynamische und inspirierend wirkt.");

  AddDetail( ({ "luft" }),
    "Die Luft im Raum ist frisch und erfuellt von einem angenehmen Duft nach dem Wald, der durch die offenen Strukturen des Raumes zirkuliert.");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes thront die imposante Flamme von Tethyr, die als Lebensquelle des gesamten Waldes gilt und den Raum mit ihrer lebendigen Praesenz erfuellt.");

  AddDetail( ({ "natur" }),
    "Die natuerliche Architektur des Raumes schafft eine Verbindung zur umgebenden Natur, die durch die organisch gewachsenen Strukturen und das Holz des Baumes deutlich wird.");

  AddDetail( ({ "ort" }),
    "Der Raum dient als zentraler Ort, an dem die Waldlaeufer zusammenkommen, um ihre Befehle zu erhalten und strategische Entscheidungen zu treffen.");

  AddDetail( ({ "rangliste" }),
    "An einer der Waende ist eine gut sichtbare Rangliste der Waldlaeufer angebracht, die ihre Hierarchie und Verdienste zeigt.");

  AddDetail( ({ "raum" }),
    "Der Raum ist gross und geraeumig, von der natuerlichen Struktur des riesigen Baumes geformt, und von der Natur selbst erfuellt.");

  AddDetail( ({ "raumes" }),
    "Die Struktur des Raumes ist auf natuerliche Weise gewachsen und fuegt sich harmonisch in die Umgebung des riesigen Baumes ein.");

  AddDetail( ({ "rot" }),
    "Die magische Flamme wechselt regelmaessig zu einem warmen Rot, das dem Raum eine gemuetliche und inspirierende Stimmung verleiht.");

  AddDetail( ({ "strukturen" }),
    "Geschwungene Boegen und organisch gewachsene Strukturen praegen die Architektur des Raumes, die sich nahtlos in den riesigen Baum eingefuegt hat.");

  AddDetail( ({ "verbindung" }),
    "Die Architektur des Raumes schafft eine natuerliche Verbindung zur umgebenden Natur, waehrend die Waldlaeufer ihre Befehle entgegennehmen und ihre Strategien besprechen.");

  AddDetail( ({ "verdienste" }),
    "An einer der Waende ist eine Rangliste der Waldlaeufer angebracht, die ihre Verdienste und Positionen innerhalb der Gilde deutlich macht.");

  AddDetail( ({ "waende" }),
    "Die Waende des Raumes sind von der natuerlichen Struktur des riesigen Baumes geformt und bieten Platz fuer die Anzeige der Rangliste der Waldlaeufer.");

  AddDetail( ({ "waldes" }),
    "Die imposante Flamme von Tethyr symbolisiert die Lebensquelle des gesamten Waldes und wird von den Waldlaeufern als zentrales Element des Raumes verehrt.");

  AddDetail( ({ "waldlaeufer" }),
    "Der Raum ist der zentrale Treffpunkt der Waldlaeufer, an dem sie ihre Befehle entgegennehmen und ihre Strategien planen.");

  AddDetail( ({ "waldlaeufer" }),
    "Die Rangliste an der Wand zeigt die Hierarchie und Verdienste der Waldlaeufer innerhalb der Gilde.");

    AddDetail( ({ "anzeige" }),
    "Eine gut sichtbare Anzeige an einer der Waende praesentiert die Rangliste der Waldlaeufer, die ihre Hierarchie und Verdienste deutlich macht.");

  AddDetail( ({ "befehle" }),
    "Der Raum ist der Ort, an dem die Waldlaeufer regelmaessig zusammenkommen, um ihre Befehle vom Obersten der Gilde zu erhalten und strategische Entscheidungen zu treffen.");

  AddDetail( ({ "blaetterdach" }),
    "Das Blaetterdach des Baumes ermoeglicht einen faszinierenden Blick auf den Himmel, der durch die offenen Strukturen des Raumes hindurchscheint.");

  AddDetail( ({ "blick" }),
    "Von verschiedenen Punkten im Raum aus bietet sich ein beeindruckender Blick auf die natuerliche Umgebung des Baumes und des umliegenden Waldes.");

  AddDetail( ({ "element" }),
    "Die natuerliche Struktur des Raumes, im Inneren des riesigen Baumes, ist ein harmonisches Element, das eine Verbindung zur umgebenden Natur schafft.");

  AddDetail( ({ "entscheidungen" }),
    "Der Raum dient als der zentrale Ort, an dem die Waldlaeufer strategische Entscheidungen treffen und ihre naechsten Schritte planen.");

  AddDetail( ({ "gilde" }),
    "Der Raum ist der Treffpunkt der Waldlaeufer, wo die Mitglieder zusammenkommen, um ihre Befehle zu erhalten und ihre Positionen innerhalb der Gilde zu festigen.");

  AddDetail( ({ "inneren" }),
    "Die Struktur des Raumes ist im Inneren des riesigen Baumes gewachsen, was dem Raum eine einzigartige und natuerliche Wirkung verleiht.");

  AddDetail( ({ "lebensquelle" }),
    "Die imposante Flamme von Tethyr, die in der Mitte des Raumes brennt, gilt als die Lebensquelle des gesamten Waldes und wird von den Waldlaeufern verehrt.");

  AddDetail( ({ "materialien" }),
    "Die Materialien im Raum sind natuerlich und bestehen hauptsaechlich aus dem Holz des riesigen Baumes, das sehr naturverbunden wirkt.");

  AddDetail( ({ "obersten" }),
    "Der Raum ist der Ort, an dem die Waldlaeufer regelmaessig zusammenkommen, um ihre Befehle vom Obersten der Gilde entgegenzunehmen.");

  AddDetail( ({ "platz" }),
    "Der Raum bietet ausreichend Platz fuer die Versammlung der Waldlaeufer, wobei die geschwungenen Boegen und Strukturen eine angenehme und offene Architektur schaffen.");

  AddDetail( ({ "positionen" }),
    "An einer der Waende ist eine gut sichtbare Rangliste der Waldlaeufer angebracht, die ihre Positionen innerhalb der Gilde deutlich macht.");

  AddDetail( ({ "praesenz" }),
    "Die Praesenz der imposanten Flamme von Tethyr verleiht den Waldlaeufern eine Verbindung zur Natur.");

  AddDetail( ({ "stimmung" }),
    "Die Stimmung im Raum wird von der wechselnden Farbe der magischen Flamme beeinflusst.");

  AddDetail( ({ "strategien" }),
    "Der Raum dient als der strategische Ort, an dem die Waldlaeufer ihre naechsten Schritte planen und ihre Strategien entwickeln.");

  AddDetail( ({ "struktur" }),
    "Die Struktur des Raumes ist auf natuerliche Weise gewachsen und fuegt sich harmonisch in den riesigen Baum ein, wodurch eine einladende und inspirierende Umgebung entsteht.");

  AddDetail( ({ "tethyr" }),
    "Die magische Flamme in der Mitte des Raumes wird als die Flamme von Tethyr verehrt und symbolisiert die Lebensquelle des gesamten Waldes.");

  AddDetail( ({ "umgebung" }),
