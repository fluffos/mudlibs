  CHMASTER->send("Info",TO,msg,MSG_SAY);
  return ;
}
/****************************************************************************/



/** Titel und Presays *******************************************************/
//-- Der Titel/Presay werden gesetzt -----------------------------------------
int  adjust_title(object player)
{
  string s, s2;
  mixed p;
  int gl, grad, female;
  
  if( !objectp(player)                              || 
      (IS_SEER(player) && file_name(previous_object())[0..30] != "/gilden/waldlaeufer/obj/koecher") || // seher werden nicht uebersteuert
      !IsGuildMember(player)                        || 
      !stringp(s=player->QueryProp(P_RACE))         ||
      !intp(gl=player->QueryProp(P_GUILD_LEVEL))    ||
      !stringp( s2=circle_to_string(GetCircle(gl))) || 
      !intp(female=(player->QueryProp(P_GENDER) == FEMALE)) ) { return 0; }
  
  //Presay Handling
  switch(s)
  { case "Elf":       s+="en"; break;
    case "Hobbit":    s+="";   break;
    case "Mensch":    s+="en"; break;
    case "Dunkelelf": s+="en"; break;
    case "Fee":       s+="n";  break; }
  s+=lower_case(s2);
  if(female) s+="in";
  player->SetProp(P_PRESAY, s);
 
  //Titel
  p=RANGERMASTER->GetPaths(getuid(player));
  grad=GetGrad(gl);
  if(!p || !pointerp(p) || sizeof(p)<1 || gl<=10)
  {
    gl=limit(gl,1,10); 
    s2=circle_to_string(GetCircle(gl));
    if(female) { s=guild_titles_female[s2, (grad-1)]; }
    else {s=guild_titles_male[s2, (grad-1)];}   
    player->SetProp(P_TITLE, s);
    return 1;
  }
  s2=p[sizeof(p)-1];
  if(female) { s=path_titles_female[s2, (grad-1)]; }
  else {s=path_titles_male[s2, (grad-1)];}
  player->SetProp(P_TITLE, s);
  return 1;
}
/****************************************************************************/



/** Ausgabe der Fertigkeiten ************************************************/
//-- Umwandlung Fertigkeiten (zahl/string) -----------------------------------
string ability_to_string(int ability) 
{
 string str;
 
 switch(ability) 
 {
   case 0   ..500 : str="ueberhaupt nicht";                            break;
   case 501 ..1000: str="eigentlich nicht";                            break;
   case 1001..1500: str="fast gar nicht";                              break;
   case 1501..2000: str="kaum";                                        break;
   case 2001..2500: str="sehr schlecht";                               break;
   case 2501..3000: str="nur sehr laienhaft";                          break;
   case 3001..3500: str="schlecht";                                    break;
   case 3501..4000: str="wie ein Amateur";                             break;
   case 4001..4500: str="unterdurchschnittlich";                       break;
   case 4501..5000: str="durchschnittlich";                            break;
   case 5001..5500: str="etwas ueberdurchschnittlich";                 break;
   case 5501..6000: str="ueberdurchschnittlich";                       break;
   case 6001..6500: str="fast ausreichend";                            break;
   case 6501..7000: str="ausreichend";                                 break;
   case 7001..7500: str="recht sicher";                                break;
   case 7501..8000: str="relativ gut";                                 break;
   case 8001..8500: str="gut";                                         break;
   case 8501..9000: str="sehr gut";                                    break;
   case 9001..9500: str="wie ein Waldlaeufer";                         break;
   case 9501..9750: str="fast fehlerfrei";                             break;
   case 9751..9850: str="wie ein Hueter";                              break;
   case 9851..9900: str="fehlerfrei";                                  break;
   case 9901..9950: str="wie ein Meister";                             break;
   case 9951..9999: str="wie ein Lehrmeister";                         break;
   case 10000     : str="wie ein legendaerer Meister";                 break;
   default        : str="nicht";                                       break;
  }
  return str;
}

//-- Die zauber werden gross geschrieben -------------------------------------
string cap_skill(string str)
{
  int i;
  string word, *words;
  
  words=explode(str, " "); word="";
  for(i=0;i<sizeof(words);i++)
  { if(member(({"der", "des"}), words[i]) == -1) { words[i]=CAP(words[i]); }
    word+=words[i]+" "; }
  return word[0..<2];
}

//-- Zusammenfassung in string -----------------------------------------------
string fertigkeiten(object ob)
{
  string s, *paths, spellpath;
  int i, abil, abils;
  mixed m, keys;
  
  if(!objectp(ob) || !mappingp(m=ob->QueryProp(P_NEWSKILLS))) { return ""; }
  s=GUILD_NPC+" fluestert Dir zu:\n";
  keys=sort_array(m_indices(m), CLOSURE(>));
  abils=0;
  paths = RANGERMASTER->GetPaths(getuid(ob));
  for(i=0;i<sizeof(keys);i++)
  {
    if(member( ({SK_RANGER_HERBALISM, SK_MAGIC_DEFENSE, FIGHT(WT_BOW), 
                 FIGHT(WT_KNIFE)}), keys[i]) != -1) { continue; }

    spellpath = RANGERMASTER->get_path(abil);
    if(stringp(spellpath) && member(paths, spellpath) < 0) continue;

    abil=ob->QuerySkillAbility(keys[i]);
    s+=BS(" "+cap_skill(keys[i])+" kannst Du "
       +ability_to_string(abil)+".\n"); 
    abils+=abil; 
  }
  abil=ob->QuerySkillAbility(SK_RANGER_HERBALISM);
  s+=BS(" Kraeuterkunde kannst Du "
     +ability_to_string(abil)+".\n");
  abils+=abil;
  abil=ob->QuerySkillAbility(SK_MAGIC_DEFENSE);
  s+=BS(" Beweglichkeit kannst Du "
     +ability_to_string(abil)+".\n");
  abils+=abil;
  abil=ob->QuerySkillAbility(FIGHT(WT_BOW));
  s+=BS(" Bogenkampf kannst Du "
     +ability_to_string(abil)+".\n");
  abils+=abil;
  abil=ob->QuerySkillAbility(FIGHT(WT_KNIFE));
  s+=BS(" Dolchkampf kannst Du "
     +ability_to_string(abil)+".\n");
  abils+=abil;
  i=limit(ob->QueryProp(P_GUILD_RATING),0,MAX_ABILITY);
  s+=BS(" In Summe bist du "
     +ability_to_string(i)+".");
  return s;
}
/****************************************************************************/



/** Skills der Gilde ********************************************************/

mapping show_enemy(object player, object enemy)
{
  string s;
  int hp, maxhp;
  if( random(50) <= 20 + player->QueryProp(P_GUILD_LEVEL) && enemy)
  {
    hp = enemy->QueryProp( P_HP );
    maxhp = enemy->QueryProp( P_MAX_HP );
    s = enemy->Name(WER, 1);
    switch(100 * hp / maxhp)
    {
      case 0..1: s += " ist eigentlich schon tot"; break;
      case 2..3: s += " ist am Verbluten und wird gleich sterben"; break;
      case 4..6: s += " steht auf der Schwelle des Todes"; break;
      case 7..9: s += " blutet aus vielen toedlichen Wunden"; break;
      case 10..12: s += " blutet aus vielen schweren Wunden"; break;
      case 13..15: s += " braucht sofort einen Notarzt"; break;
      case 16..18: s += " braucht dringend einen Arzt"; break;
      case 19..21: s += " braucht bald einen Arzt"; break;
      case 22..24: s += " ist in extrem schlechter Verfassung"; break;
      case 25..27: s += " ist in sehr schlechter Verfassung"; break;
      case 28..30: s += " ist in keiner guten Verfassung"; break;
      case 31..33: s += " ist in einem ueblen Zustand";break;
      case 34..36: s += " wankt bereits bedenklich"; break;
      case 37..39: s += " wankt schon etwas"; break;
      case 40..42: s += " macht einen stark mitgenommenen Eindruck"; break;
      case 43..45: s += " macht einen mitgenommenen Eindruck"; break;
      case 46..48: s += " macht einen etwas mitgenommenen Eindruck"; break;
      case 49..51: s += " sieht schon relativ schlecht aus"; break;
      case 52..54: s += " sieht gar nicht mehr gut aus"; break;
      case 55..57: s += " sieht nicht mehr taufrisch aus"; break;
      case 58..60: s += " ist schwer angeschlagen"; break;
      case 61..63: s += " ist ziemlich angeschlagen"; break;
      case 64..66: s += " ist leicht angeschlagen"; break;
      case 67..69: s += " fuehlt sich ziemlich schlecht"; break;
      case 70..72: s += " fuehlt sich etwas schlecht"; break;
      case 73..75: s += " fuehlte sich heute schon besser"; break;
      case 76..78: s += " ist schon ziemlich geschwaecht"; break;
      case 79..81: s += " ist schon etwas geschwaecht"; break;
      case 82..84: s += " hat schon viele Kratzer"; break;
      case 85..87: s += " hat schon einige Kratzer"; break;
      case 88..90: s += " hat erst ein paar Kratzer"; break;
      case 91..93: s += " ist noch bei bester Gesundheit"; break;
      case 94..96: s += " ist bei hervorragender Gesundheit"; break;
      case 97..98: s += " ist bei ausgezeichneter Gesundheit"; break;
      case 99..100: s += " ist absolut fit"; break;
      default: s+= " ist bei bester Gesundheit";
    }
    switch( player->QueryProp(P_TTY) )
    {
      case "ansi" :
          s = ANSI_GREEN + ANSI_BG_BLACK + s + ANSI_NORMAL; break;
      case "vt100" : s = ANSI_BOLD + s + ANSI_NORMAL; break;
    }
    s += ".\n";
    tell_object(player,s);
  }
}

public void registerArchenemyAttack(object enemy, object pl) {
  if( GUILD_MASTER->is_archenemy_of(getuid(pl), enemy) && (enemy->QueryProp(P_LEVEL))>=(pl->QueryProp(P_GUILD_LEVEL)) ){ 
    GUILD_MASTER->IncKilledArchenemys(getuid(pl), 1); 
  }
}

private void executePetSupport(object enemy, object player) {
  mapping *x;

  if(!pointerp(x=player->QueryProp(P_RANGER_PET_SUPPORT))) return;
  if(!objectp(x[0])) { // pet ist weg
    player->SetProp(P_RANGER_PET_SUPPORT, 0);
    return;
  }

  x[0]->supportRanger(enemy);
  return;
}

private mapping deep_bond_special_attack(object player, mapping sinfo) {
  object koecher, enemy, pet, p;

  if(random(100) > player->QueryAttribute(A_INT)/2) return sinfo;
  if(!objectp(player)) return sinfo;
  if(!objectp(enemy = sinfo[SI_ENEMY])) return sinfo;
  if(!objectp(koecher = present(GUILD_OBJ_ID, player))) return sinfo;
  if(koecher->_query_master_ability() != MASTER_ABIILITY_DEEP_BOND) return sinfo;
  if(!objectp(pet = koecher->FindPet(player))) return sinfo;

  switch(pet->QueryProp(P_RANGER_PET_RACE)) {
    case "katze":
      tell_object(player, BS("Dein Angriff verursacht eine blutende Wunde."));
      tell_room(ENV(enemy), BS(player->Name(WESSEN)+" Angriff verursacht eine blutende Wunde."), ({player}));
      call_other(GUILD_SPELLBOOK, "eviscerate_bleed", enemy, sinfo[SI_SKILLDAMAGE]/20, player);
      break;
    case "riese":
      tell_object(player, BS("Deine Attacke kommt mit der Wucht eines wilden Nasnhorns."));
      enemy->SetProp(P_DISABLE_ATTACK, 1);
      enemy->SetProp(P_LAST_RAMMEN_TIME, time());
      tell_room(ENV(enemy), BS(enemy->Name(WER)+" faellt zu Boden."));
      break;
    case "vogel":
      tell_object(player, BS("Schnell wie ein Vogel wirbelst du herum und bist bereit fuer den naechsten Angriff."));
      player->SetProP(P_NEXT_SPELL_TIME, time()-5);
      break;
    case "spinne":
    if(!enemy->is_class_member(({CL_UNDEAD})) && !objectp(present(NPC_POISON_ID, enemy)))
      tell_object(player, BS("Dein Angriff vergiftet deinen Gegner."));
      p=clone_object(OBJ "npc_poison"); p->move(enemy, M_TPORT|M_SILENT);
      p->poison(enemy, player, 0, random(pet->QueryProp(P_LEVEL)));
      tell_room(ENV(enemy), BS("Der Angriff von "+player->name(WEM)+" vergiftet "+enemy->name(WEN)+"."), ({player}));
      break;
    case "panzertier":
      tell_object(player, BS("Du haeltst einen Moment inne und atmest durch."));
      tell_room(ENV(player), BS(player->Name(WER)+" haelt einen Moment inne und atmet durch."), ({player}));
      player->AddHp(player->QueryProp(P_LEVEL)/10);
      break;
    case "huftier":
      // nothing -> gives a higher chance to dodge
      break;
    case "echse":
      tell_object(player, BS("Mit starrem Blick konzentrierst du dich einen Moment in Reglosigkeit."));
      tell_room(ENV(player), BS(player->Name(WER)+" verharrt einen Moment reglos."), ({player}));
      player->AddSp(player->QueryProp(P_LEVEL)/10);
      break;
    case "kleintier":
      tell_object(player, BS("Du visierst eine ungerschuetzte Stelle "+enemy->name(WESSEN)+" an."));
      tell_room(ENV(player), BS(player->Name(WER)+" visiert eine ungeschuetzte Stelle "+enemy->name(WESSEN)+" an."), ({player}));
      sinfo[OFFSET(SI_SKILLDAMAGE)] += sinfo[SI_SKILLDAMAGE] / 10;
      break;
    case "insekt":
      tell_object(player, BS("Du laesst deine Angriffe in rasender Geschwindigkeit erfolgen."));
      player->ModifySkillAttribute(SA_SPEED, 200, 2+random(2), TO);
      break;  
  }
  return sinfo;
}

//-- Dolchkampf (FIGHT(WT_KNIFE)) --------------------------------------------
public mapping Dolchkampf(object player, string skill, mapping sinfo) { 
  mixed kf, *x;
  object ob;
  int abil, ud, val, bonus, wc, wcRem, fix, swc, r;

  if(objectp(ob=present(VISION_ID, player)) && ob->QueryProp(P_RANGER_LIFE_SENSE)) {
    show_enemy(player, sinfo[SI_ENEMY]);
  }

  registerArchenemyAttack(sinfo[SI_ENEMY], player);
  sinfo = deep_bond_special_attack(player, sinfo);
  
  executePetSupport(sinfo[SI_ENEMY], player);
  if(!objectp(sinfo[SI_ENEMY])) return sinfo; // Gegner durch pet assist gestorben

  ud=sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  val = (3 * player->QueryAttribute(A_DEX) + 4*player->QueryProp(P_GUILD_LEVEL)) * abil / MAX_ABILITY;

  bonus=random(val);

  // wir rufen den blutdorn hier auf, damit wir die bestehenden HitFuncs von magischen Waffen nicht kaputt machen
  if(objectp(ob=present(BLUTDORN_ID, player))) {
    bonus += ob->HitFunc(sinfo[SI_ENEMY]);
  }

  // Frosch oder zu schlechte Waffe -> kein lernen
  if(abil<MAX_ABILITY && !player->QueryProp(P_FROG) && player->QueryProp(P_WEAPON)->QueryProp(P_WC) > abil/90 && (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > abil/400 || !random(10) ) && ++ud > abil/50) {
    ud = 0;
    abil += random(player->QuerProp(P_GUILD_LEVEL) + player->QueryAttribute(A_DEX)/3);
    if (abil >= MAX_ABILITY) tell_object(player, BS("Du hast nun die Vollendung um Messerkampf erreicht!"));
  }

  if(RANGERMASTER->is_archenemy_of(player, sinfo[SI_ENEMY]) && ! random(3)) {
    sinfo[SI_SKILLDAMAGE]+=(sinfo[SI_SKILLDAMAGE]*player->QueryProp(P_GUILD_LEVEL))/100;
    if(!random(2)) {
      tell_object(player, BS("Dein Wissen ueber die Anatomie deiner Feinde hilft dir einen Treffer zu landen!"));
    }
  }

  //Skillpoints
  if(R_SKILLMASTER->HasSkill(getuid(player), MESSERKAMPF)) { 
    sinfo[SI_SKILLDAMAGE]+=player->QueryProp(P_GUILD_LEVEL) * 5; 
  }
  
  if(R_SKILLMASTER->HasSkill(getuid(player), KLINGENMEISTER)) { 
    sinfo[SI_SKILLDAMAGE]+=random(player->QueryProp(P_GUILD_LEVEL) * 5); 
  }

  if(player->QueryProp(P_RANGER_ODE_DES_STURMES_ACTIVE) > time() && !random(25-player->QueryProp(P_GUILD_LEVEL))) {
    if(!pointerp(sinfo[SI_SKILLDAMAGE_TYPE])) sinfo[SI_SKILLDAMAGE_TYPE] = ({sinfo[SI_SKILLDAMAGE_TYPE]});
    sinfo[SI_SKILLDAMAGE_TYPE] += ({DT_LIGHTNING});
  }

  if(!random(500+MAX_ABILITY-abil)) {
    tell_object(player, "Du laesst deine Klingen in irrsinniger Geschwindigkeit wirbeln!\n");
    if(player->QuerySkillAttribute(SA_SPEED) <= 100) {
      player->ModifySkillAttribute(TO, SA_SPEED, 200 + random(100), 2+random(abil/1000));
    } else {
      player->ModifySkillAttribute(TO, SA_SPEED, 150, 2+random(abil/2000));
    }
  }

  if(R_SKILLMASTER->HasSkill(getuid(player), SPEED_TWO)) {
    swc = player->QueryProp(P_GUILD_LEVEL) /4;
    r = random(100);
    pDebug(player, sprintf("messerkampf :: second wind chance=%d roll=%d\n", swc, r));
    if(r < swc) {
      call_out("second_wind", 0, player, sinfo[SI_ENEMY]);
    }
  }

  // Seele der Klinge
  if(objectp(ob=present(EDGE_SOUL_ID, player))) {
    sinfo[SI_SKILLDAMAGE] += ob->CheckCritical(sinfo);
    if(ob->QueryProp(P_DAM_TYPE) != 0) sinfo[SI_SKILLDAMAGE_TYPE] = ({ ob->QueryProp(P_DAM_TYPE) });
  }  

  sinfo[SI_SKILLDAMAGE]+=bonus*player->QuerySkillAttribute(SA_DAMAGE)/100;

  // Meisterfertigkeit: Tausend Schnitte
  if(RANGERMASTER->GetMasterAbility(getuid(player)) == MASTER_ABIILITY_THOUSAND_CUTS) {
    r = random(100);
    pDebug(player, sprintf("messerkampf :: thousand cuts chance=%d roll=%d\n", player->QueryAttribute(A_DEX), r));
    if(r < player->QueryAttribute(A_DEX)/3) {
      tell_object(player, BS("Du hinterlaesst einen blutenden Schnitt bei "+sinfo[SI_ENEMY]->name(WEM)+"."));
      pDebug(player, sprintf("messerkampf :: thousand cuts dam=%d\n", sinfo[SI_SKILLDAMAGE]/20));
      sinfo[SI_ENEMY]->SetProp(P_RANGER_EVISCERATED_UNTIL, time()+2+random(8));
      call_other(GUILD_SPELLBOOK, "eviscerate_bleed", sinfo[SI_ENEMY], sinfo[SI_SKILLDAMAGE]/20, player);
    }
  } else // Meisterfertigkeit: Verkruepellnder Stoss
  if(RANGERMASTER->GetMasterAbility(getuid(player)) == MASTER_ABIILITY_CRIPPLING_STRIKE) {
    r = random(100);
    if(r < player->QueryAttribute(A_DEX)/3) {
      tell_object(player, BS("Dein Angriff verkrueppelt "+sinfo[SI_ENEMY]->name(WEN)+"."));
      pDebug(player, sprintf("messerkampf :: crippling strike debuff=%d duration=%d\n", player->QueryAttribute(A_STR)/2, sinfo[SI_SKILLDAMAGE]/20));
      ob = clone_object(OBJ "crippled");
      if(!ob->move(sinfo[SI_ENEMY])) {
        destruct(ob);
      } else {
        ob->set_debuff(-1 * player->QueryAttribute(A_STR)/4);
        ob->set_timeout(sinfo[SI_SKILLDAMAGE]/20);
      }
    }
  }

  player->ModifySkill( FIGHT(WT_KNIFE), ([ SI_USR: ud, SI_SKILLABILITY: abil ]), sinfo[SI_DIFFICULTY], "waldlaeufer"); 
  return sinfo;
}

public void second_wind(object player, object enemy) {
  int fix, wc, wcRem, bonus, y;
  object weapon;

  pDebug(player, sprintf("second_wind :: player=%O enemy=%O\n", player, enemy));

  if(!objectp(player) || !objectp(enemy)) return;

  bonus = random((3 * player->QueryAttribute(A_DEX) + 4*player->QueryProp(P_GUILD_LEVEL)) * player->QuerySkillAbility(FIGHT(WT_KNIFE)) / MAX_ABILITY);
  weapon = player->QueryProp(P_WEAPON);
  if(!objectp(weapon)) return;
  wc = weapon->QueryProp(P_WC);
  fix = wc * weapon->QueryProp(P_WC_FIX)/100;
  wcRem = wc - fix;

  tell_object(player, "Mit rasender Geschwindigkeit setzt du einen weiteren Angriff nach!\n");
  enemy->Defend(fix + bonus + random(wcRem), weapon->QueryProp(P_DAM_TYPE), ([SP_PHYSICAL_ATTACK:1, SP_SHOW_DAMAGE: 1]), player);

  return;
}

//-- Bogenkampf (FIGHT(WT_BOW)) ----------------------------------------------
public mapping Bogenkampf(object player, string skill, mapping sinfo) { 
  mixed kf, *x;
  object ob;
  int abil, ud, val, bonus, y;

  if(objectp(ob=present(VISION_ID, player)) && ob->QueryProp(P_RANGER_LIFE_SENSE)) {
    show_enemy(player, sinfo[SI_ENEMY]);
  }

  registerArchenemyAttack(sinfo[SI_ENEMY], player);
  sinfo = deep_bond_special_attack(player, sinfo);
  executePetSupport(sinfo[SI_ENEMY], player);
  if(!objectp(sinfo[SI_ENEMY])) return sinfo; // Gegner durch pet assist gestorben

  ud=sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  val = (3 * player->QueryAttribute(A_DEX) + 4*player->QueryProp(P_GUILD_LEVEL)) * abil / MAX_ABILITY;

  bonus=random(val);

  // Frosch oder zu schlechte Waffe -> Fertig
  if(player->QueryProp(P_FROG) || player->QueryProp(P_WEAPON)->QueryProp(P_WC) < abil/40) return sinfo;
  
  // lernen
  if( (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > abil/400 || !random(10) ) && ++ud > abil/50 && abil<MAX_ABILITY) {
    ud = 0;
    abil += random(player->QuerProp(P_GUILD_LEVEL) + player->QueryAttribute(A_DEX)/3);
    if (abil >= MAX_ABILITY) tell_object(player, BS("Du hast nun die Vollendung um Bogenkampf erreicht!"));
  }

  if(RANGERMASTER->is_archenemy_of(player, sinfo[SI_ENEMY]) && ! random(3)) {
    sinfo[SI_SKILLDAMAGE]+=(sinfo[SI_SKILLDAMAGE]*player->QueryProp(P_GUILD_LEVEL))/100;
    if(!random(2)) {
      tell_object(player, BS("Dein Wissen ueber die Anatomie deiner Feinde hilft dir einen Treffer zu landen!"));
    }
  }

  //Skillpoints
  if(R_SKILLMASTER->HasSkill(getuid(player), BOGENKAMPF)) { 
    sinfo[SI_SKILLDAMAGE] += player->QueryProp(P_GUILD_LEVEL) * 5; 
  }
  
  if(R_SKILLMASTER->HasSkill(getuid(player), BOGENMEISTER)) { 
    sinfo[SI_SKILLDAMAGE]+=random(player->QueryProp(P_GUILD_LEVEL) * 5); 
  }

  // Kalte Flamme
  if(pointerp(kf=player->QueryProp(P_RANGER_COLD_FLAME)) && kf[1] >= time()) {
    if(!pointerp(sinfo[SI_SKILLDAMAGE_TYPE])) sinfo[SI_SKILLDAMAGE_TYPE]=({sinfo[SI_SKILLDAMAGE_TYPE]});
    sinfo[SI_SKILLDAMAGE_TYPE] += kf[2];
    sinfo[SI_SKILLDAMAGE] += random(kf[3]);
  }

  if(!random(500+MAX_ABILITY-abil) ) {
    tell_object(player, "Du landest einen perfekten Treffer!\n");
    sinfo[SI_SKILLDAMAGE] *= 2;
  }

  player->ModifySkill( FIGHT(WT_BOW), ([ SI_USR: ud, SI_SKILLABILITY: abil ]), sinfo[SI_DIFFICULTY], "waldlaeufer"); 

  sinfo[SI_SKILLDAMAGE]+=bonus*player->QuerySkillAttribute(SA_DAMAGE)/100;

  // falkenauge meisterschuss
  if(pointerp(x=player->QueryProp(P_RANGER_FALCONEYES))) {
    if(x[0] < time()) {
      player->SetProp(P_RANGER_FALCONEYES, 0);
    } else {
      y = sinfo[SI_SKILLDAMAGE];
      if(x[2] < 0.0) {
        sinfo[SI_SKILLDAMAGE] = (int) (sinfo[SI_SKILLDAMAGE] * (1.0 + x[2])); // kampfmalus bei fehlschlag auf alles
      } else {
        if(x[1] == sinfo[SI_ENEMY]) {
          sinfo[SI_SKILLDAMAGE] = (int) (sinfo[SI_SKILLDAMAGE] * (1.0 + x[2])); // kampfbonus auf den gegner
        } else {
          sinfo[SI_SKILLDAMAGE] = (int) (sinfo[SI_SKILLDAMAGE] * (1.0 - x[2])); // malus auf alle anderen gegner
        }
        pDebug(player, sprintf("falkenauge :: bonus=%.2f damBefore=%d modifiedDamage=%d\n", x[2], y, sinfo[SI_SKILLDAMAGE]));
      }
    }
  }

  if(RANGERMASTER->GetMasterAbility(getuid(player)) == MASTER_ABIILITY_CRITICAL_AIM) {
    pDebug(player, "critical aim :: check\n");
    if(random(100) < player->QueryAttribute(A_DEX)/2) {
      tell_object(player, "Du konzentrierst dich auf eine kritische Stelle und triffst sie perfekt!\n");
      tell_room(ENV(player), BS(player->Name(WER)+" konzentriert sich und trifft eine kritische Stelle!"), ({player}));
      sinfo[SI_SKILLDAMAGE] *= 2;
    }
  }

  return sinfo;
}

private int deep_bond_special_edodge(object player, int sinfo) {
  object koecher, pet;

  if(random(100) > player->QueryAttribute(A_INT)/2) return sinfo;
  if(!objectp(player)) return sinfo;
  if(!objectp(koecher = present(GUILD_OBJ_ID, player))) return sinfo;
  if(koecher->_query_master_ability() != MASTER_ABIILITY_DEEP_BOND) return sinfo;
  if(!objectp(pet = koecher->FindPet(player))) return sinfo;
  if(pet->QueryProp(P_RANGER_PET_RACE) != "huftier") return sinfo;
  if(!random(40-pet->QueryProp(P_LEVEL))) return sinfo;

  tell_object(player, BS("Du schlaegst wilde Haken als haettest du Hufe!"));
  return sinfo * 2;
}

//-- Beweglichkeit (SK_MAGIC_DEFENSE) ----------------------------------------
mapping Beweglichkeit(object player, string skill, mapping sinfo) 
{ 
  int ability, usage, r, k, i, dex, playerSize, enemySize, avoided;
  mixed spell, dam_type, *x;
  string *messages, *feen, *froesche, *indoor, *normal, *forest;
  mapping env;
  object ob;

  if(pointerp(x=player->QueryProp(P_RANGER_FALCONEYES)) && x[0] < time() && sinfo[SI_ENEMY] != x[1]) {
    // mit aktivem falkenauge vernachlaessigen wir unsere verteidigung gegenueber allen anderen
    // -> kein ausweichen ausser gegen das fokussierte ziel
    return sinfo;
  }

  // kein Ausweichen, wenn es grad nicht geht (Zaubervorbereitung) oder wir paralysiert, blind etc. sind
  // Sinne des Jaegers lassen uns aber auch Blind ausweichen
  if(RANGERMASTER->GetMasterAbility(getuid(player)) != MASTER_ABIILITY_BACKOFF) {
    if((player->QueryProp(P_RANGER_NO_MAGIC_DEFENSE)+1)>=time()) {return sinfo;}
    if( player->QueryProp(P_PARALYZED) || (player->QueryProp(P_BLIND) && !objectp(present(VISION_ID, player))  || 
        player->QueryProp(P_DISABLE_ATTACK))) {
        return sinfo;
    }
  }

  registerArchenemyAttack(sinfo[SI_ENEMY], player);

  // Ein paar Werte initialisieren zum Speicher sparen. Das hier passiert immerhin in JEDEM Defend
  spell = sinfo[SI_SPELL];
  ability=sinfo[SI_SKILLABILITY];
  dex = player->QueryAttribute(A_DEX);
  enemySize = sinfo[SI_ENEMY]->QueryProp(P_SIZE);
  playerSize = player->QueryProp(P_SIZE);

  //Das Ausweichen:
  //Es wird komplett ausgewichen, man muss es sich so vorstellen, dass der/die
  // Waldlaeufer/in aus der Reichweite springt/hechtet oder so. -> damage wird
  // ergo auf 0 gesetzt. (akrobaten im kampf :-))
  // Wir wenden einfache Mathematik an, weil komplexe Formeln sich zu 99% auf einfache
  // Wahrscheinlichkeiten reduzieren lassen.
  
  // r ist unsere basischance auszuweichen (in %o) -> pro 2000 punkte 1% chance einem angriff auszuweichen
  // macht bei MAX_ABILITY eine 5% Basischance. Wir rechnen aber in Promille also pro 200 Punkte +0.5%
  r = ability / 200;

  // Besonders hohes Geschick erhoeht die Chance nochmal
  if(dex > 25) {
    r += dex-25; // bei DEX 40 -> +1.5%
  }

  // Mit Talent gibt es noch einen Bonus auf Basis der GS
  if(R_SKILLMASTER->HasSkill(getuid(player), AKROBATIK)) {
    r += player->QuerProp(P_GUILD_LEVEL); // bei GS 20 -> 2%
  }

   // Mit dem Respekt der Tiere ist unsere Chance, dass wir Tieren ausweichen doppelt so hoch.
   if(R_SKILLMASTER->HasSkill(getuid(player), TIER_RESPEKT) &&  stringp(PETMASTER->PetCategory(sinfo[SI_ENEMY]))) {
    r *= 2;
  }

  // Bestimmte environments haben auch eine Auswirkung
  if(mappingp(env=ENV(player)->QueryProp(P_ENVIRONMENT)) && member(env, ENV_TERRAIN)) {
    switch(env[ENV_TERRAIN]) {
      case TT_FOREST: 
      case TT_JUNGLE: r += 10; break;
      case TT_WATER:
      case TT_UNDERWATER:
      case TT_CAVE: r -= 10; break; // hoehlen sind eng, schwimmend ist es schwer
      case TT_PLAIN:
      case TT_DESERT: r += 5; break; // hier ist Platz
      case TT_SWAMP:
      case TT_MOUNTAIN: r -= 5; break; // hier muss man beim ausweichen mehr aufpassen
      case TT_AIR:
        if(player->is_class_member(CL_FLYING)) r += 20; break; // fliegen!
    }
  }

  // Groessendifferenz
  if(enemySize > 0) {
    if(enemySize > playerSize) {
      r += limit(10*enemySize/playerSize, 0, 20); // -> max. +2% chance auszuweichen
    } else if(playerSize > enemySize) {
      r -= limit(10*playerSize/enemySize, 0, 20); // -> max. -2% chance auszuweichen
    }
  }

  // Hier kommen wir nur hin mit P_DISABLE_ATTACK wenn wir die Meisterfertigkeit "Zurueckweichen" haben
  // damit wird die Chance verdreifacht
  if(player->QueryProp(P_DISABLE_ATTACK) && RANGERMASTER->GetMasterAbility(getuid(player)) == MASTER_ABIILITY_BACKOFF) {
    r *= 3;
  }

  // magischen Angriffen wird schwieriger ausgewichen, ausser sie sind physisch
  if(mappingp(spell) && (!member(spell, SP_PHYSICAL_ATTACK) || (member(spell, SP_PHYSICAL_ATTACK) && !spell[SP_PHYSICAL_ATTACK]))) {
    dam_type=sinfo[SI_SKILLDAMAGE_TYPE];
    if(!pointerp(dam_type)) dam_type = ({ dam_type });

    // DT_MIND (geistigen Angriffen) laesst sich nicht ausweichen
    if(member(dam_type, DT_MIND) >= 0 || member(dam_type, DT_TERROR) >= 0) return sinfo;

    // bestimmten "magischen" angriffen ist ausweichen schwerer
    k = 0;
    for(i=0; i<sizeof(dam_type); ++i) {
      if(member(({DT_SOUND, DT_MAGIC, DT_ELECTRIC, DT_UNHOLY, DT_HOLY, DT_TERROR}), dam_type[i]) >= 0) k++;
    }

    // Die Chance wir anteilsmaessig der magischen Schaeden reduziert
    r = (int) (r * (1.0 - k / sizeof(dam_type)));
  }
   
  sinfo[SI_USR]++; //usage wird unabhaengig vom tatsaechlichen ausweichen 
                  //angewendet, wichtig fuer das lerntempo
  usage=sinfo[SI_USR];

  //Das Lernen:
  //kein lernen wenn der Gegner zu schwach ist, der auszuweichende schaden zu
  //gering und natuerlich nur sehr selten, da dieser Skill bei JEDEM Defend
  //aufgerufen wird!
  if( (!random(5))                                                      &&
      (ability < MAX_ABILITY)                                           &&
      (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > ability/333)               &&
      (sinfo[SI_SKILLDAMAGE] >= ability/500)                            &&
      (usage > ability/50)  ) {
    usage=0;
    ability+=1+random(player->QuerProp(P_GUILD_LEVEL)+player->QueryAttribute(A_DEX)/2); //1-30
    if (ability >= MAX_ABILITY) { 
      tell_object(player, BS("Deine Beweglichkeit und Koerperberherrschung "
                             "haben ihren Hoehepunkt erreicht. Du kannst "
                             "Dich nichtmehr weiter steigern."));
      ability=MAX_ABILITY;
    }

    player->ModifySkill( SK_MAGIC_DEFENSE, ([ SI_USR: usage, SI_SKILLABILITY: ability ]), sinfo[SI_DIFFICULTY],"waldlaeufer"); 
  }

  froesche=({"Du bist so klein, dass Du kaum getroffen wirst und leicht "
             "ausweichen kannst.","Du huepfst mit einem weiten Sprung aus der"
             " Reichweite Deines Gegners."});
  feen=({"Elegant flatterst Du hin und her und entgehst so der Attacke.",
         "Schnell fliegst Du nach oben und wirst so nicht getroffen."});
  forest=({"Schnell gehst Du hinter einem Baum in Deckung.","Du wirfst einige"
           " Blaetter und Zweige nach oben, durch die gekonnte Ablenkung "
           "wirst Du nicht getroffen.","Du springst schnell nach oben, "
           "schwingst Dich an einem Ast rauf und entgehst somit dem Schaden.",
           "Du wirbelst herum, laeufst auf einem Baum zu. Du laeufst den "
           "Baum gekonnt mit zwei Schritten nach oben und drueckst Dich "
           "kraftvoll ab, um mit einem elegentan Rueckwaertssalto zu landen. "
           "Dein Gegner hatte keine Chance Dich zu treffen."});
  indoor=({"Du springst schnell an eine Wand, um Dich gleich wieder mit eine "
           "Drehung zur Seite abzustossen. Der Angriff Deines Feindes geht "
           "ins Leere.","Du laeufst an der Wand entlang und springst nach "
           "einem Wandlauf ueber den Angriff des Gegners.", "Du drehst dich "
           "um, springst an die Wand und drueckst Dich nach hinten ab. Mit "
           "einem Salto segelst Du ueber die Attacke des Gegners hinweg."});
  normal=({"Mit einem kraeftigen Sprung hechtest Du aus der Reichweite deines"
           " Feindes.","Du gehst in die Knie und tauchst unter den Angriff "
           "durch.","Du rollst Dich nach vorne ab.","Du rollst Dich in "
           "letzter Sekunde nach links ab.","Im letzten Moment rollst Du "
           "Dich nach rechts ab.","Du laesst Dich nach hinten fallen und "
           "nach einer geschickten Rueckwaertsrolle stehst Du wieder "
           "unbeschadet auf den Fuessen.","Du springst genau nach oben, "
           "ziehst die Beine an und der Angriff verfehlt Dich.","Du beugst "
           "Dich schnell nach hinten und spuerst wie der Angriff knapp ueber "
           "Deinem Gesicht wirkungslos verpufft.","Reaktionsschnell wirfst "
           "Du Dich auf den Boden und wirst somit nicht getroffen.",
           "Blitzartig wirbelst Du herum und Durch die schnelle Drehung, "
           "gelingt es deinem Feind nicht, Dich zu verletzen.","Du machst "
           "einen Schritt nach vorne und rechts und springst mit einem Salto "
           "ueber den Angriff hinweg. Nach diesem geschickten "
           "Ausweichmanoever stehst Du in optimaler Konterposition.",
           "Schnell und sicher schlaegst du ein Rad zur Seite und rettest "
           "Dich so vor dem Angriff.","Wie ein Karnickel schlaegst Du Haken "
           "und bringst Dich in Sicherheit."});

  // und hier der test on wir ausweichen
  k = random(1000);
  r = deep_bond_special_edodge(player, r);
  pDebug(player, sprintf("ausweichen :: chance=%d roll=%d\n", r, k));

  // chance trifft ein -> ausweichen
  if(k <= r){
    avoided = 1;
  } else {
    // die Melodie des Ostens gibt uns nochmal einen Bonus aufs ausweichen
    if(objectp(ob=present(MELODIE_DES_OSTENS_ID, player))) {
      pDebug(player, sprintf("ausweichen :: mdo bonus=%d\n",  ob->QueryProp(P_X_ATTR_MOD)[A_DEX]*2)); 
      if(k  <= (r + ob->QueryProp(P_X_ATTR_MOD)[A_DEX]*2)) {
        tell_object(player, BS("Deine ubernatuerliche Geschmeidigkeit und Geschicklichkeit helfen dir besser auszuweichen."));
        avoided = 1;
      }
    }

    // sinne des jaegers koennen uns einen re-roll erlauben
    if(objectp(present(VISION_ID, player)) && R_SKILLMASTER->HasSkill(getuid(player), SINNE_DES_JAEGERS)) {
      k = random(1000);
      pDebug(player, sprintf("ausweichen :: reroll chance=%d roll=%d\n", r/2, k));
      if(k <= r/2) {
        tell_object(player, BS("Deine geschaerften Sinne geben dir eine Vorahnung was dein Gegner tun wird!"));
        avoided=1; // wir haben es geschafft
      }
    }
  }

  if(avoided) {
    sinfo[SI_SKILLDAMAGE]=0;
    messages=normal;
    if(IsInForest(player)) messages+=forest;
    if( ENV(player) && (ENV(player)->QueryProp(P_INDOORS)) ) messages+=indoor;
    if(QueryEnv(player)==TT_WATER) messages=feen;
    if(player->QueryProp(P_FROG)) messages=froesche;
    tell_object(player, BS(messages[random(sizeof(messages))]));
  }
  

  return sinfo;
}

//-- Kraeutersuche -----------------------------------------------------------
mapping Kraeuterkunde(object player, string skill, mapping sinfo)
{ 
  int ability, usage, fail, i;
   
  //Vorbedingungen
  //Nur im echten FOREST -> Query; Froesche und Blinde sammeln keine Kraeuter
  if(!player) return sinfo;
  if(ENV(TP)->Query(P_ENVIRONMENT)[ENV_TERRAIN] != TT_FOREST)
  { tell_object(TP,BS("Das geht nur im Wald.")); return sinfo;}
  if(HERBS_MASTER->QueryRoom(sinfo[SI_ENVIRONMENT]))
  { tell_object(TP,BS("Hier wurden schon vor kurzer Zeit Kraeuter gesucht."));
    return sinfo;}
  if(player->QueryProp(P_FROG) || player->QueryProp(P_BLIND)) 
  { tell_object(TP,BS("Das geht Doch so nicht!")); return sinfo; }
  if(player->InFight())
  { tell_object(TP,BS("Das geht nicht im Kampf.")); return sinfo; }

  pDebug(player, sprintf("Kraeutersuche :: p=%O skill=%s sinfo=%O\n", player, skill, sinfo));
  
  //Die Anwendung
  sinfo[SI_USR]++;
  usage=sinfo[SI_USR];
  ability=sinfo[SI_SKILLABILITY];
  i=ability+1000*R_SKILLMASTER->HasSkill(getuid(player), KRAEUTERKUNDE);
  if(i>10000) {i=10000;}
  fail=1;
  if(!random(10-(i/1000)))
  {
    fail=0;
  }
  player->SetProp(P_PARALYZED, ([PARALYZE_TIME: 20, 
							PARALYZE_MSG: "Du bist zu beschaeftigt!\n", 
							PARALYZE_MSG_OTHER: "%s sucht in Ruhe Kraeuter.\n", 
							PARALYZE_END: "\n",
							PARALYZE_END_OTHER: "%s beendet seine Kraeutersuche.\n"]));
  tell_object(player, BS("Du suchst nach Kraeutern und Heilpflanzen."));
  tell_room(ENV(player), 
              BS(player->Name(WER, 1)+" sucht nach Kraeutern und "
                 "Heilpflanzen."), ({player}) );
  call_out("sammelSeq",3,2+random(3),player, fail);
  
  //Das lernen, nur aller ability/200
  if( (ability < MAX_ABILITY) &&  (usage > ability/200)  || fail && !random(5))
  {
    usage=0;
    ability+=1+random(player->QuerProp(P_GUILD_LEVEL)+player->QueryAttribute(A_INT)) + random(10);
    if (ability >= MAX_ABILITY)
    { 
      HERBS_MASTER->DistributeHerbs(1, 0, MAX_ABILITY, 
                                    player,"sturmdrachenfeuer");
      tell_object(player, BS("Du findest ein Sturmdrachenfeuer. Du hast jetzt"
                             " die hoechste Fertigkeitsstufe der "
                             "Kraeuterkundigen erreicht."));
    } else {
      tell_object(player, "Du verstehst die lokale Pflanzenwelt nun besser.\nDu berrschst die Kraeuterkunde nun besser.\n");

    }
    if(ability>MAX_ABILITY) { ability=MAX_ABILITY;}
    player->ModifySkill( SK_RANGER_HERBALISM, ([ SI_USR: usage, SI_SKILLABILITY: ability ]), sinfo[SI_DIFFICULTY],"waldlaeufer");   }
  return sinfo;
}

//-- Der Sequenzaufruf fuer Kraeuterkunde ------------------------------------
int sammelSeq(int counter, object player, int fail)
{
  string *messages;
  int i;
  
  if(counter<1)
  {
    player->SetProp(P_PARALYZED, 0);
    if(fail) {
      tell_object(player,BS("Leider war Deine Kraeutersuche erfolglos."));
    } else {
      tell_object(player,BS("Du hast einige Kraeuter gefunden."));
      
      i = player->QuerySkillAbility(SK_RANGER_HERBALISM)+1000*R_SKILLMASTER->HasSkill(getuid(player), KRAEUTERKUNDE);
      HERBS_MASTER->DistributeHerbs(1+(i/2000),random(i/2500),i,player);
      HERBS_MASTER->AddRoom(ENV(player));
    }
    return 1;
  }

  counter--;
  messages=({
    "Geduldig suchst Du Deine Umgebung ab.",
    "Du pflueckst ein paar Pflanzen und schaust, ob Du sie gebrauchen kannst.",
    "Du entdeckst hier und dort ein Blatt.",
    "Vorsichtig gehst Du mit der Sichel zu Werk.",
    "Du gehst langsam voran und spaehst nach nuetzlichen Kraeutern.",
    "Mit geuebtem Blick findest Du einige seltene Pflanzen.",
    "Du untersuchst die Pflanzen sorgfaeltig, um sicherzugehen, dass sie essbar sind.",
    "Du ziehst behutsam eine Wurzel aus der Erde.",
    "Im Schatten eines Baumes entdeckst Du ein besonderes Kraut.",
    "Du ueberpruefst Deine Funde und sortierst die brauchbaren Pflanzen aus.",
    "Mit einem Laecheln auf den Lippen findest Du ein huebsches Kraut.",
    "Du machst eine kurze Pause und geniesst den Duft der Natur.",
    "Zwischen ein paar Steinen entdeckst du weichs Moos.",
    "Du beugst Dich nieder und sammelst behutsam ein paar Blaetter ein.",
    "Deine Haende sind voller Erde, nachdem du ein paar Pflanzen ausgraebst.",
    "Du suchst eine Stelle, wo du denkst, dass die besten Kraeuter wachsen.",
    "Du findest eine kleine Ansammlung von aromatischen Pflanzen.",
    "Mit geschickten Bewegungen sammelst Du die Kraeuter ein, ohne sie zu beschaedigen.",
    "Du bemerkst eine Veraenderung im Duft der Luft und untersuchst das Gewaechs, von dem er kommt."});
  tell_object(player,BS(messages[random(sizeof(messages))]));
  call_out("sammelSeq",4,counter,player,fail);
  return 1;
}
/****************************************************************************/

varargs mixed check_advance(object pl) {
  int ggrad, glvl;
  mapping cond;
  mixed res;
  glvl=pl->QueryProp(P_GUILD_LEVEL);
  if(glvl > 19) return "Du bist schon im ein Meister des fuenften Grades!";
  cond=QueryProp(P_GUILD_LEVELS);
  res=call_other(RES_CHECKER, "check_new_restrictions", pl, cond[glvl+1]);
  return res;
}

public void init() {
  ::init();
  if(TP->QueryProp(P_GUILD) != "waldlaeufer") return;

  // falls wer das item verloren hat
  call_out("give_task_item", 0, TP->QueryProp(P_GUILD_LEVEL), TP);
  call_out("check_koecher", 0, TP);
  if(TP->QuerySkill("doppelschuss")) {
    call_out("replace_doppelschuss", 0, TP);
  }
}

public void replace_doppelschuss(object pl) {
  int ability;

  if(!pl->QuerySkill("doppelschuss")) return;

  // remove skill "doppelschuss" from player and add skill "panzerbrechender schuss" on same skill level
  ability = pl->QuerySkillAbility(DOPPELSCHUSS);
  pl->SetProp(P_NEWSKILLS, m_delete(pl->QueryProp(P_NEWSKILLS), DOPPELSCHUSS));
  LearnSpell(PANZERBRECHENDER_SCHUSS, TP);
  TP->ModifySkill(PANZERBRECHENDER_SCHUSS, ([SI_SKILLABILITY: ability]));

  tell_object(pl, " *** Du hast den Doppelschuss durch den Panzerbrechenden Schuss ersetzt. ***\n");
}

public void check_koecher(object pl) {
  object razi, koecher;

  if(!objectp(razi=present(GUILD_NPC_ID))) return;

  if(!objectp(koecher=present(GUILD_OBJ_ID, pl))) {
    razi->command_me("sag "+pl->Name(WER)+", du hast deinen Koecher verloren. Frag mich nach einem Neuen!");
    return;
  }

  if(koecher->Version() != KOECHER_VERSION) {
    razi->command_me("sag "+pl->Name(WER)+", dein Koecher ist veraltet. Frag mich nach einem Neuen!");
    return;
  }

  return;
}

public int GuildRating(object pl) {
  return RANGERMASTER->GuildRating(getuid(pl));
}