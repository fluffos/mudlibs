#include "../zech.h"

inherit "std/thing";

#include <properties.h>
#define TO this_object()
#define MEENV environment(TO)

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "Rausch");
  SetProp(P_GENDER, MALE);
  AddId("\nzechpreller_destilliere_bonus");

  SetProp(P_MATERIAL, MAT_ALCOHOL );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
}

void SetValues(object caster, int hp)
{
  if(objectp(caster))
    tell_object(caster, BS("Du entwickelst regenerative Kraefte!"));
  call_out("regeneration", 0, caster, hp);
}

void regeneration(object caster, int hp)
{
  if(!objectp(caster) || caster->QueryProp(P_GHOST) || hp<0)
  {
    if(objectp(caster))
      tell_object(caster, BS("Deine regenerativen Kraefte schwinden!"));
    remove(1);
    return;
  }

  caster->AddHp(random(4));
  caster->AddSp(random(4));
  call_out("regeneration", 1, caster, --hp);
}
