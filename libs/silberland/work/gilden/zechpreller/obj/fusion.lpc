inherit "std/armour";

#include "/gilden/zechpreller/zech.h"
#include <armour.h>
#include <properties.h>
#include <combat.h>

object owner;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0); 
  SetProp(P_NAME, 0);
  AddId( ({"\nzechpreller_fusion"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0 );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, "");
  SetProp(P_INVIS, 1);
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  int val;
  val=0;
  if( stringp(dam_type) )
    dam_type = ({dam_type});
  if( member(dam_type, DT_FIRE) != -1 )
    val-=15 + random(85);  
  if( member(dam_type, DT_WATER) != -1 )
    val+=10 + random(50);  
  if( member(dam_type, DT_ACID) != -1 )
    val+=10 + random(100);  
  if( member(dam_type, DT_POISON) != -1 )
    val+=10 + random(100);  
  if( member(dam_type, DT_AIR) != -1 )
    val+=10 + random(50);
  return val;
}

void init()
{
  ::init();
  if(objectp(owner))
    owner->Set(P_RACE,  symbol_function("race", this_object()), F_QUERY_METHOD);
}

void SetVars(object pl, int time)
{
  owner = pl;
  DoWear(1);
  owner->Set(P_PRESAY,  symbol_function("presay", this_object()), F_QUERY_METHOD);
  owner->Set(P_TITLE,  symbol_function("title", this_object()), F_QUERY_METHOD);
  call_out("ende", time);
  call_out("persistance_race", random(10));
}

void persistance_race()
{
   if(!random(3))
   {
     tell_object(owner, BS("Alkoholdunst steigt von Dir auf."));
     tell_room(ENV(owner), BS("Alkoholdunst steigt von "+owner->Name(WEM)+" auf."), ({owner}));
   }
   owner->Set(P_RACE,  symbol_function("race", this_object()), F_QUERY_METHOD);
   call_out("persistance_race", random(10));
}

void ende()
{
  tell_object(MENV, "Die Kraft des Weingeists verlaesst Dich.\n");
  owner->Set(P_RACE,  0, F_QUERY_METHOD);
  owner->Set(P_TITLE,  0, F_QUERY_METHOD);
  owner->Set(P_PRESAY,  0, F_QUERY_METHOD);
  DoUnwear(1);
  remove();
}

string race()
{
  if (previous_object(1) && (file_name(previous_object(1)) == "/obj/werliste" ||
        file_name(previous_object(1)) == "/p/daemon/fingerd"))
  return "Weingeist";
}

string presay()
{
  return "Ein Weingeist namens ";
}

string title()
{
  return "";
}

string extra_look()
{
  return owner->Name(WER)+" scheint aus fluessigem Alkohol zu bestehen.\n";
}
