#include "../zech.h"
#include "../talents.h"
#include <properties.h>
#include <combat.h>
#include <new_skills.h>

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Dunstpanzer");
  SetProp(P_LONG,  "Reiner Alkoholdunst..."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Dunstpanzer");
  SetProp(P_GENDER, MALE);
  AddId(({"\nzechpreller_panzer", "panzer", "dunstpanzer"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_ALCOHOL:50, MAT_AIR:50]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_CURSED, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_DEFEND_FUNC, TO);

  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_WATER:1, DT_ACID:1,
			    DT_POISON:1, DT_AIR:1, DT_MAGIC:1]) );
}

void SetVars(int dauer, int body)
{
  SetProp(P_AC, body);
  call_out("end", dauer); 
  call_out("bonus", 1);
}

#define TG(x) tell_object(find_player("gwenshara"), BS(x))

void bonus()
{
  int hp, sp;

//  TG("Teste auf ENV und interactive");
  if(!objectp(ENV(TO)) ||
     !interactive(ENV(TO))) return;

//  TG("Teste auf Erbe");
  if(ERBMASTER->QueryErbe(ENV(TO)) != ERBE_ZECHUS) return;

  hp = 5+random(6);
  sp = 5+random(6);
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:hp, P_SP:sp]));
  SetProp(P_M_HEALTH_MOD, ([P_HP:hp, P_SP:sp]));

  tell_object(ENV(TO), BS("Der Dunstpanzer staerkt Dich!"));
  ENV(TO)->UpdateAttributes();

  return;
}

void end()
{
  write(BS("Der Panzer aus Alkoholdunst loest sich auf."));
  SetProp(P_CURSED, 0);
  remove(1);
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int x;
  if((x=ZTMASTER->GetTalent(ENV(TO), ZT_YEAST_SMELL)) && !random(5)) {
    tell_room(ENV(enemy), BS(enemy->Name(WER)+" wird durch den Hefedunst ganz benebelt..."));
    enemy->ModifySkillAttribute(ENV(TO), SA_SPEED, 50, x*2);
  }

  if(ERBMASTER->QueryErbe(ENV(TO)) != ERBE_ZECHUS) return 0;
  return 5+random(10);
}
