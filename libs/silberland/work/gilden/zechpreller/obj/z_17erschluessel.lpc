               tell_object(spieler[i], sprintf("Dein Saufkumpane %s "
                  +"winkt Dir aus der Ferne zu.\n", TP->name()));
             else
               tell_object(spieler[i], sprintf("Deine Saufkumpanin %s "
                  +"winkt Dir aus der Ferne zu.\n", TP->name()));
           }
       }
   }
 return 1;
}


int zwer(string str)
{
 int i, zeile;
 object *spieler;
 string schlucker, element, lauscher;
 schlucker="";
 lauscher="";
 spieler=users();

 write("Folgende Schluckspechte sind anwesend:\n");

 if(str == "ort") /* Abfangen ob die anfrage 'ort' enthaelt */
 {
    for(i=sizeof(spieler)-1; i>=0; i--)
    {
      if( (spieler[i]->QueryProp(P_GUILD))=="zechpreller" &&
           !spieler[i]->QueryProp(P_INVIS) )
      {
         element=spieler[i]->name();
         if(IS_WIZARD(spieler[i]))
         {
           schlucker+=AddBlanks(15-strlen(element+4));
           schlucker+=element+" (M)";
           if(IS_WIZARD(TP))
             schlucker+="   -  "+environment(spieler[i])->QueryProp(P_INT_SHORT)+"\n";
           else
             schlucker+="   -  Im Vollrausch\n";
         }
         else if(spieler[i]->QueryProp(P_TESTPLAYER) != 0)
         {
           schlucker+=AddBlanks(15-strlen(element+4));
           schlucker+=element+" (T)";
           if(IS_WIZARD(TP))
             schlucker+="   -  "+environment(spieler[i])->QueryProp(P_INT_SHORT)+"\n";
           else
             schlucker+="   -  Im Vollrausch\n";
         }
         else
         {
           schlucker+=AddBlanks(15-strlen(element+4));
           schlucker+=element+" ("+spieler[i]->QueryProp(P_GUILD_LEVEL)+")";
           schlucker+="   -  "+environment(spieler[i])->QueryProp(P_INT_SHORT)+"\n";
         }
      }
    }
    write(schlucker);
    return 1;
 }

 for(i=sizeof(spieler)-1;i>=0; i--){
   if ((spieler[i]->QueryProp(P_GUILD))=="zechpreller" && !spieler[i]->QueryProp(P_INVIS)){
     schlucker+=spieler[i]->name()+"(";
     if(IS_WIZARD(spieler[i]))
       schlucker+="M";
     else if(spieler[i]->QueryProp(P_TESTPLAYER))
       schlucker+="T";
     else
       schlucker+=spieler[i]->QueryProp(P_GUILD_LEVEL)+"/"+GetAlcString(spieler[i]);
     schlucker+="), ";
   }
 }

 lauscher += "Nuechterne Zuhoerer:\n";
 for(i=sizeof(spieler)-1; i>=0; i--)
 {
  if(spieler[i]->QueryProp(P_TMP_ZECHPRELLER_LISTENER) &&
   !(spieler[i]->QueryProp(P_GUILD) == "zechpreller") &&
   !spieler[i]->QueryProp(P_INVIS))
     lauscher += spieler[i]->name()+", ";
 }
    
 write(BS(schlucker+"\b\b")+"\n");
 write(BS(lauscher));
 return 1;
}


void init()
{
  object ob;
  ::init();
  if(!living(MENV))
    call_out("remove",0);
  if(MENV->QueryProp(P_GUILD)!= "zechpreller" && !IS_WIZARD(MENV)) {
    write(BS("Der Siebzehnerschluessel loest sich in einem "
          +"Alkoholwoelkchen auf!\n"));
    call_out("remove",0);
    return 0;
  }
  if(TP!=MENV) return 0;
  DoWear();
  tell_object(MENV, BS("Du fuehlst deine Enthaltsamkeit schwinden und ein "
        +"Dunst von Allohol steigt Dir in die Nase.\n"));
  MENV->SetProp(P_WEAR_FUNC, TO);
  MENV->SetProp(P_WIELD_FUNC, TO);
  MENV->SetProp(P_REMOVE_FUNC, TO);
}

reset()
{
  ::reset();
  if(boosts > 0)
    boosts--;
}

