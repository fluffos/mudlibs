{
 write("\nzreport Kommandos   :\n"
      +"zreport hilfe         : Dieses hier\n"
      +"zreport ein           : Schaltet den Report ein\n"
      +"zreport aus           : Schaltet den Report aus\n"
      +"zreport max <0|1>     : Schaltet Anzeige der maximalen Punkte ein\n"
      +"zreport farben <0|1>  : Farben aus|ein\n"
      +"zreport minimal <0|1> : Der Report wird im Minimalmodus dargestellt\n"
      +"\nDie Statuszeile im erweiterten Modus hat folgende Beteutungen:\n"
      +" -[DRTuX]---------[ETBVFGPN]---(Alkoholstatus)--------------LPs:...\n"
      +"   ABCDE           12345678\n"
      +"\n"
      +"Im Minimal-Modus sieht eine Statuszeile so aus:\n"
      +"123/123 +1 LP 321/321 -1 MP Alkoholstatus DRTuX ETBVFGPN\n"
      +"                                          ABCDE 12345678\n\n"
      +"1 ... Ziemlich erschoepft\n"
      +"2 ... Taub\n"
      +"3 ... Blind\n"
      +"4 ... Vergiftung\n"
      +"5 ... Frosch\n"
      +"6 ... Geist\n"
      +"7 ... Paralysiert\n"
      +"8 ... NoSpell\n"
      +"A ... Dunstpanzer\n"
      +"B ... Rumkugeln\n"
      +"C ... Torkeln\n"
      +"D ... TrUnkspruch\n"
      +"E ... Zauber der Gildenstufe 11\n\n");
 return 1;
}

varargs void NotifyHpChange(int force)
{
  int hp, mhp, sp, msp, HPdif, x;
  string color, stats, spells;
  stats="";
  spells="";
  x=0;
  if (!previous_object()) return;
  if (owner != previous_object()) {
    if (TO != previous_object()) return;
    x=1;
  }
  if (!aktiv && !x) {
    if (owner!=find_netdead(getuid(owner)))
      owner->RemoveHpHook(ME);   // geht nur bei nicht-netztoten Spielern
    return;
  }

  if((x=ZTMASTER->GetTalent(owner, ZT_EMERGENCY_BARREL)) && 
      owner->QueryProp(P_ZECHPRELLER_LAST_EMERGENCY_BARREL)+300 < time() && 
      owner->QueryProp(P_ALCOHOL) == 0)
  {
    tell_object(owner, BS("Du nimmst einen schnelleren Schluck aus Deinem Notfallfass!\n"));
    owner->drink_alcohol(x * 10);
    owner->SetProp(P_ZECHPRELLER_LAST_EMERGENCY_BARREL, time());
  }

  //Abfrage der Stats (vergiftet, taub etc.)
  if(!test_bit(akt_lvl, 3))
  {
    stats+="[";
    if(owner->QueryProp(P_MV)*100/owner->QueryProp(P_MAX_MV)<10)
      stats+="E";
    else stats+="-";
    if(owner->QueryProp(P_DEAF))
      stats+="T";
    else stats+="-";
    if(owner->QueryProp(P_BLIND))
      stats+="B";
    else stats+="-";
    if(owner->QueryProp(P_POISON))
      stats+="V";
    else stats+="-";
    if(owner->QueryProp(P_FROG))
      stats+="F";
    else stats+="-";
    if(owner->QueryProp(P_GHOST))
      stats+="G";
    else stats+="-";
    if(owner->QueryProp(P_PARALYZED))
      stats+="P";
    else stats+="-";
    if(time()<owner->QueryProp(P_NEXT_SPELL_TIME))
      stats+="N";
    else stats+="-";
    stats+="]";
  }
  else
  {
    if(owner->QueryProp(P_MV)*100/owner->QueryProp(P_MAX_MV)<10)
      stats+="E";
    if(owner->QueryProp(P_DEAF))
      stats+="T";
    if(owner->QueryProp(P_BLIND))
      stats+="B";
    if(owner->QueryProp(P_POISON))
      stats+="V";
    if(owner->QueryProp(P_FROG))
      stats+="F";
    if(owner->QueryProp(P_GHOST))
      stats+="G";
    if(owner->QueryProp(P_PARALYZED))
      stats+="P";
    if(time()<owner->QueryProp(P_NEXT_SPELL_TIME))
      stats+="N";
  }

  //Auf aktive Zauber testen
  if(!test_bit(akt_lvl, 3))
  {
    spells+="[";
    if(present("\nzechpreller_panzer", owner)) spells+="D";
    else spells+="-";
    if(present("\nzechpreller_rumkugeln", owner)) spells+="R";
    else spells+="-";
    if(present("\nzechpreller_torkeln", owner)) spells+="T";
    else spells+="-";
    spells+=sprintf("%d", owner->QueryProp(P_ZECHPRELLER_DRINKS));
    if(present("\nzechpreller_special", owner)) spells+="X";
    else spells+="-";
    spells+="]";
  }
  else
  {
    if(present("\nzechpreller_panzer", owner)) spells+="D";
    if(present("\nzechpreller_rumkugeln", owner)) spells+="R";
    if(present("\nzechpreller_torkeln", owner)) spells+="T";
    spells+=sprintf("%d", owner->QueryProp(P_ZECHPRELLER_DRINKS));
    if(present("\nzechpreller_special", owner)) spells+="X";
  }
  
  // aktuelle Werte ermitteln
  hp = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);
  if(test_bit(akt_lvl, 1)) {
    switch(hp*100/mhp) {
      case 0..20: color=report_colors[4];
                  break;
      case 21..40: color=report_colors[3];
                  break;
      case 41..60: color=report_colors[2];
                  break;
      case 61..80: color=report_colors[1];
                  break;
      case 81..100: color=report_colors[0];
                  break;
      default: color=ANSI_NORMAL;
    }
  }
  else
    color="";
  // Vergleich und Ausgabe
  if(hp!=lastHP) 
    changedHP+=hp-lastHP;
  changedSP+=sp-lastSP;
  if ((hp < lastHP) || (hp != lastHP && sp == msp) || (sp != lastSP) ||
      force) {
    if(test_bit(akt_lvl, 2))
    {
      if(test_bit(akt_lvl, 3))
      {
        tell_object(owner, 
	            sprintf("%s%d/%d %s LP %d/%d %s MP %s %s %s%s\n",
			    color, hp, mhp, (changedHP>0?"+":"")+changedHP,
			    sp, msp, (changedSP>0?"+":"")+changedSP, GetAlcString(owner),
			    spells, stats, ANSI_NORMAL));
      }
      else
      {
        tell_object(owner,sprintf("%s-"+spells+"-----"+stats+"----"+
                          sprintf("%18-'-'s", GetAlcString(owner))+"----- "
                          "LPs: %d/%d(%s), MPs: %d/%d(%s)%s",
                          color, hp, mhp, (changedHP>0?"+":"")+ changedHP, sp, msp,
                           (changedSP>0?"+":"")+changedSP, ANSI_NORMAL+"\n"));
      }
    }
    else
    {
      if(test_bit(akt_lvl, 3))
      {
	tell_object(owner, 
	            sprintf("%s%d %s LP %d %s MP %s %s %s%s\n",
			    color, hp, (changedHP>0?"+":"")+changedHP,
			    sp, (changedSP>0?"+":"")+changedSP, GetAlcString(owner),
			    spells, stats, ANSI_NORMAL));
      }
      else
      {
        tell_object(owner, color+
          "-"+spells+"------"+sprintf("%18-'-'s", GetAlcString(owner))+"---"+stats+"---- LPs: "+
          hp+" ("+(changedHP>0?"+":"")+changedHP+"), MPs: "+
          sp+" ("+(changedSP>0?"+":"")+(changedSP)+")"+
          ANSI_NORMAL+"\n");
      }
    }
  //  tell_object(owner, ANSI_NORMAL+"Normalfarbe\n");
    changedSP=0;
    changedHP=0;
  }
  lastHP = hp; lastSP = sp;
 // tell_object(owner, ANSI_NORMAL+"Normalfarbe\n");
}

void activate(object ob)
{
  if (objectp(ob)) {
    aktiv = 1;
    owner = ob;
    owner_name = getuid(owner);
    ob->AddHpHook(ME);
    lastHP = ob->QueryProp(P_HP);
    lastSP = ob->QueryProp(P_SP);
  } else {
    if (ob=(owner||TP)) ob->RemoveHpHook(ME);
    owner = owner_name = aktiv = 0;
  }
}

nosave int ConfigureReport(string str, int what) {
 int flag;
 string txt;
 flag=to_int(str);
 if(flag<0 || flag>3) {
   write("Falsche Eingabe!\n");
   return 1;
 }
 if(what==1) txt="Farben";
 else if(what==2) txt="Max";
 else if(what==3) txt="Minimal";
 else txt="Level";
 if(flag==0) 
   akt_lvl=clear_bit(akt_lvl, what);
 else if(flag==1) {
   akt_lvl=set_bit(akt_lvl, what);
 }
 else if(flag==3){
   akt_lvl=set_bit(akt_lvl, what);
 }
 write("Ok, "+txt+" auf "+flag+" gesetzt!\n");
 return 1;
}

nosave int Report(string str)
{
  string *msg;
  notify_fail("Syntax: zreport ein|aus|max <0|1>|farben <0|1>|minimal <0|1>\n");
  if(!sizeof(msg=explode(str, " "))) return 0;
  switch (msg[0])
  {
    case "ein":
      if (aktiv && objectp(owner))
        write("Der Report-Modus ist schon eingeschaltet!\n");
      else {
        write("Report-Modus ist jetzt eingeschaltet.\n");
        activate(TP);
      }
      break;
    case "aus":
      if (!aktiv)
        write("Der Report-Modus ist doch schon ausgeschaltet!\n");
      else { 
        write("Report-Modus ist nun ausgeschaltet.\n");
        activate(0);
      }
      break;
    case "farben":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 1);
      else 
        write("Syntax: zreport farben <0|1>\n"); 
      break;
    case "max":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 2);
      else 
        write("Syntax: zreport max <0|1>\n"); 
      break;
    case "hilfe":
      ShowReportHelp();
      break;
    case "minimal":
      if(sizeof(msg)<2)
        write("Syntax: zreport minimal <0|1>\n");
      else
        ConfigureReport(msg[1], 3);
      break;
    default:
      return 0;
  }
  return 1;
}


nosave int SetColors(string cols) {
  string *colors, *set_cols;
  mapping valid_colors;
  int i;
  set_cols=({});
  valid_colors=(["schwarz":ANSI_BLACK,
                 "rot":ANSI_RED,
                 "gruen":ANSI_GREEN,
                 "gelb":ANSI_YELLOW,
                 "blau":ANSI_BLUE,
                 "lila":ANSI_PURPLE,
                 "zyan":ANSI_CYAN,
                 "weiss":ANSI_WHITE,
                 "normal":ANSI_NORMAL]);
  if(!cols) cols="standard";
  cols=lower_case(cols);
  if(cols=="standard") {
    report_colors=std_colors;
    write(BS("Ok, Standard Farben (Gruen, Gelb, Cyan, Blau, Rot) "
          "gesetzt!\n"));
    call_other(ZECHMASTER, "SetColors", TP, set_cols);
    return 1; 
  }
  if(cols=="hilfe") {
    return ShowColorHelp(); 
  }
  colors=explode(cols, " ");
  if(sizeof(colors)!=5) {
    write("Es muessen fuenf Farben angegeben werden!\n");
    return 0;
  }
  for(i=0;i<=sizeof(colors)-1;i++) {
    if(!member(valid_colors, colors[i])) {
      write(sprintf("Falsche Farbe: %s!\n", colors[i]));
      return 0;
    }
    set_cols+=({valid_colors[colors[i]]});
  }
  report_colors=set_cols;
  write("Ok, Farben gesetzt!\n");
  call_other(ZECHMASTER, "SetColors", TP, set_cols);
  return 1;
}

string GetAlcString(object zechi)
{
  int prozent;
  string alc_string;
  if(!objectp(zechi)) return "nuechtern";
  
  prozent=(zechi->QueryProp(P_ALCOHOL) || 1)*100/(zechi->QueryProp(P_MAX_ALCOHOL) || 1);

  switch(prozent){
    case 0 .. 10 : alc_string="nuechtern";
                  break;
    case 11 .. 20: alc_string="leicht angeheitert";
                   break;
    case 21 .. 30: alc_string="feucht froehlich";
                   break;
    case 31 .. 50: alc_string="etwas angetrunken";
                   break;
    case 51 .. 60: alc_string="angetrunken";
                   break;
    case 61 .. 70: alc_string="etwas blau";
                   break;
    case 71 .. 80: alc_string="blau";
                   break;
    case 81 .. 99: alc_string="extrem blau";
                   break;
    default      : alc_string="zechprellerblau";
                      break;
  }

  return alc_string;
}

void BecomesNetAlive(object wer)
{
  if(wer==MENV) {
      tell_object(wer,break_string(sprintf(
        "Proooooscht, %s!",wer->Name(WER,2)),78,
        "Zechus ruft Dir zu: "));
    }
}

int IsZechpreller(object wer){
  if(wer->QueryProp(P_GUILD) != "zechpreller" && !IS_WIZARD(MENV))
    return 0;
  else
    return 1;
}

string AddBlanks(int anz)
{
  int i;
  string str;
  str="";
  for(i=anz; i>0; i--)
  {
    str+=" ";
  }
  return str;
}

