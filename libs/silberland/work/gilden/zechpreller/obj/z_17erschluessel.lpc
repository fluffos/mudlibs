object *CreateRecieverArray(int flag)
// Erstellt je nach Eingabe ('raum' oder 'alle') die Liste mit den Zielen
{
  object *player,*pl_hilf,ob;
  string *ignores;
  int i,pos;

  if (flag==1) // flag=1 -> raum
    { player=filter_array(all_inventory(ENV(TP)),
                         lambda(({'item}),({#'interactive,'item})));
      pos=member_array(TP,player);
      if (pos!=-1) player=player-({TP});
      return player;
    }
  pl_hilf=({});
  ignores=({});
  player=({});


  if (flag==0) //flag=0 -> alle zechpreller
  {
    player=users();
    for(i=sizeof(player)-1;i--;i>=0)
    {
      if( player[i]->QueryProp(P_GUILD)=="zechpreller" )
        pl_hilf+=({player[i]});
    }
    player=({});
  }
  if (flag==2) // flag=2 -> freunde
    {
      if(!objectp(present("freundschaftsband", TP))) return ({}); 
      ignores=present("freundschaftsband", TP)->QueryProp(P_AUTOLOADOBJ)[1];
      if (sizeof(ignores)<1) return ({});
      for (i=sizeof(ignores)-1;i>=0;i--)
       {
         ob=find_player(ignores[i]);
         if (objectp(ob)&&
             member(ob->QueryProp(P_IGNORE), "zproste")<0 &&
             member(ob->QueryProp(P_IGNORE), "zprosten")<0)
             pl_hilf=pl_hilf+({ob});
       }
       return pl_hilf;
     }

  for(i=sizeof(pl_hilf)-1;i>=0; i--) {
   if(pl_hilf[i]!=TP) {
     ignores=pl_hilf[i]->QueryProp(P_IGNORE);
     if ((!sizeof(ignores))
         || (member(ignores, "zprost")==-1)
         && (member(ignores, "zproste")==-1)
        )
        player=player+({pl_hilf[i]});
     }
     }
  return player;
}


int zprosten(string str)
{ // --- Variablen ---
  object *spieler,ob;
  string nr_one,*presay,ausgabe;
  int index;

  // --- Fehlerueberpruefungen ---
  notify_fail(BS("Syntax: zproste [alle|raum|freunde|<Spielername>]"));
  if (!str) return 0;
  notify_fail(BS(
    "So nuechtern wie Du bischt kannscht net proschten.\n"));
  if (((100*TP->QueryProp(P_ALCOHOL)/TP->QueryProp(P_MAX_ALCOHOL))<20) &&
     (!IS_WIZARD(TP)))
   return 0;
  notify_fail("Upsch, der isch ja gar net eingeloggt.\n");

  // --- Beginn ---
  switch(lower_case(str))
  {
   case "alle" : {spieler=CreateRecieverArray(0);
                  write("Du proschtest allen anwesenden Saufkumpanen zu.\n");
                  break;}
   case "raum" : {spieler=CreateRecieverArray(1);
                  if (sizeof(spieler)==0)
                  { write(BS("Hmm, niemand hier dem Du zuproschten koenntest."
                             " Schaade."));return 1;}
                  write("Du proschtest allen im Raum, egal ob Saufkumpane "
                        "oder nicht, zu.\n");break;}
   case "freunde": spieler=CreateRecieverArray(2);
                   if (sizeof(spieler)==0)
                   { write(BS("Zu dumm, dass keine Freunde von Dir eingeloggt"
                              " sind."));return 1;}
                   write("Du proschtest all' Deinen Freunden tschu.\n");
                   break;
  default     : if (ob=find_player(str)) {
                  spieler=({ob});
                  write("Du proschtest "+ob->name()+" zu.\n");
                 }
                 else return 0;
  }

 if (sizeof(spieler)==0)
  { write(BS("Hmm, niemand hier dem Du zuproschten koenntest. Schaaade."));
    return 1;
  }
 nr_one=call_other(ZECHMASTER, "QueryNumberOne");
 if(getuid(TP)=="angrox" || getuid(TP)=="stahldorn" || getuid(TP)=="feyaria" || getuid(TP) == "gwenshara")
   presay=({"Braumeister ", "Braumeisterin "});
 else
  if (getuid(TP)=="impulz") presay=({"Hilfs-Papa ","Hilfs-Mama "});
   else
   if(stringp(nr_one) && member(nr_one, getuid(TP))!=-1)
     presay=({"Obersaeufer ", "Obersaeuferin "});
   else
     presay=({"Schluckspecht ", "Schluckspechtin "});
 if (lower_case(str)=="freunde")
   presay=({ "Dein Freund und "+presay[0],
             "Deine Freundin und "+presay[1] });

  // --- Ausgabe ---
  for (index=0;index<sizeof(spieler);index++)
  {
   ausgabe=presay[TP->QueryProp(P_GENDER)-1]+TP->name();
   ausgabe+=" proschtet Dir ";
   ausgabe+=((str=="raum")?"und allen anderen im Raum ":"");
   ausgabe+=((ENV(TP)==ENV(spieler[index]))?"":"aus der Ferne ");
   ausgabe+="tschu.";
   tell_object(spieler[index],BS(ausgabe));

  }

  return 1;
}


string _query_info()
{
   string text;
   text="Mit 'zhilfe' kriegscht mehr Infosch.\n";
   if(TP->QueryProp(P_GUILD_LEVEL) > MAX_GUILD_LEVEL-1)
     text+=BS("Ausscherdem kannscht Du mit 'party' das Partymonster rufen!");
   if(TP->QueryProp(P_GUILD_LEVEL) > MAX_GUILD_LEVEL)
     text+=BS("Ausserdem kannst Du andere Zechpreller "
              "mit dem Befehl der alkoholmacht alkoholisieren! ("
              "alkoholmacht <name> oder nur alkoholmacht)");
   return BS(text);
}

int WearFunc(object ob)
{
  if(!IsZechpreller(TP))
    {
    write(BS("Der Siebzehnerschluessel loest sich in ein Alkoholwoelckchen "
        +"auf!\n"));
    call_out("remove",0);
    return 1;
    }
  TP->SetProp(P_TMP_ZECHPRELLER_LISTENER, 1);
  return 1;
}

int WieldFunc(object ob)
{
  if(!IsZechpreller(TP))
  {
    write(BS("Der Siebzehnerschluessel loest sich in einem Alkoholwoelckchen "
        +"auf!\n"));
    call_out("remove",0);
    return 1;
  }
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  if(TP)
    TP->SetProp(P_TMP_ZECHPRELLER_LISTENER, 0);
  return 1;
}

int zrufen(string str)
{
 int i, no_msg, presay_mod, no_colors;
 object *spieler;
 string *presay, *ignores, pre, *nr_one, zruf_name;
 no_msg=0;
 zruf_name=getuid(TP);
 presay_mod=TP->QueryProp(P_GENDER);
 notify_fail(BS("Was moechescht Deinen Kneipenbruedern und -schwestern "
        +"mitteilen?\n"));
 if (!stringp(str)) return 0;
 spieler=users();
 nr_one=call_other(ZECHMASTER, "QueryNumberOne");
 if(zruf_name=="angrox" || zruf_name=="stahldorn" || zruf_name=="feyaria" || zruf_name=="gwenshara")
   presay=({"Braumeister ", "Braumeisterin ", "Ein "});
 else
   if(sizeof(nr_one) &&  member(nr_one, getuid(TP))>-1)
     presay=({"Obersaeufer ", "Obersaeuferin "});
   else
     presay=({"Schluckspecht ", "Schluckspechtin "});

 if(TP->QueryProp(P_INVIS) != 0){ //abfrage auf invis
     zruf_name="Braumeister";
     presay_mod=3;
 }
 for(i=sizeof(spieler)-1;i>=0; i--) {
   ignores=spieler[i]->QueryProp(P_IGNORE);
   if(sizeof(ignores))
     no_colors = (member(ignores, "zlalle.farben") != -1);
   if(spieler[i]==TP) {
     pre = "Du lallst den Zechprellern zu: ";
     if(interactive(TP))
       write(expand_color_strings(TP->_unparsed_args(), pre, spieler[i], no_colors));
   }
   else {
  //   ignores=spieler[i]->QueryProp(P_IGNORE);
     if(sizeof(ignores) && (member(ignores, "zlalle")!=-1 ||
           member(ignores, "zlalle")!=-1))
       no_msg=1;
     else no_msg=0;
     if(((spieler[i]->QueryProp(P_TMP_ZECHPRELLER_LISTENER))==1 && !no_msg ))
     {
       pre=presay[presay_mod-1]+capitalize(zruf_name)+
         " lallt euch zu: ";
//       no_colors = (member(ignores, "zlalle.farben") != -1);
       if(interactive(TP)) {
        tell_object(spieler[i],
            expand_color_strings(TP->_unparsed_args(), pre, spieler[i], no_colors));
      } 
      else {
        tell_object(spieler[i], break_string(str,78, pre));
      }
     }
   }
 }
  call_other(ZECHMASTER, "AddHistory", pre, 
             expand_color_strings(TP->_unparsed_args(), "",""));
 return 1;
}

int zknuddeln(string str)
{
 int i;
 object *spieler;
 spieler=users();
 for(i=sizeof(spieler)-1;i>=0; i--) {
   if ((spieler[i]->QueryProp(P_GUILD))=="zechpreller" ) {
     if(spieler[i]==TP)
       write(BS("Du knuddelst Deine Saufkumpanen/innen aus "
                +"der Ferne."));
     else {
       if(TP->QueryProp(P_GENDER)==MALE)
         tell_object(spieler[i], sprintf("Dein Saufkumpane %s "
                   +"knuddelt Dich aus der Ferne.\n", TP->name()));
       else
         tell_object(spieler[i], sprintf("Deine Saufkumpanin %s "
           +"knuddelt Dich aus der Ferne.\n", TP->name()));
     }
   }
 }
 return 1;
}

int zwinken(string str)
{
 int i;
 object *spieler;

 spieler=users();
