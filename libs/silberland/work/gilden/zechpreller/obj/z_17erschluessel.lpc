nosave object owner;
nosave string owner_name;
nosave int lastHP, lastSP, changedHP, changedSP;
nosave int aktiv=0;
nosave string *report_colors=({});
nosave string *std_colors=({});
nosave string akt_lvl="";
nosave int next_party;
nosave int boosts;

string zechmeister();
int zrufen(string str);
string GetAlcString(object zechi);
int IsZechpreller(object wer);
string AddBlanks(int anz);
void SetPartyTime(int x);
varargs void NotifyHpChange(int force);

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  next_party = 0;
  boosts     = 0;
  std_colors=({ANSI_GREEN, ANSI_YELLOW, ANSI_CYAN, ANSI_BLUE, ANSI_RED});
  report_colors=call_other(ZECHMASTER, "QueryColors", TP);
  if(!pointerp(report_colors) || !sizeof(report_colors))
    report_colors=std_colors;
  SetProp(P_SHORT, "Der Siebzehnerschluessel");
  SetProp(P_LONG,
      "Auf einer Lederschnur ist er: Der universell einsetzbare "
     +"Siebzehnerschluessel, zum Oeffnen jeglicher Gefaesse "
     +"mit alkoholischem Inhalt. Die Benuetzung fuer irgendetwas "
     +"anderes kaeme einem Sakrileg gleich.");
  SetProp(P_NAME, "Siebzehnerschluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({"schluessel", "siebzehnerschluessel", "siebzehner",
      GILDENOBJ}) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:80, MAT_LEATHER:15, MAT_ALCOHOL:5 ]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 800+random(100) );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NO_DAMAGE_DESTRUCT, 1);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MAGIC, 1);
  SetProp(P_CURSED, 0);
//  SetProp(P_INFO, BS(funcall(#'zechmeister))); //')))
  SetProp(P_WORN_TEXT, "um den Hals getragen");

  AddCmd(({"zrufe", "zruf","zlall","zlalle"}), "zrufen");
  AddCmd ("zwer", "zwer");
  AddCmd("zreport", "Report");
  AddCmd(({"zwink", "zwinke"}), "zwinken");
  AddCmd(({"zknuddle", "zknuddel"}), "zknuddeln");
  AddCmd("party", "party");
  AddCmd(({"zhist", "zhistory"}), "zhist");
  AddCmd(({"zprost","zproste"}),"zprosten");
 // AddCmd(({"zbete","zgebet"}),"zgebet");
  AddCmd(({"zfarben"}),              "SetColors");
  AddCmd(({"zhelp","zhilfe"}), "zhilfe");
  AddCmd(({"ztitel"}), "ztitel");
  AddCmd(({"zupd", "zupdate"}), "zupdate");
  AddCmd(({"zstatus", "zstat"}), "zstatus");

  SetProp(P_DEFEND_FUNC, TO);
}

public int DefendFunc(string *dtype, mixed spell, object enemy) {
  int x, pegel,bonus;
  if(!objectp(owner)) return 0;

  bonus=0;
  pegel = call_other("/spellbooks/zech_spells", "AlcPegel", owner);

  if((x=ZTMASTER->GetTalent(owner, ZT_HARD_DRINKER))) {
    bonus+=random((int) ((pegel/4) * (x/3.0)) );
  }

  if((x=ZTMASTER->GetTalent(owner, ZT_BARRELSAINT)) && pegel > 80) {
    bonus += x*10;
  }

  return bonus;
}

int zstatus(string str)
{
  if(!objectp(owner))
  {
    write(BS("Dafuer muss der Report aktiviert sein!"));
    return -1;
  }
  NotifyHpChange(1);
  return 1;
}

int party(string str)
{
  if(TP->QueryProp(P_GUILD_LEVEL) < MAX_GUILD_LEVEL-1) return 0;
  if(TP->QueryProp(P_SP) < 50)
  {
    write(BS("Datschu hascht nicht genug Magie!\n"));
    return -1;
  }

  if(TP->QueryProp(P_ALCOHOL) < 10)
  {
    write(BS("Wengischtensch ein Bisschen Alllohol im Blut solltescht "
          "haben!"));
    return -1;
  }

  if(time()-next_party < 0)
  {
    write(BS("Eine Party am Tag is doch genug..."));
    return -1;
  }

  write(BS("Du groehlst laut: PAAAAAAAAARTY!"));
  tell_room(ENV(TP), BS(TPN+" groehlt laut: PAAAAAAAAARTY!"), ({TP}));
  TP->command_me("zruf Party!!!");
  clone_object(PARTYMONSTER)->move(ENV(TP), M_GO);
  next_party = time()+86400;
  TP->AddSp(-50);

  return 1;
}


int zupdate()
{
  object schluessel;
  if(!objectp(owner))
  {
    write("Dafuer muss der Report aktiviert sein!\n");
    return -1;
  }
  
  schluessel = clone_object(OBJ("z_17erschluessel"));
  tell_object(owner, break_string("Hier hascht einen neuen Siebzehnerschluessel!",
              78, "Zechus teilt Dir mit: "));
  TO->DoUnwear();
  schluessel->move(owner);
  schluessel->DoWear();
  schluessel->SetPartyTime(next_party);
  schluessel->SetBoosts(boosts);
  TO->remove();
  return 1;
}

int ztitel()
{
  mapping gtitles;
  if(!IsZechpreller(TP)){
     write("Aber Du bischt ja gar kein Zechpreller!\n");
     write("Der Siebzehnerschluessel loest sich auf.\n");
     TO->remove();
     return 1;
  }
        
  if(TP->QueryProp(P_GENDER) == MALE)
    gtitles = call_other("/gilden/zechpreller", "QueryProp", P_GUILD_MALE_TITLES);
  else
    gtitles = call_other("/gilden/zechpreller", "QueryProp", P_GUILD_FEMALE_TITLES);

  write("Ok, Dein voller Name lautet nun:\n");
  write(TP->QueryProp(P_PRESAY)+""+TP->Name(WER)+" "+gtitles[TP->QueryProp(P_GUILD_LEVEL)]+"\n");
  TP->SetProp(P_TITLE, gtitles[TP->QueryProp(P_GUILD_LEVEL)]);
  return 1;
}


int zhilfe(string str)
{
  if(!IsZechpreller(TP)){
     write("Aber Du bischt ja gar kein Zechpreller!\n");
     write("Der Siebzehnerschluessel loest sich auf.\n");
     TO->remove();
     return 1;
  }

  if(str == "farben")
  {
  }

  write("Der Schiebzehnerschluessel ermoeglischt Dir folgendesch:\n");
  write("zlalle            Damit lallscht Deinen Saufkumpanen wasch tschu\n");
  write("                   (siehe 'hilfe farben')\n");
  write("zhist              Was ham Dir Deine Saufkumpenen tschugerufen?\n");
  write("zknuddel           Damit knuddelscht Deine Saufkumpanen\n");
  write("zwinke             Damit winkscht Deinen Saufkumpanen tschu\n");
  write("zwer (ort)         Welcher Saeufer ischt gerade da?\n");
  write("zreport <ein|aus>  Schaltet den Report ein/aus\n");
  write("zreport hilfe      Hilfe zum Report\n");
  write("zfarben            Die Farbeinstellungen tschum Report\n");
  write("zproste            Damit proschtest Deinen Saufkumpanen tschu\n");
  write("ztitel             Damit kannscht Deinen Gildentitel setschen\n");
  write("zupdate            So kannscht Dir direkt ein neuesch Gildenitem holen!\n");
  write("                   (Funktioniert nur bei aktivem Report!!!)\n");
  write("zstatus            Zeigt einen Report Deiner Lebens- und Magiepunkte.\n");

  return 1;
}
int zhist()
{
  if(!IsZechpreller(TP))
    {
      write("Aber Du bischt ja gar kein Zechpreller!\n");
      TO->remove();
      return -1;
    }
  call_other(ZECHMASTER, "ShowHistory");
  return 1;
}
int sequenz(int pos,string biername)
{
  switch(pos)
  {
    case 1 : write(BS("Du nimmst einen heiligen Bierkrug und stellst ihn "
                      "vorsichtig vor Dich hin."));
             say(BS(TPN+" nimmt einen heiligen Bierkrug und stellt ihn "
                      "vorsichtig vor sich hin."));break;
    case 2 : write(BS("Du kniest Dich vor dem Bierkrug hin."));
             say(BS(TPN+" kniet sich vor dem Bierkrug hin."));break;
    case 3 : write(BS("Du beginnst zu beten: Bier Unser das Du bist im "
                      "Glase."));
             say(BS(TPN+" beginnt zu beten: Bier Unser das Du bist im "
                      "Glase."));break;
    case 4 : write(BS("Du betest: Gesegnet werde Dein Erfinder."));
             say(BS(TPN+" betet: Gesegnet werde Dein Erfinder."));break;
    case 5 : write(BS("Du nimmst eine Flasche "+biername+" und betest weiter:"
                      " Mein Rausch komme, "));
             say(BS(TPN+" nimmt eine Flasche "+biername+" und betet weiter: "
                        "Mein Rausch komme,"));break;
    case 6 : write(BS("Du murmelst: Dein Wille geschehe,"));
             say(BS(TPN+" murmelt: Dein Wille geschehe,"));break;
    case 7 : write(BS("Du giesst langsam Bier in den Krug und murmelst: "
                      "wie Zuhause,"));
             say(BS(TPN+" giesst langsam Bier in den Krug und murmelt: "
                        "wie Zuhause,"));break;
    case 8 : write(BS("Du murmelst: so auch in der Kneipe,"));
             say(BS(TPN+" murmelt: so auch in der Kneipe,"));break;
    case 9 : write(BS("Du sagst: Und vergib uns unsere Schulden,"));
             say(BS(TPN+" sagt: Und vergib uns unsere Schulden,"));break;
    case 10: write(BS("Du betest: denn auch wir vergeben unseren "
                      "Glaeubigern."));
             say(BS(TPN+" betet: denn auch wir vergeben unseren Glaeubigern."
                 ));break;
    case 11: write(BSA("Und fuehre uns nicht in die Milchbar,",
                       "Du verziehst das Gesicht und betest weiter: "));
             say(BSA("Und fuehre uns nicht in die Milchbar,",
                    TPN+" verzieht sein Gesicht und betet weiter: "));break;
    case 12: write(BS("Du hebst den Krug und sagst: sondern gib uns die "
                      "Kraft zum Weitertrinken."));
             say(BS(TPN+" hebt den Krug und sagt: sondern gib uns die Kraft "
                    "zum Weitertrinken."));break;
    case 13:write(BS("Du murmelst: Denn Dein ist der Durst, der Rausch und"));
             say(BS(TPN+" murmelt: Denn Dein ist der Durst, der Rausch und"));
             break;
    case 14: write(BS("Du betest: die Seligkeit in Ewigkeit."));
             say(BS(TPN+" betet: die Seligkeit in Ewigkeit."));break;
    case 15: write(BS("Du trinkst den Krug auf ex runter ...."));
             say(BS(TPN+" trinkt den Krug auf ex runter ...."));break;
    case 16: write("'BOOEERRRP'\n");
             say(BS("'BOEEERRRP'"));break;
   }
   if (pos<=15) call_out("sequenz",2,pos+1,biername);
   else {
         TP->SetProp(P_PARALYZED,([PARALYZE_END:"",
                     PARALYZE_END_OTHER:"",PARALYZE_TIME:0]));
        }
   return 1;
}

