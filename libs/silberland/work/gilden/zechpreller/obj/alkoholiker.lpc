// Das Trinklied

#include "../zech.h"

inherit "std/thing";

#include <properties.h>
#include <new_skills.h>
#define TO this_object()
#define MEENV environment(TO)

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "Rausch");
  SetProp(P_GENDER, MALE);
  AddId("\nzechpreller_rausch");

  SetProp(P_MATERIAL, MAT_ALCOHOL );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
}

void SetVar(int mod, int dauer, object npc)
{
    SetProp(P_X_ATTR_MOD, ([A_STR:-mod, A_INT:-mod, A_DEX:-mod]));
    npc->SetProp(P_TMP_DIE_HOOK, ({time()+dauer, TO, "AtDeath"}));
    call_out("end", dauer);
}

void end()
{
  if(objectp(MEENV) && objectp(ENV(MEENV)))
  {
    tell_object(MEENV, "Du fuehlst Dich wieder etwas besser...\n");
    tell_room(ENV(MEENV), MENV->Name(WER)+" sieht wieder besser aus.\n",
  	      ({MEENV}));
  }
  remove(1);
}

int AtDeath(int poisondeath)
{
  end();
  return 0;
}
