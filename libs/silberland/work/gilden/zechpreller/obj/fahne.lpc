// Das Trinklied

#include "../zech.h"
#include <new_skills.h>
#include <combat.h>

inherit "std/thing";

#include <properties.h>
#define TO this_object()
#define MEENV environment(TO)

object caster;
int suc, range, damage, chance;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  suc    = 0;
  range  = 0;
  damage = 0;
  caster = 0;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "Alkoholfahne");
  SetProp(P_GENDER, MALE);
  AddId("\nzechpreller_fahne");
  AddId("\nzechpreller_special");

  SetProp(P_MATERIAL, MAT_ALCOHOL );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
}

mixed *QueryVars()
{
  return ({suc, range, chance, damage});
}

void SetVars(object pl, int abil, int success)
{
  caster = pl;
  suc    = success;
  damage = (int) 100+(abil/100)+(suc/200);
  range  = (int) (caster->QueryAttribute(A_CON)+abil/1000+(suc/1000)+random(suc/100));
  chance = (int) (abil/200)+(suc/400);
  caster->SetProp(P_TMP_ATTACK_HOOK, ({range+time(), TO, "Fighting"}));

  call_out("end", range);
}

int Fighting(object enemy)
{
  if(!objectp(enemy)) return 1;
  if(random(100) > chance) return 1;
  enemy->Defend(50+random(damage), ({DT_AIR, DT_POISON, DT_ACID}), 0,
                caster);
  return objectp(enemy);  
}

void end()
{
  if(objectp(caster) && objectp(ENV(caster)))
  {
    tell_object(caster, BS("Die Alkoholfahne um Dich herum loest sich auf."));
    tell_room(ENV(caster), BS("Die Alkoholfahne um "+caster->Name(WEN)+
              "loest sich auf."),
              ({caster}));
    caster->SetProp(P_TMP_ATTACK_HOOK, 0);
  }
  remove(1);
}
