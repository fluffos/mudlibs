#include "../zech.h"
#include <properties.h>
#include <combat.h>

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Paar Alkoholarmschienen");
  SetProp(P_LONG,
    "Die Armschienen bestehen aus reinem Alkohol, der von der Magier der "
    "Zechpreller in Form gehalten wird. Er fliesst die Arme des Traegers "
    "entlang. Vermutlich schuezten sie nicht sonderlich gut, erleichtern "
    "aber wohl das kanalisieren der alkoholischen Magie.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Paar Alkoholarmschienen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"armschienen", "alkoholschienen", "alkoholarmschienen", "schienen"}) );
  SetProp(P_ARTICLE, 1);
//  SetProp(P_PLURAL, 1);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_ALCOHOL:90, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 100);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_WATER:1, DT_POISON:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD:"zechpreller"]) );

  SetProp(P_ZECHPRELLER_BONUS, (["all":10]));
  SetProp(P_ZECHPRELLER_SPELLCOST, 10);
  SetProp(P_ZECHPRELLER_REDUCE_ALC, 10);
}
