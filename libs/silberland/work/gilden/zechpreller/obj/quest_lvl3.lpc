#include "/gilden/zechpreller/zech.h"
#include <properties.h>
#include <language.h>

inherit "std/thing";

int wasser, honig, obst, magie, yari;
object owner;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  wasser = 0;
  honig  = 0;
  obst   = 0;
  magie  = 0;
  yari   = 0;
  owner  = 0;

//--Beschreibungen---------------------------------------------------------
  SetProp(P_LONG,
    "In diesem, mit zauberkraeftigen Runen verzierten Fass, wird der "
    "seltene magische Met gegoren. Das Rezept fuer diesen magischen Met ist "
    "streng geheim. Nur die Gilde der Zechpreller kennt es!");

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Metfass");
  SetProp(P_GENDER, FEMALE);
  AddId(({GQID, GQID+"3", "fass", "metfass"}));

//--Eigenschaften----------------------------------------------------------
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  
  AddDetail( ({"runen", "rune"}),
     "Das ganze Fass ist mit magischen Runen verziert.");

  AddDetail( ({"rezept"}),
     "Das Rezept fuer den Met ist tief in den magischen Runen des Fasses "
     "verankert. Ein Zechpreller mag es bei genauerer Untersuchung erkennen."
  );

  
  AddCmd( ({"fuelle", "fuell", "befuell", "befuelle"}), "cmd_fill");
  AddCmd( ({"lege", "leg", "stecke", "steck"}), "cmd_stecken");
  AddCmd( ({"lade", "lad"}), "cmd_load");
}

int cmd_load(string str)
{
  notify_fail("Was willst Du aufladen?\n");
  if(!str || str == "") return 0;
  if(!(str == "fass auf" ||
       str == "metfass auf" ||
       str == "metfass mit magie auf" ||
       str == "fass mit magie auf" ||
       str == "fass mit magie" ||
       str == "metfass mit magie" ||
       str == "fass" ||
       str == "metfass")) return 0;

  notify_fail("Du hast zu wenig Magie!\n");
  if(TP->QueryProp(P_SP) < 50) return 0;
  TP->AddSp(-50);

  write(BS("Du laesst Deine magischen Energien in das Fass fliessen."));
  say(BS(TPN+" laesst magische Energie in ein Fass fliessen."));

  magie = 1;
  return 1;
}

int cmd_stecken(string str)
{
  string what;
  object ob;
  notify_fail("Was willst Du wohin geben?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s in metfass", what) != 1 &&
     sscanf(str, "%s in fass", what) != 1) return 0;

  notify_fail("Sowas hast Du gar nicht!\n");
  if(!ob = present(what, TP)) return 0;

  notify_fail("Sowas soll nicht in den Met!\n");
  if(!ob->id("\n_insel_honigwabe") && !ob->id("\nobst") &&
     !ob->id("\nyariyari")) return 0;

  if(ob->id("\n_insel_honigwabe"))
  {
    write(BS("Du legst die Honigwabe in das Metfass."));
    say(BS(TPN+" legt eine Honigwabe in das Metfass."));
    honig = 1;
  }
  else if(ob->id("\nobst"))
  {
    write(BS("Du legst "+ob->name(WEN, 1)+" in das Metfass."));
    say(BS(TPN+" legt "+ob->name(WEN, 1)+" das Metfass."));
    obst = 1;
  }
  else if(ob->id("\nyariyari"))
  {
    write(BS("Du legst das Yari in das Metfass."));
    say(BS(TPN+" legt ein Yari in das Metfass."));
    yari = 1;
  }

  ob->remove(1);
  return 1;
}

int cmd_fill(string str)
{
  notify_fail("Was moechtest Du womit fuellen?\n");
  if(!str || str == "") return 0;
  if(!(str == "fass mit wasser" ||
       str == "metfass mit wasser" )) return 0;

  if(wasser)
  {
    notify_fail("Es ist schon genug Wasser im Fass.\n");
    return 0;	
  }

  notify_fail("Dies hier ist wohl nicht der richtige Ort dafuer!\n");
  if(strstr(file_name(ENV(TP)), "/d/ebene/lamuerte/wwald/room/11y_30x") < 0)
    return 0;

  write(BS("Du befuellst das Metfass mit Wasser aus dem Fluss."));
  say(BS(TPN+" befuellt ein Metfass mit Wasser aus dem Fluss."));
  wasser = 1;
  return 1;
}

string info()
{
  if(!objectp(TP) || !interactive(TP)) return "";
  if(TP->QueryProp(P_GUILD) != "zechpreller") return "Du erkennst nichts.\n";
  
  return "Fuer das Rezept benoetigst Du noch:\n"+
	 "Etwas Wasser "+(wasser?"(erledigt)":"")+"\n"+
	 "Eine Honigwabe "+(honig?"(erledigt)":"")+"\n"+
	 "Ein Stueck Obst "+(obst?"(erledigt)":"")+"\n"+
	 "Etwas Magie "+(magie?"(erledigt)":"")+"\n"+
         "Einen mystischen Kultgegenstand "+(yari?"(erledigt)":"")+"\n"+
	 "Zechus weiss sicher mehr darueber!\n";
}

string _query_short()
{
  if(wasser && honig && obst && magie && yari) 
    return "Ein gefuelltes Metfass";
  else return "Ein leeres Metfass";
}

void SetOwner(object o)
{
  owner = o;
}

object QueryOwner()
{
  return owner;
}

int QueryStat()
{
  if(wasser && honig && obst && magie && yari) return 1;
  return 0;
}
