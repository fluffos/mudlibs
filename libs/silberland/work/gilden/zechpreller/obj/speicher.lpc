// Der Alkoholspeicher

#include "../zech.h"

inherit "std/thing";

#include <properties.h>
#define TO this_object()
#define MEENV environment(TO)

object caster;
int suc, range, bonus, old;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  suc    = 0;
  range  = 0;
  bonus  = 0;
  caster = 0;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "Alkoholspeicher");
  SetProp(P_GENDER, MALE);
  AddId("\nzechpreller_alkoholspeicher");

  SetProp(P_MATERIAL, MAT_ALCOHOL );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
}

void Fault(object pl)
{
  caster = pl;
  bonus  = -random(5)-5;
  old    = caster->QueryProp(P_ALCOHOL_DELAY);
  caster->Set(P_ALCOHOL_DELAY, symbol_function("alk", this_object()), F_QUERY_METHOD);
  call_out("end", caster->QueryAttribute(A_CON));
}

void SetVars(object pl, int abil, int success)
{
  caster = pl;
  suc    = success;
  bonus  = (int) (abil/1000);
  range  = (int) (caster->QueryAttribute(A_CON)*2+(suc/1000)+bonus);
  old    = caster->QueryProp(P_ALCOHOL_DELAY);

  caster->Set(P_ALCOHOL_DELAY, symbol_function("alk", this_object()), F_QUERY_METHOD);

  call_out("end", range);
}

void end()
{
  if(objectp(caster) && objectp(ENV(caster)))
  {
    tell_object(caster, BS("Die orangene Aura verschwindet wieder und Dein "
		"Alkoholhaushalt normalisiert sich."));
    tell_room(ENV(caster), BS("Die orangene Aura um "+caster->Name(WEN)+
	      " loest sich auf."),
  	      ({caster}));
  }
  caster->Set(P_ALCOHOL_DELAY, 0, F_QUERY_METHOD);
  remove(1);
}

int alk()
{
  return old+bonus;
}
