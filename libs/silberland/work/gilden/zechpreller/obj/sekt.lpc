#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../zech.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Sektglas");
  SetProp(P_LONG,
    "Ein Kristallglas voll prickelndem Sekt.");

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Sektglas");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"glas", "sektglas", "\ngwenshara_sektglas", "sekt"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CRYSTAL:80, MAT_ALCOHOL:20]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_INFO, BS("Dieser Sekt ist aus spezieller Zechprellerlagerung! "
	  "Eine Jubilaeumsausgabe zum Jahreswechsel! (Auch fuer Kinder und "
	  "Druiden geeignet)"));

  AddCmd( ({"trink", "trinke"}), "cmd_trinken");
}

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if(!str || str == "") return 0;
  if(!(str == "glas" ||
       str == "sektglas" ||
       str == "sekt")) return 0;

  write(BS("Du trinkst das Sektglas mit einem Schluck aus. PROSCHT!"));
  say(BS(TPN+" trinkt ein Sektglas aus und prostet allen zu."));

  if(TP->QueryProp(P_GUILD) == "druidenzirkel")
    TP->SetProp(P_ALCOHOL, TP->QueryProp(P_ALCOHOL)-10);
  else
    TP->SetProp(P_ALCOHOL, TP->QueryProp(P_ALCOHOL)+10);

  TO->remove(1);
  return 1;
}
