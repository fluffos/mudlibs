#include "/gilden/zechpreller/zech.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#define BSI(x, y) break_string(x, 78, y)

inherit "std/thing";

int percent;
object owner;
string uid;
void First(int ab);
void Second(int ab);
void Third(int ab);

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  percent = 45;
  
//--Beschreibungen---------------------------------------------------------
  SetProp(P_LONG,
    "Das ist gar nicht da...!");

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Task");
  SetProp(P_INVIS, 1);
  SetProp(P_GENDER, FEMALE);
  AddId(({GQID, GQID+"10"}));

//--Eigenschaften----------------------------------------------------------
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NODROP, 1);
}

void reset()
{
  int r;
  mixed in;
  if(!is_clone(TO)) return;
  if(!objectp(owner)) return;
  ::reset();
  
  r = random(4);
  in = (owner->InFight());
  if(owner->QueryProp(P_TESTPLAYER)){
  tell_object(owner, BS("Random: "+r)); 
  tell_object(owner, BS("InFight: "+sizeof(in)));}
  if(!r && !objectp(in))
  {
    owner->SetProp(P_PARALYZED, ([
		   PARALYZE_TIME: 100,
 	           PARALYZE_MSG:"Du stellst Dich gerade den Versuchungen des "
		                "Boesen!\n",
		   PARALYZE_MSG_OTHER:"",
		   PARALYZE_END:"Du erwachst aus Deiner Vision!\n",
		   PARALYZE_END_OTHER:"%s erwacht aus einer schrecklichen Vision!\n"]));
//    tell_object(owner, BS("Paralyse"));
    if(percent == 45) First(0);
    else if(percent == 55) Second(0);
    else if(percent == 65) Third(0);
  }
}

int calculate()
{
  int sum;
  sum += owner->QuerySkillAbility("prelle");
  sum += owner->QuerySkillAbility("identifiziere");
  sum += owner->QuerySkillAbility("schaetz");
  sum += owner->QuerySkillAbility("ruelpser");
  sum += owner->QuerySkillAbility("uebergeben");
  sum += owner->QuerySkillAbility("destilliere");
  sum += owner->QuerySkillAbility("anhauchen");
  sum += owner->QuerySkillAbility("rumkugeln");
  sum += owner->QuerySkillAbility("staenkern");
  sum += owner->QuerySkillAbility("groehlen");
  sum += owner->QuerySkillAbility("dunstpanzer");
  sum += owner->QuerySkillAbility("alkoholisiere");
  sum += owner->QuerySkillAbility("torkeln");
  sum += owner->QuerySkillAbility("alkoholwolke");
  sum += owner->QuerySkillAbility("trunkspruch");
  sum = (int) (sum/15); // Skilldurchschnitt
//  tell_object(owner, BS("Durchschnitt: "+sum));
  
  sum = (int) (100*sum/10000); // prozentsatz ermitteln
//  tell_object(owner, BS("Prozentsatz: "+sum));
  if(present("\nsegen", owner)) sum += 20; // Bonus aus segen
  return sum;
}

void First(int ab)
{
   if(!find_player(getuid(owner))) return;

   switch(ab)
   {
     case 0: tell_object(owner, BS("Ein eiskalter Windhauch erfasst Dich!"));
	     call_out("First", 2, 1);
	     break;
     case 1: tell_object(owner, BS("Du spuerst es... das Boese dringt in "
				    "Dich ein!"));
	     call_out("First", 3, 2);
	     break;
     case 2: tell_object(owner, BS("Ganz deutlich hoerst Du die abartige "
			 "Stimme des Boesen..."));
	     call_out("First", 2, 3);
	     break;
     case 3: tell_object(owner, BS("Gold... Reichtum... Edelsteine... all "
			 "dies kann DEIN sein!"));
	     call_out("First", 3, 4);
	     break;
     case 4: tell_object(owner, BS("Du musst mir nur Deinen Geist oeffnen!"));
	     if(calculate() >= percent) call_out("First", 3, 5);
	     else call_out("First", 3, 6);
	     break;
     case 5: tell_object(owner, BS("Du lallst dem Boesen entgegen: "
			 "Was soll ich mit Geld? Trinken kann ich auch ohne "
			 "zu zahlen!"));
	     percent = 55;
	     call_out("First", 3, 7);
	     break;
     case 6: tell_object(owner, BS("Du oeffnest dem Boesen Deinen Geist!"));
	     call_out("First", 3, 8);
	     break;
     case 7: tell_object(owner, BS("Mit einem Fauchen zieht sich das Boese " 
				   "zurueck!"));
	     call_out("First", 0, 9);
	     owner->SetProp(P_PARALYZED, 0);
	     break;
     case 8: tell_object(owner, BS("Ein Geldregen ergiesst sich ueber Dich!"));
	     if(ME_TOO_HEAVY == 
		clone_object("/d/dschungel/dante/weg/obj/fakem")->move(owner, M_GET))
	     {
	       clone_object("/d/dschungel/dante/weg/obj/fakem")->move(ENV(owner), M_PUT);
	     }
	     call_out("First", 0, 19);
	     owner->SetProp(P_PARALYZED, 0);
	     break;
     case 9: owner->Message(BSI("Du hast einer Versuchung des Boesen "
			   "widerstanden!", "Zechus teilt Dir mit: "), 
			    MSGFLAG_TELL);
	     break;
     case 10: owner->Message(BSI("Du warst tschu Schwach! Du musscht besscher "
		     "werden um dem Boeschen tschu widerstehen <HICKS>!", 
		     "Zechus teilt Dir mit: "), MSGFLAG_TELL);
	      break;
		    
     default: tell_object(owner, "Fehler! Gildenmagier verstaendigen!"); break;
   }
}

void Second(int ab)
{
   if(!find_player(getuid(owner))) return;

   switch(ab)
   {
     case 0: tell_object(owner, BS("Kaelte wallt in Dir auf!"));
	     call_out("Second", 2, 1);
	     break;
     case 1: tell_object(owner, BS("Die Macht des Boesen ergreift Dich "
				   "abermals!"));
	     call_out("Second", 3, 2);
	     break;
     case 2: tell_object(owner, BS("Du hoerst das leise Fluestern des Boesen:"));
	     call_out("Second", 2, 3);
	     break;
     case 3: tell_object(owner, BS("Kraft... pure Magie!"));
	     call_out("Second", 3, 4);
	     break;
     case 4: tell_object(owner, BS("Du musst es nur zulassen!"));
	     if(calculate() >= percent) call_out("Second", 3, 5);
	     else call_out("Second", 3, 6);
	     break;
     case 5: tell_object(owner, BS("Du lallst dem Boesen entgegen: "
			 "Wotschu brauch ich Magie? Isch hab schon genug!"));
	     percent = 65;
	     call_out("Second", 3, 7);
	     break;
     case 6: tell_object(owner, BS("Du oeffnest dem Boesen Deinen Geist!"));
	     call_out("Second", 3, 8);
	     break;
     case 7: tell_object(owner, BS("Mit einem Fauchen zieht sich das Boese " 
				   "zurueck!"));
	     call_out("Second", 0, 9);
	     owner->SetProp(P_PARALYZED, 0);
	     break;
     case 8: tell_object(owner, BS("Pure Magie manifestiert sich!"));
	     if(ME_TOO_HEAVY == clone_object(OBJ("magic"))->move(owner, M_GET))
	     {
	       clone_object(OBJ("magic"))->move(ENV(owner), M_PUT);
	     }
	     call_out("Second", 0, 10);
	     owner->SetProp(P_PARALYZED, 0);
	     break;
     case 9: owner->Message(BSI("Du hast einer Versuchung des Boesen "
			   "widerstanden!", "Zechus teilt Dir mit: "), 
			    MSGFLAG_TELL);
	     break;
     case 10: owner->Message(BSI("Du warst tschu Schwach! Du musscht besscher "
		     "werden um dem Boeschen tschu widerstehen <HICKS>!", 
		     "Zechus teilt Dir mit: "), MSGFLAG_TELL);
	      break;
		    
     default: tell_object(owner, "Fehler! Gildenmagier verstaendigen!"); break;
   }
} 

void Third(int ab)
{
   if(!find_player(getuid(owner))) return;

   switch(ab)
   {
     case 0: tell_object(owner, BS("Deine Sicht verschwimmt... "
		        "Du fuehlst Dich unwohl!"));
	     call_out("Third", 2, 1);
	     break;
     case 1: tell_object(owner, BS("Etwas boeses ergreift Besitz von Dir!"));
	     call_out("Third", 3, 2);
	     break;
     case 2: tell_object(owner, BS("Eine droehnende Stimme spricht zu Dir:"));
	     call_out("Third", 2, 3);
	     break;
     case 3: tell_object(owner, BS("Ich biete Dir die Ewigkeit! Du wirst "
		        "niemals sterben!"));
	     call_out("Third", 3, 4);
	     break;
     case 4: tell_object(owner, BS("Wuensche es, und es wird geschehen!"));
	     if(calculate() >= percent) call_out("Third", 2, 5);
	     else call_out("Third", 3, 6);
	     break;
     case 5: tell_object(owner, BS("Du lallst dem Boesen entgegen: "
			 "Ewig leben isch fad!"));
	     call_out("Third", 3, 7);
	     break;
     case 6: tell_object(owner, BS("Du wuenschst Dir ewiges Leben!"));
	     call_out("Third", 3, 8);
	     break;
     case 7: tell_object(owner, BS("Mit einem Fauchen zieht sich das Boese " 
				   "nun fuer immer zurueck!"));
	     call_out("Third", 0, 9);
	     owner->SetProp(P_PARALYZED, 0);
	     break;
     case 8: tell_object(owner, BS("Deine Konturen verblassen..."));
	     owner->SetProp(P_GHOST, 1);
	     call_out("Third", 0, 10);
	     owner->SetProp(P_PARALYZED, 0);
	     break;
     case 9: owner->Message(BSI("Du hast allen Versuchung des Boesen "
			   "widerstanden! Jetsch kannscht in die Reihen der "
			   "Zechprellermeister aufgenommen werden!", "Zechus teilt Dir mit: "), 
			    MSGFLAG_TELL);
	     QUESTMASTER->SetQuest(uid, 2);
	     remove(1);
	     break;
     case 10: owner->Message(BSI("Du warst tschu Schwach! Du musscht besscher "
		     "werden um dem Boeschen tschu widerstehen <HICKS>!", 
		     "Zechus teilt Dir mit: "), MSGFLAG_TELL);
	      break;
		    
     default: tell_object(owner, "Fehler! Gildenmagier verstaendigen!"); break;
   }
}

int SetOwner(object ob)
{
  if(strstr(file_name(PO), "/gilden/") != 0 &&
     member(GILDENMAGIER, getuid(PO)) < 0) return -1;
  owner = ob;
  uid   = getuid(ob);
  return 1;
}
