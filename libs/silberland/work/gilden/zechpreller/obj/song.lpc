// Das Trinklied

#include "../zech.h"

inherit "std/thing";

#include <properties.h>
#define TO this_object()
#define MEENV environment(TO)

mixed songs=
({
({"Auf Derlims Bergen, da waechst ein Wein",
  "Der braucht nicht Hitze, nicht Sonnenschein",
  "Ob's Jahr ist schlecht, ob's Jahr ist gut",
  "Da trinkt man froehlich der Trauben Blut"}), 

({"Bier her, Bier her, oder ich fall um, juchhe",
  "Bier her, Bier her, oder ich fall um",
  "Soll das Bier im Keller liegen",
  "Und ich hier die Ohnmacht kriegen",
  "Bier her, Bier her, oder ich fall um"}),

({"Wein her, Wein her, oder ich fall um, juchhe",
  "Wein her, Wein her, oder ich fall um",
  "Soll der Wein im Keller liegen",
  "Und ich Rheumatismus kriegen",
  "Wein her, Wein her, oder ich fall um"}),

({"Das Trinken, das soll man nicht lassen",
  "Das Trinken regiert doch die Welt",
  "Man soll auch den Menschen nicht hassen",
  "Der stets eine Lage bestellt",
  "Ob Bier oder Wein, ob Champagner",
  "Nur lasst uns beim Trinken nicht prahlen",
  "Es trank den Champagner schon mancher",
  "Und konnt ihn nachher nicht bezahlen"}),

({"Trink, trink, Bruederlein trink",
  "Lass doch die Sorgen zu Haus",
  "Meide den Kummer und meide den Schmerz",
  "Dann ist das Leben ein Scherz"}),

({"Und eins und zwei und drei und vier",
  "Sie soffen unheimlich viel Lagen Bier",
  "Und fuenf und sechs und sieben und acht",
  "Sie soffen die ganze Nacht"}),

({"Ein Bier, das macht den Durst erst schoen",
  "Drum nehmt das Glas und trinket",
  "Wie herrlich ist es anzusehn",
  "Wenn golden im Glase es blinket"}),

({"Wir trinken mit Freuden ein Bier",
  "Und stehen vereint an der Theke",
  "Wir geniessen das schaeumende Nass",
  "Das der Wirt uns zapft aus dem Fass"}),

({"He! schenket mir im Helme ein",
  "Der ist des Knappen Becher",
  "Er ist nicht seicht, und traun, nicht klein",
  "Das freut den wackern Zecher"}),

({"In Midas steht ein Hofbraeuhaus",
  "Da laeuft so manches Faesschen aus",
  "Da hat so mancher braver Mann",
  "Gezeigt was er so vertragen kann",
  "Schon frueh am Morgen fing er an",
  "Und spaet am Abend kam er heraus",
  "So schoen ist's im Hofbraeuhaus"}),

({"Werden wir so traurig sein",
  "Gebt noch ein volles Glas",
  "Holla, Wirt den besten Wein",
  "Geht vor das groesste Fass"}),

({"Lustig in dem alten Haus",
  "Kehrt Tisch und Baenk herum",
  "Werft den Wirt zum Fenster raus",
  "Da kugelt er herum"}),

({"Bier und Wein aus einem Fass",
  "sauf es ohn' Unterlass",
  "das ganze Jahr, den Abend und den Morgen"})
}); 

object caster;
int rate, suc, range, offset, bonus, strophe, zeile;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  rate   = 0;
  suc    = 0;
  range  = 0;
  offset = 0;
  bonus  = 0;
  caster = 0;

  strophe = 0;
  zeile   = 0;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "Rausch");
  SetProp(P_GENDER, MALE);
  AddId("\nzechpreller_trinklied");
  AddId("\nzechpreller_special");

  SetProp(P_MATERIAL, MAT_ALCOHOL );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
}

void Fault(object pl)
{
  caster = pl;
  bonus  = -random(5)-3;
  caster->AddHp(-10);
  SetProp(P_X_ATTR_MOD, ([A_CON:bonus]));
  call_out("end", caster->QueryAttribute(A_CON));
}

void SetVars(object pl, int abil, int success)
{
  caster = pl;
  rate   = (int) abil/1300;
  suc    = success;
  range  = (int) (caster->QueryAttribute(A_CON)+(suc/1000)+rate+random((int) suc/100));
  offset = (int) (caster->QueryAttribute(A_CON)/5); // Changed by Gwenshara, origignal : Con/2
  if(suc>6000)
    bonus  = 2+random((suc/1000));

  strophe = random(sizeof(songs));

  SetProp(P_X_ATTR_MOD, ([A_CON:bonus]));
  call_out("idleup", 2+random(5));
  call_out("end", range);
}

void idleup()
{
  int old_strophe;
  if(!caster) return;
  if(caster->QueryProp(P_MAX_HP) > caster->QueryProp(P_HP))
    caster->AddHp(rate+random(offset));

  if(zeile >= sizeof(songs[strophe]))
  {
    old_strophe=strophe;
    strophe=random(sizeof(songs));
    if(old_strophe==strophe) strophe=(strophe+1)%sizeof(songs);
    zeile = 0;
  }

  ENV(caster)->Message(break_string(songs[strophe][zeile]+"!",78,caster->Name(WER)+" singt: "),
                       MSGFLAG_SOUND, ([ MSGFLAG_EXCLUDE : ({ caster }) ]));
  caster->Message(break_string(songs[strophe][zeile]+"!",78,"Du singst: "),
                  MSGFLAG_SOUND);
  zeile++;

  call_out("idleup", 2+random(5));
}

void end()
{
  if(objectp(caster) && objectp(ENV(caster)))
  {
    tell_object(caster, "Du beendest Deinen Gesang erschoepft.\n");
    tell_room(ENV(caster), caster->Name(WER)+" hoert auf zu grohelen.\n",
  	      ({caster}));
  }
  remove(1);
}

mixed *QueryVars()
{
  return ({rate, range, offset, bonus});
}
