inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../zech.h"

object npc, caster;
int value, sets, old_spr;

create() {
  if( !is_clone(TO) ) return;
  ::create();
  sets=0;
  SetProp(P_SHORT, 0);
//  SetProp(P_WEAPON_TYPE, WT_MISC); Is das hier eine Waffe?!
//  SetProp(P_WC, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({"\ngroehlen"}));

/* if(getuid(previous_object())!="GUILD.zech_spells") {
   call_out("remove", 1);
   return 0;
  }*/
}

int SetVariables(object caster1, int dauer, int v, int spellr) {
  if(sets || !objectp(ENV(ME)) || !living(ENV(ME))) {
    call_out("remove", 0);
    return 0;
  }
  old_spr=spellr;
  caster=caster1;
  npc=ENV(ME);
  value=v;
  npc->SetProp(P_SPELLRATE, value);
  call_out("remove", dauer);
  sets=1;
  npc->SetProp(P_TMP_DIE_HOOK, ({time()+dauer, TO, "AtDeath"}));
  return 1;
}

mixed QueryVariables() {
  return ({caster, npc, value});
}

int AtDeath(int poisondeath)
{
  remove();
  return 0;
}

remove() {
 if(objectp(npc) && find_object(file_name(npc))) {
   if(objectp(caster) && find_player(getuid(caster))) 
     tell_object(caster, BS(sprintf("Die Wirkung des Groehlen laesst nach!\n" 
         )));
   if(find_object(file_name(npc))) {
     npc->SetProp(P_SPELLRATE, old_spr);
   }
 }
 while(remove_call_out("remove")!=-1);
 ::remove();
}

init() {
 ::init();
 if(!living(ENV(ME)))
   call_out("remove", 0);
}

reset() {
  ::reset();
  call_out("remove", 0);
}

BecomesNetDead(object wer) {
  remove();
}
