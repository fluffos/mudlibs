#include "/gilden/zechpreller/zech.h"
#include <moredef.h>
#include <properties.h>
#include <moving.h>

inherit "std/thing";

string *soll = ({});
string *ist  = ({});
string erbe;
int index = 0;
object owner;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Zechprellerquest 11");
  SetProp(P_LONG,  0);
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------

  SetProp(P_GENDER, MALE);
  AddId( ({"\nzechpreller_quest_11", "testid"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 0);
}

private int check()
{
  int i;
  for(i=0; i<sizeof(soll) && i<sizeof(ist); ++i)
   if(soll[i] != ist[i]) return 0;
  return 1;
}

private void SendItem()
{
  object ob;
  tell_object(owner, break_string("Schuper! Komm noch schnell her und "
	      "gib mir dasch Ding!", 78, "Zechus teilt Dir mit: "));
  ob = clone_object(EPIC("verfy/"+erbe+"_verfy"));
  ob->move(owner, M_GET); // Geht immer, verify wiegt 0!
  tell_object(owner, "Etwas faellt aus der Leiche.\n"+
                     "Du steckst es sofort ein.\n");
  tell_room(ENV(owner), "Etwas faellt aus der Leiche.\n"+
                        owner->Name(WER)+" steckt es sofort ein.\n");
  remove(1);
}

void Start(string *todo, string gruender, object o)
{
 soll = todo;
 erbe = gruender;
 owner = o;
 call_out("end", 3600);
}

void end()
{
  if(!objectp(owner)) remove(1);
  tell_object(owner, break_string("Du hascht genug Tscheit gehabt! "
	      "Wennscht ein Gildenerbe werden willscht solltescht schneller "
	      "schein!", 78, "Zechus teilt Dir mit: "));
  remove(1);
}

void StopTimer()
{
  if(find_call_out("end")) remove_call_out("end");
  remove(1);
}

private void Wrong()
{
  if(!objectp(owner)) remove(1);
  tell_object(owner, break_string("Dasch war tschwa gut... aber falsch! "
	      "Du hasscht wasch falsch gemacht <HICKS>, komm tschu mir "
	      "und versuchs nochmal!", 78, "Zechus teilt Dir mit: "));
  remove(1);
}

varargs void Mark(int pd)
{
  string path;
  if(!PO) return;
  if(!objectp(owner)) return;
  path = explode(file_name(PO), "#")[0];
  ist+=({path});
  index++;

  if(sizeof(ist) >= sizeof(soll))
  {
    if(check() > 0) SendItem();
    else Wrong();
  }
}

string *GetIst()
{
  return ist;
}
