inherit "std/inpc";
inherit "std/npc/spells";


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <inpc.h>
#include <new_skills.h>

#include "/gilden/zechpreller/zech.h"

#define GQMASTER "/gilden/zechpreller/master/questmaster"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId ( ({"zechus", "prellus", GILDENNPC}) );
  SetProp(P_NAME, "Zechus Prellus");
  SetProp(P_SHORT, "Zechus Prellus");
  SetProp(P_LONG, "Das ist Zechus Prellus, der Obertrinker der "
         +"Zechpreller. Er hat einen riesigen Schnapsbauch und "
         +"zwei grosse Glubschaugen, aus denen er Dich mit seinem "
         +"verschwommenen Blick nach Alkohol abzutasten scheint. "
         +"Von ihm geht eine Fahne aus, die selbst dem haertesten "
         +"Saeufer den Rest geben wuerde.");
  create_default_npc(50);
  SetProp(P_GENDER,MALE);
  SetProp(P_ALIGN, 0);
  SetProp(P_GUILD, "zechpreller");
  SetProp(P_GUILD_LEVEL, 15);
  SetProp(P_XP, QueryProp(P_XP)+100*100);
  SetProp(P_HANDS, ({" mit seiner Fahne",600,DT_POISON}));
  SetProp(P_XP, QueryProp(P_XP)); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_BODY, 200+random(300));
  SetProp(P_SIZE, 190);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,20);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 50);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "torkelt herein");
  SetProp(P_MSGOUT, "torkelt");
  SetProp(P_MMSGIN, "destilliert sich herein");
  SetProp(P_MMSGOUT, "loest sich in Alloholdunst auf");
  SetProp(P_DIE_MSG,  " geht auf ein Geisterbraeu zu Lars.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Dann trink ich halllllllt bei Larsch!");
  SetProp(P_KILL_NAME, "Zechus Prellus");
  SetProp(P_KILL_MSG, "PROSCHT!");
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0,        DT_BLUDGEON   :0,        DT_PIERCE     :0,
    DT_SQUEEZE    :0,        DT_WHIP       :0,        DT_RIP        :0,
    DT_FIRE       :0,        DT_COLD       :-0.5,     DT_WATER      :-0.5,    
    DT_AIR        :-0.5,     DT_LIGHTNING  :0,        DT_EXPLOSION  :0, 
    DT_SOUND      :-0.5,     DT_LIGHT      :0,        DT_ELECTRIC   :0,    
    DT_ACID       :0,        DT_POISON     :-1,        DT_TERROR     :-1,     
    DT_HOLY       :0,        DT_UNHOLY     :0,        DT_MAGIC      :-0.3]) );
  SetProp(P_SPELLRATE, 60);
  SetProp(P_ALCOHOL,1000); // Eigentlich unnoetig, da _query_alcohol() def. is
  SetProp(P_MAX_ALCOHOL,1000);

  set_living_name("zechus"); // Sowas gehoert sich einfach!
  

 CLONEME("/obj/misc/bier"); 
 CLONEME(OBJ("z_17erschluessel")); // Der MUSS her!
 command_me("trage schluessel");
 CLONEME("/p/armour/belt/guertel");
 CLONEME("/p/armour/boots/lederstiefel");
 CLONEME("/p/armour/cloak/schuerze");
 CLONEME(OBJ("zechus_bracers"));
 CLONEME("/d/wueste/gwenshara/echsendorf/armour/zech_ring");
 command_me("trage alles");
  
 AddInfo(DEFAULT_INFO, 
        "Kann man dasch deschtillieren und ... trinkn?", "lallt fragend: ");
 SetProp(P_SMELL, BS("Der Allohooooldunscht .... upsch, dasch isch "
        +"ja gar net so schlecht.\n"));
 AddLibrary(NPC("zechus.lib"), 5);
 AddInfo(({"siebzehnerschluessel", "schluessel", "siebzehner"}),
         "@@Siebzehnerschluessel@@", "lallt: ");
 AddInfo(({"neuem siebzehnerschluessel", "neuem schluessel", 
           "neuem siebzehner"}),
         "@@NewAmulett@@", "lallt: ");
 AddInfo(({"faehigkeiten", "fertigkeiten"}),
     "@@fertigkeiten@@", "lallt: ");
 AddInfo(({"faesschen", "metfaesschen", "fass", "metfass", "rezept"}),
     "@@quest_lvl3@@", "lallt: ");
 
 AddSpell(1,1400,
    "Zechus haucht Dich an.\n",
    "Zechus haucht @WEN an.\n",
    DT_POISON,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,600,
     "Zechus ruelpst Dir ins Gesicht.\n",
     "Zechus ruelpst @WEM ins Gesicht.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,900,
     "Zechus wirft eine leere Flasche nach Dir.\n",
     "Zechus wirft eine leere Flasche nach @WEM.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
 AddSpell(1, 1,
     "Zechus destilliert einen Teil Deiner Ausruestung.\n",
     "Zechus destilliert einen Teil von @WESSEN Ausruestung.\n", 
     DT_MAGIC, "destillieren");
 AddSpell(1, 700,
    "Zechus uebertraegt einen Teil seines Alkohols auf Dich!\n",
    "Zechus uebertraegt einen Teil seines Alkohols auf @WEN!\n",
    ({DT_MAGIC, DT_POISON}), "alkoholisieren", ([SP_SHOW_DAMAGE:1]));
 AddDefaultSpell(1, 300, DS_MASS_DAMAGE,
    "Zechus kugelt sich am Boden herum.\n",
    "Zechus kugelt sich am Boden herum.\n",
    ({DT_SQUEEZE}));
 AddSpell(1, 200,
    "Zechus groehlt Dir schreckliche Trinklieder entgegen!\n",
    "Zechus grohelt @WEM schreckliche Trinklieder entgegen!\n",
    ({DT_SOUND}), "groehlen", ([SP_SHOW_DAMAGE:1]));

  
  AddCmd("wette|wett&mit&zechus|prellus|zechus prellus", "cmd_barden_wette", "Mit wem willst du wetten?");
}

public int cmd_barden_wette(string args) {
  object ob;
  if(this_player()->QueryProp(P_GUILD) != "bardengilde") {
    command_me("sag He! Du bissch ja kein Barde! Du kannsches eh net!");
    return -1;
  }

  if(present("\nbard_glas_" + geteuid(this_player()), environment(this_object()))) {
    command_me("sag Wir haben doch eh schon <HICKS!> ne Wette laufn!");
    return -1;
  }

  command_me("sag Alschogut! Ich wett, du kannst desch Weinglas ned kaputt schrein!");
  ob=clone_object("/gilden/bardengilde/obj/quest/glas_base");
  ob->bind(this_player());
  if(ob->move(environment(this_object()), M_PUT) != 1) {
    command_me("sag Da gatsch irgendwas. Sagscht schnell einem Magier Bescheid?");
    return -1;
  }

  return 1;
}

void groehlen(object enemy, int damage, mixed dam_type)
{
  if(enemy->QueryProp(P_DISABLE_SPELLS) > 0) return;
  enemy->SetProp(P_DISABLE_SPELLS, 4+random(7));          
}

void alkoholisieren(object enemy, int damage, mixed dam_type)
{
  object o;
  if(!(enemy->QueryProp(P_GUILD) == "zechpreller"))
    enemy->SetProp(P_ALCOHOL, enemy->QueryProp(P_ALCOHOL)+20);
  if(!present("zechpreller_alkoholiker", enemy))
  {
    o = clone_object(OBJ("alkoholiker"));
    o->SetVar(6, 300, enemy);
    o->move(enemy);
  }
}

void destillieren(object enemy, int damage, mixed dam_type)
{
  object *i;
  i = enemy->QueryProp(P_ARMOURS);
  i += ({enemy->QueryProp(P_WEAPON)});

  // Drei Items destillieren
  if(sizeof(i)) i[random(sizeof(i))]->TakeFlaw(10);
  if(sizeof(i)) i[random(sizeof(i))]->TakeFlaw(10);
  if(sizeof(i)) i[random(sizeof(i))]->TakeFlaw(10);
  AddHp(200);
}

int Defend(int dam, mixed dam_type_list, mixed spell, object enemy)
{
  object o;
  if(!random(6) && !present("\nzechpreller_torkeln"))
  {
    o = clone_object(OBJ("torkeln"));
    o->SetVars(TO, 300, 80);
    o->move(TO);
    tell_room(ENV(TO), "Zechus beginnt zu schwanken!\n");
  }
  if(!random(6) && !present("\nzechpreller_panzer"))
  {
    o = clone_object(OBJ("dunstmantel"));
    o->SetVars(300, 40);
    o->move(TO);
    tell_room(ENV(TO), "Um Zechus bildet sich ein Dunstpanzer!\n");
    command_me("ziehe dunstpanzer an");
  }
  if(!random(3) && !present("\nzechpreller_weingeist_zechus", ENV(TO)))
  {
    o = clone_object(NPC("weingeist"));
    o->SetMaster(TO, 10000, 10000);
    o->AddId("\nzechpreller_weingeist_zechus");
    tell_room(ENV(TO), "Zechus oeffnet eine Flasche!\n");
    o->move(ENV(TO), M_TPORT);
    o->FindAndKill();
  }
  if(!present("\nzechpreller_fahne", TO))
  {
    tell_room(ENV(TO), BS("Zechus atmet gruenen Dunst aus!"));
    o = clone_object(OBJ("fahne"));
    o->SetVars(TO, 10000, 10000);
    o->move(TO, M_NOCHECK);
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}

string fertigkeiten()
{
 call_other(ENV(TO), "faehigkeiten");
 return "Scho ischt des, net *hicks*";
}
  
void GiveAmulett(object pl)
{
 object ob;
 write("Zechus gibt Dir einen Siebzehnerschluessel.\n");
 tell_room(ENV(TP),BS("Zechus gibt "+TP->Name(WEM)+" eine Art "
                      +"Flaschenoeffner.\n"),({TP}));
 if(TP->QueryProp(P_GUILD_LEVEL)>10)
 {
   ob=clone_object(EPIC("obj/g_obj_"+call_other(ERBMASTER, "QueryErbe",
                   getuid(TP))));
 }
 else ob=clone_object(OBJ("z_17erschluessel"));
 ob->move(TP, M_NOCHECK);
 return;
}

string Siebzehnerschluessel()
{
 if(TP->QueryProp(P_GUILD)!="zechpreller")
   return "Du bischt keiner von unsch.";
 if(!present(GILDENOBJ, TP))
   {
    call_out("GiveAmulett",0, TP);
    return "Upsch. Du hascht ja gar keinen mehr. Da hascht einen neuen!";
   }
 return "Dasch ischt der geheiligte SIEBTSCHEHNERSCHLUESCHEL! Damit "
       +"koennen wir <HICKs> mit der MACHT des ALLOHOLS tschaubern.";
}

string NewAmulett()
{
 object ob;
 if(TP->QueryProp(P_GUILD)!="zechpreller")
   return "Du bischt keiner von unsch.";
 if(!ob=present(GILDENOBJ, TP)) {
   call_out("GiveAmulett",0, TP);
   return "Upsch. Du hascht ja gar keinen mehr. Da hascht einen neuen!";
 }
 ob->SetProp(P_CURSED, 0);
 ob->remove();
 call_out("GiveAmulett",0, TP);
 return "Da hascht 'nen neuen.";
}

string quest_lvl3()
{
  object ob;
  if(TP->QueryProp(P_GUILD)!="zechpreller")
   return "Du bischt keiner von unsch.";
  if(present(GQID+"3", TP)) return "Du hascht eh ein Fassch!";
  if(TP->QueryProp(P_GUILD_LEVEL)<2 ||
     call_other(QUESTMASTER, "QueryQuest", getuid(TP), 0)) 
    return "Dasch musscht gar ned machen!";
  ob=clone_object(OBJ("quest_lvl3"));
  if(ME_TOO_HEAVY == ob->move(TP, M_GET))
  {
    ob->remove(1);
    return "Dasch kannscht gar nimma <HICK> tragen!";
  }
  return "Da hascht ein Metfassch! Wenns voll ist bringsch mir wieder!";
}


int _query_alcohol()
{
  return 1000;
}

void die( int poisondeath )
{
  if(present("\nzechpreller_torkeln")) present("\nzechpreller_torkeln")->remove(1);
  if(present("\nzechpreller_panzer")) present("\nzechpreller_panzer")->remove(1);
  ::die(poisondeath);
}

// Fuer die Gildenquests
void give_notify(object ob)
{
  if(!ob->id(GQID))
  {
    command_me("sag Danke!");
    return;
  }

  if(ob->id(GQID+"3"))
  {
    if(!ob->QueryStat())
    {
      command_me("sag Aber Du bischt ja noch ned fertig!");
      ob->move(TP, M_NOCHECK);
      tell_object(TP, "Zechus gibt Dir das Fass zurueck.\n");
      tell_room(ENV(TP), "Zechus gibt "+TP->Name(WEM)+" das Fass "
                "zurueck.\n", ({TP}));
      return;
    }

    command_me("sag Ahhh! Scher gut! Den Met bewahr ich fuer Dich auf!");
    tell_room(ENV(TO), BS("Zechus stellt das Metfass zu den anderen."));
    call_other(QUESTMASTER, "SetQuest", getuid(TP), 0);
    ob->remove(1);
  }
  else if(ob->id(GQID+"7"))
  {
    command_me("sag Ah! Da isch ja dasch Trink <HICK> Trinkhorn!");
    tell_room(ENV(TO), BS("Zechus steckt das Trinkhorn weg."));
    call_other(QUESTMASTER, "SetQuest", getuid(TP), 1);
    ob->remove(1);
  }
  else if(ob->id(GQID+"lanestra"))
  {
    command_me("sag Ahja! Scher gut!");
    if(present("\nzechpreller_quest_11", TP))
      call_other(present("\nzechpreller_quest_11", TP), "StopTimer");
    call_other("/gilden/zechpreller", "advance_11", ERBE_LANESTRA, TP);
    ob->remove(1);
  }
  else if(ob->id(GQID+"tarxes"))
  {
    command_me("sag Ahja! Scher gut!");
    if(present("\nzechpreller_quest_11", TP))
      call_other(present("\nzechpreller_quest_11", TP), "StopTimer");
    call_other("/gilden/zechpreller", "advance_11", ERBE_TARXES, TP);
    ob->remove(1);
  }
  else if(ob->id(GQID+"zechus"))
  {
    command_me("sag Ahja! Scher gut!");
    if(present("\nzechpreller_quest_11", TP))
      call_other(present("\nzechpreller_quest_11", TP), "StopTimer");
    call_other("/gilden/zechpreller", "advance_11", ERBE_ZECHUS, TP);
    ob->remove(1);
  }
  else if(ob->id(GQID+"artanok"))
  {
    command_me("sag Ahja! Scher gut!");
    if(present("\nzechpreller_quest_11", TP))
      call_other(present("\nzechpreller_quest_11", TP), "StopTimer");
    call_other("/gilden/zechpreller", "advance_11", ERBE_ARTANOK, TP);
    ob->remove(1);
  }
  return;
}

void silvester()
{
  object sekt, *players;
  int i;
  players=users();

  for(i=0; i<sizeof(players); ++i)
  {
    tell_object(players[i],
	BS("Zechus Prellus ruft: Ein froehlischesches neuessch Jahr! <HICKS!>"));
    tell_object(players[i],
	BS("Ein Sektglas materialisiert sich!"));
    sekt = clone_object(OBJ("sekt"));
    sekt->move(players[i], M_NOCHECK|M_GET);
  }

  return;
}

public void init() {
  ::init();

  call_out("check_tp", 0, TP);
}

public void check_tp(object who) {
  if(TP->QueryProp(P_GUILD) == "zechpreller") {
    if(call_other("/gilden/zechpreller", "get_available_talent_points", TP) > 0) {
      tell_object(TP, BS("Zechus lallt: Du hast noch Talentpunkte frei, "+TPN+"! "
                         +"Mach mal <hilfe talente> und schau was du damit tun!\n"));
    }
  }
}