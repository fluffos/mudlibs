#include <properties.h>
#include <npc.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "../zech.h"

inherit "/p/std/npc/zechpreller_npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Chronist Jakob Daniel");
  SetProp(P_LONG,
    "Jakob ist der Chronist der Zechpreller. Er ist in einen vornehmen Anzug "
    "gekleidet und haelt ein Glas seines besten Whiskeys in der Hand. Er "
    "scheint so gar nicht in die Gilde der Zechpreller zu passen, doch sein "
    "Siebzehner verraet Dir das er ein Mitglied ist. Angeblich ist er nach "
    "irgend einer Sache mit Bohnen und Riesen in den Suff abgerutscht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Jakob Daniel");
  SetProp(P_GENDER, MALE);
  AddId(({"jakob", "daniel", "chronist", "jakob daniel", "chronist", 
	  "\nzechpreller_chronist", "NOWIMPY"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("jackdaniels");

//--Eigenschaften----------------------------------------------------------

 create_default_zechpreller(40, 9);

  SetProp(P_HANDS, ({" mit seinen Faeusten",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" destilliert @WEN.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1, DT_COLD:     -0.5,
       DT_AIR:      -0.2, DT_EXPLOSION: 0.1,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das wird in den Chroniken der Zechpreller aufscheinen!");
  SetProp(P_KILL_MSG, "Und noch ein Eintrag in den Chroniken! Prost, %s!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "nimmt einen Schluck aus seinem Glas.\n");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 75);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" prostet Dir zu.\n",
    Name(WER, 1)+" sagt: Ich hasse Riesen.\n",
    Name(WER, 1)+" torkelt ein wenig.\n",
    Name(WER, 1)+" schwenkt sein Glas.\n",
    Name(WER, 1)+" durchsucht die Chroniken.\n",
    Name(WER, 1)+" erweitert die Chroniken ein Stueck.\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( WEAPON("w_glas") );
  command("zuecke glas");

  CLONEME( "/d/wasser/malar/laden/armour/seidenhemd" );
  CLONEME( "/p/armour/trousers/seidenhose" );
  CLONEME( "/p/armour/boots/seidenschuhe" );
  CLONEME( "/p/armour/cloak/seidenumhang" );
  CLONEME( "/p/armour/gloves/seidenhandschuhe" );
  CLONEME( "/d/ebene/ronja/feenquest/armour/zylinder");

  command("trage alles");

  AddCmd( ({"frag", "frage"}), "cmd_chronik");
}

void chronik(string wer, int ein, int stu, int let)
{
  object pl;

  if(!objectp(pl = find_player(lower_case(wer))))
      pl = find_netdead(lower_case(wer));

  write(sprintf("%50-'_'s\n", " "));
  write(sprintf("%50-' 's%s\n", "(", "()"));
  write(sprintf("%50-'~'s%s\n", "|", "|"));
  write(sprintf("| Name: %41s |\n", 
                 (objectp(pl)?pl->QueryProp(P_PRESAY):"")+
                  capitalize(wer)
                +(objectp(pl)?" "+pl->QueryProp(P_TITLE):"")));
  if(objectp(pl)) write(sprintf("| Zechpreller: %34s |\n", 
		 (pl->QueryProp(P_GUILD)=="zechpreller"?"ja":"nein")));
  if(objectp(pl) && pl->QueryProp(P_GUILD) == "zechpreller")
    write(sprintf("| Gildenstufe: %34d |\n", pl->QueryProp(P_GUILD_LEVEL)));
  write(sprintf("| %47s |\n", capitalize(wer)+" ist "+ein+" Mal beigetreten."));
  write(sprintf("| %47s |\n", capitalize(wer)+" hat die letzte Stufe "+let+" Mal erreicht."));
  write(sprintf("| %47s |\n", capitalize(wer)+" hat insgesamt "+stu+" Stufen erreicht."));
  if(objectp(pl) && pl->QueryProp(P_GUILD_LEVEL) > 10)
    write(sprintf("| %47s |\n", capitalize(wer)+" folgt dem Erbe von "+
          capitalize(explode(ERBMASTER->QueryErbe(lower_case(wer)), "_")[1])+
          "."));
  write(sprintf("%50-'_'s%s\n", "|", "|"));
  write(sprintf("%49-'~'s%s\n", "\\", "\\/"));
}

int cmd_chronik(string str)
{
  string wer, file, *splitted;
  int i, eintritt, stufen, letzte;
  if(sscanf(str, "nach chronik von %s", wer) != 1) return 0;
  if(file_size(LOG(lower_case(wer+".log"))) == -1)
  {
    command("sag So jemanden gibt es in den Chroniken nicht.");
    return -1;
  }	  
  file = read_file(LOG(lower_case(wer+".log")));
  splitted = explode(file, "\n");
  if(sizeof(splitted))
    for(i=0; i<sizeof(splitted); ++i)
      if(explode(lower_case(splitted[i]), ":")[3] == " "+wer+" ist in die gilde eingetreten.") eintritt++;
      else if(explode(lower_case(splitted[i]), ":")[3] == " "+wer+" ist eine stufe aufgestiegen.") stufen++;
      else if(explode(lower_case(splitted[i]), ":")[3] == " "+wer+" hat die hoechste stufe erreicht.") letzte++;

  for(i=0; i<eintritt; ++i) stufen++;
  for(i=0; i<letzte; ++i) stufen++;
  chronik(wer, eintritt, stufen, letzte);
  return 1;
}

void die(int poisondeath)
{
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
