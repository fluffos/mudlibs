inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <class.h>
#include "../zech.h"

int creation_time;
int dur=-1;
object feind;
int total_sp=0;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  creation_time=time();

  SetProp(P_SHORT, "Ein Schnapsgeist");
  SetProp(P_LONG,
    "Der Schnapsgeist sieht aus wie ein kleiner Zipfelzwerg mit einer roten, dicken "
    "Saeufernase. Er ist durchscheinend und torkelt wild und unkontrolliert herum. "
    "Er sieht nicht sonderlich intelligent aus." );
  SetProp(P_NAME, "Schnapsgeist");
  SetProp(P_GENDER, MALE);
  AddId( ({ "geist", "schnapsgeist" }));
  SetProp (P_REJECT,
         ({ REJECT_DROP, "Ein Geist kann nichts nehmen!\n" }) );

  SetProp(P_RACE, "Geist");
  SetProp(P_ALIGN,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_FRIEND, 1);
  SetProp(P_MAX_POISON, 0);
  SetProp(P_TEMPERATURE_RANGE, ([0:-276, 1:500]));
  SetProp(P_NOATTACK, "ruelpst dich nur an.");
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt weit weg");
}

void SetGhost(object caster)
{
  create_default_npc(caster->QueryProp(P_GUILD_LEVEL)*2);
  dur = caster->QueryProp(P_GUILD_LEVEL) * 3 + random(30);
  feind = caster;
  return;
}

void reset()
{
  if (!is_clone(TO)) 
    return; 
  ::reset();
  die();
}

void heart_beat()
{
  ::heart_beat();

  if((time()-creation_time) > dur || QueryProp(P_HP) <= 0)
  {
    if(objectp(feind)) 
    {
      feind->RemovePursuer(TO);
      feind->RemoveDefender(TO);
    }

    die();
  }

  feind->AddDefender(TO);
  feind->AddPursuer(TO);
  return;
}

int QueryDuration()
{
  return creation_time+dur-time();
}

mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{

  if(!ENV(TO)) return 0;
  if (!random(3) && (dam > 50)) 
  {
    tell_object(feind, Name(WER,1) + " schwaecht eine Attacke fuer Dich ab!\n");
    dam -= dam / 4;
    AddHp(-dam / 50);
  }
  return ({dam, dam_type, spell});
}
