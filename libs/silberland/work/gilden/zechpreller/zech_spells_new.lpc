           ]));
  AddSpell("rumkugeln",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:5]), 
	     SI_SKILLRESTR_USE:([P_GUILD_LEVEL:5]),
             SI_SKILLDAMAGE:100,
             OFFSET(SI_SKILLDAMAGE):50,           
	     SI_SKILLDAMAGE_TYPE:({DT_SQUEEZE}),
	     SI_RAW_SPELLCOST:30
           ]));
  AddSpell("staenkern",0,
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:6]), 
             SI_SKILLRESTR_USE:([P_GUILD_LEVEL:6]),
	     SI_SPELLFATIGUE: 4,
	     SI_RAW_SPELLCOST:50
           ]));  
  AddSpell("groehlen", 0, 
           ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:6]), 
  	     SI_SKILLRESTR_USE:([P_GUILD_LEVEL:6]),
	     SI_SPELLFATIGUE: 2,
	     SI_PREPARE_TIME: 2,
             SI_PREPARE_MSG: "Du faengst an zu groehlen ...\n",
             SI_SKILLDAMAGE:50,
             OFFSET(SI_SKILLDAMAGE):50,          
	     SI_SKILLDAMAGE_TYPE:({DT_TERROR, DT_POISON}),
	     SI_RAW_SPELLCOST:30
           ]));
   AddSpell("dunstpanzer", 0,
 	   ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:7]),
	     SI_SKILLRESTR_USE:([P_GUILD_LEVEL:7]),
