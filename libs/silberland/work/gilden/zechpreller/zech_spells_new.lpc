             SI_PREPARE_TIME:3,
             SI_PREPARE_MSG: "Du spuerst die Kraft des Alkohols in Dir aufsteigen ...\n",
	     SI_RAW_SPELLCOST:20
 	     ]));
  AddSpell("alkoholisiere", 0,
	   ([SI_SKILLRESTR_LEARN:([P_GUILD_LEVEL:7]),
