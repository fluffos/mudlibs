/* Hinzufuegen eines neuen Erben */
int AddErben(object ob, string erbe)
{
  if(!objectp(ob)) return 0;
  if(member(erben, getuid(ob))) return -1;
  if(!(erbe == ERBE_LANESTRA ||
       erbe == ERBE_ARTANOK  ||
       erbe == ERBE_ZECHUS   ||
       erbe == ERBE_TARXES   )) return -2;
  /*Security!!!*/
  if(!PO) return -3;
  if(strstr(file_name(PO), "/gilden/") != 0 &&
     member(GILDENMAGIER, getuid(PO)) < 0) return -3;

  erben+=([getuid(ob):erbe]);
  save_object(G11);
  write_file(G11LOG, ctime()+": "+file_name(ob)+" tritt das Erbe von "
	     +erbe+" an.\n");
  return 1;
}

/* Entfernen eines Erben */
int RemoveErben(object pl)
{
  if(!objectp(pl)) return 0;
  if(!member(erben, getuid(pl))) return -1;

  /*Security!!!*/
  if(!PO) return -2;
  if(strstr(file_name(PO), "/gilden/") != 0 &&
     member(GILDENMAGIER, getuid(PO)) < 0) return -2;
  

  erben=m_delete(erben, getuid(pl));
  save_object(G11);
  write_file(G11LOG, ctime()+": "+file_name(pl)+" verliert das Erbe von "
	     +erben[pl]+".\n");
  erben=m_delete(erben, getuid(pl));
  return 1;
}

/* Abfragen aller Erben */
mixed QueryErben()
{
  return m_indices(erben);
}

/* Abfragen eines Erben */
mixed QueryErbe(mixed pl)
{
  if(objectp(pl)) pl = getuid(pl);
  if(!stringp(pl)) return -1;
  if(!member(erben, pl)) return 0;
  return erben[pl];
}

/* Lesbares Erbe */
mixed QueryReadableErbe(mixed pl)
{
  string erbe, *exp;
  if(objectp(pl)) pl = getuid(pl);
  if(!stringp(pl)) return -1;
  if(!member(erben, pl)) return 0;

  erbe = QueryErbe(pl);
  exp  = explode(erbe, "_");
  return exp[1];
}

void Save()
{
  save_object(G11);
}

void Restore()
{
  restore_object(G11);
}
