#include <wizlevels.h>
#include <language.h>
#include <config.h>
#include <new_skills.h>
#include <properties.h>

#include "../zech.h"
#define TG(x) tell_object(find_player("gwenshara"), x+"\n")
#define G11 "/gilden/zechpreller/log/erben"
#define G11LOG "/gilden/zechpreller/log/zechpreller_erbe.log"

mapping erben=([]);
mapping quest=([ERBE_ZECHUS:0, ERBE_ARTANOK:0, ERBE_TARXES:0, ERBE_LANESTRA:0]);

create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));    
  restore_object(G11);
}

query_prevent_shadow() { return 1; }

/*
 * Quest-Mapping:
 * ([
 *    erbe: spieler
 *  ])
 */

/*
 * Erben-Mapping:
 * ([
 *   erbe: object
 *  ])
 */
int StartTimer(string erbe, object wer)
{
  if(quest[erbe] != 0) return -1;
  if(quest[erbe] == wer) return -2;
  /*Security!!!*/
  if(!PO) return -3;
  if(strstr(file_name(PO), "/gilden/") != 0 &&
     member(GILDENMAGIER, getuid(PO)) < 0) return -3;
  if(find_call_out(erbe+"_aufgabe") > -1) return -1;
  call_out(erbe+"_aufgabe", 14400); // 4 Stunden Zeitlimit
  quest[erbe]=wer;
  return 1;      
}

int StopTimer(string erbe)
{
  /*Security!!!*/
  if(!PO) return -3;
  if(strstr(file_name(PO), "/gilden/") != 0 &&
     member(GILDENMAGIER, getuid(PO)) < 0) return -3;
  if(find_call_out(erbe+"_aufgabe") == -1) return -1;
  remove_call_out(erbe+"_aufgabe");
  return 1;
}

void zechprellererbe_zechus_aufgabe()
{
  /*Security!!!*/
  if(!PO) return;
  if(strstr(file_name(PO), "/gilden/") != 0 &&
     member(GILDENMAGIER, getuid(PO)) < 0) return;
  quest[ERBE_ZECHUS]->Message(break_string("Wennscht mein Erbe antreten "
  "willscht, musscht schneller sein! Die Tscheit isch jtscht um!", 78,
  "Zechus teilt Dir mit: "), MSGFLAG_TELL);

  if(present("\nzechpreller_quest_11", quest[ERBE_ZECHUS]))
    present("\nzechpreller_quest_11", quest[ERBE_ZECHUS])->remove(1);
  
  quest[ERBE_ZECHUS]=0;
  return;
}

