#include <wizlevels.h>
#include <language.h>
#include <config.h>
#include <new_skills.h>
#include <properties.h>

#include "../zech.h"
#define TG(x) tell_object(find_player("gwenshara"), x+"\n")
#define GQMASTER "/gilden/zechpreller/log/gildenquestmaster.log"

mapping quester=([]);

create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));    
  restore_object(GQMASTER);
}

query_prevent_shadow() { return 1; }

/*
 * Quester-Mapping:
 * ([
 *   name: 1. Gildenquest; 2. Gildenquest; 3. Gildenquest; 4. Gildenquest
 *  ])
 */

/* Hinzufuegen eines Questers */
int AddQuester(object ob)
{
  if(!objectp(ob)) return 0;
  if(member(quester, getuid(ob))) return -1;

  quester+=([getuid(ob):0;0;0;0]);
  save_object(GQMASTER);
  return 1;
}

/* Entfernen eines Questers */
int RemoveQuester(object pl)
{
  if(!objectp(pl)) return 0;
  if(!member(quester, getuid(pl))) return -1;

  quester=m_delete(quester, getuid(pl));
  save_object(GQMASTER);
  return 1;
}

/* Abfragen aller Quester */
mixed QueryQuester()
{
  return m_indices(quester);
}

/* Abfragen eines Questers */
mixed QueryQuesterEntry(string pl)
{
  if(!member(quester, pl)) return 0;
  return ({quester[pl],quester[pl,1],quester[pl,2],quester[pl,3]});
}

/* Abfragen ob eine Gildenquest geloest wurde */
int QueryQuest(string pl, int quest)
{
  if(!member(quester, pl)) return -1;

  return quester[pl, quest];
}

/* Gildenquest setzen */
int SetQuest(string pl, int quest)
{
  if(!member(quester, pl)) return -1;
  if(quester[pl, quest]) return -2;

  quester[pl, quest]=1;
  save_object(GQMASTER);
  return 1;
}

void Save()
{
  save_object(GQMASTER);
}

void Restore()
{
  restore_object(GQMASTER);
}
