#define TALENTS "/gilden/zechpreller/backup/talents_backup"
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>
#include <language.h>
#include <combat.h>
#include <properties.h>
#include <moving.h>
#include "../zech.h"
#include "../talents.h"

#define BACKUP(x) "/gilden/zechpreller/backup/"+x

nosave mapping players = ([ ]);
nosave mapping lastTalentReset = ([ ]);
mixed saveload;

public void create() {
  seteuid(getuid(this_object()));
  if (restore_object(TALENTS))
  players=saveload;
  saveload=0;
  return;
}

mixed GetSaveLoad()
{
  return saveload;
}

public int DoBackup() {
  saveload=players;
  save_object(TALENTS);
  rm(BACKUP("talents.log"));
  write_file(BACKUP("talents.log"), "Letztes Backup: "+dtime(time())+"\n");
  return 1;
}


public int DoRestore() {
  if(restore_object(TALENTS))
    save_object(TALENTS);
  players = saveload;
  return 1;
}

public int GetTalent(object ob, int talent)
{
  string pl;
  if(!objectp(ob)) return 0;
  
  pl = getuid(ob);

  if(!member(players, pl)) players += ([ pl: ([]) ]);

  return players[pl][talent];
}

public int SetTalent(object ob, int talent, int level) {
  string pl;
  pl = getuid(ob);
  if(!member(players, pl)) players+=([pl: ([])]);

  players[pl][talent] = level;
  DoBackup();
  return GetTalent(ob, talent);
}

public mapping GetAll() {
  return players;
}

public void reset() {
  DoBackup();
  return;
}

varargs public int ResetTalents(object ob, int force) {
  string pl;
  int sacrificed;

  pl = getuid(ob);
  
  /*if(member(lastTalentReset, pl)) {
    if( ( lastTalentReset[pl] - sacrificed) > 0) {
      return lastTalentReset[pl] - sacrificed;
    } else {
      lastTalentReset = m_delete(lastTalentReset, pl);
    }
  }
*/
  
  if(!force && member(lastTalentReset, pl) && lastTalentReset[pl]+2419200 < time()) {
    return -1;
  }
  
  players[pl] = ([]);
  lastTalentReset[pl] = time();
  return 0;
}

public int GetLastTalentReset(string uid) {
  return lastTalentReset[uid];
}