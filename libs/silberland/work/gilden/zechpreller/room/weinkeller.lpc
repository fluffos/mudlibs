#include <properties.h>
#include <rooms.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include "../zech.h"


inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Weinkeller der Zechpreller");
  SetProp(P_INT_LONG,
    "Ueberall Fesser... Hier lagern alle Metfaesser");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "deckel","schild" }),
    "Du kannst das Schild lesen.");

  AddSpecialDetail( ({ "" }),
    "detail_fun");

  AddReadDetail( ({ "deckel", "schild" }),
    "    -------\n"
    "  /         \\\n"
    " |  KRONIST  |\n"
    "  \\         /\n"
    "    -------\n");
 
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage(
    ({""}),30,"func");

//--Kommandos--------------------------------------------------------------

 // AddCmd( ({ "oeffne", "oeffnen" }), "cmd_fass" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "oben", "/gilden/zechpreller" );
  AddExit( "norden", ROOM("ausstatter"));

//--Items & NPCs-----------------------------------------------------------
  NewDoor( "westen", ROOM("chronist"), "tuer",
          ({ D_NAME,"Tuer",
             D_GENDER,NEUTER,
             D_SHORT,"Eine kleine %sene Tuer.",
             D_LONG, BS("Eine kleine Holztuer im Westen fuehrt Dich tiefer in "
		        "den Keller der Zechpreller. Der Deckel eines Fasses "
			"wurde als Schild an sie genagelt.")
          }) );

}

//--Funktionen fuer Kommandos----------------------------------------------
