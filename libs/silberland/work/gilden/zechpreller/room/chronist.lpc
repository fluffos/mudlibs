#include <properties.h>
#include <rooms.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include "../zech.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Archiv der Zechpreller");
  SetProp(P_INT_LONG,
    "Eine Bibliothek haettest Du in der Gilde der Zechpreller nicht erwartet. "
    "Eigentlich handelt es sich ja auch nicht um eine Bibliothek im "
    "herkoemmlichen Sinne - Es ist eher das, was die Zechpreller unter einer "
    "Bibliothek verstehen. An den Waenden sind riesige Regale mit allerlei "
    "leeren und vollen Flaschen befaestigt. Der Geruch von schalem Bier und "
    "saurem Wein betaeubt Deine Sinne. Ja - So muessen sich Zechpreller "
    "eine Bibliothek vorstellen! Es gibt sogar etwas wie einen Tisch in dem Raum, "
    "an dem man die alten Schriften der Zechpreller studieren kann.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "bibliothek", "flaschensammlung" }),
    "Das hast Du hier unten wirklich nicht erwartet. Aber eigentlich ist es "
    "ja auch keine Bibliothek sondern mehr eine Flaschensammlung.");

  AddDetail( ({ "gilde", "zechpreller", "haus", "gildenhaus" }),
    "Du bist hier unter dem Gildenhaus der Zechpreller.");

  AddDetail( ({ "sinne" }),
    "Einerseits ist dies keine Bibliothek im herkoemmlichen Sinne, andererseits "
    "sind Deine Sinne schon mehr als betaeubt.");

  AddDetail( ({ "waende", "steinwaende" }),
    "An den Steinwaenden wurden riesige Weinregale befestigt, die fast komplett "
    "mit Flaschen gefuellt sind.");

  AddDetail( ({ "regale", "weinregale" }),
    "Die riesigen Weinregale sind aus echter Silberwaeldereiche gezimmert und "
    "haben daher ihre dunkle Faerbung. Jedes Regal ist mit einer Unzahl an "
    "noch vollen und leeren Flaschen gefuellt.");

  AddDetail( ({ "flaschen" }),
    "Du betrachtest die Flaschen genauer und stellst fest, dass in den vollen Weinfalschen "
    "richtige gute Jahrgaenge darauf warten entkorkt zu werden. Die Flaschen, die Du "
    "vorhin fuer leer gehalten hast, beherbergen Pergamentrollen.");

  AddDetail( ({ "bier", "wein" }),
    "Nicht nur der Geruch von Bier und Wein ist hier zu finden, auch etliche Flecken "
    "verschiedenster Farben deuten darauf hin, dass hier oefters einer gehoben wird.");

  AddDetail( ({ "tisch", "konstruktion", "fass" }),
    "Der 'Tisch' ist eine wackelige Konstruktion aus einem leeren Fass und einer "
    "darauf genagelten Holzplatte.");

  AddDetail( ({ "schriften", "aufzeichnungen" }),
    "Es heisst hier waeren die aeltesten Geheimnisse der Zechpreller versammelt. Es hat "
    "Jahre gedauert sie aus allen Regionen des Silberlandes hier zusammen zu tragen.");

  AddDetail( ({ "eiche", "silberwaeldereiche", "eichen", "silberwald", "silberwaldes",
	        "resistenz", "alkoholresistenz" }),
    "Die Eichen des Silberwaldes sind fuer ihre Alkoholresistenz beruehmt.");

  AddDetail( ({ "faerbung" }),
    "Die dunkle Faerbung der Regale kommt wohl nicht allein von den Eichen.");

  AddDetail( ({ "unzahl", "menge" }),
    "Jede Menge kleiner und grosser Flaschen stehen in den Regalen.");

  AddDetail( ({ "weinflaschen", "wein", "jahrgaenge" }),
    "Ob sich im Wein alkomagische Aufzeichnungen befinden?");

  AddDetail( ({ "rollen", "pergament", "pergamentrollen" }),
    "Diese Pergamentrollen enthalten scheinbar das gesamte Wissen der Zechpreller. "
    "Es sind ihre geheimen Schriften und Chroniken.");

  AddDetail( ({ "flecken" }),
    "Du willst gar nicht genauer wissen, was das fuer Flecken sind...");

  AddDetail( ({ "farben", "rot", "braun", "gruen", "gelb" }),
    "Rot, Braun, Gruen, Gelb - echt ekelhaft!");

  AddDetail( ({ "plate", "holzplatte" }),
    "Die alte Holzplatte ist mit vielen Kratzern versehen - richtig kunstvoll!");

  AddDetail( ({ "geheimnisse", "wissen" }),
    "Aufschriften, wie 'Tausendjaehriger Bier- und Weinalmanach', "
    "'Die Kunst des rechten Ruelpsers' oder 'Codex Alcomagica Maxima' verkuenden "
    "die Bedeutung des Inhaltes auf den Flaschen. Uneingeweihte werden die "
    "mystischen Schriften vermutlich nicht verstehen.");

  AddSpecialDetail( ({ "" }),
    "detail_fun");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage(
    ({""}),30,"func");

//--Kommandos--------------------------------------------------------------

//  AddCmd( ({ "such", "suche" }), "cmd_suchen" );

//--Ausgaenge--------------------------------------------------------------

    NewDoor( "osten", ROOM("weinkeller"), "tuer",
          ({ D_NAME,"Tuer",
             D_GENDER,NEUTER,
             D_SHORT,"Eine kleine %sene Tuer.",
             D_LONG, BS("Eine kleine Holztuer im Westen fuehrt Dich aus "
		        "Archiv hinaus in den Weinkeller.")
          }) );

//--Items & NPCs-----------------------------------------------------------

  AddItem( NPC("jack") , REFRESH_DESTRUCT);
}
