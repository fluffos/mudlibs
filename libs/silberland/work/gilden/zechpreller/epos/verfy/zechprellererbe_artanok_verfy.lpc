#include "../../zech.h"
#include <properties.h>

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Artanoks Trinkamulett");
  SetProp(P_LONG,
    "Das Amulett hat die Form eines Bierhumpens. Es heisst, wer es traegt "
    "koenne unendlich viel Alkohol trinken! Der Zechprellergruender Artanok "
    "suchte es auf seinen Reisen und entriss es dem alten Elsurion.");

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Trinkamulett");
  SetProp(P_GENDER, FEMALE);
  AddId( ({GQID+"artanok", "amulett", "trinkamulett", GQID}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
}
