#include "../../zech.h"
#include <properties.h>

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Tarxes schwarzes Kriegshorn");
  SetProp(P_LONG,
    "Das Horn war ein Mal Teil eines maechtigen schwarzen Drachen. Der "
    "Zechprellergruender Tarxes schlug es ihm ab und es wurde ein Zeichen "
    "seiner Macht.");

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Kriegshorn");
  SetProp(P_GENDER, NEUTER);
  AddId( ({GQID+"tarxes", "gegenstand", GQID, "horn", "kriegshorn"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
}
