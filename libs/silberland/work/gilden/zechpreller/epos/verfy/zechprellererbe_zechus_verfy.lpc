#include "../../zech.h"
#include <properties.h>

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Der original Siebzehner");
  SetProp(P_LONG,
    "Da haengt er! An einem unscheinbaren Lederband haengt eines der "
    "groessten Relikte der Zechpreller: Der urspruengliche Siebzehner! "
    "Mit ihm hat Zechus Prellus den Alkohol unterworfen und den Weingeist "
    "geschaffen!");

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Siebzehner");
  SetProp(P_GENDER, FEMALE);
  AddId( ({GQID+"zechus", "siebzehner", "zehner", GQID}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
}
