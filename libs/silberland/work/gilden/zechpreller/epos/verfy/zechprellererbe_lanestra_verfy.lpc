#include "../../zech.h"
#include <properties.h>

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Lanestras Eismuschel");
  SetProp(P_LONG,
    "Diese Muschel ist eiskalt und schneeweiss. Du weisst, sie ist aus "
    "purer Kaelte geformt. Es heisst Lanestra, die Gildengruenderin der "
    "Zechpreller haette mit ihr magische Trinklieder erzeugt.");

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Eismuschel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({GQID+"lanestra", "muschel", "eismuschel", GQID}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_ICE );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
}
