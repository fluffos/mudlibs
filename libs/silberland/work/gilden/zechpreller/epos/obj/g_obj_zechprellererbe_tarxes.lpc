#include "/gilden/zechpreller/zech.h"
#include <properties.h>

inherit "/gilden/zechpreller/epos/obj/std_epic_item";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein mystisches Trinkhornamulett");
  SetProp(P_LONG,
    "An einer Lederschnur haengt das mystische Amulett der Erben des "
    "Zechprellergruenders Tarxes. Es ist eine perfekte Nachbildung des "
    "Trinkhrons, das der Zwergenzechpreller einst als Geschenk bekam und "
    "ermoeglicht es Dir den Alkohol in Bahnen zu lenken.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Trinkhornamulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"trinkhorn", "trinkhornamulett", EPIC_ITEM, "amulett"}) );

  SetProp(P_NAME_ADJ, "mystisch" );
  AddAdjective( ({"mystischen","mystischer","mystischem","mystisches",
		  "mystische"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER:20, MAT_HORN:60, MAT_ALCOHOL:10]) );
}
