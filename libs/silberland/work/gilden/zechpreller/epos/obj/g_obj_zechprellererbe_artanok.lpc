#include "/gilden/zechpreller/zech.h"
#include <properties.h>

inherit "/gilden/zechpreller/epos/obj/std_epic_item";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Trinkeramulett");
  SetProp(P_LONG,
    "An einer Lederschnur haengt das mystische Amulett der Erben des "
    "Zechprellergruenders Artanok. Es ist die Nachbildung des alten "
    "Trinkamuletts, stellt also einen ueberschaeumenden Bierkrug dar.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Trinkeramulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"trinkeramulett", EPIC_ITEM, "amulett"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER:20, MAT_MITHRIL:60, MAT_ALCOHOL:10]) );
}
