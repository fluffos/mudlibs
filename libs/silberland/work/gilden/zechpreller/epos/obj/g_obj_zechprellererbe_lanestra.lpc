#include "/gilden/zechpreller/zech.h"
#include <properties.h>

inherit "/gilden/zechpreller/epos/obj/std_epic_item";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Amulett von Lanestras Erben");
  SetProp(P_LONG,
    "An einer Lederschnur haengt eine kleine Glasphiole, in der ein Stueck "
    "der Notenblaetter der Zechprellergruenderin Lanestra in Alkohol eingelegt "
    "wurde. Mit dies hochmagischen Amulett kannst Du Die Kraefte des Alkohols "
    "steuern.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Notenblatt");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", "erbamulett", EPIC_ITEM}) );
//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER:20, MAT_GLASS:20, MAT_PERGAMENT:30, 
		        MAT_ALCOHOL:30]) );
}
