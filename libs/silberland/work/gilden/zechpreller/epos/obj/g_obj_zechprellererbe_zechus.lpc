#include "/gilden/zechpreller/zech.h"
#include <properties.h>

inherit "/gilden/zechpreller/epos/obj/std_epic_item";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein maechtiger Siebzehnerschluessel");
  SetProp(P_LONG, QueryProp(P_LONG)+" Dieses Exemplar ist von starker, "
          "alkomagischer Macht durchdrungen!");

//--Namen------------------------------------------------------------------

  SetProp(P_GENDER, MALE);

  SetProp(P_NAME_ADJ, "maechtig" );
  AddAdjective( ({"maechtier","maechtig","maechtigem","maechtiges",
		  "maechtigen"}) );
}
