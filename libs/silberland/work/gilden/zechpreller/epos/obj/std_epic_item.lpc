#include "/gilden/zechpreller/zech.h"
#include <properties.h>
#include <wizlevels.h>

inherit "/gilden/zechpreller/obj/z_17erschluessel";

int macht;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  macht            = 0;

  AddCmd( ({"alkoholmacht"}), "cmd_macht");
}

int zupdate()
{
  object schluessel;
  if(!objectp(owner))
  {
    write("Dafuer muss der Report aktiviert sein!\n");
    return -1;
  }
  
  schluessel = clone_object(explode(file_name(TO), "#")[0]);
  tell_object(owner, break_string("Hier hascht einen neuen Siebzehnerschluessel!",
	      78, "Zechus teilt Dir mit: "));
  TO->DoUnwear();
  schluessel->move(owner);
  schluessel->DoWear();
  schluessel->SetPartyTime(next_party);
  schluessel->SetMacht(macht);
  TO->remove();
  return 1;
}

int GetMacht()
{
  return macht;
}

void SetMacht(int i)
{
  macht = i;
  return 0;
}

int cmd_macht(string str)
{
  object target;
  notify_fail("Du musscht noch warten!\n");
  if(macht-time()>0) return 0;

  if(!str || str == "")
  {
    write(BS("Du fluesterst die Worte der alten Zechpreller und spuerst "
	  "wie der Alkoholgehalt Deines Blutes steigt."));
    say(BS(TPN+" lallt leise Worte."));
    TP->SetProp(P_ALCOHOL, TP->QueryProp(P_MAX_ALCOHOL));
  }	  
  else
  {
    notify_fail("Der isch ja gar ned da!\n");
    if(!objectp(target=present(str, ENV(TP)))) return 0;
    if(!IsZechpreller(target) || IS_WIZARD(target))
    {
      write(BS("Dasch kannscht nur bei anderen Zechprellern machen!"));
      return -1;
    }
    write(BS("Du fluesterst die Worte der alten Zechpreller und deutest auf "
	  +target->Name(WEN)+"."));
    say(BS(TPN+" lallt leise Worte und deutet auf "+target->Name(WEN)+"."), 
	target);
    tell_object(target, BS(TPN+" lallt leise Worte und deutet auf Dich. "
		"Du spuerst den Alkoholgehalt Deines Blutes steigen."));
    target->SetProp(P_ALCOHOL, target->QueryProp(P_MAX_ALCOHOL));
  }

  macht = time()+86400; // 24 Stunden Pause
  return 1;
}
