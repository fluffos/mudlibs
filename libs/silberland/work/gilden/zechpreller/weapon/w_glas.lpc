#include <properties.h>
#include <npc.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include <material.h>
#include "../zech.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Glas Whiskey");
  SetProp(P_LONG,
    "Ein mit Whiskey gefuelltes Kristallglas.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Whiskeyglas");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"glas", "whiskeyglas", "\nzechpreller_weapon"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CRYSTAL:80, MAT_ALCOHOL:20]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_POISON}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["\nzechpreller_chronist": 100]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_CON:23]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Waehrend dem Kampf koennte man schon ein paar Schluck davon nehmen..."));
}


int HitFunc( object enemy ) 
{
  int alc, max_alc;
  object o;
  o = ENV(TO);
  alc = o->QueryProp(P_ALCOHOL);
  max_alc = o->QueryProp(P_MAX_ALCOHOL);

  if(alc < max_alc && !random(20))
  {
    alc+=10;
    if(alc > max_alc) alc = max_alc;
    o->SetProp(P_ALCOHOL, alc);
    tell_object(o, BS("Du nimmst einen Schluck aus dem Glas."));
  }
  return 0;
}
