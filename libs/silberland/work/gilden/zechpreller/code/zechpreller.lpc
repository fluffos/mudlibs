    ]));

 SetProp(P_GUILD_MALE_TITLES,
     ([1 : "der Safttrinker",
       2 : "der Weintrinker",
       3 : "der Starkbiertrinker",
       4 : "der Schnapstrinker",
       5 : "der Schluckspecht",
       6 : "die Schnapsleiche",
