/* Ausgabe in der P_INT_LONG */
string maghelp()
{
 if(!IS_LORD(TP)) return "";
 return "\nMagInfo: Hilfe fuer Magierbefehle mit 'gilde hilfe'.";
}

int magfunc(string str)
{
  //nur Gildenmagier und R+ dürfen
  if(!(IS_LORD(TP) || member(GILDENMAGIER, getuid(TP)))) return 0;
  if(!str) str="hilfe";
  if(str=="hilfe") {
   write("Folgende Befehle sind moeglich:\n"
        +"gilde hilfe  : Dieses hier\n"
        +"gilde backup : Backup des Memberfiles (Arch-only)\n"
        +"gilde restore: Zurueckspielen des Backups (Arch-only)\n"
        +"gilde toplist: Updaten der Topliste\n");
   return 1;
  }
  if(str=="backup" && IS_ARCH(TP)) {
    call_other(ZECHMASTER, "DoBackup"); 
    tell_object(TP, "Kopiere members/members.o nach "
             +"backup/members_backup.o\n");
    return 1;
  }
  if(str=="restore" && IS_ARCH(TP)) {
    if(call_other(ZECHMASTER, "DoRestore")==-2){
      tell_object(TP, "Fehler! Members.o konnte nicht restored "
                 +"werden!\n");
      return 1;
    } 
    tell_object(TP, "Kopiere backup/members_backup.o nach "
                 +"members/members.o\n");
    return 1;
  }
  if(str=="toplist") {
    call_other(ZECHMASTER, "UpdateMemberLevels");
    call_other(ZECHMASTER, "UpdateTopList");
    call_other(ZECHMASTER, "MakeReadList");
    call_other(ZECHMASTER, "SetNumberOne");
    tell_object(TP, "Memberliste ist nun up-to-date.\n");
    return 1;
  }
 tell_object(TP, "Befehl nicht moeglich!\n");
 return 1;
}


/* Bestenliste */
string liste()
{
 TP->More("\nDIE BESTEN SAEUFER:\n"+read_file(REALTOPLIST));
 tell_room(TO, BS(sprintf("%s schaut sich die Liste genauer an.", 
           TP->Name(WER))), ({TP}));
 return "";
}

/* Backup der Memberliste */
reset()
{
  ::reset();
  zaehler++;
  if(zaehler==1) {
    call_other(ZECHMASTER, "UpdateTopList");
    call_other(ZECHMASTER, "MakeReadList");
    call_other(ZECHMASTER, "SetNumberOne");
  }
  if(zaehler==5) {
    call_other(ZECHMASTER, "DoBackup"); 
    zaehler=0;
  }
}

/* Skillablilty am Anfang in einen Bereich 2000..4000 setzen */
nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if(value<2000) value=2000;
  else if(value>4000) value=4000;
  return value;
}


int GuildRating(object pl)
{
    return pl->SetProp(P_GUILD_RATING,
              ::GuildRating(pl)*4/5);
}


/* So gehts nicht :> */
int falscher_syntax()
{
  if(!present("zechus", TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nix!\n"));
    return 1;
  }
  write(BSA("Du muscht mich schon fragen oder <Hicks!> einfach "
           +"'tritt gilde bei' eingeben. So isch dasch, jaja...",
            "Zechus lallt Dir ins Ohr: "));
  return 1;
}

/* Austritt aus der Gilde */
int austreten()
{
  object ob;
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  }      
  if(TP->QueryProp(P_GUILD) != "zechpreller")
  {
    write(BS("Das geht wohl nur als Zechpreller."));
    return 1;
  }
  
  this_player()->SetProp( P_GUILD_LEVEL, 0);
  WLOG("/log/gilden/zechpreller", " tritt aus der Gilde aus");
  write(BSA("WAAAAAAAASCH! Du willscht nuechtern werden. Hau blossch ab...", 
      "Zechus lallt: "));
  say(BSA("WAAAAAAASCH, Du willscht nuechtern werden, "+CAP(getuid(TP))+"? "
     +"Hau blossch ab!", "Zechus lallt: "));

  /* Gildenitems entfernen */
  if(ob=present(GILDENOBJ,TP)) 
    ob->remove();
  if(ob=present("\nzechpreller_task_item", TP))
    ob->remove(1);

  /* Entries aus dem Master entfernen */
  call_other(ZECHMASTER, "DeleteMember", TP);
  call_other(ZECHMASTER, "DeleteTopEntry", getuid(TP));

  /* Channeling */
  Channel(CAP(getuid(TP))+" "+msg_out[random(sizeof(msg_out))]);

  TP->SetProp(P_ALCOHOL, 0);
  return ::austreten();
}

/* Gildenbeitritt */
int tritt(string str)
{
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  } 
  if(str!="gilde bei" && str!="zechpreller bei") return 0;

  beitreten();  
  return 1;
}
 

/* Eigentliche Beitrittsfunktion, wird von tritt() aufgerufen */
int beitreten()
{
  int b;
  object ob;
  string restr;
  if(IsGuildMember(TP)) {
     write(BSA("Aber hey, du <Hicks!> bischt ja schon einer "
              +"von unsch ... hehe!", "Zechus lallt: "));
     return 1;
    }
  restr=call_other(RES_CHECKER, "check_restrictions", TP,
      QueryProp(P_GUILD_RESTRICTIONS));
  if(stringp(restr))
  {
    tell_room(ENV(TP), 
     BSA(sprintf("Du kannscht unsch Saeu^H^H^H^H"
        "Alkoholgeniessern noch nicht beitreten, %s! %s\n", 
        TP->Name(WER), restr), 
        "Zechus lallt: "));
    return 1;
  }

  if((b = ::beitreten()) < 0) return 1;
  write(BSA("Na alscho. Hier, trink gleich mal einen Schnapsch. Du "
           +"kriegscht <Hick!> einen Siebschenerschluesschel von mir, "
           +"damit jeder *ruelps* - ups, 'schulligung - wo war ich ... "
           +"*gruebel* ah ja! Alscho, den kriegscht, damit jeder weisch, "
           +"dasch du tschu uns gehoerscht. Ausscherdem kannscht Du die "
           +"Zauber mit 'lerne' lernen, und Du kannsscht mich nach "
           +"'Fertigkeiten' fragen. "
           +"Allesch ok?\n", 
            "Zechus lallt: "));
  say(BSA("Na alscho. Hier, trink gleich mal einen Schnapsch. Du "+
           "kriegscht <Hick!> einen Siebschenerschluesschel von mir, "+
           "damit jeder *ruelps* - ups, 'schulligung - wo war ich ... "+
           "*gruebel* ah ja! Alscho, den kriegscht, damit jeder weisch, "+
           "dasch du tschu uns gehoerscht. Allesch ok?\n",
            "Zechus lallt zu "+CAP(getuid(TP))+": "));
  write(BS("Zechus gibt Dir einen Bieroeffner.\n"));
  say(BS("Zechus gib "+CAP(getuid(TP))+" einen Bieroeffner.\n"));

  /* Gildenobjekt uebergeben */
  ob=clone_object(OBJ("z_17erschluessel"));
  ob->move(TP, M_NOCHECK);
  
  /* In den Master eintragen */
  call_other(ZECHMASTER, "AddMember", this_player());
  
  write(BSA("PROSCHT und willkommen!", "Zechus lallt erfreut: "));
  say(BSA("PROSCHT und willkommen, "+CAP(getuid(TP))+"!\n"
         , "Zechus lallt erfreut: "));
  /*
  say(BS("Zechus Prellus gibt "+CAP(getuid(TP))+" ein Pergament.\n"));
  write(BS("Zechus Prellus gibt Dir ein Pergament."));
  ob=clone_object(OBJ("pergament"));
  ob->move(TP, M_NOCHECK);   
  */
  
  WLOG("/log/gilden/zechpreller", "tritt in die Gilde ein.\n");
  //call_other(ZECHMASTER, "AddMember", this_player()); - Wozu 2 mal?!
  //tell_angrox("AddMember Ok!\n");

  /* Gildenskill eintragen */
  TP->ModifySkill(SK_BOOZE,QuerySkill(SK_BOOZE),0, "zechpreller" );
  
  //tell_angrox("SetSkill ok!\n");
  write_file(LOG(getuid(TP)+".log"),
             dtime(time())+": "+CAP(getuid(TP))+" ist "
             +"in die Gilde eingetreten.\n");
  //tell_angrox("Log ok!\n");
  Channel(CAP(getuid(TP))+" "+msg_in[random(sizeof(msg_in))]);
  //tell_angrox("Alles ok!\n");
  
  /* Master updaten */
  call_other(ZECHMASTER, "UpdateMemberLevels"); 
  call_other(ZECHMASTER, "SetXp",TP, TP->QueryProp(P_XP)+LVL_XP[0]);
  return b;
}

/* Aufstieg */
advance(string str)
{
  mixed b;
  string restr;
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  }   
  notify_fail(BSA("Nur die Sschtufe der Zechpreller, okeee?.", 
    "Zechus lallt: "));
  if(!str || !IsGuildMember(TP)) return 0;
  if(str=="stufe" || str2attr(str))
     return 0;
  if(str=="gildenstufe" || str=="gilde") {
    LevelText(TP);
    if(TP->QueryProp(P_GUILD_LEVEL)>=MAX_GUILD_LEVEL &&
       !TP->QueryProp(P_TESTPLAYER)) {
      write(BSA("Weiter getsch net!!!\n", 
		    "Zechus lallt: "));
      say(BSA("Weiter getsch nimmer, "
	      +CAP(getuid(TP))+".\n", "Zechus lallt: "));
      return 1;
    }
    else if(TP->QueryProp(P_GUILD_LEVEL)>=10) {
      write(BSA("Weiter getsch net!!!\n", 
		    "Zechus lallt: "));
      say(BSA("Weiter getsch nimmer, "
	      +CAP(getuid(TP))+".\n", "Zechus lallt: "));
      return 1;
    }
    if((restr=call_other(RES_CHECKER, "check_restrictions", TP,
          QueryProp(P_GUILD_LEVELS)[TP->QueryProp(P_GUILD_LEVEL)+1]))!=0 &&
        restr!="0")
    {
      tell_room(ENV(TP), BSA(sprintf("Du erfuellst nicht alle Anforderungen, "
        +"um aufsteigen zu koennen, %s! %s\n", TP->Name(WER), restr), 
        "Zechus lallt: "));
      return 1;
    }

    b=::advance();

    call_other(ZECHMASTER, "SetXp", TP, 
        (TP->QueryProp(P_XP)+LVL_XP[TP->QueryProp(P_GUILD_LEVEL)-1]));      

    if(b) {
      if(TP->QueryProp(P_GUILD_LEVEL)>MAX_GUILD_LEVEL-1) {
	write(BSA("Schupa! Endlich hascht es g'schafft!\n",
		  "Zechus lallt: "));
	say(BSA("Schupa! Endlich hascht es g'schafft, "+
		CAP(getuid(TP))+".\n", "Zechus lallt: "));
	write_file(LOG(getuid(TP)+".log"),
		   dtime(time())+": "+CAP(getuid(TP))+" hat "
		   +"die hoechste Stufe erreicht.\n");    
	Channel(CAP(getuid(TP))+" hat bei den Zechprellern "
		+"die Vollendung des Suffs erreicht!");
  call_other(ZECHMASTER, "UpdateMemberLevels"); 
	return b;
      }
      write(BSA("Gratuliere!!\n", "Zechus spricht erstaunlich klar: "));
      say(BSA("Gratuliere, "+CAP(getuid(TP))+".\n",
              "Zechus spricht erstaunlich klar: "));     
      write_file(LOG(getuid(TP)+".log"),
		 dtime(time())+": "+CAP(getuid(TP))+" ist "
		 +"eine Stufe aufgestiegen.\n"); 
      Channel(CAP(getuid(TP))+" "+sprintf(msg_up[random(sizeof(msg_up))], 
	      TP->QueryProp(P_GUILD_LEVEL)));
      call_other(ZECHMASTER, "UpdateMemberLevels"); 
      return b;
    }

  }
  return b;
}

/* Spells lernen */
OwnLearnSpell(string str)
{
 
  if(!present(GILDENNPC, TO)) {
     write(BS("Ohne Zechus laeuft hier gar nichts!\n"));
     return 1;
  }   
  if(!IsGuildMember(TP))
  {
    write(BSA("Verschwind!!! Du bischt keiner von unsch!!!\n", 
       "Zechus groehlt: "));
    return 1;
  }
  notify_fail("Was moechtest Du hier lernen?\n");
  if(!str)
  {
    write(BSA("Wasch magscht lernen? Esch gaebe da (Stufe in Klammern) "
              "Prelle (1), Identifiziere (1), Schaetz (2), "
              "Ruelpser (2), Uebergeben (3), Destilliere (4), "
              "Anhauchen (4), Rumkugeln (5), Staenkern (6) und "
              "Groehlen (6).",
	      "Zechus fragt Dich: ")); 
    say(BSA("Wasch magscht lernen? Esch gaebe da (Stufe in Klammern): "
              "Prelle (1), Identifiziere (1), Schaetz (2), "
              "Ruelpser (2), Uebergeben (3), Destilliere (4), "
              "Anhauchen (4), Rumkugeln (5), Staenkern (6), "
              "Groehlen (6)",
         "Zechus fragt "+CAP(getuid(TP))+": "));
    return 1;
  }
    
  return LearnSpell(str);
}


/*
//
// Senden auf dem Channel info
//
*/
nosave void Channel(string msg)
{
    //if(!interactive(previous_object()))
	// return;
    call_other(CHMASTER, "join","Info", this_object());
    call_other(CHMASTER, "send", "Info", TO, msg, MSG_SAY);
}


/*
//
// Ausgabe der Fertigkeiten
//
*/
int faehigkeiten()
{
  int i, wert;
  string *arm, s;
  mapping res;
  
  if(IS_WIZARD(this_player()))
  {
    write(BSA("Deine Skills: ", "Zechus sagt: "));
    s="";
    res = this_player()->QueryProp(P_NEWSKILLS);
    arm=sort_array(m_indices(res), #'<); //')
    for (i = sizeof(arm)-1;i>=0;i--)
    {
      s += arm[i]+": ";
      if (mappingp(res[arm[i]])) s += res[arm[i]][SI_SKILLABILITY];
      else s += res[arm[i]];
      s += "\n";
      write(BSA(s, "Zechus sagt: "));
      s="";
    }
   return 1;   
  }
  if(!IsGuildMember(TP))
    {
     write(BSA("Verschwind!!!\n", "Zechus lallt: "));
     return 1;
    }
  write(BSA("Dasch kannscht Du: ", "Zechus lallt: "));
  s="";
  res=this_player()->QueryProp(P_NEWSKILLS);
  arm=sort_array(m_indices(res), #'<); //')
  for (i = sizeof(arm)-1;i>=0;i--)
   {
    if(arm[i]!="Booze")
     {
      s += CAP(arm[i])+" kannscht Du";
      wert=TP->QuerySkillAbility(arm[i]);   
      s+=int2string(wert);
      write(BSA(s, "Zechus lallt: "));
      s="";         
     }
   }   
 s=int2string(TP->QuerySkillAbility("Booze"));
 write(BSA("Und Allohol vertraegscht Du"+s,"Zechus lallt: "));
 if((wert=TP->QueryProp(P_GUILD_RATING))<1501) wert=1501;
 s=int2string(wert);
 write(BSA("Inschgeschamt betrachtet bist Du"+s, "Zechus lallt: ")); 
 say(sprintf("Zechus klaert %s ueber %se Fertigkeiten auf.\n", CAP(getuid(TP)), 
      TP->QueryPossPronoun(WESSEN)));
return 1;
}

/* Fertigkeitswert in entsprechende Ausgabe umwandeln */
string int2string(int wert)
{
 string str;
 switch(wert) 
       {
	case 0..500 : str=" scho gut wie gar nicht.\n";
                        break;
	case 501..1000: str=" fast gar *ruelps* nicht.\n"; 
                        break;
	case 1001..1500: str=" kaum.\n";
                        break;
	case 1501..2000: str=" schehr miserabel.\n";
                        break;
	case 2001..2500: str=" mischerabel.\n";
                        break;
	case 2501..3000: str=" ziemlich schlecht.\n";
                        break;
	case 3001..3500: str=" schlecht, gaaaanz schlecht.\n";
                        break;
	case 3501..4000: str=" maesschig.\n";
                        break;
	case 4001..4500: str=" unterdurchschnittililich oder wie dasch "
                            +"heisst.\n";
                        break;
	case 4501..5000: str=" durchschnittlich.\n";
                        break;
	case 5001..5500: str=" ueberdurchschnittillich.\n";
                        break;
        case 5501..6000: str=" gut. <HICKs>.\n";
                        break;
        case 6001..6500: str=" wirklich *ruelps* gut.\n";
                        break;
        case 6501..7000: str=" schehr gut.\n";
                        break;
        case 7001..7500: str=" ungllllaublich guttt.\n";
                        break;
        case 7501..8000: str=" phantastisch gut.\n";
                        break;
        case 8001..8500: str=" ausgetscheichnet.\n";
                        break;
        case 8501..9000: str=" hervorragend.\n";
                        break;
        case 9001..9500: str=" meischterhaft.\n";
                        break;
        case 9501..9999: str=" nahetschu perfekt.\n";
                        break;
        case 10000: str=" abscholut perfekt.\n";
                        break;
        default: str=" ueberhaupt nicht, du SCHTUEMPER!\n";
       } 
return str;
}




/*
//
// Funktion fuers Saufen
//
*/

void LearnBooze(object user, mapping sinfo, int alc)
{
  int abil, max, max_alc;
  abil=sinfo[SI_SKILLABILITY];
  max_alc=user->QueryProp(P_MAX_ALCOHOL);
  abil+=1+random((int)(alc/15));
  max=MAX_ABILITY-200*(6-user->QueryProp(P_GUILD_LEVEL));
  if(abil>max) abil=max;
  user->ModifySkill( SK_BOOZE, abil);
}

int Saufen(object user, string sname, mapping sinfo)
{
 
  int val, abil;
  if(!sinfo || (val=sinfo[SI_SKILLARG]) <0 ) return 0;
  abil=sinfo[SI_SKILLABILITY];
  val+=(val*abil)/(MAX_ABILITY+5000);
  if(val<0) val=0;
  abil=user->QueryProp(P_ALCOHOL);
  if(!random(8))
    LearnBooze(user, sinfo, abil);
  return val;
}

/*
//
// Ausgabe beim Levelaufstieg
//
*/
void LevelText(object pl)
{
 write(BS("Du fragst Zechus ob Du aufsteigen darfst.\n"));
 say(BS(CAP(getuid(pl))+ " fragt Zechus etwas...\n"));
 return ;
}



/*
//
// Ausgabe beim Levelaufstieg
//
*/
string NeedMoreXP(object pl, int xp)
{
 string str;
 int percent, x;
 
 str="Du brauchscht mehr Erfah ... <HICKs> ... rung. "
     +"Von den Erfahrungspunkten, die Du benoetigst, fehlen Dir ";
 x=call_other(ZECHMASTER, "GetXpDifference", pl, 
              pl->QueryProp(P_XP));
 percent=100*x/xp;
 //write("\n"+percent+"\n");
 switch (percent)
  {
    case  0..10:  str+="nur mehr ganz wenige.";     break;
    case 11..20:  str+="weniger als ein Viertel.";  break;
    case 21..30:  str+="etwa ein Viertel.";         break;
    case 31..40:  str+="weniger als die Haelfte.";  break;
    case 41..50:  str+="etwa die Haelfte.";         break;
    case 51..60:  str+="mehr als die Haelfte.";     break;
    case 61..70:  str+="weniger als drei Viertel."; break;
    case 71..80:  str+="etwa drei Viertel.";         break;
    case 81..90:  str+="mehr als drei Viertel.";    break;
    case 91..99 : str+="beinahe alle.";             break;
    case 100    : str+="alle.";                     break;
    default:      str+="viel mehr als gefordert.";  break; 
  }
  if (IS_WIZARD(TP) || TP->QueryProp(P_TESTPLAYER))
   str+=" ("+x+")";

 return str;
}


/*
//
// Aufgaben: ALK und XP! 
//
*/
string Test(object pl)
{  
  int req_alc, alc, max_alc,lvl,flag;
  string retstring,restr;
  flag=0;
  if(pl->QueryProp(P_FROG)) 
      return BSA("Ein Frosssssschhh!!! Warscht wohl beim Maksch! "
              +"Hau blosch ab!!!", 
                          "Zechus lallt: ");
  if(pl->QueryProp(P_GHOST)) 
       return BSA("Hascht Dich wohl *ruelps* tschu Tode g'schoffn, "
          +"was. Hau blosch ab!!! ", "Zechus lallt: ");

  if(!IsGuildMember(pl)) lvl=1;
  else lvl=pl->QueryProp(P_GUILD_LEVEL);
  if((lvl=6-lvl)<1) lvl=1;
  alc=pl->QueryProp(P_ALCOHOL);
  max_alc=pl->QueryProp(P_MAX_ALCOHOL);
  req_alc=(int)(max_alc/lvl);
  retstring=""; 
  if(alc<req_alc) {
    retstring="Du bischt viel zu nuechtern! ";
    flag=1;
  }
  if(IsGuildMember(pl) && pl->QuerProp(P_GUILD_LEVEL)!=1) {
    //tell_angrox(sprintf("Level:%d\n", pl->QueryProp(P_GUILD_LEVEL)));
    if(!call_other(ZECHMASTER, "CheckXp", pl, pl->QueryProp(P_XP)))
     { retstring=retstring+
                  NeedMoreXP(pl, LVL_XP[pl->QueryProp(P_GUILD_LEVEL)-1]);
       flag=1;
     }
  }

  /* Gildenquest checks */
 /* if(CheckGuildQuest(TP) != "")
  {
    retstring += CheckGuildQuest(TP);
    flag       = 1;
  }*/

  if (flag) return retstring;
  return 0;
}

string CheckGuildQuest(object pl)
{
  int glvl;
  int *quested;
  string str;
  glvl = TP->QueryProp(P_GUILD_LEVEL);
  str  = "";
  
  if(!(TP->QueryProp(P_TESTPLAYER))) return "";

  if(!(quested = call_other("/gilden/zechpreller/master/questmaster",
			  "QueryQuesterEntry", getuid(pl))))
  {
    call_other("/gilden/zechpreller/master/questmaster", "AddQuester", pl);
    quested = call_other("/gilden/zechpreller/master/questmaster", 
		         "QueryQuesterEntry", getuid(pl));
  }

  if(glvl > 1 && !quested[0]) // 1. Gildenquest
    str = "Wennscht aufsteigen willst, dann musscht mit ein Faesschen mit "
	  "Met bringen! Wennscht mich nach nem Metfaesschen fragscht kriegsts! ";
  if(glvl > 4 && !pl->QueryQuest("Der verschollene Hoehlenforscher"))
    str = "In der Naehe der Tschwergenstadt Felonia findescht einen "
	  "Hoehlenforscher, der Deine Hilfe braucht! Wennscht ihm hilfst, "
	  "dann kriegst eine Thermoskanne! Alscho los! ";
  if(glvl > 6 && !quested[1])
    str = "Einer der erschten Zechpreller, Torxes, hatte einscht ein "
	  "magisches Trinkhorn! Er isch in die Wueste getschogen und "
	  "dasch Horn is verschollen! Jetscht hams zwiehilichtige Banditen "
	  "gefunden! Bringsch am Besten gleich her! ";
  if(glvl > 8 && !quested[2])
    str = "Vor langer Tscheit hat mir dsch Boesche drei Pruefungen gestellt, "
	  "wart bis esch sich bei Dir meldet und besteh die drei Pruefungen! "
	  "Dann kannscht ein Zechprellermeister werden! ";
  
  return str;
}
