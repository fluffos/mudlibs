// History des mages_shout
int AddMagesHistory(string presay, string msg) 
{
  int i;
  
  if ( sizeof(mhistory) > 20 )
  {
    mhistory=mhistory[1..<1];
    mhist_time=mhist_time[1..<1];
  }
  mhistory+=({implode(({presay, msg}), "&&*%%")});
  mhist_time+=({time()});
  return 1;
}

mixed QueryMagesHistory() 
{
  return ({mhist_time,mhistory}); 
}

// History des guild_shout
int AddHistory(string presay, string msg, int invis) 
{
  int i;
  
  if ( sizeof(history) > 10 )
  {
    history=history[1..<1];
    hist_time=hist_time[1..<1];
  }
  history+=({implode(({presay, msg, to_string(invis)}), "&&*%%")});
  hist_time+=({time()});
  if(interactive(TP))
    write_file(NHIST_LOG, sprintf("%s - %s%s", dtime(time()), 
        presay, msg));
  write_file(NHIST_ALL_LOG, sprintf("%s - %s%s", dtime(time()), 
        presay, msg));
  return 1;
}

mixed QueryHistory() 
{
  return ({hist_time,history}); 
}

/* Den Besten herausfiltern und in einer Variablen speichern. */
int SetNumberOne() 
{
  int i, *topratings, bestrating;
  bestrating=0;
  topratings=m_indices(top);
  for(i=sizeof(topratings)-1;i>=0;i--)
    if(topratings[i]>bestrating) bestrating=topratings[i];
  number_one=top[bestrating];
  return 1; 
}

/* Den Besten ausgeben */
mixed QueryNumberOne() 
{
  return number_one;
}

/* Berechnung der Wertung */
int CalculateRating(string player, int rating, int stufe, mixed align, string gilde) 
{
  int last, lxp, gsu;
  float mod;
  object pl;
  if (gilde!=GUILDNAME) 
    return 0;
  if(!intp(align)) align=0;
  lxp=members[player, POS_SUMMELOSTXP];
  if (lxp > 100000000) lxp=100000000+(lxp-100000000)/55;
  gsu = members[player, POS_GILDENSTUFE]*8 + members[player, POS_GRAD]*4;
  rating += gsu*100 + lxp/50000 + stufe*15 - align/15;
  if(pl=find_player(player) || pl=find_netdead(player))
    last=pl->QueryProp(P_LAST_LOGIN);
  else
    last=call_other(SAVEMASTER, "QueryFileProp", player, P_LAST_LOGIN);
  if((time()-3600*24*66)>last) {         // nach 66 tagen
    mod=1-((time()-3600*24*66-last)/86400)*0.05;
    if(((int)(rating*mod))<rating/6) rating/=6;
    else rating=(int)(rating*mod);
  }
  return rating;
}

/* Fuers Austreten -> Raus aus der Topliste */
int DeleteTopEntry(string player) 
{
  int *topratings, i; 
  string *topnames;
  if (!CheckIfAllowed()) return -2;
  topnames=m_values(top);
  topratings=m_indices(top);
  for(i=sizeof(topnames)-1;i>=0;i--) 
    if(member(topnames[i], player)!=-1) 
      top[topratings[i]]-=({player});
  saveload=top;
  save_object(TOPLIST);
  return 1;
}

/* Topliste updaten */
varargs int UpdateTopList(mixed names) 
{
  string *topnames;
  int rating, i, j, *topratings, test;
  object pl;

  // Immer nur ein Update auf einmal
  if (find_call_out("UpdateTopList") != -1)
    return 0;

  if(!names) {
    names=m_indices(members);
    top=([]);
  }
  i=0;
  while (i<sizeof(names)) 
  {
    rating=0;
    if(query_wiz_level(names[i])<3) { 
      if(((pl=find_player(names[i]))||(pl=find_netdead(names[i]))) &&
          !pl->QueryProp(P_TESTPLAYER))
        rating=CalculateRating(names[i], pl->QueryProp(P_GUILD_RATING), 
               pl->QueryProp(P_LEVEL), pl->QueryProp(P_ALIGN), pl->QueryProp(P_GUILD));
      else 
      {
        if( stringp(names[i]) && 
            !call_other(SAVEMASTER, "QueryFileProp", names[i], P_TESTPLAYER))
          rating=CalculateRating(names[i],
            call_other(SAVEMASTER, "QueryFileProp", names[i], P_GUILD_RATING), 
            call_other(SAVEMASTER, "QueryFileProp", names[i], P_LEVEL),
            call_other(SAVEMASTER, "QueryFileProp", names[i], P_ALIGN),
            call_other(SAVEMASTER, "QueryFileProp", names[i], P_GUILD));
      }      
    }
    if(rating) 
    {
      if(!member(top, rating)) 
        top+=([rating:({names[i]})]);
      else 
        top[rating]+=({names[i]});
    }   
    i++;
    if ((i >= 20) && sizeof(names) > i)
    {
      names = names[i..];
      call_out("UpdateTopList", 2, names);
      return 2;
    }
  }

  // Leere Eintraege raus
  for(i=sizeof(m_indices(top))-1;i>=0;i--) 
    if(!sizeof(m_values(top)[i]))
      top=m_delete(top, m_indices(top)[i]);
  saveload=top;
  save_object(TOPLIST);
  call_out("MakeReadList",0);
  call_out("SetNumberOne",0);
  return 1;   
}

/* Topliste in file 'toplist.read' schreiben, Ausgabe ueber 'more' */
int MakeReadList() 
{
  int *arm, i, j, tabs, tabs2, gkreis, ggrad, stufe, nummer, seelen;
  float best, fac;
  string name, align;
  UpdateMemberLevels();
  rm(REALTOPLIST);
  nummer=1;
  write_file(REALTOPLIST, "    Name\tKreis Grad   Stufe  Geopfert\t"
      +"Gesinnung\tWertung\n");
  write_file(REALTOPLIST, "-----------------------------------------"
                     +"------------------------------\n");
  arm=sort_array(m_indices(top), #'>); //');
  if((i=sizeof(arm))>100) i=100;
  for(i=i-1;i>=0;i--) 
  {
    if(arm[i]) 
    {
      if(i==sizeof(arm)-1)
        best=(float)arm[i];
      for(j=sizeof(top[arm[i]])-1;j>=0;j--) 
      {
        name=top[arm[i]][j];
        fac=(float)(arm[i]/best)*100;
        align=call_other("/std/player/base", "al_to_title", 
            members[lower_case(name),POS_ALIGN]);
        tabs=1; //+(int)(strlen(name)/8);
        if (strlen(name) < 4) tabs++;
        tabs2=2-(int)(strlen(align)/8);
        gkreis=members[name,POS_GILDENSTUFE];
        ggrad=members[name,POS_GRAD];
        stufe=members[name,POS_LEVEL];
        seelen=members[name,POS_NPC];
        if(!gkreis) continue;
        if(arm[i]==1)
	  write_file(REALTOPLIST, sprintf("%2d. %s%*'\t's%4d %4d %7d %9d\t%s"
              "%*'\t's%s\n", nummer, CAP(name), tabs, "", gkreis, ggrad, stufe, 
             seelen, align, tabs2, "", "  -.---"));
        else 
	  write_file(REALTOPLIST, sprintf("%2d. %s%*'\t's%4d %4d %7d %9d\t%s"
              "%*'\t's%7.3f\n", nummer, CAP(name), tabs, "", gkreis, ggrad, stufe, 
             seelen, align, tabs2, "",fac));
        nummer++;
      }
    }
  }
  return 1;
}

nosave void Channel(string msg) 
{
  CHMASTER->join("Event",TO);
  CHMASTER->send("Event",TO,msg,MSG_SAY);
  return;
}

int ZombieEvent() 
{
  int anzahl;
  anzahl=bloodpool/20;
  if(anzahl > 100 ) anzahl = 100; // Maximal 100 Leichen
  if(call_other("/p/daemon/corpsed/corpsed", "ZombieEvent", anzahl)) {
    Channel("Die unheiligen Machenschaften der Nekromanten stossen die "
      "Pforten der Niederhoellen auf! Die Toten erheben sich!");
    UseBloodPool(bloodpool-100+random(200));
  }
  return 1;
}

mixed QueryBloodPool()
{
  return ({bloodpool,MAX_BLOODPOOL});
}

object *OnlineMembers() {
  string *nekros;
  object *online_users, *online_members;
  int i;
  nekros=m_indices(members);
  online_members=({});
  online_users=users();
  for (i=sizeof(online_users)-1;i>=0;i--) {
    if(member(nekros,getuid(online_users[i]))!=-1)
      online_members+=({online_users[i]});
  }
  return online_members;
}

object *Listeners() {
  object *online_users,*listener;
  int i;
  online_users=users();
  listener=({});
  for(i=sizeof(online_users)-1;i>=0;i--) {
    if(online_users[i]->QueryProp(P_TMP_NECROMANCER_LISTENER))
      listener+=({online_users[i]});
  }
  return listener;
}

void clone_sacr_item() {
  int i;
  string *palas;
  object pala,ob;

  palas= m_indices(killed_paladin_list);
  for(i=sizeof(palas)-1;i>=0;i--) {
    if(pala=find_player(palas[i])) {
      if(!ob=present(NEKRO_SACRIFICE_ITEM, pala)) {
        ob=clone_object(OBJ+"sacrificed");
        ob->move(pala,M_NOCHECK);
      }
      else {
        ob->init_me();
      }
    }
  }
  return ;
}

varargs int AddFreePoints(mixed pl, int value) 
{
  string pl_str;
  mapping skillpunkte;
  if(!pl=string2object(pl)) return -1;
  if(!CheckIfAllowed()) return -2;
  pl_str=getuid(pl);
  if(!value) value = 1;
  if(!member(members, pl_str)) return -3;
  skillpunkte=members[pl_str,POS_SKILLPUNKTE];
  if (!mappingp(skillpunkte)) 
    skillpunkte=(["freiepunkte":value]);
  else if (!skillpunkte["freiepunkte"])
    skillpunkte+=(["freiepunkte":value]);
  else 
    skillpunkte["freiepunkte"]=skillpunkte["freiepunkte"]+value;
  members[pl_str,POS_SKILLPUNKTE]=skillpunkte;
  saveload=members;
  save_object(MEMBERLIST);
  saveload=0;
  return 1;
}

int AllowGuildItemFunction(string command) {
  mapping cmds;
  cmds=NEKROMASKCOMMANDS;
  if(member(cmds,command))
    return cmds[command];
  return 0;
}
