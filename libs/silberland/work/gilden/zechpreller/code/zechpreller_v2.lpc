create()
{
  ::create();
  SetProp(P_INT_SHORT, "Bei den Zechprellern"); 
  SetProp(P_INT_LONG, 
	  "Du bist hier in einem kahlen, mit Holzboden ausgelegten Raum. "
	  +"Die einzige Einrichtung ist ein Tisch, ein paar Stuehle, ein "
	  +"paar Faesser und unzaehlige Flaschen. Die wenigen Fenster im "
    +"Raum sind fest verschlossen, dadurch hat sich ein ziemlich starker "
	  +"Alkoholdunst im Raum angesammelt. Die Faesser, die in der hinteren "
	  +"Ecke des Raumes stehen, sind mit XXX gekennzeichnet. Die Flaschen, "
    +"von denen alle am Boden liegen, scheinen leer zu sein. An der "
	  +"Nordwand haengt eine schmierige Liste. Im Westen fuehrt "
	  +"der Weg nach draussen. @@maghelp@@");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Zechus");
  AddDetail("einrichtung", 
      "Die Einrichtung besteht aus einem Tisch, ein paar Stuehlen, "
      +"Faessern, und Flaschen, Flaschen, Flaschen.");
  AddDetail("decke", 
	    "Die Decke besteht, so wie der Boden, aus Holzdielen.");
  AddDetail("holzdielen", 
	    "Die Holzdielen sehen schon ziemlich heruntergekommen aus.");
  AddDetail("holz", 
	    "Das Holz sieht schon sehr alt aus. Du wunderst Dich das diese "
	    +"Bude noch steht.");
  AddDetail(({"bude", "raum", "gilde", "zechprellergilde", "zechpreller"}),
            "Du stehtst mittendrin.");
  AddDetail("boden", 
	    "Der Boden besteht aus alten Holzdielen. Uberall im Raum liegen "
	    +"leere Flaschen herum. Im hinteren Teil des Raumes befinden sich "
	    +"einige Faesser am Boden.");
  AddDetail("flaschen", 
       "Einst waren sie mit edelen Gebraeuen gefuellt, doch nun sind sie "
       +"leer.");
  AddDetail("gebraeuen",
      "Schnaps, Bier, Wein. Aber irgendwer muss die Flaschen von ihrem "
      +"Inhalt befreit haben.");
  AddDetail("inhalt", 
      "Der ist nicht mehr da.");
  AddDetail("faesser", 
      "Die Faesser haben den Aufdruck 'XXX'. Was das wohl zu bedeuten hat?");
  AddDetail("xxx",
      "Vermutlich ist Schnaps oder aehnliches drinnen. Ein paar der "
      +"Faesser scheinen aber schon leer zu sein.");
  AddDetail("aufdruck", 
      "Auf den Faessern ist der Aufdruck 'XXX'.");
  AddDetail("fenster", 
      "Die Fenster sind schmutzig und beschlagen, weswegen man nicht nach "
      +"draussen sehen kann und nur diffuses Licht in den Raum faellt. Sie "
      +"sind fest verschlossen.");
  AddDetail("licht", 
      "Das Licht, dass durch die Fenster in den Raum faellt, ist diffus und "
      +"taucht den Raum in ein Spiel von Licht und Schatten.");
  AddDetail("spiel", 
      "Das Licht wirft lustige Schatten in den Raum. So wird die Oede des "
      +"Raumes ein bisschen abgeschwaecht.");
  AddDetail("schatten",
      "Die Schatten sehen witzig aus.");
  AddDetail("oede", 
      "Es ist hier schon ein bisschen oed. So wie in Mainz. Aber das wirst "
      +"Du vermutlich nicht verstehen. Egal. Das Spiel von Licht und "
      +"Schatten vertreiben diese Oede auf jeden Fall ein bisschen.");
  AddDetail("mainz", 
      "Oed, es ist oed, es ist oedest, so richtig oed, Oed, OED, "
      +"es ist BAEHHH!");
  AddDetail("ecke",
      "In der hinteren Ecke des Raumes stehen ein paar Faesser.");
  AddDetail(({"nordwand", "wand"}),
      "An der Nordwand haengt eine schmierige Liste");
  AddDetail("liste", 
      "Du kannst sie lesen.");
  AddDetail("tisch", 
      "Der Tisch hat wahrlich schon bessere Zeiten gesehen: Er wackelt, "
      +"sieht ramponiert aus und hat unzaehlige Flecken auf seiner "
      +"Oberflaeche.");
  AddDetail("oberflaeche", 
      "Die ist mit Flecken uebersaeht.");
  AddDetail("flecken", 
      "BAEHH!! Sieht das ecklig aus. Du wendest Dich angewidert ab.");
  AddDetail("stuehle", 
      "Die Stuehle stehen irgendwie im Raum herum. Auch sie sehen ziemlich "
      +"heruntergekommen aus.");
  AddDetail(({"wein", "bier", "schnaps"}), 
      "Hier ist sicher schon viel Bier, Wein und Schnaps vernichtet worden."
      +"Vor allem Schnaps.");
  AddDetail("alkoholdunst", 
      "Der ist sicher ecklig. Besser nicht riechen.");
  AddSmell(DEFAULT_SMELL, 
      "Du atmest tief durch und Dich wirft es fast von den Socken. "
      +"WAEHHHHHH! Dieser Gestank hier!");
  AddSmell("alkoholdunst", 
      "Hier riecht es schon SEHR streng nach Alkohol.");
  AddSmell("gestank", 
      "Nein, du willst nicht mehr riechen!!!");
  AddSound(DEFAULT_SOUND, 
      "Von draussen dringen gedaempft Geraeusche herrein.");
  AddSound("geraeusche", 
      "Draussen ist wohl was los!");
  AddReadDetail("liste", "@@liste@@");
  
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 22]));
  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"zech_spells"); 
         //Es muss ein gueltiges Spellbook festgelegt werden!
  SetProp(P_GUILD_RESTRICTIONS, ([P_LEVEL: 5,    
                                  A_CON:10,
                                  SR_FUN : "Test"]));
         // Die Aufnahmebedingungen fuer die Gilde


/* -----------------------------------------------------
Fuer jede Gildenstufe (!= Spielerstufe) werden bestimmte
Bedingungen festgelegt. Diese Bedingungen werden in Form
eines Mappings fuer jede (!) Stufe einzelnen angegeben.
Die Defines sind in der Gildendoku nachzulesen.
----------------------------------------------------- */
  SetProp(P_GUILD_LEVELS,([
       1: ([ SR_FUN: "Test", A_CON: 10, P_LEVEL: 5]),
       2: ([ SR_FUN: "Test", A_CON: 13, P_LEVEL: 10]),
       3: ([ SR_FUN: "Test", A_CON: 15, P_LEVEL: 15]),
       4: ([ SR_FUN: "Test", A_CON: 17, P_LEVEL: 20]),
       5: ([ SR_FUN: "Test", A_CON: 20, P_LEVEL: 25]),
       6: ([ SR_FUN: "Test", A_CON: 25, P_LEVEL: 30]),
      ]));

 SetProp(P_GUILD_MALE_TITLES,
     ([1 : "der Safttrinker",
       2 : "der Weintrinker",
       3 : "der Starkbiertrinker",
       4 : "der Schnapstrinker",
       5 : "der Schluckspecht",
       6 : "die Schnapsleiche"]));
  SetProp(P_GUILD_FEMALE_TITLES,
     ([1 : "die Safttrinkerin",
       2 : "die Weintrinkerin",
       3 : "die Starkbiertrinkerin",
       4 : "die Schnapstrinkerin",
       5 : "die Schluckspechtin",
       6 : "die Schnapsleiche"]));
 
  
/* ---------------------------------------------------------
Die gueltigen Spells des Spellbooks muessen auch im Gilden-
object definiert werden:
--------------------------------------------------------- */
  AddSpell("prelle");
  AddSpell("schaetz");
  AddSpell("identifiziere");
  AddSpell("anhauchen");
  AddSpell("ruelpser");
  AddSpell("rumkugeln");
  AddSpell("staenkern");
  AddSpell("uebergeben");
  AddSpell("destilliere");
  AddSpell("groehlen");
/* Eventuelle Skills werden ebenfalls mal definiert: */
  AddSkill(SK_BOOZE,([SI_SKILLFUNC:"Saufen"]));
  //AddExit( "gilde", "in die Abenteurergilde#/gilden/abenteurer" );
  AddCmd(({"tritt","trete"}),"tritt");
  AddCmd(({ "lerne", "lern" }), "OwnLearnSpell" );
  AddCmd("austritt","austreten");
  AddCmd("beitritt", "falscher_syntax");
  AddCmd( ({"fertigkeiten"}), "faehigkeiten");
  AddCmd("gilde", "magfunc");
  AddItem(NPC("zechus"), REFRESH_DESTRUCT);
  AddExit("westen", "/d/ebene/lamuerte/burg/weg/13x9y");
}

/* Ausgabe in der P_INT_LONG */
string maghelp()
{
 if(!IS_LORD(TP)) return "";
 return "\nMagInfo: Hilfe fuer Magierbefehle mit 'gilde hilfe'.";
}

int magfunc(string str)
{
  if(!IS_LORD(TP)) return 0;
  if(!str) str="hilfe";
  if(str=="hilfe") {
   write("Folgende Befehle sind moeglich:\n"
        +"gilde hilfe  : Dieses hier\n"
        +"gilde backup : Backup des Memberfiles (Arch-only)\n"
        +"gilde restore: Zurueckspielen des Backups (Arch-only)\n"
        +"gilde toplist: Updaten der Topliste\n");
   return 1;
  }
  if(str=="backup" && IS_ARCH(TP)) {
    call_other(ZECHMASTER, "DoBackup"); 
    tell_object(TP, "Kopiere members/members.o nach "
             +"backup/members_backup.o\n");
    return 1;
  }
  if(str=="restore" && IS_ARCH(TP)) {
    if(call_other(ZECHMASTER, "DoRestore")==-2){
      tell_object(TP, "Fehler! Members.o konnte nicht restored "
                 +"werden!\n");
      return 1;
    } 
    tell_object(TP, "Kopiere backup/members_backup.o nach "
                 +"members/members.o\n");
    return 1;
  }
  if(str=="toplist") {
    call_other(ZECHMASTER, "UpdateMemberLevels");
    call_other(ZECHMASTER, "UpdateTopList");
    call_other(ZECHMASTER, "MakeReadList");
    call_other(ZECHMASTER, "SetNumberOne");
    tell_object(TP, "Memberliste ist nun up-to-date.\n");
    return 1;
  }
 tell_object(TP, "Befehl nicht moeglich!\n");
 return 1;
}


/* Bestenliste */
string liste()
{
 TP->More("\nDIE BESTEN SAEUFER:\n"+read_file(REALTOPLIST));
 tell_room(TO, BS(sprintf("%s schaut sich die Liste genauer an.", 
           TP->Name(WER))), ({TP}));
 return "";
}

/* Backup der Memberliste */
reset()
{
  ::reset();
  zaehler++;
  if(zaehler==1) {
    call_other(ZECHMASTER, "UpdateTopList");
    call_other(ZECHMASTER, "MakeReadList");
    call_other(ZECHMASTER, "SetNumberOne");
  }
  if(zaehler==5) {
    call_other(ZECHMASTER, "DoBackup"); 
    zaehler=0;
  }
}

/* Skillablilty am Anfang in einen Bereich 2000..4000 setzen */
nosave int InitialSkillAbility(mapping ski, object pl) 
{
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if(value<2000) value=2000;
  else if(value>4000) value=4000;
  return value;
}


int GuildRating(object pl)
{
    return pl->SetProp(P_GUILD_RATING,
              ::GuildRating(pl)*4/5);
}


/* So gehts nicht :> */
int falscher_syntax()
{
  if(!present("zechus", TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nix!\n"));
    return 1;
  }
  write(BSA("Du muscht mich schon fragen oder <Hicks!> einfach "
           +"'tritt gilde bei' eingeben. So isch dasch, jaja...",
            "Zechus lallt Dir ins Ohr: "));
  return 1;
}

/* Austritt aus der Gilde */
int austreten()
{
  object ob;
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  }          
  this_player()->SetProp( P_GUILD_LEVEL, 0);
  WLOG("/log/gilden/zechpreller", " tritt aus der Gilde aus");
  write(BSA("WAAAAAAAASCH! Du willscht nuechtern werden. Hau blossch ab...", 
      "Zechus lallt: "));
  say(BSA("WAAAAAAASCH, Du willscht nuechtern werden, "+CAP(getuid(TP))+"? "
     +"Hau blossch ab!", "Zechus lallt: "));
  if(ob=present(GILDENOBJ,TP)) 
    ob->remove();
  call_other(ZECHMASTER, "DeleteMember", TP);
  call_other(ZECHMASTER, "DeleteTopEntry", getuid(TP));
  Channel(CAP(getuid(TP))+" ist gerade bei den Zechprellern "
            +"ausgetreten und wird sofort ekelhaft nuechtern.");
  TP->SetProp(P_ALCOHOL, 0);
  return ::austreten();
}

/* Gildenbeitritt */
int tritt(string str)
{
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  } 
  if(str!="gilde bei" && str!="zechpreller bei") return 0;

  beitreten();  
  return 1;
}
 

/* Eigentliche Beitrittsfunktion, wird von tritt() aufgerufen */
int beitreten()
{
  int b;
  object ob;
  string restr;
  if(IsGuildMember(TP)) {
     write(BSA("Aber hey, du <Hicks!> bischt ja schon einer "
              +"von unsch ... hehe!", "Zechus lallt: "));
     return 1;
    }
  restr=call_other(RES_CHECKER, "check_restrictions", TP,
      QueryProp(P_GUILD_RESTRICTIONS));
  if(stringp(restr))
  {
    tell_room(ENV(TP), 
     BSA(sprintf("Du kannscht unsch Saeu^H^H^H^H"
        "Alkoholgeniessern noch nicht beitreten, %s! %s\n", 
        TP->Name(WER), restr), 
        "Zechus lallt: "));
    return 1;
  }

  if((b = ::beitreten()) < 0) return 1;
  write(BSA("Na alscho. Hier, trink gleich mal einen Schnapsch. Du "
           +"kriegscht <Hick!> einen Siebschenerschluesschel von mir, "
           +"damit jeder *ruelps* - ups, 'schulligung - wo war ich ... "
           +"*gruebel* ah ja! Alscho, den kriegscht, damit jeder weisch, "
           +"dasch du tschu uns gehoerscht. Ausscherdem kannscht Du die "
           +"Zauber mit 'lerne' lernen, und Du kannsscht mich nach "
           +"'Fertigkeiten' fragen. "
           +"Allesch ok?\n", 
            "Zechus lallt: "));
  say(BSA("Na alscho. Hier, trink gleich mal einen Schnapsch. Du "+
           "kriegscht <Hick!> einen Siebschenerschluesschel von mir, "+
           "damit jeder *ruelps* - ups, 'schulligung - wo war ich ... "+
           "*gruebel* ah ja! Alscho, den kriegscht, damit jeder weisch, "+
           "dasch du tschu uns gehoerscht. Allesch ok?\n",
            "Zechus lallt zu "+CAP(getuid(TP))+": "));
  write(BS("Zechus gibt Dir einen Bieroeffner.\n"));
  say(BS("Zechus gib "+CAP(getuid(TP))+" einen Bieroeffner.\n"));
  ob=clone_object(OBJ("z_17erschluessel"));
  ob->move(TP, M_NOCHECK);
  call_other(ZECHMASTER, "AddMember", this_player());
  write(BSA("PROSCHT und willkommen!", "Zechus lallt erfreut: "));
  say(BSA("PROSCHT und willkommen, "+CAP(getuid(TP))+"!\n"
         , "Zechus lallt erfreut: "));
  /*
  say(BS("Zechus Prellus gibt "+CAP(getuid(TP))+" ein Pergament.\n"));
  write(BS("Zechus Prellus gibt Dir ein Pergament."));
  ob=clone_object(OBJ("pergament"));
  ob->move(TP, M_NOCHECK);   
  */
  WLOG("/log/gilden/zechpreller", "tritt in die Gilde ein.\n");
  call_other(ZECHMASTER, "AddMember", this_player());
  //tell_angrox("AddMember Ok!\n");
  TP->ModifySkill(SK_BOOZE,QuerySkill(SK_BOOZE),0, "zechpreller" );
  //tell_angrox("SetSkill ok!\n");
  write_file(LOG(getuid(TP)+".log"),
             dtime(time())+": "+CAP(getuid(TP))+" ist "
             +"in die Gilde eingetreten.\n");
  //tell_angrox("Log ok!\n");
  Channel(CAP(getuid(TP))+" ischt gerade den Zechprellern beigetreten. "
	  +"PROSCHT UND GESCHUNDHEIT <Hicks> !!");
  //tell_angrox("Alles ok!\n");
  call_other(ZECHMASTER, "UpdateMemberLevels"); 
  call_other(ZECHMASTER, "SetXp",TP, TP->QueryProp(P_XP)+LVL_XP[0]);
  return b;
}

/* Aufstieg */
advance(string str)
{
  mixed b;
  string restr;
  if(!present(GILDENNPC, TO)) {
    write(BS("Ohne Zechus Prellus laeuft hier gar nichts!\n"));
    return 1;
  }   
  notify_fail(BSA("Nur die Sschtufe der Zechpreller, okeee?.", 
    "Zechus lallt: "));
  if(!str || !IsGuildMember(TP)) return 0;
  if(str=="stufe" || str2attr(str))
     return 0;
  if(str=="gildenstufe" || str=="gilde") {
    LevelText(TP);
    if(TP->QueryProp(P_GUILD_LEVEL)>=6) {
      write(BSA("Weiter getsch net!!!\n", 
		    "Zechus lallt: "));
      say(BSA("Weiter getsch nimmer, "
	      +CAP(getuid(TP))+".\n", "Zechus lallt: "));
      return 1;
    }
    if((restr=call_other(RES_CHECKER, "check_restrictions", TP,
          QueryProp(P_GUILD_LEVELS)[TP->QueryProp(P_GUILD_LEVEL)+1]))!=0 &&
        restr!="0")
    {
      tell_room(ENV(TP), BSA(sprintf("Du erfuellst nicht alle Anforderungen, "
        +"um aufsteigen zu koennen, %s! %s\n", TP->Name(WER), restr), 
        "Zechus lallt: "));
      return 1;
    }
    
    b=::advance();

    call_other(ZECHMASTER, "SetXp", TP, 
        (TP->QueryProp(P_XP)+LVL_XP[TP->QueryProp(P_GUILD_LEVEL)-1]));      

    if(b) {
      if(TP->QueryProp(P_GUILD_LEVEL)>5) {
	write(BSA("Schupa! Endlich hascht es g'schafft!\n",
		  "Zechus lallt: "));
	say(BSA("Schupa! Endlich hascht es g'schafft, "+
		CAP(getuid(TP))+".\n", "Zechus lallt: "));
	write_file(LOG(getuid(TP)+".log"),
		   dtime(time())+": "+CAP(getuid(TP))+" hat "
		   +"die hoechste Stufe erreicht.\n");    
	Channel(CAP(getuid(TP))+" hat bei den Zechprellern "
		+"die Vollendung des Suffs erreicht!");
  call_other(ZECHMASTER, "UpdateMemberLevels"); 
	return b;
      }
      write(BSA("Gratuliere!!\n", "Zechus spricht erstaunlich klar: "));
      say(BSA("Gratuliere, "+CAP(getuid(TP))+".\n",
              "Zechus spricht erstaunlich klar: "));     
      write_file(LOG(getuid(TP)+".log"),
		 dtime(time())+": "+CAP(getuid(TP))+" ist "
		 +"eine Stufe aufgestiegen.\n"); 
      Channel(CAP(getuid(TP))+" hat sich bei den Zechprellern auf "
              "Gildenstufe "+TP->QueryProp(P_GUILD_LEVEL)+
              " hochgesof^H^H^Hkaempft.");
      call_other(ZECHMASTER, "UpdateMemberLevels"); 
      return b;
    }

  }
  return b;
}

/* Spells lernen */
OwnLearnSpell(string str)
{
 
  if(!present(GILDENNPC, TO)) {
     write(BS("Ohne Zechus laeuft hier gar nichts!\n"));
     return 1;
  }   
  if(!IsGuildMember(TP))
  {
    write(BSA("Verschwind!!! Du bischt keiner von unsch!!!\n", 
       "Zechus groehlt: "));
    return 1;
  }
  notify_fail("Was moechtest Du hier lernen?\n");
  if(!str)
  {
    write(BSA("Wasch magscht lernen? Esch gaebe da (Stufe in Klammern) "
              "Prelle (1), Identifiziere (1), Schaetz (2), "
              "Ruelpser (2), Uebergeben (3), Destilliere (4), "
              "Anhauchen (4), Rumkugeln (5), Staenkern (6) und "
              "Groehlen (6).",
	      "Zechus fragt Dich: ")); 
    say(BSA("Wasch magscht lernen? Esch gaebe da (Stufe in Klammern): "
              "Prelle (1), Identifiziere (1), Schaetz (2), "
              "Ruelpser (2), Uebergeben (3), Destilliere (4), "
              "Anhauchen (4), Rumkugeln (5), Staenkern (6), "
              "Groehlen (6)",
         "Zechus fragt "+CAP(getuid(TP))+": "));
    return 1;
  }
    
  return LearnSpell(str);
}


