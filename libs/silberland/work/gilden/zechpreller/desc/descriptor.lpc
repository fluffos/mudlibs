// Silberland Spell-Destriptor
// Version 1.0
// by Gwenshara@SL, 06.05.2005

#include "/gilden/zechpreller/zech.h"
#include <moredef.h>
#define BSI(x,y) break_string(x, 78, y)
#include "/sys/living/life.h"

string *Prepare(string *d, string id);

int Describe(string d_source, object room, object player)
{
  string *desc;
  int i;
  SUID;
  desc = explode(read_file(d_source), "#");
  desc = Prepare(desc, "\r");
  desc = Prepare(desc, "\n");
  player->SetProp(P_PARALYZED, ([PARALYZE_TIME:200,
			         PARALYZE_MSG:"Dazu hast Du jetzt keine Zeit!\n",
				 PARALYZE_MSG_OTHER:"",
				 PARALYZE_END:"",
				 PARALYZE_END_OTHER:""]));
  call_out("throw_description", 0, desc, 0, room, player);
  
  return 1;
}

void throw_description(string *desc, int pos, object room, object player)
{
  string indent, text, *it;
  if(!sizeof(desc) || pos >= sizeof(desc))
  {
    player->SetProp(P_PARALYZED, 0);
    return;
  }

  /* Ausgabe an den Spieler */
  if(desc[pos] != "<NOTEXT>")
  {
    it = explode(desc[pos], ">>");
    if(sizeof(it) > 1)
    {
      indent = it[0];
      text   = it[1];
    }
    else
    {
      indent = 0;
      text = it[0];
    }
    tell_object(player, BSI(text, indent));
  }
  
  /* Ausgabe an den Raum */
  if(desc[pos+1] != "<NOTEXT>")
  {
    it = explode(desc[pos+1], ">>");
    if(sizeof(it) > 1)
    {
      indent = it[0];
      text   = it[1];
    }
    else
    {
      indent = 0;
      text = it[0];
    }
    tell_room(room, sprintf(BSI(text, indent), player->Name()), ({player}));
  }

  call_out("throw_description", 3, desc, pos+2, room, player);
  return;
}

string *Prepare(string *d, string id)
{
  string *line, new_line;
  int i, j;
  
  for(i=0; i<sizeof(d); ++i)
  {
    new_line = "";
    line = explode(d[i], id);
    for(j=0; j<sizeof(line); ++j)
      new_line+=line[j];
    d[i] = new_line;
  }

  return d;  
}
