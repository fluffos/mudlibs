  if(!call_other(TASKMASTER, "CheckTask", pl)) {
    if(!stringp(var=call_other(TASKMASTER, "ShowTask", pl))) {
      _error(sprintf("Taskmaster/ShowTask, LVL: %d, returnwert: %d)", 
          lvl+1, var));
      return "";
    }
    else
      str+=var;
  }
  if(str=="") return 0;
  else return str;
}


/*
//
// NPC's die Skills lernen lassen
//
*/
learn_paladin_skills(int sword) {
  object wer;
  wer=previous_object();
  if( !wer || interactive(wer) || query_once_interactive(wer) ) return;
  wer->ModifySkill(FIGHT(WT_SWORD),
    QuerySkill(FIGHT(WT_SWORD))+([ SI_SKILLABILITY: sword]), 150,"paladine");

  switch (wer->QueryProp(P_GUILD_LEVEL))
  {
    case 16:
    case 15:
      wer->ModifySkill("talisman", 10000);
      wer->ModifySkill("talisman", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,]));
    case 14:
    case 13:
      wer->ModifySkill("spiegelschild", 10000);
      wer->ModifySkill("spiegelschild", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 12:
    case 11:
    case 10:
      wer->ModifySkill("zielattacke",   10000);
      wer->ModifySkill("zielattacke",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 9:
      wer->ModifySkill("goetterschutz", 10000);
      wer->ModifySkill("goetterschutz", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0, 
                                     SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
    case 8:
    case 7:
      wer->ModifySkill("waffensegen",   10000);
      wer->ModifySkill("waffensegen",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 6:
    case 5:
      wer->ModifySkill("heiligengebet", 10000);
      wer->ModifySkill("heiligengebet", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    case 4:
    case 3:
      wer->ModifySkill("behandle",      10000);
      wer->ModifySkill("behandle",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0, 
                                     SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
      wer->ModifySkill("verbannung",      10000);
      wer->ModifySkill("behandle",      ([SI_SPELLCOST:0]) );
    case 2:
      wer->ModifySkill("schildparade",  10000);
      wer->ModifySkill("schildparade",  ([SI_PREPARE_TIME:0, SI_SPELLCOST:0, 
                                     SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  }
}


/*
//
// Das Clonen des Schwerts der Weihe
//
*/
nosave object SwordClone(object pl) {
  object ob;
  ob=clone_object("/p/weapon/sword/langschwert");
  ob->SetProp(P_SHORT, pl->Name(WESSEN)+" Schwert der Weihe"); 
  ob->SetProp(P_LONG, 
      "Die Klinge dieses Schwertes ist lang, schmal und komplett "
      "mit den heiligen Symbolen der Dusty uebersaeht. Die Parierstange "
      "ist in Form zweier Rosen gehalten. Auf dem Knauf des Griffes "
      "steht in goldenen Lettern: 'Das Weiheschwert von "+TP->name(WER)+"'.");
  ob->SetProp(P_MAGIC, 1);
  ob->SetProp(P_NOBUY, 1);
  ob->SetProp(P_NEVERDROP, 1);
  ob->SetProp(P_VALUE, 1);
  ob->SetProp(P_NODROP, BS("Das Schwert wuerdest Du niemals weglegen."));
  ob->SetProp(P_NOSELL, BS("Das Schwert wuerdest Du niemals verkaufen."));
  ob->SetProp(P_ARTICLE, 0);
  return ob;
}

//
// Fuer das Dustytool
//
int set_opferreport(int x) {
  if(x==0) {
    opferreport=x;
    return 1;
  }
  if(getuid(TP)!="dusty") return 0;
  opferreport=1;
  return 1;
}


/*

  Fuer den Spell-blocker
  2003-01-04 Iwo

*/
int IsCastDisabled()
{
  return (cast_disabled == 1);
}



int GuildRating(object pl)
{
  mapping ski;
  string *sk;
  int i, cnt, sum;
  closure qsa;

  if (!IsGuildMember(pl)||!query_once_interactive(pl))
    return 0;

  if (!(ski = QueryProp(P_GUILD_SKILLS)) ||
      !(qsa = symbol_function("QuerySkillAbility",pl)))
    return 0;

  if(pl->QueryProp(P_GUILD_LEVEL) < 16)
    ski=m_delete(ski,"auferstehung");
    

  sk = m_indices(ski);
    
  cnt = sizeof(ski);

  for (i=cnt-1, sum=0; i>=0; i--)
    sum += funcall(qsa, sk[i]);

  sum = sum/cnt;
  if (sum < 0)
    sum = 0;
  else if (sum > MAX_ABILITY)
    sum = MAX_ABILITY;

  return pl->SetProp(P_GUILD_RATING, sum);
}


void sacrificied_heart_lvl16() {
  tell_object(TP, BS("Du kniest Dich vor dem Altar nieder und opferst "
      "Dusty das Herz des Boesen!"));
   tell_room(ME, BS(sprintf("%s kniet sich vor dem Altar der Dusty nieder "
           "und legt einen pulsierenden schwarzen Klumpen nieder.", 
           TP->Name())), ({TP}));
   tell_room(ME, BS("Mit einem hoellischen Laerm sind unmenschliche Schreie "
     "und Flueche zu hoeren! Das Herz auf dem Altar blaeht sich kurz auf, "
     "und wird ueberirdischen Lichtstrahlen, welche dem Altar entweichen, von "
     "innen heraus zersetzt, bis es schliesslich explodiert!"));
   TP->SetProp(P_GUILD_LEVEL, 16);
   ::adjust_title(TP);
   if(present(GUILDITEM_ID, TP))
      present(GUILDITEM_ID, TP)->update_glvl();
   write_file(LOG("lvl16quest"), sprintf("%s: %s -> opfert das Herz und "
           "SCHAFFT DIE QUEST! OLE OLE ! Super %s. Ole ole !\n", 
           "eingetragen!\n", dtime(time()), getuid(TP), getuid(TP)));

   call_out("quest_ende", 6);
   return ;
}

void quest_ende() {
  object ayla;
  ayla=present("ayla");
  if(!ayla) return;
  ayla->command_me("sag Sehr gut, Paladin! Du hast das Herz des Boesen "
      "vernichtet, und damit dem Silberland mehr Zeit gegeben, sich auf "
      "die Invasion des Boesen vorzubereiten.");
  call_out("quest_belohnung", 4);
  return ;
}

void quest_belohnung() {
  object ayla;
  ayla=present("ayla");
  if(!ayla) return;
  ayla->command_me("sag Als Belohnung kann ich Dir nicht viel anbieten, "
      "nur einen Zauber, der Dir hilft die Bestimmung und die Tradition "
      "der Paladine fortzufuehren. Das goettliche Wunder 'auferstehung' "
      "ermoeglicht es Dir, tote Gefaehrten, die im Kampf neben Dir gefallen "
      "sind, wiederzubeleben (lerne auferstehung). Dieses Wunder kostet "
      "Dich allerdings auch einen Teil Deiner Opfergaben an Dusty. "
      "Dusty hat Dir auch noch eine besondere Aura "
      "verliehen, mit der Deine Heiligkeit anderen guten Kreaturen ein "
      "besonderes Wohlbefuehlen beschert. Und Du kannst nun einmal "
      "am Tag die Macht Dustys wirken lassen und alle Kreaturen in einem "
      "Raum komplett heilen - Dich mit eingeschlossen! (wirke dustys macht)"
      );
  Channel(sprintf("%s hat das Herz des Boesen auf Dustys Altar geopfert! "
        "Das Silberland hat damit mehr Zeit sich auf die Invasion des "
        "Boesen vorzubereiten!", TP->Name(WER)));
  ayla->command_me("sag Paladin, ich bin stolz auf Dich! Von Deiner "
      "Sorte gibt es nur Wenige. Meine Hochachtung!");
  call_other(PALADINMASTER, "SetQuestLvl16Solved");
  return ;
}

int update_wappenrock_glvl_filter(object ob) {
  if(ob->QueryProp(P_GUILD) == "paladine") return 1;
  return 0;
}

void update_wappenrock_glvl() {
  object *pal;
  object ob;
  int i;
  pal=filter_array(users(), "update_wappenrock_glvl_filter");
  for (i=sizeof(pal)-1;i>=0;i--) {
    ob=present(GUILDITEM_ID, pal[i]);
    if (ob) ob->update_glvl();
  }
  return ;
}

int _query_total_light() {
  return 2;
}
