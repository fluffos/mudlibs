/*
//
// Opferfunktion
//
*/
nosave int Do_Sacrifice(object item, int allflag) {
  int value;
  string fn, flag;
  object item2, *inv;
  mixed var;
  int nr, i;

  if(item->QueryProp(P_PALADIN_SACRIFICED) || 
      item->QueryProp(P_NEKRO_PESTERED))
  {
    if(TP->QueryProp(P_GUILD_LEVEL) > 10)
      call_other(NPCMASTER, "del_npc", TP); // Erniedrigt die "Faction" des 
                                          // Spielers bis hin zum Pal Feind.
    write("Du sinkst in Dustys Gnade!\n");
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-random(40));
    return 0;
  }
  value=(int)(item->QueryProp(P_VALUE)*(float)(random(6)+1)/5);
  if(item2=present(TASKITEM, TP)) { // fuer die Tasks
    fn=explode(file_name(item), "#")[0];
    var=item2->GetVar();
    flag=item2->GetFlag();
    if(fn==KETZER_AMULETT && item2->GetTask(5, TP) && test_bit(flag, 0)) {
      item2->SetFlag(1);
    }
    if(fn==NACHTKAEMPFER_SCHWERT && 
        item2->GetTask(12, TP) && test_bit(flag, 0))
    {
      item2->SetFlag(1);
    }
    if(member(DIEB_DOLCH, fn)!=-1 && item2->GetTask(7, TP) && 
        test_bit(flag, 0)) 
    {
      item2->SetFlag(1);
    }
  }
  write(BS(sprintf("Du kniest vor dem Altar nieder und opferst Dusty %s.",
        item->name(WEN))));
  say(BS(sprintf("%s kniet vor dem Altar nieder und opfert Dusty %s.\n", 
      TP->Name(WER), item->name(WEN))));
  if(opferreport) {
    TELL("dusty", sprintf("%s[PAL]%s Opfer von %s: %s (Wert: %d)\n", ANSI_RED,
          ANSI_NORMAL, TP->Name(WER), item->name(WEN), 
          item->QueryProp(P_VALUE)));
  }
  if( item2 = present(PALADINREVIVED, TP) )
  {
    call_other(PALADINMASTER, "SacrificeMoney", item2->QueryPaladin(), 3*value);
    call_other(item2, "opfer", 3*value);
  }
  else if(IsGuildMember(TP)) 
    call_other(PALADINMASTER,"SacrificeMoney",TP, value);
  call_other(ROOM("burg_schatzkammer"), "??");
  inv=filter_array(all_inventory(find_object(ROOM("burg_schatzkammer"))), 
      "treasure_check");
  if(sizeof(inv) > 100 && !cleanup) {
    cleanup=1;
    call_out("cleanup_treasure", 0, inv);
  } 
  if(!random(5) && item->QueryProp(P_VALUE)>1000)  {
    // -> ab in die Schatzkammer damit
    item->SetProp(P_PALADIN_SACRIFICED, getuid(TP));
    item->SetProp(P_NOBUY, 1);
    item->move(ROOM("burg_schatzkammer"), M_TPORT); 
  }
  else {
    item->remove();
    if(objectp(item)) item->destruct();
  }
  /*
  money_counter+=value;
  if(money_counter>50000) {
    if(! call_other(ROOM("burg_a2"), "_add_money_if_needed", money_counter))
      "p/daemon/zentralbank"->PayIn(money_counter, 100);
    money_counter=0;
  }
  */ 
  if(present(GUILDNPC_ID, ME)) {
    if(!allflag) 
      tell_room(ME, BSA(sprintf("Sehr gut, %s. Dieses Opfer hat Dusty "
          +"gefallen!\n", TP->Name(WER)), GUILDNPC_NAME+" spricht: "));
    if(TP->QueryProp(P_ALIGN)<1200)
      TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)+5+random(5));
  }
}


nosave int treasure_check(object ob) {
  if(!living(ob) && !ob->id(PALADIN_STANDARTE)) return 1;
  return 0;
}

void cleanup_treasure (object *inv) {
  int i,x;
  if(sizeof(inv) < 101) {
    cleanup=0;
    return;
  }
  x=sizeof(inv)-1;
  for (i=x; i>=(x-20);i--) {
    catch(inv[i]->remove());
  }
  inv-=({0});
  call_out("cleanup_treasure", 0, inv);
}

nosave int TestItem(object item) {
  if(!item->QueryProp(P_ARMOUR_TYPE) && !item->QueryProp(P_WEAPON_TYPE))
    return 0;
  if(item->QueryProp(P_CURSED)) return 0;
  if(item->QueryProp(P_AUTOLOADOBJ)) return 0;
  if(item->QueryProp(P_NEVERDROP)) return 0;
  if(item->QueryProp(P_NOSELL)) return 0;
  if(item->QueryProp(P_NODROP)) return 0;
  if(item->QueryProp(P_KEEP_ON_SELL)==getuid(TP)) return 0;
  if(!item->QueryProp(P_VALUE)) return 0;
  if(!item->QueryProp(P_SHORT)) return 0;
  if(item->QueryProp(P_INVIS)) return 0;
  if(!item->QueryProp(P_NAME)) return 0;
  if(item->QueryProp(P_WORN)) return 0;
  if(TP->QueryProp(P_WEAPON)==item) return 0;
  if(item->id(PALADINITEM)) return 0;
  return 1;
}

nosave void SacrificeAll() {
  int i,max;
  object *inv;
  inv=all_inventory(TP);
  inv=filter_array(inv,"TestItem",ME);
  if(!sizeof(inv)) {
    write(BS("Aber Paladin, Du hast doch gar nichts zum opfern dabei!"));
    return;
  }
  // write(sprintf("%O\n",inv));
  max=sizeof(inv)-1;
  if(max>MAX_OPFER) max=MAX_OPFER;
  for(i=max;i>=0;i--) {
    Do_Sacrifice(inv[i],i);
  }
  return;
}

nosave void SacrificeFrom(object container) {
  int i,max;
  object *inv;
  inv=all_inventory(container);
  inv=filter_array(inv,"TestItem",ME);
  if(!sizeof(inv)) {
    write(BS("Aber Paladin, " + container->name(WER) + " ist doch leer!"));
    return;
  }
  // write(sprintf("%O\n",inv));
  max=sizeof(inv)-1;
  if(max>MAX_OPFER) max=MAX_OPFER;
  for(i=max;i>=0;i--) {
    Do_Sacrifice(inv[i],i);
  }
  return;
}

nosave int Sacrifice(string str) {
  object item;
  object container;
  string what;
  
  if(!str) {
    write("Was moechtest Du opfern?\n");
    return 1;
  }
  if(str == "alles") {
    SacrificeAll();
    return 1;
  }
  if (sscanf(str, "alles aus %s", what)) {
    if (container=present(what, TP)) {
      SacrificeFrom(container);
      return 1;
    }    
  }
  if(!item=deep_present(str, TP)) {
    write("So etwas besitzt Du nicht!\n");
    return 1;
  }
  if(item->id("\nbrunnenherz"))
    if(call_other(PALADINMASTER, "QueryQuestLvl16")["player"] == getuid(TP)) {
      call_out("sacrificied_heart_lvl16",0);
      item->remove();
      return 1;
  }
  if(!item->QueryProp(P_ARMOUR_TYPE) && !item->QueryProp(P_WEAPON_TYPE)) {
    write("Du solltest nur Waffen und Ruestungen hier opfern!\n");
    return 1;
  }
  if(item->QueryProp(P_CURSED) || item->QueryProp(P_AUTOLOADOBJ) ||
     item->QueryProp(P_NEVERDROP) || item->QueryProp(P_NOSELL) || 
     item->QueryProp(P_NODROP)) {
    write(BS("Das kannst Du nicht opfern. Dusty wuerde dieses Opfer nicht "
        +"gefallen.\n"));
    return 1;
  }
  if(item->QueryProp(P_KEEP_ON_SELL)==getuid(TP)) {
    write(BS(sprintf("Du wolltest %s doch behalten!", item->name(WEN))));
    return 1;
  }
  if(!item->QueryProp(P_VALUE)) {
    write(BS(sprintf("Etwas so wertloses wie %s will Dusty nicht!", 
        item->name(WEN))));
    return 1;
  }
  if(item->QueryProp(P_WORN)) {
    write(BS(sprintf("Aber Du traegst %s doch, Paladin!", item->name(WEN))));
    return 1;
  }
  if(TP->QueryProp(P_WEAPON)==item) {
    write(BS(sprintf("Du hast %s doch gezueckt!", item->name(WEN))));
    return 1;
  }
  if(item->id(PALADINITEM)) {
    write("Die Ausruestung der Paladine brauchst Du hier nicht opfern!\n");
    return 1;
  }
  Do_Sacrifice(item,0);
  return 1;
}

nosave int falscher_syntax() {
  if(present(GUILDNPC_ID, ME)) {
    if(IsGuildMember(TP)) 
      tell_room(ME, BSA(sprintf("Du bist schon ein Paladin, %s! Nocheinmal "
        +"beitreten kannst Du nicht!\n", TP->Name(WER)), GUILDNPC_NAME 
        +" spricht: "));
    else   
      tell_room(ME, BSA(sprintf("So geht das nicht, %s! Die richtige Syntax "
        +"lautet: 'trete gilde bei'!\n", 
        TP->Name(WER)), GUILDNPC_NAME+" sagt: "));
  }
  else write("Die Syntax zum Beitreten lautet: 'tritt gilde bei'\n");
  return 1;
}

/*
//
// Austritt aus der Paladingilde
//
*/
int Leave_Ceremony() {
  object ayla;
  if(!ayla=present(GUILDNPC_ID, ME)) {
    write("Ohne Ayla von Schattengrund laeuft hier gar nichts!\n");
    return 1;
  }
  if(!IsGuildMember(TP)) {
    write("Du gehoerst nicht zum auserwaehlten Kreis der Paladine!\n");
    return 1;
  }
  if(ayla->QueryProp(P_NOATTACK) && !ayla->QueryProp(P_CHAT_CHANCE)) {
    write("Ayla ist schon in eine Zeremonie vertieft!\n");
    return 1;
  }
  ayla->SetProp(P_NOATTACK,"ist zu vertieft in die Zeremonie.");
  ayla->SetProp(P_CHAT_CHANCE,0);
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:100000, PARALYZE_MSG:"", 
           PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  LoadSequenz("leave.seq", TP, #'austreten);  
  return 1;
}

varargs int austreten(string msg) {
  object ob,ayla;
  string *who;

  if(!ayla=present(GUILDNPC_ID, ME)) {
    write("Ohne Ayla von Schattengrund laeuft hier gar nichts!\n");
    return 1;
  }
  ayla->SetProp(P_NOATTACK,0);
  ayla->SetProp(P_CHAT_CHANCE,1);
  TP->SetProp(P_PARALYZED, 0);
  who=({"Etwas", "Bruder", "Schwester"});
  TP->SetProp(P_GUILD_LEVEL, 0);
  WLOG("/log/gilden/paladine", "tritt aus der Gilde aus.");
  if(ob=present(GUILDITEM_ID,TP)) {
	  ob->SetProp(P_CURSED, 0);
	  ob->remove();
  }
  call_other(PALADINMASTER, "DeleteMember", TP);
  call_other(PALADINMASTER, "DeleteTopEntry", getuid(TP));
  call_other(ABILMASTER, "DeleteEntry", getuid(TP));
  if(msg) {
    Channel(msg);
  }
  else {
  Channel(sprintf("%s hat uns gerade verlassen! Moege Dusty Dir "
      +"trotzdem immer wohlgesonnen sein, %s!", TP->Name(WER), 
      who[TP->QueryProp(P_GENDER)]));
  }
  write_file(MEMBERLOG(getuid(TP)+".log"),
             dtime(time())+": "+CAP(getuid(TP))+" ist "
			 +"aus der Gilde ausgetreten.\n");
  return ::austreten();
}

/* 
//
// Beitrittsfunktion
//
*/
int tritt(string str) {
  string wo;
  string not_fail, g_indent, restr;
  mapping not_allowed;
  object ayla;

  // 'tritt'/'trete' -> aus der Soul
  if (!str || (str && present(str))) return 0;

  not_allowed=NOT_ALLOWED_MEMBER;

  g_indent=GUILDNPC_NAME+" teilt Dir mit: ";
  not_fail="Die Syntax zum Gildenbeitritt lautet: 'tritt gilde bei'!";

  if(sscanf(str, "%s bei", wo)!=1) {
    write(BSA(not_fail, g_indent));
    return 1;
  }
  if(member(not_allowed, getuid(TP))) {
     write(BS(sprintf("Du kannst den Paladinen nicht beitreten! Grund: %s. "
            "Fuer genauere Informationen kontaktiere bitte den "
            "Gildenerzmagier oder den Sheriff", not_allowed[getuid(TP)])));
     return 1;
  }
  if(wo!="gilde" && wo!="paladinen") {
    write(BSA("'"+wo+"' kannst Du hier nicht beitreten.", g_indent));
    write(BSA(not_fail, g_indent));
    // write(BSA(not_fail, g_indent));
    return 1;
  }
  /*
  if(!TP->QueryProp(P_TESTPLAYER) && !IS_WIZARD(TP)) {
    write("Zur Zeit duerfen nur Testspieler und Magier dieser Gilde "
         +"beitreten!\n");
    return 1;
  }
  */
  if(!ayla=present(GUILDNPC_ID, ME)) {
    write("Ohne Ayla von Schattengrund laeuft hier gar nichts!\n");
    return 1;
  }
  if(ayla->QueryProp(P_NOATTACK) && !ayla->QueryProp(P_CHAT_CHANCE)) {
    write("Ayla ist schon in eine Zeremonie vertieft!\n");
    return 1;
  } 
  if(IsGuildMember(TP)) {
    write(BSA("Aber Du bist doch schon Mitglied!",  
           GUILDNPC_NAME+" staunt: "));
     return 1;
  }
  if(restr=call_other(RES_CHECKER, "check_restrictions", TP,  
      QueryProp(P_GUILD_RESTRICTIONS))) 
  {
	  tell_room(ENV(TP), BSA(sprintf("Du erfuellst nicht alle Anforderungen, "
        +"um Paladin zu werden, %s! %s\n", TP->Name(WER), restr), 
        GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:100000, PARALYZE_MSG:"", 
           PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  ayla->SetProp(P_NOATTACK,"ist zu vertieft in die Zeremonie.");
  ayla->SetProp(P_CHAT_CHANCE,0);
  LoadSequenz("start.seq", TP, #'beitreten); 
  return 1;
}
 

int beitreten() {
  int b;
  object ob,ayla;
  string *who;

  if(!ayla=present(GUILDNPC_ID, ME)) {
    write("Ohne Ayla von Schattengrund laeuft hier gar nichts!\n");
    return 1;
  }
  ob=SwordClone(TP);
  ob->move(TP, M_NOCHECK);
  ayla->SetProp(P_NOATTACK,0);
  ayla->SetProp(P_CHAT_CHANCE,1);
  who=({"Etwas", "Bruder", "Schwester"});
  TP->SetProp(P_PARALYZED, 0);
  if((b=::beitreten())<0) return 1;
  write(BSA(sprintf("Sei willkommen, %s", TP->Name(WER)),
       GUILDNPC_NAME+" spricht erhaben: "));
  say(BSA(sprintf("Sei willkommen, %s", TP->Name(WER)),
       GUILDNPC_NAME+" spricht erhaben: "));
  write(BS(GUILDNPC_LONGNAME+" ueberreicht Dir den Wappenrock, welchen Du "
      +"sofort ueberziehst.\n"));
  say(BS(sprintf("%s ueberreicht %s einen Wappenrock, welchen %s sofort "
	  +"ueberzieht.\n", GUILDNPC_LONGNAME, TP->Name(WER),
      TP->QueryPronoun(WER))));
  ob=clone_object(ARMOUR("wappenrock"));
  ob->move(TP, M_NOCHECK);
  ob->DoWear(0);
  call_other(PALADINMASTER, "AddMember",TP);
  //say(BS(sprintf("%s gibt %s ein Pergament.\n", GUILDNPC_LONGNAME, 
  //    TP->Name(WER))));
  //write(BS(sprintf("%s gibt Dir ein Pergament.\n", GUILDNPC_LONGNAME)));
  //ob=clone_object(OBJ("pergament"));
  //ob->move(TP, M_NOCHECK);   
  WLOG("/log/gilden/paladine", "tritt in die Gilde ein.");
  call_other(PALADINMASTER, "AddMember", TP);
  TP->ModifySkill(FIGHT(WT_SWORD), QuerySkill(FIGHT(WT_SWORD)),100,"paladine");
  write_file(MEMBERLOG(getuid(TP)+".log"),
             dtime(time())+": "+CAP(getuid(TP))+" ist "
			 +"in die Gilde eingetreten.\n");
  Channel(sprintf("%s ist gerade den Paladinen beigetreten. Moege Dusty "
      +"Deinen Schwertarm staerken und Deinen Glauben festigen, um die "
      +"teuflischen Ausgeburten der Unterwelt zu vernichten, %s!",
      TP->Name(WER), who[TP->QueryProp(P_GENDER)]));
  call_other(PALADINMASTER, "AdvanceLevel", TP);
  return b;
}

/*
//
// Hier wird erhoeht
//
*/
advance(string str) {
  mixed res;
  mapping cond;
  int lvl;
  object ayla;

  notify_fail(BSA("Was willst Du erhoehen? Stufe(deaktiviert!!!)? Gildenstufe?, Kraft? "
			   "Int(elligenz)? Aus(dauer)? Gesch(icklichkeit)?\n", GUILDNPC_NAME
         +" sagt: "));
  if (!str) return 0;
  if (str == "stufe") return 0; // vorerst deaktiviert, da BUGGT was !!!
                                // es wird autom evtl. gildenstufe mit erhoeht !!!
  if(!ayla=present(GUILDNPC_ID)) {
    write("Hier ist leider niemand, der Dich erhoehen koennte!\n");
    return 1;
  }
  if(ayla->QueryProp(P_NOATTACK) && !ayla->QueryProp(P_CHAT_CHANCE)) {
    write("Ayla ist schon in eine Zeremonie vertieft!\n");
    return 1;
  } 
  if (str=="stufe" || str2attr(str)) {
	 return gilde::advance(str);
  }
  if(str=="gildenstufe" || str=="gilde" ) {
    if(!IsGuildMember(TP)) {
      tell_room(ME, BSA(sprintf("Du kannst hier nicht erhoehen, Du "
                +"bist keiner von uns, %s!\n", TP->Name(WER)), GUILDNPC_NAME
                +" sagt: "));
      return 1;
    }
    if(TP->QueryProp(P_GUILD_LEVEL)>=15) {
      write(BSA("Du kannst nicht mehr weiter aufsteigen!\n",
                GUILDNPC_NAME+" sagt: "));
      say(BSA("Du kannst nicht mehr weiter aufsteigen, "
              +CAP(getuid(TP))+".\n", GUILDNPC_NAME +" sagt: "));
      return 1;
    }
    lvl=TP->QueryProp(P_GUILD_LEVEL);
    cond=QueryProp(P_GUILD_LEVELS);
    res=call_other(RES_CHECKER, "check_restrictions", TP, cond[lvl+1]);
    if(!stringp(res) || IS_ARCH(TP)) {
      TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:100000, PARALYZE_MSG:"", 
            PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
      ayla->SetProp(P_NOATTACK,"ist zu vertieft in die Zeremonie.");
      ayla->SetProp(P_CHAT_CHANCE,0);
      LoadSequenz("advance.seq", TP, #'advance2);
      return 1;
    }
    else {
      if(res!="")
        tell_room(ME, BSA(sprintf("Du kannst noch nicht aufsteigen, %s! %s", 
            TP->Name(WER), res), GUILDNPC_NAME+" sagt: "));
      return 1;
    }
  }
  return 0;
}

varargs advance2() {
  mixed b;
  object ayla;
  if(ayla=present(GUILDNPC_ID)) {
    ayla->SetProp(P_NOATTACK,0);
    ayla->SetProp(P_CHAT_CHANCE,1);
  }
  TP->SetProp(P_PARALYZED, 0);
  if(!interactive(TP)) return; // Wer waehrend der sequenz netzttod wird,
                               // steigt nicht auf
  b=gilden_room::advance();
  if(b) {
    if(TP->QueryProp(P_GUILD_LEVEL)>14) {
      write_file(MEMBERLOG(getuid(TP)+".log"), dtime(time())+": "+
                 CAP(getuid(TP))+" hat " +"die hoechste Stufe erreicht.\n");
      Channel(sprintf("Hoert! Hoert! %s hat soeben die hoechste Stufe der "
          +"Paladine erreicht! Welch unglaubliche Leistung, Paladin! Wir "
          +"alle blicken heute voller Stolz auf Dich!", TP->Name(WER)));
      return b;
    }
    write_file(MEMBERLOG(getuid(TP)+".log"),
               dtime(time())+": "+CAP(getuid(TP))+" ist "
               +"eine Stufe (->"+TP->QueryProp(P_GUILD_LEVEL)+
                ") aufgestiegen.\n");
    Channel(CAP(getuid(TP))+" ist nach Ratschluss der allmaechtigen Dusty "
            +"in der Hierarchie der Paladine aufgestiegen und hat somit "
            +"Gildenstufe "
            +TP->QueryProp(P_GUILD_LEVEL)+" erreicht.");
    call_other(PALADINMASTER, "AdvanceLevel", TP);
    if(present(GUILDITEM_ID, TP))
      present(GUILDITEM_ID, TP)->update_glvl();
    return b;
  }
}

/*
//
// Spells lernen
//
*/

/* Skillablilty am Anfang in einen Bereich 3000..5000 setzen */
nosave int InitialSkillAbility(mapping ski, object pl) {
  int value;
  if (!ski || !pl) return 0;
  value=::InitialSkillAbility(ski, pl);
  if(value<3500) 
    value=3500;
  else if(value>4500) 
    value=4500;
  return value;
}

OwnLearnSpell(string str) {
  mapping sprueche;
  if(!present(GUILDNPC_ID, ME)) {
    write(BS(GUILDNPC_LONGNAME+" ist nicht hier. Du kannst ohne sie "
        +"nichts lernen!\n"));
    return 1;
  }
  if(!IsGuildMember(TP)) {
    tell_room(ME,BSA(sprintf("Du bist kein Paladin, %s!\n", TP->Name(WER)),
              GUILDNPC_NAME+" sagt: "));
    return 1;
  }
  notify_fail("Was moechtest Du hier lernen?\n");
  if(!str) {
    tell_room(ME, BSA(sprintf("Wie es scheint weisst Du selber nicht, "
              +"was Du lernen willst! Vielleicht solltest Du Dich noch "
              +"einmal nach den Zaubern erkundigen, %s?", TP->Name(WER)),
              GUILDNPC_NAME+" spricht: "));
    return 1;
  }
  return LearnSpell(str);
}

// Hier erfolgt die Ausgabe auf den Channel
/*nosave void Channel(string msg) {
  catch(VOICEMASTER->SendToChannel("Info",TO,SAY,msg));
}*/

// Hier erfolgt die Ausgabe auf den Channel
nosave void Channel(string msg) {
  CHMASTER->join("Info",TO);
  CHMASTER->send("Info",TO,msg,MSG_SAY);
}



// Ausgabe der Fertigkeiten
int faehigkeiten() {
  int i, wert;
  string *arm, s;
  mapping res;

  if(IS_WIZARD(this_player())) {
    write(BSA("Deine Skills: ", GUILDNPC_NAME+" sagt: "));
    s="";
    res = this_player()->QueryProp(P_NEWSKILLS);
    arm = m_indices(res);
    for (i = sizeof(arm)-1;i>=0;i--) {
      s += sprintf("%-15s",arm[i])+": ";
      if (mappingp(res[arm[i]])) s += res[arm[i]][SI_SKILLABILITY];
      else s += res[arm[i]];
      s += "\n";
      write(BSA(s, GUILDNPC_NAME+" sagt: "));
      s="";
    }
    return 1;
  }
  if(!present(GUILDNPC_ID, ME)) {
    write("Ohne Ayla von Schattengrund laeuft hier gar nichts!\n");
    return 1;
  }
  if(!IsGuildMember(TP)) {
    tell_room(ME, BSA(sprintf("Du dienst nicht der heiligen Dusty, %s! "
             +"Du wirst hier Deine kuemmerlichen Fertigkeiten nicht erfahren!",
             TP->Name(WER)), GUILDNPC_NAME+" spricht energisch: "));
    return 1;
  }
  write(BSA("Du beherrschst die heiligen Zauber wie folgt: ",
            GUILDNPC_NAME+" sagt: "));
  s="";
  res=this_player()->QueryProp(P_NEWSKILLS);
  arm = sort_array(m_indices(res), #'<);
  for (i = sizeof(arm)-1;i>=0;i--) {
    if(arm[i]!="Fight_sword") {
      s += sprintf("%-15s",CAP(arm[i]));
      s += " -";
      wert=TP->QuerySkillAbility(arm[i]);
      s+=int2string(wert);
      write(BSA(s, GUILDNPC_NAME+" sagt: "));
      s="";
    }
  }

  // Kleiner Joke :) --iwo
  if (random(1000)<1)
    write(BSA("Sudern          - goettlich."+s,
              GUILDNPC_NAME+" sagt: "));


  s=int2string(TP->QuerySkillAbility("Fight_sword"));
  write(BSA("Das Kaempfen mit dem Schwert beherrschst Du"+s,
            GUILDNPC_NAME+" sagt: "));
  if((wert=TP->QueryProp(P_GUILD_RATING))<1501) wert=1501;
  s=int2string(wert);
  write(BSA("In Summe gesehen bist Du"+s, GUILDNPC_NAME+" sagt: "));
  say(sprintf("%s klaert %s ueber %se Fertigkeiten auf.\n",
              GUILDNPC_LONGNAME, TP->Name(WER), TP->QueryPossPronoun(WESSEN)));
  return 1;
}

nosave string int2string(int wert) {
 string str;
 switch(wert) {
   case 0..500    : str=" wie ein Druide - naemlich ueberhaupt nicht.\n"; break;
   case 501..1000 : str=" fast ueberhaupt nicht.\n"; break;
   case 1001..1500: str=" miserabel wie ein Vagabund.\n"; break;
   case 1501..2000: str=" wie ein blutiger Anfaenger.\n"; break;
   case 2001..2500: str=" wie ein junger Knappe.\n"; break;
   case 2501..3000: str=" schlecht.\n"; break;
   case 3001..3500: str=" maessig.\n"; break;
   case 3501..4000: str=" mittelmaessig.\n"; break;
   case 4001..4500: str=" unterdurchschnittlich wie ein Soeldner.\n"; break;
   case 4501..5000: str=" durchschnittlich.\n";  break;
   case 5001..5500: str=" ueberdurchschnittlich.\n"; break;
   case 5501..6000: str=" gut.\n"; break;
   case 6001..6500: str=" sehr gut.\n"; break;
   case 6501..7000: str=" wie ein Burgwaechter.\n"; break;
   case 7001..7500: str=" wie ein hochdekorierter Veteran.\n"; break;
   case 7501..8000: str=" wie ein hochbegabter Meister.\n"; break;
   case 8001..8500: str=" beinahe engelgleich.\n"; break;
   case 8501..9000: str=" engelgleich.\n"; break;
   case 9001..9500: str=" legendaer.\n"; break;
   case 9501..9999: str=" beinahe goettlich.\n"; break;
   case 10000     : str=" goettlich.\n"; break;
  }
  return str;
}


nosave void LevelText(object pl) {
  write(BS("Du kniest vor dem Altar nieder und beginnst zu Dusty "
         "zu beten.\n"));
  say(BS(CAP(getuid(pl))+ " kniet vor dem Altar nieder und beginnt zu "
         "Dusty zu beten.\n"));
  return ;
}



/*
//
// Schwertskill
//
*/
mapping SwordFight(object user, string sname, mapping sinfo)
{
  int abil, ud, rnd, align, val, waf, vorher;
  object schild;
  int schilddam;
  mixed h;
  if(user->QueryProp(P_TESTPLAYER)) tell_object(user, BS(sprintf("## SwordFight user=%O sname=%O sinfo=%O", user, sname, sinfo)));

  if(!mappingp(sinfo)) return 0;
  // bugfix fuer schon tote NPC's
  if(!objectp(sinfo[SI_ENEMY])) return sinfo;
  abil=sinfo[SI_SKILLABILITY];
  ud=sinfo[SI_USR];
  vorher=sinfo[SI_SKILLDAMAGE];
  // Wenn keine Waffe gezueckt -> return
  if(!objectp(user->QueryProp(P_WEAPON))) return sinfo;
  if(!intp(align=user->QueryProp(P_ALIGN))) align=0;
  if (align > 1100) align = 1100;
  //val=abil*(user->QueryAttribute(A_DEX)+user->QueryProp(P_ALIGN)/50+
  //    user->QueryAttribute(A_STR))/MAX_ABILITY;
  val=to_int(1.5*abil*(user->QueryAttribute(A_DEX)+align/50+
      user->QueryAttribute(A_STR))/MAX_ABILITY);

  sinfo[SI_SKILLDAMAGE]+=(val/2)+random(val/2);

  if(HAS_BLESSING(user, BLESSING_BLAZING_GAZE) && user->QueryProp(P_TMP_PALADINE_BLAZING_GAZE) == sinfo[SI_ENEMY]) {
    sinfo[SI_SKILLDAMAGE] += (int) (val * (user->QueryProp(P_GUILD_LEVEL)/100.0));
  }

  if(align>500+random(500) && !random(400)) {
    tell_object(user, "Dusty segnet Deine Attacke!\n");
    sinfo[SI_SKILLDAMAGE]+=500;
  }
  if(abil>8000 && align>(700+random(300))) { 
    sinfo+=([SI_SPELL:
           ([SP_REDUCE_ARMOUR:([P_BODY:100-random((abil-8000)/100)]),
             SP_NAME:"Schwertattacke", SP_SHOW_DAMAGE:1, 
             SP_PHYSICAL_ATTACK:1])]);
  }
  if(abil>(5000+random(5000)) && align>(600+random(500))) {
    if((rnd=45-user->QueryAttribute(A_DEX))<5) rnd=5;
    if(!random(rnd)) {
      tell_object(user, "Dein Glaube verleiht Deiner Waffe in der "
          +"naechsten Attacke Fluegel!\n");
      user->ModifySkillAttribute(user,SA_SPEED,200,2+random(3));
    }
  }
  if(abil>8000 && !random(12)) {
    if(!catch(schild=user->QueryArmours(AT_SHIELD)[0]) && sinfo[SI_ENEMY] &&
        align > 1000)
    {
      if (!((h=user->QueryProp(P_TMP_DEFEND_HOOK))  && h[2]=="schildparade_func"))
      {
        schilddam=schild->QueryProp(P_AC)+schild->QueryProp(
            P_PALADIN_SCHILDPARADE_AC)/2+schild->QueryProp(P_WEIGHT)/75 +
            schild->QueryProp(P_EFFECTIVE_WC)/10;
        schilddam*=(random(3)+3);
        tell_object(user, "Du attackierst mit Deinem Schild! Fuer Dusty!\n");
        tell_room(ENV(user), sprintf("%s attackiert mit %sem Schild.\n", 
              user->Name(WER), user->QueryPossPronoun(WESSEN)),({user}));
        if( sinfo[SI_ENEMY] )
          sinfo[SI_ENEMY]->Defend(schilddam, ({DT_BLUDGEON}), 
              ([SP_NAME:"schildschlag", SP_SHOW_DAMAGE:1, SP_PHYSICAL_ATTACK:1,
                SP_NO_ENEMY: 1]), user);
        if(sinfo[SI_ENEMY] && sinfo[SI_ENEMY]->QueryProp(P_SIZE) <= 250 && 
            schilddam > (sinfo[SI_ENEMY]->QueryAttribute(A_STR)*40) &&
            random(100) >= sinfo[SI_ENEMY]->QueryProp(P_NOMAGIC))
        {
          tell_room(ENV(user), sprintf("%s faellt zu Boden!\n", 
                sinfo[SI_ENEMY]->Name(WER)));
          sinfo[SI_ENEMY]->SetProp(P_DISABLE_ATTACK, 1 + random(2));
          sinfo[SI_ENEMY]->SetProp("last_rammen_time", time());
        }
      }
    }
  }
  // Als Frosch wollen wir nicht mehr lernen :)
  if(user->QueryProp(P_FROG)) return sinfo;
  // Und ab jetzt brauchen wir ein einigermassen gutes Schwert
  waf=user->QueryProp(P_WEAPON)->QueryProp(P_WC);
  if (waf<(user->QueryAttribute(A_DEX))*10/2) return sinfo;
  // Lernen
  if(!sinfo[SI_ENEMY]) return sinfo;
  if( sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > abil/400 && ++ud>abil/40 &&
      abil < MAX_ABILITY) 
  {
    ud=0;
    abil+=(user->QueryAttribute(A_DEX)+align/100)/3;
    if (abil >= MAX_ABILITY)
      player->Message("Ayla teilt Dir mit: Du beherrscht den Schwertkampf "
          "nun goettlich!!!\n", MSGFLAG_TELL);
  }
  if (abil > MAX_ABILITY)
    abil = MAX_ABILITY;
  user->ModifySkill(FIGHT(WT_SWORD), ([SI_USR: ud, SI_SKILLABILITY: abil]),
        100, "paladine");
  //tell_object(find_player("angrox"), sprintf( "### SWORD-Bonus von %s:  vorher %d  nacher %d  val %d = %d Proz\n",
  //    user->Name(WER),vorher,sinfo[SI_SKILLDAMAGE], val,
  //     to_int(100*sinfo[SI_SKILLDAMAGE]/vorher)));

  return sinfo;
 }

/*
//
// Task mitloggen
//
*/
nosave void LogTask(object pl, int stufe) {
  if(call_other(PALADINMASTER, "CheckTask", pl, stufe) &&
	  stufe==15 && stufe==6) return;
  write_file(MEMBERLOG(getuid(pl)+".log"),
             dtime(time())+": "+CAP(getuid(pl))+" hat Aufgabe "
             +stufe+" geloest.\n");
  return;
}

/*
//
// Funktionen, die die Bedingungen fuer den Gildenaufstieg ueberpruefen
// --------------------------------------------------------------------
*/

/*
//
// Paladine muessen XPs sammeln UND Waffen und Ruestungen spenden.
// Flag = 0 ... Money
// Flag = 1 ... XP
//
*/
nosave string money_or_xp_check(object pl, int value, int flag) {
  string str;
  int percent, x,lvl;
  string *what;
  str="";
  lvl=pl->QueryProp(P_GUILD_LEVEL);
  what=({"Ruestungen und Waffen opfern", "Erfahrung sammeln"});
  if(!flag) {
	  if(x=call_other(PALADINMASTER, "GetMoneyDifference", pl)) 
	    str="Von den Waffen und Ruestungen, die Du opfern musst, "
	       +"fehlen Dir ";
  }
  else  {
	  if(x=call_other(PALADINMASTER,"GetXpDifference",pl)) 
	    str="Von den Erfahrungen, die Du benoetigst, fehlen Dir ";
  }
  if(x<=1) return 0;
  percent=100*x/value;
  //write("\n"+percent+"\n");
  switch (percent) {
    case 0..10:  str+="fast gar keine mehr.";
                 break;
    case 11..20: str+="weniger als ein Viertel.";
                 break;
    case 21..30: str+="etwa ein Viertel.";
                 break;
    case 31..40: str+="weniger als die Haelfte.";
                 break;
    case 41..60: str+="in etwa die Haelfte.";
                 break;
    case 61..70: str+="mehr als die Haelfte.";
                 break;
    case 71..80: str+="etwa drei Viertel.";
                 break;
    case 81..90: str+="mehr als drei Viertel.";
                 break;
    case 91..100: str+="beinahe alle.";
                  break;
    default:      str+="beinahe alle.";
                  call_other(PALADINMASTER, "SetXp",pl,
                      pl->QueryProp(P_XP)+xp_per_level[lvl-1]);
                  break;
  }
  return str+" ";
}

nosave string Test(string str,int akt,int min,int max) {
  string out;
  int percent;
  out="";
  if(akt<max*MAX_ABILITY/100) {
    percent=100-(akt-min*100)/(max-min);
//    write(percent+"\n");
    out+="Du musst "+str+" ";
    switch (percent) {
      case -10000..10:  
                   out+="noch eine Winzigkeit mehr";
                   break;
      case 11..20: out+="nur noch sehr minimal";
                   break;
      case 21..30: out+="noch sehr wenig";
                   break;
      case 31..40: out+="noch ein wenig";
                   break;
      case 41..60: out+="etwa nochmal soviel";
                   break;
      case 61..70: out+="noch mehr";
                   break;
      case 71..80: out+="noch viel";
                   break;
      case 81..90: out+="noch sehr viel";
                   break;
      case 91..100: out+="noch unglaublich viel";
                    break;
      default:      out+="noch ungewoehnlich viel";
                    write_file(LOG("erhoehe"), sprintf(
                      "%s: Ungereimtheit beim Erhoehen: TP: %s, SPELL: %s, "
                      "Akt: %d, Min: %d, Max: %d\n",
                    dtime(time()), CAP(getuid(TP)), str, akt, min*100, 
                    max*100));
                    break;
    }
    out+=" ueben. ";
  }
  return out;
}



string LConds(object pl) {
  int lvl;
  string str;
  mixed var;
  str="";
  lvl=pl->QueryProp(P_GUILD_LEVEL);
  if(pl->QueryProp(P_FROG))
     return BSA("Wie kannst Du es wagen, Dusty als Frosch "
          +"um eine Erhoehung anzuflehen? VERSCHWINDE!", 
          GUILDNPC_NAME+" donnert: ");
  if(pl->QueryProp(P_GHOST))
     return BSA("Gehe zuerst beten! Nur in der Stofflichkeit kannst "
           +"Du Dusty um die Gnade einer Erhoehung anflehen!",
           GUILDNPC_NAME+" spricht: ");
  if(!IsGuildMember(pl)) return 0;
  if(stringp(var=money_or_xp_check(pl,money_per_level[lvl-1], 0)))
      str+=var;
  if(stringp(var=money_or_xp_check(pl,xp_per_level[lvl-1], 1)))
      str+=var;
  switch(lvl+1) {
    case  2: str+=Test("den 'Schwertkampf'",
                 pl->QuerySkillAbility(FIGHT(WT_SWORD)),   0, 7);
             str+=Test("'Erblicke'",
                 pl->QuerySkillAbility("erblicke"),        0,36);
             str+=Test("'Schaetz'",
                 pl->QuerySkillAbility("schaetz"),         0,36);
             break;
    case  3: str+=Test("den 'Schwertkampf'",
                 pl->QuerySkillAbility(FIGHT(WT_SWORD)),   7,14);
             str+=Test("'Erblicke'",
                 pl->QuerySkillAbility("erblicke"),       36,40);
             str+=Test("'Schaetz'",
                 pl->QuerySkillAbility("schaetz"),        36,40);
             str+=Test("'Heiligenschein'",
                 pl->QuerySkillAbility("heiligenschein"),  0,36);
             str+=Test("'Schildparade'",
                 pl->QuerySkillAbility("schildparade"),    0,40);
             break;
    case  4: str+=Test("den 'Schwertkampf'",
                 pl->QuerySkillAbility(FIGHT(WT_SWORD)),  14,21);
             str+=Test("'Erblicke'",
                 pl->QuerySkillAbility("erblicke"),       40,44);
             str+=Test("'Schaetz'",
                 pl->QuerySkillAbility("schaetz"),        40,44);
             str+=Test("'Heiligenschein'",
                 pl->QuerySkillAbility("heiligenschein"), 36,40);
             str+=Test("'Schildparade'",
                 pl->QuerySkillAbility("schildparade"),   40,48);
             str+=Test("'Verbannung'",
                 pl->QuerySkillAbility("verbannung"),      0,40);
             str+=Test("'Behandle'",
                 pl->QuerySkillAbility("behandle"),        0,40);
             break;
