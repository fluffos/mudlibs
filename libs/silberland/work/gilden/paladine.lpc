//
// init()
//
void init() {
  mixed help_mixed;
  mapping help_map;
  ::init();
  // Feuerhand -> Elementarhand 
  if(TP->QueryProp(P_GUILD)=="paladine" && 
      (help_map=TP->QuerySkill("stossgebet"))) 
  {
    help_mixed=TP->QueryProp(P_NEWSKILLS);
    help_mixed=m_delete(help_mixed, "stossgebet");
    TELL("angrox", sprintf("PALADINGILDE(init): TP: %O, %O\n",TP,help_map));
    help_mixed+=(["eifer":help_map]);
    TP->SetProp(P_NEWSKILLS, help_mixed);
  }  
}




/*
//
// FEHLERAUSGABE
//
*/
nosave int _error(string msg) {
  write(BS(msg));
  tell_angrox(msg);
  tell_zordan(msg);
  write_error_log(msg);
  return 1;
}



/*
//
// Longerweiterungen incl. Magierfkten
//
*/
nosave string altar() {
  string str;
  str="Ein unaussprechbar schoener Altar steht im oberen Teil des "
      "Rittersaales. Auf ihm steht ein kleines Abbild und mehrere Kerzen. "
      "Links neben dem Altar befindet sich eine Opferstelle und direkt vor "
      "dem Altar wurde eine kleine Statue mit einer Liste darauf plaziert.";
  if(present(GUILDNPC_ID, ME)) {
    str+=" Ayla steht vor dem Altar.";
  }
  return BS(str);
}

nosave string aligntest() {
  if(TP->QueryProp(P_RACE) == "Dunkelelf") {
    return "Als Dunkelelf fuehlst Du Dich hier sehr unwohl!";
  }
  if(TP->QueryProp(P_ALIGN)<0) {
    return "Allerdings fuehlst Du Dich mit Deiner boesen Gesinnung nicht "
           +"wohl hier.";
  }
  return "Mit Deiner Gesinnung fuehlst Du Dich hier wie daheim.";
}

nosave string maghelp() {
  string str;

  if(!IS_LORD(TP)) return "";
  str = "\nMagInfo: Hilfe fuer Magierbefehle mit 'gilde hilfe'.";

  if (cast_disabled) str += "\n\nZAUBERN IST DEAKTIVIERT!!!\n";

  return str;
}

nosave int magfunc(mixed str) {
  mixed *txt;
  object ob;
  int err, task;
  string name;
  if(!IS_LORD(TP)) return 0;
  if(!str) str="hilfe";
  if(str=="hilfe") {
    write("Folgende Befehle sind moeglich:\n"
          " gilde hilfe                  : Dieses hier\n"
          " gilde toplist                : Updaten der Topliste\n");
    if (IS_ARCH(TP) || getuid(TP)=="zordan" || getuid(TP)=="iwo") {
      write(
            " gilde zaubern (ein|aus)      : Zaubern (de-)aktivieren\n"
            " gilde backup                 : Backup des Memberfiles\n"
            " gilde restore                : Zurueckspielen des Backups\n"
            " gilde set_task <name> <task> : Setzen eines Tasks\n"
            " gilde del_task <name> <task> : Loeschen eines Tasks\n"
            " gilde memberdel <name>       : Spieler aus Gilde loeschen\n");
    }
    return 1;
  }
  txt=explode(str, " ");
  if(member(({"backup", "restore", "set_task", "del_task", "memberdel", "zaubern"}), 
      txt[0])!=-1) 
  {
    if(!IS_ARCH(TP) && getuid(TP)!="zordan" && getuid(TP)!="iwo") {
      write_secure_log(sprintf("Versuchte Aenderung im Gildenmaster (%s) "
		      +"von %s\n", str, CAP(getuid(TP))));
      write("Befehl nicht ausfuehrbar! Grund: Magierlevel < 60\n");
      tell_angrox(sprintf("%s***%s Versuchte Aenderung im Gildenmaster von "
          "%s!\n", ANSI_BLINK+ANSI_RED, ANSI_NORMAL, CAP(getuid(TP))));
      return 1;
    }
    else write_file(LOG("changes"), sprintf("Aenderung im Gildenmaster"
          +"(%s): gilde %s\n", CAP(getuid(TP)), str));
  }

  // Huer wird zaubern ein- oder ausgeschaltet (Iwo)
  if (txt[0] == "zaubern")
    {
      if (sizeof(txt)<2)
        {
          tell_object(TP, "Syntax: gile zaubern (ein|aus)\n");
          return 1;
        }

      if (txt[1] == "ein")
        {
          tell_object(TP, "Zaubern ist nun EINgeschaltet!\n");
          cast_disabled = 0;
        }
      else if (txt[1] == "aus")
        {
          tell_object(TP, "Zaubern ist nun AUSgeschaltet!\n");
          cast_disabled = 1;
        }
      else
        tell_object(TP, "Stoned, eh?\n");
         
      return 1;

    }


  if(txt[0]=="memberdel") {
   if(sizeof(txt)<2) {
     tell_object(TP, "Syntax: gilde memberdel <name> \n");
     return 1;
   }
   name=lower_case(to_string(txt[1]));
   err=call_other(PALADINMASTER, "DeleteMember", name);
   if(err!=1)
      tell_object(TP, sprintf("DeleteMember: Fehler. Code %d\n", err));
   else tell_object(TP, "paladinmaster: DeleteMember ok!\n");
   err=call_other(PALADINMASTER, "DeleteTopEntry", name);
   if(err!=1) 
     tell_object(TP, sprintf("DeleteTopEntry: Fehler. Code %d\n", err));
   else tell_object(TP, "paladinmaster: DeleteTopEntry ok!\n");
   err=call_other(ABILMASTER, "DeleteEntry", name);
   if(err!=1) 
     tell_object(TP, sprintf("Abilmaster, DeleteEntry: Fehler. Code %d\n", 
         err));
   else tell_object(TP, "abilmaster: DeleteEntry ok!\n");
    tell_object(TP, "Spieler aus Gilde geloescht!\n");
    return 1;

  }
  if(txt[0]=="backup") {
    call_other(PALADINMASTER, "DoBackup"); 
    tell_object(TP, 
      "Kopiere members/members.o nach backup/members_backup.o\n");
    return 1;
  }
  if(txt[0]=="restore") {
    if(call_other(PALADINMASTER, "DoRestore")==-2) {
      tell_object(TP, 
        "Fehler! Members.o konnte nicht restored werden!\n");
      return 1;
    } 
    tell_object(TP, 
      "Kopiere backup/members_backup.o nach members/members.o\n");
    return 1;
  }
  if(txt[0]=="toplist") {
    toplist_update();
    tell_object(TP, "Memberliste ist in wenigen Sekunden Up-to-date!\n");
    return 1;
  }
  if(txt[0]=="set_task") {
    if(sizeof(txt)<3) {
      tell_object(TP, "Syntax: gilde set_task <name> <Task>\n");
      return 1;
    }
    task=to_int(txt[2]);
    name=lower_case(to_string(txt[1]));
    if(!(ob=find_player(name)) && !(ob=find_netdead(name))) {
      tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
      return 1;
    }
    err=call_other(PALADINMASTER, "SetTask", ob, task);
    if(err!=1) {
       tell_object(TP, sprintf("Fehler. Code %d\n", err));
       return 1;
    }
    tell_object(TP, "Task wurde erfolgreich gesetzt.\n");
    return 1;
 } 
 if(txt[0]=="del_task") {
   if(sizeof(txt)<3) {
     tell_object(TP, "Syntax: gilde del_task <name> <Task>\n");
     return 1;
   }
   task=to_int(txt[2]);
   name=lower_case(to_string(txt[1]));
   if(!(ob=find_player(name)) && !(ob=find_netdead(name))) {
     tell_object(TP, "Spieler nicht im Speicher. Abbruch.\n");
     return 1;
    }
   err=call_other(PALADINMASTER, "DeleteTask", ob, task);
   if(err!=1) {
      tell_object(TP, sprintf("Fehler. Code %d\n", err));
      return 1;
   }
    tell_object(TP, "Task wurde erfolgreich geloescht.\n");
    return 1;
  }
  tell_object(TP, "Diesen Befehl gibt es nicht!\n");
  return 1;
}

