int check_ayla() {
  object ob;
  if(!present("ayla")) {
    ob=clone_object(NPC("ayla"));
    ob->move(ME, M_GO);
  }
  return 1;
}

/* Fuer den geheimen Abgang */
nosave string det_arm() {
  if(present(GUILDNPC_ID, ME)) 
    return BS(sprintf("Du koenntest den Arm nach unten druecken, aber "
        "solange %s im Raum ist, traust Du Dich nicht "
        "wirklich.", GUILDNPC_NAME));
  return BS(sprintf("%s ist nicht da, du koennest versuchen, den Arm "
      "nach unten zu druecken.",
      GUILDNPC_NAME));
}

int arm_druecken(string str) {
  if(!str) return 0;
  if(str!="arm nach unten" && str!="arm herunter")
    return 0;
  if(!ayla_abgelenkt && present(GUILDNPC_ID, ME)) {
    tell_object(TP, BS(sprintf("%s ist nicht abgelenkt. Wenn sie Dich dabei "
        "erwischt, wird sie Dich vermutlich umbringen. Du laesst es lieber "
        "sein.", GUILDNPC_NAME)));
    return 1;
  }
  tell_room(ME, BS(sprintf("%s sieht sich schnell um und drueckt "
      "unauffaellig den Arm der Statue nach unten.", TP->Name(WER))),({TP}));
  tell_object(TP, BS("Du schaust Dich schnell um und drueckst den Arm nach "
      "unten."));
  call_out("OpenSecret", 4);
  return 1;
}

nosave int OpenSecret() {
  object ob;
  tell_room(ME, "Ploetzlich oeffnet sich hinter dem Altar eine Oeffnung nach "
      "unten!\n");
  if(!ayla_abgelenkt && ob=present(GUILDNPC_ID)) {
    ob->command_me("prufe Alarm! Eindringliche versuchen "
        "zur Schatzkammer vorzudringen! Alarm!");
    ob->command_me("sag DAS WIRST DU BUESSEN, FREVLER!");
    ob->Kill(TP);
    AddExit("unten", ([EX_DEST:ROOM("burg_geheim1"),
                       EXG_ID:GUILDNPC_ID,
                       EXG_PLMSG:BSA("Hier darfst Du nicht runter", 
                                     GUILDNPC_NAME+" sagt: "),
                       EXG_RMMSG:BS(sprintf("%s versucht nach unten zu "
                                     "gehen, aber %s laesst %s nicht.",
                                     TP->Name(WER), GUILDNPC_NAME,
                                     TP->QueryPronoun(WEN)))]));
  }
  else {
    AddExit("unten", ROOM("burg_geheim1")); 
  }
  call_other(ROOM("burg_geheim1"), "set_next_reset", 1800);
  call_other(ROOM("burg_geheim2"), "set_next_reset", 1800);
  call_other(ROOM("burg_geheim3"), "set_next_reset", 1800);
  call_other(ROOM("burg_geheim1"), "SetOpen", 1);
  set_next_reset(1800);
  if(!find_player("dusty")) 
    opferreport=0;
  return 1;
}

int ayla_ablenken(string str) {
  string wen, was;
  object ob;
  notify_fail("Wen willst Du mit was ablenken?\n");
  if(!str) return 0;
  if(sscanf(str, "%s mit %s ab", wen, was)!=2) return 0;
  if(!present(GUILDNPC_ID) || lower_case(wen)!="ayla") return 0;
  if(!ob=present(was, TP)) {
    write("So was hast Du doch gar nicht!\n");
    return 1;
  }
  tell_room(ME, BS(sprintf("%s versucht Ayla mit %s abzulenken.", 
       TP->Name(WER), ob->name(WEN))), ({TP}));
  tell_object(TP, "Du versuchst Ayla abzulenken.\n");
  if(!ob->id("\ndustyruestung")) {
    find_living("ayla")->command_me("sag Hm, interessant. Wenn Du mich "
        "mit etwas begeistern willst, dann zeig mir doch eine "
        "von den Ruestungen, die von Dusty extra bestellt wurden.");
    return 1;
  }
  find_living("ayla")->command_me("sag Ah, lass mal sehen.");
  tell_room(ME, sprintf("%s lenkt %s ein wenig ab.\n", TP->Name(WER),
      GUILDNPC_NAME), ({TP}));
  tell_object(TP, sprintf("Du lenkst %s ein wenig ab.\n", GUILDNPC_NAME));
  ayla_abgelenkt=TP;
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:5,
                             PARALYZE_MSG: BS("Du lenkst gerade "+
                                GUILDNPC_NAME+" ab!")]));
  call_out("ayla_nicht_abgelenkt", 10);
  return 1;
}

nosave int ayla_nicht_abgelenkt() {
  ayla_abgelenkt=0;
  find_living("ayla")->command_me("sag Danke! Das ist wirklich eine "
      "goettliche Ruestung!");
  tell_room(ME, sprintf("%s ist nun nicht mehr abgelenkt!\n", GUILDNPC_NAME));
  return 1;
}

/*
//
// Reset -> TopListe updaten
//
*/
reset() {
  ::reset();
  zaehler++;
  if(zaehler>=5) {
    call_other(PALADINMASTER, "DoBackup"); 
    zaehler=0;
  }
  RemoveExit("unten");
  if(find_call_out("ayla_nicht_abgelenkt")==-1)
    ayla_abgelenkt=0;
  // Fuer die Schatzkammer:
  call_other(ROOM("burg_geheim1"), "SetOpen", 0);
  call_out("update_wappenrock_glvl", random(20)+10);
}

