void create() {
  ::create();
  SetProp( P_INT_SHORT, "Im Burgfried der Burg Sturmfels" ); 
  SetProp( P_INT_LONG, 
    "Du findest Dich in einem prunkvollen Rittersaal wieder. Ein roter "
    "Teppich fuehrt ein paar flache Stufen zu einem Altar hinauf. Vor dem "
    "Altar steht eine kleine Statue mit einer Liste darauf. Links und "
    "rechts stehen vor den Waenden mehrere Ritterruestungen in Reihe. "
    "Samtweiche Vorhaenge mit heiligen Symbolen an der Wand wehen sanft im "
    "Wind. Du spuerst in jedem Koerperteil eine starke heilige Praesenz und "
    "bist Dir ziemlich sicher, dass Du in der Gilde der Paladine gelandet "
    "bist. Es herrscht eine angenehme Ruhe im ganzen Saal. @@aligntest@@ "
    "@@maghelp@@");

  AddReadDetail( ({"liste", "topliste"}), "@@liste@@");

  AddSpecialDetail( ({ "altar" }), "altar" );

  AddDetail( ({ "rittersaal","saal" }), QueryProp(P_INT_LONG)[0..<27]);

  AddDetail( ({ "decke" }),
    "Die Decke ist wirklich sehr weit oben. An ihr haengt ein grosser "
    "Kronleuchter.");

  AddDetail( ({ "kronleuchter","leuchter" }),
    "Der goldene Kronleuchter ist wahrhaftig riesig und erhellt diesen "
    "Saal wohl auch, wenn das Boese ihn betritt.");

  AddDetail( ({ "boden" }),
    "Auf dem steinernen Boden liegt ein roter Teppich.");

  AddDetail( ({ "gesinnung" }),
    "Du solltest schon selber wissen, wie Deine Gesinnung ist.");

  AddDetail( ({ "dunkelelf","dunkelelfen","feind","feinde","ort" }),
    "Ihr seid die Feinde der Paladine. Vielleicht ist es besser, Du "
    "wendest Dich ganz schnell diesem Ort ab.");

  AddDetail( ({ "ruhe","haut" }),
    "Seltsam, man kann hier die Ruhe sogar auf der Haut spueren.");

  AddDetail( ({ "praesenz" }),
    "Du vibrierst unter dieser goettlichen Praesenz. Du traust Dich kaum ein "
    "Wort zu sagen oder etwas Frevelhaftes zu tun.");

  AddDetail( ({ "wort","piep" }),
    "Du willst grad 'Piep' sagen, aber brichst es wirklich ab.");

  AddDetail( ({ "frevelhaftes" }),
    "Nein, Du traust Dich einfach wirklich nicht!");

  AddDetail( ({ "koerperteil" }),
    "Ja, wirklich in jedem Koerperteil nimmst Du goettliche Praesenz wahr.");

  AddDetail( ({ "vorhaenge","vorhang" }),
    "Ein paar Vorhaenge haengen an den Waenden. Sie beinhalten heilige "
    "Symbole und wehen im Wind.");

  AddDetail( ({ "symbole","symbol","form" }),
    "Die Symbole stellen das Gute in jeder nur denkbaren Form dar.");

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind mit vielen kleinen Ornamenten verziert. In einer "
    "langen Reihe stehen Ritterruestungen davor. Ein paar Vorhaenge wehen "
    "im Wind.");

  AddDetail( ({ "ornamente","ornament" }),
    "Unzaehlbar viele Ornamente verzieren die Waende. Sie verleihen dem "
    "Saal eine wirklich goettliche Ausstrahlung.");

  AddDetail( ({ "reihe" }),
    "Die Ritterruestungen reichen vom Eingang bis zu den Stufen des Altar "
    "hin.");

  AddDetail( ({ "ritterruestungen","ruestungen","ritter" }),
    "Viele veschiedene Ritterruestungen wurden hier aufgestellt. Sie wurden "
    "im Laufe der Zeit gesammelt und zeigen deutlich die Staerke und Macht "
    "der Paladine.");

  AddDetail( ({ "staerke","macht" }),
    "In Worte kann man sie nicht mehr ausdruecken. Sei froh, wenn Du nicht "
    "von ihr getroffen wirst.");

  AddDetail( ({ "laufe","zeit" }),
    "Das reicht von dem Zeitpunkt an, wo Dusty das Silberland erschaffen "
    "hat.");

  AddDetail( ({ "zeitpunkt" }),
    "Genaueres ist ueber diesen Zeitpunkt leider nicht mehr bekannt.");

  AddDetail( ({ "statue" }),
    "Die Statue zeigt einen alten und erfahrenen Paladin. In seinen Haenden "
    "liegt eine Liste.");

  AddDetail( ({ "haende","hand" }),
    "Der alte Paladin haelt eine Liste in seinen Haenden.");

  AddDetail( ({ "liste" }),
    "Das ist eine Liste der Paladine. Du kannst sie lesen. Als Die Liste "
