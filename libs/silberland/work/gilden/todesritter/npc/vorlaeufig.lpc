/*
 * Vorlaeufiger Gildennpc by gwenshara
*/

#include "../dk.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Fuerstkomtur Helme Haffax, der vorlaeufige Obermotz");
  SetProp(P_LONG,
    "Das ist Helme, der alte Schwerenoeter. Ein Pakt und ein Splitter. "
    "Also ein echtes Seicherl... zum Glueck is' er ja nur vorlaeufig da!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Helme Haffax");
  SetProp(P_GENDER, MALE);
  AddId(({"helme", "haffax", "helme haffax", GUILDNPC_ID}));
  SetProp(P_ARTICLE, 0);

//set_living_name("");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(50);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 186);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
 // AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"ritter","todesritter"}),
    "Ich bin nur als Aushilfe da! Frag den Chef wenn er wieder kommt.",
    "sagt: ");
  SetProp(P_NOATTACK, 1);
}

