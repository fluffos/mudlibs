// Todesritter entwaffnen objekt

#include "../dk.h"

inherit "std/thing";

string waffe;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  waffe = "";
//--Beschreibungen---------------------------------------------------------

  SetProp(P_INVIS, 1); // Unsichtbar

//--Namen------------------------------------------------------------------

  AddId("\ntodesritter_entwaffnen");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}

void wield_weapon_in(int sek, string id)
{
  waffe=id;
  call_out("zuecken", sek);
}

void zuecken()
{
  if(!living(ENV(ME)))
  {
    remove(1);
    return;
  }
  ENV(ME)->command_me("zuecke "+waffe);
  remove(1);
  return;
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  if(!living(ENV(ME)))
    remove(1);
}
