// Todesritter entwaffnen objekt

#include "../dk.h"

inherit "std/thing";

float old_res;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  old_res=0;
//--Beschreibungen---------------------------------------------------------

  SetProp(P_INVIS, 1); // Unsichtbar

//--Namen------------------------------------------------------------------

  AddId("\ntodesritter_wunde");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}

void weg()
{
  if(living(ENV(ME)))
    tell_object(ENV(ME), BS("Die Wunde verheilt."));
  if(old_res==-99.99)
  {
    ENV(ME)->SetProp(P_RESISTANCE_STRENGTHS, 0);
  }
  else ENV(ME)->SetProp(P_RESISTANCE_STRENGTHS,
          ENV(ME)->QueryProp(P_RESISTANCE_STRENGTHS)+
          ([DT_UNHOLY:old_res]));
  remove(1);
  return;
}

void wound(int times, int hp)
{
  if(!times-- || !living(ENV(ME)))
  {
    weg();
    return;
  }
  ENV(ME)->AddHp(-hp);
  tell_object(ENV(ME), BS("Die unheilige Wunde schmerzt schrecklich!"));
  call_out("wound", 2, times, hp);
  return;
}

void initial(int times, int hp)
{
  if(ENV(ME)->QueryProp(P_RESISTANCE_STRENGTHS))
  {
    old_res = ENV(ME)->QueryProp(P_RESISTANCE_STRENGTHS)[DT_UNHOLY];
    ENV(ME)->SetProp(P_RESISTANCE_STRENGTHS,
             ENV(ME)->QueryProp(P_RESISTANCE_STRENGTHS)+
             ([DT_UNHOLY:old_res+0.2]));
  }
  else
  {
    ENV(ME)->SetProp(P_RESISTANCE_STRENGTHS, ([DT_UNHOLY:0.2]));
    old_res=-99.99;
  }
  wound(times, hp);
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  weg();
}
