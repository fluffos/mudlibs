int fragen_abfangen(string str)
{
  string dummy;
  if (sscanf(str,"roger nach %s",dummy)==1)
  write("Roger schlaeft und kann Dir nicht antworten. Wenn es wichtig "+
        "ist, kannst Du ihn ja wecken.\n");
  return 1;
		
}
int aufwecken_cmd(string str)
{
  notify_fail("Wen willst Du wecken?\n");
  if(str=="roger"||str=="roger schwarzbart"||str=="schwarzbart")
  {
    write("Du schuettelst Roger Schwarbart.\n");
    say(TPN+ " schuettelt Roger Schwartbart.\n",TP);
	if(QueryProp(P_NOATTACK)== "schlaeft. Vielleicht solltest Du ihn "
              "wecken, eh Du ihn angreifst!? Alles andere waere feige.")
	{
	  aufwachen_schreck();
	  }
	 else command("sag Hey, was soll das?");
	 return 1;
	 }
	return 0;
}

//checkt alle 30 Sekunden, ob er wieder zurueckgehen kann
void zurueckgehen()
{
	if(!ichmachgradwas)
	{
		ichmachgradwas=0;
		SetProp(P_NOATTACK,0);
		move("/d/andracia/yondala/wasser/pirateninsel/room/piratengrotte_6f");
	}
	else call_out("zurueckgehen",30)
}
void ruebergehen(object spieler)
{
	move("/gilden/piratenmeute.lpc");
	//ist der Spieler nicht mehr da, geht er zurueck
	if(!spieler||!present(spieler, environment(this_object())))
	{
		call_out("move",2, "/d/andracia/yondala/wasser/pirateninsel/room/piratengrotte_6f"); 
	}
	command("sag Worum geht es, "+spieler->name()+"?");
	call_out("zurueckgehen",300);
		
}

//mach die Tuer wieder auf und geh bald rueber
void sequenz_ende();
{
	AddExit("nebenan","/d/andracia/yondala/wasser/pirateninsel/room/piratengrotte_6f");
	tell_room(environment(TO),"Roger oeffnet die Tuer.\n");
	call_out("zurueckgehen",30)
}

void beitritts_sequenz(object spieler, int i)
{
	string ausgabe;
	ausgabe=({	"1",
				"2",
				"3",
				"4",
				"5",
				"");
	});
	tell_room(environment(TO),ausgabe[i]+"\n");
	i++;
	if(i<sizeof(ausgabe))
	call_out("beitritts_sequenz",3, spieler, i);
	else
	{
		environment(this_object)->beitreten(spieler); //wir sind ja in "/gilden/piratenmeute.lpc"
		//Hier noch beurteile und muenzwurf beibringen
	}
}

//Wirf alle raus ausser dem aktuellen Spieler und mach die Tuer zu
void alleraus(object spieler)
{
	object *alle;
	int i;
 	alle=all_inventory(TO);
	tell_room(environment(TO),"Roger sagt: Wir brauchen etwas Privatsphaere.\n");
	for(i=sizeof(alle)-1;i>=0;i--)
	  {
	  	if (alle[i]==this_object()||alle[i]==spieler) continue;
		if (!living(alle[i])) continue;
		
		tell_object(alle[i], "Roger wirft Dich raus.\n");
		alle[i]->move( "/d/andracia/yondala/wasser/pirateninsel/room/piratengrotte_6f", M_NOCHECK);
		tell_room(environment(TO),"Roger wirft "+alle[i]->name()" raus.\n");
	     }
	environment(this_object()->RemoveExit("nebenan");	 
}

void beitritt_2(object spieler)
{
	tell_room(environment(this_object()), "Roger und "spieler->name()+" gehen nach nebenan.\n");
	command("nebenan");
	spieler->move("/gilden/piratenmeute.lpc"); //eventuell noch auf Silent setzen?
	call_out("alleraus",3, spieler); 
   call_out("beitritts_sequenz",6, spieler, 0); 
}

//Der Spieler hat gesagt, dass er Pirat werden moechte und erfuellt alle Bedingungen
void starte_beitritt(object spieler)
{
	write("Roger legt seinen Arm um Deine Schulter.\n"+
		  "Roger sagt, dann kommt mal mit, "+spieler->name()+".\n");
	say("Roger legt "+spieler->name()+" seinen Arm um die Schulter.\n"+
		  "Roger sagt, dann kommt mal mit, "+spieler->name()+".\n",spieler);
	ichmachgradwas=1;
	SetProp(P_NOATTACK, "Roger ist gerade mit wichtigerem beschaeftigt.");
	spieler->SetProp(P_PARALYZED, ([
         PARALYZE_TIME: (-1),
         PARALYZE_MSG:  "Du folgst Roger in den Nebenraum.\n",
         PARALYZE_MSG_OTHER: TPN+" lauscht Rogers Worten.\n",
         PARALYZE_END: "",//TPN+" erholt sich von dem Schreck.\n",
         PARALYZE_END_OTHER: ""]));//"Du erholst Dich von Deinem Schreck.\n"]));;
	call_out("beitritt_2",3, spieler); 	 

		  
}


//abfragen, was Spieler sagen. Wenn der spieler im Gildenraum ist und Roger gerade nicht schlaeft, geht er rueber
void catch_tell(string str)
{
	string gruende;
	gruende="";

    if(!TP) return;
	if(QueryProp(P_NOATTACK)) return; //weil er dann schlaeft
	if(InFight())
	{
		write("Roger kaempft gerade und kann nicht antworten.\n");
		return;
	}
	
	string wer, was;
    if (sscanf(str, "%s teilt Dir mit: Ich moechte eine Piratenangelegenheit besprechen %s",
                    was, wer) == 2)
		{
			if(this_player->QueryProp(P_GUILD)!="piratenmeute")
			{
				call_out("write", 1,"Roger teilt Dir mit: Was gehen Euch Piratenangelegenheiten an?\n");
				return;
			}
			else if(present(this_player(),environment(this_object)))
			{
				call_out("write", 1,"Roger stubst Dich an.\nRoger sagt: Ihr braucht nicht mitzuteilen, wenn wir nebeneinander stehen.\n");
				return;
			}
			//else if(!file_name(environment(TP)) == "/d/andracia/yondala/wasser/pirateninsel/room/piratengrotte_6f")
			else if(!file_name(environment(TP)) == "/gilden/piratenmeute.lpc")
			{
				call_out("write", 1,"Roger teilt Dir mit: Begebt Euch dafuer in unseren Versammlungssaal!\n");
				return;
			}
				
			else
			{
				call_out("write", 1,"Roger teilt Dir mit: Arrr, wehe, es ist nicht wichtig!\n");
				call_out("ruebergehen",5+random(5), this_player());
				return;
			}
		return;
		    if (sscanf(str, "%s teilt Dir mit: Ich moechte Pirat werden%s", wer, was) == 2)
			{
				if(present(this_player(),environment(this_object)))
				{
					call_out("write", 1,"Roger stubst Dich an.\nRoger sagt: Ihr braucht nicht mitzuteilen, wenn wir nebeneinander stehen.\n");
					return;
				}
				else
				{
					call_out("write", 1,"Roger teilt Dir mit: Kommt dafuer persoenlich vorbei!\n");
					return;
				}
				
			}
			
		}
		
    if (sscanf(str, "%s sagt: Ich moechte Pirat werden%s", wer, was) == 2)
	{
		if(this_player->QueryProp(P_GUILD)=="piratenmeute")
		{
			call_out("write", 1,"Roger sagt: Ihr seid doch schon ein Pirat!\n");
			return;
		}
		if(this_player()->QueryProp(P_RACE)=="fee")
		{
			write("Roger sagt: Verschwinde, Fee, wir wollen Dich nicht!\n");
			//rauswerfen
			return;
		}
		
		
		if(this_player()->QueryAttribute(A_CON)<8)
			gruende+="Roger sagt: Euch fehlt dazu die noetige Ausdauer.\n");
		
		if(this_player()->QueryAttribute(A_DEX)<8)
			gruende+="Roger sagt: Euch fehlt dazu das noetige Geschick.\n");
		
		if(this_player()->QueryAttribute(A_STR)<1)
			gruende+="Roger sagt: Euch fehlt dazu die noetige Kraft.\n");
		
		if(this_player()->QueryAttribute(A_INT)<1)
		   gruende+="Roger sagt: Euch fehlt dazu die noetige Intelligenz.\n");
		
		if(!present("vulkanblume", this_player()))
			gruende+="Roger sagt: Ihr muesst dafuer eine Vulkanblume dabei haben.\n");
		
		
		if(!present("tuerkise", this_player())gruende+="Roger sagt: Ihr muesst 10 Tuerkise fuer mich dabei haben.\n";

		else if(present("tuerkise",this_player())->QueryProp(P_AMOUNT)<10) 
			gruende+="Roger sagt: Euch fehlen "+(10-present("tuerkise",this_player()->QueryProp(P_AMOUNT))+" Tuerkise.\n";

		if(!this_player()->QueryQuest("Der einsame Elfenpirat"))
			gruende+="Roger sagt: Ihr muesst dafuer erst Endoriel helfen.\n");
		
		//Zwerge und hobbits haben Sonderbedingungen
		if(this_player()->QueryProp(P_RACE)=="Zwerg"||this_player()->QueryProp(P_RACE)=="Hobbit")
		{
			if(!this_player()->QueryQuest("Alriks Wette"))
				gruende+="Roger sagt: Ihr muesst dafuer erst Alrik helfen.\n");
			if(!this_player()->QueryQuest("Aristocals Floete"))
				gruende+="Roger sagt: Ihr muesst dafuer erst Aristocal helfen.\n");
		}		
		if(gruende)
		{
			write("Roger sagt: Ihr koennt kein Pirat werden.\n"+gruende);
			say("Roger verweigert "+this_player()->name()+ "den Beitritt in die Piratenmeute.\n");
			return;
		}
		starte_beitritt(this_player);
		
		
	}		
			

			
				   
			   
	

}

			  
//Funktion nur ueber den Gildenraum
int erhoehen(string str)
{
	notify_fail("Was willst Du erhoehen?\n");
	if(str!="stufe"&&str!="gildenstufe") return 0;
	if(!(TP->QueryProp(P_GUILD)=="piratenmeute"))
		{
			write("Roger sagt: Hier koennen nur Piraten ihre Stufe erhoehen. Verschwinde!\n");
			return 1;
		}
	if(!file_name(environment(TP)) == "/gilden/piratenmeute.c ")
	{
		write("Roger raunt Dir zu: Nicht hier!\n");
		return 1;
	}
	return 0;//Damit die Funktion in der Gilde aufgerufen wird
		
}

int meute_beitreten(string str)
{
	string gruende;
	gruende="";
	notify_fail("Meinst Du eventuell 'trete meute bei' ?\n");
	
	if(str=="gilde bei")
	{
		write("Roger raunt Dir zu: Wir sind keine Gilde!\n");
		return 1;
	}
	if(str=="meute bei")
	{
		write("Sag einfach 'Ich moechte Pirat werden', wenn Du der Meute beitreten moechtest.\n");
	}	
}    


int Defend(int dam, string dam_type, mixed spell, object enemy)
{
   if(ausweichen)
   {
      if(random(2)==1)
	  {
         tell_room(environment(TO),"Roger weicht dem Angriff geschickt aus.\n");
		 dam=0;
		 }
	  else
	  {dam=dam/2;
      tell_room(environment(TO),"Roger weicht dem Angriff teilweise aus.\n");}
	  }
  
return ::Defend(dam, dam_type, spell, enemy);
}

void nicht_ausweichen()
{
   //command("sag ich weiche nicht mehr aus\n");
   ausweichen=0;
}
void taenzeln(object enemy, int damage, mixed dam_type) 
{
  ausweichen=1;
  call_out("nicht_ausweichen",10+random(30));
}
void armab(object enemy, int damage, mixed dam_type) 
{
   object *alles;
   object ob;
   object waffe;
   int i;
   object *schild;
   schild=({});
   //command("sag Damage"+damage+".");
   //if(!damage) return;
   if(!interactive(enemy)) return;

   
 	if(enemy->QueryProp(P_MAX_HANDS)>0) //wenn der Angreifer 1 oder 2 Haende hat
 		{
		    tell_object(enemy,"Roger schlaegt Dir einen Arm ab.\n");       
 			tell_room(environment(TO),"Roger schlaegt "+enemy->name(WEM)+" einen Arm ab.\n",({enemy}));
			i=enemy-> QueryProp(P_MAX_HANDS);
			i=i-1;
			//command("sag Haende "+i+".");
 	    	enemy->SetProp(P_MAX_HANDS, i);
			
			
			if(!present("\narm_invis",enemy))
			{
			//command("sag Gebe unsichtbaren Arm.");
			ob=clone_object(PIR_OBJ +"arm_invis");//unsichtbaren arm clonen
	        ob->move(enemy);
			}
			
	        ob=clone_object(PIR_OBJ +"arm");//sichtbaren arm in den Raum clonen
	        ob->namekriegen(enemy);
	        ob->move(environment(enemy));
			
		

		
		//hat er nicht mehr genug Haende um die Waffe zu zuecken, legt er sie ab:

		if(enemy->QueryProp(P_USED_HANDS)>enemy->QueryProp(P_MAX_HANDS)) 
		   {
		    if(waffe=enemy->QueryProp(P_WEAPON))
			    {
                //command("sag Waffe: "+waffe->name());
		    
			    waffe->DoUnwield();
		        waffe->move(environment(enemy),M_PUT);
			    }
			else if (schild=enemy->QueryArmours(AT_SHIELD))
			{
			 //command("sag Schild: "+schild[0]->name());
		         schild[0]->DoUnwear();
		         schild[0]->move(environment(enemy),M_PUT);
				 }
			}
		   
		   
			if (enemy->QueryProp(P_MAX_HANDS)==0)//wenn er nun keine Arme mehr hat
			
			{ 
			   //command("sag nun legst Du alles ab.");

				alles=all_inventory(enemy);
				
			   for(i=sizeof(alles);i--;i>=0)
			   {
			     if(alles[i]->QueryProp(P_WORN)==0&&alles[i]->QueryProp(P_WIELDED)==0&&
				    alles[i]->QueryProp(P_NODROP)==0&&alles[i]->QueryProp(P_NEVERDROP)==0)//wenn nicht getragen und ablegbar
				    
					{
					 alles[i]->move(environment(enemy));
					 tell_room(environment(enemy),enemy->name()+" laesst "+alles[i]+" fallen.\n",({enemy}));
					 tell_object(enemy, "Du laesst "+alles[i]+" fallen.\n");
					 }
				}
				 
			}
		}	
   		
	else
 		command("sag Pah, ihr habt ja gar keine Arme mehr, "+enemy->name()+"!");

	 
}
     
void tritt(object enemy, int damage, mixed dam_type) 
{
   enemy->move(PIR_ROOM+"piratengrotte_6e", M_GO ,
 	 "","fliegt im hohen Bogen aus dem Raum","wird aus dem Hauptquartier getreten");
   enemy->SetProp(P_PARALYZED,2, "Vor Schreck bist Du wie gelaehmt.");
 }
void geaergert(object spieler)
{
  if (member(aergerer, spieler)!=-1)
     {
       command("sag Nun reicht es mir mit Euch, "+spieler->name()+"!");
       Attack(spieler);
       } 
     else
     {command("sag Ihr solltet Euch gut ueberlegen, ob Ihr das noch "+
	          "einmal wagt, "+spieler->name()+".");
       aergerer=aergerer+({spieler});}
}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  	if(QueryProp(P_NOATTACK)== "schlaeft. Vielleicht solltest Du ihn "
              "wecken, eh Du ihn angreifst!? Alles andere waere feige.")
    { 
	  write("Roger schlaeft tief und fest. Wenn Du mehr Reaktion von ihm "+
	        "wuenscht, solltest Du ihn wecken.\n");
	  return;
	  }
	
	switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "lacht Dich schallend aus.",
        "lacht "+TP->name(WEN)+" schallend aus.");
      break;
    case "aergerlich":
	    call_out("geaergert", 0, TP);
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schmunzelt ueber Dich.",
        "schmunzelt ueber "+TP->name(WEN)+".");
      break;
    case "fies":
      call_out("geaergert", 0, TP);
      break;
    case "frech":
      call_out("geaergert", 0, TP);
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "grinst Dich froehlich an.", 
        "grinst "+TP->name(WEN)+" froehlich an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "wehrt Dich ab: Lasst gut sein, dazu seid Ihr mir viel zu jung.",
        "wehrt "+TP->name(WEN)+".");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "sagt: Herrlich, da lacht mein Piratenherz.",
        "sagt: Herrlich, da lacht mein Piratenherz.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "sagt: Nun, nun, ein Pirat weint nicht.",
        "sagt: Nun, nun, ein Pirat weint nicht.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

