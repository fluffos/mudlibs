    AddInfo( ({ "privatsachen" }),
    "Das ist privat.",
    "sagt: ");
    AddInfo( ({ "schluessel" }),
    "Den werde ich Euch sicherlich nicht geben.",
    "sagt: ");	
    AddInfo( ({ "nickerchen" }),
    "Hin und wieder halte ich ein kleines Nickerchen.",
    "sagt: ");
    AddInfo( ({ "haengematte" }),
    "Ich liebe es, in meiner Haengematte zu liegen.",
    "sagt: ");	
	AddInfo( ({ "essen","mahlzeiten", "mahlzeit" }),
    "Hildgunde bereitet mir normalerweise meine Mahlzeiten.",
