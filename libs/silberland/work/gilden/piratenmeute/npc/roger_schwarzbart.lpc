//**************Infos ueber die Piratengilde
 	AddInfo( ({ "zauber" }),
    "Piraten zaubern nicht. Wir haben andere Faehigkeiten.",
    "sagt: ");
 	AddInfo( ({ "faehigkeiten" }),
		"Piraten koennen folgende Faehigkeiten erwerben:\n"+
		"ab Stufe  1: beurteile und Muenzwurf, \n"+
		"ab Stufe  2: tritt  und zerlege\n"+
		"ab Stufe  3: herstellen und kinnhaken \n"+
		"ab Stufe  4: taenzeln und improvisiere \n"+
		"ab Stufe  5: rueckschlag und vergleiche \n"+
		"ab Stufe  6: repariere und rundumschlag \n"+
		"ab Stufe  7: verbessern und yohoho \n"+
		"ab Stufe  8: versklave \n"+
		"ab Stufe  9: fokussiere und schlachtruf \n"+
		"ab Stufe 10: beschuetze und verbinde \n",
		"sagt: ");
 	AddInfo( ({ "beurteile" }),
    "Die Faehigkeit, die eigene Umwelt zu beurteilen, gibt einem "+
	"Piraten wichtige Informationen ueber Freunde, Feinde, Ruestungen, "+
	"Waffen und die Umgebung. Je besser ein Pirat beurteilen kann und "+
	"je hoeher die eigene Stufe ist, desto mehr erfaehrt er.",
