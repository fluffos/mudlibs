#include <wizlevels.h>
#include <language.h>
#include <config.h>
#include <new_skills.h>
#include <mnpc.h>
#include <moving.h>
#include <properties.h>
#include <wizlevels.h>
#include "../nekro.h"

// Globvars
nosave object *npcs;
nosave object *feinde;
nosave int cnt=0;
nosave mixed nekro_names;


create() {
  if(is_clone(this_object())) return 0;
  nekro_names=NEKRO_NAMES;
  npcs=({});
  feinde=({});
}

void add_npc() {
  npcs+=({previous_object()});
  return;
}

varargs void del_npc(object killer) {
  catch(npcs-=({previous_object()}));
  return;
}


int IsFeind(object enemy) {
  feinde-=({0});
  if(member(feinde, enemy)==-1)
    return 0;
  else return 1;
}

int AddFeind(object enemy) {
  if(member(feinde, enemy)!=-1) return 0;
  feinde+=({enemy});
  return 1;
}

int RemoveFeind(object enemy) {
  if(member(feinde, enemy)==-1) return 0;
  feinde-=({enemy});
  return 1;
}



mixed GetNpcs() { 
  return npcs;
}

mixed GetFeinde() { 
  return feinde;
}

reset() {
  string *nnames;
  feinde=({});
  nnames=NEKRO_NAMES;
  call_out("check_nekro_names", 6, nnames);
}

void check_nekro_names(string *names) {
  int i;
  i=0;
  while(sizeof(names) && i<10) {
    if(!find_living(lower_case(names[0]))) {
      if(member(nekro_names, names[0])==-1) {
        nekro_names+=({names[0]});
      }
    }
    names-=({names[0]});
    i++;
  }
  if(sizeof(names))
    call_out("check_nekro_names", 6, names);
}

nosave int mkreische(string msg, object ob) {
  ob->command_me("mkreische "+msg);
  return 1;
}

mixed GetName() {
   string choosen_name;
   nekro_names-=({""});
   if(!sizeof(nekro_names)) return 0;
   choosen_name=nekro_names[random(sizeof(nekro_names))];
   nekro_names-=({choosen_name});
   return choosen_name;
}

void RemoveName(string name) {
   nekro_names+=({name});
   return;
}

mixed GetAllNames() {
  return nekro_names;
}
