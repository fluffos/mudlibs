}

/* Master Uid hinzufuegen */
int AddMaster(object pl,string uid)
{
  int j;
  mixed *access_rights;
  string savefile;

  if (!previous_object()||(explode(file_name(previous_object()),"#")[0]!=SERVTOOL))
    return 0;
  if (!CheckSecurity(pl,1))
    return 0;
  access_rights=QueryProp(P_SEC_ACCESS);
  if (-1==member(access_rights[1],uid))
  {
    access_rights[1]+=({uid});
    if (-1==member(access_rights[0],uid))
      access_rights[0]+=({uid});
    SetProp(P_SEC_ACCESS,access_rights);
    savefile=file_name(this_object());
    for (j=strlen(savefile)-1;savefile[j..j]!="/";j--);
    save_object(savefile[0..j]+"."+savefile[j+1..<1]+".sec");
    tell_object(pl,"Master-Uid <<"+uid+">> erfolgreich hinzugefuegt.\n");
  }
  else
    tell_object(pl,"Master-Uid <<"+uid+">> ist bereits eingetragen.\n");
  return 1;
}

/* Master Uid loeschen */
int DelMaster(object pl,string uid)
{
  int j;
  mixed *access_rights;
  string savefile;

  if (!previous_object()||(explode(file_name(previous_object()),"#")[0]!=SERVTOOL))
    return 0;
  if (!CheckSecurity(pl,1))
    return 0;
  access_rights=QueryProp(P_SEC_ACCESS);
  if (-1!=member(access_rights[1],uid))
  {
    access_rights[1]-=({uid});
    if (-1!=member(access_rights[0],uid))
      access_rights[0]-=({uid});
    SetProp(P_SEC_ACCESS,access_rights);
    savefile=file_name(this_object());
    for (j=strlen(savefile)-1;savefile[j..j]!="/";j--);
    save_object(savefile[0..j]+"."+savefile[j+1..<1]+".sec");
    tell_object(pl,"Master-Uid <<"+uid+">> erfolgreich entfernt.\n");
  }
  else
    tell_object(pl,"Master-Uid <<"+uid+">> ist nicht eingetragen.\n");
  return 1;

}

int ShowStats(object pl,string str)
{
  int i;
  string *logfiles;
  mixed *access_rights;
  
  if (!previous_object()||(explode(file_name(previous_object()),"#")[0]!=SERVTOOL))
    return 0;
  if (!CheckSecurity(pl,0))
    return 0;
  logfiles=QueryProp(P_SEC_LOGFILES);
  for (i=sizeof(logfiles);i-->0;)
    logfiles[i]=sprintf("%s-50",logfiles[i]);
  access_rights=QueryProp(P_SEC_ACCESS);
  tell_object(pl,
        "     +-----------------------------------------------------+\n"
        "     | Status von:                                         |\n"
        "     | "+
        sprintf("%-50s",file_name(this_object()))
                                                                +"  |\n"
        "     +-----------------------------------------------------+\n"
        "     | Master Uids:                                        |\n"
        "     | "+
        sprintf("%-50s",implode(access_rights[1],", "))
                                                                +"  |\n"
        "     | Uids:                                               |\n"
        "     | "+
        sprintf("%-50s",implode(access_rights[0]-access_rights[1],", "))
                                                                +"  |\n"
        "     | Logfiles:                                           |\n"
        "     | "+
        sprintf("%-50s",implode(logfiles,"  |\n     | "))
                                                                +"  |\n"
        "     +-----------------------------------------------------+\n"
              );
  return 1;
}

private mixed *_set_sec_access(mixed access)
{
  if (!pointerp(access))
    return 0;
  return Set(P_SEC_ACCESS,access,F_VALUE);
}

private mixed *_set_sec_logfiles(mixed logfiles)
{
  int i;
  
  if (!pointerp(logfiles))
    return 0;
  for (i=sizeof(logfiles);i-->0;)
    if (!stringp(logfiles[i]))
      return 0;
  return Set(P_SEC_LOGFILES,logfiles,F_VALUE);
}

private mixed *_query_sec_access()
{
  return Query(P_SEC_ACCESS,F_VALUE);
}

private mixed *_query_sec_logfiles()
{
  return Query(P_SEC_LOGFILES,F_VALUE);

}