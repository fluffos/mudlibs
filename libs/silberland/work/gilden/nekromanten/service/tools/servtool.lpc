#include <wizlevels.h>
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../service.h"

/* Sauber deklarieren */
#pragma strong_types

/* RAUSNEHMEN!!! */
inherit "/std/thing";

/* Funktionsdeklarationen */
int evaluate_command(string str);
int cmd_h(string str);
int cmd_p(string str);
int cmd_l(string str);
int cmd_s(string str);

/* Bitte keine Shadows */
nomask int query_prevent_shadow() { return 1; }

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  AddId("servtool");
  /* Ich nehm mir alle commands, die mit serv anfangen. */
  AddCmd("serv","evaluate_command",1);
}

int evaluate_command(string str)
{
  string verb;
  if (!this_player())
  {
    remove();
    return 0;
  }
  if (!IS_WIZARD(this_player()))
  {
    remove();
    return 0;
  }
  verb=query_verb();
  switch(verb[4..<1])
  {
    case "h":
    case "help":
    case "hilfe":
      return cmd_h(str);
      break;
    case "p":
    case "permission":
      return cmd_p(str);
      break;
    case "l":
    case "logfile":
      return cmd_l(str);
    case "s":
    case "stats":
      return cmd_s(str);
      break;
  }
  return 0;
}

int cmd_s(string str)
{
  notify_fail("Usage: servs <object>\n");
  if (!str) 
    return 0;
  if (!find_object(str))
  {
    tell_object(this_player(),"Object: "+str+" not found.\n");
    return 1;
  }
  notify_fail("Zugriff verweigert.\n");
  return call_other(str,"ShowStats",this_player(),"");
}

int cmd_l(string str)
{
  string *cmds;
  
  notify_fail("Usage: servl <object> <logfile> <add|+|del|->\n");
  if (!str) 
    return 0;
  cmds=explode(str," ");
  if (sizeof(cmds)!=3)
    return 0;
  if (!find_object(cmds[0]))
  {
    tell_object(this_player(),"Object: "+cmds[0]+" not found.\n");
    return 1;
  }
  notify_fail("Zugriff verweigert.\n");
  switch(cmds[2])
  {
    case "add":
    case "+":
      return call_other(find_object(cmds[0]),"AddFile",this_player(),cmds[1]);
      break;
    case "del":
    case "-":
      return call_other(cmds[0],"DelFile",this_player(),cmds[1]);
      break;
    default:
      notify_fail("Usage: servl <object> <logfile> <add|+|del|->\n");
      return 0;
      break;
  }
  return 1;
}

int cmd_p(string str)
{
  string *cmds;
  
  notify_fail("Usage: servp <object> <uid> <add|+|-|del|master|&|nomaster|%>\n");
  if (!str) 
    return 0;
  cmds=explode(str," ");
  if (sizeof(cmds)!=3)
  {
    cmds=({"","",""});
    if (3!=sscanf(str,"%s \"%s\" %s",cmds[0],cmds[1],cmds[2]))
      return 0; 
  }
  if (!find_object(cmds[0]))
  {
    tell_object(this_player(),"Object: "+cmds[0]+" not found.\n");
    return 1;
  }
  notify_fail("Zugriff verweigert.\n");
  switch (cmds[2])
  {
    case "add":
    case "+":
      return call_other(cmds[0],"AddUid",this_player(),cmds[1]); ;
      break;
    case "del":
    case "-":
      return call_other(cmds[0],"DelUid",this_player(),cmds[1]);
      break;
    case "master":
    case "&":
      return call_other(cmds[0],"AddMaster",this_player(),cmds[1]);
      break;
    case "nomaster":
    case "%":
      return call_other(cmds[0],"DelMaster",this_player(),cmds[1]);
      break;
    default:
      notify_fail("Usage: servp <object> <uid> <add|+|-|del|master|&|nomaster|%>\n");
      return 0;
      break;
  }
  return 1;
}

int cmd_h(string str)
{
  switch(str)
  {
    case "servp":
    case "servpermission":
      this_player()->More(
        "     +-servp/servpermission--------------------------------+\n"
        "     |                                                     |\n"
        "     | Die Zuriffsrechte auf das Objekt obj werden ver-    |\n"
        "     | aendert.                                            |\n"
        "     |                                                     |\n"
        "     | SYNTAX:                                             |\n"
        "     | servp <obj> <uid> <add|+|del|-|master|&|nomaster|%> |\n"
        "     |                                                     |\n"
        "     | ARGUMENTE:                                          |\n"
        "     | obj   - Der Dateiname des Objekts, dessen Zugriffs- |\n"
        "     |         Rechte veraendert werden sollen.            |\n"
        "     |                                                     |\n"
        "     | uid   - Die uid des Benutzers, dessen Zugriffsrecht |\n"
        "     |         veraendert werden soll.                     |\n"
        "     |                                                     |\n"
        "     | add|+ - Der Benutzer bekommt einfaches Zugriffsrecht|\n"
        "     |                                                     |\n"
        "     | del|- - Dem Benutzer wird sein Zugriffrecht entzogen|\n"
        "     |                                                     |\n"
        "     | master|&                                            |\n"
        "     |       - Der Benutzer bekommt Erzmagier-Zugriffsrecht|\n"
        "     |                                                     |\n"
        "     | nomaster|%                                          |\n"
        "     |       - Dem Benutzer wird das Erzmagier-Zugriffs-   |\n"
        "     |         recht entzogen.                             |\n"
        "     |                                                     |\n"
        "     | RECHTE:                                             |\n"
        "     | Nur Benutzer mit Erzmagier-Zugriffsrecht koennen    |\n"
        "     | diesen Befehl verwenden.                            |\n"
        "     |                                                     |\n"
        "     +-Siehe auch------------------------------------------+\n"
        "     |                                                     |\n"
        "     +-----------------------------------------------------+\n\n"
                                  );
      return 1;
      break;
    case "l":
    case "logfile":
      this_player()->More(
        "     +-servl/servlogfile-----------------------------------+\n"
        "     |                                                     |\n"
        "     | Die Logfiles des Objekts werden veraendert.         |\n"
        "     |                                                     |\n"
        "     | SYNTAX:                                             |\n"
        "     | servl <obj> <file> <add|+|del|->                    |\n"
        "     |                                                     |\n"
        "     | ARGUMENTE:                                          |\n"
        "     | obj   - Der Dateiname des Objekts, dessen Logfiles  |\n"
        "     |         veraendert werden sollen.                   |\n"
        "     |                                                     |\n"
        "     | file  - Das Logfile, welches hinzugefuegt oder ent- |\n"
        "     |         fernt werden soll.                          |\n"
        "     |                                                     |\n"
        "     | add|+ - Das Logfile wird hinzugefuegt.              |\n"
        "     |                                                     |\n"
        "     | del|- - Das Logfile wird entfernt.                  |\n"
        "     |                                                     |\n"
        "     | RECHTE:                                             |\n"
        "     | Alle Benutzer mit Zugriffsrecht duerfen Logfiles    |\n"
        "     | aendern.                                            |\n"
        "     |                                                     |\n"
        "     +-Siehe auch------------------------------------------+\n"
        "     |                                                     |\n"
        "     +-----------------------------------------------------+\n\n"
                                  );
      return 1;
      break;
    case "servs":
    case "servstats":
      this_player()->More(
        "     +-servs/servstats-------------------------------------+\n"
        "     |                                                     |\n"
        "     | Der aktuelle Status des Objekts wird angezeigt.     |\n"
        "     |                                                     |\n"
        "     | SYNTAX:                                             |\n"
        "     | servs <obj>                                         |\n"
        "     |                                                     |\n"
        "     | ARGUMENTE:                                          |\n"
        "     | obj    - Das Objekt, dessen Status angezeigt werden |\n"
        "     |          soll.                                      |\n"
        "     |                                                     |\n"
        "     | RECHTE:                                             |\n"
        "     | Alle Benutzer mit Zugriffsrecht duerfen dieses      |\n"
        "     | Kommando verwenden.                                 |\n"
        "     |                                                     |\n"
        "     +-Siehe auch------------------------------------------+\n"
        "     |                                                     |\n"
        "     +-----------------------------------------------------+\n\n"
                                  );
      return 1;
      break;
    default:
      tell_object(this_player(),
        "     +--Service Object Tool Expansion--"+
        sprintf("%5s",VERSION)
                                                   +"---------------+\n"
        "     |                                                     |\n"
        "     |  (c) 1999 by Cirion@Silberland                      |\n"
        "     |  Last Update: "+
        sprintf("%10s",DATE)
                                      +"                            |\n"
        "     +-----------------------------------------------------+\n"
        "     | Verfuegbare Kommandos:                              |\n"
        "     | servh [<cmd>]           - Hilfe zu den Kommandos    |\n"
        "     | servp                   - Permissions aendern       |\n"
        "     | servl                   - Logfiles aendern          |\n"
        "     | servs                   - Status anzeigen           |\n"
        "     +-----------------------------------------------------+\n\n"
                                  );
       return 1;
       break;
  }
  return 0;
}
