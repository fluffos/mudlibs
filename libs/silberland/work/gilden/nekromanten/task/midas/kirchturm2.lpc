/*
** Kirchturm in Midas  (w) Woody@SL
** ---
** 1996-08-19  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich inmitten einer kleinen, geschlungenen "+
    "Wendeltreppe, die weiter nach unten zurueck ins Kircheninnere "+
    "und nach oben zum Kirchturm hinauf fuehrt."));
  SetProp (P_INT_SHORT, "Auf einer Wendeltreppe");

  AddDetail ("kirche",
    "Du befindest Dich inmitten der gewaltigen Kirche von Midas.\n");
  AddDetail ( ({"kirchturm", "turm"}),
    "Der Kirchturm befindet sich noch weiter oben.\n");
  AddDetail ( ({"wendeltreppe", "treppe"}),
    "Die kleine, enge Wendeltreppe fuehrt hinauf in den hohen Kirchturm.\n");
  AddDetail ( ({"boden", "stufen"}),
    bs("Die Stufen der Wendeltreppe bestehen aus solidem Metall."));
  AddDetail ("metall",
    bs("Schweres, solide verarbeitetes Metall, das Dich wohl mit "+
    "Leichtigkeit zu tragen vermag."));
  AddDetail ( ({"ruhe","stille"}),
    bs("In dieser Kirche herrschen Ruhe und Stille. Du wagst es nicht, "+
    "zu rufen oder laut etwas zu sagen."));
  AddDetail ("decke",
    "Ueber Dir siehst Du nur noch weitere Stufen der eng geschlungenen "+
    "Wendeltreppe.\n");

  AddExit ("unten", "./kirchturm1");
  AddExit ("oben", "./kirchturm3");

  AddCmd ("ruf", "ruf", 1);
  AddCmd ("sag", "sag", 1);
  AddCmd ("'", "sag", 1);
}

ruf()
{
  write ("Du wagst es nicht, an dieser Staette der Ruhe etwas zu rufen.\n");
  return 1;
}

int sag (string str)
{
  str=TP->_unparsed_args();
  if (!str) str="";
  if (query_verb()[0]=='\'')
    str=query_verb()[1..]+" "+str;
  if (str=="" || !sizeof(explode(str," ")))
    return 0;
  write ("Du fluesterst: "+str+"\n");
  say (CAP_TPN+" fluestert: "+str+"\n");
  return 1;
}
