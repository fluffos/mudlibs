inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <moving.h>

#include "files.h"

int lastring;
int glocken_zerstoert=0;

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG,
"Hier ist wohl der hoechste Punkt der Stadt, der Kirchturm der maechtigen\n"+
"Kirche von Midas. Eine kleine Oeffnung in der Mauer gewaehrt Dir einen\n"+
"atemberaubenden Blick ueber die Daecher der Stadt, und noch weiter oben\n"+
"haengen zwei riesige Glocken aus Bronze, an denen ein Strick befestigt\n"+
"ist und ueber den die Glocken gelaeutet werden koennen. Ausserdem stehen\n"+
"hier ein kleiner Hocker und ein Tisch rum. Eine kleine Wendeltreppe fuehrt\n"+
"hinunter ins Kircheninnere.\n");
  SetProp (P_INT_SHORT, "Auf einem Kirchturm");

  AddDetail ("kirche",
    "Du befindest Dich inmitten der gewaltigen Kirche von Midas.\n");
  AddDetail ( ({"waende","wand","mauer"}), bs(
    "Die Wand um Dich herum wird aus Felsbloecken gebildet. Eine "
    "kleine Oeffnung in selbiger bietet Dir einen atemberaubenden "
    "Blick ueber die Daecher von Midas."));
  AddDetail ( ({"kirchturm", "turm"}),
    "Du befindest Dich hier am hoechsten Punkt der Kirche, im Kirchturm.\n");
  AddDetail ( ({"wendeltreppe", "treppe"}),
    "Die kleine, enge Wendeltreppe fuehrt wieder hinunter.\n");
  AddDetail ("stufen",
    bs("Die Stufen der Wendeltreppe bestehen aus solidem Metall."));
  AddDetail ("metall",
    bs("Schweres, solide verarbeitetes Metall, das Dich wohl mit "+
    "Leichtigkeit zu tragen vermag."));
  AddDetail ("boden",
    "Der Boden hier besteht aus relativ glatten Felsbloecken.\n");
  AddDetail ( ({"felsbloecke","bloecke"}),
    "Glatte, aber unbehandelte Felsbloecke bilden den Boden und die Waende "
    "hier.\n");
  AddDetail ("decke", bs(
    "Die Decke kannst Du nicht erkennen, zwei gewaltige Glocken aus "
    "massiver Bronze versperren Dir die Sicht."));
  AddDetail ("punkt", "Hoehenmaessig ist hier gemeint.\n");
  AddDetail ("stadt", "Midas ist hier gemeint.\n");
  AddDetail ("midas", "Der Name der Stadt, auf die Du hier hinabblickst.\n");
  AddDetail ("oeffnung",
    bs("Eine kleine Oeffnung, durch die Du gerade nicht mehr hindurch "+
    "passt. Der Unterschied zu einem Fenster besteht wohl hauptsaechlich "+
    "im hier fehlenden Glas. Der Ausblick jedenfalls ist einfach nur "+
    "atemberaubend, Du hast einen wunderbaren Ueberblick ueber die "+
    "ganze Stadt."));
  AddDetail ( ({"ausblick", "anblick", "blick"}),
    "Dir stockt der Atem bei diesem wundervollen Ausblick.\n"+
    "Du denkst noch . o O ( Gottseidank bin ich schwindelfrei... )\n");
  AddDetail ("daecher",
    "Die meisten Daecher der Haeuser unter Dir sind zinnoberrot gefaerbt.\n");
  AddDetail ("haeuser",
    bs("Eigentlich siehst Du von den Haeusern nur die Daecher, dennoch "+
    "raubt Dir der Anblick den Atem."));
  AddDetail ("glocken",
    bs("Die beiden gewaltigen Glocken aus massiver Bronze haengen etwa "+
    "zwei Meter ueber Dir. Du kannst eine Inschrift auf ihnen erkennen. "+
    "Ausserdem ist an ihnen ein Strick befestigt, der lose herunterbaumelt."));
  AddDetail ("bronze",
    "Massive und auffallend sauber polierte Bronze. Wahrlich prachtvoll.\n");
  AddDetail ("strick",
    bs("Der Strick haengt lose an der Halterung der beiden Glocken "+
    "befestigt. Vermutlich kann man an ihm ziehen, um die Glocken zu "+
    "laeuten..."));
  AddDetail ("halterung",
    bs("Die beiden Glocken sind an einer beweglichen Halterung angebracht, "+
    "ueber die sie zum Laeuten gebracht werden koennen. Ein Strick ist an "+
    "der Halterung befestigt."));
  AddDetail ("inschrift",
    bs("Auf den beiden Glocken kannst Du irgendeine Inschrift erkennen. "+
    "Vielleicht kannst Du sie ja lesen?"));
  AddReadDetail ("inschrift",
    "Du versuchst, die Inschrift zu entziffern, scheiterst aber.\n");
  AddDetail ("hocker",
    "Ein kleiner Hocker aus Holz. Nichts besonderes eigentlich.\n");
  AddDetail ("holz",
    "Gewoehnliches Holz, wie gesagt, nichts besonderes.\n");
  AddDetail ("tisch",
    "Der Tisch ist bis auf einen kleinen Teller absolut leer.\n");
  AddDetail ("teller",
    bs("Irgendjemand scheint von diesem Teller bereits gegessen zu haben; "+
    "jedenfalls kannst Du einige Essensreste erkennen."));
  AddDetail (({"essensreste", "reste"}),
    bs("Als Du die Essensreste naeher betrachtest, stellst Du fest, dass "+
    "es sich um Ueberreste von Kohl zu handeln scheint."));
  AddDetail ("kohl",
    "Reste davon finden sich auf dem Teller am Tisch.\n");

  AddExit ("unten", "./kirchturm3");
  AddCmd ( ({"zieh", "ziehe"}), "ziehe");
  AddCmd ( ({"klettere", "kletter"}), "klettere");
}

int ziehe (string str)
{
  notify_fail ("WAS oder WORAN moechtest Du ziehen?\n");
  if (!str) return 0;
  if ((str!="strick") && (str!="an strick")) return 0;
  if (lastring+random(5) > time()) {
    write ("Aber die Glocken laeuten doch noch!\n");
    return 1;
  }
  if (this_player()->QueryAttribute(A_STR)<10 || 
      this_player()->QueryProp(P_HP)<3 || this_player()->QueryProp(P_GHOST) )
  {
    write("Leider hast du zu wenig Kraft, um an dem Strick zu ziehen.\n");
    return 1;
  }
  lastring=time();
  write ("Du nimmst all Deine Kraft zusammen und ziehst an dem Strick...\n");
  domainshout ("Die Glocken der Kirche von Midas erklingen von weit her.\n");
  write ("DOOOOONG !!  Die Glocken schallen weit ins Land hinaus.\n");
  this_player()->reduce_hit_point(3);
  return 1;
}

int klettere(string str) {
  notify_fail ("Klettern? Wie bitte? Woran moechtest du hochklettern?\n");
  if(!str) return 0;
  if(str!="an strick hoch" && str!="strick hoch") return 0;
  tell_room(this_object(), BS(sprintf("%s springt auf den Strick und "
          "klettert daran hoch.",
          this_player()->Name())), ({this_player()}));
  tell_object(this_player(), BS("Du springst auf den Strick und kletterst "
        "gekonnt nach oben."));
  TP->move("/d/ebene/Midas/room/glockenturm", M_NOCHECK, "nach oben", 
      "klettert", "klettert von ", "unten herauf");
  return 1;
}

int set_dingdong_destroyed() {
  glocken_zerstoert=1;
  set_next_reset(1800);
}

reset() {
  ::reset();
  glocken_zerstoert=0;
}
