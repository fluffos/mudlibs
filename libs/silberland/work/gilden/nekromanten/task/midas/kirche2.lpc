/*
** Kirche in Midas  (w) Woody@SL
** ---
** 1996-08-18  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/secure/wizlevels.h"

#include "files.h"

string gold()
{
  if (IS_WIZARD(TP))
    return bs("Dir als Magier ist der Anblick von soviel Prunk und Gold "+
      "jedoch vollkommen gleichgueltig... Du kannst Dir doch schliesslich "+
      "soviel davon clonen, wie Du willst :)");
  if (TP->QueryProp(P_RACE)=="Zwerg")
    return bs("Wie jeder Zwerg bekommst auch Du beim Anblick von soviel "+
      "Gold feuchte Augen, und Du fragst Dich, wie man wohl an dieses Gold "+
      "herankommen koennte...");
  else
    return bs("Waerest Du Zwerg, wuerdest Du bei diesem praechtigen "+
      "Anblick vermutlich gaenzlich vergehen...");
}

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "\tDu stehst nun unmittelbar vor dem prachtvollen Altar inmitten der "+
    "maechtigen Kirche von Midas zwischen den vordersten Stuehlen. "+
    "Ausserdem siehst Du hinter dem Altar ein wundervolles, riesiges "+
    "Gemaelde mit prachtvollem Goldrahmen.")+"@@gold@@");

  SetProp (P_INT_SHORT, "In einer Kirche");

  AddDetail ("kirche",
    "Du befindest Dich inmitten der gewaltigen Kirche von Midas.\n");
  AddDetail ("kirchenschiff",
    "Das gewaltige Kirchenschiff erstreckt sich noch weiter nach Osten.\n");
  AddDetail ("boden",
    bs("Der Boden ist mit praechtigen, abwechselnd schwarzen und "+
    "weissen Marmorfliesen ausgelegt. Ausserdem ist an einer Stelle "+
    "eine kleine Messingplakette in den Boden eingelassen."));
  AddDetail ( ({"messingplakette", "plakette", "widmung"}),
    bs("Die Messingplakette scheint an einen verstorbenen Wohltaeter "+
    "zu erinnern. Du kannst einige darauf eingeritzte Worte erkennen."));
  AddReadDetail ( ({"messingplakette", "plakette", "widmung"}),
    "Auf der Messingplakette steht sorgfaeltig eingeritzt:\n"+
    "  'Gewidmet Eljaron, dem Wohltaeter, im Jahre 774'\n");
  AddDetail ( ({"marmorfliesen","fliesen"}),
    "Die Fliesen sind aus Marmor und aeusserst sauber gefertigt.\n");
  AddDetail ("marmor",
    bs("Der Marmor der Fliesen ist ueberraschend schlicht. Zumindest hast "+
    "Du auch schon mal wesentlich teurer wirkenden Marmor gesehen als "+
    "diesen..."));
  AddDetail ("stuehle",
    bs("Im riesigen Kirchenschiff sind jede Menge Stuehle verteilt, "+
    "zwischen denen ein Gang weiter nach Osten zum Ausgang fuehrt."));
  AddDetail ("altar",
    bs("Der praechtige Altar ist mit funkelndem Blattgold bedeckt und "+
    "bietet einen beeindruckenden Anblick. Du siehst einen Kelch und eine "+
    "goldene Schale darauf liegen. Ausserdem kannst Du ein grosses, "+
    "aus Messing bestehendes Kreuz mit einem Kreis in der Mitte erkennen."));
  AddDetail ( ({"blattgold","gold"}),
    bs("Das Gold schillert und funkelt selbst im von den bunten "+
    "Glasfenster etwas abgeschwaechten Licht der Sonne."));
  AddDetail ("kelch",
    bs("Ein golden funkelnder Kelch, gefuellt mit Weisswein steht auf "+
    "dem Altar. Weisswein? Du wunderst Dich... sollte es nicht Rotwein "+
    "oder Wasser sein?"));
  AddDetail ( ({"weisswein", "wein"}),
    bs("In dem Kelch befindet sich tatsaechlich Weisswein... Du "+
    "schuettelst verwundert den Kopf."));
  AddDetail ("schale",
    "In der goldenen Schale am Altar kannst Du etwas Brot erkennen.\n");
  AddDetail ( ({"brotscheiben","brot"}),
    "Ein paar trockene Brotscheiben liegen in der goldenen Schale "+
    "am Altar.\n");
  AddDetail ( ({"messingkreuz", "kreuz", "messing"}),
    bs("Das grosse Messingkreuz steht auf dem praechtigen Altar. Es hat "+
    "ungewoehnlicherweise einen Kreis in der Mitte, dessen Bedeutung Du "+
    "nicht zu ergruenden vermagst."));
  AddDetail ("kreis",
    bs("Der Kreis in der Mitte des grossen Messingkreuzes schneidet die "+
    "horizontale Achse des Kreuzes links und rechts jeweils genau in der "+
    "Mitte. Die genaue Bedeutung bleibt Dir jedoch verborgen."));
  AddDetail ( ({"glasfenster","fenster"}),
    bs("Die Fenster sind mit buntem Glas in allen Farben durchsetzt und "+
    "zeigen diverse Szenen aus der Kirchengeschichte."));
  AddDetail ("glas",
    "Das Glas der Fenster schillert in allen Farben des Lichts.\n");
  AddDetail ("farben",
    bs("Die Sonne schillert durch das bunte Glas der Fenster und erhellt "+
    "die Kirche in Rot, Gruen, Blau und Gelb."));
  AddDetail ("licht",
    bs("Das Licht der Sonne wird durch die bunten Fenster in verschiedene "+
    "Farben geteilt und erhellt die Kirche auf praechtigste Art und Weise."));
  AddDetail ("sonne",
    bs("Die Sonne mueht ihre Strahlen durch die bunten Glasfenster und "+
    "laesst das Kircheninnere in allen Farben des Lichts schillern."));
  AddDetail ( ({"ruhe","stille"}),
    bs("In dieser Kirche herrschen Ruhe und Stille. Du wagst es nicht, "+
    "zu rufen oder laut etwas zu sagen."));
  AddDetail ("decke",
    "An der hohen Decke kannst Du wundervolle Malereien erkennen.\n");
  AddDetail ( ({"deckenmalereien","malereien"}),
    bs("Die Malereien an der Decke zeigen diverse Szenen aus der "+
    "Kirchengeschichte, wie dies auch die Glasfenster tun."));
  AddDetail ("gemaelde",
    bs("Das riesige Gemaelde hinter dem Altar zeigt einen aelteren "+
    "Mann mit Holzstock, der gerade einen steilen Gebirgsweg aufwaerts "+
    "geht. Das Bild ist von einem wundervoll gearbeiteten Goldrahmen "+
    "umgeben."));
  AddDetail ("mann",
    "Es scheint sich um Eljaron, den Wohltaeter zu handeln.");
  AddDetail ("eljaron",
    "Eljaron muss zu seiner Zeit wohl ein bekannter Wohltaeter gewesen "+
    "sein, anders kannst Du Dir die Widmung auf der Plakette nicht "+
    "erklaeren...");
  AddDetail ( ({"goldrahmen", "rahmen"}),
    bs("Der Goldrahmen besteht aus von Blattgold bedecktem, massiven Holz. "+
    "Ein kleines Schild ist am unteren Rand angebracht. Ausserdem bemerkst "+
    "Du einen kleinen Hebel links vom Rahmen."));
  AddDetail ("hebel",
    "Du koenntest versuchen, ihn zu ziehen.\n");
  AddDetail ("holz",
    "Massives Holz, das von Blattgold bedeckt ist.\n");
  AddDetail ("schild",
    "Ein kleines Schild aus Messing. Du kannst es lesen.\n");
  AddReadDetail ("schild",
    bs("Auf dem Schild am Goldrahmen steht geschrieben: 'Eljaron auf "+
    "seinem Weg nach Montaran, 772'"));

  AddExit ("osten", "./kirche");

  AddCmd ("iss", "iss");
  AddCmd ( ({"trink","trinke"}), "trink");

  AddCmd ( ({"zieh","ziehe"}), "zieh");
  AddCmd ("ruf", "ruf", 1);
  AddCmd ("sag", "sag", 1);
  AddCmd ("'", "sag", 1);
}

int zieh(string str)
{
  notify_fail ("WAS moechtest Du ziehen?\n");
  if (!str) return 0;
  if (str!="hebel" && str!="an hebel" && str!="am hebel") return 0;
  write(bs("Du ziehst an einem Hebel, aber nichts passiert. Du beschliesst, "+
    "es spaeter wieder mal zu versuchen... vielleicht morgen?"));
  return 1;
}

ruf()
{
  write ("Du wagst es nicht, an dieser Staette der Ruhe etwas zu rufen.\n");
  return 1;
}

int sag (string str)
{
  str=TP->_unparsed_args();
  if (!str) str="";
  if (query_verb()[0]=='\'')
    str=query_verb()[1..]+" "+str;
  if (str=="" || !sizeof(explode(str," ")))
    return 0;
  write ("Du fluesterst: "+str+"\n");
  say (CAP_TPN+" fluestert: "+str+"\n");
  return 1;
}

int iss(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if (!str || str!="brot") return 0;
  if (TP->eat_food(2))
  {
    write(bs("Du kostest von dem bereits etwas vertrockneten Brot und "
        "stellst fest, dass es wohl durchaus bessere Speisen gibt."));
    say (TP->Name()+" isst ein wenig von dem Brot.\n");
    if (!random(4)) TP->SetProp(P_HP, TP->QueryProp(P_HP)+random(5));
  }
  return 1;
}

int trink(string str)
{
  notify_fail("Was moechtest Du trinken?\n");
  if (!str) return 0;
  if ((str!="weisswein") && (str!="wein") && (str!="aus kelch")) return 0;
  if (TP->drink_alcohol(1) && TP->drink_soft(2))
  {
    write("Du kostest ein wenig von dem Wein.\n"
      "Brrrr, ist der trocken! Und bitter. Es gibt zweifelsohne besseren.\n");
    say (TP->Name()+" trinkt ein wenig Wein.\n");
    if (random(2)) TP->SetProp(P_HP, TP->QueryProp(P_HP)+random(3));
  }
  return 1;
}

