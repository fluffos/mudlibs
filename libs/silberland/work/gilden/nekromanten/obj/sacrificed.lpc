inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../nekro.h"

int anzahl;
int has_init;
object pala;
create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (NEKRO_SACRIFICE_ITEM);
  SetProp (P_SHORT, 0);
  
  SetProp (P_NAME, "puder");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_INVIS, 1);
  SetProp (P_MATERIAL, MAT_MISC);
  anzahl=0;
  has_init=0;
  call_out("init_me", 20);
}


void init_me() {
  pala=ENV(ME);
  if(!pala || !query_once_interactive(pala) || pala->QueryProp(P_GUILD) !=
      "paladine") 
  {
    remove();
    return;
  }
  if(catch(anzahl=call_other(NEKROMASTER, "QueryAmountPaladinSacrified", 
          getuid(pala)))) 
  {
    remove();
    return;
  }
  if(!anzahl) {
    remove();
    return;
  }
  has_init=1;
  return;
}

string extra_look()
{
  if(!has_init) return "";
  if(!anzahl) {
    remove();
    return "";
  }
  if(TP->QueryProp(P_GUILD) == GUILDNAME)
    return BS(sprintf("%s wurde schon %dx von euch geopfert und %se "
          "Seele in die Niederhoellen geschickt. HARHAR!",
          CAP(pala->QueryPronoun(WER)), anzahl,
          pala->QueryPossPronoun(WESSEN)));
  return "";
}

