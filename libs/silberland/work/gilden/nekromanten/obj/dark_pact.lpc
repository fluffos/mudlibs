inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../nekro.h"

nosave int nr=1;
nosave object vic;

create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
  AddId(({ NEKRO_DARK_PACT }));
}

int Setup(object _vic, int _nr) {
  nr=_nr;
  vic=_vic;
  return 1;
}

void reset() {
  ::reset();
  if(!is_clone(TO)) return;
  nr--;
  if(nr < 1) {
    if(vic)
      tell_object(vic, BS("Dein dunkler Pakt hat sich aufgeloest!"));
    remove();
  }
  return;
}
