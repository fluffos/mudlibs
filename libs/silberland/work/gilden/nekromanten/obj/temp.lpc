// 28.05.2003 Archon: wenn auf dieses objekt per obj->Name(...) zugeriffen 
//                    wurde bugte es - zugriff war bei einem raum erfolgt, 
//                    eigene funktion Name

inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../nekro.h"

nosave mapping value;
nosave mapping old_val;
nosave object env;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, 1);
  AddId(({ NEKRO_TEMP_OBJ, "\ntemp"}));
}

varargs string Name(int casus, int demon, int plural) 
{ //bugfix da Name capitalice von name aufruft
  return 0;
}

int SetVariables(mapping val, mapping val2) {
  env=MENV;
  value=copy_mapping(val);
  old_val=copy_mapping(val2);
  if(!env->Query(P_ENVIRONMENT, F_QUERY_METHOD) && 
      !env->QueryProp("old_env")) 
  { 
    env->SetProp(P_ENVIRONMENT, value); 
    env->SetProp("old_env", old_val);
  }
  return 1;
}

mixed QueryVariables() {
  return ({value, old_val});
}


varargs int remove(int silent) {
  if(!is_clone()) return ::remove(silent);
  if(env) {
    env->SetProp(P_ENVIRONMENT, old_val); 
    env->SetProp("old_env", 0);
  }
  while(remove_call_out("remove")!=-1);
  return ::remove(silent);
}



init() {
  ::init();
  if(living(ENV(ME)))
    call_out("remove", 0);
}

reset() {
  ::reset();
  if (!is_clone(this_object())) return;
  call_out("remove", 0);
}

void test123() {
  mapping x,y;
  x=MENV->QueryProp(P_ENVIRONMENT);
  y=copy_mapping(x);
  if(y[ENV_TEMPERATURE])
    y[ENV_TEMPERATURE]--;
  SetVariables(y,x);
  return;
}
