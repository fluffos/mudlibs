// 13.08.2003 Archon: ueberarbeitet, an skillpunkte angeglichen

inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../nekro.h"

private nosave object caster;
private nosave object victim;
private nosave int nr;
private nosave int dam;
private nosave int npc_caster=0;
private nosave int skp;


void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_KILL_NAME, "Kochendes Blut");
  AddId(({ NEKRO_BLOODBOIL }));
}

int Setup(object _vic, object _caster, int suc, int _skp) 
{
  int glvl, circ, bonus;
  victim=_vic;
  caster=_caster;
  skp=_skp;
  glvl=caster->QueryProp(P_GUILD_LEVEL);
  circ=caster->QueryProp(P_GUILD_CIRCLE);
  dam=30
      + (7 * (glvl-1) + circ)
      + (suc/300)+random(suc/300)+
      skp;
  dam=call_other(NEKRO_SPELLS,"get_dam_with_skillpoints",dam,skp);
  bonus=call_other(NEKRO_SPELLS, "CheckEquip", caster, "kochendes blut");
  dam = (int) (dam*(1+bonus/100.0));
  DB(sprintf("bloodboil - caster: %O suc: %i skp: %i dam: %i\n", 
             caster, suc, skp, dam));
  nr=glvl+random(glvl)+caster->QueryProp(P_GUILD_CIRCLE)+
    caster->QueryAttribute(A_INT)/3+skp;
  call_out("do_damage", 0);
  return 1;
}

int NPC_caster() 
{
  npc_caster=1;
}

mixed QueryVariables() 
{
  return ({victim,caster,dam,nr});
}


void do_damage() 
{
  int realdam;
  if(!victim) 
  {
    remove();
    return;
  }
  if(!caster) 
  {
    remove();
    return;
  }
  if(nr < 1) 
  {
    tell_room(ENV(victim), BS(sprintf("%s Blut scheint wieder normal zu "
            "werden!", victim->Name(WESSEN))), ({victim}));
    tell_object(victim, "Dein Blut kocht nicht mehr!\n");
    call_out("remove", 0);
    return ;
  }
  if(!npc_caster && (ENV(caster) != ENV(victim))) 
  {
    if(!random(4)) nr--;
    call_out("do_damage", 2);
    return;
  }
  nr--;
  realdam = victim->Defend(dam,DT_UNHOLY,
          ([SP_NAME: "nekro_bloodboil", SP_SHOW_DAMAGE:
            ({
               ({ -1, "Dein Blut ist normal.",
                      "Das Blut von @WEM1 verursacht keinen Schaden.",
                      ""}),
               ({  0, "Dein Blut wird heiss!",
                      "@WER1 fuehlt sich unwohl!",
                      "@WER1 fuehlt sich unwohl!"}),
               ({  5, "Dein Blut verursacht starke Schmerzen!",
                      "@WER1 schreit vor Schmerzen!",
                      "@WER1 schreit vor Schmerzen!" }),
               ({ 10, "Dein Blut kocht! Es schmerzt hoellisch!",
                      "@WER1 windet sich vor Schmerzen!",
                      "@WER1 windet sich vor Schmerzen!" }),
               ({ 15, "Dein Blut kocht! Du windest Dich unter diesen "
                       +"unertraeglichen Schmerzen!",
                      "@WER1 windet sich und schreit vor Schmerz!",
                      "@WER1 windet sich und schreit vor Schmerz!"}),
               ({ 20, "Dein Blut kocht und bringt Deine Adern zum platzen!",
                      "@WER1 wird vor Schmerz fast bewusstlos!",
                      "@WER1 wird vor Schmerz fast bewusstlos!"}),
               ({ 25, "Dein Blut kocht! Du bist kurz vor dem Tod!",
                      "@WER1 stirbt fast vor unertraeglichem Schmerz!",
                      "@WER1 stirbt fast vor unertraeglichem Schmerz!"}),
           })]), caster);
  call_out("do_damage", 2);

  if(!objectp(victim)) return;

  if(skp > 9 && random(100) > victim->QueryProp(P_NOMAGIC) && !random(5) && victim->QuerySkillAttribute(SA_SPEED) >= 100) {
    victim->ModifySkillAttribute(caster, SA_SPEED, 50, 2+random((caster->QueryProp(P_GUILD_LEVEL)*7 + caster->QueryProp(P_GUILD_CIRCLE)))/7);
    tell_room(ENV(victim), BS(sprintf("Das Blut %s stockt!", victim->name(WESSEN, 1))));
  }
  return;
}

void reset() 
{
  ::reset();
  remove();
  return;
}
