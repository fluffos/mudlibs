//31.07.2003 Archon: weight, gender, setup veraendert

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_RACE, "Mensch");
  SetProp(P_SHORT, "Ein Haufen Knochen");
  SetProp(P_LONG, 
    "Ein grosser Haufen verrottender Knochen. Sie gehoerten wohl einmal "
    "einem Wesen der Rasse "+QueryProp(P_RACE)+".");
  SetProp(P_NAME, "Knochenhaufen");
  SetProp(P_GENDER, MALE);
  AddId( ({"haufen", "knochenhaufen", "knochen", NEKRO_BONES}) );

  SetProp(P_MATERIAL, ([MAT_BONE:100]));
  SetProp(P_WEIGHT, 8500);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET,1);
}

void reset() 
{
  ::reset();
  if(is_clone(TO)) 
  {
    if( MENV ) 
      tell_room(MENV, "Die Knochen zerfallen zu Staub.\n");  
    remove();
  }
}

int Setup() 
{
  SetProp(P_SHORT, "Ein Haufen Knochen");
  SetProp(P_LONG, 
    "Ein grosser Haufen verrottender Knochen. Sie gehoerten wohl einmal "
    "einem Wesen der Rasse "+QueryProp(P_RACE)+".");
  SetProp(P_NAME, "Knochenhaufen");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"haufen", "knochenhaufen", "knochen", NEKRO_BONES}) );

  SetProp(P_MATERIAL, ([MAT_BONE:100]));
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET,1);
  if (!QueryProp(P_SIZE))
    SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT,QueryProp(P_WEIGHT)/QueryProp(P_SIZE)*20);
  SetProp(P_SIZE,QueryProp(P_SIZE));
  SetProp(P_HANDS,0);
  return 1;
}

