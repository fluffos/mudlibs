// 26.11.2003 Archon: bugfix
/*
 * Pakt des Blutes
 *
 * Macht den Untoten des Nekromanten staerker.
 *  - Erhoeht den P_BODY
 *  - Erhoeht SA_SPEED 
 *  - Senkt die Anfaelligkeiten (P_RESISTANCE_STRENGTH) 
 *
 *  - Auf einen untoten Spieler gesprochen: Heilt den Spieler pro 
 *    Reset, damage beim Caster
 *  - Auf sich selber: keine Wirkung
 *
 * Kosten: 
 * Level : 
 * Schaden :
 *
 * Status: 
 *
 */
inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../nekro.h"

nosave int nr=5;
nosave object vic;
nosave object cas;

create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_KILL_NAME, "Ein blutiger Pakt");
  SetProp(P_KILL_MSG, ({"fordert seinen Tribut.", MSG_EMOTE}));
  AddId(({ NEKRO_BLOOD_PACT }));
  set_next_reset(600);
}

int Setup(object _vic, object _cas, int _nr) {
  nr=_nr;
  vic=_vic;
  cas=_cas;
  return 1;
}

void reset() {
  if(!is_clone(TO)) return;
  ::reset();
  set_next_reset(600);
  nr--;
  if(ENV(ME)!=vic) {
    remove();
    return;
  }
  if(nr < 1 || !objectp(vic)) {
    if(objectp(vic))
      tell_object(vic, BS("Ein Teil des Blutpaktes loest sich auf!"));
    if(objectp(cas)) 
      tell_object(cas, BS(sprintf("Ein Teil des Blutpaktes mit %s loest sich "
              "auf.", objectp(vic)?vic->name(WEM):"Jemandem") ));
    remove();
  }
  else {
    if(vic) {
      tell_object(vic, BS("Blut, ueberall Blut ..."));
      vic->AddHp(random(50));
    }
    if(cas) {
      tell_object(cas, BS(sprintf("Dein Blutpakt heilt %s.", 
              vic->name(WEM))));
      cas->do_damage(random(10)+5);
     }
  }
  return;
}
