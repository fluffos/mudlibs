inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>

create() 
{
  if(is_clone()) destruct();
  ::create();
}

int WieldFunc(object weapon) 
{
  if(ENV(weapon)->QueryProp(P_GUILD)=="nekromanten" ||
      ENV(weapon)->is_class_member(CL_UNDEAD) ) 
  return 1;
  tell_object(ENV(weapon), 
     BS("Ein scharfer Schmerz durchfaehrt Dich, als Dir eine fremde "
     "Praesenz klarmacht, das sie sich nicht von Dir beherrschen "
     "lassen will!\n"));
  PO->SetProp(P_KILL_NAME, "Eine fremde Praesenz");
  PO->SetProp(P_KILL_MSG, ({"laesst sich nicht beherrschen!", MSG_EMOTE}));
  ENV(weapon)->do_damage(20+random(20));
  return 0;
}
