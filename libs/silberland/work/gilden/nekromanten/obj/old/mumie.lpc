#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine mumifizierte Leiche");
  SetProp(P_LONG, 
    "Eine mumifizierte Leiche. Sie ist ueber und ueber mit weissen "
    "Bandangen eingewickelt, sodass man nicht erkennen kann, wer hier "
    "einbalsamiert wurde.");
  SetProp(P_NAME, "Leiche");
  SetProp(P_NAME_ADJ, "mumifiziert");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"leiche", "mumie", "\nnekromanten_mumie"}) );
  AddAdjective( ({"mumifiziert", "mumifizierte"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_DEAD:95, MAT_CLOTH:5]));
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET,1);
}

reset() 
{
  ::reset();
  if(is_clone(TO) && MENV ) {
    tell_room(MENV,
      "Die Mumie zerfaellt zu Staub.\n");  
    remove();
  }
}


