#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Eiterhuelle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"NekromantenEiter"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_MATERIAL, ([MAT_BLOOD:30, MAT_SLIME:40, MAT_MISC_UNHOLY:30]));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP,1);
  SetProp(P_MAGIC,1);
  SetProp(P_CURSED,1);
  SetProp(P_DEFEND_FUNC, TO);
}

string extra_look()
{
  string typ;

  typ="";
  if(objectp(QueryProp(P_WORN)) )
    typ=QueryProp(P_WORN)->Name();
  return (typ + " ist von einer ekelerregenden, eitrigen Huelle umgeben.\n");
}

varargs int move(mixed dest, int method)  // falls Traeger stirbt und EH in
{                                         // Leiche gemoved werden soll...
  int ret;

  ret = ::move(dest, method);
  if(!environment(TO) || !living(environment(TO))) call_out("remove",0);
  return ret;
}

reset() 
{
  if(is_clone(TO)) remove();
  ::reset();
}


int remove()
{
  SetProp(P_CURSED, 0);
  DoUnwear(1);
  if(environment(TO)) 
    tell_object(environment(TO), "Deine Eiterhuelle loest sich auf.\n");
  return ::remove();
}


int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  if( !sizeof(dtyp - m_indices(PHYSICAL_DAMAGE_TYPES)) )
  {
//    if(random(1000) > 800) 
//      tell_object(QueryProp(P_WORN), 
//        "Deine Eiterhuelle schwaecht den Schlag etwas ab.\n");
    return QueryProp(P_NEKRO_FESTER_DEFENCE);
  }
  else return 0;
}

