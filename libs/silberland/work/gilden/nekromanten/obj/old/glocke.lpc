#include "../nekro.h"

inherit "std/thing";

#include <properties.h>


void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Die Truemmer der Kirchenglocken");
  SetProp(P_LONG, 
      "Das sind die Reste der Glocken aus der Kirche von Midas. "
      "Sie sind komplett zerstoert.");
  SetProp(P_NAME, "Truemmer der Kirchenglocken");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"truemmer", "glocken", "kirchenglocken", 
        NEKRO_MISC_GUILDITEM_ID}) );

  SetProp(P_MATERIAL, ([MAT_IRON:100]));
  SetProp(P_WEIGHT, 1000000);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOGET, "Die sind Dir zu schwer. Du laesst sie liegen.\n");
  AddDetail("glocken",
      "Die Truemmer der Glocken liegen am Boden.");
  AddDetail("truemmer", 
      "Die Glocken sind komplett zerstoert. Offenbar wurden Sie von "
      "oben aus der Halterung gerissen.");
  AddDetail("halterung", 
      "Hmm, da muesstest Du schon am Strick hochklettern um was "
      "genaueres zu sagen.");

}

reset() 
{
  ::reset();
  if ( is_clone(TO) )
    remove();
}
