
#include "../def.h"

inherit "std/thing";

object player;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein magisches Schutzschild");
  SetProp(P_LONG,  
    "Ein magisches Schutzschild. Mit dem Befehl \'schutzschild\' kannst "
    "Du es aktivieren.");
  SetProp(P_NAME, "Schutzschild");
  SetProp(P_NAME_ADJ, "magisch" );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);

  AddId( ({"schutzschild", "mana"}) );
  AddCmd( ({"mana", "schild", "schutzschild"}),  "mana" );
}

int mana(string str)
{
  int dauer, con, hp;
  dauer= 60;
  TP->SetProp(P_TMP_DEFEND_HOOK, 0);
  TP->SetProp(P_TMP_DEFEND_HOOK,({ time()+dauer, TO, "mana_shield"}));
  con = TP->QueryAttribute(A_CON)*5;
  SetProp(P_X_HEALTH_MOD, ([P_HP:-con, P_SP:con]) );
  TP->UpdateAttributes();
  hp= TP->QueryProp(P_HP)<con ? TP->QueryProp(P_HP): con;
  TP->AddHp(-hp);
  TP->AddSp(hp);
  call_out("mana_end", dauer);
  player=TP;
  write("Du bist jetzt von einem magischen Schutzschild umgeben!\n");
  say(CAP_TPN+" ist jetzt von einem magischen Schutzschild umgeben.\n");
  return 1;
}
    
void mana_end()
{
  write("Dein magisches Schutzschild loest sich auf!\n");
  say(TP->Name(WESSEN)+ " magisches Schutzschild loest sich auf.\n");
  SetProp(P_X_HEALTH_MOD, 0 );
  TP->UpdateAttributes();
}

mixed mana_shield(int dam, mixed dam_type, mixed spell, object enemy)
{
  string what, how;
  player->AddSp(-dam/15); 
  switch(dam/15) {
    case 0:       what = "schwaech"; how =" gar nicht"; break;
    case 1..2:    what = "schwaech"; how = " ganz leicht"; break;
    case 3..5:    what = "schwaech"; how = " leicht"; break;
    case 6..10:   what = "schwaech"; how = ""; break;
    case 11..15:  what = "schwaech"; how = " stark"; break;
    case 16..20:  what = "schwaech"; how = " sehr stark"; break;
    case 21..30:  what = "schwaech"; how = " extrem stark"; break;
    case 31..50:  what = "schwaech"; how = " gewaltig"; break;
    case 51..100: what = "reduzier"; how = " kritsch"; break;
    case 101..150: what = "reduzier"; how = " beinahe toedlich";  break;
    case 151..200: what = "reduzier"; how = " toedlich"; break;
    default: what="vernichte"; how=" beinahe"; 
  }
  if( player->QueryProp(P_SP)==0 ) {
    what = "bring"; how = " zum Verschwinden";
    remove_call_out("mana_end");
    player->SetProp(P_TMP_DEFEND_HOOK, 0);
    SetProp(P_X_ATTR_MOD, 0 );
    TP->UpdateAttributes();
  }
  tell_object( enemy, "  Du "+what+"st "+player->name(WESSEN,1) + 
    " magischen Schild"+how + ".\n");
  tell_object( player, "  " + enemy->Name(WER,1) + " " + what+"t Deinen "
    "magischen Schild" + how + ".\n" );
  say( "  " + enemy->Name(WER,1) + " "+ what + "t " + player->name(WESSEN,1) + 
    " magischen Schild"+how + ".\n", ({enemy, player}) );
  dam=0;
  return 0;
}

