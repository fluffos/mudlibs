#include "../def.h"

inherit OBJ "misc/std_ghoul_food";

#include <properties.h>
#include <food.h>

object wer;
int wieviel;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein frisches Stueck Rippen");
  SetProp(P_LONG, 
    "Dieses Stueck Rippen ist noch ganz blutig und sollte wohl bald verspeist "
    "werden.");
  SetProp(P_NAME, "Stueck Rippen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stueck rippen", "rippen", "organ"}) );

  SetProp(P_NEKRO_GHOULFOOD_DECAY, 33);
  SetProp(P_FOOD_INFO, ([F_SOAK: 4, F_HEAL:0]) );
}

void BeimEssen(object pl)
{
  if( pl!=wer) {
    tell_object(pl, "Vor lauter Ekel spuckst Du "+name(WEN,1)+" wieder aus.\n"
                    "Wie kann man nur so etwas essen!\n");
    tell_room(ENV(pl), BS( pl->Name()+" will "+name(WEN)+" essen, spuckt "
        +QueryPronoun(WEN)+" aber sofort wieder aus."), ({pl}) );
    return;
  }
  tell_room(ENV(pl), BS( pl->Name()+" isst "+name(WEN)+" und schaut "
      "erfrischt aus."), ({pl}) );
  if( pl->QueryProp(P_FROG) ) {
    tell_object(pl, BS("Du verspeist "+name(WEN,1)+" und bist kein Frosch "
      "mehr."));
    pl->SetProp(P_FROG, 0);
  }
  else
   tell_object(pl, BS("Du verspeist "+name(WEN,1)+", aber nichts passiert.")); 
}


void set_healing(object caster, int succ, int level)
{
  wer=caster;
}

