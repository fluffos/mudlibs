#include "../def.h"

inherit OBJ "misc/std_ghoul_food";

#include <properties.h>
#include <food.h>

object wer;
int wieviel;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine frische Milz");
  SetProp(P_LONG, 
    "Diese Milz ist noch ganz blutig und sollte wohl bald verspeist "
    "werden.");
  SetProp(P_NAME, "Milz");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"milz", "organ"}) );

  SetProp(P_NEKRO_GHOULFOOD_DECAY, 33);
  SetProp(P_FOOD_INFO, ([F_SOAK: 2, F_HEAL:0]) );
}

void BeimEssen(object pl)
{
  if( pl!=wer) {
    tell_object(pl, "Vor lauter Ekel spuckst Du "+name(WEN,1)+" wieder aus.\n"
                    "Wie kann man nur so etwas essen!\n");
    tell_room(ENV(pl), BS( pl->Name()+" will "+name(WEN)+" essen, spuckt "
        +QueryPronoun(WEN)+" aber sofort wieder aus."), ({pl}) );
    return;
  }
  tell_room(ENV(pl), BS( pl->Name()+" isst "+name(WEN)+" und schaut "
      "erfrischt aus."), ({pl}) );
  if( pl->QueryProp(P_POISON) ) {
    tell_object(pl, BS("Du verspeist "+name(WEN,1)+" und fuehlst deine "
      "Vergiftung schwinden."));
    pl->AddPoison(-wieviel);
  }
  else
   tell_object(pl, BS("Du verspeist "+name(WEN,1)+", aber nichts passiert.")); 
}


void set_healing(object caster, int succ, int level)
{
  wer=caster;
  wieviel=level/15+succ/2000;  //0-7
}

