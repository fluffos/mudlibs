#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <food.h>

object wer;
int wieviel;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  AddId( NEKRO_FOOD, NEKRO_MISC_GUILDITEM_ID );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  AddId ( ({"leichenteil", "organ"}) );
}

void reset()
{
  ::reset();
  if( is_clone(TO) && !random(QueryProp(P_NEKRO_GHOULFOOD_DECAY)) ) {
    if( objectp(wer) && environment() && wer==environment() )
      tell_object(wer, Name()+" verfault und zerfaellt zu Staub.\n");
    remove();
  }
}
