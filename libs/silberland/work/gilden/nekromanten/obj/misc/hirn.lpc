#include "../def.h"

inherit OBJ "misc/std_ghoul_food";

#include <properties.h>
#include <food.h>

object wer;
int wieviel;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein frisches Hirn");
  SetProp(P_LONG, 
    "Dieses Hirn ist ganz frisch und sollte wohl moeglichst bald gegessen " 
    "werden.");
  SetProp(P_NAME, "Hirn");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hirn", "organ"}) );

  SetProp(P_NEKRO_GHOULFOOD_DECAY, 11);
  SetProp(P_FOOD_INFO, ([F_SOAK: 7, F_HEAL:0]) );
}

void BeimEssen(object pl)
{
  if( pl!=wer) {
    tell_object(pl, "Vor lauter Ekel spuckst Du das Hirn wieder aus.\n"
                    "Wie kann man nur so etwas essen!\n");
    tell_room(ENV(pl), BS( pl->Name()+" will "+name(WEN)+" essen, spuckt "
        +QueryPronoun(WEN)+" aber sofort wieder aus."), ({pl}) );
    return;
  }
  tell_room(ENV(pl), BS( pl->Name()+" isst "+name(WEN)+" und schaut "
      "erfrischt aus."), ({pl}) );
  tell_object(pl, 
    BS("Du verspeist das Hirn und fuehlst Dich geistig gestaerkt."));
  pl->AddSp(wieviel); 
}


void set_healing(object caster, int succ, int level)
{
  wer=caster;
  wieviel=level+succ/250;  // 1-80
}

