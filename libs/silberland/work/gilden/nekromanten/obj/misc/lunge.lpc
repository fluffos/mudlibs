#include "../def.h"

inherit OBJ "misc/std_ghoul_food";

#include <properties.h>
#include <food.h>
#include <moving.h>

object wer;
int wieviel;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine frische Lunge");
  SetProp(P_LONG, 
    "Diese Lunge ist noch ganz blutig und sollte wohl bald verspeist "
    "werden.");
  SetProp(P_NAME, "Lunge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"lunge", "organ"}) );

  SetProp(P_NEKRO_GHOULFOOD_DECAY, 33);
  SetProp(P_FOOD_INFO, ([F_SOAK: 2, F_HEAL:0]) );
}

void BeimEssen(object pl)
{
  object ob;
  if( pl!=wer) {
    tell_object(pl, "Vor lauter Ekel spuckst Du "+name(WEN,1)+" wieder aus.\n"
                    "Wie kann man nur so etwas essen!\n");
    tell_room(ENV(pl), BS( pl->Name()+" will "+name(WEN)+" essen, spuckt "
        +QueryPronoun(WEN)+" aber sofort wieder aus."), ({pl}) );
    return;
  }
  tell_room(ENV(pl), BS( pl->Name()+" isst "+name(WEN)+" und schaut "
      "erfrischt aus."), ({pl}) );
  tell_object(pl, BS("Du verspeist "+name(WEN,1)+" und fuehlst ein "
      "Kribbeln in Deiner eigenen Lunge."));
  ob=clone_object("/d/dschungel/feyaria/kueste/obj/waterbreath");
  ob->move(pl, M_NOCHECK);
  ob->atmen(wieviel*60);
  
}


void set_healing(object caster, int succ, int level)
{
  wer=caster;
  wieviel=1+level/10+succ/1500;  //1-11
}

