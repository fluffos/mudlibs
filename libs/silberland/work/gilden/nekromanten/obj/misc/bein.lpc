#include "../def.h"

inherit OBJ "misc/std_ghoul_food";

#include <properties.h>
#include <food.h>
#include <moving.h>

object wer;
int wieviel;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein blutiges Bein");
  SetProp(P_LONG, 
    "Dieses Bein ist noch ganz blutig und sollte wohl bald verspeist "
    "werden.");
  SetProp(P_NAME, "Bein");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"bein", "organ"}) );

  SetProp(P_NEKRO_GHOULFOOD_DECAY, 11);
  SetProp(P_FOOD_INFO, ([F_SOAK: 10, F_HEAL:0]) );
}

void BeimEssen(object pl)
{
  if( pl!=wer) {
    tell_object(pl, "Vor lauter Ekel spuckst Du "+name(WEN,1)+" wieder aus.\n"
                    "Wie kann man nur so etwas essen!\n");
    tell_room(ENV(pl), BS( pl->Name()+" will "+name(WEN)+" essen, spuckt "
        +QueryPronoun(WEN)+" aber sofort wieder aus."), ({pl}) );
    return;
  }
  tell_room(ENV(pl), BS( pl->Name()+" isst "+name(WEN)+" und schaut "
      "erfrischt aus."), ({pl}) );
  tell_object(pl, BS("Du verspeist "+name(WEN,1)+" und fuehlst die "
      "Muedigkeit aus Deinen Fuessen schwinden."));
  pl->SetProp(P_MV, pl->QueryProp(P_MV)+wieviel); 
}


void set_healing(object caster, int succ, int level)
{
  wer=caster;
  wieviel=level*10+succ/40;  // 100-650
}
