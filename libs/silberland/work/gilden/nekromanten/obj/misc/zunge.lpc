#include "../def.h"

inherit OBJ "misc/std_ghoul_food";

#include <properties.h>
#include <food.h>

object wer;
int wieviel;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine frische Zunge");
  SetProp(P_LONG, 
    "Diese Zunge ist noch ganz weich und sollte wohl bald verspeist "
    "werden.");
  SetProp(P_NAME, "Zunge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"zunge", "organ" }) );

  SetProp(P_NEKRO_GHOULFOOD_DECAY, 33);
  SetProp(P_FOOD_INFO, ([F_SOAK: 1, F_HEAL:0]) );
}

void BeimEssen(object pl)
{
  object ob;
  if( pl!=wer) {
    tell_object(pl, "Vor lauter Ekel spuckst Du "+name(WEN,1)+" wieder aus.\n"
                    "Wie kann man nur so etwas essen!\n");
    tell_room(ENV(pl), BS( pl->Name()+" will "+name(WEN)+" essen, spuckt "
        +QueryPronoun(WEN)+" aber sofort wieder aus."), ({pl}) );
    return;
  }
  tell_room(ENV(pl), BS( pl->Name()+" isst "+name(WEN)+" und schaut "
      "viel besser aus."), ({pl}) );
  if( objectp(ob=pl->QueryProp(P_PERM_STRING))) {
    tell_object(pl, BS("Du verspeist "+name(WEN,1)+" und kannst wieder richtig "
      "sprechen."));
    ob->remove();
  }
  else
   tell_object(pl, BS("Du verspeist "+name(WEN,1)+", aber nichts passiert.")); 
    
}

void set_healing(object caster, int succ, int level)
{
  wer=caster;
}

