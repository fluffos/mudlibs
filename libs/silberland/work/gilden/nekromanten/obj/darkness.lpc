inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../nekro.h"

object caster;

create() {
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_LIGHT, -1);
  SetProp(P_INVIS, 1);
  AddId(({ NEKRO_DARKNESS_OBJ}));
  set_next_reset(300);
}

int Setup(object _caster, int suc) {
  int light;
  caster=_caster;
  light=-(suc-9000)/500; // -1 ... -2
  if(light > -1) light = -1;
  SetProp(P_LIGHT, light);
  return 1;
}

int ChangeLightLevel() {
  SetProp(P_LIGHT, QueryProp(P_LIGHT)-1);
  return 1;
}

remove() {
  object room;
  while(remove_call_out("remove")!=-1);

  if(ENV(ME) && !living(ENV(ME))) {
    room=ENV(ME);
  }
  else if(ENV(ME) && ENV(ENV(ME)) && !living(ENV(ENV(ME)))) {
    room=ENV(ENV(ME));
  }
  if(room) {
    tell_object(room, "Die unheimliche Finsternis loest sich auf!\n");
  }
  ::remove();
}

init() {
  ::init();
}

reset() {
  ::reset();
  if (!is_clone(this_object())) return;
  call_out("remove", 0);
}

