inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>
#include "../nekro.h"

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);  
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1); 
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INVIS, 1);
  AddId(({"\n"+P_NOATTACK}));
  SUID;
}

void BecomesNetAlive(object pl) {
  if(ENV(ME) && pl == ENV(ME))
    pl->SetProp(P_NOATTACK, 0);
}

void reset() {
  ::reset();
  if(ENV(ME) && query_once_interactive(ENV(ME)))
    ENV(ME)->SetProp(P_NOATTACK, 0);
  remove();
  return;
}
