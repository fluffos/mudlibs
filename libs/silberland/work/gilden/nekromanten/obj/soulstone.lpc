//21.01.2009 Angrox, Seelenstein

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <material.h>

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein nekromantischer Seelenstein");
  SetProp(P_LONG, BS(
    "Ein nekromantischer Seelenstein. Er ist so schwarz, dass Du er wie ein Riss "
    "in der Wirklichkeit wirkt. Du kannst nichts, aber auch rein gar nichts daran "
    "erkennen."));
  SetProp(P_NAME, "Seelenstein");
  SetProp(P_GENDER, MALE);
  AddId( ({"seelenstein", NEKRO_SOULSTONE}) );

  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:100]));
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_AUTOLOADOBJ,1);
  SetProp(P_INFO, BS("Dieser Seelenstein koennte einer untoten Kreatur die Macht geben, "
        "der endgueltigen Vernichtung zu entgehen und somit einen Tod unbeschadet zu "
        "ueberstehen."));
  AddAdjective( ({ "nekromantisch" }));
}
