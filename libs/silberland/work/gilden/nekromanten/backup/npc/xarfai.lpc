#include <wizlevels.h>
#include "../nekro.h"

// Prototypes
void waiting_check();
// Globvars
nosave int perg_count, hb_time;
nosave mapping waiting_for=(["angrox":0,
                             "iwo":0,
                             "feyaria":0,
                             "stahldorn":0,
                             "dante":0,
                             "cirion":0,
                             "banshee":0]);
nosave mapping ruest;
nosave int helpvar=0; 
nosave int cnt=0;
nosave string *get_angry=({});
void new_short();

void create() {
  int i;
  string *waitf_names; 

  if (!is_clone(TO)) return;
  ::create();
  // Einer fuer alle, alle fuer einen!
  //call_other(NPCMASTER,"add_npc");
  perg_count=5;
  SetProp(P_SHORT, "Xarfai, der Meister aller Nekromanten");
  new_short();
  SetProp(P_LONG,
        "Vor Dir steht eine ueber zwei Schritt grosse, voellig "
        "widernatuerliche Gestalt. Dunkle, straehnige Haare fallen ueber "
        "ein kreidebleiches Gesicht, aus denen Dich zwei rot funkelnde Augen "
        "anstarren. Das Gesicht von Xarfai ist ueber und ueber mit Narben "
        "versehen, aus denen staendig ein leichter Blutstrom sickert. "
        "Wenn das Gesicht nicht so verunstaltet waere, koennte man "
        "es durchaus als ansehllich bezeichnen. Doch nun scheint irgendeine "
        "Art der Qual in dem Gesicht zu stecken. Seltsam ...");
  SetProp(P_NAME, "xarfai");
  SetProp(P_GENDER, MALE);

  SetProp(P_NAME, "Xarfai");
  SetProp(P_GENDER, MALE);
  AddId( ({ "xarfai", "mann", "nekromant" , GUILDNPC_ID }));
 
  set_living_name("xarfai");

//  set_heart_beat(1);
  
  // Auf welche Spieler/Magier/o.ae. warten wir? 
//  waitf_names=m_indices(waiting_for);
//  for(i=sizeof(waiting_for)-1;i>=0;i--) {
//    if(find_player(waitf_names[i])) waiting_for[waitf_names[i]]=1;
//  }

  SetProp(P_GUILD, "nekromanten");
  SetProp(P_GUILD_LEVEL, 7);
  SetProp(P_HANDS, ({" mit seinen langen Krallen",400,DT_UNHOLY}));
  SetProp(P_XP, QueryProp(P_XP)+150*100); // Bonus fuer Spells
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 250);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,-20);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_AGGRESSIVE, ([P_RACE:(["Fee":0.02]),
                        P_GUILD:(["Paladine":0.05])]));    
  // DEFAULT NPC
  create_necromancer_npc(50,7,7);
  set_guild_spellrate(90);
  // DEFAULT NPC END

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([
      DT_SLASH:     -0.7, DT_BLUDGEON:  -0.4, DT_PIERCE: -0.4, DT_SQUEEZE:-0.4, 
      DT_WHIP:      -0.4, DT_RIP:       -0.4,
      DT_FIRE:      -0.4, DT_COLD:      -0.3, DT_WATER:  -0.4, DT_AIR:    -0.3, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.3, DT_SOUND:  -0.3, DT_LIGHT:  -0.3,
      DT_ELECTRIC:  -0.3, DT_ACID:       0.0, DT_POISON: -0.3, DT_TERROR: -1.0,
      DT_HOLY:       0.2, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.7 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,45);
  SetProp(P_MSGIN, "stapft herein.\nDie Erde erzittert, es wird eine Spur "
           "kuehler");
  SetProp(P_MSGOUT, "stapft Richtung#.\nDu atmest erleichtert auf");
  SetProp(P_MMSGIN, "manifestiert sich aus der Kaelte");
  SetProp(P_MMSGOUT, "verschwindet mit der Macht der Niederhoellen.\n");

  SetProp(P_DIE_MSG,  " verbrennt von innen heraus mit bestialischem "
      "Gestank.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Wartet auf meine Wiederkehr! Dann gehoeren eure "
      "Seelen mir! MUAHAHAHAHHAHA!");
  SetProp(P_KILL_NAME, "Xarfai");
  SetProp(P_KILL_MSG, "Ein Kaempfer mehr in meinen Reihen!");

  
  SetProp(P_LOG_INFO, "xarfai.log");
/*
  AddLibrary(LIBS("allgemein.lib"), 1);
  AddLibrary(LIBS("ayla.lib"),      5);
  AddLibrary(LIBS("schenke.lib"),   1);
  AddLibrary(LIBS("schmied.lib"),   1);
  AddLibrary(LIBS("laden.lib"),     1);
  AddLibrary(LIBS("drache.lib"),    1);
*/
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Xarfai bruellt: WAS SOLL ICH DAMIT?!??!\n" }) );

  SetProp(P_SPELLRATE,70);

  AddDefaultSpell(3,900, DS_FEAR, 
    "Xarfai bruellt Dich an!\n",
    "Xarfai bruellt @WEN an!\n");
  AddDefaultSpell(3,500, DS_CURSE_WEAPON, 
    "Xarfai beschwoert die Macht der Niederhoellen auf Dich herab!\n",
    "Xarfai beschwoert die Macht der Niederhoellen auf @WEN herab!\n");
  AddDefaultSpell(3,700, DS_CURSE_ARMOUR, 
    "Xarfai beschwoert die Macht der Niederhoellen auf Dich herab!\n",
    "Xarfai beschwoert die Macht der Niederhoellen auf @WEN herab!\n");
  AddDefaultSpell(3,500, DS_REDUCE_WC, 
    "Xarfai beschwoert die Macht der Niederhoellen auf Dich herab!\n",
    "Xarfai beschwoert die Macht der Niederhoellen auf @WEN herab!\n");
  AddDefaultSpell(3,700, DS_REDUCE_AC,
    "Xarfai beschwoert die Macht der Niederhoellen auf Dich herab!\n",
    "Xarfai beschwoert die Macht der Niederhoellen auf @WEN herab!\n");

  AddDefaultSpell(3,700, DS_DEAF,
    "Xarfai deutet auf Dich und ruft: Mo'Karut!!\n",
    "Xarfai deutet auf @WEN und ruft: Mo'Karut!!\n");
  AddDefaultSpell(3,700, DS_BLIND,
    "Xarfai deutet auf Dich und ruft: Ylem Tragot!!\n",
    "Xarfai deutet auf @WEN und ruft: Ylem Tragot!!\n");
  AddDefaultSpell(3,1200, DS_PARALYZE,
    "Xarfai deutet auf Dich und ruft: Qur'Zomor!!\n",
    "Xarfai deutet auf @WEN und ruft: Qur'Zomor!!\n");
  AddSpell(1,2500,
      "Xarfai raubt Dir Deine Seele!\n",
      "Xarfai raubt @WESSEN Seele!\n",
      DT_UNHOLY);
      
  SetChats(1, ({
    "Xarfai blickt Dich kurz an und Du bekommst eine Gaensehaut.\n",
    "Xarfai bruellt: VERFLUCHT SEI DAS GUTE!\n",
    "Ein paar Tropfen von Xarfais Blut fallen zu Boden, wo sie zischend "
      "verdampfen.\n",
    "Xarfai bruellt: MUAHAHAHA Eine Seele mehr! Welche Lust sie zu quaelen!\n",
    "Xarfai laesst vor Deinen Augen eine Seele erscheinen, die voller "
    "Pein schreit!\n",
    "Das Wimmern einer gemarterten Seele ist zu hoeren.\n"}) );
/*
  SetAttackChats(100, ({
    "@@attackspell@@" }) );
*/

  // Infos ausserhalb der Libraries  
  AddInfo(({"maske", "schaedelmaske"}), "@@guild_item@@", 
            "kreischt: ");
  AddInfo(({"neuer maske", "neuer schaedelmaske"}), "@@give_guild_item@@", 
            "kreischt: ");

  AddInfo(DEFAULT_INFO, ({
    "bruellt: VERSCHWINDE DU WURM!\n",
    "aefft Ayla nach: Dusty kennt auf alles eine Antwort, frag sie doch mal.\n"
    "Xarfai grinst satanisch.\n",
    "blickt Dich nur gierig an.\n"}));
  
}

//////////////////////////////////////////////////////////////////////////////
// Misc
//////////////////////////////////////////////////////////////////////////////

mapping test123() {
  return waiting_for; 
}

int _query_wimpy() { return 0; }

nomask query_prevent_shadow() { return 1; }


init() {
  ::init();
  //if(call_other(NPCMASTER,"IsFeind",TP)) Kill(TP);
}


remove(int arg) {
  //call_other(NPCMASTER,"del_npc");
  ::remove(arg);
}

reset() {
  if(!is_clone(TO)) return ::reset();
  get_angry=({});
  ::reset();
  new_short();
}

void new_short()
{
  int i, j;
  string *strs;
  strs=({"der Herrscher der Niederhoellen", "der Meister der verlorenen Seelen",
        "der Vernichter der Paladine", "der Herr der Blutinsel Yaq'Monoq",
        "der Meisterbeschwoerer", "die Inkarnation des Boesen selbst",
        "der Beherrscher der Untoten", "der Zombiemeister", "die Geissel der Goetter",
        "der Skelettfreund","der Meister aller Nekromanten",
        "die Wurzel allen Uebels", "der Herr ueber Nicht-Leben und Un-Tot",
        "der Anfuehrer der Verdammten", "der Schlaechter der Feen",
        "der Bewahrer der 7 mal 7 Geheimnisse", "der Hueter des verbotenen Wissens",
        "der Verfluchte der Goetter", "der Blutsaeufer"
        });
  i=j=random(sizeof(strs));
  while(j==i) j=random(sizeof(strs));
  SetProp(P_SHORT, "Xarfai, "+strs[i]+" und "+strs[j][4..]);
}

string fertigkeiten() {
  call_other(ENV(TO), "faehigkeiten");
  return "";
}


