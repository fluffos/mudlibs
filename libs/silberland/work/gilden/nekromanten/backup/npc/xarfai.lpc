//////////////////////////////////////////////////////////////////////////////
// Logs
//////////////////////////////////////////////////////////////////////////////

void die(int poisondeath) {
  if((time()-hb_time)>4) { // Dann hat wohl der Herzschlag ausgesetzt -> bug
    heal_self(3000);
    return;
  }
  call_other(NPCMASTER, "del_npc", TP);
  write_file(KILL_LOG, sprintf(
      "%s: %s killt Xarfai(LVL:%d, GLVL:%d-%s)\n",
      ctime(),CAP(getuid(TP)), TP->QueryProp(P_LEVEL), 
      TP->QueryProp(P_GUILD_LEVEL), TP->QueryProp(P_GUILD)));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if (killer==ME) {
    write_file(KILL_LOG, sprintf(
      "%s: Xarfai killt %s (LVL:%d, GLVL:%d-%s, lXP:%d)\n",
      ctime(),CAP(getuid(player)), player->QueryProp(P_LEVEL), 
      player->QueryProp(P_GUILD_LEVEL), 
      stringp(player->QueryProp(P_GUILD))?player->QueryProp(P_GUILD):"???",
      lostexp));
    command_me("nkreische HARHAR! Ein Zombie mehr!");
  }
  command_me("beschwoerung leiche");
  command_me("beherrschung zombie");
}


//////////////////////////////////////////////////////////////////////////////
// Defend 
//////////////////////////////////////////////////////////////////////////////

void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  object ob;
  int al,en;
  SetProp(P_ALIGN, -1000);
  call_other(NPCMASTER,"help_me",enemy);
  en=(sizeof(PresentEnemies())+1)*100;
  if(en>600) en=600;
  if(en>=100 && !random(4)) ME->ModifySkillAttribute(ME,SA_SPEED,en,4);
  TO->SetProp(P_SP,TO->QueryProp(P_MAX_SP));
  ::Defend(dam, dam_type, spell, enemy);
}

// Nur die Gilde selber darf SkillAttributes veraendern:
varargs void ModifySkillAttribute(object caster, string atrname, int value, int duration, mixed fun) {
  if (PO && PO!=TO && getuid(PO)!="GUILD.nekromanten") return;
  ::ModifySkillAttribute(caster, atrname, value, duration, fun);
}




//////////////////////////////////////////////////////////////////////////////
// Gildensachen
//////////////////////////////////////////////////////////////////////////////

string guild_item() {
  if(TP->QueryProp(P_GUILD)!="nekromanten")
    return "VERSCHWINDE, DU WURM!";
  if(!present(GUILDITEM_ID, TP)) {
    call_out("new_guilditem",0, TP);
  return "BEI ALLEN NIEDERHOELLEN! WO IST DEINE MASKE!";
  }
  return "Harhar! Die Maske ist ein Zeichen Deines Hasses auf das Gute! "
    "Es spiegelt Deine eigene Lust wieder, das Gute zu vernichten. ";
}

string give_guild_item() {
  object ob;
  if(TP->QueryProp(P_GUILD)!=GUILDNAME)
    return "VERSCHWINDE DU WURM!";
  if(!ob=present(GUILDITEM_ID, TP)) {
    call_out("new_guilditem",0, TP);
    return "BEI ALLEN NIEDERHOELLEN! WO IST DEINE MASKE???";
  }
  ob->SetProp(P_CURSED, 0);
  ob->remove();
  call_out("new_guilditem",0, TP);
  return "HIER!";
}

void new_guilditem(object pl) {
  object ob;
  write("Xarfai bewegt seine Haende und murmelt seltsame Worte.\n"
      "Deine Schaedelmaske hat sich erneuert!\n");
  tell_room(ENV(TP), "Xarfai bewegt seine Haende und murmelt seltsame "
      "Worte!\n", ({TP}));
  ob=CLONEOB(ARMOUR "maske");
  ob->move(TP, M_NOCHECK);
  return;
}




//////////////////////////////////////////////////////////////////////////////
// Reactions
//////////////////////////////////////////////////////////////////////////////

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  //if(TPN=="Angrox" || TPN=="Zordan") return;
  if(TP->QueryGuest()) return;
  switch(gruppe) {
    case "nett"      : call_out("gut", 0); 
                       break;
    case "gut"      :  call_out("gut", 0); 
                       break;
    case "intim"     : call_out("intim", 0); 
                       break;
    case "fies"      : call_out("boese", 0);
                       break;
    case "frech"     : call_out("boese",0); 
                       break;
    case "boese"     : call_out("boese",0);
                       break;
    case "traurig"   : call_out("initm", 0); 
    case "aengstlich": call_out("intim", 0);
                       break;
    case "aergerlich": call_out("boese", 0); 
                       break;
    case "froh"      : call_out("gut", 0); 
                       break;
    case "albern"    : call_out("gut", 0); 
                       break;
    default          : break;                   
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
    return StartReaction(verb, gruppe, adverb, touch);
}



void gut() {
  string *guttext;
  if(!present(TP,MENV)) return;
  guttext= ({ "Du kleines gutes Ekelpaket! Verschwinde, %s, bevor "
              "ich Dir Deine Seele raube",
              "HARHAR! Verschwinde, %s",
              "DEINE SEELE WERDE ICH VERNICHTEN, %s", 
              "Geh doch zur Schlampe Ayla, die steht auf so was!"});
  command_me("sag " + sprintf(guttext[random(sizeof(guttext))],TPN)+ "!");
  if(!random(10))
    Kill(TP);
}

void intim() {
  string *intimtext;
  if(!present(TP,MENV)) return;
  command_me("sag DU KLEINE RATTE! ICH WERDE DICH VERNICHTEN!");
  ME->Kill(TP);
  return;
}

void boese() {
  string *boestext;
  if(!present(TP,MENV)) return;
  boestext=({ "Harhar! Du wuerdest gut zu uns passen, %s",
              "DU ELENDIGER VERSAGER! Du musst NOCH boeser werden, %s",
              "HARHAR! Das tut gut, %s"});
  command_me("sag "+sprintf(boestext[random(sizeof(boestext))],TPN)+"!");
}

