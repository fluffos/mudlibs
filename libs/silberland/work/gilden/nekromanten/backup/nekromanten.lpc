/*
//
// Austritt aus der Nekromantengilde
//
*/
int Leave_Ceremony() {
  object gnpc; 
  if(!gnpc=present(GUILDNPC_ID, ME)) {
    write("Ohne "+GUILDNPC_LONGNAME+" laeuft hier gar nichts!\n");
    return 1;
  }
  if(!IsGuildMember(TP)) {
    write("Du bist kein maechtiger Nekromant! Verschwinde!\n");
    return 1;
  }
  gnpc->SetProp(P_NOATTACK,"laesst sich nun nicht beirren.");
  gnpc->SetProp(P_CHAT_CHANCE,0);
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:-1, PARALYZE_MSG:"", 
           PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  LoadSequenz(SEQ+"dummy.seq", TP, #'austreten);  
  return 1;
}

int austreten() {
  object ob,gnpc;

  if(!gnpc=present(GUILDNPC_ID, ME)) {
    write("Ohne "+GUILDNPC_LONGNAME+" laeuft hier gar nichts!\n");
    return 1;
  }
  if( TP->QueryProp(P_GUILD_LEVEL)==7 )
  {
    WLOG("/log/gilden/nekromanten", "wollte aus der Gilde austreten.");
    write("Als Untoter kannst Du nicht mehr aus der Gilde austreten!\n");
  } 
  gnpc->SetProp(P_NOATTACK,0);
  gnpc->SetProp(P_CHAT_CHANCE,1);
  TP->SetProp(P_PARALYZED, 0);
  TP->SetProp(P_GUILD_LEVEL, 0);
  TP->Set(P_GUILD_CIRCLE,SAVE,F_MODE);
  WLOG("/log/gilden/nekromanten", "tritt aus der Gilde aus.");
  if(ob=present(GUILDITEM_ID,TP)) {
	  ob->SetProp(P_CURSED, 0);
	  ob->remove();
  }
  call_other(NMASTER, "DeleteMember", TP);
  call_other(NMASTER, "DeleteTopEntry", getuid(TP));
  call_other(ABILMASTER, "DeleteEntry", getuid(TP));
  Channel(sprintf("%s hat gerade Verrat begangen und uns verlassen! "
      "TOETET IHN UND BRINGT MIR SEIN HERZ! Dann werden wir seinen "
      "Geist in eine Leiche bannen, und er wird uns auf immer als "
      "verrottender Zombie dienen! MUAHAHHAHAHHA!!", TP->Name(WER))); 
  // Nekromanten sollen attack auf spieler sein :P
  write_file(MEMBERLOG+getuid(TP)+".log",
             dtime(time())+": "+CAP(getuid(TP))+" ist "
			 +"aus der Gilde ausgetreten.\n");
  TP->SetProp(P_NEKRO_SKILLS_MOD, 0);
  TP->SetProp(P_NEKRO_TASK_POINTS, 0);
  TP->SetProp(P_GUILD_CIRCLE, 0);
  return ::austreten();
}


nosave int Sacrifice(string str) {
  string wo;
  string not_fail, g_indent, restr, *paladins;
  object gnpc;
  int gender;

  if(!str) return 0;
  paladinopfer=lower_case(str);
  notify_fail(BS(
    "Zur Zeit duerfen nur Testspieler und Magier in dieser Gilde "
    "Paladine opfern! Aber bald!"));
  if(!TP->QueryProp(P_TESTPLAYER) && !IS_WIZARD(TP)) {
    return 0;
  }
  TELL("angrox", str+"\n");
  notify_fail("Ohne "+GUILDNPC_LONGNAME+" laeuft hier gar nichts!\n");
  if(!gnpc=present(GUILDNPC_ID, ME)) {
    return 0;
  }
  
  notify_fail(
    BSA("Verschwinde, Du hast schon geopfert! Toete lieber ein paar "
    "Unschuldige!", GUILDNPC_NAME+" kraechzt: "));
  if(IsGuildMember(TP)) {
     return 0;
  }
  if(TP->QueryProp(P_GUILD)=="paladine") {
    tell_room(ME, BSA("STIRB!", GUILDNPC_NAME+" bruellt: "));
    // Xarfai -> kill
    return 1;
  }
  if( TP->QueryProp(P_DEFAULT_GUILD) &&
      TP->QueryProp(P_GUILD)!=TP->QueryProp(P_DEFAULT_GUILD)) {
    tell_room(ENV(TP), BSA(sprintf("BEI ALLEN NIEDERHOELLEN! Du "
            "bist ein echter Versager, %s! Tritt erst einmal aus "
            "Deiner laecherlichen Gilde aus! DANN und ERST DANN "
            "komm wieder, sonst reisse ich Dir Dein Herz heraus!!!", 
            TP->name(WER)), "Xarfai bruellt: "));
    return 1;
    
  }
  paladins=call_other(PMASTER, "QueryMembers");
  if(member(paladins, paladinopfer)==-1 && paladinopfer!="knuth") {
     tell_room(ENV(TP), BSA(sprintf("DU ELENDIG%s VERSAG%s! Verschwinde, "
             "bevor wir Dich opfern! Du wirst nie Nekromant werden, wenn "
             "Du nicht mal unsere Feinde, die Paladine, erkennst, %s!!!", 
             TP->QueryProp(P_GENDER)==FEMALE?"E":"ER", 
             TP->QueryProp(P_GENDER)==FEMALE?"ERIN":"ER", 
             TP->Name(WER)), GUILDNPC_NAME+" bruellt: "));
     return 1;
  }
  if(find_player(paladinopfer)) {
     tell_room(ENV(TP), BSA(sprintf("%s, Du verdammt%s %s! Muss man Dir "
             "alles sagen? Hast Du kein Gehirn, oder stellst Du Dich nur "
             "so bloed an? Der Paladin, den Du opfern sollst, darf "
             "natuerlich nicht anwesend sein? "
             "HAST DU ES DIESMAL VERSTANDEN!?!?!?!?!?!",
             TP->Name(WER),TP->QueryProp(P_GENDER)==FEMALE?"e":"er", 
             TP->QueryProp(P_GENDER)==FEMALE?"Naerrin":"Narr"), 
             GUILDNPC_NAME+" bruellt: "));
     return 1;
  }
  
  if(restr=call_other(RES_CHECKER, "check_restrictions", TP,  
      QueryProp(P_GUILD_RESTRICTIONS))) 
  {
     tell_room(ENV(TP), BSA(sprintf("Du elendig%s Versager%s! Verschwinde, "
             "bevor wir Dich opfern! Du wirst nie Nekromant werden, wenn "
             "Du so schwach bist!, %s! %s", 
             TP->QueryProp(P_GENDER)==FEMALE?"e":"er", 
             TP->QueryProp(P_GENDER)==FEMALE?"erin":"er", 
             TP->Name(WER), restr), GUILDNPC_NAME+" bruellt: "));
    return 1;
  }
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:-1, PARALYZE_MSG:"", 
           PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
  gnpc->SetProp(P_NOATTACK,"ist zu vertieft in die Zeremonie.");
  gnpc->SetProp(P_CHAT_CHANCE,0);
  
  gender=call_other(SAVEMASTER, "QueryFileProp", paladinopfer, 
      P_GENDER);
  SetThirdPerson(CAP(paladinopfer), gender==FEMALE?"sie":"er", 
      gender==FEMALE?"sie":"ihn", gender==FEMALE?"ihr":"sein");
  TELL("angrox", sprintf("Gewaehlter Paladin: %s\n", paladinopfer));
  LoadSequenz(SEQ+"beitritt.seq", TP, #'Sacrifice_Part_Two); 
  return 1;
}

nosave void Sacrifice_Part_Two() {
 write(BS(sprintf("Um %s zu opfern, gib 'toete %s' ein!", CAP(paladinopfer), 
        paladinopfer)));
 write("Was moechtest Du nun tun?\n");
 input_to("Sacrifice_Part_Two_input"); 
}

nosave void Sacrifice_Part_Two_input(string str) {
  string req_input;
  object xarfai;
  req_input="toete "+paladinopfer;
  if(!str || str!=req_input) {
    tell_room(ENV(TP), BSA("WAS! DU NARR! DAFUER WIRST DU BUESSEN!", 
          "Xarfai bruellt erbost: "));
    
    present(GUILDNPC_ID)->Kill(TP);
    return;
  }
  LoadSequenz(SEQ+"beitritt2.seq", TP, #'Sacrifice_Part_Three); 
}

nosave void Sacrifice_Part_Three() {
  object opfer;
  string *msgs;
  msgs=({BSA("UND DIE FLUESSE FAERBEN SICH ROOOOOOOOOOOOOOOOOOT!!!!!", 
        "bruellt: "),
      "kreischt: Stirb Paladinpack!", "kreischt: Ich bin euer schlimmster "
      "Alptraum!", "bruellt: WO IST DER NAECHSTE VON EUCH?", "lacht wie von "
      "Sinnen!", BSA("FEIGLINGE! VERKRIECHT EUCH IN EURE BURG!", "bruellt: "), 
      "bruellt: UND SIE FALLEN IN HEKATOMBEN!"});      
  shout(BS(sprintf("Der entsetzliche und grauenhafte Todesschrei "
            "von %s hallt durch das SilberLand.", CAP(paladinopfer))));
  SetProp(P_NAME, "Lars");
  CHMASTER->join("Tod",TO);
  CHMASTER->send("Tod", TO, sprintf("Paladin %s wurde von %s auf dem Altar "
        "des Blutes der Nekromanten geopfert.", CAP(paladinopfer), 
        TP->name(WER)), MSG_SAY);
  SetProp(P_NAME, TP->Name(WER));
  CHMASTER->send("Tod", TO, msgs[random(sizeof(msgs))], MSG_EMOTE);
  SetProp(P_NAME, GUILDNPC_NAME); 
  call_other(PNPCMASTER, "AddFeind", TP);
  call_out("ayla_shout", 6);
  LoadSequenz(SEQ+"beitritt3.seq", TP, #'beitreten);
  return;
}

nosave void ayla_shout() {
  object ayla;
  if(ayla=find_living("ayla"))
    ayla->command_me(sprintf("prufe PALADINE! %s hat es gewagt, %s "
          "zu opfern! DAFUER GIBT ES NUR EINE STRAFE! Bringt mir den "
          "Kopf von %s!", TP->Name(WER), CAP(paladinopfer), 
          TP->name(WER)));
  return;
}

int beitreten() {
  int b;
  object ob,gnpc;
  string *who;

  if(!gnpc=present(GUILDNPC_ID, ME)) {
    write("Ohne "+GUILDNPC_LONGNAME+" laeuft hier gar nichts!\n");
    return 1;
  }
  gnpc->SetProp(P_NOATTACK,0);
  gnpc->SetProp(P_CHAT_CHANCE,1);
  who=({"Etwas", "Verdammter", "Verdammte"});
  TP->SetProp(P_PARALYZED, 0);
  if((b=::beitreten())<0) return 1;
  tell_room(ENV(TP), BSA(sprintf("Haha, %s, nun gehoert Deine Seele UNS!", 
          TP->Name(WER)), GUILDNPC_NAME+" kichert irr: "));
  write(BS("Voller Blutlust nimmst Du die Schaedelfront und setzt sie Dir "
        "als Maske auf!"));
  say(BS(sprintf("Voller Blutlust nimmer %s die Schaedelfront und setzt sie "
         "sich als Maske auf.", TP->Name(WER))));
  ob=clone_object(ARMOUR+"maske");
  ob->move(TP, M_NOCHECK);
  ob->DoWear(0);
  WLOG("/log/gilden/nekromanten", "tritt in die Gilde ein.\n");
  if(!paladinopfer) paladinopfer="juny";
  call_other(NMASTER, "AddMember", TP, 
      ({paladinopfer, call_other(SAVEMASTER, "QueryFileProp", paladinopfer, 
      P_GENDER)}));
  TP->ModifySkill(FIGHT(WT_KNIFE), QuerySkill(FIGHT(WT_KNIFE)),100,
      "nekromanten");
  TP->ModifySkill(SK_NIGHTVISION, QuerySkill(SK_NIGHTVISION),100,
      "nekromanten");
  TP->Set(P_NEKRO_SKILLS_MOD, SAVE, F_MODE_AS);
  TP->Set(P_NEKRO_TASK_POINTS, SAVE, F_MODE_AS);
  TP->Set(P_GUILD_CIRCLE,SAVE,F_MODE_AS);
  TP->SetProp(P_GUILD_CIRCLE,1);
  write_file(MEMBERLOG+getuid(TP)+".log",
             dtime(time())+": "+CAP(getuid(TP))+" ist "
			 +"in die Gilde eingetreten.\n");
  Channel(sprintf("%s! Ich wusste, dass Deine schwarze Seele "
        "eines Tages zu uns Nekromanten finden wuerde! Bei "
        "den endlosen Heerscharen von Yaq'Monoq, den verfluchten "
        "Ebenen von Ylem'Huran und dem bluttriefenden Steinkreis von "
        "Rot'Manuq, "
        "moegest Du stets die Seelen der Unschuldigen verfuehren und "
        "den dunklen Goettern opfern, auf dass sie eines Tages ihre "
        "blutige Herrschaft ueber das SilberLand erlangen moegen!",
      TP->Name(WER), who[TP->QueryProp(P_GENDER)]));
 return b;
}

int treten( string str)
{
  if( str=="in gilde ein" )
    return beitreten();
  if( str=="aus gilde aus")
    return austreten();
  return 0;
}

