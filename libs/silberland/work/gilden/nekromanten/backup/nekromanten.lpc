nosave mixed advance(string str) {
  mixed res;
  mapping cond;
  int glvl, ggrad, abil;
  object xarfai;

  glvl=TP->QueryProp(P_GUILD_LEVEL);
  ggrad=TP->QueryProp(P_GUILD_CIRCLE); 
  
  notify_fail(BSA("Was willst Du erhoehen? Stufe(deaktiviert!!!)? "
        "Kreise der Verdammnis? Innerer Grad?, Kraft? Int(elligenz)? "
        "Aus(dauer)? "
        "Gesch(icklichkeit)?\n", GUILDNPC_NAME
         +" sagt: "));
  if (!str) return 0;
  if (str == "stufe") return 0; // vorerst deaktiviert, da BUGGT was !!!
                                // es wird autom evtl. gildenstufe mit erhoeht!!
  if(!xarfai=present(GUILDNPC_ID)) {
    write("Hier ist leider niemand, der Dich erhoehen koennte!\n");
    return 1;
  }
  if (str=="stufe" || str2attr(str)) {
	 return ::advance(str);
  }
  if(str=="kreis" || str=="kreis der verdammnis" ) {
    if(!IsGuildMember(TP)) {
      tell_room(ME, BSA(sprintf("Du kannst hier nicht erhoehen, Du "
                +"bist keiner von uns, %s!\n", TP->Name(WER)), GUILDNPC_NAME
                +" sagt: "));
      return 1;
    }
    if(glvl>=7) {
      write(BSA("Du kannst nicht mehr weiter aufsteigen!\n",
                GUILDNPC_NAME+" sagt: "));
      say(BSA("Du kannst nicht mehr weiter aufsteigen, "
              +CAP(getuid(TP))+".\n", GUILDNPC_NAME +" sagt: "));
      return 1;
    }
    if(ggrad!=7) {
      write(BSA("VERSAGER! Du musst zuerst den 7. Grad des "+glvl+". Kreises "
            "der Verdammnis erreicht haben!\n", GUILDNPC_NAME+" sagt: "));
      say(BSA("VERSAGER! Du musst zuerst den 7. Grad des "+glvl+". Kreises der "
            "Verdammnis erreicht haben, "
              +CAP(getuid(TP))+".\n", GUILDNPC_NAME +" bruellt: "));
      return 1;
    }
    cond=QueryProp(P_GUILD_LEVELS);
    res=call_other(RES_CHECKER, "check_restrictions", TP, cond[glvl+1]);
    if(!stringp(res)) {
      TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:-1, PARALYZE_MSG:"", 
            PARALYZE_MSG_OTHER:"", PARALYZE_END:"", PARALYZE_END_OTHER:""]));
      xarfai->SetProp(P_NOATTACK,"ist zu vertieft in die Zeremonie.");
      xarfai->SetProp(P_CHAT_CHANCE,0);
      ::advance(); // Eigentlicher Aufstieg der Gildenstufe
      abil=TP->QuerySkill( SK_NIGHTVISION)[SI_SKILLABILITY]+200;
      TP->ModifySkill( SK_NIGHTVISION, ([ SI_SKILLABILITY: 
          (abil>MAX_ABILITY?MAX_ABILITY:abil) ]), 1,"nekromanten" );
      if(glvl=7) 
        LoadSequenz(SEQ+"undead1.seq", TP, #'Become_Undead_One); 
      else
        LoadSequenz(SEQ+"dummy.seq", TP, #'advance2);
      return 1;
    }
    else {
      if(res!="")
        tell_room(ME, BSA(sprintf("Du kannst noch nicht aufsteigen, %s! %s", 
            TP->Name(WER), res), GUILDNPC_NAME+" sagt: "));
      return 1;
    }
  }
  // AB HIER DER INNERE GRAD
  if(member(({"kreisstufe", "grad", "innerer grad", "inneren grad"}), str)!=-1)
  {
    if(!IsGuildMember(TP)) {
      tell_room(ME, BSA(sprintf("Du kannst hier nicht erhoehen, Du "
                +"bist keiner von uns, %s!\n", TP->Name(WER)), GUILDNPC_NAME
                +" sagt: "));
      return 1;
    }
    
    if(ggrad>=7) {
      if (glvl>=7) {
        write(BSA("Du kannst nicht mehr weiter aufsteigen!\n"
                  ,GUILDNPC_NAME" sagt: "));       
        say(BSA("Du kannst nicht mehr weiter aufsteigen, "
                +CAP(getuid(TP))+".\n",GUILDNPC_NAME" sagt: ")); 
      }
      else {
        write(BSA("Bevor Du wieder einen inneren Grad erhoehen kannst, "
              "musst Du zuerst in einen hoeheren Kreis der Verdammnis "
              "aufsteigen!\n", GUILDNPC_NAME+" sagt: "));
        say(BSA("Bevor Du wieder einen inneren Grad erhoehen kannst, musst Du "
              "zuerst in einen hoeheren Kreis der Verdammnis aufsteigen, "
                +CAP(getuid(TP))+".\n", GUILDNPC_NAME +" sagt: "));
      }
      return 1;
    }
    /* Restrictions pruefen */
    cond=QueryProp(P_GUILD_CIRCLE_LEVELS)[glvl];
    res=call_other(RES_CHECKER, "check_restrictions", TP, cond[ggrad+1]);
    if(!stringp(res)) {
      TP->SetProp(P_GUILD_CIRCLE, ggrad+1);
      abil=TP->QuerySkill( SK_NIGHTVISION)[SI_SKILLABILITY]+200;
      TP->ModifySkill( SK_NIGHTVISION, ([ SI_SKILLABILITY: 
          (abil>MAX_ABILITY?MAX_ABILITY:abil) ]), 1,"nekromanten" );
      call_other(NEKROMASTER, "AdvanceInnerCircle", TP);
      write(BS(
        "Du bist soeben in den "+(ggrad+1)+". Grad des "+glvl+". Kreises "
        "der Verdammnis aufgestiegen."));
      say(BS(
        TP->Name()+" hat soeben den "+(ggrad+1)+". Grad des "+glvl+". Kreises "
        "der Verdammnis erreicht."));
      return 1;
    }
    else {
      if(res!="")
        tell_room(ME, BSA(sprintf("Du kannst noch nicht aufsteigen, %s! %s", 
            TP->Name(WER), res), GUILDNPC_NAME+" kichert irr: "));
      return 1;
    }
  }
  return 0;
}

void Become_Undead_One() {
  string pl_name;
  object pl;
  pl_name=getuid(TP);
  CHMASTER->join("Tod",TO);
  CHMASTER->send("Tod", TO, sprintf("Der Verlust der eigenen Seele hat gerade "
        "%s umgebracht.", CAP(pl_name)));
  // Aendern der Shell auf Untot
  TP->SetProp(P_OLD_SHELL_ATTR_OFFSET, TP->QueryProp(P_ATTRIBUTES_OFFSETS));
  TP->Set(P_OLD_SHELL_ATTR_OFFSET, SAVE, F_MODE); // speichern im player
  MASTER->set_player_object(pl_name, UNDEAD_SHELL);
  MASTER->renew_player_object(pl_name);
  pl=find_player(pl_name); 
  LoadSequenz(SEQ+"undead2.seq", pl, #'advance2); 
    // Shell - Ende
  return ;
}

