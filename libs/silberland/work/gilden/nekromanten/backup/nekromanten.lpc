}


nosave varargs int advance2() {
  mixed b;
  object gnpc;
  if(gnpc=present(GUILDNPC_ID)) {
    gnpc->SetProp(P_NOATTACK,0);
    gnpc->SetProp(P_CHAT_CHANCE,1);
  }
  TP->SetProp(P_PARALYZED, 0);
  //::advance(); // schon in advance()
  TP->SetProp(P_GUILD_CIRCLE, 1);
  if(TP->QueryProp(P_GUILD_LEVEL)>6) {
    write_file(MEMBERLOG+getuid(TP)+".log", dtime(time())+": "+
               CAP(getuid(TP))+" hat " +"die hoechste Stufe erreicht.\n");
    Channel(sprintf("HARHAR! Fuerchtet Euch, ihr Narren! Ein weiterer "
          "maechtiger Untoter wird euch nun heimsuchen und eure Alptraeume "
          "wahr werden lassen! Und Du, %s, VERNICHTE SIE ALLE !!!", 
          CAP(getuid(TP))));
    return 1;
  }
  write_file(MEMBERLOG+getuid(TP)+".log",
             dtime(time())+": "+CAP(getuid(TP))+" ist "
             +"eine Stufe (->"+TP->QueryProp(P_GUILD_LEVEL)+
              ") aufgestiegen.\n");
  //Channel(CAP(getuid(TP))+" ist nach Ratschluss der allmaechtigen Dusty "
  //        +"in der Hierarchie der Paladine aufgestiegen und hat somit "
  //        +"Gildenstufe "
  //        +TP->QueryProp(P_GUILD_LEVEL)+" erreicht.");
  call_other(NMASTER, "AdvanceLevel", TP);
  return 1;
}



int OwnLearnSpell(string str) {
  mapping sprueche;
  if(!present(GUILDNPC_ID, ME)) {
    write(BS(GUILDNPC_LONGNAME+" ist nicht hier! VERSCHWINDE!!\n"));
    return 1;
  }
  str=TP->_unparsed_args();
  if(!IsGuildMember(TP)) {
    tell_room(ME,BSA("DU WURM!!\n", GUILDNPC_NAME+" bruellt: "));
    return 1;
  }
  notify_fail("WELCHE DAEMONISCHE BOSHEIT MOECHTEST DU LERNEN??\n");
  if(!str) {
    tell_room(ME, BSA(sprintf("HARHARHAR! DU WEISST NICHT MAL WAS DU "
             "EINSETZEN KANNST UM VERNICHTUNG IN DIE WELT ZU TRAGEN! "
             "DU WURM, %s!", TP->Name(WER)), GUILDNPC_NAME+" bruellt: "));
    return 1;
  }
  write("str = "+str+"\n");
  return LearnSpell(str);
}


mapping Dolchkampf(object player, string skill, mapping sinfo) { 
  int abil, ud, val, bonus;

  ud=sinfo[SI_USR];
  abil = sinfo[SI_SKILLABILITY];
  val = (2* player->QueryAttribute(A_DEX) +  player->QueryAttribute(A_STR) +
         3*player->QueryProp(P_GUILD_LEVEL) + 2*player->QueryProp(P_GUILD_CIRCLE) 
        ) * abil / MAX_ABILITY;

//  tell_feyaria("Ohne Skill: "+sinfo[SI_SKILLDAMAGE]+"\n");
  bonus=random(val);
  bonus=(bonus>MAX_KNIFE && interactive(player)?MAX_KNIFE:bonus);
  sinfo[SI_SKILLDAMAGE] += bonus * player->QuerySkillAttribute(SA_DAMAGE)/100;
//  tell_feyaria("Mit Skill: "+sinfo[SI_SKILLDAMAGE]+"\n");
  if( player->QueryProp(P_FROG) || 
      player->QueryProp(P_WEAPON)->QueryProp(P_WC) < abil/100 ) return sinfo;
  if( (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > abil/400 || !random(10) )
     && ++ud > abil/50 && abil<MAX_ABILITY) 
  {
//    tell_feyaria("GELERNT!\n");
    ud = 0;
    abil += random(player->QuerProp(P_GUILD_LEVEL) + 
            player->QueryAttribute(A_DEX)/3 - player->QueryProp(P_ALIGN)/166);
  }

  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  player->ModifySkill( FIGHT(WT_KNIFE), ([ SI_USR: ud, SI_SKILLABILITY: abil ]),
                       sinfo[SI_DIFFICULTY], "nekromanten");
  return sinfo;
}

//
//
// Auswertung der Aufstiegsbedingungen
//
//
string LCond(object pl) {
  string str;
  mixed var;
  str="";
  if(!IsGuildMember(pl)) return 0;
  if(pl->QueryProp(P_FROG))
     return BSA("Muahahahar! Du IDIOT! Als Frosch wagst Du Dich hier her!"
          "VERSCHWINDE BEVOR ICH DICH VERNICHTE!", 
          GUILDNPC_NAME+" kreischt: ");
  if(stringp(var=check_lvl_cond(pl, 0))) // XP
      str+=var;
  if(stringp(var=check_lvl_cond(pl, 1))) // LXP
      str+=var;
  if(stringp(var=check_lvl_cond(pl, 2))) // Seelen opfern 
      str+=var;
  if(str=="") return 0; // Ok, wir duerfen aufsteigen
  return str; // Och, leider nicht :(
}

string LCond2(object pl) {
  string str;
  mixed var;
  str="";
  if(!IsGuildMember(pl)) return 0;
  if(pl->QueryProp(P_FROG))
     return BSA("Muahahahar! Du IDIOT! Als Frosch wagst Du Dich hier her!"
          "VERSCHWINDE BEVOR ICH DICH VERNICHTE!", 
          GUILDNPC_NAME+" kreischt: ");
  if(stringp(var=check_lvl_cond(pl, 3))) // XP
      str+=var;
  if(str=="") return 0; // Ok, wir duerfen aufsteigen
  return str; // Och, leider nicht :(
}


// Auswertung des Mappings und Ausgabe was denn wo fehlt
nosave string check_lvl_cond(object pl, int flag) {
  string str;
  int percent, x,lvl, value;
  mixed cond;
  cond=({XP_PER_LEVEL,LXP_PER_LEVEL,BLOOD_PER_LEVEL, KILLS_PER_INNERCIRCLE});
  str="";
  x=0;
  lvl=pl->QueryProp(P_GUILD_LEVEL);
  switch(flag) {
    case 0: 
       if(x=call_other(NEKROMASTER, "QueryXpDifference", pl)) 
         str="Ahhh, ich sehe von der geforderten Erfahrung fehlt Dir ";
       break;
    case 1:
       if(x=call_other(NEKROMASTER, "QueryLXpDifference", pl)) 
         str="Harhar! Todeserfahrungen! Davon fehlen Dir ";
       break;
    case 2:
       if(x=call_other(NEKROMASTER, "QueryNeededBlood", pl)) //Bluuuuuuuut ;)
         str="Und eines noch! Vergiss nicht das Wichtigste: Seelen! Du "
             "musst mehr Seelen opfern! Es fehlen Dir ";
    case 3:
       lvl=pl->QueryProp(P_GUILD_CIRCLE);
       if(x=call_other(NEKROMASTER, "QueryKilled", pl))
         str="Ich sehe, Du musst noch toeten! Toeten! TOETEN! Geh hinaus "
           "und toete! Um aufsteigen zu koennen musst Du mehr "
           "Lebewesen toeten, es fehlen Dir ";
             
  }
  if(x<=1) return 0; // Alles erfuellt?
  return str+integer2percent(100*x/cond[flag][lvl-1]);
}

// integer -> percent-string 
nosave string integer2percent(int percent) {
  string str;
  str="";
  switch (percent) {
    case 0..10:  str+="fast gar keine mehr.";
                 break;
    case 11..20: str+="weniger als ein Viertel.";
                 break;
    case 21..30: str+="etwa ein Viertel.";
                 break;
    case 31..40: str+="weniger als die Haelfte.";
                 break;
    case 41..60: str+="in etwa die Haelfte.";
                 break;
    case 61..70: str+="mehr als die Haelfte.";
                 break;
    case 71..80: str+="etwa drei Viertel.";
                 break;
    case 81..90: str+="mehr als drei Viertel.";
                 break;
    case 91..100: str+="beinahe alle.";
                  break;
    default:      str+="mehr als gewoehnlich. Harhar! Betrachte das "
                    "als Strafe!";
  }
  return str+" ";
}

int Nightvision(object me, string sname, mixed sinfo) {
  int abil,light,llt,dt,res;

  if (!sinfo || !environment(me) || !interactive(me)) return 0;
  if (intp(sinfo)) sinfo=([SI_SKILLABILITY:sinfo]);
  if (!mappingp(sinfo)) return 0;
  if ((light=set_light(0))>0) {
    me->ModifySkill(sname,([SI_LASTLIGHT:time()]));
    return light;
  }
  abil=sinfo[SI_SKILLABILITY];
  if (!(llt=sinfo[SI_LASTLIGHT])) {
    TP->ModifySkill(sname,([SI_LASTLIGHT:time()]));
    dt=0;
  } else {
    dt=time()-llt;
    if (dt<0) dt=0;
    if (dt>86400) dt=86400;
  }

  res=(abil*dt)/(5*MAX_ABILITY)+light;
  if (res<=0) {
    res--; // Wert muss !=0 sein
    if (res<-MAX_ABILITY) res=-MAX_ABILITY;
  } else {
    if (res>MAX_ABILITY) res=MAX_ABILITY;
  }
  return res;
}
