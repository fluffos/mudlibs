nosave int guilditem_help(string str) {
  write("\nDeine Makse bietet Dir folgende Dienste:\n"
      +"nreport hilfe: Hilfeseite zu preport\n"
      +"nfarben hilfe: Hilfe zu den Farbeinstellungen\n"
      +"nkreische    : Gildenruf\n"
      +"nwer (ort)   : Welche Verdammte sind da und vor allem WO!\n"
      +"nhist        : History\n"
      +"nstatus      : Eigener Status\n");
  return 1;
}

