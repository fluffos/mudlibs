// No Shadows, thank you :)
nomask int query_prevent_shadow() { return 1; }
//
// CREATE
//
void create() {
  if( !is_clone(TO) ) return;
  ::create();

  // Farben holen:
  // Farben holen:
  std_colors=({ANSI_GREEN, ANSI_YELLOW, ANSI_CYAN, ANSI_BLUE, ANSI_RED});
  report_colors=call_other(GUILD_MASTER, "QueryColors", TP);
  if(!pointerp(report_colors) || !sizeof(report_colors)) 
    report_colors=std_colors;
  akt_lvl=set_bit(akt_lvl, 1);
  soulhits=2;
  
  // Properties:
  SetProp(P_NAME, "Schaedelmaske");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schaedelmaske", "maske", NEKRO_GUILDITEM_ID, 
        NEKRO_MISC_GUILDITEM_ID }) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MATERIAL, ([MAT_BONE:50, MAT_FLESH:40, MAT_BLOOD:10]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_CURSED, 0);
  SetProp(P_INFO, "Bluuuuuuuuuuut...\n\nMehr Infos: nhilfe\n");
  SetProp(P_WORN_TEXT, "aufgesetzt");
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  
  // Kommandos: 
  AddCmd(({"nkreisch", "nkreische","nemote"}),"guild_shout");
  AddCmd(({"mkreisch","mkreische"}), "mages_shout");
  AddCmd(({"nwer"}),                 "guild_who");
  AddCmd(({"nreport"}),              "Report");
  AddCmd(({"ntrete", "ntritt"}),     "ntreten");
  AddCmd(({"nhist"}),                "ShowHistory");
  AddCmd(({"mnhist"}),               "ShowMagesHistory");
  AddCmd(({"nhilfe"}),               "guilditem_help");
  AddCmd(({"nstatus"}),              "Status");
  AddCmd(({"nfarben"}),              "SetColors");
  AddCmd(({"opfer","opfere"}),       "Sacrifice");
  AddCmd(({"info","ninfo"}),         "ShowInfo");
//  AddCmd(({"ngilde"}),               "go_gilde");
  AddCmd(({"seelenschlag"}),         "SoulHit");
  AddCmd(({"ntitel"}),               "SetNekroTitle");
  call_out("UpdatePaladin", 4);
}

void reset() {
  if( !is_clone(TO) ) return;
  ::reset();
  number_of_mysterium_casts=10;
  soulhits=2;
  call_out("UpdatePaladin", 4);
  if (objectp(owner) && interactive(owner) && owner->QueryProp(P_GUILD_LEVEL) == 7)
  {
    new_level7_title();
    SetProp(P_X_HEALTH_MOD, 0);
    SetProp(P_X_MAX_HEALTH_MOD, 0);
    owner->UpdateAttributes();
  }
}

int go_gilde()
{
  if(!TP->QueryProp(P_TESTPLAYER))
    return 0;
  notify_fail("Das geht nur von der Abenteuerergilde aus.\n");
  if(file_name(ENV(TP))=="/gilden/abenteurer")
    return TP->move("/gilden/nekromanten",M_TPORT),1;
  else if( file_name(ENV(TP))=="/gilden/nekromanten" )
    return TP->move("/gilden/abenteurer",M_TPORT),1;
  return 0;
}

string _query_long() 
{
  string wer, was;
  object show_pl;
  if(member( ({"zeige", "zeig"}), query_verb())!=-1) {
    if(sscanf(TP->_unparsed_args(), "%s %s", wer,was)==2) {
      show_pl=present(wer,ENV(TP));
    }
  }
  if( !pointerp(paladin) || sizeof(paladin) != 2 || !stringp(paladin[0]) )
    UpdatePaladin();
  if(!show_pl)
     return break_string(sprintf(long_desc[1], paladin[0]),78,0,BS_LEAVE_MY_LFS);

  if(getuid(show_pl)==paladin[0])
     return break_string(long_desc[2],78,0,BS_LEAVE_MY_LFS);
  return break_string(sprintf(long_desc[0], paladin[0]),78,0,
      BS_LEAVE_MY_LFS);
  if(show_pl->QueryProp(P_GUILD)=="nekromanten") 
     return break_string(sprintf(long_desc[1], paladin[0]),78,0,
         BS_LEAVE_MY_LFS);
  return break_string(sprintf(long_desc[0], paladin[0]),78,0,
      BS_LEAVE_MY_LFS);
}

string _query_info() 
{
  if(TP->QueryProp(P_GUILD)=="nekromanten" )
  {
    return BS("Mit Deiner Maske kannst Du einen Seelenschlag "
        "(Syntax: seelenschlag) gegen den Paladin "
        "durchfuehren, den Du geopfert hast! Bedenke jedoch, dass dies nur "
        "EINMAL pro einer gewissen Zeitspanne funktioniert und das andere "
        "Nekromanten, die diesen Paladin ebenfalls geopfert haben dies "
        "ebenfalls koennen, so dass Du leer ausgehen koenntest. ALSO NUTZE "
        "DIE CHANCE!!! Weiters kannst Du - wenn Du einen Dolch gezueckt "
        "hast - die Seele eines getoeteten Wesens opfern (opfere leiche).");
  } 
  return BS("Die Maske wimmert leise ...");
}

void UpdatePaladin() {
  object wearer;
  wearer=QueryProp(P_WORN);
  if(!objectp(wearer)) {
    paladin=({"einem unbekannten Paladin",1}); 
    return ;
  }
  paladin=call_other(NEKROMASTER, "QueryKilledPaladin", wearer); 
  if(!pointerp(paladin) || !sizeof(paladin))
    paladin=({"einem unbekannten Paladin",1}); 
  else {
    paladin[0]=CAP(paladin[0]);
  }
  return ;
}

string GetAlign(int i)
{
  string ret;
  
  if(!intp(i)) i = 0;

  if(i <= -1300) ret = "diabolisch";
  else if(i == -666) ret = "teuflisch";
  else
    switch(i)
    {
      case -1299 .. -1000: ret = "satanisch";  break;
      case  -999 ..  -800: ret = "sehr boese"; break;
      case  -799 ..  -500: ret = "boese";      break;
      case  -499 ..  -200: ret = "gemein";     break;
      case  -199 ..   -40: ret = "frech";      break;
      case   -39 ..    39: ret = "neutral";    break;
      case    40 ..   199: ret = "nett";       break;
      case   200 ..   499: ret = "lieb";       break;
      case   500 ..   799: ret = "gut";        break;
      case   800 ..   999: ret = "sehr gut";   break;
      default:             ret = "heilig";
    }
  return ret;
}
// init ueberschrieben:
void init() 
{
  object ob;
  string adj;
  ::init();
  if(!living(MENV))
    call_out("remove",0);
  if( MENV->QueryProp(P_GUILD)!= "nekromanten" && !IS_WIZARD(MENV)) 
  {
    write("Die Maske loest sich mit einem haesslichen Zischen auf!\n");
    MENV->do_damage(random(20));
    call_out("remove",0);
    return 0;
  }
  // Geopferten Paladin holen:
  if(!sizeof(paladin)) 
  {
    UpdatePaladin();
    adj=adjectives[random(sizeof(adjectives))];
    SetProp(P_SHORT, "Eine "+adj+"e Schaedelmaske");
    SetProp(P_NAME_ADJ, adj);
  }

  if(TP!=MENV) return 0;
  DoWear();
  tell_object(MENV, "Du setzt die Maske auf und spuerst das Boese in "
      "Dir...\n");
  owner = MENV;
  align = GetAlign(owner->QueryProp(P_ALIGN));
}

// WearFunc: 
int WearFunc(object ob) 
{
  if (TP->QueryProp(P_GUILD)!= "nekromanten" && !IS_WIZARD(TP)) {
    write("Die Maske loest sich mit einem haesslichen Zischen auf!\n");
    MENV->do_damage(random(20));
    call_out("remove",0);
  }
  if(ob == TO)
  {
    if (MENV->QueryProp(P_GUILD) == "nekromanten")
      call_out("activate", 0, MENV);
    call_out("SetListener",0,1);
  }
  return 1;
}

// Remove Func

int RemoveFunc(object me) {
  int wearer;
  wearer=QueryProp(P_WORN);
  if(!wearer) return 1;
  if(wearer->QueryProp(P_GUILD) != GUILDNAME)
    wearer->SetProp(P_TMP_NECROMANCER_LISTENER, 0);
  return 1;
}


// WieldFunc:
int WieldFunc(object ob) { return 1; }

//
// ** MISC FUNCTIONS **
//

/* Ist das Objekt ein Nekromant? */
int is_nekromant(object ob)
{
  return (ob->QueryProp(P_GUILD)=="nekromanten"?1:0);
}

/* NPCs werden geopfert und im Master gesaved */
nosave int Sacrifice(string str)
{
  object corpse,weap,stone;
  object *present_nekros;
  string name;
  int i,level,percent,align, glvl,grad, pestered,
      overflow;
  float divisor;
  int *pool;
  pestered=0;
  divisor=2.0; // level / divisor == uebergabe an bloodpool; 
  notify_fail("So etwas siehst Du da gar nicht.\n");
  if( !str ) return 0;
  if (!corpse=present(str,ENV(TP)))
    return 0;
  notify_fail("Du kannst nur Leichen opfern.\n");
  if (!corpse->id("Leiche"))
    return 0;
  if (corpse->QueryProp(P_KILLER)!=TP)
    divisor+=2.0;
  notify_fail("Daemonen und Untote haben keine Seele, die Du opfern kannst!\n");
  if (corpse->is_class_member(({CL_UNDEAD,CL_DEMON})))
    return 0;
  notify_fail("Dafuer bist Du nicht boese genug.\n");
  if (TP->QueryProp(P_ALIGN)>0)
    return 0;
  notify_fail("Du brauchst einen Dolch oder ein Messer dazu!\n");
  if(!weap=TP->QueryProp(P_WEAPON))
    return 0;
  if(corpse->QueryProp(P_NOMAGIC) == "dusty") {
    write(BS("Bei allen Niederhoellen! Diese jaemmerlichen Paladine "
          "haben diese Seele gesegnet! NUN NUTZT SIE UNS NICHTS MEHR!"));
    return 1;
  }
  if(weap->QueryProp(P_WEAPON_TYPE)!=WT_KNIFE) 
    return 0;
  if(weap->QueryProp(P_NEKRO_PESTERED)) {
    pestered=1;
    write(BS("Du spuerst das Verlangen Deiner verpesteten Klinge nach "
        "Blut."));
  }
  pool=call_other(NEKROMASTER, "QueryBloodPool");
  percent=100*pool[0]/pool[1];
  if(percent < 2)
    divisor=1.0;
  else if(percent < 10)
    divisor-=0.5;
  if(percent > 70)
    divisor+=(float)((30+percent)/100.0);
  
  name=corpse->QueryProp(P_SHORT);
  name[0..0]=lower_case(name[0..0]);
  present_nekros=filter_array(all_inventory(ENV(TP)),#'is_nekromant);
  tell_object(TP,BS(
    "Du kniest Dich vor "+name+" und fluesterst heiser die uralte, "
    "verfluchte Formel der Opferung. Eine dunkle Aura scheint sich um "
    "die Leiche zu bilden, Du vermeinst einen leisen, gequaelten Seufzer "
    "von ihr zu hoeren, dann verschwindet die Aura und die Leiche zerfaellt "
    "zu Staub."));
  tell_object(TP,BS("Du spuerst Deine Macht wachsen."));
  level=corpse->QueryProp(P_LEVEL);
  align=corpse->QueryProp(P_ALIGN);
  TP->AddSp((int)(divisor*random(level)/7));
  if ((i=TP->QueryProp(P_ALIGN))>-1500)
    TP->SetProp(P_ALIGN,(i-level/3)-2);
  tell_room(ENV(TP),BS(
    TP->Name()+" kniet sich vor "+name+" und fluestert mit heiserer Stimme "
    "etwas. Eine dunkle Aura scheint sich um die Leiche zu bilden, dann "
    "zerfaellt sie zu Staub. Du erschauderst."),present_nekros);
  present_nekros-=({TP});
  for (i=sizeof(present_nekros);i-->0;)
    tell_object(present_nekros[i],BS(
      TP->Name()+" kniet sich vor "+name+" und fluestert mit heiserer Stimme "
      "die uralte Formel der Opferung. Eine dunkle Aura scheint sich um die "
      "Leiche zu bilden, dann zerfaellt sie zu Staub."));
  // Opfern soll immer was bringen - schliesslich isses egal ob der andere 
  // gut oder boese war
  glvl=TP->QueryProp(P_GUILD_LEVEL);
  grad=TP->QueryProp(P_GUILD_CIRCLE);
  if (glvl > 6 && !random(30) && !deep_present(NEKRO_SOULSTONE, TP)) {
     stone=clone_object(OBJ+"soulstone");
     stone->move(TP, M_NOCHECK);
     tell_object(TP, BS("Ein Teil der Seele manifestiert sich als Seelenstein in "
           "Deinen Habseligkeiten."));
  }
  if(level < (grad+glvl)) {
    write(BS(sprintf("Das Opfern dieser Seele hat Dir nichts gebracht, Du %s! "
          "OPFERE STAERKERE SEELEN!", 
          TP->QueryProp(P_GENDER)==FEMALE?"Naerrin":"Narr")));
    corpse->remove();
    return 1;
  }
  if(!TP->QueryProp(P_TESTPLAYER) && !IS_LEARNING(TP)) {
  
    // Bei einer verfluchten Waffe kommt ein Teil in die Waffe und der
	// Rest wandert in den globalen Pool
	overflow = (int) (corpse->QueryProp(P_LEVEL)/divisor);
	
    if(pestered)
      overflow = weap->AddBloodPool(overflow);
	  
	if(!overflow)
	  overflow = 1; // Es wandert immer ein bisschen in den Pool, damit
	                // die Seelen fuer den Gildenaufstieg zaehlen
    
	call_other(NEKROMASTER, "AddBlood", TP,
               to_int(call_other(NEKROMASTER, "QueryBloodBonus")) +
               overflow, align);
  }
  if(TP->QueryProp(P_ALIGN) > -1000) {
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-level-(2*random(level)));
  }
  corpse->remove();
  if(find_living(lower_case(GUILDNPC_NAME)))
    find_living(lower_case(GUILDNPC_NAME))->soul();
  return 1;
}

void BecomesNetDead(object wer) {
}

void BecomesNetAlive(object wer) 
{
  if(wer==MENV) {
    if(time()-lastlogin > 1000 && !IS_WIZARD(wer)) 
    {
      tell_object(wer,break_string(sprintf(
        "DA BIST DU JA ENDLICH, %s!",wer->Name(WER,2)),78,
        "Xarfai bruellt Dich aus der Ferne an: "));
    }
    lastlogin=time();
    if(aktiv) {
      wer->RemoveHpHook(ME);
      activate(wer);
    }
  }
}

int show_mask(string str) 
{
  mixed *obs;
  string src, dest, src2, desc;
  object what, whom;

  if(!ENV(ME) || !living(ENV(ME))) return 0;
  if (!str||sizeof(obs=explode(str," "))<2) {
    write("Syntax: zeige <wem> <was>\n");
    return 1;
 }
  dest=obs[0];
  src=implode(obs[1..]," ");
  if (!(what=present(src,ENV(ME))))
  {
    notify_fail("Du kannst nur Dinge zeigen, die Du auch dabei hast!\n");
    return 0;
  }
  if(what!=ME) return 0;
  ta("MASKE, LAST: what!=ME \n");
  if (!(whom=present(dest,ENV(ENV(this_object())))) && dest!="allen") {
    write("Wem willst Du "+what->name(WEN,1)+" zeigen?\n");
    return 1;
  }
  if (whom==TP) {
    write("Dazu solltest Du dann besser 'schau' benutzen!\n");
    return 1;
  }
  if(whom->QueryProp(P_GUILD)=="nekromanten") 
     desc=sprintf(long_desc[1], paladin[0]);
  else if(getuid(whom)==paladin[0])
     desc=long_desc[2];
  else desc=sprintf(long_desc[0], paladin[0]);
 
  src=what->name(WEN,0);
  if (what->QueryProp(P_ARTICLE) && member(src,' ')>=0)
  {
    int x;

    while (src[x]!=' ') x++;
    src2=src[x..];
    src=TP->QueryPossPronoun(what,WEN,what->IsPlural())+src2;
    if (what->IsPlural() || what->QueryProp(P_GENDER)>1)
      src2="Deine"+src2;
    else
      if (what->QueryProp(P_GENDER)==MALE)
        src2="Deinen"+src2;
      else
        src2="Dein"+src2;
  } else src2=src;
  str=TP->Name(WER)+" zeigt Dir "+src+".\n";
  if (dest=="allen")
  {
    say(str+desc,({this_object()}));
    write("Du zeigst allen "+what->name(WEN,1)+".\n");
    return 1;
  }
  tell_object(whom,str+desc);
  dest=whom->name(WEM);
  say(TP->Name(WER)+" zeigt "+dest+" "+src+".\n", ({whom,this_player()}));
  write("Du zeigst "+dest+" "+src2+".\n");
  return 1;
}


// LISTENER HANDLING
// Ueberpruefung ob der Spieler am nkreische lauscht
int IsListener(object wer) 
{
  if(!is_clone(wer) && wer->QueryProp(P_TMP_NECROMANCER_LISTENER))
  {
    return 1;
  }
  return 0;
}

// Setzen auf Listener
void SetListener(int flag) {
  if(MENV && interactive(MENV)) {
    if(flag)
      MENV->SetProp(P_TMP_NECROMANCER_LISTENER, 1);
    else 
      MENV->SetProp(P_TMP_NECROMANCER_LISTENER, 0);
  } 
  return ;
}

// Versions Check des Items
mixed QueryVersion() {
  return LAST_GUILDITEM_UPDATE; 
}

// Check des Items
nosave object CheckGuildItem(object wer) {
  int i;
  object *inv;
  inv=all_inventory(wer);
  for(i=sizeof(inv)-1;i>=0;i--) {
    if(inv[i]->id(NEKRO_GUILDITEM_ID))
      return inv[i];
  }
  return 0;
}

// Kleine Sortfunktion
nosave int MySort(object a, object b) {
  if(a->Name(WER) > b->Name(WER)) return 0;
  return 1;
}

//
//  Interner Ruf der Gildenmagier
//

int IsWiz(object pl)
{
  return (-1!=member(MASTER_MAGES,getuid(pl)));
}

nosave int mages_shout(string str) {
  int i, no_msg;
  object *members;
  string *ignores, pre;
  if (-1==member(MASTER_MAGES,getuid(TP)))
    return 0;
  no_msg=0;
  notify_fail("Was moechtest Du den anderen Gildenmagier mitteilen?\n");
  if (!stringp(str)) 
    return 0;
  members=filter_array(users(), "IsListener");
  members=filter_array(members,"IsWiz");
  for(i=sizeof(members)-1;i>=0; i--) {
    if(members[i]==TP) {
      write(break_string(TP->_unparsed_args(), 78,
           "Du teilst den andren mit: "));
    } else {
      ignores=members[i]->QueryProp(P_IGNORE);
      if(sizeof(ignores) && (member(ignores, "mkreische")!=-1 ||
                member(ignores, "mkreisch")!=-1))
        no_msg=1;
      else no_msg=0;
      if(!no_msg) {
        if(TP->QueryProp(P_INVIS))
          pre="("+CAP(getuid(TP))+") teilt Euch mit: ";  
        else     
          pre=TP->Name(WER)+" teilt Euch mit: ";
        tell_object(members[i], BSA(TP->_unparsed_args(),pre));
      }
    }
  }
  call_other(GUILD_MASTER, "AddMagesHistory",CAP(getuid(TP))+": ", TP->_unparsed_args()); // speichern
  return 1;
}

//
// Gildeninterner Ruf und Gildeninternes Emoten
//
nosave int guild_shout(string str) {
  int i, no_msg, invis,lvl, no_colors, emote;
  object *members;
  string *presay, *ignores, pre, msg, newmsg, addon, std_pre;
  no_msg=0;
  
  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  if(query_verb() == "nemote")
    emote=1;
  notify_fail("WAS MOECHTEST DU DEN VERDAMMTEN ZUKREISCHEN!?!\n");
  if (!stringp(str)) 
    return 0;
  lvl=TP->QueryProp(P_GUILD_LEVEL);
  msg=TP->_unparsed_args();
  if(objectp(TP->QueryProp(P_PERM_STRING)))
     msg=call_other(TP->QueryProp(P_PERM_STRING),"permutate_string",msg)||"";
  if(lvl > 7) lvl =7;
  members=filter_array(users(), "IsListener");
  if(member(MASTER_MAGES, getuid(TP))!=-1 || TP->name(WER)==GUILDNPC_NAME)
    presay=({"Todesengel", "Todesengel", "Todesengel"});
  else {
    if(call_other(GUILD_MASTER, "QueryNumberOne") && 
       member(call_other(GUILD_MASTER, "QueryNumberOne"), getuid(TP))!=-1)
      presay=({"Todesbote", "Todesbote", "Todesbotin"});
    else if(!is_clone(TP) && !TP->QueryProp(P_FROG))
      presay=guildlvl_pre[lvl];
    else 
      presay=({"","",""});
  }
  // std_pre wird fuer die History gebraucht
  std_pre="<NK:"+presay[TP->QueryProp(P_GENDER)]+" "+TP->name(WER);
  if(TP->QueryProp(P_INVIS)) {
    invis=1;
    std_pre="<NK:("+CAP(getuid(TP))+")";
  }
  else {
    std_pre="<NK:"+presay[TP->QueryProp(P_GENDER)]+" "+TP->name(WER);
    invis=-1;
  }
  if(emote) addon="";
  else addon=">";
  std_pre+=addon+" ";
  for(i=sizeof(members)-1;i>=0; i--) {
    ignores=members[i]->QueryProp(P_IGNORE);
    if(sizeof(ignores) && (member(ignores, "nkreische")!=-1 ||
          member(ignores, "nkreisch")!=-1))
      no_msg=1;
    else no_msg=0;
    if (sizeof(ignores))
      no_colors = (member(ignores, "nkreische.farben") != -1);
    if (members[i]->QueryProp(P_DEAF) && !IS_WIZARD(members[i])) no_msg=1;
    if(!no_msg) {
      if(TP->QueryProp(P_INVIS) && !IS_WIZARD(members[i]))
        pre="<NK:Ein Schatten"+addon+" ";
      else if(TP->QueryProp(P_INVIS) && IS_WIZARD(members[i]))
        pre="<NK:("+CAP(getuid(TP))+")"+addon+" ";  
      else     
        pre="<NK:"+presay[TP->QueryProp(P_GENDER)]+" "+TP->Name(WER)+
          addon+" ";
      if(emote) {
        newmsg=pre+msg+">";
        pre="";
        no_colors=1;
      }
      else
        newmsg=msg;
      if(interactive(TP)) {
        tell_object(members[i],
            color_tell(newmsg, pre, members[i], no_colors));
      } 
      else {
        tell_object(members[i], color_tell(str,pre,members[i]));
      }
    }
  }
  if(emote) {
    newmsg=std_pre+"%s"+">";
    std_pre=" ";
  }
  if(interactive(TP)) {
    call_other(GUILD_MASTER, "AddHistory",std_pre,
        expand_color_strings(msg,"",""),invis, emote, newmsg);
  } 
  else {
    call_other(GUILD_MASTER, "AddHistory",std_pre, 
        expand_color_strings(str, "",""), invis, emote, newmsg);
  }
  return 1;
}



nosave varargs int ShowHistory(mixed number) 
{
  int i;
  string *msgs;
  mixed *history;
  mixed *hist_time;
  
  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  if(!number) number=10;
  number=to_int(number);
  history=call_other(GUILD_MASTER, "QueryHistory", number);
  hist_time=history[0];
  history=history[1];
  if (sizeof(history)==0)
  {
    write("Die Verdammten haben bisher eine unheilige Ruhe bewahrt.\n");
    return 1;
  }
  write("DAS HABEN DIR DIE VERDAMMTEN ZUGEKREISCHT:\n");
  write(BS("-----------------------------------------------"
       +"-------------------------------\n"));
  for(i=0;i<=sizeof(history)-1;i++) {
    msgs=explode(history[i],"&&*%%");
    if( msgs[0][0..0] == " ")
      msgs[0]=msgs[0][1..];
    if (((time()+7200)/86400)>((hist_time[i]+7200)/86400)) {
      write(BS(dtime(hist_time[i])));
    }
    else {
      write(BS(dtime(hist_time[i])[19..26]));
    }
    // Wenn ein Spieler nhist macht bei jemand der invis nkreischt ...
    if(msgs[2]=="1" && !IS_WIZARD(TP)) {
      if(msgs[3] == "1") { // == emote 
        write(BS(sprintf("<NK:Ein Schatten %s>",msgs[1])));
      }
      else {
        write(BSA(msgs[1], "<NK:Ein Schatten> "));
      }
    }
    else { // ... und hier der Magier 
      if(msgs[3] == "1") { //emote
        write(BS(sprintf(msgs[4],msgs[1])));
      }
      else {
        write(BSA(msgs[1], msgs[0]));
      }
    }
  }
  write("-----------------------------------------------"
       +"-------------------------------\n");
  return 1;  
}

//
// history des mkreische anzeigen
//

nosave int ShowMagesHistory() {
  int i;
  string *msgs;
  mixed *history;
  mixed *hist_time;
  
  if (-1==member(MASTER_MAGES,getuid(TP)))
    return 0;
  history=call_other(GUILD_MASTER, "QueryMagesHistory");
  hist_time=history[0];
  history=history[1];
  if (sizeof(history)==0)
  {
    write("Die Gildenmagier haben Dir noch nichts mittgeteilt.\n");
    return 1;
  }
  write("Das haben Dir die anderen Gildenmagier mitgeteilt:\n");
  write(BS("-----------------------------------------------"
       +"-------------------------------\n"));
  for(i=0;i<=sizeof(history)-1;i++) {
    msgs=explode(history[i],"&&*%%");
    if ((time()/86400)>(hist_time[i]/86400))
      write(BS(dtime(hist_time[i])));
    else
      write(BS(dtime(hist_time[i])[19..26]));
    write(BSA(msgs[1], msgs[0]));
  }
  write("-----------------------------------------------"
       +"-------------------------------\n");
  return 1;  
}

nosave int ntreten(string str) 
{
  int i;
  object *spieler;
  string *ignores;

  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  spieler=users();
  for(i=sizeof(spieler)-1;i>=0; i--) {  
    if(IsListener(spieler[i])) {
      if(spieler[i]==TP) {
        write(BS("Du trittst alle Verdammten aus der Ferne! MUAHAHAHA!"));
      } else {
        ignores=spieler[i]->QueryProp(P_IGNORE);
        if( sizeof(ignores) && member(ignores, "ntrete") != -1 ) ;
        else
        {
          if(TP->QueryProp(P_GENDER)==FEMALE)
            tell_object(spieler[i], sprintf("%s, eine Dienerin der Verdammnis, "
                  +"tritt Dich aus der Ferne.\nAHHH, DAS TUT GUT!\n",
                  TP->name()));
          else 
            tell_object(spieler[i], sprintf("%s, einer der Verdammten, "
                  +"tritt Dich aus der Ferne.\nAHHHH, DAS TUT GUT!\n", 
                  TP->name()));
        }
      }
    }
  }
  return 1;
}


nosave int SoulHit(string str) 
{
  string pala;
  object pl, wappenrock;
  mixed h;
  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  if(catch(pala=call_other(NEKROMASTER, "QuerySacrifiedPaladin", TP)[0])) {
    UpdatePaladin();
    if(catch(pala=call_other(NEKROMASTER, "QuerySacrifiedPaladin", TP)[0])) {
      raise_error(sprintf(" Nekromant ohne korrekt geopferten Paladin: %O ",
            ENV(ME)));
      write(BS("BEI ALLEN NIEDERHOELLEN! DA GING ETWAS SCHIEF! VERSTAENDIGE "
          "EINEN MAGIER! LOS! SCHNELLER!"));
      return 1;
    }
  }
  pala=lower_case(pala);
  if(!pala) {
    write("HARHAR! Du NARR! Verstaendige einen Gildenmagier!\n");
    return 1;
  }
  if(soulhits < 1) {
    write(BS(sprintf("DU %s! Du kannst nicht %s andauernd einen Seelen"
            "schlag versetzen! WARTE ERSTMAL!",
            TP->QueryProp(P_GENDER)==FEMALE?"NAERRIN":"NARR",
            CAP(pala))));
    return 1;
  }
  if(!pl=find_player(pala)) {
    write(BS(sprintf("Du %s! %s ist ueberhaupt nicht anwesend!",
            TP->QueryProp(P_GENDER)==FEMALE?"NAERRIN":"NARR",
            CAP(pala))));
    return 1;
  }
  if(file_name(ENV(pl))[0..15] == "/gilden/paladine") {
    write(BS(sprintf("VERDAMMT NOCHMAL! %s wird von Dusty geschuetzt! Offenbar "
          "hat %s sich in %ser Burg verkrochen!", 
          pl->Name(WER), pl->QueryPronoun(WER), pl->QueryPossPronoun(WESSEN))));
    return 1;
  }

  soulhits--;
  if(present("\nspiegelschild", pl)) {
    if(random(pl->QueryProp(P_LEVEL)) < random(2*TP->QueryProp(P_LEVEL)/3)) {
      tell_object(pl, BS(sprintf("Dein Spiegelschild wirft einen "
              "hinterhaeltigen Anschlag von %s zurueck! Lob sei Dusty!", 
              TP->name(WER))));
      call_other("/spellbooks/pal_spells", "ShoutPrayer", pl);
      TP->AddSp(-20-random(10));
      TP->AddHp(-20-random(10));
      write(BS(sprintf("BEI ALLEN NIEDERHOELLEN! Was war das! Dein "
              "Seelenschlag ist zurueckgeworfen worden! NEEEEEIN !!! RACHE ! "
              "Dafuer muss %s BUESSEN!", pl->name(WER))));
      return 1;
    }
  }

  if(h=pl->QueryProp(P_TMP_DEFEND_HOOK)) {
    if(h[1] && getuid(h[1])=="GUILD.pal_spells" && h[2]=="schutz2") {
     if(h[0]>=time()) {
        write(BS("BEI ALLEN NIEDERHOELLEN! VERDAMMT! ES HAT NICHT GEKLAPPT!"));
        tell_object(pl, BS("Bei Dusty! Dein Goetterschutz wehrt eine "
              "unheilige Attacke der Nekromanten ab!"));
        return 1;
      }
    }
  }
  wappenrock=present("\npaladinwappenrock", pl);
  if(!wappenrock || !wappenrock->DoNecromancerHpLoss(ENV(ME))) 
  {
    write(BS("BEI ALLEN NIEDERHOELLEN! VERDAMMT! ES HAT NICHT GEKLAPPT!"));
    return 1;
  }
  write(BS(sprintf("HARHAR! Du spuerst den Schmerz von %s und weidest Dich "
          "daran! Daran wird %s noch lange denken!!", CAP(pala), 
          pl->QueryPronoun(WER))));
  if(ENV(TP))
    tell_room(ENV(TP),BS(sprintf("%s streicht ueber %s Maske und scheint "
            "auf einmal maechtiger zu sein.", TP->Name(WER), 
            TP->QueryPossPronoun(FEMALE,WESSEN))), ({TP}));
  ENV(ME)->AddHp(10);
  ENV(ME)->AddSp(10);
  return 1;
}


/*  ninfo, Nekromantenersatz fuer das normale info
**
**
**
*/

nosave string show_nekroinfo() 
{
  int i, xp, level, n;
  mixed sp;
  string ret,name;
  string *skull, pl_name, killed_p;
  mapping skulls; 
  skulls=([
      0:({" .-\"\"-. ", 
          "/ _  _ \\", 
          "|(_)(_)|", 
          "(_ /\\ _)",
          " L====J ",
          " '-..-' "}),
      1:({" .-\"\"-. ", 
          "/ _  _ \\", 
          "|(_\\/_)|", 
          "(_ /\\ _)",
          " |v==v| ",
          " '-..-' "}),
      ]); 
  skull=skulls[random(2)]; 
  
  pl_name=getuid(TP);
  sp=call_other(NEKROMASTER, "QuerySkillPoints",TP);
  if (!mappingp(sp)) 
    sp=0;
  else
    sp=sp["freiepunkte"];
  if(pointerp(call_other(NEKROMASTER, "QueryKilledPaladin", TP)))
    killed_p=call_other(NEKROMASTER, "QueryKilledPaladin", TP)[0];
  else killed_p="ein Paladin";
  ret="";
  if (TP->QueryProp(P_INVIS))
    name="("+CAP(getuid(TP))+")";
  else
    name=TP->short();
  if (name[<1]=='\n') name=name[0..<2];
  name=name[0..51];
  ret+=sprintf("%s  %*' 's  %s\n", skull[0],52,"",skull[0]);   
  ret+=sprintf("%s  %*' 's  %s\n", skull[1],52,"",skull[1]);   
  ret+=sprintf("%s%*'='s%s\n", skull[2],56,"",skull[2]);   
  if(member(name, '\b') != -1)
    ret+=sprintf("%s  %|54s  %s\n", skull[3],name,skull[3]);   
  else
    ret+=sprintf("%s  %|52s  %s\n", skull[3],name,skull[3]);   
  ret+=sprintf("%s%*'='s%s\n", skull[4],56,"",skull[4]);
  ret+=sprintf("%s  %|52s  %s\n", skull[5],"Nekromantengilde",skull[5]);
  if (!TP->QueryProp(P_GHOST))
  {
    if ((TP->LpLevel() == (QueryProp(P_LEVEL) + 1)) && 
        (TP->LevelPerc(TP->LpLevel() + 1) < 20))
      level = TP->QueryProp(P_LEVEL);
    else
      level = TP->LpLevel();
    ret+=sprintf(
    "   \\  Kreis der Verdammnis:     %2d | Innerer Grad:             %2d "
    " /\n"
    "    | Geopferte Seelen:      %5d | Geopf. Paladin:  %11s |\n"
    "    +==============================+==============================+\n"
    "    | Lebenspunkte:      %3d (%3d) | Erfahrungspunkte: %10d |\n"
    "    | Magiepunkte:       %3d (%3d) | Abenteuerpunkte: %4d (%4d) |\n"
    "    | Attributpunkte:           %2d | Stufe %d [%-'.'*s] %d |\n"
    "    | Skillpunkte:              %2d | Rasse:  %20s |\n"
    "    +------------------------------+------------------------------+\n"
    "    | Ausdauer:           %8s | Kraft:              %8s |\n"
    "    | Intelligenz:        %8s | Geschicklichkeit:   %8s |\n"+
    "    +------------------------------+------------------------------+\n",
      TP->QueryProp(P_GUILD_LEVEL), TP->QueryProp(P_GUILD_CIRCLE),
      call_other(NEKROMASTER, "QuerySacrified", TP),
      CAP(killed_p),
      TP->QueryProp(P_HP), TP->QueryProp(P_MAX_HP),
      TP->QueryProp(P_XP),
      TP->QueryProp(P_SP), TP->QueryProp(P_MAX_SP),
      TP->QueryProp(P_QP), QM->QueryAllQP(),
      TP->QueryProp(P_AP),
      level,
      (n = 18 - strlen(to_string(level)) - strlen(to_string(level + 1))),
      sprintf("%'#'*s", TP->LevelPerc( level + 1 ) * n / 100, ""),
      level + 1,
      sp,
      TP->QueryProp(P_RACE)[0..19],
      sprintf("%d (%+d)", TP->QueryProp(P_ATTRIBUTES)[A_CON], 
        TP->QueryAttributeOffset(A_CON)),
      sprintf("%d (%+d)", TP->QueryProp(P_ATTRIBUTES)[A_STR], 
        TP->QueryAttributeOffset(A_STR)),
      sprintf("%d (%+d)", TP->QueryProp(P_ATTRIBUTES)[A_INT], 
        TP->QueryAttributeOffset(A_INT)),
      sprintf("%d (%+d)", TP->QueryProp(P_ATTRIBUTES)[A_DEX], 
        TP->QueryAttributeOffset(A_DEX))
    );
  }
  else
  {
    xp=TP->QueryProp(P_TOTAL_LOST_XP);
    ret+=sprintf(
      "   \\                                                                /\n"
      "    | %60-s |\n" 
      "    +--------------------------------------------------------------+\n"
      ,sprintf("Du hast %s Todeserfahrungen gesammelt."
      ,xp <        1?"noch gar keine":
       xp <    10000?"noch so gut wie gar keine":
       xp <    50000?"noch fast gar keine":
       xp <   150000?"erst unheimlich wenige":
       xp <   300000?"erst sehr wenige":
       xp <   600000?"erst wenige":
       xp <  1000000?"wenige":
       xp < 20000000?"schon einige":
       xp < 30000000?"schon recht viele":
       xp < 40000000?"schon ziemlich viele":
       xp < 50000000?"schon sehr viele":
       xp < 60000000?"schon extrem viele":
       xp < 80000000?"schon unheimlich viele":
       xp <100000000?"schon wahnsinnig viele":
       xp <150000000?"schon unglaublich viele":"unschaetzbar viele"
       ));
  
  }
  return ret;
}

//aus base.c
nosave string exhausted_text()
{
  int p;
  p = 100 * TP->QueryProp(P_MV) / TP->QueryProp(P_MAX_MV);
  switch (p)
  {
    case 0..5:   return "Du bist im Moment schwer erschoepft.";
    case 6..15:  return "Du bist ziemlich ausser Atem.";
    case 16..30: return "Du bist etwas erschoepft.";
    default:     return "";
  }
}

//aus base.c
nosave string weight_text()
{
  int p;
  p = 100 * (TP->QueryProp(P_TOTAL_WEIGHT) - TP->QueryProp(P_WEIGHT) )
          / TP->QueryProp(P_MAX_WEIGHT);
  switch (p)
  {
    case  0..50:  return "";
    case 51..60: return "Du traegst einiges Gewicht mit Dir herum.";
    case 61..70: return "Du bist ziemlich beladen.";
    case 71..80: return "Du bist schwer beladen.";
    case 81..90: return "Du bist sehr schwer beladen.";
    case 91..95: return "Du bist extrem schwer beladen.";
    case 96..100: return "Das schwere Gewicht zwingt Dich fast zu Boden.";
    default:     return "Du schleppst mehr als Du eigentlich tragen kannst.";
  }
}

nosave int ShowInfo() 
{
  string ret,*strings,gift,tmp;
  int i,val,sz;
  mixed ind;
  object *enem1, *enem2, *inv;

  if( TP->QueryProp(P_GUILD) != "nekromanten" && query_verb() == "info" ) 
    return 0;
  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;

  ret=show_nekroinfo();
  if (TP->QueryProp(P_GHOST)) return write(ret),1;
//aus base.c
  strings=({"","","",""});
  i=0;
  if (val=TP->QueryProp(P_POISON) ) {
    strings[i]=(val<4 ? "leicht vergiftet" : "vergiftet");
    i++;
  }
  if( TP->QueryProp(P_BLIND) ) {
    strings[i]="blind";
    i++;
  }
  if( TP->QueryProp(P_DEAF) ) {
    strings[i]="taub";
    i++;
  }
  if( TP->QueryProp(P_FROG) ) {
    strings[i]="ein Frosch";
    i++;
  }
  tmp=gift="";
  if( i )
  {
    for( sz=0;sz<i;sz++)
      tmp+=strings[sz]+ (sz==i-1?".":(sz==i-2?" und ":", "));
    gift=sprintf("    | %-59s |\n", "Du bist "+tmp);
  }
  if ((tmp=exhausted_text()) != "")
    gift+=sprintf("    | %-59s |\n", tmp);
  if ((tmp=weight_text()) != "")
    gift+=sprintf("    | %-59s |\n", tmp);

  ret += sprintf(
    gift+
    "    | Vorsicht-Modus: %3d%:-40s |\n"
    "    | Dein Charakter ist %-40s |\n"
    "    | Alter: %-52s |\n%s"
    "    +-------------------------------------------------------------+\n"
    ,
    TP->QueryProp(P_WIMPY),
    (TP->QueryProp(P_WIMPY_DIRECTION) ?
      ", Fluchtrichtung: "+to_string(TP->QueryProp(P_WIMPY_DIRECTION)) :
      ""),
    GetAlign(TP->QueryProp(P_ALIGN))+".",
    TP->get_age(),
    (TP->QueryProp(P_AWAY) ?
      sprintf("    | Du bist nicht ansprechbar: %:-32s |\n",
              TP->QueryProp(P_AWAY)) : "")
    );

  ind = explode(break_string(TP->Forschung(), 59), "\n");
  for (i=0;i<sizeof(ind);i++)
    ret += sprintf("    | %-59s |\n", to_string(ind[i]));
  ret += "    +-------------------------------------------------------------+\n";

  // Feinde aufzaehlen
  enem1 = ((mixed) TP->QueryEnemies())[0];
  if (sizeof(enem1))
  {
    enem2 = ({});
    inv = all_inventory(environment(TP));

    for (i=0; i < sizeof(enem1); i++)
      if (member_array(enem1[i], inv) == -1) // Ist unser Feind, aber nicht da.
        enem2 += ({enem1[i]});

    if (sizeof(enem2))
    {
      ind = explode( break_string(
        "Du verfolgst "+TP->CountUp( map_objects( enem2, "name", WEN ) )
        +".", 59), "\n");

      for (i=0; i < sizeof(ind); i++)
        ret += sprintf("    | %-59s |\n", to_string(ind[i]));

      ret+="    +-------------------------------------------------------------+\n";
    }
  }
//ende aus base.c
  TP->More(ret);
  return 1;
}

//
// Guild WHO
//

string idle_to_title(object pl)
{
  int i;

  if (pl->InFight()) return "seelenbeschaffend";
  i = query_idle(pl);
  if (i < 30) return "aktiv";
  else if (i < 3 * 60) return "gelangweilt";
  else if (i < 7 * 60) return "untaetig";
  else if (i < 23 * 60) return "faul";
  else if (i < 45 * 60) return "verfaulend";
  else if (i < 90 * 60) return "verwesend";
  else if (i < 230 * 60) return "zerfallend";
  else return "scheintot";
}

int guild_who(string str) {
  int i;
  object *nekros, *listener, *listener_only, npc, master;
  string level;
  string members, align, sh;
  string *mastermages;

  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  members="";
  mastermages=MASTER_MAGES;
  write("DA SIND DIE VERDAMMTEN:\n");
  listener=call_other(NEKROMASTER, "OnlineMembers"); 
  for(i=sizeof(mastermages)-1;i>=0;i--) 
    if(objectp(master=find_player(mastermages[i])) && member(listener,master)==-1)
      listener+=({master});
  nekros=sort_array(listener,"MySort",ME);
  listener=sort_array(call_other(NEKROMASTER, "Listeners"),"MySort",ME);
  listener_only=listener-nekros;
  for(i=sizeof(nekros)-1;i>=0; i--) {    
    if(!nekros[i]->QueryProp(P_INVIS) || IS_LEARNER(TP)) 
    {
      level=sprintf("%d/%d", nekros[i]->QueryProp(P_GUILD_LEVEL), 
          nekros[i]->QueryProp(P_GUILD_CIRCLE));
      if( IS_LEARNER(nekros[i]) ) 
        if( str == "ort") level = "Mag"; else level = "M";
      align=GetAlign(nekros[i]->QueryProp(P_ALIGN));
      if(member(mastermages, getuid(nekros[i]))!=-1)
        align="satanisch";
      else if (IS_GOD(nekros[i]))
        align="abgrundtief boese";
      if (str == "idle")
        align = idle_to_title(nekros[i]);
      if (str == "ort") {
        members+=sprintf("%13s(%s) - ",CAP(getuid(nekros[i])),level);
        if (ENV(nekros[i]) && (sh=ENV(nekros[i])->QueryProp(P_INT_SHORT)) 
            && (!IS_LEARNER(nekros[i]) || IS_LEARNER(TP)) )
        {
          members+=sh+".\n";
        } else {
          members+="In den Schatten.\n";
        }
      } else {
        if (nekros[i]->QueryProp(P_INVIS))
          members+="("+CAP(getuid(nekros[i]))+")("+align+")";
        else
        members+=CAP(getuid(nekros[i]))+"("+level+"/"+align+")";
        if(i>0) members+=", ";
      }
    }
  }
  if (members[<2..] == ", ") 
    members = members[0..<3];
  if (str == "ort") {
    if(npc=find_living(lower_case(GUILDNPC_NAME))) 
      members="       "+GUILDNPC_NAME+"(7/7) - "+
              ENV(npc)->QueryProp(P_INT_SHORT)+".\n"+members;
    write(members);
  } else {
    if(find_living(lower_case(GUILDNPC_NAME))) 
      members=GUILDNPC_NAME+"(7/7/satanisch), "+members;
    write(BS(members));
  }
  write("\nDIE LUESTERNEN LAUSCHER:\n");
  members="";
  for(i=sizeof(listener_only)-1;i>=0; i--) {    
    if(!listener_only[i]->QueryProp(P_INVIS) || IS_LEARNER(TP))
    {
      if (str == "idle")
        align = idle_to_title(listener_only[i]);
      else
        align=listener_only[i]->al_to_title(listener_only[i]->QueryProp(P_ALIGN));
      if (str == "ort") {
        members+=sprintf("%16s - ",CAP(getuid(listener_only[i])));
        if (ENV(listener_only[i]) && (sh=ENV(listener_only[i])->QueryProp(P_INT_SHORT)) 
            && (!IS_LEARNER(listener_only[i]) || IS_LEARNER(TP)) )
          members+=sh+".\n";
        else
          members+="In den Schatten.\n";
      } else {
        if (listener_only[i]->QueryProp(P_INVIS))
          members+="("+CAP(getuid(listener_only[i]))+")("+align+")";
        else
          members+=CAP(getuid(listener_only[i]))+"("+align+")";
        if(i>0) members+=", ";
      }
    }
  }
  if (members[<2..] == ", ") 
    members = members[0..<3];
  if (str == "ort") {
    write(members);
  } else {
    write(BS(members));
  }
  return 1;
}


//
// REPORT !!!
//
nosave int Status(string str) {
  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  notify_fail("VERDAMMTER NARR! Du musst zuerst den nreport einschalten!\n");
  if(!aktiv) return 0;
  NotifyHpChange(1);
  return 1;
}

// Benachrichtigungsfunktion
varargs void NotifyHpChange(int force) {
  int hp, mhp, sp, msp, HPdif, length, stat, changedHP, changedSP;
  string color, msg, flags, help;

  color="";
  flags="";
  stat=0;
  // Sicherheits-Check
  if (!previous_object()) return;
  if (owner != previous_object()) {
    if (TO != previous_object()) return;
    stat=1;
  }
  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv && !stat) {
    if (owner!=find_netdead(getuid(owner)))
      owner->RemoveHpHook(ME);   // geht nur bei nicht-netztoten Spielern
    return;
  }
  if(!query_once_interactive(owner)) {
    activate(0);
    return;
  }
  // aktuelle Werte ermitteln
  hp = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);
  if (noscroll &&
      hp - scrollHP >= 0 && hp - scrollHP < 5 &&
      sp - scrollSP >= 0 && sp - scrollSP < 5)
  {
    scroll += hp - scrollHP + sp - scrollSP;
    scrollHP = hp;
    scrollSP = sp;
    if (!force && scroll < noscroll && 
        !(hp == mhp && hp != lastHP) &&
        !(sp == msp && sp != lastSP))
      return;
  }
  scroll = 0;
  scrollHP = hp;
  scrollSP = sp;
  if(test_bit(akt_lvl, 1)) {
    switch(hp*100/mhp) {
      case 0..20: color=report_colors[4];
                  break;
      case 21..40: color=report_colors[3];
                  break;
      case 41..60: color=report_colors[2];
                  break;
      case 61..80: color=report_colors[1];
                  break;
      case 81..100: color=report_colors[0];
                  break;
      default: color=ANSI_NORMAL;
    }
  }
  flags="-------------"+EnhancedReport(owner);
  if(cnt>5) { 
      align=GetAlign(owner->QueryProp(P_ALIGN));
    cnt=0;
  }
  cnt++;
  length=18-strlen(align)-2;
  // Vergleich und Ausgabe
  changedHP=hp-lasthp;
  changedSP=sp-lastsp;
  if ((((hp < lastHP) || (hp > lastHP && (sp == msp || callout)) || 
       (sp != lastSP) || (stat)) && (changedHP || changedSP)) || force ) 
  {
    if(test_bit(akt_lvl, 2))
    {
      help = sprintf("(%s)%*'-'s", align,length,"");
      msg=sprintf("%s%s%s LPs: %d/%3d(%s), MPs: %d/%d(%s)%s",
        color, flags[4..], help[0..<5], hp, mhp, (changedHP>0?"+":"")+
        changedHP, sp, msp, (changedSP>0?"+":"")+changedSP, ANSI_NORMAL);
    }
    else
    msg=sprintf("%s%s(%s)%*'-'s LPs: %d(%s), MPs: %d(%s)%s",
        color, flags, align,length, "", hp, (changedHP>0?"+":"")+
        changedHP, sp, (changedSP>0?"+":"")+changedSP, ANSI_NORMAL);
    tell_object(owner, msg+"\n"); 
    lastsp = sp;
    lasthp = hp;
    callout = 0;
    lastHP = hp; 
  }
  else if( !callout && (hp > lastHP+1) )
  {
    callout = 1;
    call_out("NotifyHpChange",0);
  }
  else 
  {
    callout = 0;
    lastHP = hp; 
  }
  // neue Werte merken
  lastSP = sp;
}

// Report aktivieren
nosave void activate(object ob) 
{
  if (objectp(ob)) 
  {
    aktiv = 1;
    owner = ob;
    owner_name = getuid(owner);
    ob->AddHpHook(ME);
    scrollHP = lastHP = ob->QueryProp(P_HP);
    scrollSP = lastSP = ob->QueryProp(P_SP);
    NotifyHpChange(1);
  } 
  else 
  {
    if (ob=(owner||TP)) ob->RemoveHpHook(ME);
    owner = owner_name = aktiv = 0;
  }
}

// Report cmd interface
nosave int Report(string str) 
{
  string *msg;
  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  notify_fail("Syntax: nreport ein|aus|max <0|1>|farben <0|1>|scroll x.\n");
  if(!sizeof(msg=explode(str, " "))) return 0;
  switch (msg[0]) {
    case "ein":
      if (aktiv && objectp(owner))
        write("Der Report-Modus ist schon eingeschaltet!\n");
      else {
        write("Report-Modus ist jetzt eingeschaltet.\n");
        activate(TP);
      }
      break;
    case "aus":
      if (!aktiv)
        write("Der Report-Modus ist doch schon ausgeschaltet!\n");
      else { 
        write("Report-Modus ist nun ausgeschaltet.\n");
        activate(0);
      }
      break;
    case "level":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 0);
      else 
        write("Syntax: nreport level <0|1>\n"); 
      break;
    case "farben":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 1);
      else 
        write("Syntax: nreport farben <0|1>\n"); 
      break;
    case "max":
      if(sizeof(msg)>1)
        ConfigureReport(msg[1], 2);
      else 
        write("Syntax: nreport max <0|1>\n"); 
      break;
    case "scroll":  
      if(sizeof(msg)>1)
      {
        noscroll = to_int(msg[1]);
        if (noscroll > 1 && noscroll < 100)
        {
          write("Nreport erst, wenn " + noscroll + " Punkte hochgeidelt.\n");
        }
        else
          write("NReport mit normalem Scroll.\n");
      }
      else 
      {
        write("NReport mit normalem Scroll.\n"); 
        noscroll = 0;
      }
      break;
    case "hilfe":
      ShowReportHelp();
      break;
    default:
      return 0;
  }
  return 1;
}

// Report konfigurieren
nosave int ConfigureReport(string str, int what) 
{
 int flag;
 string txt;
 flag=to_int(str);
 if(flag<0 || flag>2) {
   write("Falsche Eingabe!\n");
   return 1;
 }
 if(what==1) txt="Farben";
 else if(what==2) txt="Max";
 else txt="Level";
 if(flag==0) 
   akt_lvl=clear_bit(akt_lvl, what);
 else if(flag==1) {
   if(what==0) enh=1;
   akt_lvl=set_bit(akt_lvl, what);
 }
 else if(flag==2 && what==0) {
   enh=0;
   akt_lvl=set_bit(akt_lvl, what);
 }
 write("Ok, "+txt+" auf "+flag+" gesetzt!\n");
 return 1;
}

// Ausgabe des Erweiterten Reports
nosave string EnhancedReport(object owner) 
{
  mixed h;
  string flags, v, n, no;
  object ob;

  if( !enh) return "---------------";
  flags="";

  flags+="[";
  if(registered_spell_effects[0]) CheckSpellEffect(0);
  if(registered_spell_effects[0]) 
    flags+="B";
  else 
    flags+="-";
  if(registered_spell_effects[1]) CheckSpellEffect(1);
  if(registered_spell_effects[1]) 
    flags+="S";
  else 
    flags+="-";
  flags+="]";
  flags+="[";
  if(owner->QueryProp(P_MV)*100/owner->QueryProp(P_MAX_MV)<10)
    flags+="E";
  else flags+="-";
  if(owner->QueryProp(P_DEAF))
    flags+="T";
  else flags+="-";
  if(owner->QueryProp(P_BLIND))
    flags+="B";
  else flags+="-";
  if(h=owner->QueryProp(P_POISON))
  {
    if(h<=3) flags+="v"; else flags+="V";
  }
  else flags+="-";
  if(owner->QueryProp(P_FROG))
    flags+="F";
  else flags+="-";
  if(owner->QueryProp(P_GHOST))
    flags+="G";
  else flags+="-";
  if(owner->QueryProp(P_PARALYZED))
    flags+="P";
  else flags+="-";
  if(time()<owner->QueryProp(P_NEXT_SPELL_TIME))
    flags+="N";
  else flags+="-";
  flags+="]--";
  return flags;
}


//
// Farben setzen
//
nosave int SetColors(string cols) 
{
  string *colors, *set_cols;
  mapping valid_colors;
  int i;
  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  set_cols=({});
  valid_colors=(["schwarz":ANSI_BLACK,
                 "rot":ANSI_RED,
                 "gruen":ANSI_GREEN,
                 "gelb":ANSI_YELLOW,
                 "blau":ANSI_BLUE,
                 "lila":ANSI_PURPLE,
                 "cyan":ANSI_CYAN,
                 "zyan":ANSI_CYAN,
                 "weiss":ANSI_WHITE,
                 "normal":ANSI_NORMAL]);
  if(!cols) cols="standard";
  cols=lower_case(cols);
  if(cols=="standard") {
    report_colors=std_colors;
    write(BS("Ok, Standard Farben (Gruen, Gelb, Cyan, Blau, Rot) "
          "gesetzt!\n"));
    call_other(GUILD_MASTER, "SetColors", TP, std_colors);
    return 1; 
  }
  if(cols=="hilfe") {
    return ShowColorHelp(); 
  }
  colors=explode(cols, " ");
  if(sizeof(colors)!=5) {
    write("Es muessen fuenf Farben angegeben werden!\n");
    return 0;
  }
  for(i=0;i<=sizeof(colors)-1;i++) {
    if(!member(valid_colors, colors[i])) {
      write(sprintf("Falsche Farbe: %s!\n", colors[i]));
      return 0;
    }
    set_cols+=({valid_colors[colors[i]]});
  }
  report_colors=set_cols;
  call_other(GUILD_MASTER, "SetColors", TP, set_cols);
  return 1;
}  

