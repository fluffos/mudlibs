nosave int SetNekroTitle(string str) {
  mapping presays;
  string presay;
  string titel;
  int lvl;
  if(!call_other(NEKROMASTER, "AllowGuildItemFunction", query_verb()))
    return 0;
  presays=GUILDLVLPRESAYS;
  if(TP->QueryProp(P_GUILD)!="nekromanten") {
    write("Das geht nur als Nekromant!\n");
    return 1;
  }
  lvl=TP->QueryProp(P_GUILD_LEVEL);
  if(lvl > 7) {
    write("Hier stimmt etwas nicht.\n");
    return 1;
  }
  if(TP->QueryProp(P_GENDER)==FEMALE) {
    titel=find_object("/gilden/nekromanten")->QueryProp(P_GUILD_FEMALE_TITLES)[lvl];
    presay=presays[lvl][FEMALE];
  }
  else {
    titel=find_object("/gilden/nekromanten")->QueryProp(P_GUILD_MALE_TITLES)[lvl];
    presay=presays[lvl][MALE];
  }
  TP->SetProp(P_TITLE, titel);
  TP->SetProp(P_PRESAY, presay);
  write(BS(sprintf("Verdammte%s! Dein Titel und Dein Presay wurden "
        "wieder zurueckgesetzt!", TP->QueryProp(P_GENDER)==FEMALE?"":"r")));
  return 1;
}

//
// Register Spell Effects
// 0 ... Beruehurng von Zuum Uul
// 1 ,,, Schleier von xy
//
void RegisterSpellEffect(int spell) {
  registered_spell_effects[spell]=1;
  return;
}

void DeRegisterSpellEffect(int spell) {
  registered_spell_effects[spell]=0;
  return;
}

void CheckSpellEffect(int spell) {
  mixed h;
  switch(spell) {
    case 0: 
      if(!present(ZUM_UUL_OBJ, ENV(ME)))
        registered_spell_effects[0]=0;
      break;
    case 1:
      h=ENV(ME)->QueryProp(P_TMP_DEFEND_HOOK);
      if(!h || sizeof(h)<2 ||  h[2]!="nekro_schutz") {
        registered_spell_effects[1]=0;
      }
  }
  return;
}

int CastMysterium() {
  return number_of_mysterium_casts--;
}

nosave void new_level7_title()
{
  if (owner->QueryProp(P_GENDER) == FEMALE)
    owner->SetProp(P_GUILD_TITLE, ({
        "die Vernichterin der Paladine", "die Skelettfreundin", 
        "die Meisterbeschwoererin", "die Inkarnation des Boesen selbst",
        "die Beherrscherin der Untoten", "die Zombiemeisterin",
        "die Wurzel allen Uebels", "die Herrin ueber Nicht-Leben und Un-Tot",
        "die Verfluchte der Goetter", "die Blutsaeuferin",
        "die Mumienmeisterin", "die Vampirfuerstin",
        "die Seelenpeinigerin", "die Hoellenverpesterin",
        })[random(14)] );
  else if (owner->QueryProp(P_GENDER) == MALE)
    owner->SetProp(P_GUILD_TITLE, ({
        "der Vernichter der Paladine", "der Skelettfreund", 
        "der Meisterbeschwoerer", "die Inkarnation des Boesen selbst",
        "der Beherrscher der Untoten", "der Zombiemeister",
        "die Wurzel allen Uebels", "der Herr ueber Nicht-Leben und Un-Tot",
        "der Verfluchte der Goetter", "der Blutsaeufer",
        "der Mumienmeister", "der Vampirfuerst",
        "der Seelenpeiniger", "der Hoellenverpester",
    })[random(14)] );
}

void AddMax(string prop, int value)
{
  mapping mod;
  if (!objectp(owner))
    return;
  if (file_name(PO) != GUILD_SPELLBOOK)
    return;
  if (!mappingp(mod = QueryProp(P_X_HEALTH_MOD)))
    mod = ([P_HP: 0, P_SP: 0]);
  mod += ([prop: mod[prop] + value]);
  SetProp(P_X_HEALTH_MOD, mod);
  SetProp(P_X_MAX_HEALTH_MOD, mod);
  owner->UpdateAttributes();
}

string short()
{
  if (QueryProp(P_WORN) && TP && TP != QueryProp(P_WORN) &&
      QueryProp(P_WORN)->QueryProp(P_GUILD) != GUILDNAME)
    return 0;
  return ::short();
}

