//            erbt nun von skeleton

#include <class.h>
#include "../def.h"

inherit "/p/std/npc/skeleton";
inherit "/std/inpc/select";

int creation_time;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  creation_time=time();

  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG,
    "Ein Skelett, das nur mehr aus Knochen besteht. Zwei leere Augenhoehlen "
    "aus dem graesslichen Totenschaedel starren Dich hasserfuellt an. " );
  SetProp(P_NAME, "Skelett" );
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "Nekromantenskelett"}));
  create_default_skeleton(1,1); //erstmal damit einige defaults gesetzt

  SetProp(P_RACE, "Untoter");
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_FRIEND, 1);
  SetProp(P_HP_DELAY, 1);
  SetProp(P_MAX_FOOD, 0);
  SetProp(P_MAX_DRINK, 0);
  SetProp(P_MAX_ALCOHOL, 0);
  SetProp(P_MAX_POISON, 0);
  SetProp(P_TEMPERATURE_RANGE, ([0:-276, 1:500]));
  SetProp(P_DIE_MSG, " zerfaellt zu Staub.\n");

  AddDetail( ({ "knochen" }), 
    "Das Skelett besteht nur aus bleichen Knochen." );
  AddDetail( ({ "totenschaedel", "schaedel" }), 
    "Das Skelett hat einen graesslichen Totenschaedel." );

  SetChats( 1,({
        "Das Skelett knackt mit den Knochen.\n",
        "Das Skelett klappert mit den Zaehnen.\n",
        "Das Skelett laesst seine Ruestung scheppern.\n",
        "Das Skelett blickt Dich aus leeren Augenhoehlen an.\n",
        "Das Skelett klappert mit seinen Knochen.\n",
        }) );
  add_select_commands();
}

void reset()
{
  if (!is_clone(TO)) 
    return ::reset();
  die(0);
  return;
}

void give_notify(object ob)
{
  if( ob->QueryProp(P_ARMOUR_TYPE) && TP==QueryProp(P_NEKRO_MASTERED_BY) ) 
    command("trage_beste_ruestungen");
  else if( ob->QueryProp(P_WEAPON_TYPE) && TP==QueryProp(P_NEKRO_MASTERED_BY) )
    command("zuecke_beste_waffe");
  ::give_notify(ob);
}

