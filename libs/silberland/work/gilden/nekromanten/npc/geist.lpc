// 29.07.2003 Archon: typofix
// 09.12.2003 Feyaria: MP fuer caster im nerv()

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <class.h>
#include "../def.h"

int creation_time;
int dur=-1;
object feind;
int total_sp=0;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  creation_time=time();

  SetProp(P_SHORT, "Ein Geist");
  SetProp(P_LONG,
    "Eine schaurige Schreckgestalt aus dem Jenseits schwebt vor Dir in der "
    "Luft. Sie ist durchscheinend wie Nebel und kaum greifbar, dafuer aber "
    "um so fuerchterlicher anzusehen. Ein leibhaftiger Geist ist hier aus "
    "dem Totenreich zurueckgekehrt. " );
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  AddId( ({ "geist", "Nekromantengeist" }));
  AddClass(CL_UNDEAD);
  SetProp (P_REJECT,
         ({ REJECT_DROP, "Ein Geist kann nichts nehmen!\n" }) );

  SetProp(P_RACE, "Geist");
  SetProp(P_ALIGN, -666);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_FRIEND, 1);
  //SetProp(P_GHOST, 1);
  SetProp(P_MAX_POISON, 0);
  SetProp(P_TEMPERATURE_RANGE, ([0:-276, 1:500]));
  SetProp(P_NOATTACK, "ist bereits tot!");
  SetProp(P_DIE_MSG, " ist erloest.\nDu fuehlst Dich erleichtert.\n");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt weit weg");

  AddCmd( ({"bete"}), "beten");
}

void SetGhost(object corpse, mixed caster, int succ)
{
  int level;
  string str;

  if( caster )
  { 
    SetProp(P_NEKRO_CASTED_BY, caster);

    SetProp(P_LONG, QueryProp(P_LONG)[0..<2] + 
      caster->Name()+" hat diesen Geist wieder ins Leben zurueckgeholt.");
  }
  str=implode(explode(corpse->QueryProp(P_LONG), " ")[5..<1], " ")[0..<3];
  SetProp(P_SHORT, "Der Geist "+str );
  SetProp(P_NAME, "Geist "+str );
  SetProp(P_SIZE, corpse->QueryProp(P_SIZE));

  if( (level=corpse->QueryProp(P_LEVEL)/2) > 30) 
     level=30;
  create_default_npc(level);
  SetProp(P_HANDS, ({" mit Geisterhaenden", 50+level*5+succ/100,
                     DT_MAGIC }));
  SetProp(P_XP, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_UNHOLY: -1 ]));
  dur=level*40+succ/25;
  feind=corpse->QueryProp(P_KILLER);
  call_out("goto_feind", 2+random(10) );
  
  return;
}

void goto_feind()
{
  object caster;
  tell_room(MENV, "Der Geist sucht nun seinen Moerder!\n");
  if( objectp(feind) )
  {
    if( !living(feind) )
    {
      if(!living(feind = ENV(feind)))
        return;
    }
    if( !present(feind, MENV) ) 
      move(ENV(feind), M_TPORT);
    feind->AddPursuer(TO);
  }
  if( objectp(caster = QueryProp(P_NEKRO_CASTED_BY)) && feind == caster )
  {
    feind->AddDefender(TO);
    tell_object(caster, "Der Geist schwebt beschuetzend um Dich herum.\n");
  }
}

void reset()
{
  if (!is_clone(TO)) 
    return; 
  ::reset();
  die();
}

void init()
{
  object ob;

  if((time()-creation_time) > dur)
  {
    if(objectp(feind)) feind->RemovePursuer(TO);
    call_out("remove", 0);
  }

  ::init();

  if( random(2) && find_call_out("nerv")==-1) call_out("nerv",0);
}

void nerv()
{
  object caster;
  int sp;

  if( objectp(feind) && objectp(TO) && MENV && present(feind, MENV) ) {
    if( objectp(caster = QueryProp(P_NEKRO_CASTED_BY)) && feind == caster &&
        random(3)) // Schuetzender geist scrollt weniger
      return;
    if( feind->QueryProp(P_GHOST) ) {
      tell_object(feind, BS("Durch Deinen Tod hast Du auch "+name(WEN,1)+
          " erloest!"));
      call_out("die",0);
      return;
    }
    switch( random(20) ){
      case 0:
        tell_room(MENV, BS( Name(WER,1)+" sagt: Du gemeiner Moerder, "+
            feind->name()+"!") );
        break;
      case 1:
        tell_object(feind, BS("Du bekommst ein schlechtes Gewissen, weil "+
            name(WER,1)+" wegen Dir nicht zur Ruhe kommt."));
        break;
      case 2:
        tell_room(MENV, BS("Das Kettenrasseln und Heulen des Geistes "+
            "bringt Dich ganz durcheinander.") );
        break;
      case 3:
        tell_room(MENV, break_string("Warum hast Du mich getoetet, "+
            feind->name()+"?", 78, Name(WER,1)+" jammert: "));
        break;
      case 4:
        tell_room(MENV, break_string("Warum teilst Du nicht Deine "+
            feind->QueryDeepMoney()+" Muenzen mit Deinen Freunden, "+
            feind->name()+"?", 78,
            Name(WER,1)+" sagt: "));
        break;
      case 5:
        tell_object(feind, BS(Name(WER,1)+" erschreckt Dich mit einer "
            "fuerchterlichen Grimasse."));
        break;
      case 6:
        tell_object(feind, BS("Der entsetzliche Geist zehrt an Deinen "
            "Nerven!"));
        break;
      case 7:
        tell_object(feind, BS("Eine ploetzliche Panik ueberkommt Dich, "
            "als "+name(WER,1)+" in seiner koerperlosen Form mitten "
            "durch Dich hindurchschwebt."));
        break;
      case 8:
        tell_room(MENV, BS(Name(WER,1)+" rasselt fuerchterlich mit einer "
            "rostigen Eisenkette."));
        break;
      case 9:
        tell_room(MENV, BS(Name(WER,1)+" heult schauerlich."));
        break;
      case 10:
        tell_object(feind, BS(Name(WER,1)+ " versucht, Dich in die Geisterwelt "
            "zu reissen."));
        break;
      case 11:
        tell_object(feind, BS(Name(WER,1)+ " geht Dir fuerchterlich auf den "
            "Geist!"));
        break;
      case 12:
        tell_room(MENV, BS(feind->Name(WER,1)+" wird von einem fuerchterlichen "
            "Geist geplagt."), ({feind}));
        tell_object(feind, BS("Du wirst von "+name(WEM,1)+" geplagt."));
        break;
      case 13:
        tell_room(MENV, Name(WER,1)+ " macht: BUUUHHH!!!!\n"
            "Du erschrickst fuerchterlich.\n");
        break;
      case 14:
        tell_object(feind, BS(Name(WER,1)+" verwirrt Dich voellig!"));
        break;
      case 15:
        tell_object(feind, BS(Name(WER,1)+" bittet Dich um Erloesung."));
        break;
      case 16:
        tell_object(feind, break_string("Bete fuer mich, damit ich "
            "Erloesung finden kann!", 78, Name(WER,1)+" jammert: "));
        break;
      case 17:
        tell_room(MENV, BS(Name(WER,1)+" heult Dir die Ohren voll."));
        break;
      case 18:
        tell_room(MENV, BS("Deine Nackenhaare stellen sich auf, als "+
            name(WER,1)+" zu heulen und jammern beginnt."));
        break;
      case 19:
        tell_object(feind, BS("Du bekommst eine Gaensehaut, als "+
            name(WER,1)+" Dich mit eisigkalten, immateriellen Fingern "
            "beruehrt."));
        break;
    }
    if( objectp(caster = QueryProp(P_NEKRO_CASTED_BY)) && feind != caster )
    {
      if( random(20) == 13 )
      {
        tell_object(caster, BS(
              "Deine Macht waechst, weil "+feind->name(WER)+ " von "+
              name(WEM,1)+ " gequaelt wird."));
        sp = 1 + random(QueryProp(P_LEVEL));
      }
      else
      {
        sp = 1 + random(3);
      }
      caster->AddSp(sp);
      total_sp += sp;
    }
  }
}

void heart_beat()
{
  ::heart_beat();

  if((time()-creation_time) > dur || QueryProp(P_HP) <= 0)
  {
    if(objectp(feind)) 
    {
      feind->RemovePursuer(TO);
      if (feind == QueryProp(P_NEKRO_CASTED_BY))
        feind->RemoveDefender(TO);
    }
    die();
  }

  if( !random(10) && find_call_out("nerv")==-1) 
    nerv();
}

int QueryDuration()
{
  return creation_time+dur-time();
}

int beten(string str)
{
  object caster;
  notify_fail("Fuer wen willst Du beten?\n");
  if( str!="geist" && str!="fuer geist") return 0;
  if( !MENV->GetDetail("altar") )
    return notify_fail("Du kannst nur an einem Altar beten!\n"),0;
  caster=QueryProp(P_NEKRO_CASTED_BY);
  if( random(3) || (caster && feind && total_sp < 40)) 
  {
    write(BS("Du betest fuer " +name(WEN,1)+"."));
    return 1;
  }
  write(BS("Du betest fuer "+name(WEN,1)+" und er ist erloest!"));
  if( objectp(caster) ) {
    write(BS("Du fuehlst eine seltsame innere Leere in Dir."));
    tell_object(caster,  BS("Einer Deiner Geister wurde ausgetrieben, "
          "dennoch fuehlst Du Dich in Deiner MACHT gestaerkt!"));
    caster->AddSp(random(20)+1);
    if( objectp(feind) )
      feind->AddSp(-random(20)+1);
  }
  say(BS(CAP_TPN+" betet fuer "+name(WEN,1)+" und er ist erloest!"), ({TP}));
  call_out("remove",0);
  return 1;
}

mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{
  object owner;

  if(!ENV(TO)) return 0;
  if(!objectp(owner=QueryProp(P_NEKRO_CASTED_BY))) return 0;
  if((owner->QueryProp(P_ALIGN) > -500)) return 0;

  if (!random(3) && (dam > 50)) 
  {
    tell_object(owner, Name(WER,1) + " schwaecht eine Attacke fuer Dich ab!\n");
    dam -= dam / 4;
    AddHp(-dam / 50);
  } else if(QueryProp("nekro_defend_scare") && !random(6-QueryProp("nekro_defend_scare"))) {
    tell_room(ENV(TO), BS(sprintf("%s erschreckt %s fuerchterlich!", Name(WER,1), enemy->name(WEN, 1))));
    enemy->SetProp(P_DISABLE_ATTACK, 1);
  }

  return ({dam, dam_type, spell});
}
