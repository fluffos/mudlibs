// Ein Fleischungetuem
// In seinem Wanst kann es fuer seinen Meister Gegenstaende
// aufbewehren. Ghoulessen verwest darin nicht!
//
// 08-08-2012 Gwenshara
//            Created.

inherit "/p/std/npc/nekro_npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"

#define MAX_ITEMS 20
#define MIN_ITEMS 5

int creation_time, dur;
int suc;
int itemlimit;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  creation_time=time();

  SetProp(P_SHORT, "Ein Fleischungetuem");
  SetProp(P_NAME, "Fleischungetuem" );
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "ungetuem", "Nekromantenfleischbestie", "fleischungetuem" }));

  create_default_npc(7);

  SetProp(P_MAX_HP, 800);
  SetProp(P_MAX_SP, 0);
  SetAttribute(A_STR, 99);

  SetProp(P_RACE, "Untoter");
  SetProp(P_ALIGN, -666);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_FRIEND, 1);
  SetProp(P_MAX_POISON, 0);
  SetProp(P_TEMPERATURE_RANGE, ([0:-276, 1:500]));
  SetProp(P_DIE_MSG, " zerplatzt in einem Schwall aus Blut und Gedaermen.\n");

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  
  // Das hier ist ein Utility Undead
  SetProp(P_NEKRO_UTILITY_UNDEAD, 1);  
 
  itemlimit = 0;
  dur       = -1;
  creation_time = time();
}

void SetFleshbeast(mixed caster, int succ)
{
  int level, maxlevel;
 
  if(objectp(caster)) 
  {
    SetProp(P_NEKRO_CASTED_BY, caster);
    SetProp(P_LONG, QueryProp(P_LONG)[0..<2] + 
      caster->Name()+" hat diesen Untoten beschworen.");
  }
  SetProp(P_SIZE, 300 + random(200));
  SetProp(P_XP, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
        DT_UNHOLY: -0.5, DT_HOLY:0.5, DT_LIGHT:0.5 ]));

  // itemlimit berechnen
  if(objectp(caster))
    itemlimit = (int) (caster->QueryProp(P_GUILD_LEVEL) +
                       caster->QueryProp(P_GUILD_CIRCLE) +
                       (succ/1000)-4);
  else
    itemlimit = MIN_ITEMS+random(MAX_ITEMS/2);

  if(itemlimit < MIN_ITEMS)
    itemlimit = MIN_ITEMS;
  
  if(itemlimit > MAX_ITEMS)
    itemlimit = MAX_ITEMS;
  
  if(itemlimit > MAX_ITEMS)
    itemlimit = MAX_ITEMS;;

  // dauer berechnen
  /*if(objectp(caster))
    dur = caster->QueryProp(P_GUILD_LEVEL) * 60 + succ / 10 + random(200) +
          caster->QueryProp(P_GUILD_CIRCLE) * 30;
  else
    dur = 120+random(60);*/
  return;
}

void init()
{
  ::init();

  //call_out("health_message", 0);

  if(dur>0 && creation_time+dur<time())
    call_out("die", 0);
}

void reset()
{
  if (!is_clone(ME)) 
    return ::reset();

  if(!objectp(QueryProp(P_NEKRO_CASTED_BY)))
   die(0);

  if(!find_player(QueryProp(P_NEKRO_CASTED_BY)))
   die(0);

  return;
}

int QueryDuration()
{
  return creation_time+dur-time();
}

void InformDefend(object enemy)
{
  return;
}

void health_message()
{
  object env, caster;
  int swidth;

  env    = environment(TO);
  caster = QueryProp(P_NEKRO_CASTED_BY);

  if(!objectp(caster)) return;

  swidth = caster->QueryProp(P_SCREENWIDTH) || 78;

  if(QueryDuration() < 120 && QueryDuration() > 60 && !random(4))
    tell_object(caster, break_string("Deine Fleischbestie gibt aechzende "
                        "Geraeusche von sich!", swidth));
  else if(QueryDuration() < 60 && QueryDuration() > 15 && !random(2))
    tell_object(caster, break_string("Deine Fleischbestie brodelt bedrohlich!",
                       swidth));
  else if(QueryDuration() < 15)
    tell_object(caster, break_string("Die Fleischbestie explodiert jeden "
                        "Moment!", swidth));

  return; 
}

string health_status()
{
  int duration;
  duration = QueryDuration();
  
  if(duration > 1500)
    return "haelt noch lange durch.";
  if(duration > 1000 && duration <= 1500)
    return "noch eine Weile.";
  if(duration > 500 && duration <= 1000)
    return "nicht mehr all zu lange.";
  if(duration > 250 && duration <= 500)
    return "wird bald vergehen.";
  if(duration > 60 && duration <= 250)
    return "ist kurz davor zu explodieren!";
  if(duration < 60)
    return "wird jeden Moment zerfetzt! LAUF DU NARR!";
  if(duration < 0)
    return "haelt permanent.";
  
  return "???";
}


string _query_long()
{
  return break_string(
    "Dieses Fleischungetuem ist wirklich haesslich. Es sieht aus, wie "
    "die aufgedunsene Leiche eines riesigen Wesens, wie eines Ogers, "
    "oder vielleicht auch eines Trolls. So genau kannst du das unter "
    "den schwabbelnden Fleischbergen nicht erkennen. Im Vergleich zu "
    "seinem Koerper sind Kopf und Extremitaeten geradezu winzig "
    "geraten. Einzig seine Beinde sind muskoloes und standhaft. Ihr "
    "gewaltiger Bauch ist staendig in Bewegung, als wuerde sich "
    "etwas daraus befreien wollen! Das Ungetuem "+health_status()+" "
	, 78); 
}

int requiresUndeadSlot()
{
  return 0;
}

void carry(string what, object pl)
{
  object ob, env;
  int mcode;
  if(!objectp(pl))
    return;
	
  env = environment(this_object());
  if(!objectp(env))
    return;
	
  ob = present(what, pl);
	
  if(!objectp(ob))
  {
    env->Message(Name(WER, 1)+" gurgelt: Haaaast niiiicht!\n",
	             MSGFLAG_SOUND);
	return;
  }
  
  if(sizeof(deep_inventory()) > itemlimit)
  {
    env->Message(Name(WER, 1)+ " brummt: Kaaan nicht vieeeel trag!\n",
	             MSGFLAG_SOUND);
	return;
  }
  
  if(ob->QueryProp(P_MAX_WEIGHT))
  {
    env->Message(Name(WER, 1)+" gurgelt: Nix traaagen Saaaack!\n",
	             MSGFLAG_SOUND);
	return;
  }
  
  mcode = ob->move(TO, M_GIVE|M_NOCHECK);
  if(mcode != 1)
  {
    env->Message(Name(WER, 1)+" sagt: Tut mir sehr leid, aber hier liegt wohl "
	             "ein Fehler vor! Bitte informiere einen der Daemonen... aeh "
				 "Magier. Fehlercode "+mcode+"\n");
	return;
  }
  else
  {
    env->Message(Name(WER, 1)+" sagt: Mach ich tragen!\n", MSGFLAG_SOUND);
	pl->Message("Du gibst "+name(WEM, 1)+" "+ob->name(WEN, 1)+".\n");
	env->Message(pl->Name(WER, 1)+" gibt "+name(WEM)+" "+ob->name(WEN, 1)
	             +".\n",0,([MSGFLAG_EXCLUDE: ({pl})]));
	return;
  }
  return;
}

void give_back(string what, object pl)
{
  object ob, env;
  int mcode;
  if(!objectp(pl))
    return;
	
  env = environment(this_object());
  if(!objectp(env))
    return;
	
  ob = present(what);
  if(!objectp(ob))
  {
    env->Message(Name(WER, 1)+ " gurgelt: Haaaab niiiiicht!\n",
	             MSGFLAG_SOUND);
	return;
  }
  
  mcode = ob->move(pl, M_GIVE);
  
  if(mcode == ME_TOO_HEAVY)
  {
    env->Message(Name(WER, 1)+ " gurgelt: Dummes Meiiista! Kann nix tragen!\n",
	             MSGFLAG_SOUND);
	return;
  }
  else if(mcode < 1)
  {
    env->Message(Name(WER, 1)+" sagt: Tut mir sehr leid, aber hier liegt wohl "
	             "ein Fehler vor! Bitte informiere einen der Daemonen... aeh "
				 "Magier. Fehlercode "+mcode+"\n");
	return;
  }
  else
  {
    env->Message(Name(WER, 1)+" sagt: Mach ich geben!\n", MSGFLAG_SOUND);
	pl->Message(Name(WER, 1)+" gibt Dir "+ob->name(WEN, 1)+".\n");
	env->Message(Name(WER, 1)+" gibt "+pl->Name(WEM)+" "+ob->name(WEN, 1)
	             +".\n",0,([MSGFLAG_EXCLUDE: ({pl})]));
	return;
  }
  
  return;
}

void catch_tell(string str)
{
  string wer,was, npc;
  mixed my_name;
  if (!query_verb()) return ;
  if(TP!=QueryMaster()) return ;
  
  if(sscanf(str, "%s teilt Dir mit: %s\n", wer, was)==2) {
    if(strstr(lower_case(was), "wo bist du")!=-1) {
      TP->Message(break_string(QueryPosition(),78, sprintf(
              "%s teilt Dir mit: ", Name(WER))), MSGFLAG_TELL);
      return ;
    }
  }
  
  my_name=QueryProp(P_NAME);
  if(query_verb() == "sag" || query_verb()[0..0] == "'")
  {
    if (sscanf(str,"%s sagt: %s %s\n",wer,npc,was)!=3) return;
    if (!id(npc)) return;
	
	if(was[0..5] == "trage ")
	  call_out("carry", 0, was[6..], TP);
	if(was[0..7] == "gib mir ")
	  call_out("give_back", 0, was[8..], TP);
	  
  }
  
  ::catch_tell(str);
  return;
}
