// Sarg - 02.06.2003 erstellt Archon - Sarg wird geclont!!
/*
 Rev 1.0 02.06.2003 Archon: erstellt
*/

#pragma strong_types

inherit "std/thing/moving";
inherit "std/room";  //damit man sich drinnen umsehen kann
#include "../def.h"

int pos,raus;
object prisoner;

void create();
mixed detail_waende();
int exit_aufgabe();

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  
  pos=0;
  raus=0;

  SetProp(P_NAME, "Sarg");
  SetProp(P_SHORT, "Ein Sarg");
  SetProp(P_INT_SHORT, "In einem Sarg");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOGET, "Der Sarg ist viel zu schwer und zu unhandlich, um ihn wegzuschleppen.");
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT,100000);
  SetProp(P_SIZE, 250);

  AddDetail(({"holz","eichenholz","eiche"}),
     "Der Sarg besteht aus Holz, doch so wie dieses aussieht, koennte jeden "
     "Augenblick etwas aus dem Inneren des Sarges herausbrechen.");
  AddDetail(({"deckel","sargdeckel"}),
     "Der Sarg hat ueberhaupt gar keinen Deckel.");
  AddDetail(({"wand","waende","sargwand","sargwaende"}),#'detail_waende);
  AddId(({"sarg",NEKRO_SARG}));

  SetProp(P_HIDE_EXITS,({"aufgabe"}));
  AddExit("aufgabe",#'exit_aufgabe);
}

int exit_aufgabe() { return 0; }

mixed detail_waende()
{
  if (environment(PL)!=ME) return 0;
  return "Die Sargwaende umgeben Dich und Du bekommst Platzangst.\n";
}

string _query_long()
{
  switch(pos)
  {
    case 0:
      return BS("Auf dem Boden liegt ein Sarg. Was sich auch immer im "
                "Sarg befinden mag, raus kann es bestimmt nicht, da dieser "
                "keinen Deckel oder eine andere Oeffnung hat.");
    break;
    case 1: case 2: case 3:
      return BS("Auf dem Boden liegt ein Sarg. Was sich auch immer im "
                "Sarg befinden mag, raus kann es bestimmt nicht, auch wenn "
                "von Innen ein Pochen und Schlagen zu hoeren ist.");
    break;
    case 4:
      return BS("Auf dem Boden liegt ein nicht mehr ganz intakter Sarg. "
                "Einzelne Splitter sind herausgebrochen und hinterlassen "
                "kleine Loecher, durch die man das Innere eraehnen kann.");
    break;
  }
}

string _query_int_long()
{
  switch(pos)
  {
    case 0: case 1:
     return "Du bist von lauter Bandagen umwickelt in einem Sarg gefangen.\n";
    break;
    case 2:
     return "Panisch versuchst Du Dir die Bandagen vom Leib zu reissen.\n";
    break;
    case 3:
     return "Du trommelst wie wild gegen die Sargwaende.\n";
    break;
    case 4:
     return BS("Mit voller Wucht schlaegst Du gegen die Sargwaende und "
               "brichst langsam durch diese hindurch.");
    break;
  }
}

int PreventFollow(object ob) { return 1; }
int PreventLeave(object ob,object dest) { return (raus==0); }

void reset()
{
  object draussen;
  ::reset();
  if (!is_clone(ME)) return;
  raus=1;
  draussen = environment(ME);
  if (!objectp(draussen)) draussen = find_object("/room/void");
  map_objects(all_inventory(),"move",environment(ME),M_NOCHECK|M_SILENT);
  remove(1);
}

void StartSequence(object pl)
{
  prisoner=pl;
  SetProp(P_NO_NEKRO_MUMMY,1); //hier nicht nochmal einen spruch drauf!!
  pl->AddHp(-5); //leichter Schaden
  tell_room(environment(pl),BS(
    "Ploetzlich wird "+pl->name(WER,1)+" von einer schwarzen Wolke umgeben, "
    "Bandagen legen sich fest um "+pl->QueryPronoun(WEN)+" und "
    +pl->name(WER,1)+" wird in einen Sarg gezogen, der ploetzlich hinter "
    +pl->QueryPossPronoun(MALE,WEM,SINGULAR)+" Ruecken aus der Wolke "
    "entsteht."),({pl}));
  tell_object(pl,BS(
    "Ploetzlich umgibt Dich eine schwarze Wolke aus der sich Bandagen "
    "fest um Deinen Koerper legen, bis Du Dich nicht mehr ruehren kannst. "
    "Danach wirst Du nach hinten gerissen und landest, Dich vor Schmerzen "
    "grummend wollend, in einem Dich umschliessenden Behaelter. Du fuehlst "
    "Dich lebend begraben."));
  pl->move(ME,M_NOCHECK|M_SILENT);
  if (pl->QueryProp(P_SIZE))
    SetProp(P_SIZE,pl->QueryProp(P_SIZE)+10);
  call_out("sequence",5,1);
}

void sequence(int p)
{
  object draussen;
  pos=p;
  switch(pos)
  {
    case 1:
      if (environment(ME))
       tell_room(environment(ME),"Du hoerst ein dumpfes Pochen im Sarg.\n");
      tell_room(ME,"Voller Panik klopfst Du von Bandagen umhuellt gegen "
                   "die Sargwand.\n");
    break;
    case 2:
      if (environment(ME))
       tell_room(environment(ME),"Das Pochen im Sarg wird immer lauter.\n");
      tell_room(ME,BS("Panisch versuchst Du Dich zu befreien und reisst grosse "
        "Stuecke der Bandagen von Deinen Leib."));
    break;
    case 3:
      if (environment(ME))
       tell_room(environment(ME),"Lautes Krachen dringt aus dem Sarg.\n");
      tell_room(ME,BS("Halb hysterisch trommelst Du gegen die Waende "
        "des Sarges."));
    break;
    case 4:
      if (environment(ME))
       tell_room(environment(ME),"Ploetzlich beginnt der Sarg zu splittern.\n");
      tell_room(ME,BS("Mit roher Kraft schlaegst Du gegen den Sarg und "
        "merkst, wie er langsam zu splittern beginnt."));
    break;
    default:
      draussen = environment(ME);
      if (!objectp(draussen)) draussen = find_object("/room/void");
      if (!objectp(prisoner))
       tell_room(draussen,BS(
        "Mit einem lauten Krach zerspringt der Sarg und schwindet dann in "
        "einer schwarzen Wolke."));
      else
       tell_room(draussen,BS(
        "Mit einem lauten Krach zerspringt der Sarg und schwindet dann in "
        "einer schwarzen Wolke, als sich "+prisoner->name(WER,1)+
        " befreit."));
      tell_room(ME,BS(
        "Mit einem letzten kraeftigen Schlag von Dir zerspringt der Sarg "
        "und schwindet dann in einer schwarzen Wolke. Langsam laesst Deine "
        "Panik nach, nachdem Du Dich endlich befreien koenntest."));
      raus=1;
      map_objects(all_inventory(),"move",environment(ME),M_NOCHECK|M_SILENT);
      remove(1);
      return;
    break;
  }
  call_out("sequence",5,++p);
}

void SetupLeichenSarg()
{ //id fuer sarg geben
  AddId(NEKRO_MUMMY);
}
