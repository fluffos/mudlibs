#include "../nekro.h"

inherit "std/room";
inherit "/d/unterwelt/nekromanten/room/std_yaq_monoq";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Im Unheiligtum von Yol-Ghurmak");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_HOUSE]) );

  
  AddDetail( ({ "angst" }),
    "Du siehst sie nicht. Aber Du spuerst sie. Unterschwellig.");
  AddDetail( ({ "yol", "ghurmak", "yol'ghurmak"}),
    "Du weisst, dass dieser Ort hier so genannt wird. Woher vermagst Du "
    "allerdings nicht zu sagen."); 
  AddDetail( ({ "boden" }),
    "Kaltes oelig schwarzes Gestein bildet den Boden. Du vermagst nicht "
    "zu sagen was es ist, doch die pulsiereden roten Adern im Inneren "
    "verraten Dir, dass es nicht natuerlichen Ursprungs ist.");
  AddDetail( ({"inneren"}),
    "Erschreckend! Im Inneren des Gesteins verlaufen rote Adern. Das waere "
    "vielleicht noch nichts aussergewoehnliches, wenn nicht dieses "
    "rhythmische Pulsieren waere. Als Du laenger hinsiehst spuerst Du, wie "
    "Dein Herz, Dein Blut, ja selbst Dein Ich passen sich diesem Impuls "
    "an.");
  AddDetail( ({"ursprung", "ursprungs", "welt"}),
    "Was immer dieser Marmor ist, oder von er kommt: Von dieser Welt ist "
    "er nicht!");
  AddDetail( ({ "decke", "hoehlendecke" }),
    "Weit ueber Dir spannt sich eine gigantische Kuppel ueber die Insel "
    "Von der Decke rinnt ein riesiger Saeurefall herunter, der sich sued"
    "lich vor dem Unheiligtum in den See ergiesst. Die Monolithen, die "
    "rings herum stehen, ragen nicht senkrecht zur Hoehlendecke empor, "
    "sondern sind grotesk verformt und bilden ueber Dir eine Art Kuppel"
    "geruest.");
  AddDetail( ({ "see"}),
      "Der See und um Yol-Ghurmak besteht aus reinster Saeure.");
  AddDetail( ({ "insel" }),
      "Yol-Ghurmak. Oder heisst nur das Unheiligtum hier so? Yol-Ghurmak. "
      "Irgendwie geht Dir der Name nicht mehr aus dem Kopf. Yol-Ghurmak. "
      "Yol-Ghurmak. Yol-Ghurmak ...");
  AddDetail( ({ "kopf", "name" }),
      "Yol-Ghurmak. Yol-Ghurmak ... ");
  AddDetail( ({ "monolith", "monolithen" }),
      "Die Monolithen - allesamt grotesk verformt und unnatuerlich wirkend, "
      "stehen ringsum um das Unheiligtum. Von hier aus kannst Du allerdings "
      "nichts genaues erkennen. Sie bilden eine Art Kuppelgeruest, denn "
      "sie sind zum Altar hin verbogen");
  AddDetail( ({ "kuppelgeruest", "position" }),
      "Die Monolithen sind auf groteske Art und Weise verformt und bilden "
      "ein Kuppelgeruest ueber Dir, dass heisst sie sind zu Dir her nach "
      "oben verformt. Es scheint so, als haette sie eine enorme Kraft "
      "in diese Position gebracht.");
  AddDetail( ({"kraft"}), 
      "Vermutich die pure Kraft des Verderbten. Dich schaudert.");
  AddDetail( ({"verderbten"}), 
      "Du spuerst es ueberall ... ");
  AddDetail( ({ "art", "weise" }),
      "Seltsam. Auf irgendweise erinnern Dich die Monolithen an etwas, doch "
      "diese hier sind grotesk verformt.");
  AddDetail( ({"fall", "saeurefall", "saeure"}),
    "Der Saeurefall kommt von der Decke der Hoehle, weit ueber Dir.");
  AddDetail( ({"schwaerze"}),
      "Die Schwaerze des Gesteins ist undurchdringlich.");
  AddDetail( ({ "waende", "wand" }),
    "Hier, inmitten von Yol'Ghurmak, existieren keine Waende. Nichts "
    "Sichtbares kann Dich davon abhalten diesen Ort zu verlassen.");
  AddDetail( ({"sichtbares"}), 
      "Geh ... wenn Du noch kannst ...");
  AddDetail( ({ "gestein","schwarz","marmor" }),
    "Das Gestein, aus dem alles hier besteht, schimmerd in einem oeligen "
    "Schwarz. Blutrote Adern durchziehen das Gestein, scheinen zu pulsieren "
    "und voller Leben zu sein, obwohl eine eisige Kaelte von ihm ausgeht. "
    "Was immer dieses Gestein beseelt hat, es strahlt eine Kaelte aus, die "
    "Dir nicht geheuer ist.");
  AddDetail( ({ "adern" }),
    "Blutrote Adern durchziehen das Gestein. Die Adern scheinen durch die "
    "glatte Oberflaeche hindurch und pulsieren in einem uebermaechtigen "
    "Rhythmus. Selbst Dein eigenes Herz hat sich diesem Rhythmus angepasst. "
    "Dein Blut, Dein Ich, alles von Dir draengt zu dem Altar in der Mitte. ");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Halle steht er: Der Altar. Er pulsiert in einem "
    "roetlichen Licht, das von all den Adern ausgeht, die sich durch das "
    "Gestein ziehen, aus dem diese Halle hier erbaut ist.");
    
  AddDetail( ({ "blut", "ich" }),
    "Seltsam, nicht wahr. Es treibt Dich zu diesem Altar, so, als ob sich "
    "dort Dein Schicksal erfuellen wuerde.");
  AddDetail( ({ "schicksal" ,"n","a","e","h","r" }),
    "Es draengt Dich zu dem Altar! Naeher! NAEHER! N A E H E R !");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des Gesteins schimmert in einem oeligen Schwarz. "
    "Unterhalb der Oberflaeche siehst Du blutrote Adern, die in einem "
    "fremdartigen Rhythmus pulsieren. Die Oberflaeche ist eiskalt.");
  AddDetail( ({ "rhythmus", "pulsieren" }),
    "Wie durch eine unheilige Macht angetrieben pulsieren die Adern in "
    "dem Gestein. Richtung Altar hin scheint sich das Pulsieren zu "
    "verstaerken und intensivier zu werden. Selbst Dein eigenes Herz "
    "kann diesem uebermaechtigen Impuls nicht wiederstehen und passt "
    "sich dem Rhythmus an.");
  AddDetail( ({ "macht", "winkeln" }),
    "Du spuerst sie, in den hintersten Winkeln Deiner Gedanken.");
  AddDetail( ({ "gedanken" }),
    "Nun spuerst Du ganz deutlich: Hier ist etwas. Lebendig. Gross. "
    "Es lauert. Aber auf was?");
  AddDetail( ({ "herz" }),
    "Dein Herz hat sich dem Rhythmus angepasst ... und Du kannst nichts "
    "dagegen tun. Du fuehlst Dich ... seltsam.");
  AddDetail( ({ "impuls" }),
    "Was auch immer hier passiert, es ist widernatuerlich. Kalt. Toedlich.");
  AddDetail( ({ "leben" }),
    "Du zweifelst nicht daran: Irgendetwas 'lebt' hier, sofern man hier "
    "von Leben kann. Irgendeine Entitaet scheint hier zu warten, zu lauern"
    "...");
  AddDetail( ({ "entitaet","irgendetwas" }),
    "Du spuerst sie ... ");
  AddDetail( ({ "kaelte" }),
    "Die Kaelte geht von dem Gestein aus und ist allgegenwaertig. Es scheint "
    "fast so, also wuerde die gesamte Waerme der Umgebung absorbiert.");
  AddDetail( ({ "waerme" }),
    "Waerme? So was ist hier nicht zu finden!");
  AddDetail( ({ "umgebung" }),
    "Sieh Dich um und erkenne, wo Du bist.");
  AddDetail( ({ "ort", "unheiligtum", "raum", "halle" }), 
    #'_query_int_long);
  AddDetail( ({ "nekromanten" }),
    "Sieh Dich um, es sind sicher welche hier. Doch huete Dich, sie brauchen "
    "immer wieder neue Untote.");
  AddDetail( ({ "untote", "untote" }),
    "Untote befinden sich im Moment keine hier!");
  AddDetail( ({ "moment" }),
    "Das im Moment keine Untote sind hier, vermag nichts zu heissen. Hier "
    "kann jederzeit eine dieser Kreaturen vor Dir stehen!");
  AddDetail( ({ "kreatur", "kreaturen" }),
    "Du siehst Du doch vorsichtig um.");
  AddDetail( ({ "altar" }),
    "Der Altar - zumindest haeltst Du ihn fuer einen solchen - erstrahlt "
    "in einem schwach pulsierenden, roten Licht. Die roten Adern des "
    "Gesteins sind dort am klarsten zu erkennen, das Pulsieren an sich "
    "scheint von ihm. Der Altar weisst nicht die kleinsten Verzierungen "
    "auf, er ist vollkommen glatt.");
  AddDetail( ({ "verzierungen" }),
    "Du siehst keine.");
  AddDetail( ({ "licht" }),
    "Das Licht um den Altar herum pulsiert in einem satten Rot. "
    "Es wirkt irgendwie anziehend auf Dich ...");
  AddDetail( ({ "rot" }),
    "Das "+ANSI_RED+"Rot"+ANSI_NORMAL+" macht das ganze Unheiligtum "
    "noch beaengstigender.");
  AddDetail( ({ "art" }),
    "Ein Altar sieht normalerweise anders aus, aber du spuerst, dass "
    "es sich um einen Altar handelt.");
  AddDetail( ({ "pochen" }),
    "Selbst das Pochen deines Blutes passt sich dem Impuls an, der von "
    "den Adern im schwarzen Gestein ausgeht. Das Pochen scheint Richtung "
    "Altar staerker zu werden.");
  AddDetail( ({ "kuppel", "hoehle" }),
    "Wie eine unheilbringende Hand spannt sich eine gewaltige kuppelfoermige "
    "Hoehle ueber "
    "Dich. Sie ist vollkommen glatt und aus schwarzem Gestein geformt. "
    "'Geformt' ist der beste Ausdruck dafuer, denn es sind keinerlei "
    "Fugen zu sehen, die darauf hinweisen koennten, dass diese Kuppel "
    "von Sterblichen errichtet worden ist. Die Monolithen, die ringsum "
    "um das Unheiligtum stehen, ragen nicht gerade zur Decke der Hoehle "
    "empor, sondern sind grotesk verformt und treffen sich in der Mitte "
    "ueber Dir, ohne die Sicht zur Hoehlendecke zu versperren. ");
  AddDetail( ({ "sicht" }),
      "Die Monolithen versperren Dir die Sicht nicht. Oder besser gesagt: "
      "Zumindest nicht die Sicht.");

  AddDetail( ({"ausdruck"}), 
      "'Geformt' trifft es wirklich gut. Sterbliche haben diese Kuppel "
      "sicherlich nicht geformt.");
  AddDetail( ({"hand"}),
    "Ein ungutes Gefuehl beschleicht Dich hier.");
  AddDetail( ({"gefuehl"}),
    "Bedrueckend ...");
  AddDetail( ({"sterblichen"}),
    "So wie Du einer bist.");
  AddDetail( ({"fugen"}),
    "Solche siehst Du nicht.");
  AddDetail( ({"geist"}), 
    "Das Pochen fuellt deinen Geist und laesst Dich an nicht anderes "
    "mehr als an dieses eine Pochen ... du hoerst es foermlich und "
    "spuerst es auch...");
  AddDetail( ({"lage"}), 
      "Ein perfides Meisterwerk! Du laechelst boese.");
  AddDetail( ({"meisterwerk", "werk"}), 
      "HarHar! Das ist es, Nekromant! Spuerst Du nicht das Boese!");
  AddDetail ( ({"boese"}), 
      "Herrlich! Es ist rund um Dich herum!");
  AddDetail( ({"faehigkeiten"}),
      "Ja, Nekromant, so eine Boshaftigkeit legst nicht einmal DU "
      "an den Tag!");
  AddDetail( ({"boshaftigkeit"}), 
      "Du kicherst irre.");
  AddDetail( ({"tag"}),
      "Das siehst Du hier nicht!");
  AddDetail( ({"maechte"}),
      "Was Du hier spuerst - dessen bist Du Dir sicher - ist das "
      "BOESE in seiner reinsten Form!");
  AddDetail( ({"form", "so"}), 
      "Wenn Du nur auch SO verderbt waerst!");
  AddDetail( ({"seele"}), 
      "HARHAR! So was hast DU nicht mehr! Wozu auch?");
  AddDetail(({"liste"}),
      "Du koenntest sie lesen ...");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Pochen laut in Deinen Ohren.");
  AddSound(({"pochen","ohren"}),
    "Du hoerst und spuerst das Pochen! Es fuellt Dich komplett aus!!");



  AddSmell( DEFAULT_SMELL,
    "Der Geruch von Blut liegt in der Luft!");

  AddSmell( ({ "blut", "luft", "geruch" }),
    "Blut! Irgendwie kommt Dir der Geruch verlockend vor ...");

  //AddRoomMessage( 
  //  ({""}),30,"func");

}

// gildenspezifische Long
string _query_int_long() {
   string txt;
   txt="Du verspuerst Angst. Du stehst inmitten von Yol'Ghurmak, dem "
     "Unheiligtum "
     "der Nekromanten. Vor Dir erhebt sich aus dem Boden eine Art Altar, "
     "der wie alles hier aus schwarzem Marmor besteht. Die blutroten Adern "
     "scheinen Richtung Altar immer dicker zu werden, sie scheinen foermlich "
     "zu pulsieren. Du spuerst, wie Dein eigenes Blut durch Deine Adern "
     "fliesst, wie Dein Herz sich unweigerlich dem Rhythmus der unzaehligen "
     "Adern im schwarzen Gestein anpasst. Das Pochen fuellt langsam "
     "Deinen kompletten Geist aus, so dass Du nicht in der Lage bist, klar "
     "zu denken. Neben dem Altar siehst Du eine Liste.";
   if(TP->QueryProp(P_GUILD)==GUILDNAME) {
     txt+=" Obwohl Du Deine Seele hier bereits geopfert hast, spuerst Du "
       "immer noch diese unterschwellige Angst. Die Maechte, die hier am "
       "Werk sind, uebersteigen Deine eigenen boesen Faehigkeiten bei weitem!";
   }
   return BS(txt+"\n"); 
}

// 2012-08-16 Gwenshara: Untote duerfen hier bitte rasten
mixed _query_norest()
{
  if(!objectp(TP))
    return 0;
 
  if(TP->QueryProp(P_GUILD) != "nekromanten")
    return "Narr. Hier zu rasten waere Dein Tod!\n";

  return 0;
}

