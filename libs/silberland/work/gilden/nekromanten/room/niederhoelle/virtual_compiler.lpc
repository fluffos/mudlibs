#include "../niederhoelle.h"
#include <v_compiler.h>

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM );
  SetProp(P_STD_OBJECT, ROOM"/ebene");
}


string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ( sscanf(file, "%s:%s", name, who) == 2 &&
       member(({"ebene","kuestennaehe","kueste"}),name) != -1 &&
       who == lower_case(who) )
  {
    SetProp(P_STD_OBJECT, ROOM"/"+name);
    return file;
  }
}


int CustomizeRoom(object pl)
{
  string name,file, who;
  int * way;
  int i;
  
  if ( sscanf(file_name(previous_object()),"%s:%s",file,who)!=2 )
    return 0;

  file=explode(file,"/")[<1];
  
  if ( !member(LANDSCAPE,file) )
    return 0;
  
  way = pl->QueryProp(P_LOWER_HELL);
  if (!pointerp(way))
  {  
    way = ({ 0, 0 });
    pl->SetProp(P_LOWER_HELL,way);
  }
  
  for ( i = 0; i < 4; i++ )
  {
    if ( LANDSCAPE[file,1][i] )
    {
      if ( way[i%2] == LANDSCAPE[file,0][i] ) 
        previous_object()->AddExit(DIRECTIONS[i],
                                   ([EX_DEST:ROOM+"/"+LANDSCAPE[file,1][i]+":"+who,
                                     EX_TESTFUNC:"GetDirection"]));
      else
         previous_object()->AddExit(DIRECTIONS[i],
                                    ([EX_DEST:ROOM"/"+file+":"+who,
                                      EX_TESTFUNC:"GetDirection"])); 
    }  
  }
  
  return 1;
}



