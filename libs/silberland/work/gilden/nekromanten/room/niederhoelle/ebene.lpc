#include "../niederhoelle.h"

inherit ROOM"/stdroom";

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:0,ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Inmitten der kahlen Ebene der Niederhoellen");
  SetProp (P_INT_LONG, 
    "Du stehst inmitten einer kahlen, dunklen, trostlosen Steinebene. "
    "So weit das Auge reicht erstreckt sich das flache, fast schwarze, "
    "steinige Land, keine Pflanze und kein Tier ist zu erkennen. Der "
    "Himmel ueber Dir, falls man es denn so nennen kann, ist fast "
    "schwarz, nur dann und wann zieht ein wabernder, dunkelgrauer "
    "Schimmer ueber ihn hinweg. Ein kalter Wind pfeift Dir um die Ohren, "
    "und dann und wann kannst Du in der Ferne ein unheimliches, dunkles "
    "Wetterleuchten erkennen, welches von einem fernen, grollenden und "
    "unheilverheissenden Donner begleitet wird.");
  SetProp(P_NO_TPORT,NO_TPORT);

  // DETAILS START
  AddDetail ( ({"sturm", "wind"}),
    "Ein eiskalter, pfeifender Wind, ja fast ein Sturm umtost Dich. Die "+
    "Kaelte dringt durch Deine Kleidung bis tief in Deine Knochen.");
  AddDetail ( ({"leuchten", "wetterleuchten"}),
    "Ein unheimliches, dunkles Wetterleuchten erhellt von Zeit zu Zeit den "+
    "fernen Horizont, begleitet von einem unheilverheissenden, grollenden "+
    "Donner. ");
  AddDetail ( ({"boden", "ebene", "land", 
                "steinboden", "steinebene"}),
    "Der Boden hier besteht aus dunklem, kahlen Stein, welcher sich "+
    "trostlos in allen Richtungen bis zum Horizont ausbreitet. Da und dort "+
    "liegen Felsbrocken oder anderes Geroell herum, doch keine Pflanze und "+
    "kein Tier scheint diese Ebene zu bewohnen.");
  AddDetail ( ({"pflanze", "pflanzen"}),
    "Du kannst keine einzige Pflanze weit und breit erkennen, nur die "+
    "steinige, trostlose Einoede.");
  AddDetail ( ({"tier", "tiere"}),
    "Nirgends ist auch nur ein einziges Tier zu erkennen.");
  AddDetail ( ({"fels", "felsgestein", "gestein", 
                "stein"}),
    "Alles hier ist aus dem gleichen, dunklen, kahlen Felsgestein.");
  AddDetail ( ({"himmel"}),
    "Der Himmel hier, falls Du es denn so nennen willst, ist von einer "+
    "gleichmaessigen, eintoenig schwarzen Farbe, die nur dann und wann von "+
    "einem wabernden, dunklen Grau durchzogen wird. Von dort oben scheint "+
    "kein Licht herabzufallen, doch dunkel ist es hier auch nicht. Das "+
    "Licht wirkt daher irgendwie unwirklich und fern, unbehaglich.");
  AddDetail ( ({"licht"}),
    "Das Licht scheint aus keiner bestimmten Quelle zu kommen, es wirkt "+
    "unwirklich und fern, unbehaglich.");
  AddDetail ( ({"lichtquelle", "quelle"}),
    "Du kannst keine Lichtquelle ausmachen.");
  AddDetail ( ({"schimmer"}),
    "Aehnlich wie Wolken zieht der wabernde, dunkelgraue Schimmer hin und "+
    "wieder ueber den schwarzen Himmel, doch was es ist, kannst Du nicht "+
    "erkennen.");
  AddDetail ( ({"wolken"}),
    "Nein, Wolken sind es nicht.");
  AddDetail ( ({"zeit"}),
    "Zeit scheint hier voellig bedeutungslos zu sein.");
  AddDetail ( ({"kaelte"}),
    "Es ist kalt hier, und der pfeifende Wind verstaerkt die Kaelte noch "+
    "und laesst sie durch Deine Kleidung bis tief in Deine Knochen dringen.");
  AddDetail ( ({"horizont"}),
    "Bis zum fernen Horizont erstreckt sich die steinige Einoede. Dort "+
    "kannst Du am Himmel von Zeit zu Zeit ein unheimliches, dunkles "+
    "Wetterleicheten erkennen.");
  AddDetail ( ({"brocken", "felsbrocken", "geroell"}),
    "Geroell und vereinzelte Felsbrocken liegen ueberall in der Ebene "+
    "herum.");
  AddDetail ( ({"ferne", "kilometer"}),
    "Bis zum Horizont koennten es genausogut 10 wie 100 Kilometer sein, "+
    "dass kannst Du durch das seltsame Licht absolut nicht schaetzen.");
  AddDetail ( ({"farbe"}),
    "Schwarz ist die Farbe des Himmels.");
  AddDetail ( ({"donner"}),
    "Sehen kannst Du den Donner nicht.");
  AddDetail ( ({"einoede", "oede"}),
    "Die trostlose Einoede erstreckt sich in alle Richtungen bis zum "+
    "Horizont.");
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  // ITEMS END
}

init()
{
  
  if (file_name()==ROOM"/ebene")
    TP->move(ROOM"/ebene:"+getuid(TP),M_TPORT|M_NOCHECK|M_SILENT);
  ::init();
}
