#include <properties.h>
#include <moving.h>
#include "../niederhoelle.h"                                                                                    

inherit ROOM"/stdroom";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:2]));
  SetProp (P_INT_SHORT, "An einer eisigen Kueste in den Niederhoellen");
  SetProp (P_INT_LONG,
    "Du stehst hier an einer eisigen, windumtosten Felsenkueste. Nach "+
    "Norden hin breitet sich, so weit das Auge reicht, das aufgewuehlte "+
    "Meer. Riesige Wellenkaemme werden Welle um Welle vom Wind gegen die "+
    "felsige Steilkueste gedraengt. Nach Sueden hin erstreckt sich "+
    "hingegen eine steinige, kahle, ebene Einoede. Ueber Dir erstreckt "+
    "sich der schwarze Himmel, der nur dann und wann von einem "+
    "dunkelgrauen, wabernden Schimmer durchzogen wird, der sich im "+
    "Norden, ueber dem Meer zu verdichten scheint.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sturm", "wind"}),
    "Ein eisiger Wind, ja fast ein Sturm fegt vom Norden her, vom offenen "+
    "Meer, treibt die hohen Wellenkaemme gegen die Steilkueste und weht "+
    "dann nach Sueden hin ueber die Einoede ins Landesinnere.");
  AddDetail ( ({"welle", "wellen", "wellenkaemme", 
                "wellenkamm"}),
    "Der eisige Wind treibt hohe Wellen und Wellenkaemme vom offenen Meer "+
    "gegen die felsige Steilkueste, wo sie von lautem Krachen begleitet "+
    "brechen und schaeumende Wirbel bilden.");
  AddDetail ( ({"wirbel"}),
    "Schaeumende Wirbel bilden die hohen Wellen, wenn sie sich an der "+
    "Steilkueste brechen.");
  AddDetail ( ({"felsenkueste", "kueste", "steilkueste"}),
    "Die felsige Steilkueste faellt gleich vor Dir nach Norden hin fast 50 "+
    "Meter bis zum Meer hinab, wo sich die grossen Wellen brechen. Sie "+
    "erstreckt sich so weit Du blicken kannst in einer unregelmaessigen "+
    "Linie von Ost nach West.");
  AddDetail ( ({"schimmer"}),
    "Ueber den schwarzen Himmel ziehen immer wieder wabernde, dunkelgraue "+
    "Schimmer, die sich im Norden ueber dem Meer zu verdichten scheinen.");
  AddDetail ( ({"meer"}),
    "Dunkel und vom eisigen Wind aufgewuehlt erstreckt sich das Meer so "+
    "weit das Auge reicht nach Norden. Hohe Wellenkaemme werden vom Wind "+
    "gegen die Steilkueste gedraengt, wo sie sich brechen.");
  AddDetail ( ({"ebene", "einoede", "inneres", 
                "landesinneres"}),
    "Nach Sueden, ins Landesinnere erstreckt sich die felsige, ebene "+
    "Einoede bis zum Horizont, wo hin und wieder ein unheimliches Blitzen "+
    "den sonst schwarzen Himmel. ");
  AddDetail ( ({"krachen"}),
    "Sehen kann man das Krachen der Wellen nicht.");
  AddDetail ( ({"himmel"}),
    "Schwarz und unheimlich erstreckt sich der Himmel bis zum Horizont, "+
    "nur ab und an von einem wabernden, dunkelgrauen Schimmern durchzogen, "+
    "das sich im Norden ueber dem Meer zu verdichten scheint. Im Sueden "+
    "erhellt dann und wann ein Blitzen den Horizont.");
  AddDetail ( ({"blitzen", "horizont"}),
    "Hin und wieder erhellt ein unheimliches Blitzen den Horizont im "+
    "Sueden, ueber der steinigen Einoede, gefolgt von einem fernen Donnern, "+
    "welches hier schnell vom Krachen der brechenden Wellen uebertoent "+
    "wird.");
  AddDetail ( ({"donnern"}),
    "Das Donnern kannst Du nicht sehen.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus dunklem Felsgestein, welches sich nach Sueden "+
    "hin weit bis zum Horizont in einer duesteren Einoede erstreckt und im "+
    "Norden gleich vor Dir steil zum Wasser hinunter abfaellt.");
  AddDetail ( ({"fels", "felsen", "felsgestein", 
                "gestein"}),
    "Die gesamte Einoede scheint aus dem gleichen, dunklen Felsgestein zu "+
    "bestehen.");
  AddDetail ( ({"meereswasser", "wasser"}),
    "Das Meereswasser ist dunkel und aufgewuehlt.");
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  // ITEMS END
}
