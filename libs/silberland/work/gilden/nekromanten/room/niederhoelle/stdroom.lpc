#include "../niederhoelle.h"

inherit "/std/room";

int GetDirection(string dir)
{
  mixed * way;
  int idir;
  
  way = this_player()->QueryProp(P_LOWER_HELL);

  idir = member(DIRECTIONS,dir);
  if (idir<2)
    way[idir%2]++;
  else
    way[idir%2]--;

  return 1;
} 

init()
{
  ::init();

  V_COMPILER->CustomizeRoom(this_player());
}
