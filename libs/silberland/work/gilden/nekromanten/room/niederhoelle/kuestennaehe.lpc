#include <properties.h>
#include <moving.h>
#include "../niederhoelle.h"                                                                                    

inherit ROOM"/stdroom";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:1]));
  SetProp (P_INT_SHORT, "Inmitten einer trostlosen Ebene der Niederhoellen");
  SetProp (P_INT_LONG,
    "Du stehst inmitten einer kahlen, dunklen Einoede. Bis zum Horizont "+
    "erstreckt sich die flache, steinige Einoede, nur hier und dort "+
    "liegen einige Felsbrocken und Steine herum. Nur im Norden kannst Du "+
    "eine schmale Linie erkennen, hinter der das Meer zu beginnen "+
    "scheint. Ein kalter Wind fegt von dort her ueber die Ebene. Der "+
    "Himmel ist schwarz, nur dann und wann zieht ein wabernder, "+
    "dunkelgrauer Schimmer ueber ihn hinweg. Hin und wieder wird er von "+
    "einem grellen Blitzen erhellt, gefolgt von einem unheilverheissenden "+
    "Donner.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"wind","sturm"}),
    "Ein kalter Wind, ja fast ein Sturm weht vom Norden, vom Meer her "+
    "ueber die Ebene.");
  AddDetail ( ({"grenze", "linie", "meer"}),
    "Im Norden bildet eine Linie die Grenze zwischen der steinigen Einoede "+
    "und dem Meer.");
  AddDetail ( ({"brocken", "fels", "felsbrocken", 
                "felsen", "stein", "steine"}),
    "Vereinzelte Steine und Felsbrocken liegen ueberall in der kahlen "+
    "Einoede herum.");
  AddDetail ( ({"schimmer"}),
    "Ein dunkelgrauer, wabernder Schimmer zieht dann und wann ueber den "+
    "schwarzen Himmel hinweg.");
  AddDetail ( ({"horizont"}),
    "Bis zum Horizont erstreckt sich die kahle, steinige Einoede. Nur im "+
    "Norden isteine schmale Linie zu erkennen, hinter der das Meer beginnt.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist hier unheilbringend schwarz, nur hin und wieder zieht "+
    "ein wabernder, dunkelgrauer Schimmer ueber ihn hinweg.");
  AddDetail ( ({"ebene", "einoede"}),
    "Die kahle, felsige Einoede erstreckt sich bis zum Horizont, nur im "+
    "Norden endet sie an einer schmalen Linie, hinter der das Meer beginnt. "
    "Pflanzen oder Tiere kannst Du nirgends erkennen.");
  AddDetail ( ({"pflanzen"}),
    "Nirgends in der kahlen Einoede kannst Du auch nur eine einzige "+
    "Pflanze erkennen.");
  AddDetail ( ({"tier", "tiere"}),
    "Nirgends hier scheint es Tiere zu geben.");
  AddDetail ( ({"donner"}),
    "Den Donner kannst Du nicht sehen.");
  AddDetail ( ({"boden"}),
    "Der Boden hier ist steinig und voellig kahl.");
  AddDetail ( ({"blitzen"}),
    "Hin und wieder erhellt ein grelles Blitzen den sonst schwarzen "+
    "Himmel.");
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  // ITEMS END
}
