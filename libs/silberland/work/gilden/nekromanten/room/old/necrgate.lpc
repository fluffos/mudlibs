/* Eingang zum Necromanten-Friedhof von Banshee  */
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include "necrodefs.h"
int geweckt=0;

create()
{
	::create();

        SetProp( P_INT_SHORT, "Tor zum Friedhof" );
	SetProp( P_INT_LONG,
                "Du stehst unter einem Torbogen, der den Friedhof im Osten "
                "von der Unterwelt im Westen trennt. Er wird zum "
                "groessten Teil von dicken Nebelschwaden verdeckt, so dass Du "
                "kaum etwas erkennen kannst."
	);
        SetProp( P_LIGHT, 0 );
	SetProp( P_INDOORS, 0 );

        AddDetail( "boden",
                "Der Boden wird in Richtung Friedhof immer matschiger, im "
                "Gegensatz zur Unterwelt, wo er relativ steinig ist."
        );
        AddDetail( "richtung",
                "Der Friedhof befindet sich oestlich von hier, die Unterwelt "
                "westlich."
        );
        AddDetail( "unterwelt",
                "Die grausame Unterwelt endet hier. Was Dich hier wohl erwartet?"
        );
        AddDetail( "gegensatz",
                "Der Gegensatz steinig - matschig ist hier gemeint."
        );
        AddDetail( "decke",
                "Eine Decke kannst Du hier nicht erkennen, da es zu dunkel ist. "
                "Du glaubst aber ein paar kleine funkelnde Punkte ueber Dir sehen "
                "zu koennen."
        );
        AddDetail( "punkte",
                "Die meisten sind rot, manche gelb. Sie bewegen sich nicht, aber "
                "manchmal scheinen sie groesser zu werden und blitzen dann auf."
        );
        AddDetail( ({"torbogen", "tor"}),
                "Unter dem eisernen Torbogen haengen ein paar Fledermaeuse, "
                "die offensichtlich schlafen. Der Torbogen ist der einzige Weg "
                "den Friedhof zu betreten oder zu verlassen."
	);
        AddDetail( "fledermaeuse",
                "Du solltest Dich besser leise verhalten, sonst weckst Du die "
                "Fledermaeuse noch auf. Sie sehen gefaehrlich aus. "
        );      
        AddDetail( "weg",
                "Der Friedhof wird von einem Gitter aus Eisenstangen begrenzt, "
                "wodurch er wie ein Gefaengnis aussieht. Das Tor unter dem Du "
                "stehst ist der einzige sichtbare Weg rein oder raus."
        );
        AddDetail( "gitter",
                "Das Gitter sehen so aus, als wenn sie umfallen wuerden, wenn "
                "Du Dich gegen sie lehnen wuerdest."
        );
        AddDetail( ({"stangen", "eisenstangen"}),
                "Die Stangen sind alt und verrostet."
        );
        AddDetail( "gefaengnis",
                "Hoffentlich wird er nicht zu Deinem Gefaengnis."
        );
        AddDetail( ({"friedhof","anblick"}),
                "Beim Anblick des Friedhofs wird Dir richtig unheimlich zumute. "
                "Durch den Nebel kannst Du nur vereinzelt ein paar alte Baeume "
                "oder Graeber erkennen. Hoffentlich ist dort sonst nichts."
                );
        AddDetail( ({"etwas", "irgendwas"}),
                "Vielleicht Magie?"
        );
        AddDetail( "magie",
                "Die Magie scheint nicht direkt von hier zu kommen. Vielleicht "
                "findest Du auf dem Friedhof irgendwas interessantes."
        );
        AddDetail( ({"nebel", "nebelschwaden", "schwaden", "teil"}),
                "Die Nebelschwaden schweben langsam ueber den Friedhof. Du "
                "glaubst ein paar Schemen von irgendwelchen Kreaturen erkennen "
                "zu koennen."
        );
        AddDetail( "schemen",
                "Du kannst zum Glueck nur Schemen erkennen. "
        );
        AddDetail( "glueck",
                "Wenn Du wuesstest, was Dich dort erwartet, wuerdest Du panisch "
                "fluechten."
        );
        AddDetail( ({"kreaturen", "zombies", "skelette", "ghouls", "banshees", "vampire", "werwoelfe"}),
                "Zombies, Skelette, Ghouls, Banshees, Vampire, Werwoelfe, Du "
                "hast nicht die leiseste Ahnung. "
        );
        AddDetail( ({"baeume", "haende"}),
                "Die Baeume sehen wie in Verzweiflung verkrampfte Haende aus."
        );
        AddDetail( "verzweiflung",
                "Du fragst Dich wegen was man hier verzweifeln koennte."
        );
        AddDetail( "graeber",
                "Wenn Du die Graeber genauer untersuchen moechtest, musst Du "
                "schon den Friedhof betreten."
        );
        AddSound(DEFAULT_SOUND,"Du hoerst ein leises Rauschen.");
        AddSmell(DEFAULT_SMELL,"Es riecht nach abgestandener Luft.");
        AddSmell("luft","Hier unten scheint die Luft geradezu stillzustehen.");
        AddCmd( ({"sag","sage","frage","schreie","schrei", "sing","singe", "frag", "kreisch"}), "BATS");
        AddCmd( "lehne", "lehne_gitter");
        AddExit( "westen", "players/gott/Unterwelt....");
        AddExit( "osten", ROOM("cemetary"));
}

lehne_gitter( str )
{
        notify_fail( "Wo willst Du Dich denn gegenlehnen?\n" );
        if ( str == "gegen gitter" )
	{
                write( "Du lehnst Dich gegen das Gitter, aber es haelt stand. Selbst als Du gegen es "
                       "es schlaegst passiert nichts. Irgendwas muss diese Gitter halten...\n"
                       );
                return 1; 
	}
	return 0;
}
int BATS(string str )
{
	int i;
	object ob;
  if (!geweckt)
	{
    write(BS( "Die Fledermaeuse wachen auf, und greifen Dich mich boesartig funkelnden Augen\n"
               "an."));
    for (i=0;i<random(5)+5;i++)
    {
    	 ob=CLONEOB(ROOM("players/gott/changed/banshee/necrobat.lpc"));
    	 ob->move(TO,2);
    	 ob->Attack(TP);
    }
    geweckt=1;
    return 1;
  }
}

           
reset()
{
	geweckt=0;
	::reset();
}