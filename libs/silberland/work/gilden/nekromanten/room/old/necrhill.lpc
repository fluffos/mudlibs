/* Graeberhuegel auf Necromanten-Friedhof von Banshee  */
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moredef.h>

create()
{
	::create();

        SetProp( P_INT_SHORT, "Auf einem Graebernhuegel" );
	SetProp( P_INT_LONG,
                "Du befindest Dich jetzt auf einem Graeberhuegel, der nicht "
                "umsonst so heisst. Um Dich herum siehst Du massenweise Grabsteine, "
                "von denen die meisten umgefallen sind. Ein paar groessere "
                "Grabmaeler kannst Du auch erkennen. Suedlich unter dem Huegel "
                "liegt der von Nebeln verhuellte Friedhof, im Norden kannst Du "
                "ausser einer Nebelwand nichts erkennen."
	);
        SetProp( P_LIGHT, 0 );
	SetProp( P_INDOORS, 0 );

        AddDetail( "boden",
                "Du stehst auf relativ weichen, matschigen Mutterboden."
        );
        AddDetail( "mutterboden",
                "Wahrscheinlich ist er durch die feuchte Luft so matschig."
        );
        AddDetail( "luft",
                "Richtig stickig ist es hier."
        );
        AddDetail( ({"friedhof","nebel"}),
                "Der Friedhof der sich suedlich von Dir ausbreitet wird fast "
                "vollstaendig von Nebeln verdeckt."
        );
        AddDetail( ({"wand","nebelwand"}),
                "Durch die Nebelwand kannst Du wirklich ueberhaupt nichts "
                "erkennen. Sie wirkt wie eine massive Mauer, so dick ist der "
                "Nebel dort. "
        );
        AddDetail( "mauer",
                "Wahrscheinlich wird die Nebelwand durch Magie aufrecht erhalten."
        );
        AddDetail( "magie",
                "Die Nebelwand ist einfach zu dick, als dass sie natuerlich sein "
                "koennte."
        );
        AddDetail( "grabmaeler",
                "Die meisten groesseren Grabmaeler werden noch von einer Statue "
                "geschmueckt. Ein Grabmal faellt Dir besonders auf."
        );
        AddDetail( ({"statue","statuen"}),
                "Die Statuen stellen die verstorbenen Personen dar."
        );
        AddDetail( "personen",
                "Nur besonders bedeutende Personen kriegen solche grossen Grabmaeler. "
        );
        AddDetail( "grabmal",
                "Dieses Grabmal ist bei weitem das praechtigste. Es ist knapp "
                "drei Meter hoch, und das dargestellte Wesen sieht, obwohl es "
                "verwittert ist, beeindruckend aus."
        );
        AddDetail( "wesen",
                "Du hast sowas noch nie zuvor gesehen. Es sieht vom Koerperbau "
                "einem Oger aehnlich, allerdings hat es einen Stierkopf."
        );
        AddDetail( "koerperbau",
                "Der Koerperbau des Wesens aehnelt dem eines kleineren Ogers."
        );
        AddDetail( "oger",
                "Du wirst ja wohl wissen, was ein Oger ist."
        );
        AddDetail( ({"stierkopf","kopf"}),
                "Du fragst Dich, welche Wesen einen Stierkopf haben."
        );
        AddDetail( "minotauros",
                "Ja, es scheint sich um einen Minotauros zu handeln, Du solltest "
                "Dich besser vor seinem Zorn huetten. Er sieht wirklich "
                "furchteinfloessend aus."
        );
        AddDetail( ({"zorn","beispiel"}),
                "Du solltest zum Beispiel nicht seinen Frieden stoeren."
        );
        AddDetail( "frieden",
                "Den koenntest Du stoeren, indem Du seine Knochen ausgraebst."
        );
        AddDetail( "knochen",
                "Die sind wahrscheinlich hier vergraben."
        );
        AddDetail( ({"huegel" , "graeberhuegel"}),
                "Auf dem Graeberhuegel liegen massenweise Grabsteine rum."
        );
        AddDetail( ({"graeber", "ruhestaetten"}),
                "Diese Graeber sind die Ruhestaette vieler beruehmter Abenteurer.\n"
        );
        AddDetail( "ruhestaette",
                "Du solltest ihre Ruhe nicht stoeren."
        );
        AddDetail( "ruhe",
                "Die koenntest Du stoeren, indem Du ihre Knochen ausgraebst."
        );
        AddDetail( "grabsteine",
                "Die Inschriften auf dem meisten Grabsteinen sind schon bis zur "
                "Unkenntlichkeit verwittert. Auf manchen kannst Du aber noch ein "
                "paar Woerter entziffern."
        );
        AddDetail( "unkenntlichkeit",
                "Dort kannst Du wirklich nichts mehr entziffern."
        );
        AddDetail( ({"inschrift", "woerter", "inschriften"}),
                "Bei drei Inschriften kannst Du noch etwas entziffern."
        );
        AddReadDetail( "inschrift 1",
                " R NA\n" //KRONANG; MOEGE ER IN FRIEDEN RUHEN ;)
                "MOE E ER  N FR E EN  UH N" 
        );
        AddReadDetail( "inschrift 2",
                "HIER RUHT DER NAMENLOSE KRIEGER\n"
                "SEINE LETZTEN WORTE WAREN:\n"
                "'WAS IST DASN FUER N SPEER?'"
        );
        AddReadDetail( "inschrift 3",
                " AN  E : IN G  AN E  B I  AM R \n"
                "       R.      I.      P."
        );
		AddSound(DEFAULT_SOUND,"Hier oben hoerst Du den Wind leise wehen.");
		AddSound("wind", "Der Wind scheint nach Norden zu wehen.");
        AddSmell(DEFAULT_SMELL,"Es ist hier ein wenig feucht, und das Atmen faellt Dir schwer.");
        
        AddCmd("oeffne", "machdensargauf");
        AddCmd("grabe", "spooky_isnt_it");
        AddExit( "norden", "players/gott/crypt.lpc");
        AddExit( "sueden", "players/gott/cemetary.lpc");
}

spooky_isnt_it( str )
{
        //hier sollte ueberprueft werden, ob der Spieler auch ne Schaufel hat
        notify_fail( "Wo willst Du denn graben?" );
        if( str == "grab 2" || str == "in grab 2" || str == "auf grab 2" || str == "bei grab 2")
        {
                write( "Du graebst bei dem Grab des namenlosen Kriegers. Nach einer gewissen Zeit\n"
                       "hast Du seinen Sarg freigelegt.\n");
                say(    this_player()->name(WER,2)+" buddelt ein Loch.\n");
                AddDetail( "sarg",
                        "Ein normaler Holzsarg, auf dem zwei gekreuzte Speere eingraviert sind."  );
				AddDetail( ({"eindruck","speere"}),
						"Die Speere machen irgendwie einen unheimlichen Eindruck auf Dich." );
                return 1;
        }
        notify_fail( "Wo willst Du denn graben?" );
		if( str == "grabmal" || str == "bei grabmal" )
        {
                write( "Du graebst vor dem Grabmal des Minotaurus, findest aber nichts. Seine Knochen\n"
                       "muessen irgendwo anders vergraben sein.\n");
                return 1;
        }
        return 0;
}
machdensargauf( str )
{
        notify_fail( "Was willst Du denn oeffnen?" );
        if ( str == "sarg" )
        {
                // Überprüfung, ob Stärke des Spielers größer ist als 21
		write( "Du oeffnest den Sarg des namenlosen Kriegers und siehst dort seine Knochen,\n"
                       " wie sie sich langsam erheben, und Gestalt annehmen.\n");
        		{
					object ob;	//hat bei Impulz komischerweise gefunzt, bei mir net
					ob=CLONEOB(ROOM("necfighter"));
	    	 		ob->move(TO,2);
    		 		ob->Attack(TP);
				}
    			say( "Der namenlose Krieger bruellt: WER MEINE EWIGE RUHE STOERT MUSS STERBEN!\n");
                say( "Der namenlose Krieger attackiert Dich.\n");
                return 1;
        }
        return 0;
}

