/* Necromanten-Friedhof von Banshee */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moredef.h>



create()
{
  ::create();
  SetProp( P_INT_SHORT, "Auf einem Friedhof" );
  SetProp( P_INT_LONG,
    "Du stehst mitten auf einem Friedhof, der von einem "
    "Eisengitter auf allen Seiten begrenzt wird. Im Norden "
    "kannst du einen Huegel auf dem mehrere Graeber sind erkennen. "
    "Um Dich herum stehen mehrere alte verkrueppelte Baeume.");
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );

  AddDetail( ({ "finsternis" }), 
                break_string( "Ueber Dir kannst Du nichts ausser absoluter "+
                "Finsternis sehen.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Eine Decke kannst Du nicht erkennen, nur "+
                "endlose Finsternis.", 78 ) );
        AddDetail("seiten",
                "Ausser durch den Eingang im Westen, durch den Du gekommen "
                "bist, scheinst Du den Friedhof nicht verlassen zu koennen."
        );
        AddDetail(({"eingang","tor"}),
                "Im Westen ist das Tor, durch den Du den Friedhof betreten "
                "hast."
        );
        AddDetail(({"huegel","norden","graeber"}),
                "Die Grabsteine der Graeber auf den Huegeln im Norden sind "
                "alle schief oder umgefallen."
        );
        AddDetail("umgebung",
                "Du befindest Dich auf einem unheimlichen Friedhof."
        );
        AddDetail("grabsteine",
                "Vor jedem Grab steht ein meist kreuzfoermiger Grabstein."
        );
        AddDetail("baeume",
                "Die Baeume, die Dich umgeben, haben bis auf einen alle keine "
                "Blaetter mehr, und sind alle alt und vertrocknet."
        );
        AddDetail("baum",
                "Der Baum leuchtet in einem seltsamen Licht, das "
                "Deine Umgebung gespenstisches blaues Licht huellt. Du bist "
                "Dir nicht sicher, ob das Licht von den Blaettern des Baums "
                "oder von seinen Wurzeln ausgeht."
        );
        AddDetail("blaetter", 
                "Als Du die Blaetter genauer betrachtest, erkennst Du, dass sie "
                "gar nicht selber leuchten. Sie spiegeln das Licht nur wieder."
        );
        AddDetail("wurzeln",
                "Die Wurzeln scheinen durch irgendwas im Erdreich zum leuchten "
                "gebracht zu werden."
        );
        AddDetail("erdreich",
                "Das Erdreich wird vom Laub, das hier am "
                "Boden liegt bedeckt."
        );
        AddDetail("erde",
                "Du ueberlegst, was sich wohl unter ihr befindet."
        );
        AddDetail("friedhof",
                "In dem blaeulichen Licht wird Dir auf dem Friedhof richtig "
                "unheimlich."
        );
        AddDetail("licht",
                "Das Licht scheint von einem der Baeume auszugehn."
        );
        AddDetail(({"eisengitter","gitter","zaun"}),
                "Die Zaun aus Eisenstangen, der den Friedhof begrenzt, sieht "
                "relativ solide aus."
        );
        AddDetail(({"stangen", "eisenstangen"}),
                "Als Du die Stangen aus der Naehe betrachtest, kannst Du doch "
                "etliche verbogene Enden und Loecher erkennen. Hinter den Gittern "
                "wird es vollkommen dunkel, Du kannst dort rein gar nichts sehen."
        );
        AddDetail("enden",
                "Die verbogenen Enden sind ziemlich scharfkantig und rostig. "
                "Pass besser auf, dass Du Dich nicht schneidest."
        );
        AddDetail("loecher",
                "Durch die Loecher im Zaun kannst du aufgrund der Dunkelheit "
                "nichts genaues erkennen."
        );
        AddDetail("laub",  
                "Das Laub am Boden ist seltsam dunkel, als ob es "
                "nie gelebt hat. Du erkennst eine kleine Erhebung unter dem Laub."
        );
        AddDetail("dunkelheit",
                "Die Dunkelheit wirkt bedrueckend auf Dich."
        );

        AddDetail("boden",
                "Der Boden ist mit Laub bedeckt."
        );
        AddDetail("erhebung",
                "Vielleicht koennte man die Blaetter irgendwie beiseite raeumen."
        );
        AddDetail(({"waende", "freien"}),
                "Im Freien gibt es keine Waende."
        );
        AddDetail("kaelte",
                "Je naeher Du der schwarzen Rose kommst, desto kaelter wird die Luft."
        );
        AddDetail("luft",
                "Um die Rose herum scheint die Luft fast zu gefrieren. Beruehren "
                "solltest Du sie besser nicht."
        );

 		AddCmd( "beruehre", "touch_rose" );
        AddCmd( ({ "raeume", "scharre"}), "blaetter_weg" );
        AddCmd( ({ "grabe", "buddel"}), "buddel_me_away" );
        AddExit( "norden", "players/gott/graeber1.lpc" );
        AddExit( "westen", "players/gott/necrgate.lpc" );

}

blaetter_weg( str )
{
        notify_fail( "Was willst Du denn wegraeumen?\n" );
        if( str == "blaetter weg"|| str == "unter blaettern" )
	{
                write( "Als Du unter den Blaettern scharrst, legst Du das Erdreich frei,"
                        "indem sich eine kleine Mulde befindet.\n" );
                say(    this_player()->name(WER,2)+" scharrt am Boden.\n");
				AddDetail("mulde",
                	"Am Boden der Mulde scheint die Erde ein bisschen heller "
                	"zu sein." );        
                return 1;
	}
        return 0;
}
buddel_me_away( str )
{
        notify_fail( "Wodrin will Du denn buddeln?\n" );
        if( str == "in erde"|| str =="in erdreich" )
        {
                write( "Als Du tiefer in der Mulde graebst, findest Du eine einsame schwarze Rose.\n" );
                say(    this_player()->name(WER,2)+" macht irgendwas am Boden.\n");
                AddDetail("rose",
                "Die Rose erstrahlt in einem weisslich blauen Licht. Von ihr "
                "scheint eine gewisse Kaelte auszugehen.");
                return 1;
        }
        return 0;
}
touch_rose( str )
{
        notify_fail( "Was willst Du denn beruehren?\n" );
        if ( str == "rose" )
        {
                write(BS("Die Rose ist kaelter als Eis. Als Du sie beruehrst, kriecht "
                        "ein kalter Schmerz deinen Arm hoch."));
                TP->AddHp(-35);
                return 1;
        }
        return 0;
}


