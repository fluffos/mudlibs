int bei_oder_aus_treten(string str) {
  return 0;
}

string Funktion()
{
  return ("Dir stehen hier folgende Moeglichkeiten zur Verfuegung:\n"
		  "- liste [[nicht] geloest]\n"
		  "- erhoehe [stufe]\n"
		  "- kosten\n"
		  "- lerne <zauberspruch>\n"
		  "- wandle <attribut> in <attribut>\n" +
                  (IS_WIZARD(this_player()) ? "- oben (Magiertreff)\n" : "")
                  );
}

string Schmutz()
{
  // hier sollte sich doch glatt ein Zaubertrank lohnen!!
  if (this_player()->FindPotion(
      "Du popelst mit dem Fingernagel in der Fuge rum und brichst ihn Dir\n"+
      "dabei ab. Was war das? Du findest ein winziges Flaeschchen, das Du\n"+
      "mit einem Schluck austrinkst.\n"))
    return "";
  else
    return "In den Fugen befindet sich viel Schmutz.\n";
}

int GotoMagierTreff()
{
  if(IS_WIZARD(this_player()))
  {
    write("Ein Zauberspruch zieht vor Deinem geistigen Auge vorbei und Du\n"
	  +"sprichst ihn nach.\n");
    say(PL->name()+" murmelt einen geheimen Zauberspruch und schwebt langsam\n"
	+"zur Decke hinauf und verschwindet durch die Wand.\n");
    write("Du schwebst langsam zur Decke hinauf und als ob diese nicht da\n"
	  +"waere mitten hindurch in den Magiertreff.\n");
    return (PL->move("/secure/merlin", M_TPORT | M_SILENT ) >= 0);
  }
  write("Du springst zur Decke hinauf und nix passiert.\n");
  return 1;
}

void adjust_title(object pl) {
  int lv;

  if (!pl || !IsGuildMember(pl))
    return;
  lv=pl->QueryProp(P_LEVEL);
  pl->SetProp(P_GUILD_LEVEL,lv);
  if (!lv) lv=1;
  pl->SetProp(P_GUILD_TITLE,get_new_title(lv, pl));
}

int GuildRating(object pl)
{
  mapping ski;
  string *sk;
  int i, cnt, sum;
  closure qsa;

  if (!IsGuildMember(pl)||!query_once_interactive(pl))
    return 0;

  if (!(ski = QueryProp(P_GUILD_SKILLS)) ||
      !(qsa = symbol_function("QuerySkillAbility",pl)))
    return 0;

  sk = m_indices(ski);
  cnt = sizeof(ski);

  for (i=cnt-1, sum=0; i>=0; i--)
    sum += funcall(qsa, sk[i]);

  sum = sum/16; // man kann nur 16 der zauber lernen
  if (sum < 0)
    sum = 0;
  else if (sum > MAX_ABILITY)
    sum = MAX_ABILITY;

  return pl->SetProp(P_GUILD_RATING, sum);
}

int MaxGuildRating()
{
  return 10000;
}

public int spell_sort(mixed *a, mixed *b) {
  return a[0] > b[0];
}

OwnLearnSpell(string str)
{
    mapping spells;
    string *spell_names;
    string race;
    int level, i, num_spells;
    string spell_name, *include_race, *exclude_race, racereq;
    mapping spell_data, learn_restrictions;
    int required_level, race_ok;
    mixed *sorted_spells;

    // Spielerinformationen
    race = capitalize(this_player()->QueryProp(P_RACE));
    level = this_player()->QueryProp(P_LEVEL);

    // Zaubersprüche abrufen
    spells = "/spellbooks/ab_spells"->QueryProp(P_SB_SPELLS);

    if (!mappingp(spells) || !sizeof(spells))
    {
        write("Es sind keine Zauber verfügbar.\n");
        return 1;
    }

    if (!str)
    {
        // Zauberliste vorbereiten
        spell_names = m_indices(spells);
        num_spells = sizeof(spell_names);
        sorted_spells = allocate(num_spells);

        // Zauberdaten mit Stufe kombinieren
        for (i = 0; i < num_spells; i++)
        {
            spell_name = spell_names[i];
            spell_data = spells[spell_name];
            learn_restrictions = spell_data[SI_SKILLRESTR_LEARN] || ([]);
            required_level = learn_restrictions[P_LEVEL] || 0;

            sorted_spells[i] = ({ required_level, spell_name });
        }

        // Sortieren nach Stufe
        sorted_spells = sort_array(sorted_spells, "spell_sort");

        // Ausgabe der Zaubersprüche
        write("Du kannst versuchen, folgende Zauber zu lernen:\n");

        for (i = 0; i < num_spells; i++)
        {
            required_level = sorted_spells[i][0];
            spell_name = sorted_spells[i][1];
            spell_data = spells[spell_name];
            learn_restrictions = spell_data[SI_SKILLRESTR_LEARN] || ([]);

            include_race = learn_restrictions[SR_INCLUDE_RACE];
            exclude_race = learn_restrictions[SR_EXCLUDE_RACE];
            racereq = learn_restrictions[P_RACE];
            race_ok = 1;

            // Rassenbeschränkungen prüfen
            if (pointerp(include_race) && member_array(race, include_race) == -1)
                race_ok = 0;
            if (pointerp(exclude_race) && member_array(race, exclude_race) != -1)
                race_ok = 0;
            if(stringp(racereq) && lower_case(race) != lower_case(racereq))
                race_ok = 0;

            // Nur anzeigen, was der Spieler lernen kann
            if (race_ok)
            {
                write(sprintf("        %-15s ab Stufe %2d\n", spell_name, required_level));
            }
        }

        write("\n");
        return 1;
    }

    if(str == "kaempfen") {
      if(this_player()->QueryProp(P_LEVEL) < 30) {
        write(BS("Um das Kaempfen zu lernen musst du mindestens Stufe 30 sein."));
        return 1;
      }
      
      if(!this_player()->QuerySkill(SK_FIGHT)) {
        this_player()->ModifySkill(FIGHT(SK_FIGHT), QuerySkill(SK_FIGHT), 0, "abenteurer");
        write("Du erlernst das Kaempfen.\n");
      } else write("Das beherrschst Du schon!\n");
      return 1;
    }

    return ::LearnSpell(str);
}

#define RACIAL_WEAPONS ([ \
  "Fee":WT_KNIFE, \
  "Gaffo":WT_SPEAR, \
  "Troll":WT_CLUB, \
  "Oger":WT_CLUB, \
  "Mensch":WT_SWORD, \
  "Elf":WT_BOW, \
  "Zwerg":WT_AXE, \
  "Hobbit":WT_KNIFE \
])
mapping Kaempfen(object user, string skill, mapping sinfo)
{
  int bonus, ut, val, abil, dam_old;
  object enemy, weapon;

  
  if(user->QueryProp(P_TESTPLAYER))
  {
    dam_old = sinfo[SI_SKILLDAMAGE];
  }
  
  ut    = sinfo[SI_USR];
  abil  = sinfo[SI_SKILLABILITY];
  val   = (2 * user->QueryAttribute(A_STR) + user->QueryAttribute(A_DEX) +
          user->QueryProp(P_LEVEL)) * abil/MAX_ABILITY;
  
  // Bonus berechnen
  bonus = random(val);
  bonus = (bonus>150&&interactive(user)?200:bonus);
  if(objectp(weapon=user->QueryProp(P_WEAPON)) && weapon->QueryProp(P_WEAPON_TYPE) == RACIAL_WEAPONS[user->QueryProp(P_RACE)]) {
    bonus += random(user->QueryProp(P_LEVEL)/2);
  }

  sinfo[SI_SKILLDAMAGE] += bonus * user->QuerySkillAttribute(SA_DAMAGE)/100;
  //tell_object(user, BS("Kampfbonus: "+bonus+", Dam: "+sinfo[SI_SKILLDAMAGE]+", USR: "+sinfo[SI_USR]));

  // Lernen: Kein Frosch, Waffe macht genug schaden, Gegnerlevel, Anwendungszahl
  if(objectp(sinfo[SI_ENEMY]) && !user->QueryProp(P_FROG) && 
     user->QueryProp(P_WEAPON)->QueryProp(P_WC) > abil/100 && 
     (sinfo[SI_ENEMY]->QueryProp(P_LEVEL) > abil/250 || !random(10) ) &&
      ut > abil/50 && abil<MAX_ABILITY) 
  {
    ut = 0; // Anwendungen zuruecksetzen
    abil += random(user->QuerProp(P_GUILD_LEVEL) + 
            user->QueryAttribute(A_STR)/3 + user->QueryProp(P_ALCOHOL)/4);
  }

  // Einen kleinen Bonus gibts auch noch
  if(!random(500+MAX_ABILITY-abil))
  { 
    enemy = sinfo[SI_ENEMY];
    tell_object(user, break_string("Du landest einen besonders guten Treffer!", 78));
    sinfo[SI_SKILLDAMAGE]+=400;
  }

  if(abil>MAX_ABILITY) abil=MAX_ABILITY;
  ut++;
  user->ModifySkill( FIGHT(WT_CLUB), ([ SI_USR: ut, SI_SKILLABILITY: abil ]),
                       sinfo[SI_DIFFICULTY], "abenteurer");

  if(dam_old && user->QueryProp(P_TESTPLAYER))
  {
    tell_object(user, sprintf("Kampfskill: %d -> %d\n", dam_old,
			 sinfo[SI_SKILLDAMAGE]));
  }
  return sinfo;
}



reset() {
  ::reset();
}
