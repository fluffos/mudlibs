#include "/gilden/zauberer/zauberer.h"

string strmul(string a, int b)
{
  int i;
  string c;
  
  c="";
  
  for (i=0;i<b;i++) c += a;
  return c;
}



string Ruler(int width)
{
  string hr;
  hr = "+"+strmul("-", width-2) + "+\n";
  return hr;
}

string Box(int width, string title, string * content)
{
  string outstr;
  string *hstr;
  string format;
  int tw;
  int i, ii;


  tw = width - 4;
  
  outstr = Ruler(width);
  
  format = "| %"+sprintf("%d", tw)+".s |";
  
  if (stringp(title))
    {
      hstr = explode(break_string(title, tw), "\n");
      for (ii=0;ii<sizeof(hstr);ii++)
        outstr += "| " + hstr[ii] + strmul(" ", tw-strlen(hstr[ii])) + " |\n";
      outstr += Ruler(width);
    }


  for (i=0;i<sizeof(content);i++)
    {
      if (content[i] == "" || content[i] == "\n")
          outstr += Ruler(width);
      else
        {
          hstr = explode(break_string(content[i], tw), "\n");
	  
	  for (ii=0;ii<sizeof(hstr);ii++)
	    {
              outstr += "| " + hstr[ii] + strmul(" ", tw-strlen(hstr[ii])) + " |\n";
            }

	}
    }

  outstr += Ruler(width);

  return outstr;  

}

int align2fac(int align)
{
  if (align < 0) align *= -1;

  if (align > 10000) align = 10000;

  return (int) (align / 100);
}

void Debug(mixed m)
{

  if(find_player("iwo"))
    tell_object(find_player("iwo"), 
      break_string(sprintf("%O", m), 78, "Z: "));   
}

int GetSkillLimit(object pl, string skill)
{
  int guild_level;

  guild_level = 
    pl->QueryProp(P_GUILD_LEVEL) * pl->QueryProp(P_GUILD_CIRCLE);

  return Z_FORMULA(guild_level);

}
