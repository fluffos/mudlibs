inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <wizlevels.h>
#include <moredef.h>
#include <moving.h>


create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Der Umhang eines Zauberers");
  SetProp(P_LONG,  
    "Das ist ein Mantel.");
  SetProp(P_INFO, "Dieser Mantel ist Hochiwomagisch.\n");
  SetProp(P_NAME, "Mantel");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "dunkl");
  AddId( ({"mantel", "zaubermantel", "\niwo_mantel"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  AddProp(P_DAM_PROTECTION, ([DT_MAGIC:2, DT_LIGHT:2, DT_POISON:2]) );
  SetProp(P_QUALITY_DECAY, 150);
  
}
