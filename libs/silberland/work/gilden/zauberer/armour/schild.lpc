inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <wizlevels.h>
#include <moredef.h>
#include <moving.h>

#define SHIELD_MAX_AC 80

object generator;

void tell_iwo(string str)
{
  object iwo;

  if (iwo = find_player("iwo"))
    tell_object(iwo, break_string(str, 78, "Schild: "));
}

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  AddId( ({"\nz_schutzschild"}) );

  SetProp(P_AC, 0);
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_INVIS, 1); 
}

void set_generator (object ob)
{
  generator = ob;
}

int DefendFunc(string *dam_type, mixed spell, object enemy)
{
  object pl;

  tell_iwo("DefendFunc");

  if (ENV(ME) && living(ENV(ME)))
    pl = ENV(ME);

  tell_iwo("Got pl");

  if (!objectp(generator) || !objectp(pl) || !ENV(generator) || !ENV(pl) || ENV(generator) != ENV(pl))
    {
      call_out("remove", 0);
      return 0;
    }
  tell_iwo("Calling out CalcHp");
  call_out("CalcHp", 0, pl, pl->QueryProp(P_HP));
  return (SHIELD_MAX_AC * generator->QueryFactor(dam_type) / 100);
}
 

void CalcHp(object pl, int last)
{
  int curr;

  tell_iwo("CalcHp");

  if (!objectp(generator))
    {
      remove();
      return;
    }

  if ((curr = pl->QueryProp(P_HP))<last)
    generator->NotifyHpLoss(last-curr);   
  tell_iwo("CalcHp notified generator");
}


void reset()
{
  ::reset();
}

void remove(int silent)
{
  if (ENV(ME))
    ENV(ME)->SetProp(P_ARMOURS, ENV(ME)->QueryProp(P_ARMOURS)
                 - ({ this_object() }));
  ::remove();
}
