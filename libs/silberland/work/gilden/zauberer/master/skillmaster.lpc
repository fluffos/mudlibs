#pragma strong_types

#include <properties.h>
#include "../zauberer.h"

#define NAME "skillmaster"

#define SAVEFILE "/gilden/zauberer/master/skillmaster"

private mapping skills = ([]); // ([ pl: ([spell: skill ]) ])

void create()
{
  if (is_clone(this_object())) return;

  seteuid(getuid(this_object()));
  
  restore_object(SAVEFILE);
}

private int allowed()
{
  object ti;
   
  if (getuid((ti=this_interactive())) != getuid(this_object()))
      if (!IS_MAINTAINER(getuid(ti)))
        {
          notify_fail("Not allowed!\n");
          return 0;
	}

  return 1;
}

public int ModifySkill(string pl, string spell, int skill)
{
  if (!allowed()) return 0;
  
  notify_fail("Illegal argument (pl)!\n");
   
  notify_fail("Not a Member ('"+pl+"')\n");
  if (!member(skills, pl))
    return 0;
  
  notify_fail("No Spell named '"+spell+"'!\n");
  if (!member(skills[pl], spell))
    return 0;
  
  notify_fail("Illegal Skill value!\n");
  if (skill > MAX_SKILL || skill < 0) return 0;

  notify_fail(sprintf("Could not set Skill: UID:%s, SPELL:%s, SKILL:%d\n",
      pl, spell, skill));
      
  return skills[pl][spell,0] = skill;
  
}

public int QuerySkill(string pl, string spell)
{
  if (!allowed()) return -1;
  if (!member(skills, pl)) return 0;
  if (!member(skills[pl], spell)) return 0;
  return skills[pl][spell,0];
}


varargs int remove(int silent)
{
  save_object(SAVEFILE);
  destruct(this_object());
  return 1;
}
