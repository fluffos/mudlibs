


int schutzschild(object caster, mapping sinfo)
{
  int succ,
      duration,
      skill_mod,
      align;

  mapping skill;
      
  object stab;
  object generator;

  //write("here");

  if (!stab = present("\nzauberer_stab", caster)) return 0;

  succ = SpellSuccess(caster, sinfo);

  if (!PaySp(caster, succ, sinfo)) return 0;
  
  if (succ<=0) return MISSERFOLG;
  

  if (IS_MAINTAINER(getuid(caster)))
    tell_object(caster, sprintf("Sinfo: %O\n", sinfo[SI_RAW_SPELLCOST, 0]));

  // Modifikation nach Skill (%)
  if (!mappingp(caster->QuerySkill("schutzschild")))
    return 0;

  notify_fail("Boeser Fehler!\n");
  if (!mappingp(skill = copy_mapping(caster->QuerySkill("schutzschild"))))
     return 0;

  skill_mod = skill["si_abil"]/100;


  // Generator clonen, initialisieren und moven
  generator = clone_object(Z_SHIELD_GENERATOR);

  if (!objectp(generator))
    {
      object iwo;
      if (iwo = find_player("iwo")) tell_object(iwo, BS("SHIELD: Boeser Fehler!")); 
      notify_fail("Boeser Fehler!\n");
      return 0;
    }
  
  generator->startup(caster, succ);

  generator->move(ENV(caster), M_SILENT | M_NOCHECK);

  call_out("schild_aus", duration, caster);
  
  return ERFOLG;
}

