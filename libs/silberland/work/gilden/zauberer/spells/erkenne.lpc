
int erkenne(object caster, mapping sinfo)
{
  int succ;
  object victim;
  string infostr;
  
  victim=FindVictim(sinfo[SI_SKILLARG],caster,
    "Wen oder was moechtest Du erkennen?\n");

  if (!victim) return 0;

  succ = SpellSuccess(caster, sinfo);

  if (!PaySp(caster, succ, sinfo)) return 0;
  
  tell_object(caster, BS("Du konzentrierst Dich und versuchst "
                        +"Einblick in die magischen Tiefen "
                        + victim->name(WESSEN) + " zu erlangen..."));


  if (succ<=0) return MISSERFOLG;

  tell_object(caster, sprintf("%'-'78s\n", ""));


  // Basisinfo
  if (infostr=victim->info(caster) || victim->QueryProp(P_INFO))
    tell_object(caster, BS(infostr));
  else
    tell_object(caster, BS(victim->Name(WER) 
        + " birgt keine Geheimnisse."));

  // Ok, nun an die Details
  if (victim->QueryProp(P_NEVERDROP))
     tell_object(caster, BS(CAP(victim->QueryPronoun(WER))
        + " wird Dich auch im Jenseits nicht verlassen."));

  if (victim->QueryProp(P_AUTOLOADOBJ))
     tell_object(caster, BS("Armageddon kann " + victim->name(WEM)
        + " nichts anhaben."));

  if (victim->QueryProp(P_CURSED))
     tell_object(caster, BS("Ein Fluch liegt auf " + victim->name(WEM)
        + ".")); 

  tell_object(caster, sprintf("%'-'78s\n", ""));

  return ERFOLG;
}
