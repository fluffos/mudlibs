inherit "std/room";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

#include "/gilden/zauberer/zauberer.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor dem Turm der Zauberer");

  SetProp(P_INT_LONG,
    "Vor Dir erhebt sich ein riesiger Turm. Seine massiven Mauern "
    "bestehen fast voellig aus Stein, und an jeder Seite scheint "
    "in jedem Stockwerk ein Fenster zu sein. Hier befindet sich der "
    "Eingang, durch den Du in sein inneres gelangen kannst. Ein "
    "seltsames Symbol ist ueber dem steineren Eingangsbogen "
    "angebracht.");

  AddDetail( ({ "turm", "turmes" }),
    "Die Grundflaeche des Turmes scheint beinahe quadratisch zu sein. "
    "Seine Mauern verjuengen sich nach oben etwas, und bilden an "
    "seiner Spitze eine Plattform, flankiert von vier Zinnen.");

  AddDetail( ({ "mauern", "mauer" }),
    "Die Mauern sind aus massivem Stein, und sind unerklimmbar.");

  AddDetail( ({ "stein" }),
    "Seine Mauern verjuengen sich nach oben etwas, und bilden an "
    "seiner Spitze eine Plattform, flankiert von vier Zinnen.");

  AddDetail( ({ "mauern", "mauer" }),
    "Die Mauern sind aus massivem Stein, und sind unerklimmbar.");

  AddDetail( ({ "stein", "steine", "steinen" }),
    "Die Steine, aus denen der Turm gefertigt ist, stammen wohl "
    "aus der Umgebung.");

  AddDetail( ({ "umgebung" }),
    "Sieh Dich doch einfach um!");
  
  AddDetail( ({ "seite", "seiten" }),
    "An der Seite, wo Du Dich gerade befindest, liegt der Eingang.");

  AddDetail( ({ "eingang" }),
    "Der Eingang fuehrt in das Innere des Turmes.");

  AddDetail( ({ "innere", "inneres" }),
    "Du musst schon rein gehen, um es zu ergruenden.");

  AddDetail( ({ "stockwerk", "stockwerke" }),
    "Der Turm scheint vier davon zu haben.");

  AddDetail( ({ "fenster" }),
    "Leider sind die Fenster viel zu hoch, um durch sie in das "
    "Innere des Turmes zu blicken.");

  AddDetail( ({ "eingangsbogen", "bogen" }),
    "Der Bogen wird von kunstvoll ineinander verkeilten Steinen "
    "gebildet.");

  AddDetail( ({ "symbol" }),
    "Das Symbol wurde aus einem Dir unbekannten Metall gefertigt, "
    "und verraet, dass hier die Zunft der Zauberer ansaessig ist.");

  AddDetail( ({ "zunft", "zauberer" }),
    "Die Zauberer sind hier ansaessig.");

  AddDetail( ({ "metall" }),
    "Das Metall ist grau, und scheint schwach zu leuchten. Leider "
    "kennst Du es nicht.");

  AddDetail( ({ "grundflaeche" }),
    "Die Grundflaeche ist beinahe quadratisch.");

  AddDetail( ({ "plattform" }),
    "Von hier kannst Du sie leider nicht genau erkennen.");

  AddDetail( ({ "spitze", "ecken", "zinnen", "zinne" }),
    "Die Spitze des Turmes bildet eine kleine Plattform mit jeweils "
    "einer Zinne an den Ecken.");

  AddExit("norden", Z_ROOM "turm1.lpc");

}
