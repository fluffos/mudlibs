inherit "std/room";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

#include "/gilden/zauberer/zauberer.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Turm der Zauberer");

  SetProp(P_INT_LONG,
    "Du befindest Dich in der Aula des Turmes der Zauberer. "
    "Hier scheinen wohl Gaeste mehr oder weniger in Empfang "
    "genommen zu werden. Ueberall sind merkwuerdige Symbole "
    "an den Waenden aufgemalt, deren Bedeutung Dir unklar "
    "ist.");

  SetProp(P_INDOORS, 1);

  AddDetail( ({ "aula" }),
    "Die Aula ist eine Art Halle, in der die Zauberer wohl "
    "Gaeste empfangen, oder Feste feiern.");

  AddDetail( ({ "art", "halle" }),
    "Du befindest Dich in einer Art Halle.");

  AddDetail( ({ "zauberer" }),
    "Hier, in diesem Turm, haben die Zauberer ihr Zentrum "
    "der Weisheit.");
  AddDetail( ({ "zentrum" }),
    "Du bist mitten drinnen.");
  AddDetail( ({ "weisheit" }),
    "Die Zauberer erlangen ihre Weisheit durch studieren ihrer "
    "Schriften, und geben sie dann weiter.");
  AddDetail( ({ "schriften", "buecher" }),
    "Die Zauberer bewahren ihre Buecher in ihrer Bibliothek auf.");
  AddDetail( ({ "bibliothek" }),
    "Die Bibliothek befindet sich im Keller.");
  AddDetail( ({ "keller" }),
    "Eine Treppe fuehrt nach unten.");
  AddDetail( ({ "treppe" }),
    "Geh doch einfach mal runter.");
  AddDetail( ({ "fest", "feste" }),
    "Leider findet zur Zeit keines statt.");
  AddDetail( ({ "bedeutung" }),
    "Du weisst leider nicht, welche sie haben.");
  AddDetail( ({ "boden" }),
    "Der Boden scheint hier aus dem selben Gestein zu bestehen, "
    "wie die Waende.");
  AddDetail( ({ "gestein" }),
    "Das Gestein ist grau, kalt, und wohl aus dem Gebirge.");
  AddDetail( ({ "gebirge" }),
    "Das musst Du schon selber erkunden.");
  AddDetail( ({ "gaeste" }),
    "Die Zauberer scheinen nicht besonders oft welche zu haben.");
  AddDetail( ({ "decke" }),
    "Die Decke ist ebenso wie der Boden aus grauem Gestein. Ein "
    "Loch klafft darin, durch welches eine Treppe nach oben fuehrt.");
  AddDetail( ({ "loch" }),
    "Durch das Loch fuehrt eine Treppe nach oben.");
  AddDetail( ({ "turm" }),
    "Du befindest Dich im Turm der Zauberer.");
  AddDetail( ({ "symbole" }),
    "Die Symbole sehen sehr maechtig aus. Trotzdem hast Du keine "
    "Ahnung wofuer sie sind.");
  AddDetail( ({ "ahnung" }),
    "Du hast absolut keine.");
  AddDetail( ({ "waende", "waenden", "wand" }),
    "Die Waende bestehen aus Stein. Sie sind uebersaet mit magischen "
    "Symbolen.");
   


  AddSpecialExit("unten", "biblio");
  AddSpecialExit("runter", "biblio");
  AddExit("raus", Z_ROOM "eingang.lpc");
  AddExit("rauf", "/gilden/zauberer");

  SetProp(P_HIDE_EXITS, ({ "unten", "runter" }));

}
