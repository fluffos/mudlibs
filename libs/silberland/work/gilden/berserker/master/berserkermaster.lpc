string b11_raum(object player)
{
  switch (getuid(player))
  {
    case "berak": return "/d/gebirge/angrox/room/ebene1/bergwerk_r22"; break;
    case "conan": return "/d/unterwelt/dante/skel/sk1"; break;
    case "cherub": return "/d/ebene/lamuerte/turm/rooms/eingang"; break;
    case "graven": return "/d/gebirge/dante/friedhof/room/pfad1"; break;
    case "icy": return "/d/polar/lamuerte/eishoehle/rooms/19626"; break;
    case "kleine": return "/d/kristallwald/sargola/insel/room/1"; break;
    case "tower": return "/d/ebene/Midas/room/kirchturm"; break;
    case "wumanzu": return "/d/dschungel/feyaria/tijara/room/schlafzimmer"; break;
    default: 
      switch(player->QueryProp(P_RACE))
      {
        case "Zwerg": return "/d/gebirge/dusty/zwerge/room/bierribs";
        case "Elf": return "/d/kristallwald/sargola/lichtung/room/0303";
        case "Oger": return "/d/ebene/zordan/ogerhoehle/room/room_b3";
        case "Hobbit": return "/d/huegelland/raballion/hobbits/room/westtor";
        case "Mensch": return "/d/ebene/creative/feldlager/room/a5_a5";
        case "Troll": return "/d/gebirge/speedy/trollager/room/t6";
        case "Dunkelelf": return "/d/unterwelt/zordan/dhrkion/room/rothe-h10";
        default: return "/d/dschungel/feyaria/tijara/room/kraeuter_b6"; 
      }
  }
}


string b11_text(object player, int nr)
{
  string room, longdesc, result;
  int i;

  room = b11_raum(player);
  call_other(room, "???");
  longdesc = find_object(room)->QueryProp(P_INT_LONG);
  longdesc = implode(explode(longdesc,"\n"),"");
  longdesc = longdesc[0..219]; 
  result = "";
  for(i = nr; i < strlen(longdesc); i += 11)
  {
    result += longdesc[i..i];
  }
  return result;
}

int name2int(string str)
{
  int i, ret;
  for(i = 0; i < strlen(str); i++)
  {
    switch ( str[i..i] )
    {
      case "z": ret += 1;
      case "y": ret += 1;
      case "x": ret += 1;
      case "w": ret += 1;
      case "v": ret += 1;
      case "u": ret += 1;
      case "t": ret += 1;
      case "s": ret += 1;
      case "r": ret += 1;
      case "q": ret += 1;
      case "p": ret += 1;
      case "o": ret += 1;
      case "n": ret += 1;
      case "m": ret += 1;
      case "l": ret += 1;
      case "k": ret += 1;
      case "j": ret += 1;
      case "i": ret += 1;
      case "h": ret += 1;
      case "g": ret += 1;
      case "f": ret += 1;
      case "e": ret += 1;
      case "d": ret += 1;
      case "c": ret += 1;
      case "b": ret += 1;
      case "a": ret += 1;
    }
  }
  return ret;
}

string b11_gem(string player, int nr)
{
  string *gems, *pre;
  int x, l;
 
  if(!CheckIfAllowed()) return "";
  l = strlen(player);
  x = (name2int(player) + nr * l) % 13;
  gems = ({"diamant", "rubin", "saphir", "smaragd", "opal", "amethyst", 
      "lapislazuli", "granat", "zirkon", "aquamarin", "topas", "onyx",
      "turmalin"});
  pre = ({"Super", "Ultra", "Hyper", "Riesen", "Mega"});
  return pre[(nr + l) % 5] + gems[x];
}

int QueryRiesenkraft(string player)
{
  return riesenkraft[player];
}

int SetRiesenkraft(string player)
{
  if( file_name(PO)!="/spellbooks/berserker_spells" )
    return -1;
  if( !member(riesenkraft, player) )
    return riesenkraft[player] = 1;
  return riesenkraft[player]++;
}

void reset()
{
  riesenkraft = ([]);
}

mapping QueryAll() {
  return berserker; 
}


int QueryWimpy(object pl) {
    string *nowimpyplayers;
    nowimpyplayers=NOWIMPYPLAYERS;
    if (member(nowimpyplayers, getuid(pl))!=-1)
      return 0;
    return pl->QueryProp(P_WIMPY);
}
