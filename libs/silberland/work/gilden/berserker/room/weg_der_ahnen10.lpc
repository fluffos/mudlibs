// Weg der Ahnen - fuer Berserkerstufe 11
// 25.7.2003 Feyaria@SilberLand

#include "../def.h"
#include "../epic/berserkerstufe11.h"
#include <properties.h>
#include <new_skills.h>
#include <moving.h>

inherit B11_ROOM "_inh";

int tal, run, juw, per;

void create() 
{
  ::create();

  SetProp( P_INT_LONG,
    "Du befindest Dich in einer gewaltigen Saeulenhalle, die sich scheinbar "
    "unendlich in alle Richtungen erstreckt. Direkt vor Dir befindet sich "
    "ein gewaltiger Altar." );

  AddDetail( ({ "altar" }),
    "Auf dem Altar befindet sich eine kleine Vertiefung.");
  AddDetail( ({ "vertiefung" }),
    "Diese Vertiefung ist wohl dafuer gedacht, Blut zu opfern.");
  AddDetail( ({ "blut" }),
    "Das einzige Blut, dass Du opfern kannst, ist wohl Dein eigenes.");

  AddCmd( ({ "opfer", "opfere" }), "cmd_opfere" );
}

int cmd_opfere(string str )
{
  object ob;
  string was;
  notify_fail( "Was willst Du opfern?\n" );
  if( member( ({"blut", "mein blut", "eigenes blut"}), str) == -1 )
    return 0;
  write("Du opferst so viel von Deinem eigenen Blut, bis Du fast "
        "der Ohnmacht nahe bist.\n");
  TP->SetProp(P_HP, 1);
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 20, 
                             PARALYZE_MSG: "",]) );
  call_out("seq1", 8);
  return 1;
}

void seq1()
{
  write(BS("Ploetzlich beginnt sich die Quintessenz des Berserkertums "
      "blutrot zu verfaerben, wird fluessig und ersetzt Dein Blut."));
  present(B11_ID "q", TP)->remove();
  TP->AddHp(400);
  call_out("seq2", 8);
}

void seq2()
{
  write(BS("Du fuehlst nun die Macht aller Ahnen der Berserker in Dir!"));
  call_out("seq3", 8);
}

void seq3()
{
  write(BS("Der Edelstein der Edelsteine glueht auf und explodiert mit "
        "einem gewaltigen Knall und blendet Dich."));
  present(B11_ID "e", TP)->remove();
  TP->SetProp(P_BLIND, 3);
  TP->SetProp(P_SP, 1);
  call_out("seq4", 8);
}

void seq4()
{
  write("Ein Strudel erfasst Dich und bringt Dich in die Berserkergilde.\n");
  TP->move("/gilden/berserker", M_NOCHECK);
  call_other("/gilden/berserker", "level_11", TP);
  TP->AddSp(400);
}
