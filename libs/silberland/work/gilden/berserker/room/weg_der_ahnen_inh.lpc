// Weg der Ahnen - fuer Berserkerstufe 11
// 25.7.2003 Feyaria@SilberLand

#include "../def.h"
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include "../epic/berserkerstufe11.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Weg der Ahnen" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer gewaltigen Saeulenhalle, die sich scheinbar "
    "unendlich in alle Richtungen erstreckt." );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_NOQUIT, 1);

  AddDetail( ({ "saeulen", "saeule" }),
    "Die gewaltigen Saeulen sind so gross, dass nicht einmal ein Troll sie "
    "umfassen koennte.");
  AddDetail( ({"troll"}), 
      (["troll": "Du bist ein Troll!", 0:"Hier ist kein Troll!"]));
  AddDetail( ({ "halle", "saeulenhalle" }),
    "Die Saeulenhalle ist gewaltig.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leises Saeuseln.");
  AddSound( ({ "saeuseln" }),
    "Du kannst nicht bestimmen von wo es kommt.");
  AddSmell( DEFAULT_SMELL,
    "Ein leichter Modergeruch.");
  AddSmell( ({ "moder", "modergeruch", "geruch" }),
    "Es riecht nach Moder.");

}

void init()
{
  ::init();
  if( TP && interactive(TP) && !IS_ARCH(TP) &&
      (!present(B11_ID "q", TP) || !present(B11_ID "e", TP)) )
    TP->move(TP->QueryProp(P_LAST_COMMAND_ENV), M_NOCHECK);
  if( TP && !query_once_interactive(TP) && TP->Id("daemon") ||
      TP->id("elementar"))
    TP->remove();
}

void reset()
{
  ::reset();
  if (sizeof(QueryProp(P_EXITS)))
    RemoveExit("weiter");
}

