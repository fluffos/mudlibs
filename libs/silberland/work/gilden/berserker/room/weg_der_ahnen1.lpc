// Weg der Ahnen - fuer Berserkerstufe 11
// 25.7.2003 Feyaria@SilberLand

#include "../def.h"
#include "../epic/berserkerstufe11.h"
#include <properties.h>
#include <new_skills.h>
#include <moving.h>

inherit B11_ROOM "_inh";

int tal, run, juw, per;

void create() 
{
  ::create();

  SetProp( P_INT_LONG,
    "Du befindest Dich in einer gewaltigen Saeulenhalle, die sich scheinbar "
    "unendlich in alle Richtungen erstreckt. Direkt vor Dir befindet sich "
    "ein Altar." );

  AddDetail( ({ "altar" }),
    "Auf dem Altar gibt es vier Vertiefungen, die wohl fuer die Opfergaben "
    "gedacht sind.");
  AddDetail( ({ "vertiefung", "vertiefungen" }),
    "Es gibt vier Vertiefungen, eine hat die Form eines Talismans, die "
    "zweite die Form eines Juwels, die dritte die Form einer Rune und "
    "die vierte die Form einer Riesenperle.");
  AddDetail( ({ "form" }),
    "Die Vertiefungen haben jeweils die Form der Gegenstaende, die man "
    "darin opfern kann.");
  AddDetail( ({ "gegenstaende", "gegenstand", "opfergaben" }),
    "In den Vertiefungen kannst Du Gegenstaende opfern, die zu der jeweiligen "
    "Form passen.");
  AddDetail( ({ "talisman", "juwel", "rune", "riesenperle" }),
    "Das kannst Du am Altar opfern.");


  AddDetail( ({ "" }),
    "");

  AddCmd( ({ "opfer", "opfere" }), "cmd_opfere" );
  AddExit( "raus", "/gilden/berserker");
  
  tal=run=juw=per=0;
}

int cmd_opfere(string str )
{
  object ob;
  string was, nam;
  notify_fail( "Was willst Du opfern?\n" );
  if (!str) return 0;   // added 2004-11-28 by woody
  if( !ob=present(str, TP) )
    return notify_fail("Aber Du hast ja gar kein "+str+"!\n"),0;
  was = explode(file_name(ob),"#")[0];
  nam = ob->name(WEN);
  if( was == "/p/daemon/itemd/obj/runes/rune" )
  {
    if( run )
      return write("Du hast hier schon eine Rune geopfert!\n"),1;
    run =1; 
    ob->remove();
  }
  else if ( was == "/p/daemon/itemd/obj/talisman" )
  {
    if( tal )
      return write("Du hast hier schon einen Talisman geopfert!\n"),1;
    tal =1; 
    ob->remove();
  }
  else if (was == "/p/magic/riesenperle" )
  {
    if( per )
      return write("Du hast hier schon eine Perle geopfert!\n"),1;
    per =1; 
    ob->remove();
  }
  else if (was == "/d/wasser/cirion/gems/obj/std_magic_gem" )
  {
    if( juw )
      return write("Du hast hier schon ein Juwel geopfert!\n"),1;
    juw =1; 
    ob->remove();
  }
  else
    return notify_fail(ob->Name(WEN)+" kannst Du hier nicht opfern!\n"),0;
  write("Du opferst "+nam+" den Ahnen der Berserker.\n");
  if( run && tal && per && juw)
  {
    run=tal=per=juw=0;
    write("Nachdem Du alle Opfergaben dargebracht hast, verschwindet der Altar.\n");
    TP->SetProp(P_GUILD_LEVEL, 2);
    TP->move(B11_ROOM "2", M_NOCHECK+M_NO_SHOW);
  }
  return 1;
}
