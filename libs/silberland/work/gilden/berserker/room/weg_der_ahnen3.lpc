#include "../def.h"
#include "../epic/berserkerstufe11.h"
#include <properties.h>
#include <new_skills.h>
#include <moving.h>

inherit B11_ROOM "_inh";

void create() 
{
  ::create();

  SetProp( P_INT_LONG,
    "Du befindest Dich in einer gewaltigen Saeulenhalle, die sich scheinbar "
    "unendlich in alle Richtungen erstreckt. Auf den Saeulen befinden sich "
    "Darstellungen von Feenberserkern." );

  AddDetail( ({ "darstellung", "darstellungen" }),
    "Sie stellen Feenberserker da. Allerdings schauen die Feen mit ihren "
    "kleinen Aextchen nicht gerade sehr gefaehrlich aus.");
  AddDetail( ({"fee", "feen", "feenberserker", "berserker"}),
      "Komisch... noch nie zuvor hast Du von Feenberserker gehoert, "
      "scheinbar sind die schon ausgestorben.");
  AddDetail( ({"aextchen"}),
      "Die Aextchen der Feen schauen nicht sehr gefaehrlich aus.");

  AddItem(B11_GEGNER "2", REFRESH_DESTRUCT);
}


