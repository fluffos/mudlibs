#include "../def.h"
#include "../epic/berserkerstufe11.h"
#include <properties.h>
#include <new_skills.h>
#include <moving.h>

inherit B11_ROOM "_inh";

void create() 
{
  ::create();

  SetProp( P_INT_LONG,
    "Du befindest Dich in einer gewaltigen Saeulenhalle, die sich scheinbar "
    "unendlich in alle Richtungen erstreckt. Auf den Saeulen befinden sich "
    "Darstellungen von Menschenberserkern." );

  AddDetail( ({ "darstellung", "darstellungen" }),
    "Sie stellen Menschenberserker da.");
  AddDetail( ({"mensch", "menschen", "menschenberserker", "berserker"}),
      "Alle Menschen hier sind Berserker.");

  AddItem(B11_GEGNER "8", REFRESH_DESTRUCT);
}


