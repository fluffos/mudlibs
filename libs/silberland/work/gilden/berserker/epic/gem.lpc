#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include "berserkerstufe11.h"
#include "../def.h"
#include "ansi.h"

inherit "std/thing";


void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Der Edelstein aller Edelsteine");
  SetProp(P_LONG, "Das ist der Edelstein aller Edelsteine. Er ist kopfgross, "
      "hat unzaehlige Facetten und schimmert in allen Regenbogenfarben.");
      
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, ({"Edelstein aller Edelsteine",
        "Edelsteins aller Edelsteine",
        "Edelstein aller Edelsteine",
        "Edelstein aller Edelsteine",
        }));
  AddId( ({"edelstein aller edelsteine", "edelstein", "\nb11_e"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 1000000000);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  AddDetail( ({"facetten", "facette"}),
      "Unzaehlige Facetten hat der Edelstein aller Edelsteine.");
  AddDetail( ({"farbe", "regenbogenfarbe", "regenbogenfarben"}),
      "Der Edelstein aller Edelsteine schimmert in allen Regenbogenfarben.");
}

string short()
{
  if(this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return ANSI_RED+ANSI_BOLD+QueryProp(P_SHORT)+ANSI_NORMAL+".\n";
  return QueryProp(P_SHORT)+".\n";
}

string name(int casus, int daemon)
{
  string n;
  n=::name(casus, daemon);
  if( this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return ANSI_RED+ANSI_BOLD+n+ANSI_NORMAL;
  return n;
}

string Name(int casus, int daemon)
{
  return capitalize(name(casus,daemon));
}

