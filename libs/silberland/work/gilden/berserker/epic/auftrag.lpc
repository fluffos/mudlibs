#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include "berserkerstufe11.h"
#include "../def.h"
#include "vt100.h"

inherit "std/thing";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Kronangs Auftrag");
  SetProp(P_LONG, 
      "Du hast diesen Auftrag von Kronang bekommen: Du musst "
      "eine rote Drachenschuppe, einen magischen Feenfluegen, einen "
      "Ultrasaphir und eine Riesenqualperle besorgen.");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Kronangs Auftrag");
  AddId( ({"auftrag", "\nbaxt_auftrag"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}

