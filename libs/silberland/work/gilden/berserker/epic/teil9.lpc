#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include "berserkerstufe11.h"
#include "../def.h"
#include "vt100.h"

inherit "std/thing";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Der neunte Teil");
  SetProp(P_LONG, "Das ist der neunte Teil von Etwas, von dem Du noch "
      "nicht weisst, was es einmal werden wird. Es ist unregelmaessig "
      "geformt, hat 8 Kanten, 5 Ecken und eine rosa Farbe, wirklich sehr "
      "raetselhaft.\n@@teile@@");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Teil Neun");
  AddId( ({"NODESTRUCT", "9", "teil neun", "teil", "neunte teil", 
        "neunten teil", "\nb11_9"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  
  AddDetail( ({"kante", "kanten"}),
      "Du kannst 8 Kanten erkennen.\n");
  AddDetail( ({"ecke", "eck", "ecken"}),
      "Du kannst 5 Ecken erkennen.\n");
}

string teile()
{
  string r;
  r="Du kannst die Buchstaben '"+BMASTER->b11_text(TP, 8)+
    "' erkennen.\n";
  if( ALL_PARTS )
    return r + BS("Da Du nun alle Teile beisammen hast, koenntest Du "
        "versuchen, das Raetsel zu loesen");
  else
    return r;
}


string short()
{
  if(this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return VT_RED+QueryProp(P_SHORT)+VT_NORMAL+".\n";
  return QueryProp(P_SHORT)+".\n";
}

string name(int casus, int daemon)
{
  string n;
  n=::name(casus, daemon);
  if( this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return VT_RED+n+VT_NORMAL;
  return n;
}

string Name(int casus, int daemon)
{
  return capitalize(name(casus,daemon));
}

