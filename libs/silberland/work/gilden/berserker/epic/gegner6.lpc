
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "berserkerstufe11.h"
#include "../def.h"
#include <npcmaster.h>

void create() 
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Thurgrax, der Ahn der Zwergenberserker");
  SetProp(P_LONG,
      "Thurgrax ist ein alter Zwerg mit einem langen grauen Bart. Er ist "
      "komplett in eine Kettenruestung gehuellt, nur der vorhin erwaehnte "
      "Bart ist zu sehen. Ausserdem traegt er noch ein blutrotes Stirnband "
      "und hat eine gewaltige Axt gezueckt.");
  SetProp(P_NAME, "Thurgrax");
  SetProp(P_GENDER, MALE);
  AddId(({"berserker", "ahn", "thurgrax", "zwerg", "zwergenberserker"}));

  create_default_npc(31);
  SetProp(P_HANDS, ({" mit seiner Axt",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 111);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_KILL_NAME, "Der Weg der Ahnen");

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "sagt: Du musst mich besiegen, um auf den Weg der "
      "Ahnen zu bestehen!\n");
  AddLibrary(NPC "kronang.lib", 1);

  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 8);
  call_other("/gilden/berserker","learn_berserker_skills", 8000, 8000);

  SUID;
  CLONEME("/p/weapon/axe/stabaxt");
  command("zuecke axt");
  CLONEME("/gilden/berserker/obj/stirnband");
  command("trage alles");

  AddCmd( ({"zertreten", "rammen", "kampfschrei", "kopfstoss",
        "blutrausch", "schlachtruf"}), "nix");
}

int nix(string str)
{
  if (!InFight(TP)) return 0;
  write("Du musst diesen Kampf gewinnen, ohne Dich auf "+query_verb()+" zu "
      "verlassen!\n");
  return 1;
}

void die(int poisondeath) 
{
  object ob, wer;
  log_file(B11_LOG, "["+ dtime()+"] "+
      sprintf("%O",QueryProp(P_KILLER)||TP)+
      " killt den Zwergenberserker.\n");
  if( (wer=QueryProp(P_KILLER)) || (wer=TP) )
  {
    ob=wer->QueryArmours(AT_CLOAK)[0];
    ob->remove(1); if( ob ) destruct(ob);
    ob=clone_object(BERSERKERRUESTUNG);
    ob->create2(wer->QueryProp(P_RACE), AT_CLOAK);
    ob->move(wer, M_NOCHECK);
    ob->DoWear(1);
    wer->SetProp(P_GUILD_LEVEL, 8);
    wer->heal_self(400);
    environment()->AddExit("weiter", "./weg_der_ahnen8");
  }
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    log_file(B11_LOG, "["+ dtime()+"] Der Zwergenberserker hat gerade "+
        sprintf("%O",(player))+" umgebracht.\n");
  call_out("corpsemove", 4);
  heal_self(2000);
}

void corpsemove()
{
  present("leiche")->move("/gilden/berserker", M_NOCHECK);
}

int _query_wimpy() { return 0; }

void Attack(object enemy)
{
  if( !QueryProp(P_DISABLE_SPELLS) )
  {
    if( !present("\nberserker_willenskraft",TO) && !random(3) )
      command_me("willenskraft");
    else if( !QueryProp(P_PREFERED_ENEMY) && !random(3) && interactive(enemy) )
      command_me("augeinauge");
    else if ( time() - enemy->QueryProp("last_rammen_time")<4 )
      command_me("zertreten");
    else if( random(10)<3 && !enemy->QueryProp(P_DEAF) )
      command_me("kampfschrei");
    else
    {
      switch( 100*enemy->QueryProp(P_SIZE)/QueryProp(P_SIZE))
      {
        case 0..30: command_me("zertreten"); break;
        case 80..300: if( random(3) ) command_me("kopfstoss");
                        else command_me("rammen"); break;
        default: command_me("rammen"); break;
      }
    }
  }
  if( enemy ) ::Attack(enemy);
}

int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  object *obs;
  object ob;

  if (!sizeof(obs = enemy->QueryArmours(AT_CLOAK)))
  {
    tell_object(enemy, break_string("Ohne Umhang brauchst Du gar nicht gegen "
          "mich kaempfen!\n",78, Name(WER,1)+" sagt: "));
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    enemy->move("/gilden/berserker",M_NOCHECK);
    return 0;
  }
    ob = obs[0];
  if( !sizeof(obs) || (ob->QueryProp(P_AC)+ob->QueryProp(P_DAMAGED)) < 
      3*VALID_ARMOUR_CLASS[AT_CLOAK]/4)
  {
    tell_object(enemy, break_string(ob->Name(WER,1)+" "+
          (ob->QueryProp(P_PLURAL)?"sind":"ist")+ " ja Schrott. Komm wieder "
          "mit besserer Ausruestung!",78, Name(WER,1)+" sagt: "));
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    enemy->move("/gilden/berserker",M_NOCHECK);
    return 0;
  }
  enemy->SetProp(P_FOOD, enemy->QueryProp(P_MAX_FOOD));
  enemy->SetProp(P_DRINK, enemy->QueryProp(P_MAX_DRINK));
  ::Defend(dam, dam_type, spell, enemy);
}


void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  if( !InFight()) heal_self(2000);
}
