#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "berserkerstufe11.h"
#include "../def.h"

inherit "std/thing";

string grund;
int punkte;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Teilgefunden");
  AddId( ({B11_ID "teil_gefunden"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  call_out("check", 15);
}

int b11(object pl)
{
  if(objectp(pl) && interactive(pl) && pl->QueryProp(P_GUILD) == GUILDNAME &&
      pl->QueryProp(P_GUILD_LEVEL) > 10)
  {
    call_other(BMASTER, "AddTeaching", pl, punkte, grund);
  }
}

void check()
{
  if( !environment() || !environment(environment()) ) return;
  filter_array(all_inventory(environment(environment())), "b11");
  call_out("remove", 10);
}

int SetGrund(int _punkte, string _grund)
{
  punkte= _punkte;
  grund = _grund;
  return 1;
}

void reset()
{
  if( !is_clone(TO) ) return;
  remove();
}
