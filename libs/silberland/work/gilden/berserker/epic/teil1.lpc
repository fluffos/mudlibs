#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include "berserkerstufe11.h"
#include "../def.h"
#include "vt100.h"

inherit "std/thing";

int last_try;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Der erste Teil");
  SetProp(P_LONG, "Das ist der erste Teil von Etwas, von dem Du noch "
      "nicht weisst, was es einmal werden wird. Es ist unregelmaessig "
      "geformt, hat 9 Kanten, 7 Ecken und eine rote Farbe, wirklich sehr "
      "raetselhaft.\n@@teile@@");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Teil Eins");
  AddId( ({"NODESTRUCT", "1", "teil eins", "teil", "eins", "erster teil", 
        "ersten teil", "\nb11_1"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  
  AddDetail( ({"kante", "kanten"}),
      "Du kannst 9 Kanten erkennen.\n");
  AddDetail( ({"ecke", "eck", "ecken"}),
      "Du kannst 7 Ecken erkennen.\n");

  AddCmd( ({"loes", "loese"}), "loesen");

  last_try=0;
  seteuid(getuid(this_object()));
}

string teile()
{
  string r;
  r="Du kannst die Buchstaben '"+BMASTER->b11_text(TP, 0)+
    "' erkennen.\n";
  if( ALL_PARTS )
    return r + BS("Da Du nun alle Teile beisammen hast, koenntest Du "
        "versuchen, das Raetsel zu loesen");
  else
    return r;
}

int loesen(string str)
{
  if( !ALL_PARTS ) return 0;
  if( str != "raetsel") return 0;
  if( TP->QueryProp(P_LEVEL) < 64 || TP->QueryProp(P_XP) < 200000000 )
   return write("Du musst noch mehr Erfahrung sammeln um das Raetsel zu loesen!\n"),1; 
  if( time()-last_try < 60*60 )
    return write ("Du musst noch bis zum naechsten Loesungsversuch warten!\n"),1;
  if( file_name(ENV(TP)) == BMASTER->b11_raum(TP) )
  {
    write(BS("Durch Deine Umgebung inspiriert, erkennst Du ploetzlich "
          "die Loesung dieses Raetsels. Aus den 11 Einzelteilen baust "
          "Du geschwind ein groesseres Gebilde zusammen, das 5 Ecken und 5 "
          "Kanten hat und in allen Regenbogenfarben schimmert!")+
        "Du jubelst, weil Du das Raetsel aller Raetsel geloest hast!\n");
    CLONE( LOESUNG, TP);
    DB("***B11*** " + TP->Name() + " loest das Raetsel aller Raetsel!\n");
    log_file(B11_LOG,sprintf("[%s] %O loest das Raetsel aller Raetsel!\n",
          dtime(time()),TP));
    present("\nb11_11", TP)->remove();
    present("\nb11_10", TP)->remove();
    present("\nb11_9", TP)->remove();
    present("\nb11_8", TP)->remove();
    present("\nb11_7", TP)->remove();
    present("\nb11_6", TP)->remove();
    present("\nb11_5", TP)->remove();
    present("\nb11_4", TP)->remove();
    present("\nb11_3", TP)->remove();
    present("\nb11_2", TP)->remove();
    call_out("remove", 0);
    return 1;
  }
  else
    return BS("Leider schaffst Du es nicht, das Raetsel zu loesen; "
        "probiere es in einer Stunde noch einmal!"),1;
}

string short()
{
  if(this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return VT_RED+QueryProp(P_SHORT)+VT_NORMAL+".\n";
  return QueryProp(P_SHORT)+".\n";
}

string name(int casus, int daemon)
{
  string n;
  n=::name(casus, daemon);
  if( this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return VT_RED+n+VT_NORMAL;
  return n;
}

string Name(int casus, int daemon)
{
  return capitalize(name(casus,daemon));
}

