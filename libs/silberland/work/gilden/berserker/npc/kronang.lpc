void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( TPN=="Feyaria") 
  {
    if( random(2) ) call_out("feyaria",0);
    return;
  }
  if ((gruppe=="nett" || gruppe=="intim") && find_call_out("gut")==-1) 
    call_out("gut",0);
  else if ((gruppe=="fies" || gruppe=="frech") && find_call_out("boese")==-1)
    call_out("boese",0);
  else if ((gruppe=="traurig" || gruppe=="aengstlich" || gruppe=="aergerlich")
      && find_call_out("troesten")==-1 )
    call_out("troesten",0);
  else if ((gruppe=="froh" || gruppe=="albern") && find_call_out("lustig")==-1)
    call_out("lustig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void feyaria()
{
  switch( random(2) ){
    case 0: command_me("emote verneigt sich ehrfuerchtig vor Feyaria.");
            break;
    case 1: command_me("laechelt Feyaria an.\n");
            break;
  }
}

void gut()
{
  string *guttext;
  if( TPN == "Sisqui" & random(7) )
  {
    switch( random(3) ){
      case 0: tell_object(TP, "Kronang laechelt Dich an.\n");
              tell_room(MENV, "Kronang laechelt "+TPN+" an.\n", ({TP}) );
              break;
      case 1: tell_object(TP, "Kronang knuddelt Dich.\n");
              tell_room(MENV, "Kronang knuddelt "+TPN+".\n", ({TP}) );
              break;
      case 2: tell_object(TP, "Kronang umarmt Dich.\n");
              tell_room(MENV, "Kronang umarmt "+TPN+".\n", ({TP}) );
              break;
    }
    return;
  }
  guttext= ({ "Hoer auf, mich zu belaestigen, ",
              "Was soll das, ",
              "Ich mag das nicht, ",
              "Geh lieber kaempfen, " });
  command_me("sag " + guttext[random(sizeof(guttext))] + TPN+ "!");
}

void boese()
{
  string *boestext;
  boestext=({ "Das merk ich mir, ", 
              "Ich lass mich nicht von Dir provozieren, ",
              "Willst Du, dass ich Dich zerschmettere, "});
command_me("sag " + boestext[random(sizeof(boestext))] + TPN + "!" );
}

void lustig()
{
  if( TP->QueryProp(P_GUILD)=="berserker" && 
      TP->QueryProp(P_GUILD_LEVEL) > 6 )
    command_me("sag Verhalte Dich doch wie ein echter Berserker, "+TPN+"!");
  else
    command_me("sag Aus Dir wird nie ein richtiger Berserker, "+TPN+"!");
}

void troesten()
{
  if( TP->QueryProp(P_GUILD)=="berserker" && 
      TP->QueryProp(P_GUILD_LEVEL) > 4 )
    command_me("sag Ein Berserker muss immer hart bleiben, "+TPN+"!");
  else
    command_me("sag "+CAP_TPN+" ist ein Schwaechling!");
}

void antwort(object pl,string ret)
{
  tell_object(pl,ret);
}

void reset_callout_counter()
{
  callout_counter = 0;
}

void catch_tell(string str)
{
  object pl, ob;
  string ret,ret2;

  if (!str) return;
  if (!pl=find_player(lower_case(explode(str," ")[0])) ) return;
  if (pl->QueryProp(P_GUILD)!="berserker" ) return;
  if (callout_counter > 10) return;
  else if (!callout_counter) 
  {
    call_out("reset_callout_counter", 2);
    callout_counter++;
  }
  else callout_counter++;
  if ((strstr(str, "teilt Dir mit: ") != -1) && 
      ( strstr(str, "erhoehen") != -1 || strstr(str, "anforderungen") != -1 ))
  {
    switch(pl->QueryProp(P_GUILD_LEVEL))
    {
      case 1: ret=MENV->Test2(pl,1);break;
      case 2: ret=MENV->Test3(pl,1);break;
      case 3: ret=MENV->Test4(pl,1);break;
      case 4: ret=MENV->Test5(pl,1);break;
      case 5: ret=MENV->Test6(pl,1);break;
      case 6: ret=MENV->Test7(pl,1);break;
      case 7: ret=MENV->Test8(pl,1);break;
      case 8: ret=MENV->Test9(pl,1);break;
      case 9: ret=MENV->Test10(pl,1);break;
      case 10:        
      case 11: call_out("antwort",2,pl,break_string( "Fuer die naechste Stufe "
                     "musst Du Dich schon etwas mehr anstrengen!", 78,
                     "Kronang teilt Dir mit: "));
               return;
      case 12: call_out("antwort",2,pl,break_string( "Wozu willst Du noch  "
                     "erhoehen? Hoeher geht es nicht!", 78,
                     "Kronang teilt Dir mit: "));
               return;
      default: ret="Kronang teilt Dir mit: Du kannst nicht mehr erhoehen!\n";
    }
    if (!ret) 
    {
      ret=check_restrictions(pl, MENV->QueryProp(P_GUILD_LEVELS)[
          pl->QueryProp(P_GUILD_LEVEL)+1]);
      if( stringp(ret) )
        ret="Kronang teilt Dir mit: "+ret;
      else
        ret="Kronang teilt Dir mit: Komm sofort her und erhoehe Deine Stufe!\n";
    }
    else
      ret="Kronang teilt Dir mit: Du kannst leider noch nicht erhoehen!\n";
    call_out("antwort",2,pl,ret);
  }
  if( strstr(str, "teilt Dir mit: ") != -1 && strstr(str, "stirnband") != -1 )
  {
    if( ob = present("\nberserker_stirnband", pl) )
      ob->remove(1);
    CLONE( ARMOUR "stirnband", pl );
  }
}

varargs void
ModifySkillAttribute(object caster, string atrname, int value, int duration,
                         mixed fun) 
{
  if (previous_object() && previous_object()!=this_object() && 
      getuid(previous_object())!="GUILD.berserker")
    return;
  ::ModifySkillAttribute(caster, atrname, value, duration, fun);
}

string stufe9()
{
  int level, str, con, dex;
  level=45; str=27, dex=24, con=24;
  switch( TP->QueryProp(P_RACE) )
  {
    case "Dunkelelf": str=26; break;
    case "Elf": str=25; break;
    case "Hobbit": str=26; break;
  }
  tell_room(MENV, break_string(
    "Um auf Stufe neun aufzusteigen, musst Du als "+TP->QueryProp(P_RACE)+ 
    " mindestens Spielerstufe "+level+ " sein und 25 Millionen "
    "Erfahrungspunkte, eine Kraft von "+str+", eine Ausdauer von "
    +con+" und eine Geschicklichkeit von "+dex+" haben. Ausserdem musst Du "
    "fast alle Faehigkeiten meisterhaft beherrschen und "
    "alle bis auf die optionalen Abenteuer gespielt haben. Und natuerlich "
    "musst Du auch noch acht Millionen Punkte an Kampferfahrung sammeln, "
    "aber das geht ja mit Blutrausch schnell.", 78, "Kronang sagt: "));
  return "sagt: Dann kannst Du Schlachtruf lernen.";
}

string stufe10()
{
  int level, str, con, dex;
  level=55; str=30, dex=25, con=30;
  switch( TP->QueryProp(P_RACE) )
  {
    case "Elf": str=26; con=29; break;  
    case "Hobbit": str=27; con=29; break;
    case "Mensch": str=29; break;
    case "Dunkelelf": str=27; con=28; break;
  }
  tell_room(MENV, break_string(
    "Um auf Stufe zehn aufzusteigen, musst Du als "+TP->QueryProp(P_RACE)+ 
    " mindestens Spielerstufe "+level+ " sein und 55 Millionen "
    "Erfahrungspunkte, eine Kraft von "+str+", eine Ausdauer von "
    +con+" und eine Geschicklichkeit von "+dex+" haben. An Kampferfahrung "
    "musst Du zwanzig Millionen Punkte sammeln. Du musst alle "
    "Faehigkeiten perfekt beherrschen und ausserdem musst Du "
    "fast alle Abenteuer gespielt haben. Du musst den Riesen in der "
    "Unterwelt toeten, denn dann kannst Du seine Kraft uebernehmen "
    "und selber Riesenkraft lernen. Dann hast Du fast den Gipfel des "
    "Berserkertums erreicht! Du bist dann auch "
    "erfahren genug, um andere Berserker zu beurteilen.", 78, 
    "Kronang sagt: "));
  return "sagt: Bis jetzt haben erst sehr wenige Berserker diese Anforderungen erfuellt.";
}
void init()
{
  ::init();
  if (TP != TO && TP->QueryProp(P_GUILD) == "berserker" && 
      TP->QueryProp(P_GUILD_LEVEL) > random(10) &&
      find_call_out("gruss") == -1)
    call_out("gruss",0);
}

void gruss()
{
  int zeit;
  object wea;
  if(!objectp(TP)) return;

  if( present(TP, MENV) )
  {
    if( IS_WIZARD(TP) )
    {
      command("sag Welche Ehre, "+TPN+"!");
      if( getuid(TP)=="feyaria" )
        feyaria(); 
    }
    else if( TP->QueryProp(P_GUILD_LEVEL)==10 && member(axt, getuid(TP))==-1 &&
        !IS_LEARNER(TP) && !present("berserkeraxt", TP) ) 
    {
      axt += ({getuid(TP)});
      if( !random(AXTCHANCE) )
      {
        command("sag Aufgrund Deiner Verdienste borge ich Dir fuer kurze Zeit "
            "eine Berserkeraxt.");
        CLONE( WEAPON "miniberserkeraxt", TP);
        WLOG( LOG "Miniberserkeraxt", "bekommt eine Miniberserkeraxt von Kronang");
      }
    }
    else if (TP->QueryProp(P_GUILD_LEVEL) == 12)
    {
      switch (random(4))
      {
        case 0: command("sag Hallo Gildenmeisterkollege :)"); break;
        case 1: command("sag Willkommen, Kollege " + TPN + "."); break;
        case 2: command("sag Hallo " + TPN +"! Bleibst Du laenger hier? "
                    "Dann mach ich mal kurz Pause."); break;
        case 3:
          if (BMASTER->GetTeaching(getuid(TP)) < MAX_ABILITY)
            command("sag Du musst Dich noch im Lehren ueben, " + TPN + 
                ", bis Du wuerdig fuer die Axt des Gildenmeisters bist.");
          else
            command("sag Du bist ein wuerdiger Berserkergildenmeister, " +
                TPN + "!");
          break;
      }
    }
    else
    {
      zeit = (time() - TP->QueryProp(P_LAST_WUETEN_TIME)) / 60;
      if (!(wea = TP->QueryProp(P_WEAPON)) ||
          wea->QueryProp(P_WEAPON_TYPE) != WT_AXE)
      {
        command("sag Ohne eine vernueftige Axt brauchst Du mir gar nicht "
            "unter die Augen kommen, "+TPN+"!");
        TP->command_me("raus");
      }
      else if (!stringp(wea->QueryProp(P_BERSERKER_WAFFENKUNDE)) ||
          strstr(wea->QueryProp(P_BERSERKER_WAFFENKUNDE), getuid(TP)) == -1) 
        command("sag Mach doch mal 'Waffenkunde' auf Deine Axt, "+TPN+"!");
      else if (zeit > 10 && zeit < 1000 && !random(3)) 
        command("sag Du hast schon "+zeit+" Minuten nicht mehr "
                    "gewuetet, "+TPN+"!"); 
      else 
      {
        switch( random(4) )
        {
          case 0: command("sag Willkommen, Berserker "+TPN+"!"); break;
          case 1: command("sag Was kann ich Dir beibringen, "+TPN+"?"); break;
          case 2: command("sag Wann hast Du das letze Mal gewuetet, "+TPN+"?"); break;
          case 3: command("sag Zeig mir mal Deine Axt, "+TPN+"!"); break;
        }
      }
    }
  }
}

void give_notify(object ob)
{
  string wie;
  if( ob->QueryProp(P_WEAPON_TYPE)==WT_AXE)
  {
    if( stringp(wie=ob->QueryProp(P_NAME)) && wie[0..6] == "Kronang" && 
        ob->QueryProp(P_MAGIC) == 10 )
    {
      command("sag Oh! du hast meine Axt gefunden! Als Dank gebe ich Dir meine Berserkeraxt!");
      write("Kronang gibt Dir die Berserkeraxt.\n");
      say("Kronang gibt "+TP->name(WEM)+" die Berserkeraxt .\n", ({TP,}) );
      WLOG( LOG "Berserkeraxt", "bekommt eine Berserkeraxt von Kronang fuer "+ob->short());
      ob=clone_object(WEAPON "berserkeraxt");
      ob->SetProp(P_NAME, "Kronangs Berserkeraxt");
      ob->SetProp(P_SHORT, "Kronangs Berserkeraxt");
      ob->move(TP, M_NOCHECK);
      return;
    }
    switch(ob->QueryProp(P_WC) )
    {
      case 0..90: wie="unbrauchbare"; break;
      case 91..150 :wie="brauchbare"; break;
      case 151..200: wie="schoene"; break;
      case 201..250: wie="tolle"; break;
      case 251..280: wie="herrliche"; break;
      case 281..300: wie="wunderbare"; break;
    }
    if( balsam > 2 && member(balsamchance, getuid(TP)) == -1 )
    {
      balsamchance += ({ getuid(TP) });
      if( !ob->QueryProp("waffenbalsam") && random(3) &&
          ob->QueryProp(P_WC) > 150 && ob->QueryProp(P_NR_HANDS) == 2)
      {    
        command("sag Du solltest diese "+wie+" Axt besser pflegen, "+TPN+"!");
        command("emote schmiert "+ob->name(WEN)+" mit Waffenbalsam ein.\n");
        ob->SetProp("waffenbalsam",1);
        ob->Damage(-100);
        if( ob->QueryProp(P_WC) < MAX_WEAPON_CLASS-10 )
          ob->SetProp(P_WC, ob->QueryProp(P_WC)+random(10) );
        if( ob->QueryProp(P_WC_FIX) < 50 )
          ob->SetProp(P_WC_FIX, ob->QueryProp(P_WC_FIX)+2+random(5));
        if( ob->QueryProp(P_QUALITY_DECAY) != 0 )
          ob->SetProp(P_QUALITY_DECAY, ob->QueryProp(P_QUALITY_DECAY)+random(20) );
        balsam = 0;
      }
    }
    else
      command("sag Eine "+wie+" Axt hast Du da, "+TPN+"!");
    write("Kronang gibt Dir "+ob->name(WEN,1)+" wieder zurueck.\n");
    say("Kronang gibt "+TP->name(WEM)+" "+
        TP->QueryPossPronoun( ob->QueryProp(P_GENDER),WEN,SINGULAR)+" "
        +ob->name(RAW)+" wieder zurueck.\n", ({TP,}) );
    ob->move(TP, M_NOCHECK);
  }
  else
    return ::give_notify(ob);
}
  
void berserker_info() 
{
  mapping berserker;
  string *names;
  string text;
  int i, gender, level;
  mapping leveltxt;
  object ob;
   
  text="%s %s.";
  leveltxt = ([
      12: "";"ist Berserkergildenmeister und mir ebenbuertig"; 
          "ist Berserkergildenmeisterin und mir ebenbuertig",
      11: ""; "ist eine Berserkerlegende"; "ist eine Berserkerlegende",
      10: ""; "ist ein legendaerer Berserkermeister";
          "ist eine legendaerer Berserkermeisterin",
       9: ""; "ist ein Berserkermeister. Vielleicht ist er auch mal so gut, "
          "um in den Status eines legendaeren Berserkers aufzusteigen";
          "ist eine Berserkermeisterin. Vielleicht ist sie auch mal so gut, "
          "um in den Status einer legendaeren Berserkerin aufzusteigen",
       8: ""; "ist ein blutruenstiger Berserker";
          "ist eine blutruenstige Berserkerin",
       7: ""; "ist ein Berserker der Gildenstufe 7"; 
          "ist eine Berserkerin der Gildenstufe 7",
       6: ""; "ist ein Berserker der Gildenstufe 6";
          "ist eine Berserkerin der Gildenstufe 6",
       5: ""; "ist ein Berserker der Gildenstufe 5";
          "ist eine Berserkerin der Gildenstufe 5",
       4: ""; "ist ein Berserker der Gildenstufe 4";
          "ist eine Berserkerin der Gildenstufe 4",
       3: ""; "ist ein Berserker der Gildenstufe 3";
         "ist eine Berserkerin der Gildenstufe 3",
       2: ""; "ist ein Berserker der Gildenstufe 2";
          "ist eine Berserkerin der Gildenstufe 2",
       ]);
  call_other(INFOLIB_MASTER, "???");
  berserker=call_other(BMASTER, "QueryAll");
  names=m_indices(berserker);
  if(!pointerp(names)) return;
  for(i=sizeof(names)-1;i>=0;i--) 
  {
    if(!IS_LEARNER(names[i]) && berserker[names[i],1] > 4)
    {
      if(!INFOLIB_MASTER->GetInfo( NPC "kronang.lib", names[i], 2, this_object() ))
      {
        if((ob=find_player(names[i])) || (ob=find_netdead(names[i])))
          gender = ob->QueryProp(P_GENDER);
        else
          gender = MALE;
        if (stringp(leveltxt[berserker[names[i],1],gender]))    // (woody)
          AddInfo(({names[i]}), 
              sprintf(text, CAP(names[i]), leveltxt[berserker[names[i],1],gender]),
              "sagt: ");
      }
    }
  }
}

