void reset()
{
  object ob;
  ::reset();
  if( !is_clone(TO) ) return; 
  if( !random(3) )
    call_out("new_equip",10 );
  else if( !random(10) )
    call_out("berserker_info", 10);
  if( (ob=find_player("sisqui")) && !random(5) && !present("sisqui", MENV) )
    tell_object(ob, "Kronang knuddelt Dich aus der Ferne.\n");
  axt = ({});
  balsamchance = ({});
  balsam++;
  heal_self(3000);
}

void destruct_equip()
{
  object ob, next;
  for(ob=first_inventory();ob;)
  {
    next=next_inventory(ob);
    ob->remove(1);
    if( ob ) destruct(ob);
    ob=next;
  }
}

void new_equip()
{
  if( MENV )
    tell_room(MENV,"Kronang besorgt sich eine neue Ausruestung.\n");
  destruct_equip();
  ausruesten();
}

