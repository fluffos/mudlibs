public string barden_liedquest() {
  object task;
  if(TP->QueryProp(P_GUILD) == "bardengilde" && 
     !mappingp(TP->QuerySkill("toetet das biest") &&
    "/gilden/bardengilde/master/bardenmaster"->GetBardGroup(TP) == "korriax") &&
    !objectp(present("\nbard_gs8_task", TP))) {
      task = clone_object("/gilden/bardengilde/obj/quest/gs8_korriax_task");
      if(task->move(TP, M_GET|M_NOCHECK) != 1) {
        return "Fehler - Bardenaufgabe konnte nicht vergeben werden!";
      }
      return "Hab ich mir doch gedacht, dass so ein Baenkelsaenger mich nochmal aufsuchen wird. "
             "Frueher hab ich Korriax dabei geholfen die wahre Berserkerwut zu verstehen! Und dir "
             "kann ich auch helfen.\n"
             "Nachdem du ja kein Berserker bist kann ich dir das Wueten nicht einfach beibringen. "
             "Damit du aber trotzdem so richtig wuetend werden kannst, gibt es eine Froschart, deren "
             "Gift den Zorn entfesselt. Ich hab gehoert, dass es Schmuggler geben soll, die solche "
             "Froesche illegal importieren.\n"
             "Wenn du an einem solchen Frosch geleckt hast, brauchst du nur noch einen wuerdigen Gegner, "
             "um deiner Wut freien Lauf zu lassen! Ich denke so ein Braunbaer, wie ich ihn mit blossen "
             "Haenden erwuergt habe, waere genau das richtige fuer dich.";
    } else {
      return "Barden haben ja keine Ahnung von echter Wut! Das einzige Lied, dass "
             "wir Berserker singen ist der Schlachtruf. Allerdings habe ich dem "
             "Barden Korriax frueher mal geholfen die echte Berserkerwut zu verstehen.";
    }
}

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kronang, der Meister der Berserker");
  SetProp(P_LONG, BS(
    "Kronang ist der Meister der Berserkergilde. Frueher war er einmal "
    "ein gefuerchteter Kaempfer, aber nun hat er sich hier zurueckgezogen, "
    "um seinen Schuelern die Kampfkunst der Berserker beizubringen. "
    "Es ist ueber 2 Meter gross und hat gewaltige Muskeln. Obwohl sein Haar "
    "schon grau ist, ist er sicher noch ein gefaehrlicher Gegner."));
  SetProp(P_NAME, "Kronang");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"kronang", "meister", "\ngildenmeister", "BERSERKER",
           "berserker", "berserkermeister"}) );
  set_living_name("kronang");
  SetProp(P_SMELL, "Kronang riecht stark nach Schweiss.\n");
  AddDetail( ({"muskel", "muskeln"}), 
    "Einen so muskoloesen Menschen wie Kronang hast Du noch nie "
    "gesehen. Sicher kann er Dich mit seiner Axt in Stuecke hauen.");

  create_default_npc(50);
  SetProp(P_HANDS, ({" mit seinen riesigen Faeusten", 3000, DT_BLUDGEON}));
  SetAttribute(A_STR, 95);
  SetProp(P_XP, 70000000);
  SetProp(P_BODY, 500);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 200+random(10) );
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 80);
  SetProp(P_HP_DELAY, 0);

  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 12);
  call_other("/gilden/berserker","learn_berserker_skills", 10000, 10000); 
  ModifySkill(SK_CASTING, 8000 ); 
  //ModifySkill("blutrausch",   10000);
  //ModifySkill("blutrausch",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  
  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "stampft herein");
  SetProp(P_MMSGOUT, "stampft weit weg");

  SetProp(P_DIE_MSG,  " stirbt einen Berserkertod.\n");

  AddInfo(DEFAULT_INFO, ({
    "grummelt: So ein Bloedsinn!\n",
    "sagt neugierig: Gibts das wirklich?\n",
    "sagt: Aha.\n",
    "fragt: Meinst Du das wirklich so?\n",
    "sagt: Na so was!\n",
    "sagt: Pah!\n",
    "sagt: Frag doch einen Druiden!\n",
    "schaut Dich erstaunt an.\n",
    "sagt: Sowas ist nichts fuer einen echten Berserker!\n",
    "ignoriert Deine Frage.\n",
    "scheint Dich nicht verstanden zu haben.\n",
    "fragt: Warum fragst Du mich das?\n",
    "bruellt: Was willst Du, Du Feigling!\n",
    "schreit: Lass mich doch damit in Ruhe!\n",
    "knirscht mit seinen Zaehnen.\n",
    "fragt: Willst Du nicht lieber etwas ueber die Berserker erfahren?\n"}) );
  AddLibrary(NPC "kronang.lib", 2); 
  AddLibrary( "/d/dschungel/feyaria/tijara/npc/spieler.lib",1); 
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"stirnband", "blutrotes stirnband"}), #'stirnband);
  AddInfo( ({"neuem stirnband", "neues stirnband"}), CL(new_stirnband));
  AddInfo( ({"skills","faehigkeiten", "fertigkeiten"}), #'faehigkeiten, 1);
  AddInfo( ({"lerne", "lernen", "lern"}), #'lernen, 1);
  AddInfo( ({"stufe 9", "stufe neun", "gildenstufe 9"}), #'stufe9 ); 
  AddInfo( ({"stufe 10", "stufe zehn", "gildenstufe 10"}), #'stufe10 );
  AddInfo( ({"zauberlied", "toetet das biest", "bardenlied"}), #'barden_liedquest, "sagt: ");

  SetProp(P_LOG_INFO, "gilden/kronang");  

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Kronang zerstoert @WEN voller Berserkerwut!\n" }) );

  SetChats(2, ({
    "Kronang sagt: Die Berserkergilde ist die beste aller Gilden!\n",
    "Kronang schaerft seine Axt.\n",
    "Kronang massiert seinen gewaltigen Oberarm.\n",
    "Kronang konzentriert sich und staerkt seinen Willen.\n",
    "Kronang schaut grimmig durch die Gegend.\n",
    "Kronang wuetet herum und schuechtert Dich gewaltig ein.\n", 
    "Kronang spannt seine Muskeln an.\n",
    "Kronang prueft seine Ausruestung.\n",
    "Kronang steckt einen Edelstein in seine Berserkeraxt.\n",
    "Kronang knirscht mit den Zaehnen.\n",
    "Kronang spannt seinen gewaltigen Bizeps an.\n",
    "Kronang laesst seine Axt pfeifend durch die Luft sausen.\n",
    "Kronang schaut Dich veraechtlich an.\n"}) );
  //SetAttackChats(100, ({
  //  "@@use_spell@@" }) );
 
  axt = ({});  
  balsamchance = ({});
  balsam = 3;
  callout_counter = 0;
  SUID;
  ausruesten();
  call_out("berserker_info", 10);

  AddCmd( ({"bitte", "bitt"}), "cmd_bitten");
}

int cmd_bitten(string str)
{
  if(!(str == "kronang um axt" ||
       str == "kronang um meisteraxt" ||
       str == "kronang um berserkeraxt" ||
       str == "kronang um gildenmeisteraxt")) return 0;

  if(call_other(BMASTER, "FetchAxe", TP) == -1)
    command_me("sag Du bist nicht wuerdig diese Waffe zu erlangen!");
  else
    command_me("sag Hier nimm diese maechtige Axt als Lohn fuer Deine Muehen!");
  return 1;
}

void Attack(object enemy) 
{
  object *shield;

  if (!present("\nberserker_blutrausch")) 
  {
    SetProp(P_LAST_WUETEN_TIME, time() );
    command_me("blutrausch"); 
  }
  if (!random(10) && sizeof(shield = enemy->QueryArmours(AT_SHIELD)))
  {
    tell_object(enemy, "Kronang zertruemmert Deinen Schild.\n");
    tell_room(MENV, "Kronang zertruemmert "+enemy->name(WESSEN,1)+" Schild.\n", 
        ({enemy}));
    shield[0]->remove();
  }
  return ::Attack(enemy);
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  if (!query_once_interactive(enemy) && enemy->QueryProp(P_FRIEND))
  {
    enemy->remove();
    return 0;
  }
  if (!random(5) && !enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1 + random(2));
  else if (!random(5) && !enemy->QueryProp(P_DISABLE_SPELLS))
    enemy->SetProp(P_DISABLE_SPELLS, 1 + random(2));
  if (time() - (enemy->QueryProp(P_LAST_MOVE)) <= 6)
    dam /= 5;
  else if (dam > 900) 
    dam = 900;
  return ::Defend(dam, dtype, spell, enemy);
}


void heart_beat()
{
  int i;
  object *enemies;

  ::heart_beat();
  if(InFight() && !random(4) && sizeof(enemies = PresentEnemies()) >= 3)
  {
    tell_room(environment(this_object()),
        "Kronang macht einen brutalen Rundumschlag!\n");
    for(i = sizeof(enemies) - 1; i >= 0; i--)
    {
      enemies[i]->SetProp(P_PARALYZED, 1 + random(2));
      enemies[i]->Defend(500 + random(500), DT_SLASH, 
          ([SP_NAME:"rundumschlag", SP_SHOW_DAMAGE:1, SP_PHYSICAL_ATTACK:1]), 
          this_object());
    }
  }
}
