  if( TP->QueryProp(P_SP)+TP->QueryAttribute(A_DEX)+(l=enemy->QueryProp(P_LEVEL)) 
      > random(350) && (edelstein || (TP->id("berserker")&& !random(5)) ) )
  {
    write("Die Axt schlaegt besonders stark zu.\n");
    if ( !random(5) )
    {
      edelstein=0;
      write("Die Kraft des Edelsteins hat sich verbraucht.\n");
