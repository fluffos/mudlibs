string einbucht()
{
  if( edelstein )
    return "In der kleinen Einbuchtung befindet sich "+gem_name+".\n"; 
  else
    return BS("Die Einbuchtung ist so klein, dass man nur einen kleinen "
              "Edelstein dort REINSTECKEN koennte.");
}

int stecken(string str)
{
  string was;
  object ob;
  notify_fail("Was willst Du wo hinein stecken?\n");
  if( !str) return 0;
  if( sscanf(str, "%s in einbuchtung",was)!=1 )
  was=str;
  {
    if( ob=present(was,TP) )
    {
      if( ob->id("EDELSTEIN") )
      {
        if(!edelstein)
        {
          if( ob->id("rubin") )            edelstein=RUBIN;
          else if( ob->id("aquamarin") )   edelstein=AQUAMARIN;
          else if( ob->id("topas") )       edelstein=TOPAS;
          else if( ob->id("smaragd") )     edelstein=SMARAGD;
          else if( ob->id("saphir") )      edelstein=SAPHIR;
          else if( ob->id("opal") )        edelstein=OPAL;
          else if( ob->id("lapislazuli") ) edelstein=LAPISLAZULI;
          else if( ob->id("onyx") )        edelstein=ONYX;
          else if( ob->id("amethyst") )    edelstein=AMETHYST;
          else if( ob->id("bernstein") )   edelstein=BERNSTEIN;
          else if( ob->id("granat") )      edelstein=GRANAT;
          else if( ob->id("zirkon") )      edelstein=ZIRKON;
          else if( ob->id("diamant") )     edelstein=DIAMANT;
          else if( ob->id("turmalin") )    edelstein=TURMALIN;
          else if( ob->id("bergkristall") )edelstein=BERGKRISTALL;
          else if( ob->id("tigerauge") )   edelstein=TIGERAUGE;
          if(!edelstein)
          {
            write("Der Edelstein passt leider nicht!\n");
            return 1;
          }
          if( TP->QueryProp(P_SP) < COST )
          {
            write("Dafuer hast Du zu wenig Magiepunkte!\n");
            return 1;
          }
          SetProp(P_DAM_TYPE, ({DT_SLASH})+({dt[edelstein]}) );
//          SetProp(P_DAM_TYPE, ({dt[edelstein]}) );
          write("Du steckst "+ob->name(WEN)+" in die Einbuchtung hinein.\n");
          TP->AddSp(-COST);
          gem_name=ob->name(WER);
          gem_name2=ob->name(WESSEN, 1);
          ob->AddAmount(-1);
          hits = 0;
          if( ob->QueryProp(P_AMOUNT)<1 ) ob->remove();
          return 1;
        }
        else
          notify_fail("Da steckt schon ein Edelstein in der Einbuchtung.\n");
      }
      else
        notify_fail( CAP(ob->name(WER))+" ist doch gar kein Edelstein!\n");
    }
    else 
      notify_fail(CAP(was)+"? Sowas hast Du doch gar nicht!\n");
  }
  return 0;
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);
}

