#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "/p/daemon/itemd/itemd.h"

#define COST 5 // Kosten fuer edelstein reinstecken 
#define MIN_HITS 10 // solang haelt der edelstein mindestens

/*  
 *  Turmalin:     DT_UNHOLY
 *  Bergkristall: DT_HOLY    
 *  Tigerauge:    DT_MIND
 *  Amethyst:     violett, DT_SOUND
 *  Bernstein:    leuchtend gelb, DT_LIGHT, Kristallwald (sargola)
 *  Opal:         magisch in allen Farben schillernd, DT_MAGIC, Dschungel (dante)
 *  Lapislazuli:  aetzend gruen, DT_ACID, Dschungel (dante)
 *  Onyx:         schrecklich schwarz, DT_TERROR, ??? (???)
 *  Zirkon:       braun, DT_ELECTIRC, ??? (???)
 *  Topas:        sonnengelb, DT_AIR, Dschungel (dante)
 *  Granat:       dunkelrot, DT_LIGHTNIG, ??? (???)
 *  Aquamarin:    wasserblau, DT_WATER, Feenschloss (trogor)
 *  Smaragd:      giftgruen, DT_POISON, Dschungel (dante)
 *  Saphir:       eisblau, DT_COLD, Dschungel (dante)
 *  Rubin:        feuerrot, DT_FIRE , Zwergenmine (angrox)
 *  Diamant:      durchsichtig, DT_EXPLOSION, Dschungel (dante)
 */

#define TURMALIN 1
#define BERGKRISTALL 2
#define TIGERAUGE 3
#define AMETHYST 4
#define BERNSTEIN 5 
#define OPAL 6
#define LAPISLAZULI 7
#define ONYX 8
#define ZIRKON 9 
#define TOPAS 10
#define GRANAT 11
#define AQUAMARIN 12
#define SMARAGD 13
#define SAPHIR 14
#define RUBIN 15
#define DIAMANT 16


string gem_name, gem_name2;
int edelstein;
string *dt;
int hits=0;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();
  
  if(!IS_ARCH(previous_object()) && 
     file_name(previous_object())[0..28]!= "/gilden/berserker/npc/kronang" && 
     file_name(previous_object())[0..29]!= "/gilden/berserker/epic/gegner8" &&
     file_name(previous_object())[0..27]!= "/spellbooks/berserker_spells" && 
     file_name(previous_object())[0..27]!= "/gilden/berserker" ) 
  {
    if (this_interactive() && IS_LEARNER(this_interactive()))
    {
      raise_error("Illegales Clonen der Berserkeraxt!!!!\n");
      destruct(this_object());
      return;
    }
  }
  
  dt=({DT_SLASH, DT_UNHOLY, DT_HOLY, DT_MIND, DT_SOUND, DT_LIGHT, 
      DT_MAGIC, DT_ACID, DT_TERROR, DT_ELECTRIC, DT_AIR, DT_LIGHTNING, 
      DT_WATER, DT_POISON, DT_COLD, DT_FIRE, DT_EXPLOSION});

  SetProp(P_SHORT, "Eine Berserkeraxt");
  SetProp(P_LONG, BS( 
    "Das ist die Axt eines Berserkers. Sie hat einen langen Holzstiel und "
    "ein grosses, doppelschneidiges Axtblatt. Am Ende des Holzstiels "
    "befindet sich unterhalb des Griffes eine kleine Einbuchtung.") );
  SetProp(P_INFO, BS(
    "Diese Axt koennen nur Berserker verwenden.") );
  SetProp(P_NAME, "Berserkeraxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"berserkeraxt", "axt", "baxt", "\nberserkeraxt"}) );
  AddDetail( ({"stiel", "holzstiel"}),
    "Der Holzstiel ist ueber einen Meter lang und hat einen ledernen Griff "
    "am unteren Ende. Dort befindet sich auch eine kleine Einbuchtung. Am "
    "oberen Ende ist das grosse Axblatt angebracht.");
  AddDetail( ({"blatt", "axtblatt"}),
    "Das Axtblatt hat zwei grosse, scharfe Schneiden und ist aus einem "
    "sehr hartem Stahl geschmiedet.");
  AddSpecialDetail( ({"einbuchtung"}), "einbucht");

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 290 + random(11));
  SetProp(P_WC_FIX, 25 + random(11));
  SetProp(P_WC_BONUS, (["BERSERKER": 200, "kronang": 300]) );
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_QUALITY_DECAY, 350);
  SetProp(P_MATERIAL, ([MAT_WOOD: 60, MAT_ADAMANT: 40]) )  ;
  Set(P_WEIGHT, 5500);
  SetProp(P_TOTAL_WEIGHT, 5500);
  SetProp(P_VALUE, 29000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, A_STR: 40, P_XP: 50000000]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 1 + random(5), P_SP: 1 + random(5)]) );

  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_BERSERKER_BONUS, (["all": 25]) );

  AddCmd( ({"reinsteck", "reinstecke"}), "stecken");

  SetProp("waffenbalsam", 10);
  if (file_name(previous_object())[0..28]!= "/gilden/berserker/npc/kronang") 
  {
    SetProp(P_ITEMD_TMPMAGIC, ({1000, 1000}) );
    find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
  }
}

int WieldFunc(object waffe, int silent)
{
  if( TP->id("BERSERKER") ) return 1; 
  if( TP->QueryProp(P_GUILD) == "berserker" )
  {
    if( TP->QueryProp(P_GUILD_LEVEL) < 10 )
    {
      write("Nur Berserkermeister koennen mit dieser Axt kaempfen!\n");
      return 0;
    }
    if( !silent )
      write("Ein Gefuehl der Macht durchdringt Dich.\n");
    return 1;
  }
  if( !silent )
    write("Du musst schon ein Berserker sein, um diese Axt verwenden zu "
          "koennen.\n");
  return 0;
}

void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if (edelstein)  
  {
    edelstein = 0;
    write("Die Kraft " + gem_name2 + " hat sich verbraucht.\n");
    SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  }
}

#define MAX_BONUS 200

int HitFunc( object enemy )
{
  int x, r;
  object wer;

  x = -10;
  wer = QueryProp(P_WIELDED);

  if( !random(5 * enemy->QueryProp(P_LEVEL)) )
  {
    x = 5 + random(35);
    write("Die Berserkeraxt schlaegt besonders stark zu.\n");
    r = (interactive(wer) ? random(edelstein) + 2 : 20) * 
      (random(wer->QueryAttribute(A_STR) * 2) + 
       random(enemy->QueryProp(P_LEVEL) * 3));
    r = x + random(r);
  }
  else if (edelstein && !random(20) )
  {
    r = random(edelstein) * random(wer->QueryAttribute(A_STR));
    if (r > 50)
      write("Die Magie " + gem_name2 + " wendet sich gegen " + 
          enemy->name(WEN,1) + ".\n");
    x = 5 + random(15);
  }
  if ( edelstein && (hits++) > MIN_HITS && !random(40 - x) )
  {
    edelstein = 0;
    write("Die Kraft " + gem_name2 + " hat sich verbraucht.\n");
    wer->AddSp(-COST);
    SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  }
  if (interactive(wer))
  {
    r = r / 3 + 2 * random(r / 3);
    r = (r > MAX_BONUS ? MAX_BONUS : r);
  }
  if (r) 
    wer->AddSp(-random(r / 30));
  return r;
}
