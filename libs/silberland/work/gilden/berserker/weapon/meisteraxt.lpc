// Die Axt des Berserkergildenmeisters 
// 14-7-2004  Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <wizlevels.h>

void create()
{
  if (!is_clone(TO) )  return;

  ::create();
  if(!IS_ARCH(previous_object()) && 
     file_name(previous_object()) != "/gilden/berserker/master/berserkermaster" )
  {
    raise_error("Illegales Clonen der Berserkeraxt!!!!\n");
    destruct(this_object());
    return;
  }

  SetProp(P_SHORT, "Die Axt des Berserkergildenmeisters");
  SetProp(P_LONG, 
    "Das ist die Axt eines Berserkers. Sie hat einen langen Holzstiel und "
    "ein grosses, mit Dornen besetztes Axtblatt und einen maechtigen "
    "Hammerkopf auf der gegenueberliegenden Seite. An der Spitze befindet "
    "sich zusaetzlich noch ein langer Stachel.");
  SetProp(P_NAME, "Berserkeraxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"berserkeraxt", "axt", "baxt", "\nberserkeraxt", 
        "berserkergildenmeisteraxt", "meisteraxt", "gildenmeisteraxt"}) );
  AddDetail( ({"stiel", "holzstiel"}),
    "Der Holzstiel ist ueber einen Meter lang und hat einen ledernen Griff "
    "am unteren Ende. Am oberen Ende ist die grosse Axtklinge angebracht.");
  AddDetail( ({"blatt", "axtblatt", "klinge", "axtklinge"}),
    "Das Axtblatt ist aus extrem harten Adamant geschmiedet.");
  SetProp(P_INFO,BS(
      "Du kannst entweder die Axtklinge, die Dornen, den Hammerkopf oder "
      "den Stachel zum Zuschlagen verwenden."));

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 295+random(6));
  SetProp(P_WC_FIX, 35+random(6));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_QUALITY_DECAY, 550);
  SetProp(P_MATERIAL, ([MAT_WOOD:60, MAT_ADAMANT:40]) )  ;
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 500000);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 12);
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD: "berserker", P_GUILD_LEVEL: 12]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:2+random(6), P_SP:1+random(4)]) );

  SetProp(P_BERSERKER_BONUS, (["all":30]) );

  SetProp("waffenbalsam", 9);

  AddCmd( ({"verwende", "verwend"}), "cmd_verwenden");

  SetProp(P_ITEMD_TMPMAGIC, ({1000, 1000}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int cmd_verwenden(string str)
{
  if(!QueryProp(P_WIELDED))
    return 0;
  if(str == "axtklinge")
  {
    SetProp(P_DAM_TYPE, ({DT_SLASH}) );
    write("Du verwendest nun die Axtklinge im Kampf.\n");
    return 1;
  }
  else if(str == "dornen")
  {
    SetProp(P_DAM_TYPE, ({DT_RIP}) );
    write("Du verwendest nun die Dornen im Kampf.\n");
    return 1;
  }
  else if(str == "hammerkopf")
  {
    SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
    write("Du verwendest nun den Hammerkopf im Kampf.\n");
    return 1;
  }
  else if(str == "stachel")
  {
    SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
    write("Du verwendest nun den Stachel im Kampf.\n");
    return 1;
  }
  notify_fail("Willst Du die Axtklinge, die Dornen, den Hammerkopf oder den Stachel verwenden?\n");
  return 0;
}
