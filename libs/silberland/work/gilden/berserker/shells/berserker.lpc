
inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>

#define GILDE "/gilden/berserker"

nosave int lev, hbonus;

void create()
{
  base::create();

  SetDefaultHome(GILDE);
  SetPrayRoom(GILDE);

  AddId("Berserkerspieler");
  SetProp(P_AVERAGE_SIZE, 250);
  SetProp(P_AVERAGE_WEIGHT, 250000);
  SetProp(P_ATTRIBUTES_OFFSETS, ([ A_STR:6, A_DEX:0, A_CON:5, A_INT:-2 ]) );
  SetProp(P_MAX_FOOD, 150);
  SetProp(P_MAX_DRINK, 100);
  SetProp(P_MAX_ALCOHOL, 100);
  SetProp(P_FOOD_DELAY, 15);
  SetProp(P_DRINK_DELAY, 15);
  SetProp(P_ALCOHOL_DELAY, 7);
  SetProp(P_HP_DELAY, 0);
  SetProp(P_SP_DELAY, 6);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:5,T_RANGE_MAX:30]));
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN,"berserkt herein");
  SetProp(P_MSGOUT,"berserkt");

  SetProp(P_BODY, 10);
  SetProp(P_HANDS, ({" mit der Kraft eines Berserkers",50,DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_TERROR    : -0.3,
         DT_AIR       : -0.2,
         DT_TERROR    : -0.2,
         DT_BLUDGEON  : -0.1,
         DT_MAGIC     :  0.2,
         DT_MIND      :  0.4]) ) ;

  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       7,
         TT_HOUSE:      10,
         TT_HILL:       9,
         TT_FOREST:     10,
         TT_TOWN:       10,
         TT_MOUNTAIN:   7,
         TT_DESERT:     16,
         TT_JUNGLE:     15,
         TT_SWAMP:      25,
         TT_PLAIN:      7,
         TT_ARCTIC:     14,
         TT_UNDERWATER: 13,
         TT_WATER:      25,
         TT_ROAD:       6 ]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_SOLID: -50,
         MATGROUP_FLUID: -50,
         MATGROUP_GAS:   -50]) );
}

void FinalSetup()
{
  ::FinalSetup();
  lev = QueryProp(P_LEVEL);
  if (lev >= 50) hbonus = 101; else hbonus = lev * 2 + 1;   // Hands-Bonus
}

string _query_race()
{
  return "Berserker";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Berserkerin","Berserkerin","Berserkerin","Berserkerin"});
  return ({"Berserker","Berserker","Berserker","Berserker"});
}

string _query_racedescr()
{
  return break_string(
      "Berserker sind gewaltige Muskelprotze, deren einzige "
      "Staerke im Kampf liegt. Sie erholen sich schnell von "
      "ihren Verletzungen und bewegen sich ausdauernd in "
      "beinahe jedem Gelaende. Weniger ueberzeugend sind ihr "
      "Verstand, und ihr Geschick - wobei sich letzteres "
      "durch Uebung und Erfahrung ausgleichen laesst. "
      "ACHTUNG: Diese Rasse ist nur fuer waschechte Berserker!", 78);
}

int QueryAllowSelect() { return 0; }

int _query_body()
{
  return Query(P_BODY)+lev/2;
}

_query_hands()
{
  mixed h;
  h=Query(P_HANDS);
  return ({ h[0], h[1]+random(hbonus), h[2] });
}

void reset()
{
  if (file_name()[0..4]=="/std/") {
    set_next_reset(-1);
    return;
  }
  lev = QueryProp(P_LEVEL);     // Einmal pro Reset geschieht die Anpassung
  if (lev >= 50) hbonus = 101; else hbonus = lev * 2 + 1;   // Hands-Bonus!
  ::reset();
}

string *_query_default_guild_male_titles()
{
      // Egal, weil seher wenn diese Rasse
      return ({
        "der maechtige Berserker" });
}

string *_query_default_guild_female_titles()
{
      // Egal, weil seher wenn diese Rasse
      return ({
       "die maechtige Berserkerin" });
}

mixed RaceDefault(string arg)
{
  if (!arg)
    return 0;
  switch(arg) {
    case P_HANDS : return ({" mit der Kraft eines Berserkers",50,DT_BLUDGEON});
    case P_BODY :  return 10;
  }
  return ::RaceDefault(arg);
}

varargs void die(int poisondeath)
{
  GILDE->InformDeath(this_object(), poisondeath ? 0 : QueryProp(P_KILLER));
  ::die(poisondeath);
}
