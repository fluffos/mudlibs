#include <defines.h>
#include <moredef.h>

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>

string old_msgout;
object opfer;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein ausgerissener Baum");
  SetProp(P_LONG, "Ein ausgerissener Baum liegt hier.");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Baum");
  SetProp(P_NAME_ADJ, "ausgerissen");
  AddId( ({"baum", "\nberserker_baum"}) );
  AddAdjective( ({"ausgerissener", "ausgerissenen"}) );  

  SetProp(P_WEIGHT, 10000000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, "Der Baum ist viel zu schwer.\n");
}

void reset()
{
  ::reset();
  remove();
}
