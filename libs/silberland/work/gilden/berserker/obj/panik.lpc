// panik.c
// 1997-09-28  Feyaria@SilberLand

#include <defines.h>
#include <moredef.h>

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>

string old_msgout;
object opfer;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0);
  AddId( ({"\nberserker_panik"}) );

  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);
}

void fluechten(string wem)
{
  if ( file_name(PO)!="/spellbooks/berserker_spells" )
  {
    call_out("remove",0);
    return;
  }
  opfer = environment();
  old_msgout = opfer->QueryProp(P_MSGOUT);
  opfer->SetProp(P_MSGOUT, "fluechtet voller Angst vor " + wem);
  opfer->SetProp(P_WIMPY, opfer->QueryProp(P_MAX_HP) - 1);
  opfer->CheckWimpyAndFlee();
  call_out("fluechten2", 2);
}

void fluechten2()
{
  if (!opfer) 
  {
    remove();
    return ;
  }
  opfer->SetProp(P_WIMPY, opfer->QueryProp(P_MAX_HP) - 1);
  opfer->CheckWimpyAndFlee();
  if (random(8)) call_out("fluechten2", 2);
  else call_out("aus",2);
}

void aus()
{
  if (opfer)
    opfer->SetProp(P_MSGOUT, old_msgout);
  remove();
}

void init()
{
  ::init();
  if( ! living(environment()) )
    call_out("remove",0);
}

