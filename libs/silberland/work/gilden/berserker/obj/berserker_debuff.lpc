inherit "/std/thing";

#include "../def.h"
#include "../berserker_talente.h"

private string endMessage;

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    AddId(({BERSERKER_DEBUFF_ID}));

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_WEIGHT, 0);  
    SetProp(P_VALUE, 1);
    SetProp(P_NOBUY, 1); 
    SetProp(P_NODROP, 1);
    SetProp(P_NOGET, 1);
    SetProp(P_NEVERDROP, 1);
    SetProp(P_NOSELL, 1);
}

public void set_timeout(int duration) {
    while(find_call_out("remove") != -1) remove_call_out("remove");
    call_out("remove", duration, 1);
}

public void set_end_message(string message) {
    endMessage = message;
}


public void set_debuff(int val) {
    SetProp(P_X_ATTR_MOD, ([A_STR: val, A_DEX: val]));
    set_timeout(30);
    set_end_message("Dein Koerper erholt sich wieder.");
    ENV(TO)->UpdateAttributes();
    return;
}

public int remove(int silent) {
    if(stringp(endMessage) && objectp(environment(this_object()))) {
        tell_object(environment(this_object()), BS(endMessage));
        environment(this_object())->UpdateAttributes();
    }

    return ::remove(silent);
}
