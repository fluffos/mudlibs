#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "../skillmaster.h" 


void create()
{
  if (is_clone(TO)) {
    destruct(this_object());
    return ;
  }
  SUID; 
}

nomask int query_prevent_shadow() { return 1; }
        
varargs mixed obtain_skill(object pl, int flag) {
   int start_skill, maxskill, maxunlearn, x;
   switch(pl->QueryProp(P_RACE)) {
     case "Zwerg": start_skill=1000; maxskill=10000; maxunlearn=9000; break;
     case "Elf": 
     case "Dunkelelf": 
     case "Fee": 
     case "Oger":
     case "Troll": start_skill=0; maxskill=5000; maxunlearn=2500; break;
     default: start_skill=200; maxskill=6000; maxunlearn=3000;
   }
   call_other(SKILLMASTER, "???");
   if(!flag) {
      return SKILLMASTER->AddSkill(pl, SK_PROSPECT, start_skill, maxskill, 
         maxunlearn, SK_PROSPECT_NAME);
   }
   return ({start_skill,maxskill,maxunlearn});
}
