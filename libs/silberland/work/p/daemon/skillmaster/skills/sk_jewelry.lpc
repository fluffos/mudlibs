#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "../skillmaster.h" 


void create()
{
  if (is_clone(TO)) {
    destruct(this_object());
    return ;
  }
  SUID; 
}

nomask int query_prevent_shadow() { return 1; }
        
varargs mixed obtain_skill(object pl,int flag) {
   int start_skill, maxskill, maxunlearn;
   int x;
   switch(pl->QueryProp(P_RACE)) {
     case "Mensch": start_skill=250; maxskill=10000; maxunlearn=9000; break;
     case "Hobbit": start_skill=500; maxskill=10000; maxunlearn=9000; break;
     case "Zwerg": start_skill=750; maxskill=10000; maxunlearn=9000; break;
     case "Elf": start_skill=300; maxskill=10000; maxunlearn=9000; break;
     case "Dunkelelf": start_skill=300; maxskill=10000; maxunlearn=9000; break;
     case "Fee": start_skill=350; maxskill=10000; maxunlearn=9000; break;
     case "Oger": start_skill=50; maxskill=9000; maxunlearn=6000; break;
     case "Troll": start_skill=50; maxskill=9000; maxunlearn=6000; break;
     default: start_skill=250; maxskill=9990; maxunlearn=9000;
   }
   call_other(SKILLMASTER, "???");
   if(!flag) {
     return SKILLMASTER->AddSkill(pl, SK_JEWELRY, start_skill, maxskill,
         maxunlearn, SK_JEWELRY_NAME);
   }
   return ({start_skill,maxskill,maxunlearn});
}
