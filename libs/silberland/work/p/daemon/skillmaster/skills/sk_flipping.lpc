#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "../skillmaster.h" 


void create()
{
  if (is_clone(TO)) {
    destruct(this_object());
    return ;
  }
  SUID; 
}

nomask int query_prevent_shadow() { return 1; }
        
varargs mixed obtain_skill(object pl, int flag) {
  int start_skill, maxskill, maxunlearn;
  int dex;

  dex = pl->QueryAttribute(A_DEX);

  start_skill=1000 + ((random(3)+2) * (dex*10));
  maxskill=10000; maxunlearn=4000;
  call_other(SKILLMASTER, "???");
  if(!flag) {
    return SKILLMASTER->AddSkill(pl, SK_FLIPPING, start_skill, maxskill,
      maxunlearn, SK_FLIPPING_NAME);
  }
  return ({start_skill,maxskill,maxunlearn});
}

