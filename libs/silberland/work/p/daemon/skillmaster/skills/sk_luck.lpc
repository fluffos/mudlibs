#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "../skillmaster.h" 


void create()
{
  if (is_clone(TO)) {
    destruct(this_object());
    return ;
  }
  SUID; 
}

nomask int query_prevent_shadow() { return 1; }
        
varargs mixed obtain_skill(object pl,int flag) {
   int start_skill, maxskill, maxunlearn, x;
   switch(pl->QueryProp(P_RACE)) {
     case "Zwerg":
     case "Hobbit":
     case "Elf": 
     case "Dunkelelf": 
     case "Fee": 
     default: start_skill=0; maxskill=3000; maxunlearn=3000;
   }
   call_other(SKILLMASTER, "???");
   if(!flag) {
      return SKILLMASTER->AddSkill(pl, SK_LUCK, start_skill, maxskill, 
          maxunlearn, SK_LUCK_NAME);
   }
   return ({start_skill,maxskill,maxunlearn});
}
