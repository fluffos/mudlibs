#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "../skillmaster.h" 


void create()
{
  if (is_clone(TO)) {
    destruct(this_object());
    return ;
  }
  SUID; 
}

nomask int query_prevent_shadow() { return 1; }
varargs mixed obtain_skill(object pl, int flag) {
   int start_skill, maxskill, maxunlearn;
   int x;
   switch(pl->QueryProp(P_RACE)) {
     case "Zwerg": start_skill=1000; maxskill=10000; maxunlearn=9000; break;
     case "Elf": start_skill=200; maxskill=9800; maxunlearn=9000; break;
     case "Fee": start_skill=200; maxskill=9800; maxunlearn=9000; break;
     case "Oger": start_skill=500; maxskill=10000; maxunlearn=8000; break;
     case "Troll": start_skill=500; maxskill=10000; maxunlearn=8000; break;
     default: start_skill=200; maxskill=9900; maxunlearn=9000;
   }
   call_other(SKILLMASTER, "???");
   if(!flag) {
     return SKILLMASTER->AddSkill(pl, SK_ARMOURSMITHING, start_skill, maxskill,
         maxunlearn, SK_ARMOURSMITHING_NAME);
   }
   return ({start_skill,maxskill,maxunlearn});
}
