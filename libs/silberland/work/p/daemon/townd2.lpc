#pragma strong_types

#include <wizlevels.h>
// #include "townd2.h"

#define TD_SAVEFILE     "/p/daemon/save/townd2"
#define TD_NETNAME      "netname"
#define TD_TOWN         "town"
#define TD_DESC         "descr"
#define TD_COUNTRY      "country"

#define LOCALHOST       ([ TD_NETNAME:"localnet", \
                              TD_TOWN:"Wien", \
                              TD_DESC:"Der Mudrechner", \
                           TD_COUNTRY:"at" ])

mapping net;            // contains net-2-location mapping
mapping domain;         // contains host/domainname-2-location mapping
mapping location;       // contains host or net information
mapping tlevel;         // contains toplevel-2-country mapping
mapping country;        // contains toplevel-2-countrycode mapping

int security()
{
  return IS_ARCH(this_interactive());
}

void create()
{
  seteuid(getuid());
  if (!restore_object(TD_SAVEFILE))
  {
    location = ([ "localnet" : LOCALHOST ]);
    domain = ([ "localhost":"localnet" ]);
    net = ([ "127.0.0.1/32":"localnet" ]);
    tlevel = ([ "at":"Oesterreich" ]);
    country = ([ "at":"A" ]);
    save_object(TD_SAVEFILE);
  }
}

int remove()
{
  save_object(TD_SAVEFILE);
}

int AddToplevel(string str,string countryname, string countrycode)
{
  if (!security())
    return -1;
  if (!stringp(str) || !stringp(countryname) || !stringp(countrycode))
    return -2;
  if (member(tlevel,str))
    return -3;

  tlevel += ([str:countryname]);
  country += ([str:countrycode]);
  save_object(TD_SAVEFILE);
  return 1;
}

int RemoveToplevel(string str)
{
  if (!security()) return -1;
  if (!stringp(str)) return -2;
  if (!member(tlevel,str)) return -3;
  efun::m_delete(tlevel,str);
  efun::m_delete(country,str);
  save_object(TD_SAVEFILE);
  return 1;
}

mixed QueryToplevel(string str)
{
  if (!member(tlevel,str)) return 0;
  return tlevel[str];
}

mixed QueryCountrycode(string str)
{
  if (!member(country,str)) return 0;
  return country[str];
}

// mixed Query

