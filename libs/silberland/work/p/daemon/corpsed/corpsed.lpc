// SAVE-Variablen
mixed talismans=({});

private nosave string next_is_a_special="";
private nosave int zombieevent=0;
private nosave int ghostevent=0;
private nosave mapping b11_chances;
private nosave string* b11_names;

nosave object clone_potion(object ob);
nosave varargs object clone_rune(object ob, int level, string predef_rune);
nosave object clone_talisman(object ob, int level);
nosave object clone_dragonlance(object ob);
nosave int get_item(object item, object killer, object ob);
nosave int save_all();
void check_talisman();
nosave void InformPlayer(object ob);
nosave mixed b11(object ob);
nosave object clone_mithril(object ob);

void create() 
{
  if (is_clone(this_object())) {
    destruct(this_object());
    return; 
  }
  seteuid(getuid(this_object()));
  restore_object(CORPSED_SAVEFILE);
  b11_chances = B11_CHANCES;
  b11_names = m_indices(b11_chances);
  call_out("check_talisman",2);
}

nosave int save_all() 
{
  save_object(CORPSED_SAVEFILE);
  return 1;
}

int cloneitems(object ob) {
  int i, lvl;
  int helpvar;
  object item,killer;

  if(file_name(PO)[0..10] != "/std/corpse") {
    raise_error(sprintf("Illegaler Aufruf, PO: %O, TP: %O",PO,TP));
    return 0;
  }
  killer=ob->QueryProp(P_KILLER);
//  if( !killer || // Nur wenn killer gesetzt ist darf ein Item geclont werden 
//      !interactive(killer) ||   // keine NPCs
//      (IS_LEARNER(killer) || // keine Magier
//      killer->QueryProp(P_TESTPLAYER)) && // und Testspieler auch nicht
//      next_is_a_special == "" )) // ausser ueber direkten aufruf
////    return 1; 

  lvl=ob->QueryProp(P_LEVEL);
  //
  //  NPC steht als Zombie wieder auf
  //
#ifndef DISABLE_ZOMBIE  
  if( (!random(ZOMBIE_CHANCE) && ob->QueryProp(P_ALIGN)<0 && 
      ob->QueryProp(P_LEVEL)>15 && member(CORPSED_NO_ZOMBIE,killer)==-1) 
      || explode(next_is_a_special,":")[0]=="zombie" || zombieevent>0 )
  {
    TELL("angrox", sprintf("%s** CORPSED ZOMBIE%s: Killer: %O, NPC: %O\n", 
          ANSI_RED, ANSI_NORMAL,ob->QueryProp(P_KILLER),ob));
    TELL("feyaria", sprintf("%s** CORPSED ZOMBIE%s: Killer: %O, NPC: %O\n", 
          ANSI_RED, ANSI_NORMAL,ob->QueryProp(P_KILLER),ob));
    log_file(CORPSEDLOG, sprintf("ZOMBIE: Killer: %O, NPC: %O\n", 
          ob->QueryProp(P_KILLER),ob));
    call_out("create_zombie",0, PO);
    if( zombieevent >0) zombieevent--;
  }
#endif
  //
  //  NPC kehrt als Geist zurueck
  //
#ifndef DISABLE_GHOST 
  else if( (!random(555) && ob->QueryProp(P_ALIGN)>0  && 
        member(CORPSED_NO_GHOST,killer)==-1 ) ||
      (dtime(time())[19..20]=="00" && !random(55) ) ||  // Geisterstunde!!!!
      explode(next_is_a_special,":")[0]=="geist" || 
      explode(next_is_a_special,":")[0]=="ghost" || ghostevent>0 )
  {
    TELL("angrox", sprintf("%s** CORPSED GHOST%s: Killer: %O, NPC: %O\n", 
          ANSI_RED, ANSI_NORMAL,ob->QueryProp(P_KILLER),ob));
    TELL("feyaria", sprintf("%s** CORPSED GHOST%s: Killer: %O, NPC: %O\n", 
          ANSI_RED, ANSI_NORMAL,ob->QueryProp(P_KILLER),ob));
    log_file(CORPSEDLOG, sprintf("GHOST: Killer: %O, NPC: %O\n", 
          ob->QueryProp(P_KILLER),ob));
    call_out("create_ghost",0, PO);
    if( ghostevent >0) ghostevent--;
  }
#endif
  //
  // Clonen der Teile fuer Berserkerstufe 11
  //
#ifndef DISABLE_B11 
  if ( killer->QueryProp(P_GUILD) == "berserker" && 
       killer->QueryProp(P_GUILD_LEVEL) == 10 && 
       member(b11_names, explode(file_name(ob),"#")[0]) != -1 &&
       killer->QueryProp(P_LEVEL) > 60 &&
       killer->QueryProp(P_XP) > 111111111 &&
       killer->QueryProp(P_GUILD_RATING) == MAX_ABILITY)
  {
    item = b11(ob);
  }
#endif
  //
  // Clonen der Potions von Zordan
  //
#ifndef DISABLE_POTION 
  if (((random(10000) < CLONECHANCE) &&   // die Clonechance
     (TRANKMASTER->WantPotion()) &&       // duerfen wir ueberhaupt clonen?
     (ob->QueryAttribute(A_INT) > 10) &&    // INT 10
     member(CORPSED_NO_POTION,killer)==-1 &&  // Spieler darf eine finden
     (member( CLONERASSEN, ob->QueryProp(P_RACE)) != -1)) ||
      explode(next_is_a_special,":")[0]=="potion") 
    {
      item=clone_potion(ob);
    }  
#endif
  //
  //  Clonen einer Rune
  //
  //helpvar=random(10);
  //TELL("angrox", sprintf("*** CORPSED: lvl: %O, QueryRegRunes < %O: %O, rnd==5: %O, "
  //      "member norune != -1: %O\n", lvl, RUNE_MAX, sizeof(call_other(ITEMD, "QueryRegisteredRunes")),
  //      helpvar, member(CORPSED_NO_RUNE,killer)));
#ifndef DISABLE_RUNE 
  if( (lvl>25 && 
          //call_other(ITEMD, "QueryNumberRegisteredRunes") <
          // RUNE_MAX && 
           random(ITEMD_RUNE_CHANCE-2*(lvl-15)) == 5 &&
           member(CORPSED_NO_RUNE,killer)==-1 ) || 
           explode(next_is_a_special,":")[0]=="rune")
  {
    if(next_is_a_special != "")
      item=clone_rune(ob, lvl, explode(next_is_a_special,":")[1]); 
    else
      item=clone_rune(ob, lvl, ""); 
  }
#endif
  // 
  //  Clonen eines Talismans
  //
#ifndef DISABLE_TALISMAN 
  if( (lvl>15 && random(ITEMD_TALISMAN_CHANCE-2*(lvl-15)) == 5 &&
     member(CORPSED_NO_TALISMAN, killer)==-1 ) || 
          explode(next_is_a_special,":")[0]=="talisman")  
  {
    item=clone_talisman(ob, lvl);
  }
#endif
  // 
  //  Clonen eines Drachenlanzenteils
  //
#ifndef DISABLE_DRAGONLANCE 
  if( (lvl>=DRACHENLANZENTEIL_MINLEVEL && 
        (random(DRACHENLANZENTEIL_CHANCE) == 5 &&
     member(CORPSED_NO_DRAGONLANCE, killer)==-1 )) || 
          explode(next_is_a_special,":")[0]=="drachenlanzenteil")  
  {
    item=clone_dragonlance(ob);
  }
#endif

#ifndef DISABLE_MITHRIL 
  if(( lvl>=MITHRIL_MINLEVEL && 
        (random(MITHRIL_CHANCE) == 5 &&
     member(CORPSED_NO_MITHRIL, killer)==-1 )) || 
          explode(next_is_a_special,":")[0]=="mithril")  
  {
    item=clone_mithril(ob);
  }
#endif
  // NPC zum TESTEN!
  //if(explode(file_name(ob), "#")[0]=="/players/angrox/npc/soeldner")
  //  item=clone_talisman(ob, lvl);
  // ---
 
  //
  // Item dem Spieler geben, wenn es existiert
  //
  next_is_a_special="";
  if(!item) return 1;
  call_out("get_item", 0, item, killer, ob);
  return 1; 
} 

nosave int get_item(object item, object killer, object ob) {
  if(killer->QueryProp(P_LOOTING)) {
    if(item->move(killer, M_GET) < 0) {
      tell_room(ENV(killer), sprintf("%s faellt aus der Leiche!\n", 
            item->Name(WER)));
      item->move(ENV(killer), M_NOCHECK);
    }
    else {
      tell_object(killer, BS(sprintf("Du nimmst %s.", item->name(WEN))));
      tell_room(ENV(killer), BS(sprintf("%s nimmt %s.", killer->Name(WER),
              item->name(WEN))), ({killer}));
    }
  }
  else {
    tell_room(ENV(killer), sprintf("%s faellt aus der Leiche!\n", 
            item->Name(WER)));
    item->move(ENV(killer), M_NOCHECK);
  }
  return 1;
}

// Potions
nosave object clone_potion(object ob) {
  object potion,pl;
  log_file(TRANKLOG,sprintf("[%s] %s von %O (%d - %d - %s)\n",
      dtime(time()),file_name(ob),ob->QueryProp(P_KILLER),
      CLONECHANCE,ob->QueryAttribute(A_INT),ob->QueryProp(P_RACE))); 
  potion=clone_object(TRANK);
  TELL("angrox", sprintf("**CORPSED: Neue Potion: %s - %d - %s - %O\n",
        file_name(ob),ob->QueryAttribute(A_INT),ob->QueryProp(P_RACE),
        ob->QueryProp(P_KILLER)));
  return potion;
}

// Drachenlanzenteile
nosave object clone_dragonlance(object ob) {
  object teil,pl;
  teil=clone_object(DRACHENLANZENTEIL);
  log_file(DRACHENLANZENLOG,sprintf("[%s](Level %d) %s von %O :%s (%d)\n",
      dtime(time()),ob->QueryProp(P_LEVEL),file_name(ob), ob->QueryProp(P_KILLER),
      teil->QueryProp(P_SHORT),teil->QueryProp(P_MAGIC))); 
  TELL("feyaria", sprintf("**CORPSED: Drachenlanzenteil: %s (%d)- %O - %s (%d)\n",
        file_name(ob),ob->QueryProp(P_LEVEL),ob->QueryProp(P_KILLER),
        teil->QueryProp(P_SHORT),teil->QueryProp(P_MAGIC) ));
  return teil;
}

// Runen
nosave varargs object clone_rune(object ob, int level, string predef_rune) {
  mapping runemight;
  mapping reverse_runemight;
  int might;
  string rune;
  object rune_ob;
  level-=15;
  runemight=RUNE_MIGHT;
  reverse_runemight=REVERSE_RUNE_MIGHT;
  switch(random(9000)+50*level) {
    case    0..4500:  might=1; break;
    case 4501..6500:  might=2; break;
    case 6501..8500:  might=3; break;
    case 8501..9700:  might=4; break;
    case 9701..15000: might=5; break;
    default: might=1;                 
  } 
  if(stringp(predef_rune) && predef_rune != "" && member(reverse_runemight, predef_rune)) {
    rune=CAP(predef_rune);
    runemight=reverse_runemight[rune];
  }
  else
  {
    rune=runemight[might][random(sizeof(runemight[might]))];
  }
  rune_ob=clone_object(ITEMDD+"obj/runes/rune");
  if(!rune) {
    rune="Dol";
    might=1;
  }
  rune_ob->SetRune(rune);
  log_file(RUNELOG,sprintf("[%s] Rune %s, Might: %d, NPC: %O, Lvl:%d, "
        "Player: %s\n", dtime(time()),rune, might, ob, 
     ob->QueryProp(P_LEVEL), getuid(ob->QueryProp(P_KILLER))));
  TELL("angrox",sprintf("%s*** CORPSED: Rune%s %s, Might: %d, NPC: [/%O], Lvl:%d, "
        "Player: %s\n",ANSI_RED, ANSI_NORMAL, rune, might, ob, 
        ob->QueryProp(P_LEVEL), getuid(ob->QueryProp(P_KILLER))));
  TELL("wraz",sprintf("%s*** CORPSED: Rune%s %s, Might: %d, NPC: [/%O], Lvl:%d, "
        "Player: %s\n",ANSI_RED, ANSI_NORMAL, rune, might, ob, 
        ob->QueryProp(P_LEVEL), getuid(ob->QueryProp(P_KILLER))));
  return rune_ob;
}

// Talisman

// HEALTH_MOD fuer Talisman berechnen
nosave string tali_health(object talisman, int summe)
{
  int hp,sp;
  while(hp+sp<=0 || hp+sp>summe)
  {
    hp=-(summe/2)+random(3*summe/2+1);
    sp=-(summe/2)+random(3*summe/2+1);
  }
  talisman->SetProp(P_ITEMD, talisman->QueryProp(P_ITEMD)+
      ({ (hp?(hp>0?"erhoeht":"erniedrigt")+" Deine Lebenskraft":"")+
      (hp&&sp?" und ":"")+
      (sp?(sp>0?"erhoeht":"erniedrigt")+" Deine magische Kraft":"") }) );
  talisman->SetProp(P_X_HEALTH_MOD, ([P_HP:hp, P_SP:sp]) );
  return "HP:"+hp+" SP:"+sp+" ";
}

// ATTR_MOD fuer Talisman berechnen
nosave string tali_attri(object talisman, int pos, int neg, int summe)
{
  int s,nr,i;
  int *x;
  x=({0,0,0,0});
  s=-1;
  nr=0;
  while((s!=summe || (x[0]==0 && x[1]==0 && x[2]==0 && x[3]==0)) && nr<100)
  {
    x[random(4)]=neg+random(pos-neg+1);
    s=0;
    for(i=0;i<4;i++) s+=x[i];
    nr++;
  }
  // richtige Beschreibung erzeugen, trivialer Code, benoetigt keinen Kommentar
  talisman->SetProp(P_ITEMD, talisman->QueryProp(P_ITEMD)+
      ({ (x[0]?((x[0]>0? "erhoeht":"erniedrigt")+" Deine Kraft"+
                (x[1]||x[2]||x[3]?((x[1]&&x[2])||(x[1]&&x[3])||(x[2]&&x[3])?
                                   ", ":" und "):"")):"")+
       (x[1]?((x[1]>0? "erhoeht":"erniedrigt")+" Deine Geschicklichkeit"+
              (x[2]||x[3]?(x[2]&&x[3]?", ":" und "):"")):"")+
       (x[2]?((x[2]>0?"erhoeht":"erniedrigt")+" Deine Intelligenz"+
              (x[3]?" und ":"")):"")+
       (x[3]?(x[3]>0?"erhoeht":"erniedrigt")+" Deine Ausdauer":"") }) );
  talisman->SetProp(P_X_ATTR_MOD, ([A_STR:x[0], A_DEX:x[1], A_INT:x[2], A_CON:x[3]]) );
  return "STR:"+x[0]+" DEX:"+x[1]+" INT:"+x[2]+" CON:"+x[3]+" ";
}

// Talisman erzeugen
nosave object clone_talisman(object ob, int level) 
{
  int might, i, x;
  string wie, talisman_name, mod;
  object talisman_ob, obj;
  mapping tali;
  mapping names;
  names=RUNE_MIGHT;
//  Talismanmight +attribut, -attribut, attributsumme, hp+sp, licht
  tali=([1:           1;          -1;         0;        3;      0,
         2:           2;          -2;         0;        6;      1,
         3:           3;          -2;         1;       15;      1,
         4:           4;          -3;         2;       25;      2,
         5:           5;          -2;         4;       50;      3,
         ]);
        
  level-=15;
  switch(random(9000)+40*level) 
  {
    case    0..4500:  might=1; wie="winzig"; break;
    case 4501..6500:  might=2; wie="klein"; break;
    case 6501..8500:  might=3; wie=""; break;
    case 8501..9700:  might=4; wie="gross"; break;
    case 9701..15000: might=5; wie="riesig"; break;
    default: might=1;                 
  } 
  talisman_ob=clone_object(ITEMDD+"obj/talisman");
  if(might!=3)
  {
    talisman_ob->SetProp(P_NAME_ADJ, wie);
    talisman_ob->AddAdjective( ({wie,wie+"er",wie+"en"}) );
    wie=wie+"er ";
  }
  talisman_name="";
  for(i=0;i<might;i++)
  {
    talisman_name+=names[x=random(sizeof(names))+1][random(sizeof(names[x]))];
  }
  talisman_ob->AddId( ({lower_case(talisman_name), lower_case(talisman_name)+" talisman"}));
  talisman_name+=" Talisman";
  talisman_ob->SetProp(P_NAME, talisman_name);
  talisman_ob->SetProp(P_SHORT, talisman_ob->Name(WER,0));
  talisman_ob->SetProp(P_ITEMD, ({"ist ein "+wie+"magischer Talisman"}));
  talisman_ob->SetProp(P_WEIGHT, might*(1000+random(200)));
  talisman_ob->SetProp(P_VALUE, might*(1000+random(500)));
  mod="";
  switch(random(3))
  {
    case 0: mod+=tali_attri(talisman_ob,tali[might,0],tali[might,1],tali[might,2]); break;
    case 1: mod+=tali_health(talisman_ob,tali[might,3]); break;
    case 2: mod+=tali_attri(talisman_ob,tali[might,0],tali[might,1],tali[might,2]); 
            mod+=tali_health(talisman_ob,tali[might,3]); break;
  }
  if( might*might>random(50) ) // 1%, 6%, 18%, 32%, 50%
  {
    //                             25% dunkel, 75% hell
    talisman_ob->SetProp(P_LIGHT, (-1+((random(4)!=0)*2))*tali[might,4]); 
    mod+="LIGHT:"+talisman_ob->QueryProp(P_LIGHT);
  }

  if(talisman_ob->QueryProp(P_LIGHT)<0)
    talisman_ob->SetProp(P_ITEMD, talisman_ob->QueryProp(P_ITEMD)+
      ({ "verdunkelt die Umgebung" }) );
  else if(talisman_ob->QueryProp(P_LIGHT)>0)
    talisman_ob->SetProp(P_ITEMD, talisman_ob->QueryProp(P_ITEMD)+
      ({ "erhellt die Umgebung" }) );

  if(member(RUNEWORDTALISMAN, talisman_name) != -1)
    talisman_ob->SetProp(P_ITEMD, talisman_ob->QueryProp(P_ITEMD)+
        ({ "koennte ein Runenwort sein" }) );

  log_file(TALISMANLOG,sprintf("[%s] %s, Might: %d, NPC: %O, Lvl:%d, "
        "Player: %s Mods: %s\n", dtime(time()),talisman_name, might, ob, 
     ob->QueryProp(P_LEVEL), getuid(ob->QueryProp(P_KILLER)), mod));
  TELL("angrox",sprintf("%s** CORPSED: Talisman%s %s, Might: %d, NPC: [/%O], Lvl:%d, "
        "Player: %s Mods: %s\n",ANSI_RED, ANSI_NORMAL, talisman_name, might, ob, 
        ob->QueryProp(P_LEVEL), getuid(ob->QueryProp(P_KILLER)), mod));
  TELL("feyaria",sprintf("%s** CORPSED: Talisman%s %s, Might: %d, NPC: [/%O], Lvl:%d, "
        "Player: %s Mods: %s\n",ANSI_RED, ANSI_NORMAL, talisman_name, might, ob, 
        ob->QueryProp(P_LEVEL), getuid(ob->QueryProp(P_KILLER)), mod));

  talismans += ({ file_name(talisman_ob) });
  if(sizeof(talismans)>=TALISMAN_MAX) 
  {
    obj=find_object(talismans[0]);
    InformPlayer(obj);
    obj->remove();
    talismans-=({obj});
  }
  save_all();
  call_out("check_talisman",2);
  return talisman_ob;
}

//Talisman-Liste ausgeben
int all_talisman()
{
  int j,l,s,c,d,i,h,m;
  mapping map;
  object ob,env;
  string env_str;
  if(!IS_ARCH(TI))
    return 0;
  check_talisman();
  printf(
    "+===========================================+\n"
    "|                 TALISMAN                  |\n"
    "+====+======================================+=============+=================+\n"
    "|Nr. |   Name             [CON/STR/INT/DEX] [ HP/ SP] LGT | ENVIRONMENT     |\n"
    "+====+====================================================+=================+\n");
  for(j=0;j<=sizeof(talismans)-1;j++)
  {
    ob=find_object(talismans[j]);
    if(objectp(env=ENV(ob))) {
      if(objectp(ENV(env)) && (living(ENV(env)) ||
            query_once_interactive(ENV(env))))
      {
        env=ENV(env);
      }
      if(query_once_interactive(env)) 
        env_str=getuid(env);
      else 
        env_str=file_name(env);
    }
    else env_str="???";
    l=ob->QueryProp(P_LIGHT);
    if(map=ob->QueryProp(P_X_ATTR_MOD))
    {
      s=map[A_STR];
      c=map[A_CON];
      d=map[A_DEX];
      i=map[A_INT];
    }
    else
      s=c=d=i=0;
    if(map=ob->QueryProp(P_X_HEALTH_MOD))
    {
      h=map[P_HP];
      m=map[P_SP];
    }
    else
      h=m=0;
    printf("|%3d | %-19s[ %2d/ %2d/ %2d/ %2d] [%3d/%3d] %2d  | %-15s |\n",
        j,explode(ob->QueryProp(P_NAME)," ")[0],c,s,i,d,h,m,l, env_str[<15..]);
  }
  printf("+====+====================================================+=================+\n");
  return 1;
}

// Talisman auf existenz pruefen
void check_talisman() 
{
  int i;
  mixed *objects;
  object ob;
  
  if(sizeof(objects=talismans[0..])) 
  {
    for(i=sizeof(objects)-1;i>=0;i--) 
    {
      if(i<sizeof(objects))
      {
        if((!ob=find_object(objects[i])))
        {
          objects-=({objects[i]});
        }
        else if(!ENV(ob)) 
        {
          ob->remove();
          objects-=({objects[i]});
        }
      }
    }
  }
  talismans=objects[0..];
  save_all();
  return ;
}

// Spieler informieren wenn zu viele Tamlismans da sind
nosave void InformPlayer(object ob) 
{
  object pl, dis_obj;
  if(ENV(ob)) {
    pl=ENV(ENV(ob));
    if(pl && query_once_interactive(pl)) {
      tell_object(pl, sprintf("%s loest sich ploetzlich auf!\n", 
          ob->Name(WER)));
      
    }
    else {
      pl=ENV(ob);
      tell_object(pl, sprintf("%s loest sich ploetzlich auf!\n", 
          ob->Name(WER))); 
    }
    if(objectp(pl) && find_netdead(getuid(pl))) { // Clonen des dis_obj
      if(!(dis_obj=present(ITEMD_DIS_OBJ_ID, pl))) {
        dis_obj=clone_object(ITEMDD+"obj/dis_obj");
        dis_obj->move(pl, M_NOCHECK);
      }
      dis_obj->AddLostItem(ob->QueryProp(P_SHORT));
    }
  }
  return ;
}

// Zombie
nosave void create_zombie(object corpse)
{
  object zombie;
  object *obj;
  int i;
  if(objectp(corpse))
  {
    zombie=clone_object("/gilden/nekromanten/npc/zombie");
    zombie->SetZombie(corpse, 0, 10000);
    zombie->move(ENV(corpse), M_GO|M_SILENT);
    tell_room(ENV(corpse),BS("Durch eine unheilige Macht erhebt sich die "
        "Leiche zu unheiligem Leben."));
    for( i=sizeof(obj=all_inventory(corpse))-1; i>=0; i--) 
      obj[i]->move(zombie,M_GET);
    zombie->command_me("ziehe alles an");
    zombie->SetAggressive(1);
    zombie->SetProp(P_XP, 1000);
    corpse->remove();
  }
  return ;                                                           
} 

// Geist
nosave void create_ghost(object corpse)
{
  object ghost,env;
  if(objectp(corpse) && objectp(env=ENV(corpse)) && 
      !present("Nekromantengeist", env) )
  {
    ghost=clone_object("/gilden/nekromanten/npc/geist");
    ghost->SetGhost(corpse, 0, 10000);
    ghost->move(env, M_GO|M_SILENT);
    tell_room(env,BS("Die Seele des Ermordeten findet keine Ruhe "
        "und kehrt als Geist zurueck."));
    ghost->SetAggressive(1);
    corpse->remove();
  }
  return ;                                                           
} 

varargs int NextIsASpecial(string str, string arg1) {
  if(!IS_ARCH(TI)) return 0;
  if( member( ({"rune", "potion", "talisman", "zombie", "geist", "ghost", 
          "drachenlanzenteil", "mithril"}), str)==-1)
    return write("Error!\n"),1;
  if(!stringp(arg1))
    arg1="";
  next_is_a_special=str+":"+arg1;
  write("Ok. Next Corpse has a "+str+". Enjoy!\n");
  return 1;
}

int ZombieEvent(int z)
{
  if(!IS_LORD(TI) && file_name(PO)!="/gilden/nekromanten/master/nekromaster") 
    return 0;
  zombieevent=z;
  if(TI)
    write("Ok, Die naechsten "+z+" Leichen werden Zombies.\n");
  return z;
}

int QueryZombieEvent()
{
  return zombieevent;
}

int GhostEvent(int z)
{
  if(!IS_LORD(TI)) return 0;
  ghostevent=z;
  write("Ok, Die naechsten "+z+" Leichen werden Geister.\n");
  return z;
}

int QueryGhostEvent()
{
  return ghostevent;
}

nosave void b11(object ob)
{
  int chance, part, div;
  string filename;
  object obj;

  filename = explode(file_name(ob),"#")[0];
  part = b11_chances[filename,0];
  chance = b11_chances[filename,1];
  div = 1;
  if( ob->QueryProp(P_KILLER)->QueryProp(P_LEVEL) < 66 )
    div ++;
  if( ob->QueryProp(P_KILLER)->QueryProp(P_XP) < 200000000 )
    div ++;
  chance /= div;
  if( !present(B11_ID+"q",  ob->QueryProp(P_KILLER)) &&
      !present(B11_ID + part, ob->QueryProp(P_KILLER)) )
  {
    if(random(100) < chance)
    {
      log_file(B11_LOG,sprintf("[%s] %O findet Teil%d von %s (%d%%)\n",
            dtime(time()),ob->QueryProp(P_KILLER), part, filename, chance));
      TELL("feyaria", sprintf("**CORPSED: %O findet Teil%d von %s (%d%%)\n",
            ob->QueryProp(P_KILLER), part, filename, chance));
      TELL("angrox", sprintf("**CORPSED: %O findet Teil%d von %s (%d%%)\n",
            ob->QueryProp(P_KILLER), part, filename, chance));
      CLONE(B11_PART + part, ob->QueryProp(P_KILLER));
      obj = clone_object(B11_TEILGEFUNDEN);
      obj->move(TP, M_NOCHECK);
      obj->SetGrund(100, sprintf("%s findet Teil%d von %s", TPN, part, filename));
      tell_object(ob->QueryProp(P_KILLER), 
          "\nDu findest Teil "+part+" in der Leiche!\n\n");
    }
    else
    {
      obj = clone_object(B11_TEILGEFUNDEN);
      obj->move(TP, M_NOCHECK);
      obj->SetGrund(chance+1, sprintf("%s findet keinen Teil von %s", TPN, filename));
    }
    return ;
  }
}

// Mithril fuer Juwelier
nosave object clone_mithril(object ob) {
  object teil,pl;
  teil=clone_object(MITHRIL_BAR);
  log_file(MITHRILLOG,sprintf("[%s](Level %d) %s von %O\n",
      dtime(time()),ob->QueryProp(P_LEVEL),file_name(ob), ob->QueryProp(P_KILLER))); 
  TELL("feyaria", sprintf("**CORPSED: Mithril: %s (%d)- %O\n",
        file_name(ob),ob->QueryProp(P_LEVEL),ob->QueryProp(P_KILLER)));
  return teil;
}

