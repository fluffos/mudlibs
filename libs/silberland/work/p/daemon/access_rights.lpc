int access_rights(string name, string file, int readflag, int def)
{
  /*
  if (find_player("woody"))
    tell_object(find_player("woody"),
        sprintf("p/daemon/access_rights: %s -> %O\n",name,file));
  */

  if (readflag) return def;

  name=lower_case(name);
  if (file=="access_rights.lpc") return 0;        // NEVER touch myself.

  // Anatol darf was.
  if( name=="anatol" ) {
    if( file[0..3]=="cron" ) return 1;
    if( file[0..4]=="house" ) return 1;
  }

  if(name=="cirion") {
    if( file[0..3]=="wayd") return 1;
  }
  if(name=="lamuerte") {
    if( file[0..10]=="skillmaster") return 1;
  }
  return 0;
}
