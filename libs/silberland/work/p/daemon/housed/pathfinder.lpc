#pragma strict_types

#include "sys/housed_priv.h"

mapping exits;

public int query_prevent_shadow(object ob) { return 1; }

public void create() {
  seteuid(getuid(this_object()));
  if (!restore_object(HOUSED_PATHFINDER_SAVEFILE))
    exits=([]);
  // HOUSED_ERROR_LOG(sprintf("PATHFINDER LOADED (%O)",this_interactive()));
}

nosave void save() {
  save_object(HOUSED_PATHFINDER_SAVEFILE);
}

public int MayRemoveExit(string to) {
  string o, done;
  int i, h, *r;
  mixed * todo;
  mapping map;

  o=(explode(file_name(previous_object()),"/")[<1])[0..<7];
  h=to_int(file_name(previous_object())[<5..<4]);
  r=({to_int(file_name(previous_object())[<2..<1]),to_int(to[<2..<1])});

  // Eigentlich (!) sind solche Abfragen unnoetig, wenn man sich darauf
  // verlassen koennte, dass nur 'proper requests' eingehen. Aber man
  // kann nicht alles haben. :)

  if ((file_name(previous_object())[0..(strlen(VIRTUAL)-1)]!=VIRTUAL) ||
      (file_name(previous_object())[0..<3]!=to[0..<3])) {
    HOUSED_ERROR_LOG(sprintf("MISUSE MayRemoveExit: PO=%O, TP=%O, TI=%O\n",
          previous_object(), this_player(), this_interactive()));
    raise_error(sprintf("Misuse of MayRemoveExit(): PO=%O\n",
          previous_object()));
  }
  else if ((!member(exits,o)) || (!member(exits[o],h)) ||
      (!member(exits[o][h],r[0])) || (!member(exits[o][h],r[1])) ||
      (member(exits[o][h][r[0]],r[1])==-1) ||
      (member(exits[o][h][r[1]],r[0])==-1)) {
    HOUSED_ERROR_LOG(sprintf("FATAL ERROR: PO=%O, to=%s\n",
          previous_object(), to));
    raise_error("exits-mapping seems to be corrupt :(\n");
  }
  
  // Wegen *urgs* call_by_reference muss die Struktur aufw(a)endig kopiert 
  // oder nach Ablauf der Methode wiederhergestellt werden. Ich entschied
  // mich fuer die Kopie *seufz*. Da macht man im Zweifelsfall auch nichts
  // kaputt ;).

  map=map_mapping(map=exits[o][h],
    lambda(({'x}),({#'+, '({}), ({#'[, map, 'x})})));

  // Ausgaenge, die entfernt werden sollen, entfernen:

  map[r[0]]-=({r[1]});
  map[r[1]]-=({r[0]});

  // Die Wahl des passenden Suchalgorithmus ist relativ einfach: Tiefensuche
  // ist albern, alles ueber Breitensuche (BestFirst, HillClimbing, A*,..)
  // viel zu umstaendlich. Also muss nur noch entschieden werden:
  // 1) Entweder einmal von Raum 0 aus alles erfassen und schauen, 
  //    ob beide Raeume dabei sind, oder                               [ ]
  // 2) von beiden Raeumen aus versuchen, zu Raum 0 zu finden, oder    [ ]
  // 3) von einem Raum auf einem anderen Weg zum anderen zu finden.    [X] :)

  o="";
  todo=({map[r[0]]});
  while (sizeof(todo)) {
    for (i=sizeof((todo[0]));i--;)
      if (todo[0][i]==r[1]) return 1;       // Abbruch bei Zielerfassung.
      else if (!test_bit(o,todo[0][i])) {
        o=set_bit(o,todo[0][i]);
        todo+=({map[todo[0][i]]});
      }
    todo=todo[1..];
  }
  return 0;                                 // War wohl nix...
}

// SeerhouseAddExit() und SeerhouseRemoveExit() der Seherhaeuser ruft nach 
// getaner Arbeit (Add/RemoveExit()) UpdateExits() mit dem Inhalt aus 
// P_EXITS auf.

public void UpdateExits(mapping ex) {
  string * dest;
  string fn,o;
  int h, r;
 
  if (file_name(previous_object())[0..(strlen(VIRTUAL)-1)]!=VIRTUAL) {
    HOUSED_ERROR_LOG(sprintf("MISUSE UpdateExits: PO=%O, TP=%O, TI=%O\n",
          previous_object(), this_player(), this_interactive()));
    raise_error(sprintf("Misuse of UpdateExits(): PO=%O\n",
          previous_object()));
  }

  // Ich wollte mal mein Hiliting testen.... :)
  if (!mappingp(ex)) dest=({});
  else
   dest=map_array(filter_array(m_values(ex),
      lambda(({'x}), ({#'==, 
        ({#'slice_array, 'x, 0, ({#'strlen, VIRTUAL})}),
        ({#'slice_array, ({#'file_name, ({#'previous_object, 1})}), 0, 
          ({#'strlen, VIRTUAL})})}))),
      lambda(({'x}), ({#'to_int, ({#'[<, ({#'explode, 'x, ":"}), 1 })})));

  o=((fn=explode(file_name(previous_object()),"/")[<1])[0..<7]);
  h=to_int(fn[<5..<4]);
  r=to_int(fn[<2..<1]);

  if (!member(exits,o)) exits+=([o:([h:([r:dest])])]);
  else if (!member(exits[o],h)) exits[o]+=([h:([r:dest])]);
  else exits[o][h]+=([r:dest]);

  save();
  return;
}

public varargs string Debug(string s) { 
  HOUSED_ERROR_LOG(sprintf("DEBUG PEEK (%O)",this_interactive()));
  return sprintf("%O\n",(s&&member(exits,s)?exits[s]:exits)); 
}

