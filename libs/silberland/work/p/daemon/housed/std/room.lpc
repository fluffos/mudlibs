/* Seherhausausgaenge... bei "ausgang" eine Meldung ausgeben. */

public void SeerhouseAddExit(mixed cmd, mixed dest) {
  AddExit(cmd,dest);
  if (stringp(cmd))
    tell_room(this_object(),break_string(sprintf(
    "Mit leisem Knistern erscheint ein Ausgang '%s'.",to_string(cmd)),77));
  HOUSED_PATHFINDER->UpdateExits(QueryProp(P_EXITS));
}

public void SeerhouseRemoveExit(mixed cmd) {
  RemoveExit(cmd);
  if (stringp(cmd))
    tell_room(this_object(),break_string(sprintf(
    "Mit einem Whopp verschwindet der Ausgang '%s'.",
    to_string(cmd)),77));
  HOUSED_PATHFINDER->UpdateExits(QueryProp(P_EXITS));
}


private nosave string normstr(string str) {
  return implode(efun::explode(str,"@@"),"**");
}

private nosave string *brk(string str) {
  int i;
  string *t1, *t2;

  if (!str) return 0;
  t1 = regexplode(str, ", *");
  for (t2 = ({}), i=sizeof(t1)-1; i>=0; i-=2)
    t2 = ({t1[i]}) + t2;
  return t2;
}

private nosave int befCheck(string bef) {
  if (member(bef, ' ') > -1)
    return 0;

  if (member(m_indices(QueryProp(P_COMMANDS)) - 
       ({"oeffne","schliess","schliesse"}), bef) > -1 ||
     (member(ausgaenge+({"raus"}), bef) > -1 && 
       member(m_indices(QueryProp(P_EXITS)), bef) == -1))
    return 0;
  return 1;
}

public varargs int Owner(mixed allowed) {
  string *ext;
  object test;

  if (objectp(allowed) && query_once_interactive(allowed))
    test = allowed;
  else
    test = this_player();
  /* Backdoor */
  if (member(HOUSED_CARETAKER,getuid(test))>=0) return 1;

  if (allowed) {
    ext = (THQ(H_ACCESS)?(string*)THQ(H_ACCESS):({}))+({capitalize(owner)});
    if (member(ext, capitalize(getuid(test))) < 0) {
      notify_fail( "Das darfst Du hier nicht!\n" );
      return 0;
    }
  }
  else if ((getuid(test) != owner) && 
    (getuid(test) != getuid(this_object()))) {
    notify_fail( "Das hier ist nicht Dein Haus - oder was auch immer!\n" );
    return 0;
  }
  return 1;
}

public varargs string arr_out(mixed array, string none, string one, 
   string many, int flag) {

  string tmp;
  mixed arr;
  int i;

  if (!sizeof(array))
    tmp = none;
  else if (sizeof(array)==1) {
    if (array[0]==DEFAULT_SMELL) array[0]="(Raum)";
    tmp = sprintf(one,array[0]);
  }
  else {
    arr = sort_array(array, #'>);
    if (arr[0]==DEFAULT_SMELL) arr[0]="(Raum)";
    tmp = many;
    if (flag & 2)
      tmp += implode(arr, ", ")+".";
    else {
      tmp += implode(arr[0..<2], ", ");
      tmp += (" und "+arr[<1]+".");
    }
  }
  if (flag & 1)
    return(break_string(tmp, 75, 0, 1));
  else
    write(break_string(tmp, 75, 0, 1));
}

public void create() {
  seteuid(getuid(this_object()));

  if (!is_clone(this_object()) && 
    (sizeof(efun::explode(file_name(this_object()),"std"))==2)) return;

  room::create();
  usercmd::create();
  losa::create();

  Set(P_INT_LONG, SAVE, F_MODE_AS);
  Set(P_INT_SHORT, SAVE, F_MODE_AS);
  Set(P_NEW_EXITS, SAVE, F_MODE_AS);
  Set(P_DETAILS, SAVE, F_MODE_AS);
  Set(P_READ_DETAILS, SAVE, F_MODE_AS);
  // Das ist jetzt H_OWNSMELLS Set(P_SMELLS, SAVE, F_MODE_AS);
  // Das ist jetzt H_OWNSOUNDS Set(P_SOUNDS, SAVE, F_MODE_AS);
  Set(P_LIGHT, SAVE, F_MODE_AS);
  Set(P_ENVIRONMENT, SAVE, F_MODE_AS);

  SetProp(P_IDS, ({"Ding", "hier", "Raum", "raum", "sehe\rhaus"}));
  SetProp(P_NAME, "Zuhause");
  SetProp(P_GENDER, 0);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_NOGET, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_HOUSE]));
  // SetProp(P_SOUNDS, ([]));
  // SetProp(P_SMELLS, ([]));

  AddCmd( ({ "beschreib", "beschreibe" }), "beschreiben" );
  AddCmd("uebersicht", "uebersicht");
  AddCmd("ausgang", "cmdAusgang");
  AddCmd( ({"loesche", "loesch"}), "loesch");
  AddCmd( ({"wirf", "werf", "werfe" }), "wirf");
  AddCmd( ({"sperr", "sperre"}), "cmdSperre");
  AddCmd( ({"kopier", "kopiere" }), "kopieren");
  AddCmd("licht", "licht");
  AddCmd("temperatur", "temperatur");
  AddCmd( ({"aendere", "aender" }), "aendern");
  AddCmd( ({"meldung", "meldungen"}), "report");
  previous_object()->CustomizeObject();

}

public void init() {
  object haus;


  room::init();
  nedit::init_rescue();
  
   // Init-Zaehler, Debug-Zwecke.

  SetProp(" my init count ", ((int)QueryProp(" my init count "))+1);

  if (QueryProp(" my init count ")>1)
      DB("trace","Init ("+QueryProp(" my init count ")+"): "
           +file_name(this_object())+(this_player()?" "+file_name(this_player()):""));
  else
      DB("info","Init: "
           +file_name(this_object())+(this_player()?" "+file_name(this_player()):""));

  if (this_player() && query_once_interactive(this_player()) &&
      IS_LEARNER(this_player()) && getuid(this_player()) != owner) {
    if (this_player()->QueryProp(P_INVIS)) {
      say(capitalize(getuid(this_player()))+" betritt unsichtbar den Raum.\n");
      printf(" /-\\-/-\\-/-\\-/-\\-/-\\-/-\\-/-\\---- ACHTUNG! ----/-\\-/-\\"
         "-/-\\-/-\\-/-\\-/-\\-/-\\-/-\\\n |-/-\\-/ Du bist moeglicherweise in"
         " einem privaten Raum und stoerst!  \\-/-\\-|\n /-\\-/-\\-/-\\-/-\\-"
         "/-\\-/-\\-/-\\------------------/-\\-/-\\-/-\\-/-\\-/-\\-/-\\-/-\\-"
         "/-\\\n");
    }
  }
  /* if (this_player() && query_once_interactive(this_player()) && 
     (!interactive(this_player())))
    BecomesNetDead(this_player());  */
}


/* Seherhaeuser versuchen schon im reset(), sich aus dem Speicher
 * zu nehmen. Zumindest, wenn sie leer sind. Greift nicht mehr, sobald
 * Goodies im Spiel sind. 27.01.2012 12:57:37  -Anatol  */

public void reset() {
  room::reset();
  losa::reset();
  if (!objectp(first_inventory())) 
    clean_up(1);  // 1  := standard loaded object (room)
}

/* clean_up nimmt den Raum aus dem Speicher, wenn...
 * 1. alle Objekte, die er selbst erzeugt hat, im Raum sind oder
 *    zwischenzeitlich zerstaert wurden.
 * 2. (a) der Raum zwischen zwei clean_up-Versuchen nicht ge init()et
 *    wurde. ODER (b) der Raum (bis auf o.g. Objekte) leer ist.
 *
 * Fuer Seherhaeuser wird 2.(a) unter Vorbehalt ausser Kraft gesetzt: 
 * Seherhaeuser sollen sich niemals aus dem Speicher nehmen, wenn 
 * Objekte in ihnen sind, die sie nicht selbst erzeugt haben. D.h. 
 * das Ablegen einer /obj/fackel hindert einen Seherhausraum fuer 
 * die gesamte Uptime am selbst-remove().
 * Diese Ausnahme greift NUR, wenn der Besitzer im Lauf des letzten
 * Jahres eingeloggt war. Ansonsten gilt das Haus als verwaist und
 * wird wie ein normaler Raum behandelt. Das ist besser als die 
 * Alternative - das waere das Abhaengen dieser Raeume gewesen.
 *
 * Fuer alle anderen Faelle soll aber die Standardmechanik greifen.
 *
 * 26.01.2012 - Anatol
 * 27.01.2012 - Anatol
 */

#define ONE_YEAR_IN_SECONDS 31557600

public int clean_up(int arg) {
  mixed inv;
  string owner_save;


  if (!QueryOwner()||(!stringp(QueryOwner()))||(strlen(QueryOwner())<1))
     return (int)::clean_up(arg);

  owner_save=sprintf("/save/%c/%s.o",QueryOwner()[0],QueryOwner());

  if ((file_size(owner_save)) && 
     ((file_time(owner_save) + ONE_YEAR_IN_SECONDS)>time())) {
      Set(" clean counter ",4);
  }
  else {
      DB("trace","Cleanup("+Query(" clean counter ")+"--): "+file_name(this_object()));
  }
  losa::reset();  // Evtl. gepackt speichern...
  return (int)::clean_up(arg);
}

public int remove() {
 DB("info","Remove: "+file_name(this_object()));
 ::remove();
}

