#pragma strict_types

#include "../sys/house.h"
#include "../sys/upgrade.h"
#include <properties.h>

inherit HOUSED_HOMEPATH "std/room";

string upg;  /* Zugriff nur via test_bit und set_bit! */

nosave string outside;

public int query_prevent_shadow() { return 1; }

public void create() {
  if (!upg) upg="";
  if (!is_clone(this_object()) && 
    file_name(this_object())==(HOUSED_HOMEPATH "std/room00"))
    return;
  ::create();

  Set(H_REPORT, SAVE, F_MODE);
  Set(H_ACCESS, SAVE, F_MODE);
  
}

public void init() {
  int r;
  string room, dir;

  ::init();
  if ((this_player()) && (getuid(this_object())!=getuid(this_player())) 
     && (Owner()) && (r=Query(H_REPORT))) {
    call_out("notifyReport",0,r);
    Set(H_REPORT,0);
    Save();
  }
  
}

nosave void notifyReport(int r) {
  printf("Ueberrascht stellst Du fest, dass seit Deinem letzten Besuch %s\n"
      "Rueckmeldung%s von anderen Spielern hinterlassen wurde%s.\n",
   (r==1?"eine":to_string(r)), (r==1?"":"en"),(r==1?"":"n"));
  Set(H_REPORT,0);
  Save();
}

public varargs int InstallExit(string con, string dir, int verbose_only) {
  string exit2;

  // DB(sprintf("InstallExit called with %O, %O\n",con, dir));
  // DB(sprintf("Outside is: %O, Exits are %O\n",outside,QueryProp(P_EXITS)));
  if ((!con) && (!dir)) { // Tor zur Welt loeschen
    if ((!outside) || (!member((mapping)QueryProp(P_EXITS),outside)))
      return 0;
    else {
      tell_room(this_object(),"Mit einem leisen Knistern verschwindet "
          "ein Ausgang.\n");
      RemoveExit(outside);
      outside=0;
      Save();
      return 1;
    }
  }
  else {
    if ((!dir) || (!con) || (member(PROPER_EXITS,dir)==-1))
      return 0;
    exit2=PROPER_EXITS[(((member(PROPER_EXITS,dir)+
            sizeof(PROPER_EXITS)/2))%sizeof(PROPER_EXITS))];
    if (member((mapping)QueryProp(P_EXITS)-([outside]), exit2))
      return 0;
    if (verbose_only) return 1;
    tell_room(this_object(),"Es knistert und ploetzlich erscheint "
          "ein Ausgang.\n");
    AddExit(exit2, con);
    outside=exit2;
    Save();
    return 1;
  }
}

public mixed GetConnectionInfo() {
  return ([]);
}

public int QueryUpgraded(int n) { 
  return (n>=0?test_bit(upg,n):0);
}

public int Upgraded(int n) {
  if ((previous_object()!=find_object(HOUSED_UPGRADE)) || (!intp(n)) || (n<0))
    return 0;
  upg=set_bit(upg,n);
  Save();
  return 1;
}

public string QueryUpgrades() {
  string  *upgrades;
  string * res;
  int i;
  res=({});;
  upgrades=(string*)call_other(HOUSED_UPGRADE,"QueryUpgrades");
  for (i=0;i<sizeof(upgrades);i++)
    if (QueryUpgraded(i))
      res+=({upgrades[i][HOUSED_UPGRADE_DESC]});
  return implode(res,", ");
}
 
