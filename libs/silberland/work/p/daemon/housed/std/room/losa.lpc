#pragma strict_types

#define NEED_PROTOTYPES
#include "../../sys/house.h"
#include "../../sys/housed.h"
#include <properties.h>
#include <wizlevels.h>
#include <thing/properties.h>

private int csaved;

public void AddExit(mixed cmd, mixed dest);
public varargs object AddItem(mixed what, mixed ref, mixed props);

public void create() {
  Set(H_SPECIAL, SAVE|SECURED, F_MODE);
  Set(H_SPECIAL, ([]));
  Set(H_OWNSMELLS, SAVE, F_MODE_AS);
  Set(H_OWNSMELLS, ([]));
  Set(H_OWNSOUNDS, SAVE, F_MODE_AS);
  Set(H_OWNSOUNDS, ([]));
}
