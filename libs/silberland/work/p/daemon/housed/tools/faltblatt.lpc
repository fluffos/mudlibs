/*
 * /p/daemon/housed/tools/faltblatt.c - ein magisches Faltblatt, 
 * das den Hilfebefehl fuer Haeuslesbauer bzw. Hoehlengraeber, 
 * Baeumepflanzer und weiss der Kuckuck noch um die Seherhausbefehle 
 * erweitert.
 *
 * (c) 1998-2000 Mud Silberland - Adrian Holzwarth / Anatol@Silberland
 */

#pragma strict_types

#include <properties.h>
#include <wizlevels.h>
#include <language.h>

#define TXTDIR "/p/daemon/housed/doc/"
#define BEFEHLE ([\
  "aendere":"Aendern von Beschreibungen",\
  "ausgang":"Hinzufuegen eines Ausgangs",\
  "befehl":"''beschreibe befehl'' - komplex",\
  "beschreibe":"Beschreiben von Details, Geraeuschen,...",\
  "kopiere":"Kopieren von Beschreibungen",\
  "licht":"Licht an oder aus?",\
  "loesche":"Das Loeschen von Beschreibungen",\
  "meldungen":"Rueckmeldungen anderer Spieler einsehen",\
  "sperre":"Einen Ausgang entfernen",\
  "temperatur":"Temperatur warm, kalt oder angenehm?",\
  "uebersicht":"Raumuebersicht",\
  ])

inherit "/std/thing";

public int query_prevent_shadow() { return 1; }

public string liesBef() {
  int i;
  string s;
  string * ind;

  s="\n        Zu folgenden Befehlen kannst Du mit"
    "\n               ''hilfe <befehl>''"
    "\n          eine kleine Hilfeseite abrufen:\n\n";
   ind=sort_array(m_indices(BEFEHLE),#'<);
   for (i=sizeof(ind)-1;i>=0;i--)  
      s+=sprintf("%15s : %s\n",ind[i],BEFEHLE[ind[i]]);
   return s+"\n";
}

public string liesEinf() {
  if (this_player()) 
    this_player()->More(read_file(TXTDIR+"rueckseite"));
  return "";
}
public string liesAllg() {
  if (this_player()) 
    this_player()->More(read_file(TXTDIR+"vorderseite"));
  return "";
}

void create() {
  if (!is_clone(this_object())) return;
    ::create();
    
  seteuid(getuid(this_object()));
  SetProp(P_LONG, 
    "Der Glanz des Faltblatts scheint irgendwie magisch zu sein, zumindest\n"
    "glaubst Du das erkennen zu koennen. In ihm stehen bestimmt wichtige\n"
    "Informationen zum Thema Eigenheim. Tatsaechlich kannst Du eine Vorder-,\n"
    "eine Rueckseite und einen gesonderten Vermerk lesen.\n");
  SetProp(P_SHORT, "Ein magisches Faltblatt");
  SetProp(P_WEIGHT,0);
  SetProp(P_MATERIAL,MAT_PAPER); 
  SetProp(P_NODROP,"Lass mal, das koennte noch brauchbar sein.\n");
  SetProp(P_AUTOLOADOBJ,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NOBUY,1);
  SetProp(P_NOSELL,1);
  SetProp(P_INFO,"Du kannst das Faltblatt natuerlich zerreissen.\n");
  SetProp(P_VALUE,0);
  SetProp(P_READ_MSG,
    "Du kannst drei Dinge an dem Faltblatt lesen, benutze dazu:\n"
    "''lies vorderseite'', ''lies rueckseite'' und ''lies vermerk''.\n");
  SetProp(P_NAME,"Faltblatt");
  SetProp(P_GENDER,NEUTER);
  AddId(({"faltblatt","blatt","a\na\tol-faltblatt"}));
  AddReadDetail("vorderseite",#'liesAllg);
  AddReadDetail("rueckseite",#'liesEinf);
  AddReadDetail("vermerk",#'liesBef);
  AddCmd("hilfe","cmdHelp");
  AddCmd(({"zerreisse","zerreiss"}),"cmdDest");
}


nosave int cmdHelp(string s) {
   if ((!this_player()) || (!s) || (member(m_indices(BEFEHLE),s)==-1)) return 0;
   else {
     this_player()->More(read_file(TXTDIR+s));
     return 1;
   }
}

nosave int cmdDest(string s) {
  if (!this_player()) return 0;
  notify_fail("Was willst Du zerreissen?\n");
  if ((!s) || (!id(s))) return 0;
  write("Du zerreisst das Faltblatt und die Magie wird frei: Es bleibt\n"
        "nicht das kleinste bisschen Papier uebrig! Sowas!\n");
  say(break_string(sprintf("%s zerreisst ein Faltblatt und wird kurz von "
          "einem magischen Flimmern eingehuellt.",
          (string)this_player()->Name(WER))));
  remove();
  return 1;
}
