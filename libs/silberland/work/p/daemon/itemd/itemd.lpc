//
// Mitteilung an Angrox & Feyaria
//
nosave varargs void tell_af(string str, int flag) {
  if(!flag || (this_interactive() && (getuid(this_interactive())=="angrox" 
               || getuid(this_interactive())=="feyaria"))) {
    if(find_player("angrox")) tell_object(find_player("angrox"),"** ITEMD: "+str);
    if(find_player("feyaria")) tell_object(find_player("feyaria"), "** ITEMD: "+str);
  }
  else {
    CHMASTER->join("ITEMD",TO);
    CHMASTER->send("ITEMD","",str,MSG_SAY);
  }
  return;  
}

// Konsistenzcheck
void check_magic(int flag) {
  int i;
  mixed *objects;
  object ob;
  if(flag == -23) {
    call_out("check_magic", 0, LOW_ID);
    call_out("check_magic", 2, MED_ID);
    call_out("check_magic", 4, HIG_ID);
    call_out("check_magic", 6, VHG_ID);
    call_out("check_magic", 8, GDL_ID);
    call_out("check_magic", 10, RAR_ID);
    call_out("check_magic", 12, RST_ID);
    call_out("check_magic", 14, SOC_ID);
    call_out("check_magic", 16, UNQ_ID);
    call_out("check_magic", 18, SET_ID);
    call_out("check_magic", 20, RUNE_ID);
    call_out("check_magic", 22, TIME_ID);
    return ;
  }
  switch(flag) {
    case LOW_ID: objects=low_magic[0..]; break;
    case MED_ID: objects=med_magic[0..]; break;
    case HIG_ID: objects=high_magic[0..]; break;
    case VHG_ID: objects=vhigh_magic[0..]; break;
    case GDL_ID: objects=godly_magic[0..]; break;
    case RAR_ID: objects=rare[0..]; break;
    case RST_ID: objects=restricted[0..];break;
    case SOC_ID: objects=socketed[0..];break;
    case UNQ_ID: objects=unique[0..];break;
    case SET_ID: objects=set[0..];break;
    case RUNE_ID: objects=runes[0..]; break;             
    case TIME_ID: objects=timed[0..]; break;             
  }
  if(sizeof(objects)) {
    for(i=sizeof(objects)-1;i>=0;i--) {
      if(!ob=find_object(objects[i]))
        objects-=({objects[i]});
      else if(flag==RST_ID && !ENV(ob)) {
        //ta(sprintf("ENV(ob): %O, object: %s\n", ENV(ob), objects[i]));
        ob->remove();
        objects-=({objects[i]});
      }
    }
  }
  switch(flag) {
    case LOW_ID: low_magic=objects[0..]; break;
    case MED_ID: med_magic=objects[0..]; break;
    case HIG_ID: high_magic=objects[0..]; break;
    case VHG_ID: vhigh_magic=objects[0..]; break;
    case GDL_ID: godly_magic=objects[0..]; break;
    case RAR_ID: rare=objects[0..]; break;
    case RST_ID: restricted=objects[0..]; break;
    case SOC_ID: socketed=objects[0..]; break;
    case UNQ_ID: unique=objects[0..];break;
    case SET_ID: set=objects[0..];break;
    case RUNE_ID: runes=objects[0..];break;
    case TIME_ID: timed=objects[0..];break;
  }
  save_all();
  return ;
}

// Ausgelagerte Funktion zur Berechnung der Anzahl an Magic Items
// und diverser Wahrscheinlichkeiten
varargs mixed CalcProbs(mixed prob,mixed chances,int relative_chances,
    int use_skill) 
{
  int count, suc;
  mixed probs;
  probs=PROBABILITIES; 
  count=sizeof(low_magic)+sizeof(med_magic)+sizeof(high_magic)+
    sizeof(vhigh_magic)+sizeof(godly_magic);
  if(!prob) {
    prob=(int)(count/PROBABILITY_DIVISOR);
    if (use_skill && TP && !random(3)) {
      SKILLMASTER->ModifySkill(TP, SK_LUCK, "maxlearn", 3000);
      SKILLMASTER->ModifySkill(TP, SK_LUCK, "maxunlearn", 3000);
      suc=SKILLMASTER->UseSkill(TP, SK_LUCK, LUCK_USE_DIFF,
          LUCK_LEARN_DIFF, 0, ({"Ab nun hast Du mehr Glueck!", 
            "Huch. Du fuehlst Dich als haettest Du ab nun weniger Glueck"}));
      if(suc > -4000)
        prob-=suc/500; // 0 .. -20
    }
    if(dtime(time())[0..6]=="Fre, 13") prob-=20;
    // Ueberlebensbonus (Wenn der letzte Tod 500000 Sekunden her ist
    // (5 Tage, 18h), dann findet man normal Magic Items. Ist der
    // letzte Tod kuerzer her, dann findet wird Prob um -25 .. 0 
    // veraender.
    if((time()-TP->QueryProp(P_LAST_DIE_TIME)-500000) < 0) 
//      prob+=TP->QueryProp(P_LAST_DIE_TIME)/20000; /das sind aber 54764 statt 25
      prob += (time() - TP->QueryProp(P_LAST_DIE_TIME) - 500000) / 20000;
    if(prob<BASIC_MAX_CHANCE) prob=BASIC_MAX_CHANCE;
    if(prob>BASIC_MIN_CHANCE) prob=BASIC_MIN_CHANCE;
    // Geburtstage werden ausserhalb der min/max regelung behandelt.
    // Dafuer werden sie auch durchdividiert und nicht subtrahiert.
    if(dtime(time())[5..11]=="23. Nov") prob/=2; // Angrox Geburtstag
    if(dtime(time())[5..11]=="23. Apr") prob/=2; // Feyaria Geburtstag
    if(dtime(time())[5..11]=="29. Feb") prob/=2; // Schaltjahr 
  }
  if(!chances || sizeof(chances)<4) 
     chances=({probs[0]-(int)(count*probs[1]),
               probs[2]-(int)(count*probs[3]),
               probs[4]-(int)(count*probs[5]),
               probs[6]-(int)(count*probs[7]),
               probs[8]});
  else if(relative_chances) {
     chances=({chances[0],
               chances[0]+chances[1],
               chances[0]+chances[1]+chances[2],
               chances[0]+chances[1]+chances[2]+chances[3],
               chances[0]+chances[1]+chances[2]+chances[3]+chances[4]});
  }
  return ({count,prob,chances});
}

//
// Veraendert die Chance ein Item zu finden
//
int DoProbModification(int probability, object pl) {
  object *obj;
  int i, value;
  obj=pl->QueryProp(P_ARMOURS);
  obj+=({pl->QueryProp(P_WEAPON)});
  obj-=({0});
  if(!sizeof(obj)) return probability;
  obj=filter_array(obj, "ProbCheck");
  if(!sizeof(obj)) return probability;
  for(i=sizeof(obj)-1;i>=0;i--) {
    value+=obj[i]->QueryProp(ITEMD_PROB_CHANGE);
  }
  probability=(int)(probability/((value/100.0)+1));
  if(probability<0) return 0;
  return probability;
}

nosave int write_error_log(string str) {
  write_file(ITEMD_LOG "errors", str);
  return 1;
}

int ProbCheck(object ob) {
  if(ob->QueryProp(ITEMD_PROB_CHANGE)!=0) return 1;
  return 0;
}


// Wahrscheinlichkeiten fuer Unique, Rare, Set und Socketed berechnen
int CalcChances(string type, object who)
{
  int chance, size, max;
  switch(type)
  {
    case "UNIQUE":
      chance=ITEMD_UNIQUE_CHANCE;
      size=sizeof(unique);
      max=UNIQUE_MAX;
      break;
    case "RARE":
      chance=ITEMD_RARE_CHANCE;
      size=sizeof(rare);
      max=RAR_MAX;
      break;
    case "SET":
      chance=ITEMD_SET_CHANCE;
      size=sizeof(set);
      max=SET_MAX;
      break;
    case "SOCKETED":
      chance=ITEMD_SOCKETED_CHANCE;
      size=sizeof(socketed);
      max=SOC_MAX;
      break;
    default:
      return 0;
  }
  return (int)( (chance/3+DoProbModification(2*chance/3,who))*(1+1.0*size/max));
}
    


//
// Laedt und wertet das Config file unique.init aus
//
void initialize() {
  mixed tmp, hlp;
  int i;
  tmp = read_file(file_name(this_object())+".init");
  tmp = regexp(explode(tmp, "\n"), "^[^#]"); 
  tmp = map_array(tmp, #'regexplode/*'*/, "[^:][^:]*$|[ \\t]*:[ \\t]*");
  tmp = map_array(tmp, #'regexp/*'*/, "^[^: \\t]");
  for(i=sizeof(tmp)-1;i>=0;i--) {
    if(sizeof(tmp[i])<3) {
      write_error_log(sprintf("%s: Fehler im itemd.init!\n", 
            dtime(time())));
      raise_error("Fehler im itemd.init! ");
      return;
    }
    allow_unique_clone+=([tmp[i][0]:tmp[i][1];to_int(tmp[i][2])]);
  }
}

int statistic_reset()
{
  if(!CheckPermission(TP)) return 0;
  ident_types=ALL_ARMOUR_TYPES+ALL_WEAPON_TYPES;
  ident_magic=ALL_ARMOUR_TYPES+ALL_WEAPON_TYPES;
  last_statreset_time=time();
  save_all();
  return 1;
}

//
// Zerstoert alle magischen Gegenstaende
//
varargs void remove_all(string what) {
  int i;  
  string *all_items;
  object ob;
  if(!CheckPermission(TP)) return 0;
  switch (what) 
  {
    case "all": all_items=low_magic+med_magic+high_magic+vhigh_magic+godly_magic+
           unique+set+restricted+socketed;
           break;
    case "set": all_items=set; break;
    case "low": all_items=low_magic; break;
    case "med": all_items=med_magic; break;
    case "hig": all_items=high_magic; break;
    case  "vhg": all_items=vhigh_magic; break;
    case "gdl": all_items=godly_magic; break;
    case "unq": all_items=unique; break;
    case "res": all_items=restricted; break;
    case "soc": all_items=socketed; break;
    default: all_items=({});
  }
  for(i=sizeof(all_items)-1;i>=0;i--) {
    if(ob=find_object(all_items[i])) {
      ob->SetProp(P_CURSED,0);
      ob->DoUnwield(1);
      ob->DoUnwear(1);
      ob->remove();
      if (ob) destruct(ob);
    } 
  }
  switch (what) 
  {
    case "all": low_magic=({});
           med_magic=({});
           high_magic=({});
           vhigh_magic=({});
           godly_magic=({});
           unique=({});
           set=({});
           restricted=({});
           socketed=({});
           break;
    case "set": set=({}); break;
    case "low": low_magic=({}); break;
    case "med": med_magic=({}); break;
    case "hig": high_magic=({}); break;
    case "vhg": vhigh_magic=({}); break;
    case "gdl": godly_magic=({}); break;
    case "unq": unique=({}); break;
    case "res": restricted=({}); break;
  }
  save_all();
  Channel("**** ACHTUNG ****");
  if(what=="all")
    Channel(sprintf("Alle bisher gefundenen magischen Gegenstaende wurden "
        "von %s zerstoert.", CAP(getuid(TP))));
  else
    Channel(sprintf("Ein Teil der bisher gefundenen magischen Gegenstaende "
          "wurde von %s zerstoert.", CAP(getuid(TP))));

  write_file(ITEMD_LOG "remove.log", sprintf("%s: Magische Items (%s) von "
        "%O zerstoert!\n", what,TP));
  return ;
}

//
// Zerstoerung eines bestimmten Items
//
void remove_mi(int category, int number) {
  object *objects, item;
  string msg;
  int siz;
  if(!CheckPermission(TP)) return 0;
  switch(category) {
    case LOW_ID: objects=low_magic[0..]; msg="LOW MAGIC"; break;
    case MED_ID: objects=med_magic[0..]; msg="MEDIUM MAGIC"; break;
    case HIG_ID: objects=high_magic[0..]; msg="HIGH MAGIC"; break;
    case VHG_ID: objects=vhigh_magic[0..]; msg="VERY HIGH MAGIC"; break;
    case GDL_ID: objects=godly_magic[0..]; msg="GODLY MAGIC"; break;
    case RAR_ID: objects=rare[0..]; msg="RARE ITEMS"; break;
    case RST_ID: objects=restricted[0..]; msg="RESTRICTED ITEMS"; break;
    case SOC_ID: objects=socketed[0..]; msg="SOCKETED ITEMS"; break;
    case UNQ_ID: objects=unique[0..]; msg="UNIQUES"; break;
    case SET_ID: objects=set[0..]; msg="SETS"; break;
  }
  if(!siz=sizeof(objects) || number > (siz-1)) {
    write("Item nicht gefunden!\n");
    return ;
  }
  item=objects[number];
  if(!item) {
    write("Itemfehler!\n");
    return ;
  }
  write(sprintf("\nCategory : %s\n", msg));
  write(sprintf("Item     : %s\n", item->QueryProp(P_SHORT)));
  item->SetProp(P_CURSED, 0);
  InformPlayer(item);
  write_file(ITEMD_LOG+"remove.log", sprintf("%s: %s von %O zerstoert, "
        "ENV: %O\n", dtime(time()),item->QueryProp(P_SHORT),TP, ENV(item)));
  item->remove();
  write(sprintf("           ===> REMOVED <===\n\n"));
  check_magic(category-1);
  save_all();
  return ;
}

//
// Loescht ein Item
//  -> Aus Kompatibilaetsgruenden beibehalten
//
void DelItem(int flag, int nr) {
  remove_mi(flag, nr);
  return ;
}

//
// Schaltet die Items ab
//
void disable(string reason) {
  if(!reason) {
    write("Du musst einen Grund angeben!\n");
    return ;
  } 
  if(disable_items) {
    write("Die Magic Items sind schon abgeschalten!\n"); 
    return ;
  }
  Channel("****** ACHTUNG ******");
  Channel(sprintf("Die magischen Gegenstaende wurden von %s abgehaengt. "
        "Grund: %s", CAP(getuid(TP)), reason));
  Channel("****** ACHTUNG ******");
  write_file(ITEMD_DISABLE_LOG, sprintf("%s: %s haengt Items ab, "
        "Grund: %s\n", ctime(), CAP(getuid(TP)), reason));
  disable_items=1;
  return ;
}
//
// Schaltet die Items ein
//
void enable(string reason) {
  if(!CheckPermission(TP)) return 0;
  if(!reason) {
    write("Du musst einen Grund angeben!\n");
    return ;
  } 
  if(!disable_items) {
    write("Die Magic Items sind schon freigegeben!\n"); 
    return ;
  }
  Channel(sprintf("Die magischen Gegenstaende wurden von %s freigegeben. "
        "Grund: %s", CAP(getuid(TP)), reason));
  write_file(ITEMD_DISABLE_LOG, sprintf("%s: %s haengt Items AN, "
        "Grund: %s\n", ctime(), CAP(getuid(TP)), reason));
  disable_items=0;
  return ;
}

