//
// Ein bestimmtes Magic Item setzen
//
void SetMagicItem(object ob, string _pre, string _suf) {
  int what;
  mapping might;
  mixed selected, suff, pref;
  might=([0:"ist schwach magisch", 1:"ist unterdurchschnittlich magisch",
          2:"besitzt hochmagische Eigenschaften", 3:"besitzt extrem "
          "hochmagische Eigenschaften", 4:"besitzt goettliche Eigenschaften"]);
    
  if(!CheckPermission(TP) && member(ALLOW_SETMAGIC_FROM_EXTERNAL, 
        explode(file_name(PO), "#")[0]) == -1) 
    return 0;
  if(IsWeapon(ob)) {
    what=0;
  }
  else if(IsArmour(ob)) {
    what=1;
  }
  else {
    write("Keine Waffe oder Ruestung!\n");
    return;
  }
  
  write_file(ITEMD_LOG+"setmagicitem.log", dtime(time())+ sprintf(": prev object: %O, this interactive: %O - item %O, pre: %s, "
        "suff: %s\n", PO, TI, ob, _pre, _suf));
  _suf=lower_case(_suf);
  _pre=lower_case(_pre);

  selected=search_db(_suf,_pre,what);

  if (IS_ARCH(TP))
  {
    write(sprintf("PRE: %O\n", selected[0]));
    write(sprintf("SUF: %O\n", selected[1]));
    write(sprintf("flag: %d\n",selected[2]));
  }
  Description(ob, might[selected[2]]);
  RegisterNewItem(ob, selected[2]);
  DoPreSuffix(selected[0], selected[1], ob,selected[2], 0);
  return ;
}

nosave mixed search_db(string _suf, string _pre, int what) {
  int i,j,flag;
  string *magictype;
  mixed selected_pre, selected_suf, suff, pref;

  magictype=({LOW_MAGIC,MED_MAGIC,HIGH_MAGIC,VHIGH_MAGIC,GODLY_MAGIC});
  if(!what) {
    suff=WEAPON_SUFFIX;
    pref=WEAPON_PREFIX;
  }
  else {
    suff=ARMOUR_SUFFIX;
    pref=ARMOUR_PREFIX;
  }
  _suf=lower_case(_suf);
  _pre=lower_case(_pre);
  if(_pre && _pre!="") {
    for(i=sizeof(magictype)-1;i>=0;i--) {
      for(j=sizeof(pre_suf[pref][magictype[i]])-1;j>=0;j--) {
         if(lower_case(pre_suf[pref][magictype[i]][j][0])==_pre) {
           selected_pre=pre_suf[pref][magictype[i]][j];
           if(i>flag) flag=i;
         }
         else if(member(pre_suf[pref][magictype[i]][j][1],"name") && 
                 lower_case(pre_suf[pref][magictype[i]][j][1]["name"])==_pre) 
         {
           //write(sprintf("Gefunden: %d, Magic: %s\nVal:%O\n", _pre,
           //   magictype[i],pre_suf[pref][magictype[i]][j][1]));
           selected_pre=pre_suf[pref][magictype[i]][j];
           if(i>flag) flag=i;
         }
      }
    }
  }
  if(_suf && _suf!="") {
    for(i=sizeof(magictype)-1;i>=0;i--) {
      for(j=sizeof(pre_suf[suff][magictype[i]])-1;j>=0;j--) {
         if(lower_case(pre_suf[suff][magictype[i]][j][0])==_suf) {
           selected_suf=pre_suf[suff][magictype[i]][j];
           if(i>flag) flag=i;
         }
      }
    }
  }
  return ({selected_pre,selected_suf,flag});
}


