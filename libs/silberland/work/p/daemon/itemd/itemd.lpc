  pre_suf[ARMOUR_SUFFIX][GODLY_MAGIC]=GODLY_SUFFIX_ARMOUR+
    GODLY_SUFFIX_ARMOUR1;
  //save_all();
  return 1;
}

// Erstellt automatisch ein Headerfile.
// Etwas umstaendlich programmiert, aber schnell
int DumpHeaderFile() {
  string txt;
  string *what, *mag;
  int i; 
  if(!CheckPermission(TP)) return 0;

  what=({WEAPON_PREFIX, WEAPON_SUFFIX, ARMOUR_SUFFIX, ARMOUR_PREFIX});
  mag=({LOW_MAGIC, MED_MAGIC, HIGH_MAGIC, VHIGH_MAGIC, GODLY_MAGIC});
  rm(HEADERFILE);
  wh("\n// Automatisch generiertes Header file\n");
  wh("// itemd_data.h\n");
  wh(sprintf("// Generiert am %s von %s\n", dtime(time())[5..], 
      CAP(getuid(TP))));
  wh("// (c) angrox@sl.mud.at, feyaria@sl.mud.at\n//     nur zu Verwendung "
      "im Silberland bestimmt.\n\n");
  wh("// Die Weitergabe dieser Informationen an Spieler und an\n"
      "// Magier anderer MUDs ist lt. Magiervertrag VERBOTEN!!\n\n");
  wh("#define LOW_PREFIX_WEAPON ({\\\n");
  for(i=0;i<=sizeof(pre_suf[WEAPON_PREFIX][LOW_MAGIC])-1;i++) {
    txt=sprintf("%#:80O", pre_suf[WEAPON_PREFIX][LOW_MAGIC][i]);
    wh(sprintf("%s%s,\\\n", txt[0..2],txt[23..]));
  }
  wh("})\n\n\n");
  wh("#define MED_PREFIX_WEAPON ({\\\n");
  for(i=0;i<=sizeof(pre_suf[WEAPON_PREFIX][MED_MAGIC])-1;i++) {
