void remove()
{
  save_all();
  destruct(this_object());
}

//
// Moven der Charged Items
//
nosave varargs int move_charged_item(object charge, object ob, int count_flag) {
  if(!objectp(ob)) return 0;
  if(!objectp(charge)) return 0;
  if(objectp(ENV(ob)))
    charge->move(ENV(ob), M_NOCHECK);
  else if (count_flag < 5 )
    call_out("move_charged_item", 10, charge, ob, count_flag+1);
  return 1;
}

nosave int check_warnings(object pl) {
  string scnd;
  object second;
  mapping might;
  if((might=pl->QueryProp(P_WARNINGS)) && sizeof(might)>0)
    return 1;
  if(stringp(scnd=pl->QueryProp(P_SECOND)) && objectp(second=find_player(
      lower_case(scnd))) && (might=second->QueryProp(P_WARNINGS)) && 
      sizeof(might)>0) 
  {
    return 2;
  }
  return 0;
}

nosave int check_living_env(object ob)
{
  while(objectp(environment(ob)))
  {
    ob = environment(ob);
    if( living(ob) || query_once_interactive(ob) )
      return 1;
  }
  return 0;
}

nosave void check_env(mixed items, int max)
{
  int i, *tmpmagic;
  string txt;
  object ob;
  object pl;

  for(i = sizeof(items) - 1; i >= 0; i--)
  {
    // Hier werden tmpmagicitems gecheckt
    if(objectp(ob=find_object(items[i])) && 
          pointerp(tmpmagic=ob->QueryProp(P_ITEMD_TMPMAGIC))) 
    {
      tmpmagic[1]--;
      if(tmpmagic[1] < 1) {
        if (objectp(pl = environment(ob))) {
            if (!query_once_interactive(pl) && 
                objectp(environment(pl)) &&
                query_once_interactive(environment(pl)))
              pl = environment(pl);
        }
        txt = sprintf( "TMPMAGIC MI will be removed: %s [#%s] (%s)\n", 
          items[i]->Name(), explode( items[i], "#" )[<1],
          objectp(pl) ? getuid(pl) : "-" );
        tell_af(txt);
        write_file(ITEMD_LOG+"autoremove.log", dtime(time())+ ": "+ txt);
        items_without_env = m_delete(items_without_env, items[i]);
        InformPlayer(ob);
        ob->SetProp(P_CURSED, 0);
        ob->remove();
        if (ob) destruct(ob);
      }
      else {
        if (tmpmagic[1] == 30)
        {
          if (stringp(ob->QueryProp(P_NAME)))
            ob->SetProp(P_NAME, ANSI_BLINK + ob->QueryProp(P_NAME) + ANSI_NORMAL);
          ob->SetProp(P_SHORT, ANSI_BLINK + ob->QueryProp(P_SHORT) + ANSI_NORMAL);
        }
        ob->SetProp(P_ITEMD_TMPMAGIC, tmpmagic);
        tmpmagic_items += ({ob});
      }
    }
    else if( max > 1 && objectp(ob=find_object(items[i])) && !check_living_env(ob) && 
        member(NOREMOVE, explode(items[i],"#")[0]) == -1 )
    {
      if( items_without_env[items[i]] )
      {
        if( (++items_without_env[items[i]]) >= max )
        {
          txt = sprintf( "MI without env will be removed: %s [#%s]\n", 
            items[i]->Name(), explode( items[i], "#" )[<1] );
          tell_af(txt);
          write_file(ITEMD_LOG+"autoremove.log", dtime(time())+ ": "+ txt);
          items_without_env = m_delete(items_without_env, items[i]);
          items[i]->remove();
        }
      }
      else
        items_without_env[items[i]] = 1;
    }
    else if (member(items_without_env, items[i]) )
      items_without_env = m_delete(items_without_env, items[i]);
  }
}

void debug_items_without_env()
{
  if( IS_ARCH(TP) )
    printf("%O\n",items_without_env);
}

int sort_tmpmagic(object a, object b)
{
  return a->QueryProp(P_ITEMD_TMPMAGIC)[1] < b->QueryProp(P_ITEMD_TMPMAGIC)[1];
}

void debug_tmp_magic()
{
  object env;
  object *obs;
  int i;

  if( !IS_ARCH(TP) )
    return;
  
  tmpmagic_items -= ({0});
  obs = sort_array(tmpmagic_items, #'sort_tmpmagic); //'
  for(i = sizeof(obs) - 1; i >= 0; i--)
  {
    if(env=environment(obs[i]))
    { 
      if(!query_once_interactive(env))
        env=environment(env);
    }
    printf("%50s (%-11s): %4d/%4d\n",obs[i]->QueryProp(P_SHORT)[<50..],
        (env ? capitalize(getuid(env)) : "noenv"), 
        obs[i]->QueryProp(P_ITEMD_TMPMAGIC)[1],
        obs[i]->QueryProp(P_ITEMD_TMPMAGIC)[0]);
  }
}

void check_no_env_items()
{
  int i;
  object* items;

  items = m_indices(items_without_env);
  for(i = sizeof(items) - 1; i >= 0; i--)
    if( !objectp(find_object((string)items[i])) )
      items_without_env = m_delete(items_without_env, items[i]);
  tmpmagic_items = ({});
}

void reset()
{
  check_magic(-23);
  call_out("check_no_env_items", 30);
  call_out("check_env", 32, low_magic, 20);
  call_out("check_env", 34, med_magic, 20);
  call_out("check_env", 36, high_magic, 25);
  call_out("check_env", 38, vhigh_magic, 30);
  call_out("check_env", 40, godly_magic, 50);
  call_out("check_env", 42, rare, 50);
  call_out("check_env", 44, restricted, 100);
  call_out("check_env", 46, unique, 100);
  call_out("check_env", 48, socketed, -1);
  call_out("check_env", 50, set, -1);
  call_out("check_env", 52, timed, -1);
  call_out("CheckBags", 10);
  set_next_reset(3600);
}

//
// Runenhandling
//
int RegisterRune(object rune) {
  runes-=({0});
  if (member(runes, file_name(rune)) == -1)
    runes+=({file_name(rune)});
  save_all();
  return 1;
}

int DeRegisterRune(object rune) {
  runes-=({0});
  runes-=({file_name(rune)});
  check_magic(RUNE_ID);
  return 1;
}

int QueryNumberRegisteredRunes() {
  int i;
  string *bag_runes;
  string *bag_names;
  bag_runes=({});
  bag_names=m_indices(bags);
  for (i=sizeof(bag_names)-1;i>=0;i--) {
    bag_runes+=call_other(bag_names[i], "QueryRunes");
  }
  return sizeof(runes+bag_runes);
}

int QueryRegisteredRunes() {
  return runes;
}

//
// Handling der Runenbeutel
//
int RegisterBag(object bag) {
  if (!member(bags, file_name(bag)))
    bags+=([file_name(bag):({})]);
  save_all();
  return 1;
}
int DeRegisterBag(object bag) {
  if(member(bags, file_name(bag)))
    bags=m_delete(bags, file_name(bag));
  save_all();
  return 1;
}

int RegisterBagRunes(object bag, string *_runes) {
  if(!member(bags, file_name(bag))) 
    RegisterBag(bag);
  bags[file_name(bag)]=_runes;
  save_all();
  return 1;
}

void CheckBags() {
  int i; 
  string *_bags;
  object ob;
  _bags=m_indices(bags);
  for(i=sizeof(_bags)-1;i>=0;i--) {
    if(!ob=find_object(_bags[i])) {
      bags=m_delete(bags, _bags[i]);
    }
    else {
      ob->check_runes_in_bag();
    }
  }
  save_all();
  return ;
}


//
// Benoetigt ein TExtfile wo ALLE runen in der form "rune#<objectid>"
// stehen, die runen muessen auch im Spiel sein. Alternativ, wenn sie
// nachtgeclont werden sollen, so muss das textfile die form 
// "rune#<objektid> runensymbol object" haben (ersteres ist nicht sooo
// wichtig, wichtig ist das es 3 woerter sind, symbol und objekt sind 
// allerdings essentiell). dann wird die rune mit dem runensymbol 
// geclont und in das objekt "object" gemovt.
//
//
int restore_all_runes(string what, string file) {
  string *_runes;
  if(member(({"_set_runes","_clone_runes"}), what) == -1) {
    write("Usage: restore_all_runes <_set_runes|_clone_runes> <file>\n");
    return 1;
  }
  _runes=explode(read_file(ITEMDD+file), "\n");
  call_out(what, 2, _runes);
  return 1;
}

nosave void _set_runes(string *_runes) {
  object ob;
  int i,x;
  string *ids;
  if(sizeof(_runes) < 20) 
    x=sizeof(_runes);
  else
    x=20;
  for(i=0; i<=(x-1); i++) {
    if(ob=find_object(ITEMDD+"obj/runes/"+_runes[i])) {
      ids=ob->QueryProp(P_IDS)-({"Ding", "rune", "\nitemd_rune"});
      if(sizeof(ids)) {
        ob->SetRune(CAP(ids[0]));
      }
    }
  }
  call_out("_set_runes", 0,_runes[20..]);
  return ;
}


nosave void _clone_runes(string *_runes) {
  object pl,ob;
  int i,x;
  string *ids;
  if(sizeof(_runes) < 20) 
    x=sizeof(_runes);
  else
    x=20;
  for(i=0; i<=(x-1); i++) {
    ids=explode(_runes[i], " ");
    if(pl=find_object(ids[2])) {
      TELL("gwenshara", sprintf("%O -> rune %s\n", pl, CAP(ids[1])));
      ob=clone_object(ITEMDD+"obj/runes/rune");
      ob->SetRune(CAP(ids[1]));
      ob->move(pl, M_NOCHECK);
    }
  }
  call_out("_clone_runes", 0, _runes[20..]);
  return ;
}

string GetLivingEnvStr(object ob) {
  object *all_env;
  string env_str;
  int i;
  if(!ob) {
    if(objectp(previous_object())) 
      return sprintf("*previous_object=%O, living ENV=%O",previous_object(),GetLivingEnvStr(previous_object()));
    else return "*object does not exist";
  }
  all_env=all_environment(ob);
  if(sizeof(all_env)) {
    for(i=0;i<sizeof(all_env);i++) {
      if(living(all_env[i]) || query_once_interactive(all_env[i])) {
        env_str=getuid(all_env[i]);
        break;
      }
    }
    if(!env_str) env_str=file_name(all_env[0]);
  }
  else env_str="*object has no ENV*";
  return env_str;
}

varargs int QueryRuneMaxAge(mixed rune_mix) {
  object rune_obj;
  string rune_str;
  mapping reverse_runemight;
  int might;
  if(objectp(rune_mix)) { // Runenobject mitgeliefert
    rune_obj=rune_mix;
    //TELL("wraz", sprintf("rune_obj=rune_mix=%O\n", rune_mix));
  }
  else if(stringp(rune_mix)) { // Runenstring mitgeliefert (--> Runenbeutel! oder it)
    rune_str=to_string(rune_mix);
    //TELL("wraz", sprintf("rune_str=rune_mix=%s\n", rune_str));
  }
  else { // backwards compatibility (5.7.24), nichts mitgeliefert (alte Runen & Runenbeutel)
    rune_obj=previous_object();
    TELL("wraz", sprintf("rune_obj=previous_object=%O, living ENV=%O\n", rune_obj, 
      GetLivingEnvStr(rune_obj)
    ));
  }
  if(objectp(rune_obj) &&
     strstr(file_name(rune_obj), ITEMDD+"obj/runes/rune#") != -1) {
    rune_str=rune_obj->QueryRune();
  }

  reverse_runemight=REVERSE_RUNE_MIGHT;
  might=reverse_runemight[rune_str];
  //if(might==5) TELL("wraz", sprintf("Rune: %s, Might: %d, living ENV: %O\n", to_string(rune_str), might, GetLivingEnvStr(rune_obj)));
  switch(might) {
    case 1: return RUNE_MAX_AGE_LOW; break;
    case 2: return RUNE_MAX_AGE_MED; break;
    case 3: return RUNE_MAX_AGE_HIGH; break;
    case 4: return RUNE_MAX_AGE_VHIGH; break;
    case 5: return RUNE_MAX_AGE_GODLY; break;
    default: 
      TELL("wraz", " **** RUNE in ITEMD: switch(might) not within 1-5 (probably old runebag)\n");
      TELL("wraz", sprintf("rune_obj=%O, rune_str=%O\n", rune_obj, rune_str));
      return RUNE_MAX_AGE_LOW; break;
  }
}

void half_damage_protection(string dtype, int value)
{
  if (value > 1)
    value /= 2;
}

int set_nr()
{
  return sizeof(set);
}

mixed SetAuto(object ob) // workaround fuer Wraz, um als nicht-Erzi SetAuto in socketed_armour setzen zu koennen
{
  if(!ob) return 0;
  if(!objectp(ob)) return 0;
  return call_other(ob, "SetAuto", 1);
}