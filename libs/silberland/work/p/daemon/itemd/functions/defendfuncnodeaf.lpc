inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;
  if( !random(10) && (wer=PO->QueryProp(P_WORN))  && ( wer->QueryProp(P_DEAF)) )
  {
    wer->SetProp(P_DEAF, 0 );
  }
  return 0;
}

string Description() {
  return "heilt eine Ertaubung waehrend eines Kampfes sofort";
}
