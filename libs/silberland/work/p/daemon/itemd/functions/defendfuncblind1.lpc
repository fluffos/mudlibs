inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;
  mapping blind;
  int btime;
  if( (wer=PO->QueryProp(P_WORN))  && ( blind=wer->QueryProp(P_BLIND)) )
  {
    btime=blind[BLIND_TIME];
    wer->SetProp(P_BLIND, blind + ([BLIND_TIME: (btime>2 ? btime-2 : 1) ]) );
  }
  return 1;
}

string Description() {
  return "laesst im Kampf eine Erblindung schneller vergehen";
}
