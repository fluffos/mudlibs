
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <moredef.h>
#include <new_skills.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  switch(random(100) ) {
    case 0..6: (PO->QueryProp(P_WIELDED))->AddHp(2); return 150; 
    case 7..10: (PO->QueryProp(P_WIELDED))->AddHp(-1); return -100;
    case 11..16: (PO->QueryProp(P_WIELDED))->AddSp(2); return 150;;
    case 17..20: (PO->QueryProp(P_WIELDED))->AddSp(-1); return -100;
    case 21..26: (PO->QueryProp(P_WIELDED))->AddHp(random(15)); return 250; 
    case 27..30: (PO->QueryProp(P_WIELDED))->AddHp(-random(10)); return -200;
    case 31..36: (PO->QueryProp(P_WIELDED))->AddSp(random(15)); return 250;
    case 37..40: (PO->QueryProp(P_WIELDED))->AddSp(-random(10)); return -200;
    case 41..42: (PO->QueryProp(P_WIELDED))->AddPoison(1); return -200;
    case 43..44: (PO->QueryProp(P_WIELDED))->AddPoison(-2); return 350;
    case 45:     (PO->QueryProp(P_WIELDED))->SetProp(P_FROG,1); return -200;
    case 46..48: (PO->QueryProp(P_WIELDED))->SetProp(P_FROG,0); return 350;
    case 49:     (PO->QueryProp(P_WIELDED))->SetProp(P_BLIND,4); return -200;
    case 50..52: (PO->QueryProp(P_WIELDED))->SetProp(P_BLIND,0); return 300;
    case 53..54: (PO->QueryProp(P_WIELDED))->SetProp(P_FOOD,0); return -200;
    case 55..56: (PO->QueryProp(P_WIELDED))->SetProp(P_DRINK,0); return -200;
    case 57..58: (PO->QueryProp(P_WIELDED))->SetProp(P_ALCOHOL,0); return -200;
    case 59..60: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_SPEED,
                   PO->QueryProp(P_WIELDED), 300,4); return -200;
    case 61..62: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_SPEED,
                   PO->QueryProp(P_WIELDED), 50,5); return -200;
    case 63..64: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_DAMAGE,
                   PO->QueryProp(P_WIELDED), 200,6); return -200;
    case 65..66: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_DAMAGE,
                   PO->QueryProp(P_WIELDED), 50,5); return -200;
  }
  return random(50);
}


string Description() {
  return "laesst im Kampf viel Zufaelliges passieren";
}
