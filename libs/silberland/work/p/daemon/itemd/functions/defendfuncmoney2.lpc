
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int DefendFunc (string *dam_type, mixed spell, object enemy) {
  object room, ob;
//  tell_object(find_player("feyaria"),sprintf( "PO=%O\nENV=%O\nENV(ENV)=%O\n"));
    if(ENV(PO) && (room=ENV(ENV(PO)))) {
      if(ob=present("muenze", room))
        ob->AddAmount(5); 
      clone_object("/obj/money")->move(room, M_PUT|M_SILENT); 
//      tell_object(find_player("feyaria"),"XXXX\n");
    }
  return 3;
}

string Description() {
  return "laesst Dich waehrend des Kampfes reich werden";
}
