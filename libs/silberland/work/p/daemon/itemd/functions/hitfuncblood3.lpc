
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  object wielder;
  if(!random(2)) {
    wielder=previous_object()->QueryProp(P_WIELDED);
    if(enemy->QueryProp(P_HP) > 5) {
      wielder->AddHp(1+random(5));
    }
    return random(30);  
  }
  return 10;
}

string Description() {
  return "saugt Leben von Deinem Gegner";
}
