inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;
  if( !random(5) && (wer=PO->QueryProp(P_WORN))  && ( wer->QueryProp(P_FROG)) )
  {
    wer->SetProp(P_FROG, 0 );
    tell_object(wer, "Du bist jetzt kein Frosch mehr!\n");
  }
  return 1;
}

string Description() {
  return "heilt eine Verfroschung waehrend eines Kampfes sofort";
}
