
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  object wielder;
  if(!random(5)) {
    wielder=previous_object()->QueryProp(P_WIELDED);
    if(enemy->QueryProp(P_SP) > 2) {
      enemy->AddSp(-2);
      wielder->AddSp(1+random(2));
    }
  }
  return 0;  
}

string Description() {
  return "saugt die Magie aus dem Gegner";
}
