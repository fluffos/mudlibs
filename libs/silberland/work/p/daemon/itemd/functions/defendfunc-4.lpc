inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
  SetProp(P_ARTICLE, 0);
}

int DefendFunc (string *dam_type, mixed spell, object enemy) {
  SetProp(P_KILL_NAME, PO->Name(WER));
  if(ENV(PO)) 
    ENV(PO)->do_damage(random(20)+1);
  return -4;
}

string Description() {
  return "verursacht zusaetzlich Wunden";
}
