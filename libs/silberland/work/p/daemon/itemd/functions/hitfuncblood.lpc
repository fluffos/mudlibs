
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  object wielder;
  if(!random(3)) {
    wielder=previous_object()->QueryProp(P_WIELDED);
    if(enemy->QueryProp(P_HP) > 4) {
      wielder->AddHp(1+random(4));
    }
  }
  return 0;  
}

string Description() {
  return "saugt Leben von Deinem Gegner";
}
