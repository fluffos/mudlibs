
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  if(!random(20))
    return random((previous_object()->QueryProp(P_WC))*2);
  return random(10);
}

string Description() {
  return "vervielfacht ab und zu den Schaden deiner Attacken";
}
