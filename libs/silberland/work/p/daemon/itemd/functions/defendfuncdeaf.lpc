inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;
  mapping deaf;
  if( (wer=PO->QueryProp(P_WORN))  && ( deaf=wer->QueryProp(P_DEAF)) )
  {
    wer->SetProp(P_DEAF, deaf + ([DEAF_TIME: deaf[DEAF_TIME]-1 ]) );
  }
  return 0;
}

string Description() {
  return "laesst im Kampf eine Ertaubung schneller vergehen";
}
