inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;
  mapping para;
  if( (wer=PO->QueryProp(P_WORN))  && ( para=wer->QueryProp(P_PARALYZED)) )
  {
    wer->SetProp(P_PARALYZED, 0 );
  }
  return 3;
}

string Description() {
  return "heilt eine Paralyse waehrend eines Kampfes schneller";
}
