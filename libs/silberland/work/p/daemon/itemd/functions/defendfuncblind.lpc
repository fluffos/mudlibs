inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;
  mapping blind;
  if( (wer=PO->QueryProp(P_WORN))  && ( blind=wer->QueryProp(P_BLIND)) )
  {
    wer->SetProp(P_BLIND, blind + ([BLIND_TIME: blind[BLIND_TIME]-1 ]) );
  }
  return 0;
}

string Description() {
  return "laesst im Kampf eine Erblindung schneller vergehen";
}
