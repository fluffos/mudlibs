
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <moredef.h>
#include <defines.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) 
{
  if( !random(10) && !enemy->QueryProp(P_PARALYZED) )
  {
    enemy->SetProp(P_PARALYZED, 2+random(4) );
    tell_room(ENV(PO->QueryProp(P_WIELDED)), 
        enemy->Name(WER,2)+ " kann sich nicht mehr bewegen.\n", ({enemy}) );
    tell_object(enemy, "Du kannst Dich nicht mehr bewegen.\n");
  }
  return random(20);
}

string Description() {
  return "laesst Deine Gegner ab und zu erstarren";
}
