
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  if(enemy->QueryProp(P_GUILD)=="druidenzirkel")
  {
    if( !random(45) ) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return 700+random(1300);
    }
    return random(70);
  }
  return random(10);
}

string Description() {
  return "trifft Druiden besonders hart";
}
