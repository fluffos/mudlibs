

#include <properties.h>
#include <combat.h>
#include <class.h>

create() {
  if(is_clone()) destruct();
}

int HitFunc(object enemy) {
  if(enemy->is_class_member(CL_GIANT) || enemy->id("gigant") )
  {
    if( !random(50) ) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return 500+random(1000);
    }
    return random(75);
  }
  return 0;
}

string Description() {
  return "trifft Riesen besonders hart";
}
