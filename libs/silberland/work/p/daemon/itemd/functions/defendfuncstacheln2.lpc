
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  object traeger;
  int val;
  if(!objectp(traeger = ENV(PO))) return 0;
  
  if (!enemy->QueryProp(P_WEAPON) && (!spell) )
  {
     switch( PO->QueryProp(P_ARMOUR_TYPE) )
     {
       case AT_HELMET:
         if( enemy->QueryProp(P_SIZE) < traeger->QueryProp(P_SIZE) ) return 0;
         break;
       case AT_TROUSERS:
       case AT_BOOT:
         if( enemy->QueryProp(P_SIZE) > traeger->QueryProp(P_SIZE)/2 ) return 0;
         break;
       case AT_ARMOUR:
         if( enemy->QueryProp(P_SIZE) < traeger->QueryProp(P_SIZE)/2 ) return 0;
         break;
      default:
         if( enemy->QueryProp(P_SIZE) < traeger->QueryProp(P_SIZE)/2 ||
             enemy->QueryProp(P_SIZE) > traeger->QueryProp(P_SIZE)*2 ) return 0;
     }
     val=(random(6)+2)*(random(2*PO->QueryProp(P_AC))+15+PO->QueryProp(P_AC));
     if( val<50 ) return 0;
     SetProp (P_KILLER, traeger->name());
     if(ENV(ENV(PO)))
      tell_room(ENV(ENV(PO)), BS(sprintf(
         "Die Stacheln des %s von %s verletzen %s!", PO->name(RAW), 
         traeger->name(WEM), enemy->name(WEN))),({traeger,enemy}));
     tell_object(traeger, BS(sprintf(
         "Die Stacheln Deines %s treffen %s!", PO->name(RAW), 
         enemy->name(WEN))));
     tell_object(enemy, BS(sprintf(
         "Die Stacheln von %s %s treffen Dich!", traeger->name(WESSEN),
         PO->name(RAW))));
     val=(random(5)+7)*(random(2*PO->QueryProp(P_AC))+15+PO->QueryProp(P_AC));
     enemy->Defend(val,  DT_PIERCE, ([SP_NAME:"Dornen", SP_SHOW_DAMAGE:1]), 
         traeger);
  }
  return 0;
}

string Description() {
  return "verletzt unbewaffnete Gegner";
}
