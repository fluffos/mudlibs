
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  if(lower_case(enemy->QueryProp(P_RACE))=="insekt" ||
      enemy->id("insekt") || enemy->id("biene") || enemy->id("wespe") ||
      enemy->id("hornisse") || enemy->id("ameise") || enemy->id("kaefer") ||
      enemy->id("moskito") || enemy->id("muecke") || enemy->id("hummel") )
  {
    if( !random(50) ) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return 500+random(1000);
    }
    return random(40);
  }
  return 0;
}

string Description() {
  return "trifft Insekten besonders hart";
}
