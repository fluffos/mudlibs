inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>



create() {
  if(is_clone()) destruct();
  ::create();
}

int WieldFunc(object weapon) {
  environment(weapon)->Set(P_AGGRESSIVE, symbol_function("aggr", TO), F_QUERY_METHOD);
  return 1;
}

int UnwieldFunc(object weapon) {
  environment(weapon)->Set(P_AGGRESSIVE, 0, F_QUERY_METHOD);
  return 1;
}

int WearFunc(object armour) {
  environment(armour)->Set(P_AGGRESSIVE, symbol_function("aggr", TO), F_QUERY_METHOD);
  return 1;
}

int RemoveFunc(object armour) {
  environment(armour)->Set(P_AGGRESSIVE, 0, F_QUERY_METHOD);
  return 1;
}

float aggr()
{
  return 0.2;
}
