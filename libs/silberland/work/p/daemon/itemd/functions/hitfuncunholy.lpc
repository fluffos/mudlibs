
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  int align;
  if((align=enemy->QueryProp(P_ALIGN))>0)
  {
    if( !random(50) && align >=500) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return align/3+random(align/2);
    }
    return random((int)(align/15)); 
  }
  return 0;
}

string Description() {
  return "trifft heilige Lebewesen besonders hart";
}
