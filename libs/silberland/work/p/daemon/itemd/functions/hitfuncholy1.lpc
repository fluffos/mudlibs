
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  int align;
  if((align=enemy->QueryProp(P_ALIGN))<0)
  {
    if( !random(45) && align <=-250) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return -align/2+random(-align);
    }
    return random((int)(-align/10)); 
  }
  return random(10);
}

string Description() {
  return "trifft boese Lebewesen besonders hart";
}
