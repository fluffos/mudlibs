
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  previous_object()->QueryProp(P_WIELDED)->AddHp( -random(5) );
  return random(400);
}

string Description() {
  return "verstaerkt den Schaden durch Dein eigenes Blut";
}
