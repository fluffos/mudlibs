
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int DefendFunc (string *dam_type, mixed spell, object enemy) {
  object wer;
  if( !random(10) && (wer=PO->QueryProp(P_WORN)) )
  {
    wer->AddHp(random(5));
  }
  return 0;
}

string Description() {
  return "verwandelt einen Teil des Schadens in Lebenspunkte";
}
