inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;
  if( !random(10) && 
      (wer=PO->QueryProp(P_WORN))  && 
      ( wer->QueryProp(P_POISON)) )
  {
    wer->AddPoison(-10);
    tell_object(wer, "Du wirst entgiftet.\n");
  }
  return 3;
}

string Description() {
  return "heilt eine Vergiftung waehrend eines Kampfes schneller";
}
