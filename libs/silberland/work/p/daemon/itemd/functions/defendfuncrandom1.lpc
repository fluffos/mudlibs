
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <moredef.h>
#include <new_skills.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;

  wer=PO->QueryProp(P_WORN);
  switch(random(100) ) {
    case 0..5: wer->AddHp(2); return 10; 
    case 6..10: wer->AddHp(-1); return -10;
    case 11..15: wer->AddSp(2); return 10;;
    case 16..20: wer->AddSp(-1); return -10;
    case 21..25: wer->AddHp(random(15)); return 20; 
    case 26..30: wer->AddHp(-random(10)); return -20;
    case 31..35: wer->AddSp(random(15)); return 20;
    case 36..40: wer->AddSp(-random(10)); return -20;
    case 41..42: wer->AddPoison(1); return -30;
    case 43..44: wer->AddPoison(-1); return 30;
    case 45..46: wer->SetProp(P_FROG,1); return -30;
    case 47..48: wer->SetProp(P_FROG,0); return 30;
    case 49..50: wer->SetProp(P_BLIND,4); return -30;
    case 51..52: wer->SetProp(P_BLIND,0); return 30;
    case 53..54: wer->SetProp(P_FOOD,0); return -30;
    case 55..56: wer->SetProp(P_DRINK,0); return -30;
    case 57..58: wer->SetProp(P_ALCOHOL,0); return -30;
    case 59..60: wer->ModifySkillAttribute(SA_SPEED,
                  wer, 300,4); return -30;
    case 61..62: wer->ModifySkillAttribute(SA_SPEED,
                   wer, 50,5); return -30;
    case 63..64: wer->ModifySkillAttribute(SA_DAMAGE,
                   wer, 200,6); return -30;
    case 65..66: wer->ModifySkillAttribute(SA_DAMAGE,
                   wer, 50,5); return -30;
    case 67..70: wer->SetProp(P_FROG,0); return 30;
    case 71..75: wer->SetProp(P_BLIND,0); return 30;
  }
  return random(10);
}


string Description() {
  return "laesst im Kampf viel Zufaelliges passieren";
}
