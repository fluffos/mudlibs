
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <moredef.h>
#include <new_skills.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  switch(random(100) ) {
    case 0..5: (PO->QueryProp(P_WIELDED))->AddHp(1); return 100; 
    case 6..10: (PO->QueryProp(P_WIELDED))->AddHp(-1); return -100;
    case 11..15: (PO->QueryProp(P_WIELDED))->AddSp(1); return 100;;
    case 16..20: (PO->QueryProp(P_WIELDED))->AddSp(-1); return -100;
    case 21..25: (PO->QueryProp(P_WIELDED))->AddHp(random(10)); return 200; 
    case 26..30: (PO->QueryProp(P_WIELDED))->AddHp(-random(10)); return -200;
    case 31..35: (PO->QueryProp(P_WIELDED))->AddSp(random(10)); return 200;
    case 36..40: (PO->QueryProp(P_WIELDED))->AddSp(-random(10)); return -200;
    case 41..42: (PO->QueryProp(P_WIELDED))->AddPoison(1); return -300;
    case 43..44: (PO->QueryProp(P_WIELDED))->AddPoison(-1); return 300;
    case 45..46: (PO->QueryProp(P_WIELDED))->SetProp(P_FROG,1); return -300;
    case 47..48: (PO->QueryProp(P_WIELDED))->SetProp(P_FROG,0); return 300;
    case 49..50: (PO->QueryProp(P_WIELDED))->SetProp(P_BLIND,4); return -300;
    case 51..52: (PO->QueryProp(P_WIELDED))->SetProp(P_BLIND,0); return 300;
    case 53..54: (PO->QueryProp(P_WIELDED))->SetProp(P_FOOD,0); return -300;
    case 55..56: (PO->QueryProp(P_WIELDED))->SetProp(P_DRINK,0); return -300;
    case 57..58: (PO->QueryProp(P_WIELDED))->SetProp(P_ALCOHOL,0); return -300;
    case 59..60: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_SPEED,
                   PO->QueryProp(P_WIELDED), 300,2); return -300;
    case 61..62: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_SPEED,
                   PO->QueryProp(P_WIELDED), 10,5); return -300;
    case 63..64: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_DAMAGE,
                   PO->QueryProp(P_WIELDED), 200,4); return -300;
    case 65..66: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_DAMAGE,
                   PO->QueryProp(P_WIELDED), 10,5); return -300;
  }
  return 0;
}


string Description() {
  return "laesst im Kampf viel Zufaelliges passieren";
}
