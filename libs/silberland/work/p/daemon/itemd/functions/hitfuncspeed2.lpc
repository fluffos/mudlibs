
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  object wearer;
  int old_speed;
  if(!objectp(wearer=previous_object()->QueryProp(P_WIELDED))) return 0;
  old_speed=wearer->QuerySkillAttribute(SA_SPEED);
  if(!random(8) && old_speed <= 100) {
    tell_object(wearer, "Du fuehlst Dich ploetzlich schneller!\n");
    wearer->ModifySkillAttribute(wearer, SA_SPEED, (old_speed+200), 2);
  }
  return 0;
}

string Description() {
  return "beschleunigt Deine Attacken";
}
