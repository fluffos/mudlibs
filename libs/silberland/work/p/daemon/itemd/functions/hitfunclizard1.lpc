
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) 
{
  if(member(({"echse", "schildkroete", "schlange", "krokodil", "gecko"}),
      lower_case(enemy->QueryProp(P_RACE)) )>-1 || enemy->id("echse") ||
      enemy->id("schildkroete") || enemy->id("schlange") || 
      enemy->id("krokodil") || enemy->id("gecko") ) 
  {
    if( !random(45) ) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return 700+random(1300);
    }
    return random(70);
  }
  return random(10);
}


string Description() {
  return "trifft Echsenwesen besonders hart";
}
