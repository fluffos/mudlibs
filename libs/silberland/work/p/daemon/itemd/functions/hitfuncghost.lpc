
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <class.h>

void create() 
{
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) 
{
  if(enemy->id("geist") || lower_case(enemy->QueryProp(P_RACE))=="geist") {
    if( !random(50) ) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return 500+random(1000);
    }
    return random(40);
  }
  return 0;
}


string Description() {
  return "trifft Geisterwesen besonders hart";
}
