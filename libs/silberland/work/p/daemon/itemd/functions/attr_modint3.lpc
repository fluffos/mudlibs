inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

nosave string what=A_INT;
nosave int value=3;

create() {
  if(is_clone()) destruct();
  ::create();
}

int WieldFunc(object weapon) {
  previous_object()->SetProp(P_X_ATTR_MOD, ([what:value]));
  environment(weapon)->UpdateAttributes();
  return 1;
}

int UnwieldFunc(object weapon) {
  previous_object()->SetProp(P_X_ATTR_MOD, 0);
  environment(weapon)->UpdateAttributes();
  return 1;
}

int WearFunc(object armour) {
  previous_object()->SetProp(P_X_ATTR_MOD, ([what:value]));
  environment(armour)->UpdateAttributes();
  return 1;
}

int RemoveFunc(object armour) {
  previous_object()->SetProp(P_X_ATTR_MOD, 0); 
  environment(armour)->UpdateAttributes();
  return 1;
}
