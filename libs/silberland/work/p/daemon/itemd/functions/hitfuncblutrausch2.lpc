
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <moving.h>

void create() 
{
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) 
{
  object wer, ob;

  if( !random(10) && 
      !present("\nblutrausch", wer=previous_object()->QueryProp(P_WIELDED) )  &&
      wer->QueryProp(P_HP)*3 > wer->QueryProp(P_MAX_HP))
  {
    tell_object(wer, "Du verfaellst in einen Blutrausch!!!\n");
    tell_room(environment(wer), wer->Name()+" verfaellt in einen "
        "Blutrausch!\n", ({wer}) );
    ob=clone_object( "/p/daemon/itemd/obj/blutrausch");
    ob->move(wer, M_NOCHECK);
    ob->blutrausch(300, 5+random(5) );
  }  
  return random(20);
}


string Description() {
  return "laesst Dich zum Berserker werden";
}
