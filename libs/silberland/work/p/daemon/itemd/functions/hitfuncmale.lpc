
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  if( member( ({"mensch", "elf", "zwerg", "hobbit", "fee", "troll", "xandim",
                          "oger", "ork", "gaffo", "goblin", "gnom", "dunkelelf"}),
              lower_case(enemy->QueryProp(P_RACE)) )!=-1 && 
      enemy->QueryProp(P_GENDER)==MALE) 
  {
    if( !random(50) ) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return 300+random(500);
    }
    return random(30);
  }
  return 0;
}

string Description() {
  return "trifft Maenner besonders hart";
}
