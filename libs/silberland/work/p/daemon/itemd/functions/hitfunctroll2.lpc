
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <class.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  if(enemy->is_class_member(CL_TROLL) ) 
  {
    if( !random(40) ) {
      tell_object(previous_object()->QueryProp(P_WIELDED),
        "Die Magie "+previous_object()->name(WESSEN,1)+" wendet sich gegen "+
        enemy->name(WEN,1)+".\n");
      return 1000+random(1500);
    }
    return random(110);
  }
  return random(20);
}

string Description() {
  return "trifft Trolle besonders hart";
}
