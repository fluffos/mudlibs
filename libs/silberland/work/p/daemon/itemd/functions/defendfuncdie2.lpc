inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) {
  object pl;
  if(objectp(pl=PO->QueryProp(P_WORN))) {
    pl->SetProp(P_TMP_DIE_HOOK, ({time()+10, TO, "diefunc"}));
    pl->SetProp("armour_that_has_the_diefunc", PO);
  }
  return 3;
}

int diefunc(int pd) {
  object wp; 
  if(!wp=PO->QueryProp("armour_that_has_the_diefunc")) 
    return 0;
  tell_object(PO, BS("Deine magische Ruestung verhindert Deinen Tod!\n"));
  tell_object(PO, BS(sprintf("Die magische Kraft von %s ist "
      "erloschen.\n", wp->name(WEM))));
  wp->SetProp(P_DEFEND_FUNC, 0); 
  PO->SetProp(P_HP,PO->QueryProp(P_MAX_HP));
  PO->SetProp(P_TMP_DIE_HOOK, 0);
  PO->SetProp("armour_that_has_the_diefunc", 0);
  return 1;
}

string Description() {
  return "trotzt dem Tod und schuetzt Dich davor";
}
