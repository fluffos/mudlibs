
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <moredef.h>
#include <new_skills.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  switch(random(100) ) {
    case 0..7: (PO->QueryProp(P_WIELDED))->AddHp(5); return 200; 
    case 8..10: (PO->QueryProp(P_WIELDED))->AddHp(-1); return -100;
    case 11..17: (PO->QueryProp(P_WIELDED))->AddSp(5); return 200;;
    case 18..20: (PO->QueryProp(P_WIELDED))->AddSp(-1); return -100;
    case 21..27: (PO->QueryProp(P_WIELDED))->AddHp(random(20)); return 300; 
    case 28..30: (PO->QueryProp(P_WIELDED))->AddHp(-random(10)); return -100;
    case 31..37: (PO->QueryProp(P_WIELDED))->AddSp(random(20)); return 300;
    case 38..40: (PO->QueryProp(P_WIELDED))->AddSp(-random(10)); return -100;
    case 41    : (PO->QueryProp(P_WIELDED))->AddPoison(1); return -100;
    case 43..44: (PO->QueryProp(P_WIELDED))->AddPoison(-3); return 400;
    case 45    : (PO->QueryProp(P_WIELDED))->SetProp(P_FROG,1); return -100;
    case 46..48: (PO->QueryProp(P_WIELDED))->SetProp(P_FROG,0); return 400;
    case 49    : (PO->QueryProp(P_WIELDED))->SetProp(P_BLIND,4); return -100;
    case 50..52: (PO->QueryProp(P_WIELDED))->SetProp(P_BLIND,0); return 400;
    case 53..54: (PO->QueryProp(P_WIELDED))->SetProp(P_FOOD,0); return -100;
    case 55..56: (PO->QueryProp(P_WIELDED))->SetProp(P_DRINK,0); return -100;
    case 57..58: (PO->QueryProp(P_WIELDED))->SetProp(P_ALCOHOL,0); return -100;
    case 59..61: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_SPEED,
                   PO->QueryProp(P_WIELDED), 300,8); return -100;
    case 62    : (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_SPEED,
                   PO->QueryProp(P_WIELDED), 50,2); return -100;
    case 63..65: (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_DAMAGE,
                   PO->QueryProp(P_WIELDED), 200,8); return -100;
    case 66    : (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_DAMAGE,
                   PO->QueryProp(P_WIELDED), 50,2); return -100;
    case 67    : (PO->QueryProp(P_WIELDED))->ModifySkillAttribute(SA_QUALITY,
                   PO->QueryProp(P_WIELDED), 150,6); return -100;
  }
  return random(100);
}


string Description() {
  return "laesst im Kampf viel Zufaelliges passieren";
}
