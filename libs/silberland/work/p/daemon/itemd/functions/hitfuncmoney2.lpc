
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  object room, ob;
    if(ENV(PO) && (room=ENV(ENV(PO)))) 
     ob=clone_object("/obj/money");
     ob->AddAmount(random(10));
     ob->move(room, M_PUT|M_SILENT);
  return 0;
}

string Description() {
  return "laesst Dich im Kampf reich werden";
}
