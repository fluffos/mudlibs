
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  if(lower_case(enemy->QueryProp(P_RACE))=="fraggle" || enemy->id("fraggle")) 
  {
    return 60;
  }
  return 0;
}

string Description() {
  return "trifft Fraggles besonders hart";
}
