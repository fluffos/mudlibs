inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

object traeger;
create()
{
  if(is_clone(TO)) destruct();
  ::create();
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object wer;
  if( !random(7) && (wer=PO->QueryProp(P_WORN)) )
  {
    wer->AddSp(random(7)+5);
  }
  return 3;
}

string Description() {
  return "verwandelt einen Teil des Schadens in Magiepunkte";
}
