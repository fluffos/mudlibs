
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>

create() {
  if(is_clone()) destruct();
  ::create();  
}

int HitFunc(object enemy) {
  object wielder;
  if(!random(3)) {
    wielder=previous_object()->QueryProp(P_WIELDED);
    if(wielder) {
      if(enemy->QueryProp(P_SP) > 6) {
        enemy->AddSp(-6);
        wielder->AddSp(1+random(6));
      }
    }
  }
  return 0;  
}

string Description() {
  return "saugt die Magie aus dem Gegner";
}
