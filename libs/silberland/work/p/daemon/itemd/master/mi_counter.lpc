// VARIABLEN
private nosave mapping s;
mixed low_magic=({});
mixed med_magic=({});
mixed high_magic=({});
mixed vhigh_magic=({});
mixed godly_magic=({});
mixed restricted=({});
mixed rare=({});
mixed unique=({});
mixed socketed=({});
mixed set=({});
mixed runes=({});
mixed bags=({});
mixed timed=({});

void create() {
  
  if(is_clone(TO)){ destruct(TO); return; }
  seteuid(getuid(this_object()));
  restore_object(ITEMD_SAVEFILE);
}

public mapping GetMIPercent() {
  mixed *objects;
  mapping mi_percent;
  restore_object(ITEMD_SAVEFILE);
  mi_percent=([
    0:"schwach magische Gegenstaende";sizeof(low_magic[0..])*100/LOW_MAX,
    1:"unterdurchschnittlich magische Gegenstaende";sizeof(med_magic[0..])*100/MED_MAX,
    2:"hochmagische Gegenstaende";sizeof(high_magic[0..])*100/HIGH_MAX,
    3:"extrem hochmagische Gegenstaende";sizeof(vhigh_magic[0..])*100/VHIGH_MAX,
    4:"goettliche magische Gegenstaende";sizeof(godly_magic[0..])*100/GODLY_MAX,
    5:"sehr seltene magische Gegenstaende";sizeof(rare[0..])*100/RAR_MAX,
    6:"einzigartige magische Gegenstaende";sizeof(unique[0..])*100/UNIQUE_MAX,
    7:"gesockelt magische Gegenstaende";sizeof(socketed[0..])*100/SOC_MAX,
    8:"magische Setgegenstaende";sizeof(set[0..])*100/SET_MAX
    //9:"magische Runen";(count_runes(runes,1)+count_runes(bags,0))*100/RUNE_MAX // Runenlimit entfernt
  ]);

  return mi_percent;
}

public mixed GetRunes() {
  restore_object(ITEMD_SAVEFILE);
  return runes;
}

public mixed GetBags() {
  restore_object(ITEMD_SAVEFILE);
  return bags;
}

public mixed GetBagIndices() {
  restore_object(ITEMD_SAVEFILE);
  return m_indices(bags);
}

// Vorlage aus p/daemon/itemd/tools/it.c decode_rune_array()
public int count_runes(mixed rune_array, int flag) {
  int i,j,rune_no;
  string *bag_indices;
  object ob;
  rune_no=0;
  if(!sizeof(rune_array)) 
    return 0;
  if(flag) {
    for (i=sizeof(rune_array)-1;i>=0;i--) {
      if(ob=find_object(rune_array[i]))
      {
        rune_no++;
      }
    }
  } // flag = 1 loop end
  else { // Ah, wir haben einen bag
    bag_indices=m_indices(rune_array);
    for(i=sizeof(bag_indices)-1;i>=0;i--) {
      for(j=sizeof(rune_array[bag_indices[i]])-1;j>=0;j--) {
        rune_no++;
      }
    }
  }
  return rune_no;
}