nosave void teile_mit(string msg, object pl) {
  pl->Message(break_string(msg,78,CAIN + " teilt Dir mit: "), MSGFLAG_TELL);
  return;
}

void catch_tell(string str)
{
  string wer, was, *dir, txt;
  object env, pl;
  int cost;
  if(sscanf(str, "%s teilt Dir mit: %s\n", wer, was)==2) {
    if(strstr(lower_case(was), "wo bist du")==-1) 
      return ;
    env=ENV(ME);
    if(!pl=find_player(lower_case(wer))) return;
    if(QueryProp(wer) > time() - 4) {
      teile_mit("Das hast Du doch gerade erst gefragt!", pl);
      pl->SetProp(P_PARALYZED, 2+random(5));
      pl->do_damage(1+random(5));
      return;
    }
    pl->do_damage(10+random(5));
    SetProp(wer, time());
    if(!random(100)) {
      teile_mit("Ich sag Dir nicht, wo ich bin! *schmoll*", pl);
      return; 
    }
    if(!env) {
      teile_mit("Ich weiss nicht, wo ich bin. Hier ist irgendwie nichts!",pl);
      return ;
    }
    dir=explode(file_name(env), "/");
    if(dir[0]=="d") {
      teile_mit(sprintf("Ich bin in der Region %s! Ihr nennt den Ort hier "
           "\"%s\".",
            CAP(dir[1]), env->QueryProp(P_INT_SHORT)),pl); 
    }
    else if(dir[0]=="players")
      teile_mit("Ich weiss nicht wo ich bin, aber ich bin mir sicher, dass "
          +CAP(dir[1])+" daran schuld ist.",pl);
    else if(dir[0]=="gilden") {
      switch(dir[1]) {
        case "druidenzirkel": 
          txt="Ich bin bei den maechtigen Druiden. Hier ist's toll, da bleib "
            "ich! Ich frag mich nur, warum Anvar seine Haende so komisch "
            "bewegt und auf mich deutet?";
          break;
        case "abenteurer":
          txt="Ich bin in einer der Abenteurergilden.";
          break;
        case "berserker":
          txt="Melde gehorsamst: Bin bei Kronang! Werde ihn spalten! *HACK*";
          break;
        case "paladine":
          txt="Bin auf der Paladinburg! Werde mich zu Ayla begeben und "
            "etwas fuer mein Seelenheil opfern. Solltest Du auch tun!";
          break;
        case "zechpreller":
          txt="Jo i wasch ah net <HICKS> wo isch gerarade bin! SCHECHUS "
            "SCHENK EIN! HEUTE *RUELPS* MACH MA BLAU!";
          break;
        default: 
          txt="Ich bin in irgendeiner schwindligen Gilde! Holt mich raus!";
      }
      teile_mit(txt, pl);
    }
    else 
      teile_mit("Ich weiss selber nicht so genau, wo ich bin...",pl);
  }
  return ;
}

nosave int CheckLetter(string str) {
  int i,x;
  x=0;
  str=lower_case(str);
  if((i=member(word, str))!=-1) {
    get_letter=set_bit(get_letter, i);
    ta(sprintf("CAIN: Letter passt, i=%d, word[i]=%s, get_letter=%s\n",
          i,word[i],get_letter));
    write_file(ITEMD_LOG+"word.log", sprintf("%s: %s -> Buchstabe '%s'\n",
          ctime(), getuid(TP), str));
    x=2;
  }
  save_object(CAIN_SAVE);
  if(get_letter==testbit) return 1;
  return x;
}

nosave int GotWord() {
  tell_room(ENV(ME), BSA("GRATULIERE! Du hast das Wort gefunden das gesucht "
      "wurde. Als Belohnung wird der naechste Gegenstand, der mir gegeben "
      "wird, "
      "extrem hochmagisch. Aber bedenke, ich kann nur Gegenstaende "
      "verzaubern, die auch ohne meine Hilfe magisch geworden waeren, und "
      "die noch nicht identifiziert wurden. Waehle also weise. Sollte "
      "unklug gewaehlt werden, verfaellt mein Geschenk.", CAIN + " spricht: "));
  next_is_magic=1;
  word=letters[random(sizeof(letters))];
  testbit=testbits[sizeof(word)-1];
  get_letter="";
  save_object(CAIN_SAVE);
  SetProp(P_MNPC_AREA, ({"/d/", "/gilden"}));
  SetProp(P_MNPC_DEFAULTROOM, "/gilden/abenteurer");
  progress=0;
  return 1;
}

mixed QueryWord() {
  return ({word, get_letter});
}

string Missing() {
  int i;
  string str;
  str="";
  for(i=0;i<=sizeof(word)-1;i++) {
    if(!test_bit(get_letter, i)) {
      str+=word[i];
    }
  }
  return str;
}

int SetLetter(string str) {
  int pos;
  if(!IS_ARCH(TP)) return -1;
  if((pos=member(word,str))==-1) return -1;
  if(test_bit(get_letter,pos)) return 0;
  return CheckLetter(str);
}

int NextIsGodly() {
  if(!IS_ARCH(TP)) return -1;
  next_is_magic=1;
  return 1;
}

int do_save() {
  save_object(CAIN_SAVE);
  return 1;
}

int runentausch(string str)
{
  string r1,r2,r3;
  object o1,o2,o3;
  string *possible, p;
  object ob;

  notify_fail("Syntax: runentausch <rune1> <rune2> <rune3>\n");
  if (!str)
    return 0;
  if (sscanf(str, "%s %s %s", r1, r2, r3) != 3)
    return 0;
  if (r1 == r2 || r1 == r3 || r2 == r3)
    return 0;
  if (!(o1 = present(r1, TP)) || !(o2 = present(r2, TP)) || !(o3 = present(r3, TP)))
    return 0;
  if (o1->IsSocketItem() !=SOC_M_RUNE || o2->IsSocketItem() !=SOC_M_RUNE ||
      o3->IsSocketItem() !=SOC_M_RUNE)
    return 0;
  if (TP->QueryMoney() < CAIN_COST ) 
  {
    tell_room(ENV(ME), BSA(sprintf("Tut mir leid, Du hast zu wenig Geld, "
        "%s. Ich verlange "+CAIN_COST+" Goldmuenzen pro Rune, also insgesamt "+
        (3*CAIN_COST) + " Meunzen!", TP->name(WER)), CAIN + " sagt: "));
    return 1; 
  }
  tell_object(TP, "Du gibst " + CAIN + " "+(3*CAIN_COST)+" Muenzen.\n");
  TP->AddMoney(-3*CAIN_COST);
  money += 3*CAIN_COST;
  possible = RUNE_MIGHT[1] +  RUNE_MIGHT[2] + RUNE_MIGHT[3] + RUNE_MIGHT[4];
  if(member(RUNE_MIGHT[5],capitalize(r1)) >= 0 || member(RUNE_MIGHT[5],capitalize(r2))  >= 0 ||
      member(RUNE_MIGHT[5],capitalize(r3))  >= 0)
    possible = RUNE_MIGHT[4] + RUNE_MIGHT[5];
  possible -= ({capitalize(r1), capitalize(r2), capitalize(r3)});
  p = possible[random(sizeof(possible))];
  ob = clone_object(ITEMDD "obj/runes/rune");
  ob->SetRune(p);
  ob->move(TP, M_NOCHECK);
  str = sprintf("die Rune %s im Tausch gegen die Runen %s, "
        "%s und %s.\n", p,capitalize(r1),capitalize(r2),capitalize(r3));
  write(CAIN + " gibt Dir "+ str);
  say(sprintf(CAIN + " gibt %s %s", TP->name(WEM), str), ({TP}));
  write_file(ITEMD_LOG "runentausch", sprintf("%s: %s bekommt %s", 
        dtime(), capitalize(getuid(TP)), str));
  o1->remove();
  o2->remove();
  o3->remove();
  return 1;
}

varargs int remove(int silent)
{
  if (present("antiteleportationsring"))
    present("antiteleportationsring")->remove();

  return ::remove(silent);
}


void check_geocoin() {
  string locfile;
  string loc;
  locfile=ITEMDD+"geocoin/loc.txt";
  loc=read_file(locfile);
  if(file_size(ITEMDD+"geocoin/location_changed")!=-1) {
    Channel("Aktuelle Informationen zu unserem Geocoin \"Der mystische Astralring\":", "Niac");
    Channel("Position: "+loc, "Niac");
    Channel("Mehr Informationen kann ich geben, wenn ich nach astralring befragt werde.", "Niac");
    rm(ITEMDD+"geocoin/location_changed");
  }
  return;
}

string tell_about_geocoin() {
  string txt;
  string locfile;
  string loc;
  locfile=ITEMDD+"geocoin/loc.txt";
  loc=read_file(locfile);
  txt="Der mystische Astralring ist nicht nur ein Gegenstand hier im Silberland, sondern er "
    "ist auch eine real existierende Geocoin, die auf http://www.geocaching.com getrackt wird. Hier "
    "findest Du auch Informationen, was das alles ueberhaupt ist. :-)\n"
    "Die URL der Geocoin lautet: http://coord.info/TB2WPEP\n"
    "Die aktuelle Position ist: "+loc+"\n";
  return txt;
}

string tell_about_mis() {
  int mi_info_cost, i;
  mapping mi_percent;
  int *mi_keys;
  string txt;
  txt="";

  mi_info_cost = CAIN_COST * 5;

  if(TP->QueryMoney() < mi_info_cost ) {
  return sprintf("Tut mir leid, Du hast zu wenig Geld, "
      "%s. Ich verlange "+mi_info_cost+" Goldmuenzen fuer die Information, wieviele "
      "goettliche Gegenstaende es gibt.", TP->name(WER)); }
  
  tell_room(ENV(ME), sprintf("%s gibt " + CAIN + " "+mi_info_cost+" Muenzen.\n", TP->Name(WER)),
      ({TP}));
  tell_object(TP, "Du gibst " + CAIN + " "+mi_info_cost+" Muenzen.\n");
  TP->AddMoney(-mi_info_cost);
  money+=mi_info_cost;

  mi_percent="/p/daemon/itemd/master/mi_counter"->GetMIPercent();
  txt+="Es gibt derzeit ";

  mi_keys=sort_array(m_indices(mi_percent),#'>); //'
  for(i=0;i<sizeof(mi_keys);i++)
  {
    switch(mi_percent[mi_keys[i],1])
    {
      case 0..10: txt+="gar keine oder fast keine"; break;
      case 11..20: txt+="wenige"; break;
      case 21..40: txt+="einige"; break;
      case 41..60: txt+="viele"; break;
      case 61..80: txt+="sehr viele"; break;
      case 81..90: txt+="extrem viele"; break;
      case 91..95: txt+="unfassbar viele"; break;
      case 96..100: txt+="nahezu oder tatsaechlich maximal viele"; break;
      default: txt+="unmoeglich viele (FEHLER, bitte Magier verstaendigen)"; break;
    }
    txt+=(" "+mi_percent[mi_keys[i],0]);
    if(i<sizeof(mi_keys)-2) txt+=", ";
    else if(i==sizeof(mi_keys)-2) txt+=" und ";
    else if(i==sizeof(mi_keys)-1) txt+=" im Silberland.\n";
  
  }

  return txt;
}