
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
#include "/gilden/berserker/berserker_extern.h"
#include "/gilden/paladine/paladin_extern.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit ITEMD_UNIQUE_PATH "std_unique_armour";

int hits;
string det_energie(string detail);

void create()
{
  if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Eternium, die Ruestung der Ewigkeit");
  SetProp(P_LONG,
    "Eternium ist eine magische Ruestung, die angeblich schon seit ewigen "
    "Zeiten existiert. Sie besteht quasi aus der Urmagie, mit der das "
    "SilberLand geschaffen wurde und ist bis auf eine leichtes Schimmern "
    "fast unsichtbar. Eternium verbessert alle Arten von Magie und kann "
    "die magische Energie sammeln und Dir in Notfaellen wiedergeben. "
    "Sicher ist dies die beste Ruestung, die man sich vorstellen kann.");
  SetProp(P_NAME, "Eternium");
  SetProp(P_GENDER, MALE);
  AddId (({"ruestung", "eternium", "ruestung der ewigkeit"}));
  SetProp(P_INFO,
    "Eternium ist eine einzigartige Ruestung.\n");  

  AddDetail( "energie", #'det_energie);

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_DAM_PROTECTION, ALL_DAMAGE_TYPES);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:2, T_HEAT_PROT:2 ]));
  SetProp(P_M_HEALTH_MOD, ([P_HP:5, P_SP:25]));
  SetProp(P_BERSERKER_BONUS, (["all":25]) );
  SetProp(P_PALADIN_SPELLCOST, 10);
  SetProp(P_ITEMD_ELEMENTAL_VALUE, 10);
  SetProp(P_NEKRO_SPELLCOST, 10);
  SetProp(P_NEKRO_BONUS, (["all":25]) );
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "sammelt die Energie der Ewigkeit",
    "erleichtert Gebete an Dusty", 
    "verbessert die Faehigkeiten eines Berserkers",
    "laesst Dich elementare Gewalten leichter handhaben",
    "verbessert die Faehigkeiten eines Nekromanten",
    "erhoeht Deine Lebenspunkte und erhoeht Deine Magiepunkte"}) ); 

  hits = 0;
}


int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  object who;
  who=QueryProp(P_WORN);
    
  if (who->QueryProp(P_HP)<50 && hits > 2000 )  
  {
    tell_object (who, 
        "Die Energie der Ewigkeit fliesst in Deinen Koerper.\n");
    who->AddHp(hits/20);
    who->AddSp(random(hits/20));
    hits = 0;
  }
  else
    hits ++;
  return random(10);
}

void reset()
{
  object who;
  ::reset();
  if(!is_clone(this_object()))  return; 
  if( (who=QueryProp(P_WORN)) && interactive(who) )
  {
    if(hits > 7000)
    {
      tell_object (who, 
          "Die Energie der Ewigkeit fliesst in Deinen Koerper.\n");
      who->AddHp(hits/40);
      who->AddSp(random(hits/40));
      hits = 0;
    }
    else if (hits < 500 && hits > 20)
    {
      tell_object (who, 
          "Deine Energie verfluechtigt sich in die Ewigkeit.\n");
      who->AddHp(-hits/5);
      who->AddSp(-hits/5);
      hits -= random(hits);
    }
  }
}

string det_energie(string detail)
{
  string ret;

  ret = "Die Energie von Eternium ist momentan ";

  if( hits > 7000 ) ret += "beinahe am ueberlaufen.";
  else if( hits >2000 ) ret += "stark aufgeladen.";
  else if( hits > 500 ) ret += "normal.";
  else if( hits > 20 ) ret += "gefaehrlich niedrig!";
  else ret += "leer.";

  return break_string(ret, 78);
}
