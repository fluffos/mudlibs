#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../../itemd.h"

inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
  if(!is_clone(this_object())) 
    return; 
  ::create();

  SetProp(P_SHORT, "Blitzgeschwind, die Schuhe des Dauerlaufes");
  SetProp(P_LONG,
    "Blitzgeschwind sind Lederschuhe, die auf den ersten Blick ganz normal "
    "aussehen. Nur die kleinen weissen Fluegel, die auf das hellbraune Leder "
    "gestickt sind, fallen auf den zweiten Blick auf. Der dritte "
    "Blick enthuellt, dass sich diese kleinen Fluegel ruhelos auf den "
    "Schuhen bewegen und die Schuhe fast zum schweben bringen. Der vierte "
    "Blick zeigt Dir, dass die Schuhe waehrend des Betrachtens schon ein "
    "gutes Stueck mit Dir herumgelaufen sind!");
  SetProp(P_NAME, "Blitzgeschwind");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"blitzgeschwind", "schuhe", "schuhe des dauerlaufes"}));
  SetProp(P_INFO,
    "Blitzgeschwind sind einzigartige Schuhe.\n");  

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:3, T_HEAT_PROT:3 ]));
  SetProp(P_M_HEALTH_MOD, ([P_HP:7, P_SP:7]) );
  call_other(FUNDIR + "defendfunc2", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR + "defendfunc2"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", "ist leichter",
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "ist rastlos"}) ); 
  AddCmd( "", "laufen", 1);
}

int laufen(string str)
{
  object who;
  string *cmds;
  string dir;

  if( query_verb() != "" && (who = QueryProp(P_WORN)) &&
      !who->QueryProp(P_RESTING) )
  {
    who->SetProp(P_MV, who->QueryProp(P_MAX_MV));
    cmds = m_indices(environment(who)->QueryProp(P_EXITS));
    
    if(member(cmds, query_verb()) != -1)
      return 0;
    if( !random(30+(who->InFight()?70:0)) && sizeof(cmds) )
    {
      dir = cmds[random(sizeof(cmds))];
      tell_object(who, "Blitzgeschwind tragen Dich nach " + 
          capitalize(dir)+ ".\n");
      who->command_me(dir);
    }
  }
  return 0;
}
