#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Lebensschutz, der Schild des Abpralls");
  SetProp(P_LONG,
    "Lebensschutz ist ein mittelgrosser Rundschild, der scheinbar jeglichen "
    "Schaden abwehren kann. Er besteht aus einem silbrig funkelnden Metall. "
    "Sicher ist dies der beste Schild, den man sich vorstellen kann.");
  SetProp(P_NAME, "Lebensschutz");
  SetProp(P_GENDER, MALE);
  AddId (({"lebensschutz", "schild", "schild des abpralls"}));
  SetProp(P_INFO,
    "Lebensschutz ist ein einzigartiger Schild.\n");  

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_ADAMANT:100]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:2, T_HEAT_PROT:6 ]));
  SetProp(P_M_ATTR_MOD, ([A_CON: 4 ]));
  call_other(FUNDIR+"defendfunc6", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfunc6"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "erhoeht oder erniedrigt Attribute"}) ); 
}

