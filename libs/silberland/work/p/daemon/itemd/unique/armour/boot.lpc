#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Sturmtaenzer, die Stiefel der Weltreise");
  SetProp(P_LONG,
    "Sturmtaenzer sind Stiefeln aus feinstem Leder, die sich auf magische "
    "Weise der Form jeglicher Fuesse anpassen. Auch die Sohle passt sich "
    "dem Untergrund an, sodass man ueberall festen Griff hat. Solche "
    "unglaublichen Stiefeln gibts es sonst nirgendwo im ganzen SilberLand.");
  SetProp(P_NAME, "Sturmtaenzer");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"sturmtaenzer", "stiefel", "stiefel der weltreise", 
           "UNZERSTOERBAR"}));
  SetProp(P_INFO,
    "Sturmtaenzer sind einzigartige Stiefeln.\n");  

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_TELEPORT_COST, 5);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:4, T_HEAT_PROT:2 ]));
  SetProp(P_M_ATTR_MOD, ([A_DEX: 4 ]));
  call_other(FUNDIR+"defendfuncparalyze2", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfuncparalyze2"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser",  
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "erhoeht oder erniedrigt Attribute",
    "verringert die Teleportationskosten"}) ); 
}

