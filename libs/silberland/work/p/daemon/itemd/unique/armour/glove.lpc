#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Titanenfaust, der Handschuh der Kraft");
  SetProp(P_LONG,
    "Titanenfaust ist ein Handschuh aus dickem Leder. Sobald man den Handschuh "
    "ueber die Hand streift, fuehlt man sofort eine gewaltige Kraft fliessen. "
    "Die Hand veraendert sich dann in eine gewaltige Titanenfaust. "
    "Sicher ist das der beste Handschuh, den es im ganzen SilberLand gibt.");
  SetProp(P_NAME, "Titanenfaust");
  SetProp(P_GENDER, FEMALE);
  AddId (({"titanenfaust", "faust", "handschuh", "handschuh der kraft",
           "\nelementarhandschuhe"}));
  SetProp(P_INFO,
    "Titanenfaust ist eine einzigartige Ruestung.\n");  

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:4, T_HEAT_PROT:2 ]));
//  SetProp(P_M_ATTR_MOD, ([A_STR: 8, A_DEX: -4])); 
//  geht nicht wegen +5 beschraenkung bei M_ATTR_MOD
  call_other(FUNDIR+"defendfunc3", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfunc3"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "erhoeht oder erniedrigt Attribute"}) ); 
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());
}

int WearFunc(object weapon) 
{
  SetProp(P_X_ATTR_MOD, ([A_STR:8, A_DEX:-3, A_CON:-1]) );
  write("Deine Muskeln schwellen gewaltig an!\n");
  environment(weapon)->UpdateAttributes();
  return 1;
}
 
int RemoveFunc(object weapon) 
{
  SetProp(P_X_ATTR_MOD, 0);
  environment(weapon)->UpdateAttributes();
  write("Du fuehlst Dich schwach!\n");
  return 1;
}

