#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Donnerhall, der Guertel der Sinnesschaerfe");
  SetProp(P_LONG,
    "Donnerhall ist ein breiter Lederguertel, der seinem Traeger "
    "unglaubliche Sinnesschaerfe verleiht. Viele kleine Augen und Ohren "
    "sind in den Guertel eingestickt. "
    "Einen besseren Guertel kann man im ganzen SilberLand nirgends finden.");
  SetProp(P_NAME, "Donnerhall");
  SetProp(P_GENDER, MALE);
  AddId ( ({"donnerhall", "guertel", "guertel der Sinnesschaerfe" }) );
  SetProp(P_INFO,
    "Donnerhall ist ein einzigartiger Guertel.\n");  

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:1, T_HEAT_PROT:1 ]));
  SetProp(P_M_ATTR_MOD, ([A_DEX: 1, A_INT: 3]));
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "heilt Taubheit im Kampf", "heilt Blindheit im Kampf",
    "wehrt zusaetzlichen Schaden ab", "erhoeht oder erniedrigt Attribute"}) ); 
}

int DefendFunc (string *dam_type, mixed spell, object enemy) 
{
  call_other(FUNDIR+"defendfuncdeaf2","DefendFunc", dam_type, spell, enemy);
  call_other(FUNDIR+"defendfuncblind2","DefendFunc", dam_type, spell, enemy);
  return random(10);
}
