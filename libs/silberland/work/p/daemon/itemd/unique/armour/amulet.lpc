
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
  if(!is_clone(this_object())) { 
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Herzensstaerke, das Amulett der Lebenskraft");
  SetProp(P_LONG,
    "Herzensstaerke ist ein herzfoermiges Amulett, das aus niemals "
    "verwelkenden Blumen geflochten wurde. Es staerkt Deine Lebenskraft "
    "und schuetzt Dich vor vielen Schaeden. "
    "Sicher ist Herzensstaerke das beste Amulett, das es gibt.\n");
  SetProp(P_NAME, "Herzensstaerke");
  SetProp(P_GENDER, FEMALE);
  AddId (({"herzensstaerke", "amulett", "amulett der lebenskraft" }));
  SetProp(P_INFO,
    "Herzensstaerke ist ein einzigartiges Amulett.\n");  

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_PLANT:50, MAT_MAGIC:50]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:1, T_HEAT_PROT:1 ]));
  call_other(FUNDIR+"defendfunc2", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfunc2"));
  SetProp(P_M_HEALTH_MOD, ([P_HP:75]));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", 
    "erhoeht die Lebensenergie und senkt Deine magische Energie"}) ); 
}

void reset()
{
  object pl, env;
  mapping e;
  string ter;
  if(!is_clone(this_object())) { 
    return; 
  }
  ::reset();
  if( (pl = QueryProp(P_WORN)) && interactive(pl))
  {
    if( (env = environment(pl)) && 
        mappingp(e = env->QueryProp(P_ENVIRONMENT)) &&
        intp(ter = e[ENV_TERRAIN]) )
    {
      switch(ter)
      {
        case TT_FOREST:
        case TT_JUNGLE:
        case TT_WATER:
        case TT_SWAMP:
        case TT_HILL:
        case TT_PLAIN:
          tell_object(pl, "Herzensstaerke blueht auf.\n");
          SetProp(P_M_HEALTH_MOD, ([P_HP:50+random(50)]));
          pl->UpdateAttributes();
          pl->heal_self(400);
          break;
        case TT_OTHER:
        case TT_UNDERWATER:
        case TT_TOWN:
        case TT_HOUSE:
        case TT_ROAD:
          tell_object(pl, "Herzensstaerke vegetiert vor sich hin.\n");
          SetProp(P_M_HEALTH_MOD, ([P_HP:20+random(20)]));
          pl->UpdateAttributes();
          pl->AddHp(10);
          break;
        case TT_CAVE:
        case TT_MOUNTAIN:
        case TT_DESERT:
        case TT_ARCTIC:
        default:
          tell_object(pl, "Herzensstaerke verwelkt unter diesen "
              "lebensfeindlichen Bedingungen.\n");
          SetProp(P_M_HEALTH_MOD, ([P_HP:1]));
          pl->UpdateAttributes();
          pl->AddHp(-1);
      }
    }
  }
}
