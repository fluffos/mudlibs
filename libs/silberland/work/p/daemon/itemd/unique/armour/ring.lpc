#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Weitblick, der Ring des allwissenden Auges");
  SetProp(P_LONG,
    "Weitblick ist ein magischer Ring, mit dem man angeblich weit in die "
    "Ferne blicken kann. Auf einem schmalen goldenen Band sitzt ein "
    "gewaltiger Edelstein, der fast wie ein Auge aussieht. Vielleicht "
    "kann man ja wirklich mit diesem Ring in die Ferne blicken. "
    "Sicher ist dies der beste Ring, die man sich vorstellen kann.");
  SetProp(P_NAME, "Weitblick");
  SetProp(P_GENDER, MALE);
  AddId (({"weitblick", "ring", "ring des allwissenden auges"}));
  SetProp(P_INFO,
    "Weitblick ist ein einzigartiger Ring.\n"
    "Mit 'weitblick' kannst Du in die benachbarten Raeume blicken.\n");  

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_GOLD:10, MAT_MAGIC:50, MAT_OCTARINE:40]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:1, T_HEAT_PROT:1 ]));
  SetProp(P_M_ATTR_MOD, ([A_INT: 2, A_CON: 2]));
  call_other(FUNDIR+"defendfuncblind2", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfuncblind2"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "schuetzt im Kampf vor Blindheit", "erhoeht oder erniedrigt Attribute"}) ); 

  AddCmd( ({"weitblick"}), "cmd_weitblick");
}

#define COST 3

int cmd_weitblick(string str)
{
  object who, room;
  mapping exits;
  string *dirs;
  int i;
  if( objectp(who=QueryProp(P_WORN)) && 
      mappingp(exits=environment(who)->QueryProp(P_NEW_EXITS)) )
  {
    if( who->QueryProp(P_SP) < COST )
      return notify_fail("Du hast zu wenig Magiepunkte fuer einen Weitblick!\n"),0;
    who->AddSp(-COST);
    dirs = m_indices(exits);
    if( !str )
    {
      for(i=sizeof(dirs)-1; i>=0; i--)
      {
        if( stringp(exits[dirs[i]][EX_DEST]) &&
            objectp(room=find_object(exits[dirs[i]][EX_DEST])) )
        {
          tell_object(who,"\nIn Richtung "+capitalize(dirs[i])+" siehst Du:\n"+
              room->int_short(who,this_object()));
        }
      }
      tell_object(who,"\n");
    }
    else
    {
      if( member(dirs, str)==-1)
        return notify_fail("So eine Richtung gibt es nicht!\n"),0;
      if( objectp(room=find_object(exits[str][EX_DEST])) )
      {
        tell_object(who,"\nIn Richtung "+capitalize(str)+" siehst Du:\n"+
            room->int_long(who,this_object())+"\n");
      }
    }
    return 1;
  }
  return 0;
}
