#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Goldbringer, der Armreif des Gluecks");
  SetProp(P_LONG,
    "Goldbringer ist ein breiter Armreif aus purem Gold, der mit feinen "
    "Runen aus Mithril verziert ist. Die Runen sind Symbole fuer Glueck "
    "und Reichtum. "
    "Sicher ist dies der beste Armreif, den man sich vorstellen kann.");
  SetProp(P_NAME, "Goldbringer");
  SetProp(P_GENDER, MALE);
  AddId (({"goldbringer", "armreif", "armreif des gluecks" }));
  SetProp(P_INFO,
    "Goldbringer ist ein einzigartiger Armreif.\n");  

  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_GOLD:90, MAT_MITHRIL:10]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:3, T_HEAT_PROT:2 ]));
  SetProp(P_M_HEALTH_MOD, ([P_HP:15, P_SP:15]));
  call_other(FUNDIR+"defendfuncmoney2", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfuncmoney2"));
  SetProp(ITEMD_PROB_CHANGE, 50);
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "erhoeht die Lebenspunkte und die Magiepunkte", 
    "laesst Dich VIEL mehr magische Gegenstaende finden"}) ); 
}

