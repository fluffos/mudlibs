#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Gedankenblitz, die Krone der Weisheit");
  SetProp(P_LONG,
    "Gedankenblitz ist eine Krone aus purem Gold und schuetzt den Kopf "
    "besser als jeder andere Helm. Viele Edelsteine sind in die Krone "
    "eingesetzt. Die vielen Spitzen der Krone schauen sehr gefaehrlich aus.");
  SetProp(P_NAME, "Gedankenblitz");
  SetProp(P_GENDER, MALE);
  AddId (({"gedankenblitz", "krone", "krone der weisheit"}));
  SetProp(P_INFO,
    "Gedankenblitz ist ein einzigartiger Helm.\n");  

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_GOLD:80, MAT_JEWEL:20]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_EFFECTIVE_WC, 200);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:4, T_HEAT_PROT:3 ]));
  SetProp(P_M_ATTR_MOD, ([A_INT: 5, A_DEX: -1]));
  call_other(FUNDIR+"defendfunc4", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfunc4"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "erhoeht oder erniedrigt Attribute"}) ); 
}

