#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Himmelsflug, der Umhang der Freiheit");
  SetProp(P_LONG,
    "Himmelsflug ist ein Umhang, der nur aus Federn und kleinen Luftwirbeln "
    "zu bestehen scheint. Irgendeine Art von Magie haelt das ganze zusammen "
    "und verbindet es zum besten Umhang, den man sich nur vorstellen kann.");
  SetProp(P_NAME, "Himmelsflug");
  SetProp(P_GENDER, MALE);
  AddId (({"himmelsflug", "umhang", "umhang der freiheit"}));
  SetProp(P_INFO,
    "Himmelsflug ist eine einzigartiger Umhang.\n");  

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_AIR:50, MAT_FEATHER:50]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:6, T_HEAT_PROT:2 ]));
  SetProp(P_M_ATTR_MOD, ([A_DEX: 4]));
  call_other(FUNDIR+"defendfuncparalyze2", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfuncparalyze2"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "erhoeht Attribute",
    "verhindert im Kampf Paralyse"}) ); 
}

