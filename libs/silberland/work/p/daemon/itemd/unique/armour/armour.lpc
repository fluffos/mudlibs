
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
  if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Silberfunke, der Panzer der Goettlichkeit");
  SetProp(P_LONG,
    "Silberfunke ist ein Plattenpanzer aus einem silbrig schimmernden "
    "Metall. Vorder- und Rueckenplatte sind fein ziseliert und mit vielen "
    "Schlachtmotiven geschmueckt, die mit Silber und Gold ausgelegt sind. "
    "Sicher ist dies die beste Ruestung, die man sich vorstellen kann.");
  SetProp(P_NAME, "Silberfunke");
  SetProp(P_GENDER, MALE);
  AddId (({"panzer","plattenpanzer", "silberfunke", "panzer der goettlichkeit"}));
  SetProp(P_INFO,
    "Silberfunke ist eine einzigartige Ruestung.\n");  

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_DAM_PROTECTION, ALL_DAMAGE_TYPES);
  SetProp(P_MATERIAL, ([MAT_ADAMANT:100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:6, T_HEAT_PROT:2 ]));
  SetProp(P_M_ATTR_MOD, ([A_STR: 1, A_CON: 1, A_INT:1, A_DEX:1]));
  call_other(FUNDIR+"defendfunc3", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfunc3"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", "ist leichter", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "erhoeht oder erniedrigt Attribute"}) ); 
}
