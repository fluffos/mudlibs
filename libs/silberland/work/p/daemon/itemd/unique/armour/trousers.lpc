#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_armour";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Wirbelwind, die Hose der Macht");
  SetProp(P_LONG,
    "Wirbelwind ist eine Hose aus feinster, glaenzender Seide. Sie strahlt "
    "eine Aura von gewaltiger Macht aus. "
    "Noch nie hast Du eine besser gefertigte Hose gesehen.");
  SetProp(P_NAME, "Wirbelwind");
  SetProp(P_GENDER, MALE);
  AddId (({"wirbelwind", "hose", "hose der macht"}));
  SetProp(P_INFO,
    "Wirbelwind ist eine einzigartige Hose.\n");  

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_SILK:100]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:5, T_HEAT_PROT:2 ]));
  SetProp(P_M_ATTR_MOD, ([A_DEX: 2, A_INT: 2]));
  SetProp(P_M_HEALTH_MOD, ([P_HP:-20, P_SP:50]));
  call_other(FUNDIR+"defendfunc5", "???");
  SetProp(P_DEFEND_FUNC, find_object(FUNDIR+"defendfunc5"));
  SetProp("itemd", ({"ist einzigartig", "schuetzt vor mehr Schaeden", 
    "nuetzt sich ueberhaupt nicht ab", "schuetzt besser", 
    "veraendert den Temperaturschutz", "ist wertvoller", "ist unzerstoerbar",
    "wehrt zusaetzlichen Schaden ab", "erhoeht oder erniedrigt Attribute"}) ); 
}

