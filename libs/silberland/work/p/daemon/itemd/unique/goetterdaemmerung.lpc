
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <vt100.h>
#include <ansi.h>
#include "../itemd.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Goetterdaemmerung, die beste Axt des Silberlandes");
  SetProp(P_LONG,  
    "Goetterdaemmerung ist die beste Axt des Silberlandes. Nur Feyaria "
    "kann sie zuecken.");
  SetProp(P_NAME, "Goetterdaemmerung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "goetterdaemmerung"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 300);
  SetProp(P_WC_FIX, 100);
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_ADAMANT:35, MAT_FIRE:5, MAT_STEEL:60,]));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_SIZE, 120);
  SetProp(P_ARTICLE, 0);
  SetProp(P_VALUE, 100000);
  SetProp(P_QUALITY_DECAY, 0 );
  SetProp(P_MAGIC, 12);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1, P_LEVEL: 999, P_GUILD_LEVEL: 12]) );
  SetProp("waffenbalsam", 10);
  call_other(FUNDIR+"hitfunc6", "???");
  SetProp(P_HIT_FUNC, find_object(FUNDIR+"hitfunc6"));
}

string name(int casus, int daemon)
{
  string n;
  n=::name(casus, daemon);
  if( this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return VT_RED+VT_TA_B+n+VT_NORMAL;
  else if( this_player() && this_player()->QueryProp(P_TTY)=="vt100")
    return VT_TA_B+n+VT_NORMAL;
  return n;
}

string Name(int casus, int daemon)
{
  return capitalize(name(casus,daemon));
}

string short()
{
  string s;
  if(QueryProp(P_WIELDED)) 
    s=" ("+(QueryProp(P_WIELDED_TEXT)||"gezueckt")+")"; 
  else 
    s="";
  if(this_player() && this_player()->QueryProp(P_TTY)=="ansi")
     return VT_RED+VT_TA_B+QueryProp(P_SHORT)+VT_NORMAL+s+".\n"; 
  else if(this_player() && this_player()->QueryProp(P_TTY)=="vt100")
     return VT_TA_B+QueryProp(P_SHORT)+VT_NORMAL+s+".\n"; 
  return QueryProp(P_SHORT)+s+".\n";
}

