
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <vt100.h>
#include <ansi.h>
#include "../itemd.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  if(!IS_ARCH(previous_object()) && (file_name(previous_object())!=
      "/p/daemon/itemd/itemd")) 
  {
    raise_error("Illegales Clonen eines Uniques!!!!\n");
    destruct();
    return;
  }
  AddId(({"ITEMD_UNIQUE_ITEM", "NODESTRUCT", "UNZERSTOERBAR"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_VALUE, 100000);
  SetProp(P_QUALITY_DECAY, 0 );
  SetProp(P_MAGIC, 12);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp("waffenbalsam", 10);
  SetProp(P_ITEMD_TMPMAGIC, ({1111,1111}));
}

void reset()
{
  object ob;
  int dam;

  if (!is_clone(this_object()))
    return;
  ::reset();

  if ((ob=QueryProp(P_WIELDED)) && interactive(ob))  // nur, wenn eingeloggt
  {
    if((dam=QueryProp(P_DAMAGED)) && (time()-QueryProp(P_LAST_USE))<1200)
    {
      Damage(-dam/2-random(dam-dam/2+1));
      tell_object(ob, "Einige Scharten von "+name(WEM)+" verschwinden.\n");
    }
  }
}

string name(int casus, int daemon)
{
  string n;
  n=::name(casus, daemon);
  if( this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return VT_YELLOW+VT_TA_B+n+VT_NORMAL;
  else if( this_player() && this_player()->QueryProp(P_TTY)=="vt100")
    return VT_TA_B+n+VT_NORMAL;
  return n;
}

string Name(int casus, int daemon)
{
  return capitalize(name(casus,daemon));
}

string short()
{
  string s;
  if(QueryProp(P_WIELDED)) 
    s=" ("+(QueryProp(P_WIELDED_TEXT)||"gezueckt")+")"; 
  else 
    s="";
  if(this_player() && this_player()->QueryProp(P_TTY)=="ansi")
     return VT_YELLOW+VT_TA_B+QueryProp(P_SHORT)+VT_NORMAL+s+".\n"; 
  else if(this_player() && this_player()->QueryProp(P_TTY)=="vt100")
     return VT_TA_B+QueryProp(P_SHORT)+VT_NORMAL+s+".\n"; 
  return QueryProp(P_SHORT)+s+".\n";
}
