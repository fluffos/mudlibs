
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../../itemd.h"
#include "/gilden/berserker/berserker_extern.h"

inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

int zorn=0;
int hit=0;
int had_aggressive=0;

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }

  ::create();

  SetProp(P_SHORT, "Zorn, die Axt der ewigen Schlachten");
  SetProp("itemd_name", "Zorn, die Axt der ewigen Schlachten");
  SetProp(P_LONG,  
    "Zorn ist eine gewaltige Axt, das Axtblatt ist aus glaenzendem "
    "Mithril gefertigt und messerscharf, der Schaft hingegen "
    "besteht aus bestem Stahl. Zorn wurde von den groessten Helden eines "
    "jeden Zeitalters in den bedeutendsten Schlachten benutzt. "
    "Allerdings brachte er den meisten Besitzern wenig Glueck, da "
    "sie sich im Kampf in einen wahrhaftigen Blutrausch steigerten. "
    "Du bist Dir sicher, dass dies eine der maechtigsten Aexte im "
    "ganzen SilberLand ist.");
  SetProp(P_NAME, "Zorn");
  SetProp(P_GENDER, MALE);
  AddId( ({"zorn", "axt", "axt der ewigen schlachten"}) );
  SetProp(P_INFO, 
    "Zorn ist eine einzigartige Axt.\n");

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 295);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_MITHRIL:55, MAT_STEEL:45]));
  SetProp(P_WEIGHT, 2000);
  SetProp(P_SIZE, 150);
  SetProp(P_M_HEALTH_MOD, ([P_HP:12, P_SP:12]));
  SetProp(P_BERSERKER_BONUS, (["all":20]) );
  SetProp(P_HIT_FUNC, TO); 
//  SetProp(P_UNWIELD_FUNC, TO); und Wo is die UnwieldFunc() ? (feyaria) bitte nicht ungefragt an meinen uniques rumpfuschen wenn man sich net auskennt
  SetProp("itemd", ({"ist einzigartig",   
    "nuetzt sich ueberhaupt nicht ab",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "macht zusaetzlichen Schaden",
    "macht Dich zum Berserker", "verbessert die Faehigkeiten eines Berserkers",
    "erhoeht die Lebenspunkte und erhoeht die Magiepunkte"}) );
}

int HitFunc(object enemy) 
{
  int dam, p;
  object wielder;

  wielder = QueryProp(P_WIELDED);
  if(!wielder) return 0;
  call_other(FUNDIR+"hitfuncblutrausch2", "HitFunc", enemy);
  p = 100 - 100 * enemy->QueryProp(P_HP) / enemy->QueryProp(P_MAX_HP);
  dam = -55 + p + p*p/50;
  if(!zorn) hit++;
  else hit-=10+random(10);
  if(hit>1000 && !zorn) 
  {
    write("ZORN GERAET IN RAGE! TOETEN!\n");
    if(wielder->QueryProp(P_AGGRESSIVE))
      had_aggressive=1;
    else
      SetProp(P_AGGRESSIVE, 0.1);
    zorn=1;
  }
  if(hit<1 && zorn) {
    write("Zorn beruhigt sich wieder.\n");
    if(!had_aggressive)
      wielder->SetProp(P_AGGRESSIVE,0);
    had_aggressive=0;
    zorn=0;
  }
  return (dam > 300 ? 300 : dam);
}

/* Wer hat das hier verbrochen? so kann man Zorn NIE!!!! wegstecken!!! (feyaria)
varargs int DoUnwield(int silent) {
  if(zorn) {
    write("Zorn moechte nicht weggesteckt werden!\n");
    return 1;
  }
  return 0;
}
*/

void BecomesNetDead(object player) {
  object wielder;
  wielder=QueryProp(P_WIELDED);
  if(wielder != player) return;
  if(wielder->InFight()) {
    write("UEBER DEINE FEIGHEIT GERAET ZORN IN RAGE!\n");
    if(wielder->QueryProp(P_AGGRESSIVE))
      had_aggressive=1;
    else
      SetProp(P_AGGRESSIVE, 0.1);
    zorn=1;
    hit=200+random(100);
  }
  return;
}
