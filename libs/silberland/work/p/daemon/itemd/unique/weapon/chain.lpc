
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }

  ::create();

  SetProp(P_SHORT, "Daemmerungsfeuer, der Morgenstern der Schlachten");
  SetProp("itemd_name", "Daemmernungsfeuer, den Morgenstern der Schlachten");
  SetProp(P_LONG, 
    "Daemmerungsfeuer ist ein maechtiger Morgenstern, der aus silbrig "
    "schimmernden Metall gefertigt ist und in daemmrigem Licht strahlt. "
    "Der Stiel besteht aus feinstem Zwergenstahl. "
    "Du bist Dir sicher, dass dies die maechtigste aller Kettenwaffen ist.");
  SetProp(P_NAME, "Daemmerungsfeuer");
  SetProp(P_GENDER, MALE);
  AddId( ({"daemmerungsfeuer", "morgenstern", "morgenstern der schlachten"}) );
  SetProp(P_INFO, 
    "Daemmerungsfeuer ist ein einzigartiger Morgenstern.\n");

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 200);
  SetProp(P_WC_FIX, 90);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_RIP, DT_TERROR}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_ADAMANT:45, MAT_STEEL:55]));
  SetProp(P_WEIGHT, 2500);
  SetProp(P_SIZE, 100);
  SetProp(P_M_ATTR_MOD, ([A_STR: 3, A_INT: 2]));
  SetProp(P_HIT_FUNC, TO); 
  SetProp("itemd", ({"ist einzigartig", 
    "nuetzt sich ueberhaupt nicht ab", "liegt besser in der Hand",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "veraendert den Schaden auf unbekannte Art",
    "erhoeht oder erniedrigt Attribute"}) );

}

int HitFunc(object enemy) {
  object wielder;
  wielder=QueryProp(P_WIELDED);
  if(wielder->QueryProp(P_MV) < 100) {
    tell_object(wielder, BS("Du bist so erschoepft, dass Du Daemmerungsfeuer "
        "fallen laesst!"));
    DoUnwield();
    if(ENV(wielder))
      ME->move(ENV(wielder), M_NOCHECK);
    return 0;
  }
  else {
    wielder->do_exhaust(10);
    if(!random(5)) {
      tell_object(wielder, BS("Das Kaempfen mit Daemmerungsfeuer erschoepft "
            "Dich sehr.")); 
    }
  }
  return call_other(
     FUNDIR+"hitfuncparalyze1", "HitFunc", enemy); 
}
