#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

void create()
{

 if(!is_clone(this_object())) {
    return; 
  }
 
  ::create();

  SetProp(P_SHORT, "Herzsucher, der Speer der Rache");
  SetProp("itemd_name", "Herzsucher, den Speer der Rache");
  SetProp(P_LONG,  
    "Herzsucher ist ein Speer aus tiefschwarzem Holz mit einer schlanken "
    "Spitze aus ebenso tiefschwarzem Obsidian. Der Speer liegt wunderbar "
    "leicht in der Hand und hat keinen einzigen Kratzer. Du bist Dir "
    "sicher, dass Du noch nie so einen maechtigen Speer gesehen hast.");
  SetProp(P_NAME, "Herzsucher");
  SetProp(P_GENDER, MALE);
  AddId( ({"herzsucher", "speer", "speer der rache"}) );
  SetProp(P_INFO, 
    "Herzsucher ist ein einzigartiger Speer.\n");

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 255);
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_EBONY:80, MAT_OBSIDIAN:20,]));
  SetProp(P_WEIGHT, 1300);
  SetProp(P_SIZE, 220);
  SetProp(P_M_ATTR_MOD, ([A_DEX: 3, A_INT: 2]));
  SetProp(P_HIT_FUNC, TO);
  SetProp("itemd", ({"ist einzigartig",  
    "nuetzt sich ueberhaupt nicht ab", "liegt besser in der Hand",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "laesst Dich schneller attackieren",
    "erhoeht oder erniedrigt Attribute"}) );
}

int HitFunc(object enemy) 
{
  int malus;
  if( enemy->QueryProp(P_SIZE)<100+random(50) )
    malus = 200 - enemy->QueryProp(P_SIZE);
  else
    malus = 0;
  return malus+call_other(FUNDIR+"hitfuncspeed2", "HitFunc", enemy);
}
