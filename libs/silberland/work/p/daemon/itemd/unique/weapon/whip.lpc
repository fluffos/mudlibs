#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

void create()
{

 if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Seelengeissel, die Peitsche der Zerstoerung");
  SetProp("itemd_name", "Seelengeissel, die Peitsche der Zerstoerung");
  SetProp(P_LONG, 
    "Seelengeissel ist eine dreischwaenzige Peitsche mit ledernem Griff. "
    "Eine Peitschenschnur leuchtet hellrot und scheint zu brennen, die zweite "
    "ist blauweiss und eisig kalt, waehrend die dritte regenbogenfarben ist "
    "und bestimmt stark magisch. Das ist sicher die maechtigste Peitsche, "
    "die Du je gesehen hast.");
  SetProp(P_NAME, "Seelengeissel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"seelengeissel", "geissel", "peitsche", "peitsche der zerstoerung" }) );
  SetProp(P_INFO, 
    "Selengeissel ist eine einzigartige Peitsche.\n"
    "Sie scheint die magische Kraft der Gegner aufzusaugen.\n");

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 200);
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, ({DT_WHIP, DT_FIRE, DT_MAGIC, DT_COLD}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_LEATHER:10, MAT_FIRE:30, MAT_MAGIC:30, MAT_ICE:30]));
  SetProp(P_WEIGHT, 700);
  SetProp(P_SIZE, 400);
  SetProp(P_M_ATTR_MOD, ([A_INT: 3, A_DEX: 3]));
  SetProp(P_HIT_FUNC, TO);
  SetProp("itemd", ({"ist einzigartig", 
    "nuetzt sich ueberhaupt nicht ab", "liegt besser in der Hand",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "veraendert den Schaden auf unbekannte Art", 
    "erhoeht oder erniedrigt Attribute"}) );
}

int HitFunc(object enemy) 
{
  if( !random(33) )
  {
    tell_object(QueryProp(P_WIELDED),
        "Eine der Peitschenschnuere trifft Dich!\n");
    QueryProp(P_WIELDED)->AddSp(-1-random(3));
    return -100;
  }
  else if( !random(66) )
  {
    tell_object(QueryProp(P_WIELDED),
        "Zwei der Peitschenschnuere treffen Dich!\n");
    QueryProp(P_WIELDED)->AddSp(-2-random(6));
    return -200;
  }
  else if( !random(99) )
  {
    tell_object(QueryProp(P_WIELDED),
        "Alle drei Peitschenschnuere treffen Dich!\n");
    QueryProp(P_WIELDED)->AddSp(-3-random(9));
    return -300;
  }
  return random(30) + call_other(FUNDIR+"hitfuncvampire2", "HitFunc", enemy);
}
