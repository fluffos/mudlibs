
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }

  ::create();

  SetProp(P_SHORT, "Weltenbrand, das Beil der Vernichtung");
  SetProp("itemd_name", "Weltenbrand, das Beil der Vernichtung");
  SetProp(P_LONG,  
    "Weltenbrand ist ein gewaltiges Beil, dessen silbrig schimmernde Klinge "
    "von roten und gelben Feuerzungen umgeben ist. Der lange, staehlerne "
    "Griff bietet genug Platz, um Weltenbrand mit beiden Haenden zu halten. "
    "Du bist Dir sicher, dass Weltenbrand die maechtigste aller Aexte ist.");
  SetProp(P_NAME, "Weltenbrand");
  SetProp(P_GENDER, MALE);
  AddId( ({"beil", "weltenbrand", "beil der vernichtung"}) );
  SetProp(P_INFO, 
    "Weltenbrand ist eine einzigartige Axt.\n");

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 275);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_ADAMANT:35, MAT_FIRE:5, MAT_STEEL:60,]));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_SIZE, 120);
  SetProp(P_KILL_NAME, "Weltenbrand");
  SetProp(P_KILL_MSG, "DU WARST MEIN OPFER!");
  SetProp(P_M_ATTR_MOD, ([A_STR: 5, A_CON: 1]));
  SetProp(P_HIT_FUNC, TO); 
  SetProp("itemd", ({"ist einzigartig",   
    "nuetzt sich ueberhaupt nicht ab", "liegt besser in der Hand",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "macht zusaetzlichen Schaden",
    "erhoeht oder erniedrigt Attribute"}) );
}


int HitFunc(object enemy) {
  int loss;
  object wielder;
  int dam;
  
  loss=random(2)+1;
  wielder=QueryProp(P_WIELDED);
  dam = (int) call_other( FUNDIR+"hitfuncverwuestung2", "HitFunc", enemy);
  if(dam > 40) {
    if(wielder->QueryProp(P_SP)<loss) {
      tell_object(wielder, "WELTENBRAND FORDERT EIN OPFER VON DIR!\n");
      wielder->do_damage(loss);
    }
    else 
      wielder->AddSp(-loss);
    if(ENV(wielder))
      tell_room(ENV(wielder), "WELTENBRAND VERNICHTET SEIN OPFER!\n");
  }
  return dam;
}
