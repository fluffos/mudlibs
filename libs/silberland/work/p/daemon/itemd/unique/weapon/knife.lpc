#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

void create()
{

 if(!is_clone(this_object())) {
    return; 
  }

  ::create();

  SetProp(P_SHORT, "Schlitzer, der Dolch der Meuchler");
  SetProp("itemd_name", "Schlitzer, den Dolch der Meuchler");
  SetProp(P_LONG,  
    "Schlitzer ist ein stark gekruemmter Dolch aus einem silbrig glaenzenden "
    "Metall. Er besitzt eine toedliche Schaerfe. Der Griff ist aus feinstem "
    "Platin und mit den Symbolen der Diebes- und Meuchlergilden verziert. "
    "Du bist Dir sicher, noch keinen besseren Dolch gesehen zu haben.");
  SetProp(P_NAME, "Schlitzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"schlitzer", "dolch", "dolch der meuchler"}) );
  SetProp(P_INFO, 
    "Schlitzer ist ein einzigartiger Dolch.\n"
    "Er scheint die Lebenskraft der Gegner aufzusaugen.\n");

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_TERROR}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_ADAMANT:70, MAT_PLATINUM:30]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 40);
  SetProp(P_M_ATTR_MOD, ([A_DEX:5]));
  SetProp(P_HIT_FUNC, this_object());
  SetProp("itemd", ({"ist einzigartig",   
    "nuetzt sich ueberhaupt nicht ab", "liegt besser in der Hand",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "veraendert den Schaden auf unbekannte Art",
    "erhoeht oder erniedrigt Attribute"}) );

}

int HitFunc(object enemy) {
  if(!random(10)) 
    return random(200);
  return call_other(FUNDIR+"hitfuncblood3", "HitFunc", enemy);
}
