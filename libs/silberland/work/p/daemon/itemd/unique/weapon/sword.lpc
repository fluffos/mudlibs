#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

void create()
{

  if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Raecher, das Schwert der Vollstreckung");
  SetProp("itemd_name", "Raecher, das Schwert der Vollstreckung");
  SetProp(P_LONG,  
    "Raecher ist ein fein gearbeitetes Langschwert mit einer gleissenden "
    "Klinge, dessen Schaerfe unuebertroffen ist. Der vergoldete Griff ist "
    "mit vielen kleinen Diamanten verziert, die im hellen Licht funkeln. "
    "Sicher ist dies das beste Schwert, das Du jemals gesehen hast.");
  SetProp(P_NAME, "Raecher");
  SetProp(P_GENDER, MALE);
  AddId( ({"raecher", "schwert", "schwert der rache"}) );
  SetProp(P_INFO, 
    "Raecher ist ein einzigartiges Schwert.\n");

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 220);
  SetProp(P_WC_FIX, 70);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_ADAMANT:75, MAT_DIAMOND:5, MAT_GOLD:20]));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_SIZE, 120);
  SetProp(P_HIT_FUNC, TO);
  SetProp(ITEMD_PROB_CHANGE, -99);
  SetProp(P_M_ATTR_MOD, ([A_STR: 2, A_CON: 2]));
  SetProp("itemd", ({"ist einzigartig",
    "nuetzt sich ueberhaupt nicht ab", "liegt besser in der Hand",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "laesst Dich manchmal schneller angreifen",
    "erhoeht oder erniedrigt Attribute", "macht Dich aggressiv", 
    "saugt Leben von Deinem Gegner", "ist von einer unbekannten, mystischen "
    "Aura umgeben"}) );

}

// Den logischen Denk"fehler", dass es sicher auf 0 gesetzt wird, lass ich
// drinnen. Sehen wirs al "goodie"
int WieldFunc(object weapon) {
  environment(weapon)->SetProp(P_AGGRESSIVE, 0.25);
  return 1;
}

int UnwieldFunc(object weapon) {
  environment(weapon)->SetProp(P_AGGRESSIVE, 0);
  return 1;
}

int HitFunc(object enemy) {
  call_other(FUNDIR+"hitfuncblood1", "HitFunc", enemy);
  return call_other(FUNDIR+"hitfuncspeed1", "HitFunc", enemy);
}
