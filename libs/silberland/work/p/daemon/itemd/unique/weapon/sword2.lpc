#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

int rotate;
string det_zacken(string detail);

void create()
{

  if(!is_clone(this_object())) {
    return; 
  }
  ::create();

  SetProp(P_SHORT, "Todesdorn, die Klinge der Verdammten");
  SetProp("itemd_name", "Todesdorn, die Klinge der Verdammten");
  SetProp(P_LONG,  
    "Todesdorn ist eine furchterregende, gezackte Klinge aus einem "
    "unbekannten, tiefschwarzen Metall, das in duesterem Licht leuchtet. "
    "Eine finstere Macht scheint von dieser Klinge besitzt ergriffen zu "
    "haben und versucht, den Besitzer in die Verdammnis zu treiben. "
    "Sicher ist dies das beste Schwert, das Du jemals gesehen hast.");
  SetProp(P_NAME, "Todesdorn");
  SetProp(P_GENDER, MALE);
  AddId( ({"todesdorn", "klinge", "klinge der verdammten"}) );
  SetProp(P_INFO, 
    "Todesdorn ist ein einzigartiges Schwert.\n");

  AddDetail( ({"klinge"}),
      "Die Klinge hat fuenf fuerchterliche Zacken.");
  AddDetail( ({"zacken"}), #'det_zacken);
  
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 200);
  SetProp(P_WC_FIX, 75);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_RIP, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_IRIDIUM: 75, MAT_PLUTONIUM:25]));
  SetProp(P_WEIGHT, 1100);
  SetProp(P_SIZE, 130);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_M_HEALTH_MOD, ([P_HP:13, P_SP:13]));
  SetProp("itemd", ({"ist einzigartig",
    "nuetzt sich ueberhaupt nicht ab", "liegt besser in der Hand",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "ist verdammt", "macht zusaetzlichen Schaden",
    "macht mehr Schaden auf alle guten Rassen",
    "erhoeht Deine Lebenspunkte und erhoeht Deine Magiepunkte", 
    }) );
  rotate = 0;
}

int HitFunc(object enemy) 
{
  int dam;
  dam = random(20);
  if( rotate < 3 )
    dam += call_other(FUNDIR+"hitfunchuman1", "HitFunc", enemy);
  if( rotate > 0 && rotate < 4 )
    dam += call_other(FUNDIR+"hitfuncelf1", "HitFunc", enemy);
  if( rotate > 1 )
    dam += call_other(FUNDIR+"hitfuncdwarf1", "HitFunc", enemy);
  if( rotate < 1 || rotate > 2 )
    dam += call_other(FUNDIR+"hitfunchobbit1", "HitFunc", enemy);
  if( rotate < 2 || rotate > 3 )
    dam += call_other(FUNDIR+"hitfuncfairy1", "HitFunc", enemy);
  return dam;
}

void reset()
{
  object wer;
  if(!is_clone(this_object()))  return; 
  ::reset();
  if( !random(10) && objectp(wer=QueryProp(P_WIELDED)) && interactive(wer) &&
      query_idle(wer) < 30 && !wer->InFight() )
  {
    write("\nDie Macht von Todesdorn schickt Dich in die Verdammnis!\n\n");
    wer->move("/d/unterwelt/stahldorn/dammnis/room/dam_c4", M_TPORT,
        "verdammt", "wird", "wird hierher verdammt" );
  }
  rotate=(++rotate)%5;
}

string det_zacken(string detail)
{
  string ret;
  string *rassen;

  rassen = ({});
  if( rotate < 3 )
    rassen +=({"Menschen"});
  if( rotate > 0 && rotate < 4 )
    rassen +=({"Elfen"});
  if( rotate > 1 )
    rassen +=({"Zwerge"});
  if( rotate < 1 || rotate > 2 )
    rassen +=({"Hobbits"});
  if( rotate < 2 || rotate > 3 )
    rassen +=({"Feen"});
  ret = "Die Zacken scheinen irgendwie an die guten Rassen zu erinnern. "
    "Die Zacken der "+rassen[0]+", der "+rassen[1]+" und der "+
    rassen[2]+" leuchten momentan.";
  return break_string(ret,78);
}
