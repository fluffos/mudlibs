
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../../itemd.h"
inherit ITEMD_UNIQUE_PATH "std_unique_weapon";

void create()
{
 if(!is_clone(this_object())) {
    return; 
  }

  ::create();

  SetProp(P_SHORT, "Zermalmer, der Hammer der Goetter");
  SetProp("itemd_name", "Zermalmer, den Hammer der Goetter");
  SetProp(P_LONG,  
    "Zermalmer ist ein maechtiger Kriegshammer auf silbrig funkeldem Metall. "
    "Der Griff aus Mithril ist mit vielen Symbolen des Kampfes und Sieges "
    "verziert. Angeblich kann man mit dieser brutalen Waffe jeden Gegner "
    "zu feinem Staub zerbroeseln. Du bist Dir sicher, zuvor noch nie einen "
    "aehnlich maechtigen Hammer gesehen zu haben.");
  SetProp(P_NAME, "Zermalmer");
  SetProp(P_GENDER, MALE);
  AddId( ({"zermalmer", "hammer", "hammer der goetter"}) );
  SetProp(P_INFO, 
    "Zermalmer ist ein einzigartiger Hammer.\n");

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 280);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_ADAMANT:50, MAT_MITHRIL:50,]));
  SetProp(P_WEIGHT, 3000);
  SetProp(P_SIZE, 120);
  SetProp(P_M_ATTR_MOD, ([A_STR: 5]));
  SetProp(P_HIT_FUNC, TO); 
  SetProp("itemd", ({"ist einzigartig",  
    "nuetzt sich ueberhaupt nicht ab", "liegt besser in der Hand",
    "ist wertvoller", "macht grundsaetzlich mehr Schaden",
    "ist unzerstoerbar", "macht zusaetzlichen Schaden",
    "erhoeht oder erniedrigt Attribute"}) );
}

int HitFunc(object enemy) {
      return call_other(FUNDIR+"hitfuncverwuestung1", "HitFunc", enemy);
}
