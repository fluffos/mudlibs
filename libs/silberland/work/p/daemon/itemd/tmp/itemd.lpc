  if(!CheckPermission(TP)) return 0;

  what=({WEAPON_PREFIX, WEAPON_SUFFIX, ARMOUR_SUFFIX, ARMOUR_PREFIX});
  mag=({LOW_MAGIC, MED_MAGIC, HIGH_MAGIC, VHIGH_MAGIC, GODLY_MAGIC});
