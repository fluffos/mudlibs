  wh("})\n\n\n");
  wh("#define LOW_SUFFIX_ARMOUR ({\\\n");
  for(i=0;i<=sizeof(pre_suf[ARMOUR_SUFFIX][LOW_MAGIC])-1;i++) {
    txt=sprintf("%#:80O", pre_suf[ARMOUR_SUFFIX][LOW_MAGIC][i]);
    wh(sprintf("%s%s,\\\n", txt[0..2],txt[23..]));
  }
  wh("})\n\n\n");
  wh("#define MED_SUFFIX_ARMOUR ({\\\n");
  for(i=0;i<=sizeof(pre_suf[ARMOUR_SUFFIX][MED_MAGIC])-1;i++) {
    txt=sprintf("%#:80O", pre_suf[ARMOUR_SUFFIX][MED_MAGIC][i]);
    wh(sprintf("%s%s,\\\n", txt[0..2],txt[23..]));
  }
  wh("})\n\n\n");
  wh("#define HIGH_SUFFIX_ARMOUR ({\\\n");
  for(i=0;i<=sizeof(pre_suf[ARMOUR_SUFFIX][HIGH_MAGIC])-1;i++) {
    txt=sprintf("%#:80O", pre_suf[ARMOUR_SUFFIX][HIGH_MAGIC][i]);
    wh(sprintf("%s%s,\\\n", txt[0..2],txt[23..]));
  }
  wh("})\n\n\n");
  wh("#define VHIGH_SUFFIX_ARMOUR ({\\\n");
  for(i=0;i<=sizeof(pre_suf[ARMOUR_SUFFIX][VHIGH_MAGIC])-1;i++) {
    txt=sprintf("%#:80O", pre_suf[ARMOUR_SUFFIX][VHIGH_MAGIC][i]);
    wh(sprintf("%s%s,\\\n", txt[0..2],txt[23..]));
  }
  wh("})\n\n\n");
  wh("#define GODLY_SUFFIX_ARMOUR ({\\\n");
  for(i=0;i<=sizeof(pre_suf[ARMOUR_SUFFIX][GODLY_MAGIC])-1;i++) {
    txt=sprintf("%#:80O", pre_suf[ARMOUR_SUFFIX][GODLY_MAGIC][i]);
    wh(sprintf("%s%s,\\\n", txt[0..2],txt[23..]));
  }
  wh("})\n\n\n");
  return 1;    
}

void remove()
{
  save_all();
  destruct(this_object());
}

//
// Moven der Charged Items
//
nosave varargs int move_charged_item(object charge, object ob, int count_flag) {
  if(!objectp(ob)) return 0;
  if(!objectp(charge)) return 0;
  if(objectp(ENV(ob)))
    charge->move(ENV(ob), M_NOCHECK);
  else if (count_flag < 5 )
    call_out("move_charged_item", 10, charge, ob, count_flag+1);
  return 1;
}
