inherit "std/thing";

#include <properties.h>
#include <new_skills.h>

int ende, defend_value;
object wer;

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, 0);
  AddId("\nblutrausch");

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
}

void init()
{
  ::init();
  if( !living(environment())  || present("\nblutrausch 2", environment()) 
      || present("\nberserker_blutrausch", environment()) )
  {
    call_out("remove",0);
    return;
  }
  add_action( "nixda", "", 1);
}

int nixda()
{
  if( this_player()->InFight() )
    write("Du befindest Dich gerade im Blutrausch und kannst nur kaempfen!\n");
  else
  {
    if( ende == 0 )
    {
      remove_call_out("normal");
      call_out("normal",0);
      ende=1;
    }
    write("Du beruhigst Dich langsam wieder.\n");
  }
  return 1;
}

void blutrausch(int suc, int dauer)
{
  mapping h;

  ende=0;
  defend_value=suc;
  if (!(wer=environment())) 
    return;
  wer->SetProp(P_WIMPY,0);
  wer->ModifySkillAttribute(wer, SA_SPEED, suc, dauer);
  wer->ModifySkillAttribute(wer, SA_DAMAGE, suc/2, dauer);
  if( !pointerp(h=wer->QueryProp(P_TMP_DEFEND_HOOK)) || h[0]<time() )
    wer->SetProp(P_TMP_DEFEND_HOOK, ({ time()+dauer, this_object(), "defend"}));
  call_out("normal", dauer);
}

void normal()
{
  mapping h;
  if( wer )
  {
    wer->SetProp(P_SKILL_ATTRIBUTES, 0);
    if( (h=wer->QueryProp(P_TMP_DEFEND_HOOK)) && h[1] == this_object())
      wer->SetProp(P_TMP_DEFEND_HOOK,0);
    write("Der Blutrausch ist beendet.\n");
  }
  wer = 0;
  remove(); 
}

mixed defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  dam-=(defend_value)*dam/1000;
    return ({ dam, dam_type, spell, enemy });
}

varargs int remove(int silent)
{
  if(wer)
  {
    normal();
    remove_call_out("remove");
  }
  ::remove(silent);
}
