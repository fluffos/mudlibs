// dis_obj.c
//
// Wird dem Spieler geclont, wenn ein magischer Gegenstand verschwindet.

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

string *lost_items=({});

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0); 
  SetProp(P_LONG, "");
  SetProp(P_NAME, "");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ITEMD_DIS_OBJ_ID}) );
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 1); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

int AddLostItem(string str) {
  if(member(lost_items, str)!=-1) return 0;
  lost_items+=({str});
  return 1;
}

mixed QueryLostItems() {
  return lost_items;
}

void BecomesNetAlive(object wer) {
  int i;
  tell_object(wer, "\nDu hast folgende magische Gegenstaende verloren:\n");
  for(i=sizeof(lost_items)-1;i>=0;i--) {
    tell_object(wer, sprintf("\t- %s\n\n", lost_items[i]));
  } 
  call_out("remove", 0);
  return;
}
