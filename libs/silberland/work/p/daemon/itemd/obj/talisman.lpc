inherit "std/thing";

#include <properties.h>
#include <defines.h>
#include <moredef.h>

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Talisman");
  SetProp(P_LONG,
    "Ein Talisman der Dir sicher Glueck bringen wird." );
  SetProp(P_NAME, "Talisman");
  SetProp(P_GENDER, MALE);
  AddId("talisman");

  SetProp(P_MATERIAL, 
      ({MAT_IVORY,MAT_PEARL,MAT_SILVER,MAT_GOLD,MAT_EBONY})[random(5)] );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
}

object wer;

void reset() {
  ::reset();
  if (!is_clone(this_object())) return;
  if(!environment())
    remove();
}


void init()
{
  ::init();
  if (wer)
  {
    wer->UpdateAttributes();
    wer=0;
  }
  if( (wer=environment()) && query_once_interactive(wer) )
  {
    wer->UpdateAttributes();
  }
} 

int IsTalisman()
{
  return 1;
}

varargs int move(mixed dest, int method, string dir, string textout, 
    string textin) 
{
  object env;
  int x;
  env=ENV(ME);
  x=::move(dest,method,dir,textout,textin);
  if(objectp(env) && interactive(env)) {
    env->UpdateAttributes();
  }
  return x;
}

