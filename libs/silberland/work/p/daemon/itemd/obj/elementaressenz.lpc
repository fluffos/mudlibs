inherit "std/unit";

#pragma strong_types

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include "../itemd.h"

void _set_autoloadobj( mixed args )
{
  if (pointerp(args))
    args=args[0];
  if (stringp(args))
    sscanf(args,"%d",args);
  if (!intp(args))
    args=0;
  SetProp(P_AMOUNT,args);
}

int _query_autoloadobj()
{
  return (int) Query(P_AMOUNT);
}

void create()
{
  mixed plist, i;

  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_NAME,({"Elementaressenz","Elementaressenzen"}));
  SetProp(P_SHORT,"Elementaressenz");
  SetProp(P_LONG, BS("Die Elementaressenz scheint aus allen Elementen zu bestehen. Wer "
      "weiss, was man damit machen kann."));
  SetProp(P_MATERIAL, ({ MAT_FIRE, MAT_WATER, MAT_AIR, MAT_GHOST, MAT_EARTH, MAT_ICE }) );
  AddSingularId("elementaressenz");
  AddPluralId("elementaressenzen");
  AddSingularId("essenz");
  AddPluralId("essenzen");
  AddId( ({ ITEMD_EE_MONEY_ID }) );
  SetProp(P_GENDER,FEMALE);
  SetCoinsPerUnits(1,1);
  SetGramsPerUnits(1,4);
}
