// charged items,
// Angrox, 12.10.1999

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include "../itemd.h"
#include "../charge.h"
inherit CHARGE_DIR+"std_charge_item";


create() {
  ::create();
  SetProp(P_LONG, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({ITEMD_CHARGE_OBJ_ID}));
}
             
int Setup(object ob, int charges, int dam, int cost) {
  string what;
  if(!objectp(ob) || !charges || !dam) {
    remove();
  }
  switch(dam) {
   case 0..200    : what="kleiner";
   case 201..400  : what="";
   case 401..600  : what="grosser";
   default   : what="extrem grosser";
  }
  SetProp(CH_COST, cost);
  SetProp(CH_CHARGED_OBJECT, ob);
  SetProp(CH_DAMAGE, dam);
  SetProp(CH_CHARGES, charges);
  SetProp(CH_AREA_SPELL, 1);
  SetProp(CH_CMD, "todesvortex");
  SetProp(CH_DAMAGE_TYPE, ({DT_ELECTRIC}));
  SetProp(CH_FAIL_MSGS, ({
      "Ein "+what+" Todesvortex entsteht aus Dein%s %s, sucht nach Gegnern "
      "und verpufft im Nichts.",
      "Ein "+what+" Todesvortex entsteht aus %s %s und verpufft ploetzlich im "
      "Nichts."}));
  SetProp(CH_SUCCESS_MSGS, ({
      "Ein "+what+" Todesvortex entsteht aus Dein%s %s und huellt %s komplett "
      "ein!",
      "Ein "+what+" Todesvortex aus %s von %s huellt %s komplett ein!",
      "Ein "+what+" Todesvortex  aus der %s von %s umhuellt Dich. Du schreist "
      "voller Schmerz auf!"}));
  SetProp(CH_INFO_TXT, ({
      "Diese Waffe kann einen Todesvortex entstehen lassen, der Deine "
      "Feinde vernichtet! Es sind noch %d Ladungen vorhanden. "
      "Das Kommando dazu lautet 'todesvortex', allerdings musst Du die "
      "Waffe dazu erst zuecken.",
      "Diese Ruestung kann einen Todesvortex entstehen lassen, der Deine "
      "Feinde vernichtet. Es sind noch %d Ladungen vorhanden. Das Kommando "
      "dazu lautet 'todesvortex', allerdings musst Du die Ruestung zuerst "
      "anziehen."}));
  initialize();
}
