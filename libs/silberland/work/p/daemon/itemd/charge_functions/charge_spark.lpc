#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include "../itemd.h"
#include "../charge.h"
inherit CHARGE_DIR+"std_charge_item";


create() {
  ::create();
  SetProp(P_LONG, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  AddId(({ITEMD_CHARGE_OBJ_ID}));
}
             
int Setup(object ob, int charges, int dam, int cost) {
  string what;
  string cmd_name;
  if(!objectp(ob) || !charges || !dam) {
    remove();
  }
  cmd_name="Funken";
  switch(dam) {
   case 0..200    : what="winziger";
   case 201..400  : what="kleiner";
   case 401..600  : what="grosser";
   default   : what="extrem grosser";
  }
  SetProp(CH_COST, cost);
  SetProp(CH_CHARGED_OBJECT, ob);
  SetProp(CH_DAMAGE, dam);
  SetProp(CH_CHARGES, charges);
  SetProp(CH_CMD, "funken");
  SetProp(CH_DAMAGE_TYPE, ({DT_ELECTRIC}));
  SetProp(CH_FAIL_MSGS, ({
      "Ein "+what+" "+cmd_name+" zuckt aus Dein%s %s und schlaegt im Boden "
      "ein.",
      "Ein "+what+" "+cmd_name+" zuckt aus %s %s und schlaegt im Boden "
      "ein."}));
  SetProp(CH_SUCCESS_MSGS, ({
      "Ein "+what+" "+cmd_name+" aus Dein%s %s trifft %s!",
      "Ein "+what+" "+cmd_name+" aus %s von %s trifft %s!",
      "Ein "+what+" "+cmd_name+" aus der %s von %s trifft Dich."}));
  SetProp(CH_INFO_TXT, ({
      "Diese Waffe kann einen "+cmd_name+" schleudern. Es "
      "sind noch %d Ladungen vorhanden. Das Kommando dazu lautet "
      "'"+QueryProp(CH_CMD)+"', allerdings musst Du die Waffe "
      "dazu erst zuecken.",
      "Diese Ruestung kann einen "+cmd_name+" schleudern. Es "
      "sind noch %d Ladungen vorhanden. Das Kommando dazu lautet "
      "'"+QueryProp(CH_CMD)+"', allerdings musst Du die Ruestung zuerst "
      "anziehen."}));
  initialize();
}
