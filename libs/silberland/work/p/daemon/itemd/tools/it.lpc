nosave int SetColors(string terminal) {
  // Farbgebung von Zordan@SL
  color = ({ 0,0,0,0,0 });
  if(terminal=="ansi") {
    color[0] = ANSI_NORMAL;
    color[1] = ANSI_BOLD;
    color[2] = ANSI_UNDERL;
    color[3] = ANSI_BLUE;
    color[4] = ANSI_RED;
  } else if (terminal=="vt100") {
    color[0]=ANSI_NORMAL;
    color[1]=ANSI_BOLD;
    color[2]=ANSI_BOLD;
    color[3]=ANSI_NORMAL;
    color[4]=ANSI_NORMAL;
  } else {
    color[0]=color[1]=color[2]=color[3]=color[4]=ANSI_NORMAL;
  }

}

nosave string array2string(mixed array) {
  int i, len, pos;
  string text; 
  mixed hlp;
  text="";
  if(mappingp(array)) return "Too complex arguments";
  if(!pointerp(array)) 
    return implode(explode(sprintf("%O", array), "\n"), " ");
  for(i=sizeof(array)-1;i>=0;i--) {
    if(pointerp(array[i]))
      hlp=array2string(array[i]);
    else 
      hlp=array[i];
    if(stringp(hlp))
      hlp=implode(explode(hlp, "\n"), " ");
    text+=sprintf("%O, ",hlp);
  }
  //text+="\b\b";
  return text;
}

