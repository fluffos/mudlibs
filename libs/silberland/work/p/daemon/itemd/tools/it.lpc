varargs int ShowRunes(mixed show_rune)
{
  string rune_word, env_str, f_name;
  mapping map, rune_might;
  string *rune_array;
  object ob,env;
  int might,i,j,max_age,cur_time, time2die;
  mixed *r, help;

  if(!sec_check(TI,0))
    return 0;
  if(to_int(show_rune))
    show_rune=to_int(show_rune);
  rune_might=REVERSE_RUNE_MIGHT;
  restore_object(ITEMD_SAVEFILE);
  rune_array=decode_rune_array(runes, rune_might, 1);
  rune_array+=decode_rune_array(bags, rune_might, 0);
  printf(
    "+===========================================+\n"
    "|                   RUNEN                   |\n"
    "+======+======+=======+==========+=============+==============+\n"
    "|  Nr. | Rune | Might | Time2Die | Environment | File         |\n"
    "+======+======+=======+==========+=============+==============+\n");
  r = sort_array(rune_array, "rune_sort");
  for(j=0;j<=sizeof(r)-1;j++){
    help=explode(r[j],"__");
    printf("| %4d | %4s | %5d | %8s | %11s | %12s |\n",
          j, help[0], to_int(help[1]), time2string("%dd,%hh",
              to_int(help[2]))[<8..], help[3][<11..], help[4][<12..]);
  }  
  printf("+======+======+=======+==========+=============+========"
      "======+\n");
  return 1;
}

int rune_sort(string a, string b) {
  if(to_int(explode(a,"__")[2]) > to_int(explode(b,"__")[2]))
    return 1;
  return 0;
}

//
// Decode_rune_aray
//
// flag = 1 ... array mit filenames
// flag = 0 ... array mit runen in beuteln
//
// "rune_name"__"rune_might"__"create_time"__"env_str"
mixed decode_rune_array(mixed rune_array, mapping rune_might, int flag) {
  int i,j,might,time2die,max_age;
  string *normalized_array, env_str, rune_word, *bag_indices;
  string obj_str;
  object ob,env;
  mixed help;
  normalized_array=({});
  if(!sizeof(rune_array)) 
    return ({});
  if(flag) {
    for (i=sizeof(rune_array)-1;i>=0;i--) {
      if(ob=find_object(rune_array[i]))
      {
        if(objectp(env=ENV(ob))) {
          if(objectp(ENV(env)) && (living(ENV(env)) ||
                query_once_interactive(ENV(env))))
          {
            env=ENV(env);
          }
          if(query_once_interactive(env)) 
            env_str=getuid(env);
          else 
            env_str=file_name(env);
        }
        else env_str="???";
        rune_word=ob->QueryRune();
        if(member(rune_might, rune_word)) {
          might=rune_might[rune_word];
        }
        max_age=call_other(ITEMD, "QueryRuneMaxAge", ob);
        time2die=max_age-(time()-ob->QueryCreateTime());
        if(time2die < 0) time2die=0;
        obj_str=explode(file_name(ob), "/")[<1];
        normalized_array+=({implode(({rune_word,to_string(might),
                to_string(time2die), env_str,obj_str}),"__")});
      }
    }
  } // flag = 1 loop end
  else { // Ah, wir haben einen bag
    bag_indices=m_indices(rune_array);
    for(i=sizeof(bag_indices)-1;i>=0;i--) {
      if(ob=find_object(bag_indices[i])) {
        env_str=explode(bag_indices[i],"/")[<1];
        obj_str=env_str;
        if(ENV(ob) && query_once_interactive(ENV(ob))) 
          env_str=getuid(ENV(ob));
        else if(ENV(ENV(ob)) && query_once_interactive(ENV(ENV(ob)))) 
            env_str=getuid(ENV(ENV(ob)));
        else if(ENV(ENV(ob)))
          env_str=explode(file_name(ENV(ENV(ob))),"/")[<1];
        else if(ENV(ob)) 
          env_str=explode(file_name(ENV(ob)),"/")[<1];
      }
      for(j=sizeof(rune_array[bag_indices[i]])-1;j>=0;j--) {
        help=explode(rune_array[bag_indices[i]][j], "__");
        rune_word=help[0];
        max_age=call_other(ITEMD, "QueryRuneMaxAge", rune_word);
        time2die=max_age-(time()-to_int(help[1]));
        if(member(rune_might, rune_word)) {
          might=rune_might[rune_word];
        }
        normalized_array+=({implode(({rune_word,to_string(might),
                to_string(time2die), env_str,obj_str}),"__")});
      }
    }
  }
  return normalized_array;
}

varargs int ShowRuneWords(mixed show_rune)
{
  mapping runewords;
  string *words;
  string *parts;
  mixed *r;
  mapping runecount;
  string rune_word;
  object ob;
  int i;
  int max;
  string max_string;
  object pl;

  if(!sec_check(TI,0))
    return 0;
  restore_object(ITEMD_SAVEFILE);

  runewords = RUNE_WORDS + RUNE_WORDS2;
  words = sort_array(m_indices(runewords), #'>);
  r = filter_array(runes, #'find_object);
  runecount = ([]);
  if (show_rune)
    pl = find_player(show_rune) || find_netdead(show_rune);
  for(i=0;i<=sizeof(r)-1;i++)
  {
    if(ob=find_object(r[i]))
    {
      if (objectp(pl))
      {
        if (environment(ob) && 
            (environment(ob) == pl || 
             (environment(environment(ob)) && 
              environment(environment(ob)) == pl)))
          ;
        else
          continue;
      }
      rune_word=ob->QueryRune();
      if (!member(runecount, rune_word))
        runecount += ([rune_word: 1]);
      else
        runecount[rune_word]++;
    }
  }
  write( "+===========================================+\n");
  if (objectp(pl))
    printf("|          RUNENWOERTER VON %-14s  |\n",capitalize(getuid(pl)));
  else  
    write("|                   RUNENWOERTER            |\n");
  write("+======+======+=======+==========+=============+==============+\n");
  for (i = 0; i < sizeof(words); i++)
  {
    parts = explode(words[i], "_");
    max = runecount[parts[0]];
    if (runecount[parts[1]] < max)
      max = runecount[parts[1]];
    if (runecount[parts[2]] < max)
      max = runecount[parts[2]];
    if (sizeof(parts) == 3)
    {
      if (max > 0)
        max_string = sprintf("%d mal ", max);
      else
        max_string = "keines";
      printf("%-17s: %s   %d %s %d %s %d % s\n",
          words[i], max_string,
          runecount[parts[0]], parts[0], 
          runecount[parts[1]], parts[1], 
          runecount[parts[2]], parts[2]);
    }
    else
    {
      if (runecount[parts[3]] < max)
        max = runecount[parts[3]];
      if (max > 0)
        max_string = sprintf("%d mal ", max);
      else
        max_string = "keines";
      printf("%-17s: %s   %d %s %d %s %d % s %d %s\n",
          words[i], max_string,
          runecount[parts[0]], parts[0], 
          runecount[parts[1]], parts[1], 
          runecount[parts[2]], parts[2],
          runecount[parts[3]], parts[3] ) ;
    }
  }
  printf("+======+======+=======+==========+=============+========"
      "======+\n");
  return 1;
}
