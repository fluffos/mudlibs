nosave int typesort(string a, string b)
{
  return ident_types[a]>ident_types[b];
}

nosave varargs int WriteStatistic(string str, int flag)
{
  int i,c,a,w,t,mc,ma,mw,mt;
  string *sortet, txt;
  float h;
  restore_object(ITEMD_SAVEFILE);
  h=1.0*(time()-last_statreset_time)/3600;
  if(!h || h==0.0) h=1.0;
  sortet=sort_array(m_indices(ident_types),"typesort", this_object());
  a=w=0;
  txt="+==============================ITEMD=STATISTICS==============================+\n"
      "| von "+ctime(last_statreset_time)+" bis "+ctime(time())+": "
      +sprintf("%7.2f",h)+" Stunden |\n"
      "|     Anzahl der untersuchten Items      |           Magische Items          |\n"
      "+=============+========+=========+=======+========+=========+=======+========+\n"
      "| Typ         | Anzahl | Prozent | pro h | Anzahl | Prozent | pro h | Chance |\n" 
      "+=============+========+=========+=======+========+=========+=======+========+\n";
  for(i=sizeof(sortet)-1;i>=0;i--)
  {
    if(member(m_indices(ALL_ARMOUR_TYPES),sortet[i])!=-1)
    {
      a+=ident_types[sortet[i]]-1;
      ma+=ident_magic[sortet[i]]-1;
    }
    else
    {
      w+=ident_types[sortet[i]]-1;
      mw+=ident_magic[sortet[i]]-1;
    }
  } 
  t=a+w;
  mt=ma+mw;
  for(i=sizeof(sortet)-1;i>=0;i--)
  {
    c=ident_types[sortet[i]]-1;
    mc=ident_magic[sortet[i]]-1;
    if(c) txt+=sprintf("| %-11s | %6d | %6.2f%% | %5.1f | %6d | %6.2f%% | %5.3f | %5.2f%% |\n",
        CAP(sortet[i]),c,100.0*c/(t?t:1),c/h,mc,100.0*mc/(mt?mt:1),mc/h,100.0*mc/c);
  }
  txt+= "+=============+========+=========+=======+========+=========+=======+========+\n";
  txt+=sprintf( "| Armours     | %6d | %6.2f%% | %5.1f | %6d | %6.2f%% | %5.3f | %5.2f%% |\n",
      a,100.0*a/(t?t:1),a/h,ma,100.0*ma/(mt?mt:1),ma/h,100.0*ma/(a?a:1));
  txt+=sprintf( "| Weapons     | %6d | %6.2f%% | %5.1f | %6d | %6.2f%% | %5.3f | %5.2f%% |\n",
      w,100.0*w/(t?t:1),w/h,mw,100.0*mw/(mt?mt:1),mw/h,100.0*mw/(w?w:1));
  txt+="+-------------+--------+---------+-------+--------+---------+-------+--------+\n";
  txt+=sprintf( "| Total       | %6d |         | %5.1f | %6d |         | %5.3f | %5.2f%% |\n",
      t,t/h,mt,mt/h,100.0*mt/(t?t:1));
  txt+="+=============+========+=========+=======+========+=========+=======+========+\n";

  if(!flag)
    write(txt);
  else
    write_file(ITEMD_LOG+"statistik.log", txt+"\n\n");
  return 1;
}

nosave int ResetStatistic(string str)
{
  if(!sec_check(TP,1)) {
    write(BS("Das kann nur ein Erzmagier."));
    return 1;
  }
  write("Alle Statistiken werden resettet!\n");
  write("Moechtest Du das wirklich? [nein/ja_wirklich]: ");
  input_to("statistic_2");
  return 1;
}

nosave int statistic_2(string str) 
{
   if(lower_case(str)!="ja_wirklich") 
   {
     write("Abbruch! Die Statistik wurde NICHT geloescht!\n");
     return 1;
   }
    write_file(ITEMD_LOG+"statistik.log", 
        ctime(time())+": statistic resettet by "+CAP(getuid(TP))+"\n\n");
   WriteStatistic("", 1);
   if(!find_object(ITEMD)->statistic_reset())
     return write("Fehler im ItemdDaemon!!!\n"),1;
   write("Statistic is resetet!\n");
   WriteStatistic("");
   return 1;
}

int LogStatistics(string str)
{
  if(!sec_check(TP,1)) {
    write(BS("Das kann nur ein Erzmagier."));
    return 1;
  }
   WriteStatistic("", 1);
   write("Statistik wurde ins Logfile geschrieben!\n");
   return 1;
} 


