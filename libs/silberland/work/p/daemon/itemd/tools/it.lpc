nosave int GTHelp();

void create() {
  
  if( !is_clone(TO) ) return;
  ::create();
  SetColors(TP->QueryProp(P_TTY));
  TA(sprintf("%s***%s Itemd-Tool von %s geclont!\n", ANSI_RED, 
      ANSI_NORMAL, CAP(getuid(TP))));
  TF(sprintf("%s***%s Itemd-Tool von %s geclont!\n", ANSI_RED, 
      ANSI_NORMAL, CAP(getuid(TP))));
  if(!sec_check(TP,0)) { call_out("remove", 0); return;}
  SetProp(P_LONG, sprintf(
    "%s\nDas ITEMD-Tool v%s (%s)\nDieses Tool dient zum Warten "
    "des ITEMD.\n"
    "Hilfe mit <ihilfe>.\n%s%s\n%s", LINE1, VERSION, LAST_CHANGE, color[4],
    color[0],LINE1));
  SetProp(P_NAME, TP->Name(WESSEN)+" ITEMD-Tool v"+VERSION);
  SetProp(P_SHORT, TP->Name(WESSEN)+" ITEMD-Tool v"+VERSION);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"it", "itemd", "itemdtool", "tool", "kontrolltool"}) );
  SetProp(P_MATERIAL, ([MAT_MISC:100]));
  SetProp(P_WEIGHT, 1); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, "Das ITEMD-Tool wuerdest Du niemals hergeben!\n");
  SetProp(P_NEVERDROP, "Das ITEMD-Tool wuerdest Du niemals hergeben!\n");
  SetProp(P_AUTOLOADOBJ, 1);
  seteuid(getuid(this_object()));
  restore_object(ITEMD_SAVEFILE);
  init_itemd_data();
}

void init() {
  ::init();
  if( !sec_check(MENV,0) ) remove();
  add_action("IHelp", "ihilfe");
  add_action("GenerateReport", "irep");
  add_action("ShowItems", "isi");
  add_action("ShowItemsPath", "iisi");
  add_action("enable_items", "iena");
  add_action("disable_items", "idis");
  add_action("SetMagicItem", "iset");
  add_action("remove_mi", "irem");
  add_action("remove_all", "irem_all");
  add_action("ItemDetail", "idet");
  add_action("ShowChances", "iprb");
  add_action("UniqueReport", "iur");
  add_action("SetReport", "isr");
  add_action("Talismans", "itali");
  add_action("WriteStatistic", "istat");
  add_action("ResetStatistic", "istatreset");
  add_action("LogStatistics", "istatlog");
  add_action("ShowTmpMagic", "itmpmagic");
  add_action("ShowNoEnv", "inoenv");
  add_action("ShowRunes", "irunes");
  add_action("ShowRuneWords", "irunewords");
  
  SetColors(TP->QueryProp(P_TTY));  
}


nosave int sec_check(object ob,int flag)
{
  string *uids;
  string *admin_uids;

  uids = SEC_ALLOWED_UIDS;
  admin_uids = SEC_ADMIN_UIDS;

  /*
  TA(sprintf("it tool, sec check: IS_ARCH: %d, flag: %d, IS_LORD: %d, "
     "member: %d\n", IS_ARCH(ob), flag, IS_LORD(ob), member(uids,getuid(ob))));
   */

  if(IS_ARCH(ob) || member(admin_uids,getuid(ob))!=-1)
    return 1;
  if(!flag && (IS_LORD(ob) || member(uids,getuid(ob))!=-1))
    return 1;
  return 0;
}

