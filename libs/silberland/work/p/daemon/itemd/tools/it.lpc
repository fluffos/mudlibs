nosave int init_itemd_data() {
  //if(!IS_ARCH(TP)) return 0;
  pre_suf=0;
  pre_suf=([WEAPON_PREFIX: ([LOW_MAGIC: 0, MED_MAGIC:0, HIGH_MAGIC:0, VHIGH_MAGIC: 0, GODLY_MAGIC:0]), WEAPON_SUFFIX: ([LOW_MAGIC: 0, MED_MAGIC:0, HIGH_MAGIC:0, VHIGH_MAGIC: 0, GODLY_MAGIC:0]), ARMOUR_PREFIX: ([LOW_MAGIC: 0, MED_MAGIC:0, HIGH_MAGIC:0, VHIGH_MAGIC: 0, GODLY_MAGIC:0]), ARMOUR_SUFFIX: ([LOW_MAGIC: 0, MED_MAGIC:0, HIGH_MAGIC:0, VHIGH_MAGIC: 0, GODLY_MAGIC:0])]);
  pre_suf[WEAPON_PREFIX][LOW_MAGIC]=LOW_PREFIX_WEAPON+
    LOW_PREFIX_WEAPON1;
  pre_suf[WEAPON_PREFIX][MED_MAGIC]=MED_PREFIX_WEAPON+
    MED_PREFIX_WEAPON1;
  pre_suf[WEAPON_PREFIX][HIGH_MAGIC]=HIGH_PREFIX_WEAPON+
    HIGH_PREFIX_WEAPON1;
  pre_suf[WEAPON_PREFIX][VHIGH_MAGIC]=VHIGH_PREFIX_WEAPON+
    VHIGH_PREFIX_WEAPON1;
  pre_suf[WEAPON_PREFIX][GODLY_MAGIC]=GODLY_PREFIX_WEAPON+
    GODLY_PREFIX_WEAPON1;
  pre_suf[WEAPON_SUFFIX][LOW_MAGIC]=LOW_SUFFIX_WEAPON+
    LOW_SUFFIX_WEAPON1;
  pre_suf[WEAPON_SUFFIX][MED_MAGIC]=MED_SUFFIX_WEAPON+
    MED_SUFFIX_WEAPON1;
  pre_suf[WEAPON_SUFFIX][HIGH_MAGIC]=HIGH_SUFFIX_WEAPON+
    HIGH_SUFFIX_WEAPON1;
  pre_suf[WEAPON_SUFFIX][VHIGH_MAGIC]=VHIGH_SUFFIX_WEAPON+
    VHIGH_SUFFIX_WEAPON1;
  pre_suf[WEAPON_SUFFIX][GODLY_MAGIC]=GODLY_SUFFIX_WEAPON+
    GODLY_SUFFIX_WEAPON1;
  
  pre_suf[ARMOUR_PREFIX][LOW_MAGIC]=LOW_PREFIX_ARMOUR+
    LOW_PREFIX_ARMOUR1;
  pre_suf[ARMOUR_PREFIX][MED_MAGIC]=MED_PREFIX_ARMOUR+
    MED_PREFIX_ARMOUR1;
  pre_suf[ARMOUR_PREFIX][HIGH_MAGIC]=HIGH_PREFIX_ARMOUR+
    HIGH_PREFIX_ARMOUR1;
  pre_suf[ARMOUR_PREFIX][VHIGH_MAGIC]=VHIGH_PREFIX_ARMOUR+
    VHIGH_PREFIX_ARMOUR1;
  pre_suf[ARMOUR_PREFIX][GODLY_MAGIC]=GODLY_PREFIX_ARMOUR+
    GODLY_PREFIX_ARMOUR1;
  pre_suf[ARMOUR_SUFFIX][LOW_MAGIC]=LOW_SUFFIX_ARMOUR+
    LOW_SUFFIX_ARMOUR1;
  pre_suf[ARMOUR_SUFFIX][MED_MAGIC]=MED_SUFFIX_ARMOUR+
