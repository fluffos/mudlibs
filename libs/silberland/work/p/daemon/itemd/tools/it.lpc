nosave int IHelp() {
  string txt, hlpline;
  txt="| %-30s | %-41s |\n";
  hlpline=sprintf("+%*'='s+%*'='s+\n",32,"",43,"");
  write(sprintf("\n%s\n| %s%|74s%s |\n%s\n",LINE2,color[1],
      "-=- Funktionen des ITEMD-Tools -=-",color[0],LINE2));
  write(sprintf(txt, "Name", "Funktion"));
  write(hlpline);
  write(sprintf(txt, "ihilfe", "Hilfeseite aufrufen"));
  write(sprintf(txt, "isi    <1..10> <name>", "Liste der MIs (mit P_SHORT)"));
  write(sprintf(txt, "isi    8 <sockelzahl>", "Liste der MIs mit dieser Sockelzahl)"));
  write(sprintf(txt, "iisi   <1..19> <name>" , "Liste der MIs (mit Pfadangaben)"));
  write(sprintf(txt, "irep", "Anzahl der moeglichen Pre- und Suffixes"));
  write(sprintf(txt, "iena   <grund>", "MI's aktivieren"));
  write(sprintf(txt, "idis   <grund>", "MI's deaktivieren"));
  write(sprintf(txt, "iset   <obj> <pre> <suf>", "Generierung eines MI's mit "
       "gew. pre/suff"));
  write(sprintf(txt, "irem   <magieart> <nummer>", "Loescht das angegebene MI"));
  write(sprintf(txt, "irem_all", "Loescht alle MI's im Spiel"));
  write(sprintf(txt, "idet   <magieart> <nummer>", "Zeigt spielrelevante Daten "
        "von MI an"));
  write(sprintf(txt, "iprb", "Wahrscheinlichkeiten"));
  write(sprintf(txt, "iur", "Unique Report"));
  write(sprintf(txt, "isr", "Set Report"));
  write(sprintf(txt, "itali", "Talisman Report"));
  write(sprintf(txt, "istat", "Statistik der Identifizierten Objekte"));
  write(sprintf(txt, "istatreset", "Statistik wieder auf Null setzen"));
  write(sprintf(txt, "istatlog", "Statistik inst Logfile schreiben"));
  write(sprintf(txt, "itmpmagic", "Zeigt alle temporaeren magischen Items an"));
  write(sprintf(txt, "inoenv", "Zeigt Magic Items ohne living environment"));
  write(sprintf(txt, "irunes <might|rune|spieler>", "Runen auflisten"));
  write(sprintf(txt, "irunewords <spieler>", "Moegliche Runenwoerter auflisten"));
  write(hlpline+"\n");
      
  return 1;
}


nosave int ShowItemsPath(mixed flag) {
  if(!flag) flag=0;
  ShowItems(flag, 1);
  return 1;
}

nosave varargs int ShowItems(mixed flag, mixed fl) {
  int i, help_int, soc;
  object ob;
  string msg, env_str, ob_str, txt, hlp_txt, typ;
  object env;
  mixed *objects, item_ids;
  restore_object(ITEMD_SAVEFILE);
  txt="";
  if( flag)
    sscanf(flag,"%d %s",flag, typ);
  if( !typ) typ="";
  if (to_int(typ))
  {
    soc = to_int(typ);
    typ = "";
  }
  fl=to_int(fl); 
  if(!fl) fl=0;
  switch(flag) {
    case (LOW_ID+1): objects=low_magic[0..]; msg="LOW MAGIC"; break;
    case (MED_ID+1): objects=med_magic[0..]; msg="MEDIUM MAGIC"; break;
    case (HIG_ID+1): objects=high_magic[0..]; msg="HIGH MAGIC"; break;
    case (VHG_ID+1): objects=vhigh_magic[0..]; msg="VERY HIGH MAGIC"; break;
    case (GDL_ID+1): objects=godly_magic[0..]; msg="GODLY MAGIC"; break;
    case (RAR_ID+1): objects=rare[0..]; msg="RARE ITEMS"; break;
    case (RST_ID+1): objects=restricted[0..];msg="RESTRICTED"; break;
    case (SOC_ID+1): objects=socketed[0..];msg="SOCKETED"; break;
    case (UNQ_ID+1): objects=unique[0..];msg="UNIQUES"; break;
    case (SET_ID+1): objects=set[0..];msg="SET"; break;
    case (TIME_ID): objects=timed[0..];msg="TIMED"; break;
    default: return write("Falsches Argument. [1..10]\n"),1;        
  }
  call_other(ITEMD, "check_magic", flag);
  txt+="+===========================================+\n";
  txt+=sprintf("| %|41s |\n", msg);
  txt+="+=====+=====================================+==============+="
      "=============+\n";
  if(msg=="SOCKETED")
    txt+="| Nr. | Objekt:               [SOC/USO/ALO]  0/1/2/3/4/5/6 | "
        "Env:         |\n";
  else
    txt+="| Nr. | Objekt:                                            | "
        "Env:         |\n";
  txt+="+=====+====================================================+="
      "=============+\n";
  
  if(sizeof(objects)) {
    for(i=0;i<=sizeof(objects)-1;i++) {
      if((ob=find_object(objects[i])) )
      {
      if (strstr(fl?file_name(ob):lower_case(ob->QueryProp(P_SHORT)),typ)!=-1 ) {
      if (!soc || (msg=="SOCKETED" && ob->HasSockets() == soc)) {
        if(objectp(env=ENV(ob))) {
          if(objectp(ENV(env)) && (living(ENV(env)) ||
              query_once_interactive(ENV(env))))
          {
            env=ENV(env);
          }
          if(query_once_interactive(env)) 
            env_str=getuid(env);
          else 
            env_str=file_name(env);
        }
        else env_str="???";

        if(!fl) {
          if(msg=="SOCKETED")
            ob_str=explode(ob->QueryProp(P_SHORT), "(")[0];
          else 
            ob_str=ob->QueryProp(P_SHORT);
        }
        else {
          if(msg=="SOCKETED")
            ob_str=explode(file_name(ob), "/")[<1];
          else
            ob_str=file_name(ob);
        }
        if(msg=="SOCKETED") {
                       // nr    item     S   US AL      
          item_ids=ob->SocketedItems();
          if(pointerp(item_ids))
            hlp_txt=regreplace(sprintf("%1d/%1d/%1d/%1d/%1d/%1d/%1d", item_ids[0],
            item_ids[1],item_ids[2],item_ids[3],item_ids[4],item_ids[5],
            item_ids[6]), "0", "-", 1);
          else
            hlp_txt="?/?/?/?/?/?/?";
          help_int=ob->HasSockets()-ob->HasFreeSockets();
          if(help_int<0) help_int=0;
          txt+=sprintf("| %3d | %-27s [%1d/%1s/%1s] [%s]  %-12s |\n", 
             i, ob_str[<27..], ob->HasSockets(), help_int ? to_string(help_int) : " ", 
             ob->QueryAuto()==-1 ? " " : to_string(ob->QueryAuto()),   
             hlp_txt,env_str[<12..]);

        }
        else 
          txt+=sprintf("| %3d | %-50s | %-12s |\n", 
              i, ob_str[<50..], env_str[<12..]); 
      }}}
      else {
        objects-=({objects[i]});
      }
    }      
  }
  txt+="+=====+====================================================+="
      "=============+\n";
  TP->More(txt);
  return 1;
}

nosave int GenerateReport() {
  string *what, *what_name, *mag, *mag_name, output;
  int i,j,  *chances;
  int *cnt;
  mapping report;
  report=([]);
  what=({WEAPON_PREFIX, WEAPON_SUFFIX, ARMOUR_PREFIX, ARMOUR_SUFFIX});
  what_name=({"Waffen-Prefixes","Waffen-Suffixes","Ruestungs-Prefixes",
      "Ruestungs-Suffixes"});
  mag=({LOW_MAGIC,  MED_MAGIC,  HIGH_MAGIC, VHIGH_MAGIC, GODLY_MAGIC});
  mag_name=({"Niedere Magie    ", "Mittlere Magie   ", "Hohe Magie       ", 
    "Sehr hohe Magie  ", "Goettliche Magie "});

  cnt =({0,0,0,0});
  output="\nPREFIX - SUFFIX REPORT\n------------------------";
  for(i=0;i<=sizeof(what)-1;i++) {
      output+="\n"+what_name[i]+"\n";
       cnt[i]=0;
    for(j=0;j<=sizeof(mag)-1;j++) {
      output+=sprintf("  -%s: %3d\n",mag_name[j],
          sizeof(pre_suf[what[i]][mag[j]])); 
      cnt[i]+=sizeof(pre_suf[what[i]][mag[j]]);
    }
    output+="  -----------------------\n";
    output+=sprintf("               SUMME: %3d\n", cnt[i]);
  }
  output+=sprintf("\n\nSumme aller Prefixes:      %6d\nSumme aller Suffixes: "
      "     %6d\nSumme aller Kombinationen: %6d\n\n", cnt[0]+cnt[2], 
      cnt[1]+cnt[3], cnt[0]*cnt[1]+cnt[2]*cnt[3]);
  TP->More(output);
  return 1;  
}

nosave int disable_items(string why) {
  find_object(ITEMD)->diable(why);
  return 1;
}

nosave int enable_items(string why) {
  if(!sec_check(TP,1)) {
    write(BS("Die MIs enablen kann nur ein Erzmagier"));
    return 1;
  }
  find_object(ITEMD)->enable(why);
  return 1;
}

nosave int SetMagicItem(mixed parameter) {
  object ob;
  string what, _pre, _suf;
  mixed helpvar;
  if(!sec_check(TP,1)) {
    write(BS("Das kann nur ein Erzmagier."));
    return 1;
  }
  parameter=TP->_unparsed_args();
  helpvar=explode(parameter, " ");
  if(sizeof(helpvar)<2) {
    write("Ungenuegend Parameter. Hilfeseite mit 'ihilfe'\n");
    return 1;
  }
  what=helpvar[0];
  _pre=helpvar[1];
  if(sizeof(helpvar)>2) {
    helpvar-=({helpvar[0],helpvar[1]});
    _suf=implode(helpvar, " ");
  }
  else {
    _suf=helpvar[2];
  }
  TA(sprintf("OB: %O, _pre: %O, _suf: %O\n", ob,_pre,_suf));
  ob=find_object(what);
  if(!objectp(ob)) {
    write("Objekt wurde nicht gefunden!\n");
    return 1;
  }
  find_object(ITEMD)->SetMagicItem(ob,_pre,_suf);
  return 1;
}

nosave int remove_mi(mixed parameter) {
  int category, number;
  parameter=TP->_unparsed_args();
  parameter=explode(parameter, " ");
  if(!sec_check(TP,1)) {
    write(BS("Das kann nur ein Erzmagier."));
    return 1;
  }
  if(sizeof(parameter)<2) {
    write("Ungenuegend Argumente. Hilfe mit 'ihilfe'\n");
    return 1;
  }
  category=to_int(parameter[0]);
  number=to_int(parameter[1]);
  find_object(ITEMD)->remove_mi(category-1, number);
  return 1;
}

nosave int remove_all(mixed parameter) {
  if(!sec_check(TP,1)) {
    write(BS("Das kann nur ein Erzmagier."));
    return 1;
  }
  write("\n\n-=* ACHTUNG *=-\n\n");
  write(BS("Mit diesem Befehl zerstoerst Du alle MI's, die sich im Spiel "
        "befinden _UNWIEDERRUFLICH_ !!\n"));
  write("Moechtest Du das wirklich? [nein/ja_wirklich]: ");
  input_to("remove_all_2");
  return 1;
}

nosave int remove_all_2(string str) {
   if(lower_case(str)!="ja_wirklich") {
     write("Abbruch! Die MI's wurden NICHT geloescht!\n");
     return 1;
   }
   find_object(ITEMD)->remove_all();
   return 1;
}

nosave int ItemDetail(mixed parameter) {
  int flag, item,i;
  object ob, ob2;
  string msg, filename, output;
  object env;
  mixed *objects;
  string *strings;
  
  //if(!CheckPermission(TP)) return;

  restore_object(ITEMD_SAVEFILE);
  parameter=TP->_unparsed_args();
  parameter=explode(parameter, " ");
  if(sizeof(parameter)<2) {
    write("Ungenuegend Argumente. Hilfe mit 'ihilfe'\n");
    return 1;
  }
  flag=to_int(parameter[0]);
  item=to_int(parameter[1]);
  
  switch(flag) {
    case (LOW_ID+1): objects=low_magic[0..]; msg="LOW MAGIC"; break;
    case (MED_ID+1): objects=med_magic[0..]; msg="MEDIUM MAGIC"; break;
    case (HIG_ID+1): objects=high_magic[0..]; msg="HIGH MAGIC"; break;
    case (VHG_ID+1): objects=vhigh_magic[0..]; msg="VERY HIGH MAGIC"; break;
    case (GDL_ID+1): objects=godly_magic[0..]; msg="GODLY MAGIC"; break;
    case (RAR_ID+1): objects=rare[0..]; msg="RARE ITEMS"; break;
    case (RST_ID+1): objects=restricted[0..];msg="RESTRICTED"; break;
    case (SOC_ID+1): objects=socketed[0..];msg="SOCKETED"; break;
    case (UNQ_ID+1): objects=unique[0..];msg="UNIQUES"; break;
    case (SET_ID+1): objects=set[0..];msg="SET"; break;
    case (TIME_ID): objects=timed[0..];msg="TIMED"; break;
    default: return write("Falsches Argument. [1..10]\n"),1;        
  }
  if( item >= sizeof(objects) || item <-sizeof(objects) )
  {
    write("Itemnummer zu hoch oder zu niedrig!\n");
    return 1;
  }
  if( item<0)
    item=sizeof(objects)+item;
  if( !objectp(find_object(ob=objects[item])) )
    return write("Dieses Item exisiterit nicht!\n"),1;
  
  write("+=========================================================================+\n");
  write(sprintf("|           %|30s Item Nr. %3d                   |\n", msg, item ));
  write("+=========================================================================+\n");
  printf("| %-71s |\n",ob->QueryProp(P_SHORT));
  printf("| %-71s |\n", ob);
  write("+========================+================================================+\n");
  if( !stringp(output=ob->QueryProp("itemd_who_found_it"))) output="<prop empty>";
  printf("| Gefunden: %-12s | Geclont: %-37s |\n", output[0..11], ob->QueryProp(P_CLONER));
  write("+========================+================================================+\n");
  if( ob->QueryProp("itemd_cain_time"))
    printf("| Identifiziert von Cain am %-45s |\n",dtime(ob->QueryProp("itemd_cain_time"))); 
  else
    printf("| %-71s |\n", "Noch nicht von Cain identifiziert");
  write("+=========================================================================+\n");
  if( strings=ob->QueryProp("itemd") )
  {
    for(i=sizeof(strings)-1;i>=0;i--)
    {
      output=strings[i];
      while(i>=1 && strlen(output+strings[i-1])<=69 )
        output+=", "+strings[--i];
      printf("| %-71s |\n", output);
    }
  }  
  else 
    printf("| %-71s |\n", "Keine ??");
  write("+=========================================================================+\n");
  filename=explode(file_name(find_object((string)ob)),"#")[0];
  if(flag==8) {
    socketed_props(ob);
    filename=ob->QueryProp(P_ITEMD_SOC_OLDITEM);
  }
  if(ob->QueryProp(P_ARMOUR_TYPE) ) {
    armour_liste(ob);
    if( flag<=6 || flag==8 ) {
      write("+============================ ORIGINAL ===================================+\n");
      if(flag==8)
        printf("| %-71s |\n", filename);
      if( ob->QueryProp(P_ITEMD_OLD_VALUES))
      {
        armour_liste(ob->QueryProp(P_ITEMD_OLD_VALUES),1);
      }
      else
      {    
        ob2=clone_object(filename);
        armour_liste(ob2);
        ob2->remove();
      }
    }
  }
  else if (ob->QueryProp(P_WEAPON_TYPE) ) {
    weapon_liste(ob);
    if( flag<=6 || flag==8 ) {
      write("+============================ ORIGINAL ===================================+\n");
      if(flag==8)
        printf("| %-71s |\n", filename);
      if( ob->QueryProp(P_ITEMD_OLD_VALUES))
      {
        weapon_liste(ob->QueryProp(P_ITEMD_OLD_VALUES),1);
      }
      else
      {    
        ob2=clone_object(filename);
        weapon_liste(ob2);
        ob2->remove();
      }
    }
  }
  write("+=========================================================================+\n");
  return 1;
}

nosave int socketed_props(object ob) 
{
  int socks, usocks, fsocks, al, i;
  string long_beschr, *desc, output;
  socks=ob->HasSockets();
  fsocks=ob->HasFreeSockets();
  usocks=socks-fsocks;
  al=ob->QueryAuto();
  long_beschr=ob->long();
  long_beschr=implode(explode(long_beschr, "\n"), " ");
  if(sizeof(desc=explode(long_beschr, "Sockel (")) > 1)
    desc=explode(explode(desc[1], ")")[0], ", ");
  else desc=({});
  printf("| Sockel (gesamt): %1d   |   Sockel (belegt): %1d   |   Sockel (frei): %1d "
      "     |\n", socks, usocks, fsocks);
  write("+======================+========================+=========================+\n");
  if(sizeof(desc)) {
    for(i=0;i<=sizeof(desc)-1;i++) {
      output=desc[i];
      while(i<=sizeof(desc)-2 && strlen(output+desc[i+1])<=69 )
      {  
        if(desc[i+1]!="\b\b")
          output+=", "+desc[i+1];
        i++;
      }
      printf("| %-71s |\n", output);
    }
  }
  else
    printf("| %-71s |\n", "Keine");
  if(al!=-1) 
    printf("| Autoload: %2d Reboots                                       |\n",
        al);
  write("+=========================================================================+\n");
  return 1;
}

void write_mapping(string output, mapping map)
{
  int i;
  string append;
  for(i=sizeof(map)-1;i>=0;i--)
  {
    while( i>=0 && strlen(output+to_string(m_indices(map)[i])+
          to_string(m_values(map)[i])) <=68 )
    {
      output+=to_string(m_indices(map)[i])+":"+
        to_string(m_values(map)[i--])+", ";
    }
    printf("| %-71s |\n", output);
    output="";
  }
}

void write_props(object wea)
{
  if( wea->QueryProp(P_M_HEALTH_MOD))
    write_mapping("HEALTH_MODIFIKATOREN: ", wea->QueryProp(P_M_HEALTH_MOD));
  if( wea->QueryProp(P_X_HEALTH_MOD))
    write_mapping("HEALTH_MODIFIKATOREN: ", wea->QueryProp(P_X_HEALTH_MOD));
  if( wea->QueryProp((P_M_ATTR_MOD)))
    write_mapping("ATTRIBUT_MODIFIKATOREN: ", wea->QueryProp(P_M_ATTR_MOD));
  if( wea->QueryProp((P_X_ATTR_MOD)))
    write_mapping("ATTRIBUT_MODIFIKATOREN: ", wea->QueryProp(P_X_ATTR_MOD));
  if( wea->QueryProp(ITEMD_PROB_CHANGE) )
    printf("| ITEMD_PROB_CHANGE: %3d                                                  |\n", 
        wea->QueryProp(ITEMD_PROB_CHANGE) );
  if( wea->QueryProp(P_BERSERKER_BONUS) )
    write_mapping("BERSERKER_BONUS: ", wea->QueryProp(P_BERSERKER_BONUS));
  if( wea->QueryProp(P_ITEMD_ELEMENTAL_VALUE) )
  {
    if( intp(wea->QueryProp(P_ITEMD_ELEMENTAL_VALUE)) )
      printf("| ELEMENTAL_VALUE: %3d                                                    |\n", 
          wea->QueryProp(P_ITEMD_ELEMENTAL_VALUE) );
    else if( mappingp(wea->QueryProp(P_ITEMD_ELEMENTAL_VALUE)) )
      write_mapping("ELEMENTAL_VALUE: ", wea->QueryProp(P_ITEMD_ELEMENTAL_VALUE) );
  }
  if( wea->QueryProp(P_PALADIN_SPELLCOST) )
    printf("| PALADIN_SPELLCOST: %3d                                                  |\n", 
        wea->QueryProp(P_PALADIN_SPELLCOST) );
  if( wea->QueryProp(P_NEKRO_SPELLCOST) )
    printf("| NEKRO_SPELLCOST: %3d                                                    |\n", 
        wea->QueryProp(P_NEKRO_SPELLCOST) );
  if( wea->QueryProp(P_NEKRO_BONUS) )
    write_mapping("NEKRO_BONUS: ", wea->QueryProp(P_NEKRO_BONUS));
  if( wea->QueryProp(P_ZECHPRELLER_SPELLCOST) )
    printf("| ZECHPRELLER_SPELLCOST: %3d                                              |\n", 
        wea->QueryProp(P_ZECHPRELLER_SPELLCOST) );
  if( wea->QueryProp(P_ZECHPRELLER_BONUS) )
    write_mapping("ZECHPRELLER_BONUS: ", wea->QueryProp(P_ZECHPRELLER_BONUS));
  if( wea->QueryProp(P_ZECHPRELLER_REDUCE_ALC) )
    printf("| ZECHPRELLER_REDUCE_ALC: %3d                                             |\n", 
        wea->QueryProp(P_ZECHPRELLER_REDUCE_ALC) );
  if( wea->QueryProp(P_TELEPORT_COST) )
    printf("| TELEPORT_COST: %3d                                                      |\n", 
        wea->QueryProp(P_TELEPORT_COST));
}

nosave varargs int armour_liste(mixed arm, int flag)
{
  int i;
  string armstring, cloner, metal;
  mapping prot, prot2;

  if(!flag)
  {
    switch( arm->QueryProp(P_ARMOUR_TYPE) )
    {
      case AT_ARMOUR:    armstring="ARMOUR";    break;
      case AT_SHIELD:    armstring="SHIELD";    break;
      case AT_CLOAK:     armstring="CLOAK";     break;
      case AT_HELMET:    armstring="HELMET";    break;
      case AT_TROUSERS:  armstring="TROUSERS";  break;
      case AT_GLOVE:     armstring="GLOVE";     break;
      case AT_BOOT:      armstring="BOOT";      break;
      case AT_RING:      armstring="RING";      break;
      case AT_AMULET:    armstring="AMULET";    break;
      case AT_BELT:      armstring="BELT";      break;
      case AT_BRACERS:   armstring="BRACERS";   break;                   
      case AT_MISC:      armstring="MISC";      break;
    }
  }
  else
    armstring=""; 
  if( !flag && (arm->QueryMaterialGroup(MATGROUP_METAL))>10 )
    metal="J";
  else
    metal="N";
  if(flag) metal=" ";
  printf(
    "|    AT    AC   Wert  gramm    QD   Metal Cursed Light Cold  Hot          |\n"
    "|%9|s %2d %6d  %5d   %3d     %1s     %1s     %2d    %2d   %2d           |\n",
    armstring,
    flag?arm[P_AC]:arm->QueryProp(P_AC)+arm->QueryProp(P_DAMAGED),
    flag?arm[P_VALUE]:arm->QueryProp(P_VALUE),
    flag?arm[P_WEIGHT]:arm->QueryProp(P_WEIGHT),
    flag?arm[P_QUALITY_DECAY]:arm->QueryProp(P_QUALITY_DECAY),
    metal,
    flag?"N":arm->QueryProp(P_CURSED)?"J":"N",
    flag?0:arm->QueryProp(P_LIGHT), 
    flag? (mappingp(arm[P_TEMPERATURE_PROTECTION]) ? arm[P_TEMPERATURE_PROTECTION][0] : 0) :
          (mappingp(arm->QueryProp(P_TEMPERATURE_PROTECTION)) ? arm->QueryProp(P_TEMPERATURE_PROTECTION)[0] : 0),
    flag? (mappingp(arm[P_TEMPERATURE_PROTECTION]) ? arm[P_TEMPERATURE_PROTECTION][1] : 0) :
          (mappingp(arm->QueryProp(P_TEMPERATURE_PROTECTION)) ? arm->QueryProp(P_TEMPERATURE_PROTECTION)[1] : 0)
    );
    if(!flag)
    {
      if( arm->QueryProp(P_DEFEND_FUNC))
        printf("| %-71s |\n",sprintf("DEFEND_FUNC: %O",arm->QueryProp(P_DEFEND_FUNC)));
      if( arm->QueryProp(P_WEAR_FUNC))
        printf("| %-71s |\n",sprintf("WEAR_FUNC: %O",  arm->QueryProp(P_WEAR_FUNC)));
      if( arm->QueryProp(P_REMOVE_FUNC))
        printf("| %-71s |\n",sprintf("REMOVE_FUNC: %O", arm->QueryProp(P_REMOVE_FUNC)));
      if( sizeof(arm->QueryProp(P_DAM_PROTECTION))!=sizeof(PHYSICAL_DAMAGE_TYPES))
      {
        prot2=([]);
        for(i=sizeof(prot=arm->QueryProp(P_DAM_PROTECTION))-1;i>=0;i--)
          if(member(PHYSICAL_DAMAGE_TYPES, m_indices(prot)[i])==0)
            prot2=prot2+([ m_indices(prot)[i]:m_values(prot)[i] ]);
        write_mapping("DAMAGE_PROTECTION: ", prot2);
      }
      if( arm->QueryProp(P_WEAR_RESTRICTIONS))
        write_mapping("WEAR_RESTRICTIONS: ", arm->QueryProp(P_WEAR_RESTRICTIONS));
      write_props(arm);
    }
    return 1;    
}

nosave string* unique_dam_type(string* dt)
{
  int i, j;
  string* ret;
  
  ret = ({});
  for(i = 0, j = sizeof(dt); i < j; i++)
  {
    if(member(ret, dt[i]) == -1)
      ret += ({dt[i]});
  }
  return ret;  
}

nosave varargs int weapon_liste(mixed wea, int flag)
{
  string weastring, damstring, cloner, metal;
  mixed *damtype;
  int i, wc, fix;

  if( !flag)
  {
    switch( wea->QueryProp(P_WEAPON_TYPE) )
    {
      case WT_SWORD:  weastring="SWORD";  break;
      case WT_AXE:    weastring="AXE";    break;
      case WT_CLUB:   weastring="CLUB";   break;
      case WT_SPEAR:  weastring="SPEAR";  break;
      case WT_KNIFE:  weastring="KNIFE";  break;
      case WT_AMMU:   weastring="AMMU";   break;
      case WT_HANDS:  weastring="HANDS";  break;
      case WT_MAGIC:  weastring="MAGIC";  break;
      case WT_BOW:    weastring="BOW";    break;
      case WT_CHAIN:  weastring="CHAIN";  break;
      case WT_WHIP:   weastring="WHIP";   break;                
      case WT_MISC:   weastring="MISC";   break; 
    }
  }
  else
    weastring="";
  damstring="";
  damtype=unique_dam_type(flag?wea[P_DAM_TYPE]:wea->QueryProp(P_DAM_TYPE));
  for( i=0;i<sizeof(damtype);i++)
    if(stringp(damtype[i]))
    switch( damtype[i] )
    {
      case DT_SLASH:     damstring+="SLA "; break;
      case DT_BLUDGEON:  damstring+="BLU "; break;
      case DT_PIERCE:    damstring+="PIE "; break;
      case DT_SQUEEZE:   damstring+="SQU "; break;
      case DT_WHIP:      damstring+="WHI "; break;
      case DT_RIP:       damstring+="RIP "; break;
      case DT_FIRE:      damstring+="FIR "; break;
      case DT_COLD:      damstring+="COL "; break;
      case DT_WATER:     damstring+="WAT "; break;
      case DT_AIR:       damstring+="AIR "; break;
      case DT_LIGHTNING: damstring+="LTG "; break;
      case DT_EXPLOSION: damstring+="EXP "; break;
      case DT_SOUND:     damstring+="SOU "; break;
      case DT_LIGHT:     damstring+="LIT "; break;
      case DT_ELECTRIC:  damstring+="ELE "; break;
      case DT_ACID:      damstring+="ACI "; break;
      case DT_POISON:    damstring+="POI "; break;
      case DT_TERROR:    damstring+="TER "; break;
      case DT_HOLY:      damstring+="HOL "; break;
      case DT_UNHOLY:    damstring+="UNH "; break;
      case DT_MAGIC:     damstring+="MAG "; break;
    } 
  if( !flag && (wea->QueryMaterialGroup(MATGROUP_METAL))>10 )
    metal="J";
  else
    metal="N";
  if( flag) metal =" ";
  wc=flag?wea[P_WC]:(wea->QueryProp(P_WC)+wea->QueryProp(P_DAMAGED));
  fix=flag?wea[P_WC_FIX]:wea->QueryProp(P_WC_FIX);
  printf("| WT    WC FIX POW  NWC H   Wert gramm   QD"
         "  Met Crs Lgt DAM_TYPE         |\n"
         "|%5|s %3d %3d %4.1f %3d %1d %6d %5d  %3d   %1s   %1s   %1d  %-15s  |\n",
    weastring, wc, fix,
    (wc * (100 + fix))/1000.0,
    wc*( fix/2+50)/65,
    flag?wea[P_NR_HANDS]:wea->QueryProp(P_NR_HANDS),
    flag?wea[P_VALUE]:wea->QueryProp(P_VALUE),
    flag?wea[P_WEIGHT]:wea->QueryProp(P_WEIGHT),
    flag?wea[P_QUALITY_DECAY]:wea->QueryProp(P_QUALITY_DECAY),
    metal,
    flag?"N":wea->QueryProp(P_CURSED)?"J":"N",
    flag?0:wea->QueryProp(P_LIGHT),
    damstring); 
  if(!flag)
  {
    if( wea->QueryProp(P_HIT_FUNC))
      printf("| %-71s |\n",sprintf("HIT_FUNC: %O",wea->QueryProp(P_HIT_FUNC)));
    if( wea->QueryProp(P_WIELD_FUNC))
      printf("| %-71s |\n",sprintf("WIELD_FUNC: %O", wea->QueryProp(P_WIELD_FUNC)));
    if( wea->QueryProp(P_UNWIELD_FUNC))
      printf("| %-71s |\n",sprintf("UNWIELD_FUNC: %O",  wea->QueryProp(P_UNWIELD_FUNC)));
    if( wea->QueryProp(P_WIELD_RESTRICTIONS))
      write_mapping("WIELD_RESTRICTIONS: ", wea->QueryProp(P_WIELD_RESTRICTIONS));
      write_props(wea);
  }
  return 1;
}

nosave int ShowChances() {
  find_object(ITEMD)->ShowChances();
  return 1;
}


nosave int UniqueReport()
{
  int i,summe;
  string *x;
  string time,finder, item, dummy;
  mapping u;

  u=([
    "Herzensstaerke, das Amulett der Lebenskraft":0;"";"",
    "Silberfunke, der Panzer der Goettlickeit":0;"";"",
    "Donnerhall, der Guertel der Sinnesschaerfe":0;"";"",
    "Sturmtaenzer, die Stiefel der Weltreise":0;"";"",
    "Goldbringer, der Armreif des Gluecks":0;"";"",
    "Himmelsflug, der Umhang der Freiheit":0;"";"",
    "Titanenfaust, der Handschuh der Kraft":0;"";"",
    "Gedankenblitz, die Krone der Weisheit":0;"";"",
    "Weitblick, der Ring des allwissenden Auges":0;"";"",
    "Lebensschutz, der Schild des Abpralls":0;"";"",
    "Wirbelwind, die Hose der Macht":0;"";"",
    "Weltenbrand, das Beil der Vernichtung":0;"";"",
    "Daemmerungsfeuer, der Morgenstern der Schlachten":0;"";"",
    "Zermalmer, der Hammer der Goetter":0;"";"",
    "Schlitzer, der Dolch der Meuchler":0;"";"",
    "Herzsucher, der Speer der Rache":0;"";"",
    "Raecher, das Schwert der Vollstreckung":0;"";"",
    "Seelengeissel, die Peitsche der Zerstoerung":0;"";"",
    "Eternium, die Ruestung der Ewigkeit":0;"";"",
    "Blitzgeschwind, die Schuhe des Dauerlaufes":0;"";"",
    "Zorn, die Axt der ewigen Schlachten":0;"";"",
    "Todesdorn, die Klinge der Verdammten":0;"";"",
  ]);

  x=explode(read_file(ITEMD_LOG+"unique.log"),"\n");
   
  for(i=0;i<sizeof(x);i++)
  {
    if(sscanf(x[i],"%s: %s %sfindet '%s'",time,finder,dummy,item)==4)
    {
      if(member(u,item)) {
      u[item,0]++;
      u[item,1]=time;
      u[item,2]=finder;
      }
    }
  }
  x=sort_array(m_indices(u),#'<); //'
  write(
    "+============================================================================+\n"+
    "|                            UNIQUE-REPORT                                   | \n"+
    "+============================================================================+\n"+
    "|    Name des Uniques        Anzahl Spielername   Datum des letzen Fundes    |\n"+
    "+============================================================================+\n");
  summe=0;
  for(i=sizeof(x)-1;i>=0;i--)
  {
    time=explode(x[i],",")[0];
    item=explode(x[i], " ")[2];
    printf("|%-32s %2d %-11s %27s |\n",time+" ("+item+") ",u[x[i],0],u[x[i],2],u[x[i],1]);
    summe+=u[x[i],0];
  }
  printf(
    "+----------------------------------------------------------------------------+\n"+
    "|Gesamtzahl der Unique-Funde:     %-4d                                       |\n"+ 
    "+============================================================================+\n",
    summe);
  return 1;
}                                                                                

int mysort(string a, string b)
{
  if( s[a,1]==s[b,1] )
    return a<b;
  return s[a,1]>s[b,1];
}


nosave int SetReport()
{
  int i,summe, summe2;
  string *x, time, finder, set, item;

  s=([ 
      "Angaras":"Geschmeide";0;0;"";"",
      "Arcons":"Verbannung";0;0;"";"",
      "Flammaras":"Feuer";0;0;"";"",
      "Grimms":"Koerper";0;0;"";"",
      "Khartaks":"Kampfgewand";0;0;"";"",
      "Miras":"Verteidigung";0;0;"";"",
      "Nogis":"Vollruestung";0;0;"";"",
      "Rynoxas":"Lichterspiel";0;0;"";"",
      "Schlains":"Jagd";0;0;"";"",
      "Stahls":"Dornen";0;0;"";"",
      "Xulgsch":"Knochen";0;0;"";"",
      "Zafiras":"elementare Vollendung";0;0;"";"",
      ]);
  x=explode(read_file(ITEMD_LOG+"set.log"),"\n");
   
  for(i=0;i<sizeof(x);i++)
  {
    if(sscanf(x[i],"%s: %s findet '%s %s'",time,finder,set,item)==4)
      s[set,1]++;
    if(sscanf(x[i],"%s: %s hat nun %s %s komplett!",time,finder,set,item)==4 &&
        member(m_indices(s), set) != -1)
    {
      s[set,2]++;
      s[set,3]=time;
      s[set,4]=finder;
    }
  }
  x=sort_array(m_indices(s),"mysort");
  write(
    "+============================================================================+\n"+
    "|                               SET-REPORT                                   | \n"+
    "+============================================================================+\n"+
    "|    Name des Sets           gefunden komplett  Spieler          Datum       |\n"+
    "+============================================================================+\n");
  summe=summe2=0;
  for(i=sizeof(x)-1;i>=0;i--)
  {
    printf("|%-30s  %4d  %4d    %-11s %17s |\n",x[i]+" "+s[x[i],0], 
        s[x[i],1], s[x[i],2], s[x[i],4]|| " ", (stringp(s[x[i],3]) ? s[x[i],3][0..16] :" "));
    summe+=s[x[i],1];
    summe2+=s[x[i],2];
  }
  printf(
    "+----------------------------------------------------------------------------+\n"+
    "|Gesamtzahl der Set-Funde:       %4d  %4d                                  |\n"+ 
    "+============================================================================+\n",
    summe, summe2);
  return 1;
}

