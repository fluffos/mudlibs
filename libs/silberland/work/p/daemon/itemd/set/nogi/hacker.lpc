#include "../def.h"

inherit ITEMD_SET_PATH "std_set_weapon";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Nogis Vollruestung");
  SetProp(P_SET_ITEM, "Nogis Hacker");
  SetProp(P_NR_SET_ITEMS, 8);
  SetProp(P_SET_BONUS, ([
        0:([ P_WC_FIX:0, P_DAM_TYPE: ({DT_SLASH}) ]),
        1:([ P_WC_FIX:4, P_DAM_TYPE: ({DT_SLASH})  ]),
        2:([ P_WC_FIX:10, P_DAM_TYPE: ({DT_SLASH})  ]),
        3:([ P_WC_FIX:18, P_DAM_TYPE: ({DT_SLASH})  ]),
        4:([ P_WC_FIX:28, P_DAM_TYPE: ({DT_SLASH})  ]),
        5:([ P_WC_FIX:40, P_DAM_TYPE: ({DT_SLASH})  ]),
        6:([ P_WC_FIX:54, P_DAM_TYPE: ({DT_SLASH})  ]),
        7:([ P_WC_FIX:75, P_DAM_TYPE: ({DT_SLASH, DT_MIND})  ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Nogis Vollruestung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "nuetzt sich weniger ab", "liegt besser in der Hand",
        "macht speziellen Schaden"
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Nogis Hacker ist die Axt von Nogi, dem Unglaublichen. "
      "Eigentlich schaut sie aus wie eine ganz normale staehlerne Axt, "
      "nur kann man damit wohl Gegner besser auseinanderhacken.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hacker", "nogis hacker"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 177);
  SetProp(P_WC_FIX, 0);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 1950);
  SetProp(P_VALUE, 3000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:10, A_DEX:10, A_CON:10, A_STR:10]) );
  SetProp(P_HIT_FUNC, TO);
}

int HitFunc (object enemy) 
{
  return random(random(3)*random(3)*setmight()*setmight());
}
