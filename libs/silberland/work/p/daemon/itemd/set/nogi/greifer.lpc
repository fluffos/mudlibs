#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Nogis Vollruestung");
  SetProp(P_SET_ITEM, "Nogis Greifer");
  SetProp(P_NR_SET_ITEMS, 8);
  SetProp(P_SET_BONUS, ([
    0:([ P_M_ATTR_MOD: 0 ]),
    1:([ P_M_ATTR_MOD: 0 ]),
    2:([ P_M_ATTR_MOD: 0 ]),
    3:([ P_M_ATTR_MOD: ([A_DEX:1]) ]),
    4:([ P_M_ATTR_MOD: ([A_DEX:2]) ]),
    5:([ P_M_ATTR_MOD: ([A_DEX:3]) ]),
    6:([ P_M_ATTR_MOD: ([A_DEX:4]) ]),
    7:([ P_M_ATTR_MOD: ([A_DEX:5]) ]),
    ]));
  SetProp(P_ITEMD, ({"gehoert zu Nogis Vollruestung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "nuetzt sich weniger ab", "wehrt mehr Schaden ab", 
        "erhoeht deine Geschicklichkeit"
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Nogis Greifer sind die Handschuhe von Nogi, dem Unglaublichen. "
      "Eigentlich schauen sie aus wie ganz normale staehlerne Handschuhe, "
      "nur kann man mit ihnen viel besser zugreifen.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"greifer", "nogis greifer"}) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 3000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10, A_DEX:10, A_CON:10, A_STR:10]) );
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  return setmight()*setmight()/8;
}
