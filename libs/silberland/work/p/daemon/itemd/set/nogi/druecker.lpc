#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Nogis Vollruestung");
  SetProp(P_SET_ITEM, "Nogis Druecker");
  SetProp(P_NR_SET_ITEMS, 8);
  SetProp(P_SET_BONUS, ([
        0:([ ITEMD_PROB_CHANGE: 1 ]),
        1:([ ITEMD_PROB_CHANGE: 3 ]),
        2:([ ITEMD_PROB_CHANGE: 7 ]),
        3:([ ITEMD_PROB_CHANGE: 13]),
        4:([ ITEMD_PROB_CHANGE: 21]),
        5:([ ITEMD_PROB_CHANGE: 31]),
        6:([ ITEMD_PROB_CHANGE: 43]),
        7:([ ITEMD_PROB_CHANGE: 60]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Nogis Vollruestung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "lassen Dich mehr magische Sachen finden", "nuetzt sich weniger ab", 
        "wehrt mehr Schaden ab",
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Nogis Druecker sind die Armschienen von Nogi, dem Unglaublichen. "
      "Eigentlich schauen sie aus wie ganz normale staehlerne Armschienen, "
      "nur kann man sie mit kleinen Drueckern sehr gut an den Armen "
      "festschnallen.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"druecker", "nogis druecker"}) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 850);
  SetProp(P_VALUE, 3000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10, A_DEX:10, A_CON:10, A_STR:10]) );
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  return setmight()*setmight()/8;
}
