#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Nogis Vollruestung");
  SetProp(P_SET_ITEM, "Nogis Ueberzieher");
  SetProp(P_NR_SET_ITEMS, 8);
  SetProp(P_SET_BONUS, ([
        0:([ P_M_HEALTH_MOD: ([P_HP:0]) ]),
        1:([ P_M_HEALTH_MOD: ([P_HP:1]) ]),
        2:([ P_M_HEALTH_MOD: ([P_HP:2]) ]),
        3:([ P_M_HEALTH_MOD: ([P_HP:4]) ]),
        4:([ P_M_HEALTH_MOD: ([P_HP:7]) ]),
        5:([ P_M_HEALTH_MOD: ([P_HP:12]) ]),
        6:([ P_M_HEALTH_MOD: ([P_HP:17]) ]),
        7:([ P_M_HEALTH_MOD: ([P_HP:31]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Nogis Vollruestung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Deine Lebenspunkte", "nuetzt sich weniger ab", 
        "wehrt mehr Schaden ab",
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Nogis Ueberzieher ist der Panzer von Nogi, dem Unglaublichen. Eigentlich "
      "schaut er aus wie ein ganz normaler Eisenpanzer, aber scheinbar kann man "
      "ihn viel besser ueberziehen als andere Ruestungen.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"ueberzieher", "nogis ueberzieher"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 1850);
  SetProp(P_VALUE, 3000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10, A_DEX:10, A_CON:10, A_STR:10]) );
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  return setmight()*setmight()/4;
}
