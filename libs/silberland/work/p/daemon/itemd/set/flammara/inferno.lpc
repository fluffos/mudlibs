#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Flammaras Feuer");
  SetProp(P_SET_ITEM, "Flammaras Inferno");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_ITEMD_ELEMENTAL_VALUE: 1, P_LIGHT:0, P_DRUID_ADD_HAND_DAMAGE:2]),
        1:([P_ITEMD_ELEMENTAL_VALUE: 2, P_LIGHT:0, P_DRUID_ADD_HAND_DAMAGE:10]),
        2:([P_ITEMD_ELEMENTAL_VALUE: 3, P_LIGHT:1, P_DRUID_ADD_HAND_DAMAGE:20]),
        3:([P_ITEMD_ELEMENTAL_VALUE: 5, P_LIGHT:1, P_DRUID_ADD_HAND_DAMAGE:40]),
        ]));
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, FEUER);
  SetProp(P_ITEMD, ({"gehoert zu Flammaras Feuer", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "leuchtet im Dunkeln", "erhoeht Deine Magiepunkte", "verringert die "
        "Kosten aller elementarer Zauber", "nuetzt sich weniger ab", 
        "veraendert den Temperaturschutz",
        "wehrt zusaetzlichen Schaden ab", "ist federleicht",
        "verbessert den Handkampf",
        }) );
  SetProp(P_SHORT, "Flammaras Inferno");
  SetProp(P_LONG,
      "Flammaras Inferno ist ein Faeustling aus lebenden Flammen. " 
      "Die elementare Macht, die dieses Gebilde zusammenhaelt, "
      "muss enorm sein. Obwohl eine spuerbare Hitze von ihm ausgeht, "
      "scheint es Dich nicht zu verbrennen.");
  SetProp(P_NAME, "Flammaras Inferno");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"inferno","flammaras inferno", }) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_FIRE: 100]) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 6000);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:6, T_HEAT_PROT:-2]) );
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:2]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:22]) );
  SetProp(P_DEFEND_FUNC, TO);

}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return setmight()+setmight()*setmight()/2;
}

