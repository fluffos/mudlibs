
#include <properties.h>
#include "../def.h"

inherit "std/thing";

#define FIRE_OBJ_ID "\nfire_obj_flammaras_flammenspur"

string get_burning_earth();

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Boden");
  SetProp(P_NAME_ADJ, "brennend");
  SetProp(P_SHORT, "Der Boden brennt hier");
  SetProp(P_LONG,
    "Der ganze Boden steht hier in Flammen! Rette Dich solange Du kannst!" );
  SetProp(P_GENDER, MALE);
  SetProp(P_NOGET, #'get_burning_earth);
  AddId( ({ "flammen", FIRE_OBJ_ID }) );

  SetProp(P_MATERIAL, MAT_FIRE );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

  set_next_reset(60);

}

string get_burning_earth() {
  TI->AddHp(-random(10));
  return ("Du versuchst die Flammen zu nehmen! Du verbrennst Dich!");
}

void init() {
  mapping env;
  ::init();
  if (environment() && mappingp(env=environment()->QueryProp(P_ENVIRONMENT)) 
      && member(({TT_AIR, TT_WATER, TT_UNDERWATER}), env[ENV_TERRAIN]) != -1)
    call_out("remove", 0);
  else if (TP == TI && environment(this_object()) && !random(6))
    call_out("burn", 0, this_interactive());
  return ;
}

void burn(object pl) {
  object *b;
  if (!pl)
    return;
  if (sizeof(b = pl->QueryArmours(AT_BOOT)) && (
        b[0]->id("eisstiefel") || b[0]->id("flutwellendaemonstiefel") ||
        b[0]->id("gletscherstiefel") ))
  {
    tell_object(pl, "Deine Stiefel loeschen die Flammen aus!\n");
    remove();
    return;
  }
  pl->AddHp(-random(4));
  tell_object(pl, "WAH! DU VERBRENNST DICH SCHWER!\n");
  return ;
}

reset() {
  ::reset();
  call_out("remove", 0);
  return ;
}

varargs void remove(int silent)
{
  if (!silent && environment())
    tell_room(environment(), "Die Flammen am Boden verloeschen.\n");
  ::remove(silent);
}
