#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Flammaras Feuer");
  SetProp(P_SET_ITEM, "Flammaras Stichflamme");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0,P_SP:0]), P_LIGHT:0,  
            P_ITEMD_ELEMENTAL_VALUE: 0]),
        1:([P_M_HEALTH_MOD:([P_HP:1,P_SP:3]), P_LIGHT:0, 
            P_ITEMD_ELEMENTAL_VALUE: 1]),
        2:([P_M_HEALTH_MOD:([P_HP:4,P_SP:7]), P_LIGHT:1, 
            P_ITEMD_ELEMENTAL_VALUE: 2]),
        3:([P_M_HEALTH_MOD:([P_HP:9,P_SP:13]), P_LIGHT:1, 
            P_ITEMD_ELEMENTAL_VALUE: 4]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Flammaras Feuer", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "leuchtet im Dunkeln", "erhoeht Deine Magiepunkte", "verringert die "
        "Kosten aller elementarer Zauber", "nuetzt sich weniger ab", 
        "veraendert den Temperaturschutz",
        "wehrt zusaetzlichen Schaden ab", "ist federleicht",
        }) );
  SetProp(P_SHORT, "Flammaras Stichflamme");
  SetProp(P_LONG,
      "Flammaras Stichflamme ist eine hell strahlende Flamme, die staendig "
      "in alle Richtungen auszubrechen versucht, jedoch von einer elementaren "
      "Macht in einer Form aehnlich eines Amulettes gehalten wird. Obwohl "
      "eine spuerbare Hitze von ihr ausgeht, scheint sie Dich nicht zu ver"
      "brennen.");
  SetProp(P_NAME, "Flammaras Stichflamme");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stichflamme","flammaras stichflamme", "flamme" }) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_FIRE: 100]) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 6000);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:-1]) );
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:3]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:22]) );
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return setmight()*setmight()/3;
}

void reset()
{
  object pl;
  if( !is_clone(this_object()) ) return;
  ::reset();
  if( (pl=QueryProp(P_WORN)) && interactive(pl) )
  {
    tell_object(pl, "Flammaras Stichflamme waermt Deinen Koerper und Deinen Geist.\n");
    pl->heal_self(10 + 10*setmight()*setmight()*setmight());
  }
}
