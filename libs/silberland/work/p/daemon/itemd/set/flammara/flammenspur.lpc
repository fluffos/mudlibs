#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

#define FIRE_OBJ_ID "\nfire_obj_flammaras_flammenspur"
#define FIRE_OBJ ITEMD_SET_PATH+"flammara/burning_earth"

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Flammaras Feuer");
  SetProp(P_SET_ITEM, "Flammaras Flammenspur");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_ITEMD_ELEMENTAL_VALUE: 1, "burn_earth": 0, P_M_ATTR_MOD:0,]),
        1:([P_ITEMD_ELEMENTAL_VALUE: 2, "burn_earth": 5, P_M_ATTR_MOD:0,]),
        2:([P_ITEMD_ELEMENTAL_VALUE: 3, "burn_earth": 10, P_M_ATTR_MOD:([A_INT:1]),]),
        3:([P_ITEMD_ELEMENTAL_VALUE: 5, "burn_earth": 25, P_M_ATTR_MOD:([A_INT:3]),]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Flammaras Feuer", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "verringert die Kosten aller elementarer Zauber", 
        "nuetzt sich weniger ab", "laesst den Boden brennen",
        "veraendert den Temperaturschutz", "erhoeht Deine Intelligenz",
        "wehrt zusaetzlichen Schaden ab", "ist federleicht", 
        }) );
  SetProp(P_SHORT, "Flammaras Flammenspur");
  SetProp(P_LONG,
      "Flammaras Flammenspur sind ein Paar Stiefel, die aus purem elementaren "
      "Feuer zu bestehen scheinen. Sie scheinen von einer starken Macht umgeben "
      "zu sein, die sie auch in ihrer Form haelt. Obwohl von ihnen einen immense "
      "Hitze ausgeht, scheinen sie Dich nicht zu verbrennen.");
  SetProp(P_NAME, "Flammaras Flammenspur");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"flammenspur","flammaras flammenspur" }) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_FIRE: 100]) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 6000);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:22]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5, T_HEAT_PROT:-2]) );
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:2]) );

  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
}


int WearFunc(object ob, int silent) 
{
  MENV->AddHpHook(ME);
  return ::WearFunc(ob,silent);
}

int RemoveFunc(object ob, int silent) 
{
  QueryProp(P_WORN)->RemoveHpHook(ME);
  return ::RemoveFunc(ob,silent);
}


void NotifyHpChange() {
  object pl,env,ob;
  mapping m;
  pl=QueryProp(P_WORN);
  if(!pl || !env=ENV(pl)) return ;
  if( random(100) > QueryProp("burn_earth") ) return;
  if(present(FIRE_OBJ_ID, env)) return;
  if(!mappingp(m = env->QueryProp(P_ENVIRONMENT)) ||
     m[ENV_TERRAIN] == TT_UNDERWATER ||
     m[ENV_TERRAIN] == TT_WATER)
  {
    return;
  }
  ob=clone_object(FIRE_OBJ); 
  ob->SetFireDamage(QueryProp("burn_earth")/10);
  ob->move(env, M_NOCHECK);
  tell_room(env, "Ploetzlich beginnt der Boden zu brennen!\n");
  return;
}
