#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Rynoxas Lichterspiel");
  SetProp(P_SET_ITEM, "Rynoxas Glimmer");
  SetProp(P_NR_SET_ITEMS, 5);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0,P_SP:0])]),
        1:([P_M_HEALTH_MOD:([P_HP:0,P_SP:1])]),
        2:([P_M_HEALTH_MOD:([P_HP:1,P_SP:2])]),
        3:([P_M_HEALTH_MOD:([P_HP:2,P_SP:3])]),
        4:([P_M_HEALTH_MOD:([P_HP:3,P_SP:4])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Rynoxas Lichterspiel", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab", 
        "erhoeht Lebenspunkte und Magiepunkte",
        "kann nur von guten oder neutralen Wesen verwendet werden",
        "nuetzt sich fast gar nicht ab",
        "erhoeht oder erniedrigt Attribute"}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Rynoxas Glimmer ist eine kleine Lichterscheinung, die man sich wie "
    "ein Amulett umhaengen kann. Du wunderst Dich, welche seltsame Magie "
    "das Licht in diese Form gebannt hat." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"glimmer", "rynoxas glimmer" }) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_LIGHT: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 1000);

  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20, SR_BAD:-300]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  if(QueryProp(P_WORN)->QueryProp(P_ALIGN)>-300)
    return 1+setmight()/2;
  else
    return DoUnwear(),-30;
}

int WearFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 1);
  return ::WearFunc(ruestung, silent);
}       

int RemoveFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 0);
  return ::RemoveFunc(ruestung, silent);
}     

void reset()
{
  ::reset();
  if( !is_clone(this_object()) ) return;
  if (!QueryProp(P_WORN))
    SetProp(P_LIGHT, 0);
}
