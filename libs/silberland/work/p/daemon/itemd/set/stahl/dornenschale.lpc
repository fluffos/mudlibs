#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Stahls Dorne");
  SetProp(P_SET_ITEM, "Stahls Dornenschale");
  SetProp(P_NR_SET_ITEMS, 5);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0]), "hit_bonus":0]),
        1:([P_M_HEALTH_MOD:([P_HP:2]), "hit_bonus":1]),
        2:([P_M_HEALTH_MOD:([P_HP:3]), "hit_bonus":3]),
        3:([P_M_HEALTH_MOD:([P_HP:4]), "hit_bonus":6]),
        4:([P_M_HEALTH_MOD:([P_HP:8]), "hit_bonus":10]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Stahls Dorne", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "verletzt den Angreifer", 
        "schuetzt besser", "nuetzt sich weniger ab",
        "erhoeht deine Lebenspunkte"}) );

  SetProp(P_SHORT, "Stahls Dornenschale");
  SetProp(P_LONG,
      "Stahls Dornenschale ist ein eisenverstaerkter Panzer aus dem in "
      "regelmaessigen Abstaenden spitze Dorne herausragen, die den Traeger "
      "wie einen Igel schuetzen und allen Gegner das fuerchten lernen. "
      "Eine dunkle Aura scheint von der Dornenschale auszugehen.");

  AddDetail( ({"dorne"}), 
      "Die Dorne glaenzen gefaehrlich in einem stahlgrauen Schimmer.");
      

  SetProp(P_NAME, "Stahls Dornenschale");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schale", "stahls dornenschale", "dornenschale" }) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:25]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  object traeger;
  int val, ac;

  if(!traeger=QueryProp(P_WORN)) return 0;
  if(!enemy) return 0;
  if(random(45) < QueryProp("hit_bonus"))
  {
    if (!enemy->QueryProp(P_WEAPON) && (!spell) &&
        (enemy->QueryProp(P_SIZE) > 2*traeger->QueryProp(P_SIZE) / 3))
    {
      SetProp (P_KILLER, traeger->name());
      tell_room(ENV(ENV(PO)), BS(sprintf(
              "Die spitzen Dorne von %s verletzen %s!",QueryProp(P_NAME), 
              enemy->name(WEN))),({enemy}));
      tell_object(enemy, BS(sprintf(
              "Die spitzen Dorne von %s treffen Dich!", QueryProp(P_NAME))));
      ac=QueryProp(P_AC)+QueryProp("hit_bonus");
      val=(random(5)+setmight())*(random(ac)+ac);
      enemy->Defend(val,DT_PIERCE, ([SP_NAME:"Dornen", SP_SHOW_DAMAGE:1]), 
          traeger);
      return 0;
    }
  }
  return setmight()*(setmight()+1);
}

