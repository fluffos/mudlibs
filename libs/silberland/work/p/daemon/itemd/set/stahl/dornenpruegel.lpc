#include "../def.h"

inherit ITEMD_SET_PATH "std_set_weapon";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Stahls Dorne");
  SetProp(P_SET_ITEM, "Stahls Dornenpruegel");
  SetProp(P_NR_SET_ITEMS, 5);
  SetProp(P_SET_BONUS, ([
        0:([P_WC_FIX: 10, "hit_bonus":0]),
        1:([P_WC_FIX: 20, "hit_bonus":20]),
        2:([P_WC_FIX: 35, "hit_bonus":40]),
        3:([P_WC_FIX: 55, "hit_bonus":60]),
        4:([P_WC_FIX: 75, "hit_bonus":100]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Stahls Dorne", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "macht mehr Schaden", "liegt besser in der Hand", "entzieht "
        "dem Gegner Lebenspunkte", "nuetzt sich weniger ab",}));

  SetProp(P_SHORT, "Stahls Dornenpruegel");
  SetProp(P_LONG,
      "Stahls Dornenpruegel ist ein maechtiger und riesiger Kampfhammer, "
      "der ueber und ueber mit spitzen Dornen versehen ist. Eine boesartige "
      "Aura geht von ihm aus.");

  AddDetail( ({"dorne"}), 
      "Die Dorne glaenzen gefaehrlich in einem stahlgrauen Schimmer.");
      

  SetProp(P_NAME, "Stahls Dornenpruegel");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"pruegel", "stahls dornenpruegel", "dornenpruegel" }) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 180);
  SetProp(P_WC_FIX, 10 );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:25]) );
}

int Hitfunc(object enemy) {
  object wielder;
  int hb;
  hb=QueryProp("hit_bonus");
  if(!random(2) && random(hb)>30 ) {
    wielder=QueryProp(P_WIELDED);
    if(enemy->QueryProp(P_HP) > 4) {
      hb=random(hb/10);
      enemy->AddHp(-hb);
      wielder->AddHp(hb);
      return 0;
    }
  }
  return random(QueryProp("hit_bonus"));
}
