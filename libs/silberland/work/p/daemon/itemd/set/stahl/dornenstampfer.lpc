#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Stahls Dorne");
  SetProp(P_SET_ITEM, "Stahls Dornenstampfer");
  SetProp(P_NR_SET_ITEMS, 5);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0]), "hit_bonus":0, P_EFFECTIVE_WC:20]),
        1:([P_M_HEALTH_MOD:([P_HP:1]), "hit_bonus":1, P_EFFECTIVE_WC:50]),
        2:([P_M_HEALTH_MOD:([P_HP:2]), "hit_bonus":3, P_EFFECTIVE_WC:100]),
        3:([P_M_HEALTH_MOD:([P_HP:3]), "hit_bonus":6, P_EFFECTIVE_WC:150]),
        4:([P_M_HEALTH_MOD:([P_HP:4]), "hit_bonus":10, P_EFFECTIVE_WC:240]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Stahls Dorne", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "verletzt den Angreifer", 
        "schuetzt besser", "nuetzt sich weniger ab",
        "erhoeht deine Lebenspunkte"}) );

  SetProp(P_SHORT, "Stahls Dornenstampfer");
  SetProp(P_LONG,
      "Stahls Dornenstampfer sind maechtige stahlverstaerkte Kampfstiefel, "
      "die ueber und ueber mit spitzen Dornen versehen sind. Eine boesartige "
      "Aura geht von ihnen aus.");

  AddDetail( ({"dorne"}), 
      "Die Dorne glaenzen gefaehrlich in einem stahlgrauen Schimmer.");
      

  SetProp(P_NAME, "Stahls Dornenstampfer");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stampfer", "stahls dornenstampfer", "dornenstampfer" }) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_EFFECTIVE_WC, 30);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:25]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  object traeger;
  int val, ac;

  if(!traeger=QueryProp(P_WORN)) return 0;
  if(!enemy) return 0;
  if(random(30) < QueryProp("hit_bonus"))
  {
    if (!enemy->QueryProp(P_WEAPON) && (!spell) &&
        (enemy->QueryProp(P_SIZE) < traeger->QueryProp(P_SIZE) / 2))
    {
      SetProp (P_KILLER, traeger->name());
      tell_room(ENV(ENV(PO)), BS(sprintf(
              "Die spitzen Dorne von %s verletzen %s!",QueryProp(P_NAME), 
              enemy->name(WEN))),({enemy}));
      tell_object(enemy, BS(sprintf(
              "Die spitzen Dorne von %s treffen Dich!", QueryProp(P_NAME))));
      ac=QueryProp(P_AC)+QueryProp("hit_bonus");
      val=(random(5)+setmight())*(random(ac)+ac);
      enemy->Defend(val,DT_PIERCE, ([SP_NAME:"Dornen", SP_SHOW_DAMAGE:1]), 
          traeger);
      return 0;
    }
  }
  return setmight();
}

