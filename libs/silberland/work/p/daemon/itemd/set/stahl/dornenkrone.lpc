#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Stahls Dorne");
  SetProp(P_SET_ITEM, "Stahls Dornenkrone");
  SetProp(P_NR_SET_ITEMS, 5);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0]), P_EFFECTIVE_WC:20, "hit_bonus":0]),
        1:([P_M_HEALTH_MOD:([P_HP:1]),  P_EFFECTIVE_WC:50, "hit_bonus":1]),
        2:([P_M_HEALTH_MOD:([P_HP:2]),  P_EFFECTIVE_WC:100, "hit_bonus":3]),
        3:([P_M_HEALTH_MOD:([P_HP:3]),  P_EFFECTIVE_WC:150, "hit_bonus":6]),
        4:([P_M_HEALTH_MOD:([P_HP:4]),  P_EFFECTIVE_WC:240, "hit_bonus":10]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Stahls Dorne", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "verletzt den Angreifer", "entzieht mit seinen Stacheln dem Gegner "
        "Lebensenergie", "erhoeht Deine Lebensenergie", 
        "nuetzt sich weniger ab",}));

  SetProp(P_SHORT, "Stahls Dornenkrone");
  SetProp(P_LONG,
      "Die Krone ist eine bizarre Konstruktion, deren Zacken riesige "
      "Dorne sind, die in stahlgrau funkeln. Sie sehen messerscharf und "
      "SEHR spitz aus. Eine bedrohliche Aura geht von der Krone aus.");

  AddDetail( ({"dorne"}), 
      "Die Dorne glaenzen gefaehrlich in einem stahlgrauen Schimmer.");
      

  SetProp(P_NAME, "Stahls Dornenkrone");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"krone", "stahls dornenkrone", "dornenkrone" }) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:25]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  object traeger;
  int val, ac;

  if(!traeger=QueryProp(P_WORN)) return 0;
  if(!enemy) return 0;
  if(random(33) < QueryProp("hit_bonus"))
  { 
    if (!enemy->QueryProp(P_WEAPON) && (!spell) &&
        (enemy->QueryProp(P_SIZE) > traeger->QueryProp(P_SIZE) ))
    {
      SetProp (P_KILLER, traeger->name());
      ac=QueryProp(P_AC)+QueryProp("hit_bonus");
      val=(random(4)+setmight())*(random(ac)+ac);
      if(random(50) <= QueryProp("hit_bonus")) {
        traeger->AddHp(1+(val/33));
        enemy->AddHp(-1-(val/33));
        tell_object(traeger, BS(sprintf("%s entzieht Deinem Gegner "
                "Lebensenergie und uebertraegt sie auf Dich!", 
                QueryProp(P_NAME))));
      }
      else
      {
        tell_room(ENV(ENV(PO)), BS(sprintf(
                "Die spitzen Dorne von %s verletzen %s!",QueryProp(P_NAME), 
                enemy->name(WEN))),({enemy}));
        tell_object(enemy, BS(sprintf(
                "Die spitzen Dorne von %s treffen Dich!", QueryProp(P_NAME))));
        enemy->Defend(val,DT_PIERCE, ([SP_NAME:"Dornen", SP_SHOW_DAMAGE:1]), 
            traeger);
      }
    }
  }
  return setmight();
}

