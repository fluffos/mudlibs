#include "../def.h"
#include "/gilden/zechpreller/zechpreller_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Fraggins Durst");
  SetProp(P_SET_ITEM, "Fraggins Wanker");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_ZECHPRELLER_BONUS:(["torkeln":5])]),
        1:([P_ZECHPRELLER_BONUS:(["torkeln":5])]),
        2:([P_ZECHPRELLER_BONUS:(["torkeln":10])]),
        3:([P_M_HEALTH_MOD:([P_HP:5]), 
            P_ZECHPRELLER_BONUS:(["torkeln":10, "all":5])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Fraggins Durst", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab", "nuetzt sich weniger ab",
        "erhoeht Deine Lebenspunkte", "verbessert Torkeln", 
        "verbessert Zechprellerfaehigkeiten"
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Fraggins Wanker sind alte und zerlumpte Lederstiefel. Sie sind "
    "mit seltsamen gelb-gruenen Flecken bedeckt und stinken nach "
    "einer Mischung aus Schnaps und Erbrochenem. Fraggin Wirtsschreck "
    "hat diese Schuhe auf seinen langen Kneipentouren getragen." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"wanker", "fraggins wanker" }) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 80, MAT_ALCOHOL:10, MAT_MISC:10]) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:15]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 1 + setmight();
}
