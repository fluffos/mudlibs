#include "../def.h"
#include "/gilden/zechpreller/zechpreller_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Fraggins Durst");
  SetProp(P_SET_ITEM, "Fraggins Dunst");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:0,
            P_ZECHPRELLER_BONUS:(["dunstpanzer":5])]),
        1:([P_M_HEALTH_MOD:([P_HP:1]), 
            P_ZECHPRELLER_BONUS:(["dunstpanzer":10])]),
        2:([P_M_HEALTH_MOD:([P_HP:3]),
            P_ZECHPRELLER_BONUS:(["dunstpanzer":10, "alkoholwolke":5])]),
        3:([P_M_HEALTH_MOD:([P_HP:11]),
            P_ZECHPRELLER_BONUS:(["dunstpanzer":10, "alkoholwolke":10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Fraggins Durst", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab",
        "verbessert Dunstpanzer",
        "verbessert Alkoholwolke",
        "erhoeht Deine Lebenspunkte", "nuetzt sich weniger ab", 
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Fraggins Dunst ist eine weisse Dunstwolke, die Dich umwabert. "
    "Es ist purer Alkohol, der an der frischen Luft sofort verdampft. "
    "Vor vielen Jahren hat Fraggin Wirtsschreck diesen Mantel geschaffen, "
    "als er eine lange Nacht durchzechte." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"dunst", "fraggins dunst"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 9);
  AddProp(P_DAM_PROTECTION, ([DT_POISON:1, DT_ACID:1, DT_AIR:1]) );
  SetProp(P_MATERIAL, ([MAT_ALCOHOL: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:15]) );
}
