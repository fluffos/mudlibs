#include "../def.h"
#include "/gilden/zechpreller/zechpreller_extern.h"
#define ANZUENDBAR "FRAGGINSDURST_ANZUENDBAR"

inherit ITEMD_SET_PATH "std_set_weapon";

int brennend;

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Fraggins Durst");
  SetProp(P_SET_ITEM, "Fraggins Zuender");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_WC_FIX:5, P_DAM_TYPE:DT_BLUDGEON]),
        1:([P_WC_FIX:10, P_DAM_TYPE:DT_BLUDGEON]),
        2:([P_WC_FIX:20, P_DAM_TYPE:DT_BLUDGEON, 
            P_ZECHPRELLER_BONUS:(["anhauchen":5]),
            ANZUENDBAR:1]),
        3:([P_WC_FIX:25, P_DAM_TYPE:DT_BLUDGEON, 
            P_ZECHPRELLER_BONUS:(["anhauchen":10]),
            ANZUENDBAR:1]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Fraggins Durst", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "kann wie eine Fackel brennen",
        "verbessert Anhauchen", 
        "nuetzt sich weniger ab", "liegt besser in der Hand",
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
   "Fraggins Zuender sieht einem riesigen Tischbein aehnlicher als "
   "einem Streithammer. Dennoch war dieses Tischbein lange Zeit die "
   "Waffe des Zechprellerhelden Fraggin Wirtsschreck. Es heisst, "
   "man koenne den Zuender, wie eine Fackel anzuenden." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"zuender", "fraggins zuender", "fackel"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_WC, 220);
  SetProp(P_WC_FIX, 5);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD: 95, MAT_ALCOHOL:5]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WIELD_RESTRICTIONS, ([A_CON:16, A_STR:15]) );
  SetProp(ANZUENDBAR, 0);

  AddCmd( ({"zuend", "zuende"}), "cmd_anzuenden");
  AddCmd( ({"loesch", "loesche"}), "cmd_loeschen");
}

int _query_lighted()
{
  return brennend;
}

int cmd_loeschen(string str)
{
  notify_fail("Was moechtest zu loeschen?\n");
  if(!str || str == "") return 0;
  if(!(str == "zuender" ||
       str == "fraggins zuender")) return 0;

  if(!brennend)
  {
    write("Fraggins Zuender brennt gar nicht!\n");
    return -1;
  }

  write("Du loeschst Fraggins Zuender.\n");
  say(TPN+" loescht Fraggins Zuender.\n");
  
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LIGHT, 0);
  brennend=0;
  return 1;
}

int cmd_anzuenden(string str)
{
  notify_fail("Was moechtest zu anzuenden?\n");
  if(!str || str == "") return 0;
  if(!(str == "zuender" ||
       str == "fraggins zuender")) return 0;

  if(!QueryProp(ANZUENDBAR))
  {
    write("Fraggins Zuender ist noch nicht maechtig genug!\n");
    return -1;
  }
  if(brennend)
  { 
     write("Fraggins Zuender brennt schon!\n");
     return -1;
  }
  if(TP->QueryProp(P_SP) < 5)
  {
    write("Du hast zu wenig Magiepunkte.\n");
    return -1;
  }  

  write(BS("Fraggins Zuender flammt mit einer gruenen Flamme auf."));
  say(TPN+" zuendet Fraggins Zuender an.\n");
  TP->AddSp(-5);
  
  SetProp(P_SHORT, QueryProp(P_SHORT)+" (brennend)");
  SetProp(P_LIGHT, 1);
  brennend=1;
  return 1;
}

int HitFunc(object enemy)
{
  return 5+2*setmight()*setmight()*(setmight()-1)+random(enemy->QueryProp(P_LEVEL)/2);
}
