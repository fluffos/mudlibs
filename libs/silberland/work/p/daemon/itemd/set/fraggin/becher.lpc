#include "../def.h"
#include "/gilden/zechpreller/zechpreller_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

int times;

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();
  times = 1+random(3);

  SetProp(P_SET, "Fraggins Durst");
  SetProp(P_SET_ITEM, "Fraggins Becher");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_ZECHPRELLER_BONUS:(["trunkspruch":5])]),
        1:([P_ZECHPRELLER_BONUS:(["trunkspruch":5])]),
        2:([P_ZECHPRELLER_BONUS:(["trunkspruch":10])]),
        3:([P_ZECHPRELLER_BONUS:(["trunkspruch":10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Fraggins Durst", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab",
        "verbessert Trunksprueche",
        "kann ausgetrunken werden", 
        "nuetzt sich weniger ab", 
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
   "Fraggins Becher ist ein verbeulter Topfhelm, von dem ein unerhoerter "
   "Schnapsgeruch ausgeht. Bestimmt hat er schon bessere Tage gesehen. "
   "Doch trotz allem merkt man, dass eine uralte Macht in ihm wohnt. Es "
   "heisst Fraggin Wirtsschreck habe aus diesem Helm getrunken." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"becher", "fraggins becher"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_POISON:1, DT_ACID:1]));
  SetProp(P_AC, 11);
  SetProp(P_MATERIAL, ([MAT_STEEL: 95, MAT_ALCOHOL:5]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:15, A_STR:15]) );

  AddCmd( ({"trink", "trinke"}), "cmd_trinken");
}

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if(!str || str == "") return 0;
  if(!(str == "becher" ||
       str == "fraggins becher")) return 0;

  if(times < 1)
  {
    write("Aus dem Becher kommt nix raus!\n");
    return -1;
  }

  write(BS("Du trinkst einen Schluck Schnaps aus Fraggins Becher."));
  say(BS(TPN+" trinkt aus "+QueryProp(P_SET_ITEM)+"."));
  TP->drink_alcohol(50);
  times--;
  return 1;
}

void reset()
{
  ::reset();
  times = 1+random(3);
}
