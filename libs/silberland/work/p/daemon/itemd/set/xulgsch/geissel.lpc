#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit ITEMD_SET_PATH "std_set_weapon";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Xulgsch Daemonen");
  SetProp(P_SET_ITEM, "Xulgsch Geissel");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_DAM_TYPE:({DT_PIERCE}), P_WC_FIX:20, 
          P_NEKRO_BONUS: (["hauch der verwesung":5])]),
        1:([P_DAM_TYPE:({DT_PIERCE}), P_WC_FIX:40, 
           P_NEKRO_BONUS: (["hauch der verwesung":10 ])]),
        2:([P_DAM_TYPE:({DT_PIERCE}), P_WC_FIX:60, 
           P_NEKRO_BONUS: (["hauch der verwesung":20, "all":5])]),
        3:([P_DAM_TYPE:({DT_PIERCE, DT_UNHOLY}), P_WC_FIX:90, 
           P_NEKRO_BONUS: (["hauch der verwesung":30, "all":10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Xulgsch Daemonen", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "liegt besser in der Hand", "verbessert Hauch der Verwesung", 
        "nuetzt sich weniger ab",}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Xulgsch Geissel ist ein Dolch, der durch unheilige Magie belebt wurde. "
    "Die lebende Klinge schwirrt so schnell wie eine Peitsche umher und macht "
    "so eine Verteidigung gegen diese Waffe fast unmoeglich. "
    "Ein Opfer, das mit diesem Dolch getoetet wird, verliert nicht nur sein "
    "Leben sondern auch seine Seele. "
    "Staendig tropft Blut von der Klinge auf den Boden.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"geissel", "xulgsch geissel" }) );

  AddDetail( ({"klinge", "blut"}),
      "Staendig tropft Blut von der Klinge auf den Boden.");

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 123);
  SetProp(P_WC_FIX, 0);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_LIVING: 80, MAT_BLOOD:10, MAT_MISC_UNHOLY:10]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 666);

  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:22]) );
  SetProp(P_HIT_FUNC, TO);
}

int HitFunc(object enemy)
{
  return 5+2*setmight()*setmight()*(setmight()-1)+random(enemy->QueryProp(P_LEVEL)/2);
}
