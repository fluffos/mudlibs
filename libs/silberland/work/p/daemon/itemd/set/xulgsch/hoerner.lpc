#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Xulgsch Daemonen");
  SetProp(P_SET_ITEM, "Xulgsch Hoerner");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:1]), P_NEKRO_SPELLCOST: 2,
          P_NEKRO_BONUS: (["schrecken der finsternis":5]) ]),
        1:([P_M_HEALTH_MOD:([P_HP:3]), P_NEKRO_SPELLCOST: 5,
           P_NEKRO_BONUS: (["schrecken der finsternis":10])]),
        2:([P_M_HEALTH_MOD:([P_HP:9]), P_NEKRO_SPELLCOST: 9,
           P_NEKRO_BONUS: (["schrecken der finsternis":20, "all":5])]),
        3:([P_M_HEALTH_MOD:([P_HP:17]), P_NEKRO_SPELLCOST: 15,
           P_NEKRO_BONUS: (["schrecken der finsternis":30, "all":10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Xulgsch Daemonen", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Lebenspunkte", "verbessert Schrecken der Finsternis",
        "erleichtert unheilige Anrufungen", "nuetzt sich weniger ab",}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Xulgsch Hoerner bestehen quasi nur aus mehreren grossen Hoernern, "
    "die durch ein Eisenband verbunden sind. So macht das ganze den Eindruck "
    "einer Krone. Staendig tropft Blut von den Spitzen der Hoerner zu Boden.");  
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hoerner", "xulgschs hoerner" }) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 11);
  SetProp(P_MATERIAL, ([MAT_HORN: 80, MAT_IRON:15, MAT_BLOOD:5]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 666);
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY:1, DT_TERROR:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:22]) );
}

