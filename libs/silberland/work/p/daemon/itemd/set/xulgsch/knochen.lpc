#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Xulgsch Daemonen");
  SetProp(P_SET_ITEM, "Xulgsch Knochen");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_ATTR_MOD:0, 
            P_NEKRO_BONUS: (["anrufung des kharr-zzteth":5])]),
        1:([P_M_ATTR_MOD:0, 
            P_NEKRO_BONUS: (["anrufung des kharr-zzteth":10])]),
        2:([P_M_ATTR_MOD:([A_INT:1]), 
            P_NEKRO_BONUS: (["anrufung des kharr-zzteth":20, "all":5])]),
        3:([P_M_ATTR_MOD:([A_INT:3]),
            P_NEKRO_BONUS: (["anrufung des kharr-zzteth":30, "all":10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Xulgsch Daemonen", "schuetzt besser",
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht die Intelligenz", "nuetzt sich weniger ab",
        "verbessert Anrufung des Kharr-Zzteth" ,}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Xulgsch Knochen ist ein langer, enger, geschlitzer Lederrock, auf den "
    "viele kleine Fingerknochen aufgenaeht wurden. Das dunkle, blutrote "
    "Leder bildet einen scharfen Kontrast zu den hellweiss polierten Knochen.");  
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"knochen", "xulgsch knochen" }) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, 
      ([MAT_MISC_UNHOLY:5, MAT_BONE:20, MAT_BLOOD:5, MAT_LEATHER:70]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 666);
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY:1, DT_TERROR:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:22]) );

}

