#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Xulgsch Daemonen");
  SetProp(P_SET_ITEM, "Xulgsch Huelle");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_SP:1]), P_TELEPORT_COST: 0,
          P_NEKRO_BONUS: (["unterwerfung der toten":5])]),
        1:([P_M_HEALTH_MOD:([P_SP:3]), P_TELEPORT_COST: 1,
           P_NEKRO_BONUS: (["unterwerfung der toten":10,])]),
        2:([P_M_HEALTH_MOD:([P_SP:9]), P_TELEPORT_COST: 2,
           P_NEKRO_BONUS: (["unterwerfung der toten":20, "all":5])]),
        3:([P_M_HEALTH_MOD:([P_SP:17]), P_TELEPORT_COST: 4,
           P_NEKRO_BONUS: (["unterwerfung der toten":30, "all":10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Xulgsch Daemonen", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Magiepunkte", "verringert die Teleportationskosten",
        "erleichtert die Kontrolle ueber untote Wesen", "nuetzt sich weniger ab",}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Xulgsch Huelle ist ein Panzer, der aus den vielen Rippen der "
    "verschiedensten Rassen besteht. Sie ist von einer daemonischen Macht "
    "besessen, daher tropft staendig Blut zu Boden. Xulgsch konnte sich damit "
    "an jeden beliebigen Ort teleportieren, allerdings benoetigt man dazu "
    "eine gewaltige Menge an Magie. Ausserdem kann man wohl nur zu einem "
    "Ort absoluter Bosheit teleportieren.");  
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"huelle", "xulgsch huelle" }) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 33);
  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:20, MAT_BONE:75, MAT_BLOOD:5]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 666);
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY:1, DT_TERROR:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:22]) );

  AddCmd( ({"teleportiere"}), "cmd_teleport");
}

int cmd_teleport(string str)
{
  if( setmight() < 3 ) 
    return 0;
  if( !QueryProp(P_WORN) )
    return notify_fail("Dazu musst Du Xulgsch Huelle auch tragen!\n"),0;
  if( TP->QueryProp(P_SP) < 400 )
    return  notify_fail("Dazu hast du zu wenig Magiepunkte!\n"),0;
  if( !str || (strstr(str, "nekromanten") == -1 && strstr(str, "xarfai") == -1) )
    return notify_fail("Dorthin kannst Du nicht teleportieren!\n"),0;
  if( TP->InFight() )
    return notify_fail("Im Kampf geht das nicht!\n"),0;
  if( time()-TP->QueryProp(P_LAST_DAMTIME) < 60 )
    return notify_fail("So kurz nach dem Kampf geht das nicht!"),0;
  TP->move("/gilden/nekromanten", M_TPORT);
  TP->Set(P_SP, 0); // Nur eine reportmeldung
  TP->AddHp(-200);
  TP->SetProp(P_MV, 0);
  TP->SetProp(P_NEXT_SPELL_TIME, time()+3*60);
  return 1;
}
