#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Miras Verteidigung");
  SetProp(P_SET_ITEM, "Miras Aura");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:1,P_SP:1])]),
        1:([P_M_HEALTH_MOD:([P_HP:2,P_SP:2])]),
        2:([P_M_HEALTH_MOD:([P_HP:3,P_SP:3])]),
        3:([P_M_HEALTH_MOD:([P_HP:4,P_SP:4])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Miras Verteidigung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab", "nutzt sich viel langsamer ab", 
        "erhoeht Lebenspunkte und Magiepunkte" }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Miras Aura ist ein Umhang aus feinster Seide, der von einer "
    "schuetzenden Aura umgeben ist. Diese Aura hat sicher Mira bei ihren "
    "vielen Kaempfen gut beschuetzt." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"aura", "miras aura" }) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_SILK: 100]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 7000);
  SetProp(P_QUALITY_DECAY, 700);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:15, A_STR:15]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 1 + setmight()*setmight()/2;
}

