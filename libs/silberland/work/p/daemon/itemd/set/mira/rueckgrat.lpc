#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Miras Verteidigung");
  SetProp(P_SET_ITEM, "Miras Rueckgrat");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:1,P_SP:1]), "paladin_spellcost":1]),
        1:([P_M_HEALTH_MOD:([P_HP:2,P_SP:2]), "paladin_spellcost":3]),
        2:([P_M_HEALTH_MOD:([P_HP:3,P_SP:3]), "paladin_spellcost":7]),
        3:([P_M_HEALTH_MOD:([P_HP:4,P_SP:4]), "paladin_spellcost":12]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Miras Verteidigung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab", "erleichtert Gebete zu Dusty", 
        "erhoeht Lebenspunkte und Magiepunkte",
        "schuetzt besser", "nutzt sich viel langsamer ab" }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Miras Rueckgrat ist ein ganz besonders wirkungsvoller Koerperschutz. "
    "Es schaut aus wie ein Schuppenpanzer, schuetzt aber wesentlich besser. "
    "Die Schuppen bestehen aus schimmerndem Mithril und sind sicher noch "
    "zusaetzlich magisch verstaerkt." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"rueckgrat", "miras rueckgrat" }) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 35);
  SetProp(P_MATERIAL, ([MAT_MITHRIL: 90, MAT_MISC_MAGIC:10]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 7000);
  SetProp(P_QUALITY_DECAY, 700);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:15, A_STR:15]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 1 + 2*setmight();
}

