#include "../def.h"

inherit ITEMD_SET_PATH "std_set_weapon";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Arcons Verbannung");
  SetProp(P_SET_ITEM, "Arcons Klinge");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_WC_FIX:10, P_DAM_TYPE:DT_SLASH]),
        1:([P_WC_FIX:25, P_DAM_TYPE:DT_SLASH]),
        2:([P_WC_FIX:45, P_DAM_TYPE:DT_SLASH]),
        3:([P_WC_FIX:70, P_DAM_TYPE:({DT_SLASH, DT_HOLY})]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Arcons Verbannung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "kann nur von guten Wesen verwendet werden",
        "schuetzt vor dem Boesen", "macht mehr Schaden auf Daemonen",
        "nuetzt sich weniger ab", "liegt besser in der Hand", 
        "macht zusaetzlichen Schaden",
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
   "Arcons Klinge ist ein wunderbar verziertes Langschwert, das eine heilige "
   "Aura verstroemt. Solch eine Waffe ist eines Paladins wuerdig! Auf Daemonen "
   "scheint es diese Klinge ganz besonders abgesehen zu haben, nicht umsonst ist "
   "Arcon als groesster Daemonenvernichter der Geschichte bekannt." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"klinge", "arcons klinge"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_WC, 185);
  SetProp(P_WC_FIX, 10);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL: 95, MAT_MISC_HOLY:5]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:10, A_STR:10, SR_BAD:300]) );
}

int HitFunc(object enemy)
{
  int bonus, m2;
  string x;
  m2=setmight()*setmight();
  if(QueryProp(P_WIELDED)->QueryProp(P_ALIGN)>0)
  {
    switch(setmight())
    {
      case 0:
      case 1: x=""; break;
      case 2: x="1";break;
      case 3: x="2"; break;
    } 
    // 15%, 33%, 50%, 87%
    if(enemy->is_class_member(CL_DEMON) && 5+(5+setmight())*setmight()>random(33))
       return call_other(FUNDIR+"hitfuncdemon"+x, "HitFunc", enemy);
    // 5,11,19,29 %
    else if(5+(5+setmight())*setmight()>random(100))
      return call_other(FUNDIR+"hitfuncholy"+x, "HitFunc", enemy);
    else if(enemy->QueryProp(P_ALIGN)>random(333) )
      return -random(200);
  }
  else
    return DoUnwield(),-300;
  return m2;
}

