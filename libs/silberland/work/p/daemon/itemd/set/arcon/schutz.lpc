#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Arcons Verbannung");
  SetProp(P_SET_ITEM, "Arcons Schutz");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_ATTR_MOD:0, "paladin_spellcost":2]),
        1:([P_M_ATTR_MOD:0, "paladin_spellcost":5]),
        2:([P_M_ATTR_MOD:0, "paladin_spellcost":9]),
        3:([P_M_ATTR_MOD:([A_STR:1,A_INT:1,A_DEX:1,A_CON:1]), "paladin_spellcost":15]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Arcons Verbannung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab", "nuetzt sich weniger ab", 
        "kann nur von guten Wesen verwendet werden", 
        "erleichtert Gebete zu Dusty", "schuetzt vor dem Boesen", 
        "erhoeht die Attribute"}) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Arcons Schutz sieht auf den ersten Blick aus wie ein normaler "
    "Kettenpanzer, wie er von Paladinen gerne getragen wird. Auf den "
    "zweiten Blick erkennt man die vielen winzigen Bannzeichen auf den "
    "Kettengliedern, die Daemonen abwehren sollen. Jetzt verstehst Du "
    "auch, warum Arcons als groesster Daemonenjaeger der Geschichte gilt, "
    "denn mit diesem Panzer ueberlebt man sicher laenger im Kampf gegen "
    "die Daemonenbrut." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"schutz", "arcons schutz" }) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 31);
  AddProp(P_DAM_PROTECTION, ([DT_TERROR:1, DT_UNHOLY:1]) );
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10, A_STR:10, SR_BAD:300]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  int bonus, m2;
  bonus=0;
  m2=setmight()*setmight();
  if(QueryProp(P_WORN)->QueryProp(P_ALIGN)>0 && objectp(enemy))
  {
    if(enemy->is_class_member(CL_DEMON))
      return m2+4*(setmight()+1); // 4,10,16,25
    else if(enemy->QueryProp(P_ALIGN)<-500)
      return random(m2-enemy->QueryProp(P_ALIGN)/250);
    else if(enemy->QueryProp(P_ALIGN)>500)
      return -random(15-m2);
  }
  else
    return DoUnwear(),-30;
  return m2;
}

