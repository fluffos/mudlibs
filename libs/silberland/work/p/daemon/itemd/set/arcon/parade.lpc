#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Arcons Verbannung");
  SetProp(P_SET_ITEM, "Arcons Parade");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_LIGHT:0, P_PALADIN_SCHILDPARADE_AC:2]),
        1:([P_LIGHT:0, P_PALADIN_SCHILDPARADE_AC:5]),
        2:([P_LIGHT:1, P_PALADIN_SCHILDPARADE_AC:8]),
        3:([P_LIGHT:2, P_PALADIN_SCHILDPARADE_AC:13]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Arcons Verbannung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab",
        "kann nur von guten Wesen verwendet werden",
        "schuetzt vor dem Boesen", "leuchtet im Dunkeln", "ist besonders gut "
        "fuer Schildparade geeignet", "nuetzt sich weniger ab", 
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
   "Arcons Parade ist ein grosses Turmschild, wie es sonst Paladine oft "
   "verwenden. In der Mitte des Schildes befindet sich gefrorenes Licht, "
   "das zu Leuchten beginnt, wenn andere Teile aus Arcons Verbannung in "
   "der Naehe sind." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"parade", "arcons parade"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 21);
  SetProp(P_MATERIAL, ([MAT_STEEL: 95, MAT_LIGHT:5]) );
  SetProp(P_WEIGHT, 2200);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10, A_STR:10, SR_BAD:300]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  int m2;
  m2=setmight()*setmight();
  if(QueryProp(P_WORN)->QueryProp(P_ALIGN)>0)
  {
    if(enemy->is_class_member(CL_DEMON))
      return m2+2*(setmight()+1); // 2,5,10,17
    else if(enemy->QueryProp(P_ALIGN)<-500)
      return random(m2-enemy->QueryProp(P_ALIGN)/250);
    else if(enemy->QueryProp(P_ALIGN)>500)
      return -random(15-m2);
  }
  else
    return DoUnwear(),-30;
  return m2;
}


