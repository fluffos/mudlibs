#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Arcons Verbannung");
  SetProp(P_SET_ITEM, "Arcons Visier");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:0]),
        1:([P_M_HEALTH_MOD:([P_HP:1, P_SP:1])]),
        2:([P_M_HEALTH_MOD:([P_HP:3, P_SP:3])]),
        3:([P_M_HEALTH_MOD:([P_HP:11, P_SP:11])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Arcons Verbannung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab",
        "kann nur von guten Wesen verwendet werden",
        "schuetzt vor dem Boesen", "schuetzt die Augen und Ohren",
        "erhoeht Lebenspunkt und Magiepunkte", "nuetzt sich weniger ab", 
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Arcons Visier ist ein Vollhelm, wie er normalerweise von Paladinen "
    "getragen wird. Nur seine hervoragende Machart unterscheidet diesen "
    "Helm von anderen. Er schliesst die Ohren komplett ab und man kann nur "
    "durch einen schmalen Spalt im Visier hindurchsehen, soadass dieser "
   " Helm Deine Augen und Ohren extrem gut schuetzt." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"visier", "arcons visier"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 11);
  AddProp(P_DAM_PROTECTION, ([DT_SOUND:1, DT_LIGHT:1, DT_AIR:1]) );
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10, A_STR:10, SR_BAD:300]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  int m2;
  m2=setmight()*setmight();
  if(QueryProp(P_WORN)->QueryProp(P_ALIGN)>0)
  {
    if(QueryProp(P_WORN)->QueryProp(P_BLIND) && 4+m2*m2>random(100) )
      return QueryProp(P_WORN)->SetProp(P_BLIND, 0),0;
    if(QueryProp(P_WORN)->QueryProp(P_DEAF) && 4+m2*m2>random(100) )
      return QueryProp(P_WORN)->SetProp(P_DEAF, 0),0;
  }
  else
    return DoUnwear(),-30;
  return m2/2;
}

