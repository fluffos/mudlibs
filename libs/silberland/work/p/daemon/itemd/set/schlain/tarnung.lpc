#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Schlains Jagd");
  SetProp(P_SET_ITEM, "Schlains Tarnung");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:1,P_SP:1]), "ranger_bonus": (["all": 0]) ]),
        1:([P_M_HEALTH_MOD:([P_HP:3,P_SP:3]), "ranger_bonus": (["all": 5]) ]),
        2:([P_M_HEALTH_MOD:([P_HP:7,P_SP:7]), "ranger_bonus": (["all": 10]) ]),
        3:([P_M_HEALTH_MOD:([P_HP:13,P_SP:13]), "ranger_bonus": (["all": 20]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Schlains Jagd", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "nuetzt sich weniger ab", "veraendert den Temperaturschutz", 
        "wehrt zusaetzlichen Schaden ab", 
        "erhoeht die Lebenspunkte und Magiepunkte", "veressert die Faehigkeiten eines Waldlaeufers"
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Schlains Tarnung ist ein lederner Umhang, der innen mit weichem Fell "
    "gefuettert ist, was die Kaelte sicherlich ertraeglicher macht. "
    "Aussen ist Tarnung mit gruenen und braunen Farben bemalt. "
    "Durch dieses Fleckenmuster ist man im Wald quasi unsichtbar, davon "
    "kommt wohl auch der Name. Tiere koennen einen schwerer erkennen, was "
    "bei der Jagd ein gewaltiger Vorteil ist. Jetzt ist Dir auch klar, "
    "warum Schlain ein so erfolgreicher Jaeger war, dass seine Taten bis "
    "heute ueberliefert sind.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tarnung", "schlains tarnung"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_LEATHER:80, MAT_PELT:20]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:7, T_HEAT_PROT:1]) );
  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:17, A_DEX:17 ]) );
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int m2;
  m2=1+setmight()*setmight();
  if(m2>random(20))
  {
    if(enemy->is_class_member(CL_ANIMAL) || 
       member( ANIMALS, lower_case(enemy->QueryProp(P_RACE))) )
      return m2*2;
  }
  return setmight();
}
  
