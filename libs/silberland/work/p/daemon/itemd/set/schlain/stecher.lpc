#include "../def.h"

inherit ITEMD_SET_PATH "std_set_weapon";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Schlains Jagd");
  SetProp(P_SET_ITEM, "Schlains Stecher");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_WC_FIX:5, ]),
        1:([P_WC_FIX:20,]),
        2:([P_WC_FIX:40,]),
        3:([P_WC_FIX:65,]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Schlains Jagd", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "nuetzt sich weniger ab", "liegt besser in der Hand",
        "macht mehr Schaden auf Tiere",
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
   "Schlains Stecher ist ein maechtiges Jagdmesser, mit dem man sicher jedes "
   "Tier jagen kann. Die Klinge besteht aus einer flachen Klinge, die "
   "sehr scharf aussieht. An ihrem unteren Ende sind zwei Querstreben angebracht, "
   "damit der Stecher nicht zu weit in das getroffene Wild eindringt. Der "
   "Griff ist mit Fell ueberwickelt. Insgesamt macht diese Waffe eine sehr "
   "noblen Eindruck, wie es von Schlain, dem Jaeger ueberliefert ist."  );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"stecher", "schlains stecher"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_WC, 205);
  SetProp(P_WC_FIX, 5);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL: 25, MAT_OAK:70, MAT_PELT:5]) );
  SetProp(P_WEIGHT, 1900);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 250);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:17, A_DEX:17 ]) );
}

int HitFunc(object enemy)
{
  int bonus, m2;
  string x;
  m2=1+2*setmight()*setmight();
  if(enemy->is_class_member(CL_ANIMAL) || 
      member(ANIMALS,lower_case(enemy->QueryProp(P_RACE)))!=-1)
  {
    return m2*enemy->QueryProp(P_LEVEL)/10;
  }
  return random(m2/2)+m2/2;
}

