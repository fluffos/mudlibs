#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Schlains Jagd");
  SetProp(P_SET_ITEM, "Schlains Koeder");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_ATTR_MOD:0 ]),
        1:([P_M_ATTR_MOD:0 ]),
        2:([P_M_ATTR_MOD:([A_DEX:1]) ]),
        3:([P_M_ATTR_MOD:([A_DEX:3]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Schlains Jagd", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "nuetzt sich weniger ab", "erhoeht die Attribute", 
        "wehrt zusaetzlichen Schaden ab",
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Schlains Koeder ist eine lederne Hose, die auf den ersten Blick "
    "gar nicht so maechtig aussieht. Aber scheinbar ist sie sehr praktisch "
    "fuer das Jagen, sonst haette der beruehmte Jaeger Schlain seinen "
    "'Koeder' nicht staendig getragen.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"koeder", "schlains koeder"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 1400);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:17, A_DEX:17 ]) );
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int m2;
  m2=4+2*setmight()*(setmight()-1);
  if(m2>random(20))
  {
    if(enemy->is_class_member(CL_ANIMAL) || 
       member( ANIMALS, lower_case(enemy->QueryProp(P_RACE))) )
      return m2;
  }
  return setmight();
}
  
