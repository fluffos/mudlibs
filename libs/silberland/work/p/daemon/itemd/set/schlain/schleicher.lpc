#include "../def.h"
#define SNEAK_COST 5

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Schlains Jagd");
  SetProp(P_SET_ITEM, "Schlains Schleicher");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:(["ranger_spellcost":0 ]),
        1:(["ranger_spellcost":5 ]),
        2:(["ranger_spellcost":10 ]),
        3:(["ranger_spellcost":15 ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Schlains Jagd", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "nuetzt sich weniger ab", "ermoeglicht das Schleichen", 
        "wehrt zusaetzlichen Schaden ab", "wiegen weniger",
        "schuetzt vor Paralyse", "erleichtern die Faehigkeiten eines Waldlaeufers"
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Schlains Schleicher sind Mokassins aus weissem Hirschleder. Die Sohlen "
    "sind so weich, dass man damit quasi lautlos schleichen kann, davon kommt "
    "wohl auch der Name. So kommt Schlain sich also auch an das wachsamste "
    "Wild anpirschen und so zu dem legenaersten Jaeger der Geschichte werden..");
  SetProp(P_INFO,
      "Irgendeine Art von Bewegungsmagie scheint auf den Schleichern zu "
      "liegen, denn sie scheinen auch eine staendige Bewegungsfreiheit zu "
      "gewaehrleisten.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"schleicher", "schlains schleicher"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:17, A_DEX:17 ]) );
  AddCmd(({"schleiche", "schleich"}), "schleichen");
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int m2;
  m2=1+2*setmight()*(setmight()-1);
  if(m2>random(15))
  {
    if(QueryProp(P_WORN)->QueryProp(P_PARALYZED) && m2>random(15))
    {
      QueryProp(P_WORN)->SetProp(P_PARALYZED,0);
      return 0;
    }
    if(enemy->is_class_member(CL_ANIMAL) || 
       member(ANIMALS, lower_case(enemy->QueryProp(P_RACE)))!= -1 )
      return m2;
  }
  return setmight();
}
 
int schleichen(string str)
{
  mapping exits,dest;
  string wohin, ret, *ex;
  notify_fail("Du brauchst die ganze Ausruestung von Schlain zum schleichen!\n");
  if(setmight()<3) return 0;
  notify_fail("Wohin willst Du schleichen?\n");
  if(!str || !environment(TP) || 
      !mappingp(exits=environment(TP)->QueryProp(P_NEW_EXITS)))
    return 0;
  ex=m_indices(exits);
  if (sscanf(str,"nach %s",wohin)!=1)
    wohin=str;
  if( member(ex,wohin)==-1) return 0;
  dest=exits[wohin];

  if (closurep(dest[EX_TESTFUNC]) || closurep(dest[EX_FUNC]))
      return write("Dorthin kannst Du nicht schleichen!\n"),1; 
  if (dest[EXG_ID] && present(dest[EXG_ID]) )
  {
    if (dest[EXG_PLMSG])
      write(process_string(dest[EXG_PLMSG]));
    else
      write("Eine unbekannte Kraft haelt Dich zurueck.\n");
    if (dest[EXG_RMMSG])
      say(capitalize(ENV(TP)->substitute_str(process_string(dest[EXG_RMMSG]))));
    return 1;
  }
  if(TP->QueryProp(P_SP)<SNEAK_COST)
    return write("Du hast zu wenig Magiepunkte zum schleichen!\n"),1;
  if (dest[EX_PLMSG]) write(break_string(dest[EX_PLMSG],78,0,1));
  if (!ret) 
    ret=dest[EX_DEST];
  write("Du schleichst "+dest[EX_MSG]+".\n");
  TP->AddSp(-SNEAK_COST);
  TP->move(ret,M_GO|M_SILENT|M_NO_ATTACK,dest[EX_MSG]);
  return 1;
}
