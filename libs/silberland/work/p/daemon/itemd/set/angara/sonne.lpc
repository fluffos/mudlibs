#include "../def.h"
#ifndef P_WORN_LIGHT
#define P_WORN_LIGHT "worn_light"
#endif

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Angaras Geschmeide");
  SetProp(P_SET_ITEM, "Angaras leuchtende Sonne");
  SetProp(P_NR_SET_ITEMS, 3);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0,P_SP:0]), P_WORN_LIGHT:1]),
        1:([P_M_HEALTH_MOD:([P_HP:0,P_SP:3]), P_WORN_LIGHT:2]),
        2:([P_M_HEALTH_MOD:([P_HP:0,P_SP:10]), P_WORN_LIGHT:3]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Angaras Geschmeide", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "leuchtet im Dunkeln", "erhoeht Deine Magiepunkte",
        "nuetzt sich weniger ab", 
        }) );
  SetProp(P_SHORT, "Angaras leuchtende Sonne");
  SetProp(P_LONG,
      "Angaras leuchtende Sonne ist ein strahlend helles Amulett aus purem "
      "Gold, dass an einer ebenso leuchtenden Kette haengt. Eine hochmagische "
      "Aura geht von ihm aus!");
  SetProp(P_NAME, "Angaras leuchtende Sonne");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"sonne","angaras leuchtende Sonne" }) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_GOLD: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_WEAR_TEXT, 
      ({ "Du ziehst %s an und sie beginnt zu leuchten.\n", 
       " zieht %s an und das Amulett beginnt zu leuchten.\n" }));
  SetProp(P_UNWEAR_TEXT, 
      ({ "Du ziehst %s aus und sie verloescht.\n", 
       " zieht %s an und das Amulett verdunkelt sich.\n" }));
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20]) );
}

int _query_light()
{
  if (QueryProp(P_WORN))
    return QueryProp(P_WORN_LIGHT);
  else
    return 0;
}
