#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Angaras Geschmeide");
  SetProp(P_SET_ITEM, "Angaras Siegelring");
  SetProp(P_NR_SET_ITEMS, 3);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0,P_SP:0]),ITEMD_PROB_CHANGE:15]),
        1:([P_M_HEALTH_MOD:([P_HP:0,P_SP:3]),ITEMD_PROB_CHANGE:25]),
        2:([P_M_HEALTH_MOD:([P_HP:0,P_SP:10]),ITEMD_PROB_CHANGE:55]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Angaras Geschmeide", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Magiepunkte", "laesst Dich mehr magische Gegenstaende "
        "finden", "nuetzt sich weniger ab", }) );
  SetProp(P_SHORT, "Angaras Siegelring");
  SetProp(P_LONG,
      "Das ist der Siegelring von Angara. Er weist auf der Oberseite das "
      "Siegel Angaras auf. Eine leuchtende Aura geht von ihm aus.");
  SetProp(P_NAME, "Angaras Siegelring");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"siegelring", "ring", "angaras siegelring" }) );

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_GOLD: 100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20]) );
}

