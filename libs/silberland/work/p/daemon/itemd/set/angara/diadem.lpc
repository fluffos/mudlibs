#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Angaras Geschmeide");
  SetProp(P_SET_ITEM, "Angaras Diadem");
  SetProp(P_NR_SET_ITEMS, 3);
  SetProp(P_SET_BONUS, ([
        0:(["reflect_chance":10]),
        1:(["reflect_chance":30]),
        2:(["reflect_chance":60]),
        ]));
  SetProp("reflect_chance",10);
  SetProp(P_ITEMD, ({"gehoert zu Angaras Geschmeide", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Magiepunkte", "reflektiert Zauber Deiner Feinde",
        "nuetzt sich weniger ab", 
        }) );
  SetProp(P_SHORT, "Angaras Diadem");
  SetProp(P_LONG,
      "Angaras Diadem ist ein erstaunlicher Kopfschmuck. Das Diadem ist "
      "aus purem Gold mit einem eingefassten Diamanten auf der Vorderseite. "
      "Es schimmert in einem magischen Licht!");
  SetProp(P_NAME, "Angaras Diadem");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"diadem","angaras diadem" }) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_GOLD: 90, MAT_DIAMOND:10]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);


  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20]) );
}

int DefendFunc (mixed dam_type, mixed spell, object enemy) {
  object pl;
  int reflect;
  pl=QueryProp(P_WORN); 
  if(mappingp(spell) && member(spell,SI_SKILLDAMAGE) && 
      random(100) < QueryProp("reflect_chance"))
  {
    tell_object(pl, BS(sprintf("%s wirft einen Teil der "
        "magischen Attacke zurueck.", QueryProp(P_NAME))));
    pl->AddSp(-random(2));
    reflect=(int)spell[SI_SKILLDAMAGE]/(3+random(3));

    if(ENV(pl))
      tell_room(ENV(pl), BS(sprintf("%s von %s wirft "
         "einen Teil der magischen Attacke zurueck!", QueryProp(P_NAME),
         pl->name(WEM))), ({pl}));
    enemy->Defend(reflect, dam_type, ([SP_SHOW_DAMAGE: 1, 
         SP_NAME:"angaras diadem"]), pl);

    return (int)(reflect/10);
  } 
  return 0;
}
