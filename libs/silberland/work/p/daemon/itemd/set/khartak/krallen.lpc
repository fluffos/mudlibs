#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Khartaks Kampfgewand");
  SetProp(P_SET_ITEM, "Khartaks Krallen");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0]),P_BERSERKER_BONUS: (["blutrausch":3]) ]),
        1:([P_M_HEALTH_MOD:([P_HP:1]),P_BERSERKER_BONUS: (["blutrausch":10]) ]),
        2:([P_M_HEALTH_MOD:([P_HP:7]),P_BERSERKER_BONUS: (["blutrausch":20, "all":5]) ]),
        3:([P_M_HEALTH_MOD:([P_HP:23]),P_BERSERKER_BONUS: (["blutrausch":30, "all":10]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Khartaks Kampfgewand", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Lebenspunkte", "erhoeht oder erniedrigt Attribute",
        "verbessert den Blutrausch", "nuetzt sich weniger ab",}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Khartaks Krallen sind die Panzerhandschuhe von Khartak, dem legendaeren "
    "Berserkerhelden. Der Name ist nicht unberechtigt, zieren doch spitze "
    "Krallen die Finger dieser Handschuhe.");  
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"krallen", "khartaks krallen" }) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 250);

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );
}

