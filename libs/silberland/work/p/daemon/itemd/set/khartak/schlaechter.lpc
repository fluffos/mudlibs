#include "../def.h"

inherit ITEMD_SET_PATH "std_set_weapon";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Khartaks Kampfgewand");
  SetProp(P_SET_ITEM, "Khartaks Schlaechter");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_ATTR_MOD:0, P_WC_FIX:0, P_BERSERKER_BONUS: (["spalten":3])]),
        1:([P_M_ATTR_MOD:0, P_WC_FIX:15, P_BERSERKER_BONUS: (["spalten":10])]),
        2:([P_M_ATTR_MOD:([A_STR:1]), P_WC_FIX:30, P_BERSERKER_BONUS: (["spalten":20, "all":5])]),
        3:([P_M_ATTR_MOD:([A_STR:3]), P_WC_FIX:50, P_BERSERKER_BONUS: (["spalten":30, "all":10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Khartaks Kampfgewand", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Lebenspunkte", "erhoeht oder erniedrigt Attribute" ,
        "liegt besser in der Hand", "verbessert das Spalten", 
        "nuetzt sich weniger ab",}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Khartaks Schlaechter ist die Kampfaxt von Khartak, dem legendaeren "
    "Berserkerhelden. Sie besteht aus einem hoelzernen Stiel und einem "
    "riesigen doppelbaertigen Axtblatt aus bestem Stahl.") ;  
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"schlaechter", "khartaks schlaechter" }) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_WC, 234);
  SetProp(P_WC_FIX, 0);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL: 40, MAT_OAK:60]) );
  SetProp(P_WEIGHT, 6500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 250);

  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:15]) );
  SetProp(P_HIT_FUNC, TO);
}

int HitFunc(object enemy)
{
  return 5+2*setmight()*setmight()*(setmight()-1)+random(enemy->QueryProp(P_LEVEL)/2);
}
