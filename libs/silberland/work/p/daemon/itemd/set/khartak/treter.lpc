#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Khartaks Kampfgewand");
  SetProp(P_SET_ITEM, "Khartaks Treter");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_EFFECTIVE_WC:20, P_BERSERKER_BONUS: (["zertreten":5]) ]),
        1:([P_EFFECTIVE_WC:60, P_BERSERKER_BONUS: (["zertreten":10]) ]),
        2:([P_EFFECTIVE_WC:120, P_BERSERKER_BONUS: (["zertreten":20, "all":5])]),
        3:([P_EFFECTIVE_WC:240, P_BERSERKER_BONUS: (["zertreten":30, "all":10]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Khartaks Kampfgewand", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Lebenspunkte", "erhoeht oder erniedrigt Attribute",
        "verbessert das Zertreten", "nuetzt sich weniger ab",}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Khartaks Treter sind die Eisenschuhe von Khartak, dem legendaeren "
    "Berserkerhelden. Sie haben gewaltige Stacheln auf der Sohle, die beim "
    "Zertreten sicher hoellischen Schaden machen.");  
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"treter", "khartaks treter" }) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_STEEL: 30, MAT_LEATHER:70]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 250);

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );
}

