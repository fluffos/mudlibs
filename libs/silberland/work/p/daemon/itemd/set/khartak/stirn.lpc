#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Khartaks Kampfgewand");
  SetProp(P_SET_ITEM, "Khartaks Stirn");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_EFFECTIVE_WC:20, P_BERSERKER_BONUS: (["kopfstoss":5]) ]),
        1:([P_EFFECTIVE_WC:60, P_BERSERKER_BONUS: (["kopfstoss":10]) ]),
        2:([P_EFFECTIVE_WC:120, P_BERSERKER_BONUS: (["kopfstoss":20, "all":5]) ]),
        3:([P_EFFECTIVE_WC:240, P_BERSERKER_BONUS: (["kopfstoss":30, "all":10]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Khartaks Kampfgewand", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "verbessert die Faehigkeiten eines Berserkers",
        "verbessert den Kopfstoss", "nuetzt sich weniger ab",}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Khartaks Stirn heisst der gehoernte Helm von Khartak, dem legendaeren "
    "Berserkerhelden. Sie hat gewaltige Stacheln, die beim Kopfstoss "
    "sicher hoellischen Schaden machen.");  
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stirn", "khartaks stirn" }) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 13);
  SetProp(P_MATERIAL, ([MAT_STEEL: 100]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 250);

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );
}

