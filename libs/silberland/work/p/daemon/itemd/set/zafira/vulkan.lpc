#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Zafiras Elementare Vollendung");
  SetProp(P_SET_ITEM, "Zafiras Vulkan");
  SetProp(P_NR_SET_ITEMS, 6);
  SetProp(P_SET_BONUS, ([
        0:([P_LIGHT:0,  P_ITEMD_ELEMENTAL_VALUE: ([FEUER:1]) ]),
        1:([P_LIGHT:0,  P_ITEMD_ELEMENTAL_VALUE: ([FEUER:3]) ]),
        2:([P_LIGHT:1,  P_ITEMD_ELEMENTAL_VALUE: ([FEUER:5]) ]),
        3:([P_LIGHT:1,  P_ITEMD_ELEMENTAL_VALUE: ([FEUER:8]) ]),
        4:([P_LIGHT:1,  P_ITEMD_ELEMENTAL_VALUE: ([FEUER:13]) ]),
        5:([P_LIGHT:2,  P_ITEMD_ELEMENTAL_VALUE: ([FEUER:20]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Zafiras elementarer Vollendung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "leuchtet im Dunkeln", "verringert die Kosten aller Feuerzauber", 
        "nuetzt sich weniger ab", "veraendert den Temperaturschutz", 
        "wehrt zusaetzlichen Schaden ab", "ist leichter",
        "ermoeglicht die Beherrschung von Feuerelementaren", 
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Zafiras Vulkan ist ein Amulett in der Form eines kleinen Vulkans. "
      "Manchmal sieht man sogar Lava darin gluehen oder kleine Rauchfahnen "
      "steigen daraus auf. Fast koennte man glauben, es handelt sich um einen "
      "echten Vulkan, nur in Miniaturformat. Nur Zafira mit ihrer vollendeten "
      "Beherrschung der Elemente konnte solch einen Gegenstand erschaffen.");
  SetProp(P_INFO,
      "Hier scheint die elementare Gewalt des Feueres direkt in einen "
      "Gegenstand gebannt zu sein. Sicher lassen sich damit Feuerwesen zu "
      "Diensten zwingen. Auch eine gewissen Schutzwirkung gegen Feuer "
      "wird vorhanden sein.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"vulkan", "zafiras vulkan", ELEMENT_RING_FEUER}) );

  AddDetail( ({"lava"}), 
      "Da ist wirklich Lava in diesem Amulett!!");
  AddDetail( ({"rauch", "rauchfahne", "rauchfahnen"}),
      "Ab und zu steigt eine Rauchfahne aus Zafiras Vulkan auf.");

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_FIRE: 100]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:-1]) );
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:25]) );
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  if( member( dam_type, DT_FIRE)!=-1)
    return random(5+2*setmight()*setmight());
  else
    return 0;
}

int check_equip_time() 
{
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}
