#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Zafiras Elementare Vollendung");
  SetProp(P_SET_ITEM, "Zafiras Sturm");
  SetProp(P_NR_SET_ITEMS, 6);
  SetProp(P_SET_BONUS, ([
        0:([P_ITEMD_ELEMENTAL_VALUE: ([LUFT:1]), P_M_HEALTH_MOD: ([P_SP:1]) ]),
        1:([P_ITEMD_ELEMENTAL_VALUE: ([LUFT:3]), P_M_HEALTH_MOD: ([P_SP:3])  ]),
        2:([P_ITEMD_ELEMENTAL_VALUE: ([LUFT:5]), P_M_HEALTH_MOD: ([P_SP:5])  ]),
        3:([P_ITEMD_ELEMENTAL_VALUE: ([LUFT:8]), P_M_HEALTH_MOD: ([P_SP:11])  ]),
        4:([P_ITEMD_ELEMENTAL_VALUE: ([LUFT:13]), P_M_HEALTH_MOD: ([P_SP:17]) ]),
        5:([P_ITEMD_ELEMENTAL_VALUE: ([LUFT:20]), P_M_HEALTH_MOD: ([P_SP:29]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Zafiras elementarer Vollendung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Deine Magiepunkte", "frischt Deine Magiepunkte auf",
        "verringert die Kosten aller Luftzauber", "nuetzt sich weniger ab", 
        "veraendert den Temperaturschutz", 
        "wehrt zusaetzlichen Schaden ab", "ist leichter",
        "ermoeglicht die Beherrschung von Luftelementaren", 
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Zafiras Sturm ist eine Hose die vollkommen aus Luft besteht. Die "
      "Hosenbeine schauen fast aus wie zwei kleine Tornados. Trotz dieser "
      "Luftigkeit scheint Zafiras Sturm doch einen ganz guten Schutz zu "
      "bieten. Nur Zafira mit ihrer vollendeten "
      "Beherrschung der Elemente konnte solch einen Gegenstand erschaffen.");
  SetProp(P_INFO,
      "Hier scheint die elementare Gewalt der Luft direkt in einen "
      "Gegenstand gebannt zu sein. Sicher lassen sich damit Luftwesen zu "
      "Diensten zwingen. Auch eine gewissen Schutzwirkung gegen Luft "
      "wird vorhanden sein.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"sturm", "zafiras sturm", ELEMENT_RING_LUFT}) );

  AddDetail( ({"luft"}), 
      "Unglaublich, aber war: Diese Hose besteht eigentlich nur aus Luft!!");
  AddDetail( ({"luftwirbel", "tornado", "tornados"}),
      "Die Hosenbeine von Zafiras Sturm schauen aus wie zwei Luftwirbel oder "
      "Tornados.");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_AIR: 100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:1]) );
  AddProp(P_DAM_PROTECTION, ([DT_AIR:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:25]) );
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  if( member( dam_type, DT_AIR)!=-1)
    return random(5+2*setmight()*setmight());
  else
    return 0;
}

int check_equip_time() 
{
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}

void reset()
{
  object pl;
  if( !is_clone(this_object()) ) return;
  ::reset();
  if( (pl=QueryProp(P_WORN)) && setmight()*setmight()>random(25) &&
     pl->QueryProp(P_SP)<pl->QueryProp(P_MAX_SP) )
  {
    tell_object(pl, 
        "Die Macht von Zafiras Sturm frischt Deine Magiepunkte auf.\n");
    pl->AddSp(20+(5+random(10*setmight()))*setmight());
  }
}
