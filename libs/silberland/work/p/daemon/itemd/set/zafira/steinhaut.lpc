#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Zafiras Elementare Vollendung");
  SetProp(P_SET_ITEM, "Zafiras Steinhaut");
  SetProp(P_NR_SET_ITEMS, 6);
  SetProp(P_SET_BONUS, ([
        0:([P_ITEMD_ELEMENTAL_VALUE: ([ERZ:1]) ]),
        1:([P_ITEMD_ELEMENTAL_VALUE: ([ERZ:3]) ]),
        2:([P_ITEMD_ELEMENTAL_VALUE: ([ERZ:5]) ]),
        3:([P_ITEMD_ELEMENTAL_VALUE: ([ERZ:8]) ]),
        4:([P_ITEMD_ELEMENTAL_VALUE: ([ERZ:13]) ]),
        5:([P_ITEMD_ELEMENTAL_VALUE: ([ERZ:20]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Zafiras elementarer Vollendung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "verringert die Kosten aller Erzzauber", 
        "nuetzt sich weniger ab", "veraendert den Temperaturschutz", 
        "wehrt zusaetzlichen Schaden ab", "ist leichter",
        "ermoeglicht die Beherrschung von Erzementaren",
        "schuetzt vor Versteinerung", 
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Zafiras Steinhaut ist ein Umhang der aus magischem Stein besteht. "
      "Ganz anders als normaler Stein ist die Steinhaut sehr anschmiegsam "
      "und trotzdem steinhart. Nur Zafira mit ihrer vollendeten "
      "Beherrschung der Elemente konnte solch einen Gegenstand erschaffen.");
  SetProp(P_INFO,
      "Hier scheint die elementare Gewalt des Erzes direkt in einen "
      "Gegenstand gebannt zu sein. Sicher lassen sich damit Erzwesen zu "
      "Diensten zwingen. Auch eine gewissen Schutzwirkung gegen Erz "
      "wird vorhanden sein.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"steinhaut", "zafiras steinhaut", ELEMENT_RING_ERZ}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_STONE: 100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5, T_HEAT_PROT:0]) );
  AddProp(P_DAM_PROTECTION, ([DT_MAGIC:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:25]) );
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  int m2;
  m2=1+2*setmight()*setmight();
  if(QueryProp(P_WORN)->QueryProp(P_PARALYZED) && m2>random(77))
  {
    QueryProp(P_WORN)->SetProp(P_PARALYZED,0);
  }
  return 0;
}

int check_equip_time() 
{
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}
