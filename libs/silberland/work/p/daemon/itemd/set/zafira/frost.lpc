#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Zafiras Elementare Vollendung");
  SetProp(P_SET_ITEM, "Zafiras Frost");
  SetProp(P_NR_SET_ITEMS, 6);
  SetProp(P_SET_BONUS, ([
        0:([P_ITEMD_ELEMENTAL_VALUE: ([EIS:1]) ]),
        1:([P_ITEMD_ELEMENTAL_VALUE: ([EIS:3]) ]),
        2:([P_ITEMD_ELEMENTAL_VALUE: ([EIS:5]) ]),
        3:([P_ITEMD_ELEMENTAL_VALUE: ([EIS:8]) ]),
        4:([P_ITEMD_ELEMENTAL_VALUE: ([EIS:13]) ]),
        5:([P_ITEMD_ELEMENTAL_VALUE: ([EIS:20]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Zafiras elementarer Vollendung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "verringert die Kosten aller Eiszauber", 
        "nuetzt sich weniger ab", "veraendert den Temperaturschutz", 
        "wehrt zusaetzlichen Schaden ab", "ist leichter",
        "ermoeglicht die Beherrschung von Eiselementaren", 
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Zafrias Frost ist ein Guertel aus reinem Eis. "
      "Nur Zafira mit ihrer vollendeten Beherrschung der Elemente konnte "
      "solch einen Gegenstand erschaffen.");
  SetProp(P_INFO,
      "Hier scheint die elementare Gewalt des Eises direkt in einen "
      "Gegenstand gebannt zu sein. Sicher lassen sich damit Eiswesen zu "
      "Diensten zwingen. Auch eine gewissen Schutzwirkung gegen Eis und "
      "Kaelte wird vorhanden sein.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"frost", "zafiras frost", ELEMENT_RING_EIS}) );

  AddDetail( ({"eis"}), 
      "Der Guertel ist wirklich aus Eis! *brrrr*");

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_ICE: 100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-1, T_HEAT_PROT:4]) );
  AddProp(P_DAM_PROTECTION, ([DT_COLD:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:25]) );
  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  int m2;
  m2=1+2*setmight()*setmight();
  if( m2>random(300)+8 )
  {
    tell_room( ENV(enemy), BS(enemy->Name(WER)+" beruehrt "+
          QueryProp(P_NAME)+ " und wird eingefroren."));
    tell_object(enemy, BS("Du beruehrst "+
          QueryProp(P_NAME)+ " und wirst eingefroren."));
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(2*setmight()/3) );
    return 0;
  }
  if( member( dam_type, DT_COLD)!=-1)
    return random(m2); 
  return 0;
}

int check_equip_time() 
{
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}
