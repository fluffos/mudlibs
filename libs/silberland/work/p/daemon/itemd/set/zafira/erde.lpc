#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Zafiras Elementare Vollendung");
  SetProp(P_SET_ITEM, "Zafiras Erde");
  SetProp(P_NR_SET_ITEMS, 6);
  SetProp(P_SET_BONUS, ([
        0:([P_ITEMD_ELEMENTAL_VALUE: ([HUMUS:1]), P_M_HEALTH_MOD: ([P_HP:0]) ]),
        1:([P_ITEMD_ELEMENTAL_VALUE: ([HUMUS:3]), P_M_HEALTH_MOD: ([P_HP:2]) ]),
        2:([P_ITEMD_ELEMENTAL_VALUE: ([HUMUS:5]), P_M_HEALTH_MOD: ([P_HP:4]) ]),
        3:([P_ITEMD_ELEMENTAL_VALUE: ([HUMUS:8]), P_M_HEALTH_MOD: ([P_HP:7]) ]),
        4:([P_ITEMD_ELEMENTAL_VALUE: ([HUMUS:13]), P_M_HEALTH_MOD: ([P_HP:13]) ]),
        5:([P_ITEMD_ELEMENTAL_VALUE: ([HUMUS:20]), P_M_HEALTH_MOD: ([P_HP:19]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Zafiras elementarer Vollendung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Deine Lebenspunkte", "kann Dich heilen",
        "verringert die Kosten aller Humuszauber", "nuetzt sich weniger ab", 
        "veraendert den Temperaturschutz", "schuetzt Dich vor Gift",
        "wehrt zusaetzlichen Schaden ab", "ist leichter",
        "ermoeglicht die Beherrschung von Humuselementaren", 
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Zafiras Erde ist ein Ring, der vollkommen aus Erde besteht. "
      "Nur Zafira mit ihrer vollendeten "
      "Beherrschung der Elemente konnte solch einen Gegenstand erschaffen.");
  SetProp(P_INFO,
      "Hier scheint die elementare Gewalt des Humus direkt in einen "
      "Gegenstand gebannt zu sein. Sicher lassen sich damit Erdwesen zu "
      "Diensten zwingen. Auch eine gewissen Schutzwirkung gegen Gift "
      "wird vorhanden sein.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"erde", "zafiras erde", ELEMENT_RING_HUMUS}) );

  AddDetail( ({"erde"}), 
      "Unglaublich, aber war: Dieser Ring besteht eigentlich nur aus Erde!!");

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_EARTH: 100]) );
  SetProp(P_WEIGHT, 7);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1, T_HEAT_PROT:1]) );
  AddProp(P_DAM_PROTECTION, ([DT_POISON:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:25]) );
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  if( member( dam_type, DT_POISON)!=-1)
    return random(5+2*setmight()*setmight());
  else
    return 0;
}

int check_equip_time() 
{
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}

void reset()
{
  object pl;
  if( !is_clone(this_object()) ) return;
  ::reset();
  if( (pl=QueryProp(P_WORN)) && interactive(pl) && 
      setmight()*setmight()>random(25) && 
     pl->QueryProp(P_HP)<pl->QueryProp(P_MAX_HP) )
  {
    tell_object(pl, "Die Macht von Zafiras Erde heilt Dich.\n");
    pl->AddHp(20+(5+random(10*setmight()))*setmight());
  }
}

int WearFunc(object ob, int silent) 
{
  MENV->AddHpHook(ME);
  return ::WearFunc(ob,silent);
}

int RemoveFunc(object ob, int silent) 
{
  QueryProp(P_WORN)->RemoveHpHook(ME);
  return ::RemoveFunc(ob,silent);
}

void NotifyHpChange() 
{
  object pl;
  pl=QueryProp(P_WORN);
  if( pl && pl->QueryProp(P_POISON) && 1+setmight()*setmight()>random(100) )
  {
    pl->AddPoison(-1-random(setmight()));
    pl->AddSp(-random(10));
    tell_object(pl, "Die Macht von Zafiras Erde entgiftet Dich "+
        (pl->QueryProp(P_POISON)?"ein wenig":"voellig")+".\n");
  }
  return ;
}
