#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

int query_meth=0;

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Zafiras Elementare Vollendung");
  SetProp(P_SET_ITEM, "Zafiras Flutwelle");
  SetProp(P_NR_SET_ITEMS, 6);
  SetProp(P_SET_BONUS, ([
        0:([P_ITEMD_ELEMENTAL_VALUE: ([WASSER:1]), P_DRUID_ADD_HAND_DAMAGE:1 ]),
        1:([P_ITEMD_ELEMENTAL_VALUE: ([WASSER:3]), P_DRUID_ADD_HAND_DAMAGE:3 ]),
        2:([P_ITEMD_ELEMENTAL_VALUE: ([WASSER:5]), P_DRUID_ADD_HAND_DAMAGE:6 ]),
        3:([P_ITEMD_ELEMENTAL_VALUE: ([WASSER:8]), P_DRUID_ADD_HAND_DAMAGE:13 ]),
        4:([P_ITEMD_ELEMENTAL_VALUE: ([WASSER:13]), P_DRUID_ADD_HAND_DAMAGE:27 ]),
        5:([P_ITEMD_ELEMENTAL_VALUE: ([WASSER:20]), P_DRUID_ADD_HAND_DAMAGE:44 ]),
        ]));
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, WASSER );
  SetProp(P_ITEMD, ({"gehoert zu Zafiras elementarer Vollendung", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "verbessert den Handkampf", "laesst Dich mehr Fluessigkeit trinken", 
        "verringert die Kosten aller Wasserzauber", "nuetzt sich weniger ab", 
        "veraendert den Temperaturschutz", 
        "wehrt zusaetzlichen Schaden ab", "ist leichter",
        "ermoeglicht die Beherrschung von Wasserelementaren", 
        }) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
      "Zafiras Flutwelle ist ein Paar Handschuhe aus Wasser. Das Wasser ist "
      "staendig in Bewegung, sodass es aussieht, als wuerden staendig kleine "
      "Wellen ueber die Finger laufen. Nur Zafira mit ihrer vollendeten "
      "Beherrschung der Elemente konnte solch einen Gegenstand erschaffen.");
  SetProp(P_INFO,
      "Hier scheint die elementare Gewalt des Wassers direkt in einen "
      "Gegenstand gebannt zu sein. Sicher lassen sich damit Wasserwesen zu "
      "Diensten zwingen. Auch eine gewissen Schutzwirkung gegen Wasser "
      "wird vorhanden sein.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM)); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"flutwelle", "zafiras flutwelle", ELEMENT_RING_WASSER}) );

  AddDetail( ({"wasser"}), 
      "Diese Handschuhe bestehen wirklich aus Wasser!!");
  AddDetail( ({"welle", "wellen"}),
      "Kleine Wellen halten das Wasser von Zafiras Flutwelle staendig in "
      "Bewegung.");

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_WATER: 100]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:1]) );
  AddProp(P_DAM_PROTECTION, ([DT_WATER:1]) );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:25]) );
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  if( member( dam_type, DT_WATER)!=-1)
    return random(5+2*setmight()*setmight());
  else
    return 0;
}

int check_equip_time() 
{
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}

void reset()
{
  object pl;
  if( !is_clone(this_object()) ) return;
  ::reset();
  if( (pl=QueryProp(P_WORN)) && interactive(pl) )
    if (setmight()*setmight()>random(25) )
    {
      tell_object(pl, "Die Macht von Zafiras Flutwelle macht Dich durstiger.\n");
      pl->SetProp(P_DRINK, pl->QueryProp(P_DRINK)-2*setmight()*setmight());
    }
    else
    {
      tell_object(pl, "Die Macht von Zafiras Flutwelle loescht Deinen Durst.\n");
      pl->SetProp(P_DRINK, pl->QueryProp(P_DRINK)+random(50));
    }
}

int WearFunc(object ob, int silent) 
{
  if(!MENV->Query(P_DRINK_DELAY,F_QUERY_METHOD))
  {
    MENV->Set(P_DRINK_DELAY, symbol_function("delay", TO), F_QUERY_METHOD);
    query_meth=1;
  }
  return ::WearFunc(ob,silent);
}

int RemoveFunc(object ob, int silent) 
{
  if( query_meth)
  {
    QueryProp(P_WORN)->Set(P_DRINK_DELAY, 0, F_QUERY_METHOD);
    query_meth=0;
  }
  return ::RemoveFunc(ob,silent);
}

int delay()
{
  return QueryProp(P_WORN)->Query(P_DRINK_DELAY)-setmight();
}

