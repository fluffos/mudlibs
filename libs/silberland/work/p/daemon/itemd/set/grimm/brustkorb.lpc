#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Grimms Koerper");
  SetProp(P_SET_ITEM, "Grimms Brustkorb");
  SetProp(P_NR_SET_ITEMS, 5);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:1,P_SP:0]), P_BERSERKER_BONUS: 0]),
        1:([P_M_HEALTH_MOD:([P_HP:2,P_SP:1]), P_BERSERKER_BONUS: (["all":2]) ]),
        2:([P_M_HEALTH_MOD:([P_HP:3,P_SP:2]), P_BERSERKER_BONUS: (["all":7]) ]),
        3:([P_M_HEALTH_MOD:([P_HP:4,P_SP:3]), P_BERSERKER_BONUS: (["all":15]) ]),
        4:([P_M_HEALTH_MOD:([P_HP:5,P_SP:4]), P_BERSERKER_BONUS: (["all":30]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Grimms Koerper", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab", "nuetzt sich weniger ab", 
        "erhoeht Lebenspunkte und Magiepunkte", 
        "verbessert die Faehigkeiten eines Berserkers"
        }) );

  SetProp(P_SHORT, "Grimms Brustkorb");
  SetProp(P_LONG,
    "Das ist der Brustkorb von Grimm, dem Riesen. Die Rippen sind so "
    "ineinander verwachsen, dass man ihn sehr gut als Ruestung verwenden "
    "kann. Vielleicht verleiht er Dir auch die gleiche gewaltige Kraft "
    "von Grimm, wenn Du noch die anderen Teile seines Koerpers findest." );
  SetProp(P_NAME, "Grimms Brustkorb");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"brustkorb", "grimms brustkorb" }) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 35);
  SetProp(P_MATERIAL, ([MAT_BONE: 100]) );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:20]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 3 + setmight() * (setmight() - 1);
}

