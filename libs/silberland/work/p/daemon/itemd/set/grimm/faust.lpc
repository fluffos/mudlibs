#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Grimms Koerper");
  SetProp(P_SET_ITEM, "Grimms Faust");
  SetProp(P_NR_SET_ITEMS, 5);
  SetProp(P_SET_BONUS, ([
        0:([P_M_ATTR_MOD:0,]),
        1:([P_M_ATTR_MOD:0,]),
        2:([P_M_ATTR_MOD:([A_STR:1]),]),
        3:([P_M_ATTR_MOD:([A_STR:2]),]),
        4:([P_M_ATTR_MOD:([A_STR:4]),]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Grimms Koerper", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab", "nuetzt sich weniger ab", 
        "erhoeht Lebenspunkte und Magiepunkte","erhoeht deine Kraft",
        }) );
  SetProp(P_SHORT, "Grimms Faust");
  SetProp(P_LONG,
    "Das ist die Faust von Grimm, dem Riesen. Sie ist so gross, dass Du sie "
    "als Handschuh verwenden kannst. Vielleicht verleiht sie Dir auch die "
    "gleiche gewaltige Kraft von Grimm, wenn Du noch die anderen Teile "
    "seines Koerpers findest." );
  SetProp(P_NAME, "Grimms Faust");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"faust", "grimms faust" }) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_BONE: 100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:20]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 1 + setmight();
}
