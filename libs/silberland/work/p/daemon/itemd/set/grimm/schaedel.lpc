#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";

int riese=1; // kann riese werden
object giant; // ist gerade ein riese

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Grimms Koerper");
  SetProp(P_SET_ITEM, "Grimms Schaedel");
  SetProp(P_NR_SET_ITEMS, 5);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:0,P_SP:0])]),
        1:([P_M_HEALTH_MOD:([P_HP:2,P_SP:1])]),
        2:([P_M_HEALTH_MOD:([P_HP:3,P_SP:2])]),
        3:([P_M_HEALTH_MOD:([P_HP:4,P_SP:3])]),
        4:([P_M_HEALTH_MOD:([P_HP:5,P_SP:4])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Grimms Koerper", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab",  "nuetzt sich weniger ab",
        "erhoeht Lebenspunkte und Magiepunkte",
        }) );
  SetProp(P_SHORT, "Grimms Schaedel");
  SetProp(P_LONG,
    "Das ist der Schaedel von Grimm, dem Riesen. Da er viel groesser als "
    "Dein Kopf ist, kannst Du ihn Dir als Helm aufsetzen. Wenn Du durch die "
    "Augenhoehlen des legendaeren Riesen blickst, kannst Du Dich vielleicht "
    "selber in einen Riesen verwandeln." );
  SetProp(P_NAME, "Grimms Schaedel");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"schaedel", "grimms schaedel" }) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 13);
  SetProp(P_MATERIAL, ([MAT_BONE: 100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_EFFECTIVE_WC, 200);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:20]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);

  AddCmd( ({"schaue", "schau", "blicke", "blick"}), "blicken");
  AddCmd("", "test",1);
}


int blicken(string str)
{
  notify_fail("Wo willst Du durchblicken?\n");
  if(member( ({"durch augenhoehlen","augenhoehlen", "durch augenhoehle",
          "augenhoehle"}),str)==-1)
    return 0;
  if(TP!=QueryProp(P_WORN))
    return write("Dazu musst Du den Schaedel schon tragen!\n"),1;
  switch(setmight())
  {
    case 0:  
    case 1:
    case 2: write(BS("Netter Ausblick, aber Du must noch mehr wie der Riese "
                  "Grimm aussehen, damit Du selber ein Riese werden kannst."));
            return 1;
    case 3: write(BS("Du erblickst Deine Umgebung fast schon wie ein echter "
                  "Riese, aber zu einer voelligen Umwandlung reicht es noch "
                  "nicht."));
            return 1;
    case 4: write(BS("Du blickst durch die Augenhoehlen des Riesen Grimm und "
                  "beginnst Dich in einen Riesen zu verwandeln."));
            call_out("be_giant",2, QueryProp(P_WORN));
            return 1;
  }
  return 1;
}
                
void be_giant(object wer)
{
  int dauer;
  if(giant)
    return write("Du bist doch schon ein Riese!\n");
  if(!QueryProp(P_WORN) || wer!=QueryProp(P_WORN) || 
      wer->QueryProp(P_GHOST) || wer->QueryProp(P_FROG))
    return write("Du kannst Dich nicht in einen Riesen verwandeln!\n");
  if(!riese)
    return write("So oft kannst Du Dich nicht verwandeln.\n");
  if(setmight()<4)
    return write("Du musst die gesamte Ausruestung waehrend der Verwandlung "
        "tragen!\n");
  SetProp(P_X_ATTR_MOD,([A_STR:6+random(5), 
                         A_CON:2+random(4),
                         A_INT:-5+random(4),
                         A_DEX:-2+random(6)]));
  dauer=60*(random(5)+3);
  wer->ModifySkillAttribute(wer, SA_SPEED, 122+random(26), dauer );
  wer->ModifySkillAttribute(wer, SA_DAMAGE, 111+random(13), dauer );
  wer->UpdateAttributes();
  wer->AddHp(-random(10));
  wer->AddSp(-random(50));
  wer->Set(P_TITLE, symbol_function("title", this_object()), F_QUERY_METHOD);
  wer->Set(P_GUILD_TITLE, symbol_function("title", this_object()), F_QUERY_METHOD);
  wer->Set(P_SIZE, symbol_function("size", this_object()), F_QUERY_METHOD);
  wer->Set(P_WEIGHT, symbol_function("weight", this_object()), F_QUERY_METHOD);
  wer->Set(P_RACE, symbol_function("race", this_object()), F_QUERY_METHOD);
  giant=wer;
  riese=0;
  write("Nun bist Du so stark wie ein echter Riese, aber nur fuer kurze "
      "Zeit!\n");
  tell_room(environment(wer),wer->Name(WER)+" wird ploetzlich so stark "
      "wie der Riese Grimm.\n", ({wer}) );
  call_out("be_normal",dauer, wer);
}

void be_normal(object wer)
{
  tell_object(wer, "Unter Schmerzen verwandelst Du Dich wieder zurueck!\n");
  tell_room(environment(wer),wer->Name(WER)+" verliert seine Riesenkraefte.\n",
      ({wer}) );
  SetProp(P_X_ATTR_MOD, 0);
  wer->UpdateAttributes();
  wer->AddHp(-random(50));
  wer->AddSp(-random(70));
  wer->Set(P_TITLE, 0, F_QUERY_METHOD);
  wer->Set(P_GUILD_TITLE, 0, F_QUERY_METHOD);
  wer->Set(P_SIZE, 0, F_QUERY_METHOD);
  wer->Set(P_WEIGHT, 0, F_QUERY_METHOD);
  wer->Set(P_RACE, 0, F_QUERY_METHOD);
  giant=0;
}

int test()
{
  if(giant && setmight()<4)
  {
    write(BS("Da Du nicht mehr die komplette Riesenausruestung traegst, "
          "verwandelst Du Dich wieder zurueck.\n"));
    be_normal(giant);
  }
  return 0;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  test();
  return 1 + setmight();
}

void reset()
{
  if( !is_clone(this_object()) ) return;
  ::reset();
  test();
  riese=1;
}

int size() { return 500;}

int weight() { return 500000;}

string title() { return "der Riese";}
  
string race() {return "Riese";}
