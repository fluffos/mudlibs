#include "../def.h"
#include "/gilden/amazonen/amazonen_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Athenas Wehr");
  SetProp(P_SET_ITEM, "Athenas Sandalen");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_ATTR_MOD:([A_DEX:1]), P_AMAZONEN_BONUS: (["schnelligkeit":5]) ]),
        1:([P_M_ATTR_MOD:([A_DEX:1]), P_AMAZONEN_BONUS: (["schnelligkeit":10]) ]),
        2:([P_M_ATTR_MOD:([A_DEX:2]), P_AMAZONEN_BONUS: (["schnelligkeit":20, "all":5])]),
        3:([P_M_ATTR_MOD:([A_DEX:3]), P_AMAZONEN_BONUS: (["schnelligkeit":30, "all":10]) ]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Athenas Wehr", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "erhoeht Lebenspunkte", "erhoeht oder erniedrigt Attribute",
        "laesst dich schneller werden", "nuetzt sich weniger ab",
        "kann nur von weiblichen Wesen verwendet werden",}) );
  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Athenas Sandalen sind leichte, aber stabile Schuhe, die von "
    "Athena selbst getragen wurden. Es handelt sich um "
    "goldene Sandalen mit einer Schnuerung, die bis hoch zu den "
    "Waden reicht. Die Sandalen scheinen niemals komplett ruhig zu "
    "sein und vibrieren staendig leicht." );  
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"sandalen", "athenas sandalen" }) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_MISC_HOLY: 30, MAT_LEATHER:70]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 250);

  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:15, P_GENDER:FEMALE]) );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 5]));
}

public void DefendFunc(object attacker, int damage_type, int damage_amount)
{
  if(!random(20-setmight())) {
    tell_object(environment(), "Athenas Sandalen verleihen dir unglaubliche Geschwindigkeit!\n");
    environment()->ModifySkillAttribute(TO, SA_SPEED, 200 + (setmight()*50), setmight()*2);
  }
  return 0;
}

