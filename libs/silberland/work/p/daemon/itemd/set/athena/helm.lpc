#include "../def.h"
#include "/gilden/amazonen/amazonen_extern.h"

inherit ITEMD_SET_PATH "std_set_armour";

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Athenas Wehr");
  SetProp(P_SET_ITEM, "Athenas Helm");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:0, P_AMAZONEN_SPELLCOST: 1, P_AMAZONEN_BONUS: (["selbstbeherrschung": 1, "lebenskraft": 1, "all": 1])]),
        1:([P_M_HEALTH_MOD:([P_HP:1, P_SP:1]), P_AMAZONEN_SPELLCOST: 3, P_AMAZONEN_BONUS: (["selbstbeherrschung": 5, "lebenskraft":5, "all": 5])]),
        2:([P_M_HEALTH_MOD:([P_HP:3, P_SP:3]), P_AMAZONEN_SPELLCOST: 5, P_AMAZONEN_BONUS: (["selbstbeherrschung": 10, "lebenskraft": 10, "all": 8])]),
        3:([P_M_HEALTH_MOD:([P_HP:11, P_SP:11]), P_AMAZONEN_SPELLCOST: 8, P_AMAZONEN_BONUS: (["selbstbeherrschung": 20, "lebenskraft": 20, "all": 10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu  Athenas Wehr", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab",
        "kann nur von weiblichen Wesen verwendet werden",
        "schuetzt allem Schaden", "verbessert deine Selbstbeherrschung und Lebenskraft",
        "erhoeht Lebenspunkt und Magiepunkte", "nuetzt sich weniger ab",
        "verbilligt Amazonenzauber", 
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Athenas Helm ist ein kunstvoll gearbeiteter Helm, der von "
    "Athena selbst getragen wurde. Der Helm besteht aus poliertem "
    "Gold und hat einen Federbuschen aus Eulenfedern. Ein fester Nasensteg "
    "schuetzt das huebsche Gesicht der Traegerin. Der Helm strahlt eine Aura der "
    "Weisheit und des Schutzes aus.");
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"helm", "athenas helm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 11);
  AddProp(P_DAM_PROTECTION, MAGICAL_DAMAGE_TYPES );
  SetProp(P_MATERIAL, ([MAT_GOLD: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10, A_STR:10, P_GENDER:FEMALE]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 1 + 2*setmight();
}
