#include "../def.h"
#include "/gilden/amazonen/amazonen_extern.h"
inherit ITEMD_SET_PATH "std_set_weapon";

private void fuehren(int nr);
private int check(int nr);

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Athenas Wehr");
  SetProp(P_SET_ITEM, "Athenas Lanze");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_WC_FIX:25, P_DAM_TYPE:DT_PIERCE, P_AMAZONEN_BONUS: (["aufspiessen":5, "speerstoss": 5])]),
        1:([P_WC_FIX:33, P_DAM_TYPE:DT_PIERCE,P_AMAZONEN_BONUS: (["aufspiessen":10, "speerstoss": 10])]),
        2:([P_WC_FIX:50, P_DAM_TYPE:DT_PIERCE, P_AMAZONEN_BONUS: (["aufspiessen":15, "speerstoss": 15, "all":5])]),
        3:([P_WC_FIX:70, P_DAM_TYPE:({DT_PIERCE, DT_MAGIC}), P_AMAZONEN_BONUS: (["aufspiessen":30, "speerstoss": 30, "all":10])]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Athenas Wehr", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "kann nur von weiblichen Wesen verwendet werden",
        "verbessert das Aufspiessen und Speerstoesse", "macht mehr Schaden",
        "nuetzt sich weniger ab", "liegt besser in der Hand", 
        "macht zusaetzlichen Schaden",
        }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Athenas Lanze ist eine prachtvolle Waffe, die von Athena selbst "
    "getragen wurde. Die Lanze hat eine lange, schlanke Spitze aus "
    "heiligem Stahl und einen Schaft, der mit goldenen Verzierungen "
    "geschmueckt ist. Sie strahlt eine Aura der Macht und des Mutes aus "
    "und soll ihre Traegerin unbesiegbar machen. Sie kann einhaendig "
    "oder zweihaendig gefuehrt werden (fuehre lanze einhaendig|zweihaendig)." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"lanze", "athenas lanze"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_WC, 195);
  SetProp(P_WC_FIX, 10);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL: 95, MAT_MISC_HOLY:5]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 300);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:10, A_DEX:10, P_GENDER:FEMALE]) );

  fuehren(1);
  AddCmd(({"fuehre", "fuehr"}), "cmd_fuehre");
}

int cmd_fuehre(string str)
{
  string was;

  notify_fail("Was willst Du fuehren?\n");
  if( !stringp(str) || str == "" ) return 0;

  str = lower_case(str);

  if( (sscanf(str, "%s zweihaendig", was) == 1 ||
        sscanf(str, "%s mit beiden haenden", was) == 1) && id(was) )
  {
    if( !check(2) ) return -1;
    write("Du fuehrst " + name(WEN,1) + " jetzt zweihaendig.\n");
    fuehren(2);
    return 1;
  }
  else if( (sscanf(str, "%s einhaendig", was) == 1 ||
        sscanf(str, "%s mit einer hand", was) == 1 ||
        sscanf(str, "%s mit hand", was) == 1) && id(was) )
  {
    if( !check(1) ) return -1;
    write("Du fuehrst " + name(WEN,1) + " jetzt einhaendig.\n");
    fuehren(1);
    return 1;
  }

  if( id(str) )
  {
    write("Du kannst " + name(WEN,1) + " nur einhaendig oder zweihaendig fuehren.\n");
    return -1;
  }

  return 0;
}

int HitFunc(object enemy)
{
  return 5+2*setmight()*setmight()*(setmight()-1)+random(enemy->QueryProp(P_LEVEL)/2);
}

private int check(int nr)
{
  if( QueryProp(P_NR_HANDS) == nr )
  {
    write("Aber Du fuehrst " + name(WEN,1) + " doch schon " +
        (nr == 1 ? "einhaendig" : "zweihaendig") + "!\n");
    return 0;
  }
  if( QueryProp(P_WIELDED) )
  {
    write("Du musst " + name(WEN,1) + " zuerst wegstecken, um sie anders "
        "zu fuehren!\n");
    return 0;
  }
  return 1;
}

private void fuehren(int nr)
{
  if( nr == 2 )
  {
    SetProp(P_NR_HANDS, 2);
    SetProp(P_WC, 275);
    SetProp(P_WIELDED_TEXT, "mit beiden Haenden gezueckt");
    SetProp(P_WIELD_TEXT, ({"Du zueckst die Lanze mit beiden Haenden.\n",
                            " zueckt eine Lanze mit beiden Haenden.\n"}) );
  }
  else
  {
    SetProp(P_NR_HANDS, 1);
    SetProp(P_WC, 195);
    SetProp(P_WIELDED_TEXT, "mit einer Hand gezueckt");
    SetProp(P_WIELD_TEXT, ({"Du zueckst die Lanze mit einer Hand.\n",
                            " zueckt eine Lanze mit einer Hand.\n"}) );
  }
}
