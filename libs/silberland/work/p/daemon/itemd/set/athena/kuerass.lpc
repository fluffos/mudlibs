#include "../def.h"

inherit ITEMD_SET_PATH "std_set_armour";
#include "/gilden/amazonen/amazonen_extern.h"

void create() 
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SET, "Athenas Wehr");
  SetProp(P_SET_ITEM, "Athenas Kuerass");
  SetProp(P_NR_SET_ITEMS, 4);
  SetProp(P_SET_BONUS, ([
        0:([P_M_HEALTH_MOD:([P_HP:1,P_SP:1]), P_AMAZONEN_SPELLCOST:1]),
        1:([P_M_HEALTH_MOD:([P_HP:2,P_SP:2]), P_AMAZONEN_SPELLCOST:3]),
        2:([P_M_HEALTH_MOD:([P_HP:3,P_SP:3]), P_AMAZONEN_SPELLCOST:7]),
        3:([P_M_HEALTH_MOD:([P_HP:4,P_SP:4]), P_AMAZONEN_SPELLCOST:12]),
        ]));
  SetProp(P_ITEMD, ({"gehoert zu Athenas Wehr", 
        "entfaltet die volle Wirkung erst gemeinsam mit anderen Sachen",
        "wehrt zusaetzlichen Schaden ab", "verbilligt Amazonenzauber", 
        "erhoeht Lebenspunkte und Magiepunkte",
        "schuetzt besser", "nutzt sich viel langsamer ab",
        "kann nur von weiblichen Wesen getragen werden" }) );

  SetProp(P_SHORT, QueryProp(P_SET_ITEM));
  SetProp(P_LONG,
    "Athenas Kuerass ist ein schmaler Kuerass, der so geformt ist, dass "
    "er die Brust betont und den Bauch komplett frei laesst. Dennoch darf "
    "man sich von der golden strahlenden Ruestung nicht taeuschen lassen. "
    "Sie entfaltet ihre Wirkung am gesamten Koerper. Athena selbst hat diese "
    "Ruestung getragen, als sie in die Schlacht zog." );
  SetProp(P_NAME, QueryProp(P_SET_ITEM));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kuerass", "athenas kuerass" }) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 35);
  SetProp(P_MATERIAL, ([MAT_GOLD: 90, MAT_MISC_MAGIC:10]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 7000);
  SetProp(P_QUALITY_DECAY, 700);

  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+MAGICAL_DAMAGE_TYPES );

  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:15, A_STR:15, P_GENDER:FEMALE]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 1 + 2*setmight();
}

