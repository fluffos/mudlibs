/* a finger
 * Original (c) 14.03.1993 by Taube @Nightfall
 * Umsetzung fuer Morgengrauen 09.08.1993 by Loco

   Verwendung ausserhalb von Morgengrauen ist gestattet unter folgenden
   Bedingungen:
   - Benutzung erfolgt auf eigene Gefahr. Jegliche Verantwortung wird
     abgelehnt.
   - Auch in veraenderten oder abgeleiteten Objekten muss ein Hinweis auf
     die Herkunft erhalten bleiben.
   Ein Update-Service besteht nicht.

 */


#pragma strong_types

#include <config.h>
#include <properties.h>
#include <wizlevels.h>
#include <new_skills.h>
#include <moredef.h>
#include <parentmaster.h>
#include <udp_mail.h>
#include <living.h>
#include <defines.h>
#include "/secure/warnings.h"

#define HBINT    2   /* interval between two heart_beats in seconds */
#define MINIDLE 60   /* minimum idle time in seconds to be stated idle */
#define TW(x) tell_object(find_player("woody"), x)
#define TZ(x) tell_object(find_player("zordan"), x)
#define FILLHEADER(x) "( "+sprintf("%-74s",(x)[0..73])+" ()\n"

#define IN ((properties[P_GENDER]==FEMALE) ? "in" : "")

#define INITFILE (BLUE_NAME(TO)+".init")
#define LOG_NOUSER
#define LOG_FAILURE

mapping properties;
int age;
nosave mapping wiznames, aliases, work;
nosave int lastline;
nosave int lastInit;

nosave int parse_init_line(string str)
{
  string cmd,arg,rest;
  int i;

  if (!stringp(str) || !strlen(str) || str[0]=='#') return 0;
  cmd=explode(str," ")[0];
  arg=explode(str," ")[1];
  rest=implode(explode(str," ")[2..]," ");
  switch (lower_case(cmd))
  {
    case "wizname":
      wiznames[arg]=rest;
      break;
    case "alias":
      aliases[arg]=rest;
      break;
    case "work":
      work[arg]=rest;
      break;
    default:
      raise_error("Error parsing fingerd.init file!");
  }
}

void ReloadInitfile()
{
  mixed data;
  wiznames = ([]);
  aliases = ([]);
  work = ([]);
  lastInit=time();
  if (data = read_file(INITFILE))
    map_array(explode(data, "\n"), #'parse_init_line);
}

void create()
{
  seteuid(getuid());
  ReloadInitfile();
}

void reset()
{
  if (file_time(INITFILE) >= lastInit)
    ReloadInitfile();
}

nosave string UnANSI(string str)
{
  if (stringp(str))
    return regreplace(str, "(\e\\[[0-9]*[HJm])|(\a)", "", 1);
  else
    return str;
}

varargs string wiz_level_name(int level, int gender, string name)
{
  int female;
  if (name && member(wiznames,name)) return wiznames[name];
  female = (gender==FEMALE ? 1 : 0);    // just to be safe

  switch (level)
  {
    case LEARNER_LVL .. INACTIVEWIZ_LVL-1:
      return "Magierlehrling";
    case INACTIVEWIZ_LVL .. WIZARD_LVL-1:
      return "Altmagier"+(female ? "in" : "");
    case WIZARD_LVL:
      return "Gastmagier"+(female ? "in" : "");
    case WIZARD_LVL+1 .. DOMAINMEMBER_LVL-1:
      return "Jungmagier"+(female ? "in" : "");
    case DOMAINMEMBER_LVL .. FULLWIZ_LVL-1:
      return "Regionsmitarbeiter"+(female ? "in" : "");
    case FULLWIZ_LVL .. SPECIAL_LVL-1:
      return "Vollmagier"+(female ? "in" : "");
    case SPECIAL_LVL .. LORD_LVL-1:
      return "Magier"+(female ? "in" : "")+" fuer besondere Aufgaben";
    case LORD_LVL .. ELDER_LVL-1:
      return "Regionsmagier"+(female ? "in" : "");
    case ELDER_LVL .. ARCH_LVL-1:
      return "Weise"+(female ? "" : "r");
    case ARCH_LVL .. GOD_LVL-1:
      return "Erzmagier"+(female ? "in" : "");
    default:
      if (level >= GOD_LVL)
        return female ? "Mudgoettin" : "Mudgott";
      return "Magier"+(female ? "in" : "");
  }
}

string timediff(int time)
{
  string ret;

  ret="";
  if(time>=86400) {
    ret+=time/86400+"d ";
    time%=86400;
  }
  if(time<36000) ret+="0";
  ret+=time/3600+":";
  time%=3600;
  if(time<600) ret+="0";
  ret+=time/60+":";
  time%=60;
  if(time<10) ret+="0";
  ret+=time+"";
  return ret;
}

string al_to_string(mixed a)
{
  if (!intp(a)) return "unbekannt";
  if (a >= KILL_NEUTRAL_ALIGNMENT * 1000)
    return "scheinheilig";
  if (a >= KILL_NEUTRAL_ALIGNMENT * 100)
    return "heilig";
  if (a > KILL_NEUTRAL_ALIGNMENT * 20)
    return "gut";
  if (a > KILL_NEUTRAL_ALIGNMENT * 4)
    return "nett";
  if (a > - KILL_NEUTRAL_ALIGNMENT * 4)
    return "neutral";
  if (a > - KILL_NEUTRAL_ALIGNMENT * 20)
    return "frech";
  if (a > - KILL_NEUTRAL_ALIGNMENT * 100)
    return "boese";
  return "satanisch";
}

nosave string insert_blank() {
  if(lastline==0) {
    lastline=1;
    return "|                                      "+
           "                                      |\n";
  }
  return "";
}

nosave varargs string insert_text(string str, int no) {
  int i;

  lastline=0;
  while( (i=strstr(str,"\n")) && i!=-1)
    str=str[0..i-1]+str[i+1..(strlen(str)-1)];
  if(no) return str+"\n";
  return "| "+sprintf("%-74s",UnANSI((str)[0..73]))+" |\n";
}

