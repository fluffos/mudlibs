Beispiel fuer die Ausgabe:

 _____________________________________________________________________________
( Name: Fingerprogger Zordan und ?                                           ()
|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~|
| Er ist seit 09:51 Uhr von xxx.xxx.xxx.xxx [Wien] anwesend.                 |
| Organisation: Der Mudrechner                                               |
|                                                                            |
| Rasse: Mensch,  Stufe: 66, Erzmagier, Balance, Sheriff i.V.                |
| Gilde: Druidenzirkel,  Gildenstufe: 15,  Gesinnung: boese                  |
| Alter:  143d 07:03:26, Geboren am : Mon, 21. Jul 1997, um 15:48:06         |
| Gestorben:  49 mal,  (derzeit laeuft er als Geist umher!)                  |
|                                                                            |
| E-Mail: joey@halifax.rwth-aachen.de,  ICQ-UIN: 1234567890                  |
| Er hat seine Post zuletzt gelesen am: Son,  9. Jan 2000, um 21:00:36       |
| URL: members.kabsi.at/zordandi (steckt aber eher noch in den...            |
| Projekt: BlaBla                                                            |
|                                                                            |
| Er ist Sohn von Stahldorn und Vater von Soia und Verdandi.                 |
| Regionsmagier von     : Wueste.                                            |
| Regionsmitarbeiter von: Ebene, Gebirge, Huegelland, Unterwelt, Wueste.     |
|___________________________________________________________________________ |
\___________________________________________________________________________\/

Plan:

*/


varargs mixed finger_single(string str, int local, int flags)
{
  string text,ersie;
  mixed f,g,h,*userinfo; // f,g und h sind staendige Hilfsvariablen !
  object pl;             // es geht nicht anders, weil sonst zuviele Vars :(
  int i,j,wiz,seer;
  string race, guild;

  str  = lower_case(str);
  text = "";
  wiz  = (TP && IS_INACTIVEWIZ(TP));
  seer = (TP && IS_SEER(TP));
  lastline = 0;

  h=explode(str," ");
  if (member(h,"-n")!=-1) flags |= FF_NOPLAN;
  if (member(h,"-p")!=-1) flags &= ~FF_NOPLAN;
  if (member(h,"-f")!=-1) flags |= FF_NOFAMILY;
  if (member(h,"-w")!=-1) flags |= FF_NOWIZARD;
  if (member(h,"-m")!=-1) flags |= FF_NOMISC;
  if (member(h,"-s")!=-1) flags |= FF_NOLONG;
  h=(h-({"-n","-p","-f","-m","-w","-s"}));
  if (!sizeof(h)) {
    text="Du solltest schon sagen, fuer wen Du Dich interessierst!\n";
    if (local) return write(text),0;
    else return text;
  }
  str=h[0];
  sscanf(str, "gast%d%s", i, text);
  // dh. fuer Gast1..n ist i != 0 und text ein Leerstring
  if (!i || text != "")  // sonst Namen auf nonalpha chars durchchecken
  {
    for (i=0; i < strlen(str); i++)
    {
      if (str[i] < 'a' || str[i] > 'z')
      {
        text="Also, so ("+str+") heisst bestimmt kein Spieler im "
              +MUDNAME+"!\n";
        if (local) return write(text),0;
        else return text;
      }
    }
  }

  // existiert der Spieler ueberhaupt ?
  userinfo=MASTER->get_userinfo(str);
  pl=find_player(str);

  // Alias-Handling
  if(!userinfo && !pl)
  {
    if (member(aliases,str))
      text = aliases[str]+"\n";
    else
    {
      text = "/secure/master"->QueryBanished(str);
#ifdef LOG_NOUSER
      log_file("daemon/FINGERD_NOUSER",
          sprintf("[%s] %O -> %O%s\n",
            ctime(time()), TP || "extern", str,
            text ? " (banished)" : ""));
#endif
      if (text)
        text = "Hoppla - dieser Name ist reserviert oder gesperrt " +
          "(\"gebanisht\") !\n"+ (wiz ? "Grund: "+text+"\n" : "");
      else
        text = "Hmm... diesen Namen gibt es im "+MUDNAME+" nicht.\n";
    }
    if (local) return write(text), 0;
    else return text;
  }

  // Presay/Title Handling
  if (pl)
  {
    properties = pl->QueryProperties();
    g = pl->QueryProp(P_TITLE);
    h = pl->QueryProp(P_PRESAY);
    race = pl->QueryProp(P_RACE);
    guild = pl->QueryProp(P_GUILD);
  }
  else if (find_netdead(str))
  {
    properties = find_netdead(str)->QueryProperties();
    g = find_netdead(str)->QueryProp(P_TITLE);
    h = find_netdead(str)->QueryProp(P_PRESAY);
    age = find_netdead(str)->QueryProp(P_AGE);
    race = find_netdead(str)->QueryProp(P_RACE);
  }
  else
    restore_object("/save/"+str[0..0]+"/"+str);

  if (!properties)
  {
#ifdef LOG_FAILURE
    log_file("daemon/FINGERD_FAILED",
        sprintf("[%s] %O -> %O\n",ctime(time()),TP || "extern",str));
#endif
    text = "Mist!!! Das Einlesen der Daten klappt nicht wie es soll! :-(\n"+
           "Bitte informiere einen Erzmagier ueber diesen Vorfall, Danke!\n";
    properties = 0;
    if (!local) return text;
    write(text);
    return 1;
  }
  
  text = "";
  if(!(flags & FF_NOLONG))
  {
    text += " ______________________________________"+
            "_______________________________________\n";
  }

  if (!g) {
    g = properties[P_TITLE];
    if (!query_wiz_level(pl) && !g)
      g = (properties[P_GUILD_TITLE])
        [properties[P_GUILD] || properties[P_DEFAULT_GUILD] || DEFAULT_GUILD];
  }
  if (!stringp(g)) g = "";
  if (strlen(g)) {
    if(g[0] != '\b')
      g = " " + g;
    else
      g = g[1..];
  }

  if (!stringp(h)) {
    h = properties[P_PRESAY];
  }
  else
    h = h[0..<2];       // Leerzeichen abzwicken

  if (flags & FF_NOLONG)
  {
    text += "Name: "+UnANSI((stringp(h) && strlen(h)) ? h + " " : "") +
      capitalize(properties[P_NAME] || str) + (g ? g : "") + "\n";
  } else {
    f = ((stringp(h) && strlen(h)) ? h + " " : "") +
        capitalize(properties[P_NAME] || str) +
        (g ? g : "");
    f = UnANSI(f);
    if (strlen(f) > 74)
      f = f[0..73];
    f=("                                        "
       "                                        ")[0..(35-(strlen(f)/2))]+f;
    text+=FILLHEADER(f);
    text+="|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"+
          "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~|\n";
  }

  if ((f = properties[P_LAST_LOGOUT]) == -1)
    f = file_time(sprintf("/save/%c/%s.o", str[0], str));

  h = properties[P_CALLED_FROM_IP] || "unbekannt";

  g = 0;
  if (pl)
  {
    if (h=query_ip_number(pl))
    {
      if ((g=query_idle(pl))<MINIDLE)
        g=0;
    }
    if (IS_WIZARD(pl))
      j=pl->QueryProp(P_INVIS);
    else
      j=0;
    if (IS_WIZARD(pl) && j && !wiz)
    {
      age = j;
      if ((age > pl->QueryProp(P_AGE)) || (age < 0))
        age=pl->QueryProp(P_AGE);
    }
    else
      age = pl->QueryProp(P_AGE);
  }
  else
  {
    g=properties[P_LAST_LOGOUT];
    j=0;
  }

  ersie=( ([NEUTER:"es ?!?", MALE:"er",
            FEMALE:"sie"]) [properties[P_GENDER]] ||
            "?!?");

  // Anwesenheits-Handling
  if(pl)
  {
    if(h && (wiz || !j))
    {
      text+=insert_text(capitalize(ersie)+" ist seit "+
        (time()-pl->QueryProp(P_LAST_LOGIN) >= 86400 ?
          dtime(pl->QueryProp(P_LAST_LOGIN))[5..23] :
          dtime(pl->QueryProp(P_LAST_LOGIN))[19..23]) + " Uhr anwesend."+
          (g ? " (Idle: "+timediff(g)+")" : "")
        , (flags & FF_NOLONG) );
      g="kommt";
    }
    else {
      if (properties[P_LAST_VISIBLE_LOGOUT] > 0)
        f=properties[P_LAST_VISIBLE_LOGOUT];
      text+=insert_text(capitalize(ersie)+" ist leider nicht anwesend.",
        (flags & FF_NOLONG));
      text+=insert_text(
        "Zuletzt hat "+ersie+" ausgeloggt am: "+
        dtime(f)[5..23]+" Uhr ("+timediff(time()-f)+").",
        (flags & FF_NOLONG));
      g="kam";
    }
  }
  else
  {
    if (!wiz && (properties[P_LAST_VISIBLE_LOGOUT] > 0))
        f=properties[P_LAST_VISIBLE_LOGOUT];
    text+=insert_text(capitalize(ersie)+" ist leider nicht anwesend.",
      (flags & FF_NOLONG));
    text+=insert_text(
      "Zuletzt hat "+ersie+" ausgeloggt am: "+
      dtime(f)[5..23]+" Uhr ("+timediff(time()-f)+").",
      (flags & FF_NOLONG));
    g="kam";
  }

  if (f=MASTER->QueryTBanished(str))
  {
    text+=insert_text(sprintf("%s will erst am %s wieder ins "+MUDNAME+" kommen!",
        capitalize(ersie),
        (f == -1 ? "St. Nimmerleinstag" : dtime(f)[0..16])),
        (flags & FF_NOLONG));
  }

  if (pl && properties[P_AWAY] && (wiz || !j))
  {
    f=break_string(properties[P_AWAY],
            74,"z.Z. abwesend, Grund: ",BS_INDENT_ONCE);
    f=explode(f,"\n");
    for(j=0;j<sizeof(f);j++)
      text+=insert_text(f[j],(flags & FF_NOLONG));
  }

  if (stringp(properties[P_LOCATION]))
  {
    f = properties[P_LOCATION];
    if (f != country(h))
      f += sprintf(" (ueber %s)", country(h));
  }
  else
    f = country(h);

  text += insert_text(
    (wiz ?
      // wiz:
      capitalize(ersie) + " " + g +
      sprintf( " von %s (%s) [%s].",
               (pl ? query_ip_name(pl) :
                     (string) properties[P_CALLED_FROM_IP_NAME]||"Unbekannt"),
               h, f ) :
      // !wiz:
      ( f != "Unbekannt" ?
        sprintf( "%s %s aus %s.", capitalize(ersie), g, f ) :
        sprintf( "Woher %s %s, ist nicht bekannt.", ersie, g ) ) ),
    (flags & FF_NOLONG));

  if (wiz)
    text+=insert_text("Organisation: "+
          (pl ?
            TOWND->description(pl) :
            TOWND->description(h))+
          ".",
          (flags & FF_NOLONG));

  if (flags & FF_NOLONG) {
    properties=0;
    if (!local) return text;
    write(text);
    return 1;
  }

  text+=insert_blank();

  f=query_wiz_level(str);
  g=((h = (race ? race : properties[P_RACE])) ? h :
      ((userinfo && pointerp(userinfo) && sizeof(userinfo)>4 &&
        stringp(h=userinfo[4]) && find_object(h)) ?
          call_other(h, "_query_race") : capitalize(explode(h,"/")[<1])));

  text += insert_text((g != "" ? "Rasse: "+g+",  " : "") +
    (f>=10 ? "Magierstufe: "+f+",  "+
       wiz_level_name(f,properties[P_GENDER],str)
       : "Spielerstufe: "+properties[P_LEVEL]+
      (f ? ",  " + ( call_other("/obj/erzsehermaster", "check", "Erzseher", str,
             "", "", properties[P_LEVEL], properties[P_QP]) ? "Erzs" : "S") +
       "eher" + IN : "")));

  text += insert_text(sprintf("Gilde: %s",capitalize(guild || properties[P_GUILD] ||
    properties[P_DEFAULT_GUILD] || DEFAULT_GUILD))+
    (((h=properties[P_GUILD_LEVEL]) && h=h[properties[P_GUILD]]) ?
      (",  Gildenstufe: "+h) :
      "" )+
    ",  Gesinnung"+(h?"":" ")+": "+
    ((h=properties[P_ALIGN_STRING]) && (f >= 10 || properties[P_TESTPLAYER]) ?
      h :
      al_to_string(properties[P_ALIGN])));

  text += insert_text(
    (seer ? sprintf("Alter: %14s",timediff(age*HBINT)) : "")+
    (userinfo && pointerp(userinfo)
     ? (seer ? ",  " : "")+sprintf("Geboren %s",
       (userinfo[5] > 0 ? "am "+dtime(userinfo[5])[0..23]+" Uhr."
                        : "vor dem 1. Okt 1996."))
     : ""));

  if (intp(h=properties[P_DEADS]) && h>0)
  {
    f="Gestorben: "+h+" mal!";
    if (intp(h) && h>100)
      f="Gestorben: schon "+h+" mal!";
  } else {
	  f="Gestorben: Bisher noch nie!";
	}

  text += insert_text(f+(properties[P_GHOST] ?
            "  (Hoppla, derzeit ein Geist!)" :
            ""
          ));


  if (seer && (properties[P_KILLS]))    //PK's nur fuer Seher und Mags
	{
          text+=insert_text("PLAYERKILL"+(properties[P_KILLS]<=1?": ":"S: ")+
              properties[P_KILLS]+" !!!");
	}
  if (properties[P_WARNINGS]) {
    // Verwarnungen
    if (sizeof(properties[P_WARNINGS])==0)
      h="";
    else {
      j=0;
      f=m_values(properties[P_WARNINGS]);
      for (i=sizeof(f)-1; i>=0;i--) {
        j+=f[i][W_LEVEL];
      }
      switch ((j*100)/MAX_WARNING_LEVEL) {
        case 0..24: h="Gelegenheitsverbrecher"; break;
        case 25..49: h="Langfinger"; break;
        case 50..74: h="Schwerverbrecher"; break;
        case 75..99: h="Schwerstverbrecher"; break;
        default: h="Massenmoerder - VERWARNGRENZE ERREICHT";
      }
      text+=insert_text("Loyalitaet: "+h);
    }
  }

  i=0;
  if (properties[P_MARRIED])
  {
    if (!i) text += insert_blank();
    text+=insert_text(capitalize(ersie)+" ist mit "+
      capitalize(properties[P_MARRIED])+" verheiratet.");
    i=1;
  }

  if (f=properties[P_TESTPLAYER])
  {
    if (!i) text += insert_blank();
    h=capitalize(ersie)+" ist "+(i ? "weiters ":"")+"Testspieler"+IN;
    i=2;
    if (stringp(f)) h+=" von "+f;
    h+=".";
    text += insert_text(h);
  }

  if (g=properties[P_SECOND])
  {
    if (wiz)    // Magier wissen mehr ;-)
    {
      if (!i) text += insert_blank();
      h = capitalize(ersie) + " ist " + (i ? "weiters " : "");
      switch ((int) properties[P_SECOND_MARK])
      {
        case -1: h += "unsichtbar markierte" +
                      ((int) properties[P_GENDER] != FEMALE ? "r": "") + " ";
                 break;
        case  0: h += "nicht namentlich markierte" +
                      ((int) properties[P_GENDER] != FEMALE ? "r": "") + " ";
                 break;
      }
      h += "Zweitspieler" + IN;
      i = 3;
      if (stringp(g)) h+=" von "+g;
      h+=".";
      text += insert_text(h);
    }
    // Spieler sehen eventuell nichts von der 2timarkierung
    else if ((int) properties[P_SECOND_MARK] >= 1)
    {
      if (!i) text += insert_blank();
      h = capitalize(ersie)+" ist "+(i ? "weiters ":"")+"Zweitspieler"+IN;
      i = 3;
      if (stringp(g)) h+=" von " + g;
      h += ".";
      text += insert_text(h);
    }
    else if ((int) properties[P_SECOND_MARK] >= 0)
    {
      if (!i) text += insert_blank();
      h = capitalize(ersie)+" ist "+(i ? "weiters ":"")+"Zweitspieler"+IN+".";
      i = 3;
      text += insert_text(h);
    }
    // else (unsichtbar markiert)
  }

  if (!(flags & FF_NOMISC))
  {
    i=0;
    f=properties[P_MESSENGER] || ([]);
    if (properties[P_ICQ])
      f["ICQ"] = to_string(properties[P_ICQ]);

    if (wiz ||                                          // Magier?
       (properties[P_SHOW_EMAIL]==2) ||                 // fuer alle sichtbar?
       ( (properties[P_SHOW_EMAIL]==1) &&               // nur fuer Freunde?
         objectp(pl) &&
         this_player() &&
         (g=present("\n\bfband",pl)) &&
         pointerp(g=g->QueryProp(P_AUTOLOADOBJ)) &&
         pointerp(g=g[1]) &&
         (member(g,getuid(this_player()))!=-1)))
    {
      g = properties[P_MAILADDR];
      if (!stringp(g) || !strlen(g) || g=="keine" || g=="none")
        g = 0;
    }
    else
      g = 0;

    if (stringp(g) || sizeof(f))
    {
      text += insert_blank();
      i=1;
      h =  map_array(sort_array(m_indices(f),#'>),lambda(({'k,'m}),
        ({#'sprintf,"%s: %s",({#'capitalize,'k}),({#'[,'m,'k})})),f);
      h = implode(h, ", ");
      h = (g ? "E-Mail: "+ g : "")+
          ((g && sizeof(f)) ? ",  " : "")+
          (sizeof(f) ? h : "");
      h = explode(break_string(h[2..],74,h[0..1],BS_INDENT_ONCE),"\n");
      for(j=0;j<sizeof(h);j++)
        text+=insert_text(h[j]);
    }

    if (wiz && LOCAL_MAILER->MailLastRead(str))
    {
      if (!i) text += insert_blank();
      i=2;
      text += insert_text(capitalize(ersie)+" hat "+
        ( ([NEUTER:"seine ", MALE:"seine ",  FEMALE:"ihre "])
          [properties[P_GENDER]] || "die ")+
        "Post zuletzt gelesen am: "+
        dtime(LOCAL_MAILER->MailLastRead(str))[0..23]+" Uhr." );
    }

    f=properties[P_HOMEPAGE];
    if (stringp(f))
    {
      if (!i) text += insert_blank();
      i=3;
      text += insert_text("Homepage: "+f);
    }

    if (file_size(f="/players/"+str+"/.project") >= 0 ||
        file_size(f="/p/service/save/plans/"+str+".project") >= 0)
    {
      if (!i) text += insert_blank();
      i=4;
      f = explode(break_string(read_file(f), 74,"Projekt: ",
            BS_INDENT_ONCE),"\n");
      i=1;
      for(j=0;j<sizeof(f);j++)
        text+=insert_text(f[j]);
    }
  }


  if (query_wiz_level(str)>=10 && (!(flags & FF_NOWIZARD)))
  {
    i=0;
    if (!(flags & FF_NOFAMILY))
    {
      f = PARENTMASTER->GetParent(str);
      g = map_array(PARENTMASTER->GetChildren(str), #'capitalize);
      h = "";
      if (f && f!="")
      {
        h += ((properties[P_GENDER]==MALE)?"Sohn":
              (properties[P_GENDER]==FEMALE)?"Tochter":"ein Nachkomme")+
              " von "+capitalize(f);
      }
      if (sizeof(g))
      {
        if (f) h += " und ";
        h += ((properties[P_GENDER]==MALE)?"Vater":
                 (properties[P_GENDER]==FEMALE)?"Mutter":"Vorfahr")+
                  " von ";
        j = sizeof(g);
        if (j > 1)
        {
          h += implode(g[0..<2], ", ")+" und "+ g[j-1];
        }
        else
        {
          h += g[0];
        }
      }
      if (strlen(h))
      {
        h = " ist " +h+ ".";
        text += insert_blank();
        f = explode(break_string(h, 74, capitalize(ersie),
              BS_INDENT_ONCE),"\n");
        i=1;
        for(j=0;j<sizeof(f);j++)
          text+=insert_text(f[j]);
      }
    }

    if (userinfo)
    {
      g="";
      f=userinfo[3];
      if (sizeof(f))
      {
        g=break_string(implode(map_array(f,#'capitalize/*'*/),", ")+".",
            74, "Regionsmagier" + IN + " von     : ", BS_INDENT_ONCE);
        h=explode(g,"\n");
        if (!i) text+=insert_blank();
        i=2;
        for(j=0;j<sizeof(h);j++)
          text+=insert_text(h[j]);
      }
      f="/secure/master"->get_domain_homes(str);
      if (sizeof(f))
      {
        g=break_string(implode(map_array(f,#'capitalize/*'*/),", ")+".",
            74, "Regionsmitarbeiter" + IN + " von: ", BS_INDENT_ONCE);
        h=explode(g,"\n");
        if (!i) text+=insert_blank();
        for(j=0;j<sizeof(h);j++)
          text+=insert_text(h[j]);
      }
      f = work[str];
      if (sizeof(f))
      {
        g=break_string(f, 74, "Zustaendig fuer " + 
            (properties[P_GENDER] == FEMALE ? "  ": "")+"      : ", BS_INDENT_ONCE);
        h=explode(g,"\n");
        if (!i) text+=insert_blank();
        for(j=0;j<sizeof(h);j++)
          text+=insert_text(h[j]);
      }
    }
  }

  text += "|_______________________________________"
          "____________________________________ |\n";
  text += "\\______________________________________"
          "_____________________________________\\/\n";

  // Plan
  if (seer && !(flags & FF_NOPLAN))
  {
    f="/players/"+str+"/.plan";
    if (file_size(f)>=0)
      text+="\nPlan:\n"+read_file(f);
    else
    {
      f="/p/service/save/plans/"+str+".plan";
      if (file_size(f)>=0)
        text+="\nPlan:\n"+read_file(f);
    }
  }

  properties=0;
  if (!local) return text;
  write(text);
  return 1;
}
