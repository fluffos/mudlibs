
int access_rights(string name, string file, int readflag, int def)
{
  string s1;
  string *str;

#if 0 
  if (find_player("zordan"))
    tell_object(find_player("zordan"),
        sprintf(" * p/daemon/potiond::access_rights: %O - %O - %O - %O\n",
          name,file,readflag,def));
#endif

  name = lower_case( name );
  str = efun::explode( file, "/" );

  // Leserechte-Handling
  // -----------------------------------------------------------------------
  if (readflag)
  {
    if (file_name(previous_object())[0..10]=="/std/corpse")
      return 1;
    return 0;
  }

  // Schreibrechte-Handling
  // -----------------------------------------------------------------------
  if (!file || (file=="access_rights.lpc"))
    return 0;
  return 0;
}

