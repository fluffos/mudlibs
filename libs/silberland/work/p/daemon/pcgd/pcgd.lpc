#include <moredef.h>
#include "pcgd_intern.h"

inherit PCGD_HOME "modules/biome";
inherit PCGD_HOME "modules/synonyms";
inherit PCGD_HOME "modules/room";
inherit PCGD_HOME "modules/map";
inherit PCGD_HOME "modules/cache";

public void create() {
    if(is_clone(TO)) {
        destruct(TO);
        return;
    }

    biome::create();
    cache::create();

    seteuid(getuid(this_object()));
}

public void reset() {
    if(is_clone(this)) return;

    cache::reset();
}