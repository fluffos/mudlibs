#include "../pcgd_intern.h"

private mixed *cache;

public void create() {
    cache = ({
        ([ ]), // maps
        ([ ]) // biomes
    });
}

private void removeCacheItem(int cacheNr, string key) {
    if(objectp(cache[cacheNr][key][CACHE_E_VALUE])) {
        // destruct any cached object
        destruct(cache[cacheNr][key][CACHE_E_VALUE]);
    }
    cache[cacheNr] = m_delete(cache[cacheNr], key);
}

private void clearOutdatedCache(int cacheNr) {
    int i;
    string *keys;

    keys = m_indices(cache[cacheNr]);
    for(i=0;i<sizeof(keys); ++i) {
        if(time() - cache[cacheNr][keys[i]][CACHE_E_TIMESTAMP] > CACHE_TTL) {
            removeCacheItem(cacheNr, keys[i]);
        }
    }
}

private void checkAndDeleteOutdatedCacheItems() {
    clearOutdatedCache(CACHE_BIOMES);
    clearOutdatedCache(CACHE_MAPS);
}

public void reset() {
    checkAndDeleteOutdatedCacheItems();
}

public mixed* GetCache() {
    return cache;
}

public void CachePut(int cacheNr, string key, mixed value) {
    if(!mappingp(cache[cacheNr][key])) {
        cache[cacheNr][key] = ({ 0, 0 });
    }

    cache[cacheNr][key][CACHE_E_VALUE] = value;
    cache[cacheNr][key][CACHE_E_TIMESTAMP] = time();
}

public mixed CacheGet(int cacheNr, string key) {
    if(!member(cache[cacheNr], key)) return 0;

    if(time() - cache[cacheNr][key][CACHE_E_TIMESTAMP] > CACHE_TTL) {
        removeCacheItem(cacheNr, key);
        return 0;
    }

    cache[cacheNr][key][CACHE_E_TIMESTAMP] = time();
    return cache[cacheNr][key][CACHE_E_VALUE];
}

public void CacheRemove(int cacheNr, string key) {
    if(!member(cache[cacheNr], key)) return;

    removeCacheItem(cacheNr, key);
    return;
}
