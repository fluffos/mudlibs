// 
// Eine Portion Magiekraut 
// (Bugfixes by Woody, 2002-11-22)
// 90 Sekunden lang Damage 140..180%, Speed 75%

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <food.h>
#include <new_skills.h>

#define SPEED 75
#define DAMAGE (140+random(5)*10)

int decay_resets=6+random(10);


void create()
{
  if( !is_clone(TO)) return;
  ::create();

  AddId(({"kraut", "magiekraut", "\nkraut"}));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Magiekraut");

  SetProp(P_SHORT, "Ein Blatt Magiekraut");
  SetProp(P_LONG,
      "Dieses purpurne, gezackte Blatt ist ein Teil des aeusserst seltenen "
      "Magiekrautes. Man munkelt so manches ueber seine Wirkung, von "
      "toedlich bis hochmagisch ist die Rede... Du bist Dir nicht sicher, "
      "ob Du sie am eigenen Leib ergruenden willst.");

  SetProp(P_INFO,
      "Das Magiekraut verstaerkt Deine magischen Kraefte enorm.");

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_FOOD_INFO, ([F_HEAL:10,F_POISON:0,F_SOAK:5]));
}

void Eating(object pl)
{
  tell_object(pl,
      "Du isst das Magiekraut und fuehlst Dich um vieles magischer.\n");
  say(pl->Name() + " isst ein seltsames Kraut.\n");
  pl->ModifySkillAttribute(pl, SA_SPEED, SPEED, 90);
  pl->ModifySkillAttribute(pl, SA_DAMAGE, DAMAGE, 90);
}

void reset()
{
  object e;

  ::reset();
  if (!(--decay_resets))
  {
    if ((e = ENV(ME)) && interactive(e))
      tell_object(e, "Das Magiekraut verwelkt. Du wirfst es weg.\n");
    remove();
  }
}
