/*
** Das Glasschwert
** Angrox@SL
** Nur zur Verwedung im SL!
** ---
** 25.08.1998 release
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


nosave int cnt=0;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schwert", "glasschwert"}));
  SetProp (P_SHORT, "Ein Glasschwert");
  SetProp (P_LONG,
      "Das Glasschwert ist eine sehr seltsame Waffe: Es besteht vollkommen "
      "aus Glas, also ein denkbar ungeeignetes Material fuer eine Waffe. "
      "Pass bloss auf, dass Du es nicht fallen laesst, sonst koennte es "
      "in hunderttausend Stueckchen zerspringen. Die Klinge des Schwertes "
      "besteht aus durchsichtigem Glas, der Griff mit Parierstange aus "
      "orange gefaerbten Glas.");
  SetProp (P_NAME, "Glasschwert");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 5000);
  SetProp (P_WEIGHT, 2000);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, DT_MAGIC);
  SetProp (P_WC, 150);
  SetProp (P_WC_BONUS, (["NPC":300]));
  SetProp (P_WC_FIXFACTOR, 1);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_GLASS);
  SetProp(P_INFO, BS("Das Glasschwert ist trotz seiner Zerbrechlichkeit eine "
      "sehr maechtige Waffe. Solange es nicht zerbrochen ist, wird es Dir "
      "gute Dienste leisten."));
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:15]));
}


string _query_info() {
  string txt;
  switch(cnt) {
    case 0..2: txt="Es ist noch vollkommen intakt."; break;
    case 3..4: txt="Es scheint schon einige kleine Risse zu haben."; break;
    case 5..6: txt="Es hat schon einige Spruenge."; break;
    case 7..8: txt="Es hat schon viele Spruenge. Lang wird es nicht mehr "
                   "halten."; 
               break;
    case 9..10: txt="Es hat schon sehr viele Spruenge. Bald wird es "
                    "zerbrechen!";
    default   : txt="Es kann nun bei jedem weiteren Schlag zerbrechen.";
  }
  
  return BS("Das Glasschwert ist trotz seiner Zerbrechlichkeit eine "
      "sehr maechtige Waffe. Solange es nicht zerbrochen ist, wird es Dir "
      "gute Dienste leisten. "+txt);
}

int HitFunc(object enemy) {
  if(!random(3)) {
    if(cnt>10 && !random(10) && (find_call_out("remove")==-1)) {
      call_out("remove", 0);
      return 0;
    }
    cnt++;
    return (random(100)+200);
  }
  return 0;
}

void remove() {
  object pl;
  SetProp(P_CURSED, 0);
  if(objectp(pl=QueryProp(P_WIELDED))) {
    tell_object(pl, "Das Glasschwert zerspringt in tausend Stuecke.\n");
    DoUnwield(1);
    if(ENV(pl))
      tell_room(ENV(ME), sprintf("Das Glasschwert von %s zerspringt in "
          +"tausend Stuecke.\n", pl->name(WER)), ({pl}));
  }
  ::remove();
}
