
inherit "std/thing";

#include <properties.h>
#include "/p/daemon/itemd/itemd.h"

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Riesenperle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"PERLE", "perle", "riesenperle"}) );
  SetProp(P_MAGIC, 1);
  SetProp(P_MATERIAL, ([MAT_PEARL:100]) );
  SetProp(P_NOBUY, 1);
}

int create_big_pearl(object ob)
{
  if( !ob || !ob->id("PERLE") ) return 0;
  SetProp(P_NAME, "Riesen"+lower_case(ob->Query(P_NAME)[0]) );
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, ob->QueryProp(P_LONG)+
      Name(WER,1)+" ist ein seltenes Einzelstueck und riesengross." );   
  SetProp(P_INFO, ob->QueryProp(P_INFO)+
      Name(WER,1)+" ist durch ihre Groesse ganz besonders magisch.\n");
  AddId(lower_case(QueryProp(P_NAME)));
  SetProp(P_WEIGHT, 10*(ob->Query("u_gpu")[0])/(ob->Query("u_gpu")[1]));
  SetProp(P_VALUE, 30*(ob->Query("u_cpu")[0])/(ob->Query("u_cpu")[1]));
}  

int IsSocketItem()
{
  return SOC_M_GPEARL;
}
